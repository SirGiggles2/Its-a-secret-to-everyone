                            	  3721: UpdateMoldorm:
                            	  3722:     ; If facing direction = 0, return.
                            	  3723:     ;
02:00039B90 41EC0098        	  3724:     lea     ($0098,A4),A0
02:00039B94 10302000        	  3725:     move.b  (A0,D2.W),D0
02:00039B98 670000C2        	  3726:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3727:     ; If the magic clock is missing, then move around (using the flying mechanism).
                            	  3728:     ;
02:00039B9C 102C066C        	  3729:     move.b  ($066C,A4),D0
02:00039BA0 6608            	  3730:     bne  _anon_z04_79
02:00039BA2 610000BA        	  3731:     jsr     ControlMoldormFlight
02:00039BA6 61002C36        	  3732:     jsr     MoveFlyer
                            	  3733: _anon_z04_79:
                            	  3734:     ; Draw with sprite attributes: normal, red palette row
                            	  3735:     ;
02:00039BAA 7002            	  3736:     moveq   #2,D0
02:00039BAC 19400003        	  3737:     move.b  D0,($0003,A4)
02:00039BB0 7044            	  3738:     moveq   #68,D0
02:00039BB2 4EB900030FF8    	  3739:     jsr     Anim_WriteSprite
                            	  3740:     ; Check collisions, but never let them interfere with movement.
                            	  3741:     ;
02:00039BB8 41EC0098        	  3742:     lea     ($0098,A4),A0
02:00039BBC 10302000        	  3743:     move.b  (A0,D2.W),D0
02:00039BC0 1B00            	  3744:     move.b  D0,-(A5)  ; PHA
02:00039BC2 10342028        	  3745:     move.b  ($28,A4,D2.W),D0
02:00039BC6 1B00            	  3746:     move.b  D0,-(A5)  ; PHA
02:00039BC8 4EB900031068    	  3747:     jsr     CheckMonsterCollisions
02:00039BCE 101D            	  3748:     move.b  (A5)+,D0  ; PLA
02:00039BD0 19802028        	  3749:     move.b  D0,($28,A4,D2.W)
02:00039BD4 101D            	  3750:     move.b  (A5)+,D0  ; PLA
02:00039BD6 41EC0098        	  3751:     lea     ($0098,A4),A0
02:00039BDA 11802000        	  3752:     move.b  D0,(A0,D2.W)
                            	  3753:     ; If this segment is still alive, then return.
                            	  3754:     ;
02:00039BDE 41EC0405        	  3755:     lea     ($0405,A4),A0
02:00039BE2 10302000        	  3756:     move.b  (A0,D2.W),D0
02:00039BE6 6774            	  3757:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3758:     ; This segment is dead. We'll swap the tail segment with this
                            	  3759:     ; dead segment. This way, moldorm heads are always rooted
                            	  3760:     ; in slots 5 and $A; and the segments are continguous.
                            	  3761:     ;
                            	  3762:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  3763:     ;
                            	  3764:     ; Note that this is not a true swap, because the tail's HP
                            	  3765:     ; might be less than $20.
                            	  3766:     ;
02:00039BE8 7020            	  3767:     moveq   #32,D0
02:00039BEA 41EC0485        	  3768:     lea     ($0485,A4),A0
02:00039BEE 11802000        	  3769:     move.b  D0,(A0,D2.W)
02:00039BF2 61000608        	  3770:     jsr     CheckBossHitReaction
                            	  3771:     ; Look for the tail segment, starting from the low end
                            	  3772:     ; of the chain that this dead segment belongs to.
                            	  3773:     ;
02:00039BF6 163C00FF        	  3774:     move.b  #$FF,D3
02:00039BFA 0C020006        	  3775:     cmpi.b  #$06,D2
02:00039BFE 6502            	  3776:     bcs  _anon_z04_80
02:00039C00 7604            	  3777:     moveq   #4,D3
                            	  3778: _anon_z04_80:
02:00039C02 5203            	  3779:     addq.b  #1,D3
02:00039C04 41EC0350        	  3780:     lea     ($0350,A4),A0
02:00039C08 10303000        	  3781:     move.b  (A0,D3.W),D0
02:00039C0C 0C000041        	  3782:     cmpi.b  #$41,D0
02:00039C10 66F0            	  3783:     bne  _anon_z04_80
                            	  3784:     ; I don't know why the object timer of the tail segment that will
                            	  3785:     ; be made dead is set to $11. By setting its object type to $5D
                            	  3786:     ; below, its metastate will become $10 -- dying/dead. From
                            	  3787:     ; there, the object timer is set to 6.
                            	  3788:     ;
02:00039C12 7011            	  3789:     moveq   #17,D0
02:00039C14 19803029        	  3790:     move.b  D0,($29,A4,D3.W)
                            	  3791:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  3792:     ; segment to the tail segment.
                            	  3793:     ;
02:00039C18 41EC04F0        	  3794:     lea     ($04F0,A4),A0
02:00039C1C 10302000        	  3795:     move.b  (A0,D2.W),D0
02:00039C20 41EC04F1        	  3796:     lea     ($04F1,A4),A0
02:00039C24 11803000        	  3797:     move.b  D0,(A0,D3.W)
02:00039C28 10342070        	  3798:     move.b  ($70,A4,D2.W),D0
02:00039C2C 19803071        	  3799:     move.b  D0,($71,A4,D3.W)
02:00039C30 41EC0084        	  3800:     lea     ($0084,A4),A0
02:00039C34 10302000        	  3801:     move.b  (A0,D2.W),D0
02:00039C38 41EC0085        	  3802:     lea     ($0085,A4),A0
02:00039C3C 11803000        	  3803:     move.b  D0,(A0,D3.W)
                            	  3804:     ; If the tail segment found is also a head, then
                            	  3805:     ; the last segment has died. Return.
                            	  3806:     ;
02:00039C40 0C030004        	  3807:     cmpi.b  #$04,D3
02:00039C44 6716            	  3808:     beq  _L_z04_UpdateMoldorm_Exit
02:00039C46 0C030009        	  3809:     cmpi.b  #$09,D3
02:00039C4A 6710            	  3810:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3811:     ; Else finish swapping the segments.
                            	  3812:     ; Set the tail segment's type to the dead dummy object.
                            	  3813:     ;
02:00039C4C 705D            	  3814:     moveq   #93,D0
02:00039C4E 41EC0350        	  3815:     lea     ($0350,A4),A0
02:00039C52 11803000        	  3816:     move.b  D0,(A0,D3.W)
                            	  3817:     ; Reset the metastate of the current segment, so that it comes
                            	  3818:     ; back to life.
                            	  3819:     ;
02:00039C56 4EB900049EEA    	  3820:     jsr     ResetObjMetastate
                            	  3821:     even
                            	  3822: _L_z04_UpdateMoldorm_Exit:
02:00039C5C 4E75            	  3823:     rts
                            	  3824: 
                            	  3825:     even
                            	  3826: ControlMoldormFlight:
02:00039C5E 41EC0444        	  3827:     lea     ($0444,A4),A0
02:00039C62 10302000        	  3828:     move.b  (A0,D2.W),D0
02:00039C66 4EB90002AECA    	  3829:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  3830:     even
                            	  3831: ControlMoldormFlight_JumpTable:
02:00039C6C 00039C7C        	  3832:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C70 00039C7C        	  3833:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C74 00039C7C        	  3834:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:00039C78 00039CB0        	  3835:     dc.l    Moldorm_Wander   ; jump table entry (32-bit for _m68k_tablejump)
                            	  3836: 
                            	  3837:     even
                            	  3838: Moldorm_Chase:
                            	  3839:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3840:     ; Only the head controls the movement direction.
                            	  3841:     ;
02:00039C7C 0C020005        	  3842:     cmpi.b  #$05,D2
02:00039C80 670A            	  3843:     beq  _anon_z04_81
02:00039C82 0C02000A        	  3844:     cmpi.b  #$0A,D2
02:00039C86 6704            	  3845:     beq.s  __far_z_04_0025
