                            	  5168: _L_z07_UpdateArrowOrBoomerang_State10:
                            	  5169:     ; State $1x. Fly away from the thrower.
                            	  5170:     ;
                            	  5171:     ; Reset [0E], which will indicate:
                            	  5172:     ; - into MoveShot:   0 update grid offset, else don't
                            	  5173:     ; - out of MoveShot: $80 if blocked
                            	  5174:     ;
02:00048BF6 7000            	  5175:     moveq   #0,D0
02:00048BF8 1940000E        	  5176:     move.b  D0,($000E,A4)
                            	  5177:     ; If the object's direction has a horizontal component, then
                            	  5178:     ; move it horizontally.
                            	  5179:     ;
02:00048BFC 41EC0098        	  5180:     lea     ($0098,A4),A0
02:00048C00 10302000        	  5181:     move.b  (A0,D2.W),D0
02:00048C04 02000003        	  5182:     andi.b #$03,D0
02:00048C08 670A            	  5183:     beq  _anon_z07_26
02:00048C0A 4EB900030938    	  5184:     jsr     MoveShot
02:00048C10 522C000E        	  5185:     addq.b  #1,($000E,A4)
                            	  5186: _anon_z07_26:
                            	  5187:     ; If the object was blocked, go handle it.
                            	  5188:     ;
02:00048C14 102C000E        	  5189:     move.b  ($000E,A4),D0
