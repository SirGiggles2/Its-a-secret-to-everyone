                            	  3533: _L_z04_L_Wallmaster_State1_PatchSprites:
02:00039A0A 19400001        	  3534:     move.b  D0,($0001,A4)
02:00039A0E 61000082        	  3535:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  3536:     ; The default image is the hand open.
                            	  3537:     ; If animation frame = 0, then return.
                            	  3538:     ;
02:00039A12 7400            	  3539:     moveq   #0,D2
02:00039A14 142C0340        	  3540:     move.b  ($0340,A4),D2
02:00039A18 41EC03E4        	  3541:     lea     ($03E4,A4),A0
02:00039A1C 10302000        	  3542:     move.b  (A0,D2.W),D0
02:00039A20 6724            	  3543:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  3544:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  3545:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  3546:     ; The right side is correctly the right side of a closed hand.
                            	  3547:     ; But the left side is Keese. So, we have to patch the left
                            	  3548:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  3549:     ;
                            	  3550:     ; Keep in mind that left and right sprites might be flipped.
                            	  3551:     ;
02:00039A22 7600            	  3552:     moveq   #0,D3
02:00039A24 1614            	  3553:     move.b  ($0000,A4),D3
02:00039A26 41EC0201        	  3554:     lea     ($0201,A4),A0
02:00039A2A 10303000        	  3555:     move.b  (A0,D3.W),D0
02:00039A2E 0C00009C        	  3556:     cmpi.b  #$9C,D0
02:00039A32 6706            	  3557:     beq  _anon_z04_68
02:00039A34 7600            	  3558:     moveq   #0,D3
02:00039A36 162C0001        	  3559:     move.b  ($0001,A4),D3
                            	  3560: _anon_z04_68:
02:00039A3A 103C00AC        	  3561:     move.b  #$AC,D0
02:00039A3E 41EC0201        	  3562:     lea     ($0201,A4),A0
