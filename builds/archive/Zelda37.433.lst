                            	  5484: _L_z07_CheckState30_SetState40:
                            	  5485:     ; Set state $40, and a time to move of $20 frames.
                            	  5486:     ;
                            	  5487:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5488:     ;
                            	  5489:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5490:     ;
02:00048E20 7020            	  5491:     moveq   #32,D0
02:00048E22 41EC0380        	  5492:     lea     ($0380,A4),A0
02:00048E26 11802000        	  5493:     move.b  D0,(A0,D2.W)
02:00048E2A 7040            	  5494:     moveq   #64,D0
02:00048E2C 41EC00AC        	  5495:     lea     ($00AC,A4),A0
02:00048E30 11802000        	  5496:     move.b  D0,(A0,D2.W)
