                            	  8302:     ;
02:0003BDEA 102C0071        	  8303:     move.b  ($0071,A4),D0
02:0003BDEE 19802070        	  8304:     move.b  D0,($70,A4,D2.W)
                            	  8305:     ; If patra child type = $25, then the radius of its orbit is $2C.
