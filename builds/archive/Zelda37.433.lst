02:0003C008 6606            	  8617:     bne  _L_z04_Ganon_MoveAndShoot_Exit
02:0003C00A 7056            	  8618:     moveq   #86,D0
02:0003C00C 6100C632        	  8619:     jsr     ShootFireball
                            	  8620:     even
