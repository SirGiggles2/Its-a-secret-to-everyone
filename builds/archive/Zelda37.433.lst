                            	  8835: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	  8836:     ; Draw the four clouds at diagonal corners.
                            	  8837:     ;
02:0003C190 610000B6        	  8838:     jsr     Ganon_GetCurCloudLeft
02:0003C194 610000BE        	  8839:     jsr     Ganon_GetCurCloudTop
02:0003C198 61A0            	  8840:     jsr     Ganon_DrawCloud
02:0003C19A 610000B2        	  8841:     jsr     Ganon_GetCurCloudRight
02:0003C19E 619A            	  8842:     jsr     Ganon_DrawCloud
02:0003C1A0 610000A6        	  8843:     jsr     Ganon_GetCurCloudLeft
02:0003C1A4 610000B4        	  8844:     jsr     Ganon_GetCurCloudBottom
02:0003C1A8 6190            	  8845:     jsr     Ganon_DrawCloud
