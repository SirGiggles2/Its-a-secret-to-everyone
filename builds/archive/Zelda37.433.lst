02:0003CCCE 102C0254        	   280:     move.b  ($0254,A4),D0
02:0003CCD2 1B00            	   281:     move.b  D0,-(A5)  ; PHA
02:0003CCD4 102C0258        	   282:     move.b  ($0258,A4),D0
02:0003CCD8 1B00            	   283:     move.b  D0,-(A5)  ; PHA
02:0003CCDA 4EB900047414    	   284:     jsr     HideAllSprites
02:0003CCE0 101D            	   285:     move.b  (A5)+,D0  ; PLA
02:0003CCE2 19400258        	   286:     move.b  D0,($0258,A4)
02:0003CCE6 101D            	   287:     move.b  (A5)+,D0  ; PLA
02:0003CCE8 19400254        	   288:     move.b  D0,($0254,A4)
02:0003CCEC 522C00E1        	   289:     addq.b  #1,($00E1,A4)
02:0003CCF0 0A3C0001        	   290:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003CCF4 4E75            	   291:     rts
