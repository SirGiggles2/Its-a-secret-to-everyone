                            	  8629: Ganon_UpdateBrownState:
                            	  8630:     ; Every other frame decrement the state.
                            	  8631:     ; But every frame draw Ganon either translucent or opaque.
                            	  8632:     ;
02:0003C014 102C0015        	  8633:     move.b  ($0015,A4),D0
02:0003C018 E208            	  8634:     lsr.b  #1,D0   ; LSR A
02:0003C01A 6410            	  8635:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003C01C 41EC00AC        	  8636:     lea     ($00AC,A4),A0
02:0003C020 53302000        	  8637:     subq.b  #1,(A0,D2.W)
                            	  8638:     ; If the state becomes 0, then Ganon is blue again.
                            	  8639:     ; Go switch his palette row to reflect it.
                            	  8640:     ;
02:0003C024 6606            	  8641:     bne  _L_z04_Ganon_UpdateBrownState_Draw
02:0003C026 61A4            	  8642:     jsr     Ganon_RandomizeLocation
