02:0003C080 19802070        	  8699:     move.b  D0,($70,A4,D2.W)
02:0003C084 41EC0084        	  8700:     lea     ($0084,A4),A0
02:0003C088 10302000        	  8701:     move.b  (A0,D2.W),D0
02:0003C08C 123C0008        	  8702:     move.b  #$08,D1
02:0003C090 D101            	  8703:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003C092 41EC0084        	  8704:     lea     ($0084,A4),A0
02:0003C096 11802000        	  8705:     move.b  D0,(A0,D2.W)
