                            	  3622: InitMoldorm:
                            	  3623:     ; Loop to make 10 moldrom segments, from 9 to 0, indexed by Y register.
                            	  3624:     ; Object slots $A to 1 will be used.
                            	  3625:     ;
02:00039AB0 7609            	  3626:     moveq   #9,D3
                            	  3627: _anon_z04_77:
                            	  3628:     ; Start at position ($80, $70).
                            	  3629:     ;
02:00039AB2 103C0080        	  3630:     move.b  #$80,D0
02:00039AB6 19803071        	  3631:     move.b  D0,($71,A4,D3.W)
02:00039ABA 7070            	  3632:     moveq   #112,D0
02:00039ABC 41EC0085        	  3633:     lea     ($0085,A4),A0
02:00039AC0 11803000        	  3634:     move.b  D0,(A0,D3.W)
                            	  3635:     ; Start with no direction, no deferred bounce direction,
                            	  3636:     ; and ready to update.
                            	  3637:     ;
02:00039AC4 7000            	  3638:     moveq   #0,D0
02:00039AC6 41EC0099        	  3639:     lea     ($0099,A4),A0
02:00039ACA 11803000        	  3640:     move.b  D0,(A0,D3.W)
02:00039ACE 41EC03BD        	  3641:     lea     ($03BD,A4),A0
02:00039AD2 11803000        	  3642:     move.b  D0,(A0,D3.W)
02:00039AD6 41EC0406        	  3643:     lea     ($0406,A4),A0
02:00039ADA 11803000        	  3644:     move.b  D0,(A0,D3.W)
02:00039ADE 41EC0493        	  3645:     lea     ($0493,A4),A0
02:00039AE2 11803000        	  3646:     move.b  D0,(A0,D3.W)
                            	  3647:     ; Copy object attributes from the first monster slot.
                            	  3648:     ;
02:00039AE6 102C04C0        	  3649:     move.b  ($04C0,A4),D0
02:00039AEA 41EC04C0        	  3650:     lea     ($04C0,A4),A0
02:00039AEE 11803000        	  3651:     move.b  D0,(A0,D3.W)
                            	  3652:     ; Copy HP from the first monster slot.
                            	  3653:     ;
02:00039AF2 102C0486        	  3654:     move.b  ($0486,A4),D0
02:00039AF6 41EC0486        	  3655:     lea     ($0486,A4),A0
02:00039AFA 11803000        	  3656:     move.b  D0,(A0,D3.W)
                            	  3657:     ; Start with flying speed $80, and in flying state 2.
                            	  3658:     ;
02:00039AFE 103C0080        	  3659:     move.b  #$80,D0
02:00039B02 41EC0420        	  3660:     lea     ($0420,A4),A0
02:00039B06 11803000        	  3661:     move.b  D0,(A0,D3.W)
02:00039B0A 7002            	  3662:     moveq   #2,D0
02:00039B0C 41EC0445        	  3663:     lea     ($0445,A4),A0
02:00039B10 11803000        	  3664:     move.b  D0,(A0,D3.W)
02:00039B14 7041            	  3665:     moveq   #65,D0
02:00039B16 41EC0350        	  3666:     lea     ($0350,A4),A0
02:00039B1A 11803000        	  3667:     move.b  D0,(A0,D3.W)
                            	  3668:     ; Bottom of the loop.
                            	  3669:     ;
02:00039B1E 5303            	  3670:     subq.b  #1,D3
02:00039B20 6A90            	  3671:     bpl  _anon_z04_77
                            	  3672:     ; Choose a random 8-way direction for the head segments
                            	  3673:     ; in slots 4 and 9.
                            	  3674:     ;
02:00039B22 102C001D        	  3675:     move.b  ($001D,A4),D0
02:00039B26 02000007        	  3676:     andi.b #$07,D0
02:00039B2A 7600            	  3677:     moveq   #0,D3
02:00039B2C 1600            	  3678:     move.b  D0,D3
02:00039B2E 41F90003C7B6    	  3679:     lea     (Directions8).l,A0
02:00039B34 10303000        	  3680:     move.b  (A0,D3.W),D0
02:00039B38 1940009D        	  3681:     move.b  D0,($009D,A4)
02:00039B3C 19400385        	  3682:     move.b  D0,($0385,A4)
02:00039B40 102C0022        	  3683:     move.b  ($0022,A4),D0
02:00039B44 02000007        	  3684:     andi.b #$07,D0
02:00039B48 7600            	  3685:     moveq   #0,D3
02:00039B4A 1600            	  3686:     move.b  D0,D3
02:00039B4C 41F90003C7B6    	  3687:     lea     (Directions8).l,A0
02:00039B52 10303000        	  3688:     move.b  (A0,D3.W),D0
02:00039B56 194000A2        	  3689:     move.b  D0,($00A2,A4)
02:00039B5A 1940038A        	  3690:     move.b  D0,($038A,A4)
                            	  3691:     ; Set minimum number of turns 1 for flying states.
                            	  3692:     ;
                            	  3693:     ; By setting this, the first time that a flight control routine
                            	  3694:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  3695:     ; that flying state will immediately end, and object timer
                            	  3696:     ; will be left 0: ready for moldorm to decide a flying state
                            	  3697:     ; randomly and set timer to $10.
                            	  3698:     ;
02:00039B5E 7001            	  3699:     moveq   #1,D0
02:00039B60 19400431        	  3700:     move.b  D0,($0431,A4)
02:00039B64 19400436        	  3701:     move.b  D0,($0436,A4)
02:00039B68 103C0080        	  3702:     move.b  #$80,D0
02:00039B6C 194004D1        	  3703:     move.b  D0,($04D1,A4)
02:00039B70 7008            	  3704:     moveq   #8,D0
02:00039B72 1940034E        	  3705:     move.b  D0,($034E,A4)
02:00039B76 4E75            	  3706:     rts
                            	  3707: 
                            	  3708:     even
