                            	  4255: GoWalkableDir:
                            	  4256:     ; If object is not Link, then the tile is walkable. Go see if this direction
                            	  4257:     ; makes the object cross a boundary. Then go check another direction if it does,
                            	  4258:     ; or else make this the object direction.
                            	  4259:     ;
