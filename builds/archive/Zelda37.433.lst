                            	  8679:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8680:     ; in order to look up its information.
                            	  8681:     ;
02:00041D48 102C005D        	  8682:     move.b  ($005D,A4),D0
02:00041D4C 194000EB        	  8683:     move.b  D0,($00EB,A4)
                            	  8684:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8685:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8686:     ; map mark tile.
                            	  8687:     ;
02:00041D50 7013            	  8688:     moveq   #19,D0
02:00041D52 1940033F        	  8689:     move.b  D0,($033F,A4)
                            	  8690:     ; Get the currently scanned room's visit state.
                            	  8691:     ;
