                            	   934: 
                            	   935: ;------------------------------------------------------------------------------
                            	   936: ; _c_move_object_shim — MoveObject trampoline.
                            	   937: ;
                            	   938: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   939: ;   Input:     D2 = slot (0..11)
                            	   940: ;   Preserves: D2, A4, A5
                            	   941: ;   Clobbers:  D0, D1, D3, A0
                            	   942: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   943: ;
                            	   944: ; GCC side:
                            	   945: ;   void c_move_object(unsigned short slot);
                            	   946: ;     slot arrives as a 16-bit value on the stack.
                            	   947: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   948: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   949: ;   never clobbered by gcc.
                            	   950: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   951: ;   semantics can exist in a pure C port).
                            	   952: ;------------------------------------------------------------------------------
                            	   953: _c_move_object_shim:
                            	   954:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   955:     move.b  #$AA,($0900,A4)
                            	   956:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   957:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   958:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   959:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   960:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   961:     moveq   #0,D0
02:0002B658 3002            	   962:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   963:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   964:     jsr     c_move_object
02:0002B662 588F            	   965:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   966:     rts
                            	   967: 
                            	   968: ;==============================================================================
                            	   969: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   970: ; and tail-call the native asm function.
                            	   971: ;
                            	   972: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   973: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   974: ; sign-extended).
                            	   975: ;==============================================================================
                            	   976: 
                            	   977: ;------------------------------------------------------------------------------
                            	   978: ; void c_copy_bank_to_window(unsigned int bank);
                            	   979: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   980: ;------------------------------------------------------------------------------
                            	   981: c_copy_bank_to_window:
02:0002B666 202F0004        	   982:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   983:     jmp     _copy_bank_to_window
                            	   984: 
                            	   985: ;------------------------------------------------------------------------------
                            	   986: ; unsigned char c_ppu_read_2(void);
                            	   987: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   988: ; C return: gcc expects result in D0.
                            	   989: ;------------------------------------------------------------------------------
                            	   990: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   991:     jmp     _ppu_read_2
                            	   992: 
                            	   993: ;------------------------------------------------------------------------------
                            	   994: ; void c_ppu_write_6(unsigned int val);
                            	   995: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   996: ;------------------------------------------------------------------------------
                            	   997: c_ppu_write_6:
02:0002B674 202F0004        	   998:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   999:     jmp     _ppu_write_6
                            	  1000: 
                            	  1001: ;------------------------------------------------------------------------------
                            	  1002: ; void c_ppu_write_7(unsigned int val);
                            	  1003: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1004: ;------------------------------------------------------------------------------
                            	  1005: c_ppu_write_7:
02:0002B67E 202F0004        	  1006:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1007:     jmp     _ppu_write_7
                            	  1008: 
                            	  1009: ;------------------------------------------------------------------------------
                            	  1010: ; void c_turn_off_all_video(void);
                            	  1011: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1012: ;------------------------------------------------------------------------------
                            	  1013: c_turn_off_all_video:
02:0002B688 4EF900047420    	  1014:     jmp     TurnOffAllVideo
                            	  1015: 
                            	  1016: ;==============================================================================
                            	  1017: ; EXPORT side — z_03 entry point.
                            	  1018: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1019: ; the transpiler emits that label pointing to this shim instead of the
                            	  1020: ; z_03 asm body. The C function takes no args and returns void.
                            	  1021: ;==============================================================================
                            	  1022: 
                            	  1023: ;------------------------------------------------------------------------------
                            	  1024: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1025: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1026: ;------------------------------------------------------------------------------
                            	  1027: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1028:     jmp     z03_transfer_level_pattern_blocks
                            	  1029: 
                            	  1030: ;==============================================================================
                            	  1031: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1032: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1033: ;==============================================================================
                            	  1034: 
                            	  1035: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1036:     jmp     z06_init_mode2_submodes
                            	  1037: 
                            	  1038: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1039:     jmp     z06_copy_common_data_to_ram
                            	  1040: 
                            	  1041: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1042:     jmp     z06_update_mode2_load_full
                            	  1043: 
                            	  1044: ;==============================================================================
                            	  1045: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1046: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1047: ;==============================================================================
                            	  1048: 
                            	  1049: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	  1050:     jmp     z05_copy_column_to_tilebuf
                            	  1051: 
                            	  1052: c_copy_row_to_tilebuf:
