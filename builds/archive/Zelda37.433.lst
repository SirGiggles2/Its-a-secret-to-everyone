                            	   389: UpdateMenuStartOW:
                            	   390:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   391:     ; make it look completely empty, and no piece has been won.
                            	   392:     ;
02:0003CDC0 7617            	   393:     moveq   #23,D3
                            	   394: _anon_z05_6:
02:0003CDC2 7400            	   395:     moveq   #0,D2
02:0003CDC4 41F90003CD78    	   396:     lea     (TriforceTransferBufOffsets).l,A0
02:0003CDCA 14303000        	   397:     move.b  (A0,D3.W),D2
02:0003CDCE 41F90003CDA8    	   398:     lea     (TriforceTransferBufTiles).l,A0
02:0003CDD4 10303000        	   399:     move.b  (A0,D3.W),D0
02:0003CDD8 41F900043F1A    	   400:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003CDDE 11802000        	   401:     move.b  D0,(A0,D2.W)
02:0003CDE2 5303            	   402:     subq.b  #1,D3
02:0003CDE4 6ADC            	   403:     bpl  _anon_z05_6
                            	   404:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   405:     ;
02:0003CDE6 5203            	   406:     addq.b  #1,D3
                            	   407:     ; Outer loop.
                            	   408:     ; A level test bit in [06] will be used to see whether
                            	   409:     ; we have a triforce piece.
                            	   410:     ;
02:0003CDE8 7001            	   411:     moveq   #1,D0
02:0003CDEA 19400006        	   412:     move.b  D0,($0006,A4)
                            	   413:     even
                            	   414: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   415:     ; Inner loop.
                            	   416:     ; Each level bit will make 3 triforce tile slots be
                            	   417:     ; checked and replaced.
                            	   418:     ;
02:0003CDEE 7003            	   419:     moveq   #3,D0
02:0003CDF0 19400007        	   420:     move.b  D0,($0007,A4)
                            	   421:     even
                            	   422: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   423:     ; Get the offset into the submenu triforce transfer buffers of
                            	   424:     ; the current tile slot.
                            	   425:     ;
02:0003CDF4 7400            	   426:     moveq   #0,D2
02:0003CDF6 41F90003CD78    	   427:     lea     (TriforceTransferBufOffsets).l,A0
02:0003CDFC 14303000        	   428:     move.b  (A0,D3.W),D2
                            	   429:     ; If the level test bit is not in the triforce mask, then we don't
                            	   430:     ; have this piece. So, go loop again, and leave the tile in the
                            	   431:     ; empty state.
                            	   432:     ;
                            	   433:     ;
                            	   434:     ; [06] level test mask
02:0003CE00 102C0006        	   435:     move.b  ($0006,A4),D0
