                            	  5151: __far_z_07_0075:
                            	  5152:     ; Reset [00], which will hold the number of axes where the distance <= 8
                            	  5153:     ; when calculating the angle to return to thrower.
                            	  5154:     ; See states $40 and $50 and GetDirectionsAndDistancesToTarget.
                            	  5155:     ;
02:00048BDC 7000            	  5156:     moveq   #0,D0
02:00048BDE 1880            	  5157:     move.b  D0,($0000,A4)
                            	  5158:     ; If not in major state $10, go check other states.
                            	  5159:     ;
02:00048BE0 41EC00AC        	  5160:     lea     ($00AC,A4),A0
02:00048BE4 10302000        	  5161:     move.b  (A0,D2.W),D0
02:00048BE8 020000F0        	  5162:     andi.b #$F0,D0
02:00048BEC 0C000010        	  5163:     cmpi.b  #$10,D0
