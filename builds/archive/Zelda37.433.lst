                            	  3848: _anon_z04_81:
                            	  3849:     ; Chase while flying, as usual.
                            	  3850:     ;
02:00039C8C 61002BA0        	  3851:     jsr     Flyer_Chase
                            	  3852:     ; If timer has not expired, then
                            	  3853:     ; go see if it's time to propagate direction changes down the chain.
                            	  3854:     ;
02:00039C90 10342028        	  3855:     move.b  ($28,A4,D2.W),D0
02:00039C94 6702            	  3856:     beq.s  __far_z_04_0026
02:00039C96 6032            	  3857:     jmp  Moldorm_PropagateDirs
                            	  3858: __far_z_04_0026:
                            	  3859:     even
                            	  3860: Moldorm_ChangeFlyingState:
                            	  3861:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  3862:     ;
02:00039C98 61000096        	  3863:     jsr     Flyer_MoldormDecideState
02:00039C9C 7010            	  3864:     moveq   #16,D0
02:00039C9E 19802028        	  3865:     move.b  D0,($28,A4,D2.W)
                            	  3866:     ; If the next lower slot's direction <> 0, then
                            	  3867:     ; go propagate direction changes down the chain.
                            	  3868:     ;
                            	  3869:     ; But you had to have propagated directions once for the
                            	  3870:     ; next lower direction to be set. How does it happen?
                            	  3871:     ;
                            	  3872:     ; Within a flyer state, the flying routines turn the flyer
                            	  3873:     ; and set the object timer to $10 several times. After any of
                            	  3874:     ; those times will the test succeed.
                            	  3875:     ;
                            	  3876:     ; When a flying state ends, timer will be 0, triggering the code
                            	  3877:     ; in this block to set the timer to $10, and try to propagate
                            	  3878:     ; directions.
                            	  3879:     ;
                            	  3880:     ; But this is also the case the first time here.
                            	  3881:     ;
                            	  3882:     ; So, I believe that the point of this test is to delay moving
                            	  3883:     ; the lower (not head) segments when starting out.
                            	  3884:     ;
02:00039CA2 41EC0097        	  3885:     lea     ($0097,A4),A0
02:00039CA6 10302000        	  3886:     move.b  (A0,D2.W),D0
02:00039CAA 6702            	  3887:     beq.s  __far_z_04_0027
02:00039CAC 601C            	  3888:     jmp  Moldorm_PropagateDirs
                            	  3889: __far_z_04_0027:
02:00039CAE 4E75            	  3890:     rts
                            	  3891: 
                            	  3892:     even
                            	  3893: Moldorm_Wander:
                            	  3894:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3895:     ; Only the head controls the movement direction.
                            	  3896:     ;
02:00039CB0 0C020005        	  3897:     cmpi.b  #$05,D2
02:00039CB4 6708            	  3898:     beq  _anon_z04_82
02:00039CB6 0C02000A        	  3899:     cmpi.b  #$0A,D2
02:00039CBA 6702            	  3900:     beq.s  __far_z_04_0028
02:00039CBC 6070            	  3901:     jmp  L1156B_Exit
                            	  3902: __far_z_04_0028:
                            	  3903: _anon_z04_82:
                            	  3904:     ; Turn randomly while flying, as usual.
                            	  3905:     ;
02:00039CBE 61002C4C        	  3906:     jsr     Flyer_Wander
                            	  3907:     ; After every turn, the common flyer routines set timer to $10.
                            	  3908:     ; This can be used as a signal for moldorm to propagate
                            	  3909:     ; direction changes down the chain.
                            	  3910:     ;
                            	  3911:     ; Between each turn, timer <> $10.
                            	  3912:     ;
                            	  3913:     ; At the end of the delay after the last turn, timer = 0.
                            	  3914:     ; This is a signal that that flying state ended, and a new one
                            	  3915:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  3916:     ; we can propagate direction changes again; and start
                            	  3917:     ; a new flying interval by setting timer to $10. This will make
                            	  3918:     ; the next flying state delay that amount of time before turning
                            	  3919:     ; the first time.
                            	  3920:     ;
                            	  3921:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  3922:     ; arm the timer again, and shift directions down the chain.
                            	  3923:     ;
02:00039CC2 10342028        	  3924:     move.b  ($28,A4,D2.W),D0
02:00039CC6 6602            	  3925:     bne.s  __far_z_04_0029
02:00039CC8 60CE            	  3926:     jmp  Moldorm_ChangeFlyingState
                            	  3927: __far_z_04_0029:
                            	  3928:     even
                            	  3929: Moldorm_PropagateDirs:
                            	  3930:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  3931:     ;
02:00039CCA 10342028        	  3932:     move.b  ($28,A4,D2.W),D0
02:00039CCE 0C000010        	  3933:     cmpi.b  #$10,D0
02:00039CD2 6702            	  3934:     beq.s  __far_z_04_0030
02:00039CD4 6058            	  3935:     jmp  L1156B_Exit
                            	  3936: __far_z_04_0030:
                            	  3937:     ; Timer = $10.
                            	  3938:     ;
                            	  3939:     ; If deferred bounce direction <> 0, then
                            	  3940:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  3941:     ;
02:00039CD6 41EC03BC        	  3942:     lea     ($03BC,A4),A0
02:00039CDA 10302000        	  3943:     move.b  (A0,D2.W),D0
02:00039CDE 6712            	  3944:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:00039CE0 41EC0098        	  3945:     lea     ($0098,A4),A0
02:00039CE4 11802000        	  3946:     move.b  D0,(A0,D2.W)
02:00039CE8 7000            	  3947:     moveq   #0,D0
02:00039CEA 41EC03BC        	  3948:     lea     ($03BC,A4),A0
02:00039CEE 11802000        	  3949:     move.b  D0,(A0,D2.W)
                            	  3950:     even
                            	  3951: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  3952:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  3953:     ;
02:00039CF2 7004            	  3954:     moveq   #4,D0
02:00039CF4 1880            	  3955:     move.b  D0,($0000,A4)
                            	  3956:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3957:     ;
02:00039CF6 7600            	  3958:     moveq   #0,D3
02:00039CF8 0C020005        	  3959:     cmpi.b  #$05,D2
02:00039CFC 6702            	  3960:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:00039CFE 7605            	  3961:     moveq   #5,D3
                            	  3962:     even
                            	  3963: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  3964:     ; Copy old direction from a higher slot to the lower one;
                            	  3965:     ; and to the lower one's facing direction.
                            	  3966:     ;
02:00039D00 41EC0382        	  3967:     lea     ($0382,A4),A0
02:00039D04 10303000        	  3968:     move.b  (A0,D3.W),D0
02:00039D08 41EC0381        	  3969:     lea     ($0381,A4),A0
02:00039D0C 11803000        	  3970:     move.b  D0,(A0,D3.W)
02:00039D10 41EC0099        	  3971:     lea     ($0099,A4),A0
02:00039D14 11803000        	  3972:     move.b  D0,(A0,D3.W)
                            	  3973:     ; Bottom of the loop.
                            	  3974:     ; Increment segment index.
                            	  3975:     ; Decrement loop counter.
                            	  3976:     ;
02:00039D18 5203            	  3977:     addq.b  #1,D3
02:00039D1A 5314            	  3978:     subq.b  #1,($0000,A4)
02:00039D1C 66E2            	  3979:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  3980:     ; Copy current direction to old direction.
                            	  3981:     ;
02:00039D1E 41EC0098        	  3982:     lea     ($0098,A4),A0
02:00039D22 10302000        	  3983:     move.b  (A0,D2.W),D0
02:00039D26 41EC0380        	  3984:     lea     ($0380,A4),A0
02:00039D2A 11802000        	  3985:     move.b  D0,(A0,D2.W)
                            	  3986:     even
