02:00041D5E 182C0001        	  8695:     move.b  ($01,A4),D4  ; ptr hi
02:00041D62 024100FF        	  8696:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041D66 E14C            	  8697:     lsl.w   #8,D4
02:00041D68 8841            	  8698:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041D6A 48C4            	  8699:     ext.l   D4
02:00041D6C D8BC00FF0000    	  8700:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041D72 2044            	  8701:     movea.l D4,A0
02:00041D74 10303000        	  8702:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041D78 02000020        	  8703:     andi.b #$20,D0
                            	  8704:     ; If it's been visited, then check each of the 4 doors,
                            	  8705:     ; and build an open door mask.
                            	  8706:     ;
                            	  8707:     ; Start with direction up and direction index 3.
                            	  8708:     ;
02:00041D7C 671C            	  8709:     beq  _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile
02:00041D7E 7008            	  8710:     moveq   #8,D0
02:00041D80 19400002        	  8711:     move.b  D0,($0002,A4)
