                            	  2527:     ; Loop over each heart from object slot 2 to 9.
                            	  2528:     ;
                            	  2529:     ; Even though they are not standalone objects, their info
                            	  2530:     ; is stored in those object slots.
                            	  2531:     ;
02:00039294 7402            	  2532:     moveq   #2,D2
                            	  2533:     even
                            	  2534: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  2535:     ; If the current heart's state <> 0, then go move it.
                            	  2536:     ; Else we have to wait for it to come out at the right time.
                            	  2537:     ;
02:00039296 41EC00AC        	  2538:     lea     ($00AC,A4),A0
02:0003929A 10302000        	  2539:     move.b  (A0,D2.W),D0
02:0003929E 667C            	  2540:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  2541:     ; The current heart's state = 0.
                            	  2542:     ;
                            	  2543:     ; If object slot = 2, then go make it appear. This is the first
                            	  2544:     ; heart to show up.
                            	  2545:     ;
02:000392A0 0C020002        	  2546:     cmpi.b  #$02,D2
02:000392A4 6732            	  2547:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  2548:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  2549:     ; go start over.
                            	  2550:     ;
                            	  2551:     ; TODO:
                            	  2552:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  2553:     ;
02:000392A6 102C00AE        	  2554:     move.b  ($00AE,A4),D0
02:000392AA 67EA            	  2555:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  2556:     ; Look up the starting angle of this heart with the index
                            	  2557:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  2558:     ; then loop again.
                            	  2559:     ;
02:000392AC 1002            	  2560:     move.b  D2,D0
02:000392AE 003C0011        	  2561:     ori     #$11,CCR  ; SEC: set C+X
02:000392B2 123C0003        	  2562:     move.b  #$03,D1
02:000392B6 0A3C0010        	  2563:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000392BA 9101            	  2564:     subx.b  D1,D0   ; SBC #$03
02:000392BC 0A3C0010        	  2565:     eori    #$10,CCR  ; restore X = 6502 C
02:000392C0 7600            	  2566:     moveq   #0,D3
02:000392C2 1600            	  2567:     move.b  D0,D3
02:000392C4 102C0396        	  2568:     move.b  ($0396,A4),D0
02:000392C8 41F90003928C    	  2569:     lea     (PondHeartStartAngles).l,A0
02:000392CE 12303000        	  2570:     move.b  (A0,D3.W),D1
02:000392D2 B001            	  2571:     cmp.b   D1,D0
02:000392D4 66000086        	  2572:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  2573:     even
