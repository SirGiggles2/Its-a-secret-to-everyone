                            	  1128: _anon_z04_34:
02:00038928 7020            	  1129:     moveq   #32,D0
                            	  1130: ; Params:
                            	  1131: ; A: q-speed of the monster
                            	  1132: ; Y: shot object type
                            	  1133: ;
                            	  1134: ; [01] holds the q-speed of the monster
                            	  1135:     even
                            	  1136: _TryShooting:
02:0003892A 19400001        	  1137:     move.b  D0,($0001,A4)
                            	  1138:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  1139:     ;
02:0003892E 41EC034F        	  1140:     lea     ($034F,A4),A0
02:00038932 10302000        	  1141:     move.b  (A0,D2.W),D0
02:00038936 0C000003        	  1142:     cmpi.b  #$03,D0
02:0003893A 6726            	  1143:     beq  _L_z04__TryShooting_TryShootingNow
02:0003893C 0C000001        	  1144:     cmpi.b  #$01,D0
02:00038940 6720            	  1145:     beq  _L_z04__TryShooting_TryShootingNow
02:00038942 0C000009        	  1146:     cmpi.b  #$09,D0
02:00038946 671A            	  1147:     beq  _L_z04__TryShooting_TryShootingNow
02:00038948 0C00000A        	  1148:     cmpi.b  #$0A,D0
02:0003894C 6714            	  1149:     beq  _L_z04__TryShooting_TryShootingNow
02:0003894E 41EC0451        	  1150:     lea     ($0451,A4),A0
02:00038952 10302000        	  1151:     move.b  (A0,D2.W),D0
02:00038956 660A            	  1152:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1153:     ; and a random value < $F8, then return.
                            	  1154:     ;
02:00038958 10342018        	  1155:     move.b  ($18,A4,D2.W),D0
02:0003895C 0C0000F8        	  1156:     cmpi.b  #$F8,D0
02:00038960 656C            	  1157:     bcs  _L_z04__TryShooting_Exit
                            	  1158:     even
                            	  1159: _L_z04__TryShooting_TryShootingNow:
                            	  1160:     ; Summary
                            	  1161:     ;
                            	  1162:     ; if temporarily invincible then
                            	  1163:     ;   shoot timer := 0
                            	  1164:     ; elif shoot timer > 0 then
                            	  1165:     ;   decrement shoot timer
                            	  1166:     ; elif wants to shoot then
                            	  1167:     ;   shoot timer := $30
                            	  1168:     ;
                            	  1169:     ; qspeed := [01]
                            	  1170:     ;
                            	  1171:     ; if shoot timer <> 0 then
                            	  1172:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1173:     ;     shoot
                            	  1174:     ;     if succeeded then
                            	  1175:     ;       shoot timer := 0
                            	  1176:     ;       qspeed := 0
                            	  1177:     ;   else
                            	  1178:     ;     qspeed := 0
                            	  1179:     ;
                            	  1180:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038962 102C0001        	  1181:     move.b  ($0001,A4),D0
02:00038966 1883            	  1182:     move.b  D3,($0000,A4)
02:00038968 1B00            	  1183:     move.b  D0,-(A5)  ; PHA
02:0003896A 7600            	  1184:     moveq   #0,D3
                            	  1185:     ; If not temporarily invincible,
                            	  1186:     ;
02:0003896C 41EC04F0        	  1187:     lea     ($04F0,A4),A0
02:00038970 10302000        	  1188:     move.b  (A0,D2.W),D0
02:00038974 661A            	  1189:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1190:     ; then Y := shoot timer - 1
                            	  1191:     ;
02:00038976 7600            	  1192:     moveq   #0,D3
02:00038978 41EC0451        	  1193:     lea     ($0451,A4),A0
02:0003897C 16302000        	  1194:     move.b  (A0,D2.W),D3
02:00038980 5303            	  1195:     subq.b  #1,D3
                            	  1196:     ; If Y register < 0, then shoot timer is 0.
                            	  1197:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1198:     ; Else go set a non-zero speed and return.
                            	  1199:     ;
