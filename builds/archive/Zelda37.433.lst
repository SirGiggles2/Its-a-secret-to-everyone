02:0003A398 19400001        	  4835:     move.b  D0,($0001,A4)
                            	  4836:     ; Calculate sprite attributes:
                            	  4837:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4838:     ;
                            	  4839:     ; If the boss is temporarily invincible, then
                            	  4840:     ; this makes it flash by cycling all the palette rows.
                            	  4841:     ;
                            	  4842:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4843:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4844:     ;
02:0003A39C 41EC04F0        	  4845:     lea     ($04F0,A4),A0
02:0003A3A0 10302000        	  4846:     move.b  (A0,D2.W),D0
02:0003A3A4 02000003        	  4847:     andi.b #$03,D0
02:0003A3A8 0A000003        	  4848:     eori.b #$03,D0
02:0003A3AC 19400003        	  4849:     move.b  D0,($0003,A4)
02:0003A3B0 7600            	  4850:     moveq   #0,D3
02:0003A3B2 162C000A        	  4851:     move.b  ($000A,A4),D3
                            	  4852:     ; Look up the tile for this sprite.
                            	  4853:     ; If it's not the first one (face), then go write the sprite record.
                            	  4854:     ;
02:0003A3B6 41F90003A334    	  4855:     lea     (AquamentusTiles).l,A0
02:0003A3BC 10303000        	  4856:     move.b  (A0,D3.W),D0
02:0003A3C0 12390003A334    	  4857:     move.b  (AquamentusTiles).l,D1
02:0003A3C6 B001            	  4858:     cmp.b   D1,D0
02:0003A3C8 6610            	  4859:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4860:     ; Else it's the first one (the face tile).
                            	  4861:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  4862:     ;
                            	  4863:     ; $CC/CD shows the closed mouth face.
                            	  4864:     ; $C0/C1 shows the open mouth face.
                            	  4865:     ;
02:0003A3CA 7600            	  4866:     moveq   #0,D3
02:0003A3CC 16342028        	  4867:     move.b  ($28,A4,D2.W),D3
02:0003A3D0 0C030020        	  4868:     cmpi.b  #$20,D3
02:0003A3D4 6404            	  4869:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
