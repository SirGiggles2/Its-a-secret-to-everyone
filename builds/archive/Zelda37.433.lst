                            	  8585: ;
                            	  8586:     even
                            	  8587: Ganon_RandomizeLocation:
02:0003BFCC 4EF90002BA30    	  8588:     jmp     c_ganon_randomize_location
                            	  8589: 
                            	  8590: Ganon_MoveAndShoot:
                            	  8591:     ; Change the animation frame every screen frame; so that
                            	  8592:     ; when Ganon is hit, he appears in a random pose.
                            	  8593:     ;
02:0003BFD2 41EC046B        	  8594:     lea     ($046B,A4),A0
02:0003BFD6 52302000        	  8595:     addq.b  #1,(A0,D2.W)
                            	  8596:     ; The animation cycle has 6 frames.
                            	  8597:     ;
02:0003BFDA 41EC046B        	  8598:     lea     ($046B,A4),A0
02:0003BFDE 10302000        	  8599:     move.b  (A0,D2.W),D0
02:0003BFE2 0C000006        	  8600:     cmpi.b  #$06,D0
02:0003BFE6 660A            	  8601:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003BFE8 7000            	  8602:     moveq   #0,D0
02:0003BFEA 41EC046B        	  8603:     lea     ($046B,A4),A0
02:0003BFEE 11802000        	  8604:     move.b  D0,(A0,D2.W)
