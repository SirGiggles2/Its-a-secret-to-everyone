02:00034E1C 6602            	  4435:     bne.s  __far_z_02_0006
02:00034E1E 6032            	  4436:     jmp  LA9F4_Exit
                            	  4437: __far_z_02_0006:
                            	  4438:     ; Determine an index based on the high 2 bits of the character element:
                            	  4439:     ;   $80: 0
                            	  4440:     ;   $40: 1
                            	  4441:     ;   $C0: 2
                            	  4442:     ;
02:00034E20 7602            	  4443:     moveq   #2,D3
02:00034E22 0C0000C0        	  4444:     cmpi.b  #$C0,D0
02:00034E26 670A            	  4445:     beq  _anon_z02_33
02:00034E28 5303            	  4446:     subq.b  #1,D3
02:00034E2A 0C000040        	  4447:     cmpi.b  #$40,D0
02:00034E2E 6702            	  4448:     beq  _anon_z02_33
02:00034E30 5303            	  4449:     subq.b  #1,D3
                            	  4450: _anon_z02_33:
                            	  4451:     ; The index chooses the low VRAM address of the start
                            	  4452:     ; of another line:
                            	  4453:     ;   0: $C4: front of the second line
                            	  4454:     ;   1: $E4: front of the third line
                            	  4455:     ;   2: $A4: front of the first line
                            	  4456:     ;
02:00034E32 41F900034D7A    	  4457:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034E38 10303000        	  4458:     move.b  (A0,D3.W),D0
02:00034E3C 1940045F        	  4459:     move.b  D0,($045F,A4)
                            	  4460:     ; If index = 2, then we've reached the end of the text,
                            	  4461:     ; and low VRAM address is moved to the front of the first line.
                            	  4462:     ; So, advance the state of the person object, and unhalt Link.
                            	  4463:     ;
02:00034E40 0C030002        	  4464:     cmpi.b  #$02,D3
02:00034E44 6702            	  4465:     beq.s  __far_z_02_0007
02:00034E46 600A            	  4466:     jmp  LA9F4_Exit
