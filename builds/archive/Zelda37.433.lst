                            	  4194: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  4195:     ; Digdogger is big, but room boundary checks and
                            	  4196:     ; object collision checks assume a 16x16 monster or smaller.
                            	  4197:     ; Therefore, we have to check these things four times,
                            	  4198:     ; in different corners of the boss.
                            	  4199:     ;
                            	  4200:     ; Loop 4 times, from 0 to 3.
                            	  4201:     ;
02:00039E70 7600            	  4202:     moveq   #0,D3
02:00039E72 41EC0478        	  4203:     lea     ($0478,A4),A0
02:00039E76 16302000        	  4204:     move.b  (A0,D2.W),D3
                            	  4205:     ; Change the coordinates to one corner.
                            	  4206:     ;
02:00039E7A 10342070        	  4207:     move.b  ($70,A4,D2.W),D0
02:00039E7E 023C00EE        	  4208:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E82 41F900039D36    	  4209:     lea     (DigdoggerCornerOffsetsX).l,A0
02:00039E88 12303000        	  4210:     move.b  (A0,D3.W),D1
02:00039E8C D101            	  4211:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:00039E8E 19802070        	  4212:     move.b  D0,($70,A4,D2.W)
02:00039E92 41EC0084        	  4213:     lea     ($0084,A4),A0
02:00039E96 10302000        	  4214:     move.b  (A0,D2.W),D0
02:00039E9A 023C00EE        	  4215:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E9E 41F900039D3A    	  4216:     lea     (DigdoggerCornerOffsetsY).l,A0
02:00039EA4 12303000        	  4217:     move.b  (A0,D3.W),D1
02:00039EA8 D101            	  4218:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:00039EAA 41EC0084        	  4219:     lea     ($0084,A4),A0
02:00039EAE 11802000        	  4220:     move.b  D0,(A0,D2.W)
                            	  4221:     ; Check the room boundary and object collisions in this temporary location.
                            	  4222:     ;
02:00039EB2 61002930        	  4223:     jsr     BoundFlyer
02:00039EB6 4EB900031068    	  4224:     jsr     CheckMonsterCollisions
                            	  4225:     ; Increase the loop index, and loop again until it = 4.
                            	  4226:     ;
02:00039EBC 41EC0478        	  4227:     lea     ($0478,A4),A0
02:00039EC0 52302000        	  4228:     addq.b  #1,(A0,D2.W)
02:00039EC4 41EC0478        	  4229:     lea     ($0478,A4),A0
02:00039EC8 10302000        	  4230:     move.b  (A0,D2.W),D0
02:00039ECC 0C000004        	  4231:     cmpi.b  #$04,D0
02:00039ED0 659E            	  4232:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  4233:     ; Restore the original coordinates.
                            	  4234:     ;
