02:00038EA8 102C066C        	  1930:     move.b  ($066C,A4),D0
02:00038EAC 1234203D        	  1931:     move.b  ($3D,A4,D2.W),D1
02:00038EB0 8001            	  1932:     or.b  D1,D0
02:00038EB2 6704            	  1933:     beq.s  __far_z_04_0013
02:00038EB4 6000009E        	  1934:     jmp  RedLeever_AnimateAndCheckCollisions
                            	  1935: __far_z_04_0013:
                            	  1936:     ; If the leever is blocked by a tile or the room boundary,
                            	  1937:     ; then go to the next state, in addition to animating, drawing,
                            	  1938:     ; and checking for collisions.
                            	  1939:     ;
02:00038EB8 41EC0098        	  1940:     lea     ($0098,A4),A0
02:00038EBC 10302000        	  1941:     move.b  (A0,D2.W),D0
02:00038EC0 1940000F        	  1942:     move.b  D0,($000F,A4)
02:00038EC4 4EB9000480F8    	  1943:     jsr     GetCollidingTileMoving
02:00038ECA 122C034A        	  1944:     move.b  ($034A,A4),D1
