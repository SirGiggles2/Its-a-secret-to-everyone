                            	  4372: ; AnimateAndDrawCommonObject(val, slot) — ASM: D0=val, D2=slot
                            	  4373: c_animate_and_draw_common_object:
02:0002CCCC 2F02            	  4374:     move.l  D2,-(SP)        ; save D2
02:0002CCCE 2F02            	  4375:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CCD0 2F00            	  4376:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4377:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4378:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4379:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4380:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CCD2 4EB900000000    	  4381:     jsr     z04_animate_and_draw_common_object
02:0002CCD8 508F            	  4382:     addq.l  #8,SP           ; pop val+slot
02:0002CCDA 241F            	  4383:     move.l  (SP)+,D2        ; restore D2
02:0002CCDC 4E75            	  4384:     rts
