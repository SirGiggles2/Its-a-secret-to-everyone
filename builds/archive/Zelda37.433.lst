02:000399E8 4EB900030CFC    	  3520:     jsr     DrawObjectNotMirrored
02:000399EE 101D            	  3521:     move.b  (A5)+,D0  ; PLA
                            	  3522:     ; Store the offset of the left sprite record in [00],
                            	  3523:     ; and the right one in [01].
