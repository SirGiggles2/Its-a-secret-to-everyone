                            	  3174:     ; If it's not time to change the chase target, then
                            	  3175:     ; skip this and go update objects.
                            	  3176:     ;
02:00047F16 102C004A        	  3177:     move.b  ($004A,A4),D0
02:00047F1A 6636            	  3178:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3179:     ; Set the chase long-timer to a random value between 0 and 7.
                            	  3180:     ;
02:00047F1C 102C0019        	  3181:     move.b  ($0019,A4),D0
02:00047F20 02000007        	  3182:     andi.b #$07,D0
02:00047F24 1940004A        	  3183:     move.b  D0,($004A,A4)
                            	  3184:     ; Switch the flag indicating whether Link is the target.
                            	  3185:     ; If the value is 0 (Link *is* the target), then
                            	  3186:     ; skip this and go update objects.
                            	  3187:     ;
02:00047F28 102C0060        	  3188:     move.b  ($0060,A4),D0
02:00047F2C 0A000001        	  3189:     eori.b #$01,D0
02:00047F30 19400060        	  3190:     move.b  D0,($0060,A4)
02:00047F34 671C            	  3191:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3192:     ; If Link's X has not changed since the last frame
                            	  3193:     ; (when Link was the target), then XOR the chase target
                            	  3194:     ; coordinates (which were Link's coordinates last frame).
                            	  3195:     ;
                            	  3196:     ; This ends up reflecting Link's coordinates across the room;
                            	  3197:     ; so that monsters chase away from him.
                            	  3198:     ;
                            	  3199:     ; But if Link's X has changed since the last frame, then
                            	  3200:     ; leave the chase target coordinates with his old coordinates.
                            	  3201:     ;
