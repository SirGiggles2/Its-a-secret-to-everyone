                            	  2324:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2325:     ;
                            	  2326:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2327:     ; In total, 11 bytes will be written.
                            	  2328:     ;
                            	  2329:     ; First, write the high byte of PPU address in each record.
                            	  2330:     ;
02:0004784E 1014            	  2331:     move.b  ($0000,A4),D0
02:00047850 41EC0302        	  2332:     lea     ($0302,A4),A0
02:00047854 11802000        	  2333:     move.b  D0,(A0,D2.W)
02:00047858 41EC0307        	  2334:     lea     ($0307,A4),A0
02:0004785C 11802000        	  2335:     move.b  D0,(A0,D2.W)
                            	  2336:     ; Write the low address in the first record. In the second record,
                            	  2337:     ; write (low address + 1).
                            	  2338:     ;
02:00047860 102C0001        	  2339:     move.b  ($0001,A4),D0
02:00047864 41EC0303        	  2340:     lea     ($0303,A4),A0
02:00047868 11802000        	  2341:     move.b  D0,(A0,D2.W)
02:0004786C 41EC0308        	  2342:     lea     ($0308,A4),A0
02:00047870 11802000        	  2343:     move.b  D0,(A0,D2.W)
02:00047874 41EC0308        	  2344:     lea     ($0308,A4),A0
02:00047878 52302000        	  2345:     addq.b  #1,(A0,D2.W)
                            	  2346:     ; Write the first tile twice in each record. Patch them later.
                            	  2347:     ;
02:0004787C 102C0005        	  2348:     move.b  ($0005,A4),D0
02:00047880 41EC0305        	  2349:     lea     ($0305,A4),A0
02:00047884 11802000        	  2350:     move.b  D0,(A0,D2.W)
02:00047888 41EC0306        	  2351:     lea     ($0306,A4),A0
02:0004788C 11802000        	  2352:     move.b  D0,(A0,D2.W)
02:00047890 41EC030A        	  2353:     lea     ($030A,A4),A0
02:00047894 11802000        	  2354:     move.b  D0,(A0,D2.W)
02:00047898 41EC030B        	  2355:     lea     ($030B,A4),A0
02:0004789C 11802000        	  2356:     move.b  D0,(A0,D2.W)
                            	  2357:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
