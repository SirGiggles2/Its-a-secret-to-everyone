                            	  1022: _L_z04_CheckZora_LoopTileCandidate:
                            	  1023:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  1024:     ; If it = 0 or $F0, go loop again.
                            	  1025:     ;
02:00038868 7600            	  1026:     moveq   #0,D3
02:0003886A 162C000D        	  1027:     move.b  ($000D,A4),D3
02:0003886E 10343018        	  1028:     move.b  ($18,A4,D3.W),D0
02:00038872 020000F0        	  1029:     andi.b #$F0,D0
02:00038876 19802070        	  1030:     move.b  D0,($70,A4,D2.W)
02:0003887A 6748            	  1031:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003887C 0C0000F0        	  1032:     cmpi.b  #$F0,D0
02:00038880 6742            	  1033:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1034:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1035:     ; If it < $50 or >= $E0, go loop again.
                            	  1036:     ;
02:00038882 10343018        	  1037:     move.b  ($18,A4,D3.W),D0
02:00038886 E308            	  1038:     lsl.b  #1,D0   ; ASL A
02:00038888 E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:0003888A E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:0003888C E308            	  1041:     lsl.b  #1,D0   ; ASL A
02:0003888E 0C000050        	  1042:     cmpi.b  #$50,D0
02:00038892 6530            	  1043:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038894 0C0000E0        	  1044:     cmpi.b  #$E0,D0
02:00038898 642A            	  1045:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1046:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1047:     ;
