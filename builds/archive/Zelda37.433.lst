02:00038B54 1880            	  1488:     move.b  D0,($0000,A4)
02:00038B56 19430002        	  1489:     move.b  D3,($0002,A4)
                            	  1490:     ; Add the high speed byte to the Y coordinate.
                            	  1491:     ;
02:00038B5A 41EC0412        	  1492:     lea     ($0412,A4),A0
02:00038B5E 10302000        	  1493:     move.b  (A0,D2.W),D0
02:00038B62 41EC0084        	  1494:     lea     ($0084,A4),A0
02:00038B66 12302000        	  1495:     move.b  (A0,D2.W),D1
02:00038B6A D101            	  1496:     addx.b  D1,D0   ; ADC ObjY,X
02:00038B6C 41EC0084        	  1497:     lea     ($0084,A4),A0
02:00038B70 11802000        	  1498:     move.b  D0,(A0,D2.W)
                            	  1499:     ; Add the acceleration to the speed fraction (low byte).
                            	  1500:     ;
02:00038B74 41EC041F        	  1501:     lea     ($041F,A4),A0
02:00038B78 10302000        	  1502:     move.b  (A0,D2.W),D0
02:00038B7C 023C00EE        	  1503:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B80 1214            	  1504:     move.b  ($0000,A4),D1
02:00038B82 D101            	  1505:     addx.b  D1,D0   ; ADC $00
02:00038B84 41EC041F        	  1506:     lea     ($041F,A4),A0
02:00038B88 11802000        	  1507:     move.b  D0,(A0,D2.W)
                            	  1508:     ; Carry over to the high speed byte.
                            	  1509:     ;
02:00038B8C 41EC0412        	  1510:     lea     ($0412,A4),A0
02:00038B90 10302000        	  1511:     move.b  (A0,D2.W),D0
02:00038B94 123C0000        	  1512:     move.b  #$00,D1
02:00038B98 D101            	  1513:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00038B9A 41EC0412        	  1514:     lea     ($0412,A4),A0
02:00038B9E 11802000        	  1515:     move.b  D0,(A0,D2.W)
                            	  1516:     ; *Signed comparison*:
                            	  1517:     ; If the high speed byte < high max speed byte, then return.
                            	  1518:     ;
                            	  1519:     ; Note that this is not a general purpose signed comparison,
                            	  1520:     ; which would be more complicated. But it works because
                            	  1521:     ; the deviation from 0 of both values is small.
                            	  1522:     ;
02:00038BA2 122C0002        	  1523:     move.b  ($0002,A4),D1
02:00038BA6 B001            	  1524:     cmp.b   D1,D0
02:00038BA8 6A02            	  1525:     bpl.s  __far_z_04_0011
