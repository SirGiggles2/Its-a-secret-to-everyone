                            	  8937: _L_z05_UpdateSubmenuSelection_DrawBreakoutItem:
                            	  8938:     ; Draw the item in the box for the currently selected item,
                            	  8939:     ; if we have it.
                            	  8940:     ;
                            	  8941:     ; There's also the special case for the letter. If the selected item
                            	  8942:     ; is the letter, but we have a potion, then skip this.
                            	  8943:     ;
                            	  8944:     ; If the letter is selected and there's no potion, then make
                            	  8945:     ; the item value 1 in [04]. Except that, the call to 05:B81C
                            	  8946:     ; below will overwrite [04].
                            	  8947:     ;
02:00041F06 41EC0657        	  8948:     lea     ($0657,A4),A0
02:00041F0A 10302000        	  8949:     move.b  (A0,D2.W),D0
02:00041F0E 6720            	  8950:     beq  _L_z05_UpdateSubmenuSelection_AfterBreakoutItem
02:00041F10 0C02000F        	  8951:     cmpi.b  #$0F,D2
