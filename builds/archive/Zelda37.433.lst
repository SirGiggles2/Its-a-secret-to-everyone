02:000393A2 667C            	  2679:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  2680:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  2681:     ; is positive; then go use it along with a flag that indicates that
                            	  2682:     ; Link is "down" from the object.
                            	  2683:     ;
02:000393A4 7600            	  2684:     moveq   #0,D3
