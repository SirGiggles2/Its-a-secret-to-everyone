02:00039ED4 41EC0084        	  4236:     lea     ($0084,A4),A0
02:00039ED8 11802000        	  4237:     move.b  D0,(A0,D2.W)
02:00039EDC 101D            	  4238:     move.b  (A5)+,D0  ; PLA
02:00039EDE 19802070        	  4239:     move.b  D0,($70,A4,D2.W)
