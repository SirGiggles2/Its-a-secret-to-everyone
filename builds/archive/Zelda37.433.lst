                            	  4353: UpdateZeldaTextbox:
02:00034D7E 4EB9000486AA    	  4354:     jsr     Link_EndMoveAndDraw
                            	  4355:     ; If Zelda's timer has not expired, then return.
                            	  4356:     ;
02:00034D84 102C0029        	  4357:     move.b  ($0029,A4),D0
02:00034D88 6704            	  4358:     beq.s  __far_z_02_0005
02:00034D8A 600000C6        	  4359:     jmp  LA9F4_Exit
                            	  4360: __far_z_02_0005:
                            	  4361:     ; Set the timer to wait 6 frames after the next character about
                            	  4362:     ; to be shown.
                            	  4363:     ;
02:00034D8E 7006            	  4364:     moveq   #6,D0
02:00034D90 19400029        	  4365:     move.b  D0,($0029,A4)
                            	  4366:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4367:     ; to the dynamic transfer buf.
                            	  4368:     ;
02:00034D94 7604            	  4369:     moveq   #4,D3
                            	  4370: _anon_z02_31:
02:00034D96 41F900034D74    	  4371:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034D9C 10303000        	  4372:     move.b  (A0,D3.W),D0
02:00034DA0 41EC0302        	  4373:     lea     ($0302,A4),A0
02:00034DA4 11803000        	  4374:     move.b  D0,(A0,D3.W)
02:00034DA8 5303            	  4375:     subq.b  #1,D3
02:00034DAA 6AEA            	  4376:     bpl  _anon_z02_31
                            	  4377: _anon_z02_32:
                            	  4378:     ; Replace the low byte of the VRAM address with the one
                            	  4379:     ; where the next character should be written.
                            	  4380:     ;
02:00034DAC 102C045F        	  4381:     move.b  ($045F,A4),D0
02:00034DB0 19400303        	  4382:     move.b  D0,($0303,A4)
                            	  4383:     ; Increment the low VRAM address for the next character.
                            	  4384:     ;
02:00034DB4 522C045F        	  4385:     addq.b  #1,($045F,A4)
02:00034DB8 7000            	  4386:     moveq   #0,D0
02:00034DBA 1880            	  4387:     move.b  D0,($0000,A4)
02:00034DBC 7000            	  4388:     moveq   #0,D0
02:00034DBE 19400001        	  4389:     move.b  D0,($0001,A4)
                            	  4390:     ; Load the person text current character index.
                            	  4391:     ;
02:00034DC2 7600            	  4392:     moveq   #0,D3
02:00034DC4 162C0416        	  4393:     move.b  ($0416,A4),D3
                            	  4394:     ; Increment the index variable to point to the next character
                            	  4395:     ; for the next time.
                            	  4396:     ;
02:00034DC8 522C0416        	  4397:     addq.b  #1,($0416,A4)
                            	  4398:     ; Get the current character.
                            	  4399:     ;
02:00034DCC 1214            	  4400:     move.b  ($00,A4),D1   ; ptr lo
02:00034DCE 182C0001        	  4401:     move.b  ($01,A4),D4  ; ptr hi
02:00034DD2 024100FF        	  4402:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034DD6 E14C            	  4403:     lsl.w   #8,D4
02:00034DD8 8841            	  4404:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034DDA 48C4            	  4405:     ext.l   D4
02:00034DDC D8BC00FF0000    	  4406:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034DE2 2044            	  4407:     movea.l D4,A0
02:00034DE4 10303000        	  4408:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4409:     ; If the character is $25, then it's a special space. It will still
                            	  4410:     ; take up space, but will not take time to show -- meaning that
                            	  4411:     ; we'll go look up the next character to transfer.
                            	  4412:     ;
02:00034DE8 0200003F        	  4413:     andi.b #$3F,D0
02:00034DEC 0C000025        	  4414:     cmpi.b  #$25,D0
02:00034DF0 67BA            	  4415:     beq  _anon_z02_32
                            	  4416:     ; We have a non-space character. Put it in the transfer record.
                            	  4417:     ;
02:00034DF2 19400305        	  4418:     move.b  D0,($0305,A4)
                            	  4419:     ; Play the "heart taken/character" tune.
                            	  4420:     ;
02:00034DF6 7010            	  4421:     moveq   #16,D0
02:00034DF8 19400604        	  4422:     move.b  D0,($0604,A4)
                            	  4423:     ; If the high 2 bits of character element = 0, then return.
                            	  4424:     ;
02:00034DFC 1214            	  4425:     move.b  ($00,A4),D1   ; ptr lo
02:00034DFE 182C0001        	  4426:     move.b  ($01,A4),D4  ; ptr hi
