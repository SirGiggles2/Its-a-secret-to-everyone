                            	  7640: Submenu_CueTransferRowUW:
                            	  7641:     ; If menu scroll value is negative, then we transferred everything.
                            	  7642:     ; So, return.
                            	  7643:     ;
02:0004166E 102C005E        	  7644:     move.b  ($005E,A4),D0
02:00041672 6A02            	  7645:     bpl.s  __far_z_05_0084
02:00041674 6030            	  7646:     jmp  L1725A_Exit
                            	  7647: __far_z_05_0084:
                            	  7648:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7649:     ; and represents the current row of the submenu being processed.
                            	  7650:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7651:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7652:     ;
                            	  7653:     ; If the bottom bit is set, go prepare the full black row.
                            	  7654:     ;
02:00041676 E208            	  7655:     lsr.b  #1,D0   ; LSR A
02:00041678 7600            	  7656:     moveq   #0,D3
02:0004167A 1600            	  7657:     move.b  D0,D3
02:0004167C 6402            	  7658:     bcc.s  __far_z_05_0085
02:0004167E 6028            	  7659:     jmp  PrepFullBlackRow
                            	  7660: __far_z_05_0085:
                            	  7661:     ; Submenu rows $D to $15 are parts of the map.
                            	  7662:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7663:     ;
                            	  7664:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7665:     ; buffer for this row.
                            	  7666:     ;
02:00041680 0C00000D        	  7667:     cmpi.b  #$0D,D0
02:00041684 640C            	  7668:     bcc  _anon_z05_167
02:00041686 41F90004164A    	  7669:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:0004168C 10303000        	  7670:     move.b  (A0,D3.W),D0
                            	  7671:     even
