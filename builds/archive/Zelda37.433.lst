02:000478BA 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:000478BE 41EC030B        	  2372:     lea     ($030B,A4),A0
02:000478C2 11802000        	  2373:     move.b  D0,(A0,D2.W)
