02:00040480 19430006        	  5934:     move.b  D3,($0006,A4)
                            	  5935:     even
                            	  5936: _L_z05_LayoutUWFloor_LoopColumnUW:
02:00040484 7600            	  5937:     moveq   #0,D3
02:00040486 162C0006        	  5938:     move.b  ($0006,A4),D3
02:0004048A 122C0002        	  5939:     move.b  ($02,A4),D1   ; ptr lo
02:0004048E 182C0003        	  5940:     move.b  ($03,A4),D4  ; ptr hi
