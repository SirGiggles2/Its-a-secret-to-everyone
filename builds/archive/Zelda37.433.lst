02:0003CC96 102C00FB        	   259:     move.b  ($00FB,A4),D0
02:0003CC9A 02000088        	   260:     andi.b #$88,D0
02:0003CC9E 0C000088        	   261:     cmpi.b  #$88,D0
02:0003CCA2 661A            	   262:     bne  _anon_z05_3
