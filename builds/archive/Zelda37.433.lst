02:00040058 123C0003        	  5361:     move.b  #$03,D1
02:0004005C 0A3C0010        	  5362:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040060 9101            	  5363:     subx.b  D1,D0   ; SBC #$03
02:00040062 0A3C0010        	  5364:     eori    #$10,CCR  ; restore X = 6502 C
02:00040066 7600            	  5365:     moveq   #0,D3
02:00040068 1600            	  5366:     move.b  D0,D3
