                            	  2712: Link_FilterInput:
                            	  2713:     ; [00] holds the opposite of Link's facing direction.
                            	  2714:     ;
02:0003E38E 102C0098        	  2715:     move.b  ($0098,A4),D0
02:0003E392 4EB90003092C    	  2716:     jsr     GetOppositeDir
02:0003E398 1880            	  2717:     move.b  D0,($0000,A4)
                            	  2718:     ; Call GetOppositeDir again to use this mapping:
                            	  2719:     ; In Dir: 1 2 4 8
                            	  2720:     ;         -------
                            	  2721:     ; Index:  2 3 0 1
                            	  2722:     ;
02:0003E39A 4EB90003092C    	  2723:     jsr     GetOppositeDir
                            	  2724:     ; Get the appropriate coordinate for the direction:
                            	  2725:     ; X for horizontal
                            	  2726:     ; Y for vertical
                            	  2727:     ;
02:0003E3A0 102C0070        	  2728:     move.b  ($0070,A4),D0
02:0003E3A4 0C030002        	  2729:     cmpi.b  #$02,D3
02:0003E3A8 6404            	  2730:     bcc  _anon_z05_74
02:0003E3AA 102C0084        	  2731:     move.b  ($0084,A4),D0
                            	  2732: _anon_z05_74:
02:0003E3AE 19400002        	  2733:     move.b  D0,($0002,A4)
                            	  2734:     ; Mask A button and directions if inner border is crossed.
                            	  2735:     ;
02:0003E3B2 1003            	  2736:     move.b  D3,D0
02:0003E3B4 1B00            	  2737:     move.b  D0,-(A5)  ; PHA
02:0003E3B6 023C00EE        	  2738:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E3BA 123C0008        	  2739:     move.b  #$08,D1
02:0003E3BE D101            	  2740:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E3C0 7600            	  2741:     moveq   #0,D3
02:0003E3C2 1600            	  2742:     move.b  D0,D3
02:0003E3C4 103C0080        	  2743:     move.b  #$80,D0
02:0003E3C8 6134            	  2744:     jsr     MaskInputInBorder
02:0003E3CA 101D            	  2745:     move.b  (A5)+,D0  ; PLA
02:0003E3CC 7600            	  2746:     moveq   #0,D3
02:0003E3CE 1600            	  2747:     move.b  D0,D3
                            	  2748:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2749:     ; boundary using player's direction and reverse direction index.
                            	  2750:     ;
02:0003E3D0 102C0001        	  2751:     move.b  ($0001,A4),D0
