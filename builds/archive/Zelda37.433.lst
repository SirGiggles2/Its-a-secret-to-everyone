02:0004040A 0003FBE6        	  5893:     dc.l    ColumnHeapUW0
02:0004040E 0003FBF6        	  5894:     dc.l    ColumnHeapUW1
02:00040412 0003FC14        	  5895:     dc.l    ColumnHeapUW2
02:00040416 0003FC26        	  5896:     dc.l    ColumnHeapUW3
02:0004041A 0003FC38        	  5897:     dc.l    ColumnHeapUW4
02:0004041E 0003FC50        	  5898:     dc.l    ColumnHeapUW5
02:00040422 0003FC68        	  5899:     dc.l    ColumnHeapUW6
02:00040426 0003FC7A        	  5900:     dc.l    ColumnHeapUW7
02:0004042A 0003FC8C        	  5901:     dc.l    ColumnHeapUW8
02:0004042E 0003FCA6        	  5902:     dc.l    ColumnHeapUW9
