                            	  1668: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  1669:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1670:     ; the mound frame images:
                            	  1671:     ;
                            	  1672:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1673:     ;
                            	  1674:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1675:     ;
                            	  1676:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1677:     ;
02:00038CCC 003C0011        	  1678:     ori     #$11,CCR  ; SEC: set C+X
02:00038CD0 123C0001        	  1679:     move.b  #$01,D1
02:00038CD4 0A3C0010        	  1680:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038CD8 9101            	  1681:     subx.b  D1,D0   ; SBC #$01
02:00038CDA 0A3C0010        	  1682:     eori    #$10,CCR  ; restore X = 6502 C
02:00038CDE E308            	  1683:     lsl.b  #1,D0   ; ASL A
02:00038CE0 023C00EE        	  1684:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038CE4 41EC03E4        	  1685:     lea     ($03E4,A4),A0
02:00038CE8 12302000        	  1686:     move.b  (A0,D2.W),D1
02:00038CEC D101            	  1687:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1688:     even
