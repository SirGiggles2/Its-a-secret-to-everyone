                            	   429:     ; Goriya will throw a boomerang (object type $5C).
                            	   430:     ;
02:00038442 705C            	   431:     moveq   #92,D0
                            	   432:     even
                            	   433: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot:
                            	   434:     ; If object timer <> 0, return.
                            	   435:     ;
02:00038444 7600            	   436:     moveq   #0,D3
02:00038446 16342028        	   437:     move.b  ($28,A4,D2.W),D3
02:0003844A 66000082        	   438:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   439:     ; Store in [00] the type of projectile the monster will throw.
                            	   440:     ;
02:0003844E 1880            	   441:     move.b  D0,($0000,A4)
                            	   442:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   443:     ;
02:00038450 102C066C        	   444:     move.b  ($066C,A4),D0
02:00038454 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:00038458 8001            	   446:     or.b  D1,D0
02:0003845A 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
                            	   449:     ;
02:0003845C 1014            	   450:     move.b  ($0000,A4),D0
02:0003845E 6100426E        	   451:     jsr     _ShootIfWanted
02:00038462 646A            	   452:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:00038464 103C0080        	   455:     move.b  #$80,D0
02:00038468 41EC00AC        	   456:     lea     ($00AC,A4),A0
02:0003846C 11802000        	   457:     move.b  D0,(A0,D2.W)
                            	   458:     ; Reset the "wants to shoot" flag.
                            	   459:     ;
02:00038470 7000            	   460:     moveq   #0,D0
02:00038472 41EC0412        	   461:     lea     ($0412,A4),A0
02:00038476 11802000        	   462:     move.b  D0,(A0,D2.W)
                            	   463:     ; Have the shot keep track of the monster.
                            	   464:     ;
02:0003847A 1002            	   465:     move.b  D2,D0
02:0003847C 41EC042C        	   466:     lea     ($042C,A4),A0
02:00038480 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:00038484 1003            	   470:     move.b  D3,D0
02:00038486 41EC042C        	   471:     lea     ($042C,A4),A0
02:0003848A 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
