02:0003A8F0 41EC0084        	  5535:     lea     ($0084,A4),A0
02:0003A8F4 10302000        	  5536:     move.b  (A0,D2.W),D0
02:0003A8F8 023C00EE        	  5537:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8FC 123C0008        	  5538:     move.b  #$08,D1
02:0003A900 D101            	  5539:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A902 020000F0        	  5540:     andi.b #$F0,D0
                            	  5541:     ; Make sure the lower nibble of Y is $D as usual.
