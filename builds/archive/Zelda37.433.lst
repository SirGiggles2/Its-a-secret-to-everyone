                            	  5909: LayoutUWFloor:
02:0004043A 7005            	  5910:     moveq   #5,D0
02:0004043C 4EB90002A9FA    	  5911:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00040442 610073DC        	  5912:     jsr     GetUniqueRoomId
02:00040446 1B00            	  5913:     move.b  D0,-(A5)  ; PHA
02:00040448 7000            	  5914:     moveq   #0,D0
02:0004044A 19400002        	  5915:     move.b  D0,($0002,A4)
02:0004044E 7000            	  5916:     moveq   #0,D0
02:00040450 19400003        	  5917:     move.b  D0,($0003,A4)
02:00040454 101D            	  5918:     move.b  (A5)+,D0  ; PLA
02:00040456 E308            	  5919:     lsl.b  #1,D0   ; ASL A
02:00040458 E308            	  5920:     lsl.b  #1,D0   ; ASL A
02:0004045A 1880            	  5921:     move.b  D0,($0000,A4)
02:0004045C 4EB9000309B8    	  5922:     jsr     AddToInt16At2
02:00040462 1014            	  5923:     move.b  ($0000,A4),D0
02:00040464 4EB9000309B8    	  5924:     jsr     AddToInt16At2
02:0004046A 1014            	  5925:     move.b  ($0000,A4),D0
02:0004046C 4EB9000309B8    	  5926:     jsr     AddToInt16At2
02:00040472 103C008C        	  5927:     move.b  #$8C,D0
02:00040476 1880            	  5928:     move.b  D0,($0000,A4)
02:00040478 7065            	  5929:     moveq   #101,D0
02:0004047A 19400001        	  5930:     move.b  D0,($0001,A4)
                            	  5931:     ; For each column in room, indexed by [06]:
