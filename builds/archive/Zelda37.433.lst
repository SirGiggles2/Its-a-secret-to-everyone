                            	  4695: ;==============================================================================
                            	  4696: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4697: ;==============================================================================
                            	  4698: 
                            	  4699:     xref    _ShootIfWanted
                            	  4700: 
                            	  4701: ; ShootIfWanted(type, slot)
                            	  4702: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4703: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4704: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4705: c_shoot_if_wanted:
02:0002CEE6 2F02            	  4706:     move.l  D2,-(SP)
02:0002CEE8 202F0008        	  4707:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CEEC 242F000C        	  4708:     move.l  12(SP),D2       ; arg2 = slot
02:0002CEF0 4EB90003C6CE    	  4709:     jsr     _ShootIfWanted
02:0002CEF6 640C            	  4710:     bcc.s   .csiw_fail
02:0002CEF8 7000            	  4711:     moveq   #0,D0
02:0002CEFA 1003            	  4712:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CEFC 008000000100    	  4713:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF02 6002            	  4714:     bra.s   .csiw_done
                            	  4715: .csiw_fail:
02:0002CF04 7000            	  4716:     moveq   #0,D0
                            	  4717: .csiw_done:
02:0002CF06 241F            	  4718:     move.l  (SP)+,D2
02:0002CF08 4E75            	  4719:     rts
