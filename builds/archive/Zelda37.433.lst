                            	  1819: 
                            	  1820: ; Each byte describes an item. The high nibble is the type.
                            	  1821: ; The low nibble is the value. Its meaning depends on the type.
                            	  1822: ;
                            	  1823: ; 0x - individuals
                            	  1824: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  1825: ; * bit mask: value doesn't matter.
                            	  1826: ;
                            	  1827: ; 1x - amounts
                            	  1828: ; Value is an amount to add.
                            	  1829: ;
                            	  1830: ; 2x - grades
                            	  1831: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  1832: ;
                            	  1833: ; 3x - error?
                            	  1834: ; Produces an item value of $FF.
                            	  1835: ;
                            	  1836:     even
