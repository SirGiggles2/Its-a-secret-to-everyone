02:00039F98 10302000        	  4320:     move.b  (A0,D2.W),D0
02:00039F9C 41EC0437        	  4321:     lea     ($0437,A4),A0
02:00039FA0 12302000        	  4322:     move.b  (A0,D2.W),D1
02:00039FA4 B001            	  4323:     cmp.b   D1,D0
02:00039FA6 6704            	  4324:     beq.s  __far_z_04_0038
02:00039FA8 6000009E        	  4325:     jmp  L116EA_Exit
                            	  4326: __far_z_04_0038:
02:00039FAC 41EC042C        	  4327:     lea     ($042C,A4),A0
02:00039FB0 10302000        	  4328:     move.b  (A0,D2.W),D0
02:00039FB4 41EC0444        	  4329:     lea     ($0444,A4),A0
02:00039FB8 12302000        	  4330:     move.b  (A0,D2.W),D1
02:00039FBC B001            	  4331:     cmp.b   D1,D0
02:00039FBE 6704            	  4332:     beq.s  __far_z_04_0039
02:00039FC0 60000086        	  4333:     jmp  L116EA_Exit
                            	  4334: __far_z_04_0039:
                            	  4335:     ; Set speed flag to 1 meaning decelerate.
