02:0003A8B2 41F90003A6C2    	  5507:     lea     (PolsVoiceDirections).l,A0
02:0003A8B8 10303000        	  5508:     move.b  (A0,D3.W),D0
02:0003A8BC 41EC0098        	  5509:     lea     ($0098,A4),A0
02:0003A8C0 11802000        	  5510:     move.b  D0,(A0,D2.W)
                            	  5511:     ; Randomly set distance-to-move to $30 or $70.
