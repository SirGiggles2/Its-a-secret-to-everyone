02:0004006E 6502            	  5371:     bcs  _anon_z05_113
02:00040070 5303            	  5372:     subq.b  #1,D3
                            	  5373: _anon_z05_113:
                            	  5374:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5375:     ;
                            	  5376:     ; DT DFC DFO Meaning
                            	  5377:     ; ------------------
                            	  5378:     ; 0  1   1   open
                            	  5379:     ; 4  4   5   bombable
                            	  5380:     ; 5  2   1   key
                            	  5381:     ; 6  2   1   key 2
                            	  5382:     ; 7  3   1   shutter
                            	  5383:     ;
                            	  5384:     ;
                            	  5385:     ; Get the direction index.
02:00040072 101D            	  5386:     move.b  (A5)+,D0  ; PLA
