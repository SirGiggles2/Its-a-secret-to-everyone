02:00038E10 023C00EE        	  1848:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038E14 1214            	  1849:     move.b  ($0000,A4),D1
02:00038E16 D101            	  1850:     addx.b  D1,D0   ; ADC $00
                            	  1851:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1852:     ;
02:00038E18 020000F8        	  1853:     andi.b #$F8,D0
                            	  1854:     ; Assign that result to the leever's X coordinate and [02].
                            	  1855:     ;
02:00038E1C 19802070        	  1856:     move.b  D0,($70,A4,D2.W)
02:00038E20 19400002        	  1857:     move.b  D0,($0002,A4)
                            	  1858:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1859:     ;
02:00038E24 122C0001        	  1860:     move.b  ($0001,A4),D1
02:00038E28 B001            	  1861:     cmp.b   D1,D0
02:00038E2A 6510            	  1862:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038E2C 1B00            	  1863:     move.b  D0,-(A5)  ; PHA
02:00038E2E 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038E32 19400002        	  1865:     move.b  D0,($0002,A4)
02:00038E36 101D            	  1866:     move.b  (A5)+,D0  ; PLA
02:00038E38 19400001        	  1867:     move.b  D0,($0001,A4)
                            	  1868:     even
                            	  1869: _L_z04_UpdateRedLeever_Subtract:
                            	  1870:     ; The point is to get the absolute distance between the two.
                            	  1871:     ;
02:00038E3C 102C0001        	  1872:     move.b  ($0001,A4),D0
02:00038E40 003C0011        	  1873:     ori     #$11,CCR  ; SEC: set C+X
02:00038E44 122C0002        	  1874:     move.b  ($0002,A4),D1
02:00038E48 0A3C0010        	  1875:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038E4C 9101            	  1876:     subx.b  D1,D0   ; SBC $02
02:00038E4E 0A3C0010        	  1877:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1878:     ; If the absolute distance >= $30, then return.
                            	  1879:     ; It means that the leever's X coordinate wrapped around
                            	  1880:     ; the left or right edge of the screen.
                            	  1881:     ;
02:00038E52 0C000030        	  1882:     cmpi.b  #$30,D0
02:00038E56 6486            	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1884:     even
                            	  1885: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1886:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  1887:     ;
02:00038E58 4EB9000480F2    	  1888:     jsr     GetCollidableTileStill
02:00038E5E 122C034A        	  1889:     move.b  ($034A,A4),D1
02:00038E62 B001            	  1890:     cmp.b   D1,D0
02:00038E64 6400FF78        	  1891:     bcc  _L_z04_UpdateRedLeever_Exit
02:00038E68 522C0510        	  1892:     addq.b  #1,($0510,A4)
                            	  1893:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1894:     ; and pick up whatever the new value is for state 1.
                            	  1895:     ;
02:00038E6C 7001            	  1896:     moveq   #1,D0
02:00038E6E 41EC03D0        	  1897:     lea     ($03D0,A4),A0
02:00038E72 11802000        	  1898:     move.b  D0,(A0,D2.W)
                            	  1899:     ; Set the long timer to 2, meaning 20 frames.
                            	  1900:     ;
02:00038E76 E308            	  1901:     lsl.b  #1,D0   ; ASL A
02:00038E78 1940004D        	  1902:     move.b  D0,($004D,A4)
02:00038E7C 6100008C        	  1903:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  1904:     ; The leever has to face Link in order to move toward him.
                            	  1905:     ;
02:00038E80 4EB90004865A    	  1906:     jsr     ReverseObjDir
                            	  1907:     even
                            	  1908: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  1909:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  1910:     ;
02:00038E86 41EC00AC        	  1911:     lea     ($00AC,A4),A0
02:00038E8A 10302000        	  1912:     move.b  (A0,D2.W),D0
02:00038E8E 0C000003        	  1913:     cmpi.b  #$03,D0
02:00038E92 666E            	  1914:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  1915:     ; State 3.
                            	  1916:     ;
                            	  1917:     ; If being shoved, go shove, animate, and draw the leever.
                            	  1918:     ;
02:00038E94 41EC00C0        	  1919:     lea     ($00C0,A4),A0
02:00038E98 10302000        	  1920:     move.b  (A0,D2.W),D0
02:00038E9C 670A            	  1921:     beq  _L_z04_UpdateRedLeever_CheckStunned
02:00038E9E 4EB90004810C    	  1922:     jsr     Obj_Shove
02:00038EA4 600000AE        	  1923:     jmp     RedLeever_AnimateAndCheckCollisions
                            	  1924: 
