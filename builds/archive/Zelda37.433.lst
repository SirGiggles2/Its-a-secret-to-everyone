                            	  5326: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5327:     ; For opened doors, the provisional door face has become:
                            	  5328:     ;
                            	  5329:     ; DA PF Meaning
                            	  5330:     ; -------------
                            	  5331:     ; 0  4  open
                            	  5332:     ; 1  1  wall
                            	  5333:     ; 2  2  false wall
                            	  5334:     ; 3  3  false wall 2
                            	  5335:     ; 4  9  bombable
                            	  5336:     ; 5  4  key
                            	  5337:     ; 6  4  key 2
                            	  5338:     ; 7  4  shutter
                            	  5339:     ;
