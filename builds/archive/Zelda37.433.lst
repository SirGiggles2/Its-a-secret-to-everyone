02:0003BEA2 41F90003BD78    	  8393:     lea     (PatraChild2RotationBits).l,A0
02:0003BEA8 10303000        	  8394:     move.b  (A0,D3.W),D0
02:0003BEAC 7600            	  8395:     moveq   #0,D3
02:0003BEAE 1600            	  8396:     move.b  D0,D3
                            	  8397:     even
