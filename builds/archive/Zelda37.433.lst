                            	  7138:     even
                            	  7139: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7140:     ; If the "monsters from edges" long timer expired, then
                            	  7141:     ; go bring the monster in.
                            	  7142:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7143:     ;
                            	  7144:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7145:     ; residual position so enemies keep their previous-room
                            	  7146:     ; positions instead of being re-edge-spawned (matches NES).
02:00049AE8 102C004B        	  7147:     move.b  ($004B,A4),D0
02:00049AEC 662E            	  7148:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7149:     ; timer == 0. Check for fresh room-entry + residual position.
02:00049AEE 102C000F        	  7150:     move.b  ($000F,A4),D0
02:00049AF2 0C0000FF        	  7151:     cmpi.b  #$FF,D0
02:00049AF6 662E            	  7152:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:00049AF8 41EC0070        	  7153:     lea     ($0070,A4),A0
02:00049AFC 10302000        	  7154:     move.b  (A0,D2.W),D0
02:00049B00 660A            	  7155:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:00049B02 41EC0084        	  7156:     lea     ($0084,A4),A0
02:00049B06 10302000        	  7157:     move.b  (A0,D2.W),D0
02:00049B0A 671A            	  7158:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7159:     even
                            	  7160: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:00049B0C 7001            	  7161:     moveq   #1,D0
02:00049B0E 1940004B        	  7162:     move.b  D0,($004B,A4)
02:00049B12 41EC0492        	  7163:     lea     ($0492,A4),A0
02:00049B16 11802000        	  7164:     move.b  D0,(A0,D2.W)
02:00049B1A 4E75            	  7165:     rts
                            	  7166:     even
                            	  7167: _L_z07_InitObject_UninitMonsterFromEdge_Gate:
02:00049B1C 41EC0492        	  7168:     lea     ($0492,A4),A0
02:00049B20 11802000        	  7169:     move.b  D0,(A0,D2.W)
02:00049B24 4E75            	  7170:     rts
