                            	  4859: SpreadShot:
                            	  4860:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4861:     ;
                            	  4862:     ; The shot is spreading out.
                            	  4863:     ;
                            	  4864:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4865:     ; These will be negated appropriately for each corner.
                            	  4866:     ;
02:000489F2 41EC0098        	  4867:     lea     ($0098,A4),A0
02:000489F6 10302000        	  4868:     move.b  (A0,D2.W),D0
02:000489FA 19400002        	  4869:     move.b  D0,($0002,A4)
02:000489FE 19400003        	  4870:     move.b  D0,($0003,A4)
                            	  4871:     ; Reset [0F] to not flip horizontally.
                            	  4872:     ;
02:00048A02 7000            	  4873:     moveq   #0,D0
02:00048A04 1940000F        	  4874:     move.b  D0,($000F,A4)
                            	  4875:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4876:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4877:     ;
02:00048A08 7603            	  4878:     moveq   #3,D3
                            	  4879:     even
                            	  4880: _L_z07_SpreadShot_DrawShotCorner:
02:00048A0A 1003            	  4881:     move.b  D3,D0
02:00048A0C 1B00            	  4882:     move.b  D0,-(A5)  ; PHA
                            	  4883:     ; Save offset X [02] and Y offset [03].
                            	  4884:     ;
02:00048A0E 102C0002        	  4885:     move.b  ($0002,A4),D0
02:00048A12 1B00            	  4886:     move.b  D0,-(A5)  ; PHA
02:00048A14 102C0003        	  4887:     move.b  ($0003,A4),D0
02:00048A18 1B00            	  4888:     move.b  D0,-(A5)  ; PHA
                            	  4889:     ; Calculate and set sprite attributes for this corner:
                            	  4890:     ;   base attribute OR (frame counter AND 3)
                            	  4891:     ;
                            	  4892:     ; The base attribute defines how to flip the sprite.
                            	  4893:     ; The frame counter makes the shot flash by cycling each
                            	  4894:     ; palette row.
                            	  4895:     ;
02:00048A1A 102C0015        	  4896:     move.b  ($0015,A4),D0
02:00048A1E 02000003        	  4897:     andi.b #$03,D0
02:00048A22 41F9000488FE    	  4898:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048A28 12303000        	  4899:     move.b  (A0,D3.W),D1
