02:0003C1CA 41EC0084        	  8859:     lea     ($0084,A4),A0
02:0003C1CE 10302000        	  8860:     move.b  (A0,D2.W),D0
02:0003C1D2 19400001        	  8861:     move.b  D0,($0001,A4)
02:0003C1D6 6100FF62        	  8862:     jsr     Ganon_DrawCloud
