                            	  1755: ; Otherwise, X will have the empty slot found.
                            	  1756: ;
                            	  1757: ; Note that it's possible that we fail to find an empty slot,
                            	  1758: ; but the caller might find slot X occupied by a fire made earlier.
                            	  1759: ;
