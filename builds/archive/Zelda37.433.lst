                            	  6959:     ; Draw the left legs.
                            	  6960:     ;
02:0003B3AE 7600            	  6961:     moveq   #0,D3
                            	  6962: ; Params:
                            	  6963: ; Y: side: 0 for left, 1 for right
                            	  6964: ;
                            	  6965: ; Add the horizontal offset for the current side to Gohma's X to
                            	  6966: ; store the sprite's X in [00].
                            	  6967: ;
                            	  6968:     even
                            	  6969: Gohma_DrawLegsOneSide:
02:0003B3B0 10342070        	  6970:     move.b  ($70,A4,D2.W),D0
02:0003B3B4 023C00EE        	  6971:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B3B8 41F90003B38E    	  6972:     lea     (GohmaLegOffsetsX).l,A0
02:0003B3BE 12303000        	  6973:     move.b  (A0,D3.W),D1
02:0003B3C2 D101            	  6974:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B3C4 1880            	  6975:     move.b  D0,($0000,A4)
                            	  6976:     ; The object's Y is the sprite's.
                            	  6977:     ;
02:0003B3C6 41EC0084        	  6978:     lea     ($0084,A4),A0
02:0003B3CA 10302000        	  6979:     move.b  (A0,D2.W),D0
02:0003B3CE 19400001        	  6980:     move.b  D0,($0001,A4)
02:0003B3D2 612A            	  6981:     jsr     Gohma_SetSpriteAttributes
                            	  6982:     ; There are only two frame images for legs: left and right.
                            	  6983:     ; There are two animation frames. They are animated as follows:
                            	  6984:     ;
                            	  6985:     ; Frame 0:
                            	  6986:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  6987:     ; horizontal flipping = frame number = 0
                            	  6988:     ; 
                            	  6989:     ; Frame 1:
                            	  6990:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  6991:     ; horizontal flipping = frame number = 1
                            	  6992:     ;
02:0003B3D4 4EB9000496BC    	  6993:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B3DA 1003            	  6994:     move.b  D3,D0
02:0003B3DC 023C00EE        	  6995:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B3E0 41EC03E4        	  6996:     lea     ($03E4,A4),A0
02:0003B3E4 12302000        	  6997:     move.b  (A0,D2.W),D1
02:0003B3E8 D101            	  6998:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B3EA 02000001        	  6999:     andi.b #$01,D0
02:0003B3EE 023C00EE        	  7000:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B3F2 123C0004        	  7001:     move.b  #$04,D1
02:0003B3F6 D101            	  7002:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B3F8 4EF900030CFC    	  7003:     jmp     DrawObjectNotMirrored
