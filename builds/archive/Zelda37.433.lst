                            	  2480: ;==============================================================================
                            	  2481: ; EXPORT side — carry-returning shims.
                            	  2482: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2483: ; reproduces the original function's carry normalization.
                            	  2484: ;==============================================================================
                            	  2485: 
                            	  2486: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2487: c_copy_next_row_to_transfer_buf:
02:0002BF8A 4EB900000000    	  2488:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF90 08000008        	  2489:     btst    #8,D0
02:0002BF94 670A            	  2490:     beq.s   .cc_cnr
02:0002BF96 003C0001        	  2491:     ori     #$01,CCR
02:0002BF9A 0A3C0001        	  2492:     eori    #$01,CCR
02:0002BF9E 4E75            	  2493:     rts
                            	  2494: .cc_cnr:
02:0002BFA0 023C00FE        	  2495:     andi    #$FE,CCR
02:0002BFA4 0A3C0001        	  2496:     eori    #$01,CCR
02:0002BFA8 4E75            	  2497:     rts
                            	  2498: 
