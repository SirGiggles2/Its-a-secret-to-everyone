02:000390F4 0C000070        	  2268:     cmpi.b  #$70,D0
02:000390F8 6604            	  2269:     bne  _anon_z04_51
02:000390FA 61000686        	  2270:     jsr     PlaySecretFoundTune
                            	  2271: _anon_z04_51:
                            	  2272:     ; Replace the tile where the armos was.
                            	  2273:     ;
02:000390FE 522C00F7        	  2274:     addq.b  #1,($00F7,A4)
02:00039102 101D            	  2275:     move.b  (A5)+,D0  ; PLA
02:00039104 4EB900047826    	  2276:     jsr     ChangeTileObjTiles
                            	  2277:     ; Because the armos object is aligned to the square grid
                            	  2278:     ; (because it was made from a square),
                            	  2279:     ; set its grid offset to 3 to compensate.
                            	  2280:     ;
                            	  2281:     ; Most objects are aligned to the grid vertically when the
                            	  2282:     ; low nibble is $D.
                            	  2283:     ;
02:0003910A 7003            	  2284:     moveq   #3,D0
02:0003910C 41EC0394        	  2285:     lea     ($0394,A4),A0
02:00039110 11802000        	  2286:     move.b  D0,(A0,D2.W)
                            	  2287:     ; Set a speed (q-speed fraction) randomly:
                            	  2288:     ; $20 if random value < $80
                            	  2289:     ; $60 otherwise
                            	  2290:     ;
02:00039114 7020            	  2291:     moveq   #32,D0
02:00039116 7600            	  2292:     moveq   #0,D3
02:00039118 16342019        	  2293:     move.b  ($19,A4,D2.W),D3
02:0003911C 0C030080        	  2294:     cmpi.b  #$80,D3
02:00039120 6502            	  2295:     bcs  _anon_z04_52
02:00039122 7060            	  2296:     moveq   #96,D0
                            	  2297: _anon_z04_52:
02:00039124 41EC03BC        	  2298:     lea     ($03BC,A4),A0
02:00039128 11802000        	  2299:     move.b  D0,(A0,D2.W)
                            	  2300:     even
                            	  2301: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  2302:     ; Facing and input directions down.
                            	  2303:     ;
02:0003912C 7004            	  2304:     moveq   #4,D0
02:0003912E 41EC03F8        	  2305:     lea     ($03F8,A4),A0
02:00039132 11802000        	  2306:     move.b  D0,(A0,D2.W)
02:00039136 41EC0098        	  2307:     lea     ($0098,A4),A0
02:0003913A 11802000        	  2308:     move.b  D0,(A0,D2.W)
                            	  2309:     ; Every other frame, return without drawing.
                            	  2310:     ;
02:0003913E 10342028        	  2311:     move.b  ($28,A4,D2.W),D0
02:00039142 E208            	  2312:     lsr.b  #1,D0   ; LSR A
02:00039144 6512            	  2313:     bcs  _anon_z04_53
                            	  2314:     ; Finish initializing based on type.
                            	  2315:     ;
02:00039146 41EC034F        	  2316:     lea     ($034F,A4),A0
02:0003914A 10302000        	  2317:     move.b  (A0,D2.W),D0
02:0003914E 0C000022        	  2318:     cmpi.b  #$22,D0
