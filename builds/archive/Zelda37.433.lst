02:0003A388 023C00EE        	  4831:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A38C 41F90003A340    	  4832:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A392 12303000        	  4833:     move.b  (A0,D3.W),D1
