02:000393AA 023C00EE        	  2686:     andi    #$EE,CCR  ; CLC: clear C+X
02:000393AE 123C0003        	  2687:     move.b  #$03,D1
02:000393B2 D101            	  2688:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000393B4 003C0011        	  2689:     ori     #$11,CCR  ; SEC: set C+X
02:000393B8 41EC0084        	  2690:     lea     ($0084,A4),A0
02:000393BC 12302000        	  2691:     move.b  (A0,D2.W),D1
02:000393C0 0A3C0010        	  2692:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000393C4 9101            	  2693:     subx.b  D1,D0   ; SBC ObjY,X
02:000393C6 0A3C0010        	  2694:     eori    #$10,CCR  ; restore X = 6502 C
02:000393CA 6A0E            	  2695:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  2696:     ; Else negate it, and indicate Link is "up" from the object.
                            	  2697:     ;
