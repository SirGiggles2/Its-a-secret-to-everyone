02:000399F0 7600            	  3525:     moveq   #0,D3
02:000399F2 1600            	  3526:     move.b  D0,D3
02:000399F4 41F900030CC4    	  3527:     lea     (SpriteOffsets).l,A0
02:000399FA 10303000        	  3528:     move.b  (A0,D3.W),D0
02:000399FE 1880            	  3529:     move.b  D0,($0000,A4)
02:00039A00 41F900030CC5    	  3530:     lea     (SpriteOffsets+1).l,A0
