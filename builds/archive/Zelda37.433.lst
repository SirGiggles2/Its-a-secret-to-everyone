02:00041446 1B00            	  7357:     move.b  D0,-(A5)  ; PHA
02:00041448 02000007        	  7358:     andi.b #$07,D0
02:0004144C 0C000002        	  7359:     cmpi.b  #$02,D0
02:00041450 6606            	  7360:     bne  _anon_z05_156
02:00041452 7004            	  7361:     moveq   #4,D0
02:00041454 19400602        	  7362:     move.b  D0,($0602,A4)
                            	  7363: _anon_z05_156:
02:00041458 101D            	  7364:     move.b  (A5)+,D0  ; PLA
                            	  7365:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7366:     ; then the player walked all the way to the edge of the play
                            	  7367:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7368:     ;
                            	  7369:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7370:     ; edge of the play area. So, set a relative position that
                            	  7371:     ; reflects that distance: $28 or -$28.
                            	  7372:     ;
                            	  7373:     ; If walking in a decreasing direction (left or up), then
                            	  7374:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7375:     ;
                            	  7376:     ; If walking in an increasing direction (right or down), then
                            	  7377:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7378:     ;
02:0004145A 02000007        	  7379:     andi.b #$07,D0
02:0004145E 0C000002        	  7380:     cmpi.b  #$02,D0
02:00041462 6506            	  7381:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:00041464 0C000005        	  7382:     cmpi.b  #$05,D0
02:00041468 6502            	  7383:     bcs  _anon_z05_157
                            	  7384:     even
