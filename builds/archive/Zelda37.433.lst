02:0003DAFA 41F900FF6AFE    	  1608:     lea     (NES_SRAM+$0AFE).l,A0
02:0003DB00 10303000        	  1609:     move.b  (A0,D3.W),D0
02:0003DB04 02000007        	  1610:     andi.b #$07,D0
02:0003DB08 E308            	  1611:     lsl.b  #1,D0   ; ASL A
02:0003DB0A E308            	  1612:     lsl.b  #1,D0   ; ASL A
02:0003DB0C E308            	  1613:     lsl.b  #1,D0   ; ASL A
02:0003DB0E E308            	  1614:     lsl.b  #1,D0   ; ASL A
                            	  1615:     ; Add the first Y where Link can come out of underground.
