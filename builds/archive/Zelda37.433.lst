                            	  5444:     ; If major state <> $30, go check other states.
                            	  5445:     ;
02:00048DDC 0C000030        	  5446:     cmpi.b  #$30,D0
02:00048DE0 6656            	  5447:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5448:     ; State $3x. Slow down.
                            	  5449:     ;
                            	  5450:     ; Reset grid offset for movement.
                            	  5451:     ;
