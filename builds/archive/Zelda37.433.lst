02:0003889E 41EC0084        	  1049:     lea     ($0084,A4),A0
02:000388A2 11802000        	  1050:     move.b  D0,(A0,D2.W)
                            	  1051:     ; Get the tile at that location.
                            	  1052:     ; If it's not a water tile, then go loop again.
