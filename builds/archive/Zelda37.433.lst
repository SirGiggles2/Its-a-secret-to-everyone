02:000393CE 4600            	  2699:     eori.b #$FF,D0
02:000393D0 023C00EE        	  2700:     andi    #$EE,CCR  ; CLC: clear C+X
02:000393D4 123C0001        	  2701:     move.b  #$01,D1
02:000393D8 D101            	  2702:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
