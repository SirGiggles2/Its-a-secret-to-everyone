02:00033986 41EC0201        	  2507:     lea     ($0201,A4),A0
02:0003398A 11803000        	  2508:     move.b  D0,(A0,D3.W)
02:0003398E 5303            	  2509:     subq.b  #1,D3
02:00033990 6AEA            	  2510:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033992 7600            	  2511:     moveq   #0,D3
