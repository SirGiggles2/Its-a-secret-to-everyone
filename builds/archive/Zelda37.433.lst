02:0003907C 10302000        	  2179:     move.b  (A0,D2.W),D0
02:00039080 0C000022        	  2180:     cmpi.b  #$22,D0
02:00039084 670000A6        	  2181:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2182:     ; Else we have an armos.
                            	  2183:     ;
                            	  2184:     ; Store stairs tile $70 in [00] for use later.
                            	  2185:     ;
02:00039088 7070            	  2186:     moveq   #112,D0
02:0003908A 1880            	  2187:     move.b  D0,($0000,A4)
                            	  2188:     ; Look for the current room ID in an array of room ID's that
                            	  2189:     ; have armos secrets.
