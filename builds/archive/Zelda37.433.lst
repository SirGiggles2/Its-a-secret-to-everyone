                            	  7041: ChangePlayMapSquareOW:
02:00040F1A 1002            	  7042:     move.b  D2,D0
02:00040F1C 1B00            	  7043:     move.b  D0,-(A5)  ; PHA
                            	  7044:     ; We're dealing with squares.
                            	  7045:     ; So, align the object's X coordinate with 16 pixels.
                            	  7046:     ;
02:00040F1E 10342070        	  7047:     move.b  ($70,A4,D2.W),D0
02:00040F22 020000F0        	  7048:     andi.b #$F0,D0
                            	  7049:     ; Divide it by 4 to get the offset of the address of the column
                            	  7050:     ; in play area map.
                            	  7051:     ;
                            	  7052:     ; The calculation is: address offset = (X / 8) * 2
                            	  7053:     ; 8 for the width of the column; 2 for the width of the address
                            	  7054:     ;
02:00040F26 E208            	  7055:     lsr.b  #1,D0   ; LSR A
02:00040F28 E208            	  7056:     lsr.b  #1,D0   ; LSR A
02:00040F2A 7400            	  7057:     moveq   #0,D2
02:00040F2C 1400            	  7058:     move.b  D0,D2
                            	  7059:     ; Store the address of the column in [00:01].
                            	  7060:     ;
02:00040F2E 41F900047120    	  7061:     lea     (PlayAreaColumnAddrs).l,A0
02:00040F34 10302000        	  7062:     move.b  (A0,D2.W),D0
02:00040F38 1880            	  7063:     move.b  D0,($0000,A4)
02:00040F3A 41F900047121    	  7064:     lea     (PlayAreaColumnAddrs+1).l,A0
02:00040F40 10302000        	  7065:     move.b  (A0,D2.W),D0
02:00040F44 19400001        	  7066:     move.b  D0,($0001,A4)
02:00040F48 101D            	  7067:     move.b  (A5)+,D0  ; PLA
02:00040F4A 1B00            	  7068:     move.b  D0,-(A5)  ; PHA
02:00040F4C 7400            	  7069:     moveq   #0,D2
02:00040F4E 1400            	  7070:     move.b  D0,D2
                            	  7071:     ; Align the object's Y coordinate with 16 pixels.
                            	  7072:     ;
02:00040F50 41EC0084        	  7073:     lea     ($0084,A4),A0
02:00040F54 10302000        	  7074:     move.b  (A0,D2.W),D0
02:00040F58 020000F0        	  7075:     andi.b #$F0,D0
                            	  7076:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7077:     ; the height of each row.
                            	  7078:     ;
02:00040F5C 003C0011        	  7079:     ori     #$11,CCR  ; SEC: set C+X
02:00040F60 123C0040        	  7080:     move.b  #$40,D1
02:00040F64 0A3C0010        	  7081:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040F68 9101            	  7082:     subx.b  D1,D0   ; SBC #$40
02:00040F6A 0A3C0010        	  7083:     eori    #$10,CCR  ; restore X = 6502 C
02:00040F6E E208            	  7084:     lsr.b  #1,D0   ; LSR A
02:00040F70 E208            	  7085:     lsr.b  #1,D0   ; LSR A
02:00040F72 E208            	  7086:     lsr.b  #1,D0   ; LSR A
                            	  7087:     ; Add this row offset to the column address.
                            	  7088:     ;
02:00040F74 4EB9000309B0    	  7089:     jsr     AddToInt16At0
                            	  7090:     ; Assume that we'll write a type 1 square with primary square
                            	  7091:     ; taken from [05]. If so, the square index doesn't matter
                            	  7092:     ; as long as >= $10. See WriteSquareOW.
                            	  7093:     ;
02:00040F7A 7600            	  7094:     moveq   #0,D3
02:00040F7C 7410            	  7095:     moveq   #16,D2
02:00040F7E 102C0005        	  7096:     move.b  ($0005,A4),D0
                            	  7097:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
