02:00038490 41EC00AC        	   476:     lea     ($00AC,A4),A0
02:00038494 11803000        	   477:     move.b  D0,(A0,D3.W)
                            	   478:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   479:     ;
02:00038498 103C00A0        	   480:     move.b  #$A0,D0
02:0003849C 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:000384A0 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   484:     ;
02:000384A4 7051            	   485:     moveq   #81,D0
02:000384A6 41EC0380        	   486:     lea     ($0380,A4),A0
02:000384AA 11803000        	   487:     move.b  D0,(A0,D3.W)
                            	   488:     ; Make it autonomous (ready to update on its own).
                            	   489:     ;
02:000384AE 7000            	   490:     moveq   #0,D0
02:000384B0 41EC0405        	   491:     lea     ($0405,A4),A0
02:000384B4 11803000        	   492:     move.b  D0,(A0,D3.W)
                            	   493:     ; The first animation frame lasts 3 screen frames.
                            	   494:     ;
02:000384B8 7003            	   495:     moveq   #3,D0
02:000384BA 41EC03D0        	   496:     lea     ($03D0,A4),A0
02:000384BE 11803000        	   497:     move.b  D0,(A0,D3.W)
                            	   498:     ; Have the monster wait a random amount of time, up to $3F frames.
