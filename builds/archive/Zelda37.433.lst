02:000388A6 4EB9000480F2    	  1054:     jsr     GetCollidableTileStill
02:000388AC 0C00008D        	  1055:     cmpi.b  #$8D,D0
02:000388B0 6512            	  1056:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:000388B2 0C000099        	  1057:     cmpi.b  #$99,D0
