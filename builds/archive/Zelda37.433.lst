                            	  5048: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5049:     ; Advance the substate.
                            	  5050:     ;
02:0003A534 41EC042C        	  5051:     lea     ($042C,A4),A0
02:0003A538 52302000        	  5052:     addq.b  #1,(A0,D2.W)
                            	  5053:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5054:     ;
02:0003A53C 41EC042C        	  5055:     lea     ($042C,A4),A0
02:0003A540 10302000        	  5056:     move.b  (A0,D2.W),D0
02:0003A544 0C000002        	  5057:     cmpi.b  #$02,D0
02:0003A548 6402            	  5058:     bcc.s  __far_z_04_0045
02:0003A54A 601C            	  5059:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5060: __far_z_04_0045:
                            	  5061:     ; New bloated substate >= 2.
                            	  5062:     ;
                            	  5063:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5064:     ; which will transition to state 0 (moving).
                            	  5065:     ;
                            	  5066:     ; Note that if the bomb hits >= 2, then:
                            	  5067:     ; - If new substate = 2, then substate 2 will wait,
                            	  5068:     ;   and then transition to substate 3.
                            	  5069:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5070:     ;
02:0003A54C 7600            	  5071:     moveq   #0,D3
02:0003A54E 41EC0437        	  5072:     lea     ($0437,A4),A0
02:0003A552 16302000        	  5073:     move.b  (A0,D2.W),D3
02:0003A556 0C030002        	  5074:     cmpi.b  #$02,D3
02:0003A55A 6502            	  5075:     bcs.s  __far_z_04_0046
02:0003A55C 600A            	  5076:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5077: __far_z_04_0046:
