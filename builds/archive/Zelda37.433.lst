02:000401E6 6606            	  5586:     bne  _anon_z05_119
                            	  5587:     ; Command 2 sets Link's timer to $30.
                            	  5588:     ;
02:000401E8 7630            	  5589:     moveq   #48,D3
02:000401EA 19430028        	  5590:     move.b  D3,($0028,A4)
                            	  5591: _anon_z05_119:
02:000401EE 02000003        	  5592:     andi.b #$03,D0
02:000401F2 003C0011        	  5593:     ori     #$11,CCR  ; SEC: set C+X
02:000401F6 123C0001        	  5594:     move.b  #$01,D1
02:000401FA 0A3C0010        	  5595:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000401FE 9101            	  5596:     subx.b  D1,D0   ; SBC #$01
02:00040200 0A3C0010        	  5597:     eori    #$10,CCR  ; restore X = 6502 C
02:00040204 02000002        	  5598:     andi.b #$02,D0
02:00040208 19400008        	  5599:     move.b  D0,($0008,A4)
