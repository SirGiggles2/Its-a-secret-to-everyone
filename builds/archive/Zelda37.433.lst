02:0003A646 1980203D        	  5206:     move.b  D0,($3D,A4,D2.W)
02:0003A64A 7008            	  5207:     moveq   #8,D0
02:0003A64C 4EB9000496E4    	  5208:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5209:     ; If facing left, then enable horizontal flipping.
                            	  5210:     ;
02:0003A652 41EC0098        	  5211:     lea     ($0098,A4),A0
02:0003A656 10302000        	  5212:     move.b  (A0,D2.W),D0
02:0003A65A 0C000002        	  5213:     cmpi.b  #$02,D0
02:0003A65E 6604            	  5214:     bne  _anon_z04_94
02:0003A660 522C000F        	  5215:     addq.b  #1,($000F,A4)
                            	  5216: _anon_z04_94:
                            	  5217:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  5218:     ; This is the base frame image.
                            	  5219:     ;
02:0003A664 E208            	  5220:     lsr.b  #1,D0   ; LSR A
02:0003A666 E208            	  5221:     lsr.b  #1,D0   ; LSR A
                            	  5222:     ; If movement frame = 1, add 3 to frame image to access
                            	  5223:     ; the second animation frame's images.
                            	  5224:     ;
02:0003A668 7600            	  5225:     moveq   #0,D3
02:0003A66A 41EC03E4        	  5226:     lea     ($03E4,A4),A0
02:0003A66E 16302000        	  5227:     move.b  (A0,D2.W),D3
02:0003A672 671E            	  5228:     beq  _anon_z04_95
02:0003A674 023C00EE        	  5229:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A678 123C0003        	  5230:     move.b  #$03,D1
02:0003A67C D101            	  5231:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  5232:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  5233:     ;
                            	  5234:     ; Down has two frame images, but up only has one. By flipping
                            	  5235:     ; horizontally, you get two frame images.
                            	  5236:     ;
02:0003A67E 7600            	  5237:     moveq   #0,D3
02:0003A680 41EC0098        	  5238:     lea     ($0098,A4),A0
02:0003A684 16302000        	  5239:     move.b  (A0,D2.W),D3
02:0003A688 0C030008        	  5240:     cmpi.b  #$08,D3
02:0003A68C 6604            	  5241:     bne  _anon_z04_95
02:0003A68E 522C000F        	  5242:     addq.b  #1,($000F,A4)
