                            	  8495:     even
                            	  8496: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	  8497:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8498:     ; In this case, I think it means Ganon is shouting.
                            	  8499:     ;
02:0003BF5A 0C000001        	  8500:     cmpi.b  #$01,D0
02:0003BF5E 6606            	  8501:     bne  _anon_z04_160
02:0003BF60 7002            	  8502:     moveq   #2,D0
02:0003BF62 19400601        	  8503:     move.b  D0,($0601,A4)
                            	  8504: _anon_z04_160:
02:0003BF66 0A3C0001        	  8505:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BF6A 4E75            	  8506:     rts
                            	  8507: 
                            	  8508: ; Description:
                            	  8509: ; Lift up the Triforce of Courage while the room is light.
                            	  8510: ;
                            	  8511: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8512: ;
                            	  8513:     even
                            	  8514: Ganon_ScenePhase1:
02:0003BF6C 701B            	  8515:     moveq   #27,D0
02:0003BF6E 19400505        	  8516:     move.b  D0,($0505,A4)
                            	  8517:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8518:     ;
02:0003BF72 102C0028        	  8519:     move.b  ($0028,A4),D0
02:0003BF76 6702            	  8520:     beq.s  __far_z_04_0093
02:0003BF78 6012            	  8521:     jmp  Ganon_DrawBodyFrame0
                            	  8522: __far_z_04_0093:
                            	  8523:     ; Once the timer expires:
                            	  8524:     ; 1. unhalt Link
                            	  8525:     ; 2. clear the item to lift
                            	  8526:     ; 3. play level 9 song
                            	  8527:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8528:     ;
02:0003BF7A 194000AC        	  8529:     move.b  D0,($00AC,A4)
02:0003BF7E 19400505        	  8530:     move.b  D0,($0505,A4)
02:0003BF82 7020            	  8531:     moveq   #32,D0
02:0003BF84 19400600        	  8532:     move.b  D0,($0600,A4)
02:0003BF88 522C0445        	  8533:     addq.b  #1,($0445,A4)
                            	  8534:     even
                            	  8535: Ganon_DrawBodyFrame0:
                            	  8536:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8537:     ; with animation frame 0.
                            	  8538:     ;
02:0003BF8C 7000            	  8539:     moveq   #0,D0
02:0003BF8E 41EC046B        	  8540:     lea     ($046B,A4),A0
02:0003BF92 11802000        	  8541:     move.b  D0,(A0,D2.W)
02:0003BF96 600002EC        	  8542:     jmp     Ganon_DrawBody
                            	  8543: 
                            	  8544: ; Description:
                            	  8545: ; Fighting Ganon.
                            	  8546: ;
                            	  8547: ; If Ganon is dying, go handle it.
                            	  8548: ;
                            	  8549:     even
                            	  8550: Ganon_ScenePhase2:
02:0003BF9A 41EC042C        	  8551:     lea     ($042C,A4),A0
02:0003BF9E 10302000        	  8552:     move.b  (A0,D2.W),D0
02:0003BFA2 6704            	  8553:     beq.s  __far_z_04_0094
02:0003BFA4 600000A4        	  8554:     jmp  Ganon_Dying
                            	  8555: __far_z_04_0094:
02:0003BFA8 61000356        	  8556:     jsr     Ganon_CheckCollisions
02:0003BFAC 6100C316        	  8557:     jsr     PlayBossHitCryIfNeeded
                            	  8558:     ; Go handle the brown state specially.
                            	  8559:     ;
02:0003BFB0 41EC00AC        	  8560:     lea     ($00AC,A4),A0
02:0003BFB4 10302000        	  8561:     move.b  (A0,D2.W),D0
02:0003BFB8 6702            	  8562:     beq.s  __far_z_04_0095
02:0003BFBA 6058            	  8563:     jmp  Ganon_UpdateBrownState
                            	  8564: __far_z_04_0095:
                            	  8565:     ; State = 0: Blue
                            	  8566:     ;
                            	  8567:     ; If timer = 0, then go move around and shoot.
                            	  8568:     ;
02:0003BFBC 10342028        	  8569:     move.b  ($28,A4,D2.W),D0
02:0003BFC0 6602            	  8570:     bne.s  __far_z_04_0096
02:0003BFC2 600E            	  8571:     jmp  Ganon_MoveAndShoot
                            	  8572: __far_z_04_0096:
                            	  8573:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8574:     ; Collisions were checked already.
                            	  8575:     ;
                            	  8576:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8577:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8578:     ;
02:0003BFC4 0C000001        	  8579:     cmpi.b  #$01,D0
02:0003BFC8 6702            	  8580:     beq.s  __far_z_04_0097
02:0003BFCA 6078            	  8581:     jmp  L_Ganon_DrawBody
                            	  8582: __far_z_04_0097:
                            	  8583: ; Description:
