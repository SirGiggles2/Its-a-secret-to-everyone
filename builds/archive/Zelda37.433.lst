                            	  8362: _anon_z04_159:
02:0003BE6C 61000CC0        	  8363:     jsr     DecreaseObjectAngle
                            	  8364:     ; Load Patra's maneuver index.
                            	  8365:     ; It determines which counts of bits are looked up below.
