02:0003BE16 9101            	  8324:     subx.b  D1,D0   ; SBC $00
02:0003BE18 0A3C0010        	  8325:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BE1C 41EC0084        	  8326:     lea     ($0084,A4),A0
