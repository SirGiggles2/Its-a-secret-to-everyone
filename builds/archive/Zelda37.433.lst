                            	  8954: Ganon_DrawBody:
                            	  8955:     ; Loop over four 16x16 images that make up Ganon.
                            	  8956:     ; There are 6 animation frames.
                            	  8957:     ;
02:0003C284 7603            	  8958:     moveq   #3,D3
                            	  8959:     even
                            	  8960: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8961:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8962:     ;
02:0003C286 10342070        	  8963:     move.b  ($70,A4,D2.W),D0
02:0003C28A 023C00EE        	  8964:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C28E 41F90003C278    	  8965:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C294 12303000        	  8966:     move.b  (A0,D3.W),D1
02:0003C298 D101            	  8967:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C29A 1880            	  8968:     move.b  D0,($0000,A4)
                            	  8969:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8970:     ;
02:0003C29C 41EC0084        	  8971:     lea     ($0084,A4),A0
02:0003C2A0 10302000        	  8972:     move.b  (A0,D2.W),D0
02:0003C2A4 023C00EE        	  8973:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2A8 41F90003C27C    	  8974:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C2AE 12303000        	  8975:     move.b  (A0,D3.W),D1
02:0003C2B2 D101            	  8976:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C2B4 19400001        	  8977:     move.b  D0,($0001,A4)
                            	  8978:     ; Each part has a horizontal flipping flag.
                            	  8979:     ;
02:0003C2B8 41F90003C280    	  8980:     lea     (GanonSpriteHFlips).l,A0
02:0003C2BE 10303000        	  8981:     move.b  (A0,D3.W),D0
02:0003C2C2 1940000F        	  8982:     move.b  D0,($000F,A4)
                            	  8983:     ; Save and copy the loop index (the current part) to [07].
                            	  8984:     ;
02:0003C2C6 1003            	  8985:     move.b  D3,D0
02:0003C2C8 1B00            	  8986:     move.b  D0,-(A5)  ; PHA
02:0003C2CA 19400007        	  8987:     move.b  D0,($0007,A4)
                            	  8988:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8989:     ; that make it up.
                            	  8990:     ;
02:0003C2CE 41EC046B        	  8991:     lea     ($046B,A4),A0
02:0003C2D2 10302000        	  8992:     move.b  (A0,D2.W),D0
02:0003C2D6 E308            	  8993:     lsl.b  #1,D0   ; ASL A
02:0003C2D8 E308            	  8994:     lsl.b  #1,D0   ; ASL A
                            	  8995:     ; Add [07] -- the index of the current part.
                            	  8996:     ;
                            	  8997:     ; Now you have an index into the frame image table, for the
                            	  8998:     ; current image part of the current animation frame.
                            	  8999:     ;
02:0003C2DA 122C0007        	  9000:     move.b  ($0007,A4),D1
02:0003C2DE D101            	  9001:     addx.b  D1,D0   ; ADC $07
02:0003C2E0 7600            	  9002:     moveq   #0,D3
02:0003C2E2 1600            	  9003:     move.b  D0,D3
02:0003C2E4 41F90003C260    	  9004:     lea     (GanonFrameImages).l,A0
02:0003C2EA 10303000        	  9005:     move.b  (A0,D3.W),D0
02:0003C2EE 4EB900030CFC    	  9006:     jsr     DrawObjectNotMirrored
02:0003C2F4 101D            	  9007:     move.b  (A5)+,D0  ; PLA
                            	  9008:     ; Bottom of the part loop.
                            	  9009:     ;
02:0003C2F6 7600            	  9010:     moveq   #0,D3
02:0003C2F8 1600            	  9011:     move.b  D0,D3
02:0003C2FA 5303            	  9012:     subq.b  #1,D3
02:0003C2FC 6A88            	  9013:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C2FE 4E75            	  9014:     rts
