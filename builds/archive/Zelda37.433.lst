02:00039A7A 6100EB96        	  3589:     jsr     DrawObjectNotMirroredOverLink
                            	  3590:     ; Store the offsets of the sprites to show over Link
                            	  3591:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
