                            	  2421: UpdatePondFairy:
02:00039204 61003562        	  2422:     jsr     DrawFairy
                            	  2423:     ; If not in state 0, then go handle states 1 to 3.
                            	  2424:     ;
02:00039208 102C00AD        	  2425:     move.b  ($00AD,A4),D0
