02:00039F8A 6608            	  4313:     bne  _anon_z04_85
02:00039F8C 41EC042C        	  4314:     lea     ($042C,A4),A0
02:00039F90 52302000        	  4315:     addq.b  #1,(A0,D2.W)
                            	  4316: _anon_z04_85:
                            	  4317:     ; If the 16-bit speed has not reached the 16-bit target speed, then return.
                            	  4318:     ;
