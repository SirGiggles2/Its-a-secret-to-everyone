                            	  2046: AnimateAndDrawObjectWalking:
02:00030CEE 4EB900049698    	  2047:     jsr     AnimateObjectWalking
02:00030CF4 1003            	  2048:     move.b  D3,D0
02:00030CF6 6004            	  2049:     jmp     DrawObjectNotMirrored
                            	  2050: 
                            	  2051: ; Params:
                            	  2052: ; A: frame image
                            	  2053: ; X: object index
                            	  2054: ; [00]: object X
                            	  2055: ; [01]: object Y
                            	  2056: ;
                            	  2057: ;
                            	  2058: ; Set [0C] mirrored.
                            	  2059:     even
                            	  2060: DrawObjectMirrored:
02:00030CF8 7601            	  2061:     moveq   #1,D3
02:00030CFA 6602            	  2062:     bne  _anon_z01_75
                            	  2063: ; Params:
                            	  2064: ; A: frame image
                            	  2065: ; X: object index
                            	  2066: ; [00]: object X
                            	  2067: ; [01]: object Y
                            	  2068: ; [0F]: flip horizontally
                            	  2069: ;
                            	  2070:     even
                            	  2071: DrawObjectNotMirrored:
02:00030CFC 7600            	  2072:     moveq   #0,D3
                            	  2073: _anon_z01_75:
02:00030CFE 1943000C        	  2074:     move.b  D3,($000C,A4)
                            	  2075:     ; Set animation index = object type + 1.
                            	  2076:     ;
02:00030D02 7600            	  2077:     moveq   #0,D3
02:00030D04 41EC034F        	  2078:     lea     ($034F,A4),A0
02:00030D08 16302000        	  2079:     move.b  (A0,D2.W),D3
                            	  2080: ; Params:
                            	  2081: ; A: frame
                            	  2082: ; X: object index/cycle sprite index
                            	  2083: ; Y: object type
                            	  2084: ; [00]: object X
                            	  2085: ; [01]: object Y
                            	  2086: ; [0C]: mirrored
                            	  2087: ; [0F]: flip horizontally
                            	  2088: ;
                            	  2089: ; Note:
                            	  2090: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2091: ;
                            	  2092: ; The animation index of most objects is (object type + 1),
                            	  2093: ; to make up for the fact that Link uses two animation indexes.
                            	  2094: ;
                            	  2095:     even
                            	  2096: DrawObjectWithType:
02:00030D0C 5203            	  2097:     addq.b  #1,D3
                            	  2098: ; Params:
                            	  2099: ; A: frame
                            	  2100: ; X: object index/cycle sprite index
                            	  2101: ; Y: animation index
                            	  2102: ; [00]: object X
                            	  2103: ; [01]: object Y
                            	  2104: ; [0C]: mirrored
                            	  2105: ; [0F]: flip horizontally
                            	  2106: ;
                            	  2107: ; Note:
                            	  2108: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2109: ; But Link uses [0F] for flipping without checking [0C].
                            	  2110: ;
                            	  2111: ;
                            	  2112: ; [0D] holds frame.
                            	  2113:     even
                            	  2114: DrawObjectWithAnim:
02:00030D0E 1940000D        	  2115:     move.b  D0,($000D,A4)
02:00030D12 1943000E        	  2116:     move.b  D3,($000E,A4)
02:00030D16 19420008        	  2117:     move.b  D2,($0008,A4)
                            	  2118:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  2119:     ;
02:00030D1A 7600            	  2120:     moveq   #0,D3
02:00030D1C 162C0341        	  2121:     move.b  ($0341,A4),D3
02:00030D20 41F900030CC4    	  2122:     lea     (SpriteOffsets).l,A0
02:00030D26 10303000        	  2123:     move.b  (A0,D3.W),D0
02:00030D2A 19400343        	  2124:     move.b  D0,($0343,A4)
