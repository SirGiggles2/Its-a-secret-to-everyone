                            	  8666: Ganon_Dying:
                            	  8667:     ; Ganon is dying.
                            	  8668:     ; Increment Ganon phase every frame.
                            	  8669:     ;
02:0003C04A 41EC042C        	  8670:     lea     ($042C,A4),A0
