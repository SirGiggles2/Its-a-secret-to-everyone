                            	   271: _anon_z05_3:
                            	   272:     ; If Start was pressed, then hide all sprites except
                            	   273:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   274:     ;
02:0003CCBE 102C00F8        	   275:     move.b  ($00F8,A4),D0
02:0003CCC2 02000010        	   276:     andi.b #$10,D0
02:0003CCC6 6606            	   277:     bne.s  __far_z_05_0000
02:0003CCC8 4EF90002E3C0    	   278:     jmp  Exit
