                            	  5001: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5002:     ; Bloated timer =>
                            	  5003:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5004:     ; 1:     go advance the substate
                            	  5005:     ; other: go decrement Bloated timer
                            	  5006:     ;
02:0003A4D6 7600            	  5007:     moveq   #0,D3
02:0003A4D8 41EC045E        	  5008:     lea     ($045E,A4),A0
02:0003A4DC 16302000        	  5009:     move.b  (A0,D2.W),D3
02:0003A4E0 5303            	  5010:     subq.b  #1,D3
02:0003A4E2 6750            	  5011:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A4E4 6B04            	  5012:     bmi.s  __far_z_04_0043
02:0003A4E6 60000080        	  5013:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5014: __far_z_04_0043:
                            	  5015:     ; Set the bloated timer according to the substate.
                            	  5016:     ;
02:0003A4EA 7600            	  5017:     moveq   #0,D3
02:0003A4EC 41EC042C        	  5018:     lea     ($042C,A4),A0
02:0003A4F0 16302000        	  5019:     move.b  (A0,D2.W),D3
02:0003A4F4 41F90003A432    	  5020:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A4FA 10303000        	  5021:     move.b  (A0,D3.W),D0
02:0003A4FE 41EC045E        	  5022:     lea     ($045E,A4),A0
02:0003A502 11802000        	  5023:     move.b  D0,(A0,D2.W)
                            	  5024:     ; If substate <> 0, go decrement bloated timer.
                            	  5025:     ;
02:0003A506 4A03            	  5026:     cmpi.b  #$00,D3
02:0003A508 6702            	  5027:     beq.s  __far_z_04_0044
02:0003A50A 605C            	  5028:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5029: __far_z_04_0044:
                            	  5030:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5031:     ;
02:0003A50C 7610            	  5032:     moveq   #16,D3
02:0003A50E 7000            	  5033:     moveq   #0,D0
02:0003A510 41EC00AC        	  5034:     lea     ($00AC,A4),A0
02:0003A514 11803000        	  5035:     move.b  D0,(A0,D3.W)
                            	  5036:     ; Increment the number of bomb hits.
                            	  5037:     ;
02:0003A518 41EC0437        	  5038:     lea     ($0437,A4),A0
02:0003A51C 10302000        	  5039:     move.b  (A0,D2.W),D0
02:0003A520 023C00EE        	  5040:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A524 123C0001        	  5041:     move.b  #$01,D1
02:0003A528 D101            	  5042:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A52A 41EC0437        	  5043:     lea     ($0437,A4),A0
02:0003A52E 11802000        	  5044:     move.b  D0,(A0,D2.W)
02:0003A532 6034            	  5045:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  5046: 
