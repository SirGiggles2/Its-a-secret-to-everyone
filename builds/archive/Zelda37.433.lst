02:0003C052 41EC042C        	  8674:     lea     ($042C,A4),A0
02:0003C056 10302000        	  8675:     move.b  (A0,D2.W),D0
02:0003C05A 660C            	  8676:     bne  _anon_z04_162
02:0003C05C 103C00FF        	  8677:     move.b  #$FF,D0
02:0003C060 41EC042C        	  8678:     lea     ($042C,A4),A0
02:0003C064 11802000        	  8679:     move.b  D0,(A0,D2.W)
                            	  8680: _anon_z04_162:
                            	  8681:     ; If Ganon phase < $50, then go draw only.
