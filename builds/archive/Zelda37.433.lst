02:00048C20 10302000        	  5196:     move.b  (A0,D2.W),D0
02:00048C24 0200000C        	  5197:     andi.b #$0C,D0
02:00048C28 6706            	  5198:     beq  _anon_z07_27
02:00048C2A 4EB900030938    	  5199:     jsr     MoveShot
