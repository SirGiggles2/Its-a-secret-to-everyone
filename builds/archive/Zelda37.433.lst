02:0003C1BA 6100FF7E        	  8853:     jsr     Ganon_DrawCloud
02:0003C1BE 6100009A        	  8854:     jsr     Ganon_GetCurCloudBottom
02:0003C1C2 6100FF76        	  8855:     jsr     Ganon_DrawCloud
                            	  8856:     ; Draw the left and right clouds.
                            	  8857:     ;
