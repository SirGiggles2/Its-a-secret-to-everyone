02:0003922E 7040            	  2447:     moveq   #64,D0
02:00039230 194000AC        	  2448:     move.b  D0,($00AC,A4)
02:00039234 19400063        	  2449:     move.b  D0,($0063,A4)
                            	  2450:     even
