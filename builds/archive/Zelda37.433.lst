                            	  4933: UpdateDodongoState0_Move:
                            	  4934:     ; If facing left, then push X offset 0 on the stack.
                            	  4935:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  4936:     ;
                            	  4937:     ; We would like to use one set of coordinates only.
                            	  4938:     ; But movement would break down, if we did; because
                            	  4939:     ; Dodongo is so long.
                            	  4940:     ;
                            	  4941:     ; So, when not facing left, we temporarily shift the
                            	  4942:     ; X coordinate to be closer to the other side of the monster.
                            	  4943:     ;
02:0003A450 7600            	  4944:     moveq   #0,D3
02:0003A452 41EC0098        	  4945:     lea     ($0098,A4),A0
02:0003A456 10302000        	  4946:     move.b  (A0,D2.W),D0
02:0003A45A 0200000D        	  4947:     andi.b #$0D,D0
02:0003A45E 6716            	  4948:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003A460 10342070        	  4949:     move.b  ($70,A4,D2.W),D0
02:0003A464 023C00EE        	  4950:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A468 123C0010        	  4951:     move.b  #$10,D1
02:0003A46C D101            	  4952:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A46E 19802070        	  4953:     move.b  D0,($70,A4,D2.W)
02:0003A472 163C00F0        	  4954:     move.b  #$F0,D3
                            	  4955:     even
                            	  4956: _L_z04_UpdateDodongoState0_Move_Move:
02:0003A476 1003            	  4957:     move.b  D3,D0
02:0003A478 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:0003A47A 7020            	  4959:     moveq   #32,D0
02:0003A47C 41EC041F        	  4960:     lea     ($041F,A4),A0
02:0003A480 11802000        	  4961:     move.b  D0,(A0,D2.W)
02:0003A484 6100DE6C        	  4962:     jsr     Wanderer_TargetPlayer
                            	  4963:     ; Pop the offset and add it to the X coordinate.
                            	  4964:     ;
                            	  4965:     ; This brings the X coordinate back to the unique value
                            	  4966:     ; that represents the position.
                            	  4967:     ;
02:0003A488 101D            	  4968:     move.b  (A5)+,D0  ; PLA
02:0003A48A 023C00EE        	  4969:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A48E 12342070        	  4970:     move.b  ($70,A4,D2.W),D1
02:0003A492 D101            	  4971:     addx.b  D1,D0   ; ADC ObjX,X
02:0003A494 19802070        	  4972:     move.b  D0,($70,A4,D2.W)
                            	  4973:     ; If X coordinate < $20, then face right.
                            	  4974:     ;
02:0003A498 0C000020        	  4975:     cmpi.b  #$20,D0
02:0003A49C 640A            	  4976:     bcc  _anon_z04_89
02:0003A49E 7001            	  4977:     moveq   #1,D0
02:0003A4A0 41EC0098        	  4978:     lea     ($0098,A4),A0
02:0003A4A4 11802000        	  4979:     move.b  D0,(A0,D2.W)
