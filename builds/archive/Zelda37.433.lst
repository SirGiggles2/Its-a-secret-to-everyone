02:0003C12C 41EC009A        	  8781:     lea     ($009A,A4),A0
02:0003C130 11803000        	  8782:     move.b  D0,(A0,D3.W)
02:0003C134 5303            	  8783:     subq.b  #1,D3
02:0003C136 6AC2            	  8784:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
