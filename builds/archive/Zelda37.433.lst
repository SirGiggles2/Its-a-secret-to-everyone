                            	  3443: Obj_Shove:
                            	  3444:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3445:     ; then go handle it separately.
                            	  3446:     ;
02:0004810C 41EC00C0        	  3447:     lea     ($00C0,A4),A0
02:00048110 10302000        	  3448:     move.b  (A0,D2.W),D0
02:00048114 E308            	  3449:     lsl.b  #1,D0   ; ASL A
02:00048116 6448            	  3450:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3451:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3452:     ;
