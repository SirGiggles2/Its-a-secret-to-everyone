                            	  7173: _L_z07_InitObject_InitMonsterFromEdge:
02:00049B26 7400            	  7174:     moveq   #0,D2
02:00049B28 142C0340        	  7175:     move.b  ($0340,A4),D2
                            	  7176:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7177:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7178:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7179:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7180:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7181:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7182:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7183:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7184:     ; corrupting them and causing a deterministic address-error
                            	  7185:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7186:     ; identified by Codex static review.)
                            	  7187: _L_z07_P47_pre_check:
02:00049B2C 102C0525        	  7188:     move.b  ($0525,A4),D0
02:00049B30 020000F0        	  7189:     andi.b  #$F0,D0
02:00049B34 0C000040        	  7190:     cmpi.b  #$40,D0
02:00049B38 6506            	  7191:     blo     _L_z07_P47_pre_snap
02:00049B3A 0C0000E0        	  7192:     cmpi.b  #$E0,D0
02:00049B3E 6506            	  7193:     blo     _L_z07_P47_pre_ok
                            	  7194: _L_z07_P47_pre_snap:
02:00049B40 197C00480525    	  7195:     move.b  #$48,($0525,A4)
                            	  7196: _L_z07_P47_pre_ok:
02:00049B46 7005            	  7197:     moveq   #5,D0
02:00049B48 610004F4        	  7198:     jsr     SwitchBank
02:00049B4C 4EB90003E8CC    	  7199:     jsr     FindNextEdgeSpawnCell
                            	  7200:     ; Post-walk 1: bottom-edge snap.
02:00049B52 102C0525        	  7201:     move.b  ($0525,A4),D0
02:00049B56 020000F0        	  7202:     andi.b  #$F0,D0
02:00049B5A 0C0000E0        	  7203:     cmpi.b  #$E0,D0
02:00049B5E 660C            	  7204:     bne     _L_z07_P47_post1_ok
02:00049B60 197C00480525    	  7205:     move.b  #$48,($0525,A4)
02:00049B66 4EB90003E8CC    	  7206:     jsr     FindNextEdgeSpawnCell
                            	  7207: _L_z07_P47_post1_ok:
                            	  7208:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7209:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:00049B6C 7600            	  7210:     moveq   #0,D3
02:00049B6E 162C0525        	  7211:     move.b  ($0525,A4),D3
02:00049B72 0243000F        	  7212:     andi.w  #$000F,D3
02:00049B76 C6FC002C        	  7213:     mulu.w  #44,D3
02:00049B7A 203C00FF6530    	  7214:     move.l  #$FF6530,D0
02:00049B80 D083            	  7215:     add.l   D3,D0
02:00049B82 7600            	  7216:     moveq   #0,D3
02:00049B84 162C0525        	  7217:     move.b  ($0525,A4),D3
02:00049B88 E84B            	  7218:     lsr.w   #4,D3
02:00049B8A 5943            	  7219:     subi.w  #4,D3
02:00049B8C E34B            	  7220:     lsl.w   #1,D3
02:00049B8E D083            	  7221:     add.l   D3,D0
02:00049B90 2040            	  7222:     movea.l D0,A0
02:00049B92 1010            	  7223:     move.b  (A0),D0
02:00049B94 0C000084        	  7224:     cmpi.b  #$84,D0
02:00049B98 6544            	  7225:     blo     _L_z07_P47_post2_ok
                            	  7226:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7227:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7228:     ; writes to the $05xx region.
02:00049B9A 7800            	  7229:     moveq   #0,D4
                            	  7230: _L_z07_P47_fb_loop:
02:00049B9C 41FAE566        	  7231:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049BA0 12304000        	  7232:     move.b  (A0,D4.W),D1
02:00049BA4 19410525        	  7233:     move.b  D1,($0525,A4)
                            	  7234:     ; Validate fallback cell walkable.
02:00049BA8 7600            	  7235:     moveq   #0,D3
02:00049BAA 1601            	  7236:     move.b  D1,D3
02:00049BAC 0243000F        	  7237:     andi.w  #$000F,D3
02:00049BB0 C6FC002C        	  7238:     mulu.w  #44,D3
02:00049BB4 203C00FF6530    	  7239:     move.l  #$FF6530,D0
02:00049BBA D083            	  7240:     add.l   D3,D0
02:00049BBC 7600            	  7241:     moveq   #0,D3
02:00049BBE 1601            	  7242:     move.b  D1,D3
02:00049BC0 E84B            	  7243:     lsr.w   #4,D3
02:00049BC2 5943            	  7244:     subi.w  #4,D3
02:00049BC4 E34B            	  7245:     lsl.w   #1,D3
02:00049BC6 D083            	  7246:     add.l   D3,D0
02:00049BC8 2040            	  7247:     movea.l D0,A0
02:00049BCA 0C100084        	  7248:     cmpi.b  #$84,(A0)
02:00049BCE 650E            	  7249:     blo     _L_z07_P47_post2_ok
02:00049BD0 5204            	  7250:     addq.b  #1,D4
02:00049BD2 0C040008        	  7251:     cmpi.b  #8,D4
02:00049BD6 65C4            	  7252:     blo     _L_z07_P47_fb_loop
                            	  7253:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7254:     ; rather than looping).
02:00049BD8 197C00480525    	  7255:     move.b  #$48,($0525,A4)
                            	  7256: _L_z07_P47_post2_ok:
                            	  7257:     ; Extract and set the monster's location.
                            	  7258:     ;
02:00049BDE 102C0525        	  7259:     move.b  ($0525,A4),D0
                            	  7260:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7261:     ;
02:00049BE2 1B00            	  7262:     move.b  D0,-(A5)  ; PHA
02:00049BE4 E308            	  7263:     lsl.b  #1,D0   ; ASL A
02:00049BE6 E308            	  7264:     lsl.b  #1,D0   ; ASL A
02:00049BE8 E308            	  7265:     lsl.b  #1,D0   ; ASL A
02:00049BEA E308            	  7266:     lsl.b  #1,D0   ; ASL A
02:00049BEC 19802070        	  7267:     move.b  D0,($70,A4,D2.W)
                            	  7268:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7269:     ;
02:00049BF0 101D            	  7270:     move.b  (A5)+,D0  ; PLA
02:00049BF2 020000F0        	  7271:     andi.b #$F0,D0
02:00049BF6 003C0011        	  7272:     ori     #$11,CCR  ; SEC: set C+X
02:00049BFA 123C0003        	  7273:     move.b  #$03,D1
02:00049BFE 0A3C0010        	  7274:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049C02 9101            	  7275:     subx.b  D1,D0   ; SBC #$03
02:00049C04 0A3C0010        	  7276:     eori    #$10,CCR  ; restore X = 6502 C
02:00049C08 41EC0084        	  7277:     lea     ($0084,A4),A0
02:00049C0C 11802000        	  7278:     move.b  D0,(A0,D2.W)
                            	  7279:     ; Set the monsters-from-edges long timer to a random value
                            	  7280:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7281:     ;
02:00049C10 10342019        	  7282:     move.b  ($19,A4,D2.W),D0
02:00049C14 02000003        	  7283:     andi.b #$03,D0
02:00049C18 023C00EE        	  7284:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049C1C 123C0002        	  7285:     move.b  #$02,D1
02:00049C20 D101            	  7286:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049C22 1940004B        	  7287:     move.b  D0,($004B,A4)
                            	  7288:     ; If the distance to Link is too close to Link, then
                            	  7289:     ; go flag the monster uninitialized again, so we can
                            	  7290:     ; try to spawn it again next time.
                            	  7291:     ;
02:00049C26 7005            	  7292:     moveq   #5,D0
02:00049C28 61000414        	  7293:     jsr     SwitchBank
02:00049C2C 4EB90003DEE0    	  7294:     jsr     IsDistanceSafeToSpawn
02:00049C32 6500FEB4        	  7295:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7296:     ; OK to spawn.
                            	  7297:     ; In this situation, monsters don't spawn from a cloud.
                            	  7298:     ;
02:00049C36 7000            	  7299:     moveq   #0,D0
02:00049C38 41EC0405        	  7300:     lea     ($0405,A4),A0
02:00049C3C 11802000        	  7301:     move.b  D0,(A0,D2.W)
                            	  7302:     even
                            	  7303: _L_z07_InitObject_NormalSpawn:
