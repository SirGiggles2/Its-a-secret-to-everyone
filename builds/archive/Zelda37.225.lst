02:0003B124 12303000        	  3811:     move.b  (A0,D3.W),D1
02:0003B128 B001            	  3812:     cmp.b   D1,D0
02:0003B12A 6648            	  3813:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3814:     ; The secret (usually stairs) is under one of the armoses.
