02:0003A074 0A3C0010        	  1393:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A078 1940052E        	  1394:     move.b  D0,($052E,A4)
02:0003A07C 0A3C0001        	  1395:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A080 4E75            	  1396:     rts
