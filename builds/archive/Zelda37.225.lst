                            	  5830:     ; except turn 4 into 8.
                            	  5831:     ;
02:00043830 0C000005        	  5832:     cmpi.b  #$05,D0
02:00043834 642A            	  5833:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
