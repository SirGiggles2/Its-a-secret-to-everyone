02:00043590 10303000        	  5495:     move.b  (A0,D3.W),D0
02:00043594 7600            	  5496:     moveq   #0,D3
02:00043596 162C0003        	  5497:     move.b  ($0003,A4),D3
02:0004359A 0C030002        	  5498:     cmpi.b  #$02,D3
02:0004359E 6510            	  5499:     bcs  _anon_z05_106
02:000435A0 7600            	  5500:     moveq   #0,D3
02:000435A2 162C00EB        	  5501:     move.b  ($00EB,A4),D3
02:000435A6 41F900FF68FE    	  5502:     lea     (NES_SRAM+$08FE).l,A0
02:000435AC 10303000        	  5503:     move.b  (A0,D3.W),D0
                            	  5504: _anon_z05_106:
02:000435B0 1880            	  5505:     move.b  D0,($0000,A4)
