                            	  7845: UpdatePolsVoice:
02:0003CE0A 0C020001        	  7846:     cmpi.b  #$01,D2
                            	  7847:     bne  _anon_z04_96
                            	  7848: _anon_z04_96:
                            	  7849:     ; If we have the magic clock, or is stunned, then
                            	  7850:     ; go draw and check collisions.
                            	  7851:     ;
02:0003CE0E 102C066C        	  7852:     move.b  ($066C,A4),D0
02:0003CE12 1234203D        	  7853:     move.b  ($3D,A4,D2.W),D1
02:0003CE16 8001            	  7854:     or.b  D1,D0
02:0003CE18 660000AE        	  7855:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7856:     ; Every odd screen frame, go straight to drawing
                            	  7857:     ; and checking collisions.
                            	  7858:     ;
02:0003CE1C 102C0015        	  7859:     move.b  ($0015,A4),D0
02:0003CE20 E208            	  7860:     lsr.b  #1,D0   ; LSR A
02:0003CE22 6404            	  7861:     bcc.s  __far_z_04_0073
02:0003CE24 60000118        	  7862:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7863: __far_z_04_0073:
                            	  7864:     ; Otherwise move horizontally.
                            	  7865:     ;
02:0003CE28 610002A8        	  7866:     jsr     PolsVoice_MoveX
                            	  7867:     ; If state <> 0, then the monster is jumping.
                            	  7868:     ; Go handle vertical movement.
                            	  7869:     ;
02:0003CE2C 41EC00AC        	  7870:     lea     ($00AC,A4),A0
02:0003CE30 10302000        	  7871:     move.b  (A0,D2.W),D0
02:0003CE34 6706            	  7872:     beq  _L_z04_UpdatePolsVoice_State0
02:0003CE36 61000130        	  7873:     jsr     UpdatePolsVoiceState1_Jumping
02:0003CE3A 6034            	  7874:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
