                            	 12553: _anon_z04_159:
02:0003F130 61000EAE        	 12554:     jsr     DecreaseObjectAngle
                            	 12555:     ; Load Patra's maneuver index.
                            	 12556:     ; It determines which counts of bits are looked up below.
                            	 12557:     ;
02:0003F134 7600            	 12558:     moveq   #0,D3
02:0003F136 162C045F        	 12559:     move.b  ($045F,A4),D3
                            	 12560:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12561:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12562:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12563:     ;
02:0003F13A 41EC034F        	 12564:     lea     ($034F,A4),A0
02:0003F13E 10302000        	 12565:     move.b  (A0,D2.W),D0
02:0003F142 0C000025        	 12566:     cmpi.b  #$25,D0
02:0003F146 661E            	 12567:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F148 41F90003F03A    	 12568:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F14E 10303000        	 12569:     move.b  (A0,D3.W),D0
02:0003F152 1B00            	 12570:     move.b  D0,-(A5)  ; PHA
02:0003F154 41F90003F03E    	 12571:     lea     (PatraChild1RotationSineBits).l,A0
