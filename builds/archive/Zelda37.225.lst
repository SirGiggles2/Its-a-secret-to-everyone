                            	  8504: _anon_z05_174:
                            	  8505:     ; Two input directions, and at least one of them is walkable.
                            	  8506:     ;
                            	  8507:     ; Make Link go straight in one direction on the next grid line.
                            	  8508:     ;
02:00044FC8 7600            	  8509:     moveq   #0,D3
02:00044FCA 1600            	  8510:     move.b  D0,D3
02:00044FCC 522C0057        	  8511:     addq.b  #1,($0057,A4)
                            	  8512:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8513:     ; object direction and input direction to last walkable direction
                            	  8514:     ; found, and set Link's speed.
                            	  8515:     ;
                            	  8516:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8517:     ;
02:00044FD0 7400            	  8518:     moveq   #0,D2
02:00044FD2 102C000D        	  8519:     move.b  ($000D,A4),D0
02:00044FD6 0C030001        	  8520:     cmpi.b  #$01,D3
02:00044FDA 67000096        	  8521:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
