02:0003C522 122C0002        	  6576:     move.b  ($0002,A4),D1
02:0003C526 E309            	  6577:     lsl.b  #1,D1   ; ASL $02
02:0003C528 19410002        	  6578:     move.b  D1,($0002,A4)
02:0003C52C 122C0002        	  6579:     move.b  ($0002,A4),D1
02:0003C530 C200            	  6580:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C532 6716            	  6581:     beq  _L_z04_Digdogger_Move_Up
02:0003C534 41EC0084        	  6582:     lea     ($0084,A4),A0
02:0003C538 10302000        	  6583:     move.b  (A0,D2.W),D0
02:0003C53C 122C0003        	  6584:     move.b  ($0003,A4),D1
02:0003C540 D101            	  6585:     addx.b  D1,D0   ; ADC $03
02:0003C542 41EC0084        	  6586:     lea     ($0084,A4),A0
02:0003C546 11802000        	  6587:     move.b  D0,(A0,D2.W)
                            	  6588:     even
