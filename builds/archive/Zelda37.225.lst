02:0002E26A 7402            	   906:     moveq   #2,D2
                            	   907:     even
                            	   908: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_LoopWare:
                            	   909:     ; If this item is nothing, then loop again.
                            	   910:     ;
02:0002E26C 41EC0422        	   911:     lea     ($0422,A4),A0
02:0002E270 10302000        	   912:     move.b  (A0,D2.W),D0
02:0002E274 0200003F        	   913:     andi.b #$3F,D0
02:0002E278 0C00003F        	   914:     cmpi.b  #$3F,D0
02:0002E27C 6732            	   915:     beq  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   916:     ; If Link's X <> item's X, then loop again.
                            	   917:     ;
02:0002E27E 102C0070        	   918:     move.b  ($0070,A4),D0
02:0002E282 41F90002DFFC    	   919:     lea     (CaveWareXs).l,A0
02:0002E288 12302000        	   920:     move.b  (A0,D2.W),D1
02:0002E28C B001            	   921:     cmp.b   D1,D0
02:0002E28E 6620            	   922:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   923:     ; If the vertical distance between Link and the item < 6, then
                            	   924:     ; go try to take it.
                            	   925:     ;
02:0002E290 102C0084        	   926:     move.b  ($0084,A4),D0
02:0002E294 003C0011        	   927:     ori     #$11,CCR  ; SEC: set C+X
02:0002E298 123C0098        	   928:     move.b  #$98,D1
02:0002E29C 0A3C0010        	   929:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E2A0 9101            	   930:     subx.b  D1,D0   ; SBC #$98
02:0002E2A2 0A3C0010        	   931:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E2A6 61002884        	   932:     jsr     Abs
02:0002E2AA 0C000006        	   933:     cmpi.b  #$06,D0
02:0002E2AE 6506            	   934:     bcs  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_PickedUp
                            	   935:     even
                            	   936: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare:
                            	   937:     ; Bottom of the item touch loop.
                            	   938:     ;
