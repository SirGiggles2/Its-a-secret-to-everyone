02:000446D0 020000F0        	  7587:     andi.b #$F0,D0
                            	  7588:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7589:     ; the height of each row.
                            	  7590:     ;
02:000446D4 003C0011        	  7591:     ori     #$11,CCR  ; SEC: set C+X
02:000446D8 123C0040        	  7592:     move.b  #$40,D1
02:000446DC 0A3C0010        	  7593:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000446E0 9101            	  7594:     subx.b  D1,D0   ; SBC #$40
02:000446E2 0A3C0010        	  7595:     eori    #$10,CCR  ; restore X = 6502 C
02:000446E6 E208            	  7596:     lsr.b  #1,D0   ; LSR A
02:000446E8 E208            	  7597:     lsr.b  #1,D0   ; LSR A
02:000446EA E208            	  7598:     lsr.b  #1,D0   ; LSR A
                            	  7599:     ; Add this row offset to the column address.
                            	  7600:     ;
02:000446EC 4EB900030F7E    	  7601:     jsr     AddToInt16At0
                            	  7602:     ; Assume that we'll write a type 1 square with primary square
                            	  7603:     ; taken from [05]. If so, the square index doesn't matter
                            	  7604:     ; as long as >= $10. See WriteSquareOW.
                            	  7605:     ;
02:000446F2 7600            	  7606:     moveq   #0,D3
02:000446F4 7410            	  7607:     moveq   #16,D2
02:000446F6 102C0005        	  7608:     move.b  ($0005,A4),D0
                            	  7609:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7610:     ; So, we have to look up the square index corresponding
                            	  7611:     ; to primary square/tile in [05].
                            	  7612:     ;
