                            	  7176: __far_z_04_0065:
                            	  7177:     ; New bloated substate >= 2.
                            	  7178:     ;
                            	  7179:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7180:     ; which will transition to state 0 (moving).
                            	  7181:     ;
                            	  7182:     ; Note that if the bomb hits >= 2, then:
                            	  7183:     ; - If new substate = 2, then substate 2 will wait,
                            	  7184:     ;   and then transition to substate 3.
                            	  7185:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7186:     ;
02:0003C9A4 7600            	  7187:     moveq   #0,D3
02:0003C9A6 41EC0437        	  7188:     lea     ($0437,A4),A0
02:0003C9AA 16302000        	  7189:     move.b  (A0,D2.W),D3
02:0003C9AE 0C030002        	  7190:     cmpi.b  #$02,D3
