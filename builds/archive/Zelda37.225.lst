                            	 10067: _L_z04_UpdateGohma_AnimateEye:
                            	 10068:     ; Animate the eye.
                            	 10069:     ;
                            	 10070:     ; First, if the counter for when to open the eye next = 0, then
                            	 10071:     ; set it to a random value at least $C0; and set the timer for
                            	 10072:     ; keeping the eye open to $80.
                            	 10073:     ;
                            	 10074:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10075:     ; every other frame.
                            	 10076:     ;
02:0003DEE8 41EC042C        	 10077:     lea     ($042C,A4),A0
02:0003DEEC 10302000        	 10078:     move.b  (A0,D2.W),D0
02:0003DEF0 661E            	 10079:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEF2 103C0080        	 10080:     move.b  #$80,D0
02:0003DEF6 41EC0444        	 10081:     lea     ($0444,A4),A0
02:0003DEFA 11802000        	 10082:     move.b  D0,(A0,D2.W)
02:0003DEFE 103C00C0        	 10083:     move.b  #$C0,D0
02:0003DF02 12342018        	 10084:     move.b  ($18,A4,D2.W),D1
02:0003DF06 8001            	 10085:     or.b  D1,D0
02:0003DF08 41EC042C        	 10086:     lea     ($042C,A4),A0
02:0003DF0C 11802000        	 10087:     move.b  D0,(A0,D2.W)
                            	 10088:     even
                            	 10089: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10090:     ; Decrement the next-open-eye counter.
                            	 10091:     ;
02:0003DF10 102C0015        	 10092:     move.b  ($0015,A4),D0
02:0003DF14 E208            	 10093:     lsr.b  #1,D0   ; LSR A
02:0003DF16 6408            	 10094:     bcc  _anon_z04_122
02:0003DF18 41EC042C        	 10095:     lea     ($042C,A4),A0
02:0003DF1C 53302000        	 10096:     subq.b  #1,(A0,D2.W)
                            	 10097: _anon_z04_122:
                            	 10098:     ; If open eye timer = 0, then the eye is closed.
                            	 10099:     ; Go animate it differently.
                            	 10100:     ;
02:0003DF20 41EC0444        	 10101:     lea     ($0444,A4),A0
02:0003DF24 10302000        	 10102:     move.b  (A0,D2.W),D0
02:0003DF28 674A            	 10103:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10104:     ; Else decrement the open eye timer.
                            	 10105:     ;
02:0003DF2A 41EC0444        	 10106:     lea     ($0444,A4),A0
02:0003DF2E 53302000        	 10107:     subq.b  #1,(A0,D2.W)
                            	 10108:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10109:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10110:     ;
02:0003DF32 7602            	 10111:     moveq   #2,D3
02:0003DF34 0C000070        	 10112:     cmpi.b  #$70,D0
02:0003DF38 6408            	 10113:     bcc  _anon_z04_123
02:0003DF3A 0C000010        	 10114:     cmpi.b  #$10,D0
02:0003DF3E 6502            	 10115:     bcs  _anon_z04_123
02:0003DF40 5203            	 10116:     addq.b  #1,D3
                            	 10117: _anon_z04_123:
02:0003DF42 1003            	 10118:     move.b  D3,D0
                            	 10119:     even
                            	 10120: _L_z04_UpdateGohma_SetEyeStateAndShoot:
