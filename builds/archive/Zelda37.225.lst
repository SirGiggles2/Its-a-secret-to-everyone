02:0004CC88 1940000C        	  6333:     move.b  D0,($000C,A4)
                            	  6334:     ; Calculate sprite attributes.
                            	  6335:     ;
                            	  6336:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6337:     ;   base attribute OR 1
                            	  6338:     ; So, it uses palette row 5.
                            	  6339:     ;
02:0004CC8C 41F90004C6B6    	  6340:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004CC92 10303000        	  6341:     move.b  (A0,D3.W),D0
02:0004CC96 0C02000D        	  6342:     cmpi.b  #$0D,D2
