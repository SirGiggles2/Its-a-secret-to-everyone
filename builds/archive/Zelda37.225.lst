                            	  2665: ; PATCH P25b: FS2-E backspace handler.
                            	  2666: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2667: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2668: ; one column (8 px), and writes a space ($24) to the erased
                            	  2669: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2670: ; cannot cross into a previous slot's name field.
                            	  2671: _L_z02_ModeE_HandleAOrB_Backspace:
02:00034DEC 7600            	  2672:     moveq   #0,D3
02:00034DEE 162C0016        	  2673:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00034DF2 41F90003470A    	  2674:     lea     (SlotToNameOffset).l,A0
02:00034DF8 12303000        	  2675:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00034DFC 102C0421        	  2676:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00034E00 B001            	  2677:     cmp.b   D1,D0
02:00034E02 6322            	  2678:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00034E04 5300            	  2679:     subq.b  #1,D0
02:00034E06 19400421        	  2680:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00034E0A 532C0423        	  2681:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00034E0E 122C0070        	  2682:     move.b  ($0070,A4),D1
02:00034E12 5101            	  2683:     subi.b  #8,D1
02:00034E14 19410070        	  2684:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00034E18 7224            	  2685:     moveq   #$24,D1              ; space tile
02:00034E1A 7600            	  2686:     moveq   #0,D3
02:00034E1C 1600            	  2687:     move.b  D0,D3                ; D3 = erased offset
02:00034E1E 41EC0638        	  2688:     lea     ($0638,A4),A0
02:00034E22 11813000        	  2689:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2690:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2691:     even
