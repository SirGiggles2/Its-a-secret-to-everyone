                            	  6287: _anon_z05_122:
                            	  6288:     ; If the door command = 4 after incrementing it, then
                            	  6289:     ; it was 3 (close door). So:
                            	  6290:     ; 1. reset this door's flag
                            	  6291:     ; 2. remove it from the opened door mask
                            	  6292:     ; 3. reset the door command
                            	  6293:     ; 4. go lay out doors in the play area map
                            	  6294:     ;
02:00043B0C 102C0054        	  6295:     move.b  ($0054,A4),D0
02:00043B10 0C000004        	  6296:     cmpi.b  #$04,D0
02:00043B14 6626            	  6297:     bne  _anon_z05_123
02:00043B16 7400            	  6298:     moveq   #0,D2
02:00043B18 142C0009        	  6299:     move.b  ($0009,A4),D2
02:00043B1C 6100DAEC        	  6300:     jsr     ResetDoorFlag
02:00043B20 102C0055        	  6301:     move.b  ($0055,A4),D0
02:00043B24 0A00000F        	  6302:     eori.b #$0F,D0
02:00043B28 122C00EE        	  6303:     move.b  ($00EE,A4),D1
02:00043B2C C001            	  6304:     and.b  D1,D0
                            	  6305:     even
                            	  6306: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043B2E 194000EE        	  6307:     move.b  D0,($00EE,A4)
                            	  6308:     even
                            	  6309: L_ResetDoorCmdAndLayOutDoors:
02:00043B32 7000            	  6310:     moveq   #0,D0
02:00043B34 19400054        	  6311:     move.b  D0,($0054,A4)
02:00043B38 6000FCD4        	  6312:     jmp     LayOutDoors
                            	  6313: 
                            	  6314: _anon_z05_123:
                            	  6315:     ; Door command <> 4.
                            	  6316:     ; It must be 8, which means it was 7: open door.
                            	  6317:     ;
                            	  6318:     ; If the door is a shutter (7), then go add the door to the
                            	  6319:     ; opened door mask, reset door command, and lay out doors.
                            	  6320:     ;
02:00043B3C 102C0055        	  6321:     move.b  ($0055,A4),D0
02:00043B40 19400002        	  6322:     move.b  D0,($0002,A4)
02:00043B44 6100FA32        	  6323:     jsr     FindDoorAttrByDoorBit
02:00043B48 0C000007        	  6324:     cmpi.b  #$07,D0
02:00043B4C 676E            	  6325:     beq  _anon_z05_124
                            	  6326:     ; Else the door is not a shutter.
                            	  6327:     ;
                            	  6328:     ;
                            	  6329:     ; [09] door direction index
02:00043B4E 7400            	  6330:     moveq   #0,D2
02:00043B50 142C0009        	  6331:     move.b  ($0009,A4),D2
02:00043B54 6100DAAE        	  6332:     jsr     SetDoorFlag
                            	  6333:     ; Get the next room's ID.
                            	  6334:     ;
02:00043B58 1003            	  6335:     move.b  D3,D0
02:00043B5A 023C00EE        	  6336:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043B5E 41F900043A1A    	  6337:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043B64 12302000        	  6338:     move.b  (A0,D2.W),D1
02:00043B68 D101            	  6339:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043B6A 7600            	  6340:     moveq   #0,D3
02:00043B6C 1600            	  6341:     move.b  D0,D3
                            	  6342:     ; Flip the door direction index.
                            	  6343:     ;
02:00043B6E 1002            	  6344:     move.b  D2,D0
02:00043B70 0A000001        	  6345:     eori.b #$01,D0
02:00043B74 7400            	  6346:     moveq   #0,D2
02:00043B76 1400            	  6347:     move.b  D0,D2
                            	  6348:     ; Set the door flag for the opposite door in the next room.
                            	  6349:     ;
02:00043B78 1214            	  6350:     move.b  ($00,A4),D1   ; ptr lo
02:00043B7A 182C0001        	  6351:     move.b  ($01,A4),D4  ; ptr hi
02:00043B7E 024100FF        	  6352:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043B82 E14C            	  6353:     lsl.w   #8,D4
02:00043B84 8841            	  6354:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043B86 48C4            	  6355:     ext.l   D4
02:00043B88 D8BC00FF0000    	  6356:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043B8E 2044            	  6357:     movea.l D4,A0
02:00043B90 10303000        	  6358:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043B94 41F90004AD80    	  6359:     lea     (LevelMasks).l,A0
02:00043B9A 12302000        	  6360:     move.b  (A0,D2.W),D1
02:00043B9E 8001            	  6361:     or.b  D1,D0
02:00043BA0 1214            	  6362:     move.b  ($00,A4),D1   ; ptr lo
02:00043BA2 182C0001        	  6363:     move.b  ($01,A4),D4  ; ptr hi
02:00043BA6 024100FF        	  6364:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043BAA E14C            	  6365:     lsl.w   #8,D4
02:00043BAC 8841            	  6366:     or.w    D1,D4
02:00043BAE 48C4            	  6367:     ext.l   D4
02:00043BB0 D8BC00FF0000    	  6368:     add.l   #NES_RAM,D4
02:00043BB6 2044            	  6369:     movea.l D4,A0
02:00043BB8 11803000        	  6370:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6371: _anon_z05_124:
                            	  6372:     ; Add the door to the opened door mask, reset door command,
                            	  6373:     ; and lay out doors.
                            	  6374:     ;
02:00043BBC 102C0055        	  6375:     move.b  ($0055,A4),D0
02:00043BC0 122C00EE        	  6376:     move.b  ($00EE,A4),D1
02:00043BC4 8001            	  6377:     or.b  D1,D0
02:00043BC6 6000FF66        	  6378:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6379: 
                            	  6380: ; Params:
                            	  6381: ; [08]: 0 if closed
                            	  6382: ;
                            	  6383: ; Returns:
                            	  6384: ; X: current length of dynamic transfer buf
                            	  6385: ; [00]: door VRAM address high byte
                            	  6386: ; [01]: door VRAM address low byte
                            	  6387: ; [02:03]: address of door tiles for direction and face
                            	  6388: ; [05]: 2, the number of transfer records to write
                            	  6389: ; [06]: 2, the number of tiles in each record
                            	  6390: ; [07]: 0, the first index of a tile to transfer
                            	  6391: ; [09]: door direction index
                            	  6392: ;
                            	  6393: ; Note that this routine is called with triggered doors:
                            	  6394: ; doors that can change state. Their door type numbers are >= 4.
                            	  6395: ;
                            	  6396: ; If this routine were ever called with a fixed door
                            	  6397: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6398: ; values for the door face.
                            	  6399: ;
                            	  6400: ;
                            	  6401: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6402: ;
                            	  6403:     even
                            	  6404: PrepareWriteHorizontalDoorTransferRecords:
02:00043BCA 102C0055        	  6405:     move.b  ($0055,A4),D0
02:00043BCE 19400002        	  6406:     move.b  D0,($0002,A4)
02:00043BD2 6100F9A4        	  6407:     jsr     FindDoorAttrByDoorBit
02:00043BD6 0C000005        	  6408:     cmpi.b  #$05,D0
02:00043BDA 650C            	  6409:     bcs  _anon_z05_125
02:00043BDC 1B00            	  6410:     move.b  D0,-(A5)  ; PHA
02:00043BDE 7004            	  6411:     moveq   #4,D0
02:00043BE0 4EB900030670    	  6412:     jsr     PlaySample
02:00043BE6 101D            	  6413:     move.b  (A5)+,D0  ; PLA
                            	  6414: _anon_z05_125:
                            	  6415:     ; Calculate the door face index in three parts.
                            	  6416:     ;
                            	  6417:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6418:     ; (provisional face index in Y register).
                            	  6419:     ;
02:00043BE8 0C000004        	  6420:     cmpi.b  #$04,D0
02:00043BEC 6602            	  6421:     bne  _anon_z05_126
02:00043BEE 7008            	  6422:     moveq   #8,D0
                            	  6423: _anon_z05_126:
02:00043BF0 0C000001        	  6424:     cmpi.b  #$01,D0
02:00043BF4 6602            	  6425:     bne  _anon_z05_127
02:00043BF6 7004            	  6426:     moveq   #4,D0
                            	  6427: _anon_z05_127:
                            	  6428:     ; Second, subtract 3 from provisional face index.
                            	  6429:     ;
02:00043BF8 003C0011        	  6430:     ori     #$11,CCR  ; SEC: set C+X
02:00043BFC 123C0003        	  6431:     move.b  #$03,D1
02:00043C00 0A3C0010        	  6432:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C04 9101            	  6433:     subx.b  D1,D0   ; SBC #$03
02:00043C06 0A3C0010        	  6434:     eori    #$10,CCR  ; restore X = 6502 C
02:00043C0A 7600            	  6435:     moveq   #0,D3
02:00043C0C 1600            	  6436:     move.b  D0,D3
                            	  6437:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6438:     ; face index >= 3, then subtract 1 from it.
                            	  6439:     ;
                            	  6440:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6441:     ; then make it 1.
                            	  6442:     ;
02:00043C0E 102C0008        	  6443:     move.b  ($0008,A4),D0
02:00043C12 6708            	  6444:     beq  _anon_z05_128
02:00043C14 0C030005        	  6445:     cmpi.b  #$05,D3
02:00043C18 670A            	  6446:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043C1A 7601            	  6447:     moveq   #1,D3
                            	  6448: _anon_z05_128:
02:00043C1C 0C030003        	  6449:     cmpi.b  #$03,D3
02:00043C20 6502            	  6450:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043C22 5303            	  6451:     subq.b  #1,D3
                            	  6452:     even
                            	  6453: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6454:     ; The routine that returned the door type also returned its
                            	  6455:     ; reverse direction index in [03].
                            	  6456:     ;
                            	  6457:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6458:     ;
02:00043C24 7003            	  6459:     moveq   #3,D0
02:00043C26 003C0011        	  6460:     ori     #$11,CCR  ; SEC: set C+X
02:00043C2A 122C0003        	  6461:     move.b  ($0003,A4),D1
02:00043C2E 0A3C0010        	  6462:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C32 9101            	  6463:     subx.b  D1,D0   ; SBC $03
02:00043C34 0A3C0010        	  6464:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6465:     ; Call this to put the address of door face tiles in [02:03].
                            	  6466:     ;
02:00043C38 6100FD7A        	  6467:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6468:     ; Return the address of the door in the nametable in [01:00].
                            	  6469:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6470:     ;
02:00043C3C 41F900043A12    	  6471:     lea     (DoorVramAddrsHi).l,A0
02:00043C42 10302000        	  6472:     move.b  (A0,D2.W),D0
02:00043C46 1880            	  6473:     move.b  D0,($0000,A4)
02:00043C48 41F900043A16    	  6474:     lea     (DoorVramAddrsLo).l,A0
02:00043C4E 10302000        	  6475:     move.b  (A0,D2.W),D0
02:00043C52 19400001        	  6476:     move.b  D0,($0001,A4)
                            	  6477:     ; Return the direction of the door in [09], and the dynamic
                            	  6478:     ; transfer buf length in X register.
                            	  6479:     ;
02:00043C56 19420009        	  6480:     move.b  D2,($0009,A4)
02:00043C5A 7400            	  6481:     moveq   #0,D2
02:00043C5C 142C0301        	  6482:     move.b  ($0301,A4),D2
                            	  6483:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6484:     ;
02:00043C60 7000            	  6485:     moveq   #0,D0
02:00043C62 19400007        	  6486:     move.b  D0,($0007,A4)
02:00043C66 7002            	  6487:     moveq   #2,D0
02:00043C68 19400006        	  6488:     move.b  D0,($0006,A4)
02:00043C6C 19400005        	  6489:     move.b  D0,($0005,A4)
02:00043C70 0A3C0001        	  6490:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043C74 4E75            	  6491:     rts
