02:0003366A 41EC0650        	   614:     lea     ($0650,A4),A0
02:0003366E 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00033672 5203            	   618:     addq.b  #1,D3
02:00033674 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
