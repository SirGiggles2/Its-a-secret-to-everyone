                            	 10173: GohmaLegOffsetsX:
02:0003DFA6 F0              	 10174:     dc.b    $F0, $10
02:0003DFA7 10
                            	 10175: 
                            	 10176: ; Params:
                            	 10177: ; A: eye frame image
                            	 10178: ;
                            	 10179: ; Draw the eye with the frame image passed in.
                            	 10180: ;
                            	 10181:     even
                            	 10182: Gohma_AnimateAndDraw:
02:0003DFA8 1B00            	 10183:     move.b  D0,-(A5)  ; PHA
02:0003DFAA 4EB90004D1F0    	 10184:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003DFB0 6164            	 10185:     jsr     Gohma_SetSpriteAttributes
02:0003DFB2 101D            	 10186:     move.b  (A5)+,D0  ; PLA
02:0003DFB4 4EB9000316C2    	 10187:     jsr     DrawObjectMirrored
02:0003DFBA 7010            	 10188:     moveq   #16,D0
02:0003DFBC 4EB90004D1EA    	 10189:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	 10190:     ; Draw the right legs.
                            	 10191:     ;
02:0003DFC2 7601            	 10192:     moveq   #1,D3
02:0003DFC4 6102            	 10193:     jsr     Gohma_DrawLegsOneSide
                            	 10194:     ; Draw the left legs.
                            	 10195:     ;
02:0003DFC6 7600            	 10196:     moveq   #0,D3
                            	 10197: ; Params:
                            	 10198: ; Y: side: 0 for left, 1 for right
                            	 10199: ;
                            	 10200: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10201: ; store the sprite's X in [00].
                            	 10202: ;
                            	 10203:     even
                            	 10204: Gohma_DrawLegsOneSide:
02:0003DFC8 10342070        	 10205:     move.b  ($70,A4,D2.W),D0
02:0003DFCC 023C00EE        	 10206:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFD0 41F90003DFA6    	 10207:     lea     (GohmaLegOffsetsX).l,A0
02:0003DFD6 12303000        	 10208:     move.b  (A0,D3.W),D1
02:0003DFDA D101            	 10209:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DFDC 1880            	 10210:     move.b  D0,($0000,A4)
                            	 10211:     ; The object's Y is the sprite's.
                            	 10212:     ;
02:0003DFDE 41EC0084        	 10213:     lea     ($0084,A4),A0
02:0003DFE2 10302000        	 10214:     move.b  (A0,D2.W),D0
02:0003DFE6 19400001        	 10215:     move.b  D0,($0001,A4)
02:0003DFEA 612A            	 10216:     jsr     Gohma_SetSpriteAttributes
                            	 10217:     ; There are only two frame images for legs: left and right.
                            	 10218:     ; There are two animation frames. They are animated as follows:
                            	 10219:     ;
                            	 10220:     ; Frame 0:
                            	 10221:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10222:     ; horizontal flipping = frame number = 0
                            	 10223:     ; 
                            	 10224:     ; Frame 1:
                            	 10225:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10226:     ; horizontal flipping = frame number = 1
                            	 10227:     ;
02:0003DFEC 4EB90004D1C2    	 10228:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DFF2 1003            	 10229:     move.b  D3,D0
02:0003DFF4 023C00EE        	 10230:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFF8 41EC03E4        	 10231:     lea     ($03E4,A4),A0
02:0003DFFC 12302000        	 10232:     move.b  (A0,D2.W),D1
02:0003E000 D101            	 10233:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E002 02000001        	 10234:     andi.b #$01,D0
02:0003E006 023C00EE        	 10235:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E00A 123C0004        	 10236:     move.b  #$04,D1
02:0003E00E D101            	 10237:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E010 4EF9000316C6    	 10238:     jmp     DrawObjectNotMirrored
                            	 10239: 
                            	 10240: ; Returns:
                            	 10241: ; [04]: left side sprite attributes
                            	 10242: ; [05]: right side sprite attributes
                            	 10243: ;
                            	 10244:     even
                            	 10245: Gohma_SetSpriteAttributes:
02:0003E016 4EF90002BF4C    	 10246:     jmp     c_gohma_set_sprite_attributes
