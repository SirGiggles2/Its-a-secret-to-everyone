                            	  8240: Submenu_CueTransferRowUW:
                            	  8241:     ; If menu scroll value is negative, then we transferred everything.
                            	  8242:     ; So, return.
                            	  8243:     ;
02:00044E66 102C005E        	  8244:     move.b  ($005E,A4),D0
02:00044E6A 6A02            	  8245:     bpl.s  __far_z_05_0110
02:00044E6C 602E            	  8246:     jmp  L1725A_Exit
                            	  8247: __far_z_05_0110:
                            	  8248:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8249:     ; and represents the current row of the submenu being processed.
                            	  8250:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8251:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8252:     ;
                            	  8253:     ; If the bottom bit is set, go prepare the full black row.
                            	  8254:     ;
02:00044E6E E208            	  8255:     lsr.b  #1,D0   ; LSR A
02:00044E70 7600            	  8256:     moveq   #0,D3
02:00044E72 1600            	  8257:     move.b  D0,D3
02:00044E74 6402            	  8258:     bcc.s  __far_z_05_0111
02:00044E76 6026            	  8259:     jmp  PrepFullBlackRow
                            	  8260: __far_z_05_0111:
                            	  8261:     ; Submenu rows $D to $15 are parts of the map.
                            	  8262:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8263:     ;
                            	  8264:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8265:     ; buffer for this row.
                            	  8266:     ;
02:00044E78 0C00000D        	  8267:     cmpi.b  #$0D,D0
02:00044E7C 640C            	  8268:     bcc  _anon_z05_167
02:00044E7E 41F900044E42    	  8269:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044E84 10303000        	  8270:     move.b  (A0,D3.W),D0
                            	  8271:     even
