                            	  6005: ; [0C]: mirrored
                            	  6006: ; [0F]: flip horizontally
                            	  6007: ;
                            	  6008: ; Note:
                            	  6009: ; If the object is not mirrored, then it's horizontally flippable.
                            	  6010: ; But Link uses [0F] for flipping without checking [0C].
                            	  6011: ;
                            	  6012: ;
                            	  6013: ; [0D] holds frame.
                            	  6014:     even
