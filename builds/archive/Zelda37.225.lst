                            	 11126: __far_z_04_0107:
                            	 11127:     ; The segment is not a head nor bottom. So, we can use a
                            	 11128:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11129:     ; that is drawn under Link and the heads.
                            	 11130:     ;
02:0003E6A8 4EB9000319BC    	 11131:     jsr     Anim_WriteLevelPaletteSprite
