02:00034E7E 0A3C0010        	  2731:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E82 19400204        	  2732:     move.b  D0,($0204,A4)
02:00034E86 7070            	  2733:     moveq   #112,D0
02:00034E88 19400070        	  2734:     move.b  D0,($0070,A4)
02:00034E8C 103C0087        	  2735:     move.b  #$87,D0
02:00034E90 19400085        	  2736:     move.b  D0,($0085,A4)
02:00034E94 7030            	  2737:     moveq   #48,D0
02:00034E96 19400071        	  2738:     move.b  D0,($0071,A4)
