02:0003E7A4 003C0011        	 11258:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7A8 123C0041        	 11259:     move.b  #$41,D1
02:0003E7AC 0A3C0010        	 11260:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7B0 9101            	 11261:     subx.b  D1,D0   ; SBC #$41
02:0003E7B2 0A3C0010        	 11262:     eori    #$10,CCR  ; restore X = 6502 C
