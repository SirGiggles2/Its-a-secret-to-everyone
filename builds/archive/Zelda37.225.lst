                            	  6057:     ; Copy current direction to old direction.
                            	  6058:     ;
02:0003C13E 41EC0098        	  6059:     lea     ($0098,A4),A0
02:0003C142 10302000        	  6060:     move.b  (A0,D2.W),D0
02:0003C146 41EC0380        	  6061:     lea     ($0380,A4),A0
02:0003C14A 11802000        	  6062:     move.b  D0,(A0,D2.W)
                            	  6063:     even
