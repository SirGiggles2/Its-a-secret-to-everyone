                            	   394: ;------------------------------------------------------------------------------
                            	   395: ; _c_move_object_shim — MoveObject trampoline.
                            	   396: ;
                            	   397: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   398: ;   Input:     D2 = slot (0..11)
                            	   399: ;   Preserves: D2, A4, A5
                            	   400: ;   Clobbers:  D0, D1, D3, A0
                            	   401: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   402: ;
                            	   403: ; GCC side:
                            	   404: ;   void c_move_object(unsigned short slot);
                            	   405: ;     slot arrives as a 16-bit value on the stack.
                            	   406: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   407: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   408: ;   never clobbered by gcc.
                            	   409: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   410: ;   semantics can exist in a pure C port).
                            	   411: ;------------------------------------------------------------------------------
                            	   412: _c_move_object_shim:
                            	   413:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   414:     move.b  #$AA,($0900,A4)
                            	   415:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   416:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   417:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   418:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   419:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   420:     moveq   #0,D0
02:0002B658 3002            	   421:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   422:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   423:     jsr     c_move_object
02:0002B662 588F            	   424:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   425:     rts
                            	   426: 
                            	   427: ;==============================================================================
                            	   428: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   429: ; and tail-call the native asm function.
                            	   430: ;
                            	   431: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   432: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   433: ; sign-extended).
                            	   434: ;==============================================================================
                            	   435: 
                            	   436: ;------------------------------------------------------------------------------
                            	   437: ; void c_copy_bank_to_window(unsigned int bank);
                            	   438: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   439: ;------------------------------------------------------------------------------
                            	   440: c_copy_bank_to_window:
02:0002B666 202F0004        	   441:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   442:     jmp     _copy_bank_to_window
                            	   443: 
                            	   444: ;------------------------------------------------------------------------------
                            	   445: ; unsigned char c_ppu_read_2(void);
                            	   446: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   447: ; C return: gcc expects result in D0.
                            	   448: ;------------------------------------------------------------------------------
                            	   449: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   450:     jmp     _ppu_read_2
                            	   451: 
                            	   452: ;------------------------------------------------------------------------------
                            	   453: ; void c_ppu_write_6(unsigned int val);
                            	   454: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   455: ;------------------------------------------------------------------------------
                            	   456: c_ppu_write_6:
02:0002B674 202F0004        	   457:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   458:     jmp     _ppu_write_6
                            	   459: 
                            	   460: ;------------------------------------------------------------------------------
                            	   461: ; void c_ppu_write_7(unsigned int val);
                            	   462: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   463: ;------------------------------------------------------------------------------
                            	   464: c_ppu_write_7:
02:0002B67E 202F0004        	   465:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   466:     jmp     _ppu_write_7
                            	   467: 
                            	   468: ;------------------------------------------------------------------------------
                            	   469: ; void c_turn_off_all_video(void);
                            	   470: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   471: ;------------------------------------------------------------------------------
                            	   472: c_turn_off_all_video:
02:0002B688 4EF90004AC2C    	   473:     jmp     TurnOffAllVideo
