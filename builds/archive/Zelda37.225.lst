02:000302D6 52302000        	  3190:     addq.b  #1,(A0,D2.W)
02:000302DA 7070            	  3191:     moveq   #112,D0
02:000302DC 41EC03BC        	  3192:     lea     ($03BC,A4),A0
02:000302E0 11802000        	  3193:     move.b  D0,(A0,D2.W)
                            	  3194:     even
