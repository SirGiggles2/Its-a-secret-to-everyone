                            	  6896: Aquamentus_Draw:
                            	  6897:     ; Every $10 screen frames, switch animation frames.
                            	  6898:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6899:     ; The last tile of frame 0 is at index 5.
                            	  6900:     ; The last tile of frame 1 is at index $B.
                            	  6901:     ;
02:0003C792 7605            	  6902:     moveq   #5,D3
02:0003C794 102C0015        	  6903:     move.b  ($0015,A4),D0
02:0003C798 02000010        	  6904:     andi.b #$10,D0
02:0003C79C 6602            	  6905:     bne  _anon_z04_88
02:0003C79E 760B            	  6906:     moveq   #11,D3
                            	  6907: _anon_z04_88:
02:0003C7A0 1943000A        	  6908:     move.b  D3,($000A,A4)
                            	  6909:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6910:     ;
02:0003C7A4 7005            	  6911:     moveq   #5,D0
02:0003C7A6 1940000B        	  6912:     move.b  D0,($000B,A4)
                            	  6913:     even
                            	  6914: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7AA 7600            	  6915:     moveq   #0,D3
02:0003C7AC 162C000B        	  6916:     move.b  ($000B,A4),D3
                            	  6917:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6918:     ; Store it in [00].
                            	  6919:     ;
02:0003C7B0 10342070        	  6920:     move.b  ($70,A4,D2.W),D0
02:0003C7B4 023C00EE        	  6921:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7B8 41F90003C78C    	  6922:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C7BE 12303000        	  6923:     move.b  (A0,D3.W),D1
02:0003C7C2 D101            	  6924:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C7C4 1880            	  6925:     move.b  D0,($0000,A4)
                            	  6926:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6927:     ; Store it in [01].
                            	  6928:     ;
02:0003C7C6 41EC0084        	  6929:     lea     ($0084,A4),A0
02:0003C7CA 10302000        	  6930:     move.b  (A0,D2.W),D0
02:0003C7CE 023C00EE        	  6931:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7D2 41F90003C786    	  6932:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C7D8 12303000        	  6933:     move.b  (A0,D3.W),D1
02:0003C7DC D101            	  6934:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C7DE 19400001        	  6935:     move.b  D0,($0001,A4)
                            	  6936:     ; Calculate sprite attributes:
                            	  6937:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6938:     ;
                            	  6939:     ; If the boss is temporarily invincible, then
                            	  6940:     ; this makes it flash by cycling all the palette rows.
                            	  6941:     ;
                            	  6942:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6943:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6944:     ;
02:0003C7E2 41EC04F0        	  6945:     lea     ($04F0,A4),A0
02:0003C7E6 10302000        	  6946:     move.b  (A0,D2.W),D0
02:0003C7EA 02000003        	  6947:     andi.b #$03,D0
02:0003C7EE 0A000003        	  6948:     eori.b #$03,D0
02:0003C7F2 19400003        	  6949:     move.b  D0,($0003,A4)
02:0003C7F6 7600            	  6950:     moveq   #0,D3
02:0003C7F8 162C000A        	  6951:     move.b  ($000A,A4),D3
                            	  6952:     ; Look up the tile for this sprite.
                            	  6953:     ; If it's not the first one (face), then go write the sprite record.
                            	  6954:     ;
02:0003C7FC 41F90003C77A    	  6955:     lea     (AquamentusTiles).l,A0
02:0003C802 10303000        	  6956:     move.b  (A0,D3.W),D0
02:0003C806 12390003C77A    	  6957:     move.b  (AquamentusTiles).l,D1
02:0003C80C B001            	  6958:     cmp.b   D1,D0
02:0003C80E 6610            	  6959:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6960:     ; Else it's the first one (the face tile).
                            	  6961:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6962:     ;
                            	  6963:     ; $CC/CD shows the closed mouth face.
                            	  6964:     ; $C0/C1 shows the open mouth face.
                            	  6965:     ;
02:0003C810 7600            	  6966:     moveq   #0,D3
02:0003C812 16342028        	  6967:     move.b  ($28,A4,D2.W),D3
02:0003C816 0C030020        	  6968:     cmpi.b  #$20,D3
02:0003C81A 6404            	  6969:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C81C 103C00C0        	  6970:     move.b  #$C0,D0
                            	  6971:     even
                            	  6972: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C820 610E            	  6973:     jsr     WriteBossSprite
                            	  6974:     ; Bottom of the loop.
                            	  6975:     ; Decrement tile index and loop index.
                            	  6976:     ;
02:0003C822 532C000A        	  6977:     subq.b  #1,($000A,A4)
02:0003C826 532C000B        	  6978:     subq.b  #1,($000B,A4)
02:0003C82A 6A00FF7E        	  6979:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C82E 4E75            	  6980:     rts
                            	  6981: 
                            	  6982: ; Params:
                            	  6983: ; A: tile
                            	  6984: ; [00]: X
                            	  6985: ; [01]: Y
                            	  6986: ; [03]: sprite attributes
                            	  6987: ;
                            	  6988: ; Save the tile
                            	  6989:     even
