                            	  7877: _L_z04_UpdatePolsVoice_State0:
                            	  7878:     ; State 0. Walking.
                            	  7879:     ;
                            	  7880:     ; If grid offset = 0, then no more distance to cover.
                            	  7881:     ; So, go change to state 1 -- jumping.
                            	  7882:     ;
02:0003CE3C 41EC0394        	  7883:     lea     ($0394,A4),A0
02:0003CE40 10302000        	  7884:     move.b  (A0,D2.W),D0
02:0003CE44 67000084        	  7885:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7886:     ; Decrement grid offset / distance remaining.
                            	  7887:     ;
02:0003CE48 41EC0394        	  7888:     lea     ($0394,A4),A0
02:0003CE4C 53302000        	  7889:     subq.b  #1,(A0,D2.W)
                            	  7890:     ; Move vertically.
                            	  7891:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7892:     ;
02:0003CE50 41EC0084        	  7893:     lea     ($0084,A4),A0
02:0003CE54 10302000        	  7894:     move.b  (A0,D2.W),D0
02:0003CE58 023C00EE        	  7895:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE5C 41F90003CDEC    	  7896:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE62 12303000        	  7897:     move.b  (A0,D3.W),D1
02:0003CE66 D101            	  7898:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CE68 41EC0084        	  7899:     lea     ($0084,A4),A0
02:0003CE6C 11802000        	  7900:     move.b  D0,(A0,D2.W)
                            	  7901:     even
                            	  7902: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7903:     ; If the square the monster is over is walkable, then
                            	  7904:     ; go draw and check object collisions.
                            	  7905:     ;
02:0003CE70 610001F4        	  7906:     jsr     PolsVoice_IsSquareWalkable
02:0003CE74 6452            	  7907:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7908:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7909:     ; then go change to state 1.
                            	  7910:     ;
02:0003CE76 41EC041F        	  7911:     lea     ($041F,A4),A0
02:0003CE7A 10302000        	  7912:     move.b  (A0,D2.W),D0
02:0003CE7E 020000FC        	  7913:     andi.b #$FC,D0
02:0003CE82 0C0000B0        	  7914:     cmpi.b  #$B0,D0
02:0003CE86 6742            	  7915:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CE88 0C0000F4        	  7916:     cmpi.b  #$F4,D0
02:0003CE8C 643C            	  7917:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7918:     ; Else blocked by something else.
                            	  7919:     ;
                            	  7920:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7921:     ;
02:0003CE8E 41EC0098        	  7922:     lea     ($0098,A4),A0
02:0003CE92 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003CE96 02000003        	  7924:     andi.b #$03,D0
02:0003CE9A 6618            	  7925:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7926:     ; Else facing vertically. Flip the direction.
                            	  7927:     ; Go draw.
                            	  7928:     ;
02:0003CE9C 41EC0098        	  7929:     lea     ($0098,A4),A0
02:0003CEA0 10302000        	  7930:     move.b  (A0,D2.W),D0
02:0003CEA4 0A00000C        	  7931:     eori.b #$0C,D0
02:0003CEA8 41EC0098        	  7932:     lea     ($0098,A4),A0
02:0003CEAC 11802000        	  7933:     move.b  D0,(A0,D2.W)
02:0003CEB0 6000008C        	  7934:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  7938:     ; Facing horizontally. Flip the direction.
                            	  7939:     ; Move two pixels, and go draw.
                            	  7940:     ;
02:0003CEB4 0A000003        	  7941:     eori.b #$03,D0
02:0003CEB8 41EC0098        	  7942:     lea     ($0098,A4),A0
02:0003CEBC 11802000        	  7943:     move.b  D0,(A0,D2.W)
02:0003CEC0 61000210        	  7944:     jsr     PolsVoice_MoveX
02:0003CEC4 6100020C        	  7945:     jsr     PolsVoice_MoveX
                            	  7946:     even
                            	  7947: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003CEC8 6074            	  7948:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  7949: 
                            	  7950:     even
                            	  7951: _L_z04_UpdatePolsVoice_SetState1:
                            	  7952:     ; If already in state 1, then go draw and check collisions.
                            	  7953:     ;
02:0003CECA 41EC00AC        	  7954:     lea     ($00AC,A4),A0
02:0003CECE 10302000        	  7955:     move.b  (A0,D2.W),D0
02:0003CED2 6702            	  7956:     beq.s  __far_z_04_0074
02:0003CED4 6068            	  7957:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7958: __far_z_04_0074:
                            	  7959:     ; Go to state 1.
                            	  7960:     ;
02:0003CED6 41EC00AC        	  7961:     lea     ($00AC,A4),A0
02:0003CEDA 52302000        	  7962:     addq.b  #1,(A0,D2.W)
                            	  7963:     ; Subtract 1 from facing direction to make an index.
                            	  7964:     ;
02:0003CEDE 7600            	  7965:     moveq   #0,D3
02:0003CEE0 41EC0098        	  7966:     lea     ($0098,A4),A0
02:0003CEE4 16302000        	  7967:     move.b  (A0,D2.W),D3
02:0003CEE8 5303            	  7968:     subq.b  #1,D3
                            	  7969:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7970:     ;
02:0003CEEA 41EC0084        	  7971:     lea     ($0084,A4),A0
02:0003CEEE 10302000        	  7972:     move.b  (A0,D2.W),D0
02:0003CEF2 0C000078        	  7973:     cmpi.b  #$78,D0
02:0003CEF6 6402            	  7974:     bcc  _anon_z04_97
02:0003CEF8 7603            	  7975:     moveq   #3,D3
                            	  7976: _anon_z04_97:
                            	  7977:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7978:     ;
02:0003CEFA 0C0000A8        	  7979:     cmpi.b  #$A8,D0
02:0003CEFE 6502            	  7980:     bcs  _anon_z04_98
02:0003CF00 7607            	  7981:     moveq   #7,D3
                            	  7982: _anon_z04_98:
                            	  7983:     ; Set the vertical speed for the beginning of the jump.
                            	  7984:     ;
02:0003CF02 41F90003CDF6    	  7985:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF08 10303000        	  7986:     move.b  (A0,D3.W),D0
02:0003CF0C 41EC0412        	  7987:     lea     ($0412,A4),A0
02:0003CF10 11802000        	  7988:     move.b  D0,(A0,D2.W)
                            	  7989:     ; Look up the Y offset for the current direction.
                            	  7990:     ; Add it to object Y to set the destination Y of the jump.
                            	  7991:     ;
02:0003CF14 41EC0084        	  7992:     lea     ($0084,A4),A0
02:0003CF18 10302000        	  7993:     move.b  (A0,D2.W),D0
02:0003CF1C 023C00EE        	  7994:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF20 41F90003CDFE    	  7995:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF26 12303000        	  7996:     move.b  (A0,D3.W),D1
02:0003CF2A D101            	  7997:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF2C 41EC042C        	  7998:     lea     ($042C,A4),A0
02:0003CF30 11802000        	  7999:     move.b  D0,(A0,D2.W)
                            	  8000:     ; Turn the index into a direction again by adding 1.
                            	  8001:     ; Store the facing direction.
                            	  8002:     ;
02:0003CF34 5203            	  8003:     addq.b  #1,D3
02:0003CF36 41EC0098        	  8004:     lea     ($0098,A4),A0
02:0003CF3A 11832000        	  8005:     move.b  D3,(A0,D2.W)
                            	  8006:     even
                            	  8007: L_PolsVoice_DrawAndCheckCollisions:
02:0003CF3E 7008            	  8008:     moveq   #8,D0
02:0003CF40 4EB90004D1EA    	  8009:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003CF46 41EC03E4        	  8010:     lea     ($03E4,A4),A0
02:0003CF4A 10302000        	  8011:     move.b  (A0,D2.W),D0
02:0003CF4E 4EB9000316C2    	  8012:     jsr     DrawObjectMirrored
                            	  8013:     ; Pols Voice is invincible to everything but the sword,
                            	  8014:     ; during normal collision detection.
                            	  8015:     ;
                            	  8016:     ; The arrow is a special case.
                            	  8017:     ;
02:0003CF54 103C00FE        	  8018:     move.b  #$FE,D0
02:0003CF58 41EC04B2        	  8019:     lea     ($04B2,A4),A0
02:0003CF5C 11802000        	  8020:     move.b  D0,(A0,D2.W)
02:0003CF60 4EB900031A42    	  8021:     jsr     CheckMonsterCollisions
