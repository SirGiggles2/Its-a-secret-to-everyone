                            	  6223: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6224:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6225:     ; We need to remember how many tiles need to be copied
                            	  6226:     ; in each transfer record.
                            	  6227:     ;
02:00043A9C 102C0006        	  6228:     move.b  ($0006,A4),D0
02:00043AA0 19400004        	  6229:     move.b  D0,($0004,A4)
                            	  6230:     ; Write the transfer record header for the door.
                            	  6231:     ;
                            	  6232:     ;
                            	  6233:     ; VRAM address high byte of door
02:00043AA4 1014            	  6234:     move.b  ($0000,A4),D0
02:00043AA6 41EC0302        	  6235:     lea     ($0302,A4),A0
02:00043AAA 11802000        	  6236:     move.b  D0,(A0,D2.W)
02:00043AAE 5202            	  6237:     addq.b  #1,D2
02:00043AB0 102C0001        	  6238:     move.b  ($0001,A4),D0
02:00043AB4 41EC0302        	  6239:     lea     ($0302,A4),A0
02:00043AB8 11802000        	  6240:     move.b  D0,(A0,D2.W)
02:00043ABC 5202            	  6241:     addq.b  #1,D2
02:00043ABE 102C0006        	  6242:     move.b  ($0006,A4),D0
02:00043AC2 41EC0302        	  6243:     lea     ($0302,A4),A0
02:00043AC6 11802000        	  6244:     move.b  D0,(A0,D2.W)
02:00043ACA 5202            	  6245:     addq.b  #1,D2
                            	  6246: _anon_z05_121:
                            	  6247:     ; Write two tiles in a short loop indexed by [04].
                            	  6248:     ;
02:00043ACC 6100ED1C        	  6249:     jsr     WriteDoorFaceTileHorizontally
02:00043AD0 66FA            	  6250:     bne  _anon_z05_121
                            	  6251:     ; OR the low VRAM address with $20 to go down one row
                            	  6252:     ; in order to work on the second row of door tiles.
                            	  6253:     ;
02:00043AD2 7020            	  6254:     moveq   #32,D0
02:00043AD4 122C0001        	  6255:     move.b  ($0001,A4),D1
02:00043AD8 8001            	  6256:     or.b  D1,D0
02:00043ADA 19400001        	  6257:     move.b  D0,($0001,A4)
                            	  6258:     ; Bottom of the loop.
                            	  6259:     ; Loop again to write the second transfer record for the
                            	  6260:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6261:     ;
02:00043ADE 532C0005        	  6262:     subq.b  #1,($0005,A4)
02:00043AE2 66B8            	  6263:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6264:     ; Write the end marker, and update buffer length.
                            	  6265:     ;
02:00043AE4 103C00FF        	  6266:     move.b  #$FF,D0
02:00043AE8 41EC0302        	  6267:     lea     ($0302,A4),A0
02:00043AEC 11802000        	  6268:     move.b  D0,(A0,D2.W)
02:00043AF0 1002            	  6269:     move.b  D2,D0
02:00043AF2 19400301        	  6270:     move.b  D0,($0301,A4)
                            	  6271:     ; Increment the command.
                            	  6272:     ;
02:00043AF6 522C0054        	  6273:     addq.b  #1,($0054,A4)
                            	  6274:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6275:     ; and resetting the door command.
                            	  6276:     ; This ends up catching original states 3 and 7.
                            	  6277:     ;
                            	  6278:     ; Else set door timer to 8 and return.
                            	  6279:     ;
02:00043AFA 102C0054        	  6280:     move.b  ($0054,A4),D0
02:00043AFE 02000003        	  6281:     andi.b #$03,D0
02:00043B02 6708            	  6282:     beq  _anon_z05_122
02:00043B04 7008            	  6283:     moveq   #8,D0
02:00043B06 19400027        	  6284:     move.b  D0,($0027,A4)
02:00043B0A 4E75            	  6285:     rts
