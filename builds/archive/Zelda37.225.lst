02:0003DEBE 41EC0412        	 10051:     lea     ($0412,A4),A0
02:0003DEC2 11802000        	 10052:     move.b  D0,(A0,D2.W)
02:0003DEC6 61001DBA        	 10053:     jsr     ReverseObjDir8
02:0003DECA 41EC045E        	 10054:     lea     ($045E,A4),A0
02:0003DECE 10302000        	 10055:     move.b  (A0,D2.W),D0
02:0003DED2 41EC045E        	 10056:     lea     ($045E,A4),A0
02:0003DED6 52302000        	 10057:     addq.b  #1,(A0,D2.W)
                            	 10058:     ; If the previous number of sprints was odd, then flag that Gohma
                            	 10059:     ; should randomly change direction.
                            	 10060:     ;
02:0003DEDA E208            	 10061:     lsr.b  #1,D0   ; LSR A
02:0003DEDC 640A            	 10062:     bcc  _L_z04_UpdateGohma_AnimateEye
