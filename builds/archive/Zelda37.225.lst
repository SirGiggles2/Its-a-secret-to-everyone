                            	  2763:     ;
02:0003A96A 7600            	  2764:     moveq   #0,D3
02:0003A96C 41EC0098        	  2765:     lea     ($0098,A4),A0
02:0003A970 16302000        	  2766:     move.b  (A0,D2.W),D3
02:0003A974 41EC0084        	  2767:     lea     ($0084,A4),A0
02:0003A978 10302000        	  2768:     move.b  (A0,D2.W),D0
