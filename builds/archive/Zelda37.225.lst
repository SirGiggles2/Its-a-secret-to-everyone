02:00031CD8 0200000F        	  6808:     andi.b #$0F,D0
02:00031CDC 1940000D        	  6809:     move.b  D0,($000D,A4)
02:00031CE0 101D            	  6810:     move.b  (A5)+,D0  ; PLA
02:00031CE2 020000F0        	  6811:     andi.b #$F0,D0
02:00031CE6 1940000E        	  6812:     move.b  D0,($000E,A4)
                            	  6813: ; Params:
                            	  6814: ; X: object index of the attacker
                            	  6815: ; [0D]: damage points high byte
                            	  6816: ; [0E]: damage points low byte
                            	  6817: ;
