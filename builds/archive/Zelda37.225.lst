                            	   731: UpdatePersonState_Textbox:
02:0002E148 7001            	   732:     moveq   #1,D0
02:0002E14A 6100C8AE        	   733:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002E14E 4EB90004C10C    	   734:     jsr     Link_EndMoveAndDraw_Bank1
                            	   735:     ; If the person's timer has not expired, then return.
                            	   736:     ;
