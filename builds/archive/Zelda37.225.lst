02:0003DC24 0C020005        	  9700:     cmpi.b  #$05,D2
02:0003DC28 660A            	  9701:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DC2A 41EC0405        	  9702:     lea     ($0405,A4),A0
