02:0002E858 0200000F        	  1755:     andi.b #$0F,D0
02:0002E85C 003C0011        	  1756:     ori     #$11,CCR  ; SEC: set C+X
02:0002E860 123C0001        	  1757:     move.b  #$01,D1
