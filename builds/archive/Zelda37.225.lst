                            	  7616: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7617:     ; Else Link is facing horizontally.
                            	  7618:     ; [04] := (weapon X + 8)
                            	  7619:     ; A    := (weapon Y + 6)
                            	  7620:     ;
                            	  7621:     ; Shouldn't it be based on the weapon's direction?
                            	  7622:     ;
02:000321EE 10343070        	  7623:     move.b  ($70,A4,D3.W),D0
02:000321F2 023C00EE        	  7624:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321F6 123C0008        	  7625:     move.b  #$08,D1
02:000321FA D101            	  7626:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000321FC 19400004        	  7627:     move.b  D0,($0004,A4)
02:00032200 41EC0084        	  7628:     lea     ($0084,A4),A0
02:00032204 10303000        	  7629:     move.b  (A0,D3.W),D0
02:00032208 023C00EE        	  7630:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003220C 123C0006        	  7631:     move.b  #$06,D1
02:00032210 D101            	  7632:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7633: _anon_z01_98:
                            	  7634:     ; The A register will be copied to [05] and used here.
                            	  7635:     ;
02:00032212 6000FC0A        	  7636:     jmp     CheckMonsterWeaponCollision
                            	  7637: 
                            	  7638: ; Params:
                            	  7639: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7640: ; [00]: weapon object slot (unused)
                            	  7641: ; [02]: object 1 mid X
                            	  7642: ; [03]: object 1 mid Y
                            	  7643: ; [04]: object 2 mid X
                            	  7644: ; [05]: object 2 mid Y
                            	  7645: ;
                            	  7646: ; Returns:
                            	  7647: ; A: 1 if objects collide
                            	  7648: ; Y: weapon object slot
                            	  7649: ; Z: 0 if objects collide
                            	  7650: ; [06]: 1 if objects collide
                            	  7651: ; [0A]: horizontal distance
                            	  7652: ; [0B]: vertical distance
                            	  7653: ;
                            	  7654: ;
                            	  7655: ; Use the same threshold value horizontally and vertically.
                            	  7656: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7657: ;
                            	  7658:     even
                            	  7659: DoObjectsCollide:
02:00032216 1940000D        	  7660:     move.b  D0,($000D,A4)
02:0003221A 1940000E        	  7661:     move.b  D0,($000E,A4)
                            	  7662: ; Params:
                            	  7663: ; [00]: weapon or Link object slot (unused)
                            	  7664: ; [02]: object 1 mid X
                            	  7665: ; [03]: object 1 mid Y
                            	  7666: ; [04]: object 2 mid X
                            	  7667: ; [05]: object 2 mid Y
                            	  7668: ; [0D]: horizontal threshold
                            	  7669: ; [0E]: vertical threshold
                            	  7670: ;
                            	  7671: ; Returns:
                            	  7672: ; A: 1 if objects collide
                            	  7673: ; Y: weapon or Link object slot (copied from [00])
                            	  7674: ; Z: 0 if objects collide
                            	  7675: ; [06]: 1 if objects collide
                            	  7676: ; [0A]: horizontal distance
                            	  7677: ; [0B]: vertical distance
                            	  7678: ;
                            	  7679: ;
                            	  7680: ; Reset [06] to indicate no collision by default.
                            	  7681: ;
                            	  7682:     even
                            	  7683: DoObjectsCollideWithThresholds:
02:0003221E 7000            	  7684:     moveq   #0,D0
02:00032220 19400006        	  7685:     move.b  D0,($0006,A4)
02:00032224 7600            	  7686:     moveq   #0,D3
02:00032226 1614            	  7687:     move.b  ($0000,A4),D3
                            	  7688:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7689:     ;
02:00032228 102C0002        	  7690:     move.b  ($0002,A4),D0
02:0003222C 003C0011        	  7691:     ori     #$11,CCR  ; SEC: set C+X
02:00032230 122C0004        	  7692:     move.b  ($0004,A4),D1
02:00032234 0A3C0010        	  7693:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032238 9101            	  7694:     subx.b  D1,D0   ; SBC $04
02:0003223A 0A3C0010        	  7695:     eori    #$10,CCR  ; restore X = 6502 C
02:0003223E 6100E8EC        	  7696:     jsr     Abs
02:00032242 1940000A        	  7697:     move.b  D0,($000A,A4)
                            	  7698:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7699:     ;
02:00032246 122C000D        	  7700:     move.b  ($000D,A4),D1
02:0003224A B001            	  7701:     cmp.b   D1,D0
02:0003224C 642A            	  7702:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7703:     ; Store in [0B] the vertical distance between the two objects.
                            	  7704:     ;
02:0003224E 102C0003        	  7705:     move.b  ($0003,A4),D0
02:00032252 003C0011        	  7706:     ori     #$11,CCR  ; SEC: set C+X
02:00032256 122C0005        	  7707:     move.b  ($0005,A4),D1
02:0003225A 0A3C0010        	  7708:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003225E 9101            	  7709:     subx.b  D1,D0   ; SBC $05
02:00032260 0A3C0010        	  7710:     eori    #$10,CCR  ; restore X = 6502 C
02:00032264 6100E8C6        	  7711:     jsr     Abs
02:00032268 1940000B        	  7712:     move.b  D0,($000B,A4)
                            	  7713:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7714:     ;
02:0003226C 122C000E        	  7715:     move.b  ($000E,A4),D1
02:00032270 B001            	  7716:     cmp.b   D1,D0
02:00032272 6404            	  7717:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7718:     ; If we get here, then the objects are close enough in both axes.
                            	  7719:     ; Return 1.
                            	  7720:     ;
02:00032274 522C0006        	  7721:     addq.b  #1,($0006,A4)
                            	  7722:     even
                            	  7723: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:00032278 102C0006        	  7724:     move.b  ($0006,A4),D0
02:0003227C 4E75            	  7725:     rts
                            	  7726: 
                            	  7727: ; Params:
                            	  7728: ; X: caller's object index, a monster
                            	  7729: ;    the attacker, if monster attacks Link
                            	  7730: ;    else defender, if weapon attacks monster
                            	  7731: ; [00]: 0 if monster attacks Link (defender),
                            	  7732: ;       else weapon slot (attacker)
                            	  7733: ; [09]: damage type,
                            	  7734: ;       only if a monster is defending
                            	  7735: ; TODO:
                            	  7736: ; [0B]: direction
                            	  7737: ;
                            	  7738: ; Only monsters (and fire) call this routine.
                            	  7739: ;
                            	  7740: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7741: ;
                            	  7742: ; On the other hand, if a weapon attacks a monster,
                            	  7743: ; the monster sets [00] to the weapon's slot.
                            	  7744: ;
                            	  7745: ;
                            	  7746: ; If a weapon attacks a monster, and the weapon's damage
                            	  7747: ; type matches the monster's invincibility mask;
                            	  7748: ; then return without shoving.
                            	  7749: ;
                            	  7750: ; If a monster attacks Link, then damage type will be 0.
                            	  7751: ;
                            	  7752:     even
                            	  7753: BeginShove:
02:0003227E 7600            	  7754:     moveq   #0,D3
02:00032280 1614            	  7755:     move.b  ($0000,A4),D3
02:00032282 0C02000D        	  7756:     cmpi.b  #$0D,D2
02:00032286 6412            	  7757:     bcc  _anon_z01_99
02:00032288 41EC04B2        	  7758:     lea     ($04B2,A4),A0
02:0003228C 10302000        	  7759:     move.b  (A0,D2.W),D0
02:00032290 122C0009        	  7760:     move.b  ($0009,A4),D1
02:00032294 C001            	  7761:     and.b  D1,D0
02:00032296 660000C4        	  7762:     bne  _L_z01_BeginShove_Exit
                            	  7763: _anon_z01_99:
                            	  7764:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7765:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7766:     ;
                            	  7767:     ; If instead a monster is defending, then all this calculation
                            	  7768:     ; won't matter, because the shove direction will be set to the
                            	  7769:     ; weapon's direction.
                            	  7770:     ;
                            	  7771:     ; As such, calculate a direction from the monster to the defender,
                            	  7772:     ; assuming it's Link.
                            	  7773:     ;
                            	  7774:     ; Start with an assumption that the direction is vertical:
                            	  7775:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7776:     ;
02:0003229A 7008            	  7777:     moveq   #8,D0
02:0003229C 19400008        	  7778:     move.b  D0,($0008,A4)
02:000322A0 41EC0084        	  7779:     lea     ($0084,A4),A0
02:000322A4 10302000        	  7780:     move.b  (A0,D2.W),D0
02:000322A8 19400004        	  7781:     move.b  D0,($0004,A4)
02:000322AC 41EC0084        	  7782:     lea     ($0084,A4),A0
02:000322B0 10303000        	  7783:     move.b  (A0,D3.W),D0
02:000322B4 19400005        	  7784:     move.b  D0,($0005,A4)
                            	  7785:     ; If the defender is Link and his grid offset <> 0 then
                            	  7786:     ; use his usual object direction variable to determine
                            	  7787:     ; which axis to check.
                            	  7788:     ;
02:000322B8 4A03            	  7789:     cmpi.b  #$00,D3
02:000322BA 6612            	  7790:     bne  _anon_z01_100
02:000322BC 102C0394        	  7791:     move.b  ($0394,A4),D0
02:000322C0 670C            	  7792:     beq  _anon_z01_100
02:000322C2 102C0098        	  7793:     move.b  ($0098,A4),D0
02:000322C6 02000003        	  7794:     andi.b #$03,D0
02:000322CA 660C            	  7795:     bne  _L_z01_BeginShove_CheckHorizontal
02:000322CC 6720            	  7796:     beq  _L_z01_BeginShove_CheckVertical
                            	  7797: _anon_z01_100:
                            	  7798:     ; For monsters defending, or Link with grid offset = 0,
                            	  7799:     ; check direction in [0B].
                            	  7800:     ;
                            	  7801:     ; For monsters defending, this won't matter. For Link with grid
                            	  7802:     ; offset = 0, I believe the result will be arbitrary.
                            	  7803:     ;
                            	  7804:     ; TODO:
                            	  7805:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7806:     ; It doesn't seem to be if candle fire attacks him.
                            	  7807:     ;
02:000322CE 102C000B        	  7808:     move.b  ($000B,A4),D0
02:000322D2 0C000004        	  7809:     cmpi.b  #$04,D0
02:000322D6 6416            	  7810:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7811:     even
                            	  7812: _L_z01_BeginShove_CheckHorizontal:
                            	  7813:     ; If the direction checked is left or right,
                            	  7814:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7815:     ;
02:000322D8 7002            	  7816:     moveq   #2,D0
02:000322DA 19400008        	  7817:     move.b  D0,($0008,A4)
02:000322DE 10342070        	  7818:     move.b  ($70,A4,D2.W),D0
02:000322E2 19400004        	  7819:     move.b  D0,($0004,A4)
02:000322E6 10343070        	  7820:     move.b  ($70,A4,D3.W),D0
02:000322EA 19400005        	  7821:     move.b  D0,($0005,A4)
                            	  7822:     even
                            	  7823: _L_z01_BeginShove_CheckVertical:
                            	  7824:     ; If the monster is down or right of the other object,
                            	  7825:     ; then use the opposite direction already in [08].
                            	  7826:     ; Else shift [08] right to turn it into the opposite
                            	  7827:     ; direction up or down.
                            	  7828:     ;
                            	  7829:     ; Again assuming Link is the defender; after this, [08] points
                            	  7830:     ; Link away from the monster.
                            	  7831:     ;
02:000322EE 102C0004        	  7832:     move.b  ($0004,A4),D0
02:000322F2 122C0005        	  7833:     move.b  ($0005,A4),D1
02:000322F6 B001            	  7834:     cmp.b   D1,D0
02:000322F8 640A            	  7835:     bcc  _anon_z01_101
02:000322FA 122C0008        	  7836:     move.b  ($0008,A4),D1
02:000322FE E209            	  7837:     lsr.b  #1,D1   ; LSR $08
02:00032300 19410008        	  7838:     move.b  D1,($0008,A4)
                            	  7839: _anon_z01_101:
                            	  7840:     ; If a monster is the defender, go handle it separately.
                            	  7841:     ;
02:00032304 4A03            	  7842:     cmpi.b  #$00,D3
02:00032306 6656            	  7843:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7844:     ; Link is the defender.
                            	  7845:     ;
                            	  7846:     ; If Link is invincible, return without shoving.
                            	  7847:     ;
02:00032308 102C04F0        	  7848:     move.b  ($04F0,A4),D0
02:0003230C 664E            	  7849:     bne  _L_z01_BeginShove_Exit
                            	  7850:     ; Store the shove direction we determined.
                            	  7851:     ;
                            	  7852:     ; Turn on the high bit to indicate that the next time we try to
                            	  7853:     ; move by shoving, it will be the first time for this shove action.
                            	  7854:     ;
02:0003230E 102C0008        	  7855:     move.b  ($0008,A4),D0
02:00032312 00000080        	  7856:     ori.b #$80,D0
02:00032316 194000C0        	  7857:     move.b  D0,($00C0,A4)
                            	  7858:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7859:     ;
02:0003231A 7018            	  7860:     moveq   #24,D0
02:0003231C 194004F0        	  7861:     move.b  D0,($04F0,A4)
02:00032320 7020            	  7862:     moveq   #32,D0
02:00032322 194000D3        	  7863:     move.b  D0,($00D3,A4)
                            	  7864:     ; If Link was shoved by one of his own weapons, then
                            	  7865:     ; nothing else to do. Return.
                            	  7866:     ;
02:00032326 0C02000D        	  7867:     cmpi.b  #$0D,D2
02:0003232A 6430            	  7868:     bcc  _L_z01_BeginShove_Exit
                            	  7869:     ; Link was shoved by a monster.
                            	  7870:     ;
                            	  7871:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7872:     ; then return.
                            	  7873:     ;
02:0003232C 41EC04BF        	  7874:     lea     ($04BF,A4),A0
02:00032330 10302000        	  7875:     move.b  (A0,D2.W),D0
02:00032334 02000080        	  7876:     andi.b #$80,D0
02:00032338 6622            	  7877:     bne  _L_z01_BeginShove_Exit
                            	  7878:     ; If the attacker is a vire, then return.
                            	  7879:     ;
02:0003233A 41EC034F        	  7880:     lea     ($034F,A4),A0
02:0003233E 10302000        	  7881:     move.b  (A0,D2.W),D0
02:00032342 0C000012        	  7882:     cmpi.b  #$12,D0
02:00032346 6714            	  7883:     beq  _L_z01_BeginShove_Exit
                            	  7884:     ; Turn the attacker in the opposite direction.
                            	  7885:     ;
02:00032348 41EC0098        	  7886:     lea     ($0098,A4),A0
02:0003234C 10302000        	  7887:     move.b  (A0,D2.W),D0
02:00032350 6100E7D6        	  7888:     jsr     GetOppositeDir
02:00032354 41EC0098        	  7889:     lea     ($0098,A4),A0
02:00032358 11802000        	  7890:     move.b  D0,(A0,D2.W)
                            	  7891:     even
                            	  7892: _L_z01_BeginShove_Exit:
02:0003235C 4E75            	  7893:     rts
                            	  7894: 
