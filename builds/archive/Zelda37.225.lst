02:0003EF02 10302000        	 12258:     move.b  (A0,D2.W),D0
02:0003EF06 122C0002        	 12259:     move.b  ($0002,A4),D1
02:0003EF0A E309            	 12260:     lsl.b  #1,D1   ; ASL $02
02:0003EF0C 19410002        	 12261:     move.b  D1,($0002,A4)
02:0003EF10 122C0002        	 12262:     move.b  ($0002,A4),D1
02:0003EF14 C200            	 12263:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
