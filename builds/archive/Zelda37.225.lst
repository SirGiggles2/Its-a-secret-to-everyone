                            	 11988: __far_z_04_0124:
                            	 11989:     ; Will loop 4 times, propagating directions down the chain,
                            	 11990:     ; by pulling from the bottom.
                            	 11991:     ;
02:0003ED4A 7004            	 11992:     moveq   #4,D0
02:0003ED4C 1880            	 11993:     move.b  D0,($0000,A4)
                            	 11994:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11995:     ;
02:0003ED4E 7600            	 11996:     moveq   #0,D3
02:0003ED50 0C020005        	 11997:     cmpi.b  #$05,D2
02:0003ED54 6702            	 11998:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED56 7605            	 11999:     moveq   #5,D3
                            	 12000:     even
                            	 12001: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12002:     ; Loop over every segment under the head, starting from the tail.
                            	 12003:     ; Copy the next segment's direction to the current one in this loop.
                            	 12004:     ;
02:0003ED58 41EC009A        	 12005:     lea     ($009A,A4),A0
02:0003ED5C 10303000        	 12006:     move.b  (A0,D3.W),D0
02:0003ED60 41EC0099        	 12007:     lea     ($0099,A4),A0
02:0003ED64 11803000        	 12008:     move.b  D0,(A0,D3.W)
02:0003ED68 5203            	 12009:     addq.b  #1,D3
02:0003ED6A 5314            	 12010:     subq.b  #1,($0000,A4)
02:0003ED6C 66EA            	 12011:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12012:     ; If this head segment is not aligned with a square, then return.
                            	 12013:     ;
02:0003ED6E 10342070        	 12014:     move.b  ($70,A4,D2.W),D0
02:0003ED72 0200000F        	 12015:     andi.b #$0F,D0
02:0003ED76 660000BA        	 12016:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12017:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12018:     ; We had to account for the usual offset of 3.
                            	 12019:     ;
02:0003ED7A 41EC0084        	 12020:     lea     ($0084,A4),A0
02:0003ED7E 10302000        	 12021:     move.b  (A0,D2.W),D0
02:0003ED82 023C00EE        	 12022:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED86 123C0003        	 12023:     move.b  #$03,D1
02:0003ED8A D101            	 12024:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED8C 0200000F        	 12025:     andi.b #$0F,D0
02:0003ED90 660000A0        	 12026:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12027:     ; Store the opposite of the facing direction in [00].
                            	 12028:     ;
02:0003ED94 41EC0098        	 12029:     lea     ($0098,A4),A0
02:0003ED98 10302000        	 12030:     move.b  (A0,D2.W),D0
02:0003ED9C E208            	 12031:     lsr.b  #1,D0   ; LSR A
02:0003ED9E 02000005        	 12032:     andi.b #$05,D0
02:0003EDA2 1880            	 12033:     move.b  D0,($0000,A4)
02:0003EDA4 41EC0098        	 12034:     lea     ($0098,A4),A0
02:0003EDA8 10302000        	 12035:     move.b  (A0,D2.W),D0
02:0003EDAC E308            	 12036:     lsl.b  #1,D0   ; ASL A
02:0003EDAE 0200000A        	 12037:     andi.b #$0A,D0
02:0003EDB2 1214            	 12038:     move.b  ($0000,A4),D1
02:0003EDB4 8001            	 12039:     or.b  D1,D0
                            	 12040:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12041:     ;
02:0003EDB6 0A00000F        	 12042:     eori.b #$0F,D0
02:0003EDBA 1940050F        	 12043:     move.b  D0,($050F,A4)
                            	 12044:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12045:     ;
02:0003EDBE 10342018        	 12046:     move.b  ($18,A4,D2.W),D0
02:0003EDC2 0C000080        	 12047:     cmpi.b  #$80,D0
02:0003EDC6 656C            	 12048:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12049:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12050:     ; Load the monster's facing direction.
                            	 12051:     ;
02:0003EDC8 41EC0098        	 12052:     lea     ($0098,A4),A0
02:0003EDCC 10302000        	 12053:     move.b  (A0,D2.W),D0
                            	 12054:     ; Load the next random number into Y register.
                            	 12055:     ;
02:0003EDD0 7600            	 12056:     moveq   #0,D3
02:0003EDD2 16342019        	 12057:     move.b  ($19,A4,D2.W),D3
                            	 12058:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12059:     ; to keep moving straight.
                            	 12060:     ;
02:0003EDD6 0C030080        	 12061:     cmpi.b  #$80,D3
02:0003EDDA 6418            	 12062:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12063:     even
                            	 12064: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12065:     ; Loop to rotate the direction bit over the mask.
                            	 12066:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12067:     ; facing direction.
                            	 12068:     ;
                            	 12069:     ; Shift right the copy of the direction.
                            	 12070:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12071:     ;
02:0003EDDC E208            	 12072:     lsr.b  #1,D0   ; LSR A
02:0003EDDE 6402            	 12073:     bcc  _anon_z04_151
02:0003EDE0 7008            	 12074:     moveq   #8,D0
                            	 12075: _anon_z04_151:
                            	 12076:     ; If the current direction bit is masked off, then we've reached
                            	 12077:     ; the opposite direction. Loop again.
                            	 12078:     ;
02:0003EDE2 122C050F        	 12079:     move.b  ($050F,A4),D1
02:0003EDE6 C200            	 12080:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDE8 67F2            	 12081:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12082:     ; If Y register >= $40, then break out of the loop.
                            	 12083:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12084:     ;
02:0003EDEA 0C030040        	 12085:     cmpi.b  #$40,D3
02:0003EDEE 6404            	 12086:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12087:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12088:     ; and loop again now.
                            	 12089:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12090:     ;
02:0003EDF0 7640            	 12091:     moveq   #64,D3
02:0003EDF2 65E8            	 12092:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12093:     even
                            	 12094: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12095:     ; Change the facing direction to the direction found.
                            	 12096:     ;
02:0003EDF4 41EC0098        	 12097:     lea     ($0098,A4),A0
02:0003EDF8 11802000        	 12098:     move.b  D0,(A0,D2.W)
                            	 12099:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12100:     ;
02:0003EDFC 1940000F        	 12101:     move.b  D0,($000F,A4)
02:0003EE00 4EB900030A2E    	 12102:     jsr     BoundByRoom
                            	 12103:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12104:     ;
02:0003EE06 102C000F        	 12105:     move.b  ($000F,A4),D0
02:0003EE0A 6618            	 12106:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12107:     even
                            	 12108: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12109:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12110:     ; for looking for any non-opposite direction that is not blocked.
                            	 12111:     ;
02:0003EE0C 41EC0098        	 12112:     lea     ($0098,A4),A0
02:0003EE10 10302000        	 12113:     move.b  (A0,D2.W),D0
                            	 12114:     even
                            	 12115: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12116:     ; Shift right the copy of the direction.
                            	 12117:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12118:     ;
02:0003EE14 E208            	 12119:     lsr.b  #1,D0   ; LSR A
02:0003EE16 6402            	 12120:     bcc  _anon_z04_152
02:0003EE18 7008            	 12121:     moveq   #8,D0
                            	 12122: _anon_z04_152:
                            	 12123:     ; If the current direction bit is not masked off, then go check the
                            	 12124:     ; room boundary in this direction.
                            	 12125:     ; Else we've reached the opposite direction. Loop again.
                            	 12126:     ;
02:0003EE1A 122C050F        	 12127:     move.b  ($050F,A4),D1
02:0003EE1E C200            	 12128:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE20 66D2            	 12129:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE22 67F0            	 12130:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12131:     even
                            	 12132: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12133:     ; We found a direction that was not blocked by the room boundary.
                            	 12134:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12135:     ;
02:0003EE24 4EB90004B94C    	 12136:     jsr     GetCollidingTileMoving
02:0003EE2A 122C034A        	 12137:     move.b  ($034A,A4),D1
02:0003EE2E B001            	 12138:     cmp.b   D1,D0
02:0003EE30 64DA            	 12139:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12140:     even
                            	 12141: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12142:     ; TODO: confirm this
                            	 12143:     ;
                            	 12144:     ; If there were a room that had lamnolas, and they could get
                            	 12145:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12146:     ; an infinite loop.
                            	 12147:     ;
                            	 12148:     ; But, the only room with that configuration has those blocks
                            	 12149:     ; blocked off with a push block, which can only be pushed after
                            	 12150:     ; all monsters are killed.
                            	 12151:     ;
02:0003EE32 4E75            	 12152:     rts
                            	 12153: 
                            	 12154:     even
                            	 12155: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 12156:     ; Find the horizontal direction toward Link and store it in [02].
                            	 12157:     ;
02:0003EE34 7001            	 12158:     moveq   #1,D0
02:0003EE36 19400002        	 12159:     move.b  D0,($0002,A4)
02:0003EE3A 102C0070        	 12160:     move.b  ($0070,A4),D0
02:0003EE3E 003C0011        	 12161:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE42 12342070        	 12162:     move.b  ($70,A4,D2.W),D1
02:0003EE46 0A3C0010        	 12163:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE4A 9101            	 12164:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EE4C 0A3C0010        	 12165:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE50 640A            	 12166:     bcc  _anon_z04_153
02:0003EE52 122C0002        	 12167:     move.b  ($0002,A4),D1
02:0003EE56 E309            	 12168:     lsl.b  #1,D1   ; ASL $02
02:0003EE58 19410002        	 12169:     move.b  D1,($0002,A4)
                            	 12170: _anon_z04_153:
                            	 12171:     ; Find the vertical direction toward Link and store it in [03].
                            	 12172:     ;
02:0003EE5C 7004            	 12173:     moveq   #4,D0
02:0003EE5E 19400003        	 12174:     move.b  D0,($0003,A4)
02:0003EE62 102C0084        	 12175:     move.b  ($0084,A4),D0
02:0003EE66 003C0011        	 12176:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE6A 41EC0084        	 12177:     lea     ($0084,A4),A0
02:0003EE6E 12302000        	 12178:     move.b  (A0,D2.W),D1
02:0003EE72 0A3C0010        	 12179:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE76 9101            	 12180:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EE78 0A3C0010        	 12181:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE7C 640A            	 12182:     bcc  _anon_z04_154
02:0003EE7E 122C0003        	 12183:     move.b  ($0003,A4),D1
02:0003EE82 E309            	 12184:     lsl.b  #1,D1   ; ASL $03
02:0003EE84 19410003        	 12185:     move.b  D1,($0003,A4)
                            	 12186: _anon_z04_154:
                            	 12187:     ; If the horizontal direction toward Link is not allowed, then
                            	 12188:     ; go check the vertical direction.
                            	 12189:     ;
02:0003EE88 102C0002        	 12190:     move.b  ($0002,A4),D0
02:0003EE8C 122C050F        	 12191:     move.b  ($050F,A4),D1
02:0003EE90 C200            	 12192:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE92 6708            	 12193:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 12194:     ; If the horizontal direction toward Link is the same direction
                            	 12195:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 12196:     ;
02:0003EE94 122C0098        	 12197:     move.b  ($0098,A4),D1
02:0003EE98 C200            	 12198:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE9A 6604            	 12199:     bne  _anon_z04_155
                            	 12200:     even
                            	 12201: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12202:     ; Load the vertical direction toward Link in order to test it for
                            	 12203:     ; room boundary and tile collision.
                            	 12204:     ;
02:0003EE9C 102C0003        	 12205:     move.b  ($0003,A4),D0
                            	 12206: _anon_z04_155:
                            	 12207:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12208:     ;
02:0003EEA0 6000FF52        	 12209:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
