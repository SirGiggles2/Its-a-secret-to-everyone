02:0002E158 660000D8        	   738:     bne  _L_z01_UpdatePersonState_Textbox_Exit
                            	   739:     ; Set the timer to wait 6 frames after the next character about
                            	   740:     ; to be shown.
                            	   741:     ;
02:0002E15C 7006            	   742:     moveq   #6,D0
02:0002E15E 19400029        	   743:     move.b  D0,($0029,A4)
                            	   744:     ; Copy the 5 bytes of the textbox character transfer record template
                            	   745:     ; to the dynamic transfer buf.
                            	   746:     ;
02:0002E162 7604            	   747:     moveq   #4,D3
                            	   748: _anon_z01_7:
02:0002E164 41F90002E13E    	   749:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E16A 10303000        	   750:     move.b  (A0,D3.W),D0
02:0002E16E 41EC0302        	   751:     lea     ($0302,A4),A0
02:0002E172 11803000        	   752:     move.b  D0,(A0,D3.W)
02:0002E176 5303            	   753:     subq.b  #1,D3
02:0002E178 6AEA            	   754:     bpl  _anon_z01_7
                            	   755:     even
                            	   756: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   757:     ; Replace the low byte of the VRAM address with the one
                            	   758:     ; where the next character should be written.
                            	   759:     ;
02:0002E17A 102C045F        	   760:     move.b  ($045F,A4),D0
02:0002E17E 19400303        	   761:     move.b  D0,($0303,A4)
                            	   762:     ; Increment the low VRAM address for the next character.
                            	   763:     ;
02:0002E182 522C045F        	   764:     addq.b  #1,($045F,A4)
                            	   765:     ; Use the person text selector to look up the address of the
                            	   766:     ; text for the textbox. Store the address in [00:01].
                            	   767:     ;
02:0002E186 7600            	   768:     moveq   #0,D3
02:0002E188 162C0415        	   769:     move.b  ($0415,A4),D3
02:0002E18C 41F90002D7C2    	   770:     lea     (PersonTextAddrs).l,A0
02:0002E192 10303000        	   771:     move.b  (A0,D3.W),D0
02:0002E196 1880            	   772:     move.b  D0,($0000,A4)
02:0002E198 5203            	   773:     addq.b  #1,D3
02:0002E19A 41F90002D7C2    	   774:     lea     (PersonTextAddrs).l,A0
02:0002E1A0 10303000        	   775:     move.b  (A0,D3.W),D0
02:0002E1A4 19400001        	   776:     move.b  D0,($0001,A4)
                            	   777:     ; Load the person text current character index.
                            	   778:     ;
02:0002E1A8 7600            	   779:     moveq   #0,D3
02:0002E1AA 162C0416        	   780:     move.b  ($0416,A4),D3
                            	   781:     ; Increment the index variable to point to the next character
                            	   782:     ; for next time.
                            	   783:     ;
02:0002E1AE 522C0416        	   784:     addq.b  #1,($0416,A4)
                            	   785:     ; Get the current character.
                            	   786:     ;
02:0002E1B2 1214            	   787:     move.b  ($00,A4),D1   ; ptr lo
02:0002E1B4 182C0001        	   788:     move.b  ($01,A4),D4  ; ptr hi
02:0002E1B8 024100FF        	   789:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E1BC E14C            	   790:     lsl.w   #8,D4
02:0002E1BE 8841            	   791:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E1C0 48C4            	   792:     ext.l   D4
02:0002E1C2 D8BC00FF0000    	   793:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E1C8 2044            	   794:     movea.l D4,A0
02:0002E1CA 10303000        	   795:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   796:     ; If the character is $25, then it's a special space. It will still
                            	   797:     ; take up space, but will not take time to show -- meaning that
                            	   798:     ; we'll go look up the next character to transfer.
                            	   799:     ;
02:0002E1CE 0200003F        	   800:     andi.b #$3F,D0
02:0002E1D2 0C000025        	   801:     cmpi.b  #$25,D0
02:0002E1D6 67A2            	   802:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   803:     ; We have a non-space character. Put it in the transfer record.
                            	   804:     ;
02:0002E1D8 19400305        	   805:     move.b  D0,($0305,A4)
                            	   806:     ; Play the "heart taken/character" sound effect.
                            	   807:     ;
02:0002E1DC 7010            	   808:     moveq   #16,D0
02:0002E1DE 19400604        	   809:     move.b  D0,($0604,A4)
                            	   810:     ; If the high 2 bits of character element = 0, then return.
                            	   811:     ;
02:0002E1E2 1214            	   812:     move.b  ($00,A4),D1   ; ptr lo
02:0002E1E4 182C0001        	   813:     move.b  ($01,A4),D4  ; ptr hi
02:0002E1E8 024100FF        	   814:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E1EC E14C            	   815:     lsl.w   #8,D4
02:0002E1EE 8841            	   816:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E1F0 48C4            	   817:     ext.l   D4
02:0002E1F2 D8BC00FF0000    	   818:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E1F8 2044            	   819:     movea.l D4,A0
02:0002E1FA 10303000        	   820:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E1FE 020000C0        	   821:     andi.b #$C0,D0
02:0002E202 672E            	   822:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   823:     ; Determine an index based on the high 2 bits of the character element:
                            	   824:     ;   $80: 0
                            	   825:     ;   $40: 1
                            	   826:     ;   $C0: 2
                            	   827:     ;
02:0002E204 7602            	   828:     moveq   #2,D3
02:0002E206 0C0000C0        	   829:     cmpi.b  #$C0,D0
02:0002E20A 670A            	   830:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E20C 5303            	   831:     subq.b  #1,D3
02:0002E20E 0C000040        	   832:     cmpi.b  #$40,D0
02:0002E212 6702            	   833:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E214 5303            	   834:     subq.b  #1,D3
                            	   835:     even
                            	   836: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   837:     ; The index chooses the low VRAM address of the start
                            	   838:     ; of another line:
                            	   839:     ;   0: $C4: front of the second line
                            	   840:     ;   1: $E4: front of the third line
                            	   841:     ;   2: $A4: front of the first line
                            	   842:     ;
                            	   843:     ; Look up the low VRAM address and store it.
                            	   844:     ;
02:0002E216 41F90002E144    	   845:     lea     (TextboxLineAddrsLo).l,A0
02:0002E21C 10303000        	   846:     move.b  (A0,D3.W),D0
02:0002E220 1940045F        	   847:     move.b  D0,($045F,A4)
                            	   848:     ; If index = 2, then we've reached the end of the text,
                            	   849:     ; and low VRAM address is moved to the front of the first line.
                            	   850:     ; So, advance the state of the person object, and unhalt Link.
                            	   851:     ;
02:0002E224 0C030002        	   852:     cmpi.b  #$02,D3
02:0002E228 6608            	   853:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E22A 522C00AD        	   854:     addq.b  #1,($00AD,A4)
02:0002E22E 6100FB98        	   855:     jsr     UnhaltLink
                            	   856:     even
                            	   857: _L_z01_UpdatePersonState_Textbox_Exit:
02:0002E232 4E75            	   858:     rts
                            	   859: 
                            	   860:     even
                            	   861: UpdateCavePersonState_TalkOrShopOrDoorCharge:
