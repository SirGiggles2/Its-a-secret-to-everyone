                            	  5185: 
                            	  5186: ; Each byte describes an item. The high nibble is the type.
                            	  5187: ; The low nibble is the value. Its meaning depends on the type.
                            	  5188: ;
                            	  5189: ; 0x - individuals
                            	  5190: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5191: ; * bit mask: value doesn't matter.
                            	  5192: ;
                            	  5193: ; 1x - amounts
                            	  5194: ; Value is an amount to add.
                            	  5195: ;
                            	  5196: ; 2x - grades
                            	  5197: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5198: ;
                            	  5199: ; 3x - error?
                            	  5200: ; Produces an item value of $FF.
                            	  5201: ;
                            	  5202:     even
