                            	  4147: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4148:     ; If the current heart's state <> 0, then go move it.
                            	  4149:     ; Else we have to wait for it to come out at the right time.
                            	  4150:     ;
02:0003B322 41EC00AC        	  4151:     lea     ($00AC,A4),A0
