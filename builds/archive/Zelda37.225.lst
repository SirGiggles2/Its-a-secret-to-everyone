                            	  2861: __far_z_04_0024:
                            	  2862:     ; Going down. We have to consider the target Y.
                            	  2863:     ;
                            	  2864:     ; If the absolute vertical distance to the target position >= 3,
                            	  2865:     ; then go animate, draw, and check collisions.
                            	  2866:     ;
02:0003AA38 41EC0084        	  2867:     lea     ($0084,A4),A0
02:0003AA3C 10302000        	  2868:     move.b  (A0,D2.W),D0
02:0003AA40 003C0011        	  2869:     ori     #$11,CCR  ; SEC: set C+X
02:0003AA44 41EC0444        	  2870:     lea     ($0444,A4),A0
02:0003AA48 12302000        	  2871:     move.b  (A0,D2.W),D1
02:0003AA4C 0A3C0010        	  2872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AA50 9101            	  2873:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AA52 0A3C0010        	  2874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AA56 4EB900030B2C    	  2875:     jsr     Abs
02:0003AA5C 0C000003        	  2876:     cmpi.b  #$03,D0
02:0003AA60 6502            	  2877:     bcs.s  __far_z_04_0025
02:0003AA62 6062            	  2878:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2879: __far_z_04_0025:
                            	  2880:     ; Distance < 3. Go to state 0.
                            	  2881:     ;
                            	  2882:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2883:     ;
02:0003AA64 4EB90004CD8E    	  2884:     jsr     ResetObjState
02:0003AA6A 7600            	  2885:     moveq   #0,D3
02:0003AA6C 41EC034F        	  2886:     lea     ($034F,A4),A0
02:0003AA70 16302000        	  2887:     move.b  (A0,D2.W),D3
02:0003AA74 0C030020        	  2888:     cmpi.b  #$20,D3
02:0003AA78 6748            	  2889:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2890:     ; Else calculate a timer value.
                            	  2891:     ;
                            	  2892:     ; t := (Random + $10)
                            	  2893:     ; if t < $20 then
                            	  2894:     ;   t := t - $40
                            	  2895:     ;
02:0003AA7A 7010            	  2896:     moveq   #16,D0
02:0003AA7C 023C00EE        	  2897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA80 12342019        	  2898:     move.b  ($19,A4,D2.W),D1
02:0003AA84 D101            	  2899:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AA86 0C000020        	  2900:     cmpi.b  #$20,D0
02:0003AA8A 6412            	  2901:     bcc  _anon_z04_39
02:0003AA8C 003C0011        	  2902:     ori     #$11,CCR  ; SEC: set C+X
02:0003AA90 123C0040        	  2903:     move.b  #$40,D1
02:0003AA94 0A3C0010        	  2904:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AA98 9101            	  2905:     subx.b  D1,D0   ; SBC #$40
02:0003AA9A 0A3C0010        	  2906:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2907: _anon_z04_39:
                            	  2908:     ; If the object is a blue tektite, then go use this t.
                            	  2909:     ;
02:0003AA9E 7600            	  2910:     moveq   #0,D3
02:0003AAA0 41EC034F        	  2911:     lea     ($034F,A4),A0
02:0003AAA4 16302000        	  2912:     move.b  (A0,D2.W),D3
02:0003AAA8 0C03000D        	  2913:     cmpi.b  #$0D,D3
02:0003AAAC 6714            	  2914:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2915:     ; t := t AND $7F
                            	  2916:     ;
02:0003AAAE 0200007F        	  2917:     andi.b #$7F,D0
                            	  2918:     ; If Random < $A0, then go use this t.
                            	  2919:     ;
02:0003AAB2 7600            	  2920:     moveq   #0,D3
02:0003AAB4 16342019        	  2921:     move.b  ($19,A4,D2.W),D3
02:0003AAB8 0C0300A0        	  2922:     cmpi.b  #$A0,D3
02:0003AABC 6504            	  2923:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2924:     ; t := t AND $F
                            	  2925:     ;
02:0003AABE 0200000F        	  2926:     andi.b #$0F,D0
                            	  2927:     even
