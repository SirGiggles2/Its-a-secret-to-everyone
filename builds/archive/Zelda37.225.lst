02:0003C00A 41EC0485        	  5845:     lea     ($0485,A4),A0
02:0003C00E 11802000        	  5846:     move.b  D0,(A0,D2.W)
02:0003C012 6100062A        	  5847:     jsr     CheckBossHitReaction
