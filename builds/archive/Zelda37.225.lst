02:0003C01A 0C020006        	  5852:     cmpi.b  #$06,D2
02:0003C01E 6502            	  5853:     bcs  _anon_z04_80
02:0003C020 7604            	  5854:     moveq   #4,D3
                            	  5855: _anon_z04_80:
