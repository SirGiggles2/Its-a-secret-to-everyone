                            	  5981: ; Params:
                            	  5982: ; A: frame
                            	  5983: ; X: object index/cycle sprite index
                            	  5984: ; Y: object type
                            	  5985: ; [00]: object X
                            	  5986: ; [01]: object Y
                            	  5987: ; [0C]: mirrored
                            	  5988: ; [0F]: flip horizontally
