02:00039C92 11802000        	   877:     move.b  D0,(A0,D2.W)
02:00039C96 41EC00AC        	   878:     lea     ($00AC,A4),A0
02:00039C9A 52302000        	   879:     addq.b  #1,(A0,D2.W)
02:00039C9E 522C00F7        	   880:     addq.b  #1,($00F7,A4)
02:00039CA2 7074            	   881:     moveq   #116,D0
02:00039CA4 4EB90004B050    	   882:     jsr     ChangeTileObjTiles
