02:0003A986 12303000        	  2771:     move.b  (A0,D3.W),D1
02:0003A98A D101            	  2772:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A98C 41EC0444        	  2773:     lea     ($0444,A4),A0
