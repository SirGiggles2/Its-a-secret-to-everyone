                            	  7033: UpdateDodongoState0_Move:
                            	  7034:     ; If facing left, then push X offset 0 on the stack.
                            	  7035:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7036:     ;
                            	  7037:     ; We would like to use one set of coordinates only.
                            	  7038:     ; But movement would break down, if we did; because
                            	  7039:     ; Dodongo is so long.
                            	  7040:     ;
                            	  7041:     ; So, when not facing left, we temporarily shift the
                            	  7042:     ; X coordinate to be closer to the other side of the monster.
                            	  7043:     ;
02:0003C896 7600            	  7044:     moveq   #0,D3
02:0003C898 41EC0098        	  7045:     lea     ($0098,A4),A0
02:0003C89C 10302000        	  7046:     move.b  (A0,D2.W),D0
02:0003C8A0 0200000D        	  7047:     andi.b #$0D,D0
02:0003C8A4 6716            	  7048:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C8A6 10342070        	  7049:     move.b  ($70,A4,D2.W),D0
02:0003C8AA 023C00EE        	  7050:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8AE 123C0010        	  7051:     move.b  #$10,D1
02:0003C8B2 D101            	  7052:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C8B4 19802070        	  7053:     move.b  D0,($70,A4,D2.W)
02:0003C8B8 163C00F0        	  7054:     move.b  #$F0,D3
                            	  7055:     even
                            	  7056: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C8BC 1003            	  7057:     move.b  D3,D0
02:0003C8BE 1B00            	  7058:     move.b  D0,-(A5)  ; PHA
02:0003C8C0 7020            	  7059:     moveq   #32,D0
02:0003C8C2 41EC041F        	  7060:     lea     ($041F,A4),A0
02:0003C8C6 11802000        	  7061:     move.b  D0,(A0,D2.W)
02:0003C8CA 6100CFC4        	  7062:     jsr     Wanderer_TargetPlayer
                            	  7063:     ; Pop the offset and add it to the X coordinate.
                            	  7064:     ;
                            	  7065:     ; This brings the X coordinate back to the unique value
                            	  7066:     ; that represents the position.
