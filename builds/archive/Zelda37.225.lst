02:0002E242 102C0350        	   875:     move.b  ($0350,A4),D0
02:0002E246 0C000071        	   876:     cmpi.b  #$71,D0
02:0002E24A 6616            	   877:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_Exit
                            	   878:     ; Post 20 rupees to subtract.
                            	   879:     ;
02:0002E24C 102C067E        	   880:     move.b  ($067E,A4),D0
02:0002E250 023C00EE        	   881:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E254 123C0014        	   882:     move.b  #$14,D1
02:0002E258 D101            	   883:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E25A 1940067E        	   884:     move.b  D0,($067E,A4)
                            	   885:     ; Mark this secret taken.
                            	   886:     ;
02:0002E25E 61002DC0        	   887:     jsr     SetRoomFlagUWItemState
                            	   888:     even
                            	   889: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_Exit:
