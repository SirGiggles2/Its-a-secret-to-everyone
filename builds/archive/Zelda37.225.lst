                            	  7169: AnimateLinkObjState:
                            	  7170:     ; If major state = $10
                            	  7171:     ;   if minor state = 0, make it 1
                            	  7172:     ;   else OR state with $30
                            	  7173:     ;   go set movement frame to 1
                            	  7174:     ;
02:0004D1FC 102C00AC        	  7175:     move.b  ($00AC,A4),D0
02:0004D200 02000030        	  7176:     andi.b #$30,D0
02:0004D204 0C000010        	  7177:     cmpi.b  #$10,D0
02:0004D208 660C            	  7178:     bne  _L_z07_AnimateLinkObjState_CheckState20
02:0004D20A 102C00AC        	  7179:     move.b  ($00AC,A4),D0
02:0004D20E 0200000F        	  7180:     andi.b #$0F,D0
02:0004D212 6618            	  7181:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
02:0004D214 6710            	  7182:     beq  _L_z07_AnimateLinkObjState_IncState
                            	  7183:     even
                            	  7184: _L_z07_AnimateLinkObjState_CheckState20:
                            	  7185:     ; If major state = $20
                            	  7186:     ;   if minor state = 0, make it 1
                            	  7187:     ;   else OR state with $30
                            	  7188:     ;   go set movement frame to 1
                            	  7189:     ;
02:0004D216 0C000020        	  7190:     cmpi.b  #$20,D0
02:0004D21A 6624            	  7191:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:0004D21C 102C00AC        	  7192:     move.b  ($00AC,A4),D0
02:0004D220 0200000F        	  7193:     andi.b #$0F,D0
02:0004D224 6606            	  7194:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
                            	  7195:     even
                            	  7196: _L_z07_AnimateLinkObjState_IncState:
02:0004D226 522C00AC        	  7197:     addq.b  #1,($00AC,A4)
02:0004D22A 600C            	  7198:     jmp     _L_z07_AnimateLinkObjState_SetMovementFrame1
                            	  7199: 
                            	  7200:     even
                            	  7201: _L_z07_AnimateLinkObjState_CombineStateWith30:
02:0004D22C 102C00AC        	  7202:     move.b  ($00AC,A4),D0
02:0004D230 00000030        	  7203:     ori.b #$30,D0
02:0004D234 194000AC        	  7204:     move.b  D0,($00AC,A4)
                            	  7205:     even
                            	  7206: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  7207:     ; To animate the state, the animation counter had to have
                            	  7208:     ; reached 0. Right after this routine, the counter will be
                            	  7209:     ; rolled over, and the movement frame will be switched.
                            	  7210:     ;
                            	  7211:     ; So, set movement frame to 1 (legs together) at the end of
                            	  7212:     ; the animation here, in order to immediately change it to
                            	  7213:     ; 0 (legs apart) after this.
                            	  7214:     ;
02:0004D238 7001            	  7215:     moveq   #1,D0
02:0004D23A 194003E4        	  7216:     move.b  D0,($03E4,A4)
02:0004D23E 4E75            	  7217:     rts
                            	  7218: 
                            	  7219:     even
                            	  7220: _L_z07_AnimateLinkObjState_CheckState30:
