                            	  7390:     ;
02:0003CB18 41EC0098        	  7391:     lea     ($0098,A4),A0
02:0003CB1C 10302000        	  7392:     move.b  (A0,D2.W),D0
02:0003CB20 E208            	  7393:     lsr.b  #1,D0   ; LSR A
02:0003CB22 7600            	  7394:     moveq   #0,D3
02:0003CB24 1600            	  7395:     move.b  D0,D3
                            	  7396:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7397:     ; position depends on the orientation of the monster.
                            	  7398:     ;
                            	  7399:     ; Start with the horizontal distance.
                            	  7400:     ;
02:0003CB26 102C0004        	  7401:     move.b  ($0004,A4),D0
                            	  7402:     even
                            	  7403: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7404:     ; Look up the limits for the given direction.
                            	  7405:     ;
                            	  7406:     ; If the distance from the bomb < negative limit,
                            	  7407:     ; or >= positive limit, then return.
                            	  7408:     ;
                            	  7409:     ; Note that these are simple signed comparisons that work,
                            	  7410:     ; because the operands are in a small range.
                            	  7411:     ;
02:0003CB2A 41F90003CA64    	  7412:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB30 12303000        	  7413:     move.b  (A0,D3.W),D1
02:0003CB34 B001            	  7414:     cmp.b   D1,D0
02:0003CB36 6B42            	  7415:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB38 41F90003CA6A    	  7416:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB3E 12303000        	  7417:     move.b  (A0,D3.W),D1
02:0003CB42 B001            	  7418:     cmp.b   D1,D0
02:0003CB44 6A34            	  7419:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7420:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7421:     ;
02:0003CB46 1003            	  7422:     move.b  D3,D0
02:0003CB48 023C00EE        	  7423:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB4C 123C000A        	  7424:     move.b  #$0A,D1
02:0003CB50 D101            	  7425:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB52 7600            	  7426:     moveq   #0,D3
02:0003CB54 1600            	  7427:     move.b  D0,D3
                            	  7428:     ; Bottom of the loop.
                            	  7429:     ;
                            	  7430:     ; Load the vertical distance for the next iteration.
                            	  7431:     ; Decrement loop counter.
                            	  7432:     ;
02:0003CB56 102C0005        	  7433:     move.b  ($0005,A4),D0
02:0003CB5A 5314            	  7434:     subq.b  #1,($0000,A4)
02:0003CB5C 6ACC            	  7435:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7436:     ; If we get here, then the bomb was within range of the mouth.
                            	  7437:     ; Go to state 1 (bloated).
                            	  7438:     ;
02:0003CB5E 41EC00AC        	  7439:     lea     ($00AC,A4),A0
02:0003CB62 52302000        	  7440:     addq.b  #1,(A0,D2.W)
                            	  7441:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7442:     ;
02:0003CB66 7610            	  7443:     moveq   #16,D3
02:0003CB68 7000            	  7444:     moveq   #0,D0
02:0003CB6A 41EC00AC        	  7445:     lea     ($00AC,A4),A0
02:0003CB6E 11803000        	  7446:     move.b  D0,(A0,D3.W)
02:0003CB72 41EC042C        	  7447:     lea     ($042C,A4),A0
02:0003CB76 11802000        	  7448:     move.b  D0,(A0,D2.W)
                            	  7449:     even
                            	  7450: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CB7A 4E75            	  7451:     rts
                            	  7452: 
                            	  7453:     even
                            	  7454: DodongoBombPositiveLimits:
02:0003CB7C 0C              	  7455:     dc.b    $0C, $11
02:0003CB7D 11
                            	  7456: 
                            	  7457:     even
                            	  7458: DodongoBombNegativeLimits:
02:0003CB7E F4              	  7459:     dc.b    $F4, $F0
02:0003CB7F F0
                            	  7460: 
                            	  7461: ; Params:
                            	  7462: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7463: ; [00]: monster hotspot X
                            	  7464: ; [01]: monster hotspot Y
                            	  7465: ; [02]: bomb hotspot X
                            	  7466: ; [03]: bomb hotspot Y
                            	  7467: ;
                            	  7468: ; Returns:
                            	  7469: ; A: 0 if the bomb is in range of the monster
                            	  7470: ; Z: 1 if the bomb is in range of the monster
                            	  7471: ; [04]: horizontal distance
                            	  7472: ; [05]: vertical distance
                            	  7473: ;
                            	  7474: ; Store the positive limit in [06], and the negative one in [07].
                            	  7475: ;
                            	  7476:     even
                            	  7477: Dodongo_IsBombInRange:
02:0003CB80 41F90003CB7C    	  7478:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CB86 10303000        	  7479:     move.b  (A0,D3.W),D0
02:0003CB8A 19400006        	  7480:     move.b  D0,($0006,A4)
02:0003CB8E 41F90003CB7E    	  7481:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CB94 10303000        	  7482:     move.b  (A0,D3.W),D0
02:0003CB98 19400007        	  7483:     move.b  D0,($0007,A4)
                            	  7484:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7485:     ; the bomb is near enough the monster.
                            	  7486:     ;
02:0003CB9C 7003            	  7487:     moveq   #3,D0
02:0003CB9E 19400008        	  7488:     move.b  D0,($0008,A4)
                            	  7489:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7490:     ;
02:0003CBA2 7601            	  7491:     moveq   #1,D3
                            	  7492:     even
                            	  7493: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7494:     ; Subtract the bomb's coordinate from the boss's,
                            	  7495:     ; The loop index determines the coordinate.
                            	  7496:     ;
02:0003CBA4 10343000        	  7497:     move.b  ($00,A4,D3.W),D0
02:0003CBA8 003C0011        	  7498:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBAC 12343002        	  7499:     move.b  ($02,A4,D3.W),D1
02:0003CBB0 0A3C0010        	  7500:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBB4 9101            	  7501:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBB6 0A3C0010        	  7502:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7503:     ; If the distance >= positive offset, or < negative offset;
                            	  7504:     ; then loop again.
                            	  7505:     ;
02:0003CBBA 122C0006        	  7506:     move.b  ($0006,A4),D1
02:0003CBBE B001            	  7507:     cmp.b   D1,D0
02:0003CBC0 6A16            	  7508:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CBC2 122C0007        	  7509:     move.b  ($0007,A4),D1
02:0003CBC6 B001            	  7510:     cmp.b   D1,D0
02:0003CBC8 6B0E            	  7511:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7512:     ; The distance is close enough in this axis.
                            	  7513:     ;
                            	  7514:     ; Store the distance in this axis in [05] or [04],
                            	  7515:     ; depending on the loop index.
                            	  7516:     ;
02:0003CBCA 19803004        	  7517:     move.b  D0,($04,A4,D3.W)
                            	  7518:     ; Shift [08] right, because we're in range in this axis.
                            	  7519:     ;
02:0003CBCE 122C0008        	  7520:     move.b  ($0008,A4),D1
02:0003CBD2 E209            	  7521:     lsr.b  #1,D1   ; LSR $08
02:0003CBD4 19410008        	  7522:     move.b  D1,($0008,A4)
                            	  7523:     even
                            	  7524: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CBD8 5303            	  7525:     subq.b  #1,D3
02:0003CBDA 6AC8            	  7526:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7527:     ; If close enough in both axes, then [08] will be 0.
                            	  7528:     ;
02:0003CBDC 102C0008        	  7529:     move.b  ($0008,A4),D0
02:0003CBE0 4E75            	  7530:     rts
                            	  7531: 
                            	  7532: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7533: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7534: ;
                            	  7535: ; But these are not typical direction indexes. Instead a
                            	  7536: ; 5-way index is used.
                            	  7537: ; A direction shifted right once becomes a 5-way index.
                            	  7538: ; The fourth element is unused.
                            	  7539: ;
                            	  7540:     even
                            	  7541: DodongoFrameImages:
02:0003CBE2 00              	  7542:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CBE3 01
02:0003CBE4 06
02:0003CBE5 FF
02:0003CBE6 08
02:0003CBE7 02
02:0003CBE8 03
02:0003CBE9 06
02:0003CBEA FF              	  7543:     dc.b    $FF, $08
02:0003CBEB 08
                            	  7544: 
                            	  7545:     even
                            	  7546: DodongoFrameHFlips:
02:0003CBEC 00              	  7547:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CBED 40
02:0003CBEE 00
02:0003CBEF FF
02:0003CBF0 00
02:0003CBF1 00
02:0003CBF2 40
02:0003CBF3 40
02:0003CBF4 FF              	  7548:     dc.b    $FF, $40
02:0003CBF5 40
                            	  7549: 
                            	  7550:     even
                            	  7551: DodongoFrameImagesBloated:
02:0003CBF6 04              	  7552:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CBF7 05
02:0003CBF8 07
02:0003CBF9 FF
02:0003CBFA 09
02:0003CBFB 04
02:0003CBFC 05
02:0003CBFD 07
02:0003CBFE FF              	  7553:     dc.b    $FF, $09
02:0003CBFF 09
                            	  7554: 
                            	  7555:     even
                            	  7556: DodongoFrameHFlipsBloated:
02:0003CC00 00              	  7557:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC01 40
02:0003CC02 00
02:0003CC03 FF
02:0003CC04 00
02:0003CC05 00
02:0003CC06 40
02:0003CC07 00
02:0003CC08 FF              	  7558:     dc.b    $FF, $00
02:0003CC09 00
