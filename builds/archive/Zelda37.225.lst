02:000362A0 67BA            	  4613:     beq  _anon_z02_32
                            	  4614:     ; We have a non-space character. Put it in the transfer record.
                            	  4615:     ;
02:000362A2 19400305        	  4616:     move.b  D0,($0305,A4)
                            	  4617:     ; Play the "heart taken/character" tune.
                            	  4618:     ;
02:000362A6 7010            	  4619:     moveq   #16,D0
02:000362A8 19400604        	  4620:     move.b  D0,($0604,A4)
                            	  4621:     ; If the high 2 bits of character element = 0, then return.
                            	  4622:     ;
02:000362AC 1214            	  4623:     move.b  ($00,A4),D1   ; ptr lo
02:000362AE 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:000362B2 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000362B6 E14C            	  4626:     lsl.w   #8,D4
02:000362B8 8841            	  4627:     or.w    D1,D4             ; D4 = NES ptr addr
02:000362BA 48C4            	  4628:     ext.l   D4
