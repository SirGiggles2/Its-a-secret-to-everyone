02:0003029E 102C0070        	  3161:     move.b  ($0070,A4),D0
02:000302A2 12342070        	  3162:     move.b  ($70,A4,D2.W),D1
02:000302A6 B001            	  3163:     cmp.b   D1,D0
02:000302A8 673E            	  3164:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:000302AA 6402            	  3165:     bcc  _anon_z01_26
02:000302AC 7602            	  3166:     moveq   #2,D3
                            	  3167: _anon_z01_26:
