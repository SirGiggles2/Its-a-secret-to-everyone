                            	 14230: TurnTowardsPlayer8:
                            	 14231:     ; Build a direction in [00] towards the player.
                            	 14232:     ;
                            	 14233:     ; First, calculate a horizontal component:
                            	 14234:     ;
                            	 14235:     ; If   observed player X = object X, [00] := 0 (none)
                            	 14236:     ; elif observed player X > object X, [00] := 1 (right)
                            	 14237:     ; else                               [00] := 2 (left)
                            	 14238:     ;
02:0003FD00 7600            	 14239:     moveq   #0,D3
02:0003FD02 1883            	 14240:     move.b  D3,($0000,A4)
