                            	  3966: FormatHeartsInTextBuf:
                            	  3967:     ; [$0E]: hearts value
                            	  3968:     ; [$0F]: heart partial
                            	  3969:     ; Y: The offset of first character in buffer
                            	  3970:     ;
                            	  3971:     ; The end of the bottom row is $12 bytes after the
                            	  3972:     ; start of the top row. We're writing to two transfer
                            	  3973:     ; records. We write the top row in the first transfer
                            	  3974:     ; record wherever the caller chooses. The second
                            	  3975:     ; transfer record has to begin with the heart tiles.
                            	  3976:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3977:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3978:     ;
                            	  3979:     ; Store the starting offset in [$0D].
02:000307E8 1943000D        	  3980:     move.b  D3,($000D,A4)
02:000307EC 102C000E        	  3981:     move.b  ($000E,A4),D0
02:000307F0 1B00            	  3982:     move.b  D0,-(A5)  ; PHA
02:000307F2 0200000F        	  3983:     andi.b #$0F,D0
02:000307F6 1880            	  3984:     move.b  D0,($0000,A4)
02:000307F8 700F            	  3985:     moveq   #15,D0
02:000307FA 003C0011        	  3986:     ori     #$11,CCR  ; SEC: set C+X
02:000307FE 1214            	  3987:     move.b  ($0000,A4),D1
02:00030800 0A3C0010        	  3988:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030804 9101            	  3989:     subx.b  D1,D0   ; SBC $00
02:00030806 0A3C0010        	  3990:     eori    #$10,CCR  ; restore X = 6502 C
02:0003080A 1880            	  3991:     move.b  D0,($0000,A4)
02:0003080C 101D            	  3992:     move.b  (A5)+,D0  ; PLA
02:0003080E E208            	  3993:     lsr.b  #1,D0   ; LSR A
02:00030810 E208            	  3994:     lsr.b  #1,D0   ; LSR A
02:00030812 E208            	  3995:     lsr.b  #1,D0   ; LSR A
02:00030814 E208            	  3996:     lsr.b  #1,D0   ; LSR A
02:00030816 19400001        	  3997:     move.b  D0,($0001,A4)
02:0003081A 700F            	  3998:     moveq   #15,D0
02:0003081C 003C0011        	  3999:     ori     #$11,CCR  ; SEC: set C+X
02:00030820 122C0001        	  4000:     move.b  ($0001,A4),D1
02:00030824 0A3C0010        	  4001:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030828 9101            	  4002:     subx.b  D1,D0   ; SBC $01
02:0003082A 0A3C0010        	  4003:     eori    #$10,CCR  ; restore X = 6502 C
02:0003082E 19400001        	  4004:     move.b  D0,($0001,A4)
                            	  4005:     ; At this point,
                            	  4006:     ; [$00] = $F - hearts
                            	  4007:     ; [$01] = $F - heart containers
                            	  4008:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  4009:     ;
                            	  4010:     ; Also, Y is still set to the value passed in.
                            	  4011:     ;
02:00030832 7400            	  4012:     moveq   #0,D2
02:00030834 1003            	  4013:     move.b  D3,D0
02:00030836 023C00EE        	  4014:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003083A 123C0007        	  4015:     move.b  #$07,D1
02:0003083E D101            	  4016:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030840 1940000B        	  4017:     move.b  D0,($000B,A4)
                            	  4018:     ; Y keeps track of index of heart in row.
                            	  4019:     ; Start at the end of the first row.
