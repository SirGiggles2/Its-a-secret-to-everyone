02:0004CA40 41EC00AC        	  6038:     lea     ($00AC,A4),A0
02:0004CA44 11802000        	  6039:     move.b  D0,(A0,D2.W)
02:0004CA48 0C02000D        	  6040:     cmpi.b  #$0D,D2
