02:0004BE80 654C            	  4260:     bcs  _L_z07_MoveObject_Right
02:0004BE82 E208            	  4261:     lsr.b  #1,D0   ; LSR A
02:0004BE84 655E            	  4262:     bcs  _L_z07_MoveObject_Left
