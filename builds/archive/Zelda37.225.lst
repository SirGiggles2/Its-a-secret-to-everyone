                            	   380: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   381:     ; The submenu map's rotation < 8.
                            	   382:     ; It represents the number of tiles to move right.
                            	   383:     ; So, multiply it by 8.
                            	   384:     ;
02:000401F0 E308            	   385:     lsl.b  #1,D0   ; ASL A
02:000401F2 E308            	   386:     lsl.b  #1,D0   ; ASL A
02:000401F4 E308            	   387:     lsl.b  #1,D0   ; ASL A
                            	   388:     even
                            	   389: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   390:     ; Add the offset we calculated, and $62 to [00] to get
                            	   391:     ; the position marker's X coordinate.
                            	   392:     ;
02:000401F6 023C00EE        	   393:     andi    #$EE,CCR  ; CLC: clear C+X
02:000401FA 1214            	   394:     move.b  ($0000,A4),D1
02:000401FC D101            	   395:     addx.b  D1,D0   ; ADC $00
02:000401FE 023C00EE        	   396:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040202 123C0062        	   397:     move.b  #$62,D1
02:00040206 D101            	   398:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:00040208 19400253        	   399:     move.b  D0,($0253,A4)
                            	   400:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   401:     ; Divide by 2 to get a multiple of the tile height.
                            	   402:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   403:     ;
02:0004020C 102C00EB        	   404:     move.b  ($00EB,A4),D0
02:00040210 020000F0        	   405:     andi.b #$F0,D0
02:00040214 E208            	   406:     lsr.b  #1,D0   ; LSR A
02:00040216 123C0069        	   407:     move.b  #$69,D1
02:0004021A D101            	   408:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:0004021C 19400250        	   409:     move.b  D0,($0250,A4)
                            	   410:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   411:     ;
02:00040220 703E            	   412:     moveq   #62,D0
02:00040222 19400251        	   413:     move.b  D0,($0251,A4)
02:00040226 7000            	   414:     moveq   #0,D0
02:00040228 19400252        	   415:     move.b  D0,($0252,A4)
                            	   416:     even
