                            	  5830: _L_z01_CheckMazes_PlaySecretTune:
                            	  5831:     ; Play secret tune, and let the player leave the maze.
                            	  5832:     ;
02:00031460 7004            	  5833:     moveq   #4,D0
02:00031462 19400602        	  5834:     move.b  D0,($0602,A4)
02:00031466 4E75            	  5835:     rts
                            	  5836: 
                            	  5837: ; Params:
                            	  5838: ; [02]: Y
                            	  5839: ; [03]: X
                            	  5840: ;
                            	  5841: ; Returns:
                            	  5842: ; [00]: high byte of PPU address
                            	  5843: ; [01]: low byte of PPU address
                            	  5844: ;
                            	  5845: ;
                            	  5846: ; Turn the 16-bit value 08YY into the PPU address
                            	  5847: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5848: ;
                            	  5849: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5850: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5851: ;
                            	  5852:     even
                            	  5853: MapScreenPosToPpuAddr:
02:00031468 6000A5FC        	  5854:     jmp     c_map_screen_pos_to_ppu_addr
