02:0004D5C2 0C000011        	  7537:     cmpi.b  #$11,D0
02:0004D5C6 6700017A        	  7538:     beq  _L_z07_InitObject_NormalSpawn
02:0004D5CA 0C000040        	  7539:     cmpi.b  #$40,D0
02:0004D5CE 67000172        	  7540:     beq  _L_z07_InitObject_NormalSpawn
