02:0004BE94 10302000        	  4269:     move.b  (A0,D2.W),D0
02:0004BE98 123C0000        	  4270:     move.b  #$00,D1
02:0004BE9C 0A3C0010        	  4271:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BEA0 9101            	  4272:     subx.b  D1,D0   ; SBC #$00
02:0004BEA2 0A3C0010        	  4273:     eori    #$10,CCR  ; restore X = 6502 C
