                            	  1926: _L_z04_UpdateStatues_Shoot:
                            	  1927:     ; Look for an empty monster slot.
                            	  1928:     ; If none is found, return.
                            	  1929:     ;
                            	  1930:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1931:     ; object. This routine takes a shooter object, and instantiates
                            	  1932:     ; a fireball object at the shooter's location.
                            	  1933:     ;
                            	  1934:     ; The object slot we set up here will behave as the shooter.
                            	  1935:     ; For each fireball index, this object slot will have its coordinates
                            	  1936:     ; changed.
                            	  1937:     ;
                            	  1938:     ; Note that this means that:
                            	  1939:     ; 1. The first fireball made will be its own shooter.
                            	  1940:     ;    Practically, there's nothing special about this.
                            	  1941:     ; 2. If there is more than one fireball made in a frame,
                            	  1942:     ;    then two of them will come from the same statue.
                            	  1943:     ;
                            	  1944:     ;
                            	  1945:     ; Save the fireball pattern.
02:0003A426 1003            	  1946:     move.b  D3,D0
02:0003A428 1B00            	  1947:     move.b  D0,-(A5)  ; PHA
02:0003A42A 4EB90004D9E0    	  1948:     jsr     FindEmptyMonsterSlot
02:0003A430 0C000001        	  1949:     cmpi.b  #$01,D0
02:0003A434 101D            	  1950:     move.b  (A5)+,D0  ; PLA
02:0003A436 6400010A        	  1951:     bcc  _L_z04_UpdateStatues_Exit
                            	  1952:     ; If we found a slot, but it < 6, return.
                            	  1953:     ;
02:0003A43A 0C030006        	  1954:     cmpi.b  #$06,D3
02:0003A43E 65000102        	  1955:     bcs  _L_z04_UpdateStatues_Exit
                            	  1956:     ; Store the object slot in [0A].
                            	  1957:     ; Store fireball pattern in [0B].
                            	  1958:     ;
02:0003A442 1943000A        	  1959:     move.b  D3,($000A,A4)
02:0003A446 1940000B        	  1960:     move.b  D0,($000B,A4)
                            	  1961:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1962:     ;
02:0003A44A 7600            	  1963:     moveq   #0,D3
02:0003A44C 1600            	  1964:     move.b  D0,D3
02:0003A44E 7400            	  1965:     moveq   #0,D2
02:0003A450 41F90003A3E2    	  1966:     lea     (StatueFireballCounts).l,A0
02:0003A456 14303000        	  1967:     move.b  (A0,D3.W),D2
                            	  1968:     even
                            	  1969: _L_z04_UpdateStatues_LoopFireball:
                            	  1970:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1971:     ;
                            	  1972:     ; Decrement the fireball timer at this index.
                            	  1973:     ;
02:0003A45A 7600            	  1974:     moveq   #0,D3
02:0003A45C 41EC04E8        	  1975:     lea     ($04E8,A4),A0
02:0003A460 16302000        	  1976:     move.b  (A0,D2.W),D3
02:0003A464 5303            	  1977:     subq.b  #1,D3
02:0003A466 1003            	  1978:     move.b  D3,D0
02:0003A468 41EC04E8        	  1979:     lea     ($04E8,A4),A0
02:0003A46C 11802000        	  1980:     move.b  D0,(A0,D2.W)
                            	  1981:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1982:     ; to make a fireball. Go loop again.
                            	  1983:     ;
02:0003A470 5203            	  1984:     addq.b  #1,D3
02:0003A472 660000C8        	  1985:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1986:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1987:     ; This fireball index will wait another $100 frames.
                            	  1988:     ;
02:0003A476 10342018        	  1989:     move.b  ($18,A4,D2.W),D0
02:0003A47A 0C0000F0        	  1990:     cmpi.b  #$F0,D0
02:0003A47E 640000BC        	  1991:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1992:     ; Else choose one of four start times for the fireball based on
                            	  1993:     ; the random value.
                            	  1994:     ;
02:0003A482 02000003        	  1995:     andi.b #$03,D0
02:0003A486 7600            	  1996:     moveq   #0,D3
02:0003A488 1600            	  1997:     move.b  D0,D3
02:0003A48A 41F90003A3E6    	  1998:     lea     (StatueFireballStartTimes).l,A0
02:0003A490 10303000        	  1999:     move.b  (A0,D3.W),D0
02:0003A494 41EC04E8        	  2000:     lea     ($04E8,A4),A0
02:0003A498 11802000        	  2001:     move.b  D0,(A0,D2.W)
                            	  2002:     ; The coordinate lists are divided into sets for each pattern.
                            	  2003:     ;
                            	  2004:     ; Look up the index of the base of the set for the pattern in use.
                            	  2005:     ; Add it to the fireball index in X register to get the index of
                            	  2006:     ; the coordinate we want within each coordinate list.
                            	  2007:     ;
                            	  2008:     ;
                            	  2009:     ; Pattern
02:0003A49C 7600            	  2010:     moveq   #0,D3
02:0003A49E 162C000B        	  2011:     move.b  ($000B,A4),D3
02:0003A4A2 1002            	  2012:     move.b  D2,D0
02:0003A4A4 023C00EE        	  2013:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A4A8 41F90003A3EA    	  2014:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A4AE 12303000        	  2015:     move.b  (A0,D3.W),D1
02:0003A4B2 D101            	  2016:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A4B4 7600            	  2017:     moveq   #0,D3
02:0003A4B6 1600            	  2018:     move.b  D0,D3
02:0003A4B8 1002            	  2019:     move.b  D2,D0
02:0003A4BA 1B00            	  2020:     move.b  D0,-(A5)  ; PHA
                            	  2021:     ; Get Link's coordinates into [00] and [01].
                            	  2022:     ;
02:0003A4BC 7400            	  2023:     moveq   #0,D2
02:0003A4BE 4EB90004D1F0    	  2024:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2025:     ; Switch to the new fireball's object slot.
                            	  2026:     ;
02:0003A4C4 7400            	  2027:     moveq   #0,D2
02:0003A4C6 142C000A        	  2028:     move.b  ($000A,A4),D2
                            	  2029:     ; Look up and set the X coordinate for the fireball object.
                            	  2030:     ; Also store it in [02].
                            	  2031:     ;
02:0003A4CA 41F90003A3EE    	  2032:     lea     (StatueXs).l,A0
02:0003A4D0 10303000        	  2033:     move.b  (A0,D3.W),D0
02:0003A4D4 19400002        	  2034:     move.b  D0,($0002,A4)
02:0003A4D8 19802070        	  2035:     move.b  D0,($70,A4,D2.W)
                            	  2036:     ; Look up and set the Y coordinate for the fireball object.
                            	  2037:     ; Also store it in [03].
                            	  2038:     ;
02:0003A4DC 41F90003A3F6    	  2039:     lea     (StatueYs).l,A0
02:0003A4E2 10303000        	  2040:     move.b  (A0,D3.W),D0
02:0003A4E6 19400003        	  2041:     move.b  D0,($0003,A4)
02:0003A4EA 41EC0084        	  2042:     lea     ($0084,A4),A0
02:0003A4EE 11802000        	  2043:     move.b  D0,(A0,D2.W)
                            	  2044:     ; Set mask value 3 in [04].
                            	  2045:     ;
02:0003A4F2 7003            	  2046:     moveq   #3,D0
02:0003A4F4 19400004        	  2047:     move.b  D0,($0004,A4)
                            	  2048:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2049:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2050:     ;
02:0003A4F8 7601            	  2051:     moveq   #1,D3
                            	  2052:     even
                            	  2053: _L_z04_UpdateStatues_LoopAxis:
02:0003A4FA 10343000        	  2054:     move.b  ($00,A4,D3.W),D0
02:0003A4FE 003C0011        	  2055:     ori     #$11,CCR  ; SEC: set C+X
02:0003A502 12343002        	  2056:     move.b  ($02,A4,D3.W),D1
02:0003A506 0A3C0010        	  2057:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A50A 9101            	  2058:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A50C 0A3C0010        	  2059:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A510 0C000018        	  2060:     cmpi.b  #$18,D0
02:0003A514 6A10            	  2061:     bpl  _anon_z04_31
02:0003A516 0C0000E8        	  2062:     cmpi.b  #$E8,D0
02:0003A51A 6B0A            	  2063:     bmi  _anon_z04_31
02:0003A51C 122C0004        	  2064:     move.b  ($0004,A4),D1
02:0003A520 E209            	  2065:     lsr.b  #1,D1   ; LSR $04
02:0003A522 19410004        	  2066:     move.b  D1,($0004,A4)
                            	  2067: _anon_z04_31:
02:0003A526 5303            	  2068:     subq.b  #1,D3
02:0003A528 6AD0            	  2069:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  2070:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2071:     ; 0 or 1 time, instead of 2.
                            	  2072:     ;
                            	  2073:     ; This, in turn, means that the distance between Link and the
                            	  2074:     ; fireball was >= $18 in at least one axis.
                            	  2075:     ;
                            	  2076:     ; So, we're OK to finish making the fireball.
                            	  2077:     ;
02:0003A52A 102C0004        	  2078:     move.b  ($0004,A4),D0
02:0003A52E 6706            	  2079:     beq  _anon_z04_32
02:0003A530 7055            	  2080:     moveq   #85,D0
02:0003A532 6100F812        	  2081:     jsr     ShootFireball
                            	  2082: _anon_z04_32:
02:0003A536 101D            	  2083:     move.b  (A5)+,D0  ; PLA
02:0003A538 7400            	  2084:     moveq   #0,D2
02:0003A53A 1400            	  2085:     move.b  D0,D2
                            	  2086:     even
                            	  2087: _L_z04_UpdateStatues_NextLoopFireball:
                            	  2088:     ; Bottom of the loop.
                            	  2089:     ; Loop while fireball index >= 0.
                            	  2090:     ;
02:0003A53C 5302            	  2091:     subq.b  #1,D2
02:0003A53E 6A00FF1A        	  2092:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  2093:     even
