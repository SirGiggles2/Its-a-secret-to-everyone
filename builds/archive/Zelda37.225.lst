02:0003C838 41F90003168E    	  6994:     lea     (SpriteOffsets).l,A0
02:0003C83E 10303000        	  6995:     move.b  (A0,D3.W),D0
02:0003C842 7600            	  6996:     moveq   #0,D3
02:0003C844 1600            	  6997:     move.b  D0,D3
02:0003C846 101D            	  6998:     move.b  (A5)+,D0  ; PLA
02:0003C848 41EC0201        	  6999:     lea     ($0201,A4),A0
02:0003C84C 11803000        	  7000:     move.b  D0,(A0,D3.W)
02:0003C850 1014            	  7001:     move.b  ($0000,A4),D0
02:0003C852 41EC0203        	  7002:     lea     ($0203,A4),A0
02:0003C856 11803000        	  7003:     move.b  D0,(A0,D3.W)
02:0003C85A 102C0001        	  7004:     move.b  ($0001,A4),D0
02:0003C85E 4EF900031A0C    	  7005:     jmp     Anim_EndWriteSprite
