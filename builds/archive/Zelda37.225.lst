                            	   893: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_CheckPickUp:
                            	   894:     ; This is a cave where the player chooses or touches an item:
                            	   895:     ; - give item
                            	   896:     ; - shop
                            	   897:     ; - hint
                            	   898:     ; - money game
                            	   899:     ;
                            	   900:     ; If rupees are decreasing, then return.
                            	   901:     ;
02:0002E264 102C067E        	   902:     move.b  ($067E,A4),D0
02:0002E268 66F8            	   903:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_Exit
                            	   904:     ; Loop over each item from 2 to 0.
