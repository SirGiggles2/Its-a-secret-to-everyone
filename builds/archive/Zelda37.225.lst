                            	  6009: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  6010:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  6011:     ;
02:00043914 101D            	  6012:     move.b  (A5)+,D0  ; PLA
