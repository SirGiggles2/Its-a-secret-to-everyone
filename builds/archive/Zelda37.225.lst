                            	  2791: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2792:     ; State 1. Jumping.
                            	  2793:     ;
                            	  2794:     ; Keep the object inside the bounds of the room.
                            	  2795:     ;
02:0003A9B2 610052A0        	  2796:     jsr     BoundFlyer
                            	  2797:     ; If the object was blocked at the room boundary, then
                            	  2798:     ; increase boundary reversal count, and go set up another jump.
                            	  2799:     ;
02:0003A9B6 102C000F        	  2800:     move.b  ($000F,A4),D0
02:0003A9BA 660C            	  2801:     bne  _anon_z04_37
02:0003A9BC 41EC0451        	  2802:     lea     ($0451,A4),A0
02:0003A9C0 52302000        	  2803:     addq.b  #1,(A0,D2.W)
02:0003A9C4 6000FF74        	  2804:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2805: 
                            	  2806: _anon_z04_37:
02:0003A9C8 61000196        	  2807:     jsr     Jumper_PointBoulderDownward
                            	  2808:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2809:     ;
02:0003A9CC 7000            	  2810:     moveq   #0,D0
02:0003A9CE 41EC0451        	  2811:     lea     ($0451,A4),A0
02:0003A9D2 11802000        	  2812:     move.b  D0,(A0,D2.W)
                            	  2813:     ; Get the base offset for the kind of jumper the object is.
                            	  2814:     ;
02:0003A9D6 6100015E        	  2815:     jsr     Jumper_GetKind
02:0003A9DA 41F90003A8C6    	  2816:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A9E0 10303000        	  2817:     move.b  (A0,D3.W),D0
                            	  2818:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2819:     ;
                            	  2820:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2821:     ; does not have $B elements like the tektites' sets.
                            	  2822:     ;
                            	  2823:     ; Boulder does not need the upward accelerations.
                            	  2824:     ; So, the elements for those are used for the starting speeds
                            	  2825:     ; at 04:88F2.
                            	  2826:     ;
02:0003A9E4 023C00EE        	  2827:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A9E8 41EC0098        	  2828:     lea     ($0098,A4),A0
02:0003A9EC 12302000        	  2829:     move.b  (A0,D2.W),D1
02:0003A9F0 D101            	  2830:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A9F2 7600            	  2831:     moveq   #0,D3
02:0003A9F4 1600            	  2832:     move.b  D0,D3
02:0003A9F6 41F90003A8A4    	  2833:     lea     (JumperYAccelerations).l,A0
02:0003A9FC 10303000        	  2834:     move.b  (A0,D3.W),D0
02:0003AA00 7602            	  2835:     moveq   #2,D3
02:0003AA02 61000162        	  2836:     jsr     Jumper_MoveY
                            	  2837:     ; If the facing direction has a left component, then
                            	  2838:     ; subtract 1 from the object's X.
                            	  2839:     ;
                            	  2840:     ; Else add 1.
                            	  2841:     ;
02:0003AA06 163C00FF        	  2842:     move.b  #$FF,D3
02:0003AA0A 41EC0098        	  2843:     lea     ($0098,A4),A0
02:0003AA0E 10302000        	  2844:     move.b  (A0,D2.W),D0
02:0003AA12 02000002        	  2845:     andi.b #$02,D0
02:0003AA16 6602            	  2846:     bne  _anon_z04_38
02:0003AA18 7601            	  2847:     moveq   #1,D3
                            	  2848: _anon_z04_38:
02:0003AA1A 1003            	  2849:     move.b  D3,D0
02:0003AA1C 023C00EE        	  2850:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA20 12342070        	  2851:     move.b  ($70,A4,D2.W),D1
02:0003AA24 D101            	  2852:     addx.b  D1,D0   ; ADC ObjX,X
