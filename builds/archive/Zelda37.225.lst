                            	  3203:     ;
02:000302E8 102C0070        	  3204:     move.b  ($0070,A4),D0
02:000302EC 003C0011        	  3205:     ori     #$11,CCR  ; SEC: set C+X
02:000302F0 12342070        	  3206:     move.b  ($70,A4,D2.W),D1
02:000302F4 0A3C0010        	  3207:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000302F8 9101            	  3208:     subx.b  D1,D0   ; SBC ObjX,X
02:000302FA 0A3C0010        	  3209:     eori    #$10,CCR  ; restore X = 6502 C
02:000302FE 6100082C        	  3210:     jsr     Abs
02:00030302 0C00000E        	  3211:     cmpi.b  #$0E,D0
02:00030306 64DC            	  3212:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3213:     ; Determine the vertical direction toward Link;
                            	  3214:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3215:     ; along this axis. Go draw and check object collisions.
                            	  3216:     ;
02:00030308 7604            	  3217:     moveq   #4,D3
02:0003030A 102C0084        	  3218:     move.b  ($0084,A4),D0
