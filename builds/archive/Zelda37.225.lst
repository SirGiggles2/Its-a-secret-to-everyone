                            	  4943: 
                            	  4944: ; Params:
                            	  4945: ; [02:03]: address of door tiles for direction and face
                            	  4946: ; [04]: count of tiles remaining
                            	  4947: ; [07]: current index (0 to 3) of the tile to copy
                            	  4948: ;       to the dynamic transfer buf
                            	  4949: ; [09]: door direction index
                            	  4950: ;
                            	  4951: ; Returns:
                            	  4952: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4953: ; [04]: original value - 1
                            	  4954: ; [07]: original value + 1
                            	  4955: ;
                            	  4956: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4957: ; vertically. The point of this routine is to access them
                            	  4958: ; horizontally in order to transfer them to a nametable.
                            	  4959: ;
                            	  4960: ;
                            	  4961: ; For the direction index in [09], look up the base offset of the
                            	  4962: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4963: ; the door face tiles at [02:03].
                            	  4964: ;
                            	  4965:     even
                            	  4966: WriteDoorFaceTileHorizontally:
02:000427EA 7600            	  4967:     moveq   #0,D3
02:000427EC 162C0009        	  4968:     move.b  ($0009,A4),D3
02:000427F0 41F900043A0E    	  4969:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:000427F6 10303000        	  4970:     move.b  (A0,D3.W),D0
                            	  4971:     ; Add [07] to the base offset we got above. This yields one
                            	  4972:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4973:     ;
02:000427FA 023C00EE        	  4974:     andi    #$EE,CCR  ; CLC: clear C+X
02:000427FE 122C0007        	  4975:     move.b  ($0007,A4),D1
02:00042802 D101            	  4976:     addx.b  D1,D0   ; ADC $07
