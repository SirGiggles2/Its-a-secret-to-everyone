                            	 11069: __far_z_04_0105:
                            	 11070: ; Description:
                            	 11071: ; This block applies to heads and the bottom segment of a neck.
                            	 11072: ; These are drawn with sprites that come first in order, so that
                            	 11073: ; they are drawn above all other sprites, including Link.
                            	 11074: ;
                            	 11075: ; Params:
                            	 11076: ; A: tile number
                            	 11077: ;
                            	 11078: ; Normal sprite with level palette row
                            	 11079:     even
                            	 11080: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E658 7603            	 11081:     moveq   #3,D3
02:0003E65A 19430003        	 11082:     move.b  D3,($0003,A4)
02:0003E65E 1B00            	 11083:     move.b  D0,-(A5)  ; PHA
                            	 11084:     ; To calculate the base offset of the sprite record:
                            	 11085:     ; offset := neck index * 8
                            	 11086:     ;
                            	 11087:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11088:     ; at an even index.
                            	 11089:     ;
02:0003E660 102C04D7        	 11090:     move.b  ($04D7,A4),D0
02:0003E664 E308            	 11091:     lsl.b  #1,D0   ; ASL A
02:0003E666 E308            	 11092:     lsl.b  #1,D0   ; ASL A
02:0003E668 E308            	 11093:     lsl.b  #1,D0   ; ASL A
                            	 11094:     ; But if the segment is not a head (not at object slot 5), then
                            	 11095:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11096:     ;
02:0003E66A 0C020005        	 11097:     cmpi.b  #$05,D2
02:0003E66E 670A            	 11098:     beq  _anon_z04_139
02:0003E670 023C00EE        	 11099:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E674 123C0020        	 11100:     move.b  #$20,D1
02:0003E678 D101            	 11101:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11102: _anon_z04_139:
02:0003E67A 7600            	 11103:     moveq   #0,D3
02:0003E67C 1600            	 11104:     move.b  D0,D3
02:0003E67E 101D            	 11105:     move.b  (A5)+,D0  ; PLA
02:0003E680 4EB9000319F0    	 11106:     jsr     Anim_WriteSpecificSprite
