02:0004C52C 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C530 122C0002        	  5299:     move.b  ($0002,A4),D1
02:0004C534 D101            	  5300:     addx.b  D1,D0   ; ADC $02
02:0004C536 1880            	  5301:     move.b  D0,($0000,A4)
