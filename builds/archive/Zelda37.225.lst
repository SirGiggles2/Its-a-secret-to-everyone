02:000335F6 11803000        	   566:     move.b  D0,(A0,D3.W)
02:000335FA 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:000335FE 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
