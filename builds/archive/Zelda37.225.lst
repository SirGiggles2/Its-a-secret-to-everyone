02:00044FE0 162C0010        	  8523:     move.b  ($0010,A4),D3
02:00044FE4 6700008C        	  8524:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8525:     ; In UW. There are two input directions, and they're both walkable.
                            	  8526:     ;
                            	  8527:     ; Normally, turn to the direction that's perpendicular to object
                            	  8528:     ; direction. But keep going straight after that, while diagonal
                            	  8529:     ; input is held.
                            	  8530:     ;
                            	  8531:     ; Handle special cases for doors.
                            	  8532:     ;
                            	  8533:     ;
                            	  8534:     ; 1. Link at horizontal doors.
                            	  8535:     ;
                            	  8536:     ; If Link's X = $20 or $D0 then
                            	  8537:     ;   If Link's Y = $85 and facing down then
                            	  8538:     ;     Go set object direction and input direction to object
                            	  8539:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8540:     ;     Link_GoStraightWhenDiagInput.
                            	  8541:     ;   Else
                            	  8542:     ;     Go turn to the perpendicular direction
                            	  8543:     ;
02:00044FE8 7600            	  8544:     moveq   #0,D3
02:00044FEA 162C0070        	  8545:     move.b  ($0070,A4),D3
02:00044FEE 0C030020        	  8546:     cmpi.b  #$20,D3
02:00044FF2 6706            	  8547:     beq  _anon_z05_175
02:00044FF4 0C0300D0        	  8548:     cmpi.b  #$D0,D3
02:00044FF8 661C            	  8549:     bne  _anon_z05_176
