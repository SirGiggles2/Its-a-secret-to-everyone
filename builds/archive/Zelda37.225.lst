                            	 12212: Lamnola_Move:
                            	 12213:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12214:     ;
                            	 12215:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12216:     ;
                            	 12217:     ; Start with a mask of $A1 in [02]:
                            	 12218:     ; - low nibble represents the right direction
                            	 12219:     ; - high nibble is used to set or clear carry as we go along
                            	 12220:     ;
02:0003EEA4 103C00A1        	 12221:     move.b  #$A1,D0
02:0003EEA8 19400002        	 12222:     move.b  D0,($0002,A4)
                            	 12223:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12224:     ;
02:0003EEAC 41EC0098        	 12225:     lea     ($0098,A4),A0
02:0003EEB0 10302000        	 12226:     move.b  (A0,D2.W),D0
02:0003EEB4 122C0002        	 12227:     move.b  ($0002,A4),D1
02:0003EEB8 C200            	 12228:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEBA 6712            	 12229:     beq  _L_z04_Lamnola_Move_Left
02:0003EEBC 10342070        	 12230:     move.b  ($70,A4,D2.W),D0
02:0003EEC0 023C00EE        	 12231:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEC4 122C04E6        	 12232:     move.b  ($04E6,A4),D1
02:0003EEC8 D101            	 12233:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003EECA 19802070        	 12234:     move.b  D0,($70,A4,D2.W)
                            	 12235:     even
                            	 12236: _L_z04_Lamnola_Move_Left:
                            	 12237:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 12238:     ;
02:0003EECE 41EC0098        	 12239:     lea     ($0098,A4),A0
02:0003EED2 10302000        	 12240:     move.b  (A0,D2.W),D0
02:0003EED6 122C0002        	 12241:     move.b  ($0002,A4),D1
02:0003EEDA E309            	 12242:     lsl.b  #1,D1   ; ASL $02
02:0003EEDC 19410002        	 12243:     move.b  D1,($0002,A4)
02:0003EEE0 122C0002        	 12244:     move.b  ($0002,A4),D1
02:0003EEE4 C200            	 12245:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEE6 6716            	 12246:     beq  _L_z04_Lamnola_Move_Down
02:0003EEE8 10342070        	 12247:     move.b  ($70,A4,D2.W),D0
02:0003EEEC 122C04E6        	 12248:     move.b  ($04E6,A4),D1
02:0003EEF0 0A3C0010        	 12249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEF4 9101            	 12250:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EEF6 0A3C0010        	 12251:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEFA 19802070        	 12252:     move.b  D0,($70,A4,D2.W)
                            	 12253:     even
