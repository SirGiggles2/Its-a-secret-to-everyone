02:0003C024 41EC0350        	  5857:     lea     ($0350,A4),A0
02:0003C028 10303000        	  5858:     move.b  (A0,D3.W),D0
02:0003C02C 0C000041        	  5859:     cmpi.b  #$41,D0
02:0003C030 66F0            	  5860:     bne  _anon_z04_80
                            	  5861:     ; I don't know why the object timer of the tail segment that will
                            	  5862:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5863:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5864:     ; there, the object timer is set to 6.
                            	  5865:     ;
02:0003C032 7011            	  5866:     moveq   #17,D0
02:0003C034 19803029        	  5867:     move.b  D0,($29,A4,D3.W)
                            	  5868:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5869:     ; segment to the tail segment.
                            	  5870:     ;
02:0003C038 41EC04F0        	  5871:     lea     ($04F0,A4),A0
02:0003C03C 10302000        	  5872:     move.b  (A0,D2.W),D0
02:0003C040 41EC04F1        	  5873:     lea     ($04F1,A4),A0
02:0003C044 11803000        	  5874:     move.b  D0,(A0,D3.W)
02:0003C048 10342070        	  5875:     move.b  ($70,A4,D2.W),D0
02:0003C04C 19803071        	  5876:     move.b  D0,($71,A4,D3.W)
02:0003C050 41EC0084        	  5877:     lea     ($0084,A4),A0
02:0003C054 10302000        	  5878:     move.b  (A0,D2.W),D0
02:0003C058 41EC0085        	  5879:     lea     ($0085,A4),A0
02:0003C05C 11803000        	  5880:     move.b  D0,(A0,D3.W)
                            	  5881:     ; If the tail segment found is also a head, then
