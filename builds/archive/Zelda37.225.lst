02:0003DC42 0C00003C        	  9723:     cmpi.b  #$3C,D0
02:0003DC46 6602            	  9724:     bne  _anon_z04_113
02:0003DC48 5214            	  9725:     addq.b  #1,($0000,A4)
                            	  9726: _anon_z04_113:
02:0003DC4A 5303            	  9727:     subq.b  #1,D3
02:0003DC4C 6AEC            	  9728:     bpl  _L_z04_Manhandla_CheckCollisions_LoopHand
                            	  9729:     ; Decrease by 1, to account for the current dead one.
