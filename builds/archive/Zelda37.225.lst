02:0003E770 162C04D7        	 11233:     move.b  ($04D7,A4),D3
02:0003E774 41F90004AD80    	 11234:     lea     (LevelMasks).l,A0
02:0003E77A 10303000        	 11235:     move.b  (A0,D3.W),D0
