02:0003DC14 41EC0405        	  9691:     lea     ($0405,A4),A0
02:0003DC18 10302000        	  9692:     move.b  (A0,D2.W),D0
02:0003DC1C 674E            	  9693:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DC1E 4EB90004BB74    	  9694:     jsr     ResetShoveInfo
