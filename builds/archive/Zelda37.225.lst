02:0003ECAA 41EC0485        	 11907:     lea     ($0485,A4),A0
02:0003ECAE 11802000        	 11908:     move.b  D0,(A0,D2.W)
                            	 11909:     ; Find the tail of the lamnola that the current segment belongs to.
