                            	  8485: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8486:     ; If the teleporting distance remaining is even, then draw
                            	  8487:     ; and check collisions, else return.
                            	  8488:     ;
                            	  8489:     ; This means that when 0, the monster is walking.
                            	  8490:     ; So, draw and check collisions every frame.
                            	  8491:     ;
                            	  8492:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8493:     ; translucently -- every other frame.
                            	  8494:     ;
02:0003D322 41EC0394        	  8495:     lea     ($0394,A4),A0
02:0003D326 10302000        	  8496:     move.b  (A0,D2.W),D0
