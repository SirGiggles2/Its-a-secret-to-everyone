02:0004D5D6 6700016A        	  7542:     beq  _L_z07_InitObject_NormalSpawn
02:0004D5DA 0C00002E        	  7543:     cmpi.b  #$2E,D0
02:0004D5DE 67000162        	  7544:     beq  _L_z07_InitObject_NormalSpawn
