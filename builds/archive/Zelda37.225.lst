                            	 13133: GanonSpriteOffsetsX:
02:0003F53C 00              	 13134:     dc.b    $00, $10, $00, $10
02:0003F53D 10
02:0003F53E 00
02:0003F53F 10
                            	 13135: 
                            	 13136:     even
                            	 13137: GanonSpriteOffsetsY:
02:0003F540 00              	 13138:     dc.b    $00, $00, $10, $10
02:0003F541 00
02:0003F542 10
