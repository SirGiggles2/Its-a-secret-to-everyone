02:0003AE4C 101D            	  3399:     move.b  (A5)+,D0  ; PLA
02:0003AE4E 19400001        	  3400:     move.b  D0,($0001,A4)
                            	  3401:     even
                            	  3402: _L_z04_UpdateRedLeever_Subtract:
                            	  3403:     ; The point is to get the absolute distance between the two.
                            	  3404:     ;
02:0003AE52 102C0001        	  3405:     move.b  ($0001,A4),D0
02:0003AE56 003C0011        	  3406:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE5A 122C0002        	  3407:     move.b  ($0002,A4),D1
02:0003AE5E 0A3C0010        	  3408:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE62 9101            	  3409:     subx.b  D1,D0   ; SBC $02
02:0003AE64 0A3C0010        	  3410:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3411:     ; If the absolute distance >= $30, then return.
                            	  3412:     ; It means that the leever's X coordinate wrapped around
                            	  3413:     ; the left or right edge of the screen.
                            	  3414:     ;
