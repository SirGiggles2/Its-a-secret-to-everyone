02:0002E0CC 41EC0308        	   666:     lea     ($0308,A4),A0
02:0002E0D0 11803000        	   667:     move.b  D0,(A0,D3.W)
02:0002E0D4 102C0001        	   668:     move.b  ($0001,A4),D0
02:0002E0D8 6148            	   669:     jsr     SwapSpaceAndSign
02:0002E0DA 41EC0307        	   670:     lea     ($0307,A4),A0
02:0002E0DE 11803000        	   671:     move.b  D0,(A0,D3.W)
02:0002E0E2 102C0003        	   672:     move.b  ($0003,A4),D0
02:0002E0E6 41EC0309        	   673:     lea     ($0309,A4),A0
02:0002E0EA 11803000        	   674:     move.b  D0,(A0,D3.W)
