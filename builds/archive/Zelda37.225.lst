                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:0004025E 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:00040262 02000010        	   446:     andi.b #$10,D0
