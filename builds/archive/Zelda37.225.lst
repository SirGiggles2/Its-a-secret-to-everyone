02:00043CC0 101D            	  6520:     move.b  (A5)+,D0  ; PLA
02:00043CC2 E308            	  6521:     lsl.b  #1,D0   ; ASL A
02:00043CC4 E308            	  6522:     lsl.b  #1,D0   ; ASL A
