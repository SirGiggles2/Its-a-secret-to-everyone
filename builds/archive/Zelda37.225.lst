                            	 10147: _L_z04_UpdateGohma_AnimateClosedEye:
                            	 10148:     ; Here the eye is closed. So animate it this way.
                            	 10149:     ; Increment the animation counter, and if <> 8, then
                            	 10150:     ; go shoot, draw, and check collisions.
                            	 10151:     ;
02:0003DF74 41EC0478        	 10152:     lea     ($0478,A4),A0
02:0003DF78 52302000        	 10153:     addq.b  #1,(A0,D2.W)
02:0003DF7C 41EC0478        	 10154:     lea     ($0478,A4),A0
02:0003DF80 10302000        	 10155:     move.b  (A0,D2.W),D0
02:0003DF84 0C000008        	 10156:     cmpi.b  #$08,D0
02:0003DF88 66C2            	 10157:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	 10158:     ; Roll over the eye animation counter to 0.
                            	 10159:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	 10160:     ;
02:0003DF8A 7000            	 10161:     moveq   #0,D0
02:0003DF8C 41EC0478        	 10162:     lea     ($0478,A4),A0
02:0003DF90 11802000        	 10163:     move.b  D0,(A0,D2.W)
02:0003DF94 41EC046B        	 10164:     lea     ($046B,A4),A0
02:0003DF98 10302000        	 10165:     move.b  (A0,D2.W),D0
02:0003DF9C 02000001        	 10166:     andi.b #$01,D0
02:0003DFA0 0A000001        	 10167:     eori.b #$01,D0
                            	 10168:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	 10169:     ;
02:0003DFA4 609E            	 10170:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	 10171: 
