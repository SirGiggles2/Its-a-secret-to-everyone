02:00031D3A 003C0011        	  6861:     ori     #$11,CCR  ; SEC: set C+X
02:00031D3E 122C000E        	  6862:     move.b  ($000E,A4),D1
02:00031D42 0A3C0010        	  6863:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031D46 9101            	  6864:     subx.b  D1,D0   ; SBC $0E
02:00031D48 0A3C0010        	  6865:     eori    #$10,CCR  ; restore X = 6502 C
