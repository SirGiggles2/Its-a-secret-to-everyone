02:0003CD8A 1980203D        	  7780:     move.b  D0,($3D,A4,D2.W)
02:0003CD8E 7008            	  7781:     moveq   #8,D0
02:0003CD90 4EB90004D1EA    	  7782:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7783:     ; If facing left, then enable horizontal flipping.
                            	  7784:     ;
02:0003CD96 41EC0098        	  7785:     lea     ($0098,A4),A0
02:0003CD9A 10302000        	  7786:     move.b  (A0,D2.W),D0
02:0003CD9E 0C000002        	  7787:     cmpi.b  #$02,D0
02:0003CDA2 6604            	  7788:     bne  _anon_z04_94
02:0003CDA4 522C000F        	  7789:     addq.b  #1,($000F,A4)
                            	  7790: _anon_z04_94:
                            	  7791:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7792:     ; This is the base frame image.
                            	  7793:     ;
02:0003CDA8 E208            	  7794:     lsr.b  #1,D0   ; LSR A
02:0003CDAA E208            	  7795:     lsr.b  #1,D0   ; LSR A
                            	  7796:     ; If movement frame = 1, add 3 to frame image to access
                            	  7797:     ; the second animation frame's images.
                            	  7798:     ;
02:0003CDAC 7600            	  7799:     moveq   #0,D3
02:0003CDAE 41EC03E4        	  7800:     lea     ($03E4,A4),A0
02:0003CDB2 16302000        	  7801:     move.b  (A0,D2.W),D3
02:0003CDB6 671E            	  7802:     beq  _anon_z04_95
02:0003CDB8 023C00EE        	  7803:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDBC 123C0003        	  7804:     move.b  #$03,D1
02:0003CDC0 D101            	  7805:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7806:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7807:     ;
                            	  7808:     ; Down has two frame images, but up only has one. By flipping
                            	  7809:     ; horizontally, you get two frame images.
                            	  7810:     ;
02:0003CDC2 7600            	  7811:     moveq   #0,D3
02:0003CDC4 41EC0098        	  7812:     lea     ($0098,A4),A0
02:0003CDC8 16302000        	  7813:     move.b  (A0,D2.W),D3
02:0003CDCC 0C030008        	  7814:     cmpi.b  #$08,D3
02:0003CDD0 6604            	  7815:     bne  _anon_z04_95
02:0003CDD2 522C000F        	  7816:     addq.b  #1,($000F,A4)
