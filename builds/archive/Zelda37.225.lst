02:0003ECDE 41EC04F1        	 11937:     lea     ($04F1,A4),A0
02:0003ECE2 11803000        	 11938:     move.b  D0,(A0,D3.W)
02:0003ECE6 10342070        	 11939:     move.b  ($70,A4,D2.W),D0
02:0003ECEA 19803071        	 11940:     move.b  D0,($71,A4,D3.W)
02:0003ECEE 41EC0084        	 11941:     lea     ($0084,A4),A0
02:0003ECF2 10302000        	 11942:     move.b  (A0,D2.W),D0
02:0003ECF6 41EC0085        	 11943:     lea     ($0085,A4),A0
