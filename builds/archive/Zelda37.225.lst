02:00030C34 122C0004        	  4630:     move.b  ($0004,A4),D1
02:00030C38 0A3C0010        	  4631:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030C3C 9101            	  4632:     subx.b  D1,D0   ; SBC $04
02:00030C3E 0A3C0010        	  4633:     eori    #$10,CCR  ; restore X = 6502 C
02:00030C42 19400003        	  4634:     move.b  D0,($0003,A4)
02:00030C46 122C0004        	  4635:     move.b  ($0004,A4),D1
02:00030C4A B001            	  4636:     cmp.b   D1,D0
02:00030C4C 64C8            	  4637:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4638:     even
