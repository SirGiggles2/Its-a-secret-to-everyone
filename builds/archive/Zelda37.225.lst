                            	  4595: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4596:     ; TODO: call it speed index or angle?
                            	  4597:     ; If the difference in distances is within 8 pixels,
                            	  4598:     ; return the speed index (angle) we have.
                            	  4599:     ;
02:00030BFA 102C0003        	  4600:     move.b  ($0003,A4),D0
02:00030BFE 003C0011        	  4601:     ori     #$11,CCR  ; SEC: set C+X
02:00030C02 122C0004        	  4602:     move.b  ($0004,A4),D1
02:00030C06 0A3C0010        	  4603:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030C0A 9101            	  4604:     subx.b  D1,D0   ; SBC $04
02:00030C0C 0A3C0010        	  4605:     eori    #$10,CCR  ; restore X = 6502 C
02:00030C10 0C000008        	  4606:     cmpi.b  #$08,D0
02:00030C14 6538            	  4607:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4608:     even
                            	  4609: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4610:     ; TODO: call it speed index or angle?
                            	  4611:     ; Otherwise, go to the next speed index (angle).
                            	  4612:     ;
02:00030C16 1014            	  4613:     move.b  ($0000,A4),D0
02:00030C18 023C00EE        	  4614:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030C1C 122C0001        	  4615:     move.b  ($0001,A4),D1
02:00030C20 D101            	  4616:     addx.b  D1,D0   ; ADC $01
02:00030C22 1880            	  4617:     move.b  D0,($0000,A4)
                            	  4618:     ; TODO: call it speed index or angle?
                            	  4619:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4620:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4621:     ;
02:00030C24 6728            	  4622:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030C26 0C000008        	  4623:     cmpi.b  #$08,D0
02:00030C2A 6722            	  4624:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4625:     ; Subtract the lesser distance from the greater distance.
