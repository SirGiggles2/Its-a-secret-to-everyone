                            	  2270: __far_z_04_0019:
02:0003A670 61000592        	  2271:     jsr     UpdateBurrower
                            	  2272:     ; If zora died in the call above, then it happened while in
                            	  2273:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2274:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2275:     ; not come back after killing it.
                            	  2276:     ;
                            	  2277:     ; If state <> 3 or timer <> $FD,
                            	  2278:     ; then go see if the object needs to be destroyed.
                            	  2279:     ;
02:0003A674 41EC00AC        	  2280:     lea     ($00AC,A4),A0
02:0003A678 10302000        	  2281:     move.b  (A0,D2.W),D0
02:0003A67C 0C000003        	  2282:     cmpi.b  #$03,D0
02:0003A680 6616            	  2283:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003A682 10342028        	  2284:     move.b  ($28,A4,D2.W),D0
02:0003A686 0C0000FD        	  2285:     cmpi.b  #$FD,D0
02:0003A68A 660C            	  2286:     bne  _L_z04_UpdateZora_DestroyWhenDone
                            	  2287:     ; Shoot a fireball; and set the timer so that it expires faster.
                            	  2288:     ;
