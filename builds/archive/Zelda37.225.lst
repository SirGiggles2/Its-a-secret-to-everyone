02:0003F450 53302000        	 13024:     subq.b  #1,(A0,D2.W)
                            	 13025:     even
                            	 13026: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 13027:     ; Draw the four clouds at diagonal corners.
                            	 13028:     ;
02:0003F454 610000B6        	 13029:     jsr     Ganon_GetCurCloudLeft
02:0003F458 610000BE        	 13030:     jsr     Ganon_GetCurCloudTop
02:0003F45C 61A0            	 13031:     jsr     Ganon_DrawCloud
02:0003F45E 610000B2        	 13032:     jsr     Ganon_GetCurCloudRight
02:0003F462 619A            	 13033:     jsr     Ganon_DrawCloud
02:0003F464 610000A6        	 13034:     jsr     Ganon_GetCurCloudLeft
02:0003F468 610000B4        	 13035:     jsr     Ganon_GetCurCloudBottom
02:0003F46C 6190            	 13036:     jsr     Ganon_DrawCloud
02:0003F46E 610000A2        	 13037:     jsr     Ganon_GetCurCloudRight
02:0003F472 618A            	 13038:     jsr     Ganon_DrawCloud
                            	 13039:     ; Draw the top and bottom clouds.
                            	 13040:     ;
02:0003F474 10342070        	 13041:     move.b  ($70,A4,D2.W),D0
02:0003F478 1880            	 13042:     move.b  D0,($0000,A4)
02:0003F47A 6100009C        	 13043:     jsr     Ganon_GetCurCloudTop
02:0003F47E 6100FF7E        	 13044:     jsr     Ganon_DrawCloud
02:0003F482 6100009A        	 13045:     jsr     Ganon_GetCurCloudBottom
02:0003F486 6100FF76        	 13046:     jsr     Ganon_DrawCloud
                            	 13047:     ; Draw the left and right clouds.
                            	 13048:     ;
02:0003F48A 61000080        	 13049:     jsr     Ganon_GetCurCloudLeft
02:0003F48E 41EC0084        	 13050:     lea     ($0084,A4),A0
02:0003F492 10302000        	 13051:     move.b  (A0,D2.W),D0
02:0003F496 19400001        	 13052:     move.b  D0,($0001,A4)
02:0003F49A 6100FF62        	 13053:     jsr     Ganon_DrawCloud
02:0003F49E 6172            	 13054:     jsr     Ganon_GetCurCloudRight
02:0003F4A0 6100FF5C        	 13055:     jsr     Ganon_DrawCloud
                            	 13056:     ; Save the object index.
                            	 13057:     ;
02:0003F4A4 102C0340        	 13058:     move.b  ($0340,A4),D0
02:0003F4A8 1B00            	 13059:     move.b  D0,-(A5)  ; PHA
                            	 13060:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 13061:     ;
02:0003F4AA 7402            	 13062:     moveq   #2,D2
                            	 13063:     even
                            	 13064: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F4AC 19420340        	 13065:     move.b  D2,($0340,A4)
                            	 13066:     ; If object slot < 5 or = 7, then move every frame.
                            	 13067:     ; Else move 3 out of every 4 frames.
                            	 13068:     ;
                            	 13069:     ; This makes pieces spread out in somewhat of a circle,
                            	 13070:     ; by making the pieces at cardinal directions move at
                            	 13071:     ; full speed while the diagonal ones move a little slower.
                            	 13072:     ;
02:0003F4B0 0C020005        	 13073:     cmpi.b  #$05,D2
02:0003F4B4 6510            	 13074:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F4B6 0C020007        	 13075:     cmpi.b  #$07,D2
02:0003F4BA 670A            	 13076:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F4BC 102C0015        	 13077:     move.b  ($0015,A4),D0
02:0003F4C0 02000003        	 13078:     andi.b #$03,D0
02:0003F4C4 6704            	 13079:     beq  _anon_z04_164
                            	 13080:     even
                            	 13081: _L_z04_Ganon_DrawBurst_Move:
02:0003F4C6 6100DFA6        	 13082:     jsr     BlueWizzrobe_Move
                            	 13083: _anon_z04_164:
02:0003F4CA 4EB90004D1F0    	 13084:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 13085:     ; The frame counter will make the sprite flash.
                            	 13086:     ; The array has the horizontal and vertical flipping attributes.
                            	 13087:     ; Combine them into [03].
                            	 13088:     ;
02:0003F4D0 102C0015        	 13089:     move.b  ($0015,A4),D0
02:0003F4D4 02000003        	 13090:     andi.b #$03,D0
02:0003F4D8 41F90003F3A8    	 13091:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F4DE 12302000        	 13092:     move.b  (A0,D2.W),D1
02:0003F4E2 8001            	 13093:     or.b  D1,D0
02:0003F4E4 19400003        	 13094:     move.b  D0,($0003,A4)
02:0003F4E8 41F90003F3B2    	 13095:     lea     (GanonBurstTiles).l,A0
02:0003F4EE 10302000        	 13096:     move.b  (A0,D2.W),D0
02:0003F4F2 4EB9000319C2    	 13097:     jsr     Anim_WriteSprite
                            	 13098:     ; Bottom of the loop.
                            	 13099:     ; Increment object slot while <= 9.
                            	 13100:     ;
02:0003F4F8 5202            	 13101:     addq.b  #1,D2
02:0003F4FA 0C02000A        	 13102:     cmpi.b  #$0A,D2
02:0003F4FE 65AC            	 13103:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 13104:     ; Restore the object index.
                            	 13105:     ;
02:0003F500 101D            	 13106:     move.b  (A5)+,D0  ; PLA
02:0003F502 19400340        	 13107:     move.b  D0,($0340,A4)
02:0003F506 0A3C0001        	 13108:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F50A 4E75            	 13109:     rts
                            	 13110: 
                            	 13111: ; Returns:
                            	 13112: ; [00]: X coordinate
                            	 13113: ;
                            	 13114:     even
                            	 13115: Ganon_GetCurCloudLeft:
02:0003F50C 4EF90002BED2    	 13116:     jmp     c_ganon_get_cur_cloud_left
                            	 13117: 
