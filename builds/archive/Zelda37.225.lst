                            	  5864: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5865:     ; The door attribute (DA) has been mapped to a
                            	  5866:     ; provisional door face value (PF) in %A as follows:
                            	  5867:     ;
                            	  5868:     ; DA PF Meaning
                            	  5869:     ; -------------
                            	  5870:     ; 0  4  open
                            	  5871:     ; 1  1  wall
                            	  5872:     ; 2  2  false wall
                            	  5873:     ; 3  3  false wall 2
                            	  5874:     ; 4  8  bombable
                            	  5875:     ; 5  5  key
                            	  5876:     ; 6  6  key 2
                            	  5877:     ; 7  7  shutter
                            	  5878:     ;
                            	  5879:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5880:     ; has been cleared, if the type was "open" or any wall.
                            	  5881:     ;
                            	  5882:     ;
                            	  5883:     ; Save the provisional face.
02:00043860 1B00            	  5884:     move.b  D0,-(A5)  ; PHA
                            	  5885:     ; If the current direction points to a door that has been opened,
                            	  5886:     ; then see if we need to set door flags.
                            	  5887:     ;
02:00043862 102C00EE        	  5888:     move.b  ($00EE,A4),D0
02:00043866 122C0002        	  5889:     move.b  ($0002,A4),D1
02:0004386A C001            	  5890:     and.b  D1,D0
02:0004386C 7400            	  5891:     moveq   #0,D2
02:0004386E 1400            	  5892:     move.b  D0,D2
02:00043870 101D            	  5893:     move.b  (A5)+,D0  ; PLA
02:00043872 122C0002        	  5894:     move.b  ($0002,A4),D1
02:00043876 B401            	  5895:     cmp.b   D1,D2
02:00043878 6624            	  5896:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5897:     ; The current direction points to a door that has been opened.
                            	  5898:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5899:     ;
                            	  5900:     ;
                            	  5901:     ; Save provisional door face in Y register.
02:0004387A 7600            	  5902:     moveq   #0,D3
02:0004387C 1600            	  5903:     move.b  D0,D3
02:0004387E 101D            	  5904:     move.b  (A5)+,D0  ; PLA
02:00043880 1B00            	  5905:     move.b  D0,-(A5)  ; PHA
02:00043882 7400            	  5906:     moveq   #0,D2
02:00043884 1400            	  5907:     move.b  D0,D2
02:00043886 1003            	  5908:     move.b  D3,D0
                            	  5909:     ; If provisional door face is not for a shutter, then
                            	  5910:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5911:     ;
                            	  5912:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5913:     ;
02:00043888 0C000007        	  5914:     cmpi.b  #$07,D0
02:0004388C 670E            	  5915:     beq  _anon_z05_111
02:0004388E 1B00            	  5916:     move.b  D0,-(A5)  ; PHA
02:00043890 6100DD72        	  5917:     jsr     SetDoorFlag
02:00043894 101D            	  5918:     move.b  (A5)+,D0  ; PLA
                            	  5919:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5920:     ; then go make it 9 (open "bombable").
                            	  5921:     ; Else make it 4 (open "door").
                            	  5922:     ;
02:00043896 0C000008        	  5923:     cmpi.b  #$08,D0
02:0004389A 67A4            	  5924:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5925: _anon_z05_111:
02:0004389C 7004            	  5926:     moveq   #4,D0
                            	  5927:     even
                            	  5928: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5929:     ; For opened doors, the provisional door face has become:
                            	  5930:     ;
                            	  5931:     ; DA PF Meaning
                            	  5932:     ; -------------
                            	  5933:     ; 0  4  open
                            	  5934:     ; 1  1  wall
                            	  5935:     ; 2  2  false wall
                            	  5936:     ; 3  3  false wall 2
                            	  5937:     ; 4  9  bombable
                            	  5938:     ; 5  4  key
                            	  5939:     ; 6  4  key 2
                            	  5940:     ; 7  4  shutter
                            	  5941:     ;
                            	  5942:     ;
                            	  5943:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5944:     ;
02:0004389E 7400            	  5945:     moveq   #0,D2
02:000438A0 142C0006        	  5946:     move.b  ($0006,A4),D2
02:000438A4 6712            	  5947:     beq  _anon_z05_112
02:000438A6 7400            	  5948:     moveq   #0,D2
02:000438A8 142C000B        	  5949:     move.b  ($000B,A4),D2
02:000438AC 1B00            	  5950:     move.b  D0,-(A5)  ; PHA
02:000438AE 6100FCC8        	  5951:     jsr     FindDoorAttrByDoorBit
02:000438B2 61001D0C        	  5952:     jsr     CalcOpenDoorwayMask
02:000438B6 101D            	  5953:     move.b  (A5)+,D0  ; PLA
                            	  5954: _anon_z05_112:
                            	  5955:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5956:     ; because the visible door face is already a wall.
                            	  5957:     ;
02:000438B8 0C000004        	  5958:     cmpi.b  #$04,D0
02:000438BC 650000DC        	  5959:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5960:     ; For all other provisional face values, calculate:
                            	  5961:     ; door face := provisional face - 3
02:000438C0 003C0011        	  5962:     ori     #$11,CCR  ; SEC: set C+X
02:000438C4 123C0003        	  5963:     move.b  #$03,D1
02:000438C8 0A3C0010        	  5964:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000438CC 9101            	  5965:     subx.b  D1,D0   ; SBC #$03
02:000438CE 0A3C0010        	  5966:     eori    #$10,CCR  ; restore X = 6502 C
02:000438D2 7600            	  5967:     moveq   #0,D3
02:000438D4 1600            	  5968:     move.b  D0,D3
                            	  5969:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5970:     ; subtract one.
                            	  5971:     ;
02:000438D6 0C030003        	  5972:     cmpi.b  #$03,D3
02:000438DA 6502            	  5973:     bcs  _anon_z05_113
02:000438DC 5303            	  5974:     subq.b  #1,D3
                            	  5975: _anon_z05_113:
                            	  5976:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5977:     ;
                            	  5978:     ; DT DFC DFO Meaning
                            	  5979:     ; ------------------
                            	  5980:     ; 0  1   1   open
                            	  5981:     ; 4  4   5   bombable
                            	  5982:     ; 5  2   1   key
                            	  5983:     ; 6  2   1   key 2
                            	  5984:     ; 7  3   1   shutter
                            	  5985:     ;
                            	  5986:     ;
                            	  5987:     ; Get the direction index.
02:000438DE 101D            	  5988:     move.b  (A5)+,D0  ; PLA
02:000438E0 1B00            	  5989:     move.b  D0,-(A5)  ; PHA
02:000438E2 610000D0        	  5990:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5991:     ; If handling the second half, then offset to the second half
                            	  5992:     ; of the tiles.
                            	  5993:     ;
02:000438E6 102C0006        	  5994:     move.b  ($0006,A4),D0
02:000438EA 6618            	  5995:     bne  _anon_z05_114
02:000438EC 41F900043802    	  5996:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000438F2 10302000        	  5997:     move.b  (A0,D2.W),D0
02:000438F6 4EB900030F7E    	  5998:     jsr     AddToInt16At0
02:000438FC 7006            	  5999:     moveq   #6,D0
02:000438FE 4EB900030F86    	  6000:     jsr     AddToInt16At2
