                            	  7599:     ;
02:000321BE 102C0098        	  7600:     move.b  ($0098,A4),D0
02:000321C2 0200000C        	  7601:     andi.b #$0C,D0
02:000321C6 6726            	  7602:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:000321C8 10343070        	  7603:     move.b  ($70,A4,D3.W),D0
02:000321CC 023C00EE        	  7604:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321D0 123C0006        	  7605:     move.b  #$06,D1
02:000321D4 D101            	  7606:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:000321D6 19400004        	  7607:     move.b  D0,($0004,A4)
02:000321DA 41EC0084        	  7608:     lea     ($0084,A4),A0
02:000321DE 10303000        	  7609:     move.b  (A0,D3.W),D0
02:000321E2 023C00EE        	  7610:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321E6 123C0008        	  7611:     move.b  #$08,D1
02:000321EA D101            	  7612:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000321EC 6024            	  7613:     jmp     _anon_z01_98
