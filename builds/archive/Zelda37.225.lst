                            	  3143: Link_FilterInput:
                            	  3144:     ; [00] holds the opposite of Link's facing direction.
                            	  3145:     ;
02:00041ABC 102C0098        	  3146:     move.b  ($0098,A4),D0
02:00041AC0 4EB900030B28    	  3147:     jsr     GetOppositeDir
02:00041AC6 1880            	  3148:     move.b  D0,($0000,A4)
                            	  3149:     ; Call GetOppositeDir again to use this mapping:
                            	  3150:     ; In Dir: 1 2 4 8
                            	  3151:     ;         -------
                            	  3152:     ; Index:  2 3 0 1
                            	  3153:     ;
02:00041AC8 4EB900030B28    	  3154:     jsr     GetOppositeDir
                            	  3155:     ; Get the appropriate coordinate for the direction:
                            	  3156:     ; X for horizontal
                            	  3157:     ; Y for vertical
                            	  3158:     ;
02:00041ACE 102C0070        	  3159:     move.b  ($0070,A4),D0
02:00041AD2 0C030002        	  3160:     cmpi.b  #$02,D3
02:00041AD6 6404            	  3161:     bcc  _anon_z05_74
02:00041AD8 102C0084        	  3162:     move.b  ($0084,A4),D0
                            	  3163: _anon_z05_74:
02:00041ADC 19400002        	  3164:     move.b  D0,($0002,A4)
                            	  3165:     ; Mask A button and directions if inner border is crossed.
                            	  3166:     ;
02:00041AE0 1003            	  3167:     move.b  D3,D0
02:00041AE2 1B00            	  3168:     move.b  D0,-(A5)  ; PHA
02:00041AE4 023C00EE        	  3169:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041AE8 123C0008        	  3170:     move.b  #$08,D1
02:00041AEC D101            	  3171:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041AEE 7600            	  3172:     moveq   #0,D3
02:00041AF0 1600            	  3173:     move.b  D0,D3
02:00041AF2 103C0080        	  3174:     move.b  #$80,D0
02:00041AF6 6134            	  3175:     jsr     MaskInputInBorder
