02:00036254 11803000        	  4572:     move.b  D0,(A0,D3.W)
02:00036258 5303            	  4573:     subq.b  #1,D3
02:0003625A 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:0003625C 102C045F        	  4579:     move.b  ($045F,A4),D0
02:00036260 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:00036264 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:00036268 7000            	  4584:     moveq   #0,D0
02:0003626A 1880            	  4585:     move.b  D0,($0000,A4)
02:0003626C 7000            	  4586:     moveq   #0,D0
02:0003626E 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:00036272 7600            	  4590:     moveq   #0,D3
02:00036274 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:00036278 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:0003627C 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:0003627E 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
02:00036282 024100FF        	  4600:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036286 E14C            	  4601:     lsl.w   #8,D4
02:00036288 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003628A 48C4            	  4603:     ext.l   D4
02:0003628C D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036292 2044            	  4605:     movea.l D4,A0
02:00036294 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:00036298 0200003F        	  4611:     andi.b #$3F,D0
