02:0004BE5C 6706            	  4243:     beq  _anon_z07_15
02:0004BE5E 7010            	  4244:     moveq   #16,D0
02:0004BE60 163C00F0        	  4245:     move.b  #$F0,D3
                            	  4246: _anon_z07_15:
