02:0004AEC2 023C00EE        	  2114:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AEC6 122C0004        	  2115:     move.b  ($0004,A4),D1
02:0004AECA D101            	  2116:     addx.b  D1,D0   ; ADC $04
02:0004AECC 4A02            	  2117:     cmpi.b  #$00,D2
02:0004AECE 66E4            	  2118:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AED0 0C000002        	  2119:     cmpi.b  #$02,D0
02:0004AED4 66DE            	  2120:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AED6 7620            	  2121:     moveq   #32,D3
