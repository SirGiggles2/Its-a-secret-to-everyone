                            	 10248: Gohma_CheckCollisions:
                            	 10249:     ; Save the boss's X coordinate.
                            	 10250:     ;
02:0003E01C 10342070        	 10251:     move.b  ($70,A4,D2.W),D0
02:0003E020 1B00            	 10252:     move.b  D0,-(A5)  ; PHA
                            	 10253:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10254:     ; on the left side.
                            	 10255:     ;
02:0003E022 003C0011        	 10256:     ori     #$11,CCR  ; SEC: set C+X
02:0003E026 123C0010        	 10257:     move.b  #$10,D1
02:0003E02A 0A3C0010        	 10258:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E02E 9101            	 10259:     subx.b  D1,D0   ; SBC #$10
02:0003E030 0A3C0010        	 10260:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E034 19802070        	 10261:     move.b  D0,($70,A4,D2.W)
                            	 10262:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10263:     ; from left to right, indexed by [0F].
                            	 10264:     ;
02:0003E038 7005            	 10265:     moveq   #5,D0
02:0003E03A 1940000F        	 10266:     move.b  D0,($000F,A4)
                            	 10267:     even
