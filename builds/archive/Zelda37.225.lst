                            	  7916: _anon_z05_156:
02:00044C08 101D            	  7917:     move.b  (A5)+,D0  ; PLA
                            	  7918:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7919:     ; then the player walked all the way to the edge of the play
                            	  7920:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7921:     ;
                            	  7922:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7923:     ; edge of the play area. So, set a relative position that
                            	  7924:     ; reflects that distance: $28 or -$28.
                            	  7925:     ;
                            	  7926:     ; If walking in a decreasing direction (left or up), then
                            	  7927:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7928:     ;
                            	  7929:     ; If walking in an increasing direction (right or down), then
                            	  7930:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7931:     ;
02:00044C0A 02000007        	  7932:     andi.b #$07,D0
02:00044C0E 0C000002        	  7933:     cmpi.b  #$02,D0
02:00044C12 6506            	  7934:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:00044C14 0C000005        	  7935:     cmpi.b  #$05,D0
02:00044C18 6502            	  7936:     bcs  _anon_z05_157
                            	  7937:     even
