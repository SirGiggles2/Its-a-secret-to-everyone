02:0003A058 0C00002B        	  1374:     cmpi.b  #$2B,D0
02:0003A05C 6608            	  1375:     bne  _L_z04_UpdateBubble_BlockOrUnblock
                            	  1376:     ; Else the flashing bubble blocks the sword temporarily.
                            	  1377:     ; Set a long timer to $10 ($A0 frames) for this purpose.
                            	  1378:     ;
