                            	  7553: ChangePlayMapSquareOW:
02:00044692 1002            	  7554:     move.b  D2,D0
02:00044694 1B00            	  7555:     move.b  D0,-(A5)  ; PHA
                            	  7556:     ; We're dealing with squares.
                            	  7557:     ; So, align the object's X coordinate with 16 pixels.
                            	  7558:     ;
02:00044696 10342070        	  7559:     move.b  ($70,A4,D2.W),D0
02:0004469A 020000F0        	  7560:     andi.b #$F0,D0
                            	  7561:     ; Divide it by 4 to get the offset of the address of the column
                            	  7562:     ; in play area map.
                            	  7563:     ;
                            	  7564:     ; The calculation is: address offset = (X / 8) * 2
                            	  7565:     ; 8 for the width of the column; 2 for the width of the address
                            	  7566:     ;
02:0004469E E208            	  7567:     lsr.b  #1,D0   ; LSR A
02:000446A0 E208            	  7568:     lsr.b  #1,D0   ; LSR A
02:000446A2 7400            	  7569:     moveq   #0,D2
02:000446A4 1400            	  7570:     move.b  D0,D2
