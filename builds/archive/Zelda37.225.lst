02:0003AE78 B001            	  3423:     cmp.b   D1,D0
02:0003AE7A 6400FF78        	  3424:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AE7E 522C0510        	  3425:     addq.b  #1,($0510,A4)
                            	  3426:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3427:     ; and pick up whatever the new value is for state 1.
                            	  3428:     ;
