02:0003A68E 6100F6B6        	  2290:     jsr     ShootFireball
02:0003A692 7020            	  2291:     moveq   #32,D0
02:0003A694 19802028        	  2292:     move.b  D0,($28,A4,D2.W)
                            	  2293:     even
