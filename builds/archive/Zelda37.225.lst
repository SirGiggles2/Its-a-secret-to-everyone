                            	   276: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   277:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   278:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   279:     ;
02:0002DE1C 41F900FF6A7E    	   280:     lea     (NES_SRAM+$0A7E).l,A0
02:0002DE22 10303000        	   281:     move.b  (A0,D3.W),D0
02:0002DE26 41EC0422        	   282:     lea     ($0422,A4),A0
02:0002DE2A 11802000        	   283:     move.b  D0,(A0,D2.W)
                            	   284:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   285:     ;
02:0002DE2E 020000C0        	   286:     andi.b #$C0,D0
02:0002DE32 19802000        	   287:     move.b  D0,($00,A4,D2.W)
                            	   288:     ; Copy 3 prices from the Cave level block info.
                            	   289:     ;
02:0002DE36 41F900FF6ABA    	   290:     lea     (NES_SRAM+$0ABA).l,A0
02:0002DE3C 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002DE40 41EC0430        	   292:     lea     ($0430,A4),A0
02:0002DE44 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Bottom of the wares copying loop.
                            	   295:     ;
02:0002DE48 5203            	   296:     addq.b  #1,D3
02:0002DE4A 5202            	   297:     addq.b  #1,D2
02:0002DE4C 0C020003        	   298:     cmpi.b  #$03,D2
02:0002DE50 66CA            	   299:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   300:     ; Get the top 2 bits of text selector byte in [03],
                            	   301:     ; shift them to the bottom, and combine them with [00].
                            	   302:     ;
02:0002DE52 102C0003        	   303:     move.b  ($0003,A4),D0
02:0002DE56 E308            	   304:     lsl.b  #1,D0   ; ASL A
02:0002DE58 E310            	   305:     roxl.b  #1,D0   ; ROL A
02:0002DE5A E310            	   306:     roxl.b  #1,D0   ; ROL A
02:0002DE5C 1214            	   307:     move.b  ($0000,A4),D1
02:0002DE5E 8001            	   308:     or.b  D1,D0
02:0002DE60 1880            	   309:     move.b  D0,($0000,A4)
                            	   310:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   311:     ; and combine them with [00].
                            	   312:     ;
02:0002DE62 102C0002        	   313:     move.b  ($0002,A4),D0
02:0002DE66 E208            	   314:     lsr.b  #1,D0   ; LSR A
02:0002DE68 E208            	   315:     lsr.b  #1,D0   ; LSR A
02:0002DE6A E208            	   316:     lsr.b  #1,D0   ; LSR A
02:0002DE6C E208            	   317:     lsr.b  #1,D0   ; LSR A
02:0002DE6E 1214            	   318:     move.b  ($0000,A4),D1
02:0002DE70 8001            	   319:     or.b  D1,D0
02:0002DE72 1880            	   320:     move.b  D0,($0000,A4)
                            	   321:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   322:     ; and combine them with [00] into CaveFlags.
                            	   323:     ;
02:0002DE74 102C0001        	   324:     move.b  ($0001,A4),D0
02:0002DE78 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002DE7A E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002DE7C 1214            	   327:     move.b  ($0000,A4),D1
02:0002DE7E 8001            	   328:     or.b  D1,D0
02:0002DE80 19400413        	   329:     move.b  D0,($0413,A4)
                            	   330:     ; The end result is a byte with 8 cave flags.
                            	   331:     ;
                            	   332:     ; If cave flag "money game" is missing, then go finish up,
                            	   333:     ; instead of choosing random amounts for the money game.
                            	   334:     ;
02:0002DE84 02000020        	   335:     andi.b #$20,D0
02:0002DE88 6700009E        	   336:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   337:     ; Determine an index randomly with increasing probability,
                            	   338:     ; from 6 to 1. Start with the following test:
                            	   339:     ;
                            	   340:     ;   If $FF < Random, then go use index 6.
                            	   341:     ;
02:0002DE8C 103C00FF        	   342:     move.b  #$FF,D0
02:0002DE90 7606            	   343:     moveq   #6,D3
                            	   344:     even
                            	   345: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002DE92 122C0019        	   346:     move.b  ($0019,A4),D1
02:0002DE96 B001            	   347:     cmp.b   D1,D0
02:0002DE98 6516            	   348:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   349:     ; If the test fails, then subtract $2B from the reference number.
                            	   350:     ;
02:0002DE9A 003C0011        	   351:     ori     #$11,CCR  ; SEC: set C+X
02:0002DE9E 123C002B        	   352:     move.b  #$2B,D1
02:0002DEA2 0A3C0010        	   353:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DEA6 9101            	   354:     subx.b  D1,D0   ; SBC #$2B
02:0002DEA8 0A3C0010        	   355:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DEAC 5303            	   356:     subq.b  #1,D3
02:0002DEAE 66E2            	   357:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   358:     even
                            	   359: _L_z01_InitCaveContinue_FoundPermutation:
                            	   360:     ; The index chooses the last offset of a permutation of three indexes.
