                            	  5915: Moldorm_Chase:
                            	  5916:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5917:     ; Only the head controls the movement direction.
                            	  5918:     ;
02:0003C09C 0C020005        	  5919:     cmpi.b  #$05,D2
02:0003C0A0 670A            	  5920:     beq  _anon_z04_81
02:0003C0A2 0C02000A        	  5921:     cmpi.b  #$0A,D2
