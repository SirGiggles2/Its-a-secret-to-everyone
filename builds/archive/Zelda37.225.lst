                            	   559: UpdateMenuStartOW:
                            	   560:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   561:     ; make it look completely empty, and no piece has been won.
                            	   562:     ;
02:00040360 7617            	   563:     moveq   #23,D3
                            	   564: _anon_z05_6:
02:00040362 7400            	   565:     moveq   #0,D2
02:00040364 41F900040318    	   566:     lea     (TriforceTransferBufOffsets).l,A0
02:0004036A 14303000        	   567:     move.b  (A0,D3.W),D2
02:0004036E 41F900040348    	   568:     lea     (TriforceTransferBufTiles).l,A0
02:00040374 10303000        	   569:     move.b  (A0,D3.W),D0
02:00040378 41F9000476E2    	   570:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0004037E 11802000        	   571:     move.b  D0,(A0,D2.W)
02:00040382 5303            	   572:     subq.b  #1,D3
02:00040384 6ADC            	   573:     bpl  _anon_z05_6
                            	   574:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   575:     ;
02:00040386 5203            	   576:     addq.b  #1,D3
                            	   577:     ; Outer loop.
                            	   578:     ; A level test bit in [06] will be used to see whether
                            	   579:     ; we have a triforce piece.
                            	   580:     ;
02:00040388 7001            	   581:     moveq   #1,D0
02:0004038A 19400006        	   582:     move.b  D0,($0006,A4)
                            	   583:     even
                            	   584: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   585:     ; Inner loop.
                            	   586:     ; Each level bit will make 3 triforce tile slots be
                            	   587:     ; checked and replaced.
                            	   588:     ;
02:0004038E 7003            	   589:     moveq   #3,D0
02:00040390 19400007        	   590:     move.b  D0,($0007,A4)
                            	   591:     even
                            	   592: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   593:     ; Get the offset into the submenu triforce transfer buffers of
                            	   594:     ; the current tile slot.
                            	   595:     ;
02:00040394 7400            	   596:     moveq   #0,D2
02:00040396 41F900040318    	   597:     lea     (TriforceTransferBufOffsets).l,A0
02:0004039C 14303000        	   598:     move.b  (A0,D3.W),D2
                            	   599:     ; If the level test bit is not in the triforce mask, then we don't
                            	   600:     ; have this piece. So, go loop again, and leave the tile in the
                            	   601:     ; empty state.
                            	   602:     ;
                            	   603:     ;
                            	   604:     ; [06] level test mask
02:000403A0 102C0006        	   605:     move.b  ($0006,A4),D0
02:000403A4 122C0671        	   606:     move.b  ($0671,A4),D1
02:000403A8 C200            	   607:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000403AA 6730            	   608:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   609:     ; We have the triforce piece.
                            	   610:     ;
                            	   611:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   612:     ; then make it $F5. These are tiles that were half full, and now
                            	   613:     ; need to be full.
                            	   614:     ;
                            	   615:     ; Else replace it with the one at the current triforce tile slot
                            	   616:     ; in the replacement list.
                            	   617:     ;
02:000403AC 41F9000476E2    	   618:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403B2 10302000        	   619:     move.b  (A0,D2.W),D0
02:000403B6 0C0000E5        	   620:     cmpi.b  #$E5,D0
02:000403BA 6712            	   621:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000403BC 0C0000E6        	   622:     cmpi.b  #$E6,D0
02:000403C0 670C            	   623:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000403C2 41F900040330    	   624:     lea     (TriforceTriforceBufReplacements).l,A0
02:000403C8 10303000        	   625:     move.b  (A0,D3.W),D0
02:000403CC 6004            	   626:     jmp     _anon_z05_7
                            	   627: 
                            	   628:     even
                            	   629: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:000403CE 103C00F5        	   630:     move.b  #$F5,D0
                            	   631: _anon_z05_7:
02:000403D2 41F9000476E2    	   632:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403D8 11802000        	   633:     move.b  D0,(A0,D2.W)
                            	   634:     even
                            	   635: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   636:     ; Bottom of the inner loop.
                            	   637:     ;
                            	   638:     ; Increment the triforce tile slot.
                            	   639:     ; Decrement [07] and loop again, if it's not 0.
                            	   640:     ;
02:000403DC 5203            	   641:     addq.b  #1,D3
02:000403DE 532C0007        	   642:     subq.b  #1,($0007,A4)
02:000403E2 66B0            	   643:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   644:     ; Bottom of the outer loop.
                            	   645:     ;
                            	   646:     ; Shift the level test bit [06] left to test the next level.
                            	   647:     ; When it becomes 0, we're done.
                            	   648:     ;
02:000403E4 122C0006        	   649:     move.b  ($0006,A4),D1
02:000403E8 E309            	   650:     lsl.b  #1,D1   ; ASL $06
02:000403EA 19410006        	   651:     move.b  D1,($0006,A4)
02:000403EE 669E            	   652:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:000403F0 522C00E1        	   653:     addq.b  #1,($00E1,A4)
02:000403F4 4E75            	   654:     rts
                            	   655: 
                            	   656:     even
                            	   657: ScrollWorld:
02:000403F6 102C0015        	   658:     move.b  ($0015,A4),D0
                            	   659:     ; The purpose of this is to delay vertical scrolling.
                            	   660:     ; OW: once every two frames
                            	   661:     ; UW: once every four frames
                            	   662:     ; Horizontal scrolling happens every frame.
02:000403FA 02000003        	   663:     andi.b #$03,D0
02:000403FE 7600            	   664:     moveq   #0,D3
02:00040400 162C0010        	   665:     move.b  ($0010,A4),D3
02:00040404 6604            	   666:     bne  _anon_z05_8
02:00040406 02000001        	   667:     andi.b #$01,D0
                            	   668: _anon_z05_8:
02:0004040A 122C00E6        	   669:     move.b  ($00E6,A4),D1
02:0004040E B001            	   670:     cmp.b   D1,D0
02:00040410 6704            	   671:     beq.s  __far_z_05_0007
02:00040412 600000DE        	   672:     jmp  ScrollWorldH
                            	   673: __far_z_05_0007:
02:00040416 7008            	   674:     moveq   #8,D0
02:00040418 122C0098        	   675:     move.b  ($0098,A4),D1
02:0004041C C200            	   676:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004041E 6602            	   677:     bne.s  __far_z_05_0008
02:00040420 606E            	   678:     jmp  ScrollWorldDownOrH
                            	   679: __far_z_05_0008:
                            	   680:     ; then scroll up.
                            	   681:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   682:     ;
02:00040422 532C00E9        	   683:     subq.b  #1,($00E9,A4)
02:00040426 102C0084        	   684:     move.b  ($0084,A4),D0
02:0004042A 0C0000DD        	   685:     cmpi.b  #$DD,D0
02:0004042E 640A            	   686:     bcc  _anon_z05_9
02:00040430 123C0008        	   687:     move.b  #$08,D1
02:00040434 D101            	   688:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00040436 19400084        	   689:     move.b  D0,($0084,A4)
                            	   690: _anon_z05_9:
02:0004043A 102C00E2        	   691:     move.b  ($00E2,A4),D0
02:0004043E 003C0011        	   692:     ori     #$11,CCR  ; SEC: set C+X
02:00040442 123C0020        	   693:     move.b  #$20,D1
02:00040446 0A3C0010        	   694:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004044A 9101            	   695:     subx.b  D1,D0   ; SBC #$20
02:0004044C 0A3C0010        	   696:     eori    #$10,CCR  ; restore X = 6502 C
02:00040450 194000E2        	   697:     move.b  D0,($00E2,A4)
