                            	  9707: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9708:     ; At this point, we have a hand that just died.
                            	  9709:     ;
                            	  9710:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9711:     ;
02:0003DC34 7603            	  9712:     moveq   #3,D3
                            	  9713:     ; Count how many are allocated.
                            	  9714:     ; This includes the current dead one, and the other living ones.
                            	  9715:     ; Store the count in [00].
                            	  9716:     ;
02:0003DC36 7000            	  9717:     moveq   #0,D0
02:0003DC38 1880            	  9718:     move.b  D0,($0000,A4)
                            	  9719:     even
                            	  9720: _L_z04_Manhandla_CheckCollisions_LoopHand:
02:0003DC3A 41EC0350        	  9721:     lea     ($0350,A4),A0
