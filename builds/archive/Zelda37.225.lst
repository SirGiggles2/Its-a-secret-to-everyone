                            	 11145: 
                            	 11146: _anon_z04_141:
02:0003E6BE 4EB900031A42    	 11147:     jsr     CheckMonsterCollisions
                            	 11148:     ; If this segment was harmed, then set the writhing counter,
                            	 11149:     ; and the animation counter to its lower value.
                            	 11150:     ;
02:0003E6C4 41EC00C0        	 11151:     lea     ($00C0,A4),A0
02:0003E6C8 10302000        	 11152:     move.b  (A0,D2.W),D0
02:0003E6CC 670A            	 11153:     beq  _anon_z04_142
02:0003E6CE 7006            	 11154:     moveq   #6,D0
02:0003E6D0 194004E6        	 11155:     move.b  D0,($04E6,A4)
02:0003E6D4 19400510        	 11156:     move.b  D0,($0510,A4)
                            	 11157: _anon_z04_142:
02:0003E6D8 4EB90004BB74    	 11158:     jsr     ResetShoveInfo
                            	 11159:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11160:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11161:     ;
02:0003E6DE 0C020001        	 11162:     cmpi.b  #$01,D2
02:0003E6E2 670000DE        	 11163:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E6E6 6100B0AA        	 11164:     jsr     PlayBossHitCryIfNeeded
                            	 11165:     ; If this neck has not died, then go loop again.
                            	 11166:     ;
02:0003E6EA 41EC0405        	 11167:     lea     ($0405,A4),A0
02:0003E6EE 10302000        	 11168:     move.b  (A0,D2.W),D0
02:0003E6F2 670000D4        	 11169:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11170:     ; This neck died. So, prepare to make a flying head.
                            	 11171:     ;
02:0003E6F6 7060            	 11172:     moveq   #96,D0
02:0003E6F8 41EC0485        	 11173:     lea     ($0485,A4),A0
02:0003E6FC 11802000        	 11174:     move.b  D0,(A0,D2.W)
02:0003E700 1002            	 11175:     move.b  D2,D0
02:0003E702 1B00            	 11176:     move.b  D0,-(A5)  ; PHA
                            	 11177:     ; If the segment is not a head, then skip making a flying head.
                            	 11178:     ;
                            	 11179:     ; TODO:
                            	 11180:     ; But how can we get here in this case, since earlier branches
                            	 11181:     ; would have been taken to skip all this for all other segments?
                            	 11182:     ;
02:0003E704 0C020005        	 11183:     cmpi.b  #$05,D2
02:0003E708 663C            	 11184:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11185:     ; The flying head will go in slot (neck index + 7).
                            	 11186:     ; Switch the X register to it.
                            	 11187:     ;
02:0003E70A 102C04D7        	 11188:     move.b  ($04D7,A4),D0
02:0003E70E 023C00EE        	 11189:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E712 123C0007        	 11190:     move.b  #$07,D1
02:0003E716 D101            	 11191:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E718 7400            	 11192:     moveq   #0,D2
02:0003E71A 1400            	 11193:     move.b  D0,D2
                            	 11194:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11195:     ;
02:0003E71C 103C00FF        	 11196:     move.b  #$FF,D0
02:0003E720 41EC0492        	 11197:     lea     ($0492,A4),A0
02:0003E724 11802000        	 11198:     move.b  D0,(A0,D2.W)
                            	 11199:     ; Copy the original head's coordinates to it.
                            	 11200:     ;
02:0003E728 102C0075        	 11201:     move.b  ($0075,A4),D0
02:0003E72C 19802070        	 11202:     move.b  D0,($70,A4,D2.W)
02:0003E730 102C0089        	 11203:     move.b  ($0089,A4),D0
02:0003E734 41EC0084        	 11204:     lea     ($0084,A4),A0
02:0003E738 11802000        	 11205:     move.b  D0,(A0,D2.W)
                            	 11206:     ; Set object type $46 (flying head).
                            	 11207:     ;
02:0003E73C 7046            	 11208:     moveq   #70,D0
02:0003E73E 41EC034F        	 11209:     lea     ($034F,A4),A0
02:0003E742 11802000        	 11210:     move.b  D0,(A0,D2.W)
