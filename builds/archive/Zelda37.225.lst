02:0004C97C 11803000        	  5949:     move.b  D0,(A0,D3.W)
02:0004C980 0A3C0001        	  5950:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C984 4E75            	  5951:     rts
                            	  5952: 
