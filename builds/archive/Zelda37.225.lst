                            	  7560:     even
                            	  7561: Dodongo_Draw:
02:0003CC0A 610000F4        	  7562:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7563:     ; Make a 5-way direction index out of the facing direction
                            	  7564:     ; by shifting right once, and store it in [00].
                            	  7565:     ;
02:0003CC0E 41EC0098        	  7566:     lea     ($0098,A4),A0
02:0003CC12 10302000        	  7567:     move.b  (A0,D2.W),D0
02:0003CC16 E208            	  7568:     lsr.b  #1,D0   ; LSR A
02:0003CC18 1880            	  7569:     move.b  D0,($0000,A4)
                            	  7570:     ; If state = 0, go handle animating the two frames of this state.
                            	  7571:     ;
02:0003CC1A 7600            	  7572:     moveq   #0,D3
02:0003CC1C 41EC00AC        	  7573:     lea     ($00AC,A4),A0
02:0003CC20 16302000        	  7574:     move.b  (A0,D2.W),D3
02:0003CC24 6744            	  7575:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7576:     ; If state > 1, then the monster is stunned (state 2).
                            	  7577:     ; So, go switch frames every $20 screen frames.
                            	  7578:     ;
02:0003CC26 7020            	  7579:     moveq   #32,D0
02:0003CC28 5303            	  7580:     subq.b  #1,D3
02:0003CC2A 6640            	  7581:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7582:     ; State = 1. Bloated.
                            	  7583:     ;
                            	  7584:     ; In substate 0, go animate as usual for walking.
                            	  7585:     ;
02:0003CC2C 7600            	  7586:     moveq   #0,D3
02:0003CC2E 41EC042C        	  7587:     lea     ($042C,A4),A0
02:0003CC32 16302000        	  7588:     move.b  (A0,D2.W),D3
02:0003CC36 6732            	  7589:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7590:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7591:     ; go fade the boss; so that some frames are not drawn.
                            	  7592:     ;
02:0003CC38 0C030002        	  7593:     cmpi.b  #$02,D3
02:0003CC3C 6718            	  7594:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC3E 0C030003        	  7595:     cmpi.b  #$03,D3
02:0003CC42 6712            	  7596:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7597:     ; State 1, substate 1
                            	  7598:     ;
                            	  7599:     ; Add $14 to the frame image index to index into the bloated
                            	  7600:     ; frame images and H-flips.
                            	  7601:     ;
02:0003CC44 1014            	  7602:     move.b  ($0000,A4),D0
02:0003CC46 023C00EE        	  7603:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC4A 123C0014        	  7604:     move.b  #$14,D1
02:0003CC4E D101            	  7605:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC50 7600            	  7606:     moveq   #0,D3
02:0003CC52 1600            	  7607:     move.b  D0,D3
02:0003CC54 6032            	  7608:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7609: 
                            	  7610:     even
                            	  7611: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7612:     ; In bloated substates 2 and 3:
                            	  7613:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7614:     ;
02:0003CC56 102C0015        	  7615:     move.b  ($0015,A4),D0
02:0003CC5A 02000002        	  7616:     andi.b #$02,D0
02:0003CC5E 6604            	  7617:     bne.s  __far_z_04_0071
02:0003CC60 600000A6        	  7618:     jmp  L11B00_Exit
                            	  7619: __far_z_04_0071:
02:0003CC64 7600            	  7620:     moveq   #0,D3
02:0003CC66 1614            	  7621:     move.b  ($0000,A4),D3
02:0003CC68 601E            	  7622:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7623: 
                            	  7624:     even
                            	  7625: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7626:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7627:     ;
02:0003CC6A 7008            	  7628:     moveq   #8,D0
                            	  7629:     even
                            	  7630: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CC6C 7600            	  7631:     moveq   #0,D3
02:0003CC6E 1614            	  7632:     move.b  ($0000,A4),D3
02:0003CC70 122C0015        	  7633:     move.b  ($0015,A4),D1
02:0003CC74 C001            	  7634:     and.b  D1,D0
02:0003CC76 6710            	  7635:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7636:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7637:     ; in order to index into the second set of frame image numbers.
                            	  7638:     ;
02:0003CC78 1003            	  7639:     move.b  D3,D0
02:0003CC7A 023C00EE        	  7640:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC7E 123C0005        	  7641:     move.b  #$05,D1
02:0003CC82 D101            	  7642:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CC84 7600            	  7643:     moveq   #0,D3
02:0003CC86 1600            	  7644:     move.b  D0,D3
                            	  7645:     even
                            	  7646: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7647:     ; Start preparing sprites.
                            	  7648:     ;
02:0003CC88 4EB90004D1F0    	  7649:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CC8E 1003            	  7650:     move.b  D3,D0
02:0003CC90 1B00            	  7651:     move.b  D0,-(A5)  ; PHA
                            	  7652:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7653:     ;
02:0003CC92 41F90003CBEC    	  7654:     lea     (DodongoFrameHFlips).l,A0
02:0003CC98 10303000        	  7655:     move.b  (A0,D3.W),D0
02:0003CC9C 1940000F        	  7656:     move.b  D0,($000F,A4)
02:0003CCA0 41F90003CBE2    	  7657:     lea     (DodongoFrameImages).l,A0
02:0003CCA6 10303000        	  7658:     move.b  (A0,D3.W),D0
                            	  7659:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7660:     ; They are drawn mirrored.
                            	  7661:     ;
02:0003CCAA 0C000007        	  7662:     cmpi.b  #$07,D0
02:0003CCAE 6706            	  7663:     beq  _anon_z04_92
02:0003CCB0 0C000009        	  7664:     cmpi.b  #$09,D0
02:0003CCB4 6608            	  7665:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7666: _anon_z04_92:
02:0003CCB6 4EB9000316C2    	  7667:     jsr     DrawObjectMirrored
02:0003CCBC 6006            	  7668:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7669: 
                            	  7670:     even
                            	  7671: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7672:     ; No other frame images are mirrored.
                            	  7673:     ;
02:0003CCBE 4EB9000316C6    	  7674:     jsr     DrawObjectNotMirrored
                            	  7675:     even
                            	  7676: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CCC4 101D            	  7677:     move.b  (A5)+,D0  ; PLA
02:0003CCC6 7600            	  7678:     moveq   #0,D3
02:0003CCC8 1600            	  7679:     move.b  D0,D3
                            	  7680:     ; If facing vertically, then return. There's no other side to draw.
                            	  7681:     ;
02:0003CCCA 41EC0098        	  7682:     lea     ($0098,A4),A0
02:0003CCCE 10302000        	  7683:     move.b  (A0,D2.W),D0
02:0003CCD2 02000003        	  7684:     andi.b #$03,D0
02:0003CCD6 6602            	  7685:     bne.s  __far_z_04_0072
02:0003CCD8 602E            	  7686:     jmp  L11B00_Exit
                            	  7687: __far_z_04_0072:
                            	  7688:     ; Else draw the right side.
                            	  7689:     ;
                            	  7690:     ; Keep the Y coordinate in [01].
                            	  7691:     ; But, store (X + $10) in [00].
                            	  7692:     ;
02:0003CCDA 10342070        	  7693:     move.b  ($70,A4,D2.W),D0
02:0003CCDE 023C00EE        	  7694:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCE2 123C0010        	  7695:     move.b  #$10,D1
02:0003CCE6 D101            	  7696:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CCE8 1880            	  7697:     move.b  D0,($0000,A4)
02:0003CCEA 6114            	  7698:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7699:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7700:     ;
                            	  7701:     ; So, if we had animation frame 1, direction left:
                            	  7702:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7703:     ; - frame image index = 6 (1 + 5)
                            	  7704:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7705:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7706:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7707:     ;
                            	  7708:     ; So, 3 would have been the frame number used above for
                            	  7709:     ; the left side.
                            	  7710:     ;
                            	  7711:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7712:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7713:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7714:     ; on the right.
                            	  7715:     ;
02:0003CCEC 41F90003CBE2    	  7716:     lea     (DodongoFrameImages).l,A0
02:0003CCF2 10303000        	  7717:     move.b  (A0,D3.W),D0
02:0003CCF6 0A000001        	  7718:     eori.b #$01,D0
02:0003CCFA 4EF9000316C6    	  7719:     jmp     DrawObjectNotMirrored
                            	  7720: 
                            	  7721: ; Returns:
                            	  7722: ; A: 3
                            	  7723: ; [04]: left sprite attributes
                            	  7724: ; [05]: right sprite attributes
                            	  7725: ;
                            	  7726:     even
                            	  7727: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD00 7003            	  7728:     moveq   #3,D0
02:0003CD02 4EB9000319B8    	  7729:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7730:     even
                            	  7731: L11B00_Exit:
