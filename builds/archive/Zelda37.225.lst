                            	  1721: _L_z01_UpdateUnderworldPersonLifeOrMoneyState_2_PayWithHeartContainer:
                            	  1722:     ; The player chose the heart container.
                            	  1723:     ;
                            	  1724:     ; If the number of heart containers < 4, then
                            	  1725:     ; - leave the number of heart containers alone
                            	  1726:     ; - set HeartPartial to 0, so Link will die with one more hit
                            	  1727:     ;
                            	  1728:     ; Then go flag this offer taken.
                            	  1729:     ;
02:0002E81E 102C066F        	  1730:     move.b  ($066F,A4),D0
02:0002E822 020000F0        	  1731:     andi.b #$F0,D0
02:0002E826 0C000030        	  1732:     cmpi.b  #$30,D0
