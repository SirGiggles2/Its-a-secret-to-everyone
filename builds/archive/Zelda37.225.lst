                            	  7555: L763A_Exit:
02:000321AC 4E75            	  7556:     rts
                            	  7557: 
                            	  7558: ; Params:
                            	  7559: ; A: damage points
                            	  7560: ; X: monster object slot
                            	  7561: ; [00]: weapon object slot
                            	  7562: ; [02]: monster object mid X
                            	  7563: ; [03]: monster object mid Y
                            	  7564: ; [09]: damage type
                            	  7565: ; [0D]: horizontal threshold
                            	  7566: ;
                            	  7567: ; Returns:
                            	  7568: ; [06]: 1 if objects collide
                            	  7569: ; [07]: damage points
                            	  7570: ; [0E]: vertical threshold
                            	  7571: ;
                            	  7572:     even
                            	  7573: CheckMonsterSlenderWeaponCollision:
02:000321AE 19400007        	  7574:     move.b  D0,($0007,A4)
02:000321B2 102C000D        	  7575:     move.b  ($000D,A4),D0
02:000321B6 1940000E        	  7576:     move.b  D0,($000E,A4)
                            	  7577: ; Params:
                            	  7578: ; X: monster object slot
                            	  7579: ; [00]: weapon object slot
                            	  7580: ; [02]: monster object mid X
                            	  7581: ; [03]: monster object mid Y
                            	  7582: ; [07]: damage points
                            	  7583: ; [09]: damage type
                            	  7584: ; [0D]: horizontal threshold
                            	  7585: ; [0E]: vertical threshold
                            	  7586: ;
                            	  7587: ; Returns:
