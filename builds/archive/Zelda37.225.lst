                            	  3359:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3360:     ; it's too close to the top edge of the screen. So, return.
                            	  3361:     ;
02:0003AE02 0C00005D        	  3362:     cmpi.b  #$5D,D0
02:0003AE06 65EC            	  3363:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3364:     ; If facing right, then use X offset $28.
                            	  3365:     ; Else store X offset -$28 in [00].
                            	  3366:     ;
02:0003AE08 7628            	  3367:     moveq   #40,D3
02:0003AE0A 41EC0098        	  3368:     lea     ($0098,A4),A0
02:0003AE0E 10302000        	  3369:     move.b  (A0,D2.W),D0
02:0003AE12 02000002        	  3370:     andi.b #$02,D0
02:0003AE16 6704            	  3371:     beq  _anon_z04_45
02:0003AE18 163C00D8        	  3372:     move.b  #$D8,D3
                            	  3373: _anon_z04_45:
02:0003AE1C 1883            	  3374:     move.b  D3,($0000,A4)
                            	  3375:     ; [01] holds Link's X coordinate.
                            	  3376:     ;
02:0003AE1E 102C0070        	  3377:     move.b  ($0070,A4),D0
