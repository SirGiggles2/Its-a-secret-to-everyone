02:0003EF18 41EC0084        	 12265:     lea     ($0084,A4),A0
02:0003EF1C 10302000        	 12266:     move.b  (A0,D2.W),D0
02:0003EF20 122C04E6        	 12267:     move.b  ($04E6,A4),D1
02:0003EF24 D101            	 12268:     addx.b  D1,D0   ; ADC Lamnola_Speed
