02:0004C5CE 023C00EE        	  5386:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C5D2 123C0001        	  5387:     move.b  #$01,D1
02:0004C5D6 D101            	  5388:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C5D8 19803000        	  5389:     move.b  D0,($00,A4,D3.W)
                            	  5390:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5391:     ;
02:0004C5DC 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C5DE 7600            	  5393:     moveq   #0,D3
02:0004C5E0 1600            	  5394:     move.b  D0,D3
02:0004C5E2 5303            	  5395:     subq.b  #1,D3
