02:00030E38 662E            	  4959:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4960:     ; The effect involves turning grayscale rendering on and off
                            	  4961:     ; in PPUMASK.
                            	  4962:     ;
                            	  4963:     ; Start by setting A register to the PPU mask shifted right to
                            	  4964:     ; throw away the grayscale bit.
                            	  4965:     ;
02:00030E3A 102C00FE        	  4966:     move.b  ($00FE,A4),D0
02:00030E3E E208            	  4967:     lsr.b  #1,D0   ; LSR A
                            	  4968:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  4969:     ;
02:00030E40 7600            	  4970:     moveq   #0,D3
02:00030E42 16342028        	  4971:     move.b  ($28,A4,D2.W),D3
                            	  4972:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4973:     ; Carry will have been set, because of the comparison (CPY).
                            	  4974:     ;
02:00030E46 0C030016        	  4975:     cmpi.b  #$16,D3
02:00030E4A 6706            	  4976:     beq  _anon_z01_54
02:00030E4C 0C030011        	  4977:     cmpi.b  #$11,D3
02:00030E50 6604            	  4978:     bne  _L_z01_UpdateBombFlashEffect_Clear
