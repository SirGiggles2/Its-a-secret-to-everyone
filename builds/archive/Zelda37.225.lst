02:00031D26 19400050        	  6851:     move.b  D0,($0050,A4)
02:00031D2A 19400051        	  6852:     move.b  D0,($0051,A4)
                            	  6853:     ; If heart partial >= low damage points byte, then simply
                            	  6854:     ; subtract the damage byte from heart partial.
                            	  6855:     ; Else go borrow from full hearts.
