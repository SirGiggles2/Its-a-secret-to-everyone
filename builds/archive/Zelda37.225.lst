02:0003AD9A 0C0000C0        	  3303:     cmpi.b  #$C0,D0
02:0003AD9E 6506            	  3304:     bcs  _anon_z04_43
02:0003ADA0 4EB90004C0D0    	  3305:     jsr     ReverseObjDir
                            	  3306: _anon_z04_43:
                            	  3307:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3308:     ;
02:0003ADA6 41EC0098        	  3309:     lea     ($0098,A4),A0
02:0003ADAA 10302000        	  3310:     move.b  (A0,D2.W),D0
02:0003ADAE 0200000C        	  3311:     andi.b #$0C,D0
02:0003ADB2 6742            	  3312:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3313:     ; Begin with the leever's X set to Link's X.
                            	  3314:     ;
