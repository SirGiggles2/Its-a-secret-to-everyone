                            	  6040: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  6041:     ; Copy old direction from a higher slot to the lower one;
                            	  6042:     ; and to the lower one's facing direction.
                            	  6043:     ;
02:0003C120 41EC0382        	  6044:     lea     ($0382,A4),A0
