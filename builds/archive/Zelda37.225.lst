                            	  6018:     ;
02:0003C0F6 41EC03BC        	  6019:     lea     ($03BC,A4),A0
02:0003C0FA 10302000        	  6020:     move.b  (A0,D2.W),D0
02:0003C0FE 6712            	  6021:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C100 41EC0098        	  6022:     lea     ($0098,A4),A0
02:0003C104 11802000        	  6023:     move.b  D0,(A0,D2.W)
02:0003C108 7000            	  6024:     moveq   #0,D0
