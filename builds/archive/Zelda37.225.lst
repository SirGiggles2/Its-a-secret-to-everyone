                            	  9744:     ;
02:0003DC54 61001B42        	  9745:     jsr     PlayBossDeathCry
02:0003DC58 705D            	  9746:     moveq   #93,D0
02:0003DC5A 19400354        	  9747:     move.b  D0,($0354,A4)
02:0003DC5E 7010            	  9748:     moveq   #16,D0
02:0003DC60 1940040A        	  9749:     move.b  D0,($040A,A4)
02:0003DC64 1940002D        	  9750:     move.b  D0,($002D,A4)
                            	  9751:     even
