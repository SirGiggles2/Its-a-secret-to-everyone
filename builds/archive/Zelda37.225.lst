02:0003B32A 667C            	  4153:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4154:     ; The current heart's state = 0.
                            	  4155:     ;
                            	  4156:     ; If object slot = 2, then go make it appear. This is the first
                            	  4157:     ; heart to show up.
                            	  4158:     ;
02:0003B32C 0C020002        	  4159:     cmpi.b  #$02,D2
02:0003B330 6732            	  4160:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4161:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4162:     ; go start over.
                            	  4163:     ;
                            	  4164:     ; TODO:
                            	  4165:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4166:     ;
02:0003B332 102C00AE        	  4167:     move.b  ($00AE,A4),D0
02:0003B336 67EA            	  4168:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
