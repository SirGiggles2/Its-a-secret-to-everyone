02:0004C53E 651A            	  5307:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C540 0C0000FC        	  5308:     cmpi.b  #$FC,D0
02:0004C544 6466            	  5309:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C546 003C0011        	  5310:     ori     #$11,CCR  ; SEC: set C+X
02:0004C54A 12342070        	  5311:     move.b  ($70,A4,D2.W),D1
