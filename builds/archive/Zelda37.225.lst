02:00030246 19802070        	  3121:     move.b  D0,($70,A4,D2.W)
02:0003024A 41F900030206    	  3122:     lea     (TrapYs).l,A0
02:00030250 10303000        	  3123:     move.b  (A0,D3.W),D0
02:00030254 41EC0084        	  3124:     lea     ($0084,A4),A0
