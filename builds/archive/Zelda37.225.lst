02:0003A732 41EC0451        	  2404:     lea     ($0451,A4),A0
02:0003A736 11802000        	  2405:     move.b  D0,(A0,D2.W)
                            	  2406:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2407:     ;
02:0003A73A 6728            	  2408:     beq  _L_z04__TryShooting_SetSpeed
                            	  2409:     ; shoot timer <> 0
                            	  2410:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2411:     ;
02:0003A73C 0C030010        	  2412:     cmpi.b  #$10,D3
02:0003A740 661C            	  2413:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2414:     ; If we have the magic clock, or the monster is stunned, then
                            	  2415:     ; go set a zero speed.
                            	  2416:     ;
02:0003A742 102C066C        	  2417:     move.b  ($066C,A4),D0
02:0003A746 1234203D        	  2418:     move.b  ($3D,A4,D2.W),D1
02:0003A74A 8001            	  2419:     or.b  D1,D0
02:0003A74C 6610            	  2420:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2421:     ; Shoot.
                            	  2422:     ;
02:0003A74E 1014            	  2423:     move.b  ($0000,A4),D0
02:0003A750 611E            	  2424:     jsr     _ShootIfWanted2
                            	  2425:     ; If it failed, go set a non-zero speed.
                            	  2426:     ;
