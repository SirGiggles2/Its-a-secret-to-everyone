02:0003C4EE 10302000        	  6557:     move.b  (A0,D2.W),D0
02:0003C4F2 122C0002        	  6558:     move.b  ($0002,A4),D1
02:0003C4F6 E309            	  6559:     lsl.b  #1,D1   ; ASL $02
02:0003C4F8 19410002        	  6560:     move.b  D1,($0002,A4)
02:0003C4FC 122C0002        	  6561:     move.b  ($0002,A4),D1
02:0003C500 C200            	  6562:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C502 6716            	  6563:     beq  _L_z04_Digdogger_Move_Down
