                            	 11133: Gleeok_CheckCollisions:
                            	 11134:     ; If this segment is not the head nor the bottom of the neck,
                            	 11135:     ; then loop again to process the next segment.
                            	 11136:     ;
                            	 11137:     ; This kind of segment is only drawn, and is not checked
                            	 11138:     ; for object collisions.
                            	 11139:     ;
02:0003E6AE 0C020005        	 11140:     cmpi.b  #$05,D2
02:0003E6B2 670A            	 11141:     beq  _anon_z04_141
02:0003E6B4 0C020001        	 11142:     cmpi.b  #$01,D2
