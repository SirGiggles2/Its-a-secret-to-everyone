                            	 13145: Ganon_DrawBody:
                            	 13146:     ; Loop over four 16x16 images that make up Ganon.
                            	 13147:     ; There are 6 animation frames.
                            	 13148:     ;
02:0003F548 7603            	 13149:     moveq   #3,D3
                            	 13150:     even
                            	 13151: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13152:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13153:     ;
02:0003F54A 10342070        	 13154:     move.b  ($70,A4,D2.W),D0
02:0003F54E 023C00EE        	 13155:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F552 41F90003F53C    	 13156:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F558 12303000        	 13157:     move.b  (A0,D3.W),D1
02:0003F55C D101            	 13158:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F55E 1880            	 13159:     move.b  D0,($0000,A4)
                            	 13160:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13161:     ;
02:0003F560 41EC0084        	 13162:     lea     ($0084,A4),A0
02:0003F564 10302000        	 13163:     move.b  (A0,D2.W),D0
02:0003F568 023C00EE        	 13164:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F56C 41F90003F540    	 13165:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F572 12303000        	 13166:     move.b  (A0,D3.W),D1
02:0003F576 D101            	 13167:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F578 19400001        	 13168:     move.b  D0,($0001,A4)
                            	 13169:     ; Each part has a horizontal flipping flag.
                            	 13170:     ;
02:0003F57C 41F90003F544    	 13171:     lea     (GanonSpriteHFlips).l,A0
02:0003F582 10303000        	 13172:     move.b  (A0,D3.W),D0
02:0003F586 1940000F        	 13173:     move.b  D0,($000F,A4)
                            	 13174:     ; Save and copy the loop index (the current part) to [07].
                            	 13175:     ;
02:0003F58A 1003            	 13176:     move.b  D3,D0
02:0003F58C 1B00            	 13177:     move.b  D0,-(A5)  ; PHA
02:0003F58E 19400007        	 13178:     move.b  D0,($0007,A4)
                            	 13179:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13180:     ; that make it up.
                            	 13181:     ;
02:0003F592 41EC046B        	 13182:     lea     ($046B,A4),A0
02:0003F596 10302000        	 13183:     move.b  (A0,D2.W),D0
02:0003F59A E308            	 13184:     lsl.b  #1,D0   ; ASL A
02:0003F59C E308            	 13185:     lsl.b  #1,D0   ; ASL A
                            	 13186:     ; Add [07] -- the index of the current part.
                            	 13187:     ;
                            	 13188:     ; Now you have an index into the frame image table, for the
                            	 13189:     ; current image part of the current animation frame.
                            	 13190:     ;
02:0003F59E 122C0007        	 13191:     move.b  ($0007,A4),D1
02:0003F5A2 D101            	 13192:     addx.b  D1,D0   ; ADC $07
02:0003F5A4 7600            	 13193:     moveq   #0,D3
02:0003F5A6 1600            	 13194:     move.b  D0,D3
02:0003F5A8 41F90003F524    	 13195:     lea     (GanonFrameImages).l,A0
02:0003F5AE 10303000        	 13196:     move.b  (A0,D3.W),D0
02:0003F5B2 4EB9000316C6    	 13197:     jsr     DrawObjectNotMirrored
02:0003F5B8 101D            	 13198:     move.b  (A5)+,D0  ; PLA
                            	 13199:     ; Bottom of the part loop.
                            	 13200:     ;
02:0003F5BA 7600            	 13201:     moveq   #0,D3
02:0003F5BC 1600            	 13202:     move.b  D0,D3
02:0003F5BE 5303            	 13203:     subq.b  #1,D3
02:0003F5C0 6A88            	 13204:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F5C2 4E75            	 13205:     rts
                            	 13206: 
