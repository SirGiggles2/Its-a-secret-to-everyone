02:00031D58 122C000D        	  6873:     move.b  ($000D,A4),D1
02:00031D5C B001            	  6874:     cmp.b   D1,D0
02:00031D5E 6554            	  6875:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031D60 102C066F        	  6876:     move.b  ($066F,A4),D0
02:00031D64 003C0011        	  6877:     ori     #$11,CCR  ; SEC: set C+X
02:00031D68 122C000D        	  6878:     move.b  ($000D,A4),D1
02:00031D6C 0A3C0010        	  6879:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
