02:00033646 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:00033648 1002            	   594:     move.b  D2,D0
02:0003364A E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:0003364C 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
