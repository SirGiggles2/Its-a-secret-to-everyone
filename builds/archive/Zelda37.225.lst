02:00030BCC 4E75            	  4548:     rts
                            	  4549: 
                            	  4550: ; Params:
                            	  4551: ; Y: middle speed index (4)
                            	  4552: ; [03]: horizontal distance
                            	  4553: ; [04]: vertical distance
                            	  4554: ; [0A]: vertical direction
                            	  4555: ; [0B]: horizontal direction
                            	  4556: ;
                            	  4557: ; Returns:
                            	  4558: ; Y: speed index (0 to 8) for the angle
                            	  4559: ;
                            	  4560: ;
                            	  4561: ; TODO: call it speed index or angle?
                            	  4562: ; Store the middle speed index in [00]. It will be changed to the
                            	  4563: ; right speed index to use incrementally.
                            	  4564: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4565: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4566: ;
                            	  4567:     even
                            	  4568: _CalcDiagonalSpeedIndex:
02:00030BCE 1883            	  4569:     move.b  D3,($0000,A4)
                            	  4570:     ; Assuming horizontal distance >= vertical distance, the
                            	  4571:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4572:     ;
02:00030BD0 103C00FF        	  4573:     move.b  #$FF,D0
02:00030BD4 19400001        	  4574:     move.b  D0,($0001,A4)
                            	  4575:     ; TODO:
                            	  4576:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4577:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4578:     ;
                            	  4579:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4580:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4581:     ; of the farther distance faster.
                            	  4582:     ;
02:00030BD8 102C0003        	  4583:     move.b  ($0003,A4),D0
02:00030BDC 122C0004        	  4584:     move.b  ($0004,A4),D1
02:00030BE0 B001            	  4585:     cmp.b   D1,D0
02:00030BE2 6416            	  4586:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030BE4 1B00            	  4587:     move.b  D0,-(A5)  ; PHA
02:00030BE6 102C0004        	  4588:     move.b  ($0004,A4),D0
02:00030BEA 19400003        	  4589:     move.b  D0,($0003,A4)
02:00030BEE 101D            	  4590:     move.b  (A5)+,D0  ; PLA
02:00030BF0 19400004        	  4591:     move.b  D0,($0004,A4)
02:00030BF4 7001            	  4592:     moveq   #1,D0
02:00030BF6 19400001        	  4593:     move.b  D0,($0001,A4)
