02:0004B068 19400002        	  2352:     move.b  D0,($0002,A4)
02:0004B06C 4EB900031468    	  2353:     jsr     MapScreenPosToPpuAddr
02:0004B072 7400            	  2354:     moveq   #0,D2
02:0004B074 142C0301        	  2355:     move.b  ($0301,A4),D2
                            	  2356:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2357:     ;
                            	  2358:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2359:     ; In total, 11 bytes will be written.
                            	  2360:     ;
                            	  2361:     ; First, write the high byte of PPU address in each record.
                            	  2362:     ;
02:0004B078 1014            	  2363:     move.b  ($0000,A4),D0
02:0004B07A 41EC0302        	  2364:     lea     ($0302,A4),A0
02:0004B07E 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:0004B082 41EC0307        	  2366:     lea     ($0307,A4),A0
02:0004B086 11802000        	  2367:     move.b  D0,(A0,D2.W)
                            	  2368:     ; Write the low address in the first record. In the second record,
                            	  2369:     ; write (low address + 1).
                            	  2370:     ;
02:0004B08A 102C0001        	  2371:     move.b  ($0001,A4),D0
02:0004B08E 41EC0303        	  2372:     lea     ($0303,A4),A0
02:0004B092 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004B096 41EC0308        	  2374:     lea     ($0308,A4),A0
02:0004B09A 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004B09E 41EC0308        	  2376:     lea     ($0308,A4),A0
02:0004B0A2 52302000        	  2377:     addq.b  #1,(A0,D2.W)
                            	  2378:     ; Write the first tile twice in each record. Patch them later.
                            	  2379:     ;
02:0004B0A6 102C0005        	  2380:     move.b  ($0005,A4),D0
02:0004B0AA 41EC0305        	  2381:     lea     ($0305,A4),A0
02:0004B0AE 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B0B2 41EC0306        	  2383:     lea     ($0306,A4),A0
02:0004B0B6 11802000        	  2384:     move.b  D0,(A0,D2.W)
02:0004B0BA 41EC030A        	  2385:     lea     ($030A,A4),A0
02:0004B0BE 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004B0C2 41EC030B        	  2387:     lea     ($030B,A4),A0
02:0004B0C6 11802000        	  2388:     move.b  D0,(A0,D2.W)
                            	  2389:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2390:     ; Add 1 more to the second byte in each record.
                            	  2391:     ; Here is an example result of this manipulation:
                            	  2392:     ;   record 1: $70, $71
                            	  2393:     ;   record 2: $72, $73
                            	  2394:     ;
02:0004B0CA 0C000046        	  2395:     cmpi.b  #$46,D0
02:0004B0CE 6530            	  2396:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B0D0 0C0000F3        	  2397:     cmpi.b  #$F3,D0
02:0004B0D4 642A            	  2398:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B0D6 023C00EE        	  2399:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B0DA 123C0002        	  2400:     move.b  #$02,D1
02:0004B0DE D101            	  2401:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B0E0 41EC030A        	  2402:     lea     ($030A,A4),A0
02:0004B0E4 11802000        	  2403:     move.b  D0,(A0,D2.W)
02:0004B0E8 41EC030B        	  2404:     lea     ($030B,A4),A0
02:0004B0EC 11802000        	  2405:     move.b  D0,(A0,D2.W)
02:0004B0F0 41EC0306        	  2406:     lea     ($0306,A4),A0
02:0004B0F4 52302000        	  2407:     addq.b  #1,(A0,D2.W)
02:0004B0F8 41EC030B        	  2408:     lea     ($030B,A4),A0
