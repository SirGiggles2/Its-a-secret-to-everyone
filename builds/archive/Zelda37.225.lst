02:000446C0 101D            	  7579:     move.b  (A5)+,D0  ; PLA
02:000446C2 1B00            	  7580:     move.b  D0,-(A5)  ; PHA
02:000446C4 7400            	  7581:     moveq   #0,D2
02:000446C6 1400            	  7582:     move.b  D0,D2
                            	  7583:     ; Align the object's Y coordinate with 16 pixels.
                            	  7584:     ;
02:000446C8 41EC0084        	  7585:     lea     ($0084,A4),A0
