                            	  5190:     even
                            	  5191: _L_z02_DrawCredits_TerminateRecords:
                            	  5192:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5193:     ; attributes or only tiles.
                            	  5194:     ;
02:000368C6 103C00FF        	  5195:     move.b  #$FF,D0
02:000368CA 19400325        	  5196:     move.b  D0,($0325,A4)
02:000368CE 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:000368D2 7020            	  5200:     moveq   #32,D0
02:000368D4 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:000368D8 7400            	  5204:     moveq   #0,D2
02:000368DA 142C050C        	  5205:     move.b  ($050C,A4),D2
02:000368DE 41F900036684    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:000368E4 10302000        	  5207:     move.b  (A0,D2.W),D0
02:000368E8 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:000368EC 102C050D        	  5211:     move.b  ($050D,A4),D0
02:000368F0 7600            	  5212:     moveq   #0,D3
02:000368F2 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:000368F4 E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:000368F6 E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:000368F8 E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:000368FA E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:000368FC E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:000368FE 19400303        	  5221:     move.b  D0,($0303,A4)
                            	  5222:     ; Get the mask for the current VRAM page.
                            	  5223:     ;
02:00036902 41F900036690    	  5224:     lea     (CreditsPagesTextMasks).l,A0
02:00036908 10302000        	  5225:     move.b  (A0,D2.W),D0
                            	  5226: _anon_z02_43:
                            	  5227:     ; Shift left as many times as the current VRAM line number,
                            	  5228:     ; to get the bit that indicates whether this line has text.
                            	  5229:     ;
02:0003690C E308            	  5230:     lsl.b  #1,D0   ; ASL A
02:0003690E 5303            	  5231:     subq.b  #1,D3
02:00036910 6AFA            	  5232:     bpl  _anon_z02_43
02:00036912 6400013E        	  5233:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5234:     ; The mask inidcates that it should have text.
                            	  5235:     ; But if line index >= $17, then it doesn't.
                            	  5236:     ;
02:00036916 7600            	  5237:     moveq   #0,D3
02:00036918 162C050E        	  5238:     move.b  ($050E,A4),D3
02:0003691C 0C030017        	  5239:     cmpi.b  #$17,D3
02:00036920 64000130        	  5240:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5241:     ; In the first quest, don't consider line numbers >= $10.
                            	  5242:     ;
02:00036924 7400            	  5243:     moveq   #0,D2
02:00036926 142C0016        	  5244:     move.b  ($0016,A4),D2
02:0003692A 41EC062D        	  5245:     lea     ($062D,A4),A0
02:0003692E 10302000        	  5246:     move.b  (A0,D2.W),D0
02:00036932 6608            	  5247:     bne  _anon_z02_44
02:00036934 0C030010        	  5248:     cmpi.b  #$10,D3
02:00036938 64000114        	  5249:     bcc  _L_z02_DrawCredits_IncLine
                            	  5250: _anon_z02_44:
02:0003693C 7400            	  5251:     moveq   #0,D2
02:0003693E 142C0016        	  5252:     move.b  ($0016,A4),D2
02:00036942 41EC062D        	  5253:     lea     ($062D,A4),A0
02:00036946 10302000        	  5254:     move.b  (A0,D2.W),D0
                            	  5255:     ; In the second quest, skip lines $C to $F.
                            	  5256:     ;
02:0003694A 670E            	  5257:     beq  _anon_z02_45
02:0003694C 0C03000C        	  5258:     cmpi.b  #$0C,D3
02:00036950 6508            	  5259:     bcs  _anon_z02_45
02:00036952 0C030010        	  5260:     cmpi.b  #$10,D3
02:00036956 650000F6        	  5261:     bcs  _L_z02_DrawCredits_IncLine
                            	  5262: _anon_z02_45:
02:0003695A 41F90003669C    	  5263:     lea     (CreditsTextAddrsLo).l,A0
02:00036960 10303000        	  5264:     move.b  (A0,D3.W),D0
02:00036964 1880            	  5265:     move.b  D0,($0000,A4)
02:00036966 41F9000366B4    	  5266:     lea     (CreditsTextAddrsHi).l,A0
02:0003696C 10303000        	  5267:     move.b  (A0,D3.W),D0
02:00036970 19400001        	  5268:     move.b  D0,($0001,A4)
                            	  5269:     ; First read the length of the string.
                            	  5270:     ;
02:00036974 7600            	  5271:     moveq   #0,D3
02:00036976 1214            	  5272:     move.b  ($00,A4),D1   ; ptr lo
02:00036978 182C0001        	  5273:     move.b  ($01,A4),D4  ; ptr hi
02:0003697C 024100FF        	  5274:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036980 E14C            	  5275:     lsl.w   #8,D4
02:00036982 8841            	  5276:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036984 48C4            	  5277:     ext.l   D4
02:00036986 D8BC00FF0000    	  5278:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003698C 2044            	  5279:     movea.l D4,A0
02:0003698E 10303000        	  5280:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00036992 19400002        	  5281:     move.b  D0,($0002,A4)
                            	  5282:     ; Second, read the offset where the first character goes
                            	  5283:     ; in the line.
                            	  5284:     ;
02:00036996 5203            	  5285:     addq.b  #1,D3
02:00036998 1214            	  5286:     move.b  ($00,A4),D1   ; ptr lo
02:0003699A 182C0001        	  5287:     move.b  ($01,A4),D4  ; ptr hi
02:0003699E 024100FF        	  5288:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000369A2 E14C            	  5289:     lsl.w   #8,D4
02:000369A4 8841            	  5290:     or.w    D1,D4             ; D4 = NES ptr addr
02:000369A6 48C4            	  5291:     ext.l   D4
02:000369A8 D8BC00FF0000    	  5292:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000369AE 2044            	  5293:     movea.l D4,A0
02:000369B0 10303000        	  5294:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000369B4 7400            	  5295:     moveq   #0,D2
02:000369B6 1400            	  5296:     move.b  D0,D2
                            	  5297:     ; Loop over each character in the rest of the credits source record.
                            	  5298:     ;
02:000369B8 5203            	  5299:     addq.b  #1,D3
