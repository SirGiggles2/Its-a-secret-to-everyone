02:00040176 7003            	   324:     moveq   #3,D0
02:00040178 6100015C        	   325:     jsr     MovePositionMarkers
02:0004017C 102C00FC        	   326:     move.b  ($00FC,A4),D0
02:00040180 003C0011        	   327:     ori     #$11,CCR  ; SEC: set C+X
02:00040184 123C0003        	   328:     move.b  #$03,D1
02:00040188 0A3C0010        	   329:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004018C 9101            	   330:     subx.b  D1,D0   ; SBC #$03
02:0004018E 0A3C0010        	   331:     eori    #$10,CCR  ; restore X = 6502 C
02:00040192 194000FC        	   332:     move.b  D0,($00FC,A4)
                            	   333:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   334:     ;
02:00040196 0C000041        	   335:     cmpi.b  #$41,D0
02:0004019A 66000090        	   336:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   337:     ; VScroll reached $41.
