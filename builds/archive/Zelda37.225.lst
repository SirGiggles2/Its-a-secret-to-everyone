                            	  1358: _L_z04_UpdateBubble_Animate:
02:0003A03A 4EB9000319B8    	  1359:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  1360:     ; Animation counter 1 to switch animation frames every screen frame.
                            	  1361:     ;
