02:0002DEB0 7400            	   362:     moveq   #0,D2
02:0002DEB2 41F90002DD8C    	   363:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002DEB8 14303000        	   364:     move.b  (A0,D3.W),D2
                            	   365:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   366:     ;
02:0002DEBC 7602            	   367:     moveq   #2,D3
                            	   368:     even
                            	   369: _L_z01_InitCaveContinue_CopyPermutation:
02:0002DEBE 41F90002DD7A    	   370:     lea     (MoneyGamePermutations).l,A0
02:0002DEC4 10302000        	   371:     move.b  (A0,D2.W),D0
02:0002DEC8 41EC046C        	   372:     lea     ($046C,A4),A0
02:0002DECC 11803000        	   373:     move.b  D0,(A0,D3.W)
02:0002DED0 5302            	   374:     subq.b  #1,D2
02:0002DED2 5303            	   375:     subq.b  #1,D3
02:0002DED4 6AE8            	   376:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   377:     ; With the first bit of another random number, choose 10 or 40
                            	   378:     ; to put in [046F]. This is a random amount to lose.
                            	   379:     ;
02:0002DED6 102C001A        	   380:     move.b  ($001A,A4),D0
02:0002DEDA 02000001        	   381:     andi.b #$01,D0
02:0002DEDE 7600            	   382:     moveq   #0,D3
02:0002DEE0 1600            	   383:     move.b  D0,D3
02:0002DEE2 41F90002DD78    	   384:     lea     (MoneyGameLossAmounts).l,A0
02:0002DEE8 10303000        	   385:     move.b  (A0,D3.W),D0
02:0002DEEC 1940046F        	   386:     move.b  D0,($046F,A4)
                            	   387:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   388:     ;
02:0002DEF0 700A            	   389:     moveq   #10,D0
02:0002DEF2 19400470        	   390:     move.b  D0,($0470,A4)
                            	   391:     ; With a different bit of the second random number,
                            	   392:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   393:     ;
02:0002DEF6 7614            	   394:     moveq   #20,D3
02:0002DEF8 102C001A        	   395:     move.b  ($001A,A4),D0
02:0002DEFC 02000002        	   396:     andi.b #$02,D0
02:0002DF00 6702            	   397:     beq  _anon_z01_1
02:0002DF02 7632            	   398:     moveq   #50,D3
