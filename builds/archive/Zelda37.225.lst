02:0003C510 9101            	  6567:     subx.b  D1,D0   ; SBC $03
02:0003C512 0A3C0010        	  6568:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C516 19802070        	  6569:     move.b  D0,($70,A4,D2.W)
                            	  6570:     even
