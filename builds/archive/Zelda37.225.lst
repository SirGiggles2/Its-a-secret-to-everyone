02:0003E04C 123C0008        	 10274:     move.b  #$08,D1
02:0003E050 D101            	 10275:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E052 19802070        	 10276:     move.b  D0,($70,A4,D2.W)
02:0003E056 532C000F        	 10277:     subq.b  #1,($000F,A4)
02:0003E05A 66E2            	 10278:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	 10279:     ; Restore the boss's X coordinate.
                            	 10280:     ;
