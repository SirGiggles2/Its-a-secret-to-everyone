                            	  6265: _L_z07_UpdateSwordOrRod_Add4:
                            	  6266:     ; Set [00] to (state - 1) * 4:
                            	  6267:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6268:     ;
02:0004CBF0 023C00EE        	  6269:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CBF4 123C0004        	  6270:     move.b  #$04,D1
02:0004CBF8 D101            	  6271:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004CBFA 5303            	  6272:     subq.b  #1,D3
02:0004CBFC 66F2            	  6273:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004CBFE 1880            	  6274:     move.b  D0,($0000,A4)
