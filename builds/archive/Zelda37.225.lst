02:0003B00E 41EC03E4        	  3636:     lea     ($03E4,A4),A0
02:0003B012 12302000        	  3637:     move.b  (A0,D2.W),D1
02:0003B016 B300            	  3638:     eor.b  D1,D0
02:0003B018 41EC03E4        	  3639:     lea     ($03E4,A4),A0
02:0003B01C 11802000        	  3640:     move.b  D0,(A0,D2.W)
                            	  3641:     even
