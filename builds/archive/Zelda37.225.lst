                            	  9774: Manhandla_Move:
                            	  9775:     ; Implement a way of manifesting the fractional part of the speed
                            	  9776:     ; in the movement.
                            	  9777:     ;
                            	  9778:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9779:     ; byte to add to the coordinates, then the effective speed would
                            	  9780:     ; be 1 pixel a frame instead of 1.25.
                            	  9781:     ;
                            	  9782:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9783:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9784:     ;
                            	  9785:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9786:     ;
                            	  9787:     ;   SA := SA + (SL AND $E0)
                            	  9788:     ;   [03] := SH + carry
                            	  9789:     ;
                            	  9790:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9791:     ;
02:0003DC80 41EC041F        	  9792:     lea     ($041F,A4),A0
02:0003DC84 10302000        	  9793:     move.b  (A0,D2.W),D0
02:0003DC88 020000E0        	  9794:     andi.b #$E0,D0
02:0003DC8C 023C00EE        	  9795:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC90 41EC0412        	  9796:     lea     ($0412,A4),A0
02:0003DC94 12302000        	  9797:     move.b  (A0,D2.W),D1
02:0003DC98 D101            	  9798:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC9A 41EC0412        	  9799:     lea     ($0412,A4),A0
02:0003DC9E 11802000        	  9800:     move.b  D0,(A0,D2.W)
                            	  9801:     ; Assign (high speed byte + carry) to [03].
                            	  9802:     ;
02:0003DCA2 41EC042C        	  9803:     lea     ($042C,A4),A0
02:0003DCA6 10302000        	  9804:     move.b  (A0,D2.W),D0
02:0003DCAA 123C0000        	  9805:     move.b  #$00,D1
02:0003DCAE D101            	  9806:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCB0 19400003        	  9807:     move.b  D0,($0003,A4)
                            	  9808:     ; Change coordinates by the speed amount/offset in [03]
                            	  9809:     ; according to the direction.
                            	  9810:     ;
                            	  9811:     ; Start with a mask of $A1 in [02]:
                            	  9812:     ; - low nibble represents the right direction
                            	  9813:     ; - high nibble is used to set or clear carry as we go along
                            	  9814:     ;
02:0003DCB4 103C00A1        	  9815:     move.b  #$A1,D0
02:0003DCB8 19400002        	  9816:     move.b  D0,($0002,A4)
                            	  9817:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9818:     ;
02:0003DCBC 41EC0098        	  9819:     lea     ($0098,A4),A0
02:0003DCC0 10302000        	  9820:     move.b  (A0,D2.W),D0
02:0003DCC4 122C0002        	  9821:     move.b  ($0002,A4),D1
02:0003DCC8 C200            	  9822:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCCA 6712            	  9823:     beq  _L_z04_Manhandla_Move_Left
02:0003DCCC 10342070        	  9824:     move.b  ($70,A4,D2.W),D0
02:0003DCD0 023C00EE        	  9825:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCD4 122C0003        	  9826:     move.b  ($0003,A4),D1
02:0003DCD8 D101            	  9827:     addx.b  D1,D0   ; ADC $03
02:0003DCDA 19802070        	  9828:     move.b  D0,($70,A4,D2.W)
                            	  9829:     even
                            	  9830: _L_z04_Manhandla_Move_Left:
                            	  9831:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9832:     ;
02:0003DCDE 41EC0098        	  9833:     lea     ($0098,A4),A0
02:0003DCE2 10302000        	  9834:     move.b  (A0,D2.W),D0
02:0003DCE6 122C0002        	  9835:     move.b  ($0002,A4),D1
02:0003DCEA E309            	  9836:     lsl.b  #1,D1   ; ASL $02
02:0003DCEC 19410002        	  9837:     move.b  D1,($0002,A4)
02:0003DCF0 122C0002        	  9838:     move.b  ($0002,A4),D1
02:0003DCF4 C200            	  9839:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCF6 6716            	  9840:     beq  _L_z04_Manhandla_Move_Down
02:0003DCF8 10342070        	  9841:     move.b  ($70,A4,D2.W),D0
02:0003DCFC 122C0003        	  9842:     move.b  ($0003,A4),D1
02:0003DD00 0A3C0010        	  9843:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD04 9101            	  9844:     subx.b  D1,D0   ; SBC $03
02:0003DD06 0A3C0010        	  9845:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD0A 19802070        	  9846:     move.b  D0,($70,A4,D2.W)
                            	  9847:     even
                            	  9848: _L_z04_Manhandla_Move_Down:
                            	  9849:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9850:     ;
02:0003DD0E 41EC0098        	  9851:     lea     ($0098,A4),A0
02:0003DD12 10302000        	  9852:     move.b  (A0,D2.W),D0
02:0003DD16 122C0002        	  9853:     move.b  ($0002,A4),D1
02:0003DD1A E309            	  9854:     lsl.b  #1,D1   ; ASL $02
02:0003DD1C 19410002        	  9855:     move.b  D1,($0002,A4)
02:0003DD20 122C0002        	  9856:     move.b  ($0002,A4),D1
02:0003DD24 C200            	  9857:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD26 6716            	  9858:     beq  _L_z04_Manhandla_Move_Up
02:0003DD28 41EC0084        	  9859:     lea     ($0084,A4),A0
02:0003DD2C 10302000        	  9860:     move.b  (A0,D2.W),D0
02:0003DD30 122C0003        	  9861:     move.b  ($0003,A4),D1
02:0003DD34 D101            	  9862:     addx.b  D1,D0   ; ADC $03
02:0003DD36 41EC0084        	  9863:     lea     ($0084,A4),A0
02:0003DD3A 11802000        	  9864:     move.b  D0,(A0,D2.W)
                            	  9865:     even
                            	  9866: _L_z04_Manhandla_Move_Up:
                            	  9867:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9868:     ;
02:0003DD3E 41EC0098        	  9869:     lea     ($0098,A4),A0
02:0003DD42 10302000        	  9870:     move.b  (A0,D2.W),D0
02:0003DD46 122C0002        	  9871:     move.b  ($0002,A4),D1
02:0003DD4A E309            	  9872:     lsl.b  #1,D1   ; ASL $02
02:0003DD4C 19410002        	  9873:     move.b  D1,($0002,A4)
02:0003DD50 122C0002        	  9874:     move.b  ($0002,A4),D1
02:0003DD54 C200            	  9875:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD56 671E            	  9876:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD58 41EC0084        	  9877:     lea     ($0084,A4),A0
02:0003DD5C 10302000        	  9878:     move.b  (A0,D2.W),D0
02:0003DD60 122C0003        	  9879:     move.b  ($0003,A4),D1
02:0003DD64 0A3C0010        	  9880:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD68 9101            	  9881:     subx.b  D1,D0   ; SBC $03
02:0003DD6A 0A3C0010        	  9882:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD6E 41EC0084        	  9883:     lea     ($0084,A4),A0
02:0003DD72 11802000        	  9884:     move.b  D0,(A0,D2.W)
                            	  9885:     even
                            	  9886: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9887:     ; To the frame accumulator, add:
                            	  9888:     ; - a random value between 0 and 3
                            	  9889:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9890:     ;
02:0003DD76 10342019        	  9891:     move.b  ($19,A4,D2.W),D0
02:0003DD7A 02000003        	  9892:     andi.b #$03,D0
02:0003DD7E 023C00EE        	  9893:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD82 122C0003        	  9894:     move.b  ($0003,A4),D1
02:0003DD86 D101            	  9895:     addx.b  D1,D0   ; ADC $03
02:0003DD88 41EC0451        	  9896:     lea     ($0451,A4),A0
02:0003DD8C 12302000        	  9897:     move.b  (A0,D2.W),D1
02:0003DD90 D101            	  9898:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DD92 41EC0451        	  9899:     lea     ($0451,A4),A0
02:0003DD96 11802000        	  9900:     move.b  D0,(A0,D2.W)
02:0003DD9A 61001EB8        	  9901:     jsr     BoundFlyer
                            	  9902:     ; TODO:
                            	  9903:     ; I don't see why this is needed.
                            	  9904:     ;
02:0003DD9E 4EF90004D1F0    	  9905:     jmp     Anim_FetchObjPosForSpriteDescriptor
                            	  9906: 
                            	  9907:     even
                            	  9908: Manhandla_Draw:
02:0003DDA4 4EB90004D1F0    	  9909:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9910:     ; Push the "frame image and sprite attributes" value.
                            	  9911:     ;
02:0003DDAA 41EC0478        	  9912:     lea     ($0478,A4),A0
02:0003DDAE 10302000        	  9913:     move.b  (A0,D2.W),D0
02:0003DDB2 1B00            	  9914:     move.b  D0,-(A5)  ; PHA
                            	  9915:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9916:     ; passed along as is.
                            	  9917:     ;
02:0003DDB4 02000080        	  9918:     andi.b #$80,D0
02:0003DDB8 00000001        	  9919:     ori.b #$01,D0
02:0003DDBC 4EB9000319B8    	  9920:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DDC2 101D            	  9921:     move.b  (A5)+,D0  ; PLA
02:0003DDC4 1B00            	  9922:     move.b  D0,-(A5)  ; PHA
                            	  9923:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9924:     ;
02:0003DDC6 02000040        	  9925:     andi.b #$40,D0
02:0003DDCA 6704            	  9926:     beq  _anon_z04_116
02:0003DDCC 522C000F        	  9927:     addq.b  #1,($000F,A4)
                            	  9928: _anon_z04_116:
02:0003DDD0 101D            	  9929:     move.b  (A5)+,D0  ; PLA
                            	  9930:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9931:     ; These are the 2 frame images of the horizontal hands.
                            	  9932:     ;
                            	  9933:     ; Else draw the base and vertical hands mirrored.
                            	  9934:     ;
02:0003DDD2 0200000F        	  9935:     andi.b #$0F,D0
02:0003DDD6 0C000002        	  9936:     cmpi.b  #$02,D0
02:0003DDDA 670C            	  9937:     beq  _anon_z04_117
02:0003DDDC 0C000003        	  9938:     cmpi.b  #$03,D0
02:0003DDE0 6706            	  9939:     beq  _anon_z04_117
02:0003DDE2 4EF9000316C2    	  9940:     jmp     DrawObjectMirrored
                            	  9941: 
                            	  9942: _anon_z04_117:
02:0003DDE8 4EF9000316C6    	  9943:     jmp     DrawObjectNotMirrored
                            	  9944: 
                            	  9945:     even
                            	  9946: UpdateGohma:
                            	  9947:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9948:     ;
02:0003DDEE 41EC0451        	  9949:     lea     ($0451,A4),A0
02:0003DDF2 10302000        	  9950:     move.b  (A0,D2.W),D0
02:0003DDF6 662C            	  9951:     bne  _L_z04_UpdateGohma_Move
                            	  9952:     ; If Random:
                            	  9953:     ;   >= $B0: right
                            	  9954:     ;   >= $60: left
                            	  9955:     ;   Else:   down
                            	  9956:     ;
02:0003DDF8 7001            	  9957:     moveq   #1,D0
02:0003DDFA 7600            	  9958:     moveq   #0,D3
02:0003DDFC 16342018        	  9959:     move.b  ($18,A4,D2.W),D3
02:0003DE00 0C0300B0        	  9960:     cmpi.b  #$B0,D3
02:0003DE04 640A            	  9961:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE06 E308            	  9962:     lsl.b  #1,D0   ; ASL A
02:0003DE08 0C030060        	  9963:     cmpi.b  #$60,D3
02:0003DE0C 6402            	  9964:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE0E E308            	  9965:     lsl.b  #1,D0   ; ASL A
                            	  9966:     even
                            	  9967: _L_z04_UpdateGohma_ChangeDir:
02:0003DE10 41EC0098        	  9968:     lea     ($0098,A4),A0
02:0003DE14 11802000        	  9969:     move.b  D0,(A0,D2.W)
                            	  9970:     ; Now we can go straight without changing direction for some time.
                            	  9971:     ;
02:0003DE18 41EC0451        	  9972:     lea     ($0451,A4),A0
02:0003DE1C 52302000        	  9973:     addq.b  #1,(A0,D2.W)
                            	  9974:     ; Go animate the eye.
                            	  9975:     ;
02:0003DE20 600000C6        	  9976:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9977: 
                            	  9978:     even
                            	  9979: _L_z04_UpdateGohma_Move:
                            	  9980:     ; Add $80 to the movement accumulator.
                            	  9981:     ;
02:0003DE24 41EC041F        	  9982:     lea     ($041F,A4),A0
02:0003DE28 10302000        	  9983:     move.b  (A0,D2.W),D0
02:0003DE2C 023C00EE        	  9984:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE30 123C0080        	  9985:     move.b  #$80,D1
02:0003DE34 D101            	  9986:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE36 41EC041F        	  9987:     lea     ($041F,A4),A0
02:0003DE3A 11802000        	  9988:     move.b  D0,(A0,D2.W)
                            	  9989:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9990:     ;
02:0003DE3E 640000A8        	  9991:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9992:     ; Increase the distance traveled, and move 1.
                            	  9993:     ;
02:0003DE42 41EC0412        	  9994:     lea     ($0412,A4),A0
02:0003DE46 52302000        	  9995:     addq.b  #1,(A0,D2.W)
                            	  9996:     ; Set a direction mask in [02], starting with right (1).
                            	  9997:     ;
02:0003DE4A 7001            	  9998:     moveq   #1,D0
02:0003DE4C 19400002        	  9999:     move.b  D0,($0002,A4)
                            	 10000:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	 10001:     ;
02:0003DE50 41EC0098        	 10002:     lea     ($0098,A4),A0
02:0003DE54 10302000        	 10003:     move.b  (A0,D2.W),D0
02:0003DE58 122C0002        	 10004:     move.b  ($0002,A4),D1
02:0003DE5C C200            	 10005:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE5E 6704            	 10006:     beq  _anon_z04_118
02:0003DE60 52342070        	 10007:     addq.b  #1,($70,A4,D2.W)
                            	 10008: _anon_z04_118:
                            	 10009:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	 10010:     ;
02:0003DE64 122C0002        	 10011:     move.b  ($0002,A4),D1
02:0003DE68 E309            	 10012:     lsl.b  #1,D1   ; ASL $02
02:0003DE6A 19410002        	 10013:     move.b  D1,($0002,A4)
02:0003DE6E 122C0002        	 10014:     move.b  ($0002,A4),D1
02:0003DE72 C200            	 10015:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE74 6704            	 10016:     beq  _anon_z04_119
02:0003DE76 53342070        	 10017:     subq.b  #1,($70,A4,D2.W)
                            	 10018: _anon_z04_119:
                            	 10019:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	 10020:     ;
02:0003DE7A 122C0002        	 10021:     move.b  ($0002,A4),D1
02:0003DE7E E309            	 10022:     lsl.b  #1,D1   ; ASL $02
02:0003DE80 19410002        	 10023:     move.b  D1,($0002,A4)
02:0003DE84 122C0002        	 10024:     move.b  ($0002,A4),D1
02:0003DE88 C200            	 10025:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE8A 6708            	 10026:     beq  _anon_z04_120
02:0003DE8C 41EC0084        	 10027:     lea     ($0084,A4),A0
02:0003DE90 52302000        	 10028:     addq.b  #1,(A0,D2.W)
                            	 10029: _anon_z04_120:
                            	 10030:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	 10031:     ;
02:0003DE94 122C0002        	 10032:     move.b  ($0002,A4),D1
02:0003DE98 E309            	 10033:     lsl.b  #1,D1   ; ASL $02
02:0003DE9A 19410002        	 10034:     move.b  D1,($0002,A4)
02:0003DE9E 122C0002        	 10035:     move.b  ($0002,A4),D1
02:0003DEA2 C200            	 10036:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEA4 6708            	 10037:     beq  _anon_z04_121
02:0003DEA6 41EC0084        	 10038:     lea     ($0084,A4),A0
02:0003DEAA 53302000        	 10039:     subq.b  #1,(A0,D2.W)
                            	 10040: _anon_z04_121:
                            	 10041:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	 10042:     ;
02:0003DEAE 41EC0412        	 10043:     lea     ($0412,A4),A0
02:0003DEB2 10302000        	 10044:     move.b  (A0,D2.W),D0
02:0003DEB6 0C000020        	 10045:     cmpi.b  #$20,D0
02:0003DEBA 662C            	 10046:     bne  _L_z04_UpdateGohma_AnimateEye
                            	 10047:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
