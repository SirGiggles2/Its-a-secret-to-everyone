02:0003B35A 12303000        	  4183:     move.b  (A0,D3.W),D1
02:0003B35E B001            	  4184:     cmp.b   D1,D0
02:0003B360 66000086        	  4185:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
