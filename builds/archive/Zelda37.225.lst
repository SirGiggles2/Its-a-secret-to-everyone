                            	 13127: GanonFrameImages:
02:0003F524 06              	 13128:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003F525 08
02:0003F526 07
02:0003F527 09
02:0003F528 00
02:0003F529 00
02:0003F52A 01
02:0003F52B 01
02:0003F52C 02              	 13129:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003F52D 02
02:0003F52E 03
02:0003F52F 03
02:0003F530 04
02:0003F531 00
02:0003F532 05
02:0003F533 01
02:0003F534 04              	 13130:     dc.b    $04, $04, $05, $05, $00, $04, $01, $05
02:0003F535 04
02:0003F536 05
02:0003F537 05
02:0003F538 00
02:0003F539 04
02:0003F53A 01
