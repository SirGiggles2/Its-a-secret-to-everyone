02:0004C512 02000003        	  5289:     andi.b #$03,D0
02:0004C516 41F90004C374    	  5290:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C51C 12303000        	  5291:     move.b  (A0,D3.W),D1
02:0004C520 8001            	  5292:     or.b  D1,D0
02:0004C522 4EB9000319B8    	  5293:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5294:     ; Add the object's X (the center of the spread) and the
