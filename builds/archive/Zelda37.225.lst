02:00030274 660000B2        	  3140:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  3141:     ; State 0. Sensing.
                            	  3142:     ;
                            	  3143:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  3144:     ; then go see if the horizontal distance is shorter.
                            	  3145:     ;
02:00030278 102C0084        	  3146:     move.b  ($0084,A4),D0
02:0003027C 003C0011        	  3147:     ori     #$11,CCR  ; SEC: set C+X
02:00030280 41EC0084        	  3148:     lea     ($0084,A4),A0
02:00030284 12302000        	  3149:     move.b  (A0,D2.W),D1
02:00030288 0A3C0010        	  3150:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003028C 9101            	  3151:     subx.b  D1,D0   ; SBC ObjY,X
02:0003028E 0A3C0010        	  3152:     eori    #$10,CCR  ; restore X = 6502 C
02:00030292 61000898        	  3153:     jsr     Abs
02:00030296 0C00000E        	  3154:     cmpi.b  #$0E,D0
02:0003029A 644C            	  3155:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  3156:     ; Determine the horizontal direction toward Link;
                            	  3157:     ; and if Link and the trap are at the same X, then we can't move
                            	  3158:     ; along this axis. Go see about moving vertically.
