                            	  1255:     ;
02:00039F70 41EC0412        	  1256:     lea     ($0412,A4),A0
02:00039F74 10302000        	  1257:     move.b  (A0,D2.W),D0
02:00039F78 1940000F        	  1258:     move.b  D0,($000F,A4)
                            	  1259:     ; Load the horizontal q-speed and position fraction,
                            	  1260:     ; move, then save the position fraction.
                            	  1261:     ;
02:00039F7C 41EC041F        	  1262:     lea     ($041F,A4),A0
02:00039F80 10302000        	  1263:     move.b  (A0,D2.W),D0
02:00039F84 7600            	  1264:     moveq   #0,D3
02:00039F86 41EC0451        	  1265:     lea     ($0451,A4),A0
02:00039F8A 16302000        	  1266:     move.b  (A0,D2.W),D3
02:00039F8E 613E            	  1267:     jsr     Fireball_MoveOneAxis
02:00039F90 41EC0451        	  1268:     lea     ($0451,A4),A0
02:00039F94 11802000        	  1269:     move.b  D0,(A0,D2.W)
                            	  1270:     ; Second, load the vertical direction into [0F].
                            	  1271:     ;
02:00039F98 41EC0437        	  1272:     lea     ($0437,A4),A0
02:00039F9C 10302000        	  1273:     move.b  (A0,D2.W),D0
02:00039FA0 1940000F        	  1274:     move.b  D0,($000F,A4)
                            	  1275:     ; Load the vertical q-speed and position fraction,
                            	  1276:     ; move, then save the position fraction.
                            	  1277:     ;
02:00039FA4 41EC0444        	  1278:     lea     ($0444,A4),A0
02:00039FA8 10302000        	  1279:     move.b  (A0,D2.W),D0
02:00039FAC 7600            	  1280:     moveq   #0,D3
02:00039FAE 41EC045E        	  1281:     lea     ($045E,A4),A0
02:00039FB2 16302000        	  1282:     move.b  (A0,D2.W),D3
