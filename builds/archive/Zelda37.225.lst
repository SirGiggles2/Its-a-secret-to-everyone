02:0002E83E 020000F0        	  1745:     andi.b #$F0,D0
02:0002E842 003C0011        	  1746:     ori     #$11,CCR  ; SEC: set C+X
02:0002E846 123C0010        	  1747:     move.b  #$10,D1
02:0002E84A 0A3C0010        	  1748:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E84E 9101            	  1749:     subx.b  D1,D0   ; SBC #$10
02:0002E850 0A3C0010        	  1750:     eori    #$10,CCR  ; restore X = 6502 C
