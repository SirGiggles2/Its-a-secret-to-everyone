                            	  2330: _TryShooting:
02:0003A6CA 19400001        	  2331:     move.b  D0,($0001,A4)
                            	  2332:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2333:     ;
02:0003A6CE 41EC034F        	  2334:     lea     ($034F,A4),A0
02:0003A6D2 10302000        	  2335:     move.b  (A0,D2.W),D0
02:0003A6D6 0C000003        	  2336:     cmpi.b  #$03,D0
02:0003A6DA 6726            	  2337:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6DC 0C000001        	  2338:     cmpi.b  #$01,D0
02:0003A6E0 6720            	  2339:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6E2 0C000009        	  2340:     cmpi.b  #$09,D0
02:0003A6E6 671A            	  2341:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6E8 0C00000A        	  2342:     cmpi.b  #$0A,D0
02:0003A6EC 6714            	  2343:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6EE 41EC0451        	  2344:     lea     ($0451,A4),A0
02:0003A6F2 10302000        	  2345:     move.b  (A0,D2.W),D0
02:0003A6F6 660A            	  2346:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2347:     ; and a random value < $F8, then return.
                            	  2348:     ;
02:0003A6F8 10342018        	  2349:     move.b  ($18,A4,D2.W),D0
02:0003A6FC 0C0000F8        	  2350:     cmpi.b  #$F8,D0
02:0003A700 656C            	  2351:     bcs  _L_z04__TryShooting_Exit
                            	  2352:     even
                            	  2353: _L_z04__TryShooting_TryShootingNow:
                            	  2354:     ; Summary
                            	  2355:     ;
                            	  2356:     ; if temporarily invincible then
                            	  2357:     ;   shoot timer := 0
                            	  2358:     ; elif shoot timer > 0 then
                            	  2359:     ;   decrement shoot timer
                            	  2360:     ; elif wants to shoot then
                            	  2361:     ;   shoot timer := $30
                            	  2362:     ;
                            	  2363:     ; qspeed := [01]
                            	  2364:     ;
                            	  2365:     ; if shoot timer <> 0 then
                            	  2366:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2367:     ;     shoot
                            	  2368:     ;     if succeeded then
                            	  2369:     ;       shoot timer := 0
                            	  2370:     ;       qspeed := 0
                            	  2371:     ;   else
                            	  2372:     ;     qspeed := 0
                            	  2373:     ;
                            	  2374:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A702 102C0001        	  2375:     move.b  ($0001,A4),D0
02:0003A706 1883            	  2376:     move.b  D3,($0000,A4)
02:0003A708 1B00            	  2377:     move.b  D0,-(A5)  ; PHA
02:0003A70A 7600            	  2378:     moveq   #0,D3
                            	  2379:     ; If not temporarily invincible,
                            	  2380:     ;
02:0003A70C 41EC04F0        	  2381:     lea     ($04F0,A4),A0
02:0003A710 10302000        	  2382:     move.b  (A0,D2.W),D0
02:0003A714 661A            	  2383:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2384:     ; then Y := shoot timer - 1
                            	  2385:     ;
02:0003A716 7600            	  2386:     moveq   #0,D3
02:0003A718 41EC0451        	  2387:     lea     ($0451,A4),A0
02:0003A71C 16302000        	  2388:     move.b  (A0,D2.W),D3
02:0003A720 5303            	  2389:     subq.b  #1,D3
                            	  2390:     ; If Y register < 0, then shoot timer is 0.
                            	  2391:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2392:     ; Else go set a non-zero speed and return.
                            	  2393:     ;
02:0003A722 6A0C            	  2394:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A724 41EC0412        	  2395:     lea     ($0412,A4),A0
02:0003A728 10302000        	  2396:     move.b  (A0,D2.W),D0
02:0003A72C 6736            	  2397:     beq  _L_z04__TryShooting_SetSpeed
02:0003A72E 7630            	  2398:     moveq   #48,D3
                            	  2399:     even
                            	  2400: _L_z04__TryShooting_SetShootTimer:
                            	  2401:     ; shoot timer := Y
                            	  2402:     ;
