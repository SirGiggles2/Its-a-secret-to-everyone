02:00031408 6630            	  5777:     bne  _L_z01_CheckMazes_CheckMountainMaze
02:0003140A 41F9000313EC    	  5778:     lea     (ForestMazeDirs).l,A0
02:00031410 12302000        	  5779:     move.b  (A0,D2.W),D1
02:00031414 B001            	  5780:     cmp.b   D1,D0
02:00031416 6618            	  5781:     bne  _L_z01_CheckMazes_Mismatch
                            	  5782:     ; The direction matches the step.
                            	  5783:     ;
02:00031418 0C020003        	  5784:     cmpi.b  #$03,D2
02:0003141C 6742            	  5785:     beq  _L_z01_CheckMazes_PlaySecretTune
