02:0003A29E 023C00EE        	  1703:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2A2 123C0008        	  1704:     move.b  #$08,D1
02:0003A2A6 D101            	  1705:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A2A8 020000F0        	  1706:     andi.b #$F0,D0
02:0003A2AC 19802070        	  1707:     move.b  D0,($70,A4,D2.W)
