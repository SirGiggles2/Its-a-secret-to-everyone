02:0003B258 41EC03E4        	  4006:     lea     ($03E4,A4),A0
02:0003B25C 12302000        	  4007:     move.b  (A0,D2.W),D1
02:0003B260 D101            	  4008:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B262 4EB9000316C6    	  4009:     jsr     DrawObjectNotMirrored
