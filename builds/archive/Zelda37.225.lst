                            	  8277:     ; of the big map sheet.
                            	  8278:     ;
02:00044E8A 0C000015        	  8279:     cmpi.b  #$15,D0
02:00044E8E 6604            	  8280:     bne  _anon_z05_168
02:00044E90 7042            	  8281:     moveq   #66,D0
