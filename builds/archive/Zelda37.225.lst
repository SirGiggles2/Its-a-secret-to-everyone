                            	  6887: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6888:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6889:     ;   full heart=4 partial heart=$70
                            	  6890:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6891:     ; But the method here yields $3EF, because partial heart is
                            	  6892:     ; considered full when = $FF instead of $100.
                            	  6893:     ;
02:00031D80 102C000E        	  6894:     move.b  ($000E,A4),D0
02:00031D84 003C0011        	  6895:     ori     #$11,CCR  ; SEC: set C+X
02:00031D88 122C0670        	  6896:     move.b  ($0670,A4),D1
02:00031D8C 0A3C0010        	  6897:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031D90 9101            	  6898:     subx.b  D1,D0   ; SBC HeartPartial
02:00031D92 0A3C0010        	  6899:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D96 1940000E        	  6900:     move.b  D0,($000E,A4)
02:00031D9A 102C066F        	  6901:     move.b  ($066F,A4),D0
02:00031D9E 0200000F        	  6902:     andi.b #$0F,D0
02:00031DA2 6710            	  6903:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031DA4 532C066F        	  6904:     subq.b  #1,($066F,A4)
02:00031DA8 103C00FF        	  6905:     move.b  #$FF,D0
02:00031DAC 19400670        	  6906:     move.b  D0,($0670,A4)
02:00031DB0 6600FF6E        	  6907:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6908:     even
                            	  6909: _L_z01_Link_BeHarmed_HandleDied:
                            	  6910:     ; Link died.
                            	  6911:     ;
                            	  6912:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6913:     ; Make Link face down.
                            	  6914:     ; Go to mode $11.
                            	  6915:     ;
02:00031DB4 102C066F        	  6916:     move.b  ($066F,A4),D0
02:00031DB8 020000F0        	  6917:     andi.b #$F0,D0
02:00031DBC 1940066F        	  6918:     move.b  D0,($066F,A4)
02:00031DC0 4EB90004B5BE    	  6919:     jsr     EndGameMode
02:00031DC6 19400670        	  6920:     move.b  D0,($0670,A4)
02:00031DCA 194000AC        	  6921:     move.b  D0,($00AC,A4)
02:00031DCE 7011            	  6922:     moveq   #17,D0
02:00031DD0 19400012        	  6923:     move.b  D0,($0012,A4)
02:00031DD4 7004            	  6924:     moveq   #4,D0
02:00031DD6 19400098        	  6925:     move.b  D0,($0098,A4)
                            	  6926: _anon_z01_87:
02:00031DDA 4E75            	  6927:     rts
                            	  6928: 
                            	  6929: ; Params:
                            	  6930: ; X: monster slot
                            	  6931: ; Y: weapon slot
                            	  6932: ; [02]: monster mid X
                            	  6933: ; [03]: monster mid Y
                            	  6934: ;
                            	  6935: ; Returns:
                            	  6936: ; [00]: weapon slot
                            	  6937: ;
                            	  6938: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6939: ;
                            	  6940:     even
                            	  6941: CheckMonsterBoomerangOrFoodCollision:
02:00031DDC 41EC00AC        	  6942:     lea     ($00AC,A4),A0
02:00031DE0 10303000        	  6943:     move.b  (A0,D3.W),D0
02:00031DE4 E308            	  6944:     lsl.b  #1,D0   ; ASL A
02:00031DE6 65F2            	  6945:     bcs  _anon_z01_87
02:00031DE8 1883            	  6946:     move.b  D3,($0000,A4)
                            	  6947:     ; Set boomerang damage type (2) in [09].
                            	  6948:     ;
02:00031DEA 7002            	  6949:     moveq   #2,D0
02:00031DEC 19400009        	  6950:     move.b  D0,($0009,A4)
                            	  6951:     ; Set collision threshold $A in both axes.
                            	  6952:     ;
02:00031DF0 700A            	  6953:     moveq   #10,D0
02:00031DF2 1940000D        	  6954:     move.b  D0,($000D,A4)
02:00031DF6 1940000E        	  6955:     move.b  D0,($000E,A4)
                            	  6956:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6957:     ;
02:00031DFA 10343070        	  6958:     move.b  ($70,A4,D3.W),D0
02:00031DFE 023C00EE        	  6959:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E02 123C0004        	  6960:     move.b  #$04,D1
02:00031E06 D101            	  6961:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031E08 19400004        	  6962:     move.b  D0,($0004,A4)
                            	  6963:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6964:     ;
02:00031E0C 41EC0084        	  6965:     lea     ($0084,A4),A0
02:00031E10 10303000        	  6966:     move.b  (A0,D3.W),D0
02:00031E14 023C00EE        	  6967:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031E18 123C0008        	  6968:     move.b  #$08,D1
02:00031E1C D101            	  6969:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6970: ; Params:
                            	  6971: ; A: weapon object mid Y
                            	  6972: ; X: monster object slot
                            	  6973: ; Y: weapon object slot
                            	  6974: ; [00]: weapon object slot
                            	  6975: ; [02]: monster object mid X
                            	  6976: ; [03]: monster object mid Y
                            	  6977: ; [04]: weapon object mid X
                            	  6978: ; [07]: damage points
                            	  6979: ; [09]: damage type
                            	  6980: ; [0D]: horizontal threshold
                            	  6981: ; [0E]: vertical threshold
                            	  6982: ;
                            	  6983: ; Returns:
                            	  6984: ; [06]: 1 if objects collide
                            	  6985: ;
                            	  6986:     even
                            	  6987: CheckMonsterWeaponCollision:
02:00031E1E 19400005        	  6988:     move.b  D0,($0005,A4)
                            	  6989:     ; Reset [06] for no collision.
                            	  6990:     ;
02:00031E22 7000            	  6991:     moveq   #0,D0
02:00031E24 19400006        	  6992:     move.b  D0,($0006,A4)
                            	  6993:     ; If the weapon's not active (state = 0), then return.
                            	  6994:     ;
02:00031E28 7600            	  6995:     moveq   #0,D3
02:00031E2A 1614            	  6996:     move.b  ($0000,A4),D3
02:00031E2C 41EC00AC        	  6997:     lea     ($00AC,A4),A0
02:00031E30 10303000        	  6998:     move.b  (A0,D3.W),D0
02:00031E34 6604            	  6999:     bne.s  __far_z_01_0071
02:00031E36 6000010C        	  7000:     jmp  L74D8_Exit
