02:0003ADBE 41EC0098        	  3321:     lea     ($0098,A4),A0
02:0003ADC2 10302000        	  3322:     move.b  (A0,D2.W),D0
02:0003ADC6 02000008        	  3323:     andi.b #$08,D0
02:0003ADCA 6704            	  3324:     beq  _anon_z04_44
02:0003ADCC 163C00D8        	  3325:     move.b  #$D8,D3
                            	  3326: _anon_z04_44:
02:0003ADD0 1883            	  3327:     move.b  D3,($0000,A4)
                            	  3328:     ; Add Link's Y and the vertical offset.
                            	  3329:     ;
02:0003ADD2 102C0084        	  3330:     move.b  ($0084,A4),D0
02:0003ADD6 023C00EE        	  3331:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADDA 1214            	  3332:     move.b  ($0000,A4),D1
