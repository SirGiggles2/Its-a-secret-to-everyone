02:00043918 7400            	  6014:     moveq   #0,D2
02:0004391A 1400            	  6015:     move.b  D0,D2
                            	  6016:     ; For each row (2 or 3) in the door, indexed by X,
                            	  6017:     ; starting from highest index down to 0:
                            	  6018:     ;
02:0004391C 41F90004380A    	  6019:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043922 10302000        	  6020:     move.b  (A0,D2.W),D0
02:00043926 7400            	  6021:     moveq   #0,D2
