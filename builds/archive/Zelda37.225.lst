                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:00040236 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:0004023A 02000088        	   430:     andi.b #$88,D0
02:0004023E 0C000088        	   431:     cmpi.b  #$88,D0
02:00040242 661A            	   432:     bne  _anon_z05_3
