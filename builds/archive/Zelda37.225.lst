02:0003F1E4 7400            	 12651:     moveq   #0,D2
02:0003F1E6 1400            	 12652:     move.b  D0,D2
                            	 12653:     ; Turn off the room brightening flag, because we're controlling it
                            	 12654:     ; here instead of in the Mode 5 object update loop.
                            	 12655:     ;
02:0003F1E8 7000            	 12656:     moveq   #0,D0
02:0003F1EA 1940051E        	 12657:     move.b  D0,($051E,A4)
                            	 12658:     ; On the first frame of the fade-to-light cycle, play the
                            	 12659:     ; Triforce/Ganon song.
                            	 12660:     ;
02:0003F1EE 102C051C        	 12661:     move.b  ($051C,A4),D0
02:0003F1F2 0C0000C0        	 12662:     cmpi.b  #$C0,D0
02:0003F1F6 6606            	 12663:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
