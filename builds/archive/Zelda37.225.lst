                            	  6757: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6758:     ; Link and the shot are facing opposite directions.
                            	  6759:     ; Link can parry certain weapons/shots.
                            	  6760:     ;
                            	  6761:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6762:     ; no harmful collision; but it still counts as a shot collision.
                            	  6763:     ; So, go treat this as a parry.
                            	  6764:     ;
02:00031C90 41EC034F        	  6765:     lea     ($034F,A4),A0
02:00031C94 10302000        	  6766:     move.b  (A0,D2.W),D0
02:00031C98 0C000055        	  6767:     cmpi.b  #$55,D0
02:00031C9C 650E            	  6768:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031C9E 0C00005B        	  6769:     cmpi.b  #$5B,D0
02:00031CA2 6408            	  6770:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6771:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6772:     ; So, go harm Link.
                            	  6773:     ;
02:00031CA4 102C0676        	  6774:     move.b  ($0676,A4),D0
02:00031CA8 6602            	  6775:     bne.s  __far_z_01_0070
02:00031CAA 600E            	  6776:     jmp  HarmLink
                            	  6777: __far_z_01_0070:
                            	  6778:     even
