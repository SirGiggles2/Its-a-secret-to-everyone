                            	  1679:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1680:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1681:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00034438 7000            	  1682:     moveq   #0,D0
02:0003443A 102C0437        	  1683:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:0003443E EB48            	  1684:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00034440 41F900034222    	  1685:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00034446 D0C0            	  1686:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1687:     ; Set up DynTileBuf header: $3F, $00, $20
02:00034448 197C003F0302    	  1688:     move.b  #$3F,($0302,A4)
02:0003444E 197C00000303    	  1689:     move.b  #$00,($0303,A4)
02:00034454 7020            	  1690:     moveq   #32,D0
02:00034456 19400304        	  1691:     move.b  D0,($0304,A4)
