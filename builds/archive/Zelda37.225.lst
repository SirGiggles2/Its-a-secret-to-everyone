02:0004CA24 41EC03D0        	  6031:     lea     ($03D0,A4),A0
02:0004CA28 11802000        	  6032:     move.b  D0,(A0,D2.W)
02:0004CA2C 41EC00AC        	  6033:     lea     ($00AC,A4),A0
02:0004CA30 52302000        	  6034:     addq.b  #1,(A0,D2.W)
02:0004CA34 41EC00AC        	  6035:     lea     ($00AC,A4),A0
02:0004CA38 10302000        	  6036:     move.b  (A0,D2.W),D0
