                            	  4321: PlayerScreenEdgeBounds:
02:0004BF06 3D              	  4322:     dc.b    $3D, $DD, $00, $F0
02:0004BF07 DD
02:0004BF08 00
02:0004BF09 F0
                            	  4323: 
                            	  4324: ; Params:
                            	  4325: ; [0E]: $FF, if blocked by a door
                            	  4326: ; [0F]: movement direction
                            	  4327: ;
                            	  4328: ; Returns:
                            	  4329: ; [0F]: untouched, or changed if blocked or need to change
                            	  4330: ;
                            	  4331: ; Summary:
                            	  4332: ;
                            	  4333: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4334: ; Then allow movement or go to the next room. Otherwise,
                            	  4335: ; check passive tile objects and stop moving.
                            	  4336: ;
                            	  4337: ; For other objects: First, if moving, test the colliding tile for
                            	  4338: ; walkability. Otherwise search for a walkable direction starting
                            	  4339: ; from input direction.
                            	  4340: ;
                            	  4341: ; When you find a walkable direction, see if it makes the object
                            	  4342: ; cross a boundary. If it doesn't, then make this direction
                            	  4343: ; the objection direction. Otherwise, keep looping.
                            	  4344: ;
                            	  4345: ; If no walkable direction is found, then stop moving.
                            	  4346: ;
                            	  4347: ;
                            	  4348: ; if is player
                            	  4349: ;   if at doorway
                            	  4350: ;     go handle a walkable direction
                            	  4351: ;   if blocked by door
                            	  4352: ;     return
                            	  4353: ;
                            	  4354:     even
                            	  4355: Walker_CheckTileCollision:
                            	  4356:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4357:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4358:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4359:     ; reset) for Link and every other object. Only the tile
                            	  4360:     ; walkability decision in CheckTiles is overridden.
02:0004BF0A 4A02            	  4361:     cmpi.b  #$00,D2
02:0004BF0C 6614            	  4362:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004BF0E 102C0053        	  4363:     move.b  ($0053,A4),D0
02:0004BF12 6704            	  4364:     beq  _anon_z07_16
02:0004BF14 600000BE        	  4365:     jmp     GoWalkableDir
                            	  4366: 
                            	  4367: _anon_z07_16:
02:0004BF18 102C000E        	  4368:     move.b  ($000E,A4),D0
02:0004BF1C 6A04            	  4369:     bpl.s  __far_z_07_0051
02:0004BF1E 600000AC        	  4370:     jmp  L1F148_Exit
                            	  4371: __far_z_07_0051:
                            	  4372:     even
                            	  4373: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4374:     ; If grid offset <> 0, return.
                            	  4375:     ;
02:0004BF22 41EC0394        	  4376:     lea     ($0394,A4),A0
02:0004BF26 10302000        	  4377:     move.b  (A0,D2.W),D0
02:0004BF2A 6704            	  4378:     beq.s  __far_z_07_0052
02:0004BF2C 6000009E        	  4379:     jmp  L1F148_Exit
                            	  4380: __far_z_07_0052:
                            	  4381:     ; Grid offset = 0.
                            	  4382:     ; The object is at a point between cells in the grid.
                            	  4383:     ; So, we can check tiles for collision.
                            	  4384:     ;
                            	  4385:     ; Reset [0E] alternate direction search step.
                            	  4386:     ;
02:0004BF30 1940000E        	  4387:     move.b  D0,($000E,A4)
                            	  4388:     ; If there's a movement direction, go check tile collision.
                            	  4389:     ;
02:0004BF34 102C000F        	  4390:     move.b  ($000F,A4),D0
02:0004BF38 6702            	  4391:     beq.s  __far_z_07_0053
02:0004BF3A 602E            	  4392:     jmp  CheckTiles
                            	  4393: __far_z_07_0053:
                            	  4394:     ; Moving direction = 0.
                            	  4395:     ; If object is the player, return.
                            	  4396:     ;
02:0004BF3C 4A02            	  4397:     cmpi.b  #$00,D2
02:0004BF3E 6604            	  4398:     bne.s  __far_z_07_0054
02:0004BF40 6000008A        	  4399:     jmp  L1F148_Exit
                            	  4400: __far_z_07_0054:
                            	  4401:     ; Moving direction = 0.
                            	  4402:     ; The object is not the player.
                            	  4403:     ;
                            	  4404:     ; If object does not have attribute $10, then
                            	  4405:     ; set movement direction to input direction,
                            	  4406:     ; and go try to turn to an unblocked direction in order to move.
                            	  4407:     ;
02:0004BF44 41EC04BF        	  4408:     lea     ($04BF,A4),A0
02:0004BF48 10302000        	  4409:     move.b  (A0,D2.W),D0
02:0004BF4C 02000010        	  4410:     andi.b #$10,D0
02:0004BF50 6702            	  4411:     beq.s  __far_z_07_0055
02:0004BF52 600E            	  4412:     jmp  Reverse
                            	  4413: __far_z_07_0055:
02:0004BF54 41EC03F8        	  4414:     lea     ($03F8,A4),A0
02:0004BF58 10302000        	  4415:     move.b  (A0,D2.W),D0
02:0004BF5C 1940000F        	  4416:     move.b  D0,($000F,A4)
02:0004BF60 6038            	  4417:     jmp     TryNextDir
                            	  4418: 
                            	  4419:     even
                            	  4420: Reverse:
                            	  4421:     ; UNKNOWN:
                            	  4422:     ; This seems to be unused code triggered by object attribute $10.
                            	  4423:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4424:     ;
02:0004BF62 6100016C        	  4425:     jsr     ReverseObjDir
02:0004BF66 60000104        	  4426:     jmp     CheckBoundary
                            	  4427: 
                            	  4428:     even
                            	  4429: CheckTiles:
                            	  4430:     ifne TURBO_LINK
                            	  4431:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4432:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004BF6A 4A02            	  4433:     tst.b   D2
02:0004BF6C 6608            	  4434:     bne.s   _L_z07_CheckTiles_notLink
02:0004BF6E 197C0024049E    	  4435:     move.b  #$24,($049E,A4)
02:0004BF74 605E            	  4436:     jmp     GoWalkableDir
                            	  4437: _L_z07_CheckTiles_notLink:
                            	  4438:     endc
                            	  4439:     ; The code below applies to Link and other objects.
                            	  4440:     ;
                            	  4441:     ; Test the moving direction's walkability.
                            	  4442:     ;
                            	  4443:     ; For the player, this is enough. For other objects, this 
                            	  4444:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4445:     ;
                            	  4446:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4447:     ;
02:0004BF76 6100F9D4        	  4448:     jsr     GetCollidingTileMoving
02:0004BF7A 122C034A        	  4449:     move.b  ($034A,A4),D1
02:0004BF7E B001            	  4450:     cmp.b   D1,D0
02:0004BF80 6402            	  4451:     bcc.s  __far_z_07_0056
02:0004BF82 6050            	  4452:     jmp  GoWalkableDir
                            	  4453: __far_z_07_0056:
                            	  4454:     ; The colliding tile is unwalkable.
                            	  4455:     ;
                            	  4456:     ; If object is the player, then go check passive tile objects and
                            	  4457:     ; the screen edge, or stop moving.
                            	  4458:     ;
02:0004BF84 4A02            	  4459:     cmpi.b  #$00,D2
02:0004BF86 6602            	  4460:     bne.s  __far_z_07_0057
02:0004BF88 6022            	  4461:     jmp  PlayerUnwalkable
                            	  4462: __far_z_07_0057:
                            	  4463:     even
                            	  4464: CheckObjAttr10AndAltDir:
                            	  4465:     ; Not the player.
                            	  4466:     ; If object attribute has $10, go to the unused code above
                            	  4467:     ; to reverse direction.
                            	  4468:     ;
02:0004BF8A 41EC04BF        	  4469:     lea     ($04BF,A4),A0
02:0004BF8E 10302000        	  4470:     move.b  (A0,D2.W),D0
02:0004BF92 02000010        	  4471:     andi.b #$10,D0
02:0004BF96 6702            	  4472:     beq.s  __far_z_07_0058
02:0004BF98 60C8            	  4473:     jmp  Reverse
                            	  4474: __far_z_07_0058:
                            	  4475:     even
                            	  4476: TryNextDir:
                            	  4477:     ; Get the next direction to check, and set moving direction to it.
                            	  4478:     ; If not at the end of the loop, go test the new direction's walkability.
                            	  4479:     ;
02:0004BF9A 610000E6        	  4480:     jsr     Walker_GetNextAltDir
02:0004BF9E 1940000F        	  4481:     move.b  D0,($000F,A4)
02:0004BFA2 102C000E        	  4482:     move.b  ($000E,A4),D0
02:0004BFA6 6702            	  4483:     beq.s  __far_z_07_0059
02:0004BFA8 60C0            	  4484:     jmp  CheckTiles
                            	  4485: __far_z_07_0059:
02:0004BFAA 4E75            	  4486:     rts
                            	  4487: 
                            	  4488:     even
                            	  4489: PlayerUnwalkable:
                            	  4490:     ; Tile is not walkable. Object is player.
                            	  4491:     ;
                            	  4492:     ; Check passive tile objects and the screen edge, and stop moving.
                            	  4493:     ;
                            	  4494:     ; First, if in OW, check passive tile objects (armos and regular gravestone).
                            	  4495:     ;
02:0004BFAC 102C0010        	  4496:     move.b  ($0010,A4),D0
02:0004BFB0 660C            	  4497:     bne  _L_z07_PlayerUnwalkable_StopMoving
02:0004BFB2 7001            	  4498:     moveq   #1,D0
02:0004BFB4 61001B96        	  4499:     jsr     SwitchBank
02:0004BFB8 4EB900030064    	  4500:     jsr     CheckPassiveTileObjects
                            	  4501:     even
                            	  4502: _L_z07_PlayerUnwalkable_StopMoving:
                            	  4503:     ; Reset moving direction and buttons pressed.
                            	  4504:     ; If in UW, we're done.
                            	  4505:     ; In OW, go check the screen edge.
                            	  4506:     ;
02:0004BFBE 610E            	  4507:     jsr     ResetMovingDir
02:0004BFC0 194000F8        	  4508:     move.b  D0,($00F8,A4)
02:0004BFC4 102C0010        	  4509:     move.b  ($0010,A4),D0
02:0004BFC8 6602            	  4510:     bne.s  __far_z_07_0060
02:0004BFCA 6008            	  4511:     jmp  GoWalkableDir
                            	  4512: __far_z_07_0060:
                            	  4513:     even
                            	  4514: L1F148_Exit:
02:0004BFCC 4E75            	  4515:     rts
                            	  4516: 
                            	  4517: ; Returns:
                            	  4518: ; A: 0
                            	  4519: ; [0F]: 0
                            	  4520: ;
                            	  4521:     even
                            	  4522: ResetMovingDir:
02:0004BFCE 4EF90002B780    	  4523:     jmp     c_reset_moving_dir
                            	  4524: 
                            	  4525: GoWalkableDir:
                            	  4526:     ; If object is not Link, then the tile is walkable. Go see if this direction
                            	  4527:     ; makes the object cross a boundary. Then go check another direction if it does,
                            	  4528:     ; or else make this the object direction.
                            	  4529:     ;
02:0004BFD4 4A02            	  4530:     cmpi.b  #$00,D2
02:0004BFD6 6704            	  4531:     beq.s  __far_z_07_0061
02:0004BFD8 60000092        	  4532:     jmp  CheckBoundary
                            	  4533: __far_z_07_0061:
                            	  4534:     ; The object is Link. We end up here regardless of walkability.
                            	  4535:     ;
                            	  4536:     ; If not in mode 5 or ladder is in use, return.
                            	  4537:     ;
02:0004BFDC 102C0012        	  4538:     move.b  ($0012,A4),D0
02:0004BFE0 0C000005        	  4539:     cmpi.b  #$05,D0
02:0004BFE4 6704            	  4540:     beq.s  __far_z_07_0062
02:0004BFE6 60000080        	  4541:     jmp  ExitX0
                            	  4542: __far_z_07_0062:
02:0004BFEA 102C0064        	  4543:     move.b  ($0064,A4),D0
