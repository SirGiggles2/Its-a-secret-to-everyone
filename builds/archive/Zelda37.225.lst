02:0003E790 E209            	 11247:     lsr.b  #1,D1   ; LSR $00
02:0003E792 1881            	 11248:     move.b  D1,($0000,A4)
02:0003E794 123C0000        	 11249:     move.b  #$00,D1
02:0003E798 D101            	 11250:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E79A 5303            	 11251:     subq.b  #1,D3
02:0003E79C 66F0            	 11252:     bne  _anon_z04_143
