                            	 11921: _L_z04_UpdateLamnola_FindTail:
02:0003ECBE 5203            	 11922:     addq.b  #1,D3
02:0003ECC0 41EC0350        	 11923:     lea     ($0350,A4),A0
02:0003ECC4 10303000        	 11924:     move.b  (A0,D3.W),D0
02:0003ECC8 122C04E7        	 11925:     move.b  ($04E7,A4),D1
