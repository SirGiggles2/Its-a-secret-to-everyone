                            	  6166: __far_z_05_0094:
                            	  6167:     ; Turn the door command into the desired open or closed state
                            	  6168:     ; to store in [08].
                            	  6169:     ;
                            	  6170:     ; cmd:  7 6 3 2 
                            	  6171:     ; [08]: 2 0 0 0
                            	  6172:     ;
                            	  6173:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6174:     ; commands intended to be used.
                            	  6175:     ;
                            	  6176:     ; 3 is the end state of 2: close
                            	  6177:     ; 7 is the end state of 6: open
                            	  6178:     ;
02:00043A3A 02000007        	  6179:     andi.b #$07,D0
02:00043A3E 7601            	  6180:     moveq   #1,D3
02:00043A40 19430002        	  6181:     move.b  D3,($0002,A4)
02:00043A44 122C0002        	  6182:     move.b  ($0002,A4),D1
02:00043A48 C200            	  6183:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043A4A 6702            	  6184:     beq  _anon_z05_118
02:00043A4C E208            	  6185:     lsr.b  #1,D0   ; LSR A
                            	  6186: _anon_z05_118:
02:00043A4E 0C000002        	  6187:     cmpi.b  #$02,D0
02:00043A52 6606            	  6188:     bne  _anon_z05_119
                            	  6189:     ; Command 2 sets Link's timer to $30.
                            	  6190:     ;
02:00043A54 7630            	  6191:     moveq   #48,D3
02:00043A56 19430028        	  6192:     move.b  D3,($0028,A4)
                            	  6193: _anon_z05_119:
02:00043A5A 02000003        	  6194:     andi.b #$03,D0
02:00043A5E 003C0011        	  6195:     ori     #$11,CCR  ; SEC: set C+X
02:00043A62 123C0001        	  6196:     move.b  #$01,D1
02:00043A66 0A3C0010        	  6197:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A6A 9101            	  6198:     subx.b  D1,D0   ; SBC #$01
02:00043A6C 0A3C0010        	  6199:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A70 02000002        	  6200:     andi.b #$02,D0
02:00043A74 19400008        	  6201:     move.b  D0,($0008,A4)
                            	  6202:     ; The command to close a key door or bombable wall does not
                            	  6203:     ; do anything.
                            	  6204:     ;
