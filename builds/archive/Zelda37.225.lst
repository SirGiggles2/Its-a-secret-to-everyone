                            	   997: __far_z_04_0011:
                            	   998:     ; If object type < $55 (like flying rock $53), then
                            	   999:     ; check for tile collision in addition to other checks.
                            	  1000:     ;
02:00039D74 41EC034F        	  1001:     lea     ($034F,A4),A0
02:00039D78 10302000        	  1002:     move.b  (A0,D2.W),D0
02:00039D7C 0C000055        	  1003:     cmpi.b  #$55,D0
02:00039D80 6418            	  1004:     bcc  _L_z04_UpdateMonsterShot_CheckBoundary
                            	  1005:     ; Additionally, if the flying rock is held back by a timer, then
                            	  1006:     ; only check for collision with Link.
                            	  1007:     ;
02:00039D82 10342028        	  1008:     move.b  ($28,A4,D2.W),D0
02:00039D86 6622            	  1009:     bne  _L_z04_UpdateMonsterShot_CheckLinkCollision
                            	  1010:     ; If the flying rock hit a tile or room boundary, then go destroy it.
                            	  1011:     ;
