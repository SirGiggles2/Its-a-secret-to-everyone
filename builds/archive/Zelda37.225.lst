02:0003B248 16302000        	  3997:     move.b  (A0,D2.W),D3
                            	  3998:     ; If facing up, then use the second frame image in the set ("back").
                            	  3999:     ; Else use the second.
                            	  4000:     ;
02:0003B24C 0C030008        	  4001:     cmpi.b  #$08,D3
02:0003B250 6602            	  4002:     bne  _anon_z04_54
02:0003B252 7001            	  4003:     moveq   #1,D0
                            	  4004: _anon_z04_54:
