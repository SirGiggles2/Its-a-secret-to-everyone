02:0004CC18 1214            	  6287:     move.b  ($0000,A4),D1
02:0004CC1A D101            	  6288:     addx.b  D1,D0   ; ADC $00
02:0004CC1C 7600            	  6289:     moveq   #0,D3
02:0004CC1E 1600            	  6290:     move.b  D0,D3
