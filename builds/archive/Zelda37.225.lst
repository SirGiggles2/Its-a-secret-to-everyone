                            	  5808:     even
                            	  5809: L_LayOutDoors_LoopDoors:
                            	  5810:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5811:     ;
02:00043810 7001            	  5812:     moveq   #1,D0
                            	  5813:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5814:     ;
                            	  5815:     ; [06] indicates whether we're handling the first half of
                            	  5816:     ; the door: Left half for N/S, Top half for E/W.
                            	  5817:     ;
02:00043812 19400006        	  5818:     move.b  D0,($0006,A4)
                            	  5819:     even
                            	  5820: L_LayOutDoors_LoopHalves:
