                            	 14253:     ; Combine it with the horizontal component:
                            	 14254:     ;
                            	 14255:     ; Y := 4 (down)
                            	 14256:     ; if observed player Y <> object Y then
                            	 14257:     ;   if observed player Y < object Y then
                            	 14258:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 14259:     ;   [00] := [00] | Y
                            	 14260:     ;
02:0003FD18 7601            	 14261:     moveq   #1,D3
02:0003FD1A 102C0062        	 14262:     move.b  ($0062,A4),D0
02:0003FD1E 41EC0084        	 14263:     lea     ($0084,A4),A0
