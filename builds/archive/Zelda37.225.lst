02:0003B162 194000AB        	  3848:     move.b  D0,($00AB,A4)
                            	  3849:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3850:     ;
                            	  3851:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3852:     ;
                            	  3853:     ; Note that, if the item was already taken, then the room item
                            	  3854:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3855:     ; it will be ignored, because that routine checks whether
                            	  3856:     ; the item was taken.
