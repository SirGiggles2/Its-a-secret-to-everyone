                            	 12430: __far_z_04_0125:
                            	 12431:     ; State = 0.
                            	 12432:     ;
                            	 12433:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12434:     ; This is the only patra child shown in the first fame.
                            	 12435:     ;
02:0003F04E 0C020002        	 12436:     cmpi.b  #$02,D2
02:0003F052 6732            	 12437:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12438:     ; The patra child in slot 2 is the last one to be updated.
                            	 12439:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12440:     ;
                            	 12441:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12442:     ; shown.
                            	 12443:     ;
02:0003F054 102C00AE        	 12444:     move.b  ($00AE,A4),D0
02:0003F058 6700008E        	 12445:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12446:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12447:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12448:     ;
02:0003F05C 1002            	 12449:     move.b  D2,D0
                            	 12450:     ; Subtract 3 from the object slot to get the angle where the
                            	 12451:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12452:     ;
02:0003F05E 003C0011        	 12453:     ori     #$11,CCR  ; SEC: set C+X
02:0003F062 123C0003        	 12454:     move.b  #$03,D1
02:0003F066 0A3C0010        	 12455:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F06A 9101            	 12456:     subx.b  D1,D0   ; SBC #$03
02:0003F06C 0A3C0010        	 12457:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F070 7600            	 12458:     moveq   #0,D3
02:0003F072 1600            	 12459:     move.b  D0,D3
                            	 12460:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12461:     ; then return.
                            	 12462:     ;
02:0003F074 102C0396        	 12463:     move.b  ($0396,A4),D0
02:0003F078 41F90003F032    	 12464:     lea     (PatraChildStartAngles).l,A0
02:0003F07E 12303000        	 12465:     move.b  (A0,D3.W),D1
02:0003F082 B001            	 12466:     cmp.b   D1,D0
02:0003F084 6662            	 12467:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12468:     even
