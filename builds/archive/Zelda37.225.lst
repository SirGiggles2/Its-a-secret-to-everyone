                            	  6798:     ; Unpack the damage points for the monster's type.
                            	  6799:     ; The low nibble is the high byte.
                            	  6800:     ; (Damage points byte AND $F0) is the low byte.
                            	  6801:     ;
02:00031CC2 7600            	  6802:     moveq   #0,D3
