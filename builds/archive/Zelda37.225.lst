02:00041AFA 7600            	  3177:     moveq   #0,D3
02:00041AFC 1600            	  3178:     move.b  D0,D3
                            	  3179:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3180:     ; boundary using player's direction and reverse direction index.
                            	  3181:     ;
02:00041AFE 102C0001        	  3182:     move.b  ($0001,A4),D0
