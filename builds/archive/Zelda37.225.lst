                            	  2345: ; Params:
                            	  2346: ; A: Y coordinate
                            	  2347: ; X: object index
                            	  2348: ;
                            	  2349:     even
                            	  2350: InitWhirlwind:
02:0002FD14 6000BF34        	  2351:     jmp     c_init_whirlwind
                            	  2352: 
                            	  2353: SetUpWhirlwind:
02:0002FD18 6000BCE0        	  2354:     jmp     c_set_up_whirlwind
                            	  2355: 
                            	  2356: WhirlwindPrevRoomIdList:
02:0002FD1C 36              	  2357:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FD1D 3B
02:0002FD1E 73
02:0002FD1F 44
02:0002FD20 0A
02:0002FD21 21
02:0002FD22 41
02:0002FD23 6C
                            	  2358: 
                            	  2359:     even
                            	  2360: UpdateWhirlwind_Full:
                            	  2361:     ; Get Link's halted state.
                            	  2362:     ;
02:0002FD24 102C00AC        	  2363:     move.b  ($00AC,A4),D0
02:0002FD28 02000040        	  2364:     andi.b #$40,D0
02:0002FD2C 7600            	  2365:     moveq   #0,D3
02:0002FD2E 1600            	  2366:     move.b  D0,D3
                            	  2367:     ; Add 2 to whirlwind X.
                            	  2368:     ;
02:0002FD30 7002            	  2369:     moveq   #2,D0
02:0002FD32 023C00EE        	  2370:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FD36 12342070        	  2371:     move.b  ($70,A4,D2.W),D1
02:0002FD3A D101            	  2372:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FD3C 19802070        	  2373:     move.b  D0,($70,A4,D2.W)
                            	  2374:     ; If Link is not halted or teleporting state = 0, then
                            	  2375:     ; go check for collision with Link.
                            	  2376:     ;
02:0002FD40 0C030040        	  2377:     cmpi.b  #$40,D3
02:0002FD44 6638            	  2378:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FD46 7600            	  2379:     moveq   #0,D3
02:0002FD48 162C0522        	  2380:     move.b  ($0522,A4),D3
02:0002FD4C 6730            	  2381:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2382:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2383:     ;
                            	  2384:     ; Set Link's X to whirlwind's.
                            	  2385:     ;
02:0002FD4E 19400070        	  2386:     move.b  D0,($0070,A4)
                            	  2387:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2388:     ; the right screen edge and draw.
                            	  2389:     ;
02:0002FD52 5303            	  2390:     subq.b  #1,D3
02:0002FD54 6776            	  2391:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FD56 0C000080        	  2392:     cmpi.b  #$80,D0
02:0002FD5A 6670            	  2393:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2394:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2395:     ;
                            	  2396:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2397:     ;
02:0002FD5C E308            	  2398:     lsl.b  #1,D0   ; ASL A
02:0002FD5E 194000AC        	  2399:     move.b  D0,($00AC,A4)
02:0002FD62 19400522        	  2400:     move.b  D0,($0522,A4)
02:0002FD66 41EC034F        	  2401:     lea     ($034F,A4),A0
02:0002FD6A 11802000        	  2402:     move.b  D0,(A0,D2.W)
                            	  2403:     ; Update the player position marker, and draw one last time.
                            	  2404:     ;
02:0002FD6E 1002            	  2405:     move.b  D2,D0
02:0002FD70 1B00            	  2406:     move.b  D0,-(A5)  ; PHA
02:0002FD72 610010F6        	  2407:     jsr     UpdatePlayerPositionMarker
02:0002FD76 101D            	  2408:     move.b  (A5)+,D0  ; PLA
02:0002FD78 7400            	  2409:     moveq   #0,D2
02:0002FD7A 1400            	  2410:     move.b  D0,D2
02:0002FD7C 6070            	  2411:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2412: 
                            	  2413:     even
                            	  2414: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2415:     ; Link is not halted or teleporting state = 0.
                            	  2416:     ; Try to pick up Link.
                            	  2417:     ;
                            	  2418:     ; If the whirlwind does not collide with Link, then go check
                            	  2419:     ; for the screen's right edge.
                            	  2420:     ;
02:0002FD7E 61001E0C        	  2421:     jsr     CheckLinkCollision
02:0002FD82 102C0006        	  2422:     move.b  ($0006,A4),D0
02:0002FD86 6744            	  2423:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2424:     ; Collided with Link.
                            	  2425:     ;
                            	  2426:     ; Make Link face right. Reset shove info and subroom type.
                            	  2427:     ;
02:0002FD88 7001            	  2428:     moveq   #1,D0
02:0002FD8A 19400098        	  2429:     move.b  D0,($0098,A4)
02:0002FD8E E208            	  2430:     lsr.b  #1,D0   ; LSR A
02:0002FD90 194000C0        	  2431:     move.b  D0,($00C0,A4)
02:0002FD94 194000D3        	  2432:     move.b  D0,($00D3,A4)
02:0002FD98 1940005A        	  2433:     move.b  D0,($005A,A4)
                            	  2434:     ; Halt Link (state $40), and hide him.
                            	  2435:     ;
02:0002FD9C 7040            	  2436:     moveq   #64,D0
02:0002FD9E 194000AC        	  2437:     move.b  D0,($00AC,A4)
