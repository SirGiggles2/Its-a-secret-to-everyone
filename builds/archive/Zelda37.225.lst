                            	  6348: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6349:     ; The weapon is the sword.
                            	  6350:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6351:     ;
02:0004CCA2 023C00EE        	  6352:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CCA6 122C0657        	  6353:     move.b  ($0657,A4),D1
02:0004CCAA D101            	  6354:     addx.b  D1,D0   ; ADC Items
02:0004CCAC 003C0011        	  6355:     ori     #$11,CCR  ; SEC: set C+X
02:0004CCB0 123C0001        	  6356:     move.b  #$01,D1
