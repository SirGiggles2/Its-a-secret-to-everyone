                            	  6176: 
                            	  6177: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  6178: ; Each set contains 4 offsets in reverse direction index order:
                            	  6179: ; up, down, left, right
                            	  6180: ;
                            	  6181: ; These offsets are added to player X to get weapon X.
                            	  6182: ;
                            	  6183:     even
                            	  6184: PlayerToWeaponOffsetsX:
02:0004CB54 FF              	  6185:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004CB55 01
02:0004CB56 00
02:0004CB57 F8
02:0004CB58 FF
02:0004CB59 01
