02:0002E23A 6528            	   867:     bcs  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_CheckPickUp
                            	   868:     ; Advance to the end state, where the person is still shown.
                            	   869:     ;
02:0002E23C 7008            	   870:     moveq   #8,D0
02:0002E23E 194000AD        	   871:     move.b  D0,($00AD,A4)
                            	   872:     ; If this is not the "door charge" old man, then return.
                            	   873:     ; The person only talks.
