                            	  8025: UpdatePolsVoiceState1_Jumping:
                            	  8026:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8027:     ;
02:0003CF68 41EC0444        	  8028:     lea     ($0444,A4),A0
02:0003CF6C 10302000        	  8029:     move.b  (A0,D2.W),D0
02:0003CF70 023C00EE        	  8030:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF74 123C0038        	  8031:     move.b  #$38,D1
02:0003CF78 D101            	  8032:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CF7A 41EC0444        	  8033:     lea     ($0444,A4),A0
02:0003CF7E 11802000        	  8034:     move.b  D0,(A0,D2.W)
                            	  8035:     ; Add Carry to high speed byte (vertical).
                            	  8036:     ;
02:0003CF82 41EC0412        	  8037:     lea     ($0412,A4),A0
02:0003CF86 10302000        	  8038:     move.b  (A0,D2.W),D0
02:0003CF8A 123C0000        	  8039:     move.b  #$00,D1
02:0003CF8E D101            	  8040:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CF90 41EC0412        	  8041:     lea     ($0412,A4),A0
02:0003CF94 11802000        	  8042:     move.b  D0,(A0,D2.W)
                            	  8043:     ; Add high speed byte to Y coordinate.
                            	  8044:     ;
02:0003CF98 023C00EE        	  8045:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF9C 41EC0084        	  8046:     lea     ($0084,A4),A0
