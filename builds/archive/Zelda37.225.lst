02:00043CA8 4EB90002A9FA    	  6513:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00043CAE 6100739A        	  6514:     jsr     GetUniqueRoomId
02:00043CB2 1B00            	  6515:     move.b  D0,-(A5)  ; PHA
02:00043CB4 7000            	  6516:     moveq   #0,D0
