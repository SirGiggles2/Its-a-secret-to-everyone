                            	 13208: Ganon_CheckCollisions:
                            	 13209:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13210:     ; Store in [02] and [03].
                            	 13211:     ;
02:0003F5C4 10342070        	 13212:     move.b  ($70,A4,D2.W),D0
02:0003F5C8 023C00EE        	 13213:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5CC 123C0010        	 13214:     move.b  #$10,D1
02:0003F5D0 D101            	 13215:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5D2 19400002        	 13216:     move.b  D0,($0002,A4)
02:0003F5D6 41EC0084        	 13217:     lea     ($0084,A4),A0
02:0003F5DA 10302000        	 13218:     move.b  (A0,D2.W),D0
02:0003F5DE 023C00EE        	 13219:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5E2 123C0010        	 13220:     move.b  #$10,D1
02:0003F5E6 D101            	 13221:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F5E8 19400003        	 13222:     move.b  D0,($0003,A4)
                            	 13223:     ; Check for a collision with Link.
                            	 13224:     ;
                            	 13225:     ; We can't call CheckLinkCollision, because we need to
                            	 13226:     ; customize Ganon's midpoint.
                            	 13227:     ;
                            	 13228:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13229:     ; detection, if Link is invincible. Initialize variables that will
                            	 13230:     ; be returned from the partial collision check routine. Then
                            	 13231:     ; call it.
                            	 13232:     ;
02:0003F5EC 102C04F0        	 13233:     move.b  ($04F0,A4),D0
02:0003F5F0 6616            	 13234:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F5F2 19400006        	 13235:     move.b  D0,($0006,A4)
02:0003F5F6 19400009        	 13236:     move.b  D0,($0009,A4)
02:0003F5FA 1940000C        	 13237:     move.b  D0,($000C,A4)
02:0003F5FE 7600            	 13238:     moveq   #0,D3
02:0003F600 1883            	 13239:     move.b  D3,($0000,A4)
02:0003F602 4EB900031BC2    	 13240:     jsr     CheckLinkCollisionPreinit
                            	 13241:     even
                            	 13242: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13243:     ; If Ganon is not in state 0, then he's brown.
                            	 13244:     ; Go check collision with an arrow.
                            	 13245:     ;
02:0003F608 41EC00AC        	 13246:     lea     ($00AC,A4),A0
02:0003F60C 10302000        	 13247:     move.b  (A0,D2.W),D0
02:0003F610 6652            	 13248:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13249:     ; If timer <> 0, then Ganon is visible.
                            	 13250:     ; He can't be harmed like this. So, return.
                            	 13251:     ;
02:0003F612 10342028        	 13252:     move.b  ($28,A4,D2.W),D0
02:0003F616 664A            	 13253:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F618 760D            	 13254:     moveq   #13,D3
02:0003F61A 4EB90003208C    	 13255:     jsr     CheckMonsterSwordCollision
                            	 13256:     ; If Ganon has died according to the usual collision check rules
                            	 13257:     ; (HP = 0), then:
                            	 13258:     ; 1. Restore HP to the initial value $F0
                            	 13259:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13260:     ; 3. Change palette row 7 to make Ganon brown
                            	 13261:     ;
02:0003F620 41EC0405        	 13262:     lea     ($0405,A4),A0
02:0003F624 10302000        	 13263:     move.b  (A0,D2.W),D0
02:0003F628 6718            	 13264:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F62A 103C00F0        	 13265:     move.b  #$F0,D0
02:0003F62E 41EC0485        	 13266:     lea     ($0485,A4),A0
02:0003F632 11802000        	 13267:     move.b  D0,(A0,D2.W)
02:0003F636 41EC00AC        	 13268:     lea     ($00AC,A4),A0
02:0003F63A 53302000        	 13269:     subq.b  #1,(A0,D2.W)
02:0003F63E 61000084        	 13270:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13271:     even
                            	 13272: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13273:     ; If Ganon was harmed, then play the sound effect
                            	 13274:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13275:     ;
02:0003F642 41EC04F0        	 13276:     lea     ($04F0,A4),A0
02:0003F646 10302000        	 13277:     move.b  (A0,D2.W),D0
02:0003F64A 670A            	 13278:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F64C 6100A144        	 13279:     jsr     PlayBossHitCryIfNeeded
02:0003F650 7040            	 13280:     moveq   #64,D0
02:0003F652 19802028        	 13281:     move.b  D0,($28,A4,D2.W)
                            	 13282:     even
                            	 13283: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13284:     ; Reset metastate, because Ganon cannot die this way.
                            	 13285:     ;
02:0003F656 4EB90004D9F8    	 13286:     jsr     ResetObjMetastate
                            	 13287:     ; Reset shove info and invincibility timer, because Ganon
                            	 13288:     ; doesn't react at all as a usual monster.
                            	 13289:     ;
02:0003F65C 4EB900031F94    	 13290:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13291:     even
                            	 13292: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F662 4E75            	 13293:     rts
                            	 13294: 
                            	 13295:     even
                            	 13296: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13297:     ; If the silver arrow is not in the inventory, then return.
                            	 13298:     ;
02:0003F664 102C0659        	 13299:     move.b  ($0659,A4),D0
02:0003F668 0C000002        	 13300:     cmpi.b  #$02,D0
02:0003F66C 66F4            	 13301:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13302:     ; Reset the collision return value [06].
                            	 13303:     ;
02:0003F66E 7000            	 13304:     moveq   #0,D0
02:0003F670 19400006        	 13305:     move.b  D0,($0006,A4)
                            	 13306:     ; If there's no arrow in flight, then return.
                            	 13307:     ;
02:0003F674 7612            	 13308:     moveq   #18,D3
02:0003F676 41EC00AC        	 13309:     lea     ($00AC,A4),A0
02:0003F67A 10303000        	 13310:     move.b  (A0,D3.W),D0
02:0003F67E 0C000010        	 13311:     cmpi.b  #$10,D0
02:0003F682 66DE            	 13312:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13313:     ; Check for collision with an arrow; and return if no collision.
                            	 13314:     ;
02:0003F684 4EB9000320E8    	 13315:     jsr     CheckMonsterArrowOrRodCollision
02:0003F68A 102C0006        	 13316:     move.b  ($0006,A4),D0
02:0003F68E 67D2            	 13317:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13318:     ; Set the Ganon phase to "dying".
                            	 13319:     ;
02:0003F690 41EC042C        	 13320:     lea     ($042C,A4),A0
02:0003F694 52302000        	 13321:     addq.b  #1,(A0,D2.W)
                            	 13322:     ; Now his body does flash.
                            	 13323:     ;
02:0003F698 7028            	 13324:     moveq   #40,D0
02:0003F69A 41EC04F0        	 13325:     lea     ($04F0,A4),A0
02:0003F69E 11802000        	 13326:     move.b  D0,(A0,D2.W)
                            	 13327:     ; Set initial cloud distance 8.
                            	 13328:     ;
02:0003F6A2 7008            	 13329:     moveq   #8,D0
02:0003F6A4 41EC0478        	 13330:     lea     ($0478,A4),A0
02:0003F6A8 11802000        	 13331:     move.b  D0,(A0,D2.W)
02:0003F6AC 0A3C0001        	 13332:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F6B0 4E75            	 13333:     rts
                            	 13334: 
                            	 13335:     even
