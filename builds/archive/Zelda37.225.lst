                            	   195: InitCave:
                            	   196:     ; The person goes at location ($78, $80).
                            	   197:     ;
02:0002DD92 7078            	   198:     moveq   #120,D0
02:0002DD94 163C0080        	   199:     move.b  #$80,D3
02:0002DD98 610001A0        	   200:     jsr     SetUpCommonCaveObjects
                            	   201:     ; If the cave/person does not remember state (give item, door charge),
                            	   202:     ; then go handle other kinds.
                            	   203:     ;
02:0002DD9C 102C0350        	   204:     move.b  ($0350,A4),D0
02:0002DDA0 0C000072        	   205:     cmpi.b  #$72,D0
02:0002DDA4 6714            	   206:     beq  _L_z01_InitCave_TakeType
02:0002DDA6 0C000071        	   207:     cmpi.b  #$71,D0
02:0002DDAA 670E            	   208:     beq  _L_z01_InitCave_TakeType
02:0002DDAC 0C00007B        	   209:     cmpi.b  #$7B,D0
02:0002DDB0 6408            	   210:     bcc  _L_z01_InitCave_TakeType
02:0002DDB2 0C00006E        	   211:     cmpi.b  #$6E,D0
02:0002DDB6 6502            	   212:     bcs.s  __far_z_01_0000
02:0002DDB8 6012            	   213:     jmp  InitCaveContinue
                            	   214: __far_z_01_0000:
                            	   215:     even
                            	   216: _L_z01_InitCave_TakeType:
                            	   217:     ; Else the cave/person simply does:
                            	   218:     ; - taken:     no person, no text
                            	   219:     ; - not taken: show a person and text
                            	   220:     ;
                            	   221:     ; So, if the item was not taken, then go set up the text.
                            	   222:     ;
02:0002DDBA 61003268        	   223:     jsr     GetRoomFlagUWItemState
02:0002DDBE 6602            	   224:     bne.s  __far_z_01_0001
02:0002DDC0 600A            	   225:     jmp  InitCaveContinue
                            	   226: __far_z_01_0001:
                            	   227:     ; Otherwise destroy the person object, and let Link continue.
                            	   228:     ;
02:0002DDC2 7000            	   229:     moveq   #0,D0
02:0002DDC4 19400350        	   230:     move.b  D0,($0350,A4)
                            	   231:     even
                            	   232: UnhaltLink:
02:0002DDC8 6000DC24        	   233:     jmp     c_unhalt_link
                            	   234: 
                            	   235: InitCaveContinue:
                            	   236:     ; Get this cave's index (object type - $6A).
                            	   237:     ;
02:0002DDCC 102C0350        	   238:     move.b  ($0350,A4),D0
02:0002DDD0 003C0011        	   239:     ori     #$11,CCR  ; SEC: set C+X
02:0002DDD4 123C006A        	   240:     move.b  #$6A,D1
02:0002DDD8 0A3C0010        	   241:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002DDDC 9101            	   242:     subx.b  D1,D0   ; SBC #$6A
02:0002DDDE 0A3C0010        	   243:     eori    #$10,CCR  ; restore X = 6502 C
02:0002DDE2 7600            	   244:     moveq   #0,D3
02:0002DDE4 1600            	   245:     move.b  D0,D3
                            	   246:     ; Get the person text selector by looking up the text selector byte
                            	   247:     ; for this index, and masking it with $3F.
                            	   248:     ;
02:0002DDE6 41F90002DD64    	   249:     lea     (OverworldPersonTextSelectors).l,A0
02:0002DDEC 10303000        	   250:     move.b  (A0,D3.W),D0
02:0002DDF0 1B00            	   251:     move.b  D0,-(A5)  ; PHA
02:0002DDF2 0200003F        	   252:     andi.b #$3F,D0
02:0002DDF6 19400415        	   253:     move.b  D0,($0415,A4)
                            	   254:     ; Pop and mask the text selector byte with $C0 to get the
                            	   255:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   256:     ;
02:0002DDFA 101D            	   257:     move.b  (A5)+,D0  ; PLA
02:0002DDFC 020000C0        	   258:     andi.b #$C0,D0
02:0002DE00 19400003        	   259:     move.b  D0,($0003,A4)
                            	   260:     ; At this point, the Y register still has the cave index.
