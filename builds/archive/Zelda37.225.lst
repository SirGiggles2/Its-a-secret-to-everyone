                            	  5925: _anon_z04_81:
                            	  5926:     ; Chase while flying, as usual.
                            	  5927:     ;
02:0003C0AC 61003C32        	  5928:     jsr     Flyer_Chase
                            	  5929:     ; If timer has not expired, then
                            	  5930:     ; go see if it's time to propagate direction changes down the chain.
                            	  5931:     ;
02:0003C0B0 10342028        	  5932:     move.b  ($28,A4,D2.W),D0
02:0003C0B4 6702            	  5933:     beq.s  __far_z_04_0045
02:0003C0B6 6032            	  5934:     jmp  Moldorm_PropagateDirs
                            	  5935: __far_z_04_0045:
                            	  5936:     even
                            	  5937: Moldorm_ChangeFlyingState:
                            	  5938:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5939:     ;
02:0003C0B8 61000096        	  5940:     jsr     Flyer_MoldormDecideState
02:0003C0BC 7010            	  5941:     moveq   #16,D0
02:0003C0BE 19802028        	  5942:     move.b  D0,($28,A4,D2.W)
                            	  5943:     ; If the next lower slot's direction <> 0, then
                            	  5944:     ; go propagate direction changes down the chain.
                            	  5945:     ;
                            	  5946:     ; But you had to have propagated directions once for the
                            	  5947:     ; next lower direction to be set. How does it happen?
                            	  5948:     ;
                            	  5949:     ; Within a flyer state, the flying routines turn the flyer
                            	  5950:     ; and set the object timer to $10 several times. After any of
                            	  5951:     ; those times will the test succeed.
                            	  5952:     ;
                            	  5953:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5954:     ; in this block to set the timer to $10, and try to propagate
                            	  5955:     ; directions.
                            	  5956:     ;
                            	  5957:     ; But this is also the case the first time here.
                            	  5958:     ;
                            	  5959:     ; So, I believe that the point of this test is to delay moving
                            	  5960:     ; the lower (not head) segments when starting out.
                            	  5961:     ;
02:0003C0C2 41EC0097        	  5962:     lea     ($0097,A4),A0
02:0003C0C6 10302000        	  5963:     move.b  (A0,D2.W),D0
02:0003C0CA 6702            	  5964:     beq.s  __far_z_04_0046
02:0003C0CC 601C            	  5965:     jmp  Moldorm_PropagateDirs
                            	  5966: __far_z_04_0046:
02:0003C0CE 4E75            	  5967:     rts
                            	  5968: 
                            	  5969:     even
                            	  5970: Moldorm_Wander:
                            	  5971:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5972:     ; Only the head controls the movement direction.
                            	  5973:     ;
02:0003C0D0 0C020005        	  5974:     cmpi.b  #$05,D2
02:0003C0D4 6708            	  5975:     beq  _anon_z04_82
02:0003C0D6 0C02000A        	  5976:     cmpi.b  #$0A,D2
02:0003C0DA 6702            	  5977:     beq.s  __far_z_04_0047
02:0003C0DC 6070            	  5978:     jmp  L1156B_Exit
                            	  5979: __far_z_04_0047:
                            	  5980: _anon_z04_82:
                            	  5981:     ; Turn randomly while flying, as usual.
                            	  5982:     ;
02:0003C0DE 61003CDE        	  5983:     jsr     Flyer_Wander
                            	  5984:     ; After every turn, the common flyer routines set timer to $10.
                            	  5985:     ; This can be used as a signal for moldorm to propagate
                            	  5986:     ; direction changes down the chain.
                            	  5987:     ;
                            	  5988:     ; Between each turn, timer <> $10.
                            	  5989:     ;
                            	  5990:     ; At the end of the delay after the last turn, timer = 0.
                            	  5991:     ; This is a signal that that flying state ended, and a new one
                            	  5992:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5993:     ; we can propagate direction changes again; and start
                            	  5994:     ; a new flying interval by setting timer to $10. This will make
                            	  5995:     ; the next flying state delay that amount of time before turning
                            	  5996:     ; the first time.
                            	  5997:     ;
                            	  5998:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5999:     ; arm the timer again, and shift directions down the chain.
                            	  6000:     ;
02:0003C0E2 10342028        	  6001:     move.b  ($28,A4,D2.W),D0
02:0003C0E6 6602            	  6002:     bne.s  __far_z_04_0048
02:0003C0E8 60CE            	  6003:     jmp  Moldorm_ChangeFlyingState
                            	  6004: __far_z_04_0048:
                            	  6005:     even
                            	  6006: Moldorm_PropagateDirs:
                            	  6007:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6008:     ;
02:0003C0EA 10342028        	  6009:     move.b  ($28,A4,D2.W),D0
02:0003C0EE 0C000010        	  6010:     cmpi.b  #$10,D0
02:0003C0F2 6702            	  6011:     beq.s  __far_z_04_0049
02:0003C0F4 6058            	  6012:     jmp  L1156B_Exit
