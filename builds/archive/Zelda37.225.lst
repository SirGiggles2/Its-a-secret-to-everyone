                            	 12626: UpdateGanon_JumpTable:
02:0003F1C2 0003F1CE        	 12627:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F1C6 0003F230        	 12628:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F1CA 0003F25E        	 12629:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12630: 
                            	 12631: ; Description:
                            	 12632: ; Lift up the Triforce of Courage while the room is dark.
                            	 12633: ;
                            	 12634: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12635: ;
                            	 12636:     even
                            	 12637: Ganon_ScenePhase0:
02:0003F1CE 701B            	 12638:     moveq   #27,D0
02:0003F1D0 19400505        	 12639:     move.b  D0,($0505,A4)
                            	 12640:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12641:     ;
02:0003F1D4 102C0028        	 12642:     move.b  ($0028,A4),D0
02:0003F1D8 6644            	 12643:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12644:     ; Once the timer expires, it's time to brighten the room.
                            	 12645:     ;
                            	 12646:     ; Save the current object slot.
02:0003F1DA 1002            	 12647:     move.b  D2,D0
