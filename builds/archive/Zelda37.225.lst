02:0003B33A 003C0011        	  4174:     ori     #$11,CCR  ; SEC: set C+X
02:0003B33E 123C0003        	  4175:     move.b  #$03,D1
02:0003B342 0A3C0010        	  4176:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B346 9101            	  4177:     subx.b  D1,D0   ; SBC #$03
02:0003B348 0A3C0010        	  4178:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B34C 7600            	  4179:     moveq   #0,D3
02:0003B34E 1600            	  4180:     move.b  D0,D3
02:0003B350 102C0396        	  4181:     move.b  ($0396,A4),D0
