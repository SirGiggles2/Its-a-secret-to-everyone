                            	  5468: ; Params:
                            	  5469: ; [02]: bitmask for target door.
                            	  5470: ;
                            	  5471: ; Returns:
                            	  5472: ; A: door attribute for desired direction in current room.
                            	  5473: ; [01]: same as [02] if found; $10 otherwise
                            	  5474: ; [03]: reverse direction index
                            	  5475: ;
                            	  5476: ; Door bits:
                            	  5477: ; 1: E
                            	  5478: ; 2: W
                            	  5479: ; 4: S
                            	  5480: ; 8: N
                            	  5481: ;
                            	  5482: ;
                            	  5483: ; Start with single-bit mask 1.
                            	  5484:     even
                            	  5485: FindDoorAttrByDoorBit:
02:00043578 7001            	  5486:     moveq   #1,D0
02:0004357A 19400001        	  5487:     move.b  D0,($0001,A4)
02:0004357E 7003            	  5488:     moveq   #3,D0
02:00043580 19400003        	  5489:     move.b  D0,($0003,A4)
                            	  5490:     even
