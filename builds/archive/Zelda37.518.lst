02:0003DF04 41F90003DDD4    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003DF0A 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003DF0E 8001            	  8451:     or.b  D1,D0
02:0003DF10 19400003        	  8452:     move.b  D0,($0003,A4)
