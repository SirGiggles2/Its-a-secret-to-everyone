02:0003F78E 4EB9000496AE    	  1565:     jsr     DrawSpritesBetweenRooms
02:0003F794 4EB9000496CC    	  1566:     jsr     ResetPlayerState
                            	  1567:     ; Reset [0300] to [051F].
                            	  1568:     ;
02:0003F79A 7005            	  1569:     moveq   #5,D0
02:0003F79C 761F            	  1570:     moveq   #31,D3
02:0003F79E 4EB900048F8E    	  1571:     jsr     ClearRam0300UpTo
                            	  1572:     ; Reset door trigger info.
                            	  1573:     ;
02:0003F7A4 7000            	  1574:     moveq   #0,D0
02:0003F7A6 19400054        	  1575:     move.b  D0,($0054,A4)
02:0003F7AA 19400055        	  1576:     move.b  D0,($0055,A4)
                            	  1577:     ; Store level block attribute byte F for convenience.
                            	  1578:     ;
02:0003F7AE 7600            	  1579:     moveq   #0,D3
02:0003F7B0 162C00EB        	  1580:     move.b  ($00EB,A4),D3
02:0003F7B4 41F900FF6AFE    	  1581:     lea     (NES_SRAM+$0AFE).l,A0
02:0003F7BA 10303000        	  1582:     move.b  (A0,D3.W),D0
02:0003F7BE 194004CD        	  1583:     move.b  D0,($04CD,A4)
02:0003F7C2 610038A2        	  1584:     jsr     ResetInvObjState
                            	  1585:     ; There's more than one way to enter a room.
                            	  1586:     ;
                            	  1587:     ; 1: Out of a cave, dungeon, or cellar
                            	  1588:     ;     a. Walking exit
                            	  1589:     ;     b. Next to stairs
                            	  1590:     ; 2: Room to room
                            	  1591:     ;
                            	  1592:     ; Determine which one we need.
                            	  1593:     ;
02:0003F7C6 102C005A        	  1594:     move.b  ($005A,A4),D0
02:0003F7CA 6770            	  1595:     beq  _L_z05_InitMode_EnterRoom_Method2
02:0003F7CC 102C0010        	  1596:     move.b  ($0010,A4),D0
02:0003F7D0 665C            	  1597:     bne  _anon_z05_42
                            	  1598:     ; Enter method 1.
                            	  1599:     ;
                            	  1600:     ; Set up Link's exit from underground.
                            	  1601:     ;
02:0003F7D2 7600            	  1602:     moveq   #0,D3
02:0003F7D4 162C00EB        	  1603:     move.b  ($00EB,A4),D3
02:0003F7D8 41F900FF687E    	  1604:     lea     (NES_SRAM+$087E).l,A0
02:0003F7DE 10303000        	  1605:     move.b  (A0,D3.W),D0
02:0003F7E2 020000F0        	  1606:     andi.b #$F0,D0
02:0003F7E6 19400070        	  1607:     move.b  D0,($0070,A4)
02:0003F7EA 41F900FF6AFE    	  1608:     lea     (NES_SRAM+$0AFE).l,A0
02:0003F7F0 10303000        	  1609:     move.b  (A0,D3.W),D0
02:0003F7F4 02000007        	  1610:     andi.b #$07,D0
02:0003F7F8 E308            	  1611:     lsl.b  #1,D0   ; ASL A
02:0003F7FA E308            	  1612:     lsl.b  #1,D0   ; ASL A
02:0003F7FC E308            	  1613:     lsl.b  #1,D0   ; ASL A
02:0003F7FE E308            	  1614:     lsl.b  #1,D0   ; ASL A
                            	  1615:     ; Add the first Y where Link can come out of underground.
                            	  1616:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:0003F800 123C004D        	  1617:     move.b  #$4D,D1
02:0003F804 D101            	  1618:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:0003F806 19400084        	  1619:     move.b  D0,($0084,A4)
                            	  1620:     ; If the player didn't step on a cave entrance to go underground,
                            	  1621:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1622:     ;
02:0003F80A 7600            	  1623:     moveq   #0,D3
02:0003F80C 162C0065        	  1624:     move.b  ($0065,A4),D3
02:0003F810 0C030024        	  1625:     cmpi.b  #$24,D3
02:0003F814 6618            	  1626:     bne  _anon_z05_42
                            	  1627:     ; Enter method 1-a.
                            	  1628:     ;
                            	  1629:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1630:     ;
02:0003F816 19400412        	  1631:     move.b  D0,($0412,A4)
02:0003F81A 023C00EE        	  1632:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F81E 123C0010        	  1633:     move.b  #$10,D1
02:0003F822 D101            	  1634:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F824 19400084        	  1635:     move.b  D0,($0084,A4)
02:0003F828 7008            	  1636:     moveq   #8,D0
02:0003F82A 19400603        	  1637:     move.b  D0,($0603,A4)
                            	  1638: _anon_z05_42:
                            	  1639:     ; This part is the same no matter if the player went
                            	  1640:     ; underground by stairs or a cave entrance.
                            	  1641:     ;
02:0003F82E 7004            	  1642:     moveq   #4,D0
02:0003F830 19400098        	  1643:     move.b  D0,($0098,A4)
02:0003F834 7000            	  1644:     moveq   #0,D0
02:0003F836 19400053        	  1645:     move.b  D0,($0053,A4)
02:0003F83A 6064            	  1646:     jmp     _L_z05_InitMode_EnterRoom_PlaceObjects
