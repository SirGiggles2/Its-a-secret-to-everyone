                            	  5407: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5408:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5409:     ;
02:00041D98 101D            	  5410:     move.b  (A5)+,D0  ; PLA
02:00041D9A 1B00            	  5411:     move.b  D0,-(A5)  ; PHA
02:00041D9C 7400            	  5412:     moveq   #0,D2
02:00041D9E 1400            	  5413:     move.b  D0,D2
                            	  5414:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5415:     ; starting from highest index down to 0:
                            	  5416:     ;
02:00041DA0 41F900041C8E    	  5417:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00041DA6 10302000        	  5418:     move.b  (A0,D2.W),D0
02:00041DAA 7400            	  5419:     moveq   #0,D2
02:00041DAC 1400            	  5420:     move.b  D0,D2
