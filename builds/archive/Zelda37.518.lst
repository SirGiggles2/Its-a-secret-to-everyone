02:0003B0AA 12302000        	  2107:     move.b  (A0,D2.W),D1
02:0003B0AE D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0B0 1B00            	  2109:     move.b  D0,-(A5)  ; PHA
