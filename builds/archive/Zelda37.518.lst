                            	  1205:     ;==========================================================================
                            	  1206:     ; .inc_ppuaddr — advance PPU_VADDR by 1 or 32.
                            	  1207:     ; PPUCTRL bit 2: 0 → +1 horizontal, 1 → +32 vertical.
                            	  1208:     ; Modifies D1.w.
                            	  1209:     ;==========================================================================
                            	  1210: .inc_ppuaddr:
02:00010880 323900FF0802    	  1211:     move.w  (PPU_VADDR).l,D1
02:00010886 0839000200FF0804	  1212:     btst    #2,(PPU_CTRL).l
02:0001088E 6604            	  1213:     bne.s   .inc32
02:00010890 5241            	  1214:     addq.w  #1,D1
02:00010892 6004            	  1215:     bra.s   .store_inc
                            	  1216: .inc32:
02:00010894 06410020        	  1217:     addi.w  #32,D1
                            	  1218: .store_inc:
02:00010898 02413FFF        	  1219:     andi.w  #$3FFF,D1               ; clamp to valid PPU address range
02:0001089C 33C100FF0802    	  1220:     move.w  D1,(PPU_VADDR).l
02:000108A2 4E75            	  1221:     rts
