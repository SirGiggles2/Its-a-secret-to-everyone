02:0002D680 3A04            	  3384:     move.w  D4,D5
02:0002D682 02450003        	  3385:     andi.w  #$0003,D5
02:0002D686 EB4D            	  3386:     lsl.w   #5,D5
02:0002D688 E14D            	  3387:     lsl.w   #8,D5
02:0002D68A 6174            	  3388:     bsr     .ttf_attr1_cache_2x2
02:0002D68C 4EB900010A9E    	  3389:     bsr     _attr_write_2x2
                            	  3390: 
