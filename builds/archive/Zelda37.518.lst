02:0003C470 41F900032F76    	  4879:     lea     (SpriteOffsets).l,A0
02:0003C476 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003C47A 7600            	  4881:     moveq   #0,D3
02:0003C47C 1600            	  4882:     move.b  D0,D3
02:0003C47E 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003C480 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003C484 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003C488 1014            	  4886:     move.b  ($0000,A4),D0
02:0003C48A 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003C48E 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003C492 102C0001        	  4889:     move.b  ($0001,A4),D0
02:0003C496 4EF9000332F4    	  4890:     jmp     Anim_EndWriteSprite
