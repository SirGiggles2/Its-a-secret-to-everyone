                            	  8027:     ;
02:0003DC2A 102C051C        	  8028:     move.b  ($051C,A4),D0
02:0003DC2E 0200000F        	  8029:     andi.b #$0F,D0
02:0003DC32 0C000004        	  8030:     cmpi.b  #$04,D0
02:0003DC36 6702            	  8031:     beq.s  __far_z_04_0087
