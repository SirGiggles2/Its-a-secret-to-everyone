02:0003B42A 102C0070        	  2668:     move.b  ($0070,A4),D0
02:0003B42E 12342070        	  2669:     move.b  ($70,A4,D2.W),D1
02:0003B432 B001            	  2670:     cmp.b   D1,D0
02:0003B434 667C            	  2671:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  2672:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  2673:     ; is positive; then go use it along with a flag that indicates that
                            	  2674:     ; Link is "down" from the object.
