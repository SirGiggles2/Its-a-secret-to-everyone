                            	  7112: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7113:     ; If the "monsters from edges" long timer expired, then
                            	  7114:     ; go bring the monster in.
                            	  7115:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7116:     ;
                            	  7117:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7118:     ; residual position so enemies keep their previous-room
                            	  7119:     ; positions instead of being re-edge-spawned (matches NES).
02:0004B61E 102C004B        	  7120:     move.b  ($004B,A4),D0
02:0004B622 662E            	  7121:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7122:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004B624 102C000F        	  7123:     move.b  ($000F,A4),D0
02:0004B628 0C0000FF        	  7124:     cmpi.b  #$FF,D0
02:0004B62C 662E            	  7125:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004B62E 41EC0070        	  7126:     lea     ($0070,A4),A0
02:0004B632 10302000        	  7127:     move.b  (A0,D2.W),D0
02:0004B636 660A            	  7128:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004B638 41EC0084        	  7129:     lea     ($0084,A4),A0
02:0004B63C 10302000        	  7130:     move.b  (A0,D2.W),D0
02:0004B640 671A            	  7131:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7132:     even
                            	  7133: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
