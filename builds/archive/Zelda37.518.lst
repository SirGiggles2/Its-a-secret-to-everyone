02:0003AEF8 B001            	  1882:     cmp.b   D1,D0
02:0003AEFA 6400FF78        	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AEFE 522C0510        	  1884:     addq.b  #1,($0510,A4)
                            	  1885:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1886:     ; and pick up whatever the new value is for state 1.
                            	  1887:     ;
02:0003AF02 7001            	  1888:     moveq   #1,D0
02:0003AF04 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:0003AF08 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
