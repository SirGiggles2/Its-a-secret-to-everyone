                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:0003AEA6 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AEAA 1214            	  1841:     move.b  ($0000,A4),D1
02:0003AEAC D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:0003AEAE 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:0003AEB2 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:0003AEB6 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:0003AEBA 122C0001        	  1852:     move.b  ($0001,A4),D1
02:0003AEBE B001            	  1853:     cmp.b   D1,D0
02:0003AEC0 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003AEC2 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:0003AEC4 102C0001        	  1856:     move.b  ($0001,A4),D0
