02:0003AE76 102C0084        	  1815:     move.b  ($0084,A4),D0
02:0003AE7A 41EC0084        	  1816:     lea     ($0084,A4),A0
02:0003AE7E 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
