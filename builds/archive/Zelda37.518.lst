                            	  2282:     ;
02:0003B1AA 7020            	  2283:     moveq   #32,D0
02:0003B1AC 7600            	  2284:     moveq   #0,D3
02:0003B1AE 16342019        	  2285:     move.b  ($19,A4,D2.W),D3
02:0003B1B2 0C030080        	  2286:     cmpi.b  #$80,D3
02:0003B1B6 6502            	  2287:     bcs  _anon_z04_52
02:0003B1B8 7060            	  2288:     moveq   #96,D0
                            	  2289: _anon_z04_52:
02:0003B1BA 41EC03BC        	  2290:     lea     ($03BC,A4),A0
02:0003B1BE 11802000        	  2291:     move.b  D0,(A0,D2.W)
                            	  2292:     even
