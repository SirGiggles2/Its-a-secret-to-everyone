                            	  1190: .nt_skip_write:
02:00010870 610E            	  1191:     bsr     .inc_ppuaddr
02:00010872 4CDF037F        	  1192:     movem.l (SP)+,D0-D6/A0-A1
02:00010876 4E75            	  1193:     rts
