02:0003A92C E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:0003A92E E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:0003A930 E308            	  1041:     lsl.b  #1,D0   ; ASL A
