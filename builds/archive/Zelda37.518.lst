02:0002D66C E54B            	  3373:     lsl.w   #2,D3                   ; D3.w = tile_base_row (0-28)
02:0002D66E 0643001E        	  3374:     addi.w  #30,D3                  ; +30: NT1 rows 30-59 in V64 plane
02:0002D672 02400007        	  3375:     andi.w  #$0007,D0
02:0002D676 E548            	  3376:     lsl.w   #2,D0
02:0002D678 3400            	  3377:     move.w  D0,D2                   ; D2.w = tile_base_col
                            	  3378: 
                            	  3379:     ; Get attribute byte from saved D2 on stack
02:0002D67A 202F0004        	  3380:     move.l  (4,SP),D0
02:0002D67E 1800            	  3381:     move.b  D0,D4                  ; D4.b = attribute byte
                            	  3382: 
