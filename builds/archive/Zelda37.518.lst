                            	  2223:     ; Genesis 40-cell: screen column 0 is at X=128 → Genesis X = NES_X + 128
02:0002CE72 3803            	  2224:     move.w  D3,D4
02:0002CE74 06440080        	  2225:     addi.w  #128,D4
02:0002CE78 34C4            	  2226:     move.w  D4,(A2)+            ; Phase 1: SAT_SHADOW write X
                            	  2227: 
02:0002CE7A 5246            	  2228:     addq.w  #1,D6               ; advance sprite index
02:0002CE7C 51CFFF32        	  2229:     dbra    D7,.oam_loop
