02:0003140A 5202            	   333:     addq.b  #1,D2
02:0003140C 0C020003        	   334:     cmpi.b  #$03,D2
02:00031410 66CA            	   335:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   336:     ; Get the top 2 bits of text selector byte in [03],
