                            	     2R     
01:000000DC 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000DD 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000DE 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000DF 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E0 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E1 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E2 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E3 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E4 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E5 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E6 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E7 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
