                            	   753: ;==============================================================================
                            	   754: ; change_song — ported from @ChangeSong
                            	   755: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   756: ;
                            	   757: ; Selects the starting phrase index for the new song, then falls into
                            	   758: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   759: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   760: ;==============================================================================
                            	   761: change_song:
02:00000790 4A00            	   762:     tst.b   D0
02:00000792 6B46            	   763:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:00000794 B03C0006        	   764:     cmp.b   #$06,D0
02:00000798 6610            	   765:     bne.s   .not_zelda
02:0000079A 13FC002400FFE002	   766:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:000007A2 610000E0        	   767:     bsr     prep_phrase
02:000007A6 60000190        	   768:     bra     tick_sq1
                            	   769: .not_zelda:
02:000007AA B03C0001        	   770:     cmp.b   #$01,D0
02:000007AE 6716            	   771:     beq.s   .first_ow
02:000007B0 B03C0040        	   772:     cmp.b   #$40,D0
02:000007B4 671A            	   773:     beq.s   .first_uw
02:000007B6 B03C0010        	   774:     cmp.b   #$10,D0
02:000007BA 6626            	   775:     bne     play_next_phrase            ; single-phrase song
02:000007BC 13FC001100FFE002	   776:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:000007C4 601C            	   777:     bra     play_next_phrase
                            	   778: .first_ow:
02:000007C6 13FC000800FFE002	   779:     move.b  #$08,(m_phrase).l
02:000007CE 6012            	   780:     bra     play_next_phrase
                            	   781: .first_uw:
02:000007D0 13FC000F00FFE002	   782:     move.b  #$0F,(m_phrase).l
02:000007D8 6008            	   783:     bra     play_next_phrase
                            	   784: .first_demo:
02:000007DA 13FC001900FFE002	   785:     move.b  #$19,(m_phrase).l
                            	   786:     bra     play_next_phrase
                            	   787: 
                            	   788: ;==============================================================================
                            	   789: ; play_next_phrase — ported from PlayNextPhrase
                            	   790: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   791: ; calls prep_phrase and falls into tick_sq1.
                            	   792: ;==============================================================================
                            	   793: play_next_phrase:
02:000007E2 103900FFE000    	   794:     move.b  (m_song).l,D0
02:000007E8 6B78            	   795:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:000007EA B03C0001        	   796:     cmp.b   #$01,D0
02:000007EE 6758            	   797:     beq.s   .next_ow
02:000007F0 B03C0040        	   798:     cmp.b   #$40,D0
02:000007F4 6738            	   799:     beq.s   .next_uw
02:000007F6 B03C0010        	   800:     cmp.b   #$10,D0
02:000007FA 6718            	   801:     beq.s   .next_ending
                            	   802:     ; Single-phrase song: find bit position, phrase = index
02:000007FC 7200            	   803:     moveq   #0,D1
02:000007FE 7400            	   804:     moveq   #0,D2
02:00000800 1400            	   805:     move.b  D0,D2
                            	   806: .bitloop:
02:00000802 5201            	   807:     addq.b  #1,D1
02:00000804 E20A            	   808:     lsr.b   #1,D2
02:00000806 64FA            	   809:     bcc.s   .bitloop
02:00000808 13C100FFE002    	   810:     move.b  D1,(m_phrase).l
02:0000080E 6174            	   811:     bsr     prep_phrase
02:00000810 60000126        	   812:     bra     tick_sq1
                            	   813: .next_ending:
02:00000814 523900FFE002    	   814:     addq.b  #1,(m_phrase).l
02:0000081A 0C39001A00FFE002	   815:     cmpi.b  #$1A,(m_phrase).l
02:00000822 665A            	   816:     bne.s   .prep_and_tick
02:00000824 13FC001400FFE002	   817:     move.b  #$14,(m_phrase).l
02:0000082C 60B4            	   818:     bra     play_next_phrase
                            	   819: .next_uw:
02:0000082E 523900FFE002    	   820:     addq.b  #1,(m_phrase).l
02:00000834 0C39001200FFE002	   821:     cmpi.b  #$12,(m_phrase).l
02:0000083C 6640            	   822:     bne.s   .prep_and_tick
02:0000083E 13FC000F00FFE002	   823:     move.b  #$0F,(m_phrase).l
02:00000846 609A            	   824:     bra     play_next_phrase
                            	   825: .next_ow:
02:00000848 523900FFE002    	   826:     addq.b  #1,(m_phrase).l
02:0000084E 0C39001000FFE002	   827:     cmpi.b  #$10,(m_phrase).l
02:00000856 6626            	   828:     bne.s   .prep_and_tick
02:00000858 13FC000900FFE002	   829:     move.b  #$09,(m_phrase).l
02:00000860 6080            	   830:     bra     play_next_phrase
                            	   831: .next_demo:
02:00000862 523900FFE002    	   832:     addq.b  #1,(m_phrase).l
02:00000868 0C39002400FFE002	   833:     cmpi.b  #$24,(m_phrase).l
02:00000870 660C            	   834:     bne.s   .prep_and_tick
02:00000872 13FC001900FFE002	   835:     move.b  #$19,(m_phrase).l
02:0000087A 6000FF66        	   836:     bra     play_next_phrase
                            	   837: .prep_and_tick:
02:0000087E 6104            	   838:     bsr     prep_phrase
02:00000880 600000B6        	   839:     bra     tick_sq1
                            	   840: 
                            	   841: ;==============================================================================
                            	   842: ; prep_phrase — ported from PrepPhrase
                            	   843: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   844: ;==============================================================================
                            	   845: prep_phrase:
02:00000884 43F900000EAE    	   846:     lea     (MusicBlob).l,A1
02:0000088A 7200            	   847:     moveq   #0,D1
02:0000088C 123900FFE002    	   848:     move.b  (m_phrase).l,D1
02:00000892 5341            	   849:     subq.w  #1,D1
02:00000894 12311000        	   850:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000898 024100FF        	   851:     andi.w  #$FF,D1
                            	   852: 
                            	   853:     ; byte 0: NoteLengthTableBase
02:0000089C 13F1100000FFE003	   854:     move.b  (A1,D1.w),(m_len_base).l
02:000008A4 5241            	   855:     addq.w  #1,D1
                            	   856:     ; byte 1: script ptr lo
02:000008A6 7400            	   857:     moveq   #0,D2
02:000008A8 14311000        	   858:     move.b  (A1,D1.w),D2
02:000008AC 5241            	   859:     addq.w  #1,D1
                            	   860:     ; byte 2: script ptr hi
02:000008AE 7600            	   861:     moveq   #0,D3
02:000008B0 16311000        	   862:     move.b  (A1,D1.w),D3
02:000008B4 5241            	   863:     addq.w  #1,D1
02:000008B6 E14B            	   864:     lsl.w   #8,D3
02:000008B8 8642            	   865:     or.w    D2,D3                        ; D3 = NES CPU address
02:000008BA 967C8D60        	   866:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:000008BE 02830000FFFF    	   867:     andi.l  #$FFFF,D3
02:000008C4 41F900000EAE    	   868:     lea     (MusicBlob).l,A0
02:000008CA D1C3            	   869:     adda.l  D3,A0                        ; A0 = M68K script base
02:000008CC 23C800FFE008    	   870:     move.l  A0,(m_script_ptr).l
                            	   871: 
                            	   872:     ; byte 3: NoteOffsetSongTrg
02:000008D2 13F1100000FFE01C	   873:     move.b  (A1,D1.w),(m_trg_off).l
02:000008DA 5241            	   874:     addq.w  #1,D1
                            	   875:     ; byte 4: NoteOffsetSongSq0
02:000008DC 13F1100000FFE014	   876:     move.b  (A1,D1.w),(m_sq0_off).l
02:000008E4 5241            	   877:     addq.w  #1,D1
                            	   878:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:000008E6 13F1100000FFE024	   879:     move.b  (A1,D1.w),(m_noise_off).l
02:000008EE 13F1100000FFE006	   880:     move.b  (A1,D1.w),(m_noise_first).l
02:000008F6 5241            	   881:     addq.w  #1,D1
                            	   882:     ; byte 6: SongEnvelopeSelector
02:000008F8 13F1100000FFE004	   883:     move.b  (A1,D1.w),(m_env_sel).l
02:00000900 5241            	   884:     addq.w  #1,D1
                            	   885:     ; byte 7: mystery
02:00000902 13F1100000FFE005	   886:     move.b  (A1,D1.w),(m_mystery).l
                            	   887: 
                            	   888:     ; Reset counters and Sq1 offset
02:0000090A 13FC000100FFE00D	   889:     move.b  #1,(m_sq1_cnt).l
02:00000912 13FC000100FFE015	   890:     move.b  #1,(m_sq0_cnt).l
02:0000091A 13FC000100FFE01D	   891:     move.b  #1,(m_trg_cnt).l
02:00000922 13FC000100FFE025	   892:     move.b  #1,(m_noise_cnt).l
02:0000092A 423900FFE00C    	   893:     clr.b   (m_sq1_off).l
02:00000930 423900FFE021    	   894:     clr.b   (m_trg_rep_n).l
02:00000936 4E75            	   895:     rts
                            	   896: 
                            	   897: ;==============================================================================
                            	   898: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   899: ;==============================================================================
                            	   900: tick_sq1:
02:00000938 533900FFE00D    	   901:     subq.b  #1,(m_sq1_cnt).l
02:0000093E 66000116        	   902:     bne     tick_sq0                     ; no new note
                            	   903: .read:
02:00000942 207900FFE008    	   904:     move.l  (m_script_ptr).l,A0
02:00000948 7200            	   905:     moveq   #0,D1
02:0000094A 123900FFE00C    	   906:     move.b  (m_sq1_off).l,D1
02:00000950 523900FFE00C    	   907:     addq.b  #1,(m_sq1_off).l
02:00000956 10301000        	   908:     move.b  (A0,D1.w),D0
02:0000095A 673A            	   909:     beq.s   .song_ended
02:0000095C 4A00            	   910:     tst.b   D0
02:0000095E 6B02            	   911:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:00000960 6022            	   912:     bra.s   .play_note
                            	   913: .prep_then_note:
02:00000962 61000284        	   914:     bsr     get_song_note_length         ; D0 in → D0 length
02:00000966 13C000FFE00E    	   915:     move.b  D0,(m_sq1_len).l
02:0000096C 207900FFE008    	   916:     move.l  (m_script_ptr).l,A0
02:00000972 7200            	   917:     moveq   #0,D1
02:00000974 123900FFE00C    	   918:     move.b  (m_sq1_off).l,D1
02:0000097A 523900FFE00C    	   919:     addq.b  #1,(m_sq1_off).l
02:00000980 10301000        	   920:     move.b  (A0,D1.w),D0
                            	   921: .play_note:
02:00000984 6100027C        	   922:     bsr     emit_note_sq1                 ; D0 = note id
02:00000988 13F900FFE00E00FF	   923:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:00000990 E00D
02:00000992 600000C2        	   924:     bra     tick_sq0
                            	   925: .song_ended:
02:00000996 13FC000100FFE02B	   926:     move.b  #1,(m_song_loop_pending).l   ; signal loop point to C poller
02:0000099E 103900FFE000    	   927:     move.b  (m_song).l,D0
02:000009A4 020000F1        	   928:     andi.b  #$F1,D0
02:000009A8 6604            	   929:     bne.s   .play_again
02:000009AA 60000430        	   930:     bra     music_silence
                            	   931: .play_again:
02:000009AE 6102            	   932:     bsr     play_next_phrase_no_tick
02:000009B0 6090            	   933:     bra.s   .read
                            	   934: 
                            	   935: ;----------------------------------------------------------------------
                            	   936: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   937: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   938: ; to restart a looping song when $00 opcode is read.
                            	   939: ;----------------------------------------------------------------------
                            	   940: play_next_phrase_no_tick:
02:000009B2 103900FFE000    	   941:     move.b  (m_song).l,D0
02:000009B8 6B7E            	   942:     bmi     .nsp_demo
02:000009BA B03C0001        	   943:     cmp.b   #$01,D0
02:000009BE 675A            	   944:     beq     .nsp_ow
02:000009C0 B03C0040        	   945:     cmp.b   #$40,D0
02:000009C4 6738            	   946:     beq     .nsp_uw
02:000009C6 B03C0010        	   947:     cmp.b   #$10,D0
02:000009CA 6716            	   948:     beq     .nsp_ending
                            	   949:     ; single-phrase: rebuild phrase from bit
02:000009CC 7200            	   950:     moveq   #0,D1
02:000009CE 7400            	   951:     moveq   #0,D2
02:000009D0 1400            	   952:     move.b  D0,D2
                            	   953: .nsp_loop:
02:000009D2 5201            	   954:     addq.b  #1,D1
02:000009D4 E20A            	   955:     lsr.b   #1,D2
02:000009D6 64FA            	   956:     bcc     .nsp_loop
02:000009D8 13C100FFE002    	   957:     move.b  D1,(m_phrase).l
02:000009DE 6000FEA4        	   958:     bra     prep_phrase
                            	   959: .nsp_ending:
02:000009E2 523900FFE002    	   960:     addq.b  #1,(m_phrase).l
02:000009E8 0C39001A00FFE002	   961:     cmpi.b  #$1A,(m_phrase).l
02:000009F0 6600FE92        	   962:     bne     prep_phrase
02:000009F4 13FC001400FFE002	   963:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:000009FC 60B4            	   964:     bra     play_next_phrase_no_tick
                            	   965: .nsp_uw:
02:000009FE 523900FFE002    	   966:     addq.b  #1,(m_phrase).l
02:00000A04 0C39001200FFE002	   967:     cmpi.b  #$12,(m_phrase).l
02:00000A0C 6600FE76        	   968:     bne     prep_phrase
02:00000A10 13FC000F00FFE002	   969:     move.b  #$0F,(m_phrase).l
02:00000A18 6098            	   970:     bra     play_next_phrase_no_tick
                            	   971: .nsp_ow:
02:00000A1A 523900FFE002    	   972:     addq.b  #1,(m_phrase).l
02:00000A20 0C39001000FFE002	   973:     cmpi.b  #$10,(m_phrase).l
02:00000A28 6600FE5A        	   974:     bne     prep_phrase
02:00000A2C 13FC000900FFE002	   975:     move.b  #$09,(m_phrase).l
02:00000A34 6000FF7C        	   976:     bra     play_next_phrase_no_tick
                            	   977: .nsp_demo:
02:00000A38 523900FFE002    	   978:     addq.b  #1,(m_phrase).l
02:00000A3E 0C39002400FFE002	   979:     cmpi.b  #$24,(m_phrase).l
02:00000A46 6600FE3C        	   980:     bne     prep_phrase
02:00000A4A 13FC001900FFE002	   981:     move.b  #$19,(m_phrase).l
02:00000A52 6000FF5E        	   982:     bra     play_next_phrase_no_tick
