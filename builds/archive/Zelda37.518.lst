02:0003ACEA 1600            	  1608:     move.b  D0,D3
02:0003ACEC 41F90003AC66    	  1609:     lea     (BlueLeeverStateQSpeeds).l,A0
02:0003ACF2 10303000        	  1610:     move.b  (A0,D3.W),D0
02:0003ACF6 41EC03BC        	  1611:     lea     ($03BC,A4),A0
02:0003ACFA 11802000        	  1612:     move.b  D0,(A0,D2.W)
