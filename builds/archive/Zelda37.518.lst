02:0003AA54 101D            	  1233:     move.b  (A5)+,D0  ; PLA
02:0003AA56 7000            	  1234:     moveq   #0,D0
02:0003AA58 1B00            	  1235:     move.b  D0,-(A5)  ; PHA
                            	  1236:     even
