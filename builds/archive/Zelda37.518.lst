02:0003F860 673E            	  1671:     beq  _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1672:     ; If facing right, then set Link's X to 0 at the left edge.
                            	  1673:     ; If direction is left, then set Link's X to $F0 at the right edge.
                            	  1674:     ;
02:0003F862 7600            	  1675:     moveq   #0,D3
02:0003F864 102C0098        	  1676:     move.b  ($0098,A4),D0
02:0003F868 02000003        	  1677:     andi.b #$03,D0
02:0003F86C 670E            	  1678:     beq  _L_z05_InitMode_EnterRoom_ChooseWalkDistance
02:0003F86E 02000001        	  1679:     andi.b #$01,D0
02:0003F872 6604            	  1680:     bne  _anon_z05_44
02:0003F874 163C00F0        	  1681:     move.b  #$F0,D3
                            	  1682: _anon_z05_44:
