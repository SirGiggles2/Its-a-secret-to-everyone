                            	  1012: .nt_noop:
                            	  1013:     ;======================================================================
                            	  1014:     ; T20: Attribute byte ($23C0–$23FF) → Genesis tile word palette bits.
                            	  1015:     ;
                            	  1016:     ; Each NES attribute byte covers a 4×4 tile block.  Two bits per quadrant:
                            	  1017:     ;   bits [1:0] = palette for quadrant 0 (top-left  2×2 tiles)
                            	  1018:     ;   bits [3:2] = palette for quadrant 1 (top-right 2×2 tiles)
                            	  1019:     ;   bits [5:4] = palette for quadrant 2 (bot-left  2×2 tiles)
                            	  1020:     ;   bits [7:6] = palette for quadrant 3 (bot-right 2×2 tiles)
                            	  1021:     ;
                            	  1022:     ; For each of the 16 affected tiles, look up the cached tile index
                            	  1023:     ; from NT_CACHE_BASE[row*32+col] and write the tile word to Plane A
                            	  1024:     ; with bits [12:11] set to the palette.  No VDP VRAM read required.
                            	  1025:     ;======================================================================
02:00010768 0C413F00        	  1026:     cmpi.w  #$3F00,D1
02:0001076C 6400008A        	  1027:     bhs     .t19_palette            ; ≥$3F00: check palette range (widened for T39)
02:00010770 0C4123C0        	  1028:     cmpi.w  #$23C0,D1
02:00010774 650000FA        	  1029:     blo     .nt_skip_write          ; $23C0 not reached yet — skip (shouldn't happen)
02:00010778 0C412400        	  1030:     cmpi.w  #$2400,D1
02:0001077C 640000F2        	  1031:     bhs     .nt_skip_write          ; ≥$2400: overflow past attr table — skip
                            	  1032: 
                            	  1033:     ; ── T20 attribute decode ────────────────────────────�
                            	  1034:     ; offset = PPU_VADDR - $23C0 (0..63)
02:00010780 3401            	  1035:     move.w  D1,D2
02:00010782 044223C0        	  1036:     subi.w  #$23C0,D2               ; D2.w = attribute offset (0..63)
                            	  1037: 
                            	  1038:     ; tile_base_col = (offset & 7) * 4,  tile_base_row = (offset >> 3) * 4
02:00010786 3602            	  1039:     move.w  D2,D3
02:00010788 E64B            	  1040:     lsr.w   #3,D3
02:0001078A E54B            	  1041:     lsl.w   #2,D3                   ; D3.w = tile_base_row (0..28)
                            	  1042:     ; T39 HUD/playfield split: same gate as the tile path. tile_base_row
                            	  1043:     ; is always a multiple of 4 (0, 4, 8, …, 28); an attr byte at row 0
                            	  1044:     ; covers tile rows 0-3 (HUD), at row 4+ covers playfield. Route
                            	  1045:     ; $2000-source attrs to HUD only, $2400-source attrs to playfield only.
02:0001078C 4A47            	  1046:     tst.w   D7
02:0001078E 6608            	  1047:     bne.s   .nt_attr_src_2400
