02:0004A522 4EF90002DA60    	  4830:     jmp     c_set_shot_spreading_state
                            	  4831: 
                            	  4832: SpreadShot:
                            	  4833:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4834:     ;
                            	  4835:     ; The shot is spreading out.
                            	  4836:     ;
                            	  4837:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4838:     ; These will be negated appropriately for each corner.
                            	  4839:     ;
02:0004A528 41EC0098        	  4840:     lea     ($0098,A4),A0
02:0004A52C 10302000        	  4841:     move.b  (A0,D2.W),D0
02:0004A530 19400002        	  4842:     move.b  D0,($0002,A4)
02:0004A534 19400003        	  4843:     move.b  D0,($0003,A4)
                            	  4844:     ; Reset [0F] to not flip horizontally.
                            	  4845:     ;
02:0004A538 7000            	  4846:     moveq   #0,D0
02:0004A53A 1940000F        	  4847:     move.b  D0,($000F,A4)
                            	  4848:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4849:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4850:     ;
02:0004A53E 7603            	  4851:     moveq   #3,D3
                            	  4852:     even
                            	  4853: _L_z07_SpreadShot_DrawShotCorner:
02:0004A540 1003            	  4854:     move.b  D3,D0
02:0004A542 1B00            	  4855:     move.b  D0,-(A5)  ; PHA
                            	  4856:     ; Save offset X [02] and Y offset [03].
                            	  4857:     ;
02:0004A544 102C0002        	  4858:     move.b  ($0002,A4),D0
02:0004A548 1B00            	  4859:     move.b  D0,-(A5)  ; PHA
02:0004A54A 102C0003        	  4860:     move.b  ($0003,A4),D0
02:0004A54E 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Calculate and set sprite attributes for this corner:
                            	  4863:     ;   base attribute OR (frame counter AND 3)
                            	  4864:     ;
                            	  4865:     ; The base attribute defines how to flip the sprite.
                            	  4866:     ; The frame counter makes the shot flash by cycling each
                            	  4867:     ; palette row.
                            	  4868:     ;
02:0004A550 102C0015        	  4869:     move.b  ($0015,A4),D0
02:0004A554 02000003        	  4870:     andi.b #$03,D0
02:0004A558 41F90004A434    	  4871:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004A55E 12303000        	  4872:     move.b  (A0,D3.W),D1
02:0004A562 8001            	  4873:     or.b  D1,D0
02:0004A564 4EB9000332A0    	  4874:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4875:     ; Add the object's X (the center of the spread) and the
                            	  4876:     ; current offset in [02] to set sprite X in [00].
                            	  4877:     ;
02:0004A56A 10342070        	  4878:     move.b  ($70,A4,D2.W),D0
02:0004A56E 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A572 122C0002        	  4880:     move.b  ($0002,A4),D1
02:0004A576 D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:0004A578 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:0004A57A 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:0004A57E B001            	  4887:     cmp.b   D1,D0
02:0004A580 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004A582 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:0004A586 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:0004A588 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:0004A58C 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:0004A590 0A3C0010        	  4893:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A594 9101            	  4894:     subx.b  D1,D0   ; SBC ObjX,X
02:0004A596 0A3C0010        	  4895:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A59A 6014            	  4896:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4897: 
                            	  4898:     even
                            	  4899: _L_z07_SpreadShot_ReverseSub:
02:0004A59C 10342070        	  4900:     move.b  ($70,A4,D2.W),D0
02:0004A5A0 003C0011        	  4901:     ori     #$11,CCR  ; SEC: set C+X
02:0004A5A4 1214            	  4902:     move.b  ($0000,A4),D1
02:0004A5A6 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A5AA 9101            	  4904:     subx.b  D1,D0   ; SBC $00
02:0004A5AC 0A3C0010        	  4905:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4906:     even
                            	  4907: _L_z07_SpreadShot_CheckDistance:
                            	  4908:     ; If distance >= $20, skip this corner.
                            	  4909:     ;
02:0004A5B0 0C000020        	  4910:     cmpi.b  #$20,D0
02:0004A5B4 6438            	  4911:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4912:     ; Add the object's Y (the center of the spread) and the
                            	  4913:     ; current offset in [03] to set sprite Y in [01].
                            	  4914:     ;
02:0004A5B6 41EC0084        	  4915:     lea     ($0084,A4),A0
02:0004A5BA 10302000        	  4916:     move.b  (A0,D2.W),D0
02:0004A5BE 023C00EE        	  4917:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A5C2 122C0003        	  4918:     move.b  ($0003,A4),D1
02:0004A5C6 D101            	  4919:     addx.b  D1,D0   ; ADC $03
02:0004A5C8 19400001        	  4920:     move.b  D0,($0001,A4)
                            	  4921:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4922:     ;
02:0004A5CC 7600            	  4923:     moveq   #0,D3
02:0004A5CE 162C0010        	  4924:     move.b  ($0010,A4),D3
02:0004A5D2 670C            	  4925:     beq  _L_z07_SpreadShot_Draw
02:0004A5D4 0C00003E        	  4926:     cmpi.b  #$3E,D0
02:0004A5D8 6514            	  4927:     bcs  _L_z07_SpreadShot_NextCorner
02:0004A5DA 0C0000E8        	  4928:     cmpi.b  #$E8,D0
02:0004A5DE 640E            	  4929:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4930:     even
                            	  4931: _L_z07_SpreadShot_Draw:
                            	  4932:     ; Draw the corner.
                            	  4933:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4934:     ;
02:0004A5E0 7002            	  4935:     moveq   #2,D0
02:0004A5E2 1940000C        	  4936:     move.b  D0,($000C,A4)
02:0004A5E6 7623            	  4937:     moveq   #35,D3
02:0004A5E8 4EB9000331C0    	  4938:     jsr     Anim_WriteItemSprites
                            	  4939:     even
                            	  4940: _L_z07_SpreadShot_NextCorner:
                            	  4941:     ; Prepare to process the next corner.
                            	  4942:     ;
                            	  4943:     ; First, restore X offset [02] and Y offset [03].
                            	  4944:     ;
02:0004A5EE 101D            	  4945:     move.b  (A5)+,D0  ; PLA
02:0004A5F0 19400003        	  4946:     move.b  D0,($0003,A4)
02:0004A5F4 101D            	  4947:     move.b  (A5)+,D0  ; PLA
02:0004A5F6 19400002        	  4948:     move.b  D0,($0002,A4)
                            	  4949:     ; Take turns negating X offset or Y offset for the next round.
                            	  4950:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4951:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4952:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4953:     ; - Fourth turn: doesn't matter
                            	  4954:     ;
                            	  4955:     ;
                            	  4956:     ; Get the loop index.
02:0004A5FA 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:0004A5FC 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:0004A5FE 7600            	  4959:     moveq   #0,D3
02:0004A600 1600            	  4960:     move.b  D0,D3
02:0004A602 0C030001        	  4961:     cmpi.b  #$01,D3
02:0004A606 6602            	  4962:     bne  _anon_z07_25
02:0004A608 7603            	  4963:     moveq   #3,D3
                            	  4964: _anon_z07_25:
02:0004A60A 10343000        	  4965:     move.b  ($00,A4,D3.W),D0
02:0004A60E 4600            	  4966:     eori.b #$FF,D0
02:0004A610 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A614 123C0001        	  4968:     move.b  #$01,D1
02:0004A618 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004A61A 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
02:0004A61E 101D            	  4973:     move.b  (A5)+,D0  ; PLA
02:0004A620 7600            	  4974:     moveq   #0,D3
02:0004A622 1600            	  4975:     move.b  D0,D3
02:0004A624 5303            	  4976:     subq.b  #1,D3
02:0004A626 6A00FF18        	  4977:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  4978:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4979:     ;
                            	  4980:     ; Decrease the base negative offset to get farther away from
                            	  4981:     ; the center point.
                            	  4982:     ;
02:0004A62A 41EC0098        	  4983:     lea     ($0098,A4),A0
02:0004A62E 53302000        	  4984:     subq.b  #1,(A0,D2.W)
                            	  4985:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4986:     ;
                            	  4987:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  4988:     ;
02:0004A632 41EC0098        	  4989:     lea     ($0098,A4),A0
02:0004A636 10302000        	  4990:     move.b  (A0,D2.W),D0
02:0004A63A 0C0000E8        	  4991:     cmpi.b  #$E8,D0
02:0004A63E 6702            	  4992:     beq.s  __far_z_07_0071
02:0004A640 6004            	  4993:     jmp  L1F49F_Exit
                            	  4994: __far_z_07_0071:
02:0004A642 6000FED2        	  4995:     jmp     DeactivateLinkShot
                            	  4996: 
                            	  4997:     even
                            	  4998: L1F49F_Exit:
02:0004A646 4E75            	  4999:     rts
                            	  5000: 
                            	  5001:     even
                            	  5002: UpdateBoomerangOrFood:
                            	  5003:     ; If state = 0, then not active. So, return.
                            	  5004:     ;
02:0004A648 41EC00AC        	  5005:     lea     ($00AC,A4),A0
02:0004A64C 10302000        	  5006:     move.b  (A0,D2.W),D0
02:0004A650 6602            	  5007:     bne.s  __far_z_07_0072
02:0004A652 60F2            	  5008:     jmp  L1F49F_Exit
                            	  5009: __far_z_07_0072:
                            	  5010:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5011:     ;
02:0004A654 E308            	  5012:     lsl.b  #1,D0   ; ASL A
02:0004A656 6504            	  5013:     bcs.s  __far_z_07_0073
02:0004A658 600000AA        	  5014:     jmp  UpdateArrowOrBoomerang
                            	  5015: __far_z_07_0073:
                            	  5016:     ; The object is food.
                            	  5017:     ;
                            	  5018:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5019:     ; If we reach state $83, then go deactivate the object.
                            	  5020:     ;
                            	  5021:     ; Nothing changes between the states. So, they are used as
                            	  5022:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5023:     ;
02:0004A65C 10342028        	  5024:     move.b  ($28,A4,D2.W),D0
02:0004A660 6622            	  5025:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004A662 41EC00AC        	  5026:     lea     ($00AC,A4),A0
02:0004A666 52302000        	  5027:     addq.b  #1,(A0,D2.W)
02:0004A66A 41EC00AC        	  5028:     lea     ($00AC,A4),A0
02:0004A66E 10302000        	  5029:     move.b  (A0,D2.W),D0
02:0004A672 0200000F        	  5030:     andi.b #$0F,D0
02:0004A676 0C000003        	  5031:     cmpi.b  #$03,D0
02:0004A67A 674C            	  5032:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004A67C 103C00FF        	  5033:     move.b  #$FF,D0
02:0004A680 19802028        	  5034:     move.b  D0,($28,A4,D2.W)
                            	  5035:     even
                            	  5036: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
                            	  5037:     ; If the template object type in the room is one of:
                            	  5038:     ; moblin, goriya, octorock, vire, keese
                            	  5039:     ; then attract these monsters to the food.
                            	  5040:     ;
                            	  5041:     ; They will chase the food instead of Link when given a chance.
                            	  5042:     ;
02:0004A684 102C035F        	  5043:     move.b  ($035F,A4),D0
