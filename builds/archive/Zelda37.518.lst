                            	   389: UpdateMenuStartOW:
                            	   390:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   391:     ; make it look completely empty, and no piece has been won.
                            	   392:     ;
02:0003EAB0 7617            	   393:     moveq   #23,D3
                            	   394: _anon_z05_6:
02:0003EAB2 7400            	   395:     moveq   #0,D2
02:0003EAB4 41F90003EA68    	   396:     lea     (TriforceTransferBufOffsets).l,A0
02:0003EABA 14303000        	   397:     move.b  (A0,D3.W),D2
02:0003EABE 41F90003EA98    	   398:     lea     (TriforceTransferBufTiles).l,A0
02:0003EAC4 10303000        	   399:     move.b  (A0,D3.W),D0
02:0003EAC8 41F900045A8E    	   400:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003EACE 11802000        	   401:     move.b  D0,(A0,D2.W)
02:0003EAD2 5303            	   402:     subq.b  #1,D3
02:0003EAD4 6ADC            	   403:     bpl  _anon_z05_6
                            	   404:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   405:     ;
02:0003EAD6 5203            	   406:     addq.b  #1,D3
                            	   407:     ; Outer loop.
                            	   408:     ; A level test bit in [06] will be used to see whether
                            	   409:     ; we have a triforce piece.
                            	   410:     ;
02:0003EAD8 7001            	   411:     moveq   #1,D0
02:0003EADA 19400006        	   412:     move.b  D0,($0006,A4)
                            	   413:     even
                            	   414: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   415:     ; Inner loop.
                            	   416:     ; Each level bit will make 3 triforce tile slots be
                            	   417:     ; checked and replaced.
                            	   418:     ;
02:0003EADE 7003            	   419:     moveq   #3,D0
02:0003EAE0 19400007        	   420:     move.b  D0,($0007,A4)
                            	   421:     even
                            	   422: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   423:     ; Get the offset into the submenu triforce transfer buffers of
                            	   424:     ; the current tile slot.
                            	   425:     ;
02:0003EAE4 7400            	   426:     moveq   #0,D2
02:0003EAE6 41F90003EA68    	   427:     lea     (TriforceTransferBufOffsets).l,A0
02:0003EAEC 14303000        	   428:     move.b  (A0,D3.W),D2
                            	   429:     ; If the level test bit is not in the triforce mask, then we don't
                            	   430:     ; have this piece. So, go loop again, and leave the tile in the
                            	   431:     ; empty state.
                            	   432:     ;
                            	   433:     ;
                            	   434:     ; [06] level test mask
02:0003EAF0 102C0006        	   435:     move.b  ($0006,A4),D0
02:0003EAF4 122C0671        	   436:     move.b  ($0671,A4),D1
02:0003EAF8 C200            	   437:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EAFA 6730            	   438:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   439:     ; We have the triforce piece.
                            	   440:     ;
                            	   441:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   442:     ; then make it $F5. These are tiles that were half full, and now
                            	   443:     ; need to be full.
                            	   444:     ;
                            	   445:     ; Else replace it with the one at the current triforce tile slot
                            	   446:     ; in the replacement list.
                            	   447:     ;
02:0003EAFC 41F900045A8E    	   448:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003EB02 10302000        	   449:     move.b  (A0,D2.W),D0
02:0003EB06 0C0000E5        	   450:     cmpi.b  #$E5,D0
02:0003EB0A 6712            	   451:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003EB0C 0C0000E6        	   452:     cmpi.b  #$E6,D0
02:0003EB10 670C            	   453:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003EB12 41F90003EA80    	   454:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003EB18 10303000        	   455:     move.b  (A0,D3.W),D0
02:0003EB1C 6004            	   456:     jmp     _anon_z05_7
                            	   457: 
                            	   458:     even
                            	   459: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003EB1E 103C00F5        	   460:     move.b  #$F5,D0
                            	   461: _anon_z05_7:
02:0003EB22 41F900045A8E    	   462:     lea     (TriforceRow0TransferBuf+4).l,A0
