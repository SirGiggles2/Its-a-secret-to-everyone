02:00041E30 6A02            	  5483:     bpl.s  __far_z_05_0072
02:00041E32 604E            	  5484:     jmp  L165D4_Exit
                            	  5485: __far_z_05_0072:
02:00041E34 6000FE5E        	  5486:     jmp     L_LayOutDoors_LoopDoors
                            	  5487: 
                            	  5488: ; Params:
                            	  5489: ; A: direction index
