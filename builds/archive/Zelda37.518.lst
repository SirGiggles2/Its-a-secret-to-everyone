                            	  2156: InitArmosOrFlyingGhini:
                            	  2157:     ; In UpdateObject, this object was flagged "initialized".
                            	  2158:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2159:     ;
02:0003B0FE 10342028        	  2160:     move.b  ($28,A4,D2.W),D0
02:0003B102 41EC0492        	  2161:     lea     ($0492,A4),A0
02:0003B106 11802000        	  2162:     move.b  D0,(A0,D2.W)
                            	  2163:     ; If it's still fading in, then go finish some initialization needed
                            	  2164:     ; for fading in.
                            	  2165:     ;
02:0003B10A 660000B6        	  2166:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2167:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2168:     ; go finish initializing it.
                            	  2169:     ;
02:0003B10E 41EC034F        	  2170:     lea     ($034F,A4),A0
02:0003B112 10302000        	  2171:     move.b  (A0,D2.W),D0
02:0003B116 0C000022        	  2172:     cmpi.b  #$22,D0
02:0003B11A 670000A6        	  2173:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2174:     ; Else we have an armos.
                            	  2175:     ;
                            	  2176:     ; Store stairs tile $70 in [00] for use later.
                            	  2177:     ;
02:0003B11E 7070            	  2178:     moveq   #112,D0
02:0003B120 1880            	  2179:     move.b  D0,($0000,A4)
                            	  2180:     ; Look for the current room ID in an array of room ID's that
                            	  2181:     ; have armos secrets.
                            	  2182:     ;
02:0003B122 7606            	  2183:     moveq   #6,D3
                            	  2184:     even
                            	  2185: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B124 102C00EB        	  2186:     move.b  ($00EB,A4),D0
                            	  2187:     ; If this element does not match the current room ID, go loop again.
                            	  2188:     ;
02:0003B128 41F90003B0EE    	  2189:     lea     (SecretArmosRoomIds).l,A0
02:0003B12E 12303000        	  2190:     move.b  (A0,D3.W),D1
02:0003B132 B001            	  2191:     cmp.b   D1,D0
02:0003B134 6648            	  2192:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2193:     ; The secret (usually stairs) is under one of the armoses.
                            	  2194:     ;
                            	  2195:     ; If the armos's X coordinate does not match the one needed
                            	  2196:     ; for the current room in the list, then go loop again.
                            	  2197:     ;
02:0003B136 10342070        	  2198:     move.b  ($70,A4,D2.W),D0
02:0003B13A 41F90003B0F6    	  2199:     lea     (SecretArmosXs).l,A0
02:0003B140 12303000        	  2200:     move.b  (A0,D3.W),D1
02:0003B144 B001            	  2201:     cmp.b   D1,D0
02:0003B146 6636            	  2202:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2203:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2204:     ;
02:0003B148 41EC0084        	  2205:     lea     ($0084,A4),A0
02:0003B14C 10302000        	  2206:     move.b  (A0,D2.W),D0
02:0003B150 0C000080        	  2207:     cmpi.b  #$80,D0
02:0003B154 6628            	  2208:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2209:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2210:     ;
02:0003B156 4A03            	  2211:     cmpi.b  #$00,D3
02:0003B158 662C            	  2212:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2213:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2214:     ; has the power bracelet.
                            	  2215:     ;
                            	  2216:     ; Set up the room item with the armos's coordinates.
                            	  2217:     ;
02:0003B15A 19400097        	  2218:     move.b  D0,($0097,A4)
02:0003B15E 10342070        	  2219:     move.b  ($70,A4,D2.W),D0
02:0003B162 19400083        	  2220:     move.b  D0,($0083,A4)
                            	  2221:     ; This resets the room item's state, which activates it.
                            	  2222:     ;
02:0003B166 194300BF        	  2223:     move.b  D3,($00BF,A4)
                            	  2224:     ; Set the room item ID.
                            	  2225:     ;
02:0003B16A 7014            	  2226:     moveq   #20,D0
02:0003B16C 194000AB        	  2227:     move.b  D0,($00AB,A4)
                            	  2228:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2229:     ;
                            	  2230:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2231:     ;
                            	  2232:     ; Note that, if the item was already taken, then the room item
                            	  2233:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2234:     ; it will be ignored, because that routine checks whether
                            	  2235:     ; the item was taken.
                            	  2236:     ;
02:0003B170 4EB900032CE6    	  2237:     jsr     GetRoomFlagUWItemState
02:0003B176 660A            	  2238:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B178 6100069A        	  2239:     jsr     PlaySecretFoundTune
02:0003B17C 6604            	  2240:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2241:     even
                            	  2242: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  2243:     ; Bottom of the loop.
