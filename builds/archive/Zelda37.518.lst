                            	  3830: Moldorm_Chase:
                            	  3831:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3832:     ; Only the head controls the movement direction.
                            	  3833:     ;
02:0003BD0E 0C020005        	  3834:     cmpi.b  #$05,D2
02:0003BD12 670A            	  3835:     beq  _anon_z04_81
02:0003BD14 0C02000A        	  3836:     cmpi.b  #$0A,D2
02:0003BD18 6704            	  3837:     beq.s  __far_z_04_0025
02:0003BD1A 600000A4        	  3838:     jmp  L1156B_Exit
                            	  3839: __far_z_04_0025:
                            	  3840: _anon_z04_81:
                            	  3841:     ; Chase while flying, as usual.
                            	  3842:     ;
02:0003BD1E 610027FE        	  3843:     jsr     Flyer_Chase
                            	  3844:     ; If timer has not expired, then
                            	  3845:     ; go see if it's time to propagate direction changes down the chain.
                            	  3846:     ;
02:0003BD22 10342028        	  3847:     move.b  ($28,A4,D2.W),D0
02:0003BD26 6702            	  3848:     beq.s  __far_z_04_0026
02:0003BD28 6032            	  3849:     jmp  Moldorm_PropagateDirs
                            	  3850: __far_z_04_0026:
                            	  3851:     even
                            	  3852: Moldorm_ChangeFlyingState:
                            	  3853:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  3854:     ;
02:0003BD2A 61000096        	  3855:     jsr     Flyer_MoldormDecideState
02:0003BD2E 7010            	  3856:     moveq   #16,D0
02:0003BD30 19802028        	  3857:     move.b  D0,($28,A4,D2.W)
                            	  3858:     ; If the next lower slot's direction <> 0, then
                            	  3859:     ; go propagate direction changes down the chain.
                            	  3860:     ;
                            	  3861:     ; But you had to have propagated directions once for the
                            	  3862:     ; next lower direction to be set. How does it happen?
                            	  3863:     ;
                            	  3864:     ; Within a flyer state, the flying routines turn the flyer
                            	  3865:     ; and set the object timer to $10 several times. After any of
                            	  3866:     ; those times will the test succeed.
                            	  3867:     ;
                            	  3868:     ; When a flying state ends, timer will be 0, triggering the code
                            	  3869:     ; in this block to set the timer to $10, and try to propagate
                            	  3870:     ; directions.
                            	  3871:     ;
                            	  3872:     ; But this is also the case the first time here.
                            	  3873:     ;
                            	  3874:     ; So, I believe that the point of this test is to delay moving
                            	  3875:     ; the lower (not head) segments when starting out.
                            	  3876:     ;
02:0003BD34 41EC0097        	  3877:     lea     ($0097,A4),A0
02:0003BD38 10302000        	  3878:     move.b  (A0,D2.W),D0
02:0003BD3C 6702            	  3879:     beq.s  __far_z_04_0027
02:0003BD3E 601C            	  3880:     jmp  Moldorm_PropagateDirs
                            	  3881: __far_z_04_0027:
02:0003BD40 4E75            	  3882:     rts
                            	  3883: 
                            	  3884:     even
                            	  3885: Moldorm_Wander:
                            	  3886:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3887:     ; Only the head controls the movement direction.
                            	  3888:     ;
02:0003BD42 0C020005        	  3889:     cmpi.b  #$05,D2
02:0003BD46 6708            	  3890:     beq  _anon_z04_82
02:0003BD48 0C02000A        	  3891:     cmpi.b  #$0A,D2
02:0003BD4C 6702            	  3892:     beq.s  __far_z_04_0028
02:0003BD4E 6070            	  3893:     jmp  L1156B_Exit
                            	  3894: __far_z_04_0028:
                            	  3895: _anon_z04_82:
                            	  3896:     ; Turn randomly while flying, as usual.
                            	  3897:     ;
02:0003BD50 610028AA        	  3898:     jsr     Flyer_Wander
                            	  3899:     ; After every turn, the common flyer routines set timer to $10.
                            	  3900:     ; This can be used as a signal for moldorm to propagate
                            	  3901:     ; direction changes down the chain.
                            	  3902:     ;
                            	  3903:     ; Between each turn, timer <> $10.
                            	  3904:     ;
                            	  3905:     ; At the end of the delay after the last turn, timer = 0.
                            	  3906:     ; This is a signal that that flying state ended, and a new one
                            	  3907:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  3908:     ; we can propagate direction changes again; and start
                            	  3909:     ; a new flying interval by setting timer to $10. This will make
                            	  3910:     ; the next flying state delay that amount of time before turning
                            	  3911:     ; the first time.
                            	  3912:     ;
                            	  3913:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  3914:     ; arm the timer again, and shift directions down the chain.
                            	  3915:     ;
02:0003BD54 10342028        	  3916:     move.b  ($28,A4,D2.W),D0
02:0003BD58 6602            	  3917:     bne.s  __far_z_04_0029
02:0003BD5A 60CE            	  3918:     jmp  Moldorm_ChangeFlyingState
                            	  3919: __far_z_04_0029:
                            	  3920:     even
                            	  3921: Moldorm_PropagateDirs:
                            	  3922:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  3923:     ;
02:0003BD5C 10342028        	  3924:     move.b  ($28,A4,D2.W),D0
02:0003BD60 0C000010        	  3925:     cmpi.b  #$10,D0
02:0003BD64 6702            	  3926:     beq.s  __far_z_04_0030
02:0003BD66 6058            	  3927:     jmp  L1156B_Exit
                            	  3928: __far_z_04_0030:
                            	  3929:     ; Timer = $10.
                            	  3930:     ;
                            	  3931:     ; If deferred bounce direction <> 0, then
                            	  3932:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  3933:     ;
02:0003BD68 41EC03BC        	  3934:     lea     ($03BC,A4),A0
02:0003BD6C 10302000        	  3935:     move.b  (A0,D2.W),D0
02:0003BD70 6712            	  3936:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003BD72 41EC0098        	  3937:     lea     ($0098,A4),A0
02:0003BD76 11802000        	  3938:     move.b  D0,(A0,D2.W)
02:0003BD7A 7000            	  3939:     moveq   #0,D0
02:0003BD7C 41EC03BC        	  3940:     lea     ($03BC,A4),A0
02:0003BD80 11802000        	  3941:     move.b  D0,(A0,D2.W)
                            	  3942:     even
                            	  3943: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  3944:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  3945:     ;
02:0003BD84 7004            	  3946:     moveq   #4,D0
02:0003BD86 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:0003BD88 7600            	  3950:     moveq   #0,D3
02:0003BD8A 0C020005        	  3951:     cmpi.b  #$05,D2
02:0003BD8E 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003BD90 7605            	  3953:     moveq   #5,D3
                            	  3954:     even
                            	  3955: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  3956:     ; Copy old direction from a higher slot to the lower one;
                            	  3957:     ; and to the lower one's facing direction.
                            	  3958:     ;
02:0003BD92 41EC0382        	  3959:     lea     ($0382,A4),A0
02:0003BD96 10303000        	  3960:     move.b  (A0,D3.W),D0
02:0003BD9A 41EC0381        	  3961:     lea     ($0381,A4),A0
02:0003BD9E 11803000        	  3962:     move.b  D0,(A0,D3.W)
02:0003BDA2 41EC0099        	  3963:     lea     ($0099,A4),A0
02:0003BDA6 11803000        	  3964:     move.b  D0,(A0,D3.W)
                            	  3965:     ; Bottom of the loop.
                            	  3966:     ; Increment segment index.
                            	  3967:     ; Decrement loop counter.
                            	  3968:     ;
02:0003BDAA 5203            	  3969:     addq.b  #1,D3
02:0003BDAC 5314            	  3970:     subq.b  #1,($0000,A4)
02:0003BDAE 66E2            	  3971:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  3972:     ; Copy current direction to old direction.
                            	  3973:     ;
02:0003BDB0 41EC0098        	  3974:     lea     ($0098,A4),A0
02:0003BDB4 10302000        	  3975:     move.b  (A0,D2.W),D0
02:0003BDB8 41EC0380        	  3976:     lea     ($0380,A4),A0
02:0003BDBC 11802000        	  3977:     move.b  D0,(A0,D2.W)
                            	  3978:     even
