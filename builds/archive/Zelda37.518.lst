02:0003BBBC 7600            	  3669:     moveq   #0,D3
02:0003BBBE 1600            	  3670:     move.b  D0,D3
02:0003BBC0 41F90003E4A6    	  3671:     lea     (Directions8).l,A0
02:0003BBC6 10303000        	  3672:     move.b  (A0,D3.W),D0
02:0003BBCA 1940009D        	  3673:     move.b  D0,($009D,A4)
02:0003BBCE 19400385        	  3674:     move.b  D0,($0385,A4)
02:0003BBD2 102C0022        	  3675:     move.b  ($0022,A4),D0
02:0003BBD6 02000007        	  3676:     andi.b #$07,D0
02:0003BBDA 7600            	  3677:     moveq   #0,D3
02:0003BBDC 1600            	  3678:     move.b  D0,D3
02:0003BBDE 41F90003E4A6    	  3679:     lea     (Directions8).l,A0
02:0003BBE4 10303000        	  3680:     move.b  (A0,D3.W),D0
