02:0003C56A 41EC042C        	  5003:     lea     ($042C,A4),A0
02:0003C56E 16302000        	  5004:     move.b  (A0,D2.W),D3
02:0003C572 41F90003C4B0    	  5005:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C578 10303000        	  5006:     move.b  (A0,D3.W),D0
02:0003C57C 41EC045E        	  5007:     lea     ($045E,A4),A0
02:0003C580 11802000        	  5008:     move.b  D0,(A0,D2.W)
                            	  5009:     ; If substate <> 0, go decrement bloated timer.
                            	  5010:     ;
02:0003C584 4A03            	  5011:     cmpi.b  #$00,D3
02:0003C586 6702            	  5012:     beq.s  __far_z_04_0044
02:0003C588 605C            	  5013:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5014: __far_z_04_0044:
