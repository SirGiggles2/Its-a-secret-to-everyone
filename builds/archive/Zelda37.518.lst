                            	  4477: UpdatePeaceTextbox:
                            	  4478:     ; Only emit a character once every 8 frames --
                            	  4479:     ; when (counter [0412] MOD 8) = 4.
                            	  4480:     ;
02:000370CC 522C0412        	  4481:     addq.b  #1,($0412,A4)
02:000370D0 102C0412        	  4482:     move.b  ($0412,A4),D0
02:000370D4 02000007        	  4483:     andi.b #$07,D0
02:000370D8 0C000004        	  4484:     cmpi.b  #$04,D0
02:000370DC 665C            	  4485:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4486:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4487:     ; to the dynamic transfer buf.
                            	  4488:     ;
