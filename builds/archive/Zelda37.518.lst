                            	  5256:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5257:     ;
02:00041CDC 0C000001        	  5258:     cmpi.b  #$01,D0
02:00041CE0 6402            	  5259:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00041CE2 7004            	  5260:     moveq   #4,D0
                            	  5261:     even
                            	  5262: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5263:     ; The door attribute (DA) has been mapped to a
                            	  5264:     ; provisional door face value (PF) in %A as follows:
                            	  5265:     ;
                            	  5266:     ; DA PF Meaning
                            	  5267:     ; -------------
                            	  5268:     ; 0  4  open
                            	  5269:     ; 1  1  wall
                            	  5270:     ; 2  2  false wall
                            	  5271:     ; 3  3  false wall 2
                            	  5272:     ; 4  8  bombable
                            	  5273:     ; 5  5  key
                            	  5274:     ; 6  6  key 2
                            	  5275:     ; 7  7  shutter
                            	  5276:     ;
                            	  5277:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5278:     ; has been cleared, if the type was "open" or any wall.
                            	  5279:     ;
                            	  5280:     ;
                            	  5281:     ; Save the provisional face.
02:00041CE4 1B00            	  5282:     move.b  D0,-(A5)  ; PHA
                            	  5283:     ; If the current direction points to a door that has been opened,
                            	  5284:     ; then see if we need to set door flags.
                            	  5285:     ;
02:00041CE6 102C00EE        	  5286:     move.b  ($00EE,A4),D0
02:00041CEA 122C0002        	  5287:     move.b  ($0002,A4),D1
02:00041CEE C001            	  5288:     and.b  D1,D0
02:00041CF0 7400            	  5289:     moveq   #0,D2
02:00041CF2 1400            	  5290:     move.b  D0,D2
02:00041CF4 101D            	  5291:     move.b  (A5)+,D0  ; PLA
02:00041CF6 122C0002        	  5292:     move.b  ($0002,A4),D1
02:00041CFA B401            	  5293:     cmp.b   D1,D2
02:00041CFC 6624            	  5294:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5295:     ; The current direction points to a door that has been opened.
                            	  5296:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5297:     ;
                            	  5298:     ;
                            	  5299:     ; Save provisional door face in Y register.
02:00041CFE 7600            	  5300:     moveq   #0,D3
02:00041D00 1600            	  5301:     move.b  D0,D3
02:00041D02 101D            	  5302:     move.b  (A5)+,D0  ; PLA
02:00041D04 1B00            	  5303:     move.b  D0,-(A5)  ; PHA
02:00041D06 7400            	  5304:     moveq   #0,D2
02:00041D08 1400            	  5305:     move.b  D0,D2
02:00041D0A 1003            	  5306:     move.b  D3,D0
                            	  5307:     ; If provisional door face is not for a shutter, then
                            	  5308:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5309:     ;
                            	  5310:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5311:     ;
02:00041D0C 0C000007        	  5312:     cmpi.b  #$07,D0
02:00041D10 670E            	  5313:     beq  _anon_z05_111
02:00041D12 1B00            	  5314:     move.b  D0,-(A5)  ; PHA
02:00041D14 6100DF6C        	  5315:     jsr     SetDoorFlag
02:00041D18 101D            	  5316:     move.b  (A5)+,D0  ; PLA
                            	  5317:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5318:     ; then go make it 9 (open "bombable").
                            	  5319:     ; Else make it 4 (open "door").
                            	  5320:     ;
02:00041D1A 0C000008        	  5321:     cmpi.b  #$08,D0
02:00041D1E 67A4            	  5322:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5323: _anon_z05_111:
02:00041D20 7004            	  5324:     moveq   #4,D0
                            	  5325:     even
                            	  5326: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5327:     ; For opened doors, the provisional door face has become:
                            	  5328:     ;
                            	  5329:     ; DA PF Meaning
                            	  5330:     ; -------------
                            	  5331:     ; 0  4  open
                            	  5332:     ; 1  1  wall
                            	  5333:     ; 2  2  false wall
                            	  5334:     ; 3  3  false wall 2
                            	  5335:     ; 4  9  bombable
                            	  5336:     ; 5  4  key
                            	  5337:     ; 6  4  key 2
                            	  5338:     ; 7  4  shutter
                            	  5339:     ;
                            	  5340:     ;
                            	  5341:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5342:     ;
02:00041D22 7400            	  5343:     moveq   #0,D2
02:00041D24 142C0006        	  5344:     move.b  ($0006,A4),D2
02:00041D28 6712            	  5345:     beq  _anon_z05_112
02:00041D2A 7400            	  5346:     moveq   #0,D2
02:00041D2C 142C000B        	  5347:     move.b  ($000B,A4),D2
02:00041D30 1B00            	  5348:     move.b  D0,-(A5)  ; PHA
02:00041D32 6100FCC8        	  5349:     jsr     FindDoorAttrByDoorBit
02:00041D36 61001C34        	  5350:     jsr     CalcOpenDoorwayMask
02:00041D3A 101D            	  5351:     move.b  (A5)+,D0  ; PLA
                            	  5352: _anon_z05_112:
                            	  5353:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5354:     ; because the visible door face is already a wall.
                            	  5355:     ;
02:00041D3C 0C000004        	  5356:     cmpi.b  #$04,D0
02:00041D40 650000DC        	  5357:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5358:     ; For all other provisional face values, calculate:
                            	  5359:     ; door face := provisional face - 3
02:00041D44 003C0011        	  5360:     ori     #$11,CCR  ; SEC: set C+X
02:00041D48 123C0003        	  5361:     move.b  #$03,D1
02:00041D4C 0A3C0010        	  5362:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D50 9101            	  5363:     subx.b  D1,D0   ; SBC #$03
02:00041D52 0A3C0010        	  5364:     eori    #$10,CCR  ; restore X = 6502 C
02:00041D56 7600            	  5365:     moveq   #0,D3
02:00041D58 1600            	  5366:     move.b  D0,D3
                            	  5367:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5368:     ; subtract one.
                            	  5369:     ;
02:00041D5A 0C030003        	  5370:     cmpi.b  #$03,D3
02:00041D5E 6502            	  5371:     bcs  _anon_z05_113
02:00041D60 5303            	  5372:     subq.b  #1,D3
                            	  5373: _anon_z05_113:
                            	  5374:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5375:     ;
                            	  5376:     ; DT DFC DFO Meaning
                            	  5377:     ; ------------------
                            	  5378:     ; 0  1   1   open
                            	  5379:     ; 4  4   5   bombable
                            	  5380:     ; 5  2   1   key
                            	  5381:     ; 6  2   1   key 2
                            	  5382:     ; 7  3   1   shutter
                            	  5383:     ;
                            	  5384:     ;
                            	  5385:     ; Get the direction index.
02:00041D62 101D            	  5386:     move.b  (A5)+,D0  ; PLA
02:00041D64 1B00            	  5387:     move.b  D0,-(A5)  ; PHA
02:00041D66 610000D0        	  5388:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5389:     ; If handling the second half, then offset to the second half
                            	  5390:     ; of the tiles.
                            	  5391:     ;
02:00041D6A 102C0006        	  5392:     move.b  ($0006,A4),D0
02:00041D6E 6618            	  5393:     bne  _anon_z05_114
02:00041D70 41F900041C86    	  5394:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00041D76 10302000        	  5395:     move.b  (A0,D2.W),D0
02:00041D7A 4EB900032C62    	  5396:     jsr     AddToInt16At0
02:00041D80 7006            	  5397:     moveq   #6,D0
02:00041D82 4EB900032C6A    	  5398:     jsr     AddToInt16At2
                            	  5399: _anon_z05_114:
                            	  5400:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5401:     ; Pointers will be incremented instead of Y.
02:00041D88 7600            	  5402:     moveq   #0,D3
02:00041D8A 41F900041C8A    	  5403:     lea     (DirIndexToDoorColumnCount).l,A0
02:00041D90 10302000        	  5404:     move.b  (A0,D2.W),D0
02:00041D94 19400005        	  5405:     move.b  D0,($0005,A4)
