02:000371BA 0C000008        	  4604:     cmpi.b  #$08,D0
02:000371BE 6B1A            	  4605:     bmi  _anon_z02_37
02:000371C0 102C050B        	  4606:     move.b  ($050B,A4),D0
02:000371C4 123C0008        	  4607:     move.b  #$08,D1
02:000371C8 0A3C0010        	  4608:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000371CC 9101            	  4609:     subx.b  D1,D0   ; SBC #$08
