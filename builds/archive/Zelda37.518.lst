02:0004A992 666A            	  5496:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5497:     ; The boomerang has reached the thrower.
                            	  5498:     ;
                            	  5499:     ; Reset the distance to move.
                            	  5500:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5501:     ;
02:0004A994 7000            	  5502:     moveq   #0,D0
02:0004A996 41EC0380        	  5503:     lea     ($0380,A4),A0
02:0004A99A 11802000        	  5504:     move.b  D0,(A0,D2.W)
02:0004A99E 0C02000D        	  5505:     cmpi.b  #$0D,D2
02:0004A9A2 6524            	  5506:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5507:     ; Link has caught the boomerang.
                            	  5508:     ;
                            	  5509:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5510:     ;
                            	  5511:     ; If Link catches it some time after throwing it,
                            	  5512:     ; his state will become $20, and he will show the catch animation.
                            	  5513:     ;
                            	  5514:     ; But if he catches it right after throwing it, the state becomes
                            	  5515:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5516:     ;
02:0004A9A4 102C00AC        	  5517:     move.b  ($00AC,A4),D0
02:0004A9A8 00000020        	  5518:     ori.b #$20,D0
02:0004A9AC 194000AC        	  5519:     move.b  D0,($00AC,A4)
                            	  5520:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5521:     ; up the new state.
                            	  5522:     ;
02:0004A9B0 7001            	  5523:     moveq   #1,D0
02:0004A9B2 194003D0        	  5524:     move.b  D0,($03D0,A4)
                            	  5525:     ; Deactivate the boomerang.
                            	  5526:     ;
02:0004A9B6 760F            	  5527:     moveq   #15,D3
02:0004A9B8 7000            	  5528:     moveq   #0,D0
02:0004A9BA 41EC00AC        	  5529:     lea     ($00AC,A4),A0
02:0004A9BE 11803000        	  5530:     move.b  D0,(A0,D3.W)
02:0004A9C2 0A3C0001        	  5531:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004A9C6 4E75            	  5532:     rts
                            	  5533: 
                            	  5534:     even
