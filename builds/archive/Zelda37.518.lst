                            	   498: ;------------------------------------------------------------------------------
                            	   499: ; _ags_prearm — Promote the previously staged scroll state into the active
                            	   500: ;               queue at START of vblank, BEFORE IsrNmi runs. This guarantees
                            	   501: ;               a coherent current-frame fallback even if the post-NMI flush
                            	   502: ;               finishes too late to safely touch VDP state for the same frame.
                            	   503: ;
                            	   504: ; Promotes the staged scroll state prepared by the previous frame's _ags_flush
                            	   505: ; into the active queue consumed by HBlankISR, then applies it immediately.
                            	   506: ;
                            	   507: ; Reads:  STAGED_SCROLL_MODE, STAGED_HINT_CTR, STAGED_BASE_VSRAM,
                            	   508: ;         STAGED_EVENT_VSRAM
                            	   509: ; Writes: HINT_Q_COUNT, HINT_Q0_CTR, HINT_Q0_VSRAM, HINT_PEND_SPLIT,
                            	   510: ;         INTRO_SCROLL_MODE
                            	   511: ; Preserves: D1-D7, A0-A6  (clobbers D0 internally, saved/restored)
                            	   512: ;------------------------------------------------------------------------------
                            	   513: _ags_prearm:
02:00010368 48E78000        	   514:     movem.l D0,-(SP)
02:0001036C 6108            	   515:     bsr     _ags_activate_staged
02:0001036E 616C            	   516:     bsr     _ags_apply_active
02:00010370 4CDF0001        	   517:     movem.l (SP)+,D0
02:00010374 4E75            	   518:     rts
                            	   519: 
                            	   520: ;------------------------------------------------------------------------------
                            	   521: ; _ags_activate_staged — Promote STAGED_* into the active queue/debug state.
                            	   522: ; Clobbers D0.
                            	   523: ;------------------------------------------------------------------------------
                            	   524: _ags_activate_staged:
02:00010376 103900FF080A    	   525:     move.b  (STAGED_SCROLL_MODE).l,D0
02:0001037C 13C000FF081F    	   526:     move.b  D0,(INTRO_SCROLL_MODE).l
02:00010382 33F900FF080C00FF	   527:     move.w  (STAGED_BASE_VSRAM).l,(ACTIVE_BASE_VSRAM).l
02:0001038A 0836
02:0001038C 33F900FF080E00FF	   528:     move.w  (STAGED_EVENT_VSRAM).l,(ACTIVE_EVENT_VSRAM).l
02:00010394 0838
02:00010396 13F900FF080B00FF	   529:     move.b  (STAGED_HINT_CTR).l,(ACTIVE_HINT_CTR).l
02:0001039E 083A
02:000103A0 4A00            	   530:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,D0
02:000103A2 6726            	   531:     beq.s   .aas_no_split
02:000103A4 13FC000100FF081E	   532:     move.b  #1,(HINT_PEND_SPLIT).l
02:000103AC 13FC000100FF0816	   533:     move.b  #1,(HINT_Q_COUNT).l
02:000103B4 13F900FF080B00FF	   534:     move.b  (STAGED_HINT_CTR).l,(HINT_Q0_CTR).l
02:000103BC 0817
02:000103BE 33F900FF080E00FF	   535:     move.w  (STAGED_EVENT_VSRAM).l,(HINT_Q0_VSRAM).l
02:000103C6 0818
02:000103C8 4E75            	   536:     rts
                            	   537: .aas_no_split:
02:000103CA 13FC000000FF081E	   538:     move.b  #0,(HINT_PEND_SPLIT).l
02:000103D2 13FC000000FF0816	   539:     move.b  #0,(HINT_Q_COUNT).l
02:000103DA 4E75            	   540:     rts
                            	   541: 
                            	   542: ;------------------------------------------------------------------------------
                            	   543: ; _ags_apply_active — Program VDP VSRAM/H-int state for the current frame from
                            	   544: ; the active queue/debug state set by _ags_activate_staged. For no-split and
                            	   545: ; intro dead-zone modes, the base VSRAM comes from ACTIVE_BASE_VSRAM.
                            	   546: ;
                            	   547: ; Clobbers D0.
                            	   548: ;------------------------------------------------------------------------------
                            	   549: _ags_apply_active:
02:000103DC 4A3900FF081F    	   550:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,(INTRO_SCROLL_MODE).l
02:000103E2 6636            	   551:     bne.s   .aaa_split
                            	   552:     ; No-split path. When DMC is NOT active, do the full H-int off sequence.
                            	   553:     ; When DMC IS active, skip the Reg 10 / Reg 0 writes so dmc_trigger's
                            	   554:     ; HINT arm survives -- DMC only fires in no-split contexts (see
                            	   555:     ; dmc_trigger gate), so there's no scroll-split to service this frame.
02:000103E4 4A3900FFE100    	   556:     tst.b   (dmc_active).l
02:000103EA 6610            	   557:     bne.s   .aaa_dmc_vsram_only
02:000103EC 33FC8AFF00C00004	   558:     move.w  #$8AFF,(VDP_CTRL).l             ; Reg 10 = $FF (inactive)
02:000103F4 33FC800400C00004	   559:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: H-int off
                            	   560: .aaa_dmc_vsram_only:
02:000103FC 23FC4000001000C0	   561:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00010404 0004
02:00010406 33F900FF083600C0	   562:     move.w  (ACTIVE_BASE_VSRAM).l,(VDP_DATA).l
02:0001040E 0000
02:00010410 7000            	   563:     moveq   #0,D0
02:00010412 33C000C00000    	   564:     move.w  D0,(VDP_DATA).l
02:00010418 4E75            	   565:     rts
                            	   566: .aaa_split:
02:0001041A 23FC4000001000C0	   567:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00010422 0004
02:00010424 7000            	   568:     moveq   #0,D0
02:00010426 0C39000100FF081F	   569:     cmpi.b  #INTRO_SCROLL_GAME_SPLIT,(INTRO_SCROLL_MODE).l
02:0001042E 6706            	   570:     beq.s   .aaa_base_ready
02:00010430 303900FF0836    	   571:     move.w  (ACTIVE_BASE_VSRAM).l,D0
                            	   572: .aaa_base_ready:
02:00010436 33C000C00000    	   573:     move.w  D0,(VDP_DATA).l
02:0001043C 7000            	   574:     moveq   #0,D0
02:0001043E 33C000C00000    	   575:     move.w  D0,(VDP_DATA).l
02:00010444 7000            	   576:     moveq   #0,D0
02:00010446 103900FF0817    	   577:     move.b  (HINT_Q0_CTR).l,D0
02:0001044C 024000FF        	   578:     andi.w  #$00FF,D0
02:00010450 807C8A00        	   579:     or.w    #$8A00,D0
02:00010454 33C000C00004    	   580:     move.w  D0,(VDP_CTRL).l                 ; Reg 10 = active H-int scanline
02:0001045A 33FC801400C00004	   581:     move.w  #$8014,(VDP_CTRL).l             ; Reg 0: enable H-int (+colorfix bit)
02:00010462 4E75            	   582:     rts
                            	   583: 
                            	   584: ;------------------------------------------------------------------------------
                            	   585: ; _mode_transition_check — runs from VBlankISR after _ags_prearm, before
                            	   586: ; IsrNmi.  Detects a change in GameMode ($0012) against the LAST_GAMEMODE
                            	   587: ; shadow and, on transition, purges stale scroll latches, zeros the two
                            	   588: ; VSRAM words directly via the VDP control port, and rewinds the DynTileBuf
                            	   589: ; palette-precheck state so _patch_z06 P3 runs fresh on the new mode's
                            	   590: ; first tile transfer.
                            	   591: ;
                            	   592: ; Fixes VSRAM bleed-through seen when leaving attract → file-select →
                            	   593: ; gameplay: the new mode inherited the old mode's vertical scroll register
                            	   594: ; value for a single frame before the first _ags_flush landed.
                            	   595: ;
                            	   596: ; Preserves: D1-D7, A0-A6 (clobbers D0 internally and restores it).
                            	   597: ;------------------------------------------------------------------------------
                            	   598: _mode_transition_check:
02:00010464 2F00            	   599:     move.l  D0,-(SP)
02:00010466 102C0012        	   600:     move.b  ($0012,A4),D0
02:0001046A B03900FF083E    	   601:     cmp.b   (LAST_GAMEMODE).l,D0
02:00010470 6760            	   602:     beq.s   .mtc_done
                            	   603:     ; --- mode changed: latch new shadow and purge stale PPU state ---
02:00010472 13C000FF083E    	   604:     move.b  D0,(LAST_GAMEMODE).l
02:00010478 423900FF0800    	   605:     clr.b   (PPU_LATCH).l
02:0001047E 427900FF0802    	   606:     clr.w   (PPU_VADDR).l
02:00010484 423900FF0809    	   607:     clr.b   (PPU_DHALF).l
02:0001048A 423900FF0808    	   608:     clr.b   (PPU_DBUF).l
                            	   609:     ; Phase 9: PPU_SCRL_X/Y clears removed (dead — never read)
                            	   610:     ; Direct VSRAM[0] + VSRAM[1] = 0 (inside vblank window).
02:00010490 23FC4000001000C0	   611:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00010498 0004
02:0001049A 33FC000000C00000	   612:     move.w  #0,(VDP_DATA).l          ; Plane A V-scroll
02:000104A2 33FC000000C00000	   613:     move.w  #0,(VDP_DATA).l          ; Plane B V-scroll
                            	   614:     ; Preserve any live transfer work across a mode transition.
                            	   615:     ;
                            	   616:     ; Two cases matter:
                            	   617:     ;  1) DynTileBuf non-empty: pending dynamic record must survive.
                            	   618:     ;  2) TileBufSelector non-zero: pending static transfer request must survive.
                            	   619:     ;
                            	   620:     ; Room scroll transitions rely on selector-driven transfers after the mode
                            	   621:     ; has already changed, so clearing $0014 here when DynTileBuf is empty is
                            	   622:     ; too aggressive.
02:000104AA 4A2C0014        	   623:     tst.b   ($0014,A4)
02:000104AE 6622            	   624:     bne.s   .mtc_keep_pending
02:000104B0 0C2C00FF0302    	   625:     cmpi.b  #$FF,($0302,A4)
02:000104B6 661A            	   626:     bne.s   .mtc_keep_pending
                            	   627:     ; No pending selector and DynTileBuf empty: safe to rewind the
                            	   628:     ; palette-precheck state and clear stale one-shots from the old mode.
02:000104B8 422C0014        	   629:     clr.b   ($0014,A4)               ; PPU update request byte
02:000104BC 422C005C        	   630:     clr.b   ($005C,A4)               ; SwitchNameTablesReq one-shot
02:000104C0 197C003F0300    	   631:     move.b  #63,($0300,A4)
02:000104C6 197C00000301    	   632:     move.b  #0,($0301,A4)
02:000104CC 197C00FF0302    	   633:     move.b  #$FF,($0302,A4)
                            	   634: .mtc_keep_pending:
                            	   635: .mtc_done:
02:000104D2 201F            	   636:     move.l  (SP)+,D0
02:000104D4 4E75            	   637:     rts
                            	   638: 
                            	   639: 
                            	   640: 
                            	   641: ;------------------------------------------------------------------------------
                            	   642: ; _ppu_write_6 — PPUADDR ($2006)  ← T5 key implementation
                            	   643: ;
                            	   644: ; The NES PPU address register uses a two-write protocol (shared "w" latch):
                            	   645: ;   First  write: high byte of 15-bit VRAM address (bit 14 is forced clear by
                            	   646: ;                 hardware — valid VRAM is $0000–$3FFF).
                            	   647: ;   Second write: low byte.  After this write PPU_VADDR is fully updated and
                            	   648: ;                 the latch resets to 0.
                            	   649: ;
                            	   650: ; Side effect: resets the even-byte PPUDATA buffer (PPU_DHALF = 0) so that a
                            	   651: ; fresh address is always treated as the start of a new word-pair.
                            	   652: ;
                            	   653: ; Preserves: D1.
                            	   654: ;------------------------------------------------------------------------------
                            	   655: _ppu_write_6:
02:000104D6 48E74000        	   656:     movem.l D1,-(SP)
02:000104DA 123900FF0800    	   657:     move.b  (PPU_LATCH).l,D1
02:000104E0 4A01            	   658:     tst.b   D1
02:000104E2 6618            	   659:     bne.s   .second_write_6
                            	   660:     ; ---- First write: high byte ----
                            	   661:     ; High byte goes into PPU_VADDR+0.  Force bit 6 (addr bit 14) clear to
                            	   662:     ; keep address in the valid $0000–$3FFF window (matches NES hardware).
02:000104E4 0200003F        	   663:     andi.b  #$3F,D0
02:000104E8 13C000FF0802    	   664:     move.b  D0,(PPU_VADDR).l        ; store high byte
02:000104EE 13FC000100FF0800	   665:     move.b  #1,(PPU_LATCH).l
02:000104F6 4CDF0002        	   666:     movem.l (SP)+,D1
02:000104FA 4E75            	   667:     rts
                            	   668: .second_write_6:
                            	   669:     ; ---- Second write: low byte ----
02:000104FC 13C000FF0803    	   670:     move.b  D0,(PPU_VADDR+1).l      ; store low byte
02:00010502 423900FF0800    	   671:     clr.b   (PPU_LATCH).l           ; reset w register
02:00010508 423900FF0809    	   672:     clr.b   (PPU_DHALF).l           ; discard any pending even-byte buffer
02:0001050E 4CDF0002        	   673:     movem.l (SP)+,D1
02:00010512 4E75            	   674:     rts
                            	   675: 
                            	   676: ;------------------------------------------------------------------------------
                            	   677: ; _ppu_write_7 — PPUDATA ($2007)  ← T16 full implementation
                            	   678: ;
                            	   679: ; Routes byte writes to one of two paths based on PPU_VADDR:
                            	   680: ;
                            	   681: ;   CHR-RAM path  (PPU_VADDR $0000–$1FFF):
                            	   682: ;     Accumulates 16 bytes per NES tile in CHR_TILE_BUF, then on the 16th
                            	   683: ;     byte converts the 2BPP NES tile to 4BPP Genesis format and writes the
                            	   684: ;     32-byte result to VDP VRAM at Genesis addr = NES_addr × 2.
                            	   685: ;
                            	   686: ;   Nametable/palette path (PPU_VADDR $2000–$3FFF):
                            	   687: ;     Buffers even-address bytes and flushes pairs as 16-bit VDP words
                            	   688: ;     (unchanged from T5 — correct for nametable clears and palette writes).
                            	   689: ;
                            	   690: ; NES 2BPP → Genesis 4BPP conversion:
                            	   691: ;   16 bytes in: 8 bytes plane-0 then 8 bytes plane-1 (one bit per pixel)
                            	   692: ;   32 bytes out: 4 bytes per row, 2 pixels per byte, high-nibble = left pixel
                            	   693: ;   Pixel color = (plane1_bit << 1) | plane0_bit   (values 0–3)
                            	   694: ;
                            	   695: ; VDP auto-increment = 2 (Reg 15 = $8F02 set by genesis_shell).
                            	   696: ; PPU_VADDR increments by 1 (horizontal mode, bit 2 of PPUCTRL = 0).
                            	   697: ;
                            	   698: ; Preserves: D0–D6, A0–A6 (all saved/restored).
                            	   699: ;------------------------------------------------------------------------------
                            	   700: _ppu_write_7:
02:00010514 48E7FEC0        	   701:     movem.l D0-D6/A0-A1,-(SP)       ; save all working registers (A1 used by LUT in .chr_convert_upload)
                            	   702: 
02:00010518 323900FF0802    	   703:     move.w  (PPU_VADDR).l,D1        ; D1 = current NES PPU address
                            	   704: 
                            	   705:     ; Route: CHR range ($0000–$1FFF) vs nametable/palette ($2000–$3FFF)
02:0001051E 0C412000        	   706:     cmpi.w  #$2000,D1
02:00010522 647E            	   707:     bhs     .nt_write               ; ≥$2000 → nametable / palette path
                            	   708: 
                            	   709:     ;==========================================================================
                            	   710:     ; CHR TILE BUFFER PATH
                            	   711:     ;==========================================================================
                            	   712:     ; Buffer each byte.  On the 16th byte, convert the tile and upload it.
02:00010524 523900FF0834    	   713:     addq.b  #1,(CHR_HIT_COUNT).l   ; DEBUG: count every CHR path entry (wraps at 255)
02:0001052A 7400            	   714:     moveq   #0,D2
02:0001052C 143900FF0830    	   715:     move.b  (CHR_BUF_CNT).l,D2     ; D2 = bytes accumulated so far (0–15)
                            	   716: 
                            	   717:     ; Save this tile's base address on the first byte (aligned to 16 bytes)
02:00010532 4A02            	   718:     tst.b   D2
02:00010534 660C            	   719:     bne.s   .chr_store_byte
02:00010536 3601            	   720:     move.w  D1,D3
02:00010538 0243FFF0        	   721:     andi.w  #$FFF0,D3               ; round down to 16-byte tile boundary
02:0001053C 33C300FF0832    	   722:     move.w  D3,(CHR_BUF_VADDR).l
                            	   723: 
                            	   724: .chr_store_byte:
02:00010542 41F900FF0820    	   725:     lea     (CHR_TILE_BUF).l,A0
02:00010548 11802000        	   726:     move.b  D0,(A0,D2.w)            ; CHR_TILE_BUF[count] = byte
02:0001054C 523900FF0830    	   727:     addq.b  #1,(CHR_BUF_CNT).l     ; increment count
02:00010552 6100032C        	   728:     bsr     .inc_ppuaddr            ; advance PPU_VADDR
                            	   729: 
02:00010556 0C39001000FF0830	   730:     cmpi.b  #16,(CHR_BUF_CNT).l
02:0001055E 663C            	   731:     bne.s   .chr_ret                ; not yet 16 bytes — keep buffering
                            	   732: 
                            	   733:     ; Complete tile — convert 2BPP → 4BPP and upload to VDP VRAM
                            	   734:     ifne CHR_EXPANSION_ENABLED
                            	   735:     ; Dispatch by NES address bit 12:
                            	   736:     ;   bit12=0 ($0000-$0FFF) → sprite half → _chr_upload_sprite_4x (4 copies)
                            	   737:     ;   bit12=1 ($1000-$1FFF) → BG half     → _chr_convert_upload   (1 copy)
                            	   738:     ; Preflight (reports/chr_preflight.txt) confirms PPUCTRL bit 3 = 0 always,
                            	   739:     ; so sprites live at $0000-$0FFF for all current scenes.
02:00010560 343900FF0832    	   740:     move.w  (CHR_BUF_VADDR).l,D2
02:00010566 0802000C        	   741:     btst    #12,D2
02:0001056A 6606            	   742:     bne.s   .chr_bg_dispatch
