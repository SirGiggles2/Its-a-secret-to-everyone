02:00042A70 E208            	  6876:     lsr.b  #1,D0   ; LSR A
02:00042A72 7400            	  6877:     moveq   #0,D2
02:00042A74 1400            	  6878:     move.b  D0,D2
02:00042A76 41F900048C94    	  6879:     lea     (PlayAreaColumnAddrs).l,A0
02:00042A7C 10302000        	  6880:     move.b  (A0,D2.W),D0
