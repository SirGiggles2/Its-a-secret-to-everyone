                            	  8509: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8510:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8511:     ;
02:0003DF76 10342070        	  8512:     move.b  ($70,A4,D2.W),D0
02:0003DF7A 023C00EE        	  8513:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF7E 41F90003DF68    	  8514:     lea     (GanonSpriteOffsetsX).l,A0
02:0003DF84 12303000        	  8515:     move.b  (A0,D3.W),D1
02:0003DF88 D101            	  8516:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003DF8A 1880            	  8517:     move.b  D0,($0000,A4)
                            	  8518:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8519:     ;
02:0003DF8C 41EC0084        	  8520:     lea     ($0084,A4),A0
02:0003DF90 10302000        	  8521:     move.b  (A0,D2.W),D0
02:0003DF94 023C00EE        	  8522:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF98 41F90003DF6C    	  8523:     lea     (GanonSpriteOffsetsY).l,A0
02:0003DF9E 12303000        	  8524:     move.b  (A0,D3.W),D1
02:0003DFA2 D101            	  8525:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003DFA4 19400001        	  8526:     move.b  D0,($0001,A4)
                            	  8527:     ; Each part has a horizontal flipping flag.
                            	  8528:     ;
02:0003DFA8 41F90003DF70    	  8529:     lea     (GanonSpriteHFlips).l,A0
02:0003DFAE 10303000        	  8530:     move.b  (A0,D3.W),D0
02:0003DFB2 1940000F        	  8531:     move.b  D0,($000F,A4)
                            	  8532:     ; Save and copy the loop index (the current part) to [07].
                            	  8533:     ;
02:0003DFB6 1003            	  8534:     move.b  D3,D0
02:0003DFB8 1B00            	  8535:     move.b  D0,-(A5)  ; PHA
02:0003DFBA 19400007        	  8536:     move.b  D0,($0007,A4)
                            	  8537:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8538:     ; that make it up.
                            	  8539:     ;
02:0003DFBE 41EC046B        	  8540:     lea     ($046B,A4),A0
02:0003DFC2 10302000        	  8541:     move.b  (A0,D2.W),D0
02:0003DFC6 E308            	  8542:     lsl.b  #1,D0   ; ASL A
02:0003DFC8 E308            	  8543:     lsl.b  #1,D0   ; ASL A
                            	  8544:     ; Add [07] -- the index of the current part.
                            	  8545:     ;
                            	  8546:     ; Now you have an index into the frame image table, for the
                            	  8547:     ; current image part of the current animation frame.
                            	  8548:     ;
02:0003DFCA 122C0007        	  8549:     move.b  ($0007,A4),D1
02:0003DFCE D101            	  8550:     addx.b  D1,D0   ; ADC $07
