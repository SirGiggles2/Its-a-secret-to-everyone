02:0004302C 613E            	  7247:     jsr     GetPassedDoorType
                            	  7248:     ; If the door attribute is "false wall",
                            	  7249:     ; then play the "found secret" tune.
02:0004302E 1B00            	  7250:     move.b  D0,-(A5)  ; PHA
02:00043030 02000007        	  7251:     andi.b #$07,D0
02:00043034 0C000002        	  7252:     cmpi.b  #$02,D0
02:00043038 6606            	  7253:     bne  _anon_z05_156
02:0004303A 7004            	  7254:     moveq   #4,D0
02:0004303C 19400602        	  7255:     move.b  D0,($0602,A4)
                            	  7256: _anon_z05_156:
02:00043040 101D            	  7257:     move.b  (A5)+,D0  ; PLA
                            	  7258:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7259:     ; then the player walked all the way to the edge of the play
                            	  7260:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7261:     ;
                            	  7262:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7263:     ; edge of the play area. So, set a relative position that
                            	  7264:     ; reflects that distance: $28 or -$28.
                            	  7265:     ;
                            	  7266:     ; If walking in a decreasing direction (left or up), then
                            	  7267:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7268:     ;
                            	  7269:     ; If walking in an increasing direction (right or down), then
                            	  7270:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7271:     ;
02:00043042 02000007        	  7272:     andi.b #$07,D0
02:00043046 0C000002        	  7273:     cmpi.b  #$02,D0
02:0004304A 6506            	  7274:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:0004304C 0C000005        	  7275:     cmpi.b  #$05,D0
02:00043050 6502            	  7276:     bcs  _anon_z05_157
                            	  7277:     even
                            	  7278: _L_z05_InitMode6_SetWalkDistance0:
02:00043052 7602            	  7279:     moveq   #2,D3
