01:000000D8 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000D9 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000DA 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
