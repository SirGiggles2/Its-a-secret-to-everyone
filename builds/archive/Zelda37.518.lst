                            	   337:     ;
02:00030064 610003DE        	   338:     jsr     DriveTune1
02:00030068 6100020C        	   339:     jsr     DriveEffect
02:0003006C 61000502        	   340:     jsr     DriveSample
02:00030070 610006A2        	   341:     jsr     DriveSong
