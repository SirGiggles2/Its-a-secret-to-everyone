                            	  7533: Submenu_CueTransferRowUW:
                            	  7534:     ; If menu scroll value is negative, then we transferred everything.
                            	  7535:     ; So, return.
                            	  7536:     ;
02:00043256 102C005E        	  7537:     move.b  ($005E,A4),D0
02:0004325A 6A02            	  7538:     bpl.s  __far_z_05_0084
02:0004325C 6030            	  7539:     jmp  L1725A_Exit
                            	  7540: __far_z_05_0084:
                            	  7541:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7542:     ; and represents the current row of the submenu being processed.
                            	  7543:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7544:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7545:     ;
                            	  7546:     ; If the bottom bit is set, go prepare the full black row.
                            	  7547:     ;
02:0004325E E208            	  7548:     lsr.b  #1,D0   ; LSR A
02:00043260 7600            	  7549:     moveq   #0,D3
02:00043262 1600            	  7550:     move.b  D0,D3
02:00043264 6402            	  7551:     bcc.s  __far_z_05_0085
02:00043266 6028            	  7552:     jmp  PrepFullBlackRow
                            	  7553: __far_z_05_0085:
                            	  7554:     ; Submenu rows $D to $15 are parts of the map.
                            	  7555:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7556:     ;
                            	  7557:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7558:     ; buffer for this row.
                            	  7559:     ;
02:00043268 0C00000D        	  7560:     cmpi.b  #$0D,D0
02:0004326C 640C            	  7561:     bcc  _anon_z05_167
02:0004326E 41F900043232    	  7562:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00043274 10303000        	  7563:     move.b  (A0,D3.W),D0
                            	  7564:     even
