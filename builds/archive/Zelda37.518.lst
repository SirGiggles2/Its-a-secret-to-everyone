02:0003C160 9101            	  4461:     subx.b  D1,D0   ; SBC $03
02:0003C162 0A3C0010        	  4462:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C166 19802070        	  4463:     move.b  D0,($70,A4,D2.W)
                            	  4464:     even
