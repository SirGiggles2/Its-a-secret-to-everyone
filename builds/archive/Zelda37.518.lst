02:0003C172 122C0002        	  4470:     move.b  ($0002,A4),D1
02:0003C176 E309            	  4471:     lsl.b  #1,D1   ; ASL $02
02:0003C178 19410002        	  4472:     move.b  D1,($0002,A4)
02:0003C17C 122C0002        	  4473:     move.b  ($0002,A4),D1
02:0003C180 C200            	  4474:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C182 6716            	  4475:     beq  _L_z04_Digdogger_Move_Up
02:0003C184 41EC0084        	  4476:     lea     ($0084,A4),A0
02:0003C188 10302000        	  4477:     move.b  (A0,D2.W),D0
02:0003C18C 122C0003        	  4478:     move.b  ($0003,A4),D1
02:0003C190 D101            	  4479:     addx.b  D1,D0   ; ADC $03
02:0003C192 41EC0084        	  4480:     lea     ($0084,A4),A0
02:0003C196 11802000        	  4481:     move.b  D0,(A0,D2.W)
                            	  4482:     even
