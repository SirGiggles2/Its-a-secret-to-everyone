                            	  1388: ;----------------------------------------------------------------------
                            	  1389: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1390: ; Layout per slot:
                            	  1391: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1392: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1393: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1394: ;   +3 reserved
                            	  1395: ;
                            	  1396: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1397: ; values are placeholders.
                            	  1398: ;----------------------------------------------------------------------
                            	  1399: PsgDrumTable:
02:00000E9E E7              	  1400:     dc.b    $E7, $00, $00, $00         ; 0: rest (handled by early-out)
02:00000E9F 00
02:00000EA0 00
02:00000EA1 00
02:00000EA2 E4              	  1401:     dc.b    $E4, $E0, 48,  $00         ; 1: hi-hat  — white NF=00, ~5 frames
02:00000EA3 E0
02:00000EA4 30
02:00000EA5 00
02:00000EA6 E5              	  1402:     dc.b    $E5, $FF, 14,  $00         ; 2: snare   — white NF=01, ~18 frames
02:00000EA7 FF
02:00000EA8 0E
02:00000EA9 00
02:00000EAA E4              	  1403:     dc.b    $E4, $E0, 48,  $00         ; 3: hi-hat alt
02:00000EAB E0
02:00000EAC 30
02:00000EAD 00
