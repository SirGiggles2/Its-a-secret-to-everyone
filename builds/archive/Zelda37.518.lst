02:0004390A 1214            	  8550:     move.b  ($00,A4),D1   ; ptr lo
02:0004390C 182C0001        	  8551:     move.b  ($01,A4),D4  ; ptr hi
02:00043910 024100FF        	  8552:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043914 E14C            	  8553:     lsl.w   #8,D4
02:00043916 8841            	  8554:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043918 48C4            	  8555:     ext.l   D4
