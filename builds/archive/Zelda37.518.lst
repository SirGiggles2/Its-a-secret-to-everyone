                            	  2176:     even
                            	  2177: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2178:     ; At this point:
                            	  2179:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2180:     ;   - This will be changed as the player inputs characters.
                            	  2181:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2182:     ;   - This will be changed as the player inputs characters.
                            	  2183:     ; - InitializedNameField [$0420] is set to 1.
                            	  2184:     ;
02:0003592A 102C00F8        	  2185:     move.b  ($00F8,A4),D0
02:0003592E 020000C0        	  2186:     andi.b #$C0,D0
02:00035932 670000E8        	  2187:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2188:     ; A or B was pressed.
                            	  2189:     ;
02:00035936 0C000040        	  2190:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:0003593A 660000A6        	  2191:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2192:     ; A was pressed.
                            	  2193:     ;
                            	  2194:     ; Request to play the character click tune (same as bomb set).
02:0003593E 7620            	  2195:     moveq   #32,D3
02:00035940 19430604        	  2196:     move.b  D3,($0604,A4)
02:00035944 7602            	  2197:     moveq   #2,D3
                            	  2198:     even
                            	  2199: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00035946 41EC0422        	  2200:     lea     ($0422,A4),A0
02:0003594A 10303000        	  2201:     move.b  (A0,D3.W),D0
02:0003594E 41EC0302        	  2202:     lea     ($0302,A4),A0
02:00035952 11803000        	  2203:     move.b  D0,(A0,D3.W)
02:00035956 5303            	  2204:     subq.b  #1,D3
02:00035958 6AEC            	  2205:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
