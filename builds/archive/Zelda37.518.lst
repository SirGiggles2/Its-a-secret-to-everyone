02:0003C13E 10302000        	  4451:     move.b  (A0,D2.W),D0
02:0003C142 122C0002        	  4452:     move.b  ($0002,A4),D1
02:0003C146 E309            	  4453:     lsl.b  #1,D1   ; ASL $02
02:0003C148 19410002        	  4454:     move.b  D1,($0002,A4)
02:0003C14C 122C0002        	  4455:     move.b  ($0002,A4),D1
02:0003C150 C200            	  4456:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C152 6716            	  4457:     beq  _L_z04_Digdogger_Move_Down
02:0003C154 10342070        	  4458:     move.b  ($70,A4,D2.W),D0
