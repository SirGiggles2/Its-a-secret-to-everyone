02:0002D3D8 6718            	  3038:     beq.s   .ttf_chr_uploaded
02:0002D3DA 303900FF0832    	  3039:     move.w  (CHR_BUF_VADDR).l,D0
02:0002D3E0 0C401F20        	  3040:     cmpi.w  #$1F20,D0
02:0002D3E4 650C            	  3041:     blo.s   .ttf_chr_uploaded
02:0002D3E6 0C401F40        	  3042:     cmpi.w  #$1F40,D0
02:0002D3EA 6406            	  3043:     bhs.s   .ttf_chr_uploaded
02:0002D3EC 4EB900010944    	  3044:     bsr     _chr_upload_sprite_4x
