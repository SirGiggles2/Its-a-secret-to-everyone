02:0003C1A2 122C0002        	  4488:     move.b  ($0002,A4),D1
02:0003C1A6 E309            	  4489:     lsl.b  #1,D1   ; ASL $02
02:0003C1A8 19410002        	  4490:     move.b  D1,($0002,A4)
02:0003C1AC 122C0002        	  4491:     move.b  ($0002,A4),D1
02:0003C1B0 C200            	  4492:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C1B2 671E            	  4493:     beq  _L_z04_Digdogger_Move_End
02:0003C1B4 41EC0084        	  4494:     lea     ($0084,A4),A0
02:0003C1B8 10302000        	  4495:     move.b  (A0,D2.W),D0
02:0003C1BC 122C0003        	  4496:     move.b  ($0003,A4),D1
02:0003C1C0 0A3C0010        	  4497:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C1C4 9101            	  4498:     subx.b  D1,D0   ; SBC $03
02:0003C1C6 0A3C0010        	  4499:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C1CA 41EC0084        	  4500:     lea     ($0084,A4),A0
