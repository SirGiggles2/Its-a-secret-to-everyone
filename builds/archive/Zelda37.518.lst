02:0002CFB0 103900FFE02A    	  2450:     move.b  (m_sfx_ctrl_raw).l,D0
02:0002CFB6 0200000F        	  2451:     andi.b  #$0F,D0
02:0002CFBA 0C000004        	  2452:     cmpi.b  #$04,D0
02:0002CFBE 6512            	  2453:     bcs.s   .pg_short
