                            	  1491:     ; Add the acceleration to the speed fraction (low byte).
                            	  1492:     ;
02:0003AC0A 41EC041F        	  1493:     lea     ($041F,A4),A0
02:0003AC0E 10302000        	  1494:     move.b  (A0,D2.W),D0
02:0003AC12 023C00EE        	  1495:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC16 1214            	  1496:     move.b  ($0000,A4),D1
02:0003AC18 D101            	  1497:     addx.b  D1,D0   ; ADC $00
02:0003AC1A 41EC041F        	  1498:     lea     ($041F,A4),A0
02:0003AC1E 11802000        	  1499:     move.b  D0,(A0,D2.W)
                            	  1500:     ; Carry over to the high speed byte.
                            	  1501:     ;
02:0003AC22 41EC0412        	  1502:     lea     ($0412,A4),A0
02:0003AC26 10302000        	  1503:     move.b  (A0,D2.W),D0
02:0003AC2A 123C0000        	  1504:     move.b  #$00,D1
02:0003AC2E D101            	  1505:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AC30 41EC0412        	  1506:     lea     ($0412,A4),A0
02:0003AC34 11802000        	  1507:     move.b  D0,(A0,D2.W)
                            	  1508:     ; *Signed comparison*:
                            	  1509:     ; If the high speed byte < high max speed byte, then return.
                            	  1510:     ;
                            	  1511:     ; Note that this is not a general purpose signed comparison,
                            	  1512:     ; which would be more complicated. But it works because
                            	  1513:     ; the deviation from 0 of both values is small.
                            	  1514:     ;
02:0003AC38 122C0002        	  1515:     move.b  ($0002,A4),D1
