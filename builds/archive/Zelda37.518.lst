02:0003F724 6702            	  1504:     beq.s  __far_z_05_0024
02:0003F726 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
                            	  1507:     ; Submode 2.
                            	  1508:     ;
02:0003F728 7600            	  1509:     moveq   #0,D3
02:0003F72A 162C00EB        	  1510:     move.b  ($00EB,A4),D3
02:0003F72E 6100424E        	  1511:     jsr     IsDarkRoom_Bank5
02:0003F732 6702            	  1512:     beq.s  __far_z_05_0025
02:0003F734 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
                            	  1516:     ; See if we have to brighten it after leaving a dark room.
                            	  1517:     ;
02:0003F736 102C0098        	  1518:     move.b  ($0098,A4),D0
02:0003F73A 6100408A        	  1519:     jsr     CalcNextRoomByDir
                            	  1520:     ; Subtract RoomId from next room ID that was calculated
                            	  1521:     ; to get room ID offset in that direction.
02:0003F73E 003C0011        	  1522:     ori     #$11,CCR  ; SEC: set C+X
02:0003F742 122C00EB        	  1523:     move.b  ($00EB,A4),D1
02:0003F746 0A3C0010        	  1524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F74A 9101            	  1525:     subx.b  D1,D0   ; SBC RoomId
02:0003F74C 0A3C0010        	  1526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F750 4EB900032BE6    	  1527:     jsr     Negate
02:0003F756 023C00EE        	  1528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F75A 122C00EB        	  1529:     move.b  ($00EB,A4),D1
02:0003F75E D101            	  1530:     addx.b  D1,D0   ; ADC RoomId
02:0003F760 7600            	  1531:     moveq   #0,D3
02:0003F762 1600            	  1532:     move.b  D0,D3
02:0003F764 61004218        	  1533:     jsr     IsDarkRoom_Bank5
02:0003F768 6602            	  1534:     bne.s  __far_z_05_0026
02:0003F76A 601C            	  1535:     jmp  InitMode4_GoToSub0
                            	  1536: __far_z_05_0026:
                            	  1537:     ; The previous room was dark.
                            	  1538:     ;
