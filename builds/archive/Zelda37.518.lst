02:0002EADA 588F            	  3883:     addq.l  #4,SP
02:0002EADC 08000008        	  3884:     btst    #8,D0
02:0002EAE0 6706            	  3885:     beq.s   .cc_aqspf
02:0002EAE2 003C0011        	  3886:     ori     #$11,CCR
02:0002EAE6 4E75            	  3887:     rts
                            	  3888: .cc_aqspf:
02:0002EAE8 023C00EE        	  3889:     andi    #$EE,CCR
02:0002EAEC 4E75            	  3890:     rts
                            	  3891: 
