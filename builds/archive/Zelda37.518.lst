                            	  5033: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5034:     ; Advance the substate.
                            	  5035:     ;
02:0003C5B2 41EC042C        	  5036:     lea     ($042C,A4),A0
02:0003C5B6 52302000        	  5037:     addq.b  #1,(A0,D2.W)
                            	  5038:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5039:     ;
02:0003C5BA 41EC042C        	  5040:     lea     ($042C,A4),A0
02:0003C5BE 10302000        	  5041:     move.b  (A0,D2.W),D0
02:0003C5C2 0C000002        	  5042:     cmpi.b  #$02,D0
