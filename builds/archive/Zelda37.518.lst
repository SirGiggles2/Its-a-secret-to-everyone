                            	  5600: AnimateBoomerangAndCheckCollision:
                            	  5601:     ; Decrement animation counter; and when it reaches 0:
                            	  5602:     ; 1. arm it again for 2 frames
                            	  5603:     ; 2. advance the minor state within a cycle of 8
                            	  5604:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5605:     ;
02:0004AA58 41EC03D0        	  5606:     lea     ($03D0,A4),A0
02:0004AA5C 53302000        	  5607:     subq.b  #1,(A0,D2.W)
02:0004AA60 6702            	  5608:     beq.s  __far_z_07_0080
02:0004AA62 6036            	  5609:     jmp  DrawBoomerangAndCheckCollision
                            	  5610: __far_z_07_0080:
02:0004AA64 7002            	  5611:     moveq   #2,D0
02:0004AA66 41EC03D0        	  5612:     lea     ($03D0,A4),A0
02:0004AA6A 11802000        	  5613:     move.b  D0,(A0,D2.W)
02:0004AA6E 41EC00AC        	  5614:     lea     ($00AC,A4),A0
02:0004AA72 52302000        	  5615:     addq.b  #1,(A0,D2.W)
02:0004AA76 41EC00AC        	  5616:     lea     ($00AC,A4),A0
02:0004AA7A 10302000        	  5617:     move.b  (A0,D2.W),D0
02:0004AA7E 02000077        	  5618:     andi.b #$77,D0
02:0004AA82 41EC00AC        	  5619:     lea     ($00AC,A4),A0
02:0004AA86 11802000        	  5620:     move.b  D0,(A0,D2.W)
02:0004AA8A 0C02000D        	  5621:     cmpi.b  #$0D,D2
02:0004AA8E 6402            	  5622:     bcc.s  __far_z_07_0081
02:0004AA90 6032            	  5623:     jmp  CalcBoomerangFrame
                            	  5624: __far_z_07_0081:
02:0004AA92 7602            	  5625:     moveq   #2,D3
02:0004AA94 4EB900032B7A    	  5626:     jsr     PlayBoomerangSfx
                            	  5627:     even
                            	  5628: DrawBoomerangAndCheckCollision:
                            	  5629:     ; If the boomerang belongs to a monster, then check for
                            	  5630:     ; collision with Link.
                            	  5631:     ;
                            	  5632:     ; If they collide, then set state $20 and animation counter 3.
                            	  5633:     ;
02:0004AA9A 0C02000D        	  5634:     cmpi.b  #$0D,D2
02:0004AA9E 6502            	  5635:     bcs.s  __far_z_07_0082
02:0004AAA0 6022            	  5636:     jmp  CalcBoomerangFrame
