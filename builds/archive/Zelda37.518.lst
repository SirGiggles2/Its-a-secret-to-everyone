02:0003AC92 10302000        	  1565:     move.b  (A0,D2.W),D0
02:0003AC96 0C000011        	  1566:     cmpi.b  #$11,D0
02:0003AC9A 662A            	  1567:     bne  _L_z04_UpdateBurrower_CycleState
02:0003AC9C 7600            	  1568:     moveq   #0,D3
02:0003AC9E 41EC00AC        	  1569:     lea     ($00AC,A4),A0
