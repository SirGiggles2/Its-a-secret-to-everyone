                            	   271: InitCaveContinue:
                            	   272:     ; Get this cave's index (object type - $6A).
                            	   273:     ;
02:0003138C 102C0350        	   274:     move.b  ($0350,A4),D0
02:00031390 003C0011        	   275:     ori     #$11,CCR  ; SEC: set C+X
02:00031394 123C006A        	   276:     move.b  #$6A,D1
02:00031398 0A3C0010        	   277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003139C 9101            	   278:     subx.b  D1,D0   ; SBC #$6A
02:0003139E 0A3C0010        	   279:     eori    #$10,CCR  ; restore X = 6502 C
02:000313A2 7600            	   280:     moveq   #0,D3
02:000313A4 1600            	   281:     move.b  D0,D3
                            	   282:     ; Get the person text selector by looking up the text selector byte
                            	   283:     ; for this index, and masking it with $3F.
                            	   284:     ;
02:000313A6 41F900031356    	   285:     lea     (OverworldPersonTextSelectors).l,A0
02:000313AC 10303000        	   286:     move.b  (A0,D3.W),D0
02:000313B0 1B00            	   287:     move.b  D0,-(A5)  ; PHA
02:000313B2 0200003F        	   288:     andi.b #$3F,D0
02:000313B6 19400415        	   289:     move.b  D0,($0415,A4)
                            	   290:     ; Pop and mask the text selector byte with $C0 to get the
                            	   291:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   292:     ;
02:000313BA 101D            	   293:     move.b  (A5)+,D0  ; PLA
02:000313BC 020000C0        	   294:     andi.b #$C0,D0
02:000313C0 19400003        	   295:     move.b  D0,($0003,A4)
                            	   296:     ; At this point, the Y register still has the cave index.
                            	   297:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   298:     ;
02:000313C4 103C00FD        	   299:     move.b  #$FD,D0
                            	   300: _anon_z01_0:
02:000313C8 023C00EE        	   301:     andi    #$EE,CCR  ; CLC: clear C+X
02:000313CC 123C0003        	   302:     move.b  #$03,D1
02:000313D0 D101            	   303:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000313D2 5303            	   304:     subq.b  #1,D3
02:000313D4 6AF2            	   305:     bpl  _anon_z01_0
02:000313D6 7600            	   306:     moveq   #0,D3
02:000313D8 1600            	   307:     move.b  D0,D3
                            	   308:     ; Loop over the wares from 0 to 2.
                            	   309:     ;
02:000313DA 7400            	   310:     moveq   #0,D2
                            	   311:     even
                            	   312: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   313:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   314:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   315:     ;
02:000313DC 41F900FF6A7E    	   316:     lea     (NES_SRAM+$0A7E).l,A0
02:000313E2 10303000        	   317:     move.b  (A0,D3.W),D0
02:000313E6 41EC0422        	   318:     lea     ($0422,A4),A0
02:000313EA 11802000        	   319:     move.b  D0,(A0,D2.W)
                            	   320:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   321:     ;
02:000313EE 020000C0        	   322:     andi.b #$C0,D0
02:000313F2 19802000        	   323:     move.b  D0,($00,A4,D2.W)
                            	   324:     ; Copy 3 prices from the Cave level block info.
