                            	   472: ;------------------------------------------------------------------------------
                            	   473: ; _ags_flush — Stage the NEXT frame's Genesis composition state and write
                            	   474: ;              H-scroll after IsrNmi has finalized the scroll shadows.
                            	   475: ;
                            	   476: ; This must not touch active-frame VSRAM/H-int state; the first
                            	   477: ; _apply_genesis_scroll hook inside IsrNmi owns current-frame application.
                            	   478: ;
                            	   479: ; Preserves: D5-D7, A0-A6.
                            	   480: ;------------------------------------------------------------------------------
                            	   481: _ags_flush:
02:00010338 48E7F800        	   482:     movem.l D0-D4,-(SP)
02:0001033C 6190            	   483:     bsr     _ags_compute_stage
                            	   484: 
                            	   485: .ags_hscroll:
                            	   486:     ; --- H-scroll (Plane A H-scroll table entry 0) ---
02:0001033E 7000            	   487:     moveq   #0,D0
02:00010340 102C00FD        	   488:     move.b  ($00FD,A4),D0              ; CurHScroll
02:00010344 4440            	   489:     neg.w   D0
02:00010346 024001FF        	   490:     andi.w  #$01FF,D0
02:0001034A 23FC7C00000300C0	   491:     move.l  #$7C000003,(VDP_CTRL).l    ; VRAM write at $FC00
02:00010352 0004
02:00010354 33C000C00000    	   492:     move.w  D0,(VDP_DATA).l            ; Plane A H-scroll
02:0001035A 7000            	   493:     moveq   #0,D0
02:0001035C 33C000C00000    	   494:     move.w  D0,(VDP_DATA).l            ; Plane B H-scroll = 0
02:00010362 4CDF001F        	   495:     movem.l (SP)+,D0-D4
02:00010366 4E75            	   496:     rts
