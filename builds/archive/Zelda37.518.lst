02:0003AECC 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:0003AECE 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:0003AED2 102C0001        	  1864:     move.b  ($0001,A4),D0
02:0003AED6 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:0003AEDA 122C0002        	  1866:     move.b  ($0002,A4),D1
02:0003AEDE 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AEE2 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:0003AEE4 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:0003AEE8 0C000030        	  1874:     cmpi.b  #$30,D0
02:0003AEEC 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
