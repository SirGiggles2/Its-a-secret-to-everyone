02:00031416 E308            	   340:     lsl.b  #1,D0   ; ASL A
02:00031418 E310            	   341:     roxl.b  #1,D0   ; ROL A
02:0003141A E310            	   342:     roxl.b  #1,D0   ; ROL A
02:0003141C 1214            	   343:     move.b  ($0000,A4),D1
02:0003141E 8001            	   344:     or.b  D1,D0
02:00031420 1880            	   345:     move.b  D0,($0000,A4)
                            	   346:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   347:     ; and combine them with [00].
                            	   348:     ;
02:00031422 102C0002        	   349:     move.b  ($0002,A4),D0
02:00031426 E208            	   350:     lsr.b  #1,D0   ; LSR A
02:00031428 E208            	   351:     lsr.b  #1,D0   ; LSR A
02:0003142A E208            	   352:     lsr.b  #1,D0   ; LSR A
02:0003142C E208            	   353:     lsr.b  #1,D0   ; LSR A
02:0003142E 1214            	   354:     move.b  ($0000,A4),D1
02:00031430 8001            	   355:     or.b  D1,D0
02:00031432 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   358:     ; and combine them with [00] into CaveFlags.
                            	   359:     ;
