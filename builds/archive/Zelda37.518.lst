02:00031438 E208            	   361:     lsr.b  #1,D0   ; LSR A
02:0003143A E208            	   362:     lsr.b  #1,D0   ; LSR A
02:0003143C 1214            	   363:     move.b  ($0000,A4),D1
02:0003143E 8001            	   364:     or.b  D1,D0
02:00031440 19400413        	   365:     move.b  D0,($0413,A4)
                            	   366:     ; The end result is a byte with 8 cave flags.
                            	   367:     ;
