Source: "audio_driver.asm"
                            	     2: 
                            	     3: ;==============================================================================
                            	     4: ; audio_driver.asm — YM2612 + PSG driver for NES APU emulation
                            	     5: ;
                            	     6: ; Maps NES APU channels to Genesis sound hardware using Sonic 2 Emerald Hill
                            	     7: ; Zone FM patches:
                            	     8: ;   Pulse 1 → YM2612 ch 0 (EHZ Voice $00, Algorithm 7)
                            	     9: ;   Pulse 2 → YM2612 ch 1 (EHZ Voice $03, Algorithm 5)
                            	    10: ;   Triangle → YM2612 ch 2 (EHZ Voice $07, Algorithm 0)
                            	    11: ;   Noise   → SN76489 PSG ch 3
                            	    12: ;
                            	    13: ; Include BEFORE nes_io.asm so helpers are available to APU stubs.
                            	    14: ;==============================================================================
                            	    15: 
                            	    16: ;----------------------------------------------------------------------
                            	    17: ; Hardware ports
                            	    18: ;----------------------------------------------------------------------
                            	    19: YM_ADDR1        equ $A04000     ; YM2612 Part I address  (ch 0-2 + global regs)
                            	    20: YM_DATA1        equ $A04001     ; YM2612 Part I data
                            	    21: YM_ADDR2        equ $A04002     ; YM2612 Part II address (ch 3-5 / ch 6 DAC pan)
                            	    22: YM_DATA2        equ $A04003     ; YM2612 Part II data
                            	    23: PSG_PORT        equ $C00011     ; SN76489 PSG data
                            	    24: 
                            	    25: ;----------------------------------------------------------------------
                            	    26: ; Shadow APU registers ($FF0A00–$FF0A15)
                            	    27: ; Clear of NES RAM ($FF0000-$FF07FF), PPU/MMC1 ($FF0800-$FF083F),
                            	    28: ; H-int queue ($FF0816-$FF081F), forensics ($FF0900-$FF0943).
                            	    29: ;----------------------------------------------------------------------
                            	    30: APU_SH_BASE     equ $FF0A00
                            	    31: APU_SH_4000     equ APU_SH_BASE+$00    ; Pulse 1 duty/volume
                            	    32: APU_SH_4001     equ APU_SH_BASE+$01    ; Pulse 1 sweep (unused)
                            	    33: APU_SH_4002     equ APU_SH_BASE+$02    ; Pulse 1 period low
                            	    34: APU_SH_4003     equ APU_SH_BASE+$03    ; Pulse 1 period high + length
                            	    35: APU_SH_4004     equ APU_SH_BASE+$04    ; Pulse 2 duty/volume
                            	    36: APU_SH_4005     equ APU_SH_BASE+$05    ; Pulse 2 sweep (unused)
                            	    37: APU_SH_4006     equ APU_SH_BASE+$06    ; Pulse 2 period low
                            	    38: APU_SH_4007     equ APU_SH_BASE+$07    ; Pulse 2 period high + length
                            	    39: APU_SH_4008     equ APU_SH_BASE+$08    ; Triangle linear counter
                            	    40: APU_SH_400A     equ APU_SH_BASE+$0A    ; Triangle period low
                            	    41: APU_SH_400B     equ APU_SH_BASE+$0B    ; Triangle period high + length
                            	    42: APU_SH_400C     equ APU_SH_BASE+$0C    ; Noise volume/envelope
                            	    43: APU_SH_400E     equ APU_SH_BASE+$0E    ; Noise mode + period
                            	    44: APU_SH_400F     equ APU_SH_BASE+$0F    ; Noise length counter
                            	    45: APU_SH_4015     equ APU_SH_BASE+$10    ; Channel enable flags
                            	    46: 
                            	    47: ;----------------------------------------------------------------------
                            	    48: ; Frequency conversion constants
                            	    49: ;
                            	    50: ; NES pulse:    f = CPU_CLK / (16 * (P+1)),   CPU_CLK = 1,789,773
                            	    51: ; NES triangle: f = CPU_CLK / (32 * (P+1))    (one octave lower)
                            	    52: ; YM2612:       f = (F_num * 2^block * YM_CLK) / (144 * 2^20)
                            	    53: ;                   YM_CLK = 7,670,453
                            	    54: ;
                            	    55: ; K_pulse = CPU_CLK * 144 * 2^20 / (16 * YM_CLK) ≈ 4,403,410
                            	    56: ; K5_pulse = K_pulse >> 5 = 137,606    (base block = 5)
                            	    57: ; K5_tri   = K5_pulse / 2 = 68,803     (triangle is one octave below pulse)
                            	    58: ;
                            	    59: ; Sanity check: NES A4 (P=253, P+1=254) → K5/254 = 541.75
                            	    60: ;               Standard YM2612 F_num for A4 at block 5 = 541. ✓
                            	    61: ;----------------------------------------------------------------------
                            	    62: NES_YM_K5_PULSE equ 137606
                            	    63: NES_YM_K5_TRI   equ 68803
                            	    64: 
                            	    65: ;==============================================================================
                            	    66: ; ym_write1 — Write one register to YM2612 Part I
                            	    67: ;
                            	    68: ; Input:  D0.b = register address
                            	    69: ;         D1.b = data value
                            	    70: ; Output: none
                            	    71: ; Preserves: all registers
                            	    72: ;
                            	    73: ; SR lockout: the address+data pair MUST go out as an atomic latched write.
                            	    74: ; With the HBlank-driven DMC streamer enabled, the HINT handler also writes
                            	    75: ; $2A + data to YM2612 Part I; if it preempts between our address write and
                            	    76: ; data write, the YM latch is left pointing at $2A and our subsequent data
                            	    77: ; byte lands in the DAC instead of the intended register.  Mask HINT (level
                            	    78: ; 4) for the duration of the pair by raising SR interrupt level to 6, then
                            	    79: ; restore the caller's SR on exit.  Cost: ~16 cycles per call.
                            	    80: ;==============================================================================
                            	    81: ym_write1:
02:000003D0 40E7            	    82:     move.w  SR,-(SP)                ; save caller's SR
02:000003D2 007C0600        	    83:     ori.w   #$0600,SR               ; mask HINT (level 4) + its below
                            	    84: .wait:
02:000003D6 4A3900A04000    	    85:     tst.b   (YM_ADDR1).l            ; bit 7 = busy flag
02:000003DC 6BF8            	    86:     bmi.s   .wait
02:000003DE 13C000A04000    	    87:     move.b  D0,(YM_ADDR1).l         ; write register address
02:000003E4 4E71            	    88:     nop                              ; address setup delay
02:000003E6 4E71            	    89:     nop
02:000003E8 4E71            	    90:     nop
02:000003EA 13C100A04001    	    91:     move.b  D1,(YM_DATA1).l         ; write data
02:000003F0 46DF            	    92:     move.w  (SP)+,SR                ; restore SR (re-enables HINT)
02:000003F2 4E75            	    93:     rts
                            	    94: 
                            	    95: ;==============================================================================
                            	    96: ; ym_write2 — Write one register to YM2612 Part II
                            	    97: ;
                            	    98: ; Used for ch 4-5 regs and ch 6 pan ($B4+2 = $B6 on Part II).  The busy flag
                            	    99: ; is shared across both parts so we still poll Part I.  Same SR lockout as
                            	   100: ; ym_write1 to prevent HINT-based DMC streamer from stomping the latch.
                            	   101: ;
                            	   102: ; Input:  D0.b = register address
                            	   103: ;         D1.b = data value
                            	   104: ; Output: none
                            	   105: ; Preserves: all registers
                            	   106: ;==============================================================================
                            	   107: ym_write2:
02:000003F4 40E7            	   108:     move.w  SR,-(SP)
02:000003F6 007C0600        	   109:     ori.w   #$0600,SR
                            	   110: .wait:
02:000003FA 4A3900A04000    	   111:     tst.b   (YM_ADDR1).l            ; busy flag is shared between parts
02:00000400 6BF8            	   112:     bmi.s   .wait
02:00000402 13C000A04002    	   113:     move.b  D0,(YM_ADDR2).l         ; write register address (Part II)
02:00000408 4E71            	   114:     nop
02:0000040A 4E71            	   115:     nop
02:0000040C 4E71            	   116:     nop
02:0000040E 13C100A04003    	   117:     move.b  D1,(YM_DATA2).l         ; write data (Part II)
02:00000414 46DF            	   118:     move.w  (SP)+,SR
02:00000416 4E75            	   119:     rts
                            	   120: 
                            	   121: ;==============================================================================
                            	   122: ; nes_to_ym_freq — Convert NES 11-bit period to YM2612 frequency
                            	   123: ;
                            	   124: ; Input:  D2.w = 11-bit NES period (0–2047)
                            	   125: ;         D3.l = K constant (NES_YM_K5_PULSE or NES_YM_K5_TRI)
                            	   126: ; Output: D2.b = A4 register value (block<<3 | F_num bits 10:8)
                            	   127: ;         D3.b = A0 register value (F_num bits 7:0)
                            	   128: ; Destroys: D4, D5
                            	   129: ;==============================================================================
                            	   130: nes_to_ym_freq:
02:00000418 5242            	   131:     addq.w  #1,D2                   ; D2 = P + 1
02:0000041A B47C0002        	   132:     cmp.w   #2,D2
02:0000041E 6532            	   133:     blo.s   .silence                ; period 0 → silence
02:00000420 86C2            	   134:     divu    D2,D3                   ; D3.l / D2.w → quotient in D3.w
02:00000422 692E            	   135:     bvs.s   .silence                ; overflow safety
02:00000424 3A03            	   136:     move.w  D3,D5                   ; D5 = raw quotient = F_num at block 5
02:00000426 7805            	   137:     moveq   #5,D4                   ; starting block (K was pre-shifted by 5)
                            	   138: .norm:
02:00000428 BA7C07FF        	   139:     cmp.w   #2047,D5
02:0000042C 630C            	   140:     bls.s   .done                   ; F_num fits in 11 bits
02:0000042E E24D            	   141:     lsr.w   #1,D5                   ; halve F_num
02:00000430 5204            	   142:     addq.b  #1,D4                   ; increment block
02:00000432 B83C0007        	   143:     cmp.b   #7,D4
02:00000436 6210            	   144:     bhi.s   .clamp                  ; block overflow → clamp
02:00000438 60EE            	   145:     bra.s   .norm
                            	   146: .done:
                            	   147:     ; D5.w = F_num (0–2047), D4.b = block (0–7)
02:0000043A 1404            	   148:     move.b  D4,D2
02:0000043C E70A            	   149:     lsl.b   #3,D2                   ; block << 3
02:0000043E 3605            	   150:     move.w  D5,D3
02:00000440 E04B            	   151:     lsr.w   #8,D3                   ; F_num >> 8 = high 3 bits
02:00000442 8403            	   152:     or.b    D3,D2                   ; D2.b = (block<<3) | F_num_high
02:00000444 1605            	   153:     move.b  D5,D3                   ; D3.b = F_num_low
02:00000446 4E75            	   154:     rts
                            	   155: .clamp:
                            	   156:     ; Frequency too high for YM2612 — clamp to max
02:00000448 143C003F        	   157:     move.b  #$3F,D2                 ; block 7, F_num high = 7
02:0000044C 163C00FF        	   158:     move.b  #$FF,D3                 ; F_num low = $FF → F_num = 2047
02:00000450 4E75            	   159:     rts
                            	   160: .silence:
02:00000452 7400            	   161:     moveq   #0,D2
02:00000454 7600            	   162:     moveq   #0,D3
02:00000456 4E75            	   163:     rts
                            	   164: 
                            	   165: ;==============================================================================
                            	   166: ; load_fm_patch — Load a 25-byte FM patch into a YM2612 channel
                            	   167: ;
                            	   168: ; Input:  A0 = pointer to 25-byte patch data
                            	   169: ;         D6.b = channel (0, 1, or 2)
                            	   170: ; Output: none
                            	   171: ; Preserves: D0-D6, A0-A1 (saved/restored internally)
                            	   172: ;==============================================================================
                            	   173: load_fm_patch:
02:00000458 48E7E0C0        	   174:     movem.l D0-D2/A0-A1,-(SP)
02:0000045C 43FA018A        	   175:     lea     FM_PATCH_REGS(PC),A1
02:00000460 7418            	   176:     moveq   #24,D2                  ; 25 register/value pairs
                            	   177: .loop:
02:00000462 1019            	   178:     move.b  (A1)+,D0                ; register base address
02:00000464 D006            	   179:     add.b   D6,D0                   ; + channel offset (0/1/2)
02:00000466 1218            	   180:     move.b  (A0)+,D1                ; data value
02:00000468 6100FF66        	   181:     bsr     ym_write1
02:0000046C 51CAFFF4        	   182:     dbra    D2,.loop
02:00000470 4CDF0307        	   183:     movem.l (SP)+,D0-D2/A0-A1
02:00000474 4E75            	   184:     rts
                            	   185: 
                            	   186: ;==============================================================================
                            	   187: ; audio_init — Initialize YM2612 and PSG for NES audio emulation
                            	   188: ;
                            	   189: ; Called once during boot. Sets up FM patches and mutes all channels.
                            	   190: ; Preserves: A4, A5, D7 (NES register shadows)
                            	   191: ;==============================================================================
                            	   192: audio_init:
02:00000476 48E7FE80        	   193:     movem.l D0-D6/A0,-(SP)
                            	   194: 
                            	   195:     ;------------------------------------------------------------------
                            	   196:     ; Key-off all 6 YM2612 channels
                            	   197:     ;------------------------------------------------------------------
02:0000047A 103C0028        	   198:     move.b  #$28,D0                 ; Key on/off register
02:0000047E 7200            	   199:     moveq   #0,D1
02:00000480 6100FF4E        	   200:     bsr     ym_write1               ; ch 0 off
02:00000484 123C0001        	   201:     move.b  #$01,D1
02:00000488 6100FF46        	   202:     bsr     ym_write1               ; ch 1 off
02:0000048C 123C0002        	   203:     move.b  #$02,D1
02:00000490 6100FF3E        	   204:     bsr     ym_write1               ; ch 2 off
02:00000494 123C0004        	   205:     move.b  #$04,D1
02:00000498 6100FF36        	   206:     bsr     ym_write1               ; ch 4 off (Part II)
02:0000049C 123C0005        	   207:     move.b  #$05,D1
02:000004A0 6100FF2E        	   208:     bsr     ym_write1               ; ch 5 off
02:000004A4 123C0006        	   209:     move.b  #$06,D1
02:000004A8 6100FF26        	   210:     bsr     ym_write1               ; ch 6 off
                            	   211: 
                            	   212:     ;------------------------------------------------------------------
                            	   213:     ; DMC scaffold (Phase C): enable YM2612 DAC on ch 6 and unmute its
                            	   214:     ; pan register so PCM bytes streamed to reg $2A become audible.
                            	   215:     ;
                            	   216:     ; $2B bit 7 = DAC enable (replaces ch 6's FM synth path).  We also
                            	   217:     ; write a center value ($80) to $2A so the DAC sits at mid-scale
                            	   218:     ; until dmc_feed starts pushing real samples.  $B6 (Part II) is ch 6
                            	   219:     ; pan/AMS/PMS — $C0 enables both L+R outputs.
                            	   220:     ;------------------------------------------------------------------
02:000004AC 103C002B        	   221:     move.b  #$2B,D0                 ; DAC enable register
02:000004B0 123C0080        	   222:     move.b  #$80,D1                 ; bit 7 = DAC on
02:000004B4 6100FF1A        	   223:     bsr     ym_write1
02:000004B8 103C002A        	   224:     move.b  #$2A,D0                 ; DAC data
02:000004BC 123C0080        	   225:     move.b  #$80,D1                 ; center value = silence
02:000004C0 6100FF0E        	   226:     bsr     ym_write1
02:000004C4 103C00B6        	   227:     move.b  #$B6,D0                 ; ch 6 pan/AMS/PMS (Part II)
02:000004C8 123C00C0        	   228:     move.b  #$C0,D1                 ; L+R enabled
02:000004CC 6100FF26        	   229:     bsr     ym_write2
                            	   230: 
                            	   231:     ;------------------------------------------------------------------
                            	   232:     ; LFO off (register $22 = 0)
                            	   233:     ;------------------------------------------------------------------
02:000004D0 103C0022        	   234:     move.b  #$22,D0
02:000004D4 7200            	   235:     moveq   #0,D1
02:000004D6 6100FEF8        	   236:     bsr     ym_write1
                            	   237: 
                            	   238:     ;------------------------------------------------------------------
                            	   239:     ; Clear SSG-EG for every operator on ch 0, 1, 2 ($90-$9E on Part I).
                            	   240:     ;
                            	   241:     ; The YM2612 SSG-EG register per operator has no power-on guarantee
                            	   242:     ; on Genesis hardware and may hold leftover state across soft resets.
                            	   243:     ; If bit 3 (SSG enable) is set, the envelope generator runs in a
                            	   244:     ; sawtooth/square-like "SSG mode" that produces an audible buzz or
                            	   245:     ; hiss alongside the clean FM output — we were hearing that on ch 1
                            	   246:     ; (Voice $00 pad) and ch 2 (Voice $07 bass).
                            	   247:     ;
                            	   248:     ; Zero-ing $90+op+ch for all 4 operators on each used channel puts
                            	   249:     ; every envelope generator back in standard mode.  12 writes total.
                            	   250:     ;------------------------------------------------------------------
02:000004DA 7200            	   251:     moveq   #0,D1                   ; data = 0 for all
02:000004DC 103C0090        	   252:     move.b  #$90,D0                 ; slot1 ch0
02:000004E0 6100FEEE        	   253:     bsr     ym_write1
02:000004E4 103C0091        	   254:     move.b  #$91,D0                 ; slot1 ch1
02:000004E8 6100FEE6        	   255:     bsr     ym_write1
02:000004EC 103C0092        	   256:     move.b  #$92,D0                 ; slot1 ch2
02:000004F0 6100FEDE        	   257:     bsr     ym_write1
02:000004F4 103C0094        	   258:     move.b  #$94,D0                 ; slot3 ch0
02:000004F8 6100FED6        	   259:     bsr     ym_write1
02:000004FC 103C0095        	   260:     move.b  #$95,D0                 ; slot3 ch1
02:00000500 6100FECE        	   261:     bsr     ym_write1
02:00000504 103C0096        	   262:     move.b  #$96,D0                 ; slot3 ch2
02:00000508 6100FEC6        	   263:     bsr     ym_write1
02:0000050C 103C0098        	   264:     move.b  #$98,D0                 ; slot2 ch0
02:00000510 6100FEBE        	   265:     bsr     ym_write1
02:00000514 103C0099        	   266:     move.b  #$99,D0                 ; slot2 ch1
02:00000518 6100FEB6        	   267:     bsr     ym_write1
02:0000051C 103C009A        	   268:     move.b  #$9A,D0                 ; slot2 ch2
02:00000520 6100FEAE        	   269:     bsr     ym_write1
02:00000524 103C009C        	   270:     move.b  #$9C,D0                 ; slot4 ch0
02:00000528 6100FEA6        	   271:     bsr     ym_write1
02:0000052C 103C009D        	   272:     move.b  #$9D,D0                 ; slot4 ch1
02:00000530 6100FE9E        	   273:     bsr     ym_write1
02:00000534 103C009E        	   274:     move.b  #$9E,D0                 ; slot4 ch2
02:00000538 6100FE96        	   275:     bsr     ym_write1
                            	   276: 
02:0000053C 614E            	   277:     bsr     audio_driver_reload_patches
                            	   278: 
                            	   279:     ;------------------------------------------------------------------
                            	   280:     ; (Phase E polish: the Phase-C FM isolation mute that forced every
                            	   281:     ; operator TL to $7F has been removed — FM music plays again alongside
                            	   282:     ; the DMC DAC stream now that HBlank-driven non-blocking playback is
                            	   283:     ; in place.  Patches loaded by load_fm_patch above already set the
                            	   284:     ; authoritative TL bytes for each voice.)
                            	   285:     ;------------------------------------------------------------------
                            	   286: 
                            	   287:     ;------------------------------------------------------------------
                            	   288:     ; Mute all 4 PSG channels (attenuation = $F = maximum)
                            	   289:     ;------------------------------------------------------------------
02:0000053E 13FC009F00C00011	   290:     move.b  #$9F,(PSG_PORT).l       ; Tone 1 mute
02:00000546 13FC00BF00C00011	   291:     move.b  #$BF,(PSG_PORT).l       ; Tone 2 mute
02:0000054E 13FC00DF00C00011	   292:     move.b  #$DF,(PSG_PORT).l       ; Tone 3 mute
02:00000556 13FC00FF00C00011	   293:     move.b  #$FF,(PSG_PORT).l       ; Noise mute
                            	   294: 
02:0000055E 6170            	   295:     bsr     audio_driver_zero_apu_shadow
                            	   296: 
                            	   297:     ;------------------------------------------------------------------
                            	   298:     ; Clear native music player state
                            	   299:     ;------------------------------------------------------------------
02:00000560 41F900FFE000    	   300:     lea     (MUSIC_BASE).l,A0
02:00000566 700F            	   301:     moveq   #(MUSIC_STATE_SIZE/4)-1,D0
                            	   302: .clr_music:
02:00000568 4298            	   303:     clr.l   (A0)+
02:0000056A 51C8FFFC        	   304:     dbra    D0,.clr_music
                            	   305: 
                            	   306:     ;------------------------------------------------------------------
                            	   307:     ; Clear DMC state block ($FFE100, 17 bytes — rounded to 20).  Zero
                            	   308:     ; dmc_active, dmc_burst, dmc_ptr, dmc_remain, shadow registers, and
                            	   309:     ; debug scaffold state.
                            	   310:     ;------------------------------------------------------------------
02:0000056E 41F900FFE100    	   311:     lea     (DMC_BASE).l,A0
02:00000574 4298            	   312:     clr.l   (A0)+                   ; active + burst
02:00000576 4298            	   313:     clr.l   (A0)+                   ; dmc_ptr
02:00000578 4298            	   314:     clr.l   (A0)+                   ; dmc_remain
02:0000057A 4298            	   315:     clr.l   (A0)+                   ; rate/addr/len sel + prev_btn
02:0000057C 4298            	   316:     clr.l   (A0)+                   ; dbg_next + pad (over-clear, safe)
                            	   317:     ;------------------------------------------------------------------
                            	   318:     ; Scaffold: preload dmc_dbg_next = 1 so the first Start press fires
                            	   319:     ; sample #1.  dmc_trigger wraps 1..7 from there.
                            	   320:     ;------------------------------------------------------------------
02:0000057E 13FC000100FFE110	   321:     move.b  #1,(dmc_dbg_next).l
                            	   322: 
02:00000586 4CDF017F        	   323:     movem.l (SP)+,D0-D6/A0
02:0000058A 4E75            	   324:     rts
                            	   325: 
                            	   326: ;==============================================================================
                            	   327: ; audio_driver_reload_patches — restore FM ch 0..2 to NES-pulse/triangle
                            	   328: ; patches and L+R panning. Called from init AND from music_dispatch.music_stop
                            	   329: ; on FS-music exit so MIDI's bell-pad patches don't bleed into gameplay.
                            	   330: ; Preserves all caller registers via movem.
                            	   331: ;==============================================================================
                            	   332:     xdef    audio_driver_reload_patches
                            	   333: audio_driver_reload_patches:
02:0000058C 48E7C280        	   334:     movem.l D0-D1/D6/A0,-(SP)
                            	   335: 
02:00000590 41FA008A        	   336:     lea     PATCH_VOICE03(PC),A0
02:00000594 7C00            	   337:     moveq   #0,D6
02:00000596 6100FEC0        	   338:     bsr     load_fm_patch
                            	   339: 
02:0000059A 41FA0066        	   340:     lea     PATCH_VOICE00(PC),A0
02:0000059E 7C01            	   341:     moveq   #1,D6
02:000005A0 6100FEB6        	   342:     bsr     load_fm_patch
                            	   343: 
02:000005A4 41FA0090        	   344:     lea     PATCH_VOICE07(PC),A0
02:000005A8 7C02            	   345:     moveq   #2,D6
02:000005AA 6100FEAC        	   346:     bsr     load_fm_patch
                            	   347: 
02:000005AE 103C00B4        	   348:     move.b  #$B4,D0
02:000005B2 123C00C0        	   349:     move.b  #$C0,D1
02:000005B6 6100FE18        	   350:     bsr     ym_write1
02:000005BA 103C00B5        	   351:     move.b  #$B5,D0
02:000005BE 6100FE10        	   352:     bsr     ym_write1
02:000005C2 103C00B6        	   353:     move.b  #$B6,D0
02:000005C6 6100FE08        	   354:     bsr     ym_write1
                            	   355: 
02:000005CA 4CDF0143        	   356:     movem.l (SP)+,D0-D1/D6/A0
02:000005CE 4E75            	   357:     rts
                            	   358: 
                            	   359: ;==============================================================================
                            	   360: ; audio_driver_zero_apu_shadow — zero $FF0A00..$FF0A15 (APU shadow regs).
                            	   361: ; Called from init AND from music_dispatch.music_stop so audio_driver tickers
                            	   362: ; don't resume from stale state when MIDI hands YM back.
                            	   363: ;==============================================================================
                            	   364:     xdef    audio_driver_zero_apu_shadow
                            	   365: audio_driver_zero_apu_shadow:
02:000005D0 48E78080        	   366:     movem.l D0/A0,-(SP)
02:000005D4 41F900FF0A00    	   367:     lea     (APU_SH_BASE).l,A0
02:000005DA 7008            	   368:     moveq   #($11/2),D0
                            	   369: .clr:
02:000005DC 4258            	   370:     clr.w   (A0)+
02:000005DE 51C8FFFC        	   371:     dbra    D0,.clr
02:000005E2 4CDF0101        	   372:     movem.l (SP)+,D0/A0
02:000005E6 4E75            	   373:     rts
                            	   374: 
                            	   375: ;==============================================================================
                            	   376: ; FM Patch Register Address Table
                            	   377: ;
                            	   378: ; 25 register base addresses (add channel 0/1/2 for target channel).
                            	   379: ; Order matches the 25 data bytes in each PATCH_VOICExx block.
                            	   380: ;==============================================================================
                            	   381:     even
                            	   382: FM_PATCH_REGS:
02:000005E8 B0              	   383:     dc.b    $B0                     ; FB/ALG
02:000005E9 30              	   384:     dc.b    $30,$34,$38,$3C         ; DT1/MUL (slot1,slot3,slot2,slot4)
02:000005EA 34
02:000005EB 38
02:000005EC 3C
02:000005ED 50              	   385:     dc.b    $50,$54,$58,$5C         ; RS/AR
02:000005EE 54
02:000005EF 58
02:000005F0 5C
02:000005F1 60              	   386:     dc.b    $60,$64,$68,$6C         ; AM/D1R
02:000005F2 64
02:000005F3 68
02:000005F4 6C
02:000005F5 70              	   387:     dc.b    $70,$74,$78,$7C         ; D2R
02:000005F6 74
02:000005F7 78
02:000005F8 7C
02:000005F9 80              	   388:     dc.b    $80,$84,$88,$8C         ; DL/RR
02:000005FA 84
02:000005FB 88
02:000005FC 8C
02:000005FD 40              	   389:     dc.b    $40,$44,$48,$4C         ; TL
02:000005FE 44
02:000005FF 48
02:00000600 4C
                            	   390:     even
                            	   391: 
                            	   392: ;==============================================================================
                            	   393: ; FM Patch Data — Sonic 2 Emerald Hill Zone voices
                            	   394: ;
                            	   395: ; 25 bytes each.  Canonical Sonic 2 voice format from sonicretro/s2disasm
                            	   396: ; sound/music/82 - EHZ.asm (label EHZ_Voices):
                            	   397: ;
                            	   398: ;   byte 0      : FB/ALG (feedback<<3 | algorithm)
                            	   399: ;   bytes 1-4   : DT/MUL  — operators in slot order: op1, op3, op2, op4
                            	   400: ;   bytes 5-8   : RS/AR    "
                            	   401: ;   bytes 9-12  : AM/D1R   "
                            	   402: ;   bytes 13-16 : D2R      "
                            	   403: ;   bytes 17-20 : DL/RR    "
                            	   404: ;   bytes 21-24 : TL       "
                            	   405: ;
                            	   406: ; The slot order op1,op3,op2,op4 matches YM2612 register offsets 0,4,8,C in
                            	   407: ; FM_PATCH_REGS, so the bytes stream directly to the right operator slots
                            	   408: ; without any reordering in load_fm_patch.
                            	   409: ;
                            	   410: ; NOTE: the original SMPS driver uses bit 7 ($80) on TL bytes as an "absolute,
                            	   411: ; do not add channel volume" flag — it masks bit 7 before writing and channel
                            	   412: ; volume is added for operators without the flag.  We have no per-channel
                            	   413: ; volume, so we translate $80 directly to a safe carrier TL of $18 (matching
                            	   414: ; Voice $03's proven-clean carrier level) and keep the authoritative
                            	   415: ; modulator TL bytes as-is.
                            	   416: ;
                            	   417: ; ym_trace.lua (2026-04-10) proved the driver was writing these bytes
                            	   418: ; verbatim to the YM2612.  A prior transcription of Voice $00 and Voice $07
                            	   419: ; had the middle two bytes of DT/MUL, RS/AR, AM/D1R, and TL swapped — putting
                            	   420: ; op2's parameters onto op3 and vice versa.  On Voice $03 the middle values
                            	   421: ; are near-symmetric so the swap is inaudible; on Voices $00 and $07 the
                            	   422: ; middle values differ enough that the swap produced cross-wired FM
                            	   423: ; modulation = sustained "crunchy buzz" on both channels.  Restored to the
                            	   424: ; authoritative byte order here.
                            	   425: ;==============================================================================
                            	   426: 
                            	   427: ; Voice $00 — Bell-like pad.
                            	   428: ;
                            	   429: ; Classic FM bell recipe:
                            	   430: ;   Alg 5 (3 carriers modulated by op1)
                            	   431: ;   FB 5 for brightness without the FB 7 "hard bite"
                            	   432: ;   Op1 MUL 4 → produces inharmonic overtones at 4x the carrier pitch,
                            	   433: ;     which is what gives bells their characteristic "chime" quality
                            	   434: ;   Op1 TL $14 → modulator loud enough to shape the bell spectrum
                            	   435: ;   Carriers at MUL 1, tuned unison (no detune beating)
                            	   436: ;   Fast attack, medium D1R, low DL, slow RR = bell strike + sustain tail
                            	   437: PATCH_VOICE00:
02:00000602 2D              	   438:     dc.b    $2D                     ; FB/ALG: (5<<3)|5 — FB 5 bell pad
02:00000603 04              	   439:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:00000604 01
02:00000605 01
02:00000606 01
02:00000607 1F              	   440:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:00000608 1F
02:00000609 1F
02:0000060A 1F
02:0000060B 08              	   441:     dc.b    $08,$04,$04,$04         ; AM/D1R — bell-decay shape
02:0000060C 04
02:0000060D 04
02:0000060E 04
02:0000060F 00              	   442:     dc.b    $00,$00,$00,$00         ; D2R
02:00000610 00
02:00000611 00
02:00000612 00
02:00000613 47              	   443:     dc.b    $47,$37,$37,$17         ; DL 4/3 + RR 7/7/7/7 — bell tail
02:00000614 37
02:00000615 37
02:00000616 17
02:00000617 14              	   444:     dc.b    $14,$1E,$1E,$1E         ; TL — op1 mod loud ($14), carriers quieter ($1E)
02:00000618 1E
02:00000619 1E
02:0000061A 1E
                            	   445:     even
                            	   446: 
                            	   447: ; Voice $03 — EHZ FM3 opening voice (iconic lead)
                            	   448: ; Algorithm 5 (slots 2,3,4 are carriers), Feedback 7
                            	   449: PATCH_VOICE03:
02:0000061C 3D              	   450:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:0000061D 01              	   451:     dc.b    $01,$51,$21,$01         ; DT/MUL
02:0000061E 51
02:0000061F 21
02:00000620 01
02:00000621 1F              	   452:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR (max — EHZ's slow-attack swell was delaying Zelda's Pulse 2 melody)
02:00000622 1F
02:00000623 1F
02:00000624 1F
02:00000625 0A              	   453:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:00000626 05
02:00000627 05
02:00000628 05
02:00000629 00              	   454:     dc.b    $00,$00,$00,$00         ; D2R
02:0000062A 00
02:0000062B 00
02:0000062C 00
02:0000062D 2B              	   455:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
02:0000062E 2B
02:0000062F 2B
02:00000630 1B
02:00000631 19              	   456:     dc.b    $19,$18,$18,$18         ; TL (slot1=modulator $19; slots 2/3/4 carriers +$18 for mix)
02:00000632 18
02:00000633 18
02:00000634 18
                            	   457:     even
                            	   458: 
                            	   459: ; Voice $07 — Clean bass.
                            	   460: ;
                            	   461: ; Pure sine-ish bass: Alg 5, low FB, all operators at MUL 1 with no detune.
                            	   462: ; This is the cleanest possible FM bass — no harmonics beyond what the fun-
                            	   463: ; damental already provides.  Moderately quiet so it supports the lead
                            	   464: ; without fighting it.
                            	   465: PATCH_VOICE07:
02:00000636 0D              	   466:     dc.b    $0D                     ; FB/ALG: (1<<3)|5 — FB 1 (minimal grit)
02:00000637 01              	   467:     dc.b    $01,$01,$01,$01         ; DT/MUL — unison, no beating
02:00000638 01
02:00000639 01
02:0000063A 01
02:0000063B 1F              	   468:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
02:0000063C 1F
02:0000063D 1F
02:0000063E 1F
02:0000063F 0A              	   469:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:00000640 05
02:00000641 05
02:00000642 05
02:00000643 00              	   470:     dc.b    $00,$00,$00,$00         ; D2R
02:00000644 00
02:00000645 00
02:00000646 00
02:00000647 28              	   471:     dc.b    $28,$28,$28,$18         ; DL 2 / RR 8 — bass punch
02:00000648 28
02:00000649 28
02:0000064A 18
02:0000064B 22              	   472:     dc.b    $22,$20,$20,$20         ; TL — moderately quiet (less than 27.81's $28)
02:0000064C 20
02:0000064D 20
02:0000064E 20
                            	   473:     even
                            	   474: 
                            	   475: ;==============================================================================
                            	   476: ;==============================================================================
                            	   477: ; NATIVE M68K MUSIC PLAYER
                            	   478: ;
                            	   479: ; Ports the NES Zelda DriveSong engine verbatim, reading the same script
                            	   480: ; opcodes but emitting YM2612/PSG writes instead of NES APU writes.
                            	   481: ;
                            	   482: ; State lives at $FF0B00.  Song data is pulled from the contiguous
                            	   483: ; MusicBlob (SongTable + 9 song headers + 9 song scripts, 2757 bytes)
                            	   484: ; loaded at label MusicBlob.  NES CPU addresses in song headers are
                            	   485: ; converted to M68K pointers via (nes_addr - MUSIC_BLOB_NES_BASE) + MusicBlob.
                            	   486: ;==============================================================================
                            	   487: ;==============================================================================
                            	   488: 
                            	   489: ;----------------------------------------------------------------------
                            	   490: ; Music state RAM ($FF0B00-$FF0B3F, 64 bytes)
                            	   491: ;----------------------------------------------------------------------
                            	   492: ; ============================================================================
                            	   493: ; MUSIC_BASE must be OUTSIDE the NES RAM mirror range.
                            	   494: ; Real NES mirrors its 2 KB RAM through $0000-$1FFF, so any transpiled access
                            	   495: ; through a pointer in zero-page that lands in $0800-$1FFF on 6502 will on our
                            	   496: ; M68K map hit $FF0800-$FF1FFF directly (transpiler does not wrap mirrors).
                            	   497: ; $FF0B00 got continuously clobbered by such accesses during the intro.
                            	   498: ; $FFE000 is safely past $FF1FFF and well below the stack at $FFFFFE.
                            	   499: ; ============================================================================
                            	   500: MUSIC_BASE          equ $FFE000
                            	   501: MUSIC_STATE_SIZE    equ $40
                            	   502: 
                            	   503: m_song              equ MUSIC_BASE+$00  ; current song bitmap
                            	   504: m_song_req          equ MUSIC_BASE+$01  ; requested song change
                            	   505: m_phrase            equ MUSIC_BASE+$02  ; current phrase index
                            	   506: m_len_base          equ MUSIC_BASE+$03  ; note length table base
                            	   507: m_env_sel           equ MUSIC_BASE+$04  ; envelope selector
                            	   508: m_mystery           equ MUSIC_BASE+$05  ; header byte 7 ($05F1 equiv)
                            	   509: m_noise_first       equ MUSIC_BASE+$06  ; noise loop start
                            	   510: m_script_ptr        equ MUSIC_BASE+$08  ; long: M68K pointer to script base
                            	   511: 
                            	   512: ; Sq1 (Pulse 1 → YM ch 0)
                            	   513: m_sq1_off           equ MUSIC_BASE+$0C
                            	   514: m_sq1_cnt           equ MUSIC_BASE+$0D
                            	   515: m_sq1_len           equ MUSIC_BASE+$0E
                            	   516: m_sq1_vib           equ MUSIC_BASE+$0F
                            	   517: m_sq1_per           equ MUSIC_BASE+$10
                            	   518: 
                            	   519: ; Sq0 (Pulse 2 → YM ch 1)
                            	   520: m_sq0_off           equ MUSIC_BASE+$14
                            	   521: m_sq0_cnt           equ MUSIC_BASE+$15
                            	   522: m_sq0_len           equ MUSIC_BASE+$16
                            	   523: m_sq0_vib           equ MUSIC_BASE+$17
                            	   524: m_sq0_per           equ MUSIC_BASE+$18
                            	   525: 
                            	   526: ; Triangle (→ YM ch 2)
                            	   527: m_trg_off           equ MUSIC_BASE+$1C
                            	   528: m_trg_cnt           equ MUSIC_BASE+$1D
                            	   529: m_trg_len           equ MUSIC_BASE+$1E
                            	   530: m_trg_vib           equ MUSIC_BASE+$1F
                            	   531: m_trg_per           equ MUSIC_BASE+$20
                            	   532: m_trg_rep_n         equ MUSIC_BASE+$21
                            	   533: m_trg_rep_s         equ MUSIC_BASE+$22
                            	   534: 
                            	   535: ; Noise (→ PSG ch 3)
                            	   536: m_noise_off         equ MUSIC_BASE+$24
                            	   537: m_noise_cnt         equ MUSIC_BASE+$25
                            	   538: ; Software ADSR state for the PSG noise drum channel (Kroc Sonic 1 SMS pattern).
                            	   539: ; SN76489 has no envelope hardware, so we run a linear software envelope and
                            	   540: ; map it to the 4-bit PSG attenuation every frame.  Writing the noise control
                            	   541: ; register resets the LFSR, so we also cache the last-written control byte and
                            	   542: ; skip redundant writes to preserve the decay tail.
                            	   543: m_noise_level       equ MUSIC_BASE+$26  ; byte: current envelope level ($00-$FF)
                            	   544: m_noise_decay       equ MUSIC_BASE+$27  ; byte: current linear decay rate (per tick)
                            	   545: m_last_psg_nc       equ MUSIC_BASE+$28  ; byte: last noise-control byte written
                            	   546: 
                            	   547: ; Noise-SFX shadow state. Zelda's PlaySfxNote writes $400E/$400C/$400F
                            	   548: ; per sfx-tick. The first two cache here; $400F is the per-hit trigger.
                            	   549: m_sfx_vol           equ MUSIC_BASE+$29  ; byte: last $400C byte
                            	   550: m_sfx_ctrl_raw      equ MUSIC_BASE+$2A  ; byte: last $400E byte
                            	   551: ; Set to 1 by tick_sq1.song_ended each time the song script reaches its
                            	   552: ; loop point (opcode $00). C-side intro_story polls this to sync the
                            	   553: ; final-hold-then-loop-back-to-title transition with the music loop.
                            	   554: ; Owner clears it; ASM only ever writes 1.
                            	   555: m_song_loop_pending equ MUSIC_BASE+$2B  ; byte: 1 = song just looped
                            	   556: 
                            	   557: ;----------------------------------------------------------------------
                            	   558: ; DMC → YM2612 DAC state (Phase A of DMC port — see
                            	   559: ; C:\Users\Jake Diggity\.claude\plans\quirky-baking-goose.md).
                            	   560: ;
                            	   561: ; Lives at $FFE100, clear of the music-state block at $FFE000-$FFE03F.
                            	   562: ; Written by the DMC APU stubs in nes_io.asm, consumed by dmc_feed which
                            	   563: ; runs at the tail of music_tick and bursts PCM bytes to YM reg $2A.
                            	   564: ;----------------------------------------------------------------------
                            	   565: DMC_BASE            equ $FFE100
                            	   566: dmc_active          equ DMC_BASE+$00    ; byte: 0 = idle, 1 = playing
                            	   567: dmc_last_idx        equ DMC_BASE+$01    ; byte: last triggered sample index (for HUD)
                            	   568: dmc_ptr             equ DMC_BASE+$04    ; long: current M68K pointer into PCM blob
                            	   569: dmc_remain          equ DMC_BASE+$08    ; long: PCM bytes left in current sample
                            	   570: dmc_rate_sel        equ DMC_BASE+$0C    ; byte: shadow of last $4010 write
                            	   571: dmc_addr_sel        equ DMC_BASE+$0D    ; byte: shadow of last $4012 write
                            	   572: dmc_len_sel         equ DMC_BASE+$0E    ; byte: shadow of last $4013 write
                            	   573: dmc_dbg_prev_btn    equ DMC_BASE+$0F    ; byte: pad state from last frame (edge det)
                            	   574: dmc_dbg_next        equ DMC_BASE+$10    ; byte: next sample index (1..7) to trigger
                            	   575: 
                            	   576: ;==============================================================================
                            	   577: ; dmc_trigger — non-blocking HBlank DAC streamer.
                            	   578: ;
                            	   579: ; Samples are pre-processed by tools/extract_dmc_samples.py: proper bandlimited
                            	   580: ; resampling (scipy.signal.resample_poly with Kaiser-window FIR) from native
                            	   581: ; NES rate (21/25/33 kHz) down to the empirically-measured Genesis HINT rate
                            	   582: ; (~8751 Hz with music active). That's where the "crunchy" sound came from
                            	   583: ; before — linear interpolation without anti-alias filter caused aliasing.
                            	   584: ; With proper prefiltered resampling, playback sounds clean even at the lower
                            	   585: ; effective rate, and the game does NOT hitch.
                            	   586: ;==============================================================================
                            	   587: dmc_trigger:
02:00000650 4A00            	   588:     tst.b   D0
02:00000652 6762            	   589:     beq.s   .bad
02:00000654 B03C0007        	   590:     cmp.b   #DMC_SAMPLE_COUNT,D0
02:00000658 625C            	   591:     bhi.s   .bad
02:0000065A 48E7E0C0        	   592:     movem.l D0-D2/A0-A1,-(SP)
02:0000065E 13C000FFE101    	   593:     move.b  D0,(dmc_last_idx).l
02:00000664 7200            	   594:     moveq   #0,D1
02:00000666 1200            	   595:     move.b  D0,D1                   ; D1.l = 1-based index
02:00000668 5381            	   596:     subq.l  #1,D1                   ; 0-based
02:0000066A D281            	   597:     add.l   D1,D1                   ; idx * 2
02:0000066C D281            	   598:     add.l   D1,D1                   ; idx * 4
                            	   599: 
02:0000066E 41F900001974    	   600:     lea     (DMC_SAMPLE_PCM_OFFS).l,A0
02:00000674 24301800        	   601:     move.l  (A0,D1.l),D2
02:00000678 43F9000052E4    	   602:     lea     (DMC_SAMPLE_PCM_BLOB).l,A1
02:0000067E D3C2            	   603:     add.l   D2,A1
                            	   604: 
02:00000680 41F900001990    	   605:     lea     (DMC_SAMPLE_PCM_LENS).l,A0
02:00000686 24301800        	   606:     move.l  (A0,D1.l),D2
02:0000068A 4A82            	   607:     tst.l   D2
02:0000068C 6724            	   608:     beq.s   .bad_restore
                            	   609: 
02:0000068E 23C900FFE104    	   610:     move.l  A1,(dmc_ptr).l
02:00000694 23C200FFE108    	   611:     move.l  D2,(dmc_remain).l
02:0000069A 13FC000100FFE100	   612:     move.b  #1,(dmc_active).l
                            	   613: 
                            	   614:     ; Arm HBlank every line, enable HINT (preserve colorfix bit).
02:000006A2 33FC8A0000C00004	   615:     move.w  #$8A00,(VDP_CTRL).l     ; Reg 10 = 0 -> fire every line
02:000006AA 33FC801400C00004	   616:     move.w  #$8014,(VDP_CTRL).l     ; Reg  0 = $14 -> HINT on + colorfix
                            	   617: .bad_restore:
02:000006B2 4CDF0307        	   618:     movem.l (SP)+,D0-D2/A0-A1
                            	   619: .bad:
02:000006B6 4E75            	   620:     rts
                            	   621: 
                            	   622: ;==============================================================================
                            	   623: ; dmc_hint_tick — per-HBlank PCM byte -> YM2612 reg $2A DAC write.
                            	   624: ;==============================================================================
                            	   625: dmc_hint_tick:
02:000006B8 207900FFE104    	   626:     move.l  (dmc_ptr).l,A0
02:000006BE 1018            	   627:     move.b  (A0)+,D0
02:000006C0 23C800FFE104    	   628:     move.l  A0,(dmc_ptr).l
02:000006C6 41F900A04000    	   629:     lea     (YM_ADDR1).l,A0
                            	   630: .wait:
02:000006CC 4A10            	   631:     tst.b   (A0)
02:000006CE 6BFC            	   632:     bmi.s   .wait
02:000006D0 10BC002A        	   633:     move.b  #$2A,(A0)
02:000006D4 13C000A04001    	   634:     move.b  D0,(YM_DATA1).l
02:000006DA 53B900FFE108    	   635:     subq.l  #1,(dmc_remain).l
02:000006E0 6702            	   636:     beq.s   .end
02:000006E2 4E75            	   637:     rts
                            	   638: .end:
02:000006E4 41F900A04000    	   639:     lea     (YM_ADDR1).l,A0
                            	   640: .wait2:
02:000006EA 4A10            	   641:     tst.b   (A0)
02:000006EC 6BFC            	   642:     bmi.s   .wait2
02:000006EE 10BC002A        	   643:     move.b  #$2A,(A0)
02:000006F2 13FC008000A04001	   644:     move.b  #$80,(YM_DATA1).l       ; park DAC at mid-rail
02:000006FA 423900FFE100    	   645:     clr.b   (dmc_active).l
02:00000700 33FC800400C00004	   646:     move.w  #$8004,(VDP_CTRL).l     ; Reg 0 = $04 -> HINT off, colorfix on
02:00000708 4E75            	   647:     rts
                            	   648: 
                            	   649: ;==============================================================================
                            	   650: ; dmc_feed — legacy VBlank entry point, retained as labeled rts.
                            	   651: ;
                            	   652: ; music_tick used to call this to drain a frame's worth of PCM in VBlank.
                            	   653: ; All streaming now happens from HBlank via dmc_hint_tick.  Kept as a cheap
                            	   654: ; rts so we don't have to surgically delete the call from music_tick.
                            	   655: ;==============================================================================
                            	   656: dmc_feed:
02:0000070A 4E75            	   657:     rts
                            	   658: 
                            	   659: ;==============================================================================
                            	   660: ; dmc_dbg_poll - Phase-C/D scaffold (REMOVED in Phase E).
                            	   661: ;
                            	   662: ; Previously watched the NES-format controller latch for a Start rising edge
                            	   663: ; and cycled through the 7 DMC samples.  That scaffold served its purpose at
                            	   664: ; T27/T28 PASS — DMC triggering is now fully driven by the game's own APU
                            	   665: ; $4015 writes via the _apu_write_4015 stub in nes_io.asm (Phase D), and
                            	   666: ; Start has a real game function (exit attract mode).  Polling it here would
                            	   667: ; fire a stray DMC burst every time the player presses Start on the title
                            	   668: ; screen, masking real game audio events.
                            	   669: ;
                            	   670: ; The label is kept as a labeled rts for backward-compat with the call in
                            	   671: ; music_tick, which we'll peel out in a later cleanup pass.
                            	   672: ;==============================================================================
                            	   673: dmc_dbg_poll:
02:0000070C 4E75            	   674:     rts
                            	   675: 
                            	   676: ;==============================================================================
                            	   677: ; music_play — request a song change
                            	   678: ; Input: D0.b = song bitmap
                            	   679: ;==============================================================================
                            	   680:     xdef    music_play
                            	   681: music_play:
02:0000070E 13C000FFE001    	   682:     move.b  D0,(m_song_req).l
02:00000714 4E75            	   683:     rts
                            	   684: 
                            	   685: ;==============================================================================
                            	   686: ; music_tick — DriveSong equivalent.  Call once per VBlank.
                            	   687: ;==============================================================================
                            	   688: music_tick:
02:00000716 48E7FFE0        	   689:     movem.l D0-D7/A0-A2,-(SP)
                            	   690:     ;------------------------------------------------------------------
                            	   691:     ; Phase E polish: FM music path restored.  DMC streams independently
                            	   692:     ; from HBlank via dmc_hint_tick, so the main-thread music tick no
                            	   693:     ; longer needs to stay muted.  ym_write1/2 carry SR lockout so the
                            	   694:     ; HINT-driven DAC streamer can't corrupt the YM2612 latch between
                            	   695:     ; address and data bytes.
                            	   696:     ;
                            	   697:     ; Structure matches the pre-isolation (Zelda27.82) tick: consume
                            	   698:     ; song_req via change_song, otherwise tick_sq1 if a song is playing.
                            	   699:     ; dmc_dbg_poll + dmc_feed run after either path.  dmc_feed is now a
                            	   700:     ; labeled rts — the call costs ~20 cycles total and lets us defer
                            	   701:     ; removing it to a later cleanup pass.
                            	   702:     ;------------------------------------------------------------------
                            	   703:     ; Attract-mode-exit hook: the game's DriveAudio is NOP'd, so the
                            	   704:     ; audio driver's own SilenceSong paths (via DriveTune0 → $0604 bit7
                            	   705:     ; and DriveTune1 → $0602 bit7) never run.  Game logic still writes
                            	   706:     ; the request bytes at state transitions.  The attract-to-file-menu
                            	   707:     ; path (UpdateMode0Demo_Sub0 → SilenceAllSound in z_01.asm:4118)
                            	   708:     ; sets $0604 = $80 and $0603 = $80.  Poll both $0604 and $0602 for
                            	   709:     ; the silence-request bit 7 and route it into native music_silence.
                            	   710:     ; Also clear $0605/$0607 (current-tune shadows) so the game's own
                            	   711:     ; "nothing playing" markers stay coherent with our silenced state.
                            	   712:     ; SongRequest bridge: game writes D0 -> $FF0600 (NES RAM SongRequest) at
                            	   713:     ; every song change (title/gameplay/dungeon/etc.). Forward to m_song_req
                            	   714:     ; and clear the game-side byte so the game's own driver-absent check
                            	   715:     ; ("did my song change get consumed?") stays coherent.
02:0000071A 103900FF0600    	   716:     move.b  ($FF0600).l,D0
02:00000720 670C            	   717:     beq.s   .no_song_req_bridge
02:00000722 423900FF0600    	   718:     clr.b   ($FF0600).l
02:00000728 13C000FFE001    	   719:     move.b  D0,(m_song_req).l
                            	   720: .no_song_req_bridge:
02:0000072E 103900FF0604    	   721:     move.b  ($FF0604).l,D0          ; Tune 0 request (SilenceAllSound)
02:00000734 6B08            	   722:     bmi.s   .do_silence
02:00000736 103900FF0602    	   723:     move.b  ($FF0602).l,D0          ; Tune 1 request (silence-then-play)
02:0000073C 6A24            	   724:     bpl.s   .no_silence_req
                            	   725: .do_silence:
02:0000073E 423900FF0602    	   726:     clr.b   ($FF0602).l
02:00000744 423900FF0603    	   727:     clr.b   ($FF0603).l
02:0000074A 423900FF0604    	   728:     clr.b   ($FF0604).l
02:00000750 423900FF0605    	   729:     clr.b   ($FF0605).l
02:00000756 423900FF0607    	   730:     clr.b   ($FF0607).l
02:0000075C 6100067E        	   731:     bsr     music_silence
02:00000760 6024            	   732:     bra.s   .dmc_poll
                            	   733: .no_silence_req:
02:00000762 103900FFE001    	   734:     move.b  (m_song_req).l,D0
02:00000768 6710            	   735:     beq.s   .no_req
02:0000076A 423900FFE001    	   736:     clr.b   (m_song_req).l
02:00000770 13C000FFE000    	   737:     move.b  D0,(m_song).l
02:00000776 6118            	   738:     bsr     change_song
02:00000778 600C            	   739:     bra.s   .dmc_poll
                            	   740: .no_req:
02:0000077A 4A3900FFE000    	   741:     tst.b   (m_song).l
02:00000780 6704            	   742:     beq.s   .dmc_poll
02:00000782 610001B4        	   743:     bsr     tick_sq1
                            	   744: .dmc_poll:
02:00000786 6184            	   745:     bsr     dmc_dbg_poll            ; scaffold: Start cycles DMC samples
02:00000788 6180            	   746:     bsr     dmc_feed                ; no-op stub (backward-compat call)
                            	   747:     ; DMC and noise-SFX dispatch paused -- neither produced acceptable
                            	   748:     ; audio yet. Revisit in a future pass. Music + SongRequest bridge
                            	   749:     ; stay wired.
02:0000078A 4CDF07FF        	   750:     movem.l (SP)+,D0-D7/A0-A2
02:0000078E 4E75            	   751:     rts
