02:0003B080 661E            	  2081:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B082 7006            	  2082:     moveq   #6,D0
02:0003B084 41EC03D0        	  2083:     lea     ($03D0,A4),A0
02:0003B088 11802000        	  2084:     move.b  D0,(A0,D2.W)
                            	  2085:     ; There are actually 6 frame images divided into 2 sets.
                            	  2086:     ; Each set depicts one animation frame. In each set there are
                            	  2087:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2088:     ;
                            	  2089:     ; The movement frame will keep track of the base offset of
                            	  2090:     ; the current set for the current animation frame: 0 or 3.
                            	  2091:     ;
                            	  2092:     ; So, XOR the movement frame with 3.
                            	  2093:     ;
02:0003B08C E208            	  2094:     lsr.b  #1,D0   ; LSR A
02:0003B08E 41EC03E4        	  2095:     lea     ($03E4,A4),A0
02:0003B092 12302000        	  2096:     move.b  (A0,D2.W),D1
02:0003B096 B300            	  2097:     eor.b  D1,D0
02:0003B098 41EC03E4        	  2098:     lea     ($03E4,A4),A0
02:0003B09C 11802000        	  2099:     move.b  D0,(A0,D2.W)
                            	  2100:     even
