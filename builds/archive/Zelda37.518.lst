02:0003AA38 102C066C        	  1215:     move.b  ($066C,A4),D0
02:0003AA3C 1234203D        	  1216:     move.b  ($3D,A4,D2.W),D1
02:0003AA40 8001            	  1217:     or.b  D1,D0
02:0003AA42 6610            	  1218:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1219:     ; Shoot.
                            	  1220:     ;
02:0003AA44 1014            	  1221:     move.b  ($0000,A4),D0
02:0003AA46 611E            	  1222:     jsr     _ShootIfWanted2
                            	  1223:     ; If it failed, go set a non-zero speed.
                            	  1224:     ;
02:0003AA48 6510            	  1225:     bcs  _L_z04__TryShooting_SetSpeed
                            	  1226:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  1227:     ;
02:0003AA4A 7000            	  1228:     moveq   #0,D0
02:0003AA4C 41EC0412        	  1229:     lea     ($0412,A4),A0
02:0003AA50 11802000        	  1230:     move.b  D0,(A0,D2.W)
                            	  1231:     even
