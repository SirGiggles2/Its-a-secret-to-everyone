02:0003DB60 7600            	  7916:     moveq   #0,D3
02:0003DB62 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003DB66 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003DB6A 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003DB6E 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003DB72 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003DB74 41F90003DA66    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003DB7A 10303000        	  7927:     move.b  (A0,D3.W),D0
02:0003DB7E 1B00            	  7928:     move.b  D0,-(A5)  ; PHA
02:0003DB80 41F90003DA6A    	  7929:     lea     (PatraChild1RotationSineBits).l,A0
02:0003DB86 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0003DB8A 7600            	  7931:     moveq   #0,D3
02:0003DB8C 1600            	  7932:     move.b  D0,D3
02:0003DB8E 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0003DB90 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  7939:     ; for both Y and X increment calculations in rotation. This leads to
                            	  7940:     ; a small circle (5) and a large circle (6).
                            	  7941:     ;
02:0003DB92 41F90003DA68    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0003DB98 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0003DB9C 7600            	  7944:     moveq   #0,D3
02:0003DB9E 1600            	  7945:     move.b  D0,D3
                            	  7946:     even
                            	  7947: _L_z04_PatraChild_State1_Rotate:
