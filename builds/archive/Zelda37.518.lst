02:0003ACB4 122C0084        	  1583:     move.b  ($0084,A4),D1
02:0003ACB8 B001            	  1584:     cmp.b   D1,D0
02:0003ACBA 6402            	  1585:     bcc  _anon_z04_40
02:0003ACBC 5303            	  1586:     subq.b  #1,D3
                            	  1587: _anon_z04_40:
