02:0003AD16 41F90003AC72    	  1624:     lea     (BlueLeeverStateAnimTimes).l,A0
02:0003AD1C 10303000        	  1625:     move.b  (A0,D3.W),D0
                            	  1626: ; Params:
                            	  1627: ; A: new value for animation counter, in case it rolls over
                            	  1628: ; X: object index
                            	  1629: ;
                            	  1630: ; Note:
                            	  1631: ; Advances the animation counter first.
                            	  1632: ;
                            	  1633:     even
                            	  1634: Burrower_AnimateDrawAndCheckCollisions:
02:0003AD20 4EB90004B21A    	  1635:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  1636:     ; If state = 0, return.
                            	  1637:     ;
