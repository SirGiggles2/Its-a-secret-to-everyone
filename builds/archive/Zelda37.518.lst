02:0002CFC4 6512            	  2455:     bcs.s   .pg_mid
02:0002CFC6 0C00000C        	  2456:     cmpi.b  #$0C,D0
02:0002CFCA 6512            	  2457:     bcs.s   .pg_long
02:0002CFCC 103C00E7        	  2458:     move.b  #$E7,D0
02:0002CFD0 6010            	  2459:     bra.s   .pg_ready
