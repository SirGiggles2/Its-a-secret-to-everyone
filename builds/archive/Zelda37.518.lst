                            	  4360: DrawLinkZeldaTriforces:
                            	  4361:     ; The triforce over Link goes in the room object slot $13.
                            	  4362:     ; Set its location $10 pixels above Link.
                            	  4363:     ;
02:00036F92 102C0070        	  4364:     move.b  ($0070,A4),D0
02:00036F96 19400083        	  4365:     move.b  D0,($0083,A4)
02:00036F9A 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00036F9E 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00036FA2 123C0010        	  4368:     move.b  #$10,D1
02:00036FA6 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036FAA 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00036FAC 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00036FB0 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
                            	  4374:     ;
02:00036FB4 7400            	  4375:     moveq   #0,D2
02:00036FB6 4EB90004B220    	  4376:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00036FBC 6100C2E2        	  4377:     jsr     Anim_SetSpriteDescriptorAttributes
02:00036FC0 1940000C        	  4378:     move.b  D0,($000C,A4)
02:00036FC4 7048            	  4379:     moveq   #72,D0
02:00036FC6 19400343        	  4380:     move.b  D0,($0343,A4)
02:00036FCA 704C            	  4381:     moveq   #76,D0
