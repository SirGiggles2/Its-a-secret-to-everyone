02:0002D3AC 3005            	  3023:     move.w  D5,D0
02:0002D3AE 0240000F        	  3024:     andi.w  #$000F,D0
02:0002D3B2 4A40            	  3025:     tst.w   D0
02:0002D3B4 663C            	  3026:     bne.s   .ttf_chr_no_convert
                            	  3027: 
