02:00042A82 41F900048C95    	  6882:     lea     (PlayAreaColumnAddrs+1).l,A0
02:00042A88 10302000        	  6883:     move.b  (A0,D2.W),D0
02:00042A8C 19400001        	  6884:     move.b  D0,($0001,A4)
02:00042A90 1003            	  6885:     move.b  D3,D0
02:00042A92 003C0011        	  6886:     ori     #$11,CCR  ; SEC: set C+X
02:00042A96 123C0040        	  6887:     move.b  #$40,D1
02:00042A9A 0A3C0010        	  6888:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042A9E 9101            	  6889:     subx.b  D1,D0   ; SBC #$40
02:00042AA0 0A3C0010        	  6890:     eori    #$10,CCR  ; restore X = 6502 C
02:00042AA4 E208            	  6891:     lsr.b  #1,D0   ; LSR A
02:00042AA6 E208            	  6892:     lsr.b  #1,D0   ; LSR A
02:00042AA8 E208            	  6893:     lsr.b  #1,D0   ; LSR A
02:00042AAA 7600            	  6894:     moveq   #0,D3
02:00042AAC 1600            	  6895:     move.b  D0,D3
02:00042AAE 1214            	  6896:     move.b  ($00,A4),D1   ; ptr lo
02:00042AB0 182C0001        	  6897:     move.b  ($01,A4),D4  ; ptr hi
02:00042AB4 024100FF        	  6898:     andi.w  #$00FF,D1         ; zero-extend lo byte
