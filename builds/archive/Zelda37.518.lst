Source: "audio_driver.asm"
                            	  1420: 

Source: "genesis_shell.asm"
                            	   715:     include "music_player.asm"

Source: "music_player.asm"
                            	     1: ;==============================================================================
                            	     2: ; music_player.asm — Compact event-driven YM2612 MIDI player.
                            	     3: ;
                            	     4: ; Public symbols:
                            	     5: ;       music_player_ym_init     — load Voice 00 bell pad on YM channels 0..5, mute PSG
                            	     6: ;       music_player_init_song   — point play state at caller-provided blob ptr (A0)
                            	     7: ;       music_player_tick        — call once per VBlank; dispatches due events
                            	     8: ;       music_player_silence_all — key-off all 6 FM channels, mute PSG
                            	     9: ;
                            	    10: ; Compiled blob is at label `song_great_fairy_blob`.  Layout (big-endian):
                            	    11: ;       u32 magic = 'MIDI'
                            	    12: ;       u32 num_events
                            	    13: ;       u32 loop_offset    (byte offset into events[] for loop point)
                            	    14: ;       events[N]:
                            	    15: ;           u16 delta_frames
                            	    16: ;           u8  op        ($00 note-off, $01 note-on, $FF end-of-song)
                            	    17: ;           u8  ch        (0..5 -> YM channel)
                            	    18: ;           u8  bf_hi     ((block<<3)|fnum_hi)  — destined for $A4+offset
                            	    19: ;           u8  fnum_lo   — destined for $A0+offset
                            	    20: ;
                            	    21: ; Private helpers use mp_ prefix to avoid name collisions with audio_driver.asm
                            	    22: ; when both are included into the same vasm translation unit (main ROM build).
                            	    23: ; The standalone midi_demo build links music_player.o alone — no conflicts either.
                            	    24: ;==============================================================================
                            	    25: 
                            	    26: ;----------------------------------------------------------------------
                            	    27: ; Hardware ports (private names: audio_driver.asm defines YM_ADDR1 etc.
                            	    28: ; globally, but we use our own copies for locality so bsr stays in range)
                            	    29: ;----------------------------------------------------------------------
                            	    30: MP_YM_ADDR1     equ $A04000
                            	    31: MP_YM_DATA1     equ $A04001
                            	    32: MP_YM_ADDR2     equ $A04002
                            	    33: MP_YM_DATA2     equ $A04003
                            	    34: MP_PSG_PORT     equ $C00011
                            	    35: 
                            	    36: ;----------------------------------------------------------------------
                            	    37: ; Player state (lives in RAM)
                            	    38: ;----------------------------------------------------------------------
                            	    39: MIDI_STATE      equ $FFE140
                            	    40: MS_PLAY_PTR     equ MIDI_STATE+0     ; long: pointer to next event's delta byte
                            	    41: MS_EVENTS_BASE  equ MIDI_STATE+4     ; long: pointer to events[] start
                            	    42: MS_LOOP_PTR     equ MIDI_STATE+8     ; long: events[] + loop_offset
                            	    43: MS_TIME_NEXT    equ MIDI_STATE+12    ; word: frames until next event
                            	    44: MS_END_PTR      equ MIDI_STATE+14    ; long: events[] end (events_base + 6*num_events)
                            	    45: 
                            	    46:     section "text",code
                            	    47: 
                            	    48: ;==============================================================================
                            	    49: ; mp_ym_w1 — write address+data atomically to YM2612 Part I.
                            	    50: ; Input:  D0.b = register, D1.b = data.  Preserves D0,D1.
                            	    51: ; Private to music_player.asm — keeps bsr calls local (always in range).
                            	    52: ;
                            	    53: ; SR lockout (same as audio_driver.ym_write1): the address+data pair MUST
                            	    54: ; go out as an atomic latched write. With audio_driver's HBlank-driven DMC
                            	    55: ; streamer enabled, the HINT handler also writes $2A + data to YM2612 Part
                            	    56: ; I; if it preempts between our address write and data write, the YM latch
                            	    57: ; is left pointing at $2A and our subsequent data byte lands in the DAC
                            	    58: ; instead of the intended register. Mask HINT (level 4) for the duration
                            	    59: ; of the pair by raising SR interrupt level to 6, then restore caller's
                            	    60: ; SR on exit.
                            	    61: ;==============================================================================
                            	    62: mp_ym_w1:
02:0000E0D4 40E7            	    63:     move.w  SR,-(SP)
02:0000E0D6 007C0600        	    64:     ori.w   #$0600,SR
                            	    65: .wait1:
02:0000E0DA 4A3900A04000    	    66:     tst.b   (MP_YM_ADDR1).l
02:0000E0E0 6BF8            	    67:     bmi.s   .wait1
02:0000E0E2 13C000A04000    	    68:     move.b  D0,(MP_YM_ADDR1).l
02:0000E0E8 4E71            	    69:     nop
02:0000E0EA 4E71            	    70:     nop
02:0000E0EC 4E71            	    71:     nop
02:0000E0EE 13C100A04001    	    72:     move.b  D1,(MP_YM_DATA1).l
02:0000E0F4 46DF            	    73:     move.w  (SP)+,SR
02:0000E0F6 4E75            	    74:     rts
                            	    75: 
                            	    76: ;==============================================================================
                            	    77: ; mp_ym_w2 — write address+data atomically to YM2612 Part II.
                            	    78: ; Busy flag is shared, so still poll Part I.  Same SR lockout as mp_ym_w1.
                            	    79: ;==============================================================================
                            	    80: mp_ym_w2:
02:0000E0F8 40E7            	    81:     move.w  SR,-(SP)
02:0000E0FA 007C0600        	    82:     ori.w   #$0600,SR
                            	    83: .wait2:
02:0000E0FE 4A3900A04000    	    84:     tst.b   (MP_YM_ADDR1).l
02:0000E104 6BF8            	    85:     bmi.s   .wait2
02:0000E106 13C000A04002    	    86:     move.b  D0,(MP_YM_ADDR2).l
02:0000E10C 4E71            	    87:     nop
02:0000E10E 4E71            	    88:     nop
02:0000E110 4E71            	    89:     nop
02:0000E112 13C100A04003    	    90:     move.b  D1,(MP_YM_DATA2).l
02:0000E118 46DF            	    91:     move.w  (SP)+,SR
02:0000E11A 4E75            	    92:     rts
                            	    93: 
                            	    94: ;==============================================================================
                            	    95: ; mp_load_patch — load 25-byte patch into one channel.
                            	    96: ; Input: A0 = pointer to 25-byte patch, D6.b = YM channel 0..5
                            	    97: ;==============================================================================
                            	    98: mp_load_patch:
02:0000E11C 48E7E2C0        	    99:     movem.l D0-D2/D6/A0-A1,-(SP)
02:0000E120 43FA0272        	   100:     lea     mp_FM_PATCH_REGS(PC),A1
02:0000E124 7418            	   101:     moveq   #24,D2                  ; 25 register/value pairs
02:0000E126 0C060003        	   102:     cmpi.b  #3,D6
02:0000E12A 6D10            	   103:     blt.s   .partI
                            	   104:     ; ch 3..5 — Part II, channel offset = ch-3
02:0000E12C 5706            	   105:     subi.b  #3,D6
                            	   106: .lpII:
02:0000E12E 1019            	   107:     move.b  (A1)+,D0
02:0000E130 D006            	   108:     add.b   D6,D0
02:0000E132 1218            	   109:     move.b  (A0)+,D1
02:0000E134 61C2            	   110:     bsr     mp_ym_w2
02:0000E136 51CAFFF6        	   111:     dbra    D2,.lpII
02:0000E13A 600C            	   112:     bra.s   .done
                            	   113: .partI:
                            	   114: .lpI:
02:0000E13C 1019            	   115:     move.b  (A1)+,D0
02:0000E13E D006            	   116:     add.b   D6,D0
02:0000E140 1218            	   117:     move.b  (A0)+,D1
02:0000E142 6190            	   118:     bsr     mp_ym_w1
02:0000E144 51CAFFF6        	   119:     dbra    D2,.lpI
                            	   120: .done:
02:0000E148 4CDF0347        	   121:     movem.l (SP)+,D0-D2/D6/A0-A1
02:0000E14C 4E75            	   122:     rts
                            	   123: 
                            	   124: ;==============================================================================
                            	   125: ; music_player_silence_all — key-off all 6 FM channels, mute PSG.
                            	   126: ; Called by music_player_ym_init at start of patch load AND by
                            	   127: ; music_dispatch.music_stop before handing YM back to audio_driver.
                            	   128: ;==============================================================================
                            	   129:     xdef    music_player_silence_all
                            	   130: music_player_silence_all:
02:0000E14E 48E7C000        	   131:     movem.l D0-D1,-(SP)
02:0000E152 103C0028        	   132:     move.b  #$28,D0
02:0000E156 7200            	   133:     moveq   #$00,D1
02:0000E158 6100FF7A        	   134:     bsr     mp_ym_w1
02:0000E15C 7201            	   135:     moveq   #$01,D1
02:0000E15E 6100FF74        	   136:     bsr     mp_ym_w1
02:0000E162 7202            	   137:     moveq   #$02,D1
02:0000E164 6100FF6E        	   138:     bsr     mp_ym_w1
02:0000E168 7204            	   139:     moveq   #$04,D1
02:0000E16A 6100FF68        	   140:     bsr     mp_ym_w1
02:0000E16E 7205            	   141:     moveq   #$05,D1
02:0000E170 6100FF62        	   142:     bsr     mp_ym_w1
02:0000E174 7206            	   143:     moveq   #$06,D1
02:0000E176 6100FF5C        	   144:     bsr     mp_ym_w1
                            	   145: 
02:0000E17A 13FC009F00C00011	   146:     move.b  #$9F,(MP_PSG_PORT).l
02:0000E182 13FC00BF00C00011	   147:     move.b  #$BF,(MP_PSG_PORT).l
02:0000E18A 13FC00DF00C00011	   148:     move.b  #$DF,(MP_PSG_PORT).l
02:0000E192 13FC00FF00C00011	   149:     move.b  #$FF,(MP_PSG_PORT).l
                            	   150: 
02:0000E19A 4CDF0003        	   151:     movem.l (SP)+,D0-D1
02:0000E19E 4E75            	   152:     rts
                            	   153: 
                            	   154: ;==============================================================================
                            	   155: ; music_player_ym_init — set up YM2612 for 6-voice bell pad playback.
                            	   156: ;==============================================================================
                            	   157:     xdef    music_player_ym_init
                            	   158: music_player_ym_init:
02:0000E1A0 48E7FE80        	   159:     movem.l D0-D6/A0,-(SP)
                            	   160: 
                            	   161:     ; Key-off all 6 channels + mute PSG
02:0000E1A4 61A8            	   162:     bsr     music_player_silence_all
                            	   163: 
                            	   164:     ; LFO off
02:0000E1A6 103C0022        	   165:     move.b  #$22,D0
02:0000E1AA 7200            	   166:     moveq   #0,D1
02:0000E1AC 6100FF26        	   167:     bsr     mp_ym_w1
                            	   168: 
                            	   169:     ; DAC disabled (ch 6 stays as FM, but we don't use it)
02:0000E1B0 103C002B        	   170:     move.b  #$2B,D0
02:0000E1B4 7200            	   171:     moveq   #0,D1
02:0000E1B6 6100FF1C        	   172:     bsr     mp_ym_w1
                            	   173: 
                            	   174:     ; Clear SSG-EG for every operator on all 6 channels.
                            	   175:     ; Part I = ch 0,1,2.  Part II = ch 3,4,5 (channel offsets 0,1,2 on Part II).
02:0000E1BA 7200            	   176:     moveq   #0,D1
02:0000E1BC 7C00            	   177:     moveq   #0,D6
                            	   178: .ssg_loop:
02:0000E1BE 1006            	   179:     move.b  D6,D0
02:0000E1C0 06000090        	   180:     addi.b  #$90,D0
02:0000E1C4 6100FF0E        	   181:     bsr     mp_ym_w1
02:0000E1C8 1006            	   182:     move.b  D6,D0
02:0000E1CA 06000090        	   183:     addi.b  #$90,D0
02:0000E1CE 6100FF28        	   184:     bsr     mp_ym_w2
02:0000E1D2 5206            	   185:     addq.b  #1,D6
02:0000E1D4 0C06000F        	   186:     cmpi.b  #15,D6                  ; 16 iterations covers $90..$9F (4 ops x 3 ch + skip)
02:0000E1D8 6FE4            	   187:     ble.s   .ssg_loop
                            	   188: 
                            	   189:     ; Load harp patch on ch 0..2 (lead), bell pad on ch 3..5 (backup).
02:0000E1DA 7C00            	   190:     moveq   #0,D6
                            	   191: .patch_lead:
02:0000E1DC 41FA01D0        	   192:     lea     mp_PATCH_VOICE00(PC),A0 ; bell pad on lead — best fit per user A/B
02:0000E1E0 6100FF3A        	   193:     bsr     mp_load_patch
02:0000E1E4 5206            	   194:     addq.b  #1,D6
02:0000E1E6 0C060002        	   195:     cmpi.b  #2,D6
02:0000E1EA 6FF0            	   196:     ble.s   .patch_lead
                            	   197: .patch_backup:
02:0000E1EC 41FA01DA        	   198:     lea     mp_PATCH_PAD(PC),A0     ; slow-swell mystical pad for backup line
02:0000E1F0 6100FF2A        	   199:     bsr     mp_load_patch
02:0000E1F4 5206            	   200:     addq.b  #1,D6
02:0000E1F6 0C060005        	   201:     cmpi.b  #5,D6
02:0000E1FA 6FF0            	   202:     ble.s   .patch_backup
                            	   203: 
                            	   204:     ; Panning L+R for ch 0..2 ($B4..$B6 Part I)
02:0000E1FC 123C00C0        	   205:     move.b  #$C0,D1
02:0000E200 103C00B4        	   206:     move.b  #$B4,D0
02:0000E204 6100FECE        	   207:     bsr     mp_ym_w1
02:0000E208 103C00B5        	   208:     move.b  #$B5,D0
02:0000E20C 6100FEC6        	   209:     bsr     mp_ym_w1
02:0000E210 103C00B6        	   210:     move.b  #$B6,D0
02:0000E214 6100FEBE        	   211:     bsr     mp_ym_w1
                            	   212:     ; ch 3..5 ($B4..$B6 Part II)
02:0000E218 103C00B4        	   213:     move.b  #$B4,D0
02:0000E21C 6100FEDA        	   214:     bsr     mp_ym_w2
02:0000E220 103C00B5        	   215:     move.b  #$B5,D0
02:0000E224 6100FED2        	   216:     bsr     mp_ym_w2
02:0000E228 103C00B6        	   217:     move.b  #$B6,D0
02:0000E22C 6100FECA        	   218:     bsr     mp_ym_w2
                            	   219: 
02:0000E230 4CDF017F        	   220:     movem.l (SP)+,D0-D6/A0
02:0000E234 4E75            	   221:     rts
                            	   222: 
                            	   223: ;==============================================================================
                            	   224: ; music_player_init_song(const void *blob)
                            	   225: ; C-callable: m68k SysV cdecl ABI passes the pointer arg on the stack at
                            	   226: ; 4(SP). Earlier docs claimed A0 input — that was wrong; gcc emits the call
                            	   227: ; with the arg pushed, not in A0. Empirically verified via BizHawk probe:
                            	   228: ; with A0-input contract, MS_PLAY_PTR stayed 0 (magic check failing on
                            	   229: ; whatever junk A0 held), MS_TIME_NEXT stuck at \$7FFF (.bad branch).
                            	   230: ;==============================================================================
                            	   231:     xdef    music_player_init_song
                            	   232: music_player_init_song:
02:0000E236 206F0004        	   233:     movea.l 4(SP),A0                 ; first arg: blob pointer
02:0000E23A 48E7E000        	   234:     movem.l D0-D2,-(SP)              ; save scratch (now stack = saved D0-D2 + retaddr + arg)
02:0000E23E 0C904D494449    	   235:     cmpi.l  #$4D494449,(A0)
02:0000E244 6644            	   236:     bne     .bad
                            	   237: 
02:0000E246 20280004        	   238:     move.l  4(A0),D0                 ; num_events
02:0000E24A 22280008        	   239:     move.l  8(A0),D1                 ; loop_offset (bytes)
                            	   240: 
02:0000E24E 41E8000C        	   241:     lea     12(A0),A0                ; A0 -> events_base (skip 12-byte header)
02:0000E252 23C800FFE144    	   242:     move.l  A0,(MS_EVENTS_BASE).l
02:0000E258 23C800FFE140    	   243:     move.l  A0,(MS_PLAY_PTR).l
                            	   244: 
02:0000E25E 2408            	   245:     move.l  A0,D2
02:0000E260 D481            	   246:     add.l   D1,D2
02:0000E262 23C200FFE148    	   247:     move.l  D2,(MS_LOOP_PTR).l
                            	   248: 
02:0000E268 2400            	   249:     move.l  D0,D2
02:0000E26A E38A            	   250:     lsl.l   #1,D2
02:0000E26C D480            	   251:     add.l   D0,D2
02:0000E26E D480            	   252:     add.l   D0,D2
02:0000E270 D480            	   253:     add.l   D0,D2
02:0000E272 D480            	   254:     add.l   D0,D2
02:0000E274 D488            	   255:     add.l   A0,D2
02:0000E276 23C200FFE14E    	   256:     move.l  D2,(MS_END_PTR).l
                            	   257: 
02:0000E27C 3010            	   258:     move.w  (A0),D0
02:0000E27E 33C000FFE14C    	   259:     move.w  D0,(MS_TIME_NEXT).l
                            	   260: 
02:0000E284 4CDF0007        	   261:     movem.l (SP)+,D0-D2
02:0000E288 4E75            	   262:     rts
                            	   263: 
                            	   264: .bad:
02:0000E28A 33FC7FFF00FFE14C	   265:     move.w  #$7FFF,(MS_TIME_NEXT).l
02:0000E292 4CDF0007        	   266:     movem.l (SP)+,D0-D2
02:0000E296 4E75            	   267:     rts
                            	   268: 
                            	   269: ;==============================================================================
                            	   270: ; music_player_tick — called once per VBlank.
                            	   271: ;==============================================================================
                            	   272:     xdef    music_player_tick
                            	   273: music_player_tick:
02:0000E298 48E7FE80        	   274:     movem.l D0-D6/A0,-(SP)
                            	   275: 
02:0000E29C 3E3900FFE14C    	   276:     move.w  (MS_TIME_NEXT).l,D7
02:0000E2A2 670A            	   277:     beq.s   .due
02:0000E2A4 5347            	   278:     subq.w  #1,D7
02:0000E2A6 33C700FFE14C    	   279:     move.w  D7,(MS_TIME_NEXT).l
02:0000E2AC 6664            	   280:     bne     .out
                            	   281: .due:
02:0000E2AE 207900FFE140    	   282:     movea.l (MS_PLAY_PTR).l,A0
                            	   283: 
                            	   284: .dispatch:
                            	   285:     ; Bounds check (defensive — well-formed blob hits 0xFF before this)
02:0000E2B4 2008            	   286:     move.l  A0,D0
02:0000E2B6 B0B900FFE14E    	   287:     cmp.l   (MS_END_PTR).l,D0
02:0000E2BC 6C3C            	   288:     bge.s   .loop_back
                            	   289: 
                            	   290:     ; Read header: u16 delta, u8 op, u8 ch, u8 bf_hi, u8 fnum_lo
02:0000E2BE 3A18            	   291:     move.w  (A0)+,D5                 ; delta (already consumed when we entered)
02:0000E2C0 1018            	   292:     move.b  (A0)+,D0                 ; op
02:0000E2C2 1C18            	   293:     move.b  (A0)+,D6                 ; ch (0..5)
02:0000E2C4 1618            	   294:     move.b  (A0)+,D3                 ; bf_hi (block<<3 | fnum_hi)
02:0000E2C6 1818            	   295:     move.b  (A0)+,D4                 ; fnum_lo
                            	   296: 
02:0000E2C8 0C0000FF        	   297:     cmpi.b  #$FF,D0
02:0000E2CC 672C            	   298:     beq.s   .loop_back
                            	   299: 
02:0000E2CE 0C000001        	   300:     cmpi.b  #$01,D0
02:0000E2D2 6706            	   301:     beq.s   .note_on
                            	   302:     ; else note-off
02:0000E2D4 6100009E        	   303:     bsr     mp_do_note_off
02:0000E2D8 6002            	   304:     bra.s   .next_event
                            	   305: 
                            	   306: .note_on:
02:0000E2DA 613C            	   307:     bsr     mp_do_note_on
                            	   308: 
                            	   309: .next_event:
                            	   310:     ; Peek next event's delta to see whether to keep dispatching this frame.
02:0000E2DC 2008            	   311:     move.l  A0,D0
02:0000E2DE B0B900FFE14E    	   312:     cmp.l   (MS_END_PTR).l,D0
02:0000E2E4 6C14            	   313:     bge.s   .loop_back
02:0000E2E6 3010            	   314:     move.w  (A0),D0                  ; next event's delta
02:0000E2E8 6602            	   315:     bne.s   .stop_dispatch
02:0000E2EA 60C8            	   316:     bra.s   .dispatch                ; delta=0, dispatch immediately
                            	   317: 
                            	   318: .stop_dispatch:
02:0000E2EC 33C000FFE14C    	   319:     move.w  D0,(MS_TIME_NEXT).l
02:0000E2F2 23C800FFE140    	   320:     move.l  A0,(MS_PLAY_PTR).l
02:0000E2F8 6018            	   321:     bra.s   .out
                            	   322: 
                            	   323: .loop_back:
02:0000E2FA 207900FFE148    	   324:     movea.l (MS_LOOP_PTR).l,A0
02:0000E300 3010            	   325:     move.w  (A0),D0
02:0000E302 33C000FFE14C    	   326:     move.w  D0,(MS_TIME_NEXT).l
02:0000E308 23C800FFE140    	   327:     move.l  A0,(MS_PLAY_PTR).l
                            	   328:     ; If we just landed on a delta-0 event, dispatch it now.
02:0000E30E 4A40            	   329:     tst.w   D0
02:0000E310 67A2            	   330:     beq.s   .dispatch
                            	   331: 
                            	   332: .out:
02:0000E312 4CDF017F        	   333:     movem.l (SP)+,D0-D6/A0
02:0000E316 4E75            	   334:     rts
                            	   335: 
                            	   336: ;==============================================================================
                            	   337: ; mp_do_note_on — emit block/fnum to YM ch in D6, then key-on all operators.
                            	   338: ; Input:  D6.b = ch 0..5, D3.b = bf_hi, D4.b = fnum_lo
                            	   339: ;==============================================================================
                            	   340: mp_do_note_on:
02:0000E318 48E7E000        	   341:     movem.l D0-D2,-(SP)
                            	   342: 
02:0000E31C 0C060003        	   343:     cmpi.b  #3,D6
02:0000E320 6D1E            	   344:     blt.s   .freq_partI
                            	   345:     ; Part II
02:0000E322 1406            	   346:     move.b  D6,D2
02:0000E324 5702            	   347:     subi.b  #3,D2                    ; ch-3 = Part II offset
02:0000E326 1002            	   348:     move.b  D2,D0
02:0000E328 060000A4        	   349:     addi.b  #$A4,D0                  ; reg $A4+offset
02:0000E32C 1203            	   350:     move.b  D3,D1                    ; data = bf_hi
02:0000E32E 6100FDC8        	   351:     bsr     mp_ym_w2
02:0000E332 1002            	   352:     move.b  D2,D0
02:0000E334 060000A0        	   353:     addi.b  #$A0,D0
02:0000E338 1204            	   354:     move.b  D4,D1
02:0000E33A 6100FDBC        	   355:     bsr     mp_ym_w2
02:0000E33E 6018            	   356:     bra.s   .key_on
                            	   357: 
                            	   358: .freq_partI:
02:0000E340 1006            	   359:     move.b  D6,D0
02:0000E342 060000A4        	   360:     addi.b  #$A4,D0
02:0000E346 1203            	   361:     move.b  D3,D1
02:0000E348 6100FD8A        	   362:     bsr     mp_ym_w1
02:0000E34C 1006            	   363:     move.b  D6,D0
02:0000E34E 060000A0        	   364:     addi.b  #$A0,D0
02:0000E352 1204            	   365:     move.b  D4,D1
02:0000E354 6100FD7E        	   366:     bsr     mp_ym_w1
                            	   367: 
                            	   368: .key_on:
                            	   369:     ; Key-on: reg $28 always Part I.  Data = $F0 | yamaha_id where
                            	   370:     ; yamaha_id = ch for ch<3, else ch+1.
02:0000E358 103C0028        	   371:     move.b  #$28,D0
02:0000E35C 1206            	   372:     move.b  D6,D1
02:0000E35E 0C060003        	   373:     cmpi.b  #3,D6
02:0000E362 6D02            	   374:     blt.s   .ko_lt
02:0000E364 5201            	   375:     addq.b  #1,D1
                            	   376: .ko_lt:
02:0000E366 000100F0        	   377:     ori.b   #$F0,D1
02:0000E36A 6100FD68        	   378:     bsr     mp_ym_w1
                            	   379: 
02:0000E36E 4CDF0007        	   380:     movem.l (SP)+,D0-D2
02:0000E372 4E75            	   381:     rts
                            	   382: 
                            	   383: ;==============================================================================
                            	   384: ; mp_do_note_off — key-off all operators on YM ch in D6.
                            	   385: ;==============================================================================
                            	   386: mp_do_note_off:
02:0000E374 48E7C000        	   387:     movem.l D0-D1,-(SP)
02:0000E378 103C0028        	   388:     move.b  #$28,D0
02:0000E37C 1206            	   389:     move.b  D6,D1
02:0000E37E 0C060003        	   390:     cmpi.b  #3,D6
02:0000E382 6D02            	   391:     blt.s   .kf_lt
02:0000E384 5201            	   392:     addq.b  #1,D1
                            	   393: .kf_lt:
02:0000E386 0201000F        	   394:     andi.b  #$0F,D1                  ; key bits = 0 -> all operators off
02:0000E38A 6100FD48        	   395:     bsr     mp_ym_w1
02:0000E38E 4CDF0003        	   396:     movem.l (SP)+,D0-D1
02:0000E392 4E75            	   397:     rts
                            	   398: 
                            	   399: ;==============================================================================
                            	   400: ; FM patch tables (private mp_ prefix — no conflict with audio_driver.asm)
                            	   401: ; Stay in "text" section (no section switch) so PC-relative lea stays within
                            	   402: ; ±32KB of the code that references these tables. audio_driver.asm does the
                            	   403: ; same: its patch tables live in "text" with no section change.
                            	   404: ;==============================================================================
                            	   405:     even
                            	   406: mp_FM_PATCH_REGS:
02:0000E394 B0              	   407:     dc.b    $B0
02:0000E395 30              	   408:     dc.b    $30,$34,$38,$3C
02:0000E396 34
02:0000E397 38
02:0000E398 3C
02:0000E399 50              	   409:     dc.b    $50,$54,$58,$5C
02:0000E39A 54
02:0000E39B 58
02:0000E39C 5C
02:0000E39D 60              	   410:     dc.b    $60,$64,$68,$6C
02:0000E39E 64
02:0000E39F 68
02:0000E3A0 6C
02:0000E3A1 70              	   411:     dc.b    $70,$74,$78,$7C
02:0000E3A2 74
02:0000E3A3 78
02:0000E3A4 7C
02:0000E3A5 80              	   412:     dc.b    $80,$84,$88,$8C
02:0000E3A6 84
02:0000E3A7 88
02:0000E3A8 8C
02:0000E3A9 40              	   413:     dc.b    $40,$44,$48,$4C
02:0000E3AA 44
02:0000E3AB 48
02:0000E3AC 4C
                            	   414:     even
                            	   415: 
                            	   416: ; Voice $00 — bell pad (Sonic 2 EHZ; verbatim from src/audio_driver.asm)
                            	   417: mp_PATCH_VOICE00:
02:0000E3AE 2D              	   418:     dc.b    $2D                     ; FB/ALG: (5<<3)|5
02:0000E3AF 04              	   419:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:0000E3B0 01
02:0000E3B1 01
02:0000E3B2 01
02:0000E3B3 1F              	   420:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:0000E3B4 1F
02:0000E3B5 1F
02:0000E3B6 1F
02:0000E3B7 08              	   421:     dc.b    $08,$04,$04,$04         ; AM/D1R
02:0000E3B8 04
02:0000E3B9 04
02:0000E3BA 04
02:0000E3BB 00              	   422:     dc.b    $00,$00,$00,$00         ; D2R
02:0000E3BC 00
02:0000E3BD 00
02:0000E3BE 00
02:0000E3BF 47              	   423:     dc.b    $47,$37,$37,$17         ; DL/RR — bell tail
02:0000E3C0 37
02:0000E3C1 37
02:0000E3C2 17
02:0000E3C3 14              	   424:     dc.b    $14,$1E,$1E,$1E         ; TL — modulator $14, carriers $1E
02:0000E3C4 1E
02:0000E3C5 1E
02:0000E3C6 1E
                            	   425:     even
                            	   426: 
                            	   427: ; Mystical pad — distinctly different from the celesta lead.  Carriers
                            	   428: ; have a SLOW attack so each note swells in like a breath of mist behind
                            	   429: ; the bright lead twinkle.  Op1 modulator stays at MUL 4 with high TL so
                            	   430: ; only a faint metallic shimmer rides on top of pure-tone carriers.  No
                            	   431: ; FB.  Carriers mildly detuned for chorus.  Net effect: airy washes
                            	   432: ; that bloom under the lead's plucks instead of competing with them.
                            	   433: mp_PATCH_PAD:
02:0000E3C8 05              	   434:     dc.b    $05                     ; FB/ALG: FB 0, ALG 5
02:0000E3C9 04              	   435:     dc.b    $04,$11,$01,$51         ; DT/MUL — op1 MUL 4 modulator
02:0000E3CA 11
02:0000E3CB 01
02:0000E3CC 51
02:0000E3CD 1F              	   436:     dc.b    $1F,$10,$10,$10         ; RS/AR — mod instant, carriers SLOW attack
02:0000E3CE 10
02:0000E3CF 10
02:0000E3D0 10
02:0000E3D1 00              	   437:     dc.b    $00,$02,$02,$02         ; AM/D1R — long decay
02:0000E3D2 02
02:0000E3D3 02
02:0000E3D4 02
02:0000E3D5 00              	   438:     dc.b    $00,$00,$00,$00         ; D2R
02:0000E3D6 00
02:0000E3D7 00
02:0000E3D8 00
02:0000E3D9 4A              	   439:     dc.b    $4A,$28,$28,$28         ; DL/RR — long sustained tail
02:0000E3DA 28
02:0000E3DB 28
02:0000E3DC 28
02:0000E3DD 30              	   440:     dc.b    $30,$1A,$1A,$1A         ; TL — mod whisper, carriers gentle
02:0000E3DE 1A
02:0000E3DF 1A
02:0000E3E0 1A
                            	   441:     even
                            	   442: 
                            	   443: ; Flute/organ patch — additive ALG 7 (4 carriers in parallel).
                            	   444: ;   Op MUL ratios 1:2:3:4 add octave and 5th overtones for an airy, woody
                            	   445: ;   timbre.  Sustained envelope (no decay during note hold), fast release
                            	   446: ;   on key-off.  FB 1 for slight warmth without distortion.
                            	   447: ;   Slot byte order in YM2612 patches is op1, op3, op2, op4.
                            	   448: mp_PATCH_FLUTE:
02:0000E3E2 0F              	   449:     dc.b    $0F                     ; FB/ALG: (1<<3)|7
02:0000E3E3 01              	   450:     dc.b    $01,$03,$02,$04         ; DT/MUL (op1=1, op3=3, op2=2, op4=4)
02:0000E3E4 03
02:0000E3E5 02
02:0000E3E6 04
02:0000E3E7 1F              	   451:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR — instant attack
02:0000E3E8 1F
02:0000E3E9 1F
02:0000E3EA 1F
02:0000E3EB 00              	   452:     dc.b    $00,$00,$00,$00         ; AM/D1R — no decay, sustain at TL
02:0000E3EC 00
02:0000E3ED 00
02:0000E3EE 00
02:0000E3EF 00              	   453:     dc.b    $00,$00,$00,$00         ; D2R
02:0000E3F0 00
02:0000E3F1 00
02:0000E3F2 00
02:0000E3F3 0F              	   454:     dc.b    $0F,$0F,$0F,$0F         ; DL/RR — DL 0, RR 15 (fast release)
02:0000E3F4 0F
02:0000E3F5 0F
02:0000E3F6 0F
02:0000E3F7 18              	   455:     dc.b    $18,$24,$20,$2C         ; TL — fundamental loudest, harmonics quieter
02:0000E3F8 24
02:0000E3F9 20
02:0000E3FA 2C
                            	   456:     even
                            	   457: 
                            	   458: ; Voice $03 — EHZ FM3 lead (Sonic 2; bright FB7 / Algorithm 5).
                            	   459: mp_PATCH_VOICE03:
02:0000E3FC 3D              	   460:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:0000E3FD 01              	   461:     dc.b    $01,$51,$21,$01         ; DT/MUL
