02:0002D3B6 303900FF0832    	  3030:     move.w  (CHR_BUF_VADDR).l,D0
02:0002D3BC 0800000C        	  3031:     btst    #12,D0
02:0002D3C0 6608            	  3032:     bne.s   .ttf_chr_bg_dispatch
02:0002D3C2 4EB900010944    	  3033:     bsr     _chr_upload_sprite_4x
02:0002D3C8 6028            	  3034:     bra.s   .ttf_chr_uploaded
