02:0004A06A 600000AA        	  4081:     jmp  L1F148_Exit
                            	  4082: __far_z_07_0046:
                            	  4083:     even
                            	  4084: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4085:     ; If grid offset <> 0, return.
                            	  4086:     ;
02:0004A06E 41EC0394        	  4087:     lea     ($0394,A4),A0
02:0004A072 10302000        	  4088:     move.b  (A0,D2.W),D0
02:0004A076 6704            	  4089:     beq.s  __far_z_07_0047
02:0004A078 6000009C        	  4090:     jmp  L1F148_Exit
                            	  4091: __far_z_07_0047:
                            	  4092:     ; Grid offset = 0.
                            	  4093:     ; The object is at a point between cells in the grid.
                            	  4094:     ; So, we can check tiles for collision.
                            	  4095:     ;
                            	  4096:     ; Reset [0E] alternate direction search step.
                            	  4097:     ;
02:0004A07C 1940000E        	  4098:     move.b  D0,($000E,A4)
                            	  4099:     ; If there's a movement direction, go check tile collision.
                            	  4100:     ;
02:0004A080 102C000F        	  4101:     move.b  ($000F,A4),D0
02:0004A084 6702            	  4102:     beq.s  __far_z_07_0048
02:0004A086 602E            	  4103:     jmp  CheckTiles
                            	  4104: __far_z_07_0048:
                            	  4105:     ; Moving direction = 0.
                            	  4106:     ; If object is the player, return.
                            	  4107:     ;
02:0004A088 4A02            	  4108:     cmpi.b  #$00,D2
02:0004A08A 6604            	  4109:     bne.s  __far_z_07_0049
02:0004A08C 60000088        	  4110:     jmp  L1F148_Exit
                            	  4111: __far_z_07_0049:
                            	  4112:     ; Moving direction = 0.
                            	  4113:     ; The object is not the player.
                            	  4114:     ;
                            	  4115:     ; If object does not have attribute $10, then
                            	  4116:     ; set movement direction to input direction,
                            	  4117:     ; and go try to turn to an unblocked direction in order to move.
                            	  4118:     ;
02:0004A090 41EC04BF        	  4119:     lea     ($04BF,A4),A0
02:0004A094 10302000        	  4120:     move.b  (A0,D2.W),D0
02:0004A098 02000010        	  4121:     andi.b #$10,D0
02:0004A09C 6702            	  4122:     beq.s  __far_z_07_0050
02:0004A09E 600E            	  4123:     jmp  Reverse
