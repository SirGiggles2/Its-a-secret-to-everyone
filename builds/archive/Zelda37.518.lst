                            	   720: 
                            	   721: ;==============================================================================
                            	   722: ; Zelda translated code — generated by tools/transpile_6502.py --all --no-stubs
                            	   723: ;
                            	   724: ; z_07.asm is the NES fixed bank ($E000-$FFFF): IsrReset, IsrNmi, RunGame,
                            	   725: ; and ALL shared equates (NES RAM variables).  It must be included first.
                            	   726: ;
                            	   727: ; z_00–z_06 are the switchable PRG banks.  They carry no equate block in
                            	   728: ; --all mode (suppressed by transpiler to avoid vasm duplicate-symbol errors).
                            	   729: ; All cross-bank import stubs are also suppressed — every symbol resolves
                            	   730: ; directly by label across the flat Genesis ROM.
                            	   731: ;
                            	   732: ; vasm CWD is src/ (set by build.bat pushd), so paths are relative to src/.
                            	   733: ;==============================================================================
                            	   734:     ; All 8 banks included in ascending order (z_00 first so its definitions of
                            	   735:     ; multiply-exported symbols like Exit are canonical).  z_07 is included last
                            	   736:     ; so its cross-bank stubs (which are suppressed for globally-exported symbols)
                            	   737:     ; don't conflict with real definitions from z_00-z_06.
                            	   738:     ; Equates are only in z_07 (other banks omit them in --all mode).
                            	   739:     include "zelda_translated/z_00.asm"

