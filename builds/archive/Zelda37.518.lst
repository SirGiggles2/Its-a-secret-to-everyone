02:0003BC7C 41EC0485        	  3760:     lea     ($0485,A4),A0
02:0003BC80 11802000        	  3761:     move.b  D0,(A0,D2.W)
02:0003BC84 610005F4        	  3762:     jsr     CheckBossHitReaction
                            	  3763:     ; Look for the tail segment, starting from the low end
                            	  3764:     ; of the chain that this dead segment belongs to.
                            	  3765:     ;
02:0003BC88 163C00FF        	  3766:     move.b  #$FF,D3
02:0003BC8C 0C020006        	  3767:     cmpi.b  #$06,D2
02:0003BC90 6502            	  3768:     bcs  _anon_z04_80
02:0003BC92 7604            	  3769:     moveq   #4,D3
                            	  3770: _anon_z04_80:
02:0003BC94 5203            	  3771:     addq.b  #1,D3
02:0003BC96 41EC0350        	  3772:     lea     ($0350,A4),A0
02:0003BC9A 10303000        	  3773:     move.b  (A0,D3.W),D0
02:0003BC9E 0C000041        	  3774:     cmpi.b  #$41,D0
02:0003BCA2 66F0            	  3775:     bne  _anon_z04_80
                            	  3776:     ; I don't know why the object timer of the tail segment that will
                            	  3777:     ; be made dead is set to $11. By setting its object type to $5D
                            	  3778:     ; below, its metastate will become $10 -- dying/dead. From
                            	  3779:     ; there, the object timer is set to 6.
                            	  3780:     ;
02:0003BCA4 7011            	  3781:     moveq   #17,D0
02:0003BCA6 19803029        	  3782:     move.b  D0,($29,A4,D3.W)
                            	  3783:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  3784:     ; segment to the tail segment.
                            	  3785:     ;
02:0003BCAA 41EC04F0        	  3786:     lea     ($04F0,A4),A0
02:0003BCAE 10302000        	  3787:     move.b  (A0,D2.W),D0
02:0003BCB2 41EC04F1        	  3788:     lea     ($04F1,A4),A0
02:0003BCB6 11803000        	  3789:     move.b  D0,(A0,D3.W)
02:0003BCBA 10342070        	  3790:     move.b  ($70,A4,D2.W),D0
02:0003BCBE 19803071        	  3791:     move.b  D0,($71,A4,D3.W)
02:0003BCC2 41EC0084        	  3792:     lea     ($0084,A4),A0
02:0003BCC6 10302000        	  3793:     move.b  (A0,D2.W),D0
02:0003BCCA 41EC0085        	  3794:     lea     ($0085,A4),A0
02:0003BCCE 11803000        	  3795:     move.b  D0,(A0,D3.W)
                            	  3796:     ; If the tail segment found is also a head, then
                            	  3797:     ; the last segment has died. Return.
                            	  3798:     ;
02:0003BCD2 0C030004        	  3799:     cmpi.b  #$04,D3
02:0003BCD6 6716            	  3800:     beq  _L_z04_UpdateMoldorm_Exit
02:0003BCD8 0C030009        	  3801:     cmpi.b  #$09,D3
02:0003BCDC 6710            	  3802:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3803:     ; Else finish swapping the segments.
                            	  3804:     ; Set the tail segment's type to the dead dummy object.
                            	  3805:     ;
02:0003BCDE 705D            	  3806:     moveq   #93,D0
02:0003BCE0 41EC0350        	  3807:     lea     ($0350,A4),A0
02:0003BCE4 11803000        	  3808:     move.b  D0,(A0,D3.W)
                            	  3809:     ; Reset the metastate of the current segment, so that it comes
                            	  3810:     ; back to life.
                            	  3811:     ;
02:0003BCE8 4EB90004BA20    	  3812:     jsr     ResetObjMetastate
