                            	  3692: ModifyObjCountByHistoryOW:
                            	  3693:     ;Look for the room in the history.
                            	  3694:     ;
02:000406E8 7605            	  3695:     moveq   #5,D3
02:000406EA 102C00EB        	  3696:     move.b  ($00EB,A4),D0
                            	  3697: _anon_z05_90:
02:000406EE 41EC0621        	  3698:     lea     ($0621,A4),A0
02:000406F2 12303000        	  3699:     move.b  (A0,D3.W),D1
02:000406F6 B001            	  3700:     cmp.b   D1,D0
02:000406F8 6752            	  3701:     beq  _anon_z05_91
02:000406FA 5303            	  3702:     subq.b  #1,D3
02:000406FC 6AF0            	  3703:     bpl  _anon_z05_90
                            	  3704:     ; It wasn't found. Check the kill count in the room flags.
                            	  3705:     ;
02:000406FE 4EB9000490F6    	  3706:     jsr     GetRoomFlags
02:00040704 02000007        	  3707:     andi.b #$07,D0
02:00040708 0C000007        	  3708:     cmpi.b  #$07,D0
02:0004070C 663E            	  3709:     bne  _anon_z05_91
                            	  3710:     ; The room is not in history, and all foes were defeated.
                            	  3711:     ; So, reset the kill count in room flags.
                            	  3712:     ;
02:0004070E 1214            	  3713:     move.b  ($00,A4),D1   ; ptr lo
02:00040710 182C0001        	  3714:     move.b  ($01,A4),D4  ; ptr hi
02:00040714 024100FF        	  3715:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040718 E14C            	  3716:     lsl.w   #8,D4
02:0004071A 8841            	  3717:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004071C 48C4            	  3718:     ext.l   D4
02:0004071E D8BC00FF0000    	  3719:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040724 2044            	  3720:     movea.l D4,A0
02:00040726 10303000        	  3721:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004072A 020000F8        	  3722:     andi.b #$F8,D0
02:0004072E 1214            	  3723:     move.b  ($00,A4),D1   ; ptr lo
02:00040730 182C0001        	  3724:     move.b  ($01,A4),D4  ; ptr hi
02:00040734 024100FF        	  3725:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040738 E14C            	  3726:     lsl.w   #8,D4
02:0004073A 8841            	  3727:     or.w    D1,D4
02:0004073C 48C4            	  3728:     ext.l   D4
02:0004073E D8BC00FF0000    	  3729:     add.l   #NES_RAM,D4
02:00040744 2044            	  3730:     movea.l D4,A0
02:00040746 11803000        	  3731:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  3732:     even
                            	  3733: _L_z05_ModifyObjCountByHistoryOW_Exit:
02:0004074A 4E75            	  3734:     rts
                            	  3735: 
                            	  3736: _anon_z05_91:
                            	  3737:     ; If kill count in room flags = 0, leave object count alone, and return.
                            	  3738:     ;
02:0004074C 4EB9000490F6    	  3739:     jsr     GetRoomFlags
