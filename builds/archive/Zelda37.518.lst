                            	  3223:     ;
02:000403C2 7601            	  3224:     moveq   #1,D3
02:000403C4 102C0070        	  3225:     move.b  ($0070,A4),D0
02:000403C8 0C000050        	  3226:     cmpi.b  #$50,D0
02:000403CC 6712            	  3227:     beq  _anon_z05_83
02:000403CE 5203            	  3228:     addq.b  #1,D3
02:000403D0 0C000080        	  3229:     cmpi.b  #$80,D0
02:000403D4 670A            	  3230:     beq  _anon_z05_83
02:000403D6 5203            	  3231:     addq.b  #1,D3
02:000403D8 0C0000B0        	  3232:     cmpi.b  #$B0,D0
02:000403DC 6702            	  3233:     beq.s  __far_z_05_0062
