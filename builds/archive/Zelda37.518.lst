02:0004ACE4 023C00EE        	  5933:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004ACE8 122C0657        	  5934:     move.b  ($0657,A4),D1
02:0004ACEC D101            	  5935:     addx.b  D1,D0   ; ADC Items
02:0004ACEE 003C0011        	  5936:     ori     #$11,CCR  ; SEC: set C+X
