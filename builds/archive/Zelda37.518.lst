02:00036F82 19400028        	  4350:     move.b  D0,($0028,A4)
                            	  4351:     ; Set a long timer of $40 ($280 frames) for the whole duration
                            	  4352:     ; of the next submode.
                            	  4353:     ;
02:00036F86 7040            	  4354:     moveq   #64,D0
02:00036F88 1940004D        	  4355:     move.b  D0,($004D,A4)
02:00036F8C 522C0013        	  4356:     addq.b  #1,($0013,A4)
