02:0002E15A 08000008        	  2520:     btst    #8,D0
02:0002E15E 670A            	  2521:     beq.s   .cc_cnras
02:0002E160 003C0001        	  2522:     ori     #$01,CCR
02:0002E164 0A3C0001        	  2523:     eori    #$01,CCR
02:0002E168 4E75            	  2524:     rts
                            	  2525: .cc_cnras:
02:0002E16A 023C00FE        	  2526:     andi    #$FE,CCR
02:0002E16E 0A3C0001        	  2527:     eori    #$01,CCR
02:0002E172 4E75            	  2528:     rts
                            	  2529: 
