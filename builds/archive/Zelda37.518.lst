02:0004AA10 4EB900032BF6    	  5578:     jsr     SetBoomerangSpeed
02:0004AA16 102C000A        	  5579:     move.b  ($000A,A4),D0
02:0004AA1A 1940000F        	  5580:     move.b  D0,($000F,A4)
02:0004AA1E 41EC0098        	  5581:     lea     ($0098,A4),A0
