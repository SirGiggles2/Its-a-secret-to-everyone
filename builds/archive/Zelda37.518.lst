02:0003B40C 41EC034F        	  2652:     lea     ($034F,A4),A0
02:0003B410 10302000        	  2653:     move.b  (A0,D2.W),D0
02:0003B414 0C000065        	  2654:     cmpi.b  #$65,D0
02:0003B418 6708            	  2655:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
02:0003B41A 102C0665        	  2656:     move.b  ($0665,A4),D0
02:0003B41E 67000092        	  2657:     beq  _L_z04_UpdateRockOrGravestone_Exit
