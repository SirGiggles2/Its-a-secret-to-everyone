                            	   984: ;==============================================================================
                            	   985: ; tick_sq0 — Sq0 channel update
                            	   986: ;==============================================================================
                            	   987: tick_sq0:
02:00000A56 4A3900FFE014    	   988:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:00000A5C 6754            	   989:     beq     tick_trg
02:00000A5E 533900FFE015    	   990:     subq.b  #1,(m_sq0_cnt).l
02:00000A64 664C            	   991:     bne     tick_trg
02:00000A66 207900FFE008    	   992:     move.l  (m_script_ptr).l,A0
02:00000A6C 7200            	   993:     moveq   #0,D1
02:00000A6E 123900FFE014    	   994:     move.b  (m_sq0_off).l,D1
02:00000A74 523900FFE014    	   995:     addq.b  #1,(m_sq0_off).l
02:00000A7A 10301000        	   996:     move.b  (A0,D1.w),D0
02:00000A7E 4A00            	   997:     tst.b   D0
02:00000A80 6A22            	   998:     bpl.s   .play
02:00000A82 61000164        	   999:     bsr     get_song_note_length
02:00000A86 13C000FFE016    	  1000:     move.b  D0,(m_sq0_len).l
02:00000A8C 207900FFE008    	  1001:     move.l  (m_script_ptr).l,A0
02:00000A92 7200            	  1002:     moveq   #0,D1
02:00000A94 123900FFE014    	  1003:     move.b  (m_sq0_off).l,D1
02:00000A9A 523900FFE014    	  1004:     addq.b  #1,(m_sq0_off).l
02:00000AA0 10301000        	  1005:     move.b  (A0,D1.w),D0
                            	  1006: .play:
02:00000AA4 610001BA        	  1007:     bsr     emit_note_sq0
02:00000AA8 13F900FFE01600FF	  1008:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000AB0 E015
                            	  1009:     bra     tick_trg
                            	  1010: 
                            	  1011: ;==============================================================================
                            	  1012: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	  1013: ;==============================================================================
                            	  1014: tick_trg:
02:00000AB2 4A3900FFE01C    	  1015:     tst.b   (m_trg_off).l
02:00000AB8 6700009E        	  1016:     beq     tick_noise
02:00000ABC 533900FFE01D    	  1017:     subq.b  #1,(m_trg_cnt).l
02:00000AC2 66000094        	  1018:     bne     tick_noise
                            	  1019: .prep_note_or_passage:
02:00000AC6 207900FFE008    	  1020:     move.l  (m_script_ptr).l,A0
02:00000ACC 7200            	  1021:     moveq   #0,D1
02:00000ACE 123900FFE01C    	  1022:     move.b  (m_trg_off).l,D1
02:00000AD4 523900FFE01C    	  1023:     addq.b  #1,(m_trg_off).l
02:00000ADA 10301000        	  1024:     move.b  (A0,D1.w),D0
02:00000ADE 676A            	  1025:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000AE0 4A00            	  1026:     tst.b   D0
02:00000AE2 6A56            	  1027:     bpl.s   .play_note_trg                ; direct note
02:00000AE4 0C0000F0        	  1028:     cmpi.b  #$F0,D0
02:00000AE8 6718            	  1029:     beq.s   .end_of_passage
02:00000AEA 652A            	  1030:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1031:     ; $F1-$FF → start passage
02:00000AEC 040000F0        	  1032:     subi.b  #$F0,D0
02:00000AF0 13C000FFE021    	  1033:     move.b  D0,(m_trg_rep_n).l
02:00000AF6 13F900FFE01C00FF	  1034:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000AFE E022
02:00000B00 60C4            	  1035:     bra.s   .prep_note_or_passage
                            	  1036: .end_of_passage:
02:00000B02 533900FFE021    	  1037:     subq.b  #1,(m_trg_rep_n).l
02:00000B08 670A            	  1038:     beq.s   .pass_done
02:00000B0A 13F900FFE02200FF	  1039:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000B12 E01C
                            	  1040: .pass_done:
02:00000B14 60B0            	  1041:     bra.s   .prep_note_or_passage
                            	  1042: .prep_note_trg:
02:00000B16 610000D0        	  1043:     bsr     get_song_note_length
02:00000B1A 13C000FFE01E    	  1044:     move.b  D0,(m_trg_len).l
02:00000B20 207900FFE008    	  1045:     move.l  (m_script_ptr).l,A0
02:00000B26 7200            	  1046:     moveq   #0,D1
02:00000B28 123900FFE01C    	  1047:     move.b  (m_trg_off).l,D1
02:00000B2E 523900FFE01C    	  1048:     addq.b  #1,(m_trg_off).l
02:00000B34 10301000        	  1049:     move.b  (A0,D1.w),D0
02:00000B38 6710            	  1050:     beq.s   .silence_trg
                            	  1051: .play_note_trg:
02:00000B3A 61000182        	  1052:     bsr     emit_note_trg
02:00000B3E 13F900FFE01E00FF	  1053:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B46 E01D
02:00000B48 600E            	  1054:     bra     tick_noise
                            	  1055: .silence_trg:
02:00000B4A 610001E6        	  1056:     bsr     key_off_trg
02:00000B4E 13F900FFE01E00FF	  1057:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B56 E01D
                            	  1058:     bra     tick_noise
                            	  1059: 
                            	  1060: ;==============================================================================
                            	  1061: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1062: ;==============================================================================
                            	  1063: tick_noise:
02:00000B58 103900FFE000    	  1064:     move.b  (m_song).l,D0
02:00000B5E 02000091        	  1065:     andi.b  #$91,D0
02:00000B62 67000082        	  1066:     beq     .tn_done
                            	  1067:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1068:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1069:     ; a hit fires below.
02:00000B66 61000250        	  1070:     bsr     noise_decay_tick
02:00000B6A 533900FFE025    	  1071:     subq.b  #1,(m_noise_cnt).l
02:00000B70 6674            	  1072:     bne     .tn_done
                            	  1073: .read:
02:00000B72 207900FFE008    	  1074:     move.l  (m_script_ptr).l,A0
02:00000B78 7200            	  1075:     moveq   #0,D1
02:00000B7A 123900FFE024    	  1076:     move.b  (m_noise_off).l,D1
02:00000B80 523900FFE024    	  1077:     addq.b  #1,(m_noise_off).l
02:00000B86 10301000        	  1078:     move.b  (A0,D1.w),D0
02:00000B8A 660C            	  1079:     bne.s   .got
02:00000B8C 13F900FFE00600FF	  1080:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B94 E024
02:00000B96 60DA            	  1081:     bra.s   .read
                            	  1082: .got:
02:00000B98 1800            	  1083:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1084:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1085:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1086:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1087:     ; (0,7,6). For our port we replicate exactly.
02:00000B9A 7400            	  1088:     moveq   #0,D2
02:00000B9C 1404            	  1089:     move.b  D4,D2
                            	  1090:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B9E 7000            	  1091:     moveq   #0,D0
02:00000BA0 08020000        	  1092:     btst    #0,D2
02:00000BA4 6704            	  1093:     beq.s   .b0
02:00000BA6 08C00002        	  1094:     bset    #2,D0
                            	  1095: .b0:
02:00000BAA 08020007        	  1096:     btst    #7,D2
02:00000BAE 6704            	  1097:     beq.s   .b7
02:00000BB0 08C00001        	  1098:     bset    #1,D0
                            	  1099: .b7:
02:00000BB4 08020006        	  1100:     btst    #6,D2
02:00000BB8 6704            	  1101:     beq.s   .b6
02:00000BBA 08C00000        	  1102:     bset    #0,D0
                            	  1103: .b6:
02:00000BBE 7200            	  1104:     moveq   #0,D1
02:00000BC0 123900FFE003    	  1105:     move.b  (m_len_base).l,D1
02:00000BC6 D240            	  1106:     add.w   D0,D1
02:00000BC8 43F900000E6A    	  1107:     lea     (NoteLengthTables).l,A1
02:00000BCE 13F1100000FFE025	  1108:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1109:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000BD6 1004            	  1110:     move.b  D4,D0
02:00000BD8 0200003E        	  1111:     andi.b  #$3E,D0
02:00000BDC E808            	  1112:     lsr.b   #4,D0
02:00000BDE 7200            	  1113:     moveq   #0,D1
02:00000BE0 1200            	  1114:     move.b  D0,D1
                            	  1115:     ; Map to PSG noise: set volume + period
02:00000BE2 6100015A        	  1116:     bsr     set_psg_noise
                            	  1117: .tn_done:
02:00000BE6 4E75            	  1118:     rts
                            	  1119: 
                            	  1120: ;==============================================================================
                            	  1121: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1122: ; Input: D0 = control byte → Output: D0 = length
                            	  1123: ;==============================================================================
                            	  1124: get_song_note_length:
02:00000BE8 02400007        	  1125:     andi.w  #$07,D0
02:00000BEC 7200            	  1126:     moveq   #0,D1
02:00000BEE 123900FFE003    	  1127:     move.b  (m_len_base).l,D1
02:00000BF4 D240            	  1128:     add.w   D0,D1
02:00000BF6 43F900000E6A    	  1129:     lea     (NoteLengthTables).l,A1
02:00000BFC 10311000        	  1130:     move.b  (A1,D1.w),D0
02:00000C00 4E75            	  1131:     rts
                            	  1132: 
                            	  1133: ;==============================================================================
                            	  1134: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1135: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1136: ;==============================================================================
                            	  1137: emit_note_sq1:
02:00000C02 024000FF        	  1138:     andi.w  #$FF,D0
02:00000C06 43F900000DF8    	  1139:     lea     (MusicNotePeriodTable).l,A1
02:00000C0C 7400            	  1140:     moveq   #0,D2
02:00000C0E 14310001        	  1141:     move.b  1(A1,D0.w),D2                 ; lo
02:00000C12 67000106        	  1142:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000C16 7600            	  1143:     moveq   #0,D3
02:00000C18 16310000        	  1144:     move.b  0(A1,D0.w),D3                 ; hi
02:00000C1C E14B            	  1145:     lsl.w   #8,D3
02:00000C1E 8642            	  1146:     or.w    D2,D3                          ; D3.w = period
02:00000C20 024307FF        	  1147:     andi.w  #$07FF,D3
02:00000C24 13C200FFE010    	  1148:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000C2A 3403            	  1149:     move.w  D3,D2
02:00000C2C 263C00021986    	  1150:     move.l  #NES_YM_K5_PULSE,D3
02:00000C32 6100F7E4        	  1151:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1152:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000C36 103C0028        	  1153:     move.b  #$28,D0
02:00000C3A 7200            	  1154:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000C3C 6100F792        	  1155:     bsr     ym_write1
02:00000C40 103C00A4        	  1156:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000C44 1202            	  1157:     move.b  D2,D1
02:00000C46 6100F788        	  1158:     bsr     ym_write1
02:00000C4A 103C00A0        	  1159:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000C4E 1203            	  1160:     move.b  D3,D1
02:00000C50 6100F77E        	  1161:     bsr     ym_write1
                            	  1162:     ; Key on ch 0, all ops
02:00000C54 103C0028        	  1163:     move.b  #$28,D0
02:00000C58 123C00F0        	  1164:     move.b  #$F0,D1
02:00000C5C 6000F772        	  1165:     bra     ym_write1
                            	  1166: 
                            	  1167: ;==============================================================================
                            	  1168: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1169: ;==============================================================================
                            	  1170: emit_note_sq0:
02:00000C60 024000FF        	  1171:     andi.w  #$FF,D0
02:00000C64 43F900000DF8    	  1172:     lea     (MusicNotePeriodTable).l,A1
02:00000C6A 7400            	  1173:     moveq   #0,D2
02:00000C6C 14310001        	  1174:     move.b  1(A1,D0.w),D2
02:00000C70 670000B4        	  1175:     beq     key_off_sq0
02:00000C74 7600            	  1176:     moveq   #0,D3
02:00000C76 16310000        	  1177:     move.b  0(A1,D0.w),D3
02:00000C7A E14B            	  1178:     lsl.w   #8,D3
02:00000C7C 8642            	  1179:     or.w    D2,D3
02:00000C7E 024307FF        	  1180:     andi.w  #$07FF,D3
02:00000C82 13C200FFE018    	  1181:     move.b  D2,(m_sq0_per).l
02:00000C88 3403            	  1182:     move.w  D3,D2
02:00000C8A 263C00021986    	  1183:     move.l  #NES_YM_K5_PULSE,D3
02:00000C90 6100F786        	  1184:     bsr     nes_to_ym_freq
                            	  1185:     ; Key off first so the envelope attack phase retriggers
02:00000C94 103C0028        	  1186:     move.b  #$28,D0
02:00000C98 7201            	  1187:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000C9A 6100F734        	  1188:     bsr     ym_write1
02:00000C9E 103C00A5        	  1189:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000CA2 1202            	  1190:     move.b  D2,D1
02:00000CA4 6100F72A        	  1191:     bsr     ym_write1
02:00000CA8 103C00A1        	  1192:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000CAC 1203            	  1193:     move.b  D3,D1
02:00000CAE 6100F720        	  1194:     bsr     ym_write1
02:00000CB2 103C0028        	  1195:     move.b  #$28,D0
02:00000CB6 123C00F1        	  1196:     move.b  #$F1,D1
02:00000CBA 6000F714        	  1197:     bra     ym_write1
                            	  1198: 
                            	  1199: ;==============================================================================
                            	  1200: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1201: ;==============================================================================
                            	  1202: emit_note_trg:
02:00000CBE 024000FF        	  1203:     andi.w  #$FF,D0
02:00000CC2 43F900000DF8    	  1204:     lea     (MusicNotePeriodTable).l,A1
02:00000CC8 7400            	  1205:     moveq   #0,D2
02:00000CCA 14310001        	  1206:     move.b  1(A1,D0.w),D2
02:00000CCE 6762            	  1207:     beq     key_off_trg
02:00000CD0 7600            	  1208:     moveq   #0,D3
02:00000CD2 16310000        	  1209:     move.b  0(A1,D0.w),D3
02:00000CD6 E14B            	  1210:     lsl.w   #8,D3
02:00000CD8 8642            	  1211:     or.w    D2,D3
02:00000CDA 024307FF        	  1212:     andi.w  #$07FF,D3
02:00000CDE 13C200FFE020    	  1213:     move.b  D2,(m_trg_per).l
02:00000CE4 3403            	  1214:     move.w  D3,D2
02:00000CE6 263C00010CC3    	  1215:     move.l  #NES_YM_K5_TRI,D3
02:00000CEC 6100F72A        	  1216:     bsr     nes_to_ym_freq
                            	  1217:     ; Key off first so the bass envelope retriggers per note
02:00000CF0 103C0028        	  1218:     move.b  #$28,D0
02:00000CF4 7202            	  1219:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000CF6 6100F6D8        	  1220:     bsr     ym_write1
02:00000CFA 103C00A6        	  1221:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000CFE 1202            	  1222:     move.b  D2,D1
02:00000D00 6100F6CE        	  1223:     bsr     ym_write1
02:00000D04 103C00A2        	  1224:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000D08 1203            	  1225:     move.b  D3,D1
02:00000D0A 6100F6C4        	  1226:     bsr     ym_write1
02:00000D0E 103C0028        	  1227:     move.b  #$28,D0
02:00000D12 123C00F2        	  1228:     move.b  #$F2,D1
02:00000D16 6000F6B8        	  1229:     bra     ym_write1
                            	  1230: 
                            	  1231: ;==============================================================================
                            	  1232: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1233: ;==============================================================================
                            	  1234: key_off_sq1:
02:00000D1A 103C0028        	  1235:     move.b  #$28,D0
02:00000D1E 123C0000        	  1236:     move.b  #$00,D1
02:00000D22 6000F6AC        	  1237:     bra     ym_write1
                            	  1238: key_off_sq0:
02:00000D26 103C0028        	  1239:     move.b  #$28,D0
02:00000D2A 123C0001        	  1240:     move.b  #$01,D1
02:00000D2E 6000F6A0        	  1241:     bra     ym_write1
                            	  1242: key_off_trg:
02:00000D32 103C0028        	  1243:     move.b  #$28,D0
02:00000D36 123C0002        	  1244:     move.b  #$02,D1
02:00000D3A 6000F694        	  1245:     bra     ym_write1
                            	  1246: 
                            	  1247: ;==============================================================================
                            	  1248: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1249: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1250: ;
                            	  1251: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1252: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1253: ;     PsgDrumTable.
                            	  1254: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1255: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1256: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1257: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1258: ;     noise_decay_tick.
                            	  1259: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1260: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1261: ;==============================================================================
                            	  1262: set_psg_noise:
                            	  1263:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1264:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1265:     ; music drums resume on the next beat.
02:00000D3E 4A3900FF0606    	  1266:     tst.b   ($00FF0606).l
02:00000D44 661A            	  1267:     bne.s   .sfx_owns_psg
02:00000D46 4A01            	  1268:     tst.b   D1
02:00000D48 6618            	  1269:     bne.s   .not_rest
                            	  1270:     ; Rest: silence the PSG noise channel immediately.
02:00000D4A 423900FFE026    	  1271:     clr.b   (m_noise_level).l
02:00000D50 423900FFE027    	  1272:     clr.b   (m_noise_decay).l
02:00000D56 13FC00FF00C00011	  1273:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000D5E 4E75            	  1274:     rts
                            	  1275: .sfx_owns_psg:
02:00000D60 4E75            	  1276:     rts
                            	  1277: .not_rest:
02:00000D62 7000            	  1278:     moveq   #0,D0
02:00000D64 1001            	  1279:     move.b  D1,D0
02:00000D66 E548            	  1280:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000D68 43F900000E9E    	  1281:     lea     (PsgDrumTable).l,A1
02:00000D6E D3C0            	  1282:     adda.l  D0,A1
02:00000D70 1019            	  1283:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1284:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000D72 B03900FFE028    	  1285:     cmp.b   (m_last_psg_nc).l,D0
02:00000D78 670C            	  1286:     beq.s   .nc_same
02:00000D7A 13C000FFE028    	  1287:     move.b  D0,(m_last_psg_nc).l
02:00000D80 13C000C00011    	  1288:     move.b  D0,(PSG_PORT).l
                            	  1289: .nc_same:
02:00000D86 1019            	  1290:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000D88 13C000FFE026    	  1291:     move.b  D0,(m_noise_level).l
02:00000D8E 1019            	  1292:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000D90 13C000FFE027    	  1293:     move.b  D0,(m_noise_decay).l
                            	  1294:     bra     write_psg_noise_vol
                            	  1295: 
                            	  1296: ;==============================================================================
                            	  1297: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1298: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1299: ; Preserves D1.
                            	  1300: ;==============================================================================
                            	  1301: write_psg_noise_vol:
02:00000D96 4A3900FF0606    	  1302:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000D9C 6618            	  1303:     bne.s   .wpnv_skip
02:00000D9E 7000            	  1304:     moveq   #0,D0
02:00000DA0 103900FFE026    	  1305:     move.b  (m_noise_level).l,D0
02:00000DA6 E808            	  1306:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000DA8 0A00000F        	  1307:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000DAC 000000F0        	  1308:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000DB0 13C000C00011    	  1309:     move.b  D0,(PSG_PORT).l
                            	  1310: .wpnv_skip:
02:00000DB6 4E75            	  1311:     rts
                            	  1312: 
                            	  1313: ;==============================================================================
                            	  1314: ; noise_decay_tick — linear envelope decay step.
                            	  1315: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1316: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1317: ; Preserves D1.
                            	  1318: ;==============================================================================
                            	  1319: noise_decay_tick:
02:00000DB8 4A3900FF0606    	  1320:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000DBE 661A            	  1321:     bne.s   .nd_done
02:00000DC0 103900FFE026    	  1322:     move.b  (m_noise_level).l,D0
02:00000DC6 6712            	  1323:     beq.s   .nd_done                        ; already silent
02:00000DC8 903900FFE027    	  1324:     sub.b   (m_noise_decay).l,D0
02:00000DCE 6402            	  1325:     bcc.s   .nd_store                       ; no underflow → new level
02:00000DD0 7000            	  1326:     moveq   #0,D0                           ; underflow → silent
                            	  1327: .nd_store:
02:00000DD2 13C000FFE026    	  1328:     move.b  D0,(m_noise_level).l
02:00000DD8 60BC            	  1329:     bra     write_psg_noise_vol
                            	  1330: .nd_done:
02:00000DDA 4E75            	  1331:     rts
                            	  1332: 
                            	  1333: ;==============================================================================
                            	  1334: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1335: ;==============================================================================
                            	  1336: music_silence:
02:00000DDC 423900FFE000    	  1337:     clr.b   (m_song).l
02:00000DE2 6100FF36        	  1338:     bsr     key_off_sq1
02:00000DE6 6100FF3E        	  1339:     bsr     key_off_sq0
02:00000DEA 6100FF46        	  1340:     bsr     key_off_trg
02:00000DEE 13FC00FF00C00011	  1341:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000DF6 4E75            	  1342:     rts
