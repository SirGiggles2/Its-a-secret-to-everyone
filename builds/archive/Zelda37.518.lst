                            	   314:     ; PATCHED: NOP — audio data requires NES bank mapping not yet implemented.
02:00030046 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:00030048 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0003004C 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0003004E 7000            	   323:     moveq   #0,D0
02:00030050 6100CFCC        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:00030054 700F            	   325:     moveq   #15,D0
02:00030056 6100CFC6        	   326:     jsr     _apu_write_4015  ; APU/IO write
02:0003005A 6618            	   327:     bne  _L_z00_DriveAudio_Paused
                            	   328:     even
                            	   329: _L_z00_DriveAudio_Play:
