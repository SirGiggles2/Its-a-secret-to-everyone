                            	   370:     ;
02:00031444 02000020        	   371:     andi.b #$20,D0
02:00031448 6700009E        	   372:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   373:     ; Determine an index randomly with increasing probability,
                            	   374:     ; from 6 to 1. Start with the following test:
