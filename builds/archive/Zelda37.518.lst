                            	   467:     even
                            	   468: 
                            	   469: ; Twinkle / celesta lead — soft mystical bell, light and bright.
                            	   470: ;   Algorithm 5 (3 carriers driven by op1 modulator), FB 0 keeps timbre
                            	   471: ;   clean and pure (no FB-induced grit).  Op1 MUL 2 with low modulator
                            	   472: ;   level adds just a hint of chime without harsh overtones.  Carriers
                            	   473: ;   are slightly detuned (DT 1, 0, -1) for a gentle chorus shimmer that
                            	   474: ;   reads as "mystical" rather than dry.  Long DL+RR gives notes a
                            	   475: ;   relaxing tail that overlaps into chord-like ringouts.
                            	   476: mp_PATCH_TWINKLE:
02:0000E416 05              	   477:     dc.b    $05                     ; FB/ALG: FB 0, ALG 5
02:0000E417 02              	   478:     dc.b    $02,$11,$01,$51         ; DT/MUL — slot order op1,op3,op2,op4
02:0000E418 11
02:0000E419 01
02:0000E41A 51
02:0000E41B 1F              	   479:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR — instant attack
02:0000E41C 1F
02:0000E41D 1F
02:0000E41E 1F
02:0000E41F 00              	   480:     dc.b    $00,$03,$03,$03         ; AM/D1R — mod sustained, carriers gentle decay
02:0000E420 03
02:0000E421 03
02:0000E422 03
02:0000E423 00              	   481:     dc.b    $00,$00,$00,$00         ; D2R
02:0000E424 00
02:0000E425 00
02:0000E426 00
02:0000E427 48              	   482:     dc.b    $48,$36,$36,$26         ; DL/RR — long shimmery tail
02:0000E428 36
02:0000E429 36
02:0000E42A 26
02:0000E42B 24              	   483:     dc.b    $24,$14,$14,$14         ; TL — mod gentle ($24), carriers bright ($14)
02:0000E42C 14
02:0000E42D 14
02:0000E42E 14
