02:00040766 003C0011        	  3749:     ori     #$11,CCR  ; SEC: set C+X
02:0004076A 122C0004        	  3750:     move.b  ($0004,A4),D1
02:0004076E 0A3C0010        	  3751:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
