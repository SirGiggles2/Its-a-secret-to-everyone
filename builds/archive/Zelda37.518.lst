02:0004081E 12303000        	  3877:     move.b  (A0,D3.W),D1
02:00040822 B001            	  3878:     cmp.b   D1,D0
02:00040824 6510            	  3879:     bcs  _anon_z05_95
02:00040826 41F9000407E8    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0004082C 12303000        	  3881:     move.b  (A0,D3.W),D1
