                            	  1197:     ; Slots 1..3 (color indices 1..3) are written relative to this base.
                            	  1198: .t19_spr_cram_base:
02:00010878 0008            	  1199:     dc.w    $08                 ; sub-pal 0 → PAL0[4]  (CRAM $08..$0E)
02:0001087A 0010            	  1200:     dc.w    $10                 ; sub-pal 1 → PAL0[8]  (CRAM $10..$16)
02:0001087C 0018            	  1201:     dc.w    $18                 ; sub-pal 2 → PAL0[12] (CRAM $18..$1E)
02:0001087E 0028            	  1202:     dc.w    $28                 ; sub-pal 3 → PAL1[4]  (CRAM $28..$2E)
                            	  1203:     endc
