                            	  1717: 
                            	  1718: ;------------------------------------------------------------------------------
                            	  1719: ; _copy_bank_to_window
                            	  1720: ;   D0.w = bank number (0-7)
                            	  1721: ;   Copies bank 0-6 into $FF8000 when cache misses. Bank 7 is exempt.
                            	  1722: ;------------------------------------------------------------------------------
                            	  1723: _copy_bank_to_window:
02:0002CBA4 02400007        	  1724:     andi.w  #$0007,D0
02:0002CBA8 0C400007        	  1725:     cmpi.w  #7,D0
02:0002CBAC 6734            	  1726:     beq.s   .skip
02:0002CBAE B03900FF083F    	  1727:     cmp.b   (_current_window_bank).l,D0
02:0002CBB4 672C            	  1728:     beq.s   .skip
02:0002CBB6 48E740C0        	  1729:     movem.l D1/A0-A1,-(SP)
02:0002CBBA 3200            	  1730:     move.w  D0,D1
02:0002CBBC E549            	  1731:     lsl.w   #2,D1
02:0002CBBE 41F90002CB84    	  1732:     lea     (_bank_rom_bases).l,A0
02:0002CBC4 20701000        	  1733:     movea.l (A0,D1.W),A0
02:0002CBC8 43F900FF8000    	  1734:     lea     (BANK_WINDOW_BASE).l,A1
02:0002CBCE 323C0FFF        	  1735:     move.w  #BANK_WINDOW_SIZE/4-1,D1
                            	  1736: .copy_loop:
02:0002CBD2 22D8            	  1737:     move.l  (A0)+,(A1)+
02:0002CBD4 51C9FFFC        	  1738:     dbra    D1,.copy_loop
02:0002CBD8 13C000FF083F    	  1739:     move.b  D0,(_current_window_bank).l
02:0002CBDE 4CDF0302        	  1740:     movem.l (SP)+,D1/A0-A1
                            	  1741: .skip:
02:0002CBE2 4E75            	  1742:     rts
                            	  1743: 
                            	  1744: ;------------------------------------------------------------------------------
                            	  1745: ; _ensure_bank_window
                            	  1746: ;   Reads MMC1_PRG and ensures $FF8000 currently mirrors that PRG bank.
                            	  1747: ;   Preserves D0 and all address registers used by callers.
                            	  1748: ;------------------------------------------------------------------------------
                            	  1749: _ensure_bank_window:
02:0002CBE4 48E78000        	  1750:     movem.l D0,-(SP)
02:0002CBE8 7000            	  1751:     moveq   #0,D0
02:0002CBEA 103900FF0815    	  1752:     move.b  (MMC1_PRG).l,D0
02:0002CBF0 02400007        	  1753:     andi.w  #$0007,D0
02:0002CBF4 B03900FF083F    	  1754:     cmp.b   (_current_window_bank).l,D0
02:0002CBFA 6702            	  1755:     beq.s   .done
02:0002CBFC 61A6            	  1756:     bsr     _copy_bank_to_window
                            	  1757: .done:
02:0002CBFE 4CDF0001        	  1758:     movem.l (SP)+,D0
02:0002CC02 4E75            	  1759:     rts
