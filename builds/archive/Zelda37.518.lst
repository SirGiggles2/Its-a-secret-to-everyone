02:0003AD2E 670000A8        	  1640:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1641:     ; If is zora, and state >= 2 and < 5, then use frame image 2 or 3
                            	  1642:     ; (front or back), which was stored in ObjDir above.
                            	  1643:     ;
02:0003AD32 7600            	  1644:     moveq   #0,D3
02:0003AD34 41EC034F        	  1645:     lea     ($034F,A4),A0
02:0003AD38 16302000        	  1646:     move.b  (A0,D2.W),D3
02:0003AD3C 0C030011        	  1647:     cmpi.b  #$11,D3
02:0003AD40 6620            	  1648:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:0003AD42 7600            	  1649:     moveq   #0,D3
02:0003AD44 41EC00AC        	  1650:     lea     ($00AC,A4),A0
02:0003AD48 16302000        	  1651:     move.b  (A0,D2.W),D3
02:0003AD4C 0C030002        	  1652:     cmpi.b  #$02,D3
02:0003AD50 6510            	  1653:     bcs  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:0003AD52 0C030005        	  1654:     cmpi.b  #$05,D3
02:0003AD56 640A            	  1655:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:0003AD58 41EC0098        	  1656:     lea     ($0098,A4),A0
02:0003AD5C 10302000        	  1657:     move.b  (A0,D2.W),D0
