                            	  5422: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00041DAE 122C0002        	  5423:     move.b  ($02,A4),D1   ; ptr lo
02:00041DB2 182C0003        	  5424:     move.b  ($03,A4),D4  ; ptr hi
02:00041DB6 024100FF        	  5425:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041DBA E14C            	  5426:     lsl.w   #8,D4
02:00041DBC 8841            	  5427:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041DBE 48C4            	  5428:     ext.l   D4
02:00041DC0 D8BC00FF0000    	  5429:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041DC6 2044            	  5430:     movea.l D4,A0
02:00041DC8 10303000        	  5431:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041DCC 1214            	  5432:     move.b  ($00,A4),D1   ; ptr lo
02:00041DCE 182C0001        	  5433:     move.b  ($01,A4),D4  ; ptr hi
02:00041DD2 024100FF        	  5434:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041DD6 E14C            	  5435:     lsl.w   #8,D4
02:00041DD8 8841            	  5436:     or.w    D1,D4
02:00041DDA 48C4            	  5437:     ext.l   D4
02:00041DDC D8BC00FF0000    	  5438:     add.l   #NES_RAM,D4
02:00041DE2 2044            	  5439:     movea.l D4,A0
02:00041DE4 11803000        	  5440:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:00041DE8 4EB900032C66    	  5441:     jsr     Add1ToInt16At2
02:00041DEE 41F900041C82    	  5442:     lea     (NextDoorTileOffsets).l,A0
02:00041DF4 10302000        	  5443:     move.b  (A0,D2.W),D0
02:00041DF8 4EB900032C62    	  5444:     jsr     AddToInt16At0
                            	  5445:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5446:     ; go 1 more tile down, to start the next column at the right place.
                            	  5447:     ; We have to compensate for the fact that E/W doors are 
                            	  5448:     ; shorter vertically than N/S doors.
02:00041DFE 4A02            	  5449:     cmpi.b  #$00,D2
02:00041E00 6610            	  5450:     bne  _anon_z05_115
02:00041E02 101D            	  5451:     move.b  (A5)+,D0  ; PLA
02:00041E04 1B00            	  5452:     move.b  D0,-(A5)  ; PHA
02:00041E06 0C000002        	  5453:     cmpi.b  #$02,D0
02:00041E0A 6406            	  5454:     bcc  _anon_z05_115
02:00041E0C 4EB900032C5E    	  5455:     jsr     Add1ToInt16At0
