                            	  2480: ;==============================================================================
                            	  2481: ; DMC APU register stubs (Phase D)
                            	  2482: ;
                            	  2483: ; Zelda's SelectDMC routine (transpiled at z_00.asm:_L_z00_DriveSample_*)
                            	  2484: ; writes the APU DMC registers in a fixed order whenever it wants to play
                            	  2485: ; a sample effect:
                            	  2486: ;
                            	  2487: ;     $4010  <- SampleRates[idx-1]   ; rate nibble (low 4 bits)
                            	  2488: ;     $4012  <- SampleAddrs[idx-1]   ; start addr high byte ($C000 + b*64)
                            	  2489: ;     $4013  <- SampleLengths[idx-1] ; length byte (length = b*16 + 1)
                            	  2490: ;     $4015  <- $0F                  ; enable all non-DMC channels
                            	  2491: ;     $4015  <- $1F                  ; OR in bit 4 -> DMC playback
                            	  2492: ;
                            	  2493: ; We shadow $4010 and $4012 on write so that when $4015 arrives with bit 4
                            	  2494: ; set we can recover the intended sample index via DMC_SAMPLE_LOOKUP.
                            	  2495: ;==============================================================================
                            	  2496: _apu_write_4010:
02:0002D006 13C000FFE10C    	  2497:     move.b  D0,(dmc_rate_sel).l
02:0002D00C 4E75            	  2498:     rts
                            	  2499: 
                            	  2500: _apu_write_4012:
02:0002D00E 13C000FFE10D    	  2501:     move.b  D0,(dmc_addr_sel).l
02:0002D014 4E75            	  2502:     rts
                            	  2503: 
                            	  2504: _apu_write_4013:
02:0002D016 13C000FFE10E    	  2505:     move.b  D0,(dmc_len_sel).l
02:0002D01C 4E75            	  2506:     rts
                            	  2507: 
                            	  2508: _apu_write_4015:
02:0002D01E 08000004        	  2509:     btst    #4,D0                       ; DMC enable bit?
02:0002D022 673E            	  2510:     beq.s   .no_dmc                     ; clearing → stop playback
                            	  2511:     ; Look up (addr, rate) in DMC_SAMPLE_LOOKUP.  Walk 7 {addr,rate,idx,0}
                            	  2512:     ; quads; on match, load the 1-based index into D1 and call dmc_trigger.
02:0002D024 48E77080        	  2513:     movem.l D1-D3/A0,-(SP)
02:0002D028 143900FFE10D    	  2514:     move.b  (dmc_addr_sel).l,D2
02:0002D02E 163900FFE10C    	  2515:     move.b  (dmc_rate_sel).l,D3
02:0002D034 41F9000019D0    	  2516:     lea     (DMC_SAMPLE_LOOKUP).l,A0
02:0002D03A 7206            	  2517:     moveq   #DMC_SAMPLE_COUNT-1,D1
                            	  2518: .scan:
02:0002D03C B410            	  2519:     cmp.b   (A0),D2
02:0002D03E 6616            	  2520:     bne.s   .next
02:0002D040 B6280001        	  2521:     cmp.b   1(A0),D3
02:0002D044 6610            	  2522:     bne.s   .next
                            	  2523:     ; Match: 3rd byte of the quad is the 1-based index
02:0002D046 7200            	  2524:     moveq   #0,D1
02:0002D048 12280002        	  2525:     move.b  2(A0),D1
02:0002D04C 1001            	  2526:     move.b  D1,D0                       ; dmc_trigger wants index in D0.b
02:0002D04E 4EB900000650    	  2527:     bsr     dmc_trigger
02:0002D054 6006            	  2528:     bra.s   .done
                            	  2529: .next:
02:0002D056 5888            	  2530:     addq.l  #4,A0
02:0002D058 51C9FFE2        	  2531:     dbra    D1,.scan
                            	  2532:     ; No match — silently ignore (unknown rate/addr combo, not fatal)
                            	  2533: .done:
02:0002D05C 4CDF010E        	  2534:     movem.l (SP)+,D1-D3/A0
02:0002D060 4E75            	  2535:     rts
                            	  2536: .no_dmc:
                            	  2537:     ; Bit 4 clear — if DMC currently playing, stop it.
02:0002D062 4A3900FFE100    	  2538:     tst.b   (dmc_active).l
02:0002D068 6706            	  2539:     beq.s   .no_dmc_done
02:0002D06A 42B900FFE108    	  2540:     clr.l   (dmc_remain).l
                            	  2541: .no_dmc_done:
02:0002D070 4E75            	  2542:     rts
                            	  2543: 
                            	  2544: ;==============================================================================
                            	  2545: ; _indirect_stub — JMP (abs) indirect placeholder.
                            	  2546: ; Called when the transpiler can't resolve an indirect jump target at
                            	  2547: ; translate-time.  Halts via an infinite bra so BizHawk shows PC stuck here.
                            	  2548: ; In T9+ these will be replaced by computed dispatch tables.
                            	  2549: ;==============================================================================
                            	  2550: _indirect_stub:
02:0002D072 60FE            	  2551:     bra.s   _indirect_stub          ; spin — caught as deliberate halt in T9+
                            	  2552: 
                            	  2553: ;==============================================================================
                            	  2554: ; _m68k_tablejump — M68K-native replacement for the NES JSR-trick TableJump.
                            	  2555: ;
                            	  2556: ; On NES, "JSR TableJump" is a JSR-trick: the bytes after the JSR are a
                            	  2557: ; table of 16-bit vectors.  TableJump pops the return address from the 6502
                            	  2558: ; stack to find the table base, then jumps through it using the value in A.
                            	  2559: ;
                            	  2560: ; In M68K, BSR pushes the return address (= table base) onto A7 (M68K stack),
                            	  2561: ; not A5 (our NES stack).  The original TableJump pulled from A5 (zeros),
                            	  2562: ; constructing a bogus NES address and jumping into garbage.
                            	  2563: ;
                            	  2564: ; This replacement correctly pops the M68K return address as the dc.l table
                            	  2565: ; base, indexes by D0.b × 4, and dispatches.
                            	  2566: ;
                            	  2567: ; Calling convention:
                            	  2568: ;   D0.b = mode index
                            	  2569: ;   (A7)  = base address of the dc.l jump table (pushed by BSR)
                            	  2570: ;   Jumps directly to the selected target (does not RTS).
                            	  2571: ;==============================================================================
                            	  2572: _m68k_tablejump:
02:0002D074 205F            	  2573:     movea.l (SP)+,A0        ; pop M68K return address = dc.l table base
02:0002D076 C07C00FF        	  2574:     and.w   #$00FF,D0       ; zero-extend mode byte → word
02:0002D07A E548            	  2575:     lsl.w   #2,D0           ; D0.w = index × 4  (each dc.l = 4 bytes)
02:0002D07C 20700000        	  2576:     movea.l (A0,D0.W),A0   ; load 32-bit target address from table
02:0002D080 4ED0            	  2577:     jmp     (A0)            ; dispatch (no return)
                            	  2578: 
                            	  2579: ;==============================================================================
                            	  2580: ; _clear_nametable_fast — Fast replacement for ClearNameTable.
                            	  2581: ;
                            	  2582: ; Fills Plane A with a tile word directly via VDP_DATA (bypassing _ppu_write_7)
                            	  2583: ; and clears NT_CACHE.  V64 plane: NT0 ($20) → rows 0-29, NT1 ($28) → rows 30-59.
                            	  2584: ;
                            	  2585: ; Input:
                            	  2586: ;   D0.b = hi byte of NES PPU address ($20 = nametable 0, $28 = nametable 1)
                            	  2587: ;   D2.b = tile index to fill with
                            	  2588: ;   D3.b = attribute byte (always 0 for Zelda clear; palette 0 used)
                            	  2589: ;
                            	  2590: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2591: ; Updates PPU_VADDR to the post-clear address (matching original behavior).
                            	  2592: ;==============================================================================
                            	  2593:     even
                            	  2594: _clear_nametable_fast:
02:0002D082 48E7F880        	  2595:     movem.l D0-D4/A0,-(SP)
                            	  2596: 
                            	  2597:     ; Save NT selection before D0 is clobbered
02:0002D086 1800            	  2598:     move.b  D0,D4                   ; D4.b = NT hi byte ($20 or $28)
                            	  2599: 
                            	  2600:     ; Compute the end PPU_VADDR: start + 1024 tiles + 64 attributes = +$0440
02:0002D088 024000FF        	  2601:     andi.w  #$00FF,D0
02:0002D08C E148            	  2602:     lsl.w   #8,D0                   ; D0.w = PPU base ($2000 or $2800)
02:0002D08E 06400440        	  2603:     addi.w  #$0440,D0
02:0002D092 33C000FF0802    	  2604:     move.w  D0,(PPU_VADDR).l        ; set PPU_VADDR to expected end value
                            	  2605: 
                            	  2606:     ; Build tile word from the current BG pattern-table selection
02:0002D098 7000            	  2607:     moveq   #0,D0
02:0002D09A 1002            	  2608:     move.b  D2,D0                   ; D0.w = raw tile index
02:0002D09C 4EB900010A86    	  2609:     bsr     _compose_bg_tile_word
02:0002D0A2 3200            	  2610:     move.w  D0,D1                   ; D1.w = tile word to write
                            	  2611: 
                            	  2612:     ; Determine VRAM start address based on NT selection
02:0002D0A4 0C040028        	  2613:     cmpi.b  #$28,D4
02:0002D0A8 672A            	  2614:     beq.s   .cnf_nt1
                            	  2615: 
                            	  2616:     ; ---- NT0: Fill Plane A rows 0-29 starting at $C000 ----
                            	  2617:     ; Phase 2c: also fill Window nametable rows 0-7 (256 tiles = 512 bytes).
                            	  2618:     ; Without this, NT0-clear requests leave stale HUD tiles in Window
                            	  2619:     ; after a mode transition that clears NT0.
02:0002D0AA 23FC7000000200C0	  2620:     move.l  #$70000002,(VDP_CTRL).l ; VRAM write at $B000 (Window)
02:0002D0B2 0004
02:0002D0B4 363C00FF        	  2621:     move.w  #255,D3                 ; 32 cols * 8 rows - 1
                            	  2622: .cnf_window_fill:
02:0002D0B8 33C100C00000    	  2623:     move.w  D1,(VDP_DATA).l
02:0002D0BE 51CBFFF8        	  2624:     dbf     D3,.cnf_window_fill
                            	  2625: 
02:0002D0C2 23FC4000000300C0	  2626:     move.l  #$40000003,(VDP_CTRL).l ; VRAM write at $C000
02:0002D0CA 0004
                            	  2627:     ; Clear NT_CACHE offsets 0-959 (NT0)
02:0002D0CC 41F900FF0840    	  2628:     lea     (NT_CACHE_BASE).l,A0
02:0002D0D2 6010            	  2629:     bra.s   .cnf_fill
                            	  2630: 
                            	  2631: .cnf_nt1:
                            	  2632:     ; ---- NT1: Fill Plane A rows 30-63 starting at $CF00 ----
                            	  2633:     ; 34 rows = 30 NT1 rows + 4 gap rows (prevents garbage when scroll wraps).
                            	  2634:     ; $CF00 = $C000 + 30*$80.  VDP command: ($CF00 & $3FFF)<<16 | $40000003
                            	  2635:     ; NT1 doesn't touch HUD range — skip Window fill.
02:0002D0D4 23FC4F00000300C0	  2636:     move.l  #$4F000003,(VDP_CTRL).l ; VRAM write at $CF00
02:0002D0DC 0004
                            	  2637:     ; Clear NT_CACHE offsets 960-1919 (NT1)
02:0002D0DE 41F900FF0C00    	  2638:     lea     (NT_CACHE_BASE+960).l,A0
                            	  2639: 
                            	  2640: .cnf_fill:
                            	  2641:     ; Write tiles to Plane A rows.  Plane A is 64 tiles wide,
                            	  2642:     ; so after each 32-tile NES row we must skip 32 unused tiles.
                            	  2643:     ; NT0: 30 rows (0-29).  NT1: 34 rows (30-63, includes 4 gap rows).
02:0002D0E4 0C040028        	  2644:     cmpi.b  #$28,D4
02:0002D0E8 6604            	  2645:     bne.s   .cnf_nt0_count
02:0002D0EA 7621            	  2646:     moveq   #34-1,D3                ; NT1: 34 rows (fills gap rows 60-63)
02:0002D0EC 6002            	  2647:     bra.s   .cnf_row
                            	  2648: .cnf_nt0_count:
02:0002D0EE 761D            	  2649:     moveq   #30-1,D3                ; NT0: 30 rows
                            	  2650: .cnf_row:
02:0002D0F0 781F            	  2651:     moveq   #32-1,D4                ; 32 cols per row
                            	  2652: .cnf_col:
02:0002D0F2 33C100C00000    	  2653:     move.w  D1,(VDP_DATA).l
02:0002D0F8 51CCFFF8        	  2654:     dbf     D4,.cnf_col
                            	  2655: 
                            	  2656:     ; Skip 32 unused tile slots (64 bytes) in Plane A row.
02:0002D0FC 781F            	  2657:     moveq   #32-1,D4
                            	  2658: .cnf_skip:
02:0002D0FE 33C100C00000    	  2659:     move.w  D1,(VDP_DATA).l         ; write same tile to unused slots (harmless)
02:0002D104 51CCFFF8        	  2660:     dbf     D4,.cnf_skip
                            	  2661: 
02:0002D108 51CBFFE6        	  2662:     dbf     D3,.cnf_row
                            	  2663: 
                            	  2664:     ; ---- Clear NT_CACHE (960 bytes for the selected NT) ----
02:0002D10C 363C03BF        	  2665:     move.w  #960-1,D3
02:0002D110 1001            	  2666:     move.b  D1,D0                   ; fill byte = tile index
                            	  2667: .cnf_cache:
02:0002D112 10C0            	  2668:     move.b  D0,(A0)+
02:0002D114 51CBFFFC        	  2669:     dbf     D3,.cnf_cache
                            	  2670: 
                            	  2671:     ; Clear matching transfer-interpreter palette shadow for this NT.
02:0002D118 0C040028        	  2672:     cmpi.b  #$28,D4
02:0002D11C 6708            	  2673:     beq.s   .cnf_attr_nt1
02:0002D11E 41F900FF1400    	  2674:     lea     (NT_ATTR_CACHE_BASE).l,A0
02:0002D124 6006            	  2675:     bra.s   .cnf_attr_fill
                            	  2676: .cnf_attr_nt1:
02:0002D126 41F900FF17C0    	  2677:     lea     (NT_ATTR_CACHE_BASE+960).l,A0
                            	  2678: .cnf_attr_fill:
02:0002D12C 363C03BF        	  2679:     move.w  #960-1,D3
02:0002D130 4200            	  2680:     clr.b   D0
                            	  2681: .cnf_attr_loop:
02:0002D132 10C0            	  2682:     move.b  D0,(A0)+
02:0002D134 51CBFFFC        	  2683:     dbf     D3,.cnf_attr_loop
                            	  2684: 
                            	  2685: .cnf_done:
02:0002D138 4CDF011F        	  2686:     movem.l (SP)+,D0-D4/A0
02:0002D13C 4E75            	  2687:     rts
                            	  2688: 
                            	  2689: ;==============================================================================
                            	  2690: ; _transfer_chr_block_fast — Bulk 2BPP→4BPP tile transfer to VDP VRAM.
                            	  2691: ;
                            	  2692: ; Bypasses _ppu_write_7 entirely.  Reads NES 2BPP tile data from a ROM source
                            	  2693: ; address, converts each 16-byte tile to 32-byte Genesis 4BPP, and writes
                            	  2694: ; directly to VDP VRAM.  Processes full tiles (16 bytes each).
                            	  2695: ;
                            	  2696: ; Input:
                            	  2697: ;   A0     = ROM source address (32-bit, points to NES 2BPP tile data)
                            	  2698: ;   D1.w   = NES PPU destination address (CHR range $0000–$1FFF)
                            	  2699: ;   D2.l   = byte count (must be multiple of 16)
                            	  2700: ;
                            	  2701: ; Output:
                            	  2702: ;   PPU_VADDR updated to D1 + D2 (post-transfer address)
                            	  2703: ;
                            	  2704: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2705: ;==============================================================================
                            	  2706:     even
                            	  2707: _transfer_chr_block_fast:
                            	  2708:     ifne CHR_EXPANSION_ENABLED
                            	  2709:     ; If destination is sprite half ($0000-$0FFF), stage each 16-byte tile
                            	  2710:     ; through CHR_TILE_BUF and call _chr_upload_sprite_4x (emits 4 biased
                            	  2711:     ; copies).  BG half ($1000-$1FFF) takes the legacy 1x fast path below.
02:0002D13E 3A01            	  2712:     move.w  D1,D5
02:0002D140 02451000        	  2713:     andi.w  #$1000,D5
02:0002D144 663A            	  2714:     bne.s   .tcbf_legacy_entry
02:0002D146 48E7FFE0        	  2715:     movem.l D0-D7/A0-A2,-(SP)
                            	  2716: .tcbf_4x_loop:
02:0002D14A 4A82            	  2717:     tst.l   D2
02:0002D14C 6F26            	  2718:     ble.s   .tcbf_4x_done
02:0002D14E 43F900FF0820    	  2719:     lea     (CHR_TILE_BUF).l,A1
02:0002D154 22D8            	  2720:     move.l  (A0)+,(A1)+
02:0002D156 22D8            	  2721:     move.l  (A0)+,(A1)+
02:0002D158 22D8            	  2722:     move.l  (A0)+,(A1)+
02:0002D15A 22D8            	  2723:     move.l  (A0)+,(A1)+
02:0002D15C 33C100FF0832    	  2724:     move.w  D1,(CHR_BUF_VADDR).l
02:0002D162 4EB900010944    	  2725:     bsr     _chr_upload_sprite_4x
02:0002D168 06410010        	  2726:     addi.w  #16,D1
02:0002D16C 048200000010    	  2727:     subi.l  #16,D2
02:0002D172 60D6            	  2728:     bra.s   .tcbf_4x_loop
                            	  2729: .tcbf_4x_done:
02:0002D174 33C100FF0802    	  2730:     move.w  D1,(PPU_VADDR).l
02:0002D17A 4CDF07FF        	  2731:     movem.l (SP)+,D0-D7/A0-A2
02:0002D17E 4E75            	  2732:     rts
                            	  2733: .tcbf_legacy_entry:
                            	  2734:     endc
02:0002D180 48E7FEE0        	  2735:     movem.l D0-D6/A0-A2,-(SP)
                            	  2736: 
                            	  2737:     ; Save byte count for PPU_VADDR update at end
02:0002D184 2002            	  2738:     move.l  D2,D0                   ; D0.l = total byte count
                            	  2739: 
                            	  2740:     ; A2 = LUT base (kept across all tiles)
02:0002D186 45F90002D270    	  2741:     lea     (.fast_expand_lut).l,A2
                            	  2742: 
                            	  2743:     ; A0 = ROM source (already set by caller)
                            	  2744:     ; D1.w = NES PPU dest address
                            	  2745: 
                            	  2746: .ftcb_tile:
02:0002D18C 4A82            	  2747:     tst.l   D2
02:0002D18E 6F0000D4        	  2748:     ble     .ftcb_done
                            	  2749: 
02:0002D192 0839000500FF0804	  2750:     btst    #5,(PPU_CTRL).l
02:0002D19A 672C            	  2751:     beq.s   .ftcb_no_stage_hi_sprite
02:0002D19C 0C411F20        	  2752:     cmpi.w  #$1F20,D1
02:0002D1A0 6526            	  2753:     blo.s   .ftcb_no_stage_hi_sprite
02:0002D1A2 0C411F40        	  2754:     cmpi.w  #$1F40,D1
02:0002D1A6 6420            	  2755:     bhs.s   .ftcb_no_stage_hi_sprite
02:0002D1A8 43F900FF0820    	  2756:     lea     (CHR_TILE_BUF).l,A1
02:0002D1AE 2290            	  2757:     move.l  0(A0),(A1)
