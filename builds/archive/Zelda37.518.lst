02:00049E26 6606            	  3688:     bne  _L_z07_WieldFlute_Normal
02:00049E28 101D            	  3689:     move.b  (A5)+,D0  ; PLA
02:00049E2A 662A            	  3690:     bne  _L_z07_WieldFlute_SummonWhirlwind
02:00049E2C 6704            	  3691:     beq  _L_z07_WieldFlute_RevealSecret
                            	  3692:     even
                            	  3693: _L_z07_WieldFlute_Normal:
                            	  3694:     ; For other rooms in the list:
                            	  3695:     ; In Q1, go summon the whirlwind.
                            	  3696:     ; In Q2, continue to reveal the secret.
                            	  3697:     ;
