                            	  1649: _L_z05_InitMode_EnterRoom_Method2:
                            	  1650:     ; Enter method 2.
                            	  1651:     ; Room to room.
                            	  1652:     ;
                            	  1653:     ; Get the direction that the player is entering from.
                            	  1654:     ;
02:0003F83C 102C0098        	  1655:     move.b  ($0098,A4),D0
02:0003F840 19400053        	  1656:     move.b  D0,($0053,A4)
02:0003F844 4EB900032BDE    	  1657:     jsr     GetOppositeDir
                            	  1658:     ; If the player is entering from a door that was opened, then
                            	  1659:     ; set the "close" door command.
                            	  1660:     ;
02:0003F84A 122C00EE        	  1661:     move.b  ($00EE,A4),D1
02:0003F84E C001            	  1662:     and.b  D1,D0
02:0003F850 19400055        	  1663:     move.b  D0,($0055,A4)
02:0003F854 6706            	  1664:     beq  _anon_z05_43
02:0003F856 7002            	  1665:     moveq   #2,D0
02:0003F858 19400054        	  1666:     move.b  D0,($0054,A4)
                            	  1667: _anon_z05_43:
                            	  1668:     ; If in OW, go reset Link's relative position, and work on objects.
