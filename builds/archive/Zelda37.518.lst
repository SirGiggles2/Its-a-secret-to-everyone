02:0003145E 123C002B        	   388:     move.b  #$2B,D1
02:00031462 0A3C0010        	   389:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031466 9101            	   390:     subx.b  D1,D0   ; SBC #$2B
02:00031468 0A3C0010        	   391:     eori    #$10,CCR  ; restore X = 6502 C
02:0003146C 5303            	   392:     subq.b  #1,D3
02:0003146E 66E2            	   393:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   394:     even
