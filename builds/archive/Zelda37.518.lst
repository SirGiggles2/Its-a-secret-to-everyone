                            	  2337:     ; write (low address + 1).
                            	  2338:     ;
02:000493D4 102C0001        	  2339:     move.b  ($0001,A4),D0
02:000493D8 41EC0303        	  2340:     lea     ($0303,A4),A0
02:000493DC 11802000        	  2341:     move.b  D0,(A0,D2.W)
02:000493E0 41EC0308        	  2342:     lea     ($0308,A4),A0
02:000493E4 11802000        	  2343:     move.b  D0,(A0,D2.W)
02:000493E8 41EC0308        	  2344:     lea     ($0308,A4),A0
02:000493EC 52302000        	  2345:     addq.b  #1,(A0,D2.W)
