02:0003B3EE 5202            	  2631:     addq.b  #1,D2
02:0003B3F0 0C02000A        	  2632:     cmpi.b  #$0A,D2
02:0003B3F4 6600FF32        	  2633:     bne  _L_z04_PondFairy_MoveHearts_LoopHeart
02:0003B3F8 0A3C0001        	  2634:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B3FC 4E75            	  2635:     rts
