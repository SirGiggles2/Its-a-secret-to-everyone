02:0004AAAC 6602            	  5640:     bne.s  __far_z_07_0083
02:0004AAAE 6014            	  5641:     jmp  CalcBoomerangFrame
                            	  5642: __far_z_07_0083:
02:0004AAB0 7003            	  5643:     moveq   #3,D0
02:0004AAB2 41EC03D0        	  5644:     lea     ($03D0,A4),A0
02:0004AAB6 11802000        	  5645:     move.b  D0,(A0,D2.W)
02:0004AABA 7020            	  5646:     moveq   #32,D0
02:0004AABC 41EC00AC        	  5647:     lea     ($00AC,A4),A0
02:0004AAC0 11802000        	  5648:     move.b  D0,(A0,D2.W)
                            	  5649:     even
                            	  5650: CalcBoomerangFrame:
                            	  5651:     ; The minor state (low 3 bits of state) is used to
                            	  5652:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5653:     ;
                            	  5654:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5655:     ; In other words, don't offset the coordinate below.
                            	  5656:     ;
02:0004AAC4 7000            	  5657:     moveq   #0,D0
02:0004AAC6 1880            	  5658:     move.b  D0,($0000,A4)
02:0004AAC8 41EC00AC        	  5659:     lea     ($00AC,A4),A0
02:0004AACC 10302000        	  5660:     move.b  (A0,D2.W),D0
02:0004AAD0 0200000F        	  5661:     andi.b #$0F,D0
02:0004AAD4 7600            	  5662:     moveq   #0,D3
02:0004AAD6 1600            	  5663:     move.b  D0,D3
02:0004AAD8 7000            	  5664:     moveq   #0,D0
02:0004AADA 19400001        	  5665:     move.b  D0,($0001,A4)
02:0004AADE 41F90004A6CC    	  5666:     lea     (BoomerangFrameCycle).l,A0
02:0004AAE4 10303000        	  5667:     move.b  (A0,D3.W),D0
02:0004AAE8 1940000C        	  5668:     move.b  D0,($000C,A4)
                            	  5669:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5670:     ;
02:0004AAEC 1003            	  5671:     move.b  D3,D0
02:0004AAEE 41F90004A6D6    	  5672:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004AAF4 10303000        	  5673:     move.b  (A0,D3.W),D0
02:0004AAF8 19400004        	  5674:     move.b  D0,($0004,A4)
                            	  5675:     ; TODO: ?
                            	  5676:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5677:     ; Else add the item value of the magic boomerang.
                            	  5678:     ;
                            	  5679:     ; But none of the values in the base sprite attributes array is 8.
                            	  5680:     ;
                            	  5681:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5682:     ; the inventory will always be added to the base sprite attribute.
                            	  5683:     ;
                            	  5684:     ; So, palette row 4 or 5 will be chosen.
                            	  5685:     ;
02:0004AAFC 7600            	  5686:     moveq   #0,D3
02:0004AAFE 0C000008        	  5687:     cmpi.b  #$08,D0
02:0004AB02 6706            	  5688:     beq  _anon_z07_31
02:0004AB04 7600            	  5689:     moveq   #0,D3
02:0004AB06 162C0675        	  5690:     move.b  ($0675,A4),D3
                            	  5691: _anon_z07_31:
02:0004AB0A 1003            	  5692:     move.b  D3,D0
02:0004AB0C 023C00EE        	  5693:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AB10 122C0004        	  5694:     move.b  ($0004,A4),D1
