                            	   808: _L_z01_TransferDemoPatterns_LoopBlock:
                            	   809:     ; Loop over each block.
                            	   810:     ;
02:00031760 102C051D        	   811:     move.b  ($051D,A4),D0
02:00031764 E308            	   812:     lsl.b  #1,D0   ; ASL A
