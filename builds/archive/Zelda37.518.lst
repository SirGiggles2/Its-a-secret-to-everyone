                            	  5564: __far_z_05_0076:
                            	  5565:     ; Turn the door command into the desired open or closed state
                            	  5566:     ; to store in [08].
                            	  5567:     ;
                            	  5568:     ; cmd:  7 6 3 2 
                            	  5569:     ; [08]: 2 0 0 0
                            	  5570:     ;
                            	  5571:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5572:     ; commands intended to be used.
                            	  5573:     ;
                            	  5574:     ; 3 is the end state of 2: close
                            	  5575:     ; 7 is the end state of 6: open
                            	  5576:     ;
02:00041EBE 02000007        	  5577:     andi.b #$07,D0
02:00041EC2 7601            	  5578:     moveq   #1,D3
02:00041EC4 19430002        	  5579:     move.b  D3,($0002,A4)
02:00041EC8 122C0002        	  5580:     move.b  ($0002,A4),D1
02:00041ECC C200            	  5581:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00041ECE 6702            	  5582:     beq  _anon_z05_118
02:00041ED0 E208            	  5583:     lsr.b  #1,D0   ; LSR A
                            	  5584: _anon_z05_118:
02:00041ED2 0C000002        	  5585:     cmpi.b  #$02,D0
02:00041ED6 6606            	  5586:     bne  _anon_z05_119
                            	  5587:     ; Command 2 sets Link's timer to $30.
                            	  5588:     ;
02:00041ED8 7630            	  5589:     moveq   #48,D3
02:00041EDA 19430028        	  5590:     move.b  D3,($0028,A4)
                            	  5591: _anon_z05_119:
02:00041EDE 02000003        	  5592:     andi.b #$03,D0
02:00041EE2 003C0011        	  5593:     ori     #$11,CCR  ; SEC: set C+X
02:00041EE6 123C0001        	  5594:     move.b  #$01,D1
02:00041EEA 0A3C0010        	  5595:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041EEE 9101            	  5596:     subx.b  D1,D0   ; SBC #$01
02:00041EF0 0A3C0010        	  5597:     eori    #$10,CCR  ; restore X = 6502 C
02:00041EF4 02000002        	  5598:     andi.b #$02,D0
02:00041EF8 19400008        	  5599:     move.b  D0,($0008,A4)
                            	  5600:     ; The command to close a key door or bombable wall does not
                            	  5601:     ; do anything.
                            	  5602:     ;
02:00041EFC 102C0054        	  5603:     move.b  ($0054,A4),D0
02:00041F00 0C000005        	  5604:     cmpi.b  #$05,D0
02:00041F04 6416            	  5605:     bcc  _anon_z05_120
02:00041F06 102C0055        	  5606:     move.b  ($0055,A4),D0
02:00041F0A 19400002        	  5607:     move.b  D0,($0002,A4)
02:00041F0E 6100FAEC        	  5608:     jsr     FindDoorAttrByDoorBit
02:00041F12 0C000007        	  5609:     cmpi.b  #$07,D0
02:00041F16 6704            	  5610:     beq  _anon_z05_120
02:00041F18 6000009C        	  5611:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  5612: 
                            	  5613: _anon_z05_120:
                            	  5614:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5615:     ;
                            	  5616:     ; Shutters and the commands to open a door always change
                            	  5617:     ; tiles.
                            	  5618:     ;
02:00041F1C 61000130        	  5619:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5620:     even
                            	  5621: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5622:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5623:     ; We need to remember how many tiles need to be copied
                            	  5624:     ; in each transfer record.
                            	  5625:     ;
02:00041F20 102C0006        	  5626:     move.b  ($0006,A4),D0
02:00041F24 19400004        	  5627:     move.b  D0,($0004,A4)
                            	  5628:     ; Write the transfer record header for the door.
                            	  5629:     ;
                            	  5630:     ;
                            	  5631:     ; VRAM address high byte of door
02:00041F28 1014            	  5632:     move.b  ($0000,A4),D0
02:00041F2A 41EC0302        	  5633:     lea     ($0302,A4),A0
02:00041F2E 11802000        	  5634:     move.b  D0,(A0,D2.W)
02:00041F32 5202            	  5635:     addq.b  #1,D2
02:00041F34 102C0001        	  5636:     move.b  ($0001,A4),D0
02:00041F38 41EC0302        	  5637:     lea     ($0302,A4),A0
02:00041F3C 11802000        	  5638:     move.b  D0,(A0,D2.W)
02:00041F40 5202            	  5639:     addq.b  #1,D2
02:00041F42 102C0006        	  5640:     move.b  ($0006,A4),D0
02:00041F46 41EC0302        	  5641:     lea     ($0302,A4),A0
02:00041F4A 11802000        	  5642:     move.b  D0,(A0,D2.W)
02:00041F4E 5202            	  5643:     addq.b  #1,D2
                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:00041F50 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:00041F54 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:00041F56 7020            	  5652:     moveq   #32,D0
02:00041F58 122C0001        	  5653:     move.b  ($0001,A4),D1
02:00041F5C 8001            	  5654:     or.b  D1,D0
02:00041F5E 19400001        	  5655:     move.b  D0,($0001,A4)
                            	  5656:     ; Bottom of the loop.
                            	  5657:     ; Loop again to write the second transfer record for the
                            	  5658:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5659:     ;
02:00041F62 532C0005        	  5660:     subq.b  #1,($0005,A4)
02:00041F66 66B8            	  5661:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5662:     ; Write the end marker, and update buffer length.
                            	  5663:     ;
02:00041F68 103C00FF        	  5664:     move.b  #$FF,D0
02:00041F6C 41EC0302        	  5665:     lea     ($0302,A4),A0
02:00041F70 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:00041F74 1002            	  5667:     move.b  D2,D0
02:00041F76 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:00041F7A 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:00041F7E 102C0054        	  5678:     move.b  ($0054,A4),D0
02:00041F82 02000003        	  5679:     andi.b #$03,D0
02:00041F86 6708            	  5680:     beq  _anon_z05_122
02:00041F88 7008            	  5681:     moveq   #8,D0
02:00041F8A 19400027        	  5682:     move.b  D0,($0027,A4)
02:00041F8E 4E75            	  5683:     rts
                            	  5684: 
                            	  5685: _anon_z05_122:
                            	  5686:     ; If the door command = 4 after incrementing it, then
                            	  5687:     ; it was 3 (close door). So:
                            	  5688:     ; 1. reset this door's flag
                            	  5689:     ; 2. remove it from the opened door mask
                            	  5690:     ; 3. reset the door command
                            	  5691:     ; 4. go lay out doors in the play area map
                            	  5692:     ;
02:00041F90 102C0054        	  5693:     move.b  ($0054,A4),D0
02:00041F94 0C000004        	  5694:     cmpi.b  #$04,D0
02:00041F98 6626            	  5695:     bne  _anon_z05_123
02:00041F9A 7400            	  5696:     moveq   #0,D2
02:00041F9C 142C0009        	  5697:     move.b  ($0009,A4),D2
02:00041FA0 6100DCE6        	  5698:     jsr     ResetDoorFlag
02:00041FA4 102C0055        	  5699:     move.b  ($0055,A4),D0
02:00041FA8 0A00000F        	  5700:     eori.b #$0F,D0
02:00041FAC 122C00EE        	  5701:     move.b  ($00EE,A4),D1
02:00041FB0 C001            	  5702:     and.b  D1,D0
                            	  5703:     even
                            	  5704: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00041FB2 194000EE        	  5705:     move.b  D0,($00EE,A4)
                            	  5706:     even
                            	  5707: L_ResetDoorCmdAndLayOutDoors:
02:00041FB6 7000            	  5708:     moveq   #0,D0
02:00041FB8 19400054        	  5709:     move.b  D0,($0054,A4)
02:00041FBC 6000FCD4        	  5710:     jmp     LayOutDoors
                            	  5711: 
                            	  5712: _anon_z05_123:
                            	  5713:     ; Door command <> 4.
                            	  5714:     ; It must be 8, which means it was 7: open door.
                            	  5715:     ;
                            	  5716:     ; If the door is a shutter (7), then go add the door to the
                            	  5717:     ; opened door mask, reset door command, and lay out doors.
                            	  5718:     ;
02:00041FC0 102C0055        	  5719:     move.b  ($0055,A4),D0
02:00041FC4 19400002        	  5720:     move.b  D0,($0002,A4)
02:00041FC8 6100FA32        	  5721:     jsr     FindDoorAttrByDoorBit
02:00041FCC 0C000007        	  5722:     cmpi.b  #$07,D0
02:00041FD0 676E            	  5723:     beq  _anon_z05_124
                            	  5724:     ; Else the door is not a shutter.
                            	  5725:     ;
                            	  5726:     ;
                            	  5727:     ; [09] door direction index
02:00041FD2 7400            	  5728:     moveq   #0,D2
02:00041FD4 142C0009        	  5729:     move.b  ($0009,A4),D2
02:00041FD8 6100DCA8        	  5730:     jsr     SetDoorFlag
                            	  5731:     ; Get the next room's ID.
                            	  5732:     ;
02:00041FDC 1003            	  5733:     move.b  D3,D0
02:00041FDE 023C00EE        	  5734:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041FE2 41F900041E9E    	  5735:     lea     (DoorNextRoomIdOffsets).l,A0
02:00041FE8 12302000        	  5736:     move.b  (A0,D2.W),D1
02:00041FEC D101            	  5737:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00041FEE 7600            	  5738:     moveq   #0,D3
02:00041FF0 1600            	  5739:     move.b  D0,D3
                            	  5740:     ; Flip the door direction index.
                            	  5741:     ;
02:00041FF2 1002            	  5742:     move.b  D2,D0
02:00041FF4 0A000001        	  5743:     eori.b #$01,D0
02:00041FF8 7400            	  5744:     moveq   #0,D2
02:00041FFA 1400            	  5745:     move.b  D0,D2
                            	  5746:     ; Set the door flag for the opposite door in the next room.
                            	  5747:     ;
02:00041FFC 1214            	  5748:     move.b  ($00,A4),D1   ; ptr lo
02:00041FFE 182C0001        	  5749:     move.b  ($01,A4),D4  ; ptr hi
02:00042002 024100FF        	  5750:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042006 E14C            	  5751:     lsl.w   #8,D4
02:00042008 8841            	  5752:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004200A 48C4            	  5753:     ext.l   D4
02:0004200C D8BC00FF0000    	  5754:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042012 2044            	  5755:     movea.l D4,A0
02:00042014 10303000        	  5756:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042018 41F9000490E8    	  5757:     lea     (LevelMasks).l,A0
02:0004201E 12302000        	  5758:     move.b  (A0,D2.W),D1
02:00042022 8001            	  5759:     or.b  D1,D0
02:00042024 1214            	  5760:     move.b  ($00,A4),D1   ; ptr lo
02:00042026 182C0001        	  5761:     move.b  ($01,A4),D4  ; ptr hi
02:0004202A 024100FF        	  5762:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004202E E14C            	  5763:     lsl.w   #8,D4
02:00042030 8841            	  5764:     or.w    D1,D4
02:00042032 48C4            	  5765:     ext.l   D4
02:00042034 D8BC00FF0000    	  5766:     add.l   #NES_RAM,D4
02:0004203A 2044            	  5767:     movea.l D4,A0
02:0004203C 11803000        	  5768:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5769: _anon_z05_124:
                            	  5770:     ; Add the door to the opened door mask, reset door command,
                            	  5771:     ; and lay out doors.
                            	  5772:     ;
02:00042040 102C0055        	  5773:     move.b  ($0055,A4),D0
02:00042044 122C00EE        	  5774:     move.b  ($00EE,A4),D1
02:00042048 8001            	  5775:     or.b  D1,D0
02:0004204A 6000FF66        	  5776:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:0004204E 102C0055        	  5803:     move.b  ($0055,A4),D0
02:00042052 19400002        	  5804:     move.b  D0,($0002,A4)
02:00042056 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:0004205A 0C000005        	  5806:     cmpi.b  #$05,D0
02:0004205E 650C            	  5807:     bcs  _anon_z05_125
02:00042060 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:00042062 7004            	  5809:     moveq   #4,D0
02:00042064 4EB900032B38    	  5810:     jsr     PlaySample
02:0004206A 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:0004206C 0C000004        	  5818:     cmpi.b  #$04,D0
02:00042070 6602            	  5819:     bne  _anon_z05_126
02:00042072 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:00042074 0C000001        	  5822:     cmpi.b  #$01,D0
02:00042078 6602            	  5823:     bne  _anon_z05_127
02:0004207A 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:0004207C 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:00042080 123C0003        	  5829:     move.b  #$03,D1
02:00042084 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042088 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:0004208A 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:0004208E 7600            	  5833:     moveq   #0,D3
02:00042090 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:00042092 102C0008        	  5841:     move.b  ($0008,A4),D0
02:00042096 6708            	  5842:     beq  _anon_z05_128
02:00042098 0C030005        	  5843:     cmpi.b  #$05,D3
02:0004209C 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0004209E 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:000420A0 0C030003        	  5847:     cmpi.b  #$03,D3
02:000420A4 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000420A6 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:000420A8 7003            	  5857:     moveq   #3,D0
02:000420AA 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:000420AE 122C0003        	  5859:     move.b  ($0003,A4),D1
02:000420B2 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000420B6 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:000420B8 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:000420BC 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:000420C0 41F900041E96    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:000420C6 10302000        	  5870:     move.b  (A0,D2.W),D0
02:000420CA 1880            	  5871:     move.b  D0,($0000,A4)
02:000420CC 41F900041E9A    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:000420D2 10302000        	  5873:     move.b  (A0,D2.W),D0
02:000420D6 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:000420DA 19420009        	  5878:     move.b  D2,($0009,A4)
02:000420DE 7400            	  5879:     moveq   #0,D2
02:000420E0 142C0301        	  5880:     move.b  ($0301,A4),D2
                            	  5881:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5882:     ;
02:000420E4 7000            	  5883:     moveq   #0,D0
02:000420E6 19400007        	  5884:     move.b  D0,($0007,A4)
02:000420EA 7002            	  5885:     moveq   #2,D0
02:000420EC 19400006        	  5886:     move.b  D0,($0006,A4)
02:000420F0 19400005        	  5887:     move.b  D0,($0005,A4)
02:000420F4 0A3C0001        	  5888:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000420F8 4E75            	  5889:     rts
                            	  5890: 
                            	  5891:     even
                            	  5892: ColumnDirectoryUW:
02:000420FA 000418D6        	  5893:     dc.l    ColumnHeapUW0
02:000420FE 000418E6        	  5894:     dc.l    ColumnHeapUW1
02:00042102 00041904        	  5895:     dc.l    ColumnHeapUW2
02:00042106 00041916        	  5896:     dc.l    ColumnHeapUW3
02:0004210A 00041928        	  5897:     dc.l    ColumnHeapUW4
02:0004210E 00041940        	  5898:     dc.l    ColumnHeapUW5
02:00042112 00041958        	  5899:     dc.l    ColumnHeapUW6
02:00042116 0004196A        	  5900:     dc.l    ColumnHeapUW7
02:0004211A 0004197C        	  5901:     dc.l    ColumnHeapUW8
02:0004211E 00041996        	  5902:     dc.l    ColumnHeapUW9
                            	  5903: 
                            	  5904:     even
                            	  5905: PrimarySquaresUW:
02:00042122 B0              	  5906:     dc.b    $B0, $74, $94, $B4, $70, $68, $F4, $24
02:00042123 74
02:00042124 94
02:00042125 B4
02:00042126 70
02:00042127 68
02:00042128 F4
02:00042129 24
                            	  5907: 
                            	  5908:     even
                            	  5909: LayoutUWFloor:
02:0004212A 7005            	  5910:     moveq   #5,D0
02:0004212C 4EB90002CBA4    	  5911:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00042132 61007260        	  5912:     jsr     GetUniqueRoomId
02:00042136 1B00            	  5913:     move.b  D0,-(A5)  ; PHA
02:00042138 7000            	  5914:     moveq   #0,D0
02:0004213A 19400002        	  5915:     move.b  D0,($0002,A4)
02:0004213E 7000            	  5916:     moveq   #0,D0
02:00042140 19400003        	  5917:     move.b  D0,($0003,A4)
02:00042144 101D            	  5918:     move.b  (A5)+,D0  ; PLA
02:00042146 E308            	  5919:     lsl.b  #1,D0   ; ASL A
