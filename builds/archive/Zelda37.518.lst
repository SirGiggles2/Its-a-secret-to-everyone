02:0002D692 3A04            	  3392:     move.w  D4,D5
02:0002D694 E44D            	  3393:     lsr.w   #2,D5
02:0002D696 02450003        	  3394:     andi.w  #$0003,D5
02:0002D69A EB4D            	  3395:     lsl.w   #5,D5
02:0002D69C E14D            	  3396:     lsl.w   #8,D5
02:0002D69E 5442            	  3397:     addq.w  #2,D2
02:0002D6A0 615E            	  3398:     bsr     .ttf_attr1_cache_2x2
02:0002D6A2 4EB900010A9E    	  3399:     bsr     _attr_write_2x2
02:0002D6A8 5542            	  3400:     subq.w  #2,D2
                            	  3401: 
                            	  3402:     ; Quadrant 2: bits [5:4], row_off=+2
02:0002D6AA 3A04            	  3403:     move.w  D4,D5
02:0002D6AC E84D            	  3404:     lsr.w   #4,D5
02:0002D6AE 02450003        	  3405:     andi.w  #$0003,D5
02:0002D6B2 EB4D            	  3406:     lsl.w   #5,D5
02:0002D6B4 E14D            	  3407:     lsl.w   #8,D5
02:0002D6B6 5443            	  3408:     addq.w  #2,D3
02:0002D6B8 6146            	  3409:     bsr     .ttf_attr1_cache_2x2
02:0002D6BA 4EB900010A9E    	  3410:     bsr     _attr_write_2x2
02:0002D6C0 5543            	  3411:     subq.w  #2,D3
                            	  3412: 
                            	  3413:     ; Quadrant 3: bits [7:6], row_off=+2, col_off=+2
02:0002D6C2 3A04            	  3414:     move.w  D4,D5
02:0002D6C4 EC4D            	  3415:     lsr.w   #6,D5
02:0002D6C6 02450003        	  3416:     andi.w  #$0003,D5
02:0002D6CA EB4D            	  3417:     lsl.w   #5,D5
02:0002D6CC E14D            	  3418:     lsl.w   #8,D5
02:0002D6CE 5442            	  3419:     addq.w  #2,D2
02:0002D6D0 5443            	  3420:     addq.w  #2,D3
02:0002D6D2 612C            	  3421:     bsr     .ttf_attr1_cache_2x2
02:0002D6D4 4EB900010A9E    	  3422:     bsr     _attr_write_2x2
02:0002D6DA 5542            	  3423:     subq.w  #2,D2
02:0002D6DC 5543            	  3424:     subq.w  #2,D3
                            	  3425: 
02:0002D6DE 4CDF001E        	  3426:     movem.l (SP)+,D1-D4
02:0002D6E2 205F            	  3427:     movea.l (SP)+,A0
02:0002D6E4 3A3900FF0802    	  3428:     move.w  (PPU_VADDR).l,D5
                            	  3429: 
                            	  3430: .ttf_attr1_skip:
02:0002D6EA DA41            	  3431:     add.w   D1,D5                   ; advance PPU_VADDR
02:0002D6EC 02453FFF        	  3432:     andi.w  #$3FFF,D5
02:0002D6F0 33C500FF0802    	  3433:     move.w  D5,(PPU_VADDR).l
02:0002D6F6 5343            	  3434:     subq.w  #1,D3
02:0002D6F8 6600FF4C        	  3435:     bne     .ttf_attr1_loop
02:0002D6FC 600000E2        	  3436:     bra     .ttf_post_record
                            	  3437: 
                            	  3438: .ttf_attr1_cache_2x2:
02:0002D700 3005            	  3439:     move.w  D5,D0
02:0002D702 E048            	  3440:     lsr.w   #8,D0
02:0002D704 EA48            	  3441:     lsr.w   #5,D0                   ; D0.w = raw palette id 0..3
02:0002D706 43F900FF1400    	  3442:     lea     (NT_ATTR_CACHE_BASE).l,A1
02:0002D70C 7C00            	  3443:     moveq   #0,D6
02:0002D70E 3C03            	  3444:     move.w  D3,D6
02:0002D710 EB4E            	  3445:     lsl.w   #5,D6
02:0002D712 DC42            	  3446:     add.w   D2,D6
02:0002D714 13806000        	  3447:     move.b  D0,(A1,D6.W)
02:0002D718 5246            	  3448:     addq.w  #1,D6
02:0002D71A 13806000        	  3449:     move.b  D0,(A1,D6.W)
02:0002D71E 0646001F        	  3450:     addi.w  #31,D6
02:0002D722 13806000        	  3451:     move.b  D0,(A1,D6.W)
02:0002D726 5246            	  3452:     addq.w  #1,D6
02:0002D728 13806000        	  3453:     move.b  D0,(A1,D6.W)
02:0002D72C 4E75            	  3454:     rts
