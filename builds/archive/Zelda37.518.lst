02:0003ACD2 123C0001        	  1597:     move.b  #$01,D1
02:0003ACD6 D101            	  1598:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003ACD8 0C000006        	  1599:     cmpi.b  #$06,D0
02:0003ACDC 6502            	  1600:     bcs  _anon_z04_41
02:0003ACDE 7000            	  1601:     moveq   #0,D0
                            	  1602: _anon_z04_41:
