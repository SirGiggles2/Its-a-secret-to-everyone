02:0003B404 10302000        	  2645:     move.b  (A0,D2.W),D0
02:0003B408 660000AA        	  2646:     bne  _L_z04_UpdateRockOrGravestone_State1
                            	  2647:     ; State 0.
                            	  2648:     ;
                            	  2649:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  2650:     ; bracelet, then return.
