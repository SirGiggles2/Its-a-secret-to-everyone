02:000371E6 D101            	  4619:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:000371E8 19400058        	  4620:     move.b  D0,($0058,A4)
                            	  4621:     ; Carry over to the tile offset and current V-scroll.
                            	  4622:     ;
02:000371EC 6404            	  4623:     bcc  _anon_z02_38
02:000371EE 522C050B        	  4624:     addq.b  #1,($050B,A4)
                            	  4625: _anon_z02_38:
02:000371F2 102C00FC        	  4626:     move.b  ($00FC,A4),D0
02:000371F6 123C0000        	  4627:     move.b  #$00,D1
02:000371FA D101            	  4628:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000371FC 194000FC        	  4629:     move.b  D0,($00FC,A4)
                            	  4630:     ; If we've reached the bottom of a nametable, then
                            	  4631:     ; roll over current V-scroll to 0, and increase number of
                            	  4632:     ; screens scrolled.
                            	  4633:     ;
02:00037200 0C0000F0        	  4634:     cmpi.b  #$F0,D0
02:00037204 7000            	  4635:     moveq   #0,D0
02:00037206 6508            	  4636:     bcs  _anon_z02_39
02:00037208 194000FC        	  4637:     move.b  D0,($00FC,A4)
02:0003720C 522C00E2        	  4638:     addq.b  #1,($00E2,A4)
                            	  4639: _anon_z02_39:
