                            	  1223:     ;==========================================================================
                            	  1224:     ; .chr_convert_upload — convert 16-byte NES 2BPP tile to 32-byte Genesis
                            	  1225:     ;                        4BPP and write to VDP VRAM.
                            	  1226:     ;
                            	  1227:     ; Input: CHR_TILE_BUF holds the 16 tile bytes.
                            	  1228:     ;        CHR_BUF_VADDR holds the NES CHR base address (× 16-aligned).
                            	  1229:     ;
                            	  1230:     ; Genesis VRAM tile address = CHR_BUF_VADDR × 2 (tiles are 32 bytes each).
                            	  1231:     ;
                            	  1232:     ; For each of 8 rows:
                            	  1233:     ;   plane0_row = CHR_TILE_BUF[row]       (bit 0 of each of 8 pixels)
                            	  1234:     ;   plane1_row = CHR_TILE_BUF[row+8]     (bit 1 of each of 8 pixels)
                            	  1235:     ;
                            	  1236:     ; Pixel color = (plane1_bit << 1) | plane0_bit  →  4-bit Genesis nibble
                            	  1237:     ;
                            	  1238:     ; Output format per row (4 Genesis bytes = 2 VDP words):
                            	  1239:     ;   byte 0: pixels 0,1  (high nibble = pixel 0, low nibble = pixel 1)
                            	  1240:     ;   byte 1: pixels 2,3
                            	  1241:     ;   byte 2: pixels 4,5
                            	  1242:     ;   byte 3: pixels 6,7
                            	  1243:     ;
                            	  1244:     ; expand_nibble(n) helper: scatters 4-bit value n to positions 12,8,4,0
                            	  1245:     ; of a 16-bit word (one bit per nibble).  Then OR-ing plane0 expansion
                            	  1246:     ; with (plane1 expansion << 1) gives the correct Genesis word.
                            	  1247:     ;
                            	  1248:     ; Uses D0–D5/A0 (all caller-saved at _ppu_write_7 entry).
                            	  1249:     ;==========================================================================
                            	  1250: _chr_convert_upload:
                            	  1251:     ; Set VDP write address: Genesis tile addr = NES CHR addr × 2
02:000108A4 323900FF0832    	  1252:     move.w  (CHR_BUF_VADDR).l,D1
02:000108AA D241            	  1253:     add.w   D1,D1                   ; D1.w = NES_addr × 2  (lsl #1)
                            	  1254:     ; VDP VRAM write command for D1.w (< $4000, so upper word = 0):
                            	  1255:     ; Use moveq+move.w to guarantee D2 upper = 0 before swap.
                            	  1256:     ; (plain move.l D1,D2 would propagate garbage from D1 upper 16 bits
                            	  1257:     ;  into the CD/address bits of the VDP command after swap.)
02:000108AC 7400            	  1258:     moveq   #0,D2
02:000108AE 3401            	  1259:     move.w  D1,D2                   ; D2.w = NES_addr × 2  (D2 upper guaranteed 0)
02:000108B0 4842            	  1260:     swap    D2                      ; D2 = (NES_addr × 2) << 16
02:000108B2 008240000000    	  1261:     ori.l   #$40000000,D2           ; VDP VRAM-write command
02:000108B8 23C200C00004    	  1262:     move.l  D2,(VDP_CTRL).l
                            	  1263: 
02:000108BE 41F900FF0820    	  1264:     lea     (CHR_TILE_BUF).l,A0     ; A0 → plane-0 row bytes (0..7)
02:000108C4 43F900010922    	  1265:     lea     (.expand_nibble_lut).l,A1 ; A1 → LUT (kept across all rows)
02:000108CA 7A07            	  1266:     moveq   #7,D5                   ; 8 rows, counter 7..0
                            	  1267: 
                            	  1268: .ccu_row:
02:000108CC 1610            	  1269:     move.b  0(A0),D3                ; D3.b = plane 0 for this row
02:000108CE 18280008        	  1270:     move.b  8(A0),D4                ; D4.b = plane 1 for this row
02:000108D2 5288            	  1271:     addq.l  #1,A0                   ; advance to next plane-0 row byte
                            	  1272: 
                            	  1273:     ; ---- Pixels 0-3 (upper nibbles of D3 and D4) ----
02:000108D4 1203            	  1274:     move.b  D3,D1
02:000108D6 E809            	  1275:     lsr.b   #4,D1                   ; D1.b = upper nibble of plane0 (pix 0-3)
02:000108D8 0201000F        	  1276:     andi.b  #$0F,D1
02:000108DC 6138            	  1277:     bsr     .expand_nibble          ; D2.w = plane0 expansion (bit0 of each nibble)
02:000108DE 3C02            	  1278:     move.w  D2,D6                   ; save plane0 expansion in D6 (D0 clobbered by expand)
                            	  1279: 
02:000108E0 1204            	  1280:     move.b  D4,D1
02:000108E2 E809            	  1281:     lsr.b   #4,D1                   ; D1.b = upper nibble of plane1 (pix 0-3)
02:000108E4 0201000F        	  1282:     andi.b  #$0F,D1
02:000108E8 612C            	  1283:     bsr     .expand_nibble          ; D2.w = plane1 expansion
02:000108EA E34A            	  1284:     lsl.w   #1,D2                   ; ×2 → puts plane1 bits in bit1 of each nibble
02:000108EC 8446            	  1285:     or.w    D6,D2                   ; combine: each nibble = (p1_bit<<1)|p0_bit
02:000108EE 33C200C00000    	  1286:     move.w  D2,(VDP_DATA).l         ; write pixels 0-3 (2 VDP bytes via auto-incr)
                            	  1287: 
                            	  1288:     ; ---- Pixels 4-7 (lower nibbles of D3 and D4) ----
02:000108F4 1203            	  1289:     move.b  D3,D1
02:000108F6 0201000F        	  1290:     andi.b  #$0F,D1                 ; D1.b = lower nibble of plane0 (pix 4-7)
02:000108FA 611A            	  1291:     bsr     .expand_nibble
02:000108FC 3C02            	  1292:     move.w  D2,D6                   ; save plane0 expansion in D6
                            	  1293: 
02:000108FE 1204            	  1294:     move.b  D4,D1
02:00010900 0201000F        	  1295:     andi.b  #$0F,D1                 ; D1.b = lower nibble of plane1 (pix 4-7)
02:00010904 6110            	  1296:     bsr     .expand_nibble
02:00010906 E34A            	  1297:     lsl.w   #1,D2                   ; ×2 for plane1
02:00010908 8446            	  1298:     or.w    D6,D2
02:0001090A 33C200C00000    	  1299:     move.w  D2,(VDP_DATA).l         ; write pixels 4-7
                            	  1300: 
02:00010910 5305            	  1301:     subq.b  #1,D5
02:00010912 6CB8            	  1302:     bge.s   .ccu_row                ; loop for all 8 rows
02:00010914 4E75            	  1303:     rts
                            	  1304: 
                            	  1305:     ;==========================================================================
                            	  1306:     ; .expand_nibble — scatter 4-bit nibble to bit-0 of each output nibble.
                            	  1307:     ;
                            	  1308:     ; Input:  D1.b = 4-bit value n (bits 3..0 = pixels 0..3 of one plane)
                            	  1309:     ; Output: D2.w = bit3→pos12, bit2→pos8, bit1→pos4, bit0→pos0
                            	  1310:     ;
                            	  1311:     ; Uses lookup table for speed: 2 instructions instead of ~24.
                            	  1312:     ;==========================================================================
                            	  1313: .expand_nibble:
02:00010916 0241000F        	  1314:     andi.w  #$000F,D1               ; mask to 4 bits, zero-extend
02:0001091A D241            	  1315:     add.w   D1,D1                   ; word offset into table
02:0001091C 34311000        	  1316:     move.w  (A1,D1.W),D2            ; D2.w = expanded nibble (A1 = LUT base)
02:00010920 4E75            	  1317:     rts
                            	  1318: 
                            	  1319:     ;==========================================================================
                            	  1320:     ; 16-entry lookup table: nibble → scattered bits.
                            	  1321:     ;   Entry n: bit3→bit12, bit2→bit8, bit1→bit4, bit0→bit0
                            	  1322:     ;   e.g. $F (1111) → $1111, $A (1010) → $1010, $5 (0101) → $0101
                            	  1323:     ;==========================================================================
                            	  1324:     even
                            	  1325: .expand_nibble_lut:
02:00010922 0000            	  1326:     dc.w    $0000   ; 0000
02:00010924 0001            	  1327:     dc.w    $0001   ; 0001
02:00010926 0010            	  1328:     dc.w    $0010   ; 0010
02:00010928 0011            	  1329:     dc.w    $0011   ; 0011
02:0001092A 0100            	  1330:     dc.w    $0100   ; 0100
02:0001092C 0101            	  1331:     dc.w    $0101   ; 0101
02:0001092E 0110            	  1332:     dc.w    $0110   ; 0110
02:00010930 0111            	  1333:     dc.w    $0111   ; 0111
02:00010932 1000            	  1334:     dc.w    $1000   ; 1000
02:00010934 1001            	  1335:     dc.w    $1001   ; 1001
02:00010936 1010            	  1336:     dc.w    $1010   ; 1010
02:00010938 1011            	  1337:     dc.w    $1011   ; 1011
02:0001093A 1100            	  1338:     dc.w    $1100   ; 1100
02:0001093C 1101            	  1339:     dc.w    $1101   ; 1101
02:0001093E 1110            	  1340:     dc.w    $1110   ; 1110
02:00010940 1111            	  1341:     dc.w    $1111   ; 1111
                            	  1342: 
02:00010942 4E75            	  1343:     rts
                            	  1344: 
                            	  1345:     ifne CHR_EXPANSION_ENABLED
                            	  1346: ;==============================================================================
                            	  1347: ; _chr_upload_sprite_4x — upload one NES sprite CHR tile to 4 Gen VRAM copies
                            	  1348: ;                         with pre-biased pixel values.
                            	  1349: ;
                            	  1350: ; Input:  CHR_TILE_BUF     = 16 NES 2bpp tile bytes
                            	  1351: ;         CHR_BUF_VADDR    = NES CHR address (16-aligned)
                            	  1352: ;
                            	  1353: ; Output: lower-half sprite CHR populates the normal sprite-copy banks.
                            	  1354: ;         upper-half CHR during NES 8x16 mode populates only the safe banks
                            	  1355: ;         used by the nonzero sprite sub-palettes, so BG pattern-table 1 tiles
                            	  1356: ;         are not clobbered.
                            	  1357: ;
                            	  1358: ; Pixel 0 (transparent) is preserved across all 4 copies — bias is only
                            	  1359: ; applied to nonzero pixels via a nibble mask.
                            	  1360: ;
                            	  1361: ; Bias mechanism (mask-based, no per-copy LUTs):
                            	  1362: ;   1. expand plane0 and plane1 via existing 16-entry .expand_nibble_lut
                            	  1363: ;   2. nonzero_mask = plane0_exp | plane1_exp  ($0 or $1 per nibble)
                            	  1364: ;   3. bias_word_per_copy:  $0000, $4444, $8888, $CCCC
                            	  1365: ;   4. mask_F = mask | mask<<1 | mask<<2 | mask<<3 ($0 or $F per nibble)
                            	  1366: ;   5. bias_add = mask_F & bias_word  ($0 or bias per nonzero nibble)
                            	  1367: ;   6. final = orig_pixels | bias_add  (no nibble overflow: orig <= 3, bias <= 12)
                            	  1368: ;
                            	  1369: ; Clobbers D0-D7, A0-A2.
                            	  1370: ;==============================================================================
                            	  1371: _chr_upload_sprite_4x:
02:00010944 48E7FFE0        	  1372:     movem.l D0-D7/A0-A2,-(SP)           ; save everything (helper clobbers D0-D7, A0-A2)
02:00010948 303900FF0832    	  1373:     move.w  (CHR_BUF_VADDR).l,D0
02:0001094E 0800000C        	  1374:     btst    #12,D0
02:00010952 6714            	  1375:     beq.s   .csfx_use_lo_tbl
02:00010954 0839000500FF0804	  1376:     btst    #5,(PPU_CTRL).l
02:0001095C 670A            	  1377:     beq.s   .csfx_use_lo_tbl
02:0001095E 45F900010A76    	  1378:     lea     (.csfx_hi_copy_base_tbl).l,A2
02:00010964 7A01            	  1379:     moveq   #1,D5                       ; upper-half 8x16 support: banks B/C only
02:00010966 6008            	  1380:     bra.s   .csfx_copy_loop
                            	  1381: .csfx_use_lo_tbl:
02:00010968 45F900010A56    	  1382:     lea     (.csfx_copy_base_tbl).l,A2
02:0001096E 7A03            	  1383:     moveq   #3,D5                       ; 4 copies, counter 3..0
                            	  1384: .csfx_copy_loop:
                            	  1385:     ; Recompute tile offset each iteration because .csfx_row (below) clobbers
                            	  1386:     ; D3/D4 with plane0/plane1 row bytes. Previously this lived before the
                            	  1387:     ; loop and caused copies 1-3 to land at misaligned VRAM addresses.
02:00010970 363900FF0832    	  1388:     move.w  (CHR_BUF_VADDR).l,D3
02:00010976 D643            	  1389:     add.w   D3,D3                       ; D3.w = gen tile offset (NES_addr * 2)
02:00010978 02830000FFFF    	  1390:     andi.l  #$0000FFFF,D3               ; zero-extend for safe .l math
02:0001097E 281A            	  1391:     move.l  (A2)+,D4                    ; D4.l = copy base VRAM addr
02:00010980 D883            	  1392:     add.l   D3,D4                       ; D4.l = tile VRAM addr for this copy
02:00010982 2E1A            	  1393:     move.l  (A2)+,D7                    ; D7.l = bias word (low 16 bits used)
                            	  1394:     ; Build VDP VRAM write command in D2.l:
                            	  1395:     ;   cmd = $40000000 | ((addr & $3FFF) << 16) | ((addr >> 14) & $0003)
02:00010984 2004            	  1396:     move.l  D4,D0
02:00010986 028000003FFF    	  1397:     andi.l  #$00003FFF,D0
02:0001098C 4840            	  1398:     swap    D0
02:0001098E 008040000000    	  1399:     ori.l   #$40000000,D0
02:00010994 2404            	  1400:     move.l  D4,D2
02:00010996 E08A            	  1401:     lsr.l   #8,D2
02:00010998 EC8A            	  1402:     lsr.l   #6,D2
02:0001099A 028200000003    	  1403:     andi.l  #$00000003,D2
02:000109A0 8082            	  1404:     or.l    D2,D0
02:000109A2 23C000C00004    	  1405:     move.l  D0,(VDP_CTRL).l
                            	  1406: 
02:000109A8 41F900FF0820    	  1407:     lea     (CHR_TILE_BUF).l,A0
02:000109AE 43F900010A36    	  1408:     lea     (.csfx_expand_lut).l,A1
02:000109B4 7007            	  1409:     move.l  #7,D0
                            	  1410:     ; Using D0 as row counter conflicts with expand_nibble which clobbers D0/D1/D2.
                            	  1411:     ; Save row counter on stack per iteration.
                            	  1412: .csfx_row:
02:000109B6 2F00            	  1413:     move.l  D0,-(SP)                    ; save row counter
02:000109B8 1610            	  1414:     move.b  0(A0),D3                    ; D3.b = plane0 row
02:000109BA 18280008        	  1415:     move.b  8(A0),D4                    ; D4.b = plane1 row
02:000109BE 5288            	  1416:     addq.l  #1,A0
                            	  1417: 
                            	  1418:     ; ---- Pixels 0-3 (upper nibbles) ----
02:000109C0 1203            	  1419:     move.b  D3,D1
02:000109C2 E809            	  1420:     lsr.b   #4,D1
02:000109C4 0201000F        	  1421:     andi.b  #$0F,D1
02:000109C8 6160            	  1422:     bsr     .csfx_expand                ; D2.w = plane0 expand
02:000109CA 3C02            	  1423:     move.w  D2,D6                       ; D6 = plane0 expand
02:000109CC 1204            	  1424:     move.b  D4,D1
02:000109CE E809            	  1425:     lsr.b   #4,D1
02:000109D0 0201000F        	  1426:     andi.b  #$0F,D1
02:000109D4 6154            	  1427:     bsr     .csfx_expand              ; D2.w = plane1 expand
02:000109D6 3002            	  1428:     move.w  D2,D0                       ; D0.w = plane1 expand
02:000109D8 8046            	  1429:     or.w    D6,D0                       ; D0.w = nonzero mask ($0/$1 per nibble)
02:000109DA E34A            	  1430:     lsl.w   #1,D2
02:000109DC 8446            	  1431:     or.w    D6,D2                       ; D2.w = raw pixel nibbles
02:000109DE 6138            	  1432:     bsr     .csfx_apply_bias            ; merges bias using D0(mask), D7(bias)
02:000109E0 33C200C00000    	  1433:     move.w  D2,(VDP_DATA).l
                            	  1434: 
                            	  1435:     ; ---- Pixels 4-7 (lower nibbles) ----
02:000109E6 1203            	  1436:     move.b  D3,D1
02:000109E8 0201000F        	  1437:     andi.b  #$0F,D1
02:000109EC 613C            	  1438:     bsr     .csfx_expand
02:000109EE 3C02            	  1439:     move.w  D2,D6
02:000109F0 1204            	  1440:     move.b  D4,D1
02:000109F2 0201000F        	  1441:     andi.b  #$0F,D1
02:000109F6 6132            	  1442:     bsr     .csfx_expand
02:000109F8 3002            	  1443:     move.w  D2,D0
02:000109FA 8046            	  1444:     or.w    D6,D0
02:000109FC E34A            	  1445:     lsl.w   #1,D2
02:000109FE 8446            	  1446:     or.w    D6,D2
02:00010A00 6116            	  1447:     bsr     .csfx_apply_bias
02:00010A02 33C200C00000    	  1448:     move.w  D2,(VDP_DATA).l
                            	  1449: 
02:00010A08 201F            	  1450:     move.l  (SP)+,D0                    ; restore row counter
02:00010A0A 5380            	  1451:     subq.l  #1,D0
02:00010A0C 6CA8            	  1452:     bge.s   .csfx_row
                            	  1453: 
02:00010A0E 51CDFF60        	  1454:     dbra    D5,.csfx_copy_loop
02:00010A12 4CDF07FF        	  1455:     movem.l (SP)+,D0-D7/A0-A2
02:00010A16 4E75            	  1456:     rts
                            	  1457: 
                            	  1458:     ;==========================================================================
                            	  1459:     ; .csfx_apply_bias — add per-copy bias to nonzero pixel nibbles.
                            	  1460:     ; In:  D0.w = nonzero mask ($0/$1 per nibble)
                            	  1461:     ;      D2.w = raw pixel nibbles
                            	  1462:     ;      D7.w = bias word ($0000/$4444/$8888/$CCCC)
                            	  1463:     ; Out: D2.w = biased pixel nibbles
                            	  1464:     ; Clobbers D0, D1.
                            	  1465:     ;==========================================================================
                            	  1466: .csfx_apply_bias:
02:00010A18 3200            	  1467:     move.w  D0,D1
02:00010A1A E349            	  1468:     lsl.w   #1,D1
02:00010A1C 8041            	  1469:     or.w    D1,D0
02:00010A1E 3200            	  1470:     move.w  D0,D1
02:00010A20 E549            	  1471:     lsl.w   #2,D1
02:00010A22 8041            	  1472:     or.w    D1,D0                       ; D0 now has $F per nonzero nibble
02:00010A24 C047            	  1473:     and.w   D7,D0                       ; D0 = bias_add (bias per nonzero nibble)
02:00010A26 8440            	  1474:     or.w    D0,D2                       ; merge into pixel nibbles
02:00010A28 4E75            	  1475:     rts
                            	  1476: 
                            	  1477:     ;==========================================================================
                            	  1478:     ; .csfx_expand — local copy of the nibble expander used by _chr_convert_upload.
                            	  1479:     ; In:  D1.b = 4-bit nibble, A1 = .csfx_expand_lut
                            	  1480:     ; Out: D2.w = bit3→pos12, bit2→pos8, bit1→pos4, bit0→pos0
                            	  1481:     ;==========================================================================
                            	  1482: .csfx_expand:
02:00010A2A 0241000F        	  1483:     andi.w  #$000F,D1
02:00010A2E D241            	  1484:     add.w   D1,D1
02:00010A30 34311000        	  1485:     move.w  (A1,D1.W),D2
02:00010A34 4E75            	  1486:     rts
                            	  1487: 
                            	  1488:     even
                            	  1489: .csfx_expand_lut:
02:00010A36 0000            	  1490:     dc.w    $0000,$0001,$0010,$0011
02:00010A38 0001
02:00010A3A 0010
02:00010A3C 0011
02:00010A3E 0100            	  1491:     dc.w    $0100,$0101,$0110,$0111
02:00010A40 0101
02:00010A42 0110
02:00010A44 0111
02:00010A46 1000            	  1492:     dc.w    $1000,$1001,$1010,$1011
02:00010A48 1001
02:00010A4A 1010
02:00010A4C 1011
02:00010A4E 1100            	  1493:     dc.w    $1100,$1101,$1110,$1111
02:00010A50 1101
02:00010A52 1110
02:00010A54 1111
                            	  1494: 
                            	  1495:     even
                            	  1496: .csfx_copy_base_tbl:
                            	  1497:     ; 4 entries, 8 bytes each: (base_vram .l, bias_word_as_long .l)
                            	  1498:     ; Bias word sits in the low 16 bits of the long so `move.l (A2)+,D7`
                            	  1499:     ; leaves the bias in D7.w for the .w AND in .csfx_apply_bias.
                            	  1500:     ; T-CHR v9: sub-pal→CRAM slot mapping via pixel bias + Gen-pal bits (OAM).
                            	  1501:     ;   copy 0 / shared bank A (sub-pal 0 + sub-pal 3): bias +$4
                            	  1502:     ;   copy 1 / bank B (sub-pal 1): bias +$8
                            	  1503:     ;   copy 2 / bank C (sub-pal 2): bias +$C
                            	  1504:     ;   copy 3 reuses bank A because sub-pal 3 needs the same +$4 biased pixels
                            	  1505:     ;   as sub-pal 0; only the SAT palette bits differ. This frees the old bank-C
                            	  1506:     ;   overlap so 8x16 table-1 sprites like the item-roll heart can use upper-half
                            	  1507:     ;   tile pairs without colliding with another sprite copy.
02:00010A56 00000000        	  1508:     dc.l    $00000000,$00004444
02:00010A5A 00004444
02:00010A5E 00004000        	  1509:     dc.l    $00004000,$00008888
02:00010A62 00008888
02:00010A66 00008000        	  1510:     dc.l    $00008000,$0000CCCC
02:00010A6A 0000CCCC
02:00010A6E 00000000        	  1511:     dc.l    $00000000,$00004444
02:00010A72 00004444
                            	  1512: .csfx_hi_copy_base_tbl:
                            	  1513:     ; Upper-half CHR mirrored for NES 8x16 sprites. Only the safe banks used by
                            	  1514:     ; sub-pal 1 (+8) and sub-pal 2 (+C) are populated here.
02:00010A76 00004000        	  1515:     dc.l    $00004000,$00008888
02:00010A7A 00008888
02:00010A7E 00008000        	  1516:     dc.l    $00008000,$0000CCCC
02:00010A82 0000CCCC
                            	  1517:     endc
                            	  1518: 
                            	  1519: ;==============================================================================
                            	  1520: ; _compose_bg_tile_word — add the active BG pattern-table offset to a raw tile.
                            	  1521: ;
                            	  1522: ; Input:  D0.w = raw NES BG tile index (0..255)
                            	  1523: ; Output: D0.w = Genesis tile word: bit 15 (high prio) | tile index
                            	  1524: ; Uses no other registers.
                            	  1525: ;
                            	  1526: ; Attempt 5g (diary 2026-04-04 12:37:44): Plane A BG tiles are promoted to
                            	  1527: ; high priority so text and board glyphs can sit in front of sprites that
                            	  1528: ; NES OAM marks as behind-background (attr bit 5). _oam_dma pairs with this
                            	  1529: ; by honoring attr bit 5 and leaving those sprites low-priority.
                            	  1530: ;==============================================================================
                            	  1531: _compose_bg_tile_word:
02:00010A86 024000FF        	  1532:     andi.w  #$00FF,D0               ; raw tile index only
02:00010A8A 0839000400FF0804	  1533:     btst    #4,(PPU_CTRL).l
02:00010A92 6704            	  1534:     beq.s   .cbgtw_done
02:00010A94 00400100        	  1535:     ori.w   #$0100,D0               ; BG pattern table 1 → VRAM $1000
                            	  1536: .cbgtw_done:
02:00010A98 00408000        	  1537:     ori.w   #$8000,D0               ; bit 15 = high priority (Attempt 5g)
02:00010A9C 4E75            	  1538:     rts
                            	  1539: 
                            	  1540: ;==============================================================================
                            	  1541: ; _attr_write_2x2 — write palette bits into a 2x2 tile block.
                            	  1542: ;
                            	  1543: ; Input: D2.w = col (top-left tile), D3.w = row (top-left tile)
                            	  1544: ;        D5.w = palette << 13  (Genesis tile word palette bits [14:13])
                            	  1545: ; All inputs preserved.  Uses D0, D1, A0 as scratch.
                            	  1546: ;==============================================================================
                            	  1547: _attr_write_2x2:
02:00010A9E 6110            	  1548:     bsr     _attr_write_one_tile        ; (row,   col)
02:00010AA0 5242            	  1549:     addq.w  #1,D2
02:00010AA2 610C            	  1550:     bsr     _attr_write_one_tile        ; (row,   col+1)
02:00010AA4 5243            	  1551:     addq.w  #1,D3
02:00010AA6 6108            	  1552:     bsr     _attr_write_one_tile        ; (row+1, col+1)
02:00010AA8 5342            	  1553:     subq.w  #1,D2
02:00010AAA 6104            	  1554:     bsr     _attr_write_one_tile        ; (row+1, col)
02:00010AAC 5343            	  1555:     subq.w  #1,D3
02:00010AAE 4E75            	  1556:     rts
                            	  1557: 
                            	  1558: ;==============================================================================
                            	  1559: ; _attr_write_one_tile — write one Plane A tile word with palette bits.
                            	  1560: ;
                            	  1561: ; Input: D2.w = col (0..31), D3.w = row (0..29), D5.w = palette << 13
                            	  1562: ; Reads tile index from NT_CACHE_BASE[row*32 + col].
                            	  1563: ; Writes tile word = (palette<<13) | tile_index to VDP Plane A.
                            	  1564: ; Inputs D2, D3, D5 preserved.  Uses D0, D1, A0.
                            	  1565: ;==============================================================================
                            	  1566: _attr_write_one_tile:
                            	  1567:     ; Bounds check (V64: NT0 rows 0-29, NT1 rows 30-59)
02:00010AB0 0C43003C        	  1568:     cmpi.w  #60,D3
02:00010AB4 644C            	  1569:     bhs     .awt_skip           ; row >= 60 -> out of nametable
02:00010AB6 0C420020        	  1570:     cmpi.w  #32,D2
02:00010ABA 6446            	  1571:     bhs     .awt_skip           ; col >= 32 -> out of nametable
                            	  1572: 
                            	  1573:     ; Load cached tile index: NT_CACHE[row*32 + col]
02:00010ABC 7200            	  1574:     moveq   #0,D1
02:00010ABE 3203            	  1575:     move.w  D3,D1
02:00010AC0 EB49            	  1576:     lsl.w   #5,D1               ; D1.w = row * 32
02:00010AC2 D242            	  1577:     add.w   D2,D1               ; D1.w = row*32 + col
02:00010AC4 41F900FF0840    	  1578:     lea     (NT_CACHE_BASE).l,A0
02:00010ACA 7000            	  1579:     moveq   #0,D0
02:00010ACC 10301000        	  1580:     move.b  (A0,D1.W),D0        ; D0.b = tile index
                            	  1581: 
02:00010AD0 61B4            	  1582:     bsr     _compose_bg_tile_word
                            	  1583:     ; Build tile word: (palette<<13) | tile_index
02:00010AD2 8045            	  1584:     or.w    D5,D0               ; D0.w = tile word with palette bits
                            	  1585: 
                            	  1586:     ; Compute Genesis VDP address: $C000 + row*$80 + col*2
02:00010AD4 7200            	  1587:     moveq   #0,D1
02:00010AD6 3203            	  1588:     move.w  D3,D1
02:00010AD8 EF89            	  1589:     lsl.l   #7,D1               ; D1.l = row * $80
02:00010ADA D242            	  1590:     add.w   D2,D1
02:00010ADC D242            	  1591:     add.w   D2,D1               ; D1.w += col * 2
02:00010ADE 0641C000        	  1592:     addi.w  #$C000,D1           ; D1.w = VDP address
                            	  1593: 
                            	  1594:     ; Issue VDP VRAM write command
02:00010AE2 3F00            	  1595:     move.w  D0,-(SP)            ; save tile word
02:00010AE4 2001            	  1596:     move.l  D1,D0
02:00010AE6 028000003FFF    	  1597:     andi.l  #$00003FFF,D0
02:00010AEC 4840            	  1598:     swap    D0
02:00010AEE 008040000003    	  1599:     ori.l   #$40000003,D0       ; CD bits + A[15:14]=3
02:00010AF4 23C000C00004    	  1600:     move.l  D0,(VDP_CTRL).l
02:00010AFA 301F            	  1601:     move.w  (SP)+,D0            ; restore tile word
02:00010AFC 33C000C00000    	  1602:     move.w  D0,(VDP_DATA).l     ; write to Plane A
                            	  1603: 
                            	  1604:     ; V64 gap rows 60-63 left blank — see _ppu_write_7 comment.
                            	  1605: 
                            	  1606: .awt_skip:
02:00010B02 4E75            	  1607:     rts
                            	  1608: 
                            	  1609: ;==============================================================================
                            	  1610: ; NES → Genesis palette lookup table
                            	  1611: ;
                            	  1612: ; 64 × 16-bit words: index = NES color byte (0–63).
                            	  1613: ; Genesis color format: $0BGR (bits [10:8]=Blue, [6:4]=Green, [2:0]=Red, 0–7 each).
                            	  1614: ; Source: title-calibrated NES palette approximations tuned against BizHawk
                            	  1615: ; frame-200 NES reference captures, quantized to Genesis 3-bit channels.
                            	  1616: ;==============================================================================
                            	  1617:     even
                            	  1618: nes_palette_to_genesis:
                            	  1619:     ;       NES $00–$0F  (grays, blues, purples, reds, greens)
                            	  1620:     ;       Genesis CRAM = (B<<9)|(G<<5)|(R<<1)  — NOT raw $0BGR nibbles
02:00010B04 0666            	  1621:     dc.w    $0666   ; $00  rgb(84,84,84)     dark gray (universal BG)
02:00010B06 0E00            	  1622:     dc.w    $0E00   ; $01  rgb(0,0,252)     dark blue
02:00010B08 0A00            	  1623:     dc.w    $0A00   ; $02  rgb(0,0,188)     dark blue
02:00010B0A 0A24            	  1624:     dc.w    $0A24   ; $03  rgb(68,40,188)   blue-violet
02:00010B0C 0808            	  1625:     dc.w    $0808   ; $04  rgb(148,0,132)   purple
02:00010B0E 020A            	  1626:     dc.w    $020A   ; $05  rgb(168,0,32)    dark red-magenta
02:00010B10 000A            	  1627:     dc.w    $000A   ; $06  rgb(168,16,0)    dark red
02:00010B12 0028            	  1628:     dc.w    $0028   ; $07  rgb(136,20,0)    dark red-brown
02:00010B14 0044            	  1629:     dc.w    $0044   ; $08  dark olive-brown
02:00010B16 0060            	  1630:     dc.w    $0060   ; $09  rgb(0,120,0)     dark green
02:00010B18 0060            	  1631:     dc.w    $0060   ; $0A  rgb(0,104,0)     dark green
02:00010B1A 0040            	  1632:     dc.w    $0040   ; $0B  rgb(0,88,0)      very dark green
02:00010B1C 0440            	  1633:     dc.w    $0440   ; $0C  rgb(0,64,88)     dark teal
02:00010B1E 0000            	  1634:     dc.w    $0000   ; $0D  black (unused/invalid)
02:00010B20 0000            	  1635:     dc.w    $0000   ; $0E  black (unused/invalid)
