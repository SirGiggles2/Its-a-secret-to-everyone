                            	  1279: AnimateDemoPhase0Subphase1:
02:0003502E 102C0438        	  1280:     move.b  ($0438,A4),D0
02:00035032 666C            	  1281:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1282:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1283:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1284:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00035034 7000            	  1285:     moveq   #0,D0
02:00035036 102C0437        	  1286:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:0003503A EB48            	  1287:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:0003503C 41F900034E1E    	  1288:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00035042 D0C0            	  1289:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1290:     ; Set up DynTileBuf header: $3F, $00, $20
02:00035044 197C003F0302    	  1291:     move.b  #$3F,($0302,A4)
02:0003504A 197C00000303    	  1292:     move.b  #$00,($0303,A4)
02:00035050 7020            	  1293:     moveq   #32,D0
02:00035052 19400304        	  1294:     move.b  D0,($0304,A4)
                            	  1295:     ; End marker at DynTileBuf+4+31
02:00035056 761F            	  1296:     moveq   #31,D3
02:00035058 103C00FF        	  1297:     move.b  #$FF,D0
02:0003505C 43EC0306        	  1298:     lea     ($0306,A4),A1
02:00035060 13803000        	  1299:     move.b  D0,(A1,D3.W)
                            	  1300:     even
                            	  1301: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00035064 10303000        	  1302:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00035068 43EC0305        	  1303:     lea     ($0305,A4),A1
02:0003506C 13803000        	  1304:     move.b  D0,(A1,D3.W)
02:00035070 5303            	  1305:     subq.b  #1,D3
02:00035072 6AF0            	  1306:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1307:     ; Advance the subphase cycle.
                            	  1308:     ;
02:00035074 522C0437        	  1309:     addq.b  #1,($0437,A4)
                            	  1310:     ; Set the timer to the delay for the current point in the cycle.
                            	  1311:     ;
02:00035078 7600            	  1312:     moveq   #0,D3
02:0003507A 162C0437        	  1313:     move.b  ($0437,A4),D3
02:0003507E 41F90003501D    	  1314:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:00035084 10303000        	  1315:     move.b  (A0,D3.W),D0
02:00035088 19400438        	  1316:     move.b  D0,($0438,A4)
02:0003508C 0C03000E        	  1317:     cmpi.b  #$0E,D3
02:00035090 650E            	  1318:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1319:     ; Advance to the next demo phase.
                            	  1320:     ;
02:00035092 522C042C        	  1321:     addq.b  #1,($042C,A4)
02:00035096 7000            	  1322:     moveq   #0,D0
02:00035098 1940042D        	  1323:     move.b  D0,($042D,A4)
02:0003509C 19400011        	  1324:     move.b  D0,($0011,A4)
                            	  1325:     even
