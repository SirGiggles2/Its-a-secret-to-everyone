                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002CB84 00010B84        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002CB88 00014B84
02:0002CB8C 00018B84        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0002CB90 0001CB84
