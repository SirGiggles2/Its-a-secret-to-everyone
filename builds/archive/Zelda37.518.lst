02:0004A44C 41EC0394        	  4719:     lea     ($0394,A4),A0
02:0004A450 10302000        	  4720:     move.b  (A0,D2.W),D0
                            	  4721:     bne  _anon_z07_23
                            	  4722: _anon_z07_23:
02:0004A454 41EC0098        	  4723:     lea     ($0098,A4),A0
02:0004A458 10302000        	  4724:     move.b  (A0,D2.W),D0
02:0004A45C 4EB900032BEA    	  4725:     jsr     MoveShot
                            	  4726:     ; If movement was blocked, go handle the situation.
                            	  4727:     ;
02:0004A462 102C000F        	  4728:     move.b  ($000F,A4),D0
02:0004A466 6604            	  4729:     bne.s  __far_z_07_0069
02:0004A468 600000A6        	  4730:     jmp  HandleShotBlocked
                            	  4731: __far_z_07_0069:
                            	  4732:     ; If grid offset is a multiple of 8, reset it.
                            	  4733:     ;
02:0004A46C 41EC0394        	  4734:     lea     ($0394,A4),A0
02:0004A470 10302000        	  4735:     move.b  (A0,D2.W),D0
02:0004A474 02000007        	  4736:     andi.b #$07,D0
02:0004A478 6702            	  4737:     beq.s  __far_z_07_0070
02:0004A47A 6008            	  4738:     jmp  DrawSwordShotOrMagicShot
                            	  4739: __far_z_07_0070:
02:0004A47C 41EC0394        	  4740:     lea     ($0394,A4),A0
02:0004A480 11802000        	  4741:     move.b  D0,(A0,D2.W)
                            	  4742:     even
                            	  4743: DrawSwordShotOrMagicShot:
                            	  4744:     ; Prepare the sprite position.
                            	  4745:     ;
02:0004A484 61000D9A        	  4746:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4747:     ; If the direction is horizontal, move the sprites down 3 pixels.
                            	  4748:     ;
02:0004A488 41EC0098        	  4749:     lea     ($0098,A4),A0
02:0004A48C 10302000        	  4750:     move.b  (A0,D2.W),D0
02:0004A490 1B00            	  4751:     move.b  D0,-(A5)  ; PHA
02:0004A492 02000003        	  4752:     andi.b #$03,D0
02:0004A496 6712            	  4753:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004A498 102C0001        	  4754:     move.b  ($0001,A4),D0
02:0004A49C 023C00EE        	  4755:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A4A0 123C0003        	  4756:     move.b  #$03,D1
02:0004A4A4 D101            	  4757:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004A4A6 19400001        	  4758:     move.b  D0,($0001,A4)
                            	  4759:     even
                            	  4760: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:0004A4AA 101D            	  4761:     move.b  (A5)+,D0  ; PLA
                            	  4762:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4763:     ; This makes the shot flash by cycling all the palettes, one each frame.
                            	  4764:     ;
                            	  4765:     ;
                            	  4766:     ; Call this only to get reverse direction index.
02:0004A4AC 4EB900032BDE    	  4767:     jsr     GetOppositeDir
02:0004A4B2 102C0015        	  4768:     move.b  ($0015,A4),D0
02:0004A4B6 02000003        	  4769:     andi.b #$03,D0
02:0004A4BA 41F90004A6F8    	  4770:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004A4C0 12303000        	  4771:     move.b  (A0,D3.W),D1
02:0004A4C4 8001            	  4772:     or.b  D1,D0
02:0004A4C6 4EB9000332A0    	  4773:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4774:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4775:     ;
02:0004A4CC 41F90004A6F4    	  4776:     lea     (RDirectionToWeaponFrame).l,A0
02:0004A4D2 10303000        	  4777:     move.b  (A0,D3.W),D0
02:0004A4D6 1940000C        	  4778:     move.b  D0,($000C,A4)
                            	  4779:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4780:     ;
02:0004A4DA 0C030002        	  4781:     cmpi.b  #$02,D3
02:0004A4DE 6604            	  4782:     bne  _anon_z07_24
02:0004A4E0 522C000F        	  4783:     addq.b  #1,($000F,A4)
                            	  4784: _anon_z07_24:
                            	  4785:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4786:     ;   $57 (sword shot) => $22
                            	  4787:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4788:     ;
02:0004A4E4 7622            	  4789:     moveq   #34,D3
02:0004A4E6 0C02000D        	  4790:     cmpi.b  #$0D,D2
02:0004A4EA 6410            	  4791:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004A4EC 41EC034F        	  4792:     lea     ($034F,A4),A0
02:0004A4F0 10302000        	  4793:     move.b  (A0,D2.W),D0
02:0004A4F4 0C000057        	  4794:     cmpi.b  #$57,D0
02:0004A4F8 6710            	  4795:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004A4FA 660C            	  4796:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4797:     even
                            	  4798: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4799:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4800:     ;   high bit set (magic)   => $23
                            	  4801:     ;   high bit clear (sword) => $22
                            	  4802:     ;
02:0004A4FC 41EC00AC        	  4803:     lea     ($00AC,A4),A0
02:0004A500 10302000        	  4804:     move.b  (A0,D2.W),D0
02:0004A504 E308            	  4805:     lsl.b  #1,D0   ; ASL A
02:0004A506 6402            	  4806:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4807:     even
                            	  4808: _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites:
02:0004A508 7623            	  4809:     moveq   #35,D3
                            	  4810:     even
                            	  4811: _L_z07_DrawSwordShotOrMagicShot_WriteSprites:
02:0004A50A 4EF9000331C0    	  4812:     jmp     Anim_WriteItemSprites
                            	  4813: 
                            	  4814: ; Params:
                            	  4815: ; X: shot object index
                            	  4816: ;
                            	  4817: ; If the object is a sword shot, go spread out the shot.
                            	  4818: ;
                            	  4819:     even
                            	  4820: HandleShotBlocked:
02:0004A510 4EF90002F50E    	  4821:     jmp     c_handle_shot_blocked
                            	  4822: 
                            	  4823: DeactivateLinkShot:
02:0004A516 4EF90002DE3E    	  4824:     jmp     c_deactivate_link_shot
                            	  4825: 
