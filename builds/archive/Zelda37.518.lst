                            	  5016:     ;
02:0003C58A 7610            	  5017:     moveq   #16,D3
02:0003C58C 7000            	  5018:     moveq   #0,D0
02:0003C58E 41EC00AC        	  5019:     lea     ($00AC,A4),A0
02:0003C592 11803000        	  5020:     move.b  D0,(A0,D3.W)
                            	  5021:     ; Increment the number of bomb hits.
                            	  5022:     ;
02:0003C596 41EC0437        	  5023:     lea     ($0437,A4),A0
02:0003C59A 10302000        	  5024:     move.b  (A0,D2.W),D0
