                            	  4167:     ; If object is the player, then go check passive tile objects and
                            	  4168:     ; the screen edge, or stop moving.
                            	  4169:     ;
02:0004A0D0 4A02            	  4170:     cmpi.b  #$00,D2
02:0004A0D2 6602            	  4171:     bne.s  __far_z_07_0052
02:0004A0D4 6020            	  4172:     jmp  PlayerUnwalkable
