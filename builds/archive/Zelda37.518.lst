                            	  7146: _L_z07_InitObject_InitMonsterFromEdge:
02:0004B65C 7400            	  7147:     moveq   #0,D2
02:0004B65E 142C0340        	  7148:     move.b  ($0340,A4),D2
                            	  7149:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7150:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7151:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7152:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7153:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7154:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7155:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7156:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7157:     ; corrupting them and causing a deterministic address-error
                            	  7158:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7159:     ; identified by Codex static review.)
                            	  7160: _L_z07_P47_pre_check:
02:0004B662 102C0525        	  7161:     move.b  ($0525,A4),D0
02:0004B666 020000F0        	  7162:     andi.b  #$F0,D0
02:0004B66A 0C000040        	  7163:     cmpi.b  #$40,D0
02:0004B66E 6506            	  7164:     blo     _L_z07_P47_pre_snap
02:0004B670 0C0000E0        	  7165:     cmpi.b  #$E0,D0
02:0004B674 6506            	  7166:     blo     _L_z07_P47_pre_ok
                            	  7167: _L_z07_P47_pre_snap:
02:0004B676 197C00480525    	  7168:     move.b  #$48,($0525,A4)
                            	  7169: _L_z07_P47_pre_ok:
02:0004B67C 7005            	  7170:     moveq   #5,D0
02:0004B67E 610004F4        	  7171:     jsr     SwitchBank
02:0004B682 4EB9000405BC    	  7172:     jsr     FindNextEdgeSpawnCell
                            	  7173:     ; Post-walk 1: bottom-edge snap.
02:0004B688 102C0525        	  7174:     move.b  ($0525,A4),D0
02:0004B68C 020000F0        	  7175:     andi.b  #$F0,D0
02:0004B690 0C0000E0        	  7176:     cmpi.b  #$E0,D0
02:0004B694 660C            	  7177:     bne     _L_z07_P47_post1_ok
02:0004B696 197C00480525    	  7178:     move.b  #$48,($0525,A4)
02:0004B69C 4EB9000405BC    	  7179:     jsr     FindNextEdgeSpawnCell
                            	  7180: _L_z07_P47_post1_ok:
                            	  7181:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7182:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004B6A2 7600            	  7183:     moveq   #0,D3
02:0004B6A4 162C0525        	  7184:     move.b  ($0525,A4),D3
02:0004B6A8 0243000F        	  7185:     andi.w  #$000F,D3
02:0004B6AC C6FC002C        	  7186:     mulu.w  #44,D3
02:0004B6B0 203C00FF6530    	  7187:     move.l  #$FF6530,D0
02:0004B6B6 D083            	  7188:     add.l   D3,D0
02:0004B6B8 7600            	  7189:     moveq   #0,D3
02:0004B6BA 162C0525        	  7190:     move.b  ($0525,A4),D3
02:0004B6BE E84B            	  7191:     lsr.w   #4,D3
02:0004B6C0 5943            	  7192:     subi.w  #4,D3
02:0004B6C2 E34B            	  7193:     lsl.w   #1,D3
02:0004B6C4 D083            	  7194:     add.l   D3,D0
02:0004B6C6 2040            	  7195:     movea.l D0,A0
02:0004B6C8 1010            	  7196:     move.b  (A0),D0
02:0004B6CA 0C000084        	  7197:     cmpi.b  #$84,D0
02:0004B6CE 6544            	  7198:     blo     _L_z07_P47_post2_ok
                            	  7199:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7200:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7201:     ; writes to the $05xx region.
02:0004B6D0 7800            	  7202:     moveq   #0,D4
                            	  7203: _L_z07_P47_fb_loop:
02:0004B6D2 41FAE584        	  7204:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004B6D6 12304000        	  7205:     move.b  (A0,D4.W),D1
02:0004B6DA 19410525        	  7206:     move.b  D1,($0525,A4)
                            	  7207:     ; Validate fallback cell walkable.
02:0004B6DE 7600            	  7208:     moveq   #0,D3
02:0004B6E0 1601            	  7209:     move.b  D1,D3
02:0004B6E2 0243000F        	  7210:     andi.w  #$000F,D3
02:0004B6E6 C6FC002C        	  7211:     mulu.w  #44,D3
02:0004B6EA 203C00FF6530    	  7212:     move.l  #$FF6530,D0
02:0004B6F0 D083            	  7213:     add.l   D3,D0
02:0004B6F2 7600            	  7214:     moveq   #0,D3
02:0004B6F4 1601            	  7215:     move.b  D1,D3
02:0004B6F6 E84B            	  7216:     lsr.w   #4,D3
02:0004B6F8 5943            	  7217:     subi.w  #4,D3
02:0004B6FA E34B            	  7218:     lsl.w   #1,D3
02:0004B6FC D083            	  7219:     add.l   D3,D0
02:0004B6FE 2040            	  7220:     movea.l D0,A0
02:0004B700 0C100084        	  7221:     cmpi.b  #$84,(A0)
02:0004B704 650E            	  7222:     blo     _L_z07_P47_post2_ok
02:0004B706 5204            	  7223:     addq.b  #1,D4
02:0004B708 0C040008        	  7224:     cmpi.b  #8,D4
02:0004B70C 65C4            	  7225:     blo     _L_z07_P47_fb_loop
                            	  7226:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7227:     ; rather than looping).
02:0004B70E 197C00480525    	  7228:     move.b  #$48,($0525,A4)
                            	  7229: _L_z07_P47_post2_ok:
                            	  7230:     ; Extract and set the monster's location.
                            	  7231:     ;
02:0004B714 102C0525        	  7232:     move.b  ($0525,A4),D0
