Source: "genesis_shell.asm"
                            	   747: 
                            	   748: ;==============================================================================
                            	   749: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   750: ;
                            	   751: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   752: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   753: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   754: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   755: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   756: ;
                            	   757: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   758: ;
                            	   759: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   760: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   761: ;==============================================================================
                            	   762:     ifne DEBUG_TELEPORT
                            	   763: _debug_teleport_check:
                            	   764:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   765:     tst.b   ($0010,A4)
                            	   766:     bne     .dtc_no
                            	   767:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   768:     cmpi.b  #$05,($0012,A4)
                            	   769:     bne     .dtc_no
                            	   770:     tst.b   ($0013,A4)
                            	   771:     bne     .dtc_no
                            	   772:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   773:     ;
                            	   774:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   775:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   776:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   777:     ; So the bit map is:
                            	   778:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   779:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   780:     move.b  ($00F8,A4),D1
                            	   781:     andi.b  #$0F,D1
                            	   782:     beq     .dtc_no
                            	   783:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   784:     moveq   #0,D0
                            	   785:     btst    #3,D1                   ; Up
                            	   786:     bne.s   .dtc_dir_set
                            	   787:     moveq   #1,D0
                            	   788:     btst    #2,D1                   ; Down
                            	   789:     bne.s   .dtc_dir_set
                            	   790:     moveq   #2,D0
                            	   791:     btst    #1,D1                   ; Left
                            	   792:     bne.s   .dtc_dir_set
                            	   793:     moveq   #3,D0                   ; Right (bit 0)
                            	   794: .dtc_dir_set:
                            	   795:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   796:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   797:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   798:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   799:     move.b  ($00EB,A4),D2
                            	   800:     move.b  D2,D3
                            	   801:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   802:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   803:     tst.b   D0
                            	   804:     bne.s   .dtc_not_up
                            	   805:     tst.b   D2
                            	   806:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   807:     bra.s   .dtc_apply
                            	   808: .dtc_not_up:
                            	   809:     cmpi.b  #1,D0
                            	   810:     bne.s   .dtc_not_down
                            	   811:     cmpi.b  #7,D2
                            	   812:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   813:     bra.s   .dtc_apply
                            	   814: .dtc_not_down:
                            	   815:     cmpi.b  #2,D0
                            	   816:     bne.s   .dtc_not_left
                            	   817:     tst.b   D3
                            	   818:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   819:     bra.s   .dtc_apply
                            	   820: .dtc_not_left:
                            	   821:     cmpi.b  #$0F,D3
                            	   822:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   823: .dtc_apply:
                            	   824:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   825:     lea     (NextRoomIdOffsets).l,A0
                            	   826:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   827:     move.b  ($00EB,A4),D0
                            	   828:     add.b   D1,D0
                            	   829:     move.b  D0,($00EB,A4)
                            	   830:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   831:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   832:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   833:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   834:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   835:     ; movement update doesn't immediately retrigger the edge.
                            	   836:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   837:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   838:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   839:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   840:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   841:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   842:     ; skip that setup.
                            	   843:     jsr     LayOutRoom
                            	   844:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   845:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   846:     ; kick that from here with arbitrary state causes crashes when the
                            	   847:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   848:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   849:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   850:     ; per target room.
                            	   851:     clr.b   ($00F8,A4)
                            	   852:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   853:                                          ; doesn't walk during sweep settle
                            	   854:     moveq   #1,D0
                            	   855:     rts
                            	   856: .dtc_edge:
                            	   857:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   858:     ; interpret it as "walk into wall" animation.
                            	   859:     clr.b   ($00F8,A4)
                            	   860:     clr.b   ($00FA,A4)
                            	   861:     moveq   #1,D0
                            	   862:     rts
                            	   863: .dtc_no:
                            	   864:     moveq   #0,D0
                            	   865:     rts
                            	   866:     endc
                            	   867: 
                            	   868: ;==============================================================================
                            	   869: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   870: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   871: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   872: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   873: ;==============================================================================
                            	   874:     ifne TURBO_LINK
                            	   875: _turbo_link_boost:
                            	   876:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   877:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   878:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   879:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:0004BBB2 4E75            	   880:     rts
                            	   881: _turbo_link_boost_disabled:
                            	   882:     ; OW gate
02:0004BBB4 4A2C0010        	   883:     tst.b   ($0010,A4)
02:0004BBB8 6670            	   884:     bne     .tlb_exit
                            	   885:     ; Mode 5 / Submode 0 only
02:0004BBBA 0C2C00050012    	   886:     cmpi.b  #$05,($0012,A4)
02:0004BBC0 6668            	   887:     bne     .tlb_exit
02:0004BBC2 4A2C0013        	   888:     tst.b   ($0013,A4)
02:0004BBC6 6662            	   889:     bne     .tlb_exit
                            	   890:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:0004BBC8 122C00FA        	   891:     move.b  ($00FA,A4),D1
02:0004BBCC 0201000F        	   892:     andi.b  #$0F,D1
02:0004BBD0 6758            	   893:     beq     .tlb_exit
                            	   894:     ; Edge-safe clamps.
02:0004BBD2 08010003        	   895:     btst    #3,D1                   ; Up (bit 3)
02:0004BBD6 6710            	   896:     beq     .tlb_no_up
02:0004BBD8 102C0084        	   897:     move.b  ($0084,A4),D0
02:0004BBDC 0C000040        	   898:     cmpi.b  #$40,D0
02:0004BBE0 6306            	   899:     bls     .tlb_no_up
02:0004BBE2 5900            	   900:     subi.b  #4,D0
02:0004BBE4 19400084        	   901:     move.b  D0,($0084,A4)
                            	   902: .tlb_no_up:
02:0004BBE8 08010002        	   903:     btst    #2,D1                   ; Down (bit 2)
02:0004BBEC 6710            	   904:     beq     .tlb_no_down
02:0004BBEE 102C0084        	   905:     move.b  ($0084,A4),D0
02:0004BBF2 0C0000D0        	   906:     cmpi.b  #$D0,D0
02:0004BBF6 6406            	   907:     bcc     .tlb_no_down
02:0004BBF8 5800            	   908:     addi.b  #4,D0
02:0004BBFA 19400084        	   909:     move.b  D0,($0084,A4)
                            	   910: .tlb_no_down:
02:0004BBFE 08010001        	   911:     btst    #1,D1                   ; Left (bit 1)
02:0004BC02 6710            	   912:     beq     .tlb_no_left
02:0004BC04 102C0070        	   913:     move.b  ($0070,A4),D0
02:0004BC08 0C00000A        	   914:     cmpi.b  #$0A,D0
02:0004BC0C 6306            	   915:     bls     .tlb_no_left
02:0004BC0E 5900            	   916:     subi.b  #4,D0
02:0004BC10 19400070        	   917:     move.b  D0,($0070,A4)
                            	   918: .tlb_no_left:
02:0004BC14 08010000        	   919:     btst    #0,D1                   ; Right (bit 0)
02:0004BC18 6710            	   920:     beq     .tlb_no_right
02:0004BC1A 102C0070        	   921:     move.b  ($0070,A4),D0
02:0004BC1E 0C0000E6        	   922:     cmpi.b  #$E6,D0
02:0004BC22 6406            	   923:     bcc     .tlb_no_right
02:0004BC24 5800            	   924:     addi.b  #4,D0
02:0004BC26 19400070        	   925:     move.b  D0,($0070,A4)
                            	   926: .tlb_no_right:
                            	   927: .tlb_exit:
02:0004BC2A 4E75            	   928:     rts
                            	   929:     endc
