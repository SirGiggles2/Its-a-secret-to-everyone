02:0003DB28 41EC0084        	  7890:     lea     ($0084,A4),A0
02:0003DB2C 10302000        	  7891:     move.b  (A0,D2.W),D0
02:0003DB30 023C00EE        	  7892:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DB34 122C0479        	  7893:     move.b  ($0479,A4),D1
02:0003DB38 D101            	  7894:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003DB3A 41EC0084        	  7895:     lea     ($0084,A4),A0
