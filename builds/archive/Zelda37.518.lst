                            	  7788: __far_z_04_0086:
                            	  7789:     ; State = 0.
                            	  7790:     ;
                            	  7791:     ; If the current object slot is 2, then go initialize the patra child.
                            	  7792:     ; This is the only patra child shown in the first fame.
                            	  7793:     ;
02:0003DA7A 0C020002        	  7794:     cmpi.b  #$02,D2
02:0003DA7E 6732            	  7795:     beq  _L_z04_UpdatePatraChild_Ready
                            	  7796:     ; The patra child in slot 2 is the last one to be updated.
                            	  7797:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  7798:     ;
                            	  7799:     ; This means that in the first frame, slot 2 is the only one to be
                            	  7800:     ; shown.
                            	  7801:     ;
02:0003DA80 102C00AE        	  7802:     move.b  ($00AE,A4),D0
02:0003DA84 6700008E        	  7803:     beq  _L_z04_UpdatePatraChild_Exit
                            	  7804:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  7805:     ; here to wait to be shown at the top position (N) one at a time.
                            	  7806:     ;
02:0003DA88 1002            	  7807:     move.b  D2,D0
                            	  7808:     ; Subtract 3 from the object slot to get the angle where the
                            	  7809:     ; patra child in object slot 2 should be for the current one to appear.
                            	  7810:     ;
02:0003DA8A 003C0011        	  7811:     ori     #$11,CCR  ; SEC: set C+X
02:0003DA8E 123C0003        	  7812:     move.b  #$03,D1
02:0003DA92 0A3C0010        	  7813:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DA96 9101            	  7814:     subx.b  D1,D0   ; SBC #$03
02:0003DA98 0A3C0010        	  7815:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DA9C 7600            	  7816:     moveq   #0,D3
02:0003DA9E 1600            	  7817:     move.b  D0,D3
                            	  7818:     ; If the patra child in slot 2 has not reached the required angle,
                            	  7819:     ; then return.
                            	  7820:     ;
02:0003DAA0 102C0396        	  7821:     move.b  ($0396,A4),D0
02:0003DAA4 41F90003DA5E    	  7822:     lea     (PatraChildStartAngles).l,A0
02:0003DAAA 12303000        	  7823:     move.b  (A0,D3.W),D1
02:0003DAAE B001            	  7824:     cmp.b   D1,D0
02:0003DAB0 6662            	  7825:     bne  _L_z04_UpdatePatraChild_Exit
                            	  7826:     even
