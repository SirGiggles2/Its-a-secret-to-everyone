02:0003D268 12302000        	  6733:     move.b  (A0,D2.W),D1
02:0003D26C D101            	  6734:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003D26E 02000001        	  6735:     andi.b #$01,D0
02:0003D272 023C00EE        	  6736:     andi    #$EE,CCR  ; CLC: clear C+X
