                            	  4986: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  4987:     ; Bloated timer =>
                            	  4988:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  4989:     ; 1:     go advance the substate
                            	  4990:     ; other: go decrement Bloated timer
                            	  4991:     ;
02:0003C554 7600            	  4992:     moveq   #0,D3
02:0003C556 41EC045E        	  4993:     lea     ($045E,A4),A0
02:0003C55A 16302000        	  4994:     move.b  (A0,D2.W),D3
02:0003C55E 5303            	  4995:     subq.b  #1,D3
02:0003C560 6750            	  4996:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003C562 6B04            	  4997:     bmi.s  __far_z_04_0043
02:0003C564 60000080        	  4998:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  4999: __far_z_04_0043:
                            	  5000:     ; Set the bloated timer according to the substate.
                            	  5001:     ;
