02:0003BE8A 41EC034F        	  6130:     lea     ($034F,A4),A0
02:0003BE8E 11802000        	  6131:     move.b  D0,(A0,D2.W)
02:0003BE92 101D            	  6132:     move.b  (A5)+,D0  ; PLA
02:0003BE94 41EC046B        	  6133:     lea     ($046B,A4),A0
02:0003BE98 11802000        	  6134:     move.b  D0,(A0,D2.W)
                            	  6135:     ; Restore the original coordinates.
                            	  6136:     ;
02:0003BE9C 101D            	  6137:     move.b  (A5)+,D0  ; PLA
02:0003BE9E 41EC0084        	  6138:     lea     ($0084,A4),A0
02:0003BEA2 11802000        	  6139:     move.b  D0,(A0,D2.W)
02:0003BEA6 101D            	  6140:     move.b  (A5)+,D0  ; PLA
