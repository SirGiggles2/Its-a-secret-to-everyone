02:0004ACD4 41EC034F        	  3260:     lea     ($034F,A4),A0
02:0004ACD8 10302000        	  3261:     move.b  (A0,D2.W),D0
02:0004ACDC 674A            	  3262:     beq  _L_z07_BeginUpdateWorld_NextObject
02:0004ACDE 41EC034F        	  3263:     lea     ($034F,A4),A0
02:0004ACE2 10302000        	  3264:     move.b  (A0,D2.W),D0
02:0004ACE6 6100194E        	  3265:     jsr     UpdateObject
