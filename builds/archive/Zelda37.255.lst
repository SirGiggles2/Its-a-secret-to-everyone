02:0003CB52 6624            	  7866:     bne  _L_z04_UpdateLikeLike_Draw
02:0003CB54 7008            	  7867:     moveq   #8,D0
02:0003CB56 41EC03D0        	  7868:     lea     ($03D0,A4),A0
02:0003CB5A 11802000        	  7869:     move.b  D0,(A0,D2.W)
02:0003CB5E 7600            	  7870:     moveq   #0,D3
02:0003CB60 41EC03E4        	  7871:     lea     ($03E4,A4),A0
02:0003CB64 16302000        	  7872:     move.b  (A0,D2.W),D3
02:0003CB68 5203            	  7873:     addq.b  #1,D3
02:0003CB6A 1003            	  7874:     move.b  D3,D0
02:0003CB6C 02000003        	  7875:     andi.b #$03,D0
02:0003CB70 41EC03E4        	  7876:     lea     ($03E4,A4),A0
02:0003CB74 11802000        	  7877:     move.b  D0,(A0,D2.W)
                            	  7878:     even
