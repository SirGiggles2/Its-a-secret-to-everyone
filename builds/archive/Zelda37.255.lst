02:0004BF46 5303            	  6028:     subq.b  #1,D3
02:0004BF48 66F2            	  6029:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004BF4A 1880            	  6030:     move.b  D0,($0000,A4)
                            	  6031:     ; Set object's direction to player's. It might have changed
                            	  6032:     ; since the last frame.
