                            	   544: _anon_z05_6:
02:0003FC22 7400            	   545:     moveq   #0,D2
02:0003FC24 41F90003FBD8    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0003FC2A 14303000        	   547:     move.b  (A0,D3.W),D2
02:0003FC2E 41F90003FC08    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0003FC34 10303000        	   549:     move.b  (A0,D3.W),D0
02:0003FC38 41F900046C30    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
