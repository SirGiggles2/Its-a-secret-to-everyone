02:00031B68 60000102        	  5372:     jmp  L74D8_Exit
                            	  5373: __far_z_01_0053:
                            	  5374:     ; If the weapon is a boomerang ...
                            	  5375:     ;
02:00031B6C 0C03000F        	  5376:     cmpi.b  #$0F,D3
