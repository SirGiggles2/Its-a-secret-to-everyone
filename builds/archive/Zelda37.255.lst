                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:0004309C 1014            	  5783:     move.b  ($0000,A4),D0
02:0004309E 41EC0302        	  5784:     lea     ($0302,A4),A0
02:000430A2 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:000430A6 5202            	  5786:     addq.b  #1,D2
02:000430A8 102C0001        	  5787:     move.b  ($0001,A4),D0
02:000430AC 41EC0302        	  5788:     lea     ($0302,A4),A0
