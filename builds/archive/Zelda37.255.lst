02:0002BFAE 670A            	  2290:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2291:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2292:     eori    #$01,CCR
02:0002BFB8 4E75            	  2293:     rts
                            	  2294: .cc_cnras:
02:0002BFBA 023C00FE        	  2295:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2296:     eori    #$01,CCR
02:0002BFC2 4E75            	  2297:     rts
