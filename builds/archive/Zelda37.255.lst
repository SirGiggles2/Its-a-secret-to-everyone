                            	  3821: UpdateArmos:
02:0003ADC2 6100E830        	  3822:     jsr     UpdateGoriya
                            	  3823:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3824:     ;
02:0003ADC6 41EC00C0        	  3825:     lea     ($00C0,A4),A0
02:0003ADCA 10302000        	  3826:     move.b  (A0,D2.W),D0
02:0003ADCE 6702            	  3827:     beq.s  __far_z_04_0033
02:0003ADD0 602A            	  3828:     jmp  DrawArmosAndCheckCollisions
                            	  3829: __far_z_04_0033:
                            	  3830:     ; Animate.
                            	  3831:     ;
                            	  3832:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3833:     ; then only go draw.
                            	  3834:     ;
02:0003ADD2 41EC03D0        	  3835:     lea     ($03D0,A4),A0
02:0003ADD6 53302000        	  3836:     subq.b  #1,(A0,D2.W)
02:0003ADDA 6702            	  3837:     beq.s  __far_z_04_0034
02:0003ADDC 601E            	  3838:     jmp  DrawArmosAndCheckCollisions
                            	  3839: __far_z_04_0034:
                            	  3840:     ; Armos animation frames last 6 screen frames.
                            	  3841:     ;
02:0003ADDE 7006            	  3842:     moveq   #6,D0
02:0003ADE0 41EC03D0        	  3843:     lea     ($03D0,A4),A0
02:0003ADE4 11802000        	  3844:     move.b  D0,(A0,D2.W)
                            	  3845:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3846:     ; change the position of the shield. To keep fixed it in place,
                            	  3847:     ; there are separate frame images for each animation frame.
                            	  3848:     ;
                            	  3849:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3850:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3851:     ;
                            	  3852:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3853:     ; Then choose the direction at the point of drawing below.
                            	  3854:     ;
02:0003ADE8 41EC03E4        	  3855:     lea     ($03E4,A4),A0
02:0003ADEC 10302000        	  3856:     move.b  (A0,D2.W),D0
02:0003ADF0 0A000002        	  3857:     eori.b #$02,D0
02:0003ADF4 41EC03E4        	  3858:     lea     ($03E4,A4),A0
02:0003ADF8 11802000        	  3859:     move.b  D0,(A0,D2.W)
                            	  3860:     even
                            	  3861: DrawArmosAndCheckCollisions:
02:0003ADFC 4EB90004C53C    	  3862:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003AE02 7600            	  3863:     moveq   #0,D3
02:0003AE04 41EC0098        	  3864:     lea     ($0098,A4),A0
02:0003AE08 16302000        	  3865:     move.b  (A0,D2.W),D3
                            	  3866:     ; If facing up, then use the second frame image in the set ("back").
                            	  3867:     ; Else use the second.
                            	  3868:     ;
02:0003AE0C 0C030008        	  3869:     cmpi.b  #$08,D3
02:0003AE10 6602            	  3870:     bne  _anon_z04_54
02:0003AE12 7001            	  3871:     moveq   #1,D0
                            	  3872: _anon_z04_54:
02:0003AE14 023C00EE        	  3873:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE18 41EC03E4        	  3874:     lea     ($03E4,A4),A0
02:0003AE1C 12302000        	  3875:     move.b  (A0,D2.W),D1
02:0003AE20 D101            	  3876:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003AE22 4EB9000313EE    	  3877:     jsr     DrawObjectNotMirrored
                            	  3878:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3879:     ; but not with weapons.
                            	  3880:     ;
02:0003AE28 10342028        	  3881:     move.b  ($28,A4,D2.W),D0
02:0003AE2C 661C            	  3882:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3883:     ; Else check for all collisions.
                            	  3884:     ;
02:0003AE2E 4EB90003176A    	  3885:     jsr     CheckMonsterCollisions
                            	  3886:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3887:     ;
02:0003AE34 41EC0405        	  3888:     lea     ($0405,A4),A0
02:0003AE38 10302000        	  3889:     move.b  (A0,D2.W),D0
02:0003AE3C 670A            	  3890:     beq  _anon_z04_55
02:0003AE3E 705D            	  3891:     moveq   #93,D0
02:0003AE40 41EC034F        	  3892:     lea     ($034F,A4),A0
02:0003AE44 11802000        	  3893:     move.b  D0,(A0,D2.W)
                            	  3894: _anon_z04_55:
02:0003AE48 4E75            	  3895:     rts
                            	  3896: 
                            	  3897:     even
                            	  3898: _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision:
02:0003AE4A 4EF9000318B4    	  3899:     jmp     CheckLinkCollision
                            	  3900: 
                            	  3901:     even
                            	  3902: UpdatePondFairy:
02:0003AE50 610045AC        	  3903:     jsr     DrawFairy
                            	  3904:     ; If not in state 0, then go handle states 1 to 3.
                            	  3905:     ;
02:0003AE54 102C00AD        	  3906:     move.b  ($00AD,A4),D0
02:0003AE58 6702            	  3907:     beq.s  __far_z_04_0035
02:0003AE5A 602A            	  3908:     jmp  PondFairy_HandleOtherStates
                            	  3909: __far_z_04_0035:
                            	  3910:     ; State 0.
                            	  3911:     ;
                            	  3912:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3913:     ;
02:0003AE5C 102C0084        	  3914:     move.b  ($0084,A4),D0
02:0003AE60 0C0000AD        	  3915:     cmpi.b  #$AD,D0
02:0003AE64 661E            	  3916:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3917:     ; If Link's X < $70 or >= $81, then return.
                            	  3918:     ;
02:0003AE66 102C0070        	  3919:     move.b  ($0070,A4),D0
02:0003AE6A 0C000070        	  3920:     cmpi.b  #$70,D0
02:0003AE6E 6514            	  3921:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003AE70 0C000081        	  3922:     cmpi.b  #$81,D0
02:0003AE74 640E            	  3923:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3924:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3925:     ; halt Link, and start filling hearts.
                            	  3926:     ;
02:0003AE76 522C00AD        	  3927:     addq.b  #1,($00AD,A4)
02:0003AE7A 7040            	  3928:     moveq   #64,D0
02:0003AE7C 194000AC        	  3929:     move.b  D0,($00AC,A4)
02:0003AE80 19400063        	  3930:     move.b  D0,($0063,A4)
                            	  3931:     even
                            	  3932: _L_z04_UpdatePondFairy_Exit:
02:0003AE84 4E75            	  3933:     rts
                            	  3934: 
                            	  3935:     even
                            	  3936: PondFairy_HandleOtherStates:
02:0003AE86 0C000001        	  3937:     cmpi.b  #$01,D0
02:0003AE8A 6610            	  3938:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3939:     ; State 1. Flying and filling hearts.
                            	  3940:     ;
                            	  3941:     ; If still filling hearts, then go draw Link and hearts.
                            	  3942:     ;
02:0003AE8C 102C0063        	  3943:     move.b  ($0063,A4),D0
02:0003AE90 6620            	  3944:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3945:     ; If not filling hearts anymore, then go to state 2,
                            	  3946:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3947:     ; a little while after we finish filling hearts.
                            	  3948:     ;
02:0003AE92 522C00AD        	  3949:     addq.b  #1,($00AD,A4)
02:0003AE96 7050            	  3950:     moveq   #80,D0
02:0003AE98 19400029        	  3951:     move.b  D0,($0029,A4)
                            	  3952:     even
                            	  3953: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3954:     ; If state <> 2 (so, it's 3), then return.
                            	  3955:     ;
                            	  3956:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3957:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3958:     ; was set to, and we'll return.
                            	  3959:     ;
02:0003AE9C 0C000002        	  3960:     cmpi.b  #$02,D0
02:0003AEA0 6634            	  3961:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3962:     ; State = 2.
                            	  3963:     ;
                            	  3964:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3965:     ;
02:0003AEA2 102C0029        	  3966:     move.b  ($0029,A4),D0
02:0003AEA6 660A            	  3967:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3968:     ; Else go to state 3, and unhalt Link.
                            	  3969:     ;
02:0003AEA8 522C00AD        	  3970:     addq.b  #1,($00AD,A4)
02:0003AEAC 7000            	  3971:     moveq   #0,D0
02:0003AEAE 194000AC        	  3972:     move.b  D0,($00AC,A4)
                            	  3973:     even
                            	  3974: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  3975:     ; TODO: but why, since Link is halted?
                            	  3976:     ;
                            	  3977:     ; Reset the input direction, so that Link doesn't animate
                            	  3978:     ; when drawing him.
02:0003AEB2 7600            	  3979:     moveq   #0,D3
02:0003AEB4 194303F8        	  3980:     move.b  D3,($03F8,A4)
                            	  3981:     ; Save and reset Link's state.
                            	  3982:     ;
                            	  3983:     ; TODO: but why, since Link is halted?
                            	  3984:     ;
02:0003AEB8 102C00AC        	  3985:     move.b  ($00AC,A4),D0
02:0003AEBC 1B00            	  3986:     move.b  D0,-(A5)  ; PHA
02:0003AEBE 194300AC        	  3987:     move.b  D3,($00AC,A4)
02:0003AEC2 4EB90004B450    	  3988:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  3989:     ; Restore Link's state.
                            	  3990:     ;
02:0003AEC8 101D            	  3991:     move.b  (A5)+,D0  ; PLA
02:0003AECA 194000AC        	  3992:     move.b  D0,($00AC,A4)
02:0003AECE 6110            	  3993:     jsr     PondFairy_MoveHearts
                            	  3994:     ; Restore the object slot.
                            	  3995:     ;
02:0003AED0 7400            	  3996:     moveq   #0,D2
02:0003AED2 142C0340        	  3997:     move.b  ($0340,A4),D2
                            	  3998:     even
                            	  3999: _L_z04_PondFairy_HandleOtherStates_Exit:
02:0003AED6 4E75            	  4000:     rts
                            	  4001: 
                            	  4002:     even
                            	  4003: PondHeartStartAngles:
02:0003AED8 14              	  4004:     dc.b    $14, $10, $0C, $08, $04, $00, $1C
02:0003AED9 10
02:0003AEDA 0C
02:0003AEDB 08
02:0003AEDC 04
02:0003AEDD 00
02:0003AEDE 1C
                            	  4005: 
                            	  4006:     even
                            	  4007: PondFairy_MoveHearts:
                            	  4008:     ; Loop over each heart from object slot 2 to 9.
                            	  4009:     ;
                            	  4010:     ; Even though they are not standalone objects, their info
                            	  4011:     ; is stored in those object slots.
                            	  4012:     ;
02:0003AEE0 7402            	  4013:     moveq   #2,D2
                            	  4014:     even
                            	  4015: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4016:     ; If the current heart's state <> 0, then go move it.
                            	  4017:     ; Else we have to wait for it to come out at the right time.
                            	  4018:     ;
02:0003AEE2 41EC00AC        	  4019:     lea     ($00AC,A4),A0
02:0003AEE6 10302000        	  4020:     move.b  (A0,D2.W),D0
02:0003AEEA 667C            	  4021:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4022:     ; The current heart's state = 0.
                            	  4023:     ;
                            	  4024:     ; If object slot = 2, then go make it appear. This is the first
                            	  4025:     ; heart to show up.
                            	  4026:     ;
02:0003AEEC 0C020002        	  4027:     cmpi.b  #$02,D2
02:0003AEF0 6732            	  4028:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4029:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4030:     ; go start over.
                            	  4031:     ;
                            	  4032:     ; TODO:
                            	  4033:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4034:     ;
02:0003AEF2 102C00AE        	  4035:     move.b  ($00AE,A4),D0
02:0003AEF6 67EA            	  4036:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4037:     ; Look up the starting angle of this heart with the index
                            	  4038:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4039:     ; then loop again.
                            	  4040:     ;
02:0003AEF8 1002            	  4041:     move.b  D2,D0
02:0003AEFA 003C0011        	  4042:     ori     #$11,CCR  ; SEC: set C+X
02:0003AEFE 123C0003        	  4043:     move.b  #$03,D1
02:0003AF02 0A3C0010        	  4044:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AF06 9101            	  4045:     subx.b  D1,D0   ; SBC #$03
02:0003AF08 0A3C0010        	  4046:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AF0C 7600            	  4047:     moveq   #0,D3
02:0003AF0E 1600            	  4048:     move.b  D0,D3
02:0003AF10 102C0396        	  4049:     move.b  ($0396,A4),D0
02:0003AF14 41F90003AED8    	  4050:     lea     (PondHeartStartAngles).l,A0
02:0003AF1A 12303000        	  4051:     move.b  (A0,D3.W),D1
02:0003AF1E B001            	  4052:     cmp.b   D1,D0
02:0003AF20 66000086        	  4053:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4054:     even
