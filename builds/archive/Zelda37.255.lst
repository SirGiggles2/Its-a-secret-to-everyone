02:00034148 19400438        	  1707:     move.b  D0,($0438,A4)
02:0003414C 0C03000E        	  1708:     cmpi.b  #$0E,D3
02:00034150 650E            	  1709:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
