02:00044AEC 194000EB        	  8754:     move.b  D0,($00EB,A4)
02:00044AF0 101D            	  8755:     move.b  (A5)+,D0  ; PLA
02:00044AF2 7600            	  8756:     moveq   #0,D3
02:00044AF4 1600            	  8757:     move.b  D0,D3
                            	  8758:     ; The map marks are arranged in the same order as all the
                            	  8759:     ; possible values of OpenDoorMask.
                            	  8760:     ;
                            	  8761:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8762:     ; dynamic transfer buf at the current offset.
                            	  8763:     ;
02:00044AF6 102C033F        	  8764:     move.b  ($033F,A4),D0
02:00044AFA 023C00EE        	  8765:     andi    #$EE,CCR  ; CLC: clear C+X
02:00044AFE 123C00E2        	  8766:     move.b  #$E2,D1
02:00044B02 D101            	  8767:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00044B04 41EC0304        	  8768:     lea     ($0304,A4),A0
02:00044B08 11803000        	  8769:     move.b  D0,(A0,D3.W)
02:00044B0C 4E75            	  8770:     rts
                            	  8771: 
                            	  8772: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8773: ; based on doorway type and room flags. Each call will shift the next
                            	  8774: ; doorway state bit into OpenDoorwayMask.
                            	  8775: ;
                            	  8776: ; Params:
                            	  8777: ; A: door attribute
                            	  8778: ; X: direction index
                            	  8779: ;
                            	  8780: ; Returns:
                            	  8781: ; A: untouched
                            	  8782: ;
                            	  8783:     even
