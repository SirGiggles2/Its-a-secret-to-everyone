02:0003A64C 003C0011        	  2770:     ori     #$11,CCR  ; SEC: set C+X
02:0003A650 123C0040        	  2771:     move.b  #$40,D1
02:0003A654 0A3C0010        	  2772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
