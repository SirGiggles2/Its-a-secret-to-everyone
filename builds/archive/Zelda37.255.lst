                            	  4488:     ; Set the dock object's X.
                            	  4489:     ;
02:0003B22C 19802070        	  4490:     move.b  D0,($70,A4,D2.W)
                            	  4491:     ; Determine whether Link is coming or going.
                            	  4492:     ; If Y = $3D, then he's at the top edge of the screen. Use state 1.
                            	  4493:     ;
02:0003B230 7601            	  4494:     moveq   #1,D3
02:0003B232 102C0084        	  4495:     move.b  ($0084,A4),D0
02:0003B236 0C00003D        	  4496:     cmpi.b  #$3D,D0
02:0003B23A 6708            	  4497:     beq  _L_z04_UpdateDock_SetState
                            	  4498:     ; But if Y = $7D, then he's at the dock. Use state 2.
                            	  4499:     ; Otherwise, return.
                            	  4500:     ;
02:0003B23C 5203            	  4501:     addq.b  #1,D3
02:0003B23E 0C00007D        	  4502:     cmpi.b  #$7D,D0
