02:0004A5C2 142C0301        	  2365:     move.b  ($0301,A4),D2
                            	  2366:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2367:     ;
                            	  2368:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2369:     ; In total, 11 bytes will be written.
                            	  2370:     ;
                            	  2371:     ; First, write the high byte of PPU address in each record.
                            	  2372:     ;
02:0004A5C6 1014            	  2373:     move.b  ($0000,A4),D0
02:0004A5C8 41EC0302        	  2374:     lea     ($0302,A4),A0
02:0004A5CC 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004A5D0 41EC0307        	  2376:     lea     ($0307,A4),A0
02:0004A5D4 11802000        	  2377:     move.b  D0,(A0,D2.W)
                            	  2378:     ; Write the low address in the first record. In the second record,
                            	  2379:     ; write (low address + 1).
                            	  2380:     ;
02:0004A5D8 102C0001        	  2381:     move.b  ($0001,A4),D0
02:0004A5DC 41EC0303        	  2382:     lea     ($0303,A4),A0
02:0004A5E0 11802000        	  2383:     move.b  D0,(A0,D2.W)
02:0004A5E4 41EC0308        	  2384:     lea     ($0308,A4),A0
02:0004A5E8 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:0004A5EC 41EC0308        	  2386:     lea     ($0308,A4),A0
02:0004A5F0 52302000        	  2387:     addq.b  #1,(A0,D2.W)
                            	  2388:     ; Write the first tile twice in each record. Patch them later.
                            	  2389:     ;
02:0004A5F4 102C0005        	  2390:     move.b  ($0005,A4),D0
02:0004A5F8 41EC0305        	  2391:     lea     ($0305,A4),A0
02:0004A5FC 11802000        	  2392:     move.b  D0,(A0,D2.W)
02:0004A600 41EC0306        	  2393:     lea     ($0306,A4),A0
02:0004A604 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:0004A608 41EC030A        	  2395:     lea     ($030A,A4),A0
02:0004A60C 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:0004A610 41EC030B        	  2397:     lea     ($030B,A4),A0
02:0004A614 11802000        	  2398:     move.b  D0,(A0,D2.W)
                            	  2399:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2400:     ; Add 1 more to the second byte in each record.
                            	  2401:     ; Here is an example result of this manipulation:
                            	  2402:     ;   record 1: $70, $71
                            	  2403:     ;   record 2: $72, $73
                            	  2404:     ;
02:0004A618 0C000046        	  2405:     cmpi.b  #$46,D0
02:0004A61C 6530            	  2406:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004A61E 0C0000F3        	  2407:     cmpi.b  #$F3,D0
02:0004A622 642A            	  2408:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004A624 023C00EE        	  2409:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A628 123C0002        	  2410:     move.b  #$02,D1
02:0004A62C D101            	  2411:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004A62E 41EC030A        	  2412:     lea     ($030A,A4),A0
02:0004A632 11802000        	  2413:     move.b  D0,(A0,D2.W)
02:0004A636 41EC030B        	  2414:     lea     ($030B,A4),A0
02:0004A63A 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:0004A63E 41EC0306        	  2416:     lea     ($0306,A4),A0
02:0004A642 52302000        	  2417:     addq.b  #1,(A0,D2.W)
02:0004A646 41EC030B        	  2418:     lea     ($030B,A4),A0
02:0004A64A 52302000        	  2419:     addq.b  #1,(A0,D2.W)
