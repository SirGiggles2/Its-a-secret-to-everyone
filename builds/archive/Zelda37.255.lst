02:00044AE2 E209            	  8746:     lsr.b  #1,D1   ; LSR $02
02:00044AE4 19410002        	  8747:     move.b  D1,($0002,A4)
02:00044AE8 66EC            	  8748:     bne  _anon_z05_204
