02:0003AFFE D101            	  4169:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003B000 003C0011        	  4170:     ori     #$11,CCR  ; SEC: set C+X
02:0003B004 41EC0084        	  4171:     lea     ($0084,A4),A0
02:0003B008 12302000        	  4172:     move.b  (A0,D2.W),D1
02:0003B00C 0A3C0010        	  4173:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B010 9101            	  4174:     subx.b  D1,D0   ; SBC ObjY,X
02:0003B012 0A3C0010        	  4175:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B016 6A0E            	  4176:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  4177:     ; Else negate it, and indicate Link is "up" from the object.
                            	  4178:     ;
