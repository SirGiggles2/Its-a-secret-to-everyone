                            	 11421:     even
                            	 11422: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003E62A 10342070        	 11423:     move.b  ($70,A4,D2.W),D0
02:0003E62E 1B00            	 11424:     move.b  D0,-(A5)  ; PHA
                            	 11425:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11426:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11427:     ;
02:0003E630 023C00EE        	 11428:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E634 123C0004        	 11429:     move.b  #$04,D1
02:0003E638 D101            	 11430:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E63A 19802070        	 11431:     move.b  D0,($70,A4,D2.W)
                            	 11432:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11433:     ; to store in [03].
                            	 11434:     ;
02:0003E63E 102C04E6        	 11435:     move.b  ($04E6,A4),D0
02:0003E642 0A000003        	 11436:     eori.b #$03,D0
02:0003E646 19400003        	 11437:     move.b  D0,($0003,A4)
                            	 11438:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11439:     ;
02:0003E64A 103C009E        	 11440:     move.b  #$9E,D0
02:0003E64E 0C020005        	 11441:     cmpi.b  #$05,D2
02:0003E652 670A            	 11442:     beq  _L_z04_UpdateLamnola_Draw
02:0003E654 0C02000A        	 11443:     cmpi.b  #$0A,D2
02:0003E658 6704            	 11444:     beq  _L_z04_UpdateLamnola_Draw
02:0003E65A 103C00A0        	 11445:     move.b  #$A0,D0
                            	 11446:     even
                            	 11447: _L_z04_UpdateLamnola_Draw:
02:0003E65E 4EB9000316EA    	 11448:     jsr     Anim_WriteSprite
02:0003E664 101D            	 11449:     move.b  (A5)+,D0  ; PLA
02:0003E666 19802070        	 11450:     move.b  D0,($70,A4,D2.W)
02:0003E66A 41EC0098        	 11451:     lea     ($0098,A4),A0
02:0003E66E 10302000        	 11452:     move.b  (A0,D2.W),D0
02:0003E672 1B00            	 11453:     move.b  D0,-(A5)  ; PHA
02:0003E674 4EB90003176A    	 11454:     jsr     CheckMonsterCollisions
02:0003E67A 101D            	 11455:     move.b  (A5)+,D0  ; PLA
02:0003E67C 41EC0098        	 11456:     lea     ($0098,A4),A0
02:0003E680 11802000        	 11457:     move.b  D0,(A0,D2.W)
                            	 11458:     ; If still alive, then return.
                            	 11459:     ;
02:0003E684 41EC0405        	 11460:     lea     ($0405,A4),A0
02:0003E688 10302000        	 11461:     move.b  (A0,D2.W),D0
