02:00039C4E 123C002B        	  1282:     move.b  #$2B,D1
02:00039C52 0A3C0010        	  1283:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039C56 9101            	  1284:     subx.b  D1,D0   ; SBC #$2B
02:00039C58 0A3C0010        	  1285:     eori    #$10,CCR  ; restore X = 6502 C
02:00039C5C 6008            	  1286:     jmp     _L_z04_UpdateBubble_Animate
