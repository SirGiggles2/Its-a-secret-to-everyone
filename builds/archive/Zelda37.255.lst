02:000301BC D101            	  1846:     addx.b  D1,D0   ; ADC CurObjIndex
02:000301BE 7400            	  1847:     moveq   #0,D2
02:000301C0 1400            	  1848:     move.b  D0,D2
                            	  1849:     ; Look up and set the location for this iteration's individual trap.
                            	  1850:     ;
02:000301C2 41F900030186    	  1851:     lea     (TrapXs).l,A0
02:000301C8 10303000        	  1852:     move.b  (A0,D3.W),D0
02:000301CC 19802070        	  1853:     move.b  D0,($70,A4,D2.W)
02:000301D0 41F90003018C    	  1854:     lea     (TrapYs).l,A0
02:000301D6 10303000        	  1855:     move.b  (A0,D3.W),D0
02:000301DA 41EC0084        	  1856:     lea     ($0084,A4),A0
02:000301DE 11802000        	  1857:     move.b  D0,(A0,D2.W)
02:000301E2 619E            	  1858:     jsr     InitOneSimpleObject
02:000301E4 5302            	  1859:     subq.b  #1,D2
02:000301E6 5303            	  1860:     subq.b  #1,D3
