02:000302B6 1940000F        	  1972:     move.b  D0,($000F,A4)
02:000302BA 4EB90004B1C4    	  1973:     jsr     MoveObject
                            	  1974:     ; Truncate the grid offset to square length ($10).
                            	  1975:     ;
02:000302C0 41EC0394        	  1976:     lea     ($0394,A4),A0
02:000302C4 10302000        	  1977:     move.b  (A0,D2.W),D0
02:000302C8 0200000F        	  1978:     andi.b #$0F,D0
02:000302CC 6608            	  1979:     bne  _anon_z01_28
02:000302CE 41EC0394        	  1980:     lea     ($0394,A4),A0
02:000302D2 11802000        	  1981:     move.b  D0,(A0,D2.W)
                            	  1982: _anon_z01_28:
                            	  1983:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  1984:     ;
02:000302D6 610015DC        	  1985:     jsr     CheckLinkCollision
                            	  1986:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  1987:     ; and current coordinate to the trap's X.
                            	  1988:     ;
02:000302DA 7600            	  1989:     moveq   #0,D3
02:000302DC 16342070        	  1990:     move.b  ($70,A4,D2.W),D3
