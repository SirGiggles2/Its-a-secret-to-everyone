02:0003EB4A 11802000        	 12137:     move.b  D0,(A0,D2.W)
02:0003EB4E 611C            	 12138:     jsr     PatraChild_Draw
                            	 12139:     ; If Patra's state still = 0, then the last patra child has not
                            	 12140:     ; shown up yet. In this case don't check collisions yet, only return.
                            	 12141:     ;
02:0003EB50 102C00AD        	 12142:     move.b  ($00AD,A4),D0
02:0003EB54 6714            	 12143:     beq  _L_z04_PatraChild_State1_Exit
02:0003EB56 4EB90003176A    	 12144:     jsr     CheckMonsterCollisions
                            	 12145:     ; If the monster died, then change to the dead dummy object.
                            	 12146:     ;
02:0003EB5C 41EC0405        	 12147:     lea     ($0405,A4),A0
02:0003EB60 10302000        	 12148:     move.b  (A0,D2.W),D0
02:0003EB64 6704            	 12149:     beq  _L_z04_PatraChild_State1_Exit
02:0003EB66 6100FA94        	 12150:     jsr     SetDeadDummyObjType
                            	 12151:     even
