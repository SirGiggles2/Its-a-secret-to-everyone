                            	 11535:     ; If X coordinate is not a multiple of 8, then return.
                            	 11536:     ;
02:0003E714 10342070        	 11537:     move.b  ($70,A4,D2.W),D0
02:0003E718 02000007        	 11538:     andi.b #$07,D0
02:0003E71C 6702            	 11539:     beq.s  __far_z_04_0112
02:0003E71E 60F2            	 11540:     jmp  L12A6F_Exit
                            	 11541: __far_z_04_0112:
                            	 11542:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11543:     ; We had to account for the usual offset of 3.
                            	 11544:     ;
02:0003E720 41EC0084        	 11545:     lea     ($0084,A4),A0
02:0003E724 10302000        	 11546:     move.b  (A0,D2.W),D0
02:0003E728 023C00EE        	 11547:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E72C 123C0003        	 11548:     move.b  #$03,D1
02:0003E730 D101            	 11549:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E732 02000007        	 11550:     andi.b #$07,D0
02:0003E736 6702            	 11551:     beq.s  __far_z_04_0113
02:0003E738 60D8            	 11552:     jmp  L12A6F_Exit
                            	 11553: __far_z_04_0113:
                            	 11554:     ; Will loop 4 times, propagating directions down the chain,
                            	 11555:     ; by pulling from the bottom.
                            	 11556:     ;
02:0003E73A 7004            	 11557:     moveq   #4,D0
02:0003E73C 1880            	 11558:     move.b  D0,($0000,A4)
                            	 11559:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11560:     ;
02:0003E73E 7600            	 11561:     moveq   #0,D3
02:0003E740 0C020005        	 11562:     cmpi.b  #$05,D2
02:0003E744 6702            	 11563:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003E746 7605            	 11564:     moveq   #5,D3
                            	 11565:     even
                            	 11566: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11567:     ; Loop over every segment under the head, starting from the tail.
                            	 11568:     ; Copy the next segment's direction to the current one in this loop.
                            	 11569:     ;
02:0003E748 41EC009A        	 11570:     lea     ($009A,A4),A0
02:0003E74C 10303000        	 11571:     move.b  (A0,D3.W),D0
02:0003E750 41EC0099        	 11572:     lea     ($0099,A4),A0
02:0003E754 11803000        	 11573:     move.b  D0,(A0,D3.W)
02:0003E758 5203            	 11574:     addq.b  #1,D3
02:0003E75A 5314            	 11575:     subq.b  #1,($0000,A4)
02:0003E75C 66EA            	 11576:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11577:     ; If this head segment is not aligned with a square, then return.
                            	 11578:     ;
02:0003E75E 10342070        	 11579:     move.b  ($70,A4,D2.W),D0
02:0003E762 0200000F        	 11580:     andi.b #$0F,D0
02:0003E766 660000BA        	 11581:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11582:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11583:     ; We had to account for the usual offset of 3.
                            	 11584:     ;
02:0003E76A 41EC0084        	 11585:     lea     ($0084,A4),A0
02:0003E76E 10302000        	 11586:     move.b  (A0,D2.W),D0
02:0003E772 023C00EE        	 11587:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E776 123C0003        	 11588:     move.b  #$03,D1
02:0003E77A D101            	 11589:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E77C 0200000F        	 11590:     andi.b #$0F,D0
02:0003E780 660000A0        	 11591:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11592:     ; Store the opposite of the facing direction in [00].
                            	 11593:     ;
02:0003E784 41EC0098        	 11594:     lea     ($0098,A4),A0
02:0003E788 10302000        	 11595:     move.b  (A0,D2.W),D0
02:0003E78C E208            	 11596:     lsr.b  #1,D0   ; LSR A
02:0003E78E 02000005        	 11597:     andi.b #$05,D0
02:0003E792 1880            	 11598:     move.b  D0,($0000,A4)
02:0003E794 41EC0098        	 11599:     lea     ($0098,A4),A0
02:0003E798 10302000        	 11600:     move.b  (A0,D2.W),D0
02:0003E79C E308            	 11601:     lsl.b  #1,D0   ; ASL A
02:0003E79E 0200000A        	 11602:     andi.b #$0A,D0
02:0003E7A2 1214            	 11603:     move.b  ($0000,A4),D1
02:0003E7A4 8001            	 11604:     or.b  D1,D0
                            	 11605:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11606:     ;
02:0003E7A6 0A00000F        	 11607:     eori.b #$0F,D0
02:0003E7AA 1940050F        	 11608:     move.b  D0,($050F,A4)
                            	 11609:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11610:     ;
02:0003E7AE 10342018        	 11611:     move.b  ($18,A4,D2.W),D0
02:0003E7B2 0C000080        	 11612:     cmpi.b  #$80,D0
02:0003E7B6 656C            	 11613:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11614:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11615:     ; Load the monster's facing direction.
                            	 11616:     ;
02:0003E7B8 41EC0098        	 11617:     lea     ($0098,A4),A0
02:0003E7BC 10302000        	 11618:     move.b  (A0,D2.W),D0
                            	 11619:     ; Load the next random number into Y register.
                            	 11620:     ;
02:0003E7C0 7600            	 11621:     moveq   #0,D3
02:0003E7C2 16342019        	 11622:     move.b  ($19,A4,D2.W),D3
                            	 11623:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11624:     ; to keep moving straight.
                            	 11625:     ;
02:0003E7C6 0C030080        	 11626:     cmpi.b  #$80,D3
02:0003E7CA 6418            	 11627:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11628:     even
                            	 11629: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11630:     ; Loop to rotate the direction bit over the mask.
                            	 11631:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11632:     ; facing direction.
                            	 11633:     ;
                            	 11634:     ; Shift right the copy of the direction.
                            	 11635:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11636:     ;
02:0003E7CC E208            	 11637:     lsr.b  #1,D0   ; LSR A
02:0003E7CE 6402            	 11638:     bcc  _anon_z04_151
02:0003E7D0 7008            	 11639:     moveq   #8,D0
                            	 11640: _anon_z04_151:
                            	 11641:     ; If the current direction bit is masked off, then we've reached
                            	 11642:     ; the opposite direction. Loop again.
                            	 11643:     ;
02:0003E7D2 122C050F        	 11644:     move.b  ($050F,A4),D1
02:0003E7D6 C200            	 11645:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E7D8 67F2            	 11646:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11647:     ; If Y register >= $40, then break out of the loop.
                            	 11648:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11649:     ;
02:0003E7DA 0C030040        	 11650:     cmpi.b  #$40,D3
02:0003E7DE 6404            	 11651:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11652:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11653:     ; and loop again now.
                            	 11654:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11655:     ;
02:0003E7E0 7640            	 11656:     moveq   #64,D3
02:0003E7E2 65E8            	 11657:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11658:     even
                            	 11659: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11660:     ; Change the facing direction to the direction found.
                            	 11661:     ;
02:0003E7E4 41EC0098        	 11662:     lea     ($0098,A4),A0
02:0003E7E8 11802000        	 11663:     move.b  D0,(A0,D2.W)
                            	 11664:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11665:     ;
02:0003E7EC 1940000F        	 11666:     move.b  D0,($000F,A4)
02:0003E7F0 4EB90003079C    	 11667:     jsr     BoundByRoom
                            	 11668:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11669:     ;
02:0003E7F6 102C000F        	 11670:     move.b  ($000F,A4),D0
02:0003E7FA 6618            	 11671:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11672:     even
                            	 11673: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11674:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11675:     ; for looking for any non-opposite direction that is not blocked.
                            	 11676:     ;
02:0003E7FC 41EC0098        	 11677:     lea     ($0098,A4),A0
02:0003E800 10302000        	 11678:     move.b  (A0,D2.W),D0
                            	 11679:     even
                            	 11680: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11681:     ; Shift right the copy of the direction.
                            	 11682:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11683:     ;
02:0003E804 E208            	 11684:     lsr.b  #1,D0   ; LSR A
02:0003E806 6402            	 11685:     bcc  _anon_z04_152
02:0003E808 7008            	 11686:     moveq   #8,D0
                            	 11687: _anon_z04_152:
                            	 11688:     ; If the current direction bit is not masked off, then go check the
                            	 11689:     ; room boundary in this direction.
                            	 11690:     ; Else we've reached the opposite direction. Loop again.
                            	 11691:     ;
02:0003E80A 122C050F        	 11692:     move.b  ($050F,A4),D1
02:0003E80E C200            	 11693:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E810 66D2            	 11694:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003E812 67F0            	 11695:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11696:     even
                            	 11697: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11698:     ; We found a direction that was not blocked by the room boundary.
                            	 11699:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11700:     ;
02:0003E814 4EB90004AE70    	 11701:     jsr     GetCollidingTileMoving
02:0003E81A 122C034A        	 11702:     move.b  ($034A,A4),D1
02:0003E81E B001            	 11703:     cmp.b   D1,D0
02:0003E820 64DA            	 11704:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11705:     even
                            	 11706: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11707:     ; TODO: confirm this
                            	 11708:     ;
                            	 11709:     ; If there were a room that had lamnolas, and they could get
                            	 11710:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11711:     ; an infinite loop.
                            	 11712:     ;
                            	 11713:     ; But, the only room with that configuration has those blocks
                            	 11714:     ; blocked off with a push block, which can only be pushed after
                            	 11715:     ; all monsters are killed.
                            	 11716:     ;
02:0003E822 4E75            	 11717:     rts
                            	 11718: 
                            	 11719:     even
                            	 11720: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11721:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11722:     ;
02:0003E824 7001            	 11723:     moveq   #1,D0
02:0003E826 19400002        	 11724:     move.b  D0,($0002,A4)
02:0003E82A 102C0070        	 11725:     move.b  ($0070,A4),D0
02:0003E82E 003C0011        	 11726:     ori     #$11,CCR  ; SEC: set C+X
02:0003E832 12342070        	 11727:     move.b  ($70,A4,D2.W),D1
02:0003E836 0A3C0010        	 11728:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E83A 9101            	 11729:     subx.b  D1,D0   ; SBC ObjX,X
02:0003E83C 0A3C0010        	 11730:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E840 640A            	 11731:     bcc  _anon_z04_153
02:0003E842 122C0002        	 11732:     move.b  ($0002,A4),D1
02:0003E846 E309            	 11733:     lsl.b  #1,D1   ; ASL $02
02:0003E848 19410002        	 11734:     move.b  D1,($0002,A4)
                            	 11735: _anon_z04_153:
                            	 11736:     ; Find the vertical direction toward Link and store it in [03].
                            	 11737:     ;
02:0003E84C 7004            	 11738:     moveq   #4,D0
02:0003E84E 19400003        	 11739:     move.b  D0,($0003,A4)
02:0003E852 102C0084        	 11740:     move.b  ($0084,A4),D0
02:0003E856 003C0011        	 11741:     ori     #$11,CCR  ; SEC: set C+X
02:0003E85A 41EC0084        	 11742:     lea     ($0084,A4),A0
02:0003E85E 12302000        	 11743:     move.b  (A0,D2.W),D1
02:0003E862 0A3C0010        	 11744:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E866 9101            	 11745:     subx.b  D1,D0   ; SBC ObjY,X
02:0003E868 0A3C0010        	 11746:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E86C 640A            	 11747:     bcc  _anon_z04_154
02:0003E86E 122C0003        	 11748:     move.b  ($0003,A4),D1
02:0003E872 E309            	 11749:     lsl.b  #1,D1   ; ASL $03
02:0003E874 19410003        	 11750:     move.b  D1,($0003,A4)
                            	 11751: _anon_z04_154:
                            	 11752:     ; If the horizontal direction toward Link is not allowed, then
                            	 11753:     ; go check the vertical direction.
                            	 11754:     ;
02:0003E878 102C0002        	 11755:     move.b  ($0002,A4),D0
02:0003E87C 122C050F        	 11756:     move.b  ($050F,A4),D1
02:0003E880 C200            	 11757:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E882 6708            	 11758:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11759:     ; If the horizontal direction toward Link is the same direction
                            	 11760:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11761:     ;
02:0003E884 122C0098        	 11762:     move.b  ($0098,A4),D1
02:0003E888 C200            	 11763:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E88A 6604            	 11764:     bne  _anon_z04_155
                            	 11765:     even
                            	 11766: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11767:     ; Load the vertical direction toward Link in order to test it for
                            	 11768:     ; room boundary and tile collision.
                            	 11769:     ;
02:0003E88C 102C0003        	 11770:     move.b  ($0003,A4),D0
                            	 11771: _anon_z04_155:
                            	 11772:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11773:     ;
02:0003E890 6000FF52        	 11774:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
