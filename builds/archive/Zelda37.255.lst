02:0003D646 10302000        	  9319:     move.b  (A0,D2.W),D0
02:0003D64A 674E            	  9320:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003D64C 4EB90004AEE4    	  9321:     jsr     ResetShoveInfo
