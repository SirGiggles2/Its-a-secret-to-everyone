                            	  7669: __far_z_04_0069:
                            	  7670:     ; Go to state 1.
                            	  7671:     ;
02:0003C994 41EC00AC        	  7672:     lea     ($00AC,A4),A0
02:0003C998 52302000        	  7673:     addq.b  #1,(A0,D2.W)
                            	  7674:     ; Subtract 1 from facing direction to make an index.
                            	  7675:     ;
02:0003C99C 7600            	  7676:     moveq   #0,D3
02:0003C99E 41EC0098        	  7677:     lea     ($0098,A4),A0
02:0003C9A2 16302000        	  7678:     move.b  (A0,D2.W),D3
02:0003C9A6 5303            	  7679:     subq.b  #1,D3
                            	  7680:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7681:     ;
