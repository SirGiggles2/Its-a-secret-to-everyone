02:0003BECE 41EC042C        	  6161:     lea     ($042C,A4),A0
02:0003BED2 52302000        	  6162:     addq.b  #1,(A0,D2.W)
                            	  6163: _anon_z04_85:
                            	  6164:     ; If the 16-bit speed has not reached the 16-bit target speed, then return.
                            	  6165:     ;
02:0003BED6 41EC041F        	  6166:     lea     ($041F,A4),A0
02:0003BEDA 10302000        	  6167:     move.b  (A0,D2.W),D0
02:0003BEDE 41EC0437        	  6168:     lea     ($0437,A4),A0
02:0003BEE2 12302000        	  6169:     move.b  (A0,D2.W),D1
02:0003BEE6 B001            	  6170:     cmp.b   D1,D0
02:0003BEE8 6704            	  6171:     beq.s  __far_z_04_0053
02:0003BEEA 6000009E        	  6172:     jmp  L116EA_Exit
                            	  6173: __far_z_04_0053:
02:0003BEEE 41EC042C        	  6174:     lea     ($042C,A4),A0
02:0003BEF2 10302000        	  6175:     move.b  (A0,D2.W),D0
02:0003BEF6 41EC0444        	  6176:     lea     ($0444,A4),A0
02:0003BEFA 12302000        	  6177:     move.b  (A0,D2.W),D1
02:0003BEFE B001            	  6178:     cmp.b   D1,D0
