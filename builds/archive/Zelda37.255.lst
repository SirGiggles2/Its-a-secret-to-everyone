                            	  5055:     ;
02:00036304 102C00FC        	  5056:     move.b  ($00FC,A4),D0
02:00036308 41F90003627C    	  5057:     lea     (CreditsLastVscrollList).l,A0
02:0003630E 12303000        	  5058:     move.b  (A0,D3.W),D1
02:00036312 B001            	  5059:     cmp.b   D1,D0
02:00036314 650A            	  5060:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  5061:     ; But if we have, then go to the next submode, and set a timer
