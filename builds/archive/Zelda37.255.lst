02:0004BF64 1214            	  6043:     move.b  ($0000,A4),D1
02:0004BF66 D101            	  6044:     addx.b  D1,D0   ; ADC $00
02:0004BF68 7600            	  6045:     moveq   #0,D3
02:0004BF6A 1600            	  6046:     move.b  D0,D3
                            	  6047:     ; Set object's X to player's X + offset for state and direction.
                            	  6048:     ; Copy the result to [00].
