02:00042F68 10302000        	  5594:     move.b  (A0,D2.W),D0
02:00042F6C 4EB900030CEE    	  5595:     jsr     AddToInt16At0
                            	  5596:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5597:     ; go 1 more tile down, to start the next column at the right place.
                            	  5598:     ; We have to compensate for the fact that E/W doors are 
                            	  5599:     ; shorter vertically than N/S doors.
02:00042F72 4A02            	  5600:     cmpi.b  #$00,D2
02:00042F74 6610            	  5601:     bne  _anon_z05_115
02:00042F76 101D            	  5602:     move.b  (A5)+,D0  ; PLA
02:00042F78 1B00            	  5603:     move.b  D0,-(A5)  ; PHA
