                            	  6062: _anon_z01_99:
                            	  6063:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  6064:     ; if he is defending. The goal is to push Link away from the monster.
                            	  6065:     ;
                            	  6066:     ; If instead a monster is defending, then all this calculation
                            	  6067:     ; won't matter, because the shove direction will be set to the
                            	  6068:     ; weapon's direction.
                            	  6069:     ;
                            	  6070:     ; As such, calculate a direction from the monster to the defender,
                            	  6071:     ; assuming it's Link.
                            	  6072:     ;
                            	  6073:     ; Start with an assumption that the direction is vertical:
                            	  6074:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  6075:     ;
02:00031F64 7008            	  6076:     moveq   #8,D0
02:00031F66 19400008        	  6077:     move.b  D0,($0008,A4)
02:00031F6A 41EC0084        	  6078:     lea     ($0084,A4),A0
02:00031F6E 10302000        	  6079:     move.b  (A0,D2.W),D0
02:00031F72 19400004        	  6080:     move.b  D0,($0004,A4)
02:00031F76 41EC0084        	  6081:     lea     ($0084,A4),A0
02:00031F7A 10303000        	  6082:     move.b  (A0,D3.W),D0
02:00031F7E 19400005        	  6083:     move.b  D0,($0005,A4)
                            	  6084:     ; If the defender is Link and his grid offset <> 0 then
                            	  6085:     ; use his usual object direction variable to determine
                            	  6086:     ; which axis to check.
                            	  6087:     ;
02:00031F82 4A03            	  6088:     cmpi.b  #$00,D3
02:00031F84 6612            	  6089:     bne  _anon_z01_100
02:00031F86 102C0394        	  6090:     move.b  ($0394,A4),D0
02:00031F8A 670C            	  6091:     beq  _anon_z01_100
02:00031F8C 102C0098        	  6092:     move.b  ($0098,A4),D0
02:00031F90 02000003        	  6093:     andi.b #$03,D0
02:00031F94 660C            	  6094:     bne  _L_z01_BeginShove_CheckHorizontal
02:00031F96 6720            	  6095:     beq  _L_z01_BeginShove_CheckVertical
                            	  6096: _anon_z01_100:
                            	  6097:     ; For monsters defending, or Link with grid offset = 0,
                            	  6098:     ; check direction in [0B].
                            	  6099:     ;
                            	  6100:     ; For monsters defending, this won't matter. For Link with grid
                            	  6101:     ; offset = 0, I believe the result will be arbitrary.
                            	  6102:     ;
                            	  6103:     ; TODO:
                            	  6104:     ; Is [0B] always set if Link's grid offset = 0?
                            	  6105:     ; It doesn't seem to be if candle fire attacks him.
                            	  6106:     ;
