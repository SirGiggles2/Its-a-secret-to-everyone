                            	  5573: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00042F22 122C0002        	  5574:     move.b  ($02,A4),D1   ; ptr lo
02:00042F26 182C0003        	  5575:     move.b  ($03,A4),D4  ; ptr hi
02:00042F2A 024100FF        	  5576:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042F2E E14C            	  5577:     lsl.w   #8,D4
02:00042F30 8841            	  5578:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042F32 48C4            	  5579:     ext.l   D4
02:00042F34 D8BC00FF0000    	  5580:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042F3A 2044            	  5581:     movea.l D4,A0
02:00042F3C 10303000        	  5582:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042F40 1214            	  5583:     move.b  ($00,A4),D1   ; ptr lo
02:00042F42 182C0001        	  5584:     move.b  ($01,A4),D4  ; ptr hi
02:00042F46 024100FF        	  5585:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042F4A E14C            	  5586:     lsl.w   #8,D4
02:00042F4C 8841            	  5587:     or.w    D1,D4
02:00042F4E 48C4            	  5588:     ext.l   D4
02:00042F50 D8BC00FF0000    	  5589:     add.l   #NES_RAM,D4
02:00042F56 2044            	  5590:     movea.l D4,A0
02:00042F58 11803000        	  5591:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:00042F5C 4EB900030CF2    	  5592:     jsr     Add1ToInt16At2
