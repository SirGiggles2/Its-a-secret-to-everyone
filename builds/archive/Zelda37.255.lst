                            	  7588: _L_z04_UpdatePolsVoice_State0:
                            	  7589:     ; State 0. Walking.
                            	  7590:     ;
                            	  7591:     ; If grid offset = 0, then no more distance to cover.
                            	  7592:     ; So, go change to state 1 -- jumping.
                            	  7593:     ;
02:0003C8FA 41EC0394        	  7594:     lea     ($0394,A4),A0
02:0003C8FE 10302000        	  7595:     move.b  (A0,D2.W),D0
02:0003C902 67000084        	  7596:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7597:     ; Decrement grid offset / distance remaining.
                            	  7598:     ;
02:0003C906 41EC0394        	  7599:     lea     ($0394,A4),A0
02:0003C90A 53302000        	  7600:     subq.b  #1,(A0,D2.W)
