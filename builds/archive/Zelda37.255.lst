                            	  3234:     ;
02:0003A9C8 7628            	  3235:     moveq   #40,D3
02:0003A9CA 41EC0098        	  3236:     lea     ($0098,A4),A0
02:0003A9CE 10302000        	  3237:     move.b  (A0,D2.W),D0
02:0003A9D2 02000002        	  3238:     andi.b #$02,D0
