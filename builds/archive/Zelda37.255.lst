                            	  6041: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6042:     ; Digdogger is big, but room boundary checks and
                            	  6043:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6044:     ; Therefore, we have to check these things four times,
                            	  6045:     ; in different corners of the boss.
                            	  6046:     ;
                            	  6047:     ; Loop 4 times, from 0 to 3.
                            	  6048:     ;
02:0003BDB2 7600            	  6049:     moveq   #0,D3
02:0003BDB4 41EC0478        	  6050:     lea     ($0478,A4),A0
02:0003BDB8 16302000        	  6051:     move.b  (A0,D2.W),D3
                            	  6052:     ; Change the coordinates to one corner.
                            	  6053:     ;
02:0003BDBC 10342070        	  6054:     move.b  ($70,A4,D2.W),D0
02:0003BDC0 023C00EE        	  6055:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BDC4 41F90003BC78    	  6056:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003BDCA 12303000        	  6057:     move.b  (A0,D3.W),D1
02:0003BDCE D101            	  6058:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003BDD0 19802070        	  6059:     move.b  D0,($70,A4,D2.W)
02:0003BDD4 41EC0084        	  6060:     lea     ($0084,A4),A0
02:0003BDD8 10302000        	  6061:     move.b  (A0,D2.W),D0
02:0003BDDC 023C00EE        	  6062:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BDE0 41F90003BC7C    	  6063:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003BDE6 12303000        	  6064:     move.b  (A0,D3.W),D1
02:0003BDEA D101            	  6065:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003BDEC 41EC0084        	  6066:     lea     ($0084,A4),A0
02:0003BDF0 11802000        	  6067:     move.b  D0,(A0,D2.W)
                            	  6068:     ; Check the room boundary and object collisions in this temporary location.
                            	  6069:     ;
02:0003BDF4 61003734        	  6070:     jsr     BoundFlyer
02:0003BDF8 4EB90003176A    	  6071:     jsr     CheckMonsterCollisions
                            	  6072:     ; Increase the loop index, and loop again until it = 4.
                            	  6073:     ;
02:0003BDFE 41EC0478        	  6074:     lea     ($0478,A4),A0
02:0003BE02 52302000        	  6075:     addq.b  #1,(A0,D2.W)
02:0003BE06 41EC0478        	  6076:     lea     ($0478,A4),A0
02:0003BE0A 10302000        	  6077:     move.b  (A0,D2.W),D0
02:0003BE0E 0C000004        	  6078:     cmpi.b  #$04,D0
02:0003BE12 659E            	  6079:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6080:     ; Restore the original coordinates.
                            	  6081:     ;
02:0003BE14 101D            	  6082:     move.b  (A5)+,D0  ; PLA
02:0003BE16 41EC0084        	  6083:     lea     ($0084,A4),A0
02:0003BE1A 11802000        	  6084:     move.b  D0,(A0,D2.W)
02:0003BE1E 101D            	  6085:     move.b  (A5)+,D0  ; PLA
02:0003BE20 19802070        	  6086:     move.b  D0,($70,A4,D2.W)
02:0003BE24 6100026E        	  6087:     jsr     Digdogger_Draw
                            	  6088:     even
