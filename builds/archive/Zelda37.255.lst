02:0003F9A4 0003FA00        	   211:     dc.l    UpdateMenu_Return   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F9A8 0003FC20        	   212:     dc.l    UpdateMenuStartOW   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F9AC 0003F9CC        	   213:     dc.l    UpdateMenuCommon1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F9B0 0003FA02        	   214:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F9B4 0003FA14        	   215:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
