                            	 11777: Lamnola_Move:
                            	 11778:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11779:     ;
                            	 11780:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11781:     ;
                            	 11782:     ; Start with a mask of $A1 in [02]:
                            	 11783:     ; - low nibble represents the right direction
                            	 11784:     ; - high nibble is used to set or clear carry as we go along
                            	 11785:     ;
02:0003E894 103C00A1        	 11786:     move.b  #$A1,D0
02:0003E898 19400002        	 11787:     move.b  D0,($0002,A4)
                            	 11788:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11789:     ;
02:0003E89C 41EC0098        	 11790:     lea     ($0098,A4),A0
02:0003E8A0 10302000        	 11791:     move.b  (A0,D2.W),D0
02:0003E8A4 122C0002        	 11792:     move.b  ($0002,A4),D1
02:0003E8A8 C200            	 11793:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E8AA 6712            	 11794:     beq  _L_z04_Lamnola_Move_Left
02:0003E8AC 10342070        	 11795:     move.b  ($70,A4,D2.W),D0
02:0003E8B0 023C00EE        	 11796:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E8B4 122C04E6        	 11797:     move.b  ($04E6,A4),D1
02:0003E8B8 D101            	 11798:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003E8BA 19802070        	 11799:     move.b  D0,($70,A4,D2.W)
                            	 11800:     even
                            	 11801: _L_z04_Lamnola_Move_Left:
                            	 11802:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 11803:     ;
02:0003E8BE 41EC0098        	 11804:     lea     ($0098,A4),A0
02:0003E8C2 10302000        	 11805:     move.b  (A0,D2.W),D0
02:0003E8C6 122C0002        	 11806:     move.b  ($0002,A4),D1
02:0003E8CA E309            	 11807:     lsl.b  #1,D1   ; ASL $02
02:0003E8CC 19410002        	 11808:     move.b  D1,($0002,A4)
02:0003E8D0 122C0002        	 11809:     move.b  ($0002,A4),D1
02:0003E8D4 C200            	 11810:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E8D6 6716            	 11811:     beq  _L_z04_Lamnola_Move_Down
02:0003E8D8 10342070        	 11812:     move.b  ($70,A4,D2.W),D0
02:0003E8DC 122C04E6        	 11813:     move.b  ($04E6,A4),D1
02:0003E8E0 0A3C0010        	 11814:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E8E4 9101            	 11815:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003E8E6 0A3C0010        	 11816:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E8EA 19802070        	 11817:     move.b  D0,($70,A4,D2.W)
                            	 11818:     even
