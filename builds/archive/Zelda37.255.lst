                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:000431C2 102C0055        	  5954:     move.b  ($0055,A4),D0
02:000431C6 19400002        	  5955:     move.b  D0,($0002,A4)
02:000431CA 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:000431CE 0C000005        	  5957:     cmpi.b  #$05,D0
02:000431D2 650C            	  5958:     bcs  _anon_z05_125
02:000431D4 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:000431D6 7004            	  5960:     moveq   #4,D0
02:000431D8 4EB90003050C    	  5961:     jsr     PlaySample
02:000431DE 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:000431E0 0C000004        	  5969:     cmpi.b  #$04,D0
02:000431E4 6602            	  5970:     bne  _anon_z05_126
02:000431E6 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:000431E8 0C000001        	  5973:     cmpi.b  #$01,D0
02:000431EC 6602            	  5974:     bne  _anon_z05_127
02:000431EE 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:000431F0 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:000431F4 123C0003        	  5980:     move.b  #$03,D1
02:000431F8 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000431FC 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:000431FE 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:00043202 7600            	  5984:     moveq   #0,D3
02:00043204 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:00043206 102C0008        	  5992:     move.b  ($0008,A4),D0
02:0004320A 6708            	  5993:     beq  _anon_z05_128
02:0004320C 0C030005        	  5994:     cmpi.b  #$05,D3
02:00043210 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043212 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:00043214 0C030003        	  5998:     cmpi.b  #$03,D3
02:00043218 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0004321A 5303            	  6000:     subq.b  #1,D3
                            	  6001:     even
                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:0004321C 7003            	  6008:     moveq   #3,D0
02:0004321E 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:00043222 122C0003        	  6010:     move.b  ($0003,A4),D1
02:00043226 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004322A 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:0004322C 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6014:     ; Call this to put the address of door face tiles in [02:03].
                            	  6015:     ;
02:00043230 6100FD7A        	  6016:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6017:     ; Return the address of the door in the nametable in [01:00].
                            	  6018:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6019:     ;
02:00043234 41F90004300A    	  6020:     lea     (DoorVramAddrsHi).l,A0
02:0004323A 10302000        	  6021:     move.b  (A0,D2.W),D0
02:0004323E 1880            	  6022:     move.b  D0,($0000,A4)
02:00043240 41F90004300E    	  6023:     lea     (DoorVramAddrsLo).l,A0
02:00043246 10302000        	  6024:     move.b  (A0,D2.W),D0
02:0004324A 19400001        	  6025:     move.b  D0,($0001,A4)
                            	  6026:     ; Return the direction of the door in [09], and the dynamic
                            	  6027:     ; transfer buf length in X register.
                            	  6028:     ;
02:0004324E 19420009        	  6029:     move.b  D2,($0009,A4)
02:00043252 7400            	  6030:     moveq   #0,D2
02:00043254 142C0301        	  6031:     move.b  ($0301,A4),D2
                            	  6032:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6033:     ;
02:00043258 7000            	  6034:     moveq   #0,D0
02:0004325A 19400007        	  6035:     move.b  D0,($0007,A4)
02:0004325E 7002            	  6036:     moveq   #2,D0
02:00043260 19400006        	  6037:     move.b  D0,($0006,A4)
02:00043264 19400005        	  6038:     move.b  D0,($0005,A4)
02:00043268 0A3C0001        	  6039:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004326C 4E75            	  6040:     rts
