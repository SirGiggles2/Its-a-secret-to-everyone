02:0003F75A 122C0003        	 13928:     move.b  ($0003,A4),D1
02:0003F75E 0A3C0010        	 13929:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F762 9101            	 13930:     subx.b  D1,D0   ; SBC $03
02:0003F764 0A3C0010        	 13931:     eori    #$10,CCR  ; restore X = 6502 C
