                            	  7718: 
                            	  7719: _anon_z05_167:
                            	  7720:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7721:     ; of the big map sheet.
                            	  7722:     ;
02:000443EE 0C000015        	  7723:     cmpi.b  #$15,D0
02:000443F2 6604            	  7724:     bne  _anon_z05_168
02:000443F4 7042            	  7725:     moveq   #66,D0
