02:00039A86 10342070        	  1052:     move.b  ($70,A4,D2.W),D0
02:00039A8A 023C00EE        	  1053:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039A8E 41F900039980    	  1054:     lea     (ShotBounceWidths).l,A0
02:00039A94 12303000        	  1055:     move.b  (A0,D3.W),D1
