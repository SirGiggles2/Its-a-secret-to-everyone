                            	  7184: DodongoBombPositiveLimits:
02:0003C662 0C              	  7185:     dc.b    $0C, $11
02:0003C663 11
                            	  7186: 
                            	  7187:     even
                            	  7188: DodongoBombNegativeLimits:
02:0003C664 F4              	  7189:     dc.b    $F4, $F0
02:0003C665 F0
                            	  7190: 
                            	  7191: ; Params:
                            	  7192: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7193: ; [00]: monster hotspot X
                            	  7194: ; [01]: monster hotspot Y
                            	  7195: ; [02]: bomb hotspot X
                            	  7196: ; [03]: bomb hotspot Y
                            	  7197: ;
                            	  7198: ; Returns:
                            	  7199: ; A: 0 if the bomb is in range of the monster
                            	  7200: ; Z: 1 if the bomb is in range of the monster
                            	  7201: ; [04]: horizontal distance
                            	  7202: ; [05]: vertical distance
                            	  7203: ;
                            	  7204: ; Store the positive limit in [06], and the negative one in [07].
                            	  7205: ;
                            	  7206:     even
                            	  7207: Dodongo_IsBombInRange:
02:0003C666 41F90003C662    	  7208:     lea     (DodongoBombPositiveLimits).l,A0
02:0003C66C 10303000        	  7209:     move.b  (A0,D3.W),D0
02:0003C670 19400006        	  7210:     move.b  D0,($0006,A4)
02:0003C674 41F90003C664    	  7211:     lea     (DodongoBombNegativeLimits).l,A0
02:0003C67A 10303000        	  7212:     move.b  (A0,D3.W),D0
02:0003C67E 19400007        	  7213:     move.b  D0,($0007,A4)
                            	  7214:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7215:     ; the bomb is near enough the monster.
                            	  7216:     ;
02:0003C682 7003            	  7217:     moveq   #3,D0
02:0003C684 19400008        	  7218:     move.b  D0,($0008,A4)
                            	  7219:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7220:     ;
02:0003C688 7601            	  7221:     moveq   #1,D3
                            	  7222:     even
                            	  7223: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7224:     ; Subtract the bomb's coordinate from the boss's,
                            	  7225:     ; The loop index determines the coordinate.
                            	  7226:     ;
02:0003C68A 10343000        	  7227:     move.b  ($00,A4,D3.W),D0
02:0003C68E 003C0011        	  7228:     ori     #$11,CCR  ; SEC: set C+X
02:0003C692 12343002        	  7229:     move.b  ($02,A4,D3.W),D1
02:0003C696 0A3C0010        	  7230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C69A 9101            	  7231:     subx.b  D1,D0   ; SBC $0002,Y
02:0003C69C 0A3C0010        	  7232:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7233:     ; If the distance >= positive offset, or < negative offset;
                            	  7234:     ; then loop again.
                            	  7235:     ;
02:0003C6A0 122C0006        	  7236:     move.b  ($0006,A4),D1
02:0003C6A4 B001            	  7237:     cmp.b   D1,D0
02:0003C6A6 6A16            	  7238:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003C6A8 122C0007        	  7239:     move.b  ($0007,A4),D1
02:0003C6AC B001            	  7240:     cmp.b   D1,D0
02:0003C6AE 6B0E            	  7241:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7242:     ; The distance is close enough in this axis.
                            	  7243:     ;
                            	  7244:     ; Store the distance in this axis in [05] or [04],
                            	  7245:     ; depending on the loop index.
                            	  7246:     ;
02:0003C6B0 19803004        	  7247:     move.b  D0,($04,A4,D3.W)
                            	  7248:     ; Shift [08] right, because we're in range in this axis.
                            	  7249:     ;
02:0003C6B4 122C0008        	  7250:     move.b  ($0008,A4),D1
02:0003C6B8 E209            	  7251:     lsr.b  #1,D1   ; LSR $08
02:0003C6BA 19410008        	  7252:     move.b  D1,($0008,A4)
                            	  7253:     even
                            	  7254: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003C6BE 5303            	  7255:     subq.b  #1,D3
02:0003C6C0 6AC8            	  7256:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7257:     ; If close enough in both axes, then [08] will be 0.
                            	  7258:     ;
02:0003C6C2 102C0008        	  7259:     move.b  ($0008,A4),D0
02:0003C6C6 4E75            	  7260:     rts
                            	  7261: 
                            	  7262: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7263: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7264: ;
                            	  7265: ; But these are not typical direction indexes. Instead a
                            	  7266: ; 5-way index is used.
                            	  7267: ; A direction shifted right once becomes a 5-way index.
                            	  7268: ; The fourth element is unused.
                            	  7269: ;
                            	  7270:     even
                            	  7271: DodongoFrameImages:
02:0003C6C8 00              	  7272:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003C6C9 01
02:0003C6CA 06
02:0003C6CB FF
02:0003C6CC 08
02:0003C6CD 02
02:0003C6CE 03
02:0003C6CF 06
02:0003C6D0 FF              	  7273:     dc.b    $FF, $08
02:0003C6D1 08
                            	  7274: 
                            	  7275:     even
                            	  7276: DodongoFrameHFlips:
02:0003C6D2 00              	  7277:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003C6D3 40
02:0003C6D4 00
02:0003C6D5 FF
02:0003C6D6 00
02:0003C6D7 00
02:0003C6D8 40
02:0003C6D9 40
02:0003C6DA FF              	  7278:     dc.b    $FF, $40
02:0003C6DB 40
