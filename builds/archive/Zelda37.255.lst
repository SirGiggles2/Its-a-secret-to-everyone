02:0003CBBA 194000C0        	  7905:     move.b  D0,($00C0,A4)
02:0003CBBE 194000D3        	  7906:     move.b  D0,($00D3,A4)
                            	  7907:     ; Restart the monster's movement frame cycle: frame 0, counter 4
