02:00030968 102C0003        	  3020:     move.b  ($0003,A4),D0
02:0003096C 003C0011        	  3021:     ori     #$11,CCR  ; SEC: set C+X
02:00030970 122C0004        	  3022:     move.b  ($0004,A4),D1
02:00030974 0A3C0010        	  3023:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030978 9101            	  3024:     subx.b  D1,D0   ; SBC $04
02:0003097A 0A3C0010        	  3025:     eori    #$10,CCR  ; restore X = 6502 C
02:0003097E 0C000008        	  3026:     cmpi.b  #$08,D0
02:00030982 6538            	  3027:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3028:     even
                            	  3029: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  3030:     ; TODO: call it speed index or angle?
                            	  3031:     ; Otherwise, go to the next speed index (angle).
