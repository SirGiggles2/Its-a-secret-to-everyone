02:0003C5D2 0C000012        	  7082:     cmpi.b  #$12,D0
02:0003C5D6 6602            	  7083:     bne.s  __far_z_04_0065
02:0003C5D8 601A            	  7084:     jmp  Dodongo_TryEatBomb
                            	  7085: __far_z_04_0065:
                            	  7086:     ; If the object in the slot is actually a fire, then return.
                            	  7087:     ;
02:0003C5DA 0C000020        	  7088:     cmpi.b  #$20,D0
02:0003C5DE 6412            	  7089:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7090:     ; The bomb already blew up.
