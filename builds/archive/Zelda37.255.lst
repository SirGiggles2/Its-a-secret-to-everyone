                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:000431B4 102C0055        	  5924:     move.b  ($0055,A4),D0
02:000431B8 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:000431BC 8001            	  5926:     or.b  D1,D0
