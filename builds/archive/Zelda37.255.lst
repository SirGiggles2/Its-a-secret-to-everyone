02:00044A8E 6100586A        	  8704:     jsr     GetRoomFlags
02:00044A92 102C00EB        	  8705:     move.b  ($00EB,A4),D0
02:00044A96 1B00            	  8706:     move.b  D0,-(A5)  ; PHA
                            	  8707:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8708:     ; in order to look up its information.
                            	  8709:     ;
02:00044A98 102C005D        	  8710:     move.b  ($005D,A4),D0
02:00044A9C 194000EB        	  8711:     move.b  D0,($00EB,A4)
                            	  8712:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8713:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8714:     ; map mark tile.
                            	  8715:     ;
02:00044AA0 7013            	  8716:     moveq   #19,D0
02:00044AA2 1940033F        	  8717:     move.b  D0,($033F,A4)
                            	  8718:     ; Get the currently scanned room's visit state.
                            	  8719:     ;
02:00044AA6 7600            	  8720:     moveq   #0,D3
02:00044AA8 162C00EB        	  8721:     move.b  ($00EB,A4),D3
02:00044AAC 1214            	  8722:     move.b  ($00,A4),D1   ; ptr lo
02:00044AAE 182C0001        	  8723:     move.b  ($01,A4),D4  ; ptr hi
02:00044AB2 024100FF        	  8724:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00044AB6 E14C            	  8725:     lsl.w   #8,D4
02:00044AB8 8841            	  8726:     or.w    D1,D4             ; D4 = NES ptr addr
02:00044ABA 48C4            	  8727:     ext.l   D4
02:00044ABC D8BC00FF0000    	  8728:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00044AC2 2044            	  8729:     movea.l D4,A0
02:00044AC4 10303000        	  8730:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00044AC8 02000020        	  8731:     andi.b #$20,D0
                            	  8732:     ; If it's been visited, then check each of the 4 doors,
                            	  8733:     ; and build an open door mask.
                            	  8734:     ;
                            	  8735:     ; Start with direction up and direction index 3.
                            	  8736:     ;
02:00044ACC 671C            	  8737:     beq  _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile
02:00044ACE 7008            	  8738:     moveq   #8,D0
02:00044AD0 19400002        	  8739:     move.b  D0,($0002,A4)
