02:0003EE5C 41EC0084        	 12595:     lea     ($0084,A4),A0
02:0003EE60 10302000        	 12596:     move.b  (A0,D2.W),D0
02:0003EE64 19400001        	 12597:     move.b  D0,($0001,A4)
02:0003EE68 6100FF62        	 12598:     jsr     Ganon_DrawCloud
02:0003EE6C 6172            	 12599:     jsr     Ganon_GetCurCloudRight
02:0003EE6E 6100FF5C        	 12600:     jsr     Ganon_DrawCloud
                            	 12601:     ; Save the object index.
                            	 12602:     ;
02:0003EE72 102C0340        	 12603:     move.b  ($0340,A4),D0
02:0003EE76 1B00            	 12604:     move.b  D0,-(A5)  ; PHA
                            	 12605:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12606:     ;
02:0003EE78 7402            	 12607:     moveq   #2,D2
                            	 12608:     even
                            	 12609: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003EE7A 19420340        	 12610:     move.b  D2,($0340,A4)
                            	 12611:     ; If object slot < 5 or = 7, then move every frame.
                            	 12612:     ; Else move 3 out of every 4 frames.
                            	 12613:     ;
                            	 12614:     ; This makes pieces spread out in somewhat of a circle,
                            	 12615:     ; by making the pieces at cardinal directions move at
                            	 12616:     ; full speed while the diagonal ones move a little slower.
                            	 12617:     ;
02:0003EE7E 0C020005        	 12618:     cmpi.b  #$05,D2
02:0003EE82 6510            	 12619:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003EE84 0C020007        	 12620:     cmpi.b  #$07,D2
02:0003EE88 670A            	 12621:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003EE8A 102C0015        	 12622:     move.b  ($0015,A4),D0
02:0003EE8E 02000003        	 12623:     andi.b #$03,D0
02:0003EE92 6704            	 12624:     beq  _anon_z04_164
                            	 12625:     even
                            	 12626: _L_z04_Ganon_DrawBurst_Move:
02:0003EE94 6100E036        	 12627:     jsr     BlueWizzrobe_Move
                            	 12628: _anon_z04_164:
02:0003EE98 4EB90004C53C    	 12629:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12630:     ; The frame counter will make the sprite flash.
                            	 12631:     ; The array has the horizontal and vertical flipping attributes.
                            	 12632:     ; Combine them into [03].
                            	 12633:     ;
02:0003EE9E 102C0015        	 12634:     move.b  ($0015,A4),D0
02:0003EEA2 02000003        	 12635:     andi.b #$03,D0
02:0003EEA6 41F90003ED76    	 12636:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003EEAC 12302000        	 12637:     move.b  (A0,D2.W),D1
02:0003EEB0 8001            	 12638:     or.b  D1,D0
02:0003EEB2 19400003        	 12639:     move.b  D0,($0003,A4)
02:0003EEB6 41F90003ED80    	 12640:     lea     (GanonBurstTiles).l,A0
02:0003EEBC 10302000        	 12641:     move.b  (A0,D2.W),D0
02:0003EEC0 4EB9000316EA    	 12642:     jsr     Anim_WriteSprite
                            	 12643:     ; Bottom of the loop.
                            	 12644:     ; Increment object slot while <= 9.
                            	 12645:     ;
02:0003EEC6 5202            	 12646:     addq.b  #1,D2
02:0003EEC8 0C02000A        	 12647:     cmpi.b  #$0A,D2
02:0003EECC 65AC            	 12648:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12649:     ; Restore the object index.
                            	 12650:     ;
02:0003EECE 101D            	 12651:     move.b  (A5)+,D0  ; PLA
02:0003EED0 19400340        	 12652:     move.b  D0,($0340,A4)
02:0003EED4 0A3C0001        	 12653:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003EED8 4E75            	 12654:     rts
                            	 12655: 
