                            	  5675:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5676:     ;
02:0004BC9E 7000            	  5677:     moveq   #0,D0
02:0004BCA0 41EC0380        	  5678:     lea     ($0380,A4),A0
02:0004BCA4 11802000        	  5679:     move.b  D0,(A0,D2.W)
02:0004BCA8 0C02000D        	  5680:     cmpi.b  #$0D,D2
02:0004BCAC 6524            	  5681:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5682:     ; Link has caught the boomerang.
                            	  5683:     ;
                            	  5684:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5685:     ;
                            	  5686:     ; If Link catches it some time after throwing it,
                            	  5687:     ; his state will become $20, and he will show the catch animation.
                            	  5688:     ;
                            	  5689:     ; But if he catches it right after throwing it, the state becomes
                            	  5690:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5691:     ;
02:0004BCAE 102C00AC        	  5692:     move.b  ($00AC,A4),D0
02:0004BCB2 00000020        	  5693:     ori.b #$20,D0
02:0004BCB6 194000AC        	  5694:     move.b  D0,($00AC,A4)
                            	  5695:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5696:     ; up the new state.
