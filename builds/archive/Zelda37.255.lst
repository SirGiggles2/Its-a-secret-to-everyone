02:00031938 102C0084        	  5058:     move.b  ($0084,A4),D0
02:0003193C 023C00EE        	  5059:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031940 123C0008        	  5060:     move.b  #$08,D1
02:00031944 D101            	  5061:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031946 19400005        	  5062:     move.b  D0,($0005,A4)
                            	  5063:     ; If both objects are 9 pixels apart or more, then return no collision.
                            	  5064:     ;
02:0003194A 7009            	  5065:     moveq   #9,D0
