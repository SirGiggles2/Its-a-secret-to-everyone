                            	  4202: 
                            	  4203: ; Params:
                            	  4204: ; [02]: Y
                            	  4205: ; [03]: X
                            	  4206: ;
                            	  4207: ; Returns:
                            	  4208: ; [00]: high byte of PPU address
                            	  4209: ; [01]: low byte of PPU address
                            	  4210: ;
                            	  4211: ;
                            	  4212: ; Turn the 16-bit value 08YY into the PPU address
                            	  4213: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  4214: ;
                            	  4215: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  4216: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  4217: ;
                            	  4218:     even
