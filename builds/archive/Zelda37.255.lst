                            	 12069: PatraChild_State1:
                            	 12070:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12071:     ;
02:0003EAB8 10342070        	 12072:     move.b  ($70,A4,D2.W),D0
02:0003EABC 023C00EE        	 12073:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EAC0 122C046C        	 12074:     move.b  ($046C,A4),D1
02:0003EAC4 D101            	 12075:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003EAC6 19802070        	 12076:     move.b  D0,($70,A4,D2.W)
02:0003EACA 41EC0084        	 12077:     lea     ($0084,A4),A0
02:0003EACE 10302000        	 12078:     move.b  (A0,D2.W),D0
02:0003EAD2 023C00EE        	 12079:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EAD6 122C0479        	 12080:     move.b  ($0479,A4),D1
02:0003EADA D101            	 12081:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003EADC 41EC0084        	 12082:     lea     ($0084,A4),A0
02:0003EAE0 11802000        	 12083:     move.b  D0,(A0,D2.W)
                            	 12084:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12085:     ;
02:0003EAE4 7000            	 12086:     moveq   #0,D0
02:0003EAE6 1940000B        	 12087:     move.b  D0,($000B,A4)
                            	 12088:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12089:     ; monster's angle by $70, else by $60 to go slower.
                            	 12090:     ;
02:0003EAEA 7070            	 12091:     moveq   #112,D0
02:0003EAEC 7600            	 12092:     moveq   #0,D3
02:0003EAEE 41EC034F        	 12093:     lea     ($034F,A4),A0
02:0003EAF2 16302000        	 12094:     move.b  (A0,D2.W),D3
02:0003EAF6 0C030025        	 12095:     cmpi.b  #$25,D3
02:0003EAFA 6702            	 12096:     beq  _anon_z04_159
02:0003EAFC 7060            	 12097:     moveq   #96,D0
                            	 12098: _anon_z04_159:
02:0003EAFE 61000D9C        	 12099:     jsr     DecreaseObjectAngle
                            	 12100:     ; Load Patra's maneuver index.
                            	 12101:     ; It determines which counts of bits are looked up below.
                            	 12102:     ;
02:0003EB02 7600            	 12103:     moveq   #0,D3
02:0003EB04 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003EB08 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003EB0C 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003EB10 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003EB14 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003EB16 41F90003EA08    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003EB1C 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003EB20 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003EB22 41F90003EA0C    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003EB28 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003EB2C 7600            	 12118:     moveq   #0,D3
02:0003EB2E 1600            	 12119:     move.b  D0,D3
02:0003EB30 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003EB32 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003EB34 41F90003EA0A    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003EB3A 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003EB3E 7600            	 12131:     moveq   #0,D3
02:0003EB40 1600            	 12132:     move.b  D0,D3
                            	 12133:     even
                            	 12134: _L_z04_PatraChild_State1_Rotate:
02:0003EB42 61000BA8        	 12135:     jsr     RotateObjectLocation
