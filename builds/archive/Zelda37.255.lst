                            	  6082: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6083:     ; Store the weapon's frame (horizontal or vertical)
                            	  6084:     ; for the direction chosen above in [0C].
                            	  6085:     ;
02:0004BFC4 4EB900030896    	  6086:     jsr     GetOppositeDir
02:0004BFCA 41F90004B9FE    	  6087:     lea     (RDirectionToWeaponFrame).l,A0
02:0004BFD0 10303000        	  6088:     move.b  (A0,D3.W),D0
02:0004BFD4 1940000C        	  6089:     move.b  D0,($000C,A4)
                            	  6090:     ; Calculate sprite attributes.
                            	  6091:     ;
                            	  6092:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6093:     ;   base attribute OR 1
                            	  6094:     ; So, it uses palette row 5.
                            	  6095:     ;
02:0004BFD8 41F90004BA02    	  6096:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004BFDE 10303000        	  6097:     move.b  (A0,D3.W),D0
