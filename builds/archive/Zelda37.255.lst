02:0004BF94 12303000        	  6063:     move.b  (A0,D3.W),D1
02:0004BF98 D101            	  6064:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004BF9A 41EC0084        	  6065:     lea     ($0084,A4),A0
