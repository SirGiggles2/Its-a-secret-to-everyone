                            	  7337: _L_z07_InitObject_InitMonsterFromEdge:
02:0004C978 7400            	  7338:     moveq   #0,D2
02:0004C97A 142C0340        	  7339:     move.b  ($0340,A4),D2
                            	  7340:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7341:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7342:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7343:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7344:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7345:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7346:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7347:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7348:     ; corrupting them and causing a deterministic address-error
                            	  7349:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7350:     ; identified by Codex static review.)
                            	  7351: _L_z07_P47_pre_check:
02:0004C97E 102C0525        	  7352:     move.b  ($0525,A4),D0
02:0004C982 020000F0        	  7353:     andi.b  #$F0,D0
02:0004C986 0C000040        	  7354:     cmpi.b  #$40,D0
02:0004C98A 6506            	  7355:     blo     _L_z07_P47_pre_snap
02:0004C98C 0C0000E0        	  7356:     cmpi.b  #$E0,D0
02:0004C990 6506            	  7357:     blo     _L_z07_P47_pre_ok
                            	  7358: _L_z07_P47_pre_snap:
02:0004C992 197C00480525    	  7359:     move.b  #$48,($0525,A4)
                            	  7360: _L_z07_P47_pre_ok:
02:0004C998 7005            	  7361:     moveq   #5,D0
02:0004C99A 610004F4        	  7362:     jsr     SwitchBank
02:0004C99E 4EB900041730    	  7363:     jsr     FindNextEdgeSpawnCell
                            	  7364:     ; Post-walk 1: bottom-edge snap.
02:0004C9A4 102C0525        	  7365:     move.b  ($0525,A4),D0
02:0004C9A8 020000F0        	  7366:     andi.b  #$F0,D0
02:0004C9AC 0C0000E0        	  7367:     cmpi.b  #$E0,D0
02:0004C9B0 660C            	  7368:     bne     _L_z07_P47_post1_ok
02:0004C9B2 197C00480525    	  7369:     move.b  #$48,($0525,A4)
02:0004C9B8 4EB900041730    	  7370:     jsr     FindNextEdgeSpawnCell
                            	  7371: _L_z07_P47_post1_ok:
                            	  7372:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7373:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004C9BE 7600            	  7374:     moveq   #0,D3
02:0004C9C0 162C0525        	  7375:     move.b  ($0525,A4),D3
02:0004C9C4 0243000F        	  7376:     andi.w  #$000F,D3
02:0004C9C8 C6FC002C        	  7377:     mulu.w  #44,D3
02:0004C9CC 203C00FF6530    	  7378:     move.l  #$FF6530,D0
02:0004C9D2 D083            	  7379:     add.l   D3,D0
02:0004C9D4 7600            	  7380:     moveq   #0,D3
02:0004C9D6 162C0525        	  7381:     move.b  ($0525,A4),D3
02:0004C9DA E84B            	  7382:     lsr.w   #4,D3
02:0004C9DC 5943            	  7383:     subi.w  #4,D3
02:0004C9DE E34B            	  7384:     lsl.w   #1,D3
02:0004C9E0 D083            	  7385:     add.l   D3,D0
02:0004C9E2 2040            	  7386:     movea.l D0,A0
02:0004C9E4 1010            	  7387:     move.b  (A0),D0
02:0004C9E6 0C000084        	  7388:     cmpi.b  #$84,D0
02:0004C9EA 6544            	  7389:     blo     _L_z07_P47_post2_ok
                            	  7390:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7391:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7392:     ; writes to the $05xx region.
02:0004C9EC 7800            	  7393:     moveq   #0,D4
                            	  7394: _L_z07_P47_fb_loop:
02:0004C9EE 41FAE48C        	  7395:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004C9F2 12304000        	  7396:     move.b  (A0,D4.W),D1
02:0004C9F6 19410525        	  7397:     move.b  D1,($0525,A4)
                            	  7398:     ; Validate fallback cell walkable.
02:0004C9FA 7600            	  7399:     moveq   #0,D3
02:0004C9FC 1601            	  7400:     move.b  D1,D3
02:0004C9FE 0243000F        	  7401:     andi.w  #$000F,D3
02:0004CA02 C6FC002C        	  7402:     mulu.w  #44,D3
02:0004CA06 203C00FF6530    	  7403:     move.l  #$FF6530,D0
02:0004CA0C D083            	  7404:     add.l   D3,D0
02:0004CA0E 7600            	  7405:     moveq   #0,D3
02:0004CA10 1601            	  7406:     move.b  D1,D3
02:0004CA12 E84B            	  7407:     lsr.w   #4,D3
02:0004CA14 5943            	  7408:     subi.w  #4,D3
02:0004CA16 E34B            	  7409:     lsl.w   #1,D3
02:0004CA18 D083            	  7410:     add.l   D3,D0
02:0004CA1A 2040            	  7411:     movea.l D0,A0
02:0004CA1C 0C100084        	  7412:     cmpi.b  #$84,(A0)
02:0004CA20 650E            	  7413:     blo     _L_z07_P47_post2_ok
02:0004CA22 5204            	  7414:     addq.b  #1,D4
02:0004CA24 0C040008        	  7415:     cmpi.b  #8,D4
02:0004CA28 65C4            	  7416:     blo     _L_z07_P47_fb_loop
                            	  7417:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7418:     ; rather than looping).
02:0004CA2A 197C00480525    	  7419:     move.b  #$48,($0525,A4)
                            	  7420: _L_z07_P47_post2_ok:
                            	  7421:     ; Extract and set the monster's location.
                            	  7422:     ;
02:0004CA30 102C0525        	  7423:     move.b  ($0525,A4),D0
                            	  7424:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7425:     ;
02:0004CA34 1B00            	  7426:     move.b  D0,-(A5)  ; PHA
02:0004CA36 E308            	  7427:     lsl.b  #1,D0   ; ASL A
02:0004CA38 E308            	  7428:     lsl.b  #1,D0   ; ASL A
02:0004CA3A E308            	  7429:     lsl.b  #1,D0   ; ASL A
02:0004CA3C E308            	  7430:     lsl.b  #1,D0   ; ASL A
02:0004CA3E 19802070        	  7431:     move.b  D0,($70,A4,D2.W)
                            	  7432:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7433:     ;
02:0004CA42 101D            	  7434:     move.b  (A5)+,D0  ; PLA
02:0004CA44 020000F0        	  7435:     andi.b #$F0,D0
02:0004CA48 003C0011        	  7436:     ori     #$11,CCR  ; SEC: set C+X
02:0004CA4C 123C0003        	  7437:     move.b  #$03,D1
02:0004CA50 0A3C0010        	  7438:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004CA54 9101            	  7439:     subx.b  D1,D0   ; SBC #$03
02:0004CA56 0A3C0010        	  7440:     eori    #$10,CCR  ; restore X = 6502 C
02:0004CA5A 41EC0084        	  7441:     lea     ($0084,A4),A0
02:0004CA5E 11802000        	  7442:     move.b  D0,(A0,D2.W)
                            	  7443:     ; Set the monsters-from-edges long timer to a random value
                            	  7444:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7445:     ;
02:0004CA62 10342019        	  7446:     move.b  ($19,A4,D2.W),D0
02:0004CA66 02000003        	  7447:     andi.b #$03,D0
02:0004CA6A 023C00EE        	  7448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CA6E 123C0002        	  7449:     move.b  #$02,D1
02:0004CA72 D101            	  7450:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004CA74 1940004B        	  7451:     move.b  D0,($004B,A4)
                            	  7452:     ; If the distance to Link is too close to Link, then
                            	  7453:     ; go flag the monster uninitialized again, so we can
                            	  7454:     ; try to spawn it again next time.
                            	  7455:     ;
02:0004CA78 7005            	  7456:     moveq   #5,D0
02:0004CA7A 61000414        	  7457:     jsr     SwitchBank
02:0004CA7E 4EB900040D40    	  7458:     jsr     IsDistanceSafeToSpawn
02:0004CA84 6500FEB4        	  7459:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7460:     ; OK to spawn.
                            	  7461:     ; In this situation, monsters don't spawn from a cloud.
                            	  7462:     ;
02:0004CA88 7000            	  7463:     moveq   #0,D0
02:0004CA8A 41EC0405        	  7464:     lea     ($0405,A4),A0
02:0004CA8E 11802000        	  7465:     move.b  D0,(A0,D2.W)
                            	  7466:     even
                            	  7467: _L_z07_InitObject_NormalSpawn:
02:0004CA92 7004            	  7468:     moveq   #4,D0
02:0004CA94 610003FA        	  7469:     jsr     SwitchBank
                            	  7470:     ; For monsters that spawn in a cloud, set their start time to
                            	  7471:     ; the same value as the object slot; so that they all start
                            	  7472:     ; moving at different times.
                            	  7473:     ;
02:0004CA98 7400            	  7474:     moveq   #0,D2
02:0004CA9A 142C0340        	  7475:     move.b  ($0340,A4),D2
02:0004CA9E 7600            	  7476:     moveq   #0,D3
02:0004CAA0 41EC034F        	  7477:     lea     ($034F,A4),A0
02:0004CAA4 16302000        	  7478:     move.b  (A0,D2.W),D3
02:0004CAA8 0C03001E        	  7479:     cmpi.b  #$1E,D3
02:0004CAAC 6712            	  7480:     beq  _L_z07_InitObject_FetchAttrs
02:0004CAAE 0C030022        	  7481:     cmpi.b  #$22,D3
02:0004CAB2 670C            	  7482:     beq  _L_z07_InitObject_FetchAttrs
02:0004CAB4 0C030053        	  7483:     cmpi.b  #$53,D3
02:0004CAB8 6406            	  7484:     bcc  _L_z07_InitObject_FetchAttrs
02:0004CABA 1002            	  7485:     move.b  D2,D0
02:0004CABC 19802028        	  7486:     move.b  D0,($28,A4,D2.W)
                            	  7487:     even
                            	  7488: _L_z07_InitObject_FetchAttrs:
                            	  7489:     ; Store the object attributes for fast access.
