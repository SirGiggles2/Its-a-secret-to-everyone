                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:000430C4 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:000430C8 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
