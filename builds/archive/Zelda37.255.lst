                            	  3597: 
                            	  3598: ; Each byte describes an item. The high nibble is the type.
                            	  3599: ; The low nibble is the value. Its meaning depends on the type.
                            	  3600: ;
                            	  3601: ; 0x - individuals
                            	  3602: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  3603: ; * bit mask: value doesn't matter.
                            	  3604: ;
                            	  3605: ; 1x - amounts
                            	  3606: ; Value is an amount to add.
                            	  3607: ;
                            	  3608: ; 2x - grades
                            	  3609: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  3610: ;
                            	  3611: ; 3x - error?
                            	  3612: ; Produces an item value of $FF.
                            	  3613: ;
                            	  3614:     even
                            	  3615: ItemIdToDescriptor:
