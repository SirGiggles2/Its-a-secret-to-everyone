                            	  3641: SecretArmosXs:
02:0003ACAC E0              	  3642:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003ACAD B0
02:0003ACAE B0
02:0003ACAF 30
02:0003ACB0 40
02:0003ACB1 90
02:0003ACB2 A0
