02:00031EF6 123C0006        	  5971:     move.b  #$06,D1
02:00031EFA D101            	  5972:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00031EFC 19400004        	  5973:     move.b  D0,($0004,A4)
02:00031F00 41EC0084        	  5974:     lea     ($0084,A4),A0
02:00031F04 10303000        	  5975:     move.b  (A0,D3.W),D0
02:00031F08 023C00EE        	  5976:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031F0C 123C0008        	  5977:     move.b  #$08,D1
