                            	  1191: _L_z04_UpdateFireball_Move:
                            	  1192:     ; A movement routine is used that works along one axis.
                            	  1193:     ; So, load its parameters, and call it for each axis individually.
                            	  1194:     ;
                            	  1195:     ; First, load the horizontal direction into [0F].
                            	  1196:     ;
02:00039BA4 41EC0412        	  1197:     lea     ($0412,A4),A0
02:00039BA8 10302000        	  1198:     move.b  (A0,D2.W),D0
02:00039BAC 1940000F        	  1199:     move.b  D0,($000F,A4)
                            	  1200:     ; Load the horizontal q-speed and position fraction,
                            	  1201:     ; move, then save the position fraction.
                            	  1202:     ;
02:00039BB0 41EC041F        	  1203:     lea     ($041F,A4),A0
02:00039BB4 10302000        	  1204:     move.b  (A0,D2.W),D0
02:00039BB8 7600            	  1205:     moveq   #0,D3
02:00039BBA 41EC0451        	  1206:     lea     ($0451,A4),A0
02:00039BBE 16302000        	  1207:     move.b  (A0,D2.W),D3
02:00039BC2 613E            	  1208:     jsr     Fireball_MoveOneAxis
02:00039BC4 41EC0451        	  1209:     lea     ($0451,A4),A0
02:00039BC8 11802000        	  1210:     move.b  D0,(A0,D2.W)
                            	  1211:     ; Second, load the vertical direction into [0F].
                            	  1212:     ;
02:00039BCC 41EC0437        	  1213:     lea     ($0437,A4),A0
02:00039BD0 10302000        	  1214:     move.b  (A0,D2.W),D0
02:00039BD4 1940000F        	  1215:     move.b  D0,($000F,A4)
                            	  1216:     ; Load the vertical q-speed and position fraction,
                            	  1217:     ; move, then save the position fraction.
                            	  1218:     ;
02:00039BD8 41EC0444        	  1219:     lea     ($0444,A4),A0
02:00039BDC 10302000        	  1220:     move.b  (A0,D2.W),D0
02:00039BE0 7600            	  1221:     moveq   #0,D3
02:00039BE2 41EC045E        	  1222:     lea     ($045E,A4),A0
02:00039BE6 16302000        	  1223:     move.b  (A0,D2.W),D3
02:00039BEA 6116            	  1224:     jsr     Fireball_MoveOneAxis
02:00039BEC 41EC045E        	  1225:     lea     ($045E,A4),A0
