02:00042E44 122C00EE        	  5403:     move.b  ($00EE,A4),D1
02:00042E48 C001            	  5404:     and.b  D1,D0
02:00042E4A 194000EE        	  5405:     move.b  D0,($00EE,A4)
02:00042E4E 101D            	  5406:     move.b  (A5)+,D0  ; PLA
                            	  5407:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5408:     ;
02:00042E50 0C000001        	  5409:     cmpi.b  #$01,D0
02:00042E54 6402            	  5410:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00042E56 7004            	  5411:     moveq   #4,D0
                            	  5412:     even
                            	  5413: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5414:     ; The door attribute (DA) has been mapped to a
                            	  5415:     ; provisional door face value (PF) in %A as follows:
                            	  5416:     ;
                            	  5417:     ; DA PF Meaning
                            	  5418:     ; -------------
                            	  5419:     ; 0  4  open
                            	  5420:     ; 1  1  wall
                            	  5421:     ; 2  2  false wall
                            	  5422:     ; 3  3  false wall 2
                            	  5423:     ; 4  8  bombable
                            	  5424:     ; 5  5  key
                            	  5425:     ; 6  6  key 2
                            	  5426:     ; 7  7  shutter
                            	  5427:     ;
                            	  5428:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5429:     ; has been cleared, if the type was "open" or any wall.
                            	  5430:     ;
                            	  5431:     ;
                            	  5432:     ; Save the provisional face.
02:00042E58 1B00            	  5433:     move.b  D0,-(A5)  ; PHA
                            	  5434:     ; If the current direction points to a door that has been opened,
                            	  5435:     ; then see if we need to set door flags.
                            	  5436:     ;
02:00042E5A 102C00EE        	  5437:     move.b  ($00EE,A4),D0
02:00042E5E 122C0002        	  5438:     move.b  ($0002,A4),D1
02:00042E62 C001            	  5439:     and.b  D1,D0
02:00042E64 7400            	  5440:     moveq   #0,D2
02:00042E66 1400            	  5441:     move.b  D0,D2
02:00042E68 101D            	  5442:     move.b  (A5)+,D0  ; PLA
02:00042E6A 122C0002        	  5443:     move.b  ($0002,A4),D1
02:00042E6E B401            	  5444:     cmp.b   D1,D2
02:00042E70 6624            	  5445:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5446:     ; The current direction points to a door that has been opened.
                            	  5447:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5448:     ;
                            	  5449:     ;
                            	  5450:     ; Save provisional door face in Y register.
02:00042E72 7600            	  5451:     moveq   #0,D3
02:00042E74 1600            	  5452:     move.b  D0,D3
02:00042E76 101D            	  5453:     move.b  (A5)+,D0  ; PLA
02:00042E78 1B00            	  5454:     move.b  D0,-(A5)  ; PHA
02:00042E7A 7400            	  5455:     moveq   #0,D2
02:00042E7C 1400            	  5456:     move.b  D0,D2
02:00042E7E 1003            	  5457:     move.b  D3,D0
                            	  5458:     ; If provisional door face is not for a shutter, then
                            	  5459:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5460:     ;
                            	  5461:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5462:     ;
02:00042E80 0C000007        	  5463:     cmpi.b  #$07,D0
02:00042E84 670E            	  5464:     beq  _anon_z05_111
02:00042E86 1B00            	  5465:     move.b  D0,-(A5)  ; PHA
02:00042E88 6100DF68        	  5466:     jsr     SetDoorFlag
02:00042E8C 101D            	  5467:     move.b  (A5)+,D0  ; PLA
                            	  5468:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5469:     ; then go make it 9 (open "bombable").
                            	  5470:     ; Else make it 4 (open "door").
                            	  5471:     ;
02:00042E8E 0C000008        	  5472:     cmpi.b  #$08,D0
02:00042E92 67A4            	  5473:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5474: _anon_z05_111:
02:00042E94 7004            	  5475:     moveq   #4,D0
                            	  5476:     even
                            	  5477: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5478:     ; For opened doors, the provisional door face has become:
                            	  5479:     ;
                            	  5480:     ; DA PF Meaning
                            	  5481:     ; -------------
                            	  5482:     ; 0  4  open
                            	  5483:     ; 1  1  wall
                            	  5484:     ; 2  2  false wall
                            	  5485:     ; 3  3  false wall 2
                            	  5486:     ; 4  9  bombable
                            	  5487:     ; 5  4  key
                            	  5488:     ; 6  4  key 2
                            	  5489:     ; 7  4  shutter
                            	  5490:     ;
                            	  5491:     ;
                            	  5492:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5493:     ;
02:00042E96 7400            	  5494:     moveq   #0,D2
02:00042E98 142C0006        	  5495:     move.b  ($0006,A4),D2
02:00042E9C 6712            	  5496:     beq  _anon_z05_112
02:00042E9E 7400            	  5497:     moveq   #0,D2
02:00042EA0 142C000B        	  5498:     move.b  ($000B,A4),D2
02:00042EA4 1B00            	  5499:     move.b  D0,-(A5)  ; PHA
02:00042EA6 6100FCC8        	  5500:     jsr     FindDoorAttrByDoorBit
02:00042EAA 61001C62        	  5501:     jsr     CalcOpenDoorwayMask
02:00042EAE 101D            	  5502:     move.b  (A5)+,D0  ; PLA
                            	  5503: _anon_z05_112:
                            	  5504:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5505:     ; because the visible door face is already a wall.
                            	  5506:     ;
02:00042EB0 0C000004        	  5507:     cmpi.b  #$04,D0
02:00042EB4 650000DC        	  5508:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5509:     ; For all other provisional face values, calculate:
                            	  5510:     ; door face := provisional face - 3
02:00042EB8 003C0011        	  5511:     ori     #$11,CCR  ; SEC: set C+X
02:00042EBC 123C0003        	  5512:     move.b  #$03,D1
02:00042EC0 0A3C0010        	  5513:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042EC4 9101            	  5514:     subx.b  D1,D0   ; SBC #$03
02:00042EC6 0A3C0010        	  5515:     eori    #$10,CCR  ; restore X = 6502 C
02:00042ECA 7600            	  5516:     moveq   #0,D3
02:00042ECC 1600            	  5517:     move.b  D0,D3
                            	  5518:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5519:     ; subtract one.
                            	  5520:     ;
02:00042ECE 0C030003        	  5521:     cmpi.b  #$03,D3
02:00042ED2 6502            	  5522:     bcs  _anon_z05_113
02:00042ED4 5303            	  5523:     subq.b  #1,D3
                            	  5524: _anon_z05_113:
                            	  5525:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5526:     ;
                            	  5527:     ; DT DFC DFO Meaning
                            	  5528:     ; ------------------
                            	  5529:     ; 0  1   1   open
                            	  5530:     ; 4  4   5   bombable
                            	  5531:     ; 5  2   1   key
                            	  5532:     ; 6  2   1   key 2
                            	  5533:     ; 7  3   1   shutter
                            	  5534:     ;
                            	  5535:     ;
                            	  5536:     ; Get the direction index.
02:00042ED6 101D            	  5537:     move.b  (A5)+,D0  ; PLA
02:00042ED8 1B00            	  5538:     move.b  D0,-(A5)  ; PHA
02:00042EDA 610000D0        	  5539:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5540:     ; If handling the second half, then offset to the second half
                            	  5541:     ; of the tiles.
                            	  5542:     ;
02:00042EDE 102C0006        	  5543:     move.b  ($0006,A4),D0
02:00042EE2 6618            	  5544:     bne  _anon_z05_114
02:00042EE4 41F900042DFA    	  5545:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00042EEA 10302000        	  5546:     move.b  (A0,D2.W),D0
02:00042EEE 4EB900030CEE    	  5547:     jsr     AddToInt16At0
02:00042EF4 7006            	  5548:     moveq   #6,D0
02:00042EF6 4EB900030CF6    	  5549:     jsr     AddToInt16At2
                            	  5550: _anon_z05_114:
                            	  5551:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5552:     ; Pointers will be incremented instead of Y.
02:00042EFC 7600            	  5553:     moveq   #0,D3
02:00042EFE 41F900042DFE    	  5554:     lea     (DirIndexToDoorColumnCount).l,A0
02:00042F04 10302000        	  5555:     move.b  (A0,D2.W),D0
02:00042F08 19400005        	  5556:     move.b  D0,($0005,A4)
