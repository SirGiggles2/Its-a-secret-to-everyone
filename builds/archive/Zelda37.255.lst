02:0003D836 0C030060        	  9590:     cmpi.b  #$60,D3
02:0003D83A 6402            	  9591:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003D83C E308            	  9592:     lsl.b  #1,D0   ; ASL A
