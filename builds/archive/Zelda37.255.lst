                            	  1815: InitTrap_Full:
                            	  1816:     ; Copy this parent/generator object's attributes to [01].
                            	  1817:     ;
02:00030192 41EC04BF        	  1818:     lea     ($04BF,A4),A0
02:00030196 10302000        	  1819:     move.b  (A0,D2.W),D0
02:0003019A 19400001        	  1820:     move.b  D0,($0001,A4)
                            	  1821:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  1822:     ;
02:0003019E 7605            	  1823:     moveq   #5,D3
                            	  1824:     ; The individual trap objects to make will be of type $49.
                            	  1825:     ; Store it in [00].
                            	  1826:     ;
02:000301A0 7049            	  1827:     moveq   #73,D0
02:000301A2 1880            	  1828:     move.b  D0,($0000,A4)
                            	  1829:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  1830:     ; then we'll make 4 traps.
                            	  1831:     ;
02:000301A4 41EC034F        	  1832:     lea     ($034F,A4),A0
02:000301A8 12302000        	  1833:     move.b  (A0,D2.W),D1
02:000301AC B001            	  1834:     cmp.b   D1,D0
02:000301AE 6702            	  1835:     beq  _L_z01_InitTrap_Full_LoopTrap
02:000301B0 7603            	  1836:     moveq   #3,D3
                            	  1837:     even
                            	  1838: _L_z01_InitTrap_Full_LoopTrap:
                            	  1839:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
