                            	  2969: 
                            	  2970: ; Params:
                            	  2971: ; Y: middle speed index (4)
                            	  2972: ; [03]: horizontal distance
                            	  2973: ; [04]: vertical distance
                            	  2974: ; [0A]: vertical direction
                            	  2975: ; [0B]: horizontal direction
                            	  2976: ;
                            	  2977: ; Returns:
                            	  2978: ; Y: speed index (0 to 8) for the angle
                            	  2979: ;
                            	  2980: ;
                            	  2981: ; TODO: call it speed index or angle?
                            	  2982: ; Store the middle speed index in [00]. It will be changed to the
                            	  2983: ; right speed index to use incrementally.
                            	  2984: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  2985: ; Higher speed indexes yield faster Y speeds and lower X speeds.
