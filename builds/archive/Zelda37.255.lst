02:0004BE1A 122C0004        	  5869:     move.b  ($0004,A4),D1
02:0004BE1E D101            	  5870:     addx.b  D1,D0   ; ADC $04
02:0004BE20 19400004        	  5871:     move.b  D0,($0004,A4)
02:0004BE24 761D            	  5872:     moveq   #29,D3
