                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:0003FB1E 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0003FB22 02000010        	   426:     andi.b #$10,D0
02:0003FB26 6606            	   427:     bne.s  __far_z_05_0000
02:0003FB28 4EF90002D96C    	   428:     jmp  Exit
