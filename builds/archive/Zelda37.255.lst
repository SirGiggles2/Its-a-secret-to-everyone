                            	  1799: _L_z05_InitMode_EnterRoom_Method2:
                            	  1800:     ; Enter method 2.
                            	  1801:     ; Room to room.
                            	  1802:     ;
                            	  1803:     ; Get the direction that the player is entering from.
                            	  1804:     ;
02:000409AC 102C0098        	  1805:     move.b  ($0098,A4),D0
02:000409B0 19400053        	  1806:     move.b  D0,($0053,A4)
02:000409B4 4EB900030896    	  1807:     jsr     GetOppositeDir
                            	  1808:     ; If the player is entering from a door that was opened, then
                            	  1809:     ; set the "close" door command.
                            	  1810:     ;
02:000409BA 122C00EE        	  1811:     move.b  ($00EE,A4),D1
02:000409BE C001            	  1812:     and.b  D1,D0
02:000409C0 19400055        	  1813:     move.b  D0,($0055,A4)
02:000409C4 6706            	  1814:     beq  _anon_z05_43
02:000409C6 7002            	  1815:     moveq   #2,D0
02:000409C8 19400054        	  1816:     move.b  D0,($0054,A4)
                            	  1817: _anon_z05_43:
