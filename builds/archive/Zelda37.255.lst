02:0003A948 646A            	  3162:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3163:     ; Face in the same direction as Link.
                            	  3164:     ;
02:0003A94A 102C0098        	  3165:     move.b  ($0098,A4),D0
02:0003A94E 41EC0098        	  3166:     lea     ($0098,A4),A0
02:0003A952 11802000        	  3167:     move.b  D0,(A0,D2.W)
                            	  3168:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3169:     ;
02:0003A956 10342019        	  3170:     move.b  ($19,A4,D2.W),D0
02:0003A95A 0C0000C0        	  3171:     cmpi.b  #$C0,D0
02:0003A95E 6506            	  3172:     bcs  _anon_z04_43
02:0003A960 4EB90004B41C    	  3173:     jsr     ReverseObjDir
                            	  3174: _anon_z04_43:
                            	  3175:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3176:     ;
02:0003A966 41EC0098        	  3177:     lea     ($0098,A4),A0
02:0003A96A 10302000        	  3178:     move.b  (A0,D2.W),D0
02:0003A96E 0200000C        	  3179:     andi.b #$0C,D0
02:0003A972 6742            	  3180:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3181:     ; Begin with the leever's X set to Link's X.
                            	  3182:     ;
