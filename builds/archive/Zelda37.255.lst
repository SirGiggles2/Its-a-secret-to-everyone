02:00043CF6 B001            	  7157:     cmp.b   D1,D0
02:00043CF8 6704            	  7158:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00043CFA 5302            	  7159:     subq.b  #1,D2
02:00043CFC 66EE            	  7160:     bne  _anon_z05_149
