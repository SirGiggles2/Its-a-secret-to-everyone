02:0003C5E0 7600            	  7094:     moveq   #0,D3
02:0003C5E2 61000082        	  7095:     jsr     Dodongo_IsBombInRange
02:0003C5E6 660A            	  7096:     bne  _L_z04_Dodongo_CheckBombHit_Exit
