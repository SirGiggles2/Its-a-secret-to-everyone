02:0003A2A0 6720            	  2207:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A2A2 0C000009        	  2208:     cmpi.b  #$09,D0
02:0003A2A6 671A            	  2209:     beq  _L_z04__TryShooting_TryShootingNow
