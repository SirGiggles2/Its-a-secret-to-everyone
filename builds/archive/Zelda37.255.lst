02:0003D82A 16342018        	  9586:     move.b  ($18,A4,D2.W),D3
02:0003D82E 0C0300B0        	  9587:     cmpi.b  #$B0,D3
02:0003D832 640A            	  9588:     bcc  _L_z04_UpdateGohma_ChangeDir
