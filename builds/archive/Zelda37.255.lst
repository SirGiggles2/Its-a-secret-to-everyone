                            	 12167: UpdateGanon:
02:0003EB86 102C0445        	 12168:     move.b  ($0445,A4),D0
02:0003EB8A 4EB90002AECA    	 12169:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	 12170:     even
                            	 12171: UpdateGanon_JumpTable:
02:0003EB90 0003EB9C        	 12172:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003EB94 0003EBFE        	 12173:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003EB98 0003EC2C        	 12174:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12175: 
                            	 12176: ; Description:
                            	 12177: ; Lift up the Triforce of Courage while the room is dark.
                            	 12178: ;
                            	 12179: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12180: ;
                            	 12181:     even
                            	 12182: Ganon_ScenePhase0:
02:0003EB9C 701B            	 12183:     moveq   #27,D0
02:0003EB9E 19400505        	 12184:     move.b  D0,($0505,A4)
                            	 12185:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12186:     ;
02:0003EBA2 102C0028        	 12187:     move.b  ($0028,A4),D0
02:0003EBA6 6644            	 12188:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12189:     ; Once the timer expires, it's time to brighten the room.
                            	 12190:     ;
                            	 12191:     ; Save the current object slot.
02:0003EBA8 1002            	 12192:     move.b  D2,D0
02:0003EBAA 1B00            	 12193:     move.b  D0,-(A5)  ; PHA
02:0003EBAC 610007F0        	 12194:     jsr     UpdateCandle
02:0003EBB0 101D            	 12195:     move.b  (A5)+,D0  ; PLA
02:0003EBB2 7400            	 12196:     moveq   #0,D2
02:0003EBB4 1400            	 12197:     move.b  D0,D2
                            	 12198:     ; Turn off the room brightening flag, because we're controlling it
                            	 12199:     ; here instead of in the Mode 5 object update loop.
                            	 12200:     ;
02:0003EBB6 7000            	 12201:     moveq   #0,D0
02:0003EBB8 1940051E        	 12202:     move.b  D0,($051E,A4)
                            	 12203:     ; On the first frame of the fade-to-light cycle, play the
                            	 12204:     ; Triforce/Ganon song.
                            	 12205:     ;
02:0003EBBC 102C051C        	 12206:     move.b  ($051C,A4),D0
02:0003EBC0 0C0000C0        	 12207:     cmpi.b  #$C0,D0
02:0003EBC4 6606            	 12208:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003EBC6 7002            	 12209:     moveq   #2,D0
02:0003EBC8 19400600        	 12210:     move.b  D0,($0600,A4)
                            	 12211:     even
                            	 12212: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12213:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12214:     ;
02:0003EBCC 102C051C        	 12215:     move.b  ($051C,A4),D0
02:0003EBD0 0200000F        	 12216:     andi.b #$0F,D0
02:0003EBD4 0C000004        	 12217:     cmpi.b  #$04,D0
02:0003EBD8 6702            	 12218:     beq.s  __far_z_04_0115
02:0003EBDA 6042            	 12219:     jmp  Ganon_DrawBodyFrame0
                            	 12220: __far_z_04_0115:
                            	 12221:     ; Set Link's timer to $C0 for the next scene phase.
                            	 12222:     ;
02:0003EBDC 103C00C0        	 12223:     move.b  #$C0,D0
02:0003EBE0 19400028        	 12224:     move.b  D0,($0028,A4)
                            	 12225:     ; Set scene phase 1, and go draw Ganon.
                            	 12226:     ;
02:0003EBE4 522C0445        	 12227:     addq.b  #1,($0445,A4)
02:0003EBE8 6702            	 12228:     beq.s  __far_z_04_0116
02:0003EBEA 6032            	 12229:     jmp  Ganon_DrawBodyFrame0
                            	 12230: __far_z_04_0116:
                            	 12231:     even
                            	 12232: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	 12233:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	 12234:     ; In this case, I think it means Ganon is shouting.
                            	 12235:     ;
02:0003EBEC 0C000001        	 12236:     cmpi.b  #$01,D0
