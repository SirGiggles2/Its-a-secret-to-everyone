02:0003C9BC 6502            	  7691:     bcs  _anon_z04_98
02:0003C9BE 7607            	  7692:     moveq   #7,D3
                            	  7693: _anon_z04_98:
                            	  7694:     ; Set the vertical speed for the beginning of the jump.
                            	  7695:     ;
02:0003C9C0 41F90003C8B4    	  7696:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003C9C6 10303000        	  7697:     move.b  (A0,D3.W),D0
02:0003C9CA 41EC0412        	  7698:     lea     ($0412,A4),A0
02:0003C9CE 11802000        	  7699:     move.b  D0,(A0,D2.W)
                            	  7700:     ; Look up the Y offset for the current direction.
                            	  7701:     ; Add it to object Y to set the destination Y of the jump.
                            	  7702:     ;
02:0003C9D2 41EC0084        	  7703:     lea     ($0084,A4),A0
02:0003C9D6 10302000        	  7704:     move.b  (A0,D2.W),D0
02:0003C9DA 023C00EE        	  7705:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C9DE 41F90003C8BC    	  7706:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003C9E4 12303000        	  7707:     move.b  (A0,D3.W),D1
02:0003C9E8 D101            	  7708:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003C9EA 41EC042C        	  7709:     lea     ($042C,A4),A0
02:0003C9EE 11802000        	  7710:     move.b  D0,(A0,D2.W)
                            	  7711:     ; Turn the index into a direction again by adding 1.
