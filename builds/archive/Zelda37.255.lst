02:0003B9FC 7070            	  5479:     moveq   #112,D0
02:0003B9FE 41EC0085        	  5480:     lea     ($0085,A4),A0
02:0003BA02 11803000        	  5481:     move.b  D0,(A0,D3.W)
                            	  5482:     ; Start with no direction, no deferred bounce direction,
                            	  5483:     ; and ready to update.
                            	  5484:     ;
02:0003BA06 7000            	  5485:     moveq   #0,D0
02:0003BA08 41EC0099        	  5486:     lea     ($0099,A4),A0
02:0003BA0C 11803000        	  5487:     move.b  D0,(A0,D3.W)
02:0003BA10 41EC03BD        	  5488:     lea     ($03BD,A4),A0
02:0003BA14 11803000        	  5489:     move.b  D0,(A0,D3.W)
02:0003BA18 41EC0406        	  5490:     lea     ($0406,A4),A0
02:0003BA1C 11803000        	  5491:     move.b  D0,(A0,D3.W)
02:0003BA20 41EC0493        	  5492:     lea     ($0493,A4),A0
02:0003BA24 11803000        	  5493:     move.b  D0,(A0,D3.W)
                            	  5494:     ; Copy object attributes from the first monster slot.
                            	  5495:     ;
02:0003BA28 102C04C0        	  5496:     move.b  ($04C0,A4),D0
02:0003BA2C 41EC04C0        	  5497:     lea     ($04C0,A4),A0
02:0003BA30 11803000        	  5498:     move.b  D0,(A0,D3.W)
                            	  5499:     ; Copy HP from the first monster slot.
                            	  5500:     ;
02:0003BA34 102C0486        	  5501:     move.b  ($0486,A4),D0
02:0003BA38 41EC0486        	  5502:     lea     ($0486,A4),A0
02:0003BA3C 11803000        	  5503:     move.b  D0,(A0,D3.W)
                            	  5504:     ; Start with flying speed $80, and in flying state 2.
                            	  5505:     ;
02:0003BA40 103C0080        	  5506:     move.b  #$80,D0
02:0003BA44 41EC0420        	  5507:     lea     ($0420,A4),A0
02:0003BA48 11803000        	  5508:     move.b  D0,(A0,D3.W)
02:0003BA4C 7002            	  5509:     moveq   #2,D0
02:0003BA4E 41EC0445        	  5510:     lea     ($0445,A4),A0
02:0003BA52 11803000        	  5511:     move.b  D0,(A0,D3.W)
02:0003BA56 7041            	  5512:     moveq   #65,D0
02:0003BA58 41EC0350        	  5513:     lea     ($0350,A4),A0
02:0003BA5C 11803000        	  5514:     move.b  D0,(A0,D3.W)
                            	  5515:     ; Bottom of the loop.
                            	  5516:     ;
02:0003BA60 5303            	  5517:     subq.b  #1,D3
02:0003BA62 6A90            	  5518:     bpl  _anon_z04_77
                            	  5519:     ; Choose a random 8-way direction for the head segments
                            	  5520:     ; in slots 4 and 9.
                            	  5521:     ;
02:0003BA64 102C001D        	  5522:     move.b  ($001D,A4),D0
02:0003BA68 02000007        	  5523:     andi.b #$07,D0
02:0003BA6C 7600            	  5524:     moveq   #0,D3
02:0003BA6E 1600            	  5525:     move.b  D0,D3
02:0003BA70 41F90003F44C    	  5526:     lea     (Directions8).l,A0
02:0003BA76 10303000        	  5527:     move.b  (A0,D3.W),D0
02:0003BA7A 1940009D        	  5528:     move.b  D0,($009D,A4)
02:0003BA7E 19400385        	  5529:     move.b  D0,($0385,A4)
02:0003BA82 102C0022        	  5530:     move.b  ($0022,A4),D0
02:0003BA86 02000007        	  5531:     andi.b #$07,D0
02:0003BA8A 7600            	  5532:     moveq   #0,D3
02:0003BA8C 1600            	  5533:     move.b  D0,D3
02:0003BA8E 41F90003F44C    	  5534:     lea     (Directions8).l,A0
02:0003BA94 10303000        	  5535:     move.b  (A0,D3.W),D0
02:0003BA98 194000A2        	  5536:     move.b  D0,($00A2,A4)
02:0003BA9C 1940038A        	  5537:     move.b  D0,($038A,A4)
                            	  5538:     ; Set minimum number of turns 1 for flying states.
                            	  5539:     ;
                            	  5540:     ; By setting this, the first time that a flight control routine
                            	  5541:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  5542:     ; that flying state will immediately end, and object timer
                            	  5543:     ; will be left 0: ready for moldorm to decide a flying state
                            	  5544:     ; randomly and set timer to $10.
                            	  5545:     ;
02:0003BAA0 7001            	  5546:     moveq   #1,D0
02:0003BAA2 19400431        	  5547:     move.b  D0,($0431,A4)
02:0003BAA6 19400436        	  5548:     move.b  D0,($0436,A4)
02:0003BAAA 103C0080        	  5549:     move.b  #$80,D0
02:0003BAAE 194004D1        	  5550:     move.b  D0,($04D1,A4)
02:0003BAB2 7008            	  5551:     moveq   #8,D0
02:0003BAB4 1940034E        	  5552:     move.b  D0,($034E,A4)
02:0003BAB8 4E75            	  5553:     rts
