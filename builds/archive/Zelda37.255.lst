02:000441A2 1B00            	  7401:     move.b  D0,-(A5)  ; PHA
02:000441A4 02000007        	  7402:     andi.b #$07,D0
02:000441A8 0C000002        	  7403:     cmpi.b  #$02,D0
02:000441AC 6606            	  7404:     bne  _anon_z05_156
