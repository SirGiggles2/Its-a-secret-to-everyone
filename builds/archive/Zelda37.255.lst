02:00031B74 41EC04B2        	  5383:     lea     ($04B2,A4),A0
02:00031B78 10302000        	  5384:     move.b  (A0,D2.W),D0
02:00031B7C 122C0009        	  5385:     move.b  ($0009,A4),D1
02:00031B80 C001            	  5386:     and.b  D1,D0
02:00031B82 6704            	  5387:     beq  _anon_z01_88
02:00031B84 61000348        	  5388:     jsr     PlayParryTune
                            	  5389: _anon_z01_88:
                            	  5390:     ; Set the boomerang state to return fast to the thrower.
