                            	  3150: _anon_z04_42:
                            	  3151:     ; State 0.
                            	  3152:     ;
                            	  3153:     ; In state we determine whether to burst out of the ground.
                            	  3154:     ; If the long timer has not expired, then return.
                            	  3155:     ;
