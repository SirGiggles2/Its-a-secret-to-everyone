02:0003E704 41EC0350        	 11525:     lea     ($0350,A4),A0
02:0003E708 11803000        	 11526:     move.b  D0,(A0,D3.W)
02:0003E70C 4EF90004CD3C    	 11527:     jmp     ResetObjMetastate
