02:00034A10 10303000        	  2592:     move.b  (A0,D3.W),D0
02:00034A14 41EC0302        	  2593:     lea     ($0302,A4),A0
02:00034A18 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:00034A1C 5303            	  2595:     subq.b  #1,D3
02:00034A1E 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034A20 19430306        	  2597:     move.b  D3,($0306,A4)
02:00034A24 7400            	  2598:     moveq   #0,D2
