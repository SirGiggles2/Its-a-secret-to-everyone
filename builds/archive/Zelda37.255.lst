02:0004ACA8 19400060        	  3232:     move.b  D0,($0060,A4)
02:0004ACAC 671C            	  3233:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3234:     ; If Link's X has not changed since the last frame
                            	  3235:     ; (when Link was the target), then XOR the chase target
                            	  3236:     ; coordinates (which were Link's coordinates last frame).
                            	  3237:     ;
                            	  3238:     ; This ends up reflecting Link's coordinates across the room;
                            	  3239:     ; so that monsters chase away from him.
                            	  3240:     ;
