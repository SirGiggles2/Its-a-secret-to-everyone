02:00043186 2044            	  5906:     movea.l D4,A0
02:00043188 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004318C 41F90004A2CE    	  5908:     lea     (LevelMasks).l,A0
02:00043192 12302000        	  5909:     move.b  (A0,D2.W),D1
02:00043196 8001            	  5910:     or.b  D1,D0
02:00043198 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:0004319A 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:0004319E 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
