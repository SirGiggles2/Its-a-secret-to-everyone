02:0004CACA 41EC04BF        	  7493:     lea     ($04BF,A4),A0
02:0004CACE 11802000        	  7494:     move.b  D0,(A0,D2.W)
02:0004CAD2 1003            	  7495:     move.b  D3,D0
02:0004CAD4 1880            	  7496:     move.b  D0,($0000,A4)
                            	  7497:     ; Hit points are packed two values to a byte.
                            	  7498:     ; Divide the object type in half in order to index
                            	  7499:     ; into the hit points table.
                            	  7500:     ;
02:0004CAD6 E208            	  7501:     lsr.b  #1,D0   ; LSR A
02:0004CAD8 7600            	  7502:     moveq   #0,D3
02:0004CADA 1600            	  7503:     move.b  D0,D3
02:0004CADC 41F90004C610    	  7504:     lea     (ObjectTypeToHpPairs).l,A0
02:0004CAE2 10303000        	  7505:     move.b  (A0,D3.W),D0
02:0004CAE6 4EB90003F104    	  7506:     jsr     ExtractHitPointValue
02:0004CAEC 41EC0485        	  7507:     lea     ($0485,A4),A0
02:0004CAF0 11802000        	  7508:     move.b  D0,(A0,D2.W)
                            	  7509:     ; If the object is a cave, go initialize it.
