02:00031FDC 00000080        	  6155:     ori.b #$80,D0
02:00031FE0 194000C0        	  6156:     move.b  D0,($00C0,A4)
                            	  6157:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  6158:     ;
