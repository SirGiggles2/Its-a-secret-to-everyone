02:00043BCC 6700009C        	  7017:     beq  _L_z05_CheckShortcut_Exit
02:00043BD0 6100013C        	  7018:     jsr     FetchTileMapAddr
02:00043BD4 7005            	  7019:     moveq   #5,D0
02:00043BD6 4EB90002A9FA    	  7020:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
02:00043BDC 4EB900030B52    	  7021:     jsr     GetShortcutOrItemXY
                            	  7022:     ; Divide X coordinate by 4 to get offset into column address table.
                            	  7023:     ; Think of it this way. Divide X by 8 to get tile column number.
                            	  7024:     ; Then multiply by 2 to turn it into an offset for an address.
                            	  7025:     ;
02:00043BE2 E208            	  7026:     lsr.b  #1,D0   ; LSR A
02:00043BE4 E208            	  7027:     lsr.b  #1,D0   ; LSR A
02:00043BE6 7400            	  7028:     moveq   #0,D2
02:00043BE8 1400            	  7029:     move.b  D0,D2
02:00043BEA 41F900049E36    	  7030:     lea     (PlayAreaColumnAddrs).l,A0
02:00043BF0 10302000        	  7031:     move.b  (A0,D2.W),D0
02:00043BF4 1880            	  7032:     move.b  D0,($0000,A4)
02:00043BF6 41F900049E37    	  7033:     lea     (PlayAreaColumnAddrs+1).l,A0
02:00043BFC 10302000        	  7034:     move.b  (A0,D2.W),D0
02:00043C00 19400001        	  7035:     move.b  D0,($0001,A4)
02:00043C04 1003            	  7036:     move.b  D3,D0
02:00043C06 003C0011        	  7037:     ori     #$11,CCR  ; SEC: set C+X
02:00043C0A 123C0040        	  7038:     move.b  #$40,D1
02:00043C0E 0A3C0010        	  7039:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C12 9101            	  7040:     subx.b  D1,D0   ; SBC #$40
02:00043C14 0A3C0010        	  7041:     eori    #$10,CCR  ; restore X = 6502 C
02:00043C18 E208            	  7042:     lsr.b  #1,D0   ; LSR A
02:00043C1A E208            	  7043:     lsr.b  #1,D0   ; LSR A
02:00043C1C E208            	  7044:     lsr.b  #1,D0   ; LSR A
02:00043C1E 7600            	  7045:     moveq   #0,D3
02:00043C20 1600            	  7046:     move.b  D0,D3
02:00043C22 1214            	  7047:     move.b  ($00,A4),D1   ; ptr lo
02:00043C24 182C0001        	  7048:     move.b  ($01,A4),D4  ; ptr hi
02:00043C28 024100FF        	  7049:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C2C E14C            	  7050:     lsl.w   #8,D4
02:00043C2E 8841            	  7051:     or.w    D1,D4             ; D4 = NES ptr addr
