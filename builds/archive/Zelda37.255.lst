                            	  2674: _anon_z04_37:
02:0003A588 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:0003A58C 7000            	  2678:     moveq   #0,D0
02:0003A58E 41EC0451        	  2679:     lea     ($0451,A4),A0
02:0003A592 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:0003A596 6100015E        	  2683:     jsr     Jumper_GetKind
02:0003A59A 41F90003A486    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A5A0 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:0003A5A4 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5A8 41EC0098        	  2696:     lea     ($0098,A4),A0
02:0003A5AC 12302000        	  2697:     move.b  (A0,D2.W),D1
02:0003A5B0 D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003A5B2 7600            	  2699:     moveq   #0,D3
02:0003A5B4 1600            	  2700:     move.b  D0,D3
02:0003A5B6 41F90003A464    	  2701:     lea     (JumperYAccelerations).l,A0
02:0003A5BC 10303000        	  2702:     move.b  (A0,D3.W),D0
02:0003A5C0 7602            	  2703:     moveq   #2,D3
02:0003A5C2 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
                            	  2707:     ;
                            	  2708:     ; Else add 1.
                            	  2709:     ;
02:0003A5C6 163C00FF        	  2710:     move.b  #$FF,D3
02:0003A5CA 41EC0098        	  2711:     lea     ($0098,A4),A0
02:0003A5CE 10302000        	  2712:     move.b  (A0,D2.W),D0
02:0003A5D2 02000002        	  2713:     andi.b #$02,D0
02:0003A5D6 6602            	  2714:     bne  _anon_z04_38
02:0003A5D8 7601            	  2715:     moveq   #1,D3
                            	  2716: _anon_z04_38:
02:0003A5DA 1003            	  2717:     move.b  D3,D0
02:0003A5DC 023C00EE        	  2718:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5E0 12342070        	  2719:     move.b  ($70,A4,D2.W),D1
02:0003A5E4 D101            	  2720:     addx.b  D1,D0   ; ADC ObjX,X
