                            	  5135: DrawCredits:
                            	  5136:     ; Make a transfer record of a full row of blank tiles.
                            	  5137:     ;
02:00036522 761F            	  5138:     moveq   #31,D3
02:00036524 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
02:00036526 41EC0305        	  5141:     lea     ($0305,A4),A0
02:0003652A 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:0003652E 5303            	  5143:     subq.b  #1,D3
02:00036530 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
                            	  5146:     ;
02:00036532 102C050A        	  5147:     move.b  ($050A,A4),D0
02:00036536 672C            	  5148:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5149:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5150:     ; Rows 2 to $2D get side walls.
                            	  5151:     ;
02:00036538 0C000001        	  5152:     cmpi.b  #$01,D0
02:0003653C 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:0003653E 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:00036542 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00036544 661E            	  5156:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5157:     even
                            	  5158: _L_z02_DrawCredits_WriteHorizontalWalls:
02:00036546 7619            	  5159:     moveq   #25,D3
02:00036548 103C00FA        	  5160:     move.b  #$FA,D0
                            	  5161: _anon_z02_42:
02:0003654C 41EC0308        	  5162:     lea     ($0308,A4),A0
02:00036550 11803000        	  5163:     move.b  D0,(A0,D3.W)
02:00036554 5303            	  5164:     subq.b  #1,D3
02:00036556 6AF4            	  5165:     bpl  _anon_z02_42
                            	  5166:     even
                            	  5167: _L_z02_DrawCredits_WriteSideWalls:
02:00036558 103C00FA        	  5168:     move.b  #$FA,D0
02:0003655C 19400308        	  5169:     move.b  D0,($0308,A4)
02:00036560 19400321        	  5170:     move.b  D0,($0321,A4)
                            	  5171:     even
                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:00036564 103C00FF        	  5176:     move.b  #$FF,D0
02:00036568 19400325        	  5177:     move.b  D0,($0325,A4)
02:0003656C 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:00036570 7020            	  5181:     moveq   #32,D0
02:00036572 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:00036576 7400            	  5185:     moveq   #0,D2
02:00036578 142C050C        	  5186:     move.b  ($050C,A4),D2
02:0003657C 41F900036322    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:00036582 10302000        	  5188:     move.b  (A0,D2.W),D0
02:00036586 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:0003658A 102C050D        	  5192:     move.b  ($050D,A4),D0
02:0003658E 7600            	  5193:     moveq   #0,D3
02:00036590 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:00036592 E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00036594 E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:00036596 E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:00036598 E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:0003659A E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:0003659C 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:000365A0 41F90003632E    	  5205:     lea     (CreditsPagesTextMasks).l,A0
02:000365A6 10302000        	  5206:     move.b  (A0,D2.W),D0
                            	  5207: _anon_z02_43:
                            	  5208:     ; Shift left as many times as the current VRAM line number,
                            	  5209:     ; to get the bit that indicates whether this line has text.
                            	  5210:     ;
02:000365AA E308            	  5211:     lsl.b  #1,D0   ; ASL A
02:000365AC 5303            	  5212:     subq.b  #1,D3
02:000365AE 6AFA            	  5213:     bpl  _anon_z02_43
02:000365B0 6400013E        	  5214:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5215:     ; The mask inidcates that it should have text.
                            	  5216:     ; But if line index >= $17, then it doesn't.
                            	  5217:     ;
02:000365B4 7600            	  5218:     moveq   #0,D3
02:000365B6 162C050E        	  5219:     move.b  ($050E,A4),D3
02:000365BA 0C030017        	  5220:     cmpi.b  #$17,D3
02:000365BE 64000130        	  5221:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5222:     ; In the first quest, don't consider line numbers >= $10.
                            	  5223:     ;
02:000365C2 7400            	  5224:     moveq   #0,D2
