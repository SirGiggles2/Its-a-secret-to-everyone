                            	  5775: AnimateBoomerangAndCheckCollision:
                            	  5776:     ; Decrement animation counter; and when it reaches 0:
                            	  5777:     ; 1. arm it again for 2 frames
                            	  5778:     ; 2. advance the minor state within a cycle of 8
                            	  5779:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5780:     ;
02:0004BD62 41EC03D0        	  5781:     lea     ($03D0,A4),A0
02:0004BD66 53302000        	  5782:     subq.b  #1,(A0,D2.W)
