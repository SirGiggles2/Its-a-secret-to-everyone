                            	  3485: Obj_Shove:
                            	  3486:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3487:     ; then go handle it separately.
                            	  3488:     ;
02:0004AE84 41EC00C0        	  3489:     lea     ($00C0,A4),A0
02:0004AE88 10302000        	  3490:     move.b  (A0,D2.W),D0
02:0004AE8C E308            	  3491:     lsl.b  #1,D0   ; ASL A
02:0004AE8E 6448            	  3492:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3493:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3494:     ;
02:0004AE90 E208            	  3495:     lsr.b  #1,D0   ; LSR A
02:0004AE92 41EC00C0        	  3496:     lea     ($00C0,A4),A0
02:0004AE96 11802000        	  3497:     move.b  D0,(A0,D2.W)
                            	  3498:     ; If the object faces horizontally, go check which axis shove
                            	  3499:     ; direction is on.
                            	  3500:     ;
02:0004AE9A 7600            	  3501:     moveq   #0,D3
02:0004AE9C 41EC0098        	  3502:     lea     ($0098,A4),A0
02:0004AEA0 16302000        	  3503:     move.b  (A0,D2.W),D3
02:0004AEA4 0C030003        	  3504:     cmpi.b  #$03,D3
02:0004AEA8 6526            	  3505:     bcs  _L_z07_Obj_Shove_FacingHorizontally
                            	  3506:     ; The object faces vertically.
                            	  3507:     ;
                            	  3508:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3509:     ;
02:0004AEAA 02000003        	  3510:     andi.b #$03,D0
02:0004AEAE 671E            	  3511:     beq  _L_z07_Obj_Shove_Exit
                            	  3512:     even
                            	  3513: _L_z07_Obj_Shove_CheckPerpendicularShove:
