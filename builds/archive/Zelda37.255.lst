02:00039FBA 41EC0394        	  1763:     lea     ($0394,A4),A0
02:00039FBE 10302000        	  1764:     move.b  (A0,D2.W),D0
02:00039FC2 0200000F        	  1765:     andi.b #$0F,D0
02:00039FC6 023C00EE        	  1766:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039FCA 6608            	  1767:     bne  _L_z04_Gel_MoveSplitting_Exit
02:00039FCC 41EC0394        	  1768:     lea     ($0394,A4),A0
