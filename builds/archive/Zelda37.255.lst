                            	  9401: Manhandla_Move:
                            	  9402:     ; Implement a way of manifesting the fractional part of the speed
                            	  9403:     ; in the movement.
                            	  9404:     ;
                            	  9405:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9406:     ; byte to add to the coordinates, then the effective speed would
                            	  9407:     ; be 1 pixel a frame instead of 1.25.
                            	  9408:     ;
                            	  9409:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9410:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9411:     ;
                            	  9412:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9413:     ;
                            	  9414:     ;   SA := SA + (SL AND $E0)
                            	  9415:     ;   [03] := SH + carry
                            	  9416:     ;
                            	  9417:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9418:     ;
02:0003D6AE 41EC041F        	  9419:     lea     ($041F,A4),A0
02:0003D6B2 10302000        	  9420:     move.b  (A0,D2.W),D0
02:0003D6B6 020000E0        	  9421:     andi.b #$E0,D0
02:0003D6BA 023C00EE        	  9422:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D6BE 41EC0412        	  9423:     lea     ($0412,A4),A0
02:0003D6C2 12302000        	  9424:     move.b  (A0,D2.W),D1
02:0003D6C6 D101            	  9425:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003D6C8 41EC0412        	  9426:     lea     ($0412,A4),A0
02:0003D6CC 11802000        	  9427:     move.b  D0,(A0,D2.W)
                            	  9428:     ; Assign (high speed byte + carry) to [03].
                            	  9429:     ;
02:0003D6D0 41EC042C        	  9430:     lea     ($042C,A4),A0
02:0003D6D4 10302000        	  9431:     move.b  (A0,D2.W),D0
02:0003D6D8 123C0000        	  9432:     move.b  #$00,D1
02:0003D6DC D101            	  9433:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D6DE 19400003        	  9434:     move.b  D0,($0003,A4)
                            	  9435:     ; Change coordinates by the speed amount/offset in [03]
                            	  9436:     ; according to the direction.
                            	  9437:     ;
                            	  9438:     ; Start with a mask of $A1 in [02]:
                            	  9439:     ; - low nibble represents the right direction
                            	  9440:     ; - high nibble is used to set or clear carry as we go along
                            	  9441:     ;
02:0003D6E2 103C00A1        	  9442:     move.b  #$A1,D0
02:0003D6E6 19400002        	  9443:     move.b  D0,($0002,A4)
                            	  9444:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9445:     ;
02:0003D6EA 41EC0098        	  9446:     lea     ($0098,A4),A0
02:0003D6EE 10302000        	  9447:     move.b  (A0,D2.W),D0
02:0003D6F2 122C0002        	  9448:     move.b  ($0002,A4),D1
02:0003D6F6 C200            	  9449:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D6F8 6712            	  9450:     beq  _L_z04_Manhandla_Move_Left
02:0003D6FA 10342070        	  9451:     move.b  ($70,A4,D2.W),D0
02:0003D6FE 023C00EE        	  9452:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D702 122C0003        	  9453:     move.b  ($0003,A4),D1
02:0003D706 D101            	  9454:     addx.b  D1,D0   ; ADC $03
02:0003D708 19802070        	  9455:     move.b  D0,($70,A4,D2.W)
                            	  9456:     even
                            	  9457: _L_z04_Manhandla_Move_Left:
                            	  9458:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9459:     ;
02:0003D70C 41EC0098        	  9460:     lea     ($0098,A4),A0
02:0003D710 10302000        	  9461:     move.b  (A0,D2.W),D0
02:0003D714 122C0002        	  9462:     move.b  ($0002,A4),D1
02:0003D718 E309            	  9463:     lsl.b  #1,D1   ; ASL $02
02:0003D71A 19410002        	  9464:     move.b  D1,($0002,A4)
02:0003D71E 122C0002        	  9465:     move.b  ($0002,A4),D1
02:0003D722 C200            	  9466:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D724 6716            	  9467:     beq  _L_z04_Manhandla_Move_Down
02:0003D726 10342070        	  9468:     move.b  ($70,A4,D2.W),D0
02:0003D72A 122C0003        	  9469:     move.b  ($0003,A4),D1
02:0003D72E 0A3C0010        	  9470:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D732 9101            	  9471:     subx.b  D1,D0   ; SBC $03
02:0003D734 0A3C0010        	  9472:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D738 19802070        	  9473:     move.b  D0,($70,A4,D2.W)
                            	  9474:     even
                            	  9475: _L_z04_Manhandla_Move_Down:
                            	  9476:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9477:     ;
02:0003D73C 41EC0098        	  9478:     lea     ($0098,A4),A0
02:0003D740 10302000        	  9479:     move.b  (A0,D2.W),D0
02:0003D744 122C0002        	  9480:     move.b  ($0002,A4),D1
02:0003D748 E309            	  9481:     lsl.b  #1,D1   ; ASL $02
02:0003D74A 19410002        	  9482:     move.b  D1,($0002,A4)
02:0003D74E 122C0002        	  9483:     move.b  ($0002,A4),D1
02:0003D752 C200            	  9484:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D754 6716            	  9485:     beq  _L_z04_Manhandla_Move_Up
02:0003D756 41EC0084        	  9486:     lea     ($0084,A4),A0
02:0003D75A 10302000        	  9487:     move.b  (A0,D2.W),D0
02:0003D75E 122C0003        	  9488:     move.b  ($0003,A4),D1
02:0003D762 D101            	  9489:     addx.b  D1,D0   ; ADC $03
02:0003D764 41EC0084        	  9490:     lea     ($0084,A4),A0
02:0003D768 11802000        	  9491:     move.b  D0,(A0,D2.W)
                            	  9492:     even
                            	  9493: _L_z04_Manhandla_Move_Up:
                            	  9494:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9495:     ;
02:0003D76C 41EC0098        	  9496:     lea     ($0098,A4),A0
02:0003D770 10302000        	  9497:     move.b  (A0,D2.W),D0
02:0003D774 122C0002        	  9498:     move.b  ($0002,A4),D1
02:0003D778 E309            	  9499:     lsl.b  #1,D1   ; ASL $02
02:0003D77A 19410002        	  9500:     move.b  D1,($0002,A4)
02:0003D77E 122C0002        	  9501:     move.b  ($0002,A4),D1
02:0003D782 C200            	  9502:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D784 671E            	  9503:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003D786 41EC0084        	  9504:     lea     ($0084,A4),A0
02:0003D78A 10302000        	  9505:     move.b  (A0,D2.W),D0
02:0003D78E 122C0003        	  9506:     move.b  ($0003,A4),D1
02:0003D792 0A3C0010        	  9507:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D796 9101            	  9508:     subx.b  D1,D0   ; SBC $03
02:0003D798 0A3C0010        	  9509:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D79C 41EC0084        	  9510:     lea     ($0084,A4),A0
02:0003D7A0 11802000        	  9511:     move.b  D0,(A0,D2.W)
                            	  9512:     even
                            	  9513: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9514:     ; To the frame accumulator, add:
                            	  9515:     ; - a random value between 0 and 3
                            	  9516:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9517:     ;
02:0003D7A4 10342019        	  9518:     move.b  ($19,A4,D2.W),D0
02:0003D7A8 02000003        	  9519:     andi.b #$03,D0
02:0003D7AC 023C00EE        	  9520:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D7B0 122C0003        	  9521:     move.b  ($0003,A4),D1
02:0003D7B4 D101            	  9522:     addx.b  D1,D0   ; ADC $03
02:0003D7B6 41EC0451        	  9523:     lea     ($0451,A4),A0
02:0003D7BA 12302000        	  9524:     move.b  (A0,D2.W),D1
02:0003D7BE D101            	  9525:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003D7C0 41EC0451        	  9526:     lea     ($0451,A4),A0
02:0003D7C4 11802000        	  9527:     move.b  D0,(A0,D2.W)
