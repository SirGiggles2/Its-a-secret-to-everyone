                            	  9752:     ; Decrement the shoot timer.
                            	  9753:     ;
02:0003D97A 41EC0380        	  9754:     lea     ($0380,A4),A0
02:0003D97E 53302000        	  9755:     subq.b  #1,(A0,D2.W)
                            	  9756:     ; If it became 0, then set it to $41, and shoot fireball $56.
                            	  9757:     ;
