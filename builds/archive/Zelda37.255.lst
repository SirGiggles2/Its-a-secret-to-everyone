02:0003E68E 6000FF72        	 11463:     jmp  L129EA_Exit
                            	 11464: __far_z_04_0109:
                            	 11465:     ; Otherwise, the segment is dead.
                            	 11466:     ;
02:0003E692 4EB90004AEE4    	 11467:     jsr     ResetShoveInfo
                            	 11468:     ; Set the current segment's HP to the initial value in anticipation
                            	 11469:     ; of bringing this segment back to life.
                            	 11470:     ;
02:0003E698 7020            	 11471:     moveq   #32,D0
02:0003E69A 41EC0485        	 11472:     lea     ($0485,A4),A0
02:0003E69E 11802000        	 11473:     move.b  D0,(A0,D2.W)
                            	 11474:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11475:     ;
                            	 11476:     ; From the lowest slot, look for one that has the original lamnola
                            	 11477:     ; object type.
                            	 11478:     ;
                            	 11479:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11480:     ;
02:0003E6A2 163C00FF        	 11481:     move.b  #$FF,D3
02:0003E6A6 0C020006        	 11482:     cmpi.b  #$06,D2
02:0003E6AA 6502            	 11483:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003E6AC 7604            	 11484:     moveq   #4,D3
                            	 11485:     even
                            	 11486: _L_z04_UpdateLamnola_FindTail:
02:0003E6AE 5203            	 11487:     addq.b  #1,D3
02:0003E6B0 41EC0350        	 11488:     lea     ($0350,A4),A0
02:0003E6B4 10303000        	 11489:     move.b  (A0,D3.W),D0
02:0003E6B8 122C04E7        	 11490:     move.b  ($04E7,A4),D1
02:0003E6BC B001            	 11491:     cmp.b   D1,D0
02:0003E6BE 66EE            	 11492:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11493:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11494:     ;
02:0003E6C0 7011            	 11495:     moveq   #17,D0
02:0003E6C2 19803029        	 11496:     move.b  D0,($29,A4,D3.W)
                            	 11497:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11498:     ; to the tail segment.
                            	 11499:     ;
02:0003E6C6 41EC04F0        	 11500:     lea     ($04F0,A4),A0
02:0003E6CA 10302000        	 11501:     move.b  (A0,D2.W),D0
02:0003E6CE 41EC04F1        	 11502:     lea     ($04F1,A4),A0
02:0003E6D2 11803000        	 11503:     move.b  D0,(A0,D3.W)
02:0003E6D6 10342070        	 11504:     move.b  ($70,A4,D2.W),D0
02:0003E6DA 19803071        	 11505:     move.b  D0,($71,A4,D3.W)
02:0003E6DE 41EC0084        	 11506:     lea     ($0084,A4),A0
02:0003E6E2 10302000        	 11507:     move.b  (A0,D2.W),D0
02:0003E6E6 41EC0085        	 11508:     lea     ($0085,A4),A0
02:0003E6EA 11803000        	 11509:     move.b  D0,(A0,D3.W)
                            	 11510:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11511:     ; So, return and leave it dead.
                            	 11512:     ;
02:0003E6EE 0C030004        	 11513:     cmpi.b  #$04,D3
02:0003E6F2 6604            	 11514:     bne.s  __far_z_04_0110
02:0003E6F4 6000FF0C        	 11515:     jmp  L129EA_Exit
                            	 11516: __far_z_04_0110:
