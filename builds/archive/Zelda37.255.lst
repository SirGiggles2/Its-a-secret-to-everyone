02:00041574 1214            	  3407:     move.b  ($0000,A4),D1
02:00041576 D101            	  3408:     addx.b  D1,D0   ; ADC $00
                            	  3409:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3410:     ;
02:00041578 02000003        	  3411:     andi.b #$03,D0
