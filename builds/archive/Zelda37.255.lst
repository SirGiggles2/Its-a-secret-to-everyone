02:0002BF8A 08000008        	  2276:     btst    #8,D0
02:0002BF8E 670A            	  2277:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2278:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2279:     eori    #$01,CCR
02:0002BF98 4E75            	  2280:     rts
                            	  2281: .cc_cnr:
02:0002BF9A 023C00FE        	  2282:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2283:     eori    #$01,CCR
02:0002BFA2 4E75            	  2284:     rts
                            	  2285: 
