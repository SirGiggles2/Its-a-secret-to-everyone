02:0003FAEE 61005046        	   402:     jsr     DrawSubmenuItems
02:0003FAF2 6100510A        	   403:     jsr     UpdateSubmenuSelection
                            	   404:     ; If buttons Up and A are down on the second controller, then
                            	   405:     ; 1. reset submenu state
                            	   406:     ; 2. go to mode 8
                            	   407:     ; 3. silence sound
                            	   408:     ;
02:0003FAF6 102C00FB        	   409:     move.b  ($00FB,A4),D0
02:0003FAFA 02000088        	   410:     andi.b #$88,D0
02:0003FAFE 0C000088        	   411:     cmpi.b  #$88,D0
02:0003FB02 661A            	   412:     bne  _anon_z05_3
02:0003FB04 4EB90004AAE6    	   413:     jsr     EndGameMode
02:0003FB0A 194000E1        	   414:     move.b  D0,($00E1,A4)
02:0003FB0E 7008            	   415:     moveq   #8,D0
02:0003FB10 19400012        	   416:     move.b  D0,($0012,A4)
02:0003FB14 7000            	   417:     moveq   #0,D0
02:0003FB16 19400619        	   418:     move.b  D0,($0619,A4)
02:0003FB1A 600012CE        	   419:     jmp     SilenceSound
