02:00031952 6000008C        	  5068:     jmp  L73A9_Exit
                            	  5069: __far_z_01_0045:
                            	  5070:     ; They collide. Now find out how they collide.
                            	  5071:     ;
                            	  5072:     ; If it's a regular monster, go harm Link.
                            	  5073:     ;
02:00031956 41EC034F        	  5074:     lea     ($034F,A4),A0
02:0003195A 10302000        	  5075:     move.b  (A0,D2.W),D0
02:0003195E 0C000053        	  5076:     cmpi.b  #$53,D0
02:00031962 6402            	  5077:     bcc.s  __far_z_01_0046
02:00031964 607C            	  5078:     jmp  HarmLink
                            	  5079: __far_z_01_0046:
                            	  5080:     ; Here, the attacker is a monster's shot/projectile.
                            	  5081:     ; Flag this kind of collision.
                            	  5082:     ;
02:00031966 522C034B        	  5083:     addq.b  #1,($034B,A4)
                            	  5084:     ; If object type = Fireball2 ($56) or $5A, or Link is not idle;
                            	  5085:     ; then go harm Link.
                            	  5086:     ;
02:0003196A 0C000056        	  5087:     cmpi.b  #$56,D0
02:0003196E 6602            	  5088:     bne.s  __far_z_01_0047
02:00031970 6070            	  5089:     jmp  HarmLink
                            	  5090: __far_z_01_0047:
02:00031972 0C00005A        	  5091:     cmpi.b  #$5A,D0
02:00031976 6602            	  5092:     bne.s  __far_z_01_0048
02:00031978 6068            	  5093:     jmp  HarmLink
                            	  5094: __far_z_01_0048:
02:0003197A 102C00AC        	  5095:     move.b  ($00AC,A4),D0
02:0003197E 020000F0        	  5096:     andi.b #$F0,D0
02:00031982 6702            	  5097:     beq.s  __far_z_01_0049
02:00031984 605C            	  5098:     jmp  HarmLink
                            	  5099: __far_z_01_0049:
                            	  5100:     ; If Link and the shot are not facing opposite directions,
                            	  5101:     ; then go harm Link.
                            	  5102:     ;
                            	  5103:     ; Note the bitwise AND in the test. It picks out one direction
                            	  5104:     ; component of a monster that can move diagonally.
                            	  5105:     ;
02:00031986 102C0098        	  5106:     move.b  ($0098,A4),D0
02:0003198A 41EC0098        	  5107:     lea     ($0098,A4),A0
02:0003198E 12302000        	  5108:     move.b  (A0,D2.W),D1
02:00031992 8001            	  5109:     or.b  D1,D0
02:00031994 0200000C        	  5110:     andi.b #$0C,D0
02:00031998 0C00000C        	  5111:     cmpi.b  #$0C,D0
02:0003199C 671A            	  5112:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:0003199E 102C0098        	  5113:     move.b  ($0098,A4),D0
02:000319A2 41EC0098        	  5114:     lea     ($0098,A4),A0
02:000319A6 12302000        	  5115:     move.b  (A0,D2.W),D1
02:000319AA 8001            	  5116:     or.b  D1,D0
02:000319AC 02000003        	  5117:     andi.b #$03,D0
02:000319B0 0C000003        	  5118:     cmpi.b  #$03,D0
02:000319B4 6702            	  5119:     beq.s  __far_z_01_0050
02:000319B6 602A            	  5120:     jmp  HarmLink
                            	  5121: __far_z_01_0050:
                            	  5122:     even
                            	  5123: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  5124:     ; Link and the shot are facing opposite directions.
                            	  5125:     ; Link can parry certain weapons/shots.
                            	  5126:     ;
                            	  5127:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  5128:     ; no harmful collision; but it still counts as a shot collision.
                            	  5129:     ; So, go treat this as a parry.
                            	  5130:     ;
02:000319B8 41EC034F        	  5131:     lea     ($034F,A4),A0
02:000319BC 10302000        	  5132:     move.b  (A0,D2.W),D0
02:000319C0 0C000055        	  5133:     cmpi.b  #$55,D0
02:000319C4 650E            	  5134:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:000319C6 0C00005B        	  5135:     cmpi.b  #$5B,D0
02:000319CA 6408            	  5136:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  5137:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  5138:     ; So, go harm Link.
                            	  5139:     ;
02:000319CC 102C0676        	  5140:     move.b  ($0676,A4),D0
02:000319D0 6602            	  5141:     bne.s  __far_z_01_0051
02:000319D2 600E            	  5142:     jmp  HarmLink
                            	  5143: __far_z_01_0051:
                            	  5144:     even
                            	  5145: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  5146:     ; Else Link parries.
                            	  5147:     ;
                            	  5148:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  5149:     ;
02:000319D4 7001            	  5150:     moveq   #1,D0
02:000319D6 19400604        	  5151:     move.b  D0,($0604,A4)
02:000319DA 7000            	  5152:     moveq   #0,D0
02:000319DC 19400006        	  5153:     move.b  D0,($0006,A4)
                            	  5154:     even
                            	  5155: L73A9_Exit:
02:000319E0 4E75            	  5156:     rts
                            	  5157: 
                            	  5158:     even
                            	  5159: HarmLink:
02:000319E2 61000564        	  5160:     jsr     BeginShove
                            	  5161:     ; Flag collision with [0C], even though [06] was already set.
                            	  5162:     ;
02:000319E6 522C000C        	  5163:     addq.b  #1,($000C,A4)
                            	  5164:     ; Unpack the damage points for the monster's type.
                            	  5165:     ; The low nibble is the high byte.
                            	  5166:     ; (Damage points byte AND $F0) is the low byte.
                            	  5167:     ;
02:000319EA 7600            	  5168:     moveq   #0,D3
02:000319EC 41EC034F        	  5169:     lea     ($034F,A4),A0
02:000319F0 16302000        	  5170:     move.b  (A0,D2.W),D3
02:000319F4 41F900031856    	  5171:     lea     (ObjTypeToDamagePoints).l,A0
02:000319FA 10303000        	  5172:     move.b  (A0,D3.W),D0
02:000319FE 1B00            	  5173:     move.b  D0,-(A5)  ; PHA
02:00031A00 0200000F        	  5174:     andi.b #$0F,D0
02:00031A04 1940000D        	  5175:     move.b  D0,($000D,A4)
02:00031A08 101D            	  5176:     move.b  (A5)+,D0  ; PLA
02:00031A0A 020000F0        	  5177:     andi.b #$F0,D0
02:00031A0E 1940000E        	  5178:     move.b  D0,($000E,A4)
                            	  5179: ; Params:
                            	  5180: ; X: object index of the attacker
                            	  5181: ; [0D]: damage points high byte
                            	  5182: ; [0E]: damage points low byte
                            	  5183: ;
                            	  5184: ;
                            	  5185: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  5186: ;
                            	  5187:     even
                            	  5188: Link_BeHarmed:
02:00031A12 7600            	  5189:     moveq   #0,D3
02:00031A14 41EC034F        	  5190:     lea     ($034F,A4),A0
02:00031A18 16302000        	  5191:     move.b  (A0,D2.W),D3
02:00031A1C 0C03002E        	  5192:     cmpi.b  #$2E,D3
02:00031A20 6706            	  5193:     beq  _anon_z01_85
02:00031A22 7008            	  5194:     moveq   #8,D0
02:00031A24 6100EAE6        	  5195:     jsr     PlaySample
                            	  5196: _anon_z01_85:
                            	  5197:     ; For every level of ring (1 or 2), divide the 16-bit damage amount in [0E:0D] by 2.
                            	  5198:     ;
02:00031A28 7600            	  5199:     moveq   #0,D3
02:00031A2A 162C0662        	  5200:     move.b  ($0662,A4),D3
02:00031A2E 6718            	  5201:     beq  _L_z01_Link_BeHarmed_ResetHelp
                            	  5202: _anon_z01_86:
02:00031A30 122C000D        	  5203:     move.b  ($000D,A4),D1
02:00031A34 E209            	  5204:     lsr.b  #1,D1   ; LSR $0D
02:00031A36 1941000D        	  5205:     move.b  D1,($000D,A4)
02:00031A3A 122C000E        	  5206:     move.b  ($000E,A4),D1
02:00031A3E E211            	  5207:     roxr.b  #1,D1   ; ROR $0E
02:00031A40 1941000E        	  5208:     move.b  D1,($000E,A4)
02:00031A44 5303            	  5209:     subq.b  #1,D3
02:00031A46 66E8            	  5210:     bne  _anon_z01_86
                            	  5211:     even
                            	  5212: _L_z01_Link_BeHarmed_ResetHelp:
                            	  5213:     ; Reset values used in special item drops.
                            	  5214:     ;
02:00031A48 7000            	  5215:     moveq   #0,D0
02:00031A4A 19400627        	  5216:     move.b  D0,($0627,A4)
02:00031A4E 19400050        	  5217:     move.b  D0,($0050,A4)
02:00031A52 19400051        	  5218:     move.b  D0,($0051,A4)
                            	  5219:     ; If heart partial >= low damage points byte, then simply
                            	  5220:     ; subtract the damage byte from heart partial.
                            	  5221:     ; Else go borrow from full hearts.
                            	  5222:     ;
02:00031A56 102C0670        	  5223:     move.b  ($0670,A4),D0
02:00031A5A 122C000E        	  5224:     move.b  ($000E,A4),D1
02:00031A5E B001            	  5225:     cmp.b   D1,D0
02:00031A60 6546            	  5226:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031A62 003C0011        	  5227:     ori     #$11,CCR  ; SEC: set C+X
02:00031A66 122C000E        	  5228:     move.b  ($000E,A4),D1
02:00031A6A 0A3C0010        	  5229:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031A6E 9101            	  5230:     subx.b  D1,D0   ; SBC $0E
02:00031A70 0A3C0010        	  5231:     eori    #$10,CCR  ; restore X = 6502 C
02:00031A74 19400670        	  5232:     move.b  D0,($0670,A4)
                            	  5233:     ; If full hearts >= high damage points byte, then simply
                            	  5234:     ; subtract the damage byte from full hearts.
                            	  5235:     ; Else go handle Link dying.
                            	  5236:     ;
02:00031A78 102C066F        	  5237:     move.b  ($066F,A4),D0
02:00031A7C 0200000F        	  5238:     andi.b #$0F,D0
02:00031A80 122C000D        	  5239:     move.b  ($000D,A4),D1
02:00031A84 B001            	  5240:     cmp.b   D1,D0
02:00031A86 6554            	  5241:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00031A88 102C066F        	  5242:     move.b  ($066F,A4),D0
02:00031A8C 003C0011        	  5243:     ori     #$11,CCR  ; SEC: set C+X
02:00031A90 122C000D        	  5244:     move.b  ($000D,A4),D1
02:00031A94 0A3C0010        	  5245:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031A98 9101            	  5246:     subx.b  D1,D0   ; SBC $0D
02:00031A9A 0A3C0010        	  5247:     eori    #$10,CCR  ; restore X = 6502 C
02:00031A9E 1940066F        	  5248:     move.b  D0,($066F,A4)
02:00031AA2 0A3C0001        	  5249:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00031AA6 4E75            	  5250:     rts
                            	  5251: 
                            	  5252:     even
                            	  5253: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  5254:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  5255:     ;   full heart=4 partial heart=$70
                            	  5256:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  5257:     ; But the method here yields $3EF, because partial heart is
                            	  5258:     ; considered full when = $FF instead of $100.
                            	  5259:     ;
02:00031AA8 102C000E        	  5260:     move.b  ($000E,A4),D0
02:00031AAC 003C0011        	  5261:     ori     #$11,CCR  ; SEC: set C+X
02:00031AB0 122C0670        	  5262:     move.b  ($0670,A4),D1
02:00031AB4 0A3C0010        	  5263:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031AB8 9101            	  5264:     subx.b  D1,D0   ; SBC HeartPartial
02:00031ABA 0A3C0010        	  5265:     eori    #$10,CCR  ; restore X = 6502 C
02:00031ABE 1940000E        	  5266:     move.b  D0,($000E,A4)
02:00031AC2 102C066F        	  5267:     move.b  ($066F,A4),D0
02:00031AC6 0200000F        	  5268:     andi.b #$0F,D0
02:00031ACA 6710            	  5269:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031ACC 532C066F        	  5270:     subq.b  #1,($066F,A4)
02:00031AD0 103C00FF        	  5271:     move.b  #$FF,D0
02:00031AD4 19400670        	  5272:     move.b  D0,($0670,A4)
02:00031AD8 6600FF6E        	  5273:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  5274:     even
                            	  5275: _L_z01_Link_BeHarmed_HandleDied:
                            	  5276:     ; Link died.
                            	  5277:     ;
                            	  5278:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  5279:     ; Make Link face down.
                            	  5280:     ; Go to mode $11.
                            	  5281:     ;
02:00031ADC 102C066F        	  5282:     move.b  ($066F,A4),D0
02:00031AE0 020000F0        	  5283:     andi.b #$F0,D0
02:00031AE4 1940066F        	  5284:     move.b  D0,($066F,A4)
02:00031AE8 4EB90004AAE6    	  5285:     jsr     EndGameMode
02:00031AEE 19400670        	  5286:     move.b  D0,($0670,A4)
02:00031AF2 194000AC        	  5287:     move.b  D0,($00AC,A4)
02:00031AF6 7011            	  5288:     moveq   #17,D0
02:00031AF8 19400012        	  5289:     move.b  D0,($0012,A4)
02:00031AFC 7004            	  5290:     moveq   #4,D0
02:00031AFE 19400098        	  5291:     move.b  D0,($0098,A4)
                            	  5292: _anon_z01_87:
02:00031B02 4E75            	  5293:     rts
                            	  5294: 
                            	  5295: ; Params:
                            	  5296: ; X: monster slot
                            	  5297: ; Y: weapon slot
                            	  5298: ; [02]: monster mid X
                            	  5299: ; [03]: monster mid Y
                            	  5300: ;
                            	  5301: ; Returns:
                            	  5302: ; [00]: weapon slot
                            	  5303: ;
                            	  5304: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  5305: ;
                            	  5306:     even
                            	  5307: CheckMonsterBoomerangOrFoodCollision:
02:00031B04 41EC00AC        	  5308:     lea     ($00AC,A4),A0
02:00031B08 10303000        	  5309:     move.b  (A0,D3.W),D0
02:00031B0C E308            	  5310:     lsl.b  #1,D0   ; ASL A
02:00031B0E 65F2            	  5311:     bcs  _anon_z01_87
02:00031B10 1883            	  5312:     move.b  D3,($0000,A4)
                            	  5313:     ; Set boomerang damage type (2) in [09].
                            	  5314:     ;
02:00031B12 7002            	  5315:     moveq   #2,D0
02:00031B14 19400009        	  5316:     move.b  D0,($0009,A4)
                            	  5317:     ; Set collision threshold $A in both axes.
                            	  5318:     ;
02:00031B18 700A            	  5319:     moveq   #10,D0
02:00031B1A 1940000D        	  5320:     move.b  D0,($000D,A4)
02:00031B1E 1940000E        	  5321:     move.b  D0,($000E,A4)
                            	  5322:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  5323:     ;
02:00031B22 10343070        	  5324:     move.b  ($70,A4,D3.W),D0
02:00031B26 023C00EE        	  5325:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031B2A 123C0004        	  5326:     move.b  #$04,D1
02:00031B2E D101            	  5327:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031B30 19400004        	  5328:     move.b  D0,($0004,A4)
                            	  5329:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  5330:     ;
02:00031B34 41EC0084        	  5331:     lea     ($0084,A4),A0
02:00031B38 10303000        	  5332:     move.b  (A0,D3.W),D0
02:00031B3C 023C00EE        	  5333:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031B40 123C0008        	  5334:     move.b  #$08,D1
02:00031B44 D101            	  5335:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  5336: ; Params:
                            	  5337: ; A: weapon object mid Y
                            	  5338: ; X: monster object slot
                            	  5339: ; Y: weapon object slot
                            	  5340: ; [00]: weapon object slot
                            	  5341: ; [02]: monster object mid X
                            	  5342: ; [03]: monster object mid Y
                            	  5343: ; [04]: weapon object mid X
                            	  5344: ; [07]: damage points
                            	  5345: ; [09]: damage type
                            	  5346: ; [0D]: horizontal threshold
                            	  5347: ; [0E]: vertical threshold
                            	  5348: ;
                            	  5349: ; Returns:
                            	  5350: ; [06]: 1 if objects collide
                            	  5351: ;
                            	  5352:     even
                            	  5353: CheckMonsterWeaponCollision:
02:00031B46 19400005        	  5354:     move.b  D0,($0005,A4)
                            	  5355:     ; Reset [06] for no collision.
                            	  5356:     ;
02:00031B4A 7000            	  5357:     moveq   #0,D0
02:00031B4C 19400006        	  5358:     move.b  D0,($0006,A4)
                            	  5359:     ; If the weapon's not active (state = 0), then return.
                            	  5360:     ;
02:00031B50 7600            	  5361:     moveq   #0,D3
02:00031B52 1614            	  5362:     move.b  ($0000,A4),D3
02:00031B54 41EC00AC        	  5363:     lea     ($00AC,A4),A0
02:00031B58 10303000        	  5364:     move.b  (A0,D3.W),D0
02:00031B5C 6604            	  5365:     bne.s  __far_z_01_0052
02:00031B5E 6000010C        	  5366:     jmp  L74D8_Exit
                            	  5367: __far_z_01_0052:
                            	  5368:     ; If the objects do not collide, then return.
                            	  5369:     ;
02:00031B62 610003E0        	  5370:     jsr     DoObjectsCollideWithThresholds
