                            	  1206: ; Params:
                            	  1207: ; A: Y coordinate
                            	  1208: ; X: object index
                            	  1209: ;
                            	  1210:     even
                            	  1211: InitWhirlwind:
02:0002FD7E 6000BECA        	  1212:     jmp     c_init_whirlwind
                            	  1213: 
                            	  1214: SetUpWhirlwind:
02:0002FD82 6000BC76        	  1215:     jmp     c_set_up_whirlwind
                            	  1216: 
                            	  1217: WhirlwindPrevRoomIdList:
02:0002FD86 36              	  1218:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FD87 3B
02:0002FD88 73
02:0002FD89 44
02:0002FD8A 0A
02:0002FD8B 21
02:0002FD8C 41
02:0002FD8D 6C
                            	  1219: 
                            	  1220:     even
                            	  1221: UpdateWhirlwind_Full:
                            	  1222:     ; Get Link's halted state.
                            	  1223:     ;
02:0002FD8E 102C00AC        	  1224:     move.b  ($00AC,A4),D0
02:0002FD92 02000040        	  1225:     andi.b #$40,D0
02:0002FD96 7600            	  1226:     moveq   #0,D3
02:0002FD98 1600            	  1227:     move.b  D0,D3
                            	  1228:     ; Add 2 to whirlwind X.
                            	  1229:     ;
02:0002FD9A 7002            	  1230:     moveq   #2,D0
02:0002FD9C 023C00EE        	  1231:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FDA0 12342070        	  1232:     move.b  ($70,A4,D2.W),D1
02:0002FDA4 D101            	  1233:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FDA6 19802070        	  1234:     move.b  D0,($70,A4,D2.W)
                            	  1235:     ; If Link is not halted or teleporting state = 0, then
                            	  1236:     ; go check for collision with Link.
                            	  1237:     ;
02:0002FDAA 0C030040        	  1238:     cmpi.b  #$40,D3
02:0002FDAE 6638            	  1239:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FDB0 7600            	  1240:     moveq   #0,D3
02:0002FDB2 162C0522        	  1241:     move.b  ($0522,A4),D3
02:0002FDB6 6730            	  1242:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1243:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1244:     ;
                            	  1245:     ; Set Link's X to whirlwind's.
                            	  1246:     ;
02:0002FDB8 19400070        	  1247:     move.b  D0,($0070,A4)
                            	  1248:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1249:     ; the right screen edge and draw.
                            	  1250:     ;
02:0002FDBC 5303            	  1251:     subq.b  #1,D3
02:0002FDBE 6776            	  1252:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FDC0 0C000080        	  1253:     cmpi.b  #$80,D0
02:0002FDC4 6670            	  1254:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1255:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1256:     ;
                            	  1257:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1258:     ;
02:0002FDC6 E308            	  1259:     lsl.b  #1,D0   ; ASL A
02:0002FDC8 194000AC        	  1260:     move.b  D0,($00AC,A4)
02:0002FDCC 19400522        	  1261:     move.b  D0,($0522,A4)
02:0002FDD0 41EC034F        	  1262:     lea     ($034F,A4),A0
02:0002FDD4 11802000        	  1263:     move.b  D0,(A0,D2.W)
                            	  1264:     ; Update the player position marker, and draw one last time.
                            	  1265:     ;
02:0002FDD8 1002            	  1266:     move.b  D2,D0
02:0002FDDA 1B00            	  1267:     move.b  D0,-(A5)  ; PHA
02:0002FDDC 61000DFA        	  1268:     jsr     UpdatePlayerPositionMarker
02:0002FDE0 101D            	  1269:     move.b  (A5)+,D0  ; PLA
02:0002FDE2 7400            	  1270:     moveq   #0,D2
02:0002FDE4 1400            	  1271:     move.b  D0,D2
02:0002FDE6 6070            	  1272:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1273: 
                            	  1274:     even
                            	  1275: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1276:     ; Link is not halted or teleporting state = 0.
                            	  1277:     ; Try to pick up Link.
                            	  1278:     ;
                            	  1279:     ; If the whirlwind does not collide with Link, then go check
                            	  1280:     ; for the screen's right edge.
                            	  1281:     ;
02:0002FDE8 61001ACA        	  1282:     jsr     CheckLinkCollision
02:0002FDEC 102C0006        	  1283:     move.b  ($0006,A4),D0
02:0002FDF0 6744            	  1284:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1285:     ; Collided with Link.
                            	  1286:     ;
                            	  1287:     ; Make Link face right. Reset shove info and subroom type.
                            	  1288:     ;
02:0002FDF2 7001            	  1289:     moveq   #1,D0
02:0002FDF4 19400098        	  1290:     move.b  D0,($0098,A4)
02:0002FDF8 E208            	  1291:     lsr.b  #1,D0   ; LSR A
02:0002FDFA 194000C0        	  1292:     move.b  D0,($00C0,A4)
02:0002FDFE 194000D3        	  1293:     move.b  D0,($00D3,A4)
02:0002FE02 1940005A        	  1294:     move.b  D0,($005A,A4)
                            	  1295:     ; Halt Link (state $40), and hide him.
                            	  1296:     ;
02:0002FE06 7040            	  1297:     moveq   #64,D0
02:0002FE08 194000AC        	  1298:     move.b  D0,($00AC,A4)
02:0002FE0C 103C00F8        	  1299:     move.b  #$F8,D0
02:0002FE10 19400248        	  1300:     move.b  D0,($0248,A4)
02:0002FE14 1940024C        	  1301:     move.b  D0,($024C,A4)
                            	  1302:     ; Find and set the room that will behave as the previous room
                            	  1303:     ; when scrolling right to the room with the level's entrance.
                            	  1304:     ;
02:0002FE18 102C0523        	  1305:     move.b  ($0523,A4),D0
02:0002FE1C 02000007        	  1306:     andi.b #$07,D0
02:0002FE20 7600            	  1307:     moveq   #0,D3
02:0002FE22 1600            	  1308:     move.b  D0,D3
02:0002FE24 41F90002FD86    	  1309:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FE2A 10303000        	  1310:     move.b  (A0,D3.W),D0
02:0002FE2E 194000EA        	  1311:     move.b  D0,($00EA,A4)
                            	  1312:     ; Set teleporting state 1.
                            	  1313:     ;
02:0002FE32 522C0522        	  1314:     addq.b  #1,($0522,A4)
                            	  1315:     even
                            	  1316: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1317:     ; If whirlwind's X < $F0, go draw.
                            	  1318:     ;
02:0002FE36 10342070        	  1319:     move.b  ($70,A4,D2.W),D0
02:0002FE3A 0C0000F0        	  1320:     cmpi.b  #$F0,D0
02:0002FE3E 6518            	  1321:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1322:     ; The whirlwind has reached the right edge of the screen.
                            	  1323:     ;
                            	  1324:     ; Destroy the object.
                            	  1325:     ;
02:0002FE40 611A            	  1326:     jsr     DestroyWhirlwind
                            	  1327:     ; If teleporting state <> 0, we picked up Link.
                            	  1328:     ; So, go to the next mode.
                            	  1329:     ;
                            	  1330:     ; Either way, draw one last time.
                            	  1331:     ;
