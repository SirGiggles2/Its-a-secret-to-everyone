                            	  6962: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6963:     ; To animate the state, the animation counter had to have
                            	  6964:     ; reached 0. Right after this routine, the counter will be
                            	  6965:     ; rolled over, and the movement frame will be switched.
                            	  6966:     ;
                            	  6967:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6968:     ; the animation here, in order to immediately change it to
                            	  6969:     ; 0 (legs apart) after this.
                            	  6970:     ;
02:0004C584 7001            	  6971:     moveq   #1,D0
02:0004C586 194003E4        	  6972:     move.b  D0,($03E4,A4)
02:0004C58A 4E75            	  6973:     rts
