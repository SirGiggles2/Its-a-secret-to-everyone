02:0003B1CE 19400004        	  4430:     move.b  D0,($0004,A4)
02:0003B1D2 41EC0084        	  4431:     lea     ($0084,A4),A0
02:0003B1D6 10303000        	  4432:     move.b  (A0,D3.W),D0
