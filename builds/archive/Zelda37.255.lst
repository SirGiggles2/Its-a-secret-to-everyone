02:000301FA 660000B2        	  1872:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  1873:     ; State 0. Sensing.
                            	  1874:     ;
                            	  1875:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  1876:     ; then go see if the horizontal distance is shorter.
                            	  1877:     ;
02:000301FE 102C0084        	  1878:     move.b  ($0084,A4),D0
02:00030202 003C0011        	  1879:     ori     #$11,CCR  ; SEC: set C+X
02:00030206 41EC0084        	  1880:     lea     ($0084,A4),A0
02:0003020A 12302000        	  1881:     move.b  (A0,D2.W),D1
02:0003020E 0A3C0010        	  1882:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030212 9101            	  1883:     subx.b  D1,D0   ; SBC ObjY,X
02:00030214 0A3C0010        	  1884:     eori    #$10,CCR  ; restore X = 6502 C
02:00030218 61000680        	  1885:     jsr     Abs
02:0003021C 0C00000E        	  1886:     cmpi.b  #$0E,D0
02:00030220 644C            	  1887:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1888:     ; Determine the horizontal direction toward Link;
                            	  1889:     ; and if Link and the trap are at the same X, then we can't move
                            	  1890:     ; along this axis. Go see about moving vertically.
                            	  1891:     ;
02:00030222 7601            	  1892:     moveq   #1,D3
02:00030224 102C0070        	  1893:     move.b  ($0070,A4),D0
02:00030228 12342070        	  1894:     move.b  ($70,A4,D2.W),D1
02:0003022C B001            	  1895:     cmp.b   D1,D0
02:0003022E 673E            	  1896:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030230 6402            	  1897:     bcc  _anon_z01_26
02:00030232 7602            	  1898:     moveq   #2,D3
                            	  1899: _anon_z01_26:
                            	  1900:     ; Remember the original X coordinate.
                            	  1901:     ;
02:00030234 10342070        	  1902:     move.b  ($70,A4,D2.W),D0
                            	  1903:     even
                            	  1904: _L_z01_UpdateTrap_Full_GoToState1:
02:00030238 41EC0380        	  1905:     lea     ($0380,A4),A0
02:0003023C 11802000        	  1906:     move.b  D0,(A0,D2.W)
                            	  1907:     ; Set facing direction to the horizontal one that we determined.
                            	  1908:     ;
02:00030240 1003            	  1909:     move.b  D3,D0
02:00030242 41EC0098        	  1910:     lea     ($0098,A4),A0
02:00030246 11802000        	  1911:     move.b  D0,(A0,D2.W)
                            	  1912:     ; If the direction we determined is not allowed for this trap, then
                            	  1913:     ; go draw and check collisions.
                            	  1914:     ;
02:0003024A 41F9000301EB    	  1915:     lea     (TrapAllowedDirs-1).l,A0
02:00030250 12302000        	  1916:     move.b  (A0,D2.W),D1
02:00030254 C001            	  1917:     and.b  D1,D0
02:00030256 6712            	  1918:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1919:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  1920:     ;
02:00030258 41EC00AC        	  1921:     lea     ($00AC,A4),A0
02:0003025C 52302000        	  1922:     addq.b  #1,(A0,D2.W)
02:00030260 7070            	  1923:     moveq   #112,D0
02:00030262 41EC03BC        	  1924:     lea     ($03BC,A4),A0
02:00030266 11802000        	  1925:     move.b  D0,(A0,D2.W)
                            	  1926:     even
                            	  1927: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:0003026A 60000102        	  1928:     jmp     L_Trap_DrawAndCheckCollisions
                            	  1929: 
                            	  1930:     even
                            	  1931: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1932:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1933:     ; then this trap definitely wasn't triggered.
                            	  1934:     ; Go draw and check collisions.
                            	  1935:     ;
02:0003026E 102C0070        	  1936:     move.b  ($0070,A4),D0
02:00030272 003C0011        	  1937:     ori     #$11,CCR  ; SEC: set C+X
02:00030276 12342070        	  1938:     move.b  ($70,A4,D2.W),D1
02:0003027A 0A3C0010        	  1939:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003027E 9101            	  1940:     subx.b  D1,D0   ; SBC ObjX,X
02:00030280 0A3C0010        	  1941:     eori    #$10,CCR  ; restore X = 6502 C
02:00030284 61000614        	  1942:     jsr     Abs
02:00030288 0C00000E        	  1943:     cmpi.b  #$0E,D0
02:0003028C 64DC            	  1944:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1945:     ; Determine the vertical direction toward Link;
                            	  1946:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1947:     ; along this axis. Go draw and check object collisions.
                            	  1948:     ;
02:0003028E 7604            	  1949:     moveq   #4,D3
02:00030290 102C0084        	  1950:     move.b  ($0084,A4),D0
02:00030294 41EC0084        	  1951:     lea     ($0084,A4),A0
02:00030298 12302000        	  1952:     move.b  (A0,D2.W),D1
02:0003029C B001            	  1953:     cmp.b   D1,D0
02:0003029E 67CA            	  1954:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000302A0 6402            	  1955:     bcc  _anon_z01_27
02:000302A2 7608            	  1956:     moveq   #8,D3
                            	  1957: _anon_z01_27:
                            	  1958:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  1959:     ; set the vertical direction we determined, and other preparations.
                            	  1960:     ;
02:000302A4 41EC0084        	  1961:     lea     ($0084,A4),A0
02:000302A8 10302000        	  1962:     move.b  (A0,D2.W),D0
02:000302AC 668A            	  1963:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  1964:     even
                            	  1965: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  1966:     ; State 1 and 2.
                            	  1967:     ;
                            	  1968:     ; Move in the direction it's facing.
                            	  1969:     ;
02:000302AE 41EC0098        	  1970:     lea     ($0098,A4),A0
