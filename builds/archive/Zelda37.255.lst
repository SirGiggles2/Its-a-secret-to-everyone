02:000360BE 102C0085        	  4792:     move.b  ($0085,A4),D0
02:000360C2 003C0011        	  4793:     ori     #$11,CCR  ; SEC: set C+X
02:000360C6 123C0010        	  4794:     move.b  #$10,D1
02:000360CA 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000360CE 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:000360D0 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
