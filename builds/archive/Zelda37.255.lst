                            	  3620: _L_z07_ShoveMoveMin_ChooseSpeed:
                            	  3621:     ; If the direction is right or down, store 1 in [02], else -1.
                            	  3622:     ; This is the amount to change the relevant coordinate by.
                            	  3623:     ;
02:0004AF5C 7601            	  3624:     moveq   #1,D3
02:0004AF5E 41EC00C0        	  3625:     lea     ($00C0,A4),A0
02:0004AF62 10302000        	  3626:     move.b  (A0,D2.W),D0
02:0004AF66 02000005        	  3627:     andi.b #$05,D0
02:0004AF6A 6604            	  3628:     bne  _anon_z07_13
02:0004AF6C 163C00FF        	  3629:     move.b  #$FF,D3
                            	  3630: _anon_z07_13:
02:0004AF70 19430002        	  3631:     move.b  D3,($0002,A4)
                            	  3632:     ; We're OK to change the position. So, decrease the distance
                            	  3633:     ; that's left to move.
                            	  3634:     ;
02:0004AF74 41EC00D3        	  3635:     lea     ($00D3,A4),A0
02:0004AF78 53302000        	  3636:     subq.b  #1,(A0,D2.W)
                            	  3637:     ; Change the grid offset by the amount in [02] (1, -1).
                            	  3638:     ;
02:0004AF7C 41EC0394        	  3639:     lea     ($0394,A4),A0
02:0004AF80 10302000        	  3640:     move.b  (A0,D2.W),D0
02:0004AF84 023C00EE        	  3641:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AF88 122C0002        	  3642:     move.b  ($0002,A4),D1
02:0004AF8C D101            	  3643:     addx.b  D1,D0   ; ADC $02
02:0004AF8E 41EC0394        	  3644:     lea     ($0394,A4),A0
02:0004AF92 11802000        	  3645:     move.b  D0,(A0,D2.W)
                            	  3646:     ; If grid offset is a multiple of $10, or the object is Link and grid offset
                            	  3647:     ; is a multiple of 8, then reset grid offset.
