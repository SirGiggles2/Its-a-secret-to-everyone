02:0003FC42 5303            	   552:     subq.b  #1,D3
02:0003FC44 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0003FC46 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0003FC48 7001            	   561:     moveq   #1,D0
02:0003FC4A 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0003FC4E 7003            	   569:     moveq   #3,D0
02:0003FC50 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:0003FC54 7400            	   576:     moveq   #0,D2
02:0003FC56 41F90003FBD8    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0003FC5C 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:0003FC60 102C0006        	   585:     move.b  ($0006,A4),D0
02:0003FC64 122C0671        	   586:     move.b  ($0671,A4),D1
02:0003FC68 C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003FC6A 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:0003FC6C 41F900046C30    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003FC72 10302000        	   599:     move.b  (A0,D2.W),D0
02:0003FC76 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:0003FC7A 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003FC7C 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:0003FC80 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
