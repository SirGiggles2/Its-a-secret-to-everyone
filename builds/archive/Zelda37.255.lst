                            	  5115: _L_z07_SpreadShot_NextCorner:
                            	  5116:     ; Prepare to process the next corner.
                            	  5117:     ;
                            	  5118:     ; First, restore X offset [02] and Y offset [03].
                            	  5119:     ;
02:0004B8F8 101D            	  5120:     move.b  (A5)+,D0  ; PLA
02:0004B8FA 19400003        	  5121:     move.b  D0,($0003,A4)
02:0004B8FE 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004B900 19400002        	  5123:     move.b  D0,($0002,A4)
                            	  5124:     ; Take turns negating X offset or Y offset for the next round.
                            	  5125:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5126:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5127:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5128:     ; - Fourth turn: doesn't matter
                            	  5129:     ;
                            	  5130:     ;
                            	  5131:     ; Get the loop index.
02:0004B904 101D            	  5132:     move.b  (A5)+,D0  ; PLA
02:0004B906 1B00            	  5133:     move.b  D0,-(A5)  ; PHA
02:0004B908 7600            	  5134:     moveq   #0,D3
02:0004B90A 1600            	  5135:     move.b  D0,D3
02:0004B90C 0C030001        	  5136:     cmpi.b  #$01,D3
02:0004B910 6602            	  5137:     bne  _anon_z07_25
02:0004B912 7603            	  5138:     moveq   #3,D3
                            	  5139: _anon_z07_25:
