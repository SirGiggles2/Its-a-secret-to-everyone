                            	  6052: BeginShove:
02:00031F48 7600            	  6053:     moveq   #0,D3
02:00031F4A 1614            	  6054:     move.b  ($0000,A4),D3
02:00031F4C 0C02000D        	  6055:     cmpi.b  #$0D,D2
02:00031F50 6412            	  6056:     bcc  _anon_z01_99
02:00031F52 41EC04B2        	  6057:     lea     ($04B2,A4),A0
02:00031F56 10302000        	  6058:     move.b  (A0,D2.W),D0
02:00031F5A 122C0009        	  6059:     move.b  ($0009,A4),D1
02:00031F5E C001            	  6060:     and.b  D1,D0
