02:00039EE0 41EC0394        	  1636:     lea     ($0394,A4),A0
02:00039EE4 11802000        	  1637:     move.b  D0,(A0,D2.W)
02:00039EE8 41EC00AC        	  1638:     lea     ($00AC,A4),A0
02:00039EEC 52302000        	  1639:     addq.b  #1,(A0,D2.W)
                            	  1640:     even
