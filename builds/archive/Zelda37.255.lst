02:0004ACB8 6610            	  3247:     bne  _L_z07_BeginUpdateWorld_LoopObject
02:0004ACBA 4600            	  3248:     eori.b #$FF,D0
02:0004ACBC 19400061        	  3249:     move.b  D0,($0061,A4)
