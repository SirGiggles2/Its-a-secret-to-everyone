02:0003C7B0 41EC0098        	  7412:     lea     ($0098,A4),A0
02:0003C7B4 10302000        	  7413:     move.b  (A0,D2.W),D0
02:0003C7B8 02000003        	  7414:     andi.b #$03,D0
02:0003C7BC 6602            	  7415:     bne.s  __far_z_04_0067
