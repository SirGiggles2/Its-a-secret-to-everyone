02:0003F7D2 003C0011        	 13983:     ori     #$11,CCR  ; SEC: set C+X
02:0003F7D6 123C0008        	 13984:     move.b  #$08,D1
02:0003F7DA 0A3C0010        	 13985:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F7DE 9101            	 13986:     subx.b  D1,D0   ; SBC #$08
02:0003F7E0 0A3C0010        	 13987:     eori    #$10,CCR  ; restore X = 6502 C
