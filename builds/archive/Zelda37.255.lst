02:0003BE52 123C0008        	  6106:     move.b  #$08,D1
02:0003BE56 D101            	  6107:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BE58 19802070        	  6108:     move.b  D0,($70,A4,D2.W)
                            	  6109:     ; Save the child flag and object type.
                            	  6110:     ;
02:0003BE5C 41EC046B        	  6111:     lea     ($046B,A4),A0
02:0003BE60 10302000        	  6112:     move.b  (A0,D2.W),D0
02:0003BE64 1B00            	  6113:     move.b  D0,-(A5)  ; PHA
02:0003BE66 41EC034F        	  6114:     lea     ($034F,A4),A0
02:0003BE6A 10302000        	  6115:     move.b  (A0,D2.W),D0
02:0003BE6E 1B00            	  6116:     move.b  D0,-(A5)  ; PHA
                            	  6117:     ; Change object type to $18 (Little Digdogger),
                            	  6118:     ; and child flag to 1, in order to draw as a little digdogger.
                            	  6119:     ;
02:0003BE70 7018            	  6120:     moveq   #24,D0
02:0003BE72 41EC034F        	  6121:     lea     ($034F,A4),A0
02:0003BE76 11802000        	  6122:     move.b  D0,(A0,D2.W)
02:0003BE7A 7001            	  6123:     moveq   #1,D0
