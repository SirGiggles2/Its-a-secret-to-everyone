02:0003C9AC 10302000        	  7683:     move.b  (A0,D2.W),D0
02:0003C9B0 0C000078        	  7684:     cmpi.b  #$78,D0
02:0003C9B4 6402            	  7685:     bcc  _anon_z04_97
