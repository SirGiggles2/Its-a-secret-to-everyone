02:0003CBD0 11802000        	  7913:     move.b  D0,(A0,D2.W)
                            	  7914:     ; Now Link can't move.
                            	  7915:     ;
02:0003CBD4 522C0512        	  7916:     addq.b  #1,($0512,A4)
                            	  7917:     even
