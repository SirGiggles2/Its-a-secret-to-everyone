02:000313E6 1003            	  4315:     move.b  D3,D0
02:000313E8 6004            	  4316:     jmp     DrawObjectNotMirrored
                            	  4317: 
                            	  4318: ; Params:
                            	  4319: ; A: frame image
                            	  4320: ; X: object index
                            	  4321: ; [00]: object X
                            	  4322: ; [01]: object Y
                            	  4323: ;
                            	  4324: ;
                            	  4325: ; Set [0C] mirrored.
                            	  4326:     even
                            	  4327: DrawObjectMirrored:
02:000313EA 7601            	  4328:     moveq   #1,D3
02:000313EC 6602            	  4329:     bne  _anon_z01_75
                            	  4330: ; Params:
                            	  4331: ; A: frame image
                            	  4332: ; X: object index
                            	  4333: ; [00]: object X
                            	  4334: ; [01]: object Y
                            	  4335: ; [0F]: flip horizontally
                            	  4336: ;
                            	  4337:     even
                            	  4338: DrawObjectNotMirrored:
02:000313EE 7600            	  4339:     moveq   #0,D3
                            	  4340: _anon_z01_75:
02:000313F0 1943000C        	  4341:     move.b  D3,($000C,A4)
                            	  4342:     ; Set animation index = object type + 1.
                            	  4343:     ;
02:000313F4 7600            	  4344:     moveq   #0,D3
02:000313F6 41EC034F        	  4345:     lea     ($034F,A4),A0
02:000313FA 16302000        	  4346:     move.b  (A0,D2.W),D3
                            	  4347: ; Params:
                            	  4348: ; A: frame
                            	  4349: ; X: object index/cycle sprite index
                            	  4350: ; Y: object type
                            	  4351: ; [00]: object X
                            	  4352: ; [01]: object Y
                            	  4353: ; [0C]: mirrored
                            	  4354: ; [0F]: flip horizontally
                            	  4355: ;
                            	  4356: ; Note:
                            	  4357: ; If the object is not mirrored, then it's horizontally flippable.
                            	  4358: ;
                            	  4359: ; The animation index of most objects is (object type + 1),
                            	  4360: ; to make up for the fact that Link uses two animation indexes.
                            	  4361: ;
                            	  4362:     even
                            	  4363: DrawObjectWithType:
02:000313FE 5203            	  4364:     addq.b  #1,D3
                            	  4365: ; Params:
                            	  4366: ; A: frame
                            	  4367: ; X: object index/cycle sprite index
                            	  4368: ; Y: animation index
                            	  4369: ; [00]: object X
                            	  4370: ; [01]: object Y
                            	  4371: ; [0C]: mirrored
                            	  4372: ; [0F]: flip horizontally
                            	  4373: ;
                            	  4374: ; Note:
                            	  4375: ; If the object is not mirrored, then it's horizontally flippable.
                            	  4376: ; But Link uses [0F] for flipping without checking [0C].
                            	  4377: ;
                            	  4378: ;
                            	  4379: ; [0D] holds frame.
                            	  4380:     even
                            	  4381: DrawObjectWithAnim:
02:00031400 1940000D        	  4382:     move.b  D0,($000D,A4)
02:00031404 1943000E        	  4383:     move.b  D3,($000E,A4)
02:00031408 19420008        	  4384:     move.b  D2,($0008,A4)
                            	  4385:     ; Set the left and right sprite record offsets for CurSpriteIndex.
