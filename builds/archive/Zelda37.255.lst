02:0003C8E0 6404            	  7572:     bcc.s  __far_z_04_0068
02:0003C8E2 60000118        	  7573:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7574: __far_z_04_0068:
                            	  7575:     ; Otherwise move horizontally.
