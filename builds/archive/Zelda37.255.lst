02:0003D7D2 4EB90004C53C    	  9536:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9537:     ; Push the "frame image and sprite attributes" value.
                            	  9538:     ;
02:0003D7D8 41EC0478        	  9539:     lea     ($0478,A4),A0
02:0003D7DC 10302000        	  9540:     move.b  (A0,D2.W),D0
02:0003D7E0 1B00            	  9541:     move.b  D0,-(A5)  ; PHA
                            	  9542:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9543:     ; passed along as is.
                            	  9544:     ;
02:0003D7E2 02000080        	  9545:     andi.b #$80,D0
02:0003D7E6 00000001        	  9546:     ori.b #$01,D0
02:0003D7EA 4EB9000316E0    	  9547:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003D7F0 101D            	  9548:     move.b  (A5)+,D0  ; PLA
