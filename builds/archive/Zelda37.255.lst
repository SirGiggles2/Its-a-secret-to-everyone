                            	  1313:     ; Else the flashing bubble blocks the sword temporarily.
                            	  1314:     ; Set a long timer to $10 ($A0 frames) for this purpose.
                            	  1315:     ;
02:00039C8A 7010            	  1316:     moveq   #16,D0
02:00039C8C 1940004C        	  1317:     move.b  D0,($004C,A4)
