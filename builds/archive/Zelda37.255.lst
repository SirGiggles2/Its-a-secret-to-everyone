                            	  5479: __far_z_07_0083:
                            	  5480:     ; State $2x. Spark.
                            	  5481:     ;
                            	  5482:     ; Change the state to $28, and decrement animation counter.
                            	  5483:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5484:     ; (with Link, if this is a monster's boomerang).
                            	  5485:     ;
                            	  5486:     ; TODO: Why state $28?
                            	  5487:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5488:     ; start over again when spinning.
                            	  5489:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5490:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5491:     ; any drawing code depends on the minor state.
                            	  5492:     ;
02:0004BB68 7028            	  5493:     moveq   #40,D0
02:0004BB6A 41EC00AC        	  5494:     lea     ($00AC,A4),A0
02:0004BB6E 11802000        	  5495:     move.b  D0,(A0,D2.W)
02:0004BB72 41EC03D0        	  5496:     lea     ($03D0,A4),A0
