02:0003BBCE 610039CC        	  5698:     jsr     Flyer_Chase
                            	  5699:     ; If timer has not expired, then
                            	  5700:     ; go see if it's time to propagate direction changes down the chain.
                            	  5701:     ;
02:0003BBD2 10342028        	  5702:     move.b  ($28,A4,D2.W),D0
02:0003BBD6 6702            	  5703:     beq.s  __far_z_04_0041
