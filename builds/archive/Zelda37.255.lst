02:0003EB72 4EB90004C536    	 12161:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003EB78 41EC03E4        	 12162:     lea     ($03E4,A4),A0
02:0003EB7C 10302000        	 12163:     move.b  (A0,D2.W),D0
