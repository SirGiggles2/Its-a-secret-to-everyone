02:0003A60C 0A3C0010        	  2740:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A610 9101            	  2741:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003A612 0A3C0010        	  2742:     eori    #$10,CCR  ; restore X = 6502 C
