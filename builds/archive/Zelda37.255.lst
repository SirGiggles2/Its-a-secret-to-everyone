02:0004157E 1600            	  3413:     move.b  D0,D3
02:00041580 41F900FF6BB2    	  3414:     lea     (NES_SRAM+$0BB2).l,A0
02:00041586 10303000        	  3415:     move.b  (A0,D3.W),D0
