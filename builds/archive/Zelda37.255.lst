02:0003C730 123C0014        	  7334:     move.b  #$14,D1
02:0003C734 D101            	  7335:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003C736 7600            	  7336:     moveq   #0,D3
02:0003C738 1600            	  7337:     move.b  D0,D3
