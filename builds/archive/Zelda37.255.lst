                            	   714: UpdateBlock0Idle:
                            	   715:     ; If there are monsters in the room, go reset the push timer and return.
                            	   716:     ;
02:0003980E 102C034D        	   717:     move.b  ($034D,A4),D0
02:00039812 6604            	   718:     bne.s  __far_z_04_0005
02:00039814 600000DA        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:00039818 102C0070        	   725:     move.b  ($0070,A4),D0
02:0003981C 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:00039820 B001            	   727:     cmp.b   D1,D0
02:00039822 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039824 7600            	   729:     moveq   #0,D3
02:00039826 102C0084        	   730:     move.b  ($0084,A4),D0
02:0003982A 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003982E 123C0003        	   732:     move.b  #$03,D1
02:00039832 D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039834 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:00039838 41EC0084        	   735:     lea     ($0084,A4),A0
02:0003983C 12302000        	   736:     move.b  (A0,D2.W),D1
02:00039840 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039844 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:00039846 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:0003984A 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:0003984C 102C0084        	   747:     move.b  ($0084,A4),D0
02:00039850 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039854 123C0003        	   749:     move.b  #$03,D1
02:00039858 D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003985A 41EC0084        	   751:     lea     ($0084,A4),A0
02:0003985E 12302000        	   752:     move.b  (A0,D2.W),D1
02:00039862 B001            	   753:     cmp.b   D1,D0
02:00039864 6704            	   754:     beq.s  __far_z_04_0006
02:00039866 60000088        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:0003986A 7602            	   760:     moveq   #2,D3
02:0003986C 102C0070        	   761:     move.b  ($0070,A4),D0
02:00039870 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:00039874 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:00039878 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003987C 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:0003987E 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:00039882 6A08            	   776:     bpl  _anon_z04_14
02:00039884 5203            	   777:     addq.b  #1,D3
02:00039886 4EB90003089E    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
                            	   780:     ; If the distance >= $11, then go reset the push timer and return.
                            	   781:     ;
02:0003988C 0C000011        	   782:     cmpi.b  #$11,D0
02:00039890 6502            	   783:     bcs.s  __far_z_04_0007
02:00039892 605C            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:00039894 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:00039898 41F9000397EC    	   792:     lea     (BlockPushDirections).l,A0
02:0003989E 12303000        	   793:     move.b  (A0,D3.W),D1
02:000398A2 B001            	   794:     cmp.b   D1,D0
02:000398A4 6702            	   795:     beq.s  __far_z_04_0008
02:000398A6 6048            	   796:     jmp  ResetPushTimer
                            	   797: __far_z_04_0008:
                            	   798:     ; Link is truly pushing the block.
                            	   799:     ;
                            	   800:     ; Increase the push timer.
                            	   801:     ;
02:000398A8 41EC0412        	   802:     lea     ($0412,A4),A0
02:000398AC 52302000        	   803:     addq.b  #1,(A0,D2.W)
                            	   804:     ; If the push timer still < $10, return.
                            	   805:     ;
02:000398B0 7600            	   806:     moveq   #0,D3
02:000398B2 41EC0412        	   807:     lea     ($0412,A4),A0
02:000398B6 16302000        	   808:     move.b  (A0,D2.W),D3
02:000398BA 0C030010        	   809:     cmpi.b  #$10,D3
02:000398BE 6402            	   810:     bcc.s  __far_z_04_0009
02:000398C0 6034            	   811:     jmp  L10262_Exit
