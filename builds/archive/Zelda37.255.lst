02:0004BD74 11802000        	  5788:     move.b  D0,(A0,D2.W)
02:0004BD78 41EC00AC        	  5789:     lea     ($00AC,A4),A0
02:0004BD7C 52302000        	  5790:     addq.b  #1,(A0,D2.W)
02:0004BD80 41EC00AC        	  5791:     lea     ($00AC,A4),A0
