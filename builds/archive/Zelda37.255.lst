02:0004BCC8 11803000        	  5705:     move.b  D0,(A0,D3.W)
02:0004BCCC 0A3C0001        	  5706:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004BCD0 4E75            	  5707:     rts
