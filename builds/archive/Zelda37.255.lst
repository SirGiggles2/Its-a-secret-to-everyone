                            	  8160:     ; Timer = 0. Only teleporting now.
                            	  8161:     ;
                            	  8162:     ; If there is still distance to go while translucent, then
                            	  8163:     ; decrement the distance remaining, and move.
                            	  8164:     ;
02:0003CD98 41EC0394        	  8165:     lea     ($0394,A4),A0
02:0003CD9C 10302000        	  8166:     move.b  (A0,D2.W),D0
02:0003CDA0 670A            	  8167:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003CDA2 41EC0394        	  8168:     lea     ($0394,A4),A0
