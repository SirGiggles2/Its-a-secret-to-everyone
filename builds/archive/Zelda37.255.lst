                            	   150: TransferCurTileBuf:
                            	   151:     ; PATCHED: DynTileBuf pending-record pre-check (generalized Bug C fix).
                            	   152:     ; If DynTileBuf is non-empty while TileBufSelector already points at a
                            	   153:     ; later static buffer, consume DynTileBuf first and leave selector intact
                            	   154:     ; for the next NMI. This preserves NES ordering for dynamic room/menu
                            	   155:     ; records that would otherwise be dropped by selector timing drift.
02:00044F3C 41F900FF0302    	   156:     lea     (NES_RAM+DynTileBuf).l,A0
02:00044F42 0C1000FF        	   157:     cmpi.b  #$FF,(A0)                  ; DynTileBuf empty sentinel?
02:00044F46 672E            	   158:     beq.s   .no_pending_dyn
02:00044F48 4A2C0014        	   159:     tst.b   ($0014,A4)                  ; TileBufSelector = 0 => normal DynTileBuf path
02:00044F4C 6728            	   160:     beq.s   .no_pending_dyn
02:00044F4E 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:00044F52 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:00044F58 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:00044F5C 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
02:00044F64 703F            	   165:     moveq   #63,D0
