                            	  1822:     ; If facing right, then set Link's X to 0 at the left edge.
                            	  1823:     ; If direction is left, then set Link's X to $F0 at the right edge.
                            	  1824:     ;
02:000409D2 7600            	  1825:     moveq   #0,D3
02:000409D4 102C0098        	  1826:     move.b  ($0098,A4),D0
02:000409D8 02000003        	  1827:     andi.b #$03,D0
