                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:00043104 102C0054        	  5844:     move.b  ($0054,A4),D0
02:00043108 0C000004        	  5845:     cmpi.b  #$04,D0
02:0004310C 6626            	  5846:     bne  _anon_z05_123
02:0004310E 7400            	  5847:     moveq   #0,D2
02:00043110 142C0009        	  5848:     move.b  ($0009,A4),D2
02:00043114 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:00043118 102C0055        	  5850:     move.b  ($0055,A4),D0
02:0004311C 0A00000F        	  5851:     eori.b #$0F,D0
02:00043120 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:00043124 C001            	  5853:     and.b  D1,D0
                            	  5854:     even
