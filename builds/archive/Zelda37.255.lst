                            	  2525: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2526: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2527: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2528: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2529: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2530: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2531:     even
                            	  2532: ModeE_SyncCharBoardCursorToIndex:
02:0003499E 4EF90002BADC    	  2533:     jmp     c_mode_e_sync_char_board_cursor
                            	  2534: 
                            	  2535: ModeE_HandleAOrB:
02:000349A4 102C0420        	  2536:     move.b  ($0420,A4),D0
                            	  2537:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2538:     ; the name field.
02:000349A8 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:000349AA 7600            	  2540:     moveq   #0,D3
02:000349AC 162C0016        	  2541:     move.b  ($0016,A4),D3
02:000349B0 0C030003        	  2542:     cmpi.b  #$03,D3
02:000349B4 6602            	  2543:     bne.s  __far_z_02_0007
02:000349B6 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:000349B8 41F9000343C6    	  2548:     lea     (SlotToNameOffset).l,A0
02:000349BE 10303000        	  2549:     move.b  (A0,D3.W),D0
02:000349C2 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:000349C6 7400            	  2553:     moveq   #0,D2
02:000349C8 41F9000343CA    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:000349CE 14303000        	  2555:     move.b  (A0,D3.W),D2
02:000349D2 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:000349D4 41F900034396    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:000349DA 10302000        	  2560:     move.b  (A0,D2.W),D0
