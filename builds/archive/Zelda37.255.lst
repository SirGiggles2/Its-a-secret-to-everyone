02:0003C778 41F90003C6D2    	  7384:     lea     (DodongoFrameHFlips).l,A0
02:0003C77E 10303000        	  7385:     move.b  (A0,D3.W),D0
02:0003C782 1940000F        	  7386:     move.b  D0,($000F,A4)
02:0003C786 41F90003C6C8    	  7387:     lea     (DodongoFrameImages).l,A0
02:0003C78C 10303000        	  7388:     move.b  (A0,D3.W),D0
                            	  7389:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7390:     ; They are drawn mirrored.
