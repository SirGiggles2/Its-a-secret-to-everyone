                            	  9774: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9775:     ; Here the eye is closed. So animate it this way.
                            	  9776:     ; Increment the animation counter, and if <> 8, then
                            	  9777:     ; go shoot, draw, and check collisions.
                            	  9778:     ;
02:0003D9A2 41EC0478        	  9779:     lea     ($0478,A4),A0
02:0003D9A6 52302000        	  9780:     addq.b  #1,(A0,D2.W)
02:0003D9AA 41EC0478        	  9781:     lea     ($0478,A4),A0
02:0003D9AE 10302000        	  9782:     move.b  (A0,D2.W),D0
02:0003D9B2 0C000008        	  9783:     cmpi.b  #$08,D0
02:0003D9B6 66C2            	  9784:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9785:     ; Roll over the eye animation counter to 0.
                            	  9786:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9787:     ;
02:0003D9B8 7000            	  9788:     moveq   #0,D0
02:0003D9BA 41EC0478        	  9789:     lea     ($0478,A4),A0
02:0003D9BE 11802000        	  9790:     move.b  D0,(A0,D2.W)
02:0003D9C2 41EC046B        	  9791:     lea     ($046B,A4),A0
02:0003D9C6 10302000        	  9792:     move.b  (A0,D2.W),D0
02:0003D9CA 02000001        	  9793:     andi.b #$01,D0
02:0003D9CE 0A000001        	  9794:     eori.b #$01,D0
                            	  9795:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	  9796:     ;
02:0003D9D2 609E            	  9797:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	  9798: 
                            	  9799:     even
                            	  9800: GohmaLegOffsetsX:
02:0003D9D4 F0              	  9801:     dc.b    $F0, $10
02:0003D9D5 10
                            	  9802: 
                            	  9803: ; Params:
                            	  9804: ; A: eye frame image
                            	  9805: ;
                            	  9806: ; Draw the eye with the frame image passed in.
                            	  9807: ;
                            	  9808:     even
                            	  9809: Gohma_AnimateAndDraw:
02:0003D9D6 1B00            	  9810:     move.b  D0,-(A5)  ; PHA
02:0003D9D8 4EB90004C53C    	  9811:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D9DE 6164            	  9812:     jsr     Gohma_SetSpriteAttributes
02:0003D9E0 101D            	  9813:     move.b  (A5)+,D0  ; PLA
02:0003D9E2 4EB9000313EA    	  9814:     jsr     DrawObjectMirrored
02:0003D9E8 7010            	  9815:     moveq   #16,D0
02:0003D9EA 4EB90004C536    	  9816:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  9817:     ; Draw the right legs.
                            	  9818:     ;
02:0003D9F0 7601            	  9819:     moveq   #1,D3
02:0003D9F2 6102            	  9820:     jsr     Gohma_DrawLegsOneSide
                            	  9821:     ; Draw the left legs.
                            	  9822:     ;
02:0003D9F4 7600            	  9823:     moveq   #0,D3
                            	  9824: ; Params:
                            	  9825: ; Y: side: 0 for left, 1 for right
                            	  9826: ;
                            	  9827: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9828: ; store the sprite's X in [00].
                            	  9829: ;
                            	  9830:     even
                            	  9831: Gohma_DrawLegsOneSide:
02:0003D9F6 10342070        	  9832:     move.b  ($70,A4,D2.W),D0
02:0003D9FA 023C00EE        	  9833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D9FE 41F90003D9D4    	  9834:     lea     (GohmaLegOffsetsX).l,A0
02:0003DA04 12303000        	  9835:     move.b  (A0,D3.W),D1
02:0003DA08 D101            	  9836:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DA0A 1880            	  9837:     move.b  D0,($0000,A4)
                            	  9838:     ; The object's Y is the sprite's.
                            	  9839:     ;
02:0003DA0C 41EC0084        	  9840:     lea     ($0084,A4),A0
02:0003DA10 10302000        	  9841:     move.b  (A0,D2.W),D0
02:0003DA14 19400001        	  9842:     move.b  D0,($0001,A4)
02:0003DA18 612A            	  9843:     jsr     Gohma_SetSpriteAttributes
                            	  9844:     ; There are only two frame images for legs: left and right.
                            	  9845:     ; There are two animation frames. They are animated as follows:
                            	  9846:     ;
                            	  9847:     ; Frame 0:
                            	  9848:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9849:     ; horizontal flipping = frame number = 0
                            	  9850:     ; 
                            	  9851:     ; Frame 1:
                            	  9852:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9853:     ; horizontal flipping = frame number = 1
                            	  9854:     ;
02:0003DA1A 4EB90004C50E    	  9855:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DA20 1003            	  9856:     move.b  D3,D0
02:0003DA22 023C00EE        	  9857:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DA26 41EC03E4        	  9858:     lea     ($03E4,A4),A0
02:0003DA2A 12302000        	  9859:     move.b  (A0,D2.W),D1
02:0003DA2E D101            	  9860:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003DA30 02000001        	  9861:     andi.b #$01,D0
02:0003DA34 023C00EE        	  9862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DA38 123C0004        	  9863:     move.b  #$04,D1
02:0003DA3C D101            	  9864:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DA3E 4EF9000313EE    	  9865:     jmp     DrawObjectNotMirrored
                            	  9866: 
                            	  9867: ; Returns:
                            	  9868: ; [04]: left side sprite attributes
                            	  9869: ; [05]: right side sprite attributes
                            	  9870: ;
                            	  9871:     even
                            	  9872: Gohma_SetSpriteAttributes:
02:0003DA44 4EF90002BF4C    	  9873:     jmp     c_gohma_set_sprite_attributes
                            	  9874: 
                            	  9875: Gohma_CheckCollisions:
                            	  9876:     ; Save the boss's X coordinate.
                            	  9877:     ;
02:0003DA4A 10342070        	  9878:     move.b  ($70,A4,D2.W),D0
02:0003DA4E 1B00            	  9879:     move.b  D0,-(A5)  ; PHA
                            	  9880:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  9881:     ; on the left side.
                            	  9882:     ;
02:0003DA50 003C0011        	  9883:     ori     #$11,CCR  ; SEC: set C+X
02:0003DA54 123C0010        	  9884:     move.b  #$10,D1
02:0003DA58 0A3C0010        	  9885:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DA5C 9101            	  9886:     subx.b  D1,D0   ; SBC #$10
02:0003DA5E 0A3C0010        	  9887:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DA62 19802070        	  9888:     move.b  D0,($70,A4,D2.W)
                            	  9889:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	  9890:     ; from left to right, indexed by [0F].
                            	  9891:     ;
02:0003DA66 7005            	  9892:     moveq   #5,D0
02:0003DA68 1940000F        	  9893:     move.b  D0,($000F,A4)
                            	  9894:     even
                            	  9895: _L_z04_Gohma_CheckCollisions_LoopSprite:
02:0003DA6C 4EB90003176A    	  9896:     jsr     CheckMonsterCollisions
                            	  9897:     ; Add 8 to the X coordinate for the next part.
                            	  9898:     ;
02:0003DA72 10342070        	  9899:     move.b  ($70,A4,D2.W),D0
02:0003DA76 023C00EE        	  9900:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DA7A 123C0008        	  9901:     move.b  #$08,D1
02:0003DA7E D101            	  9902:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003DA80 19802070        	  9903:     move.b  D0,($70,A4,D2.W)
02:0003DA84 532C000F        	  9904:     subq.b  #1,($000F,A4)
02:0003DA88 66E2            	  9905:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	  9906:     ; Restore the boss's X coordinate.
                            	  9907:     ;
02:0003DA8A 101D            	  9908:     move.b  (A5)+,D0  ; PLA
02:0003DA8C 19802070        	  9909:     move.b  D0,($70,A4,D2.W)
