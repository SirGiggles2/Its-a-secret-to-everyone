02:0003C912 10302000        	  7605:     move.b  (A0,D2.W),D0
02:0003C916 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C91A 41F90003C8AA    	  7607:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003C920 12303000        	  7608:     move.b  (A0,D3.W),D1
