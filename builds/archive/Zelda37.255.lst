                            	  1612: _L_z04_Gel_Move_Move:
                            	  1613:     ; Blocked or timer expired.
                            	  1614:     ;
                            	  1615:     ; Set X coordinate to ((X + 8) AND $F0).
                            	  1616:     ;
02:00039EAA 10342070        	  1617:     move.b  ($70,A4,D2.W),D0
02:00039EAE 023C00EE        	  1618:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039EB2 123C0008        	  1619:     move.b  #$08,D1
02:00039EB6 D101            	  1620:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00039EB8 020000F0        	  1621:     andi.b #$F0,D0
02:00039EBC 19802070        	  1622:     move.b  D0,($70,A4,D2.W)
                            	  1623:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1624:     ;
02:00039EC0 41EC0084        	  1625:     lea     ($0084,A4),A0
02:00039EC4 10302000        	  1626:     move.b  (A0,D2.W),D0
02:00039EC8 123C0008        	  1627:     move.b  #$08,D1
02:00039ECC D101            	  1628:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00039ECE 020000F0        	  1629:     andi.b #$F0,D0
02:00039ED2 0000000D        	  1630:     ori.b #$0D,D0
02:00039ED6 41EC0084        	  1631:     lea     ($0084,A4),A0
02:00039EDA 11802000        	  1632:     move.b  D0,(A0,D2.W)
                            	  1633:     ; Reset the grid offset, and go to state 2.
                            	  1634:     ;
