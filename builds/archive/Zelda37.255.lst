                            	  6021: _L_z07_UpdateSwordOrRod_Add4:
                            	  6022:     ; Set [00] to (state - 1) * 4:
                            	  6023:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6024:     ;
02:0004BF3C 023C00EE        	  6025:     andi    #$EE,CCR  ; CLC: clear C+X
