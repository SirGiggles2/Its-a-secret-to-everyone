02:0004B91E 123C0001        	  5143:     move.b  #$01,D1
02:0004B922 D101            	  5144:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004B924 19803000        	  5145:     move.b  D0,($00,A4,D3.W)
                            	  5146:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5147:     ;
02:0004B928 101D            	  5148:     move.b  (A5)+,D0  ; PLA
