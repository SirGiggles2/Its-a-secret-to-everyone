                            	   235: InitCave:
                            	   236:     ; The person goes at location ($78, $80).
                            	   237:     ;
02:0002E680 7078            	   238:     moveq   #120,D0
02:0002E682 163C0080        	   239:     move.b  #$80,D3
02:0002E686 610001A0        	   240:     jsr     SetUpCommonCaveObjects
                            	   241:     ; If the cave/person does not remember state (give item, door charge),
                            	   242:     ; then go handle other kinds.
                            	   243:     ;
02:0002E68A 102C0350        	   244:     move.b  ($0350,A4),D0
02:0002E68E 0C000072        	   245:     cmpi.b  #$72,D0
02:0002E692 6714            	   246:     beq  _L_z01_InitCave_TakeType
02:0002E694 0C000071        	   247:     cmpi.b  #$71,D0
02:0002E698 670E            	   248:     beq  _L_z01_InitCave_TakeType
02:0002E69A 0C00007B        	   249:     cmpi.b  #$7B,D0
02:0002E69E 6408            	   250:     bcc  _L_z01_InitCave_TakeType
02:0002E6A0 0C00006E        	   251:     cmpi.b  #$6E,D0
02:0002E6A4 6502            	   252:     bcs.s  __far_z_01_0000
02:0002E6A6 6012            	   253:     jmp  InitCaveContinue
                            	   254: __far_z_01_0000:
                            	   255:     even
                            	   256: _L_z01_InitCave_TakeType:
                            	   257:     ; Else the cave/person simply does:
                            	   258:     ; - taken:     no person, no text
                            	   259:     ; - not taken: show a person and text
                            	   260:     ;
                            	   261:     ; So, if the item was not taken, then go set up the text.
                            	   262:     ;
02:0002E6A8 610026EA        	   263:     jsr     GetRoomFlagUWItemState
02:0002E6AC 6602            	   264:     bne.s  __far_z_01_0001
02:0002E6AE 600A            	   265:     jmp  InitCaveContinue
                            	   266: __far_z_01_0001:
                            	   267:     ; Otherwise destroy the person object, and let Link continue.
                            	   268:     ;
02:0002E6B0 7000            	   269:     moveq   #0,D0
02:0002E6B2 19400350        	   270:     move.b  D0,($0350,A4)
                            	   271:     even
                            	   272: UnhaltLink:
02:0002E6B6 6000D336        	   273:     jmp     c_unhalt_link
                            	   274: 
                            	   275: InitCaveContinue:
                            	   276:     ; Get this cave's index (object type - $6A).
                            	   277:     ;
02:0002E6BA 102C0350        	   278:     move.b  ($0350,A4),D0
02:0002E6BE 003C0011        	   279:     ori     #$11,CCR  ; SEC: set C+X
02:0002E6C2 123C006A        	   280:     move.b  #$6A,D1
02:0002E6C6 0A3C0010        	   281:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E6CA 9101            	   282:     subx.b  D1,D0   ; SBC #$6A
02:0002E6CC 0A3C0010        	   283:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E6D0 7600            	   284:     moveq   #0,D3
02:0002E6D2 1600            	   285:     move.b  D0,D3
                            	   286:     ; Get the person text selector by looking up the text selector byte
                            	   287:     ; for this index, and masking it with $3F.
                            	   288:     ;
02:0002E6D4 41F90002E652    	   289:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E6DA 10303000        	   290:     move.b  (A0,D3.W),D0
02:0002E6DE 1B00            	   291:     move.b  D0,-(A5)  ; PHA
02:0002E6E0 0200003F        	   292:     andi.b #$3F,D0
02:0002E6E4 19400415        	   293:     move.b  D0,($0415,A4)
                            	   294:     ; Pop and mask the text selector byte with $C0 to get the
                            	   295:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   296:     ;
02:0002E6E8 101D            	   297:     move.b  (A5)+,D0  ; PLA
02:0002E6EA 020000C0        	   298:     andi.b #$C0,D0
02:0002E6EE 19400003        	   299:     move.b  D0,($0003,A4)
                            	   300:     ; At this point, the Y register still has the cave index.
                            	   301:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   302:     ;
02:0002E6F2 103C00FD        	   303:     move.b  #$FD,D0
                            	   304: _anon_z01_0:
02:0002E6F6 023C00EE        	   305:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E6FA 123C0003        	   306:     move.b  #$03,D1
02:0002E6FE D101            	   307:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E700 5303            	   308:     subq.b  #1,D3
02:0002E702 6AF2            	   309:     bpl  _anon_z01_0
02:0002E704 7600            	   310:     moveq   #0,D3
02:0002E706 1600            	   311:     move.b  D0,D3
                            	   312:     ; Loop over the wares from 0 to 2.
                            	   313:     ;
02:0002E708 7400            	   314:     moveq   #0,D2
                            	   315:     even
                            	   316: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   317:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   318:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   319:     ;
02:0002E70A 41F900FF6A7E    	   320:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E710 10303000        	   321:     move.b  (A0,D3.W),D0
02:0002E714 41EC0422        	   322:     lea     ($0422,A4),A0
02:0002E718 11802000        	   323:     move.b  D0,(A0,D2.W)
                            	   324:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   325:     ;
02:0002E71C 020000C0        	   326:     andi.b #$C0,D0
02:0002E720 19802000        	   327:     move.b  D0,($00,A4,D2.W)
                            	   328:     ; Copy 3 prices from the Cave level block info.
                            	   329:     ;
02:0002E724 41F900FF6ABA    	   330:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E72A 10303000        	   331:     move.b  (A0,D3.W),D0
02:0002E72E 41EC0430        	   332:     lea     ($0430,A4),A0
02:0002E732 11802000        	   333:     move.b  D0,(A0,D2.W)
                            	   334:     ; Bottom of the wares copying loop.
                            	   335:     ;
02:0002E736 5203            	   336:     addq.b  #1,D3
02:0002E738 5202            	   337:     addq.b  #1,D2
02:0002E73A 0C020003        	   338:     cmpi.b  #$03,D2
02:0002E73E 66CA            	   339:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   340:     ; Get the top 2 bits of text selector byte in [03],
                            	   341:     ; shift them to the bottom, and combine them with [00].
                            	   342:     ;
02:0002E740 102C0003        	   343:     move.b  ($0003,A4),D0
02:0002E744 E308            	   344:     lsl.b  #1,D0   ; ASL A
02:0002E746 E310            	   345:     roxl.b  #1,D0   ; ROL A
02:0002E748 E310            	   346:     roxl.b  #1,D0   ; ROL A
02:0002E74A 1214            	   347:     move.b  ($0000,A4),D1
02:0002E74C 8001            	   348:     or.b  D1,D0
02:0002E74E 1880            	   349:     move.b  D0,($0000,A4)
                            	   350:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   351:     ; and combine them with [00].
                            	   352:     ;
02:0002E750 102C0002        	   353:     move.b  ($0002,A4),D0
02:0002E754 E208            	   354:     lsr.b  #1,D0   ; LSR A
02:0002E756 E208            	   355:     lsr.b  #1,D0   ; LSR A
02:0002E758 E208            	   356:     lsr.b  #1,D0   ; LSR A
02:0002E75A E208            	   357:     lsr.b  #1,D0   ; LSR A
02:0002E75C 1214            	   358:     move.b  ($0000,A4),D1
02:0002E75E 8001            	   359:     or.b  D1,D0
02:0002E760 1880            	   360:     move.b  D0,($0000,A4)
                            	   361:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   362:     ; and combine them with [00] into CaveFlags.
                            	   363:     ;
02:0002E762 102C0001        	   364:     move.b  ($0001,A4),D0
02:0002E766 E208            	   365:     lsr.b  #1,D0   ; LSR A
02:0002E768 E208            	   366:     lsr.b  #1,D0   ; LSR A
02:0002E76A 1214            	   367:     move.b  ($0000,A4),D1
02:0002E76C 8001            	   368:     or.b  D1,D0
02:0002E76E 19400413        	   369:     move.b  D0,($0413,A4)
                            	   370:     ; The end result is a byte with 8 cave flags.
                            	   371:     ;
                            	   372:     ; If cave flag "money game" is missing, then go finish up,
                            	   373:     ; instead of choosing random amounts for the money game.
                            	   374:     ;
02:0002E772 02000020        	   375:     andi.b #$20,D0
02:0002E776 6700009E        	   376:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   377:     ; Determine an index randomly with increasing probability,
                            	   378:     ; from 6 to 1. Start with the following test:
                            	   379:     ;
                            	   380:     ;   If $FF < Random, then go use index 6.
                            	   381:     ;
02:0002E77A 103C00FF        	   382:     move.b  #$FF,D0
02:0002E77E 7606            	   383:     moveq   #6,D3
                            	   384:     even
                            	   385: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E780 122C0019        	   386:     move.b  ($0019,A4),D1
02:0002E784 B001            	   387:     cmp.b   D1,D0
02:0002E786 6516            	   388:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   389:     ; If the test fails, then subtract $2B from the reference number.
                            	   390:     ;
02:0002E788 003C0011        	   391:     ori     #$11,CCR  ; SEC: set C+X
02:0002E78C 123C002B        	   392:     move.b  #$2B,D1
02:0002E790 0A3C0010        	   393:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E794 9101            	   394:     subx.b  D1,D0   ; SBC #$2B
02:0002E796 0A3C0010        	   395:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E79A 5303            	   396:     subq.b  #1,D3
02:0002E79C 66E2            	   397:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   398:     even
                            	   399: _L_z01_InitCaveContinue_FoundPermutation:
                            	   400:     ; The index chooses the last offset of a permutation of three indexes.
                            	   401:     ;
02:0002E79E 7400            	   402:     moveq   #0,D2
02:0002E7A0 41F90002E67A    	   403:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E7A6 14303000        	   404:     move.b  (A0,D3.W),D2
                            	   405:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   406:     ;
02:0002E7AA 7602            	   407:     moveq   #2,D3
                            	   408:     even
                            	   409: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E7AC 41F90002E668    	   410:     lea     (MoneyGamePermutations).l,A0
02:0002E7B2 10302000        	   411:     move.b  (A0,D2.W),D0
02:0002E7B6 41EC046C        	   412:     lea     ($046C,A4),A0
02:0002E7BA 11803000        	   413:     move.b  D0,(A0,D3.W)
02:0002E7BE 5302            	   414:     subq.b  #1,D2
02:0002E7C0 5303            	   415:     subq.b  #1,D3
02:0002E7C2 6AE8            	   416:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   417:     ; With the first bit of another random number, choose 10 or 40
                            	   418:     ; to put in [046F]. This is a random amount to lose.
                            	   419:     ;
02:0002E7C4 102C001A        	   420:     move.b  ($001A,A4),D0
02:0002E7C8 02000001        	   421:     andi.b #$01,D0
02:0002E7CC 7600            	   422:     moveq   #0,D3
02:0002E7CE 1600            	   423:     move.b  D0,D3
02:0002E7D0 41F90002E666    	   424:     lea     (MoneyGameLossAmounts).l,A0
02:0002E7D6 10303000        	   425:     move.b  (A0,D3.W),D0
02:0002E7DA 1940046F        	   426:     move.b  D0,($046F,A4)
                            	   427:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   428:     ;
02:0002E7DE 700A            	   429:     moveq   #10,D0
02:0002E7E0 19400470        	   430:     move.b  D0,($0470,A4)
                            	   431:     ; With a different bit of the second random number,
                            	   432:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   433:     ;
02:0002E7E4 7614            	   434:     moveq   #20,D3
02:0002E7E6 102C001A        	   435:     move.b  ($001A,A4),D0
02:0002E7EA 02000002        	   436:     andi.b #$02,D0
02:0002E7EE 6702            	   437:     beq  _anon_z01_1
02:0002E7F0 7632            	   438:     moveq   #50,D3
                            	   439: _anon_z01_1:
02:0002E7F2 19430471        	   440:     move.b  D3,($0471,A4)
                            	   441:     ; The 3 amounts are now in [046F] to [0471].
                            	   442:     ; Reference these amounts using the permutation of indexes
                            	   443:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   444:     ;
02:0002E7F6 7402            	   445:     moveq   #2,D2
