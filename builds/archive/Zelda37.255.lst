02:0003FB2E 102C0254        	   430:     move.b  ($0254,A4),D0
02:0003FB32 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0003FB34 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003FB38 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003FB3A 4EB90004A12A    	   434:     jsr     HideAllSprites
02:0003FB40 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0003FB42 19400258        	   436:     move.b  D0,($0258,A4)
02:0003FB46 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:0003FB48 19400254        	   438:     move.b  D0,($0254,A4)
02:0003FB4C 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0003FB50 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003FB54 4E75            	   441:     rts
