02:0004B89E 9101            	  5069:     subx.b  D1,D0   ; SBC ObjX,X
02:0004B8A0 0A3C0010        	  5070:     eori    #$10,CCR  ; restore X = 6502 C
02:0004B8A4 6014            	  5071:     jmp     _L_z07_SpreadShot_CheckDistance
