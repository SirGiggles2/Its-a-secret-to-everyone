                            	  5715: __far_z_05_0076:
                            	  5716:     ; Turn the door command into the desired open or closed state
                            	  5717:     ; to store in [08].
                            	  5718:     ;
                            	  5719:     ; cmd:  7 6 3 2 
                            	  5720:     ; [08]: 2 0 0 0
                            	  5721:     ;
                            	  5722:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5723:     ; commands intended to be used.
                            	  5724:     ;
                            	  5725:     ; 3 is the end state of 2: close
                            	  5726:     ; 7 is the end state of 6: open
                            	  5727:     ;
02:00043032 02000007        	  5728:     andi.b #$07,D0
02:00043036 7601            	  5729:     moveq   #1,D3
02:00043038 19430002        	  5730:     move.b  D3,($0002,A4)
02:0004303C 122C0002        	  5731:     move.b  ($0002,A4),D1
02:00043040 C200            	  5732:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043042 6702            	  5733:     beq  _anon_z05_118
02:00043044 E208            	  5734:     lsr.b  #1,D0   ; LSR A
                            	  5735: _anon_z05_118:
