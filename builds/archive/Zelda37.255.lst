                            	  3260:     ;
02:0003A9FA 122C0001        	  3261:     move.b  ($0001,A4),D1
02:0003A9FE B001            	  3262:     cmp.b   D1,D0
02:0003AA00 6510            	  3263:     bcs  _L_z04_UpdateRedLeever_Subtract
