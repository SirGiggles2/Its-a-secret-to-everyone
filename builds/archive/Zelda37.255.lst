02:0003A978 19802070        	  3184:     move.b  D0,($70,A4,D2.W)
                            	  3185:     ; If facing down, then use Y offset $28.
                            	  3186:     ; Else store Y offset -$28 in [00].
                            	  3187:     ;
02:0003A97C 7628            	  3188:     moveq   #40,D3
02:0003A97E 41EC0098        	  3189:     lea     ($0098,A4),A0
02:0003A982 10302000        	  3190:     move.b  (A0,D2.W),D0
02:0003A986 02000008        	  3191:     andi.b #$08,D0
02:0003A98A 6704            	  3192:     beq  _anon_z04_44
02:0003A98C 163C00D8        	  3193:     move.b  #$D8,D3
                            	  3194: _anon_z04_44:
02:0003A990 1883            	  3195:     move.b  D3,($0000,A4)
                            	  3196:     ; Add Link's Y and the vertical offset.
                            	  3197:     ;
02:0003A992 102C0084        	  3198:     move.b  ($0084,A4),D0
02:0003A996 023C00EE        	  3199:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A99A 1214            	  3200:     move.b  ($0000,A4),D1
02:0003A99C D101            	  3201:     addx.b  D1,D0   ; ADC $00
                            	  3202:     ; Sanitize the Y coordinate:
                            	  3203:     ; (Y AND $F0) OR $D
                            	  3204:     ;
02:0003A99E 020000F0        	  3205:     andi.b #$F0,D0
02:0003A9A2 0000000D        	  3206:     ori.b #$0D,D0
02:0003A9A6 41EC0084        	  3207:     lea     ($0084,A4),A0
02:0003A9AA 11802000        	  3208:     move.b  D0,(A0,D2.W)
                            	  3209:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3210:     ; go see if the tile is valid to come out of.
                            	  3211:     ;
                            	  3212:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3213:     ;
02:0003A9AE 0C00005D        	  3214:     cmpi.b  #$5D,D0
02:0003A9B2 647A            	  3215:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
