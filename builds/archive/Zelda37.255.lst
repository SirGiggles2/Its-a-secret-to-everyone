02:000418A2 1214            	  3874:     move.b  ($00,A4),D1   ; ptr lo
02:000418A4 182C0001        	  3875:     move.b  ($01,A4),D4  ; ptr hi
02:000418A8 024100FF        	  3876:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000418AC E14C            	  3877:     lsl.w   #8,D4
