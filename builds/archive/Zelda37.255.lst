                            	  6004: ; Params:
                            	  6005: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  6006: ; [00]: weapon object slot (unused)
                            	  6007: ; [02]: object 1 mid X
                            	  6008: ; [03]: object 1 mid Y
                            	  6009: ; [04]: object 2 mid X
                            	  6010: ; [05]: object 2 mid Y
                            	  6011: ;
                            	  6012: ; Returns:
                            	  6013: ; A: 1 if objects collide
                            	  6014: ; Y: weapon object slot
                            	  6015: ; Z: 0 if objects collide
                            	  6016: ; [06]: 1 if objects collide
                            	  6017: ; [0A]: horizontal distance
                            	  6018: ; [0B]: vertical distance
                            	  6019: ;
                            	  6020: ;
                            	  6021: ; Use the same threshold value horizontally and vertically.
                            	  6022: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  6023: ;
                            	  6024:     even
                            	  6025: DoObjectsCollide:
02:00031F3C 1940000D        	  6026:     move.b  D0,($000D,A4)
02:00031F40 1940000E        	  6027:     move.b  D0,($000E,A4)
                            	  6028: ; Params:
                            	  6029: ; [00]: weapon or Link object slot (unused)
                            	  6030: ; [02]: object 1 mid X
                            	  6031: ; [03]: object 1 mid Y
                            	  6032: ; [04]: object 2 mid X
                            	  6033: ; [05]: object 2 mid Y
                            	  6034: ; [0D]: horizontal threshold
                            	  6035: ; [0E]: vertical threshold
                            	  6036: ;
                            	  6037: ; Returns:
                            	  6038: ; A: 1 if objects collide
                            	  6039: ; Y: weapon or Link object slot (copied from [00])
                            	  6040: ; Z: 0 if objects collide
                            	  6041: ; [06]: 1 if objects collide
                            	  6042: ; [0A]: horizontal distance
                            	  6043: ; [0B]: vertical distance
                            	  6044: ;
                            	  6045: ;
                            	  6046: ; Reset [06] to indicate no collision by default.
                            	  6047: ;
                            	  6048:     even
