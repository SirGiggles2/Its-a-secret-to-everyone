02:0003C86C 41EC03E4        	  7511:     lea     ($03E4,A4),A0
02:0003C870 16302000        	  7512:     move.b  (A0,D2.W),D3
02:0003C874 671E            	  7513:     beq  _anon_z04_95
02:0003C876 023C00EE        	  7514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C87A 123C0003        	  7515:     move.b  #$03,D1
02:0003C87E D101            	  7516:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7517:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7518:     ;
