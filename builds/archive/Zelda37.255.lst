                            	  1816: UpdateStatues:
                            	  1817:     ; If person fireballs are enabled (from the two fires), then
                            	  1818:     ; go make fireballs with pattern 2.
                            	  1819:     ;
02:0003A00E 7602            	  1820:     moveq   #2,D3
02:0003A010 102C04CC        	  1821:     move.b  ($04CC,A4),D0
02:0003A014 6620            	  1822:     bne  _L_z04_UpdateStatues_Shoot
                            	  1823:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1824:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1825:     ; - layout $23: pattern 1: 2 statues
                            	  1826:     ; - layout $24: pattern 0: 4 statues
                            	  1827:     ;
02:0003A016 4EB90004A598    	  1828:     jsr     GetUniqueRoomId
02:0003A01C 7601            	  1829:     moveq   #1,D3
                            	  1830: _anon_z04_30:
02:0003A01E 41F900039FF0    	  1831:     lea     (StatueRoomLayouts).l,A0
02:0003A024 12303000        	  1832:     move.b  (A0,D3.W),D1
02:0003A028 B001            	  1833:     cmp.b   D1,D0
02:0003A02A 670A            	  1834:     beq  _L_z04_UpdateStatues_Shoot
02:0003A02C 5303            	  1835:     subq.b  #1,D3
02:0003A02E 6AEE            	  1836:     bpl  _anon_z04_30
