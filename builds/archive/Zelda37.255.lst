02:000362F6 41F90003627A    	  5049:     lea     (CreditsLastScreenList).l,A0
02:000362FC 12303000        	  5050:     move.b  (A0,D3.W),D1
02:00036300 B001            	  5051:     cmp.b   D1,D0
02:00036302 651C            	  5052:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  5053:     ; If we haven't scrolled the last amount in the last screen,
