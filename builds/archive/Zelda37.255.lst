                            	  7277:     ; We want to handle "enemies from the edges of the screen".
                            	  7278:     ;
                            	  7279:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7280:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7281:     ; that does not spawn with a cloud (type >= $53);
                            	  7282:     ; 
                            	  7283:     ; then go initialize the object.
                            	  7284:     ;
02:0004C8F6 102C0010        	  7285:     move.b  ($0010,A4),D0
