02:00043144 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:00043146 7400            	  5879:     moveq   #0,D2
02:00043148 142C0009        	  5880:     move.b  ($0009,A4),D2
02:0004314C 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00043150 1003            	  5884:     move.b  D3,D0
02:00043152 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043156 41F900043012    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:0004315C 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00043160 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043162 7600            	  5889:     moveq   #0,D3
02:00043164 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:00043166 1002            	  5893:     move.b  D2,D0
02:00043168 0A000001        	  5894:     eori.b #$01,D0
02:0004316C 7400            	  5895:     moveq   #0,D2
02:0004316E 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00043170 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:00043172 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:00043176 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
