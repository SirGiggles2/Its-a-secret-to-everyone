02:00033262 E14C            	   528:     lsl.w   #8,D4
02:00033264 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033266 48C4            	   530:     ext.l   D4
02:00033268 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003326E 2044            	   532:     movea.l D4,A0
02:00033270 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033274 41EC0633        	   534:     lea     ($0633,A4),A0
02:00033278 11803000        	   535:     move.b  D0,(A0,D3.W)
02:0003327C 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:0003327E 1003            	   537:     move.b  D3,D0
02:00033280 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:00033282 19430016        	   539:     move.b  D3,($0016,A4)
02:00033286 6100D30E        	   540:     jsr     FetchFileAAddressSet
02:0003328A 61001C38        	   541:     jsr     FormatFileA
