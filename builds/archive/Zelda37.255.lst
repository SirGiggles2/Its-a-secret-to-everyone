02:0003C6DC 04              	  7282:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003C6DD 05
02:0003C6DE 07
02:0003C6DF FF
02:0003C6E0 09
02:0003C6E1 04
02:0003C6E2 05
02:0003C6E3 07
02:0003C6E4 FF              	  7283:     dc.b    $FF, $09
02:0003C6E5 09
                            	  7284: 
                            	  7285:     even
                            	  7286: DodongoFrameHFlipsBloated:
02:0003C6E6 00              	  7287:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003C6E7 40
02:0003C6E8 00
02:0003C6E9 FF
02:0003C6EA 00
02:0003C6EB 00
02:0003C6EC 40
02:0003C6ED 00
02:0003C6EE FF              	  7288:     dc.b    $FF, $00
02:0003C6EF 00
