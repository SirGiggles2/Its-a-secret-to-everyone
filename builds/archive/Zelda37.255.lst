02:0004C8FE 102C04CD        	  7287:     move.b  ($04CD,A4),D0
02:0004C902 02000008        	  7288:     andi.b #$08,D0
02:0004C906 6700018A        	  7289:     beq  _L_z07_InitObject_NormalSpawn
02:0004C90A 41EC034F        	  7290:     lea     ($034F,A4),A0
02:0004C90E 10302000        	  7291:     move.b  (A0,D2.W),D0
02:0004C912 0C000011        	  7292:     cmpi.b  #$11,D0
02:0004C916 6700017A        	  7293:     beq  _L_z07_InitObject_NormalSpawn
02:0004C91A 0C000040        	  7294:     cmpi.b  #$40,D0
02:0004C91E 67000172        	  7295:     beq  _L_z07_InitObject_NormalSpawn
02:0004C922 0C00001E        	  7296:     cmpi.b  #$1E,D0
02:0004C926 6700016A        	  7297:     beq  _L_z07_InitObject_NormalSpawn
02:0004C92A 0C00002E        	  7298:     cmpi.b  #$2E,D0
02:0004C92E 67000162        	  7299:     beq  _L_z07_InitObject_NormalSpawn
02:0004C932 0C000053        	  7300:     cmpi.b  #$53,D0
02:0004C936 6400015A        	  7301:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7302:     even
                            	  7303: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7304:     ; If the "monsters from edges" long timer expired, then
                            	  7305:     ; go bring the monster in.
                            	  7306:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7307:     ;
                            	  7308:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7309:     ; residual position so enemies keep their previous-room
                            	  7310:     ; positions instead of being re-edge-spawned (matches NES).
02:0004C93A 102C004B        	  7311:     move.b  ($004B,A4),D0
02:0004C93E 662E            	  7312:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7313:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004C940 102C000F        	  7314:     move.b  ($000F,A4),D0
02:0004C944 0C0000FF        	  7315:     cmpi.b  #$FF,D0
02:0004C948 662E            	  7316:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004C94A 41EC0070        	  7317:     lea     ($0070,A4),A0
02:0004C94E 10302000        	  7318:     move.b  (A0,D2.W),D0
02:0004C952 660A            	  7319:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004C954 41EC0084        	  7320:     lea     ($0084,A4),A0
02:0004C958 10302000        	  7321:     move.b  (A0,D2.W),D0
02:0004C95C 671A            	  7322:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7323:     even
                            	  7324: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
