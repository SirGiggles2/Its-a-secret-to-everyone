                            	  7559: _anon_z04_96:
                            	  7560:     ; If we have the magic clock, or is stunned, then
                            	  7561:     ; go draw and check collisions.
                            	  7562:     ;
02:0003C8CC 102C066C        	  7563:     move.b  ($066C,A4),D0
02:0003C8D0 1234203D        	  7564:     move.b  ($3D,A4,D2.W),D1
02:0003C8D4 8001            	  7565:     or.b  D1,D0
02:0003C8D6 660000AE        	  7566:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7567:     ; Every odd screen frame, go straight to drawing
                            	  7568:     ; and checking collisions.
