02:00030984 1014            	  3033:     move.b  ($0000,A4),D0
02:00030986 023C00EE        	  3034:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003098A 122C0001        	  3035:     move.b  ($0001,A4),D1
02:0003098E D101            	  3036:     addx.b  D1,D0   ; ADC $01
02:00030990 1880            	  3037:     move.b  D0,($0000,A4)
                            	  3038:     ; TODO: call it speed index or angle?
                            	  3039:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  3040:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  3041:     ;
02:00030992 6728            	  3042:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030994 0C000008        	  3043:     cmpi.b  #$08,D0
02:00030998 6722            	  3044:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3045:     ; Subtract the lesser distance from the greater distance.
                            	  3046:     ; If they still haven't crossed, then we can turn more.
                            	  3047:     ;
02:0003099A 102C0003        	  3048:     move.b  ($0003,A4),D0
02:0003099E 003C0011        	  3049:     ori     #$11,CCR  ; SEC: set C+X
02:000309A2 122C0004        	  3050:     move.b  ($0004,A4),D1
02:000309A6 0A3C0010        	  3051:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000309AA 9101            	  3052:     subx.b  D1,D0   ; SBC $04
02:000309AC 0A3C0010        	  3053:     eori    #$10,CCR  ; restore X = 6502 C
02:000309B0 19400003        	  3054:     move.b  D0,($0003,A4)
02:000309B4 122C0004        	  3055:     move.b  ($0004,A4),D1
02:000309B8 B001            	  3056:     cmp.b   D1,D0
02:000309BA 64C8            	  3057:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  3058:     even
