02:00039C9A 0A3C0010        	  1328:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039C9E 9101            	  1329:     subx.b  D1,D0   ; SBC #$2C
02:00039CA0 0A3C0010        	  1330:     eori    #$10,CCR  ; restore X = 6502 C
02:00039CA4 1940052E        	  1331:     move.b  D0,($052E,A4)
02:00039CA8 0A3C0001        	  1332:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00039CAC 4E75            	  1333:     rts
