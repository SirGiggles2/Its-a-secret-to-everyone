02:00040A34 41EC0098        	  1878:     lea     ($0098,A4),A0
02:00040A38 11802000        	  1879:     move.b  D0,(A0,D2.W)
02:00040A3C 1980203D        	  1880:     move.b  D0,($3D,A4,D2.W)
02:00040A40 41EC03D0        	  1881:     lea     ($03D0,A4),A0
02:00040A44 52302000        	  1882:     addq.b  #1,(A0,D2.W)
02:00040A48 41EC0405        	  1883:     lea     ($0405,A4),A0
02:00040A4C 52302000        	  1884:     addq.b  #1,(A0,D2.W)
02:00040A50 7020            	  1885:     moveq   #32,D0
02:00040A52 41EC03BC        	  1886:     lea     ($03BC,A4),A0
02:00040A56 11802000        	  1887:     move.b  D0,(A0,D2.W)
02:00040A5A 5302            	  1888:     subq.b  #1,D2
