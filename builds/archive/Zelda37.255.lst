                            	 12900: _anon_z04_165:
02:0003F09C 1003            	 12901:     move.b  D3,D0
02:0003F09E 1B00            	 12902:     move.b  D0,-(A5)  ; PHA
                            	 12903:     ; Get the length, to append to the dynamic transfer buf.
                            	 12904:     ;
02:0003F0A0 7400            	 12905:     moveq   #0,D2
02:0003F0A2 142C0301        	 12906:     move.b  ($0301,A4),D2
                            	 12907:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 12908:     ;
02:0003F0A6 7600            	 12909:     moveq   #0,D3
                            	 12910:     even
                            	 12911: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003F0A8 41F90003F080    	 12912:     lea     (GanonColorTransferRecord).l,A0
02:0003F0AE 10303000        	 12913:     move.b  (A0,D3.W),D0
02:0003F0B2 41EC0302        	 12914:     lea     ($0302,A4),A0
02:0003F0B6 11802000        	 12915:     move.b  D0,(A0,D2.W)
02:0003F0BA 5202            	 12916:     addq.b  #1,D2
02:0003F0BC 5203            	 12917:     addq.b  #1,D3
02:0003F0BE 0C030008        	 12918:     cmpi.b  #$08,D3
02:0003F0C2 66E4            	 12919:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003F0C4 19420301        	 12920:     move.b  D2,($0301,A4)
02:0003F0C8 101D            	 12921:     move.b  (A5)+,D0  ; PLA
02:0003F0CA 7600            	 12922:     moveq   #0,D3
02:0003F0CC 1600            	 12923:     move.b  D0,D3
                            	 12924:     ; Overwrite the last 3 colors in the record, with the ones
                            	 12925:     ; ending at the index passed in.
                            	 12926:     ;
02:0003F0CE 7402            	 12927:     moveq   #2,D2
