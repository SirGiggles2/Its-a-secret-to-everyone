02:0004198C 41F900041958    	  4027:     lea     (DoorwayBoundsMinOver).l,A0
02:00041992 12303000        	  4028:     move.b  (A0,D3.W),D1
02:00041996 B001            	  4029:     cmp.b   D1,D0
02:00041998 6510            	  4030:     bcs  _anon_z05_95
02:0004199A 41F90004195C    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:000419A0 12303000        	  4032:     move.b  (A0,D3.W),D1
02:000419A4 B001            	  4033:     cmp.b   D1,D0
02:000419A6 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
