02:0004ACEC 142C0340        	  3272:     move.b  ($0340,A4),D2
02:0004ACF0 41EC0405        	  3273:     lea     ($0405,A4),A0
02:0004ACF4 10302000        	  3274:     move.b  (A0,D2.W),D0
02:0004ACF8 662E            	  3275:     bne  _L_z07_BeginUpdateWorld_NextObject
02:0004ACFA 41EC04BF        	  3276:     lea     ($04BF,A4),A0
02:0004ACFE 10302000        	  3277:     move.b  (A0,D2.W),D0
02:0004AD02 02000001        	  3278:     andi.b #$01,D0
02:0004AD06 6620            	  3279:     bne  _L_z07_BeginUpdateWorld_NextObject
                            	  3280:     ; If no attribute 1, then it indicates not to skip drawing. So, animate and draw.
