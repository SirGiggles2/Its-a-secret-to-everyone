02:00039D8A 41EC0098        	  1444:     lea     ($0098,A4),A0
02:00039D8E 10302000        	  1445:     move.b  (A0,D2.W),D0
02:00039D92 0C000004        	  1446:     cmpi.b  #$04,D0
