                            	  7746: __far_z_07_0125:
                            	  7747:     ; So, every 8 frames:
                            	  7748:     ; 1. Increment the secret color cycle count.
                            	  7749:     ; 2. Change the water palette.
                            	  7750:     ;
                            	  7751:     ; But when the count = $B, go reveal the stairs.
                            	  7752:     ;
