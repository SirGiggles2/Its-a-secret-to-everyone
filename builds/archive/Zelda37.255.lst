                            	  6104: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6105:     ; The weapon is the sword.
                            	  6106:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6107:     ;
02:0004BFEE 023C00EE        	  6108:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BFF2 122C0657        	  6109:     move.b  ($0657,A4),D1
02:0004BFF6 D101            	  6110:     addx.b  D1,D0   ; ADC Items
02:0004BFF8 003C0011        	  6111:     ori     #$11,CCR  ; SEC: set C+X
02:0004BFFC 123C0001        	  6112:     move.b  #$01,D1
02:0004C000 0A3C0010        	  6113:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C004 9101            	  6114:     subx.b  D1,D0   ; SBC #$01
02:0004C006 0A3C0010        	  6115:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6116:     even
