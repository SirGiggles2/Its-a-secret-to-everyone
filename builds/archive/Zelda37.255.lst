02:0004B85A 102C0015        	  5044:     move.b  ($0015,A4),D0
02:0004B85E 02000003        	  5045:     andi.b #$03,D0
02:0004B862 41F90004B6C0    	  5046:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004B868 12303000        	  5047:     move.b  (A0,D3.W),D1
02:0004B86C 8001            	  5048:     or.b  D1,D0
02:0004B86E 4EB9000316E0    	  5049:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5050:     ; Add the object's X (the center of the spread) and the
                            	  5051:     ; current offset in [02] to set sprite X in [00].
                            	  5052:     ;
02:0004B874 10342070        	  5053:     move.b  ($70,A4,D2.W),D0
02:0004B878 023C00EE        	  5054:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B87C 122C0002        	  5055:     move.b  ($0002,A4),D1
02:0004B880 D101            	  5056:     addx.b  D1,D0   ; ADC $02
02:0004B882 1880            	  5057:     move.b  D0,($0000,A4)
