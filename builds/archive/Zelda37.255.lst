                            	   727: ;------------------------------------------------------------------------------
                            	   728: ; _c_move_object_shim — MoveObject trampoline.
                            	   729: ;
                            	   730: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   731: ;   Input:     D2 = slot (0..11)
                            	   732: ;   Preserves: D2, A4, A5
                            	   733: ;   Clobbers:  D0, D1, D3, A0
                            	   734: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   735: ;
                            	   736: ; GCC side:
                            	   737: ;   void c_move_object(unsigned short slot);
                            	   738: ;     slot arrives as a 16-bit value on the stack.
                            	   739: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   740: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   741: ;   never clobbered by gcc.
                            	   742: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   743: ;   semantics can exist in a pure C port).
                            	   744: ;------------------------------------------------------------------------------
                            	   745: _c_move_object_shim:
                            	   746:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   747:     move.b  #$AA,($0900,A4)
                            	   748:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   749:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   750:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   751:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   752:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   753:     moveq   #0,D0
02:0002B658 3002            	   754:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   755:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   756:     jsr     c_move_object
02:0002B662 588F            	   757:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   758:     rts
                            	   759: 
                            	   760: ;==============================================================================
                            	   761: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   762: ; and tail-call the native asm function.
                            	   763: ;
                            	   764: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   765: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   766: ; sign-extended).
                            	   767: ;==============================================================================
                            	   768: 
                            	   769: ;------------------------------------------------------------------------------
                            	   770: ; void c_copy_bank_to_window(unsigned int bank);
                            	   771: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   772: ;------------------------------------------------------------------------------
                            	   773: c_copy_bank_to_window:
02:0002B666 202F0004        	   774:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   775:     jmp     _copy_bank_to_window
                            	   776: 
                            	   777: ;------------------------------------------------------------------------------
                            	   778: ; unsigned char c_ppu_read_2(void);
                            	   779: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   780: ; C return: gcc expects result in D0.
                            	   781: ;------------------------------------------------------------------------------
                            	   782: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   783:     jmp     _ppu_read_2
                            	   784: 
                            	   785: ;------------------------------------------------------------------------------
                            	   786: ; void c_ppu_write_6(unsigned int val);
                            	   787: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   788: ;------------------------------------------------------------------------------
                            	   789: c_ppu_write_6:
02:0002B674 202F0004        	   790:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   791:     jmp     _ppu_write_6
                            	   792: 
                            	   793: ;------------------------------------------------------------------------------
                            	   794: ; void c_ppu_write_7(unsigned int val);
                            	   795: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   796: ;------------------------------------------------------------------------------
                            	   797: c_ppu_write_7:
02:0002B67E 202F0004        	   798:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   799:     jmp     _ppu_write_7
                            	   800: 
                            	   801: ;------------------------------------------------------------------------------
                            	   802: ; void c_turn_off_all_video(void);
                            	   803: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   804: ;------------------------------------------------------------------------------
                            	   805: c_turn_off_all_video:
02:0002B688 4EF90004A17A    	   806:     jmp     TurnOffAllVideo
