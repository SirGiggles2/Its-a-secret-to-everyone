02:0003F6F0 19430005        	 13883:     move.b  D3,($0005,A4)
                            	 13884:     ; First, rotate the X coordinate.
                            	 13885:     ;
                            	 13886:     ; Look up the sine for the current angle, and store it in [00].
                            	 13887:     ;
02:0003F6F4 41EC0394        	 13888:     lea     ($0394,A4),A0
02:0003F6F8 10302000        	 13889:     move.b  (A0,D2.W),D0
02:0003F6FC 0200000F        	 13890:     andi.b #$0F,D0
02:0003F700 7600            	 13891:     moveq   #0,D3
02:0003F702 1600            	 13892:     move.b  D0,D3
02:0003F704 41F90003F6DC    	 13893:     lea     (PatraSines).l,A0
02:0003F70A 10303000        	 13894:     move.b  (A0,D3.W),D0
02:0003F70E 1880            	 13895:     move.b  D0,($0000,A4)
                            	 13896:     ; Mutliply q-speed by [00].
                            	 13897:     ;
                            	 13898:     ; Q-speed has the default value $20 set when entering the room.
                            	 13899:     ;
02:0003F710 41EC03BC        	 13900:     lea     ($03BC,A4),A0
02:0003F714 10302000        	 13901:     move.b  (A0,D2.W),D0
02:0003F718 7600            	 13902:     moveq   #0,D3
02:0003F71A 162C0005        	 13903:     move.b  ($0005,A4),D3
02:0003F71E 61000136        	 13904:     jsr     ShiftMultiply
                            	 13905:     ; The absolute X increment for the current angle is now in [02:03].
                            	 13906:     ;
                            	 13907:     ; If angle >= $10, then the monster is in the top half of circle going left.
                            	 13908:     ;
02:0003F722 41EC0394        	 13909:     lea     ($0394,A4),A0
02:0003F726 10302000        	 13910:     move.b  (A0,D2.W),D0
02:0003F72A 02000018        	 13911:     andi.b #$18,D0
02:0003F72E 0C000010        	 13912:     cmpi.b  #$10,D0
02:0003F732 6536            	 13913:     bcs  _L_z04_RotateObjectLocation_AddToX
