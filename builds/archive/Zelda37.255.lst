02:00044544 7600            	  7964:     moveq   #0,D3
02:00044546 162C0010        	  7965:     move.b  ($0010,A4),D3
02:0004454A 6700008C        	  7966:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7967:     ; In UW. There are two input directions, and they're both walkable.
                            	  7968:     ;
                            	  7969:     ; Normally, turn to the direction that's perpendicular to object
                            	  7970:     ; direction. But keep going straight after that, while diagonal
                            	  7971:     ; input is held.
                            	  7972:     ;
                            	  7973:     ; Handle special cases for doors.
                            	  7974:     ;
                            	  7975:     ;
                            	  7976:     ; 1. Link at horizontal doors.
                            	  7977:     ;
                            	  7978:     ; If Link's X = $20 or $D0 then
                            	  7979:     ;   If Link's Y = $85 and facing down then
                            	  7980:     ;     Go set object direction and input direction to object
                            	  7981:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7982:     ;     Link_GoStraightWhenDiagInput.
                            	  7983:     ;   Else
                            	  7984:     ;     Go turn to the perpendicular direction
                            	  7985:     ;
02:0004454E 7600            	  7986:     moveq   #0,D3
02:00044550 162C0070        	  7987:     move.b  ($0070,A4),D3
02:00044554 0C030020        	  7988:     cmpi.b  #$20,D3
02:00044558 6706            	  7989:     beq  _anon_z05_175
