02:0003B216 7600            	  4477:     moveq   #0,D3
02:0003B218 162C00EB        	  4478:     move.b  ($00EB,A4),D3
02:0003B21C 0C030055        	  4479:     cmpi.b  #$55,D3
02:0003B220 6702            	  4480:     beq  _anon_z04_57
02:0003B222 7060            	  4481:     moveq   #96,D0
                            	  4482: _anon_z04_57:
                            	  4483:     ; If the player is not aligned with the dock, return.
                            	  4484:     ;
