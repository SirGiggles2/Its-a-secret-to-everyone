02:0003A306 1234203D        	  2286:     move.b  ($3D,A4,D2.W),D1
02:0003A30A 8001            	  2287:     or.b  D1,D0
02:0003A30C 6610            	  2288:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2289:     ; Shoot.
                            	  2290:     ;
