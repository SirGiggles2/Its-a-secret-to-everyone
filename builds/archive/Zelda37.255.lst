                            	  3294: _L_z07_BeginUpdateWorld_NextObject:
                            	  3295:     ; Bottom of the object update loop.
                            	  3296:     ;
02:0004AD28 532C0340        	  3297:     subq.b  #1,($0340,A4)
02:0004AD2C 669C            	  3298:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3299:     ; Set the current object slot to what it should be when we
                            	  3300:     ; begin updating objects again next frame: $B
                            	  3301:     ; the last object slot for monsters and tile objects
