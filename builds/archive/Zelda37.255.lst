                            	   753: _L_z01_CopyCommonCodeToRam_Loop:
02:0002E9EE 1214            	   754:     move.b  ($00,A4),D1   ; ptr lo
02:0002E9F0 182C0001        	   755:     move.b  ($01,A4),D4  ; ptr hi
02:0002E9F4 024100FF        	   756:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E9F8 E14C            	   757:     lsl.w   #8,D4
02:0002E9FA 8841            	   758:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E9FC 48C4            	   759:     ext.l   D4
02:0002E9FE D8BC00FF0000    	   760:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002EA04 2044            	   761:     movea.l D4,A0
02:0002EA06 10303000        	   762:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EA0A 122C0002        	   763:     move.b  ($02,A4),D1   ; ptr lo
02:0002EA0E 182C0003        	   764:     move.b  ($03,A4),D4  ; ptr hi
02:0002EA12 024100FF        	   765:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EA16 E14C            	   766:     lsl.w   #8,D4
02:0002EA18 8841            	   767:     or.w    D1,D4
02:0002EA1A 48C4            	   768:     ext.l   D4
02:0002EA1C D8BC00FF0000    	   769:     add.l   #NES_RAM,D4
02:0002EA22 2044            	   770:     movea.l D4,A0
02:0002EA24 11803000        	   771:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   772:     ; Increment source address.
                            	   773:     ;
02:0002EA28 1014            	   774:     move.b  ($0000,A4),D0
02:0002EA2A 023C00EE        	   775:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EA2E 123C0001        	   776:     move.b  #$01,D1
02:0002EA32 D101            	   777:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EA34 1880            	   778:     move.b  D0,($0000,A4)
02:0002EA36 102C0001        	   779:     move.b  ($0001,A4),D0
02:0002EA3A 123C0000        	   780:     move.b  #$00,D1
02:0002EA3E D101            	   781:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EA40 19400001        	   782:     move.b  D0,($0001,A4)
                            	   783:     ; Increment destination address.
