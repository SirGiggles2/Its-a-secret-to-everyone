                            	  2987:     even
                            	  2988: _CalcDiagonalSpeedIndex:
02:0003093C 1883            	  2989:     move.b  D3,($0000,A4)
                            	  2990:     ; Assuming horizontal distance >= vertical distance, the
                            	  2991:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  2992:     ;
02:0003093E 103C00FF        	  2993:     move.b  #$FF,D0
02:00030942 19400001        	  2994:     move.b  D0,($0001,A4)
                            	  2995:     ; TODO:
                            	  2996:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  2997:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  2998:     ;
                            	  2999:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  3000:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  3001:     ; of the farther distance faster.
                            	  3002:     ;
02:00030946 102C0003        	  3003:     move.b  ($0003,A4),D0
02:0003094A 122C0004        	  3004:     move.b  ($0004,A4),D1
02:0003094E B001            	  3005:     cmp.b   D1,D0
02:00030950 6416            	  3006:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030952 1B00            	  3007:     move.b  D0,-(A5)  ; PHA
02:00030954 102C0004        	  3008:     move.b  ($0004,A4),D0
02:00030958 19400003        	  3009:     move.b  D0,($0003,A4)
02:0003095C 101D            	  3010:     move.b  (A5)+,D0  ; PLA
02:0003095E 19400004        	  3011:     move.b  D0,($0004,A4)
02:00030962 7001            	  3012:     moveq   #1,D0
02:00030964 19400001        	  3013:     move.b  D0,($0001,A4)
