                            	  8180: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8181:     ; Timer:
                            	  8182:     ;   >= $10: Turn if needed and move every other frame
                            	  8183:     ;   > 1:    Do nothing
                            	  8184:     ;   = 1:    Choose a place to teleport to.
                            	  8185:     ;
