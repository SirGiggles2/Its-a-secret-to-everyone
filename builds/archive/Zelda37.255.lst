                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003D852 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003D856 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003D85A 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D85E 123C0080        	  9612:     move.b  #$80,D1
02:0003D862 D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003D864 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003D868 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003D86C 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
02:0003D870 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003D874 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003D878 7001            	  9625:     moveq   #1,D0
02:0003D87A 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003D87E 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003D882 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003D886 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003D88A C200            	  9632:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D88C 6704            	  9633:     beq  _anon_z04_118
02:0003D88E 52342070        	  9634:     addq.b  #1,($70,A4,D2.W)
                            	  9635: _anon_z04_118:
                            	  9636:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9637:     ;
02:0003D892 122C0002        	  9638:     move.b  ($0002,A4),D1
02:0003D896 E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003D898 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003D89C 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003D8A0 C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D8A2 6704            	  9643:     beq  _anon_z04_119
02:0003D8A4 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
                            	  9646:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9647:     ;
02:0003D8A8 122C0002        	  9648:     move.b  ($0002,A4),D1
02:0003D8AC E309            	  9649:     lsl.b  #1,D1   ; ASL $02
02:0003D8AE 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003D8B2 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003D8B6 C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D8B8 6708            	  9653:     beq  _anon_z04_120
02:0003D8BA 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003D8BE 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
                            	  9657:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9658:     ;
02:0003D8C2 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003D8C6 E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003D8C8 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003D8CC 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003D8D0 C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D8D2 6708            	  9664:     beq  _anon_z04_121
02:0003D8D4 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003D8D8 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003D8DC 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003D8E0 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003D8E4 0C000020        	  9672:     cmpi.b  #$20,D0
02:0003D8E8 662C            	  9673:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9674:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9675:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9676:     ;
02:0003D8EA 7000            	  9677:     moveq   #0,D0
02:0003D8EC 41EC0412        	  9678:     lea     ($0412,A4),A0
02:0003D8F0 11802000        	  9679:     move.b  D0,(A0,D2.W)
02:0003D8F4 61001C62        	  9680:     jsr     ReverseObjDir8
02:0003D8F8 41EC045E        	  9681:     lea     ($045E,A4),A0
02:0003D8FC 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003D900 41EC045E        	  9683:     lea     ($045E,A4),A0
02:0003D904 52302000        	  9684:     addq.b  #1,(A0,D2.W)
                            	  9685:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9686:     ; should randomly change direction.
                            	  9687:     ;
02:0003D908 E208            	  9688:     lsr.b  #1,D0   ; LSR A
02:0003D90A 640A            	  9689:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003D90C 7000            	  9690:     moveq   #0,D0
02:0003D90E 41EC0451        	  9691:     lea     ($0451,A4),A0
