02:0003140E 162C0341        	  4388:     move.b  ($0341,A4),D3
02:00031412 41F9000313B6    	  4389:     lea     (SpriteOffsets).l,A0
02:00031418 10303000        	  4390:     move.b  (A0,D3.W),D0
02:0003141C 19400343        	  4391:     move.b  D0,($0343,A4)
02:00031420 41F9000313B7    	  4392:     lea     (SpriteOffsets+1).l,A0
02:00031426 10303000        	  4393:     move.b  (A0,D3.W),D0
