                            	  7291: Dodongo_Draw:
02:0003C6F0 610000F4        	  7292:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7293:     ; Make a 5-way direction index out of the facing direction
                            	  7294:     ; by shifting right once, and store it in [00].
                            	  7295:     ;
02:0003C6F4 41EC0098        	  7296:     lea     ($0098,A4),A0
02:0003C6F8 10302000        	  7297:     move.b  (A0,D2.W),D0
02:0003C6FC E208            	  7298:     lsr.b  #1,D0   ; LSR A
02:0003C6FE 1880            	  7299:     move.b  D0,($0000,A4)
                            	  7300:     ; If state = 0, go handle animating the two frames of this state.
                            	  7301:     ;
02:0003C700 7600            	  7302:     moveq   #0,D3
02:0003C702 41EC00AC        	  7303:     lea     ($00AC,A4),A0
02:0003C706 16302000        	  7304:     move.b  (A0,D2.W),D3
02:0003C70A 6744            	  7305:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7306:     ; If state > 1, then the monster is stunned (state 2).
                            	  7307:     ; So, go switch frames every $20 screen frames.
                            	  7308:     ;
02:0003C70C 7020            	  7309:     moveq   #32,D0
02:0003C70E 5303            	  7310:     subq.b  #1,D3
02:0003C710 6640            	  7311:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7312:     ; State = 1. Bloated.
                            	  7313:     ;
                            	  7314:     ; In substate 0, go animate as usual for walking.
                            	  7315:     ;
02:0003C712 7600            	  7316:     moveq   #0,D3
02:0003C714 41EC042C        	  7317:     lea     ($042C,A4),A0
02:0003C718 16302000        	  7318:     move.b  (A0,D2.W),D3
02:0003C71C 6732            	  7319:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7320:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7321:     ; go fade the boss; so that some frames are not drawn.
                            	  7322:     ;
02:0003C71E 0C030002        	  7323:     cmpi.b  #$02,D3
02:0003C722 6718            	  7324:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003C724 0C030003        	  7325:     cmpi.b  #$03,D3
02:0003C728 6712            	  7326:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7327:     ; State 1, substate 1
