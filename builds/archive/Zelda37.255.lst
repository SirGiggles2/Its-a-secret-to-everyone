                            	  1670: AnimateDemoPhase0Subphase1:
02:000340EE 102C0438        	  1671:     move.b  ($0438,A4),D0
02:000340F2 666C            	  1672:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:000340F4 7000            	  1676:     moveq   #0,D0
02:000340F6 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:000340FA EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:000340FC 41F900033EDE    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00034102 D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:00034104 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
02:0003410A 197C00000303    	  1683:     move.b  #$00,($0303,A4)
02:00034110 7020            	  1684:     moveq   #32,D0
02:00034112 19400304        	  1685:     move.b  D0,($0304,A4)
                            	  1686:     ; End marker at DynTileBuf+4+31
02:00034116 761F            	  1687:     moveq   #31,D3
02:00034118 103C00FF        	  1688:     move.b  #$FF,D0
02:0003411C 43EC0306        	  1689:     lea     ($0306,A4),A1
02:00034120 13803000        	  1690:     move.b  D0,(A1,D3.W)
                            	  1691:     even
