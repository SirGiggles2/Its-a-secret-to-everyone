                            	  2221: _L_z04__TryShooting_TryShootingNow:
                            	  2222:     ; Summary
                            	  2223:     ;
                            	  2224:     ; if temporarily invincible then
                            	  2225:     ;   shoot timer := 0
                            	  2226:     ; elif shoot timer > 0 then
                            	  2227:     ;   decrement shoot timer
                            	  2228:     ; elif wants to shoot then
                            	  2229:     ;   shoot timer := $30
                            	  2230:     ;
                            	  2231:     ; qspeed := [01]
                            	  2232:     ;
                            	  2233:     ; if shoot timer <> 0 then
                            	  2234:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2235:     ;     shoot
                            	  2236:     ;     if succeeded then
                            	  2237:     ;       shoot timer := 0
                            	  2238:     ;       qspeed := 0
                            	  2239:     ;   else
                            	  2240:     ;     qspeed := 0
                            	  2241:     ;
                            	  2242:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A2C2 102C0001        	  2243:     move.b  ($0001,A4),D0
02:0003A2C6 1883            	  2244:     move.b  D3,($0000,A4)
02:0003A2C8 1B00            	  2245:     move.b  D0,-(A5)  ; PHA
02:0003A2CA 7600            	  2246:     moveq   #0,D3
                            	  2247:     ; If not temporarily invincible,
                            	  2248:     ;
02:0003A2CC 41EC04F0        	  2249:     lea     ($04F0,A4),A0
02:0003A2D0 10302000        	  2250:     move.b  (A0,D2.W),D0
02:0003A2D4 661A            	  2251:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2252:     ; then Y := shoot timer - 1
                            	  2253:     ;
02:0003A2D6 7600            	  2254:     moveq   #0,D3
02:0003A2D8 41EC0451        	  2255:     lea     ($0451,A4),A0
02:0003A2DC 16302000        	  2256:     move.b  (A0,D2.W),D3
02:0003A2E0 5303            	  2257:     subq.b  #1,D3
                            	  2258:     ; If Y register < 0, then shoot timer is 0.
                            	  2259:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2260:     ; Else go set a non-zero speed and return.
                            	  2261:     ;
02:0003A2E2 6A0C            	  2262:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A2E4 41EC0412        	  2263:     lea     ($0412,A4),A0
02:0003A2E8 10302000        	  2264:     move.b  (A0,D2.W),D0
02:0003A2EC 6736            	  2265:     beq  _L_z04__TryShooting_SetSpeed
02:0003A2EE 7630            	  2266:     moveq   #48,D3
                            	  2267:     even
                            	  2268: _L_z04__TryShooting_SetShootTimer:
