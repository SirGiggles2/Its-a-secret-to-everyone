02:00045308 2044            	  8737:     movea.l D4,A0
02:0004530A 10303000        	  8738:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004530E 02000020        	  8739:     andi.b #$20,D0
                            	  8740:     ; If it's been visited, then check each of the 4 doors,
                            	  8741:     ; and build an open door mask.
