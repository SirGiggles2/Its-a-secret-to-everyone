02:000320D8 0200000C        	  6485:     andi.b #$0C,D0
02:000320DC 0C00000C        	  6486:     cmpi.b  #$0C,D0
02:000320E0 671A            	  6487:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
