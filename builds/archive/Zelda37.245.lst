02:00043A8A 10302000        	  6026:     move.b  (A0,D2.W),D0
02:00043A8E 19400001        	  6027:     move.b  D0,($0001,A4)
                            	  6028:     ; Return the direction of the door in [09], and the dynamic
                            	  6029:     ; transfer buf length in X register.
                            	  6030:     ;
02:00043A92 19420009        	  6031:     move.b  D2,($0009,A4)
02:00043A96 7400            	  6032:     moveq   #0,D2
02:00043A98 142C0301        	  6033:     move.b  ($0301,A4),D2
                            	  6034:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6035:     ;
