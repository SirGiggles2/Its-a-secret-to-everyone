02:0004453A B001            	  7159:     cmp.b   D1,D0
02:0004453C 6704            	  7160:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:0004453E 5302            	  7161:     subq.b  #1,D2
02:00044540 66EE            	  7162:     bne  _anon_z05_149
                            	  7163:     even
