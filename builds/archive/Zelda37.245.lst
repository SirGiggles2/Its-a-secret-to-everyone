                            	  9018:     ;
02:000454E0 102C0015        	  9019:     move.b  ($0015,A4),D0
02:000454E4 02000008        	  9020:     andi.b #$08,D0
02:000454E8 E208            	  9021:     lsr.b  #1,D0   ; LSR A
02:000454EA E208            	  9022:     lsr.b  #1,D0   ; LSR A
02:000454EC E208            	  9023:     lsr.b  #1,D0   ; LSR A
02:000454EE 123C0001        	  9024:     move.b  #$01,D1
02:000454F2 D101            	  9025:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:000454F4 1940021E        	  9026:     move.b  D0,($021E,A4)
                            	  9027:     ; Flip the right sprite horizontally.
                            	  9028:     ;
