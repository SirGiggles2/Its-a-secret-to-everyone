02:0003CAC0 7600            	  6776:     moveq   #0,D3
02:0003CAC2 162C000B        	  6777:     move.b  ($000B,A4),D3
                            	  6778:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6779:     ; Store it in [00].
                            	  6780:     ;
02:0003CAC6 10342070        	  6781:     move.b  ($70,A4,D2.W),D0
02:0003CACA 023C00EE        	  6782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CACE 41F90003CAA2    	  6783:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003CAD4 12303000        	  6784:     move.b  (A0,D3.W),D1
02:0003CAD8 D101            	  6785:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003CADA 1880            	  6786:     move.b  D0,($0000,A4)
                            	  6787:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6788:     ; Store it in [01].
                            	  6789:     ;
02:0003CADC 41EC0084        	  6790:     lea     ($0084,A4),A0
02:0003CAE0 10302000        	  6791:     move.b  (A0,D2.W),D0
02:0003CAE4 023C00EE        	  6792:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAE8 41F90003CA9C    	  6793:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003CAEE 12303000        	  6794:     move.b  (A0,D3.W),D1
02:0003CAF2 D101            	  6795:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003CAF4 19400001        	  6796:     move.b  D0,($0001,A4)
                            	  6797:     ; Calculate sprite attributes:
                            	  6798:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6799:     ;
                            	  6800:     ; If the boss is temporarily invincible, then
                            	  6801:     ; this makes it flash by cycling all the palette rows.
                            	  6802:     ;
                            	  6803:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6804:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6805:     ;
02:0003CAF8 41EC04F0        	  6806:     lea     ($04F0,A4),A0
02:0003CAFC 10302000        	  6807:     move.b  (A0,D2.W),D0
02:0003CB00 02000003        	  6808:     andi.b #$03,D0
02:0003CB04 0A000003        	  6809:     eori.b #$03,D0
02:0003CB08 19400003        	  6810:     move.b  D0,($0003,A4)
02:0003CB0C 7600            	  6811:     moveq   #0,D3
02:0003CB0E 162C000A        	  6812:     move.b  ($000A,A4),D3
                            	  6813:     ; Look up the tile for this sprite.
                            	  6814:     ; If it's not the first one (face), then go write the sprite record.
                            	  6815:     ;
02:0003CB12 41F90003CA90    	  6816:     lea     (AquamentusTiles).l,A0
02:0003CB18 10303000        	  6817:     move.b  (A0,D3.W),D0
02:0003CB1C 12390003CA90    	  6818:     move.b  (AquamentusTiles).l,D1
02:0003CB22 B001            	  6819:     cmp.b   D1,D0
02:0003CB24 6610            	  6820:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6821:     ; Else it's the first one (the face tile).
                            	  6822:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6823:     ;
                            	  6824:     ; $CC/CD shows the closed mouth face.
                            	  6825:     ; $C0/C1 shows the open mouth face.
                            	  6826:     ;
02:0003CB26 7600            	  6827:     moveq   #0,D3
02:0003CB28 16342028        	  6828:     move.b  ($28,A4,D2.W),D3
02:0003CB2C 0C030020        	  6829:     cmpi.b  #$20,D3
02:0003CB30 6404            	  6830:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003CB32 103C00C0        	  6831:     move.b  #$C0,D0
