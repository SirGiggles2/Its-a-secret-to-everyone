02:00043A9E 19400007        	  6037:     move.b  D0,($0007,A4)
02:00043AA2 7002            	  6038:     moveq   #2,D0
02:00043AA4 19400006        	  6039:     move.b  D0,($0006,A4)
02:00043AA8 19400005        	  6040:     move.b  D0,($0005,A4)
