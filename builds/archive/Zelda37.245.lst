02:00039F86 7003            	   744:     moveq   #3,D0
02:00039F88 41EC03D0        	   745:     lea     ($03D0,A4),A0
02:00039F8C 11803000        	   746:     move.b  D0,(A0,D3.W)
                            	   747:     ; Have the monster wait a random amount of time, up to $3F frames.
