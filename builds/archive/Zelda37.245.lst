                            	  2297: _TryShooting:
02:0003AA82 19400001        	  2298:     move.b  D0,($0001,A4)
                            	  2299:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2300:     ;
02:0003AA86 41EC034F        	  2301:     lea     ($034F,A4),A0
02:0003AA8A 10302000        	  2302:     move.b  (A0,D2.W),D0
02:0003AA8E 0C000003        	  2303:     cmpi.b  #$03,D0
02:0003AA92 6726            	  2304:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA94 0C000001        	  2305:     cmpi.b  #$01,D0
02:0003AA98 6720            	  2306:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA9A 0C000009        	  2307:     cmpi.b  #$09,D0
02:0003AA9E 671A            	  2308:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AAA0 0C00000A        	  2309:     cmpi.b  #$0A,D0
02:0003AAA4 6714            	  2310:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AAA6 41EC0451        	  2311:     lea     ($0451,A4),A0
02:0003AAAA 10302000        	  2312:     move.b  (A0,D2.W),D0
02:0003AAAE 660A            	  2313:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2314:     ; and a random value < $F8, then return.
                            	  2315:     ;
02:0003AAB0 10342018        	  2316:     move.b  ($18,A4,D2.W),D0
02:0003AAB4 0C0000F8        	  2317:     cmpi.b  #$F8,D0
