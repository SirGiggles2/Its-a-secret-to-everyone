02:00032196 19400051        	  6593:     move.b  D0,($0051,A4)
                            	  6594:     ; If heart partial >= low damage points byte, then simply
                            	  6595:     ; subtract the damage byte from heart partial.
                            	  6596:     ; Else go borrow from full hearts.
