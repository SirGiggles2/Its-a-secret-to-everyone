02:0003D33E 023C00EE        	  7955:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D342 123C0008        	  7956:     move.b  #$08,D1
02:0003D346 D101            	  7957:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
