                            	 12563:     ; Ganon is now a pile of ashes at offset (7, 8) from where he was.
                            	 12564:     ;
02:0003F54C 10342070        	 12565:     move.b  ($70,A4,D2.W),D0
02:0003F550 123C0007        	 12566:     move.b  #$07,D1
02:0003F554 D101            	 12567:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003F556 19802070        	 12568:     move.b  D0,($70,A4,D2.W)
02:0003F55A 41EC0084        	 12569:     lea     ($0084,A4),A0
02:0003F55E 10302000        	 12570:     move.b  (A0,D2.W),D0
02:0003F562 123C0008        	 12571:     move.b  #$08,D1
02:0003F566 D101            	 12572:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F568 41EC0084        	 12573:     lea     ($0084,A4),A0
02:0003F56C 11802000        	 12574:     move.b  D0,(A0,D2.W)
02:0003F570 615C            	 12575:     jsr     Ganon_SetUpBurstRays
02:0003F572 610003DA        	 12576:     jsr     PlayBossDeathCry
02:0003F576 7002            	 12577:     moveq   #2,D0
02:0003F578 19400600        	 12578:     move.b  D0,($0600,A4)
