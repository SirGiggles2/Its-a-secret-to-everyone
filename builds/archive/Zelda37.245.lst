                            	  7220: Dodongo_TryEatBomb:
                            	  7221:     ; Try to eat the bomb.
                            	  7222:     ;
                            	  7223:     ; If the bomb is not in range of the monster, then return.
                            	  7224:     ;
                            	  7225:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7226:     ;
02:0003CE12 7601            	  7227:     moveq   #1,D3
02:0003CE14 616E            	  7228:     jsr     Dodongo_IsBombInRange
02:0003CE16 6666            	  7229:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7230:     ; Will loop from 1 to 0, indexed by [00].
                            	  7231:     ;
02:0003CE18 7001            	  7232:     moveq   #1,D0
02:0003CE1A 1880            	  7233:     move.b  D0,($0000,A4)
                            	  7234:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7235:     ;
02:0003CE1C 41EC0098        	  7236:     lea     ($0098,A4),A0
02:0003CE20 10302000        	  7237:     move.b  (A0,D2.W),D0
02:0003CE24 E208            	  7238:     lsr.b  #1,D0   ; LSR A
02:0003CE26 7600            	  7239:     moveq   #0,D3
02:0003CE28 1600            	  7240:     move.b  D0,D3
                            	  7241:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7242:     ; position depends on the orientation of the monster.
                            	  7243:     ;
                            	  7244:     ; Start with the horizontal distance.
                            	  7245:     ;
02:0003CE2A 102C0004        	  7246:     move.b  ($0004,A4),D0
                            	  7247:     even
                            	  7248: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7249:     ; Look up the limits for the given direction.
                            	  7250:     ;
                            	  7251:     ; If the distance from the bomb < negative limit,
                            	  7252:     ; or >= positive limit, then return.
                            	  7253:     ;
                            	  7254:     ; Note that these are simple signed comparisons that work,
                            	  7255:     ; because the operands are in a small range.
                            	  7256:     ;
02:0003CE2E 41F90003CD68    	  7257:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CE34 12303000        	  7258:     move.b  (A0,D3.W),D1
02:0003CE38 B001            	  7259:     cmp.b   D1,D0
02:0003CE3A 6B42            	  7260:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CE3C 41F90003CD6E    	  7261:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CE42 12303000        	  7262:     move.b  (A0,D3.W),D1
02:0003CE46 B001            	  7263:     cmp.b   D1,D0
02:0003CE48 6A34            	  7264:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7265:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7266:     ;
02:0003CE4A 1003            	  7267:     move.b  D3,D0
02:0003CE4C 023C00EE        	  7268:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE50 123C000A        	  7269:     move.b  #$0A,D1
02:0003CE54 D101            	  7270:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CE56 7600            	  7271:     moveq   #0,D3
02:0003CE58 1600            	  7272:     move.b  D0,D3
                            	  7273:     ; Bottom of the loop.
                            	  7274:     ;
                            	  7275:     ; Load the vertical distance for the next iteration.
                            	  7276:     ; Decrement loop counter.
                            	  7277:     ;
02:0003CE5A 102C0005        	  7278:     move.b  ($0005,A4),D0
02:0003CE5E 5314            	  7279:     subq.b  #1,($0000,A4)
02:0003CE60 6ACC            	  7280:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7281:     ; If we get here, then the bomb was within range of the mouth.
                            	  7282:     ; Go to state 1 (bloated).
                            	  7283:     ;
02:0003CE62 41EC00AC        	  7284:     lea     ($00AC,A4),A0
02:0003CE66 52302000        	  7285:     addq.b  #1,(A0,D2.W)
                            	  7286:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7287:     ;
02:0003CE6A 7610            	  7288:     moveq   #16,D3
02:0003CE6C 7000            	  7289:     moveq   #0,D0
02:0003CE6E 41EC00AC        	  7290:     lea     ($00AC,A4),A0
02:0003CE72 11803000        	  7291:     move.b  D0,(A0,D3.W)
02:0003CE76 41EC042C        	  7292:     lea     ($042C,A4),A0
02:0003CE7A 11802000        	  7293:     move.b  D0,(A0,D2.W)
                            	  7294:     even
                            	  7295: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CE7E 4E75            	  7296:     rts
                            	  7297: 
                            	  7298:     even
                            	  7299: DodongoBombPositiveLimits:
02:0003CE80 0C              	  7300:     dc.b    $0C, $11
02:0003CE81 11
                            	  7301: 
                            	  7302:     even
                            	  7303: DodongoBombNegativeLimits:
02:0003CE82 F4              	  7304:     dc.b    $F4, $F0
02:0003CE83 F0
                            	  7305: 
                            	  7306: ; Params:
                            	  7307: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7308: ; [00]: monster hotspot X
                            	  7309: ; [01]: monster hotspot Y
                            	  7310: ; [02]: bomb hotspot X
                            	  7311: ; [03]: bomb hotspot Y
                            	  7312: ;
                            	  7313: ; Returns:
                            	  7314: ; A: 0 if the bomb is in range of the monster
                            	  7315: ; Z: 1 if the bomb is in range of the monster
                            	  7316: ; [04]: horizontal distance
                            	  7317: ; [05]: vertical distance
                            	  7318: ;
                            	  7319: ; Store the positive limit in [06], and the negative one in [07].
                            	  7320: ;
                            	  7321:     even
                            	  7322: Dodongo_IsBombInRange:
02:0003CE84 41F90003CE80    	  7323:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CE8A 10303000        	  7324:     move.b  (A0,D3.W),D0
02:0003CE8E 19400006        	  7325:     move.b  D0,($0006,A4)
02:0003CE92 41F90003CE82    	  7326:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CE98 10303000        	  7327:     move.b  (A0,D3.W),D0
02:0003CE9C 19400007        	  7328:     move.b  D0,($0007,A4)
                            	  7329:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7330:     ; the bomb is near enough the monster.
                            	  7331:     ;
02:0003CEA0 7003            	  7332:     moveq   #3,D0
02:0003CEA2 19400008        	  7333:     move.b  D0,($0008,A4)
                            	  7334:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7335:     ;
02:0003CEA6 7601            	  7336:     moveq   #1,D3
                            	  7337:     even
                            	  7338: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7339:     ; Subtract the bomb's coordinate from the boss's,
                            	  7340:     ; The loop index determines the coordinate.
                            	  7341:     ;
02:0003CEA8 10343000        	  7342:     move.b  ($00,A4,D3.W),D0
02:0003CEAC 003C0011        	  7343:     ori     #$11,CCR  ; SEC: set C+X
02:0003CEB0 12343002        	  7344:     move.b  ($02,A4,D3.W),D1
02:0003CEB4 0A3C0010        	  7345:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CEB8 9101            	  7346:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CEBA 0A3C0010        	  7347:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7348:     ; If the distance >= positive offset, or < negative offset;
                            	  7349:     ; then loop again.
                            	  7350:     ;
02:0003CEBE 122C0006        	  7351:     move.b  ($0006,A4),D1
02:0003CEC2 B001            	  7352:     cmp.b   D1,D0
02:0003CEC4 6A16            	  7353:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CEC6 122C0007        	  7354:     move.b  ($0007,A4),D1
02:0003CECA B001            	  7355:     cmp.b   D1,D0
02:0003CECC 6B0E            	  7356:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7357:     ; The distance is close enough in this axis.
                            	  7358:     ;
                            	  7359:     ; Store the distance in this axis in [05] or [04],
                            	  7360:     ; depending on the loop index.
                            	  7361:     ;
02:0003CECE 19803004        	  7362:     move.b  D0,($04,A4,D3.W)
                            	  7363:     ; Shift [08] right, because we're in range in this axis.
                            	  7364:     ;
02:0003CED2 122C0008        	  7365:     move.b  ($0008,A4),D1
02:0003CED6 E209            	  7366:     lsr.b  #1,D1   ; LSR $08
02:0003CED8 19410008        	  7367:     move.b  D1,($0008,A4)
                            	  7368:     even
                            	  7369: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CEDC 5303            	  7370:     subq.b  #1,D3
02:0003CEDE 6AC8            	  7371:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7372:     ; If close enough in both axes, then [08] will be 0.
