                            	 13243:     ;
02:0003FA6A 700F            	 13244:     moveq   #15,D0
02:0003FA6C 7600            	 13245:     moveq   #0,D3
02:0003FA6E 162C0051        	 13246:     move.b  ($0051,A4),D3
