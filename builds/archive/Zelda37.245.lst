                            	 12541:     ; If it just went from $FF to 0, then keep it at $FF.
                            	 12542:     ;
02:0003F528 41EC042C        	 12543:     lea     ($042C,A4),A0
02:0003F52C 10302000        	 12544:     move.b  (A0,D2.W),D0
02:0003F530 660C            	 12545:     bne  _anon_z04_162
02:0003F532 103C00FF        	 12546:     move.b  #$FF,D0
02:0003F536 41EC042C        	 12547:     lea     ($042C,A4),A0
02:0003F53A 11802000        	 12548:     move.b  D0,(A0,D2.W)
                            	 12549: _anon_z04_162:
