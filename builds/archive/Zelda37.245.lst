02:000444BC 1B00            	  7089:     move.b  D0,-(A5)  ; PHA
                            	  7090:     ; We're dealing with squares.
                            	  7091:     ; So, align the object's X coordinate with 16 pixels.
                            	  7092:     ;
02:000444BE 10342070        	  7093:     move.b  ($70,A4,D2.W),D0
02:000444C2 020000F0        	  7094:     andi.b #$F0,D0
                            	  7095:     ; Divide it by 4 to get the offset of the address of the column
                            	  7096:     ; in play area map.
                            	  7097:     ;
                            	  7098:     ; The calculation is: address offset = (X / 8) * 2
                            	  7099:     ; 8 for the width of the column; 2 for the width of the address
                            	  7100:     ;
02:000444C6 E208            	  7101:     lsr.b  #1,D0   ; LSR A
02:000444C8 E208            	  7102:     lsr.b  #1,D0   ; LSR A
