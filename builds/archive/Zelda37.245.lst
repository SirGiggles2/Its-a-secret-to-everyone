02:0003212A 522C000C        	  6538:     addq.b  #1,($000C,A4)
                            	  6539:     ; Unpack the damage points for the monster's type.
                            	  6540:     ; The low nibble is the high byte.
                            	  6541:     ; (Damage points byte AND $F0) is the low byte.
                            	  6542:     ;
02:0003212E 7600            	  6543:     moveq   #0,D3
02:00032130 41EC034F        	  6544:     lea     ($034F,A4),A0
02:00032134 16302000        	  6545:     move.b  (A0,D2.W),D3
02:00032138 41F900031F9A    	  6546:     lea     (ObjTypeToDamagePoints).l,A0
02:0003213E 10303000        	  6547:     move.b  (A0,D3.W),D0
02:00032142 1B00            	  6548:     move.b  D0,-(A5)  ; PHA
02:00032144 0200000F        	  6549:     andi.b #$0F,D0
02:00032148 1940000D        	  6550:     move.b  D0,($000D,A4)
02:0003214C 101D            	  6551:     move.b  (A5)+,D0  ; PLA
02:0003214E 020000F0        	  6552:     andi.b #$F0,D0
02:00032152 1940000E        	  6553:     move.b  D0,($000E,A4)
                            	  6554: ; Params:
                            	  6555: ; X: object index of the attacker
                            	  6556: ; [0D]: damage points high byte
                            	  6557: ; [0E]: damage points low byte
                            	  6558: ;
                            	  6559: ;
                            	  6560: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6561: ;
                            	  6562:     even
