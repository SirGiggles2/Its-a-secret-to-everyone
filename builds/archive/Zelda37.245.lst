02:0004024C 4EF90002BEB0    	   272:     jmp     c_select_transfer_buf_and_inc_state
                            	   273: 
                            	   274: _anon_z05_1:
02:00040252 522C00E1        	   275:     addq.b  #1,($00E1,A4)
02:00040256 4E75            	   276:     rts
                            	   277: 
                            	   278:     even
