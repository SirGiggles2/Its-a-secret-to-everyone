                            	  5695:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5696:     ;
                            	  5697:     ; If Link catches it some time after throwing it,
                            	  5698:     ; his state will become $20, and he will show the catch animation.
                            	  5699:     ;
                            	  5700:     ; But if he catches it right after throwing it, the state becomes
                            	  5701:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5702:     ;
