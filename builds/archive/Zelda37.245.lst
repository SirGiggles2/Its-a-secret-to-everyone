02:000321A6 003C0011        	  6602:     ori     #$11,CCR  ; SEC: set C+X
02:000321AA 122C000E        	  6603:     move.b  ($000E,A4),D1
02:000321AE 0A3C0010        	  6604:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000321B2 9101            	  6605:     subx.b  D1,D0   ; SBC $0E
02:000321B4 0A3C0010        	  6606:     eori    #$10,CCR  ; restore X = 6502 C
02:000321B8 19400670        	  6607:     move.b  D0,($0670,A4)
                            	  6608:     ; If full hearts >= high damage points byte, then simply
