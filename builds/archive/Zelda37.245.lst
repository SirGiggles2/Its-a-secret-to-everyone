                            	 12108: __far_z_04_0114:
                            	 12109:     ; State = 0.
                            	 12110:     ;
                            	 12111:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12112:     ; This is the only patra child shown in the first fame.
                            	 12113:     ;
02:0003F260 0C020002        	 12114:     cmpi.b  #$02,D2
02:0003F264 6732            	 12115:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12116:     ; The patra child in slot 2 is the last one to be updated.
                            	 12117:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12118:     ;
                            	 12119:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12120:     ; shown.
                            	 12121:     ;
02:0003F266 102C00AE        	 12122:     move.b  ($00AE,A4),D0
02:0003F26A 6700008E        	 12123:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12124:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12125:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12126:     ;
02:0003F26E 1002            	 12127:     move.b  D2,D0
                            	 12128:     ; Subtract 3 from the object slot to get the angle where the
                            	 12129:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12130:     ;
02:0003F270 003C0011        	 12131:     ori     #$11,CCR  ; SEC: set C+X
02:0003F274 123C0003        	 12132:     move.b  #$03,D1
02:0003F278 0A3C0010        	 12133:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F27C 9101            	 12134:     subx.b  D1,D0   ; SBC #$03
02:0003F27E 0A3C0010        	 12135:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F282 7600            	 12136:     moveq   #0,D3
02:0003F284 1600            	 12137:     move.b  D0,D3
                            	 12138:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12139:     ; then return.
                            	 12140:     ;
02:0003F286 102C0396        	 12141:     move.b  ($0396,A4),D0
02:0003F28A 41F90003F244    	 12142:     lea     (PatraChildStartAngles).l,A0
02:0003F290 12303000        	 12143:     move.b  (A0,D3.W),D1
02:0003F294 B001            	 12144:     cmp.b   D1,D0
02:0003F296 6662            	 12145:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12146:     even
