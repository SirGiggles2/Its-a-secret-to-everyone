02:0004054A 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004054E 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:00040550 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:00040554 194000E2        	   677:     move.b  D0,($00E2,A4)
02:00040558 6404            	   678:     bcc  _anon_z05_10
02:0004055A 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
