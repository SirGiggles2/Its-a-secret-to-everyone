                            	  4885:     ;
                            	  4886:     ; Call this only to get reverse direction index.
02:0004BFA4 4EB900030FDA    	  4887:     jsr     GetOppositeDir
02:0004BFAA 102C0015        	  4888:     move.b  ($0015,A4),D0
02:0004BFAE 02000003        	  4889:     andi.b #$03,D0
02:0004BFB2 41F90004C26E    	  4890:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004BFB8 12303000        	  4891:     move.b  (A0,D3.W),D1
02:0004BFBC 8001            	  4892:     or.b  D1,D0
02:0004BFBE 4EB900031E24    	  4893:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4894:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4895:     ;
