02:0003F5D8 123C0004        	 12637:     move.b  #$04,D1
02:0003F5DC D101            	 12638:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F5DE 19803072        	 12639:     move.b  D0,($72,A4,D3.W)
02:0003F5E2 41EC0084        	 12640:     lea     ($0084,A4),A0
02:0003F5E6 10302000        	 12641:     move.b  (A0,D2.W),D0
02:0003F5EA 123C0004        	 12642:     move.b  #$04,D1
02:0003F5EE D101            	 12643:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F5F0 41EC0086        	 12644:     lea     ($0086,A4),A0
02:0003F5F4 11803000        	 12645:     move.b  D0,(A0,D3.W)
                            	 12646:     ; Set the direction.
                            	 12647:     ;
02:0003F5F8 41F90003F5B2    	 12648:     lea     (GanonBurstDirs).l,A0
02:0003F5FE 10303000        	 12649:     move.b  (A0,D3.W),D0
02:0003F602 41EC009A        	 12650:     lea     ($009A,A4),A0
02:0003F606 11803000        	 12651:     move.b  D0,(A0,D3.W)
02:0003F60A 5303            	 12652:     subq.b  #1,D3
02:0003F60C 6AC2            	 12653:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003F60E 4E75            	 12654:     rts
                            	 12655: 
                            	 12656: ; Params:
                            	 12657: ; [00]: X
                            	 12658: ; [01]: Y
                            	 12659: ;
