                            	  5135: DrawCredits:
                            	  5136:     ; Make a transfer record of a full row of blank tiles.
                            	  5137:     ;
02:00036C6A 761F            	  5138:     moveq   #31,D3
02:00036C6C 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
02:00036C6E 41EC0305        	  5141:     lea     ($0305,A4),A0
02:00036C72 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:00036C76 5303            	  5143:     subq.b  #1,D3
02:00036C78 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
                            	  5146:     ;
02:00036C7A 102C050A        	  5147:     move.b  ($050A,A4),D0
02:00036C7E 672C            	  5148:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5149:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5150:     ; Rows 2 to $2D get side walls.
                            	  5151:     ;
02:00036C80 0C000001        	  5152:     cmpi.b  #$01,D0
02:00036C84 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00036C86 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:00036C8A 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00036C8C 661E            	  5156:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5157:     even
                            	  5158: _L_z02_DrawCredits_WriteHorizontalWalls:
02:00036C8E 7619            	  5159:     moveq   #25,D3
02:00036C90 103C00FA        	  5160:     move.b  #$FA,D0
                            	  5161: _anon_z02_42:
02:00036C94 41EC0308        	  5162:     lea     ($0308,A4),A0
02:00036C98 11803000        	  5163:     move.b  D0,(A0,D3.W)
02:00036C9C 5303            	  5164:     subq.b  #1,D3
02:00036C9E 6AF4            	  5165:     bpl  _anon_z02_42
                            	  5166:     even
                            	  5167: _L_z02_DrawCredits_WriteSideWalls:
02:00036CA0 103C00FA        	  5168:     move.b  #$FA,D0
