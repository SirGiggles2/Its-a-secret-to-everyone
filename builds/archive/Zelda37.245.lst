                            	  4108: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  4109:     ;
                            	  4110:     ;
                            	  4111:     ; [0E] holds reverse index of doorway direction found.
                            	  4112:     ;
02:0004226E 1943000E        	  4113:     move.b  D3,($000E,A4)
                            	  4114:     ; Store input direction in [02] and [0C].
                            	  4115:     ;
