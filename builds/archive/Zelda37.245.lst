02:0004C014 60000082        	  4945:     jmp  SetShotSpreadingState
                            	  4946: __far_z_07_0075:
                            	  4947:     ; This is a magic shot.
                            	  4948:     ;
                            	  4949:     ; If missing the magic book, go deactivate the shot object.
                            	  4950:     ;
02:0004C018 102C0661        	  4951:     move.b  ($0661,A4),D0
02:0004C01C 6602            	  4952:     bne.s  __far_z_07_0076
02:0004C01E 6072            	  4953:     jmp  DeactivateShot
                            	  4954: __far_z_07_0076:
                            	  4955:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4956:     ; unused, so it only has to depend on having an empty slot.
                            	  4957:     ;
                            	  4958:     ; If successful, Link's state will have been changed to "using item".
                            	  4959:     ; But we don't want that in this case.
                            	  4960:     ;
                            	  4961:     ; For both these reasons, save state and restore it afterward.
                            	  4962:     ;
02:0004C020 102C00AC        	  4963:     move.b  ($00AC,A4),D0
02:0004C024 1B00            	  4964:     move.b  D0,-(A5)  ; PHA
02:0004C026 102C0513        	  4965:     move.b  ($0513,A4),D0
02:0004C02A 1B00            	  4966:     move.b  D0,-(A5)  ; PHA
02:0004C02C 7000            	  4967:     moveq   #0,D0
02:0004C02E 19400513        	  4968:     move.b  D0,($0513,A4)
02:0004C032 4EB900031224    	  4969:     jsr     WieldCandle
02:0004C038 101D            	  4970:     move.b  (A5)+,D0  ; PLA
02:0004C03A 19400513        	  4971:     move.b  D0,($0513,A4)
02:0004C03E 101D            	  4972:     move.b  (A5)+,D0  ; PLA
02:0004C040 194000AC        	  4973:     move.b  D0,($00AC,A4)
                            	  4974:     ; State $21 means that a moving fire was just made.
                            	  4975:     ;
                            	  4976:     ; If it's any another value, then we didn't find an empty slot
                            	  4977:     ; to make a fire. In this case, all that's left to do is to go
                            	  4978:     ; deactivate the shot object.
                            	  4979:     ;
02:0004C044 41EC00AC        	  4980:     lea     ($00AC,A4),A0
02:0004C048 10302000        	  4981:     move.b  (A0,D2.W),D0
02:0004C04C 0C000021        	  4982:     cmpi.b  #$21,D0
02:0004C050 6702            	  4983:     beq.s  __far_z_07_0077
02:0004C052 6038            	  4984:     jmp  DeactivateLinkShot
                            	  4985: __far_z_07_0077:
                            	  4986:     ; Make state $22 for a standing fire.
                            	  4987:     ;
02:0004C054 41EC00AC        	  4988:     lea     ($00AC,A4),A0
02:0004C058 52302000        	  4989:     addq.b  #1,(A0,D2.W)
                            	  4990:     ; Copy the shot's position and direction to the fire.
                            	  4991:     ;
02:0004C05C 760E            	  4992:     moveq   #14,D3
02:0004C05E 10343070        	  4993:     move.b  ($70,A4,D3.W),D0
02:0004C062 19802070        	  4994:     move.b  D0,($70,A4,D2.W)
02:0004C066 41EC0084        	  4995:     lea     ($0084,A4),A0
02:0004C06A 10303000        	  4996:     move.b  (A0,D3.W),D0
02:0004C06E 41EC0084        	  4997:     lea     ($0084,A4),A0
02:0004C072 11802000        	  4998:     move.b  D0,(A0,D2.W)
02:0004C076 41EC0098        	  4999:     lea     ($0098,A4),A0
02:0004C07A 10303000        	  5000:     move.b  (A0,D3.W),D0
02:0004C07E 41EC0098        	  5001:     lea     ($0098,A4),A0
02:0004C082 11802000        	  5002:     move.b  D0,(A0,D2.W)
                            	  5003:     ; The fire lasts $4F frames.
                            	  5004:     ; Deactivate the shot.
                            	  5005:     ;
02:0004C086 704F            	  5006:     moveq   #79,D0
02:0004C088 19802028        	  5007:     move.b  D0,($28,A4,D2.W)
                            	  5008:     even
