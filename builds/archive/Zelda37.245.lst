02:0003B5A6 41EC0492        	  3913:     lea     ($0492,A4),A0
02:0003B5AA 10302000        	  3914:     move.b  (A0,D2.W),D0
02:0003B5AE 66EC            	  3915:     bne  _anon_z04_53
02:0003B5B0 4EB90004D5A2    	  3916:     jsr     ResetObjMetastateAndTimer
02:0003B5B6 6000F45A        	  3917:     jmp     EndInitFlyer
                            	  3918: 
