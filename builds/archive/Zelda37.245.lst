02:00041A40 1880            	  2870:     move.b  D0,($0000,A4)
                            	  2871:     ; Call GetOppositeDir again to use this mapping:
                            	  2872:     ; In Dir: 1 2 4 8
                            	  2873:     ;         -------
                            	  2874:     ; Index:  2 3 0 1
                            	  2875:     ;
02:00041A42 4EB900030FDA    	  2876:     jsr     GetOppositeDir
                            	  2877:     ; Get the appropriate coordinate for the direction:
                            	  2878:     ; X for horizontal
                            	  2879:     ; Y for vertical
                            	  2880:     ;
02:00041A48 102C0070        	  2881:     move.b  ($0070,A4),D0
02:00041A4C 0C030002        	  2882:     cmpi.b  #$02,D3
02:00041A50 6404            	  2883:     bcc  _anon_z05_74
02:00041A52 102C0084        	  2884:     move.b  ($0084,A4),D0
                            	  2885: _anon_z05_74:
02:00041A56 19400002        	  2886:     move.b  D0,($0002,A4)
                            	  2887:     ; Mask A button and directions if inner border is crossed.
                            	  2888:     ;
02:00041A5A 1003            	  2889:     move.b  D3,D0
02:00041A5C 1B00            	  2890:     move.b  D0,-(A5)  ; PHA
02:00041A5E 023C00EE        	  2891:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A62 123C0008        	  2892:     move.b  #$08,D1
02:00041A66 D101            	  2893:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041A68 7600            	  2894:     moveq   #0,D3
02:00041A6A 1600            	  2895:     move.b  D0,D3
02:00041A6C 103C0080        	  2896:     move.b  #$80,D0
02:00041A70 6134            	  2897:     jsr     MaskInputInBorder
02:00041A72 101D            	  2898:     move.b  (A5)+,D0  ; PLA
02:00041A74 7600            	  2899:     moveq   #0,D3
02:00041A76 1600            	  2900:     move.b  D0,D3
                            	  2901:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2902:     ; boundary using player's direction and reverse direction index.
                            	  2903:     ;
02:00041A78 102C0001        	  2904:     move.b  ($0001,A4),D0
