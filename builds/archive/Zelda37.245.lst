                            	  6950:     even
                            	  6951: _L_z07_AnimateLinkObjState_CheckState20:
                            	  6952:     ; If major state = $20
                            	  6953:     ;   if minor state = 0, make it 1
                            	  6954:     ;   else OR state with $30
                            	  6955:     ;   go set movement frame to 1
                            	  6956:     ;
02:0004CDCE 0C000020        	  6957:     cmpi.b  #$20,D0
02:0004CDD2 6624            	  6958:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:0004CDD4 102C00AC        	  6959:     move.b  ($00AC,A4),D0
02:0004CDD8 0200000F        	  6960:     andi.b #$0F,D0
02:0004CDDC 6606            	  6961:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
                            	  6962:     even
                            	  6963: _L_z07_AnimateLinkObjState_IncState:
