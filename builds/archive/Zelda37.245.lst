02:0003A59E 610001F8        	  1558:     jsr     Gel_CheckCollisions
02:0003A5A2 41EC0405        	  1559:     lea     ($0405,A4),A0
02:0003A5A6 10302000        	  1560:     move.b  (A0,D2.W),D0
