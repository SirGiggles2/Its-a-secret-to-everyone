                            	  5688: AnimateAndDrawObjectWalking:
02:00031B24 4EB90004CD44    	  5689:     jsr     AnimateObjectWalking
02:00031B2A 1003            	  5690:     move.b  D3,D0
02:00031B2C 6004            	  5691:     jmp     DrawObjectNotMirrored
                            	  5692: 
                            	  5693: ; Params:
                            	  5694: ; A: frame image
                            	  5695: ; X: object index
                            	  5696: ; [00]: object X
                            	  5697: ; [01]: object Y
                            	  5698: ;
                            	  5699: ;
                            	  5700: ; Set [0C] mirrored.
                            	  5701:     even
                            	  5702: DrawObjectMirrored:
02:00031B2E 7601            	  5703:     moveq   #1,D3
02:00031B30 6602            	  5704:     bne  _anon_z01_75
                            	  5705: ; Params:
                            	  5706: ; A: frame image
                            	  5707: ; X: object index
                            	  5708: ; [00]: object X
                            	  5709: ; [01]: object Y
                            	  5710: ; [0F]: flip horizontally
                            	  5711: ;
                            	  5712:     even
                            	  5713: DrawObjectNotMirrored:
02:00031B32 7600            	  5714:     moveq   #0,D3
                            	  5715: _anon_z01_75:
02:00031B34 1943000C        	  5716:     move.b  D3,($000C,A4)
                            	  5717:     ; Set animation index = object type + 1.
                            	  5718:     ;
02:00031B38 7600            	  5719:     moveq   #0,D3
02:00031B3A 41EC034F        	  5720:     lea     ($034F,A4),A0
02:00031B3E 16302000        	  5721:     move.b  (A0,D2.W),D3
                            	  5722: ; Params:
                            	  5723: ; A: frame
                            	  5724: ; X: object index/cycle sprite index
                            	  5725: ; Y: object type
                            	  5726: ; [00]: object X
                            	  5727: ; [01]: object Y
                            	  5728: ; [0C]: mirrored
                            	  5729: ; [0F]: flip horizontally
                            	  5730: ;
                            	  5731: ; Note:
                            	  5732: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5733: ;
                            	  5734: ; The animation index of most objects is (object type + 1),
                            	  5735: ; to make up for the fact that Link uses two animation indexes.
                            	  5736: ;
                            	  5737:     even
                            	  5738: DrawObjectWithType:
02:00031B42 5203            	  5739:     addq.b  #1,D3
                            	  5740: ; Params:
                            	  5741: ; A: frame
                            	  5742: ; X: object index/cycle sprite index
                            	  5743: ; Y: animation index
                            	  5744: ; [00]: object X
                            	  5745: ; [01]: object Y
                            	  5746: ; [0C]: mirrored
                            	  5747: ; [0F]: flip horizontally
                            	  5748: ;
                            	  5749: ; Note:
                            	  5750: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5751: ; But Link uses [0F] for flipping without checking [0C].
                            	  5752: ;
                            	  5753: ;
                            	  5754: ; [0D] holds frame.
                            	  5755:     even
                            	  5756: DrawObjectWithAnim:
02:00031B44 1940000D        	  5757:     move.b  D0,($000D,A4)
02:00031B48 1943000E        	  5758:     move.b  D3,($000E,A4)
02:00031B4C 19420008        	  5759:     move.b  D2,($0008,A4)
                            	  5760:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5761:     ;
02:00031B50 7600            	  5762:     moveq   #0,D3
02:00031B52 162C0341        	  5763:     move.b  ($0341,A4),D3
02:00031B56 41F900031AFA    	  5764:     lea     (SpriteOffsets).l,A0
02:00031B5C 10303000        	  5765:     move.b  (A0,D3.W),D0
02:00031B60 19400343        	  5766:     move.b  D0,($0343,A4)
02:00031B64 41F900031AFB    	  5767:     lea     (SpriteOffsets+1).l,A0
02:00031B6A 10303000        	  5768:     move.b  (A0,D3.W),D0
                            	  5769:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  5770:     ;
02:00031B6E 4A02            	  5771:     cmpi.b  #$00,D2
02:00031B70 6702            	  5772:     beq.s  __far_z_01_0049
02:00031B72 6008            	  5773:     jmp  DrawObjectWithAnimAndSpecificSprites
                            	  5774: __far_z_01_0049:
02:00031B74 7048            	  5775:     moveq   #72,D0
02:00031B76 19400343        	  5776:     move.b  D0,($0343,A4)
02:00031B7A 704C            	  5777:     moveq   #76,D0
                            	  5778:     even
                            	  5779: DrawObjectWithAnimAndSpecificSprites:
02:00031B7C 19400344        	  5780:     move.b  D0,($0344,A4)
02:00031B80 7600            	  5781:     moveq   #0,D3
02:00031B82 162C000E        	  5782:     move.b  ($000E,A4),D3
02:00031B86 7001            	  5783:     moveq   #1,D0
02:00031B88 19400007        	  5784:     move.b  D0,($0007,A4)
02:00031B8C 7008            	  5785:     moveq   #8,D0
02:00031B8E 1940000A        	  5786:     move.b  D0,($000A,A4)
02:00031B92 41F9000318E2    	  5787:     lea     (ObjAnimations).l,A0
02:00031B98 10303000        	  5788:     move.b  (A0,D3.W),D0
02:00031B9C 023C00EE        	  5789:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BA0 122C000D        	  5790:     move.b  ($000D,A4),D1
02:00031BA4 D101            	  5791:     addx.b  D1,D0   ; ADC $0D
02:00031BA6 7600            	  5792:     moveq   #0,D3
02:00031BA8 1600            	  5793:     move.b  D0,D3
02:00031BAA 41F900031962    	  5794:     lea     (ObjAnimFrameHeap).l,A0
02:00031BB0 10303000        	  5795:     move.b  (A0,D3.W),D0
02:00031BB4 19400002        	  5796:     move.b  D0,($0002,A4)
02:00031BB8 023C00EE        	  5797:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BBC 123C0002        	  5798:     move.b  #$02,D1
02:00031BC0 D101            	  5799:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00031BC2 19400003        	  5800:     move.b  D0,($0003,A4)
                            	  5801:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  5802:     ; then go set attributes and write sprites.
                            	  5803:     ;
02:00031BC6 4A02            	  5804:     cmpi.b  #$00,D2
02:00031BC8 6722            	  5805:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00031BCA 0C02000D        	  5806:     cmpi.b  #$0D,D2
02:00031BCE 641C            	  5807:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
                            	  5808:     ; If the object has a "half-width draw" attribute, then
                            	  5809:     ; go draw half-width.
                            	  5810:     ;
02:00031BD0 41EC04BF        	  5811:     lea     ($04BF,A4),A0
02:00031BD4 10302000        	  5812:     move.b  (A0,D2.W),D0
02:00031BD8 02000002        	  5813:     andi.b #$02,D0
02:00031BDC 6630            	  5814:     bne  _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth
                            	  5815:     ; If the object has the "Ignore sprite attribute table" attribute,
                            	  5816:     ; then don't look up sprite attributes.
                            	  5817:     ;
02:00031BDE 41EC04BF        	  5818:     lea     ($04BF,A4),A0
02:00031BE2 10302000        	  5819:     move.b  (A0,D2.W),D0
02:00031BE6 02000008        	  5820:     andi.b #$08,D0
02:00031BEA 660E            	  5821:     bne  _anon_z01_76
                            	  5822:     even
                            	  5823: _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr:
02:00031BEC 41F900031A2E    	  5824:     lea     (ObjAnimAttrHeap).l,A0
02:00031BF2 10303000        	  5825:     move.b  (A0,D3.W),D0
02:00031BF6 6100022C        	  5826:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5827: _anon_z01_76:
                            	  5828:     ; If it's Link, write the sprites. He's never mirrored.
                            	  5829:     ;
02:00031BFA 4A02            	  5830:     cmpi.b  #$00,D2
02:00031BFC 6602            	  5831:     bne.s  __far_z_01_0050
02:00031BFE 6014            	  5832:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  5833: __far_z_01_0050:
                            	  5834:     ; For other objects, the caller controls mirroring and flipping.
                            	  5835:     ;
                            	  5836:     ; If mirrored [0C], then draw it mirrored.
                            	  5837:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  5838:     ;
02:00031C00 7600            	  5839:     moveq   #0,D3
02:00031C02 162C000C        	  5840:     move.b  ($000C,A4),D3
02:00031C06 6602            	  5841:     bne.s  __far_z_01_0051
02:00031C08 600A            	  5842:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  5843: __far_z_01_0051:
02:00031C0A 600001FE        	  5844:     jmp     Anim_WriteMirroredSpritePair
                            	  5845: 
                            	  5846:     even
                            	  5847: _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth:
02:00031C0E 532C0007        	  5848:     subq.b  #1,($0007,A4)
02:00031C12 6034            	  5849:     jmp     Anim_WriteSpritePair
                            	  5850: 
                            	  5851: ; Params:
                            	  5852: ; [00]: Object X
                            	  5853: ; [01]: Object Y
                            	  5854: ; [02]: Left tile
                            	  5855: ; [03]: Right tile
                            	  5856: ; [04]: Left attributes
                            	  5857: ; [05]: Right attributes
