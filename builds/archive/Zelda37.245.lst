02:0003A07C 41EC00AC        	   878:     lea     ($00AC,A4),A0
02:0003A080 52302000        	   879:     addq.b  #1,(A0,D2.W)
02:0003A084 522C00F7        	   880:     addq.b  #1,($00F7,A4)
02:0003A088 7074            	   881:     moveq   #116,D0
02:0003A08A 4EB90004ADE4    	   882:     jsr     ChangeTileObjTiles
