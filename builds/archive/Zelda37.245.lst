                            	  2691: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2692:     ; If reversal count >= 2, then
                            	  2693:     ; 1. invert the horizontal component of facing direction,
                            	  2694:     ;    to face away from the chase target
                            	  2695:     ; 2. reset the reversal count to 0.
                            	  2696:     ;
                            	  2697:     ; This prevents a jumper from getting stuck in a corner.
                            	  2698:     ;
                            	  2699:     ; For example, if a tektite's direction is down and right,
                            	  2700:     ; and jumps into the top right corner of the room:
                            	  2701:     ; 1. The right room boundary is hit. So the direction is
                            	  2702:     ;    automatically reversed to up and left.
                            	  2703:     ; 2. The next frame, the top room boundary is hit.
                            	  2704:     ;    The direction is reversed to down and right.
                            	  2705:     ;
                            	  2706:     ; As you can see, an endless loop has been made.
                            	  2707:     ;
02:0003ACF2 41EC0451        	  2708:     lea     ($0451,A4),A0
02:0003ACF6 10302000        	  2709:     move.b  (A0,D2.W),D0
02:0003ACFA 0C000002        	  2710:     cmpi.b  #$02,D0
02:0003ACFE 651E            	  2711:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003AD00 41EC0098        	  2712:     lea     ($0098,A4),A0
02:0003AD04 10302000        	  2713:     move.b  (A0,D2.W),D0
02:0003AD08 0A000003        	  2714:     eori.b #$03,D0
02:0003AD0C 41EC0098        	  2715:     lea     ($0098,A4),A0
02:0003AD10 11802000        	  2716:     move.b  D0,(A0,D2.W)
02:0003AD14 7000            	  2717:     moveq   #0,D0
02:0003AD16 41EC0451        	  2718:     lea     ($0451,A4),A0
02:0003AD1A 11802000        	  2719:     move.b  D0,(A0,D2.W)
                            	  2720:     even
                            	  2721: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2722:     ; If the object is a boulder, then make sure its facing direction
                            	  2723:     ; has a down vertical component.
                            	  2724:     ;
02:0003AD1E 610001F8        	  2725:     jsr     Jumper_PointBoulderDownward
                            	  2726:     ; For the given direction, get the Y offset of the destination
                            	  2727:     ; of the jump.
                            	  2728:     ;
                            	  2729:     ; Add it to the object's Y, and store this destination Y.
                            	  2730:     ;
02:0003AD22 7600            	  2731:     moveq   #0,D3
02:0003AD24 41EC0098        	  2732:     lea     ($0098,A4),A0
02:0003AD28 16302000        	  2733:     move.b  (A0,D2.W),D3
02:0003AD2C 41EC0084        	  2734:     lea     ($0084,A4),A0
02:0003AD30 10302000        	  2735:     move.b  (A0,D2.W),D0
02:0003AD34 023C00EE        	  2736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD38 41F90003AC50    	  2737:     lea     (JumperYOffsets).l,A0
02:0003AD3E 12303000        	  2738:     move.b  (A0,D3.W),D1
02:0003AD42 D101            	  2739:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003AD44 41EC0444        	  2740:     lea     ($0444,A4),A0
02:0003AD48 11802000        	  2741:     move.b  D0,(A0,D2.W)
                            	  2742:     ; Set the starting speed, depending on the object type.
                            	  2743:     ;
02:0003AD4C 610001A0        	  2744:     jsr     Jumper_GetKind
02:0003AD50 41F90003AC7A    	  2745:     lea     (JumperStartSpeedsHi).l,A0
02:0003AD56 10303000        	  2746:     move.b  (A0,D3.W),D0
02:0003AD5A 41EC0412        	  2747:     lea     ($0412,A4),A0
02:0003AD5E 11802000        	  2748:     move.b  D0,(A0,D2.W)
                            	  2749:     ; Reset the vertical speed low byte.
