02:0003B1AE 102C0084        	  3323:     move.b  ($0084,A4),D0
02:0003B1B2 41EC0084        	  3324:     lea     ($0084,A4),A0
02:0003B1B6 11802000        	  3325:     move.b  D0,(A0,D2.W)
                            	  3326:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3327:     ; it's too close to the top edge of the screen. So, return.
                            	  3328:     ;
02:0003B1BA 0C00005D        	  3329:     cmpi.b  #$5D,D0
02:0003B1BE 65EC            	  3330:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3331:     ; If facing right, then use X offset $28.
                            	  3332:     ; Else store X offset -$28 in [00].
                            	  3333:     ;
02:0003B1C0 7628            	  3334:     moveq   #40,D3
02:0003B1C2 41EC0098        	  3335:     lea     ($0098,A4),A0
02:0003B1C6 10302000        	  3336:     move.b  (A0,D2.W),D0
02:0003B1CA 02000002        	  3337:     andi.b #$02,D0
02:0003B1CE 6704            	  3338:     beq  _anon_z04_45
02:0003B1D0 163C00D8        	  3339:     move.b  #$D8,D3
                            	  3340: _anon_z04_45:
02:0003B1D4 1883            	  3341:     move.b  D3,($0000,A4)
                            	  3342:     ; [01] holds Link's X coordinate.
                            	  3343:     ;
02:0003B1D6 102C0070        	  3344:     move.b  ($0070,A4),D0
02:0003B1DA 19400001        	  3345:     move.b  D0,($0001,A4)
                            	  3346:     ; Add Link's X and the horizontal offset.
                            	  3347:     ;
02:0003B1DE 023C00EE        	  3348:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B1E2 1214            	  3349:     move.b  ($0000,A4),D1
02:0003B1E4 D101            	  3350:     addx.b  D1,D0   ; ADC $00
                            	  3351:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3352:     ;
02:0003B1E6 020000F8        	  3353:     andi.b #$F8,D0
                            	  3354:     ; Assign that result to the leever's X coordinate and [02].
                            	  3355:     ;
02:0003B1EA 19802070        	  3356:     move.b  D0,($70,A4,D2.W)
02:0003B1EE 19400002        	  3357:     move.b  D0,($0002,A4)
                            	  3358:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3359:     ;
02:0003B1F2 122C0001        	  3360:     move.b  ($0001,A4),D1
02:0003B1F6 B001            	  3361:     cmp.b   D1,D0
02:0003B1F8 6510            	  3362:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003B1FA 1B00            	  3363:     move.b  D0,-(A5)  ; PHA
02:0003B1FC 102C0001        	  3364:     move.b  ($0001,A4),D0
02:0003B200 19400002        	  3365:     move.b  D0,($0002,A4)
02:0003B204 101D            	  3366:     move.b  (A5)+,D0  ; PLA
02:0003B206 19400001        	  3367:     move.b  D0,($0001,A4)
                            	  3368:     even
                            	  3369: _L_z04_UpdateRedLeever_Subtract:
                            	  3370:     ; The point is to get the absolute distance between the two.
                            	  3371:     ;
02:0003B20A 102C0001        	  3372:     move.b  ($0001,A4),D0
02:0003B20E 003C0011        	  3373:     ori     #$11,CCR  ; SEC: set C+X
02:0003B212 122C0002        	  3374:     move.b  ($0002,A4),D1
02:0003B216 0A3C0010        	  3375:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B21A 9101            	  3376:     subx.b  D1,D0   ; SBC $02
02:0003B21C 0A3C0010        	  3377:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3378:     ; If the absolute distance >= $30, then return.
                            	  3379:     ; It means that the leever's X coordinate wrapped around
                            	  3380:     ; the left or right edge of the screen.
                            	  3381:     ;
02:0003B220 0C000030        	  3382:     cmpi.b  #$30,D0
02:0003B224 6486            	  3383:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3384:     even
                            	  3385: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
