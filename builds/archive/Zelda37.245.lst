                            	   621: 
                            	   622: ;------------------------------------------------------------------------------
                            	   623: ; _c_move_object_shim — MoveObject trampoline.
                            	   624: ;
                            	   625: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   626: ;   Input:     D2 = slot (0..11)
                            	   627: ;   Preserves: D2, A4, A5
                            	   628: ;   Clobbers:  D0, D1, D3, A0
                            	   629: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   630: ;
                            	   631: ; GCC side:
                            	   632: ;   void c_move_object(unsigned short slot);
                            	   633: ;     slot arrives as a 16-bit value on the stack.
                            	   634: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   635: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   636: ;   never clobbered by gcc.
                            	   637: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   638: ;   semantics can exist in a pure C port).
                            	   639: ;------------------------------------------------------------------------------
                            	   640: _c_move_object_shim:
                            	   641:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   642:     move.b  #$AA,($0900,A4)
                            	   643:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   644:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   645:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   646:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   647:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   648:     moveq   #0,D0
02:0002B658 3002            	   649:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   650:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   651:     jsr     c_move_object
02:0002B662 588F            	   652:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   653:     rts
                            	   654: 
                            	   655: ;==============================================================================
                            	   656: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   657: ; and tail-call the native asm function.
                            	   658: ;
                            	   659: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   660: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   661: ; sign-extended).
                            	   662: ;==============================================================================
                            	   663: 
                            	   664: ;------------------------------------------------------------------------------
                            	   665: ; void c_copy_bank_to_window(unsigned int bank);
                            	   666: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   667: ;------------------------------------------------------------------------------
                            	   668: c_copy_bank_to_window:
02:0002B666 202F0004        	   669:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   670:     jmp     _copy_bank_to_window
                            	   671: 
                            	   672: ;------------------------------------------------------------------------------
                            	   673: ; unsigned char c_ppu_read_2(void);
                            	   674: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   675: ; C return: gcc expects result in D0.
                            	   676: ;------------------------------------------------------------------------------
                            	   677: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   678:     jmp     _ppu_read_2
                            	   679: 
                            	   680: ;------------------------------------------------------------------------------
                            	   681: ; void c_ppu_write_6(unsigned int val);
                            	   682: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   683: ;------------------------------------------------------------------------------
                            	   684: c_ppu_write_6:
02:0002B674 202F0004        	   685:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   686:     jmp     _ppu_write_6
                            	   687: 
                            	   688: ;------------------------------------------------------------------------------
