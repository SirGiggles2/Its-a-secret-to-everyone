                            	  7650:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7651:     ;
                            	  7652:     ; Down has two frame images, but up only has one. By flipping
                            	  7653:     ; horizontally, you get two frame images.
                            	  7654:     ;
