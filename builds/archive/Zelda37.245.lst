02:0002E8B2 123C0014        	   892:     move.b  #$14,D1
02:0002E8B6 D101            	   893:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E8B8 1940067E        	   894:     move.b  D0,($067E,A4)
