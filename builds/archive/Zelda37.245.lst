02:00045554 19410602        	  9090:     move.b  D1,($0602,A4)
                            	  9091: _anon_z05_215:
02:00045558 4E75            	  9092:     rts
                            	  9093: 
                            	  9094: ; Params:
                            	  9095: ; A: direction to search: 0=none, 1=forward, 2=backward
                            	  9096: ; Y: starting item slot
                            	  9097: ;
                            	  9098: ; Returns:
                            	  9099: ; [EF]: direction to search
                            	  9100: ;
                            	  9101:     even
