02:0004BAF8 6A04            	  4152:     bpl.s  __far_z_07_0048
02:0004BAFA 600000AC        	  4153:     jmp  L1F148_Exit
                            	  4154: __far_z_07_0048:
                            	  4155:     even
                            	  4156: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4157:     ; If grid offset <> 0, return.
                            	  4158:     ;
02:0004BAFE 41EC0394        	  4159:     lea     ($0394,A4),A0
02:0004BB02 10302000        	  4160:     move.b  (A0,D2.W),D0
02:0004BB06 6704            	  4161:     beq.s  __far_z_07_0049
02:0004BB08 6000009E        	  4162:     jmp  L1F148_Exit
                            	  4163: __far_z_07_0049:
                            	  4164:     ; Grid offset = 0.
                            	  4165:     ; The object is at a point between cells in the grid.
                            	  4166:     ; So, we can check tiles for collision.
                            	  4167:     ;
                            	  4168:     ; Reset [0E] alternate direction search step.
                            	  4169:     ;
