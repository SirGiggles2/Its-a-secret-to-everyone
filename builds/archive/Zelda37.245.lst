                            	  3761: FormatHeartsInTextBuf:
                            	  3762:     ; [$0E]: hearts value
                            	  3763:     ; [$0F]: heart partial
                            	  3764:     ; Y: The offset of first character in buffer
                            	  3765:     ;
                            	  3766:     ; The end of the bottom row is $12 bytes after the
                            	  3767:     ; start of the top row. We're writing to two transfer
                            	  3768:     ; records. We write the top row in the first transfer
                            	  3769:     ; record wherever the caller chooses. The second
                            	  3770:     ; transfer record has to begin with the heart tiles.
                            	  3771:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3772:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3773:     ;
                            	  3774:     ; Store the starting offset in [$0D].
02:00030C9A 1943000D        	  3775:     move.b  D3,($000D,A4)
02:00030C9E 102C000E        	  3776:     move.b  ($000E,A4),D0
02:00030CA2 1B00            	  3777:     move.b  D0,-(A5)  ; PHA
02:00030CA4 0200000F        	  3778:     andi.b #$0F,D0
02:00030CA8 1880            	  3779:     move.b  D0,($0000,A4)
02:00030CAA 700F            	  3780:     moveq   #15,D0
02:00030CAC 003C0011        	  3781:     ori     #$11,CCR  ; SEC: set C+X
02:00030CB0 1214            	  3782:     move.b  ($0000,A4),D1
02:00030CB2 0A3C0010        	  3783:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030CB6 9101            	  3784:     subx.b  D1,D0   ; SBC $00
02:00030CB8 0A3C0010        	  3785:     eori    #$10,CCR  ; restore X = 6502 C
02:00030CBC 1880            	  3786:     move.b  D0,($0000,A4)
02:00030CBE 101D            	  3787:     move.b  (A5)+,D0  ; PLA
02:00030CC0 E208            	  3788:     lsr.b  #1,D0   ; LSR A
02:00030CC2 E208            	  3789:     lsr.b  #1,D0   ; LSR A
02:00030CC4 E208            	  3790:     lsr.b  #1,D0   ; LSR A
02:00030CC6 E208            	  3791:     lsr.b  #1,D0   ; LSR A
02:00030CC8 19400001        	  3792:     move.b  D0,($0001,A4)
02:00030CCC 700F            	  3793:     moveq   #15,D0
02:00030CCE 003C0011        	  3794:     ori     #$11,CCR  ; SEC: set C+X
02:00030CD2 122C0001        	  3795:     move.b  ($0001,A4),D1
02:00030CD6 0A3C0010        	  3796:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030CDA 9101            	  3797:     subx.b  D1,D0   ; SBC $01
02:00030CDC 0A3C0010        	  3798:     eori    #$10,CCR  ; restore X = 6502 C
02:00030CE0 19400001        	  3799:     move.b  D0,($0001,A4)
                            	  3800:     ; At this point,
                            	  3801:     ; [$00] = $F - hearts
                            	  3802:     ; [$01] = $F - heart containers
                            	  3803:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3804:     ;
                            	  3805:     ; Also, Y is still set to the value passed in.
                            	  3806:     ;
02:00030CE4 7400            	  3807:     moveq   #0,D2
02:00030CE6 1003            	  3808:     move.b  D3,D0
02:00030CE8 023C00EE        	  3809:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030CEC 123C0007        	  3810:     move.b  #$07,D1
02:00030CF0 D101            	  3811:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030CF2 1940000B        	  3812:     move.b  D0,($000B,A4)
