02:0002E41C 6602            	   234:     bne.s  __far_z_01_0001
02:0002E41E 600A            	   235:     jmp  InitCaveContinue
                            	   236: __far_z_01_0001:
                            	   237:     ; Otherwise destroy the person object, and let Link continue.
                            	   238:     ;
02:0002E420 7000            	   239:     moveq   #0,D0
02:0002E422 19400350        	   240:     move.b  D0,($0350,A4)
                            	   241:     even
                            	   242: UnhaltLink:
02:0002E426 6000D5C6        	   243:     jmp     c_unhalt_link
