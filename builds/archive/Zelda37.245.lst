02:00036CA8 19400321        	  5170:     move.b  D0,($0321,A4)
                            	  5171:     even
                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:00036CAC 103C00FF        	  5176:     move.b  #$FF,D0
02:00036CB0 19400325        	  5177:     move.b  D0,($0325,A4)
02:00036CB4 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:00036CB8 7020            	  5181:     moveq   #32,D0
02:00036CBA 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:00036CBE 7400            	  5185:     moveq   #0,D2
02:00036CC0 142C050C        	  5186:     move.b  ($050C,A4),D2
02:00036CC4 41F900036A6A    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:00036CCA 10302000        	  5188:     move.b  (A0,D2.W),D0
02:00036CCE 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:00036CD2 102C050D        	  5192:     move.b  ($050D,A4),D0
02:00036CD6 7600            	  5193:     moveq   #0,D3
02:00036CD8 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:00036CDA E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00036CDC E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:00036CDE E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:00036CE0 E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:00036CE2 E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:00036CE4 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:00036CE8 41F900036A76    	  5205:     lea     (CreditsPagesTextMasks).l,A0
02:00036CEE 10302000        	  5206:     move.b  (A0,D2.W),D0
                            	  5207: _anon_z02_43:
                            	  5208:     ; Shift left as many times as the current VRAM line number,
                            	  5209:     ; to get the bit that indicates whether this line has text.
                            	  5210:     ;
02:00036CF2 E308            	  5211:     lsl.b  #1,D0   ; ASL A
02:00036CF4 5303            	  5212:     subq.b  #1,D3
02:00036CF6 6AFA            	  5213:     bpl  _anon_z02_43
02:00036CF8 6400013E        	  5214:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5215:     ; The mask inidcates that it should have text.
                            	  5216:     ; But if line index >= $17, then it doesn't.
                            	  5217:     ;
02:00036CFC 7600            	  5218:     moveq   #0,D3
02:00036CFE 162C050E        	  5219:     move.b  ($050E,A4),D3
02:00036D02 0C030017        	  5220:     cmpi.b  #$17,D3
02:00036D06 64000130        	  5221:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5222:     ; In the first quest, don't consider line numbers >= $10.
                            	  5223:     ;
02:00036D0A 7400            	  5224:     moveq   #0,D2
02:00036D0C 142C0016        	  5225:     move.b  ($0016,A4),D2
02:00036D10 41EC062D        	  5226:     lea     ($062D,A4),A0
02:00036D14 10302000        	  5227:     move.b  (A0,D2.W),D0
02:00036D18 6608            	  5228:     bne  _anon_z02_44
02:00036D1A 0C030010        	  5229:     cmpi.b  #$10,D3
02:00036D1E 64000114        	  5230:     bcc  _L_z02_DrawCredits_IncLine
                            	  5231: _anon_z02_44:
02:00036D22 7400            	  5232:     moveq   #0,D2
02:00036D24 142C0016        	  5233:     move.b  ($0016,A4),D2
02:00036D28 41EC062D        	  5234:     lea     ($062D,A4),A0
02:00036D2C 10302000        	  5235:     move.b  (A0,D2.W),D0
                            	  5236:     ; In the second quest, skip lines $C to $F.
                            	  5237:     ;
02:00036D30 670E            	  5238:     beq  _anon_z02_45
02:00036D32 0C03000C        	  5239:     cmpi.b  #$0C,D3
02:00036D36 6508            	  5240:     bcs  _anon_z02_45
02:00036D38 0C030010        	  5241:     cmpi.b  #$10,D3
02:00036D3C 650000F6        	  5242:     bcs  _L_z02_DrawCredits_IncLine
                            	  5243: _anon_z02_45:
02:00036D40 41F900036A82    	  5244:     lea     (CreditsTextAddrsLo).l,A0
02:00036D46 10303000        	  5245:     move.b  (A0,D3.W),D0
02:00036D4A 1880            	  5246:     move.b  D0,($0000,A4)
02:00036D4C 41F900036A9A    	  5247:     lea     (CreditsTextAddrsHi).l,A0
02:00036D52 10303000        	  5248:     move.b  (A0,D3.W),D0
02:00036D56 19400001        	  5249:     move.b  D0,($0001,A4)
                            	  5250:     ; First read the length of the string.
                            	  5251:     ;
