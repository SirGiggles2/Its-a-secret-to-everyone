                            	  2905: InitTrap_Full:
                            	  2906:     ; Copy this parent/generator object's attributes to [01].
                            	  2907:     ;
02:000306E8 41EC04BF        	  2908:     lea     ($04BF,A4),A0
02:000306EC 10302000        	  2909:     move.b  (A0,D2.W),D0
02:000306F0 19400001        	  2910:     move.b  D0,($0001,A4)
                            	  2911:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2912:     ;
02:000306F4 7605            	  2913:     moveq   #5,D3
                            	  2914:     ; The individual trap objects to make will be of type $49.
                            	  2915:     ; Store it in [00].
                            	  2916:     ;
02:000306F6 7049            	  2917:     moveq   #73,D0
02:000306F8 1880            	  2918:     move.b  D0,($0000,A4)
                            	  2919:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  2920:     ; then we'll make 4 traps.
                            	  2921:     ;
02:000306FA 41EC034F        	  2922:     lea     ($034F,A4),A0
02:000306FE 12302000        	  2923:     move.b  (A0,D2.W),D1
02:00030702 B001            	  2924:     cmp.b   D1,D0
02:00030704 6702            	  2925:     beq  _L_z01_InitTrap_Full_LoopTrap
02:00030706 7603            	  2926:     moveq   #3,D3
                            	  2927:     even
                            	  2928: _L_z01_InitTrap_Full_LoopTrap:
                            	  2929:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
                            	  2930:     ;
