02:0003070A 023C00EE        	  2932:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  2933:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  2934:     ;
02:0003070E 122C0340        	  2935:     move.b  ($0340,A4),D1
02:00030712 D101            	  2936:     addx.b  D1,D0   ; ADC CurObjIndex
02:00030714 7400            	  2937:     moveq   #0,D2
02:00030716 1400            	  2938:     move.b  D0,D2
                            	  2939:     ; Look up and set the location for this iteration's individual trap.
                            	  2940:     ;
02:00030718 41F9000306DC    	  2941:     lea     (TrapXs).l,A0
02:0003071E 10303000        	  2942:     move.b  (A0,D3.W),D0
02:00030722 19802070        	  2943:     move.b  D0,($70,A4,D2.W)
02:00030726 41F9000306E2    	  2944:     lea     (TrapYs).l,A0
02:0003072C 10303000        	  2945:     move.b  (A0,D3.W),D0
02:00030730 41EC0084        	  2946:     lea     ($0084,A4),A0
02:00030734 11802000        	  2947:     move.b  D0,(A0,D2.W)
02:00030738 619E            	  2948:     jsr     InitOneSimpleObject
02:0003073A 5302            	  2949:     subq.b  #1,D2
02:0003073C 5303            	  2950:     subq.b  #1,D3
02:0003073E 6AC8            	  2951:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:00030740 4E75            	  2952:     rts
