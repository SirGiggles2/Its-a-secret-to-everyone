02:00045500 102C03F8        	  9034:     move.b  ($03F8,A4),D0
02:00045504 122C00EF        	  9035:     move.b  ($00EF,A4),D1
02:00045508 B001            	  9036:     cmp.b   D1,D0
02:0004550A 6604            	  9037:     bne.s  __far_z_05_0104
02:0004550C 60000094        	  9038:     jmp  L177F1_Exit
                            	  9039: __far_z_05_0104:
02:00045510 7400            	  9040:     moveq   #0,D2
02:00045512 1400            	  9041:     move.b  D0,D2
                            	  9042:     ; If input direction = 0, up, or down; then we won't change
                            	  9043:     ; the change the selected item slot forward or backward.
                            	  9044:     ;
                            	  9045:     ; Instead, jump to this routine to make sure an occupied slot
                            	  9046:     ; is selected, then return.
                            	  9047:     ;
