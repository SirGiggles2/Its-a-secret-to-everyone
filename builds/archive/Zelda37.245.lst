                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:00040464 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:00040466 7400            	   545:     moveq   #0,D2
02:00040468 41F90004041C    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0004046E 14303000        	   547:     move.b  (A0,D3.W),D2
02:00040472 41F90004044C    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:00040478 10303000        	   549:     move.b  (A0,D3.W),D0
02:0004047C 41F900047476    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040482 11802000        	   551:     move.b  D0,(A0,D2.W)
02:00040486 5303            	   552:     subq.b  #1,D3
02:00040488 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0004048A 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0004048C 7001            	   561:     moveq   #1,D0
02:0004048E 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:00040492 7003            	   569:     moveq   #3,D0
02:00040494 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:00040498 7400            	   576:     moveq   #0,D2
02:0004049A 41F90004041C    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:000404A0 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:000404A4 102C0006        	   585:     move.b  ($0006,A4),D0
02:000404A8 122C0671        	   586:     move.b  ($0671,A4),D1
02:000404AC C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000404AE 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:000404B0 41F900047476    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000404B6 10302000        	   599:     move.b  (A0,D2.W),D0
02:000404BA 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:000404BE 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000404C0 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:000404C4 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000404C6 41F900040434    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:000404CC 10303000        	   605:     move.b  (A0,D3.W),D0
02:000404D0 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:000404D2 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:000404D6 41F900047476    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000404DC 11802000        	   613:     move.b  D0,(A0,D2.W)
                            	   614:     even
                            	   615: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   616:     ; Bottom of the inner loop.
                            	   617:     ;
                            	   618:     ; Increment the triforce tile slot.
                            	   619:     ; Decrement [07] and loop again, if it's not 0.
                            	   620:     ;
02:000404E0 5203            	   621:     addq.b  #1,D3
02:000404E2 532C0007        	   622:     subq.b  #1,($0007,A4)
02:000404E6 66B0            	   623:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   624:     ; Bottom of the outer loop.
                            	   625:     ;
                            	   626:     ; Shift the level test bit [06] left to test the next level.
                            	   627:     ; When it becomes 0, we're done.
                            	   628:     ;
02:000404E8 122C0006        	   629:     move.b  ($0006,A4),D1
02:000404EC E309            	   630:     lsl.b  #1,D1   ; ASL $06
02:000404EE 19410006        	   631:     move.b  D1,($0006,A4)
02:000404F2 669E            	   632:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:000404F4 522C00E1        	   633:     addq.b  #1,($00E1,A4)
02:000404F8 4E75            	   634:     rts
