                            	  8250: 
                            	  8251: ; Description:
                            	  8252: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8253: ; When walking, the object timer is set. When teleporting,
                            	  8254: ; the teleporting distance remaining is set.
                            	  8255: ;
                            	  8256: ; If we have the magic clock, then only go draw and check collisions.
                            	  8257: ;
                            	  8258:     even
                            	  8259: UpdateBlueWizzrobe:
02:0003D5B6 102C066C        	  8260:     move.b  ($066C,A4),D0
02:0003D5BA 6702            	  8261:     beq.s  __far_z_04_0070
02:0003D5BC 6014            	  8262:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8263: __far_z_04_0070:
02:0003D5BE 6116            	  8264:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D5C0 61000318        	  8265:     jsr     BlueWizzrobe_TryShooting
                            	  8266:     even
                            	  8267: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8268:     ; If the teleporting distance remaining is even, then draw
                            	  8269:     ; and check collisions, else return.
                            	  8270:     ;
                            	  8271:     ; This means that when 0, the monster is walking.
                            	  8272:     ; So, draw and check collisions every frame.
                            	  8273:     ;
                            	  8274:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8275:     ; translucently -- every other frame.
                            	  8276:     ;
02:0003D5C4 41EC0394        	  8277:     lea     ($0394,A4),A0
02:0003D5C8 10302000        	  8278:     move.b  (A0,D2.W),D0
02:0003D5CC E208            	  8279:     lsr.b  #1,D0   ; LSR A
02:0003D5CE 6402            	  8280:     bcc.s  __far_z_04_0071
02:0003D5D0 603A            	  8281:     jmp  L11E17_Exit
                            	  8282: __far_z_04_0071:
                            	  8283:     even
                            	  8284: L_Wizzrobe_DrawAndCheckCollisions:
02:0003D5D2 600004DE        	  8285:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8286: 
                            	  8287:     even
                            	  8288: BlueWizzrobe_WalkOrTeleport:
                            	  8289:     ; If timer has not expired, then go walk.
                            	  8290:     ;
02:0003D5D6 10342028        	  8291:     move.b  ($28,A4,D2.W),D0
02:0003D5DA 661C            	  8292:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8293:     ; Timer = 0. Only teleporting now.
                            	  8294:     ;
                            	  8295:     ; If there is still distance to go while translucent, then
                            	  8296:     ; decrement the distance remaining, and move.
                            	  8297:     ;
02:0003D5DC 41EC0394        	  8298:     lea     ($0394,A4),A0
02:0003D5E0 10302000        	  8299:     move.b  (A0,D2.W),D0
02:0003D5E4 670A            	  8300:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D5E6 41EC0394        	  8301:     lea     ($0394,A4),A0
02:0003D5EA 53302000        	  8302:     subq.b  #1,(A0,D2.W)
02:0003D5EE 602A            	  8303:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8304: 
                            	  8305:     even
                            	  8306: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8307:     ; Distance remaining = 0. Still teleporting.
                            	  8308:     ;
02:0003D5F0 6100021A        	  8309:     jsr     BlueWizzrobe_AlignWithNearestSquareAndRandomizeTimer
02:0003D5F4 600000B0        	  8310:     jmp     BlueWizzrobe_TurnTowardLink
                            	  8311: 
                            	  8312:     even
                            	  8313: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8314:     ; Timer:
                            	  8315:     ;   >= $10: Turn if needed and move every other frame
                            	  8316:     ;   > 1:    Do nothing
                            	  8317:     ;   = 1:    Choose a place to teleport to.
                            	  8318:     ;
                            	  8319:     ; Notice that walking is slower than teleporting; and there is
                            	  8320:     ; a pause of $10 frames at the end.
                            	  8321:     ;
02:0003D5F8 0C000010        	  8322:     cmpi.b  #$10,D0
02:0003D5FC 6502            	  8323:     bcs.s  __far_z_04_0072
02:0003D5FE 600E            	  8324:     jmp  GoEveryOtherFrame
                            	  8325: __far_z_04_0072:
