                            	  7390:     even
                            	  7391: DodongoFrameHFlips:
02:0003CEF0 00              	  7392:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CEF1 40
02:0003CEF2 00
02:0003CEF3 FF
02:0003CEF4 00
02:0003CEF5 00
02:0003CEF6 40
02:0003CEF7 40
02:0003CEF8 FF              	  7393:     dc.b    $FF, $40
02:0003CEF9 40
