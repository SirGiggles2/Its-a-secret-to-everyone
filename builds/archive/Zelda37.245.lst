                            	  3284:     ; If facing down, then use Y offset $28.
                            	  3285:     ; Else store Y offset -$28 in [00].
                            	  3286:     ;
02:0003B174 7628            	  3287:     moveq   #40,D3
02:0003B176 41EC0098        	  3288:     lea     ($0098,A4),A0
02:0003B17A 10302000        	  3289:     move.b  (A0,D2.W),D0
02:0003B17E 02000008        	  3290:     andi.b #$08,D0
02:0003B182 6704            	  3291:     beq  _anon_z04_44
02:0003B184 163C00D8        	  3292:     move.b  #$D8,D3
                            	  3293: _anon_z04_44:
02:0003B188 1883            	  3294:     move.b  D3,($0000,A4)
                            	  3295:     ; Add Link's Y and the vertical offset.
                            	  3296:     ;
02:0003B18A 102C0084        	  3297:     move.b  ($0084,A4),D0
02:0003B18E 023C00EE        	  3298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B192 1214            	  3299:     move.b  ($0000,A4),D1
02:0003B194 D101            	  3300:     addx.b  D1,D0   ; ADC $00
                            	  3301:     ; Sanitize the Y coordinate:
                            	  3302:     ; (Y AND $F0) OR $D
                            	  3303:     ;
02:0003B196 020000F0        	  3304:     andi.b #$F0,D0
02:0003B19A 0000000D        	  3305:     ori.b #$0D,D0
02:0003B19E 41EC0084        	  3306:     lea     ($0084,A4),A0
02:0003B1A2 11802000        	  3307:     move.b  D0,(A0,D2.W)
                            	  3308:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3309:     ; go see if the tile is valid to come out of.
                            	  3310:     ;
                            	  3311:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3312:     ;
02:0003B1A6 0C00005D        	  3313:     cmpi.b  #$5D,D0
02:0003B1AA 647A            	  3314:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
