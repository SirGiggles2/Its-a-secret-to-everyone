                            	  6962: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6963:     ; Bloated timer =>
                            	  6964:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6965:     ; 1:     go advance the substate
                            	  6966:     ; other: go decrement Bloated timer
                            	  6967:     ;
02:0003CC32 7600            	  6968:     moveq   #0,D3
02:0003CC34 41EC045E        	  6969:     lea     ($045E,A4),A0
02:0003CC38 16302000        	  6970:     move.b  (A0,D2.W),D3
02:0003CC3C 5303            	  6971:     subq.b  #1,D3
02:0003CC3E 6750            	  6972:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CC40 6B04            	  6973:     bmi.s  __far_z_04_0058
02:0003CC42 60000080        	  6974:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6975: __far_z_04_0058:
                            	  6976:     ; Set the bloated timer according to the substate.
                            	  6977:     ;
02:0003CC46 7600            	  6978:     moveq   #0,D3
02:0003CC48 41EC042C        	  6979:     lea     ($042C,A4),A0
02:0003CC4C 16302000        	  6980:     move.b  (A0,D2.W),D3
02:0003CC50 41F90003CB8E    	  6981:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003CC56 10303000        	  6982:     move.b  (A0,D3.W),D0
02:0003CC5A 41EC045E        	  6983:     lea     ($045E,A4),A0
02:0003CC5E 11802000        	  6984:     move.b  D0,(A0,D2.W)
                            	  6985:     ; If substate <> 0, go decrement bloated timer.
                            	  6986:     ;
02:0003CC62 4A03            	  6987:     cmpi.b  #$00,D3
02:0003CC64 6702            	  6988:     beq.s  __far_z_04_0059
02:0003CC66 605C            	  6989:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6990: __far_z_04_0059:
                            	  6991:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  6992:     ;
02:0003CC68 7610            	  6993:     moveq   #16,D3
02:0003CC6A 7000            	  6994:     moveq   #0,D0
02:0003CC6C 41EC00AC        	  6995:     lea     ($00AC,A4),A0
02:0003CC70 11803000        	  6996:     move.b  D0,(A0,D3.W)
                            	  6997:     ; Increment the number of bomb hits.
                            	  6998:     ;
02:0003CC74 41EC0437        	  6999:     lea     ($0437,A4),A0
02:0003CC78 10302000        	  7000:     move.b  (A0,D2.W),D0
02:0003CC7C 023C00EE        	  7001:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC80 123C0001        	  7002:     move.b  #$01,D1
02:0003CC84 D101            	  7003:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003CC86 41EC0437        	  7004:     lea     ($0437,A4),A0
02:0003CC8A 11802000        	  7005:     move.b  D0,(A0,D2.W)
02:0003CC8E 6034            	  7006:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  7007: 
                            	  7008:     even
                            	  7009: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7010:     ; Advance the substate.
                            	  7011:     ;
02:0003CC90 41EC042C        	  7012:     lea     ($042C,A4),A0
02:0003CC94 52302000        	  7013:     addq.b  #1,(A0,D2.W)
                            	  7014:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7015:     ;
02:0003CC98 41EC042C        	  7016:     lea     ($042C,A4),A0
02:0003CC9C 10302000        	  7017:     move.b  (A0,D2.W),D0
02:0003CCA0 0C000002        	  7018:     cmpi.b  #$02,D0
02:0003CCA4 6402            	  7019:     bcc.s  __far_z_04_0060
02:0003CCA6 601C            	  7020:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7021: __far_z_04_0060:
                            	  7022:     ; New bloated substate >= 2.
                            	  7023:     ;
                            	  7024:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7025:     ; which will transition to state 0 (moving).
                            	  7026:     ;
                            	  7027:     ; Note that if the bomb hits >= 2, then:
