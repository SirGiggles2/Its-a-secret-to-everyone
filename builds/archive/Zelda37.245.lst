02:000421CC 102C0001        	  4028:     move.b  ($0001,A4),D0
02:000421D0 41F90004219C    	  4029:     lea     (DoorwayBoundsMinOver).l,A0
02:000421D6 12303000        	  4030:     move.b  (A0,D3.W),D1
02:000421DA B001            	  4031:     cmp.b   D1,D0
02:000421DC 6510            	  4032:     bcs  _anon_z05_95
02:000421DE 41F9000421A0    	  4033:     lea     (DoorwayBoundsMaxOver).l,A0
02:000421E4 12303000        	  4034:     move.b  (A0,D3.W),D1
02:000421E8 B001            	  4035:     cmp.b   D1,D0
02:000421EA 65000082        	  4036:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4037: _anon_z05_95:
