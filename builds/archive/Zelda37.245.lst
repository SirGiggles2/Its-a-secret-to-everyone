                            	 11137: __far_z_04_0101:
                            	 11138:     ; The animation timer has expired. There are two choices for arming it.
                            	 11139:     ;
                            	 11140:     ; When writhing after a hit, Gleeok animates faster.
                            	 11141:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	 11142:     ; Otherwise, set a longer time ($10).
                            	 11143:     ;
