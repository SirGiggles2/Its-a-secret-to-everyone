                            	  5838: _anon_z05_122:
                            	  5839:     ; If the door command = 4 after incrementing it, then
                            	  5840:     ; it was 3 (close door). So:
                            	  5841:     ; 1. reset this door's flag
                            	  5842:     ; 2. remove it from the opened door mask
                            	  5843:     ; 3. reset the door command
                            	  5844:     ; 4. go lay out doors in the play area map
                            	  5845:     ;
02:00043948 102C0054        	  5846:     move.b  ($0054,A4),D0
02:0004394C 0C000004        	  5847:     cmpi.b  #$04,D0
02:00043950 6626            	  5848:     bne  _anon_z05_123
02:00043952 7400            	  5849:     moveq   #0,D2
02:00043954 142C0009        	  5850:     move.b  ($0009,A4),D2
02:00043958 6100DCE2        	  5851:     jsr     ResetDoorFlag
02:0004395C 102C0055        	  5852:     move.b  ($0055,A4),D0
02:00043960 0A00000F        	  5853:     eori.b #$0F,D0
02:00043964 122C00EE        	  5854:     move.b  ($00EE,A4),D1
02:00043968 C001            	  5855:     and.b  D1,D0
                            	  5856:     even
                            	  5857: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004396A 194000EE        	  5858:     move.b  D0,($00EE,A4)
                            	  5859:     even
                            	  5860: L_ResetDoorCmdAndLayOutDoors:
02:0004396E 7000            	  5861:     moveq   #0,D0
02:00043970 19400054        	  5862:     move.b  D0,($0054,A4)
02:00043974 6000FCD4        	  5863:     jmp     LayOutDoors
                            	  5864: 
                            	  5865: _anon_z05_123:
                            	  5866:     ; Door command <> 4.
                            	  5867:     ; It must be 8, which means it was 7: open door.
                            	  5868:     ;
                            	  5869:     ; If the door is a shutter (7), then go add the door to the
                            	  5870:     ; opened door mask, reset door command, and lay out doors.
                            	  5871:     ;
02:00043978 102C0055        	  5872:     move.b  ($0055,A4),D0
02:0004397C 19400002        	  5873:     move.b  D0,($0002,A4)
02:00043980 6100FA32        	  5874:     jsr     FindDoorAttrByDoorBit
02:00043984 0C000007        	  5875:     cmpi.b  #$07,D0
02:00043988 676E            	  5876:     beq  _anon_z05_124
                            	  5877:     ; Else the door is not a shutter.
                            	  5878:     ;
                            	  5879:     ;
                            	  5880:     ; [09] door direction index
02:0004398A 7400            	  5881:     moveq   #0,D2
02:0004398C 142C0009        	  5882:     move.b  ($0009,A4),D2
02:00043990 6100DCA4        	  5883:     jsr     SetDoorFlag
                            	  5884:     ; Get the next room's ID.
                            	  5885:     ;
02:00043994 1003            	  5886:     move.b  D3,D0
02:00043996 023C00EE        	  5887:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004399A 41F900043856    	  5888:     lea     (DoorNextRoomIdOffsets).l,A0
02:000439A0 12302000        	  5889:     move.b  (A0,D2.W),D1
02:000439A4 D101            	  5890:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000439A6 7600            	  5891:     moveq   #0,D3
02:000439A8 1600            	  5892:     move.b  D0,D3
                            	  5893:     ; Flip the door direction index.
                            	  5894:     ;
02:000439AA 1002            	  5895:     move.b  D2,D0
02:000439AC 0A000001        	  5896:     eori.b #$01,D0
02:000439B0 7400            	  5897:     moveq   #0,D2
02:000439B2 1400            	  5898:     move.b  D0,D2
                            	  5899:     ; Set the door flag for the opposite door in the next room.
                            	  5900:     ;
02:000439B4 1214            	  5901:     move.b  ($00,A4),D1   ; ptr lo
02:000439B6 182C0001        	  5902:     move.b  ($01,A4),D4  ; ptr hi
02:000439BA 024100FF        	  5903:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439BE E14C            	  5904:     lsl.w   #8,D4
02:000439C0 8841            	  5905:     or.w    D1,D4             ; D4 = NES ptr addr
02:000439C2 48C4            	  5906:     ext.l   D4
02:000439C4 D8BC00FF0000    	  5907:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000439CA 2044            	  5908:     movea.l D4,A0
02:000439CC 10303000        	  5909:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000439D0 41F90004AB14    	  5910:     lea     (LevelMasks).l,A0
02:000439D6 12302000        	  5911:     move.b  (A0,D2.W),D1
02:000439DA 8001            	  5912:     or.b  D1,D0
02:000439DC 1214            	  5913:     move.b  ($00,A4),D1   ; ptr lo
02:000439DE 182C0001        	  5914:     move.b  ($01,A4),D4  ; ptr hi
02:000439E2 024100FF        	  5915:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439E6 E14C            	  5916:     lsl.w   #8,D4
02:000439E8 8841            	  5917:     or.w    D1,D4
02:000439EA 48C4            	  5918:     ext.l   D4
02:000439EC D8BC00FF0000    	  5919:     add.l   #NES_RAM,D4
02:000439F2 2044            	  5920:     movea.l D4,A0
02:000439F4 11803000        	  5921:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5922: _anon_z05_124:
                            	  5923:     ; Add the door to the opened door mask, reset door command,
                            	  5924:     ; and lay out doors.
                            	  5925:     ;
02:000439F8 102C0055        	  5926:     move.b  ($0055,A4),D0
02:000439FC 122C00EE        	  5927:     move.b  ($00EE,A4),D1
02:00043A00 8001            	  5928:     or.b  D1,D0
02:00043A02 6000FF66        	  5929:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5930: 
                            	  5931: ; Params:
                            	  5932: ; [08]: 0 if closed
                            	  5933: ;
                            	  5934: ; Returns:
                            	  5935: ; X: current length of dynamic transfer buf
                            	  5936: ; [00]: door VRAM address high byte
                            	  5937: ; [01]: door VRAM address low byte
                            	  5938: ; [02:03]: address of door tiles for direction and face
                            	  5939: ; [05]: 2, the number of transfer records to write
                            	  5940: ; [06]: 2, the number of tiles in each record
                            	  5941: ; [07]: 0, the first index of a tile to transfer
                            	  5942: ; [09]: door direction index
                            	  5943: ;
                            	  5944: ; Note that this routine is called with triggered doors:
                            	  5945: ; doors that can change state. Their door type numbers are >= 4.
                            	  5946: ;
                            	  5947: ; If this routine were ever called with a fixed door
                            	  5948: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5949: ; values for the door face.
                            	  5950: ;
                            	  5951: ;
                            	  5952: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5953: ;
                            	  5954:     even
                            	  5955: PrepareWriteHorizontalDoorTransferRecords:
02:00043A06 102C0055        	  5956:     move.b  ($0055,A4),D0
02:00043A0A 19400002        	  5957:     move.b  D0,($0002,A4)
02:00043A0E 6100F9A4        	  5958:     jsr     FindDoorAttrByDoorBit
02:00043A12 0C000005        	  5959:     cmpi.b  #$05,D0
02:00043A16 650C            	  5960:     bcs  _anon_z05_125
02:00043A18 1B00            	  5961:     move.b  D0,-(A5)  ; PHA
02:00043A1A 7004            	  5962:     moveq   #4,D0
02:00043A1C 4EB900030B46    	  5963:     jsr     PlaySample
02:00043A22 101D            	  5964:     move.b  (A5)+,D0  ; PLA
                            	  5965: _anon_z05_125:
                            	  5966:     ; Calculate the door face index in three parts.
                            	  5967:     ;
                            	  5968:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5969:     ; (provisional face index in Y register).
                            	  5970:     ;
02:00043A24 0C000004        	  5971:     cmpi.b  #$04,D0
02:00043A28 6602            	  5972:     bne  _anon_z05_126
