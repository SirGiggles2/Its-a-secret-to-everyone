02:000452D4 6100586A        	  8712:     jsr     GetRoomFlags
02:000452D8 102C00EB        	  8713:     move.b  ($00EB,A4),D0
02:000452DC 1B00            	  8714:     move.b  D0,-(A5)  ; PHA
                            	  8715:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8716:     ; in order to look up its information.
                            	  8717:     ;
02:000452DE 102C005D        	  8718:     move.b  ($005D,A4),D0
02:000452E2 194000EB        	  8719:     move.b  D0,($00EB,A4)
                            	  8720:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8721:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8722:     ; map mark tile.
                            	  8723:     ;
02:000452E6 7013            	  8724:     moveq   #19,D0
02:000452E8 1940033F        	  8725:     move.b  D0,($033F,A4)
                            	  8726:     ; Get the currently scanned room's visit state.
                            	  8727:     ;
02:000452EC 7600            	  8728:     moveq   #0,D3
02:000452EE 162C00EB        	  8729:     move.b  ($00EB,A4),D3
02:000452F2 1214            	  8730:     move.b  ($00,A4),D1   ; ptr lo
02:000452F4 182C0001        	  8731:     move.b  ($01,A4),D4  ; ptr hi
02:000452F8 024100FF        	  8732:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000452FC E14C            	  8733:     lsl.w   #8,D4
