02:0003F68A 1880            	 12720:     move.b  D0,($0000,A4)
02:0003F68C 6100009C        	 12721:     jsr     Ganon_GetCurCloudTop
02:0003F690 6100FF7E        	 12722:     jsr     Ganon_DrawCloud
02:0003F694 6100009A        	 12723:     jsr     Ganon_GetCurCloudBottom
02:0003F698 6100FF76        	 12724:     jsr     Ganon_DrawCloud
                            	 12725:     ; Draw the left and right clouds.
                            	 12726:     ;
02:0003F69C 61000080        	 12727:     jsr     Ganon_GetCurCloudLeft
02:0003F6A0 41EC0084        	 12728:     lea     ($0084,A4),A0
02:0003F6A4 10302000        	 12729:     move.b  (A0,D2.W),D0
02:0003F6A8 19400001        	 12730:     move.b  D0,($0001,A4)
02:0003F6AC 6100FF62        	 12731:     jsr     Ganon_DrawCloud
02:0003F6B0 6172            	 12732:     jsr     Ganon_GetCurCloudRight
02:0003F6B2 6100FF5C        	 12733:     jsr     Ganon_DrawCloud
                            	 12734:     ; Save the object index.
                            	 12735:     ;
02:0003F6B6 102C0340        	 12736:     move.b  ($0340,A4),D0
02:0003F6BA 1B00            	 12737:     move.b  D0,-(A5)  ; PHA
                            	 12738:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12739:     ;
02:0003F6BC 7402            	 12740:     moveq   #2,D2
                            	 12741:     even
                            	 12742: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F6BE 19420340        	 12743:     move.b  D2,($0340,A4)
                            	 12744:     ; If object slot < 5 or = 7, then move every frame.
                            	 12745:     ; Else move 3 out of every 4 frames.
                            	 12746:     ;
                            	 12747:     ; This makes pieces spread out in somewhat of a circle,
                            	 12748:     ; by making the pieces at cardinal directions move at
                            	 12749:     ; full speed while the diagonal ones move a little slower.
                            	 12750:     ;
02:0003F6C2 0C020005        	 12751:     cmpi.b  #$05,D2
02:0003F6C6 6510            	 12752:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F6C8 0C020007        	 12753:     cmpi.b  #$07,D2
02:0003F6CC 670A            	 12754:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F6CE 102C0015        	 12755:     move.b  ($0015,A4),D0
02:0003F6D2 02000003        	 12756:     andi.b #$03,D0
02:0003F6D6 6704            	 12757:     beq  _anon_z04_164
                            	 12758:     even
                            	 12759: _L_z04_Ganon_DrawBurst_Move:
02:0003F6D8 6100E036        	 12760:     jsr     BlueWizzrobe_Move
                            	 12761: _anon_z04_164:
02:0003F6DC 4EB90004CDA8    	 12762:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12763:     ; The frame counter will make the sprite flash.
                            	 12764:     ; The array has the horizontal and vertical flipping attributes.
                            	 12765:     ; Combine them into [03].
                            	 12766:     ;
02:0003F6E2 102C0015        	 12767:     move.b  ($0015,A4),D0
02:0003F6E6 02000003        	 12768:     andi.b #$03,D0
02:0003F6EA 41F90003F5BA    	 12769:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F6F0 12302000        	 12770:     move.b  (A0,D2.W),D1
02:0003F6F4 8001            	 12771:     or.b  D1,D0
02:0003F6F6 19400003        	 12772:     move.b  D0,($0003,A4)
02:0003F6FA 41F90003F5C4    	 12773:     lea     (GanonBurstTiles).l,A0
02:0003F700 10302000        	 12774:     move.b  (A0,D2.W),D0
02:0003F704 4EB900031E2E    	 12775:     jsr     Anim_WriteSprite
                            	 12776:     ; Bottom of the loop.
                            	 12777:     ; Increment object slot while <= 9.
                            	 12778:     ;
02:0003F70A 5202            	 12779:     addq.b  #1,D2
02:0003F70C 0C02000A        	 12780:     cmpi.b  #$0A,D2
02:0003F710 65AC            	 12781:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12782:     ; Restore the object index.
                            	 12783:     ;
02:0003F712 101D            	 12784:     move.b  (A5)+,D0  ; PLA
02:0003F714 19400340        	 12785:     move.b  D0,($0340,A4)
02:0003F718 0A3C0001        	 12786:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F71C 4E75            	 12787:     rts
                            	 12788: 
                            	 12789: ; Returns:
                            	 12790: ; [00]: X coordinate
                            	 12791: ;
                            	 12792:     even
                            	 12793: Ganon_GetCurCloudLeft:
