                            	  5717: __far_z_05_0076:
                            	  5718:     ; Turn the door command into the desired open or closed state
                            	  5719:     ; to store in [08].
                            	  5720:     ;
                            	  5721:     ; cmd:  7 6 3 2 
                            	  5722:     ; [08]: 2 0 0 0
                            	  5723:     ;
                            	  5724:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5725:     ; commands intended to be used.
                            	  5726:     ;
                            	  5727:     ; 3 is the end state of 2: close
                            	  5728:     ; 7 is the end state of 6: open
                            	  5729:     ;
02:00043876 02000007        	  5730:     andi.b #$07,D0
02:0004387A 7601            	  5731:     moveq   #1,D3
02:0004387C 19430002        	  5732:     move.b  D3,($0002,A4)
02:00043880 122C0002        	  5733:     move.b  ($0002,A4),D1
02:00043884 C200            	  5734:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043886 6702            	  5735:     beq  _anon_z05_118
02:00043888 E208            	  5736:     lsr.b  #1,D0   ; LSR A
                            	  5737: _anon_z05_118:
02:0004388A 0C000002        	  5738:     cmpi.b  #$02,D0
02:0004388E 6606            	  5739:     bne  _anon_z05_119
                            	  5740:     ; Command 2 sets Link's timer to $30.
                            	  5741:     ;
02:00043890 7630            	  5742:     moveq   #48,D3
02:00043892 19430028        	  5743:     move.b  D3,($0028,A4)
                            	  5744: _anon_z05_119:
02:00043896 02000003        	  5745:     andi.b #$03,D0
02:0004389A 003C0011        	  5746:     ori     #$11,CCR  ; SEC: set C+X
02:0004389E 123C0001        	  5747:     move.b  #$01,D1
02:000438A2 0A3C0010        	  5748:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000438A6 9101            	  5749:     subx.b  D1,D0   ; SBC #$01
02:000438A8 0A3C0010        	  5750:     eori    #$10,CCR  ; restore X = 6502 C
02:000438AC 02000002        	  5751:     andi.b #$02,D0
02:000438B0 19400008        	  5752:     move.b  D0,($0008,A4)
                            	  5753:     ; The command to close a key door or bombable wall does not
                            	  5754:     ; do anything.
                            	  5755:     ;
02:000438B4 102C0054        	  5756:     move.b  ($0054,A4),D0
02:000438B8 0C000005        	  5757:     cmpi.b  #$05,D0
02:000438BC 6416            	  5758:     bcc  _anon_z05_120
02:000438BE 102C0055        	  5759:     move.b  ($0055,A4),D0
