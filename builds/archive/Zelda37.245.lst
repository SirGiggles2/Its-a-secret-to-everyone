02:0004C51E 00000020        	  5704:     ori.b #$20,D0
02:0004C522 194000AC        	  5705:     move.b  D0,($00AC,A4)
                            	  5706:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5707:     ; up the new state.
                            	  5708:     ;
02:0004C526 7001            	  5709:     moveq   #1,D0
02:0004C528 194003D0        	  5710:     move.b  D0,($03D0,A4)
