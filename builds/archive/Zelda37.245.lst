02:00034842 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00034844 41F900034626    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:0003484A D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
