02:000321C4 122C000D        	  6614:     move.b  ($000D,A4),D1
02:000321C8 B001            	  6615:     cmp.b   D1,D0
02:000321CA 6554            	  6616:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:000321CC 102C066F        	  6617:     move.b  ($066F,A4),D0
02:000321D0 003C0011        	  6618:     ori     #$11,CCR  ; SEC: set C+X
02:000321D4 122C000D        	  6619:     move.b  ($000D,A4),D1
02:000321D8 0A3C0010        	  6620:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000321DC 9101            	  6621:     subx.b  D1,D0   ; SBC $0D
02:000321DE 0A3C0010        	  6622:     eori    #$10,CCR  ; restore X = 6502 C
02:000321E2 1940066F        	  6623:     move.b  D0,($066F,A4)
02:000321E6 0A3C0001        	  6624:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000321EA 4E75            	  6625:     rts
