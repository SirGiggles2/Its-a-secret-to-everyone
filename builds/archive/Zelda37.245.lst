02:0004C534 11803000        	  5716:     move.b  D0,(A0,D3.W)
02:0004C538 0A3C0001        	  5717:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C53C 4E75            	  5718:     rts
