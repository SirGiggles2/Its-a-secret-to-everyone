                            	   513: UpdateMode0Demo_Sub2:
                            	   514:     ; Copy data from each save file A to save slot info.
                            	   515:     ; Most of the game will deal with save slot info.
                            	   516:     ; Format each inactive file A, to make sure it's clear.
                            	   517:     ;
02:00033988 4EB90004A9C0    	   518:     jsr     TurnOffAllVideo
02:0003398E 7000            	   519:     moveq   #0,D0
02:00033990 19400016        	   520:     move.b  D0,($0016,A4)
02:00033994 6100D23A        	   521:     jsr     FetchFileAAddressSet
02:00033998 7602            	   522:     moveq   #2,D3
                            	   523:     even
                            	   524: _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot:
02:0003399A 122C0006        	   525:     move.b  ($06,A4),D1   ; ptr lo
02:0003399E 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:000339A2 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000339A6 E14C            	   528:     lsl.w   #8,D4
02:000339A8 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:000339AA 48C4            	   530:     ext.l   D4
02:000339AC D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000339B2 2044            	   532:     movea.l D4,A0
02:000339B4 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000339B8 41EC0633        	   534:     lea     ($0633,A4),A0
02:000339BC 11803000        	   535:     move.b  D0,(A0,D3.W)
02:000339C0 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:000339C2 1003            	   537:     move.b  D3,D0
02:000339C4 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:000339C6 19430016        	   539:     move.b  D3,($0016,A4)
02:000339CA 6100D204        	   540:     jsr     FetchFileAAddressSet
02:000339CE 61001C3C        	   541:     jsr     FormatFileA
02:000339D2 7000            	   542:     moveq   #0,D0
02:000339D4 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:000339D8 6100D1F6        	   550:     jsr     FetchFileAAddressSet
02:000339DC 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:000339DE 7600            	   552:     moveq   #0,D3
02:000339E0 1600            	   553:     move.b  D0,D3
                            	   554:     even
