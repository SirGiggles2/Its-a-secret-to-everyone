                            	   766: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   767:     ; Replace the low byte of the VRAM address with the one
                            	   768:     ; where the next character should be written.
                            	   769:     ;
02:0002E7D8 102C045F        	   770:     move.b  ($045F,A4),D0
02:0002E7DC 19400303        	   771:     move.b  D0,($0303,A4)
                            	   772:     ; Increment the low VRAM address for the next character.
                            	   773:     ;
02:0002E7E0 522C045F        	   774:     addq.b  #1,($045F,A4)
                            	   775:     ; Use the person text selector to look up the address of the
                            	   776:     ; text for the textbox. Store the address in [00:01].
                            	   777:     ;
02:0002E7E4 7600            	   778:     moveq   #0,D3
02:0002E7E6 162C0415        	   779:     move.b  ($0415,A4),D3
02:0002E7EA 41F90002DE20    	   780:     lea     (PersonTextAddrs).l,A0
02:0002E7F0 10303000        	   781:     move.b  (A0,D3.W),D0
02:0002E7F4 1880            	   782:     move.b  D0,($0000,A4)
02:0002E7F6 5203            	   783:     addq.b  #1,D3
02:0002E7F8 41F90002DE20    	   784:     lea     (PersonTextAddrs).l,A0
02:0002E7FE 10303000        	   785:     move.b  (A0,D3.W),D0
02:0002E802 19400001        	   786:     move.b  D0,($0001,A4)
                            	   787:     ; Load the person text current character index.
                            	   788:     ;
02:0002E806 7600            	   789:     moveq   #0,D3
02:0002E808 162C0416        	   790:     move.b  ($0416,A4),D3
                            	   791:     ; Increment the index variable to point to the next character
                            	   792:     ; for next time.
                            	   793:     ;
02:0002E80C 522C0416        	   794:     addq.b  #1,($0416,A4)
                            	   795:     ; Get the current character.
                            	   796:     ;
02:0002E810 1214            	   797:     move.b  ($00,A4),D1   ; ptr lo
02:0002E812 182C0001        	   798:     move.b  ($01,A4),D4  ; ptr hi
02:0002E816 024100FF        	   799:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E81A E14C            	   800:     lsl.w   #8,D4
02:0002E81C 8841            	   801:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E81E 48C4            	   802:     ext.l   D4
02:0002E820 D8BC00FF0000    	   803:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E826 2044            	   804:     movea.l D4,A0
02:0002E828 10303000        	   805:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   806:     ; If the character is $25, then it's a special space. It will still
                            	   807:     ; take up space, but will not take time to show -- meaning that
                            	   808:     ; we'll go look up the next character to transfer.
                            	   809:     ;
02:0002E82C 0200003F        	   810:     andi.b #$3F,D0
02:0002E830 0C000025        	   811:     cmpi.b  #$25,D0
