02:0003FA54 7600            	 13229:     moveq   #0,D3
02:0003FA56 162C0627        	 13230:     move.b  ($0627,A4),D3
02:0003FA5A 0C030010        	 13231:     cmpi.b  #$10,D3
02:0003FA5E 6716            	 13232:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	 13233:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	 13234:     ; But there is a random chance that the item drop will be canceled.
                            	 13235:     ;
02:0003FA60 102C0050        	 13236:     move.b  ($0050,A4),D0
