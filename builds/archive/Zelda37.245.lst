                            	  5814: DrawBoomerangAndCheckCollision:
                            	  5815:     ; If the boomerang belongs to a monster, then check for
                            	  5816:     ; collision with Link.
                            	  5817:     ;
                            	  5818:     ; If they collide, then set state $20 and animation counter 3.
                            	  5819:     ;
