                            	  7427: BeginShove:
02:0003268C 7600            	  7428:     moveq   #0,D3
02:0003268E 1614            	  7429:     move.b  ($0000,A4),D3
02:00032690 0C02000D        	  7430:     cmpi.b  #$0D,D2
02:00032694 6412            	  7431:     bcc  _anon_z01_99
02:00032696 41EC04B2        	  7432:     lea     ($04B2,A4),A0
02:0003269A 10302000        	  7433:     move.b  (A0,D2.W),D0
02:0003269E 122C0009        	  7434:     move.b  ($0009,A4),D1
02:000326A2 C001            	  7435:     and.b  D1,D0
02:000326A4 660000C4        	  7436:     bne  _L_z01_BeginShove_Exit
                            	  7437: _anon_z01_99:
                            	  7438:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7439:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7440:     ;
                            	  7441:     ; If instead a monster is defending, then all this calculation
                            	  7442:     ; won't matter, because the shove direction will be set to the
                            	  7443:     ; weapon's direction.
                            	  7444:     ;
                            	  7445:     ; As such, calculate a direction from the monster to the defender,
                            	  7446:     ; assuming it's Link.
                            	  7447:     ;
                            	  7448:     ; Start with an assumption that the direction is vertical:
                            	  7449:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7450:     ;
02:000326A8 7008            	  7451:     moveq   #8,D0
02:000326AA 19400008        	  7452:     move.b  D0,($0008,A4)
02:000326AE 41EC0084        	  7453:     lea     ($0084,A4),A0
02:000326B2 10302000        	  7454:     move.b  (A0,D2.W),D0
02:000326B6 19400004        	  7455:     move.b  D0,($0004,A4)
02:000326BA 41EC0084        	  7456:     lea     ($0084,A4),A0
02:000326BE 10303000        	  7457:     move.b  (A0,D3.W),D0
02:000326C2 19400005        	  7458:     move.b  D0,($0005,A4)
                            	  7459:     ; If the defender is Link and his grid offset <> 0 then
                            	  7460:     ; use his usual object direction variable to determine
                            	  7461:     ; which axis to check.
                            	  7462:     ;
02:000326C6 4A03            	  7463:     cmpi.b  #$00,D3
02:000326C8 6612            	  7464:     bne  _anon_z01_100
02:000326CA 102C0394        	  7465:     move.b  ($0394,A4),D0
02:000326CE 670C            	  7466:     beq  _anon_z01_100
02:000326D0 102C0098        	  7467:     move.b  ($0098,A4),D0
02:000326D4 02000003        	  7468:     andi.b #$03,D0
02:000326D8 660C            	  7469:     bne  _L_z01_BeginShove_CheckHorizontal
02:000326DA 6720            	  7470:     beq  _L_z01_BeginShove_CheckVertical
                            	  7471: _anon_z01_100:
                            	  7472:     ; For monsters defending, or Link with grid offset = 0,
                            	  7473:     ; check direction in [0B].
                            	  7474:     ;
                            	  7475:     ; For monsters defending, this won't matter. For Link with grid
                            	  7476:     ; offset = 0, I believe the result will be arbitrary.
                            	  7477:     ;
                            	  7478:     ; TODO:
                            	  7479:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7480:     ; It doesn't seem to be if candle fire attacks him.
                            	  7481:     ;
02:000326DC 102C000B        	  7482:     move.b  ($000B,A4),D0
02:000326E0 0C000004        	  7483:     cmpi.b  #$04,D0
02:000326E4 6416            	  7484:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7485:     even
                            	  7486: _L_z01_BeginShove_CheckHorizontal:
                            	  7487:     ; If the direction checked is left or right,
                            	  7488:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7489:     ;
02:000326E6 7002            	  7490:     moveq   #2,D0
02:000326E8 19400008        	  7491:     move.b  D0,($0008,A4)
02:000326EC 10342070        	  7492:     move.b  ($70,A4,D2.W),D0
02:000326F0 19400004        	  7493:     move.b  D0,($0004,A4)
02:000326F4 10343070        	  7494:     move.b  ($70,A4,D3.W),D0
02:000326F8 19400005        	  7495:     move.b  D0,($0005,A4)
                            	  7496:     even
                            	  7497: _L_z01_BeginShove_CheckVertical:
                            	  7498:     ; If the monster is down or right of the other object,
                            	  7499:     ; then use the opposite direction already in [08].
                            	  7500:     ; Else shift [08] right to turn it into the opposite
                            	  7501:     ; direction up or down.
                            	  7502:     ;
                            	  7503:     ; Again assuming Link is the defender; after this, [08] points
                            	  7504:     ; Link away from the monster.
                            	  7505:     ;
02:000326FC 102C0004        	  7506:     move.b  ($0004,A4),D0
02:00032700 122C0005        	  7507:     move.b  ($0005,A4),D1
02:00032704 B001            	  7508:     cmp.b   D1,D0
02:00032706 640A            	  7509:     bcc  _anon_z01_101
02:00032708 122C0008        	  7510:     move.b  ($0008,A4),D1
02:0003270C E209            	  7511:     lsr.b  #1,D1   ; LSR $08
02:0003270E 19410008        	  7512:     move.b  D1,($0008,A4)
                            	  7513: _anon_z01_101:
                            	  7514:     ; If a monster is the defender, go handle it separately.
                            	  7515:     ;
02:00032712 4A03            	  7516:     cmpi.b  #$00,D3
02:00032714 6656            	  7517:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7518:     ; Link is the defender.
                            	  7519:     ;
                            	  7520:     ; If Link is invincible, return without shoving.
                            	  7521:     ;
02:00032716 102C04F0        	  7522:     move.b  ($04F0,A4),D0
02:0003271A 664E            	  7523:     bne  _L_z01_BeginShove_Exit
                            	  7524:     ; Store the shove direction we determined.
                            	  7525:     ;
                            	  7526:     ; Turn on the high bit to indicate that the next time we try to
                            	  7527:     ; move by shoving, it will be the first time for this shove action.
                            	  7528:     ;
02:0003271C 102C0008        	  7529:     move.b  ($0008,A4),D0
02:00032720 00000080        	  7530:     ori.b #$80,D0
02:00032724 194000C0        	  7531:     move.b  D0,($00C0,A4)
                            	  7532:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7533:     ;
02:00032728 7018            	  7534:     moveq   #24,D0
02:0003272A 194004F0        	  7535:     move.b  D0,($04F0,A4)
02:0003272E 7020            	  7536:     moveq   #32,D0
02:00032730 194000D3        	  7537:     move.b  D0,($00D3,A4)
                            	  7538:     ; If Link was shoved by one of his own weapons, then
                            	  7539:     ; nothing else to do. Return.
                            	  7540:     ;
02:00032734 0C02000D        	  7541:     cmpi.b  #$0D,D2
02:00032738 6430            	  7542:     bcc  _L_z01_BeginShove_Exit
                            	  7543:     ; Link was shoved by a monster.
                            	  7544:     ;
                            	  7545:     ; If the monster's object attribute "reverse after hit Link" is set,
