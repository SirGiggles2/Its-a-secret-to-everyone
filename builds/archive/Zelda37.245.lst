02:0004BFDE 0C02000D        	  4910:     cmpi.b  #$0D,D2
02:0004BFE2 6410            	  4911:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BFE4 41EC034F        	  4912:     lea     ($034F,A4),A0
02:0004BFE8 10302000        	  4913:     move.b  (A0,D2.W),D0
02:0004BFEC 0C000057        	  4914:     cmpi.b  #$57,D0
