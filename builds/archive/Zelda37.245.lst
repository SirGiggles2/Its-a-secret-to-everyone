02:0003227C 10303000        	  6707:     move.b  (A0,D3.W),D0
02:00032280 023C00EE        	  6708:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032284 123C0008        	  6709:     move.b  #$08,D1
02:00032288 D101            	  6710:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6711: ; Params:
                            	  6712: ; A: weapon object mid Y
                            	  6713: ; X: monster object slot
                            	  6714: ; Y: weapon object slot
                            	  6715: ; [00]: weapon object slot
                            	  6716: ; [02]: monster object mid X
                            	  6717: ; [03]: monster object mid Y
