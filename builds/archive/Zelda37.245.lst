02:0003F478 6704            	 12422:     beq.s  __far_z_04_0118
02:0003F47A 600000A4        	 12423:     jmp  Ganon_Dying
                            	 12424: __far_z_04_0118:
02:0003F47E 61000356        	 12425:     jsr     Ganon_CheckCollisions
02:0003F482 6100A6F4        	 12426:     jsr     PlayBossHitCryIfNeeded
                            	 12427:     ; Go handle the brown state specially.
                            	 12428:     ;
02:0003F486 41EC00AC        	 12429:     lea     ($00AC,A4),A0
02:0003F48A 10302000        	 12430:     move.b  (A0,D2.W),D0
02:0003F48E 6702            	 12431:     beq.s  __far_z_04_0119
02:0003F490 6058            	 12432:     jmp  Ganon_UpdateBrownState
                            	 12433: __far_z_04_0119:
                            	 12434:     ; State = 0: Blue
                            	 12435:     ;
                            	 12436:     ; If timer = 0, then go move around and shoot.
                            	 12437:     ;
02:0003F492 10342028        	 12438:     move.b  ($28,A4,D2.W),D0
02:0003F496 6602            	 12439:     bne.s  __far_z_04_0120
02:0003F498 600E            	 12440:     jmp  Ganon_MoveAndShoot
                            	 12441: __far_z_04_0120:
                            	 12442:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12443:     ; Collisions were checked already.
                            	 12444:     ;
                            	 12445:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12446:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12447:     ;
02:0003F49A 0C000001        	 12448:     cmpi.b  #$01,D0
02:0003F49E 6702            	 12449:     beq.s  __far_z_04_0121
02:0003F4A0 6078            	 12450:     jmp  L_Ganon_DrawBody
                            	 12451: __far_z_04_0121:
                            	 12452: ; Description:
