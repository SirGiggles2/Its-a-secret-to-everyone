                            	 12535: Ganon_Dying:
                            	 12536:     ; Ganon is dying.
                            	 12537:     ; Increment Ganon phase every frame.
                            	 12538:     ;
02:0003F520 41EC042C        	 12539:     lea     ($042C,A4),A0
