                            	  2320: _L_z04__TryShooting_TryShootingNow:
                            	  2321:     ; Summary
                            	  2322:     ;
                            	  2323:     ; if temporarily invincible then
                            	  2324:     ;   shoot timer := 0
                            	  2325:     ; elif shoot timer > 0 then
                            	  2326:     ;   decrement shoot timer
                            	  2327:     ; elif wants to shoot then
                            	  2328:     ;   shoot timer := $30
                            	  2329:     ;
                            	  2330:     ; qspeed := [01]
                            	  2331:     ;
                            	  2332:     ; if shoot timer <> 0 then
                            	  2333:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2334:     ;     shoot
                            	  2335:     ;     if succeeded then
                            	  2336:     ;       shoot timer := 0
                            	  2337:     ;       qspeed := 0
                            	  2338:     ;   else
                            	  2339:     ;     qspeed := 0
                            	  2340:     ;
                            	  2341:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003AABA 102C0001        	  2342:     move.b  ($0001,A4),D0
02:0003AABE 1883            	  2343:     move.b  D3,($0000,A4)
02:0003AAC0 1B00            	  2344:     move.b  D0,-(A5)  ; PHA
02:0003AAC2 7600            	  2345:     moveq   #0,D3
                            	  2346:     ; If not temporarily invincible,
                            	  2347:     ;
02:0003AAC4 41EC04F0        	  2348:     lea     ($04F0,A4),A0
02:0003AAC8 10302000        	  2349:     move.b  (A0,D2.W),D0
02:0003AACC 661A            	  2350:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2351:     ; then Y := shoot timer - 1
                            	  2352:     ;
02:0003AACE 7600            	  2353:     moveq   #0,D3
02:0003AAD0 41EC0451        	  2354:     lea     ($0451,A4),A0
02:0003AAD4 16302000        	  2355:     move.b  (A0,D2.W),D3
02:0003AAD8 5303            	  2356:     subq.b  #1,D3
                            	  2357:     ; If Y register < 0, then shoot timer is 0.
                            	  2358:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2359:     ; Else go set a non-zero speed and return.
                            	  2360:     ;
02:0003AADA 6A0C            	  2361:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003AADC 41EC0412        	  2362:     lea     ($0412,A4),A0
02:0003AAE0 10302000        	  2363:     move.b  (A0,D2.W),D0
02:0003AAE4 6736            	  2364:     beq  _L_z04__TryShooting_SetSpeed
02:0003AAE6 7630            	  2365:     moveq   #48,D3
                            	  2366:     even
                            	  2367: _L_z04__TryShooting_SetShootTimer:
                            	  2368:     ; shoot timer := Y
                            	  2369:     ;
02:0003AAE8 1003            	  2370:     move.b  D3,D0
02:0003AAEA 41EC0451        	  2371:     lea     ($0451,A4),A0
02:0003AAEE 11802000        	  2372:     move.b  D0,(A0,D2.W)
                            	  2373:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2374:     ;
02:0003AAF2 6728            	  2375:     beq  _L_z04__TryShooting_SetSpeed
                            	  2376:     ; shoot timer <> 0
                            	  2377:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2378:     ;
02:0003AAF4 0C030010        	  2379:     cmpi.b  #$10,D3
02:0003AAF8 661C            	  2380:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2381:     ; If we have the magic clock, or the monster is stunned, then
                            	  2382:     ; go set a zero speed.
                            	  2383:     ;
02:0003AAFA 102C066C        	  2384:     move.b  ($066C,A4),D0
02:0003AAFE 1234203D        	  2385:     move.b  ($3D,A4,D2.W),D1
02:0003AB02 8001            	  2386:     or.b  D1,D0
02:0003AB04 6610            	  2387:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2388:     ; Shoot.
                            	  2389:     ;
02:0003AB06 1014            	  2390:     move.b  ($0000,A4),D0
02:0003AB08 611E            	  2391:     jsr     _ShootIfWanted2
                            	  2392:     ; If it failed, go set a non-zero speed.
                            	  2393:     ;
02:0003AB0A 6510            	  2394:     bcs  _L_z04__TryShooting_SetSpeed
                            	  2395:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  2396:     ;
02:0003AB0C 7000            	  2397:     moveq   #0,D0
02:0003AB0E 41EC0412        	  2398:     lea     ($0412,A4),A0
02:0003AB12 11802000        	  2399:     move.b  D0,(A0,D2.W)
                            	  2400:     even
