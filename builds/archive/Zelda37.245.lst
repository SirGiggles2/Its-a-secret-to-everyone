02:00033A3A 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:00033A3E 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033A42 E14C            	   587:     lsl.w   #8,D4
02:00033A44 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033A46 48C4            	   589:     ext.l   D4
02:00033A48 D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033A4E 2044            	   591:     movea.l D4,A0
02:00033A50 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033A54 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:00033A56 1002            	   594:     move.b  D2,D0
02:00033A58 E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:00033A5A 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
02:00033A5C 101D            	   601:     move.b  (A5)+,D0  ; PLA
02:00033A5E 020000F0        	   602:     andi.b #$F0,D0
02:00033A62 1940000C        	   603:     move.b  D0,($000C,A4)
02:00033A66 E208            	   604:     lsr.b  #1,D0   ; LSR A
02:00033A68 E208            	   605:     lsr.b  #1,D0   ; LSR A
02:00033A6A E208            	   606:     lsr.b  #1,D0   ; LSR A
02:00033A6C E208            	   607:     lsr.b  #1,D0   ; LSR A
02:00033A6E 122C000C        	   608:     move.b  ($000C,A4),D1
02:00033A72 8001            	   609:     or.b  D1,D0
02:00033A74 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
