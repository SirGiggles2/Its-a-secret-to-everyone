02:0003F614 102C0001        	 12666:     move.b  ($0001,A4),D0
02:0003F618 1B00            	 12667:     move.b  D0,-(A5)  ; PHA
                            	 12668:     ; If cloud distance < 6, then use frame image $C (medium).
                            	 12669:     ; Else use frame image $D (low).
