                            	  6936: AnimateLinkObjState:
                            	  6937:     ; If major state = $10
                            	  6938:     ;   if minor state = 0, make it 1
                            	  6939:     ;   else OR state with $30
                            	  6940:     ;   go set movement frame to 1
                            	  6941:     ;
02:0004CDB4 102C00AC        	  6942:     move.b  ($00AC,A4),D0
02:0004CDB8 02000030        	  6943:     andi.b #$30,D0
02:0004CDBC 0C000010        	  6944:     cmpi.b  #$10,D0
02:0004CDC0 660C            	  6945:     bne  _L_z07_AnimateLinkObjState_CheckState20
02:0004CDC2 102C00AC        	  6946:     move.b  ($00AC,A4),D0
02:0004CDC6 0200000F        	  6947:     andi.b #$0F,D0
02:0004CDCA 6618            	  6948:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
