                            	 12704: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12705:     ; Draw the four clouds at diagonal corners.
                            	 12706:     ;
02:0003F666 610000B6        	 12707:     jsr     Ganon_GetCurCloudLeft
02:0003F66A 610000BE        	 12708:     jsr     Ganon_GetCurCloudTop
02:0003F66E 61A0            	 12709:     jsr     Ganon_DrawCloud
02:0003F670 610000B2        	 12710:     jsr     Ganon_GetCurCloudRight
02:0003F674 619A            	 12711:     jsr     Ganon_DrawCloud
02:0003F676 610000A6        	 12712:     jsr     Ganon_GetCurCloudLeft
02:0003F67A 610000B4        	 12713:     jsr     Ganon_GetCurCloudBottom
02:0003F67E 6190            	 12714:     jsr     Ganon_DrawCloud
02:0003F680 610000A2        	 12715:     jsr     Ganon_GetCurCloudRight
02:0003F684 618A            	 12716:     jsr     Ganon_DrawCloud
                            	 12717:     ; Draw the top and bottom clouds.
                            	 12718:     ;
