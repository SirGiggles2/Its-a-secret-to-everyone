02:000454CA 6502            	  9006:     bcs  _anon_z05_214
02:000454CC 7046            	  9007:     moveq   #70,D0
                            	  9008: _anon_z05_214:
02:000454CE 1940021C        	  9009:     move.b  D0,($021C,A4)
02:000454D2 19400220        	  9010:     move.b  D0,($0220,A4)
                            	  9011:     ; $1E is the cursor tile.
                            	  9012:     ;
02:000454D6 701E            	  9013:     moveq   #30,D0
02:000454D8 1940021D        	  9014:     move.b  D0,($021D,A4)
