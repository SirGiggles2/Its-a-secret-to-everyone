02:0003B4AC 10342028        	  3748:     move.b  ($28,A4,D2.W),D0
02:0003B4B0 41EC0492        	  3749:     lea     ($0492,A4),A0
02:0003B4B4 11802000        	  3750:     move.b  D0,(A0,D2.W)
                            	  3751:     ; If it's still fading in, then go finish some initialization needed
                            	  3752:     ; for fading in.
                            	  3753:     ;
02:0003B4B8 660000B6        	  3754:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3755:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3756:     ; go finish initializing it.
