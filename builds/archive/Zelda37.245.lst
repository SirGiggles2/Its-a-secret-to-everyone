                            	 11601:     ; Set the current segment's HP to the initial value in anticipation
                            	 11602:     ; of bringing this segment back to life.
                            	 11603:     ;
02:0003EEDC 7020            	 11604:     moveq   #32,D0
02:0003EEDE 41EC0485        	 11605:     lea     ($0485,A4),A0
02:0003EEE2 11802000        	 11606:     move.b  D0,(A0,D2.W)
                            	 11607:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11608:     ;
                            	 11609:     ; From the lowest slot, look for one that has the original lamnola
                            	 11610:     ; object type.
                            	 11611:     ;
                            	 11612:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11613:     ;
02:0003EEE6 163C00FF        	 11614:     move.b  #$FF,D3
02:0003EEEA 0C020006        	 11615:     cmpi.b  #$06,D2
02:0003EEEE 6502            	 11616:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003EEF0 7604            	 11617:     moveq   #4,D3
                            	 11618:     even
                            	 11619: _L_z04_UpdateLamnola_FindTail:
02:0003EEF2 5203            	 11620:     addq.b  #1,D3
02:0003EEF4 41EC0350        	 11621:     lea     ($0350,A4),A0
02:0003EEF8 10303000        	 11622:     move.b  (A0,D3.W),D0
02:0003EEFC 122C04E7        	 11623:     move.b  ($04E7,A4),D1
02:0003EF00 B001            	 11624:     cmp.b   D1,D0
02:0003EF02 66EE            	 11625:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11626:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11627:     ;
02:0003EF04 7011            	 11628:     moveq   #17,D0
02:0003EF06 19803029        	 11629:     move.b  D0,($29,A4,D3.W)
                            	 11630:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11631:     ; to the tail segment.
                            	 11632:     ;
02:0003EF0A 41EC04F0        	 11633:     lea     ($04F0,A4),A0
02:0003EF0E 10302000        	 11634:     move.b  (A0,D2.W),D0
02:0003EF12 41EC04F1        	 11635:     lea     ($04F1,A4),A0
02:0003EF16 11803000        	 11636:     move.b  D0,(A0,D3.W)
02:0003EF1A 10342070        	 11637:     move.b  ($70,A4,D2.W),D0
02:0003EF1E 19803071        	 11638:     move.b  D0,($71,A4,D3.W)
02:0003EF22 41EC0084        	 11639:     lea     ($0084,A4),A0
02:0003EF26 10302000        	 11640:     move.b  (A0,D2.W),D0
02:0003EF2A 41EC0085        	 11641:     lea     ($0085,A4),A0
02:0003EF2E 11803000        	 11642:     move.b  D0,(A0,D3.W)
                            	 11643:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11644:     ; So, return and leave it dead.
                            	 11645:     ;
02:0003EF32 0C030004        	 11646:     cmpi.b  #$04,D3
02:0003EF36 6604            	 11647:     bne.s  __far_z_04_0110
02:0003EF38 6000FF0C        	 11648:     jmp  L129EA_Exit
                            	 11649: __far_z_04_0110:
02:0003EF3C 0C030009        	 11650:     cmpi.b  #$09,D3
02:0003EF40 6604            	 11651:     bne.s  __far_z_04_0111
02:0003EF42 6000FF02        	 11652:     jmp  L129EA_Exit
                            	 11653: __far_z_04_0111:
                            	 11654:     ; Change the tail segment to the dead dummy object, and
                            	 11655:     ; bring the current segment back to life.
                            	 11656:     ;
02:0003EF46 705D            	 11657:     moveq   #93,D0
02:0003EF48 41EC0350        	 11658:     lea     ($0350,A4),A0
02:0003EF4C 11803000        	 11659:     move.b  D0,(A0,D3.W)
02:0003EF50 4EF90004D5A8    	 11660:     jmp     ResetObjMetastate
                            	 11661: 
                            	 11662:     even
                            	 11663: L12A6F_Exit:
02:0003EF56 4E75            	 11664:     rts
                            	 11665: 
                            	 11666:     even
                            	 11667: Lamnola_UpdateHead:
                            	 11668:     ; If X coordinate is not a multiple of 8, then return.
                            	 11669:     ;
02:0003EF58 10342070        	 11670:     move.b  ($70,A4,D2.W),D0
02:0003EF5C 02000007        	 11671:     andi.b #$07,D0
02:0003EF60 6702            	 11672:     beq.s  __far_z_04_0112
02:0003EF62 60F2            	 11673:     jmp  L12A6F_Exit
                            	 11674: __far_z_04_0112:
                            	 11675:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11676:     ; We had to account for the usual offset of 3.
                            	 11677:     ;
02:0003EF64 41EC0084        	 11678:     lea     ($0084,A4),A0
02:0003EF68 10302000        	 11679:     move.b  (A0,D2.W),D0
02:0003EF6C 023C00EE        	 11680:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF70 123C0003        	 11681:     move.b  #$03,D1
02:0003EF74 D101            	 11682:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EF76 02000007        	 11683:     andi.b #$07,D0
02:0003EF7A 6702            	 11684:     beq.s  __far_z_04_0113
02:0003EF7C 60D8            	 11685:     jmp  L12A6F_Exit
                            	 11686: __far_z_04_0113:
                            	 11687:     ; Will loop 4 times, propagating directions down the chain,
                            	 11688:     ; by pulling from the bottom.
                            	 11689:     ;
02:0003EF7E 7004            	 11690:     moveq   #4,D0
02:0003EF80 1880            	 11691:     move.b  D0,($0000,A4)
                            	 11692:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11693:     ;
02:0003EF82 7600            	 11694:     moveq   #0,D3
02:0003EF84 0C020005        	 11695:     cmpi.b  #$05,D2
02:0003EF88 6702            	 11696:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EF8A 7605            	 11697:     moveq   #5,D3
                            	 11698:     even
                            	 11699: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11700:     ; Loop over every segment under the head, starting from the tail.
                            	 11701:     ; Copy the next segment's direction to the current one in this loop.
                            	 11702:     ;
02:0003EF8C 41EC009A        	 11703:     lea     ($009A,A4),A0
02:0003EF90 10303000        	 11704:     move.b  (A0,D3.W),D0
02:0003EF94 41EC0099        	 11705:     lea     ($0099,A4),A0
02:0003EF98 11803000        	 11706:     move.b  D0,(A0,D3.W)
02:0003EF9C 5203            	 11707:     addq.b  #1,D3
02:0003EF9E 5314            	 11708:     subq.b  #1,($0000,A4)
02:0003EFA0 66EA            	 11709:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11710:     ; If this head segment is not aligned with a square, then return.
                            	 11711:     ;
02:0003EFA2 10342070        	 11712:     move.b  ($70,A4,D2.W),D0
02:0003EFA6 0200000F        	 11713:     andi.b #$0F,D0
02:0003EFAA 660000BA        	 11714:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11715:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11716:     ; We had to account for the usual offset of 3.
                            	 11717:     ;
02:0003EFAE 41EC0084        	 11718:     lea     ($0084,A4),A0
02:0003EFB2 10302000        	 11719:     move.b  (A0,D2.W),D0
02:0003EFB6 023C00EE        	 11720:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EFBA 123C0003        	 11721:     move.b  #$03,D1
02:0003EFBE D101            	 11722:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EFC0 0200000F        	 11723:     andi.b #$0F,D0
02:0003EFC4 660000A0        	 11724:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11725:     ; Store the opposite of the facing direction in [00].
                            	 11726:     ;
02:0003EFC8 41EC0098        	 11727:     lea     ($0098,A4),A0
02:0003EFCC 10302000        	 11728:     move.b  (A0,D2.W),D0
02:0003EFD0 E208            	 11729:     lsr.b  #1,D0   ; LSR A
02:0003EFD2 02000005        	 11730:     andi.b #$05,D0
02:0003EFD6 1880            	 11731:     move.b  D0,($0000,A4)
02:0003EFD8 41EC0098        	 11732:     lea     ($0098,A4),A0
02:0003EFDC 10302000        	 11733:     move.b  (A0,D2.W),D0
02:0003EFE0 E308            	 11734:     lsl.b  #1,D0   ; ASL A
02:0003EFE2 0200000A        	 11735:     andi.b #$0A,D0
02:0003EFE6 1214            	 11736:     move.b  ($0000,A4),D1
02:0003EFE8 8001            	 11737:     or.b  D1,D0
                            	 11738:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11739:     ;
02:0003EFEA 0A00000F        	 11740:     eori.b #$0F,D0
02:0003EFEE 1940050F        	 11741:     move.b  D0,($050F,A4)
                            	 11742:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11743:     ;
02:0003EFF2 10342018        	 11744:     move.b  ($18,A4,D2.W),D0
02:0003EFF6 0C000080        	 11745:     cmpi.b  #$80,D0
02:0003EFFA 656C            	 11746:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11747:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11748:     ; Load the monster's facing direction.
                            	 11749:     ;
02:0003EFFC 41EC0098        	 11750:     lea     ($0098,A4),A0
02:0003F000 10302000        	 11751:     move.b  (A0,D2.W),D0
                            	 11752:     ; Load the next random number into Y register.
                            	 11753:     ;
02:0003F004 7600            	 11754:     moveq   #0,D3
02:0003F006 16342019        	 11755:     move.b  ($19,A4,D2.W),D3
                            	 11756:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11757:     ; to keep moving straight.
                            	 11758:     ;
02:0003F00A 0C030080        	 11759:     cmpi.b  #$80,D3
02:0003F00E 6418            	 11760:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11761:     even
                            	 11762: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11763:     ; Loop to rotate the direction bit over the mask.
                            	 11764:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11765:     ; facing direction.
                            	 11766:     ;
                            	 11767:     ; Shift right the copy of the direction.
                            	 11768:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11769:     ;
02:0003F010 E208            	 11770:     lsr.b  #1,D0   ; LSR A
02:0003F012 6402            	 11771:     bcc  _anon_z04_151
02:0003F014 7008            	 11772:     moveq   #8,D0
                            	 11773: _anon_z04_151:
                            	 11774:     ; If the current direction bit is masked off, then we've reached
                            	 11775:     ; the opposite direction. Loop again.
                            	 11776:     ;
02:0003F016 122C050F        	 11777:     move.b  ($050F,A4),D1
02:0003F01A C200            	 11778:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F01C 67F2            	 11779:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11780:     ; If Y register >= $40, then break out of the loop.
                            	 11781:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11782:     ;
02:0003F01E 0C030040        	 11783:     cmpi.b  #$40,D3
02:0003F022 6404            	 11784:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11785:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11786:     ; and loop again now.
                            	 11787:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11788:     ;
02:0003F024 7640            	 11789:     moveq   #64,D3
02:0003F026 65E8            	 11790:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11791:     even
                            	 11792: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11793:     ; Change the facing direction to the direction found.
                            	 11794:     ;
02:0003F028 41EC0098        	 11795:     lea     ($0098,A4),A0
02:0003F02C 11802000        	 11796:     move.b  D0,(A0,D2.W)
                            	 11797:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11798:     ;
02:0003F030 1940000F        	 11799:     move.b  D0,($000F,A4)
02:0003F034 4EB900030EE0    	 11800:     jsr     BoundByRoom
                            	 11801:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11802:     ;
02:0003F03A 102C000F        	 11803:     move.b  ($000F,A4),D0
02:0003F03E 6618            	 11804:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11805:     even
                            	 11806: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11807:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11808:     ; for looking for any non-opposite direction that is not blocked.
                            	 11809:     ;
02:0003F040 41EC0098        	 11810:     lea     ($0098,A4),A0
02:0003F044 10302000        	 11811:     move.b  (A0,D2.W),D0
                            	 11812:     even
                            	 11813: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11814:     ; Shift right the copy of the direction.
                            	 11815:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11816:     ;
02:0003F048 E208            	 11817:     lsr.b  #1,D0   ; LSR A
02:0003F04A 6402            	 11818:     bcc  _anon_z04_152
02:0003F04C 7008            	 11819:     moveq   #8,D0
                            	 11820: _anon_z04_152:
                            	 11821:     ; If the current direction bit is not masked off, then go check the
                            	 11822:     ; room boundary in this direction.
                            	 11823:     ; Else we've reached the opposite direction. Loop again.
                            	 11824:     ;
02:0003F04E 122C050F        	 11825:     move.b  ($050F,A4),D1
02:0003F052 C200            	 11826:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F054 66D2            	 11827:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003F056 67F0            	 11828:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11829:     even
                            	 11830: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11831:     ; We found a direction that was not blocked by the room boundary.
                            	 11832:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11833:     ;
02:0003F058 4EB90004B6DC    	 11834:     jsr     GetCollidingTileMoving
02:0003F05E 122C034A        	 11835:     move.b  ($034A,A4),D1
02:0003F062 B001            	 11836:     cmp.b   D1,D0
02:0003F064 64DA            	 11837:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11838:     even
                            	 11839: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11840:     ; TODO: confirm this
                            	 11841:     ;
                            	 11842:     ; If there were a room that had lamnolas, and they could get
                            	 11843:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11844:     ; an infinite loop.
                            	 11845:     ;
                            	 11846:     ; But, the only room with that configuration has those blocks
                            	 11847:     ; blocked off with a push block, which can only be pushed after
                            	 11848:     ; all monsters are killed.
                            	 11849:     ;
02:0003F066 4E75            	 11850:     rts
                            	 11851: 
                            	 11852:     even
                            	 11853: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11854:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11855:     ;
02:0003F068 7001            	 11856:     moveq   #1,D0
02:0003F06A 19400002        	 11857:     move.b  D0,($0002,A4)
02:0003F06E 102C0070        	 11858:     move.b  ($0070,A4),D0
02:0003F072 003C0011        	 11859:     ori     #$11,CCR  ; SEC: set C+X
02:0003F076 12342070        	 11860:     move.b  ($70,A4,D2.W),D1
02:0003F07A 0A3C0010        	 11861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F07E 9101            	 11862:     subx.b  D1,D0   ; SBC ObjX,X
02:0003F080 0A3C0010        	 11863:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F084 640A            	 11864:     bcc  _anon_z04_153
02:0003F086 122C0002        	 11865:     move.b  ($0002,A4),D1
02:0003F08A E309            	 11866:     lsl.b  #1,D1   ; ASL $02
02:0003F08C 19410002        	 11867:     move.b  D1,($0002,A4)
                            	 11868: _anon_z04_153:
                            	 11869:     ; Find the vertical direction toward Link and store it in [03].
                            	 11870:     ;
02:0003F090 7004            	 11871:     moveq   #4,D0
02:0003F092 19400003        	 11872:     move.b  D0,($0003,A4)
02:0003F096 102C0084        	 11873:     move.b  ($0084,A4),D0
02:0003F09A 003C0011        	 11874:     ori     #$11,CCR  ; SEC: set C+X
02:0003F09E 41EC0084        	 11875:     lea     ($0084,A4),A0
02:0003F0A2 12302000        	 11876:     move.b  (A0,D2.W),D1
02:0003F0A6 0A3C0010        	 11877:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0AA 9101            	 11878:     subx.b  D1,D0   ; SBC ObjY,X
02:0003F0AC 0A3C0010        	 11879:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0B0 640A            	 11880:     bcc  _anon_z04_154
02:0003F0B2 122C0003        	 11881:     move.b  ($0003,A4),D1
02:0003F0B6 E309            	 11882:     lsl.b  #1,D1   ; ASL $03
02:0003F0B8 19410003        	 11883:     move.b  D1,($0003,A4)
                            	 11884: _anon_z04_154:
                            	 11885:     ; If the horizontal direction toward Link is not allowed, then
                            	 11886:     ; go check the vertical direction.
                            	 11887:     ;
02:0003F0BC 102C0002        	 11888:     move.b  ($0002,A4),D0
02:0003F0C0 122C050F        	 11889:     move.b  ($050F,A4),D1
02:0003F0C4 C200            	 11890:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0C6 6708            	 11891:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11892:     ; If the horizontal direction toward Link is the same direction
                            	 11893:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11894:     ;
02:0003F0C8 122C0098        	 11895:     move.b  ($0098,A4),D1
02:0003F0CC C200            	 11896:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0CE 6604            	 11897:     bne  _anon_z04_155
                            	 11898:     even
                            	 11899: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11900:     ; Load the vertical direction toward Link in order to test it for
                            	 11901:     ; room boundary and tile collision.
                            	 11902:     ;
02:0003F0D0 102C0003        	 11903:     move.b  ($0003,A4),D0
                            	 11904: _anon_z04_155:
                            	 11905:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11906:     ;
02:0003F0D4 6000FF52        	 11907:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11908: 
                            	 11909:     even
                            	 11910: Lamnola_Move:
                            	 11911:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11912:     ;
                            	 11913:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11914:     ;
                            	 11915:     ; Start with a mask of $A1 in [02]:
                            	 11916:     ; - low nibble represents the right direction
                            	 11917:     ; - high nibble is used to set or clear carry as we go along
                            	 11918:     ;
02:0003F0D8 103C00A1        	 11919:     move.b  #$A1,D0
02:0003F0DC 19400002        	 11920:     move.b  D0,($0002,A4)
                            	 11921:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11922:     ;
02:0003F0E0 41EC0098        	 11923:     lea     ($0098,A4),A0
02:0003F0E4 10302000        	 11924:     move.b  (A0,D2.W),D0
02:0003F0E8 122C0002        	 11925:     move.b  ($0002,A4),D1
02:0003F0EC C200            	 11926:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0EE 6712            	 11927:     beq  _L_z04_Lamnola_Move_Left
02:0003F0F0 10342070        	 11928:     move.b  ($70,A4,D2.W),D0
02:0003F0F4 023C00EE        	 11929:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F0F8 122C04E6        	 11930:     move.b  ($04E6,A4),D1
02:0003F0FC D101            	 11931:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003F0FE 19802070        	 11932:     move.b  D0,($70,A4,D2.W)
                            	 11933:     even
                            	 11934: _L_z04_Lamnola_Move_Left:
                            	 11935:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 11936:     ;
02:0003F102 41EC0098        	 11937:     lea     ($0098,A4),A0
02:0003F106 10302000        	 11938:     move.b  (A0,D2.W),D0
02:0003F10A 122C0002        	 11939:     move.b  ($0002,A4),D1
