02:0003F63A 101D            	 12684:     move.b  (A5)+,D0  ; PLA
02:0003F63C 19400001        	 12685:     move.b  D0,($0001,A4)
02:0003F640 101D            	 12686:     move.b  (A5)+,D0  ; PLA
02:0003F642 1880            	 12687:     move.b  D0,($0000,A4)
02:0003F644 0A3C0001        	 12688:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F648 4E75            	 12689:     rts
