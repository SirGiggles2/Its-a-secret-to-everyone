                            	  6894: UpdateDodongoState0_Move:
                            	  6895:     ; If facing left, then push X offset 0 on the stack.
                            	  6896:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6897:     ;
                            	  6898:     ; We would like to use one set of coordinates only.
                            	  6899:     ; But movement would break down, if we did; because
                            	  6900:     ; Dodongo is so long.
                            	  6901:     ;
                            	  6902:     ; So, when not facing left, we temporarily shift the
                            	  6903:     ; X coordinate to be closer to the other side of the monster.
                            	  6904:     ;
02:0003CBAC 7600            	  6905:     moveq   #0,D3
02:0003CBAE 41EC0098        	  6906:     lea     ($0098,A4),A0
02:0003CBB2 10302000        	  6907:     move.b  (A0,D2.W),D0
02:0003CBB6 0200000D        	  6908:     andi.b #$0D,D0
02:0003CBBA 6716            	  6909:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003CBBC 10342070        	  6910:     move.b  ($70,A4,D2.W),D0
02:0003CBC0 023C00EE        	  6911:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBC4 123C0010        	  6912:     move.b  #$10,D1
02:0003CBC8 D101            	  6913:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CBCA 19802070        	  6914:     move.b  D0,($70,A4,D2.W)
02:0003CBCE 163C00F0        	  6915:     move.b  #$F0,D3
                            	  6916:     even
                            	  6917: _L_z04_UpdateDodongoState0_Move_Move:
02:0003CBD2 1003            	  6918:     move.b  D3,D0
02:0003CBD4 1B00            	  6919:     move.b  D0,-(A5)  ; PHA
02:0003CBD6 7020            	  6920:     moveq   #32,D0
02:0003CBD8 41EC041F        	  6921:     lea     ($041F,A4),A0
02:0003CBDC 11802000        	  6922:     move.b  D0,(A0,D2.W)
02:0003CBE0 6100D094        	  6923:     jsr     Wanderer_TargetPlayer
                            	  6924:     ; Pop the offset and add it to the X coordinate.
                            	  6925:     ;
                            	  6926:     ; This brings the X coordinate back to the unique value
                            	  6927:     ; that represents the position.
                            	  6928:     ;
02:0003CBE4 101D            	  6929:     move.b  (A5)+,D0  ; PLA
02:0003CBE6 023C00EE        	  6930:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CBEA 12342070        	  6931:     move.b  ($70,A4,D2.W),D1
02:0003CBEE D101            	  6932:     addx.b  D1,D0   ; ADC ObjX,X
02:0003CBF0 19802070        	  6933:     move.b  D0,($70,A4,D2.W)
                            	  6934:     ; If X coordinate < $20, then face right.
                            	  6935:     ;
02:0003CBF4 0C000020        	  6936:     cmpi.b  #$20,D0
02:0003CBF8 640A            	  6937:     bcc  _anon_z04_89
02:0003CBFA 7001            	  6938:     moveq   #1,D0
02:0003CBFC 41EC0098        	  6939:     lea     ($0098,A4),A0
02:0003CC00 11802000        	  6940:     move.b  D0,(A0,D2.W)
