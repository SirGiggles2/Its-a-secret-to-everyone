                            	  7641:     ; the second animation frame's images.
                            	  7642:     ;
02:0003D0AE 7600            	  7643:     moveq   #0,D3
02:0003D0B0 41EC03E4        	  7644:     lea     ($03E4,A4),A0
02:0003D0B4 16302000        	  7645:     move.b  (A0,D2.W),D3
02:0003D0B8 671E            	  7646:     beq  _anon_z04_95
02:0003D0BA 023C00EE        	  7647:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0BE 123C0003        	  7648:     move.b  #$03,D1
