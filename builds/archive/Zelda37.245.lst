                            	  5351: LayOutDoors:
                            	  5352:     ; Copies the right door face for the direction, type, and state
                            	  5353:     ; of the door to the play area tile map.
                            	  5354:     ;
                            	  5355:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5356:     ; that are not true doors.
                            	  5357:     ;
02:0004364A 7403            	  5358:     moveq   #3,D2
                            	  5359:     even
                            	  5360: L_LayOutDoors_LoopDoors:
                            	  5361:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5362:     ;
02:0004364C 7001            	  5363:     moveq   #1,D0
                            	  5364:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5365:     ;
                            	  5366:     ; [06] indicates whether we're handling the first half of
                            	  5367:     ; the door: Left half for N/S, Top half for E/W.
                            	  5368:     ;
02:0004364E 19400006        	  5369:     move.b  D0,($0006,A4)
                            	  5370:     even
                            	  5371: L_LayOutDoors_LoopHalves:
02:00043652 1002            	  5372:     move.b  D2,D0
02:00043654 1B00            	  5373:     move.b  D0,-(A5)  ; PHA
02:00043656 1940000B        	  5374:     move.b  D0,($000B,A4)
02:0004365A 41F900043626    	  5375:     lea     (DoorBits).l,A0
02:00043660 10302000        	  5376:     move.b  (A0,D2.W),D0
02:00043664 19400002        	  5377:     move.b  D0,($0002,A4)
02:00043668 6100FD4A        	  5378:     jsr     FindDoorAttrByDoorBit
                            	  5379:     ; Begin looking for the door face for the door attribute.
                            	  5380:     ; In general, use the door type as the provisional face;
                            	  5381:     ; except turn 4 into 8.
                            	  5382:     ;
02:0004366C 0C000005        	  5383:     cmpi.b  #$05,D0
02:00043670 642A            	  5384:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043672 0C000004        	  5385:     cmpi.b  #$04,D0
02:00043676 6608            	  5386:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:00043678 7008            	  5387:     moveq   #8,D0
02:0004367A 6620            	  5388:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5389:     even
                            	  5390: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5391:     ; We jump here if the door type is bombable and was opened.
                            	  5392:     ; Change the provisional door face to value 9, which
                            	  5393:     ; will become the "hole in the wall".
                            	  5394:     ;
02:0004367C 7009            	  5395:     moveq   #9,D0
02:0004367E 665A            	  5396:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5397:     even
                            	  5398: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5399:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5400:     ; the mask of opened doors, because this is not a true door.
                            	  5401:     ;
02:00043680 1B00            	  5402:     move.b  D0,-(A5)  ; PHA
02:00043682 102C0002        	  5403:     move.b  ($0002,A4),D0
02:00043686 4600            	  5404:     eori.b #$FF,D0
02:00043688 122C00EE        	  5405:     move.b  ($00EE,A4),D1
02:0004368C C001            	  5406:     and.b  D1,D0
02:0004368E 194000EE        	  5407:     move.b  D0,($00EE,A4)
02:00043692 101D            	  5408:     move.b  (A5)+,D0  ; PLA
                            	  5409:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5410:     ;
02:00043694 0C000001        	  5411:     cmpi.b  #$01,D0
02:00043698 6402            	  5412:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004369A 7004            	  5413:     moveq   #4,D0
                            	  5414:     even
                            	  5415: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5416:     ; The door attribute (DA) has been mapped to a
                            	  5417:     ; provisional door face value (PF) in %A as follows:
                            	  5418:     ;
                            	  5419:     ; DA PF Meaning
                            	  5420:     ; -------------
                            	  5421:     ; 0  4  open
                            	  5422:     ; 1  1  wall
                            	  5423:     ; 2  2  false wall
                            	  5424:     ; 3  3  false wall 2
                            	  5425:     ; 4  8  bombable
                            	  5426:     ; 5  5  key
                            	  5427:     ; 6  6  key 2
                            	  5428:     ; 7  7  shutter
                            	  5429:     ;
                            	  5430:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5431:     ; has been cleared, if the type was "open" or any wall.
                            	  5432:     ;
                            	  5433:     ;
                            	  5434:     ; Save the provisional face.
02:0004369C 1B00            	  5435:     move.b  D0,-(A5)  ; PHA
                            	  5436:     ; If the current direction points to a door that has been opened,
                            	  5437:     ; then see if we need to set door flags.
                            	  5438:     ;
02:0004369E 102C00EE        	  5439:     move.b  ($00EE,A4),D0
02:000436A2 122C0002        	  5440:     move.b  ($0002,A4),D1
02:000436A6 C001            	  5441:     and.b  D1,D0
02:000436A8 7400            	  5442:     moveq   #0,D2
02:000436AA 1400            	  5443:     move.b  D0,D2
02:000436AC 101D            	  5444:     move.b  (A5)+,D0  ; PLA
02:000436AE 122C0002        	  5445:     move.b  ($0002,A4),D1
02:000436B2 B401            	  5446:     cmp.b   D1,D2
02:000436B4 6624            	  5447:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5448:     ; The current direction points to a door that has been opened.
                            	  5449:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5450:     ;
                            	  5451:     ;
                            	  5452:     ; Save provisional door face in Y register.
02:000436B6 7600            	  5453:     moveq   #0,D3
02:000436B8 1600            	  5454:     move.b  D0,D3
02:000436BA 101D            	  5455:     move.b  (A5)+,D0  ; PLA
02:000436BC 1B00            	  5456:     move.b  D0,-(A5)  ; PHA
02:000436BE 7400            	  5457:     moveq   #0,D2
02:000436C0 1400            	  5458:     move.b  D0,D2
02:000436C2 1003            	  5459:     move.b  D3,D0
                            	  5460:     ; If provisional door face is not for a shutter, then
                            	  5461:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5462:     ;
                            	  5463:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5464:     ;
02:000436C4 0C000007        	  5465:     cmpi.b  #$07,D0
02:000436C8 670E            	  5466:     beq  _anon_z05_111
02:000436CA 1B00            	  5467:     move.b  D0,-(A5)  ; PHA
02:000436CC 6100DF68        	  5468:     jsr     SetDoorFlag
02:000436D0 101D            	  5469:     move.b  (A5)+,D0  ; PLA
                            	  5470:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5471:     ; then go make it 9 (open "bombable").
                            	  5472:     ; Else make it 4 (open "door").
                            	  5473:     ;
02:000436D2 0C000008        	  5474:     cmpi.b  #$08,D0
02:000436D6 67A4            	  5475:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5476: _anon_z05_111:
02:000436D8 7004            	  5477:     moveq   #4,D0
                            	  5478:     even
                            	  5479: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5480:     ; For opened doors, the provisional door face has become:
                            	  5481:     ;
                            	  5482:     ; DA PF Meaning
                            	  5483:     ; -------------
                            	  5484:     ; 0  4  open
                            	  5485:     ; 1  1  wall
                            	  5486:     ; 2  2  false wall
                            	  5487:     ; 3  3  false wall 2
                            	  5488:     ; 4  9  bombable
                            	  5489:     ; 5  4  key
                            	  5490:     ; 6  4  key 2
                            	  5491:     ; 7  4  shutter
                            	  5492:     ;
                            	  5493:     ;
                            	  5494:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5495:     ;
02:000436DA 7400            	  5496:     moveq   #0,D2
02:000436DC 142C0006        	  5497:     move.b  ($0006,A4),D2
02:000436E0 6712            	  5498:     beq  _anon_z05_112
02:000436E2 7400            	  5499:     moveq   #0,D2
02:000436E4 142C000B        	  5500:     move.b  ($000B,A4),D2
02:000436E8 1B00            	  5501:     move.b  D0,-(A5)  ; PHA
02:000436EA 6100FCC8        	  5502:     jsr     FindDoorAttrByDoorBit
02:000436EE 61001C64        	  5503:     jsr     CalcOpenDoorwayMask
02:000436F2 101D            	  5504:     move.b  (A5)+,D0  ; PLA
                            	  5505: _anon_z05_112:
                            	  5506:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5507:     ; because the visible door face is already a wall.
                            	  5508:     ;
02:000436F4 0C000004        	  5509:     cmpi.b  #$04,D0
02:000436F8 650000DC        	  5510:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5511:     ; For all other provisional face values, calculate:
                            	  5512:     ; door face := provisional face - 3
02:000436FC 003C0011        	  5513:     ori     #$11,CCR  ; SEC: set C+X
02:00043700 123C0003        	  5514:     move.b  #$03,D1
02:00043704 0A3C0010        	  5515:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043708 9101            	  5516:     subx.b  D1,D0   ; SBC #$03
02:0004370A 0A3C0010        	  5517:     eori    #$10,CCR  ; restore X = 6502 C
02:0004370E 7600            	  5518:     moveq   #0,D3
02:00043710 1600            	  5519:     move.b  D0,D3
                            	  5520:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5521:     ; subtract one.
                            	  5522:     ;
02:00043712 0C030003        	  5523:     cmpi.b  #$03,D3
02:00043716 6502            	  5524:     bcs  _anon_z05_113
02:00043718 5303            	  5525:     subq.b  #1,D3
                            	  5526: _anon_z05_113:
                            	  5527:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5528:     ;
                            	  5529:     ; DT DFC DFO Meaning
                            	  5530:     ; ------------------
                            	  5531:     ; 0  1   1   open
                            	  5532:     ; 4  4   5   bombable
                            	  5533:     ; 5  2   1   key
                            	  5534:     ; 6  2   1   key 2
                            	  5535:     ; 7  3   1   shutter
                            	  5536:     ;
                            	  5537:     ;
                            	  5538:     ; Get the direction index.
02:0004371A 101D            	  5539:     move.b  (A5)+,D0  ; PLA
02:0004371C 1B00            	  5540:     move.b  D0,-(A5)  ; PHA
02:0004371E 610000D0        	  5541:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5542:     ; If handling the second half, then offset to the second half
                            	  5543:     ; of the tiles.
                            	  5544:     ;
02:00043722 102C0006        	  5545:     move.b  ($0006,A4),D0
02:00043726 6618            	  5546:     bne  _anon_z05_114
02:00043728 41F90004363E    	  5547:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:0004372E 10302000        	  5548:     move.b  (A0,D2.W),D0
02:00043732 4EB900031432    	  5549:     jsr     AddToInt16At0
02:00043738 7006            	  5550:     moveq   #6,D0
02:0004373A 4EB90003143A    	  5551:     jsr     AddToInt16At2
                            	  5552: _anon_z05_114:
                            	  5553:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5554:     ; Pointers will be incremented instead of Y.
02:00043740 7600            	  5555:     moveq   #0,D3
02:00043742 41F900043642    	  5556:     lea     (DirIndexToDoorColumnCount).l,A0
02:00043748 10302000        	  5557:     move.b  (A0,D2.W),D0
02:0004374C 19400005        	  5558:     move.b  D0,($0005,A4)
                            	  5559:     even
                            	  5560: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5561:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5562:     ;
02:00043750 101D            	  5563:     move.b  (A5)+,D0  ; PLA
02:00043752 1B00            	  5564:     move.b  D0,-(A5)  ; PHA
02:00043754 7400            	  5565:     moveq   #0,D2
02:00043756 1400            	  5566:     move.b  D0,D2
                            	  5567:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5568:     ; starting from highest index down to 0:
                            	  5569:     ;
02:00043758 41F900043646    	  5570:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:0004375E 10302000        	  5571:     move.b  (A0,D2.W),D0
02:00043762 7400            	  5572:     moveq   #0,D2
02:00043764 1400            	  5573:     move.b  D0,D2
                            	  5574:     even
                            	  5575: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00043766 122C0002        	  5576:     move.b  ($02,A4),D1   ; ptr lo
02:0004376A 182C0003        	  5577:     move.b  ($03,A4),D4  ; ptr hi
02:0004376E 024100FF        	  5578:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043772 E14C            	  5579:     lsl.w   #8,D4
02:00043774 8841            	  5580:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043776 48C4            	  5581:     ext.l   D4
02:00043778 D8BC00FF0000    	  5582:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004377E 2044            	  5583:     movea.l D4,A0
02:00043780 10303000        	  5584:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043784 1214            	  5585:     move.b  ($00,A4),D1   ; ptr lo
02:00043786 182C0001        	  5586:     move.b  ($01,A4),D4  ; ptr hi
02:0004378A 024100FF        	  5587:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004378E E14C            	  5588:     lsl.w   #8,D4
02:00043790 8841            	  5589:     or.w    D1,D4
02:00043792 48C4            	  5590:     ext.l   D4
02:00043794 D8BC00FF0000    	  5591:     add.l   #NES_RAM,D4
02:0004379A 2044            	  5592:     movea.l D4,A0
02:0004379C 11803000        	  5593:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000437A0 4EB900031436    	  5594:     jsr     Add1ToInt16At2
02:000437A6 41F90004363A    	  5595:     lea     (NextDoorTileOffsets).l,A0
02:000437AC 10302000        	  5596:     move.b  (A0,D2.W),D0
02:000437B0 4EB900031432    	  5597:     jsr     AddToInt16At0
                            	  5598:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5599:     ; go 1 more tile down, to start the next column at the right place.
                            	  5600:     ; We have to compensate for the fact that E/W doors are 
                            	  5601:     ; shorter vertically than N/S doors.
02:000437B6 4A02            	  5602:     cmpi.b  #$00,D2
02:000437B8 6610            	  5603:     bne  _anon_z05_115
02:000437BA 101D            	  5604:     move.b  (A5)+,D0  ; PLA
02:000437BC 1B00            	  5605:     move.b  D0,-(A5)  ; PHA
02:000437BE 0C000002        	  5606:     cmpi.b  #$02,D0
02:000437C2 6406            	  5607:     bcc  _anon_z05_115
02:000437C4 4EB90003142E    	  5608:     jsr     Add1ToInt16At0
                            	  5609: _anon_z05_115:
                            	  5610:     ; Bottom of the tile row copying loop.
                            	  5611:     ; Decrement the row index.
                            	  5612:     ;
02:000437CA 5302            	  5613:     subq.b  #1,D2
02:000437CC 6A98            	  5614:     bpl  _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile
                            	  5615:     ; Bottom of the column copying loop.
                            	  5616:     ; Decrease the column counter.
                            	  5617:     ;
02:000437CE 532C0005        	  5618:     subq.b  #1,($0005,A4)
02:000437D2 6600FF7C        	  5619:     bne  _L_z05_L_LayOutDoors_LoopHalves_LoopColumn
                            	  5620:     even
                            	  5621: _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf:
                            	  5622:     ; Bottom of the door halves loop.
                            	  5623:     ;
02:000437D6 101D            	  5624:     move.b  (A5)+,D0  ; PLA
02:000437D8 7400            	  5625:     moveq   #0,D2
