02:0003DE0A 41EC0478        	  9387:     lea     ($0478,A4),A0
02:0003DE0E 10302000        	  9388:     move.b  (A0,D2.W),D0
02:0003DE12 41EC0437        	  9389:     lea     ($0437,A4),A0
