                            	  8661:     ; Exclude rooms that are not part of this level, and certain rooms
                            	  8662:     ; that should never be marked visited in the submenu map.
                            	  8663:     ;
                            	  8664:     ; First calculate the map row:
                            	  8665:     ; ((current menu scrolling value) / 2) - $D
                            	  8666:     ;
02:0004527C 102C005E        	  8667:     move.b  ($005E,A4),D0
