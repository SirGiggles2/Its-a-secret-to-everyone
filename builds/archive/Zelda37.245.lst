02:0004553E 7600            	  9081:     moveq   #0,D3
02:00045540 162C0656        	  9082:     move.b  ($0656,A4),D3
02:00045544 41EC0657        	  9083:     lea     ($0657,A4),A0
02:00045548 10303000        	  9084:     move.b  (A0,D3.W),D0
02:0004554C 660A            	  9085:     bne  _anon_z05_215
                            	  9086:     even
