                            	  5786: AnimateBoomerangAndCheckCollision:
                            	  5787:     ; Decrement animation counter; and when it reaches 0:
                            	  5788:     ; 1. arm it again for 2 frames
                            	  5789:     ; 2. advance the minor state within a cycle of 8
                            	  5790:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5791:     ;
02:0004C5CE 41EC03D0        	  5792:     lea     ($03D0,A4),A0
02:0004C5D2 53302000        	  5793:     subq.b  #1,(A0,D2.W)
02:0004C5D6 6702            	  5794:     beq.s  __far_z_07_0087
02:0004C5D8 6036            	  5795:     jmp  DrawBoomerangAndCheckCollision
                            	  5796: __far_z_07_0087:
02:0004C5DA 7002            	  5797:     moveq   #2,D0
02:0004C5DC 41EC03D0        	  5798:     lea     ($03D0,A4),A0
02:0004C5E0 11802000        	  5799:     move.b  D0,(A0,D2.W)
02:0004C5E4 41EC00AC        	  5800:     lea     ($00AC,A4),A0
02:0004C5E8 52302000        	  5801:     addq.b  #1,(A0,D2.W)
02:0004C5EC 41EC00AC        	  5802:     lea     ($00AC,A4),A0
02:0004C5F0 10302000        	  5803:     move.b  (A0,D2.W),D0
02:0004C5F4 02000077        	  5804:     andi.b #$77,D0
02:0004C5F8 41EC00AC        	  5805:     lea     ($00AC,A4),A0
02:0004C5FC 11802000        	  5806:     move.b  D0,(A0,D2.W)
02:0004C600 0C02000D        	  5807:     cmpi.b  #$0D,D2
02:0004C604 6402            	  5808:     bcc.s  __far_z_07_0088
02:0004C606 6032            	  5809:     jmp  CalcBoomerangFrame
                            	  5810: __far_z_07_0088:
