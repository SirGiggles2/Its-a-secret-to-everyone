                            	  2237: __far_z_04_0017:
02:0003AA28 61000592        	  2238:     jsr     UpdateBurrower
                            	  2239:     ; If zora died in the call above, then it happened while in
                            	  2240:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2241:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2242:     ; not come back after killing it.
                            	  2243:     ;
                            	  2244:     ; If state <> 3 or timer <> $FD,
                            	  2245:     ; then go see if the object needs to be destroyed.
                            	  2246:     ;
02:0003AA2C 41EC00AC        	  2247:     lea     ($00AC,A4),A0
02:0003AA30 10302000        	  2248:     move.b  (A0,D2.W),D0
02:0003AA34 0C000003        	  2249:     cmpi.b  #$03,D0
02:0003AA38 6616            	  2250:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003AA3A 10342028        	  2251:     move.b  ($28,A4,D2.W),D0
02:0003AA3E 0C0000FD        	  2252:     cmpi.b  #$FD,D0
02:0003AA42 660C            	  2253:     bne  _L_z04_UpdateZora_DestroyWhenDone
