02:00033A78 41EC0650        	   614:     lea     ($0650,A4),A0
02:00033A7C 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00033A80 5203            	   618:     addq.b  #1,D3
02:00033A82 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:00033A84 0C020006        	   622:     cmpi.b  #$06,D2
02:00033A88 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:00033A8A 1002            	   624:     move.b  D2,D0
02:00033A8C E208            	   625:     lsr.b  #1,D0   ; LSR A
02:00033A8E 65A8            	   626:     bcs  _L_z02_UpdateMode0Demo_Sub2_LoopHeart
                            	   627:     ; The 3 files are consecutive in the set.
                            	   628:     ; Point to the hearts value in the next slot.
