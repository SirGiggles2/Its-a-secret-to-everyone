02:0003E186 E208            	  9853:     lsr.b  #1,D0   ; LSR A
02:0003E188 6408            	  9854:     bcc  _anon_z04_122
02:0003E18A 41EC042C        	  9855:     lea     ($042C,A4),A0
02:0003E18E 53302000        	  9856:     subq.b  #1,(A0,D2.W)
                            	  9857: _anon_z04_122:
                            	  9858:     ; If open eye timer = 0, then the eye is closed.
                            	  9859:     ; Go animate it differently.
                            	  9860:     ;
