02:0003D0C6 41EC0098        	  7656:     lea     ($0098,A4),A0
02:0003D0CA 16302000        	  7657:     move.b  (A0,D2.W),D3
02:0003D0CE 0C030008        	  7658:     cmpi.b  #$08,D3
02:0003D0D2 6604            	  7659:     bne  _anon_z04_95
