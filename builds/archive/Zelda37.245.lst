02:0003FA40 D101            	 13220:     addx.b  D1,D0   ; ADC WorldKillCycle
02:0003FA42 7600            	 13221:     moveq   #0,D3
02:0003FA44 1600            	 13222:     move.b  D0,D3
02:0003FA46 41F90003F97E    	 13223:     lea     (DropItemTable).l,A0
02:0003FA4C 10303000        	 13224:     move.b  (A0,D3.W),D0
02:0003FA50 1880            	 13225:     move.b  D0,($0000,A4)
                            	 13226:     ; If the global kill count = $10, set the dropped item to a fairy.
                            	 13227:     ;
