02:0003C05C 102C0070        	  5375:     move.b  ($0070,A4),D0
02:0003C060 003C0011        	  5376:     ori     #$11,CCR  ; SEC: set C+X
02:0003C064 12342070        	  5377:     move.b  ($70,A4,D2.W),D1
02:0003C068 0A3C0010        	  5378:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C06C 9101            	  5379:     subx.b  D1,D0   ; SBC ObjX,X
02:0003C06E 0A3C0010        	  5380:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C072 4EB900030FDE    	  5381:     jsr     Abs
