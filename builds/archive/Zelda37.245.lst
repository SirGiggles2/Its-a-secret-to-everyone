02:0003F436 7002            	 12371:     moveq   #2,D0
02:0003F438 19400601        	 12372:     move.b  D0,($0601,A4)
                            	 12373: _anon_z04_160:
02:0003F43C 0A3C0001        	 12374:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F440 4E75            	 12375:     rts
                            	 12376: 
                            	 12377: ; Description:
                            	 12378: ; Lift up the Triforce of Courage while the room is light.
                            	 12379: ;
                            	 12380: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12381: ;
                            	 12382:     even
                            	 12383: Ganon_ScenePhase1:
02:0003F442 701B            	 12384:     moveq   #27,D0
02:0003F444 19400505        	 12385:     move.b  D0,($0505,A4)
                            	 12386:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12387:     ;
02:0003F448 102C0028        	 12388:     move.b  ($0028,A4),D0
02:0003F44C 6702            	 12389:     beq.s  __far_z_04_0117
02:0003F44E 6012            	 12390:     jmp  Ganon_DrawBodyFrame0
                            	 12391: __far_z_04_0117:
                            	 12392:     ; Once the timer expires:
                            	 12393:     ; 1. unhalt Link
                            	 12394:     ; 2. clear the item to lift
                            	 12395:     ; 3. play level 9 song
                            	 12396:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12397:     ;
02:0003F450 194000AC        	 12398:     move.b  D0,($00AC,A4)
02:0003F454 19400505        	 12399:     move.b  D0,($0505,A4)
02:0003F458 7020            	 12400:     moveq   #32,D0
02:0003F45A 19400600        	 12401:     move.b  D0,($0600,A4)
02:0003F45E 522C0445        	 12402:     addq.b  #1,($0445,A4)
                            	 12403:     even
                            	 12404: Ganon_DrawBodyFrame0:
                            	 12405:     ; When holding the Triforce of Courage, only draw Ganon
                            	 12406:     ; with animation frame 0.
                            	 12407:     ;
02:0003F462 7000            	 12408:     moveq   #0,D0
02:0003F464 41EC046B        	 12409:     lea     ($046B,A4),A0
02:0003F468 11802000        	 12410:     move.b  D0,(A0,D2.W)
02:0003F46C 600002EC        	 12411:     jmp     Ganon_DrawBody
                            	 12412: 
                            	 12413: ; Description:
                            	 12414: ; Fighting Ganon.
                            	 12415: ;
                            	 12416: ; If Ganon is dying, go handle it.
                            	 12417: ;
                            	 12418:     even
                            	 12419: Ganon_ScenePhase2:
02:0003F470 41EC042C        	 12420:     lea     ($042C,A4),A0
