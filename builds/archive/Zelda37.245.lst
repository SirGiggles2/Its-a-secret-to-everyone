02:00043A40 9101            	  5984:     subx.b  D1,D0   ; SBC #$03
02:00043A42 0A3C0010        	  5985:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A46 7600            	  5986:     moveq   #0,D3
02:00043A48 1600            	  5987:     move.b  D0,D3
                            	  5988:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5989:     ; face index >= 3, then subtract 1 from it.
                            	  5990:     ;
                            	  5991:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5992:     ; then make it 1.
                            	  5993:     ;
02:00043A4A 102C0008        	  5994:     move.b  ($0008,A4),D0
