                            	 12466:     ;
02:0003F4B0 41EC046B        	 12467:     lea     ($046B,A4),A0
02:0003F4B4 10302000        	 12468:     move.b  (A0,D2.W),D0
02:0003F4B8 0C000006        	 12469:     cmpi.b  #$06,D0
02:0003F4BC 660A            	 12470:     bne  _L_z04_Ganon_MoveAndShoot_Move
