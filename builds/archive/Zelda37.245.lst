02:0003F736 06              	 12806:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003F737 08
02:0003F738 07
02:0003F739 09
02:0003F73A 00
02:0003F73B 00
02:0003F73C 01
02:0003F73D 01
02:0003F73E 02              	 12807:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003F73F 02
02:0003F740 03
02:0003F741 03
02:0003F742 04
02:0003F743 00
02:0003F744 05
