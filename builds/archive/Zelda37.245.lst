                            	  5195: _anon_z04_70:
                            	  5196:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5197:     ; 1. negate the distance
                            	  5198:     ; 2. add 8 to the instruction offset to access
                            	  5199:     ;    the opposite direction for the same wall
                            	  5200:     ;
02:0003BEE8 7600            	  5201:     moveq   #0,D3
02:0003BEEA 162C0098        	  5202:     move.b  ($0098,A4),D3
02:0003BEEE 122C0002        	  5203:     move.b  ($0002,A4),D1
02:0003BEF2 B601            	  5204:     cmp.b   D1,D3
02:0003BEF4 662A            	  5205:     bne  _anon_z04_71
02:0003BEF6 1B00            	  5206:     move.b  D0,-(A5)  ; PHA
02:0003BEF8 41EC0412        	  5207:     lea     ($0412,A4),A0
02:0003BEFC 10302000        	  5208:     move.b  (A0,D2.W),D0
02:0003BF00 023C00EE        	  5209:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF04 123C0008        	  5210:     move.b  #$08,D1
02:0003BF08 D101            	  5211:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BF0A 41EC0412        	  5212:     lea     ($0412,A4),A0
02:0003BF0E 11802000        	  5213:     move.b  D0,(A0,D2.W)
02:0003BF12 101D            	  5214:     move.b  (A5)+,D0  ; PLA
02:0003BF14 4600            	  5215:     eori.b #$FF,D0
02:0003BF16 023C00EE        	  5216:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF1A 123C0001        	  5217:     move.b  #$01,D1
02:0003BF1E D101            	  5218:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5219: _anon_z04_71:
                            	  5220:     ; Add the distance and Link's minor coordinate to calculate
                            	  5221:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5222:     ; In general, the monster will be put in front of Link.
                            	  5223:     ;
02:0003BF20 023C00EE        	  5224:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF24 1214            	  5225:     move.b  ($0000,A4),D1
02:0003BF26 D101            	  5226:     addx.b  D1,D0   ; ADC $00
02:0003BF28 19400004        	  5227:     move.b  D0,($0004,A4)
                            	  5228:     ; By default, will return index 0 to choose the minimum value
                            	  5229:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5230:     ; if Link is at the wall with a smaller major coordinate.
                            	  5231:     ;
02:0003BF2C 7600            	  5232:     moveq   #0,D3
                            	  5233:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5234:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5235:     ; to access the block for the other direction along the same axis,
                            	  5236:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5237:     ;
02:0003BF2E 102C0001        	  5238:     move.b  ($0001,A4),D0
02:0003BF32 122C0003        	  5239:     move.b  ($0003,A4),D1
02:0003BF36 B001            	  5240:     cmp.b   D1,D0
02:0003BF38 671C            	  5241:     beq  _anon_z04_72
02:0003BF3A 41EC0412        	  5242:     lea     ($0412,A4),A0
02:0003BF3E 10302000        	  5243:     move.b  (A0,D2.W),D0
02:0003BF42 023C00EE        	  5244:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF46 123C0010        	  5245:     move.b  #$10,D1
02:0003BF4A D101            	  5246:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BF4C 41EC0412        	  5247:     lea     ($0412,A4),A0
02:0003BF50 11802000        	  5248:     move.b  D0,(A0,D2.W)
02:0003BF54 5203            	  5249:     addq.b  #1,D3
