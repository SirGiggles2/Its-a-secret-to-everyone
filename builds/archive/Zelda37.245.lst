02:0004BFCA 10303000        	  4897:     move.b  (A0,D3.W),D0
02:0004BFCE 1940000C        	  4898:     move.b  D0,($000C,A4)
                            	  4899:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4900:     ;
02:0004BFD2 0C030002        	  4901:     cmpi.b  #$02,D3
02:0004BFD6 6604            	  4902:     bne  _anon_z07_24
02:0004BFD8 522C000F        	  4903:     addq.b  #1,($000F,A4)
                            	  4904: _anon_z07_24:
                            	  4905:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4906:     ;   $57 (sword shot) => $22
