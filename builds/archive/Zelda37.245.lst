02:00045532 6126            	  9068:     jsr     FindAndSelectOccupiedItemSlot
                            	  9069:     ; If the new item slot = old item slot, go cancel the
                            	  9070:     ; "selection changed" tune.
                            	  9071:     ;
                            	  9072:     ;
                            	  9073:     ; Pop selected item slot.
02:00045534 101D            	  9074:     move.b  (A5)+,D0  ; PLA
02:00045536 122C0656        	  9075:     move.b  ($0656,A4),D1
