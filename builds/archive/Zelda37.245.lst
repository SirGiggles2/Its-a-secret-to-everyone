                            	  6365: Digdogger_Move:
                            	  6366:     ; This calculation is the same one used in Manhandla to
                            	  6367:     ; manifest the fractional speed over several frames.
                            	  6368:     ;
                            	  6369:     ; To summarize, the formula is:
                            	  6370:     ;
                            	  6371:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6372:     ;
                            	  6373:     ;   SA := SA + (SL AND $E0)
                            	  6374:     ;   [03] := SH + carry
                            	  6375:     ;
                            	  6376:     ; See 04:A28E Manhandla_Move.
                            	  6377:     ;
02:0003C7A6 41EC041F        	  6378:     lea     ($041F,A4),A0
02:0003C7AA 10302000        	  6379:     move.b  (A0,D2.W),D0
02:0003C7AE 020000E0        	  6380:     andi.b #$E0,D0
02:0003C7B2 023C00EE        	  6381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7B6 41EC0412        	  6382:     lea     ($0412,A4),A0
02:0003C7BA 12302000        	  6383:     move.b  (A0,D2.W),D1
02:0003C7BE D101            	  6384:     addx.b  D1,D0   ; ADC $0412,X
02:0003C7C0 41EC0412        	  6385:     lea     ($0412,A4),A0
02:0003C7C4 11802000        	  6386:     move.b  D0,(A0,D2.W)
                            	  6387:     ; Assign (high speed byte + carry) to [03].
                            	  6388:     ;
02:0003C7C8 41EC042C        	  6389:     lea     ($042C,A4),A0
