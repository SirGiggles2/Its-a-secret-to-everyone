02:0004BF88 1B00            	  4871:     move.b  D0,-(A5)  ; PHA
02:0004BF8A 02000003        	  4872:     andi.b #$03,D0
02:0004BF8E 6712            	  4873:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004BF90 102C0001        	  4874:     move.b  ($0001,A4),D0
02:0004BF94 023C00EE        	  4875:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BF98 123C0003        	  4876:     move.b  #$03,D1
02:0004BF9C D101            	  4877:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004BF9E 19400001        	  4878:     move.b  D0,($0001,A4)
                            	  4879:     even
