02:00044C32 6070            	  7725:     jmp     SelectTransferBufAndDecCounter
                            	  7726: 
                            	  7727: _anon_z05_167:
                            	  7728:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7729:     ; of the big map sheet.
                            	  7730:     ;
02:00044C34 0C000015        	  7731:     cmpi.b  #$15,D0
02:00044C38 6604            	  7732:     bne  _anon_z05_168
02:00044C3A 7042            	  7733:     moveq   #66,D0
02:00044C3C 60F4            	  7734:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  7735: 
