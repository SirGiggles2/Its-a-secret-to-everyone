02:0004CDFC 660C            	  6991:     bne  _anon_z07_39
02:0004CDFE 102C00AC        	  6992:     move.b  ($00AC,A4),D0
02:0004CE02 020000C0        	  6993:     andi.b #$C0,D0
02:0004CE06 194000AC        	  6994:     move.b  D0,($00AC,A4)
