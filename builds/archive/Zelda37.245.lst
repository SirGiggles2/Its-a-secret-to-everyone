02:00039F48 1002            	   714:     move.b  D2,D0
02:00039F4A 41EC042C        	   715:     lea     ($042C,A4),A0
02:00039F4E 11803000        	   716:     move.b  D0,(A0,D3.W)
                            	   717:     ; Have the monster keep track of the shot.
                            	   718:     ;
02:00039F52 1003            	   719:     move.b  D3,D0
02:00039F54 41EC042C        	   720:     lea     ($042C,A4),A0
02:00039F58 11802000        	   721:     move.b  D0,(A0,D2.W)
                            	   722:     ; Set the shot's state to $10, which is the flying state for them.
                            	   723:     ;
02:00039F5C 7010            	   724:     moveq   #16,D0
02:00039F5E 41EC00AC        	   725:     lea     ($00AC,A4),A0
02:00039F62 11803000        	   726:     move.b  D0,(A0,D3.W)
                            	   727:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   728:     ;
02:00039F66 103C00A0        	   729:     move.b  #$A0,D0
02:00039F6A 41EC03BC        	   730:     lea     ($03BC,A4),A0
02:00039F6E 11803000        	   731:     move.b  D0,(A0,D3.W)
                            	   732:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   733:     ;
