02:0003C360 41EC0350        	  5741:     lea     ($0350,A4),A0
02:0003C364 10303000        	  5742:     move.b  (A0,D3.W),D0
02:0003C368 0C000041        	  5743:     cmpi.b  #$41,D0
02:0003C36C 66F0            	  5744:     bne  _anon_z04_80
                            	  5745:     ; I don't know why the object timer of the tail segment that will
                            	  5746:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5747:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5748:     ; there, the object timer is set to 6.
                            	  5749:     ;
02:0003C36E 7011            	  5750:     moveq   #17,D0
02:0003C370 19803029        	  5751:     move.b  D0,($29,A4,D3.W)
                            	  5752:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5753:     ; segment to the tail segment.
                            	  5754:     ;
02:0003C374 41EC04F0        	  5755:     lea     ($04F0,A4),A0
02:0003C378 10302000        	  5756:     move.b  (A0,D2.W),D0
02:0003C37C 41EC04F1        	  5757:     lea     ($04F1,A4),A0
02:0003C380 11803000        	  5758:     move.b  D0,(A0,D3.W)
02:0003C384 10342070        	  5759:     move.b  ($70,A4,D2.W),D0
02:0003C388 19803071        	  5760:     move.b  D0,($71,A4,D3.W)
02:0003C38C 41EC0084        	  5761:     lea     ($0084,A4),A0
02:0003C390 10302000        	  5762:     move.b  (A0,D2.W),D0
02:0003C394 41EC0085        	  5763:     lea     ($0085,A4),A0
02:0003C398 11803000        	  5764:     move.b  D0,(A0,D3.W)
                            	  5765:     ; If the tail segment found is also a head, then
                            	  5766:     ; the last segment has died. Return.
