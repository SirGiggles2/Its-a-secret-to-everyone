02:0003217A 1941000D        	  6580:     move.b  D1,($000D,A4)
02:0003217E 122C000E        	  6581:     move.b  ($000E,A4),D1
02:00032182 E211            	  6582:     roxr.b  #1,D1   ; ROR $0E
02:00032184 1941000E        	  6583:     move.b  D1,($000E,A4)
02:00032188 5303            	  6584:     subq.b  #1,D3
02:0003218A 66E8            	  6585:     bne  _anon_z01_86
