                            	  7406: Dodongo_Draw:
02:0003CF0E 610000F4        	  7407:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7408:     ; Make a 5-way direction index out of the facing direction
                            	  7409:     ; by shifting right once, and store it in [00].
                            	  7410:     ;
02:0003CF12 41EC0098        	  7411:     lea     ($0098,A4),A0
02:0003CF16 10302000        	  7412:     move.b  (A0,D2.W),D0
02:0003CF1A E208            	  7413:     lsr.b  #1,D0   ; LSR A
02:0003CF1C 1880            	  7414:     move.b  D0,($0000,A4)
                            	  7415:     ; If state = 0, go handle animating the two frames of this state.
                            	  7416:     ;
02:0003CF1E 7600            	  7417:     moveq   #0,D3
02:0003CF20 41EC00AC        	  7418:     lea     ($00AC,A4),A0
02:0003CF24 16302000        	  7419:     move.b  (A0,D2.W),D3
02:0003CF28 6744            	  7420:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7421:     ; If state > 1, then the monster is stunned (state 2).
                            	  7422:     ; So, go switch frames every $20 screen frames.
                            	  7423:     ;
02:0003CF2A 7020            	  7424:     moveq   #32,D0
02:0003CF2C 5303            	  7425:     subq.b  #1,D3
02:0003CF2E 6640            	  7426:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7427:     ; State = 1. Bloated.
                            	  7428:     ;
                            	  7429:     ; In substate 0, go animate as usual for walking.
                            	  7430:     ;
02:0003CF30 7600            	  7431:     moveq   #0,D3
02:0003CF32 41EC042C        	  7432:     lea     ($042C,A4),A0
02:0003CF36 16302000        	  7433:     move.b  (A0,D2.W),D3
02:0003CF3A 6732            	  7434:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7435:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7436:     ; go fade the boss; so that some frames are not drawn.
                            	  7437:     ;
02:0003CF3C 0C030002        	  7438:     cmpi.b  #$02,D3
02:0003CF40 6718            	  7439:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CF42 0C030003        	  7440:     cmpi.b  #$03,D3
02:0003CF46 6712            	  7441:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7442:     ; State 1, substate 1
                            	  7443:     ;
                            	  7444:     ; Add $14 to the frame image index to index into the bloated
                            	  7445:     ; frame images and H-flips.
                            	  7446:     ;
02:0003CF48 1014            	  7447:     move.b  ($0000,A4),D0
02:0003CF4A 023C00EE        	  7448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF4E 123C0014        	  7449:     move.b  #$14,D1
02:0003CF52 D101            	  7450:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CF54 7600            	  7451:     moveq   #0,D3
02:0003CF56 1600            	  7452:     move.b  D0,D3
02:0003CF58 6032            	  7453:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7454: 
                            	  7455:     even
                            	  7456: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7457:     ; In bloated substates 2 and 3:
                            	  7458:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7459:     ;
02:0003CF5A 102C0015        	  7460:     move.b  ($0015,A4),D0
02:0003CF5E 02000002        	  7461:     andi.b #$02,D0
02:0003CF62 6604            	  7462:     bne.s  __far_z_04_0066
02:0003CF64 600000A4        	  7463:     jmp  L11B00_Exit
                            	  7464: __far_z_04_0066:
02:0003CF68 7600            	  7465:     moveq   #0,D3
02:0003CF6A 1614            	  7466:     move.b  ($0000,A4),D3
02:0003CF6C 601E            	  7467:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7468: 
                            	  7469:     even
                            	  7470: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7471:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7472:     ;
02:0003CF6E 7008            	  7473:     moveq   #8,D0
                            	  7474:     even
                            	  7475: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CF70 7600            	  7476:     moveq   #0,D3
02:0003CF72 1614            	  7477:     move.b  ($0000,A4),D3
02:0003CF74 122C0015        	  7478:     move.b  ($0015,A4),D1
02:0003CF78 C001            	  7479:     and.b  D1,D0
02:0003CF7A 6710            	  7480:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7481:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7482:     ; in order to index into the second set of frame image numbers.
                            	  7483:     ;
02:0003CF7C 1003            	  7484:     move.b  D3,D0
02:0003CF7E 023C00EE        	  7485:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF82 123C0005        	  7486:     move.b  #$05,D1
02:0003CF86 D101            	  7487:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CF88 7600            	  7488:     moveq   #0,D3
02:0003CF8A 1600            	  7489:     move.b  D0,D3
                            	  7490:     even
                            	  7491: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7492:     ; Start preparing sprites.
                            	  7493:     ;
02:0003CF8C 4EB90004CDA8    	  7494:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CF92 1003            	  7495:     move.b  D3,D0
02:0003CF94 1B00            	  7496:     move.b  D0,-(A5)  ; PHA
                            	  7497:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7498:     ;
02:0003CF96 41F90003CEF0    	  7499:     lea     (DodongoFrameHFlips).l,A0
02:0003CF9C 10303000        	  7500:     move.b  (A0,D3.W),D0
02:0003CFA0 1940000F        	  7501:     move.b  D0,($000F,A4)
02:0003CFA4 41F90003CEE6    	  7502:     lea     (DodongoFrameImages).l,A0
02:0003CFAA 10303000        	  7503:     move.b  (A0,D3.W),D0
                            	  7504:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7505:     ; They are drawn mirrored.
                            	  7506:     ;
02:0003CFAE 0C000007        	  7507:     cmpi.b  #$07,D0
02:0003CFB2 6706            	  7508:     beq  _anon_z04_92
02:0003CFB4 0C000009        	  7509:     cmpi.b  #$09,D0
02:0003CFB8 6608            	  7510:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7511: _anon_z04_92:
02:0003CFBA 4EB900031B2E    	  7512:     jsr     DrawObjectMirrored
02:0003CFC0 6006            	  7513:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7514: 
                            	  7515:     even
                            	  7516: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7517:     ; No other frame images are mirrored.
                            	  7518:     ;
02:0003CFC2 4EB900031B32    	  7519:     jsr     DrawObjectNotMirrored
                            	  7520:     even
                            	  7521: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CFC8 101D            	  7522:     move.b  (A5)+,D0  ; PLA
02:0003CFCA 7600            	  7523:     moveq   #0,D3
02:0003CFCC 1600            	  7524:     move.b  D0,D3
                            	  7525:     ; If facing vertically, then return. There's no other side to draw.
                            	  7526:     ;
02:0003CFCE 41EC0098        	  7527:     lea     ($0098,A4),A0
02:0003CFD2 10302000        	  7528:     move.b  (A0,D2.W),D0
02:0003CFD6 02000003        	  7529:     andi.b #$03,D0
02:0003CFDA 6602            	  7530:     bne.s  __far_z_04_0067
02:0003CFDC 602C            	  7531:     jmp  L11B00_Exit
                            	  7532: __far_z_04_0067:
                            	  7533:     ; Else draw the right side.
                            	  7534:     ;
                            	  7535:     ; Keep the Y coordinate in [01].
                            	  7536:     ; But, store (X + $10) in [00].
                            	  7537:     ;
02:0003CFDE 10342070        	  7538:     move.b  ($70,A4,D2.W),D0
02:0003CFE2 023C00EE        	  7539:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFE6 123C0010        	  7540:     move.b  #$10,D1
02:0003CFEA D101            	  7541:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CFEC 1880            	  7542:     move.b  D0,($0000,A4)
02:0003CFEE 6114            	  7543:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7544:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7545:     ;
                            	  7546:     ; So, if we had animation frame 1, direction left:
                            	  7547:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7548:     ; - frame image index = 6 (1 + 5)
                            	  7549:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7550:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7551:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7552:     ;
                            	  7553:     ; So, 3 would have been the frame number used above for
                            	  7554:     ; the left side.
                            	  7555:     ;
                            	  7556:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7557:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7558:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7559:     ; on the right.
                            	  7560:     ;
02:0003CFF0 41F90003CEE6    	  7561:     lea     (DodongoFrameImages).l,A0
02:0003CFF6 10303000        	  7562:     move.b  (A0,D3.W),D0
02:0003CFFA 0A000001        	  7563:     eori.b #$01,D0
02:0003CFFE 4EF900031B32    	  7564:     jmp     DrawObjectNotMirrored
                            	  7565: 
                            	  7566: ; Returns:
                            	  7567: ; A: 3
                            	  7568: ; [04]: left sprite attributes
                            	  7569: ; [05]: right sprite attributes
                            	  7570: ;
                            	  7571:     even
                            	  7572: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003D004 4EF90002C312    	  7573:     jmp     c_anim_set_sprite_desc_level_palette_row
