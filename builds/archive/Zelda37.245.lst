                            	  2959: UpdateTrap_Full:
02:00030748 41EC00AC        	  2960:     lea     ($00AC,A4),A0
02:0003074C 10302000        	  2961:     move.b  (A0,D2.W),D0
02:00030750 660000B2        	  2962:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2963:     ; State 0. Sensing.
                            	  2964:     ;
                            	  2965:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2966:     ; then go see if the horizontal distance is shorter.
                            	  2967:     ;
02:00030754 102C0084        	  2968:     move.b  ($0084,A4),D0
02:00030758 003C0011        	  2969:     ori     #$11,CCR  ; SEC: set C+X
02:0003075C 41EC0084        	  2970:     lea     ($0084,A4),A0
02:00030760 12302000        	  2971:     move.b  (A0,D2.W),D1
02:00030764 0A3C0010        	  2972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030768 9101            	  2973:     subx.b  D1,D0   ; SBC ObjY,X
02:0003076A 0A3C0010        	  2974:     eori    #$10,CCR  ; restore X = 6502 C
02:0003076E 6100086E        	  2975:     jsr     Abs
02:00030772 0C00000E        	  2976:     cmpi.b  #$0E,D0
02:00030776 644C            	  2977:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2978:     ; Determine the horizontal direction toward Link;
                            	  2979:     ; and if Link and the trap are at the same X, then we can't move
                            	  2980:     ; along this axis. Go see about moving vertically.
                            	  2981:     ;
02:00030778 7601            	  2982:     moveq   #1,D3
02:0003077A 102C0070        	  2983:     move.b  ($0070,A4),D0
02:0003077E 12342070        	  2984:     move.b  ($70,A4,D2.W),D1
02:00030782 B001            	  2985:     cmp.b   D1,D0
02:00030784 673E            	  2986:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030786 6402            	  2987:     bcc  _anon_z01_26
02:00030788 7602            	  2988:     moveq   #2,D3
                            	  2989: _anon_z01_26:
                            	  2990:     ; Remember the original X coordinate.
                            	  2991:     ;
02:0003078A 10342070        	  2992:     move.b  ($70,A4,D2.W),D0
                            	  2993:     even
                            	  2994: _L_z01_UpdateTrap_Full_GoToState1:
02:0003078E 41EC0380        	  2995:     lea     ($0380,A4),A0
02:00030792 11802000        	  2996:     move.b  D0,(A0,D2.W)
                            	  2997:     ; Set facing direction to the horizontal one that we determined.
                            	  2998:     ;
02:00030796 1003            	  2999:     move.b  D3,D0
02:00030798 41EC0098        	  3000:     lea     ($0098,A4),A0
02:0003079C 11802000        	  3001:     move.b  D0,(A0,D2.W)
                            	  3002:     ; If the direction we determined is not allowed for this trap, then
                            	  3003:     ; go draw and check collisions.
                            	  3004:     ;
02:000307A0 41F900030741    	  3005:     lea     (TrapAllowedDirs-1).l,A0
02:000307A6 12302000        	  3006:     move.b  (A0,D2.W),D1
02:000307AA C001            	  3007:     and.b  D1,D0
02:000307AC 6712            	  3008:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3009:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  3010:     ;
02:000307AE 41EC00AC        	  3011:     lea     ($00AC,A4),A0
02:000307B2 52302000        	  3012:     addq.b  #1,(A0,D2.W)
02:000307B6 7070            	  3013:     moveq   #112,D0
02:000307B8 41EC03BC        	  3014:     lea     ($03BC,A4),A0
02:000307BC 11802000        	  3015:     move.b  D0,(A0,D2.W)
                            	  3016:     even
                            	  3017: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:000307C0 60000102        	  3018:     jmp     L_Trap_DrawAndCheckCollisions
                            	  3019: 
                            	  3020:     even
                            	  3021: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3022:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3023:     ; then this trap definitely wasn't triggered.
                            	  3024:     ; Go draw and check collisions.
                            	  3025:     ;
02:000307C4 102C0070        	  3026:     move.b  ($0070,A4),D0
02:000307C8 003C0011        	  3027:     ori     #$11,CCR  ; SEC: set C+X
02:000307CC 12342070        	  3028:     move.b  ($70,A4,D2.W),D1
02:000307D0 0A3C0010        	  3029:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000307D4 9101            	  3030:     subx.b  D1,D0   ; SBC ObjX,X
02:000307D6 0A3C0010        	  3031:     eori    #$10,CCR  ; restore X = 6502 C
02:000307DA 61000802        	  3032:     jsr     Abs
02:000307DE 0C00000E        	  3033:     cmpi.b  #$0E,D0
02:000307E2 64DC            	  3034:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3035:     ; Determine the vertical direction toward Link;
                            	  3036:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3037:     ; along this axis. Go draw and check object collisions.
                            	  3038:     ;
02:000307E4 7604            	  3039:     moveq   #4,D3
02:000307E6 102C0084        	  3040:     move.b  ($0084,A4),D0
02:000307EA 41EC0084        	  3041:     lea     ($0084,A4),A0
02:000307EE 12302000        	  3042:     move.b  (A0,D2.W),D1
02:000307F2 B001            	  3043:     cmp.b   D1,D0
02:000307F4 67CA            	  3044:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000307F6 6402            	  3045:     bcc  _anon_z01_27
02:000307F8 7608            	  3046:     moveq   #8,D3
                            	  3047: _anon_z01_27:
                            	  3048:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3049:     ; set the vertical direction we determined, and other preparations.
                            	  3050:     ;
02:000307FA 41EC0084        	  3051:     lea     ($0084,A4),A0
02:000307FE 10302000        	  3052:     move.b  (A0,D2.W),D0
02:00030802 668A            	  3053:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  3054:     even
                            	  3055: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3056:     ; State 1 and 2.
                            	  3057:     ;
                            	  3058:     ; Move in the direction it's facing.
                            	  3059:     ;
02:00030804 41EC0098        	  3060:     lea     ($0098,A4),A0
02:00030808 10302000        	  3061:     move.b  (A0,D2.W),D0
02:0003080C 1940000F        	  3062:     move.b  D0,($000F,A4)
02:00030810 4EB90004BA30    	  3063:     jsr     MoveObject
                            	  3064:     ; Truncate the grid offset to square length ($10).
                            	  3065:     ;
02:00030816 41EC0394        	  3066:     lea     ($0394,A4),A0
02:0003081A 10302000        	  3067:     move.b  (A0,D2.W),D0
02:0003081E 0200000F        	  3068:     andi.b #$0F,D0
02:00030822 6608            	  3069:     bne  _anon_z01_28
02:00030824 41EC0394        	  3070:     lea     ($0394,A4),A0
02:00030828 11802000        	  3071:     move.b  D0,(A0,D2.W)
                            	  3072: _anon_z01_28:
                            	  3073:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3074:     ;
02:0003082C 610017CA        	  3075:     jsr     CheckLinkCollision
                            	  3076:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3077:     ; and current coordinate to the trap's X.
                            	  3078:     ;
02:00030830 7600            	  3079:     moveq   #0,D3
02:00030832 16342070        	  3080:     move.b  ($70,A4,D2.W),D3
02:00030836 7078            	  3081:     moveq   #120,D0
02:00030838 1880            	  3082:     move.b  D0,($0000,A4)
02:0003083A 41EC0098        	  3083:     lea     ($0098,A4),A0
02:0003083E 10302000        	  3084:     move.b  (A0,D2.W),D0
02:00030842 0200000C        	  3085:     andi.b #$0C,D0
02:00030846 6710            	  3086:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3087:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3088:     ; and current coordinate to the trap's Y.
                            	  3089:     ;
02:00030848 7600            	  3090:     moveq   #0,D3
02:0003084A 41EC0084        	  3091:     lea     ($0084,A4),A0
02:0003084E 16302000        	  3092:     move.b  (A0,D2.W),D3
02:00030852 103C0090        	  3093:     move.b  #$90,D0
02:00030856 1880            	  3094:     move.b  D0,($0000,A4)
                            	  3095:     even
                            	  3096: _L_z01_UpdateTrap_Full_Finish:
                            	  3097:     ; If in state 2, then go finish handling it.
