                            	  7975:     ; In UW. There are two input directions, and they're both walkable.
                            	  7976:     ;
                            	  7977:     ; Normally, turn to the direction that's perpendicular to object
                            	  7978:     ; direction. But keep going straight after that, while diagonal
                            	  7979:     ; input is held.
                            	  7980:     ;
                            	  7981:     ; Handle special cases for doors.
                            	  7982:     ;
                            	  7983:     ;
                            	  7984:     ; 1. Link at horizontal doors.
                            	  7985:     ;
                            	  7986:     ; If Link's X = $20 or $D0 then
                            	  7987:     ;   If Link's Y = $85 and facing down then
