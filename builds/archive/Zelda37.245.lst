02:00041A88 4EB900030FDA    	  2909:     jsr     GetOppositeDir
                            	  2910: _anon_z05_75:
                            	  2911:     ; If in UW, use the second set of bounds by adding 4
                            	  2912:     ; to reverse direction index.
                            	  2913:     ;
                            	  2914:     ; Else in OW, and use first set that begins at offset 0.
                            	  2915:     ;
02:00041A8E 102C0010        	  2916:     move.b  ($0010,A4),D0
02:00041A92 6710            	  2917:     beq  _anon_z05_76
02:00041A94 1003            	  2918:     move.b  D3,D0
02:00041A96 023C00EE        	  2919:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A9A 123C0004        	  2920:     move.b  #$04,D1
02:00041A9E D101            	  2921:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041AA0 7600            	  2922:     moveq   #0,D3
02:00041AA2 1600            	  2923:     move.b  D0,D3
                            	  2924: _anon_z05_76:
                            	  2925:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2926:     ;
02:00041AA4 7000            	  2927:     moveq   #0,D0
                            	  2928: ; Params:
                            	  2929: ; A: mask of buttons to block
                            	  2930: ; Y: offset into BorderBounds
                            	  2931: ; [00]: direction
                            	  2932: ; [02]: coordinate
                            	  2933: ;
                            	  2934: ; Returns:
                            	  2935: ; [01]: button mask that was used
                            	  2936: ;       (set to $FF if boundary not crossed)
                            	  2937: ;
                            	  2938:     even
                            	  2939: MaskInputInBorder:
