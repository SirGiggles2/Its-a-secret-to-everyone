                            	  5799: Moldorm_Chase:
                            	  5800:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5801:     ; Only the head controls the movement direction.
                            	  5802:     ;
02:0003C3D8 0C020005        	  5803:     cmpi.b  #$05,D2
02:0003C3DC 670A            	  5804:     beq  _anon_z04_81
02:0003C3DE 0C02000A        	  5805:     cmpi.b  #$0A,D2
