02:00039F74 41EC0380        	   735:     lea     ($0380,A4),A0
02:00039F78 11803000        	   736:     move.b  D0,(A0,D3.W)
                            	   737:     ; Make it autonomous (ready to update on its own).
                            	   738:     ;
02:00039F7C 7000            	   739:     moveq   #0,D0
02:00039F7E 41EC0405        	   740:     lea     ($0405,A4),A0
02:00039F82 11803000        	   741:     move.b  D0,(A0,D3.W)
                            	   742:     ; The first animation frame lasts 3 screen frames.
