02:0003B146 41EC0098        	  3265:     lea     ($0098,A4),A0
02:0003B14A 11802000        	  3266:     move.b  D0,(A0,D2.W)
                            	  3267:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3268:     ;
02:0003B14E 10342019        	  3269:     move.b  ($19,A4,D2.W),D0
02:0003B152 0C0000C0        	  3270:     cmpi.b  #$C0,D0
02:0003B156 6506            	  3271:     bcs  _anon_z04_43
02:0003B158 4EB90004BC88    	  3272:     jsr     ReverseObjDir
                            	  3273: _anon_z04_43:
                            	  3274:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3275:     ;
02:0003B15E 41EC0098        	  3276:     lea     ($0098,A4),A0
