                            	  6628: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6629:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6630:     ;   full heart=4 partial heart=$70
                            	  6631:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6632:     ; But the method here yields $3EF, because partial heart is
                            	  6633:     ; considered full when = $FF instead of $100.
                            	  6634:     ;
02:000321EC 102C000E        	  6635:     move.b  ($000E,A4),D0
02:000321F0 003C0011        	  6636:     ori     #$11,CCR  ; SEC: set C+X
02:000321F4 122C0670        	  6637:     move.b  ($0670,A4),D1
02:000321F8 0A3C0010        	  6638:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000321FC 9101            	  6639:     subx.b  D1,D0   ; SBC HeartPartial
02:000321FE 0A3C0010        	  6640:     eori    #$10,CCR  ; restore X = 6502 C
02:00032202 1940000E        	  6641:     move.b  D0,($000E,A4)
02:00032206 102C066F        	  6642:     move.b  ($066F,A4),D0
02:0003220A 0200000F        	  6643:     andi.b #$0F,D0
02:0003220E 6710            	  6644:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00032210 532C066F        	  6645:     subq.b  #1,($066F,A4)
02:00032214 103C00FF        	  6646:     move.b  #$FF,D0
02:00032218 19400670        	  6647:     move.b  D0,($0670,A4)
02:0003221C 6600FF6E        	  6648:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6649:     even
