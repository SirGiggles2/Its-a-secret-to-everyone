02:00036E4C 7006            	  5358:     moveq   #6,D0
                            	  5359: _anon_z02_49:
                            	  5360:     ; If the VRAM line number has not just been incremented to
                            	  5361:     ; the reference line number count, then go write NT attributes.
                            	  5362:     ;
02:00036E4E 122C050D        	  5363:     move.b  ($050D,A4),D1
02:00036E52 B001            	  5364:     cmp.b   D1,D0
