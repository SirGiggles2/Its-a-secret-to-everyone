02:0003A5B8 41EC0084        	  1572:     lea     ($0084,A4),A0
02:0003A5BC 10302000        	  1573:     move.b  (A0,D2.W),D0
02:0003A5C0 0200000F        	  1574:     andi.b #$0F,D0
02:0003A5C4 0C00000D        	  1575:     cmpi.b  #$0D,D0
02:0003A5C8 6602            	  1576:     bne  _anon_z04_26
02:0003A5CA 7603            	  1577:     moveq   #3,D3
                            	  1578: _anon_z04_26:
02:0003A5CC 1883            	  1579:     move.b  D3,($0000,A4)
                            	  1580:     ; If horizontally aligned with the square grid, then
                            	  1581:     ; use a vertical direction mask ($C).
                            	  1582:     ;
02:0003A5CE 7600            	  1583:     moveq   #0,D3
02:0003A5D0 10342070        	  1584:     move.b  ($70,A4,D2.W),D0
02:0003A5D4 0200000F        	  1585:     andi.b #$0F,D0
02:0003A5D8 6602            	  1586:     bne  _anon_z04_27
02:0003A5DA 760C            	  1587:     moveq   #12,D3
                            	  1588: _anon_z04_27:
02:0003A5DC 1003            	  1589:     move.b  D3,D0
                            	  1590:     ; Combine the two masks. At most one will be 0.
                            	  1591:     ;
02:0003A5DE 1214            	  1592:     move.b  ($0000,A4),D1
02:0003A5E0 8001            	  1593:     or.b  D1,D0
                            	  1594:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1595:     ; with the grid.
                            	  1596:     ;
                            	  1597:     ; If so, then go to state 1 to do a "big shove".
                            	  1598:     ; Else go to state 2, to immediately split in two.
                            	  1599:     ;
                            	  1600:     ; Examples:
                            	  1601:     ; It would be aligned, if moving left along a tile as usual.
                            	  1602:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1603:     ; - The collision check routines would have made the zol
                            	  1604:     ;   face in the direction of the weapon.
                            	  1605:     ; - See CheckMonsterWeaponCollision.
                            	  1606:     ;
02:0003A5E2 122C0098        	  1607:     move.b  ($0098,A4),D1
02:0003A5E6 C001            	  1608:     and.b  D1,D0
02:0003A5E8 6608            	  1609:     bne  _anon_z04_28
02:0003A5EA 41EC00AC        	  1610:     lea     ($00AC,A4),A0
02:0003A5EE 52302000        	  1611:     addq.b  #1,(A0,D2.W)
