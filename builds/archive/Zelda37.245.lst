                            	  5720:     ; dead segment. This way, moldorm heads are always rooted
                            	  5721:     ; in slots 5 and $A; and the segments are continguous.
                            	  5722:     ;
                            	  5723:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5724:     ;
                            	  5725:     ; Note that this is not a true swap, because the tail's HP
                            	  5726:     ; might be less than $20.
                            	  5727:     ;
02:0003C344 7020            	  5728:     moveq   #32,D0
02:0003C346 41EC0485        	  5729:     lea     ($0485,A4),A0
02:0003C34A 11802000        	  5730:     move.b  D0,(A0,D2.W)
02:0003C34E 61000608        	  5731:     jsr     CheckBossHitReaction
                            	  5732:     ; Look for the tail segment, starting from the low end
                            	  5733:     ; of the chain that this dead segment belongs to.
                            	  5734:     ;
02:0003C352 163C00FF        	  5735:     move.b  #$FF,D3
02:0003C356 0C020006        	  5736:     cmpi.b  #$06,D2
02:0003C35A 6502            	  5737:     bcs  _anon_z04_80
02:0003C35C 7604            	  5738:     moveq   #4,D3
                            	  5739: _anon_z04_80:
