                            	  7962:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7963:     ; object direction and input direction to last walkable direction
                            	  7964:     ; found, and set Link's speed.
                            	  7965:     ;
                            	  7966:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7967:     ;
02:00044D7C 7400            	  7968:     moveq   #0,D2
02:00044D7E 102C000D        	  7969:     move.b  ($000D,A4),D0
