02:0003F62C 700D            	 12677:     moveq   #13,D0
                            	 12678: _anon_z04_163:
02:0003F62E 7600            	 12679:     moveq   #0,D3
02:0003F630 1943000F        	 12680:     move.b  D3,($000F,A4)
02:0003F634 4EB900031B2E    	 12681:     jsr     DrawObjectMirrored
