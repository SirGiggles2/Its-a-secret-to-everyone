02:0003F502 41EC00AC        	 12519:     lea     ($00AC,A4),A0
02:0003F506 10302000        	 12520:     move.b  (A0,D2.W),D0
02:0003F50A 0C000030        	 12521:     cmpi.b  #$30,D0
02:0003F50E 6502            	 12522:     bcs.s  __far_z_04_0122
