                            	  2161: 
                            	  2162: ;==============================================================================
                            	  2163: ; EXPORT side — carry-returning shims.
                            	  2164: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2165: ; reproduces the original function's carry normalization.
                            	  2166: ;==============================================================================
                            	  2167: 
                            	  2168: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2169: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2170:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2171:     btst    #8,D0
02:0002BF8E 670A            	  2172:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2173:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2174:     eori    #$01,CCR
02:0002BF98 4E75            	  2175:     rts
                            	  2176: .cc_cnr:
02:0002BF9A 023C00FE        	  2177:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2178:     eori    #$01,CCR
02:0002BFA2 4E75            	  2179:     rts
                            	  2180: 
                            	  2181: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2182: c_copy_next_row_advance_submode:
02:0002BFA4 4EB900000000    	  2183:     jsr     z05_copy_next_row_advance_submode
02:0002BFAA 08000008        	  2184:     btst    #8,D0
