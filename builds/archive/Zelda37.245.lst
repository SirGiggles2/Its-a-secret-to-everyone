                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:0004039A 103C00FD        	   447:     move.b  #$FD,D0
02:0004039E 613A            	   448:     jsr     MovePositionMarkers
02:000403A0 102C00FC        	   449:     move.b  ($00FC,A4),D0
02:000403A4 023C00EE        	   450:     andi    #$EE,CCR  ; CLC: clear C+X
02:000403A8 123C0003        	   451:     move.b  #$03,D1
02:000403AC D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000403AE 194000FC        	   453:     move.b  D0,($00FC,A4)
