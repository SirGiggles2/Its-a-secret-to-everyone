02:00043A6A 0A3C0010        	  6013:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A6E 9101            	  6014:     subx.b  D1,D0   ; SBC $03
02:00043A70 0A3C0010        	  6015:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6016:     ; Call this to put the address of door face tiles in [02:03].
                            	  6017:     ;
02:00043A74 6100FD7A        	  6018:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6019:     ; Return the address of the door in the nametable in [01:00].
