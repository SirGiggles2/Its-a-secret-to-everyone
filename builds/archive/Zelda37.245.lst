                            	  9827: _L_z04_UpdateGohma_AnimateEye:
                            	  9828:     ; Animate the eye.
                            	  9829:     ;
                            	  9830:     ; First, if the counter for when to open the eye next = 0, then
                            	  9831:     ; set it to a random value at least $C0; and set the timer for
                            	  9832:     ; keeping the eye open to $80.
                            	  9833:     ;
                            	  9834:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9835:     ; every other frame.
                            	  9836:     ;
02:0003E15A 41EC042C        	  9837:     lea     ($042C,A4),A0
02:0003E15E 10302000        	  9838:     move.b  (A0,D2.W),D0
02:0003E162 661E            	  9839:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003E164 103C0080        	  9840:     move.b  #$80,D0
02:0003E168 41EC0444        	  9841:     lea     ($0444,A4),A0
02:0003E16C 11802000        	  9842:     move.b  D0,(A0,D2.W)
02:0003E170 103C00C0        	  9843:     move.b  #$C0,D0
02:0003E174 12342018        	  9844:     move.b  ($18,A4,D2.W),D1
02:0003E178 8001            	  9845:     or.b  D1,D0
02:0003E17A 41EC042C        	  9846:     lea     ($042C,A4),A0
02:0003E17E 11802000        	  9847:     move.b  D0,(A0,D2.W)
                            	  9848:     even
