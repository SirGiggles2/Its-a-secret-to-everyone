02:0004BFA2 101D            	  4881:     move.b  (A5)+,D0  ; PLA
                            	  4882:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4883:     ; This makes the shot flash by cycling all the palettes, one each frame.
