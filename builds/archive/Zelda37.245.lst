                            	  6757: Aquamentus_Draw:
                            	  6758:     ; Every $10 screen frames, switch animation frames.
                            	  6759:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6760:     ; The last tile of frame 0 is at index 5.
                            	  6761:     ; The last tile of frame 1 is at index $B.
                            	  6762:     ;
02:0003CAA8 7605            	  6763:     moveq   #5,D3
02:0003CAAA 102C0015        	  6764:     move.b  ($0015,A4),D0
02:0003CAAE 02000010        	  6765:     andi.b #$10,D0
02:0003CAB2 6602            	  6766:     bne  _anon_z04_88
02:0003CAB4 760B            	  6767:     moveq   #11,D3
                            	  6768: _anon_z04_88:
02:0003CAB6 1943000A        	  6769:     move.b  D3,($000A,A4)
