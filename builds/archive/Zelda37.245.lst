02:0003D5A2 023C00EE        	  8245:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D5A6 41EC03E4        	  8246:     lea     ($03E4,A4),A0
02:0003D5AA 12302000        	  8247:     move.b  (A0,D2.W),D1
