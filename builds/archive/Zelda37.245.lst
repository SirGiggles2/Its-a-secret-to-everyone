                            	  5774: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5775:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5776:     ; We need to remember how many tiles need to be copied
                            	  5777:     ; in each transfer record.
                            	  5778:     ;
02:000438D8 102C0006        	  5779:     move.b  ($0006,A4),D0
02:000438DC 19400004        	  5780:     move.b  D0,($0004,A4)
                            	  5781:     ; Write the transfer record header for the door.
                            	  5782:     ;
                            	  5783:     ;
                            	  5784:     ; VRAM address high byte of door
02:000438E0 1014            	  5785:     move.b  ($0000,A4),D0
02:000438E2 41EC0302        	  5786:     lea     ($0302,A4),A0
02:000438E6 11802000        	  5787:     move.b  D0,(A0,D2.W)
02:000438EA 5202            	  5788:     addq.b  #1,D2
02:000438EC 102C0001        	  5789:     move.b  ($0001,A4),D0
02:000438F0 41EC0302        	  5790:     lea     ($0302,A4),A0
02:000438F4 11802000        	  5791:     move.b  D0,(A0,D2.W)
02:000438F8 5202            	  5792:     addq.b  #1,D2
02:000438FA 102C0006        	  5793:     move.b  ($0006,A4),D0
02:000438FE 41EC0302        	  5794:     lea     ($0302,A4),A0
02:00043902 11802000        	  5795:     move.b  D0,(A0,D2.W)
02:00043906 5202            	  5796:     addq.b  #1,D2
                            	  5797: _anon_z05_121:
                            	  5798:     ; Write two tiles in a short loop indexed by [04].
                            	  5799:     ;
02:00043908 6100ED1C        	  5800:     jsr     WriteDoorFaceTileHorizontally
02:0004390C 66FA            	  5801:     bne  _anon_z05_121
                            	  5802:     ; OR the low VRAM address with $20 to go down one row
                            	  5803:     ; in order to work on the second row of door tiles.
                            	  5804:     ;
02:0004390E 7020            	  5805:     moveq   #32,D0
02:00043910 122C0001        	  5806:     move.b  ($0001,A4),D1
02:00043914 8001            	  5807:     or.b  D1,D0
02:00043916 19400001        	  5808:     move.b  D0,($0001,A4)
                            	  5809:     ; Bottom of the loop.
                            	  5810:     ; Loop again to write the second transfer record for the
                            	  5811:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5812:     ;
02:0004391A 532C0005        	  5813:     subq.b  #1,($0005,A4)
02:0004391E 66B8            	  5814:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5815:     ; Write the end marker, and update buffer length.
                            	  5816:     ;
02:00043920 103C00FF        	  5817:     move.b  #$FF,D0
02:00043924 41EC0302        	  5818:     lea     ($0302,A4),A0
02:00043928 11802000        	  5819:     move.b  D0,(A0,D2.W)
02:0004392C 1002            	  5820:     move.b  D2,D0
02:0004392E 19400301        	  5821:     move.b  D0,($0301,A4)
                            	  5822:     ; Increment the command.
                            	  5823:     ;
02:00043932 522C0054        	  5824:     addq.b  #1,($0054,A4)
                            	  5825:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5826:     ; and resetting the door command.
                            	  5827:     ; This ends up catching original states 3 and 7.
                            	  5828:     ;
                            	  5829:     ; Else set door timer to 8 and return.
                            	  5830:     ;
02:00043936 102C0054        	  5831:     move.b  ($0054,A4),D0
02:0004393A 02000003        	  5832:     andi.b #$03,D0
02:0004393E 6708            	  5833:     beq  _anon_z05_122
02:00043940 7008            	  5834:     moveq   #8,D0
02:00043942 19400027        	  5835:     move.b  D0,($0027,A4)
02:00043946 4E75            	  5836:     rts
