02:0003B166 0200000C        	  3278:     andi.b #$0C,D0
02:0003B16A 6742            	  3279:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3280:     ; Begin with the leever's X set to Link's X.
                            	  3281:     ;
