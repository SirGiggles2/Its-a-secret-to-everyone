02:00042244 B001            	  4092:     cmp.b   D1,D0
02:00042246 6620            	  4093:     bne  _anon_z05_96
02:00042248 102C0001        	  4094:     move.b  ($0001,A4),D0
02:0004224C 41F9000421A4    	  4095:     lea     (DoorwayBoundsMinUnder).l,A0
02:00042252 12303000        	  4096:     move.b  (A0,D3.W),D1
02:00042256 B001            	  4097:     cmp.b   D1,D0
02:00042258 650E            	  4098:     bcs  _anon_z05_96
02:0004225A 41F9000421A8    	  4099:     lea     (DoorwayBoundsMaxUnder).l,A0
02:00042260 12303000        	  4100:     move.b  (A0,D3.W),D1
02:00042264 B001            	  4101:     cmp.b   D1,D0
02:00042266 6506            	  4102:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4103: _anon_z05_96:
