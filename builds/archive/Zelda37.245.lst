                            	  7118:     ;
02:000444F0 41EC0084        	  7119:     lea     ($0084,A4),A0
02:000444F4 10302000        	  7120:     move.b  (A0,D2.W),D0
02:000444F8 020000F0        	  7121:     andi.b #$F0,D0
                            	  7122:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7123:     ; the height of each row.
                            	  7124:     ;
02:000444FC 003C0011        	  7125:     ori     #$11,CCR  ; SEC: set C+X
02:00044500 123C0040        	  7126:     move.b  #$40,D1
02:00044504 0A3C0010        	  7127:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044508 9101            	  7128:     subx.b  D1,D0   ; SBC #$40
02:0004450A 0A3C0010        	  7129:     eori    #$10,CCR  ; restore X = 6502 C
02:0004450E E208            	  7130:     lsr.b  #1,D0   ; LSR A
02:00044510 E208            	  7131:     lsr.b  #1,D0   ; LSR A
02:00044512 E208            	  7132:     lsr.b  #1,D0   ; LSR A
                            	  7133:     ; Add this row offset to the column address.
                            	  7134:     ;
02:00044514 4EB900031432    	  7135:     jsr     AddToInt16At0
                            	  7136:     ; Assume that we'll write a type 1 square with primary square
                            	  7137:     ; taken from [05]. If so, the square index doesn't matter
                            	  7138:     ; as long as >= $10. See WriteSquareOW.
                            	  7139:     ;
02:0004451A 7600            	  7140:     moveq   #0,D3
02:0004451C 7410            	  7141:     moveq   #16,D2
02:0004451E 102C0005        	  7142:     move.b  ($0005,A4),D0
                            	  7143:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7144:     ; So, we have to look up the square index corresponding
                            	  7145:     ; to primary square/tile in [05].
                            	  7146:     ;
                            	  7147:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7148:     ; then the X register will have the square index value.
                            	  7149:     ;
02:00044522 0C000027        	  7150:     cmpi.b  #$27,D0
02:00044526 6506            	  7151:     bcs  _anon_z05_148
02:00044528 0C0000F3        	  7152:     cmpi.b  #$F3,D0
02:0004452C 6514            	  7153:     bcs  _L_z05_ChangePlayMapSquareOW_Write
