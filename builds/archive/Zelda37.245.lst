02:000339E6 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:000339EA 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000339EE E14C            	   559:     lsl.w   #8,D4
02:000339F0 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:000339F2 48C4            	   561:     ext.l   D4
02:000339F4 D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000339FA 2044            	   563:     movea.l D4,A0
02:000339FC 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033A00 41EC0630        	   565:     lea     ($0630,A4),A0
02:00033A04 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00033A08 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00033A0C 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00033A10 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033A14 E14C            	   570:     lsl.w   #8,D4
02:00033A16 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033A18 48C4            	   572:     ext.l   D4
02:00033A1A D8BC00FF0000    	   573:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033A20 2044            	   574:     movea.l D4,A0
02:00033A22 10303000        	   575:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
