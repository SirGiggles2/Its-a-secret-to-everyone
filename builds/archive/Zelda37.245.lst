                            	  7748: PrepFullBlackRow:
                            	  7749:     ; Prepare the dynamic transfer buf with a row of blank ($24) tiles
                            	  7750:     ; to transfer to row (7 + Y).
                            	  7751:     ;
                            	  7752:     ; Calculate PPU address ($28E0 + Y*$20).
