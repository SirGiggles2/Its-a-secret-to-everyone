02:0002E572 41EC046F        	   421:     lea     ($046F,A4),A0
02:0002E576 10303000        	   422:     move.b  (A0,D3.W),D0
02:0002E57A 41EC0448        	   423:     lea     ($0448,A4),A0
02:0002E57E 11802000        	   424:     move.b  D0,(A0,D2.W)
02:0002E582 5302            	   425:     subq.b  #1,D2
02:0002E584 6AE2            	   426:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
