02:000407B4 E208            	   984:     lsr.b  #1,D0   ; LSR A
02:000407B6 122C0098        	   985:     move.b  ($0098,A4),D1
02:000407BA C200            	   986:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
