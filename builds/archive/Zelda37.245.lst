02:00036908 162C0413        	  4892:     move.b  ($0413,A4),D3
02:0003690C 41F9000368A6    	  4893:     lea     (PeaceText).l,A0
02:00036912 10303000        	  4894:     move.b  (A0,D3.W),D0
02:00036916 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:0003691A 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:0003691C 19400305        	  4897:     move.b  D0,($0305,A4)
