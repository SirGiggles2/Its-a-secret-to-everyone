02:0003B74E 0A3C0010        	  4178:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B752 9101            	  4179:     subx.b  D1,D0   ; SBC #$1C
02:0003B754 0A3C0010        	  4180:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B758 41EC0084        	  4181:     lea     ($0084,A4),A0
