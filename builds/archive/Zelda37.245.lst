                            	  9055:     ; Cue the "selection changed" tune.
                            	  9056:     ;
02:00045520 7401            	  9057:     moveq   #1,D2
02:00045522 19420602        	  9058:     move.b  D2,($0602,A4)
                            	  9059:     ; Move the selection in the input direction.
                            	  9060:     ;
                            	  9061:     ;
                            	  9062:     ; Save the input direction.
