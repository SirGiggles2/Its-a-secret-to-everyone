                            	   816:     ; Play the "heart taken/character" sound effect.
                            	   817:     ;
02:0002E83A 7010            	   818:     moveq   #16,D0
02:0002E83C 19400604        	   819:     move.b  D0,($0604,A4)
                            	   820:     ; If the high 2 bits of character element = 0, then return.
                            	   821:     ;
02:0002E840 1214            	   822:     move.b  ($00,A4),D1   ; ptr lo
02:0002E842 182C0001        	   823:     move.b  ($01,A4),D4  ; ptr hi
02:0002E846 024100FF        	   824:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E84A E14C            	   825:     lsl.w   #8,D4
02:0002E84C 8841            	   826:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E84E 48C4            	   827:     ext.l   D4
02:0002E850 D8BC00FF0000    	   828:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E856 2044            	   829:     movea.l D4,A0
02:0002E858 10303000        	   830:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E85C 020000C0        	   831:     andi.b #$C0,D0
02:0002E860 672E            	   832:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   833:     ; Determine an index based on the high 2 bits of the character element:
                            	   834:     ;   $80: 0
