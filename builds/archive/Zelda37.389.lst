02:00049AD4 41EC0098        	  6197:     lea     ($0098,A4),A0
02:00049AD8 10302000        	  6198:     move.b  (A0,D2.W),D0
02:00049ADC 02000003        	  6199:     andi.b #$03,D0
02:00049AE0 6714            	  6200:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:00049AE2 10342070        	  6201:     move.b  ($70,A4,D2.W),D0
