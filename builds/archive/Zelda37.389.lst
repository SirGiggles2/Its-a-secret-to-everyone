                            	  7456:     ; For monsters that spawn in a cloud, set their start time to
                            	  7457:     ; the same value as the object slot; so that they all start
                            	  7458:     ; moving at different times.
                            	  7459:     ;
02:0004A4CE 7400            	  7460:     moveq   #0,D2
02:0004A4D0 142C0340        	  7461:     move.b  ($0340,A4),D2
02:0004A4D4 7600            	  7462:     moveq   #0,D3
02:0004A4D6 41EC034F        	  7463:     lea     ($034F,A4),A0
02:0004A4DA 16302000        	  7464:     move.b  (A0,D2.W),D3
02:0004A4DE 0C03001E        	  7465:     cmpi.b  #$1E,D3
02:0004A4E2 6712            	  7466:     beq  _L_z07_InitObject_FetchAttrs
02:0004A4E4 0C030022        	  7467:     cmpi.b  #$22,D3
02:0004A4E8 670C            	  7468:     beq  _L_z07_InitObject_FetchAttrs
02:0004A4EA 0C030053        	  7469:     cmpi.b  #$53,D3
02:0004A4EE 6406            	  7470:     bcc  _L_z07_InitObject_FetchAttrs
02:0004A4F0 1002            	  7471:     move.b  D2,D0
02:0004A4F2 19802028        	  7472:     move.b  D0,($28,A4,D2.W)
                            	  7473:     even
                            	  7474: _L_z07_InitObject_FetchAttrs:
                            	  7475:     ; Store the object attributes for fast access.
