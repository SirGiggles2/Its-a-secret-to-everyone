                            	  1001: _L_z04_UpdateFireball_Move:
                            	  1002:     ; A movement routine is used that works along one axis.
                            	  1003:     ; So, load its parameters, and call it for each axis individually.
                            	  1004:     ;
                            	  1005:     ; First, load the horizontal direction into [0F].
                            	  1006:     ;
02:0003880E 41EC0412        	  1007:     lea     ($0412,A4),A0
02:00038812 10302000        	  1008:     move.b  (A0,D2.W),D0
02:00038816 1940000F        	  1009:     move.b  D0,($000F,A4)
                            	  1010:     ; Load the horizontal q-speed and position fraction,
                            	  1011:     ; move, then save the position fraction.
                            	  1012:     ;
02:0003881A 41EC041F        	  1013:     lea     ($041F,A4),A0
02:0003881E 10302000        	  1014:     move.b  (A0,D2.W),D0
02:00038822 7600            	  1015:     moveq   #0,D3
02:00038824 41EC0451        	  1016:     lea     ($0451,A4),A0
02:00038828 16302000        	  1017:     move.b  (A0,D2.W),D3
02:0003882C 613E            	  1018:     jsr     Fireball_MoveOneAxis
02:0003882E 41EC0451        	  1019:     lea     ($0451,A4),A0
02:00038832 11802000        	  1020:     move.b  D0,(A0,D2.W)
                            	  1021:     ; Second, load the vertical direction into [0F].
                            	  1022:     ;
02:00038836 41EC0437        	  1023:     lea     ($0437,A4),A0
02:0003883A 10302000        	  1024:     move.b  (A0,D2.W),D0
02:0003883E 1940000F        	  1025:     move.b  D0,($000F,A4)
                            	  1026:     ; Load the vertical q-speed and position fraction,
                            	  1027:     ; move, then save the position fraction.
                            	  1028:     ;
02:00038842 41EC0444        	  1029:     lea     ($0444,A4),A0
02:00038846 10302000        	  1030:     move.b  (A0,D2.W),D0
02:0003884A 7600            	  1031:     moveq   #0,D3
02:0003884C 41EC045E        	  1032:     lea     ($045E,A4),A0
02:00038850 16302000        	  1033:     move.b  (A0,D2.W),D3
