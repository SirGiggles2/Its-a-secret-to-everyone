                            	  5966:     ; If it hasn't expired, go move the sword or rod.
                            	  5967:     ;
02:00049916 41EC03D0        	  5968:     lea     ($03D0,A4),A0
02:0004991A 53302000        	  5969:     subq.b  #1,(A0,D2.W)
02:0004991E 6644            	  5970:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5971:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5972:     ;
02:00049920 41EC00AC        	  5973:     lea     ($00AC,A4),A0
02:00049924 10302000        	  5974:     move.b  (A0,D2.W),D0
02:00049928 0200000F        	  5975:     andi.b #$0F,D0
02:0004992C 7600            	  5976:     moveq   #0,D3
02:0004992E 1600            	  5977:     move.b  D0,D3
02:00049930 7008            	  5978:     moveq   #8,D0
02:00049932 5303            	  5979:     subq.b  #1,D3
02:00049934 6702            	  5980:     beq  _anon_z07_32
02:00049936 7001            	  5981:     moveq   #1,D0
                            	  5982: _anon_z07_32:
                            	  5983:     ; Set both the player's animation counter and the sword's
                            	  5984:     ; animation counter/timer to this value.
                            	  5985:     ;
02:00049938 194003D0        	  5986:     move.b  D0,($03D0,A4)
02:0004993C 41EC03D0        	  5987:     lea     ($03D0,A4),A0
02:00049940 11802000        	  5988:     move.b  D0,(A0,D2.W)
                            	  5989:     ; Go to the next state.
                            	  5990:     ;
02:00049944 41EC00AC        	  5991:     lea     ($00AC,A4),A0
02:00049948 52302000        	  5992:     addq.b  #1,(A0,D2.W)
                            	  5993:     ; Once we reach state 6, deactivate the object.
                            	  5994:     ; Otherwise, go draw it.
                            	  5995:     ;
02:0004994C 41EC00AC        	  5996:     lea     ($00AC,A4),A0
02:00049950 10302000        	  5997:     move.b  (A0,D2.W),D0
02:00049954 0200000F        	  5998:     andi.b #$0F,D0
02:00049958 0C000006        	  5999:     cmpi.b  #$06,D0
02:0004995C 6506            	  6000:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:0004995E 610001C2        	  6001:     jsr     ResetObjState
                            	  6002:     even
