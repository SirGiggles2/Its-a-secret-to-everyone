                            	  3327: PondFairy_MoveHearts:
                            	  3328:     ; Loop over each heart from object slot 2 to 9.
                            	  3329:     ;
                            	  3330:     ; Even though they are not standalone objects, their info
                            	  3331:     ; is stored in those object slots.
                            	  3332:     ;
