                            	  5621:     even
                            	  5622: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5623:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5624:     ; We need to remember how many tiles need to be copied
                            	  5625:     ; in each transfer record.
                            	  5626:     ;
02:0004090A 102C0006        	  5627:     move.b  ($0006,A4),D0
02:0004090E 19400004        	  5628:     move.b  D0,($0004,A4)
                            	  5629:     ; Write the transfer record header for the door.
                            	  5630:     ;
                            	  5631:     ;
                            	  5632:     ; VRAM address high byte of door
02:00040912 1014            	  5633:     move.b  ($0000,A4),D0
02:00040914 41EC0302        	  5634:     lea     ($0302,A4),A0
02:00040918 11802000        	  5635:     move.b  D0,(A0,D2.W)
02:0004091C 5202            	  5636:     addq.b  #1,D2
02:0004091E 102C0001        	  5637:     move.b  ($0001,A4),D0
02:00040922 41EC0302        	  5638:     lea     ($0302,A4),A0
02:00040926 11802000        	  5639:     move.b  D0,(A0,D2.W)
02:0004092A 5202            	  5640:     addq.b  #1,D2
02:0004092C 102C0006        	  5641:     move.b  ($0006,A4),D0
02:00040930 41EC0302        	  5642:     lea     ($0302,A4),A0
02:00040934 11802000        	  5643:     move.b  D0,(A0,D2.W)
02:00040938 5202            	  5644:     addq.b  #1,D2
                            	  5645: _anon_z05_121:
                            	  5646:     ; Write two tiles in a short loop indexed by [04].
                            	  5647:     ;
02:0004093A 6100ED1C        	  5648:     jsr     WriteDoorFaceTileHorizontally
02:0004093E 66FA            	  5649:     bne  _anon_z05_121
                            	  5650:     ; OR the low VRAM address with $20 to go down one row
                            	  5651:     ; in order to work on the second row of door tiles.
                            	  5652:     ;
02:00040940 7020            	  5653:     moveq   #32,D0
02:00040942 122C0001        	  5654:     move.b  ($0001,A4),D1
02:00040946 8001            	  5655:     or.b  D1,D0
02:00040948 19400001        	  5656:     move.b  D0,($0001,A4)
                            	  5657:     ; Bottom of the loop.
                            	  5658:     ; Loop again to write the second transfer record for the
                            	  5659:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5660:     ;
02:0004094C 532C0005        	  5661:     subq.b  #1,($0005,A4)
02:00040950 66B8            	  5662:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5663:     ; Write the end marker, and update buffer length.
                            	  5664:     ;
02:00040952 103C00FF        	  5665:     move.b  #$FF,D0
02:00040956 41EC0302        	  5666:     lea     ($0302,A4),A0
02:0004095A 11802000        	  5667:     move.b  D0,(A0,D2.W)
02:0004095E 1002            	  5668:     move.b  D2,D0
02:00040960 19400301        	  5669:     move.b  D0,($0301,A4)
                            	  5670:     ; Increment the command.
                            	  5671:     ;
02:00040964 522C0054        	  5672:     addq.b  #1,($0054,A4)
                            	  5673:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5674:     ; and resetting the door command.
                            	  5675:     ; This ends up catching original states 3 and 7.
                            	  5676:     ;
                            	  5677:     ; Else set door timer to 8 and return.
                            	  5678:     ;
02:00040968 102C0054        	  5679:     move.b  ($0054,A4),D0
02:0004096C 02000003        	  5680:     andi.b #$03,D0
02:00040970 6708            	  5681:     beq  _anon_z05_122
02:00040972 7008            	  5682:     moveq   #8,D0
02:00040974 19400027        	  5683:     move.b  D0,($0027,A4)
02:00040978 4E75            	  5684:     rts
                            	  5685: 
                            	  5686: _anon_z05_122:
                            	  5687:     ; If the door command = 4 after incrementing it, then
                            	  5688:     ; it was 3 (close door). So:
                            	  5689:     ; 1. reset this door's flag
                            	  5690:     ; 2. remove it from the opened door mask
                            	  5691:     ; 3. reset the door command
                            	  5692:     ; 4. go lay out doors in the play area map
                            	  5693:     ;
02:0004097A 102C0054        	  5694:     move.b  ($0054,A4),D0
02:0004097E 0C000004        	  5695:     cmpi.b  #$04,D0
02:00040982 6626            	  5696:     bne  _anon_z05_123
02:00040984 7400            	  5697:     moveq   #0,D2
02:00040986 142C0009        	  5698:     move.b  ($0009,A4),D2
02:0004098A 6100DCE2        	  5699:     jsr     ResetDoorFlag
02:0004098E 102C0055        	  5700:     move.b  ($0055,A4),D0
02:00040992 0A00000F        	  5701:     eori.b #$0F,D0
02:00040996 122C00EE        	  5702:     move.b  ($00EE,A4),D1
02:0004099A C001            	  5703:     and.b  D1,D0
                            	  5704:     even
                            	  5705: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004099C 194000EE        	  5706:     move.b  D0,($00EE,A4)
                            	  5707:     even
                            	  5708: L_ResetDoorCmdAndLayOutDoors:
02:000409A0 7000            	  5709:     moveq   #0,D0
02:000409A2 19400054        	  5710:     move.b  D0,($0054,A4)
02:000409A6 6000FCD4        	  5711:     jmp     LayOutDoors
                            	  5712: 
                            	  5713: _anon_z05_123:
                            	  5714:     ; Door command <> 4.
                            	  5715:     ; It must be 8, which means it was 7: open door.
                            	  5716:     ;
                            	  5717:     ; If the door is a shutter (7), then go add the door to the
                            	  5718:     ; opened door mask, reset door command, and lay out doors.
                            	  5719:     ;
02:000409AA 102C0055        	  5720:     move.b  ($0055,A4),D0
02:000409AE 19400002        	  5721:     move.b  D0,($0002,A4)
02:000409B2 6100FA32        	  5722:     jsr     FindDoorAttrByDoorBit
02:000409B6 0C000007        	  5723:     cmpi.b  #$07,D0
02:000409BA 676E            	  5724:     beq  _anon_z05_124
                            	  5725:     ; Else the door is not a shutter.
                            	  5726:     ;
                            	  5727:     ;
                            	  5728:     ; [09] door direction index
02:000409BC 7400            	  5729:     moveq   #0,D2
02:000409BE 142C0009        	  5730:     move.b  ($0009,A4),D2
02:000409C2 6100DCA4        	  5731:     jsr     SetDoorFlag
                            	  5732:     ; Get the next room's ID.
                            	  5733:     ;
02:000409C6 1003            	  5734:     move.b  D3,D0
02:000409C8 023C00EE        	  5735:     andi    #$EE,CCR  ; CLC: clear C+X
02:000409CC 41F900040888    	  5736:     lea     (DoorNextRoomIdOffsets).l,A0
02:000409D2 12302000        	  5737:     move.b  (A0,D2.W),D1
02:000409D6 D101            	  5738:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000409D8 7600            	  5739:     moveq   #0,D3
02:000409DA 1600            	  5740:     move.b  D0,D3
                            	  5741:     ; Flip the door direction index.
                            	  5742:     ;
02:000409DC 1002            	  5743:     move.b  D2,D0
02:000409DE 0A000001        	  5744:     eori.b #$01,D0
02:000409E2 7400            	  5745:     moveq   #0,D2
02:000409E4 1400            	  5746:     move.b  D0,D2
                            	  5747:     ; Set the door flag for the opposite door in the next room.
                            	  5748:     ;
02:000409E6 1214            	  5749:     move.b  ($00,A4),D1   ; ptr lo
02:000409E8 182C0001        	  5750:     move.b  ($01,A4),D4  ; ptr hi
02:000409EC 024100FF        	  5751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000409F0 E14C            	  5752:     lsl.w   #8,D4
02:000409F2 8841            	  5753:     or.w    D1,D4             ; D4 = NES ptr addr
02:000409F4 48C4            	  5754:     ext.l   D4
02:000409F6 D8BC00FF0000    	  5755:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000409FC 2044            	  5756:     movea.l D4,A0
02:000409FE 10303000        	  5757:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040A02 41F900047D16    	  5758:     lea     (LevelMasks).l,A0
02:00040A08 12302000        	  5759:     move.b  (A0,D2.W),D1
02:00040A0C 8001            	  5760:     or.b  D1,D0
02:00040A0E 1214            	  5761:     move.b  ($00,A4),D1   ; ptr lo
02:00040A10 182C0001        	  5762:     move.b  ($01,A4),D4  ; ptr hi
02:00040A14 024100FF        	  5763:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040A18 E14C            	  5764:     lsl.w   #8,D4
