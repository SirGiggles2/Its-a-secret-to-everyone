02:0003AECE D101            	  6426:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003AED0 41EC0394        	  6427:     lea     ($0394,A4),A0
02:0003AED4 11802000        	  6428:     move.b  D0,(A0,D2.W)
                            	  6429:     ; Align the monster with a square horizontally.
                            	  6430:     ;
                            	  6431:     ; If in the left half of a square, align with that square.
                            	  6432:     ; If in the right half, align with the next square.
                            	  6433:     ;
02:0003AED8 10342070        	  6434:     move.b  ($70,A4,D2.W),D0
02:0003AEDC 023C00EE        	  6435:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AEE0 123C0008        	  6436:     move.b  #$08,D1
02:0003AEE4 D101            	  6437:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AEE6 020000F0        	  6438:     andi.b #$F0,D0
02:0003AEEA 19802070        	  6439:     move.b  D0,($70,A4,D2.W)
                            	  6440:     ; Align the monster with a square vertically.
                            	  6441:     ;
                            	  6442:     ; If in the top half of a square, align with that square.
                            	  6443:     ; If in the bottom half, align with the next square.
                            	  6444:     ;
02:0003AEEE 41EC0084        	  6445:     lea     ($0084,A4),A0
02:0003AEF2 10302000        	  6446:     move.b  (A0,D2.W),D0
02:0003AEF6 023C00EE        	  6447:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AEFA 123C0008        	  6448:     move.b  #$08,D1
02:0003AEFE D101            	  6449:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AF00 020000F0        	  6450:     andi.b #$F0,D0
                            	  6451:     ; Make sure the lower nibble of Y is $D as usual.
                            	  6452:     ;
02:0003AF04 003C0011        	  6453:     ori     #$11,CCR  ; SEC: set C+X
02:0003AF08 123C0003        	  6454:     move.b  #$03,D1
02:0003AF0C 0A3C0010        	  6455:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AF10 9101            	  6456:     subx.b  D1,D0   ; SBC #$03
02:0003AF12 0A3C0010        	  6457:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AF16 41EC0084        	  6458:     lea     ($0084,A4),A0
02:0003AF1A 11802000        	  6459:     move.b  D0,(A0,D2.W)
