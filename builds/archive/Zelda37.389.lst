                            	  5706: Aquamentus_Draw:
                            	  5707:     ; Every $10 screen frames, switch animation frames.
                            	  5708:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  5709:     ; The last tile of frame 0 is at index 5.
                            	  5710:     ; The last tile of frame 1 is at index $B.
                            	  5711:     ;
02:0003A94A 7605            	  5712:     moveq   #5,D3
02:0003A94C 102C0015        	  5713:     move.b  ($0015,A4),D0
02:0003A950 02000010        	  5714:     andi.b #$10,D0
02:0003A954 6602            	  5715:     bne  _anon_z04_88
02:0003A956 760B            	  5716:     moveq   #11,D3
                            	  5717: _anon_z04_88:
02:0003A958 1943000A        	  5718:     move.b  D3,($000A,A4)
                            	  5719:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  5720:     ;
02:0003A95C 7005            	  5721:     moveq   #5,D0
02:0003A95E 1940000B        	  5722:     move.b  D0,($000B,A4)
                            	  5723:     even
                            	  5724: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A962 7600            	  5725:     moveq   #0,D3
02:0003A964 162C000B        	  5726:     move.b  ($000B,A4),D3
                            	  5727:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  5728:     ; Store it in [00].
                            	  5729:     ;
02:0003A968 10342070        	  5730:     move.b  ($70,A4,D2.W),D0
02:0003A96C 023C00EE        	  5731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A970 41F90003A944    	  5732:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A976 12303000        	  5733:     move.b  (A0,D3.W),D1
02:0003A97A D101            	  5734:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A97C 1880            	  5735:     move.b  D0,($0000,A4)
                            	  5736:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  5737:     ; Store it in [01].
                            	  5738:     ;
02:0003A97E 41EC0084        	  5739:     lea     ($0084,A4),A0
02:0003A982 10302000        	  5740:     move.b  (A0,D2.W),D0
02:0003A986 023C00EE        	  5741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A98A 41F90003A93E    	  5742:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A990 12303000        	  5743:     move.b  (A0,D3.W),D1
02:0003A994 D101            	  5744:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A996 19400001        	  5745:     move.b  D0,($0001,A4)
                            	  5746:     ; Calculate sprite attributes:
                            	  5747:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  5748:     ;
                            	  5749:     ; If the boss is temporarily invincible, then
                            	  5750:     ; this makes it flash by cycling all the palette rows.
                            	  5751:     ;
                            	  5752:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  5753:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  5754:     ;
02:0003A99A 41EC04F0        	  5755:     lea     ($04F0,A4),A0
02:0003A99E 10302000        	  5756:     move.b  (A0,D2.W),D0
02:0003A9A2 02000003        	  5757:     andi.b #$03,D0
02:0003A9A6 0A000003        	  5758:     eori.b #$03,D0
02:0003A9AA 19400003        	  5759:     move.b  D0,($0003,A4)
02:0003A9AE 7600            	  5760:     moveq   #0,D3
02:0003A9B0 162C000A        	  5761:     move.b  ($000A,A4),D3
                            	  5762:     ; Look up the tile for this sprite.
                            	  5763:     ; If it's not the first one (face), then go write the sprite record.
                            	  5764:     ;
02:0003A9B4 41F90003A932    	  5765:     lea     (AquamentusTiles).l,A0
02:0003A9BA 10303000        	  5766:     move.b  (A0,D3.W),D0
02:0003A9BE 12390003A932    	  5767:     move.b  (AquamentusTiles).l,D1
02:0003A9C4 B001            	  5768:     cmp.b   D1,D0
02:0003A9C6 6610            	  5769:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  5770:     ; Else it's the first one (the face tile).
                            	  5771:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  5772:     ;
                            	  5773:     ; $CC/CD shows the closed mouth face.
                            	  5774:     ; $C0/C1 shows the open mouth face.
                            	  5775:     ;
02:0003A9C8 7600            	  5776:     moveq   #0,D3
02:0003A9CA 16342028        	  5777:     move.b  ($28,A4,D2.W),D3
02:0003A9CE 0C030020        	  5778:     cmpi.b  #$20,D3
02:0003A9D2 6404            	  5779:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A9D4 103C00C0        	  5780:     move.b  #$C0,D0
                            	  5781:     even
                            	  5782: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003A9D8 610E            	  5783:     jsr     WriteBossSprite
                            	  5784:     ; Bottom of the loop.
                            	  5785:     ; Decrement tile index and loop index.
                            	  5786:     ;
02:0003A9DA 532C000A        	  5787:     subq.b  #1,($000A,A4)
02:0003A9DE 532C000B        	  5788:     subq.b  #1,($000B,A4)
02:0003A9E2 6A00FF7E        	  5789:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A9E6 4E75            	  5790:     rts
                            	  5791: 
                            	  5792: ; Params:
                            	  5793: ; A: tile
                            	  5794: ; [00]: X
                            	  5795: ; [01]: Y
                            	  5796: ; [03]: sprite attributes
                            	  5797: ;
                            	  5798: ; Save the tile
                            	  5799:     even
                            	  5800: WriteBossSprite:
02:0003A9E8 1B00            	  5801:     move.b  D0,-(A5)  ; PHA
02:0003A9EA 7600            	  5802:     moveq   #0,D3
02:0003A9EC 162C0341        	  5803:     move.b  ($0341,A4),D3
02:0003A9F0 41F900030C64    	  5804:     lea     (SpriteOffsets).l,A0
02:0003A9F6 10303000        	  5805:     move.b  (A0,D3.W),D0
02:0003A9FA 7600            	  5806:     moveq   #0,D3
02:0003A9FC 1600            	  5807:     move.b  D0,D3
02:0003A9FE 101D            	  5808:     move.b  (A5)+,D0  ; PLA
02:0003AA00 41EC0201        	  5809:     lea     ($0201,A4),A0
02:0003AA04 11803000        	  5810:     move.b  D0,(A0,D3.W)
02:0003AA08 1014            	  5811:     move.b  ($0000,A4),D0
02:0003AA0A 41EC0203        	  5812:     lea     ($0203,A4),A0
02:0003AA0E 11803000        	  5813:     move.b  D0,(A0,D3.W)
02:0003AA12 102C0001        	  5814:     move.b  ($0001,A4),D0
02:0003AA16 4EF900030FE2    	  5815:     jmp     Anim_EndWriteSprite
