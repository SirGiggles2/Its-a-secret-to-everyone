02:00040AB6 41F900040884    	  5873:     lea     (DoorVramAddrsLo).l,A0
02:00040ABC 10302000        	  5874:     move.b  (A0,D2.W),D0
02:00040AC0 19400001        	  5875:     move.b  D0,($0001,A4)
                            	  5876:     ; Return the direction of the door in [09], and the dynamic
                            	  5877:     ; transfer buf length in X register.
                            	  5878:     ;
02:00040AC4 19420009        	  5879:     move.b  D2,($0009,A4)
02:00040AC8 7400            	  5880:     moveq   #0,D2
02:00040ACA 142C0301        	  5881:     move.b  ($0301,A4),D2
