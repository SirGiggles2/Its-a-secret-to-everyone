                            	  2405:     ;   record 2: $72, $73
                            	  2406:     ;
02:00048060 0C000046        	  2407:     cmpi.b  #$46,D0
02:00048064 6530            	  2408:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00048066 0C0000F3        	  2409:     cmpi.b  #$F3,D0
