                            	  5911: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5912:     ; Bloated timer =>
                            	  5913:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5914:     ; 1:     go advance the substate
                            	  5915:     ; other: go decrement Bloated timer
                            	  5916:     ;
02:0003AAD4 7600            	  5917:     moveq   #0,D3
02:0003AAD6 41EC045E        	  5918:     lea     ($045E,A4),A0
02:0003AADA 16302000        	  5919:     move.b  (A0,D2.W),D3
02:0003AADE 5303            	  5920:     subq.b  #1,D3
02:0003AAE0 6750            	  5921:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003AAE2 6B04            	  5922:     bmi.s  __far_z_04_0051
02:0003AAE4 60000080        	  5923:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5924: __far_z_04_0051:
                            	  5925:     ; Set the bloated timer according to the substate.
                            	  5926:     ;
02:0003AAE8 7600            	  5927:     moveq   #0,D3
02:0003AAEA 41EC042C        	  5928:     lea     ($042C,A4),A0
02:0003AAEE 16302000        	  5929:     move.b  (A0,D2.W),D3
02:0003AAF2 41F90003AA30    	  5930:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003AAF8 10303000        	  5931:     move.b  (A0,D3.W),D0
02:0003AAFC 41EC045E        	  5932:     lea     ($045E,A4),A0
02:0003AB00 11802000        	  5933:     move.b  D0,(A0,D2.W)
                            	  5934:     ; If substate <> 0, go decrement bloated timer.
                            	  5935:     ;
02:0003AB04 4A03            	  5936:     cmpi.b  #$00,D3
02:0003AB06 6702            	  5937:     beq.s  __far_z_04_0052
02:0003AB08 605C            	  5938:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5939: __far_z_04_0052:
                            	  5940:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5941:     ;
02:0003AB0A 7610            	  5942:     moveq   #16,D3
02:0003AB0C 7000            	  5943:     moveq   #0,D0
02:0003AB0E 41EC00AC        	  5944:     lea     ($00AC,A4),A0
02:0003AB12 11803000        	  5945:     move.b  D0,(A0,D3.W)
                            	  5946:     ; Increment the number of bomb hits.
                            	  5947:     ;
02:0003AB16 41EC0437        	  5948:     lea     ($0437,A4),A0
02:0003AB1A 10302000        	  5949:     move.b  (A0,D2.W),D0
02:0003AB1E 023C00EE        	  5950:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB22 123C0001        	  5951:     move.b  #$01,D1
02:0003AB26 D101            	  5952:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003AB28 41EC0437        	  5953:     lea     ($0437,A4),A0
02:0003AB2C 11802000        	  5954:     move.b  D0,(A0,D2.W)
02:0003AB30 6034            	  5955:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  5956: 
                            	  5957:     even
                            	  5958: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5959:     ; Advance the substate.
                            	  5960:     ;
02:0003AB32 41EC042C        	  5961:     lea     ($042C,A4),A0
02:0003AB36 52302000        	  5962:     addq.b  #1,(A0,D2.W)
                            	  5963:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5964:     ;
02:0003AB3A 41EC042C        	  5965:     lea     ($042C,A4),A0
02:0003AB3E 10302000        	  5966:     move.b  (A0,D2.W),D0
02:0003AB42 0C000002        	  5967:     cmpi.b  #$02,D0
02:0003AB46 6402            	  5968:     bcc.s  __far_z_04_0053
02:0003AB48 601C            	  5969:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5970: __far_z_04_0053:
                            	  5971:     ; New bloated substate >= 2.
                            	  5972:     ;
                            	  5973:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5974:     ; which will transition to state 0 (moving).
                            	  5975:     ;
                            	  5976:     ; Note that if the bomb hits >= 2, then:
                            	  5977:     ; - If new substate = 2, then substate 2 will wait,
                            	  5978:     ;   and then transition to substate 3.
                            	  5979:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5980:     ;
02:0003AB4A 7600            	  5981:     moveq   #0,D3
02:0003AB4C 41EC0437        	  5982:     lea     ($0437,A4),A0
02:0003AB50 16302000        	  5983:     move.b  (A0,D2.W),D3
02:0003AB54 0C030002        	  5984:     cmpi.b  #$02,D3
02:0003AB58 6502            	  5985:     bcs.s  __far_z_04_0054
02:0003AB5A 600A            	  5986:     jmp  L_Dodongo_DecrementBloatedTimer
