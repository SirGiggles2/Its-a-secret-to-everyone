                            	  1906: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  1907:     ; Set state 1 to jump.
                            	  1908:     ;
02:00038DE6 41EC00AC        	  1909:     lea     ($00AC,A4),A0
02:00038DEA 52302000        	  1910:     addq.b  #1,(A0,D2.W)
