                            	  2935: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:00039588 102C000D        	  2936:     move.b  ($000D,A4),D0
                            	  2937: ; Params:
                            	  2938: ; A: frame image
                            	  2939: ; X: object index
                            	  2940: ; [00]: object X
                            	  2941: ; [01]: object Y
                            	  2942: ; [0F]: flip horizontally
                            	  2943: ;
                            	  2944: ; Returns:
                            	  2945: ; [00]: 0 for Link slot
                            	  2946: ; [06]: 1 if objects collide
                            	  2947: ; [09]: 0 for Link damage type (none)
                            	  2948: ; [0C]: 1 if objects collide
                            	  2949: ; [034B]: ShotCollidesWithLink
                            	  2950: ;
                            	  2951:     even
