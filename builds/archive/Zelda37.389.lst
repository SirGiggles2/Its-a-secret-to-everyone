                            	  7641: Submenu_CueTransferRowUW:
                            	  7642:     ; If menu scroll value is negative, then we transferred everything.
                            	  7643:     ; So, return.
                            	  7644:     ;
02:00041D48 102C005E        	  7645:     move.b  ($005E,A4),D0
02:00041D4C 6A02            	  7646:     bpl.s  __far_z_05_0084
02:00041D4E 6030            	  7647:     jmp  L1725A_Exit
                            	  7648: __far_z_05_0084:
                            	  7649:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7650:     ; and represents the current row of the submenu being processed.
                            	  7651:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7652:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7653:     ;
                            	  7654:     ; If the bottom bit is set, go prepare the full black row.
                            	  7655:     ;
02:00041D50 E208            	  7656:     lsr.b  #1,D0   ; LSR A
02:00041D52 7600            	  7657:     moveq   #0,D3
02:00041D54 1600            	  7658:     move.b  D0,D3
02:00041D56 6402            	  7659:     bcc.s  __far_z_05_0085
02:00041D58 6028            	  7660:     jmp  PrepFullBlackRow
                            	  7661: __far_z_05_0085:
                            	  7662:     ; Submenu rows $D to $15 are parts of the map.
                            	  7663:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7664:     ;
                            	  7665:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7666:     ; buffer for this row.
                            	  7667:     ;
02:00041D5A 0C00000D        	  7668:     cmpi.b  #$0D,D0
02:00041D5E 640C            	  7669:     bcc  _anon_z05_167
02:00041D60 41F900041D24    	  7670:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00041D66 10303000        	  7671:     move.b  (A0,D3.W),D0
                            	  7672:     even
