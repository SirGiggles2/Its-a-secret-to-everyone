02:00039630 1014            	  3065:     move.b  ($0000,A4),D0
                            	  3066:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3067:     ;
02:00039632 1B00            	  3068:     move.b  D0,-(A5)  ; PHA
02:00039634 0C000070        	  3069:     cmpi.b  #$70,D0
02:00039638 6604            	  3070:     bne  _anon_z04_51
02:0003963A 61000686        	  3071:     jsr     PlaySecretFoundTune
                            	  3072: _anon_z04_51:
                            	  3073:     ; Replace the tile where the armos was.
                            	  3074:     ;
02:0003963E 522C00F7        	  3075:     addq.b  #1,($00F7,A4)
02:00039642 101D            	  3076:     move.b  (A5)+,D0  ; PLA
02:00039644 4EB900047FE6    	  3077:     jsr     ChangeTileObjTiles
                            	  3078:     ; Because the armos object is aligned to the square grid
                            	  3079:     ; (because it was made from a square),
                            	  3080:     ; set its grid offset to 3 to compensate.
                            	  3081:     ;
                            	  3082:     ; Most objects are aligned to the grid vertically when the
                            	  3083:     ; low nibble is $D.
                            	  3084:     ;
02:0003964A 7003            	  3085:     moveq   #3,D0
02:0003964C 41EC0394        	  3086:     lea     ($0394,A4),A0
02:00039650 11802000        	  3087:     move.b  D0,(A0,D2.W)
                            	  3088:     ; Set a speed (q-speed fraction) randomly:
                            	  3089:     ; $20 if random value < $80
                            	  3090:     ; $60 otherwise
                            	  3091:     ;
02:00039654 7020            	  3092:     moveq   #32,D0
02:00039656 7600            	  3093:     moveq   #0,D3
02:00039658 16342019        	  3094:     move.b  ($19,A4,D2.W),D3
02:0003965C 0C030080        	  3095:     cmpi.b  #$80,D3
02:00039660 6502            	  3096:     bcs  _anon_z04_52
02:00039662 7060            	  3097:     moveq   #96,D0
