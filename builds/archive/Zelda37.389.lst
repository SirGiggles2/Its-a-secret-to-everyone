                            	  2804: _L_z04_UpdateOctorock_SaveOffset:
02:000394AA 1B00            	  2805:     move.b  D0,-(A5)  ; PHA
                            	  2806:     ; Decrement the animation counter, and roll over if needed.
                            	  2807:     ;
02:000394AC 41EC03D0        	  2808:     lea     ($03D0,A4),A0
02:000394B0 53302000        	  2809:     subq.b  #1,(A0,D2.W)
02:000394B4 661E            	  2810:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:000394B6 7006            	  2811:     moveq   #6,D0
02:000394B8 41EC03D0        	  2812:     lea     ($03D0,A4),A0
02:000394BC 11802000        	  2813:     move.b  D0,(A0,D2.W)
                            	  2814:     ; There are actually 6 frame images divided into 2 sets.
                            	  2815:     ; Each set depicts one animation frame. In each set there are
                            	  2816:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2817:     ;
                            	  2818:     ; The movement frame will keep track of the base offset of
                            	  2819:     ; the current set for the current animation frame: 0 or 3.
                            	  2820:     ;
                            	  2821:     ; So, XOR the movement frame with 3.
                            	  2822:     ;
