                            	  4840:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  4841:     ;
02:0003A2C8 10342028        	  4842:     move.b  ($28,A4,D2.W),D0
02:0003A2CC 0C000010        	  4843:     cmpi.b  #$10,D0
02:0003A2D0 6702            	  4844:     beq.s  __far_z_04_0038
02:0003A2D2 6058            	  4845:     jmp  L1156B_Exit
