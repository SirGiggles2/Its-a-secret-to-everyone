                            	  2561: _anon_z04_45:
02:000392D0 1883            	  2562:     move.b  D3,($0000,A4)
                            	  2563:     ; [01] holds Link's X coordinate.
                            	  2564:     ;
02:000392D2 102C0070        	  2565:     move.b  ($0070,A4),D0
02:000392D6 19400001        	  2566:     move.b  D0,($0001,A4)
                            	  2567:     ; Add Link's X and the horizontal offset.
                            	  2568:     ;
02:000392DA 023C00EE        	  2569:     andi    #$EE,CCR  ; CLC: clear C+X
02:000392DE 1214            	  2570:     move.b  ($0000,A4),D1
02:000392E0 D101            	  2571:     addx.b  D1,D0   ; ADC $00
                            	  2572:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  2573:     ;
02:000392E2 020000F8        	  2574:     andi.b #$F8,D0
                            	  2575:     ; Assign that result to the leever's X coordinate and [02].
                            	  2576:     ;
02:000392E6 19802070        	  2577:     move.b  D0,($70,A4,D2.W)
02:000392EA 19400002        	  2578:     move.b  D0,($0002,A4)
                            	  2579:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  2580:     ;
02:000392EE 122C0001        	  2581:     move.b  ($0001,A4),D1
02:000392F2 B001            	  2582:     cmp.b   D1,D0
02:000392F4 6510            	  2583:     bcs  _L_z04_UpdateRedLeever_Subtract
02:000392F6 1B00            	  2584:     move.b  D0,-(A5)  ; PHA
02:000392F8 102C0001        	  2585:     move.b  ($0001,A4),D0
02:000392FC 19400002        	  2586:     move.b  D0,($0002,A4)
02:00039300 101D            	  2587:     move.b  (A5)+,D0  ; PLA
02:00039302 19400001        	  2588:     move.b  D0,($0001,A4)
                            	  2589:     even
                            	  2590: _L_z04_UpdateRedLeever_Subtract:
                            	  2591:     ; The point is to get the absolute distance between the two.
                            	  2592:     ;
02:00039306 102C0001        	  2593:     move.b  ($0001,A4),D0
02:0003930A 003C0011        	  2594:     ori     #$11,CCR  ; SEC: set C+X
02:0003930E 122C0002        	  2595:     move.b  ($0002,A4),D1
02:00039312 0A3C0010        	  2596:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039316 9101            	  2597:     subx.b  D1,D0   ; SBC $02
02:00039318 0A3C0010        	  2598:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2599:     ; If the absolute distance >= $30, then return.
