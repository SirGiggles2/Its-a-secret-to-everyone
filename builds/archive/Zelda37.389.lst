                            	  1270: _L_z04_UpdateStatues_Shoot:
                            	  1271:     ; Look for an empty monster slot.
                            	  1272:     ; If none is found, return.
                            	  1273:     ;
                            	  1274:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1275:     ; object. This routine takes a shooter object, and instantiates
                            	  1276:     ; a fireball object at the shooter's location.
                            	  1277:     ;
                            	  1278:     ; The object slot we set up here will behave as the shooter.
                            	  1279:     ; For each fireball index, this object slot will have its coordinates
                            	  1280:     ; changed.
                            	  1281:     ;
                            	  1282:     ; Note that this means that:
                            	  1283:     ; 1. The first fireball made will be its own shooter.
                            	  1284:     ;    Practically, there's nothing special about this.
                            	  1285:     ; 2. If there is more than one fireball made in a frame,
                            	  1286:     ;    then two of them will come from the same statue.
                            	  1287:     ;
                            	  1288:     ;
                            	  1289:     ; Save the fireball pattern.
02:000389E6 1003            	  1290:     move.b  D3,D0
02:000389E8 1B00            	  1291:     move.b  D0,-(A5)  ; PHA
02:000389EA 4EB90004A75A    	  1292:     jsr     FindEmptyMonsterSlot
02:000389F0 0C000001        	  1293:     cmpi.b  #$01,D0
02:000389F4 101D            	  1294:     move.b  (A5)+,D0  ; PLA
02:000389F6 6400010A        	  1295:     bcc  _L_z04_UpdateStatues_Exit
                            	  1296:     ; If we found a slot, but it < 6, return.
                            	  1297:     ;
02:000389FA 0C030006        	  1298:     cmpi.b  #$06,D3
02:000389FE 65000102        	  1299:     bcs  _L_z04_UpdateStatues_Exit
                            	  1300:     ; Store the object slot in [0A].
                            	  1301:     ; Store fireball pattern in [0B].
                            	  1302:     ;
02:00038A02 1943000A        	  1303:     move.b  D3,($000A,A4)
02:00038A06 1940000B        	  1304:     move.b  D0,($000B,A4)
                            	  1305:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1306:     ;
02:00038A0A 7600            	  1307:     moveq   #0,D3
02:00038A0C 1600            	  1308:     move.b  D0,D3
02:00038A0E 7400            	  1309:     moveq   #0,D2
02:00038A10 41F9000389A2    	  1310:     lea     (StatueFireballCounts).l,A0
02:00038A16 14303000        	  1311:     move.b  (A0,D3.W),D2
                            	  1312:     even
                            	  1313: _L_z04_UpdateStatues_LoopFireball:
                            	  1314:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1315:     ;
                            	  1316:     ; Decrement the fireball timer at this index.
                            	  1317:     ;
02:00038A1A 7600            	  1318:     moveq   #0,D3
02:00038A1C 41EC04E8        	  1319:     lea     ($04E8,A4),A0
02:00038A20 16302000        	  1320:     move.b  (A0,D2.W),D3
02:00038A24 5303            	  1321:     subq.b  #1,D3
02:00038A26 1003            	  1322:     move.b  D3,D0
02:00038A28 41EC04E8        	  1323:     lea     ($04E8,A4),A0
02:00038A2C 11802000        	  1324:     move.b  D0,(A0,D2.W)
                            	  1325:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1326:     ; to make a fireball. Go loop again.
                            	  1327:     ;
02:00038A30 5203            	  1328:     addq.b  #1,D3
02:00038A32 660000C8        	  1329:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1330:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1331:     ; This fireball index will wait another $100 frames.
                            	  1332:     ;
02:00038A36 10342018        	  1333:     move.b  ($18,A4,D2.W),D0
02:00038A3A 0C0000F0        	  1334:     cmpi.b  #$F0,D0
02:00038A3E 640000BC        	  1335:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1336:     ; Else choose one of four start times for the fireball based on
                            	  1337:     ; the random value.
                            	  1338:     ;
02:00038A42 02000003        	  1339:     andi.b #$03,D0
02:00038A46 7600            	  1340:     moveq   #0,D3
02:00038A48 1600            	  1341:     move.b  D0,D3
02:00038A4A 41F9000389A6    	  1342:     lea     (StatueFireballStartTimes).l,A0
02:00038A50 10303000        	  1343:     move.b  (A0,D3.W),D0
02:00038A54 41EC04E8        	  1344:     lea     ($04E8,A4),A0
02:00038A58 11802000        	  1345:     move.b  D0,(A0,D2.W)
                            	  1346:     ; The coordinate lists are divided into sets for each pattern.
                            	  1347:     ;
                            	  1348:     ; Look up the index of the base of the set for the pattern in use.
                            	  1349:     ; Add it to the fireball index in X register to get the index of
                            	  1350:     ; the coordinate we want within each coordinate list.
                            	  1351:     ;
                            	  1352:     ;
                            	  1353:     ; Pattern
02:00038A5C 7600            	  1354:     moveq   #0,D3
02:00038A5E 162C000B        	  1355:     move.b  ($000B,A4),D3
02:00038A62 1002            	  1356:     move.b  D2,D0
02:00038A64 023C00EE        	  1357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038A68 41F9000389AA    	  1358:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00038A6E 12303000        	  1359:     move.b  (A0,D3.W),D1
02:00038A72 D101            	  1360:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:00038A74 7600            	  1361:     moveq   #0,D3
02:00038A76 1600            	  1362:     move.b  D0,D3
02:00038A78 1002            	  1363:     move.b  D2,D0
02:00038A7A 1B00            	  1364:     move.b  D0,-(A5)  ; PHA
                            	  1365:     ; Get Link's coordinates into [00] and [01].
                            	  1366:     ;
02:00038A7C 7400            	  1367:     moveq   #0,D2
02:00038A7E 4EB900049F72    	  1368:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1369:     ; Switch to the new fireball's object slot.
                            	  1370:     ;
02:00038A84 7400            	  1371:     moveq   #0,D2
02:00038A86 142C000A        	  1372:     move.b  ($000A,A4),D2
                            	  1373:     ; Look up and set the X coordinate for the fireball object.
                            	  1374:     ; Also store it in [02].
                            	  1375:     ;
02:00038A8A 41F9000389AE    	  1376:     lea     (StatueXs).l,A0
02:00038A90 10303000        	  1377:     move.b  (A0,D3.W),D0
02:00038A94 19400002        	  1378:     move.b  D0,($0002,A4)
02:00038A98 19802070        	  1379:     move.b  D0,($70,A4,D2.W)
                            	  1380:     ; Look up and set the Y coordinate for the fireball object.
                            	  1381:     ; Also store it in [03].
                            	  1382:     ;
02:00038A9C 41F9000389B6    	  1383:     lea     (StatueYs).l,A0
02:00038AA2 10303000        	  1384:     move.b  (A0,D3.W),D0
02:00038AA6 19400003        	  1385:     move.b  D0,($0003,A4)
02:00038AAA 41EC0084        	  1386:     lea     ($0084,A4),A0
02:00038AAE 11802000        	  1387:     move.b  D0,(A0,D2.W)
                            	  1388:     ; Set mask value 3 in [04].
                            	  1389:     ;
02:00038AB2 7003            	  1390:     moveq   #3,D0
02:00038AB4 19400004        	  1391:     move.b  D0,($0004,A4)
                            	  1392:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  1393:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  1394:     ;
02:00038AB8 7601            	  1395:     moveq   #1,D3
                            	  1396:     even
                            	  1397: _L_z04_UpdateStatues_LoopAxis:
02:00038ABA 10343000        	  1398:     move.b  ($00,A4,D3.W),D0
02:00038ABE 003C0011        	  1399:     ori     #$11,CCR  ; SEC: set C+X
02:00038AC2 12343002        	  1400:     move.b  ($02,A4,D3.W),D1
02:00038AC6 0A3C0010        	  1401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038ACA 9101            	  1402:     subx.b  D1,D0   ; SBC $0002,Y
02:00038ACC 0A3C0010        	  1403:     eori    #$10,CCR  ; restore X = 6502 C
02:00038AD0 0C000018        	  1404:     cmpi.b  #$18,D0
02:00038AD4 6A10            	  1405:     bpl  _anon_z04_31
02:00038AD6 0C0000E8        	  1406:     cmpi.b  #$E8,D0
02:00038ADA 6B0A            	  1407:     bmi  _anon_z04_31
02:00038ADC 122C0004        	  1408:     move.b  ($0004,A4),D1
02:00038AE0 E209            	  1409:     lsr.b  #1,D1   ; LSR $04
02:00038AE2 19410004        	  1410:     move.b  D1,($0004,A4)
                            	  1411: _anon_z04_31:
02:00038AE6 5303            	  1412:     subq.b  #1,D3
02:00038AE8 6AD0            	  1413:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  1414:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  1415:     ; 0 or 1 time, instead of 2.
                            	  1416:     ;
                            	  1417:     ; This, in turn, means that the distance between Link and the
                            	  1418:     ; fireball was >= $18 in at least one axis.
                            	  1419:     ;
                            	  1420:     ; So, we're OK to finish making the fireball.
                            	  1421:     ;
02:00038AEA 102C0004        	  1422:     move.b  ($0004,A4),D0
02:00038AEE 6706            	  1423:     beq  _anon_z04_32
02:00038AF0 7055            	  1424:     moveq   #85,D0
02:00038AF2 6100FB02        	  1425:     jsr     ShootFireball
                            	  1426: _anon_z04_32:
02:00038AF6 101D            	  1427:     move.b  (A5)+,D0  ; PLA
02:00038AF8 7400            	  1428:     moveq   #0,D2
02:00038AFA 1400            	  1429:     move.b  D0,D2
                            	  1430:     even
                            	  1431: _L_z04_UpdateStatues_NextLoopFireball:
                            	  1432:     ; Bottom of the loop.
                            	  1433:     ; Loop while fireball index >= 0.
                            	  1434:     ;
02:00038AFC 5302            	  1435:     subq.b  #1,D2
02:00038AFE 6A00FF1A        	  1436:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  1437:     even
                            	  1438: _L_z04_UpdateStatues_Exit:
02:00038B02 4E75            	  1439:     rts
                            	  1440: 
                            	  1441: ; Unknown block
02:00038B04 FF              	  1442:     dc.b    $FF, $FF, $FF
02:00038B05 FF
02:00038B06 FF
                            	  1443: 
                            	  1444:     even
                            	  1445: CheckZora:
                            	  1446:     ; If the zora attribute of this room is off, return.
                            	  1447:     ;
02:00038B08 7600            	  1448:     moveq   #0,D3
02:00038B0A 162C00EB        	  1449:     move.b  ($00EB,A4),D3
02:00038B0E 41F900FF687E    	  1450:     lea     (NES_SRAM+$087E).l,A0
02:00038B14 10303000        	  1451:     move.b  (A0,D3.W),D0
02:00038B18 02000008        	  1452:     andi.b #$08,D0
02:00038B1C 677C            	  1453:     beq  _L_z04_CheckZora_Exit
                            	  1454:     ; If zora is active, return.
                            	  1455:     ;
02:00038B1E 102C0514        	  1456:     move.b  ($0514,A4),D0
02:00038B22 6676            	  1457:     bne  _L_z04_CheckZora_Exit
                            	  1458:     ; Look for an empty monster slot. If none is found, return.
                            	  1459:     ;
02:00038B24 4EB90004A75A    	  1460:     jsr     FindEmptyMonsterSlot
02:00038B2A 676E            	  1461:     beq  _L_z04_CheckZora_Exit
                            	  1462:     ; Loop $D times looking for a water tile to put a zora on.
                            	  1463:     ; Indexed by [0D].
                            	  1464:     ;
02:00038B2C 700D            	  1465:     moveq   #13,D0
02:00038B2E 1940000D        	  1466:     move.b  D0,($000D,A4)
                            	  1467:     ; Switch to the new object slot.
                            	  1468:     ;
02:00038B32 7400            	  1469:     moveq   #0,D2
02:00038B34 142C0059        	  1470:     move.b  ($0059,A4),D2
                            	  1471:     even
                            	  1472: _L_z04_CheckZora_LoopTileCandidate:
                            	  1473:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  1474:     ; If it = 0 or $F0, go loop again.
                            	  1475:     ;
02:00038B38 7600            	  1476:     moveq   #0,D3
02:00038B3A 162C000D        	  1477:     move.b  ($000D,A4),D3
02:00038B3E 10343018        	  1478:     move.b  ($18,A4,D3.W),D0
02:00038B42 020000F0        	  1479:     andi.b #$F0,D0
02:00038B46 19802070        	  1480:     move.b  D0,($70,A4,D2.W)
02:00038B4A 6748            	  1481:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038B4C 0C0000F0        	  1482:     cmpi.b  #$F0,D0
02:00038B50 6742            	  1483:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1484:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1485:     ; If it < $50 or >= $E0, go loop again.
                            	  1486:     ;
02:00038B52 10343018        	  1487:     move.b  ($18,A4,D3.W),D0
02:00038B56 E308            	  1488:     lsl.b  #1,D0   ; ASL A
02:00038B58 E308            	  1489:     lsl.b  #1,D0   ; ASL A
02:00038B5A E308            	  1490:     lsl.b  #1,D0   ; ASL A
02:00038B5C E308            	  1491:     lsl.b  #1,D0   ; ASL A
02:00038B5E 0C000050        	  1492:     cmpi.b  #$50,D0
02:00038B62 6530            	  1493:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038B64 0C0000E0        	  1494:     cmpi.b  #$E0,D0
02:00038B68 642A            	  1495:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1496:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1497:     ;
02:00038B6A 0000000D        	  1498:     ori.b #$0D,D0
02:00038B6E 41EC0084        	  1499:     lea     ($0084,A4),A0
02:00038B72 11802000        	  1500:     move.b  D0,(A0,D2.W)
                            	  1501:     ; Get the tile at that location.
                            	  1502:     ; If it's not a water tile, then go loop again.
                            	  1503:     ;
02:00038B76 4EB9000488B2    	  1504:     jsr     GetCollidableTileStill
02:00038B7C 0C00008D        	  1505:     cmpi.b  #$8D,D0
02:00038B80 6512            	  1506:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038B82 0C000099        	  1507:     cmpi.b  #$99,D0
02:00038B86 640C            	  1508:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1509:     ; Flag the zora active, and set up the object.
                            	  1510:     ;
02:00038B88 522C0514        	  1511:     addq.b  #1,($0514,A4)
02:00038B8C 7011            	  1512:     moveq   #17,D0
02:00038B8E 4EF90004A754    	  1513:     jmp     SetTypeAndClearObject
                            	  1514: 
                            	  1515:     even
                            	  1516: _L_z04_CheckZora_NextLoopTileCandidate:
                            	  1517:     ; Bottom of the loop. Keep going until loop index [0D] = 0.
                            	  1518:     ;
02:00038B94 532C000D        	  1519:     subq.b  #1,($000D,A4)
02:00038B98 669E            	  1520:     bne  _L_z04_CheckZora_LoopTileCandidate
                            	  1521:     even
