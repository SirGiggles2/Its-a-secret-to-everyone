                            	  5586: _L_z04_Aquamentus_Move_ApplySpeed:
                            	  5587:     ; Use (direction - 1) to index the speeds.
                            	  5588:     ; This yields 0 for right, 1 for left.
                            	  5589:     ;
02:0003A882 7600            	  5590:     moveq   #0,D3
02:0003A884 41EC0098        	  5591:     lea     ($0098,A4),A0
02:0003A888 16302000        	  5592:     move.b  (A0,D2.W),D3
02:0003A88C 5303            	  5593:     subq.b  #1,D3
                            	  5594:     ; Add the speed to the X coordinate.
                            	  5595:     ;
02:0003A88E 10342070        	  5596:     move.b  ($70,A4,D2.W),D0
02:0003A892 023C00EE        	  5597:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A896 41F90003A800    	  5598:     lea     (AquamentusSpeeds).l,A0
02:0003A89C 12303000        	  5599:     move.b  (A0,D3.W),D1
02:0003A8A0 D101            	  5600:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
02:0003A8A2 19802070        	  5601:     move.b  D0,($70,A4,D2.W)
                            	  5602:     ; Decrement the distance remaining.
                            	  5603:     ;
02:0003A8A6 41EC0394        	  5604:     lea     ($0394,A4),A0
02:0003A8AA 53302000        	  5605:     subq.b  #1,(A0,D2.W)
