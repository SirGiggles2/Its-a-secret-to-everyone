02:000339BA 660E            	  2567:     bne  _L_z02_ModeEandF_WriteCharBoardCursorSpritePosition_WriteCursorCoords
02:000339BC 103C00F8        	  2568:     move.b  #$F8,D0
02:000339C0 19400208        	  2569:     move.b  D0,($0208,A4)
02:000339C4 0A3C0001        	  2570:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000339C8 4E75            	  2571:     rts
                            	  2572: 
