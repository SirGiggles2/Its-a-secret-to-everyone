02:0003C45A 41EC034F        	  9267:     lea     ($034F,A4),A0
02:0003C45E 16302000        	  9268:     move.b  (A0,D2.W),D3
02:0003C462 0C030025        	  9269:     cmpi.b  #$25,D3
02:0003C466 6702            	  9270:     beq  _anon_z04_159
