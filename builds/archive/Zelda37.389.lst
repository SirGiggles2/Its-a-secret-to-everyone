02:0003B9D0 612A            	  7891:     jsr     Gohma_SetSpriteAttributes
                            	  7892:     ; There are only two frame images for legs: left and right.
                            	  7893:     ; There are two animation frames. They are animated as follows:
                            	  7894:     ;
                            	  7895:     ; Frame 0:
                            	  7896:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  7897:     ; horizontal flipping = frame number = 0
                            	  7898:     ; 
                            	  7899:     ; Frame 1:
                            	  7900:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  7901:     ; horizontal flipping = frame number = 1
