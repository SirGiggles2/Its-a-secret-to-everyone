                            	  3141: UpdateArmos:
02:000396B6 6100ECE6        	  3142:     jsr     UpdateGoriya
                            	  3143:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3144:     ;
02:000396BA 41EC00C0        	  3145:     lea     ($00C0,A4),A0
02:000396BE 10302000        	  3146:     move.b  (A0,D2.W),D0
02:000396C2 6702            	  3147:     beq.s  __far_z_04_0026
02:000396C4 602A            	  3148:     jmp  DrawArmosAndCheckCollisions
                            	  3149: __far_z_04_0026:
                            	  3150:     ; Animate.
                            	  3151:     ;
                            	  3152:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3153:     ; then only go draw.
                            	  3154:     ;
02:000396C6 41EC03D0        	  3155:     lea     ($03D0,A4),A0
02:000396CA 53302000        	  3156:     subq.b  #1,(A0,D2.W)
02:000396CE 6702            	  3157:     beq.s  __far_z_04_0027
02:000396D0 601E            	  3158:     jmp  DrawArmosAndCheckCollisions
                            	  3159: __far_z_04_0027:
                            	  3160:     ; Armos animation frames last 6 screen frames.
                            	  3161:     ;
02:000396D2 7006            	  3162:     moveq   #6,D0
02:000396D4 41EC03D0        	  3163:     lea     ($03D0,A4),A0
02:000396D8 11802000        	  3164:     move.b  D0,(A0,D2.W)
                            	  3165:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3166:     ; change the position of the shield. To keep fixed it in place,
                            	  3167:     ; there are separate frame images for each animation frame.
                            	  3168:     ;
                            	  3169:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3170:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3171:     ;
                            	  3172:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3173:     ; Then choose the direction at the point of drawing below.
                            	  3174:     ;
02:000396DC 41EC03E4        	  3175:     lea     ($03E4,A4),A0
02:000396E0 10302000        	  3176:     move.b  (A0,D2.W),D0
02:000396E4 0A000002        	  3177:     eori.b #$02,D0
02:000396E8 41EC03E4        	  3178:     lea     ($03E4,A4),A0
02:000396EC 11802000        	  3179:     move.b  D0,(A0,D2.W)
                            	  3180:     even
                            	  3181: DrawArmosAndCheckCollisions:
02:000396F0 4EB900049F72    	  3182:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:000396F6 7600            	  3183:     moveq   #0,D3
02:000396F8 41EC0098        	  3184:     lea     ($0098,A4),A0
02:000396FC 16302000        	  3185:     move.b  (A0,D2.W),D3
                            	  3186:     ; If facing up, then use the second frame image in the set ("back").
                            	  3187:     ; Else use the second.
                            	  3188:     ;
02:00039700 0C030008        	  3189:     cmpi.b  #$08,D3
02:00039704 6602            	  3190:     bne  _anon_z04_54
02:00039706 7001            	  3191:     moveq   #1,D0
                            	  3192: _anon_z04_54:
02:00039708 023C00EE        	  3193:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003970C 41EC03E4        	  3194:     lea     ($03E4,A4),A0
02:00039710 12302000        	  3195:     move.b  (A0,D2.W),D1
02:00039714 D101            	  3196:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00039716 4EB900030C9C    	  3197:     jsr     DrawObjectNotMirrored
                            	  3198:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3199:     ; but not with weapons.
                            	  3200:     ;
02:0003971C 10342028        	  3201:     move.b  ($28,A4,D2.W),D0
02:00039720 661C            	  3202:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3203:     ; Else check for all collisions.
                            	  3204:     ;
02:00039722 4EB900031008    	  3205:     jsr     CheckMonsterCollisions
                            	  3206:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3207:     ;
02:00039728 41EC0405        	  3208:     lea     ($0405,A4),A0
02:0003972C 10302000        	  3209:     move.b  (A0,D2.W),D0
02:00039730 670A            	  3210:     beq  _anon_z04_55
02:00039732 705D            	  3211:     moveq   #93,D0
02:00039734 41EC034F        	  3212:     lea     ($034F,A4),A0
02:00039738 11802000        	  3213:     move.b  D0,(A0,D2.W)
