                            	  5652: _L_z04_Aquamentus_Shoot_LoopObject:
                            	  5653:     ; If type <> $55, loop again.
                            	  5654:     ;
02:0003A8EC 41EC034F        	  5655:     lea     ($034F,A4),A0
02:0003A8F0 10302000        	  5656:     move.b  (A0,D2.W),D0
02:0003A8F4 0C000055        	  5657:     cmpi.b  #$55,D0
02:0003A8F8 6626            	  5658:     bne  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  5659:     ; Every other screen frame, loop again.
