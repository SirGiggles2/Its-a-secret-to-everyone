02:00042464 1214            	  8716:     move.b  ($00,A4),D1   ; ptr lo
02:00042466 182C0001        	  8717:     move.b  ($01,A4),D4  ; ptr hi
02:0004246A 024100FF        	  8718:     andi.w  #$00FF,D1         ; zero-extend lo byte
