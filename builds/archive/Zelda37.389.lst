02:0003A470 41EC0478        	  5113:     lea     ($0478,A4),A0
02:0003A474 16302000        	  5114:     move.b  (A0,D2.W),D3
                            	  5115:     ; Change the coordinates to one corner.
                            	  5116:     ;
02:0003A478 10342070        	  5117:     move.b  ($70,A4,D2.W),D0
02:0003A47C 023C00EE        	  5118:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A480 41F90003A334    	  5119:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A486 12303000        	  5120:     move.b  (A0,D3.W),D1
