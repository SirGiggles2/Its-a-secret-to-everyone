02:00038C28 10342018        	  1605:     move.b  ($18,A4,D2.W),D0
02:00038C2C 0C0000F8        	  1606:     cmpi.b  #$F8,D0
02:00038C30 656C            	  1607:     bcs  _L_z04__TryShooting_Exit
                            	  1608:     even
                            	  1609: _L_z04__TryShooting_TryShootingNow:
                            	  1610:     ; Summary
                            	  1611:     ;
                            	  1612:     ; if temporarily invincible then
                            	  1613:     ;   shoot timer := 0
                            	  1614:     ; elif shoot timer > 0 then
                            	  1615:     ;   decrement shoot timer
                            	  1616:     ; elif wants to shoot then
                            	  1617:     ;   shoot timer := $30
                            	  1618:     ;
                            	  1619:     ; qspeed := [01]
                            	  1620:     ;
                            	  1621:     ; if shoot timer <> 0 then
                            	  1622:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1623:     ;     shoot
                            	  1624:     ;     if succeeded then
