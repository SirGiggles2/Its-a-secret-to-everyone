                            	   153: TransferPatternBlock_Bank2:
                            	   154:     ; PATCHED: fast bulk CHR transfer (bypasses per-byte _ppu_write_7)
02:00031210 4EB90000E32C    	   155:     jsr     _ppu_write_6          ; complete PPU addr latch pair (sets PPU_VADDR)
02:00031216 206C0004        	   156:     movea.l ($04,A4),A0           ; ROM source address
02:0003121A 323900FF0802    	   157:     move.w  (PPU_VADDR).l,D1      ; NES CHR destination address
02:00031220 7400            	   158:     moveq   #0,D2
02:00031222 142C0002        	   159:     move.b  ($0002,A4),D2         ; size hi byte
02:00031226 E14A            	   160:     lsl.w   #8,D2
02:00031228 142C0003        	   161:     move.b  ($0003,A4),D2         ; size lo byte (D2.w = total bytes)
02:0003122C 48C2            	   162:     ext.l   D2                    ; D2.l = byte count
02:0003122E 61009D64        	   163:     jsr     _transfer_chr_block_fast
02:00031232 522C051D        	   164:     addq.b  #1,($051D,A4)         ; increment block index
02:00031236 4E75            	   165:     rts
