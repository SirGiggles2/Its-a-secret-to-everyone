02:0004800A 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:0004800E 1014            	  2375:     move.b  ($0000,A4),D0
02:00048010 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00048014 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:00048018 41EC0307        	  2378:     lea     ($0307,A4),A0
02:0004801C 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:00048020 102C0001        	  2383:     move.b  ($0001,A4),D0
02:00048024 41EC0303        	  2384:     lea     ($0303,A4),A0
02:00048028 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:0004802C 41EC0308        	  2386:     lea     ($0308,A4),A0
02:00048030 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:00048034 41EC0308        	  2388:     lea     ($0308,A4),A0
02:00048038 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:0004803C 102C0005        	  2392:     move.b  ($0005,A4),D0
02:00048040 41EC0305        	  2393:     lea     ($0305,A4),A0
02:00048044 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:00048048 41EC0306        	  2395:     lea     ($0306,A4),A0
02:0004804C 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:00048050 41EC030A        	  2397:     lea     ($030A,A4),A0
02:00048054 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:00048058 41EC030B        	  2399:     lea     ($030B,A4),A0
02:0004805C 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
                            	  2403:     ; Here is an example result of this manipulation:
