02:0003926C 19802070        	  2504:     move.b  D0,($70,A4,D2.W)
                            	  2505:     ; If facing down, then use Y offset $28.
                            	  2506:     ; Else store Y offset -$28 in [00].
                            	  2507:     ;
02:00039270 7628            	  2508:     moveq   #40,D3
02:00039272 41EC0098        	  2509:     lea     ($0098,A4),A0
02:00039276 10302000        	  2510:     move.b  (A0,D2.W),D0
02:0003927A 02000008        	  2511:     andi.b #$08,D0
02:0003927E 6704            	  2512:     beq  _anon_z04_44
02:00039280 163C00D8        	  2513:     move.b  #$D8,D3
                            	  2514: _anon_z04_44:
02:00039284 1883            	  2515:     move.b  D3,($0000,A4)
                            	  2516:     ; Add Link's Y and the vertical offset.
                            	  2517:     ;
02:00039286 102C0084        	  2518:     move.b  ($0084,A4),D0
02:0003928A 023C00EE        	  2519:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003928E 1214            	  2520:     move.b  ($0000,A4),D1
02:00039290 D101            	  2521:     addx.b  D1,D0   ; ADC $00
                            	  2522:     ; Sanitize the Y coordinate:
                            	  2523:     ; (Y AND $F0) OR $D
                            	  2524:     ;
02:00039292 020000F0        	  2525:     andi.b #$F0,D0
02:00039296 0000000D        	  2526:     ori.b #$0D,D0
02:0003929A 41EC0084        	  2527:     lea     ($0084,A4),A0
02:0003929E 11802000        	  2528:     move.b  D0,(A0,D2.W)
                            	  2529:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  2530:     ; go see if the tile is valid to come out of.
                            	  2531:     ;
                            	  2532:     ; Else it's too close to the top edge of the screen. So, return.
                            	  2533:     ;
02:000392A2 0C00005D        	  2534:     cmpi.b  #$5D,D0
02:000392A6 647A            	  2535:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
