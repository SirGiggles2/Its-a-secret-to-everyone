02:00049AEC 6034            	  6204:     jmp  ResetObjState
                            	  6205: __far_z_07_0095:
02:00049AEE 0C0000EC        	  6206:     cmpi.b  #$EC,D0
02:00049AF2 6502            	  6207:     bcs.s  __far_z_07_0096
02:00049AF4 602C            	  6208:     jmp  ResetObjState
