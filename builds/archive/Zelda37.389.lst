02:0003C3C0 0C020009        	  9192:     cmpi.b  #$09,D2
02:0003C3C4 6604            	  9193:     bne  _anon_z04_157
02:0003C3C6 522C00AD        	  9194:     addq.b  #1,($00AD,A4)
