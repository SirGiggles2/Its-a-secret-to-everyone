                            	  9864: Ganon_DrawBody:
                            	  9865:     ; Loop over four 16x16 images that make up Ganon.
                            	  9866:     ; There are 6 animation frames.
                            	  9867:     ;
02:0003C882 7603            	  9868:     moveq   #3,D3
                            	  9869:     even
                            	  9870: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  9871:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  9872:     ;
02:0003C884 10342070        	  9873:     move.b  ($70,A4,D2.W),D0
02:0003C888 023C00EE        	  9874:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C88C 41F90003C876    	  9875:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C892 12303000        	  9876:     move.b  (A0,D3.W),D1
02:0003C896 D101            	  9877:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C898 1880            	  9878:     move.b  D0,($0000,A4)
                            	  9879:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  9880:     ;
02:0003C89A 41EC0084        	  9881:     lea     ($0084,A4),A0
02:0003C89E 10302000        	  9882:     move.b  (A0,D2.W),D0
02:0003C8A2 023C00EE        	  9883:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8A6 41F90003C87A    	  9884:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C8AC 12303000        	  9885:     move.b  (A0,D3.W),D1
02:0003C8B0 D101            	  9886:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C8B2 19400001        	  9887:     move.b  D0,($0001,A4)
                            	  9888:     ; Each part has a horizontal flipping flag.
                            	  9889:     ;
02:0003C8B6 41F90003C87E    	  9890:     lea     (GanonSpriteHFlips).l,A0
02:0003C8BC 10303000        	  9891:     move.b  (A0,D3.W),D0
02:0003C8C0 1940000F        	  9892:     move.b  D0,($000F,A4)
                            	  9893:     ; Save and copy the loop index (the current part) to [07].
                            	  9894:     ;
02:0003C8C4 1003            	  9895:     move.b  D3,D0
02:0003C8C6 1B00            	  9896:     move.b  D0,-(A5)  ; PHA
02:0003C8C8 19400007        	  9897:     move.b  D0,($0007,A4)
                            	  9898:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  9899:     ; that make it up.
                            	  9900:     ;
02:0003C8CC 41EC046B        	  9901:     lea     ($046B,A4),A0
02:0003C8D0 10302000        	  9902:     move.b  (A0,D2.W),D0
02:0003C8D4 E308            	  9903:     lsl.b  #1,D0   ; ASL A
02:0003C8D6 E308            	  9904:     lsl.b  #1,D0   ; ASL A
                            	  9905:     ; Add [07] -- the index of the current part.
                            	  9906:     ;
                            	  9907:     ; Now you have an index into the frame image table, for the
                            	  9908:     ; current image part of the current animation frame.
                            	  9909:     ;
02:0003C8D8 122C0007        	  9910:     move.b  ($0007,A4),D1
02:0003C8DC D101            	  9911:     addx.b  D1,D0   ; ADC $07
02:0003C8DE 7600            	  9912:     moveq   #0,D3
02:0003C8E0 1600            	  9913:     move.b  D0,D3
02:0003C8E2 41F90003C85E    	  9914:     lea     (GanonFrameImages).l,A0
02:0003C8E8 10303000        	  9915:     move.b  (A0,D3.W),D0
02:0003C8EC 4EB900030C9C    	  9916:     jsr     DrawObjectNotMirrored
02:0003C8F2 101D            	  9917:     move.b  (A5)+,D0  ; PLA
                            	  9918:     ; Bottom of the part loop.
                            	  9919:     ;
02:0003C8F4 7600            	  9920:     moveq   #0,D3
02:0003C8F6 1600            	  9921:     move.b  D0,D3
02:0003C8F8 5303            	  9922:     subq.b  #1,D3
02:0003C8FA 6A88            	  9923:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C8FC 4E75            	  9924:     rts
