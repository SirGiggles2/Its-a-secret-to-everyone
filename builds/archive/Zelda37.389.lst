                            	  1048: ; Y: position fraction
                            	  1049: ; [0F]: movement direction
                            	  1050: ;
                            	  1051: ; Returns:
                            	  1052: ; A: position fraction
                            	  1053: ;
                            	  1054: ; Load the q-speed and position fraction from the parameters.
                            	  1055: ;
                            	  1056:     even
