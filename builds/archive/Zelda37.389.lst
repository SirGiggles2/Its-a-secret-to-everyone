                            	  9272: _anon_z04_159:
02:0003C46A 61000D98        	  9273:     jsr     DecreaseObjectAngle
                            	  9274:     ; Load Patra's maneuver index.
                            	  9275:     ; It determines which counts of bits are looked up below.
                            	  9276:     ;
02:0003C46E 7600            	  9277:     moveq   #0,D3
02:0003C470 162C045F        	  9278:     move.b  ($045F,A4),D3
                            	  9279:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  9280:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  9281:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  9282:     ;
02:0003C474 41EC034F        	  9283:     lea     ($034F,A4),A0
02:0003C478 10302000        	  9284:     move.b  (A0,D2.W),D0
02:0003C47C 0C000025        	  9285:     cmpi.b  #$25,D0
02:0003C480 661E            	  9286:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003C482 41F90003C374    	  9287:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003C488 10303000        	  9288:     move.b  (A0,D3.W),D0
02:0003C48C 1B00            	  9289:     move.b  D0,-(A5)  ; PHA
02:0003C48E 41F90003C378    	  9290:     lea     (PatraChild1RotationSineBits).l,A0
02:0003C494 10303000        	  9291:     move.b  (A0,D3.W),D0
02:0003C498 7600            	  9292:     moveq   #0,D3
02:0003C49A 1600            	  9293:     move.b  D0,D3
02:0003C49C 101D            	  9294:     move.b  (A5)+,D0  ; PLA
02:0003C49E 600E            	  9295:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  9296: 
                            	  9297:     even
                            	  9298: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  9299:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  9300:     ; for both Y and X increment calculations in rotation. This leads to
                            	  9301:     ; a small circle (5) and a large circle (6).
                            	  9302:     ;
02:0003C4A0 41F90003C376    	  9303:     lea     (PatraChild2RotationBits).l,A0
02:0003C4A6 10303000        	  9304:     move.b  (A0,D3.W),D0
