                            	  9149: __far_z_04_0098:
                            	  9150:     ; State = 0.
                            	  9151:     ;
                            	  9152:     ; If the current object slot is 2, then go initialize the patra child.
                            	  9153:     ; This is the only patra child shown in the first fame.
                            	  9154:     ;
02:0003C388 0C020002        	  9155:     cmpi.b  #$02,D2
02:0003C38C 6732            	  9156:     beq  _L_z04_UpdatePatraChild_Ready
                            	  9157:     ; The patra child in slot 2 is the last one to be updated.
                            	  9158:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  9159:     ;
                            	  9160:     ; This means that in the first frame, slot 2 is the only one to be
                            	  9161:     ; shown.
                            	  9162:     ;
02:0003C38E 102C00AE        	  9163:     move.b  ($00AE,A4),D0
02:0003C392 6700008E        	  9164:     beq  _L_z04_UpdatePatraChild_Exit
                            	  9165:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  9166:     ; here to wait to be shown at the top position (N) one at a time.
                            	  9167:     ;
02:0003C396 1002            	  9168:     move.b  D2,D0
                            	  9169:     ; Subtract 3 from the object slot to get the angle where the
                            	  9170:     ; patra child in object slot 2 should be for the current one to appear.
                            	  9171:     ;
02:0003C398 003C0011        	  9172:     ori     #$11,CCR  ; SEC: set C+X
02:0003C39C 123C0003        	  9173:     move.b  #$03,D1
02:0003C3A0 0A3C0010        	  9174:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C3A4 9101            	  9175:     subx.b  D1,D0   ; SBC #$03
02:0003C3A6 0A3C0010        	  9176:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C3AA 7600            	  9177:     moveq   #0,D3
02:0003C3AC 1600            	  9178:     move.b  D0,D3
                            	  9179:     ; If the patra child in slot 2 has not reached the required angle,
                            	  9180:     ; then return.
                            	  9181:     ;
02:0003C3AE 102C0396        	  9182:     move.b  ($0396,A4),D0
02:0003C3B2 41F90003C36C    	  9183:     lea     (PatraChildStartAngles).l,A0
02:0003C3B8 12303000        	  9184:     move.b  (A0,D3.W),D1
02:0003C3BC B001            	  9185:     cmp.b   D1,D0
02:0003C3BE 6662            	  9186:     bne  _L_z04_UpdatePatraChild_Exit
                            	  9187:     even
                            	  9188: _L_z04_UpdatePatraChild_Ready:
                            	  9189:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  9190:     ; the patra parent's state.
