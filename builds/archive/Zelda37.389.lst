02:0004970C 41EC00AC        	  5706:     lea     ($00AC,A4),A0
02:00049710 11803000        	  5707:     move.b  D0,(A0,D3.W)
02:00049714 0A3C0001        	  5708:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00049718 4E75            	  5709:     rts
