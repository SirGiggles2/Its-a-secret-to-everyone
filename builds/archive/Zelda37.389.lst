02:0003A70E 122C0002        	  5406:     move.b  ($0002,A4),D1
02:0003A712 E309            	  5407:     lsl.b  #1,D1   ; ASL $02
02:0003A714 19410002        	  5408:     move.b  D1,($0002,A4)
02:0003A718 122C0002        	  5409:     move.b  ($0002,A4),D1
02:0003A71C C200            	  5410:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A71E 671E            	  5411:     beq  _L_z04_Digdogger_Move_End
02:0003A720 41EC0084        	  5412:     lea     ($0084,A4),A0
02:0003A724 10302000        	  5413:     move.b  (A0,D2.W),D0
02:0003A728 122C0003        	  5414:     move.b  ($0003,A4),D1
02:0003A72C 0A3C0010        	  5415:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A730 9101            	  5416:     subx.b  D1,D0   ; SBC $03
02:0003A732 0A3C0010        	  5417:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A736 41EC0084        	  5418:     lea     ($0084,A4),A0
02:0003A73A 11802000        	  5419:     move.b  D0,(A0,D2.W)
                            	  5420:     even
