                            	   107: _L_z02_TransferCommonPatterns_LoopBlock:
02:0003119E 102C051D        	   108:     move.b  ($051D,A4),D0
02:000311A2 E308            	   109:     lsl.b  #1,D0   ; ASL A
02:000311A4 7400            	   110:     moveq   #0,D2
02:000311A6 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:000311A8 41F90003117A    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:000311AE 3A02            	   117:     move.w  D2,D5
02:000311B0 DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:000311B2 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:000311B6 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:000311BA 41F900031186    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:000311C0 10302000        	   122:     move.b  (A0,D2.W),D0
02:000311C4 19400002        	   123:     move.b  D0,($0002,A4)
02:000311C8 41F90003118C    	   124:     lea     (CommonPatternVramAddrs).l,A0
02:000311CE 10302000        	   125:     move.b  (A0,D2.W),D0
02:000311D2 4EB90000E32C    	   126:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:000311D8 5202            	   127:     addq.b  #1,D2
                            	   128:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:000311DA 41F900031186    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:000311E0 10302000        	   130:     move.b  (A0,D2.W),D0
02:000311E4 19400003        	   131:     move.b  D0,($0003,A4)
02:000311E8 41F90003118C    	   132:     lea     (CommonPatternVramAddrs).l,A0
02:000311EE 10302000        	   133:     move.b  (A0,D2.W),D0
02:000311F2 611C            	   134:     jsr     TransferPatternBlock_Bank2
                            	   135:     ; Loop until pattern block index = 3.
                            	   136:     ;
02:000311F4 102C051D        	   137:     move.b  ($051D,A4),D0
02:000311F8 0C000003        	   138:     cmpi.b  #$03,D0
02:000311FC 66A0            	   139:     bne  _L_z02_TransferCommonPatterns_LoopBlock
02:000311FE 705A            	   140:     moveq   #90,D0
02:00031200 194000F5        	   141:     move.b  D0,($00F5,A4)
02:00031204 7000            	   142:     moveq   #0,D0
02:00031206 1940051D        	   143:     move.b  D0,($051D,A4)
02:0003120A 0A3C0001        	   144:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003120E 4E75            	   145:     rts
                            	   146: 
                            	   147: ; Params:
                            	   148: ; [00:01]: source address
                            	   149: ; [03:02]: size
                            	   150: ; A: low byte of desination VRAM address
                            	   151: ;
