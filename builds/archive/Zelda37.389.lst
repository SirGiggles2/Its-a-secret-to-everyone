                            	  2397:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  2398:     ;
02:00039192 003C0011        	  2399:     ori     #$11,CCR  ; SEC: set C+X
02:00039196 123C0001        	  2400:     move.b  #$01,D1
02:0003919A 0A3C0010        	  2401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
