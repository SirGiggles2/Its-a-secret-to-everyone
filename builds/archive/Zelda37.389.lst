                            	 10074: _anon_z04_165:
02:0003CA08 1003            	 10075:     move.b  D3,D0
02:0003CA0A 1B00            	 10076:     move.b  D0,-(A5)  ; PHA
                            	 10077:     ; Get the length, to append to the dynamic transfer buf.
                            	 10078:     ;
02:0003CA0C 7400            	 10079:     moveq   #0,D2
02:0003CA0E 142C0301        	 10080:     move.b  ($0301,A4),D2
                            	 10081:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 10082:     ;
02:0003CA12 7600            	 10083:     moveq   #0,D3
                            	 10084:     even
                            	 10085: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003CA14 41F90003C9EC    	 10086:     lea     (GanonColorTransferRecord).l,A0
02:0003CA1A 10303000        	 10087:     move.b  (A0,D3.W),D0
02:0003CA1E 41EC0302        	 10088:     lea     ($0302,A4),A0
02:0003CA22 11802000        	 10089:     move.b  D0,(A0,D2.W)
02:0003CA26 5202            	 10090:     addq.b  #1,D2
02:0003CA28 5203            	 10091:     addq.b  #1,D3
02:0003CA2A 0C030008        	 10092:     cmpi.b  #$08,D3
02:0003CA2E 66E4            	 10093:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003CA30 19420301        	 10094:     move.b  D2,($0301,A4)
02:0003CA34 101D            	 10095:     move.b  (A5)+,D0  ; PLA
02:0003CA36 7600            	 10096:     moveq   #0,D3
02:0003CA38 1600            	 10097:     move.b  D0,D3
                            	 10098:     ; Overwrite the last 3 colors in the record, with the ones
                            	 10099:     ; ending at the index passed in.
                            	 10100:     ;
02:0003CA3A 7402            	 10101:     moveq   #2,D2
                            	 10102:     even
