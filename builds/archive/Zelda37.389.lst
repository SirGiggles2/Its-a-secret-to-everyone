                            	  5678:     ;
02:000496E6 7000            	  5679:     moveq   #0,D0
02:000496E8 41EC0380        	  5680:     lea     ($0380,A4),A0
02:000496EC 11802000        	  5681:     move.b  D0,(A0,D2.W)
02:000496F0 0C02000D        	  5682:     cmpi.b  #$0D,D2
02:000496F4 6524            	  5683:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5684:     ; Link has caught the boomerang.
                            	  5685:     ;
                            	  5686:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5687:     ;
                            	  5688:     ; If Link catches it some time after throwing it,
                            	  5689:     ; his state will become $20, and he will show the catch animation.
                            	  5690:     ;
                            	  5691:     ; But if he catches it right after throwing it, the state becomes
                            	  5692:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5693:     ;
02:000496F6 102C00AC        	  5694:     move.b  ($00AC,A4),D0
02:000496FA 00000020        	  5695:     ori.b #$20,D0
02:000496FE 194000AC        	  5696:     move.b  D0,($00AC,A4)
                            	  5697:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5698:     ; up the new state.
                            	  5699:     ;
02:00049702 7001            	  5700:     moveq   #1,D0
02:00049704 194003D0        	  5701:     move.b  D0,($03D0,A4)
