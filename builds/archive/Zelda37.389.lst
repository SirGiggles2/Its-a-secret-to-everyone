                            	  5611: Aquamentus_Shoot:
                            	  5612:     ; If the object timer <> 0, then
                            	  5613:     ; go modify fireballs that might still be flying.
                            	  5614:     ;
02:0003A8B0 10342028        	  5615:     move.b  ($28,A4,D2.W),D0
02:0003A8B4 6634            	  5616:     bne  _L_z04_Aquamentus_Shoot_SpreadOutFireballs
                            	  5617:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  5618:     ;
                            	  5619:     ; Set the timer to a random time, at least $70 frames.
                            	  5620:     ;
02:0003A8B6 10342018        	  5621:     move.b  ($18,A4,D2.W),D0
02:0003A8BA 00000070        	  5622:     ori.b #$70,D0
02:0003A8BE 19802028        	  5623:     move.b  D0,($28,A4,D2.W)
                            	  5624:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  5625:     ;
02:0003A8C2 6168            	  5626:     jsr     ShootFireball55
02:0003A8C4 7000            	  5627:     moveq   #0,D0
02:0003A8C6 41EC0478        	  5628:     lea     ($0478,A4),A0
02:0003A8CA 11803000        	  5629:     move.b  D0,(A0,D3.W)
                            	  5630:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  5631:     ;
02:0003A8CE 615C            	  5632:     jsr     ShootFireball55
02:0003A8D0 7001            	  5633:     moveq   #1,D0
02:0003A8D2 41EC0478        	  5634:     lea     ($0478,A4),A0
02:0003A8D6 11803000        	  5635:     move.b  D0,(A0,D3.W)
                            	  5636:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  5637:     ;
02:0003A8DA 6150            	  5638:     jsr     ShootFireball55
02:0003A8DC 103C00FF        	  5639:     move.b  #$FF,D0
02:0003A8E0 41EC0478        	  5640:     lea     ($0478,A4),A0
02:0003A8E4 11803000        	  5641:     move.b  D0,(A0,D3.W)
02:0003A8E8 4E75            	  5642:     rts
