02:0003ADD6 023C00EE        	  6330:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADDA 41F90003ACB8    	  6331:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003ADE0 12303000        	  6332:     move.b  (A0,D3.W),D1
