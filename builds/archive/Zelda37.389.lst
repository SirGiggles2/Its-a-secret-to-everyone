                            	  9196:     ; Go to state 1 to orbit.
                            	  9197:     ;
02:0003C3CA 41EC00AC        	  9198:     lea     ($00AC,A4),A0
02:0003C3CE 52302000        	  9199:     addq.b  #1,(A0,D2.W)
                            	  9200:     ; TODO: ?
                            	  9201:     ;
