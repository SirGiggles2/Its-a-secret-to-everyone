02:0003AE78 10302000        	  6395:     move.b  (A0,D2.W),D0
02:0003AE7C 41EC042C        	  6396:     lea     ($042C,A4),A0
02:0003AE80 12302000        	  6397:     move.b  (A0,D2.W),D1
02:0003AE84 B001            	  6398:     cmp.b   D1,D0
02:0003AE86 65000096        	  6399:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  6400:     ; Else reached the destination. Go to state 0.
                            	  6401:     ;
02:0003AE8A 7000            	  6402:     moveq   #0,D0
02:0003AE8C 41EC00AC        	  6403:     lea     ($00AC,A4),A0
02:0003AE90 11802000        	  6404:     move.b  D0,(A0,D2.W)
                            	  6405:     ; Reset 16-bit vertical speed.
                            	  6406:     ;
02:0003AE94 41EC0444        	  6407:     lea     ($0444,A4),A0
02:0003AE98 11802000        	  6408:     move.b  D0,(A0,D2.W)
02:0003AE9C 41EC0412        	  6409:     lea     ($0412,A4),A0
02:0003AEA0 11802000        	  6410:     move.b  D0,(A0,D2.W)
                            	  6411:     ; Choose a random direction to face in.
                            	  6412:     ;
02:0003AEA4 10342018        	  6413:     move.b  ($18,A4,D2.W),D0
02:0003AEA8 02000003        	  6414:     andi.b #$03,D0
02:0003AEAC 7600            	  6415:     moveq   #0,D3
02:0003AEAE 1600            	  6416:     move.b  D0,D3
02:0003AEB0 41F90003ACC0    	  6417:     lea     (PolsVoiceDirections).l,A0
02:0003AEB6 10303000        	  6418:     move.b  (A0,D3.W),D0
02:0003AEBA 41EC0098        	  6419:     lea     ($0098,A4),A0
02:0003AEBE 11802000        	  6420:     move.b  D0,(A0,D2.W)
                            	  6421:     ; Randomly set distance-to-move to $30 or $70.
                            	  6422:     ;
