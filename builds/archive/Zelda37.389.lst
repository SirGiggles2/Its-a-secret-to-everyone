02:000394C2 41EC03E4        	  2824:     lea     ($03E4,A4),A0
02:000394C6 12302000        	  2825:     move.b  (A0,D2.W),D1
02:000394CA B300            	  2826:     eor.b  D1,D0
02:000394CC 41EC03E4        	  2827:     lea     ($03E4,A4),A0
02:000394D0 11802000        	  2828:     move.b  D0,(A0,D2.W)
                            	  2829:     even
