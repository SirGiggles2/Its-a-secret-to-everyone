                            	  2541: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  2542:     ; Begin with the leever's Y set to Link's Y.
                            	  2543:     ;
02:000392AA 102C0084        	  2544:     move.b  ($0084,A4),D0
02:000392AE 41EC0084        	  2545:     lea     ($0084,A4),A0
02:000392B2 11802000        	  2546:     move.b  D0,(A0,D2.W)
                            	  2547:     ; If Y coordinate < $5D (top of the third square row), then
                            	  2548:     ; it's too close to the top edge of the screen. So, return.
                            	  2549:     ;
02:000392B6 0C00005D        	  2550:     cmpi.b  #$5D,D0
02:000392BA 65EC            	  2551:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  2552:     ; If facing right, then use X offset $28.
                            	  2553:     ; Else store X offset -$28 in [00].
                            	  2554:     ;
02:000392BC 7628            	  2555:     moveq   #40,D3
02:000392BE 41EC0098        	  2556:     lea     ($0098,A4),A0
02:000392C2 10302000        	  2557:     move.b  (A0,D2.W),D0
02:000392C6 02000002        	  2558:     andi.b #$02,D0
02:000392CA 6704            	  2559:     beq  _anon_z04_45
