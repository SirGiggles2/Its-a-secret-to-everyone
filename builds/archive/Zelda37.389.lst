                            	  7323: _L_z07_InitObject_InitMonsterFromEdge:
02:0004A3AE 7400            	  7324:     moveq   #0,D2
02:0004A3B0 142C0340        	  7325:     move.b  ($0340,A4),D2
                            	  7326:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7327:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7328:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7329:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7330:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7331:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7332:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7333:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7334:     ; corrupting them and causing a deterministic address-error
                            	  7335:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7336:     ; identified by Codex static review.)
                            	  7337: _L_z07_P47_pre_check:
02:0004A3B4 102C0525        	  7338:     move.b  ($0525,A4),D0
02:0004A3B8 020000F0        	  7339:     andi.b  #$F0,D0
02:0004A3BC 0C000040        	  7340:     cmpi.b  #$40,D0
02:0004A3C0 6506            	  7341:     blo     _L_z07_P47_pre_snap
02:0004A3C2 0C0000E0        	  7342:     cmpi.b  #$E0,D0
02:0004A3C6 6506            	  7343:     blo     _L_z07_P47_pre_ok
                            	  7344: _L_z07_P47_pre_snap:
02:0004A3C8 197C00480525    	  7345:     move.b  #$48,($0525,A4)
                            	  7346: _L_z07_P47_pre_ok:
02:0004A3CE 7005            	  7347:     moveq   #5,D0
02:0004A3D0 610004F4        	  7348:     jsr     SwitchBank
02:0004A3D4 4EB90003EFA6    	  7349:     jsr     FindNextEdgeSpawnCell
                            	  7350:     ; Post-walk 1: bottom-edge snap.
02:0004A3DA 102C0525        	  7351:     move.b  ($0525,A4),D0
02:0004A3DE 020000F0        	  7352:     andi.b  #$F0,D0
02:0004A3E2 0C0000E0        	  7353:     cmpi.b  #$E0,D0
02:0004A3E6 660C            	  7354:     bne     _L_z07_P47_post1_ok
02:0004A3E8 197C00480525    	  7355:     move.b  #$48,($0525,A4)
02:0004A3EE 4EB90003EFA6    	  7356:     jsr     FindNextEdgeSpawnCell
                            	  7357: _L_z07_P47_post1_ok:
                            	  7358:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7359:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004A3F4 7600            	  7360:     moveq   #0,D3
02:0004A3F6 162C0525        	  7361:     move.b  ($0525,A4),D3
02:0004A3FA 0243000F        	  7362:     andi.w  #$000F,D3
02:0004A3FE C6FC002C        	  7363:     mulu.w  #44,D3
02:0004A402 203C00FF6530    	  7364:     move.l  #$FF6530,D0
02:0004A408 D083            	  7365:     add.l   D3,D0
02:0004A40A 7600            	  7366:     moveq   #0,D3
02:0004A40C 162C0525        	  7367:     move.b  ($0525,A4),D3
02:0004A410 E84B            	  7368:     lsr.w   #4,D3
02:0004A412 5943            	  7369:     subi.w  #4,D3
02:0004A414 E34B            	  7370:     lsl.w   #1,D3
02:0004A416 D083            	  7371:     add.l   D3,D0
02:0004A418 2040            	  7372:     movea.l D0,A0
02:0004A41A 1010            	  7373:     move.b  (A0),D0
02:0004A41C 0C000084        	  7374:     cmpi.b  #$84,D0
02:0004A420 6544            	  7375:     blo     _L_z07_P47_post2_ok
                            	  7376:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7377:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7378:     ; writes to the $05xx region.
02:0004A422 7800            	  7379:     moveq   #0,D4
                            	  7380: _L_z07_P47_fb_loop:
02:0004A424 41FAE49E        	  7381:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004A428 12304000        	  7382:     move.b  (A0,D4.W),D1
02:0004A42C 19410525        	  7383:     move.b  D1,($0525,A4)
                            	  7384:     ; Validate fallback cell walkable.
02:0004A430 7600            	  7385:     moveq   #0,D3
02:0004A432 1601            	  7386:     move.b  D1,D3
02:0004A434 0243000F        	  7387:     andi.w  #$000F,D3
02:0004A438 C6FC002C        	  7388:     mulu.w  #44,D3
02:0004A43C 203C00FF6530    	  7389:     move.l  #$FF6530,D0
02:0004A442 D083            	  7390:     add.l   D3,D0
02:0004A444 7600            	  7391:     moveq   #0,D3
02:0004A446 1601            	  7392:     move.b  D1,D3
02:0004A448 E84B            	  7393:     lsr.w   #4,D3
02:0004A44A 5943            	  7394:     subi.w  #4,D3
02:0004A44C E34B            	  7395:     lsl.w   #1,D3
02:0004A44E D083            	  7396:     add.l   D3,D0
02:0004A450 2040            	  7397:     movea.l D0,A0
02:0004A452 0C100084        	  7398:     cmpi.b  #$84,(A0)
02:0004A456 650E            	  7399:     blo     _L_z07_P47_post2_ok
02:0004A458 5204            	  7400:     addq.b  #1,D4
02:0004A45A 0C040008        	  7401:     cmpi.b  #8,D4
02:0004A45E 65C4            	  7402:     blo     _L_z07_P47_fb_loop
                            	  7403:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7404:     ; rather than looping).
02:0004A460 197C00480525    	  7405:     move.b  #$48,($0525,A4)
                            	  7406: _L_z07_P47_post2_ok:
                            	  7407:     ; Extract and set the monster's location.
                            	  7408:     ;
02:0004A466 102C0525        	  7409:     move.b  ($0525,A4),D0
                            	  7410:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7411:     ;
02:0004A46A 1B00            	  7412:     move.b  D0,-(A5)  ; PHA
02:0004A46C E308            	  7413:     lsl.b  #1,D0   ; ASL A
02:0004A46E E308            	  7414:     lsl.b  #1,D0   ; ASL A
02:0004A470 E308            	  7415:     lsl.b  #1,D0   ; ASL A
02:0004A472 E308            	  7416:     lsl.b  #1,D0   ; ASL A
02:0004A474 19802070        	  7417:     move.b  D0,($70,A4,D2.W)
                            	  7418:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7419:     ;
02:0004A478 101D            	  7420:     move.b  (A5)+,D0  ; PLA
02:0004A47A 020000F0        	  7421:     andi.b #$F0,D0
02:0004A47E 003C0011        	  7422:     ori     #$11,CCR  ; SEC: set C+X
02:0004A482 123C0003        	  7423:     move.b  #$03,D1
02:0004A486 0A3C0010        	  7424:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A48A 9101            	  7425:     subx.b  D1,D0   ; SBC #$03
02:0004A48C 0A3C0010        	  7426:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A490 41EC0084        	  7427:     lea     ($0084,A4),A0
02:0004A494 11802000        	  7428:     move.b  D0,(A0,D2.W)
                            	  7429:     ; Set the monsters-from-edges long timer to a random value
                            	  7430:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7431:     ;
02:0004A498 10342019        	  7432:     move.b  ($19,A4,D2.W),D0
02:0004A49C 02000003        	  7433:     andi.b #$03,D0
02:0004A4A0 023C00EE        	  7434:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A4A4 123C0002        	  7435:     move.b  #$02,D1
02:0004A4A8 D101            	  7436:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004A4AA 1940004B        	  7437:     move.b  D0,($004B,A4)
                            	  7438:     ; If the distance to Link is too close to Link, then
                            	  7439:     ; go flag the monster uninitialized again, so we can
                            	  7440:     ; try to spawn it again next time.
                            	  7441:     ;
02:0004A4AE 7005            	  7442:     moveq   #5,D0
02:0004A4B0 61000414        	  7443:     jsr     SwitchBank
02:0004A4B4 4EB90003E5B6    	  7444:     jsr     IsDistanceSafeToSpawn
02:0004A4BA 6500FEB4        	  7445:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7446:     ; OK to spawn.
                            	  7447:     ; In this situation, monsters don't spawn from a cloud.
                            	  7448:     ;
02:0004A4BE 7000            	  7449:     moveq   #0,D0
02:0004A4C0 41EC0405        	  7450:     lea     ($0405,A4),A0
02:0004A4C4 11802000        	  7451:     move.b  D0,(A0,D2.W)
                            	  7452:     even
                            	  7453: _L_z07_InitObject_NormalSpawn:
02:0004A4C8 7004            	  7454:     moveq   #4,D0
