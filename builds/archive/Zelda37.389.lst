02:0003C3D6 41EC0098        	  9203:     lea     ($0098,A4),A0
02:0003C3DA 11802000        	  9204:     move.b  D0,(A0,D2.W)
                            	  9205:     ; Set angle $18 (N).
                            	  9206:     ;
02:0003C3DE 7018            	  9207:     moveq   #24,D0
02:0003C3E0 41EC0394        	  9208:     lea     ($0394,A4),A0
02:0003C3E4 11802000        	  9209:     move.b  D0,(A0,D2.W)
                            	  9210:     ; This location is right above Patra.
                            	  9211:     ; Set X coordinate to Patra's.
                            	  9212:     ;
02:0003C3E8 102C0071        	  9213:     move.b  ($0071,A4),D0
02:0003C3EC 19802070        	  9214:     move.b  D0,($70,A4,D2.W)
                            	  9215:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  9216:     ; Else use radius $18. Store the chosen value in [00].
                            	  9217:     ;
02:0003C3F0 702C            	  9218:     moveq   #44,D0
02:0003C3F2 7600            	  9219:     moveq   #0,D3
02:0003C3F4 41EC034F        	  9220:     lea     ($034F,A4),A0
02:0003C3F8 16302000        	  9221:     move.b  (A0,D2.W),D3
02:0003C3FC 0C030025        	  9222:     cmpi.b  #$25,D3
02:0003C400 6702            	  9223:     beq  _anon_z04_158
02:0003C402 7018            	  9224:     moveq   #24,D0
                            	  9225: _anon_z04_158:
02:0003C404 1880            	  9226:     move.b  D0,($0000,A4)
                            	  9227:     ; This location is right above Patra.
                            	  9228:     ; Set Y coordinate to (Patra's Y - [00]).
