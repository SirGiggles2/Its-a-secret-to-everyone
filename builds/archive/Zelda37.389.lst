02:0004247C 10303000        	  8724:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042480 02000020        	  8725:     andi.b #$20,D0
                            	  8726:     ; If it's been visited, then check each of the 4 doors,
