01:000000E2 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E3 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E4 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E5 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E6 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E7 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E8 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000E9 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000EA 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000EB 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000EC 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000ED 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000EE 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000EF 20              	     1R         dc.b    $20                             ; $1C8 notes (spaces)   (40)
                            	     2R     
01:000000F0 4A55452020202020	   174:     dc.b    "JUE             "                  ; $1F0 regions          (16)
01:000000F8 2020202020202020
                            	   175: 
                            	   176: ;==============================================================================
                            	   177: ; $000200 — Boot code
                            	   178: ;==============================================================================
                            	   179: 
                            	   180:     ; Stage-2a: named section; build/genesis.ld pins to $200.
                            	   181:     section "text",code
                            	   182: 
                            	   183: ;------------------------------------------------------------------------------
                            	   184: ; EntryPoint — 68000 reset vector lands here.
                            	   185: ; The 68000 boots with SR = $2700 (supervisor, all IRQs masked). We leave
                            	   186: ; interrupts masked through the entire init sequence and lower the mask at
                            	   187: ; the end of MainLoop via the STOP instruction.
                            	   188: ;------------------------------------------------------------------------------
                            	   189: EntryPoint:
                            	   190:     ;--------------------------------------------------------------------------
                            	   191:     ; TMSS handshake — check VERSION_PORT bit[0]; if set, this is a TMSS
                            	   192:     ; hardware revision that requires writing 'SEGA' ($53454741) to $A14000
                            	   193:     ; before VDP access is allowed. Safe to skip on pre-TMSS hardware.
                            	   194:     ;--------------------------------------------------------------------------
02:00000000 103900A10001    	   195:     move.b  (VERSION_PORT).l,D0
02:00000006 0200000F        	   196:     andi.b  #$0F,D0
02:0000000A 6710            	   197:     beq.s   .skip_tmss
02:0000000C 23FC5345474100A1	   198:     move.l  #$53454741,(TMSS_PORT).l   ; 'S','E','G','A'
02:00000014 4000
02:00000016 700F            	   199:     moveq   #15,D0
                            	   200: .tmss_delay:
02:00000018 51C8FFFE        	   201:     dbra    D0,.tmss_delay              ; ~80 cycles delay for VDP unlock
                            	   202: .skip_tmss:
                            	   203: 
                            	   204:     ;--------------------------------------------------------------------------
                            	   205:     ; Stop Z80 — hold it in reset to prevent bus contention during init.
                            	   206:     ;--------------------------------------------------------------------------
02:0000001C 33FC010000A11100	   207:     move.w  #$0100,(Z80_BUSREQ).l
02:00000024 33FC010000A11200	   208:     move.w  #$0100,(Z80_RESET).l
                            	   209: .z80wait:
02:0000002C 0839000000A11100	   210:     btst    #0,(Z80_BUSREQ).l            ; BUSACK = bit 0 of high byte $A11100;
02:00000034 66F6            	   211:     bne.s   .z80wait                    ; wait until Z80 releases the bus
                            	   212: 
                            	   213:     ;--------------------------------------------------------------------------
                            	   214:     ; VDP register init — H32 mode, display OFF during init.
                            	   215:     ;
                            	   216:     ; COLORFIX: Reg 0 = $8004. bit 2 MUST BE 1.
                            	   217:     ;   $8000 (bit2=0) → dingy/dark colors on hardware despite correct CRAM.
                            	   218:     ;   $8004 (bit2=1) → correct colors.
                            	   219:     ;--------------------------------------------------------------------------
02:00000036 33FC800400C00004	   220:     move.w  #$8004,(VDP_CTRL).l  ; Reg  0: bit2=1 (colorfix), no H-int, no left-blank
02:0000003E 33FC813400C00004	   221:     move.w  #$8134,(VDP_CTRL).l  ; Reg  1: display OFF, VBlank IRQ, DMA, M5 (Genesis)
02:00000046 33FC823000C00004	   222:     move.w  #$8230,(VDP_CTRL).l  ; Reg  2: Plane A @ $C000  ($C000/$2000=6 → $30)
02:0000004E 33FC832C00C00004	   223:     move.w  #$832C,(VDP_CTRL).l  ; Reg  3: Window  @ $B000  (bits[5:1]=22 → $2C)
02:00000056 33FC840700C00004	   224:     move.w  #$8407,(VDP_CTRL).l  ; Reg  4: Plane B @ $E000  ($E000/$2000=7 → $07)
02:0000005E 33FC857C00C00004	   225:     move.w  #$857C,(VDP_CTRL).l  ; Reg  5: Sprite table @ $F800 ($F800/$200=124 → $7C)
02:00000066 33FC860000C00004	   226:     move.w  #$8600,(VDP_CTRL).l  ; Reg  6: sprite table high bit = 0
02:0000006E 33FC870000C00004	   227:     move.w  #$8700,(VDP_CTRL).l  ; Reg  7: BG color = palette 0, color 0
02:00000076 33FC880000C00004	   228:     move.w  #$8800,(VDP_CTRL).l  ; Reg  8: SMS compat = 0 (unused in M5)
02:0000007E 33FC890000C00004	   229:     move.w  #$8900,(VDP_CTRL).l  ; Reg  9: SMS compat = 0 (unused in M5)
02:00000086 33FC8AFF00C00004	   230:     move.w  #$8AFF,(VDP_CTRL).l  ; Reg 10: H-int counter = $FF (effectively disabled)
02:0000008E 33FC8B0000C00004	   231:     move.w  #$8B00,(VDP_CTRL).l  ; Reg 11: full-screen V-scroll, full H-scroll
02:00000096 33FC8C0000C00004	   232:     move.w  #$8C00,(VDP_CTRL).l  ; Reg 12: H32 (bits7,0=0), no interlace, no shadow/hl
02:0000009E 33FC8D3F00C00004	   233:     move.w  #$8D3F,(VDP_CTRL).l  ; Reg 13: H-scroll table @ $FC00 ($FC00/$400=63 → $3F)
02:000000A6 33FC8E0000C00004	   234:     move.w  #$8E00,(VDP_CTRL).l  ; Reg 14: pattern gen base = 0 (SMS compat, unused M5)
02:000000AE 33FC8F0200C00004	   235:     move.w  #$8F02,(VDP_CTRL).l  ; Reg 15: auto-increment = 2 (word per VRAM access)
02:000000B6 33FC901100C00004	   236:     move.w  #$9011,(VDP_CTRL).l  ; Reg 16: scroll size 64H × 64V → $11
02:000000BE 33FC910000C00004	   237:     move.w  #$9100,(VDP_CTRL).l  ; Reg 17: window H position = 0 (H window off)
                            	   238:     ; Phase 2 v2: enable Window for top 8 rows (HUD isolation).
                            	   239:     ; $2000-$20FF NES nametable writes (rows 0-7) route to Window at $B000
                            	   240:     ; via _ppu_write_7 AND _transfer_tilebuf_fast HUD branches.  Plane A
                            	   241:     ; bulk writes to rows 0-7 stay at $C000 — invisible under Window overlay.
02:000000C6 33FC920800C00004	   242:     move.w  #$9208,(VDP_CTRL).l  ; Reg 18: window V position = 8 (covers rows 0-7)
                            	   243:     ; Regs 19-23 (DMA) intentionally SKIPPED — writing reg 23 arms the
                            	   244:     ; VDP DMA pending state on real hardware, causing subsequent CRAM/VRAM
                            	   245:     ; commands to be intercepted as DMA triggers.  DMA regs default to 0
                            	   246:     ; and must only be written immediately before a DMA operation.
                            	   247: 
                            	   248:     ;--------------------------------------------------------------------------
                            	   249:     ; Phase 6.2: Clear VRAM via VDP DMA fill.
                            	   250:     ; With display off and no other DMA pending, a single 64 KB byte-fill
                            	   251:     ; completes in ~38 µs on real hardware (vs. ~3.5 ms for the previous
                            	   252:     ; 32768-word CPU loop), reclaiming ~6 frames of boot time.
                            	   253:     ;
                            	   254:     ; Sequence:
                            	   255:     ;   1. Reg 15 (auto-increment) = 1 → byte stride for the fill.
                            	   256:     ;   2. Regs 19/20 (DMA length low/high) = 0 → documented VDP quirk:
                            	   257:     ;      length $0000 means "fill 65536 bytes" (full 64 KB).
                            	   258:     ;   3. Reg 23 (DMA source high) = $80 → VRAM-fill mode.
                            	   259:     ;   4. Write address command to VDP_CTRL with DMA bit (CD5=1) set.
                            	   260:     ;   5. Write fill word to VDP_DATA — DMA begins using the upper byte as
                            	   261:     ;      the fill value.  We write $0000 so the fill byte is $00.
                            	   262:     ;   6. Poll VDP status until DMA-busy bit (bit 1) clears.
                            	   263:     ;   7. Restore auto-increment to 2 for normal word writes later.
                            	   264:     ;--------------------------------------------------------------------------
02:000000CE 33FC8F0100C00004	   265:     move.w  #$8F01,(VDP_CTRL).l  ; Reg 15: auto-increment = 1 (byte stride)
02:000000D6 33FC930000C00004	   266:     move.w  #$9300,(VDP_CTRL).l  ; Reg 19: DMA length low  = $00
02:000000DE 33FC940000C00004	   267:     move.w  #$9400,(VDP_CTRL).l  ; Reg 20: DMA length high = $00 ($0000 = 65536)
02:000000E6 33FC978000C00004	   268:     move.w  #$9780,(VDP_CTRL).l  ; Reg 23: DMA mode = VRAM fill
02:000000EE 23FC4000008000C0	   269:     move.l  #$40000080,(VDP_CTRL).l  ; VRAM write $0000 + DMA bit (CD5=1)
02:000000F6 0004
02:000000F8 33FC000000C00000	   270:     move.w  #$0000,(VDP_DATA).l  ; Fill byte = upper byte = $00; DMA begins
                            	   271: .vram_dma_wait:
02:00000100 303900C00004    	   272:     move.w  (VDP_CTRL).l,D0
02:00000106 08000001        	   273:     btst    #1,D0                ; bit 1 = DMA busy
02:0000010A 66F4            	   274:     bne.s   .vram_dma_wait
02:0000010C 33FC8F0200C00004	   275:     move.w  #$8F02,(VDP_CTRL).l  ; Reg 15: restore auto-increment = 2
                            	   276: 
                            	   277:     ;--------------------------------------------------------------------------
                            	   278:     ; Plane B blank fill — use tile $05FF (VRAM $BFE0) as a dedicated blank.
                            	   279:     ; Tile $05FF lives in the gap between Zelda CHR ($0000-$BE00 worst case)
                            	   280:     ; and Plane A nametable ($C000), so Zelda's dynamic CHR uploads never
                            	   281:     ; stomp it. Upload 32 zero bytes to tile $05FF explicitly (VRAM is already
                            	   282:     ; zeroed above, but we re-assert post-CHR-load safety by keeping the tile
                            	   283:     ; outside the Zelda CHR window). Fill plane B with tile index $05FF.
                            	   284:     ; This replaces tile $0200, which was inside Zelda's BG CHR bank and
                            	   285:     ; held octorok-sprite data after CHR upload → visible blue-checker
                            	   286:     ; leak through transparent plane A pixels during intro story scroll.
                            	   287:     ;--------------------------------------------------------------------------
02:00000114 23FCBFE0000300C0	   288:     move.l  #$BFE00003,(VDP_CTRL).l  ; VRAM write to $BFE0 (tile $5FF data)
02:0000011C 0004
02:0000011E 700F            	   289:     moveq   #15,D0
                            	   290: .blank_tile_fill:
02:00000120 33FC000000C00000	   291:     move.w  #0,(VDP_DATA).l
02:00000128 51C8FFF6        	   292:     dbra    D0,.blank_tile_fill
                            	   293:     ;--------------------------------------------------------------------------
                            	   294:     ; Plane B fill — 2048 words of tile $05FF.
                            	   295:     ; Phase 6.3 (VRAM→VRAM DMA propagate-copy) was attempted here but caused
                            	   296:     ; an ExcBusError under gpgx; reverted to the CPU loop since the savings
                            	   297:     ; (~0.3 frames) aren't worth risking the baseline.
                            	   298:     ;--------------------------------------------------------------------------
02:0000012C 23FC6000000300C0	   299:     move.l  #$60000003,(VDP_CTRL).l  ; VRAM write to $E000 (plane B map)
02:00000134 0004
02:00000136 303C07FF        	   300:     move.w  #2047,D0
                            	   301: .planeb_fill:
02:0000013A 33FC05FF00C00000	   302:     move.w  #$05FF,(VDP_DATA).l
02:00000142 51C8FFF6        	   303:     dbra    D0,.planeb_fill
                            	   304: 
                            	   305:     ;--------------------------------------------------------------------------
                            	   306:     ; Phase 2 v2: fill Window nametable at $B000 with blank tile $05FF.
                            	   307:     ; Without this, Window (now active top 8 rows) renders tile index $0000
                            	   308:     ; (CHR tile 0) = garbage art before game writes HUD content.
                            	   309:     ; Window map is 32x32 = 1024 bytes = 512 words.
                            	   310:     ; VDP cmd $70000002: $B000 A[15:14]=10, addr13-0=$3000, lower word=2.
                            	   311:     ;--------------------------------------------------------------------------
02:00000146 23FC7000000200C0	   312:     move.l  #$70000002,(VDP_CTRL).l  ; VRAM write to $B000 (Window map)
02:0000014E 0004
02:00000150 303C01FF        	   313:     move.w  #511,D0
                            	   314: .window_fill:
02:00000154 33FC05FF00C00000	   315:     move.w  #$05FF,(VDP_DATA).l
02:0000015C 51C8FFF6        	   316:     dbra    D0,.window_fill
                            	   317: 
                            	   318:     ;--------------------------------------------------------------------------
                            	   319:     ; Write test palette — pure green to CRAM[0] (background color slot).
                            	   320:     ; Reg 7 above set background = palette 0, color 0 → CRAM entry 0.
                            	   321:     ;
                            	   322:     ; Result on screen: solid green = VDP init correct (colorfix working).
                            	   323:     ; Dingy/dark green = check that Reg 0 is $8004, NOT $8000.
                            	   324:     ;--------------------------------------------------------------------------
02:00000160 23FCC000000000C0	   325:     move.l  #CRAM_WRITE_0000,(VDP_CTRL).l
02:00000168 0004
02:0000016A 33FC00E000C00000	   326:     move.w  #COLOR_GREEN,(VDP_DATA).l
                            	   327: 
                            	   328:     ;--------------------------------------------------------------------------
                            	   329:     ; Display on
                            	   330:     ;--------------------------------------------------------------------------
02:00000172 33FC817400C00004	   331:     move.w  #$8174,(VDP_CTRL).l  ; Reg 1: DISP=1, VBlank IRQ, DMA, M5
                            	   332: 
                            	   333:     ;--------------------------------------------------------------------------
                            	   334:     ; Clear NES RAM ($FF0000–$FF07FF) — 2KB of NES work RAM mapped into
                            	   335:     ; Genesis RAM at the top of the address space.
                            	   336:     ; Also clears PPU state block ($FF0800–$FF080F) in the same pass.
                            	   337:     ;--------------------------------------------------------------------------
02:0000017A 207C00FF0000    	   338:     movea.l #NES_RAM_BASE,A0
02:00000180 303C041F        	   339:     move.w  #(NES_RAM_SIZE+PPU_STATE_SIZE)/2-1,D0  ; 1031 words
                            	   340: .nesramclear:
02:00000184 30FC0000        	   341:     move.w  #0,(A0)+
02:00000188 51C8FFFA        	   342:     dbra    D0,.nesramclear
                            	   343: 
                            	   344:     ; Phase 1: clear SAT_SHADOW double-buffer + SAT_ACTIVE_BANK flag.
                            	   345:     ; Genesis sprite Y=0 lies 128px above screen → all shadow sprites start
                            	   346:     ; off-screen.  First _oam_dma fill overrides with real game state.
02:0000018C 207C00FF2000    	   347:     movea.l #SAT_SHADOW_A,A0
02:00000192 303C01FF        	   348:     move.w  #(SAT_SHADOW_SIZE*2)/2-1,D0   ; 2 banks × 512 bytes → 512 words
                            	   349: .sat_shadow_clear:
02:00000196 30FC0000        	   350:     move.w  #0,(A0)+
02:0000019A 51C8FFFA        	   351:     dbra    D0,.sat_shadow_clear
02:0000019E 423900FF2400    	   352:     clr.b   (SAT_ACTIVE_BANK).l            ; start with bank A active
                            	   353: 
                            	   354:     ;--------------------------------------------------------------------------
                            	   355:     ; T4: Initialize NES register equivalents before handing off to Zelda code.
                            	   356:     ;
                            	   357:     ;   A4 = NES_RAM_BASE ($FF0000) — base for all (offset,A4) NES RAM accesses
                            	   358:     ;   A5 = NES_STACK_INIT ($FF0200) — NES stack starts at SP=$FF, so the
                            	   359:     ;        first PHA decrements to $FF01FF.  A5 points one-past the top.
                            	   360:     ;   D7 = $FF — 6502 SP shadow (used by TSX/TXS and stack bound checks)
                            	   361:     ;--------------------------------------------------------------------------
02:000001A4 287C00FF0000    	   362:     movea.l #NES_RAM_BASE,A4
02:000001AA 2A7C00FF0200    	   363:     movea.l #NES_STACK_INIT,A5
02:000001B0 7EFF            	   364:     moveq   #-1,D7                  ; D7 = $FF (NES SP shadow)
                            	   365: 
02:000001B2 6100023A        	   366:     jsr     audio_init              ; Initialize YM2612 + PSG
                            	   367: 
                            	   368:     ; Request the title/demo song on boot as a smoke test for the native
                            	   369:     ; M68K music player.  music_tick (called from VBlank) will pick this
                            	   370:     ; up on the first frame after SR is lowered.
02:000001B6 13FC008000FFE001	   371:     move.b  #$80,(m_song_req).l
                            	   372: 
                            	   373:     ; Pre-write tile buffer sentinel so the first NMI's TransferCurTileBuf
                            	   374:     ; doesn't parse zeroed RAM as phantom records.  DynTileBuf = NES $0302.
02:000001BE 197C00FF0302    	   375:     move.b  #$FF,($0302,A4)
                            	   376: 
                            	   377:     ; Seed LAST_GAMEMODE to $FF so the first _mode_transition_check always
                            	   378:     ; fires a transition (harmless because PPU latches are already zero but
                            	   379:     ; forces a clean VSRAM init).
02:000001C4 13FC00FF00FF083E	   380:     move.b  #$FF,($00FF083E).l       ; LAST_GAMEMODE
02:000001CC 13FC00FF00FF083F	   381:     move.b  #$FF,(_current_window_bank).l ; P33: force first bank-window copy
                            	   382: 
                            	   383:     ;--------------------------------------------------------------------------
                            	   384:     ; Phase 9.7 — Cartridge SRAM declared in header at $1B0-$1BB.  The header
                            	   385:     ; alone is enough for gpgx to allocate the SRAM domain, but writes to
                            	   386:     ; $200001+ via the M68K bus are routed to ROM unless the SRAM mapper
                            	   387:     ; port at $A130F1 is set to $01 (verified by bizhawk_sram_smoke probe:
                            	   388:     ; without the port write the bus reads back $FF, with it the writes
                            	   389:     ; persist into the gpgx SRAM domain).
                            	   390:     ;--------------------------------------------------------------------------
                            	   391:     ;--------------------------------------------------------------------------
                            	   392:     ; Controller port 1 — set TH pin as output once during init.
                            	   393:     ; Doing this inside _ctrl_strobe on every call caused rapid CTRL-register
                            	   394:     ; writes that destabilised the 3-button pad multiplexer on real hardware,
                            	   395:     ; producing inconsistent reads that trapped the ReadOneController
                            	   396:     ; debounce loop in an infinite retry → d-pad freeze while held.
                            	   397:     ;--------------------------------------------------------------------------
02:000001D4 13FC004000A10009	   398:     move.b  #$40,($A10009).l        ; Port 1 CTRL: bit6 (TH) = output
02:000001DC 13FC004000A10003	   399:     move.b  #$40,($A10003).l        ; Port 1 DATA: TH=1 (idle state)
                            	   400: 
02:000001E4 13FC000100A130F1	   401:     move.b  #$01,($A130F1).l        ; SRAM mapper enable (write-only port)
                            	   402:     ; Phase 9.7 SRAM self-test: write a sentinel pattern to the LAST four
                            	   403:     ; odd-byte slots of cart SRAM ($203FF9/$203FFB/$203FFD/$203FFF).  This
                            	   404:     ; lives at the very end of the declared SRAM window, far away from
                            	   405:     ; the NES save-slot range that Phase 9.8 will use ($200001-$200CFF
                            	   406:     ; covering NES $6000-$67FF).  Purpose: gives the smoke probe a
                            	   407:     ; deterministic check that the M68K bus path actually writes through
                            	   408:     ; the cart mapper into the gpgx SRAM file (BizHawk's Lua "M68K BUS"
                            	   409:     ; domain bypasses the mapper and is unreliable for this).
02:000001EC 13FC005A00203FF9	   410:     move.b  #$5A,($203FF9).l
02:000001F4 13FC00A500203FFB	   411:     move.b  #$A5,($203FFB).l
02:000001FC 13FC00C300203FFD	   412:     move.b  #$C3,($203FFD).l
02:00000204 13FC003C00203FFF	   413:     move.b  #$3C,($203FFF).l
                            	   414:     ; Phase 9.8 — Restore the three NES save slots (NES $6000-$67FF) from
                            	   415:     ; cart SRAM into the work-RAM mirror at $FF6000 BEFORE Zelda runs.
                            	   416:     ; The mirror is what z_02 reads/writes via NES_SRAM equ $FF6000.
                            	   417:     ; Without this restore, every cold boot would see all-$FF SRAM data.
02:0000020C 4EB90002AB70    	   418:     jsr     _sram_load_save_slots
                            	   419: 
                            	   420:     ;--------------------------------------------------------------------------
                            	   421:     ; Lower interrupt mask so VBlank (level 6) can fire.
                            	   422:     ; A4/A5/D7 are initialised above — IsrNmi is now safe to execute.
                            	   423:     ; IPL=0: all interrupt levels pass (VBlank=6, NMI-like=7).
                            	   424:     ;--------------------------------------------------------------------------
02:00000212 027CF8FF        	   425:     andi.w  #$F8FF,SR               ; IPL → 0: enable VBlank
                            	   426: 
                            	   427:     ;--------------------------------------------------------------------------
                            	   428:     ; Hand off to Zelda — jump to IsrReset (the NES Reset vector handler).
                            	   429:     ; IsrReset polls PPU $2002 (VBlank) twice, initialises MMC1, then jumps
                            	   430:     ; to RunGame which spins in LoopForever waiting for VBlank NMI.
                            	   431:     ;
                            	   432:     ; NOTE: VBlankISR below is wired to IsrNmi once T4 is validated.
                            	   433:     ; For T4, VBlank is masked by genesis boot SR ($2700) and IsrReset's SEI
                            	   434:     ; (now a NOP), so LoopForever just spins — that is the expected T4 state.
                            	   435:     ;--------------------------------------------------------------------------
02:00000216 4EB90004A828    	   436:     jsr     IsrReset                ; never returns (RunGame → LoopForever)
                            	   437: 
                            	   438:     ;--------------------------------------------------------------------------
                            	   439:     ; Safety net — should never be reached.
                            	   440:     ;--------------------------------------------------------------------------
                            	   441: HaltForever:
02:0000021C 4E722700        	   442:     stop    #$2700
02:00000220 60FA            	   443:     bra.s   HaltForever
                            	   444: 
                            	   445: ;==============================================================================
                            	   446: ; VBlankISR — T4: call IsrNmi (Zelda's NMI handler) then return.
                            	   447: ; IsrNmi is defined in zelda_translated/z_07.asm (included below).
                            	   448: ;
                            	   449: ; T4 note: during boot, SR=$2700 so this ISR never fires while IsrReset runs.
                            	   450: ; Once RunGame hits LoopForever and we lower SR (T5+), this fires every frame.
                            	   451: ;==============================================================================
                            	   452: VBlankISR:
02:00000222 48E7FFFE        	   453:     movem.l D0-D7/A0-A6,-(SP)
                            	   454:     ; Only call IsrNmi if PPUCTRL bit 7 = 1 (NMI enable).
                            	   455:     ; On NES, VBlank NMI fires only when PPUCTRL.$80 is set.
                            	   456:     ; During IsrReset warmup PPUCTRL=0, so IsrNmi is suppressed
                            	   457:     ; until RunGame writes $A0 to $2000.
02:00000226 0839000700FF0804	   458:     btst    #7,($00FF0804).l        ; PPU_CTRL = $FF0804, bit 7 = NMI enable
02:0000022E 672E            	   459:     beq.s   .nmi_off
02:00000230 523900FF1003    	   460:     addq.b  #1,($00FF1003).l        ; Phase 2.4: NMI probe counter
                            	   461:     ; Phase 1 (HW adoption): flush previous frame's SAT_SHADOW to VRAM $F800
                            	   462:     ; via 68k→VRAM DMA.  Must run before _ags_prearm/IsrNmi so the DMA
                            	   463:     ; trigger fires early in vblank (IsrNmi can extend into active display).
                            	   464:     ; _oam_dma_flush also flips SAT_ACTIVE_BANK so the NEXT IsrNmi fill
                            	   465:     ; populates the other bank.
02:00000236 4EB90002ACEC    	   466:     bsr     _oam_dma_flush
                            	   467:     ; Pre-arm pending VSRAM + H-int state from previous frame's _ags_flush.
                            	   468:     ; Must run BEFORE IsrNmi: IsrNmi can extend into active display past
                            	   469:     ; scanline 40, so doing the VDP writes after-the-fact (inside _ags_flush)
                            	   470:     ; misses the pinned-title band. _ags_prearm guarantees the write lands
                            	   471:     ; in vblank.
02:0000023C 4EB90000E1BE    	   472:     bsr     _ags_prearm
                            	   473:     ; Phase 1 mode-transition purge — catches GameMode changes and zeroes
                            	   474:     ; PPU latches + direct-writes VSRAM[0]/[1] inside the blanking window
                            	   475:     ; so VSRAM bleed from the prior mode cannot contaminate the first frame
                            	   476:     ; of the new mode.  Must run BEFORE IsrNmi (IsrNmi would otherwise
                            	   477:     ; apply the stale scroll shadows mid-NMI).
02:00000242 4EB90000E2BA    	   478:     bsr     _mode_transition_check
02:00000248 4EB90004791A    	   479:     jsr     IsrNmi
                            	   480:     ; Stage 2b: C-runtime heartbeat. Confirms the gcc/ld/objcopy
                            	   481:     ; toolchain integration is live. Observable at &c_probe_counter
                            	   482:     ; (address in whatif.lst — .bss region $FFC000+). void(void);
                            	   483:     ; standard SysV m68k ABI clobbers D0/D1/A0/A1 and no NES regs.
02:0000024E 4EB900000000    	   484:     jsr     c_probe_tick
                            	   485:     ; Advance the native music player one tick (YM2612 + PSG writes).
                            	   486:     ; Mirrors the original NES engine which drove music from NMI.
02:00000254 61000420        	   487:     bsr     music_tick
                            	   488:     ; Flush PPU scroll shadows → VDP VSRAM / H-scroll / H-int queue.
                            	   489:     ; Deferred to here (post-NMI, still in VBlank) so the two transpiler-
                            	   490:     ; injected `bsr _apply_genesis_scroll` sites inside IsrNmi cannot
                            	   491:     ; double-program the VDP mid-NMI. _ags_flush reads CurVScroll/
                            	   492:     ; CurHScroll/IsSprite0CheckActive from NES zero-page via A4, which
                            	   493:     ; VBlankISR's movem preserved from the interrupted caller (RunGame
                            	   494:     ; establishes A4 = $FF0000 before LoopForever).
02:00000258 4EB90000E18E    	   495:     bsr     _ags_flush
                            	   496: .nmi_off:
02:0000025E 4CDF7FFF        	   497:     movem.l (SP)+,D0-D7/A0-A6
02:00000262 4E73            	   498:     rte
                            	   499: 
                            	   500: ;==============================================================================
                            	   501: ; HBlankISR — queue-popping H-int dispatcher + DMC DAC streamer.
                            	   502: ;
                            	   503: ; Two fundamentally different uses of HINT now share this ISR:
                            	   504: ;
                            	   505: ;   (a) Scroll splits.  1-2 HINTs per frame fire at specific lines, drain
                            	   506: ;       the HINT_Q* queue, write VSRAM, then self-disable HINT via reg 0.
                            	   507: ;       This is the original behaviour, unchanged.
                            	   508: ;
                            	   509: ;   (b) DMC DAC streaming.  While audio_driver's dmc_trigger is active,
                            	   510: ;       HINT is armed every line (reg 10 = 0) and this ISR streams one PCM
                            	   511: ;       byte per fire to YM2612 reg $2A.  Detected by dmc_active != 0 at
                            	   512: ;       ISR entry.  In DMC mode we bypass the scroll queue entirely —
                            	   513: ;       title screen and intro don't use scroll splits anyway.
                            	   514: ;
                            	   515: ; Detection is at the very top of the ISR so the DMC path has minimal
                            	   516: ; latency.  dmc_hint_tick is defined in audio_driver.asm and handles the
                            	   517: ; full stream-one-byte-or-end-of-sample logic.
                            	   518: ;
                            	   519: ; State contract for scroll-path (unchanged):
                            	   520: ;   _ags_flush   writes NEXT-frame staged state (STAGED_*)
                            	   521: ;   _ags_prearm  promotes STAGED_* -> active HINT_Q* before display starts
                            	   522: ;   HINT_Q_COUNT ≥ 1 when H-int is armed via Reg 0 bit 4 for the CURRENT frame
                            	   523: ;   HINT_Q0_CTR  = initial Reg 10 value for the current frame
                            	   524: ;   HINT_Q0_VSRAM = VSRAM value to write when the current frame's H-int fires
                            	   525: ;   HINT_Q1_* remain available for future chained events
                            	   526: ;==============================================================================
                            	   527: HBlankISR:
02:00000264 4A3900FFE100    	   528:     tst.b   (dmc_active).l                  ; DMC streaming?
02:0000026A 670E            	   529:     beq.s   .scroll_path                    ; no → scroll queue handler
02:0000026C 48E78080        	   530:     movem.l D0/A0,-(SP)
02:00000270 610003A6        	   531:     bsr     dmc_hint_tick
02:00000274 4CDF0101        	   532:     movem.l (SP)+,D0/A0
02:00000278 4E73            	   533:     rte
                            	   534: 
                            	   535: .scroll_path:
02:0000027A 48E7C080        	   536:     movem.l D0-D1/A0,-(SP)
02:0000027E 41F900FF0816    	   537:     lea     (HINT_Q_COUNT).l,A0
02:00000284 1010            	   538:     move.b  (A0),D0
02:00000286 6738            	   539:     beq.s   .hi_disable                     ; defensive: empty queue
02:00000288 5310            	   540:     subq.b  #1,(A0)                         ; decrement remaining count
                            	   541:     ; Write queued VSRAM FIRST (critical path)
02:0000028A 23FC4000001000C0	   542:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00000292 0004
02:00000294 33F900FF081800C0	   543:     move.w  (HINT_Q0_VSRAM).l,(VDP_DATA).l
02:0000029C 0000
                            	   544:     ; If another event is pending, re-arm Reg 10 and promote Q1 → Q0
02:0000029E 4A10            	   545:     tst.b   (A0)
02:000002A0 671E            	   546:     beq.s   .hi_disable
02:000002A2 7200            	   547:     moveq   #0,D1
02:000002A4 123900FF081A    	   548:     move.b  (HINT_Q1_CTR).l,D1
02:000002AA 827C8A00        	   549:     or.w    #$8A00,D1
02:000002AE 33C100C00004    	   550:     move.w  D1,(VDP_CTRL).l                 ; Reg 10 = delta to next event
02:000002B4 33F900FF081C00FF	   551:     move.w  (HINT_Q1_VSRAM).l,(HINT_Q0_VSRAM).l
02:000002BC 0818
02:000002BE 6008            	   552:     bra.s   .hi_done
                            	   553: .hi_disable:
02:000002C0 33FC800400C00004	   554:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: disable H-int
                            	   555: .hi_done:
02:000002C8 4CDF0103        	   556:     movem.l (SP)+,D0-D1/A0
02:000002CC 4E73            	   557:     rte
                            	   558: 
                            	   559: ;==============================================================================
                            	   560: ; Exception forensics handlers
                            	   561: ;
                            	   562: ; On any exception: save type, stacked SR, faulting PC, and all data/address
                            	   563: ; registers to a known RAM block at $FF0900 before spinning.  The T5 probe
                            	   564: ; (and BizHawk debugger) can then read this block to identify the fault.
                            	   565: ;
                            	   566: ; 68000 stack frames:
                            	   567: ;   Bus Error (vec 2) / Address Error (vec 3):
                            	   568: ;     SP+0  function code / misc (word)
                            	   569: ;     SP+2  access address (long)
                            	   570: ;     SP+6  instruction register (word)
                            	   571: ;     SP+8  SR at exception time
                            	   572: ;     SP+10 PC of faulting instruction (long)
                            	   573: ;   All other exceptions:
                            	   574: ;     SP+0  SR at exception time
                            	   575: ;     SP+2  PC of faulting instruction (long)
                            	   576: ;
                            	   577: ; Forensics RAM layout ($FF0900):
                            	   578: ;   $FF0900: exception type byte (2=bus error, 3=addr error, 0=other)
                            	   579: ;   $FF0901: (pad)
                            	   580: ;   $FF0902: stacked SR (word)
                            	   581: ;   $FF0904: faulting PC (long)
                            	   582: ;   $FF0908: D0–D7, A0–A6 saved by MOVEM.L (15 longs = 60 bytes, ends $FF0943)
                            	   583: ;==============================================================================
                            	   584: 
                            	   585: ExcBusError:
02:000002CE 13FC000200FF0900	   586:     move.b  #2,($FF0900).l
02:000002D6 33EF000800FF0902	   587:     move.w  8(SP),($FF0902).l
02:000002DE 23EF000A00FF0904	   588:     move.l  10(SP),($FF0904).l
02:000002E6 48F97FFF00FF0908	   589:     movem.l D0-D7/A0-A6,($FF0908).l
                            	   590: .spin:
02:000002EE 60FE            	   591:     bra.s   .spin
                            	   592: 
                            	   593: ExcAddrError:
02:000002F0 13FC000300FF0900	   594:     move.b  #3,($FF0900).l
02:000002F8 33EF000800FF0902	   595:     move.w  8(SP),($FF0902).l           ; SR
02:00000300 23EF000A00FF0904	   596:     move.l  10(SP),($FF0904).l          ; PC
02:00000308 33D700FF0944    	   597:     move.w  0(SP),($FF0944).l           ; status word
02:0000030E 23EF000200FF0946	   598:     move.l  2(SP),($FF0946).l           ; access address (faulting addr)
02:00000316 33EF000600FF094A	   599:     move.w  6(SP),($FF094A).l           ; instruction register (opcode)
02:0000031E 48F97FFF00FF0908	   600:     movem.l D0-D7/A0-A6,($FF0908).l
                            	   601: .spin:
02:00000326 60FE            	   602:     bra.s   .spin
                            	   603: 
                            	   604: DefaultException:
02:00000328 13FC000000FF0900	   605:     move.b  #0,($FF0900).l
02:00000330 33D700FF0902    	   606:     move.w  (SP),($FF0902).l
02:00000336 23EF000200FF0904	   607:     move.l  2(SP),($FF0904).l
02:0000033E 48F97FFF00FF0908	   608:     movem.l D0-D7/A0-A6,($FF0908).l
                            	   609: .spin:
02:00000346 60FE            	   610:     bra.s   .spin
                            	   611: 
                            	   612: ;==============================================================================
                            	   613: ; NES I/O emulation layer — real implementations of _ppu_*, _apu_*, _ctrl_*,
                            	   614: ; _oam_dma, _mmc1_*, _indirect_stub.  Must be included BEFORE any bank file
                            	   615: ; so all helpers are defined when z_XX.asm code references them.
                            	   616: ; (With --no-stubs the bank files no longer emit these labels themselves.)
                            	   617: ;==============================================================================
                            	   618:     include "audio_driver.asm"

