                            	  5165:     ;
02:00049384 41EC0098        	  5166:     lea     ($0098,A4),A0
02:00049388 10302000        	  5167:     move.b  (A0,D2.W),D0
02:0004938C 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:00049390 6702            	  5169:     beq.s  __far_z_07_0077
02:00049392 6004            	  5170:     jmp  L1F49F_Exit
