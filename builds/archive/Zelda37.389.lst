02:00048076 41EC030A        	  2414:     lea     ($030A,A4),A0
02:0004807A 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:0004807E 41EC030B        	  2416:     lea     ($030B,A4),A0
02:00048082 11802000        	  2417:     move.b  D0,(A0,D2.W)
02:00048086 41EC0306        	  2418:     lea     ($0306,A4),A0
02:0004808A 52302000        	  2419:     addq.b  #1,(A0,D2.W)
02:0004808E 41EC030B        	  2420:     lea     ($030B,A4),A0
