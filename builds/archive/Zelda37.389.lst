                            	  7883: HaveInput:
                            	  7884:     ; There were input directions.
                            	  7885:     ;
                            	  7886:     ; If there was only one input direction, go set object direction
                            	  7887:     ; to input direction, and set Link's speed.
                            	  7888:     ;
