                            	  2713: Link_FilterInput:
                            	  2714:     ; [00] holds the opposite of Link's facing direction.
                            	  2715:     ;
02:0003EA68 102C0098        	  2716:     move.b  ($0098,A4),D0
02:0003EA6C 4EB9000308CC    	  2717:     jsr     GetOppositeDir
02:0003EA72 1880            	  2718:     move.b  D0,($0000,A4)
                            	  2719:     ; Call GetOppositeDir again to use this mapping:
                            	  2720:     ; In Dir: 1 2 4 8
                            	  2721:     ;         -------
                            	  2722:     ; Index:  2 3 0 1
                            	  2723:     ;
02:0003EA74 4EB9000308CC    	  2724:     jsr     GetOppositeDir
                            	  2725:     ; Get the appropriate coordinate for the direction:
                            	  2726:     ; X for horizontal
                            	  2727:     ; Y for vertical
                            	  2728:     ;
02:0003EA7A 102C0070        	  2729:     move.b  ($0070,A4),D0
02:0003EA7E 0C030002        	  2730:     cmpi.b  #$02,D3
02:0003EA82 6404            	  2731:     bcc  _anon_z05_74
02:0003EA84 102C0084        	  2732:     move.b  ($0084,A4),D0
                            	  2733: _anon_z05_74:
02:0003EA88 19400002        	  2734:     move.b  D0,($0002,A4)
                            	  2735:     ; Mask A button and directions if inner border is crossed.
                            	  2736:     ;
02:0003EA8C 1003            	  2737:     move.b  D3,D0
02:0003EA8E 1B00            	  2738:     move.b  D0,-(A5)  ; PHA
02:0003EA90 023C00EE        	  2739:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EA94 123C0008        	  2740:     move.b  #$08,D1
02:0003EA98 D101            	  2741:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003EA9A 7600            	  2742:     moveq   #0,D3
02:0003EA9C 1600            	  2743:     move.b  D0,D3
02:0003EA9E 103C0080        	  2744:     move.b  #$80,D0
02:0003EAA2 6134            	  2745:     jsr     MaskInputInBorder
02:0003EAA4 101D            	  2746:     move.b  (A5)+,D0  ; PLA
02:0003EAA6 7600            	  2747:     moveq   #0,D3
02:0003EAA8 1600            	  2748:     move.b  D0,D3
                            	  2749:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2750:     ; boundary using player's direction and reverse direction index.
                            	  2751:     ;
02:0003EAAA 102C0001        	  2752:     move.b  ($0001,A4),D0
02:0003EAAE 0C0000FF        	  2753:     cmpi.b  #$FF,D0
02:0003EAB2 660C            	  2754:     bne  _anon_z05_75
02:0003EAB4 102C0098        	  2755:     move.b  ($0098,A4),D0
02:0003EAB8 1880            	  2756:     move.b  D0,($0000,A4)
02:0003EABA 4EB9000308CC    	  2757:     jsr     GetOppositeDir
                            	  2758: _anon_z05_75:
                            	  2759:     ; If in UW, use the second set of bounds by adding 4
                            	  2760:     ; to reverse direction index.
                            	  2761:     ;
                            	  2762:     ; Else in OW, and use first set that begins at offset 0.
                            	  2763:     ;
02:0003EAC0 102C0010        	  2764:     move.b  ($0010,A4),D0
02:0003EAC4 6710            	  2765:     beq  _anon_z05_76
02:0003EAC6 1003            	  2766:     move.b  D3,D0
02:0003EAC8 023C00EE        	  2767:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EACC 123C0004        	  2768:     move.b  #$04,D1
02:0003EAD0 D101            	  2769:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003EAD2 7600            	  2770:     moveq   #0,D3
02:0003EAD4 1600            	  2771:     move.b  D0,D3
                            	  2772: _anon_z05_76:
                            	  2773:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2774:     ;
02:0003EAD6 7000            	  2775:     moveq   #0,D0
                            	  2776: ; Params:
                            	  2777: ; A: mask of buttons to block
                            	  2778: ; Y: offset into BorderBounds
                            	  2779: ; [00]: direction
                            	  2780: ; [02]: coordinate
                            	  2781: ;
                            	  2782: ; Returns:
                            	  2783: ; [01]: button mask that was used
                            	  2784: ;       (set to $FF if boundary not crossed)
                            	  2785: ;
                            	  2786:     even
                            	  2787: MaskInputInBorder:
02:0003EAD8 19400001        	  2788:     move.b  D0,($0001,A4)
                            	  2789:     ; If direction is positive (right or down), then go handle it separately.
                            	  2790:     ;
02:0003EADC 1014            	  2791:     move.b  ($0000,A4),D0
02:0003EADE 0200000A        	  2792:     andi.b #$0A,D0
02:0003EAE2 6748            	  2793:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2794:     ; The direction is negative (left or up).
                            	  2795:     ;
                            	  2796:     ; If the coordinate does not cross (<) the boundary, then
                            	  2797:     ; go set mask $FF, so that no button is excluded.
                            	  2798:     ;
02:0003EAE4 102C0002        	  2799:     move.b  ($0002,A4),D0
02:0003EAE8 41F90003EA5C    	  2800:     lea     (BorderBounds).l,A0
02:0003EAEE 12303000        	  2801:     move.b  (A0,D3.W),D1
02:0003EAF2 B001            	  2802:     cmp.b   D1,D0
02:0003EAF4 6548            	  2803:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2804:     even
                            	  2805: _L_z05_MaskInputInBorder_MaskButtons:
                            	  2806:     ; The boundary was crossed. Mask buttons.
                            	  2807:     ;
02:0003EAF6 102C00F8        	  2808:     move.b  ($00F8,A4),D0
02:0003EAFA 122C0001        	  2809:     move.b  ($0001,A4),D1
02:0003EAFE C001            	  2810:     and.b  D1,D0
02:0003EB00 194000F8        	  2811:     move.b  D0,($00F8,A4)
                            	  2812:     ; If in OW or button mask <> 0, return.
                            	  2813:     ;
02:0003EB04 102C0010        	  2814:     move.b  ($0010,A4),D0
02:0003EB08 6720            	  2815:     beq  _L_z05_MaskInputInBorder_Exit
02:0003EB0A 102C0001        	  2816:     move.b  ($0001,A4),D0
02:0003EB0E 661A            	  2817:     bne  _L_z05_MaskInputInBorder_Exit
                            	  2818:     ; Mask off input directions perpendicular to player's facing.
                            	  2819:     ;
02:0003EB10 760C            	  2820:     moveq   #12,D3
02:0003EB12 102C0098        	  2821:     move.b  ($0098,A4),D0
02:0003EB16 0200000C        	  2822:     andi.b #$0C,D0
02:0003EB1A 6602            	  2823:     bne  _anon_z05_77
02:0003EB1C 7603            	  2824:     moveq   #3,D3
                            	  2825: _anon_z05_77:
02:0003EB1E 1003            	  2826:     move.b  D3,D0
02:0003EB20 122C03F8        	  2827:     move.b  ($03F8,A4),D1
02:0003EB24 C001            	  2828:     and.b  D1,D0
02:0003EB26 194003F8        	  2829:     move.b  D0,($03F8,A4)
