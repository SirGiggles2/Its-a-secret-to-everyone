                            	  3222: UpdatePondFairy:
02:00039744 61003620        	  3223:     jsr     DrawFairy
                            	  3224:     ; If not in state 0, then go handle states 1 to 3.
                            	  3225:     ;
02:00039748 102C00AD        	  3226:     move.b  ($00AD,A4),D0
02:0003974C 6702            	  3227:     beq.s  __far_z_04_0028
02:0003974E 602A            	  3228:     jmp  PondFairy_HandleOtherStates
                            	  3229: __far_z_04_0028:
                            	  3230:     ; State 0.
                            	  3231:     ;
                            	  3232:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3233:     ;
02:00039750 102C0084        	  3234:     move.b  ($0084,A4),D0
02:00039754 0C0000AD        	  3235:     cmpi.b  #$AD,D0
02:00039758 661E            	  3236:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3237:     ; If Link's X < $70 or >= $81, then return.
                            	  3238:     ;
02:0003975A 102C0070        	  3239:     move.b  ($0070,A4),D0
02:0003975E 0C000070        	  3240:     cmpi.b  #$70,D0
02:00039762 6514            	  3241:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039764 0C000081        	  3242:     cmpi.b  #$81,D0
02:00039768 640E            	  3243:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3244:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3245:     ; halt Link, and start filling hearts.
                            	  3246:     ;
02:0003976A 522C00AD        	  3247:     addq.b  #1,($00AD,A4)
02:0003976E 7040            	  3248:     moveq   #64,D0
02:00039770 194000AC        	  3249:     move.b  D0,($00AC,A4)
02:00039774 19400063        	  3250:     move.b  D0,($0063,A4)
                            	  3251:     even
                            	  3252: _L_z04_UpdatePondFairy_Exit:
02:00039778 4E75            	  3253:     rts
                            	  3254: 
                            	  3255:     even
                            	  3256: PondFairy_HandleOtherStates:
02:0003977A 0C000001        	  3257:     cmpi.b  #$01,D0
02:0003977E 6610            	  3258:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3259:     ; State 1. Flying and filling hearts.
                            	  3260:     ;
                            	  3261:     ; If still filling hearts, then go draw Link and hearts.
                            	  3262:     ;
02:00039780 102C0063        	  3263:     move.b  ($0063,A4),D0
02:00039784 6620            	  3264:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3265:     ; If not filling hearts anymore, then go to state 2,
                            	  3266:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3267:     ; a little while after we finish filling hearts.
                            	  3268:     ;
02:00039786 522C00AD        	  3269:     addq.b  #1,($00AD,A4)
02:0003978A 7050            	  3270:     moveq   #80,D0
02:0003978C 19400029        	  3271:     move.b  D0,($0029,A4)
                            	  3272:     even
                            	  3273: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3274:     ; If state <> 2 (so, it's 3), then return.
                            	  3275:     ;
                            	  3276:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3277:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3278:     ; was set to, and we'll return.
                            	  3279:     ;
02:00039790 0C000002        	  3280:     cmpi.b  #$02,D0
02:00039794 6634            	  3281:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3282:     ; State = 2.
                            	  3283:     ;
                            	  3284:     ; If Link's timer <> 0, then go draw Link and hearts.
