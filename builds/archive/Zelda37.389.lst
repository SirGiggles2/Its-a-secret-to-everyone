02:00035560 E208            	  5197:     lsr.b  #1,D0   ; LSR A
02:00035562 6556            	  5198:     bcs  _L_z02_DrawCredits_IncRow
02:00035564 E208            	  5199:     lsr.b  #1,D0   ; LSR A
02:00035566 6552            	  5200:     bcs  _L_z02_DrawCredits_IncRow
                            	  5201:     ; Attributes for the left and right blocks are 0.
                            	  5202:     ;
02:00035568 7400            	  5203:     moveq   #0,D2
02:0003556A 19420328        	  5204:     move.b  D2,($0328,A4)
02:0003556E 1942032F        	  5205:     move.b  D2,($032F,A4)
                            	  5206:     ; The row was already divided by 4. So now it refers to an
                            	  5207:     ; NT attribute block row. Look up the attribute byte to use
                            	  5208:     ; for almost every block in this NT attribute block row.
                            	  5209:     ;
02:00035572 7600            	  5210:     moveq   #0,D3
02:00035574 1600            	  5211:     move.b  D0,D3
