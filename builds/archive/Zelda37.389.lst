02:00038F40 003C0011        	  2090:     ori     #$11,CCR  ; SEC: set C+X
02:00038F44 123C0040        	  2091:     move.b  #$40,D1
02:00038F48 0A3C0010        	  2092:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038F4C 9101            	  2093:     subx.b  D1,D0   ; SBC #$40
02:00038F4E 0A3C0010        	  2094:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2095: _anon_z04_39:
