02:000493B8 52302000        	  5204:     addq.b  #1,(A0,D2.W)
02:000493BC 41EC00AC        	  5205:     lea     ($00AC,A4),A0
02:000493C0 10302000        	  5206:     move.b  (A0,D2.W),D0
02:000493C4 0200000F        	  5207:     andi.b #$0F,D0
02:000493C8 0C000003        	  5208:     cmpi.b  #$03,D0
02:000493CC 674C            	  5209:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
