02:00049B48 101D            	  6269:     move.b  (A5)+,D0  ; PLA
02:00049B4A E208            	  6270:     lsr.b  #1,D0   ; LSR A
02:00049B4C E208            	  6271:     lsr.b  #1,D0   ; LSR A
02:00049B4E E208            	  6272:     lsr.b  #1,D0   ; LSR A
02:00049B50 E208            	  6273:     lsr.b  #1,D0   ; LSR A
02:00049B52 1214            	  6274:     move.b  ($0000,A4),D1
02:00049B54 B001            	  6275:     cmp.b   D1,D0
02:00049B56 6702            	  6276:     beq.s  __far_z_07_0098
02:00049B58 60C6            	  6277:     jmp  L1F854_Exit
                            	  6278: __far_z_07_0098:
