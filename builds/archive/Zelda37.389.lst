02:0004163A 123C0040        	  7081:     move.b  #$40,D1
02:0004163E 0A3C0010        	  7082:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041642 9101            	  7083:     subx.b  D1,D0   ; SBC #$40
02:00041644 0A3C0010        	  7084:     eori    #$10,CCR  ; restore X = 6502 C
02:00041648 E208            	  7085:     lsr.b  #1,D0   ; LSR A
02:0004164A E208            	  7086:     lsr.b  #1,D0   ; LSR A
02:0004164C E208            	  7087:     lsr.b  #1,D0   ; LSR A
                            	  7088:     ; Add this row offset to the column address.
