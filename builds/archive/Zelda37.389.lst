                            	  9927: Ganon_CheckCollisions:
                            	  9928:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  9929:     ; Store in [02] and [03].
                            	  9930:     ;
02:0003C8FE 10342070        	  9931:     move.b  ($70,A4,D2.W),D0
02:0003C902 023C00EE        	  9932:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C906 123C0010        	  9933:     move.b  #$10,D1
02:0003C90A D101            	  9934:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C90C 19400002        	  9935:     move.b  D0,($0002,A4)
02:0003C910 41EC0084        	  9936:     lea     ($0084,A4),A0
02:0003C914 10302000        	  9937:     move.b  (A0,D2.W),D0
02:0003C918 023C00EE        	  9938:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C91C 123C0010        	  9939:     move.b  #$10,D1
02:0003C920 D101            	  9940:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C922 19400003        	  9941:     move.b  D0,($0003,A4)
                            	  9942:     ; Check for a collision with Link.
                            	  9943:     ;
                            	  9944:     ; We can't call CheckLinkCollision, because we need to
                            	  9945:     ; customize Ganon's midpoint.
                            	  9946:     ;
                            	  9947:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  9948:     ; detection, if Link is invincible. Initialize variables that will
                            	  9949:     ; be returned from the partial collision check routine. Then
                            	  9950:     ; call it.
                            	  9951:     ;
02:0003C926 102C04F0        	  9952:     move.b  ($04F0,A4),D0
02:0003C92A 6616            	  9953:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C92C 19400006        	  9954:     move.b  D0,($0006,A4)
02:0003C930 19400009        	  9955:     move.b  D0,($0009,A4)
02:0003C934 1940000C        	  9956:     move.b  D0,($000C,A4)
02:0003C938 7600            	  9957:     moveq   #0,D3
02:0003C93A 1883            	  9958:     move.b  D3,($0000,A4)
02:0003C93C 4EB900031072    	  9959:     jsr     CheckLinkCollisionPreinit
                            	  9960:     even
                            	  9961: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  9962:     ; If Ganon is not in state 0, then he's brown.
                            	  9963:     ; Go check collision with an arrow.
                            	  9964:     ;
02:0003C942 41EC00AC        	  9965:     lea     ($00AC,A4),A0
02:0003C946 10302000        	  9966:     move.b  (A0,D2.W),D0
02:0003C94A 6652            	  9967:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  9968:     ; If timer <> 0, then Ganon is visible.
                            	  9969:     ; He can't be harmed like this. So, return.
                            	  9970:     ;
02:0003C94C 10342028        	  9971:     move.b  ($28,A4,D2.W),D0
02:0003C950 664A            	  9972:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003C952 760D            	  9973:     moveq   #13,D3
02:0003C954 4EB9000310AC    	  9974:     jsr     CheckMonsterSwordCollision
                            	  9975:     ; If Ganon has died according to the usual collision check rules
                            	  9976:     ; (HP = 0), then:
                            	  9977:     ; 1. Restore HP to the initial value $F0
                            	  9978:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  9979:     ; 3. Change palette row 7 to make Ganon brown
                            	  9980:     ;
02:0003C95A 41EC0405        	  9981:     lea     ($0405,A4),A0
02:0003C95E 10302000        	  9982:     move.b  (A0,D2.W),D0
02:0003C962 6718            	  9983:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003C964 103C00F0        	  9984:     move.b  #$F0,D0
02:0003C968 41EC0485        	  9985:     lea     ($0485,A4),A0
02:0003C96C 11802000        	  9986:     move.b  D0,(A0,D2.W)
02:0003C970 41EC00AC        	  9987:     lea     ($00AC,A4),A0
02:0003C974 53302000        	  9988:     subq.b  #1,(A0,D2.W)
02:0003C978 61000084        	  9989:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  9990:     even
                            	  9991: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  9992:     ; If Ganon was harmed, then play the sound effect
                            	  9993:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  9994:     ;
02:0003C97C 41EC04F0        	  9995:     lea     ($04F0,A4),A0
02:0003C980 10302000        	  9996:     move.b  (A0,D2.W),D0
02:0003C984 670A            	  9997:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003C986 6100B8DA        	  9998:     jsr     PlayBossHitCryIfNeeded
02:0003C98A 7040            	  9999:     moveq   #64,D0
02:0003C98C 19802028        	 10000:     move.b  D0,($28,A4,D2.W)
                            	 10001:     even
                            	 10002: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 10003:     ; Reset metastate, because Ganon cannot die this way.
                            	 10004:     ;
02:0003C990 4EB90004A772    	 10005:     jsr     ResetObjMetastate
                            	 10006:     ; Reset shove info and invincibility timer, because Ganon
                            	 10007:     ; doesn't react at all as a usual monster.
                            	 10008:     ;
02:0003C996 4EB90003109A    	 10009:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 10010:     even
                            	 10011: _L_z04_Ganon_CheckCollisions_Exit:
02:0003C99C 4E75            	 10012:     rts
                            	 10013: 
                            	 10014:     even
                            	 10015: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 10016:     ; If the silver arrow is not in the inventory, then return.
                            	 10017:     ;
02:0003C99E 102C0659        	 10018:     move.b  ($0659,A4),D0
02:0003C9A2 0C000002        	 10019:     cmpi.b  #$02,D0
02:0003C9A6 66F4            	 10020:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 10021:     ; Reset the collision return value [06].
                            	 10022:     ;
02:0003C9A8 7000            	 10023:     moveq   #0,D0
02:0003C9AA 19400006        	 10024:     move.b  D0,($0006,A4)
                            	 10025:     ; If there's no arrow in flight, then return.
                            	 10026:     ;
02:0003C9AE 7612            	 10027:     moveq   #18,D3
02:0003C9B0 41EC00AC        	 10028:     lea     ($00AC,A4),A0
02:0003C9B4 10303000        	 10029:     move.b  (A0,D3.W),D0
02:0003C9B8 0C000010        	 10030:     cmpi.b  #$10,D0
02:0003C9BC 66DE            	 10031:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 10032:     ; Check for collision with an arrow; and return if no collision.
                            	 10033:     ;
02:0003C9BE 4EB9000310B4    	 10034:     jsr     CheckMonsterArrowOrRodCollision
02:0003C9C4 102C0006        	 10035:     move.b  ($0006,A4),D0
02:0003C9C8 67D2            	 10036:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 10037:     ; Set the Ganon phase to "dying".
                            	 10038:     ;
02:0003C9CA 41EC042C        	 10039:     lea     ($042C,A4),A0
02:0003C9CE 52302000        	 10040:     addq.b  #1,(A0,D2.W)
                            	 10041:     ; Now his body does flash.
                            	 10042:     ;
02:0003C9D2 7028            	 10043:     moveq   #40,D0
02:0003C9D4 41EC04F0        	 10044:     lea     ($04F0,A4),A0
02:0003C9D8 11802000        	 10045:     move.b  D0,(A0,D2.W)
                            	 10046:     ; Set initial cloud distance 8.
                            	 10047:     ;
02:0003C9DC 7008            	 10048:     moveq   #8,D0
02:0003C9DE 41EC0478        	 10049:     lea     ($0478,A4),A0
02:0003C9E2 11802000        	 10050:     move.b  D0,(A0,D2.W)
02:0003C9E6 0A3C0001        	 10051:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C9EA 4E75            	 10052:     rts
                            	 10053: 
                            	 10054:     even
