                            	  6189: SetUpWeaponWithState:
02:00049AC4 41EC00AC        	  6190:     lea     ($00AC,A4),A0
02:00049AC8 11802000        	  6191:     move.b  D0,(A0,D2.W)
02:00049ACC 7010            	  6192:     moveq   #16,D0
02:00049ACE 4EB900030902    	  6193:     jsr     PlaceWeapon
                            	  6194:     ; If the direction is horizontal, and X < $14 or >= $EC, then
                            	  6195:     ; deactivate the shot object.
