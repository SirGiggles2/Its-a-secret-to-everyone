                            	  4812: __far_z_04_0036:
                            	  4813: _anon_z04_82:
                            	  4814:     ; Turn randomly while flying, as usual.
                            	  4815:     ;
02:0003A2BC 61002D24        	  4816:     jsr     Flyer_Wander
                            	  4817:     ; After every turn, the common flyer routines set timer to $10.
                            	  4818:     ; This can be used as a signal for moldorm to propagate
                            	  4819:     ; direction changes down the chain.
                            	  4820:     ;
                            	  4821:     ; Between each turn, timer <> $10.
                            	  4822:     ;
                            	  4823:     ; At the end of the delay after the last turn, timer = 0.
                            	  4824:     ; This is a signal that that flying state ended, and a new one
                            	  4825:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  4826:     ; we can propagate direction changes again; and start
                            	  4827:     ; a new flying interval by setting timer to $10. This will make
                            	  4828:     ; the next flying state delay that amount of time before turning
                            	  4829:     ; the first time.
                            	  4830:     ;
                            	  4831:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  4832:     ; arm the timer again, and shift directions down the chain.
                            	  4833:     ;
02:0003A2C0 10342028        	  4834:     move.b  ($28,A4,D2.W),D0
02:0003A2C4 6602            	  4835:     bne.s  __far_z_04_0037
02:0003A2C6 60CE            	  4836:     jmp  Moldorm_ChangeFlyingState
                            	  4837: __far_z_04_0037:
                            	  4838:     even
