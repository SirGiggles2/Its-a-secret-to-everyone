                            	  6180: _L_z07_UpdateSwordOrRod_MakeMagicShot:
                            	  6181:     ; Play "magic shot" tune.
                            	  6182:     ;
02:00049ABA 7004            	  6183:     moveq   #4,D0
02:00049ABC 19400604        	  6184:     move.b  D0,($0604,A4)
                            	  6185:     ; Activate the shot object (state $80).
                            	  6186:     ;
02:00049AC0 103C0080        	  6187:     move.b  #$80,D0
