02:00038C02 10302000        	  1591:     move.b  (A0,D2.W),D0
02:00038C06 0C000003        	  1592:     cmpi.b  #$03,D0
02:00038C0A 6726            	  1593:     beq  _L_z04__TryShooting_TryShootingNow
02:00038C0C 0C000001        	  1594:     cmpi.b  #$01,D0
02:00038C10 6720            	  1595:     beq  _L_z04__TryShooting_TryShootingNow
02:00038C12 0C000009        	  1596:     cmpi.b  #$09,D0
02:00038C16 671A            	  1597:     beq  _L_z04__TryShooting_TryShootingNow
02:00038C18 0C00000A        	  1598:     cmpi.b  #$0A,D0
02:00038C1C 6714            	  1599:     beq  _L_z04__TryShooting_TryShootingNow
02:00038C1E 41EC0451        	  1600:     lea     ($0451,A4),A0
02:00038C22 10302000        	  1601:     move.b  (A0,D2.W),D0
02:00038C26 660A            	  1602:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1603:     ; and a random value < $F8, then return.
