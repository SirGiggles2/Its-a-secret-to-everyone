                            	   783: InitMode7_Sub2:
                            	   784:     ; This transfers a room's play area tiles to nametable 2.
                            	   785:     ;
                            	   786:     ; CurRow starts at the bottom ($15).
02:0003D7A6 610037E0        	   787:     jsr     CopyRowToTileBuf
02:0003D7AA 102C0302        	   788:     move.b  ($0302,A4),D0
                            	   789:     ; Change the target nametable from 0 to 2.
                            	   790:     ;
                            	   791:     ; Because there's only a play area and no status bar in
                            	   792:     ; nametable 2, you have to add 7 to the high byte instead of 8.
                            	   793:     ; So, the top of the play area in NT 0 is at $2100.
                            	   794:     ; But the top of the play area in NT 2 is at $2800.
                            	   795:     ;
                            	   796:     ; This assumes that you want to scroll vertically, where the
                            	   797:     ; two scroll areas must be contiguous vertically.
02:0003D7AE 0200000F        	   798:     andi.b #$0F,D0
02:0003D7B2 023C00EE        	   799:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D7B6 123C0027        	   800:     move.b  #$27,D1
02:0003D7BA D101            	   801:     addx.b  D1,D0   ; ADC #$27 (X flag = 6502 C)
02:0003D7BC 19400302        	   802:     move.b  D0,($0302,A4)
02:0003D7C0 102C0098        	   803:     move.b  ($0098,A4),D0
02:0003D7C4 0C000004        	   804:     cmpi.b  #$04,D0
02:0003D7C8 6404            	   805:     bcc  _anon_z05_20
                            	   806:     ; then you DO have to account for the status bar.
                            	   807:     ; So, add $100 (by incrementing high byte) to move
                            	   808:     ; everything down 64 pixels.
                            	   809:     ;
                            	   810:     ; Now the play areas will line up in NT 0 and NT 2 when
                            	   811:     ; we change mirroring to vertical at the end of this mode.
02:0003D7CA 522C0302        	   812:     addq.b  #1,($0302,A4)
                            	   813: _anon_z05_20:
02:0003D7CE 532C00E9        	   814:     subq.b  #1,($00E9,A4)
02:0003D7D2 6A06            	   815:     bpl  _anon_z05_21
                            	   816:     even
