                            	 10814: SetDelayAndTurn:
                            	 10815:     ; Set a delay of $10 frames.
                            	 10816:     ;
02:0003CF1E 7010            	 10817:     moveq   #16,D0
02:0003CF20 19802028        	 10818:     move.b  D0,($28,A4,D2.W)
                            	 10819:     even
                            	 10820: TurnTowardsPlayer8:
                            	 10821:     ; Build a direction in [00] towards the player.
                            	 10822:     ;
                            	 10823:     ; First, calculate a horizontal component:
                            	 10824:     ;
                            	 10825:     ; If   observed player X = object X, [00] := 0 (none)
                            	 10826:     ; elif observed player X > object X, [00] := 1 (right)
                            	 10827:     ; else                               [00] := 2 (left)
                            	 10828:     ;
02:0003CF24 7600            	 10829:     moveq   #0,D3
02:0003CF26 1883            	 10830:     move.b  D3,($0000,A4)
02:0003CF28 5203            	 10831:     addq.b  #1,D3
02:0003CF2A 102C0061        	 10832:     move.b  ($0061,A4),D0
02:0003CF2E 12342070        	 10833:     move.b  ($70,A4,D2.W),D1
02:0003CF32 B001            	 10834:     cmp.b   D1,D0
02:0003CF34 6706            	 10835:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003CF36 6402            	 10836:     bcc  _anon_z04_175
02:0003CF38 5203            	 10837:     addq.b  #1,D3
                            	 10838: _anon_z04_175:
02:0003CF3A 1883            	 10839:     move.b  D3,($0000,A4)
                            	 10840:     even
                            	 10841: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 10842:     ; Second, calculate a vertical component.
                            	 10843:     ; Combine it with the horizontal component:
                            	 10844:     ;
                            	 10845:     ; Y := 4 (down)
                            	 10846:     ; if observed player Y <> object Y then
                            	 10847:     ;   if observed player Y < object Y then
                            	 10848:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 10849:     ;   [00] := [00] | Y
                            	 10850:     ;
02:0003CF3C 7601            	 10851:     moveq   #1,D3
02:0003CF3E 102C0062        	 10852:     move.b  ($0062,A4),D0
02:0003CF42 41EC0084        	 10853:     lea     ($0084,A4),A0
