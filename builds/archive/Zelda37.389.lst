                            	  4759:     ; Chase while flying, as usual.
                            	  4760:     ;
02:0003A28A 61002C78        	  4761:     jsr     Flyer_Chase
                            	  4762:     ; If timer has not expired, then
                            	  4763:     ; go see if it's time to propagate direction changes down the chain.
                            	  4764:     ;
02:0003A28E 10342028        	  4765:     move.b  ($28,A4,D2.W),D0
02:0003A292 6702            	  4766:     beq.s  __far_z_04_0034
