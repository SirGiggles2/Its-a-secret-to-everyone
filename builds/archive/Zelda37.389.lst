02:0003D3A4 102C0254        	   280:     move.b  ($0254,A4),D0
02:0003D3A8 1B00            	   281:     move.b  D0,-(A5)  ; PHA
02:0003D3AA 102C0258        	   282:     move.b  ($0258,A4),D0
02:0003D3AE 1B00            	   283:     move.b  D0,-(A5)  ; PHA
02:0003D3B0 4EB900047B72    	   284:     jsr     HideAllSprites
