02:0003829E 670000FC        	   261:     beq  _L_z04_Exit_SetInputDir
02:000382A2 41EC0394        	   262:     lea     ($0394,A4),A0
02:000382A6 10302000        	   263:     move.b  (A0,D2.W),D0
02:000382AA 0200000F        	   264:     andi.b #$0F,D0
02:000382AE 660000EC        	   265:     bne  _L_z04_Exit_SetInputDir
                            	   266:     ; Set truncated grid offset.
                            	   267:     ;
02:000382B2 41EC0394        	   268:     lea     ($0394,A4),A0
02:000382B6 11802000        	   269:     move.b  D0,(A0,D2.W)
                            	   270:     ; If turn rate < a random value, or Link's state = $FF;
                            	   271:     ; then go turn if turn timer has expired.
                            	   272:     ;
02:000382BA 41EC041F        	   273:     lea     ($041F,A4),A0
02:000382BE 10302000        	   274:     move.b  (A0,D2.W),D0
02:000382C2 12342019        	   275:     move.b  ($19,A4,D2.W),D1
02:000382C6 B001            	   276:     cmp.b   D1,D0
02:000382C8 650000AC        	   277:     bcs  _L_z04_Exit_TurnIfTime
02:000382CC 102C00AC        	   278:     move.b  ($00AC,A4),D0
02:000382D0 0C0000FF        	   279:     cmpi.b  #$FF,D0
02:000382D4 670000A0        	   280:     beq  _L_z04_Exit_TurnIfTime
                            	   281:     ; Get the absolute horizontal distance between
                            	   282:     ; the monster and the chase target.
                            	   283:     ;
02:000382D8 102C0061        	   284:     move.b  ($0061,A4),D0
02:000382DC 003C0011        	   285:     ori     #$11,CCR  ; SEC: set C+X
02:000382E0 12342070        	   286:     move.b  ($70,A4,D2.W),D1
02:000382E4 0A3C0010        	   287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000382E8 9101            	   288:     subx.b  D1,D0   ; SBC ObjX,X
02:000382EA 0A3C0010        	   289:     eori    #$10,CCR  ; restore X = 6502 C
02:000382EE 6A0C            	   290:     bpl  _anon_z04_8
02:000382F0 4600            	   291:     eori.b #$FF,D0
02:000382F2 023C00EE        	   292:     andi    #$EE,CCR  ; CLC: clear C+X
02:000382F6 123C0001        	   293:     move.b  #$01,D1
02:000382FA D101            	   294:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	   295: _anon_z04_8:
                            	   296:     ; If distance >= 9, then go check the vertical distance.
