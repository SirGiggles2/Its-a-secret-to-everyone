                            	  2965: InitArmosOrFlyingGhini:
                            	  2966:     ; In UpdateObject, this object was flagged "initialized".
                            	  2967:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2968:     ;
02:000395A8 10342028        	  2969:     move.b  ($28,A4,D2.W),D0
02:000395AC 41EC0492        	  2970:     lea     ($0492,A4),A0
02:000395B0 11802000        	  2971:     move.b  D0,(A0,D2.W)
                            	  2972:     ; If it's still fading in, then go finish some initialization needed
                            	  2973:     ; for fading in.
                            	  2974:     ;
02:000395B4 660000B6        	  2975:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2976:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2977:     ; go finish initializing it.
                            	  2978:     ;
02:000395B8 41EC034F        	  2979:     lea     ($034F,A4),A0
02:000395BC 10302000        	  2980:     move.b  (A0,D2.W),D0
02:000395C0 0C000022        	  2981:     cmpi.b  #$22,D0
02:000395C4 670000A6        	  2982:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2983:     ; Else we have an armos.
                            	  2984:     ;
                            	  2985:     ; Store stairs tile $70 in [00] for use later.
                            	  2986:     ;
02:000395C8 7070            	  2987:     moveq   #112,D0
02:000395CA 1880            	  2988:     move.b  D0,($0000,A4)
                            	  2989:     ; Look for the current room ID in an array of room ID's that
                            	  2990:     ; have armos secrets.
                            	  2991:     ;
02:000395CC 7606            	  2992:     moveq   #6,D3
                            	  2993:     even
                            	  2994: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:000395CE 102C00EB        	  2995:     move.b  ($00EB,A4),D0
                            	  2996:     ; If this element does not match the current room ID, go loop again.
                            	  2997:     ;
02:000395D2 41F900039598    	  2998:     lea     (SecretArmosRoomIds).l,A0
02:000395D8 12303000        	  2999:     move.b  (A0,D3.W),D1
02:000395DC B001            	  3000:     cmp.b   D1,D0
02:000395DE 6648            	  3001:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3002:     ; The secret (usually stairs) is under one of the armoses.
                            	  3003:     ;
                            	  3004:     ; If the armos's X coordinate does not match the one needed
                            	  3005:     ; for the current room in the list, then go loop again.
                            	  3006:     ;
02:000395E0 10342070        	  3007:     move.b  ($70,A4,D2.W),D0
02:000395E4 41F9000395A0    	  3008:     lea     (SecretArmosXs).l,A0
02:000395EA 12303000        	  3009:     move.b  (A0,D3.W),D1
02:000395EE B001            	  3010:     cmp.b   D1,D0
02:000395F0 6636            	  3011:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3012:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3013:     ;
02:000395F2 41EC0084        	  3014:     lea     ($0084,A4),A0
02:000395F6 10302000        	  3015:     move.b  (A0,D2.W),D0
02:000395FA 0C000080        	  3016:     cmpi.b  #$80,D0
02:000395FE 6628            	  3017:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3018:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3019:     ;
02:00039600 4A03            	  3020:     cmpi.b  #$00,D3
02:00039602 662C            	  3021:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3022:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3023:     ; has the power bracelet.
                            	  3024:     ;
                            	  3025:     ; Set up the room item with the armos's coordinates.
                            	  3026:     ;
02:00039604 19400097        	  3027:     move.b  D0,($0097,A4)
02:00039608 10342070        	  3028:     move.b  ($70,A4,D2.W),D0
02:0003960C 19400083        	  3029:     move.b  D0,($0083,A4)
                            	  3030:     ; This resets the room item's state, which activates it.
                            	  3031:     ;
02:00039610 194300BF        	  3032:     move.b  D3,($00BF,A4)
                            	  3033:     ; Set the room item ID.
                            	  3034:     ;
02:00039614 7014            	  3035:     moveq   #20,D0
02:00039616 194000AB        	  3036:     move.b  D0,($00AB,A4)
                            	  3037:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3038:     ;
                            	  3039:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3040:     ;
                            	  3041:     ; Note that, if the item was already taken, then the room item
                            	  3042:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3043:     ; it will be ignored, because that routine checks whether
                            	  3044:     ; the item was taken.
                            	  3045:     ;
02:0003961A 4EB9000309D4    	  3046:     jsr     GetRoomFlagUWItemState
02:00039620 660A            	  3047:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00039622 6100069E        	  3048:     jsr     PlaySecretFoundTune
02:00039626 6604            	  3049:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3050:     even
                            	  3051: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3052:     ; Bottom of the loop.
                            	  3053:     ;
02:00039628 5303            	  3054:     subq.b  #1,D3
02:0003962A 6AA2            	  3055:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3056:     even
                            	  3057: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3058:     ; Not found, or found the power bracelet.
                            	  3059:     ; Use a floor tile $26 to replace the armos.
