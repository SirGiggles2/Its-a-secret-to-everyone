02:0003A48C 19802070        	  5122:     move.b  D0,($70,A4,D2.W)
02:0003A490 41EC0084        	  5123:     lea     ($0084,A4),A0
02:0003A494 10302000        	  5124:     move.b  (A0,D2.W),D0
02:0003A498 023C00EE        	  5125:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A49C 41F90003A338    	  5126:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A4A2 12303000        	  5127:     move.b  (A0,D3.W),D1
02:0003A4A6 D101            	  5128:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A4A8 41EC0084        	  5129:     lea     ($0084,A4),A0
02:0003A4AC 11802000        	  5130:     move.b  D0,(A0,D2.W)
                            	  5131:     ; Check the room boundary and object collisions in this temporary location.
                            	  5132:     ;
