02:0003C83C 19400340        	  9826:     move.b  D0,($0340,A4)
02:0003C840 0A3C0001        	  9827:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C844 4E75            	  9828:     rts
