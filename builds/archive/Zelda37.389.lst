02:0003C406 102C0085        	  9230:     move.b  ($0085,A4),D0
02:0003C40A 003C0011        	  9231:     ori     #$11,CCR  ; SEC: set C+X
02:0003C40E 1214            	  9232:     move.b  ($0000,A4),D1
02:0003C410 0A3C0010        	  9233:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C414 9101            	  9234:     subx.b  D1,D0   ; SBC $00
02:0003C416 0A3C0010        	  9235:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C41A 41EC0084        	  9236:     lea     ($0084,A4),A0
02:0003C41E 11802000        	  9237:     move.b  D0,(A0,D2.W)
                            	  9238:     even
