                            	  5301: __far_z_07_0080:
                            	  5302:     ; Reset [00], which will hold the number of axes where the distance <= 8
                            	  5303:     ; when calculating the angle to return to thrower.
                            	  5304:     ; See states $40 and $50 and GetDirectionsAndDistancesToTarget.
                            	  5305:     ;
