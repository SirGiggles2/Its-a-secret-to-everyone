02:0003966E 41EC03F8        	  3106:     lea     ($03F8,A4),A0
02:00039672 11802000        	  3107:     move.b  D0,(A0,D2.W)
02:00039676 41EC0098        	  3108:     lea     ($0098,A4),A0
02:0003967A 11802000        	  3109:     move.b  D0,(A0,D2.W)
                            	  3110:     ; Every other frame, return without drawing.
