02:0003CA46 41EC0306        	 10106:     lea     ($0306,A4),A0
02:0003CA4A 11802000        	 10107:     move.b  D0,(A0,D2.W)
02:0003CA4E 5303            	 10108:     subq.b  #1,D3
02:0003CA50 5302            	 10109:     subq.b  #1,D2
02:0003CA52 6AE8            	 10110:     bpl  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_OverwriteColors
02:0003CA54 7400            	 10111:     moveq   #0,D2
02:0003CA56 142C0340        	 10112:     move.b  ($0340,A4),D2
