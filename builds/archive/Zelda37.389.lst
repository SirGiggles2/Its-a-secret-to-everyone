                            	  5770: _anon_z05_124:
                            	  5771:     ; Add the door to the opened door mask, reset door command,
                            	  5772:     ; and lay out doors.
                            	  5773:     ;
02:00040A2A 102C0055        	  5774:     move.b  ($0055,A4),D0
02:00040A2E 122C00EE        	  5775:     move.b  ($00EE,A4),D1
02:00040A32 8001            	  5776:     or.b  D1,D0
02:00040A34 6000FF66        	  5777:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5778: 
                            	  5779: ; Params:
                            	  5780: ; [08]: 0 if closed
                            	  5781: ;
                            	  5782: ; Returns:
                            	  5783: ; X: current length of dynamic transfer buf
                            	  5784: ; [00]: door VRAM address high byte
                            	  5785: ; [01]: door VRAM address low byte
                            	  5786: ; [02:03]: address of door tiles for direction and face
                            	  5787: ; [05]: 2, the number of transfer records to write
                            	  5788: ; [06]: 2, the number of tiles in each record
                            	  5789: ; [07]: 0, the first index of a tile to transfer
                            	  5790: ; [09]: door direction index
                            	  5791: ;
                            	  5792: ; Note that this routine is called with triggered doors:
                            	  5793: ; doors that can change state. Their door type numbers are >= 4.
                            	  5794: ;
                            	  5795: ; If this routine were ever called with a fixed door
                            	  5796: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5797: ; values for the door face.
                            	  5798: ;
                            	  5799: ;
                            	  5800: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5801: ;
                            	  5802:     even
                            	  5803: PrepareWriteHorizontalDoorTransferRecords:
02:00040A38 102C0055        	  5804:     move.b  ($0055,A4),D0
02:00040A3C 19400002        	  5805:     move.b  D0,($0002,A4)
02:00040A40 6100F9A4        	  5806:     jsr     FindDoorAttrByDoorBit
02:00040A44 0C000005        	  5807:     cmpi.b  #$05,D0
02:00040A48 650C            	  5808:     bcs  _anon_z05_125
02:00040A4A 1B00            	  5809:     move.b  D0,-(A5)  ; PHA
02:00040A4C 7004            	  5810:     moveq   #4,D0
02:00040A4E 4EB90003081A    	  5811:     jsr     PlaySample
02:00040A54 101D            	  5812:     move.b  (A5)+,D0  ; PLA
                            	  5813: _anon_z05_125:
                            	  5814:     ; Calculate the door face index in three parts.
                            	  5815:     ;
                            	  5816:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5817:     ; (provisional face index in Y register).
                            	  5818:     ;
02:00040A56 0C000004        	  5819:     cmpi.b  #$04,D0
02:00040A5A 6602            	  5820:     bne  _anon_z05_126
02:00040A5C 7008            	  5821:     moveq   #8,D0
                            	  5822: _anon_z05_126:
02:00040A5E 0C000001        	  5823:     cmpi.b  #$01,D0
02:00040A62 6602            	  5824:     bne  _anon_z05_127
02:00040A64 7004            	  5825:     moveq   #4,D0
                            	  5826: _anon_z05_127:
                            	  5827:     ; Second, subtract 3 from provisional face index.
                            	  5828:     ;
02:00040A66 003C0011        	  5829:     ori     #$11,CCR  ; SEC: set C+X
02:00040A6A 123C0003        	  5830:     move.b  #$03,D1
02:00040A6E 0A3C0010        	  5831:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040A72 9101            	  5832:     subx.b  D1,D0   ; SBC #$03
02:00040A74 0A3C0010        	  5833:     eori    #$10,CCR  ; restore X = 6502 C
02:00040A78 7600            	  5834:     moveq   #0,D3
02:00040A7A 1600            	  5835:     move.b  D0,D3
                            	  5836:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5837:     ; face index >= 3, then subtract 1 from it.
                            	  5838:     ;
                            	  5839:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5840:     ; then make it 1.
                            	  5841:     ;
02:00040A7C 102C0008        	  5842:     move.b  ($0008,A4),D0
02:00040A80 6708            	  5843:     beq  _anon_z05_128
02:00040A82 0C030005        	  5844:     cmpi.b  #$05,D3
02:00040A86 670A            	  5845:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040A88 7601            	  5846:     moveq   #1,D3
                            	  5847: _anon_z05_128:
02:00040A8A 0C030003        	  5848:     cmpi.b  #$03,D3
02:00040A8E 6502            	  5849:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040A90 5303            	  5850:     subq.b  #1,D3
                            	  5851:     even
                            	  5852: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5853:     ; The routine that returned the door type also returned its
                            	  5854:     ; reverse direction index in [03].
                            	  5855:     ;
                            	  5856:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5857:     ;
02:00040A92 7003            	  5858:     moveq   #3,D0
02:00040A94 003C0011        	  5859:     ori     #$11,CCR  ; SEC: set C+X
02:00040A98 122C0003        	  5860:     move.b  ($0003,A4),D1
02:00040A9C 0A3C0010        	  5861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040AA0 9101            	  5862:     subx.b  D1,D0   ; SBC $03
02:00040AA2 0A3C0010        	  5863:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5864:     ; Call this to put the address of door face tiles in [02:03].
                            	  5865:     ;
02:00040AA6 6100FD7A        	  5866:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5867:     ; Return the address of the door in the nametable in [01:00].
