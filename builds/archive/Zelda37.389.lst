02:00030CE4 704C            	  2148:     moveq   #76,D0
                            	  2149:     even
                            	  2150: DrawObjectWithAnimAndSpecificSprites:
02:00030CE6 19400344        	  2151:     move.b  D0,($0344,A4)
02:00030CEA 7600            	  2152:     moveq   #0,D3
02:00030CEC 162C000E        	  2153:     move.b  ($000E,A4),D3
02:00030CF0 7001            	  2154:     moveq   #1,D0
02:00030CF2 19400007        	  2155:     move.b  D0,($0007,A4)
02:00030CF6 7008            	  2156:     moveq   #8,D0
02:00030CF8 1940000A        	  2157:     move.b  D0,($000A,A4)
02:00030CFC 41F900030A4C    	  2158:     lea     (ObjAnimations).l,A0
02:00030D02 10303000        	  2159:     move.b  (A0,D3.W),D0
02:00030D06 023C00EE        	  2160:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D0A 122C000D        	  2161:     move.b  ($000D,A4),D1
02:00030D0E D101            	  2162:     addx.b  D1,D0   ; ADC $0D
02:00030D10 7600            	  2163:     moveq   #0,D3
02:00030D12 1600            	  2164:     move.b  D0,D3
02:00030D14 41F900030ACC    	  2165:     lea     (ObjAnimFrameHeap).l,A0
02:00030D1A 10303000        	  2166:     move.b  (A0,D3.W),D0
02:00030D1E 19400002        	  2167:     move.b  D0,($0002,A4)
02:00030D22 023C00EE        	  2168:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D26 123C0002        	  2169:     move.b  #$02,D1
02:00030D2A D101            	  2170:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030D2C 19400003        	  2171:     move.b  D0,($0003,A4)
                            	  2172:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  2173:     ; then go set attributes and write sprites.
                            	  2174:     ;
02:00030D30 4A02            	  2175:     cmpi.b  #$00,D2
02:00030D32 6722            	  2176:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00030D34 0C02000D        	  2177:     cmpi.b  #$0D,D2
02:00030D38 641C            	  2178:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
                            	  2179:     ; If the object has a "half-width draw" attribute, then
                            	  2180:     ; go draw half-width.
