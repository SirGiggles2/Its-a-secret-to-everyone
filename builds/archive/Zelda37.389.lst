02:0003852C 52302000        	   613:     addq.b  #1,(A0,D2.W)
                            	   614:     ; If the push timer still < $10, return.
                            	   615:     ;
02:00038530 7600            	   616:     moveq   #0,D3
02:00038532 41EC0412        	   617:     lea     ($0412,A4),A0
02:00038536 16302000        	   618:     move.b  (A0,D2.W),D3
02:0003853A 0C030010        	   619:     cmpi.b  #$10,D3
02:0003853E 6402            	   620:     bcc.s  __far_z_04_0004
02:00038540 6032            	   621:     jmp  L10262_Exit
