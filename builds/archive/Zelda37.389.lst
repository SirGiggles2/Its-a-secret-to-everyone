                            	   749: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F39A 1214            	   750:     move.b  ($00,A4),D1   ; ptr lo
02:0002F39C 182C0001        	   751:     move.b  ($01,A4),D4  ; ptr hi
02:0002F3A0 024100FF        	   752:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F3A4 E14C            	   753:     lsl.w   #8,D4
02:0002F3A6 8841            	   754:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F3A8 48C4            	   755:     ext.l   D4
02:0002F3AA D8BC00FF0000    	   756:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F3B0 2044            	   757:     movea.l D4,A0
02:0002F3B2 10303000        	   758:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F3B6 122C0002        	   759:     move.b  ($02,A4),D1   ; ptr lo
02:0002F3BA 182C0003        	   760:     move.b  ($03,A4),D4  ; ptr hi
02:0002F3BE 024100FF        	   761:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F3C2 E14C            	   762:     lsl.w   #8,D4
02:0002F3C4 8841            	   763:     or.w    D1,D4
02:0002F3C6 48C4            	   764:     ext.l   D4
02:0002F3C8 D8BC00FF0000    	   765:     add.l   #NES_RAM,D4
02:0002F3CE 2044            	   766:     movea.l D4,A0
02:0002F3D0 11803000        	   767:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   768:     ; Increment source address.
                            	   769:     ;
02:0002F3D4 1014            	   770:     move.b  ($0000,A4),D0
02:0002F3D6 023C00EE        	   771:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F3DA 123C0001        	   772:     move.b  #$01,D1
02:0002F3DE D101            	   773:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F3E0 1880            	   774:     move.b  D0,($0000,A4)
02:0002F3E2 102C0001        	   775:     move.b  ($0001,A4),D0
02:0002F3E6 123C0000        	   776:     move.b  #$00,D1
02:0002F3EA D101            	   777:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F3EC 19400001        	   778:     move.b  D0,($0001,A4)
                            	   779:     ; Increment destination address.
