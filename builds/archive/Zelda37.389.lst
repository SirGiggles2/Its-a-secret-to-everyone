02:00041DCC 0C000015        	  7753:     cmpi.b  #$15,D0
02:00041DD0 640E            	  7754:     bcc  _anon_z05_170
02:00041DD2 41F900041D32    	  7755:     lea     (SubmenuTransferBufSelectorsOW).l,A0
