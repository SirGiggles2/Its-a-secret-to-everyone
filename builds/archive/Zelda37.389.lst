02:0004923E 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:00049242 41EC0084        	  4986:     lea     ($0084,A4),A0
02:00049246 10303000        	  4987:     move.b  (A0,D3.W),D0
