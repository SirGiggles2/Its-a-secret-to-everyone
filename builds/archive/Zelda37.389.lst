02:0003C818 12302000        	  9811:     move.b  (A0,D2.W),D1
02:0003C81C 8001            	  9812:     or.b  D1,D0
02:0003C81E 19400003        	  9813:     move.b  D0,($0003,A4)
02:0003C822 41F90003C6EC    	  9814:     lea     (GanonBurstTiles).l,A0
02:0003C828 10302000        	  9815:     move.b  (A0,D2.W),D0
02:0003C82C 4EB900030F98    	  9816:     jsr     Anim_WriteSprite
                            	  9817:     ; Bottom of the loop.
                            	  9818:     ; Increment object slot while <= 9.
                            	  9819:     ;
02:0003C832 5202            	  9820:     addq.b  #1,D2
02:0003C834 0C02000A        	  9821:     cmpi.b  #$0A,D2
02:0003C838 65AC            	  9822:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  9823:     ; Restore the object index.
