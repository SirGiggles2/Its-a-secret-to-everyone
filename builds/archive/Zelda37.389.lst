                            	  9258:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  9259:     ;
02:0003C450 7000            	  9260:     moveq   #0,D0
02:0003C452 1940000B        	  9261:     move.b  D0,($000B,A4)
