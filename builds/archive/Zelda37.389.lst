                            	   389: UpdateMenuStartOW:
                            	   390:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   391:     ; make it look completely empty, and no piece has been won.
                            	   392:     ;
02:0003D496 7617            	   393:     moveq   #23,D3
                            	   394: _anon_z05_6:
02:0003D498 7400            	   395:     moveq   #0,D2
02:0003D49A 41F90003D44E    	   396:     lea     (TriforceTransferBufOffsets).l,A0
02:0003D4A0 14303000        	   397:     move.b  (A0,D3.W),D2
02:0003D4A4 41F90003D47E    	   398:     lea     (TriforceTransferBufTiles).l,A0
02:0003D4AA 10303000        	   399:     move.b  (A0,D3.W),D0
02:0003D4AE 41F900044678    	   400:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003D4B4 11802000        	   401:     move.b  D0,(A0,D2.W)
02:0003D4B8 5303            	   402:     subq.b  #1,D3
02:0003D4BA 6ADC            	   403:     bpl  _anon_z05_6
                            	   404:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   405:     ;
02:0003D4BC 5203            	   406:     addq.b  #1,D3
                            	   407:     ; Outer loop.
                            	   408:     ; A level test bit in [06] will be used to see whether
                            	   409:     ; we have a triforce piece.
                            	   410:     ;
02:0003D4BE 7001            	   411:     moveq   #1,D0
02:0003D4C0 19400006        	   412:     move.b  D0,($0006,A4)
                            	   413:     even
                            	   414: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   415:     ; Inner loop.
                            	   416:     ; Each level bit will make 3 triforce tile slots be
                            	   417:     ; checked and replaced.
                            	   418:     ;
02:0003D4C4 7003            	   419:     moveq   #3,D0
02:0003D4C6 19400007        	   420:     move.b  D0,($0007,A4)
                            	   421:     even
                            	   422: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   423:     ; Get the offset into the submenu triforce transfer buffers of
                            	   424:     ; the current tile slot.
                            	   425:     ;
02:0003D4CA 7400            	   426:     moveq   #0,D2
02:0003D4CC 41F90003D44E    	   427:     lea     (TriforceTransferBufOffsets).l,A0
02:0003D4D2 14303000        	   428:     move.b  (A0,D3.W),D2
                            	   429:     ; If the level test bit is not in the triforce mask, then we don't
                            	   430:     ; have this piece. So, go loop again, and leave the tile in the
                            	   431:     ; empty state.
                            	   432:     ;
                            	   433:     ;
                            	   434:     ; [06] level test mask
02:0003D4D6 102C0006        	   435:     move.b  ($0006,A4),D0
02:0003D4DA 122C0671        	   436:     move.b  ($0671,A4),D1
02:0003D4DE C200            	   437:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D4E0 6730            	   438:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   439:     ; We have the triforce piece.
                            	   440:     ;
                            	   441:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   442:     ; then make it $F5. These are tiles that were half full, and now
                            	   443:     ; need to be full.
                            	   444:     ;
                            	   445:     ; Else replace it with the one at the current triforce tile slot
                            	   446:     ; in the replacement list.
                            	   447:     ;
02:0003D4E2 41F900044678    	   448:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003D4E8 10302000        	   449:     move.b  (A0,D2.W),D0
02:0003D4EC 0C0000E5        	   450:     cmpi.b  #$E5,D0
02:0003D4F0 6712            	   451:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003D4F2 0C0000E6        	   452:     cmpi.b  #$E6,D0
02:0003D4F6 670C            	   453:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003D4F8 41F90003D466    	   454:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003D4FE 10303000        	   455:     move.b  (A0,D3.W),D0
02:0003D502 6004            	   456:     jmp     _anon_z05_7
                            	   457: 
                            	   458:     even
                            	   459: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003D504 103C00F5        	   460:     move.b  #$F5,D0
                            	   461: _anon_z05_7:
02:0003D508 41F900044678    	   462:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003D50E 11802000        	   463:     move.b  D0,(A0,D2.W)
                            	   464:     even
                            	   465: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   466:     ; Bottom of the inner loop.
                            	   467:     ;
                            	   468:     ; Increment the triforce tile slot.
                            	   469:     ; Decrement [07] and loop again, if it's not 0.
                            	   470:     ;
02:0003D512 5203            	   471:     addq.b  #1,D3
02:0003D514 532C0007        	   472:     subq.b  #1,($0007,A4)
02:0003D518 66B0            	   473:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   474:     ; Bottom of the outer loop.
                            	   475:     ;
                            	   476:     ; Shift the level test bit [06] left to test the next level.
                            	   477:     ; When it becomes 0, we're done.
                            	   478:     ;
02:0003D51A 122C0006        	   479:     move.b  ($0006,A4),D1
02:0003D51E E309            	   480:     lsl.b  #1,D1   ; ASL $06
02:0003D520 19410006        	   481:     move.b  D1,($0006,A4)
02:0003D524 669E            	   482:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003D526 522C00E1        	   483:     addq.b  #1,($00E1,A4)
02:0003D52A 4E75            	   484:     rts
                            	   485: 
                            	   486:     even
                            	   487: ScrollWorld:
02:0003D52C 102C0015        	   488:     move.b  ($0015,A4),D0
                            	   489:     ; The purpose of this is to delay vertical scrolling.
                            	   490:     ; OW: once every two frames
                            	   491:     ; UW: once every four frames
                            	   492:     ; Horizontal scrolling happens every frame.
02:0003D530 02000003        	   493:     andi.b #$03,D0
02:0003D534 7600            	   494:     moveq   #0,D3
02:0003D536 162C0010        	   495:     move.b  ($0010,A4),D3
02:0003D53A 6604            	   496:     bne  _anon_z05_8
02:0003D53C 02000001        	   497:     andi.b #$01,D0
                            	   498: _anon_z05_8:
02:0003D540 122C00E6        	   499:     move.b  ($00E6,A4),D1
02:0003D544 B001            	   500:     cmp.b   D1,D0
02:0003D546 6704            	   501:     beq.s  __far_z_05_0004
02:0003D548 600000DE        	   502:     jmp  ScrollWorldH
                            	   503: __far_z_05_0004:
02:0003D54C 7008            	   504:     moveq   #8,D0
02:0003D54E 122C0098        	   505:     move.b  ($0098,A4),D1
02:0003D552 C200            	   506:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D554 6602            	   507:     bne.s  __far_z_05_0005
02:0003D556 606E            	   508:     jmp  ScrollWorldDownOrH
                            	   509: __far_z_05_0005:
                            	   510:     ; then scroll up.
                            	   511:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   512:     ;
02:0003D558 532C00E9        	   513:     subq.b  #1,($00E9,A4)
02:0003D55C 102C0084        	   514:     move.b  ($0084,A4),D0
02:0003D560 0C0000DD        	   515:     cmpi.b  #$DD,D0
02:0003D564 640A            	   516:     bcc  _anon_z05_9
02:0003D566 123C0008        	   517:     move.b  #$08,D1
02:0003D56A D101            	   518:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D56C 19400084        	   519:     move.b  D0,($0084,A4)
                            	   520: _anon_z05_9:
02:0003D570 102C00E2        	   521:     move.b  ($00E2,A4),D0
02:0003D574 003C0011        	   522:     ori     #$11,CCR  ; SEC: set C+X
02:0003D578 123C0020        	   523:     move.b  #$20,D1
02:0003D57C 0A3C0010        	   524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D580 9101            	   525:     subx.b  D1,D0   ; SBC #$20
02:0003D582 0A3C0010        	   526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D586 194000E2        	   527:     move.b  D0,($00E2,A4)
02:0003D58A 6404            	   528:     bcc  _anon_z05_10
02:0003D58C 532C0058        	   529:     subq.b  #1,($0058,A4)
                            	   530: _anon_z05_10:
02:0003D590 0C0000E0        	   531:     cmpi.b  #$E0,D0
02:0003D594 661E            	   532:     bne  _L_z05_ScrollWorld_Exit
02:0003D596 102C0058        	   533:     move.b  ($0058,A4),D0
02:0003D59A 0C000020        	   534:     cmpi.b  #$20,D0
02:0003D59E 6716            	   535:     beq  _L_z05_ScrollWorld_LimitLow
02:0003D5A0 0C000027        	   536:     cmpi.b  #$27,D0
02:0003D5A4 660E            	   537:     bne  _L_z05_ScrollWorld_Exit
                            	   538:     ; VScroll address is $27E0. So, we rolled from the
                            	   539:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   540:     ; to $23A0, the true last row of NT 0.
02:0003D5A6 7023            	   541:     moveq   #35,D0
02:0003D5A8 19400058        	   542:     move.b  D0,($0058,A4)
02:0003D5AC 103C00A0        	   543:     move.b  #$A0,D0
02:0003D5B0 194000E2        	   544:     move.b  D0,($00E2,A4)
                            	   545:     even
                            	   546: _L_z05_ScrollWorld_Exit:
02:0003D5B4 4E75            	   547:     rts
                            	   548: 
                            	   549:     even
                            	   550: _L_z05_ScrollWorld_LimitLow:
                            	   551:     ; Don't let the scroll position go above $2100, the bottom of
                            	   552:     ; the status bar; nor below $2800, the top of NT 2.
02:0003D5B6 522C0058        	   553:     addq.b  #1,($0058,A4)
                            	   554:     even
