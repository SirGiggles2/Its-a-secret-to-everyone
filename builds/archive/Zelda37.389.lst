02:0003D3BC 101D            	   287:     move.b  (A5)+,D0  ; PLA
02:0003D3BE 19400254        	   288:     move.b  D0,($0254,A4)
02:0003D3C2 522C00E1        	   289:     addq.b  #1,($00E1,A4)
02:0003D3C6 0A3C0001        	   290:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D3CA 4E75            	   291:     rts
