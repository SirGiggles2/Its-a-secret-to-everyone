                            	  5565: __far_z_05_0076:
                            	  5566:     ; Turn the door command into the desired open or closed state
                            	  5567:     ; to store in [08].
                            	  5568:     ;
                            	  5569:     ; cmd:  7 6 3 2 
                            	  5570:     ; [08]: 2 0 0 0
                            	  5571:     ;
                            	  5572:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5573:     ; commands intended to be used.
                            	  5574:     ;
                            	  5575:     ; 3 is the end state of 2: close
                            	  5576:     ; 7 is the end state of 6: open
                            	  5577:     ;
02:000408A8 02000007        	  5578:     andi.b #$07,D0
02:000408AC 7601            	  5579:     moveq   #1,D3
02:000408AE 19430002        	  5580:     move.b  D3,($0002,A4)
02:000408B2 122C0002        	  5581:     move.b  ($0002,A4),D1
02:000408B6 C200            	  5582:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000408B8 6702            	  5583:     beq  _anon_z05_118
02:000408BA E208            	  5584:     lsr.b  #1,D0   ; LSR A
                            	  5585: _anon_z05_118:
02:000408BC 0C000002        	  5586:     cmpi.b  #$02,D0
02:000408C0 6606            	  5587:     bne  _anon_z05_119
                            	  5588:     ; Command 2 sets Link's timer to $30.
                            	  5589:     ;
02:000408C2 7630            	  5590:     moveq   #48,D3
02:000408C4 19430028        	  5591:     move.b  D3,($0028,A4)
                            	  5592: _anon_z05_119:
02:000408C8 02000003        	  5593:     andi.b #$03,D0
02:000408CC 003C0011        	  5594:     ori     #$11,CCR  ; SEC: set C+X
02:000408D0 123C0001        	  5595:     move.b  #$01,D1
02:000408D4 0A3C0010        	  5596:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000408D8 9101            	  5597:     subx.b  D1,D0   ; SBC #$01
02:000408DA 0A3C0010        	  5598:     eori    #$10,CCR  ; restore X = 6502 C
02:000408DE 02000002        	  5599:     andi.b #$02,D0
02:000408E2 19400008        	  5600:     move.b  D0,($0008,A4)
                            	  5601:     ; The command to close a key door or bombable wall does not
                            	  5602:     ; do anything.
                            	  5603:     ;
02:000408E6 102C0054        	  5604:     move.b  ($0054,A4),D0
02:000408EA 0C000005        	  5605:     cmpi.b  #$05,D0
02:000408EE 6416            	  5606:     bcc  _anon_z05_120
02:000408F0 102C0055        	  5607:     move.b  ($0055,A4),D0
02:000408F4 19400002        	  5608:     move.b  D0,($0002,A4)
02:000408F8 6100FAEC        	  5609:     jsr     FindDoorAttrByDoorBit
02:000408FC 0C000007        	  5610:     cmpi.b  #$07,D0
02:00040900 6704            	  5611:     beq  _anon_z05_120
02:00040902 6000009C        	  5612:     jmp     L_ResetDoorCmdAndLayOutDoors
