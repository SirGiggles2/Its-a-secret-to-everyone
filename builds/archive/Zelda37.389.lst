02:0003984A 0A3C0010        	  3399:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003984E 9101            	  3400:     subx.b  D1,D0   ; SBC #$1C
02:00039850 0A3C0010        	  3401:     eori    #$10,CCR  ; restore X = 6502 C
02:00039854 41EC0084        	  3402:     lea     ($0084,A4),A0
