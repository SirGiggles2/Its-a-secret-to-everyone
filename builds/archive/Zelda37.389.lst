                            	  1478: AnimateDemoPhase0Subphase1:
02:00032F28 102C0438        	  1479:     move.b  ($0438,A4),D0
02:00032F2C 666C            	  1480:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1481:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1482:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1483:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032F2E 7000            	  1484:     moveq   #0,D0
02:00032F30 102C0437        	  1485:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032F34 EB48            	  1486:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032F36 41F900032D18    	  1487:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032F3C D0C0            	  1488:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1489:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032F3E 197C003F0302    	  1490:     move.b  #$3F,($0302,A4)
02:00032F44 197C00000303    	  1491:     move.b  #$00,($0303,A4)
02:00032F4A 7020            	  1492:     moveq   #32,D0
02:00032F4C 19400304        	  1493:     move.b  D0,($0304,A4)
                            	  1494:     ; End marker at DynTileBuf+4+31
02:00032F50 761F            	  1495:     moveq   #31,D3
02:00032F52 103C00FF        	  1496:     move.b  #$FF,D0
02:00032F56 43EC0306        	  1497:     lea     ($0306,A4),A1
02:00032F5A 13803000        	  1498:     move.b  D0,(A1,D3.W)
                            	  1499:     even
                            	  1500: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00032F5E 10303000        	  1501:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00032F62 43EC0305        	  1502:     lea     ($0305,A4),A1
02:00032F66 13803000        	  1503:     move.b  D0,(A1,D3.W)
02:00032F6A 5303            	  1504:     subq.b  #1,D3
02:00032F6C 6AF0            	  1505:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1506:     ; Advance the subphase cycle.
                            	  1507:     ;
02:00032F6E 522C0437        	  1508:     addq.b  #1,($0437,A4)
                            	  1509:     ; Set the timer to the delay for the current point in the cycle.
                            	  1510:     ;
02:00032F72 7600            	  1511:     moveq   #0,D3
02:00032F74 162C0437        	  1512:     move.b  ($0437,A4),D3
02:00032F78 41F900032F17    	  1513:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:00032F7E 10303000        	  1514:     move.b  (A0,D3.W),D0
02:00032F82 19400438        	  1515:     move.b  D0,($0438,A4)
02:00032F86 0C03000E        	  1516:     cmpi.b  #$0E,D3
02:00032F8A 650E            	  1517:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1518:     ; Advance to the next demo phase.
                            	  1519:     ;
02:00032F8C 522C042C        	  1520:     addq.b  #1,($042C,A4)
02:00032F90 7000            	  1521:     moveq   #0,D0
02:00032F92 1940042D        	  1522:     move.b  D0,($042D,A4)
02:00032F96 19400011        	  1523:     move.b  D0,($0011,A4)
                            	  1524:     even
