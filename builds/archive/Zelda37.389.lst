02:000391A0 0A3C0010        	  2403:     eori    #$10,CCR  ; restore X = 6502 C
02:000391A4 E308            	  2404:     lsl.b  #1,D0   ; ASL A
02:000391A6 023C00EE        	  2405:     andi    #$EE,CCR  ; CLC: clear C+X
02:000391AA 41EC03E4        	  2406:     lea     ($03E4,A4),A0
02:000391AE 12302000        	  2407:     move.b  (A0,D2.W),D1
02:000391B2 D101            	  2408:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  2409:     even
