02:0003A900 651E            	  5663:     bcs  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  5664:     ; Add the displacement for this fireball to its Y coordinate.
                            	  5665:     ;
02:0003A902 41EC0084        	  5666:     lea     ($0084,A4),A0
02:0003A906 10302000        	  5667:     move.b  (A0,D2.W),D0
02:0003A90A 023C00EE        	  5668:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A90E 41EC0478        	  5669:     lea     ($0478,A4),A0
02:0003A912 12302000        	  5670:     move.b  (A0,D2.W),D1
02:0003A916 D101            	  5671:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003A918 41EC0084        	  5672:     lea     ($0084,A4),A0
02:0003A91C 11802000        	  5673:     move.b  D0,(A0,D2.W)
                            	  5674:     even
