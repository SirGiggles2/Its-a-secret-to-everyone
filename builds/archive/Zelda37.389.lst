02:0003B9E6 D101            	  7908:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B9E8 02000001        	  7909:     andi.b #$01,D0
02:0003B9EC 023C00EE        	  7910:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B9F0 123C0004        	  7911:     move.b  #$04,D1
02:0003B9F4 D101            	  7912:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
