                            	  6007: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  6008:     ; Reset horizontal flipping in [0F].
                            	  6009:     ;
02:00049964 7000            	  6010:     moveq   #0,D0
02:00049966 1940000F        	  6011:     move.b  D0,($000F,A4)
                            	  6012:     ; If state = 5, return without drawing.
                            	  6013:     ;
02:0004996A 41EC00AC        	  6014:     lea     ($00AC,A4),A0
02:0004996E 10302000        	  6015:     move.b  (A0,D2.W),D0
02:00049972 0200000F        	  6016:     andi.b #$0F,D0
02:00049976 7600            	  6017:     moveq   #0,D3
02:00049978 1600            	  6018:     move.b  D0,D3
02:0004997A 103C00FC        	  6019:     move.b  #$FC,D0
02:0004997E 0C030005        	  6020:     cmpi.b  #$05,D3
02:00049982 67DE            	  6021:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  6022:     even
                            	  6023: _L_z07_UpdateSwordOrRod_Add4:
                            	  6024:     ; Set [00] to (state - 1) * 4:
                            	  6025:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6026:     ;
02:00049984 023C00EE        	  6027:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049988 123C0004        	  6028:     move.b  #$04,D1
02:0004998C D101            	  6029:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004998E 5303            	  6030:     subq.b  #1,D3
02:00049990 66F2            	  6031:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00049992 1880            	  6032:     move.b  D0,($0000,A4)
                            	  6033:     ; Set object's direction to player's. It might have changed
                            	  6034:     ; since the last frame.
                            	  6035:     ;
02:00049994 102C0098        	  6036:     move.b  ($0098,A4),D0
02:00049998 41EC0098        	  6037:     lea     ($0098,A4),A0
02:0004999C 11802000        	  6038:     move.b  D0,(A0,D2.W)
                            	  6039:     ; Add [00] and the reverse index of the direction to get
                            	  6040:     ; the byte offset of the pixel offset.
                            	  6041:     ;
02:000499A0 4EB9000308CC    	  6042:     jsr     GetOppositeDir
02:000499A6 1003            	  6043:     move.b  D3,D0
02:000499A8 023C00EE        	  6044:     andi    #$EE,CCR  ; CLC: clear C+X
02:000499AC 1214            	  6045:     move.b  ($0000,A4),D1
02:000499AE D101            	  6046:     addx.b  D1,D0   ; ADC $00
02:000499B0 7600            	  6047:     moveq   #0,D3
02:000499B2 1600            	  6048:     move.b  D0,D3
                            	  6049:     ; Set object's X to player's X + offset for state and direction.
                            	  6050:     ; Copy the result to [00].
                            	  6051:     ;
02:000499B4 102C0070        	  6052:     move.b  ($0070,A4),D0
02:000499B8 023C00EE        	  6053:     andi    #$EE,CCR  ; CLC: clear C+X
02:000499BC 41F9000498E8    	  6054:     lea     (PlayerToWeaponOffsetsX).l,A0
02:000499C2 12303000        	  6055:     move.b  (A0,D3.W),D1
02:000499C6 D101            	  6056:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:000499C8 19802070        	  6057:     move.b  D0,($70,A4,D2.W)
02:000499CC 1880            	  6058:     move.b  D0,($0000,A4)
                            	  6059:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6060:     ; Copy the result to [01].
                            	  6061:     ;
02:000499CE 102C0084        	  6062:     move.b  ($0084,A4),D0
02:000499D2 023C00EE        	  6063:     andi    #$EE,CCR  ; CLC: clear C+X
02:000499D6 41F9000498F8    	  6064:     lea     (PlayerToWeaponOffsetsY).l,A0
02:000499DC 12303000        	  6065:     move.b  (A0,D3.W),D1
02:000499E0 D101            	  6066:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:000499E2 41EC0084        	  6067:     lea     ($0084,A4),A0
02:000499E6 11802000        	  6068:     move.b  D0,(A0,D2.W)
02:000499EA 19400001        	  6069:     move.b  D0,($0001,A4)
                            	  6070:     ; If state = 1, use up direction.
                            	  6071:     ; Else use object direction.
                            	  6072:     ;
02:000499EE 41EC00AC        	  6073:     lea     ($00AC,A4),A0
02:000499F2 10302000        	  6074:     move.b  (A0,D2.W),D0
02:000499F6 0200000F        	  6075:     andi.b #$0F,D0
02:000499FA 7600            	  6076:     moveq   #0,D3
02:000499FC 1600            	  6077:     move.b  D0,D3
02:000499FE 7008            	  6078:     moveq   #8,D0
02:00049A00 5303            	  6079:     subq.b  #1,D3
02:00049A02 6708            	  6080:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00049A04 41EC0098        	  6081:     lea     ($0098,A4),A0
02:00049A08 10302000        	  6082:     move.b  (A0,D2.W),D0
                            	  6083:     even
                            	  6084: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6085:     ; Store the weapon's frame (horizontal or vertical)
                            	  6086:     ; for the direction chosen above in [0C].
                            	  6087:     ;
02:00049A0C 4EB9000308CC    	  6088:     jsr     GetOppositeDir
02:00049A12 41F900049446    	  6089:     lea     (RDirectionToWeaponFrame).l,A0
02:00049A18 10303000        	  6090:     move.b  (A0,D3.W),D0
02:00049A1C 1940000C        	  6091:     move.b  D0,($000C,A4)
                            	  6092:     ; Calculate sprite attributes.
                            	  6093:     ;
                            	  6094:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6095:     ;   base attribute OR 1
                            	  6096:     ; So, it uses palette row 5.
                            	  6097:     ;
02:00049A20 41F90004944A    	  6098:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049A26 10303000        	  6099:     move.b  (A0,D3.W),D0
02:00049A2A 0C02000D        	  6100:     cmpi.b  #$0D,D2
02:00049A2E 6706            	  6101:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00049A30 00000001        	  6102:     ori.b #$01,D0
02:00049A34 601C            	  6103:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6104: 
                            	  6105:     even
                            	  6106: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6107:     ; The weapon is the sword.
                            	  6108:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6109:     ;
02:00049A36 023C00EE        	  6110:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049A3A 122C0657        	  6111:     move.b  ($0657,A4),D1
02:00049A3E D101            	  6112:     addx.b  D1,D0   ; ADC Items
02:00049A40 003C0011        	  6113:     ori     #$11,CCR  ; SEC: set C+X
02:00049A44 123C0001        	  6114:     move.b  #$01,D1
02:00049A48 0A3C0010        	  6115:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049A4C 9101            	  6116:     subx.b  D1,D0   ; SBC #$01
02:00049A4E 0A3C0010        	  6117:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6118:     even
                            	  6119: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6120:     ; Set sprite attributes to the calculated value above.
                            	  6121:     ;
02:00049A52 4EB900030F8E    	  6122:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  6123:     ; If the direction is left, set [0F] to flip horizontally.
                            	  6124:     ;
02:00049A58 0C030002        	  6125:     cmpi.b  #$02,D3
02:00049A5C 6604            	  6126:     bne  _anon_z07_33
02:00049A5E 522C000F        	  6127:     addq.b  #1,($000F,A4)
                            	  6128: _anon_z07_33:
                            	  6129:     ; If state = 1, return. Don't show the weapon.
                            	  6130:     ;
02:00049A62 41EC00AC        	  6131:     lea     ($00AC,A4),A0
02:00049A66 10302000        	  6132:     move.b  (A0,D2.W),D0
02:00049A6A 0200000F        	  6133:     andi.b #$0F,D0
02:00049A6E 0C000001        	  6134:     cmpi.b  #$01,D0
02:00049A72 6604            	  6135:     bne.s  __far_z_07_0091
02:00049A74 600000AA        	  6136:     jmp  L1F854_Exit
                            	  6137: __far_z_07_0091:
                            	  6138:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  6139:     ; sword or rod
                            	  6140:     ;
                            	  6141:     ;
                            	  6142:     ; Sword slot
02:00049A78 7600            	  6143:     moveq   #0,D3
02:00049A7A 0C02000D        	  6144:     cmpi.b  #$0D,D2
02:00049A7E 6702            	  6145:     beq  _anon_z07_34
02:00049A80 7608            	  6146:     moveq   #8,D3
                            	  6147: _anon_z07_34:
02:00049A82 4EB900030EAE    	  6148:     jsr     Anim_WriteItemSprites
                            	  6149:     ; If state <> 3, return.
                            	  6150:     ;
02:00049A88 41EC00AC        	  6151:     lea     ($00AC,A4),A0
02:00049A8C 10302000        	  6152:     move.b  (A0,D2.W),D0
02:00049A90 0200000F        	  6153:     andi.b #$0F,D0
02:00049A94 0C000003        	  6154:     cmpi.b  #$03,D0
02:00049A98 6704            	  6155:     beq.s  __far_z_07_0092
02:00049A9A 60000084        	  6156:     jmp  L1F854_Exit
                            	  6157: __far_z_07_0092:
                            	  6158:     ; State = 3. Time to instantiate a shot.
                            	  6159:     ;
                            	  6160:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6161:     ;
02:00049A9E 0C020012        	  6162:     cmpi.b  #$12,D2
02:00049AA2 6704            	  6163:     beq.s  __far_z_07_0093
02:00049AA4 60000082        	  6164:     jmp  MakeSwordShot
                            	  6165: __far_z_07_0093:
                            	  6166:     ; Instantiate a magic shot (rod shot).
                            	  6167:     ; Switch to the shot slot $E.
                            	  6168:     ;
02:00049AA8 740E            	  6169:     moveq   #14,D2
                            	  6170:     ; If high bit of state is set, return. It's already active.
                            	  6171:     ;
02:00049AAA 41EC00AC        	  6172:     lea     ($00AC,A4),A0
02:00049AAE 10302000        	  6173:     move.b  (A0,D2.W),D0
02:00049AB2 6706            	  6174:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00049AB4 E308            	  6175:     lsl.b  #1,D0   ; ASL A
02:00049AB6 6402            	  6176:     bcc.s  __far_z_07_0094
02:00049AB8 6066            	  6177:     jmp  L1F854_Exit
                            	  6178: __far_z_07_0094:
