                            	  2389: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  2390:     ; Or else if is zora in state 1 or 5, then use one of
                            	  2391:     ; the mound frame images:
                            	  2392:     ;
                            	  2393:     ; frame image := ((state - 1) * 2) + movement frame
                            	  2394:     ;
                            	  2395:     ; This yields 0/1 or 8/9, depending on the state.
