02:00049AFE 10302000        	  6218:     move.b  (A0,D2.W),D0
02:00049B02 E308            	  6219:     lsl.b  #1,D0   ; ASL A
02:00049B04 6404            	  6220:     bcc  _anon_z07_35
02:00049B06 163C00A0        	  6221:     move.b  #$A0,D3
                            	  6222: _anon_z07_35:
02:00049B0A 1003            	  6223:     move.b  D3,D0
02:00049B0C 41EC03BC        	  6224:     lea     ($03BC,A4),A0
02:00049B10 11802000        	  6225:     move.b  D0,(A0,D2.W)
                            	  6226:     ; Set the shot object's grid offset the same as the player's.
