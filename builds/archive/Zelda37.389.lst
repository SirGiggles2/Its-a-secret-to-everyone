                            	  1465:     even
                            	  1466: InitMode4:
02:0003E0E6 7400            	  1467:     moveq   #0,D2
02:0003E0E8 142C0013        	  1468:     move.b  ($0013,A4),D2
02:0003E0EC 6604            	  1469:     bne.s  __far_z_05_0023
02:0003E0EE 60000084        	  1470:     jmp  InitMode_EnterRoom
                            	  1471: __far_z_05_0023:
02:0003E0F2 5302            	  1472:     subq.b  #1,D2
02:0003E0F4 6612            	  1473:     bne  _L_z05_InitMode4_CheckSub2
                            	  1474:     ; Submode 1.
                            	  1475:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1476:     ;
                            	  1477:     ; TODO:
                            	  1478:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1479:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1480:     ; A positive value triggers this submode 1 to transfer
                            	  1481:     ; the whole play area.
                            	  1482:     ;
                            	  1483:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1484:     ; a good state reflecting the new room. The only thing
                            	  1485:     ; needed is possibly to brighten the room by way of
                            	  1486:     ; changing the palette.
                            	  1487:     ;
                            	  1488:     ; So why does mode 7 trigger this?
                            	  1489:     ; Is there another mode that truly needs this behavior?
                            	  1490:     ;
02:0003E0F6 102C00E9        	  1491:     move.b  ($00E9,A4),D0
02:0003E0FA 6B06            	  1492:     bmi  _anon_z05_40
02:0003E0FC 6100359A        	  1493:     jsr     CopyNextRowToTransferBuf
02:0003E100 6404            	  1494:     bcc  _L_z05_InitMode4_Exit
                            	  1495: _anon_z05_40:
02:0003E102 522C0013        	  1496:     addq.b  #1,($0013,A4)
                            	  1497:     even
                            	  1498: _L_z05_InitMode4_Exit:
02:0003E106 4E75            	  1499:     rts
                            	  1500: 
                            	  1501:     even
                            	  1502: _L_z05_InitMode4_CheckSub2:
02:0003E108 5302            	  1503:     subq.b  #1,D2
02:0003E10A 6702            	  1504:     beq.s  __far_z_05_0024
02:0003E10C 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
                            	  1507:     ; Submode 2.
                            	  1508:     ;
02:0003E10E 7600            	  1509:     moveq   #0,D3
02:0003E110 162C00EB        	  1510:     move.b  ($00EB,A4),D3
02:0003E114 61004452        	  1511:     jsr     IsDarkRoom_Bank5
02:0003E118 6702            	  1512:     beq.s  __far_z_05_0025
02:0003E11A 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
                            	  1516:     ; See if we have to brighten it after leaving a dark room.
                            	  1517:     ;
02:0003E11C 102C0098        	  1518:     move.b  ($0098,A4),D0
02:0003E120 610041C4        	  1519:     jsr     CalcNextRoomByDir
                            	  1520:     ; Subtract RoomId from next room ID that was calculated
                            	  1521:     ; to get room ID offset in that direction.
02:0003E124 003C0011        	  1522:     ori     #$11,CCR  ; SEC: set C+X
02:0003E128 122C00EB        	  1523:     move.b  ($00EB,A4),D1
02:0003E12C 0A3C0010        	  1524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E130 9101            	  1525:     subx.b  D1,D0   ; SBC RoomId
02:0003E132 0A3C0010        	  1526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E136 4EB9000308D4    	  1527:     jsr     Negate
02:0003E13C 023C00EE        	  1528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E140 122C00EB        	  1529:     move.b  ($00EB,A4),D1
02:0003E144 D101            	  1530:     addx.b  D1,D0   ; ADC RoomId
02:0003E146 7600            	  1531:     moveq   #0,D3
02:0003E148 1600            	  1532:     move.b  D0,D3
02:0003E14A 6100441C        	  1533:     jsr     IsDarkRoom_Bank5
02:0003E14E 6602            	  1534:     bne.s  __far_z_05_0026
02:0003E150 601C            	  1535:     jmp  InitMode4_GoToSub0
                            	  1536: __far_z_05_0026:
                            	  1537:     ; The previous room was dark.
                            	  1538:     ;
02:0003E152 102C051F        	  1539:     move.b  ($051F,A4),D0
02:0003E156 6702            	  1540:     beq.s  __far_z_05_0027
02:0003E158 6014            	  1541:     jmp  InitMode4_GoToSub0
                            	  1542: __far_z_05_0027:
02:0003E15A 103C00C0        	  1543:     move.b  #$C0,D0
                            	  1544: ; Params:
                            	  1545: ; A: start index of cycle
                            	  1546: ;
                            	  1547:     even
                            	  1548: SetFadeCycleAndAdvanceSubmode:
02:0003E15E 4EF90002C034    	  1549:     jmp     c_set_fade_cycle_advance_submode
                            	  1550: 
                            	  1551: _anon_z05_41:
02:0003E164 4E75            	  1552:     rts
                            	  1553: 
                            	  1554:     even
                            	  1555: InitMode4_Sub3:
                            	  1556:     ; Submode 3.
                            	  1557:     ;
02:0003E166 4EB900030A22    	  1558:     jsr     AnimateWorldFading
02:0003E16C 66F6            	  1559:     bne  _anon_z05_41
                            	  1560:     even
                            	  1561: InitMode4_GoToSub0:
02:0003E16E 4EF90002B9E8    	  1562:     jmp     c_init_mode4_go_to_sub0
                            	  1563: 
                            	  1564: InitMode_EnterRoom:
02:0003E174 4EB9000482FA    	  1565:     jsr     DrawSpritesBetweenRooms
02:0003E17A 4EB900048318    	  1566:     jsr     ResetPlayerState
                            	  1567:     ; Reset [0300] to [051F].
                            	  1568:     ;
02:0003E180 7005            	  1569:     moveq   #5,D0
02:0003E182 761F            	  1570:     moveq   #31,D3
02:0003E184 4EB900047B78    	  1571:     jsr     ClearRam0300UpTo
                            	  1572:     ; Reset door trigger info.
                            	  1573:     ;
02:0003E18A 7000            	  1574:     moveq   #0,D0
02:0003E18C 19400054        	  1575:     move.b  D0,($0054,A4)
02:0003E190 19400055        	  1576:     move.b  D0,($0055,A4)
                            	  1577:     ; Store level block attribute byte F for convenience.
                            	  1578:     ;
02:0003E194 7600            	  1579:     moveq   #0,D3
02:0003E196 162C00EB        	  1580:     move.b  ($00EB,A4),D3
02:0003E19A 41F900FF6AFE    	  1581:     lea     (NES_SRAM+$0AFE).l,A0
02:0003E1A0 10303000        	  1582:     move.b  (A0,D3.W),D0
02:0003E1A4 194004CD        	  1583:     move.b  D0,($04CD,A4)
02:0003E1A8 610039AE        	  1584:     jsr     ResetInvObjState
                            	  1585:     ; There's more than one way to enter a room.
                            	  1586:     ;
                            	  1587:     ; 1: Out of a cave, dungeon, or cellar
                            	  1588:     ;     a. Walking exit
                            	  1589:     ;     b. Next to stairs
                            	  1590:     ; 2: Room to room
                            	  1591:     ;
                            	  1592:     ; Determine which one we need.
                            	  1593:     ;
02:0003E1AC 102C005A        	  1594:     move.b  ($005A,A4),D0
02:0003E1B0 6770            	  1595:     beq  _L_z05_InitMode_EnterRoom_Method2
02:0003E1B2 102C0010        	  1596:     move.b  ($0010,A4),D0
02:0003E1B6 665C            	  1597:     bne  _anon_z05_42
                            	  1598:     ; Enter method 1.
                            	  1599:     ;
                            	  1600:     ; Set up Link's exit from underground.
                            	  1601:     ;
