                            	  1038: _L_z04_UpdateFireball_CheckCollisionAndDraw:
                            	  1039:     ; Check for collision with Link. If hit, then go destroy the fireball.
                            	  1040:     ;
02:0003885E 6100FED8        	  1041:     jsr     CheckShotLinkCollision
02:00038862 102C034B        	  1042:     move.b  ($034B,A4),D0
02:00038866 66A0            	  1043:     bne  _L_z04_UpdateFireball_DestroyMonster
