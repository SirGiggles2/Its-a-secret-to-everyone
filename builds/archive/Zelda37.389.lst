02:0003F20C B001            	  3879:     cmp.b   D1,D0
02:0003F20E 6510            	  3880:     bcs  _anon_z05_95
02:0003F210 41F90003F1D2    	  3881:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003F216 12303000        	  3882:     move.b  (A0,D3.W),D1
02:0003F21A B001            	  3883:     cmp.b   D1,D0
02:0003F21C 65000082        	  3884:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3885: _anon_z05_95:
