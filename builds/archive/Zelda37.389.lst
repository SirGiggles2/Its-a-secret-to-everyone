02:000423C0 0A3C0010        	  8619:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000423C4 9101            	  8620:     subx.b  D1,D0   ; SBC #$1A
02:000423C6 0A3C0010        	  8621:     eori    #$10,CCR  ; restore X = 6502 C
