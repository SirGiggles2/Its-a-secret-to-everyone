                            	  2574: _L_z02_ModeEandF_WriteCharBoardCursorSpritePosition_WriteCursorCoords:
02:000339CA 102C0085        	  2575:     move.b  ($0085,A4),D0
02:000339CE 610E            	  2576:     jsr     ModifyFlashingCursorY
02:000339D0 19430208        	  2577:     move.b  D3,($0208,A4)
02:000339D4 102C0071        	  2578:     move.b  ($0071,A4),D0
02:000339D8 1940020B        	  2579:     move.b  D0,($020B,A4)
02:000339DC 4E75            	  2580:     rts
                            	  2581: 
                            	  2582: ; Params:
                            	  2583: ; A: cursor Y
                            	  2584: ;
                            	  2585: ; Returns:
                            	  2586: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2587: ;
                            	  2588: ; Description:
                            	  2589: ; Adjust the Y coordinate to account for the visible part of
                            	  2590: ; block cursor being in the bottom half of sprite.
                            	  2591: ; Also, make the cursor flash.
                            	  2592: ;
                            	  2593:     even
                            	  2594: ModifyFlashingCursorY:
02:000339DE 003C0011        	  2595:     ori     #$11,CCR  ; SEC: set C+X
02:000339E2 123C0008        	  2596:     move.b  #$08,D1
02:000339E6 0A3C0010        	  2597:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000339EA 9101            	  2598:     subx.b  D1,D0   ; SBC #$08
02:000339EC 0A3C0010        	  2599:     eori    #$10,CCR  ; restore X = 6502 C
02:000339F0 7600            	  2600:     moveq   #0,D3
