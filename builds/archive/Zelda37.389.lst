02:0003C430 D101            	  9249:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003C432 19802070        	  9250:     move.b  D0,($70,A4,D2.W)
02:0003C436 41EC0084        	  9251:     lea     ($0084,A4),A0
02:0003C43A 10302000        	  9252:     move.b  (A0,D2.W),D0
02:0003C43E 023C00EE        	  9253:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C442 122C0479        	  9254:     move.b  ($0479,A4),D1
02:0003C446 D101            	  9255:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
