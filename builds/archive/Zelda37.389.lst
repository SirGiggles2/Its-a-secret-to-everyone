02:00030D60 6100022C        	  2197:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  2198: _anon_z01_76:
                            	  2199:     ; If it's Link, write the sprites. He's never mirrored.
                            	  2200:     ;
02:00030D64 4A02            	  2201:     cmpi.b  #$00,D2
02:00030D66 6602            	  2202:     bne.s  __far_z_01_0002
02:00030D68 6014            	  2203:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  2204: __far_z_01_0002:
                            	  2205:     ; For other objects, the caller controls mirroring and flipping.
                            	  2206:     ;
                            	  2207:     ; If mirrored [0C], then draw it mirrored.
                            	  2208:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  2209:     ;
02:00030D6A 7600            	  2210:     moveq   #0,D3
