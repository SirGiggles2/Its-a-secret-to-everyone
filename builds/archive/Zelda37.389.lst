                            	  2050:     ; Going down. We have to consider the target Y.
                            	  2051:     ;
                            	  2052:     ; If the absolute vertical distance to the target position >= 3,
                            	  2053:     ; then go animate, draw, and check collisions.
                            	  2054:     ;
02:00038EEC 41EC0084        	  2055:     lea     ($0084,A4),A0
02:00038EF0 10302000        	  2056:     move.b  (A0,D2.W),D0
02:00038EF4 003C0011        	  2057:     ori     #$11,CCR  ; SEC: set C+X
02:00038EF8 41EC0444        	  2058:     lea     ($0444,A4),A0
02:00038EFC 12302000        	  2059:     move.b  (A0,D2.W),D1
02:00038F00 0A3C0010        	  2060:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038F04 9101            	  2061:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:00038F06 0A3C0010        	  2062:     eori    #$10,CCR  ; restore X = 6502 C
02:00038F0A 4EB9000308D0    	  2063:     jsr     Abs
