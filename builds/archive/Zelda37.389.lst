02:0004A4F6 41F900049FE6    	  7477:     lea     (ObjectTypeToAttributes).l,A0
02:0004A4FC 10303000        	  7478:     move.b  (A0,D3.W),D0
02:0004A500 41EC04BF        	  7479:     lea     ($04BF,A4),A0
02:0004A504 11802000        	  7480:     move.b  D0,(A0,D2.W)
02:0004A508 1003            	  7481:     move.b  D3,D0
02:0004A50A 1880            	  7482:     move.b  D0,($0000,A4)
                            	  7483:     ; Hit points are packed two values to a byte.
