02:0003924E 0C0000C0        	  2491:     cmpi.b  #$C0,D0
02:00039252 6506            	  2492:     bcs  _anon_z04_43
02:00039254 4EB900048E64    	  2493:     jsr     ReverseObjDir
                            	  2494: _anon_z04_43:
                            	  2495:     ; If facing horizontally, go place the leever to the left or right of Link.
