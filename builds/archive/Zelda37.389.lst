02:0003B348 D101            	  7039:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B34A 020000F0        	  7040:     andi.b #$F0,D0
02:0003B34E 19802070        	  7041:     move.b  D0,($70,A4,D2.W)
                            	  7042:     ; If in the top half of a square, jump to the top edge.
                            	  7043:     ; Else jump to the next square.
