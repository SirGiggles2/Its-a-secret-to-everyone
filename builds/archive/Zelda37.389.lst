02:0002BFB2 0A3C0001        	  2497:     eori    #$01,CCR
02:0002BFB6 4E75            	  2498:     rts
                            	  2499: .cc_cnras:
02:0002BFB8 023C00FE        	  2500:     andi    #$FE,CCR
