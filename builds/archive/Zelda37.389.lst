02:000398F4 003C0011        	  3490:     ori     #$11,CCR  ; SEC: set C+X
02:000398F8 41EC0084        	  3491:     lea     ($0084,A4),A0
02:000398FC 12302000        	  3492:     move.b  (A0,D2.W),D1
02:00039900 0A3C0010        	  3493:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039904 9101            	  3494:     subx.b  D1,D0   ; SBC ObjY,X
