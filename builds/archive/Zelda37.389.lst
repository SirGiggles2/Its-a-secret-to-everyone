                            	   294: UpdateMenuScrollUp:
                            	   295:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   296:     ;
02:0003D3CC 103C00FD        	   297:     move.b  #$FD,D0
02:0003D3D0 613A            	   298:     jsr     MovePositionMarkers
02:0003D3D2 102C00FC        	   299:     move.b  ($00FC,A4),D0
02:0003D3D6 023C00EE        	   300:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D3DA 123C0003        	   301:     move.b  #$03,D1
02:0003D3DE D101            	   302:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003D3E0 194000FC        	   303:     move.b  D0,($00FC,A4)
                            	   304:     ; If hardware vertical scroll still < $F0, then return.
                            	   305:     ;
02:0003D3E4 0C0000F0        	   306:     cmpi.b  #$F0,D0
02:0003D3E8 6406            	   307:     bcc.s  __far_z_05_0001
02:0003D3EA 4EF90002E34A    	   308:     jmp  Exit
                            	   309: __far_z_05_0001:
                            	   310:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   311:     ;
02:0003D3F0 1940005C        	   312:     move.b  D0,($005C,A4)
                            	   313:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   314:     ;
                            	   315:     ; UNKNOWN: But why not do this in OW, too?
                            	   316:     ;
02:0003D3F4 102C0010        	   317:     move.b  ($0010,A4),D0
02:0003D3F8 6706            	   318:     beq  _anon_z05_4
02:0003D3FA 4EB900030A2E    	   319:     jsr     WriteBlankPrioritySprites
                            	   320: _anon_z05_4:
                            	   321:     ; We reached the end. So, reset hardware vertical scroll
                            	   322:     ; and submenu state.
                            	   323:     ;
02:0003D400 7000            	   324:     moveq   #0,D0
02:0003D402 194000FC        	   325:     move.b  D0,($00FC,A4)
02:0003D406 194000E1        	   326:     move.b  D0,($00E1,A4)
                            	   327:     ; Move the position markers 2 pixels down, because we
                            	   328:     ; overshot and reached vertical scroll $F2.
                            	   329:     ;
02:0003D40A 7002            	   330:     moveq   #2,D0
                            	   331: ; Params:
                            	   332: ; A: vertical velocity of menu scrolling
                            	   333: ;
                            	   334: ;
                            	   335: ; [00] holds the vertical velocity of menu scrolling.
                            	   336:     even
                            	   337: MovePositionMarkers:
02:0003D40C 1880            	   338:     move.b  D0,($0000,A4)
                            	   339:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   340:     ;
02:0003D40E 102C0254        	   341:     move.b  ($0254,A4),D0
02:0003D412 0C0000F8        	   342:     cmpi.b  #$F8,D0
02:0003D416 670C            	   343:     beq  _anon_z05_5
02:0003D418 023C00EE        	   344:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D41C 1214            	   345:     move.b  ($0000,A4),D1
02:0003D41E D101            	   346:     addx.b  D1,D0   ; ADC $00
02:0003D420 19400254        	   347:     move.b  D0,($0254,A4)
