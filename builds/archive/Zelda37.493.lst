                            	  5248: UpdatePolsVoice:
02:0003A5A4 0C020001        	  5249:     cmpi.b  #$01,D2
                            	  5250:     bne  _anon_z04_96
                            	  5251: _anon_z04_96:
                            	  5252:     ; If we have the magic clock, or is stunned, then
                            	  5253:     ; go draw and check collisions.
                            	  5254:     ;
02:0003A5A8 102C066C        	  5255:     move.b  ($066C,A4),D0
02:0003A5AC 1234203D        	  5256:     move.b  ($3D,A4,D2.W),D1
02:0003A5B0 8001            	  5257:     or.b  D1,D0
02:0003A5B2 660000AE        	  5258:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5259:     ; Every odd screen frame, go straight to drawing
                            	  5260:     ; and checking collisions.
                            	  5261:     ;
02:0003A5B6 102C0015        	  5262:     move.b  ($0015,A4),D0
02:0003A5BA E208            	  5263:     lsr.b  #1,D0   ; LSR A
02:0003A5BC 6404            	  5264:     bcc.s  __far_z_04_0047
02:0003A5BE 60000118        	  5265:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5266: __far_z_04_0047:
                            	  5267:     ; Otherwise move horizontally.
                            	  5268:     ;
02:0003A5C2 61000248        	  5269:     jsr     PolsVoice_MoveX
                            	  5270:     ; If state <> 0, then the monster is jumping.
                            	  5271:     ; Go handle vertical movement.
                            	  5272:     ;
02:0003A5C6 41EC00AC        	  5273:     lea     ($00AC,A4),A0
02:0003A5CA 10302000        	  5274:     move.b  (A0,D2.W),D0
02:0003A5CE 6706            	  5275:     beq  _L_z04_UpdatePolsVoice_State0
02:0003A5D0 61000130        	  5276:     jsr     UpdatePolsVoiceState1_Jumping
02:0003A5D4 6034            	  5277:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  5278: 
                            	  5279:     even
                            	  5280: _L_z04_UpdatePolsVoice_State0:
                            	  5281:     ; State 0. Walking.
                            	  5282:     ;
                            	  5283:     ; If grid offset = 0, then no more distance to cover.
                            	  5284:     ; So, go change to state 1 -- jumping.
                            	  5285:     ;
02:0003A5D6 41EC0394        	  5286:     lea     ($0394,A4),A0
02:0003A5DA 10302000        	  5287:     move.b  (A0,D2.W),D0
02:0003A5DE 67000084        	  5288:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5289:     ; Decrement grid offset / distance remaining.
                            	  5290:     ;
02:0003A5E2 41EC0394        	  5291:     lea     ($0394,A4),A0
02:0003A5E6 53302000        	  5292:     subq.b  #1,(A0,D2.W)
                            	  5293:     ; Move vertically.
                            	  5294:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5295:     ;
02:0003A5EA 41EC0084        	  5296:     lea     ($0084,A4),A0
02:0003A5EE 10302000        	  5297:     move.b  (A0,D2.W),D0
02:0003A5F2 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5F6 41F90003A586    	  5299:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003A5FC 12303000        	  5300:     move.b  (A0,D3.W),D1
02:0003A600 D101            	  5301:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003A602 41EC0084        	  5302:     lea     ($0084,A4),A0
02:0003A606 11802000        	  5303:     move.b  D0,(A0,D2.W)
                            	  5304:     even
                            	  5305: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5306:     ; If the square the monster is over is walkable, then
                            	  5307:     ; go draw and check object collisions.
                            	  5308:     ;
02:0003A60A 610001F4        	  5309:     jsr     PolsVoice_IsSquareWalkable
02:0003A60E 6452            	  5310:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5311:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5312:     ; then go change to state 1.
                            	  5313:     ;
02:0003A610 41EC041F        	  5314:     lea     ($041F,A4),A0
02:0003A614 10302000        	  5315:     move.b  (A0,D2.W),D0
02:0003A618 020000FC        	  5316:     andi.b #$FC,D0
02:0003A61C 0C0000B0        	  5317:     cmpi.b  #$B0,D0
02:0003A620 6742            	  5318:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003A622 0C0000F4        	  5319:     cmpi.b  #$F4,D0
02:0003A626 643C            	  5320:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5321:     ; Else blocked by something else.
                            	  5322:     ;
                            	  5323:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5324:     ;
02:0003A628 41EC0098        	  5325:     lea     ($0098,A4),A0
02:0003A62C 10302000        	  5326:     move.b  (A0,D2.W),D0
02:0003A630 02000003        	  5327:     andi.b #$03,D0
02:0003A634 6618            	  5328:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5329:     ; Else facing vertically. Flip the direction.
                            	  5330:     ; Go draw.
                            	  5331:     ;
02:0003A636 41EC0098        	  5332:     lea     ($0098,A4),A0
02:0003A63A 10302000        	  5333:     move.b  (A0,D2.W),D0
02:0003A63E 0A00000C        	  5334:     eori.b #$0C,D0
02:0003A642 41EC0098        	  5335:     lea     ($0098,A4),A0
02:0003A646 11802000        	  5336:     move.b  D0,(A0,D2.W)
02:0003A64A 6000008C        	  5337:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5338: 
                            	  5339:     even
                            	  5340: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  5341:     ; Facing horizontally. Flip the direction.
                            	  5342:     ; Move two pixels, and go draw.
                            	  5343:     ;
02:0003A64E 0A000003        	  5344:     eori.b #$03,D0
02:0003A652 41EC0098        	  5345:     lea     ($0098,A4),A0
02:0003A656 11802000        	  5346:     move.b  D0,(A0,D2.W)
02:0003A65A 610001B0        	  5347:     jsr     PolsVoice_MoveX
02:0003A65E 610001AC        	  5348:     jsr     PolsVoice_MoveX
                            	  5349:     even
                            	  5350: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003A662 6074            	  5351:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5352: 
                            	  5353:     even
                            	  5354: _L_z04_UpdatePolsVoice_SetState1:
                            	  5355:     ; If already in state 1, then go draw and check collisions.
                            	  5356:     ;
02:0003A664 41EC00AC        	  5357:     lea     ($00AC,A4),A0
02:0003A668 10302000        	  5358:     move.b  (A0,D2.W),D0
02:0003A66C 6702            	  5359:     beq.s  __far_z_04_0048
02:0003A66E 6068            	  5360:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5361: __far_z_04_0048:
                            	  5362:     ; Go to state 1.
                            	  5363:     ;
02:0003A670 41EC00AC        	  5364:     lea     ($00AC,A4),A0
02:0003A674 52302000        	  5365:     addq.b  #1,(A0,D2.W)
                            	  5366:     ; Subtract 1 from facing direction to make an index.
                            	  5367:     ;
02:0003A678 7600            	  5368:     moveq   #0,D3
02:0003A67A 41EC0098        	  5369:     lea     ($0098,A4),A0
02:0003A67E 16302000        	  5370:     move.b  (A0,D2.W),D3
02:0003A682 5303            	  5371:     subq.b  #1,D3
                            	  5372:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5373:     ;
02:0003A684 41EC0084        	  5374:     lea     ($0084,A4),A0
02:0003A688 10302000        	  5375:     move.b  (A0,D2.W),D0
02:0003A68C 0C000078        	  5376:     cmpi.b  #$78,D0
02:0003A690 6402            	  5377:     bcc  _anon_z04_97
02:0003A692 7603            	  5378:     moveq   #3,D3
                            	  5379: _anon_z04_97:
                            	  5380:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5381:     ;
02:0003A694 0C0000A8        	  5382:     cmpi.b  #$A8,D0
02:0003A698 6502            	  5383:     bcs  _anon_z04_98
02:0003A69A 7607            	  5384:     moveq   #7,D3
                            	  5385: _anon_z04_98:
                            	  5386:     ; Set the vertical speed for the beginning of the jump.
                            	  5387:     ;
02:0003A69C 41F90003A590    	  5388:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003A6A2 10303000        	  5389:     move.b  (A0,D3.W),D0
02:0003A6A6 41EC0412        	  5390:     lea     ($0412,A4),A0
02:0003A6AA 11802000        	  5391:     move.b  D0,(A0,D2.W)
                            	  5392:     ; Look up the Y offset for the current direction.
                            	  5393:     ; Add it to object Y to set the destination Y of the jump.
                            	  5394:     ;
02:0003A6AE 41EC0084        	  5395:     lea     ($0084,A4),A0
02:0003A6B2 10302000        	  5396:     move.b  (A0,D2.W),D0
02:0003A6B6 023C00EE        	  5397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A6BA 41F90003A598    	  5398:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003A6C0 12303000        	  5399:     move.b  (A0,D3.W),D1
02:0003A6C4 D101            	  5400:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003A6C6 41EC042C        	  5401:     lea     ($042C,A4),A0
02:0003A6CA 11802000        	  5402:     move.b  D0,(A0,D2.W)
                            	  5403:     ; Turn the index into a direction again by adding 1.
                            	  5404:     ; Store the facing direction.
                            	  5405:     ;
02:0003A6CE 5203            	  5406:     addq.b  #1,D3
02:0003A6D0 41EC0098        	  5407:     lea     ($0098,A4),A0
02:0003A6D4 11832000        	  5408:     move.b  D3,(A0,D2.W)
                            	  5409:     even
                            	  5410: L_PolsVoice_DrawAndCheckCollisions:
02:0003A6D8 7008            	  5411:     moveq   #8,D0
02:0003A6DA 4EB90004909A    	  5412:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003A6E0 41EC03E4        	  5413:     lea     ($03E4,A4),A0
02:0003A6E4 10302000        	  5414:     move.b  (A0,D2.W),D0
02:0003A6E8 4EB900030E28    	  5415:     jsr     DrawObjectMirrored
                            	  5416:     ; Pols Voice is invincible to everything but the sword,
                            	  5417:     ; during normal collision detection.
                            	  5418:     ;
                            	  5419:     ; The arrow is a special case.
                            	  5420:     ;
02:0003A6EE 103C00FE        	  5421:     move.b  #$FE,D0
02:0003A6F2 41EC04B2        	  5422:     lea     ($04B2,A4),A0
02:0003A6F6 11802000        	  5423:     move.b  D0,(A0,D2.W)
02:0003A6FA 4EB900031198    	  5424:     jsr     CheckMonsterCollisions
02:0003A700 4E75            	  5425:     rts
                            	  5426: 
                            	  5427:     even
                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A702 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0003A706 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0003A70A 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A70E 123C0038        	  5434:     move.b  #$38,D1
02:0003A712 D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A714 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0003A718 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0003A71C 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003A720 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0003A724 123C0000        	  5442:     move.b  #$00,D1
02:0003A728 D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A72A 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0003A72E 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0003A732 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A736 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0003A73A 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0003A73E D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0003A740 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0003A744 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
02:0003A748 41EC0412        	  5456:     lea     ($0412,A4),A0
02:0003A74C 10302000        	  5457:     move.b  (A0,D2.W),D0
02:0003A750 6B0000AC        	  5458:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5459:     ; If Y coordinate still < target Y, then return.
                            	  5460:     ;
02:0003A754 41EC0084        	  5461:     lea     ($0084,A4),A0
02:0003A758 10302000        	  5462:     move.b  (A0,D2.W),D0
02:0003A75C 41EC042C        	  5463:     lea     ($042C,A4),A0
