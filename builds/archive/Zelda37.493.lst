                            	   689: 
                            	   690: ;==============================================================================
                            	   691: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   692: ;
                            	   693: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   694: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   695: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   696: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   697: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   698: ;
                            	   699: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   700: ;
                            	   701: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   702: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   703: ;==============================================================================
                            	   704:     ifne DEBUG_TELEPORT
                            	   705: _debug_teleport_check:
                            	   706:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   707:     tst.b   ($0010,A4)
                            	   708:     bne     .dtc_no
                            	   709:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   710:     cmpi.b  #$05,($0012,A4)
                            	   711:     bne     .dtc_no
                            	   712:     tst.b   ($0013,A4)
                            	   713:     bne     .dtc_no
                            	   714:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   715:     ;
                            	   716:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   717:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   718:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   719:     ; So the bit map is:
                            	   720:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   721:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   722:     move.b  ($00F8,A4),D1
                            	   723:     andi.b  #$0F,D1
                            	   724:     beq     .dtc_no
                            	   725:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   726:     moveq   #0,D0
                            	   727:     btst    #3,D1                   ; Up
                            	   728:     bne.s   .dtc_dir_set
                            	   729:     moveq   #1,D0
                            	   730:     btst    #2,D1                   ; Down
                            	   731:     bne.s   .dtc_dir_set
                            	   732:     moveq   #2,D0
                            	   733:     btst    #1,D1                   ; Left
                            	   734:     bne.s   .dtc_dir_set
                            	   735:     moveq   #3,D0                   ; Right (bit 0)
                            	   736: .dtc_dir_set:
                            	   737:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   738:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   739:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   740:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   741:     move.b  ($00EB,A4),D2
                            	   742:     move.b  D2,D3
                            	   743:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   744:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   745:     tst.b   D0
                            	   746:     bne.s   .dtc_not_up
                            	   747:     tst.b   D2
                            	   748:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   749:     bra.s   .dtc_apply
                            	   750: .dtc_not_up:
                            	   751:     cmpi.b  #1,D0
                            	   752:     bne.s   .dtc_not_down
                            	   753:     cmpi.b  #7,D2
                            	   754:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   755:     bra.s   .dtc_apply
                            	   756: .dtc_not_down:
                            	   757:     cmpi.b  #2,D0
                            	   758:     bne.s   .dtc_not_left
                            	   759:     tst.b   D3
                            	   760:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   761:     bra.s   .dtc_apply
                            	   762: .dtc_not_left:
                            	   763:     cmpi.b  #$0F,D3
                            	   764:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   765: .dtc_apply:
                            	   766:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   767:     lea     (NextRoomIdOffsets).l,A0
                            	   768:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   769:     move.b  ($00EB,A4),D0
                            	   770:     add.b   D1,D0
                            	   771:     move.b  D0,($00EB,A4)
                            	   772:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   773:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   774:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   775:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   776:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   777:     ; movement update doesn't immediately retrigger the edge.
                            	   778:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   779:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   780:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   781:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   782:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   783:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   784:     ; skip that setup.
                            	   785:     jsr     LayOutRoom
                            	   786:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   787:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   788:     ; kick that from here with arbitrary state causes crashes when the
                            	   789:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   790:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   791:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   792:     ; per target room.
                            	   793:     clr.b   ($00F8,A4)
                            	   794:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   795:                                          ; doesn't walk during sweep settle
                            	   796:     moveq   #1,D0
                            	   797:     rts
                            	   798: .dtc_edge:
                            	   799:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   800:     ; interpret it as "walk into wall" animation.
                            	   801:     clr.b   ($00F8,A4)
                            	   802:     clr.b   ($00FA,A4)
                            	   803:     moveq   #1,D0
                            	   804:     rts
                            	   805: .dtc_no:
                            	   806:     moveq   #0,D0
                            	   807:     rts
                            	   808:     endc
                            	   809: 
                            	   810: ;==============================================================================
                            	   811: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   812: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   813: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   814: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   815: ;==============================================================================
                            	   816:     ifne TURBO_LINK
                            	   817: _turbo_link_boost:
                            	   818:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   819:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   820:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   821:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:00049A32 4E75            	   822:     rts
                            	   823: _turbo_link_boost_disabled:
                            	   824:     ; OW gate
02:00049A34 4A2C0010        	   825:     tst.b   ($0010,A4)
02:00049A38 6670            	   826:     bne     .tlb_exit
                            	   827:     ; Mode 5 / Submode 0 only
02:00049A3A 0C2C00050012    	   828:     cmpi.b  #$05,($0012,A4)
02:00049A40 6668            	   829:     bne     .tlb_exit
02:00049A42 4A2C0013        	   830:     tst.b   ($0013,A4)
02:00049A46 6662            	   831:     bne     .tlb_exit
                            	   832:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:00049A48 122C00FA        	   833:     move.b  ($00FA,A4),D1
02:00049A4C 0201000F        	   834:     andi.b  #$0F,D1
02:00049A50 6758            	   835:     beq     .tlb_exit
                            	   836:     ; Edge-safe clamps.
02:00049A52 08010003        	   837:     btst    #3,D1                   ; Up (bit 3)
02:00049A56 6710            	   838:     beq     .tlb_no_up
02:00049A58 102C0084        	   839:     move.b  ($0084,A4),D0
02:00049A5C 0C000040        	   840:     cmpi.b  #$40,D0
02:00049A60 6306            	   841:     bls     .tlb_no_up
02:00049A62 5900            	   842:     subi.b  #4,D0
02:00049A64 19400084        	   843:     move.b  D0,($0084,A4)
                            	   844: .tlb_no_up:
02:00049A68 08010002        	   845:     btst    #2,D1                   ; Down (bit 2)
02:00049A6C 6710            	   846:     beq     .tlb_no_down
02:00049A6E 102C0084        	   847:     move.b  ($0084,A4),D0
02:00049A72 0C0000D0        	   848:     cmpi.b  #$D0,D0
02:00049A76 6406            	   849:     bcc     .tlb_no_down
02:00049A78 5800            	   850:     addi.b  #4,D0
02:00049A7A 19400084        	   851:     move.b  D0,($0084,A4)
                            	   852: .tlb_no_down:
02:00049A7E 08010001        	   853:     btst    #1,D1                   ; Left (bit 1)
02:00049A82 6710            	   854:     beq     .tlb_no_left
02:00049A84 102C0070        	   855:     move.b  ($0070,A4),D0
02:00049A88 0C00000A        	   856:     cmpi.b  #$0A,D0
02:00049A8C 6306            	   857:     bls     .tlb_no_left
02:00049A8E 5900            	   858:     subi.b  #4,D0
02:00049A90 19400070        	   859:     move.b  D0,($0070,A4)
                            	   860: .tlb_no_left:
02:00049A94 08010000        	   861:     btst    #0,D1                   ; Right (bit 0)
02:00049A98 6710            	   862:     beq     .tlb_no_right
02:00049A9A 102C0070        	   863:     move.b  ($0070,A4),D0
02:00049A9E 0C0000E6        	   864:     cmpi.b  #$E6,D0
02:00049AA2 6406            	   865:     bcc     .tlb_no_right
02:00049AA4 5800            	   866:     addi.b  #4,D0
02:00049AA6 19400070        	   867:     move.b  D0,($0070,A4)
                            	   868: .tlb_no_right:
                            	   869: .tlb_exit:
02:00049AAA 4E75            	   870:     rts
                            	   871:     endc
