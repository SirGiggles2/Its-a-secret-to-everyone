02:000384C0 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:000384C4 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:000384C8 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:000384CC 7074            	   629:     moveq   #116,D0
02:000384CE 4EB900047218    	   630:     jsr     ChangeTileObjTiles
