02:0003DF9E 102C0001        	  2815:     move.b  ($0001,A4),D0
02:0003DFA2 661A            	  2816:     bne  _L_z05_MaskInputInBorder_Exit
                            	  2817:     ; Mask off input directions perpendicular to player's facing.
                            	  2818:     ;
02:0003DFA4 760C            	  2819:     moveq   #12,D3
02:0003DFA6 102C0098        	  2820:     move.b  ($0098,A4),D0
02:0003DFAA 0200000C        	  2821:     andi.b #$0C,D0
02:0003DFAE 6602            	  2822:     bne  _anon_z05_77
02:0003DFB0 7603            	  2823:     moveq   #3,D3
                            	  2824: _anon_z05_77:
02:0003DFB2 1003            	  2825:     move.b  D3,D0
02:0003DFB4 122C03F8        	  2826:     move.b  ($03F8,A4),D1
02:0003DFB8 C001            	  2827:     and.b  D1,D0
02:0003DFBA 194003F8        	  2828:     move.b  D0,($03F8,A4)
