02:00038F9C 7070            	  2178:     moveq   #112,D0
02:00038F9E 1880            	  2179:     move.b  D0,($0000,A4)
                            	  2180:     ; Look for the current room ID in an array of room ID's that
                            	  2181:     ; have armos secrets.
                            	  2182:     ;
02:00038FA0 7606            	  2183:     moveq   #6,D3
                            	  2184:     even
                            	  2185: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:00038FA2 102C00EB        	  2186:     move.b  ($00EB,A4),D0
                            	  2187:     ; If this element does not match the current room ID, go loop again.
                            	  2188:     ;
02:00038FA6 41F900038F6C    	  2189:     lea     (SecretArmosRoomIds).l,A0
02:00038FAC 12303000        	  2190:     move.b  (A0,D3.W),D1
02:00038FB0 B001            	  2191:     cmp.b   D1,D0
02:00038FB2 6648            	  2192:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2193:     ; The secret (usually stairs) is under one of the armoses.
                            	  2194:     ;
                            	  2195:     ; If the armos's X coordinate does not match the one needed
                            	  2196:     ; for the current room in the list, then go loop again.
                            	  2197:     ;
02:00038FB4 10342070        	  2198:     move.b  ($70,A4,D2.W),D0
02:00038FB8 41F900038F74    	  2199:     lea     (SecretArmosXs).l,A0
02:00038FBE 12303000        	  2200:     move.b  (A0,D3.W),D1
02:00038FC2 B001            	  2201:     cmp.b   D1,D0
02:00038FC4 6636            	  2202:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2203:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2204:     ;
02:00038FC6 41EC0084        	  2205:     lea     ($0084,A4),A0
02:00038FCA 10302000        	  2206:     move.b  (A0,D2.W),D0
02:00038FCE 0C000080        	  2207:     cmpi.b  #$80,D0
02:00038FD2 6628            	  2208:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2209:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2210:     ;
02:00038FD4 4A03            	  2211:     cmpi.b  #$00,D3
02:00038FD6 662C            	  2212:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2213:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2214:     ; has the power bracelet.
                            	  2215:     ;
                            	  2216:     ; Set up the room item with the armos's coordinates.
                            	  2217:     ;
02:00038FD8 19400097        	  2218:     move.b  D0,($0097,A4)
02:00038FDC 10342070        	  2219:     move.b  ($70,A4,D2.W),D0
02:00038FE0 19400083        	  2220:     move.b  D0,($0083,A4)
                            	  2221:     ; This resets the room item's state, which activates it.
                            	  2222:     ;
02:00038FE4 194300BF        	  2223:     move.b  D3,($00BF,A4)
                            	  2224:     ; Set the room item ID.
                            	  2225:     ;
02:00038FE8 7014            	  2226:     moveq   #20,D0
02:00038FEA 194000AB        	  2227:     move.b  D0,($00AB,A4)
                            	  2228:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2229:     ;
                            	  2230:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2231:     ;
                            	  2232:     ; Note that, if the item was already taken, then the room item
                            	  2233:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2234:     ; it will be ignored, because that routine checks whether
                            	  2235:     ; the item was taken.
                            	  2236:     ;
02:00038FEE 4EB900030B64    	  2237:     jsr     GetRoomFlagUWItemState
02:00038FF4 660A            	  2238:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00038FF6 6100069A        	  2239:     jsr     PlaySecretFoundTune
02:00038FFA 6604            	  2240:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2241:     even
                            	  2242: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  2243:     ; Bottom of the loop.
                            	  2244:     ;
02:00038FFC 5303            	  2245:     subq.b  #1,D3
02:00038FFE 6AA2            	  2246:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  2247:     even
                            	  2248: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  2249:     ; Not found, or found the power bracelet.
                            	  2250:     ; Use a floor tile $26 to replace the armos.
                            	  2251:     ;
02:00039000 7026            	  2252:     moveq   #38,D0
02:00039002 1880            	  2253:     move.b  D0,($0000,A4)
                            	  2254:     even
                            	  2255: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:00039004 1014            	  2256:     move.b  ($0000,A4),D0
                            	  2257:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  2258:     ;
02:00039006 1B00            	  2259:     move.b  D0,-(A5)  ; PHA
02:00039008 0C000070        	  2260:     cmpi.b  #$70,D0
02:0003900C 6604            	  2261:     bne  _anon_z04_51
02:0003900E 61000682        	  2262:     jsr     PlaySecretFoundTune
                            	  2263: _anon_z04_51:
                            	  2264:     ; Replace the tile where the armos was.
                            	  2265:     ;
02:00039012 522C00F7        	  2266:     addq.b  #1,($00F7,A4)
02:00039016 101D            	  2267:     move.b  (A5)+,D0  ; PLA
02:00039018 4EB900047218    	  2268:     jsr     ChangeTileObjTiles
                            	  2269:     ; Because the armos object is aligned to the square grid
                            	  2270:     ; (because it was made from a square),
                            	  2271:     ; set its grid offset to 3 to compensate.
                            	  2272:     ;
                            	  2273:     ; Most objects are aligned to the grid vertically when the
                            	  2274:     ; low nibble is $D.
                            	  2275:     ;
02:0003901E 7003            	  2276:     moveq   #3,D0
02:00039020 41EC0394        	  2277:     lea     ($0394,A4),A0
02:00039024 11802000        	  2278:     move.b  D0,(A0,D2.W)
                            	  2279:     ; Set a speed (q-speed fraction) randomly:
                            	  2280:     ; $20 if random value < $80
                            	  2281:     ; $60 otherwise
                            	  2282:     ;
02:00039028 7020            	  2283:     moveq   #32,D0
02:0003902A 7600            	  2284:     moveq   #0,D3
02:0003902C 16342019        	  2285:     move.b  ($19,A4,D2.W),D3
02:00039030 0C030080        	  2286:     cmpi.b  #$80,D3
02:00039034 6502            	  2287:     bcs  _anon_z04_52
02:00039036 7060            	  2288:     moveq   #96,D0
                            	  2289: _anon_z04_52:
02:00039038 41EC03BC        	  2290:     lea     ($03BC,A4),A0
02:0003903C 11802000        	  2291:     move.b  D0,(A0,D2.W)
                            	  2292:     even
                            	  2293: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  2294:     ; Facing and input directions down.
                            	  2295:     ;
02:00039040 7004            	  2296:     moveq   #4,D0
02:00039042 41EC03F8        	  2297:     lea     ($03F8,A4),A0
02:00039046 11802000        	  2298:     move.b  D0,(A0,D2.W)
02:0003904A 41EC0098        	  2299:     lea     ($0098,A4),A0
02:0003904E 11802000        	  2300:     move.b  D0,(A0,D2.W)
                            	  2301:     ; Every other frame, return without drawing.
                            	  2302:     ;
02:00039052 10342028        	  2303:     move.b  ($28,A4,D2.W),D0
02:00039056 E208            	  2304:     lsr.b  #1,D0   ; LSR A
02:00039058 6512            	  2305:     bcs  _anon_z04_53
                            	  2306:     ; Finish initializing based on type.
                            	  2307:     ;
02:0003905A 41EC034F        	  2308:     lea     ($034F,A4),A0
02:0003905E 10302000        	  2309:     move.b  (A0,D2.W),D0
02:00039062 0C000022        	  2310:     cmpi.b  #$22,D0
02:00039066 6602            	  2311:     bne.s  __far_z_04_0017
02:00039068 6008            	  2312:     jmp  L_EndInitFlyingGhini
                            	  2313: __far_z_04_0017:
02:0003906A 6158            	  2314:     jsr     DrawArmosAndCheckCollisions
                            	  2315: _anon_z04_53:
02:0003906C 0A3C0001        	  2316:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00039070 4E75            	  2317:     rts
                            	  2318: 
                            	  2319:     even
                            	  2320: L_EndInitFlyingGhini:
02:00039072 6100FEE8        	  2321:     jsr     DrawGhiniAndCheckCollisions
                            	  2322:     ; If we're finally leaving the object flagged "initialized",
                            	  2323:     ; then reset metastate and initialize this as a flyer.
                            	  2324:     ;
02:00039076 41EC0492        	  2325:     lea     ($0492,A4),A0
02:0003907A 10302000        	  2326:     move.b  (A0,D2.W),D0
02:0003907E 66EC            	  2327:     bne  _anon_z04_53
02:00039080 4EB90004989A    	  2328:     jsr     ResetObjMetastateAndTimer
02:00039086 6000F794        	  2329:     jmp     EndInitFlyer
