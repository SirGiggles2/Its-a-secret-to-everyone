                            	  4940: _L_z07_SpreadShot_NextCorner:
                            	  4941:     ; Prepare to process the next corner.
                            	  4942:     ;
                            	  4943:     ; First, restore X offset [02] and Y offset [03].
                            	  4944:     ;
02:0004846E 101D            	  4945:     move.b  (A5)+,D0  ; PLA
02:00048470 19400003        	  4946:     move.b  D0,($0003,A4)
02:00048474 101D            	  4947:     move.b  (A5)+,D0  ; PLA
02:00048476 19400002        	  4948:     move.b  D0,($0002,A4)
                            	  4949:     ; Take turns negating X offset or Y offset for the next round.
                            	  4950:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4951:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4952:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4953:     ; - Fourth turn: doesn't matter
                            	  4954:     ;
                            	  4955:     ;
                            	  4956:     ; Get the loop index.
02:0004847A 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:0004847C 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:0004847E 7600            	  4959:     moveq   #0,D3
02:00048480 1600            	  4960:     move.b  D0,D3
02:00048482 0C030001        	  4961:     cmpi.b  #$01,D3
02:00048486 6602            	  4962:     bne  _anon_z07_25
02:00048488 7603            	  4963:     moveq   #3,D3
                            	  4964: _anon_z07_25:
02:0004848A 10343000        	  4965:     move.b  ($00,A4,D3.W),D0
02:0004848E 4600            	  4966:     eori.b #$FF,D0
02:00048490 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048494 123C0001        	  4968:     move.b  #$01,D1
02:00048498 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004849A 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
02:0004849E 101D            	  4973:     move.b  (A5)+,D0  ; PLA
02:000484A0 7600            	  4974:     moveq   #0,D3
02:000484A2 1600            	  4975:     move.b  D0,D3
02:000484A4 5303            	  4976:     subq.b  #1,D3
