                            	  3968: _L_z07_MoveObject_ApplyQSpeedToPosition:
02:00047E44 102C000F        	  3969:     move.b  ($000F,A4),D0
02:00047E48 E208            	  3970:     lsr.b  #1,D0   ; LSR A
02:00047E4A 654C            	  3971:     bcs  _L_z07_MoveObject_Right
02:00047E4C E208            	  3972:     lsr.b  #1,D0   ; LSR A
02:00047E4E 655E            	  3973:     bcs  _L_z07_MoveObject_Left
02:00047E50 E208            	  3974:     lsr.b  #1,D0   ; LSR A
