                            	  2079:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2080:     ; which here represents an offset from the palette row.
                            	  2081:     ;
02:0004708A 023C00EE        	  2082:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004708E 122C0004        	  2083:     move.b  ($0004,A4),D1
02:00047092 D101            	  2084:     addx.b  D1,D0   ; ADC $04
02:00047094 4A02            	  2085:     cmpi.b  #$00,D2
02:00047096 66E4            	  2086:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00047098 0C000002        	  2087:     cmpi.b  #$02,D0
02:0004709C 66DE            	  2088:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004709E 7620            	  2089:     moveq   #32,D3
02:000470A0 60DA            	  2090:     jmp     _L_z07_DrawItemBySlot_WriteSprites
