                            	  3875: ; AddQSpeedToPositionFraction — D2=slot. Returns carry in CCR (C=1 if advanced).
                            	  3876: ; ASM MoveObject_Right/Down consume this via `addx.b`, which reads CCR.X (bit 4).
                            	  3877: ; 6502 convention: X mirrors C. Set/clear both bits 0 (C) and 4 (X).
                            	  3878: c_add_q_speed_to_position_fraction:
02:0002C94C 7000            	  3879:     moveq   #0,D0
02:0002C94E 3002            	  3880:     move.w  D2,D0
02:0002C950 2F00            	  3881:     move.l  D0,-(SP)
02:0002C952 4EB900000000    	  3882:     jsr     z01_add_q_speed_to_position_fraction
02:0002C958 588F            	  3883:     addq.l  #4,SP
02:0002C95A 08000008        	  3884:     btst    #8,D0
02:0002C95E 6706            	  3885:     beq.s   .cc_aqspf
02:0002C960 003C0011        	  3886:     ori     #$11,CCR
02:0002C964 4E75            	  3887:     rts
                            	  3888: .cc_aqspf:
02:0002C966 023C00EE        	  3889:     andi    #$EE,CCR
02:0002C96A 4E75            	  3890:     rts
                            	  3891: 
                            	  3892: ; SubQSpeedFromPositionFraction — D2=slot. Returns carry (C=0 if advanced).
                            	  3893: ; ASM MoveObject_Up/Left consume this via `subx.b` (reads CCR.X). Set X = C.
                            	  3894: c_sub_q_speed_from_position_fraction:
02:0002C96C 7000            	  3895:     moveq   #0,D0
02:0002C96E 3002            	  3896:     move.w  D2,D0
02:0002C970 2F00            	  3897:     move.l  D0,-(SP)
02:0002C972 4EB900000000    	  3898:     jsr     z01_sub_q_speed_from_position_fraction
02:0002C978 588F            	  3899:     addq.l  #4,SP
02:0002C97A 08000008        	  3900:     btst    #8,D0
02:0002C97E 6706            	  3901:     beq.s   .cc_sqspf
02:0002C980 003C0011        	  3902:     ori     #$11,CCR
02:0002C984 4E75            	  3903:     rts
                            	  3904: .cc_sqspf:
02:0002C986 023C00EE        	  3905:     andi    #$EE,CCR
02:0002C98A 4E75            	  3906:     rts
