                            	  9358: TurnTowardsPlayer8:
                            	  9359:     ; Build a direction in [00] towards the player.
                            	  9360:     ;
                            	  9361:     ; First, calculate a horizontal component:
                            	  9362:     ;
                            	  9363:     ; If   observed player X = object X, [00] := 0 (none)
                            	  9364:     ; elif observed player X > object X, [00] := 1 (right)
                            	  9365:     ; else                               [00] := 2 (left)
                            	  9366:     ;
02:0003C3BC 7600            	  9367:     moveq   #0,D3
02:0003C3BE 1883            	  9368:     move.b  D3,($0000,A4)
