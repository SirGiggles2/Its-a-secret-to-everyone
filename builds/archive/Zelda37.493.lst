                            	  2647:     ; State 0.
                            	  2648:     ;
                            	  2649:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  2650:     ; bracelet, then return.
                            	  2651:     ;
02:0003928A 41EC034F        	  2652:     lea     ($034F,A4),A0
02:0003928E 10302000        	  2653:     move.b  (A0,D2.W),D0
02:00039292 0C000065        	  2654:     cmpi.b  #$65,D0
02:00039296 6708            	  2655:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
