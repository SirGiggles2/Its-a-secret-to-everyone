02:00038300 11802000        	   372:     move.b  D0,(A0,D2.W)
                            	   373:     ; If turn timer <> 0, then go set input direction to facing direction.
                            	   374:     ;
02:00038304 41EC0478        	   375:     lea     ($0478,A4),A0
02:00038308 10302000        	   376:     move.b  (A0,D2.W),D0
02:0003830C 6612            	   377:     bne  _L_z04_Exit_SetInputDir
                            	   378:     ; Turn toward the chase target in a direction perpendicular to
                            	   379:     ; facing direction.
