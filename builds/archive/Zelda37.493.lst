02:00039254 4EB9000490A0    	  2616:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2617:     ; The variable for the currently updating object slot has to be
                            	  2618:     ; set to the heart's object slot for this drawing routine to work.
                            	  2619:     ;
02:0003925A 7400            	  2620:     moveq   #0,D2
02:0003925C 142C0340        	  2621:     move.b  ($0340,A4),D2
02:00039260 4EB900030E2C    	  2622:     jsr     DrawObjectNotMirrored
