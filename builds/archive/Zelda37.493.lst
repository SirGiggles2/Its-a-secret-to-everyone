                            	  1810: 
                            	  1811:     even
                            	  1812: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  1813:     ; Begin with the leever's Y set to Link's Y.
                            	  1814:     ;
02:00038CF4 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038CF8 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038CFC 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038D00 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038D04 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038D06 7628            	  1826:     moveq   #40,D3
02:00038D08 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038D0C 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038D10 02000002        	  1829:     andi.b #$02,D0
02:00038D14 6704            	  1830:     beq  _anon_z04_45
02:00038D16 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038D1A 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038D1C 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038D20 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038D24 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D28 1214            	  1841:     move.b  ($0000,A4),D1
02:00038D2A D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038D2C 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038D30 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038D34 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
