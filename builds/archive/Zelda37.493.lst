                            	  4832: SpreadShot:
                            	  4833:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4834:     ;
                            	  4835:     ; The shot is spreading out.
                            	  4836:     ;
                            	  4837:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4838:     ; These will be negated appropriately for each corner.
                            	  4839:     ;
02:000483A8 41EC0098        	  4840:     lea     ($0098,A4),A0
02:000483AC 10302000        	  4841:     move.b  (A0,D2.W),D0
02:000483B0 19400002        	  4842:     move.b  D0,($0002,A4)
02:000483B4 19400003        	  4843:     move.b  D0,($0003,A4)
                            	  4844:     ; Reset [0F] to not flip horizontally.
                            	  4845:     ;
02:000483B8 7000            	  4846:     moveq   #0,D0
02:000483BA 1940000F        	  4847:     move.b  D0,($000F,A4)
                            	  4848:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4849:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4850:     ;
02:000483BE 7603            	  4851:     moveq   #3,D3
                            	  4852:     even
                            	  4853: _L_z07_SpreadShot_DrawShotCorner:
02:000483C0 1003            	  4854:     move.b  D3,D0
02:000483C2 1B00            	  4855:     move.b  D0,-(A5)  ; PHA
                            	  4856:     ; Save offset X [02] and Y offset [03].
                            	  4857:     ;
02:000483C4 102C0002        	  4858:     move.b  ($0002,A4),D0
02:000483C8 1B00            	  4859:     move.b  D0,-(A5)  ; PHA
02:000483CA 102C0003        	  4860:     move.b  ($0003,A4),D0
02:000483CE 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Calculate and set sprite attributes for this corner:
                            	  4863:     ;   base attribute OR (frame counter AND 3)
                            	  4864:     ;
                            	  4865:     ; The base attribute defines how to flip the sprite.
                            	  4866:     ; The frame counter makes the shot flash by cycling each
                            	  4867:     ; palette row.
                            	  4868:     ;
02:000483D0 102C0015        	  4869:     move.b  ($0015,A4),D0
02:000483D4 02000003        	  4870:     andi.b #$03,D0
02:000483D8 41F9000482B4    	  4871:     lea     (SwordShotSpreadBaseAttr).l,A0
