                            	  4490: _anon_z02_35:
02:00034F5E 41F900034EDA    	  4491:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00034F64 10303000        	  4492:     move.b  (A0,D3.W),D0
