                            	   869: 
02:0000E4C6 3401            	   870:     move.w  D1,D2
02:0000E4C8 04422BC0        	   871:     subi.w  #$2BC0,D2                ; D2.w = attribute offset (0..63)
                            	   872: 
02:0000E4CC 3602            	   873:     move.w  D2,D3
