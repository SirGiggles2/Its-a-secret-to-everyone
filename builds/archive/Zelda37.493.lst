                            	   828: ;==============================================================================
                            	   829: ; prep_phrase — ported from PrepPhrase
                            	   830: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   831: ;==============================================================================
                            	   832: prep_phrase:
02:0000080C 43F900000E2E    	   833:     lea     (MusicBlob).l,A1
02:00000812 7200            	   834:     moveq   #0,D1
02:00000814 123900FFE002    	   835:     move.b  (m_phrase).l,D1
02:0000081A 5341            	   836:     subq.w  #1,D1
02:0000081C 12311000        	   837:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000820 024100FF        	   838:     andi.w  #$FF,D1
                            	   839: 
                            	   840:     ; byte 0: NoteLengthTableBase
02:00000824 13F1100000FFE003	   841:     move.b  (A1,D1.w),(m_len_base).l
02:0000082C 5241            	   842:     addq.w  #1,D1
                            	   843:     ; byte 1: script ptr lo
02:0000082E 7400            	   844:     moveq   #0,D2
02:00000830 14311000        	   845:     move.b  (A1,D1.w),D2
02:00000834 5241            	   846:     addq.w  #1,D1
                            	   847:     ; byte 2: script ptr hi
02:00000836 7600            	   848:     moveq   #0,D3
02:00000838 16311000        	   849:     move.b  (A1,D1.w),D3
02:0000083C 5241            	   850:     addq.w  #1,D1
02:0000083E E14B            	   851:     lsl.w   #8,D3
02:00000840 8642            	   852:     or.w    D2,D3                        ; D3 = NES CPU address
02:00000842 967C8D60        	   853:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:00000846 02830000FFFF    	   854:     andi.l  #$FFFF,D3
02:0000084C 41F900000E2E    	   855:     lea     (MusicBlob).l,A0
02:00000852 D1C3            	   856:     adda.l  D3,A0                        ; A0 = M68K script base
02:00000854 23C800FFE008    	   857:     move.l  A0,(m_script_ptr).l
                            	   858: 
                            	   859:     ; byte 3: NoteOffsetSongTrg
02:0000085A 13F1100000FFE01C	   860:     move.b  (A1,D1.w),(m_trg_off).l
02:00000862 5241            	   861:     addq.w  #1,D1
                            	   862:     ; byte 4: NoteOffsetSongSq0
02:00000864 13F1100000FFE014	   863:     move.b  (A1,D1.w),(m_sq0_off).l
02:0000086C 5241            	   864:     addq.w  #1,D1
                            	   865:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:0000086E 13F1100000FFE024	   866:     move.b  (A1,D1.w),(m_noise_off).l
02:00000876 13F1100000FFE006	   867:     move.b  (A1,D1.w),(m_noise_first).l
02:0000087E 5241            	   868:     addq.w  #1,D1
                            	   869:     ; byte 6: SongEnvelopeSelector
02:00000880 13F1100000FFE004	   870:     move.b  (A1,D1.w),(m_env_sel).l
02:00000888 5241            	   871:     addq.w  #1,D1
                            	   872:     ; byte 7: mystery
02:0000088A 13F1100000FFE005	   873:     move.b  (A1,D1.w),(m_mystery).l
                            	   874: 
                            	   875:     ; Reset counters and Sq1 offset
02:00000892 13FC000100FFE00D	   876:     move.b  #1,(m_sq1_cnt).l
02:0000089A 13FC000100FFE015	   877:     move.b  #1,(m_sq0_cnt).l
02:000008A2 13FC000100FFE01D	   878:     move.b  #1,(m_trg_cnt).l
02:000008AA 13FC000100FFE025	   879:     move.b  #1,(m_noise_cnt).l
02:000008B2 423900FFE00C    	   880:     clr.b   (m_sq1_off).l
02:000008B8 423900FFE021    	   881:     clr.b   (m_trg_rep_n).l
02:000008BE 4E75            	   882:     rts
