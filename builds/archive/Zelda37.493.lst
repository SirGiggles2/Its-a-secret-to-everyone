                            	  5327:     ;
                            	  5328:     ; Set state to $40. It will become $50 below in
                            	  5329:     ; HandleArrowOrBoomerangBlocked.
                            	  5330:     ;
02:000486F4 7040            	  5331:     moveq   #64,D0
02:000486F6 41EC00AC        	  5332:     lea     ($00AC,A4),A0
02:000486FA 11802000        	  5333:     move.b  D0,(A0,D2.W)
                            	  5334:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5335:     ; Else go handle the boomerang being blocked.
                            	  5336:     ;
02:000486FE 0C02000D        	  5337:     cmpi.b  #$0D,D2
02:00048702 640E            	  5338:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:00048704 41EC034F        	  5339:     lea     ($034F,A4),A0
02:00048708 10302000        	  5340:     move.b  (A0,D2.W),D0
02:0004870C 0C00005B        	  5341:     cmpi.b  #$5B,D0
02:00048710 6708            	  5342:     beq  _L_z07_CheckState20_Deactivate
