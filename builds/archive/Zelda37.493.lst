02:000483E4 4EB90003111E    	  4874:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4875:     ; Add the object's X (the center of the spread) and the
                            	  4876:     ; current offset in [02] to set sprite X in [00].
                            	  4877:     ;
02:000483EA 10342070        	  4878:     move.b  ($70,A4,D2.W),D0
02:000483EE 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:000483F2 122C0002        	  4880:     move.b  ($0002,A4),D1
02:000483F6 D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:000483F8 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:000483FA 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:000483FE B001            	  4887:     cmp.b   D1,D0
02:00048400 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048402 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:00048406 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:00048408 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:0004840C 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
