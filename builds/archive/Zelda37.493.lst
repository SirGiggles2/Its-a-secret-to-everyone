                            	  2572:     ;
02:000391F0 103C0080        	  2573:     move.b  #$80,D0
02:000391F4 41EC0098        	  2574:     lea     ($0098,A4),A0
02:000391F8 11802000        	  2575:     move.b  D0,(A0,D2.W)
