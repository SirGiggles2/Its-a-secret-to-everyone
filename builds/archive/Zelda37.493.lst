02:000472A6 D101            	  2369:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000472A8 41EC030A        	  2370:     lea     ($030A,A4),A0
02:000472AC 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:000472B0 41EC030B        	  2372:     lea     ($030B,A4),A0
02:000472B4 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:000472B8 41EC0306        	  2374:     lea     ($0306,A4),A0
02:000472BC 52302000        	  2375:     addq.b  #1,(A0,D2.W)
02:000472C0 41EC030B        	  2376:     lea     ($030B,A4),A0
