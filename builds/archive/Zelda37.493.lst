02:00038D78 6400FF78        	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
02:00038D7C 522C0510        	  1884:     addq.b  #1,($0510,A4)
                            	  1885:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1886:     ; and pick up whatever the new value is for state 1.
                            	  1887:     ;
02:00038D80 7001            	  1888:     moveq   #1,D0
02:00038D82 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:00038D86 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
02:00038D8A E308            	  1893:     lsl.b  #1,D0   ; ASL A
02:00038D8C 1940004D        	  1894:     move.b  D0,($004D,A4)
02:00038D90 6100008C        	  1895:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  1896:     ; The leever has to face Link in order to move toward him.
                            	  1897:     ;
02:00038D94 4EB900048010    	  1898:     jsr     ReverseObjDir
                            	  1899:     even
                            	  1900: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  1901:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  1902:     ;
02:00038D9A 41EC00AC        	  1903:     lea     ($00AC,A4),A0
02:00038D9E 10302000        	  1904:     move.b  (A0,D2.W),D0
02:00038DA2 0C000003        	  1905:     cmpi.b  #$03,D0
02:00038DA6 666E            	  1906:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  1907:     ; State 3.
                            	  1908:     ;
                            	  1909:     ; If being shoved, go shove, animate, and draw the leever.
