                            	  3957: _anon_z07_15:
02:00047E2E 1940010E        	  3958:     move.b  D0,($010E,A4)
02:00047E32 1943010F        	  3959:     move.b  D3,($010F,A4)
02:00047E36 102C000F        	  3960:     move.b  ($000F,A4),D0
