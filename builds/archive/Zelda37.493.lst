02:000485B6 10302000        	  5154:     move.b  (A0,D2.W),D0
02:000485BA 02000003        	  5155:     andi.b #$03,D0
02:000485BE 670A            	  5156:     beq  _anon_z07_26
02:000485C0 4EB900030A68    	  5157:     jsr     MoveShot
02:000485C6 522C000E        	  5158:     addq.b  #1,($000E,A4)
