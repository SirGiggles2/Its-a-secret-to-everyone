02:0003A45A 7004            	  5063:     moveq   #4,D0
02:0003A45C 41EC042C        	  5064:     lea     ($042C,A4),A0
02:0003A460 11802000        	  5065:     move.b  D0,(A0,D2.W)
                            	  5066:     even
