02:0003A7D2 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0003A7D6 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7DA 123C0008        	  5515:     move.b  #$08,D1
02:0003A7DE D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A7E0 020000F0        	  5517:     andi.b #$F0,D0
