02:0002B626 1002            	  3544:     move.b  D2,D0
02:0002B628 0240003F        	  3545:     andi.w  #$003F,D0               ; mask to valid color index
02:0002B62C E348            	  3546:     lsl.w   #1,D0                   ; word offset
02:0002B62E 30330000        	  3547:     move.w  (A3,D0.W),D0           ; Genesis color word
02:0002B632 33C000C00000    	  3548:     move.w  D0,(VDP_DATA).l
