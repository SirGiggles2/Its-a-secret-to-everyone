                            	   662: 
                            	   663: ;==============================================================================
                            	   664: ; Zelda translated code — generated by tools/transpile_6502.py --all --no-stubs
                            	   665: ;
                            	   666: ; z_07.asm is the NES fixed bank ($E000-$FFFF): IsrReset, IsrNmi, RunGame,
                            	   667: ; and ALL shared equates (NES RAM variables).  It must be included first.
                            	   668: ;
                            	   669: ; z_00–z_06 are the switchable PRG banks.  They carry no equate block in
                            	   670: ; --all mode (suppressed by transpiler to avoid vasm duplicate-symbol errors).
                            	   671: ; All cross-bank import stubs are also suppressed — every symbol resolves
                            	   672: ; directly by label across the flat Genesis ROM.
                            	   673: ;
                            	   674: ; vasm CWD is src/ (set by build.bat pushd), so paths are relative to src/.
                            	   675: ;==============================================================================
                            	   676:     ; All 8 banks included in ascending order (z_00 first so its definitions of
                            	   677:     ; multiply-exported symbols like Exit are canonical).  z_07 is included last
                            	   678:     ; so its cross-bank stubs (which are suppressed for globally-exported symbols)
                            	   679:     ; don't conflict with real definitions from z_00-z_06.
                            	   680:     ; Equates are only in z_07 (other banks omit them in --all mode).
                            	   681:     include "zelda_translated/z_00.asm"

Source: "zelda_translated\z_00.asm"
