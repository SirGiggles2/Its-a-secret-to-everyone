                            	  1741: _anon_z04_42:
                            	  1742:     ; State 0.
                            	  1743:     ;
                            	  1744:     ; In state we determine whether to burst out of the ground.
                            	  1745:     ; If the long timer has not expired, then return.
                            	  1746:     ;
02:00038C78 102C004D        	  1747:     move.b  ($004D,A4),D0
02:00038C7C 6674            	  1748:     bne  _L_z04_UpdateRedLeever_Exit
                            	  1749:     ; Only allow two red leevers at a time.
                            	  1750:     ;
02:00038C7E 102C0510        	  1751:     move.b  ($0510,A4),D0
02:00038C82 0C000002        	  1752:     cmpi.b  #$02,D0
02:00038C86 646A            	  1753:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1754:     ; Face in the same direction as Link.
                            	  1755:     ;
02:00038C88 102C0098        	  1756:     move.b  ($0098,A4),D0
02:00038C8C 41EC0098        	  1757:     lea     ($0098,A4),A0
02:00038C90 11802000        	  1758:     move.b  D0,(A0,D2.W)
                            	  1759:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  1760:     ;
02:00038C94 10342019        	  1761:     move.b  ($19,A4,D2.W),D0
02:00038C98 0C0000C0        	  1762:     cmpi.b  #$C0,D0
02:00038C9C 6506            	  1763:     bcs  _anon_z04_43
02:00038C9E 4EB900048010    	  1764:     jsr     ReverseObjDir
                            	  1765: _anon_z04_43:
                            	  1766:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  1767:     ;
02:00038CA4 41EC0098        	  1768:     lea     ($0098,A4),A0
02:00038CA8 10302000        	  1769:     move.b  (A0,D2.W),D0
02:00038CAC 0200000C        	  1770:     andi.b #$0C,D0
02:00038CB0 6742            	  1771:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  1772:     ; Begin with the leever's X set to Link's X.
                            	  1773:     ;
02:00038CB2 102C0070        	  1774:     move.b  ($0070,A4),D0
02:00038CB6 19802070        	  1775:     move.b  D0,($70,A4,D2.W)
                            	  1776:     ; If facing down, then use Y offset $28.
                            	  1777:     ; Else store Y offset -$28 in [00].
                            	  1778:     ;
02:00038CBA 7628            	  1779:     moveq   #40,D3
02:00038CBC 41EC0098        	  1780:     lea     ($0098,A4),A0
02:00038CC0 10302000        	  1781:     move.b  (A0,D2.W),D0
02:00038CC4 02000008        	  1782:     andi.b #$08,D0
02:00038CC8 6704            	  1783:     beq  _anon_z04_44
02:00038CCA 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:00038CCE 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
02:00038CD0 102C0084        	  1789:     move.b  ($0084,A4),D0
02:00038CD4 023C00EE        	  1790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038CD8 1214            	  1791:     move.b  ($0000,A4),D1
02:00038CDA D101            	  1792:     addx.b  D1,D0   ; ADC $00
                            	  1793:     ; Sanitize the Y coordinate:
                            	  1794:     ; (Y AND $F0) OR $D
                            	  1795:     ;
02:00038CDC 020000F0        	  1796:     andi.b #$F0,D0
02:00038CE0 0000000D        	  1797:     ori.b #$0D,D0
02:00038CE4 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038CE8 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
                            	  1802:     ;
                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038CEC 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038CF0 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
