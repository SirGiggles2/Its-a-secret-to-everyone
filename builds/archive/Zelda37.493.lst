                            	  2659: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  2660:     ; If there is a mismatch between the current quest and the quest
                            	  2661:     ; needed for the secret in this room, then return.
                            	  2662:     ;
02:000392A0 6100021C        	  2663:     jsr     IsQuestSecretMismatch
02:000392A4 6500008A        	  2664:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  2665:     ; The gravestone and rocks can only be pushed vertically.
                            	  2666:     ; Return, if X's don't match.
                            	  2667:     ;
02:000392A8 102C0070        	  2668:     move.b  ($0070,A4),D0
02:000392AC 12342070        	  2669:     move.b  ($70,A4,D2.W),D1
02:000392B0 B001            	  2670:     cmp.b   D1,D0
02:000392B2 667C            	  2671:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  2672:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  2673:     ; is positive; then go use it along with a flag that indicates that
                            	  2674:     ; Link is "down" from the object.
                            	  2675:     ;
02:000392B4 7600            	  2676:     moveq   #0,D3
02:000392B6 102C0084        	  2677:     move.b  ($0084,A4),D0
02:000392BA 023C00EE        	  2678:     andi    #$EE,CCR  ; CLC: clear C+X
02:000392BE 123C0003        	  2679:     move.b  #$03,D1
02:000392C2 D101            	  2680:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000392C4 003C0011        	  2681:     ori     #$11,CCR  ; SEC: set C+X
02:000392C8 41EC0084        	  2682:     lea     ($0084,A4),A0
02:000392CC 12302000        	  2683:     move.b  (A0,D2.W),D1
02:000392D0 0A3C0010        	  2684:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000392D4 9101            	  2685:     subx.b  D1,D0   ; SBC ObjY,X
02:000392D6 0A3C0010        	  2686:     eori    #$10,CCR  ; restore X = 6502 C
02:000392DA 6A0E            	  2687:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  2688:     ; Else negate it, and indicate Link is "up" from the object.
                            	  2689:     ;
02:000392DC 5203            	  2690:     addq.b  #1,D3
02:000392DE 4600            	  2691:     eori.b #$FF,D0
02:000392E0 023C00EE        	  2692:     andi    #$EE,CCR  ; CLC: clear C+X
02:000392E4 123C0001        	  2693:     move.b  #$01,D1
02:000392E8 D101            	  2694:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  2695:     even
                            	  2696: _L_z04_UpdateRockOrGravestone_CheckDistance:
                            	  2697:     ; If the distance >= $11, return.
