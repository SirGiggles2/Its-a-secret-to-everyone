02:00040A0C 6100FCDA        	  7015:     jsr     WriteSquareOW
02:00040A10 101D            	  7016:     move.b  (A5)+,D0  ; PLA
02:00040A12 7400            	  7017:     moveq   #0,D2
02:00040A14 1400            	  7018:     move.b  D0,D2
02:00040A16 4E75            	  7019:     rts
