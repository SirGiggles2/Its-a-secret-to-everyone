                            	  2044: AnimateAndDrawObjectWalking:
02:00030E1E 4EB90004904E    	  2045:     jsr     AnimateObjectWalking
02:00030E24 1003            	  2046:     move.b  D3,D0
02:00030E26 6004            	  2047:     jmp     DrawObjectNotMirrored
                            	  2048: 
                            	  2049: ; Params:
                            	  2050: ; A: frame image
                            	  2051: ; X: object index
                            	  2052: ; [00]: object X
                            	  2053: ; [01]: object Y
                            	  2054: ;
                            	  2055: ;
                            	  2056: ; Set [0C] mirrored.
                            	  2057:     even
                            	  2058: DrawObjectMirrored:
02:00030E28 7601            	  2059:     moveq   #1,D3
02:00030E2A 6602            	  2060:     bne  _anon_z01_75
                            	  2061: ; Params:
                            	  2062: ; A: frame image
                            	  2063: ; X: object index
                            	  2064: ; [00]: object X
                            	  2065: ; [01]: object Y
                            	  2066: ; [0F]: flip horizontally
                            	  2067: ;
                            	  2068:     even
                            	  2069: DrawObjectNotMirrored:
02:00030E2C 7600            	  2070:     moveq   #0,D3
                            	  2071: _anon_z01_75:
02:00030E2E 1943000C        	  2072:     move.b  D3,($000C,A4)
                            	  2073:     ; Set animation index = object type + 1.
                            	  2074:     ;
02:00030E32 7600            	  2075:     moveq   #0,D3
02:00030E34 41EC034F        	  2076:     lea     ($034F,A4),A0
02:00030E38 16302000        	  2077:     move.b  (A0,D2.W),D3
                            	  2078: ; Params:
                            	  2079: ; A: frame
                            	  2080: ; X: object index/cycle sprite index
                            	  2081: ; Y: object type
                            	  2082: ; [00]: object X
                            	  2083: ; [01]: object Y
                            	  2084: ; [0C]: mirrored
                            	  2085: ; [0F]: flip horizontally
                            	  2086: ;
                            	  2087: ; Note:
                            	  2088: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2089: ;
                            	  2090: ; The animation index of most objects is (object type + 1),
                            	  2091: ; to make up for the fact that Link uses two animation indexes.
                            	  2092: ;
                            	  2093:     even
                            	  2094: DrawObjectWithType:
02:00030E3C 5203            	  2095:     addq.b  #1,D3
                            	  2096: ; Params:
                            	  2097: ; A: frame
                            	  2098: ; X: object index/cycle sprite index
                            	  2099: ; Y: animation index
                            	  2100: ; [00]: object X
                            	  2101: ; [01]: object Y
                            	  2102: ; [0C]: mirrored
                            	  2103: ; [0F]: flip horizontally
                            	  2104: ;
                            	  2105: ; Note:
                            	  2106: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2107: ; But Link uses [0F] for flipping without checking [0C].
                            	  2108: ;
                            	  2109: ;
                            	  2110: ; [0D] holds frame.
                            	  2111:     even
                            	  2112: DrawObjectWithAnim:
02:00030E3E 1940000D        	  2113:     move.b  D0,($000D,A4)
02:00030E42 1943000E        	  2114:     move.b  D3,($000E,A4)
02:00030E46 19420008        	  2115:     move.b  D2,($0008,A4)
                            	  2116:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  2117:     ;
02:00030E4A 7600            	  2118:     moveq   #0,D3
02:00030E4C 162C0341        	  2119:     move.b  ($0341,A4),D3
02:00030E50 41F900030DF4    	  2120:     lea     (SpriteOffsets).l,A0
02:00030E56 10303000        	  2121:     move.b  (A0,D3.W),D0
02:00030E5A 19400343        	  2122:     move.b  D0,($0343,A4)
02:00030E5E 41F900030DF5    	  2123:     lea     (SpriteOffsets+1).l,A0
02:00030E64 10303000        	  2124:     move.b  (A0,D3.W),D0
                            	  2125:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  2126:     ;
02:00030E68 4A02            	  2127:     cmpi.b  #$00,D2
02:00030E6A 6702            	  2128:     beq.s  __far_z_01_0001
02:00030E6C 6008            	  2129:     jmp  DrawObjectWithAnimAndSpecificSprites
                            	  2130: __far_z_01_0001:
02:00030E6E 7048            	  2131:     moveq   #72,D0
02:00030E70 19400343        	  2132:     move.b  D0,($0343,A4)
02:00030E74 704C            	  2133:     moveq   #76,D0
                            	  2134:     even
                            	  2135: DrawObjectWithAnimAndSpecificSprites:
02:00030E76 19400344        	  2136:     move.b  D0,($0344,A4)
02:00030E7A 7600            	  2137:     moveq   #0,D3
02:00030E7C 162C000E        	  2138:     move.b  ($000E,A4),D3
02:00030E80 7001            	  2139:     moveq   #1,D0
02:00030E82 19400007        	  2140:     move.b  D0,($0007,A4)
02:00030E86 7008            	  2141:     moveq   #8,D0
02:00030E88 1940000A        	  2142:     move.b  D0,($000A,A4)
02:00030E8C 41F900030BDC    	  2143:     lea     (ObjAnimations).l,A0
02:00030E92 10303000        	  2144:     move.b  (A0,D3.W),D0
02:00030E96 023C00EE        	  2145:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030E9A 122C000D        	  2146:     move.b  ($000D,A4),D1
02:00030E9E D101            	  2147:     addx.b  D1,D0   ; ADC $0D
02:00030EA0 7600            	  2148:     moveq   #0,D3
02:00030EA2 1600            	  2149:     move.b  D0,D3
02:00030EA4 41F900030C5C    	  2150:     lea     (ObjAnimFrameHeap).l,A0
02:00030EAA 10303000        	  2151:     move.b  (A0,D3.W),D0
02:00030EAE 19400002        	  2152:     move.b  D0,($0002,A4)
02:00030EB2 023C00EE        	  2153:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EB6 123C0002        	  2154:     move.b  #$02,D1
02:00030EBA D101            	  2155:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030EBC 19400003        	  2156:     move.b  D0,($0003,A4)
                            	  2157:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  2158:     ; then go set attributes and write sprites.
                            	  2159:     ;
02:00030EC0 4A02            	  2160:     cmpi.b  #$00,D2
02:00030EC2 6722            	  2161:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00030EC4 0C02000D        	  2162:     cmpi.b  #$0D,D2
02:00030EC8 641C            	  2163:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
                            	  2164:     ; If the object has a "half-width draw" attribute, then
                            	  2165:     ; go draw half-width.
                            	  2166:     ;
02:00030ECA 41EC04BF        	  2167:     lea     ($04BF,A4),A0
02:00030ECE 10302000        	  2168:     move.b  (A0,D2.W),D0
02:00030ED2 02000002        	  2169:     andi.b #$02,D0
02:00030ED6 6630            	  2170:     bne  _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth
                            	  2171:     ; If the object has the "Ignore sprite attribute table" attribute,
                            	  2172:     ; then don't look up sprite attributes.
                            	  2173:     ;
02:00030ED8 41EC04BF        	  2174:     lea     ($04BF,A4),A0
02:00030EDC 10302000        	  2175:     move.b  (A0,D2.W),D0
02:00030EE0 02000008        	  2176:     andi.b #$08,D0
02:00030EE4 660E            	  2177:     bne  _anon_z01_76
                            	  2178:     even
                            	  2179: _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr:
02:00030EE6 41F900030D28    	  2180:     lea     (ObjAnimAttrHeap).l,A0
02:00030EEC 10303000        	  2181:     move.b  (A0,D3.W),D0
02:00030EF0 6100022C        	  2182:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  2183: _anon_z01_76:
                            	  2184:     ; If it's Link, write the sprites. He's never mirrored.
                            	  2185:     ;
02:00030EF4 4A02            	  2186:     cmpi.b  #$00,D2
02:00030EF6 6602            	  2187:     bne.s  __far_z_01_0002
02:00030EF8 6014            	  2188:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  2189: __far_z_01_0002:
                            	  2190:     ; For other objects, the caller controls mirroring and flipping.
                            	  2191:     ;
                            	  2192:     ; If mirrored [0C], then draw it mirrored.
                            	  2193:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  2194:     ;
02:00030EFA 7600            	  2195:     moveq   #0,D3
02:00030EFC 162C000C        	  2196:     move.b  ($000C,A4),D3
02:00030F00 6602            	  2197:     bne.s  __far_z_01_0003
02:00030F02 600A            	  2198:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  2199: __far_z_01_0003:
02:00030F04 600001FE        	  2200:     jmp     Anim_WriteMirroredSpritePair
                            	  2201: 
                            	  2202:     even
                            	  2203: _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth:
02:00030F08 532C0007        	  2204:     subq.b  #1,($0007,A4)
02:00030F0C 6034            	  2205:     jmp     Anim_WriteSpritePair
                            	  2206: 
                            	  2207: ; Params:
                            	  2208: ; [00]: Object X
                            	  2209: ; [01]: Object Y
                            	  2210: ; [02]: Left tile
                            	  2211: ; [03]: Right tile
                            	  2212: ; [04]: Left attributes
                            	  2213: ; [05]: Right attributes
                            	  2214: ; [07]: Has two sides
                            	  2215: ; [08]: Cycle sprite index
                            	  2216: ; [0A]: X separation
                            	  2217: ; [0F]: Flip horizontally
                            	  2218: ; [0343]: LeftSpriteOffset
                            	  2219: ; [0344]: RightSpriteOffset
                            	  2220: ;
                            	  2221: ; If [0F] = 0, write the sprite pair with no further processing.
                            	  2222: ;
                            	  2223:     even
                            	  2224: Anim_WriteHorizontallyFlippableSpritePair:
02:00030F0E 102C000F        	  2225:     move.b  ($000F,A4),D0
02:00030F12 6602            	  2226:     bne.s  __far_z_01_0004
02:00030F14 602C            	  2227:     jmp  Anim_WriteSpritePair
                            	  2228: __far_z_01_0004:
                            	  2229:     ; Otherwise, reverse the two sides.
                            	  2230:     ;
02:00030F16 102C0002        	  2231:     move.b  ($0002,A4),D0
02:00030F1A 1B00            	  2232:     move.b  D0,-(A5)  ; PHA
02:00030F1C 102C0003        	  2233:     move.b  ($0003,A4),D0
02:00030F20 19400002        	  2234:     move.b  D0,($0002,A4)
02:00030F24 101D            	  2235:     move.b  (A5)+,D0  ; PLA
02:00030F26 19400003        	  2236:     move.b  D0,($0003,A4)
                            	  2237:     ; Set the horizontal flip sprite attributes.
                            	  2238:     ;
02:00030F2A 102C0004        	  2239:     move.b  ($0004,A4),D0
