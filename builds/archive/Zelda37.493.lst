02:0004948A 6700016A        	  7106:     beq  _L_z07_InitObject_NormalSpawn
02:0004948E 0C00002E        	  7107:     cmpi.b  #$2E,D0
02:00049492 67000162        	  7108:     beq  _L_z07_InitObject_NormalSpawn
