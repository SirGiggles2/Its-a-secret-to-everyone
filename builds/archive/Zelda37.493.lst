                            	   970: ;==============================================================================
                            	   971: ; tick_sq0 — Sq0 channel update
                            	   972: ;==============================================================================
                            	   973: tick_sq0:
02:000009D6 4A3900FFE014    	   974:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:000009DC 6754            	   975:     beq     tick_trg
02:000009DE 533900FFE015    	   976:     subq.b  #1,(m_sq0_cnt).l
02:000009E4 664C            	   977:     bne     tick_trg
02:000009E6 207900FFE008    	   978:     move.l  (m_script_ptr).l,A0
02:000009EC 7200            	   979:     moveq   #0,D1
02:000009EE 123900FFE014    	   980:     move.b  (m_sq0_off).l,D1
02:000009F4 523900FFE014    	   981:     addq.b  #1,(m_sq0_off).l
02:000009FA 10301000        	   982:     move.b  (A0,D1.w),D0
02:000009FE 4A00            	   983:     tst.b   D0
02:00000A00 6A22            	   984:     bpl.s   .play
02:00000A02 61000164        	   985:     bsr     get_song_note_length
02:00000A06 13C000FFE016    	   986:     move.b  D0,(m_sq0_len).l
02:00000A0C 207900FFE008    	   987:     move.l  (m_script_ptr).l,A0
02:00000A12 7200            	   988:     moveq   #0,D1
02:00000A14 123900FFE014    	   989:     move.b  (m_sq0_off).l,D1
02:00000A1A 523900FFE014    	   990:     addq.b  #1,(m_sq0_off).l
02:00000A20 10301000        	   991:     move.b  (A0,D1.w),D0
                            	   992: .play:
02:00000A24 610001BA        	   993:     bsr     emit_note_sq0
02:00000A28 13F900FFE01600FF	   994:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A30 E015
                            	   995:     bra     tick_trg
                            	   996: 
                            	   997: ;==============================================================================
                            	   998: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	   999: ;==============================================================================
                            	  1000: tick_trg:
02:00000A32 4A3900FFE01C    	  1001:     tst.b   (m_trg_off).l
02:00000A38 6700009E        	  1002:     beq     tick_noise
02:00000A3C 533900FFE01D    	  1003:     subq.b  #1,(m_trg_cnt).l
02:00000A42 66000094        	  1004:     bne     tick_noise
                            	  1005: .prep_note_or_passage:
02:00000A46 207900FFE008    	  1006:     move.l  (m_script_ptr).l,A0
02:00000A4C 7200            	  1007:     moveq   #0,D1
02:00000A4E 123900FFE01C    	  1008:     move.b  (m_trg_off).l,D1
02:00000A54 523900FFE01C    	  1009:     addq.b  #1,(m_trg_off).l
02:00000A5A 10301000        	  1010:     move.b  (A0,D1.w),D0
02:00000A5E 676A            	  1011:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000A60 4A00            	  1012:     tst.b   D0
02:00000A62 6A56            	  1013:     bpl.s   .play_note_trg                ; direct note
02:00000A64 0C0000F0        	  1014:     cmpi.b  #$F0,D0
02:00000A68 6718            	  1015:     beq.s   .end_of_passage
02:00000A6A 652A            	  1016:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1017:     ; $F1-$FF → start passage
02:00000A6C 040000F0        	  1018:     subi.b  #$F0,D0
02:00000A70 13C000FFE021    	  1019:     move.b  D0,(m_trg_rep_n).l
02:00000A76 13F900FFE01C00FF	  1020:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000A7E E022
02:00000A80 60C4            	  1021:     bra.s   .prep_note_or_passage
                            	  1022: .end_of_passage:
02:00000A82 533900FFE021    	  1023:     subq.b  #1,(m_trg_rep_n).l
02:00000A88 670A            	  1024:     beq.s   .pass_done
02:00000A8A 13F900FFE02200FF	  1025:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000A92 E01C
                            	  1026: .pass_done:
02:00000A94 60B0            	  1027:     bra.s   .prep_note_or_passage
                            	  1028: .prep_note_trg:
02:00000A96 610000D0        	  1029:     bsr     get_song_note_length
02:00000A9A 13C000FFE01E    	  1030:     move.b  D0,(m_trg_len).l
02:00000AA0 207900FFE008    	  1031:     move.l  (m_script_ptr).l,A0
02:00000AA6 7200            	  1032:     moveq   #0,D1
02:00000AA8 123900FFE01C    	  1033:     move.b  (m_trg_off).l,D1
02:00000AAE 523900FFE01C    	  1034:     addq.b  #1,(m_trg_off).l
02:00000AB4 10301000        	  1035:     move.b  (A0,D1.w),D0
02:00000AB8 6710            	  1036:     beq.s   .silence_trg
                            	  1037: .play_note_trg:
02:00000ABA 61000182        	  1038:     bsr     emit_note_trg
02:00000ABE 13F900FFE01E00FF	  1039:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AC6 E01D
02:00000AC8 600E            	  1040:     bra     tick_noise
                            	  1041: .silence_trg:
02:00000ACA 610001E6        	  1042:     bsr     key_off_trg
02:00000ACE 13F900FFE01E00FF	  1043:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000AD6 E01D
                            	  1044:     bra     tick_noise
                            	  1045: 
                            	  1046: ;==============================================================================
                            	  1047: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1048: ;==============================================================================
                            	  1049: tick_noise:
02:00000AD8 103900FFE000    	  1050:     move.b  (m_song).l,D0
02:00000ADE 02000091        	  1051:     andi.b  #$91,D0
02:00000AE2 67000082        	  1052:     beq     .tn_done
                            	  1053:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1054:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1055:     ; a hit fires below.
02:00000AE6 61000250        	  1056:     bsr     noise_decay_tick
02:00000AEA 533900FFE025    	  1057:     subq.b  #1,(m_noise_cnt).l
02:00000AF0 6674            	  1058:     bne     .tn_done
                            	  1059: .read:
02:00000AF2 207900FFE008    	  1060:     move.l  (m_script_ptr).l,A0
02:00000AF8 7200            	  1061:     moveq   #0,D1
02:00000AFA 123900FFE024    	  1062:     move.b  (m_noise_off).l,D1
02:00000B00 523900FFE024    	  1063:     addq.b  #1,(m_noise_off).l
02:00000B06 10301000        	  1064:     move.b  (A0,D1.w),D0
02:00000B0A 660C            	  1065:     bne.s   .got
02:00000B0C 13F900FFE00600FF	  1066:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B14 E024
02:00000B16 60DA            	  1067:     bra.s   .read
                            	  1068: .got:
02:00000B18 1800            	  1069:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1070:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1071:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1072:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1073:     ; (0,7,6). For our port we replicate exactly.
02:00000B1A 7400            	  1074:     moveq   #0,D2
02:00000B1C 1404            	  1075:     move.b  D4,D2
                            	  1076:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B1E 7000            	  1077:     moveq   #0,D0
02:00000B20 08020000        	  1078:     btst    #0,D2
02:00000B24 6704            	  1079:     beq.s   .b0
02:00000B26 08C00002        	  1080:     bset    #2,D0
                            	  1081: .b0:
02:00000B2A 08020007        	  1082:     btst    #7,D2
02:00000B2E 6704            	  1083:     beq.s   .b7
02:00000B30 08C00001        	  1084:     bset    #1,D0
                            	  1085: .b7:
02:00000B34 08020006        	  1086:     btst    #6,D2
02:00000B38 6704            	  1087:     beq.s   .b6
02:00000B3A 08C00000        	  1088:     bset    #0,D0
                            	  1089: .b6:
02:00000B3E 7200            	  1090:     moveq   #0,D1
02:00000B40 123900FFE003    	  1091:     move.b  (m_len_base).l,D1
02:00000B46 D240            	  1092:     add.w   D0,D1
02:00000B48 43F900000DEA    	  1093:     lea     (NoteLengthTables).l,A1
02:00000B4E 13F1100000FFE025	  1094:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1095:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000B56 1004            	  1096:     move.b  D4,D0
02:00000B58 0200003E        	  1097:     andi.b  #$3E,D0
02:00000B5C E808            	  1098:     lsr.b   #4,D0
02:00000B5E 7200            	  1099:     moveq   #0,D1
02:00000B60 1200            	  1100:     move.b  D0,D1
                            	  1101:     ; Map to PSG noise: set volume + period
02:00000B62 6100015A        	  1102:     bsr     set_psg_noise
                            	  1103: .tn_done:
02:00000B66 4E75            	  1104:     rts
