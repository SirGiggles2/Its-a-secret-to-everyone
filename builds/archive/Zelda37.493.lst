                            	  5769: _anon_z05_124:
                            	  5770:     ; Add the door to the opened door mask, reset door command,
                            	  5771:     ; and lay out doors.
                            	  5772:     ;
02:0003FEBE 102C0055        	  5773:     move.b  ($0055,A4),D0
02:0003FEC2 122C00EE        	  5774:     move.b  ($00EE,A4),D1
02:0003FEC6 8001            	  5775:     or.b  D1,D0
02:0003FEC8 6000FF66        	  5776:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:0003FECC 102C0055        	  5803:     move.b  ($0055,A4),D0
02:0003FED0 19400002        	  5804:     move.b  D0,($0002,A4)
02:0003FED4 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:0003FED8 0C000005        	  5806:     cmpi.b  #$05,D0
02:0003FEDC 650C            	  5807:     bcs  _anon_z05_125
02:0003FEDE 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:0003FEE0 7004            	  5809:     moveq   #4,D0
02:0003FEE2 4EB9000309B6    	  5810:     jsr     PlaySample
02:0003FEE8 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:0003FEEA 0C000004        	  5818:     cmpi.b  #$04,D0
02:0003FEEE 6602            	  5819:     bne  _anon_z05_126
02:0003FEF0 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:0003FEF2 0C000001        	  5822:     cmpi.b  #$01,D0
02:0003FEF6 6602            	  5823:     bne  _anon_z05_127
02:0003FEF8 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:0003FEFA 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:0003FEFE 123C0003        	  5829:     move.b  #$03,D1
02:0003FF02 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF06 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:0003FF08 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FF0C 7600            	  5833:     moveq   #0,D3
02:0003FF0E 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:0003FF10 102C0008        	  5841:     move.b  ($0008,A4),D0
02:0003FF14 6708            	  5842:     beq  _anon_z05_128
02:0003FF16 0C030005        	  5843:     cmpi.b  #$05,D3
02:0003FF1A 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FF1C 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:0003FF1E 0C030003        	  5847:     cmpi.b  #$03,D3
02:0003FF22 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FF24 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:0003FF26 7003            	  5857:     moveq   #3,D0
02:0003FF28 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:0003FF2C 122C0003        	  5859:     move.b  ($0003,A4),D1
02:0003FF30 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF34 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:0003FF36 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:0003FF3A 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:0003FF3E 41F90003FD14    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:0003FF44 10302000        	  5870:     move.b  (A0,D2.W),D0
02:0003FF48 1880            	  5871:     move.b  D0,($0000,A4)
02:0003FF4A 41F90003FD18    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:0003FF50 10302000        	  5873:     move.b  (A0,D2.W),D0
02:0003FF54 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:0003FF58 19420009        	  5878:     move.b  D2,($0009,A4)
02:0003FF5C 7400            	  5879:     moveq   #0,D2
02:0003FF5E 142C0301        	  5880:     move.b  ($0301,A4),D2
                            	  5881:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5882:     ;
02:0003FF62 7000            	  5883:     moveq   #0,D0
02:0003FF64 19400007        	  5884:     move.b  D0,($0007,A4)
02:0003FF68 7002            	  5885:     moveq   #2,D0
02:0003FF6A 19400006        	  5886:     move.b  D0,($0006,A4)
02:0003FF6E 19400005        	  5887:     move.b  D0,($0005,A4)
02:0003FF72 0A3C0001        	  5888:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003FF76 4E75            	  5889:     rts
