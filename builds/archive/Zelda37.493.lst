                            	   641: ; intro_to_file_select_trampoline — STUB. Real body in Task 9.
                            	   642: ; For Task 8 it just sets the handoff probe marker and stops, so we can
                            	   643: ; verify Start press is detected and intro_start_pressed runs end-to-end.
                            	   644: ;==============================================================================
                            	   645:     xdef    intro_to_file_select_trampoline
                            	   646: intro_to_file_select_trampoline:
02:00000362 13FC00BB00FF07F2	   647:     move.b  #$BB,($00FF07F2).l
02:0000036A 4E722700        	   648:     stop    #$2700
02:0000036E 60F2            	   649:     bra.s   intro_to_file_select_trampoline
