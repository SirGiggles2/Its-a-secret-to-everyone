02:00038E4E 10303000        	  1995:     move.b  (A0,D3.W),D0
02:00038E52 41EC03BC        	  1996:     lea     ($03BC,A4),A0
02:00038E56 11802000        	  1997:     move.b  D0,(A0,D2.W)
02:00038E5A 41F900038C5E    	  1998:     lea     (RedLeeverStateTimes).l,A0
02:00038E60 10303000        	  1999:     move.b  (A0,D3.W),D0
02:00038E64 19802028        	  2000:     move.b  D0,($28,A4,D2.W)
                            	  2001:     even
