02:0003BA4E 4EB90004909A    	  7974:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003BA54 41EC03E4        	  7975:     lea     ($03E4,A4),A0
02:0003BA58 10302000        	  7976:     move.b  (A0,D2.W),D0
