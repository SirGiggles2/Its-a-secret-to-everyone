Source: "audio_driver.asm"
                            	     2: 
                            	     3: ;==============================================================================
                            	     4: ; audio_driver.asm — YM2612 + PSG driver for NES APU emulation
                            	     5: ;
                            	     6: ; Maps NES APU channels to Genesis sound hardware using Sonic 2 Emerald Hill
                            	     7: ; Zone FM patches:
                            	     8: ;   Pulse 1 → YM2612 ch 0 (EHZ Voice $00, Algorithm 7)
                            	     9: ;   Pulse 2 → YM2612 ch 1 (EHZ Voice $03, Algorithm 5)
                            	    10: ;   Triangle → YM2612 ch 2 (EHZ Voice $07, Algorithm 0)
                            	    11: ;   Noise   → SN76489 PSG ch 3
                            	    12: ;
                            	    13: ; Include BEFORE nes_io.asm so helpers are available to APU stubs.
                            	    14: ;==============================================================================
                            	    15: 
                            	    16: ;----------------------------------------------------------------------
                            	    17: ; Hardware ports
                            	    18: ;----------------------------------------------------------------------
                            	    19: YM_ADDR1        equ $A04000     ; YM2612 Part I address  (ch 0-2 + global regs)
                            	    20: YM_DATA1        equ $A04001     ; YM2612 Part I data
                            	    21: YM_ADDR2        equ $A04002     ; YM2612 Part II address (ch 3-5 / ch 6 DAC pan)
                            	    22: YM_DATA2        equ $A04003     ; YM2612 Part II data
                            	    23: PSG_PORT        equ $C00011     ; SN76489 PSG data
                            	    24: 
                            	    25: ;----------------------------------------------------------------------
                            	    26: ; Shadow APU registers ($FF0A00–$FF0A15)
                            	    27: ; Clear of NES RAM ($FF0000-$FF07FF), PPU/MMC1 ($FF0800-$FF083F),
                            	    28: ; H-int queue ($FF0816-$FF081F), forensics ($FF0900-$FF0943).
                            	    29: ;----------------------------------------------------------------------
                            	    30: APU_SH_BASE     equ $FF0A00
                            	    31: APU_SH_4000     equ APU_SH_BASE+$00    ; Pulse 1 duty/volume
                            	    32: APU_SH_4001     equ APU_SH_BASE+$01    ; Pulse 1 sweep (unused)
                            	    33: APU_SH_4002     equ APU_SH_BASE+$02    ; Pulse 1 period low
                            	    34: APU_SH_4003     equ APU_SH_BASE+$03    ; Pulse 1 period high + length
                            	    35: APU_SH_4004     equ APU_SH_BASE+$04    ; Pulse 2 duty/volume
                            	    36: APU_SH_4005     equ APU_SH_BASE+$05    ; Pulse 2 sweep (unused)
                            	    37: APU_SH_4006     equ APU_SH_BASE+$06    ; Pulse 2 period low
                            	    38: APU_SH_4007     equ APU_SH_BASE+$07    ; Pulse 2 period high + length
                            	    39: APU_SH_4008     equ APU_SH_BASE+$08    ; Triangle linear counter
                            	    40: APU_SH_400A     equ APU_SH_BASE+$0A    ; Triangle period low
                            	    41: APU_SH_400B     equ APU_SH_BASE+$0B    ; Triangle period high + length
                            	    42: APU_SH_400C     equ APU_SH_BASE+$0C    ; Noise volume/envelope
                            	    43: APU_SH_400E     equ APU_SH_BASE+$0E    ; Noise mode + period
                            	    44: APU_SH_400F     equ APU_SH_BASE+$0F    ; Noise length counter
                            	    45: APU_SH_4015     equ APU_SH_BASE+$10    ; Channel enable flags
                            	    46: 
                            	    47: ;----------------------------------------------------------------------
                            	    48: ; Frequency conversion constants
                            	    49: ;
                            	    50: ; NES pulse:    f = CPU_CLK / (16 * (P+1)),   CPU_CLK = 1,789,773
                            	    51: ; NES triangle: f = CPU_CLK / (32 * (P+1))    (one octave lower)
                            	    52: ; YM2612:       f = (F_num * 2^block * YM_CLK) / (144 * 2^20)
                            	    53: ;                   YM_CLK = 7,670,453
                            	    54: ;
                            	    55: ; K_pulse = CPU_CLK * 144 * 2^20 / (16 * YM_CLK) ≈ 4,403,410
                            	    56: ; K5_pulse = K_pulse >> 5 = 137,606    (base block = 5)
                            	    57: ; K5_tri   = K5_pulse / 2 = 68,803     (triangle is one octave below pulse)
                            	    58: ;
                            	    59: ; Sanity check: NES A4 (P=253, P+1=254) → K5/254 = 541.75
                            	    60: ;               Standard YM2612 F_num for A4 at block 5 = 541. ✓
                            	    61: ;----------------------------------------------------------------------
                            	    62: NES_YM_K5_PULSE equ 137606
                            	    63: NES_YM_K5_TRI   equ 68803
                            	    64: 
                            	    65: ;==============================================================================
                            	    66: ; ym_write1 — Write one register to YM2612 Part I
                            	    67: ;
                            	    68: ; Input:  D0.b = register address
                            	    69: ;         D1.b = data value
                            	    70: ; Output: none
                            	    71: ; Preserves: all registers
                            	    72: ;
                            	    73: ; SR lockout: the address+data pair MUST go out as an atomic latched write.
                            	    74: ; With the HBlank-driven DMC streamer enabled, the HINT handler also writes
                            	    75: ; $2A + data to YM2612 Part I; if it preempts between our address write and
                            	    76: ; data write, the YM latch is left pointing at $2A and our subsequent data
                            	    77: ; byte lands in the DAC instead of the intended register.  Mask HINT (level
                            	    78: ; 4) for the duration of the pair by raising SR interrupt level to 6, then
                            	    79: ; restore the caller's SR on exit.  Cost: ~16 cycles per call.
                            	    80: ;==============================================================================
                            	    81: ym_write1:
02:00000370 40E7            	    82:     move.w  SR,-(SP)                ; save caller's SR
02:00000372 007C0600        	    83:     ori.w   #$0600,SR               ; mask HINT (level 4) + its below
                            	    84: .wait:
02:00000376 4A3900A04000    	    85:     tst.b   (YM_ADDR1).l            ; bit 7 = busy flag
02:0000037C 6BF8            	    86:     bmi.s   .wait
02:0000037E 13C000A04000    	    87:     move.b  D0,(YM_ADDR1).l         ; write register address
02:00000384 4E71            	    88:     nop                              ; address setup delay
02:00000386 4E71            	    89:     nop
02:00000388 4E71            	    90:     nop
02:0000038A 13C100A04001    	    91:     move.b  D1,(YM_DATA1).l         ; write data
02:00000390 46DF            	    92:     move.w  (SP)+,SR                ; restore SR (re-enables HINT)
02:00000392 4E75            	    93:     rts
                            	    94: 
                            	    95: ;==============================================================================
                            	    96: ; ym_write2 — Write one register to YM2612 Part II
                            	    97: ;
                            	    98: ; Used for ch 4-5 regs and ch 6 pan ($B4+2 = $B6 on Part II).  The busy flag
                            	    99: ; is shared across both parts so we still poll Part I.  Same SR lockout as
                            	   100: ; ym_write1 to prevent HINT-based DMC streamer from stomping the latch.
                            	   101: ;
                            	   102: ; Input:  D0.b = register address
                            	   103: ;         D1.b = data value
                            	   104: ; Output: none
                            	   105: ; Preserves: all registers
                            	   106: ;==============================================================================
                            	   107: ym_write2:
02:00000394 40E7            	   108:     move.w  SR,-(SP)
02:00000396 007C0600        	   109:     ori.w   #$0600,SR
                            	   110: .wait:
02:0000039A 4A3900A04000    	   111:     tst.b   (YM_ADDR1).l            ; busy flag is shared between parts
02:000003A0 6BF8            	   112:     bmi.s   .wait
02:000003A2 13C000A04002    	   113:     move.b  D0,(YM_ADDR2).l         ; write register address (Part II)
02:000003A8 4E71            	   114:     nop
02:000003AA 4E71            	   115:     nop
02:000003AC 4E71            	   116:     nop
02:000003AE 13C100A04003    	   117:     move.b  D1,(YM_DATA2).l         ; write data (Part II)
02:000003B4 46DF            	   118:     move.w  (SP)+,SR
02:000003B6 4E75            	   119:     rts
                            	   120: 
                            	   121: ;==============================================================================
                            	   122: ; nes_to_ym_freq — Convert NES 11-bit period to YM2612 frequency
                            	   123: ;
                            	   124: ; Input:  D2.w = 11-bit NES period (0–2047)
                            	   125: ;         D3.l = K constant (NES_YM_K5_PULSE or NES_YM_K5_TRI)
                            	   126: ; Output: D2.b = A4 register value (block<<3 | F_num bits 10:8)
                            	   127: ;         D3.b = A0 register value (F_num bits 7:0)
                            	   128: ; Destroys: D4, D5
                            	   129: ;==============================================================================
                            	   130: nes_to_ym_freq:
02:000003B8 5242            	   131:     addq.w  #1,D2                   ; D2 = P + 1
02:000003BA B47C0002        	   132:     cmp.w   #2,D2
02:000003BE 6532            	   133:     blo.s   .silence                ; period 0 → silence
02:000003C0 86C2            	   134:     divu    D2,D3                   ; D3.l / D2.w → quotient in D3.w
02:000003C2 692E            	   135:     bvs.s   .silence                ; overflow safety
02:000003C4 3A03            	   136:     move.w  D3,D5                   ; D5 = raw quotient = F_num at block 5
02:000003C6 7805            	   137:     moveq   #5,D4                   ; starting block (K was pre-shifted by 5)
                            	   138: .norm:
02:000003C8 BA7C07FF        	   139:     cmp.w   #2047,D5
02:000003CC 630C            	   140:     bls.s   .done                   ; F_num fits in 11 bits
02:000003CE E24D            	   141:     lsr.w   #1,D5                   ; halve F_num
02:000003D0 5204            	   142:     addq.b  #1,D4                   ; increment block
02:000003D2 B83C0007        	   143:     cmp.b   #7,D4
02:000003D6 6210            	   144:     bhi.s   .clamp                  ; block overflow → clamp
02:000003D8 60EE            	   145:     bra.s   .norm
                            	   146: .done:
                            	   147:     ; D5.w = F_num (0–2047), D4.b = block (0–7)
02:000003DA 1404            	   148:     move.b  D4,D2
02:000003DC E70A            	   149:     lsl.b   #3,D2                   ; block << 3
02:000003DE 3605            	   150:     move.w  D5,D3
02:000003E0 E04B            	   151:     lsr.w   #8,D3                   ; F_num >> 8 = high 3 bits
02:000003E2 8403            	   152:     or.b    D3,D2                   ; D2.b = (block<<3) | F_num_high
02:000003E4 1605            	   153:     move.b  D5,D3                   ; D3.b = F_num_low
02:000003E6 4E75            	   154:     rts
                            	   155: .clamp:
                            	   156:     ; Frequency too high for YM2612 — clamp to max
02:000003E8 143C003F        	   157:     move.b  #$3F,D2                 ; block 7, F_num high = 7
02:000003EC 163C00FF        	   158:     move.b  #$FF,D3                 ; F_num low = $FF → F_num = 2047
02:000003F0 4E75            	   159:     rts
                            	   160: .silence:
02:000003F2 7400            	   161:     moveq   #0,D2
02:000003F4 7600            	   162:     moveq   #0,D3
02:000003F6 4E75            	   163:     rts
                            	   164: 
                            	   165: ;==============================================================================
                            	   166: ; load_fm_patch — Load a 25-byte FM patch into a YM2612 channel
                            	   167: ;
                            	   168: ; Input:  A0 = pointer to 25-byte patch data
                            	   169: ;         D6.b = channel (0, 1, or 2)
                            	   170: ; Output: none
                            	   171: ; Preserves: D0-D6, A0-A1 (saved/restored internally)
                            	   172: ;==============================================================================
                            	   173: load_fm_patch:
02:000003F8 48E7E0C0        	   174:     movem.l D0-D2/A0-A1,-(SP)
02:000003FC 43FA0172        	   175:     lea     FM_PATCH_REGS(PC),A1
02:00000400 7418            	   176:     moveq   #24,D2                  ; 25 register/value pairs
                            	   177: .loop:
02:00000402 1019            	   178:     move.b  (A1)+,D0                ; register base address
02:00000404 D006            	   179:     add.b   D6,D0                   ; + channel offset (0/1/2)
02:00000406 1218            	   180:     move.b  (A0)+,D1                ; data value
02:00000408 6100FF66        	   181:     bsr     ym_write1
02:0000040C 51CAFFF4        	   182:     dbra    D2,.loop
02:00000410 4CDF0307        	   183:     movem.l (SP)+,D0-D2/A0-A1
02:00000414 4E75            	   184:     rts
                            	   185: 
                            	   186: ;==============================================================================
                            	   187: ; audio_init — Initialize YM2612 and PSG for NES audio emulation
                            	   188: ;
                            	   189: ; Called once during boot. Sets up FM patches and mutes all channels.
                            	   190: ; Preserves: A4, A5, D7 (NES register shadows)
                            	   191: ;==============================================================================
                            	   192: audio_init:
02:00000416 48E7FE80        	   193:     movem.l D0-D6/A0,-(SP)
                            	   194: 
                            	   195:     ;------------------------------------------------------------------
                            	   196:     ; Key-off all 6 YM2612 channels
                            	   197:     ;------------------------------------------------------------------
02:0000041A 103C0028        	   198:     move.b  #$28,D0                 ; Key on/off register
02:0000041E 7200            	   199:     moveq   #0,D1
02:00000420 6100FF4E        	   200:     bsr     ym_write1               ; ch 0 off
02:00000424 123C0001        	   201:     move.b  #$01,D1
02:00000428 6100FF46        	   202:     bsr     ym_write1               ; ch 1 off
02:0000042C 123C0002        	   203:     move.b  #$02,D1
02:00000430 6100FF3E        	   204:     bsr     ym_write1               ; ch 2 off
02:00000434 123C0004        	   205:     move.b  #$04,D1
02:00000438 6100FF36        	   206:     bsr     ym_write1               ; ch 4 off (Part II)
02:0000043C 123C0005        	   207:     move.b  #$05,D1
02:00000440 6100FF2E        	   208:     bsr     ym_write1               ; ch 5 off
02:00000444 123C0006        	   209:     move.b  #$06,D1
02:00000448 6100FF26        	   210:     bsr     ym_write1               ; ch 6 off
                            	   211: 
                            	   212:     ;------------------------------------------------------------------
                            	   213:     ; DMC scaffold (Phase C): enable YM2612 DAC on ch 6 and unmute its
                            	   214:     ; pan register so PCM bytes streamed to reg $2A become audible.
                            	   215:     ;
                            	   216:     ; $2B bit 7 = DAC enable (replaces ch 6's FM synth path).  We also
                            	   217:     ; write a center value ($80) to $2A so the DAC sits at mid-scale
                            	   218:     ; until dmc_feed starts pushing real samples.  $B6 (Part II) is ch 6
                            	   219:     ; pan/AMS/PMS — $C0 enables both L+R outputs.
                            	   220:     ;------------------------------------------------------------------
02:0000044C 103C002B        	   221:     move.b  #$2B,D0                 ; DAC enable register
02:00000450 123C0080        	   222:     move.b  #$80,D1                 ; bit 7 = DAC on
02:00000454 6100FF1A        	   223:     bsr     ym_write1
02:00000458 103C002A        	   224:     move.b  #$2A,D0                 ; DAC data
02:0000045C 123C0080        	   225:     move.b  #$80,D1                 ; center value = silence
02:00000460 6100FF0E        	   226:     bsr     ym_write1
02:00000464 103C00B6        	   227:     move.b  #$B6,D0                 ; ch 6 pan/AMS/PMS (Part II)
02:00000468 123C00C0        	   228:     move.b  #$C0,D1                 ; L+R enabled
02:0000046C 6100FF26        	   229:     bsr     ym_write2
                            	   230: 
                            	   231:     ;------------------------------------------------------------------
                            	   232:     ; LFO off (register $22 = 0)
                            	   233:     ;------------------------------------------------------------------
02:00000470 103C0022        	   234:     move.b  #$22,D0
02:00000474 7200            	   235:     moveq   #0,D1
02:00000476 6100FEF8        	   236:     bsr     ym_write1
                            	   237: 
                            	   238:     ;------------------------------------------------------------------
                            	   239:     ; Clear SSG-EG for every operator on ch 0, 1, 2 ($90-$9E on Part I).
                            	   240:     ;
                            	   241:     ; The YM2612 SSG-EG register per operator has no power-on guarantee
                            	   242:     ; on Genesis hardware and may hold leftover state across soft resets.
                            	   243:     ; If bit 3 (SSG enable) is set, the envelope generator runs in a
                            	   244:     ; sawtooth/square-like "SSG mode" that produces an audible buzz or
                            	   245:     ; hiss alongside the clean FM output — we were hearing that on ch 1
                            	   246:     ; (Voice $00 pad) and ch 2 (Voice $07 bass).
                            	   247:     ;
                            	   248:     ; Zero-ing $90+op+ch for all 4 operators on each used channel puts
                            	   249:     ; every envelope generator back in standard mode.  12 writes total.
                            	   250:     ;------------------------------------------------------------------
02:0000047A 7200            	   251:     moveq   #0,D1                   ; data = 0 for all
02:0000047C 103C0090        	   252:     move.b  #$90,D0                 ; slot1 ch0
02:00000480 6100FEEE        	   253:     bsr     ym_write1
02:00000484 103C0091        	   254:     move.b  #$91,D0                 ; slot1 ch1
02:00000488 6100FEE6        	   255:     bsr     ym_write1
02:0000048C 103C0092        	   256:     move.b  #$92,D0                 ; slot1 ch2
02:00000490 6100FEDE        	   257:     bsr     ym_write1
02:00000494 103C0094        	   258:     move.b  #$94,D0                 ; slot3 ch0
02:00000498 6100FED6        	   259:     bsr     ym_write1
02:0000049C 103C0095        	   260:     move.b  #$95,D0                 ; slot3 ch1
02:000004A0 6100FECE        	   261:     bsr     ym_write1
02:000004A4 103C0096        	   262:     move.b  #$96,D0                 ; slot3 ch2
02:000004A8 6100FEC6        	   263:     bsr     ym_write1
02:000004AC 103C0098        	   264:     move.b  #$98,D0                 ; slot2 ch0
02:000004B0 6100FEBE        	   265:     bsr     ym_write1
02:000004B4 103C0099        	   266:     move.b  #$99,D0                 ; slot2 ch1
02:000004B8 6100FEB6        	   267:     bsr     ym_write1
02:000004BC 103C009A        	   268:     move.b  #$9A,D0                 ; slot2 ch2
02:000004C0 6100FEAE        	   269:     bsr     ym_write1
02:000004C4 103C009C        	   270:     move.b  #$9C,D0                 ; slot4 ch0
02:000004C8 6100FEA6        	   271:     bsr     ym_write1
02:000004CC 103C009D        	   272:     move.b  #$9D,D0                 ; slot4 ch1
02:000004D0 6100FE9E        	   273:     bsr     ym_write1
02:000004D4 103C009E        	   274:     move.b  #$9E,D0                 ; slot4 ch2
02:000004D8 6100FE96        	   275:     bsr     ym_write1
                            	   276: 
                            	   277:     ;------------------------------------------------------------------
                            	   278:     ; Load EHZ Voice $03 into ch 0 (m_sq1 = NES Sq1 = Pulse 2 = LEAD melody)
                            	   279:     ; NES naming: Sq1/Sq0 are reversed from intuition — Sq1 writes $4006/$4007
                            	   280:     ; (Pulse 2) and owns the primary melody.  Put the snappy EHZ lead here.
                            	   281:     ;------------------------------------------------------------------
02:000004DC 41FA00C6        	   282:     lea     PATCH_VOICE03(PC),A0
02:000004E0 7C00            	   283:     moveq   #0,D6                   ; channel 0 (emit_note_sq1 target)
02:000004E2 6100FF14        	   284:     bsr     load_fm_patch
                            	   285: 
                            	   286:     ;------------------------------------------------------------------
                            	   287:     ; Load EHZ Voice $00 into ch 1 (m_sq0 = NES Sq0 = Pulse 1 = harmony/arp)
                            	   288:     ; The slow-decay pad fits arpeggiated harmony better than a sharp lead.
                            	   289:     ;------------------------------------------------------------------
02:000004E6 41FA00A2        	   290:     lea     PATCH_VOICE00(PC),A0
02:000004EA 7C01            	   291:     moveq   #1,D6                   ; channel 1 (emit_note_sq0 target)
02:000004EC 6100FF0A        	   292:     bsr     load_fm_patch
                            	   293: 
                            	   294:     ;------------------------------------------------------------------
                            	   295:     ; Load EHZ Voice $07 into ch 2 (Triangle — Algorithm 0, bass)
                            	   296:     ;------------------------------------------------------------------
02:000004F0 41FA00CC        	   297:     lea     PATCH_VOICE07(PC),A0
02:000004F4 7C02            	   298:     moveq   #2,D6                   ; channel 2
02:000004F6 6100FF00        	   299:     bsr     load_fm_patch
                            	   300: 
                            	   301:     ;------------------------------------------------------------------
                            	   302:     ; Set panning: both speakers for ch 0–2
                            	   303:     ; Register $B4+ch, data $C0 = L+R output
                            	   304:     ;------------------------------------------------------------------
02:000004FA 103C00B4        	   305:     move.b  #$B4,D0
02:000004FE 123C00C0        	   306:     move.b  #$C0,D1
02:00000502 6100FE6C        	   307:     bsr     ym_write1               ; ch 0 panning
02:00000506 103C00B5        	   308:     move.b  #$B5,D0
02:0000050A 6100FE64        	   309:     bsr     ym_write1               ; ch 1 panning
02:0000050E 103C00B6        	   310:     move.b  #$B6,D0
02:00000512 6100FE5C        	   311:     bsr     ym_write1               ; ch 2 panning
                            	   312: 
                            	   313:     ;------------------------------------------------------------------
                            	   314:     ; (Phase E polish: the Phase-C FM isolation mute that forced every
                            	   315:     ; operator TL to $7F has been removed — FM music plays again alongside
                            	   316:     ; the DMC DAC stream now that HBlank-driven non-blocking playback is
                            	   317:     ; in place.  Patches loaded by load_fm_patch above already set the
                            	   318:     ; authoritative TL bytes for each voice.)
                            	   319:     ;------------------------------------------------------------------
                            	   320: 
                            	   321:     ;------------------------------------------------------------------
                            	   322:     ; Mute all 4 PSG channels (attenuation = $F = maximum)
                            	   323:     ;------------------------------------------------------------------
02:00000516 13FC009F00C00011	   324:     move.b  #$9F,(PSG_PORT).l       ; Tone 1 mute
02:0000051E 13FC00BF00C00011	   325:     move.b  #$BF,(PSG_PORT).l       ; Tone 2 mute
02:00000526 13FC00DF00C00011	   326:     move.b  #$DF,(PSG_PORT).l       ; Tone 3 mute
02:0000052E 13FC00FF00C00011	   327:     move.b  #$FF,(PSG_PORT).l       ; Noise mute
                            	   328: 
                            	   329:     ;------------------------------------------------------------------
                            	   330:     ; Clear shadow APU registers
                            	   331:     ;------------------------------------------------------------------
02:00000536 41F900FF0A00    	   332:     lea     (APU_SH_BASE).l,A0
02:0000053C 7008            	   333:     moveq   #($11/2),D0            ; 18 bytes / 2 = 9 words (round up)
                            	   334: .clr:
02:0000053E 4258            	   335:     clr.w   (A0)+
02:00000540 51C8FFFC        	   336:     dbra    D0,.clr
                            	   337: 
                            	   338:     ;------------------------------------------------------------------
                            	   339:     ; Clear native music player state
                            	   340:     ;------------------------------------------------------------------
02:00000544 41F900FFE000    	   341:     lea     (MUSIC_BASE).l,A0
02:0000054A 700F            	   342:     moveq   #(MUSIC_STATE_SIZE/4)-1,D0
                            	   343: .clr_music:
02:0000054C 4298            	   344:     clr.l   (A0)+
02:0000054E 51C8FFFC        	   345:     dbra    D0,.clr_music
                            	   346: 
                            	   347:     ;------------------------------------------------------------------
                            	   348:     ; Clear DMC state block ($FFE100, 17 bytes — rounded to 20).  Zero
                            	   349:     ; dmc_active, dmc_burst, dmc_ptr, dmc_remain, shadow registers, and
                            	   350:     ; debug scaffold state.
                            	   351:     ;------------------------------------------------------------------
02:00000552 41F900FFE100    	   352:     lea     (DMC_BASE).l,A0
02:00000558 4298            	   353:     clr.l   (A0)+                   ; active + burst
02:0000055A 4298            	   354:     clr.l   (A0)+                   ; dmc_ptr
02:0000055C 4298            	   355:     clr.l   (A0)+                   ; dmc_remain
02:0000055E 4298            	   356:     clr.l   (A0)+                   ; rate/addr/len sel + prev_btn
02:00000560 4298            	   357:     clr.l   (A0)+                   ; dbg_next + pad (over-clear, safe)
                            	   358:     ;------------------------------------------------------------------
                            	   359:     ; Scaffold: preload dmc_dbg_next = 1 so the first Start press fires
                            	   360:     ; sample #1.  dmc_trigger wraps 1..7 from there.
                            	   361:     ;------------------------------------------------------------------
02:00000562 13FC000100FFE110	   362:     move.b  #1,(dmc_dbg_next).l
                            	   363: 
02:0000056A 4CDF017F        	   364:     movem.l (SP)+,D0-D6/A0
02:0000056E 4E75            	   365:     rts
                            	   366: 
                            	   367: ;==============================================================================
                            	   368: ; FM Patch Register Address Table
                            	   369: ;
                            	   370: ; 25 register base addresses (add channel 0/1/2 for target channel).
                            	   371: ; Order matches the 25 data bytes in each PATCH_VOICExx block.
                            	   372: ;==============================================================================
                            	   373:     even
                            	   374: FM_PATCH_REGS:
02:00000570 B0              	   375:     dc.b    $B0                     ; FB/ALG
02:00000571 30              	   376:     dc.b    $30,$34,$38,$3C         ; DT1/MUL (slot1,slot3,slot2,slot4)
02:00000572 34
02:00000573 38
02:00000574 3C
02:00000575 50              	   377:     dc.b    $50,$54,$58,$5C         ; RS/AR
02:00000576 54
02:00000577 58
02:00000578 5C
02:00000579 60              	   378:     dc.b    $60,$64,$68,$6C         ; AM/D1R
02:0000057A 64
02:0000057B 68
02:0000057C 6C
02:0000057D 70              	   379:     dc.b    $70,$74,$78,$7C         ; D2R
02:0000057E 74
02:0000057F 78
02:00000580 7C
02:00000581 80              	   380:     dc.b    $80,$84,$88,$8C         ; DL/RR
02:00000582 84
02:00000583 88
02:00000584 8C
02:00000585 40              	   381:     dc.b    $40,$44,$48,$4C         ; TL
02:00000586 44
02:00000587 48
02:00000588 4C
                            	   382:     even
                            	   383: 
                            	   384: ;==============================================================================
                            	   385: ; FM Patch Data — Sonic 2 Emerald Hill Zone voices
                            	   386: ;
                            	   387: ; 25 bytes each.  Canonical Sonic 2 voice format from sonicretro/s2disasm
                            	   388: ; sound/music/82 - EHZ.asm (label EHZ_Voices):
                            	   389: ;
                            	   390: ;   byte 0      : FB/ALG (feedback<<3 | algorithm)
                            	   391: ;   bytes 1-4   : DT/MUL  — operators in slot order: op1, op3, op2, op4
                            	   392: ;   bytes 5-8   : RS/AR    "
                            	   393: ;   bytes 9-12  : AM/D1R   "
                            	   394: ;   bytes 13-16 : D2R      "
                            	   395: ;   bytes 17-20 : DL/RR    "
                            	   396: ;   bytes 21-24 : TL       "
                            	   397: ;
                            	   398: ; The slot order op1,op3,op2,op4 matches YM2612 register offsets 0,4,8,C in
                            	   399: ; FM_PATCH_REGS, so the bytes stream directly to the right operator slots
                            	   400: ; without any reordering in load_fm_patch.
                            	   401: ;
                            	   402: ; NOTE: the original SMPS driver uses bit 7 ($80) on TL bytes as an "absolute,
                            	   403: ; do not add channel volume" flag — it masks bit 7 before writing and channel
                            	   404: ; volume is added for operators without the flag.  We have no per-channel
                            	   405: ; volume, so we translate $80 directly to a safe carrier TL of $18 (matching
                            	   406: ; Voice $03's proven-clean carrier level) and keep the authoritative
                            	   407: ; modulator TL bytes as-is.
                            	   408: ;
                            	   409: ; ym_trace.lua (2026-04-10) proved the driver was writing these bytes
                            	   410: ; verbatim to the YM2612.  A prior transcription of Voice $00 and Voice $07
                            	   411: ; had the middle two bytes of DT/MUL, RS/AR, AM/D1R, and TL swapped — putting
                            	   412: ; op2's parameters onto op3 and vice versa.  On Voice $03 the middle values
                            	   413: ; are near-symmetric so the swap is inaudible; on Voices $00 and $07 the
                            	   414: ; middle values differ enough that the swap produced cross-wired FM
                            	   415: ; modulation = sustained "crunchy buzz" on both channels.  Restored to the
                            	   416: ; authoritative byte order here.
                            	   417: ;==============================================================================
                            	   418: 
                            	   419: ; Voice $00 — Bell-like pad.
                            	   420: ;
                            	   421: ; Classic FM bell recipe:
                            	   422: ;   Alg 5 (3 carriers modulated by op1)
                            	   423: ;   FB 5 for brightness without the FB 7 "hard bite"
                            	   424: ;   Op1 MUL 4 → produces inharmonic overtones at 4x the carrier pitch,
                            	   425: ;     which is what gives bells their characteristic "chime" quality
                            	   426: ;   Op1 TL $14 → modulator loud enough to shape the bell spectrum
                            	   427: ;   Carriers at MUL 1, tuned unison (no detune beating)
                            	   428: ;   Fast attack, medium D1R, low DL, slow RR = bell strike + sustain tail
                            	   429: PATCH_VOICE00:
02:0000058A 2D              	   430:     dc.b    $2D                     ; FB/ALG: (5<<3)|5 — FB 5 bell pad
02:0000058B 04              	   431:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:0000058C 01
02:0000058D 01
02:0000058E 01
02:0000058F 1F              	   432:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:00000590 1F
02:00000591 1F
02:00000592 1F
02:00000593 08              	   433:     dc.b    $08,$04,$04,$04         ; AM/D1R — bell-decay shape
02:00000594 04
02:00000595 04
02:00000596 04
02:00000597 00              	   434:     dc.b    $00,$00,$00,$00         ; D2R
02:00000598 00
02:00000599 00
02:0000059A 00
02:0000059B 47              	   435:     dc.b    $47,$37,$37,$17         ; DL 4/3 + RR 7/7/7/7 — bell tail
02:0000059C 37
02:0000059D 37
02:0000059E 17
02:0000059F 14              	   436:     dc.b    $14,$1E,$1E,$1E         ; TL — op1 mod loud ($14), carriers quieter ($1E)
02:000005A0 1E
02:000005A1 1E
02:000005A2 1E
                            	   437:     even
                            	   438: 
                            	   439: ; Voice $03 — EHZ FM3 opening voice (iconic lead)
                            	   440: ; Algorithm 5 (slots 2,3,4 are carriers), Feedback 7
                            	   441: PATCH_VOICE03:
02:000005A4 3D              	   442:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:000005A5 01              	   443:     dc.b    $01,$51,$21,$01         ; DT/MUL
02:000005A6 51
02:000005A7 21
02:000005A8 01
02:000005A9 1F              	   444:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR (max — EHZ's slow-attack swell was delaying Zelda's Pulse 2 melody)
02:000005AA 1F
02:000005AB 1F
02:000005AC 1F
02:000005AD 0A              	   445:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:000005AE 05
02:000005AF 05
02:000005B0 05
02:000005B1 00              	   446:     dc.b    $00,$00,$00,$00         ; D2R
02:000005B2 00
02:000005B3 00
02:000005B4 00
02:000005B5 2B              	   447:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
02:000005B6 2B
02:000005B7 2B
02:000005B8 1B
02:000005B9 19              	   448:     dc.b    $19,$18,$18,$18         ; TL (slot1=modulator $19; slots 2/3/4 carriers +$18 for mix)
02:000005BA 18
02:000005BB 18
02:000005BC 18
                            	   449:     even
                            	   450: 
                            	   451: ; Voice $07 — Clean bass.
                            	   452: ;
                            	   453: ; Pure sine-ish bass: Alg 5, low FB, all operators at MUL 1 with no detune.
                            	   454: ; This is the cleanest possible FM bass — no harmonics beyond what the fun-
                            	   455: ; damental already provides.  Moderately quiet so it supports the lead
                            	   456: ; without fighting it.
                            	   457: PATCH_VOICE07:
02:000005BE 0D              	   458:     dc.b    $0D                     ; FB/ALG: (1<<3)|5 — FB 1 (minimal grit)
02:000005BF 01              	   459:     dc.b    $01,$01,$01,$01         ; DT/MUL — unison, no beating
02:000005C0 01
02:000005C1 01
02:000005C2 01
02:000005C3 1F              	   460:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
02:000005C4 1F
02:000005C5 1F
02:000005C6 1F
02:000005C7 0A              	   461:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:000005C8 05
02:000005C9 05
02:000005CA 05
02:000005CB 00              	   462:     dc.b    $00,$00,$00,$00         ; D2R
02:000005CC 00
02:000005CD 00
02:000005CE 00
02:000005CF 28              	   463:     dc.b    $28,$28,$28,$18         ; DL 2 / RR 8 — bass punch
02:000005D0 28
02:000005D1 28
02:000005D2 18
02:000005D3 22              	   464:     dc.b    $22,$20,$20,$20         ; TL — moderately quiet (less than 27.81's $28)
02:000005D4 20
02:000005D5 20
02:000005D6 20
                            	   465:     even
                            	   466: 
                            	   467: ;==============================================================================
                            	   468: ;==============================================================================
                            	   469: ; NATIVE M68K MUSIC PLAYER
                            	   470: ;
                            	   471: ; Ports the NES Zelda DriveSong engine verbatim, reading the same script
                            	   472: ; opcodes but emitting YM2612/PSG writes instead of NES APU writes.
                            	   473: ;
                            	   474: ; State lives at $FF0B00.  Song data is pulled from the contiguous
                            	   475: ; MusicBlob (SongTable + 9 song headers + 9 song scripts, 2757 bytes)
                            	   476: ; loaded at label MusicBlob.  NES CPU addresses in song headers are
                            	   477: ; converted to M68K pointers via (nes_addr - MUSIC_BLOB_NES_BASE) + MusicBlob.
                            	   478: ;==============================================================================
                            	   479: ;==============================================================================
                            	   480: 
                            	   481: ;----------------------------------------------------------------------
                            	   482: ; Music state RAM ($FF0B00-$FF0B3F, 64 bytes)
                            	   483: ;----------------------------------------------------------------------
                            	   484: ; ============================================================================
                            	   485: ; MUSIC_BASE must be OUTSIDE the NES RAM mirror range.
                            	   486: ; Real NES mirrors its 2 KB RAM through $0000-$1FFF, so any transpiled access
                            	   487: ; through a pointer in zero-page that lands in $0800-$1FFF on 6502 will on our
                            	   488: ; M68K map hit $FF0800-$FF1FFF directly (transpiler does not wrap mirrors).
                            	   489: ; $FF0B00 got continuously clobbered by such accesses during the intro.
                            	   490: ; $FFE000 is safely past $FF1FFF and well below the stack at $FFFFFE.
                            	   491: ; ============================================================================
                            	   492: MUSIC_BASE          equ $FFE000
                            	   493: MUSIC_STATE_SIZE    equ $40
                            	   494: 
                            	   495: m_song              equ MUSIC_BASE+$00  ; current song bitmap
                            	   496: m_song_req          equ MUSIC_BASE+$01  ; requested song change
                            	   497: m_phrase            equ MUSIC_BASE+$02  ; current phrase index
                            	   498: m_len_base          equ MUSIC_BASE+$03  ; note length table base
                            	   499: m_env_sel           equ MUSIC_BASE+$04  ; envelope selector
                            	   500: m_mystery           equ MUSIC_BASE+$05  ; header byte 7 ($05F1 equiv)
                            	   501: m_noise_first       equ MUSIC_BASE+$06  ; noise loop start
                            	   502: m_script_ptr        equ MUSIC_BASE+$08  ; long: M68K pointer to script base
                            	   503: 
                            	   504: ; Sq1 (Pulse 1 → YM ch 0)
                            	   505: m_sq1_off           equ MUSIC_BASE+$0C
                            	   506: m_sq1_cnt           equ MUSIC_BASE+$0D
                            	   507: m_sq1_len           equ MUSIC_BASE+$0E
                            	   508: m_sq1_vib           equ MUSIC_BASE+$0F
                            	   509: m_sq1_per           equ MUSIC_BASE+$10
                            	   510: 
                            	   511: ; Sq0 (Pulse 2 → YM ch 1)
                            	   512: m_sq0_off           equ MUSIC_BASE+$14
                            	   513: m_sq0_cnt           equ MUSIC_BASE+$15
                            	   514: m_sq0_len           equ MUSIC_BASE+$16
                            	   515: m_sq0_vib           equ MUSIC_BASE+$17
                            	   516: m_sq0_per           equ MUSIC_BASE+$18
                            	   517: 
                            	   518: ; Triangle (→ YM ch 2)
                            	   519: m_trg_off           equ MUSIC_BASE+$1C
                            	   520: m_trg_cnt           equ MUSIC_BASE+$1D
                            	   521: m_trg_len           equ MUSIC_BASE+$1E
                            	   522: m_trg_vib           equ MUSIC_BASE+$1F
                            	   523: m_trg_per           equ MUSIC_BASE+$20
                            	   524: m_trg_rep_n         equ MUSIC_BASE+$21
                            	   525: m_trg_rep_s         equ MUSIC_BASE+$22
                            	   526: 
                            	   527: ; Noise (→ PSG ch 3)
                            	   528: m_noise_off         equ MUSIC_BASE+$24
                            	   529: m_noise_cnt         equ MUSIC_BASE+$25
                            	   530: ; Software ADSR state for the PSG noise drum channel (Kroc Sonic 1 SMS pattern).
                            	   531: ; SN76489 has no envelope hardware, so we run a linear software envelope and
                            	   532: ; map it to the 4-bit PSG attenuation every frame.  Writing the noise control
                            	   533: ; register resets the LFSR, so we also cache the last-written control byte and
                            	   534: ; skip redundant writes to preserve the decay tail.
                            	   535: m_noise_level       equ MUSIC_BASE+$26  ; byte: current envelope level ($00-$FF)
                            	   536: m_noise_decay       equ MUSIC_BASE+$27  ; byte: current linear decay rate (per tick)
                            	   537: m_last_psg_nc       equ MUSIC_BASE+$28  ; byte: last noise-control byte written
                            	   538: 
                            	   539: ; Noise-SFX shadow state. Zelda's PlaySfxNote writes $400E/$400C/$400F
                            	   540: ; per sfx-tick. The first two cache here; $400F is the per-hit trigger.
                            	   541: m_sfx_vol           equ MUSIC_BASE+$29  ; byte: last $400C byte
                            	   542: m_sfx_ctrl_raw      equ MUSIC_BASE+$2A  ; byte: last $400E byte
                            	   543: 
                            	   544: ;----------------------------------------------------------------------
                            	   545: ; DMC → YM2612 DAC state (Phase A of DMC port — see
                            	   546: ; C:\Users\Jake Diggity\.claude\plans\quirky-baking-goose.md).
                            	   547: ;
                            	   548: ; Lives at $FFE100, clear of the music-state block at $FFE000-$FFE03F.
                            	   549: ; Written by the DMC APU stubs in nes_io.asm, consumed by dmc_feed which
                            	   550: ; runs at the tail of music_tick and bursts PCM bytes to YM reg $2A.
                            	   551: ;----------------------------------------------------------------------
                            	   552: DMC_BASE            equ $FFE100
                            	   553: dmc_active          equ DMC_BASE+$00    ; byte: 0 = idle, 1 = playing
                            	   554: dmc_last_idx        equ DMC_BASE+$01    ; byte: last triggered sample index (for HUD)
                            	   555: dmc_ptr             equ DMC_BASE+$04    ; long: current M68K pointer into PCM blob
                            	   556: dmc_remain          equ DMC_BASE+$08    ; long: PCM bytes left in current sample
                            	   557: dmc_rate_sel        equ DMC_BASE+$0C    ; byte: shadow of last $4010 write
                            	   558: dmc_addr_sel        equ DMC_BASE+$0D    ; byte: shadow of last $4012 write
                            	   559: dmc_len_sel         equ DMC_BASE+$0E    ; byte: shadow of last $4013 write
                            	   560: dmc_dbg_prev_btn    equ DMC_BASE+$0F    ; byte: pad state from last frame (edge det)
                            	   561: dmc_dbg_next        equ DMC_BASE+$10    ; byte: next sample index (1..7) to trigger
                            	   562: 
                            	   563: ;==============================================================================
                            	   564: ; dmc_trigger — non-blocking HBlank DAC streamer.
                            	   565: ;
                            	   566: ; Samples are pre-processed by tools/extract_dmc_samples.py: proper bandlimited
                            	   567: ; resampling (scipy.signal.resample_poly with Kaiser-window FIR) from native
                            	   568: ; NES rate (21/25/33 kHz) down to the empirically-measured Genesis HINT rate
                            	   569: ; (~8751 Hz with music active). That's where the "crunchy" sound came from
                            	   570: ; before — linear interpolation without anti-alias filter caused aliasing.
                            	   571: ; With proper prefiltered resampling, playback sounds clean even at the lower
                            	   572: ; effective rate, and the game does NOT hitch.
                            	   573: ;==============================================================================
                            	   574: dmc_trigger:
02:000005D8 4A00            	   575:     tst.b   D0
02:000005DA 6762            	   576:     beq.s   .bad
02:000005DC B03C0007        	   577:     cmp.b   #DMC_SAMPLE_COUNT,D0
02:000005E0 625C            	   578:     bhi.s   .bad
02:000005E2 48E7E0C0        	   579:     movem.l D0-D2/A0-A1,-(SP)
02:000005E6 13C000FFE101    	   580:     move.b  D0,(dmc_last_idx).l
02:000005EC 7200            	   581:     moveq   #0,D1
02:000005EE 1200            	   582:     move.b  D0,D1                   ; D1.l = 1-based index
02:000005F0 5381            	   583:     subq.l  #1,D1                   ; 0-based
02:000005F2 D281            	   584:     add.l   D1,D1                   ; idx * 2
02:000005F4 D281            	   585:     add.l   D1,D1                   ; idx * 4
                            	   586: 
02:000005F6 41F9000018F4    	   587:     lea     (DMC_SAMPLE_PCM_OFFS).l,A0
02:000005FC 24301800        	   588:     move.l  (A0,D1.l),D2
02:00000600 43F900005264    	   589:     lea     (DMC_SAMPLE_PCM_BLOB).l,A1
02:00000606 D3C2            	   590:     add.l   D2,A1
                            	   591: 
02:00000608 41F900001910    	   592:     lea     (DMC_SAMPLE_PCM_LENS).l,A0
02:0000060E 24301800        	   593:     move.l  (A0,D1.l),D2
02:00000612 4A82            	   594:     tst.l   D2
02:00000614 6724            	   595:     beq.s   .bad_restore
                            	   596: 
02:00000616 23C900FFE104    	   597:     move.l  A1,(dmc_ptr).l
02:0000061C 23C200FFE108    	   598:     move.l  D2,(dmc_remain).l
02:00000622 13FC000100FFE100	   599:     move.b  #1,(dmc_active).l
                            	   600: 
                            	   601:     ; Arm HBlank every line, enable HINT (preserve colorfix bit).
02:0000062A 33FC8A0000C00004	   602:     move.w  #$8A00,(VDP_CTRL).l     ; Reg 10 = 0 -> fire every line
02:00000632 33FC801400C00004	   603:     move.w  #$8014,(VDP_CTRL).l     ; Reg  0 = $14 -> HINT on + colorfix
                            	   604: .bad_restore:
02:0000063A 4CDF0307        	   605:     movem.l (SP)+,D0-D2/A0-A1
                            	   606: .bad:
02:0000063E 4E75            	   607:     rts
                            	   608: 
                            	   609: ;==============================================================================
                            	   610: ; dmc_hint_tick — per-HBlank PCM byte -> YM2612 reg $2A DAC write.
                            	   611: ;==============================================================================
                            	   612: dmc_hint_tick:
02:00000640 207900FFE104    	   613:     move.l  (dmc_ptr).l,A0
02:00000646 1018            	   614:     move.b  (A0)+,D0
02:00000648 23C800FFE104    	   615:     move.l  A0,(dmc_ptr).l
02:0000064E 41F900A04000    	   616:     lea     (YM_ADDR1).l,A0
                            	   617: .wait:
02:00000654 4A10            	   618:     tst.b   (A0)
02:00000656 6BFC            	   619:     bmi.s   .wait
02:00000658 10BC002A        	   620:     move.b  #$2A,(A0)
02:0000065C 13C000A04001    	   621:     move.b  D0,(YM_DATA1).l
02:00000662 53B900FFE108    	   622:     subq.l  #1,(dmc_remain).l
02:00000668 6702            	   623:     beq.s   .end
02:0000066A 4E75            	   624:     rts
                            	   625: .end:
02:0000066C 41F900A04000    	   626:     lea     (YM_ADDR1).l,A0
                            	   627: .wait2:
02:00000672 4A10            	   628:     tst.b   (A0)
02:00000674 6BFC            	   629:     bmi.s   .wait2
02:00000676 10BC002A        	   630:     move.b  #$2A,(A0)
02:0000067A 13FC008000A04001	   631:     move.b  #$80,(YM_DATA1).l       ; park DAC at mid-rail
02:00000682 423900FFE100    	   632:     clr.b   (dmc_active).l
02:00000688 33FC800400C00004	   633:     move.w  #$8004,(VDP_CTRL).l     ; Reg 0 = $04 -> HINT off, colorfix on
02:00000690 4E75            	   634:     rts
                            	   635: 
                            	   636: ;==============================================================================
                            	   637: ; dmc_feed — legacy VBlank entry point, retained as labeled rts.
                            	   638: ;
                            	   639: ; music_tick used to call this to drain a frame's worth of PCM in VBlank.
                            	   640: ; All streaming now happens from HBlank via dmc_hint_tick.  Kept as a cheap
                            	   641: ; rts so we don't have to surgically delete the call from music_tick.
                            	   642: ;==============================================================================
                            	   643: dmc_feed:
02:00000692 4E75            	   644:     rts
                            	   645: 
                            	   646: ;==============================================================================
                            	   647: ; dmc_dbg_poll - Phase-C/D scaffold (REMOVED in Phase E).
                            	   648: ;
                            	   649: ; Previously watched the NES-format controller latch for a Start rising edge
                            	   650: ; and cycled through the 7 DMC samples.  That scaffold served its purpose at
                            	   651: ; T27/T28 PASS — DMC triggering is now fully driven by the game's own APU
                            	   652: ; $4015 writes via the _apu_write_4015 stub in nes_io.asm (Phase D), and
                            	   653: ; Start has a real game function (exit attract mode).  Polling it here would
                            	   654: ; fire a stray DMC burst every time the player presses Start on the title
                            	   655: ; screen, masking real game audio events.
                            	   656: ;
                            	   657: ; The label is kept as a labeled rts for backward-compat with the call in
                            	   658: ; music_tick, which we'll peel out in a later cleanup pass.
                            	   659: ;==============================================================================
                            	   660: dmc_dbg_poll:
02:00000694 4E75            	   661:     rts
                            	   662: 
                            	   663: ;==============================================================================
                            	   664: ; music_play — request a song change
                            	   665: ; Input: D0.b = song bitmap
                            	   666: ;==============================================================================
                            	   667:     xdef    music_play
                            	   668: music_play:
02:00000696 13C000FFE001    	   669:     move.b  D0,(m_song_req).l
02:0000069C 4E75            	   670:     rts
                            	   671: 
                            	   672: ;==============================================================================
                            	   673: ; music_tick — DriveSong equivalent.  Call once per VBlank.
                            	   674: ;==============================================================================
                            	   675: music_tick:
02:0000069E 48E7FFE0        	   676:     movem.l D0-D7/A0-A2,-(SP)
                            	   677:     ;------------------------------------------------------------------
                            	   678:     ; Phase E polish: FM music path restored.  DMC streams independently
                            	   679:     ; from HBlank via dmc_hint_tick, so the main-thread music tick no
                            	   680:     ; longer needs to stay muted.  ym_write1/2 carry SR lockout so the
                            	   681:     ; HINT-driven DAC streamer can't corrupt the YM2612 latch between
                            	   682:     ; address and data bytes.
                            	   683:     ;
                            	   684:     ; Structure matches the pre-isolation (Zelda27.82) tick: consume
                            	   685:     ; song_req via change_song, otherwise tick_sq1 if a song is playing.
                            	   686:     ; dmc_dbg_poll + dmc_feed run after either path.  dmc_feed is now a
                            	   687:     ; labeled rts — the call costs ~20 cycles total and lets us defer
                            	   688:     ; removing it to a later cleanup pass.
                            	   689:     ;------------------------------------------------------------------
                            	   690:     ; Attract-mode-exit hook: the game's DriveAudio is NOP'd, so the
                            	   691:     ; audio driver's own SilenceSong paths (via DriveTune0 → $0604 bit7
                            	   692:     ; and DriveTune1 → $0602 bit7) never run.  Game logic still writes
                            	   693:     ; the request bytes at state transitions.  The attract-to-file-menu
                            	   694:     ; path (UpdateMode0Demo_Sub0 → SilenceAllSound in z_01.asm:4118)
                            	   695:     ; sets $0604 = $80 and $0603 = $80.  Poll both $0604 and $0602 for
                            	   696:     ; the silence-request bit 7 and route it into native music_silence.
                            	   697:     ; Also clear $0605/$0607 (current-tune shadows) so the game's own
                            	   698:     ; "nothing playing" markers stay coherent with our silenced state.
                            	   699:     ; SongRequest bridge: game writes D0 -> $FF0600 (NES RAM SongRequest) at
                            	   700:     ; every song change (title/gameplay/dungeon/etc.). Forward to m_song_req
                            	   701:     ; and clear the game-side byte so the game's own driver-absent check
                            	   702:     ; ("did my song change get consumed?") stays coherent.
02:000006A2 103900FF0600    	   703:     move.b  ($FF0600).l,D0
02:000006A8 670C            	   704:     beq.s   .no_song_req_bridge
02:000006AA 423900FF0600    	   705:     clr.b   ($FF0600).l
02:000006B0 13C000FFE001    	   706:     move.b  D0,(m_song_req).l
                            	   707: .no_song_req_bridge:
02:000006B6 103900FF0604    	   708:     move.b  ($FF0604).l,D0          ; Tune 0 request (SilenceAllSound)
02:000006BC 6B08            	   709:     bmi.s   .do_silence
02:000006BE 103900FF0602    	   710:     move.b  ($FF0602).l,D0          ; Tune 1 request (silence-then-play)
02:000006C4 6A24            	   711:     bpl.s   .no_silence_req
                            	   712: .do_silence:
02:000006C6 423900FF0602    	   713:     clr.b   ($FF0602).l
02:000006CC 423900FF0603    	   714:     clr.b   ($FF0603).l
02:000006D2 423900FF0604    	   715:     clr.b   ($FF0604).l
02:000006D8 423900FF0605    	   716:     clr.b   ($FF0605).l
02:000006DE 423900FF0607    	   717:     clr.b   ($FF0607).l
02:000006E4 61000676        	   718:     bsr     music_silence
02:000006E8 6024            	   719:     bra.s   .dmc_poll
                            	   720: .no_silence_req:
02:000006EA 103900FFE001    	   721:     move.b  (m_song_req).l,D0
02:000006F0 6710            	   722:     beq.s   .no_req
02:000006F2 423900FFE001    	   723:     clr.b   (m_song_req).l
02:000006F8 13C000FFE000    	   724:     move.b  D0,(m_song).l
02:000006FE 6118            	   725:     bsr     change_song
02:00000700 600C            	   726:     bra.s   .dmc_poll
                            	   727: .no_req:
02:00000702 4A3900FFE000    	   728:     tst.b   (m_song).l
02:00000708 6704            	   729:     beq.s   .dmc_poll
02:0000070A 610001B4        	   730:     bsr     tick_sq1
                            	   731: .dmc_poll:
02:0000070E 6184            	   732:     bsr     dmc_dbg_poll            ; scaffold: Start cycles DMC samples
02:00000710 6180            	   733:     bsr     dmc_feed                ; no-op stub (backward-compat call)
                            	   734:     ; DMC and noise-SFX dispatch paused -- neither produced acceptable
                            	   735:     ; audio yet. Revisit in a future pass. Music + SongRequest bridge
                            	   736:     ; stay wired.
02:00000712 4CDF07FF        	   737:     movem.l (SP)+,D0-D7/A0-A2
02:00000716 4E75            	   738:     rts
                            	   739: 
                            	   740: ;==============================================================================
                            	   741: ; change_song — ported from @ChangeSong
                            	   742: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   743: ;
                            	   744: ; Selects the starting phrase index for the new song, then falls into
                            	   745: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   746: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   747: ;==============================================================================
                            	   748: change_song:
02:00000718 4A00            	   749:     tst.b   D0
02:0000071A 6B46            	   750:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:0000071C B03C0006        	   751:     cmp.b   #$06,D0
02:00000720 6610            	   752:     bne.s   .not_zelda
02:00000722 13FC002400FFE002	   753:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:0000072A 610000E0        	   754:     bsr     prep_phrase
02:0000072E 60000190        	   755:     bra     tick_sq1
                            	   756: .not_zelda:
02:00000732 B03C0001        	   757:     cmp.b   #$01,D0
02:00000736 6716            	   758:     beq.s   .first_ow
02:00000738 B03C0040        	   759:     cmp.b   #$40,D0
02:0000073C 671A            	   760:     beq.s   .first_uw
02:0000073E B03C0010        	   761:     cmp.b   #$10,D0
02:00000742 6626            	   762:     bne     play_next_phrase            ; single-phrase song
02:00000744 13FC001100FFE002	   763:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:0000074C 601C            	   764:     bra     play_next_phrase
                            	   765: .first_ow:
02:0000074E 13FC000800FFE002	   766:     move.b  #$08,(m_phrase).l
02:00000756 6012            	   767:     bra     play_next_phrase
                            	   768: .first_uw:
02:00000758 13FC000F00FFE002	   769:     move.b  #$0F,(m_phrase).l
02:00000760 6008            	   770:     bra     play_next_phrase
                            	   771: .first_demo:
02:00000762 13FC001900FFE002	   772:     move.b  #$19,(m_phrase).l
                            	   773:     bra     play_next_phrase
                            	   774: 
                            	   775: ;==============================================================================
                            	   776: ; play_next_phrase — ported from PlayNextPhrase
                            	   777: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   778: ; calls prep_phrase and falls into tick_sq1.
                            	   779: ;==============================================================================
                            	   780: play_next_phrase:
02:0000076A 103900FFE000    	   781:     move.b  (m_song).l,D0
02:00000770 6B78            	   782:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:00000772 B03C0001        	   783:     cmp.b   #$01,D0
02:00000776 6758            	   784:     beq.s   .next_ow
02:00000778 B03C0040        	   785:     cmp.b   #$40,D0
02:0000077C 6738            	   786:     beq.s   .next_uw
02:0000077E B03C0010        	   787:     cmp.b   #$10,D0
02:00000782 6718            	   788:     beq.s   .next_ending
                            	   789:     ; Single-phrase song: find bit position, phrase = index
02:00000784 7200            	   790:     moveq   #0,D1
02:00000786 7400            	   791:     moveq   #0,D2
02:00000788 1400            	   792:     move.b  D0,D2
                            	   793: .bitloop:
02:0000078A 5201            	   794:     addq.b  #1,D1
02:0000078C E20A            	   795:     lsr.b   #1,D2
02:0000078E 64FA            	   796:     bcc.s   .bitloop
02:00000790 13C100FFE002    	   797:     move.b  D1,(m_phrase).l
02:00000796 6174            	   798:     bsr     prep_phrase
02:00000798 60000126        	   799:     bra     tick_sq1
                            	   800: .next_ending:
02:0000079C 523900FFE002    	   801:     addq.b  #1,(m_phrase).l
02:000007A2 0C39001A00FFE002	   802:     cmpi.b  #$1A,(m_phrase).l
02:000007AA 665A            	   803:     bne.s   .prep_and_tick
02:000007AC 13FC001400FFE002	   804:     move.b  #$14,(m_phrase).l
02:000007B4 60B4            	   805:     bra     play_next_phrase
                            	   806: .next_uw:
02:000007B6 523900FFE002    	   807:     addq.b  #1,(m_phrase).l
02:000007BC 0C39001200FFE002	   808:     cmpi.b  #$12,(m_phrase).l
02:000007C4 6640            	   809:     bne.s   .prep_and_tick
02:000007C6 13FC000F00FFE002	   810:     move.b  #$0F,(m_phrase).l
02:000007CE 609A            	   811:     bra     play_next_phrase
                            	   812: .next_ow:
02:000007D0 523900FFE002    	   813:     addq.b  #1,(m_phrase).l
02:000007D6 0C39001000FFE002	   814:     cmpi.b  #$10,(m_phrase).l
02:000007DE 6626            	   815:     bne.s   .prep_and_tick
02:000007E0 13FC000900FFE002	   816:     move.b  #$09,(m_phrase).l
02:000007E8 6080            	   817:     bra     play_next_phrase
                            	   818: .next_demo:
02:000007EA 523900FFE002    	   819:     addq.b  #1,(m_phrase).l
02:000007F0 0C39002400FFE002	   820:     cmpi.b  #$24,(m_phrase).l
02:000007F8 660C            	   821:     bne.s   .prep_and_tick
02:000007FA 13FC001900FFE002	   822:     move.b  #$19,(m_phrase).l
02:00000802 6000FF66        	   823:     bra     play_next_phrase
                            	   824: .prep_and_tick:
