                            	  4422: c_animate_and_draw_common_object:
02:0002CD24 2F02            	  4423:     move.l  D2,-(SP)        ; save D2
02:0002CD26 2F02            	  4424:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CD28 2F00            	  4425:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4426:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4427:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4428:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4429:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CD2A 4EB900000000    	  4430:     jsr     z04_animate_and_draw_common_object
02:0002CD30 508F            	  4431:     addq.l  #8,SP           ; pop val+slot
02:0002CD32 241F            	  4432:     move.l  (SP)+,D2        ; restore D2
02:0002CD34 4E75            	  4433:     rts
