02:0003A528 7008            	  5184:     moveq   #8,D0
02:0003A52A 4EB90004909A    	  5185:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5186:     ; If facing left, then enable horizontal flipping.
