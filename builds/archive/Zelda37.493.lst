                            	  7547: __far_z_07_0117:
                            	  7548:     ; 7 of every 8 frames, return.
                            	  7549:     ;
02:000498C8 102C0015        	  7550:     move.b  ($0015,A4),D0
02:000498CC 02000007        	  7551:     andi.b #$07,D0
02:000498D0 0C000004        	  7552:     cmpi.b  #$04,D0
02:000498D4 6702            	  7553:     beq.s  __far_z_07_0118
02:000498D6 604C            	  7554:     jmp  L1FF28_Exit
                            	  7555: __far_z_07_0118:
                            	  7556:     ; So, every 8 frames:
                            	  7557:     ; 1. Increment the secret color cycle count.
                            	  7558:     ; 2. Change the water palette.
                            	  7559:     ;
                            	  7560:     ; But when the count = $B, go reveal the stairs.
                            	  7561:     ;
