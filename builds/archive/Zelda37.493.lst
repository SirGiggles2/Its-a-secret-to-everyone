02:0003BDE7 10
02:0003BDE8 00
02:0003BDE9 10
                            	  8493: 
                            	  8494:     even
                            	  8495: GanonSpriteOffsetsY:
02:0003BDEA 00              	  8496:     dc.b    $00, $00, $10, $10
02:0003BDEB 00
02:0003BDEC 10
02:0003BDED 10
                            	  8497: 
                            	  8498:     even
                            	  8499: GanonSpriteHFlips:
