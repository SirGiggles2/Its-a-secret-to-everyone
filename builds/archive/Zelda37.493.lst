                            	  5929: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5930:     ; The weapon is the sword.
                            	  5931:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5932:     ;
02:00048B64 023C00EE        	  5933:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B68 122C0657        	  5934:     move.b  ($0657,A4),D1
02:00048B6C D101            	  5935:     addx.b  D1,D0   ; ADC Items
02:00048B6E 003C0011        	  5936:     ori     #$11,CCR  ; SEC: set C+X
02:00048B72 123C0001        	  5937:     move.b  #$01,D1
02:00048B76 0A3C0010        	  5938:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048B7A 9101            	  5939:     subx.b  D1,D0   ; SBC #$01
02:00048B7C 0A3C0010        	  5940:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5941:     even
