                            	   271: _anon_z05_3:
                            	   272:     ; If Start was pressed, then hide all sprites except
                            	   273:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   274:     ;
02:0003C82C 102C00F8        	   275:     move.b  ($00F8,A4),D0
