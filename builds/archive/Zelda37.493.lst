                            	  5141: _L_z07_UpdateArrowOrBoomerang_State10:
                            	  5142:     ; State $1x. Fly away from the thrower.
                            	  5143:     ;
                            	  5144:     ; Reset [0E], which will indicate:
                            	  5145:     ; - into MoveShot:   0 update grid offset, else don't
                            	  5146:     ; - out of MoveShot: $80 if blocked
                            	  5147:     ;
02:000485AC 7000            	  5148:     moveq   #0,D0
02:000485AE 1940000E        	  5149:     move.b  D0,($000E,A4)
