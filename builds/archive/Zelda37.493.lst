                            	  2712: Link_FilterInput:
                            	  2713:     ; [00] holds the opposite of Link's facing direction.
                            	  2714:     ;
02:0003DEFC 102C0098        	  2715:     move.b  ($0098,A4),D0
02:0003DF00 4EB900030A5C    	  2716:     jsr     GetOppositeDir
02:0003DF06 1880            	  2717:     move.b  D0,($0000,A4)
                            	  2718:     ; Call GetOppositeDir again to use this mapping:
                            	  2719:     ; In Dir: 1 2 4 8
                            	  2720:     ;         -------
                            	  2721:     ; Index:  2 3 0 1
                            	  2722:     ;
02:0003DF08 4EB900030A5C    	  2723:     jsr     GetOppositeDir
                            	  2724:     ; Get the appropriate coordinate for the direction:
                            	  2725:     ; X for horizontal
                            	  2726:     ; Y for vertical
                            	  2727:     ;
02:0003DF0E 102C0070        	  2728:     move.b  ($0070,A4),D0
02:0003DF12 0C030002        	  2729:     cmpi.b  #$02,D3
02:0003DF16 6404            	  2730:     bcc  _anon_z05_74
02:0003DF18 102C0084        	  2731:     move.b  ($0084,A4),D0
                            	  2732: _anon_z05_74:
02:0003DF1C 19400002        	  2733:     move.b  D0,($0002,A4)
                            	  2734:     ; Mask A button and directions if inner border is crossed.
                            	  2735:     ;
02:0003DF20 1003            	  2736:     move.b  D3,D0
02:0003DF22 1B00            	  2737:     move.b  D0,-(A5)  ; PHA
02:0003DF24 023C00EE        	  2738:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF28 123C0008        	  2739:     move.b  #$08,D1
02:0003DF2C D101            	  2740:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003DF2E 7600            	  2741:     moveq   #0,D3
02:0003DF30 1600            	  2742:     move.b  D0,D3
02:0003DF32 103C0080        	  2743:     move.b  #$80,D0
02:0003DF36 6134            	  2744:     jsr     MaskInputInBorder
02:0003DF38 101D            	  2745:     move.b  (A5)+,D0  ; PLA
02:0003DF3A 7600            	  2746:     moveq   #0,D3
02:0003DF3C 1600            	  2747:     move.b  D0,D3
                            	  2748:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2749:     ; boundary using player's direction and reverse direction index.
                            	  2750:     ;
02:0003DF3E 102C0001        	  2751:     move.b  ($0001,A4),D0
02:0003DF42 0C0000FF        	  2752:     cmpi.b  #$FF,D0
02:0003DF46 660C            	  2753:     bne  _anon_z05_75
02:0003DF48 102C0098        	  2754:     move.b  ($0098,A4),D0
02:0003DF4C 1880            	  2755:     move.b  D0,($0000,A4)
02:0003DF4E 4EB900030A5C    	  2756:     jsr     GetOppositeDir
                            	  2757: _anon_z05_75:
                            	  2758:     ; If in UW, use the second set of bounds by adding 4
                            	  2759:     ; to reverse direction index.
                            	  2760:     ;
                            	  2761:     ; Else in OW, and use first set that begins at offset 0.
                            	  2762:     ;
02:0003DF54 102C0010        	  2763:     move.b  ($0010,A4),D0
02:0003DF58 6710            	  2764:     beq  _anon_z05_76
02:0003DF5A 1003            	  2765:     move.b  D3,D0
02:0003DF5C 023C00EE        	  2766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF60 123C0004        	  2767:     move.b  #$04,D1
02:0003DF64 D101            	  2768:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DF66 7600            	  2769:     moveq   #0,D3
02:0003DF68 1600            	  2770:     move.b  D0,D3
                            	  2771: _anon_z05_76:
                            	  2772:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2773:     ;
02:0003DF6A 7000            	  2774:     moveq   #0,D0
                            	  2775: ; Params:
                            	  2776: ; A: mask of buttons to block
                            	  2777: ; Y: offset into BorderBounds
                            	  2778: ; [00]: direction
                            	  2779: ; [02]: coordinate
                            	  2780: ;
                            	  2781: ; Returns:
                            	  2782: ; [01]: button mask that was used
                            	  2783: ;       (set to $FF if boundary not crossed)
                            	  2784: ;
                            	  2785:     even
                            	  2786: MaskInputInBorder:
02:0003DF6C 19400001        	  2787:     move.b  D0,($0001,A4)
                            	  2788:     ; If direction is positive (right or down), then go handle it separately.
                            	  2789:     ;
02:0003DF70 1014            	  2790:     move.b  ($0000,A4),D0
02:0003DF72 0200000A        	  2791:     andi.b #$0A,D0
02:0003DF76 6748            	  2792:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2793:     ; The direction is negative (left or up).
                            	  2794:     ;
                            	  2795:     ; If the coordinate does not cross (<) the boundary, then
                            	  2796:     ; go set mask $FF, so that no button is excluded.
                            	  2797:     ;
02:0003DF78 102C0002        	  2798:     move.b  ($0002,A4),D0
02:0003DF7C 41F90003DEF0    	  2799:     lea     (BorderBounds).l,A0
02:0003DF82 12303000        	  2800:     move.b  (A0,D3.W),D1
02:0003DF86 B001            	  2801:     cmp.b   D1,D0
02:0003DF88 6548            	  2802:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2803:     even
                            	  2804: _L_z05_MaskInputInBorder_MaskButtons:
                            	  2805:     ; The boundary was crossed. Mask buttons.
                            	  2806:     ;
02:0003DF8A 102C00F8        	  2807:     move.b  ($00F8,A4),D0
02:0003DF8E 122C0001        	  2808:     move.b  ($0001,A4),D1
02:0003DF92 C001            	  2809:     and.b  D1,D0
02:0003DF94 194000F8        	  2810:     move.b  D0,($00F8,A4)
                            	  2811:     ; If in OW or button mask <> 0, return.
                            	  2812:     ;
02:0003DF98 102C0010        	  2813:     move.b  ($0010,A4),D0
