                            	   861:     ; NT_B attribute decode ($2BC0-$2BFF) — parallel to NT_A .nt_noop path
                            	   862:     ; but writes to Plane A rows 30..59 by adding +30 to tile_base_row.
                            	   863:     ; _attr_write_one_tile reads NT_CACHE[row*32+col], so row≥30 naturally
