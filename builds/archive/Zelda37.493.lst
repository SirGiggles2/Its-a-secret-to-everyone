                            	  1022: _L_z04_CheckZora_LoopTileCandidate:
                            	  1023:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  1024:     ; If it = 0 or $F0, go loop again.
                            	  1025:     ;
