02:0003E6D2 41F90003E662    	  3911:     lea     (DoorwayBoundsMinOver).l,A0
02:0003E6D8 12303000        	  3912:     move.b  (A0,D3.W),D1
02:0003E6DC B001            	  3913:     cmp.b   D1,D0
