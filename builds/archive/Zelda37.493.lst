                            	    43: DMC_SFX_04_PCM_OFF   equ     $0035F8
                            	    44: DMC_SFX_04_PCM_LEN   equ     $000155
                            	    45: DMC_SFX_05_PCM_OFF   equ     $00374D
                            	    46: DMC_SFX_05_PCM_LEN   equ     $001EFE
                            	    47: DMC_SFX_06_PCM_OFF   equ     $00564B
                            	    48: DMC_SFX_06_PCM_LEN   equ     $001305
                            	    49: DMC_SFX_07_PCM_OFF   equ     $006950
                            	    50: DMC_SFX_07_PCM_LEN   equ     $0024A0
                            	    51: 
                            	    52: ; --- Shared metadata ---------------------------------------------------
                            	    53: DMC_SFX_01_RATE      equ     $0F   ; $4010 raw
                            	    54: DMC_SFX_01_NESADDR   equ     $C000   ; $4012 -> NES addr
                            	    55: DMC_SFX_02_RATE      equ     $0F   ; $4010 raw
                            	    56: DMC_SFX_02_NESADDR   equ     $D300   ; $4012 -> NES addr
                            	    57: DMC_SFX_03_RATE      equ     $0D   ; $4010 raw
