02:000383B2 41EC00AC        	   476:     lea     ($00AC,A4),A0
02:000383B6 11803000        	   477:     move.b  D0,(A0,D3.W)
                            	   478:     ; Fly at q-speed $A0 (2.5 pixels a frame).
