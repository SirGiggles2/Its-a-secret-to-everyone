                            	   381:     ; If facing vertically, then go choose a horizontal direction
                            	   382:     ; toward the chase target.
                            	   383:     ;
                            	   384:     ; Else go choose a vertical direction toward the chase target.
                            	   385:     ;
02:0003830E 41EC0098        	   386:     lea     ($0098,A4),A0
02:00038312 10302000        	   387:     move.b  (A0,D2.W),D0
02:00038316 0200000C        	   388:     andi.b #$0C,D0
02:0003831A 66AE            	   389:     bne  _L_z04_Exit_TurnHorizontally
