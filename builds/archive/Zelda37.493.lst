02:0000E6B4 04420010        	  1166:     subi.w  #$10,D2
                            	  1167: .t19_bg_color:
02:0000E6B8 3602            	  1168:     move.w  D2,D3
02:0000E6BA E44B            	  1169:     lsr.w   #2,D3                   ; D3.w = palette index (0..3)
02:0000E6BC EB4B            	  1170:     lsl.w   #5,D3                   ; D3.w = palette * $20
02:0000E6BE 02420003        	  1171:     andi.w  #$0003,D2               ; D2.w = color slot (0..3)
