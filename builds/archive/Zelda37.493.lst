                            	   759:     ;
02:0002F570 1014            	   760:     move.b  ($0000,A4),D0
02:0002F572 023C00EE        	   761:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F576 123C0001        	   762:     move.b  #$01,D1
02:0002F57A D101            	   763:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F57C 1880            	   764:     move.b  D0,($0000,A4)
02:0002F57E 102C0001        	   765:     move.b  ($0001,A4),D0
02:0002F582 123C0000        	   766:     move.b  #$00,D1
02:0002F586 D101            	   767:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F588 19400001        	   768:     move.b  D0,($0001,A4)
                            	   769:     ; Increment destination address.
                            	   770:     ;
02:0002F58C 102C0002        	   771:     move.b  ($0002,A4),D0
02:0002F590 023C00EE        	   772:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F594 123C0001        	   773:     move.b  #$01,D1
02:0002F598 D101            	   774:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002F59A 19400002        	   775:     move.b  D0,($0002,A4)
02:0002F59E 102C0003        	   776:     move.b  ($0003,A4),D0
02:0002F5A2 123C0000        	   777:     move.b  #$00,D1
02:0002F5A6 D101            	   778:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002F5A8 19400003        	   779:     move.b  D0,($0003,A4)
