02:00034F72 6AEA            	  4496:     bpl  _anon_z02_35
                            	  4497:     ; Load a character from the string and copy it to
                            	  4498:     ; the transfer record until we read character $FF.
                            	  4499:     ;
02:00034F74 7600            	  4500:     moveq   #0,D3
02:00034F76 162C0413        	  4501:     move.b  ($0413,A4),D3
02:00034F7A 41F900034F14    	  4502:     lea     (PeaceText).l,A0
02:00034F80 10303000        	  4503:     move.b  (A0,D3.W),D0
02:00034F84 0C0000FF        	  4504:     cmpi.b  #$FF,D0
