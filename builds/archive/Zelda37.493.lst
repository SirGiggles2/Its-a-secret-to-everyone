                            	  5124: __far_z_07_0074:
                            	  5125:     ; Reset [00], which will hold the number of axes where the distance <= 8
                            	  5126:     ; when calculating the angle to return to thrower.
                            	  5127:     ; See states $40 and $50 and GetDirectionsAndDistancesToTarget.
                            	  5128:     ;
02:00048592 7000            	  5129:     moveq   #0,D0
02:00048594 1880            	  5130:     move.b  D0,($0000,A4)
                            	  5131:     ; If not in major state $10, go check other states.
                            	  5132:     ;
02:00048596 41EC00AC        	  5133:     lea     ($00AC,A4),A0
02:0004859A 10302000        	  5134:     move.b  (A0,D2.W),D0
02:0004859E 020000F0        	  5135:     andi.b #$F0,D0
02:000485A2 0C000010        	  5136:     cmpi.b  #$10,D0
02:000485A6 6704            	  5137:     beq  _L_z07_UpdateArrowOrBoomerang_State10
