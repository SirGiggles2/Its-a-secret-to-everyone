                            	   389: UpdateMenuStartOW:
                            	   390:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   391:     ; make it look completely empty, and no piece has been won.
                            	   392:     ;
02:0003C92E 7617            	   393:     moveq   #23,D3
                            	   394: _anon_z05_6:
02:0003C930 7400            	   395:     moveq   #0,D2
02:0003C932 41F90003C8E6    	   396:     lea     (TriforceTransferBufOffsets).l,A0
02:0003C938 14303000        	   397:     move.b  (A0,D3.W),D2
02:0003C93C 41F90003C916    	   398:     lea     (TriforceTransferBufTiles).l,A0
02:0003C942 10303000        	   399:     move.b  (A0,D3.W),D0
02:0003C946 41F90004390C    	   400:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003C94C 11802000        	   401:     move.b  D0,(A0,D2.W)
02:0003C950 5303            	   402:     subq.b  #1,D3
02:0003C952 6ADC            	   403:     bpl  _anon_z05_6
                            	   404:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   405:     ;
02:0003C954 5203            	   406:     addq.b  #1,D3
                            	   407:     ; Outer loop.
                            	   408:     ; A level test bit in [06] will be used to see whether
                            	   409:     ; we have a triforce piece.
                            	   410:     ;
02:0003C956 7001            	   411:     moveq   #1,D0
02:0003C958 19400006        	   412:     move.b  D0,($0006,A4)
                            	   413:     even
                            	   414: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   415:     ; Inner loop.
                            	   416:     ; Each level bit will make 3 triforce tile slots be
                            	   417:     ; checked and replaced.
                            	   418:     ;
02:0003C95C 7003            	   419:     moveq   #3,D0
02:0003C95E 19400007        	   420:     move.b  D0,($0007,A4)
                            	   421:     even
                            	   422: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   423:     ; Get the offset into the submenu triforce transfer buffers of
                            	   424:     ; the current tile slot.
                            	   425:     ;
02:0003C962 7400            	   426:     moveq   #0,D2
02:0003C964 41F90003C8E6    	   427:     lea     (TriforceTransferBufOffsets).l,A0
02:0003C96A 14303000        	   428:     move.b  (A0,D3.W),D2
                            	   429:     ; If the level test bit is not in the triforce mask, then we don't
                            	   430:     ; have this piece. So, go loop again, and leave the tile in the
                            	   431:     ; empty state.
                            	   432:     ;
                            	   433:     ;
                            	   434:     ; [06] level test mask
02:0003C96E 102C0006        	   435:     move.b  ($0006,A4),D0
02:0003C972 122C0671        	   436:     move.b  ($0671,A4),D1
02:0003C976 C200            	   437:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C978 6730            	   438:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   439:     ; We have the triforce piece.
                            	   440:     ;
                            	   441:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   442:     ; then make it $F5. These are tiles that were half full, and now
                            	   443:     ; need to be full.
                            	   444:     ;
                            	   445:     ; Else replace it with the one at the current triforce tile slot
                            	   446:     ; in the replacement list.
                            	   447:     ;
02:0003C97A 41F90004390C    	   448:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003C980 10302000        	   449:     move.b  (A0,D2.W),D0
02:0003C984 0C0000E5        	   450:     cmpi.b  #$E5,D0
02:0003C988 6712            	   451:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003C98A 0C0000E6        	   452:     cmpi.b  #$E6,D0
02:0003C98E 670C            	   453:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003C990 41F90003C8FE    	   454:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003C996 10303000        	   455:     move.b  (A0,D3.W),D0
02:0003C99A 6004            	   456:     jmp     _anon_z05_7
                            	   457: 
                            	   458:     even
                            	   459: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003C99C 103C00F5        	   460:     move.b  #$F5,D0
                            	   461: _anon_z05_7:
02:0003C9A0 41F90004390C    	   462:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003C9A6 11802000        	   463:     move.b  D0,(A0,D2.W)
                            	   464:     even
                            	   465: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   466:     ; Bottom of the inner loop.
                            	   467:     ;
                            	   468:     ; Increment the triforce tile slot.
                            	   469:     ; Decrement [07] and loop again, if it's not 0.
                            	   470:     ;
02:0003C9AA 5203            	   471:     addq.b  #1,D3
02:0003C9AC 532C0007        	   472:     subq.b  #1,($0007,A4)
02:0003C9B0 66B0            	   473:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   474:     ; Bottom of the outer loop.
                            	   475:     ;
                            	   476:     ; Shift the level test bit [06] left to test the next level.
                            	   477:     ; When it becomes 0, we're done.
                            	   478:     ;
02:0003C9B2 122C0006        	   479:     move.b  ($0006,A4),D1
02:0003C9B6 E309            	   480:     lsl.b  #1,D1   ; ASL $06
02:0003C9B8 19410006        	   481:     move.b  D1,($0006,A4)
02:0003C9BC 669E            	   482:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003C9BE 522C00E1        	   483:     addq.b  #1,($00E1,A4)
02:0003C9C2 4E75            	   484:     rts
                            	   485: 
                            	   486:     even
                            	   487: ScrollWorld:
02:0003C9C4 102C0015        	   488:     move.b  ($0015,A4),D0
                            	   489:     ; The purpose of this is to delay vertical scrolling.
                            	   490:     ; OW: once every two frames
                            	   491:     ; UW: once every four frames
                            	   492:     ; Horizontal scrolling happens every frame.
02:0003C9C8 02000003        	   493:     andi.b #$03,D0
02:0003C9CC 7600            	   494:     moveq   #0,D3
02:0003C9CE 162C0010        	   495:     move.b  ($0010,A4),D3
02:0003C9D2 6604            	   496:     bne  _anon_z05_8
02:0003C9D4 02000001        	   497:     andi.b #$01,D0
                            	   498: _anon_z05_8:
02:0003C9D8 122C00E6        	   499:     move.b  ($00E6,A4),D1
02:0003C9DC B001            	   500:     cmp.b   D1,D0
02:0003C9DE 6704            	   501:     beq.s  __far_z_05_0004
02:0003C9E0 600000DE        	   502:     jmp  ScrollWorldH
                            	   503: __far_z_05_0004:
02:0003C9E4 7008            	   504:     moveq   #8,D0
02:0003C9E6 122C0098        	   505:     move.b  ($0098,A4),D1
02:0003C9EA C200            	   506:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C9EC 6602            	   507:     bne.s  __far_z_05_0005
02:0003C9EE 606E            	   508:     jmp  ScrollWorldDownOrH
                            	   509: __far_z_05_0005:
                            	   510:     ; then scroll up.
                            	   511:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   512:     ;
02:0003C9F0 532C00E9        	   513:     subq.b  #1,($00E9,A4)
02:0003C9F4 102C0084        	   514:     move.b  ($0084,A4),D0
02:0003C9F8 0C0000DD        	   515:     cmpi.b  #$DD,D0
02:0003C9FC 640A            	   516:     bcc  _anon_z05_9
02:0003C9FE 123C0008        	   517:     move.b  #$08,D1
02:0003CA02 D101            	   518:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA04 19400084        	   519:     move.b  D0,($0084,A4)
                            	   520: _anon_z05_9:
02:0003CA08 102C00E2        	   521:     move.b  ($00E2,A4),D0
02:0003CA0C 003C0011        	   522:     ori     #$11,CCR  ; SEC: set C+X
02:0003CA10 123C0020        	   523:     move.b  #$20,D1
02:0003CA14 0A3C0010        	   524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CA18 9101            	   525:     subx.b  D1,D0   ; SBC #$20
02:0003CA1A 0A3C0010        	   526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CA1E 194000E2        	   527:     move.b  D0,($00E2,A4)
02:0003CA22 6404            	   528:     bcc  _anon_z05_10
02:0003CA24 532C0058        	   529:     subq.b  #1,($0058,A4)
                            	   530: _anon_z05_10:
02:0003CA28 0C0000E0        	   531:     cmpi.b  #$E0,D0
02:0003CA2C 661E            	   532:     bne  _L_z05_ScrollWorld_Exit
02:0003CA2E 102C0058        	   533:     move.b  ($0058,A4),D0
02:0003CA32 0C000020        	   534:     cmpi.b  #$20,D0
02:0003CA36 6716            	   535:     beq  _L_z05_ScrollWorld_LimitLow
02:0003CA38 0C000027        	   536:     cmpi.b  #$27,D0
02:0003CA3C 660E            	   537:     bne  _L_z05_ScrollWorld_Exit
                            	   538:     ; VScroll address is $27E0. So, we rolled from the
                            	   539:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   540:     ; to $23A0, the true last row of NT 0.
02:0003CA3E 7023            	   541:     moveq   #35,D0
02:0003CA40 19400058        	   542:     move.b  D0,($0058,A4)
02:0003CA44 103C00A0        	   543:     move.b  #$A0,D0
02:0003CA48 194000E2        	   544:     move.b  D0,($00E2,A4)
                            	   545:     even
                            	   546: _L_z05_ScrollWorld_Exit:
02:0003CA4C 4E75            	   547:     rts
                            	   548: 
                            	   549:     even
                            	   550: _L_z05_ScrollWorld_LimitLow:
                            	   551:     ; Don't let the scroll position go above $2100, the bottom of
                            	   552:     ; the status bar; nor below $2800, the top of NT 2.
02:0003CA4E 522C0058        	   553:     addq.b  #1,($0058,A4)
                            	   554:     even
                            	   555: ResetVScrollLo:
02:0003CA52 4EF90002BCA4    	   556:     jmp     c_reset_vscroll_lo
                            	   557: 
                            	   558: IncSubmode:
02:0003CA58 4EF90002BA04    	   559:     jmp     c_inc_submode
                            	   560: 
                            	   561: ScrollWorldDownOrH:
02:0003CA5E E208            	   562:     lsr.b  #1,D0   ; LSR A
