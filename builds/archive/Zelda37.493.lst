                            	   810:     ; Fold $2400 mirror → $2000 (vertical mirroring alias for NT_A).
02:0000E440 0C412400        	   811:     cmpi.w  #$2400,D1
02:0000E444 650A            	   812:     blo.s   .nt_no_a_mirror
02:0000E446 0C412800        	   813:     cmpi.w  #$2800,D1
02:0000E44A 6404            	   814:     bhs.s   .nt_no_a_mirror
02:0000E44C 04410400        	   815:     subi.w  #$0400,D1
                            	   816: .nt_no_a_mirror:
                            	   817: 
                            	   818:     ; Dispatch on NT_A vs NT_B tile ranges.
02:0000E450 0C412800        	   819:     cmpi.w  #$2800,D1
02:0000E454 650000DA        	   820:     blo     .nt_write_a              ; $2000-$27FF → NT_A path
02:0000E458 0C412C00        	   821:     cmpi.w  #$2C00,D1
02:0000E45C 64000188        	   822:     bhs     .nt_noop                 ; ≥$2C00 → palette/skip
02:0000E460 0C412BC0        	   823:     cmpi.w  #$2BC0,D1
02:0000E464 6458            	   824:     bhs     .nt_attr_b               ; $2BC0-$2BFF → NT_B attribute decode
                            	   825: 
                            	   826:     ; ---- NT_B tile write: $2800-$2BBF → Plane A rows 30..59 ----
02:0000E466 3401            	   827:     move.w  D1,D2
02:0000E468 04422800        	   828:     subi.w  #$2800,D2                ; D2.w = index within NT_B (0…$3BF)
                            	   829: 
                            	   830:     ; T21: cache raw tile index for attribute palette updates.
                            	   831:     ; NT_B cache lives at NT_CACHE_BASE + 960 (rows 30..59 slot).
02:0000E46C 024000FF        	   832:     andi.w  #$00FF,D0                ; D0.w = tile index
02:0000E470 3602            	   833:     move.w  D2,D3
02:0000E472 064303C0        	   834:     addi.w  #960,D3                  ; D3.w = NT_B cache offset (960..1919)
02:0000E476 41F900FF0840    	   835:     lea     (NT_CACHE_BASE).l,A0
02:0000E47C 11803000        	   836:     move.b  D0,(A0,D3.W)
                            	   837: 
02:0000E480 3602            	   838:     move.w  D2,D3
02:0000E482 0243001F        	   839:     andi.w  #$001F,D3
02:0000E486 E34B            	   840:     lsl.w   #1,D3                    ; D3.w = col * 2
                            	   841: 
02:0000E488 EA4A            	   842:     lsr.w   #5,D2                    ; D2.w = row within NT_B (0…29)
02:0000E48A 0642001E        	   843:     addi.w  #30,D2                   ; offset into Plane A rows 30..59
02:0000E48E C4FC0080        	   844:     mulu.w  #$0080,D2                ; D2.l = row * $80 (row ≤ 59)
02:0000E492 D443            	   845:     add.w   D3,D2
02:0000E494 0642C000        	   846:     addi.w  #$C000,D2                ; D2.w = VDP VRAM addr
                            	   847: 
02:0000E498 2602            	   848:     move.l  D2,D3
02:0000E49A 028300003FFF    	   849:     andi.l  #$00003FFF,D3
02:0000E4A0 4843            	   850:     swap    D3
02:0000E4A2 008340000003    	   851:     ori.l   #$40000003,D3
02:0000E4A8 23C300C00004    	   852:     move.l  D3,(VDP_CTRL).l
                            	   853: 
02:0000E4AE 61000454        	   854:     bsr     _compose_bg_tile_word
02:0000E4B2 33C000C00000    	   855:     move.w  D0,(VDP_DATA).l
                            	   856: 
02:0000E4B8 4CDF037F        	   857:     movem.l (SP)+,D0-D6/A0-A1
02:0000E4BC 4E75            	   858:     rts
