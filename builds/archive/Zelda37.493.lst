                            	  2525:     even
                            	  2526: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  2527:     ; If the current heart's state <> 0, then go move it.
                            	  2528:     ; Else we have to wait for it to come out at the right time.
                            	  2529:     ;
02:000391A6 41EC00AC        	  2530:     lea     ($00AC,A4),A0
02:000391AA 10302000        	  2531:     move.b  (A0,D2.W),D0
02:000391AE 667C            	  2532:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  2533:     ; The current heart's state = 0.
                            	  2534:     ;
                            	  2535:     ; If object slot = 2, then go make it appear. This is the first
                            	  2536:     ; heart to show up.
                            	  2537:     ;
02:000391B0 0C020002        	  2538:     cmpi.b  #$02,D2
02:000391B4 6732            	  2539:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  2540:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  2541:     ; go start over.
                            	  2542:     ;
                            	  2543:     ; TODO:
                            	  2544:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  2545:     ;
02:000391B6 102C00AE        	  2546:     move.b  ($00AE,A4),D0
02:000391BA 67EA            	  2547:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  2548:     ; Look up the starting angle of this heart with the index
                            	  2549:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  2550:     ; then loop again.
                            	  2551:     ;
02:000391BC 1002            	  2552:     move.b  D2,D0
02:000391BE 003C0011        	  2553:     ori     #$11,CCR  ; SEC: set C+X
02:000391C2 123C0003        	  2554:     move.b  #$03,D1
02:000391C6 0A3C0010        	  2555:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000391CA 9101            	  2556:     subx.b  D1,D0   ; SBC #$03
02:000391CC 0A3C0010        	  2557:     eori    #$10,CCR  ; restore X = 6502 C
02:000391D0 7600            	  2558:     moveq   #0,D3
02:000391D2 1600            	  2559:     move.b  D0,D3
02:000391D4 102C0396        	  2560:     move.b  ($0396,A4),D0
02:000391D8 41F90003919C    	  2561:     lea     (PondHeartStartAngles).l,A0
02:000391DE 12303000        	  2562:     move.b  (A0,D3.W),D1
02:000391E2 B001            	  2563:     cmp.b   D1,D0
02:000391E4 66000086        	  2564:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  2565:     even
