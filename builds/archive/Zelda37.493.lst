02:00048792 0C000030        	  5419:     cmpi.b  #$30,D0
02:00048796 6656            	  5420:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5421:     ; State $3x. Slow down.
                            	  5422:     ;
                            	  5423:     ; Reset grid offset for movement.
                            	  5424:     ;
02:00048798 7000            	  5425:     moveq   #0,D0
02:0004879A 41EC0394        	  5426:     lea     ($0394,A4),A0
02:0004879E 11802000        	  5427:     move.b  D0,(A0,D2.W)
