02:0002B612 7000            	  3536:     moveq   #0,D0
02:0002B614 3006            	  3537:     move.w  D6,D0
02:0002B616 4840            	  3538:     swap    D0
02:0002B618 0080C0000000    	  3539:     ori.l   #$C0000000,D0
02:0002B61E 23C000C00004    	  3540:     move.l  D0,(VDP_CTRL).l
