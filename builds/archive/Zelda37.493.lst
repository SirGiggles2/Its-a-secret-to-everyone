02:00038D40 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038D42 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038D46 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038D4A 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038D4C 19400001        	  1859:     move.b  D0,($0001,A4)
