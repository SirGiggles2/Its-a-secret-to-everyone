                            	  3536: FindNextEdgeSpawnCell:
                            	  3537:     ; Load [0A] with the value before the call.
                            	  3538:     ;
02:0003E43A 102C0525        	  3539:     move.b  ($0525,A4),D0
02:0003E43E 1940000A        	  3540:     move.b  D0,($000A,A4)
                            	  3541:     even
                            	  3542: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3543:     ; Loop to look for a place to spawn a monster from the edge
                            	  3544:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3545:     ;
                            	  3546:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3547:     ; We'll move down $10 pixels.
                            	  3548:     ;
02:0003E442 7610            	  3549:     moveq   #16,D3
02:0003E444 102C000A        	  3550:     move.b  ($000A,A4),D0
02:0003E448 0200000F        	  3551:     andi.b #$0F,D0
02:0003E44C 670A            	  3552:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3553:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3554:     ; Don't move vertically.
                            	  3555:     ;
02:0003E44E 163C00F0        	  3556:     move.b  #$F0,D3
02:0003E452 0C00000F        	  3557:     cmpi.b  #$0F,D0
02:0003E456 6610            	  3558:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3559:     even
                            	  3560: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3561:     ; Else low nibble = $F. We're at the right edge,
                            	  3562:     ; and we'll move up $10 pixels.
                            	  3563:     ;
02:0003E458 1003            	  3564:     move.b  D3,D0
02:0003E45A 023C00EE        	  3565:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E45E 122C000A        	  3566:     move.b  ($000A,A4),D1
02:0003E462 D101            	  3567:     addx.b  D1,D0   ; ADC $0A
02:0003E464 1940000A        	  3568:     move.b  D0,($000A,A4)
                            	  3569:     even
                            	  3570: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3571:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3572:     ; Move right one pixel.
                            	  3573:     ;
02:0003E468 102C000A        	  3574:     move.b  ($000A,A4),D0
02:0003E46C 020000F0        	  3575:     andi.b #$F0,D0
02:0003E470 0C0000E0        	  3576:     cmpi.b  #$E0,D0
02:0003E474 6606            	  3577:     bne  _anon_z05_88
02:0003E476 522C000A        	  3578:     addq.b  #1,($000A,A4)
02:0003E47A 600A            	  3579:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3580: 
                            	  3581: _anon_z05_88:
                            	  3582:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3583:     ; Dont' move horizontally.
                            	  3584:     ;
02:0003E47C 0C000040        	  3585:     cmpi.b  #$40,D0
02:0003E480 6604            	  3586:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3587:     ; Else high nibble = 4. We're at the top edge.
                            	  3588:     ; Move left 1 pixel.
                            	  3589:     ;
02:0003E482 532C000A        	  3590:     subq.b  #1,($000A,A4)
                            	  3591:     even
                            	  3592: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3593:     ; Time to get the address of the column.
                            	  3594:     ; Starting at the top of the leftmost column.
                            	  3595:     ;
02:0003E486 61002590        	  3596:     jsr     FetchTileMapAddr
02:0003E48A 7005            	  3597:     moveq   #5,D0
02:0003E48C 4EB90002AA22    	  3598:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3599:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3600:     ; in order to point to the column we want.
                            	  3601:     ;
02:0003E492 102C000A        	  3602:     move.b  ($000A,A4),D0
02:0003E496 0200000F        	  3603:     andi.b #$0F,D0
02:0003E49A 7600            	  3604:     moveq   #0,D3
02:0003E49C 1600            	  3605:     move.b  D0,D3
02:0003E49E 670C            	  3606:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3607: _anon_z05_89:
02:0003E4A0 702C            	  3608:     moveq   #44,D0
02:0003E4A2 4EB900030AE0    	  3609:     jsr     AddToInt16At0
02:0003E4A8 5303            	  3610:     subq.b  #1,D3
02:0003E4AA 66F4            	  3611:     bne  _anon_z05_89
                            	  3612:     even
                            	  3613: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3614:     ; Turn the row part of [0A] into a tile index.
                            	  3615:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3616:     ;
02:0003E4AC 102C000A        	  3617:     move.b  ($000A,A4),D0
02:0003E4B0 020000F0        	  3618:     andi.b #$F0,D0
02:0003E4B4 003C0011        	  3619:     ori     #$11,CCR  ; SEC: set C+X
02:0003E4B8 123C0040        	  3620:     move.b  #$40,D1
02:0003E4BC 0A3C0010        	  3621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E4C0 9101            	  3622:     subx.b  D1,D0   ; SBC #$40
02:0003E4C2 0A3C0010        	  3623:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E4C6 E208            	  3624:     lsr.b  #1,D0   ; LSR A
02:0003E4C8 E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003E4CA E208            	  3626:     lsr.b  #1,D0   ; LSR A
