02:0003E6E0 41F90003E666    	  3915:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E6E6 12303000        	  3916:     move.b  (A0,D3.W),D1
02:0003E6EA B001            	  3917:     cmp.b   D1,D0
02:0003E6EC 640E            	  3918:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0003E6EE 102C0053        	  3919:     move.b  ($0053,A4),D0
02:0003E6F2 122C0098        	  3920:     move.b  ($0098,A4),D1
02:0003E6F6 B001            	  3921:     cmp.b   D1,D0
02:0003E6F8 6700FF7E        	  3922:     beq  _L_z05_CheckDoorway_SearchOverflowBounds
                            	  3923:     even
                            	  3924: _L_z05_CheckDoorway_SearchUnderflowDoorway:
                            	  3925:     ; The player might be in the original doorway facing backwards,
                            	  3926:     ; outside it, or in the other doorway along the axis.
                            	  3927:     ;
                            	  3928:     ; Look for a doorway that Link might be in.
