                            	   884: ;==============================================================================
                            	   885: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   886: ;==============================================================================
                            	   887: tick_sq1:
02:000008C0 533900FFE00D    	   888:     subq.b  #1,(m_sq1_cnt).l
02:000008C6 6600010E        	   889:     bne     tick_sq0                     ; no new note
                            	   890: .read:
02:000008CA 207900FFE008    	   891:     move.l  (m_script_ptr).l,A0
02:000008D0 7200            	   892:     moveq   #0,D1
02:000008D2 123900FFE00C    	   893:     move.b  (m_sq1_off).l,D1
02:000008D8 523900FFE00C    	   894:     addq.b  #1,(m_sq1_off).l
02:000008DE 10301000        	   895:     move.b  (A0,D1.w),D0
02:000008E2 673A            	   896:     beq.s   .song_ended
02:000008E4 4A00            	   897:     tst.b   D0
02:000008E6 6B02            	   898:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:000008E8 6022            	   899:     bra.s   .play_note
                            	   900: .prep_then_note:
02:000008EA 6100027C        	   901:     bsr     get_song_note_length         ; D0 in → D0 length
02:000008EE 13C000FFE00E    	   902:     move.b  D0,(m_sq1_len).l
02:000008F4 207900FFE008    	   903:     move.l  (m_script_ptr).l,A0
02:000008FA 7200            	   904:     moveq   #0,D1
02:000008FC 123900FFE00C    	   905:     move.b  (m_sq1_off).l,D1
02:00000902 523900FFE00C    	   906:     addq.b  #1,(m_sq1_off).l
02:00000908 10301000        	   907:     move.b  (A0,D1.w),D0
                            	   908: .play_note:
02:0000090C 61000274        	   909:     bsr     emit_note_sq1                 ; D0 = note id
02:00000910 13F900FFE00E00FF	   910:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:00000918 E00D
02:0000091A 600000BA        	   911:     bra     tick_sq0
                            	   912: .song_ended:
02:0000091E 103900FFE000    	   913:     move.b  (m_song).l,D0
02:00000924 020000F1        	   914:     andi.b  #$F1,D0
02:00000928 6604            	   915:     bne.s   .play_again
02:0000092A 60000430        	   916:     bra     music_silence
                            	   917: .play_again:
02:0000092E 6102            	   918:     bsr     play_next_phrase_no_tick
02:00000930 6098            	   919:     bra.s   .read
                            	   920: 
                            	   921: ;----------------------------------------------------------------------
                            	   922: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   923: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   924: ; to restart a looping song when $00 opcode is read.
                            	   925: ;----------------------------------------------------------------------
                            	   926: play_next_phrase_no_tick:
02:00000932 103900FFE000    	   927:     move.b  (m_song).l,D0
02:00000938 6B7E            	   928:     bmi     .nsp_demo
02:0000093A B03C0001        	   929:     cmp.b   #$01,D0
02:0000093E 675A            	   930:     beq     .nsp_ow
02:00000940 B03C0040        	   931:     cmp.b   #$40,D0
02:00000944 6738            	   932:     beq     .nsp_uw
02:00000946 B03C0010        	   933:     cmp.b   #$10,D0
02:0000094A 6716            	   934:     beq     .nsp_ending
                            	   935:     ; single-phrase: rebuild phrase from bit
02:0000094C 7200            	   936:     moveq   #0,D1
02:0000094E 7400            	   937:     moveq   #0,D2
02:00000950 1400            	   938:     move.b  D0,D2
                            	   939: .nsp_loop:
02:00000952 5201            	   940:     addq.b  #1,D1
02:00000954 E20A            	   941:     lsr.b   #1,D2
02:00000956 64FA            	   942:     bcc     .nsp_loop
02:00000958 13C100FFE002    	   943:     move.b  D1,(m_phrase).l
02:0000095E 6000FEAC        	   944:     bra     prep_phrase
                            	   945: .nsp_ending:
02:00000962 523900FFE002    	   946:     addq.b  #1,(m_phrase).l
02:00000968 0C39001A00FFE002	   947:     cmpi.b  #$1A,(m_phrase).l
02:00000970 6600FE9A        	   948:     bne     prep_phrase
02:00000974 13FC001400FFE002	   949:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:0000097C 60B4            	   950:     bra     play_next_phrase_no_tick
                            	   951: .nsp_uw:
02:0000097E 523900FFE002    	   952:     addq.b  #1,(m_phrase).l
02:00000984 0C39001200FFE002	   953:     cmpi.b  #$12,(m_phrase).l
02:0000098C 6600FE7E        	   954:     bne     prep_phrase
02:00000990 13FC000F00FFE002	   955:     move.b  #$0F,(m_phrase).l
02:00000998 6098            	   956:     bra     play_next_phrase_no_tick
                            	   957: .nsp_ow:
02:0000099A 523900FFE002    	   958:     addq.b  #1,(m_phrase).l
02:000009A0 0C39001000FFE002	   959:     cmpi.b  #$10,(m_phrase).l
02:000009A8 6600FE62        	   960:     bne     prep_phrase
02:000009AC 13FC000900FFE002	   961:     move.b  #$09,(m_phrase).l
02:000009B4 6000FF7C        	   962:     bra     play_next_phrase_no_tick
                            	   963: .nsp_demo:
02:000009B8 523900FFE002    	   964:     addq.b  #1,(m_phrase).l
02:000009BE 0C39002400FFE002	   965:     cmpi.b  #$24,(m_phrase).l
02:000009C6 6600FE44        	   966:     bne     prep_phrase
02:000009CA 13FC001900FFE002	   967:     move.b  #$19,(m_phrase).l
02:000009D2 6000FF5E        	   968:     bra     play_next_phrase_no_tick
