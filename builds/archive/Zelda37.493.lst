02:00038E26 023C00EE        	  1979:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038E2A 123C0001        	  1980:     move.b  #$01,D1
02:00038E2E D101            	  1981:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038E30 0C000006        	  1982:     cmpi.b  #$06,D0
02:00038E34 6506            	  1983:     bcs  _anon_z04_47
02:00038E36 532C0510        	  1984:     subq.b  #1,($0510,A4)
02:00038E3A 7000            	  1985:     moveq   #0,D0
                            	  1986: _anon_z04_47:
