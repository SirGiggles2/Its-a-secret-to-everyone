02:00038F24 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00038F28 12302000        	  2107:     move.b  (A0,D2.W),D1
02:00038F2C D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00038F2E 1B00            	  2109:     move.b  D0,-(A5)  ; PHA
                            	  2110:     ; If facing vertically, go draw mirrored.
                            	  2111:     ;
02:00038F30 41EC0098        	  2112:     lea     ($0098,A4),A0
02:00038F34 10302000        	  2113:     move.b  (A0,D2.W),D0
02:00038F38 0200000C        	  2114:     andi.b #$0C,D0
02:00038F3C 660C            	  2115:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2116:     ; Else draw not mirrored.
                            	  2117:     ;
02:00038F3E 101D            	  2118:     move.b  (A5)+,D0  ; PLA
02:00038F40 4EB900030E2C    	  2119:     jsr     DrawObjectNotMirrored
02:00038F46 60008250        	  2120:     jmp     CheckMonsterCollisions
