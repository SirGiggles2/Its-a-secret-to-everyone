02:00038E68 7600            	  2003:     moveq   #0,D3
02:00038E6A 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038E6E 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038E72 41F900038C64    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038E78 10303000        	  2007:     move.b  (A0,D3.W),D0
