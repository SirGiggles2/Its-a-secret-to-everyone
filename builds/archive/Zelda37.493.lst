02:00048B46 10303000        	  5913:     move.b  (A0,D3.W),D0
02:00048B4A 1940000C        	  5914:     move.b  D0,($000C,A4)
                            	  5915:     ; Calculate sprite attributes.
                            	  5916:     ;
                            	  5917:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5918:     ;   base attribute OR 1
                            	  5919:     ; So, it uses palette row 5.
                            	  5920:     ;
02:00048B4E 41F900048578    	  5921:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048B54 10303000        	  5922:     move.b  (A0,D3.W),D0
