                            	  2581:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  2582:     ;
02:00039206 102C0071        	  2583:     move.b  ($0071,A4),D0
02:0003920A 19802070        	  2584:     move.b  D0,($70,A4,D2.W)
                            	  2585:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  2586:     ;
02:0003920E 102C0085        	  2587:     move.b  ($0085,A4),D0
02:00039212 003C0011        	  2588:     ori     #$11,CCR  ; SEC: set C+X
02:00039216 123C001C        	  2589:     move.b  #$1C,D1
02:0003921A 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003921E 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:00039220 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:00039224 41EC0084        	  2593:     lea     ($0084,A4),A0
02:00039228 11802000        	  2594:     move.b  D0,(A0,D2.W)
                            	  2595:     even
                            	  2596: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  2597:     ; Decrease the angle by $00.60.
                            	  2598:     ;
02:0003922C 7000            	  2599:     moveq   #0,D0
02:0003922E 1940000B        	  2600:     move.b  D0,($000B,A4)
02:00039232 7060            	  2601:     moveq   #96,D0
02:00039234 61003466        	  2602:     jsr     DecreaseObjectAngle
                            	  2603:     ; Rotate the heart's location by the change in angle.
                            	  2604:     ; Use 6 for the number of bits of sine/cosine to use
                            	  2605:     ; for a large ring.
                            	  2606:     ;
02:00039238 7006            	  2607:     moveq   #6,D0
02:0003923A 7600            	  2608:     moveq   #0,D3
02:0003923C 1600            	  2609:     move.b  D0,D3
