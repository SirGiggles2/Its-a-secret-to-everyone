02:0003A2A4 0A000003        	  4833:     eori.b #$03,D0
02:0003A2A8 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A2AC 7600            	  4835:     moveq   #0,D3
02:0003A2AE 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A2B2 41F90003A230    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A2B8 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A2BC 12390003A230    	  4842:     move.b  (AquamentusTiles).l,D1
