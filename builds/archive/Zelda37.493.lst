                            	  3897: _L_z05_CheckDoorway_InDoorway:
                            	  3898:     ; In a doorway. DoorwayDir is in A.
                            	  3899:     ;
02:0003E6C0 1B00            	  3900:     move.b  D0,-(A5)  ; PHA
02:0003E6C2 610000DC        	  3901:     jsr     GetPlayerCoordsForDirection
02:0003E6C6 101D            	  3902:     move.b  (A5)+,D0  ; PLA
02:0003E6C8 4EB900030A5C    	  3903:     jsr     GetOppositeDir
02:0003E6CE 102C0001        	  3904:     move.b  ($0001,A4),D0
                            	  3905:     ; If the player is within the bounds of the doorway for DoorwayDir
                            	  3906:     ; (for example the left door way, if DoorwayDir = left;
                            	  3907:     ; instead of right doorway while DoorwayDir = left),
                            	  3908:     ; and player is facing in DoorwayDir, then go repeat the
