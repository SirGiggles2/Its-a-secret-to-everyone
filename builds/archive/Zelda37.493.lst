                            	   739: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F536 1214            	   740:     move.b  ($00,A4),D1   ; ptr lo
02:0002F538 182C0001        	   741:     move.b  ($01,A4),D4  ; ptr hi
02:0002F53C 024100FF        	   742:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F540 E14C            	   743:     lsl.w   #8,D4
02:0002F542 8841            	   744:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F544 48C4            	   745:     ext.l   D4
02:0002F546 D8BC00FF0000    	   746:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F54C 2044            	   747:     movea.l D4,A0
02:0002F54E 10303000        	   748:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F552 122C0002        	   749:     move.b  ($02,A4),D1   ; ptr lo
02:0002F556 182C0003        	   750:     move.b  ($03,A4),D4  ; ptr hi
02:0002F55A 024100FF        	   751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F55E E14C            	   752:     lsl.w   #8,D4
02:0002F560 8841            	   753:     or.w    D1,D4
02:0002F562 48C4            	   754:     ext.l   D4
02:0002F564 D8BC00FF0000    	   755:     add.l   #NES_RAM,D4
02:0002F56A 2044            	   756:     movea.l D4,A0
02:0002F56C 11803000        	   757:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
