                            	  7980: UpdateGanon:
02:0003BA62 102C0445        	  7981:     move.b  ($0445,A4),D0
02:0003BA66 4EB90002AEF2    	  7982:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7983:     even
                            	  7984: UpdateGanon_JumpTable:
02:0003BA6C 0003BA78        	  7985:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BA70 0003BADA        	  7986:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BA74 0003BB08        	  7987:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  7988: 
                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0003BA78 701B            	  7996:     moveq   #27,D0
02:0003BA7A 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0003BA7E 102C0028        	  8000:     move.b  ($0028,A4),D0
02:0003BA82 6644            	  8001:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8002:     ; Once the timer expires, it's time to brighten the room.
                            	  8003:     ;
                            	  8004:     ; Save the current object slot.
02:0003BA84 1002            	  8005:     move.b  D2,D0
02:0003BA86 1B00            	  8006:     move.b  D0,-(A5)  ; PHA
02:0003BA88 610007F0        	  8007:     jsr     UpdateCandle
02:0003BA8C 101D            	  8008:     move.b  (A5)+,D0  ; PLA
02:0003BA8E 7400            	  8009:     moveq   #0,D2
02:0003BA90 1400            	  8010:     move.b  D0,D2
                            	  8011:     ; Turn off the room brightening flag, because we're controlling it
                            	  8012:     ; here instead of in the Mode 5 object update loop.
                            	  8013:     ;
02:0003BA92 7000            	  8014:     moveq   #0,D0
02:0003BA94 1940051E        	  8015:     move.b  D0,($051E,A4)
                            	  8016:     ; On the first frame of the fade-to-light cycle, play the
                            	  8017:     ; Triforce/Ganon song.
                            	  8018:     ;
02:0003BA98 102C051C        	  8019:     move.b  ($051C,A4),D0
02:0003BA9C 0C0000C0        	  8020:     cmpi.b  #$C0,D0
02:0003BAA0 6606            	  8021:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BAA2 7002            	  8022:     moveq   #2,D0
02:0003BAA4 19400600        	  8023:     move.b  D0,($0600,A4)
                            	  8024:     even
                            	  8025: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8026:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8027:     ;
02:0003BAA8 102C051C        	  8028:     move.b  ($051C,A4),D0
02:0003BAAC 0200000F        	  8029:     andi.b #$0F,D0
02:0003BAB0 0C000004        	  8030:     cmpi.b  #$04,D0
02:0003BAB4 6702            	  8031:     beq.s  __far_z_04_0087
02:0003BAB6 6042            	  8032:     jmp  Ganon_DrawBodyFrame0
                            	  8033: __far_z_04_0087:
                            	  8034:     ; Set Link's timer to $C0 for the next scene phase.
