                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002AA02 0000EA02        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA06 00012A02
02:0002AA0A 00016A02        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0002AA0E 0001AA02
02:0002AA12 0001EA02        	  1715:     dc.l    _nes_bank_04_data, _nes_bank_05_data
02:0002AA16 00022A02
02:0002AA1A 00026A02        	  1716:     dc.l    _nes_bank_06_data, 0
02:0002AA1E 00000000
