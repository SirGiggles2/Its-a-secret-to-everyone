                            	  9774: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9775:     ; Here the eye is closed. So animate it this way.
                            	  9776:     ; Increment the animation counter, and if <> 8, then
                            	  9777:     ; go shoot, draw, and check collisions.
                            	  9778:     ;
02:0003D27E 41EC0478        	  9779:     lea     ($0478,A4),A0
02:0003D282 52302000        	  9780:     addq.b  #1,(A0,D2.W)
02:0003D286 41EC0478        	  9781:     lea     ($0478,A4),A0
02:0003D28A 10302000        	  9782:     move.b  (A0,D2.W),D0
02:0003D28E 0C000008        	  9783:     cmpi.b  #$08,D0
02:0003D292 66C2            	  9784:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9785:     ; Roll over the eye animation counter to 0.
                            	  9786:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9787:     ;
02:0003D294 7000            	  9788:     moveq   #0,D0
02:0003D296 41EC0478        	  9789:     lea     ($0478,A4),A0
02:0003D29A 11802000        	  9790:     move.b  D0,(A0,D2.W)
02:0003D29E 41EC046B        	  9791:     lea     ($046B,A4),A0
02:0003D2A2 10302000        	  9792:     move.b  (A0,D2.W),D0
02:0003D2A6 02000001        	  9793:     andi.b #$01,D0
02:0003D2AA 0A000001        	  9794:     eori.b #$01,D0
                            	  9795:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	  9796:     ;
02:0003D2AE 609E            	  9797:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	  9798: 
                            	  9799:     even
