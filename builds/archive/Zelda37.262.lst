                            	  6084: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6085:     ; Store the weapon's frame (horizontal or vertical)
                            	  6086:     ; for the direction chosen above in [0C].
                            	  6087:     ;
02:0004B8A0 4EB90003081E    	  6088:     jsr     GetOppositeDir
02:0004B8A6 41F90004B2DA    	  6089:     lea     (RDirectionToWeaponFrame).l,A0
02:0004B8AC 10303000        	  6090:     move.b  (A0,D3.W),D0
02:0004B8B0 1940000C        	  6091:     move.b  D0,($000C,A4)
                            	  6092:     ; Calculate sprite attributes.
                            	  6093:     ;
                            	  6094:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6095:     ;   base attribute OR 1
                            	  6096:     ; So, it uses palette row 5.
                            	  6097:     ;
02:0004B8B4 41F90004B2DE    	  6098:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004B8BA 10303000        	  6099:     move.b  (A0,D3.W),D0
02:0004B8BE 0C02000D        	  6100:     cmpi.b  #$0D,D2
02:0004B8C2 6706            	  6101:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:0004B8C4 00000001        	  6102:     ori.b #$01,D0
02:0004B8C8 601C            	  6103:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6104: 
                            	  6105:     even
                            	  6106: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6107:     ; The weapon is the sword.
                            	  6108:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6109:     ;
02:0004B8CA 023C00EE        	  6110:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B8CE 122C0657        	  6111:     move.b  ($0657,A4),D1
02:0004B8D2 D101            	  6112:     addx.b  D1,D0   ; ADC Items
02:0004B8D4 003C0011        	  6113:     ori     #$11,CCR  ; SEC: set C+X
02:0004B8D8 123C0001        	  6114:     move.b  #$01,D1
02:0004B8DC 0A3C0010        	  6115:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004B8E0 9101            	  6116:     subx.b  D1,D0   ; SBC #$01
02:0004B8E2 0A3C0010        	  6117:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6118:     even
                            	  6119: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6120:     ; Set sprite attributes to the calculated value above.
                            	  6121:     ;
02:0004B8E6 4EB90003101A    	  6122:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  6123:     ; If the direction is left, set [0F] to flip horizontally.
                            	  6124:     ;
02:0004B8EC 0C030002        	  6125:     cmpi.b  #$02,D3
02:0004B8F0 6604            	  6126:     bne  _anon_z07_33
02:0004B8F2 522C000F        	  6127:     addq.b  #1,($000F,A4)
                            	  6128: _anon_z07_33:
                            	  6129:     ; If state = 1, return. Don't show the weapon.
                            	  6130:     ;
02:0004B8F6 41EC00AC        	  6131:     lea     ($00AC,A4),A0
02:0004B8FA 10302000        	  6132:     move.b  (A0,D2.W),D0
02:0004B8FE 0200000F        	  6133:     andi.b #$0F,D0
02:0004B902 0C000001        	  6134:     cmpi.b  #$01,D0
02:0004B906 6604            	  6135:     bne.s  __far_z_07_0091
02:0004B908 600000AA        	  6136:     jmp  L1F854_Exit
                            	  6137: __far_z_07_0091:
                            	  6138:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  6139:     ; sword or rod
                            	  6140:     ;
                            	  6141:     ;
                            	  6142:     ; Sword slot
02:0004B90C 7600            	  6143:     moveq   #0,D3
02:0004B90E 0C02000D        	  6144:     cmpi.b  #$0D,D2
02:0004B912 6702            	  6145:     beq  _anon_z07_34
