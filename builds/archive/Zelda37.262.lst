02:0003A580 24              	  3638:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003A581 0B
02:0003A582 1C
02:0003A583 22
02:0003A584 34
02:0003A585 3D
02:0003A586 4E
                            	  3639: 
                            	  3640:     even
                            	  3641: SecretArmosXs:
02:0003A588 E0              	  3642:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003A589 B0
02:0003A58A B0
02:0003A58B 30
02:0003A58C 40
02:0003A58D 90
02:0003A58E A0
