02:000412B2 41F900041238    	  4066:     lea     (DoorwayBoundsMaxOver).l,A0
02:000412B8 12303000        	  4067:     move.b  (A0,D3.W),D1
02:000412BC B001            	  4068:     cmp.b   D1,D0
02:000412BE 640E            	  4069:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
