02:00049E96 4EB900030ACA    	  2365:     jsr     MapScreenPosToPpuAddr
02:00049E9C 7400            	  2366:     moveq   #0,D2
02:00049E9E 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:00049EA2 1014            	  2375:     move.b  ($0000,A4),D0
02:00049EA4 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00049EA8 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:00049EAC 41EC0307        	  2378:     lea     ($0307,A4),A0
02:00049EB0 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:00049EB4 102C0001        	  2383:     move.b  ($0001,A4),D0
02:00049EB8 41EC0303        	  2384:     lea     ($0303,A4),A0
02:00049EBC 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:00049EC0 41EC0308        	  2386:     lea     ($0308,A4),A0
02:00049EC4 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:00049EC8 41EC0308        	  2388:     lea     ($0308,A4),A0
02:00049ECC 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:00049ED0 102C0005        	  2392:     move.b  ($0005,A4),D0
02:00049ED4 41EC0305        	  2393:     lea     ($0305,A4),A0
02:00049ED8 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:00049EDC 41EC0306        	  2395:     lea     ($0306,A4),A0
02:00049EE0 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:00049EE4 41EC030A        	  2397:     lea     ($030A,A4),A0
02:00049EE8 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:00049EEC 41EC030B        	  2399:     lea     ($030B,A4),A0
02:00049EF0 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
                            	  2403:     ; Here is an example result of this manipulation:
                            	  2404:     ;   record 1: $70, $71
                            	  2405:     ;   record 2: $72, $73
                            	  2406:     ;
02:00049EF4 0C000046        	  2407:     cmpi.b  #$46,D0
02:00049EF8 6530            	  2408:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00049EFA 0C0000F3        	  2409:     cmpi.b  #$F3,D0
02:00049EFE 642A            	  2410:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00049F00 023C00EE        	  2411:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049F04 123C0002        	  2412:     move.b  #$02,D1
02:00049F08 D101            	  2413:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049F0A 41EC030A        	  2414:     lea     ($030A,A4),A0
02:00049F0E 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:00049F12 41EC030B        	  2416:     lea     ($030B,A4),A0
02:00049F16 11802000        	  2417:     move.b  D0,(A0,D2.W)
02:00049F1A 41EC0306        	  2418:     lea     ($0306,A4),A0
02:00049F1E 52302000        	  2419:     addq.b  #1,(A0,D2.W)
02:00049F22 41EC030B        	  2420:     lea     ($030B,A4),A0
02:00049F26 52302000        	  2421:     addq.b  #1,(A0,D2.W)
