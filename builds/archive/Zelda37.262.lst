02:0002BFA8 08000008        	  2347:     btst    #8,D0
02:0002BFAC 670A            	  2348:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2349:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2350:     eori    #$01,CCR
02:0002BFB6 4E75            	  2351:     rts
                            	  2352: .cc_cnras:
02:0002BFB8 023C00FE        	  2353:     andi    #$FE,CCR
02:0002BFBC 0A3C0001        	  2354:     eori    #$01,CCR
02:0002BFC0 4E75            	  2355:     rts
