                            	  9550:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9551:     ;
02:0003D0D0 02000040        	  9552:     andi.b #$40,D0
02:0003D0D4 6704            	  9553:     beq  _anon_z04_116
02:0003D0D6 522C000F        	  9554:     addq.b  #1,($000F,A4)
                            	  9555: _anon_z04_116:
02:0003D0DA 101D            	  9556:     move.b  (A5)+,D0  ; PLA
                            	  9557:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9558:     ; These are the 2 frame images of the horizontal hands.
                            	  9559:     ;
                            	  9560:     ; Else draw the base and vertical hands mirrored.
                            	  9561:     ;
02:0003D0DC 0200000F        	  9562:     andi.b #$0F,D0
02:0003D0E0 0C000002        	  9563:     cmpi.b  #$02,D0
