02:0003AF36 61000104        	  5016:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5017:     ; The default image is the hand open.
                            	  5018:     ; If animation frame = 0, then return.
                            	  5019:     ;
02:0003AF3A 7400            	  5020:     moveq   #0,D2
02:0003AF3C 142C0340        	  5021:     move.b  ($0340,A4),D2
02:0003AF40 41EC03E4        	  5022:     lea     ($03E4,A4),A0
