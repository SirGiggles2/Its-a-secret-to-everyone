02:00043582 1B00            	  7112:     move.b  D0,-(A5)  ; PHA
02:00043584 7400            	  7113:     moveq   #0,D2
02:00043586 1400            	  7114:     move.b  D0,D2
                            	  7115:     ; Align the object's Y coordinate with 16 pixels.
                            	  7116:     ;
02:00043588 41EC0084        	  7117:     lea     ($0084,A4),A0
02:0004358C 10302000        	  7118:     move.b  (A0,D2.W),D0
02:00043590 020000F0        	  7119:     andi.b #$F0,D0
                            	  7120:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7121:     ; the height of each row.
                            	  7122:     ;
02:00043594 003C0011        	  7123:     ori     #$11,CCR  ; SEC: set C+X
02:00043598 123C0040        	  7124:     move.b  #$40,D1
02:0004359C 0A3C0010        	  7125:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000435A0 9101            	  7126:     subx.b  D1,D0   ; SBC #$40
02:000435A2 0A3C0010        	  7127:     eori    #$10,CCR  ; restore X = 6502 C
02:000435A6 E208            	  7128:     lsr.b  #1,D0   ; LSR A
02:000435A8 E208            	  7129:     lsr.b  #1,D0   ; LSR A
02:000435AA E208            	  7130:     lsr.b  #1,D0   ; LSR A
                            	  7131:     ; Add this row offset to the column address.
                            	  7132:     ;
02:000435AC 4EB9000309DC    	  7133:     jsr     AddToInt16At0
                            	  7134:     ; Assume that we'll write a type 1 square with primary square
                            	  7135:     ; taken from [05]. If so, the square index doesn't matter
                            	  7136:     ; as long as >= $10. See WriteSquareOW.
                            	  7137:     ;
02:000435B2 7600            	  7138:     moveq   #0,D3
02:000435B4 7410            	  7139:     moveq   #16,D2
02:000435B6 102C0005        	  7140:     move.b  ($0005,A4),D0
                            	  7141:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7142:     ; So, we have to look up the square index corresponding
                            	  7143:     ; to primary square/tile in [05].
                            	  7144:     ;
                            	  7145:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7146:     ; then the X register will have the square index value.
                            	  7147:     ;
02:000435BA 0C000027        	  7148:     cmpi.b  #$27,D0
