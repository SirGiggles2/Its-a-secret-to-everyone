                            	  7339: _L_z07_InitObject_InitMonsterFromEdge:
02:0004C254 7400            	  7340:     moveq   #0,D2
02:0004C256 142C0340        	  7341:     move.b  ($0340,A4),D2
                            	  7342:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7343:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7344:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7345:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7346:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7347:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7348:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7349:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7350:     ; corrupting them and causing a deterministic address-error
                            	  7351:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7352:     ; identified by Codex static review.)
                            	  7353: _L_z07_P47_pre_check:
02:0004C25A 102C0525        	  7354:     move.b  ($0525,A4),D0
02:0004C25E 020000F0        	  7355:     andi.b  #$F0,D0
02:0004C262 0C000040        	  7356:     cmpi.b  #$40,D0
02:0004C266 6506            	  7357:     blo     _L_z07_P47_pre_snap
02:0004C268 0C0000E0        	  7358:     cmpi.b  #$E0,D0
02:0004C26C 6506            	  7359:     blo     _L_z07_P47_pre_ok
                            	  7360: _L_z07_P47_pre_snap:
02:0004C26E 197C00480525    	  7361:     move.b  #$48,($0525,A4)
                            	  7362: _L_z07_P47_pre_ok:
02:0004C274 7005            	  7363:     moveq   #5,D0
02:0004C276 610004F4        	  7364:     jsr     SwitchBank
02:0004C27A 4EB90004100C    	  7365:     jsr     FindNextEdgeSpawnCell
                            	  7366:     ; Post-walk 1: bottom-edge snap.
02:0004C280 102C0525        	  7367:     move.b  ($0525,A4),D0
02:0004C284 020000F0        	  7368:     andi.b  #$F0,D0
02:0004C288 0C0000E0        	  7369:     cmpi.b  #$E0,D0
02:0004C28C 660C            	  7370:     bne     _L_z07_P47_post1_ok
02:0004C28E 197C00480525    	  7371:     move.b  #$48,($0525,A4)
02:0004C294 4EB90004100C    	  7372:     jsr     FindNextEdgeSpawnCell
                            	  7373: _L_z07_P47_post1_ok:
                            	  7374:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7375:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004C29A 7600            	  7376:     moveq   #0,D3
02:0004C29C 162C0525        	  7377:     move.b  ($0525,A4),D3
02:0004C2A0 0243000F        	  7378:     andi.w  #$000F,D3
02:0004C2A4 C6FC002C        	  7379:     mulu.w  #44,D3
02:0004C2A8 203C00FF6530    	  7380:     move.l  #$FF6530,D0
02:0004C2AE D083            	  7381:     add.l   D3,D0
02:0004C2B0 7600            	  7382:     moveq   #0,D3
02:0004C2B2 162C0525        	  7383:     move.b  ($0525,A4),D3
02:0004C2B6 E84B            	  7384:     lsr.w   #4,D3
02:0004C2B8 5943            	  7385:     subi.w  #4,D3
02:0004C2BA E34B            	  7386:     lsl.w   #1,D3
02:0004C2BC D083            	  7387:     add.l   D3,D0
02:0004C2BE 2040            	  7388:     movea.l D0,A0
02:0004C2C0 1010            	  7389:     move.b  (A0),D0
02:0004C2C2 0C000084        	  7390:     cmpi.b  #$84,D0
02:0004C2C6 6544            	  7391:     blo     _L_z07_P47_post2_ok
                            	  7392:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7393:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7394:     ; writes to the $05xx region.
02:0004C2C8 7800            	  7395:     moveq   #0,D4
                            	  7396: _L_z07_P47_fb_loop:
02:0004C2CA 41FAE48C        	  7397:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004C2CE 12304000        	  7398:     move.b  (A0,D4.W),D1
02:0004C2D2 19410525        	  7399:     move.b  D1,($0525,A4)
                            	  7400:     ; Validate fallback cell walkable.
02:0004C2D6 7600            	  7401:     moveq   #0,D3
02:0004C2D8 1601            	  7402:     move.b  D1,D3
02:0004C2DA 0243000F        	  7403:     andi.w  #$000F,D3
02:0004C2DE C6FC002C        	  7404:     mulu.w  #44,D3
02:0004C2E2 203C00FF6530    	  7405:     move.l  #$FF6530,D0
02:0004C2E8 D083            	  7406:     add.l   D3,D0
02:0004C2EA 7600            	  7407:     moveq   #0,D3
02:0004C2EC 1601            	  7408:     move.b  D1,D3
02:0004C2EE E84B            	  7409:     lsr.w   #4,D3
02:0004C2F0 5943            	  7410:     subi.w  #4,D3
02:0004C2F2 E34B            	  7411:     lsl.w   #1,D3
02:0004C2F4 D083            	  7412:     add.l   D3,D0
02:0004C2F6 2040            	  7413:     movea.l D0,A0
02:0004C2F8 0C100084        	  7414:     cmpi.b  #$84,(A0)
02:0004C2FC 650E            	  7415:     blo     _L_z07_P47_post2_ok
02:0004C2FE 5204            	  7416:     addq.b  #1,D4
02:0004C300 0C040008        	  7417:     cmpi.b  #8,D4
02:0004C304 65C4            	  7418:     blo     _L_z07_P47_fb_loop
                            	  7419:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7420:     ; rather than looping).
02:0004C306 197C00480525    	  7421:     move.b  #$48,($0525,A4)
                            	  7422: _L_z07_P47_post2_ok:
                            	  7423:     ; Extract and set the monster's location.
                            	  7424:     ;
02:0004C30C 102C0525        	  7425:     move.b  ($0525,A4),D0
                            	  7426:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7427:     ;
02:0004C310 1B00            	  7428:     move.b  D0,-(A5)  ; PHA
02:0004C312 E308            	  7429:     lsl.b  #1,D0   ; ASL A
02:0004C314 E308            	  7430:     lsl.b  #1,D0   ; ASL A
02:0004C316 E308            	  7431:     lsl.b  #1,D0   ; ASL A
02:0004C318 E308            	  7432:     lsl.b  #1,D0   ; ASL A
02:0004C31A 19802070        	  7433:     move.b  D0,($70,A4,D2.W)
                            	  7434:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7435:     ;
02:0004C31E 101D            	  7436:     move.b  (A5)+,D0  ; PLA
02:0004C320 020000F0        	  7437:     andi.b #$F0,D0
02:0004C324 003C0011        	  7438:     ori     #$11,CCR  ; SEC: set C+X
