02:00039FAC 41EC03E4        	  2842:     lea     ($03E4,A4),A0
02:00039FB0 10302000        	  2843:     move.b  (A0,D2.W),D0
02:00039FB4 610005BE        	  2844:     jsr     DrawObjectNotMirroredAndCheckLinkCollision
                            	  2845:     ; If the boulder's Y < $F0, return.
                            	  2846:     ;
02:00039FB8 41EC0084        	  2847:     lea     ($0084,A4),A0
02:00039FBC 10302000        	  2848:     move.b  (A0,D2.W),D0
02:00039FC0 0C0000F0        	  2849:     cmpi.b  #$F0,D0
02:00039FC4 6402            	  2850:     bcc.s  __far_z_04_0024
02:00039FC6 6032            	  2851:     jmp  L10A10_Exit
                            	  2852: __far_z_04_0024:
                            	  2853:     ; Else the boulder is close enough to the bottom of the screen
