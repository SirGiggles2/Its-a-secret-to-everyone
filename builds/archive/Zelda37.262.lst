02:0003A25A 41EC0098        	  3189:     lea     ($0098,A4),A0
02:0003A25E 10302000        	  3190:     move.b  (A0,D2.W),D0
02:0003A262 02000008        	  3191:     andi.b #$08,D0
02:0003A266 6704            	  3192:     beq  _anon_z04_44
02:0003A268 163C00D8        	  3193:     move.b  #$D8,D3
                            	  3194: _anon_z04_44:
02:0003A26C 1883            	  3195:     move.b  D3,($0000,A4)
                            	  3196:     ; Add Link's Y and the vertical offset.
                            	  3197:     ;
02:0003A26E 102C0084        	  3198:     move.b  ($0084,A4),D0
