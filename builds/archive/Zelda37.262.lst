02:0003D002 10342070        	  9468:     move.b  ($70,A4,D2.W),D0
02:0003D006 122C0003        	  9469:     move.b  ($0003,A4),D1
02:0003D00A 0A3C0010        	  9470:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D00E 9101            	  9471:     subx.b  D1,D0   ; SBC $03
02:0003D010 0A3C0010        	  9472:     eori    #$10,CCR  ; restore X = 6502 C
