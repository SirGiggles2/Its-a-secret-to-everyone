02:00035AD2 0C0000A0        	  4918:     cmpi.b  #$A0,D0
02:00035AD6 6406            	  4919:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:00035AD8 7023            	  4920:     moveq   #35,D0
