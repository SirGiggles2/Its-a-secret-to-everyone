02:0004B23E 600000AA        	  5191:     jmp  UpdateArrowOrBoomerang
                            	  5192: __far_z_07_0079:
                            	  5193:     ; The object is food.
                            	  5194:     ;
                            	  5195:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5196:     ; If we reach state $83, then go deactivate the object.
                            	  5197:     ;
                            	  5198:     ; Nothing changes between the states. So, they are used as
                            	  5199:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5200:     ;
02:0004B242 10342028        	  5201:     move.b  ($28,A4,D2.W),D0
02:0004B246 6622            	  5202:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004B248 41EC00AC        	  5203:     lea     ($00AC,A4),A0
02:0004B24C 52302000        	  5204:     addq.b  #1,(A0,D2.W)
02:0004B250 41EC00AC        	  5205:     lea     ($00AC,A4),A0
02:0004B254 10302000        	  5206:     move.b  (A0,D2.W),D0
02:0004B258 0200000F        	  5207:     andi.b #$0F,D0
02:0004B25C 0C000003        	  5208:     cmpi.b  #$03,D0
02:0004B260 674C            	  5209:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004B262 103C00FF        	  5210:     move.b  #$FF,D0
02:0004B266 19802028        	  5211:     move.b  D0,($28,A4,D2.W)
                            	  5212:     even
                            	  5213: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
