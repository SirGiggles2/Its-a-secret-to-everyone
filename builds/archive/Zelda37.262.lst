02:0003E350 41EC0394        	 12034:     lea     ($0394,A4),A0
02:0003E354 11802000        	 12035:     move.b  D0,(A0,D2.W)
                            	 12036:     ; This location is right above Patra.
                            	 12037:     ; Set X coordinate to Patra's.
                            	 12038:     ;
