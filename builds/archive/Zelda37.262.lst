                            	  4755: ; Params:
                            	  4756: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  4757: ; [00]: weapon object slot (unused)
                            	  4758: ; [02]: object 1 mid X
                            	  4759: ; [03]: object 1 mid Y
                            	  4760: ; [04]: object 2 mid X
                            	  4761: ; [05]: object 2 mid Y
