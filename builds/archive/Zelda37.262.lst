02:0003E484 1002            	 12192:     move.b  D2,D0
02:0003E486 1B00            	 12193:     move.b  D0,-(A5)  ; PHA
02:0003E488 610007F0        	 12194:     jsr     UpdateCandle
02:0003E48C 101D            	 12195:     move.b  (A5)+,D0  ; PLA
02:0003E48E 7400            	 12196:     moveq   #0,D2
02:0003E490 1400            	 12197:     move.b  D0,D2
                            	 12198:     ; Turn off the room brightening flag, because we're controlling it
                            	 12199:     ; here instead of in the Mode 5 object update loop.
                            	 12200:     ;
02:0003E492 7000            	 12201:     moveq   #0,D0
02:0003E494 1940051E        	 12202:     move.b  D0,($051E,A4)
                            	 12203:     ; On the first frame of the fade-to-light cycle, play the
