                            	  4765: ; Y: weapon object slot
                            	  4766: ; Z: 0 if objects collide
                            	  4767: ; [06]: 1 if objects collide
                            	  4768: ; [0A]: horizontal distance
                            	  4769: ; [0B]: vertical distance
                            	  4770: ;
                            	  4771: ;
                            	  4772: ; Use the same threshold value horizontally and vertically.
                            	  4773: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  4774: ;
