02:0003C032 122C0015        	  7363:     move.b  ($0015,A4),D1
02:0003C036 C001            	  7364:     and.b  D1,D0
02:0003C038 6710            	  7365:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7366:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7367:     ; in order to index into the second set of frame image numbers.
                            	  7368:     ;
02:0003C03A 1003            	  7369:     move.b  D3,D0
02:0003C03C 023C00EE        	  7370:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C040 123C0005        	  7371:     move.b  #$05,D1
02:0003C044 D101            	  7372:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003C046 7600            	  7373:     moveq   #0,D3
02:0003C048 1600            	  7374:     move.b  D0,D3
                            	  7375:     even
                            	  7376: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7377:     ; Start preparing sprites.
                            	  7378:     ;
02:0003C04A 4EB90004BE18    	  7379:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003C050 1003            	  7380:     move.b  D3,D0
02:0003C052 1B00            	  7381:     move.b  D0,-(A5)  ; PHA
                            	  7382:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7383:     ;
02:0003C054 41F90003BFAE    	  7384:     lea     (DodongoFrameHFlips).l,A0
02:0003C05A 10303000        	  7385:     move.b  (A0,D3.W),D0
02:0003C05E 1940000F        	  7386:     move.b  D0,($000F,A4)
02:0003C062 41F90003BFA4    	  7387:     lea     (DodongoFrameImages).l,A0
02:0003C068 10303000        	  7388:     move.b  (A0,D3.W),D0
                            	  7389:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7390:     ; They are drawn mirrored.
                            	  7391:     ;
02:0003C06C 0C000007        	  7392:     cmpi.b  #$07,D0
02:0003C070 6706            	  7393:     beq  _anon_z04_92
02:0003C072 0C000009        	  7394:     cmpi.b  #$09,D0
02:0003C076 6608            	  7395:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7396: _anon_z04_92:
