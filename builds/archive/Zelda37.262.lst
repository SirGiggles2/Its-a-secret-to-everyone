                            	  5957:     even
                            	  5958: UpdateSwordOrRod:
                            	  5959:     ; If state = 0, the object is not active. So, return.
                            	  5960:     ;
02:0004B79C 41EC00AC        	  5961:     lea     ($00AC,A4),A0
02:0004B7A0 10302000        	  5962:     move.b  (A0,D2.W),D0
02:0004B7A4 0200000F        	  5963:     andi.b #$0F,D0
02:0004B7A8 674C            	  5964:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5965:     ; Decrement the state timer.
                            	  5966:     ; If it hasn't expired, go move the sword or rod.
                            	  5967:     ;
02:0004B7AA 41EC03D0        	  5968:     lea     ($03D0,A4),A0
02:0004B7AE 53302000        	  5969:     subq.b  #1,(A0,D2.W)
02:0004B7B2 6644            	  5970:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5971:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5972:     ;
02:0004B7B4 41EC00AC        	  5973:     lea     ($00AC,A4),A0
02:0004B7B8 10302000        	  5974:     move.b  (A0,D2.W),D0
02:0004B7BC 0200000F        	  5975:     andi.b #$0F,D0
02:0004B7C0 7600            	  5976:     moveq   #0,D3
02:0004B7C2 1600            	  5977:     move.b  D0,D3
02:0004B7C4 7008            	  5978:     moveq   #8,D0
02:0004B7C6 5303            	  5979:     subq.b  #1,D3
02:0004B7C8 6702            	  5980:     beq  _anon_z07_32
02:0004B7CA 7001            	  5981:     moveq   #1,D0
                            	  5982: _anon_z07_32:
                            	  5983:     ; Set both the player's animation counter and the sword's
                            	  5984:     ; animation counter/timer to this value.
                            	  5985:     ;
02:0004B7CC 194003D0        	  5986:     move.b  D0,($03D0,A4)
02:0004B7D0 41EC03D0        	  5987:     lea     ($03D0,A4),A0
02:0004B7D4 11802000        	  5988:     move.b  D0,(A0,D2.W)
                            	  5989:     ; Go to the next state.
                            	  5990:     ;
02:0004B7D8 41EC00AC        	  5991:     lea     ($00AC,A4),A0
02:0004B7DC 52302000        	  5992:     addq.b  #1,(A0,D2.W)
                            	  5993:     ; Once we reach state 6, deactivate the object.
                            	  5994:     ; Otherwise, go draw it.
                            	  5995:     ;
02:0004B7E0 41EC00AC        	  5996:     lea     ($00AC,A4),A0
02:0004B7E4 10302000        	  5997:     move.b  (A0,D2.W),D0
02:0004B7E8 0200000F        	  5998:     andi.b #$0F,D0
02:0004B7EC 0C000006        	  5999:     cmpi.b  #$06,D0
02:0004B7F0 6506            	  6000:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:0004B7F2 610001C2        	  6001:     jsr     ResetObjState
