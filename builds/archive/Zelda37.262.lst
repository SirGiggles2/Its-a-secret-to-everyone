02:00032B90 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00032B94 E14C            	   559:     lsl.w   #8,D4
02:00032B96 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
