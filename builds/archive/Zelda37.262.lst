                            	 12753: Ganon_CheckCollisions:
                            	 12754:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12755:     ; Store in [02] and [03].
                            	 12756:     ;
02:0003E86E 10342070        	 12757:     move.b  ($70,A4,D2.W),D0
02:0003E872 023C00EE        	 12758:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E876 123C0010        	 12759:     move.b  #$10,D1
02:0003E87A D101            	 12760:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003E87C 19400002        	 12761:     move.b  D0,($0002,A4)
02:0003E880 41EC0084        	 12762:     lea     ($0084,A4),A0
02:0003E884 10302000        	 12763:     move.b  (A0,D2.W),D0
02:0003E888 023C00EE        	 12764:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E88C 123C0010        	 12765:     move.b  #$10,D1
02:0003E890 D101            	 12766:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003E892 19400003        	 12767:     move.b  D0,($0003,A4)
                            	 12768:     ; Check for a collision with Link.
                            	 12769:     ;
                            	 12770:     ; We can't call CheckLinkCollision, because we need to
                            	 12771:     ; customize Ganon's midpoint.
                            	 12772:     ;
                            	 12773:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12774:     ; detection, if Link is invincible. Initialize variables that will
                            	 12775:     ; be returned from the partial collision check routine. Then
                            	 12776:     ; call it.
                            	 12777:     ;
02:0003E896 102C04F0        	 12778:     move.b  ($04F0,A4),D0
02:0003E89A 6616            	 12779:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003E89C 19400006        	 12780:     move.b  D0,($0006,A4)
02:0003E8A0 19400009        	 12781:     move.b  D0,($0009,A4)
02:0003E8A4 1940000C        	 12782:     move.b  D0,($000C,A4)
02:0003E8A8 7600            	 12783:     moveq   #0,D3
02:0003E8AA 1883            	 12784:     move.b  D3,($0000,A4)
02:0003E8AC 4EB9000311DA    	 12785:     jsr     CheckLinkCollisionPreinit
                            	 12786:     even
                            	 12787: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12788:     ; If Ganon is not in state 0, then he's brown.
                            	 12789:     ; Go check collision with an arrow.
                            	 12790:     ;
02:0003E8B2 41EC00AC        	 12791:     lea     ($00AC,A4),A0
02:0003E8B6 10302000        	 12792:     move.b  (A0,D2.W),D0
02:0003E8BA 6652            	 12793:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12794:     ; If timer <> 0, then Ganon is visible.
                            	 12795:     ; He can't be harmed like this. So, return.
                            	 12796:     ;
02:0003E8BC 10342028        	 12797:     move.b  ($28,A4,D2.W),D0
02:0003E8C0 664A            	 12798:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003E8C2 760D            	 12799:     moveq   #13,D3
02:0003E8C4 4EB9000316A4    	 12800:     jsr     CheckMonsterSwordCollision
                            	 12801:     ; If Ganon has died according to the usual collision check rules
                            	 12802:     ; (HP = 0), then:
                            	 12803:     ; 1. Restore HP to the initial value $F0
                            	 12804:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12805:     ; 3. Change palette row 7 to make Ganon brown
                            	 12806:     ;
02:0003E8CA 41EC0405        	 12807:     lea     ($0405,A4),A0
02:0003E8CE 10302000        	 12808:     move.b  (A0,D2.W),D0
02:0003E8D2 6718            	 12809:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003E8D4 103C00F0        	 12810:     move.b  #$F0,D0
02:0003E8D8 41EC0485        	 12811:     lea     ($0485,A4),A0
02:0003E8DC 11802000        	 12812:     move.b  D0,(A0,D2.W)
02:0003E8E0 41EC00AC        	 12813:     lea     ($00AC,A4),A0
02:0003E8E4 53302000        	 12814:     subq.b  #1,(A0,D2.W)
02:0003E8E8 61000084        	 12815:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12816:     even
                            	 12817: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12818:     ; If Ganon was harmed, then play the sound effect
                            	 12819:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12820:     ;
02:0003E8EC 41EC04F0        	 12821:     lea     ($04F0,A4),A0
02:0003E8F0 10302000        	 12822:     move.b  (A0,D2.W),D0
02:0003E8F4 670A            	 12823:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003E8F6 6100A414        	 12824:     jsr     PlayBossHitCryIfNeeded
02:0003E8FA 7040            	 12825:     moveq   #64,D0
02:0003E8FC 19802028        	 12826:     move.b  D0,($28,A4,D2.W)
                            	 12827:     even
                            	 12828: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12829:     ; Reset metastate, because Ganon cannot die this way.
                            	 12830:     ;
02:0003E900 4EB90004C618    	 12831:     jsr     ResetObjMetastate
                            	 12832:     ; Reset shove info and invincibility timer, because Ganon
                            	 12833:     ; doesn't react at all as a usual monster.
                            	 12834:     ;
02:0003E906 4EB9000315AC    	 12835:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12836:     even
                            	 12837: _L_z04_Ganon_CheckCollisions_Exit:
02:0003E90C 4E75            	 12838:     rts
                            	 12839: 
                            	 12840:     even
                            	 12841: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12842:     ; If the silver arrow is not in the inventory, then return.
