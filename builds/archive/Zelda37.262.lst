02:0003E760 0C020007        	 12620:     cmpi.b  #$07,D2
02:0003E764 670A            	 12621:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003E766 102C0015        	 12622:     move.b  ($0015,A4),D0
