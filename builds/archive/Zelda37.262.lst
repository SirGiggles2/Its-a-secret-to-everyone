02:0003A462 4EB90004BE18    	  3456:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3457:     ; If facing down, then use frame image offset 2.
                            	  3458:     ;
02:0003A468 41EC0098        	  3459:     lea     ($0098,A4),A0
02:0003A46C 10302000        	  3460:     move.b  (A0,D2.W),D0
02:0003A470 7600            	  3461:     moveq   #0,D3
02:0003A472 1600            	  3462:     move.b  D0,D3
02:0003A474 0200000C        	  3463:     andi.b #$0C,D0
02:0003A478 670C            	  3464:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003A47A 7002            	  3465:     moveq   #2,D0
