02:0003A002 1880            	  2889:     move.b  D0,($0000,A4)
02:0003A004 19430002        	  2890:     move.b  D3,($0002,A4)
                            	  2891:     ; Add the high speed byte to the Y coordinate.
                            	  2892:     ;
02:0003A008 41EC0412        	  2893:     lea     ($0412,A4),A0
