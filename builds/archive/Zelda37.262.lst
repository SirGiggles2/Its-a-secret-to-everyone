                            	  7184: DodongoBombPositiveLimits:
02:0003BF3E 0C              	  7185:     dc.b    $0C, $11
02:0003BF3F 11
                            	  7186: 
                            	  7187:     even
                            	  7188: DodongoBombNegativeLimits:
02:0003BF40 F4              	  7189:     dc.b    $F4, $F0
02:0003BF41 F0
                            	  7190: 
                            	  7191: ; Params:
                            	  7192: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7193: ; [00]: monster hotspot X
                            	  7194: ; [01]: monster hotspot Y
                            	  7195: ; [02]: bomb hotspot X
                            	  7196: ; [03]: bomb hotspot Y
                            	  7197: ;
                            	  7198: ; Returns:
                            	  7199: ; A: 0 if the bomb is in range of the monster
                            	  7200: ; Z: 1 if the bomb is in range of the monster
                            	  7201: ; [04]: horizontal distance
                            	  7202: ; [05]: vertical distance
                            	  7203: ;
                            	  7204: ; Store the positive limit in [06], and the negative one in [07].
                            	  7205: ;
                            	  7206:     even
                            	  7207: Dodongo_IsBombInRange:
02:0003BF42 41F90003BF3E    	  7208:     lea     (DodongoBombPositiveLimits).l,A0
02:0003BF48 10303000        	  7209:     move.b  (A0,D3.W),D0
02:0003BF4C 19400006        	  7210:     move.b  D0,($0006,A4)
02:0003BF50 41F90003BF40    	  7211:     lea     (DodongoBombNegativeLimits).l,A0
02:0003BF56 10303000        	  7212:     move.b  (A0,D3.W),D0
02:0003BF5A 19400007        	  7213:     move.b  D0,($0007,A4)
                            	  7214:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7215:     ; the bomb is near enough the monster.
                            	  7216:     ;
02:0003BF5E 7003            	  7217:     moveq   #3,D0
02:0003BF60 19400008        	  7218:     move.b  D0,($0008,A4)
                            	  7219:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7220:     ;
02:0003BF64 7601            	  7221:     moveq   #1,D3
                            	  7222:     even
                            	  7223: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7224:     ; Subtract the bomb's coordinate from the boss's,
                            	  7225:     ; The loop index determines the coordinate.
                            	  7226:     ;
02:0003BF66 10343000        	  7227:     move.b  ($00,A4,D3.W),D0
02:0003BF6A 003C0011        	  7228:     ori     #$11,CCR  ; SEC: set C+X
02:0003BF6E 12343002        	  7229:     move.b  ($02,A4,D3.W),D1
02:0003BF72 0A3C0010        	  7230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BF76 9101            	  7231:     subx.b  D1,D0   ; SBC $0002,Y
02:0003BF78 0A3C0010        	  7232:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7233:     ; If the distance >= positive offset, or < negative offset;
                            	  7234:     ; then loop again.
                            	  7235:     ;
02:0003BF7C 122C0006        	  7236:     move.b  ($0006,A4),D1
02:0003BF80 B001            	  7237:     cmp.b   D1,D0
02:0003BF82 6A16            	  7238:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003BF84 122C0007        	  7239:     move.b  ($0007,A4),D1
02:0003BF88 B001            	  7240:     cmp.b   D1,D0
02:0003BF8A 6B0E            	  7241:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7242:     ; The distance is close enough in this axis.
                            	  7243:     ;
                            	  7244:     ; Store the distance in this axis in [05] or [04],
                            	  7245:     ; depending on the loop index.
                            	  7246:     ;
02:0003BF8C 19803004        	  7247:     move.b  D0,($04,A4,D3.W)
                            	  7248:     ; Shift [08] right, because we're in range in this axis.
                            	  7249:     ;
02:0003BF90 122C0008        	  7250:     move.b  ($0008,A4),D1
02:0003BF94 E209            	  7251:     lsr.b  #1,D1   ; LSR $08
02:0003BF96 19410008        	  7252:     move.b  D1,($0008,A4)
                            	  7253:     even
                            	  7254: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003BF9A 5303            	  7255:     subq.b  #1,D3
02:0003BF9C 6AC8            	  7256:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7257:     ; If close enough in both axes, then [08] will be 0.
