02:0003EAD4 122C052A        	 13086:     move.b  ($052A,A4),D1
02:0003EAD8 D101            	 13087:     addx.b  D1,D0   ; ADC WorldKillCycle
02:0003EADA 7600            	 13088:     moveq   #0,D3
02:0003EADC 1600            	 13089:     move.b  D0,D3
02:0003EADE 41F90003EA16    	 13090:     lea     (DropItemTable).l,A0
02:0003EAE4 10303000        	 13091:     move.b  (A0,D3.W),D0
02:0003EAE8 1880            	 13092:     move.b  D0,($0000,A4)
                            	 13093:     ; If the global kill count = $10, set the dropped item to a fairy.
                            	 13094:     ;
02:0003EAEA 7023            	 13095:     moveq   #35,D0
02:0003EAEC 7600            	 13096:     moveq   #0,D3
02:0003EAEE 162C0627        	 13097:     move.b  ($0627,A4),D3
02:0003EAF2 0C030010        	 13098:     cmpi.b  #$10,D3
02:0003EAF6 6716            	 13099:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	 13100:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	 13101:     ; But there is a random chance that the item drop will be canceled.
                            	 13102:     ;
02:0003EAF8 102C0050        	 13103:     move.b  ($0050,A4),D0
02:0003EAFC 0C00000A        	 13104:     cmpi.b  #$0A,D0
02:0003EB00 651A            	 13105:     bcs  _L_z04_SetUpDroppedItem_RandomlyCancel
                            	 13106:     ; Otherwise, the item will be guaranteed to be made.
                            	 13107:     ; [51] HelpDropValue determines which kind:
                            	 13108:     ; - 0:     5 rupees
                            	 13109:     ; - other: bomb
                            	 13110:     ;
02:0003EB02 700F            	 13111:     moveq   #15,D0
02:0003EB04 7600            	 13112:     moveq   #0,D3
02:0003EB06 162C0051        	 13113:     move.b  ($0051,A4),D3
02:0003EB0A 6702            	 13114:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
02:0003EB0C 7000            	 13115:     moveq   #0,D0
                            	 13116:     even
