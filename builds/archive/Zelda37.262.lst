02:0003EA8A 5303            	 13044:     subq.b  #1,D3
02:0003EA8C 6AEE            	 13045:     bpl  _L_z04_SetUpDroppedItem_FindDrop1Type
                            	 13046:     ; Increment row number in [01] to 2.
                            	 13047:     ;
02:0003EA8E 522C0001        	 13048:     addq.b  #1,($0001,A4)
