                            	   733: _L_z01_CopyCommonCodeToRam_Loop:
02:0002EBC6 1214            	   734:     move.b  ($00,A4),D1   ; ptr lo
02:0002EBC8 182C0001        	   735:     move.b  ($01,A4),D4  ; ptr hi
02:0002EBCC 024100FF        	   736:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EBD0 E14C            	   737:     lsl.w   #8,D4
02:0002EBD2 8841            	   738:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002EBD4 48C4            	   739:     ext.l   D4
02:0002EBD6 D8BC00FF0000    	   740:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002EBDC 2044            	   741:     movea.l D4,A0
02:0002EBDE 10303000        	   742:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EBE2 122C0002        	   743:     move.b  ($02,A4),D1   ; ptr lo
02:0002EBE6 182C0003        	   744:     move.b  ($03,A4),D4  ; ptr hi
02:0002EBEA 024100FF        	   745:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EBEE E14C            	   746:     lsl.w   #8,D4
02:0002EBF0 8841            	   747:     or.w    D1,D4
02:0002EBF2 48C4            	   748:     ext.l   D4
02:0002EBF4 D8BC00FF0000    	   749:     add.l   #NES_RAM,D4
02:0002EBFA 2044            	   750:     movea.l D4,A0
02:0002EBFC 11803000        	   751:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   752:     ; Increment source address.
                            	   753:     ;
02:0002EC00 1014            	   754:     move.b  ($0000,A4),D0
02:0002EC02 023C00EE        	   755:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EC06 123C0001        	   756:     move.b  #$01,D1
02:0002EC0A D101            	   757:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EC0C 1880            	   758:     move.b  D0,($0000,A4)
02:0002EC0E 102C0001        	   759:     move.b  ($0001,A4),D0
02:0002EC12 123C0000        	   760:     move.b  #$00,D1
02:0002EC16 D101            	   761:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EC18 19400001        	   762:     move.b  D0,($0001,A4)
                            	   763:     ; Increment destination address.
                            	   764:     ;
02:0002EC1C 102C0002        	   765:     move.b  ($0002,A4),D0
02:0002EC20 023C00EE        	   766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EC24 123C0001        	   767:     move.b  #$01,D1
02:0002EC28 D101            	   768:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EC2A 19400002        	   769:     move.b  D0,($0002,A4)
02:0002EC2E 102C0003        	   770:     move.b  ($0003,A4),D0
02:0002EC32 123C0000        	   771:     move.b  #$00,D1
02:0002EC36 D101            	   772:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EC38 19400003        	   773:     move.b  D0,($0003,A4)
02:0002EC3C 0C00007F        	   774:     cmpi.b  #$7F,D0
02:0002EC40 6684            	   775:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002EC42 102C0002        	   776:     move.b  ($0002,A4),D0
02:0002EC46 4A00            	   777:     cmpi.b  #$00,D0
