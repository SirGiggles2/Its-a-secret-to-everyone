                            	   194: UpdateMenuUW_JumpTable:
02:0003F256 0003F2DC        	   195:     dc.l    UpdateMenu_Return   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F25A 0003F2A8        	   196:     dc.l    UpdateMenuCommon1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F25E 0003F2DE        	   197:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F262 0003F2F0        	   198:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F266 0003F2F6        	   199:     dc.l    UpdateMenuCommon4   ; jump table entry (32-bit for _m68k_tablejump)
