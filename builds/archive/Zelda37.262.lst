                            	  4231:     ; the screen edge, or stop moving.
                            	  4232:     ;
02:0004ABD0 4A02            	  4233:     cmpi.b  #$00,D2
02:0004ABD2 6602            	  4234:     bne.s  __far_z_07_0053
02:0004ABD4 6022            	  4235:     jmp  PlayerUnwalkable
                            	  4236: __far_z_07_0053:
