02:0003A8F8 023C00EE        	  4181:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8FC 123C0001        	  4182:     move.b  #$01,D1
02:0003A900 D101            	  4183:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
