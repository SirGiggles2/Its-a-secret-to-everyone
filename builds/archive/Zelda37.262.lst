02:0003A276 1214            	  3200:     move.b  ($0000,A4),D1
02:0003A278 D101            	  3201:     addx.b  D1,D0   ; ADC $00
                            	  3202:     ; Sanitize the Y coordinate:
                            	  3203:     ; (Y AND $F0) OR $D
