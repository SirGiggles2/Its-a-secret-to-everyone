                            	  4991: UpdateMode13WinGame_Sub3:
                            	  4992:     ; After scrolling 8 pixels, draw another tile row.
                            	  4993:     ;
02:00035B5A 102C050B        	  4994:     move.b  ($050B,A4),D0
02:00035B5E 0C000008        	  4995:     cmpi.b  #$08,D0
02:00035B62 6B1A            	  4996:     bmi  _anon_z02_37
02:00035B64 102C050B        	  4997:     move.b  ($050B,A4),D0
02:00035B68 123C0008        	  4998:     move.b  #$08,D1
02:00035B6C 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035B70 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:00035B72 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
02:00035B76 1940050B        	  5002:     move.b  D0,($050B,A4)
02:00035B7A 61000282        	  5003:     jsr     DrawCredits
                            	  5004: _anon_z02_37:
                            	  5005:     ; Add $80 to the scroll speed fraction.
                            	  5006:     ;
02:00035B7E 102C0058        	  5007:     move.b  ($0058,A4),D0
02:00035B82 023C00EE        	  5008:     andi    #$EE,CCR  ; CLC: clear C+X
02:00035B86 123C0080        	  5009:     move.b  #$80,D1
02:00035B8A D101            	  5010:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00035B8C 19400058        	  5011:     move.b  D0,($0058,A4)
                            	  5012:     ; Carry over to the tile offset and current V-scroll.
                            	  5013:     ;
02:00035B90 6404            	  5014:     bcc  _anon_z02_38
02:00035B92 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:00035B96 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:00035B9A 123C0000        	  5018:     move.b  #$00,D1
02:00035B9E D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035BA0 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
                            	  5024:     ;
02:00035BA4 0C0000F0        	  5025:     cmpi.b  #$F0,D0
02:00035BA8 7000            	  5026:     moveq   #0,D0
02:00035BAA 6508            	  5027:     bcs  _anon_z02_39
02:00035BAC 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:00035BB0 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
                            	  5031:     ; Roll the carry from the comparison above into bit 0.
                            	  5032:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5033:     ;
