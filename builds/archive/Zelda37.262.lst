02:00031AA0 41F900031A4C    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:00031AA6 10302000        	   130:     move.b  (A0,D2.W),D0
02:00031AAA 19400003        	   131:     move.b  D0,($0003,A4)
02:00031AAE 41F900031A52    	   132:     lea     (CommonPatternVramAddrs).l,A0
02:00031AB4 10302000        	   133:     move.b  (A0,D2.W),D0
