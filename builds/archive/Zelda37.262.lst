                            	   921: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   922:     move.l  D0,-(SP)
02:0002B6C8 7200            	   923:     moveq   #0,D1
02:0002B6CA 1202            	   924:     move.b  D2,D1
02:0002B6CC 2F01            	   925:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   926:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   927:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   928:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   929:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   930:     addq.l  #8,SP
02:0002B6E2 201F            	   931:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   932:     rts
