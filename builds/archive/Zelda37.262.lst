02:0003F5BE 532C00E9        	   663:     subq.b  #1,($00E9,A4)
02:0003F5C2 102C0084        	   664:     move.b  ($0084,A4),D0
02:0003F5C6 0C0000DD        	   665:     cmpi.b  #$DD,D0
02:0003F5CA 640A            	   666:     bcc  _anon_z05_9
02:0003F5CC 123C0008        	   667:     move.b  #$08,D1
02:0003F5D0 D101            	   668:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F5D2 19400084        	   669:     move.b  D0,($0084,A4)
                            	   670: _anon_z05_9:
02:0003F5D6 102C00E2        	   671:     move.b  ($00E2,A4),D0
02:0003F5DA 003C0011        	   672:     ori     #$11,CCR  ; SEC: set C+X
02:0003F5DE 123C0020        	   673:     move.b  #$20,D1
02:0003F5E2 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F5E6 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:0003F5E8 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F5EC 194000E2        	   677:     move.b  D0,($00E2,A4)
02:0003F5F0 6404            	   678:     bcc  _anon_z05_10
02:0003F5F2 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
02:0003F5F6 0C0000E0        	   681:     cmpi.b  #$E0,D0
02:0003F5FA 661E            	   682:     bne  _L_z05_ScrollWorld_Exit
02:0003F5FC 102C0058        	   683:     move.b  ($0058,A4),D0
02:0003F600 0C000020        	   684:     cmpi.b  #$20,D0
02:0003F604 6716            	   685:     beq  _L_z05_ScrollWorld_LimitLow
02:0003F606 0C000027        	   686:     cmpi.b  #$27,D0
02:0003F60A 660E            	   687:     bne  _L_z05_ScrollWorld_Exit
                            	   688:     ; VScroll address is $27E0. So, we rolled from the
                            	   689:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   690:     ; to $23A0, the true last row of NT 0.
02:0003F60C 7023            	   691:     moveq   #35,D0
02:0003F60E 19400058        	   692:     move.b  D0,($0058,A4)
02:0003F612 103C00A0        	   693:     move.b  #$A0,D0
02:0003F616 194000E2        	   694:     move.b  D0,($00E2,A4)
                            	   695:     even
