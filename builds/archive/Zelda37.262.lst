                            	  7736: UpdatePolsVoiceState1_Jumping:
                            	  7737:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7738:     ;
02:0003C302 41EC0444        	  7739:     lea     ($0444,A4),A0
02:0003C306 10302000        	  7740:     move.b  (A0,D2.W),D0
02:0003C30A 023C00EE        	  7741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C30E 123C0038        	  7742:     move.b  #$38,D1
02:0003C312 D101            	  7743:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003C314 41EC0444        	  7744:     lea     ($0444,A4),A0
02:0003C318 11802000        	  7745:     move.b  D0,(A0,D2.W)
                            	  7746:     ; Add Carry to high speed byte (vertical).
                            	  7747:     ;
02:0003C31C 41EC0412        	  7748:     lea     ($0412,A4),A0
02:0003C320 10302000        	  7749:     move.b  (A0,D2.W),D0
02:0003C324 123C0000        	  7750:     move.b  #$00,D1
02:0003C328 D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C32A 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003C32E 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
02:0003C332 023C00EE        	  7756:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C336 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003C33A 12302000        	  7758:     move.b  (A0,D2.W),D1
02:0003C33E D101            	  7759:     addx.b  D1,D0   ; ADC ObjY,X
02:0003C340 41EC0084        	  7760:     lea     ($0084,A4),A0
02:0003C344 11802000        	  7761:     move.b  D0,(A0,D2.W)
                            	  7762:     ; If the speed is still negative, then return.
                            	  7763:     ;
02:0003C348 41EC0412        	  7764:     lea     ($0412,A4),A0
02:0003C34C 10302000        	  7765:     move.b  (A0,D2.W),D0
