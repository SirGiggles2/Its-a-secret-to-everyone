02:0003989A 10302000        	  1764:     move.b  (A0,D2.W),D0
02:0003989E 0200000F        	  1765:     andi.b #$0F,D0
02:000398A2 023C00EE        	  1766:     andi    #$EE,CCR  ; CLC: clear C+X
02:000398A6 6608            	  1767:     bne  _L_z04_Gel_MoveSplitting_Exit
02:000398A8 41EC0394        	  1768:     lea     ($0394,A4),A0
02:000398AC 11802000        	  1769:     move.b  D0,(A0,D2.W)
