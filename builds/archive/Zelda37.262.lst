02:00043A7E 1B00            	  7401:     move.b  D0,-(A5)  ; PHA
02:00043A80 02000007        	  7402:     andi.b #$07,D0
02:00043A84 0C000002        	  7403:     cmpi.b  #$02,D0
02:00043A88 6606            	  7404:     bne  _anon_z05_156
02:00043A8A 7004            	  7405:     moveq   #4,D0
