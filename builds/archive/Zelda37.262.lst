                            	  3901:     even
                            	  3902: UpdatePondFairy:
02:0003A72C 610045AC        	  3903:     jsr     DrawFairy
                            	  3904:     ; If not in state 0, then go handle states 1 to 3.
                            	  3905:     ;
02:0003A730 102C00AD        	  3906:     move.b  ($00AD,A4),D0
02:0003A734 6702            	  3907:     beq.s  __far_z_04_0035
02:0003A736 602A            	  3908:     jmp  PondFairy_HandleOtherStates
                            	  3909: __far_z_04_0035:
                            	  3910:     ; State 0.
                            	  3911:     ;
                            	  3912:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3913:     ;
02:0003A738 102C0084        	  3914:     move.b  ($0084,A4),D0
02:0003A73C 0C0000AD        	  3915:     cmpi.b  #$AD,D0
02:0003A740 661E            	  3916:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3917:     ; If Link's X < $70 or >= $81, then return.
                            	  3918:     ;
02:0003A742 102C0070        	  3919:     move.b  ($0070,A4),D0
02:0003A746 0C000070        	  3920:     cmpi.b  #$70,D0
02:0003A74A 6514            	  3921:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003A74C 0C000081        	  3922:     cmpi.b  #$81,D0
02:0003A750 640E            	  3923:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3924:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3925:     ; halt Link, and start filling hearts.
                            	  3926:     ;
02:0003A752 522C00AD        	  3927:     addq.b  #1,($00AD,A4)
02:0003A756 7040            	  3928:     moveq   #64,D0
02:0003A758 194000AC        	  3929:     move.b  D0,($00AC,A4)
02:0003A75C 19400063        	  3930:     move.b  D0,($0063,A4)
                            	  3931:     even
                            	  3932: _L_z04_UpdatePondFairy_Exit:
02:0003A760 4E75            	  3933:     rts
                            	  3934: 
                            	  3935:     even
                            	  3936: PondFairy_HandleOtherStates:
02:0003A762 0C000001        	  3937:     cmpi.b  #$01,D0
02:0003A766 6610            	  3938:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3939:     ; State 1. Flying and filling hearts.
                            	  3940:     ;
                            	  3941:     ; If still filling hearts, then go draw Link and hearts.
                            	  3942:     ;
02:0003A768 102C0063        	  3943:     move.b  ($0063,A4),D0
02:0003A76C 6620            	  3944:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3945:     ; If not filling hearts anymore, then go to state 2,
                            	  3946:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3947:     ; a little while after we finish filling hearts.
                            	  3948:     ;
02:0003A76E 522C00AD        	  3949:     addq.b  #1,($00AD,A4)
02:0003A772 7050            	  3950:     moveq   #80,D0
02:0003A774 19400029        	  3951:     move.b  D0,($0029,A4)
                            	  3952:     even
                            	  3953: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3954:     ; If state <> 2 (so, it's 3), then return.
                            	  3955:     ;
                            	  3956:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3957:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3958:     ; was set to, and we'll return.
                            	  3959:     ;
02:0003A778 0C000002        	  3960:     cmpi.b  #$02,D0
02:0003A77C 6634            	  3961:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3962:     ; State = 2.
                            	  3963:     ;
