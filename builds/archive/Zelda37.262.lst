                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:0004B10E 41EC0098        	  5017:     lea     ($0098,A4),A0
02:0004B112 10302000        	  5018:     move.b  (A0,D2.W),D0
02:0004B116 19400002        	  5019:     move.b  D0,($0002,A4)
02:0004B11A 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:0004B11E 7000            	  5023:     moveq   #0,D0
02:0004B120 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:0004B124 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:0004B126 1003            	  5031:     move.b  D3,D0
02:0004B128 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:0004B12A 102C0002        	  5035:     move.b  ($0002,A4),D0
02:0004B12E 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:0004B130 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004B134 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004B136 102C0015        	  5046:     move.b  ($0015,A4),D0
02:0004B13A 02000003        	  5047:     andi.b #$03,D0
02:0004B13E 41F90004AF9C    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004B144 12303000        	  5049:     move.b  (A0,D3.W),D1
02:0004B148 8001            	  5050:     or.b  D1,D0
02:0004B14A 4EB90003101A    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:0004B150 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004B154 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B158 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004B15C D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004B15E 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:0004B160 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004B164 B001            	  5064:     cmp.b   D1,D0
02:0004B166 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004B168 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004B16C 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004B16E 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004B172 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004B176 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004B17A 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004B17C 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:0004B180 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:0004B182 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:0004B186 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:0004B18A 1214            	  5079:     move.b  ($0000,A4),D1
02:0004B18C 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004B190 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004B192 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:0004B196 0C000020        	  5087:     cmpi.b  #$20,D0
02:0004B19A 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004B19C 41EC0084        	  5092:     lea     ($0084,A4),A0
02:0004B1A0 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004B1A4 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B1A8 122C0003        	  5095:     move.b  ($0003,A4),D1
02:0004B1AC D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:0004B1AE 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:0004B1B2 7600            	  5100:     moveq   #0,D3
02:0004B1B4 162C0010        	  5101:     move.b  ($0010,A4),D3
02:0004B1B8 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:0004B1BA 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004B1BE 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:0004B1C0 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:0004B1C4 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:0004B1C6 7002            	  5112:     moveq   #2,D0
02:0004B1C8 1940000C        	  5113:     move.b  D0,($000C,A4)
02:0004B1CC 7623            	  5114:     moveq   #35,D3
02:0004B1CE 4EB900030F3A    	  5115:     jsr     Anim_WriteItemSprites
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:0004B1D4 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004B1D6 19400003        	  5123:     move.b  D0,($0003,A4)
02:0004B1DA 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004B1DC 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:0004B1E0 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:0004B1E2 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:0004B1E4 7600            	  5136:     moveq   #0,D3
02:0004B1E6 1600            	  5137:     move.b  D0,D3
02:0004B1E8 0C030001        	  5138:     cmpi.b  #$01,D3
02:0004B1EC 6602            	  5139:     bne  _anon_z07_25
02:0004B1EE 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:0004B1F0 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:0004B1F4 4600            	  5143:     eori.b #$FF,D0
02:0004B1F6 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B1FA 123C0001        	  5145:     move.b  #$01,D1
02:0004B1FE D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004B200 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:0004B204 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:0004B206 7600            	  5151:     moveq   #0,D3
02:0004B208 1600            	  5152:     move.b  D0,D3
02:0004B20A 5303            	  5153:     subq.b  #1,D3
02:0004B20C 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5155:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5156:     ;
                            	  5157:     ; Decrease the base negative offset to get farther away from
                            	  5158:     ; the center point.
                            	  5159:     ;
02:0004B210 41EC0098        	  5160:     lea     ($0098,A4),A0
02:0004B214 53302000        	  5161:     subq.b  #1,(A0,D2.W)
                            	  5162:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5163:     ;
                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:0004B218 41EC0098        	  5166:     lea     ($0098,A4),A0
02:0004B21C 10302000        	  5167:     move.b  (A0,D2.W),D0
02:0004B220 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:0004B224 6702            	  5169:     beq.s  __far_z_07_0077
02:0004B226 6004            	  5170:     jmp  L1F49F_Exit
                            	  5171: __far_z_07_0077:
