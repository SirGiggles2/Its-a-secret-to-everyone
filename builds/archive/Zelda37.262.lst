                            	  9606: _L_z04_UpdateGohma_Move:
                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003D12E 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003D132 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003D136 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D13A 123C0080        	  9612:     move.b  #$80,D1
02:0003D13E D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003D140 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003D144 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003D148 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
02:0003D14C 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003D150 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003D154 7001            	  9625:     moveq   #1,D0
02:0003D156 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003D15A 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003D15E 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003D162 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003D166 C200            	  9632:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D168 6704            	  9633:     beq  _anon_z04_118
02:0003D16A 52342070        	  9634:     addq.b  #1,($70,A4,D2.W)
                            	  9635: _anon_z04_118:
                            	  9636:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9637:     ;
02:0003D16E 122C0002        	  9638:     move.b  ($0002,A4),D1
02:0003D172 E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003D174 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003D178 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003D17C C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D17E 6704            	  9643:     beq  _anon_z04_119
02:0003D180 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
                            	  9646:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9647:     ;
02:0003D184 122C0002        	  9648:     move.b  ($0002,A4),D1
02:0003D188 E309            	  9649:     lsl.b  #1,D1   ; ASL $02
02:0003D18A 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003D18E 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003D192 C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D194 6708            	  9653:     beq  _anon_z04_120
02:0003D196 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003D19A 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
                            	  9657:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9658:     ;
02:0003D19E 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003D1A2 E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003D1A4 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003D1A8 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003D1AC C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D1AE 6708            	  9664:     beq  _anon_z04_121
02:0003D1B0 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003D1B4 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003D1B8 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003D1BC 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003D1C0 0C000020        	  9672:     cmpi.b  #$20,D0
02:0003D1C4 662C            	  9673:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9674:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9675:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9676:     ;
02:0003D1C6 7000            	  9677:     moveq   #0,D0
02:0003D1C8 41EC0412        	  9678:     lea     ($0412,A4),A0
02:0003D1CC 11802000        	  9679:     move.b  D0,(A0,D2.W)
02:0003D1D0 61001C62        	  9680:     jsr     ReverseObjDir8
02:0003D1D4 41EC045E        	  9681:     lea     ($045E,A4),A0
02:0003D1D8 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003D1DC 41EC045E        	  9683:     lea     ($045E,A4),A0
02:0003D1E0 52302000        	  9684:     addq.b  #1,(A0,D2.W)
                            	  9685:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9686:     ; should randomly change direction.
                            	  9687:     ;
02:0003D1E4 E208            	  9688:     lsr.b  #1,D0   ; LSR A
02:0003D1E6 640A            	  9689:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003D1E8 7000            	  9690:     moveq   #0,D0
02:0003D1EA 41EC0451        	  9691:     lea     ($0451,A4),A0
02:0003D1EE 11802000        	  9692:     move.b  D0,(A0,D2.W)
