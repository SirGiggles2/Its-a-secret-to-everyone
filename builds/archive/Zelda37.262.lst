02:0003DF88 7604            	 11484:     moveq   #4,D3
                            	 11485:     even
                            	 11486: _L_z04_UpdateLamnola_FindTail:
02:0003DF8A 5203            	 11487:     addq.b  #1,D3
02:0003DF8C 41EC0350        	 11488:     lea     ($0350,A4),A0
02:0003DF90 10303000        	 11489:     move.b  (A0,D3.W),D0
02:0003DF94 122C04E7        	 11490:     move.b  ($04E7,A4),D1
02:0003DF98 B001            	 11491:     cmp.b   D1,D0
02:0003DF9A 66EE            	 11492:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11493:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11494:     ;
02:0003DF9C 7011            	 11495:     moveq   #17,D0
02:0003DF9E 19803029        	 11496:     move.b  D0,($29,A4,D3.W)
                            	 11497:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11498:     ; to the tail segment.
                            	 11499:     ;
02:0003DFA2 41EC04F0        	 11500:     lea     ($04F0,A4),A0
02:0003DFA6 10302000        	 11501:     move.b  (A0,D2.W),D0
02:0003DFAA 41EC04F1        	 11502:     lea     ($04F1,A4),A0
02:0003DFAE 11803000        	 11503:     move.b  D0,(A0,D3.W)
02:0003DFB2 10342070        	 11504:     move.b  ($70,A4,D2.W),D0
02:0003DFB6 19803071        	 11505:     move.b  D0,($71,A4,D3.W)
02:0003DFBA 41EC0084        	 11506:     lea     ($0084,A4),A0
02:0003DFBE 10302000        	 11507:     move.b  (A0,D2.W),D0
02:0003DFC2 41EC0085        	 11508:     lea     ($0085,A4),A0
02:0003DFC6 11803000        	 11509:     move.b  D0,(A0,D3.W)
                            	 11510:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11511:     ; So, return and leave it dead.
                            	 11512:     ;
02:0003DFCA 0C030004        	 11513:     cmpi.b  #$04,D3
02:0003DFCE 6604            	 11514:     bne.s  __far_z_04_0110
02:0003DFD0 6000FF0C        	 11515:     jmp  L129EA_Exit
                            	 11516: __far_z_04_0110:
02:0003DFD4 0C030009        	 11517:     cmpi.b  #$09,D3
02:0003DFD8 6604            	 11518:     bne.s  __far_z_04_0111
02:0003DFDA 6000FF02        	 11519:     jmp  L129EA_Exit
                            	 11520: __far_z_04_0111:
                            	 11521:     ; Change the tail segment to the dead dummy object, and
                            	 11522:     ; bring the current segment back to life.
                            	 11523:     ;
02:0003DFDE 705D            	 11524:     moveq   #93,D0
02:0003DFE0 41EC0350        	 11525:     lea     ($0350,A4),A0
02:0003DFE4 11803000        	 11526:     move.b  D0,(A0,D3.W)
02:0003DFE8 4EF90004C618    	 11527:     jmp     ResetObjMetastate
                            	 11528: 
                            	 11529:     even
                            	 11530: L12A6F_Exit:
02:0003DFEE 4E75            	 11531:     rts
                            	 11532: 
                            	 11533:     even
                            	 11534: Lamnola_UpdateHead:
                            	 11535:     ; If X coordinate is not a multiple of 8, then return.
                            	 11536:     ;
02:0003DFF0 10342070        	 11537:     move.b  ($70,A4,D2.W),D0
02:0003DFF4 02000007        	 11538:     andi.b #$07,D0
02:0003DFF8 6702            	 11539:     beq.s  __far_z_04_0112
02:0003DFFA 60F2            	 11540:     jmp  L12A6F_Exit
                            	 11541: __far_z_04_0112:
                            	 11542:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11543:     ; We had to account for the usual offset of 3.
                            	 11544:     ;
02:0003DFFC 41EC0084        	 11545:     lea     ($0084,A4),A0
02:0003E000 10302000        	 11546:     move.b  (A0,D2.W),D0
02:0003E004 023C00EE        	 11547:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E008 123C0003        	 11548:     move.b  #$03,D1
02:0003E00C D101            	 11549:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E00E 02000007        	 11550:     andi.b #$07,D0
02:0003E012 6702            	 11551:     beq.s  __far_z_04_0113
02:0003E014 60D8            	 11552:     jmp  L12A6F_Exit
                            	 11553: __far_z_04_0113:
                            	 11554:     ; Will loop 4 times, propagating directions down the chain,
                            	 11555:     ; by pulling from the bottom.
                            	 11556:     ;
02:0003E016 7004            	 11557:     moveq   #4,D0
02:0003E018 1880            	 11558:     move.b  D0,($0000,A4)
                            	 11559:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11560:     ;
02:0003E01A 7600            	 11561:     moveq   #0,D3
02:0003E01C 0C020005        	 11562:     cmpi.b  #$05,D2
02:0003E020 6702            	 11563:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003E022 7605            	 11564:     moveq   #5,D3
                            	 11565:     even
                            	 11566: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11567:     ; Loop over every segment under the head, starting from the tail.
                            	 11568:     ; Copy the next segment's direction to the current one in this loop.
                            	 11569:     ;
02:0003E024 41EC009A        	 11570:     lea     ($009A,A4),A0
02:0003E028 10303000        	 11571:     move.b  (A0,D3.W),D0
02:0003E02C 41EC0099        	 11572:     lea     ($0099,A4),A0
02:0003E030 11803000        	 11573:     move.b  D0,(A0,D3.W)
02:0003E034 5203            	 11574:     addq.b  #1,D3
02:0003E036 5314            	 11575:     subq.b  #1,($0000,A4)
02:0003E038 66EA            	 11576:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11577:     ; If this head segment is not aligned with a square, then return.
                            	 11578:     ;
02:0003E03A 10342070        	 11579:     move.b  ($70,A4,D2.W),D0
02:0003E03E 0200000F        	 11580:     andi.b #$0F,D0
02:0003E042 660000BA        	 11581:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11582:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11583:     ; We had to account for the usual offset of 3.
                            	 11584:     ;
02:0003E046 41EC0084        	 11585:     lea     ($0084,A4),A0
02:0003E04A 10302000        	 11586:     move.b  (A0,D2.W),D0
02:0003E04E 023C00EE        	 11587:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E052 123C0003        	 11588:     move.b  #$03,D1
02:0003E056 D101            	 11589:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003E058 0200000F        	 11590:     andi.b #$0F,D0
02:0003E05C 660000A0        	 11591:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11592:     ; Store the opposite of the facing direction in [00].
                            	 11593:     ;
02:0003E060 41EC0098        	 11594:     lea     ($0098,A4),A0
02:0003E064 10302000        	 11595:     move.b  (A0,D2.W),D0
02:0003E068 E208            	 11596:     lsr.b  #1,D0   ; LSR A
02:0003E06A 02000005        	 11597:     andi.b #$05,D0
02:0003E06E 1880            	 11598:     move.b  D0,($0000,A4)
02:0003E070 41EC0098        	 11599:     lea     ($0098,A4),A0
02:0003E074 10302000        	 11600:     move.b  (A0,D2.W),D0
02:0003E078 E308            	 11601:     lsl.b  #1,D0   ; ASL A
02:0003E07A 0200000A        	 11602:     andi.b #$0A,D0
02:0003E07E 1214            	 11603:     move.b  ($0000,A4),D1
02:0003E080 8001            	 11604:     or.b  D1,D0
                            	 11605:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11606:     ;
02:0003E082 0A00000F        	 11607:     eori.b #$0F,D0
02:0003E086 1940050F        	 11608:     move.b  D0,($050F,A4)
                            	 11609:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11610:     ;
02:0003E08A 10342018        	 11611:     move.b  ($18,A4,D2.W),D0
02:0003E08E 0C000080        	 11612:     cmpi.b  #$80,D0
02:0003E092 656C            	 11613:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11614:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11615:     ; Load the monster's facing direction.
                            	 11616:     ;
02:0003E094 41EC0098        	 11617:     lea     ($0098,A4),A0
02:0003E098 10302000        	 11618:     move.b  (A0,D2.W),D0
                            	 11619:     ; Load the next random number into Y register.
                            	 11620:     ;
02:0003E09C 7600            	 11621:     moveq   #0,D3
02:0003E09E 16342019        	 11622:     move.b  ($19,A4,D2.W),D3
                            	 11623:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11624:     ; to keep moving straight.
                            	 11625:     ;
02:0003E0A2 0C030080        	 11626:     cmpi.b  #$80,D3
02:0003E0A6 6418            	 11627:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11628:     even
                            	 11629: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11630:     ; Loop to rotate the direction bit over the mask.
                            	 11631:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11632:     ; facing direction.
                            	 11633:     ;
                            	 11634:     ; Shift right the copy of the direction.
                            	 11635:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11636:     ;
02:0003E0A8 E208            	 11637:     lsr.b  #1,D0   ; LSR A
02:0003E0AA 6402            	 11638:     bcc  _anon_z04_151
02:0003E0AC 7008            	 11639:     moveq   #8,D0
                            	 11640: _anon_z04_151:
                            	 11641:     ; If the current direction bit is masked off, then we've reached
                            	 11642:     ; the opposite direction. Loop again.
                            	 11643:     ;
02:0003E0AE 122C050F        	 11644:     move.b  ($050F,A4),D1
02:0003E0B2 C200            	 11645:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E0B4 67F2            	 11646:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11647:     ; If Y register >= $40, then break out of the loop.
                            	 11648:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11649:     ;
02:0003E0B6 0C030040        	 11650:     cmpi.b  #$40,D3
02:0003E0BA 6404            	 11651:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11652:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11653:     ; and loop again now.
                            	 11654:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11655:     ;
02:0003E0BC 7640            	 11656:     moveq   #64,D3
02:0003E0BE 65E8            	 11657:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11658:     even
                            	 11659: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11660:     ; Change the facing direction to the direction found.
                            	 11661:     ;
02:0003E0C0 41EC0098        	 11662:     lea     ($0098,A4),A0
02:0003E0C4 11802000        	 11663:     move.b  D0,(A0,D2.W)
                            	 11664:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11665:     ;
02:0003E0C8 1940000F        	 11666:     move.b  D0,($000F,A4)
02:0003E0CC 4EB90003080E    	 11667:     jsr     BoundByRoom
                            	 11668:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11669:     ;
02:0003E0D2 102C000F        	 11670:     move.b  ($000F,A4),D0
02:0003E0D6 6618            	 11671:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11672:     even
                            	 11673: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11674:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11675:     ; for looking for any non-opposite direction that is not blocked.
                            	 11676:     ;
02:0003E0D8 41EC0098        	 11677:     lea     ($0098,A4),A0
02:0003E0DC 10302000        	 11678:     move.b  (A0,D2.W),D0
                            	 11679:     even
                            	 11680: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11681:     ; Shift right the copy of the direction.
                            	 11682:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11683:     ;
02:0003E0E0 E208            	 11684:     lsr.b  #1,D0   ; LSR A
02:0003E0E2 6402            	 11685:     bcc  _anon_z04_152
02:0003E0E4 7008            	 11686:     moveq   #8,D0
                            	 11687: _anon_z04_152:
                            	 11688:     ; If the current direction bit is not masked off, then go check the
                            	 11689:     ; room boundary in this direction.
                            	 11690:     ; Else we've reached the opposite direction. Loop again.
                            	 11691:     ;
02:0003E0E6 122C050F        	 11692:     move.b  ($050F,A4),D1
02:0003E0EA C200            	 11693:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E0EC 66D2            	 11694:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003E0EE 67F0            	 11695:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11696:     even
                            	 11697: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11698:     ; We found a direction that was not blocked by the room boundary.
                            	 11699:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11700:     ;
02:0003E0F0 4EB90004A74C    	 11701:     jsr     GetCollidingTileMoving
02:0003E0F6 122C034A        	 11702:     move.b  ($034A,A4),D1
02:0003E0FA B001            	 11703:     cmp.b   D1,D0
02:0003E0FC 64DA            	 11704:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11705:     even
                            	 11706: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11707:     ; TODO: confirm this
                            	 11708:     ;
                            	 11709:     ; If there were a room that had lamnolas, and they could get
                            	 11710:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11711:     ; an infinite loop.
                            	 11712:     ;
                            	 11713:     ; But, the only room with that configuration has those blocks
                            	 11714:     ; blocked off with a push block, which can only be pushed after
                            	 11715:     ; all monsters are killed.
                            	 11716:     ;
02:0003E0FE 4E75            	 11717:     rts
                            	 11718: 
                            	 11719:     even
                            	 11720: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11721:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11722:     ;
02:0003E100 7001            	 11723:     moveq   #1,D0
02:0003E102 19400002        	 11724:     move.b  D0,($0002,A4)
02:0003E106 102C0070        	 11725:     move.b  ($0070,A4),D0
02:0003E10A 003C0011        	 11726:     ori     #$11,CCR  ; SEC: set C+X
02:0003E10E 12342070        	 11727:     move.b  ($70,A4,D2.W),D1
02:0003E112 0A3C0010        	 11728:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E116 9101            	 11729:     subx.b  D1,D0   ; SBC ObjX,X
02:0003E118 0A3C0010        	 11730:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E11C 640A            	 11731:     bcc  _anon_z04_153
02:0003E11E 122C0002        	 11732:     move.b  ($0002,A4),D1
02:0003E122 E309            	 11733:     lsl.b  #1,D1   ; ASL $02
02:0003E124 19410002        	 11734:     move.b  D1,($0002,A4)
                            	 11735: _anon_z04_153:
                            	 11736:     ; Find the vertical direction toward Link and store it in [03].
                            	 11737:     ;
02:0003E128 7004            	 11738:     moveq   #4,D0
02:0003E12A 19400003        	 11739:     move.b  D0,($0003,A4)
02:0003E12E 102C0084        	 11740:     move.b  ($0084,A4),D0
02:0003E132 003C0011        	 11741:     ori     #$11,CCR  ; SEC: set C+X
02:0003E136 41EC0084        	 11742:     lea     ($0084,A4),A0
02:0003E13A 12302000        	 11743:     move.b  (A0,D2.W),D1
02:0003E13E 0A3C0010        	 11744:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E142 9101            	 11745:     subx.b  D1,D0   ; SBC ObjY,X
02:0003E144 0A3C0010        	 11746:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E148 640A            	 11747:     bcc  _anon_z04_154
02:0003E14A 122C0003        	 11748:     move.b  ($0003,A4),D1
02:0003E14E E309            	 11749:     lsl.b  #1,D1   ; ASL $03
02:0003E150 19410003        	 11750:     move.b  D1,($0003,A4)
                            	 11751: _anon_z04_154:
                            	 11752:     ; If the horizontal direction toward Link is not allowed, then
                            	 11753:     ; go check the vertical direction.
                            	 11754:     ;
02:0003E154 102C0002        	 11755:     move.b  ($0002,A4),D0
02:0003E158 122C050F        	 11756:     move.b  ($050F,A4),D1
02:0003E15C C200            	 11757:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E15E 6708            	 11758:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11759:     ; If the horizontal direction toward Link is the same direction
                            	 11760:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11761:     ;
02:0003E160 122C0098        	 11762:     move.b  ($0098,A4),D1
02:0003E164 C200            	 11763:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E166 6604            	 11764:     bne  _anon_z04_155
                            	 11765:     even
                            	 11766: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11767:     ; Load the vertical direction toward Link in order to test it for
                            	 11768:     ; room boundary and tile collision.
                            	 11769:     ;
02:0003E168 102C0003        	 11770:     move.b  ($0003,A4),D0
                            	 11771: _anon_z04_155:
                            	 11772:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11773:     ;
02:0003E16C 6000FF52        	 11774:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11775: 
                            	 11776:     even
                            	 11777: Lamnola_Move:
                            	 11778:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11779:     ;
                            	 11780:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11781:     ;
                            	 11782:     ; Start with a mask of $A1 in [02]:
                            	 11783:     ; - low nibble represents the right direction
                            	 11784:     ; - high nibble is used to set or clear carry as we go along
                            	 11785:     ;
02:0003E170 103C00A1        	 11786:     move.b  #$A1,D0
02:0003E174 19400002        	 11787:     move.b  D0,($0002,A4)
                            	 11788:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11789:     ;
02:0003E178 41EC0098        	 11790:     lea     ($0098,A4),A0
02:0003E17C 10302000        	 11791:     move.b  (A0,D2.W),D0
02:0003E180 122C0002        	 11792:     move.b  ($0002,A4),D1
02:0003E184 C200            	 11793:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E186 6712            	 11794:     beq  _L_z04_Lamnola_Move_Left
02:0003E188 10342070        	 11795:     move.b  ($70,A4,D2.W),D0
02:0003E18C 023C00EE        	 11796:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E190 122C04E6        	 11797:     move.b  ($04E6,A4),D1
02:0003E194 D101            	 11798:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003E196 19802070        	 11799:     move.b  D0,($70,A4,D2.W)
                            	 11800:     even
                            	 11801: _L_z04_Lamnola_Move_Left:
                            	 11802:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 11803:     ;
02:0003E19A 41EC0098        	 11804:     lea     ($0098,A4),A0
02:0003E19E 10302000        	 11805:     move.b  (A0,D2.W),D0
02:0003E1A2 122C0002        	 11806:     move.b  ($0002,A4),D1
02:0003E1A6 E309            	 11807:     lsl.b  #1,D1   ; ASL $02
02:0003E1A8 19410002        	 11808:     move.b  D1,($0002,A4)
02:0003E1AC 122C0002        	 11809:     move.b  ($0002,A4),D1
02:0003E1B0 C200            	 11810:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E1B2 6716            	 11811:     beq  _L_z04_Lamnola_Move_Down
02:0003E1B4 10342070        	 11812:     move.b  ($70,A4,D2.W),D0
02:0003E1B8 122C04E6        	 11813:     move.b  ($04E6,A4),D1
02:0003E1BC 0A3C0010        	 11814:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E1C0 9101            	 11815:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003E1C2 0A3C0010        	 11816:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E1C6 19802070        	 11817:     move.b  D0,($70,A4,D2.W)
                            	 11818:     even
                            	 11819: _L_z04_Lamnola_Move_Down:
                            	 11820:     ; If direction has a down component (4), then add offset to Y coordinate.
