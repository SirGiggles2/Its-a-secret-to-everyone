02:0003C3E8 123C0003        	  7829:     move.b  #$03,D1
02:0003C3EC 0A3C0010        	  7830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C3F0 9101            	  7831:     subx.b  D1,D0   ; SBC #$03
02:0003C3F2 0A3C0010        	  7832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C3F6 41EC0084        	  7833:     lea     ($0084,A4),A0
02:0003C3FA 11802000        	  7834:     move.b  D0,(A0,D2.W)
