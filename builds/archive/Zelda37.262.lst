                            	  6251: Digdogger_Move:
                            	  6252:     ; This calculation is the same one used in Manhandla to
                            	  6253:     ; manifest the fractional speed over several frames.
                            	  6254:     ;
                            	  6255:     ; To summarize, the formula is:
                            	  6256:     ;
                            	  6257:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6258:     ;
                            	  6259:     ;   SA := SA + (SL AND $E0)
                            	  6260:     ;   [03] := SH + carry
                            	  6261:     ;
                            	  6262:     ; See 04:A28E Manhandla_Move.
                            	  6263:     ;
02:0003B868 41EC041F        	  6264:     lea     ($041F,A4),A0
02:0003B86C 10302000        	  6265:     move.b  (A0,D2.W),D0
02:0003B870 020000E0        	  6266:     andi.b #$E0,D0
02:0003B874 023C00EE        	  6267:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B878 41EC0412        	  6268:     lea     ($0412,A4),A0
02:0003B87C 12302000        	  6269:     move.b  (A0,D2.W),D1
02:0003B880 D101            	  6270:     addx.b  D1,D0   ; ADC $0412,X
02:0003B882 41EC0412        	  6271:     lea     ($0412,A4),A0
