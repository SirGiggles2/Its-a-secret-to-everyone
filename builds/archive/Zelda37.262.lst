                            	  6910:     ; If bomb hits < 2, then set bloated substate 4,
                            	  6911:     ; which will transition to state 0 (moving).
                            	  6912:     ;
                            	  6913:     ; Note that if the bomb hits >= 2, then:
                            	  6914:     ; - If new substate = 2, then substate 2 will wait,
                            	  6915:     ;   and then transition to substate 3.
                            	  6916:     ; - If new substate = 3, then the next frame the monster will die.
                            	  6917:     ;
