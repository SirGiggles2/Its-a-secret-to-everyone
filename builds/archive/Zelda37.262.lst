02:00031A6A 7400            	   110:     moveq   #0,D2
02:00031A6C 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:00031A6E 41F900031A40    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:00031A74 3A02            	   117:     move.w  D2,D5
02:00031A76 DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:00031A78 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:00031A7C 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:00031A80 41F900031A4C    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:00031A86 10302000        	   122:     move.b  (A0,D2.W),D0
