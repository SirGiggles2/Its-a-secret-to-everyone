02:0004125C 12303000        	  4023:     move.b  (A0,D3.W),D1
02:00041260 B001            	  4024:     cmp.b   D1,D0
02:00041262 6622            	  4025:     bne  _anon_z05_95
02:00041264 102C0001        	  4026:     move.b  ($0001,A4),D0
02:00041268 41F900041234    	  4027:     lea     (DoorwayBoundsMinOver).l,A0
02:0004126E 12303000        	  4028:     move.b  (A0,D3.W),D1
02:00041272 B001            	  4029:     cmp.b   D1,D0
02:00041274 6510            	  4030:     bcs  _anon_z05_95
02:00041276 41F900041238    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:0004127C 12303000        	  4032:     move.b  (A0,D3.W),D1
02:00041280 B001            	  4033:     cmp.b   D1,D0
02:00041282 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4035: _anon_z05_95:
02:00041286 5303            	  4036:     subq.b  #1,D3
02:00041288 6ACA            	  4037:     bpl  _L_z05_CheckDoorway_LoopOverflowBounds
