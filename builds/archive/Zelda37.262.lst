02:0003D050 122C0002        	  9498:     move.b  ($0002,A4),D1
02:0003D054 E309            	  9499:     lsl.b  #1,D1   ; ASL $02
02:0003D056 19410002        	  9500:     move.b  D1,($0002,A4)
02:0003D05A 122C0002        	  9501:     move.b  ($0002,A4),D1
02:0003D05E C200            	  9502:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D060 671E            	  9503:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003D062 41EC0084        	  9504:     lea     ($0084,A4),A0
