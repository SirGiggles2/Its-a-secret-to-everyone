                            	  5248: _anon_z04_76:
                            	  5249:     ; If qspeed <> $20 or grid offset <> 0, then go draw.
                            	  5250:     ;
02:0003B106 41EC03BC        	  5251:     lea     ($03BC,A4),A0
02:0003B10A 10302000        	  5252:     move.b  (A0,D2.W),D0
02:0003B10E 0C000020        	  5253:     cmpi.b  #$20,D0
