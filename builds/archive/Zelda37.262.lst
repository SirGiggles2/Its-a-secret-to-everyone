                            	  1909: 
                            	  1910:     even
                            	  1911: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1912:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1913:     ; then this trap definitely wasn't triggered.
                            	  1914:     ; Go draw and check collisions.
                            	  1915:     ;
02:00030446 102C0070        	  1916:     move.b  ($0070,A4),D0
02:0003044A 003C0011        	  1917:     ori     #$11,CCR  ; SEC: set C+X
02:0003044E 12342070        	  1918:     move.b  ($70,A4,D2.W),D1
02:00030452 0A3C0010        	  1919:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030456 9101            	  1920:     subx.b  D1,D0   ; SBC ObjX,X
02:00030458 0A3C0010        	  1921:     eori    #$10,CCR  ; restore X = 6502 C
02:0003045C 610003C4        	  1922:     jsr     Abs
02:00030460 0C00000E        	  1923:     cmpi.b  #$0E,D0
02:00030464 64DC            	  1924:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1925:     ; Determine the vertical direction toward Link;
                            	  1926:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1927:     ; along this axis. Go draw and check object collisions.
                            	  1928:     ;
02:00030466 7604            	  1929:     moveq   #4,D3
02:00030468 102C0084        	  1930:     move.b  ($0084,A4),D0
02:0003046C 41EC0084        	  1931:     lea     ($0084,A4),A0
02:00030470 12302000        	  1932:     move.b  (A0,D2.W),D1
02:00030474 B001            	  1933:     cmp.b   D1,D0
02:00030476 67CA            	  1934:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:00030478 6402            	  1935:     bcc  _anon_z01_27
02:0003047A 7608            	  1936:     moveq   #8,D3
                            	  1937: _anon_z01_27:
                            	  1938:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  1939:     ; set the vertical direction we determined, and other preparations.
                            	  1940:     ;
02:0003047C 41EC0084        	  1941:     lea     ($0084,A4),A0
02:00030480 10302000        	  1942:     move.b  (A0,D2.W),D0
02:00030484 668A            	  1943:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  1944:     even
                            	  1945: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  1946:     ; State 1 and 2.
                            	  1947:     ;
                            	  1948:     ; Move in the direction it's facing.
                            	  1949:     ;
02:00030486 41EC0098        	  1950:     lea     ($0098,A4),A0
02:0003048A 10302000        	  1951:     move.b  (A0,D2.W),D0
02:0003048E 1940000F        	  1952:     move.b  D0,($000F,A4)
02:00030492 4EB90004AAA0    	  1953:     jsr     MoveObject
                            	  1954:     ; Truncate the grid offset to square length ($10).
                            	  1955:     ;
02:00030498 41EC0394        	  1956:     lea     ($0394,A4),A0
02:0003049C 10302000        	  1957:     move.b  (A0,D2.W),D0
02:000304A0 0200000F        	  1958:     andi.b #$0F,D0
02:000304A4 6608            	  1959:     bne  _anon_z01_28
02:000304A6 41EC0394        	  1960:     lea     ($0394,A4),A0
02:000304AA 11802000        	  1961:     move.b  D0,(A0,D2.W)
                            	  1962: _anon_z01_28:
                            	  1963:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  1964:     ;
02:000304AE 61000CF6        	  1965:     jsr     CheckLinkCollision
                            	  1966:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  1967:     ; and current coordinate to the trap's X.
                            	  1968:     ;
02:000304B2 7600            	  1969:     moveq   #0,D3
02:000304B4 16342070        	  1970:     move.b  ($70,A4,D2.W),D3
02:000304B8 7078            	  1971:     moveq   #120,D0
02:000304BA 1880            	  1972:     move.b  D0,($0000,A4)
02:000304BC 41EC0098        	  1973:     lea     ($0098,A4),A0
02:000304C0 10302000        	  1974:     move.b  (A0,D2.W),D0
02:000304C4 0200000C        	  1975:     andi.b #$0C,D0
02:000304C8 6710            	  1976:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  1977:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  1978:     ; and current coordinate to the trap's Y.
                            	  1979:     ;
02:000304CA 7600            	  1980:     moveq   #0,D3
02:000304CC 41EC0084        	  1981:     lea     ($0084,A4),A0
02:000304D0 16302000        	  1982:     move.b  (A0,D2.W),D3
02:000304D4 103C0090        	  1983:     move.b  #$90,D0
02:000304D8 1880            	  1984:     move.b  D0,($0000,A4)
                            	  1985:     even
                            	  1986: _L_z01_UpdateTrap_Full_Finish:
                            	  1987:     ; If in state 2, then go finish handling it.
                            	  1988:     ;
02:000304DA 41EC00AC        	  1989:     lea     ($00AC,A4),A0
02:000304DE 10302000        	  1990:     move.b  (A0,D2.W),D0
02:000304E2 02000001        	  1991:     andi.b #$01,D0
02:000304E6 6744            	  1992:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  1993:     ; Finish handling state 1.
                            	  1994:     ;
                            	  1995:     ; Get the distance between the current coordinate and the target.
                            	  1996:     ;
02:000304E8 1003            	  1997:     move.b  D3,D0
02:000304EA 003C0011        	  1998:     ori     #$11,CCR  ; SEC: set C+X
02:000304EE 1214            	  1999:     move.b  ($0000,A4),D1
02:000304F0 0A3C0010        	  2000:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000304F4 9101            	  2001:     subx.b  D1,D0   ; SBC $00
02:000304F6 0A3C0010        	  2002:     eori    #$10,CCR  ; restore X = 6502 C
02:000304FA 61000326        	  2003:     jsr     Abs
