                            	 13076: _L_z04_SetUpDroppedItem_LookUpItem:
                            	 13077:     ; Look up the base offset of the row in the drop item table.
                            	 13078:     ; Add it and WorldKillCycle to look up the dropped item for
                            	 13079:     ; this object type and store it in [00].
                            	 13080:     ;
02:0003EAC0 7600            	 13081:     moveq   #0,D3
02:0003EAC2 162C0001        	 13082:     move.b  ($0001,A4),D3
02:0003EAC6 41F90003EA0E    	 13083:     lea     (DropItemSetBaseOffsets).l,A0
02:0003EACC 10303000        	 13084:     move.b  (A0,D3.W),D0
