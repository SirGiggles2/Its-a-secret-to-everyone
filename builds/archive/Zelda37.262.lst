                            	  7405:     even
                            	  7406: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003C086 101D            	  7407:     move.b  (A5)+,D0  ; PLA
02:0003C088 7600            	  7408:     moveq   #0,D3
02:0003C08A 1600            	  7409:     move.b  D0,D3
                            	  7410:     ; If facing vertically, then return. There's no other side to draw.
                            	  7411:     ;
02:0003C08C 41EC0098        	  7412:     lea     ($0098,A4),A0
02:0003C090 10302000        	  7413:     move.b  (A0,D2.W),D0
02:0003C094 02000003        	  7414:     andi.b #$03,D0
02:0003C098 6602            	  7415:     bne.s  __far_z_04_0067
02:0003C09A 602C            	  7416:     jmp  L11B00_Exit
                            	  7417: __far_z_04_0067:
                            	  7418:     ; Else draw the right side.
                            	  7419:     ;
                            	  7420:     ; Keep the Y coordinate in [01].
                            	  7421:     ; But, store (X + $10) in [00].
                            	  7422:     ;
02:0003C09C 10342070        	  7423:     move.b  ($70,A4,D2.W),D0
02:0003C0A0 023C00EE        	  7424:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C0A4 123C0010        	  7425:     move.b  #$10,D1
02:0003C0A8 D101            	  7426:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C0AA 1880            	  7427:     move.b  D0,($0000,A4)
02:0003C0AC 6114            	  7428:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7429:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7430:     ;
                            	  7431:     ; So, if we had animation frame 1, direction left:
                            	  7432:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7433:     ; - frame image index = 6 (1 + 5)
                            	  7434:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7435:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7436:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7437:     ;
                            	  7438:     ; So, 3 would have been the frame number used above for
                            	  7439:     ; the left side.
                            	  7440:     ;
                            	  7441:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7442:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7443:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7444:     ; on the right.
                            	  7445:     ;
02:0003C0AE 41F90003BFA4    	  7446:     lea     (DodongoFrameImages).l,A0
02:0003C0B4 10303000        	  7447:     move.b  (A0,D3.W),D0
02:0003C0B8 0A000001        	  7448:     eori.b #$01,D0
02:0003C0BC 4EF900030D28    	  7449:     jmp     DrawObjectNotMirrored
