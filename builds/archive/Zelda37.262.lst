02:0003A82E 123C001C        	  4078:     move.b  #$1C,D1
02:0003A832 0A3C0010        	  4079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A836 9101            	  4080:     subx.b  D1,D0   ; SBC #$1C
02:0003A838 0A3C0010        	  4081:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A83C 41EC0084        	  4082:     lea     ($0084,A4),A0
