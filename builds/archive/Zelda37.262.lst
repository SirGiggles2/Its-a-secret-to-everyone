                            	 11968: UpdatePatraChild:
                            	 11969:     ; If state = 1, then go orbit.
                            	 11970:     ;
02:0003E2EA 41EC00AC        	 11971:     lea     ($00AC,A4),A0
02:0003E2EE 10302000        	 11972:     move.b  (A0,D2.W),D0
