                            	  4881: _anon_z02_35:
02:00035A84 41F900035A00    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00035A8A 10303000        	  4883:     move.b  (A0,D3.W),D0
02:00035A8E 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00035A92 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:00035A96 5303            	  4886:     subq.b  #1,D3
02:00035A98 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:00035A9A 7600            	  4891:     moveq   #0,D3
02:00035A9C 162C0413        	  4892:     move.b  ($0413,A4),D3
02:00035AA0 41F900035A3A    	  4893:     lea     (PeaceText).l,A0
02:00035AA6 10303000        	  4894:     move.b  (A0,D3.W),D0
02:00035AAA 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:00035AAE 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00035AB0 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:00035AB4 0C000024        	  4901:     cmpi.b  #$24,D0
02:00035AB8 6706            	  4902:     beq  _anon_z02_36
