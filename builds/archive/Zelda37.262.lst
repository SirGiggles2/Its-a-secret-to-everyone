02:0003E376 102C0085        	 12056:     move.b  ($0085,A4),D0
02:0003E37A 003C0011        	 12057:     ori     #$11,CCR  ; SEC: set C+X
02:0003E37E 1214            	 12058:     move.b  ($0000,A4),D1
02:0003E380 0A3C0010        	 12059:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E384 9101            	 12060:     subx.b  D1,D0   ; SBC $00
02:0003E386 0A3C0010        	 12061:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E38A 41EC0084        	 12062:     lea     ($0084,A4),A0
