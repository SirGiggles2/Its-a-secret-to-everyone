02:00043C10 12303000        	  7622:     move.b  (A0,D3.W),D1
02:00043C14 B001            	  7623:     cmp.b   D1,D0
02:00043C16 6702            	  7624:     beq  _anon_z05_165
02:00043C18 5202            	  7625:     addq.b  #1,D2
