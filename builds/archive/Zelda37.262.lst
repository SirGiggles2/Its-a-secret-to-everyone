                            	  2653: UpdateBombFlashEffect:
                            	  2654:     ; If state <> $13, return.
                            	  2655:     ;
02:00030888 41EC00AC        	  2656:     lea     ($00AC,A4),A0
02:0003088C 10302000        	  2657:     move.b  (A0,D2.W),D0
02:00030890 0C000013        	  2658:     cmpi.b  #$13,D0
02:00030894 662E            	  2659:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  2660:     ; The effect involves turning grayscale rendering on and off
                            	  2661:     ; in PPUMASK.
                            	  2662:     ;
                            	  2663:     ; Start by setting A register to the PPU mask shifted right to
                            	  2664:     ; throw away the grayscale bit.
                            	  2665:     ;
02:00030896 102C00FE        	  2666:     move.b  ($00FE,A4),D0
02:0003089A E208            	  2667:     lsr.b  #1,D0   ; LSR A
                            	  2668:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  2669:     ;
02:0003089C 7600            	  2670:     moveq   #0,D3
02:0003089E 16342028        	  2671:     move.b  ($28,A4,D2.W),D3
                            	  2672:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  2673:     ; Carry will have been set, because of the comparison (CPY).
                            	  2674:     ;
02:000308A2 0C030016        	  2675:     cmpi.b  #$16,D3
02:000308A6 6706            	  2676:     beq  _anon_z01_54
02:000308A8 0C030011        	  2677:     cmpi.b  #$11,D3
02:000308AC 6604            	  2678:     bne  _L_z01_UpdateBombFlashEffect_Clear
                            	  2679: _anon_z01_54:
