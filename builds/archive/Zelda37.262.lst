02:0003D026 19410002        	  9482:     move.b  D1,($0002,A4)
02:0003D02A 122C0002        	  9483:     move.b  ($0002,A4),D1
02:0003D02E C200            	  9484:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
