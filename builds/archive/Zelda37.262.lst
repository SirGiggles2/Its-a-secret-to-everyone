02:0004AB98 02000010        	  4184:     andi.b #$10,D0
02:0004AB9C 6702            	  4185:     beq.s  __far_z_07_0051
02:0004AB9E 600E            	  4186:     jmp  Reverse
                            	  4187: __far_z_07_0051:
