02:00039FE6 9101            	  2871:     subx.b  D1,D0   ; SBC #$0D
02:00039FE8 0A3C0010        	  2872:     eori    #$10,CCR  ; restore X = 6502 C
02:00039FEC 7600            	  2873:     moveq   #0,D3
