02:00043564 1400            	  7102:     move.b  D0,D2
                            	  7103:     ; Store the address of the column in [00:01].
                            	  7104:     ;
02:00043566 41F900049712    	  7105:     lea     (PlayAreaColumnAddrs).l,A0
02:0004356C 10302000        	  7106:     move.b  (A0,D2.W),D0
