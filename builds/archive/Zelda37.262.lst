02:00043CF2 D101            	  7753:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00043CF4 6404            	  7754:     bcc  _anon_z05_169
02:00043CF6 522C0302        	  7755:     addq.b  #1,($0302,A4)
                            	  7756: _anon_z05_169:
02:00043CFA 5303            	  7757:     subq.b  #1,D3
02:00043CFC 6AEC            	  7758:     bpl  _L_z05_PrepFullBlackRow_Add20H
02:00043CFE 19400303        	  7759:     move.b  D0,($0303,A4)
02:00043D02 7060            	  7760:     moveq   #96,D0
