02:00042782 6100FCC8        	  5500:     jsr     FindDoorAttrByDoorBit
02:00042786 61001C62        	  5501:     jsr     CalcOpenDoorwayMask
02:0004278A 101D            	  5502:     move.b  (A5)+,D0  ; PLA
                            	  5503: _anon_z05_112:
                            	  5504:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5505:     ; because the visible door face is already a wall.
                            	  5506:     ;
02:0004278C 0C000004        	  5507:     cmpi.b  #$04,D0
02:00042790 650000DC        	  5508:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5509:     ; For all other provisional face values, calculate:
                            	  5510:     ; door face := provisional face - 3
02:00042794 003C0011        	  5511:     ori     #$11,CCR  ; SEC: set C+X
02:00042798 123C0003        	  5512:     move.b  #$03,D1
02:0004279C 0A3C0010        	  5513:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000427A0 9101            	  5514:     subx.b  D1,D0   ; SBC #$03
02:000427A2 0A3C0010        	  5515:     eori    #$10,CCR  ; restore X = 6502 C
02:000427A6 7600            	  5516:     moveq   #0,D3
02:000427A8 1600            	  5517:     move.b  D0,D3
                            	  5518:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5519:     ; subtract one.
                            	  5520:     ;
02:000427AA 0C030003        	  5521:     cmpi.b  #$03,D3
02:000427AE 6502            	  5522:     bcs  _anon_z05_113
02:000427B0 5303            	  5523:     subq.b  #1,D3
                            	  5524: _anon_z05_113:
                            	  5525:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5526:     ;
                            	  5527:     ; DT DFC DFO Meaning
                            	  5528:     ; ------------------
                            	  5529:     ; 0  1   1   open
                            	  5530:     ; 4  4   5   bombable
                            	  5531:     ; 5  2   1   key
                            	  5532:     ; 6  2   1   key 2
                            	  5533:     ; 7  3   1   shutter
                            	  5534:     ;
                            	  5535:     ;
                            	  5536:     ; Get the direction index.
02:000427B2 101D            	  5537:     move.b  (A5)+,D0  ; PLA
02:000427B4 1B00            	  5538:     move.b  D0,-(A5)  ; PHA
02:000427B6 610000D0        	  5539:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5540:     ; If handling the second half, then offset to the second half
                            	  5541:     ; of the tiles.
                            	  5542:     ;
02:000427BA 102C0006        	  5543:     move.b  ($0006,A4),D0
02:000427BE 6618            	  5544:     bne  _anon_z05_114
02:000427C0 41F9000426D6    	  5545:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000427C6 10302000        	  5546:     move.b  (A0,D2.W),D0
02:000427CA 4EB9000309DC    	  5547:     jsr     AddToInt16At0
02:000427D0 7006            	  5548:     moveq   #6,D0
02:000427D2 4EB9000309E4    	  5549:     jsr     AddToInt16At2
                            	  5550: _anon_z05_114:
                            	  5551:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5552:     ; Pointers will be incremented instead of Y.
02:000427D8 7600            	  5553:     moveq   #0,D3
02:000427DA 41F9000426DA    	  5554:     lea     (DirIndexToDoorColumnCount).l,A0
02:000427E0 10302000        	  5555:     move.b  (A0,D2.W),D0
02:000427E4 19400005        	  5556:     move.b  D0,($0005,A4)
                            	  5557:     even
                            	  5558: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5559:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5560:     ;
02:000427E8 101D            	  5561:     move.b  (A5)+,D0  ; PLA
02:000427EA 1B00            	  5562:     move.b  D0,-(A5)  ; PHA
02:000427EC 7400            	  5563:     moveq   #0,D2
02:000427EE 1400            	  5564:     move.b  D0,D2
                            	  5565:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5566:     ; starting from highest index down to 0:
                            	  5567:     ;
02:000427F0 41F9000426DE    	  5568:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:000427F6 10302000        	  5569:     move.b  (A0,D2.W),D0
02:000427FA 7400            	  5570:     moveq   #0,D2
02:000427FC 1400            	  5571:     move.b  D0,D2
                            	  5572:     even
                            	  5573: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:000427FE 122C0002        	  5574:     move.b  ($02,A4),D1   ; ptr lo
02:00042802 182C0003        	  5575:     move.b  ($03,A4),D4  ; ptr hi
02:00042806 024100FF        	  5576:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004280A E14C            	  5577:     lsl.w   #8,D4
02:0004280C 8841            	  5578:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004280E 48C4            	  5579:     ext.l   D4
02:00042810 D8BC00FF0000    	  5580:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042816 2044            	  5581:     movea.l D4,A0
02:00042818 10303000        	  5582:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004281C 1214            	  5583:     move.b  ($00,A4),D1   ; ptr lo
02:0004281E 182C0001        	  5584:     move.b  ($01,A4),D4  ; ptr hi
02:00042822 024100FF        	  5585:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042826 E14C            	  5586:     lsl.w   #8,D4
02:00042828 8841            	  5587:     or.w    D1,D4
02:0004282A 48C4            	  5588:     ext.l   D4
02:0004282C D8BC00FF0000    	  5589:     add.l   #NES_RAM,D4
02:00042832 2044            	  5590:     movea.l D4,A0
02:00042834 11803000        	  5591:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:00042838 4EB9000309E0    	  5592:     jsr     Add1ToInt16At2
02:0004283E 41F9000426D2    	  5593:     lea     (NextDoorTileOffsets).l,A0
02:00042844 10302000        	  5594:     move.b  (A0,D2.W),D0
02:00042848 4EB9000309DC    	  5595:     jsr     AddToInt16At0
                            	  5596:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5597:     ; go 1 more tile down, to start the next column at the right place.
                            	  5598:     ; We have to compensate for the fact that E/W doors are 
                            	  5599:     ; shorter vertically than N/S doors.
02:0004284E 4A02            	  5600:     cmpi.b  #$00,D2
02:00042850 6610            	  5601:     bne  _anon_z05_115
02:00042852 101D            	  5602:     move.b  (A5)+,D0  ; PLA
02:00042854 1B00            	  5603:     move.b  D0,-(A5)  ; PHA
02:00042856 0C000002        	  5604:     cmpi.b  #$02,D0
02:0004285A 6406            	  5605:     bcc  _anon_z05_115
02:0004285C 4EB9000309D8    	  5606:     jsr     Add1ToInt16At0
                            	  5607: _anon_z05_115:
