                            	  7740: PrepFullBlackRow:
                            	  7741:     ; Prepare the dynamic transfer buf with a row of blank ($24) tiles
                            	  7742:     ; to transfer to row (7 + Y).
                            	  7743:     ;
                            	  7744:     ; Calculate PPU address ($28E0 + Y*$20).
                            	  7745:     ;
02:00043CE0 7028            	  7746:     moveq   #40,D0
02:00043CE2 19400302        	  7747:     move.b  D0,($0302,A4)
02:00043CE6 103C00C0        	  7748:     move.b  #$C0,D0
