02:0003038C 023C00EE        	  1822:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  1823:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  1824:     ;
02:00030390 122C0340        	  1825:     move.b  ($0340,A4),D1
02:00030394 D101            	  1826:     addx.b  D1,D0   ; ADC CurObjIndex
02:00030396 7400            	  1827:     moveq   #0,D2
02:00030398 1400            	  1828:     move.b  D0,D2
                            	  1829:     ; Look up and set the location for this iteration's individual trap.
                            	  1830:     ;
02:0003039A 41F90003035E    	  1831:     lea     (TrapXs).l,A0
02:000303A0 10303000        	  1832:     move.b  (A0,D3.W),D0
02:000303A4 19802070        	  1833:     move.b  D0,($70,A4,D2.W)
02:000303A8 41F900030364    	  1834:     lea     (TrapYs).l,A0
02:000303AE 10303000        	  1835:     move.b  (A0,D3.W),D0
02:000303B2 41EC0084        	  1836:     lea     ($0084,A4),A0
02:000303B6 11802000        	  1837:     move.b  D0,(A0,D2.W)
02:000303BA 619E            	  1838:     jsr     InitOneSimpleObject
02:000303BC 5302            	  1839:     subq.b  #1,D2
02:000303BE 5303            	  1840:     subq.b  #1,D3
02:000303C0 6AC8            	  1841:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:000303C2 4E75            	  1842:     rts
