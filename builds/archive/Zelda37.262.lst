02:00034488 003C0011        	  2787:     ori     #$11,CCR  ; SEC: set C+X
02:0003448C 123C0008        	  2788:     move.b  #$08,D1
02:00034490 0A3C0010        	  2789:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034494 9101            	  2790:     subx.b  D1,D0   ; SBC #$08
02:00034496 0A3C0010        	  2791:     eori    #$10,CCR  ; restore X = 6502 C
02:0003449A 7600            	  2792:     moveq   #0,D3
02:0003449C 1600            	  2793:     move.b  D0,D3
02:0003449E 102C0015        	  2794:     move.b  ($0015,A4),D0
