02:0003B0B6 10302000        	  5216:     move.b  (A0,D2.W),D0
02:0003B0BA 0200000F        	  5217:     andi.b #$0F,D0
02:0003B0BE 6608            	  5218:     bne  _anon_z04_75
02:0003B0C0 41EC0394        	  5219:     lea     ($0394,A4),A0
