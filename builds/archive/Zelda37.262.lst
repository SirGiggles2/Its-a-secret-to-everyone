                            	  6041: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6042:     ; Digdogger is big, but room boundary checks and
                            	  6043:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6044:     ; Therefore, we have to check these things four times,
                            	  6045:     ; in different corners of the boss.
                            	  6046:     ;
                            	  6047:     ; Loop 4 times, from 0 to 3.
                            	  6048:     ;
02:0003B68E 7600            	  6049:     moveq   #0,D3
02:0003B690 41EC0478        	  6050:     lea     ($0478,A4),A0
02:0003B694 16302000        	  6051:     move.b  (A0,D2.W),D3
                            	  6052:     ; Change the coordinates to one corner.
                            	  6053:     ;
02:0003B698 10342070        	  6054:     move.b  ($70,A4,D2.W),D0
02:0003B69C 023C00EE        	  6055:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6A0 41F90003B554    	  6056:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003B6A6 12303000        	  6057:     move.b  (A0,D3.W),D1
02:0003B6AA D101            	  6058:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003B6AC 19802070        	  6059:     move.b  D0,($70,A4,D2.W)
02:0003B6B0 41EC0084        	  6060:     lea     ($0084,A4),A0
02:0003B6B4 10302000        	  6061:     move.b  (A0,D2.W),D0
02:0003B6B8 023C00EE        	  6062:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6BC 41F90003B558    	  6063:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003B6C2 12303000        	  6064:     move.b  (A0,D3.W),D1
02:0003B6C6 D101            	  6065:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003B6C8 41EC0084        	  6066:     lea     ($0084,A4),A0
02:0003B6CC 11802000        	  6067:     move.b  D0,(A0,D2.W)
                            	  6068:     ; Check the room boundary and object collisions in this temporary location.
                            	  6069:     ;
02:0003B6D0 61003734        	  6070:     jsr     BoundFlyer
02:0003B6D4 4EB9000310A4    	  6071:     jsr     CheckMonsterCollisions
                            	  6072:     ; Increase the loop index, and loop again until it = 4.
                            	  6073:     ;
02:0003B6DA 41EC0478        	  6074:     lea     ($0478,A4),A0
02:0003B6DE 52302000        	  6075:     addq.b  #1,(A0,D2.W)
02:0003B6E2 41EC0478        	  6076:     lea     ($0478,A4),A0
02:0003B6E6 10302000        	  6077:     move.b  (A0,D2.W),D0
02:0003B6EA 0C000004        	  6078:     cmpi.b  #$04,D0
02:0003B6EE 659E            	  6079:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6080:     ; Restore the original coordinates.
                            	  6081:     ;
02:0003B6F0 101D            	  6082:     move.b  (A5)+,D0  ; PLA
02:0003B6F2 41EC0084        	  6083:     lea     ($0084,A4),A0
02:0003B6F6 11802000        	  6084:     move.b  D0,(A0,D2.W)
02:0003B6FA 101D            	  6085:     move.b  (A5)+,D0  ; PLA
02:0003B6FC 19802070        	  6086:     move.b  D0,($70,A4,D2.W)
