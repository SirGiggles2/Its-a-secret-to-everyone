02:00041231 78
02:00041232 8D
02:00041233 8D
                            	  3946: 
                            	  3947: ; Player coordinate must be >= these bounds.
                            	  3948: ; Using these bounds; the player will be considered within the
                            	  3949: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3950: ;
                            	  3951:     even
                            	  3952: DoorwayBoundsMinOver:
02:00041234 3D              	  3953:     dc.b    $3D, $BD, $00, $CF
02:00041235 BD
02:00041236 00
02:00041237 CF
                            	  3954: 
                            	  3955: ; Player coordinate must be < these bounds.
                            	  3956: ; Using these bounds; the player will be considered within the
                            	  3957: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3958: ;
                            	  3959:     even
                            	  3960: DoorwayBoundsMaxOver:
02:00041238 5E              	  3961:     dc.b    $5E, $DE, $21, $F1
02:00041239 DE
02:0004123A 21
02:0004123B F1
                            	  3962: 
                            	  3963: ; Player coordinate must be >= these bounds.
                            	  3964: ; Using these bounds; the player will be considered within the
                            	  3965: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3966: ; at the edge.
                            	  3967: ;
                            	  3968:     even
                            	  3969: DoorwayBoundsMinUnder:
02:0004123C 3D              	  3970:     dc.b    $3D, $BF, $00, $D2
02:0004123D BF
02:0004123E 00
02:0004123F D2
                            	  3971: 
                            	  3972: ; Player coordinate must be < these bounds.
                            	  3973: ; Using these bounds; the player will be considered within the
                            	  3974: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3975: ; at the edge.
                            	  3976: ;
                            	  3977:     even
                            	  3978: DoorwayBoundsMaxUnder:
02:00041240 5C              	  3979:     dc.b    $5C, $DE, $1F, $F1
02:00041241 DE
02:00041242 1F
02:00041243 F1
                            	  3980: 
                            	  3981: ; Params:
                            	  3982: ; [0F]: moving direction
                            	  3983: ;
                            	  3984: ; Returns:
                            	  3985: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3986: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3987: ;
                            	  3988: ; When not at or in a doorway, this function leaves
                            	  3989: ; [0F] moving direction as is.
                            	  3990: ;
                            	  3991: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3992: ; will be left as is, assuming that it had been reset before this
                            	  3993: ; routine by BoundByRoom.
                            	  3994: ;
                            	  3995: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3996: ;
                            	  3997: ;
                            	  3998: ; If already in a doorway, go handle it separately.
                            	  3999: ;
                            	  4000:     even
                            	  4001: CheckDoorway:
02:00041244 102C0053        	  4002:     move.b  ($0053,A4),D0
02:00041248 6648            	  4003:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4004:     even
                            	  4005: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4006:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4007:     ;
                            	  4008:     ; To match a doorway:
                            	  4009:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4010:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4011:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4012:     ;
                            	  4013:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4014:     ; a doorway to be part of it.
                            	  4015:     ;
02:0004124A 102C0098        	  4016:     move.b  ($0098,A4),D0
02:0004124E 61000122        	  4017:     jsr     GetPlayerCoordsForDirection
02:00041252 7603            	  4018:     moveq   #3,D3
                            	  4019:     even
                            	  4020: _L_z05_CheckDoorway_LoopOverflowBounds:
02:00041254 1014            	  4021:     move.b  ($0000,A4),D0
