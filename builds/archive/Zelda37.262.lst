02:0003A188 0A3C0010        	  3083:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A18C E308            	  3084:     lsl.b  #1,D0   ; ASL A
02:0003A18E 023C00EE        	  3085:     andi    #$EE,CCR  ; CLC: clear C+X
