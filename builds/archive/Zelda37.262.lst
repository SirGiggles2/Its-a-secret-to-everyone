                            	  2325: ;==============================================================================
                            	  2326: ; EXPORT side — carry-returning shims.
                            	  2327: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2328: ; reproduces the original function's carry normalization.
                            	  2329: ;==============================================================================
                            	  2330: 
                            	  2331: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2332: c_copy_next_row_to_transfer_buf:
02:0002BF82 4EB900000000    	  2333:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF88 08000008        	  2334:     btst    #8,D0
02:0002BF8C 670A            	  2335:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2336:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2337:     eori    #$01,CCR
02:0002BF96 4E75            	  2338:     rts
                            	  2339: .cc_cnr:
02:0002BF98 023C00FE        	  2340:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2341:     eori    #$01,CCR
02:0002BFA0 4E75            	  2342:     rts
                            	  2343: 
                            	  2344: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2345: c_copy_next_row_advance_submode:
