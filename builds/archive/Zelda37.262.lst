                            	  7305: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7306:     ; If the "monsters from edges" long timer expired, then
                            	  7307:     ; go bring the monster in.
                            	  7308:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7309:     ;
                            	  7310:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7311:     ; residual position so enemies keep their previous-room
                            	  7312:     ; positions instead of being re-edge-spawned (matches NES).
02:0004C216 102C004B        	  7313:     move.b  ($004B,A4),D0
02:0004C21A 662E            	  7314:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7315:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004C21C 102C000F        	  7316:     move.b  ($000F,A4),D0
02:0004C220 0C0000FF        	  7317:     cmpi.b  #$FF,D0
02:0004C224 662E            	  7318:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004C226 41EC0070        	  7319:     lea     ($0070,A4),A0
02:0004C22A 10302000        	  7320:     move.b  (A0,D2.W),D0
02:0004C22E 660A            	  7321:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004C230 41EC0084        	  7322:     lea     ($0084,A4),A0
02:0004C234 10302000        	  7323:     move.b  (A0,D2.W),D0
02:0004C238 671A            	  7324:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7325:     even
                            	  7326: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:0004C23A 7001            	  7327:     moveq   #1,D0
02:0004C23C 1940004B        	  7328:     move.b  D0,($004B,A4)
02:0004C240 41EC0492        	  7329:     lea     ($0492,A4),A0
02:0004C244 11802000        	  7330:     move.b  D0,(A0,D2.W)
02:0004C248 4E75            	  7331:     rts
                            	  7332:     even
