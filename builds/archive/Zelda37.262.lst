                            	  4946: _L_z01_BeginShove_MonsterDefender:
                            	  4947:     ; A monster is the defender. A weapon is the attacker.
                            	  4948:     ;
                            	  4949:     ; Set the shove direction to the weapon's direction,
                            	  4950:     ; instead of the direction passed in [0B].
                            	  4951:     ;
02:00031918 41EC0098        	  4952:     lea     ($0098,A4),A0
