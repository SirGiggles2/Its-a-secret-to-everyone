02:0003BE3E 41EC00AC        	  7032:     lea     ($00AC,A4),A0
02:0003BE42 10302000        	  7033:     move.b  (A0,D2.W),D0
02:0003BE46 66000086        	  7034:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7035:     ; If facing vertically, then store (X + 8) in [00].
                            	  7036:     ; Else store (X + $10).
