02:0003A68A 41EC0492        	  3814:     lea     ($0492,A4),A0
02:0003A68E 10302000        	  3815:     move.b  (A0,D2.W),D0
02:0003A692 66EC            	  3816:     bne  _anon_z04_53
02:0003A694 4EB90004C612    	  3817:     jsr     ResetObjMetastateAndTimer
02:0003A69A 6000F45A        	  3818:     jmp     EndInitFlyer
