02:0003F28C 0003F2DE        	   214:     dc.l    UpdateMenuCommon2   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F290 0003F2F0        	   215:     dc.l    UpdateMenuCommon3   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F294 0003F2F6        	   216:     dc.l    UpdateMenuCommon4   ; jump table entry (32-bit for _m68k_tablejump)
