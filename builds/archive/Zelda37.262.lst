                            	  4004: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  4005:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  4006:     ;   full heart=4 partial heart=$70
                            	  4007:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  4008:     ; But the method here yields $3EF, because partial heart is
                            	  4009:     ; considered full when = $FF instead of $100.
                            	  4010:     ;
02:00031398 102C000E        	  4011:     move.b  ($000E,A4),D0
02:0003139C 003C0011        	  4012:     ori     #$11,CCR  ; SEC: set C+X
02:000313A0 122C0670        	  4013:     move.b  ($0670,A4),D1
02:000313A4 0A3C0010        	  4014:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000313A8 9101            	  4015:     subx.b  D1,D0   ; SBC HeartPartial
02:000313AA 0A3C0010        	  4016:     eori    #$10,CCR  ; restore X = 6502 C
02:000313AE 1940000E        	  4017:     move.b  D0,($000E,A4)
02:000313B2 102C066F        	  4018:     move.b  ($066F,A4),D0
02:000313B6 0200000F        	  4019:     andi.b #$0F,D0
02:000313BA 6710            	  4020:     beq  _L_z01_Link_BeHarmed_HandleDied
02:000313BC 532C066F        	  4021:     subq.b  #1,($066F,A4)
02:000313C0 103C00FF        	  4022:     move.b  #$FF,D0
02:000313C4 19400670        	  4023:     move.b  D0,($0670,A4)
02:000313C8 6600FF6E        	  4024:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  4025:     even
