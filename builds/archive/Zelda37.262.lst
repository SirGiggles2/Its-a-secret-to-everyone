02:0003BBB4 D101            	  6681:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003BBB6 19400001        	  6682:     move.b  D0,($0001,A4)
                            	  6683:     ; Calculate sprite attributes:
                            	  6684:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6685:     ;
                            	  6686:     ; If the boss is temporarily invincible, then
                            	  6687:     ; this makes it flash by cycling all the palette rows.
                            	  6688:     ;
                            	  6689:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6690:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6691:     ;
02:0003BBBA 41EC04F0        	  6692:     lea     ($04F0,A4),A0
02:0003BBBE 10302000        	  6693:     move.b  (A0,D2.W),D0
02:0003BBC2 02000003        	  6694:     andi.b #$03,D0
02:0003BBC6 0A000003        	  6695:     eori.b #$03,D0
02:0003BBCA 19400003        	  6696:     move.b  D0,($0003,A4)
02:0003BBCE 7600            	  6697:     moveq   #0,D3
02:0003BBD0 162C000A        	  6698:     move.b  ($000A,A4),D3
                            	  6699:     ; Look up the tile for this sprite.
                            	  6700:     ; If it's not the first one (face), then go write the sprite record.
                            	  6701:     ;
02:0003BBD4 41F90003BB52    	  6702:     lea     (AquamentusTiles).l,A0
02:0003BBDA 10303000        	  6703:     move.b  (A0,D3.W),D0
02:0003BBDE 12390003BB52    	  6704:     move.b  (AquamentusTiles).l,D1
02:0003BBE4 B001            	  6705:     cmp.b   D1,D0
02:0003BBE6 6610            	  6706:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6707:     ; Else it's the first one (the face tile).
                            	  6708:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6709:     ;
                            	  6710:     ; $CC/CD shows the closed mouth face.
                            	  6711:     ; $C0/C1 shows the open mouth face.
                            	  6712:     ;
02:0003BBE8 7600            	  6713:     moveq   #0,D3
02:0003BBEA 16342028        	  6714:     move.b  ($28,A4,D2.W),D3
02:0003BBEE 0C030020        	  6715:     cmpi.b  #$20,D3
02:0003BBF2 6404            	  6716:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
