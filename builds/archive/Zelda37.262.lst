02:0003BC98 7020            	  6806:     moveq   #32,D0
02:0003BC9A 41EC041F        	  6807:     lea     ($041F,A4),A0
02:0003BC9E 11802000        	  6808:     move.b  D0,(A0,D2.W)
02:0003BCA2 6100D0FC        	  6809:     jsr     Wanderer_TargetPlayer
                            	  6810:     ; Pop the offset and add it to the X coordinate.
                            	  6811:     ;
                            	  6812:     ; This brings the X coordinate back to the unique value
                            	  6813:     ; that represents the position.
