02:00032B9A D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00032BA0 2044            	   563:     movea.l D4,A0
02:00032BA2 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00032BA6 41EC0630        	   565:     lea     ($0630,A4),A0
02:00032BAA 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00032BAE 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
