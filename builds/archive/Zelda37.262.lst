                            	   589: L_Walker_SetInputDirAndTryShootingBoomerang:
                            	   590:     ; Set the input direction to the facing direction.
                            	   591:     ;
02:00038FFE 41EC0098        	   592:     lea     ($0098,A4),A0
02:00039002 10302000        	   593:     move.b  (A0,D2.W),D0
02:00039006 41EC03F8        	   594:     lea     ($03F8,A4),A0
02:0003900A 11802000        	   595:     move.b  D0,(A0,D2.W)
                            	   596:     ; Goriya will throw a boomerang (object type $5C).
                            	   597:     ;
02:0003900E 705C            	   598:     moveq   #92,D0
                            	   599:     ; If the monster is a blue goriya, go check the timer.
                            	   600:     ;
02:00039010 7600            	   601:     moveq   #0,D3
02:00039012 41EC034F        	   602:     lea     ($034F,A4),A0
02:00039016 16302000        	   603:     move.b  (A0,D2.W),D3
02:0003901A 0C030005        	   604:     cmpi.b  #$05,D3
02:0003901E 671C            	   605:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   606:     ; If it's not a red goriya either, then return.
                            	   607:     ;
02:00039020 0C030006        	   608:     cmpi.b  #$06,D3
02:00039024 660000A0        	   609:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   610:     ; If a random value <> $23 nor $77, then return.
                            	   611:     ;
02:00039028 10342018        	   612:     move.b  ($18,A4,D2.W),D0
02:0003902C 0C000023        	   613:     cmpi.b  #$23,D0
02:00039030 6708            	   614:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang
02:00039032 0C000077        	   615:     cmpi.b  #$77,D0
02:00039036 6600008E        	   616:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   617:     even
                            	   618: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang:
                            	   619:     ; Goriya will throw a boomerang (object type $5C).
                            	   620:     ;
02:0003903A 705C            	   621:     moveq   #92,D0
                            	   622:     even
                            	   623: _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot:
                            	   624:     ; If object timer <> 0, return.
                            	   625:     ;
