02:0003E782 41F90003E652    	 12636:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003E788 12302000        	 12637:     move.b  (A0,D2.W),D1
02:0003E78C 8001            	 12638:     or.b  D1,D0
02:0003E78E 19400003        	 12639:     move.b  D0,($0003,A4)
02:0003E792 41F90003E65C    	 12640:     lea     (GanonBurstTiles).l,A0
02:0003E798 10302000        	 12641:     move.b  (A0,D2.W),D0
