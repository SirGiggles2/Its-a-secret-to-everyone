02:0004B778 6000FB70        	  5933:     jmp     UpdateArrowOrBoomerang
                            	  5934: 
                            	  5935: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  5936: ; Each set contains 4 offsets in reverse direction index order:
                            	  5937: ; up, down, left, right
                            	  5938: ;
                            	  5939: ; These offsets are added to player X to get weapon X.
                            	  5940: ;
                            	  5941:     even
                            	  5942: PlayerToWeaponOffsetsX:
02:0004B77C FF              	  5943:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004B77D 01
02:0004B77E 00
02:0004B77F F8
02:0004B780 FF
02:0004B781 01
02:0004B782 F5
02:0004B783 0B
02:0004B784 FF              	  5944:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004B785 01
02:0004B786 F9
02:0004B787 07
02:0004B788 FF
02:0004B789 01
02:0004B78A FD
02:0004B78B 03
                            	  5945: 
                            	  5946: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5947: ; Each set contains 4 offsets in reverse direction index order:
                            	  5948: ; up, down, left, right
                            	  5949: ;
                            	  5950: ; These offsets are added to player Y to get weapon Y.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PlayerToWeaponOffsetsY:
02:0004B78C F7              	  5954:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:0004B78D F2
02:0004B78E F5
02:0004B78F F5
02:0004B790 F6
02:0004B791 0D
02:0004B792 03
02:0004B793 03
02:0004B794 F7              	  5955:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:0004B795 09
02:0004B796 03
02:0004B797 03
02:0004B798 FF
02:0004B799 05
02:0004B79A 03
02:0004B79B 03
