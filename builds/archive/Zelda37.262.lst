02:0004B924 0200000F        	  6153:     andi.b #$0F,D0
02:0004B928 0C000003        	  6154:     cmpi.b  #$03,D0
02:0004B92C 6704            	  6155:     beq.s  __far_z_07_0092
02:0004B92E 60000084        	  6156:     jmp  L1F854_Exit
                            	  6157: __far_z_07_0092:
                            	  6158:     ; State = 3. Time to instantiate a shot.
                            	  6159:     ;
                            	  6160:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6161:     ;
02:0004B932 0C020012        	  6162:     cmpi.b  #$12,D2
02:0004B936 6704            	  6163:     beq.s  __far_z_07_0093
02:0004B938 60000082        	  6164:     jmp  MakeSwordShot
                            	  6165: __far_z_07_0093:
                            	  6166:     ; Instantiate a magic shot (rod shot).
