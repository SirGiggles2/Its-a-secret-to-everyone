                            	   714: UpdateBlock0Idle:
                            	   715:     ; If there are monsters in the room, go reset the push timer and return.
                            	   716:     ;
02:000390EA 102C034D        	   717:     move.b  ($034D,A4),D0
02:000390EE 6604            	   718:     bne.s  __far_z_04_0005
02:000390F0 600000DA        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:000390F4 102C0070        	   725:     move.b  ($0070,A4),D0
02:000390F8 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:000390FC B001            	   727:     cmp.b   D1,D0
02:000390FE 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039100 7600            	   729:     moveq   #0,D3
02:00039102 102C0084        	   730:     move.b  ($0084,A4),D0
02:00039106 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003910A 123C0003        	   732:     move.b  #$03,D1
02:0003910E D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039110 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:00039114 41EC0084        	   735:     lea     ($0084,A4),A0
02:00039118 12302000        	   736:     move.b  (A0,D2.W),D1
02:0003911C 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039120 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:00039122 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:00039126 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:00039128 102C0084        	   747:     move.b  ($0084,A4),D0
02:0003912C 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039130 123C0003        	   749:     move.b  #$03,D1
02:00039134 D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039136 41EC0084        	   751:     lea     ($0084,A4),A0
02:0003913A 12302000        	   752:     move.b  (A0,D2.W),D1
02:0003913E B001            	   753:     cmp.b   D1,D0
02:00039140 6704            	   754:     beq.s  __far_z_04_0006
02:00039142 60000088        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:00039146 7602            	   760:     moveq   #2,D3
02:00039148 102C0070        	   761:     move.b  ($0070,A4),D0
02:0003914C 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:00039150 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:00039154 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039158 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:0003915A 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:0003915E 6A08            	   776:     bpl  _anon_z04_14
02:00039160 5203            	   777:     addq.b  #1,D3
02:00039162 4EB900030826    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
                            	   780:     ; If the distance >= $11, then go reset the push timer and return.
                            	   781:     ;
02:00039168 0C000011        	   782:     cmpi.b  #$11,D0
02:0003916C 6502            	   783:     bcs.s  __far_z_04_0007
02:0003916E 605C            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:00039170 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:00039174 41F9000390C8    	   792:     lea     (BlockPushDirections).l,A0
02:0003917A 12303000        	   793:     move.b  (A0,D3.W),D1
02:0003917E B001            	   794:     cmp.b   D1,D0
02:00039180 6702            	   795:     beq.s  __far_z_04_0008
02:00039182 6048            	   796:     jmp  ResetPushTimer
                            	   797: __far_z_04_0008:
                            	   798:     ; Link is truly pushing the block.
                            	   799:     ;
                            	   800:     ; Increase the push timer.
                            	   801:     ;
02:00039184 41EC0412        	   802:     lea     ($0412,A4),A0
02:00039188 52302000        	   803:     addq.b  #1,(A0,D2.W)
                            	   804:     ; If the push timer still < $10, return.
                            	   805:     ;
02:0003918C 7600            	   806:     moveq   #0,D3
02:0003918E 41EC0412        	   807:     lea     ($0412,A4),A0
02:00039192 16302000        	   808:     move.b  (A0,D2.W),D3
02:00039196 0C030010        	   809:     cmpi.b  #$10,D3
02:0003919A 6402            	   810:     bcc.s  __far_z_04_0009
02:0003919C 6034            	   811:     jmp  L10262_Exit
