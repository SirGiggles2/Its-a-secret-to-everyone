                            	  3614:     even
                            	  3615: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003A570 102C000D        	  3616:     move.b  ($000D,A4),D0
                            	  3617: ; Params:
                            	  3618: ; A: frame image
                            	  3619: ; X: object index
                            	  3620: ; [00]: object X
                            	  3621: ; [01]: object Y
                            	  3622: ; [0F]: flip horizontally
                            	  3623: ;
                            	  3624: ; Returns:
                            	  3625: ; [00]: 0 for Link slot
                            	  3626: ; [06]: 1 if objects collide
                            	  3627: ; [09]: 0 for Link damage type (none)
                            	  3628: ; [0C]: 1 if objects collide
                            	  3629: ; [034B]: ShotCollidesWithLink
                            	  3630: ;
                            	  3631:     even
                            	  3632: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003A574 4EB900030D28    	  3633:     jsr     DrawObjectNotMirrored
02:0003A57A 4EF9000311A6    	  3634:     jmp     CheckLinkCollision
                            	  3635: 
                            	  3636:     even
