02:0003BB9C 1880            	  6672:     move.b  D0,($0000,A4)
                            	  6673:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6674:     ; Store it in [01].
                            	  6675:     ;
02:0003BB9E 41EC0084        	  6676:     lea     ($0084,A4),A0
02:0003BBA2 10302000        	  6677:     move.b  (A0,D2.W),D0
02:0003BBA6 023C00EE        	  6678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBAA 41F90003BB5E    	  6679:     lea     (AquamentusSpriteOffsetsY).l,A0
