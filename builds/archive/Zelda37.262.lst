02:0003037A 1880            	  1808:     move.b  D0,($0000,A4)
                            	  1809:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  1810:     ; then we'll make 4 traps.
                            	  1811:     ;
02:0003037C 41EC034F        	  1812:     lea     ($034F,A4),A0
02:00030380 12302000        	  1813:     move.b  (A0,D2.W),D1
