                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:0003F432 103C00FD        	   447:     move.b  #$FD,D0
02:0003F436 613A            	   448:     jsr     MovePositionMarkers
02:0003F438 102C00FC        	   449:     move.b  ($00FC,A4),D0
02:0003F43C 023C00EE        	   450:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F440 123C0003        	   451:     move.b  #$03,D1
02:0003F444 D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003F446 194000FC        	   453:     move.b  D0,($00FC,A4)
                            	   454:     ; If hardware vertical scroll still < $F0, then return.
                            	   455:     ;
02:0003F44A 0C0000F0        	   456:     cmpi.b  #$F0,D0
