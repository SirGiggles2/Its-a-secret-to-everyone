02:00040B78 102C0098        	  2971:     move.b  ($0098,A4),D0
02:00040B7C 0200000C        	  2972:     andi.b #$0C,D0
02:00040B80 6602            	  2973:     bne  _anon_z05_77
02:00040B82 7603            	  2974:     moveq   #3,D3
                            	  2975: _anon_z05_77:
