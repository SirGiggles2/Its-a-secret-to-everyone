                            	  5179: UpdateBoomerangOrFood:
                            	  5180:     ; If state = 0, then not active. So, return.
                            	  5181:     ;
02:0004B22E 41EC00AC        	  5182:     lea     ($00AC,A4),A0
02:0004B232 10302000        	  5183:     move.b  (A0,D2.W),D0
02:0004B236 6602            	  5184:     bne.s  __far_z_07_0078
02:0004B238 60F2            	  5185:     jmp  L1F49F_Exit
                            	  5186: __far_z_07_0078:
                            	  5187:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5188:     ;
02:0004B23A E308            	  5189:     lsl.b  #1,D0   ; ASL A
