                            	  4803: BeginShove:
02:00031838 7600            	  4804:     moveq   #0,D3
02:0003183A 1614            	  4805:     move.b  ($0000,A4),D3
02:0003183C 0C02000D        	  4806:     cmpi.b  #$0D,D2
02:00031840 6412            	  4807:     bcc  _anon_z01_99
02:00031842 41EC04B2        	  4808:     lea     ($04B2,A4),A0
02:00031846 10302000        	  4809:     move.b  (A0,D2.W),D0
02:0003184A 122C0009        	  4810:     move.b  ($0009,A4),D1
02:0003184E C001            	  4811:     and.b  D1,D0
02:00031850 660000C4        	  4812:     bne  _L_z01_BeginShove_Exit
                            	  4813: _anon_z01_99:
                            	  4814:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  4815:     ; if he is defending. The goal is to push Link away from the monster.
                            	  4816:     ;
                            	  4817:     ; If instead a monster is defending, then all this calculation
                            	  4818:     ; won't matter, because the shove direction will be set to the
                            	  4819:     ; weapon's direction.
                            	  4820:     ;
                            	  4821:     ; As such, calculate a direction from the monster to the defender,
                            	  4822:     ; assuming it's Link.
                            	  4823:     ;
                            	  4824:     ; Start with an assumption that the direction is vertical:
                            	  4825:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  4826:     ;
02:00031854 7008            	  4827:     moveq   #8,D0
02:00031856 19400008        	  4828:     move.b  D0,($0008,A4)
02:0003185A 41EC0084        	  4829:     lea     ($0084,A4),A0
02:0003185E 10302000        	  4830:     move.b  (A0,D2.W),D0
02:00031862 19400004        	  4831:     move.b  D0,($0004,A4)
02:00031866 41EC0084        	  4832:     lea     ($0084,A4),A0
02:0003186A 10303000        	  4833:     move.b  (A0,D3.W),D0
02:0003186E 19400005        	  4834:     move.b  D0,($0005,A4)
                            	  4835:     ; If the defender is Link and his grid offset <> 0 then
                            	  4836:     ; use his usual object direction variable to determine
                            	  4837:     ; which axis to check.
                            	  4838:     ;
02:00031872 4A03            	  4839:     cmpi.b  #$00,D3
02:00031874 6612            	  4840:     bne  _anon_z01_100
02:00031876 102C0394        	  4841:     move.b  ($0394,A4),D0
02:0003187A 670C            	  4842:     beq  _anon_z01_100
02:0003187C 102C0098        	  4843:     move.b  ($0098,A4),D0
02:00031880 02000003        	  4844:     andi.b #$03,D0
02:00031884 660C            	  4845:     bne  _L_z01_BeginShove_CheckHorizontal
02:00031886 6720            	  4846:     beq  _L_z01_BeginShove_CheckVertical
                            	  4847: _anon_z01_100:
                            	  4848:     ; For monsters defending, or Link with grid offset = 0,
                            	  4849:     ; check direction in [0B].
                            	  4850:     ;
                            	  4851:     ; For monsters defending, this won't matter. For Link with grid
                            	  4852:     ; offset = 0, I believe the result will be arbitrary.
                            	  4853:     ;
                            	  4854:     ; TODO:
                            	  4855:     ; Is [0B] always set if Link's grid offset = 0?
                            	  4856:     ; It doesn't seem to be if candle fire attacks him.
                            	  4857:     ;
02:00031888 102C000B        	  4858:     move.b  ($000B,A4),D0
02:0003188C 0C000004        	  4859:     cmpi.b  #$04,D0
02:00031890 6416            	  4860:     bcc  _L_z01_BeginShove_CheckVertical
                            	  4861:     even
                            	  4862: _L_z01_BeginShove_CheckHorizontal:
                            	  4863:     ; If the direction checked is left or right,
                            	  4864:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  4865:     ;
02:00031892 7002            	  4866:     moveq   #2,D0
02:00031894 19400008        	  4867:     move.b  D0,($0008,A4)
02:00031898 10342070        	  4868:     move.b  ($70,A4,D2.W),D0
02:0003189C 19400004        	  4869:     move.b  D0,($0004,A4)
02:000318A0 10343070        	  4870:     move.b  ($70,A4,D3.W),D0
02:000318A4 19400005        	  4871:     move.b  D0,($0005,A4)
                            	  4872:     even
                            	  4873: _L_z01_BeginShove_CheckVertical:
                            	  4874:     ; If the monster is down or right of the other object,
                            	  4875:     ; then use the opposite direction already in [08].
                            	  4876:     ; Else shift [08] right to turn it into the opposite
                            	  4877:     ; direction up or down.
                            	  4878:     ;
                            	  4879:     ; Again assuming Link is the defender; after this, [08] points
                            	  4880:     ; Link away from the monster.
                            	  4881:     ;
02:000318A8 102C0004        	  4882:     move.b  ($0004,A4),D0
02:000318AC 122C0005        	  4883:     move.b  ($0005,A4),D1
02:000318B0 B001            	  4884:     cmp.b   D1,D0
02:000318B2 640A            	  4885:     bcc  _anon_z01_101
02:000318B4 122C0008        	  4886:     move.b  ($0008,A4),D1
02:000318B8 E209            	  4887:     lsr.b  #1,D1   ; LSR $08
02:000318BA 19410008        	  4888:     move.b  D1,($0008,A4)
                            	  4889: _anon_z01_101:
                            	  4890:     ; If a monster is the defender, go handle it separately.
                            	  4891:     ;
02:000318BE 4A03            	  4892:     cmpi.b  #$00,D3
02:000318C0 6656            	  4893:     bne  _L_z01_BeginShove_MonsterDefender
                            	  4894:     ; Link is the defender.
                            	  4895:     ;
                            	  4896:     ; If Link is invincible, return without shoving.
                            	  4897:     ;
02:000318C2 102C04F0        	  4898:     move.b  ($04F0,A4),D0
02:000318C6 664E            	  4899:     bne  _L_z01_BeginShove_Exit
                            	  4900:     ; Store the shove direction we determined.
                            	  4901:     ;
                            	  4902:     ; Turn on the high bit to indicate that the next time we try to
                            	  4903:     ; move by shoving, it will be the first time for this shove action.
                            	  4904:     ;
02:000318C8 102C0008        	  4905:     move.b  ($0008,A4),D0
02:000318CC 00000080        	  4906:     ori.b #$80,D0
02:000318D0 194000C0        	  4907:     move.b  D0,($00C0,A4)
                            	  4908:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  4909:     ;
02:000318D4 7018            	  4910:     moveq   #24,D0
02:000318D6 194004F0        	  4911:     move.b  D0,($04F0,A4)
02:000318DA 7020            	  4912:     moveq   #32,D0
02:000318DC 194000D3        	  4913:     move.b  D0,($00D3,A4)
                            	  4914:     ; If Link was shoved by one of his own weapons, then
                            	  4915:     ; nothing else to do. Return.
                            	  4916:     ;
02:000318E0 0C02000D        	  4917:     cmpi.b  #$0D,D2
02:000318E4 6430            	  4918:     bcc  _L_z01_BeginShove_Exit
                            	  4919:     ; Link was shoved by a monster.
                            	  4920:     ;
                            	  4921:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  4922:     ; then return.
                            	  4923:     ;
02:000318E6 41EC04BF        	  4924:     lea     ($04BF,A4),A0
02:000318EA 10302000        	  4925:     move.b  (A0,D2.W),D0
02:000318EE 02000080        	  4926:     andi.b #$80,D0
02:000318F2 6622            	  4927:     bne  _L_z01_BeginShove_Exit
                            	  4928:     ; If the attacker is a vire, then return.
                            	  4929:     ;
02:000318F4 41EC034F        	  4930:     lea     ($034F,A4),A0
02:000318F8 10302000        	  4931:     move.b  (A0,D2.W),D0
02:000318FC 0C000012        	  4932:     cmpi.b  #$12,D0
02:00031900 6714            	  4933:     beq  _L_z01_BeginShove_Exit
                            	  4934:     ; Turn the attacker in the opposite direction.
                            	  4935:     ;
02:00031902 41EC0098        	  4936:     lea     ($0098,A4),A0
02:00031906 10302000        	  4937:     move.b  (A0,D2.W),D0
02:0003190A 6100EF12        	  4938:     jsr     GetOppositeDir
02:0003190E 41EC0098        	  4939:     lea     ($0098,A4),A0
02:00031912 11802000        	  4940:     move.b  D0,(A0,D2.W)
                            	  4941:     even
