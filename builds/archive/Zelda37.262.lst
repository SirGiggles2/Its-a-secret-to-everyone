                            	 11975: __far_z_04_0114:
                            	 11976:     ; State = 0.
                            	 11977:     ;
                            	 11978:     ; If the current object slot is 2, then go initialize the patra child.
                            	 11979:     ; This is the only patra child shown in the first fame.
                            	 11980:     ;
02:0003E2F8 0C020002        	 11981:     cmpi.b  #$02,D2
02:0003E2FC 6732            	 11982:     beq  _L_z04_UpdatePatraChild_Ready
                            	 11983:     ; The patra child in slot 2 is the last one to be updated.
                            	 11984:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 11985:     ;
                            	 11986:     ; This means that in the first frame, slot 2 is the only one to be
                            	 11987:     ; shown.
                            	 11988:     ;
02:0003E2FE 102C00AE        	 11989:     move.b  ($00AE,A4),D0
02:0003E302 6700008E        	 11990:     beq  _L_z04_UpdatePatraChild_Exit
                            	 11991:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 11992:     ; here to wait to be shown at the top position (N) one at a time.
                            	 11993:     ;
02:0003E306 1002            	 11994:     move.b  D2,D0
                            	 11995:     ; Subtract 3 from the object slot to get the angle where the
                            	 11996:     ; patra child in object slot 2 should be for the current one to appear.
                            	 11997:     ;
02:0003E308 003C0011        	 11998:     ori     #$11,CCR  ; SEC: set C+X
02:0003E30C 123C0003        	 11999:     move.b  #$03,D1
02:0003E310 0A3C0010        	 12000:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E314 9101            	 12001:     subx.b  D1,D0   ; SBC #$03
02:0003E316 0A3C0010        	 12002:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E31A 7600            	 12003:     moveq   #0,D3
02:0003E31C 1600            	 12004:     move.b  D0,D3
                            	 12005:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12006:     ; then return.
                            	 12007:     ;
02:0003E31E 102C0396        	 12008:     move.b  ($0396,A4),D0
02:0003E322 41F90003E2DC    	 12009:     lea     (PatraChildStartAngles).l,A0
02:0003E328 12303000        	 12010:     move.b  (A0,D3.W),D1
02:0003E32C B001            	 12011:     cmp.b   D1,D0
02:0003E32E 6662            	 12012:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12013:     even
