02:00040F04 003C0011        	  3503:     ori     #$11,CCR  ; SEC: set C+X
02:00040F08 12342070        	  3504:     move.b  ($70,A4,D2.W),D1
02:00040F0C 0A3C0010        	  3505:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040F10 9101            	  3506:     subx.b  D1,D0   ; SBC ObjX,X
02:00040F12 0A3C0010        	  3507:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3508:     even
                            	  3509: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3510:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3511:     ; If > $10, go put the ladder away.
                            	  3512:     ;
02:00040F16 4EB900030822    	  3513:     jsr     Abs
02:00040F1C 1880            	  3514:     move.b  D0,($0000,A4)
02:00040F1E 0C000010        	  3515:     cmpi.b  #$10,D0
02:00040F22 6532            	  3516:     bcs  _L_z05_CheckLadder_SetState2
02:00040F24 0C000010        	  3517:     cmpi.b  #$10,D0
02:00040F28 661E            	  3518:     bne  _L_z05_CheckLadder_StashLadder
                            	  3519:     ; Distance = $10. If player's not facing in the same direction as
                            	  3520:     ; the ladder, go put away the ladder.
                            	  3521:     ;
02:00040F2A 102C0098        	  3522:     move.b  ($0098,A4),D0
02:00040F2E 41EC0098        	  3523:     lea     ($0098,A4),A0
02:00040F32 12302000        	  3524:     move.b  (A0,D2.W),D1
02:00040F36 B001            	  3525:     cmp.b   D1,D0
02:00040F38 660E            	  3526:     bne  _L_z05_CheckLadder_StashLadder
                            	  3527:     ; Distance = $10, and player's facing in the same direction.
                            	  3528:     ;
                            	  3529:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3530:     ; ladder and had not stepped onto it yet.
                            	  3531:     ; Go handle movement on it, but don't change state yet.
                            	  3532:     ;
                            	  3533:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3534:     ; off of the ladder. So the ladder should be put away. In this
                            	  3535:     ; case, fall thru.
                            	  3536:     ;
02:00040F3A 41EC00AC        	  3537:     lea     ($00AC,A4),A0
02:00040F3E 10302000        	  3538:     move.b  (A0,D2.W),D0
02:00040F42 0C000001        	  3539:     cmpi.b  #$01,D0
02:00040F46 6718            	  3540:     beq  _L_z05_CheckLadder_HandleInput
                            	  3541:     even
                            	  3542: _L_z05_CheckLadder_StashLadder:
                            	  3543:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3544:     ;
02:00040F48 7000            	  3545:     moveq   #0,D0
02:00040F4A 19400064        	  3546:     move.b  D0,($0064,A4)
02:00040F4E 4EB90004C5F4    	  3547:     jsr     DestroyMonster
                            	  3548:     even
                            	  3549: _L_z05_CheckLadder_Exit:
02:00040F54 4E75            	  3550:     rts
                            	  3551: 
                            	  3552:     even
                            	  3553: _L_z05_CheckLadder_SetState2:
                            	  3554:     ;  Set state 2, because we're on the ladder.
                            	  3555:     ;
02:00040F56 7002            	  3556:     moveq   #2,D0
02:00040F58 41EC00AC        	  3557:     lea     ($00AC,A4),A0
02:00040F5C 11802000        	  3558:     move.b  D0,(A0,D2.W)
                            	  3559:     even
                            	  3560: _L_z05_CheckLadder_HandleInput:
                            	  3561:     ; If input direction = 0, go draw and reset moving direction.
                            	  3562:     ;
02:00040F60 102C03F8        	  3563:     move.b  ($03F8,A4),D0
02:00040F64 67000086        	  3564:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3565:     ; Input direction <> 0. The player intends to move.
                            	  3566:     ; So, see if we need to override the moving direction.
                            	  3567:     ;
                            	  3568:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3569:     ; go draw and set moving direction to Link's direction.
                            	  3570:     ;
                            	  3571:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3572:     ; been blocked by the water.
                            	  3573:     ;
                            	  3574:     ; Or, Link already passed over the point right over the ladder
                            	  3575:     ; and was allowed to move onto the tiles after the ladder.
                            	  3576:     ;
02:00040F68 102C0098        	  3577:     move.b  ($0098,A4),D0
02:00040F6C 7600            	  3578:     moveq   #0,D3
02:00040F6E 1614            	  3579:     move.b  ($0000,A4),D3
02:00040F70 670C            	  3580:     beq  _anon_z05_86
02:00040F72 41EC0098        	  3581:     lea     ($0098,A4),A0
02:00040F76 12302000        	  3582:     move.b  (A0,D2.W),D1
02:00040F7A B001            	  3583:     cmp.b   D1,D0
02:00040F7C 676E            	  3584:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3585: _anon_z05_86:
                            	  3586:     ; Distance = 0, or facing different directions.
                            	  3587:     ;
                            	  3588:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3589:     ; then go draw and keep moving.
                            	  3590:     ;
                            	  3591:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3592:     ;
                            	  3593:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3594:     ; to move onto the tiles after the ladder.
                            	  3595:     ;
                            	  3596:     ; Note that if Link is not moving, then this test will fail,
                            	  3597:     ; and case (D) will catch it.
                            	  3598:     ;
02:00040F7E 41EC0098        	  3599:     lea     ($0098,A4),A0
02:00040F82 10302000        	  3600:     move.b  (A0,D2.W),D0
02:00040F86 122C000F        	  3601:     move.b  ($000F,A4),D1
02:00040F8A B001            	  3602:     cmp.b   D1,D0
02:00040F8C 675E            	  3603:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3604:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3605:     ; then go draw and move in ladder's direction.
                            	  3606:     ;
                            	  3607:     ; You can always step off the ladder where you came from.
                            	  3608:     ;
02:00040F8E 4EB90003081E    	  3609:     jsr     GetOppositeDir
02:00040F94 122C0098        	  3610:     move.b  ($0098,A4),D1
02:00040F98 B001            	  3611:     cmp.b   D1,D0
02:00040F9A 6750            	  3612:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3613:     ; D. If opposite of ladder's direction <> down,
                            	  3614:     ; or input direction <> up,
                            	  3615:     ; then go reset moving direction, and draw.
                            	  3616:     ;
                            	  3617:     ; This will catch all cases of Link facing perpendicular to
                            	  3618:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3619:     ; ladder direction is up and input direction is up (E).
                            	  3620:     ;
02:00040F9C 0C000004        	  3621:     cmpi.b  #$04,D0
02:00040FA0 6648            	  3622:     bne  _anon_z05_87
02:00040FA2 102C03F8        	  3623:     move.b  ($03F8,A4),D0
02:00040FA6 0C000008        	  3624:     cmpi.b  #$08,D0
02:00040FAA 663E            	  3625:     bne  _anon_z05_87
                            	  3626:     ; E. The ladder's direction is up and input direction is up.
                            	  3627:     ;
                            	  3628:     ; An earlier call to check tile collision would have blocked
                            	  3629:     ; movement, because the tile under Link's top half is a water tile.
                            	  3630:     ; But because Link is squarely on the ladder, we really have
                            	  3631:     ; to check the tile above that one.
                            	  3632:     ;
                            	  3633:     ; Set moving direction to input direction (up) and switch X to
                            	  3634:     ; the player's slot for the purpose of checking tile collision below.
                            	  3635:     ; Based on that, we'll set moving direction according to walkability.
                            	  3636:     ;
02:00040FAC 6158            	  3637:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3638:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3639:     ;
02:00040FAE 102C0084        	  3640:     move.b  ($0084,A4),D0
02:00040FB2 1B00            	  3641:     move.b  D0,-(A5)  ; PHA
02:00040FB4 003C0011        	  3642:     ori     #$11,CCR  ; SEC: set C+X
02:00040FB8 123C0008        	  3643:     move.b  #$08,D1
02:00040FBC 0A3C0010        	  3644:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040FC0 9101            	  3645:     subx.b  D1,D0   ; SBC #$08
02:00040FC2 0A3C0010        	  3646:     eori    #$10,CCR  ; restore X = 6502 C
02:00040FC6 19400084        	  3647:     move.b  D0,($0084,A4)
02:00040FCA 4EB90004A74C    	  3648:     jsr     GetCollidingTileMoving
02:00040FD0 101D            	  3649:     move.b  (A5)+,D0  ; PLA
02:00040FD2 19400084        	  3650:     move.b  D0,($0084,A4)
                            	  3651:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3652:     ; direction as the input direction (in a roundabout way).
                            	  3653:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3654:     ;
02:00040FD6 102C000F        	  3655:     move.b  ($000F,A4),D0
02:00040FDA 7600            	  3656:     moveq   #0,D3
02:00040FDC 162C049E        	  3657:     move.b  ($049E,A4),D3
02:00040FE0 122C034A        	  3658:     move.b  ($034A,A4),D1
02:00040FE4 B601            	  3659:     cmp.b   D1,D3
02:00040FE6 6500FF78        	  3660:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3661: _anon_z05_87:
                            	  3662:     ; Set A to reset moving direction in [0F].
                            	  3663:     ;
02:00040FEA 7000            	  3664:     moveq   #0,D0
                            	  3665:     even
                            	  3666: _L_z05_CheckLadder_DrawLadder:
                            	  3667:     ; Draw the ladder.
                            	  3668:     ;
02:00040FEC 1B00            	  3669:     move.b  D0,-(A5)  ; PHA
02:00040FEE 7400            	  3670:     moveq   #0,D2
02:00040FF0 142C0064        	  3671:     move.b  ($0064,A4),D2
02:00040FF4 4EB90004BE18    	  3672:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00040FFA 760C            	  3673:     moveq   #12,D3
02:00040FFC 7000            	  3674:     moveq   #0,D0
02:00040FFE 4EB900030F2C    	  3675:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041004 101D            	  3676:     move.b  (A5)+,D0  ; PLA
                            	  3677: ; Params:
                            	  3678: ; A: direction
                            	  3679: ;
                            	  3680: ; Returns:
                            	  3681: ; [0F]: direction
                            	  3682: ;
                            	  3683:     even
                            	  3684: SetMovingDirAndSwitchToPlayerSlot:
02:00041006 4EF90002C046    	  3685:     jmp     c_set_moving_dir_switch_player
                            	  3686: 
                            	  3687: FindNextEdgeSpawnCell:
                            	  3688:     ; Load [0A] with the value before the call.
                            	  3689:     ;
02:0004100C 102C0525        	  3690:     move.b  ($0525,A4),D0
02:00041010 1940000A        	  3691:     move.b  D0,($000A,A4)
                            	  3692:     even
                            	  3693: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3694:     ; Loop to look for a place to spawn a monster from the edge
                            	  3695:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3696:     ;
                            	  3697:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3698:     ; We'll move down $10 pixels.
                            	  3699:     ;
02:00041014 7610            	  3700:     moveq   #16,D3
02:00041016 102C000A        	  3701:     move.b  ($000A,A4),D0
02:0004101A 0200000F        	  3702:     andi.b #$0F,D0
02:0004101E 670A            	  3703:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3704:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3705:     ; Don't move vertically.
                            	  3706:     ;
02:00041020 163C00F0        	  3707:     move.b  #$F0,D3
02:00041024 0C00000F        	  3708:     cmpi.b  #$0F,D0
02:00041028 6610            	  3709:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3710:     even
                            	  3711: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3712:     ; Else low nibble = $F. We're at the right edge,
                            	  3713:     ; and we'll move up $10 pixels.
                            	  3714:     ;
02:0004102A 1003            	  3715:     move.b  D3,D0
02:0004102C 023C00EE        	  3716:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041030 122C000A        	  3717:     move.b  ($000A,A4),D1
02:00041034 D101            	  3718:     addx.b  D1,D0   ; ADC $0A
02:00041036 1940000A        	  3719:     move.b  D0,($000A,A4)
                            	  3720:     even
                            	  3721: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3722:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3723:     ; Move right one pixel.
                            	  3724:     ;
02:0004103A 102C000A        	  3725:     move.b  ($000A,A4),D0
02:0004103E 020000F0        	  3726:     andi.b #$F0,D0
02:00041042 0C0000E0        	  3727:     cmpi.b  #$E0,D0
02:00041046 6606            	  3728:     bne  _anon_z05_88
02:00041048 522C000A        	  3729:     addq.b  #1,($000A,A4)
02:0004104C 600A            	  3730:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3731: 
                            	  3732: _anon_z05_88:
                            	  3733:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3734:     ; Dont' move horizontally.
                            	  3735:     ;
02:0004104E 0C000040        	  3736:     cmpi.b  #$40,D0
02:00041052 6604            	  3737:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3738:     ; Else high nibble = 4. We're at the top edge.
                            	  3739:     ; Move left 1 pixel.
                            	  3740:     ;
02:00041054 532C000A        	  3741:     subq.b  #1,($000A,A4)
                            	  3742:     even
                            	  3743: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3744:     ; Time to get the address of the column.
                            	  3745:     ; Starting at the top of the leftmost column.
                            	  3746:     ;
02:00041058 61002590        	  3747:     jsr     FetchTileMapAddr
02:0004105C 7005            	  3748:     moveq   #5,D0
02:0004105E 4EB90002A9FA    	  3749:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3750:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3751:     ; in order to point to the column we want.
                            	  3752:     ;
02:00041064 102C000A        	  3753:     move.b  ($000A,A4),D0
02:00041068 0200000F        	  3754:     andi.b #$0F,D0
02:0004106C 7600            	  3755:     moveq   #0,D3
02:0004106E 1600            	  3756:     move.b  D0,D3
02:00041070 670C            	  3757:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3758: _anon_z05_89:
02:00041072 702C            	  3759:     moveq   #44,D0
02:00041074 4EB9000309DC    	  3760:     jsr     AddToInt16At0
02:0004107A 5303            	  3761:     subq.b  #1,D3
02:0004107C 66F4            	  3762:     bne  _anon_z05_89
                            	  3763:     even
                            	  3764: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3765:     ; Turn the row part of [0A] into a tile index.
                            	  3766:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3767:     ;
02:0004107E 102C000A        	  3768:     move.b  ($000A,A4),D0
02:00041082 020000F0        	  3769:     andi.b #$F0,D0
02:00041086 003C0011        	  3770:     ori     #$11,CCR  ; SEC: set C+X
02:0004108A 123C0040        	  3771:     move.b  #$40,D1
02:0004108E 0A3C0010        	  3772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041092 9101            	  3773:     subx.b  D1,D0   ; SBC #$40
02:00041094 0A3C0010        	  3774:     eori    #$10,CCR  ; restore X = 6502 C
02:00041098 E208            	  3775:     lsr.b  #1,D0   ; LSR A
02:0004109A E208            	  3776:     lsr.b  #1,D0   ; LSR A
02:0004109C E208            	  3777:     lsr.b  #1,D0   ; LSR A
02:0004109E 7600            	  3778:     moveq   #0,D3
02:000410A0 1600            	  3779:     move.b  D0,D3
                            	  3780:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3781:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3782:     ; when coming in from the edges.
                            	  3783:     ;
02:000410A2 1214            	  3784:     move.b  ($00,A4),D1   ; ptr lo
02:000410A4 182C0001        	  3785:     move.b  ($01,A4),D4  ; ptr hi
02:000410A8 024100FF        	  3786:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000410AC E14C            	  3787:     lsl.w   #8,D4
02:000410AE 8841            	  3788:     or.w    D1,D4             ; D4 = NES ptr addr
02:000410B0 48C4            	  3789:     ext.l   D4
02:000410B2 D8BC00FF0000    	  3790:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000410B8 2044            	  3791:     movea.l D4,A0
02:000410BA 10303000        	  3792:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000410BE 0C000084        	  3793:     cmpi.b  #$84,D0
02:000410C2 650E            	  3794:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3795:     ; Bottom of the loop.
                            	  3796:     ; If you reach the original cell, then stop.
                            	  3797:     ;
02:000410C4 102C000A        	  3798:     move.b  ($000A,A4),D0
02:000410C8 122C0525        	  3799:     move.b  ($0525,A4),D1
02:000410CC B001            	  3800:     cmp.b   D1,D0
02:000410CE 6600FF44        	  3801:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3802:     even
                            	  3803: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3804:     ; Set the spawn cell to the one we found.
                            	  3805:     ;
02:000410D2 102C000A        	  3806:     move.b  ($000A,A4),D0
02:000410D6 19400525        	  3807:     move.b  D0,($0525,A4)
02:000410DA 4E75            	  3808:     rts
                            	  3809: 
                            	  3810:     even
