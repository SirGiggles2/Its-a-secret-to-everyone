                            	  5778:     ;
02:0003B4E8 10342028        	  5779:     move.b  ($28,A4,D2.W),D0
02:0003B4EC 0C000010        	  5780:     cmpi.b  #$10,D0
02:0003B4F0 6702            	  5781:     beq.s  __far_z_04_0045
02:0003B4F2 6058            	  5782:     jmp  L1156B_Exit
