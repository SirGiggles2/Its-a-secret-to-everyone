                            	   785: ;------------------------------------------------------------------------------
                            	   786: ; _c_move_object_shim — MoveObject trampoline.
                            	   787: ;
                            	   788: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   789: ;   Input:     D2 = slot (0..11)
                            	   790: ;   Preserves: D2, A4, A5
                            	   791: ;   Clobbers:  D0, D1, D3, A0
                            	   792: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   793: ;
                            	   794: ; GCC side:
                            	   795: ;   void c_move_object(unsigned short slot);
                            	   796: ;     slot arrives as a 16-bit value on the stack.
                            	   797: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   798: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   799: ;   never clobbered by gcc.
                            	   800: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   801: ;   semantics can exist in a pure C port).
                            	   802: ;------------------------------------------------------------------------------
                            	   803: _c_move_object_shim:
                            	   804:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   805:     move.b  #$AA,($0900,A4)
                            	   806:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   807:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   808:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   809:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   810:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   811:     moveq   #0,D0
02:0002B658 3002            	   812:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   813:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   814:     jsr     c_move_object
02:0002B662 588F            	   815:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   816:     rts
                            	   817: 
                            	   818: ;==============================================================================
                            	   819: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   820: ; and tail-call the native asm function.
                            	   821: ;
                            	   822: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   823: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   824: ; sign-extended).
                            	   825: ;==============================================================================
                            	   826: 
                            	   827: ;------------------------------------------------------------------------------
                            	   828: ; void c_copy_bank_to_window(unsigned int bank);
                            	   829: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   830: ;------------------------------------------------------------------------------
                            	   831: c_copy_bank_to_window:
02:0002B666 202F0004        	   832:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   833:     jmp     _copy_bank_to_window
                            	   834: 
                            	   835: ;------------------------------------------------------------------------------
                            	   836: ; unsigned char c_ppu_read_2(void);
                            	   837: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   838: ; C return: gcc expects result in D0.
                            	   839: ;------------------------------------------------------------------------------
                            	   840: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   841:     jmp     _ppu_read_2
                            	   842: 
                            	   843: ;------------------------------------------------------------------------------
                            	   844: ; void c_ppu_write_6(unsigned int val);
                            	   845: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   846: ;------------------------------------------------------------------------------
                            	   847: c_ppu_write_6:
02:0002B674 202F0004        	   848:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   849:     jmp     _ppu_write_6
                            	   850: 
                            	   851: ;------------------------------------------------------------------------------
                            	   852: ; void c_ppu_write_7(unsigned int val);
                            	   853: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   854: ;------------------------------------------------------------------------------
                            	   855: c_ppu_write_7:
02:0002B67E 202F0004        	   856:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   857:     jmp     _ppu_write_7
                            	   858: 
                            	   859: ;------------------------------------------------------------------------------
                            	   860: ; void c_turn_off_all_video(void);
                            	   861: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   862: ;------------------------------------------------------------------------------
                            	   863: c_turn_off_all_video:
02:0002B688 4EF900049A56    	   864:     jmp     TurnOffAllVideo
