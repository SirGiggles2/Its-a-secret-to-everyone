02:0003A444 7600            	  3442:     moveq   #0,D3
02:0003A446 41EC034F        	  3443:     lea     ($034F,A4),A0
02:0003A44A 16302000        	  3444:     move.b  (A0,D2.W),D3
02:0003A44E 0C030007        	  3445:     cmpi.b  #$07,D3
02:0003A452 6708            	  3446:     beq  _L_z04_UpdateOctorock_Shoot
02:0003A454 0C030009        	  3447:     cmpi.b  #$09,D3
02:0003A458 6702            	  3448:     beq  _L_z04_UpdateOctorock_Shoot
02:0003A45A E308            	  3449:     lsl.b  #1,D0   ; ASL A
                            	  3450:     even
                            	  3451: _L_z04_UpdateOctorock_Shoot:
                            	  3452:     ; Shoot a flying rock (object type $53).
                            	  3453:     ;
02:0003A45C 7653            	  3454:     moveq   #83,D3
