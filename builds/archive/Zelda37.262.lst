02:0003B076 00000020        	  5186:     ori.b #$20,D0
02:0003B07A 41EC0202        	  5187:     lea     ($0202,A4),A0
02:0003B07E 11803000        	  5188:     move.b  D0,(A0,D3.W)
                            	  5189: _anon_z04_73:
