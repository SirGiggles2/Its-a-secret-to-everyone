02:0003903E 16342028        	   627:     move.b  ($28,A4,D2.W),D3
02:00039042 66000082        	   628:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   629:     ; Store in [00] the type of projectile the monster will throw.
                            	   630:     ;
02:00039046 1880            	   631:     move.b  D0,($0000,A4)
                            	   632:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   633:     ;
02:00039048 102C066C        	   634:     move.b  ($066C,A4),D0
02:0003904C 1234203D        	   635:     move.b  ($3D,A4,D2.W),D1
02:00039050 8001            	   636:     or.b  D1,D0
02:00039052 6672            	   637:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   638:     ; Try to shoot. Return, if it failed.
                            	   639:     ;
02:00039054 1014            	   640:     move.b  ($0000,A4),D0
02:00039056 61005BE4        	   641:     jsr     _ShootIfWanted
02:0003905A 646A            	   642:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   643:     ; Set monster's state to $80 for delaying after shooting.
                            	   644:     ;
02:0003905C 103C0080        	   645:     move.b  #$80,D0
02:00039060 41EC00AC        	   646:     lea     ($00AC,A4),A0
02:00039064 11802000        	   647:     move.b  D0,(A0,D2.W)
                            	   648:     ; Reset the "wants to shoot" flag.
                            	   649:     ;
02:00039068 7000            	   650:     moveq   #0,D0
02:0003906A 41EC0412        	   651:     lea     ($0412,A4),A0
02:0003906E 11802000        	   652:     move.b  D0,(A0,D2.W)
                            	   653:     ; Have the shot keep track of the monster.
                            	   654:     ;
02:00039072 1002            	   655:     move.b  D2,D0
02:00039074 41EC042C        	   656:     lea     ($042C,A4),A0
02:00039078 11803000        	   657:     move.b  D0,(A0,D3.W)
                            	   658:     ; Have the monster keep track of the shot.
                            	   659:     ;
02:0003907C 1003            	   660:     move.b  D3,D0
02:0003907E 41EC042C        	   661:     lea     ($042C,A4),A0
02:00039082 11802000        	   662:     move.b  D0,(A0,D2.W)
                            	   663:     ; Set the shot's state to $10, which is the flying state for them.
                            	   664:     ;
02:00039086 7010            	   665:     moveq   #16,D0
02:00039088 41EC00AC        	   666:     lea     ($00AC,A4),A0
02:0003908C 11803000        	   667:     move.b  D0,(A0,D3.W)
                            	   668:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   669:     ;
02:00039090 103C00A0        	   670:     move.b  #$A0,D0
02:00039094 41EC03BC        	   671:     lea     ($03BC,A4),A0
02:00039098 11803000        	   672:     move.b  D0,(A0,D3.W)
                            	   673:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   674:     ;
02:0003909C 7051            	   675:     moveq   #81,D0
02:0003909E 41EC0380        	   676:     lea     ($0380,A4),A0
02:000390A2 11803000        	   677:     move.b  D0,(A0,D3.W)
                            	   678:     ; Make it autonomous (ready to update on its own).
                            	   679:     ;
02:000390A6 7000            	   680:     moveq   #0,D0
02:000390A8 41EC0405        	   681:     lea     ($0405,A4),A0
02:000390AC 11803000        	   682:     move.b  D0,(A0,D3.W)
                            	   683:     ; The first animation frame lasts 3 screen frames.
                            	   684:     ;
02:000390B0 7003            	   685:     moveq   #3,D0
02:000390B2 41EC03D0        	   686:     lea     ($03D0,A4),A0
02:000390B6 11803000        	   687:     move.b  D0,(A0,D3.W)
                            	   688:     ; Have the monster wait a random amount of time, up to $3F frames.
                            	   689:     ;
02:000390BA 10342018        	   690:     move.b  ($18,A4,D2.W),D0
02:000390BE 0200003F        	   691:     andi.b #$3F,D0
02:000390C2 19802028        	   692:     move.b  D0,($28,A4,D2.W)
