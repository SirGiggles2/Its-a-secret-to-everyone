                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:00042AF8 7003            	  6008:     moveq   #3,D0
02:00042AFA 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:00042AFE 122C0003        	  6010:     move.b  ($0003,A4),D1
02:00042B02 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042B06 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:00042B08 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6014:     ; Call this to put the address of door face tiles in [02:03].
                            	  6015:     ;
02:00042B0C 6100FD7A        	  6016:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6017:     ; Return the address of the door in the nametable in [01:00].
                            	  6018:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6019:     ;
02:00042B10 41F9000428E6    	  6020:     lea     (DoorVramAddrsHi).l,A0
02:00042B16 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00042B1A 1880            	  6022:     move.b  D0,($0000,A4)
02:00042B1C 41F9000428EA    	  6023:     lea     (DoorVramAddrsLo).l,A0
02:00042B22 10302000        	  6024:     move.b  (A0,D2.W),D0
02:00042B26 19400001        	  6025:     move.b  D0,($0001,A4)
                            	  6026:     ; Return the direction of the door in [09], and the dynamic
                            	  6027:     ; transfer buf length in X register.
                            	  6028:     ;
02:00042B2A 19420009        	  6029:     move.b  D2,($0009,A4)
02:00042B2E 7400            	  6030:     moveq   #0,D2
02:00042B30 142C0301        	  6031:     move.b  ($0301,A4),D2
                            	  6032:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6033:     ;
02:00042B34 7000            	  6034:     moveq   #0,D0
02:00042B36 19400007        	  6035:     move.b  D0,($0007,A4)
02:00042B3A 7002            	  6036:     moveq   #2,D0
02:00042B3C 19400006        	  6037:     move.b  D0,($0006,A4)
02:00042B40 19400005        	  6038:     move.b  D0,($0005,A4)
02:00042B44 0A3C0001        	  6039:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00042B48 4E75            	  6040:     rts
