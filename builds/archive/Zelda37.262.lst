                            	  5715: __far_z_05_0076:
                            	  5716:     ; Turn the door command into the desired open or closed state
                            	  5717:     ; to store in [08].
                            	  5718:     ;
                            	  5719:     ; cmd:  7 6 3 2 
                            	  5720:     ; [08]: 2 0 0 0
                            	  5721:     ;
                            	  5722:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5723:     ; commands intended to be used.
                            	  5724:     ;
                            	  5725:     ; 3 is the end state of 2: close
                            	  5726:     ; 7 is the end state of 6: open
                            	  5727:     ;
02:0004290E 02000007        	  5728:     andi.b #$07,D0
02:00042912 7601            	  5729:     moveq   #1,D3
02:00042914 19430002        	  5730:     move.b  D3,($0002,A4)
02:00042918 122C0002        	  5731:     move.b  ($0002,A4),D1
02:0004291C C200            	  5732:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004291E 6702            	  5733:     beq  _anon_z05_118
02:00042920 E208            	  5734:     lsr.b  #1,D0   ; LSR A
                            	  5735: _anon_z05_118:
02:00042922 0C000002        	  5736:     cmpi.b  #$02,D0
02:00042926 6606            	  5737:     bne  _anon_z05_119
                            	  5738:     ; Command 2 sets Link's timer to $30.
                            	  5739:     ;
02:00042928 7630            	  5740:     moveq   #48,D3
02:0004292A 19430028        	  5741:     move.b  D3,($0028,A4)
                            	  5742: _anon_z05_119:
02:0004292E 02000003        	  5743:     andi.b #$03,D0
02:00042932 003C0011        	  5744:     ori     #$11,CCR  ; SEC: set C+X
02:00042936 123C0001        	  5745:     move.b  #$01,D1
02:0004293A 0A3C0010        	  5746:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004293E 9101            	  5747:     subx.b  D1,D0   ; SBC #$01
02:00042940 0A3C0010        	  5748:     eori    #$10,CCR  ; restore X = 6502 C
02:00042944 02000002        	  5749:     andi.b #$02,D0
02:00042948 19400008        	  5750:     move.b  D0,($0008,A4)
                            	  5751:     ; The command to close a key door or bombable wall does not
                            	  5752:     ; do anything.
                            	  5753:     ;
02:0004294C 102C0054        	  5754:     move.b  ($0054,A4),D0
02:00042950 0C000005        	  5755:     cmpi.b  #$05,D0
02:00042954 6416            	  5756:     bcc  _anon_z05_120
02:00042956 102C0055        	  5757:     move.b  ($0055,A4),D0
02:0004295A 19400002        	  5758:     move.b  D0,($0002,A4)
02:0004295E 6100FAEC        	  5759:     jsr     FindDoorAttrByDoorBit
02:00042962 0C000007        	  5760:     cmpi.b  #$07,D0
02:00042966 6704            	  5761:     beq  _anon_z05_120
02:00042968 6000009C        	  5762:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  5763: 
                            	  5764: _anon_z05_120:
                            	  5765:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5766:     ;
                            	  5767:     ; Shutters and the commands to open a door always change
                            	  5768:     ; tiles.
                            	  5769:     ;
02:0004296C 61000130        	  5770:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5771:     even
                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:00042970 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00042974 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00042978 1014            	  5783:     move.b  ($0000,A4),D0
02:0004297A 41EC0302        	  5784:     lea     ($0302,A4),A0
02:0004297E 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:00042982 5202            	  5786:     addq.b  #1,D2
02:00042984 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00042988 41EC0302        	  5788:     lea     ($0302,A4),A0
02:0004298C 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:00042990 5202            	  5790:     addq.b  #1,D2
02:00042992 102C0006        	  5791:     move.b  ($0006,A4),D0
02:00042996 41EC0302        	  5792:     lea     ($0302,A4),A0
02:0004299A 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:0004299E 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:000429A0 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:000429A4 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:000429A6 7020            	  5803:     moveq   #32,D0
02:000429A8 122C0001        	  5804:     move.b  ($0001,A4),D1
02:000429AC 8001            	  5805:     or.b  D1,D0
02:000429AE 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:000429B2 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:000429B6 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:000429B8 103C00FF        	  5815:     move.b  #$FF,D0
02:000429BC 41EC0302        	  5816:     lea     ($0302,A4),A0
02:000429C0 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:000429C4 1002            	  5818:     move.b  D2,D0
02:000429C6 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:000429CA 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:000429CE 102C0054        	  5829:     move.b  ($0054,A4),D0
02:000429D2 02000003        	  5830:     andi.b #$03,D0
02:000429D6 6708            	  5831:     beq  _anon_z05_122
02:000429D8 7008            	  5832:     moveq   #8,D0
02:000429DA 19400027        	  5833:     move.b  D0,($0027,A4)
02:000429DE 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:000429E0 102C0054        	  5844:     move.b  ($0054,A4),D0
02:000429E4 0C000004        	  5845:     cmpi.b  #$04,D0
02:000429E8 6626            	  5846:     bne  _anon_z05_123
02:000429EA 7400            	  5847:     moveq   #0,D2
02:000429EC 142C0009        	  5848:     move.b  ($0009,A4),D2
02:000429F0 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:000429F4 102C0055        	  5850:     move.b  ($0055,A4),D0
02:000429F8 0A00000F        	  5851:     eori.b #$0F,D0
02:000429FC 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:00042A00 C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00042A02 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:00042A06 7000            	  5859:     moveq   #0,D0
02:00042A08 19400054        	  5860:     move.b  D0,($0054,A4)
02:00042A0C 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:00042A10 102C0055        	  5870:     move.b  ($0055,A4),D0
02:00042A14 19400002        	  5871:     move.b  D0,($0002,A4)
02:00042A18 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:00042A1C 0C000007        	  5873:     cmpi.b  #$07,D0
02:00042A20 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:00042A22 7400            	  5879:     moveq   #0,D2
02:00042A24 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00042A28 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00042A2C 1003            	  5884:     move.b  D3,D0
02:00042A2E 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042A32 41F9000428EE    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00042A38 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00042A3C D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00042A3E 7600            	  5889:     moveq   #0,D3
02:00042A40 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:00042A42 1002            	  5893:     move.b  D2,D0
02:00042A44 0A000001        	  5894:     eori.b #$01,D0
02:00042A48 7400            	  5895:     moveq   #0,D2
02:00042A4A 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00042A4C 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:00042A4E 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:00042A52 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042A56 E14C            	  5902:     lsl.w   #8,D4
02:00042A58 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042A5A 48C4            	  5904:     ext.l   D4
02:00042A5C D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042A62 2044            	  5906:     movea.l D4,A0
02:00042A64 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042A68 41F900049BAA    	  5908:     lea     (LevelMasks).l,A0
02:00042A6E 12302000        	  5909:     move.b  (A0,D2.W),D1
02:00042A72 8001            	  5910:     or.b  D1,D0
02:00042A74 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:00042A76 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00042A7A 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042A7E E14C            	  5914:     lsl.w   #8,D4
02:00042A80 8841            	  5915:     or.w    D1,D4
02:00042A82 48C4            	  5916:     ext.l   D4
02:00042A84 D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:00042A8A 2044            	  5918:     movea.l D4,A0
02:00042A8C 11803000        	  5919:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:00042A90 102C0055        	  5924:     move.b  ($0055,A4),D0
02:00042A94 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:00042A98 8001            	  5926:     or.b  D1,D0
02:00042A9A 6000FF66        	  5927:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:00042A9E 102C0055        	  5954:     move.b  ($0055,A4),D0
02:00042AA2 19400002        	  5955:     move.b  D0,($0002,A4)
02:00042AA6 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:00042AAA 0C000005        	  5957:     cmpi.b  #$05,D0
02:00042AAE 650C            	  5958:     bcs  _anon_z05_125
02:00042AB0 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:00042AB2 7004            	  5960:     moveq   #4,D0
02:00042AB4 4EB9000306E4    	  5961:     jsr     PlaySample
02:00042ABA 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:00042ABC 0C000004        	  5969:     cmpi.b  #$04,D0
02:00042AC0 6602            	  5970:     bne  _anon_z05_126
02:00042AC2 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:00042AC4 0C000001        	  5973:     cmpi.b  #$01,D0
02:00042AC8 6602            	  5974:     bne  _anon_z05_127
02:00042ACA 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:00042ACC 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:00042AD0 123C0003        	  5980:     move.b  #$03,D1
02:00042AD4 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042AD8 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:00042ADA 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:00042ADE 7600            	  5984:     moveq   #0,D3
02:00042AE0 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:00042AE2 102C0008        	  5992:     move.b  ($0008,A4),D0
02:00042AE6 6708            	  5993:     beq  _anon_z05_128
02:00042AE8 0C030005        	  5994:     cmpi.b  #$05,D3
02:00042AEC 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
