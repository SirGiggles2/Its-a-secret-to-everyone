02:0003B0D4 6718            	  5229:     beq  _L_z04_UpdateRope_CheckSpeed
02:0003B0D6 10342028        	  5230:     move.b  ($28,A4,D2.W),D0
02:0003B0DA 6612            	  5231:     bne  _L_z04_UpdateRope_CheckSpeed
02:0003B0DC 10342018        	  5232:     move.b  ($18,A4,D2.W),D0
