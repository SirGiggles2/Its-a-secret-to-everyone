                            	  2811:     ; Draw a tektite.
                            	  2812:     ;
                            	  2813:     ; If state = 1, then go draw frame image 1, and check collisions.
                            	  2814:     ;
02:00039F7A 41EC00AC        	  2815:     lea     ($00AC,A4),A0
02:00039F7E 10302000        	  2816:     move.b  (A0,D2.W),D0
02:00039F82 661C            	  2817:     bne  _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite
                            	  2818:     ; If object timer < $21, go draw frame image 0, and check collisions.
                            	  2819:     ;
02:00039F84 7600            	  2820:     moveq   #0,D3
02:00039F86 16342028        	  2821:     move.b  ($28,A4,D2.W),D3
02:00039F8A 0C030021        	  2822:     cmpi.b  #$21,D3
02:00039F8E 6510            	  2823:     bcs  _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite
                            	  2824:     ; Else cycle the animation counter, draw, and check collisions.
                            	  2825:     ;
                            	  2826:     ; The movement frame determines the frame image.
                            	  2827:     ;
02:00039F90 7010            	  2828:     moveq   #16,D0
02:00039F92 4EB90004BE12    	  2829:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:00039F98 41EC03E4        	  2830:     lea     ($03E4,A4),A0
02:00039F9C 10302000        	  2831:     move.b  (A0,D2.W),D0
                            	  2832:     even
