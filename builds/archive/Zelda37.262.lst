                            	  2138: __far_z_04_0017:
02:00039B0C 61000592        	  2139:     jsr     UpdateBurrower
                            	  2140:     ; If zora died in the call above, then it happened while in
                            	  2141:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2142:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2143:     ; not come back after killing it.
                            	  2144:     ;
                            	  2145:     ; If state <> 3 or timer <> $FD,
                            	  2146:     ; then go see if the object needs to be destroyed.
                            	  2147:     ;
02:00039B10 41EC00AC        	  2148:     lea     ($00AC,A4),A0
02:00039B14 10302000        	  2149:     move.b  (A0,D2.W),D0
02:00039B18 0C000003        	  2150:     cmpi.b  #$03,D0
02:00039B1C 6616            	  2151:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:00039B1E 10342028        	  2152:     move.b  ($28,A4,D2.W),D0
02:00039B22 0C0000FD        	  2153:     cmpi.b  #$FD,D0
02:00039B26 660C            	  2154:     bne  _L_z04_UpdateZora_DestroyWhenDone
                            	  2155:     ; Shoot a fireball; and set the timer so that it expires faster.
                            	  2156:     ;
