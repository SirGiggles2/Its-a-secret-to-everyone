                            	 12609: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003E756 19420340        	 12610:     move.b  D2,($0340,A4)
                            	 12611:     ; If object slot < 5 or = 7, then move every frame.
                            	 12612:     ; Else move 3 out of every 4 frames.
                            	 12613:     ;
                            	 12614:     ; This makes pieces spread out in somewhat of a circle,
                            	 12615:     ; by making the pieces at cardinal directions move at
                            	 12616:     ; full speed while the diagonal ones move a little slower.
                            	 12617:     ;
02:0003E75A 0C020005        	 12618:     cmpi.b  #$05,D2
