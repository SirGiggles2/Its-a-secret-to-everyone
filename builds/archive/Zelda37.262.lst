02:00049CF0 122C0004        	  2127:     move.b  ($0004,A4),D1
02:00049CF4 D101            	  2128:     addx.b  D1,D0   ; ADC $04
02:00049CF6 4A02            	  2129:     cmpi.b  #$00,D2
