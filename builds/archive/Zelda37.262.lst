02:0003E49C 0C0000C0        	 12207:     cmpi.b  #$C0,D0
02:0003E4A0 6606            	 12208:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003E4A2 7002            	 12209:     moveq   #2,D0
