                            	   254: 
                            	   255: InitCaveContinue:
                            	   256:     ; Get this cave's index (object type - $6A).
                            	   257:     ;
02:0002E892 102C0350        	   258:     move.b  ($0350,A4),D0
02:0002E896 003C0011        	   259:     ori     #$11,CCR  ; SEC: set C+X
02:0002E89A 123C006A        	   260:     move.b  #$6A,D1
02:0002E89E 0A3C0010        	   261:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E8A2 9101            	   262:     subx.b  D1,D0   ; SBC #$6A
02:0002E8A4 0A3C0010        	   263:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E8A8 7600            	   264:     moveq   #0,D3
02:0002E8AA 1600            	   265:     move.b  D0,D3
                            	   266:     ; Get the person text selector by looking up the text selector byte
                            	   267:     ; for this index, and masking it with $3F.
                            	   268:     ;
02:0002E8AC 41F90002E85C    	   269:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E8B2 10303000        	   270:     move.b  (A0,D3.W),D0
02:0002E8B6 1B00            	   271:     move.b  D0,-(A5)  ; PHA
02:0002E8B8 0200003F        	   272:     andi.b #$3F,D0
02:0002E8BC 19400415        	   273:     move.b  D0,($0415,A4)
                            	   274:     ; Pop and mask the text selector byte with $C0 to get the
                            	   275:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   276:     ;
02:0002E8C0 101D            	   277:     move.b  (A5)+,D0  ; PLA
02:0002E8C2 020000C0        	   278:     andi.b #$C0,D0
02:0002E8C6 19400003        	   279:     move.b  D0,($0003,A4)
                            	   280:     ; At this point, the Y register still has the cave index.
                            	   281:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   282:     ;
02:0002E8CA 103C00FD        	   283:     move.b  #$FD,D0
                            	   284: _anon_z01_0:
02:0002E8CE 023C00EE        	   285:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E8D2 123C0003        	   286:     move.b  #$03,D1
02:0002E8D6 D101            	   287:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E8D8 5303            	   288:     subq.b  #1,D3
02:0002E8DA 6AF2            	   289:     bpl  _anon_z01_0
02:0002E8DC 7600            	   290:     moveq   #0,D3
02:0002E8DE 1600            	   291:     move.b  D0,D3
                            	   292:     ; Loop over the wares from 0 to 2.
                            	   293:     ;
02:0002E8E0 7400            	   294:     moveq   #0,D2
                            	   295:     even
                            	   296: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   297:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   298:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   299:     ;
02:0002E8E2 41F900FF6A7E    	   300:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E8E8 10303000        	   301:     move.b  (A0,D3.W),D0
02:0002E8EC 41EC0422        	   302:     lea     ($0422,A4),A0
02:0002E8F0 11802000        	   303:     move.b  D0,(A0,D2.W)
                            	   304:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   305:     ;
02:0002E8F4 020000C0        	   306:     andi.b #$C0,D0
02:0002E8F8 19802000        	   307:     move.b  D0,($00,A4,D2.W)
                            	   308:     ; Copy 3 prices from the Cave level block info.
                            	   309:     ;
02:0002E8FC 41F900FF6ABA    	   310:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E902 10303000        	   311:     move.b  (A0,D3.W),D0
02:0002E906 41EC0430        	   312:     lea     ($0430,A4),A0
02:0002E90A 11802000        	   313:     move.b  D0,(A0,D2.W)
                            	   314:     ; Bottom of the wares copying loop.
                            	   315:     ;
02:0002E90E 5203            	   316:     addq.b  #1,D3
02:0002E910 5202            	   317:     addq.b  #1,D2
02:0002E912 0C020003        	   318:     cmpi.b  #$03,D2
02:0002E916 66CA            	   319:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   320:     ; Get the top 2 bits of text selector byte in [03],
                            	   321:     ; shift them to the bottom, and combine them with [00].
                            	   322:     ;
02:0002E918 102C0003        	   323:     move.b  ($0003,A4),D0
02:0002E91C E308            	   324:     lsl.b  #1,D0   ; ASL A
02:0002E91E E310            	   325:     roxl.b  #1,D0   ; ROL A
02:0002E920 E310            	   326:     roxl.b  #1,D0   ; ROL A
02:0002E922 1214            	   327:     move.b  ($0000,A4),D1
02:0002E924 8001            	   328:     or.b  D1,D0
02:0002E926 1880            	   329:     move.b  D0,($0000,A4)
                            	   330:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   331:     ; and combine them with [00].
                            	   332:     ;
02:0002E928 102C0002        	   333:     move.b  ($0002,A4),D0
02:0002E92C E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E92E E208            	   335:     lsr.b  #1,D0   ; LSR A
02:0002E930 E208            	   336:     lsr.b  #1,D0   ; LSR A
02:0002E932 E208            	   337:     lsr.b  #1,D0   ; LSR A
02:0002E934 1214            	   338:     move.b  ($0000,A4),D1
02:0002E936 8001            	   339:     or.b  D1,D0
02:0002E938 1880            	   340:     move.b  D0,($0000,A4)
                            	   341:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   342:     ; and combine them with [00] into CaveFlags.
                            	   343:     ;
02:0002E93A 102C0001        	   344:     move.b  ($0001,A4),D0
02:0002E93E E208            	   345:     lsr.b  #1,D0   ; LSR A
02:0002E940 E208            	   346:     lsr.b  #1,D0   ; LSR A
02:0002E942 1214            	   347:     move.b  ($0000,A4),D1
02:0002E944 8001            	   348:     or.b  D1,D0
02:0002E946 19400413        	   349:     move.b  D0,($0413,A4)
                            	   350:     ; The end result is a byte with 8 cave flags.
                            	   351:     ;
                            	   352:     ; If cave flag "money game" is missing, then go finish up,
                            	   353:     ; instead of choosing random amounts for the money game.
                            	   354:     ;
02:0002E94A 02000020        	   355:     andi.b #$20,D0
02:0002E94E 6700009E        	   356:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   357:     ; Determine an index randomly with increasing probability,
                            	   358:     ; from 6 to 1. Start with the following test:
                            	   359:     ;
                            	   360:     ;   If $FF < Random, then go use index 6.
                            	   361:     ;
02:0002E952 103C00FF        	   362:     move.b  #$FF,D0
02:0002E956 7606            	   363:     moveq   #6,D3
                            	   364:     even
                            	   365: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E958 122C0019        	   366:     move.b  ($0019,A4),D1
02:0002E95C B001            	   367:     cmp.b   D1,D0
02:0002E95E 6516            	   368:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   369:     ; If the test fails, then subtract $2B from the reference number.
                            	   370:     ;
02:0002E960 003C0011        	   371:     ori     #$11,CCR  ; SEC: set C+X
02:0002E964 123C002B        	   372:     move.b  #$2B,D1
02:0002E968 0A3C0010        	   373:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E96C 9101            	   374:     subx.b  D1,D0   ; SBC #$2B
02:0002E96E 0A3C0010        	   375:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E972 5303            	   376:     subq.b  #1,D3
02:0002E974 66E2            	   377:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   378:     even
                            	   379: _L_z01_InitCaveContinue_FoundPermutation:
                            	   380:     ; The index chooses the last offset of a permutation of three indexes.
                            	   381:     ;
02:0002E976 7400            	   382:     moveq   #0,D2
02:0002E978 41F90002E884    	   383:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E97E 14303000        	   384:     move.b  (A0,D3.W),D2
                            	   385:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   386:     ;
02:0002E982 7602            	   387:     moveq   #2,D3
                            	   388:     even
                            	   389: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E984 41F90002E872    	   390:     lea     (MoneyGamePermutations).l,A0
02:0002E98A 10302000        	   391:     move.b  (A0,D2.W),D0
02:0002E98E 41EC046C        	   392:     lea     ($046C,A4),A0
02:0002E992 11803000        	   393:     move.b  D0,(A0,D3.W)
02:0002E996 5302            	   394:     subq.b  #1,D2
02:0002E998 5303            	   395:     subq.b  #1,D3
02:0002E99A 6AE8            	   396:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   397:     ; With the first bit of another random number, choose 10 or 40
                            	   398:     ; to put in [046F]. This is a random amount to lose.
                            	   399:     ;
02:0002E99C 102C001A        	   400:     move.b  ($001A,A4),D0
02:0002E9A0 02000001        	   401:     andi.b #$01,D0
02:0002E9A4 7600            	   402:     moveq   #0,D3
02:0002E9A6 1600            	   403:     move.b  D0,D3
02:0002E9A8 41F90002E870    	   404:     lea     (MoneyGameLossAmounts).l,A0
02:0002E9AE 10303000        	   405:     move.b  (A0,D3.W),D0
02:0002E9B2 1940046F        	   406:     move.b  D0,($046F,A4)
                            	   407:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   408:     ;
02:0002E9B6 700A            	   409:     moveq   #10,D0
02:0002E9B8 19400470        	   410:     move.b  D0,($0470,A4)
                            	   411:     ; With a different bit of the second random number,
                            	   412:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   413:     ;
02:0002E9BC 7614            	   414:     moveq   #20,D3
02:0002E9BE 102C001A        	   415:     move.b  ($001A,A4),D0
02:0002E9C2 02000002        	   416:     andi.b #$02,D0
02:0002E9C6 6702            	   417:     beq  _anon_z01_1
02:0002E9C8 7632            	   418:     moveq   #50,D3
                            	   419: _anon_z01_1:
02:0002E9CA 19430471        	   420:     move.b  D3,($0471,A4)
                            	   421:     ; The 3 amounts are now in [046F] to [0471].
                            	   422:     ; Reference these amounts using the permutation of indexes
                            	   423:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   424:     ;
02:0002E9CE 7402            	   425:     moveq   #2,D2
                            	   426:     even
                            	   427: _L_z01_InitCaveContinue_ArrangeAmounts:
02:0002E9D0 7600            	   428:     moveq   #0,D3
02:0002E9D2 41EC046C        	   429:     lea     ($046C,A4),A0
02:0002E9D6 16302000        	   430:     move.b  (A0,D2.W),D3
02:0002E9DA 41EC046F        	   431:     lea     ($046F,A4),A0
02:0002E9DE 10303000        	   432:     move.b  (A0,D3.W),D0
02:0002E9E2 41EC0448        	   433:     lea     ($0448,A4),A0
02:0002E9E6 11802000        	   434:     move.b  D0,(A0,D2.W)
02:0002E9EA 5302            	   435:     subq.b  #1,D2
02:0002E9EC 6AE2            	   436:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   437:     even
                            	   438: _L_z01_InitCaveContinue_ResetTextbox:
                            	   439:     ; Reset the current character index.
                            	   440:     ;
02:0002E9EE 7000            	   441:     moveq   #0,D0
02:0002E9F0 19400416        	   442:     move.b  D0,($0416,A4)
                            	   443:     ; Point to the front of the first textbox line.
                            	   444:     ;
02:0002E9F4 10390002EA6E    	   445:     move.b  (TextboxLineAddrsLo+2).l,D0
02:0002E9FA 1940045F        	   446:     move.b  D0,($045F,A4)
02:0002E9FE 4E75            	   447:     rts
                            	   448: 
                            	   449: ; Params:
                            	   450: ; A: X coordinate
                            	   451: ; Y: Y coordinate
                            	   452: ;
                            	   453: ; Set the person's coordinates, HP, and attributes.
                            	   454: ;
                            	   455:     even
                            	   456: SetUpCommonCaveObjects:
