02:0003F658 102C00E2        	   730:     move.b  ($00E2,A4),D0
02:0003F65C 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F660 123C0020        	   732:     move.b  #$20,D1
