                            	  3270: _L_z04_UpdateRedLeever_Subtract:
                            	  3271:     ; The point is to get the absolute distance between the two.
                            	  3272:     ;
02:0003A2EE 102C0001        	  3273:     move.b  ($0001,A4),D0
02:0003A2F2 003C0011        	  3274:     ori     #$11,CCR  ; SEC: set C+X
02:0003A2F6 122C0002        	  3275:     move.b  ($0002,A4),D1
02:0003A2FA 0A3C0010        	  3276:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A2FE 9101            	  3277:     subx.b  D1,D0   ; SBC $02
02:0003A300 0A3C0010        	  3278:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3279:     ; If the absolute distance >= $30, then return.
                            	  3280:     ; It means that the leever's X coordinate wrapped around
                            	  3281:     ; the left or right edge of the screen.
                            	  3282:     ;
