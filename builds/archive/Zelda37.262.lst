                            	  1841: _L_z04_UpdateStatues_Shoot:
                            	  1842:     ; Look for an empty monster slot.
                            	  1843:     ; If none is found, return.
                            	  1844:     ;
                            	  1845:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1846:     ; object. This routine takes a shooter object, and instantiates
                            	  1847:     ; a fireball object at the shooter's location.
                            	  1848:     ;
                            	  1849:     ; The object slot we set up here will behave as the shooter.
                            	  1850:     ; For each fireball index, this object slot will have its coordinates
                            	  1851:     ; changed.
                            	  1852:     ;
                            	  1853:     ; Note that this means that:
                            	  1854:     ; 1. The first fireball made will be its own shooter.
                            	  1855:     ;    Practically, there's nothing special about this.
                            	  1856:     ; 2. If there is more than one fireball made in a frame,
                            	  1857:     ;    then two of them will come from the same statue.
                            	  1858:     ;
                            	  1859:     ;
                            	  1860:     ; Save the fireball pattern.
02:00039912 1003            	  1861:     move.b  D3,D0
02:00039914 1B00            	  1862:     move.b  D0,-(A5)  ; PHA
02:00039916 4EB90004C600    	  1863:     jsr     FindEmptyMonsterSlot
02:0003991C 0C000001        	  1864:     cmpi.b  #$01,D0
02:00039920 101D            	  1865:     move.b  (A5)+,D0  ; PLA
02:00039922 6400010A        	  1866:     bcc  _L_z04_UpdateStatues_Exit
                            	  1867:     ; If we found a slot, but it < 6, return.
                            	  1868:     ;
02:00039926 0C030006        	  1869:     cmpi.b  #$06,D3
02:0003992A 65000102        	  1870:     bcs  _L_z04_UpdateStatues_Exit
                            	  1871:     ; Store the object slot in [0A].
                            	  1872:     ; Store fireball pattern in [0B].
                            	  1873:     ;
02:0003992E 1943000A        	  1874:     move.b  D3,($000A,A4)
02:00039932 1940000B        	  1875:     move.b  D0,($000B,A4)
                            	  1876:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1877:     ;
02:00039936 7600            	  1878:     moveq   #0,D3
02:00039938 1600            	  1879:     move.b  D0,D3
02:0003993A 7400            	  1880:     moveq   #0,D2
02:0003993C 41F9000398CE    	  1881:     lea     (StatueFireballCounts).l,A0
02:00039942 14303000        	  1882:     move.b  (A0,D3.W),D2
                            	  1883:     even
                            	  1884: _L_z04_UpdateStatues_LoopFireball:
                            	  1885:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1886:     ;
                            	  1887:     ; Decrement the fireball timer at this index.
                            	  1888:     ;
02:00039946 7600            	  1889:     moveq   #0,D3
02:00039948 41EC04E8        	  1890:     lea     ($04E8,A4),A0
02:0003994C 16302000        	  1891:     move.b  (A0,D2.W),D3
02:00039950 5303            	  1892:     subq.b  #1,D3
02:00039952 1003            	  1893:     move.b  D3,D0
02:00039954 41EC04E8        	  1894:     lea     ($04E8,A4),A0
02:00039958 11802000        	  1895:     move.b  D0,(A0,D2.W)
                            	  1896:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1897:     ; to make a fireball. Go loop again.
                            	  1898:     ;
02:0003995C 5203            	  1899:     addq.b  #1,D3
02:0003995E 660000C8        	  1900:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1901:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1902:     ; This fireball index will wait another $100 frames.
                            	  1903:     ;
02:00039962 10342018        	  1904:     move.b  ($18,A4,D2.W),D0
02:00039966 0C0000F0        	  1905:     cmpi.b  #$F0,D0
02:0003996A 640000BC        	  1906:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1907:     ; Else choose one of four start times for the fireball based on
                            	  1908:     ; the random value.
                            	  1909:     ;
02:0003996E 02000003        	  1910:     andi.b #$03,D0
02:00039972 7600            	  1911:     moveq   #0,D3
02:00039974 1600            	  1912:     move.b  D0,D3
02:00039976 41F9000398D2    	  1913:     lea     (StatueFireballStartTimes).l,A0
02:0003997C 10303000        	  1914:     move.b  (A0,D3.W),D0
02:00039980 41EC04E8        	  1915:     lea     ($04E8,A4),A0
02:00039984 11802000        	  1916:     move.b  D0,(A0,D2.W)
                            	  1917:     ; The coordinate lists are divided into sets for each pattern.
                            	  1918:     ;
                            	  1919:     ; Look up the index of the base of the set for the pattern in use.
                            	  1920:     ; Add it to the fireball index in X register to get the index of
                            	  1921:     ; the coordinate we want within each coordinate list.
                            	  1922:     ;
                            	  1923:     ;
                            	  1924:     ; Pattern
02:00039988 7600            	  1925:     moveq   #0,D3
02:0003998A 162C000B        	  1926:     move.b  ($000B,A4),D3
02:0003998E 1002            	  1927:     move.b  D2,D0
02:00039990 023C00EE        	  1928:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039994 41F9000398D6    	  1929:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003999A 12303000        	  1930:     move.b  (A0,D3.W),D1
02:0003999E D101            	  1931:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:000399A0 7600            	  1932:     moveq   #0,D3
02:000399A2 1600            	  1933:     move.b  D0,D3
02:000399A4 1002            	  1934:     move.b  D2,D0
02:000399A6 1B00            	  1935:     move.b  D0,-(A5)  ; PHA
                            	  1936:     ; Get Link's coordinates into [00] and [01].
                            	  1937:     ;
02:000399A8 7400            	  1938:     moveq   #0,D2
02:000399AA 4EB90004BE18    	  1939:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1940:     ; Switch to the new fireball's object slot.
                            	  1941:     ;
02:000399B0 7400            	  1942:     moveq   #0,D2
02:000399B2 142C000A        	  1943:     move.b  ($000A,A4),D2
                            	  1944:     ; Look up and set the X coordinate for the fireball object.
                            	  1945:     ; Also store it in [02].
                            	  1946:     ;
02:000399B6 41F9000398DA    	  1947:     lea     (StatueXs).l,A0
02:000399BC 10303000        	  1948:     move.b  (A0,D3.W),D0
02:000399C0 19400002        	  1949:     move.b  D0,($0002,A4)
02:000399C4 19802070        	  1950:     move.b  D0,($70,A4,D2.W)
                            	  1951:     ; Look up and set the Y coordinate for the fireball object.
                            	  1952:     ; Also store it in [03].
                            	  1953:     ;
02:000399C8 41F9000398E2    	  1954:     lea     (StatueYs).l,A0
02:000399CE 10303000        	  1955:     move.b  (A0,D3.W),D0
02:000399D2 19400003        	  1956:     move.b  D0,($0003,A4)
02:000399D6 41EC0084        	  1957:     lea     ($0084,A4),A0
02:000399DA 11802000        	  1958:     move.b  D0,(A0,D2.W)
                            	  1959:     ; Set mask value 3 in [04].
