                            	  9597:     ; Now we can go straight without changing direction for some time.
                            	  9598:     ;
02:0003D122 41EC0451        	  9599:     lea     ($0451,A4),A0
02:0003D126 52302000        	  9600:     addq.b  #1,(A0,D2.W)
                            	  9601:     ; Go animate the eye.
                            	  9602:     ;
02:0003D12A 600000C6        	  9603:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9604: 
