02:000303D2 660000B2        	  1852:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  1853:     ; State 0. Sensing.
                            	  1854:     ;
                            	  1855:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  1856:     ; then go see if the horizontal distance is shorter.
                            	  1857:     ;
02:000303D6 102C0084        	  1858:     move.b  ($0084,A4),D0
02:000303DA 003C0011        	  1859:     ori     #$11,CCR  ; SEC: set C+X
02:000303DE 41EC0084        	  1860:     lea     ($0084,A4),A0
02:000303E2 12302000        	  1861:     move.b  (A0,D2.W),D1
02:000303E6 0A3C0010        	  1862:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000303EA 9101            	  1863:     subx.b  D1,D0   ; SBC ObjY,X
02:000303EC 0A3C0010        	  1864:     eori    #$10,CCR  ; restore X = 6502 C
02:000303F0 61000430        	  1865:     jsr     Abs
02:000303F4 0C00000E        	  1866:     cmpi.b  #$0E,D0
02:000303F8 644C            	  1867:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1868:     ; Determine the horizontal direction toward Link;
                            	  1869:     ; and if Link and the trap are at the same X, then we can't move
                            	  1870:     ; along this axis. Go see about moving vertically.
                            	  1871:     ;
02:000303FA 7601            	  1872:     moveq   #1,D3
02:000303FC 102C0070        	  1873:     move.b  ($0070,A4),D0
02:00030400 12342070        	  1874:     move.b  ($70,A4,D2.W),D1
02:00030404 B001            	  1875:     cmp.b   D1,D0
02:00030406 673E            	  1876:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030408 6402            	  1877:     bcc  _anon_z01_26
02:0003040A 7602            	  1878:     moveq   #2,D3
                            	  1879: _anon_z01_26:
                            	  1880:     ; Remember the original X coordinate.
                            	  1881:     ;
02:0003040C 10342070        	  1882:     move.b  ($70,A4,D2.W),D0
                            	  1883:     even
                            	  1884: _L_z01_UpdateTrap_Full_GoToState1:
02:00030410 41EC0380        	  1885:     lea     ($0380,A4),A0
02:00030414 11802000        	  1886:     move.b  D0,(A0,D2.W)
                            	  1887:     ; Set facing direction to the horizontal one that we determined.
                            	  1888:     ;
02:00030418 1003            	  1889:     move.b  D3,D0
02:0003041A 41EC0098        	  1890:     lea     ($0098,A4),A0
02:0003041E 11802000        	  1891:     move.b  D0,(A0,D2.W)
                            	  1892:     ; If the direction we determined is not allowed for this trap, then
                            	  1893:     ; go draw and check collisions.
                            	  1894:     ;
02:00030422 41F9000303C3    	  1895:     lea     (TrapAllowedDirs-1).l,A0
02:00030428 12302000        	  1896:     move.b  (A0,D2.W),D1
02:0003042C C001            	  1897:     and.b  D1,D0
02:0003042E 6712            	  1898:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1899:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  1900:     ;
02:00030430 41EC00AC        	  1901:     lea     ($00AC,A4),A0
02:00030434 52302000        	  1902:     addq.b  #1,(A0,D2.W)
02:00030438 7070            	  1903:     moveq   #112,D0
02:0003043A 41EC03BC        	  1904:     lea     ($03BC,A4),A0
02:0003043E 11802000        	  1905:     move.b  D0,(A0,D2.W)
                            	  1906:     even
                            	  1907: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
