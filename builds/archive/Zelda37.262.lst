02:0004B7FA 1940000F        	  6011:     move.b  D0,($000F,A4)
                            	  6012:     ; If state = 5, return without drawing.
                            	  6013:     ;
02:0004B7FE 41EC00AC        	  6014:     lea     ($00AC,A4),A0
02:0004B802 10302000        	  6015:     move.b  (A0,D2.W),D0
02:0004B806 0200000F        	  6016:     andi.b #$0F,D0
02:0004B80A 7600            	  6017:     moveq   #0,D3
02:0004B80C 1600            	  6018:     move.b  D0,D3
02:0004B80E 103C00FC        	  6019:     move.b  #$FC,D0
