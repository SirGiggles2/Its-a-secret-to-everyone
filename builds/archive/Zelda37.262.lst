02:0003EA70 6738            	 13029:     beq  _L_z04_SetUpDroppedItem_Found
02:0003EA72 5303            	 13030:     subq.b  #1,D3
02:0003EA74 6AEE            	 13031:     bpl  _L_z04_SetUpDroppedItem_FindDrop0Type
                            	 13032:     ; Increment row number in [01] to 1.
                            	 13033:     ;
02:0003EA76 522C0001        	 13034:     addq.b  #1,($0001,A4)
