                            	  1197: WhirlwindPrevRoomIdList:
02:0002FF5E 36              	  1198:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FF5F 3B
02:0002FF60 73
02:0002FF61 44
02:0002FF62 0A
02:0002FF63 21
02:0002FF64 41
02:0002FF65 6C
                            	  1199: 
                            	  1200:     even
                            	  1201: UpdateWhirlwind_Full:
                            	  1202:     ; Get Link's halted state.
                            	  1203:     ;
02:0002FF66 102C00AC        	  1204:     move.b  ($00AC,A4),D0
02:0002FF6A 02000040        	  1205:     andi.b #$40,D0
02:0002FF6E 7600            	  1206:     moveq   #0,D3
02:0002FF70 1600            	  1207:     move.b  D0,D3
                            	  1208:     ; Add 2 to whirlwind X.
                            	  1209:     ;
02:0002FF72 7002            	  1210:     moveq   #2,D0
02:0002FF74 023C00EE        	  1211:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FF78 12342070        	  1212:     move.b  ($70,A4,D2.W),D1
02:0002FF7C D101            	  1213:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FF7E 19802070        	  1214:     move.b  D0,($70,A4,D2.W)
                            	  1215:     ; If Link is not halted or teleporting state = 0, then
                            	  1216:     ; go check for collision with Link.
                            	  1217:     ;
02:0002FF82 0C030040        	  1218:     cmpi.b  #$40,D3
02:0002FF86 6638            	  1219:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FF88 7600            	  1220:     moveq   #0,D3
02:0002FF8A 162C0522        	  1221:     move.b  ($0522,A4),D3
02:0002FF8E 6730            	  1222:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1223:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1224:     ;
                            	  1225:     ; Set Link's X to whirlwind's.
                            	  1226:     ;
02:0002FF90 19400070        	  1227:     move.b  D0,($0070,A4)
                            	  1228:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1229:     ; the right screen edge and draw.
                            	  1230:     ;
02:0002FF94 5303            	  1231:     subq.b  #1,D3
02:0002FF96 6776            	  1232:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FF98 0C000080        	  1233:     cmpi.b  #$80,D0
02:0002FF9C 6670            	  1234:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1235:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1236:     ;
                            	  1237:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1238:     ;
02:0002FF9E E308            	  1239:     lsl.b  #1,D0   ; ASL A
02:0002FFA0 194000AC        	  1240:     move.b  D0,($00AC,A4)
02:0002FFA4 19400522        	  1241:     move.b  D0,($0522,A4)
02:0002FFA8 41EC034F        	  1242:     lea     ($034F,A4),A0
02:0002FFAC 11802000        	  1243:     move.b  D0,(A0,D2.W)
                            	  1244:     ; Update the player position marker, and draw one last time.
                            	  1245:     ;
02:0002FFB0 1002            	  1246:     move.b  D2,D0
02:0002FFB2 1B00            	  1247:     move.b  D0,-(A5)  ; PHA
02:0002FFB4 61000910        	  1248:     jsr     UpdatePlayerPositionMarker
02:0002FFB8 101D            	  1249:     move.b  (A5)+,D0  ; PLA
02:0002FFBA 7400            	  1250:     moveq   #0,D2
02:0002FFBC 1400            	  1251:     move.b  D0,D2
02:0002FFBE 6070            	  1252:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1253: 
                            	  1254:     even
                            	  1255: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1256:     ; Link is not halted or teleporting state = 0.
                            	  1257:     ; Try to pick up Link.
                            	  1258:     ;
                            	  1259:     ; If the whirlwind does not collide with Link, then go check
                            	  1260:     ; for the screen's right edge.
                            	  1261:     ;
02:0002FFC0 610011E4        	  1262:     jsr     CheckLinkCollision
02:0002FFC4 102C0006        	  1263:     move.b  ($0006,A4),D0
02:0002FFC8 6744            	  1264:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1265:     ; Collided with Link.
                            	  1266:     ;
                            	  1267:     ; Make Link face right. Reset shove info and subroom type.
                            	  1268:     ;
02:0002FFCA 7001            	  1269:     moveq   #1,D0
02:0002FFCC 19400098        	  1270:     move.b  D0,($0098,A4)
02:0002FFD0 E208            	  1271:     lsr.b  #1,D0   ; LSR A
02:0002FFD2 194000C0        	  1272:     move.b  D0,($00C0,A4)
02:0002FFD6 194000D3        	  1273:     move.b  D0,($00D3,A4)
02:0002FFDA 1940005A        	  1274:     move.b  D0,($005A,A4)
                            	  1275:     ; Halt Link (state $40), and hide him.
                            	  1276:     ;
02:0002FFDE 7040            	  1277:     moveq   #64,D0
02:0002FFE0 194000AC        	  1278:     move.b  D0,($00AC,A4)
02:0002FFE4 103C00F8        	  1279:     move.b  #$F8,D0
02:0002FFE8 19400248        	  1280:     move.b  D0,($0248,A4)
02:0002FFEC 1940024C        	  1281:     move.b  D0,($024C,A4)
                            	  1282:     ; Find and set the room that will behave as the previous room
                            	  1283:     ; when scrolling right to the room with the level's entrance.
                            	  1284:     ;
02:0002FFF0 102C0523        	  1285:     move.b  ($0523,A4),D0
02:0002FFF4 02000007        	  1286:     andi.b #$07,D0
02:0002FFF8 7600            	  1287:     moveq   #0,D3
02:0002FFFA 1600            	  1288:     move.b  D0,D3
02:0002FFFC 41F90002FF5E    	  1289:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030002 10303000        	  1290:     move.b  (A0,D3.W),D0
02:00030006 194000EA        	  1291:     move.b  D0,($00EA,A4)
                            	  1292:     ; Set teleporting state 1.
                            	  1293:     ;
02:0003000A 522C0522        	  1294:     addq.b  #1,($0522,A4)
                            	  1295:     even
                            	  1296: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1297:     ; If whirlwind's X < $F0, go draw.
                            	  1298:     ;
02:0003000E 10342070        	  1299:     move.b  ($70,A4,D2.W),D0
02:00030012 0C0000F0        	  1300:     cmpi.b  #$F0,D0
02:00030016 6518            	  1301:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1302:     ; The whirlwind has reached the right edge of the screen.
                            	  1303:     ;
                            	  1304:     ; Destroy the object.
                            	  1305:     ;
02:00030018 611A            	  1306:     jsr     DestroyWhirlwind
                            	  1307:     ; If teleporting state <> 0, we picked up Link.
                            	  1308:     ; So, go to the next mode.
                            	  1309:     ;
                            	  1310:     ; Either way, draw one last time.
                            	  1311:     ;
02:0003001A 102C0522        	  1312:     move.b  ($0522,A4),D0
02:0003001E 6710            	  1313:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:00030020 1002            	  1314:     move.b  D2,D0
02:00030022 1B00            	  1315:     move.b  D0,-(A5)  ; PHA
02:00030024 4EB90004AC92    	  1316:     jsr     GoToNextModeFromPlay
02:0003002A 101D            	  1317:     move.b  (A5)+,D0  ; PLA
02:0003002C 7400            	  1318:     moveq   #0,D2
02:0003002E 1400            	  1319:     move.b  D0,D2
                            	  1320:     even
                            	  1321: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030030 60000094        	  1322:     jmp     DrawWhirlwind
                            	  1323: 
                            	  1324:     even
                            	  1325: DestroyWhirlwind:
02:00030034 6000B7DE        	  1326:     jmp     c_destroy_whirlwind
                            	  1327: 
                            	  1328: SummonWhirlwind:
                            	  1329:     ; If not in mode 5, return.
                            	  1330:     ;
02:00030038 102C0012        	  1331:     move.b  ($0012,A4),D0
02:0003003C 0C000005        	  1332:     cmpi.b  #$05,D0
02:00030040 6704            	  1333:     beq.s  __far_z_01_0000
02:00030042 60000080        	  1334:     jmp  L6104_Exit
                            	  1335: __far_z_01_0000:
                            	  1336:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  1337:     ;
02:00030046 6178            	  1338:     jsr     AdvanceTeleportingLevelIndex
02:00030048 102C0523        	  1339:     move.b  ($0523,A4),D0
02:0003004C 02000007        	  1340:     andi.b #$07,D0
02:00030050 7600            	  1341:     moveq   #0,D3
02:00030052 1600            	  1342:     move.b  D0,D3
02:00030054 41F900049BAA    	  1343:     lea     (LevelMasks).l,A0
02:0003005A 10303000        	  1344:     move.b  (A0,D3.W),D0
02:0003005E 1880            	  1345:     move.b  D0,($0000,A4)
                            	  1346:     even
                            	  1347: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  1348:     ; If there are no triforce pieces, then return.
                            	  1349:     ;
02:00030060 102C0671        	  1350:     move.b  ($0671,A4),D0
