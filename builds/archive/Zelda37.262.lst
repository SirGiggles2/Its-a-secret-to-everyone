                            	  2195: ;
                            	  2196: ; [01] holds the q-speed of the monster
                            	  2197:     even
                            	  2198: _TryShooting:
02:00039B66 19400001        	  2199:     move.b  D0,($0001,A4)
                            	  2200:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2201:     ;
02:00039B6A 41EC034F        	  2202:     lea     ($034F,A4),A0
02:00039B6E 10302000        	  2203:     move.b  (A0,D2.W),D0
02:00039B72 0C000003        	  2204:     cmpi.b  #$03,D0
02:00039B76 6726            	  2205:     beq  _L_z04__TryShooting_TryShootingNow
02:00039B78 0C000001        	  2206:     cmpi.b  #$01,D0
02:00039B7C 6720            	  2207:     beq  _L_z04__TryShooting_TryShootingNow
02:00039B7E 0C000009        	  2208:     cmpi.b  #$09,D0
02:00039B82 671A            	  2209:     beq  _L_z04__TryShooting_TryShootingNow
02:00039B84 0C00000A        	  2210:     cmpi.b  #$0A,D0
02:00039B88 6714            	  2211:     beq  _L_z04__TryShooting_TryShootingNow
02:00039B8A 41EC0451        	  2212:     lea     ($0451,A4),A0
02:00039B8E 10302000        	  2213:     move.b  (A0,D2.W),D0
02:00039B92 660A            	  2214:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2215:     ; and a random value < $F8, then return.
                            	  2216:     ;
02:00039B94 10342018        	  2217:     move.b  ($18,A4,D2.W),D0
02:00039B98 0C0000F8        	  2218:     cmpi.b  #$F8,D0
02:00039B9C 656C            	  2219:     bcs  _L_z04__TryShooting_Exit
                            	  2220:     even
                            	  2221: _L_z04__TryShooting_TryShootingNow:
                            	  2222:     ; Summary
                            	  2223:     ;
                            	  2224:     ; if temporarily invincible then
                            	  2225:     ;   shoot timer := 0
                            	  2226:     ; elif shoot timer > 0 then
                            	  2227:     ;   decrement shoot timer
                            	  2228:     ; elif wants to shoot then
                            	  2229:     ;   shoot timer := $30
                            	  2230:     ;
                            	  2231:     ; qspeed := [01]
                            	  2232:     ;
                            	  2233:     ; if shoot timer <> 0 then
                            	  2234:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2235:     ;     shoot
                            	  2236:     ;     if succeeded then
                            	  2237:     ;       shoot timer := 0
                            	  2238:     ;       qspeed := 0
                            	  2239:     ;   else
                            	  2240:     ;     qspeed := 0
                            	  2241:     ;
                            	  2242:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00039B9E 102C0001        	  2243:     move.b  ($0001,A4),D0
02:00039BA2 1883            	  2244:     move.b  D3,($0000,A4)
02:00039BA4 1B00            	  2245:     move.b  D0,-(A5)  ; PHA
02:00039BA6 7600            	  2246:     moveq   #0,D3
                            	  2247:     ; If not temporarily invincible,
                            	  2248:     ;
02:00039BA8 41EC04F0        	  2249:     lea     ($04F0,A4),A0
02:00039BAC 10302000        	  2250:     move.b  (A0,D2.W),D0
02:00039BB0 661A            	  2251:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2252:     ; then Y := shoot timer - 1
                            	  2253:     ;
02:00039BB2 7600            	  2254:     moveq   #0,D3
02:00039BB4 41EC0451        	  2255:     lea     ($0451,A4),A0
02:00039BB8 16302000        	  2256:     move.b  (A0,D2.W),D3
02:00039BBC 5303            	  2257:     subq.b  #1,D3
                            	  2258:     ; If Y register < 0, then shoot timer is 0.
                            	  2259:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2260:     ; Else go set a non-zero speed and return.
                            	  2261:     ;
02:00039BBE 6A0C            	  2262:     bpl  _L_z04__TryShooting_SetShootTimer
02:00039BC0 41EC0412        	  2263:     lea     ($0412,A4),A0
02:00039BC4 10302000        	  2264:     move.b  (A0,D2.W),D0
02:00039BC8 6736            	  2265:     beq  _L_z04__TryShooting_SetSpeed
02:00039BCA 7630            	  2266:     moveq   #48,D3
                            	  2267:     even
                            	  2268: _L_z04__TryShooting_SetShootTimer:
                            	  2269:     ; shoot timer := Y
                            	  2270:     ;
02:00039BCC 1003            	  2271:     move.b  D3,D0
02:00039BCE 41EC0451        	  2272:     lea     ($0451,A4),A0
02:00039BD2 11802000        	  2273:     move.b  D0,(A0,D2.W)
                            	  2274:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2275:     ;
02:00039BD6 6728            	  2276:     beq  _L_z04__TryShooting_SetSpeed
                            	  2277:     ; shoot timer <> 0
                            	  2278:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2279:     ;
02:00039BD8 0C030010        	  2280:     cmpi.b  #$10,D3
02:00039BDC 661C            	  2281:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2282:     ; If we have the magic clock, or the monster is stunned, then
                            	  2283:     ; go set a zero speed.
                            	  2284:     ;
02:00039BDE 102C066C        	  2285:     move.b  ($066C,A4),D0
02:00039BE2 1234203D        	  2286:     move.b  ($3D,A4,D2.W),D1
02:00039BE6 8001            	  2287:     or.b  D1,D0
02:00039BE8 6610            	  2288:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2289:     ; Shoot.
                            	  2290:     ;
02:00039BEA 1014            	  2291:     move.b  ($0000,A4),D0
02:00039BEC 611E            	  2292:     jsr     _ShootIfWanted2
                            	  2293:     ; If it failed, go set a non-zero speed.
                            	  2294:     ;
02:00039BEE 6510            	  2295:     bcs  _L_z04__TryShooting_SetSpeed
                            	  2296:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  2297:     ;
02:00039BF0 7000            	  2298:     moveq   #0,D0
02:00039BF2 41EC0412        	  2299:     lea     ($0412,A4),A0
02:00039BF6 11802000        	  2300:     move.b  D0,(A0,D2.W)
                            	  2301:     even
                            	  2302: _L_z04__TryShooting_ZeroSpeed:
02:00039BFA 101D            	  2303:     move.b  (A5)+,D0  ; PLA
02:00039BFC 7000            	  2304:     moveq   #0,D0
02:00039BFE 1B00            	  2305:     move.b  D0,-(A5)  ; PHA
                            	  2306:     even
                            	  2307: _L_z04__TryShooting_SetSpeed:
                            	  2308:     ; Set the speed to whatever was determined: 0 or the value passed in [01].
