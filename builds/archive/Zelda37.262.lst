                            	  3484: _L_z04_UpdateOctorock_SaveOffset:
02:0003A492 1B00            	  3485:     move.b  D0,-(A5)  ; PHA
                            	  3486:     ; Decrement the animation counter, and roll over if needed.
                            	  3487:     ;
02:0003A494 41EC03D0        	  3488:     lea     ($03D0,A4),A0
02:0003A498 53302000        	  3489:     subq.b  #1,(A0,D2.W)
02:0003A49C 661E            	  3490:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003A49E 7006            	  3491:     moveq   #6,D0
02:0003A4A0 41EC03D0        	  3492:     lea     ($03D0,A4),A0
02:0003A4A4 11802000        	  3493:     move.b  D0,(A0,D2.W)
                            	  3494:     ; There are actually 6 frame images divided into 2 sets.
                            	  3495:     ; Each set depicts one animation frame. In each set there are
                            	  3496:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3497:     ;
                            	  3498:     ; The movement frame will keep track of the base offset of
                            	  3499:     ; the current set for the current animation frame: 0 or 3.
                            	  3500:     ;
                            	  3501:     ; So, XOR the movement frame with 3.
                            	  3502:     ;
02:0003A4A8 E208            	  3503:     lsr.b  #1,D0   ; LSR A
02:0003A4AA 41EC03E4        	  3504:     lea     ($03E4,A4),A0
02:0003A4AE 12302000        	  3505:     move.b  (A0,D2.W),D1
02:0003A4B2 B300            	  3506:     eor.b  D1,D0
02:0003A4B4 41EC03E4        	  3507:     lea     ($03E4,A4),A0
02:0003A4B8 11802000        	  3508:     move.b  D0,(A0,D2.W)
                            	  3509:     even
                            	  3510: _L_z04_UpdateOctorock_CalcFinalOffset:
