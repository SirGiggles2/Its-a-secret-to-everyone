02:0003C672 661C            	  8159:     bne  _L_z04_BlueWizzrobe_WalkOrTeleport_Walk
                            	  8160:     ; Timer = 0. Only teleporting now.
                            	  8161:     ;
                            	  8162:     ; If there is still distance to go while translucent, then
                            	  8163:     ; decrement the distance remaining, and move.
                            	  8164:     ;
02:0003C674 41EC0394        	  8165:     lea     ($0394,A4),A0
02:0003C678 10302000        	  8166:     move.b  (A0,D2.W),D0
02:0003C67C 670A            	  8167:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003C67E 41EC0394        	  8168:     lea     ($0394,A4),A0
02:0003C682 53302000        	  8169:     subq.b  #1,(A0,D2.W)
02:0003C686 602A            	  8170:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8171: 
                            	  8172:     even
                            	  8173: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8174:     ; Distance remaining = 0. Still teleporting.
                            	  8175:     ;
02:0003C688 6100021A        	  8176:     jsr     BlueWizzrobe_AlignWithNearestSquareAndRandomizeTimer
02:0003C68C 600000B0        	  8177:     jmp     BlueWizzrobe_TurnTowardLink
                            	  8178: 
                            	  8179:     even
                            	  8180: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8181:     ; Timer:
                            	  8182:     ;   >= $10: Turn if needed and move every other frame
                            	  8183:     ;   > 1:    Do nothing
                            	  8184:     ;   = 1:    Choose a place to teleport to.
                            	  8185:     ;
                            	  8186:     ; Notice that walking is slower than teleporting; and there is
                            	  8187:     ; a pause of $10 frames at the end.
                            	  8188:     ;
02:0003C690 0C000010        	  8189:     cmpi.b  #$10,D0
02:0003C694 6502            	  8190:     bcs.s  __far_z_04_0072
02:0003C696 600E            	  8191:     jmp  GoEveryOtherFrame
