                            	  1353: __far_z_01_0001:
                            	  1354:     ; If we have gotten this triforce piece, then go try to make a
                            	  1355:     ; whirlwind.
                            	  1356:     ;
02:00030068 1214            	  1357:     move.b  ($0000,A4),D1
02:0003006A C200            	  1358:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003006C 662C            	  1359:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  1360:     ; We have not gotten this piece.
                            	  1361:     ; First, advance the teleporting index again.
                            	  1362:     ;
02:0003006E 6150            	  1363:     jsr     AdvanceTeleportingLevelIndex
                            	  1364:     ; If the direction Link is facing is an increasing one, then
                            	  1365:     ; rotate the level mask in [00] left to correspond to the higher
                            	  1366:     ; level number. Then go test this new mask.
                            	  1367:     ;
02:00030070 102C0098        	  1368:     move.b  ($0098,A4),D0
02:00030074 02000009        	  1369:     andi.b #$09,D0
02:00030078 6710            	  1370:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0003007A 1214            	  1371:     move.b  ($0000,A4),D1
02:0003007C E309            	  1372:     lsl.b  #1,D1   ; ASL $00
02:0003007E 1881            	  1373:     move.b  D1,($0000,A4)
02:00030080 64DE            	  1374:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:00030082 1214            	  1375:     move.b  ($0000,A4),D1
02:00030084 E311            	  1376:     roxl.b  #1,D1   ; ROL $00
02:00030086 1881            	  1377:     move.b  D1,($0000,A4)
02:00030088 60D6            	  1378:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1379: 
