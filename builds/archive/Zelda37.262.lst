                            	  5493:     ;
02:00042772 7400            	  5494:     moveq   #0,D2
02:00042774 142C0006        	  5495:     move.b  ($0006,A4),D2
02:00042778 6712            	  5496:     beq  _anon_z05_112
02:0004277A 7400            	  5497:     moveq   #0,D2
02:0004277C 142C000B        	  5498:     move.b  ($000B,A4),D2
