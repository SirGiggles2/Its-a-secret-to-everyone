02:0003A4D2 10302000        	  3522:     move.b  (A0,D2.W),D0
02:0003A4D6 0200000C        	  3523:     andi.b #$0C,D0
02:0003A4DA 660E            	  3524:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3525:     ; Else draw not mirrored.
                            	  3526:     ;
02:0003A4DC 101D            	  3527:     move.b  (A5)+,D0  ; PLA
02:0003A4DE 4EB900030D28    	  3528:     jsr     DrawObjectNotMirrored
