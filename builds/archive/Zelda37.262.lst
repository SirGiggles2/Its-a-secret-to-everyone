02:000412DE 6620            	  4091:     bne  _anon_z05_96
02:000412E0 102C0001        	  4092:     move.b  ($0001,A4),D0
02:000412E4 41F90004123C    	  4093:     lea     (DoorwayBoundsMinUnder).l,A0
02:000412EA 12303000        	  4094:     move.b  (A0,D3.W),D1
02:000412EE B001            	  4095:     cmp.b   D1,D0
02:000412F0 650E            	  4096:     bcs  _anon_z05_96
02:000412F2 41F900041240    	  4097:     lea     (DoorwayBoundsMaxUnder).l,A0
02:000412F8 12303000        	  4098:     move.b  (A0,D3.W),D1
02:000412FC B001            	  4099:     cmp.b   D1,D0
