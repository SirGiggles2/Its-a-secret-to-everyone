                            	  7780:     ; Reset 16-bit vertical speed.
                            	  7781:     ;
02:0003C374 41EC0444        	  7782:     lea     ($0444,A4),A0
02:0003C378 11802000        	  7783:     move.b  D0,(A0,D2.W)
02:0003C37C 41EC0412        	  7784:     lea     ($0412,A4),A0
02:0003C380 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     ; Choose a random direction to face in.
                            	  7787:     ;
