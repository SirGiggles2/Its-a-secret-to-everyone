02:0003D032 41EC0084        	  9486:     lea     ($0084,A4),A0
02:0003D036 10302000        	  9487:     move.b  (A0,D2.W),D0
02:0003D03A 122C0003        	  9488:     move.b  ($0003,A4),D1
02:0003D03E D101            	  9489:     addx.b  D1,D0   ; ADC $03
02:0003D040 41EC0084        	  9490:     lea     ($0084,A4),A0
