                            	  5636: __far_z_05_0072:
02:00042884 6000FE5E        	  5637:     jmp     L_LayOutDoors_LoopDoors
                            	  5638: 
                            	  5639: ; Params:
                            	  5640: ; A: direction index
                            	  5641: ; Y: face index
                            	  5642: ;
                            	  5643: ; Returns:
                            	  5644: ; X: direction index
