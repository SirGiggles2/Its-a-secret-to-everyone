02:0004AB72 10302000        	  4151:     move.b  (A0,D2.W),D0
02:0004AB76 6704            	  4152:     beq.s  __far_z_07_0048
02:0004AB78 6000009E        	  4153:     jmp  L1F148_Exit
                            	  4154: __far_z_07_0048:
                            	  4155:     ; Grid offset = 0.
                            	  4156:     ; The object is at a point between cells in the grid.
                            	  4157:     ; So, we can check tiles for collision.
                            	  4158:     ;
                            	  4159:     ; Reset [0E] alternate direction search step.
                            	  4160:     ;
02:0004AB7C 1940000E        	  4161:     move.b  D0,($000E,A4)
                            	  4162:     ; If there's a movement direction, go check tile collision.
                            	  4163:     ;
02:0004AB80 102C000F        	  4164:     move.b  ($000F,A4),D0
02:0004AB84 6702            	  4165:     beq.s  __far_z_07_0049
02:0004AB86 602E            	  4166:     jmp  CheckTiles
                            	  4167: __far_z_07_0049:
