02:00044384 162C00EB        	  8721:     move.b  ($00EB,A4),D3
02:00044388 1214            	  8722:     move.b  ($00,A4),D1   ; ptr lo
02:0004438A 182C0001        	  8723:     move.b  ($01,A4),D4  ; ptr hi
02:0004438E 024100FF        	  8724:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00044392 E14C            	  8725:     lsl.w   #8,D4
