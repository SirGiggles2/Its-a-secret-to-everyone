02:0003EB12 19400050        	 13123:     move.b  D0,($0050,A4)
02:0003EB16 19400051        	 13124:     move.b  D0,($0051,A4)
02:0003EB1A 6718            	 13125:     beq  _L_z04_SetUpDroppedItem_Commit
                            	 13126:     even
