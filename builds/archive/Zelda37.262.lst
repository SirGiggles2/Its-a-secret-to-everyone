02:0003E360 702C            	 12044:     moveq   #44,D0
02:0003E362 7600            	 12045:     moveq   #0,D3
02:0003E364 41EC034F        	 12046:     lea     ($034F,A4),A0
02:0003E368 16302000        	 12047:     move.b  (A0,D2.W),D3
02:0003E36C 0C030025        	 12048:     cmpi.b  #$25,D3
02:0003E370 6702            	 12049:     beq  _anon_z04_158
02:0003E372 7018            	 12050:     moveq   #24,D0
                            	 12051: _anon_z04_158:
02:0003E374 1880            	 12052:     move.b  D0,($0000,A4)
