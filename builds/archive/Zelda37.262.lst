                            	  4783: ; [04]: object 2 mid X
                            	  4784: ; [05]: object 2 mid Y
                            	  4785: ; [0D]: horizontal threshold
                            	  4786: ; [0E]: vertical threshold
                            	  4787: ;
                            	  4788: ; Returns:
                            	  4789: ; A: 1 if objects collide
                            	  4790: ; Y: weapon or Link object slot (copied from [00])
                            	  4791: ; Z: 0 if objects collide
                            	  4792: ; [06]: 1 if objects collide
                            	  4793: ; [0A]: horizontal distance
                            	  4794: ; [0B]: vertical distance
                            	  4795: ;
                            	  4796: ;
                            	  4797: ; Reset [06] to indicate no collision by default.
