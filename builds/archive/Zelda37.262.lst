02:00040B60 122C0001        	  2959:     move.b  ($0001,A4),D1
02:00040B64 C001            	  2960:     and.b  D1,D0
02:00040B66 194000F8        	  2961:     move.b  D0,($00F8,A4)
                            	  2962:     ; If in OW or button mask <> 0, return.
