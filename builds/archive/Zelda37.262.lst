                            	   942: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   943: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   944: c_split_room_id:
02:0002B6EC 4EB900000000    	   945:     jsr     z05_split_room_id
02:0002B6F2 7600            	   946:     moveq   #0,D3
02:0002B6F4 1600            	   947:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   948:     lsr.w   #8,D0
02:0002B6F8 7400            	   949:     moveq   #0,D2
02:0002B6FA 1400            	   950:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   951:     rts
