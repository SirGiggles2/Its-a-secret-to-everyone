02:0003B114 41EC0394        	  5255:     lea     ($0394,A4),A0
02:0003B118 10302000        	  5256:     move.b  (A0,D2.W),D0
02:0003B11C 6656            	  5257:     bne  _L_z04_UpdateRope_Animate
                            	  5258:     ; If the absolute horizontal distance between Link and the monster >= 8,
                            	  5259:     ; then go see if the vertical distance is smaller.
                            	  5260:     ;
02:0003B11E 102C0070        	  5261:     move.b  ($0070,A4),D0
02:0003B122 003C0011        	  5262:     ori     #$11,CCR  ; SEC: set C+X
02:0003B126 12342070        	  5263:     move.b  ($70,A4,D2.W),D1
02:0003B12A 0A3C0010        	  5264:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B12E 9101            	  5265:     subx.b  D1,D0   ; SBC ObjX,X
02:0003B130 0A3C0010        	  5266:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B134 4EB900030822    	  5267:     jsr     Abs
02:0003B13A 0C000008        	  5268:     cmpi.b  #$08,D0
02:0003B13E 64000088        	  5269:     bcc  _L_z04_UpdateRope_CheckVertical
