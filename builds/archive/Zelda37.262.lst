                            	  2659: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2660:     ; State 1. Jumping.
                            	  2661:     ;
                            	  2662:     ; Keep the object inside the bounds of the room.
                            	  2663:     ;
02:00039E4E 61004FB6        	  2664:     jsr     BoundFlyer
                            	  2665:     ; If the object was blocked at the room boundary, then
                            	  2666:     ; increase boundary reversal count, and go set up another jump.
                            	  2667:     ;
02:00039E52 102C000F        	  2668:     move.b  ($000F,A4),D0
02:00039E56 660C            	  2669:     bne  _anon_z04_37
02:00039E58 41EC0451        	  2670:     lea     ($0451,A4),A0
02:00039E5C 52302000        	  2671:     addq.b  #1,(A0,D2.W)
02:00039E60 6000FF74        	  2672:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2673: 
                            	  2674: _anon_z04_37:
02:00039E64 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:00039E68 7000            	  2678:     moveq   #0,D0
02:00039E6A 41EC0451        	  2679:     lea     ($0451,A4),A0
02:00039E6E 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:00039E72 6100015E        	  2683:     jsr     Jumper_GetKind
02:00039E76 41F900039D62    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:00039E7C 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:00039E80 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E84 41EC0098        	  2696:     lea     ($0098,A4),A0
02:00039E88 12302000        	  2697:     move.b  (A0,D2.W),D1
02:00039E8C D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:00039E8E 7600            	  2699:     moveq   #0,D3
02:00039E90 1600            	  2700:     move.b  D0,D3
02:00039E92 41F900039D40    	  2701:     lea     (JumperYAccelerations).l,A0
02:00039E98 10303000        	  2702:     move.b  (A0,D3.W),D0
02:00039E9C 7602            	  2703:     moveq   #2,D3
02:00039E9E 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
                            	  2707:     ;
                            	  2708:     ; Else add 1.
                            	  2709:     ;
02:00039EA2 163C00FF        	  2710:     move.b  #$FF,D3
02:00039EA6 41EC0098        	  2711:     lea     ($0098,A4),A0
02:00039EAA 10302000        	  2712:     move.b  (A0,D2.W),D0
02:00039EAE 02000002        	  2713:     andi.b #$02,D0
02:00039EB2 6602            	  2714:     bne  _anon_z04_38
02:00039EB4 7601            	  2715:     moveq   #1,D3
                            	  2716: _anon_z04_38:
02:00039EB6 1003            	  2717:     move.b  D3,D0
02:00039EB8 023C00EE        	  2718:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039EBC 12342070        	  2719:     move.b  ($70,A4,D2.W),D1
02:00039EC0 D101            	  2720:     addx.b  D1,D0   ; ADC ObjX,X
02:00039EC2 19802070        	  2721:     move.b  D0,($70,A4,D2.W)
                            	  2722:     ; If going up (negative v-speed high byte), then
                            	  2723:     ; go animate, draw, and check collisions.
                            	  2724:     ;
02:00039EC6 41EC0412        	  2725:     lea     ($0412,A4),A0
02:00039ECA 10302000        	  2726:     move.b  (A0,D2.W),D0
02:00039ECE 6A04            	  2727:     bpl.s  __far_z_04_0022
02:00039ED0 60000090        	  2728:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2729: __far_z_04_0022:
                            	  2730:     ; Going down. We have to consider the target Y.
                            	  2731:     ;
                            	  2732:     ; If the absolute vertical distance to the target position >= 3,
                            	  2733:     ; then go animate, draw, and check collisions.
                            	  2734:     ;
02:00039ED4 41EC0084        	  2735:     lea     ($0084,A4),A0
02:00039ED8 10302000        	  2736:     move.b  (A0,D2.W),D0
02:00039EDC 003C0011        	  2737:     ori     #$11,CCR  ; SEC: set C+X
02:00039EE0 41EC0444        	  2738:     lea     ($0444,A4),A0
02:00039EE4 12302000        	  2739:     move.b  (A0,D2.W),D1
02:00039EE8 0A3C0010        	  2740:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039EEC 9101            	  2741:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:00039EEE 0A3C0010        	  2742:     eori    #$10,CCR  ; restore X = 6502 C
02:00039EF2 4EB900030822    	  2743:     jsr     Abs
02:00039EF8 0C000003        	  2744:     cmpi.b  #$03,D0
02:00039EFC 6502            	  2745:     bcs.s  __far_z_04_0023
02:00039EFE 6062            	  2746:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2747: __far_z_04_0023:
                            	  2748:     ; Distance < 3. Go to state 0.
                            	  2749:     ;
                            	  2750:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2751:     ;
02:00039F00 4EB90004B9B6    	  2752:     jsr     ResetObjState
02:00039F06 7600            	  2753:     moveq   #0,D3
02:00039F08 41EC034F        	  2754:     lea     ($034F,A4),A0
02:00039F0C 16302000        	  2755:     move.b  (A0,D2.W),D3
02:00039F10 0C030020        	  2756:     cmpi.b  #$20,D3
02:00039F14 6748            	  2757:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2758:     ; Else calculate a timer value.
                            	  2759:     ;
                            	  2760:     ; t := (Random + $10)
                            	  2761:     ; if t < $20 then
                            	  2762:     ;   t := t - $40
                            	  2763:     ;
02:00039F16 7010            	  2764:     moveq   #16,D0
02:00039F18 023C00EE        	  2765:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039F1C 12342019        	  2766:     move.b  ($19,A4,D2.W),D1
02:00039F20 D101            	  2767:     addx.b  D1,D0   ; ADC Random+1,X
02:00039F22 0C000020        	  2768:     cmpi.b  #$20,D0
02:00039F26 6412            	  2769:     bcc  _anon_z04_39
02:00039F28 003C0011        	  2770:     ori     #$11,CCR  ; SEC: set C+X
02:00039F2C 123C0040        	  2771:     move.b  #$40,D1
02:00039F30 0A3C0010        	  2772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039F34 9101            	  2773:     subx.b  D1,D0   ; SBC #$40
02:00039F36 0A3C0010        	  2774:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2775: _anon_z04_39:
                            	  2776:     ; If the object is a blue tektite, then go use this t.
                            	  2777:     ;
02:00039F3A 7600            	  2778:     moveq   #0,D3
02:00039F3C 41EC034F        	  2779:     lea     ($034F,A4),A0
02:00039F40 16302000        	  2780:     move.b  (A0,D2.W),D3
02:00039F44 0C03000D        	  2781:     cmpi.b  #$0D,D3
02:00039F48 6714            	  2782:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2783:     ; t := t AND $7F
                            	  2784:     ;
02:00039F4A 0200007F        	  2785:     andi.b #$7F,D0
                            	  2786:     ; If Random < $A0, then go use this t.
                            	  2787:     ;
02:00039F4E 7600            	  2788:     moveq   #0,D3
02:00039F50 16342019        	  2789:     move.b  ($19,A4,D2.W),D3
02:00039F54 0C0300A0        	  2790:     cmpi.b  #$A0,D3
02:00039F58 6504            	  2791:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2792:     ; t := t AND $F
                            	  2793:     ;
02:00039F5A 0200000F        	  2794:     andi.b #$0F,D0
                            	  2795:     even
                            	  2796: _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate:
02:00039F5E 19802028        	  2797:     move.b  D0,($28,A4,D2.W)
                            	  2798:     even
                            	  2799: Jumper_AnimateAndCheckCollisions:
02:00039F62 4EB90004BE18    	  2800:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2801:     ; TODO: [0D] ?
                            	  2802:     ; [0D] doesn't seem to be used.
                            	  2803:     ;
02:00039F68 1940000D        	  2804:     move.b  D0,($000D,A4)
                            	  2805:     ; If the monster is a boulder, then go animate, draw, check collision.
                            	  2806:     ;
02:00039F6C 41EC034F        	  2807:     lea     ($034F,A4),A0
