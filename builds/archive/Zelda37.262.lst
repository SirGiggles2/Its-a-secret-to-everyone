                            	  5215:     ; moblin, goriya, octorock, vire, keese
                            	  5216:     ; then attract these monsters to the food.
                            	  5217:     ;
                            	  5218:     ; They will chase the food instead of Link when given a chance.
                            	  5219:     ;
02:0004B26A 102C035F        	  5220:     move.b  ($035F,A4),D0
02:0004B26E 0C000003        	  5221:     cmpi.b  #$03,D0
02:0004B272 652C            	  5222:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:0004B274 0C00000B        	  5223:     cmpi.b  #$0B,D0
