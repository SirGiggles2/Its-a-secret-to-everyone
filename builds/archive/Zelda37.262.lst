02:0003A4BE 023C00EE        	  3514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A4C2 41EC03E4        	  3515:     lea     ($03E4,A4),A0
02:0003A4C6 12302000        	  3516:     move.b  (A0,D2.W),D1
02:0003A4CA D101            	  3517:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003A4CC 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
                            	  3519:     ; If facing vertically, go draw mirrored.
                            	  3520:     ;
