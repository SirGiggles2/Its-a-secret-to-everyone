02:000343C4 41F900033C8C    	  2697:     lea     (ModeEandFCursorSprites).l,A0
02:000343CA 10303000        	  2698:     move.b  (A0,D3.W),D0
02:000343CE 41EC0201        	  2699:     lea     ($0201,A4),A0
02:000343D2 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:000343D6 5303            	  2701:     subq.b  #1,D3
02:000343D8 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:000343DA 7600            	  2703:     moveq   #0,D3
02:000343DC 162C0016        	  2704:     move.b  ($0016,A4),D3
02:000343E0 41F900033C42    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:000343E6 10303000        	  2706:     move.b  (A0,D3.W),D0
02:000343EA 19400084        	  2707:     move.b  D0,($0084,A4)
02:000343EE 19400200        	  2708:     move.b  D0,($0200,A4)
02:000343F2 102C0012        	  2709:     move.b  ($0012,A4),D0
02:000343F6 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:000343FA 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:000343FC 103C00F3        	  2715:     move.b  #$F3,D0
02:00034400 19400201        	  2716:     move.b  D0,($0201,A4)
                            	  2717:     ; Because the visible part of the cursor block sprite is
                            	  2718:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2719:     ; above its ObjY.
02:00034404 102C0084        	  2720:     move.b  ($0084,A4),D0
02:00034408 003C0011        	  2721:     ori     #$11,CCR  ; SEC: set C+X
02:0003440C 123C0008        	  2722:     move.b  #$08,D1
02:00034410 0A3C0010        	  2723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034414 9101            	  2724:     subx.b  D1,D0   ; SBC #$08
02:00034416 0A3C0010        	  2725:     eori    #$10,CCR  ; restore X = 6502 C
02:0003441A 19400204        	  2726:     move.b  D0,($0204,A4)
02:0003441E 7070            	  2727:     moveq   #112,D0
02:00034420 19400070        	  2728:     move.b  D0,($0070,A4)
02:00034424 103C0087        	  2729:     move.b  #$87,D0
02:00034428 19400085        	  2730:     move.b  D0,($0085,A4)
02:0003442C 7030            	  2731:     moveq   #48,D0
02:0003442E 19400071        	  2732:     move.b  D0,($0071,A4)
                            	  2733:     even
