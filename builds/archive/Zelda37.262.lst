                            	  9401: Manhandla_Move:
                            	  9402:     ; Implement a way of manifesting the fractional part of the speed
                            	  9403:     ; in the movement.
                            	  9404:     ;
                            	  9405:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9406:     ; byte to add to the coordinates, then the effective speed would
                            	  9407:     ; be 1 pixel a frame instead of 1.25.
                            	  9408:     ;
                            	  9409:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9410:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9411:     ;
                            	  9412:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9413:     ;
                            	  9414:     ;   SA := SA + (SL AND $E0)
                            	  9415:     ;   [03] := SH + carry
                            	  9416:     ;
                            	  9417:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9418:     ;
02:0003CF8A 41EC041F        	  9419:     lea     ($041F,A4),A0
02:0003CF8E 10302000        	  9420:     move.b  (A0,D2.W),D0
02:0003CF92 020000E0        	  9421:     andi.b #$E0,D0
02:0003CF96 023C00EE        	  9422:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF9A 41EC0412        	  9423:     lea     ($0412,A4),A0
02:0003CF9E 12302000        	  9424:     move.b  (A0,D2.W),D1
02:0003CFA2 D101            	  9425:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003CFA4 41EC0412        	  9426:     lea     ($0412,A4),A0
02:0003CFA8 11802000        	  9427:     move.b  D0,(A0,D2.W)
                            	  9428:     ; Assign (high speed byte + carry) to [03].
                            	  9429:     ;
02:0003CFAC 41EC042C        	  9430:     lea     ($042C,A4),A0
02:0003CFB0 10302000        	  9431:     move.b  (A0,D2.W),D0
02:0003CFB4 123C0000        	  9432:     move.b  #$00,D1
02:0003CFB8 D101            	  9433:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CFBA 19400003        	  9434:     move.b  D0,($0003,A4)
                            	  9435:     ; Change coordinates by the speed amount/offset in [03]
                            	  9436:     ; according to the direction.
                            	  9437:     ;
                            	  9438:     ; Start with a mask of $A1 in [02]:
                            	  9439:     ; - low nibble represents the right direction
                            	  9440:     ; - high nibble is used to set or clear carry as we go along
                            	  9441:     ;
02:0003CFBE 103C00A1        	  9442:     move.b  #$A1,D0
02:0003CFC2 19400002        	  9443:     move.b  D0,($0002,A4)
                            	  9444:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9445:     ;
02:0003CFC6 41EC0098        	  9446:     lea     ($0098,A4),A0
02:0003CFCA 10302000        	  9447:     move.b  (A0,D2.W),D0
02:0003CFCE 122C0002        	  9448:     move.b  ($0002,A4),D1
02:0003CFD2 C200            	  9449:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CFD4 6712            	  9450:     beq  _L_z04_Manhandla_Move_Left
02:0003CFD6 10342070        	  9451:     move.b  ($70,A4,D2.W),D0
02:0003CFDA 023C00EE        	  9452:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFDE 122C0003        	  9453:     move.b  ($0003,A4),D1
02:0003CFE2 D101            	  9454:     addx.b  D1,D0   ; ADC $03
02:0003CFE4 19802070        	  9455:     move.b  D0,($70,A4,D2.W)
                            	  9456:     even
                            	  9457: _L_z04_Manhandla_Move_Left:
                            	  9458:     ; If direction has a left component (2), then subtract offset from X coordinate.
