02:000390D4 02000003        	   705:     andi.b #$03,D0
02:000390D8 4EB90002AECA    	   706:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	   707:     even
                            	   708: UpdateBlock_JumpTable:
02:000390DE 000390EA        	   709:     dc.l    UpdateBlock0Idle   ; jump table entry (32-bit for _m68k_tablejump)
02:000390E2 000391D4        	   710:     dc.l    UpdateBlock1Moving   ; jump table entry (32-bit for _m68k_tablejump)
