02:0003CFF6 19410002        	  9464:     move.b  D1,($0002,A4)
02:0003CFFA 122C0002        	  9465:     move.b  ($0002,A4),D1
02:0003CFFE C200            	  9466:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
