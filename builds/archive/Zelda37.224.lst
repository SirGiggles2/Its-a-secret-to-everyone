                            	  7301: Dodongo_CheckBombHit:
                            	  7302:     ; If state <> 0 (not moving), then return.
                            	  7303:     ;
02:0003CA6A 41EC00AC        	  7304:     lea     ($00AC,A4),A0
02:0003CA6E 10302000        	  7305:     move.b  (A0,D2.W),D0
02:0003CA72 66000086        	  7306:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7307:     ; If facing vertically, then store (X + 8) in [00].
                            	  7308:     ; Else store (X + $10).
                            	  7309:     ;
02:0003CA76 10342070        	  7310:     move.b  ($70,A4,D2.W),D0
02:0003CA7A 023C00EE        	  7311:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA7E 123C0008        	  7312:     move.b  #$08,D1
02:0003CA82 D101            	  7313:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CA84 7600            	  7314:     moveq   #0,D3
02:0003CA86 41EC0098        	  7315:     lea     ($0098,A4),A0
02:0003CA8A 16302000        	  7316:     move.b  (A0,D2.W),D3
