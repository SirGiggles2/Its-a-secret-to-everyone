02:000401E8 102C00EB        	   352:     move.b  ($00EB,A4),D0
02:000401EC 0200000F        	   353:     andi.b #$0F,D0
02:000401F0 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:000401F2 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:000401F4 E308            	   356:     lsl.b  #1,D0   ; ASL A
