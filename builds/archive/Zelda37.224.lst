                            	  6502: Digdogger_Move:
                            	  6503:     ; This calculation is the same one used in Manhandla to
                            	  6504:     ; manifest the fractional speed over several frames.
                            	  6505:     ;
                            	  6506:     ; To summarize, the formula is:
                            	  6507:     ;
                            	  6508:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6509:     ;
                            	  6510:     ;   SA := SA + (SL AND $E0)
                            	  6511:     ;   [03] := SH + carry
                            	  6512:     ;
                            	  6513:     ; See 04:A28E Manhandla_Move.
                            	  6514:     ;
02:0003C47A 41EC041F        	  6515:     lea     ($041F,A4),A0
02:0003C47E 10302000        	  6516:     move.b  (A0,D2.W),D0
02:0003C482 020000E0        	  6517:     andi.b #$E0,D0
02:0003C486 023C00EE        	  6518:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C48A 41EC0412        	  6519:     lea     ($0412,A4),A0
02:0003C48E 12302000        	  6520:     move.b  (A0,D2.W),D1
02:0003C492 D101            	  6521:     addx.b  D1,D0   ; ADC $0412,X
02:0003C494 41EC0412        	  6522:     lea     ($0412,A4),A0
02:0003C498 11802000        	  6523:     move.b  D0,(A0,D2.W)
                            	  6524:     ; Assign (high speed byte + carry) to [03].
                            	  6525:     ;
02:0003C49C 41EC042C        	  6526:     lea     ($042C,A4),A0
02:0003C4A0 10302000        	  6527:     move.b  (A0,D2.W),D0
02:0003C4A4 123C0000        	  6528:     move.b  #$00,D1
02:0003C4A8 D101            	  6529:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C4AA 19400003        	  6530:     move.b  D0,($0003,A4)
                            	  6531:     ; Change coordinates by the speed amount/offset in [03]
                            	  6532:     ; according to the direction.
                            	  6533:     ;
                            	  6534:     ; Start with a mask of $A1 in [02]:
                            	  6535:     ; - low nibble represents the right direction
                            	  6536:     ; - high nibble is used to set or clear carry as we go along
                            	  6537:     ;
02:0003C4AE 103C00A1        	  6538:     move.b  #$A1,D0
02:0003C4B2 19400002        	  6539:     move.b  D0,($0002,A4)
                            	  6540:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6541:     ;
02:0003C4B6 41EC0098        	  6542:     lea     ($0098,A4),A0
02:0003C4BA 10302000        	  6543:     move.b  (A0,D2.W),D0
02:0003C4BE 122C0002        	  6544:     move.b  ($0002,A4),D1
02:0003C4C2 C200            	  6545:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4C4 6712            	  6546:     beq  _L_z04_Digdogger_Move_Left
02:0003C4C6 10342070        	  6547:     move.b  ($70,A4,D2.W),D0
02:0003C4CA 023C00EE        	  6548:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4CE 122C0003        	  6549:     move.b  ($0003,A4),D1
02:0003C4D2 D101            	  6550:     addx.b  D1,D0   ; ADC $03
02:0003C4D4 19802070        	  6551:     move.b  D0,($70,A4,D2.W)
                            	  6552:     even
                            	  6553: _L_z04_Digdogger_Move_Left:
                            	  6554:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6555:     ;
