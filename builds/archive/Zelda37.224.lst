                            	 12241: Lamnola_Move:
                            	 12242:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12243:     ;
                            	 12244:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12245:     ;
                            	 12246:     ; Start with a mask of $A1 in [02]:
                            	 12247:     ; - low nibble represents the right direction
                            	 12248:     ; - high nibble is used to set or clear carry as we go along
                            	 12249:     ;
02:0003EED8 103C00A1        	 12250:     move.b  #$A1,D0
02:0003EEDC 19400002        	 12251:     move.b  D0,($0002,A4)
                            	 12252:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12253:     ;
02:0003EEE0 41EC0098        	 12254:     lea     ($0098,A4),A0
02:0003EEE4 10302000        	 12255:     move.b  (A0,D2.W),D0
02:0003EEE8 122C0002        	 12256:     move.b  ($0002,A4),D1
02:0003EEEC C200            	 12257:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEEE 6712            	 12258:     beq  _L_z04_Lamnola_Move_Left
02:0003EEF0 10342070        	 12259:     move.b  ($70,A4,D2.W),D0
02:0003EEF4 023C00EE        	 12260:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEF8 122C04E6        	 12261:     move.b  ($04E6,A4),D1
