                            	  6898: Aquamentus_Draw:
                            	  6899:     ; Every $10 screen frames, switch animation frames.
                            	  6900:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6901:     ; The last tile of frame 0 is at index 5.
                            	  6902:     ; The last tile of frame 1 is at index $B.
                            	  6903:     ;
02:0003C780 7605            	  6904:     moveq   #5,D3
02:0003C782 102C0015        	  6905:     move.b  ($0015,A4),D0
02:0003C786 02000010        	  6906:     andi.b #$10,D0
02:0003C78A 6602            	  6907:     bne  _anon_z04_88
02:0003C78C 760B            	  6908:     moveq   #11,D3
                            	  6909: _anon_z04_88:
02:0003C78E 1943000A        	  6910:     move.b  D3,($000A,A4)
                            	  6911:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6912:     ;
02:0003C792 7005            	  6913:     moveq   #5,D0
02:0003C794 1940000B        	  6914:     move.b  D0,($000B,A4)
                            	  6915:     even
                            	  6916: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C798 7600            	  6917:     moveq   #0,D3
02:0003C79A 162C000B        	  6918:     move.b  ($000B,A4),D3
                            	  6919:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6920:     ; Store it in [00].
                            	  6921:     ;
02:0003C79E 10342070        	  6922:     move.b  ($70,A4,D2.W),D0
02:0003C7A2 023C00EE        	  6923:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7A6 41F90003C77A    	  6924:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C7AC 12303000        	  6925:     move.b  (A0,D3.W),D1
02:0003C7B0 D101            	  6926:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C7B2 1880            	  6927:     move.b  D0,($0000,A4)
                            	  6928:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6929:     ; Store it in [01].
                            	  6930:     ;
02:0003C7B4 41EC0084        	  6931:     lea     ($0084,A4),A0
02:0003C7B8 10302000        	  6932:     move.b  (A0,D2.W),D0
02:0003C7BC 023C00EE        	  6933:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7C0 41F90003C774    	  6934:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C7C6 12303000        	  6935:     move.b  (A0,D3.W),D1
02:0003C7CA D101            	  6936:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C7CC 19400001        	  6937:     move.b  D0,($0001,A4)
                            	  6938:     ; Calculate sprite attributes:
                            	  6939:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6940:     ;
                            	  6941:     ; If the boss is temporarily invincible, then
                            	  6942:     ; this makes it flash by cycling all the palette rows.
                            	  6943:     ;
                            	  6944:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6945:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6946:     ;
02:0003C7D0 41EC04F0        	  6947:     lea     ($04F0,A4),A0
02:0003C7D4 10302000        	  6948:     move.b  (A0,D2.W),D0
02:0003C7D8 02000003        	  6949:     andi.b #$03,D0
02:0003C7DC 0A000003        	  6950:     eori.b #$03,D0
02:0003C7E0 19400003        	  6951:     move.b  D0,($0003,A4)
02:0003C7E4 7600            	  6952:     moveq   #0,D3
02:0003C7E6 162C000A        	  6953:     move.b  ($000A,A4),D3
                            	  6954:     ; Look up the tile for this sprite.
                            	  6955:     ; If it's not the first one (face), then go write the sprite record.
                            	  6956:     ;
02:0003C7EA 41F90003C768    	  6957:     lea     (AquamentusTiles).l,A0
02:0003C7F0 10303000        	  6958:     move.b  (A0,D3.W),D0
02:0003C7F4 12390003C768    	  6959:     move.b  (AquamentusTiles).l,D1
02:0003C7FA B001            	  6960:     cmp.b   D1,D0
02:0003C7FC 6610            	  6961:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6962:     ; Else it's the first one (the face tile).
                            	  6963:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6964:     ;
                            	  6965:     ; $CC/CD shows the closed mouth face.
                            	  6966:     ; $C0/C1 shows the open mouth face.
                            	  6967:     ;
02:0003C7FE 7600            	  6968:     moveq   #0,D3
02:0003C800 16342028        	  6969:     move.b  ($28,A4,D2.W),D3
02:0003C804 0C030020        	  6970:     cmpi.b  #$20,D3
02:0003C808 6404            	  6971:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C80A 103C00C0        	  6972:     move.b  #$C0,D0
                            	  6973:     even
                            	  6974: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C80E 610E            	  6975:     jsr     WriteBossSprite
                            	  6976:     ; Bottom of the loop.
                            	  6977:     ; Decrement tile index and loop index.
                            	  6978:     ;
02:0003C810 532C000A        	  6979:     subq.b  #1,($000A,A4)
02:0003C814 532C000B        	  6980:     subq.b  #1,($000B,A4)
02:0003C818 6A00FF7E        	  6981:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C81C 4E75            	  6982:     rts
                            	  6983: 
                            	  6984: ; Params:
                            	  6985: ; A: tile
                            	  6986: ; [00]: X
                            	  6987: ; [01]: Y
                            	  6988: ; [03]: sprite attributes
                            	  6989: ;
                            	  6990: ; Save the tile
                            	  6991:     even
                            	  6992: WriteBossSprite:
02:0003C81E 1B00            	  6993:     move.b  D0,-(A5)  ; PHA
02:0003C820 7600            	  6994:     moveq   #0,D3
02:0003C822 162C0341        	  6995:     move.b  ($0341,A4),D3
02:0003C826 41F90003167C    	  6996:     lea     (SpriteOffsets).l,A0
02:0003C82C 10303000        	  6997:     move.b  (A0,D3.W),D0
02:0003C830 7600            	  6998:     moveq   #0,D3
02:0003C832 1600            	  6999:     move.b  D0,D3
02:0003C834 101D            	  7000:     move.b  (A5)+,D0  ; PLA
02:0003C836 41EC0201        	  7001:     lea     ($0201,A4),A0
02:0003C83A 11803000        	  7002:     move.b  D0,(A0,D3.W)
02:0003C83E 1014            	  7003:     move.b  ($0000,A4),D0
02:0003C840 41EC0203        	  7004:     lea     ($0203,A4),A0
02:0003C844 11803000        	  7005:     move.b  D0,(A0,D3.W)
02:0003C848 102C0001        	  7006:     move.b  ($0001,A4),D0
02:0003C84C 4EF9000319FA    	  7007:     jmp     Anim_EndWriteSprite
