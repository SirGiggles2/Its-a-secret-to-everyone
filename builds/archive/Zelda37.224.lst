                            	  4397: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4398:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4399:     ;
                            	  4400:     ; To match a doorway:
                            	  4401:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4402:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4403:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4404:     ;
                            	  4405:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4406:     ; a doorway to be part of it.
                            	  4407:     ;
