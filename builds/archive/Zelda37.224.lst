                            	  4944: 
                            	  4945: ; Params:
                            	  4946: ; [02:03]: address of door tiles for direction and face
                            	  4947: ; [04]: count of tiles remaining
                            	  4948: ; [07]: current index (0 to 3) of the tile to copy
                            	  4949: ;       to the dynamic transfer buf
                            	  4950: ; [09]: door direction index
                            	  4951: ;
                            	  4952: ; Returns:
                            	  4953: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4954: ; [04]: original value - 1
                            	  4955: ; [07]: original value + 1
                            	  4956: ;
                            	  4957: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4958: ; vertically. The point of this routine is to access them
                            	  4959: ; horizontally in order to transfer them to a nametable.
                            	  4960: ;
                            	  4961: ;
                            	  4962: ; For the direction index in [09], look up the base offset of the
                            	  4963: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4964: ; the door face tiles at [02:03].
                            	  4965: ;
                            	  4966:     even
                            	  4967: WriteDoorFaceTileHorizontally:
02:0004281C 7600            	  4968:     moveq   #0,D3
02:0004281E 162C0009        	  4969:     move.b  ($0009,A4),D3
02:00042822 41F900043A40    	  4970:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:00042828 10303000        	  4971:     move.b  (A0,D3.W),D0
                            	  4972:     ; Add [07] to the base offset we got above. This yields one
                            	  4973:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4974:     ;
02:0004282C 023C00EE        	  4975:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042830 122C0007        	  4976:     move.b  ($0007,A4),D1
02:00042834 D101            	  4977:     addx.b  D1,D0   ; ADC $07
02:00042836 7600            	  4978:     moveq   #0,D3
02:00042838 1600            	  4979:     move.b  D0,D3
                            	  4980:     ; With that index, look up the index to use with the door face
                            	  4981:     ; list of tiles at [02:03].
                            	  4982:     ;
