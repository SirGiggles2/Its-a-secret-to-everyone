02:0003DC6E 61001B5C        	  9766:     jsr     PlayBossDeathCry
02:0003DC72 705D            	  9767:     moveq   #93,D0
02:0003DC74 19400354        	  9768:     move.b  D0,($0354,A4)
02:0003DC78 7010            	  9769:     moveq   #16,D0
02:0003DC7A 1940040A        	  9770:     move.b  D0,($040A,A4)
02:0003DC7E 1940002D        	  9771:     move.b  D0,($002D,A4)
                            	  9772:     even
