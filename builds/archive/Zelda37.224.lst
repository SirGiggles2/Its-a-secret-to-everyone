02:0003C4FE 9101            	  6567:     subx.b  D1,D0   ; SBC $03
02:0003C500 0A3C0010        	  6568:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C504 19802070        	  6569:     move.b  D0,($70,A4,D2.W)
                            	  6570:     even
