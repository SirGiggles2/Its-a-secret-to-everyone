02:0004C65A 41EC00AC        	  5447:     lea     ($00AC,A4),A0
02:0004C65E 10302000        	  5448:     move.b  (A0,D2.W),D0
02:0004C662 0200000F        	  5449:     andi.b #$0F,D0
02:0004C666 0C000003        	  5450:     cmpi.b  #$03,D0
