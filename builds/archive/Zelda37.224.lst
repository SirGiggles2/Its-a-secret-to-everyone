02:0003AE8E 10302000        	  3445:     move.b  (A0,D2.W),D0
02:0003AE92 0C000003        	  3446:     cmpi.b  #$03,D0
02:0003AE96 666E            	  3447:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
