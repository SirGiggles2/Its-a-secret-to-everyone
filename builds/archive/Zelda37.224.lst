02:0002E130 6AEA            	   754:     bpl  _anon_z01_7
                            	   755:     even
                            	   756: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   757:     ; Replace the low byte of the VRAM address with the one
                            	   758:     ; where the next character should be written.
                            	   759:     ;
02:0002E132 102C045F        	   760:     move.b  ($045F,A4),D0
02:0002E136 19400303        	   761:     move.b  D0,($0303,A4)
                            	   762:     ; Increment the low VRAM address for the next character.
                            	   763:     ;
02:0002E13A 522C045F        	   764:     addq.b  #1,($045F,A4)
                            	   765:     ; Use the person text selector to look up the address of the
                            	   766:     ; text for the textbox. Store the address in [00:01].
                            	   767:     ;
02:0002E13E 7600            	   768:     moveq   #0,D3
02:0002E140 162C0415        	   769:     move.b  ($0415,A4),D3
02:0002E144 41F90002D77A    	   770:     lea     (PersonTextAddrs).l,A0
02:0002E14A 10303000        	   771:     move.b  (A0,D3.W),D0
02:0002E14E 1880            	   772:     move.b  D0,($0000,A4)
02:0002E150 5203            	   773:     addq.b  #1,D3
02:0002E152 41F90002D77A    	   774:     lea     (PersonTextAddrs).l,A0
02:0002E158 10303000        	   775:     move.b  (A0,D3.W),D0
02:0002E15C 19400001        	   776:     move.b  D0,($0001,A4)
                            	   777:     ; Load the person text current character index.
                            	   778:     ;
02:0002E160 7600            	   779:     moveq   #0,D3
02:0002E162 162C0416        	   780:     move.b  ($0416,A4),D3
                            	   781:     ; Increment the index variable to point to the next character
                            	   782:     ; for next time.
                            	   783:     ;
02:0002E166 522C0416        	   784:     addq.b  #1,($0416,A4)
                            	   785:     ; Get the current character.
                            	   786:     ;
02:0002E16A 1214            	   787:     move.b  ($00,A4),D1   ; ptr lo
02:0002E16C 182C0001        	   788:     move.b  ($01,A4),D4  ; ptr hi
02:0002E170 024100FF        	   789:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E174 E14C            	   790:     lsl.w   #8,D4
02:0002E176 8841            	   791:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E178 48C4            	   792:     ext.l   D4
02:0002E17A D8BC00FF0000    	   793:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E180 2044            	   794:     movea.l D4,A0
02:0002E182 10303000        	   795:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   796:     ; If the character is $25, then it's a special space. It will still
                            	   797:     ; take up space, but will not take time to show -- meaning that
                            	   798:     ; we'll go look up the next character to transfer.
                            	   799:     ;
02:0002E186 0200003F        	   800:     andi.b #$3F,D0
02:0002E18A 0C000025        	   801:     cmpi.b  #$25,D0
02:0002E18E 67A2            	   802:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   803:     ; We have a non-space character. Put it in the transfer record.
                            	   804:     ;
02:0002E190 19400305        	   805:     move.b  D0,($0305,A4)
                            	   806:     ; Play the "heart taken/character" sound effect.
                            	   807:     ;
02:0002E194 7010            	   808:     moveq   #16,D0
02:0002E196 19400604        	   809:     move.b  D0,($0604,A4)
                            	   810:     ; If the high 2 bits of character element = 0, then return.
                            	   811:     ;
02:0002E19A 1214            	   812:     move.b  ($00,A4),D1   ; ptr lo
02:0002E19C 182C0001        	   813:     move.b  ($01,A4),D4  ; ptr hi
02:0002E1A0 024100FF        	   814:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E1A4 E14C            	   815:     lsl.w   #8,D4
02:0002E1A6 8841            	   816:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E1A8 48C4            	   817:     ext.l   D4
02:0002E1AA D8BC00FF0000    	   818:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E1B0 2044            	   819:     movea.l D4,A0
02:0002E1B2 10303000        	   820:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E1B6 020000C0        	   821:     andi.b #$C0,D0
02:0002E1BA 672E            	   822:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   823:     ; Determine an index based on the high 2 bits of the character element:
