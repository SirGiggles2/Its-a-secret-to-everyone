02:00031126 101D            	  5396:     move.b  (A5)+,D0  ; PLA
                            	  5397:     ; Check the high nibble which specifies the item's class.
                            	  5398:     ;
                            	  5399:     ; A: item class
                            	  5400:     ; X: item type
                            	  5401:     ; Y: item slot
                            	  5402:     ;
02:00031128 020000F0        	  5403:     andi.b #$F0,D0
02:0003112C 6702            	  5404:     beq.s  __far_z_01_0040
02:0003112E 6036            	  5405:     jmp  CheckClass1
                            	  5406: __far_z_01_0040:
                            	  5407:     ; Class 0. We have an item of a type that's unique or complex.
                            	  5408:     ;
