02:0003B62E E208            	  4590:     lsr.b  #1,D0   ; LSR A
02:0003B630 E208            	  4591:     lsr.b  #1,D0   ; LSR A
02:0003B632 E208            	  4592:     lsr.b  #1,D0   ; LSR A
02:0003B634 E208            	  4593:     lsr.b  #1,D0   ; LSR A
02:0003B636 E208            	  4594:     lsr.b  #1,D0   ; LSR A
                            	  4595:     ; If it's 0, then return C=0.
                            	  4596:     ;
02:0003B638 6726            	  4597:     beq  _L_z04_IsQuestSecretMismatch_ReturnFalse
                            	  4598:     ; Look up a quest number (0 or 1) indexed by quest secret (0 or 1).
