02:0002E834 123C0010        	  1769:     move.b  #$10,D1
02:0002E838 0A3C0010        	  1770:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E83C 9101            	  1771:     subx.b  D1,D0   ; SBC #$10
02:0002E83E 0A3C0010        	  1772:     eori    #$10,CCR  ; restore X = 6502 C
