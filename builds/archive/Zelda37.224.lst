02:0003D02A 023C00EE        	  8113:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D02E 123C0008        	  8114:     move.b  #$08,D1
02:0003D032 D101            	  8115:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
