02:00039C66 52302000        	   862:     addq.b  #1,(A0,D2.W)
                            	   863:     ; If the push timer still < $10, return.
                            	   864:     ;
02:00039C6A 7600            	   865:     moveq   #0,D3
02:00039C6C 41EC0412        	   866:     lea     ($0412,A4),A0
02:00039C70 16302000        	   867:     move.b  (A0,D2.W),D3
02:00039C74 0C030010        	   868:     cmpi.b  #$10,D3
02:00039C78 6402            	   869:     bcc.s  __far_z_04_0009
02:00039C7A 6034            	   870:     jmp  L10262_Exit
