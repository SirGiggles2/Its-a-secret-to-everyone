                            	  2528: LA10A_Exit:
02:00034CCE 4E75            	  2529:     rts
                            	  2530: 
                            	  2531: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2532: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2533: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2534: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2535: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2536: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2537:     even
                            	  2538: ModeE_SyncCharBoardCursorToIndex:
02:00034CD0 4EF90002BADC    	  2539:     jmp     c_mode_e_sync_char_board_cursor
                            	  2540: 
                            	  2541: ModeE_HandleAOrB:
02:00034CD6 102C0420        	  2542:     move.b  ($0420,A4),D0
                            	  2543:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2544:     ; the name field.
02:00034CDA 6646            	  2545:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00034CDC 7600            	  2546:     moveq   #0,D3
02:00034CDE 162C0016        	  2547:     move.b  ($0016,A4),D3
02:00034CE2 0C030003        	  2548:     cmpi.b  #$03,D3
02:00034CE6 6602            	  2549:     bne.s  __far_z_02_0007
02:00034CE8 60E4            	  2550:     jmp  LA10A_Exit
                            	  2551: __far_z_02_0007:
                            	  2552:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2553:     ; in the current slot's name.
02:00034CEA 41F9000346F8    	  2554:     lea     (SlotToNameOffset).l,A0
02:00034CF0 10303000        	  2555:     move.b  (A0,D3.W),D0
02:00034CF4 19400421        	  2556:     move.b  D0,($0421,A4)
                            	  2557:     ; Get the offset of the end of the initial name character
                            	  2558:     ; transfer record header for the current slot.
02:00034CF8 7400            	  2559:     moveq   #0,D2
02:00034CFA 41F9000346FC    	  2560:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034D00 14303000        	  2561:     move.b  (A0,D3.W),D2
02:00034D04 7602            	  2562:     moveq   #2,D3
                            	  2563:     even
                            	  2564: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00034D06 41F9000346C8    	  2565:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00034D0C 10302000        	  2566:     move.b  (A0,D2.W),D0
02:00034D10 41EC0422        	  2567:     lea     ($0422,A4),A0
02:00034D14 11803000        	  2568:     move.b  D0,(A0,D3.W)
02:00034D18 5302            	  2569:     subq.b  #1,D2
02:00034D1A 5303            	  2570:     subq.b  #1,D3
02:00034D1C 6AE8            	  2571:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034D1E 522C0420        	  2572:     addq.b  #1,($0420,A4)
                            	  2573:     even
                            	  2574: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2575:     ; At this point:
                            	  2576:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2577:     ;   - This will be changed as the player inputs characters.
                            	  2578:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2579:     ;   - This will be changed as the player inputs characters.
                            	  2580:     ; - InitializedNameField [$0420] is set to 1.
                            	  2581:     ;
02:00034D22 102C00F8        	  2582:     move.b  ($00F8,A4),D0
02:00034D26 020000C0        	  2583:     andi.b #$C0,D0
02:00034D2A 670000E8        	  2584:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2585:     ; A or B was pressed.
                            	  2586:     ;
02:00034D2E 0C000040        	  2587:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034D32 660000A6        	  2588:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2589:     ; A was pressed.
                            	  2590:     ;
                            	  2591:     ; Request to play the character click tune (same as bomb set).
02:00034D36 7620            	  2592:     moveq   #32,D3
02:00034D38 19430604        	  2593:     move.b  D3,($0604,A4)
02:00034D3C 7602            	  2594:     moveq   #2,D3
                            	  2595:     even
                            	  2596: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00034D3E 41EC0422        	  2597:     lea     ($0422,A4),A0
02:00034D42 10303000        	  2598:     move.b  (A0,D3.W),D0
02:00034D46 41EC0302        	  2599:     lea     ($0302,A4),A0
02:00034D4A 11803000        	  2600:     move.b  D0,(A0,D3.W)
02:00034D4E 5303            	  2601:     subq.b  #1,D3
02:00034D50 6AEC            	  2602:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034D52 19430306        	  2603:     move.b  D3,($0306,A4)
02:00034D56 7400            	  2604:     moveq   #0,D2
02:00034D58 142C0421        	  2605:     move.b  ($0421,A4),D2
02:00034D5C 7600            	  2606:     moveq   #0,D3
02:00034D5E 162C041F        	  2607:     move.b  ($041F,A4),D3
02:00034D62 41F90003469C    	  2608:     lea     (ModeE_CharMap).l,A0
02:00034D68 10303000        	  2609:     move.b  (A0,D3.W),D0
02:00034D6C 19400305        	  2610:     move.b  D0,($0305,A4)
02:00034D70 41EC0638        	  2611:     lea     ($0638,A4),A0
02:00034D74 11802000        	  2612:     move.b  D0,(A0,D2.W)
                            	  2613:     even
                            	  2614: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00034D78 102C0070        	  2615:     move.b  ($0070,A4),D0
02:00034D7C 023C00EE        	  2616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034D80 123C0008        	  2617:     move.b  #$08,D1
02:00034D84 D101            	  2618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00034D86 19400070        	  2619:     move.b  D0,($0070,A4)
02:00034D8A 522C0421        	  2620:     addq.b  #1,($0421,A4)
02:00034D8E 522C0423        	  2621:     addq.b  #1,($0423,A4)
                            	  2622:     ; If VRAM address still points inside the name field,
                            	  2623:     ; then go finish.
                            	  2624:     ;
                            	  2625:     ; The idea is that each name field in nametable begins at
                            	  2626:     ; an address ending in $E. For example, slot 0 has a name
                            	  2627:     ; at VRAM addresses $20CE to $20D5.
                            	  2628:     ;
                            	  2629:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2630:     ; the name field.
                            	  2631:     ;
                            	  2632:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2633:     ; record header.
                            	  2634:     ;
02:00034D92 102C0070        	  2635:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00034D96 0C0000B0        	  2636:     cmpi.b  #$B0,D0
02:00034D9A 6678            	  2637:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2638:     ; The VRAM address now points outside the name field.
                            	  2639:     ; So, wrap around to the beginning of the name field.
                            	  2640:     ;
                            	  2641:     ; For example, $20D6 -> $20CE.
                            	  2642:     ;
02:00034D9C 102C0423        	  2643:     move.b  ($0423,A4),D0
02:00034DA0 003C0011        	  2644:     ori     #$11,CCR  ; SEC: set C+X
02:00034DA4 123C0008        	  2645:     move.b  #$08,D1
02:00034DA8 0A3C0010        	  2646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034DAC 9101            	  2647:     subx.b  D1,D0   ; SBC #$08
02:00034DAE 0A3C0010        	  2648:     eori    #$10,CCR  ; restore X = 6502 C
02:00034DB2 19400423        	  2649:     move.b  D0,($0423,A4)
                            	  2650:     ; It also means that we went past the end of the save slot
                            	  2651:     ; info name. Set the offset to the beginning of the name.
02:00034DB6 7600            	  2652:     moveq   #0,D3
02:00034DB8 162C0016        	  2653:     move.b  ($0016,A4),D3
02:00034DBC 41F9000346F8    	  2654:     lea     (SlotToNameOffset).l,A0
02:00034DC2 10303000        	  2655:     move.b  (A0,D3.W),D0
02:00034DC6 19400421        	  2656:     move.b  D0,($0421,A4)
                            	  2657:     ; If the name cursor has gone past the end of the field,
                            	  2658:     ; then wrap around.
02:00034DCA 102C0070        	  2659:     move.b  ($0070,A4),D0
02:00034DCE 0C0000B0        	  2660:     cmpi.b  #$B0,D0
02:00034DD2 6640            	  2661:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00034DD4 7070            	  2662:     moveq   #112,D0
02:00034DD6 19400070        	  2663:     move.b  D0,($0070,A4)
                            	  2664:     even
                            	  2665: ; PATCH P25b: FS2-E backspace handler.
                            	  2666: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2667: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2668: ; one column (8 px), and writes a space ($24) to the erased
                            	  2669: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2670: ; cannot cross into a previous slot's name field.
                            	  2671: _L_z02_ModeE_HandleAOrB_Backspace:
02:00034DDA 7600            	  2672:     moveq   #0,D3
02:00034DDC 162C0016        	  2673:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00034DE0 41F9000346F8    	  2674:     lea     (SlotToNameOffset).l,A0
02:00034DE6 12303000        	  2675:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00034DEA 102C0421        	  2676:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00034DEE B001            	  2677:     cmp.b   D1,D0
02:00034DF0 6322            	  2678:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00034DF2 5300            	  2679:     subq.b  #1,D0
02:00034DF4 19400421        	  2680:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00034DF8 532C0423        	  2681:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00034DFC 122C0070        	  2682:     move.b  ($0070,A4),D1
02:00034E00 5101            	  2683:     subi.b  #8,D1
02:00034E02 19410070        	  2684:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00034E06 7224            	  2685:     moveq   #$24,D1              ; space tile
02:00034E08 7600            	  2686:     moveq   #0,D3
02:00034E0A 1600            	  2687:     move.b  D0,D3                ; D3 = erased offset
02:00034E0C 41EC0638        	  2688:     lea     ($0638,A4),A0
02:00034E10 11813000        	  2689:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2690:     jmp     _L_z02_ModeE_HandleAOrB_Exit
