                            	  6047: DrawBoomerangAndCheckCollision:
                            	  6048:     ; If the boomerang belongs to a monster, then check for
                            	  6049:     ; collision with Link.
                            	  6050:     ;
                            	  6051:     ; If they collide, then set state $20 and animation counter 3.
                            	  6052:     ;
02:0004CA8A 0C02000D        	  6053:     cmpi.b  #$0D,D2
