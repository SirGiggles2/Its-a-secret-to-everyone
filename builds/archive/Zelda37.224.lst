                            	  7456: DodongoBombPositiveLimits:
02:0003CB6A 0C              	  7457:     dc.b    $0C, $11
02:0003CB6B 11
                            	  7458: 
                            	  7459:     even
                            	  7460: DodongoBombNegativeLimits:
02:0003CB6C F4              	  7461:     dc.b    $F4, $F0
02:0003CB6D F0
                            	  7462: 
                            	  7463: ; Params:
                            	  7464: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7465: ; [00]: monster hotspot X
                            	  7466: ; [01]: monster hotspot Y
                            	  7467: ; [02]: bomb hotspot X
                            	  7468: ; [03]: bomb hotspot Y
                            	  7469: ;
                            	  7470: ; Returns:
                            	  7471: ; A: 0 if the bomb is in range of the monster
                            	  7472: ; Z: 1 if the bomb is in range of the monster
                            	  7473: ; [04]: horizontal distance
                            	  7474: ; [05]: vertical distance
                            	  7475: ;
                            	  7476: ; Store the positive limit in [06], and the negative one in [07].
                            	  7477: ;
                            	  7478:     even
                            	  7479: Dodongo_IsBombInRange:
02:0003CB6E 41F90003CB6A    	  7480:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CB74 10303000        	  7481:     move.b  (A0,D3.W),D0
02:0003CB78 19400006        	  7482:     move.b  D0,($0006,A4)
02:0003CB7C 41F90003CB6C    	  7483:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CB82 10303000        	  7484:     move.b  (A0,D3.W),D0
02:0003CB86 19400007        	  7485:     move.b  D0,($0007,A4)
                            	  7486:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7487:     ; the bomb is near enough the monster.
                            	  7488:     ;
02:0003CB8A 7003            	  7489:     moveq   #3,D0
02:0003CB8C 19400008        	  7490:     move.b  D0,($0008,A4)
                            	  7491:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7492:     ;
02:0003CB90 7601            	  7493:     moveq   #1,D3
                            	  7494:     even
                            	  7495: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7496:     ; Subtract the bomb's coordinate from the boss's,
                            	  7497:     ; The loop index determines the coordinate.
                            	  7498:     ;
02:0003CB92 10343000        	  7499:     move.b  ($00,A4,D3.W),D0
02:0003CB96 003C0011        	  7500:     ori     #$11,CCR  ; SEC: set C+X
02:0003CB9A 12343002        	  7501:     move.b  ($02,A4,D3.W),D1
02:0003CB9E 0A3C0010        	  7502:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBA2 9101            	  7503:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBA4 0A3C0010        	  7504:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7505:     ; If the distance >= positive offset, or < negative offset;
                            	  7506:     ; then loop again.
                            	  7507:     ;
02:0003CBA8 122C0006        	  7508:     move.b  ($0006,A4),D1
02:0003CBAC B001            	  7509:     cmp.b   D1,D0
02:0003CBAE 6A16            	  7510:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CBB0 122C0007        	  7511:     move.b  ($0007,A4),D1
02:0003CBB4 B001            	  7512:     cmp.b   D1,D0
02:0003CBB6 6B0E            	  7513:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7514:     ; The distance is close enough in this axis.
                            	  7515:     ;
                            	  7516:     ; Store the distance in this axis in [05] or [04],
                            	  7517:     ; depending on the loop index.
                            	  7518:     ;
02:0003CBB8 19803004        	  7519:     move.b  D0,($04,A4,D3.W)
                            	  7520:     ; Shift [08] right, because we're in range in this axis.
                            	  7521:     ;
02:0003CBBC 122C0008        	  7522:     move.b  ($0008,A4),D1
02:0003CBC0 E209            	  7523:     lsr.b  #1,D1   ; LSR $08
02:0003CBC2 19410008        	  7524:     move.b  D1,($0008,A4)
                            	  7525:     even
                            	  7526: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CBC6 5303            	  7527:     subq.b  #1,D3
02:0003CBC8 6AC8            	  7528:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7529:     ; If close enough in both axes, then [08] will be 0.
                            	  7530:     ;
02:0003CBCA 102C0008        	  7531:     move.b  ($0008,A4),D0
02:0003CBCE 4E75            	  7532:     rts
                            	  7533: 
                            	  7534: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7535: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7536: ;
                            	  7537: ; But these are not typical direction indexes. Instead a
                            	  7538: ; 5-way index is used.
                            	  7539: ; A direction shifted right once becomes a 5-way index.
                            	  7540: ; The fourth element is unused.
                            	  7541: ;
                            	  7542:     even
                            	  7543: DodongoFrameImages:
02:0003CBD0 00              	  7544:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CBD1 01
02:0003CBD2 06
02:0003CBD3 FF
02:0003CBD4 08
02:0003CBD5 02
02:0003CBD6 03
02:0003CBD7 06
02:0003CBD8 FF              	  7545:     dc.b    $FF, $08
02:0003CBD9 08
                            	  7546: 
                            	  7547:     even
                            	  7548: DodongoFrameHFlips:
02:0003CBDA 00              	  7549:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CBDB 40
02:0003CBDC 00
02:0003CBDD FF
02:0003CBDE 00
02:0003CBDF 00
02:0003CBE0 40
02:0003CBE1 40
02:0003CBE2 FF              	  7550:     dc.b    $FF, $40
02:0003CBE3 40
                            	  7551: 
                            	  7552:     even
                            	  7553: DodongoFrameImagesBloated:
02:0003CBE4 04              	  7554:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CBE5 05
02:0003CBE6 07
02:0003CBE7 FF
02:0003CBE8 09
02:0003CBE9 04
02:0003CBEA 05
02:0003CBEB 07
02:0003CBEC FF              	  7555:     dc.b    $FF, $09
02:0003CBED 09
                            	  7556: 
                            	  7557:     even
                            	  7558: DodongoFrameHFlipsBloated:
02:0003CBEE 00              	  7559:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CBEF 40
02:0003CBF0 00
02:0003CBF1 FF
02:0003CBF2 00
02:0003CBF3 00
02:0003CBF4 40
02:0003CBF5 00
02:0003CBF6 FF              	  7560:     dc.b    $FF, $00
02:0003CBF7 00
