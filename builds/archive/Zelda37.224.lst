02:0002DE30 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002DE32 E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002DE34 1214            	   327:     move.b  ($0000,A4),D1
