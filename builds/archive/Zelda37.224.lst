                            	  3353: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3354:     ; Begin with the leever's Y set to Link's Y.
                            	  3355:     ;
02:0003ADE4 102C0084        	  3356:     move.b  ($0084,A4),D0
02:0003ADE8 41EC0084        	  3357:     lea     ($0084,A4),A0
02:0003ADEC 11802000        	  3358:     move.b  D0,(A0,D2.W)
                            	  3359:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3360:     ; it's too close to the top edge of the screen. So, return.
                            	  3361:     ;
02:0003ADF0 0C00005D        	  3362:     cmpi.b  #$5D,D0
02:0003ADF4 65EC            	  3363:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3364:     ; If facing right, then use X offset $28.
                            	  3365:     ; Else store X offset -$28 in [00].
                            	  3366:     ;
02:0003ADF6 7628            	  3367:     moveq   #40,D3
02:0003ADF8 41EC0098        	  3368:     lea     ($0098,A4),A0
02:0003ADFC 10302000        	  3369:     move.b  (A0,D2.W),D0
02:0003AE00 02000002        	  3370:     andi.b #$02,D0
02:0003AE04 6704            	  3371:     beq  _anon_z04_45
02:0003AE06 163C00D8        	  3372:     move.b  #$D8,D3
                            	  3373: _anon_z04_45:
02:0003AE0A 1883            	  3374:     move.b  D3,($0000,A4)
                            	  3375:     ; [01] holds Link's X coordinate.
                            	  3376:     ;
02:0003AE0C 102C0070        	  3377:     move.b  ($0070,A4),D0
02:0003AE10 19400001        	  3378:     move.b  D0,($0001,A4)
                            	  3379:     ; Add Link's X and the horizontal offset.
                            	  3380:     ;
02:0003AE14 023C00EE        	  3381:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE18 1214            	  3382:     move.b  ($0000,A4),D1
02:0003AE1A D101            	  3383:     addx.b  D1,D0   ; ADC $00
                            	  3384:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3385:     ;
02:0003AE1C 020000F8        	  3386:     andi.b #$F8,D0
                            	  3387:     ; Assign that result to the leever's X coordinate and [02].
                            	  3388:     ;
02:0003AE20 19802070        	  3389:     move.b  D0,($70,A4,D2.W)
02:0003AE24 19400002        	  3390:     move.b  D0,($0002,A4)
                            	  3391:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3392:     ;
02:0003AE28 122C0001        	  3393:     move.b  ($0001,A4),D1
02:0003AE2C B001            	  3394:     cmp.b   D1,D0
02:0003AE2E 6510            	  3395:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003AE30 1B00            	  3396:     move.b  D0,-(A5)  ; PHA
02:0003AE32 102C0001        	  3397:     move.b  ($0001,A4),D0
02:0003AE36 19400002        	  3398:     move.b  D0,($0002,A4)
02:0003AE3A 101D            	  3399:     move.b  (A5)+,D0  ; PLA
02:0003AE3C 19400001        	  3400:     move.b  D0,($0001,A4)
                            	  3401:     even
                            	  3402: _L_z04_UpdateRedLeever_Subtract:
                            	  3403:     ; The point is to get the absolute distance between the two.
                            	  3404:     ;
02:0003AE40 102C0001        	  3405:     move.b  ($0001,A4),D0
02:0003AE44 003C0011        	  3406:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE48 122C0002        	  3407:     move.b  ($0002,A4),D1
02:0003AE4C 0A3C0010        	  3408:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE50 9101            	  3409:     subx.b  D1,D0   ; SBC $02
02:0003AE52 0A3C0010        	  3410:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3411:     ; If the absolute distance >= $30, then return.
                            	  3412:     ; It means that the leever's X coordinate wrapped around
                            	  3413:     ; the left or right edge of the screen.
                            	  3414:     ;
02:0003AE56 0C000030        	  3415:     cmpi.b  #$30,D0
02:0003AE5A 6486            	  3416:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3417:     even
                            	  3418: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3419:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3420:     ;
02:0003AE5C 4EB90004B974    	  3421:     jsr     GetCollidableTileStill
02:0003AE62 122C034A        	  3422:     move.b  ($034A,A4),D1
02:0003AE66 B001            	  3423:     cmp.b   D1,D0
02:0003AE68 6400FF78        	  3424:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AE6C 522C0510        	  3425:     addq.b  #1,($0510,A4)
                            	  3426:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3427:     ; and pick up whatever the new value is for state 1.
                            	  3428:     ;
02:0003AE70 7001            	  3429:     moveq   #1,D0
02:0003AE72 41EC03D0        	  3430:     lea     ($03D0,A4),A0
02:0003AE76 11802000        	  3431:     move.b  D0,(A0,D2.W)
                            	  3432:     ; Set the long timer to 2, meaning 20 frames.
                            	  3433:     ;
02:0003AE7A E308            	  3434:     lsl.b  #1,D0   ; ASL A
02:0003AE7C 1940004D        	  3435:     move.b  D0,($004D,A4)
02:0003AE80 6100008C        	  3436:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3437:     ; The leever has to face Link in order to move toward him.
                            	  3438:     ;
02:0003AE84 4EB90004C102    	  3439:     jsr     ReverseObjDir
                            	  3440:     even
