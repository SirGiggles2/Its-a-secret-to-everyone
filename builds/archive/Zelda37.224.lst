                            	  8528:     ; Normally, turn to the direction that's perpendicular to object
                            	  8529:     ; direction. But keep going straight after that, while diagonal
                            	  8530:     ; input is held.
                            	  8531:     ;
                            	  8532:     ; Handle special cases for doors.
                            	  8533:     ;
                            	  8534:     ;
                            	  8535:     ; 1. Link at horizontal doors.
                            	  8536:     ;
                            	  8537:     ; If Link's X = $20 or $D0 then
