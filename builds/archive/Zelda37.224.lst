                            	 11950: _L_z04_UpdateLamnola_FindTail:
02:0003ECF2 5203            	 11951:     addq.b  #1,D3
02:0003ECF4 41EC0350        	 11952:     lea     ($0350,A4),A0
02:0003ECF8 10303000        	 11953:     move.b  (A0,D3.W),D0
02:0003ECFC 122C04E7        	 11954:     move.b  ($04E7,A4),D1
02:0003ED00 B001            	 11955:     cmp.b   D1,D0
02:0003ED02 66EE            	 11956:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11957:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11958:     ;
02:0003ED04 7011            	 11959:     moveq   #17,D0
02:0003ED06 19803029        	 11960:     move.b  D0,($29,A4,D3.W)
                            	 11961:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11962:     ; to the tail segment.
