02:0003A724 11802000        	  2405:     move.b  D0,(A0,D2.W)
                            	  2406:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2407:     ;
02:0003A728 6728            	  2408:     beq  _L_z04__TryShooting_SetSpeed
                            	  2409:     ; shoot timer <> 0
                            	  2410:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2411:     ;
