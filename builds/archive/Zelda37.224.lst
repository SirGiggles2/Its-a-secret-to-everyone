02:000435D0 6510            	  5500:     bcs  _anon_z05_106
02:000435D2 7600            	  5501:     moveq   #0,D3
02:000435D4 162C00EB        	  5502:     move.b  ($00EB,A4),D3
02:000435D8 41F900FF68FE    	  5503:     lea     (NES_SRAM+$08FE).l,A0
02:000435DE 10303000        	  5504:     move.b  (A0,D3.W),D0
