                            	 10283:     ; on the left side.
                            	 10284:     ;
02:0003E056 003C0011        	 10285:     ori     #$11,CCR  ; SEC: set C+X
02:0003E05A 123C0010        	 10286:     move.b  #$10,D1
02:0003E05E 0A3C0010        	 10287:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E062 9101            	 10288:     subx.b  D1,D0   ; SBC #$10
02:0003E064 0A3C0010        	 10289:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E068 19802070        	 10290:     move.b  D0,($70,A4,D2.W)
                            	 10291:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10292:     ; from left to right, indexed by [0F].
                            	 10293:     ;
02:0003E06C 7005            	 10294:     moveq   #5,D0
02:0003E06E 1940000F        	 10295:     move.b  D0,($000F,A4)
