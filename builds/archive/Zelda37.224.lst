02:00030262 660000B2        	  3162:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  3163:     ; State 0. Sensing.
                            	  3164:     ;
                            	  3165:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  3166:     ; then go see if the horizontal distance is shorter.
                            	  3167:     ;
02:00030266 102C0084        	  3168:     move.b  ($0084,A4),D0
