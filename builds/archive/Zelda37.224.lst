                            	  2791: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2792:     ; State 1. Jumping.
                            	  2793:     ;
                            	  2794:     ; Keep the object inside the bounds of the room.
                            	  2795:     ;
02:0003A9A0 610052E6        	  2796:     jsr     BoundFlyer
                            	  2797:     ; If the object was blocked at the room boundary, then
                            	  2798:     ; increase boundary reversal count, and go set up another jump.
                            	  2799:     ;
02:0003A9A4 102C000F        	  2800:     move.b  ($000F,A4),D0
02:0003A9A8 660C            	  2801:     bne  _anon_z04_37
02:0003A9AA 41EC0451        	  2802:     lea     ($0451,A4),A0
02:0003A9AE 52302000        	  2803:     addq.b  #1,(A0,D2.W)
02:0003A9B2 6000FF74        	  2804:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2805: 
                            	  2806: _anon_z04_37:
02:0003A9B6 61000196        	  2807:     jsr     Jumper_PointBoulderDownward
                            	  2808:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2809:     ;
02:0003A9BA 7000            	  2810:     moveq   #0,D0
02:0003A9BC 41EC0451        	  2811:     lea     ($0451,A4),A0
02:0003A9C0 11802000        	  2812:     move.b  D0,(A0,D2.W)
                            	  2813:     ; Get the base offset for the kind of jumper the object is.
                            	  2814:     ;
02:0003A9C4 6100015E        	  2815:     jsr     Jumper_GetKind
02:0003A9C8 41F90003A8B4    	  2816:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003A9CE 10303000        	  2817:     move.b  (A0,D3.W),D0
                            	  2818:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2819:     ;
                            	  2820:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2821:     ; does not have $B elements like the tektites' sets.
                            	  2822:     ;
                            	  2823:     ; Boulder does not need the upward accelerations.
                            	  2824:     ; So, the elements for those are used for the starting speeds
                            	  2825:     ; at 04:88F2.
                            	  2826:     ;
