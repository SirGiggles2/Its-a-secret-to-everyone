                            	  9795: Manhandla_Move:
                            	  9796:     ; Implement a way of manifesting the fractional part of the speed
                            	  9797:     ; in the movement.
                            	  9798:     ;
                            	  9799:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9800:     ; byte to add to the coordinates, then the effective speed would
                            	  9801:     ; be 1 pixel a frame instead of 1.25.
                            	  9802:     ;
                            	  9803:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9804:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9805:     ;
                            	  9806:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9807:     ;
                            	  9808:     ;   SA := SA + (SL AND $E0)
                            	  9809:     ;   [03] := SH + carry
                            	  9810:     ;
                            	  9811:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9812:     ;
02:0003DC9A 41EC041F        	  9813:     lea     ($041F,A4),A0
02:0003DC9E 10302000        	  9814:     move.b  (A0,D2.W),D0
02:0003DCA2 020000E0        	  9815:     andi.b #$E0,D0
02:0003DCA6 023C00EE        	  9816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCAA 41EC0412        	  9817:     lea     ($0412,A4),A0
02:0003DCAE 12302000        	  9818:     move.b  (A0,D2.W),D1
02:0003DCB2 D101            	  9819:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DCB4 41EC0412        	  9820:     lea     ($0412,A4),A0
02:0003DCB8 11802000        	  9821:     move.b  D0,(A0,D2.W)
                            	  9822:     ; Assign (high speed byte + carry) to [03].
                            	  9823:     ;
02:0003DCBC 41EC042C        	  9824:     lea     ($042C,A4),A0
02:0003DCC0 10302000        	  9825:     move.b  (A0,D2.W),D0
02:0003DCC4 123C0000        	  9826:     move.b  #$00,D1
02:0003DCC8 D101            	  9827:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCCA 19400003        	  9828:     move.b  D0,($0003,A4)
                            	  9829:     ; Change coordinates by the speed amount/offset in [03]
                            	  9830:     ; according to the direction.
                            	  9831:     ;
                            	  9832:     ; Start with a mask of $A1 in [02]:
                            	  9833:     ; - low nibble represents the right direction
                            	  9834:     ; - high nibble is used to set or clear carry as we go along
                            	  9835:     ;
02:0003DCCE 103C00A1        	  9836:     move.b  #$A1,D0
02:0003DCD2 19400002        	  9837:     move.b  D0,($0002,A4)
                            	  9838:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9839:     ;
02:0003DCD6 41EC0098        	  9840:     lea     ($0098,A4),A0
02:0003DCDA 10302000        	  9841:     move.b  (A0,D2.W),D0
02:0003DCDE 122C0002        	  9842:     move.b  ($0002,A4),D1
02:0003DCE2 C200            	  9843:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCE4 6712            	  9844:     beq  _L_z04_Manhandla_Move_Left
02:0003DCE6 10342070        	  9845:     move.b  ($70,A4,D2.W),D0
02:0003DCEA 023C00EE        	  9846:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCEE 122C0003        	  9847:     move.b  ($0003,A4),D1
02:0003DCF2 D101            	  9848:     addx.b  D1,D0   ; ADC $03
02:0003DCF4 19802070        	  9849:     move.b  D0,($70,A4,D2.W)
                            	  9850:     even
                            	  9851: _L_z04_Manhandla_Move_Left:
                            	  9852:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9853:     ;
02:0003DCF8 41EC0098        	  9854:     lea     ($0098,A4),A0
02:0003DCFC 10302000        	  9855:     move.b  (A0,D2.W),D0
02:0003DD00 122C0002        	  9856:     move.b  ($0002,A4),D1
02:0003DD04 E309            	  9857:     lsl.b  #1,D1   ; ASL $02
02:0003DD06 19410002        	  9858:     move.b  D1,($0002,A4)
02:0003DD0A 122C0002        	  9859:     move.b  ($0002,A4),D1
02:0003DD0E C200            	  9860:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD10 6716            	  9861:     beq  _L_z04_Manhandla_Move_Down
02:0003DD12 10342070        	  9862:     move.b  ($70,A4,D2.W),D0
02:0003DD16 122C0003        	  9863:     move.b  ($0003,A4),D1
02:0003DD1A 0A3C0010        	  9864:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD1E 9101            	  9865:     subx.b  D1,D0   ; SBC $03
02:0003DD20 0A3C0010        	  9866:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD24 19802070        	  9867:     move.b  D0,($70,A4,D2.W)
                            	  9868:     even
                            	  9869: _L_z04_Manhandla_Move_Down:
                            	  9870:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9871:     ;
02:0003DD28 41EC0098        	  9872:     lea     ($0098,A4),A0
02:0003DD2C 10302000        	  9873:     move.b  (A0,D2.W),D0
02:0003DD30 122C0002        	  9874:     move.b  ($0002,A4),D1
02:0003DD34 E309            	  9875:     lsl.b  #1,D1   ; ASL $02
02:0003DD36 19410002        	  9876:     move.b  D1,($0002,A4)
02:0003DD3A 122C0002        	  9877:     move.b  ($0002,A4),D1
02:0003DD3E C200            	  9878:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD40 6716            	  9879:     beq  _L_z04_Manhandla_Move_Up
02:0003DD42 41EC0084        	  9880:     lea     ($0084,A4),A0
02:0003DD46 10302000        	  9881:     move.b  (A0,D2.W),D0
02:0003DD4A 122C0003        	  9882:     move.b  ($0003,A4),D1
02:0003DD4E D101            	  9883:     addx.b  D1,D0   ; ADC $03
02:0003DD50 41EC0084        	  9884:     lea     ($0084,A4),A0
02:0003DD54 11802000        	  9885:     move.b  D0,(A0,D2.W)
                            	  9886:     even
                            	  9887: _L_z04_Manhandla_Move_Up:
                            	  9888:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9889:     ;
02:0003DD58 41EC0098        	  9890:     lea     ($0098,A4),A0
02:0003DD5C 10302000        	  9891:     move.b  (A0,D2.W),D0
02:0003DD60 122C0002        	  9892:     move.b  ($0002,A4),D1
02:0003DD64 E309            	  9893:     lsl.b  #1,D1   ; ASL $02
02:0003DD66 19410002        	  9894:     move.b  D1,($0002,A4)
02:0003DD6A 122C0002        	  9895:     move.b  ($0002,A4),D1
02:0003DD6E C200            	  9896:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD70 671E            	  9897:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD72 41EC0084        	  9898:     lea     ($0084,A4),A0
02:0003DD76 10302000        	  9899:     move.b  (A0,D2.W),D0
02:0003DD7A 122C0003        	  9900:     move.b  ($0003,A4),D1
02:0003DD7E 0A3C0010        	  9901:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD82 9101            	  9902:     subx.b  D1,D0   ; SBC $03
02:0003DD84 0A3C0010        	  9903:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD88 41EC0084        	  9904:     lea     ($0084,A4),A0
02:0003DD8C 11802000        	  9905:     move.b  D0,(A0,D2.W)
                            	  9906:     even
                            	  9907: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9908:     ; To the frame accumulator, add:
                            	  9909:     ; - a random value between 0 and 3
                            	  9910:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9911:     ;
02:0003DD90 10342019        	  9912:     move.b  ($19,A4,D2.W),D0
02:0003DD94 02000003        	  9913:     andi.b #$03,D0
02:0003DD98 023C00EE        	  9914:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD9C 122C0003        	  9915:     move.b  ($0003,A4),D1
02:0003DDA0 D101            	  9916:     addx.b  D1,D0   ; ADC $03
02:0003DDA2 41EC0451        	  9917:     lea     ($0451,A4),A0
02:0003DDA6 12302000        	  9918:     move.b  (A0,D2.W),D1
02:0003DDAA D101            	  9919:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DDAC 41EC0451        	  9920:     lea     ($0451,A4),A0
02:0003DDB0 11802000        	  9921:     move.b  D0,(A0,D2.W)
02:0003DDB4 61001ED2        	  9922:     jsr     BoundFlyer
                            	  9923:     ; TODO:
                            	  9924:     ; I don't see why this is needed.
                            	  9925:     ;
02:0003DDB8 4EF90004D222    	  9926:     jmp     Anim_FetchObjPosForSpriteDescriptor
