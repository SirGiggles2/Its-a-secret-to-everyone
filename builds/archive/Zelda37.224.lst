                            	  8471: ; Description:
                            	  8472: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8473: ; When walking, the object timer is set. When teleporting,
                            	  8474: ; the teleporting distance remaining is set.
                            	  8475: ;
                            	  8476: ; If we have the magic clock, then only go draw and check collisions.
                            	  8477: ;
                            	  8478:     even
                            	  8479: UpdateBlueWizzrobe:
02:0003D302 102C066C        	  8480:     move.b  ($066C,A4),D0
