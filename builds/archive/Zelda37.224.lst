                            	 12267:     ;
02:0003EF02 41EC0098        	 12268:     lea     ($0098,A4),A0
02:0003EF06 10302000        	 12269:     move.b  (A0,D2.W),D0
02:0003EF0A 122C0002        	 12270:     move.b  ($0002,A4),D1
02:0003EF0E E309            	 12271:     lsl.b  #1,D1   ; ASL $02
02:0003EF10 19410002        	 12272:     move.b  D1,($0002,A4)
02:0003EF14 122C0002        	 12273:     move.b  ($0002,A4),D1
02:0003EF18 C200            	 12274:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF1A 6716            	 12275:     beq  _L_z04_Lamnola_Move_Down
02:0003EF1C 10342070        	 12276:     move.b  ($70,A4,D2.W),D0
02:0003EF20 122C04E6        	 12277:     move.b  ($04E6,A4),D1
02:0003EF24 0A3C0010        	 12278:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EF28 9101            	 12279:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EF2A 0A3C0010        	 12280:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF2E 19802070        	 12281:     move.b  D0,($70,A4,D2.W)
                            	 12282:     even
