                            	  3282: _anon_z04_42:
                            	  3283:     ; State 0.
                            	  3284:     ;
                            	  3285:     ; In state we determine whether to burst out of the ground.
                            	  3286:     ; If the long timer has not expired, then return.
                            	  3287:     ;
02:0003AD68 102C004D        	  3288:     move.b  ($004D,A4),D0
02:0003AD6C 6674            	  3289:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3290:     ; Only allow two red leevers at a time.
                            	  3291:     ;
02:0003AD6E 102C0510        	  3292:     move.b  ($0510,A4),D0
02:0003AD72 0C000002        	  3293:     cmpi.b  #$02,D0
02:0003AD76 646A            	  3294:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3295:     ; Face in the same direction as Link.
                            	  3296:     ;
02:0003AD78 102C0098        	  3297:     move.b  ($0098,A4),D0
02:0003AD7C 41EC0098        	  3298:     lea     ($0098,A4),A0
02:0003AD80 11802000        	  3299:     move.b  D0,(A0,D2.W)
                            	  3300:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3301:     ;
02:0003AD84 10342019        	  3302:     move.b  ($19,A4,D2.W),D0
02:0003AD88 0C0000C0        	  3303:     cmpi.b  #$C0,D0
02:0003AD8C 6506            	  3304:     bcs  _anon_z04_43
02:0003AD8E 4EB90004C102    	  3305:     jsr     ReverseObjDir
                            	  3306: _anon_z04_43:
                            	  3307:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3308:     ;
02:0003AD94 41EC0098        	  3309:     lea     ($0098,A4),A0
02:0003AD98 10302000        	  3310:     move.b  (A0,D2.W),D0
02:0003AD9C 0200000C        	  3311:     andi.b #$0C,D0
02:0003ADA0 6742            	  3312:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3313:     ; Begin with the leever's X set to Link's X.
                            	  3314:     ;
02:0003ADA2 102C0070        	  3315:     move.b  ($0070,A4),D0
02:0003ADA6 19802070        	  3316:     move.b  D0,($70,A4,D2.W)
                            	  3317:     ; If facing down, then use Y offset $28.
                            	  3318:     ; Else store Y offset -$28 in [00].
                            	  3319:     ;
02:0003ADAA 7628            	  3320:     moveq   #40,D3
02:0003ADAC 41EC0098        	  3321:     lea     ($0098,A4),A0
02:0003ADB0 10302000        	  3322:     move.b  (A0,D2.W),D0
02:0003ADB4 02000008        	  3323:     andi.b #$08,D0
02:0003ADB8 6704            	  3324:     beq  _anon_z04_44
02:0003ADBA 163C00D8        	  3325:     move.b  #$D8,D3
                            	  3326: _anon_z04_44:
02:0003ADBE 1883            	  3327:     move.b  D3,($0000,A4)
                            	  3328:     ; Add Link's Y and the vertical offset.
                            	  3329:     ;
02:0003ADC0 102C0084        	  3330:     move.b  ($0084,A4),D0
02:0003ADC4 023C00EE        	  3331:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADC8 1214            	  3332:     move.b  ($0000,A4),D1
02:0003ADCA D101            	  3333:     addx.b  D1,D0   ; ADC $00
                            	  3334:     ; Sanitize the Y coordinate:
                            	  3335:     ; (Y AND $F0) OR $D
                            	  3336:     ;
02:0003ADCC 020000F0        	  3337:     andi.b #$F0,D0
02:0003ADD0 0000000D        	  3338:     ori.b #$0D,D0
02:0003ADD4 41EC0084        	  3339:     lea     ($0084,A4),A0
02:0003ADD8 11802000        	  3340:     move.b  D0,(A0,D2.W)
                            	  3341:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3342:     ; go see if the tile is valid to come out of.
                            	  3343:     ;
                            	  3344:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3345:     ;
02:0003ADDC 0C00005D        	  3346:     cmpi.b  #$5D,D0
02:0003ADE0 647A            	  3347:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3348:     even
                            	  3349: _L_z04_UpdateRedLeever_Exit:
02:0003ADE2 4E75            	  3350:     rts
                            	  3351: 
