02:0003C2F8 10302000        	  6328:     move.b  (A0,D2.W),D0
02:0003C2FC 0C000004        	  6329:     cmpi.b  #$04,D0
02:0003C300 659E            	  6330:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
