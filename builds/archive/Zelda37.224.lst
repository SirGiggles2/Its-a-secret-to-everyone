02:0002DE1A 102C0002        	   313:     move.b  ($0002,A4),D0
02:0002DE1E E208            	   314:     lsr.b  #1,D0   ; LSR A
02:0002DE20 E208            	   315:     lsr.b  #1,D0   ; LSR A
02:0002DE22 E208            	   316:     lsr.b  #1,D0   ; LSR A
02:0002DE24 E208            	   317:     lsr.b  #1,D0   ; LSR A
02:0002DE26 1214            	   318:     move.b  ($0000,A4),D1
02:0002DE28 8001            	   319:     or.b  D1,D0
02:0002DE2A 1880            	   320:     move.b  D0,($0000,A4)
                            	   321:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
