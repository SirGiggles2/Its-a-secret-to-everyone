                            	  6875:     ; If heart partial >= low damage points byte, then simply
                            	  6876:     ; subtract the damage byte from heart partial.
                            	  6877:     ; Else go borrow from full hearts.
                            	  6878:     ;
02:00031D1C 102C0670        	  6879:     move.b  ($0670,A4),D0
02:00031D20 122C000E        	  6880:     move.b  ($000E,A4),D1
02:00031D24 B001            	  6881:     cmp.b   D1,D0
02:00031D26 6546            	  6882:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:00031D28 003C0011        	  6883:     ori     #$11,CCR  ; SEC: set C+X
02:00031D2C 122C000E        	  6884:     move.b  ($000E,A4),D1
