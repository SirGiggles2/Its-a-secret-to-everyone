02:0003E780 102C04D7        	 11247:     move.b  ($04D7,A4),D0
02:0003E784 E308            	 11248:     lsl.b  #1,D0   ; ASL A
02:0003E786 E308            	 11249:     lsl.b  #1,D0   ; ASL A
02:0003E788 E308            	 11250:     lsl.b  #1,D0   ; ASL A
02:0003E78A 7600            	 11251:     moveq   #0,D3
02:0003E78C 1600            	 11252:     move.b  D0,D3
02:0003E78E 103C00F8        	 11253:     move.b  #$F8,D0
02:0003E792 41EC0200        	 11254:     lea     ($0200,A4),A0
02:0003E796 11803000        	 11255:     move.b  D0,(A0,D3.W)
02:0003E79A 41EC0220        	 11256:     lea     ($0220,A4),A0
02:0003E79E 11803000        	 11257:     move.b  D0,(A0,D3.W)
                            	 11258:     ; Add the bit for this neck to the dead neck mask.
                            	 11259:     ; Copy it to [00].
                            	 11260:     ;
02:0003E7A2 7600            	 11261:     moveq   #0,D3
02:0003E7A4 162C04D7        	 11262:     move.b  ($04D7,A4),D3
02:0003E7A8 41F90004ADB2    	 11263:     lea     (LevelMasks).l,A0
02:0003E7AE 10303000        	 11264:     move.b  (A0,D3.W),D0
02:0003E7B2 122C0511        	 11265:     move.b  ($0511,A4),D1
02:0003E7B6 8001            	 11266:     or.b  D1,D0
02:0003E7B8 19400511        	 11267:     move.b  D0,($0511,A4)
02:0003E7BC 1880            	 11268:     move.b  D0,($0000,A4)
                            	 11269:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11270:     ; Count them up, and store the amount in [00].
                            	 11271:     ;
02:0003E7BE 7000            	 11272:     moveq   #0,D0
02:0003E7C0 7604            	 11273:     moveq   #4,D3
                            	 11274: _anon_z04_143:
02:0003E7C2 1214            	 11275:     move.b  ($0000,A4),D1
02:0003E7C4 E209            	 11276:     lsr.b  #1,D1   ; LSR $00
02:0003E7C6 1881            	 11277:     move.b  D1,($0000,A4)
02:0003E7C8 123C0000        	 11278:     move.b  #$00,D1
02:0003E7CC D101            	 11279:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E7CE 5303            	 11280:     subq.b  #1,D3
02:0003E7D0 66F0            	 11281:     bne  _anon_z04_143
02:0003E7D2 1880            	 11282:     move.b  D0,($0000,A4)
                            	 11283:     ; Compare the number of dead necks to the original number
                            	 11284:     ; (object type - $41).
                            	 11285:     ;
02:0003E7D4 102C0350        	 11286:     move.b  ($0350,A4),D0
02:0003E7D8 003C0011        	 11287:     ori     #$11,CCR  ; SEC: set C+X
02:0003E7DC 123C0041        	 11288:     move.b  #$41,D1
02:0003E7E0 0A3C0010        	 11289:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E7E4 9101            	 11290:     subx.b  D1,D0   ; SBC #$41
02:0003E7E6 0A3C0010        	 11291:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E7EA 1214            	 11292:     move.b  ($0000,A4),D1
02:0003E7EC B001            	 11293:     cmp.b   D1,D0
                            	 11294:     ; If they're equal, then go handle the whole boss dying.
