                            	 12459: __far_z_04_0125:
                            	 12460:     ; State = 0.
                            	 12461:     ;
                            	 12462:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12463:     ; This is the only patra child shown in the first fame.
                            	 12464:     ;
02:0003F082 0C020002        	 12465:     cmpi.b  #$02,D2
02:0003F086 6732            	 12466:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12467:     ; The patra child in slot 2 is the last one to be updated.
                            	 12468:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12469:     ;
                            	 12470:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12471:     ; shown.
                            	 12472:     ;
02:0003F088 102C00AE        	 12473:     move.b  ($00AE,A4),D0
02:0003F08C 6700008E        	 12474:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12475:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12476:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12477:     ;
02:0003F090 1002            	 12478:     move.b  D2,D0
                            	 12479:     ; Subtract 3 from the object slot to get the angle where the
                            	 12480:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12481:     ;
02:0003F092 003C0011        	 12482:     ori     #$11,CCR  ; SEC: set C+X
02:0003F096 123C0003        	 12483:     move.b  #$03,D1
02:0003F09A 0A3C0010        	 12484:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F09E 9101            	 12485:     subx.b  D1,D0   ; SBC #$03
02:0003F0A0 0A3C0010        	 12486:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0A4 7600            	 12487:     moveq   #0,D3
02:0003F0A6 1600            	 12488:     move.b  D0,D3
                            	 12489:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12490:     ; then return.
                            	 12491:     ;
02:0003F0A8 102C0396        	 12492:     move.b  ($0396,A4),D0
02:0003F0AC 41F90003F066    	 12493:     lea     (PatraChildStartAngles).l,A0
02:0003F0B2 12303000        	 12494:     move.b  (A0,D3.W),D1
02:0003F0B6 B001            	 12495:     cmp.b   D1,D0
02:0003F0B8 6662            	 12496:     bne  _L_z04_UpdatePatraChild_Exit
