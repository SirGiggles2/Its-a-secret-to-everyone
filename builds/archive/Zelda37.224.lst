02:0003F49C 610000B4        	 13064:     jsr     Ganon_GetCurCloudBottom
02:0003F4A0 6190            	 13065:     jsr     Ganon_DrawCloud
02:0003F4A2 610000A2        	 13066:     jsr     Ganon_GetCurCloudRight
02:0003F4A6 618A            	 13067:     jsr     Ganon_DrawCloud
                            	 13068:     ; Draw the top and bottom clouds.
                            	 13069:     ;
02:0003F4A8 10342070        	 13070:     move.b  ($70,A4,D2.W),D0
02:0003F4AC 1880            	 13071:     move.b  D0,($0000,A4)
02:0003F4AE 6100009C        	 13072:     jsr     Ganon_GetCurCloudTop
02:0003F4B2 6100FF7E        	 13073:     jsr     Ganon_DrawCloud
02:0003F4B6 6100009A        	 13074:     jsr     Ganon_GetCurCloudBottom
02:0003F4BA 6100FF76        	 13075:     jsr     Ganon_DrawCloud
                            	 13076:     ; Draw the left and right clouds.
                            	 13077:     ;
02:0003F4BE 61000080        	 13078:     jsr     Ganon_GetCurCloudLeft
02:0003F4C2 41EC0084        	 13079:     lea     ($0084,A4),A0
02:0003F4C6 10302000        	 13080:     move.b  (A0,D2.W),D0
02:0003F4CA 19400001        	 13081:     move.b  D0,($0001,A4)
02:0003F4CE 6100FF62        	 13082:     jsr     Ganon_DrawCloud
02:0003F4D2 6172            	 13083:     jsr     Ganon_GetCurCloudRight
02:0003F4D4 6100FF5C        	 13084:     jsr     Ganon_DrawCloud
                            	 13085:     ; Save the object index.
                            	 13086:     ;
02:0003F4D8 102C0340        	 13087:     move.b  ($0340,A4),D0
02:0003F4DC 1B00            	 13088:     move.b  D0,-(A5)  ; PHA
                            	 13089:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 13090:     ;
02:0003F4DE 7402            	 13091:     moveq   #2,D2
                            	 13092:     even
                            	 13093: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F4E0 19420340        	 13094:     move.b  D2,($0340,A4)
                            	 13095:     ; If object slot < 5 or = 7, then move every frame.
                            	 13096:     ; Else move 3 out of every 4 frames.
                            	 13097:     ;
                            	 13098:     ; This makes pieces spread out in somewhat of a circle,
                            	 13099:     ; by making the pieces at cardinal directions move at
                            	 13100:     ; full speed while the diagonal ones move a little slower.
                            	 13101:     ;
02:0003F4E4 0C020005        	 13102:     cmpi.b  #$05,D2
02:0003F4E8 6510            	 13103:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F4EA 0C020007        	 13104:     cmpi.b  #$07,D2
02:0003F4EE 670A            	 13105:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F4F0 102C0015        	 13106:     move.b  ($0015,A4),D0
02:0003F4F4 02000003        	 13107:     andi.b #$03,D0
02:0003F4F8 6704            	 13108:     beq  _anon_z04_164
                            	 13109:     even
                            	 13110: _L_z04_Ganon_DrawBurst_Move:
02:0003F4FA 6100DF60        	 13111:     jsr     BlueWizzrobe_Move
                            	 13112: _anon_z04_164:
02:0003F4FE 4EB90004D222    	 13113:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 13114:     ; The frame counter will make the sprite flash.
                            	 13115:     ; The array has the horizontal and vertical flipping attributes.
                            	 13116:     ; Combine them into [03].
                            	 13117:     ;
02:0003F504 102C0015        	 13118:     move.b  ($0015,A4),D0
02:0003F508 02000003        	 13119:     andi.b #$03,D0
02:0003F50C 41F90003F3DC    	 13120:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F512 12302000        	 13121:     move.b  (A0,D2.W),D1
02:0003F516 8001            	 13122:     or.b  D1,D0
02:0003F518 19400003        	 13123:     move.b  D0,($0003,A4)
02:0003F51C 41F90003F3E6    	 13124:     lea     (GanonBurstTiles).l,A0
02:0003F522 10302000        	 13125:     move.b  (A0,D2.W),D0
02:0003F526 4EB9000319B0    	 13126:     jsr     Anim_WriteSprite
                            	 13127:     ; Bottom of the loop.
                            	 13128:     ; Increment object slot while <= 9.
                            	 13129:     ;
02:0003F52C 5202            	 13130:     addq.b  #1,D2
02:0003F52E 0C02000A        	 13131:     cmpi.b  #$0A,D2
02:0003F532 65AC            	 13132:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 13133:     ; Restore the object index.
                            	 13134:     ;
02:0003F534 101D            	 13135:     move.b  (A5)+,D0  ; PLA
02:0003F536 19400340        	 13136:     move.b  D0,($0340,A4)
02:0003F53A 0A3C0001        	 13137:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F53E 4E75            	 13138:     rts
                            	 13139: 
                            	 13140: ; Returns:
                            	 13141: ; [00]: X coordinate
                            	 13142: ;
                            	 13143:     even
