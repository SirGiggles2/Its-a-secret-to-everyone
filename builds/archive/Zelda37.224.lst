02:00031034 10302000        	  5280:     move.b  (A0,D2.W),D0
02:00031038 6BDC            	  5281:     bmi  _anon_z01_63
                            	  5282:     ; Pass RoomItemId, also known as [98][$13] and ObjDir[$13],
                            	  5283:     ; to try to take the item.
                            	  5284:     ;
02:0003103A 41EC0098        	  5285:     lea     ($0098,A4),A0
02:0003103E 10302000        	  5286:     move.b  (A0,D2.W),D0
02:00031042 19400004        	  5287:     move.b  D0,($0004,A4)
                            	  5288: ; Params:
                            	  5289: ; X: object index
                            	  5290: ; [04]: item type
                            	  5291: ;
                            	  5292: ;
                            	  5293: ; If the lifetime timer of the item >= $F0, then return;
                            	  5294: ; so that the player can't pick it up right away.
                            	  5295: ;
                            	  5296: ; [03A8][X] is used to count down the life of the item.
                            	  5297:     even
