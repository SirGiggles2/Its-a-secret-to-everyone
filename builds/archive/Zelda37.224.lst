                            	  7554: ChangePlayMapSquareOW:
02:000446C4 1002            	  7555:     move.b  D2,D0
02:000446C6 1B00            	  7556:     move.b  D0,-(A5)  ; PHA
                            	  7557:     ; We're dealing with squares.
                            	  7558:     ; So, align the object's X coordinate with 16 pixels.
                            	  7559:     ;
02:000446C8 10342070        	  7560:     move.b  ($70,A4,D2.W),D0
02:000446CC 020000F0        	  7561:     andi.b #$F0,D0
                            	  7562:     ; Divide it by 4 to get the offset of the address of the column
                            	  7563:     ; in play area map.
                            	  7564:     ;
                            	  7565:     ; The calculation is: address offset = (X / 8) * 2
                            	  7566:     ; 8 for the width of the column; 2 for the width of the address
                            	  7567:     ;
02:000446D0 E208            	  7568:     lsr.b  #1,D0   ; LSR A
02:000446D2 E208            	  7569:     lsr.b  #1,D0   ; LSR A
02:000446D4 7400            	  7570:     moveq   #0,D2
02:000446D6 1400            	  7571:     move.b  D0,D2
                            	  7572:     ; Store the address of the column in [00:01].
                            	  7573:     ;
02:000446D8 41F90004A91A    	  7574:     lea     (PlayAreaColumnAddrs).l,A0
02:000446DE 10302000        	  7575:     move.b  (A0,D2.W),D0
