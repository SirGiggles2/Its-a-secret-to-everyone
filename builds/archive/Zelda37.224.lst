                            	  4328: 
                            	  4329: ; To be considered within a doorway, one condition is that
                            	  4330: ; Link's perpendicular coordinate ([00]) has to match the doorway's
                            	  4331: ; (X=$78 for verticals, Y=$8D for horizontals).
                            	  4332: ;
                            	  4333: ; See GetPlayerCoordsForDirection.
                            	  4334: ;
                            	  4335:     even
                            	  4336: DoorwayRequiredCoord:
02:00042348 78              	  4337:     dc.b    $78, $78, $8D, $8D
02:00042349 78
02:0004234A 8D
02:0004234B 8D
                            	  4338: 
                            	  4339: ; Player coordinate must be >= these bounds.
                            	  4340: ; Using these bounds; the player will be considered within the
                            	  4341: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4342: ;
                            	  4343:     even
                            	  4344: DoorwayBoundsMinOver:
02:0004234C 3D              	  4345:     dc.b    $3D, $BD, $00, $CF
02:0004234D BD
02:0004234E 00
02:0004234F CF
                            	  4346: 
                            	  4347: ; Player coordinate must be < these bounds.
                            	  4348: ; Using these bounds; the player will be considered within the
                            	  4349: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4350: ;
                            	  4351:     even
                            	  4352: DoorwayBoundsMaxOver:
02:00042350 5E              	  4353:     dc.b    $5E, $DE, $21, $F1
02:00042351 DE
02:00042352 21
02:00042353 F1
                            	  4354: 
                            	  4355: ; Player coordinate must be >= these bounds.
                            	  4356: ; Using these bounds; the player will be considered within the
                            	  4357: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4358: ; at the edge.
                            	  4359: ;
                            	  4360:     even
                            	  4361: DoorwayBoundsMinUnder:
02:00042354 3D              	  4362:     dc.b    $3D, $BF, $00, $D2
02:00042355 BF
02:00042356 00
02:00042357 D2
                            	  4363: 
                            	  4364: ; Player coordinate must be < these bounds.
                            	  4365: ; Using these bounds; the player will be considered within the
                            	  4366: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4367: ; at the edge.
                            	  4368: ;
                            	  4369:     even
                            	  4370: DoorwayBoundsMaxUnder:
02:00042358 5C              	  4371:     dc.b    $5C, $DE, $1F, $F1
02:00042359 DE
02:0004235A 1F
02:0004235B F1
                            	  4372: 
                            	  4373: ; Params:
                            	  4374: ; [0F]: moving direction
                            	  4375: ;
                            	  4376: ; Returns:
                            	  4377: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4378: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4379: ;
                            	  4380: ; When not at or in a doorway, this function leaves
                            	  4381: ; [0F] moving direction as is.
                            	  4382: ;
                            	  4383: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4384: ; will be left as is, assuming that it had been reset before this
                            	  4385: ; routine by BoundByRoom.
                            	  4386: ;
                            	  4387: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4388: ;
                            	  4389: ;
                            	  4390: ; If already in a doorway, go handle it separately.
