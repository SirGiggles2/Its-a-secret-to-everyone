                            	  3713:     ; If the direction has an "up" component, then keep the
                            	  3714:     ; frame image 0, and go figure out horizontal flipping.
                            	  3715:     ;
02:0003B08E 41EC0098        	  3716:     lea     ($0098,A4),A0
