02:0004C4D6 760E            	  5225:     moveq   #14,D3
02:0004C4D8 10343070        	  5226:     move.b  ($70,A4,D3.W),D0
02:0004C4DC 19802070        	  5227:     move.b  D0,($70,A4,D2.W)
02:0004C4E0 41EC0084        	  5228:     lea     ($0084,A4),A0
02:0004C4E4 10303000        	  5229:     move.b  (A0,D3.W),D0
02:0004C4E8 41EC0084        	  5230:     lea     ($0084,A4),A0
02:0004C4EC 11802000        	  5231:     move.b  D0,(A0,D2.W)
02:0004C4F0 41EC0098        	  5232:     lea     ($0098,A4),A0
02:0004C4F4 10303000        	  5233:     move.b  (A0,D3.W),D0
