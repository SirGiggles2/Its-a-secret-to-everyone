                            	  2330: _TryShooting:
02:0003A6B8 19400001        	  2331:     move.b  D0,($0001,A4)
                            	  2332:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2333:     ;
02:0003A6BC 41EC034F        	  2334:     lea     ($034F,A4),A0
