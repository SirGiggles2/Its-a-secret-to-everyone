02:0003A6C4 0C000003        	  2336:     cmpi.b  #$03,D0
02:0003A6C8 6726            	  2337:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6CA 0C000001        	  2338:     cmpi.b  #$01,D0
02:0003A6CE 6720            	  2339:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6D0 0C000009        	  2340:     cmpi.b  #$09,D0
02:0003A6D4 671A            	  2341:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6D6 0C00000A        	  2342:     cmpi.b  #$0A,D0
02:0003A6DA 6714            	  2343:     beq  _L_z04__TryShooting_TryShootingNow
02:0003A6DC 41EC0451        	  2344:     lea     ($0451,A4),A0
02:0003A6E0 10302000        	  2345:     move.b  (A0,D2.W),D0
02:0003A6E4 660A            	  2346:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2347:     ; and a random value < $F8, then return.
                            	  2348:     ;
