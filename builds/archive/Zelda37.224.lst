02:0003B2C6 19400029        	  4083:     move.b  D0,($0029,A4)
                            	  4084:     even
                            	  4085: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4086:     ; If state <> 2 (so, it's 3), then return.
                            	  4087:     ;
                            	  4088:     ; Note that the first time here is when we fall thru from 8DBC.
