                            	  5937: Moldorm_ChangeFlyingState:
                            	  5938:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5939:     ;
02:0003C0A6 61000096        	  5940:     jsr     Flyer_MoldormDecideState
02:0003C0AA 7010            	  5941:     moveq   #16,D0
02:0003C0AC 19802028        	  5942:     move.b  D0,($28,A4,D2.W)
                            	  5943:     ; If the next lower slot's direction <> 0, then
                            	  5944:     ; go propagate direction changes down the chain.
                            	  5945:     ;
                            	  5946:     ; But you had to have propagated directions once for the
                            	  5947:     ; next lower direction to be set. How does it happen?
                            	  5948:     ;
                            	  5949:     ; Within a flyer state, the flying routines turn the flyer
                            	  5950:     ; and set the object timer to $10 several times. After any of
                            	  5951:     ; those times will the test succeed.
                            	  5952:     ;
                            	  5953:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5954:     ; in this block to set the timer to $10, and try to propagate
                            	  5955:     ; directions.
                            	  5956:     ;
                            	  5957:     ; But this is also the case the first time here.
                            	  5958:     ;
                            	  5959:     ; So, I believe that the point of this test is to delay moving
                            	  5960:     ; the lower (not head) segments when starting out.
                            	  5961:     ;
02:0003C0B0 41EC0097        	  5962:     lea     ($0097,A4),A0
02:0003C0B4 10302000        	  5963:     move.b  (A0,D2.W),D0
02:0003C0B8 6702            	  5964:     beq.s  __far_z_04_0046
02:0003C0BA 601C            	  5965:     jmp  Moldorm_PropagateDirs
                            	  5966: __far_z_04_0046:
02:0003C0BC 4E75            	  5967:     rts
                            	  5968: 
                            	  5969:     even
                            	  5970: Moldorm_Wander:
                            	  5971:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5972:     ; Only the head controls the movement direction.
                            	  5973:     ;
02:0003C0BE 0C020005        	  5974:     cmpi.b  #$05,D2
