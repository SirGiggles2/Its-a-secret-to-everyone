                            	 10168: _L_z04_UpdateGohma_AnimateClosedEye:
                            	 10169:     ; Here the eye is closed. So animate it this way.
                            	 10170:     ; Increment the animation counter, and if <> 8, then
                            	 10171:     ; go shoot, draw, and check collisions.
                            	 10172:     ;
