                            	  7377: Dodongo_TryEatBomb:
                            	  7378:     ; Try to eat the bomb.
                            	  7379:     ;
                            	  7380:     ; If the bomb is not in range of the monster, then return.
                            	  7381:     ;
                            	  7382:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7383:     ;
02:0003CAFC 7601            	  7384:     moveq   #1,D3
02:0003CAFE 616E            	  7385:     jsr     Dodongo_IsBombInRange
02:0003CB00 6666            	  7386:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7387:     ; Will loop from 1 to 0, indexed by [00].
                            	  7388:     ;
02:0003CB02 7001            	  7389:     moveq   #1,D0
02:0003CB04 1880            	  7390:     move.b  D0,($0000,A4)
                            	  7391:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7392:     ;
02:0003CB06 41EC0098        	  7393:     lea     ($0098,A4),A0
02:0003CB0A 10302000        	  7394:     move.b  (A0,D2.W),D0
02:0003CB0E E208            	  7395:     lsr.b  #1,D0   ; LSR A
02:0003CB10 7600            	  7396:     moveq   #0,D3
02:0003CB12 1600            	  7397:     move.b  D0,D3
                            	  7398:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7399:     ; position depends on the orientation of the monster.
                            	  7400:     ;
                            	  7401:     ; Start with the horizontal distance.
                            	  7402:     ;
02:0003CB14 102C0004        	  7403:     move.b  ($0004,A4),D0
                            	  7404:     even
                            	  7405: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7406:     ; Look up the limits for the given direction.
                            	  7407:     ;
                            	  7408:     ; If the distance from the bomb < negative limit,
                            	  7409:     ; or >= positive limit, then return.
                            	  7410:     ;
                            	  7411:     ; Note that these are simple signed comparisons that work,
                            	  7412:     ; because the operands are in a small range.
                            	  7413:     ;
02:0003CB18 41F90003CA52    	  7414:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB1E 12303000        	  7415:     move.b  (A0,D3.W),D1
02:0003CB22 B001            	  7416:     cmp.b   D1,D0
02:0003CB24 6B42            	  7417:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB26 41F90003CA58    	  7418:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB2C 12303000        	  7419:     move.b  (A0,D3.W),D1
02:0003CB30 B001            	  7420:     cmp.b   D1,D0
02:0003CB32 6A34            	  7421:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7422:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7423:     ;
02:0003CB34 1003            	  7424:     move.b  D3,D0
02:0003CB36 023C00EE        	  7425:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB3A 123C000A        	  7426:     move.b  #$0A,D1
02:0003CB3E D101            	  7427:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB40 7600            	  7428:     moveq   #0,D3
02:0003CB42 1600            	  7429:     move.b  D0,D3
                            	  7430:     ; Bottom of the loop.
                            	  7431:     ;
                            	  7432:     ; Load the vertical distance for the next iteration.
                            	  7433:     ; Decrement loop counter.
                            	  7434:     ;
02:0003CB44 102C0005        	  7435:     move.b  ($0005,A4),D0
02:0003CB48 5314            	  7436:     subq.b  #1,($0000,A4)
02:0003CB4A 6ACC            	  7437:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7438:     ; If we get here, then the bomb was within range of the mouth.
                            	  7439:     ; Go to state 1 (bloated).
                            	  7440:     ;
02:0003CB4C 41EC00AC        	  7441:     lea     ($00AC,A4),A0
02:0003CB50 52302000        	  7442:     addq.b  #1,(A0,D2.W)
                            	  7443:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7444:     ;
02:0003CB54 7610            	  7445:     moveq   #16,D3
02:0003CB56 7000            	  7446:     moveq   #0,D0
02:0003CB58 41EC00AC        	  7447:     lea     ($00AC,A4),A0
02:0003CB5C 11803000        	  7448:     move.b  D0,(A0,D3.W)
02:0003CB60 41EC042C        	  7449:     lea     ($042C,A4),A0
02:0003CB64 11802000        	  7450:     move.b  D0,(A0,D2.W)
                            	  7451:     even
