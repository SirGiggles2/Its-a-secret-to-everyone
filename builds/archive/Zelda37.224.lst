02:000368B8 19400325        	  5196:     move.b  D0,($0325,A4)
02:000368BC 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:000368C0 7020            	  5200:     moveq   #32,D0
02:000368C2 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:000368C6 7400            	  5204:     moveq   #0,D2
02:000368C8 142C050C        	  5205:     move.b  ($050C,A4),D2
02:000368CC 41F900036672    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:000368D2 10302000        	  5207:     move.b  (A0,D2.W),D0
02:000368D6 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:000368DA 102C050D        	  5211:     move.b  ($050D,A4),D0
02:000368DE 7600            	  5212:     moveq   #0,D3
02:000368E0 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:000368E2 E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:000368E4 E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:000368E6 E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:000368E8 E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:000368EA E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:000368EC 19400303        	  5221:     move.b  D0,($0303,A4)
                            	  5222:     ; Get the mask for the current VRAM page.
                            	  5223:     ;
02:000368F0 41F90003667E    	  5224:     lea     (CreditsPagesTextMasks).l,A0
02:000368F6 10302000        	  5225:     move.b  (A0,D2.W),D0
                            	  5226: _anon_z02_43:
                            	  5227:     ; Shift left as many times as the current VRAM line number,
                            	  5228:     ; to get the bit that indicates whether this line has text.
                            	  5229:     ;
