02:0003D014 123C0008        	  8102:     move.b  #$08,D1
02:0003D018 D101            	  8103:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D01A 020000F0        	  8104:     andi.b #$F0,D0
02:0003D01E 19802070        	  8105:     move.b  D0,($70,A4,D2.W)
                            	  8106:     ; Align the monster with a square vertically.
