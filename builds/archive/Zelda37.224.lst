                            	  2724: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2725:     ; If reversal count >= 2, then
                            	  2726:     ; 1. invert the horizontal component of facing direction,
                            	  2727:     ;    to face away from the chase target
                            	  2728:     ; 2. reset the reversal count to 0.
                            	  2729:     ;
                            	  2730:     ; This prevents a jumper from getting stuck in a corner.
                            	  2731:     ;
                            	  2732:     ; For example, if a tektite's direction is down and right,
                            	  2733:     ; and jumps into the top right corner of the room:
                            	  2734:     ; 1. The right room boundary is hit. So the direction is
                            	  2735:     ;    automatically reversed to up and left.
                            	  2736:     ; 2. The next frame, the top room boundary is hit.
                            	  2737:     ;    The direction is reversed to down and right.
                            	  2738:     ;
                            	  2739:     ; As you can see, an endless loop has been made.
                            	  2740:     ;
02:0003A928 41EC0451        	  2741:     lea     ($0451,A4),A0
02:0003A92C 10302000        	  2742:     move.b  (A0,D2.W),D0
02:0003A930 0C000002        	  2743:     cmpi.b  #$02,D0
02:0003A934 651E            	  2744:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003A936 41EC0098        	  2745:     lea     ($0098,A4),A0
02:0003A93A 10302000        	  2746:     move.b  (A0,D2.W),D0
02:0003A93E 0A000003        	  2747:     eori.b #$03,D0
02:0003A942 41EC0098        	  2748:     lea     ($0098,A4),A0
02:0003A946 11802000        	  2749:     move.b  D0,(A0,D2.W)
02:0003A94A 7000            	  2750:     moveq   #0,D0
02:0003A94C 41EC0451        	  2751:     lea     ($0451,A4),A0
02:0003A950 11802000        	  2752:     move.b  D0,(A0,D2.W)
                            	  2753:     even
                            	  2754: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2755:     ; If the object is a boulder, then make sure its facing direction
                            	  2756:     ; has a down vertical component.
                            	  2757:     ;
02:0003A954 610001F8        	  2758:     jsr     Jumper_PointBoulderDownward
                            	  2759:     ; For the given direction, get the Y offset of the destination
                            	  2760:     ; of the jump.
                            	  2761:     ;
                            	  2762:     ; Add it to the object's Y, and store this destination Y.
                            	  2763:     ;
02:0003A958 7600            	  2764:     moveq   #0,D3
02:0003A95A 41EC0098        	  2765:     lea     ($0098,A4),A0
02:0003A95E 16302000        	  2766:     move.b  (A0,D2.W),D3
02:0003A962 41EC0084        	  2767:     lea     ($0084,A4),A0
02:0003A966 10302000        	  2768:     move.b  (A0,D2.W),D0
02:0003A96A 023C00EE        	  2769:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A96E 41F90003A886    	  2770:     lea     (JumperYOffsets).l,A0
02:0003A974 12303000        	  2771:     move.b  (A0,D3.W),D1
02:0003A978 D101            	  2772:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003A97A 41EC0444        	  2773:     lea     ($0444,A4),A0
02:0003A97E 11802000        	  2774:     move.b  D0,(A0,D2.W)
                            	  2775:     ; Set the starting speed, depending on the object type.
                            	  2776:     ;
02:0003A982 610001A0        	  2777:     jsr     Jumper_GetKind
02:0003A986 41F90003A8B0    	  2778:     lea     (JumperStartSpeedsHi).l,A0
02:0003A98C 10303000        	  2779:     move.b  (A0,D3.W),D0
02:0003A990 41EC0412        	  2780:     lea     ($0412,A4),A0
02:0003A994 11802000        	  2781:     move.b  D0,(A0,D2.W)
                            	  2782:     ; Reset the vertical speed low byte.
                            	  2783:     ; Then go animate, draw, and check collisions.
                            	  2784:     ;
02:0003A998 6100022E        	  2785:     jsr     Jumper_ResetVSpeedFrac
