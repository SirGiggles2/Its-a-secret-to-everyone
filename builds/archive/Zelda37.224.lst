02:0003DEE0 61001DD4        	 10074:     jsr     ReverseObjDir8
02:0003DEE4 41EC045E        	 10075:     lea     ($045E,A4),A0
02:0003DEE8 10302000        	 10076:     move.b  (A0,D2.W),D0
