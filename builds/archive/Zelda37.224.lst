                            	 14279:     even
                            	 14280: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 14281:     ; Second, calculate a vertical component.
                            	 14282:     ; Combine it with the horizontal component:
                            	 14283:     ;
                            	 14284:     ; Y := 4 (down)
                            	 14285:     ; if observed player Y <> object Y then
                            	 14286:     ;   if observed player Y < object Y then
                            	 14287:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 14288:     ;   [00] := [00] | Y
                            	 14289:     ;
02:0003FD4C 7601            	 14290:     moveq   #1,D3
02:0003FD4E 102C0062        	 14291:     move.b  ($0062,A4),D0
02:0003FD52 41EC0084        	 14292:     lea     ($0084,A4),A0
02:0003FD56 12302000        	 14293:     move.b  (A0,D2.W),D1
02:0003FD5A B001            	 14294:     cmp.b   D1,D0
02:0003FD5C 6710            	 14295:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003FD5E 6402            	 14296:     bcc  _anon_z04_176
02:0003FD60 5203            	 14297:     addq.b  #1,D3
