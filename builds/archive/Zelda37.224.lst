                            	 13237: Ganon_CheckCollisions:
                            	 13238:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13239:     ; Store in [02] and [03].
                            	 13240:     ;
02:0003F5F8 10342070        	 13241:     move.b  ($70,A4,D2.W),D0
02:0003F5FC 023C00EE        	 13242:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F600 123C0010        	 13243:     move.b  #$10,D1
02:0003F604 D101            	 13244:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F606 19400002        	 13245:     move.b  D0,($0002,A4)
02:0003F60A 41EC0084        	 13246:     lea     ($0084,A4),A0
02:0003F60E 10302000        	 13247:     move.b  (A0,D2.W),D0
02:0003F612 023C00EE        	 13248:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F616 123C0010        	 13249:     move.b  #$10,D1
02:0003F61A D101            	 13250:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F61C 19400003        	 13251:     move.b  D0,($0003,A4)
                            	 13252:     ; Check for a collision with Link.
                            	 13253:     ;
                            	 13254:     ; We can't call CheckLinkCollision, because we need to
                            	 13255:     ; customize Ganon's midpoint.
                            	 13256:     ;
                            	 13257:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13258:     ; detection, if Link is invincible. Initialize variables that will
                            	 13259:     ; be returned from the partial collision check routine. Then
                            	 13260:     ; call it.
                            	 13261:     ;
02:0003F620 102C04F0        	 13262:     move.b  ($04F0,A4),D0
02:0003F624 6616            	 13263:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F626 19400006        	 13264:     move.b  D0,($0006,A4)
02:0003F62A 19400009        	 13265:     move.b  D0,($0009,A4)
02:0003F62E 1940000C        	 13266:     move.b  D0,($000C,A4)
02:0003F632 7600            	 13267:     moveq   #0,D3
02:0003F634 1883            	 13268:     move.b  D3,($0000,A4)
02:0003F636 4EB900031BB0    	 13269:     jsr     CheckLinkCollisionPreinit
                            	 13270:     even
                            	 13271: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13272:     ; If Ganon is not in state 0, then he's brown.
                            	 13273:     ; Go check collision with an arrow.
                            	 13274:     ;
02:0003F63C 41EC00AC        	 13275:     lea     ($00AC,A4),A0
02:0003F640 10302000        	 13276:     move.b  (A0,D2.W),D0
02:0003F644 6652            	 13277:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13278:     ; If timer <> 0, then Ganon is visible.
                            	 13279:     ; He can't be harmed like this. So, return.
                            	 13280:     ;
02:0003F646 10342028        	 13281:     move.b  ($28,A4,D2.W),D0
02:0003F64A 664A            	 13282:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F64C 760D            	 13283:     moveq   #13,D3
02:0003F64E 4EB90003207A    	 13284:     jsr     CheckMonsterSwordCollision
                            	 13285:     ; If Ganon has died according to the usual collision check rules
                            	 13286:     ; (HP = 0), then:
                            	 13287:     ; 1. Restore HP to the initial value $F0
                            	 13288:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13289:     ; 3. Change palette row 7 to make Ganon brown
                            	 13290:     ;
02:0003F654 41EC0405        	 13291:     lea     ($0405,A4),A0
02:0003F658 10302000        	 13292:     move.b  (A0,D2.W),D0
02:0003F65C 6718            	 13293:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F65E 103C00F0        	 13294:     move.b  #$F0,D0
02:0003F662 41EC0485        	 13295:     lea     ($0485,A4),A0
02:0003F666 11802000        	 13296:     move.b  D0,(A0,D2.W)
02:0003F66A 41EC00AC        	 13297:     lea     ($00AC,A4),A0
02:0003F66E 53302000        	 13298:     subq.b  #1,(A0,D2.W)
02:0003F672 61000084        	 13299:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13300:     even
                            	 13301: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13302:     ; If Ganon was harmed, then play the sound effect
                            	 13303:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13304:     ;
02:0003F676 41EC04F0        	 13305:     lea     ($04F0,A4),A0
02:0003F67A 10302000        	 13306:     move.b  (A0,D2.W),D0
02:0003F67E 670A            	 13307:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F680 6100A0FE        	 13308:     jsr     PlayBossHitCryIfNeeded
02:0003F684 7040            	 13309:     moveq   #64,D0
02:0003F686 19802028        	 13310:     move.b  D0,($28,A4,D2.W)
                            	 13311:     even
                            	 13312: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13313:     ; Reset metastate, because Ganon cannot die this way.
                            	 13314:     ;
02:0003F68A 4EB90004DA2A    	 13315:     jsr     ResetObjMetastate
                            	 13316:     ; Reset shove info and invincibility timer, because Ganon
                            	 13317:     ; doesn't react at all as a usual monster.
                            	 13318:     ;
02:0003F690 4EB900031F82    	 13319:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13320:     even
                            	 13321: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F696 4E75            	 13322:     rts
                            	 13323: 
                            	 13324:     even
                            	 13325: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13326:     ; If the silver arrow is not in the inventory, then return.
                            	 13327:     ;
02:0003F698 102C0659        	 13328:     move.b  ($0659,A4),D0
02:0003F69C 0C000002        	 13329:     cmpi.b  #$02,D0
02:0003F6A0 66F4            	 13330:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13331:     ; Reset the collision return value [06].
                            	 13332:     ;
02:0003F6A2 7000            	 13333:     moveq   #0,D0
02:0003F6A4 19400006        	 13334:     move.b  D0,($0006,A4)
                            	 13335:     ; If there's no arrow in flight, then return.
                            	 13336:     ;
02:0003F6A8 7612            	 13337:     moveq   #18,D3
02:0003F6AA 41EC00AC        	 13338:     lea     ($00AC,A4),A0
02:0003F6AE 10303000        	 13339:     move.b  (A0,D3.W),D0
02:0003F6B2 0C000010        	 13340:     cmpi.b  #$10,D0
02:0003F6B6 66DE            	 13341:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13342:     ; Check for collision with an arrow; and return if no collision.
                            	 13343:     ;
02:0003F6B8 4EB9000320D6    	 13344:     jsr     CheckMonsterArrowOrRodCollision
02:0003F6BE 102C0006        	 13345:     move.b  ($0006,A4),D0
02:0003F6C2 67D2            	 13346:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13347:     ; Set the Ganon phase to "dying".
                            	 13348:     ;
02:0003F6C4 41EC042C        	 13349:     lea     ($042C,A4),A0
02:0003F6C8 52302000        	 13350:     addq.b  #1,(A0,D2.W)
                            	 13351:     ; Now his body does flash.
                            	 13352:     ;
02:0003F6CC 7028            	 13353:     moveq   #40,D0
02:0003F6CE 41EC04F0        	 13354:     lea     ($04F0,A4),A0
02:0003F6D2 11802000        	 13355:     move.b  D0,(A0,D2.W)
                            	 13356:     ; Set initial cloud distance 8.
                            	 13357:     ;
02:0003F6D6 7008            	 13358:     moveq   #8,D0
02:0003F6D8 41EC0478        	 13359:     lea     ($0478,A4),A0
02:0003F6DC 11802000        	 13360:     move.b  D0,(A0,D2.W)
02:0003F6E0 0A3C0001        	 13361:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F6E4 4E75            	 13362:     rts
                            	 13363: 
                            	 13364:     even
