                            	  5980: _anon_z04_82:
                            	  5981:     ; Turn randomly while flying, as usual.
                            	  5982:     ;
02:0003C0CC 61003D24        	  5983:     jsr     Flyer_Wander
                            	  5984:     ; After every turn, the common flyer routines set timer to $10.
                            	  5985:     ; This can be used as a signal for moldorm to propagate
                            	  5986:     ; direction changes down the chain.
                            	  5987:     ;
                            	  5988:     ; Between each turn, timer <> $10.
                            	  5989:     ;
                            	  5990:     ; At the end of the delay after the last turn, timer = 0.
                            	  5991:     ; This is a signal that that flying state ended, and a new one
                            	  5992:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5993:     ; we can propagate direction changes again; and start
                            	  5994:     ; a new flying interval by setting timer to $10. This will make
                            	  5995:     ; the next flying state delay that amount of time before turning
                            	  5996:     ; the first time.
                            	  5997:     ;
                            	  5998:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5999:     ; arm the timer again, and shift directions down the chain.
                            	  6000:     ;
02:0003C0D0 10342028        	  6001:     move.b  ($28,A4,D2.W),D0
02:0003C0D4 6602            	  6002:     bne.s  __far_z_04_0048
02:0003C0D6 60CE            	  6003:     jmp  Moldorm_ChangeFlyingState
                            	  6004: __far_z_04_0048:
                            	  6005:     even
