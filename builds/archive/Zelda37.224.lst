02:0003102C 66E8            	  5273:     bne  _anon_z01_63
                            	  5274:     ; Switch to room item object slot $13.
                            	  5275:     ;
02:0003102E 7413            	  5276:     moveq   #19,D2
                            	  5277:     ; If room item object wasn't activated, then return.
                            	  5278:     ;
