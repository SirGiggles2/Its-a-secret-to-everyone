02:00031BEC 102C0070        	  6709:     move.b  ($0070,A4),D0
02:00031BF0 023C00EE        	  6710:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BF4 123C0008        	  6711:     move.b  #$08,D1
02:00031BF8 D101            	  6712:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031BFA 19400004        	  6713:     move.b  D0,($0004,A4)
02:00031BFE 102C0084        	  6714:     move.b  ($0084,A4),D0
02:00031C02 023C00EE        	  6715:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031C06 123C0008        	  6716:     move.b  #$08,D1
02:00031C0A D101            	  6717:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031C0C 19400005        	  6718:     move.b  D0,($0005,A4)
                            	  6719:     ; If both objects are 9 pixels apart or more, then return no collision.
                            	  6720:     ;
