                            	  6019: AnimateBoomerangAndCheckCollision:
                            	  6020:     ; Decrement animation counter; and when it reaches 0:
                            	  6021:     ; 1. arm it again for 2 frames
                            	  6022:     ; 2. advance the minor state within a cycle of 8
                            	  6023:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  6024:     ;
02:0004CA48 41EC03D0        	  6025:     lea     ($03D0,A4),A0
02:0004CA4C 53302000        	  6026:     subq.b  #1,(A0,D2.W)
02:0004CA50 6702            	  6027:     beq.s  __far_z_07_0090
02:0004CA52 6036            	  6028:     jmp  DrawBoomerangAndCheckCollision
                            	  6029: __far_z_07_0090:
02:0004CA54 7002            	  6030:     moveq   #2,D0
02:0004CA56 41EC03D0        	  6031:     lea     ($03D0,A4),A0
02:0004CA5A 11802000        	  6032:     move.b  D0,(A0,D2.W)
02:0004CA5E 41EC00AC        	  6033:     lea     ($00AC,A4),A0
02:0004CA62 52302000        	  6034:     addq.b  #1,(A0,D2.W)
02:0004CA66 41EC00AC        	  6035:     lea     ($00AC,A4),A0
02:0004CA6A 10302000        	  6036:     move.b  (A0,D2.W),D0
02:0004CA6E 02000077        	  6037:     andi.b #$77,D0
02:0004CA72 41EC00AC        	  6038:     lea     ($00AC,A4),A0
02:0004CA76 11802000        	  6039:     move.b  D0,(A0,D2.W)
02:0004CA7A 0C02000D        	  6040:     cmpi.b  #$0D,D2
02:0004CA7E 6402            	  6041:     bcc.s  __far_z_07_0091
02:0004CA80 6032            	  6042:     jmp  CalcBoomerangFrame
                            	  6043: __far_z_07_0091:
02:0004CA82 7602            	  6044:     moveq   #2,D3
02:0004CA84 4EB900030728    	  6045:     jsr     PlayBoomerangSfx
