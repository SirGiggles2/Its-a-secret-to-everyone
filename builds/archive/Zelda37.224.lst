02:0002E9B2 123C0001        	  1937:     move.b  #$01,D1
02:0002E9B6 D101            	  1938:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002E9B8 1880            	  1939:     move.b  D0,($0000,A4)
02:0002E9BA 102C0001        	  1940:     move.b  ($0001,A4),D0
02:0002E9BE 123C0000        	  1941:     move.b  #$00,D1
02:0002E9C2 D101            	  1942:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002E9C4 19400001        	  1943:     move.b  D0,($0001,A4)
                            	  1944:     ; Increment destination address.
