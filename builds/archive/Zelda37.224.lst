02:000368FC 5303            	  5231:     subq.b  #1,D3
02:000368FE 6AFA            	  5232:     bpl  _anon_z02_43
02:00036900 6400013E        	  5233:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5234:     ; The mask inidcates that it should have text.
                            	  5235:     ; But if line index >= $17, then it doesn't.
                            	  5236:     ;
02:00036904 7600            	  5237:     moveq   #0,D3
02:00036906 162C050E        	  5238:     move.b  ($050E,A4),D3
02:0003690A 0C030017        	  5239:     cmpi.b  #$17,D3
02:0003690E 64000130        	  5240:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5241:     ; In the first quest, don't consider line numbers >= $10.
                            	  5242:     ;
02:00036912 7400            	  5243:     moveq   #0,D2
02:00036914 142C0016        	  5244:     move.b  ($0016,A4),D2
02:00036918 41EC062D        	  5245:     lea     ($062D,A4),A0
02:0003691C 10302000        	  5246:     move.b  (A0,D2.W),D0
02:00036920 6608            	  5247:     bne  _anon_z02_44
02:00036922 0C030010        	  5248:     cmpi.b  #$10,D3
02:00036926 64000114        	  5249:     bcc  _L_z02_DrawCredits_IncLine
                            	  5250: _anon_z02_44:
