02:0004390C 6502            	  5974:     bcs  _anon_z05_113
02:0004390E 5303            	  5975:     subq.b  #1,D3
                            	  5976: _anon_z05_113:
                            	  5977:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5978:     ;
                            	  5979:     ; DT DFC DFO Meaning
