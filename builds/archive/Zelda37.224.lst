02:000438AA 6624            	  5897:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5898:     ; The current direction points to a door that has been opened.
                            	  5899:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5900:     ;
                            	  5901:     ;
                            	  5902:     ; Save provisional door face in Y register.
02:000438AC 7600            	  5903:     moveq   #0,D3
02:000438AE 1600            	  5904:     move.b  D0,D3
02:000438B0 101D            	  5905:     move.b  (A5)+,D0  ; PLA
02:000438B2 1B00            	  5906:     move.b  D0,-(A5)  ; PHA
02:000438B4 7400            	  5907:     moveq   #0,D2
02:000438B6 1400            	  5908:     move.b  D0,D2
02:000438B8 1003            	  5909:     move.b  D3,D0
                            	  5910:     ; If provisional door face is not for a shutter, then
                            	  5911:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5912:     ;
                            	  5913:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5914:     ;
02:000438BA 0C000007        	  5915:     cmpi.b  #$07,D0
02:000438BE 670E            	  5916:     beq  _anon_z05_111
02:000438C0 1B00            	  5917:     move.b  D0,-(A5)  ; PHA
02:000438C2 6100DD74        	  5918:     jsr     SetDoorFlag
02:000438C6 101D            	  5919:     move.b  (A5)+,D0  ; PLA
                            	  5920:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5921:     ; then go make it 9 (open "bombable").
                            	  5922:     ; Else make it 4 (open "door").
                            	  5923:     ;
02:000438C8 0C000008        	  5924:     cmpi.b  #$08,D0
02:000438CC 67A4            	  5925:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5926: _anon_z05_111:
