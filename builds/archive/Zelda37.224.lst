02:0003DF32 41EC042C        	 10116:     lea     ($042C,A4),A0
02:0003DF36 53302000        	 10117:     subq.b  #1,(A0,D2.W)
                            	 10118: _anon_z04_122:
                            	 10119:     ; If open eye timer = 0, then the eye is closed.
                            	 10120:     ; Go animate it differently.
                            	 10121:     ;
02:0003DF3A 41EC0444        	 10122:     lea     ($0444,A4),A0
02:0003DF3E 10302000        	 10123:     move.b  (A0,D2.W),D0
02:0003DF42 674A            	 10124:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	 10125:     ; Else decrement the open eye timer.
                            	 10126:     ;
02:0003DF44 41EC0444        	 10127:     lea     ($0444,A4),A0
02:0003DF48 53302000        	 10128:     subq.b  #1,(A0,D2.W)
                            	 10129:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	 10130:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	 10131:     ;
02:0003DF4C 7602            	 10132:     moveq   #2,D3
02:0003DF4E 0C000070        	 10133:     cmpi.b  #$70,D0
02:0003DF52 6408            	 10134:     bcc  _anon_z04_123
02:0003DF54 0C000010        	 10135:     cmpi.b  #$10,D0
02:0003DF58 6502            	 10136:     bcs  _anon_z04_123
02:0003DF5A 5203            	 10137:     addq.b  #1,D3
                            	 10138: _anon_z04_123:
02:0003DF5C 1003            	 10139:     move.b  D3,D0
                            	 10140:     even
