02:0003027A 9101            	  3173:     subx.b  D1,D0   ; SBC ObjY,X
02:0003027C 0A3C0010        	  3174:     eori    #$10,CCR  ; restore X = 6502 C
02:00030280 61000898        	  3175:     jsr     Abs
