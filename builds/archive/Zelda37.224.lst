02:00036938 670E            	  5257:     beq  _anon_z02_45
02:0003693A 0C03000C        	  5258:     cmpi.b  #$0C,D3
02:0003693E 6508            	  5259:     bcs  _anon_z02_45
02:00036940 0C030010        	  5260:     cmpi.b  #$10,D3
02:00036944 650000F6        	  5261:     bcs  _L_z02_DrawCredits_IncLine
                            	  5262: _anon_z02_45:
02:00036948 41F90003668A    	  5263:     lea     (CreditsTextAddrsLo).l,A0
02:0003694E 10303000        	  5264:     move.b  (A0,D3.W),D0
02:00036952 1880            	  5265:     move.b  D0,($0000,A4)
02:00036954 41F9000366A2    	  5266:     lea     (CreditsTextAddrsHi).l,A0
02:0003695A 10303000        	  5267:     move.b  (A0,D3.W),D0
02:0003695E 19400001        	  5268:     move.b  D0,($0001,A4)
                            	  5269:     ; First read the length of the string.
                            	  5270:     ;
02:00036962 7600            	  5271:     moveq   #0,D3
02:00036964 1214            	  5272:     move.b  ($00,A4),D1   ; ptr lo
02:00036966 182C0001        	  5273:     move.b  ($01,A4),D4  ; ptr hi
02:0003696A 024100FF        	  5274:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003696E E14C            	  5275:     lsl.w   #8,D4
02:00036970 8841            	  5276:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036972 48C4            	  5277:     ext.l   D4
02:00036974 D8BC00FF0000    	  5278:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003697A 2044            	  5279:     movea.l D4,A0
02:0003697C 10303000        	  5280:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00036980 19400002        	  5281:     move.b  D0,($0002,A4)
                            	  5282:     ; Second, read the offset where the first character goes
                            	  5283:     ; in the line.
                            	  5284:     ;
02:00036984 5203            	  5285:     addq.b  #1,D3
02:00036986 1214            	  5286:     move.b  ($00,A4),D1   ; ptr lo
02:00036988 182C0001        	  5287:     move.b  ($01,A4),D4  ; ptr hi
02:0003698C 024100FF        	  5288:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036990 E14C            	  5289:     lsl.w   #8,D4
02:00036992 8841            	  5290:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036994 48C4            	  5291:     ext.l   D4
02:00036996 D8BC00FF0000    	  5292:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003699C 2044            	  5293:     movea.l D4,A0
02:0003699E 10303000        	  5294:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000369A2 7400            	  5295:     moveq   #0,D2
02:000369A4 1400            	  5296:     move.b  D0,D2
                            	  5297:     ; Loop over each character in the rest of the credits source record.
