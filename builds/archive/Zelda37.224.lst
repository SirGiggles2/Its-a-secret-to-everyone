02:0004D642 1940004B        	  7571:     move.b  D0,($004B,A4)
02:0004D646 41EC0492        	  7572:     lea     ($0492,A4),A0
02:0004D64A 11802000        	  7573:     move.b  D0,(A0,D2.W)
02:0004D64E 4E75            	  7574:     rts
                            	  7575:     even
