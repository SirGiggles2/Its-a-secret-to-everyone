02:00031CFC 1941000D        	  6861:     move.b  D1,($000D,A4)
02:00031D00 122C000E        	  6862:     move.b  ($000E,A4),D1
02:00031D04 E211            	  6863:     roxr.b  #1,D1   ; ROR $0E
02:00031D06 1941000E        	  6864:     move.b  D1,($000E,A4)
02:00031D0A 5303            	  6865:     subq.b  #1,D3
02:00031D0C 66E8            	  6866:     bne  _anon_z01_86
