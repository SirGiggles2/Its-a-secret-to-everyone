                            	 14259: TurnTowardsPlayer8:
                            	 14260:     ; Build a direction in [00] towards the player.
                            	 14261:     ;
                            	 14262:     ; First, calculate a horizontal component:
                            	 14263:     ;
                            	 14264:     ; If   observed player X = object X, [00] := 0 (none)
                            	 14265:     ; elif observed player X > object X, [00] := 1 (right)
                            	 14266:     ; else                               [00] := 2 (left)
                            	 14267:     ;
02:0003FD34 7600            	 14268:     moveq   #0,D3
02:0003FD36 1883            	 14269:     move.b  D3,($0000,A4)
02:0003FD38 5203            	 14270:     addq.b  #1,D3
02:0003FD3A 102C0061        	 14271:     move.b  ($0061,A4),D0
02:0003FD3E 12342070        	 14272:     move.b  ($70,A4,D2.W),D1
02:0003FD42 B001            	 14273:     cmp.b   D1,D0
02:0003FD44 6706            	 14274:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003FD46 6402            	 14275:     bcc  _anon_z04_175
02:0003FD48 5203            	 14276:     addq.b  #1,D3
                            	 14277: _anon_z04_175:
