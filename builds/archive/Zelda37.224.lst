02:0003CA94 123C0008        	  7319:     move.b  #$08,D1
02:0003CA98 D101            	  7320:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7321: _anon_z04_91:
02:0003CA9A 1880            	  7322:     move.b  D0,($0000,A4)
                            	  7323:     ; Store (Y + 8) in [01].
                            	  7324:     ;
02:0003CA9C 41EC0084        	  7325:     lea     ($0084,A4),A0
02:0003CAA0 10302000        	  7326:     move.b  (A0,D2.W),D0
02:0003CAA4 123C0008        	  7327:     move.b  #$08,D1
02:0003CAA8 D101            	  7328:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAAA 19400001        	  7329:     move.b  D0,($0001,A4)
                            	  7330:     ; Only check the first bomb slot ($10).
                            	  7331:     ;
                            	  7332:     ; Store the bomb's (X + 8) in [02].
                            	  7333:     ;
02:0003CAAE 7610            	  7334:     moveq   #16,D3
02:0003CAB0 10343070        	  7335:     move.b  ($70,A4,D3.W),D0
02:0003CAB4 123C0008        	  7336:     move.b  #$08,D1
02:0003CAB8 D101            	  7337:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CABA 19400002        	  7338:     move.b  D0,($0002,A4)
                            	  7339:     ; Store the bomb's (Y + 8) in [03].
                            	  7340:     ;
02:0003CABE 41EC0084        	  7341:     lea     ($0084,A4),A0
02:0003CAC2 10303000        	  7342:     move.b  (A0,D3.W),D0
02:0003CAC6 123C0008        	  7343:     move.b  #$08,D1
02:0003CACA D101            	  7344:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CACC 19400003        	  7345:     move.b  D0,($0003,A4)
                            	  7346:     ; But, if there's no bomb, then return.
                            	  7347:     ;
02:0003CAD0 41EC00AC        	  7348:     lea     ($00AC,A4),A0
02:0003CAD4 10303000        	  7349:     move.b  (A0,D3.W),D0
02:0003CAD8 6720            	  7350:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7351:     ; If the bomb has not exploded (state $12), then
                            	  7352:     ; go see if Dodongo will eat it.
