02:00033582 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033586 E14C            	   528:     lsl.w   #8,D4
02:00033588 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003358A 48C4            	   530:     ext.l   D4
02:0003358C D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033592 2044            	   532:     movea.l D4,A0
02:00033594 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033598 41EC0633        	   534:     lea     ($0633,A4),A0
02:0003359C 11803000        	   535:     move.b  D0,(A0,D3.W)
02:000335A0 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:000335A2 1003            	   537:     move.b  D3,D0
02:000335A4 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:000335A6 19430016        	   539:     move.b  D3,($0016,A4)
02:000335AA 6100D13C        	   540:     jsr     FetchFileAAddressSet
02:000335AE 61001C46        	   541:     jsr     FormatFileA
02:000335B2 7000            	   542:     moveq   #0,D0
02:000335B4 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:000335B8 6100D12E        	   550:     jsr     FetchFileAAddressSet
02:000335BC 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:000335BE 7600            	   552:     moveq   #0,D3
02:000335C0 1600            	   553:     move.b  D0,D3
                            	   554:     even
