                            	   384: ;------------------------------------------------------------------------------
                            	   385: ; _c_move_object_shim — MoveObject trampoline.
                            	   386: ;
                            	   387: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   388: ;   Input:     D2 = slot (0..11)
                            	   389: ;   Preserves: D2, A4, A5
                            	   390: ;   Clobbers:  D0, D1, D3, A0
                            	   391: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   392: ;
                            	   393: ; GCC side:
                            	   394: ;   void c_move_object(unsigned short slot);
                            	   395: ;     slot arrives as a 16-bit value on the stack.
                            	   396: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   397: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   398: ;   never clobbered by gcc.
                            	   399: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   400: ;   semantics can exist in a pure C port).
                            	   401: ;------------------------------------------------------------------------------
                            	   402: _c_move_object_shim:
                            	   403:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   404:     move.b  #$AA,($0900,A4)
                            	   405:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   406:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   407:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   408:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   409:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   410:     moveq   #0,D0
02:0002B658 3002            	   411:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   412:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   413:     jsr     c_move_object
02:0002B662 588F            	   414:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   415:     rts
                            	   416: 
                            	   417: ;==============================================================================
                            	   418: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   419: ; and tail-call the native asm function.
                            	   420: ;
                            	   421: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   422: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   423: ; sign-extended).
                            	   424: ;==============================================================================
                            	   425: 
                            	   426: ;------------------------------------------------------------------------------
                            	   427: ; void c_copy_bank_to_window(unsigned int bank);
                            	   428: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   429: ;------------------------------------------------------------------------------
                            	   430: c_copy_bank_to_window:
02:0002B666 202F0004        	   431:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   432:     jmp     _copy_bank_to_window
                            	   433: 
                            	   434: ;------------------------------------------------------------------------------
                            	   435: ; unsigned char c_ppu_read_2(void);
                            	   436: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   437: ; C return: gcc expects result in D0.
                            	   438: ;------------------------------------------------------------------------------
                            	   439: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   440:     jmp     _ppu_read_2
                            	   441: 
                            	   442: ;------------------------------------------------------------------------------
                            	   443: ; void c_ppu_write_6(unsigned int val);
                            	   444: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   445: ;------------------------------------------------------------------------------
                            	   446: c_ppu_write_6:
02:0002B674 202F0004        	   447:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   448:     jmp     _ppu_write_6
                            	   449: 
                            	   450: ;------------------------------------------------------------------------------
                            	   451: ; void c_ppu_write_7(unsigned int val);
                            	   452: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   453: ;------------------------------------------------------------------------------
                            	   454: c_ppu_write_7:
02:0002B67E 202F0004        	   455:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   456:     jmp     _ppu_write_7
                            	   457: 
                            	   458: ;------------------------------------------------------------------------------
                            	   459: ; void c_turn_off_all_video(void);
