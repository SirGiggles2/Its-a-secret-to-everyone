                            	  6777:     ; Use (direction - 1) to index the speeds.
                            	  6778:     ; This yields 0 for right, 1 for left.
                            	  6779:     ;
02:0003C6B8 7600            	  6780:     moveq   #0,D3
02:0003C6BA 41EC0098        	  6781:     lea     ($0098,A4),A0
02:0003C6BE 16302000        	  6782:     move.b  (A0,D2.W),D3
02:0003C6C2 5303            	  6783:     subq.b  #1,D3
                            	  6784:     ; Add the speed to the X coordinate.
                            	  6785:     ;
02:0003C6C4 10342070        	  6786:     move.b  ($70,A4,D2.W),D0
02:0003C6C8 023C00EE        	  6787:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C6CC 41F90003C636    	  6788:     lea     (AquamentusSpeeds).l,A0
02:0003C6D2 12303000        	  6789:     move.b  (A0,D3.W),D1
02:0003C6D6 D101            	  6790:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
02:0003C6D8 19802070        	  6791:     move.b  D0,($70,A4,D2.W)
                            	  6792:     ; Decrement the distance remaining.
