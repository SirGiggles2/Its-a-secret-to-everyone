                            	  4061: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  4062:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  4063:     ;
                            	  4064:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  4065:     ;         or object direction when <> 0.
                            	  4066:     ;
                            	  4067:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  4068:     ;
                            	  4069:     ; if slot = 0 and grid offset <> 0 then
                            	  4070:     ;   if input dir = 0 then
                            	  4071:     ;     use 0
                            	  4072:     ;   else
                            	  4073:     ;     use object direction
                            	  4074:     ; else
                            	  4075:     ;   if slot <> 0 and (has clock or stunned) then
                            	  4076:     ;     return
                            	  4077:     ;   else
                            	  4078:     ;     if input dir = 0
                            	  4079:     ;       use 0
                            	  4080:     ;     else
                            	  4081:     ;       use input direction
                            	  4082:     ;
