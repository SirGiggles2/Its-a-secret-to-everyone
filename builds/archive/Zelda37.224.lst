                            	  7166: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7167:     ; Advance the substate.
                            	  7168:     ;
02:0003C97A 41EC042C        	  7169:     lea     ($042C,A4),A0
02:0003C97E 52302000        	  7170:     addq.b  #1,(A0,D2.W)
                            	  7171:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7172:     ;
02:0003C982 41EC042C        	  7173:     lea     ($042C,A4),A0
