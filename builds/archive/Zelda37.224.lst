                            	   231:     ; be at the bottom of NT 2.
                            	   232:     ;
02:00040156 103C00EF        	   233:     move.b  #$EF,D0
02:0004015A 194000FC        	   234:     move.b  D0,($00FC,A4)
02:0004015E 1940005C        	   235:     move.b  D0,($005C,A4)
02:00040162 7001            	   236:     moveq   #1,D0
