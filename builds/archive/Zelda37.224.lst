02:0003A538 162C00EB        	  2105:     move.b  ($00EB,A4),D3
02:0003A53C 41F900FF687E    	  2106:     lea     (NES_SRAM+$087E).l,A0
02:0003A542 10303000        	  2107:     move.b  (A0,D3.W),D0
02:0003A546 02000008        	  2108:     andi.b #$08,D0
02:0003A54A 677C            	  2109:     beq  _L_z04_CheckZora_Exit
                            	  2110:     ; If zora is active, return.
                            	  2111:     ;
