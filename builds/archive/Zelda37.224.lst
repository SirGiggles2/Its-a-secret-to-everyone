02:0003E080 123C0008        	 10303:     move.b  #$08,D1
02:0003E084 D101            	 10304:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E086 19802070        	 10305:     move.b  D0,($70,A4,D2.W)
02:0003E08A 532C000F        	 10306:     subq.b  #1,($000F,A4)
