                            	  8248: __far_z_05_0110:
                            	  8249:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8250:     ; and represents the current row of the submenu being processed.
                            	  8251:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8252:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8253:     ;
                            	  8254:     ; If the bottom bit is set, go prepare the full black row.
                            	  8255:     ;
02:00044EA0 E208            	  8256:     lsr.b  #1,D0   ; LSR A
02:00044EA2 7600            	  8257:     moveq   #0,D3
02:00044EA4 1600            	  8258:     move.b  D0,D3
02:00044EA6 6402            	  8259:     bcc.s  __far_z_05_0111
02:00044EA8 6026            	  8260:     jmp  PrepFullBlackRow
                            	  8261: __far_z_05_0111:
                            	  8262:     ; Submenu rows $D to $15 are parts of the map.
                            	  8263:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8264:     ;
                            	  8265:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8266:     ; buffer for this row.
                            	  8267:     ;
02:00044EAA 0C00000D        	  8268:     cmpi.b  #$0D,D0
02:00044EAE 640C            	  8269:     bcc  _anon_z05_167
02:00044EB0 41F900044E74    	  8270:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044EB6 10303000        	  8271:     move.b  (A0,D3.W),D0
                            	  8272:     even
