                            	  7087: UpdateDodongoState2_Stunned:
                            	  7088:     ; Take action depending on the value of stun timer:
                            	  7089:     ; 0:     set stun timer to $20 
                            	  7090:     ; 1:     go back to state 0
                            	  7091:     ; other: return
                            	  7092:     ;
