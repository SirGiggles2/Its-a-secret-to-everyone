02:0003C8E4 1634203D        	  7094:     move.b  ($3D,A4,D2.W),D3
02:0003C8E8 5303            	  7095:     subq.b  #1,D3
02:0003C8EA 6604            	  7096:     bne.s  __far_z_04_0062
