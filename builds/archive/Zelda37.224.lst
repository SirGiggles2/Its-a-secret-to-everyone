                            	 10194: GohmaLegOffsetsX:
02:0003DFC0 F0              	 10195:     dc.b    $F0, $10
02:0003DFC1 10
                            	 10196: 
                            	 10197: ; Params:
                            	 10198: ; A: eye frame image
                            	 10199: ;
                            	 10200: ; Draw the eye with the frame image passed in.
                            	 10201: ;
                            	 10202:     even
                            	 10203: Gohma_AnimateAndDraw:
02:0003DFC2 1B00            	 10204:     move.b  D0,-(A5)  ; PHA
02:0003DFC4 4EB90004D222    	 10205:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003DFCA 6164            	 10206:     jsr     Gohma_SetSpriteAttributes
02:0003DFCC 101D            	 10207:     move.b  (A5)+,D0  ; PLA
02:0003DFCE 4EB9000316B0    	 10208:     jsr     DrawObjectMirrored
02:0003DFD4 7010            	 10209:     moveq   #16,D0
02:0003DFD6 4EB90004D21C    	 10210:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	 10211:     ; Draw the right legs.
                            	 10212:     ;
02:0003DFDC 7601            	 10213:     moveq   #1,D3
02:0003DFDE 6102            	 10214:     jsr     Gohma_DrawLegsOneSide
                            	 10215:     ; Draw the left legs.
                            	 10216:     ;
02:0003DFE0 7600            	 10217:     moveq   #0,D3
                            	 10218: ; Params:
                            	 10219: ; Y: side: 0 for left, 1 for right
                            	 10220: ;
                            	 10221: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10222: ; store the sprite's X in [00].
                            	 10223: ;
                            	 10224:     even
                            	 10225: Gohma_DrawLegsOneSide:
02:0003DFE2 10342070        	 10226:     move.b  ($70,A4,D2.W),D0
02:0003DFE6 023C00EE        	 10227:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFEA 41F90003DFC0    	 10228:     lea     (GohmaLegOffsetsX).l,A0
02:0003DFF0 12303000        	 10229:     move.b  (A0,D3.W),D1
02:0003DFF4 D101            	 10230:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DFF6 1880            	 10231:     move.b  D0,($0000,A4)
                            	 10232:     ; The object's Y is the sprite's.
                            	 10233:     ;
02:0003DFF8 41EC0084        	 10234:     lea     ($0084,A4),A0
02:0003DFFC 10302000        	 10235:     move.b  (A0,D2.W),D0
02:0003E000 19400001        	 10236:     move.b  D0,($0001,A4)
02:0003E004 612A            	 10237:     jsr     Gohma_SetSpriteAttributes
                            	 10238:     ; There are only two frame images for legs: left and right.
                            	 10239:     ; There are two animation frames. They are animated as follows:
                            	 10240:     ;
                            	 10241:     ; Frame 0:
                            	 10242:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10243:     ; horizontal flipping = frame number = 0
                            	 10244:     ; 
                            	 10245:     ; Frame 1:
                            	 10246:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10247:     ; horizontal flipping = frame number = 1
                            	 10248:     ;
02:0003E006 4EB90004D1F4    	 10249:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E00C 1003            	 10250:     move.b  D3,D0
02:0003E00E 023C00EE        	 10251:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E012 41EC03E4        	 10252:     lea     ($03E4,A4),A0
02:0003E016 12302000        	 10253:     move.b  (A0,D2.W),D1
02:0003E01A D101            	 10254:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E01C 02000001        	 10255:     andi.b #$01,D0
02:0003E020 023C00EE        	 10256:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E024 123C0004        	 10257:     move.b  #$04,D1
02:0003E028 D101            	 10258:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E02A 4EF9000316B4    	 10259:     jmp     DrawObjectNotMirrored
                            	 10260: 
                            	 10261: ; Returns:
                            	 10262: ; [04]: left side sprite attributes
                            	 10263: ; [05]: right side sprite attributes
                            	 10264: ;
                            	 10265:     even
                            	 10266: Gohma_SetSpriteAttributes:
02:0003E030 41EC034F        	 10267:     lea     ($034F,A4),A0
02:0003E034 10302000        	 10268:     move.b  (A0,D2.W),D0
02:0003E038 003C0011        	 10269:     ori     #$11,CCR  ; SEC: set C+X
02:0003E03C 123C0032        	 10270:     move.b  #$32,D1
02:0003E040 0A3C0010        	 10271:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E044 9101            	 10272:     subx.b  D1,D0   ; SBC #$32
02:0003E046 0A3C0010        	 10273:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E04A 4EF9000319A6    	 10274:     jmp     Anim_SetSpriteDescriptorAttributes
