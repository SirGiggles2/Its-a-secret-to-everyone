02:0003ED74 D101            	 12013:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED76 02000007        	 12014:     andi.b #$07,D0
02:0003ED7A 6702            	 12015:     beq.s  __far_z_04_0124
02:0003ED7C 60D8            	 12016:     jmp  L12A6F_Exit
                            	 12017: __far_z_04_0124:
                            	 12018:     ; Will loop 4 times, propagating directions down the chain,
                            	 12019:     ; by pulling from the bottom.
