                            	  9728: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9729:     ; At this point, we have a hand that just died.
                            	  9730:     ;
                            	  9731:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9732:     ;
02:0003DC4E 7603            	  9733:     moveq   #3,D3
                            	  9734:     ; Count how many are allocated.
                            	  9735:     ; This includes the current dead one, and the other living ones.
                            	  9736:     ; Store the count in [00].
                            	  9737:     ;
02:0003DC50 7000            	  9738:     moveq   #0,D0
02:0003DC52 1880            	  9739:     move.b  D0,($0000,A4)
                            	  9740:     even
                            	  9741: _L_z04_Manhandla_CheckCollisions_LoopHand:
