                            	 13384: _anon_z04_165:
02:0003F702 1003            	 13385:     move.b  D3,D0
02:0003F704 1B00            	 13386:     move.b  D0,-(A5)  ; PHA
                            	 13387:     ; Get the length, to append to the dynamic transfer buf.
                            	 13388:     ;
02:0003F706 7400            	 13389:     moveq   #0,D2
02:0003F708 142C0301        	 13390:     move.b  ($0301,A4),D2
                            	 13391:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 13392:     ;
02:0003F70C 7600            	 13393:     moveq   #0,D3
