                            	  6119: ; Params:
                            	  6120: ; Y: reverse direction index that the weapon is facing
                            	  6121: ;
                            	  6122: ;
                            	  6123: ; [00] and [01] will hold sprite X and Y.
                            	  6124: ; Begin with the horizontal and vertical offsets.
                            	  6125: ;
                            	  6126:     even
