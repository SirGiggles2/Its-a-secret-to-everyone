02:0003ECDE 41EC0485        	 11936:     lea     ($0485,A4),A0
02:0003ECE2 11802000        	 11937:     move.b  D0,(A0,D2.W)
                            	 11938:     ; Find the tail of the lamnola that the current segment belongs to.
