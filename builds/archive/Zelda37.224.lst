02:0002E250 123C0098        	   928:     move.b  #$98,D1
02:0002E254 0A3C0010        	   929:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E258 9101            	   930:     subx.b  D1,D0   ; SBC #$98
02:0002E25A 0A3C0010        	   931:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E25E 610028BA        	   932:     jsr     Abs
02:0002E262 0C000006        	   933:     cmpi.b  #$06,D0
