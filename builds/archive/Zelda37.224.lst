02:0003C546 19410002        	  6596:     move.b  D1,($0002,A4)
02:0003C54A 122C0002        	  6597:     move.b  ($0002,A4),D1
02:0003C54E C200            	  6598:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C550 671E            	  6599:     beq  _L_z04_Digdogger_Move_End
02:0003C552 41EC0084        	  6600:     lea     ($0084,A4),A0
