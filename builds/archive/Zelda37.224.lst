                            	  7573:     even
                            	  7574: PlayParryTune:
02:00032196 60009CA8        	  7575:     jmp     c_play_parry_tune
                            	  7576: 
                            	  7577: L763A_Exit:
02:0003219A 4E75            	  7578:     rts
                            	  7579: 
                            	  7580: ; Params:
                            	  7581: ; A: damage points
                            	  7582: ; X: monster object slot
                            	  7583: ; [00]: weapon object slot
                            	  7584: ; [02]: monster object mid X
                            	  7585: ; [03]: monster object mid Y
                            	  7586: ; [09]: damage type
                            	  7587: ; [0D]: horizontal threshold
                            	  7588: ;
                            	  7589: ; Returns:
                            	  7590: ; [06]: 1 if objects collide
                            	  7591: ; [07]: damage points
                            	  7592: ; [0E]: vertical threshold
                            	  7593: ;
                            	  7594:     even
                            	  7595: CheckMonsterSlenderWeaponCollision:
02:0003219C 19400007        	  7596:     move.b  D0,($0007,A4)
02:000321A0 102C000D        	  7597:     move.b  ($000D,A4),D0
02:000321A4 1940000E        	  7598:     move.b  D0,($000E,A4)
                            	  7599: ; Params:
                            	  7600: ; X: monster object slot
                            	  7601: ; [00]: weapon object slot
                            	  7602: ; [02]: monster object mid X
                            	  7603: ; [03]: monster object mid Y
                            	  7604: ; [07]: damage points
                            	  7605: ; [09]: damage type
                            	  7606: ; [0D]: horizontal threshold
                            	  7607: ; [0E]: vertical threshold
                            	  7608: ;
                            	  7609: ; Returns:
                            	  7610: ; [06]: 1 if objects collide
                            	  7611: ;
                            	  7612:     even
                            	  7613: CheckMonsterSlenderWeaponCollision2:
02:000321A8 7600            	  7614:     moveq   #0,D3
02:000321AA 1614            	  7615:     move.b  ($0000,A4),D3
                            	  7616:     ; If Link is facing vertically, then:
                            	  7617:     ; [04] := (weapon X + 6)
                            	  7618:     ; A    := (weapon Y + 8)
                            	  7619:     ;
                            	  7620:     ; Shouldn't it be based on the weapon's direction?
                            	  7621:     ;
02:000321AC 102C0098        	  7622:     move.b  ($0098,A4),D0
02:000321B0 0200000C        	  7623:     andi.b #$0C,D0
02:000321B4 6726            	  7624:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:000321B6 10343070        	  7625:     move.b  ($70,A4,D3.W),D0
02:000321BA 023C00EE        	  7626:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321BE 123C0006        	  7627:     move.b  #$06,D1
02:000321C2 D101            	  7628:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:000321C4 19400004        	  7629:     move.b  D0,($0004,A4)
02:000321C8 41EC0084        	  7630:     lea     ($0084,A4),A0
02:000321CC 10303000        	  7631:     move.b  (A0,D3.W),D0
02:000321D0 023C00EE        	  7632:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321D4 123C0008        	  7633:     move.b  #$08,D1
02:000321D8 D101            	  7634:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000321DA 6024            	  7635:     jmp     _anon_z01_98
                            	  7636: 
                            	  7637:     even
                            	  7638: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7639:     ; Else Link is facing horizontally.
                            	  7640:     ; [04] := (weapon X + 8)
                            	  7641:     ; A    := (weapon Y + 6)
                            	  7642:     ;
                            	  7643:     ; Shouldn't it be based on the weapon's direction?
                            	  7644:     ;
02:000321DC 10343070        	  7645:     move.b  ($70,A4,D3.W),D0
02:000321E0 023C00EE        	  7646:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321E4 123C0008        	  7647:     move.b  #$08,D1
02:000321E8 D101            	  7648:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000321EA 19400004        	  7649:     move.b  D0,($0004,A4)
02:000321EE 41EC0084        	  7650:     lea     ($0084,A4),A0
02:000321F2 10303000        	  7651:     move.b  (A0,D3.W),D0
02:000321F6 023C00EE        	  7652:     andi    #$EE,CCR  ; CLC: clear C+X
02:000321FA 123C0006        	  7653:     move.b  #$06,D1
02:000321FE D101            	  7654:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7655: _anon_z01_98:
                            	  7656:     ; The A register will be copied to [05] and used here.
                            	  7657:     ;
02:00032200 6000FC0A        	  7658:     jmp     CheckMonsterWeaponCollision
                            	  7659: 
                            	  7660: ; Params:
                            	  7661: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7662: ; [00]: weapon object slot (unused)
                            	  7663: ; [02]: object 1 mid X
                            	  7664: ; [03]: object 1 mid Y
                            	  7665: ; [04]: object 2 mid X
                            	  7666: ; [05]: object 2 mid Y
                            	  7667: ;
                            	  7668: ; Returns:
                            	  7669: ; A: 1 if objects collide
                            	  7670: ; Y: weapon object slot
                            	  7671: ; Z: 0 if objects collide
                            	  7672: ; [06]: 1 if objects collide
                            	  7673: ; [0A]: horizontal distance
                            	  7674: ; [0B]: vertical distance
                            	  7675: ;
                            	  7676: ;
                            	  7677: ; Use the same threshold value horizontally and vertically.
                            	  7678: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7679: ;
                            	  7680:     even
                            	  7681: DoObjectsCollide:
02:00032204 1940000D        	  7682:     move.b  D0,($000D,A4)
02:00032208 1940000E        	  7683:     move.b  D0,($000E,A4)
                            	  7684: ; Params:
                            	  7685: ; [00]: weapon or Link object slot (unused)
                            	  7686: ; [02]: object 1 mid X
                            	  7687: ; [03]: object 1 mid Y
                            	  7688: ; [04]: object 2 mid X
                            	  7689: ; [05]: object 2 mid Y
                            	  7690: ; [0D]: horizontal threshold
                            	  7691: ; [0E]: vertical threshold
                            	  7692: ;
                            	  7693: ; Returns:
                            	  7694: ; A: 1 if objects collide
                            	  7695: ; Y: weapon or Link object slot (copied from [00])
                            	  7696: ; Z: 0 if objects collide
                            	  7697: ; [06]: 1 if objects collide
                            	  7698: ; [0A]: horizontal distance
                            	  7699: ; [0B]: vertical distance
                            	  7700: ;
                            	  7701: ;
                            	  7702: ; Reset [06] to indicate no collision by default.
                            	  7703: ;
                            	  7704:     even
                            	  7705: DoObjectsCollideWithThresholds:
02:0003220C 7000            	  7706:     moveq   #0,D0
02:0003220E 19400006        	  7707:     move.b  D0,($0006,A4)
02:00032212 7600            	  7708:     moveq   #0,D3
02:00032214 1614            	  7709:     move.b  ($0000,A4),D3
                            	  7710:     ; Store in [0A] the horizontal distance between the two objects.
                            	  7711:     ;
02:00032216 102C0002        	  7712:     move.b  ($0002,A4),D0
02:0003221A 003C0011        	  7713:     ori     #$11,CCR  ; SEC: set C+X
02:0003221E 122C0004        	  7714:     move.b  ($0004,A4),D1
02:00032222 0A3C0010        	  7715:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032226 9101            	  7716:     subx.b  D1,D0   ; SBC $04
02:00032228 0A3C0010        	  7717:     eori    #$10,CCR  ; restore X = 6502 C
02:0003222C 6100E8EC        	  7718:     jsr     Abs
02:00032230 1940000A        	  7719:     move.b  D0,($000A,A4)
                            	  7720:     ; If distance >= horizontal threshold in [0D], return 0.
                            	  7721:     ;
02:00032234 122C000D        	  7722:     move.b  ($000D,A4),D1
02:00032238 B001            	  7723:     cmp.b   D1,D0
02:0003223A 642A            	  7724:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7725:     ; Store in [0B] the vertical distance between the two objects.
                            	  7726:     ;
02:0003223C 102C0003        	  7727:     move.b  ($0003,A4),D0
02:00032240 003C0011        	  7728:     ori     #$11,CCR  ; SEC: set C+X
02:00032244 122C0005        	  7729:     move.b  ($0005,A4),D1
02:00032248 0A3C0010        	  7730:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003224C 9101            	  7731:     subx.b  D1,D0   ; SBC $05
02:0003224E 0A3C0010        	  7732:     eori    #$10,CCR  ; restore X = 6502 C
02:00032252 6100E8C6        	  7733:     jsr     Abs
02:00032256 1940000B        	  7734:     move.b  D0,($000B,A4)
                            	  7735:     ; If distance >= vertical threshold in [0E], return 0.
                            	  7736:     ;
02:0003225A 122C000E        	  7737:     move.b  ($000E,A4),D1
02:0003225E B001            	  7738:     cmp.b   D1,D0
02:00032260 6404            	  7739:     bcc  _L_z01_DoObjectsCollideWithThresholds_ReturnValue
                            	  7740:     ; If we get here, then the objects are close enough in both axes.
                            	  7741:     ; Return 1.
                            	  7742:     ;
02:00032262 522C0006        	  7743:     addq.b  #1,($0006,A4)
                            	  7744:     even
                            	  7745: _L_z01_DoObjectsCollideWithThresholds_ReturnValue:
02:00032266 102C0006        	  7746:     move.b  ($0006,A4),D0
02:0003226A 4E75            	  7747:     rts
                            	  7748: 
                            	  7749: ; Params:
                            	  7750: ; X: caller's object index, a monster
                            	  7751: ;    the attacker, if monster attacks Link
                            	  7752: ;    else defender, if weapon attacks monster
                            	  7753: ; [00]: 0 if monster attacks Link (defender),
                            	  7754: ;       else weapon slot (attacker)
                            	  7755: ; [09]: damage type,
                            	  7756: ;       only if a monster is defending
                            	  7757: ; TODO:
                            	  7758: ; [0B]: direction
                            	  7759: ;
                            	  7760: ; Only monsters (and fire) call this routine.
                            	  7761: ;
                            	  7762: ; When monsters attack Link, they set [00] to 0 for Link's slot.
                            	  7763: ;
                            	  7764: ; On the other hand, if a weapon attacks a monster,
                            	  7765: ; the monster sets [00] to the weapon's slot.
                            	  7766: ;
                            	  7767: ;
                            	  7768: ; If a weapon attacks a monster, and the weapon's damage
                            	  7769: ; type matches the monster's invincibility mask;
                            	  7770: ; then return without shoving.
                            	  7771: ;
                            	  7772: ; If a monster attacks Link, then damage type will be 0.
                            	  7773: ;
                            	  7774:     even
                            	  7775: BeginShove:
02:0003226C 7600            	  7776:     moveq   #0,D3
02:0003226E 1614            	  7777:     move.b  ($0000,A4),D3
02:00032270 0C02000D        	  7778:     cmpi.b  #$0D,D2
02:00032274 6412            	  7779:     bcc  _anon_z01_99
02:00032276 41EC04B2        	  7780:     lea     ($04B2,A4),A0
02:0003227A 10302000        	  7781:     move.b  (A0,D2.W),D0
02:0003227E 122C0009        	  7782:     move.b  ($0009,A4),D1
02:00032282 C001            	  7783:     and.b  D1,D0
02:00032284 660000C4        	  7784:     bne  _L_z01_BeginShove_Exit
                            	  7785: _anon_z01_99:
                            	  7786:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7787:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7788:     ;
                            	  7789:     ; If instead a monster is defending, then all this calculation
                            	  7790:     ; won't matter, because the shove direction will be set to the
                            	  7791:     ; weapon's direction.
                            	  7792:     ;
                            	  7793:     ; As such, calculate a direction from the monster to the defender,
                            	  7794:     ; assuming it's Link.
                            	  7795:     ;
                            	  7796:     ; Start with an assumption that the direction is vertical:
                            	  7797:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7798:     ;
02:00032288 7008            	  7799:     moveq   #8,D0
02:0003228A 19400008        	  7800:     move.b  D0,($0008,A4)
02:0003228E 41EC0084        	  7801:     lea     ($0084,A4),A0
02:00032292 10302000        	  7802:     move.b  (A0,D2.W),D0
02:00032296 19400004        	  7803:     move.b  D0,($0004,A4)
02:0003229A 41EC0084        	  7804:     lea     ($0084,A4),A0
02:0003229E 10303000        	  7805:     move.b  (A0,D3.W),D0
02:000322A2 19400005        	  7806:     move.b  D0,($0005,A4)
                            	  7807:     ; If the defender is Link and his grid offset <> 0 then
                            	  7808:     ; use his usual object direction variable to determine
                            	  7809:     ; which axis to check.
                            	  7810:     ;
02:000322A6 4A03            	  7811:     cmpi.b  #$00,D3
02:000322A8 6612            	  7812:     bne  _anon_z01_100
02:000322AA 102C0394        	  7813:     move.b  ($0394,A4),D0
02:000322AE 670C            	  7814:     beq  _anon_z01_100
02:000322B0 102C0098        	  7815:     move.b  ($0098,A4),D0
02:000322B4 02000003        	  7816:     andi.b #$03,D0
02:000322B8 660C            	  7817:     bne  _L_z01_BeginShove_CheckHorizontal
02:000322BA 6720            	  7818:     beq  _L_z01_BeginShove_CheckVertical
                            	  7819: _anon_z01_100:
                            	  7820:     ; For monsters defending, or Link with grid offset = 0,
                            	  7821:     ; check direction in [0B].
                            	  7822:     ;
                            	  7823:     ; For monsters defending, this won't matter. For Link with grid
                            	  7824:     ; offset = 0, I believe the result will be arbitrary.
                            	  7825:     ;
                            	  7826:     ; TODO:
                            	  7827:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7828:     ; It doesn't seem to be if candle fire attacks him.
                            	  7829:     ;
02:000322BC 102C000B        	  7830:     move.b  ($000B,A4),D0
02:000322C0 0C000004        	  7831:     cmpi.b  #$04,D0
02:000322C4 6416            	  7832:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7833:     even
                            	  7834: _L_z01_BeginShove_CheckHorizontal:
                            	  7835:     ; If the direction checked is left or right,
                            	  7836:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7837:     ;
02:000322C6 7002            	  7838:     moveq   #2,D0
02:000322C8 19400008        	  7839:     move.b  D0,($0008,A4)
02:000322CC 10342070        	  7840:     move.b  ($70,A4,D2.W),D0
02:000322D0 19400004        	  7841:     move.b  D0,($0004,A4)
02:000322D4 10343070        	  7842:     move.b  ($70,A4,D3.W),D0
02:000322D8 19400005        	  7843:     move.b  D0,($0005,A4)
                            	  7844:     even
                            	  7845: _L_z01_BeginShove_CheckVertical:
                            	  7846:     ; If the monster is down or right of the other object,
                            	  7847:     ; then use the opposite direction already in [08].
                            	  7848:     ; Else shift [08] right to turn it into the opposite
                            	  7849:     ; direction up or down.
                            	  7850:     ;
                            	  7851:     ; Again assuming Link is the defender; after this, [08] points
                            	  7852:     ; Link away from the monster.
                            	  7853:     ;
02:000322DC 102C0004        	  7854:     move.b  ($0004,A4),D0
02:000322E0 122C0005        	  7855:     move.b  ($0005,A4),D1
02:000322E4 B001            	  7856:     cmp.b   D1,D0
02:000322E6 640A            	  7857:     bcc  _anon_z01_101
02:000322E8 122C0008        	  7858:     move.b  ($0008,A4),D1
02:000322EC E209            	  7859:     lsr.b  #1,D1   ; LSR $08
02:000322EE 19410008        	  7860:     move.b  D1,($0008,A4)
                            	  7861: _anon_z01_101:
                            	  7862:     ; If a monster is the defender, go handle it separately.
                            	  7863:     ;
02:000322F2 4A03            	  7864:     cmpi.b  #$00,D3
02:000322F4 6656            	  7865:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7866:     ; Link is the defender.
                            	  7867:     ;
                            	  7868:     ; If Link is invincible, return without shoving.
                            	  7869:     ;
02:000322F6 102C04F0        	  7870:     move.b  ($04F0,A4),D0
02:000322FA 664E            	  7871:     bne  _L_z01_BeginShove_Exit
                            	  7872:     ; Store the shove direction we determined.
                            	  7873:     ;
                            	  7874:     ; Turn on the high bit to indicate that the next time we try to
                            	  7875:     ; move by shoving, it will be the first time for this shove action.
                            	  7876:     ;
02:000322FC 102C0008        	  7877:     move.b  ($0008,A4),D0
02:00032300 00000080        	  7878:     ori.b #$80,D0
02:00032304 194000C0        	  7879:     move.b  D0,($00C0,A4)
                            	  7880:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7881:     ;
02:00032308 7018            	  7882:     moveq   #24,D0
02:0003230A 194004F0        	  7883:     move.b  D0,($04F0,A4)
02:0003230E 7020            	  7884:     moveq   #32,D0
02:00032310 194000D3        	  7885:     move.b  D0,($00D3,A4)
                            	  7886:     ; If Link was shoved by one of his own weapons, then
                            	  7887:     ; nothing else to do. Return.
                            	  7888:     ;
02:00032314 0C02000D        	  7889:     cmpi.b  #$0D,D2
02:00032318 6430            	  7890:     bcc  _L_z01_BeginShove_Exit
                            	  7891:     ; Link was shoved by a monster.
                            	  7892:     ;
                            	  7893:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7894:     ; then return.
                            	  7895:     ;
02:0003231A 41EC04BF        	  7896:     lea     ($04BF,A4),A0
02:0003231E 10302000        	  7897:     move.b  (A0,D2.W),D0
02:00032322 02000080        	  7898:     andi.b #$80,D0
02:00032326 6622            	  7899:     bne  _L_z01_BeginShove_Exit
                            	  7900:     ; If the attacker is a vire, then return.
                            	  7901:     ;
02:00032328 41EC034F        	  7902:     lea     ($034F,A4),A0
02:0003232C 10302000        	  7903:     move.b  (A0,D2.W),D0
02:00032330 0C000012        	  7904:     cmpi.b  #$12,D0
02:00032334 6714            	  7905:     beq  _L_z01_BeginShove_Exit
                            	  7906:     ; Turn the attacker in the opposite direction.
                            	  7907:     ;
02:00032336 41EC0098        	  7908:     lea     ($0098,A4),A0
02:0003233A 10302000        	  7909:     move.b  (A0,D2.W),D0
02:0003233E 6100E7D6        	  7910:     jsr     GetOppositeDir
02:00032342 41EC0098        	  7911:     lea     ($0098,A4),A0
02:00032346 11802000        	  7912:     move.b  D0,(A0,D2.W)
                            	  7913:     even
                            	  7914: _L_z01_BeginShove_Exit:
02:0003234A 4E75            	  7915:     rts
                            	  7916: 
                            	  7917:     even
                            	  7918: _L_z01_BeginShove_MonsterDefender:
                            	  7919:     ; A monster is the defender. A weapon is the attacker.
                            	  7920:     ;
                            	  7921:     ; Set the shove direction to the weapon's direction,
                            	  7922:     ; instead of the direction passed in [0B].
                            	  7923:     ;
02:0003234C 41EC0098        	  7924:     lea     ($0098,A4),A0
02:00032350 10303000        	  7925:     move.b  (A0,D3.W),D0
02:00032354 19400008        	  7926:     move.b  D0,($0008,A4)
                            	  7927:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7928:     ; combine the shove direction with $40.
                            	  7929:     ;
                            	  7930:     ; TODO:
                            	  7931:     ; But the shoving routing doesn't read this flag.
                            	  7932:     ;
02:00032358 41EC04BF        	  7933:     lea     ($04BF,A4),A0
02:0003235C 10302000        	  7934:     move.b  (A0,D2.W),D0
02:00032360 02000080        	  7935:     andi.b #$80,D0
02:00032364 670C            	  7936:     beq  _anon_z01_102
02:00032366 102C0008        	  7937:     move.b  ($0008,A4),D0
02:0003236A 00000040        	  7938:     ori.b #$40,D0
02:0003236E 19400008        	  7939:     move.b  D0,($0008,A4)
                            	  7940: _anon_z01_102:
                            	  7941:     ; If the monster is invincible, then return without shoving.
