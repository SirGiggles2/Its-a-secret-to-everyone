                            	   826:     ;   $C0: 2
                            	   827:     ;
02:0002E1BC 7602            	   828:     moveq   #2,D3
02:0002E1BE 0C0000C0        	   829:     cmpi.b  #$C0,D0
02:0002E1C2 670A            	   830:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E1C4 5303            	   831:     subq.b  #1,D3
02:0002E1C6 0C000040        	   832:     cmpi.b  #$40,D0
02:0002E1CA 6702            	   833:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
