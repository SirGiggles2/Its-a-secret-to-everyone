                            	 11155: __far_z_04_0107:
                            	 11156:     ; The segment is not a head nor bottom. So, we can use a
                            	 11157:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11158:     ; that is drawn under Link and the heads.
                            	 11159:     ;
02:0003E6DC 4EB9000319AA    	 11160:     jsr     Anim_WriteLevelPaletteSprite
                            	 11161:     even
                            	 11162: Gleeok_CheckCollisions:
                            	 11163:     ; If this segment is not the head nor the bottom of the neck,
                            	 11164:     ; then loop again to process the next segment.
                            	 11165:     ;
                            	 11166:     ; This kind of segment is only drawn, and is not checked
                            	 11167:     ; for object collisions.
                            	 11168:     ;
02:0003E6E2 0C020005        	 11169:     cmpi.b  #$05,D2
02:0003E6E6 670A            	 11170:     beq  _anon_z04_141
02:0003E6E8 0C020001        	 11171:     cmpi.b  #$01,D2
02:0003E6EC 6704            	 11172:     beq  _anon_z04_141
02:0003E6EE 6000010C        	 11173:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11174: 
                            	 11175: _anon_z04_141:
02:0003E6F2 4EB900031A30    	 11176:     jsr     CheckMonsterCollisions
                            	 11177:     ; If this segment was harmed, then set the writhing counter,
                            	 11178:     ; and the animation counter to its lower value.
                            	 11179:     ;
02:0003E6F8 41EC00C0        	 11180:     lea     ($00C0,A4),A0
02:0003E6FC 10302000        	 11181:     move.b  (A0,D2.W),D0
02:0003E700 670A            	 11182:     beq  _anon_z04_142
02:0003E702 7006            	 11183:     moveq   #6,D0
02:0003E704 194004E6        	 11184:     move.b  D0,($04E6,A4)
02:0003E708 19400510        	 11185:     move.b  D0,($0510,A4)
                            	 11186: _anon_z04_142:
02:0003E70C 4EB90004BBA6    	 11187:     jsr     ResetShoveInfo
                            	 11188:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11189:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11190:     ;
02:0003E712 0C020001        	 11191:     cmpi.b  #$01,D2
02:0003E716 670000DE        	 11192:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E71A 6100B064        	 11193:     jsr     PlayBossHitCryIfNeeded
                            	 11194:     ; If this neck has not died, then go loop again.
                            	 11195:     ;
02:0003E71E 41EC0405        	 11196:     lea     ($0405,A4),A0
02:0003E722 10302000        	 11197:     move.b  (A0,D2.W),D0
02:0003E726 670000D4        	 11198:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11199:     ; This neck died. So, prepare to make a flying head.
                            	 11200:     ;
02:0003E72A 7060            	 11201:     moveq   #96,D0
02:0003E72C 41EC0485        	 11202:     lea     ($0485,A4),A0
02:0003E730 11802000        	 11203:     move.b  D0,(A0,D2.W)
02:0003E734 1002            	 11204:     move.b  D2,D0
02:0003E736 1B00            	 11205:     move.b  D0,-(A5)  ; PHA
                            	 11206:     ; If the segment is not a head, then skip making a flying head.
                            	 11207:     ;
                            	 11208:     ; TODO:
                            	 11209:     ; But how can we get here in this case, since earlier branches
                            	 11210:     ; would have been taken to skip all this for all other segments?
                            	 11211:     ;
02:0003E738 0C020005        	 11212:     cmpi.b  #$05,D2
02:0003E73C 663C            	 11213:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11214:     ; The flying head will go in slot (neck index + 7).
                            	 11215:     ; Switch the X register to it.
                            	 11216:     ;
02:0003E73E 102C04D7        	 11217:     move.b  ($04D7,A4),D0
02:0003E742 023C00EE        	 11218:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E746 123C0007        	 11219:     move.b  #$07,D1
02:0003E74A D101            	 11220:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E74C 7400            	 11221:     moveq   #0,D2
02:0003E74E 1400            	 11222:     move.b  D0,D2
                            	 11223:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11224:     ;
02:0003E750 103C00FF        	 11225:     move.b  #$FF,D0
02:0003E754 41EC0492        	 11226:     lea     ($0492,A4),A0
02:0003E758 11802000        	 11227:     move.b  D0,(A0,D2.W)
                            	 11228:     ; Copy the original head's coordinates to it.
                            	 11229:     ;
02:0003E75C 102C0075        	 11230:     move.b  ($0075,A4),D0
02:0003E760 19802070        	 11231:     move.b  D0,($70,A4,D2.W)
02:0003E764 102C0089        	 11232:     move.b  ($0089,A4),D0
02:0003E768 41EC0084        	 11233:     lea     ($0084,A4),A0
02:0003E76C 11802000        	 11234:     move.b  D0,(A0,D2.W)
                            	 11235:     ; Set object type $46 (flying head).
                            	 11236:     ;
02:0003E770 7046            	 11237:     moveq   #70,D0
02:0003E772 41EC034F        	 11238:     lea     ($034F,A4),A0
02:0003E776 11802000        	 11239:     move.b  D0,(A0,D2.W)
                            	 11240:     even
                            	 11241: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E77A 101D            	 11242:     move.b  (A5)+,D0  ; PLA
02:0003E77C 7400            	 11243:     moveq   #0,D2
02:0003E77E 1400            	 11244:     move.b  D0,D2
                            	 11245:     ; Hide the original head's sprite, and the base segment's sprite.
