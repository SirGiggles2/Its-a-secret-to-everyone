02:00033634 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:00033636 1002            	   594:     move.b  D2,D0
02:00033638 E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
