                            	   314:     ; PATCHED: NOP — audio data requires NES bank mapping not yet implemented.
02:0002CA0C 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002CA0E 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002CA12 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002CA14 7000            	   323:     moveq   #0,D0
02:0002CA16 6100E45C        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:0002CA1A 700F            	   325:     moveq   #15,D0
02:0002CA1C 6100E456        	   326:     jsr     _apu_write_4015  ; APU/IO write
02:0002CA20 6618            	   327:     bne  _L_z00_DriveAudio_Paused
                            	   328:     even
                            	   329: _L_z00_DriveAudio_Play:
