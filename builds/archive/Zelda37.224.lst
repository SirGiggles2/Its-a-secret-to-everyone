02:0004CB32 1214            	  6141:     move.b  ($0000,A4),D1
02:0004CB34 D101            	  6142:     addx.b  D1,D0   ; ADC $00
02:0004CB36 1880            	  6143:     move.b  D0,($0000,A4)
02:0004CB38 41EC0084        	  6144:     lea     ($0084,A4),A0
02:0004CB3C 10302000        	  6145:     move.b  (A0,D2.W),D0
02:0004CB40 023C00EE        	  6146:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CB44 122C0001        	  6147:     move.b  ($0001,A4),D1
02:0004CB48 D101            	  6148:     addx.b  D1,D0   ; ADC $01
