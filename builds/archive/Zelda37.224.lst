02:0004C52A 1940000F        	  5266:     move.b  D0,($000F,A4)
                            	  5267:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5268:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5269:     ;
02:0004C52E 7603            	  5270:     moveq   #3,D3
                            	  5271:     even
                            	  5272: _L_z07_SpreadShot_DrawShotCorner:
02:0004C530 1003            	  5273:     move.b  D3,D0
02:0004C532 1B00            	  5274:     move.b  D0,-(A5)  ; PHA
                            	  5275:     ; Save offset X [02] and Y offset [03].
                            	  5276:     ;
02:0004C534 102C0002        	  5277:     move.b  ($0002,A4),D0
02:0004C538 1B00            	  5278:     move.b  D0,-(A5)  ; PHA
02:0004C53A 102C0003        	  5279:     move.b  ($0003,A4),D0
02:0004C53E 1B00            	  5280:     move.b  D0,-(A5)  ; PHA
                            	  5281:     ; Calculate and set sprite attributes for this corner:
                            	  5282:     ;   base attribute OR (frame counter AND 3)
                            	  5283:     ;
                            	  5284:     ; The base attribute defines how to flip the sprite.
                            	  5285:     ; The frame counter makes the shot flash by cycling each
                            	  5286:     ; palette row.
                            	  5287:     ;
02:0004C540 102C0015        	  5288:     move.b  ($0015,A4),D0
02:0004C544 02000003        	  5289:     andi.b #$03,D0
02:0004C548 41F90004C3A6    	  5290:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C54E 12303000        	  5291:     move.b  (A0,D3.W),D1
02:0004C552 8001            	  5292:     or.b  D1,D0
02:0004C554 4EB9000319A6    	  5293:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5294:     ; Add the object's X (the center of the spread) and the
                            	  5295:     ; current offset in [02] to set sprite X in [00].
                            	  5296:     ;
02:0004C55A 10342070        	  5297:     move.b  ($70,A4,D2.W),D0
02:0004C55E 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C562 122C0002        	  5299:     move.b  ($0002,A4),D1
02:0004C566 D101            	  5300:     addx.b  D1,D0   ; ADC $02
02:0004C568 1880            	  5301:     move.b  D0,($0000,A4)
                            	  5302:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5303:     ; Else calculate the distance from object X to sprite X.
                            	  5304:     ;
02:0004C56A 12342070        	  5305:     move.b  ($70,A4,D2.W),D1
02:0004C56E B001            	  5306:     cmp.b   D1,D0
02:0004C570 651A            	  5307:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C572 0C0000FC        	  5308:     cmpi.b  #$FC,D0
02:0004C576 6466            	  5309:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C578 003C0011        	  5310:     ori     #$11,CCR  ; SEC: set C+X
02:0004C57C 12342070        	  5311:     move.b  ($70,A4,D2.W),D1
02:0004C580 0A3C0010        	  5312:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C584 9101            	  5313:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C586 0A3C0010        	  5314:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C58A 6014            	  5315:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5316: 
                            	  5317:     even
                            	  5318: _L_z07_SpreadShot_ReverseSub:
02:0004C58C 10342070        	  5319:     move.b  ($70,A4,D2.W),D0
02:0004C590 003C0011        	  5320:     ori     #$11,CCR  ; SEC: set C+X
02:0004C594 1214            	  5321:     move.b  ($0000,A4),D1
02:0004C596 0A3C0010        	  5322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C59A 9101            	  5323:     subx.b  D1,D0   ; SBC $00
02:0004C59C 0A3C0010        	  5324:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5325:     even
                            	  5326: _L_z07_SpreadShot_CheckDistance:
                            	  5327:     ; If distance >= $20, skip this corner.
