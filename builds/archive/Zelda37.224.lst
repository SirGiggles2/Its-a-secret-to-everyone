                            	  3201: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3202:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3203:     ; the mound frame images:
                            	  3204:     ;
                            	  3205:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3206:     ;
                            	  3207:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3208:     ;
                            	  3209:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3210:     ;
02:0003ACCC 003C0011        	  3211:     ori     #$11,CCR  ; SEC: set C+X
02:0003ACD0 123C0001        	  3212:     move.b  #$01,D1
02:0003ACD4 0A3C0010        	  3213:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ACD8 9101            	  3214:     subx.b  D1,D0   ; SBC #$01
02:0003ACDA 0A3C0010        	  3215:     eori    #$10,CCR  ; restore X = 6502 C
02:0003ACDE E308            	  3216:     lsl.b  #1,D0   ; ASL A
02:0003ACE0 023C00EE        	  3217:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ACE4 41EC03E4        	  3218:     lea     ($03E4,A4),A0
02:0003ACE8 12302000        	  3219:     move.b  (A0,D2.W),D1
02:0003ACEC D101            	  3220:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  3221:     even
