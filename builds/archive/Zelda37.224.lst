02:0003CE04 8001            	  7856:     or.b  D1,D0
02:0003CE06 660000AE        	  7857:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7858:     ; Every odd screen frame, go straight to drawing
                            	  7859:     ; and checking collisions.
