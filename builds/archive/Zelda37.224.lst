02:0003692C 142C0016        	  5252:     move.b  ($0016,A4),D2
02:00036930 41EC062D        	  5253:     lea     ($062D,A4),A0
02:00036934 10302000        	  5254:     move.b  (A0,D2.W),D0
                            	  5255:     ; In the second quest, skip lines $C to $F.
