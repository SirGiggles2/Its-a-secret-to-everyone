                            	   748: _anon_z01_7:
02:0002E11C 41F90002E0F6    	   749:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E122 10303000        	   750:     move.b  (A0,D3.W),D0
02:0002E126 41EC0302        	   751:     lea     ($0302,A4),A0
02:0002E12A 11803000        	   752:     move.b  D0,(A0,D3.W)
