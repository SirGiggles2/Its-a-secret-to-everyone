                            	  5380: _L_z01_TakeItem_SkipLift:
                            	  5381:     ; Look up the item slot and sprite attributes by the item type.
                            	  5382:     ;
02:00031100 7400            	  5383:     moveq   #0,D2
02:00031102 1400            	  5384:     move.b  D0,D2
02:00031104 41F900030FA6    	  5385:     lea     (ItemIdToSlot).l,A0
02:0003110A 10302000        	  5386:     move.b  (A0,D2.W),D0
02:0003110E 7600            	  5387:     moveq   #0,D3
02:00031110 1600            	  5388:     move.b  D0,D3
02:00031112 41F900030FCA    	  5389:     lea     (ItemIdToDescriptor).l,A0
02:00031118 10302000        	  5390:     move.b  (A0,D2.W),D0
                            	  5391:     ; [0A] holds the item value from the low nibble of descriptor.
                            	  5392:     ;
02:0003111C 1B00            	  5393:     move.b  D0,-(A5)  ; PHA
02:0003111E 0200000F        	  5394:     andi.b #$0F,D0
