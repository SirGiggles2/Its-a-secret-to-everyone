                            	  6801: Aquamentus_Shoot:
                            	  6802:     ; If the object timer <> 0, then
                            	  6803:     ; go modify fireballs that might still be flying.
                            	  6804:     ;
02:0003C6E6 10342028        	  6805:     move.b  ($28,A4,D2.W),D0
02:0003C6EA 6634            	  6806:     bne  _L_z04_Aquamentus_Shoot_SpreadOutFireballs
                            	  6807:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  6808:     ;
                            	  6809:     ; Set the timer to a random time, at least $70 frames.
                            	  6810:     ;
02:0003C6EC 10342018        	  6811:     move.b  ($18,A4,D2.W),D0
02:0003C6F0 00000070        	  6812:     ori.b #$70,D0
02:0003C6F4 19802028        	  6813:     move.b  D0,($28,A4,D2.W)
                            	  6814:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  6815:     ;
02:0003C6F8 6168            	  6816:     jsr     ShootFireball55
02:0003C6FA 7000            	  6817:     moveq   #0,D0
02:0003C6FC 41EC0478        	  6818:     lea     ($0478,A4),A0
02:0003C700 11803000        	  6819:     move.b  D0,(A0,D3.W)
                            	  6820:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  6821:     ;
02:0003C704 615C            	  6822:     jsr     ShootFireball55
02:0003C706 7001            	  6823:     moveq   #1,D0
02:0003C708 41EC0478        	  6824:     lea     ($0478,A4),A0
02:0003C70C 11803000        	  6825:     move.b  D0,(A0,D3.W)
                            	  6826:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  6827:     ;
02:0003C710 6150            	  6828:     jsr     ShootFireball55
02:0003C712 103C00FF        	  6829:     move.b  #$FF,D0
02:0003C716 41EC0478        	  6830:     lea     ($0478,A4),A0
02:0003C71A 11803000        	  6831:     move.b  D0,(A0,D3.W)
02:0003C71E 4E75            	  6832:     rts
