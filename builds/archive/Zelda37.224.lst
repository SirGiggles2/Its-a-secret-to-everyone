                            	   239:     ; Calculate horizontal distance and direction away from chase target.
                            	   240:     ; Store the distance in [00].
                            	   241:     ;
02:000397A6 7602            	   242:     moveq   #2,D3
02:000397A8 102C0061        	   243:     move.b  ($0061,A4),D0
02:000397AC 003C0011        	   244:     ori     #$11,CCR  ; SEC: set C+X
02:000397B0 12342070        	   245:     move.b  ($70,A4,D2.W),D1
02:000397B4 0A3C0010        	   246:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000397B8 9101            	   247:     subx.b  D1,D0   ; SBC ObjX,X
02:000397BA 0A3C0010        	   248:     eori    #$10,CCR  ; restore X = 6502 C
