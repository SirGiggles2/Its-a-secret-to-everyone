02:0003AEA0 670A            	  3454:     beq  _L_z04_UpdateRedLeever_CheckStunned
02:0003AEA2 4EB90004BB46    	  3455:     jsr     Obj_Shove
02:0003AEA8 600000AE        	  3456:     jmp     RedLeever_AnimateAndCheckCollisions
                            	  3457: 
                            	  3458:     even
                            	  3459: _L_z04_UpdateRedLeever_CheckStunned:
                            	  3460:     ; If we have the magic clock or the leever is stunned, then
                            	  3461:     ; go animate, draw, and check for collisions.
                            	  3462:     ;
02:0003AEAC 102C066C        	  3463:     move.b  ($066C,A4),D0
02:0003AEB0 1234203D        	  3464:     move.b  ($3D,A4,D2.W),D1
02:0003AEB4 8001            	  3465:     or.b  D1,D0
02:0003AEB6 6704            	  3466:     beq.s  __far_z_04_0030
02:0003AEB8 6000009E        	  3467:     jmp  RedLeever_AnimateAndCheckCollisions
                            	  3468: __far_z_04_0030:
                            	  3469:     ; If the leever is blocked by a tile or the room boundary,
                            	  3470:     ; then go to the next state, in addition to animating, drawing,
                            	  3471:     ; and checking for collisions.
                            	  3472:     ;
