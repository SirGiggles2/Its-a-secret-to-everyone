                            	  2352:     even
                            	  2353: _L_z04__TryShooting_TryShootingNow:
                            	  2354:     ; Summary
                            	  2355:     ;
                            	  2356:     ; if temporarily invincible then
                            	  2357:     ;   shoot timer := 0
                            	  2358:     ; elif shoot timer > 0 then
                            	  2359:     ;   decrement shoot timer
                            	  2360:     ; elif wants to shoot then
                            	  2361:     ;   shoot timer := $30
                            	  2362:     ;
                            	  2363:     ; qspeed := [01]
                            	  2364:     ;
                            	  2365:     ; if shoot timer <> 0 then
                            	  2366:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2367:     ;     shoot
                            	  2368:     ;     if succeeded then
                            	  2369:     ;       shoot timer := 0
                            	  2370:     ;       qspeed := 0
                            	  2371:     ;   else
                            	  2372:     ;     qspeed := 0
                            	  2373:     ;
                            	  2374:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003A6F0 102C0001        	  2375:     move.b  ($0001,A4),D0
02:0003A6F4 1883            	  2376:     move.b  D3,($0000,A4)
02:0003A6F6 1B00            	  2377:     move.b  D0,-(A5)  ; PHA
02:0003A6F8 7600            	  2378:     moveq   #0,D3
                            	  2379:     ; If not temporarily invincible,
                            	  2380:     ;
02:0003A6FA 41EC04F0        	  2381:     lea     ($04F0,A4),A0
02:0003A6FE 10302000        	  2382:     move.b  (A0,D2.W),D0
02:0003A702 661A            	  2383:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2384:     ; then Y := shoot timer - 1
                            	  2385:     ;
02:0003A704 7600            	  2386:     moveq   #0,D3
02:0003A706 41EC0451        	  2387:     lea     ($0451,A4),A0
02:0003A70A 16302000        	  2388:     move.b  (A0,D2.W),D3
02:0003A70E 5303            	  2389:     subq.b  #1,D3
                            	  2390:     ; If Y register < 0, then shoot timer is 0.
                            	  2391:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2392:     ; Else go set a non-zero speed and return.
                            	  2393:     ;
02:0003A710 6A0C            	  2394:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003A712 41EC0412        	  2395:     lea     ($0412,A4),A0
02:0003A716 10302000        	  2396:     move.b  (A0,D2.W),D0
02:0003A71A 6736            	  2397:     beq  _L_z04__TryShooting_SetSpeed
02:0003A71C 7630            	  2398:     moveq   #48,D3
                            	  2399:     even
