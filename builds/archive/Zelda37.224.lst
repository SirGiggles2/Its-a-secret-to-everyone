                            	   817: SwitchToNT1:
                            	   818:     ; When we begin scrolling left, CurHScroll = 0 and base
                            	   819:     ; nametable is 0. This shows the current room completely.
                            	   820:     ;
                            	   821:     ; The first time in ScrollWorld, the speed [00] will be
                            	   822:     ; subtracted from CurHScroll to show most of NT 0, and
                            	   823:     ; a little of NT 1 to its left. In other words, the
                            	   824:     ; scroll position now refers to a position in NT 1.
                            	   825:     ;
                            	   826:     ; [01] is this first position shown in NT 1. So, once
                            	   827:     ; CurHScroll matches it (in the first call to this routine),
                            	   828:     ; turn on this flag that makes NT 1 the base nametable.
02:0004058A 7001            	   829:     moveq   #1,D0
02:0004058C 1940005F        	   830:     move.b  D0,($005F,A4)
                            	   831:     even
