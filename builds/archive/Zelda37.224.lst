02:0004C908 7000            	  5844:     moveq   #0,D0
02:0004C90A 41EC0394        	  5845:     lea     ($0394,A4),A0
02:0004C90E 11802000        	  5846:     move.b  D0,(A0,D2.W)
                            	  5847:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5848:     ;
02:0004C912 7040            	  5849:     moveq   #64,D0
02:0004C914 41EC03BC        	  5850:     lea     ($03BC,A4),A0
02:0004C918 11802000        	  5851:     move.b  D0,(A0,D2.W)
                            	  5852:     ; If facing left and X < 2, then go change state to $40. The
                            	  5853:     ; boomerang is too close to the left edge of the screen.
                            	  5854:     ; Another move might make it wrap around.
                            	  5855:     ;
02:0004C91C 41EC0098        	  5856:     lea     ($0098,A4),A0
