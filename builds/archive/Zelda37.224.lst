02:0004C5A4 6438            	  5330:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5331:     ; Add the object's Y (the center of the spread) and the
                            	  5332:     ; current offset in [03] to set sprite Y in [01].
                            	  5333:     ;
02:0004C5A6 41EC0084        	  5334:     lea     ($0084,A4),A0
02:0004C5AA 10302000        	  5335:     move.b  (A0,D2.W),D0
02:0004C5AE 023C00EE        	  5336:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C5B2 122C0003        	  5337:     move.b  ($0003,A4),D1
02:0004C5B6 D101            	  5338:     addx.b  D1,D0   ; ADC $03
02:0004C5B8 19400001        	  5339:     move.b  D0,($0001,A4)
                            	  5340:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5341:     ;
02:0004C5BC 7600            	  5342:     moveq   #0,D3
02:0004C5BE 162C0010        	  5343:     move.b  ($0010,A4),D3
02:0004C5C2 670C            	  5344:     beq  _L_z07_SpreadShot_Draw
02:0004C5C4 0C00003E        	  5345:     cmpi.b  #$3E,D0
02:0004C5C8 6514            	  5346:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C5CA 0C0000E8        	  5347:     cmpi.b  #$E8,D0
