                            	  3988: FormatHeartsInTextBuf:
                            	  3989:     ; [$0E]: hearts value
                            	  3990:     ; [$0F]: heart partial
                            	  3991:     ; Y: The offset of first character in buffer
                            	  3992:     ;
                            	  3993:     ; The end of the bottom row is $12 bytes after the
                            	  3994:     ; start of the top row. We're writing to two transfer
                            	  3995:     ; records. We write the top row in the first transfer
                            	  3996:     ; record wherever the caller chooses. The second
                            	  3997:     ; transfer record has to begin with the heart tiles.
                            	  3998:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3999:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  4000:     ;
                            	  4001:     ; Store the starting offset in [$0D].
