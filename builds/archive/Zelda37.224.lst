02:00039C20 60000088        	   814:     jmp  ResetPushTimer
                            	   815: __far_z_04_0006:
                            	   816:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   817:     ; Get the difference in X.
                            	   818:     ;
02:00039C24 7602            	   819:     moveq   #2,D3
02:00039C26 102C0070        	   820:     move.b  ($0070,A4),D0
02:00039C2A 003C0011        	   821:     ori     #$11,CCR  ; SEC: set C+X
02:00039C2E 12342070        	   822:     move.b  ($70,A4,D2.W),D1
02:00039C32 0A3C0010        	   823:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039C36 9101            	   824:     subx.b  D1,D0   ; SBC ObjX,X
02:00039C38 0A3C0010        	   825:     eori    #$10,CCR  ; restore X = 6502 C
                            	   826:     even
                            	   827: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   828:     ; If the difference in coordinates is negative, then Link is
                            	   829:     ; up or left of the block.
                            	   830:     ;
                            	   831:     ; In that case, increase Y register to index the correct opposite
                            	   832:     ; direction below. Also, negate the difference, so we test
                            	   833:     ; positive values.
                            	   834:     ;
02:00039C3C 6A08            	   835:     bpl  _anon_z04_14
02:00039C3E 5203            	   836:     addq.b  #1,D3
02:00039C40 4EB900030B1E    	   837:     jsr     Negate
                            	   838: _anon_z04_14:
                            	   839:     ; If the distance >= $11, then go reset the push timer and return.
                            	   840:     ;
02:00039C46 0C000011        	   841:     cmpi.b  #$11,D0
02:00039C4A 6502            	   842:     bcs.s  __far_z_04_0007
02:00039C4C 605C            	   843:     jmp  ResetPushTimer
                            	   844: __far_z_04_0007:
                            	   845:     ; At this point, Link is aligned with the block.
                            	   846:     ;
                            	   847:     ; If the input direction is not the required direction based on
                            	   848:     ; Link's placement; then go reset the push timer and return.
                            	   849:     ;
02:00039C4E 102C03F8        	   850:     move.b  ($03F8,A4),D0
02:00039C52 41F900039BA6    	   851:     lea     (BlockPushDirections).l,A0
02:00039C58 12303000        	   852:     move.b  (A0,D3.W),D1
02:00039C5C B001            	   853:     cmp.b   D1,D0
02:00039C5E 6702            	   854:     beq.s  __far_z_04_0008
02:00039C60 6048            	   855:     jmp  ResetPushTimer
                            	   856: __far_z_04_0008:
                            	   857:     ; Link is truly pushing the block.
                            	   858:     ;
                            	   859:     ; Increase the push timer.
                            	   860:     ;
