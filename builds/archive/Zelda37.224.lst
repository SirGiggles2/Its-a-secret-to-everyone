02:0004CB56 020000F0        	  6155:     andi.b #$F0,D0
02:0004CB5A 0C000020        	  6156:     cmpi.b  #$20,D0
02:0004CB5E 6608            	  6157:     bne  _L_z07_L_DrawArrowOrBoomerang_Draw
