02:0003C736 651E            	  6853:     bcs  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  6854:     ; Add the displacement for this fireball to its Y coordinate.
                            	  6855:     ;
02:0003C738 41EC0084        	  6856:     lea     ($0084,A4),A0
02:0003C73C 10302000        	  6857:     move.b  (A0,D2.W),D0
02:0003C740 023C00EE        	  6858:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C744 41EC0478        	  6859:     lea     ($0478,A4),A0
02:0003C748 12302000        	  6860:     move.b  (A0,D2.W),D1
02:0003C74C D101            	  6861:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003C74E 41EC0084        	  6862:     lea     ($0084,A4),A0
02:0003C752 11802000        	  6863:     move.b  D0,(A0,D2.W)
                            	  6864:     even
