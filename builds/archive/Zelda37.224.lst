                            	  1571:     ; Check collisions.
                            	  1572:     ;
                            	  1573:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1574:     ; then return.
                            	  1575:     ;
02:0003A1BA 610001F8        	  1576:     jsr     Gel_CheckCollisions
02:0003A1BE 41EC0405        	  1577:     lea     ($0405,A4),A0
02:0003A1C2 10302000        	  1578:     move.b  (A0,D2.W),D0
02:0003A1C6 664E            	  1579:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A1C8 41EC04F0        	  1580:     lea     ($04F0,A4),A0
02:0003A1CC 10302000        	  1581:     move.b  (A0,D2.W),D0
02:0003A1D0 6744            	  1582:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1583:     ; If vertically aligned with the square grid, then
                            	  1584:     ; use a horizontal direction mask (3).
                            	  1585:     ;
                            	  1586:     ; Keep in mind that most objects are aligned vertically when
                            	  1587:     ; the low nibble of their Y is $D.
                            	  1588:     ;
02:0003A1D2 7600            	  1589:     moveq   #0,D3
02:0003A1D4 41EC0084        	  1590:     lea     ($0084,A4),A0
02:0003A1D8 10302000        	  1591:     move.b  (A0,D2.W),D0
02:0003A1DC 0200000F        	  1592:     andi.b #$0F,D0
02:0003A1E0 0C00000D        	  1593:     cmpi.b  #$0D,D0
02:0003A1E4 6602            	  1594:     bne  _anon_z04_26
02:0003A1E6 7603            	  1595:     moveq   #3,D3
                            	  1596: _anon_z04_26:
02:0003A1E8 1883            	  1597:     move.b  D3,($0000,A4)
                            	  1598:     ; If horizontally aligned with the square grid, then
                            	  1599:     ; use a vertical direction mask ($C).
                            	  1600:     ;
02:0003A1EA 7600            	  1601:     moveq   #0,D3
02:0003A1EC 10342070        	  1602:     move.b  ($70,A4,D2.W),D0
02:0003A1F0 0200000F        	  1603:     andi.b #$0F,D0
02:0003A1F4 6602            	  1604:     bne  _anon_z04_27
02:0003A1F6 760C            	  1605:     moveq   #12,D3
                            	  1606: _anon_z04_27:
02:0003A1F8 1003            	  1607:     move.b  D3,D0
                            	  1608:     ; Combine the two masks. At most one will be 0.
                            	  1609:     ;
02:0003A1FA 1214            	  1610:     move.b  ($0000,A4),D1
02:0003A1FC 8001            	  1611:     or.b  D1,D0
                            	  1612:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1613:     ; with the grid.
                            	  1614:     ;
                            	  1615:     ; If so, then go to state 1 to do a "big shove".
                            	  1616:     ; Else go to state 2, to immediately split in two.
                            	  1617:     ;
                            	  1618:     ; Examples:
                            	  1619:     ; It would be aligned, if moving left along a tile as usual.
                            	  1620:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1621:     ; - The collision check routines would have made the zol
                            	  1622:     ;   face in the direction of the weapon.
                            	  1623:     ; - See CheckMonsterWeaponCollision.
                            	  1624:     ;
02:0003A1FE 122C0098        	  1625:     move.b  ($0098,A4),D1
02:0003A202 C001            	  1626:     and.b  D1,D0
02:0003A204 6608            	  1627:     bne  _anon_z04_28
02:0003A206 41EC00AC        	  1628:     lea     ($00AC,A4),A0
02:0003A20A 52302000        	  1629:     addq.b  #1,(A0,D2.W)
                            	  1630: _anon_z04_28:
02:0003A20E 41EC00AC        	  1631:     lea     ($00AC,A4),A0
02:0003A212 52302000        	  1632:     addq.b  #1,(A0,D2.W)
