                            	 13174: Ganon_DrawBody:
                            	 13175:     ; Loop over four 16x16 images that make up Ganon.
                            	 13176:     ; There are 6 animation frames.
                            	 13177:     ;
02:0003F57C 7603            	 13178:     moveq   #3,D3
                            	 13179:     even
                            	 13180: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13181:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13182:     ;
02:0003F57E 10342070        	 13183:     move.b  ($70,A4,D2.W),D0
02:0003F582 023C00EE        	 13184:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F586 41F90003F570    	 13185:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F58C 12303000        	 13186:     move.b  (A0,D3.W),D1
02:0003F590 D101            	 13187:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F592 1880            	 13188:     move.b  D0,($0000,A4)
                            	 13189:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13190:     ;
02:0003F594 41EC0084        	 13191:     lea     ($0084,A4),A0
02:0003F598 10302000        	 13192:     move.b  (A0,D2.W),D0
02:0003F59C 023C00EE        	 13193:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5A0 41F90003F574    	 13194:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F5A6 12303000        	 13195:     move.b  (A0,D3.W),D1
02:0003F5AA D101            	 13196:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F5AC 19400001        	 13197:     move.b  D0,($0001,A4)
                            	 13198:     ; Each part has a horizontal flipping flag.
                            	 13199:     ;
02:0003F5B0 41F90003F578    	 13200:     lea     (GanonSpriteHFlips).l,A0
02:0003F5B6 10303000        	 13201:     move.b  (A0,D3.W),D0
02:0003F5BA 1940000F        	 13202:     move.b  D0,($000F,A4)
                            	 13203:     ; Save and copy the loop index (the current part) to [07].
                            	 13204:     ;
02:0003F5BE 1003            	 13205:     move.b  D3,D0
02:0003F5C0 1B00            	 13206:     move.b  D0,-(A5)  ; PHA
02:0003F5C2 19400007        	 13207:     move.b  D0,($0007,A4)
                            	 13208:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13209:     ; that make it up.
                            	 13210:     ;
02:0003F5C6 41EC046B        	 13211:     lea     ($046B,A4),A0
02:0003F5CA 10302000        	 13212:     move.b  (A0,D2.W),D0
02:0003F5CE E308            	 13213:     lsl.b  #1,D0   ; ASL A
02:0003F5D0 E308            	 13214:     lsl.b  #1,D0   ; ASL A
                            	 13215:     ; Add [07] -- the index of the current part.
                            	 13216:     ;
                            	 13217:     ; Now you have an index into the frame image table, for the
                            	 13218:     ; current image part of the current animation frame.
                            	 13219:     ;
02:0003F5D2 122C0007        	 13220:     move.b  ($0007,A4),D1
02:0003F5D6 D101            	 13221:     addx.b  D1,D0   ; ADC $07
02:0003F5D8 7600            	 13222:     moveq   #0,D3
02:0003F5DA 1600            	 13223:     move.b  D0,D3
02:0003F5DC 41F90003F558    	 13224:     lea     (GanonFrameImages).l,A0
02:0003F5E2 10303000        	 13225:     move.b  (A0,D3.W),D0
02:0003F5E6 4EB9000316B4    	 13226:     jsr     DrawObjectNotMirrored
02:0003F5EC 101D            	 13227:     move.b  (A5)+,D0  ; PLA
                            	 13228:     ; Bottom of the part loop.
                            	 13229:     ;
02:0003F5EE 7600            	 13230:     moveq   #0,D3
02:0003F5F0 1600            	 13231:     move.b  D0,D3
02:0003F5F2 5303            	 13232:     subq.b  #1,D3
02:0003F5F4 6A88            	 13233:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F5F6 4E75            	 13234:     rts
