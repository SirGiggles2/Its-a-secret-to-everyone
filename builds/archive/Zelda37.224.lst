                            	  7792: _anon_z04_94:
                            	  7793:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7794:     ; This is the base frame image.
                            	  7795:     ;
02:0003CD96 E208            	  7796:     lsr.b  #1,D0   ; LSR A
02:0003CD98 E208            	  7797:     lsr.b  #1,D0   ; LSR A
                            	  7798:     ; If movement frame = 1, add 3 to frame image to access
                            	  7799:     ; the second animation frame's images.
