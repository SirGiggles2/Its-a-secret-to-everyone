02:0004CCD4 023C00EE        	  6352:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CCD8 122C0657        	  6353:     move.b  ($0657,A4),D1
02:0004CCDC D101            	  6354:     addx.b  D1,D0   ; ADC Items
02:0004CCDE 003C0011        	  6355:     ori     #$11,CCR  ; SEC: set C+X
