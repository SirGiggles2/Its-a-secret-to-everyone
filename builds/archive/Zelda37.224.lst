                            	  5929: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5930:     ; For opened doors, the provisional door face has become:
                            	  5931:     ;
                            	  5932:     ; DA PF Meaning
                            	  5933:     ; -------------
                            	  5934:     ; 0  4  open
                            	  5935:     ; 1  1  wall
                            	  5936:     ; 2  2  false wall
                            	  5937:     ; 3  3  false wall 2
                            	  5938:     ; 4  9  bombable
                            	  5939:     ; 5  4  key
                            	  5940:     ; 6  4  key 2
                            	  5941:     ; 7  4  shutter
                            	  5942:     ;
