02:0003C516 19410002        	  6578:     move.b  D1,($0002,A4)
02:0003C51A 122C0002        	  6579:     move.b  ($0002,A4),D1
02:0003C51E C200            	  6580:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
