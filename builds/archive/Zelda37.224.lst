02:0004CA2A 10303000        	  6011:     move.b  (A0,D3.W),D0
02:0004CA2E 4EB900030C42    	  6012:     jsr     SetBoomerangSpeed
02:0004CA34 102C000B        	  6013:     move.b  ($000B,A4),D0
02:0004CA38 1940000F        	  6014:     move.b  D0,($000F,A4)
02:0004CA3C 41EC0098        	  6015:     lea     ($0098,A4),A0
02:0004CA40 11802000        	  6016:     move.b  D0,(A0,D2.W)
02:0004CA44 6100F440        	  6017:     jsr     MoveObject
