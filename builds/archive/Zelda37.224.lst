                            	  6755: __far_z_01_0068:
                            	  6756:     ; If Link and the shot are not facing opposite directions,
                            	  6757:     ; then go harm Link.
                            	  6758:     ;
                            	  6759:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6760:     ; component of a monster that can move diagonally.
                            	  6761:     ;
02:00031C4C 102C0098        	  6762:     move.b  ($0098,A4),D0
02:00031C50 41EC0098        	  6763:     lea     ($0098,A4),A0
02:00031C54 12302000        	  6764:     move.b  (A0,D2.W),D1
02:00031C58 8001            	  6765:     or.b  D1,D0
02:00031C5A 0200000C        	  6766:     andi.b #$0C,D0
02:00031C5E 0C00000C        	  6767:     cmpi.b  #$0C,D0
02:00031C62 671A            	  6768:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031C64 102C0098        	  6769:     move.b  ($0098,A4),D0
02:00031C68 41EC0098        	  6770:     lea     ($0098,A4),A0
02:00031C6C 12302000        	  6771:     move.b  (A0,D2.W),D1
02:00031C70 8001            	  6772:     or.b  D1,D0
02:00031C72 02000003        	  6773:     andi.b #$03,D0
02:00031C76 0C000003        	  6774:     cmpi.b  #$03,D0
02:00031C7A 6702            	  6775:     beq.s  __far_z_01_0069
02:00031C7C 602A            	  6776:     jmp  HarmLink
                            	  6777: __far_z_01_0069:
                            	  6778:     even
                            	  6779: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6780:     ; Link and the shot are facing opposite directions.
                            	  6781:     ; Link can parry certain weapons/shots.
                            	  6782:     ;
                            	  6783:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6784:     ; no harmful collision; but it still counts as a shot collision.
                            	  6785:     ; So, go treat this as a parry.
                            	  6786:     ;
02:00031C7E 41EC034F        	  6787:     lea     ($034F,A4),A0
02:00031C82 10302000        	  6788:     move.b  (A0,D2.W),D0
02:00031C86 0C000055        	  6789:     cmpi.b  #$55,D0
02:00031C8A 650E            	  6790:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031C8C 0C00005B        	  6791:     cmpi.b  #$5B,D0
02:00031C90 6408            	  6792:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6793:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6794:     ; So, go harm Link.
                            	  6795:     ;
02:00031C92 102C0676        	  6796:     move.b  ($0676,A4),D0
02:00031C96 6602            	  6797:     bne.s  __far_z_01_0070
02:00031C98 600E            	  6798:     jmp  HarmLink
                            	  6799: __far_z_01_0070:
                            	  6800:     even
                            	  6801: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  6802:     ; Else Link parries.
                            	  6803:     ;
                            	  6804:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6805:     ;
02:00031C9A 7001            	  6806:     moveq   #1,D0
02:00031C9C 19400604        	  6807:     move.b  D0,($0604,A4)
02:00031CA0 7000            	  6808:     moveq   #0,D0
02:00031CA2 19400006        	  6809:     move.b  D0,($0006,A4)
                            	  6810:     even
