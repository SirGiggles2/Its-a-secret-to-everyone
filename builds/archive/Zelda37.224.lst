02:0003CE8E 10302000        	  7932:     move.b  (A0,D2.W),D0
02:0003CE92 0A00000C        	  7933:     eori.b #$0C,D0
02:0003CE96 41EC0098        	  7934:     lea     ($0098,A4),A0
02:0003CE9A 11802000        	  7935:     move.b  D0,(A0,D2.W)
02:0003CE9E 6000008C        	  7936:     jmp     L_PolsVoice_DrawAndCheckCollisions
