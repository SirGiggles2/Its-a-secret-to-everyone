02:00039F66 1940000F        	  1258:     move.b  D0,($000F,A4)
                            	  1259:     ; Load the horizontal q-speed and position fraction,
                            	  1260:     ; move, then save the position fraction.
                            	  1261:     ;
02:00039F6A 41EC041F        	  1262:     lea     ($041F,A4),A0
02:00039F6E 10302000        	  1263:     move.b  (A0,D2.W),D0
