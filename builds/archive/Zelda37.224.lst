02:0004CB18 1880            	  6130:     move.b  D0,($0000,A4)
02:0004CB1A 41F90004C6F0    	  6131:     lea     (RDirectionToOffsetsY).l,A0
02:0004CB20 10303000        	  6132:     move.b  (A0,D3.W),D0
02:0004CB24 19400001        	  6133:     move.b  D0,($0001,A4)
02:0004CB28 7602            	  6134:     moveq   #2,D3
                            	  6135:     even
