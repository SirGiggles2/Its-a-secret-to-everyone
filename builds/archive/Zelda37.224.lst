                            	   464: UpdateMenuScrollUp:
                            	   465:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   466:     ;
02:000402CA 103C00FD        	   467:     move.b  #$FD,D0
02:000402CE 613A            	   468:     jsr     MovePositionMarkers
02:000402D0 102C00FC        	   469:     move.b  ($00FC,A4),D0
02:000402D4 023C00EE        	   470:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402D8 123C0003        	   471:     move.b  #$03,D1
02:000402DC D101            	   472:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000402DE 194000FC        	   473:     move.b  D0,($00FC,A4)
                            	   474:     ; If hardware vertical scroll still < $F0, then return.
                            	   475:     ;
02:000402E2 0C0000F0        	   476:     cmpi.b  #$F0,D0
02:000402E6 6406            	   477:     bcc.s  __far_z_05_0004
02:000402E8 4EF90002D036    	   478:     jmp  Exit
                            	   479: __far_z_05_0004:
                            	   480:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   481:     ;
02:000402EE 1940005C        	   482:     move.b  D0,($005C,A4)
                            	   483:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   484:     ;
                            	   485:     ; UNKNOWN: But why not do this in OW, too?
                            	   486:     ;
02:000402F2 102C0010        	   487:     move.b  ($0010,A4),D0
02:000402F6 6706            	   488:     beq  _anon_z05_4
02:000402F8 4EB9000313D6    	   489:     jsr     WriteBlankPrioritySprites
                            	   490: _anon_z05_4:
                            	   491:     ; We reached the end. So, reset hardware vertical scroll
                            	   492:     ; and submenu state.
                            	   493:     ;
02:000402FE 7000            	   494:     moveq   #0,D0
02:00040300 194000FC        	   495:     move.b  D0,($00FC,A4)
02:00040304 194000E1        	   496:     move.b  D0,($00E1,A4)
                            	   497:     ; Move the position markers 2 pixels down, because we
                            	   498:     ; overshot and reached vertical scroll $F2.
                            	   499:     ;
02:00040308 7002            	   500:     moveq   #2,D0
                            	   501: ; Params:
                            	   502: ; A: vertical velocity of menu scrolling
                            	   503: ;
                            	   504: ;
                            	   505: ; [00] holds the vertical velocity of menu scrolling.
                            	   506:     even
                            	   507: MovePositionMarkers:
02:0004030A 1880            	   508:     move.b  D0,($0000,A4)
                            	   509:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   510:     ;
02:0004030C 102C0254        	   511:     move.b  ($0254,A4),D0
02:00040310 0C0000F8        	   512:     cmpi.b  #$F8,D0
02:00040314 670C            	   513:     beq  _anon_z05_5
02:00040316 023C00EE        	   514:     andi    #$EE,CCR  ; CLC: clear C+X
