                            	 11098: __far_z_04_0105:
                            	 11099: ; Description:
                            	 11100: ; This block applies to heads and the bottom segment of a neck.
                            	 11101: ; These are drawn with sprites that come first in order, so that
                            	 11102: ; they are drawn above all other sprites, including Link.
                            	 11103: ;
                            	 11104: ; Params:
                            	 11105: ; A: tile number
                            	 11106: ;
                            	 11107: ; Normal sprite with level palette row
                            	 11108:     even
                            	 11109: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E68C 7603            	 11110:     moveq   #3,D3
02:0003E68E 19430003        	 11111:     move.b  D3,($0003,A4)
02:0003E692 1B00            	 11112:     move.b  D0,-(A5)  ; PHA
                            	 11113:     ; To calculate the base offset of the sprite record:
                            	 11114:     ; offset := neck index * 8
                            	 11115:     ;
                            	 11116:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11117:     ; at an even index.
                            	 11118:     ;
02:0003E694 102C04D7        	 11119:     move.b  ($04D7,A4),D0
02:0003E698 E308            	 11120:     lsl.b  #1,D0   ; ASL A
02:0003E69A E308            	 11121:     lsl.b  #1,D0   ; ASL A
02:0003E69C E308            	 11122:     lsl.b  #1,D0   ; ASL A
                            	 11123:     ; But if the segment is not a head (not at object slot 5), then
                            	 11124:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11125:     ;
02:0003E69E 0C020005        	 11126:     cmpi.b  #$05,D2
02:0003E6A2 670A            	 11127:     beq  _anon_z04_139
02:0003E6A4 023C00EE        	 11128:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6A8 123C0020        	 11129:     move.b  #$20,D1
02:0003E6AC D101            	 11130:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11131: _anon_z04_139:
02:0003E6AE 7600            	 11132:     moveq   #0,D3
02:0003E6B0 1600            	 11133:     move.b  D0,D3
02:0003E6B2 101D            	 11134:     move.b  (A5)+,D0  ; PLA
02:0003E6B4 4EB9000319DE    	 11135:     jsr     Anim_WriteSpecificSprite
02:0003E6BA 6026            	 11136:     jmp     Gleeok_CheckCollisions
                            	 11137: 
                            	 11138:     even
                            	 11139: Gleeok_DrawHeadAndCheckCollisions:
02:0003E6BC 7405            	 11140:     moveq   #5,D2
                            	 11141:     even
