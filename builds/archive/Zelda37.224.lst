                            	  6167: __far_z_05_0094:
                            	  6168:     ; Turn the door command into the desired open or closed state
                            	  6169:     ; to store in [08].
                            	  6170:     ;
                            	  6171:     ; cmd:  7 6 3 2 
                            	  6172:     ; [08]: 2 0 0 0
                            	  6173:     ;
                            	  6174:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6175:     ; commands intended to be used.
                            	  6176:     ;
                            	  6177:     ; 3 is the end state of 2: close
                            	  6178:     ; 7 is the end state of 6: open
                            	  6179:     ;
02:00043A6C 02000007        	  6180:     andi.b #$07,D0
02:00043A70 7601            	  6181:     moveq   #1,D3
02:00043A72 19430002        	  6182:     move.b  D3,($0002,A4)
02:00043A76 122C0002        	  6183:     move.b  ($0002,A4),D1
02:00043A7A C200            	  6184:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043A7C 6702            	  6185:     beq  _anon_z05_118
02:00043A7E E208            	  6186:     lsr.b  #1,D0   ; LSR A
                            	  6187: _anon_z05_118:
02:00043A80 0C000002        	  6188:     cmpi.b  #$02,D0
02:00043A84 6606            	  6189:     bne  _anon_z05_119
                            	  6190:     ; Command 2 sets Link's timer to $30.
                            	  6191:     ;
02:00043A86 7630            	  6192:     moveq   #48,D3
02:00043A88 19430028        	  6193:     move.b  D3,($0028,A4)
                            	  6194: _anon_z05_119:
02:00043A8C 02000003        	  6195:     andi.b #$03,D0
02:00043A90 003C0011        	  6196:     ori     #$11,CCR  ; SEC: set C+X
02:00043A94 123C0001        	  6197:     move.b  #$01,D1
02:00043A98 0A3C0010        	  6198:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A9C 9101            	  6199:     subx.b  D1,D0   ; SBC #$01
02:00043A9E 0A3C0010        	  6200:     eori    #$10,CCR  ; restore X = 6502 C
02:00043AA2 02000002        	  6201:     andi.b #$02,D0
02:00043AA6 19400008        	  6202:     move.b  D0,($0008,A4)
                            	  6203:     ; The command to close a key door or bombable wall does not
                            	  6204:     ; do anything.
                            	  6205:     ;
