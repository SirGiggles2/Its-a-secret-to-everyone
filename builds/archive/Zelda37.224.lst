                            	  1448: Flyer_KeeseDecideState:
                            	  1449:     ; Go to the next state randomly:
                            	  1450:     ; Random >= $A0: 2
                            	  1451:     ; Random >= $20: 3
                            	  1452:     ; Else:          4
                            	  1453:     ;
                            	  1454:     ; Set up 6 turns.
                            	  1455:     ;
02:0003A0E2 7602            	  1456:     moveq   #2,D3
