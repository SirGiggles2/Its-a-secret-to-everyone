                            	  6815: HarmLink:
02:00031CA8 610005C2        	  6816:     jsr     BeginShove
                            	  6817:     ; Flag collision with [0C], even though [06] was already set.
                            	  6818:     ;
02:00031CAC 522C000C        	  6819:     addq.b  #1,($000C,A4)
                            	  6820:     ; Unpack the damage points for the monster's type.
                            	  6821:     ; The low nibble is the high byte.
                            	  6822:     ; (Damage points byte AND $F0) is the low byte.
                            	  6823:     ;
02:00031CB0 7600            	  6824:     moveq   #0,D3
02:00031CB2 41EC034F        	  6825:     lea     ($034F,A4),A0
02:00031CB6 16302000        	  6826:     move.b  (A0,D2.W),D3
02:00031CBA 41F900031B1C    	  6827:     lea     (ObjTypeToDamagePoints).l,A0
02:00031CC0 10303000        	  6828:     move.b  (A0,D3.W),D0
02:00031CC4 1B00            	  6829:     move.b  D0,-(A5)  ; PHA
02:00031CC6 0200000F        	  6830:     andi.b #$0F,D0
02:00031CCA 1940000D        	  6831:     move.b  D0,($000D,A4)
02:00031CCE 101D            	  6832:     move.b  (A5)+,D0  ; PLA
02:00031CD0 020000F0        	  6833:     andi.b #$F0,D0
02:00031CD4 1940000E        	  6834:     move.b  D0,($000E,A4)
                            	  6835: ; Params:
                            	  6836: ; X: object index of the attacker
                            	  6837: ; [0D]: damage points high byte
                            	  6838: ; [0E]: damage points low byte
                            	  6839: ;
                            	  6840: ;
                            	  6841: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6842: ;
                            	  6843:     even
                            	  6844: Link_BeHarmed:
02:00031CD8 7600            	  6845:     moveq   #0,D3
02:00031CDA 41EC034F        	  6846:     lea     ($034F,A4),A0
02:00031CDE 16302000        	  6847:     move.b  (A0,D2.W),D3
02:00031CE2 0C03002E        	  6848:     cmpi.b  #$2E,D3
02:00031CE6 6706            	  6849:     beq  _anon_z01_85
