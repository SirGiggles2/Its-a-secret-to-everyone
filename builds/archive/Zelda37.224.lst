02:000446EE 19400001        	  7579:     move.b  D0,($0001,A4)
02:000446F2 101D            	  7580:     move.b  (A5)+,D0  ; PLA
02:000446F4 1B00            	  7581:     move.b  D0,-(A5)  ; PHA
02:000446F6 7400            	  7582:     moveq   #0,D2
02:000446F8 1400            	  7583:     move.b  D0,D2
                            	  7584:     ; Align the object's Y coordinate with 16 pixels.
                            	  7585:     ;
02:000446FA 41EC0084        	  7586:     lea     ($0084,A4),A0
02:000446FE 10302000        	  7587:     move.b  (A0,D2.W),D0
02:00044702 020000F0        	  7588:     andi.b #$F0,D0
                            	  7589:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7590:     ; the height of each row.
                            	  7591:     ;
02:00044706 003C0011        	  7592:     ori     #$11,CCR  ; SEC: set C+X
02:0004470A 123C0040        	  7593:     move.b  #$40,D1
02:0004470E 0A3C0010        	  7594:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044712 9101            	  7595:     subx.b  D1,D0   ; SBC #$40
02:00044714 0A3C0010        	  7596:     eori    #$10,CCR  ; restore X = 6502 C
02:00044718 E208            	  7597:     lsr.b  #1,D0   ; LSR A
02:0004471A E208            	  7598:     lsr.b  #1,D0   ; LSR A
02:0004471C E208            	  7599:     lsr.b  #1,D0   ; LSR A
                            	  7600:     ; Add this row offset to the column address.
                            	  7601:     ;
02:0004471E 4EB900030F6C    	  7602:     jsr     AddToInt16At0
                            	  7603:     ; Assume that we'll write a type 1 square with primary square
                            	  7604:     ; taken from [05]. If so, the square index doesn't matter
                            	  7605:     ; as long as >= $10. See WriteSquareOW.
                            	  7606:     ;
02:00044724 7600            	  7607:     moveq   #0,D3
02:00044726 7410            	  7608:     moveq   #16,D2
02:00044728 102C0005        	  7609:     move.b  ($0005,A4),D0
                            	  7610:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7611:     ; So, we have to look up the square index corresponding
                            	  7612:     ; to primary square/tile in [05].
                            	  7613:     ;
                            	  7614:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7615:     ; then the X register will have the square index value.
                            	  7616:     ;
