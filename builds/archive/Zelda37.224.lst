                            	  7879: _L_z04_UpdatePolsVoice_State0:
                            	  7880:     ; State 0. Walking.
                            	  7881:     ;
                            	  7882:     ; If grid offset = 0, then no more distance to cover.
                            	  7883:     ; So, go change to state 1 -- jumping.
                            	  7884:     ;
02:0003CE2A 41EC0394        	  7885:     lea     ($0394,A4),A0
02:0003CE2E 10302000        	  7886:     move.b  (A0,D2.W),D0
02:0003CE32 67000084        	  7887:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7888:     ; Decrement grid offset / distance remaining.
                            	  7889:     ;
02:0003CE36 41EC0394        	  7890:     lea     ($0394,A4),A0
02:0003CE3A 53302000        	  7891:     subq.b  #1,(A0,D2.W)
                            	  7892:     ; Move vertically.
                            	  7893:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7894:     ;
02:0003CE3E 41EC0084        	  7895:     lea     ($0084,A4),A0
02:0003CE42 10302000        	  7896:     move.b  (A0,D2.W),D0
02:0003CE46 023C00EE        	  7897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE4A 41F90003CDDA    	  7898:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE50 12303000        	  7899:     move.b  (A0,D3.W),D1
02:0003CE54 D101            	  7900:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CE56 41EC0084        	  7901:     lea     ($0084,A4),A0
02:0003CE5A 11802000        	  7902:     move.b  D0,(A0,D2.W)
                            	  7903:     even
                            	  7904: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7905:     ; If the square the monster is over is walkable, then
                            	  7906:     ; go draw and check object collisions.
