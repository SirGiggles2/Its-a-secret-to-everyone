02:000307F2 9101            	  4011:     subx.b  D1,D0   ; SBC $00
02:000307F4 0A3C0010        	  4012:     eori    #$10,CCR  ; restore X = 6502 C
02:000307F8 1880            	  4013:     move.b  D0,($0000,A4)
02:000307FA 101D            	  4014:     move.b  (A5)+,D0  ; PLA
02:000307FC E208            	  4015:     lsr.b  #1,D0   ; LSR A
02:000307FE E208            	  4016:     lsr.b  #1,D0   ; LSR A
02:00030800 E208            	  4017:     lsr.b  #1,D0   ; LSR A
