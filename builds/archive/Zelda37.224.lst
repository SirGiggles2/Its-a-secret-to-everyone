02:0003DEB4 19410002        	 10055:     move.b  D1,($0002,A4)
02:0003DEB8 122C0002        	 10056:     move.b  ($0002,A4),D1
02:0003DEBC C200            	 10057:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
