                            	 10088: _L_z04_UpdateGohma_AnimateEye:
                            	 10089:     ; Animate the eye.
                            	 10090:     ;
                            	 10091:     ; First, if the counter for when to open the eye next = 0, then
                            	 10092:     ; set it to a random value at least $C0; and set the timer for
                            	 10093:     ; keeping the eye open to $80.
                            	 10094:     ;
                            	 10095:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10096:     ; every other frame.
                            	 10097:     ;
02:0003DF02 41EC042C        	 10098:     lea     ($042C,A4),A0
02:0003DF06 10302000        	 10099:     move.b  (A0,D2.W),D0
02:0003DF0A 661E            	 10100:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DF0C 103C0080        	 10101:     move.b  #$80,D0
02:0003DF10 41EC0444        	 10102:     lea     ($0444,A4),A0
02:0003DF14 11802000        	 10103:     move.b  D0,(A0,D2.W)
02:0003DF18 103C00C0        	 10104:     move.b  #$C0,D0
02:0003DF1C 12342018        	 10105:     move.b  ($18,A4,D2.W),D1
02:0003DF20 8001            	 10106:     or.b  D1,D0
02:0003DF22 41EC042C        	 10107:     lea     ($042C,A4),A0
02:0003DF26 11802000        	 10108:     move.b  D0,(A0,D2.W)
                            	 10109:     even
                            	 10110: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10111:     ; Decrement the next-open-eye counter.
                            	 10112:     ;
02:0003DF2A 102C0015        	 10113:     move.b  ($0015,A4),D0
