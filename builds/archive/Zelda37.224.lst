                            	  8486:     even
                            	  8487: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8488:     ; If the teleporting distance remaining is even, then draw
                            	  8489:     ; and check collisions, else return.
                            	  8490:     ;
                            	  8491:     ; This means that when 0, the monster is walking.
                            	  8492:     ; So, draw and check collisions every frame.
                            	  8493:     ;
                            	  8494:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8495:     ; translucently -- every other frame.
                            	  8496:     ;
02:0003D310 41EC0394        	  8497:     lea     ($0394,A4),A0
02:0003D314 10302000        	  8498:     move.b  (A0,D2.W),D0
02:0003D318 E208            	  8499:     lsr.b  #1,D0   ; LSR A
02:0003D31A 6402            	  8500:     bcc.s  __far_z_04_0076
02:0003D31C 603A            	  8501:     jmp  L11E17_Exit
                            	  8502: __far_z_04_0076:
                            	  8503:     even
