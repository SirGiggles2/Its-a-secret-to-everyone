                            	  5297: _anon_z04_70:
                            	  5298:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5299:     ; 1. negate the distance
                            	  5300:     ; 2. add 8 to the instruction offset to access
                            	  5301:     ;    the opposite direction for the same wall
                            	  5302:     ;
02:0003BB7E 7600            	  5303:     moveq   #0,D3
02:0003BB80 162C0098        	  5304:     move.b  ($0098,A4),D3
02:0003BB84 122C0002        	  5305:     move.b  ($0002,A4),D1
02:0003BB88 B601            	  5306:     cmp.b   D1,D3
02:0003BB8A 662A            	  5307:     bne  _anon_z04_71
02:0003BB8C 1B00            	  5308:     move.b  D0,-(A5)  ; PHA
02:0003BB8E 41EC0412        	  5309:     lea     ($0412,A4),A0
02:0003BB92 10302000        	  5310:     move.b  (A0,D2.W),D0
02:0003BB96 023C00EE        	  5311:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB9A 123C0008        	  5312:     move.b  #$08,D1
02:0003BB9E D101            	  5313:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BBA0 41EC0412        	  5314:     lea     ($0412,A4),A0
02:0003BBA4 11802000        	  5315:     move.b  D0,(A0,D2.W)
02:0003BBA8 101D            	  5316:     move.b  (A5)+,D0  ; PLA
02:0003BBAA 4600            	  5317:     eori.b #$FF,D0
02:0003BBAC 023C00EE        	  5318:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBB0 123C0001        	  5319:     move.b  #$01,D1
02:0003BBB4 D101            	  5320:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5321: _anon_z04_71:
                            	  5322:     ; Add the distance and Link's minor coordinate to calculate
                            	  5323:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5324:     ; In general, the monster will be put in front of Link.
                            	  5325:     ;
02:0003BBB6 023C00EE        	  5326:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBBA 1214            	  5327:     move.b  ($0000,A4),D1
02:0003BBBC D101            	  5328:     addx.b  D1,D0   ; ADC $00
02:0003BBBE 19400004        	  5329:     move.b  D0,($0004,A4)
                            	  5330:     ; By default, will return index 0 to choose the minimum value
                            	  5331:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5332:     ; if Link is at the wall with a smaller major coordinate.
                            	  5333:     ;
02:0003BBC2 7600            	  5334:     moveq   #0,D3
                            	  5335:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5336:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5337:     ; to access the block for the other direction along the same axis,
                            	  5338:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5339:     ;
02:0003BBC4 102C0001        	  5340:     move.b  ($0001,A4),D0
02:0003BBC8 122C0003        	  5341:     move.b  ($0003,A4),D1
02:0003BBCC B001            	  5342:     cmp.b   D1,D0
02:0003BBCE 671C            	  5343:     beq  _anon_z04_72
02:0003BBD0 41EC0412        	  5344:     lea     ($0412,A4),A0
02:0003BBD4 10302000        	  5345:     move.b  (A0,D2.W),D0
02:0003BBD8 023C00EE        	  5346:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBDC 123C0010        	  5347:     move.b  #$10,D1
02:0003BBE0 D101            	  5348:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BBE2 41EC0412        	  5349:     lea     ($0412,A4),A0
02:0003BBE6 11802000        	  5350:     move.b  D0,(A0,D2.W)
02:0003BBEA 5203            	  5351:     addq.b  #1,D3
