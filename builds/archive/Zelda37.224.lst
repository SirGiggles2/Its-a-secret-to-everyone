02:0003DE9A 19410002        	 10044:     move.b  D1,($0002,A4)
02:0003DE9E 122C0002        	 10045:     move.b  ($0002,A4),D1
02:0003DEA2 C200            	 10046:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEA4 6708            	 10047:     beq  _anon_z04_120
02:0003DEA6 41EC0084        	 10048:     lea     ($0084,A4),A0
02:0003DEAA 52302000        	 10049:     addq.b  #1,(A0,D2.W)
                            	 10050: _anon_z04_120:
                            	 10051:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	 10052:     ;
02:0003DEAE 122C0002        	 10053:     move.b  ($0002,A4),D1
