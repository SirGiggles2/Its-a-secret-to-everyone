02:0003CE5E 610001F4        	  7908:     jsr     PolsVoice_IsSquareWalkable
02:0003CE62 6452            	  7909:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7910:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7911:     ; then go change to state 1.
                            	  7912:     ;
02:0003CE64 41EC041F        	  7913:     lea     ($041F,A4),A0
02:0003CE68 10302000        	  7914:     move.b  (A0,D2.W),D0
02:0003CE6C 020000FC        	  7915:     andi.b #$FC,D0
02:0003CE70 0C0000B0        	  7916:     cmpi.b  #$B0,D0
02:0003CE74 6742            	  7917:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CE76 0C0000F4        	  7918:     cmpi.b  #$F4,D0
02:0003CE7A 643C            	  7919:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7920:     ; Else blocked by something else.
                            	  7921:     ;
                            	  7922:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7923:     ;
02:0003CE7C 41EC0098        	  7924:     lea     ($0098,A4),A0
02:0003CE80 10302000        	  7925:     move.b  (A0,D2.W),D0
02:0003CE84 02000003        	  7926:     andi.b #$03,D0
02:0003CE88 6618            	  7927:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
