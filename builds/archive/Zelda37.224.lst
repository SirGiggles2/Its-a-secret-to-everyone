                            	  5349:     even
                            	  5350: _L_z07_SpreadShot_Draw:
                            	  5351:     ; Draw the corner.
                            	  5352:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5353:     ;
02:0004C5D0 7002            	  5354:     moveq   #2,D0
02:0004C5D2 1940000C        	  5355:     move.b  D0,($000C,A4)
02:0004C5D6 7623            	  5356:     moveq   #35,D3
02:0004C5D8 4EB9000318C6    	  5357:     jsr     Anim_WriteItemSprites
                            	  5358:     even
                            	  5359: _L_z07_SpreadShot_NextCorner:
                            	  5360:     ; Prepare to process the next corner.
                            	  5361:     ;
                            	  5362:     ; First, restore X offset [02] and Y offset [03].
                            	  5363:     ;
02:0004C5DE 101D            	  5364:     move.b  (A5)+,D0  ; PLA
02:0004C5E0 19400003        	  5365:     move.b  D0,($0003,A4)
02:0004C5E4 101D            	  5366:     move.b  (A5)+,D0  ; PLA
02:0004C5E6 19400002        	  5367:     move.b  D0,($0002,A4)
                            	  5368:     ; Take turns negating X offset or Y offset for the next round.
                            	  5369:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5370:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5371:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5372:     ; - Fourth turn: doesn't matter
                            	  5373:     ;
                            	  5374:     ;
                            	  5375:     ; Get the loop index.
02:0004C5EA 101D            	  5376:     move.b  (A5)+,D0  ; PLA
02:0004C5EC 1B00            	  5377:     move.b  D0,-(A5)  ; PHA
02:0004C5EE 7600            	  5378:     moveq   #0,D3
02:0004C5F0 1600            	  5379:     move.b  D0,D3
02:0004C5F2 0C030001        	  5380:     cmpi.b  #$01,D3
02:0004C5F6 6602            	  5381:     bne  _anon_z07_25
02:0004C5F8 7603            	  5382:     moveq   #3,D3
                            	  5383: _anon_z07_25:
02:0004C5FA 10343000        	  5384:     move.b  ($00,A4,D3.W),D0
02:0004C5FE 4600            	  5385:     eori.b #$FF,D0
02:0004C600 023C00EE        	  5386:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C604 123C0001        	  5387:     move.b  #$01,D1
02:0004C608 D101            	  5388:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C60A 19803000        	  5389:     move.b  D0,($00,A4,D3.W)
                            	  5390:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5391:     ;
02:0004C60E 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C610 7600            	  5393:     moveq   #0,D3
02:0004C612 1600            	  5394:     move.b  D0,D3
02:0004C614 5303            	  5395:     subq.b  #1,D3
02:0004C616 6A00FF18        	  5396:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5397:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5398:     ;
                            	  5399:     ; Decrease the base negative offset to get farther away from
                            	  5400:     ; the center point.
                            	  5401:     ;
02:0004C61A 41EC0098        	  5402:     lea     ($0098,A4),A0
02:0004C61E 53302000        	  5403:     subq.b  #1,(A0,D2.W)
                            	  5404:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5405:     ;
                            	  5406:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5407:     ;
02:0004C622 41EC0098        	  5408:     lea     ($0098,A4),A0
02:0004C626 10302000        	  5409:     move.b  (A0,D2.W),D0
02:0004C62A 0C0000E8        	  5410:     cmpi.b  #$E8,D0
02:0004C62E 6702            	  5411:     beq.s  __far_z_07_0081
02:0004C630 6004            	  5412:     jmp  L1F49F_Exit
