02:0003DF96 41EC0478        	 10175:     lea     ($0478,A4),A0
02:0003DF9A 10302000        	 10176:     move.b  (A0,D2.W),D0
02:0003DF9E 0C000008        	 10177:     cmpi.b  #$08,D0
02:0003DFA2 66C2            	 10178:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	 10179:     ; Roll over the eye animation counter to 0.
