                            	  7953: _L_z04_UpdatePolsVoice_SetState1:
                            	  7954:     ; If already in state 1, then go draw and check collisions.
                            	  7955:     ;
02:0003CEB8 41EC00AC        	  7956:     lea     ($00AC,A4),A0
02:0003CEBC 10302000        	  7957:     move.b  (A0,D2.W),D0
02:0003CEC0 6702            	  7958:     beq.s  __far_z_04_0074
02:0003CEC2 6068            	  7959:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7960: __far_z_04_0074:
                            	  7961:     ; Go to state 1.
                            	  7962:     ;
02:0003CEC4 41EC00AC        	  7963:     lea     ($00AC,A4),A0
02:0003CEC8 52302000        	  7964:     addq.b  #1,(A0,D2.W)
                            	  7965:     ; Subtract 1 from facing direction to make an index.
                            	  7966:     ;
02:0003CECC 7600            	  7967:     moveq   #0,D3
02:0003CECE 41EC0098        	  7968:     lea     ($0098,A4),A0
02:0003CED2 16302000        	  7969:     move.b  (A0,D2.W),D3
02:0003CED6 5303            	  7970:     subq.b  #1,D3
                            	  7971:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7972:     ;
02:0003CED8 41EC0084        	  7973:     lea     ($0084,A4),A0
02:0003CEDC 10302000        	  7974:     move.b  (A0,D2.W),D0
02:0003CEE0 0C000078        	  7975:     cmpi.b  #$78,D0
02:0003CEE4 6402            	  7976:     bcc  _anon_z04_97
02:0003CEE6 7603            	  7977:     moveq   #3,D3
                            	  7978: _anon_z04_97:
                            	  7979:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7980:     ;
02:0003CEE8 0C0000A8        	  7981:     cmpi.b  #$A8,D0
02:0003CEEC 6502            	  7982:     bcs  _anon_z04_98
02:0003CEEE 7607            	  7983:     moveq   #7,D3
                            	  7984: _anon_z04_98:
                            	  7985:     ; Set the vertical speed for the beginning of the jump.
                            	  7986:     ;
02:0003CEF0 41F90003CDE4    	  7987:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CEF6 10303000        	  7988:     move.b  (A0,D3.W),D0
02:0003CEFA 41EC0412        	  7989:     lea     ($0412,A4),A0
02:0003CEFE 11802000        	  7990:     move.b  D0,(A0,D2.W)
                            	  7991:     ; Look up the Y offset for the current direction.
                            	  7992:     ; Add it to object Y to set the destination Y of the jump.
                            	  7993:     ;
02:0003CF02 41EC0084        	  7994:     lea     ($0084,A4),A0
02:0003CF06 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003CF0A 023C00EE        	  7996:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF0E 41F90003CDEC    	  7997:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF14 12303000        	  7998:     move.b  (A0,D3.W),D1
02:0003CF18 D101            	  7999:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF1A 41EC042C        	  8000:     lea     ($042C,A4),A0
02:0003CF1E 11802000        	  8001:     move.b  D0,(A0,D2.W)
                            	  8002:     ; Turn the index into a direction again by adding 1.
                            	  8003:     ; Store the facing direction.
                            	  8004:     ;
02:0003CF22 5203            	  8005:     addq.b  #1,D3
02:0003CF24 41EC0098        	  8006:     lea     ($0098,A4),A0
02:0003CF28 11832000        	  8007:     move.b  D3,(A0,D2.W)
