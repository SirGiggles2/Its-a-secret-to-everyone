                            	  4068: PondFairy_HandleOtherStates:
02:0003B2B4 0C000001        	  4069:     cmpi.b  #$01,D0
02:0003B2B8 6610            	  4070:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4071:     ; State 1. Flying and filling hearts.
                            	  4072:     ;
