                            	  4991:     ;
02:00030E2E 7600            	  4992:     moveq   #0,D3
02:00030E30 16342028        	  4993:     move.b  ($28,A4,D2.W),D3
                            	  4994:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4995:     ; Carry will have been set, because of the comparison (CPY).
                            	  4996:     ;
