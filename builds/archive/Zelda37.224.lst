                            	   802: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   803:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   804:     ; go reset the push timer.
                            	   805:     ;
02:00039C06 102C0084        	   806:     move.b  ($0084,A4),D0
02:00039C0A 023C00EE        	   807:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039C0E 123C0003        	   808:     move.b  #$03,D1
02:00039C12 D101            	   809:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039C14 41EC0084        	   810:     lea     ($0084,A4),A0
02:00039C18 12302000        	   811:     move.b  (A0,D2.W),D1
