                            	  5961:     ; For all other provisional face values, calculate:
                            	  5962:     ; door face := provisional face - 3
02:000438F2 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:000438F6 123C0003        	  5964:     move.b  #$03,D1
02:000438FA 0A3C0010        	  5965:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000438FE 9101            	  5966:     subx.b  D1,D0   ; SBC #$03
02:00043900 0A3C0010        	  5967:     eori    #$10,CCR  ; restore X = 6502 C
02:00043904 7600            	  5968:     moveq   #0,D3
02:00043906 1600            	  5969:     move.b  D0,D3
