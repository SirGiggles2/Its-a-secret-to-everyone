02:0003ED1A 10342070        	 11968:     move.b  ($70,A4,D2.W),D0
02:0003ED1E 19803071        	 11969:     move.b  D0,($71,A4,D3.W)
02:0003ED22 41EC0084        	 11970:     lea     ($0084,A4),A0
02:0003ED26 10302000        	 11971:     move.b  (A0,D2.W),D0
02:0003ED2A 41EC0085        	 11972:     lea     ($0085,A4),A0
