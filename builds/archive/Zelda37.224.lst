                            	  5955: _anon_z05_112:
                            	  5956:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5957:     ; because the visible door face is already a wall.
                            	  5958:     ;
02:000438EA 0C000004        	  5959:     cmpi.b  #$04,D0
