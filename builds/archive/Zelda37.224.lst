                            	  8241: Submenu_CueTransferRowUW:
                            	  8242:     ; If menu scroll value is negative, then we transferred everything.
                            	  8243:     ; So, return.
                            	  8244:     ;
02:00044E98 102C005E        	  8245:     move.b  ($005E,A4),D0
02:00044E9C 6A02            	  8246:     bpl.s  __far_z_05_0110
