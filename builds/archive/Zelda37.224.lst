                            	  3755:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3756:     ;
02:00041EDE 41EC0098        	  3757:     lea     ($0098,A4),A0
02:00041EE2 10302000        	  3758:     move.b  (A0,D2.W),D0
02:00041EE6 0200000C        	  3759:     andi.b #$0C,D0
02:00041EEA 6734            	  3760:     beq  _anon_z05_85
02:00041EEC 102C0070        	  3761:     move.b  ($0070,A4),D0
02:00041EF0 12342070        	  3762:     move.b  ($70,A4,D2.W),D1
02:00041EF4 B001            	  3763:     cmp.b   D1,D0
02:00041EF6 6600008A        	  3764:     bne  _L_z05_CheckLadder_StashLadder
02:00041EFA 102C0084        	  3765:     move.b  ($0084,A4),D0
02:00041EFE 023C00EE        	  3766:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F02 123C0003        	  3767:     move.b  #$03,D1
02:00041F06 D101            	  3768:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041F08 003C0011        	  3769:     ori     #$11,CCR  ; SEC: set C+X
02:00041F0C 41EC0084        	  3770:     lea     ($0084,A4),A0
02:00041F10 12302000        	  3771:     move.b  (A0,D2.W),D1
02:00041F14 0A3C0010        	  3772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F18 9101            	  3773:     subx.b  D1,D0   ; SBC ObjY,X
02:00041F1A 0A3C0010        	  3774:     eori    #$10,CCR  ; restore X = 6502 C
02:00041F1E 6030            	  3775:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3776: 
                            	  3777: _anon_z05_85:
                            	  3778:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3779:     ; between the ladder and Link.
                            	  3780:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3781:     ;
02:00041F20 102C0084        	  3782:     move.b  ($0084,A4),D0
02:00041F24 023C00EE        	  3783:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F28 123C0003        	  3784:     move.b  #$03,D1
02:00041F2C D101            	  3785:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041F2E 41EC0084        	  3786:     lea     ($0084,A4),A0
02:00041F32 12302000        	  3787:     move.b  (A0,D2.W),D1
02:00041F36 B001            	  3788:     cmp.b   D1,D0
02:00041F38 6648            	  3789:     bne  _L_z05_CheckLadder_StashLadder
02:00041F3A 102C0070        	  3790:     move.b  ($0070,A4),D0
02:00041F3E 003C0011        	  3791:     ori     #$11,CCR  ; SEC: set C+X
02:00041F42 12342070        	  3792:     move.b  ($70,A4,D2.W),D1
02:00041F46 0A3C0010        	  3793:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F4A 9101            	  3794:     subx.b  D1,D0   ; SBC ObjX,X
02:00041F4C 0A3C0010        	  3795:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3796:     even
                            	  3797: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3798:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3799:     ; If > $10, go put the ladder away.
                            	  3800:     ;
02:00041F50 4EB900030B1A    	  3801:     jsr     Abs
02:00041F56 1880            	  3802:     move.b  D0,($0000,A4)
02:00041F58 0C000010        	  3803:     cmpi.b  #$10,D0
02:00041F5C 6532            	  3804:     bcs  _L_z05_CheckLadder_SetState2
02:00041F5E 0C000010        	  3805:     cmpi.b  #$10,D0
02:00041F62 661E            	  3806:     bne  _L_z05_CheckLadder_StashLadder
                            	  3807:     ; Distance = $10. If player's not facing in the same direction as
                            	  3808:     ; the ladder, go put away the ladder.
                            	  3809:     ;
02:00041F64 102C0098        	  3810:     move.b  ($0098,A4),D0
02:00041F68 41EC0098        	  3811:     lea     ($0098,A4),A0
02:00041F6C 12302000        	  3812:     move.b  (A0,D2.W),D1
02:00041F70 B001            	  3813:     cmp.b   D1,D0
02:00041F72 660E            	  3814:     bne  _L_z05_CheckLadder_StashLadder
                            	  3815:     ; Distance = $10, and player's facing in the same direction.
                            	  3816:     ;
                            	  3817:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3818:     ; ladder and had not stepped onto it yet.
                            	  3819:     ; Go handle movement on it, but don't change state yet.
                            	  3820:     ;
                            	  3821:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3822:     ; off of the ladder. So the ladder should be put away. In this
                            	  3823:     ; case, fall thru.
                            	  3824:     ;
02:00041F74 41EC00AC        	  3825:     lea     ($00AC,A4),A0
02:00041F78 10302000        	  3826:     move.b  (A0,D2.W),D0
02:00041F7C 0C000001        	  3827:     cmpi.b  #$01,D0
02:00041F80 6718            	  3828:     beq  _L_z05_CheckLadder_HandleInput
                            	  3829:     even
                            	  3830: _L_z05_CheckLadder_StashLadder:
                            	  3831:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3832:     ;
02:00041F82 7000            	  3833:     moveq   #0,D0
02:00041F84 19400064        	  3834:     move.b  D0,($0064,A4)
02:00041F88 4EB90004DA06    	  3835:     jsr     DestroyMonster
                            	  3836:     even
                            	  3837: _L_z05_CheckLadder_Exit:
02:00041F8E 4E75            	  3838:     rts
                            	  3839: 
                            	  3840:     even
                            	  3841: _L_z05_CheckLadder_SetState2:
                            	  3842:     ;  Set state 2, because we're on the ladder.
                            	  3843:     ;
02:00041F90 7002            	  3844:     moveq   #2,D0
02:00041F92 41EC00AC        	  3845:     lea     ($00AC,A4),A0
02:00041F96 11802000        	  3846:     move.b  D0,(A0,D2.W)
                            	  3847:     even
                            	  3848: _L_z05_CheckLadder_HandleInput:
                            	  3849:     ; If input direction = 0, go draw and reset moving direction.
                            	  3850:     ;
02:00041F9A 102C03F8        	  3851:     move.b  ($03F8,A4),D0
02:00041F9E 67000086        	  3852:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3853:     ; Input direction <> 0. The player intends to move.
                            	  3854:     ; So, see if we need to override the moving direction.
                            	  3855:     ;
                            	  3856:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3857:     ; go draw and set moving direction to Link's direction.
                            	  3858:     ;
                            	  3859:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3860:     ; been blocked by the water.
                            	  3861:     ;
                            	  3862:     ; Or, Link already passed over the point right over the ladder
                            	  3863:     ; and was allowed to move onto the tiles after the ladder.
                            	  3864:     ;
02:00041FA2 102C0098        	  3865:     move.b  ($0098,A4),D0
02:00041FA6 7600            	  3866:     moveq   #0,D3
02:00041FA8 1614            	  3867:     move.b  ($0000,A4),D3
02:00041FAA 670C            	  3868:     beq  _anon_z05_86
02:00041FAC 41EC0098        	  3869:     lea     ($0098,A4),A0
02:00041FB0 12302000        	  3870:     move.b  (A0,D2.W),D1
02:00041FB4 B001            	  3871:     cmp.b   D1,D0
02:00041FB6 676E            	  3872:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3873: _anon_z05_86:
                            	  3874:     ; Distance = 0, or facing different directions.
                            	  3875:     ;
                            	  3876:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3877:     ; then go draw and keep moving.
                            	  3878:     ;
                            	  3879:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3880:     ;
                            	  3881:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3882:     ; to move onto the tiles after the ladder.
                            	  3883:     ;
                            	  3884:     ; Note that if Link is not moving, then this test will fail,
                            	  3885:     ; and case (D) will catch it.
                            	  3886:     ;
02:00041FB8 41EC0098        	  3887:     lea     ($0098,A4),A0
02:00041FBC 10302000        	  3888:     move.b  (A0,D2.W),D0
02:00041FC0 122C000F        	  3889:     move.b  ($000F,A4),D1
02:00041FC4 B001            	  3890:     cmp.b   D1,D0
02:00041FC6 675E            	  3891:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3892:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3893:     ; then go draw and move in ladder's direction.
                            	  3894:     ;
                            	  3895:     ; You can always step off the ladder where you came from.
                            	  3896:     ;
02:00041FC8 4EB900030B16    	  3897:     jsr     GetOppositeDir
02:00041FCE 122C0098        	  3898:     move.b  ($0098,A4),D1
02:00041FD2 B001            	  3899:     cmp.b   D1,D0
02:00041FD4 6750            	  3900:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3901:     ; D. If opposite of ladder's direction <> down,
                            	  3902:     ; or input direction <> up,
                            	  3903:     ; then go reset moving direction, and draw.
                            	  3904:     ;
                            	  3905:     ; This will catch all cases of Link facing perpendicular to
                            	  3906:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3907:     ; ladder direction is up and input direction is up (E).
                            	  3908:     ;
02:00041FD6 0C000004        	  3909:     cmpi.b  #$04,D0
02:00041FDA 6648            	  3910:     bne  _anon_z05_87
02:00041FDC 102C03F8        	  3911:     move.b  ($03F8,A4),D0
02:00041FE0 0C000008        	  3912:     cmpi.b  #$08,D0
02:00041FE4 663E            	  3913:     bne  _anon_z05_87
                            	  3914:     ; E. The ladder's direction is up and input direction is up.
                            	  3915:     ;
                            	  3916:     ; An earlier call to check tile collision would have blocked
                            	  3917:     ; movement, because the tile under Link's top half is a water tile.
                            	  3918:     ; But because Link is squarely on the ladder, we really have
                            	  3919:     ; to check the tile above that one.
                            	  3920:     ;
                            	  3921:     ; Set moving direction to input direction (up) and switch X to
                            	  3922:     ; the player's slot for the purpose of checking tile collision below.
                            	  3923:     ; Based on that, we'll set moving direction according to walkability.
                            	  3924:     ;
02:00041FE6 6158            	  3925:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3926:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3927:     ;
02:00041FE8 102C0084        	  3928:     move.b  ($0084,A4),D0
02:00041FEC 1B00            	  3929:     move.b  D0,-(A5)  ; PHA
02:00041FEE 003C0011        	  3930:     ori     #$11,CCR  ; SEC: set C+X
02:00041FF2 123C0008        	  3931:     move.b  #$08,D1
02:00041FF6 0A3C0010        	  3932:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041FFA 9101            	  3933:     subx.b  D1,D0   ; SBC #$08
02:00041FFC 0A3C0010        	  3934:     eori    #$10,CCR  ; restore X = 6502 C
02:00042000 19400084        	  3935:     move.b  D0,($0084,A4)
02:00042004 4EB90004B97E    	  3936:     jsr     GetCollidingTileMoving
02:0004200A 101D            	  3937:     move.b  (A5)+,D0  ; PLA
02:0004200C 19400084        	  3938:     move.b  D0,($0084,A4)
                            	  3939:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3940:     ; direction as the input direction (in a roundabout way).
                            	  3941:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3942:     ;
02:00042010 102C000F        	  3943:     move.b  ($000F,A4),D0
02:00042014 7600            	  3944:     moveq   #0,D3
02:00042016 162C049E        	  3945:     move.b  ($049E,A4),D3
02:0004201A 122C034A        	  3946:     move.b  ($034A,A4),D1
02:0004201E B601            	  3947:     cmp.b   D1,D3
02:00042020 6500FF78        	  3948:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3949: _anon_z05_87:
                            	  3950:     ; Set A to reset moving direction in [0F].
                            	  3951:     ;
02:00042024 7000            	  3952:     moveq   #0,D0
                            	  3953:     even
                            	  3954: _L_z05_CheckLadder_DrawLadder:
                            	  3955:     ; Draw the ladder.
                            	  3956:     ;
02:00042026 1B00            	  3957:     move.b  D0,-(A5)  ; PHA
02:00042028 7400            	  3958:     moveq   #0,D2
02:0004202A 142C0064        	  3959:     move.b  ($0064,A4),D2
02:0004202E 4EB90004D222    	  3960:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00042034 760C            	  3961:     moveq   #12,D3
02:00042036 7000            	  3962:     moveq   #0,D0
02:00042038 4EB9000318B8    	  3963:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0004203E 101D            	  3964:     move.b  (A5)+,D0  ; PLA
                            	  3965: ; Params:
                            	  3966: ; A: direction
                            	  3967: ;
                            	  3968: ; Returns:
                            	  3969: ; [0F]: direction
                            	  3970: ;
                            	  3971:     even
                            	  3972: SetMovingDirAndSwitchToPlayerSlot:
02:00042040 1940000F        	  3973:     move.b  D0,($000F,A4)
02:00042044 7400            	  3974:     moveq   #0,D2
02:00042046 4E75            	  3975:     rts
                            	  3976: 
                            	  3977:     even
                            	  3978: FindNextEdgeSpawnCell:
                            	  3979:     ; Load [0A] with the value before the call.
                            	  3980:     ;
02:00042048 102C0525        	  3981:     move.b  ($0525,A4),D0
02:0004204C 1940000A        	  3982:     move.b  D0,($000A,A4)
                            	  3983:     even
                            	  3984: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3985:     ; Loop to look for a place to spawn a monster from the edge
                            	  3986:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3987:     ;
                            	  3988:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3989:     ; We'll move down $10 pixels.
                            	  3990:     ;
02:00042050 7610            	  3991:     moveq   #16,D3
02:00042052 102C000A        	  3992:     move.b  ($000A,A4),D0
02:00042056 0200000F        	  3993:     andi.b #$0F,D0
02:0004205A 670A            	  3994:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3995:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3996:     ; Don't move vertically.
                            	  3997:     ;
02:0004205C 163C00F0        	  3998:     move.b  #$F0,D3
02:00042060 0C00000F        	  3999:     cmpi.b  #$0F,D0
02:00042064 6610            	  4000:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  4001:     even
                            	  4002: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  4003:     ; Else low nibble = $F. We're at the right edge,
                            	  4004:     ; and we'll move up $10 pixels.
                            	  4005:     ;
02:00042066 1003            	  4006:     move.b  D3,D0
02:00042068 023C00EE        	  4007:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004206C 122C000A        	  4008:     move.b  ($000A,A4),D1
02:00042070 D101            	  4009:     addx.b  D1,D0   ; ADC $0A
02:00042072 1940000A        	  4010:     move.b  D0,($000A,A4)
                            	  4011:     even
                            	  4012: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  4013:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  4014:     ; Move right one pixel.
                            	  4015:     ;
02:00042076 102C000A        	  4016:     move.b  ($000A,A4),D0
02:0004207A 020000F0        	  4017:     andi.b #$F0,D0
02:0004207E 0C0000E0        	  4018:     cmpi.b  #$E0,D0
02:00042082 6606            	  4019:     bne  _anon_z05_88
02:00042084 522C000A        	  4020:     addq.b  #1,($000A,A4)
02:00042088 600A            	  4021:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4022: 
                            	  4023: _anon_z05_88:
                            	  4024:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  4025:     ; Dont' move horizontally.
                            	  4026:     ;
02:0004208A 0C000040        	  4027:     cmpi.b  #$40,D0
02:0004208E 6604            	  4028:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4029:     ; Else high nibble = 4. We're at the top edge.
                            	  4030:     ; Move left 1 pixel.
                            	  4031:     ;
02:00042090 532C000A        	  4032:     subq.b  #1,($000A,A4)
                            	  4033:     even
                            	  4034: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  4035:     ; Time to get the address of the column.
                            	  4036:     ; Starting at the top of the leftmost column.
                            	  4037:     ;
02:00042094 610026C6        	  4038:     jsr     FetchTileMapAddr
02:00042098 7005            	  4039:     moveq   #5,D0
02:0004209A 4EB90002A9FA    	  4040:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  4041:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  4042:     ; in order to point to the column we want.
                            	  4043:     ;
02:000420A0 102C000A        	  4044:     move.b  ($000A,A4),D0
02:000420A4 0200000F        	  4045:     andi.b #$0F,D0
02:000420A8 7600            	  4046:     moveq   #0,D3
02:000420AA 1600            	  4047:     move.b  D0,D3
02:000420AC 670C            	  4048:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  4049: _anon_z05_89:
02:000420AE 702C            	  4050:     moveq   #44,D0
02:000420B0 4EB900030F6C    	  4051:     jsr     AddToInt16At0
02:000420B6 5303            	  4052:     subq.b  #1,D3
02:000420B8 66F4            	  4053:     bne  _anon_z05_89
                            	  4054:     even
                            	  4055: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  4056:     ; Turn the row part of [0A] into a tile index.
                            	  4057:     ; row := (([0A] AND $F0) - $40) / 8
                            	  4058:     ;
02:000420BA 102C000A        	  4059:     move.b  ($000A,A4),D0
02:000420BE 020000F0        	  4060:     andi.b #$F0,D0
02:000420C2 003C0011        	  4061:     ori     #$11,CCR  ; SEC: set C+X
02:000420C6 123C0040        	  4062:     move.b  #$40,D1
02:000420CA 0A3C0010        	  4063:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000420CE 9101            	  4064:     subx.b  D1,D0   ; SBC #$40
02:000420D0 0A3C0010        	  4065:     eori    #$10,CCR  ; restore X = 6502 C
02:000420D4 E208            	  4066:     lsr.b  #1,D0   ; LSR A
02:000420D6 E208            	  4067:     lsr.b  #1,D0   ; LSR A
02:000420D8 E208            	  4068:     lsr.b  #1,D0   ; LSR A
02:000420DA 7600            	  4069:     moveq   #0,D3
02:000420DC 1600            	  4070:     move.b  D0,D3
                            	  4071:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  4072:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  4073:     ; when coming in from the edges.
                            	  4074:     ;
02:000420DE 1214            	  4075:     move.b  ($00,A4),D1   ; ptr lo
02:000420E0 182C0001        	  4076:     move.b  ($01,A4),D4  ; ptr hi
02:000420E4 024100FF        	  4077:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000420E8 E14C            	  4078:     lsl.w   #8,D4
02:000420EA 8841            	  4079:     or.w    D1,D4             ; D4 = NES ptr addr
02:000420EC 48C4            	  4080:     ext.l   D4
02:000420EE D8BC00FF0000    	  4081:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000420F4 2044            	  4082:     movea.l D4,A0
02:000420F6 10303000        	  4083:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
