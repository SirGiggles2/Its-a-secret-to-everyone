                            	  7178: __far_z_04_0065:
                            	  7179:     ; New bloated substate >= 2.
                            	  7180:     ;
                            	  7181:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7182:     ; which will transition to state 0 (moving).
                            	  7183:     ;
                            	  7184:     ; Note that if the bomb hits >= 2, then:
                            	  7185:     ; - If new substate = 2, then substate 2 will wait,
                            	  7186:     ;   and then transition to substate 3.
                            	  7187:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7188:     ;
02:0003C992 7600            	  7189:     moveq   #0,D3
02:0003C994 41EC0437        	  7190:     lea     ($0437,A4),A0
02:0003C998 16302000        	  7191:     move.b  (A0,D2.W),D3
02:0003C99C 0C030002        	  7192:     cmpi.b  #$02,D3
02:0003C9A0 6502            	  7193:     bcs.s  __far_z_04_0066
02:0003C9A2 600A            	  7194:     jmp  L_Dodongo_DecrementBloatedTimer
