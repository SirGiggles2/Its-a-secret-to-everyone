                            	  8009: L_PolsVoice_DrawAndCheckCollisions:
02:0003CF2C 7008            	  8010:     moveq   #8,D0
02:0003CF2E 4EB90004D21C    	  8011:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003CF34 41EC03E4        	  8012:     lea     ($03E4,A4),A0
