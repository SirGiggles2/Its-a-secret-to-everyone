02:00043CEC 7000            	  6519:     moveq   #0,D0
02:00043CEE 19400003        	  6520:     move.b  D0,($0003,A4)
02:00043CF2 101D            	  6521:     move.b  (A5)+,D0  ; PLA
02:00043CF4 E308            	  6522:     lsl.b  #1,D0   ; ASL A
02:00043CF6 E308            	  6523:     lsl.b  #1,D0   ; ASL A
02:00043CF8 1880            	  6524:     move.b  D0,($0000,A4)
02:00043CFA 4EB900030F74    	  6525:     jsr     AddToInt16At2
02:00043D00 1014            	  6526:     move.b  ($0000,A4),D0
02:00043D02 4EB900030F74    	  6527:     jsr     AddToInt16At2
02:00043D08 1014            	  6528:     move.b  ($0000,A4),D0
02:00043D0A 4EB900030F74    	  6529:     jsr     AddToInt16At2
02:00043D10 103C008C        	  6530:     move.b  #$8C,D0
