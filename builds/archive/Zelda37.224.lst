02:0003DC1A 0C020005        	  9703:     cmpi.b  #$05,D2
02:0003DC1E 660A            	  9704:     bne  _anon_z04_112
02:0003DC20 7000            	  9705:     moveq   #0,D0
02:0003DC22 41EC04F0        	  9706:     lea     ($04F0,A4),A0
02:0003DC26 11802000        	  9707:     move.b  D0,(A0,D2.W)
                            	  9708: _anon_z04_112:
02:0003DC2A 6100BB54        	  9709:     jsr     PlayBossHitCryIfNeeded
                            	  9710:     ; If still alive, then return.
                            	  9711:     ;
02:0003DC2E 41EC0405        	  9712:     lea     ($0405,A4),A0
02:0003DC32 10302000        	  9713:     move.b  (A0,D2.W),D0
02:0003DC36 674E            	  9714:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DC38 4EB90004BBA6    	  9715:     jsr     ResetShoveInfo
                            	  9716:     ; Don't let the base die on its own.
                            	  9717:     ; If this is the base, then reset metastate, and return.
                            	  9718:     ;
                            	  9719:     ; The base only dies once the last hand dies.
                            	  9720:     ;
02:0003DC3E 0C020005        	  9721:     cmpi.b  #$05,D2
02:0003DC42 660A            	  9722:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DC44 41EC0405        	  9723:     lea     ($0405,A4),A0
02:0003DC48 11802000        	  9724:     move.b  D0,(A0,D2.W)
02:0003DC4C 6038            	  9725:     jmp     _L_z04_Manhandla_CheckCollisions_Exit
                            	  9726: 
