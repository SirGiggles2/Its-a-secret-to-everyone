                            	  5852: _L_z01_CheckMazes_PlaySecretTune:
                            	  5853:     ; Play secret tune, and let the player leave the maze.
                            	  5854:     ;
02:0003144E 7004            	  5855:     moveq   #4,D0
02:00031450 19400602        	  5856:     move.b  D0,($0602,A4)
02:00031454 4E75            	  5857:     rts
                            	  5858: 
                            	  5859: ; Params:
                            	  5860: ; [02]: Y
                            	  5861: ; [03]: X
                            	  5862: ;
                            	  5863: ; Returns:
                            	  5864: ; [00]: high byte of PPU address
                            	  5865: ; [01]: low byte of PPU address
                            	  5866: ;
                            	  5867: ;
                            	  5868: ; Turn the 16-bit value 08YY into the PPU address
                            	  5869: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5870: ;
                            	  5871: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5872: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5873: ;
                            	  5874:     even
                            	  5875: MapScreenPosToPpuAddr:
02:00031456 6000A60E        	  5876:     jmp     c_map_screen_pos_to_ppu_addr
