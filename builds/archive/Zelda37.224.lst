                            	  5801: LayOutDoors:
                            	  5802:     ; Copies the right door face for the direction, type, and state
                            	  5803:     ; of the door to the play area tile map.
                            	  5804:     ;
                            	  5805:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5806:     ; that are not true doors.
                            	  5807:     ;
02:00043840 7403            	  5808:     moveq   #3,D2
                            	  5809:     even
                            	  5810: L_LayOutDoors_LoopDoors:
                            	  5811:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5812:     ;
02:00043842 7001            	  5813:     moveq   #1,D0
                            	  5814:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5815:     ;
                            	  5816:     ; [06] indicates whether we're handling the first half of
                            	  5817:     ; the door: Left half for N/S, Top half for E/W.
                            	  5818:     ;
02:00043844 19400006        	  5819:     move.b  D0,($0006,A4)
                            	  5820:     even
                            	  5821: L_LayOutDoors_LoopHalves:
02:00043848 1002            	  5822:     move.b  D2,D0
02:0004384A 1B00            	  5823:     move.b  D0,-(A5)  ; PHA
02:0004384C 1940000B        	  5824:     move.b  D0,($000B,A4)
02:00043850 41F90004381C    	  5825:     lea     (DoorBits).l,A0
02:00043856 10302000        	  5826:     move.b  (A0,D2.W),D0
02:0004385A 19400002        	  5827:     move.b  D0,($0002,A4)
02:0004385E 6100FD4A        	  5828:     jsr     FindDoorAttrByDoorBit
                            	  5829:     ; Begin looking for the door face for the door attribute.
                            	  5830:     ; In general, use the door type as the provisional face;
                            	  5831:     ; except turn 4 into 8.
                            	  5832:     ;
02:00043862 0C000005        	  5833:     cmpi.b  #$05,D0
02:00043866 642A            	  5834:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043868 0C000004        	  5835:     cmpi.b  #$04,D0
02:0004386C 6608            	  5836:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:0004386E 7008            	  5837:     moveq   #8,D0
02:00043870 6620            	  5838:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5839:     even
                            	  5840: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5841:     ; We jump here if the door type is bombable and was opened.
                            	  5842:     ; Change the provisional door face to value 9, which
                            	  5843:     ; will become the "hole in the wall".
                            	  5844:     ;
02:00043872 7009            	  5845:     moveq   #9,D0
02:00043874 665A            	  5846:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5847:     even
                            	  5848: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5849:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5850:     ; the mask of opened doors, because this is not a true door.
                            	  5851:     ;
02:00043876 1B00            	  5852:     move.b  D0,-(A5)  ; PHA
02:00043878 102C0002        	  5853:     move.b  ($0002,A4),D0
02:0004387C 4600            	  5854:     eori.b #$FF,D0
02:0004387E 122C00EE        	  5855:     move.b  ($00EE,A4),D1
02:00043882 C001            	  5856:     and.b  D1,D0
02:00043884 194000EE        	  5857:     move.b  D0,($00EE,A4)
02:00043888 101D            	  5858:     move.b  (A5)+,D0  ; PLA
                            	  5859:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5860:     ;
02:0004388A 0C000001        	  5861:     cmpi.b  #$01,D0
02:0004388E 6402            	  5862:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043890 7004            	  5863:     moveq   #4,D0
                            	  5864:     even
                            	  5865: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5866:     ; The door attribute (DA) has been mapped to a
                            	  5867:     ; provisional door face value (PF) in %A as follows:
                            	  5868:     ;
                            	  5869:     ; DA PF Meaning
                            	  5870:     ; -------------
                            	  5871:     ; 0  4  open
                            	  5872:     ; 1  1  wall
                            	  5873:     ; 2  2  false wall
                            	  5874:     ; 3  3  false wall 2
                            	  5875:     ; 4  8  bombable
                            	  5876:     ; 5  5  key
                            	  5877:     ; 6  6  key 2
                            	  5878:     ; 7  7  shutter
                            	  5879:     ;
                            	  5880:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5881:     ; has been cleared, if the type was "open" or any wall.
                            	  5882:     ;
                            	  5883:     ;
                            	  5884:     ; Save the provisional face.
02:00043892 1B00            	  5885:     move.b  D0,-(A5)  ; PHA
                            	  5886:     ; If the current direction points to a door that has been opened,
                            	  5887:     ; then see if we need to set door flags.
                            	  5888:     ;
02:00043894 102C00EE        	  5889:     move.b  ($00EE,A4),D0
02:00043898 122C0002        	  5890:     move.b  ($0002,A4),D1
02:0004389C C001            	  5891:     and.b  D1,D0
02:0004389E 7400            	  5892:     moveq   #0,D2
02:000438A0 1400            	  5893:     move.b  D0,D2
02:000438A2 101D            	  5894:     move.b  (A5)+,D0  ; PLA
02:000438A4 122C0002        	  5895:     move.b  ($0002,A4),D1
