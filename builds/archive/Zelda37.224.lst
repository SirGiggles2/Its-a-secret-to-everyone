02:0002E974 182C0001        	  1916:     move.b  ($01,A4),D4  ; ptr hi
02:0002E978 024100FF        	  1917:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E97C E14C            	  1918:     lsl.w   #8,D4
02:0002E97E 8841            	  1919:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E980 48C4            	  1920:     ext.l   D4
02:0002E982 D8BC00FF0000    	  1921:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E988 2044            	  1922:     movea.l D4,A0
02:0002E98A 10303000        	  1923:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E98E 122C0002        	  1924:     move.b  ($02,A4),D1   ; ptr lo
02:0002E992 182C0003        	  1925:     move.b  ($03,A4),D4  ; ptr hi
02:0002E996 024100FF        	  1926:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E99A E14C            	  1927:     lsl.w   #8,D4
02:0002E99C 8841            	  1928:     or.w    D1,D4
02:0002E99E 48C4            	  1929:     ext.l   D4
02:0002E9A0 D8BC00FF0000    	  1930:     add.l   #NES_RAM,D4
02:0002E9A6 2044            	  1931:     movea.l D4,A0
02:0002E9A8 11803000        	  1932:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
