                            	  2128: _L_z04_CheckZora_LoopTileCandidate:
                            	  2129:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2130:     ; If it = 0 or $F0, go loop again.
                            	  2131:     ;
02:0003A566 7600            	  2132:     moveq   #0,D3
02:0003A568 162C000D        	  2133:     move.b  ($000D,A4),D3
02:0003A56C 10343018        	  2134:     move.b  ($18,A4,D3.W),D0
02:0003A570 020000F0        	  2135:     andi.b #$F0,D0
02:0003A574 19802070        	  2136:     move.b  D0,($70,A4,D2.W)
02:0003A578 6748            	  2137:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A57A 0C0000F0        	  2138:     cmpi.b  #$F0,D0
02:0003A57E 6742            	  2139:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2140:     ; Turn the random value into a $10 pixel aligned Y coordinate.
