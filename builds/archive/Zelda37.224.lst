                            	  5982:     ; 4  4   5   bombable
                            	  5983:     ; 5  2   1   key
                            	  5984:     ; 6  2   1   key 2
                            	  5985:     ; 7  3   1   shutter
                            	  5986:     ;
                            	  5987:     ;
                            	  5988:     ; Get the direction index.
02:00043910 101D            	  5989:     move.b  (A5)+,D0  ; PLA
