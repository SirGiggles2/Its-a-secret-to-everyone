02:00031D4E 102C066F        	  6898:     move.b  ($066F,A4),D0
02:00031D52 003C0011        	  6899:     ori     #$11,CCR  ; SEC: set C+X
02:00031D56 122C000D        	  6900:     move.b  ($000D,A4),D1
