                            	  5207: 
                            	  5208: ; Each byte describes an item. The high nibble is the type.
                            	  5209: ; The low nibble is the value. Its meaning depends on the type.
                            	  5210: ;
                            	  5211: ; 0x - individuals
                            	  5212: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  5213: ; * bit mask: value doesn't matter.
                            	  5214: ;
                            	  5215: ; 1x - amounts
                            	  5216: ; Value is an amount to add.
                            	  5217: ;
                            	  5218: ; 2x - grades
                            	  5219: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  5220: ;
                            	  5221: ; 3x - error?
                            	  5222: ; Produces an item value of $FF.
                            	  5223: ;
                            	  5224:     even
