                            	  2391:     ; Here is an example result of this manipulation:
                            	  2392:     ;   record 1: $70, $71
                            	  2393:     ;   record 2: $72, $73
                            	  2394:     ;
02:0004B0FC 0C000046        	  2395:     cmpi.b  #$46,D0
02:0004B100 6530            	  2396:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B102 0C0000F3        	  2397:     cmpi.b  #$F3,D0
02:0004B106 642A            	  2398:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B108 023C00EE        	  2399:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B10C 123C0002        	  2400:     move.b  #$02,D1
02:0004B110 D101            	  2401:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B112 41EC030A        	  2402:     lea     ($030A,A4),A0
02:0004B116 11802000        	  2403:     move.b  D0,(A0,D2.W)
02:0004B11A 41EC030B        	  2404:     lea     ($030B,A4),A0
02:0004B11E 11802000        	  2405:     move.b  D0,(A0,D2.W)
02:0004B122 41EC0306        	  2406:     lea     ($0306,A4),A0
02:0004B126 52302000        	  2407:     addq.b  #1,(A0,D2.W)
02:0004B12A 41EC030B        	  2408:     lea     ($030B,A4),A0
02:0004B12E 52302000        	  2409:     addq.b  #1,(A0,D2.W)
