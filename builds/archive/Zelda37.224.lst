02:000369AE 024100FF        	  5303:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000369B2 E14C            	  5304:     lsl.w   #8,D4
02:000369B4 8841            	  5305:     or.w    D1,D4             ; D4 = NES ptr addr
02:000369B6 48C4            	  5306:     ext.l   D4
02:000369B8 D8BC00FF0000    	  5307:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000369BE 2044            	  5308:     movea.l D4,A0
02:000369C0 10303000        	  5309:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000369C4 41EC0305        	  5310:     lea     ($0305,A4),A0
02:000369C8 11802000        	  5311:     move.b  D0,(A0,D2.W)
02:000369CC 5203            	  5312:     addq.b  #1,D3
02:000369CE 5202            	  5313:     addq.b  #1,D2
