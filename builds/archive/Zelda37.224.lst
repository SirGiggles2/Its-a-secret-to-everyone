02:0003C09A 61003C78        	  5928:     jsr     Flyer_Chase
                            	  5929:     ; If timer has not expired, then
                            	  5930:     ; go see if it's time to propagate direction changes down the chain.
                            	  5931:     ;
02:0003C09E 10342028        	  5932:     move.b  ($28,A4,D2.W),D0
02:0003C0A2 6702            	  5933:     beq.s  __far_z_04_0045
