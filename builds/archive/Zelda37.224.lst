02:0002E23A 41F90002DFB4    	   919:     lea     (CaveWareXs).l,A0
02:0002E240 12302000        	   920:     move.b  (A0,D2.W),D1
02:0002E244 B001            	   921:     cmp.b   D1,D0
02:0002E246 6620            	   922:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   923:     ; If the vertical distance between Link and the item < 6, then
