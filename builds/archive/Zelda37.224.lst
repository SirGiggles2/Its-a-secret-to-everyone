                            	  8027: UpdatePolsVoiceState1_Jumping:
                            	  8028:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8029:     ;
02:0003CF56 41EC0444        	  8030:     lea     ($0444,A4),A0
02:0003CF5A 10302000        	  8031:     move.b  (A0,D2.W),D0
02:0003CF5E 023C00EE        	  8032:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF62 123C0038        	  8033:     move.b  #$38,D1
02:0003CF66 D101            	  8034:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CF68 41EC0444        	  8035:     lea     ($0444,A4),A0
02:0003CF6C 11802000        	  8036:     move.b  D0,(A0,D2.W)
                            	  8037:     ; Add Carry to high speed byte (vertical).
                            	  8038:     ;
02:0003CF70 41EC0412        	  8039:     lea     ($0412,A4),A0
02:0003CF74 10302000        	  8040:     move.b  (A0,D2.W),D0
02:0003CF78 123C0000        	  8041:     move.b  #$00,D1
02:0003CF7C D101            	  8042:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CF7E 41EC0412        	  8043:     lea     ($0412,A4),A0
02:0003CF82 11802000        	  8044:     move.b  D0,(A0,D2.W)
                            	  8045:     ; Add high speed byte to Y coordinate.
                            	  8046:     ;
02:0003CF86 023C00EE        	  8047:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF8A 41EC0084        	  8048:     lea     ($0084,A4),A0
02:0003CF8E 12302000        	  8049:     move.b  (A0,D2.W),D1
02:0003CF92 D101            	  8050:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CF94 41EC0084        	  8051:     lea     ($0084,A4),A0
02:0003CF98 11802000        	  8052:     move.b  D0,(A0,D2.W)
                            	  8053:     ; If the speed is still negative, then return.
                            	  8054:     ;
02:0003CF9C 41EC0412        	  8055:     lea     ($0412,A4),A0
02:0003CFA0 10302000        	  8056:     move.b  (A0,D2.W),D0
02:0003CFA4 6B0000AC        	  8057:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8058:     ; If Y coordinate still < target Y, then return.
                            	  8059:     ;
02:0003CFA8 41EC0084        	  8060:     lea     ($0084,A4),A0
02:0003CFAC 10302000        	  8061:     move.b  (A0,D2.W),D0
02:0003CFB0 41EC042C        	  8062:     lea     ($042C,A4),A0
02:0003CFB4 12302000        	  8063:     move.b  (A0,D2.W),D1
02:0003CFB8 B001            	  8064:     cmp.b   D1,D0
02:0003CFBA 65000096        	  8065:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  8066:     ; Else reached the destination. Go to state 0.
                            	  8067:     ;
02:0003CFBE 7000            	  8068:     moveq   #0,D0
02:0003CFC0 41EC00AC        	  8069:     lea     ($00AC,A4),A0
02:0003CFC4 11802000        	  8070:     move.b  D0,(A0,D2.W)
                            	  8071:     ; Reset 16-bit vertical speed.
                            	  8072:     ;
02:0003CFC8 41EC0444        	  8073:     lea     ($0444,A4),A0
02:0003CFCC 11802000        	  8074:     move.b  D0,(A0,D2.W)
02:0003CFD0 41EC0412        	  8075:     lea     ($0412,A4),A0
02:0003CFD4 11802000        	  8076:     move.b  D0,(A0,D2.W)
                            	  8077:     ; Choose a random direction to face in.
                            	  8078:     ;
02:0003CFD8 10342018        	  8079:     move.b  ($18,A4,D2.W),D0
02:0003CFDC 02000003        	  8080:     andi.b #$03,D0
02:0003CFE0 7600            	  8081:     moveq   #0,D3
02:0003CFE2 1600            	  8082:     move.b  D0,D3
02:0003CFE4 41F90003CDF4    	  8083:     lea     (PolsVoiceDirections).l,A0
