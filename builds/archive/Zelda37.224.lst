                            	  3152:     ; Index:  2 3 0 1
                            	  3153:     ;
02:00041AFC 4EB900030B16    	  3154:     jsr     GetOppositeDir
                            	  3155:     ; Get the appropriate coordinate for the direction:
                            	  3156:     ; X for horizontal
                            	  3157:     ; Y for vertical
                            	  3158:     ;
