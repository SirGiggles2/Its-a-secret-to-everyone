02:0003DFA6 41EC0478        	 10183:     lea     ($0478,A4),A0
02:0003DFAA 11802000        	 10184:     move.b  D0,(A0,D2.W)
02:0003DFAE 41EC046B        	 10185:     lea     ($046B,A4),A0
02:0003DFB2 10302000        	 10186:     move.b  (A0,D2.W),D0
02:0003DFB6 02000001        	 10187:     andi.b #$01,D0
02:0003DFBA 0A000001        	 10188:     eori.b #$01,D0
