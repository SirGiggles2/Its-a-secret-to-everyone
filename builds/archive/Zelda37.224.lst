02:0003A288 10342070        	  1702:     move.b  ($70,A4,D2.W),D0
02:0003A28C 023C00EE        	  1703:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A290 123C0008        	  1704:     move.b  #$08,D1
02:0003A294 D101            	  1705:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A296 020000F0        	  1706:     andi.b #$F0,D0
02:0003A29A 19802070        	  1707:     move.b  D0,($70,A4,D2.W)
                            	  1708:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1709:     ;
02:0003A29E 41EC0084        	  1710:     lea     ($0084,A4),A0
02:0003A2A2 10302000        	  1711:     move.b  (A0,D2.W),D0
02:0003A2A6 123C0008        	  1712:     move.b  #$08,D1
02:0003A2AA D101            	  1713:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A2AC 020000F0        	  1714:     andi.b #$F0,D0
