02:00043CD8 7005            	  6513:     moveq   #5,D0
02:00043CDA 4EB90002A9FA    	  6514:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00043CE0 6100739A        	  6515:     jsr     GetUniqueRoomId
02:00043CE4 1B00            	  6516:     move.b  D0,-(A5)  ; PHA
02:00043CE6 7000            	  6517:     moveq   #0,D0
