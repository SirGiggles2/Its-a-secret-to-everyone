                            	  7035: UpdateDodongoState0_Move:
                            	  7036:     ; If facing left, then push X offset 0 on the stack.
                            	  7037:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7038:     ;
                            	  7039:     ; We would like to use one set of coordinates only.
                            	  7040:     ; But movement would break down, if we did; because
                            	  7041:     ; Dodongo is so long.
                            	  7042:     ;
                            	  7043:     ; So, when not facing left, we temporarily shift the
                            	  7044:     ; X coordinate to be closer to the other side of the monster.
                            	  7045:     ;
02:0003C884 7600            	  7046:     moveq   #0,D3
02:0003C886 41EC0098        	  7047:     lea     ($0098,A4),A0
02:0003C88A 10302000        	  7048:     move.b  (A0,D2.W),D0
02:0003C88E 0200000D        	  7049:     andi.b #$0D,D0
02:0003C892 6716            	  7050:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C894 10342070        	  7051:     move.b  ($70,A4,D2.W),D0
02:0003C898 023C00EE        	  7052:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C89C 123C0010        	  7053:     move.b  #$10,D1
02:0003C8A0 D101            	  7054:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C8A2 19802070        	  7055:     move.b  D0,($70,A4,D2.W)
02:0003C8A6 163C00F0        	  7056:     move.b  #$F0,D3
                            	  7057:     even
                            	  7058: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C8AA 1003            	  7059:     move.b  D3,D0
02:0003C8AC 1B00            	  7060:     move.b  D0,-(A5)  ; PHA
02:0003C8AE 7020            	  7061:     moveq   #32,D0
02:0003C8B0 41EC041F        	  7062:     lea     ($041F,A4),A0
02:0003C8B4 11802000        	  7063:     move.b  D0,(A0,D2.W)
02:0003C8B8 6100CFC4        	  7064:     jsr     Wanderer_TargetPlayer
                            	  7065:     ; Pop the offset and add it to the X coordinate.
                            	  7066:     ;
                            	  7067:     ; This brings the X coordinate back to the unique value
                            	  7068:     ; that represents the position.
                            	  7069:     ;
02:0003C8BC 101D            	  7070:     move.b  (A5)+,D0  ; PLA
02:0003C8BE 023C00EE        	  7071:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8C2 12342070        	  7072:     move.b  ($70,A4,D2.W),D1
02:0003C8C6 D101            	  7073:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C8C8 19802070        	  7074:     move.b  D0,($70,A4,D2.W)
                            	  7075:     ; If X coordinate < $20, then face right.
                            	  7076:     ;
02:0003C8CC 0C000020        	  7077:     cmpi.b  #$20,D0
02:0003C8D0 640A            	  7078:     bcc  _anon_z04_89
02:0003C8D2 7001            	  7079:     moveq   #1,D0
02:0003C8D4 41EC0098        	  7080:     lea     ($0098,A4),A0
02:0003C8D8 11802000        	  7081:     move.b  D0,(A0,D2.W)
                            	  7082: _anon_z04_89:
02:0003C8DC 0A3C0001        	  7083:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C8E0 4E75            	  7084:     rts
