02:00036248 6AEA            	  4574:     bpl  _anon_z02_31
                            	  4575: _anon_z02_32:
                            	  4576:     ; Replace the low byte of the VRAM address with the one
                            	  4577:     ; where the next character should be written.
                            	  4578:     ;
02:0003624A 102C045F        	  4579:     move.b  ($045F,A4),D0
02:0003624E 19400303        	  4580:     move.b  D0,($0303,A4)
                            	  4581:     ; Increment the low VRAM address for the next character.
                            	  4582:     ;
02:00036252 522C045F        	  4583:     addq.b  #1,($045F,A4)
02:00036256 7000            	  4584:     moveq   #0,D0
02:00036258 1880            	  4585:     move.b  D0,($0000,A4)
02:0003625A 7000            	  4586:     moveq   #0,D0
02:0003625C 19400001        	  4587:     move.b  D0,($0001,A4)
                            	  4588:     ; Load the person text current character index.
                            	  4589:     ;
02:00036260 7600            	  4590:     moveq   #0,D3
02:00036262 162C0416        	  4591:     move.b  ($0416,A4),D3
                            	  4592:     ; Increment the index variable to point to the next character
                            	  4593:     ; for the next time.
                            	  4594:     ;
02:00036266 522C0416        	  4595:     addq.b  #1,($0416,A4)
                            	  4596:     ; Get the current character.
                            	  4597:     ;
02:0003626A 1214            	  4598:     move.b  ($00,A4),D1   ; ptr lo
02:0003626C 182C0001        	  4599:     move.b  ($01,A4),D4  ; ptr hi
02:00036270 024100FF        	  4600:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036274 E14C            	  4601:     lsl.w   #8,D4
02:00036276 8841            	  4602:     or.w    D1,D4             ; D4 = NES ptr addr
02:00036278 48C4            	  4603:     ext.l   D4
02:0003627A D8BC00FF0000    	  4604:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036280 2044            	  4605:     movea.l D4,A0
02:00036282 10303000        	  4606:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4607:     ; If the character is $25, then it's a special space. It will still
                            	  4608:     ; take up space, but will not take time to show -- meaning that
                            	  4609:     ; we'll go look up the next character to transfer.
                            	  4610:     ;
02:00036286 0200003F        	  4611:     andi.b #$3F,D0
02:0003628A 0C000025        	  4612:     cmpi.b  #$25,D0
02:0003628E 67BA            	  4613:     beq  _anon_z02_32
                            	  4614:     ; We have a non-space character. Put it in the transfer record.
                            	  4615:     ;
02:00036290 19400305        	  4616:     move.b  D0,($0305,A4)
                            	  4617:     ; Play the "heart taken/character" tune.
                            	  4618:     ;
02:00036294 7010            	  4619:     moveq   #16,D0
02:00036296 19400604        	  4620:     move.b  D0,($0604,A4)
                            	  4621:     ; If the high 2 bits of character element = 0, then return.
                            	  4622:     ;
02:0003629A 1214            	  4623:     move.b  ($00,A4),D1   ; ptr lo
02:0003629C 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:000362A0 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000362A4 E14C            	  4626:     lsl.w   #8,D4
02:000362A6 8841            	  4627:     or.w    D1,D4             ; D4 = NES ptr addr
02:000362A8 48C4            	  4628:     ext.l   D4
02:000362AA D8BC00FF0000    	  4629:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000362B0 2044            	  4630:     movea.l D4,A0
02:000362B2 10303000        	  4631:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000362B6 020000C0        	  4632:     andi.b #$C0,D0
02:000362BA 6602            	  4633:     bne.s  __far_z_02_0010
02:000362BC 6032            	  4634:     jmp  LA9F4_Exit
                            	  4635: __far_z_02_0010:
                            	  4636:     ; Determine an index based on the high 2 bits of the character element:
                            	  4637:     ;   $80: 0
                            	  4638:     ;   $40: 1
                            	  4639:     ;   $C0: 2
                            	  4640:     ;
02:000362BE 7602            	  4641:     moveq   #2,D3
02:000362C0 0C0000C0        	  4642:     cmpi.b  #$C0,D0
02:000362C4 670A            	  4643:     beq  _anon_z02_33
02:000362C6 5303            	  4644:     subq.b  #1,D3
02:000362C8 0C000040        	  4645:     cmpi.b  #$40,D0
02:000362CC 6702            	  4646:     beq  _anon_z02_33
02:000362CE 5303            	  4647:     subq.b  #1,D3
                            	  4648: _anon_z02_33:
                            	  4649:     ; The index chooses the low VRAM address of the start
                            	  4650:     ; of another line:
                            	  4651:     ;   0: $C4: front of the second line
                            	  4652:     ;   1: $E4: front of the third line
                            	  4653:     ;   2: $A4: front of the first line
                            	  4654:     ;
02:000362D0 41F900036218    	  4655:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:000362D6 10303000        	  4656:     move.b  (A0,D3.W),D0
02:000362DA 1940045F        	  4657:     move.b  D0,($045F,A4)
                            	  4658:     ; If index = 2, then we've reached the end of the text,
                            	  4659:     ; and low VRAM address is moved to the front of the first line.
                            	  4660:     ; So, advance the state of the person object, and unhalt Link.
                            	  4661:     ;
02:000362DE 0C030002        	  4662:     cmpi.b  #$02,D3
02:000362E2 6702            	  4663:     beq.s  __far_z_02_0011
02:000362E4 600A            	  4664:     jmp  LA9F4_Exit
                            	  4665: __far_z_02_0011:
02:000362E6 522C00AD        	  4666:     addq.b  #1,($00AD,A4)
02:000362EA 7000            	  4667:     moveq   #0,D0
02:000362EC 194000AC        	  4668:     move.b  D0,($00AC,A4)
                            	  4669:     even
