02:0003CD9A 7600            	  7801:     moveq   #0,D3
02:0003CD9C 41EC03E4        	  7802:     lea     ($03E4,A4),A0
02:0003CDA0 16302000        	  7803:     move.b  (A0,D2.W),D3
02:0003CDA4 671E            	  7804:     beq  _anon_z04_95
02:0003CDA6 023C00EE        	  7805:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDAA 123C0003        	  7806:     move.b  #$03,D1
02:0003CDAE D101            	  7807:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7808:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7809:     ;
                            	  7810:     ; Down has two frame images, but up only has one. By flipping
                            	  7811:     ; horizontally, you get two frame images.
                            	  7812:     ;
02:0003CDB0 7600            	  7813:     moveq   #0,D3
02:0003CDB2 41EC0098        	  7814:     lea     ($0098,A4),A0
02:0003CDB6 16302000        	  7815:     move.b  (A0,D2.W),D3
02:0003CDBA 0C030008        	  7816:     cmpi.b  #$08,D3
02:0003CDBE 6604            	  7817:     bne  _anon_z04_95
02:0003CDC0 522C000F        	  7818:     addq.b  #1,($000F,A4)
