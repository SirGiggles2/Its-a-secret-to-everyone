                            	  7917: _anon_z05_156:
02:00044C3A 101D            	  7918:     move.b  (A5)+,D0  ; PLA
                            	  7919:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7920:     ; then the player walked all the way to the edge of the play
                            	  7921:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7922:     ;
                            	  7923:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7924:     ; edge of the play area. So, set a relative position that
                            	  7925:     ; reflects that distance: $28 or -$28.
                            	  7926:     ;
                            	  7927:     ; If walking in a decreasing direction (left or up), then
                            	  7928:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7929:     ;
                            	  7930:     ; If walking in an increasing direction (right or down), then
                            	  7931:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7932:     ;
02:00044C3C 02000007        	  7933:     andi.b #$07,D0
02:00044C40 0C000002        	  7934:     cmpi.b  #$02,D0
02:00044C44 6506            	  7935:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:00044C46 0C000005        	  7936:     cmpi.b  #$05,D0
