02:0003C562 9101            	  6604:     subx.b  D1,D0   ; SBC $03
02:0003C564 0A3C0010        	  6605:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C568 41EC0084        	  6606:     lea     ($0084,A4),A0
