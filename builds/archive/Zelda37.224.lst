02:0003AD02 41EC00AC        	  3232:     lea     ($00AC,A4),A0
02:0003AD06 10302000        	  3233:     move.b  (A0,D2.W),D0
02:0003AD0A 0C000002        	  3234:     cmpi.b  #$02,D0
