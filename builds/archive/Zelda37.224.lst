                            	  5469: ; Params:
                            	  5470: ; [02]: bitmask for target door.
                            	  5471: ;
                            	  5472: ; Returns:
                            	  5473: ; A: door attribute for desired direction in current room.
                            	  5474: ; [01]: same as [02] if found; $10 otherwise
                            	  5475: ; [03]: reverse direction index
                            	  5476: ;
                            	  5477: ; Door bits:
                            	  5478: ; 1: E
                            	  5479: ; 2: W
                            	  5480: ; 4: S
                            	  5481: ; 8: N
                            	  5482: ;
                            	  5483: ;
                            	  5484: ; Start with single-bit mask 1.
                            	  5485:     even
