                            	  5187: __far_z_07_0079:
                            	  5188:     ; Try to activate a fire object. Temporarily mark the candle
                            	  5189:     ; unused, so it only has to depend on having an empty slot.
                            	  5190:     ;
                            	  5191:     ; If successful, Link's state will have been changed to "using item".
                            	  5192:     ; But we don't want that in this case.
                            	  5193:     ;
                            	  5194:     ; For both these reasons, save state and restore it afterward.
                            	  5195:     ;
02:0004C49A 102C00AC        	  5196:     move.b  ($00AC,A4),D0
02:0004C49E 1B00            	  5197:     move.b  D0,-(A5)  ; PHA
02:0004C4A0 102C0513        	  5198:     move.b  ($0513,A4),D0
02:0004C4A4 1B00            	  5199:     move.b  D0,-(A5)  ; PHA
02:0004C4A6 7000            	  5200:     moveq   #0,D0
02:0004C4A8 19400513        	  5201:     move.b  D0,($0513,A4)
02:0004C4AC 4EB900030D60    	  5202:     jsr     WieldCandle
02:0004C4B2 101D            	  5203:     move.b  (A5)+,D0  ; PLA
02:0004C4B4 19400513        	  5204:     move.b  D0,($0513,A4)
02:0004C4B8 101D            	  5205:     move.b  (A5)+,D0  ; PLA
02:0004C4BA 194000AC        	  5206:     move.b  D0,($00AC,A4)
                            	  5207:     ; State $21 means that a moving fire was just made.
                            	  5208:     ;
                            	  5209:     ; If it's any another value, then we didn't find an empty slot
                            	  5210:     ; to make a fire. In this case, all that's left to do is to go
                            	  5211:     ; deactivate the shot object.
                            	  5212:     ;
02:0004C4BE 41EC00AC        	  5213:     lea     ($00AC,A4),A0
02:0004C4C2 10302000        	  5214:     move.b  (A0,D2.W),D0
02:0004C4C6 0C000021        	  5215:     cmpi.b  #$21,D0
