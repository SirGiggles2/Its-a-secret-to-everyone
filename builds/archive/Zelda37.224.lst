02:0003A734 1234203D        	  2418:     move.b  ($3D,A4,D2.W),D1
02:0003A738 8001            	  2419:     or.b  D1,D0
02:0003A73A 6610            	  2420:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2421:     ; Shoot.
                            	  2422:     ;
