02:000402A2 102C0254        	   450:     move.b  ($0254,A4),D0
02:000402A6 1B00            	   451:     move.b  D0,-(A5)  ; PHA
02:000402A8 102C0258        	   452:     move.b  ($0258,A4),D0
02:000402AC 1B00            	   453:     move.b  D0,-(A5)  ; PHA
