                            	  6008:     ;
02:0003C0D8 10342028        	  6009:     move.b  ($28,A4,D2.W),D0
02:0003C0DC 0C000010        	  6010:     cmpi.b  #$10,D0
02:0003C0E0 6702            	  6011:     beq.s  __far_z_04_0049
02:0003C0E2 6058            	  6012:     jmp  L1156B_Exit
