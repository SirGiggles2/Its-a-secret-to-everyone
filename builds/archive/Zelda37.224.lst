02:00031BD0 0C000053        	  6697:     cmpi.b  #$53,D0
02:00031BD4 6516            	  6698:     bcs  _anon_z01_84
02:00031BD6 41EC00AC        	  6699:     lea     ($00AC,A4),A0
02:00031BDA 10302000        	  6700:     move.b  (A0,D2.W),D0
02:00031BDE 020000F0        	  6701:     andi.b #$F0,D0
02:00031BE2 0C000010        	  6702:     cmpi.b  #$10,D0
02:00031BE6 6704            	  6703:     beq.s  __far_z_01_0063
02:00031BE8 600000BC        	  6704:     jmp  L73A9_Exit
