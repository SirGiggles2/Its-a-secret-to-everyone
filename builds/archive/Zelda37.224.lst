                            	 12030: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12031:     ; Loop over every segment under the head, starting from the tail.
                            	 12032:     ; Copy the next segment's direction to the current one in this loop.
                            	 12033:     ;
02:0003ED8C 41EC009A        	 12034:     lea     ($009A,A4),A0
02:0003ED90 10303000        	 12035:     move.b  (A0,D3.W),D0
02:0003ED94 41EC0099        	 12036:     lea     ($0099,A4),A0
02:0003ED98 11803000        	 12037:     move.b  D0,(A0,D3.W)
02:0003ED9C 5203            	 12038:     addq.b  #1,D3
02:0003ED9E 5314            	 12039:     subq.b  #1,($0000,A4)
02:0003EDA0 66EA            	 12040:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12041:     ; If this head segment is not aligned with a square, then return.
                            	 12042:     ;
02:0003EDA2 10342070        	 12043:     move.b  ($70,A4,D2.W),D0
02:0003EDA6 0200000F        	 12044:     andi.b #$0F,D0
02:0003EDAA 660000BA        	 12045:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12046:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12047:     ; We had to account for the usual offset of 3.
                            	 12048:     ;
02:0003EDAE 41EC0084        	 12049:     lea     ($0084,A4),A0
02:0003EDB2 10302000        	 12050:     move.b  (A0,D2.W),D0
02:0003EDB6 023C00EE        	 12051:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDBA 123C0003        	 12052:     move.b  #$03,D1
02:0003EDBE D101            	 12053:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDC0 0200000F        	 12054:     andi.b #$0F,D0
02:0003EDC4 660000A0        	 12055:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12056:     ; Store the opposite of the facing direction in [00].
                            	 12057:     ;
02:0003EDC8 41EC0098        	 12058:     lea     ($0098,A4),A0
02:0003EDCC 10302000        	 12059:     move.b  (A0,D2.W),D0
02:0003EDD0 E208            	 12060:     lsr.b  #1,D0   ; LSR A
02:0003EDD2 02000005        	 12061:     andi.b #$05,D0
02:0003EDD6 1880            	 12062:     move.b  D0,($0000,A4)
02:0003EDD8 41EC0098        	 12063:     lea     ($0098,A4),A0
02:0003EDDC 10302000        	 12064:     move.b  (A0,D2.W),D0
02:0003EDE0 E308            	 12065:     lsl.b  #1,D0   ; ASL A
02:0003EDE2 0200000A        	 12066:     andi.b #$0A,D0
02:0003EDE6 1214            	 12067:     move.b  ($0000,A4),D1
02:0003EDE8 8001            	 12068:     or.b  D1,D0
                            	 12069:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12070:     ;
02:0003EDEA 0A00000F        	 12071:     eori.b #$0F,D0
02:0003EDEE 1940050F        	 12072:     move.b  D0,($050F,A4)
                            	 12073:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12074:     ;
02:0003EDF2 10342018        	 12075:     move.b  ($18,A4,D2.W),D0
02:0003EDF6 0C000080        	 12076:     cmpi.b  #$80,D0
02:0003EDFA 656C            	 12077:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12078:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12079:     ; Load the monster's facing direction.
                            	 12080:     ;
02:0003EDFC 41EC0098        	 12081:     lea     ($0098,A4),A0
02:0003EE00 10302000        	 12082:     move.b  (A0,D2.W),D0
                            	 12083:     ; Load the next random number into Y register.
                            	 12084:     ;
02:0003EE04 7600            	 12085:     moveq   #0,D3
02:0003EE06 16342019        	 12086:     move.b  ($19,A4,D2.W),D3
                            	 12087:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12088:     ; to keep moving straight.
                            	 12089:     ;
02:0003EE0A 0C030080        	 12090:     cmpi.b  #$80,D3
02:0003EE0E 6418            	 12091:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12092:     even
                            	 12093: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12094:     ; Loop to rotate the direction bit over the mask.
                            	 12095:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12096:     ; facing direction.
                            	 12097:     ;
                            	 12098:     ; Shift right the copy of the direction.
                            	 12099:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12100:     ;
02:0003EE10 E208            	 12101:     lsr.b  #1,D0   ; LSR A
02:0003EE12 6402            	 12102:     bcc  _anon_z04_151
02:0003EE14 7008            	 12103:     moveq   #8,D0
                            	 12104: _anon_z04_151:
                            	 12105:     ; If the current direction bit is masked off, then we've reached
                            	 12106:     ; the opposite direction. Loop again.
                            	 12107:     ;
02:0003EE16 122C050F        	 12108:     move.b  ($050F,A4),D1
02:0003EE1A C200            	 12109:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE1C 67F2            	 12110:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12111:     ; If Y register >= $40, then break out of the loop.
                            	 12112:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12113:     ;
02:0003EE1E 0C030040        	 12114:     cmpi.b  #$40,D3
02:0003EE22 6404            	 12115:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12116:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12117:     ; and loop again now.
                            	 12118:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12119:     ;
02:0003EE24 7640            	 12120:     moveq   #64,D3
02:0003EE26 65E8            	 12121:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12122:     even
                            	 12123: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12124:     ; Change the facing direction to the direction found.
                            	 12125:     ;
02:0003EE28 41EC0098        	 12126:     lea     ($0098,A4),A0
02:0003EE2C 11802000        	 12127:     move.b  D0,(A0,D2.W)
                            	 12128:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12129:     ;
02:0003EE30 1940000F        	 12130:     move.b  D0,($000F,A4)
02:0003EE34 4EB900030A1C    	 12131:     jsr     BoundByRoom
                            	 12132:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12133:     ;
02:0003EE3A 102C000F        	 12134:     move.b  ($000F,A4),D0
02:0003EE3E 6618            	 12135:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12136:     even
                            	 12137: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12138:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12139:     ; for looking for any non-opposite direction that is not blocked.
                            	 12140:     ;
02:0003EE40 41EC0098        	 12141:     lea     ($0098,A4),A0
02:0003EE44 10302000        	 12142:     move.b  (A0,D2.W),D0
                            	 12143:     even
                            	 12144: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12145:     ; Shift right the copy of the direction.
                            	 12146:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12147:     ;
02:0003EE48 E208            	 12148:     lsr.b  #1,D0   ; LSR A
02:0003EE4A 6402            	 12149:     bcc  _anon_z04_152
02:0003EE4C 7008            	 12150:     moveq   #8,D0
                            	 12151: _anon_z04_152:
                            	 12152:     ; If the current direction bit is not masked off, then go check the
                            	 12153:     ; room boundary in this direction.
                            	 12154:     ; Else we've reached the opposite direction. Loop again.
                            	 12155:     ;
02:0003EE4E 122C050F        	 12156:     move.b  ($050F,A4),D1
02:0003EE52 C200            	 12157:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE54 66D2            	 12158:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE56 67F0            	 12159:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12160:     even
                            	 12161: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12162:     ; We found a direction that was not blocked by the room boundary.
                            	 12163:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12164:     ;
02:0003EE58 4EB90004B97E    	 12165:     jsr     GetCollidingTileMoving
02:0003EE5E 122C034A        	 12166:     move.b  ($034A,A4),D1
02:0003EE62 B001            	 12167:     cmp.b   D1,D0
02:0003EE64 64DA            	 12168:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12169:     even
                            	 12170: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12171:     ; TODO: confirm this
                            	 12172:     ;
                            	 12173:     ; If there were a room that had lamnolas, and they could get
                            	 12174:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12175:     ; an infinite loop.
                            	 12176:     ;
                            	 12177:     ; But, the only room with that configuration has those blocks
                            	 12178:     ; blocked off with a push block, which can only be pushed after
                            	 12179:     ; all monsters are killed.
                            	 12180:     ;
02:0003EE66 4E75            	 12181:     rts
                            	 12182: 
                            	 12183:     even
                            	 12184: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 12185:     ; Find the horizontal direction toward Link and store it in [02].
                            	 12186:     ;
02:0003EE68 7001            	 12187:     moveq   #1,D0
02:0003EE6A 19400002        	 12188:     move.b  D0,($0002,A4)
02:0003EE6E 102C0070        	 12189:     move.b  ($0070,A4),D0
02:0003EE72 003C0011        	 12190:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE76 12342070        	 12191:     move.b  ($70,A4,D2.W),D1
02:0003EE7A 0A3C0010        	 12192:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE7E 9101            	 12193:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EE80 0A3C0010        	 12194:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE84 640A            	 12195:     bcc  _anon_z04_153
02:0003EE86 122C0002        	 12196:     move.b  ($0002,A4),D1
02:0003EE8A E309            	 12197:     lsl.b  #1,D1   ; ASL $02
02:0003EE8C 19410002        	 12198:     move.b  D1,($0002,A4)
                            	 12199: _anon_z04_153:
                            	 12200:     ; Find the vertical direction toward Link and store it in [03].
                            	 12201:     ;
02:0003EE90 7004            	 12202:     moveq   #4,D0
02:0003EE92 19400003        	 12203:     move.b  D0,($0003,A4)
02:0003EE96 102C0084        	 12204:     move.b  ($0084,A4),D0
02:0003EE9A 003C0011        	 12205:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE9E 41EC0084        	 12206:     lea     ($0084,A4),A0
02:0003EEA2 12302000        	 12207:     move.b  (A0,D2.W),D1
02:0003EEA6 0A3C0010        	 12208:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEAA 9101            	 12209:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EEAC 0A3C0010        	 12210:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEB0 640A            	 12211:     bcc  _anon_z04_154
02:0003EEB2 122C0003        	 12212:     move.b  ($0003,A4),D1
02:0003EEB6 E309            	 12213:     lsl.b  #1,D1   ; ASL $03
02:0003EEB8 19410003        	 12214:     move.b  D1,($0003,A4)
                            	 12215: _anon_z04_154:
                            	 12216:     ; If the horizontal direction toward Link is not allowed, then
                            	 12217:     ; go check the vertical direction.
                            	 12218:     ;
02:0003EEBC 102C0002        	 12219:     move.b  ($0002,A4),D0
02:0003EEC0 122C050F        	 12220:     move.b  ($050F,A4),D1
02:0003EEC4 C200            	 12221:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEC6 6708            	 12222:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 12223:     ; If the horizontal direction toward Link is the same direction
                            	 12224:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 12225:     ;
02:0003EEC8 122C0098        	 12226:     move.b  ($0098,A4),D1
02:0003EECC C200            	 12227:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EECE 6604            	 12228:     bne  _anon_z04_155
                            	 12229:     even
                            	 12230: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12231:     ; Load the vertical direction toward Link in order to test it for
                            	 12232:     ; room boundary and tile collision.
                            	 12233:     ;
02:0003EED0 102C0003        	 12234:     move.b  ($0003,A4),D0
                            	 12235: _anon_z04_155:
                            	 12236:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12237:     ;
02:0003EED4 6000FF52        	 12238:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
