                            	  7563: Dodongo_Draw:
02:0003CBF8 610000F4        	  7564:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7565:     ; Make a 5-way direction index out of the facing direction
                            	  7566:     ; by shifting right once, and store it in [00].
                            	  7567:     ;
02:0003CBFC 41EC0098        	  7568:     lea     ($0098,A4),A0
02:0003CC00 10302000        	  7569:     move.b  (A0,D2.W),D0
02:0003CC04 E208            	  7570:     lsr.b  #1,D0   ; LSR A
02:0003CC06 1880            	  7571:     move.b  D0,($0000,A4)
                            	  7572:     ; If state = 0, go handle animating the two frames of this state.
                            	  7573:     ;
02:0003CC08 7600            	  7574:     moveq   #0,D3
02:0003CC0A 41EC00AC        	  7575:     lea     ($00AC,A4),A0
02:0003CC0E 16302000        	  7576:     move.b  (A0,D2.W),D3
02:0003CC12 6744            	  7577:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7578:     ; If state > 1, then the monster is stunned (state 2).
                            	  7579:     ; So, go switch frames every $20 screen frames.
                            	  7580:     ;
02:0003CC14 7020            	  7581:     moveq   #32,D0
02:0003CC16 5303            	  7582:     subq.b  #1,D3
02:0003CC18 6640            	  7583:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7584:     ; State = 1. Bloated.
                            	  7585:     ;
                            	  7586:     ; In substate 0, go animate as usual for walking.
                            	  7587:     ;
02:0003CC1A 7600            	  7588:     moveq   #0,D3
02:0003CC1C 41EC042C        	  7589:     lea     ($042C,A4),A0
02:0003CC20 16302000        	  7590:     move.b  (A0,D2.W),D3
02:0003CC24 6732            	  7591:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7592:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7593:     ; go fade the boss; so that some frames are not drawn.
                            	  7594:     ;
02:0003CC26 0C030002        	  7595:     cmpi.b  #$02,D3
02:0003CC2A 6718            	  7596:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC2C 0C030003        	  7597:     cmpi.b  #$03,D3
02:0003CC30 6712            	  7598:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7599:     ; State 1, substate 1
                            	  7600:     ;
                            	  7601:     ; Add $14 to the frame image index to index into the bloated
                            	  7602:     ; frame images and H-flips.
                            	  7603:     ;
02:0003CC32 1014            	  7604:     move.b  ($0000,A4),D0
02:0003CC34 023C00EE        	  7605:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC38 123C0014        	  7606:     move.b  #$14,D1
02:0003CC3C D101            	  7607:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC3E 7600            	  7608:     moveq   #0,D3
02:0003CC40 1600            	  7609:     move.b  D0,D3
02:0003CC42 6032            	  7610:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7611: 
                            	  7612:     even
                            	  7613: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7614:     ; In bloated substates 2 and 3:
                            	  7615:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7616:     ;
02:0003CC44 102C0015        	  7617:     move.b  ($0015,A4),D0
02:0003CC48 02000002        	  7618:     andi.b #$02,D0
02:0003CC4C 6604            	  7619:     bne.s  __far_z_04_0071
02:0003CC4E 600000A6        	  7620:     jmp  L11B00_Exit
                            	  7621: __far_z_04_0071:
02:0003CC52 7600            	  7622:     moveq   #0,D3
02:0003CC54 1614            	  7623:     move.b  ($0000,A4),D3
02:0003CC56 601E            	  7624:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7625: 
                            	  7626:     even
                            	  7627: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7628:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7629:     ;
02:0003CC58 7008            	  7630:     moveq   #8,D0
                            	  7631:     even
                            	  7632: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CC5A 7600            	  7633:     moveq   #0,D3
02:0003CC5C 1614            	  7634:     move.b  ($0000,A4),D3
02:0003CC5E 122C0015        	  7635:     move.b  ($0015,A4),D1
02:0003CC62 C001            	  7636:     and.b  D1,D0
02:0003CC64 6710            	  7637:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7638:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7639:     ; in order to index into the second set of frame image numbers.
                            	  7640:     ;
02:0003CC66 1003            	  7641:     move.b  D3,D0
02:0003CC68 023C00EE        	  7642:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC6C 123C0005        	  7643:     move.b  #$05,D1
02:0003CC70 D101            	  7644:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CC72 7600            	  7645:     moveq   #0,D3
02:0003CC74 1600            	  7646:     move.b  D0,D3
                            	  7647:     even
                            	  7648: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7649:     ; Start preparing sprites.
                            	  7650:     ;
02:0003CC76 4EB90004D222    	  7651:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CC7C 1003            	  7652:     move.b  D3,D0
02:0003CC7E 1B00            	  7653:     move.b  D0,-(A5)  ; PHA
                            	  7654:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7655:     ;
02:0003CC80 41F90003CBDA    	  7656:     lea     (DodongoFrameHFlips).l,A0
02:0003CC86 10303000        	  7657:     move.b  (A0,D3.W),D0
02:0003CC8A 1940000F        	  7658:     move.b  D0,($000F,A4)
02:0003CC8E 41F90003CBD0    	  7659:     lea     (DodongoFrameImages).l,A0
02:0003CC94 10303000        	  7660:     move.b  (A0,D3.W),D0
                            	  7661:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7662:     ; They are drawn mirrored.
                            	  7663:     ;
02:0003CC98 0C000007        	  7664:     cmpi.b  #$07,D0
02:0003CC9C 6706            	  7665:     beq  _anon_z04_92
02:0003CC9E 0C000009        	  7666:     cmpi.b  #$09,D0
02:0003CCA2 6608            	  7667:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7668: _anon_z04_92:
02:0003CCA4 4EB9000316B0    	  7669:     jsr     DrawObjectMirrored
02:0003CCAA 6006            	  7670:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7671: 
                            	  7672:     even
                            	  7673: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7674:     ; No other frame images are mirrored.
                            	  7675:     ;
02:0003CCAC 4EB9000316B4    	  7676:     jsr     DrawObjectNotMirrored
                            	  7677:     even
                            	  7678: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CCB2 101D            	  7679:     move.b  (A5)+,D0  ; PLA
02:0003CCB4 7600            	  7680:     moveq   #0,D3
02:0003CCB6 1600            	  7681:     move.b  D0,D3
                            	  7682:     ; If facing vertically, then return. There's no other side to draw.
                            	  7683:     ;
02:0003CCB8 41EC0098        	  7684:     lea     ($0098,A4),A0
02:0003CCBC 10302000        	  7685:     move.b  (A0,D2.W),D0
02:0003CCC0 02000003        	  7686:     andi.b #$03,D0
02:0003CCC4 6602            	  7687:     bne.s  __far_z_04_0072
02:0003CCC6 602E            	  7688:     jmp  L11B00_Exit
                            	  7689: __far_z_04_0072:
                            	  7690:     ; Else draw the right side.
                            	  7691:     ;
                            	  7692:     ; Keep the Y coordinate in [01].
                            	  7693:     ; But, store (X + $10) in [00].
                            	  7694:     ;
02:0003CCC8 10342070        	  7695:     move.b  ($70,A4,D2.W),D0
02:0003CCCC 023C00EE        	  7696:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCD0 123C0010        	  7697:     move.b  #$10,D1
02:0003CCD4 D101            	  7698:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CCD6 1880            	  7699:     move.b  D0,($0000,A4)
02:0003CCD8 6114            	  7700:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7701:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7702:     ;
                            	  7703:     ; So, if we had animation frame 1, direction left:
                            	  7704:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7705:     ; - frame image index = 6 (1 + 5)
                            	  7706:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7707:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7708:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7709:     ;
                            	  7710:     ; So, 3 would have been the frame number used above for
                            	  7711:     ; the left side.
                            	  7712:     ;
                            	  7713:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7714:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7715:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7716:     ; on the right.
                            	  7717:     ;
02:0003CCDA 41F90003CBD0    	  7718:     lea     (DodongoFrameImages).l,A0
02:0003CCE0 10303000        	  7719:     move.b  (A0,D3.W),D0
02:0003CCE4 0A000001        	  7720:     eori.b #$01,D0
02:0003CCE8 4EF9000316B4    	  7721:     jmp     DrawObjectNotMirrored
                            	  7722: 
                            	  7723: ; Returns:
                            	  7724: ; A: 3
                            	  7725: ; [04]: left sprite attributes
                            	  7726: ; [05]: right sprite attributes
                            	  7727: ;
                            	  7728:     even
                            	  7729: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CCEE 7003            	  7730:     moveq   #3,D0
02:0003CCF0 4EB9000319A6    	  7731:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7732:     even
