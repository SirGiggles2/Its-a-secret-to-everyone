02:0003C2A2 41EC0478        	  6301:     lea     ($0478,A4),A0
02:0003C2A6 16302000        	  6302:     move.b  (A0,D2.W),D3
                            	  6303:     ; Change the coordinates to one corner.
                            	  6304:     ;
02:0003C2AA 10342070        	  6305:     move.b  ($70,A4,D2.W),D0
02:0003C2AE 023C00EE        	  6306:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2B2 41F90003C166    	  6307:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C2B8 12303000        	  6308:     move.b  (A0,D3.W),D1
02:0003C2BC D101            	  6309:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C2BE 19802070        	  6310:     move.b  D0,($70,A4,D2.W)
02:0003C2C2 41EC0084        	  6311:     lea     ($0084,A4),A0
02:0003C2C6 10302000        	  6312:     move.b  (A0,D2.W),D0
02:0003C2CA 023C00EE        	  6313:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2CE 41F90003C16A    	  6314:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C2D4 12303000        	  6315:     move.b  (A0,D3.W),D1
02:0003C2D8 D101            	  6316:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C2DA 41EC0084        	  6317:     lea     ($0084,A4),A0
02:0003C2DE 11802000        	  6318:     move.b  D0,(A0,D2.W)
                            	  6319:     ; Check the room boundary and object collisions in this temporary location.
