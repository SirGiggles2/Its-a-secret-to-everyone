                            	  9928:     even
                            	  9929: Manhandla_Draw:
02:0003DDBE 4EB90004D222    	  9930:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9931:     ; Push the "frame image and sprite attributes" value.
                            	  9932:     ;
02:0003DDC4 41EC0478        	  9933:     lea     ($0478,A4),A0
02:0003DDC8 10302000        	  9934:     move.b  (A0,D2.W),D0
02:0003DDCC 1B00            	  9935:     move.b  D0,-(A5)  ; PHA
                            	  9936:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9937:     ; passed along as is.
                            	  9938:     ;
02:0003DDCE 02000080        	  9939:     andi.b #$80,D0
02:0003DDD2 00000001        	  9940:     ori.b #$01,D0
02:0003DDD6 4EB9000319A6    	  9941:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DDDC 101D            	  9942:     move.b  (A5)+,D0  ; PLA
02:0003DDDE 1B00            	  9943:     move.b  D0,-(A5)  ; PHA
                            	  9944:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9945:     ;
02:0003DDE0 02000040        	  9946:     andi.b #$40,D0
02:0003DDE4 6704            	  9947:     beq  _anon_z04_116
02:0003DDE6 522C000F        	  9948:     addq.b  #1,($000F,A4)
                            	  9949: _anon_z04_116:
02:0003DDEA 101D            	  9950:     move.b  (A5)+,D0  ; PLA
                            	  9951:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9952:     ; These are the 2 frame images of the horizontal hands.
                            	  9953:     ;
                            	  9954:     ; Else draw the base and vertical hands mirrored.
                            	  9955:     ;
02:0003DDEC 0200000F        	  9956:     andi.b #$0F,D0
02:0003DDF0 0C000002        	  9957:     cmpi.b  #$02,D0
02:0003DDF4 670C            	  9958:     beq  _anon_z04_117
02:0003DDF6 0C000003        	  9959:     cmpi.b  #$03,D0
02:0003DDFA 6706            	  9960:     beq  _anon_z04_117
02:0003DDFC 4EF9000316B0    	  9961:     jmp     DrawObjectMirrored
                            	  9962: 
                            	  9963: _anon_z04_117:
02:0003DE02 4EF9000316B4    	  9964:     jmp     DrawObjectNotMirrored
                            	  9965: 
                            	  9966:     even
                            	  9967: UpdateGohma:
                            	  9968:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9969:     ;
02:0003DE08 41EC0451        	  9970:     lea     ($0451,A4),A0
02:0003DE0C 10302000        	  9971:     move.b  (A0,D2.W),D0
02:0003DE10 662C            	  9972:     bne  _L_z04_UpdateGohma_Move
                            	  9973:     ; If Random:
                            	  9974:     ;   >= $B0: right
                            	  9975:     ;   >= $60: left
                            	  9976:     ;   Else:   down
                            	  9977:     ;
02:0003DE12 7001            	  9978:     moveq   #1,D0
02:0003DE14 7600            	  9979:     moveq   #0,D3
02:0003DE16 16342018        	  9980:     move.b  ($18,A4,D2.W),D3
02:0003DE1A 0C0300B0        	  9981:     cmpi.b  #$B0,D3
02:0003DE1E 640A            	  9982:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE20 E308            	  9983:     lsl.b  #1,D0   ; ASL A
02:0003DE22 0C030060        	  9984:     cmpi.b  #$60,D3
02:0003DE26 6402            	  9985:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE28 E308            	  9986:     lsl.b  #1,D0   ; ASL A
                            	  9987:     even
                            	  9988: _L_z04_UpdateGohma_ChangeDir:
02:0003DE2A 41EC0098        	  9989:     lea     ($0098,A4),A0
02:0003DE2E 11802000        	  9990:     move.b  D0,(A0,D2.W)
                            	  9991:     ; Now we can go straight without changing direction for some time.
                            	  9992:     ;
02:0003DE32 41EC0451        	  9993:     lea     ($0451,A4),A0
02:0003DE36 52302000        	  9994:     addq.b  #1,(A0,D2.W)
                            	  9995:     ; Go animate the eye.
                            	  9996:     ;
02:0003DE3A 600000C6        	  9997:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9998: 
                            	  9999:     even
                            	 10000: _L_z04_UpdateGohma_Move:
                            	 10001:     ; Add $80 to the movement accumulator.
                            	 10002:     ;
02:0003DE3E 41EC041F        	 10003:     lea     ($041F,A4),A0
02:0003DE42 10302000        	 10004:     move.b  (A0,D2.W),D0
02:0003DE46 023C00EE        	 10005:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE4A 123C0080        	 10006:     move.b  #$80,D1
02:0003DE4E D101            	 10007:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE50 41EC041F        	 10008:     lea     ($041F,A4),A0
02:0003DE54 11802000        	 10009:     move.b  D0,(A0,D2.W)
                            	 10010:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	 10011:     ;
02:0003DE58 640000A8        	 10012:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	 10013:     ; Increase the distance traveled, and move 1.
                            	 10014:     ;
02:0003DE5C 41EC0412        	 10015:     lea     ($0412,A4),A0
02:0003DE60 52302000        	 10016:     addq.b  #1,(A0,D2.W)
                            	 10017:     ; Set a direction mask in [02], starting with right (1).
                            	 10018:     ;
02:0003DE64 7001            	 10019:     moveq   #1,D0
02:0003DE66 19400002        	 10020:     move.b  D0,($0002,A4)
                            	 10021:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	 10022:     ;
02:0003DE6A 41EC0098        	 10023:     lea     ($0098,A4),A0
02:0003DE6E 10302000        	 10024:     move.b  (A0,D2.W),D0
02:0003DE72 122C0002        	 10025:     move.b  ($0002,A4),D1
02:0003DE76 C200            	 10026:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE78 6704            	 10027:     beq  _anon_z04_118
02:0003DE7A 52342070        	 10028:     addq.b  #1,($70,A4,D2.W)
                            	 10029: _anon_z04_118:
                            	 10030:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	 10031:     ;
