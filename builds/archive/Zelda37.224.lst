                            	  4288: Link_ModifyDirInDoorway:
                            	  4289:     ; In a doorway (UW), you can only move in the direction
                            	  4290:     ; that you entered it or the opposite.
                            	  4291:     ;
                            	  4292:     ;
                            	  4293:     ; If not in a doorway nor moving, then return.
                            	  4294:     ;
02:00042308 102C0053        	  4295:     move.b  ($0053,A4),D0
02:0004230C 672E            	  4296:     beq  _L_z05_Link_ModifyDirInDoorway_Exit
02:0004230E 7600            	  4297:     moveq   #0,D3
02:00042310 162C03F8        	  4298:     move.b  ($03F8,A4),D3
02:00042314 6726            	  4299:     beq  _L_z05_Link_ModifyDirInDoorway_Exit
                            	  4300:     ; If the facing direction is part of the input direction, then
                            	  4301:     ; keep moving in the facing direction.
                            	  4302:     ;
02:00042316 102C0098        	  4303:     move.b  ($0098,A4),D0
02:0004231A 122C03F8        	  4304:     move.b  ($03F8,A4),D1
02:0004231E C001            	  4305:     and.b  D1,D0
02:00042320 6616            	  4306:     bne  _anon_z05_94
                            	  4307:     ; If the opposite of the facing direction is part of the input direction, then
                            	  4308:     ; face the opposite direction.
                            	  4309:     ;
02:00042322 102C0098        	  4310:     move.b  ($0098,A4),D0
02:00042326 4EB900030B16    	  4311:     jsr     GetOppositeDir
02:0004232C 122C03F8        	  4312:     move.b  ($03F8,A4),D1
02:00042330 C001            	  4313:     and.b  D1,D0
                            	  4314:     ; If neither direction matched input direction, then
                            	  4315:     ; change input direction to facing direction.
                            	  4316:     ;
02:00042332 6604            	  4317:     bne  _anon_z05_94
02:00042334 102C0098        	  4318:     move.b  ($0098,A4),D0
                            	  4319: _anon_z05_94:
