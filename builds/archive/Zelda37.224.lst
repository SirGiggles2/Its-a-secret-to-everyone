02:0003DC5C 0C00003C        	  9744:     cmpi.b  #$3C,D0
02:0003DC60 6602            	  9745:     bne  _anon_z04_113
02:0003DC62 5214            	  9746:     addq.b  #1,($0000,A4)
                            	  9747: _anon_z04_113:
