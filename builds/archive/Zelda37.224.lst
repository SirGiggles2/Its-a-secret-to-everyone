02:0004CA9C 6602            	  6059:     bne.s  __far_z_07_0093
02:0004CA9E 6014            	  6060:     jmp  CalcBoomerangFrame
                            	  6061: __far_z_07_0093:
02:0004CAA0 7003            	  6062:     moveq   #3,D0
02:0004CAA2 41EC03D0        	  6063:     lea     ($03D0,A4),A0
02:0004CAA6 11802000        	  6064:     move.b  D0,(A0,D2.W)
02:0004CAAA 7020            	  6065:     moveq   #32,D0
02:0004CAAC 41EC00AC        	  6066:     lea     ($00AC,A4),A0
02:0004CAB0 11802000        	  6067:     move.b  D0,(A0,D2.W)
                            	  6068:     even
                            	  6069: CalcBoomerangFrame:
                            	  6070:     ; The minor state (low 3 bits of state) is used to
                            	  6071:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  6072:     ;
                            	  6073:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  6074:     ; In other words, don't offset the coordinate below.
                            	  6075:     ;
02:0004CAB4 7000            	  6076:     moveq   #0,D0
02:0004CAB6 1880            	  6077:     move.b  D0,($0000,A4)
02:0004CAB8 41EC00AC        	  6078:     lea     ($00AC,A4),A0
02:0004CABC 10302000        	  6079:     move.b  (A0,D2.W),D0
02:0004CAC0 0200000F        	  6080:     andi.b #$0F,D0
02:0004CAC4 7600            	  6081:     moveq   #0,D3
02:0004CAC6 1600            	  6082:     move.b  D0,D3
02:0004CAC8 7000            	  6083:     moveq   #0,D0
02:0004CACA 19400001        	  6084:     move.b  D0,($0001,A4)
02:0004CACE 41F90004C6BC    	  6085:     lea     (BoomerangFrameCycle).l,A0
02:0004CAD4 10303000        	  6086:     move.b  (A0,D3.W),D0
02:0004CAD8 1940000C        	  6087:     move.b  D0,($000C,A4)
                            	  6088:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  6089:     ;
02:0004CADC 1003            	  6090:     move.b  D3,D0
02:0004CADE 41F90004C6C6    	  6091:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004CAE4 10303000        	  6092:     move.b  (A0,D3.W),D0
02:0004CAE8 19400004        	  6093:     move.b  D0,($0004,A4)
                            	  6094:     ; TODO: ?
                            	  6095:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  6096:     ; Else add the item value of the magic boomerang.
                            	  6097:     ;
                            	  6098:     ; But none of the values in the base sprite attributes array is 8.
                            	  6099:     ;
                            	  6100:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  6101:     ; the inventory will always be added to the base sprite attribute.
                            	  6102:     ;
                            	  6103:     ; So, palette row 4 or 5 will be chosen.
                            	  6104:     ;
02:0004CAEC 7600            	  6105:     moveq   #0,D3
02:0004CAEE 0C000008        	  6106:     cmpi.b  #$08,D0
02:0004CAF2 6706            	  6107:     beq  _anon_z07_31
02:0004CAF4 7600            	  6108:     moveq   #0,D3
02:0004CAF6 162C0675        	  6109:     move.b  ($0675,A4),D3
                            	  6110: _anon_z07_31:
02:0004CAFA 1003            	  6111:     move.b  D3,D0
02:0004CAFC 023C00EE        	  6112:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004CB00 122C0004        	  6113:     move.b  ($0004,A4),D1
02:0004CB04 D101            	  6114:     addx.b  D1,D0   ; ADC $04
02:0004CB06 19400004        	  6115:     move.b  D0,($0004,A4)
02:0004CB0A 761D            	  6116:     moveq   #29,D3
02:0004CB0C 601C            	  6117:     jmp     L_DrawArrowOrBoomerang
