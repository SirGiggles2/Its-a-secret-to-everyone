                            	  7119: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7120:     ; Bloated timer =>
                            	  7121:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7122:     ; 1:     go advance the substate
                            	  7123:     ; other: go decrement Bloated timer
                            	  7124:     ;
02:0003C91C 7600            	  7125:     moveq   #0,D3
02:0003C91E 41EC045E        	  7126:     lea     ($045E,A4),A0
