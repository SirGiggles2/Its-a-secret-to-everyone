02:0003C4DC 10302000        	  6557:     move.b  (A0,D2.W),D0
02:0003C4E0 122C0002        	  6558:     move.b  ($0002,A4),D1
02:0003C4E4 E309            	  6559:     lsl.b  #1,D1   ; ASL $02
02:0003C4E6 19410002        	  6560:     move.b  D1,($0002,A4)
02:0003C4EA 122C0002        	  6561:     move.b  ($0002,A4),D1
02:0003C4EE C200            	  6562:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4F0 6716            	  6563:     beq  _L_z04_Digdogger_Move_Down
02:0003C4F2 10342070        	  6564:     move.b  ($70,A4,D2.W),D0
