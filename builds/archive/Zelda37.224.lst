02:000313E4 142C052F        	  5794:     move.b  ($052F,A4),D2
02:000313E8 102C0098        	  5795:     move.b  ($0098,A4),D0
02:000313EC 7600            	  5796:     moveq   #0,D3
02:000313EE 162C00EB        	  5797:     move.b  ($00EB,A4),D3
02:000313F2 0C030061        	  5798:     cmpi.b  #$61,D3
02:000313F6 6630            	  5799:     bne  _L_z01_CheckMazes_CheckMountainMaze
02:000313F8 41F9000313DA    	  5800:     lea     (ForestMazeDirs).l,A0
02:000313FE 12302000        	  5801:     move.b  (A0,D2.W),D1
02:00031402 B001            	  5802:     cmp.b   D1,D0
02:00031404 6618            	  5803:     bne  _L_z01_CheckMazes_Mismatch
                            	  5804:     ; The direction matches the step.
                            	  5805:     ;
02:00031406 0C020003        	  5806:     cmpi.b  #$03,D2
02:0003140A 6742            	  5807:     beq  _L_z01_CheckMazes_PlaySecretTune
                            	  5808:     even
                            	  5809: _L_z01_CheckMazes_AdvanceMaze:
                            	  5810:     ; Haven't passed the last step. So increment the step,
