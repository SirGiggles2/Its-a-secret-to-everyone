02:0003A2D0 10302000        	  1743:     move.b  (A0,D2.W),D0
02:0003A2D4 123C0008        	  1744:     move.b  #$08,D1
02:0003A2D8 D101            	  1745:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A2DA 020000F0        	  1746:     andi.b #$F0,D0
02:0003A2DE 0000000D        	  1747:     ori.b #$0D,D0
02:0003A2E2 41EC0084        	  1748:     lea     ($0084,A4),A0
