02:0003AD2A 0C000011        	  3262:     cmpi.b  #$11,D0
02:0003AD2E 6614            	  3263:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:0003AD30 41EC00AC        	  3264:     lea     ($00AC,A4),A0
02:0003AD34 10302000        	  3265:     move.b  (A0,D2.W),D0
