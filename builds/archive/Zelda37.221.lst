                            	  4944: 
                            	  4945: ; Params:
                            	  4946: ; [02:03]: address of door tiles for direction and face
                            	  4947: ; [04]: count of tiles remaining
                            	  4948: ; [07]: current index (0 to 3) of the tile to copy
                            	  4949: ;       to the dynamic transfer buf
                            	  4950: ; [09]: door direction index
                            	  4951: ;
                            	  4952: ; Returns:
                            	  4953: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4954: ; [04]: original value - 1
                            	  4955: ; [07]: original value + 1
                            	  4956: ;
                            	  4957: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4958: ; vertically. The point of this routine is to access them
                            	  4959: ; horizontally in order to transfer them to a nametable.
                            	  4960: ;
                            	  4961: ;
                            	  4962: ; For the direction index in [09], look up the base offset of the
                            	  4963: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
