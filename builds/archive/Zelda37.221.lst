02:00031BC2 10302000        	  6700:     move.b  (A0,D2.W),D0
02:00031BC6 020000F0        	  6701:     andi.b #$F0,D0
02:00031BCA 0C000010        	  6702:     cmpi.b  #$10,D0
02:00031BCE 6704            	  6703:     beq.s  __far_z_01_0063
