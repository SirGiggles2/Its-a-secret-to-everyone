02:0003C572 E309            	  6627:     lsl.b  #1,D1   ; ASL $02
02:0003C574 19410002        	  6628:     move.b  D1,($0002,A4)
02:0003C578 122C0002        	  6629:     move.b  ($0002,A4),D1
02:0003C57C C200            	  6630:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C57E 671E            	  6631:     beq  _L_z04_Digdogger_Move_End
02:0003C580 41EC0084        	  6632:     lea     ($0084,A4),A0
02:0003C584 10302000        	  6633:     move.b  (A0,D2.W),D0
02:0003C588 122C0003        	  6634:     move.b  ($0003,A4),D1
02:0003C58C 0A3C0010        	  6635:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C590 9101            	  6636:     subx.b  D1,D0   ; SBC $03
02:0003C592 0A3C0010        	  6637:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C596 41EC0084        	  6638:     lea     ($0084,A4),A0
02:0003C59A 11802000        	  6639:     move.b  D0,(A0,D2.W)
