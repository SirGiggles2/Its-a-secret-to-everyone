02:0002E10A 10303000        	   750:     move.b  (A0,D3.W),D0
02:0002E10E 41EC0302        	   751:     lea     ($0302,A4),A0
02:0002E112 11803000        	   752:     move.b  D0,(A0,D3.W)
02:0002E116 5303            	   753:     subq.b  #1,D3
02:0002E118 6AEA            	   754:     bpl  _anon_z01_7
                            	   755:     even
                            	   756: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   757:     ; Replace the low byte of the VRAM address with the one
                            	   758:     ; where the next character should be written.
                            	   759:     ;
02:0002E11A 102C045F        	   760:     move.b  ($045F,A4),D0
02:0002E11E 19400303        	   761:     move.b  D0,($0303,A4)
                            	   762:     ; Increment the low VRAM address for the next character.
                            	   763:     ;
02:0002E122 522C045F        	   764:     addq.b  #1,($045F,A4)
                            	   765:     ; Use the person text selector to look up the address of the
                            	   766:     ; text for the textbox. Store the address in [00:01].
                            	   767:     ;
02:0002E126 7600            	   768:     moveq   #0,D3
02:0002E128 162C0415        	   769:     move.b  ($0415,A4),D3
02:0002E12C 41F90002D762    	   770:     lea     (PersonTextAddrs).l,A0
02:0002E132 10303000        	   771:     move.b  (A0,D3.W),D0
02:0002E136 1880            	   772:     move.b  D0,($0000,A4)
02:0002E138 5203            	   773:     addq.b  #1,D3
02:0002E13A 41F90002D762    	   774:     lea     (PersonTextAddrs).l,A0
02:0002E140 10303000        	   775:     move.b  (A0,D3.W),D0
02:0002E144 19400001        	   776:     move.b  D0,($0001,A4)
                            	   777:     ; Load the person text current character index.
                            	   778:     ;
02:0002E148 7600            	   779:     moveq   #0,D3
02:0002E14A 162C0416        	   780:     move.b  ($0416,A4),D3
                            	   781:     ; Increment the index variable to point to the next character
                            	   782:     ; for next time.
                            	   783:     ;
02:0002E14E 522C0416        	   784:     addq.b  #1,($0416,A4)
                            	   785:     ; Get the current character.
                            	   786:     ;
02:0002E152 1214            	   787:     move.b  ($00,A4),D1   ; ptr lo
02:0002E154 182C0001        	   788:     move.b  ($01,A4),D4  ; ptr hi
02:0002E158 024100FF        	   789:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E15C E14C            	   790:     lsl.w   #8,D4
02:0002E15E 8841            	   791:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E160 48C4            	   792:     ext.l   D4
02:0002E162 D8BC00FF0000    	   793:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E168 2044            	   794:     movea.l D4,A0
02:0002E16A 10303000        	   795:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   796:     ; If the character is $25, then it's a special space. It will still
                            	   797:     ; take up space, but will not take time to show -- meaning that
                            	   798:     ; we'll go look up the next character to transfer.
                            	   799:     ;
02:0002E16E 0200003F        	   800:     andi.b #$3F,D0
