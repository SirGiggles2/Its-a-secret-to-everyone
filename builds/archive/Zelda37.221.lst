02:00031E16 60000102        	  7028:     jmp  L74D8_Exit
                            	  7029: __far_z_01_0072:
                            	  7030:     ; If the weapon is a boomerang ...
                            	  7031:     ;
02:00031E1A 0C03000F        	  7032:     cmpi.b  #$0F,D3
