02:0004CBB4 FF              	  6185:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004CBB5 01
02:0004CBB6 00
02:0004CBB7 F8
02:0004CBB8 FF
02:0004CBB9 01
02:0004CBBA F5
02:0004CBBB 0B
02:0004CBBC FF              	  6186:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004CBBD 01
02:0004CBBE F9
02:0004CBBF 07
02:0004CBC0 FF
02:0004CBC1 01
02:0004CBC2 FD
02:0004CBC3 03
