02:0003D02C 123C0030        	  8123:     move.b  #$30,D1
02:0003D030 D101            	  8124:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D032 41EC0394        	  8125:     lea     ($0394,A4),A0
02:0003D036 11802000        	  8126:     move.b  D0,(A0,D2.W)
                            	  8127:     ; Align the monster with a square horizontally.
                            	  8128:     ;
                            	  8129:     ; If in the left half of a square, align with that square.
                            	  8130:     ; If in the right half, align with the next square.
                            	  8131:     ;
02:0003D03A 10342070        	  8132:     move.b  ($70,A4,D2.W),D0
02:0003D03E 023C00EE        	  8133:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D042 123C0008        	  8134:     move.b  #$08,D1
02:0003D046 D101            	  8135:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D048 020000F0        	  8136:     andi.b #$F0,D0
02:0003D04C 19802070        	  8137:     move.b  D0,($70,A4,D2.W)
                            	  8138:     ; Align the monster with a square vertically.
                            	  8139:     ;
                            	  8140:     ; If in the top half of a square, align with that square.
                            	  8141:     ; If in the bottom half, align with the next square.
                            	  8142:     ;
02:0003D050 41EC0084        	  8143:     lea     ($0084,A4),A0
02:0003D054 10302000        	  8144:     move.b  (A0,D2.W),D0
02:0003D058 023C00EE        	  8145:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D05C 123C0008        	  8146:     move.b  #$08,D1
02:0003D060 D101            	  8147:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D062 020000F0        	  8148:     andi.b #$F0,D0
                            	  8149:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8150:     ;
02:0003D066 003C0011        	  8151:     ori     #$11,CCR  ; SEC: set C+X
02:0003D06A 123C0003        	  8152:     move.b  #$03,D1
