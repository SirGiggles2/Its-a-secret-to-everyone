                            	  7595: Dodongo_Draw:
02:0003CC26 610000F4        	  7596:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7597:     ; Make a 5-way direction index out of the facing direction
                            	  7598:     ; by shifting right once, and store it in [00].
                            	  7599:     ;
02:0003CC2A 41EC0098        	  7600:     lea     ($0098,A4),A0
02:0003CC2E 10302000        	  7601:     move.b  (A0,D2.W),D0
02:0003CC32 E208            	  7602:     lsr.b  #1,D0   ; LSR A
02:0003CC34 1880            	  7603:     move.b  D0,($0000,A4)
                            	  7604:     ; If state = 0, go handle animating the two frames of this state.
                            	  7605:     ;
02:0003CC36 7600            	  7606:     moveq   #0,D3
02:0003CC38 41EC00AC        	  7607:     lea     ($00AC,A4),A0
02:0003CC3C 16302000        	  7608:     move.b  (A0,D2.W),D3
02:0003CC40 6744            	  7609:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7610:     ; If state > 1, then the monster is stunned (state 2).
                            	  7611:     ; So, go switch frames every $20 screen frames.
                            	  7612:     ;
02:0003CC42 7020            	  7613:     moveq   #32,D0
02:0003CC44 5303            	  7614:     subq.b  #1,D3
02:0003CC46 6640            	  7615:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7616:     ; State = 1. Bloated.
                            	  7617:     ;
                            	  7618:     ; In substate 0, go animate as usual for walking.
                            	  7619:     ;
02:0003CC48 7600            	  7620:     moveq   #0,D3
02:0003CC4A 41EC042C        	  7621:     lea     ($042C,A4),A0
02:0003CC4E 16302000        	  7622:     move.b  (A0,D2.W),D3
02:0003CC52 6732            	  7623:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7624:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7625:     ; go fade the boss; so that some frames are not drawn.
                            	  7626:     ;
02:0003CC54 0C030002        	  7627:     cmpi.b  #$02,D3
02:0003CC58 6718            	  7628:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC5A 0C030003        	  7629:     cmpi.b  #$03,D3
02:0003CC5E 6712            	  7630:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7631:     ; State 1, substate 1
                            	  7632:     ;
                            	  7633:     ; Add $14 to the frame image index to index into the bloated
                            	  7634:     ; frame images and H-flips.
                            	  7635:     ;
02:0003CC60 1014            	  7636:     move.b  ($0000,A4),D0
02:0003CC62 023C00EE        	  7637:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC66 123C0014        	  7638:     move.b  #$14,D1
02:0003CC6A D101            	  7639:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC6C 7600            	  7640:     moveq   #0,D3
02:0003CC6E 1600            	  7641:     move.b  D0,D3
02:0003CC70 6032            	  7642:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7643: 
                            	  7644:     even
                            	  7645: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7646:     ; In bloated substates 2 and 3:
                            	  7647:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7648:     ;
02:0003CC72 102C0015        	  7649:     move.b  ($0015,A4),D0
02:0003CC76 02000002        	  7650:     andi.b #$02,D0
02:0003CC7A 6604            	  7651:     bne.s  __far_z_04_0071
02:0003CC7C 600000A6        	  7652:     jmp  L11B00_Exit
                            	  7653: __far_z_04_0071:
02:0003CC80 7600            	  7654:     moveq   #0,D3
02:0003CC82 1614            	  7655:     move.b  ($0000,A4),D3
02:0003CC84 601E            	  7656:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7657: 
                            	  7658:     even
                            	  7659: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7660:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7661:     ;
02:0003CC86 7008            	  7662:     moveq   #8,D0
                            	  7663:     even
                            	  7664: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CC88 7600            	  7665:     moveq   #0,D3
02:0003CC8A 1614            	  7666:     move.b  ($0000,A4),D3
02:0003CC8C 122C0015        	  7667:     move.b  ($0015,A4),D1
02:0003CC90 C001            	  7668:     and.b  D1,D0
02:0003CC92 6710            	  7669:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7670:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7671:     ; in order to index into the second set of frame image numbers.
                            	  7672:     ;
02:0003CC94 1003            	  7673:     move.b  D3,D0
02:0003CC96 023C00EE        	  7674:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC9A 123C0005        	  7675:     move.b  #$05,D1
02:0003CC9E D101            	  7676:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CCA0 7600            	  7677:     moveq   #0,D3
02:0003CCA2 1600            	  7678:     move.b  D0,D3
                            	  7679:     even
                            	  7680: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7681:     ; Start preparing sprites.
                            	  7682:     ;
02:0003CCA4 4EB90004D250    	  7683:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CCAA 1003            	  7684:     move.b  D3,D0
02:0003CCAC 1B00            	  7685:     move.b  D0,-(A5)  ; PHA
                            	  7686:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7687:     ;
02:0003CCAE 41F90003CC08    	  7688:     lea     (DodongoFrameHFlips).l,A0
02:0003CCB4 10303000        	  7689:     move.b  (A0,D3.W),D0
02:0003CCB8 1940000F        	  7690:     move.b  D0,($000F,A4)
02:0003CCBC 41F90003CBFE    	  7691:     lea     (DodongoFrameImages).l,A0
02:0003CCC2 10303000        	  7692:     move.b  (A0,D3.W),D0
                            	  7693:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7694:     ; They are drawn mirrored.
                            	  7695:     ;
02:0003CCC6 0C000007        	  7696:     cmpi.b  #$07,D0
02:0003CCCA 6706            	  7697:     beq  _anon_z04_92
02:0003CCCC 0C000009        	  7698:     cmpi.b  #$09,D0
02:0003CCD0 6608            	  7699:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7700: _anon_z04_92:
02:0003CCD2 4EB900031698    	  7701:     jsr     DrawObjectMirrored
02:0003CCD8 6006            	  7702:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7703: 
                            	  7704:     even
                            	  7705: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7706:     ; No other frame images are mirrored.
                            	  7707:     ;
02:0003CCDA 4EB90003169C    	  7708:     jsr     DrawObjectNotMirrored
                            	  7709:     even
                            	  7710: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CCE0 101D            	  7711:     move.b  (A5)+,D0  ; PLA
02:0003CCE2 7600            	  7712:     moveq   #0,D3
02:0003CCE4 1600            	  7713:     move.b  D0,D3
                            	  7714:     ; If facing vertically, then return. There's no other side to draw.
                            	  7715:     ;
02:0003CCE6 41EC0098        	  7716:     lea     ($0098,A4),A0
02:0003CCEA 10302000        	  7717:     move.b  (A0,D2.W),D0
02:0003CCEE 02000003        	  7718:     andi.b #$03,D0
02:0003CCF2 6602            	  7719:     bne.s  __far_z_04_0072
02:0003CCF4 602E            	  7720:     jmp  L11B00_Exit
                            	  7721: __far_z_04_0072:
                            	  7722:     ; Else draw the right side.
                            	  7723:     ;
                            	  7724:     ; Keep the Y coordinate in [01].
                            	  7725:     ; But, store (X + $10) in [00].
                            	  7726:     ;
02:0003CCF6 10342070        	  7727:     move.b  ($70,A4,D2.W),D0
02:0003CCFA 023C00EE        	  7728:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCFE 123C0010        	  7729:     move.b  #$10,D1
02:0003CD02 D101            	  7730:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD04 1880            	  7731:     move.b  D0,($0000,A4)
02:0003CD06 6114            	  7732:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7733:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7734:     ;
                            	  7735:     ; So, if we had animation frame 1, direction left:
                            	  7736:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7737:     ; - frame image index = 6 (1 + 5)
                            	  7738:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7739:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7740:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7741:     ;
                            	  7742:     ; So, 3 would have been the frame number used above for
                            	  7743:     ; the left side.
                            	  7744:     ;
                            	  7745:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7746:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7747:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7748:     ; on the right.
                            	  7749:     ;
02:0003CD08 41F90003CBFE    	  7750:     lea     (DodongoFrameImages).l,A0
02:0003CD0E 10303000        	  7751:     move.b  (A0,D3.W),D0
02:0003CD12 0A000001        	  7752:     eori.b #$01,D0
02:0003CD16 4EF90003169C    	  7753:     jmp     DrawObjectNotMirrored
                            	  7754: 
                            	  7755: ; Returns:
                            	  7756: ; A: 3
                            	  7757: ; [04]: left sprite attributes
                            	  7758: ; [05]: right sprite attributes
                            	  7759: ;
                            	  7760:     even
                            	  7761: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD1C 7003            	  7762:     moveq   #3,D0
02:0003CD1E 4EB90003198E    	  7763:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7764:     even
