02:00043A0C 6A02            	  6086:     bpl.s  __far_z_05_0090
02:00043A0E 604E            	  6087:     jmp  L165D4_Exit
                            	  6088: __far_z_05_0090:
02:00043A10 6000FE5E        	  6089:     jmp     L_LayOutDoors_LoopDoors
                            	  6090: 
                            	  6091: ; Params:
                            	  6092: ; A: direction index
                            	  6093: ; Y: face index
                            	  6094: ;
                            	  6095: ; Returns:
                            	  6096: ; X: direction index
                            	  6097: ; [$00:01]: address of door inside play area tile map
                            	  6098: ; [$02:03]: address of door tiles for direction and face
                            	  6099: ;
                            	  6100:     even
                            	  6101: FetchDoorAddrsFaceTilesSrcAndPlayAreaDst:
02:00043A14 7400            	  6102:     moveq   #0,D2
