02:0003693A 1880            	  5265:     move.b  D0,($0000,A4)
02:0003693C 41F90003668A    	  5266:     lea     (CreditsTextAddrsHi).l,A0
02:00036942 10303000        	  5267:     move.b  (A0,D3.W),D0
02:00036946 19400001        	  5268:     move.b  D0,($0001,A4)
                            	  5269:     ; First read the length of the string.
                            	  5270:     ;
02:0003694A 7600            	  5271:     moveq   #0,D3
02:0003694C 1214            	  5272:     move.b  ($00,A4),D1   ; ptr lo
02:0003694E 182C0001        	  5273:     move.b  ($01,A4),D4  ; ptr hi
02:00036952 024100FF        	  5274:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036956 E14C            	  5275:     lsl.w   #8,D4
02:00036958 8841            	  5276:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003695A 48C4            	  5277:     ext.l   D4
02:0003695C D8BC00FF0000    	  5278:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036962 2044            	  5279:     movea.l D4,A0
02:00036964 10303000        	  5280:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
