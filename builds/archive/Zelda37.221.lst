02:0003C52C 9101            	  6599:     subx.b  D1,D0   ; SBC $03
02:0003C52E 0A3C0010        	  6600:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C532 19802070        	  6601:     move.b  D0,($70,A4,D2.W)
                            	  6602:     even
