02:0003029A 41F90003023B    	  3205:     lea     (TrapAllowedDirs-1).l,A0
02:000302A0 12302000        	  3206:     move.b  (A0,D2.W),D1
02:000302A4 C001            	  3207:     and.b  D1,D0
