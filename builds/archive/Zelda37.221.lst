                            	  5947: Moldorm_Chase:
                            	  5948:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5949:     ; Only the head controls the movement direction.
                            	  5950:     ;
02:0003C0B8 0C020005        	  5951:     cmpi.b  #$05,D2
