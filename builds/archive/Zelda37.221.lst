                            	  9999: UpdateGohma:
                            	 10000:     ; If flagged not to continue straight, then choose a random facing direction.
                            	 10001:     ;
02:0003DE36 41EC0451        	 10002:     lea     ($0451,A4),A0
02:0003DE3A 10302000        	 10003:     move.b  (A0,D2.W),D0
02:0003DE3E 662C            	 10004:     bne  _L_z04_UpdateGohma_Move
                            	 10005:     ; If Random:
                            	 10006:     ;   >= $B0: right
                            	 10007:     ;   >= $60: left
                            	 10008:     ;   Else:   down
                            	 10009:     ;
02:0003DE40 7001            	 10010:     moveq   #1,D0
02:0003DE42 7600            	 10011:     moveq   #0,D3
02:0003DE44 16342018        	 10012:     move.b  ($18,A4,D2.W),D3
02:0003DE48 0C0300B0        	 10013:     cmpi.b  #$B0,D3
02:0003DE4C 640A            	 10014:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE4E E308            	 10015:     lsl.b  #1,D0   ; ASL A
02:0003DE50 0C030060        	 10016:     cmpi.b  #$60,D3
02:0003DE54 6402            	 10017:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE56 E308            	 10018:     lsl.b  #1,D0   ; ASL A
                            	 10019:     even
                            	 10020: _L_z04_UpdateGohma_ChangeDir:
02:0003DE58 41EC0098        	 10021:     lea     ($0098,A4),A0
02:0003DE5C 11802000        	 10022:     move.b  D0,(A0,D2.W)
                            	 10023:     ; Now we can go straight without changing direction for some time.
                            	 10024:     ;
02:0003DE60 41EC0451        	 10025:     lea     ($0451,A4),A0
02:0003DE64 52302000        	 10026:     addq.b  #1,(A0,D2.W)
                            	 10027:     ; Go animate the eye.
                            	 10028:     ;
02:0003DE68 600000C6        	 10029:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	 10030: 
                            	 10031:     even
                            	 10032: _L_z04_UpdateGohma_Move:
                            	 10033:     ; Add $80 to the movement accumulator.
                            	 10034:     ;
02:0003DE6C 41EC041F        	 10035:     lea     ($041F,A4),A0
02:0003DE70 10302000        	 10036:     move.b  (A0,D2.W),D0
02:0003DE74 023C00EE        	 10037:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE78 123C0080        	 10038:     move.b  #$80,D1
02:0003DE7C D101            	 10039:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
