                            	 13269: Ganon_CheckCollisions:
                            	 13270:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13271:     ; Store in [02] and [03].
                            	 13272:     ;
02:0003F626 10342070        	 13273:     move.b  ($70,A4,D2.W),D0
02:0003F62A 023C00EE        	 13274:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F62E 123C0010        	 13275:     move.b  #$10,D1
02:0003F632 D101            	 13276:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F634 19400002        	 13277:     move.b  D0,($0002,A4)
02:0003F638 41EC0084        	 13278:     lea     ($0084,A4),A0
02:0003F63C 10302000        	 13279:     move.b  (A0,D2.W),D0
02:0003F640 023C00EE        	 13280:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F644 123C0010        	 13281:     move.b  #$10,D1
02:0003F648 D101            	 13282:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F64A 19400003        	 13283:     move.b  D0,($0003,A4)
                            	 13284:     ; Check for a collision with Link.
                            	 13285:     ;
                            	 13286:     ; We can't call CheckLinkCollision, because we need to
                            	 13287:     ; customize Ganon's midpoint.
                            	 13288:     ;
                            	 13289:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13290:     ; detection, if Link is invincible. Initialize variables that will
                            	 13291:     ; be returned from the partial collision check routine. Then
                            	 13292:     ; call it.
                            	 13293:     ;
02:0003F64E 102C04F0        	 13294:     move.b  ($04F0,A4),D0
02:0003F652 6616            	 13295:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F654 19400006        	 13296:     move.b  D0,($0006,A4)
02:0003F658 19400009        	 13297:     move.b  D0,($0009,A4)
02:0003F65C 1940000C        	 13298:     move.b  D0,($000C,A4)
02:0003F660 7600            	 13299:     moveq   #0,D3
02:0003F662 1883            	 13300:     move.b  D3,($0000,A4)
02:0003F664 4EB900031B98    	 13301:     jsr     CheckLinkCollisionPreinit
                            	 13302:     even
                            	 13303: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13304:     ; If Ganon is not in state 0, then he's brown.
                            	 13305:     ; Go check collision with an arrow.
                            	 13306:     ;
02:0003F66A 41EC00AC        	 13307:     lea     ($00AC,A4),A0
02:0003F66E 10302000        	 13308:     move.b  (A0,D2.W),D0
02:0003F672 6652            	 13309:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13310:     ; If timer <> 0, then Ganon is visible.
                            	 13311:     ; He can't be harmed like this. So, return.
                            	 13312:     ;
02:0003F674 10342028        	 13313:     move.b  ($28,A4,D2.W),D0
02:0003F678 664A            	 13314:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F67A 760D            	 13315:     moveq   #13,D3
02:0003F67C 4EB900032062    	 13316:     jsr     CheckMonsterSwordCollision
                            	 13317:     ; If Ganon has died according to the usual collision check rules
                            	 13318:     ; (HP = 0), then:
                            	 13319:     ; 1. Restore HP to the initial value $F0
                            	 13320:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13321:     ; 3. Change palette row 7 to make Ganon brown
                            	 13322:     ;
02:0003F682 41EC0405        	 13323:     lea     ($0405,A4),A0
02:0003F686 10302000        	 13324:     move.b  (A0,D2.W),D0
02:0003F68A 6718            	 13325:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F68C 103C00F0        	 13326:     move.b  #$F0,D0
02:0003F690 41EC0485        	 13327:     lea     ($0485,A4),A0
02:0003F694 11802000        	 13328:     move.b  D0,(A0,D2.W)
02:0003F698 41EC00AC        	 13329:     lea     ($00AC,A4),A0
02:0003F69C 53302000        	 13330:     subq.b  #1,(A0,D2.W)
02:0003F6A0 61000084        	 13331:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13332:     even
                            	 13333: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13334:     ; If Ganon was harmed, then play the sound effect
                            	 13335:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13336:     ;
02:0003F6A4 41EC04F0        	 13337:     lea     ($04F0,A4),A0
02:0003F6A8 10302000        	 13338:     move.b  (A0,D2.W),D0
02:0003F6AC 670A            	 13339:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F6AE 6100A0B8        	 13340:     jsr     PlayBossHitCryIfNeeded
02:0003F6B2 7040            	 13341:     moveq   #64,D0
02:0003F6B4 19802028        	 13342:     move.b  D0,($28,A4,D2.W)
                            	 13343:     even
                            	 13344: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13345:     ; Reset metastate, because Ganon cannot die this way.
                            	 13346:     ;
02:0003F6B8 4EB90004DA58    	 13347:     jsr     ResetObjMetastate
                            	 13348:     ; Reset shove info and invincibility timer, because Ganon
                            	 13349:     ; doesn't react at all as a usual monster.
                            	 13350:     ;
02:0003F6BE 4EB900031F6A    	 13351:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13352:     even
                            	 13353: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F6C4 4E75            	 13354:     rts
                            	 13355: 
                            	 13356:     even
                            	 13357: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13358:     ; If the silver arrow is not in the inventory, then return.
                            	 13359:     ;
02:0003F6C6 102C0659        	 13360:     move.b  ($0659,A4),D0
02:0003F6CA 0C000002        	 13361:     cmpi.b  #$02,D0
02:0003F6CE 66F4            	 13362:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13363:     ; Reset the collision return value [06].
                            	 13364:     ;
02:0003F6D0 7000            	 13365:     moveq   #0,D0
02:0003F6D2 19400006        	 13366:     move.b  D0,($0006,A4)
                            	 13367:     ; If there's no arrow in flight, then return.
                            	 13368:     ;
02:0003F6D6 7612            	 13369:     moveq   #18,D3
02:0003F6D8 41EC00AC        	 13370:     lea     ($00AC,A4),A0
02:0003F6DC 10303000        	 13371:     move.b  (A0,D3.W),D0
02:0003F6E0 0C000010        	 13372:     cmpi.b  #$10,D0
02:0003F6E4 66DE            	 13373:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13374:     ; Check for collision with an arrow; and return if no collision.
                            	 13375:     ;
02:0003F6E6 4EB9000320BE    	 13376:     jsr     CheckMonsterArrowOrRodCollision
02:0003F6EC 102C0006        	 13377:     move.b  ($0006,A4),D0
02:0003F6F0 67D2            	 13378:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13379:     ; Set the Ganon phase to "dying".
                            	 13380:     ;
02:0003F6F2 41EC042C        	 13381:     lea     ($042C,A4),A0
02:0003F6F6 52302000        	 13382:     addq.b  #1,(A0,D2.W)
                            	 13383:     ; Now his body does flash.
                            	 13384:     ;
02:0003F6FA 7028            	 13385:     moveq   #40,D0
02:0003F6FC 41EC04F0        	 13386:     lea     ($04F0,A4),A0
02:0003F700 11802000        	 13387:     move.b  D0,(A0,D2.W)
                            	 13388:     ; Set initial cloud distance 8.
                            	 13389:     ;
02:0003F704 7008            	 13390:     moveq   #8,D0
02:0003F706 41EC0478        	 13391:     lea     ($0478,A4),A0
02:0003F70A 11802000        	 13392:     move.b  D0,(A0,D2.W)
02:0003F70E 0A3C0001        	 13393:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F712 4E75            	 13394:     rts
                            	 13395: 
                            	 13396:     even
