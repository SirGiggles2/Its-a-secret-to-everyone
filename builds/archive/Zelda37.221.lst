                            	  8085:     ; If the speed is still negative, then return.
                            	  8086:     ;
02:0003CFCA 41EC0412        	  8087:     lea     ($0412,A4),A0
02:0003CFCE 10302000        	  8088:     move.b  (A0,D2.W),D0
