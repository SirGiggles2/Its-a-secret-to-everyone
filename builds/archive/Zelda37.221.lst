                            	  5329: _anon_z04_70:
                            	  5330:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5331:     ; 1. negate the distance
                            	  5332:     ; 2. add 8 to the instruction offset to access
                            	  5333:     ;    the opposite direction for the same wall
                            	  5334:     ;
02:0003BBAC 7600            	  5335:     moveq   #0,D3
02:0003BBAE 162C0098        	  5336:     move.b  ($0098,A4),D3
02:0003BBB2 122C0002        	  5337:     move.b  ($0002,A4),D1
02:0003BBB6 B601            	  5338:     cmp.b   D1,D3
02:0003BBB8 662A            	  5339:     bne  _anon_z04_71
02:0003BBBA 1B00            	  5340:     move.b  D0,-(A5)  ; PHA
02:0003BBBC 41EC0412        	  5341:     lea     ($0412,A4),A0
02:0003BBC0 10302000        	  5342:     move.b  (A0,D2.W),D0
02:0003BBC4 023C00EE        	  5343:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBC8 123C0008        	  5344:     move.b  #$08,D1
02:0003BBCC D101            	  5345:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BBCE 41EC0412        	  5346:     lea     ($0412,A4),A0
02:0003BBD2 11802000        	  5347:     move.b  D0,(A0,D2.W)
02:0003BBD6 101D            	  5348:     move.b  (A5)+,D0  ; PLA
02:0003BBD8 4600            	  5349:     eori.b #$FF,D0
02:0003BBDA 023C00EE        	  5350:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBDE 123C0001        	  5351:     move.b  #$01,D1
02:0003BBE2 D101            	  5352:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5353: _anon_z04_71:
                            	  5354:     ; Add the distance and Link's minor coordinate to calculate
                            	  5355:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5356:     ; In general, the monster will be put in front of Link.
                            	  5357:     ;
02:0003BBE4 023C00EE        	  5358:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BBE8 1214            	  5359:     move.b  ($0000,A4),D1
02:0003BBEA D101            	  5360:     addx.b  D1,D0   ; ADC $00
02:0003BBEC 19400004        	  5361:     move.b  D0,($0004,A4)
                            	  5362:     ; By default, will return index 0 to choose the minimum value
                            	  5363:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5364:     ; if Link is at the wall with a smaller major coordinate.
                            	  5365:     ;
02:0003BBF0 7600            	  5366:     moveq   #0,D3
                            	  5367:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5368:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5369:     ; to access the block for the other direction along the same axis,
                            	  5370:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5371:     ;
02:0003BBF2 102C0001        	  5372:     move.b  ($0001,A4),D0
02:0003BBF6 122C0003        	  5373:     move.b  ($0003,A4),D1
02:0003BBFA B001            	  5374:     cmp.b   D1,D0
02:0003BBFC 671C            	  5375:     beq  _anon_z04_72
02:0003BBFE 41EC0412        	  5376:     lea     ($0412,A4),A0
02:0003BC02 10302000        	  5377:     move.b  (A0,D2.W),D0
02:0003BC06 023C00EE        	  5378:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC0A 123C0010        	  5379:     move.b  #$10,D1
02:0003BC0E D101            	  5380:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BC10 41EC0412        	  5381:     lea     ($0412,A4),A0
02:0003BC14 11802000        	  5382:     move.b  D0,(A0,D2.W)
02:0003BC18 5203            	  5383:     addq.b  #1,D3
