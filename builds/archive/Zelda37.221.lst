                            	  8505: _anon_z05_174:
                            	  8506:     ; Two input directions, and at least one of them is walkable.
                            	  8507:     ;
                            	  8508:     ; Make Link go straight in one direction on the next grid line.
                            	  8509:     ;
02:00045028 7600            	  8510:     moveq   #0,D3
02:0004502A 1600            	  8511:     move.b  D0,D3
02:0004502C 522C0057        	  8512:     addq.b  #1,($0057,A4)
                            	  8513:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8514:     ; object direction and input direction to last walkable direction
                            	  8515:     ; found, and set Link's speed.
                            	  8516:     ;
                            	  8517:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8518:     ;
02:00045030 7400            	  8519:     moveq   #0,D2
02:00045032 102C000D        	  8520:     move.b  ($000D,A4),D0
