                            	  7962:     ;
02:0003CEB8 41EC0098        	  7963:     lea     ($0098,A4),A0
02:0003CEBC 10302000        	  7964:     move.b  (A0,D2.W),D0
02:0003CEC0 0A00000C        	  7965:     eori.b #$0C,D0
02:0003CEC4 41EC0098        	  7966:     lea     ($0098,A4),A0
02:0003CEC8 11802000        	  7967:     move.b  D0,(A0,D2.W)
02:0003CECC 6000008C        	  7968:     jmp     L_PolsVoice_DrawAndCheckCollisions
