02:0003D0AC D101            	  8187:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:0003D0AE 41EC0084        	  8188:     lea     ($0084,A4),A0
02:0003D0B2 11802000        	  8189:     move.b  D0,(A0,D2.W)
