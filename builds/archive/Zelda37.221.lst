                            	  6725: __far_z_01_0064:
                            	  6726:     ; They collide. Now find out how they collide.
                            	  6727:     ;
                            	  6728:     ; If it's a regular monster, go harm Link.
                            	  6729:     ;
02:00031C04 41EC034F        	  6730:     lea     ($034F,A4),A0
02:00031C08 10302000        	  6731:     move.b  (A0,D2.W),D0
02:00031C0C 0C000053        	  6732:     cmpi.b  #$53,D0
02:00031C10 6402            	  6733:     bcc.s  __far_z_01_0065
02:00031C12 607C            	  6734:     jmp  HarmLink
                            	  6735: __far_z_01_0065:
                            	  6736:     ; Here, the attacker is a monster's shot/projectile.
                            	  6737:     ; Flag this kind of collision.
                            	  6738:     ;
02:00031C14 522C034B        	  6739:     addq.b  #1,($034B,A4)
