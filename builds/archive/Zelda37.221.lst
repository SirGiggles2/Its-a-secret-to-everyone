                            	  2366: 
                            	  2367: ; Params:
                            	  2368: ; A: Y coordinate
                            	  2369: ; X: object index
                            	  2370: ;
                            	  2371:     even
                            	  2372: InitWhirlwind:
02:0002FCEA 6000BF5E        	  2373:     jmp     c_init_whirlwind
                            	  2374: 
                            	  2375: SetUpWhirlwind:
02:0002FCEE 6000BD0A        	  2376:     jmp     c_set_up_whirlwind
                            	  2377: 
                            	  2378: WhirlwindPrevRoomIdList:
02:0002FCF2 36              	  2379:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FCF3 3B
02:0002FCF4 73
02:0002FCF5 44
02:0002FCF6 0A
02:0002FCF7 21
02:0002FCF8 41
02:0002FCF9 6C
                            	  2380: 
                            	  2381:     even
                            	  2382: UpdateWhirlwind_Full:
                            	  2383:     ; Get Link's halted state.
                            	  2384:     ;
02:0002FCFA 102C00AC        	  2385:     move.b  ($00AC,A4),D0
02:0002FCFE 02000040        	  2386:     andi.b #$40,D0
02:0002FD02 7600            	  2387:     moveq   #0,D3
02:0002FD04 1600            	  2388:     move.b  D0,D3
                            	  2389:     ; Add 2 to whirlwind X.
                            	  2390:     ;
02:0002FD06 7002            	  2391:     moveq   #2,D0
02:0002FD08 023C00EE        	  2392:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FD0C 12342070        	  2393:     move.b  ($70,A4,D2.W),D1
02:0002FD10 D101            	  2394:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FD12 19802070        	  2395:     move.b  D0,($70,A4,D2.W)
                            	  2396:     ; If Link is not halted or teleporting state = 0, then
                            	  2397:     ; go check for collision with Link.
                            	  2398:     ;
02:0002FD16 0C030040        	  2399:     cmpi.b  #$40,D3
02:0002FD1A 6638            	  2400:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FD1C 7600            	  2401:     moveq   #0,D3
02:0002FD1E 162C0522        	  2402:     move.b  ($0522,A4),D3
02:0002FD22 6730            	  2403:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2404:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2405:     ;
                            	  2406:     ; Set Link's X to whirlwind's.
                            	  2407:     ;
02:0002FD24 19400070        	  2408:     move.b  D0,($0070,A4)
                            	  2409:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2410:     ; the right screen edge and draw.
                            	  2411:     ;
02:0002FD28 5303            	  2412:     subq.b  #1,D3
02:0002FD2A 6776            	  2413:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FD2C 0C000080        	  2414:     cmpi.b  #$80,D0
02:0002FD30 6670            	  2415:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2416:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2417:     ;
                            	  2418:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2419:     ;
02:0002FD32 E308            	  2420:     lsl.b  #1,D0   ; ASL A
02:0002FD34 194000AC        	  2421:     move.b  D0,($00AC,A4)
02:0002FD38 19400522        	  2422:     move.b  D0,($0522,A4)
02:0002FD3C 41EC034F        	  2423:     lea     ($034F,A4),A0
02:0002FD40 11802000        	  2424:     move.b  D0,(A0,D2.W)
                            	  2425:     ; Update the player position marker, and draw one last time.
                            	  2426:     ;
02:0002FD44 1002            	  2427:     move.b  D2,D0
02:0002FD46 1B00            	  2428:     move.b  D0,-(A5)  ; PHA
02:0002FD48 610010F6        	  2429:     jsr     UpdatePlayerPositionMarker
02:0002FD4C 101D            	  2430:     move.b  (A5)+,D0  ; PLA
02:0002FD4E 7400            	  2431:     moveq   #0,D2
02:0002FD50 1400            	  2432:     move.b  D0,D2
02:0002FD52 6070            	  2433:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2434: 
                            	  2435:     even
                            	  2436: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2437:     ; Link is not halted or teleporting state = 0.
                            	  2438:     ; Try to pick up Link.
                            	  2439:     ;
                            	  2440:     ; If the whirlwind does not collide with Link, then go check
                            	  2441:     ; for the screen's right edge.
                            	  2442:     ;
02:0002FD54 61001E0C        	  2443:     jsr     CheckLinkCollision
02:0002FD58 102C0006        	  2444:     move.b  ($0006,A4),D0
02:0002FD5C 6744            	  2445:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2446:     ; Collided with Link.
                            	  2447:     ;
                            	  2448:     ; Make Link face right. Reset shove info and subroom type.
                            	  2449:     ;
02:0002FD5E 7001            	  2450:     moveq   #1,D0
02:0002FD60 19400098        	  2451:     move.b  D0,($0098,A4)
02:0002FD64 E208            	  2452:     lsr.b  #1,D0   ; LSR A
02:0002FD66 194000C0        	  2453:     move.b  D0,($00C0,A4)
02:0002FD6A 194000D3        	  2454:     move.b  D0,($00D3,A4)
02:0002FD6E 1940005A        	  2455:     move.b  D0,($005A,A4)
                            	  2456:     ; Halt Link (state $40), and hide him.
                            	  2457:     ;
02:0002FD72 7040            	  2458:     moveq   #64,D0
02:0002FD74 194000AC        	  2459:     move.b  D0,($00AC,A4)
02:0002FD78 103C00F8        	  2460:     move.b  #$F8,D0
02:0002FD7C 19400248        	  2461:     move.b  D0,($0248,A4)
02:0002FD80 1940024C        	  2462:     move.b  D0,($024C,A4)
                            	  2463:     ; Find and set the room that will behave as the previous room
                            	  2464:     ; when scrolling right to the room with the level's entrance.
                            	  2465:     ;
02:0002FD84 102C0523        	  2466:     move.b  ($0523,A4),D0
02:0002FD88 02000007        	  2467:     andi.b #$07,D0
02:0002FD8C 7600            	  2468:     moveq   #0,D3
02:0002FD8E 1600            	  2469:     move.b  D0,D3
02:0002FD90 41F90002FCF2    	  2470:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0002FD96 10303000        	  2471:     move.b  (A0,D3.W),D0
02:0002FD9A 194000EA        	  2472:     move.b  D0,($00EA,A4)
                            	  2473:     ; Set teleporting state 1.
                            	  2474:     ;
02:0002FD9E 522C0522        	  2475:     addq.b  #1,($0522,A4)
                            	  2476:     even
                            	  2477: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2478:     ; If whirlwind's X < $F0, go draw.
                            	  2479:     ;
02:0002FDA2 10342070        	  2480:     move.b  ($70,A4,D2.W),D0
02:0002FDA6 0C0000F0        	  2481:     cmpi.b  #$F0,D0
02:0002FDAA 6518            	  2482:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2483:     ; The whirlwind has reached the right edge of the screen.
                            	  2484:     ;
                            	  2485:     ; Destroy the object.
                            	  2486:     ;
02:0002FDAC 611A            	  2487:     jsr     DestroyWhirlwind
                            	  2488:     ; If teleporting state <> 0, we picked up Link.
                            	  2489:     ; So, go to the next mode.
                            	  2490:     ;
                            	  2491:     ; Either way, draw one last time.
                            	  2492:     ;
02:0002FDAE 102C0522        	  2493:     move.b  ($0522,A4),D0
02:0002FDB2 6710            	  2494:     beq  _L_z01_UpdateWhirlwind_Full_Draw
