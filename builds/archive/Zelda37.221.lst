02:0002E1F4 123C0014        	   882:     move.b  #$14,D1
02:0002E1F8 D101            	   883:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E1FA 1940067E        	   884:     move.b  D0,($067E,A4)
