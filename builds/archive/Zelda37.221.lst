02:00044C56 1B00            	  7911:     move.b  D0,-(A5)  ; PHA
02:00044C58 02000007        	  7912:     andi.b #$07,D0
02:00044C5C 0C000002        	  7913:     cmpi.b  #$02,D0
02:00044C60 6606            	  7914:     bne  _anon_z05_156
