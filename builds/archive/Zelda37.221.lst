02:0003DF7C 0C000070        	 10165:     cmpi.b  #$70,D0
02:0003DF80 6408            	 10166:     bcc  _anon_z04_123
02:0003DF82 0C000010        	 10167:     cmpi.b  #$10,D0
02:0003DF86 6502            	 10168:     bcs  _anon_z04_123
02:0003DF88 5203            	 10169:     addq.b  #1,D3
