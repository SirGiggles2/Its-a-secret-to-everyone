02:0002E198 2044            	   819:     movea.l D4,A0
02:0002E19A 10303000        	   820:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E19E 020000C0        	   821:     andi.b #$C0,D0
02:0002E1A2 672E            	   822:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   823:     ; Determine an index based on the high 2 bits of the character element:
