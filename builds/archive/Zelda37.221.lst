02:0004504A 162C0070        	  8546:     move.b  ($0070,A4),D3
02:0004504E 0C030020        	  8547:     cmpi.b  #$20,D3
02:00045052 6706            	  8548:     beq  _anon_z05_175
02:00045054 0C0300D0        	  8549:     cmpi.b  #$D0,D3
