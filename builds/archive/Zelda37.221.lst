02:0004DC3A 6710            	   815:     beq.s   .tlb_no_left
02:0004DC3C 102C0070        	   816:     move.b  ($0070,A4),D0
02:0004DC40 0C00000A        	   817:     cmpi.b  #$0A,D0
02:0004DC44 6306            	   818:     bls.s   .tlb_no_left
02:0004DC46 5900            	   819:     subi.b  #4,D0
02:0004DC48 19400070        	   820:     move.b  D0,($0070,A4)
