                            	 10120: _L_z04_UpdateGohma_AnimateEye:
                            	 10121:     ; Animate the eye.
                            	 10122:     ;
                            	 10123:     ; First, if the counter for when to open the eye next = 0, then
                            	 10124:     ; set it to a random value at least $C0; and set the timer for
                            	 10125:     ; keeping the eye open to $80.
                            	 10126:     ;
                            	 10127:     ; Note that $C0 is not a number of frames, because it's changed
                            	 10128:     ; every other frame.
                            	 10129:     ;
02:0003DF30 41EC042C        	 10130:     lea     ($042C,A4),A0
02:0003DF34 10302000        	 10131:     move.b  (A0,D2.W),D0
02:0003DF38 661E            	 10132:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DF3A 103C0080        	 10133:     move.b  #$80,D0
02:0003DF3E 41EC0444        	 10134:     lea     ($0444,A4),A0
02:0003DF42 11802000        	 10135:     move.b  D0,(A0,D2.W)
02:0003DF46 103C00C0        	 10136:     move.b  #$C0,D0
02:0003DF4A 12342018        	 10137:     move.b  ($18,A4,D2.W),D1
02:0003DF4E 8001            	 10138:     or.b  D1,D0
02:0003DF50 41EC042C        	 10139:     lea     ($042C,A4),A0
02:0003DF54 11802000        	 10140:     move.b  D0,(A0,D2.W)
                            	 10141:     even
                            	 10142: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	 10143:     ; Decrement the next-open-eye counter.
                            	 10144:     ;
