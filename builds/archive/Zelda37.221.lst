02:0004CA84 41EC03D0        	  6031:     lea     ($03D0,A4),A0
02:0004CA88 11802000        	  6032:     move.b  D0,(A0,D2.W)
02:0004CA8C 41EC00AC        	  6033:     lea     ($00AC,A4),A0
02:0004CA90 52302000        	  6034:     addq.b  #1,(A0,D2.W)
02:0004CA94 41EC00AC        	  6035:     lea     ($00AC,A4),A0
