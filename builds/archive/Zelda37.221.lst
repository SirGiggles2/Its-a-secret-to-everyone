                            	  6817:     ; Flag collision with [0C], even though [06] was already set.
                            	  6818:     ;
02:00031C94 522C000C        	  6819:     addq.b  #1,($000C,A4)
                            	  6820:     ; Unpack the damage points for the monster's type.
                            	  6821:     ; The low nibble is the high byte.
                            	  6822:     ; (Damage points byte AND $F0) is the low byte.
                            	  6823:     ;
02:00031C98 7600            	  6824:     moveq   #0,D3
02:00031C9A 41EC034F        	  6825:     lea     ($034F,A4),A0
02:00031C9E 16302000        	  6826:     move.b  (A0,D2.W),D3
02:00031CA2 41F900031B04    	  6827:     lea     (ObjTypeToDamagePoints).l,A0
02:00031CA8 10303000        	  6828:     move.b  (A0,D3.W),D0
02:00031CAC 1B00            	  6829:     move.b  D0,-(A5)  ; PHA
02:00031CAE 0200000F        	  6830:     andi.b #$0F,D0
02:00031CB2 1940000D        	  6831:     move.b  D0,($000D,A4)
02:00031CB6 101D            	  6832:     move.b  (A5)+,D0  ; PLA
02:00031CB8 020000F0        	  6833:     andi.b #$F0,D0
02:00031CBC 1940000E        	  6834:     move.b  D0,($000E,A4)
                            	  6835: ; Params:
                            	  6836: ; X: object index of the attacker
                            	  6837: ; [0D]: damage points high byte
                            	  6838: ; [0E]: damage points low byte
                            	  6839: ;
                            	  6840: ;
