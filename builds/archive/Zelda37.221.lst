02:0003F0C4 123C0003        	 12515:     move.b  #$03,D1
02:0003F0C8 0A3C0010        	 12516:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0CC 9101            	 12517:     subx.b  D1,D0   ; SBC #$03
02:0003F0CE 0A3C0010        	 12518:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0D2 7600            	 12519:     moveq   #0,D3
02:0003F0D4 1600            	 12520:     move.b  D0,D3
                            	 12521:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12522:     ; then return.
                            	 12523:     ;
