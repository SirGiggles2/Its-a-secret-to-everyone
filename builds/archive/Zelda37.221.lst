02:0004DBF2 0C2C00050012    	   789:     cmpi.b  #$05,($0012,A4)
02:0004DBF8 6668            	   790:     bne     .tlb_exit
02:0004DBFA 4A2C0013        	   791:     tst.b   ($0013,A4)
02:0004DBFE 6662            	   792:     bne     .tlb_exit
