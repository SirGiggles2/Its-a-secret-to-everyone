02:00031C30 6702            	  6753:     beq.s  __far_z_01_0068
02:00031C32 605C            	  6754:     jmp  HarmLink
                            	  6755: __far_z_01_0068:
                            	  6756:     ; If Link and the shot are not facing opposite directions,
                            	  6757:     ; then go harm Link.
                            	  6758:     ;
                            	  6759:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6760:     ; component of a monster that can move diagonally.
                            	  6761:     ;
02:00031C34 102C0098        	  6762:     move.b  ($0098,A4),D0
02:00031C38 41EC0098        	  6763:     lea     ($0098,A4),A0
02:00031C3C 12302000        	  6764:     move.b  (A0,D2.W),D1
02:00031C40 8001            	  6765:     or.b  D1,D0
02:00031C42 0200000C        	  6766:     andi.b #$0C,D0
02:00031C46 0C00000C        	  6767:     cmpi.b  #$0C,D0
02:00031C4A 671A            	  6768:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031C4C 102C0098        	  6769:     move.b  ($0098,A4),D0
02:00031C50 41EC0098        	  6770:     lea     ($0098,A4),A0
02:00031C54 12302000        	  6771:     move.b  (A0,D2.W),D1
02:00031C58 8001            	  6772:     or.b  D1,D0
02:00031C5A 02000003        	  6773:     andi.b #$03,D0
02:00031C5E 0C000003        	  6774:     cmpi.b  #$03,D0
02:00031C62 6702            	  6775:     beq.s  __far_z_01_0069
02:00031C64 602A            	  6776:     jmp  HarmLink
