02:0003E066 003C0011        	 10301:     ori     #$11,CCR  ; SEC: set C+X
02:0003E06A 123C0032        	 10302:     move.b  #$32,D1
02:0003E06E 0A3C0010        	 10303:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E072 9101            	 10304:     subx.b  D1,D0   ; SBC #$32
02:0003E074 0A3C0010        	 10305:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E078 4EF90003198E    	 10306:     jmp     Anim_SetSpriteDescriptorAttributes
