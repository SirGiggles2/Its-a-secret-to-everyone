                            	  4179: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4180:     ; If the current heart's state <> 0, then go move it.
                            	  4181:     ; Else we have to wait for it to come out at the right time.
                            	  4182:     ;
02:0003B33E 41EC00AC        	  4183:     lea     ($00AC,A4),A0
02:0003B342 10302000        	  4184:     move.b  (A0,D2.W),D0
02:0003B346 667C            	  4185:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4186:     ; The current heart's state = 0.
                            	  4187:     ;
                            	  4188:     ; If object slot = 2, then go make it appear. This is the first
                            	  4189:     ; heart to show up.
                            	  4190:     ;
02:0003B348 0C020002        	  4191:     cmpi.b  #$02,D2
02:0003B34C 6732            	  4192:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4193:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4194:     ; go start over.
                            	  4195:     ;
                            	  4196:     ; TODO:
                            	  4197:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4198:     ;
02:0003B34E 102C00AE        	  4199:     move.b  ($00AE,A4),D0
02:0003B352 67EA            	  4200:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4201:     ; Look up the starting angle of this heart with the index
                            	  4202:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4203:     ; then loop again.
                            	  4204:     ;
02:0003B354 1002            	  4205:     move.b  D2,D0
02:0003B356 003C0011        	  4206:     ori     #$11,CCR  ; SEC: set C+X
02:0003B35A 123C0003        	  4207:     move.b  #$03,D1
02:0003B35E 0A3C0010        	  4208:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B362 9101            	  4209:     subx.b  D1,D0   ; SBC #$03
02:0003B364 0A3C0010        	  4210:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B368 7600            	  4211:     moveq   #0,D3
02:0003B36A 1600            	  4212:     move.b  D0,D3
02:0003B36C 102C0396        	  4213:     move.b  ($0396,A4),D0
02:0003B370 41F90003B334    	  4214:     lea     (PondHeartStartAngles).l,A0
02:0003B376 12303000        	  4215:     move.b  (A0,D3.W),D1
02:0003B37A B001            	  4216:     cmp.b   D1,D0
02:0003B37C 66000086        	  4217:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4218:     even
