02:0003CDC0 522C000F        	  7823:     addq.b  #1,($000F,A4)
                            	  7824: _anon_z04_94:
                            	  7825:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7826:     ; This is the base frame image.
                            	  7827:     ;
02:0003CDC4 E208            	  7828:     lsr.b  #1,D0   ; LSR A
02:0003CDC6 E208            	  7829:     lsr.b  #1,D0   ; LSR A
                            	  7830:     ; If movement frame = 1, add 3 to frame image to access
                            	  7831:     ; the second animation frame's images.
                            	  7832:     ;
