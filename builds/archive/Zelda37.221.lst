                            	 12824: __far_z_04_0131:
                            	 12825:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12826:     ; Collisions were checked already.
                            	 12827:     ;
                            	 12828:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12829:     ; in anticipation of moving around when timer becomes 0 next frame.
