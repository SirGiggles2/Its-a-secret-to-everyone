02:00031D1E 0A3C0010        	  6887:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D22 19400670        	  6888:     move.b  D0,($0670,A4)
                            	  6889:     ; If full hearts >= high damage points byte, then simply
