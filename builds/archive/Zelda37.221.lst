                            	  4171: PondFairy_MoveHearts:
                            	  4172:     ; Loop over each heart from object slot 2 to 9.
                            	  4173:     ;
                            	  4174:     ; Even though they are not standalone objects, their info
                            	  4175:     ; is stored in those object slots.
