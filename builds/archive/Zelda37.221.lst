                            	  5282:     ; Second, read the offset where the first character goes
                            	  5283:     ; in the line.
                            	  5284:     ;
02:0003696C 5203            	  5285:     addq.b  #1,D3
02:0003696E 1214            	  5286:     move.b  ($00,A4),D1   ; ptr lo
02:00036970 182C0001        	  5287:     move.b  ($01,A4),D4  ; ptr hi
02:00036974 024100FF        	  5288:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00036978 E14C            	  5289:     lsl.w   #8,D4
02:0003697A 8841            	  5290:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003697C 48C4            	  5291:     ext.l   D4
02:0003697E D8BC00FF0000    	  5292:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00036984 2044            	  5293:     movea.l D4,A0
02:00036986 10303000        	  5294:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003698A 7400            	  5295:     moveq   #0,D2
02:0003698C 1400            	  5296:     move.b  D0,D2
                            	  5297:     ; Loop over each character in the rest of the credits source record.
