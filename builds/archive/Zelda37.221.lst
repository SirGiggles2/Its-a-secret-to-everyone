02:000368E6 6AFA            	  5232:     bpl  _anon_z02_43
02:000368E8 6400013E        	  5233:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5234:     ; The mask inidcates that it should have text.
                            	  5235:     ; But if line index >= $17, then it doesn't.
                            	  5236:     ;
