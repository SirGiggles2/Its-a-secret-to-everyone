                            	  6930: Aquamentus_Draw:
                            	  6931:     ; Every $10 screen frames, switch animation frames.
                            	  6932:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6933:     ; The last tile of frame 0 is at index 5.
                            	  6934:     ; The last tile of frame 1 is at index $B.
                            	  6935:     ;
02:0003C7AE 7605            	  6936:     moveq   #5,D3
02:0003C7B0 102C0015        	  6937:     move.b  ($0015,A4),D0
02:0003C7B4 02000010        	  6938:     andi.b #$10,D0
02:0003C7B8 6602            	  6939:     bne  _anon_z04_88
02:0003C7BA 760B            	  6940:     moveq   #11,D3
                            	  6941: _anon_z04_88:
02:0003C7BC 1943000A        	  6942:     move.b  D3,($000A,A4)
                            	  6943:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6944:     ;
02:0003C7C0 7005            	  6945:     moveq   #5,D0
02:0003C7C2 1940000B        	  6946:     move.b  D0,($000B,A4)
                            	  6947:     even
                            	  6948: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7C6 7600            	  6949:     moveq   #0,D3
02:0003C7C8 162C000B        	  6950:     move.b  ($000B,A4),D3
                            	  6951:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6952:     ; Store it in [00].
                            	  6953:     ;
02:0003C7CC 10342070        	  6954:     move.b  ($70,A4,D2.W),D0
02:0003C7D0 023C00EE        	  6955:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7D4 41F90003C7A8    	  6956:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C7DA 12303000        	  6957:     move.b  (A0,D3.W),D1
02:0003C7DE D101            	  6958:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C7E0 1880            	  6959:     move.b  D0,($0000,A4)
                            	  6960:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6961:     ; Store it in [01].
                            	  6962:     ;
02:0003C7E2 41EC0084        	  6963:     lea     ($0084,A4),A0
02:0003C7E6 10302000        	  6964:     move.b  (A0,D2.W),D0
02:0003C7EA 023C00EE        	  6965:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C7EE 41F90003C7A2    	  6966:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C7F4 12303000        	  6967:     move.b  (A0,D3.W),D1
02:0003C7F8 D101            	  6968:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C7FA 19400001        	  6969:     move.b  D0,($0001,A4)
                            	  6970:     ; Calculate sprite attributes:
                            	  6971:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6972:     ;
                            	  6973:     ; If the boss is temporarily invincible, then
                            	  6974:     ; this makes it flash by cycling all the palette rows.
                            	  6975:     ;
                            	  6976:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6977:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6978:     ;
02:0003C7FE 41EC04F0        	  6979:     lea     ($04F0,A4),A0
02:0003C802 10302000        	  6980:     move.b  (A0,D2.W),D0
02:0003C806 02000003        	  6981:     andi.b #$03,D0
02:0003C80A 0A000003        	  6982:     eori.b #$03,D0
02:0003C80E 19400003        	  6983:     move.b  D0,($0003,A4)
02:0003C812 7600            	  6984:     moveq   #0,D3
02:0003C814 162C000A        	  6985:     move.b  ($000A,A4),D3
                            	  6986:     ; Look up the tile for this sprite.
                            	  6987:     ; If it's not the first one (face), then go write the sprite record.
                            	  6988:     ;
02:0003C818 41F90003C796    	  6989:     lea     (AquamentusTiles).l,A0
02:0003C81E 10303000        	  6990:     move.b  (A0,D3.W),D0
02:0003C822 12390003C796    	  6991:     move.b  (AquamentusTiles).l,D1
02:0003C828 B001            	  6992:     cmp.b   D1,D0
02:0003C82A 6610            	  6993:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6994:     ; Else it's the first one (the face tile).
                            	  6995:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6996:     ;
                            	  6997:     ; $CC/CD shows the closed mouth face.
                            	  6998:     ; $C0/C1 shows the open mouth face.
                            	  6999:     ;
02:0003C82C 7600            	  7000:     moveq   #0,D3
02:0003C82E 16342028        	  7001:     move.b  ($28,A4,D2.W),D3
02:0003C832 0C030020        	  7002:     cmpi.b  #$20,D3
02:0003C836 6404            	  7003:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C838 103C00C0        	  7004:     move.b  #$C0,D0
                            	  7005:     even
                            	  7006: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C83C 610E            	  7007:     jsr     WriteBossSprite
                            	  7008:     ; Bottom of the loop.
