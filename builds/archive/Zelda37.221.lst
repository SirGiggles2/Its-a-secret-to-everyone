02:000402D0 102C0254        	   450:     move.b  ($0254,A4),D0
02:000402D4 1B00            	   451:     move.b  D0,-(A5)  ; PHA
02:000402D6 102C0258        	   452:     move.b  ($0258,A4),D0
02:000402DA 1B00            	   453:     move.b  D0,-(A5)  ; PHA
02:000402DC 4EB90004AC3C    	   454:     jsr     HideAllSprites
02:000402E2 101D            	   455:     move.b  (A5)+,D0  ; PLA
02:000402E4 19400258        	   456:     move.b  D0,($0258,A4)
02:000402E8 101D            	   457:     move.b  (A5)+,D0  ; PLA
02:000402EA 19400254        	   458:     move.b  D0,($0254,A4)
02:000402EE 522C00E1        	   459:     addq.b  #1,($00E1,A4)
02:000402F2 0A3C0001        	   460:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000402F6 4E75            	   461:     rts
