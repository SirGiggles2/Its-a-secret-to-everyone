                            	  3809: InitArmosOrFlyingGhini:
                            	  3810:     ; In UpdateObject, this object was flagged "initialized".
                            	  3811:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3812:     ;
02:0003B110 10342028        	  3813:     move.b  ($28,A4,D2.W),D0
02:0003B114 41EC0492        	  3814:     lea     ($0492,A4),A0
02:0003B118 11802000        	  3815:     move.b  D0,(A0,D2.W)
                            	  3816:     ; If it's still fading in, then go finish some initialization needed
                            	  3817:     ; for fading in.
                            	  3818:     ;
02:0003B11C 660000B6        	  3819:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3820:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3821:     ; go finish initializing it.
                            	  3822:     ;
02:0003B120 41EC034F        	  3823:     lea     ($034F,A4),A0
02:0003B124 10302000        	  3824:     move.b  (A0,D2.W),D0
02:0003B128 0C000022        	  3825:     cmpi.b  #$22,D0
02:0003B12C 670000A6        	  3826:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3827:     ; Else we have an armos.
                            	  3828:     ;
                            	  3829:     ; Store stairs tile $70 in [00] for use later.
                            	  3830:     ;
02:0003B130 7070            	  3831:     moveq   #112,D0
02:0003B132 1880            	  3832:     move.b  D0,($0000,A4)
                            	  3833:     ; Look for the current room ID in an array of room ID's that
                            	  3834:     ; have armos secrets.
                            	  3835:     ;
02:0003B134 7606            	  3836:     moveq   #6,D3
                            	  3837:     even
                            	  3838: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B136 102C00EB        	  3839:     move.b  ($00EB,A4),D0
                            	  3840:     ; If this element does not match the current room ID, go loop again.
                            	  3841:     ;
02:0003B13A 41F90003B100    	  3842:     lea     (SecretArmosRoomIds).l,A0
02:0003B140 12303000        	  3843:     move.b  (A0,D3.W),D1
02:0003B144 B001            	  3844:     cmp.b   D1,D0
02:0003B146 6648            	  3845:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3846:     ; The secret (usually stairs) is under one of the armoses.
                            	  3847:     ;
                            	  3848:     ; If the armos's X coordinate does not match the one needed
                            	  3849:     ; for the current room in the list, then go loop again.
                            	  3850:     ;
02:0003B148 10342070        	  3851:     move.b  ($70,A4,D2.W),D0
02:0003B14C 41F90003B108    	  3852:     lea     (SecretArmosXs).l,A0
02:0003B152 12303000        	  3853:     move.b  (A0,D3.W),D1
02:0003B156 B001            	  3854:     cmp.b   D1,D0
02:0003B158 6636            	  3855:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3856:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3857:     ;
02:0003B15A 41EC0084        	  3858:     lea     ($0084,A4),A0
02:0003B15E 10302000        	  3859:     move.b  (A0,D2.W),D0
02:0003B162 0C000080        	  3860:     cmpi.b  #$80,D0
02:0003B166 6628            	  3861:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3862:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3863:     ;
02:0003B168 4A03            	  3864:     cmpi.b  #$00,D3
02:0003B16A 662C            	  3865:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3866:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3867:     ; has the power bracelet.
                            	  3868:     ;
                            	  3869:     ; Set up the room item with the armos's coordinates.
                            	  3870:     ;
02:0003B16C 19400097        	  3871:     move.b  D0,($0097,A4)
02:0003B170 10342070        	  3872:     move.b  ($70,A4,D2.W),D0
02:0003B174 19400083        	  3873:     move.b  D0,($0083,A4)
                            	  3874:     ; This resets the room item's state, which activates it.
                            	  3875:     ;
02:0003B178 194300BF        	  3876:     move.b  D3,($00BF,A4)
                            	  3877:     ; Set the room item ID.
                            	  3878:     ;
02:0003B17C 7014            	  3879:     moveq   #20,D0
02:0003B17E 194000AB        	  3880:     move.b  D0,($00AB,A4)
                            	  3881:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3882:     ;
                            	  3883:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3884:     ;
                            	  3885:     ; Note that, if the item was already taken, then the room item
                            	  3886:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3887:     ; it will be ignored, because that routine checks whether
                            	  3888:     ; the item was taken.
                            	  3889:     ;
02:0003B182 4EB900030FFA    	  3890:     jsr     GetRoomFlagUWItemState
02:0003B188 660A            	  3891:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B18A 610006FE        	  3892:     jsr     PlaySecretFoundTune
02:0003B18E 6604            	  3893:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3894:     even
                            	  3895: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3896:     ; Bottom of the loop.
                            	  3897:     ;
02:0003B190 5303            	  3898:     subq.b  #1,D3
02:0003B192 6AA2            	  3899:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3900:     even
                            	  3901: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3902:     ; Not found, or found the power bracelet.
                            	  3903:     ; Use a floor tile $26 to replace the armos.
                            	  3904:     ;
02:0003B194 7026            	  3905:     moveq   #38,D0
02:0003B196 1880            	  3906:     move.b  D0,($0000,A4)
                            	  3907:     even
                            	  3908: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B198 1014            	  3909:     move.b  ($0000,A4),D0
                            	  3910:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3911:     ;
02:0003B19A 1B00            	  3912:     move.b  D0,-(A5)  ; PHA
02:0003B19C 0C000070        	  3913:     cmpi.b  #$70,D0
02:0003B1A0 6604            	  3914:     bne  _anon_z04_51
02:0003B1A2 610006E6        	  3915:     jsr     PlaySecretFoundTune
                            	  3916: _anon_z04_51:
                            	  3917:     ; Replace the tile where the armos was.
                            	  3918:     ;
02:0003B1A6 522C00F7        	  3919:     addq.b  #1,($00F7,A4)
02:0003B1AA 101D            	  3920:     move.b  (A5)+,D0  ; PLA
02:0003B1AC 4EB90004B0B0    	  3921:     jsr     ChangeTileObjTiles
                            	  3922:     ; Because the armos object is aligned to the square grid
                            	  3923:     ; (because it was made from a square),
                            	  3924:     ; set its grid offset to 3 to compensate.
                            	  3925:     ;
                            	  3926:     ; Most objects are aligned to the grid vertically when the
                            	  3927:     ; low nibble is $D.
                            	  3928:     ;
02:0003B1B2 7003            	  3929:     moveq   #3,D0
02:0003B1B4 41EC0394        	  3930:     lea     ($0394,A4),A0
02:0003B1B8 11802000        	  3931:     move.b  D0,(A0,D2.W)
                            	  3932:     ; Set a speed (q-speed fraction) randomly:
                            	  3933:     ; $20 if random value < $80
                            	  3934:     ; $60 otherwise
                            	  3935:     ;
02:0003B1BC 7020            	  3936:     moveq   #32,D0
02:0003B1BE 7600            	  3937:     moveq   #0,D3
02:0003B1C0 16342019        	  3938:     move.b  ($19,A4,D2.W),D3
02:0003B1C4 0C030080        	  3939:     cmpi.b  #$80,D3
02:0003B1C8 6502            	  3940:     bcs  _anon_z04_52
02:0003B1CA 7060            	  3941:     moveq   #96,D0
                            	  3942: _anon_z04_52:
02:0003B1CC 41EC03BC        	  3943:     lea     ($03BC,A4),A0
02:0003B1D0 11802000        	  3944:     move.b  D0,(A0,D2.W)
                            	  3945:     even
                            	  3946: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3947:     ; Facing and input directions down.
                            	  3948:     ;
02:0003B1D4 7004            	  3949:     moveq   #4,D0
02:0003B1D6 41EC03F8        	  3950:     lea     ($03F8,A4),A0
02:0003B1DA 11802000        	  3951:     move.b  D0,(A0,D2.W)
02:0003B1DE 41EC0098        	  3952:     lea     ($0098,A4),A0
02:0003B1E2 11802000        	  3953:     move.b  D0,(A0,D2.W)
                            	  3954:     ; Every other frame, return without drawing.
                            	  3955:     ;
02:0003B1E6 10342028        	  3956:     move.b  ($28,A4,D2.W),D0
02:0003B1EA E208            	  3957:     lsr.b  #1,D0   ; LSR A
02:0003B1EC 6512            	  3958:     bcs  _anon_z04_53
                            	  3959:     ; Finish initializing based on type.
                            	  3960:     ;
02:0003B1EE 41EC034F        	  3961:     lea     ($034F,A4),A0
02:0003B1F2 10302000        	  3962:     move.b  (A0,D2.W),D0
02:0003B1F6 0C000022        	  3963:     cmpi.b  #$22,D0
02:0003B1FA 6602            	  3964:     bne.s  __far_z_04_0034
02:0003B1FC 6008            	  3965:     jmp  L_EndInitFlyingGhini
                            	  3966: __far_z_04_0034:
02:0003B1FE 6158            	  3967:     jsr     DrawArmosAndCheckCollisions
                            	  3968: _anon_z04_53:
02:0003B200 0A3C0001        	  3969:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B204 4E75            	  3970:     rts
                            	  3971: 
                            	  3972:     even
                            	  3973: L_EndInitFlyingGhini:
02:0003B206 6100FEAA        	  3974:     jsr     DrawGhiniAndCheckCollisions
                            	  3975:     ; If we're finally leaving the object flagged "initialized",
                            	  3976:     ; then reset metastate and initialize this as a flyer.
