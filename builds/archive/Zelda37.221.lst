02:0003D00A 02000003        	  8112:     andi.b #$03,D0
02:0003D00E 7600            	  8113:     moveq   #0,D3
02:0003D010 1600            	  8114:     move.b  D0,D3
02:0003D012 41F90003CE22    	  8115:     lea     (PolsVoiceDirections).l,A0
02:0003D018 10303000        	  8116:     move.b  (A0,D3.W),D0
