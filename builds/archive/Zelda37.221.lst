                            	  6069: CalcBoomerangFrame:
                            	  6070:     ; The minor state (low 3 bits of state) is used to
                            	  6071:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  6072:     ;
                            	  6073:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  6074:     ; In other words, don't offset the coordinate below.
                            	  6075:     ;
02:0004CAE2 7000            	  6076:     moveq   #0,D0
02:0004CAE4 1880            	  6077:     move.b  D0,($0000,A4)
02:0004CAE6 41EC00AC        	  6078:     lea     ($00AC,A4),A0
02:0004CAEA 10302000        	  6079:     move.b  (A0,D2.W),D0
02:0004CAEE 0200000F        	  6080:     andi.b #$0F,D0
02:0004CAF2 7600            	  6081:     moveq   #0,D3
02:0004CAF4 1600            	  6082:     move.b  D0,D3
02:0004CAF6 7000            	  6083:     moveq   #0,D0
02:0004CAF8 19400001        	  6084:     move.b  D0,($0001,A4)
02:0004CAFC 41F90004C6EA    	  6085:     lea     (BoomerangFrameCycle).l,A0
02:0004CB02 10303000        	  6086:     move.b  (A0,D3.W),D0
02:0004CB06 1940000C        	  6087:     move.b  D0,($000C,A4)
                            	  6088:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  6089:     ;
02:0004CB0A 1003            	  6090:     move.b  D3,D0
02:0004CB0C 41F90004C6F4    	  6091:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004CB12 10303000        	  6092:     move.b  (A0,D3.W),D0
02:0004CB16 19400004        	  6093:     move.b  D0,($0004,A4)
                            	  6094:     ; TODO: ?
                            	  6095:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  6096:     ; Else add the item value of the magic boomerang.
                            	  6097:     ;
                            	  6098:     ; But none of the values in the base sprite attributes array is 8.
                            	  6099:     ;
                            	  6100:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  6101:     ; the inventory will always be added to the base sprite attribute.
                            	  6102:     ;
                            	  6103:     ; So, palette row 4 or 5 will be chosen.
                            	  6104:     ;
02:0004CB1A 7600            	  6105:     moveq   #0,D3
02:0004CB1C 0C000008        	  6106:     cmpi.b  #$08,D0
02:0004CB20 6706            	  6107:     beq  _anon_z07_31
02:0004CB22 7600            	  6108:     moveq   #0,D3
02:0004CB24 162C0675        	  6109:     move.b  ($0675,A4),D3
