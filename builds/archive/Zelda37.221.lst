                            	 12491: __far_z_04_0125:
                            	 12492:     ; State = 0.
                            	 12493:     ;
                            	 12494:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12495:     ; This is the only patra child shown in the first fame.
                            	 12496:     ;
02:0003F0B0 0C020002        	 12497:     cmpi.b  #$02,D2
02:0003F0B4 6732            	 12498:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12499:     ; The patra child in slot 2 is the last one to be updated.
                            	 12500:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12501:     ;
                            	 12502:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12503:     ; shown.
                            	 12504:     ;
02:0003F0B6 102C00AE        	 12505:     move.b  ($00AE,A4),D0
02:0003F0BA 6700008E        	 12506:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12507:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12508:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12509:     ;
02:0003F0BE 1002            	 12510:     move.b  D2,D0
                            	 12511:     ; Subtract 3 from the object slot to get the angle where the
                            	 12512:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12513:     ;
