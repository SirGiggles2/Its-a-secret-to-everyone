02:00041B70 4EB900030AFE    	  3187:     jsr     GetOppositeDir
                            	  3188: _anon_z05_75:
                            	  3189:     ; If in UW, use the second set of bounds by adding 4
                            	  3190:     ; to reverse direction index.
                            	  3191:     ;
                            	  3192:     ; Else in OW, and use first set that begins at offset 0.
                            	  3193:     ;
02:00041B76 102C0010        	  3194:     move.b  ($0010,A4),D0
02:00041B7A 6710            	  3195:     beq  _anon_z05_76
02:00041B7C 1003            	  3196:     move.b  D3,D0
02:00041B7E 023C00EE        	  3197:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041B82 123C0004        	  3198:     move.b  #$04,D1
02:00041B86 D101            	  3199:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041B88 7600            	  3200:     moveq   #0,D3
02:00041B8A 1600            	  3201:     move.b  D0,D3
                            	  3202: _anon_z05_76:
                            	  3203:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3204:     ;
02:00041B8C 7000            	  3205:     moveq   #0,D0
                            	  3206: ; Params:
                            	  3207: ; A: mask of buttons to block
                            	  3208: ; Y: offset into BorderBounds
                            	  3209: ; [00]: direction
                            	  3210: ; [02]: coordinate
                            	  3211: ;
                            	  3212: ; Returns:
                            	  3213: ; [01]: button mask that was used
                            	  3214: ;       (set to $FF if boundary not crossed)
                            	  3215: ;
                            	  3216:     even
                            	  3217: MaskInputInBorder:
02:00041B8E 19400001        	  3218:     move.b  D0,($0001,A4)
                            	  3219:     ; If direction is positive (right or down), then go handle it separately.
                            	  3220:     ;
02:00041B92 1014            	  3221:     move.b  ($0000,A4),D0
02:00041B94 0200000A        	  3222:     andi.b #$0A,D0
02:00041B98 6748            	  3223:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3224:     ; The direction is negative (left or up).
                            	  3225:     ;
                            	  3226:     ; If the coordinate does not cross (<) the boundary, then
                            	  3227:     ; go set mask $FF, so that no button is excluded.
                            	  3228:     ;
02:00041B9A 102C0002        	  3229:     move.b  ($0002,A4),D0
02:00041B9E 41F900041B12    	  3230:     lea     (BorderBounds).l,A0
02:00041BA4 12303000        	  3231:     move.b  (A0,D3.W),D1
02:00041BA8 B001            	  3232:     cmp.b   D1,D0
02:00041BAA 6548            	  3233:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3234:     even
