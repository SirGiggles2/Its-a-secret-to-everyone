02:0004CBC4 F7              	  6196:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:0004CBC5 F2
02:0004CBC6 F5
02:0004CBC7 F5
02:0004CBC8 F6
02:0004CBC9 0D
02:0004CBCA 03
02:0004CBCB 03
02:0004CBCC F7              	  6197:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:0004CBCD 09
02:0004CBCE 03
02:0004CBCF 03
02:0004CBD0 FF
02:0004CBD1 05
02:0004CBD2 03
02:0004CBD3 03
