                            	   421: UpdateMenuActive:
02:00040290 610053B6        	   422:     jsr     DrawSubmenuItems
02:00040294 6100547A        	   423:     jsr     UpdateSubmenuSelection
                            	   424:     ; If buttons Up and A are down on the second controller, then
                            	   425:     ; 1. reset submenu state
                            	   426:     ; 2. go to mode 8
                            	   427:     ; 3. silence sound
                            	   428:     ;
02:00040298 102C00FB        	   429:     move.b  ($00FB,A4),D0
02:0004029C 02000088        	   430:     andi.b #$88,D0
02:000402A0 0C000088        	   431:     cmpi.b  #$88,D0
02:000402A4 661A            	   432:     bne  _anon_z05_3
02:000402A6 4EB90004B61E    	   433:     jsr     EndGameMode
02:000402AC 194000E1        	   434:     move.b  D0,($00E1,A4)
02:000402B0 7008            	   435:     moveq   #8,D0
02:000402B2 19400012        	   436:     move.b  D0,($0012,A4)
02:000402B6 7000            	   437:     moveq   #0,D0
02:000402B8 19400619        	   438:     move.b  D0,($0619,A4)
02:000402BC 600013A0        	   439:     jmp     SilenceSound
