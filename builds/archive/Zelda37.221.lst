02:0003EF7A 41EC0084        	 12326:     lea     ($0084,A4),A0
02:0003EF7E 10302000        	 12327:     move.b  (A0,D2.W),D0
02:0003EF82 122C04E6        	 12328:     move.b  ($04E6,A4),D1
02:0003EF86 D101            	 12329:     addx.b  D1,D0   ; ADC Lamnola_Speed
