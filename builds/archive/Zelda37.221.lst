                            	  6512: LayoutUWFloor:
02:00043D06 7005            	  6513:     moveq   #5,D0
02:00043D08 4EB90002A9FA    	  6514:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00043D0E 6100739A        	  6515:     jsr     GetUniqueRoomId
02:00043D12 1B00            	  6516:     move.b  D0,-(A5)  ; PHA
02:00043D14 7000            	  6517:     moveq   #0,D0
02:00043D16 19400002        	  6518:     move.b  D0,($0002,A4)
02:00043D1A 7000            	  6519:     moveq   #0,D0
02:00043D1C 19400003        	  6520:     move.b  D0,($0003,A4)
02:00043D20 101D            	  6521:     move.b  (A5)+,D0  ; PLA
02:00043D22 E308            	  6522:     lsl.b  #1,D0   ; ASL A
02:00043D24 E308            	  6523:     lsl.b  #1,D0   ; ASL A
02:00043D26 1880            	  6524:     move.b  D0,($0000,A4)
