                            	  6778:     even
                            	  6779: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6780:     ; Link and the shot are facing opposite directions.
                            	  6781:     ; Link can parry certain weapons/shots.
                            	  6782:     ;
                            	  6783:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6784:     ; no harmful collision; but it still counts as a shot collision.
                            	  6785:     ; So, go treat this as a parry.
                            	  6786:     ;
02:00031C66 41EC034F        	  6787:     lea     ($034F,A4),A0
02:00031C6A 10302000        	  6788:     move.b  (A0,D2.W),D0
02:00031C6E 0C000055        	  6789:     cmpi.b  #$55,D0
02:00031C72 650E            	  6790:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031C74 0C00005B        	  6791:     cmpi.b  #$5B,D0
02:00031C78 6408            	  6792:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6793:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6794:     ; So, go harm Link.
                            	  6795:     ;
02:00031C7A 102C0676        	  6796:     move.b  ($0676,A4),D0
02:00031C7E 6602            	  6797:     bne.s  __far_z_01_0070
02:00031C80 600E            	  6798:     jmp  HarmLink
                            	  6799: __far_z_01_0070:
                            	  6800:     even
                            	  6801: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  6802:     ; Else Link parries.
                            	  6803:     ;
                            	  6804:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6805:     ;
02:00031C82 7001            	  6806:     moveq   #1,D0
02:00031C84 19400604        	  6807:     move.b  D0,($0604,A4)
02:00031C88 7000            	  6808:     moveq   #0,D0
02:00031C8A 19400006        	  6809:     move.b  D0,($0006,A4)
