                            	  6216: _anon_z05_120:
                            	  6217:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  6218:     ;
                            	  6219:     ; Shutters and the commands to open a door always change
                            	  6220:     ; tiles.
                            	  6221:     ;
02:00043AF8 61000130        	  6222:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  6223:     even
                            	  6224: _L_z05_UpdateDoors_LoopTransferRec:
                            	  6225:     ; Copy [06] to [04] for the call to write tiles below.
                            	  6226:     ; We need to remember how many tiles need to be copied
                            	  6227:     ; in each transfer record.
                            	  6228:     ;
02:00043AFC 102C0006        	  6229:     move.b  ($0006,A4),D0
02:00043B00 19400004        	  6230:     move.b  D0,($0004,A4)
                            	  6231:     ; Write the transfer record header for the door.
                            	  6232:     ;
                            	  6233:     ;
                            	  6234:     ; VRAM address high byte of door
02:00043B04 1014            	  6235:     move.b  ($0000,A4),D0
02:00043B06 41EC0302        	  6236:     lea     ($0302,A4),A0
02:00043B0A 11802000        	  6237:     move.b  D0,(A0,D2.W)
02:00043B0E 5202            	  6238:     addq.b  #1,D2
02:00043B10 102C0001        	  6239:     move.b  ($0001,A4),D0
02:00043B14 41EC0302        	  6240:     lea     ($0302,A4),A0
02:00043B18 11802000        	  6241:     move.b  D0,(A0,D2.W)
02:00043B1C 5202            	  6242:     addq.b  #1,D2
02:00043B1E 102C0006        	  6243:     move.b  ($0006,A4),D0
02:00043B22 41EC0302        	  6244:     lea     ($0302,A4),A0
02:00043B26 11802000        	  6245:     move.b  D0,(A0,D2.W)
02:00043B2A 5202            	  6246:     addq.b  #1,D2
                            	  6247: _anon_z05_121:
                            	  6248:     ; Write two tiles in a short loop indexed by [04].
                            	  6249:     ;
02:00043B2C 6100ED1C        	  6250:     jsr     WriteDoorFaceTileHorizontally
02:00043B30 66FA            	  6251:     bne  _anon_z05_121
                            	  6252:     ; OR the low VRAM address with $20 to go down one row
                            	  6253:     ; in order to work on the second row of door tiles.
                            	  6254:     ;
02:00043B32 7020            	  6255:     moveq   #32,D0
02:00043B34 122C0001        	  6256:     move.b  ($0001,A4),D1
02:00043B38 8001            	  6257:     or.b  D1,D0
02:00043B3A 19400001        	  6258:     move.b  D0,($0001,A4)
                            	  6259:     ; Bottom of the loop.
                            	  6260:     ; Loop again to write the second transfer record for the
                            	  6261:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6262:     ;
02:00043B3E 532C0005        	  6263:     subq.b  #1,($0005,A4)
02:00043B42 66B8            	  6264:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6265:     ; Write the end marker, and update buffer length.
                            	  6266:     ;
02:00043B44 103C00FF        	  6267:     move.b  #$FF,D0
02:00043B48 41EC0302        	  6268:     lea     ($0302,A4),A0
02:00043B4C 11802000        	  6269:     move.b  D0,(A0,D2.W)
02:00043B50 1002            	  6270:     move.b  D2,D0
02:00043B52 19400301        	  6271:     move.b  D0,($0301,A4)
                            	  6272:     ; Increment the command.
                            	  6273:     ;
02:00043B56 522C0054        	  6274:     addq.b  #1,($0054,A4)
                            	  6275:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6276:     ; and resetting the door command.
                            	  6277:     ; This ends up catching original states 3 and 7.
                            	  6278:     ;
                            	  6279:     ; Else set door timer to 8 and return.
                            	  6280:     ;
02:00043B5A 102C0054        	  6281:     move.b  ($0054,A4),D0
02:00043B5E 02000003        	  6282:     andi.b #$03,D0
02:00043B62 6708            	  6283:     beq  _anon_z05_122
02:00043B64 7008            	  6284:     moveq   #8,D0
02:00043B66 19400027        	  6285:     move.b  D0,($0027,A4)
02:00043B6A 4E75            	  6286:     rts
                            	  6287: 
                            	  6288: _anon_z05_122:
                            	  6289:     ; If the door command = 4 after incrementing it, then
                            	  6290:     ; it was 3 (close door). So:
                            	  6291:     ; 1. reset this door's flag
                            	  6292:     ; 2. remove it from the opened door mask
                            	  6293:     ; 3. reset the door command
                            	  6294:     ; 4. go lay out doors in the play area map
                            	  6295:     ;
02:00043B6C 102C0054        	  6296:     move.b  ($0054,A4),D0
02:00043B70 0C000004        	  6297:     cmpi.b  #$04,D0
02:00043B74 6626            	  6298:     bne  _anon_z05_123
02:00043B76 7400            	  6299:     moveq   #0,D2
02:00043B78 142C0009        	  6300:     move.b  ($0009,A4),D2
02:00043B7C 6100DAEE        	  6301:     jsr     ResetDoorFlag
02:00043B80 102C0055        	  6302:     move.b  ($0055,A4),D0
02:00043B84 0A00000F        	  6303:     eori.b #$0F,D0
02:00043B88 122C00EE        	  6304:     move.b  ($00EE,A4),D1
02:00043B8C C001            	  6305:     and.b  D1,D0
                            	  6306:     even
                            	  6307: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043B8E 194000EE        	  6308:     move.b  D0,($00EE,A4)
                            	  6309:     even
                            	  6310: L_ResetDoorCmdAndLayOutDoors:
02:00043B92 7000            	  6311:     moveq   #0,D0
02:00043B94 19400054        	  6312:     move.b  D0,($0054,A4)
02:00043B98 6000FCD4        	  6313:     jmp     LayOutDoors
                            	  6314: 
                            	  6315: _anon_z05_123:
                            	  6316:     ; Door command <> 4.
                            	  6317:     ; It must be 8, which means it was 7: open door.
                            	  6318:     ;
                            	  6319:     ; If the door is a shutter (7), then go add the door to the
                            	  6320:     ; opened door mask, reset door command, and lay out doors.
                            	  6321:     ;
02:00043B9C 102C0055        	  6322:     move.b  ($0055,A4),D0
02:00043BA0 19400002        	  6323:     move.b  D0,($0002,A4)
02:00043BA4 6100FA32        	  6324:     jsr     FindDoorAttrByDoorBit
02:00043BA8 0C000007        	  6325:     cmpi.b  #$07,D0
02:00043BAC 676E            	  6326:     beq  _anon_z05_124
                            	  6327:     ; Else the door is not a shutter.
                            	  6328:     ;
                            	  6329:     ;
                            	  6330:     ; [09] door direction index
02:00043BAE 7400            	  6331:     moveq   #0,D2
02:00043BB0 142C0009        	  6332:     move.b  ($0009,A4),D2
02:00043BB4 6100DAB0        	  6333:     jsr     SetDoorFlag
                            	  6334:     ; Get the next room's ID.
                            	  6335:     ;
02:00043BB8 1003            	  6336:     move.b  D3,D0
02:00043BBA 023C00EE        	  6337:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043BBE 41F900043A7A    	  6338:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043BC4 12302000        	  6339:     move.b  (A0,D2.W),D1
02:00043BC8 D101            	  6340:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043BCA 7600            	  6341:     moveq   #0,D3
02:00043BCC 1600            	  6342:     move.b  D0,D3
                            	  6343:     ; Flip the door direction index.
                            	  6344:     ;
02:00043BCE 1002            	  6345:     move.b  D2,D0
02:00043BD0 0A000001        	  6346:     eori.b #$01,D0
02:00043BD4 7400            	  6347:     moveq   #0,D2
02:00043BD6 1400            	  6348:     move.b  D0,D2
                            	  6349:     ; Set the door flag for the opposite door in the next room.
                            	  6350:     ;
02:00043BD8 1214            	  6351:     move.b  ($00,A4),D1   ; ptr lo
02:00043BDA 182C0001        	  6352:     move.b  ($01,A4),D4  ; ptr hi
02:00043BDE 024100FF        	  6353:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043BE2 E14C            	  6354:     lsl.w   #8,D4
02:00043BE4 8841            	  6355:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043BE6 48C4            	  6356:     ext.l   D4
02:00043BE8 D8BC00FF0000    	  6357:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043BEE 2044            	  6358:     movea.l D4,A0
02:00043BF0 10303000        	  6359:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043BF4 41F90004ADE0    	  6360:     lea     (LevelMasks).l,A0
02:00043BFA 12302000        	  6361:     move.b  (A0,D2.W),D1
02:00043BFE 8001            	  6362:     or.b  D1,D0
02:00043C00 1214            	  6363:     move.b  ($00,A4),D1   ; ptr lo
02:00043C02 182C0001        	  6364:     move.b  ($01,A4),D4  ; ptr hi
02:00043C06 024100FF        	  6365:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043C0A E14C            	  6366:     lsl.w   #8,D4
02:00043C0C 8841            	  6367:     or.w    D1,D4
02:00043C0E 48C4            	  6368:     ext.l   D4
02:00043C10 D8BC00FF0000    	  6369:     add.l   #NES_RAM,D4
02:00043C16 2044            	  6370:     movea.l D4,A0
02:00043C18 11803000        	  6371:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6372: _anon_z05_124:
                            	  6373:     ; Add the door to the opened door mask, reset door command,
                            	  6374:     ; and lay out doors.
                            	  6375:     ;
02:00043C1C 102C0055        	  6376:     move.b  ($0055,A4),D0
02:00043C20 122C00EE        	  6377:     move.b  ($00EE,A4),D1
02:00043C24 8001            	  6378:     or.b  D1,D0
02:00043C26 6000FF66        	  6379:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6380: 
                            	  6381: ; Params:
                            	  6382: ; [08]: 0 if closed
                            	  6383: ;
                            	  6384: ; Returns:
                            	  6385: ; X: current length of dynamic transfer buf
                            	  6386: ; [00]: door VRAM address high byte
                            	  6387: ; [01]: door VRAM address low byte
                            	  6388: ; [02:03]: address of door tiles for direction and face
                            	  6389: ; [05]: 2, the number of transfer records to write
                            	  6390: ; [06]: 2, the number of tiles in each record
                            	  6391: ; [07]: 0, the first index of a tile to transfer
                            	  6392: ; [09]: door direction index
                            	  6393: ;
                            	  6394: ; Note that this routine is called with triggered doors:
                            	  6395: ; doors that can change state. Their door type numbers are >= 4.
                            	  6396: ;
                            	  6397: ; If this routine were ever called with a fixed door
                            	  6398: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6399: ; values for the door face.
                            	  6400: ;
                            	  6401: ;
                            	  6402: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6403: ;
                            	  6404:     even
                            	  6405: PrepareWriteHorizontalDoorTransferRecords:
02:00043C2A 102C0055        	  6406:     move.b  ($0055,A4),D0
02:00043C2E 19400002        	  6407:     move.b  D0,($0002,A4)
02:00043C32 6100F9A4        	  6408:     jsr     FindDoorAttrByDoorBit
02:00043C36 0C000005        	  6409:     cmpi.b  #$05,D0
02:00043C3A 650C            	  6410:     bcs  _anon_z05_125
02:00043C3C 1B00            	  6411:     move.b  D0,-(A5)  ; PHA
02:00043C3E 7004            	  6412:     moveq   #4,D0
02:00043C40 4EB900030646    	  6413:     jsr     PlaySample
02:00043C46 101D            	  6414:     move.b  (A5)+,D0  ; PLA
                            	  6415: _anon_z05_125:
                            	  6416:     ; Calculate the door face index in three parts.
                            	  6417:     ;
                            	  6418:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6419:     ; (provisional face index in Y register).
                            	  6420:     ;
02:00043C48 0C000004        	  6421:     cmpi.b  #$04,D0
02:00043C4C 6602            	  6422:     bne  _anon_z05_126
02:00043C4E 7008            	  6423:     moveq   #8,D0
                            	  6424: _anon_z05_126:
02:00043C50 0C000001        	  6425:     cmpi.b  #$01,D0
02:00043C54 6602            	  6426:     bne  _anon_z05_127
02:00043C56 7004            	  6427:     moveq   #4,D0
                            	  6428: _anon_z05_127:
                            	  6429:     ; Second, subtract 3 from provisional face index.
                            	  6430:     ;
02:00043C58 003C0011        	  6431:     ori     #$11,CCR  ; SEC: set C+X
02:00043C5C 123C0003        	  6432:     move.b  #$03,D1
02:00043C60 0A3C0010        	  6433:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C64 9101            	  6434:     subx.b  D1,D0   ; SBC #$03
02:00043C66 0A3C0010        	  6435:     eori    #$10,CCR  ; restore X = 6502 C
02:00043C6A 7600            	  6436:     moveq   #0,D3
02:00043C6C 1600            	  6437:     move.b  D0,D3
                            	  6438:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6439:     ; face index >= 3, then subtract 1 from it.
                            	  6440:     ;
                            	  6441:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6442:     ; then make it 1.
                            	  6443:     ;
02:00043C6E 102C0008        	  6444:     move.b  ($0008,A4),D0
02:00043C72 6708            	  6445:     beq  _anon_z05_128
02:00043C74 0C030005        	  6446:     cmpi.b  #$05,D3
02:00043C78 670A            	  6447:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043C7A 7601            	  6448:     moveq   #1,D3
                            	  6449: _anon_z05_128:
02:00043C7C 0C030003        	  6450:     cmpi.b  #$03,D3
02:00043C80 6502            	  6451:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043C82 5303            	  6452:     subq.b  #1,D3
                            	  6453:     even
                            	  6454: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6455:     ; The routine that returned the door type also returned its
                            	  6456:     ; reverse direction index in [03].
                            	  6457:     ;
                            	  6458:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6459:     ;
02:00043C84 7003            	  6460:     moveq   #3,D0
02:00043C86 003C0011        	  6461:     ori     #$11,CCR  ; SEC: set C+X
02:00043C8A 122C0003        	  6462:     move.b  ($0003,A4),D1
02:00043C8E 0A3C0010        	  6463:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043C92 9101            	  6464:     subx.b  D1,D0   ; SBC $03
02:00043C94 0A3C0010        	  6465:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6466:     ; Call this to put the address of door face tiles in [02:03].
                            	  6467:     ;
02:00043C98 6100FD7A        	  6468:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6469:     ; Return the address of the door in the nametable in [01:00].
                            	  6470:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6471:     ;
02:00043C9C 41F900043A72    	  6472:     lea     (DoorVramAddrsHi).l,A0
02:00043CA2 10302000        	  6473:     move.b  (A0,D2.W),D0
02:00043CA6 1880            	  6474:     move.b  D0,($0000,A4)
02:00043CA8 41F900043A76    	  6475:     lea     (DoorVramAddrsLo).l,A0
02:00043CAE 10302000        	  6476:     move.b  (A0,D2.W),D0
02:00043CB2 19400001        	  6477:     move.b  D0,($0001,A4)
                            	  6478:     ; Return the direction of the door in [09], and the dynamic
                            	  6479:     ; transfer buf length in X register.
                            	  6480:     ;
02:00043CB6 19420009        	  6481:     move.b  D2,($0009,A4)
02:00043CBA 7400            	  6482:     moveq   #0,D2
02:00043CBC 142C0301        	  6483:     move.b  ($0301,A4),D2
                            	  6484:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6485:     ;
02:00043CC0 7000            	  6486:     moveq   #0,D0
02:00043CC2 19400007        	  6487:     move.b  D0,($0007,A4)
02:00043CC6 7002            	  6488:     moveq   #2,D0
02:00043CC8 19400006        	  6489:     move.b  D0,($0006,A4)
02:00043CCC 19400005        	  6490:     move.b  D0,($0005,A4)
02:00043CD0 0A3C0001        	  6491:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043CD4 4E75            	  6492:     rts
                            	  6493: 
                            	  6494:     even
