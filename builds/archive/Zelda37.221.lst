                            	  2302: __far_z_04_0019:
02:0003A68C 61000592        	  2303:     jsr     UpdateBurrower
                            	  2304:     ; If zora died in the call above, then it happened while in
                            	  2305:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2306:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2307:     ; not come back after killing it.
                            	  2308:     ;
                            	  2309:     ; If state <> 3 or timer <> $FD,
                            	  2310:     ; then go see if the object needs to be destroyed.
                            	  2311:     ;
02:0003A690 41EC00AC        	  2312:     lea     ($00AC,A4),A0
02:0003A694 10302000        	  2313:     move.b  (A0,D2.W),D0
02:0003A698 0C000003        	  2314:     cmpi.b  #$03,D0
02:0003A69C 6616            	  2315:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003A69E 10342028        	  2316:     move.b  ($28,A4,D2.W),D0
02:0003A6A2 0C0000FD        	  2317:     cmpi.b  #$FD,D0
02:0003A6A6 660C            	  2318:     bne  _L_z04_UpdateZora_DestroyWhenDone
                            	  2319:     ; Shoot a fireball; and set the timer so that it expires faster.
                            	  2320:     ;
02:0003A6A8 7055            	  2321:     moveq   #85,D0
02:0003A6AA 6100F670        	  2322:     jsr     ShootFireball
02:0003A6AE 7020            	  2323:     moveq   #32,D0
02:0003A6B0 19802028        	  2324:     move.b  D0,($28,A4,D2.W)
                            	  2325:     even
