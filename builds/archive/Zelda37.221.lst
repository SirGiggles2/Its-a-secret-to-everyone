                            	  3221: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3222:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3223:     ; then this trap definitely wasn't triggered.
                            	  3224:     ; Go draw and check collisions.
                            	  3225:     ;
02:000302BE 102C0070        	  3226:     move.b  ($0070,A4),D0
02:000302C2 003C0011        	  3227:     ori     #$11,CCR  ; SEC: set C+X
02:000302C6 12342070        	  3228:     move.b  ($70,A4,D2.W),D1
02:000302CA 0A3C0010        	  3229:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000302CE 9101            	  3230:     subx.b  D1,D0   ; SBC ObjX,X
02:000302D0 0A3C0010        	  3231:     eori    #$10,CCR  ; restore X = 6502 C
02:000302D4 6100082C        	  3232:     jsr     Abs
02:000302D8 0C00000E        	  3233:     cmpi.b  #$0E,D0
02:000302DC 64DC            	  3234:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3235:     ; Determine the vertical direction toward Link;
                            	  3236:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3237:     ; along this axis. Go draw and check object collisions.
                            	  3238:     ;
02:000302DE 7604            	  3239:     moveq   #4,D3
02:000302E0 102C0084        	  3240:     move.b  ($0084,A4),D0
02:000302E4 41EC0084        	  3241:     lea     ($0084,A4),A0
02:000302E8 12302000        	  3242:     move.b  (A0,D2.W),D1
02:000302EC B001            	  3243:     cmp.b   D1,D0
02:000302EE 67CA            	  3244:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000302F0 6402            	  3245:     bcc  _anon_z01_27
02:000302F2 7608            	  3246:     moveq   #8,D3
                            	  3247: _anon_z01_27:
                            	  3248:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3249:     ; set the vertical direction we determined, and other preparations.
                            	  3250:     ;
02:000302F4 41EC0084        	  3251:     lea     ($0084,A4),A0
