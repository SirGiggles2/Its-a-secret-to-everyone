02:0003024A 660000B2        	  3162:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  3163:     ; State 0. Sensing.
                            	  3164:     ;
                            	  3165:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  3166:     ; then go see if the horizontal distance is shorter.
                            	  3167:     ;
02:0003024E 102C0084        	  3168:     move.b  ($0084,A4),D0
02:00030252 003C0011        	  3169:     ori     #$11,CCR  ; SEC: set C+X
02:00030256 41EC0084        	  3170:     lea     ($0084,A4),A0
02:0003025A 12302000        	  3171:     move.b  (A0,D2.W),D1
02:0003025E 0A3C0010        	  3172:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030262 9101            	  3173:     subx.b  D1,D0   ; SBC ObjY,X
02:00030264 0A3C0010        	  3174:     eori    #$10,CCR  ; restore X = 6502 C
02:00030268 61000898        	  3175:     jsr     Abs
02:0003026C 0C00000E        	  3176:     cmpi.b  #$0E,D0
02:00030270 644C            	  3177:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  3178:     ; Determine the horizontal direction toward Link;
                            	  3179:     ; and if Link and the trap are at the same X, then we can't move
                            	  3180:     ; along this axis. Go see about moving vertically.
