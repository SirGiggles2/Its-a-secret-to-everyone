                            	 12774: __far_z_04_0128:
                            	 12775:     ; Once the timer expires:
                            	 12776:     ; 1. unhalt Link
                            	 12777:     ; 2. clear the item to lift
                            	 12778:     ; 3. play level 9 song
                            	 12779:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12780:     ;
02:0003F2A0 194000AC        	 12781:     move.b  D0,($00AC,A4)
02:0003F2A4 19400505        	 12782:     move.b  D0,($0505,A4)
02:0003F2A8 7020            	 12783:     moveq   #32,D0
02:0003F2AA 19400600        	 12784:     move.b  D0,($0600,A4)
02:0003F2AE 522C0445        	 12785:     addq.b  #1,($0445,A4)
                            	 12786:     even
