                            	 14316:     ; Y := 4 (down)
                            	 14317:     ; if observed player Y <> object Y then
                            	 14318:     ;   if observed player Y < object Y then
                            	 14319:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 14320:     ;   [00] := [00] | Y
                            	 14321:     ;
