02:0003C036 0C020006        	  5884:     cmpi.b  #$06,D2
02:0003C03A 6502            	  5885:     bcs  _anon_z04_80
02:0003C03C 7604            	  5886:     moveq   #4,D3
                            	  5887: _anon_z04_80:
