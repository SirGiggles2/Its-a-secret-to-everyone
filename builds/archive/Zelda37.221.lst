02:00030278 12342070        	  3184:     move.b  ($70,A4,D2.W),D1
02:0003027C B001            	  3185:     cmp.b   D1,D0
02:0003027E 673E            	  3186:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030280 6402            	  3187:     bcc  _anon_z01_26
02:00030282 7602            	  3188:     moveq   #2,D3
                            	  3189: _anon_z01_26:
                            	  3190:     ; Remember the original X coordinate.
                            	  3191:     ;
02:00030284 10342070        	  3192:     move.b  ($70,A4,D2.W),D0
                            	  3193:     even
                            	  3194: _L_z01_UpdateTrap_Full_GoToState1:
