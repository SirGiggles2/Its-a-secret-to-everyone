02:0003E08C 0A3C0010        	 10319:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E090 9101            	 10320:     subx.b  D1,D0   ; SBC #$10
02:0003E092 0A3C0010        	 10321:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E096 19802070        	 10322:     move.b  D0,($70,A4,D2.W)
