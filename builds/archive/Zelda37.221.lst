02:000307DA 9101            	  4011:     subx.b  D1,D0   ; SBC $00
02:000307DC 0A3C0010        	  4012:     eori    #$10,CCR  ; restore X = 6502 C
02:000307E0 1880            	  4013:     move.b  D0,($0000,A4)
02:000307E2 101D            	  4014:     move.b  (A5)+,D0  ; PLA
02:000307E4 E208            	  4015:     lsr.b  #1,D0   ; LSR A
02:000307E6 E208            	  4016:     lsr.b  #1,D0   ; LSR A
02:000307E8 E208            	  4017:     lsr.b  #1,D0   ; LSR A
