                            	  1603:     ; Check collisions.
                            	  1604:     ;
                            	  1605:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1606:     ; then return.
                            	  1607:     ;
02:0003A1E8 610001F8        	  1608:     jsr     Gel_CheckCollisions
02:0003A1EC 41EC0405        	  1609:     lea     ($0405,A4),A0
02:0003A1F0 10302000        	  1610:     move.b  (A0,D2.W),D0
02:0003A1F4 664E            	  1611:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A1F6 41EC04F0        	  1612:     lea     ($04F0,A4),A0
02:0003A1FA 10302000        	  1613:     move.b  (A0,D2.W),D0
02:0003A1FE 6744            	  1614:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1615:     ; If vertically aligned with the square grid, then
                            	  1616:     ; use a horizontal direction mask (3).
                            	  1617:     ;
                            	  1618:     ; Keep in mind that most objects are aligned vertically when
                            	  1619:     ; the low nibble of their Y is $D.
                            	  1620:     ;
02:0003A200 7600            	  1621:     moveq   #0,D3
02:0003A202 41EC0084        	  1622:     lea     ($0084,A4),A0
02:0003A206 10302000        	  1623:     move.b  (A0,D2.W),D0
02:0003A20A 0200000F        	  1624:     andi.b #$0F,D0
02:0003A20E 0C00000D        	  1625:     cmpi.b  #$0D,D0
02:0003A212 6602            	  1626:     bne  _anon_z04_26
02:0003A214 7603            	  1627:     moveq   #3,D3
                            	  1628: _anon_z04_26:
02:0003A216 1883            	  1629:     move.b  D3,($0000,A4)
                            	  1630:     ; If horizontally aligned with the square grid, then
                            	  1631:     ; use a vertical direction mask ($C).
                            	  1632:     ;
02:0003A218 7600            	  1633:     moveq   #0,D3
02:0003A21A 10342070        	  1634:     move.b  ($70,A4,D2.W),D0
02:0003A21E 0200000F        	  1635:     andi.b #$0F,D0
02:0003A222 6602            	  1636:     bne  _anon_z04_27
02:0003A224 760C            	  1637:     moveq   #12,D3
                            	  1638: _anon_z04_27:
02:0003A226 1003            	  1639:     move.b  D3,D0
                            	  1640:     ; Combine the two masks. At most one will be 0.
                            	  1641:     ;
02:0003A228 1214            	  1642:     move.b  ($0000,A4),D1
02:0003A22A 8001            	  1643:     or.b  D1,D0
                            	  1644:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1645:     ; with the grid.
                            	  1646:     ;
                            	  1647:     ; If so, then go to state 1 to do a "big shove".
                            	  1648:     ; Else go to state 2, to immediately split in two.
                            	  1649:     ;
                            	  1650:     ; Examples:
                            	  1651:     ; It would be aligned, if moving left along a tile as usual.
                            	  1652:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1653:     ; - The collision check routines would have made the zol
                            	  1654:     ;   face in the direction of the weapon.
                            	  1655:     ; - See CheckMonsterWeaponCollision.
                            	  1656:     ;
02:0003A22C 122C0098        	  1657:     move.b  ($0098,A4),D1
02:0003A230 C001            	  1658:     and.b  D1,D0
02:0003A232 6608            	  1659:     bne  _anon_z04_28
02:0003A234 41EC00AC        	  1660:     lea     ($00AC,A4),A0
02:0003A238 52302000        	  1661:     addq.b  #1,(A0,D2.W)
                            	  1662: _anon_z04_28:
02:0003A23C 41EC00AC        	  1663:     lea     ($00AC,A4),A0
02:0003A240 52302000        	  1664:     addq.b  #1,(A0,D2.W)
