02:00039C32 6502            	   842:     bcs.s  __far_z_04_0007
02:00039C34 605C            	   843:     jmp  ResetPushTimer
                            	   844: __far_z_04_0007:
                            	   845:     ; At this point, Link is aligned with the block.
