                            	  7992: __far_z_04_0074:
                            	  7993:     ; Go to state 1.
                            	  7994:     ;
02:0003CEF2 41EC00AC        	  7995:     lea     ($00AC,A4),A0
02:0003CEF6 52302000        	  7996:     addq.b  #1,(A0,D2.W)
                            	  7997:     ; Subtract 1 from facing direction to make an index.
                            	  7998:     ;
02:0003CEFA 7600            	  7999:     moveq   #0,D3
02:0003CEFC 41EC0098        	  8000:     lea     ($0098,A4),A0
02:0003CF00 16302000        	  8001:     move.b  (A0,D2.W),D3
02:0003CF04 5303            	  8002:     subq.b  #1,D3
                            	  8003:     ; If Y coordinate < $78, make the index 3 for down.
                            	  8004:     ;
02:0003CF06 41EC0084        	  8005:     lea     ($0084,A4),A0
02:0003CF0A 10302000        	  8006:     move.b  (A0,D2.W),D0
02:0003CF0E 0C000078        	  8007:     cmpi.b  #$78,D0
02:0003CF12 6402            	  8008:     bcc  _anon_z04_97
02:0003CF14 7603            	  8009:     moveq   #3,D3
                            	  8010: _anon_z04_97:
                            	  8011:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  8012:     ;
02:0003CF16 0C0000A8        	  8013:     cmpi.b  #$A8,D0
02:0003CF1A 6502            	  8014:     bcs  _anon_z04_98
02:0003CF1C 7607            	  8015:     moveq   #7,D3
                            	  8016: _anon_z04_98:
                            	  8017:     ; Set the vertical speed for the beginning of the jump.
                            	  8018:     ;
02:0003CF1E 41F90003CE12    	  8019:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003CF24 10303000        	  8020:     move.b  (A0,D3.W),D0
02:0003CF28 41EC0412        	  8021:     lea     ($0412,A4),A0
02:0003CF2C 11802000        	  8022:     move.b  D0,(A0,D2.W)
                            	  8023:     ; Look up the Y offset for the current direction.
                            	  8024:     ; Add it to object Y to set the destination Y of the jump.
                            	  8025:     ;
02:0003CF30 41EC0084        	  8026:     lea     ($0084,A4),A0
02:0003CF34 10302000        	  8027:     move.b  (A0,D2.W),D0
02:0003CF38 023C00EE        	  8028:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF3C 41F90003CE1A    	  8029:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF42 12303000        	  8030:     move.b  (A0,D3.W),D1
02:0003CF46 D101            	  8031:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003CF48 41EC042C        	  8032:     lea     ($042C,A4),A0
02:0003CF4C 11802000        	  8033:     move.b  D0,(A0,D2.W)
                            	  8034:     ; Turn the index into a direction again by adding 1.
                            	  8035:     ; Store the facing direction.
                            	  8036:     ;
02:0003CF50 5203            	  8037:     addq.b  #1,D3
02:0003CF52 41EC0098        	  8038:     lea     ($0098,A4),A0
02:0003CF56 11832000        	  8039:     move.b  D3,(A0,D2.W)
