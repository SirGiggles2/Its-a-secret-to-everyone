                            	  5867:     ; This segment is dead. We'll swap the tail segment with this
                            	  5868:     ; dead segment. This way, moldorm heads are always rooted
                            	  5869:     ; in slots 5 and $A; and the segments are continguous.
                            	  5870:     ;
                            	  5871:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5872:     ;
