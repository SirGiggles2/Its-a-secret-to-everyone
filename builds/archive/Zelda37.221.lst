                            	  6089:     ; Copy current direction to old direction.
                            	  6090:     ;
02:0003C15A 41EC0098        	  6091:     lea     ($0098,A4),A0
02:0003C15E 10302000        	  6092:     move.b  (A0,D2.W),D0
02:0003C162 41EC0380        	  6093:     lea     ($0380,A4),A0
02:0003C166 11802000        	  6094:     move.b  D0,(A0,D2.W)
