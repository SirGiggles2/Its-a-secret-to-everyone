                            	  7409: Dodongo_TryEatBomb:
                            	  7410:     ; Try to eat the bomb.
                            	  7411:     ;
                            	  7412:     ; If the bomb is not in range of the monster, then return.
                            	  7413:     ;
                            	  7414:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7415:     ;
02:0003CB2A 7601            	  7416:     moveq   #1,D3
02:0003CB2C 616E            	  7417:     jsr     Dodongo_IsBombInRange
02:0003CB2E 6666            	  7418:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7419:     ; Will loop from 1 to 0, indexed by [00].
                            	  7420:     ;
02:0003CB30 7001            	  7421:     moveq   #1,D0
02:0003CB32 1880            	  7422:     move.b  D0,($0000,A4)
                            	  7423:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7424:     ;
02:0003CB34 41EC0098        	  7425:     lea     ($0098,A4),A0
02:0003CB38 10302000        	  7426:     move.b  (A0,D2.W),D0
02:0003CB3C E208            	  7427:     lsr.b  #1,D0   ; LSR A
02:0003CB3E 7600            	  7428:     moveq   #0,D3
02:0003CB40 1600            	  7429:     move.b  D0,D3
                            	  7430:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7431:     ; position depends on the orientation of the monster.
                            	  7432:     ;
                            	  7433:     ; Start with the horizontal distance.
                            	  7434:     ;
02:0003CB42 102C0004        	  7435:     move.b  ($0004,A4),D0
                            	  7436:     even
                            	  7437: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7438:     ; Look up the limits for the given direction.
                            	  7439:     ;
                            	  7440:     ; If the distance from the bomb < negative limit,
                            	  7441:     ; or >= positive limit, then return.
                            	  7442:     ;
                            	  7443:     ; Note that these are simple signed comparisons that work,
                            	  7444:     ; because the operands are in a small range.
                            	  7445:     ;
02:0003CB46 41F90003CA80    	  7446:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB4C 12303000        	  7447:     move.b  (A0,D3.W),D1
02:0003CB50 B001            	  7448:     cmp.b   D1,D0
02:0003CB52 6B42            	  7449:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB54 41F90003CA86    	  7450:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB5A 12303000        	  7451:     move.b  (A0,D3.W),D1
02:0003CB5E B001            	  7452:     cmp.b   D1,D0
02:0003CB60 6A34            	  7453:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7454:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7455:     ;
02:0003CB62 1003            	  7456:     move.b  D3,D0
02:0003CB64 023C00EE        	  7457:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB68 123C000A        	  7458:     move.b  #$0A,D1
02:0003CB6C D101            	  7459:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB6E 7600            	  7460:     moveq   #0,D3
02:0003CB70 1600            	  7461:     move.b  D0,D3
                            	  7462:     ; Bottom of the loop.
                            	  7463:     ;
                            	  7464:     ; Load the vertical distance for the next iteration.
                            	  7465:     ; Decrement loop counter.
                            	  7466:     ;
02:0003CB72 102C0005        	  7467:     move.b  ($0005,A4),D0
02:0003CB76 5314            	  7468:     subq.b  #1,($0000,A4)
02:0003CB78 6ACC            	  7469:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7470:     ; If we get here, then the bomb was within range of the mouth.
                            	  7471:     ; Go to state 1 (bloated).
                            	  7472:     ;
02:0003CB7A 41EC00AC        	  7473:     lea     ($00AC,A4),A0
02:0003CB7E 52302000        	  7474:     addq.b  #1,(A0,D2.W)
                            	  7475:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7476:     ;
02:0003CB82 7610            	  7477:     moveq   #16,D3
02:0003CB84 7000            	  7478:     moveq   #0,D0
02:0003CB86 41EC00AC        	  7479:     lea     ($00AC,A4),A0
02:0003CB8A 11803000        	  7480:     move.b  D0,(A0,D3.W)
02:0003CB8E 41EC042C        	  7481:     lea     ($042C,A4),A0
02:0003CB92 11802000        	  7482:     move.b  D0,(A0,D2.W)
                            	  7483:     even
                            	  7484: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CB96 4E75            	  7485:     rts
                            	  7486: 
                            	  7487:     even
                            	  7488: DodongoBombPositiveLimits:
02:0003CB98 0C              	  7489:     dc.b    $0C, $11
02:0003CB99 11
                            	  7490: 
                            	  7491:     even
                            	  7492: DodongoBombNegativeLimits:
02:0003CB9A F4              	  7493:     dc.b    $F4, $F0
02:0003CB9B F0
                            	  7494: 
                            	  7495: ; Params:
                            	  7496: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7497: ; [00]: monster hotspot X
                            	  7498: ; [01]: monster hotspot Y
                            	  7499: ; [02]: bomb hotspot X
                            	  7500: ; [03]: bomb hotspot Y
                            	  7501: ;
                            	  7502: ; Returns:
                            	  7503: ; A: 0 if the bomb is in range of the monster
                            	  7504: ; Z: 1 if the bomb is in range of the monster
                            	  7505: ; [04]: horizontal distance
                            	  7506: ; [05]: vertical distance
                            	  7507: ;
                            	  7508: ; Store the positive limit in [06], and the negative one in [07].
                            	  7509: ;
                            	  7510:     even
                            	  7511: Dodongo_IsBombInRange:
02:0003CB9C 41F90003CB98    	  7512:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CBA2 10303000        	  7513:     move.b  (A0,D3.W),D0
02:0003CBA6 19400006        	  7514:     move.b  D0,($0006,A4)
02:0003CBAA 41F90003CB9A    	  7515:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CBB0 10303000        	  7516:     move.b  (A0,D3.W),D0
02:0003CBB4 19400007        	  7517:     move.b  D0,($0007,A4)
                            	  7518:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7519:     ; the bomb is near enough the monster.
                            	  7520:     ;
02:0003CBB8 7003            	  7521:     moveq   #3,D0
02:0003CBBA 19400008        	  7522:     move.b  D0,($0008,A4)
                            	  7523:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7524:     ;
02:0003CBBE 7601            	  7525:     moveq   #1,D3
                            	  7526:     even
                            	  7527: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7528:     ; Subtract the bomb's coordinate from the boss's,
                            	  7529:     ; The loop index determines the coordinate.
                            	  7530:     ;
02:0003CBC0 10343000        	  7531:     move.b  ($00,A4,D3.W),D0
02:0003CBC4 003C0011        	  7532:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBC8 12343002        	  7533:     move.b  ($02,A4,D3.W),D1
02:0003CBCC 0A3C0010        	  7534:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBD0 9101            	  7535:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBD2 0A3C0010        	  7536:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7537:     ; If the distance >= positive offset, or < negative offset;
                            	  7538:     ; then loop again.
                            	  7539:     ;
02:0003CBD6 122C0006        	  7540:     move.b  ($0006,A4),D1
02:0003CBDA B001            	  7541:     cmp.b   D1,D0
02:0003CBDC 6A16            	  7542:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CBDE 122C0007        	  7543:     move.b  ($0007,A4),D1
02:0003CBE2 B001            	  7544:     cmp.b   D1,D0
02:0003CBE4 6B0E            	  7545:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7546:     ; The distance is close enough in this axis.
                            	  7547:     ;
                            	  7548:     ; Store the distance in this axis in [05] or [04],
                            	  7549:     ; depending on the loop index.
                            	  7550:     ;
02:0003CBE6 19803004        	  7551:     move.b  D0,($04,A4,D3.W)
                            	  7552:     ; Shift [08] right, because we're in range in this axis.
                            	  7553:     ;
02:0003CBEA 122C0008        	  7554:     move.b  ($0008,A4),D1
02:0003CBEE E209            	  7555:     lsr.b  #1,D1   ; LSR $08
02:0003CBF0 19410008        	  7556:     move.b  D1,($0008,A4)
                            	  7557:     even
                            	  7558: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CBF4 5303            	  7559:     subq.b  #1,D3
02:0003CBF6 6AC8            	  7560:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7561:     ; If close enough in both axes, then [08] will be 0.
                            	  7562:     ;
02:0003CBF8 102C0008        	  7563:     move.b  ($0008,A4),D0
02:0003CBFC 4E75            	  7564:     rts
                            	  7565: 
                            	  7566: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7567: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7568: ;
                            	  7569: ; But these are not typical direction indexes. Instead a
                            	  7570: ; 5-way index is used.
                            	  7571: ; A direction shifted right once becomes a 5-way index.
                            	  7572: ; The fourth element is unused.
                            	  7573: ;
                            	  7574:     even
                            	  7575: DodongoFrameImages:
02:0003CBFE 00              	  7576:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CBFF 01
02:0003CC00 06
02:0003CC01 FF
02:0003CC02 08
02:0003CC03 02
02:0003CC04 03
02:0003CC05 06
02:0003CC06 FF              	  7577:     dc.b    $FF, $08
02:0003CC07 08
                            	  7578: 
                            	  7579:     even
                            	  7580: DodongoFrameHFlips:
02:0003CC08 00              	  7581:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CC09 40
02:0003CC0A 00
02:0003CC0B FF
02:0003CC0C 00
02:0003CC0D 00
02:0003CC0E 40
02:0003CC0F 40
02:0003CC10 FF              	  7582:     dc.b    $FF, $40
02:0003CC11 40
                            	  7583: 
                            	  7584:     even
                            	  7585: DodongoFrameImagesBloated:
02:0003CC12 04              	  7586:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CC13 05
02:0003CC14 07
02:0003CC15 FF
02:0003CC16 09
02:0003CC17 04
02:0003CC18 05
02:0003CC19 07
02:0003CC1A FF              	  7587:     dc.b    $FF, $09
02:0003CC1B 09
                            	  7588: 
                            	  7589:     even
                            	  7590: DodongoFrameHFlipsBloated:
02:0003CC1C 00              	  7591:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC1D 40
02:0003CC1E 00
02:0003CC1F FF
02:0003CC20 00
02:0003CC21 00
02:0003CC22 40
02:0003CC23 00
02:0003CC24 FF              	  7592:     dc.b    $FF, $00
02:0003CC25 00
