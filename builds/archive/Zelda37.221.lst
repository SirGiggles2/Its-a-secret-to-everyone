                            	  7206: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  7207:     ; To animate the state, the animation counter had to have
                            	  7208:     ; reached 0. Right after this routine, the counter will be
                            	  7209:     ; rolled over, and the movement frame will be switched.
                            	  7210:     ;
                            	  7211:     ; So, set movement frame to 1 (legs together) at the end of
                            	  7212:     ; the animation here, in order to immediately change it to
                            	  7213:     ; 0 (legs apart) after this.
                            	  7214:     ;
02:0004D298 7001            	  7215:     moveq   #1,D0
02:0004D29A 194003E4        	  7216:     move.b  D0,($03E4,A4)
