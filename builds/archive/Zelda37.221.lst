                            	  8241: Submenu_CueTransferRowUW:
                            	  8242:     ; If menu scroll value is negative, then we transferred everything.
                            	  8243:     ; So, return.
                            	  8244:     ;
02:00044EC6 102C005E        	  8245:     move.b  ($005E,A4),D0
02:00044ECA 6A02            	  8246:     bpl.s  __far_z_05_0110
02:00044ECC 602E            	  8247:     jmp  L1725A_Exit
                            	  8248: __far_z_05_0110:
                            	  8249:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8250:     ; and represents the current row of the submenu being processed.
                            	  8251:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8252:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  8253:     ;
                            	  8254:     ; If the bottom bit is set, go prepare the full black row.
                            	  8255:     ;
02:00044ECE E208            	  8256:     lsr.b  #1,D0   ; LSR A
02:00044ED0 7600            	  8257:     moveq   #0,D3
02:00044ED2 1600            	  8258:     move.b  D0,D3
02:00044ED4 6402            	  8259:     bcc.s  __far_z_05_0111
02:00044ED6 6026            	  8260:     jmp  PrepFullBlackRow
                            	  8261: __far_z_05_0111:
                            	  8262:     ; Submenu rows $D to $15 are parts of the map.
                            	  8263:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  8264:     ;
                            	  8265:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  8266:     ; buffer for this row.
                            	  8267:     ;
02:00044ED8 0C00000D        	  8268:     cmpi.b  #$0D,D0
02:00044EDC 640C            	  8269:     bcc  _anon_z05_167
02:00044EDE 41F900044EA2    	  8270:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044EE4 10303000        	  8271:     move.b  (A0,D3.W),D0
                            	  8272:     even
                            	  8273: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00044EE8 606E            	  8274:     jmp     SelectTransferBufAndDecCounter
                            	  8275: 
                            	  8276: _anon_z05_167:
                            	  8277:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  8278:     ; of the big map sheet.
                            	  8279:     ;
02:00044EEA 0C000015        	  8280:     cmpi.b  #$15,D0
02:00044EEE 6604            	  8281:     bne  _anon_z05_168
02:00044EF0 7042            	  8282:     moveq   #66,D0
02:00044EF2 60F4            	  8283:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  8284: 
