                            	  7210: __far_z_04_0065:
                            	  7211:     ; New bloated substate >= 2.
                            	  7212:     ;
                            	  7213:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7214:     ; which will transition to state 0 (moving).
                            	  7215:     ;
                            	  7216:     ; Note that if the bomb hits >= 2, then:
                            	  7217:     ; - If new substate = 2, then substate 2 will wait,
                            	  7218:     ;   and then transition to substate 3.
                            	  7219:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7220:     ;
02:0003C9C0 7600            	  7221:     moveq   #0,D3
02:0003C9C2 41EC0437        	  7222:     lea     ($0437,A4),A0
02:0003C9C6 16302000        	  7223:     move.b  (A0,D2.W),D3
02:0003C9CA 0C030002        	  7224:     cmpi.b  #$02,D3
02:0003C9CE 6502            	  7225:     bcs.s  __far_z_04_0066
02:0003C9D0 600A            	  7226:     jmp  L_Dodongo_DecrementBloatedTimer
