                            	  6167: __far_z_05_0094:
                            	  6168:     ; Turn the door command into the desired open or closed state
                            	  6169:     ; to store in [08].
                            	  6170:     ;
                            	  6171:     ; cmd:  7 6 3 2 
                            	  6172:     ; [08]: 2 0 0 0
                            	  6173:     ;
                            	  6174:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  6175:     ; commands intended to be used.
                            	  6176:     ;
                            	  6177:     ; 3 is the end state of 2: close
                            	  6178:     ; 7 is the end state of 6: open
                            	  6179:     ;
02:00043A9A 02000007        	  6180:     andi.b #$07,D0
02:00043A9E 7601            	  6181:     moveq   #1,D3
02:00043AA0 19430002        	  6182:     move.b  D3,($0002,A4)
02:00043AA4 122C0002        	  6183:     move.b  ($0002,A4),D1
02:00043AA8 C200            	  6184:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00043AAA 6702            	  6185:     beq  _anon_z05_118
02:00043AAC E208            	  6186:     lsr.b  #1,D0   ; LSR A
                            	  6187: _anon_z05_118:
02:00043AAE 0C000002        	  6188:     cmpi.b  #$02,D0
02:00043AB2 6606            	  6189:     bne  _anon_z05_119
                            	  6190:     ; Command 2 sets Link's timer to $30.
                            	  6191:     ;
02:00043AB4 7630            	  6192:     moveq   #48,D3
02:00043AB6 19430028        	  6193:     move.b  D3,($0028,A4)
                            	  6194: _anon_z05_119:
02:00043ABA 02000003        	  6195:     andi.b #$03,D0
02:00043ABE 003C0011        	  6196:     ori     #$11,CCR  ; SEC: set C+X
02:00043AC2 123C0001        	  6197:     move.b  #$01,D1
02:00043AC6 0A3C0010        	  6198:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043ACA 9101            	  6199:     subx.b  D1,D0   ; SBC #$01
02:00043ACC 0A3C0010        	  6200:     eori    #$10,CCR  ; restore X = 6502 C
02:00043AD0 02000002        	  6201:     andi.b #$02,D0
02:00043AD4 19400008        	  6202:     move.b  D0,($0008,A4)
                            	  6203:     ; The command to close a key door or bombable wall does not
                            	  6204:     ; do anything.
                            	  6205:     ;
02:00043AD8 102C0054        	  6206:     move.b  ($0054,A4),D0
02:00043ADC 0C000005        	  6207:     cmpi.b  #$05,D0
02:00043AE0 6416            	  6208:     bcc  _anon_z05_120
02:00043AE2 102C0055        	  6209:     move.b  ($0055,A4),D0
02:00043AE6 19400002        	  6210:     move.b  D0,($0002,A4)
02:00043AEA 6100FAEC        	  6211:     jsr     FindDoorAttrByDoorBit
02:00043AEE 0C000007        	  6212:     cmpi.b  #$07,D0
02:00043AF2 6704            	  6213:     beq  _anon_z05_120
02:00043AF4 6000009C        	  6214:     jmp     L_ResetDoorCmdAndLayOutDoors
