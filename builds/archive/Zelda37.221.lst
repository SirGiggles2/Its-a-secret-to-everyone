02:00033570 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033572 48C4            	   530:     ext.l   D4
02:00033574 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003357A 2044            	   532:     movea.l D4,A0
