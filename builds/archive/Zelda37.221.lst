                            	  7067: UpdateDodongoState0_Move:
                            	  7068:     ; If facing left, then push X offset 0 on the stack.
                            	  7069:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  7070:     ;
                            	  7071:     ; We would like to use one set of coordinates only.
                            	  7072:     ; But movement would break down, if we did; because
                            	  7073:     ; Dodongo is so long.
                            	  7074:     ;
                            	  7075:     ; So, when not facing left, we temporarily shift the
                            	  7076:     ; X coordinate to be closer to the other side of the monster.
                            	  7077:     ;
02:0003C8B2 7600            	  7078:     moveq   #0,D3
02:0003C8B4 41EC0098        	  7079:     lea     ($0098,A4),A0
02:0003C8B8 10302000        	  7080:     move.b  (A0,D2.W),D0
02:0003C8BC 0200000D        	  7081:     andi.b #$0D,D0
02:0003C8C0 6716            	  7082:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C8C2 10342070        	  7083:     move.b  ($70,A4,D2.W),D0
02:0003C8C6 023C00EE        	  7084:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8CA 123C0010        	  7085:     move.b  #$10,D1
02:0003C8CE D101            	  7086:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C8D0 19802070        	  7087:     move.b  D0,($70,A4,D2.W)
02:0003C8D4 163C00F0        	  7088:     move.b  #$F0,D3
                            	  7089:     even
                            	  7090: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C8D8 1003            	  7091:     move.b  D3,D0
02:0003C8DA 1B00            	  7092:     move.b  D0,-(A5)  ; PHA
02:0003C8DC 7020            	  7093:     moveq   #32,D0
02:0003C8DE 41EC041F        	  7094:     lea     ($041F,A4),A0
02:0003C8E2 11802000        	  7095:     move.b  D0,(A0,D2.W)
02:0003C8E6 6100CF7E        	  7096:     jsr     Wanderer_TargetPlayer
                            	  7097:     ; Pop the offset and add it to the X coordinate.
                            	  7098:     ;
                            	  7099:     ; This brings the X coordinate back to the unique value
                            	  7100:     ; that represents the position.
                            	  7101:     ;
02:0003C8EA 101D            	  7102:     move.b  (A5)+,D0  ; PLA
02:0003C8EC 023C00EE        	  7103:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C8F0 12342070        	  7104:     move.b  ($70,A4,D2.W),D1
02:0003C8F4 D101            	  7105:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C8F6 19802070        	  7106:     move.b  D0,($70,A4,D2.W)
                            	  7107:     ; If X coordinate < $20, then face right.
                            	  7108:     ;
02:0003C8FA 0C000020        	  7109:     cmpi.b  #$20,D0
