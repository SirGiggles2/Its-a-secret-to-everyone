02:00031CC2 41EC034F        	  6846:     lea     ($034F,A4),A0
02:00031CC6 16302000        	  6847:     move.b  (A0,D2.W),D3
02:00031CCA 0C03002E        	  6848:     cmpi.b  #$2E,D3
