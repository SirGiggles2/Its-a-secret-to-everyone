02:0002E214 0200003F        	   913:     andi.b #$3F,D0
02:0002E218 0C00003F        	   914:     cmpi.b  #$3F,D0
02:0002E21C 6732            	   915:     beq  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   916:     ; If Link's X <> item's X, then loop again.
