                            	  2473:     ;
02:0003A780 101D            	  2474:     move.b  (A5)+,D0  ; PLA
02:0003A782 41EC03BC        	  2475:     lea     ($03BC,A4),A0
02:0003A786 11802000        	  2476:     move.b  D0,(A0,D2.W)
                            	  2477:     even
