                            	  4982:     ; The effect involves turning grayscale rendering on and off
                            	  4983:     ; in PPUMASK.
                            	  4984:     ;
                            	  4985:     ; Start by setting A register to the PPU mask shifted right to
                            	  4986:     ; throw away the grayscale bit.
                            	  4987:     ;
