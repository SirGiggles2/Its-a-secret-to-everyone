02:0003627E 19400604        	  4620:     move.b  D0,($0604,A4)
                            	  4621:     ; If the high 2 bits of character element = 0, then return.
                            	  4622:     ;
02:00036282 1214            	  4623:     move.b  ($00,A4),D1   ; ptr lo
02:00036284 182C0001        	  4624:     move.b  ($01,A4),D4  ; ptr hi
02:00036288 024100FF        	  4625:     andi.w  #$00FF,D1         ; zero-extend lo byte
