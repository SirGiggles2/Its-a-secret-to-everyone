                            	  5251: SpreadShot:
                            	  5252:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5253:     ;
                            	  5254:     ; The shot is spreading out.
                            	  5255:     ;
                            	  5256:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5257:     ; These will be negated appropriately for each corner.
                            	  5258:     ;
02:0004C546 41EC0098        	  5259:     lea     ($0098,A4),A0
02:0004C54A 10302000        	  5260:     move.b  (A0,D2.W),D0
02:0004C54E 19400002        	  5261:     move.b  D0,($0002,A4)
02:0004C552 19400003        	  5262:     move.b  D0,($0003,A4)
                            	  5263:     ; Reset [0F] to not flip horizontally.
                            	  5264:     ;
02:0004C556 7000            	  5265:     moveq   #0,D0
02:0004C558 1940000F        	  5266:     move.b  D0,($000F,A4)
                            	  5267:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5268:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5269:     ;
02:0004C55C 7603            	  5270:     moveq   #3,D3
                            	  5271:     even
                            	  5272: _L_z07_SpreadShot_DrawShotCorner:
02:0004C55E 1003            	  5273:     move.b  D3,D0
02:0004C560 1B00            	  5274:     move.b  D0,-(A5)  ; PHA
                            	  5275:     ; Save offset X [02] and Y offset [03].
                            	  5276:     ;
02:0004C562 102C0002        	  5277:     move.b  ($0002,A4),D0
02:0004C566 1B00            	  5278:     move.b  D0,-(A5)  ; PHA
02:0004C568 102C0003        	  5279:     move.b  ($0003,A4),D0
02:0004C56C 1B00            	  5280:     move.b  D0,-(A5)  ; PHA
                            	  5281:     ; Calculate and set sprite attributes for this corner:
                            	  5282:     ;   base attribute OR (frame counter AND 3)
                            	  5283:     ;
                            	  5284:     ; The base attribute defines how to flip the sprite.
                            	  5285:     ; The frame counter makes the shot flash by cycling each
                            	  5286:     ; palette row.
                            	  5287:     ;
02:0004C56E 102C0015        	  5288:     move.b  ($0015,A4),D0
02:0004C572 02000003        	  5289:     andi.b #$03,D0
02:0004C576 41F90004C3D4    	  5290:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C57C 12303000        	  5291:     move.b  (A0,D3.W),D1
02:0004C580 8001            	  5292:     or.b  D1,D0
02:0004C582 4EB90003198E    	  5293:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5294:     ; Add the object's X (the center of the spread) and the
                            	  5295:     ; current offset in [02] to set sprite X in [00].
                            	  5296:     ;
02:0004C588 10342070        	  5297:     move.b  ($70,A4,D2.W),D0
02:0004C58C 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C590 122C0002        	  5299:     move.b  ($0002,A4),D1
02:0004C594 D101            	  5300:     addx.b  D1,D0   ; ADC $02
02:0004C596 1880            	  5301:     move.b  D0,($0000,A4)
                            	  5302:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5303:     ; Else calculate the distance from object X to sprite X.
                            	  5304:     ;
02:0004C598 12342070        	  5305:     move.b  ($70,A4,D2.W),D1
02:0004C59C B001            	  5306:     cmp.b   D1,D0
02:0004C59E 651A            	  5307:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C5A0 0C0000FC        	  5308:     cmpi.b  #$FC,D0
02:0004C5A4 6466            	  5309:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C5A6 003C0011        	  5310:     ori     #$11,CCR  ; SEC: set C+X
02:0004C5AA 12342070        	  5311:     move.b  ($70,A4,D2.W),D1
02:0004C5AE 0A3C0010        	  5312:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C5B2 9101            	  5313:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C5B4 0A3C0010        	  5314:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C5B8 6014            	  5315:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5316: 
                            	  5317:     even
                            	  5318: _L_z07_SpreadShot_ReverseSub:
02:0004C5BA 10342070        	  5319:     move.b  ($70,A4,D2.W),D0
02:0004C5BE 003C0011        	  5320:     ori     #$11,CCR  ; SEC: set C+X
02:0004C5C2 1214            	  5321:     move.b  ($0000,A4),D1
02:0004C5C4 0A3C0010        	  5322:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C5C8 9101            	  5323:     subx.b  D1,D0   ; SBC $00
02:0004C5CA 0A3C0010        	  5324:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5325:     even
                            	  5326: _L_z07_SpreadShot_CheckDistance:
                            	  5327:     ; If distance >= $20, skip this corner.
                            	  5328:     ;
02:0004C5CE 0C000020        	  5329:     cmpi.b  #$20,D0
02:0004C5D2 6438            	  5330:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5331:     ; Add the object's Y (the center of the spread) and the
                            	  5332:     ; current offset in [03] to set sprite Y in [01].
                            	  5333:     ;
02:0004C5D4 41EC0084        	  5334:     lea     ($0084,A4),A0
02:0004C5D8 10302000        	  5335:     move.b  (A0,D2.W),D0
02:0004C5DC 023C00EE        	  5336:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C5E0 122C0003        	  5337:     move.b  ($0003,A4),D1
02:0004C5E4 D101            	  5338:     addx.b  D1,D0   ; ADC $03
02:0004C5E6 19400001        	  5339:     move.b  D0,($0001,A4)
                            	  5340:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5341:     ;
02:0004C5EA 7600            	  5342:     moveq   #0,D3
02:0004C5EC 162C0010        	  5343:     move.b  ($0010,A4),D3
02:0004C5F0 670C            	  5344:     beq  _L_z07_SpreadShot_Draw
02:0004C5F2 0C00003E        	  5345:     cmpi.b  #$3E,D0
02:0004C5F6 6514            	  5346:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C5F8 0C0000E8        	  5347:     cmpi.b  #$E8,D0
02:0004C5FC 640E            	  5348:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5349:     even
                            	  5350: _L_z07_SpreadShot_Draw:
                            	  5351:     ; Draw the corner.
                            	  5352:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5353:     ;
02:0004C5FE 7002            	  5354:     moveq   #2,D0
02:0004C600 1940000C        	  5355:     move.b  D0,($000C,A4)
02:0004C604 7623            	  5356:     moveq   #35,D3
02:0004C606 4EB9000318AE    	  5357:     jsr     Anim_WriteItemSprites
                            	  5358:     even
                            	  5359: _L_z07_SpreadShot_NextCorner:
                            	  5360:     ; Prepare to process the next corner.
                            	  5361:     ;
                            	  5362:     ; First, restore X offset [02] and Y offset [03].
                            	  5363:     ;
02:0004C60C 101D            	  5364:     move.b  (A5)+,D0  ; PLA
02:0004C60E 19400003        	  5365:     move.b  D0,($0003,A4)
02:0004C612 101D            	  5366:     move.b  (A5)+,D0  ; PLA
02:0004C614 19400002        	  5367:     move.b  D0,($0002,A4)
                            	  5368:     ; Take turns negating X offset or Y offset for the next round.
                            	  5369:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5370:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5371:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5372:     ; - Fourth turn: doesn't matter
                            	  5373:     ;
                            	  5374:     ;
                            	  5375:     ; Get the loop index.
02:0004C618 101D            	  5376:     move.b  (A5)+,D0  ; PLA
02:0004C61A 1B00            	  5377:     move.b  D0,-(A5)  ; PHA
02:0004C61C 7600            	  5378:     moveq   #0,D3
02:0004C61E 1600            	  5379:     move.b  D0,D3
02:0004C620 0C030001        	  5380:     cmpi.b  #$01,D3
02:0004C624 6602            	  5381:     bne  _anon_z07_25
02:0004C626 7603            	  5382:     moveq   #3,D3
                            	  5383: _anon_z07_25:
02:0004C628 10343000        	  5384:     move.b  ($00,A4,D3.W),D0
02:0004C62C 4600            	  5385:     eori.b #$FF,D0
02:0004C62E 023C00EE        	  5386:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C632 123C0001        	  5387:     move.b  #$01,D1
02:0004C636 D101            	  5388:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C638 19803000        	  5389:     move.b  D0,($00,A4,D3.W)
                            	  5390:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5391:     ;
02:0004C63C 101D            	  5392:     move.b  (A5)+,D0  ; PLA
02:0004C63E 7600            	  5393:     moveq   #0,D3
02:0004C640 1600            	  5394:     move.b  D0,D3
02:0004C642 5303            	  5395:     subq.b  #1,D3
02:0004C644 6A00FF18        	  5396:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5397:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5398:     ;
                            	  5399:     ; Decrease the base negative offset to get farther away from
                            	  5400:     ; the center point.
                            	  5401:     ;
02:0004C648 41EC0098        	  5402:     lea     ($0098,A4),A0
02:0004C64C 53302000        	  5403:     subq.b  #1,(A0,D2.W)
                            	  5404:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5405:     ;
                            	  5406:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5407:     ;
02:0004C650 41EC0098        	  5408:     lea     ($0098,A4),A0
02:0004C654 10302000        	  5409:     move.b  (A0,D2.W),D0
02:0004C658 0C0000E8        	  5410:     cmpi.b  #$E8,D0
02:0004C65C 6702            	  5411:     beq.s  __far_z_07_0081
02:0004C65E 6004            	  5412:     jmp  L1F49F_Exit
                            	  5413: __far_z_07_0081:
02:0004C660 6000FED2        	  5414:     jmp     DeactivateLinkShot
                            	  5415: 
                            	  5416:     even
