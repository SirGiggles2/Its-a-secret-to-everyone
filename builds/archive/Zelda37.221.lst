02:000368FC 142C0016        	  5244:     move.b  ($0016,A4),D2
02:00036900 41EC062D        	  5245:     lea     ($062D,A4),A0
02:00036904 10302000        	  5246:     move.b  (A0,D2.W),D0
02:00036908 6608            	  5247:     bne  _anon_z02_44
02:0003690A 0C030010        	  5248:     cmpi.b  #$10,D3
02:0003690E 64000114        	  5249:     bcc  _L_z02_DrawCredits_IncLine
                            	  5250: _anon_z02_44:
