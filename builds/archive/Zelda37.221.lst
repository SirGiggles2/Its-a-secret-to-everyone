                            	  3143: Link_FilterInput:
                            	  3144:     ; [00] holds the opposite of Link's facing direction.
                            	  3145:     ;
02:00041B1E 102C0098        	  3146:     move.b  ($0098,A4),D0
02:00041B22 4EB900030AFE    	  3147:     jsr     GetOppositeDir
02:00041B28 1880            	  3148:     move.b  D0,($0000,A4)
                            	  3149:     ; Call GetOppositeDir again to use this mapping:
                            	  3150:     ; In Dir: 1 2 4 8
                            	  3151:     ;         -------
                            	  3152:     ; Index:  2 3 0 1
                            	  3153:     ;
02:00041B2A 4EB900030AFE    	  3154:     jsr     GetOppositeDir
                            	  3155:     ; Get the appropriate coordinate for the direction:
                            	  3156:     ; X for horizontal
                            	  3157:     ; Y for vertical
                            	  3158:     ;
02:00041B30 102C0070        	  3159:     move.b  ($0070,A4),D0
02:00041B34 0C030002        	  3160:     cmpi.b  #$02,D3
02:00041B38 6404            	  3161:     bcc  _anon_z05_74
02:00041B3A 102C0084        	  3162:     move.b  ($0084,A4),D0
                            	  3163: _anon_z05_74:
02:00041B3E 19400002        	  3164:     move.b  D0,($0002,A4)
                            	  3165:     ; Mask A button and directions if inner border is crossed.
                            	  3166:     ;
02:00041B42 1003            	  3167:     move.b  D3,D0
02:00041B44 1B00            	  3168:     move.b  D0,-(A5)  ; PHA
02:00041B46 023C00EE        	  3169:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041B4A 123C0008        	  3170:     move.b  #$08,D1
02:00041B4E D101            	  3171:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041B50 7600            	  3172:     moveq   #0,D3
02:00041B52 1600            	  3173:     move.b  D0,D3
02:00041B54 103C0080        	  3174:     move.b  #$80,D0
02:00041B58 6134            	  3175:     jsr     MaskInputInBorder
02:00041B5A 101D            	  3176:     move.b  (A5)+,D0  ; PLA
02:00041B5C 7600            	  3177:     moveq   #0,D3
02:00041B5E 1600            	  3178:     move.b  D0,D3
                            	  3179:     ; If inner boundary was not crossed, then we'll check the outer
                            	  3180:     ; boundary using player's direction and reverse direction index.
                            	  3181:     ;
02:00041B60 102C0001        	  3182:     move.b  ($0001,A4),D0
