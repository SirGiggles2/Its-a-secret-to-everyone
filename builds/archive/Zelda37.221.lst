                            	  3978: FindNextEdgeSpawnCell:
                            	  3979:     ; Load [0A] with the value before the call.
                            	  3980:     ;
02:00042076 102C0525        	  3981:     move.b  ($0525,A4),D0
02:0004207A 1940000A        	  3982:     move.b  D0,($000A,A4)
                            	  3983:     even
                            	  3984: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3985:     ; Loop to look for a place to spawn a monster from the edge
                            	  3986:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3987:     ;
                            	  3988:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3989:     ; We'll move down $10 pixels.
                            	  3990:     ;
02:0004207E 7610            	  3991:     moveq   #16,D3
02:00042080 102C000A        	  3992:     move.b  ($000A,A4),D0
02:00042084 0200000F        	  3993:     andi.b #$0F,D0
02:00042088 670A            	  3994:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3995:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3996:     ; Don't move vertically.
                            	  3997:     ;
02:0004208A 163C00F0        	  3998:     move.b  #$F0,D3
02:0004208E 0C00000F        	  3999:     cmpi.b  #$0F,D0
02:00042092 6610            	  4000:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  4001:     even
                            	  4002: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  4003:     ; Else low nibble = $F. We're at the right edge,
                            	  4004:     ; and we'll move up $10 pixels.
                            	  4005:     ;
02:00042094 1003            	  4006:     move.b  D3,D0
02:00042096 023C00EE        	  4007:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004209A 122C000A        	  4008:     move.b  ($000A,A4),D1
02:0004209E D101            	  4009:     addx.b  D1,D0   ; ADC $0A
02:000420A0 1940000A        	  4010:     move.b  D0,($000A,A4)
                            	  4011:     even
                            	  4012: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  4013:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  4014:     ; Move right one pixel.
                            	  4015:     ;
02:000420A4 102C000A        	  4016:     move.b  ($000A,A4),D0
02:000420A8 020000F0        	  4017:     andi.b #$F0,D0
02:000420AC 0C0000E0        	  4018:     cmpi.b  #$E0,D0
02:000420B0 6606            	  4019:     bne  _anon_z05_88
02:000420B2 522C000A        	  4020:     addq.b  #1,($000A,A4)
02:000420B6 600A            	  4021:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4022: 
                            	  4023: _anon_z05_88:
                            	  4024:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  4025:     ; Dont' move horizontally.
                            	  4026:     ;
02:000420B8 0C000040        	  4027:     cmpi.b  #$40,D0
02:000420BC 6604            	  4028:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  4029:     ; Else high nibble = 4. We're at the top edge.
                            	  4030:     ; Move left 1 pixel.
                            	  4031:     ;
02:000420BE 532C000A        	  4032:     subq.b  #1,($000A,A4)
                            	  4033:     even
                            	  4034: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  4035:     ; Time to get the address of the column.
                            	  4036:     ; Starting at the top of the leftmost column.
                            	  4037:     ;
02:000420C2 610026C6        	  4038:     jsr     FetchTileMapAddr
02:000420C6 7005            	  4039:     moveq   #5,D0
02:000420C8 4EB90002A9FA    	  4040:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  4041:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  4042:     ; in order to point to the column we want.
                            	  4043:     ;
02:000420CE 102C000A        	  4044:     move.b  ($000A,A4),D0
02:000420D2 0200000F        	  4045:     andi.b #$0F,D0
02:000420D6 7600            	  4046:     moveq   #0,D3
02:000420D8 1600            	  4047:     move.b  D0,D3
02:000420DA 670C            	  4048:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  4049: _anon_z05_89:
02:000420DC 702C            	  4050:     moveq   #44,D0
02:000420DE 4EB900030F54    	  4051:     jsr     AddToInt16At0
02:000420E4 5303            	  4052:     subq.b  #1,D3
02:000420E6 66F4            	  4053:     bne  _anon_z05_89
                            	  4054:     even
                            	  4055: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  4056:     ; Turn the row part of [0A] into a tile index.
                            	  4057:     ; row := (([0A] AND $F0) - $40) / 8
                            	  4058:     ;
02:000420E8 102C000A        	  4059:     move.b  ($000A,A4),D0
02:000420EC 020000F0        	  4060:     andi.b #$F0,D0
02:000420F0 003C0011        	  4061:     ori     #$11,CCR  ; SEC: set C+X
02:000420F4 123C0040        	  4062:     move.b  #$40,D1
02:000420F8 0A3C0010        	  4063:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000420FC 9101            	  4064:     subx.b  D1,D0   ; SBC #$40
