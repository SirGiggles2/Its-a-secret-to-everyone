                            	   464: UpdateMenuScrollUp:
                            	   465:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   466:     ;
02:000402F8 103C00FD        	   467:     move.b  #$FD,D0
02:000402FC 613A            	   468:     jsr     MovePositionMarkers
02:000402FE 102C00FC        	   469:     move.b  ($00FC,A4),D0
02:00040302 023C00EE        	   470:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040306 123C0003        	   471:     move.b  #$03,D1
02:0004030A D101            	   472:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004030C 194000FC        	   473:     move.b  D0,($00FC,A4)
                            	   474:     ; If hardware vertical scroll still < $F0, then return.
                            	   475:     ;
02:00040310 0C0000F0        	   476:     cmpi.b  #$F0,D0
02:00040314 6406            	   477:     bcc.s  __far_z_05_0004
02:00040316 4EF90002D01E    	   478:     jmp  Exit
                            	   479: __far_z_05_0004:
                            	   480:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   481:     ;
02:0004031C 1940005C        	   482:     move.b  D0,($005C,A4)
                            	   483:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   484:     ;
                            	   485:     ; UNKNOWN: But why not do this in OW, too?
                            	   486:     ;
02:00040320 102C0010        	   487:     move.b  ($0010,A4),D0
02:00040324 6706            	   488:     beq  _anon_z05_4
02:00040326 4EB9000313BE    	   489:     jsr     WriteBlankPrioritySprites
                            	   490: _anon_z05_4:
                            	   491:     ; We reached the end. So, reset hardware vertical scroll
                            	   492:     ; and submenu state.
                            	   493:     ;
02:0004032C 7000            	   494:     moveq   #0,D0
02:0004032E 194000FC        	   495:     move.b  D0,($00FC,A4)
02:00040332 194000E1        	   496:     move.b  D0,($00E1,A4)
                            	   497:     ; Move the position markers 2 pixels down, because we
                            	   498:     ; overshot and reached vertical scroll $F2.
                            	   499:     ;
02:00040336 7002            	   500:     moveq   #2,D0
                            	   501: ; Params:
                            	   502: ; A: vertical velocity of menu scrolling
                            	   503: ;
                            	   504: ;
                            	   505: ; [00] holds the vertical velocity of menu scrolling.
                            	   506:     even
                            	   507: MovePositionMarkers:
02:00040338 1880            	   508:     move.b  D0,($0000,A4)
                            	   509:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   510:     ;
02:0004033A 102C0254        	   511:     move.b  ($0254,A4),D0
02:0004033E 0C0000F8        	   512:     cmpi.b  #$F8,D0
02:00040342 670C            	   513:     beq  _anon_z05_5
02:00040344 023C00EE        	   514:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040348 1214            	   515:     move.b  ($0000,A4),D1
02:0004034A D101            	   516:     addx.b  D1,D0   ; ADC $00
02:0004034C 19400254        	   517:     move.b  D0,($0254,A4)
