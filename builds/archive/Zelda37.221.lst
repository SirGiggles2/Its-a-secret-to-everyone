02:0003F589 09
02:0003F58A 00
02:0003F58B 00
02:0003F58C 01
02:0003F58D 01
02:0003F58E 02              	 13190:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003F58F 02
02:0003F590 03
02:0003F591 03
02:0003F592 04
02:0003F593 00
02:0003F594 05
02:0003F595 01
