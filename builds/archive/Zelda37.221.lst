02:000310F8 1600            	  5388:     move.b  D0,D3
02:000310FA 41F900030FB2    	  5389:     lea     (ItemIdToDescriptor).l,A0
02:00031100 10302000        	  5390:     move.b  (A0,D2.W),D0
