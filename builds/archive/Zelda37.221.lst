02:0003CE90 6452            	  7941:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7942:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7943:     ; then go change to state 1.
                            	  7944:     ;
02:0003CE92 41EC041F        	  7945:     lea     ($041F,A4),A0
02:0003CE96 10302000        	  7946:     move.b  (A0,D2.W),D0
02:0003CE9A 020000FC        	  7947:     andi.b #$FC,D0
02:0003CE9E 0C0000B0        	  7948:     cmpi.b  #$B0,D0
02:0003CEA2 6742            	  7949:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CEA4 0C0000F4        	  7950:     cmpi.b  #$F4,D0
02:0003CEA8 643C            	  7951:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7952:     ; Else blocked by something else.
                            	  7953:     ;
                            	  7954:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7955:     ;
02:0003CEAA 41EC0098        	  7956:     lea     ($0098,A4),A0
02:0003CEAE 10302000        	  7957:     move.b  (A0,D2.W),D0
02:0003CEB2 02000003        	  7958:     andi.b #$03,D0
02:0003CEB6 6618            	  7959:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7960:     ; Else facing vertically. Flip the direction.
