                            	   314:     ; PATCHED: NOP — audio data requires NES bank mapping not yet implemented.
02:0002C9F4 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002C9F6 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002C9FA 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002C9FC 7000            	   323:     moveq   #0,D0
02:0002C9FE 6100E474        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:0002CA02 700F            	   325:     moveq   #15,D0
02:0002CA04 6100E46E        	   326:     jsr     _apu_write_4015  ; APU/IO write
02:0002CA08 6618            	   327:     bne  _L_z00_DriveAudio_Paused
                            	   328:     even
                            	   329: _L_z00_DriveAudio_Play:
