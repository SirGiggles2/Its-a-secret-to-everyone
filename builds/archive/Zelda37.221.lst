02:0003DF5E 6408            	 10147:     bcc  _anon_z04_122
02:0003DF60 41EC042C        	 10148:     lea     ($042C,A4),A0
02:0003DF64 53302000        	 10149:     subq.b  #1,(A0,D2.W)
                            	 10150: _anon_z04_122:
                            	 10151:     ; If open eye timer = 0, then the eye is closed.
                            	 10152:     ; Go animate it differently.
