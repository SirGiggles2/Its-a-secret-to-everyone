02:0003EF64 10302000        	 12319:     move.b  (A0,D2.W),D0
02:0003EF68 122C0002        	 12320:     move.b  ($0002,A4),D1
02:0003EF6C E309            	 12321:     lsl.b  #1,D1   ; ASL $02
02:0003EF6E 19410002        	 12322:     move.b  D1,($0002,A4)
02:0003EF72 122C0002        	 12323:     move.b  ($0002,A4),D1
