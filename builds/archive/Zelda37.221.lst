                            	 13206: Ganon_DrawBody:
                            	 13207:     ; Loop over four 16x16 images that make up Ganon.
                            	 13208:     ; There are 6 animation frames.
                            	 13209:     ;
02:0003F5AA 7603            	 13210:     moveq   #3,D3
                            	 13211:     even
                            	 13212: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 13213:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 13214:     ;
02:0003F5AC 10342070        	 13215:     move.b  ($70,A4,D2.W),D0
02:0003F5B0 023C00EE        	 13216:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5B4 41F90003F59E    	 13217:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F5BA 12303000        	 13218:     move.b  (A0,D3.W),D1
02:0003F5BE D101            	 13219:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F5C0 1880            	 13220:     move.b  D0,($0000,A4)
                            	 13221:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 13222:     ;
02:0003F5C2 41EC0084        	 13223:     lea     ($0084,A4),A0
02:0003F5C6 10302000        	 13224:     move.b  (A0,D2.W),D0
02:0003F5CA 023C00EE        	 13225:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F5CE 41F90003F5A2    	 13226:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F5D4 12303000        	 13227:     move.b  (A0,D3.W),D1
02:0003F5D8 D101            	 13228:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F5DA 19400001        	 13229:     move.b  D0,($0001,A4)
                            	 13230:     ; Each part has a horizontal flipping flag.
                            	 13231:     ;
02:0003F5DE 41F90003F5A6    	 13232:     lea     (GanonSpriteHFlips).l,A0
02:0003F5E4 10303000        	 13233:     move.b  (A0,D3.W),D0
02:0003F5E8 1940000F        	 13234:     move.b  D0,($000F,A4)
                            	 13235:     ; Save and copy the loop index (the current part) to [07].
                            	 13236:     ;
02:0003F5EC 1003            	 13237:     move.b  D3,D0
02:0003F5EE 1B00            	 13238:     move.b  D0,-(A5)  ; PHA
02:0003F5F0 19400007        	 13239:     move.b  D0,($0007,A4)
                            	 13240:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 13241:     ; that make it up.
                            	 13242:     ;
02:0003F5F4 41EC046B        	 13243:     lea     ($046B,A4),A0
02:0003F5F8 10302000        	 13244:     move.b  (A0,D2.W),D0
02:0003F5FC E308            	 13245:     lsl.b  #1,D0   ; ASL A
02:0003F5FE E308            	 13246:     lsl.b  #1,D0   ; ASL A
                            	 13247:     ; Add [07] -- the index of the current part.
                            	 13248:     ;
                            	 13249:     ; Now you have an index into the frame image table, for the
                            	 13250:     ; current image part of the current animation frame.
                            	 13251:     ;
02:0003F600 122C0007        	 13252:     move.b  ($0007,A4),D1
02:0003F604 D101            	 13253:     addx.b  D1,D0   ; ADC $07
02:0003F606 7600            	 13254:     moveq   #0,D3
02:0003F608 1600            	 13255:     move.b  D0,D3
02:0003F60A 41F90003F586    	 13256:     lea     (GanonFrameImages).l,A0
02:0003F610 10303000        	 13257:     move.b  (A0,D3.W),D0
02:0003F614 4EB90003169C    	 13258:     jsr     DrawObjectNotMirrored
02:0003F61A 101D            	 13259:     move.b  (A5)+,D0  ; PLA
                            	 13260:     ; Bottom of the part loop.
                            	 13261:     ;
02:0003F61C 7600            	 13262:     moveq   #0,D3
02:0003F61E 1600            	 13263:     move.b  D0,D3
02:0003F620 5303            	 13264:     subq.b  #1,D3
02:0003F622 6A88            	 13265:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F624 4E75            	 13266:     rts
                            	 13267: 
