02:0003C50A 10302000        	  6589:     move.b  (A0,D2.W),D0
02:0003C50E 122C0002        	  6590:     move.b  ($0002,A4),D1
02:0003C512 E309            	  6591:     lsl.b  #1,D1   ; ASL $02
02:0003C514 19410002        	  6592:     move.b  D1,($0002,A4)
02:0003C518 122C0002        	  6593:     move.b  ($0002,A4),D1
02:0003C51C C200            	  6594:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C51E 6716            	  6595:     beq  _L_z04_Digdogger_Move_Down
