                            	 13076:     ; If cloud distance <> 0, then decrement it once every 8 frames.
                            	 13077:     ;
02:0003F49A 41EC0478        	 13078:     lea     ($0478,A4),A0
02:0003F49E 10302000        	 13079:     move.b  (A0,D2.W),D0
02:0003F4A2 6712            	 13080:     beq  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003F4A4 102C0015        	 13081:     move.b  ($0015,A4),D0
02:0003F4A8 02000007        	 13082:     andi.b #$07,D0
02:0003F4AC 6608            	 13083:     bne  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003F4AE 41EC0478        	 13084:     lea     ($0478,A4),A0
02:0003F4B2 53302000        	 13085:     subq.b  #1,(A0,D2.W)
                            	 13086:     even
                            	 13087: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 13088:     ; Draw the four clouds at diagonal corners.
                            	 13089:     ;
02:0003F4B6 610000B6        	 13090:     jsr     Ganon_GetCurCloudLeft
02:0003F4BA 610000BE        	 13091:     jsr     Ganon_GetCurCloudTop
02:0003F4BE 61A0            	 13092:     jsr     Ganon_DrawCloud
02:0003F4C0 610000B2        	 13093:     jsr     Ganon_GetCurCloudRight
02:0003F4C4 619A            	 13094:     jsr     Ganon_DrawCloud
02:0003F4C6 610000A6        	 13095:     jsr     Ganon_GetCurCloudLeft
02:0003F4CA 610000B4        	 13096:     jsr     Ganon_GetCurCloudBottom
02:0003F4CE 6190            	 13097:     jsr     Ganon_DrawCloud
02:0003F4D0 610000A2        	 13098:     jsr     Ganon_GetCurCloudRight
02:0003F4D4 618A            	 13099:     jsr     Ganon_DrawCloud
                            	 13100:     ; Draw the top and bottom clouds.
                            	 13101:     ;
02:0003F4D6 10342070        	 13102:     move.b  ($70,A4,D2.W),D0
02:0003F4DA 1880            	 13103:     move.b  D0,($0000,A4)
02:0003F4DC 6100009C        	 13104:     jsr     Ganon_GetCurCloudTop
02:0003F4E0 6100FF7E        	 13105:     jsr     Ganon_DrawCloud
02:0003F4E4 6100009A        	 13106:     jsr     Ganon_GetCurCloudBottom
02:0003F4E8 6100FF76        	 13107:     jsr     Ganon_DrawCloud
                            	 13108:     ; Draw the left and right clouds.
                            	 13109:     ;
02:0003F4EC 61000080        	 13110:     jsr     Ganon_GetCurCloudLeft
02:0003F4F0 41EC0084        	 13111:     lea     ($0084,A4),A0
02:0003F4F4 10302000        	 13112:     move.b  (A0,D2.W),D0
02:0003F4F8 19400001        	 13113:     move.b  D0,($0001,A4)
02:0003F4FC 6100FF62        	 13114:     jsr     Ganon_DrawCloud
02:0003F500 6172            	 13115:     jsr     Ganon_GetCurCloudRight
02:0003F502 6100FF5C        	 13116:     jsr     Ganon_DrawCloud
                            	 13117:     ; Save the object index.
                            	 13118:     ;
02:0003F506 102C0340        	 13119:     move.b  ($0340,A4),D0
02:0003F50A 1B00            	 13120:     move.b  D0,-(A5)  ; PHA
                            	 13121:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 13122:     ;
02:0003F50C 7402            	 13123:     moveq   #2,D2
                            	 13124:     even
                            	 13125: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F50E 19420340        	 13126:     move.b  D2,($0340,A4)
                            	 13127:     ; If object slot < 5 or = 7, then move every frame.
                            	 13128:     ; Else move 3 out of every 4 frames.
                            	 13129:     ;
                            	 13130:     ; This makes pieces spread out in somewhat of a circle,
                            	 13131:     ; by making the pieces at cardinal directions move at
                            	 13132:     ; full speed while the diagonal ones move a little slower.
                            	 13133:     ;
02:0003F512 0C020005        	 13134:     cmpi.b  #$05,D2
02:0003F516 6510            	 13135:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F518 0C020007        	 13136:     cmpi.b  #$07,D2
02:0003F51C 670A            	 13137:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F51E 102C0015        	 13138:     move.b  ($0015,A4),D0
02:0003F522 02000003        	 13139:     andi.b #$03,D0
02:0003F526 6704            	 13140:     beq  _anon_z04_164
                            	 13141:     even
                            	 13142: _L_z04_Ganon_DrawBurst_Move:
02:0003F528 6100DF60        	 13143:     jsr     BlueWizzrobe_Move
                            	 13144: _anon_z04_164:
02:0003F52C 4EB90004D250    	 13145:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 13146:     ; The frame counter will make the sprite flash.
                            	 13147:     ; The array has the horizontal and vertical flipping attributes.
                            	 13148:     ; Combine them into [03].
                            	 13149:     ;
02:0003F532 102C0015        	 13150:     move.b  ($0015,A4),D0
02:0003F536 02000003        	 13151:     andi.b #$03,D0
02:0003F53A 41F90003F40A    	 13152:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F540 12302000        	 13153:     move.b  (A0,D2.W),D1
02:0003F544 8001            	 13154:     or.b  D1,D0
02:0003F546 19400003        	 13155:     move.b  D0,($0003,A4)
02:0003F54A 41F90003F414    	 13156:     lea     (GanonBurstTiles).l,A0
02:0003F550 10302000        	 13157:     move.b  (A0,D2.W),D0
02:0003F554 4EB900031998    	 13158:     jsr     Anim_WriteSprite
                            	 13159:     ; Bottom of the loop.
                            	 13160:     ; Increment object slot while <= 9.
                            	 13161:     ;
02:0003F55A 5202            	 13162:     addq.b  #1,D2
02:0003F55C 0C02000A        	 13163:     cmpi.b  #$0A,D2
02:0003F560 65AC            	 13164:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 13165:     ; Restore the object index.
                            	 13166:     ;
02:0003F562 101D            	 13167:     move.b  (A5)+,D0  ; PLA
02:0003F564 19400340        	 13168:     move.b  D0,($0340,A4)
02:0003F568 0A3C0001        	 13169:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F56C 4E75            	 13170:     rts
                            	 13171: 
                            	 13172: ; Returns:
                            	 13173: ; [00]: X coordinate
                            	 13174: ;
                            	 13175:     even
                            	 13176: Ganon_GetCurCloudLeft:
