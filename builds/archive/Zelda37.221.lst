02:0004C6B8 0C00001B        	  5469:     cmpi.b  #$1B,D0
02:0004C6BC 6706            	  5470:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:0004C6BE 0C00001C        	  5471:     cmpi.b  #$1C,D0
02:0004C6C2 6614            	  5472:     bne  _L_z07_UpdateBoomerangOrFood_Draw
                            	  5473:     even
