                            	  6059:     even
                            	  6060: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  6061:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  6062:     ;
02:0003C12E 7004            	  6063:     moveq   #4,D0
02:0003C130 1880            	  6064:     move.b  D0,($0000,A4)
                            	  6065:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  6066:     ;
02:0003C132 7600            	  6067:     moveq   #0,D3
02:0003C134 0C020005        	  6068:     cmpi.b  #$05,D2
02:0003C138 6702            	  6069:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C13A 7605            	  6070:     moveq   #5,D3
                            	  6071:     even
                            	  6072: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  6073:     ; Copy old direction from a higher slot to the lower one;
                            	  6074:     ; and to the lower one's facing direction.
                            	  6075:     ;
02:0003C13C 41EC0382        	  6076:     lea     ($0382,A4),A0
02:0003C140 10303000        	  6077:     move.b  (A0,D3.W),D0
02:0003C144 41EC0381        	  6078:     lea     ($0381,A4),A0
02:0003C148 11803000        	  6079:     move.b  D0,(A0,D3.W)
02:0003C14C 41EC0099        	  6080:     lea     ($0099,A4),A0
02:0003C150 11803000        	  6081:     move.b  D0,(A0,D3.W)
                            	  6082:     ; Bottom of the loop.
