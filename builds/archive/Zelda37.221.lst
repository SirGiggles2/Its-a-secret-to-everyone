02:0003C2F8 023C00EE        	  6345:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2FC 41F90003C198    	  6346:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C302 12303000        	  6347:     move.b  (A0,D3.W),D1
02:0003C306 D101            	  6348:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C308 41EC0084        	  6349:     lea     ($0084,A4),A0
02:0003C30C 11802000        	  6350:     move.b  D0,(A0,D2.W)
                            	  6351:     ; Check the room boundary and object collisions in this temporary location.
