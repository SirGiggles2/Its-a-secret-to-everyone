02:00030BA2 4E75            	  4570:     rts
                            	  4571: 
                            	  4572: ; Params:
                            	  4573: ; Y: middle speed index (4)
                            	  4574: ; [03]: horizontal distance
                            	  4575: ; [04]: vertical distance
                            	  4576: ; [0A]: vertical direction
                            	  4577: ; [0B]: horizontal direction
                            	  4578: ;
                            	  4579: ; Returns:
                            	  4580: ; Y: speed index (0 to 8) for the angle
                            	  4581: ;
                            	  4582: ;
                            	  4583: ; TODO: call it speed index or angle?
                            	  4584: ; Store the middle speed index in [00]. It will be changed to the
                            	  4585: ; right speed index to use incrementally.
                            	  4586: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4587: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4588: ;
                            	  4589:     even
                            	  4590: _CalcDiagonalSpeedIndex:
02:00030BA4 1883            	  4591:     move.b  D3,($0000,A4)
                            	  4592:     ; Assuming horizontal distance >= vertical distance, the
                            	  4593:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4594:     ;
02:00030BA6 103C00FF        	  4595:     move.b  #$FF,D0
02:00030BAA 19400001        	  4596:     move.b  D0,($0001,A4)
                            	  4597:     ; TODO:
                            	  4598:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4599:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4600:     ;
                            	  4601:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4602:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4603:     ; of the farther distance faster.
                            	  4604:     ;
02:00030BAE 102C0003        	  4605:     move.b  ($0003,A4),D0
02:00030BB2 122C0004        	  4606:     move.b  ($0004,A4),D1
02:00030BB6 B001            	  4607:     cmp.b   D1,D0
02:00030BB8 6416            	  4608:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030BBA 1B00            	  4609:     move.b  D0,-(A5)  ; PHA
02:00030BBC 102C0004        	  4610:     move.b  ($0004,A4),D0
02:00030BC0 19400003        	  4611:     move.b  D0,($0003,A4)
02:00030BC4 101D            	  4612:     move.b  (A5)+,D0  ; PLA
02:00030BC6 19400004        	  4613:     move.b  D0,($0004,A4)
02:00030BCA 7001            	  4614:     moveq   #1,D0
02:00030BCC 19400001        	  4615:     move.b  D0,($0001,A4)
                            	  4616:     even
                            	  4617: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4618:     ; TODO: call it speed index or angle?
                            	  4619:     ; If the difference in distances is within 8 pixels,
                            	  4620:     ; return the speed index (angle) we have.
                            	  4621:     ;
02:00030BD0 102C0003        	  4622:     move.b  ($0003,A4),D0
02:00030BD4 003C0011        	  4623:     ori     #$11,CCR  ; SEC: set C+X
02:00030BD8 122C0004        	  4624:     move.b  ($0004,A4),D1
02:00030BDC 0A3C0010        	  4625:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030BE0 9101            	  4626:     subx.b  D1,D0   ; SBC $04
02:00030BE2 0A3C0010        	  4627:     eori    #$10,CCR  ; restore X = 6502 C
02:00030BE6 0C000008        	  4628:     cmpi.b  #$08,D0
02:00030BEA 6538            	  4629:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4630:     even
                            	  4631: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4632:     ; TODO: call it speed index or angle?
                            	  4633:     ; Otherwise, go to the next speed index (angle).
                            	  4634:     ;
02:00030BEC 1014            	  4635:     move.b  ($0000,A4),D0
02:00030BEE 023C00EE        	  4636:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030BF2 122C0001        	  4637:     move.b  ($0001,A4),D1
02:00030BF6 D101            	  4638:     addx.b  D1,D0   ; ADC $01
02:00030BF8 1880            	  4639:     move.b  D0,($0000,A4)
                            	  4640:     ; TODO: call it speed index or angle?
                            	  4641:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4642:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4643:     ;
02:00030BFA 6728            	  4644:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030BFC 0C000008        	  4645:     cmpi.b  #$08,D0
02:00030C00 6722            	  4646:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4647:     ; Subtract the lesser distance from the greater distance.
                            	  4648:     ; If they still haven't crossed, then we can turn more.
                            	  4649:     ;
02:00030C02 102C0003        	  4650:     move.b  ($0003,A4),D0
02:00030C06 003C0011        	  4651:     ori     #$11,CCR  ; SEC: set C+X
02:00030C0A 122C0004        	  4652:     move.b  ($0004,A4),D1
02:00030C0E 0A3C0010        	  4653:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030C12 9101            	  4654:     subx.b  D1,D0   ; SBC $04
02:00030C14 0A3C0010        	  4655:     eori    #$10,CCR  ; restore X = 6502 C
02:00030C18 19400003        	  4656:     move.b  D0,($0003,A4)
02:00030C1C 122C0004        	  4657:     move.b  ($0004,A4),D1
02:00030C20 B001            	  4658:     cmp.b   D1,D0
02:00030C22 64C8            	  4659:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4660:     even
