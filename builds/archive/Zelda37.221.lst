02:00041EF0 6602            	  3729:     bne.s  __far_z_05_0076
02:00041EF2 60CC            	  3730:     jmp  GoToModeAFromCave
                            	  3731: __far_z_05_0076:
02:00041EF4 4E75            	  3732:     rts
                            	  3733: 
                            	  3734: ; Params:
                            	  3735: ; [0F]: movement direction
                            	  3736: ;
                            	  3737: ; Returns:
                            	  3738: ; [0F]: movement direction or 0
                            	  3739: ;
                            	  3740: ;
                            	  3741: ; If the ladder's not in use, return.
                            	  3742: ;
                            	  3743:     even
                            	  3744: CheckLadder:
02:00041EF6 7400            	  3745:     moveq   #0,D2
02:00041EF8 142C0064        	  3746:     move.b  ($0064,A4),D2
02:00041EFC 670000BE        	  3747:     beq  _L_z05_CheckLadder_Exit
                            	  3748:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3749:     ;
02:00041F00 41EC00AC        	  3750:     lea     ($00AC,A4),A0
02:00041F04 10302000        	  3751:     move.b  (A0,D2.W),D0
02:00041F08 670000A6        	  3752:     beq  _L_z05_CheckLadder_StashLadder
                            	  3753:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3754:     ; between the ladder and Link.
                            	  3755:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3756:     ;
02:00041F0C 41EC0098        	  3757:     lea     ($0098,A4),A0
02:00041F10 10302000        	  3758:     move.b  (A0,D2.W),D0
02:00041F14 0200000C        	  3759:     andi.b #$0C,D0
02:00041F18 6734            	  3760:     beq  _anon_z05_85
02:00041F1A 102C0070        	  3761:     move.b  ($0070,A4),D0
02:00041F1E 12342070        	  3762:     move.b  ($70,A4,D2.W),D1
02:00041F22 B001            	  3763:     cmp.b   D1,D0
02:00041F24 6600008A        	  3764:     bne  _L_z05_CheckLadder_StashLadder
02:00041F28 102C0084        	  3765:     move.b  ($0084,A4),D0
02:00041F2C 023C00EE        	  3766:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F30 123C0003        	  3767:     move.b  #$03,D1
02:00041F34 D101            	  3768:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041F36 003C0011        	  3769:     ori     #$11,CCR  ; SEC: set C+X
02:00041F3A 41EC0084        	  3770:     lea     ($0084,A4),A0
02:00041F3E 12302000        	  3771:     move.b  (A0,D2.W),D1
02:00041F42 0A3C0010        	  3772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F46 9101            	  3773:     subx.b  D1,D0   ; SBC ObjY,X
02:00041F48 0A3C0010        	  3774:     eori    #$10,CCR  ; restore X = 6502 C
02:00041F4C 6030            	  3775:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3776: 
                            	  3777: _anon_z05_85:
                            	  3778:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3779:     ; between the ladder and Link.
                            	  3780:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3781:     ;
02:00041F4E 102C0084        	  3782:     move.b  ($0084,A4),D0
02:00041F52 023C00EE        	  3783:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041F56 123C0003        	  3784:     move.b  #$03,D1
02:00041F5A D101            	  3785:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041F5C 41EC0084        	  3786:     lea     ($0084,A4),A0
02:00041F60 12302000        	  3787:     move.b  (A0,D2.W),D1
02:00041F64 B001            	  3788:     cmp.b   D1,D0
02:00041F66 6648            	  3789:     bne  _L_z05_CheckLadder_StashLadder
02:00041F68 102C0070        	  3790:     move.b  ($0070,A4),D0
02:00041F6C 003C0011        	  3791:     ori     #$11,CCR  ; SEC: set C+X
02:00041F70 12342070        	  3792:     move.b  ($70,A4,D2.W),D1
02:00041F74 0A3C0010        	  3793:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F78 9101            	  3794:     subx.b  D1,D0   ; SBC ObjX,X
02:00041F7A 0A3C0010        	  3795:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3796:     even
                            	  3797: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3798:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3799:     ; If > $10, go put the ladder away.
                            	  3800:     ;
02:00041F7E 4EB900030B02    	  3801:     jsr     Abs
02:00041F84 1880            	  3802:     move.b  D0,($0000,A4)
02:00041F86 0C000010        	  3803:     cmpi.b  #$10,D0
02:00041F8A 6532            	  3804:     bcs  _L_z05_CheckLadder_SetState2
02:00041F8C 0C000010        	  3805:     cmpi.b  #$10,D0
02:00041F90 661E            	  3806:     bne  _L_z05_CheckLadder_StashLadder
                            	  3807:     ; Distance = $10. If player's not facing in the same direction as
                            	  3808:     ; the ladder, go put away the ladder.
                            	  3809:     ;
02:00041F92 102C0098        	  3810:     move.b  ($0098,A4),D0
02:00041F96 41EC0098        	  3811:     lea     ($0098,A4),A0
02:00041F9A 12302000        	  3812:     move.b  (A0,D2.W),D1
02:00041F9E B001            	  3813:     cmp.b   D1,D0
02:00041FA0 660E            	  3814:     bne  _L_z05_CheckLadder_StashLadder
                            	  3815:     ; Distance = $10, and player's facing in the same direction.
                            	  3816:     ;
                            	  3817:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3818:     ; ladder and had not stepped onto it yet.
                            	  3819:     ; Go handle movement on it, but don't change state yet.
                            	  3820:     ;
                            	  3821:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3822:     ; off of the ladder. So the ladder should be put away. In this
                            	  3823:     ; case, fall thru.
                            	  3824:     ;
02:00041FA2 41EC00AC        	  3825:     lea     ($00AC,A4),A0
02:00041FA6 10302000        	  3826:     move.b  (A0,D2.W),D0
02:00041FAA 0C000001        	  3827:     cmpi.b  #$01,D0
02:00041FAE 6718            	  3828:     beq  _L_z05_CheckLadder_HandleInput
                            	  3829:     even
                            	  3830: _L_z05_CheckLadder_StashLadder:
                            	  3831:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3832:     ;
02:00041FB0 7000            	  3833:     moveq   #0,D0
02:00041FB2 19400064        	  3834:     move.b  D0,($0064,A4)
02:00041FB6 4EB90004DA34    	  3835:     jsr     DestroyMonster
                            	  3836:     even
                            	  3837: _L_z05_CheckLadder_Exit:
02:00041FBC 4E75            	  3838:     rts
                            	  3839: 
                            	  3840:     even
                            	  3841: _L_z05_CheckLadder_SetState2:
                            	  3842:     ;  Set state 2, because we're on the ladder.
                            	  3843:     ;
02:00041FBE 7002            	  3844:     moveq   #2,D0
02:00041FC0 41EC00AC        	  3845:     lea     ($00AC,A4),A0
02:00041FC4 11802000        	  3846:     move.b  D0,(A0,D2.W)
                            	  3847:     even
                            	  3848: _L_z05_CheckLadder_HandleInput:
                            	  3849:     ; If input direction = 0, go draw and reset moving direction.
                            	  3850:     ;
02:00041FC8 102C03F8        	  3851:     move.b  ($03F8,A4),D0
02:00041FCC 67000086        	  3852:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3853:     ; Input direction <> 0. The player intends to move.
                            	  3854:     ; So, see if we need to override the moving direction.
                            	  3855:     ;
                            	  3856:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3857:     ; go draw and set moving direction to Link's direction.
                            	  3858:     ;
                            	  3859:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3860:     ; been blocked by the water.
                            	  3861:     ;
                            	  3862:     ; Or, Link already passed over the point right over the ladder
                            	  3863:     ; and was allowed to move onto the tiles after the ladder.
                            	  3864:     ;
02:00041FD0 102C0098        	  3865:     move.b  ($0098,A4),D0
02:00041FD4 7600            	  3866:     moveq   #0,D3
02:00041FD6 1614            	  3867:     move.b  ($0000,A4),D3
02:00041FD8 670C            	  3868:     beq  _anon_z05_86
02:00041FDA 41EC0098        	  3869:     lea     ($0098,A4),A0
02:00041FDE 12302000        	  3870:     move.b  (A0,D2.W),D1
02:00041FE2 B001            	  3871:     cmp.b   D1,D0
02:00041FE4 676E            	  3872:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3873: _anon_z05_86:
                            	  3874:     ; Distance = 0, or facing different directions.
                            	  3875:     ;
                            	  3876:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3877:     ; then go draw and keep moving.
                            	  3878:     ;
                            	  3879:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3880:     ;
                            	  3881:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3882:     ; to move onto the tiles after the ladder.
                            	  3883:     ;
                            	  3884:     ; Note that if Link is not moving, then this test will fail,
                            	  3885:     ; and case (D) will catch it.
                            	  3886:     ;
02:00041FE6 41EC0098        	  3887:     lea     ($0098,A4),A0
02:00041FEA 10302000        	  3888:     move.b  (A0,D2.W),D0
02:00041FEE 122C000F        	  3889:     move.b  ($000F,A4),D1
02:00041FF2 B001            	  3890:     cmp.b   D1,D0
02:00041FF4 675E            	  3891:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3892:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3893:     ; then go draw and move in ladder's direction.
                            	  3894:     ;
                            	  3895:     ; You can always step off the ladder where you came from.
                            	  3896:     ;
02:00041FF6 4EB900030AFE    	  3897:     jsr     GetOppositeDir
02:00041FFC 122C0098        	  3898:     move.b  ($0098,A4),D1
02:00042000 B001            	  3899:     cmp.b   D1,D0
02:00042002 6750            	  3900:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3901:     ; D. If opposite of ladder's direction <> down,
                            	  3902:     ; or input direction <> up,
                            	  3903:     ; then go reset moving direction, and draw.
                            	  3904:     ;
                            	  3905:     ; This will catch all cases of Link facing perpendicular to
                            	  3906:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3907:     ; ladder direction is up and input direction is up (E).
                            	  3908:     ;
02:00042004 0C000004        	  3909:     cmpi.b  #$04,D0
02:00042008 6648            	  3910:     bne  _anon_z05_87
02:0004200A 102C03F8        	  3911:     move.b  ($03F8,A4),D0
02:0004200E 0C000008        	  3912:     cmpi.b  #$08,D0
02:00042012 663E            	  3913:     bne  _anon_z05_87
                            	  3914:     ; E. The ladder's direction is up and input direction is up.
                            	  3915:     ;
                            	  3916:     ; An earlier call to check tile collision would have blocked
                            	  3917:     ; movement, because the tile under Link's top half is a water tile.
                            	  3918:     ; But because Link is squarely on the ladder, we really have
                            	  3919:     ; to check the tile above that one.
                            	  3920:     ;
                            	  3921:     ; Set moving direction to input direction (up) and switch X to
                            	  3922:     ; the player's slot for the purpose of checking tile collision below.
                            	  3923:     ; Based on that, we'll set moving direction according to walkability.
                            	  3924:     ;
02:00042014 6158            	  3925:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3926:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3927:     ;
02:00042016 102C0084        	  3928:     move.b  ($0084,A4),D0
02:0004201A 1B00            	  3929:     move.b  D0,-(A5)  ; PHA
02:0004201C 003C0011        	  3930:     ori     #$11,CCR  ; SEC: set C+X
02:00042020 123C0008        	  3931:     move.b  #$08,D1
02:00042024 0A3C0010        	  3932:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042028 9101            	  3933:     subx.b  D1,D0   ; SBC #$08
02:0004202A 0A3C0010        	  3934:     eori    #$10,CCR  ; restore X = 6502 C
02:0004202E 19400084        	  3935:     move.b  D0,($0084,A4)
02:00042032 4EB90004B9AC    	  3936:     jsr     GetCollidingTileMoving
02:00042038 101D            	  3937:     move.b  (A5)+,D0  ; PLA
02:0004203A 19400084        	  3938:     move.b  D0,($0084,A4)
                            	  3939:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3940:     ; direction as the input direction (in a roundabout way).
                            	  3941:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3942:     ;
02:0004203E 102C000F        	  3943:     move.b  ($000F,A4),D0
02:00042042 7600            	  3944:     moveq   #0,D3
02:00042044 162C049E        	  3945:     move.b  ($049E,A4),D3
02:00042048 122C034A        	  3946:     move.b  ($034A,A4),D1
02:0004204C B601            	  3947:     cmp.b   D1,D3
02:0004204E 6500FF78        	  3948:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3949: _anon_z05_87:
                            	  3950:     ; Set A to reset moving direction in [0F].
                            	  3951:     ;
02:00042052 7000            	  3952:     moveq   #0,D0
                            	  3953:     even
                            	  3954: _L_z05_CheckLadder_DrawLadder:
                            	  3955:     ; Draw the ladder.
                            	  3956:     ;
02:00042054 1B00            	  3957:     move.b  D0,-(A5)  ; PHA
02:00042056 7400            	  3958:     moveq   #0,D2
02:00042058 142C0064        	  3959:     move.b  ($0064,A4),D2
02:0004205C 4EB90004D250    	  3960:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00042062 760C            	  3961:     moveq   #12,D3
02:00042064 7000            	  3962:     moveq   #0,D0
02:00042066 4EB9000318A0    	  3963:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0004206C 101D            	  3964:     move.b  (A5)+,D0  ; PLA
                            	  3965: ; Params:
                            	  3966: ; A: direction
                            	  3967: ;
                            	  3968: ; Returns:
                            	  3969: ; [0F]: direction
                            	  3970: ;
                            	  3971:     even
                            	  3972: SetMovingDirAndSwitchToPlayerSlot:
02:0004206E 1940000F        	  3973:     move.b  D0,($000F,A4)
02:00042072 7400            	  3974:     moveq   #0,D2
02:00042074 4E75            	  3975:     rts
