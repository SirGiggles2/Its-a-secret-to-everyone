                            	 12273: Lamnola_Move:
                            	 12274:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12275:     ;
                            	 12276:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12277:     ;
                            	 12278:     ; Start with a mask of $A1 in [02]:
                            	 12279:     ; - low nibble represents the right direction
                            	 12280:     ; - high nibble is used to set or clear carry as we go along
                            	 12281:     ;
02:0003EF06 103C00A1        	 12282:     move.b  #$A1,D0
02:0003EF0A 19400002        	 12283:     move.b  D0,($0002,A4)
                            	 12284:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12285:     ;
02:0003EF0E 41EC0098        	 12286:     lea     ($0098,A4),A0
02:0003EF12 10302000        	 12287:     move.b  (A0,D2.W),D0
02:0003EF16 122C0002        	 12288:     move.b  ($0002,A4),D1
02:0003EF1A C200            	 12289:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF1C 6712            	 12290:     beq  _L_z04_Lamnola_Move_Left
02:0003EF1E 10342070        	 12291:     move.b  ($70,A4,D2.W),D0
