                            	  8337: __far_z_05_0112:
                            	  8338:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8339:     ; and represents the current row of the submenu being processed.
                            	  8340:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8341:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  8342:     ;
                            	  8343:     ; If the bottom bit is set, go prepare the full black row.
                            	  8344:     ;
02:00044F3E E208            	  8345:     lsr.b  #1,D0   ; LSR A
02:00044F40 7600            	  8346:     moveq   #0,D3
02:00044F42 1600            	  8347:     move.b  D0,D3
02:00044F44 6402            	  8348:     bcc.s  __far_z_05_0113
02:00044F46 60B6            	  8349:     jmp  PrepFullBlackRow
