                            	  5835: CheckState30:
                            	  5836:     ; If major state <> $30, go check other states.
                            	  5837:     ;
02:0004C930 0C000030        	  5838:     cmpi.b  #$30,D0
02:0004C934 6656            	  5839:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5840:     ; State $3x. Slow down.
                            	  5841:     ;
                            	  5842:     ; Reset grid offset for movement.
                            	  5843:     ;
02:0004C936 7000            	  5844:     moveq   #0,D0
02:0004C938 41EC0394        	  5845:     lea     ($0394,A4),A0
02:0004C93C 11802000        	  5846:     move.b  D0,(A0,D2.W)
                            	  5847:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
