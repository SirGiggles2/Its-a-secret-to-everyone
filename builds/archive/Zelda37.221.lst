                            	   441: _anon_z05_3:
                            	   442:     ; If Start was pressed, then hide all sprites except
                            	   443:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   444:     ;
02:000402C0 102C00F8        	   445:     move.b  ($00F8,A4),D0
02:000402C4 02000010        	   446:     andi.b #$10,D0
02:000402C8 6606            	   447:     bne.s  __far_z_05_0003
02:000402CA 4EF90002D01E    	   448:     jmp  Exit
