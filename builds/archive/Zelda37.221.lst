                            	 10247:     ; Draw the left legs.
                            	 10248:     ;
02:0003E00E 7600            	 10249:     moveq   #0,D3
                            	 10250: ; Params:
                            	 10251: ; Y: side: 0 for left, 1 for right
                            	 10252: ;
                            	 10253: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10254: ; store the sprite's X in [00].
                            	 10255: ;
                            	 10256:     even
                            	 10257: Gohma_DrawLegsOneSide:
02:0003E010 10342070        	 10258:     move.b  ($70,A4,D2.W),D0
02:0003E014 023C00EE        	 10259:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E018 41F90003DFEE    	 10260:     lea     (GohmaLegOffsetsX).l,A0
02:0003E01E 12303000        	 10261:     move.b  (A0,D3.W),D1
02:0003E022 D101            	 10262:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003E024 1880            	 10263:     move.b  D0,($0000,A4)
                            	 10264:     ; The object's Y is the sprite's.
                            	 10265:     ;
02:0003E026 41EC0084        	 10266:     lea     ($0084,A4),A0
02:0003E02A 10302000        	 10267:     move.b  (A0,D2.W),D0
02:0003E02E 19400001        	 10268:     move.b  D0,($0001,A4)
02:0003E032 612A            	 10269:     jsr     Gohma_SetSpriteAttributes
                            	 10270:     ; There are only two frame images for legs: left and right.
                            	 10271:     ; There are two animation frames. They are animated as follows:
                            	 10272:     ;
                            	 10273:     ; Frame 0:
                            	 10274:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10275:     ; horizontal flipping = frame number = 0
                            	 10276:     ; 
                            	 10277:     ; Frame 1:
                            	 10278:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10279:     ; horizontal flipping = frame number = 1
                            	 10280:     ;
02:0003E034 4EB90004D222    	 10281:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E03A 1003            	 10282:     move.b  D3,D0
02:0003E03C 023C00EE        	 10283:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E040 41EC03E4        	 10284:     lea     ($03E4,A4),A0
02:0003E044 12302000        	 10285:     move.b  (A0,D2.W),D1
02:0003E048 D101            	 10286:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E04A 02000001        	 10287:     andi.b #$01,D0
02:0003E04E 023C00EE        	 10288:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E052 123C0004        	 10289:     move.b  #$04,D1
02:0003E056 D101            	 10290:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E058 4EF90003169C    	 10291:     jmp     DrawObjectNotMirrored
                            	 10292: 
                            	 10293: ; Returns:
