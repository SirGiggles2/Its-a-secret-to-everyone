                            	  6534: Digdogger_Move:
                            	  6535:     ; This calculation is the same one used in Manhandla to
                            	  6536:     ; manifest the fractional speed over several frames.
                            	  6537:     ;
                            	  6538:     ; To summarize, the formula is:
                            	  6539:     ;
                            	  6540:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6541:     ;
                            	  6542:     ;   SA := SA + (SL AND $E0)
                            	  6543:     ;   [03] := SH + carry
                            	  6544:     ;
                            	  6545:     ; See 04:A28E Manhandla_Move.
                            	  6546:     ;
02:0003C4A8 41EC041F        	  6547:     lea     ($041F,A4),A0
02:0003C4AC 10302000        	  6548:     move.b  (A0,D2.W),D0
02:0003C4B0 020000E0        	  6549:     andi.b #$E0,D0
02:0003C4B4 023C00EE        	  6550:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4B8 41EC0412        	  6551:     lea     ($0412,A4),A0
02:0003C4BC 12302000        	  6552:     move.b  (A0,D2.W),D1
02:0003C4C0 D101            	  6553:     addx.b  D1,D0   ; ADC $0412,X
02:0003C4C2 41EC0412        	  6554:     lea     ($0412,A4),A0
02:0003C4C6 11802000        	  6555:     move.b  D0,(A0,D2.W)
                            	  6556:     ; Assign (high speed byte + carry) to [03].
                            	  6557:     ;
02:0003C4CA 41EC042C        	  6558:     lea     ($042C,A4),A0
02:0003C4CE 10302000        	  6559:     move.b  (A0,D2.W),D0
02:0003C4D2 123C0000        	  6560:     move.b  #$00,D1
02:0003C4D6 D101            	  6561:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C4D8 19400003        	  6562:     move.b  D0,($0003,A4)
                            	  6563:     ; Change coordinates by the speed amount/offset in [03]
                            	  6564:     ; according to the direction.
                            	  6565:     ;
                            	  6566:     ; Start with a mask of $A1 in [02]:
                            	  6567:     ; - low nibble represents the right direction
                            	  6568:     ; - high nibble is used to set or clear carry as we go along
                            	  6569:     ;
02:0003C4DC 103C00A1        	  6570:     move.b  #$A1,D0
02:0003C4E0 19400002        	  6571:     move.b  D0,($0002,A4)
                            	  6572:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6573:     ;
02:0003C4E4 41EC0098        	  6574:     lea     ($0098,A4),A0
02:0003C4E8 10302000        	  6575:     move.b  (A0,D2.W),D0
02:0003C4EC 122C0002        	  6576:     move.b  ($0002,A4),D1
02:0003C4F0 C200            	  6577:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C4F2 6712            	  6578:     beq  _L_z04_Digdogger_Move_Left
02:0003C4F4 10342070        	  6579:     move.b  ($70,A4,D2.W),D0
02:0003C4F8 023C00EE        	  6580:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4FC 122C0003        	  6581:     move.b  ($0003,A4),D1
02:0003C500 D101            	  6582:     addx.b  D1,D0   ; ADC $03
02:0003C502 19802070        	  6583:     move.b  D0,($70,A4,D2.W)
                            	  6584:     even
                            	  6585: _L_z04_Digdogger_Move_Left:
                            	  6586:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6587:     ;
