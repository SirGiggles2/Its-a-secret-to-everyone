                            	  5957: _anon_z04_81:
                            	  5958:     ; Chase while flying, as usual.
                            	  5959:     ;
02:0003C0C8 61003C78        	  5960:     jsr     Flyer_Chase
                            	  5961:     ; If timer has not expired, then
                            	  5962:     ; go see if it's time to propagate direction changes down the chain.
                            	  5963:     ;
02:0003C0CC 10342028        	  5964:     move.b  ($28,A4,D2.W),D0
02:0003C0D0 6702            	  5965:     beq.s  __far_z_04_0045
02:0003C0D2 6032            	  5966:     jmp  Moldorm_PropagateDirs
                            	  5967: __far_z_04_0045:
                            	  5968:     even
                            	  5969: Moldorm_ChangeFlyingState:
                            	  5970:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5971:     ;
02:0003C0D4 61000096        	  5972:     jsr     Flyer_MoldormDecideState
02:0003C0D8 7010            	  5973:     moveq   #16,D0
02:0003C0DA 19802028        	  5974:     move.b  D0,($28,A4,D2.W)
                            	  5975:     ; If the next lower slot's direction <> 0, then
                            	  5976:     ; go propagate direction changes down the chain.
                            	  5977:     ;
                            	  5978:     ; But you had to have propagated directions once for the
                            	  5979:     ; next lower direction to be set. How does it happen?
                            	  5980:     ;
                            	  5981:     ; Within a flyer state, the flying routines turn the flyer
                            	  5982:     ; and set the object timer to $10 several times. After any of
                            	  5983:     ; those times will the test succeed.
                            	  5984:     ;
                            	  5985:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5986:     ; in this block to set the timer to $10, and try to propagate
                            	  5987:     ; directions.
                            	  5988:     ;
                            	  5989:     ; But this is also the case the first time here.
                            	  5990:     ;
                            	  5991:     ; So, I believe that the point of this test is to delay moving
                            	  5992:     ; the lower (not head) segments when starting out.
                            	  5993:     ;
02:0003C0DE 41EC0097        	  5994:     lea     ($0097,A4),A0
02:0003C0E2 10302000        	  5995:     move.b  (A0,D2.W),D0
02:0003C0E6 6702            	  5996:     beq.s  __far_z_04_0046
02:0003C0E8 601C            	  5997:     jmp  Moldorm_PropagateDirs
                            	  5998: __far_z_04_0046:
02:0003C0EA 4E75            	  5999:     rts
                            	  6000: 
                            	  6001:     even
                            	  6002: Moldorm_Wander:
                            	  6003:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  6004:     ; Only the head controls the movement direction.
                            	  6005:     ;
02:0003C0EC 0C020005        	  6006:     cmpi.b  #$05,D2
02:0003C0F0 6708            	  6007:     beq  _anon_z04_82
02:0003C0F2 0C02000A        	  6008:     cmpi.b  #$0A,D2
02:0003C0F6 6702            	  6009:     beq.s  __far_z_04_0047
02:0003C0F8 6070            	  6010:     jmp  L1156B_Exit
                            	  6011: __far_z_04_0047:
                            	  6012: _anon_z04_82:
                            	  6013:     ; Turn randomly while flying, as usual.
                            	  6014:     ;
02:0003C0FA 61003D24        	  6015:     jsr     Flyer_Wander
                            	  6016:     ; After every turn, the common flyer routines set timer to $10.
                            	  6017:     ; This can be used as a signal for moldorm to propagate
                            	  6018:     ; direction changes down the chain.
                            	  6019:     ;
                            	  6020:     ; Between each turn, timer <> $10.
                            	  6021:     ;
                            	  6022:     ; At the end of the delay after the last turn, timer = 0.
                            	  6023:     ; This is a signal that that flying state ended, and a new one
                            	  6024:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  6025:     ; we can propagate direction changes again; and start
                            	  6026:     ; a new flying interval by setting timer to $10. This will make
                            	  6027:     ; the next flying state delay that amount of time before turning
                            	  6028:     ; the first time.
                            	  6029:     ;
                            	  6030:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  6031:     ; arm the timer again, and shift directions down the chain.
                            	  6032:     ;
02:0003C0FE 10342028        	  6033:     move.b  ($28,A4,D2.W),D0
02:0003C102 6602            	  6034:     bne.s  __far_z_04_0048
02:0003C104 60CE            	  6035:     jmp  Moldorm_ChangeFlyingState
                            	  6036: __far_z_04_0048:
                            	  6037:     even
                            	  6038: Moldorm_PropagateDirs:
                            	  6039:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  6040:     ;
02:0003C106 10342028        	  6041:     move.b  ($28,A4,D2.W),D0
02:0003C10A 0C000010        	  6042:     cmpi.b  #$10,D0
02:0003C10E 6702            	  6043:     beq.s  __far_z_04_0049
02:0003C110 6058            	  6044:     jmp  L1156B_Exit
