                            	 10226: GohmaLegOffsetsX:
02:0003DFEE F0              	 10227:     dc.b    $F0, $10
02:0003DFEF 10
                            	 10228: 
                            	 10229: ; Params:
                            	 10230: ; A: eye frame image
                            	 10231: ;
                            	 10232: ; Draw the eye with the frame image passed in.
                            	 10233: ;
                            	 10234:     even
                            	 10235: Gohma_AnimateAndDraw:
02:0003DFF0 1B00            	 10236:     move.b  D0,-(A5)  ; PHA
02:0003DFF2 4EB90004D250    	 10237:     jsr     Anim_FetchObjPosForSpriteDescriptor
