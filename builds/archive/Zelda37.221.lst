                            	  5865: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5866:     ; The door attribute (DA) has been mapped to a
                            	  5867:     ; provisional door face value (PF) in %A as follows:
                            	  5868:     ;
                            	  5869:     ; DA PF Meaning
                            	  5870:     ; -------------
                            	  5871:     ; 0  4  open
                            	  5872:     ; 1  1  wall
                            	  5873:     ; 2  2  false wall
                            	  5874:     ; 3  3  false wall 2
                            	  5875:     ; 4  8  bombable
                            	  5876:     ; 5  5  key
                            	  5877:     ; 6  6  key 2
                            	  5878:     ; 7  7  shutter
                            	  5879:     ;
                            	  5880:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5881:     ; has been cleared, if the type was "open" or any wall.
                            	  5882:     ;
                            	  5883:     ;
                            	  5884:     ; Save the provisional face.
02:000438C0 1B00            	  5885:     move.b  D0,-(A5)  ; PHA
                            	  5886:     ; If the current direction points to a door that has been opened,
                            	  5887:     ; then see if we need to set door flags.
                            	  5888:     ;
02:000438C2 102C00EE        	  5889:     move.b  ($00EE,A4),D0
02:000438C6 122C0002        	  5890:     move.b  ($0002,A4),D1
02:000438CA C001            	  5891:     and.b  D1,D0
02:000438CC 7400            	  5892:     moveq   #0,D2
02:000438CE 1400            	  5893:     move.b  D0,D2
02:000438D0 101D            	  5894:     move.b  (A5)+,D0  ; PLA
02:000438D2 122C0002        	  5895:     move.b  ($0002,A4),D1
02:000438D6 B401            	  5896:     cmp.b   D1,D2
02:000438D8 6624            	  5897:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5898:     ; The current direction points to a door that has been opened.
                            	  5899:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5900:     ;
                            	  5901:     ;
                            	  5902:     ; Save provisional door face in Y register.
02:000438DA 7600            	  5903:     moveq   #0,D3
02:000438DC 1600            	  5904:     move.b  D0,D3
02:000438DE 101D            	  5905:     move.b  (A5)+,D0  ; PLA
02:000438E0 1B00            	  5906:     move.b  D0,-(A5)  ; PHA
02:000438E2 7400            	  5907:     moveq   #0,D2
02:000438E4 1400            	  5908:     move.b  D0,D2
02:000438E6 1003            	  5909:     move.b  D3,D0
                            	  5910:     ; If provisional door face is not for a shutter, then
                            	  5911:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5912:     ;
                            	  5913:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5914:     ;
02:000438E8 0C000007        	  5915:     cmpi.b  #$07,D0
02:000438EC 670E            	  5916:     beq  _anon_z05_111
02:000438EE 1B00            	  5917:     move.b  D0,-(A5)  ; PHA
02:000438F0 6100DD74        	  5918:     jsr     SetDoorFlag
02:000438F4 101D            	  5919:     move.b  (A5)+,D0  ; PLA
                            	  5920:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5921:     ; then go make it 9 (open "bombable").
                            	  5922:     ; Else make it 4 (open "door").
                            	  5923:     ;
02:000438F6 0C000008        	  5924:     cmpi.b  #$08,D0
02:000438FA 67A4            	  5925:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5926: _anon_z05_111:
02:000438FC 7004            	  5927:     moveq   #4,D0
                            	  5928:     even
                            	  5929: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5930:     ; For opened doors, the provisional door face has become:
                            	  5931:     ;
                            	  5932:     ; DA PF Meaning
                            	  5933:     ; -------------
                            	  5934:     ; 0  4  open
                            	  5935:     ; 1  1  wall
                            	  5936:     ; 2  2  false wall
                            	  5937:     ; 3  3  false wall 2
                            	  5938:     ; 4  9  bombable
                            	  5939:     ; 5  4  key
                            	  5940:     ; 6  4  key 2
                            	  5941:     ; 7  4  shutter
                            	  5942:     ;
                            	  5943:     ;
                            	  5944:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5945:     ;
02:000438FE 7400            	  5946:     moveq   #0,D2
02:00043900 142C0006        	  5947:     move.b  ($0006,A4),D2
02:00043904 6712            	  5948:     beq  _anon_z05_112
02:00043906 7400            	  5949:     moveq   #0,D2
02:00043908 142C000B        	  5950:     move.b  ($000B,A4),D2
02:0004390C 1B00            	  5951:     move.b  D0,-(A5)  ; PHA
02:0004390E 6100FCC8        	  5952:     jsr     FindDoorAttrByDoorBit
02:00043912 61001D0C        	  5953:     jsr     CalcOpenDoorwayMask
02:00043916 101D            	  5954:     move.b  (A5)+,D0  ; PLA
                            	  5955: _anon_z05_112:
                            	  5956:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5957:     ; because the visible door face is already a wall.
                            	  5958:     ;
02:00043918 0C000004        	  5959:     cmpi.b  #$04,D0
02:0004391C 650000DC        	  5960:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5961:     ; For all other provisional face values, calculate:
                            	  5962:     ; door face := provisional face - 3
02:00043920 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:00043924 123C0003        	  5964:     move.b  #$03,D1
02:00043928 0A3C0010        	  5965:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004392C 9101            	  5966:     subx.b  D1,D0   ; SBC #$03
02:0004392E 0A3C0010        	  5967:     eori    #$10,CCR  ; restore X = 6502 C
02:00043932 7600            	  5968:     moveq   #0,D3
02:00043934 1600            	  5969:     move.b  D0,D3
                            	  5970:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5971:     ; subtract one.
                            	  5972:     ;
02:00043936 0C030003        	  5973:     cmpi.b  #$03,D3
02:0004393A 6502            	  5974:     bcs  _anon_z05_113
02:0004393C 5303            	  5975:     subq.b  #1,D3
                            	  5976: _anon_z05_113:
                            	  5977:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5978:     ;
                            	  5979:     ; DT DFC DFO Meaning
                            	  5980:     ; ------------------
                            	  5981:     ; 0  1   1   open
                            	  5982:     ; 4  4   5   bombable
                            	  5983:     ; 5  2   1   key
                            	  5984:     ; 6  2   1   key 2
                            	  5985:     ; 7  3   1   shutter
                            	  5986:     ;
                            	  5987:     ;
                            	  5988:     ; Get the direction index.
02:0004393E 101D            	  5989:     move.b  (A5)+,D0  ; PLA
02:00043940 1B00            	  5990:     move.b  D0,-(A5)  ; PHA
02:00043942 610000D0        	  5991:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5992:     ; If handling the second half, then offset to the second half
                            	  5993:     ; of the tiles.
                            	  5994:     ;
02:00043946 102C0006        	  5995:     move.b  ($0006,A4),D0
02:0004394A 6618            	  5996:     bne  _anon_z05_114
02:0004394C 41F900043862    	  5997:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:00043952 10302000        	  5998:     move.b  (A0,D2.W),D0
02:00043956 4EB900030F54    	  5999:     jsr     AddToInt16At0
02:0004395C 7006            	  6000:     moveq   #6,D0
02:0004395E 4EB900030F5C    	  6001:     jsr     AddToInt16At2
                            	  6002: _anon_z05_114:
                            	  6003:     ; Fix Y at 0 for copying source tiles to destination.
                            	  6004:     ; Pointers will be incremented instead of Y.
02:00043964 7600            	  6005:     moveq   #0,D3
02:00043966 41F900043866    	  6006:     lea     (DirIndexToDoorColumnCount).l,A0
02:0004396C 10302000        	  6007:     move.b  (A0,D2.W),D0
02:00043970 19400005        	  6008:     move.b  D0,($0005,A4)
                            	  6009:     even
                            	  6010: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  6011:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  6012:     ;
02:00043974 101D            	  6013:     move.b  (A5)+,D0  ; PLA
02:00043976 1B00            	  6014:     move.b  D0,-(A5)  ; PHA
02:00043978 7400            	  6015:     moveq   #0,D2
02:0004397A 1400            	  6016:     move.b  D0,D2
                            	  6017:     ; For each row (2 or 3) in the door, indexed by X,
                            	  6018:     ; starting from highest index down to 0:
                            	  6019:     ;
02:0004397C 41F90004386A    	  6020:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043982 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00043986 7400            	  6022:     moveq   #0,D2
02:00043988 1400            	  6023:     move.b  D0,D2
                            	  6024:     even
                            	  6025: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:0004398A 122C0002        	  6026:     move.b  ($02,A4),D1   ; ptr lo
02:0004398E 182C0003        	  6027:     move.b  ($03,A4),D4  ; ptr hi
02:00043992 024100FF        	  6028:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043996 E14C            	  6029:     lsl.w   #8,D4
02:00043998 8841            	  6030:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004399A 48C4            	  6031:     ext.l   D4
02:0004399C D8BC00FF0000    	  6032:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000439A2 2044            	  6033:     movea.l D4,A0
02:000439A4 10303000        	  6034:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000439A8 1214            	  6035:     move.b  ($00,A4),D1   ; ptr lo
02:000439AA 182C0001        	  6036:     move.b  ($01,A4),D4  ; ptr hi
02:000439AE 024100FF        	  6037:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439B2 E14C            	  6038:     lsl.w   #8,D4
02:000439B4 8841            	  6039:     or.w    D1,D4
02:000439B6 48C4            	  6040:     ext.l   D4
02:000439B8 D8BC00FF0000    	  6041:     add.l   #NES_RAM,D4
02:000439BE 2044            	  6042:     movea.l D4,A0
02:000439C0 11803000        	  6043:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000439C4 4EB900030F58    	  6044:     jsr     Add1ToInt16At2
02:000439CA 41F90004385E    	  6045:     lea     (NextDoorTileOffsets).l,A0
02:000439D0 10302000        	  6046:     move.b  (A0,D2.W),D0
02:000439D4 4EB900030F54    	  6047:     jsr     AddToInt16At0
                            	  6048:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  6049:     ; go 1 more tile down, to start the next column at the right place.
                            	  6050:     ; We have to compensate for the fact that E/W doors are 
                            	  6051:     ; shorter vertically than N/S doors.
02:000439DA 4A02            	  6052:     cmpi.b  #$00,D2
02:000439DC 6610            	  6053:     bne  _anon_z05_115
02:000439DE 101D            	  6054:     move.b  (A5)+,D0  ; PLA
02:000439E0 1B00            	  6055:     move.b  D0,-(A5)  ; PHA
02:000439E2 0C000002        	  6056:     cmpi.b  #$02,D0
02:000439E6 6406            	  6057:     bcc  _anon_z05_115
02:000439E8 4EB900030F52    	  6058:     jsr     Add1ToInt16At0
                            	  6059: _anon_z05_115:
                            	  6060:     ; Bottom of the tile row copying loop.
                            	  6061:     ; Decrement the row index.
                            	  6062:     ;
02:000439EE 5302            	  6063:     subq.b  #1,D2
02:000439F0 6A98            	  6064:     bpl  _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile
                            	  6065:     ; Bottom of the column copying loop.
                            	  6066:     ; Decrease the column counter.
                            	  6067:     ;
02:000439F2 532C0005        	  6068:     subq.b  #1,($0005,A4)
02:000439F6 6600FF7C        	  6069:     bne  _L_z05_L_LayOutDoors_LoopHalves_LoopColumn
                            	  6070:     even
                            	  6071: _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf:
                            	  6072:     ; Bottom of the door halves loop.
                            	  6073:     ;
02:000439FA 101D            	  6074:     move.b  (A5)+,D0  ; PLA
02:000439FC 7400            	  6075:     moveq   #0,D2
02:000439FE 1400            	  6076:     move.b  D0,D2
02:00043A00 532C0006        	  6077:     subq.b  #1,($0006,A4)
