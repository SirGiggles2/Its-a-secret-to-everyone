02:0004CB2E 122C0004        	  6113:     move.b  ($0004,A4),D1
02:0004CB32 D101            	  6114:     addx.b  D1,D0   ; ADC $04
02:0004CB34 19400004        	  6115:     move.b  D0,($0004,A4)
