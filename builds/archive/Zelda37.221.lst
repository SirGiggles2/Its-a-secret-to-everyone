02:0003C544 19410002        	  6610:     move.b  D1,($0002,A4)
02:0003C548 122C0002        	  6611:     move.b  ($0002,A4),D1
02:0003C54C C200            	  6612:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
