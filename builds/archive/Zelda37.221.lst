02:0004C4AA 4EF9000318AE    	  5165:     jmp     Anim_WriteItemSprites
                            	  5166: 
                            	  5167: ; Params:
                            	  5168: ; X: shot object index
                            	  5169: ;
                            	  5170: ; If the object is a sword shot, go spread out the shot.
                            	  5171: ;
                            	  5172:     even
                            	  5173: HandleShotBlocked:
02:0004C4B0 41EC00AC        	  5174:     lea     ($00AC,A4),A0
02:0004C4B4 10302000        	  5175:     move.b  (A0,D2.W),D0
02:0004C4B8 E308            	  5176:     lsl.b  #1,D0   ; ASL A
02:0004C4BA 6504            	  5177:     bcs.s  __far_z_07_0078
02:0004C4BC 60000082        	  5178:     jmp  SetShotSpreadingState
                            	  5179: __far_z_07_0078:
                            	  5180:     ; This is a magic shot.
                            	  5181:     ;
                            	  5182:     ; If missing the magic book, go deactivate the shot object.
                            	  5183:     ;
02:0004C4C0 102C0661        	  5184:     move.b  ($0661,A4),D0
02:0004C4C4 6602            	  5185:     bne.s  __far_z_07_0079
02:0004C4C6 6072            	  5186:     jmp  DeactivateShot
                            	  5187: __far_z_07_0079:
                            	  5188:     ; Try to activate a fire object. Temporarily mark the candle
                            	  5189:     ; unused, so it only has to depend on having an empty slot.
                            	  5190:     ;
                            	  5191:     ; If successful, Link's state will have been changed to "using item".
                            	  5192:     ; But we don't want that in this case.
                            	  5193:     ;
                            	  5194:     ; For both these reasons, save state and restore it afterward.
                            	  5195:     ;
02:0004C4C8 102C00AC        	  5196:     move.b  ($00AC,A4),D0
02:0004C4CC 1B00            	  5197:     move.b  D0,-(A5)  ; PHA
02:0004C4CE 102C0513        	  5198:     move.b  ($0513,A4),D0
02:0004C4D2 1B00            	  5199:     move.b  D0,-(A5)  ; PHA
02:0004C4D4 7000            	  5200:     moveq   #0,D0
02:0004C4D6 19400513        	  5201:     move.b  D0,($0513,A4)
02:0004C4DA 4EB900030D48    	  5202:     jsr     WieldCandle
02:0004C4E0 101D            	  5203:     move.b  (A5)+,D0  ; PLA
02:0004C4E2 19400513        	  5204:     move.b  D0,($0513,A4)
02:0004C4E6 101D            	  5205:     move.b  (A5)+,D0  ; PLA
02:0004C4E8 194000AC        	  5206:     move.b  D0,($00AC,A4)
                            	  5207:     ; State $21 means that a moving fire was just made.
                            	  5208:     ;
                            	  5209:     ; If it's any another value, then we didn't find an empty slot
                            	  5210:     ; to make a fire. In this case, all that's left to do is to go
                            	  5211:     ; deactivate the shot object.
                            	  5212:     ;
02:0004C4EC 41EC00AC        	  5213:     lea     ($00AC,A4),A0
02:0004C4F0 10302000        	  5214:     move.b  (A0,D2.W),D0
02:0004C4F4 0C000021        	  5215:     cmpi.b  #$21,D0
02:0004C4F8 6702            	  5216:     beq.s  __far_z_07_0080
02:0004C4FA 6038            	  5217:     jmp  DeactivateLinkShot
                            	  5218: __far_z_07_0080:
                            	  5219:     ; Make state $22 for a standing fire.
                            	  5220:     ;
02:0004C4FC 41EC00AC        	  5221:     lea     ($00AC,A4),A0
02:0004C500 52302000        	  5222:     addq.b  #1,(A0,D2.W)
                            	  5223:     ; Copy the shot's position and direction to the fire.
                            	  5224:     ;
02:0004C504 760E            	  5225:     moveq   #14,D3
02:0004C506 10343070        	  5226:     move.b  ($70,A4,D3.W),D0
02:0004C50A 19802070        	  5227:     move.b  D0,($70,A4,D2.W)
02:0004C50E 41EC0084        	  5228:     lea     ($0084,A4),A0
02:0004C512 10303000        	  5229:     move.b  (A0,D3.W),D0
02:0004C516 41EC0084        	  5230:     lea     ($0084,A4),A0
02:0004C51A 11802000        	  5231:     move.b  D0,(A0,D2.W)
02:0004C51E 41EC0098        	  5232:     lea     ($0098,A4),A0
02:0004C522 10303000        	  5233:     move.b  (A0,D3.W),D0
02:0004C526 41EC0098        	  5234:     lea     ($0098,A4),A0
02:0004C52A 11802000        	  5235:     move.b  D0,(A0,D2.W)
                            	  5236:     ; The fire lasts $4F frames.
                            	  5237:     ; Deactivate the shot.
                            	  5238:     ;
02:0004C52E 704F            	  5239:     moveq   #79,D0
02:0004C530 19802028        	  5240:     move.b  D0,($28,A4,D2.W)
                            	  5241:     even
                            	  5242: DeactivateLinkShot:
02:0004C534 4EF90002BC8E    	  5243:     jmp     c_deactivate_link_shot
                            	  5244: 
                            	  5245: DeactivateShot:
02:0004C53A 4EF90002BC7E    	  5246:     jmp     c_deactivate_shot
