02:00031BE2 19400004        	  6713:     move.b  D0,($0004,A4)
02:00031BE6 102C0084        	  6714:     move.b  ($0084,A4),D0
02:00031BEA 023C00EE        	  6715:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031BEE 123C0008        	  6716:     move.b  #$08,D1
02:00031BF2 D101            	  6717:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031BF4 19400005        	  6718:     move.b  D0,($0005,A4)
