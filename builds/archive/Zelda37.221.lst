                            	 14291: TurnTowardsPlayer8:
                            	 14292:     ; Build a direction in [00] towards the player.
                            	 14293:     ;
                            	 14294:     ; First, calculate a horizontal component:
                            	 14295:     ;
                            	 14296:     ; If   observed player X = object X, [00] := 0 (none)
                            	 14297:     ; elif observed player X > object X, [00] := 1 (right)
                            	 14298:     ; else                               [00] := 2 (left)
                            	 14299:     ;
02:0003FD62 7600            	 14300:     moveq   #0,D3
02:0003FD64 1883            	 14301:     move.b  D3,($0000,A4)
02:0003FD66 5203            	 14302:     addq.b  #1,D3
02:0003FD68 102C0061        	 14303:     move.b  ($0061,A4),D0
