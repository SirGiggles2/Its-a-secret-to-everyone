                            	   320: _anon_z05_2:
                            	   321:     ; Move position markers and advance nametable scrolling;
                            	   322:     ; so that we scroll down 3 pixels.
                            	   323:     ;
02:000401D8 7003            	   324:     moveq   #3,D0
02:000401DA 6100015C        	   325:     jsr     MovePositionMarkers
02:000401DE 102C00FC        	   326:     move.b  ($00FC,A4),D0
02:000401E2 003C0011        	   327:     ori     #$11,CCR  ; SEC: set C+X
02:000401E6 123C0003        	   328:     move.b  #$03,D1
02:000401EA 0A3C0010        	   329:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000401EE 9101            	   330:     subx.b  D1,D0   ; SBC #$03
02:000401F0 0A3C0010        	   331:     eori    #$10,CCR  ; restore X = 6502 C
02:000401F4 194000FC        	   332:     move.b  D0,($00FC,A4)
                            	   333:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   334:     ;
02:000401F8 0C000041        	   335:     cmpi.b  #$41,D0
02:000401FC 66000090        	   336:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   337:     ; VScroll reached $41.
