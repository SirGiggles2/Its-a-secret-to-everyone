                            	  6048:     ; If deferred bounce direction <> 0, then
                            	  6049:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  6050:     ;
02:0003C112 41EC03BC        	  6051:     lea     ($03BC,A4),A0
02:0003C116 10302000        	  6052:     move.b  (A0,D2.W),D0
02:0003C11A 6712            	  6053:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C11C 41EC0098        	  6054:     lea     ($0098,A4),A0
02:0003C120 11802000        	  6055:     move.b  D0,(A0,D2.W)
02:0003C124 7000            	  6056:     moveq   #0,D0
02:0003C126 41EC03BC        	  6057:     lea     ($03BC,A4),A0
