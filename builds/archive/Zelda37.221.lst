02:000302AC 52302000        	  3212:     addq.b  #1,(A0,D2.W)
02:000302B0 7070            	  3213:     moveq   #112,D0
02:000302B2 41EC03BC        	  3214:     lea     ($03BC,A4),A0
02:000302B6 11802000        	  3215:     move.b  D0,(A0,D2.W)
                            	  3216:     even
