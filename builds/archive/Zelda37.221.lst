02:0002E17C 7010            	   808:     moveq   #16,D0
02:0002E17E 19400604        	   809:     move.b  D0,($0604,A4)
                            	   810:     ; If the high 2 bits of character element = 0, then return.
                            	   811:     ;
02:0002E182 1214            	   812:     move.b  ($00,A4),D1   ; ptr lo
02:0002E184 182C0001        	   813:     move.b  ($01,A4),D4  ; ptr hi
02:0002E188 024100FF        	   814:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E18C E14C            	   815:     lsl.w   #8,D4
02:0002E18E 8841            	   816:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E190 48C4            	   817:     ext.l   D4
