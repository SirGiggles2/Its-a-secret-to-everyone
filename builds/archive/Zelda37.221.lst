02:000369A6 2044            	  5308:     movea.l D4,A0
02:000369A8 10303000        	  5309:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000369AC 41EC0305        	  5310:     lea     ($0305,A4),A0
02:000369B0 11802000        	  5311:     move.b  D0,(A0,D2.W)
