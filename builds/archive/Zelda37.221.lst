02:0004B0CC 4EB90003143E    	  2353:     jsr     MapScreenPosToPpuAddr
02:0004B0D2 7400            	  2354:     moveq   #0,D2
02:0004B0D4 142C0301        	  2355:     move.b  ($0301,A4),D2
                            	  2356:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2357:     ;
                            	  2358:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2359:     ; In total, 11 bytes will be written.
                            	  2360:     ;
                            	  2361:     ; First, write the high byte of PPU address in each record.
                            	  2362:     ;
02:0004B0D8 1014            	  2363:     move.b  ($0000,A4),D0
02:0004B0DA 41EC0302        	  2364:     lea     ($0302,A4),A0
02:0004B0DE 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:0004B0E2 41EC0307        	  2366:     lea     ($0307,A4),A0
02:0004B0E6 11802000        	  2367:     move.b  D0,(A0,D2.W)
                            	  2368:     ; Write the low address in the first record. In the second record,
                            	  2369:     ; write (low address + 1).
                            	  2370:     ;
02:0004B0EA 102C0001        	  2371:     move.b  ($0001,A4),D0
02:0004B0EE 41EC0303        	  2372:     lea     ($0303,A4),A0
02:0004B0F2 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004B0F6 41EC0308        	  2374:     lea     ($0308,A4),A0
02:0004B0FA 11802000        	  2375:     move.b  D0,(A0,D2.W)
02:0004B0FE 41EC0308        	  2376:     lea     ($0308,A4),A0
02:0004B102 52302000        	  2377:     addq.b  #1,(A0,D2.W)
                            	  2378:     ; Write the first tile twice in each record. Patch them later.
                            	  2379:     ;
02:0004B106 102C0005        	  2380:     move.b  ($0005,A4),D0
02:0004B10A 41EC0305        	  2381:     lea     ($0305,A4),A0
02:0004B10E 11802000        	  2382:     move.b  D0,(A0,D2.W)
02:0004B112 41EC0306        	  2383:     lea     ($0306,A4),A0
02:0004B116 11802000        	  2384:     move.b  D0,(A0,D2.W)
02:0004B11A 41EC030A        	  2385:     lea     ($030A,A4),A0
02:0004B11E 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:0004B122 41EC030B        	  2387:     lea     ($030B,A4),A0
02:0004B126 11802000        	  2388:     move.b  D0,(A0,D2.W)
                            	  2389:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2390:     ; Add 1 more to the second byte in each record.
                            	  2391:     ; Here is an example result of this manipulation:
                            	  2392:     ;   record 1: $70, $71
                            	  2393:     ;   record 2: $72, $73
                            	  2394:     ;
02:0004B12A 0C000046        	  2395:     cmpi.b  #$46,D0
02:0004B12E 6530            	  2396:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B130 0C0000F3        	  2397:     cmpi.b  #$F3,D0
02:0004B134 642A            	  2398:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004B136 023C00EE        	  2399:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B13A 123C0002        	  2400:     move.b  #$02,D1
02:0004B13E D101            	  2401:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B140 41EC030A        	  2402:     lea     ($030A,A4),A0
02:0004B144 11802000        	  2403:     move.b  D0,(A0,D2.W)
02:0004B148 41EC030B        	  2404:     lea     ($030B,A4),A0
02:0004B14C 11802000        	  2405:     move.b  D0,(A0,D2.W)
02:0004B150 41EC0306        	  2406:     lea     ($0306,A4),A0
02:0004B154 52302000        	  2407:     addq.b  #1,(A0,D2.W)
02:0004B158 41EC030B        	  2408:     lea     ($030B,A4),A0
02:0004B15C 52302000        	  2409:     addq.b  #1,(A0,D2.W)
