                            	  1940:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1941:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1942:     ; - layout $23: pattern 1: 2 statues
                            	  1943:     ; - layout $24: pattern 0: 4 statues
                            	  1944:     ;
02:0003A422 4EB90004B0AA    	  1945:     jsr     GetUniqueRoomId
02:0003A428 7601            	  1946:     moveq   #1,D3
                            	  1947: _anon_z04_30:
