02:0003C026 41EC0485        	  5877:     lea     ($0485,A4),A0
02:0003C02A 11802000        	  5878:     move.b  D0,(A0,D2.W)
02:0003C02E 6100062A        	  5879:     jsr     CheckBossHitReaction
                            	  5880:     ; Look for the tail segment, starting from the low end
                            	  5881:     ; of the chain that this dead segment belongs to.
