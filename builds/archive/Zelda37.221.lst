02:00045044 6700008C        	  8525:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8526:     ; In UW. There are two input directions, and they're both walkable.
                            	  8527:     ;
                            	  8528:     ; Normally, turn to the direction that's perpendicular to object
                            	  8529:     ; direction. But keep going straight after that, while diagonal
                            	  8530:     ; input is held.
                            	  8531:     ;
                            	  8532:     ; Handle special cases for doors.
                            	  8533:     ;
                            	  8534:     ;
                            	  8535:     ; 1. Link at horizontal doors.
                            	  8536:     ;
                            	  8537:     ; If Link's X = $20 or $D0 then
                            	  8538:     ;   If Link's Y = $85 and facing down then
                            	  8539:     ;     Go set object direction and input direction to object
                            	  8540:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8541:     ;     Link_GoStraightWhenDiagInput.
