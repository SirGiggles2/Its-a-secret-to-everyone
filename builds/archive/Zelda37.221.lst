02:0003EF2C 19802070        	 12295:     move.b  D0,($70,A4,D2.W)
                            	 12296:     even
                            	 12297: _L_z04_Lamnola_Move_Left:
                            	 12298:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 12299:     ;
02:0003EF30 41EC0098        	 12300:     lea     ($0098,A4),A0
02:0003EF34 10302000        	 12301:     move.b  (A0,D2.W),D0
02:0003EF38 122C0002        	 12302:     move.b  ($0002,A4),D1
02:0003EF3C E309            	 12303:     lsl.b  #1,D1   ; ASL $02
02:0003EF3E 19410002        	 12304:     move.b  D1,($0002,A4)
02:0003EF42 122C0002        	 12305:     move.b  ($0002,A4),D1
02:0003EF46 C200            	 12306:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF48 6716            	 12307:     beq  _L_z04_Lamnola_Move_Down
02:0003EF4A 10342070        	 12308:     move.b  ($70,A4,D2.W),D0
02:0003EF4E 122C04E6        	 12309:     move.b  ($04E6,A4),D1
02:0003EF52 0A3C0010        	 12310:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EF56 9101            	 12311:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EF58 0A3C0010        	 12312:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF5C 19802070        	 12313:     move.b  D0,($70,A4,D2.W)
                            	 12314:     even
