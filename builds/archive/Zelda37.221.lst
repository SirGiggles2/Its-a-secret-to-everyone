                            	  6019: AnimateBoomerangAndCheckCollision:
                            	  6020:     ; Decrement animation counter; and when it reaches 0:
                            	  6021:     ; 1. arm it again for 2 frames
                            	  6022:     ; 2. advance the minor state within a cycle of 8
                            	  6023:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  6024:     ;
02:0004CA76 41EC03D0        	  6025:     lea     ($03D0,A4),A0
02:0004CA7A 53302000        	  6026:     subq.b  #1,(A0,D2.W)
