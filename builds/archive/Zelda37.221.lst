                            	   805: .tlb_no_up:
02:0004DC20 08010002        	   806:     btst    #2,D1                   ; Down (bit 2)
02:0004DC24 6710            	   807:     beq.s   .tlb_no_down
02:0004DC26 102C0084        	   808:     move.b  ($0084,A4),D0
02:0004DC2A 0C0000D0        	   809:     cmpi.b  #$D0,D0
02:0004DC2E 6406            	   810:     bcc.s   .tlb_no_down
