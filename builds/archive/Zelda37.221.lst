                            	  7985: _L_z04_UpdatePolsVoice_SetState1:
                            	  7986:     ; If already in state 1, then go draw and check collisions.
                            	  7987:     ;
02:0003CEE6 41EC00AC        	  7988:     lea     ($00AC,A4),A0
02:0003CEEA 10302000        	  7989:     move.b  (A0,D2.W),D0
02:0003CEEE 6702            	  7990:     beq.s  __far_z_04_0074
