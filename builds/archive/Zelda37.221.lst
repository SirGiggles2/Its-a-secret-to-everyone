02:0003A3CE 0200000F        	  1882:     andi.b #$0F,D0
02:0003A3D2 023C00EE        	  1883:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3D6 6608            	  1884:     bne  _L_z04_Gel_MoveSplitting_Exit
02:0003A3D8 41EC0394        	  1885:     lea     ($0394,A4),A0
