02:0003CE32 8001            	  7888:     or.b  D1,D0
02:0003CE34 660000AE        	  7889:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7890:     ; Every odd screen frame, go straight to drawing
