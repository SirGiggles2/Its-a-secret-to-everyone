02:0003A2B6 10342070        	  1734:     move.b  ($70,A4,D2.W),D0
02:0003A2BA 023C00EE        	  1735:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2BE 123C0008        	  1736:     move.b  #$08,D1
02:0003A2C2 D101            	  1737:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A2C4 020000F0        	  1738:     andi.b #$F0,D0
02:0003A2C8 19802070        	  1739:     move.b  D0,($70,A4,D2.W)
                            	  1740:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
