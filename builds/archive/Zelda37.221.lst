02:0004C6C8 19400061        	  5476:     move.b  D0,($0061,A4)
02:0004C6CC 41EC0084        	  5477:     lea     ($0084,A4),A0
02:0004C6D0 10302000        	  5478:     move.b  (A0,D2.W),D0
02:0004C6D4 19400062        	  5479:     move.b  D0,($0062,A4)
                            	  5480:     even
