                            	  7198: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7199:     ; Advance the substate.
                            	  7200:     ;
02:0003C9A8 41EC042C        	  7201:     lea     ($042C,A4),A0
02:0003C9AC 52302000        	  7202:     addq.b  #1,(A0,D2.W)
                            	  7203:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7204:     ;
02:0003C9B0 41EC042C        	  7205:     lea     ($042C,A4),A0
02:0003C9B4 10302000        	  7206:     move.b  (A0,D2.W),D0
