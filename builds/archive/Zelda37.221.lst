                            	  6909: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6910:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6911:     ;   full heart=4 partial heart=$70
                            	  6912:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6913:     ; But the method here yields $3EF, because partial heart is
                            	  6914:     ; considered full when = $FF instead of $100.
                            	  6915:     ;
02:00031D56 102C000E        	  6916:     move.b  ($000E,A4),D0
02:00031D5A 003C0011        	  6917:     ori     #$11,CCR  ; SEC: set C+X
02:00031D5E 122C0670        	  6918:     move.b  ($0670,A4),D1
02:00031D62 0A3C0010        	  6919:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031D66 9101            	  6920:     subx.b  D1,D0   ; SBC HeartPartial
02:00031D68 0A3C0010        	  6921:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D6C 1940000E        	  6922:     move.b  D0,($000E,A4)
02:00031D70 102C066F        	  6923:     move.b  ($066F,A4),D0
02:00031D74 0200000F        	  6924:     andi.b #$0F,D0
02:00031D78 6710            	  6925:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031D7A 532C066F        	  6926:     subq.b  #1,($066F,A4)
02:00031D7E 103C00FF        	  6927:     move.b  #$FF,D0
02:00031D82 19400670        	  6928:     move.b  D0,($0670,A4)
02:00031D86 6600FF6E        	  6929:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6930:     even
                            	  6931: _L_z01_Link_BeHarmed_HandleDied:
                            	  6932:     ; Link died.
                            	  6933:     ;
                            	  6934:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6935:     ; Make Link face down.
                            	  6936:     ; Go to mode $11.
                            	  6937:     ;
02:00031D8A 102C066F        	  6938:     move.b  ($066F,A4),D0
02:00031D8E 020000F0        	  6939:     andi.b #$F0,D0
02:00031D92 1940066F        	  6940:     move.b  D0,($066F,A4)
02:00031D96 4EB90004B61E    	  6941:     jsr     EndGameMode
02:00031D9C 19400670        	  6942:     move.b  D0,($0670,A4)
02:00031DA0 194000AC        	  6943:     move.b  D0,($00AC,A4)
02:00031DA4 7011            	  6944:     moveq   #17,D0
02:00031DA6 19400012        	  6945:     move.b  D0,($0012,A4)
02:00031DAA 7004            	  6946:     moveq   #4,D0
02:00031DAC 19400098        	  6947:     move.b  D0,($0098,A4)
                            	  6948: _anon_z01_87:
02:00031DB0 4E75            	  6949:     rts
                            	  6950: 
                            	  6951: ; Params:
                            	  6952: ; X: monster slot
                            	  6953: ; Y: weapon slot
                            	  6954: ; [02]: monster mid X
                            	  6955: ; [03]: monster mid Y
                            	  6956: ;
                            	  6957: ; Returns:
                            	  6958: ; [00]: weapon slot
                            	  6959: ;
                            	  6960: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6961: ;
                            	  6962:     even
                            	  6963: CheckMonsterBoomerangOrFoodCollision:
02:00031DB2 41EC00AC        	  6964:     lea     ($00AC,A4),A0
02:00031DB6 10303000        	  6965:     move.b  (A0,D3.W),D0
02:00031DBA E308            	  6966:     lsl.b  #1,D0   ; ASL A
02:00031DBC 65F2            	  6967:     bcs  _anon_z01_87
02:00031DBE 1883            	  6968:     move.b  D3,($0000,A4)
                            	  6969:     ; Set boomerang damage type (2) in [09].
                            	  6970:     ;
02:00031DC0 7002            	  6971:     moveq   #2,D0
02:00031DC2 19400009        	  6972:     move.b  D0,($0009,A4)
                            	  6973:     ; Set collision threshold $A in both axes.
                            	  6974:     ;
02:00031DC6 700A            	  6975:     moveq   #10,D0
02:00031DC8 1940000D        	  6976:     move.b  D0,($000D,A4)
02:00031DCC 1940000E        	  6977:     move.b  D0,($000E,A4)
                            	  6978:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6979:     ;
02:00031DD0 10343070        	  6980:     move.b  ($70,A4,D3.W),D0
02:00031DD4 023C00EE        	  6981:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031DD8 123C0004        	  6982:     move.b  #$04,D1
02:00031DDC D101            	  6983:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00031DDE 19400004        	  6984:     move.b  D0,($0004,A4)
                            	  6985:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6986:     ;
02:00031DE2 41EC0084        	  6987:     lea     ($0084,A4),A0
02:00031DE6 10303000        	  6988:     move.b  (A0,D3.W),D0
02:00031DEA 023C00EE        	  6989:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031DEE 123C0008        	  6990:     move.b  #$08,D1
02:00031DF2 D101            	  6991:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6992: ; Params:
                            	  6993: ; A: weapon object mid Y
                            	  6994: ; X: monster object slot
                            	  6995: ; Y: weapon object slot
                            	  6996: ; [00]: weapon object slot
                            	  6997: ; [02]: monster object mid X
                            	  6998: ; [03]: monster object mid Y
                            	  6999: ; [04]: weapon object mid X
                            	  7000: ; [07]: damage points
                            	  7001: ; [09]: damage type
                            	  7002: ; [0D]: horizontal threshold
                            	  7003: ; [0E]: vertical threshold
                            	  7004: ;
                            	  7005: ; Returns:
                            	  7006: ; [06]: 1 if objects collide
                            	  7007: ;
                            	  7008:     even
                            	  7009: CheckMonsterWeaponCollision:
02:00031DF4 19400005        	  7010:     move.b  D0,($0005,A4)
                            	  7011:     ; Reset [06] for no collision.
                            	  7012:     ;
02:00031DF8 7000            	  7013:     moveq   #0,D0
02:00031DFA 19400006        	  7014:     move.b  D0,($0006,A4)
                            	  7015:     ; If the weapon's not active (state = 0), then return.
                            	  7016:     ;
02:00031DFE 7600            	  7017:     moveq   #0,D3
02:00031E00 1614            	  7018:     move.b  ($0000,A4),D3
02:00031E02 41EC00AC        	  7019:     lea     ($00AC,A4),A0
02:00031E06 10303000        	  7020:     move.b  (A0,D3.W),D0
02:00031E0A 6604            	  7021:     bne.s  __far_z_01_0071
02:00031E0C 6000010C        	  7022:     jmp  L74D8_Exit
                            	  7023: __far_z_01_0071:
                            	  7024:     ; If the objects do not collide, then return.
