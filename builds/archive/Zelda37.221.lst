                            	  9792:     ;
                            	  9793:     ; Change the base segment's object type to the dead dummy.
                            	  9794:     ; Immediately set metastate to $10, instead of waiting for
                            	  9795:     ; the dead dummy object's update routine to do it.
                            	  9796:     ; Also set its timer to $10.
                            	  9797:     ;
02:0003DC9C 61001B5C        	  9798:     jsr     PlayBossDeathCry
02:0003DCA0 705D            	  9799:     moveq   #93,D0
02:0003DCA2 19400354        	  9800:     move.b  D0,($0354,A4)
02:0003DCA6 7010            	  9801:     moveq   #16,D0
02:0003DCA8 1940040A        	  9802:     move.b  D0,($040A,A4)
02:0003DCAC 1940002D        	  9803:     move.b  D0,($002D,A4)
                            	  9804:     even
