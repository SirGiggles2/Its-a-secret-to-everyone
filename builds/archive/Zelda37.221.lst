02:0003B03E 023C00EE        	  3678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B042 41EC03E4        	  3679:     lea     ($03E4,A4),A0
02:0003B046 12302000        	  3680:     move.b  (A0,D2.W),D1
02:0003B04A D101            	  3681:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B04C 1B00            	  3682:     move.b  D0,-(A5)  ; PHA
                            	  3683:     ; If facing vertically, go draw mirrored.
                            	  3684:     ;
02:0003B04E 41EC0098        	  3685:     lea     ($0098,A4),A0
02:0003B052 10302000        	  3686:     move.b  (A0,D2.W),D0
02:0003B056 0200000C        	  3687:     andi.b #$0C,D0
02:0003B05A 660E            	  3688:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3689:     ; Else draw not mirrored.
                            	  3690:     ;
02:0003B05C 101D            	  3691:     move.b  (A5)+,D0  ; PLA
02:0003B05E 4EB90003169C    	  3692:     jsr     DrawObjectNotMirrored
