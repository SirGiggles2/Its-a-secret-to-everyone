02:0003E708 60B0            	 11186:     jmp  Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions
                            	 11187: __far_z_04_0107:
                            	 11188:     ; The segment is not a head nor bottom. So, we can use a
                            	 11189:     ; standard routine to draw. It uses one of the rolling sprites
                            	 11190:     ; that is drawn under Link and the heads.
                            	 11191:     ;
02:0003E70A 4EB900031992    	 11192:     jsr     Anim_WriteLevelPaletteSprite
                            	 11193:     even
                            	 11194: Gleeok_CheckCollisions:
                            	 11195:     ; If this segment is not the head nor the bottom of the neck,
                            	 11196:     ; then loop again to process the next segment.
                            	 11197:     ;
                            	 11198:     ; This kind of segment is only drawn, and is not checked
                            	 11199:     ; for object collisions.
                            	 11200:     ;
02:0003E710 0C020005        	 11201:     cmpi.b  #$05,D2
02:0003E714 670A            	 11202:     beq  _anon_z04_141
02:0003E716 0C020001        	 11203:     cmpi.b  #$01,D2
02:0003E71A 6704            	 11204:     beq  _anon_z04_141
02:0003E71C 6000010C        	 11205:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11206: 
                            	 11207: _anon_z04_141:
02:0003E720 4EB900031A18    	 11208:     jsr     CheckMonsterCollisions
                            	 11209:     ; If this segment was harmed, then set the writhing counter,
                            	 11210:     ; and the animation counter to its lower value.
                            	 11211:     ;
02:0003E726 41EC00C0        	 11212:     lea     ($00C0,A4),A0
02:0003E72A 10302000        	 11213:     move.b  (A0,D2.W),D0
02:0003E72E 670A            	 11214:     beq  _anon_z04_142
02:0003E730 7006            	 11215:     moveq   #6,D0
02:0003E732 194004E6        	 11216:     move.b  D0,($04E6,A4)
02:0003E736 19400510        	 11217:     move.b  D0,($0510,A4)
                            	 11218: _anon_z04_142:
02:0003E73A 4EB90004BBD4    	 11219:     jsr     ResetShoveInfo
                            	 11220:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 11221:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 11222:     ;
02:0003E740 0C020001        	 11223:     cmpi.b  #$01,D2
02:0003E744 670000DE        	 11224:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E748 6100B01E        	 11225:     jsr     PlayBossHitCryIfNeeded
                            	 11226:     ; If this neck has not died, then go loop again.
                            	 11227:     ;
02:0003E74C 41EC0405        	 11228:     lea     ($0405,A4),A0
02:0003E750 10302000        	 11229:     move.b  (A0,D2.W),D0
02:0003E754 670000D4        	 11230:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 11231:     ; This neck died. So, prepare to make a flying head.
                            	 11232:     ;
02:0003E758 7060            	 11233:     moveq   #96,D0
02:0003E75A 41EC0485        	 11234:     lea     ($0485,A4),A0
02:0003E75E 11802000        	 11235:     move.b  D0,(A0,D2.W)
02:0003E762 1002            	 11236:     move.b  D2,D0
02:0003E764 1B00            	 11237:     move.b  D0,-(A5)  ; PHA
                            	 11238:     ; If the segment is not a head, then skip making a flying head.
                            	 11239:     ;
                            	 11240:     ; TODO:
                            	 11241:     ; But how can we get here in this case, since earlier branches
                            	 11242:     ; would have been taken to skip all this for all other segments?
                            	 11243:     ;
02:0003E766 0C020005        	 11244:     cmpi.b  #$05,D2
02:0003E76A 663C            	 11245:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 11246:     ; The flying head will go in slot (neck index + 7).
                            	 11247:     ; Switch the X register to it.
                            	 11248:     ;
02:0003E76C 102C04D7        	 11249:     move.b  ($04D7,A4),D0
02:0003E770 023C00EE        	 11250:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E774 123C0007        	 11251:     move.b  #$07,D1
02:0003E778 D101            	 11252:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E77A 7400            	 11253:     moveq   #0,D2
02:0003E77C 1400            	 11254:     move.b  D0,D2
                            	 11255:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 11256:     ;
02:0003E77E 103C00FF        	 11257:     move.b  #$FF,D0
02:0003E782 41EC0492        	 11258:     lea     ($0492,A4),A0
02:0003E786 11802000        	 11259:     move.b  D0,(A0,D2.W)
                            	 11260:     ; Copy the original head's coordinates to it.
                            	 11261:     ;
02:0003E78A 102C0075        	 11262:     move.b  ($0075,A4),D0
02:0003E78E 19802070        	 11263:     move.b  D0,($70,A4,D2.W)
02:0003E792 102C0089        	 11264:     move.b  ($0089,A4),D0
02:0003E796 41EC0084        	 11265:     lea     ($0084,A4),A0
02:0003E79A 11802000        	 11266:     move.b  D0,(A0,D2.W)
                            	 11267:     ; Set object type $46 (flying head).
                            	 11268:     ;
02:0003E79E 7046            	 11269:     moveq   #70,D0
02:0003E7A0 41EC034F        	 11270:     lea     ($034F,A4),A0
02:0003E7A4 11802000        	 11271:     move.b  D0,(A0,D2.W)
                            	 11272:     even
                            	 11273: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E7A8 101D            	 11274:     move.b  (A5)+,D0  ; PLA
02:0003E7AA 7400            	 11275:     moveq   #0,D2
02:0003E7AC 1400            	 11276:     move.b  D0,D2
                            	 11277:     ; Hide the original head's sprite, and the base segment's sprite.
                            	 11278:     ;
02:0003E7AE 102C04D7        	 11279:     move.b  ($04D7,A4),D0
02:0003E7B2 E308            	 11280:     lsl.b  #1,D0   ; ASL A
02:0003E7B4 E308            	 11281:     lsl.b  #1,D0   ; ASL A
02:0003E7B6 E308            	 11282:     lsl.b  #1,D0   ; ASL A
02:0003E7B8 7600            	 11283:     moveq   #0,D3
02:0003E7BA 1600            	 11284:     move.b  D0,D3
02:0003E7BC 103C00F8        	 11285:     move.b  #$F8,D0
02:0003E7C0 41EC0200        	 11286:     lea     ($0200,A4),A0
02:0003E7C4 11803000        	 11287:     move.b  D0,(A0,D3.W)
02:0003E7C8 41EC0220        	 11288:     lea     ($0220,A4),A0
02:0003E7CC 11803000        	 11289:     move.b  D0,(A0,D3.W)
                            	 11290:     ; Add the bit for this neck to the dead neck mask.
                            	 11291:     ; Copy it to [00].
                            	 11292:     ;
02:0003E7D0 7600            	 11293:     moveq   #0,D3
02:0003E7D2 162C04D7        	 11294:     move.b  ($04D7,A4),D3
02:0003E7D6 41F90004ADE0    	 11295:     lea     (LevelMasks).l,A0
02:0003E7DC 10303000        	 11296:     move.b  (A0,D3.W),D0
02:0003E7E0 122C0511        	 11297:     move.b  ($0511,A4),D1
02:0003E7E4 8001            	 11298:     or.b  D1,D0
02:0003E7E6 19400511        	 11299:     move.b  D0,($0511,A4)
02:0003E7EA 1880            	 11300:     move.b  D0,($0000,A4)
                            	 11301:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11302:     ; Count them up, and store the amount in [00].
                            	 11303:     ;
02:0003E7EC 7000            	 11304:     moveq   #0,D0
02:0003E7EE 7604            	 11305:     moveq   #4,D3
                            	 11306: _anon_z04_143:
02:0003E7F0 1214            	 11307:     move.b  ($0000,A4),D1
02:0003E7F2 E209            	 11308:     lsr.b  #1,D1   ; LSR $00
02:0003E7F4 1881            	 11309:     move.b  D1,($0000,A4)
02:0003E7F6 123C0000        	 11310:     move.b  #$00,D1
02:0003E7FA D101            	 11311:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E7FC 5303            	 11312:     subq.b  #1,D3
02:0003E7FE 66F0            	 11313:     bne  _anon_z04_143
02:0003E800 1880            	 11314:     move.b  D0,($0000,A4)
                            	 11315:     ; Compare the number of dead necks to the original number
                            	 11316:     ; (object type - $41).
                            	 11317:     ;
02:0003E802 102C0350        	 11318:     move.b  ($0350,A4),D0
02:0003E806 003C0011        	 11319:     ori     #$11,CCR  ; SEC: set C+X
02:0003E80A 123C0041        	 11320:     move.b  #$41,D1
02:0003E80E 0A3C0010        	 11321:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E812 9101            	 11322:     subx.b  D1,D0   ; SBC #$41
02:0003E814 0A3C0010        	 11323:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E818 1214            	 11324:     move.b  ($0000,A4),D1
02:0003E81A B001            	 11325:     cmp.b   D1,D0
                            	 11326:     ; If they're equal, then go handle the whole boss dying.
                            	 11327:     ;
02:0003E81C 671C            	 11328:     beq  _L_z04_Gleeok_CheckCollisions_BossDied
                            	 11329:     ; Else reset object metastate of the segment, and return.
                            	 11330:     ;
02:0003E81E 4EF90004DA58    	 11331:     jmp     ResetObjMetastate
                            	 11332: 
                            	 11333:     even
                            	 11334: _L_z04_Gleeok_CheckCollisions_ResetMetastate:
02:0003E824 4EB90004DA58    	 11335:     jsr     ResetObjMetastate
                            	 11336:     even
                            	 11337: _L_z04_Gleeok_CheckCollisions_NextLoopSegment:
                            	 11338:     ; Bottom of the segment loop.
                            	 11339:     ; Decrement segment object slot.
                            	 11340:     ;
                            	 11341:     ; If >= 1, then go draw the next segment and check collisions.
                            	 11342:     ; Else return.
                            	 11343:     ;
02:0003E82A 5302            	 11344:     subq.b  #1,D2
02:0003E82C 0C020001        	 11345:     cmpi.b  #$01,D2
02:0003E830 6404            	 11346:     bcc.s  __far_z_04_0108
