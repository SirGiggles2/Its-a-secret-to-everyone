                            	  7582: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D688 7400            	  7583:     moveq   #0,D2
02:0004D68A 142C0340        	  7584:     move.b  ($0340,A4),D2
                            	  7585:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7586:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7587:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7588:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7589:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7590:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7591:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7592:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7593:     ; corrupting them and causing a deterministic address-error
                            	  7594:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7595:     ; identified by Codex static review.)
                            	  7596: _L_z07_P47_pre_check:
02:0004D68E 102C0525        	  7597:     move.b  ($0525,A4),D0
02:0004D692 020000F0        	  7598:     andi.b  #$F0,D0
02:0004D696 0C000040        	  7599:     cmpi.b  #$40,D0
02:0004D69A 6506            	  7600:     blo     _L_z07_P47_pre_snap
02:0004D69C 0C0000E0        	  7601:     cmpi.b  #$E0,D0
02:0004D6A0 6506            	  7602:     blo     _L_z07_P47_pre_ok
                            	  7603: _L_z07_P47_pre_snap:
02:0004D6A2 197C00480525    	  7604:     move.b  #$48,($0525,A4)
                            	  7605: _L_z07_P47_pre_ok:
02:0004D6A8 7005            	  7606:     moveq   #5,D0
02:0004D6AA 61000500        	  7607:     jsr     SwitchBank
02:0004D6AE 4EB900042076    	  7608:     jsr     FindNextEdgeSpawnCell
                            	  7609:     ; Post-walk 1: bottom-edge snap.
02:0004D6B4 102C0525        	  7610:     move.b  ($0525,A4),D0
02:0004D6B8 020000F0        	  7611:     andi.b  #$F0,D0
02:0004D6BC 0C0000E0        	  7612:     cmpi.b  #$E0,D0
02:0004D6C0 660C            	  7613:     bne     _L_z07_P47_post1_ok
02:0004D6C2 197C00480525    	  7614:     move.b  #$48,($0525,A4)
02:0004D6C8 4EB900042076    	  7615:     jsr     FindNextEdgeSpawnCell
                            	  7616: _L_z07_P47_post1_ok:
                            	  7617:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7618:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D6CE 7600            	  7619:     moveq   #0,D3
02:0004D6D0 162C0525        	  7620:     move.b  ($0525,A4),D3
02:0004D6D4 0243000F        	  7621:     andi.w  #$000F,D3
02:0004D6D8 C6FC002C        	  7622:     mulu.w  #44,D3
02:0004D6DC 203C00FF6530    	  7623:     move.l  #$FF6530,D0
02:0004D6E2 D083            	  7624:     add.l   D3,D0
02:0004D6E4 7600            	  7625:     moveq   #0,D3
02:0004D6E6 162C0525        	  7626:     move.b  ($0525,A4),D3
02:0004D6EA E84B            	  7627:     lsr.w   #4,D3
02:0004D6EC 5943            	  7628:     subi.w  #4,D3
02:0004D6EE E34B            	  7629:     lsl.w   #1,D3
02:0004D6F0 D083            	  7630:     add.l   D3,D0
02:0004D6F2 2040            	  7631:     movea.l D0,A0
02:0004D6F4 1010            	  7632:     move.b  (A0),D0
02:0004D6F6 0C000084        	  7633:     cmpi.b  #$84,D0
02:0004D6FA 6544            	  7634:     blo     _L_z07_P47_post2_ok
                            	  7635:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7636:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7637:     ; writes to the $05xx region.
02:0004D6FC 7800            	  7638:     moveq   #0,D4
                            	  7639: _L_z07_P47_fb_loop:
02:0004D6FE 41FAE46C        	  7640:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D702 12304000        	  7641:     move.b  (A0,D4.W),D1
02:0004D706 19410525        	  7642:     move.b  D1,($0525,A4)
                            	  7643:     ; Validate fallback cell walkable.
02:0004D70A 7600            	  7644:     moveq   #0,D3
02:0004D70C 1601            	  7645:     move.b  D1,D3
02:0004D70E 0243000F        	  7646:     andi.w  #$000F,D3
02:0004D712 C6FC002C        	  7647:     mulu.w  #44,D3
02:0004D716 203C00FF6530    	  7648:     move.l  #$FF6530,D0
02:0004D71C D083            	  7649:     add.l   D3,D0
02:0004D71E 7600            	  7650:     moveq   #0,D3
02:0004D720 1601            	  7651:     move.b  D1,D3
02:0004D722 E84B            	  7652:     lsr.w   #4,D3
02:0004D724 5943            	  7653:     subi.w  #4,D3
02:0004D726 E34B            	  7654:     lsl.w   #1,D3
02:0004D728 D083            	  7655:     add.l   D3,D0
02:0004D72A 2040            	  7656:     movea.l D0,A0
02:0004D72C 0C100084        	  7657:     cmpi.b  #$84,(A0)
02:0004D730 650E            	  7658:     blo     _L_z07_P47_post2_ok
02:0004D732 5204            	  7659:     addq.b  #1,D4
02:0004D734 0C040008        	  7660:     cmpi.b  #8,D4
02:0004D738 65C4            	  7661:     blo     _L_z07_P47_fb_loop
                            	  7662:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7663:     ; rather than looping).
02:0004D73A 197C00480525    	  7664:     move.b  #$48,($0525,A4)
                            	  7665: _L_z07_P47_post2_ok:
                            	  7666:     ; Extract and set the monster's location.
                            	  7667:     ;
02:0004D740 102C0525        	  7668:     move.b  ($0525,A4),D0
                            	  7669:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7670:     ;
02:0004D744 1B00            	  7671:     move.b  D0,-(A5)  ; PHA
02:0004D746 E308            	  7672:     lsl.b  #1,D0   ; ASL A
02:0004D748 E308            	  7673:     lsl.b  #1,D0   ; ASL A
02:0004D74A E308            	  7674:     lsl.b  #1,D0   ; ASL A
02:0004D74C E308            	  7675:     lsl.b  #1,D0   ; ASL A
02:0004D74E 19802070        	  7676:     move.b  D0,($70,A4,D2.W)
                            	  7677:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7678:     ;
02:0004D752 101D            	  7679:     move.b  (A5)+,D0  ; PLA
02:0004D754 020000F0        	  7680:     andi.b #$F0,D0
02:0004D758 003C0011        	  7681:     ori     #$11,CCR  ; SEC: set C+X
02:0004D75C 123C0003        	  7682:     move.b  #$03,D1
02:0004D760 0A3C0010        	  7683:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D764 9101            	  7684:     subx.b  D1,D0   ; SBC #$03
