02:00031D3A 003C0011        	  6899:     ori     #$11,CCR  ; SEC: set C+X
02:00031D3E 122C000D        	  6900:     move.b  ($000D,A4),D1
02:00031D42 0A3C0010        	  6901:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
