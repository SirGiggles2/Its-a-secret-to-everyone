02:0003B20A 41EC0492        	  3978:     lea     ($0492,A4),A0
02:0003B20E 10302000        	  3979:     move.b  (A0,D2.W),D0
02:0003B212 66EC            	  3980:     bne  _anon_z04_53
02:0003B214 4EB90004DA52    	  3981:     jsr     ResetObjMetastateAndTimer
02:0003B21A 6000F44A        	  3982:     jmp     EndInitFlyer
                            	  3983: 
                            	  3984:     even
                            	  3985: UpdateArmos:
02:0003B21E 6100E776        	  3986:     jsr     UpdateGoriya
                            	  3987:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3988:     ;
02:0003B222 41EC00C0        	  3989:     lea     ($00C0,A4),A0
02:0003B226 10302000        	  3990:     move.b  (A0,D2.W),D0
02:0003B22A 6702            	  3991:     beq.s  __far_z_04_0035
02:0003B22C 602A            	  3992:     jmp  DrawArmosAndCheckCollisions
                            	  3993: __far_z_04_0035:
                            	  3994:     ; Animate.
                            	  3995:     ;
                            	  3996:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3997:     ; then only go draw.
                            	  3998:     ;
02:0003B22E 41EC03D0        	  3999:     lea     ($03D0,A4),A0
02:0003B232 53302000        	  4000:     subq.b  #1,(A0,D2.W)
02:0003B236 6702            	  4001:     beq.s  __far_z_04_0036
02:0003B238 601E            	  4002:     jmp  DrawArmosAndCheckCollisions
                            	  4003: __far_z_04_0036:
                            	  4004:     ; Armos animation frames last 6 screen frames.
                            	  4005:     ;
02:0003B23A 7006            	  4006:     moveq   #6,D0
02:0003B23C 41EC03D0        	  4007:     lea     ($03D0,A4),A0
02:0003B240 11802000        	  4008:     move.b  D0,(A0,D2.W)
                            	  4009:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  4010:     ; change the position of the shield. To keep fixed it in place,
                            	  4011:     ; there are separate frame images for each animation frame.
                            	  4012:     ;
                            	  4013:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  4014:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  4015:     ;
                            	  4016:     ; Here flip between the two sets by XOR'ing with 2.
                            	  4017:     ; Then choose the direction at the point of drawing below.
                            	  4018:     ;
02:0003B244 41EC03E4        	  4019:     lea     ($03E4,A4),A0
02:0003B248 10302000        	  4020:     move.b  (A0,D2.W),D0
02:0003B24C 0A000002        	  4021:     eori.b #$02,D0
02:0003B250 41EC03E4        	  4022:     lea     ($03E4,A4),A0
02:0003B254 11802000        	  4023:     move.b  D0,(A0,D2.W)
                            	  4024:     even
                            	  4025: DrawArmosAndCheckCollisions:
02:0003B258 4EB90004D250    	  4026:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B25E 7600            	  4027:     moveq   #0,D3
02:0003B260 41EC0098        	  4028:     lea     ($0098,A4),A0
02:0003B264 16302000        	  4029:     move.b  (A0,D2.W),D3
                            	  4030:     ; If facing up, then use the second frame image in the set ("back").
                            	  4031:     ; Else use the second.
                            	  4032:     ;
02:0003B268 0C030008        	  4033:     cmpi.b  #$08,D3
02:0003B26C 6602            	  4034:     bne  _anon_z04_54
02:0003B26E 7001            	  4035:     moveq   #1,D0
                            	  4036: _anon_z04_54:
02:0003B270 023C00EE        	  4037:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B274 41EC03E4        	  4038:     lea     ($03E4,A4),A0
02:0003B278 12302000        	  4039:     move.b  (A0,D2.W),D1
02:0003B27C D101            	  4040:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B27E 4EB90003169C    	  4041:     jsr     DrawObjectNotMirrored
                            	  4042:     ; If the armos is still fading in, then go for check collision with Link,
                            	  4043:     ; but not with weapons.
                            	  4044:     ;
02:0003B284 10342028        	  4045:     move.b  ($28,A4,D2.W),D0
02:0003B288 661C            	  4046:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  4047:     ; Else check for all collisions.
                            	  4048:     ;
02:0003B28A 4EB900031A18    	  4049:     jsr     CheckMonsterCollisions
                            	  4050:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  4051:     ;
02:0003B290 41EC0405        	  4052:     lea     ($0405,A4),A0
02:0003B294 10302000        	  4053:     move.b  (A0,D2.W),D0
02:0003B298 670A            	  4054:     beq  _anon_z04_55
02:0003B29A 705D            	  4055:     moveq   #93,D0
02:0003B29C 41EC034F        	  4056:     lea     ($034F,A4),A0
02:0003B2A0 11802000        	  4057:     move.b  D0,(A0,D2.W)
                            	  4058: _anon_z04_55:
02:0003B2A4 4E75            	  4059:     rts
                            	  4060: 
                            	  4061:     even
                            	  4062: _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision:
02:0003B2A6 4EF900031B62    	  4063:     jmp     CheckLinkCollision
                            	  4064: 
                            	  4065:     even
                            	  4066: UpdatePondFairy:
02:0003B2AC 610048A4        	  4067:     jsr     DrawFairy
                            	  4068:     ; If not in state 0, then go handle states 1 to 3.
                            	  4069:     ;
02:0003B2B0 102C00AD        	  4070:     move.b  ($00AD,A4),D0
02:0003B2B4 6702            	  4071:     beq.s  __far_z_04_0037
02:0003B2B6 602A            	  4072:     jmp  PondFairy_HandleOtherStates
                            	  4073: __far_z_04_0037:
                            	  4074:     ; State 0.
                            	  4075:     ;
                            	  4076:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4077:     ;
02:0003B2B8 102C0084        	  4078:     move.b  ($0084,A4),D0
02:0003B2BC 0C0000AD        	  4079:     cmpi.b  #$AD,D0
02:0003B2C0 661E            	  4080:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4081:     ; If Link's X < $70 or >= $81, then return.
                            	  4082:     ;
02:0003B2C2 102C0070        	  4083:     move.b  ($0070,A4),D0
02:0003B2C6 0C000070        	  4084:     cmpi.b  #$70,D0
02:0003B2CA 6514            	  4085:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B2CC 0C000081        	  4086:     cmpi.b  #$81,D0
02:0003B2D0 640E            	  4087:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4088:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4089:     ; halt Link, and start filling hearts.
                            	  4090:     ;
02:0003B2D2 522C00AD        	  4091:     addq.b  #1,($00AD,A4)
02:0003B2D6 7040            	  4092:     moveq   #64,D0
02:0003B2D8 194000AC        	  4093:     move.b  D0,($00AC,A4)
02:0003B2DC 19400063        	  4094:     move.b  D0,($0063,A4)
                            	  4095:     even
                            	  4096: _L_z04_UpdatePondFairy_Exit:
02:0003B2E0 4E75            	  4097:     rts
                            	  4098: 
                            	  4099:     even
                            	  4100: PondFairy_HandleOtherStates:
02:0003B2E2 0C000001        	  4101:     cmpi.b  #$01,D0
02:0003B2E6 6610            	  4102:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4103:     ; State 1. Flying and filling hearts.
                            	  4104:     ;
                            	  4105:     ; If still filling hearts, then go draw Link and hearts.
                            	  4106:     ;
02:0003B2E8 102C0063        	  4107:     move.b  ($0063,A4),D0
02:0003B2EC 6620            	  4108:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4109:     ; If not filling hearts anymore, then go to state 2,
                            	  4110:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4111:     ; a little while after we finish filling hearts.
                            	  4112:     ;
02:0003B2EE 522C00AD        	  4113:     addq.b  #1,($00AD,A4)
02:0003B2F2 7050            	  4114:     moveq   #80,D0
02:0003B2F4 19400029        	  4115:     move.b  D0,($0029,A4)
                            	  4116:     even
                            	  4117: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4118:     ; If state <> 2 (so, it's 3), then return.
                            	  4119:     ;
                            	  4120:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4121:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4122:     ; was set to, and we'll return.
                            	  4123:     ;
02:0003B2F8 0C000002        	  4124:     cmpi.b  #$02,D0
02:0003B2FC 6634            	  4125:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4126:     ; State = 2.
                            	  4127:     ;
                            	  4128:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4129:     ;
02:0003B2FE 102C0029        	  4130:     move.b  ($0029,A4),D0
02:0003B302 660A            	  4131:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4132:     ; Else go to state 3, and unhalt Link.
                            	  4133:     ;
02:0003B304 522C00AD        	  4134:     addq.b  #1,($00AD,A4)
02:0003B308 7000            	  4135:     moveq   #0,D0
02:0003B30A 194000AC        	  4136:     move.b  D0,($00AC,A4)
                            	  4137:     even
                            	  4138: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  4139:     ; TODO: but why, since Link is halted?
                            	  4140:     ;
                            	  4141:     ; Reset the input direction, so that Link doesn't animate
                            	  4142:     ; when drawing him.
02:0003B30E 7600            	  4143:     moveq   #0,D3
02:0003B310 194303F8        	  4144:     move.b  D3,($03F8,A4)
                            	  4145:     ; Save and reset Link's state.
                            	  4146:     ;
                            	  4147:     ; TODO: but why, since Link is halted?
                            	  4148:     ;
02:0003B314 102C00AC        	  4149:     move.b  ($00AC,A4),D0
02:0003B318 1B00            	  4150:     move.b  D0,-(A5)  ; PHA
02:0003B31A 194300AC        	  4151:     move.b  D3,($00AC,A4)
02:0003B31E 4EB90004C164    	  4152:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  4153:     ; Restore Link's state.
                            	  4154:     ;
