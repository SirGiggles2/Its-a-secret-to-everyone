02:00043A18 41F90004384E    	  6104:     lea     (DoorFaceTilesAddrsLo).l,A0
02:00043A1E 10302000        	  6105:     move.b  (A0,D2.W),D0
02:00043A22 19400002        	  6106:     move.b  D0,($0002,A4)
02:00043A26 41F900043852    	  6107:     lea     (DoorFaceTilesAddrsHi).l,A0
