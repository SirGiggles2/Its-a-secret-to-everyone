02:0003028C 11802000        	  3196:     move.b  D0,(A0,D2.W)
                            	  3197:     ; Set facing direction to the horizontal one that we determined.
                            	  3198:     ;
02:00030290 1003            	  3199:     move.b  D3,D0
02:00030292 41EC0098        	  3200:     lea     ($0098,A4),A0
02:00030296 11802000        	  3201:     move.b  D0,(A0,D2.W)
                            	  3202:     ; If the direction we determined is not allowed for this trap, then
                            	  3203:     ; go draw and check collisions.
