02:0004284C 162C0009        	  4969:     move.b  ($0009,A4),D3
02:00042850 41F900043A6E    	  4970:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:00042856 10303000        	  4971:     move.b  (A0,D3.W),D0
                            	  4972:     ; Add [07] to the base offset we got above. This yields one
                            	  4973:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4974:     ;
