                            	 12040:     ;
02:0003ED92 41EC0084        	 12041:     lea     ($0084,A4),A0
02:0003ED96 10302000        	 12042:     move.b  (A0,D2.W),D0
02:0003ED9A 023C00EE        	 12043:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED9E 123C0003        	 12044:     move.b  #$03,D1
02:0003EDA2 D101            	 12045:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDA4 02000007        	 12046:     andi.b #$07,D0
02:0003EDA8 6702            	 12047:     beq.s  __far_z_04_0124
02:0003EDAA 60D8            	 12048:     jmp  L12A6F_Exit
                            	 12049: __far_z_04_0124:
                            	 12050:     ; Will loop 4 times, propagating directions down the chain,
                            	 12051:     ; by pulling from the bottom.
                            	 12052:     ;
02:0003EDAC 7004            	 12053:     moveq   #4,D0
02:0003EDAE 1880            	 12054:     move.b  D0,($0000,A4)
                            	 12055:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 12056:     ;
02:0003EDB0 7600            	 12057:     moveq   #0,D3
02:0003EDB2 0C020005        	 12058:     cmpi.b  #$05,D2
02:0003EDB6 6702            	 12059:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EDB8 7605            	 12060:     moveq   #5,D3
                            	 12061:     even
                            	 12062: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 12063:     ; Loop over every segment under the head, starting from the tail.
                            	 12064:     ; Copy the next segment's direction to the current one in this loop.
                            	 12065:     ;
02:0003EDBA 41EC009A        	 12066:     lea     ($009A,A4),A0
02:0003EDBE 10303000        	 12067:     move.b  (A0,D3.W),D0
02:0003EDC2 41EC0099        	 12068:     lea     ($0099,A4),A0
02:0003EDC6 11803000        	 12069:     move.b  D0,(A0,D3.W)
02:0003EDCA 5203            	 12070:     addq.b  #1,D3
02:0003EDCC 5314            	 12071:     subq.b  #1,($0000,A4)
02:0003EDCE 66EA            	 12072:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 12073:     ; If this head segment is not aligned with a square, then return.
                            	 12074:     ;
02:0003EDD0 10342070        	 12075:     move.b  ($70,A4,D2.W),D0
02:0003EDD4 0200000F        	 12076:     andi.b #$0F,D0
02:0003EDD8 660000BA        	 12077:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12078:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 12079:     ; We had to account for the usual offset of 3.
                            	 12080:     ;
02:0003EDDC 41EC0084        	 12081:     lea     ($0084,A4),A0
02:0003EDE0 10302000        	 12082:     move.b  (A0,D2.W),D0
02:0003EDE4 023C00EE        	 12083:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EDE8 123C0003        	 12084:     move.b  #$03,D1
02:0003EDEC D101            	 12085:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EDEE 0200000F        	 12086:     andi.b #$0F,D0
02:0003EDF2 660000A0        	 12087:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 12088:     ; Store the opposite of the facing direction in [00].
                            	 12089:     ;
02:0003EDF6 41EC0098        	 12090:     lea     ($0098,A4),A0
02:0003EDFA 10302000        	 12091:     move.b  (A0,D2.W),D0
02:0003EDFE E208            	 12092:     lsr.b  #1,D0   ; LSR A
02:0003EE00 02000005        	 12093:     andi.b #$05,D0
02:0003EE04 1880            	 12094:     move.b  D0,($0000,A4)
02:0003EE06 41EC0098        	 12095:     lea     ($0098,A4),A0
02:0003EE0A 10302000        	 12096:     move.b  (A0,D2.W),D0
02:0003EE0E E308            	 12097:     lsl.b  #1,D0   ; ASL A
02:0003EE10 0200000A        	 12098:     andi.b #$0A,D0
02:0003EE14 1214            	 12099:     move.b  ($0000,A4),D1
02:0003EE16 8001            	 12100:     or.b  D1,D0
                            	 12101:     ; Make a mask of the inverted bits of the opposite direction.
                            	 12102:     ;
02:0003EE18 0A00000F        	 12103:     eori.b #$0F,D0
02:0003EE1C 1940050F        	 12104:     move.b  D0,($050F,A4)
                            	 12105:     ; There's a 50% chance of going to try to turn toward Link.
                            	 12106:     ;
02:0003EE20 10342018        	 12107:     move.b  ($18,A4,D2.W),D0
02:0003EE24 0C000080        	 12108:     cmpi.b  #$80,D0
02:0003EE28 656C            	 12109:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 12110:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 12111:     ; Load the monster's facing direction.
                            	 12112:     ;
02:0003EE2A 41EC0098        	 12113:     lea     ($0098,A4),A0
02:0003EE2E 10302000        	 12114:     move.b  (A0,D2.W),D0
                            	 12115:     ; Load the next random number into Y register.
                            	 12116:     ;
02:0003EE32 7600            	 12117:     moveq   #0,D3
02:0003EE34 16342019        	 12118:     move.b  ($19,A4,D2.W),D3
                            	 12119:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 12120:     ; to keep moving straight.
                            	 12121:     ;
02:0003EE38 0C030080        	 12122:     cmpi.b  #$80,D3
02:0003EE3C 6418            	 12123:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12124:     even
                            	 12125: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 12126:     ; Loop to rotate the direction bit over the mask.
                            	 12127:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 12128:     ; facing direction.
                            	 12129:     ;
                            	 12130:     ; Shift right the copy of the direction.
                            	 12131:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12132:     ;
02:0003EE3E E208            	 12133:     lsr.b  #1,D0   ; LSR A
02:0003EE40 6402            	 12134:     bcc  _anon_z04_151
02:0003EE42 7008            	 12135:     moveq   #8,D0
                            	 12136: _anon_z04_151:
                            	 12137:     ; If the current direction bit is masked off, then we've reached
                            	 12138:     ; the opposite direction. Loop again.
                            	 12139:     ;
02:0003EE44 122C050F        	 12140:     move.b  ($050F,A4),D1
02:0003EE48 C200            	 12141:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE4A 67F2            	 12142:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12143:     ; If Y register >= $40, then break out of the loop.
                            	 12144:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 12145:     ;
02:0003EE4C 0C030040        	 12146:     cmpi.b  #$40,D3
02:0003EE50 6404            	 12147:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12148:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 12149:     ; and loop again now.
                            	 12150:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 12151:     ;
02:0003EE52 7640            	 12152:     moveq   #64,D3
02:0003EE54 65E8            	 12153:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 12154:     even
                            	 12155: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 12156:     ; Change the facing direction to the direction found.
                            	 12157:     ;
02:0003EE56 41EC0098        	 12158:     lea     ($0098,A4),A0
02:0003EE5A 11802000        	 12159:     move.b  D0,(A0,D2.W)
                            	 12160:     ; Set moving direction [0F] for boundary and tile checks.
                            	 12161:     ;
02:0003EE5E 1940000F        	 12162:     move.b  D0,($000F,A4)
02:0003EE62 4EB900030A04    	 12163:     jsr     BoundByRoom
                            	 12164:     ; If not blocked by the room boundary, then go check tile collision.
                            	 12165:     ;
02:0003EE68 102C000F        	 12166:     move.b  ($000F,A4),D0
02:0003EE6C 6618            	 12167:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 12168:     even
                            	 12169: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 12170:     ; Else it was blocked. So, load the facing direction in preparation
                            	 12171:     ; for looking for any non-opposite direction that is not blocked.
                            	 12172:     ;
02:0003EE6E 41EC0098        	 12173:     lea     ($0098,A4),A0
02:0003EE72 10302000        	 12174:     move.b  (A0,D2.W),D0
                            	 12175:     even
                            	 12176: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 12177:     ; Shift right the copy of the direction.
                            	 12178:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 12179:     ;
02:0003EE76 E208            	 12180:     lsr.b  #1,D0   ; LSR A
02:0003EE78 6402            	 12181:     bcc  _anon_z04_152
02:0003EE7A 7008            	 12182:     moveq   #8,D0
                            	 12183: _anon_z04_152:
                            	 12184:     ; If the current direction bit is not masked off, then go check the
                            	 12185:     ; room boundary in this direction.
                            	 12186:     ; Else we've reached the opposite direction. Loop again.
                            	 12187:     ;
02:0003EE7C 122C050F        	 12188:     move.b  ($050F,A4),D1
02:0003EE80 C200            	 12189:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE82 66D2            	 12190:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EE84 67F0            	 12191:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 12192:     even
                            	 12193: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 12194:     ; We found a direction that was not blocked by the room boundary.
                            	 12195:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 12196:     ;
02:0003EE86 4EB90004B9AC    	 12197:     jsr     GetCollidingTileMoving
02:0003EE8C 122C034A        	 12198:     move.b  ($034A,A4),D1
02:0003EE90 B001            	 12199:     cmp.b   D1,D0
02:0003EE92 64DA            	 12200:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 12201:     even
                            	 12202: _L_z04_Lamnola_UpdateHead_Exit:
                            	 12203:     ; TODO: confirm this
                            	 12204:     ;
                            	 12205:     ; If there were a room that had lamnolas, and they could get
                            	 12206:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 12207:     ; an infinite loop.
                            	 12208:     ;
                            	 12209:     ; But, the only room with that configuration has those blocks
                            	 12210:     ; blocked off with a push block, which can only be pushed after
                            	 12211:     ; all monsters are killed.
                            	 12212:     ;
02:0003EE94 4E75            	 12213:     rts
                            	 12214: 
                            	 12215:     even
                            	 12216: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 12217:     ; Find the horizontal direction toward Link and store it in [02].
                            	 12218:     ;
02:0003EE96 7001            	 12219:     moveq   #1,D0
02:0003EE98 19400002        	 12220:     move.b  D0,($0002,A4)
02:0003EE9C 102C0070        	 12221:     move.b  ($0070,A4),D0
02:0003EEA0 003C0011        	 12222:     ori     #$11,CCR  ; SEC: set C+X
02:0003EEA4 12342070        	 12223:     move.b  ($70,A4,D2.W),D1
02:0003EEA8 0A3C0010        	 12224:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEAC 9101            	 12225:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EEAE 0A3C0010        	 12226:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEB2 640A            	 12227:     bcc  _anon_z04_153
02:0003EEB4 122C0002        	 12228:     move.b  ($0002,A4),D1
02:0003EEB8 E309            	 12229:     lsl.b  #1,D1   ; ASL $02
02:0003EEBA 19410002        	 12230:     move.b  D1,($0002,A4)
                            	 12231: _anon_z04_153:
                            	 12232:     ; Find the vertical direction toward Link and store it in [03].
                            	 12233:     ;
02:0003EEBE 7004            	 12234:     moveq   #4,D0
02:0003EEC0 19400003        	 12235:     move.b  D0,($0003,A4)
02:0003EEC4 102C0084        	 12236:     move.b  ($0084,A4),D0
02:0003EEC8 003C0011        	 12237:     ori     #$11,CCR  ; SEC: set C+X
02:0003EECC 41EC0084        	 12238:     lea     ($0084,A4),A0
02:0003EED0 12302000        	 12239:     move.b  (A0,D2.W),D1
02:0003EED4 0A3C0010        	 12240:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EED8 9101            	 12241:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EEDA 0A3C0010        	 12242:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEDE 640A            	 12243:     bcc  _anon_z04_154
02:0003EEE0 122C0003        	 12244:     move.b  ($0003,A4),D1
02:0003EEE4 E309            	 12245:     lsl.b  #1,D1   ; ASL $03
02:0003EEE6 19410003        	 12246:     move.b  D1,($0003,A4)
                            	 12247: _anon_z04_154:
                            	 12248:     ; If the horizontal direction toward Link is not allowed, then
                            	 12249:     ; go check the vertical direction.
                            	 12250:     ;
02:0003EEEA 102C0002        	 12251:     move.b  ($0002,A4),D0
02:0003EEEE 122C050F        	 12252:     move.b  ($050F,A4),D1
02:0003EEF2 C200            	 12253:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEF4 6708            	 12254:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 12255:     ; If the horizontal direction toward Link is the same direction
                            	 12256:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 12257:     ;
02:0003EEF6 122C0098        	 12258:     move.b  ($0098,A4),D1
02:0003EEFA C200            	 12259:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEFC 6604            	 12260:     bne  _anon_z04_155
                            	 12261:     even
                            	 12262: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12263:     ; Load the vertical direction toward Link in order to test it for
                            	 12264:     ; room boundary and tile collision.
                            	 12265:     ;
02:0003EEFE 102C0003        	 12266:     move.b  ($0003,A4),D0
                            	 12267: _anon_z04_155:
                            	 12268:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12269:     ;
02:0003EF02 6000FF52        	 12270:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 12271: 
