02:00043CD6 000434B2        	  6496:     dc.l    ColumnHeapUW0
02:00043CDA 000434C2        	  6497:     dc.l    ColumnHeapUW1
02:00043CDE 000434E0        	  6498:     dc.l    ColumnHeapUW2
02:00043CE2 000434F2        	  6499:     dc.l    ColumnHeapUW3
02:00043CE6 00043504        	  6500:     dc.l    ColumnHeapUW4
02:00043CEA 0004351C        	  6501:     dc.l    ColumnHeapUW5
02:00043CEE 00043534        	  6502:     dc.l    ColumnHeapUW6
02:00043CF2 00043546        	  6503:     dc.l    ColumnHeapUW7
02:00043CF6 00043558        	  6504:     dc.l    ColumnHeapUW8
