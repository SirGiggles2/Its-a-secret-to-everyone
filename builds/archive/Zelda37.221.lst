02:0003C842 532C000B        	  7012:     subq.b  #1,($000B,A4)
02:0003C846 6A00FF7E        	  7013:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C84A 4E75            	  7014:     rts
