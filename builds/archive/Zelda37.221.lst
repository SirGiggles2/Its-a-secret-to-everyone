                            	 11130: __far_z_04_0105:
                            	 11131: ; Description:
                            	 11132: ; This block applies to heads and the bottom segment of a neck.
                            	 11133: ; These are drawn with sprites that come first in order, so that
                            	 11134: ; they are drawn above all other sprites, including Link.
                            	 11135: ;
                            	 11136: ; Params:
                            	 11137: ; A: tile number
                            	 11138: ;
                            	 11139: ; Normal sprite with level palette row
                            	 11140:     even
                            	 11141: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E6BA 7603            	 11142:     moveq   #3,D3
02:0003E6BC 19430003        	 11143:     move.b  D3,($0003,A4)
02:0003E6C0 1B00            	 11144:     move.b  D0,-(A5)  ; PHA
                            	 11145:     ; To calculate the base offset of the sprite record:
                            	 11146:     ; offset := neck index * 8
                            	 11147:     ;
                            	 11148:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 11149:     ; at an even index.
                            	 11150:     ;
02:0003E6C2 102C04D7        	 11151:     move.b  ($04D7,A4),D0
02:0003E6C6 E308            	 11152:     lsl.b  #1,D0   ; ASL A
02:0003E6C8 E308            	 11153:     lsl.b  #1,D0   ; ASL A
02:0003E6CA E308            	 11154:     lsl.b  #1,D0   ; ASL A
                            	 11155:     ; But if the segment is not a head (not at object slot 5), then
                            	 11156:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 11157:     ;
02:0003E6CC 0C020005        	 11158:     cmpi.b  #$05,D2
02:0003E6D0 670A            	 11159:     beq  _anon_z04_139
02:0003E6D2 023C00EE        	 11160:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6D6 123C0020        	 11161:     move.b  #$20,D1
02:0003E6DA D101            	 11162:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 11163: _anon_z04_139:
02:0003E6DC 7600            	 11164:     moveq   #0,D3
02:0003E6DE 1600            	 11165:     move.b  D0,D3
02:0003E6E0 101D            	 11166:     move.b  (A5)+,D0  ; PLA
02:0003E6E2 4EB9000319C6    	 11167:     jsr     Anim_WriteSpecificSprite
02:0003E6E8 6026            	 11168:     jmp     Gleeok_CheckCollisions
                            	 11169: 
                            	 11170:     even
                            	 11171: Gleeok_DrawHeadAndCheckCollisions:
02:0003E6EA 7405            	 11172:     moveq   #5,D2
                            	 11173:     even
                            	 11174: Gleeok_DrawSegmentAndCheckCollisions:
