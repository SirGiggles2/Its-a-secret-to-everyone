                            	   382: ;------------------------------------------------------------------------------
                            	   383: ; _c_move_object_shim — MoveObject trampoline.
                            	   384: ;
                            	   385: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   386: ;   Input:     D2 = slot (0..11)
                            	   387: ;   Preserves: D2, A4, A5
                            	   388: ;   Clobbers:  D0, D1, D3, A0
                            	   389: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   390: ;
                            	   391: ; GCC side:
                            	   392: ;   void c_move_object(unsigned short slot);
                            	   393: ;     slot arrives as a 16-bit value on the stack.
                            	   394: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   395: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   396: ;   never clobbered by gcc.
                            	   397: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   398: ;   semantics can exist in a pure C port).
                            	   399: ;------------------------------------------------------------------------------
                            	   400: _c_move_object_shim:
                            	   401:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   402:     move.b  #$AA,($0900,A4)
                            	   403:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   404:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   405:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   406:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   407:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   408:     moveq   #0,D0
02:0002B658 3002            	   409:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   410:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   411:     jsr     c_move_object
02:0002B662 588F            	   412:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   413:     rts
                            	   414: 
                            	   415: ;==============================================================================
                            	   416: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   417: ; and tail-call the native asm function.
                            	   418: ;
                            	   419: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   420: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   421: ; sign-extended).
                            	   422: ;==============================================================================
                            	   423: 
                            	   424: ;------------------------------------------------------------------------------
                            	   425: ; void c_copy_bank_to_window(unsigned int bank);
                            	   426: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   427: ;------------------------------------------------------------------------------
                            	   428: c_copy_bank_to_window:
02:0002B666 202F0004        	   429:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   430:     jmp     _copy_bank_to_window
                            	   431: 
                            	   432: ;------------------------------------------------------------------------------
                            	   433: ; unsigned char c_ppu_read_2(void);
                            	   434: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   435: ; C return: gcc expects result in D0.
                            	   436: ;------------------------------------------------------------------------------
                            	   437: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   438:     jmp     _ppu_read_2
                            	   439: 
                            	   440: ;------------------------------------------------------------------------------
                            	   441: ; void c_ppu_write_6(unsigned int val);
                            	   442: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   443: ;------------------------------------------------------------------------------
                            	   444: c_ppu_write_6:
02:0002B674 202F0004        	   445:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   446:     jmp     _ppu_write_6
                            	   447: 
                            	   448: ;------------------------------------------------------------------------------
                            	   449: ; void c_ppu_write_7(unsigned int val);
                            	   450: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   451: ;------------------------------------------------------------------------------
                            	   452: c_ppu_write_7:
02:0002B67E 202F0004        	   453:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   454:     jmp     _ppu_write_7
                            	   455: 
                            	   456: ;------------------------------------------------------------------------------
                            	   457: ; void c_turn_off_all_video(void);
                            	   458: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   459: ;------------------------------------------------------------------------------
                            	   460: c_turn_off_all_video:
02:0002B688 4EF90004AC8C    	   461:     jmp     TurnOffAllVideo
