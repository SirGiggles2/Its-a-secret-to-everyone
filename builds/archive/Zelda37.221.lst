02:0003C040 41EC0350        	  5889:     lea     ($0350,A4),A0
02:0003C044 10303000        	  5890:     move.b  (A0,D3.W),D0
02:0003C048 0C000041        	  5891:     cmpi.b  #$41,D0
02:0003C04C 66F0            	  5892:     bne  _anon_z04_80
                            	  5893:     ; I don't know why the object timer of the tail segment that will
                            	  5894:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5895:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5896:     ; there, the object timer is set to 6.
                            	  5897:     ;
02:0003C04E 7011            	  5898:     moveq   #17,D0
02:0003C050 19803029        	  5899:     move.b  D0,($29,A4,D3.W)
                            	  5900:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5901:     ; segment to the tail segment.
                            	  5902:     ;
02:0003C054 41EC04F0        	  5903:     lea     ($04F0,A4),A0
02:0003C058 10302000        	  5904:     move.b  (A0,D2.W),D0
02:0003C05C 41EC04F1        	  5905:     lea     ($04F1,A4),A0
02:0003C060 11803000        	  5906:     move.b  D0,(A0,D3.W)
02:0003C064 10342070        	  5907:     move.b  ($70,A4,D2.W),D0
02:0003C068 19803071        	  5908:     move.b  D0,($71,A4,D3.W)
02:0003C06C 41EC0084        	  5909:     lea     ($0084,A4),A0
02:0003C070 10302000        	  5910:     move.b  (A0,D2.W),D0
02:0003C074 41EC0085        	  5911:     lea     ($0085,A4),A0
02:0003C078 11803000        	  5912:     move.b  D0,(A0,D3.W)
                            	  5913:     ; If the tail segment found is also a head, then
