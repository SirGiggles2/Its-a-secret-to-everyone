                            	  3647:     even
                            	  3648: _L_z04_UpdateOctorock_SaveOffset:
02:0003B012 1B00            	  3649:     move.b  D0,-(A5)  ; PHA
                            	  3650:     ; Decrement the animation counter, and roll over if needed.
                            	  3651:     ;
02:0003B014 41EC03D0        	  3652:     lea     ($03D0,A4),A0
02:0003B018 53302000        	  3653:     subq.b  #1,(A0,D2.W)
02:0003B01C 661E            	  3654:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B01E 7006            	  3655:     moveq   #6,D0
02:0003B020 41EC03D0        	  3656:     lea     ($03D0,A4),A0
02:0003B024 11802000        	  3657:     move.b  D0,(A0,D2.W)
                            	  3658:     ; There are actually 6 frame images divided into 2 sets.
                            	  3659:     ; Each set depicts one animation frame. In each set there are
                            	  3660:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3661:     ;
                            	  3662:     ; The movement frame will keep track of the base offset of
                            	  3663:     ; the current set for the current animation frame: 0 or 3.
                            	  3664:     ;
                            	  3665:     ; So, XOR the movement frame with 3.
                            	  3666:     ;
02:0003B028 E208            	  3667:     lsr.b  #1,D0   ; LSR A
02:0003B02A 41EC03E4        	  3668:     lea     ($03E4,A4),A0
02:0003B02E 12302000        	  3669:     move.b  (A0,D2.W),D1
02:0003B032 B300            	  3670:     eor.b  D1,D0
02:0003B034 41EC03E4        	  3671:     lea     ($03E4,A4),A0
02:0003B038 11802000        	  3672:     move.b  D0,(A0,D2.W)
                            	  3673:     even
                            	  3674: _L_z04_UpdateOctorock_CalcFinalOffset:
