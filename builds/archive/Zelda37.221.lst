02:0003CDCA 41EC03E4        	  7834:     lea     ($03E4,A4),A0
02:0003CDCE 16302000        	  7835:     move.b  (A0,D2.W),D3
02:0003CDD2 671E            	  7836:     beq  _anon_z04_95
02:0003CDD4 023C00EE        	  7837:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDD8 123C0003        	  7838:     move.b  #$03,D1
02:0003CDDC D101            	  7839:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7840:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7841:     ;
                            	  7842:     ; Down has two frame images, but up only has one. By flipping
                            	  7843:     ; horizontally, you get two frame images.
                            	  7844:     ;
02:0003CDDE 7600            	  7845:     moveq   #0,D3
02:0003CDE0 41EC0098        	  7846:     lea     ($0098,A4),A0
02:0003CDE4 16302000        	  7847:     move.b  (A0,D2.W),D3
02:0003CDE8 0C030008        	  7848:     cmpi.b  #$08,D3
02:0003CDEC 6604            	  7849:     bne  _anon_z04_95
02:0003CDEE 522C000F        	  7850:     addq.b  #1,($000F,A4)
