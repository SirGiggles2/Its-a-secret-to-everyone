                            	  3233: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  3234:     ; Or else if is zora in state 1 or 5, then use one of
                            	  3235:     ; the mound frame images:
                            	  3236:     ;
                            	  3237:     ; frame image := ((state - 1) * 2) + movement frame
                            	  3238:     ;
                            	  3239:     ; This yields 0/1 or 8/9, depending on the state.
                            	  3240:     ;
                            	  3241:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  3242:     ;
02:0003ACFA 003C0011        	  3243:     ori     #$11,CCR  ; SEC: set C+X
02:0003ACFE 123C0001        	  3244:     move.b  #$01,D1
02:0003AD02 0A3C0010        	  3245:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AD06 9101            	  3246:     subx.b  D1,D0   ; SBC #$01
02:0003AD08 0A3C0010        	  3247:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AD0C E308            	  3248:     lsl.b  #1,D0   ; ASL A
02:0003AD0E 023C00EE        	  3249:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD12 41EC03E4        	  3250:     lea     ($03E4,A4),A0
02:0003AD16 12302000        	  3251:     move.b  (A0,D2.W),D1
02:0003AD1A D101            	  3252:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  3253:     even
