02:00042864 7600            	  4978:     moveq   #0,D3
02:00042866 1600            	  4979:     move.b  D0,D3
                            	  4980:     ; With that index, look up the index to use with the door face
                            	  4981:     ; list of tiles at [02:03].
                            	  4982:     ;
02:00042868 41F900043A60    	  4983:     lea     (HorizontalDoorFaceIndexes).l,A0
02:0004286E 10303000        	  4984:     move.b  (A0,D3.W),D0
02:00042872 7600            	  4985:     moveq   #0,D3
02:00042874 1600            	  4986:     move.b  D0,D3
                            	  4987:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4988:     ; and copy it to the dynamic transfer buf.
