02:0003AFE2 4EB90004D250    	  3620:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3621:     ; If facing down, then use frame image offset 2.
                            	  3622:     ;
02:0003AFE8 41EC0098        	  3623:     lea     ($0098,A4),A0
02:0003AFEC 10302000        	  3624:     move.b  (A0,D2.W),D0
02:0003AFF0 7600            	  3625:     moveq   #0,D3
02:0003AFF2 1600            	  3626:     move.b  D0,D3
02:0003AFF4 0200000C        	  3627:     andi.b #$0C,D0
02:0003AFF8 670C            	  3628:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003AFFA 7002            	  3629:     moveq   #2,D0
02:0003AFFC 0C030008        	  3630:     cmpi.b  #$08,D3
02:0003B000 6610            	  3631:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3632:     ; Else facing up. Use frame image offset 1.
                            	  3633:     ;
