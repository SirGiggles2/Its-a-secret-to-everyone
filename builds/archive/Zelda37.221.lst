02:0002CA0E 6100E3D8        	   335:     jsr     _apu_write_4017  ; APU/IO write
                            	   336:     ; Drive each game sound channel.
                            	   337:     ;
02:0002CA12 610003DE        	   338:     jsr     DriveTune1
02:0002CA16 6100020C        	   339:     jsr     DriveEffect
02:0002CA1A 61000502        	   340:     jsr     DriveSample
02:0002CA1E 610006A2        	   341:     jsr     DriveSong
                            	   342:     even
