                            	  7355:     ; Store (Y + 8) in [01].
                            	  7356:     ;
02:0003CACA 41EC0084        	  7357:     lea     ($0084,A4),A0
02:0003CACE 10302000        	  7358:     move.b  (A0,D2.W),D0
02:0003CAD2 123C0008        	  7359:     move.b  #$08,D1
02:0003CAD6 D101            	  7360:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAD8 19400001        	  7361:     move.b  D0,($0001,A4)
                            	  7362:     ; Only check the first bomb slot ($10).
                            	  7363:     ;
                            	  7364:     ; Store the bomb's (X + 8) in [02].
                            	  7365:     ;
02:0003CADC 7610            	  7366:     moveq   #16,D3
02:0003CADE 10343070        	  7367:     move.b  ($70,A4,D3.W),D0
02:0003CAE2 123C0008        	  7368:     move.b  #$08,D1
02:0003CAE6 D101            	  7369:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAE8 19400002        	  7370:     move.b  D0,($0002,A4)
                            	  7371:     ; Store the bomb's (Y + 8) in [03].
                            	  7372:     ;
02:0003CAEC 41EC0084        	  7373:     lea     ($0084,A4),A0
02:0003CAF0 10303000        	  7374:     move.b  (A0,D3.W),D0
02:0003CAF4 123C0008        	  7375:     move.b  #$08,D1
02:0003CAF8 D101            	  7376:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAFA 19400003        	  7377:     move.b  D0,($0003,A4)
                            	  7378:     ; But, if there's no bomb, then return.
                            	  7379:     ;
02:0003CAFE 41EC00AC        	  7380:     lea     ($00AC,A4),A0
