02:00033580 41EC0633        	   534:     lea     ($0633,A4),A0
02:00033584 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00033588 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:0003358A 1003            	   537:     move.b  D3,D0
02:0003358C 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:0003358E 19430016        	   539:     move.b  D3,($0016,A4)
02:00033592 6100D13C        	   540:     jsr     FetchFileAAddressSet
02:00033596 61001C46        	   541:     jsr     FormatFileA
02:0003359A 7000            	   542:     moveq   #0,D0
