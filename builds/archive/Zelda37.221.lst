                            	  8518:     even
                            	  8519: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8520:     ; If the teleporting distance remaining is even, then draw
                            	  8521:     ; and check collisions, else return.
                            	  8522:     ;
                            	  8523:     ; This means that when 0, the monster is walking.
                            	  8524:     ; So, draw and check collisions every frame.
                            	  8525:     ;
                            	  8526:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8527:     ; translucently -- every other frame.
                            	  8528:     ;
02:0003D33E 41EC0394        	  8529:     lea     ($0394,A4),A0
02:0003D342 10302000        	  8530:     move.b  (A0,D2.W),D0
02:0003D346 E208            	  8531:     lsr.b  #1,D0   ; LSR A
02:0003D348 6402            	  8532:     bcc.s  __far_z_04_0076
02:0003D34A 603A            	  8533:     jmp  L11E17_Exit
                            	  8534: __far_z_04_0076:
                            	  8535:     even
