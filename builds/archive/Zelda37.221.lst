                            	  3313: 
                            	  3314: _anon_z04_42:
                            	  3315:     ; State 0.
                            	  3316:     ;
                            	  3317:     ; In state we determine whether to burst out of the ground.
                            	  3318:     ; If the long timer has not expired, then return.
                            	  3319:     ;
02:0003AD96 102C004D        	  3320:     move.b  ($004D,A4),D0
02:0003AD9A 6674            	  3321:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3322:     ; Only allow two red leevers at a time.
                            	  3323:     ;
02:0003AD9C 102C0510        	  3324:     move.b  ($0510,A4),D0
02:0003ADA0 0C000002        	  3325:     cmpi.b  #$02,D0
02:0003ADA4 646A            	  3326:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3327:     ; Face in the same direction as Link.
                            	  3328:     ;
02:0003ADA6 102C0098        	  3329:     move.b  ($0098,A4),D0
02:0003ADAA 41EC0098        	  3330:     lea     ($0098,A4),A0
02:0003ADAE 11802000        	  3331:     move.b  D0,(A0,D2.W)
                            	  3332:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3333:     ;
02:0003ADB2 10342019        	  3334:     move.b  ($19,A4,D2.W),D0
02:0003ADB6 0C0000C0        	  3335:     cmpi.b  #$C0,D0
02:0003ADBA 6506            	  3336:     bcs  _anon_z04_43
02:0003ADBC 4EB90004C130    	  3337:     jsr     ReverseObjDir
                            	  3338: _anon_z04_43:
                            	  3339:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3340:     ;
02:0003ADC2 41EC0098        	  3341:     lea     ($0098,A4),A0
02:0003ADC6 10302000        	  3342:     move.b  (A0,D2.W),D0
02:0003ADCA 0200000C        	  3343:     andi.b #$0C,D0
02:0003ADCE 6742            	  3344:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3345:     ; Begin with the leever's X set to Link's X.
                            	  3346:     ;
02:0003ADD0 102C0070        	  3347:     move.b  ($0070,A4),D0
02:0003ADD4 19802070        	  3348:     move.b  D0,($70,A4,D2.W)
                            	  3349:     ; If facing down, then use Y offset $28.
                            	  3350:     ; Else store Y offset -$28 in [00].
                            	  3351:     ;
02:0003ADD8 7628            	  3352:     moveq   #40,D3
02:0003ADDA 41EC0098        	  3353:     lea     ($0098,A4),A0
02:0003ADDE 10302000        	  3354:     move.b  (A0,D2.W),D0
02:0003ADE2 02000008        	  3355:     andi.b #$08,D0
02:0003ADE6 6704            	  3356:     beq  _anon_z04_44
02:0003ADE8 163C00D8        	  3357:     move.b  #$D8,D3
                            	  3358: _anon_z04_44:
02:0003ADEC 1883            	  3359:     move.b  D3,($0000,A4)
                            	  3360:     ; Add Link's Y and the vertical offset.
                            	  3361:     ;
02:0003ADEE 102C0084        	  3362:     move.b  ($0084,A4),D0
02:0003ADF2 023C00EE        	  3363:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADF6 1214            	  3364:     move.b  ($0000,A4),D1
02:0003ADF8 D101            	  3365:     addx.b  D1,D0   ; ADC $00
                            	  3366:     ; Sanitize the Y coordinate:
                            	  3367:     ; (Y AND $F0) OR $D
                            	  3368:     ;
02:0003ADFA 020000F0        	  3369:     andi.b #$F0,D0
02:0003ADFE 0000000D        	  3370:     ori.b #$0D,D0
02:0003AE02 41EC0084        	  3371:     lea     ($0084,A4),A0
02:0003AE06 11802000        	  3372:     move.b  D0,(A0,D2.W)
                            	  3373:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3374:     ; go see if the tile is valid to come out of.
                            	  3375:     ;
                            	  3376:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3377:     ;
02:0003AE0A 0C00005D        	  3378:     cmpi.b  #$5D,D0
02:0003AE0E 647A            	  3379:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3380:     even
                            	  3381: _L_z04_UpdateRedLeever_Exit:
02:0003AE10 4E75            	  3382:     rts
                            	  3383: 
                            	  3384:     even
                            	  3385: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3386:     ; Begin with the leever's Y set to Link's Y.
                            	  3387:     ;
02:0003AE12 102C0084        	  3388:     move.b  ($0084,A4),D0
02:0003AE16 41EC0084        	  3389:     lea     ($0084,A4),A0
02:0003AE1A 11802000        	  3390:     move.b  D0,(A0,D2.W)
                            	  3391:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3392:     ; it's too close to the top edge of the screen. So, return.
                            	  3393:     ;
02:0003AE1E 0C00005D        	  3394:     cmpi.b  #$5D,D0
02:0003AE22 65EC            	  3395:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3396:     ; If facing right, then use X offset $28.
                            	  3397:     ; Else store X offset -$28 in [00].
                            	  3398:     ;
02:0003AE24 7628            	  3399:     moveq   #40,D3
02:0003AE26 41EC0098        	  3400:     lea     ($0098,A4),A0
02:0003AE2A 10302000        	  3401:     move.b  (A0,D2.W),D0
02:0003AE2E 02000002        	  3402:     andi.b #$02,D0
02:0003AE32 6704            	  3403:     beq  _anon_z04_45
02:0003AE34 163C00D8        	  3404:     move.b  #$D8,D3
                            	  3405: _anon_z04_45:
02:0003AE38 1883            	  3406:     move.b  D3,($0000,A4)
                            	  3407:     ; [01] holds Link's X coordinate.
                            	  3408:     ;
02:0003AE3A 102C0070        	  3409:     move.b  ($0070,A4),D0
02:0003AE3E 19400001        	  3410:     move.b  D0,($0001,A4)
                            	  3411:     ; Add Link's X and the horizontal offset.
                            	  3412:     ;
02:0003AE42 023C00EE        	  3413:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE46 1214            	  3414:     move.b  ($0000,A4),D1
02:0003AE48 D101            	  3415:     addx.b  D1,D0   ; ADC $00
                            	  3416:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3417:     ;
02:0003AE4A 020000F8        	  3418:     andi.b #$F8,D0
                            	  3419:     ; Assign that result to the leever's X coordinate and [02].
                            	  3420:     ;
02:0003AE4E 19802070        	  3421:     move.b  D0,($70,A4,D2.W)
02:0003AE52 19400002        	  3422:     move.b  D0,($0002,A4)
                            	  3423:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3424:     ;
02:0003AE56 122C0001        	  3425:     move.b  ($0001,A4),D1
02:0003AE5A B001            	  3426:     cmp.b   D1,D0
02:0003AE5C 6510            	  3427:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003AE5E 1B00            	  3428:     move.b  D0,-(A5)  ; PHA
02:0003AE60 102C0001        	  3429:     move.b  ($0001,A4),D0
02:0003AE64 19400002        	  3430:     move.b  D0,($0002,A4)
02:0003AE68 101D            	  3431:     move.b  (A5)+,D0  ; PLA
02:0003AE6A 19400001        	  3432:     move.b  D0,($0001,A4)
                            	  3433:     even
                            	  3434: _L_z04_UpdateRedLeever_Subtract:
                            	  3435:     ; The point is to get the absolute distance between the two.
                            	  3436:     ;
02:0003AE6E 102C0001        	  3437:     move.b  ($0001,A4),D0
02:0003AE72 003C0011        	  3438:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE76 122C0002        	  3439:     move.b  ($0002,A4),D1
02:0003AE7A 0A3C0010        	  3440:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE7E 9101            	  3441:     subx.b  D1,D0   ; SBC $02
02:0003AE80 0A3C0010        	  3442:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3443:     ; If the absolute distance >= $30, then return.
                            	  3444:     ; It means that the leever's X coordinate wrapped around
                            	  3445:     ; the left or right edge of the screen.
                            	  3446:     ;
02:0003AE84 0C000030        	  3447:     cmpi.b  #$30,D0
02:0003AE88 6486            	  3448:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3449:     even
                            	  3450: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3451:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3452:     ;
02:0003AE8A 4EB90004B9A2    	  3453:     jsr     GetCollidableTileStill
02:0003AE90 122C034A        	  3454:     move.b  ($034A,A4),D1
02:0003AE94 B001            	  3455:     cmp.b   D1,D0
02:0003AE96 6400FF78        	  3456:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003AE9A 522C0510        	  3457:     addq.b  #1,($0510,A4)
                            	  3458:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3459:     ; and pick up whatever the new value is for state 1.
                            	  3460:     ;
02:0003AE9E 7001            	  3461:     moveq   #1,D0
02:0003AEA0 41EC03D0        	  3462:     lea     ($03D0,A4),A0
02:0003AEA4 11802000        	  3463:     move.b  D0,(A0,D2.W)
                            	  3464:     ; Set the long timer to 2, meaning 20 frames.
                            	  3465:     ;
02:0003AEA8 E308            	  3466:     lsl.b  #1,D0   ; ASL A
02:0003AEAA 1940004D        	  3467:     move.b  D0,($004D,A4)
02:0003AEAE 6100008C        	  3468:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3469:     ; The leever has to face Link in order to move toward him.
                            	  3470:     ;
02:0003AEB2 4EB90004C130    	  3471:     jsr     ReverseObjDir
                            	  3472:     even
                            	  3473: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  3474:     ; If not in state 3, go check the object timer in order to draw and such.
                            	  3475:     ;
02:0003AEB8 41EC00AC        	  3476:     lea     ($00AC,A4),A0
02:0003AEBC 10302000        	  3477:     move.b  (A0,D2.W),D0
02:0003AEC0 0C000003        	  3478:     cmpi.b  #$03,D0
02:0003AEC4 666E            	  3479:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  3480:     ; State 3.
