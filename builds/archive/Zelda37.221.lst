                            	  8503: ; Description:
                            	  8504: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8505: ; When walking, the object timer is set. When teleporting,
                            	  8506: ; the teleporting distance remaining is set.
                            	  8507: ;
                            	  8508: ; If we have the magic clock, then only go draw and check collisions.
                            	  8509: ;
                            	  8510:     even
                            	  8511: UpdateBlueWizzrobe:
02:0003D330 102C066C        	  8512:     move.b  ($066C,A4),D0
02:0003D334 6702            	  8513:     beq.s  __far_z_04_0075
