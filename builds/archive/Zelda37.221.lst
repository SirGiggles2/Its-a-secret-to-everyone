                            	  2133: CheckZora:
                            	  2134:     ; If the zora attribute of this room is off, return.
                            	  2135:     ;
02:0003A564 7600            	  2136:     moveq   #0,D3
02:0003A566 162C00EB        	  2137:     move.b  ($00EB,A4),D3
02:0003A56A 41F900FF687E    	  2138:     lea     (NES_SRAM+$087E).l,A0
02:0003A570 10303000        	  2139:     move.b  (A0,D3.W),D0
02:0003A574 02000008        	  2140:     andi.b #$08,D0
02:0003A578 677C            	  2141:     beq  _L_z04_CheckZora_Exit
                            	  2142:     ; If zora is active, return.
                            	  2143:     ;
02:0003A57A 102C0514        	  2144:     move.b  ($0514,A4),D0
02:0003A57E 6676            	  2145:     bne  _L_z04_CheckZora_Exit
                            	  2146:     ; Look for an empty monster slot. If none is found, return.
                            	  2147:     ;
02:0003A580 4EB90004DA40    	  2148:     jsr     FindEmptyMonsterSlot
02:0003A586 676E            	  2149:     beq  _L_z04_CheckZora_Exit
                            	  2150:     ; Loop $D times looking for a water tile to put a zora on.
