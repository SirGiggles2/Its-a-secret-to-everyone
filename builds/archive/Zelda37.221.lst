                            	  5627:     ; If it reached the limit, set state $20 and a new movement
                            	  5628:     ; limit of $10, and go handle the rest as if blocked.
                            	  5629:     ; State $20 will become $30 below in HandleArrowOrBoomerangBlocked.
                            	  5630:     ;
                            	  5631:     ; Otherwise, only animate and check collision as usual.
                            	  5632:     ;
