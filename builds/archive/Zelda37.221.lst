02:0003D072 9101            	  8154:     subx.b  D1,D0   ; SBC #$03
02:0003D074 0A3C0010        	  8155:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D078 41EC0084        	  8156:     lea     ($0084,A4),A0
02:0003D07C 11802000        	  8157:     move.b  D0,(A0,D2.W)
