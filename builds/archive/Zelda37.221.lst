                            	  2088: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2089:     ; We got here in one of three ways:
                            	  2090:     ;
                            	  2091:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2092:     ;    explicitly.
                            	  2093:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2094:     ;    held an offset that was added to base palette attribute
                            	  2095:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2096:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2097:     ;    held absolute attributes.
                            	  2098:     ;
                            	  2099:     ; At this point, A holds the final sprite attributes.
02:0004AF14 7400            	  2100:     moveq   #0,D2
02:0004AF16 1942000C        	  2101:     move.b  D2,($000C,A4)
02:0004AF1A 740F            	  2102:     moveq   #15,D2
                            	  2103:     ; Write sprites.
                            	  2104:     ; A holds the calculated sprite attributes.
                            	  2105:     ; Y holds the item slot.
02:0004AF1C 4EF9000318A0    	  2106:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2107: 
                            	  2108:     even
                            	  2109: _L_z07_DrawItemBySlot_AddItemAndTableValue:
                            	  2110:     ; Calculate sprite attributes by adding item value / sprite palette
                            	  2111:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2112:     ; which here represents an offset from the palette row.
                            	  2113:     ;
02:0004AF22 023C00EE        	  2114:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AF26 122C0004        	  2115:     move.b  ($0004,A4),D1
02:0004AF2A D101            	  2116:     addx.b  D1,D0   ; ADC $04
02:0004AF2C 4A02            	  2117:     cmpi.b  #$00,D2
02:0004AF2E 66E4            	  2118:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AF30 0C000002        	  2119:     cmpi.b  #$02,D0
02:0004AF34 66DE            	  2120:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AF36 7620            	  2121:     moveq   #32,D3
