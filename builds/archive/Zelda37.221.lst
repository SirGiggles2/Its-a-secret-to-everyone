02:0003C85E 7600            	  7030:     moveq   #0,D3
02:0003C860 1600            	  7031:     move.b  D0,D3
02:0003C862 101D            	  7032:     move.b  (A5)+,D0  ; PLA
02:0003C864 41EC0201        	  7033:     lea     ($0201,A4),A0
