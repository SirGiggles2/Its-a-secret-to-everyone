                            	  9719: Manhandla_CheckCollisions:
                            	  9720:     ; Check collisions, but never let them interfere with movement.
                            	  9721:     ;
02:0003DC22 41EC0098        	  9722:     lea     ($0098,A4),A0
02:0003DC26 10302000        	  9723:     move.b  (A0,D2.W),D0
02:0003DC2A 1B00            	  9724:     move.b  D0,-(A5)  ; PHA
02:0003DC2C 10342028        	  9725:     move.b  ($28,A4,D2.W),D0
02:0003DC30 1B00            	  9726:     move.b  D0,-(A5)  ; PHA
02:0003DC32 4EB900031A18    	  9727:     jsr     CheckMonsterCollisions
02:0003DC38 101D            	  9728:     move.b  (A5)+,D0  ; PLA
02:0003DC3A 19802028        	  9729:     move.b  D0,($28,A4,D2.W)
02:0003DC3E 101D            	  9730:     move.b  (A5)+,D0  ; PLA
02:0003DC40 41EC0098        	  9731:     lea     ($0098,A4),A0
02:0003DC44 11802000        	  9732:     move.b  D0,(A0,D2.W)
                            	  9733:     ; Don't let the base segment be temporarily invincible.
                            	  9734:     ;
02:0003DC48 0C020005        	  9735:     cmpi.b  #$05,D2
02:0003DC4C 660A            	  9736:     bne  _anon_z04_112
02:0003DC4E 7000            	  9737:     moveq   #0,D0
02:0003DC50 41EC04F0        	  9738:     lea     ($04F0,A4),A0
02:0003DC54 11802000        	  9739:     move.b  D0,(A0,D2.W)
                            	  9740: _anon_z04_112:
02:0003DC58 6100BB0E        	  9741:     jsr     PlayBossHitCryIfNeeded
                            	  9742:     ; If still alive, then return.
                            	  9743:     ;
02:0003DC5C 41EC0405        	  9744:     lea     ($0405,A4),A0
02:0003DC60 10302000        	  9745:     move.b  (A0,D2.W),D0
02:0003DC64 674E            	  9746:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DC66 4EB90004BBD4    	  9747:     jsr     ResetShoveInfo
                            	  9748:     ; Don't let the base die on its own.
                            	  9749:     ; If this is the base, then reset metastate, and return.
                            	  9750:     ;
                            	  9751:     ; The base only dies once the last hand dies.
                            	  9752:     ;
02:0003DC6C 0C020005        	  9753:     cmpi.b  #$05,D2
02:0003DC70 660A            	  9754:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003DC72 41EC0405        	  9755:     lea     ($0405,A4),A0
02:0003DC76 11802000        	  9756:     move.b  D0,(A0,D2.W)
02:0003DC7A 6038            	  9757:     jmp     _L_z04_Manhandla_CheckCollisions_Exit
                            	  9758: 
                            	  9759:     even
                            	  9760: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9761:     ; At this point, we have a hand that just died.
                            	  9762:     ;
                            	  9763:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9764:     ;
02:0003DC7C 7603            	  9765:     moveq   #3,D3
                            	  9766:     ; Count how many are allocated.
                            	  9767:     ; This includes the current dead one, and the other living ones.
                            	  9768:     ; Store the count in [00].
                            	  9769:     ;
02:0003DC7E 7000            	  9770:     moveq   #0,D0
02:0003DC80 1880            	  9771:     move.b  D0,($0000,A4)
                            	  9772:     even
                            	  9773: _L_z04_Manhandla_CheckCollisions_LoopHand:
02:0003DC82 41EC0350        	  9774:     lea     ($0350,A4),A0
02:0003DC86 10303000        	  9775:     move.b  (A0,D3.W),D0
02:0003DC8A 0C00003C        	  9776:     cmpi.b  #$3C,D0
02:0003DC8E 6602            	  9777:     bne  _anon_z04_113
02:0003DC90 5214            	  9778:     addq.b  #1,($0000,A4)
                            	  9779: _anon_z04_113:
02:0003DC92 5303            	  9780:     subq.b  #1,D3
02:0003DC94 6AEC            	  9781:     bpl  _L_z04_Manhandla_CheckCollisions_LoopHand
                            	  9782:     ; Decrease by 1, to account for the current dead one.
                            	  9783:     ;
02:0003DC96 5314            	  9784:     subq.b  #1,($0000,A4)
                            	  9785:     ; If the count >= 0 (signed comparison), then
                            	  9786:     ; go change this hand object to the dead dummy.
