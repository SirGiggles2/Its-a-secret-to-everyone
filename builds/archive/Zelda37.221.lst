                            	  5421: UpdateBoomerangOrFood:
                            	  5422:     ; If state = 0, then not active. So, return.
                            	  5423:     ;
02:0004C666 41EC00AC        	  5424:     lea     ($00AC,A4),A0
02:0004C66A 10302000        	  5425:     move.b  (A0,D2.W),D0
02:0004C66E 6602            	  5426:     bne.s  __far_z_07_0082
02:0004C670 60F2            	  5427:     jmp  L1F49F_Exit
                            	  5428: __far_z_07_0082:
                            	  5429:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5430:     ;
02:0004C672 E308            	  5431:     lsl.b  #1,D0   ; ASL A
02:0004C674 6504            	  5432:     bcs.s  __far_z_07_0083
02:0004C676 600000AA        	  5433:     jmp  UpdateArrowOrBoomerang
                            	  5434: __far_z_07_0083:
                            	  5435:     ; The object is food.
                            	  5436:     ;
                            	  5437:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5438:     ; If we reach state $83, then go deactivate the object.
                            	  5439:     ;
                            	  5440:     ; Nothing changes between the states. So, they are used as
                            	  5441:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5442:     ;
02:0004C67A 10342028        	  5443:     move.b  ($28,A4,D2.W),D0
02:0004C67E 6622            	  5444:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004C680 41EC00AC        	  5445:     lea     ($00AC,A4),A0
02:0004C684 52302000        	  5446:     addq.b  #1,(A0,D2.W)
02:0004C688 41EC00AC        	  5447:     lea     ($00AC,A4),A0
02:0004C68C 10302000        	  5448:     move.b  (A0,D2.W),D0
02:0004C690 0200000F        	  5449:     andi.b #$0F,D0
02:0004C694 0C000003        	  5450:     cmpi.b  #$03,D0
02:0004C698 674C            	  5451:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004C69A 103C00FF        	  5452:     move.b  #$FF,D0
02:0004C69E 19802028        	  5453:     move.b  D0,($28,A4,D2.W)
                            	  5454:     even
                            	  5455: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
                            	  5456:     ; If the template object type in the room is one of:
                            	  5457:     ; moblin, goriya, octorock, vire, keese
                            	  5458:     ; then attract these monsters to the food.
                            	  5459:     ;
                            	  5460:     ; They will chase the food instead of Link when given a chance.
                            	  5461:     ;
02:0004C6A2 102C035F        	  5462:     move.b  ($035F,A4),D0
02:0004C6A6 0C000003        	  5463:     cmpi.b  #$03,D0
02:0004C6AA 652C            	  5464:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:0004C6AC 0C00000B        	  5465:     cmpi.b  #$0B,D0
02:0004C6B0 6512            	  5466:     bcs  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:0004C6B2 0C000012        	  5467:     cmpi.b  #$12,D0
