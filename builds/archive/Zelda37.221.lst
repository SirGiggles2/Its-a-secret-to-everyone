                            	  7333: Dodongo_CheckBombHit:
                            	  7334:     ; If state <> 0 (not moving), then return.
                            	  7335:     ;
02:0003CA98 41EC00AC        	  7336:     lea     ($00AC,A4),A0
02:0003CA9C 10302000        	  7337:     move.b  (A0,D2.W),D0
02:0003CAA0 66000086        	  7338:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7339:     ; If facing vertically, then store (X + 8) in [00].
                            	  7340:     ; Else store (X + $10).
                            	  7341:     ;
02:0003CAA4 10342070        	  7342:     move.b  ($70,A4,D2.W),D0
02:0003CAA8 023C00EE        	  7343:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAAC 123C0008        	  7344:     move.b  #$08,D1
02:0003CAB0 D101            	  7345:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAB2 7600            	  7346:     moveq   #0,D3
02:0003CAB4 41EC0098        	  7347:     lea     ($0098,A4),A0
02:0003CAB8 16302000        	  7348:     move.b  (A0,D2.W),D3
