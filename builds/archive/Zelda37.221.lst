                            	 11352: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 11353:     ; The whole gleeok died, because the last neck died.
                            	 11354:     ;
                            	 11355:     ; First, hide the first $10 sprites: the attached heads.
                            	 11356:     ;
02:0003E83A 4EB9000313BE    	 11357:     jsr     WriteBlankPrioritySprites
02:0003E840 61000FB8        	 11358:     jsr     PlayBossDeathCry
                            	 11359:     ; We want a death spark. So, set the metastate of the first
                            	 11360:     ; monster slot to $11.
                            	 11361:     ;
02:0003E844 7011            	 11362:     moveq   #17,D0
02:0003E846 19400406        	 11363:     move.b  D0,($0406,A4)
                            	 11364:     ; Reset the object type of slots 2 to $A.
                            	 11365:     ;
                            	 11366:     ; Beware a left over fireball in slot $B!
                            	 11367:     ;
02:0003E84A 7601            	 11368:     moveq   #1,D3
                            	 11369:     even
                            	 11370: _L_z04_Gleeok_CheckCollisions_DestroyFireballs:
02:0003E84C 7000            	 11371:     moveq   #0,D0
