02:0003AFA6 41EC034F        	  3593:     lea     ($034F,A4),A0
02:0003AFAA 16302000        	  3594:     move.b  (A0,D2.W),D3
02:0003AFAE 0C030009        	  3595:     cmpi.b  #$09,D3
