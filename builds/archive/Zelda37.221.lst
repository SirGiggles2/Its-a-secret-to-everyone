                            	  9961: Manhandla_Draw:
02:0003DDEC 4EB90004D250    	  9962:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9963:     ; Push the "frame image and sprite attributes" value.
                            	  9964:     ;
02:0003DDF2 41EC0478        	  9965:     lea     ($0478,A4),A0
02:0003DDF6 10302000        	  9966:     move.b  (A0,D2.W),D0
02:0003DDFA 1B00            	  9967:     move.b  D0,-(A5)  ; PHA
                            	  9968:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9969:     ; passed along as is.
                            	  9970:     ;
02:0003DDFC 02000080        	  9971:     andi.b #$80,D0
02:0003DE00 00000001        	  9972:     ori.b #$01,D0
02:0003DE04 4EB90003198E    	  9973:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DE0A 101D            	  9974:     move.b  (A5)+,D0  ; PLA
02:0003DE0C 1B00            	  9975:     move.b  D0,-(A5)  ; PHA
                            	  9976:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9977:     ;
02:0003DE0E 02000040        	  9978:     andi.b #$40,D0
02:0003DE12 6704            	  9979:     beq  _anon_z04_116
02:0003DE14 522C000F        	  9980:     addq.b  #1,($000F,A4)
                            	  9981: _anon_z04_116:
02:0003DE18 101D            	  9982:     move.b  (A5)+,D0  ; PLA
                            	  9983:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9984:     ; These are the 2 frame images of the horizontal hands.
                            	  9985:     ;
                            	  9986:     ; Else draw the base and vertical hands mirrored.
                            	  9987:     ;
02:0003DE1A 0200000F        	  9988:     andi.b #$0F,D0
02:0003DE1E 0C000002        	  9989:     cmpi.b  #$02,D0
02:0003DE22 670C            	  9990:     beq  _anon_z04_117
02:0003DE24 0C000003        	  9991:     cmpi.b  #$03,D0
02:0003DE28 6706            	  9992:     beq  _anon_z04_117
02:0003DE2A 4EF900031698    	  9993:     jmp     DrawObjectMirrored
                            	  9994: 
                            	  9995: _anon_z04_117:
