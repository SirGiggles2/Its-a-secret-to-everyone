02:0003ACDA 7600            	  3222:     moveq   #0,D3
02:0003ACDC 41EC00AC        	  3223:     lea     ($00AC,A4),A0
02:0003ACE0 16302000        	  3224:     move.b  (A0,D2.W),D3
