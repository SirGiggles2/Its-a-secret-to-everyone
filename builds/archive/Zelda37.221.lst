02:0004C992 11802000        	  5901:     move.b  D0,(A0,D2.W)
                            	  5902:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5903:     ;
02:0004C996 0C02000D        	  5904:     cmpi.b  #$0D,D2
02:0004C99A 6408            	  5905:     bcc  _anon_z07_30
02:0004C99C 41EC042C        	  5906:     lea     ($042C,A4),A0
02:0004C9A0 10302000        	  5907:     move.b  (A0,D2.W),D0
                            	  5908: _anon_z07_30:
02:0004C9A4 4EB900030B56    	  5909:     jsr     GetDirectionsAndDistancesToTarget
                            	  5910:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5911:     ; then go move towards the thrower, draw, and check collisions.
                            	  5912:     ;
02:0004C9AA 1014            	  5913:     move.b  ($0000,A4),D0
02:0004C9AC 0C000002        	  5914:     cmpi.b  #$02,D0
02:0004C9B0 666A            	  5915:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5916:     ; The boomerang has reached the thrower.
                            	  5917:     ;
                            	  5918:     ; Reset the distance to move.
                            	  5919:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5920:     ;
02:0004C9B2 7000            	  5921:     moveq   #0,D0
02:0004C9B4 41EC0380        	  5922:     lea     ($0380,A4),A0
02:0004C9B8 11802000        	  5923:     move.b  D0,(A0,D2.W)
02:0004C9BC 0C02000D        	  5924:     cmpi.b  #$0D,D2
02:0004C9C0 6524            	  5925:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5926:     ; Link has caught the boomerang.
                            	  5927:     ;
                            	  5928:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5929:     ;
                            	  5930:     ; If Link catches it some time after throwing it,
                            	  5931:     ; his state will become $20, and he will show the catch animation.
                            	  5932:     ;
                            	  5933:     ; But if he catches it right after throwing it, the state becomes
                            	  5934:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5935:     ;
02:0004C9C2 102C00AC        	  5936:     move.b  ($00AC,A4),D0
02:0004C9C6 00000020        	  5937:     ori.b #$20,D0
02:0004C9CA 194000AC        	  5938:     move.b  D0,($00AC,A4)
                            	  5939:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5940:     ; up the new state.
                            	  5941:     ;
02:0004C9CE 7001            	  5942:     moveq   #1,D0
02:0004C9D0 194003D0        	  5943:     move.b  D0,($03D0,A4)
                            	  5944:     ; Deactivate the boomerang.
                            	  5945:     ;
02:0004C9D4 760F            	  5946:     moveq   #15,D3
02:0004C9D6 7000            	  5947:     moveq   #0,D0
02:0004C9D8 41EC00AC        	  5948:     lea     ($00AC,A4),A0
02:0004C9DC 11803000        	  5949:     move.b  D0,(A0,D3.W)
02:0004C9E0 0A3C0001        	  5950:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C9E4 4E75            	  5951:     rts
