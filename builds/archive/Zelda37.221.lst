                            	  7911: _L_z04_UpdatePolsVoice_State0:
                            	  7912:     ; State 0. Walking.
                            	  7913:     ;
                            	  7914:     ; If grid offset = 0, then no more distance to cover.
                            	  7915:     ; So, go change to state 1 -- jumping.
                            	  7916:     ;
02:0003CE58 41EC0394        	  7917:     lea     ($0394,A4),A0
02:0003CE5C 10302000        	  7918:     move.b  (A0,D2.W),D0
02:0003CE60 67000084        	  7919:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7920:     ; Decrement grid offset / distance remaining.
                            	  7921:     ;
02:0003CE64 41EC0394        	  7922:     lea     ($0394,A4),A0
02:0003CE68 53302000        	  7923:     subq.b  #1,(A0,D2.W)
                            	  7924:     ; Move vertically.
                            	  7925:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7926:     ;
02:0003CE6C 41EC0084        	  7927:     lea     ($0084,A4),A0
02:0003CE70 10302000        	  7928:     move.b  (A0,D2.W),D0
02:0003CE74 023C00EE        	  7929:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE78 41F90003CE08    	  7930:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CE7E 12303000        	  7931:     move.b  (A0,D3.W),D1
02:0003CE82 D101            	  7932:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003CE84 41EC0084        	  7933:     lea     ($0084,A4),A0
02:0003CE88 11802000        	  7934:     move.b  D0,(A0,D2.W)
                            	  7935:     even
                            	  7936: _L_z04_UpdatePolsVoice_CheckWalkability:
