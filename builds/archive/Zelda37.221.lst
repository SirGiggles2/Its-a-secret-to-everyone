                            	  8059: UpdatePolsVoiceState1_Jumping:
                            	  8060:     ; Add acceleration $38 to low speed byte (vertical).
                            	  8061:     ;
02:0003CF84 41EC0444        	  8062:     lea     ($0444,A4),A0
02:0003CF88 10302000        	  8063:     move.b  (A0,D2.W),D0
02:0003CF8C 023C00EE        	  8064:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF90 123C0038        	  8065:     move.b  #$38,D1
02:0003CF94 D101            	  8066:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CF96 41EC0444        	  8067:     lea     ($0444,A4),A0
02:0003CF9A 11802000        	  8068:     move.b  D0,(A0,D2.W)
                            	  8069:     ; Add Carry to high speed byte (vertical).
                            	  8070:     ;
02:0003CF9E 41EC0412        	  8071:     lea     ($0412,A4),A0
02:0003CFA2 10302000        	  8072:     move.b  (A0,D2.W),D0
02:0003CFA6 123C0000        	  8073:     move.b  #$00,D1
02:0003CFAA D101            	  8074:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CFAC 41EC0412        	  8075:     lea     ($0412,A4),A0
02:0003CFB0 11802000        	  8076:     move.b  D0,(A0,D2.W)
                            	  8077:     ; Add high speed byte to Y coordinate.
                            	  8078:     ;
02:0003CFB4 023C00EE        	  8079:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFB8 41EC0084        	  8080:     lea     ($0084,A4),A0
02:0003CFBC 12302000        	  8081:     move.b  (A0,D2.W),D1
