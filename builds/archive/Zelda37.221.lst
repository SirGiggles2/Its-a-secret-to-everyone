02:0004C95A 670A            	  5860:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004C95C 10342070        	  5861:     move.b  ($70,A4,D2.W),D0
02:0004C960 0C000002        	  5862:     cmpi.b  #$02,D0
