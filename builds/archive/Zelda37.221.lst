                            	  9827: Manhandla_Move:
                            	  9828:     ; Implement a way of manifesting the fractional part of the speed
                            	  9829:     ; in the movement.
                            	  9830:     ;
                            	  9831:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9832:     ; byte to add to the coordinates, then the effective speed would
                            	  9833:     ; be 1 pixel a frame instead of 1.25.
                            	  9834:     ;
                            	  9835:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9836:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9837:     ;
                            	  9838:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9839:     ;
                            	  9840:     ;   SA := SA + (SL AND $E0)
                            	  9841:     ;   [03] := SH + carry
                            	  9842:     ;
                            	  9843:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9844:     ;
02:0003DCC8 41EC041F        	  9845:     lea     ($041F,A4),A0
02:0003DCCC 10302000        	  9846:     move.b  (A0,D2.W),D0
02:0003DCD0 020000E0        	  9847:     andi.b #$E0,D0
02:0003DCD4 023C00EE        	  9848:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DCD8 41EC0412        	  9849:     lea     ($0412,A4),A0
02:0003DCDC 12302000        	  9850:     move.b  (A0,D2.W),D1
02:0003DCE0 D101            	  9851:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DCE2 41EC0412        	  9852:     lea     ($0412,A4),A0
02:0003DCE6 11802000        	  9853:     move.b  D0,(A0,D2.W)
                            	  9854:     ; Assign (high speed byte + carry) to [03].
                            	  9855:     ;
02:0003DCEA 41EC042C        	  9856:     lea     ($042C,A4),A0
02:0003DCEE 10302000        	  9857:     move.b  (A0,D2.W),D0
02:0003DCF2 123C0000        	  9858:     move.b  #$00,D1
02:0003DCF6 D101            	  9859:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DCF8 19400003        	  9860:     move.b  D0,($0003,A4)
                            	  9861:     ; Change coordinates by the speed amount/offset in [03]
                            	  9862:     ; according to the direction.
                            	  9863:     ;
                            	  9864:     ; Start with a mask of $A1 in [02]:
                            	  9865:     ; - low nibble represents the right direction
                            	  9866:     ; - high nibble is used to set or clear carry as we go along
                            	  9867:     ;
02:0003DCFC 103C00A1        	  9868:     move.b  #$A1,D0
02:0003DD00 19400002        	  9869:     move.b  D0,($0002,A4)
                            	  9870:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9871:     ;
02:0003DD04 41EC0098        	  9872:     lea     ($0098,A4),A0
02:0003DD08 10302000        	  9873:     move.b  (A0,D2.W),D0
02:0003DD0C 122C0002        	  9874:     move.b  ($0002,A4),D1
02:0003DD10 C200            	  9875:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD12 6712            	  9876:     beq  _L_z04_Manhandla_Move_Left
02:0003DD14 10342070        	  9877:     move.b  ($70,A4,D2.W),D0
02:0003DD18 023C00EE        	  9878:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD1C 122C0003        	  9879:     move.b  ($0003,A4),D1
02:0003DD20 D101            	  9880:     addx.b  D1,D0   ; ADC $03
02:0003DD22 19802070        	  9881:     move.b  D0,($70,A4,D2.W)
                            	  9882:     even
                            	  9883: _L_z04_Manhandla_Move_Left:
                            	  9884:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9885:     ;
02:0003DD26 41EC0098        	  9886:     lea     ($0098,A4),A0
02:0003DD2A 10302000        	  9887:     move.b  (A0,D2.W),D0
02:0003DD2E 122C0002        	  9888:     move.b  ($0002,A4),D1
02:0003DD32 E309            	  9889:     lsl.b  #1,D1   ; ASL $02
02:0003DD34 19410002        	  9890:     move.b  D1,($0002,A4)
02:0003DD38 122C0002        	  9891:     move.b  ($0002,A4),D1
02:0003DD3C C200            	  9892:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD3E 6716            	  9893:     beq  _L_z04_Manhandla_Move_Down
02:0003DD40 10342070        	  9894:     move.b  ($70,A4,D2.W),D0
02:0003DD44 122C0003        	  9895:     move.b  ($0003,A4),D1
02:0003DD48 0A3C0010        	  9896:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD4C 9101            	  9897:     subx.b  D1,D0   ; SBC $03
02:0003DD4E 0A3C0010        	  9898:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD52 19802070        	  9899:     move.b  D0,($70,A4,D2.W)
                            	  9900:     even
                            	  9901: _L_z04_Manhandla_Move_Down:
                            	  9902:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9903:     ;
02:0003DD56 41EC0098        	  9904:     lea     ($0098,A4),A0
02:0003DD5A 10302000        	  9905:     move.b  (A0,D2.W),D0
02:0003DD5E 122C0002        	  9906:     move.b  ($0002,A4),D1
02:0003DD62 E309            	  9907:     lsl.b  #1,D1   ; ASL $02
02:0003DD64 19410002        	  9908:     move.b  D1,($0002,A4)
02:0003DD68 122C0002        	  9909:     move.b  ($0002,A4),D1
02:0003DD6C C200            	  9910:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD6E 6716            	  9911:     beq  _L_z04_Manhandla_Move_Up
02:0003DD70 41EC0084        	  9912:     lea     ($0084,A4),A0
02:0003DD74 10302000        	  9913:     move.b  (A0,D2.W),D0
02:0003DD78 122C0003        	  9914:     move.b  ($0003,A4),D1
02:0003DD7C D101            	  9915:     addx.b  D1,D0   ; ADC $03
02:0003DD7E 41EC0084        	  9916:     lea     ($0084,A4),A0
02:0003DD82 11802000        	  9917:     move.b  D0,(A0,D2.W)
                            	  9918:     even
                            	  9919: _L_z04_Manhandla_Move_Up:
                            	  9920:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9921:     ;
02:0003DD86 41EC0098        	  9922:     lea     ($0098,A4),A0
02:0003DD8A 10302000        	  9923:     move.b  (A0,D2.W),D0
02:0003DD8E 122C0002        	  9924:     move.b  ($0002,A4),D1
02:0003DD92 E309            	  9925:     lsl.b  #1,D1   ; ASL $02
02:0003DD94 19410002        	  9926:     move.b  D1,($0002,A4)
02:0003DD98 122C0002        	  9927:     move.b  ($0002,A4),D1
02:0003DD9C C200            	  9928:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD9E 671E            	  9929:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DDA0 41EC0084        	  9930:     lea     ($0084,A4),A0
02:0003DDA4 10302000        	  9931:     move.b  (A0,D2.W),D0
02:0003DDA8 122C0003        	  9932:     move.b  ($0003,A4),D1
02:0003DDAC 0A3C0010        	  9933:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DDB0 9101            	  9934:     subx.b  D1,D0   ; SBC $03
02:0003DDB2 0A3C0010        	  9935:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DDB6 41EC0084        	  9936:     lea     ($0084,A4),A0
02:0003DDBA 11802000        	  9937:     move.b  D0,(A0,D2.W)
                            	  9938:     even
                            	  9939: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9940:     ; To the frame accumulator, add:
                            	  9941:     ; - a random value between 0 and 3
                            	  9942:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9943:     ;
02:0003DDBE 10342019        	  9944:     move.b  ($19,A4,D2.W),D0
02:0003DDC2 02000003        	  9945:     andi.b #$03,D0
02:0003DDC6 023C00EE        	  9946:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDCA 122C0003        	  9947:     move.b  ($0003,A4),D1
02:0003DDCE D101            	  9948:     addx.b  D1,D0   ; ADC $03
02:0003DDD0 41EC0451        	  9949:     lea     ($0451,A4),A0
02:0003DDD4 12302000        	  9950:     move.b  (A0,D2.W),D1
02:0003DDD8 D101            	  9951:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DDDA 41EC0451        	  9952:     lea     ($0451,A4),A0
02:0003DDDE 11802000        	  9953:     move.b  D0,(A0,D2.W)
02:0003DDE2 61001ED2        	  9954:     jsr     BoundFlyer
                            	  9955:     ; TODO:
                            	  9956:     ; I don't see why this is needed.
                            	  9957:     ;
02:0003DDE6 4EF90004D250    	  9958:     jmp     Anim_FetchObjPosForSpriteDescriptor
