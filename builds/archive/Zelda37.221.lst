02:000368A4 19400330        	  5197:     move.b  D0,($0330,A4)
                            	  5198:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5199:     ;
02:000368A8 7020            	  5200:     moveq   #32,D0
02:000368AA 19400304        	  5201:     move.b  D0,($0304,A4)
                            	  5202:     ; Write the high byte of the current VRAM page.
                            	  5203:     ;
02:000368AE 7400            	  5204:     moveq   #0,D2
02:000368B0 142C050C        	  5205:     move.b  ($050C,A4),D2
02:000368B4 41F90003665A    	  5206:     lea     (CreditLineVramAddrsHi).l,A0
02:000368BA 10302000        	  5207:     move.b  (A0,D2.W),D0
02:000368BE 19400302        	  5208:     move.b  D0,($0302,A4)
                            	  5209:     ; The line number will be used to shift the task mask below.
                            	  5210:     ;
02:000368C2 102C050D        	  5211:     move.b  ($050D,A4),D0
02:000368C6 7600            	  5212:     moveq   #0,D3
02:000368C8 1600            	  5213:     move.b  D0,D3
                            	  5214:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5215:     ;
02:000368CA E308            	  5216:     lsl.b  #1,D0   ; ASL A
02:000368CC E308            	  5217:     lsl.b  #1,D0   ; ASL A
02:000368CE E308            	  5218:     lsl.b  #1,D0   ; ASL A
02:000368D0 E308            	  5219:     lsl.b  #1,D0   ; ASL A
02:000368D2 E308            	  5220:     lsl.b  #1,D0   ; ASL A
02:000368D4 19400303        	  5221:     move.b  D0,($0303,A4)
                            	  5222:     ; Get the mask for the current VRAM page.
                            	  5223:     ;
02:000368D8 41F900036666    	  5224:     lea     (CreditsPagesTextMasks).l,A0
02:000368DE 10302000        	  5225:     move.b  (A0,D2.W),D0
                            	  5226: _anon_z02_43:
                            	  5227:     ; Shift left as many times as the current VRAM line number,
