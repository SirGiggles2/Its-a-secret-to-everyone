                            	   339:     ; If in OW or in a cellar, we're done. Return.
                            	   340:     ;
02:00040200 522C00E1        	   341:     addq.b  #1,($00E1,A4)
02:00040204 102C0010        	   342:     move.b  ($0010,A4),D0
02:00040208 67000084        	   343:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:0004020C 102C0012        	   344:     move.b  ($0012,A4),D0
02:00040210 0C000009        	   345:     cmpi.b  #$09,D0
02:00040214 6778            	   346:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   347:     ; Calculate the X coordinate of the submenu position marker.
                            	   348:     ;
                            	   349:     ; First, mask off the high nibble of the room ID and multiply by
                            	   350:     ; the width of a tile, 8. Store the result in [00].
                            	   351:     ;
02:00040216 102C00EB        	   352:     move.b  ($00EB,A4),D0
02:0004021A 0200000F        	   353:     andi.b #$0F,D0
02:0004021E E308            	   354:     lsl.b  #1,D0   ; ASL A
02:00040220 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:00040222 E308            	   356:     lsl.b  #1,D0   ; ASL A
02:00040224 1880            	   357:     move.b  D0,($0000,A4)
                            	   358:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   359:     ; negative or left rotation by ($10 - rotation value).
                            	   360:     ;
                            	   361:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   362:     ; the width of a tile. Then negate it. The final result is the
                            	   363:     ; negative offset.
                            	   364:     ;
02:00040226 103900FF6BAB    	   365:     move.b  (NES_SRAM+$0BAB).l,D0
02:0004022C 0C000008        	   366:     cmpi.b  #$08,D0
02:00040230 6520            	   367:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:00040232 7010            	   368:     moveq   #16,D0
02:00040234 123900FF6BAB    	   369:     move.b  (NES_SRAM+$0BAB).l,D1
02:0004023A 0A3C0010        	   370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004023E 9101            	   371:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:00040240 0A3C0010        	   372:     eori    #$10,CCR  ; restore X = 6502 C
02:00040244 E308            	   373:     lsl.b  #1,D0   ; ASL A
02:00040246 E308            	   374:     lsl.b  #1,D0   ; ASL A
02:00040248 E308            	   375:     lsl.b  #1,D0   ; ASL A
