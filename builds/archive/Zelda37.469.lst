02:0003C3C6 E308            	  9400:     lsl.b  #1,D0   ; ASL A
02:0003C3C8 1214            	  9401:     move.b  ($0000,A4),D1
02:0003C3CA 8001            	  9402:     or.b  D1,D0
02:0003C3CC 1880            	  9403:     move.b  D0,($0000,A4)
