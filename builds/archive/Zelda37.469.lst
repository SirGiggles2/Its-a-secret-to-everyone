02:0003A0FE 7600            	  4615:     moveq   #0,D3
02:0003A100 1600            	  4616:     move.b  D0,D3
02:0003A102 5203            	  4617:     addq.b  #1,D3
02:0003A104 41EC0098        	  4618:     lea     ($0098,A4),A0
02:0003A108 11832000        	  4619:     move.b  D3,(A0,D2.W)
02:0003A10C 4E75            	  4620:     rts
