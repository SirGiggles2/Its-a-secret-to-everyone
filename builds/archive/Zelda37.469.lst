                            	  1579:     ;
02:00038B00 7603            	  1580:     moveq   #3,D3
02:00038B02 41EC0084        	  1581:     lea     ($0084,A4),A0
02:00038B06 10302000        	  1582:     move.b  (A0,D2.W),D0
02:00038B0A 122C0084        	  1583:     move.b  ($0084,A4),D1
02:00038B0E B001            	  1584:     cmp.b   D1,D0
02:00038B10 6402            	  1585:     bcc  _anon_z04_40
02:00038B12 5303            	  1586:     subq.b  #1,D3
                            	  1587: _anon_z04_40:
02:00038B14 41EC0098        	  1588:     lea     ($0098,A4),A0
