02:00048750 7000            	  5404:     moveq   #0,D0
02:00048752 1940000F        	  5405:     move.b  D0,($000F,A4)
                            	  5406:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5407:     ; and go draw.
                            	  5408:     ;
02:00048756 41EC0098        	  5409:     lea     ($0098,A4),A0
