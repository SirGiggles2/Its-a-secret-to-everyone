02:00041248 0C030085        	  7844:     cmpi.b  #$85,D3
02:0004124C 6642            	  7845:     bne  _anon_z05_177
02:0004124E 102C0098        	  7846:     move.b  ($0098,A4),D0
02:00041252 02000004        	  7847:     andi.b #$04,D0
02:00041256 6738            	  7848:     beq  _anon_z05_177
