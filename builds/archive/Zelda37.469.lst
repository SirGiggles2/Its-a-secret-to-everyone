02:0003A15A 41EC0098        	  4666:     lea     ($0098,A4),A0
02:0003A15E 16302000        	  4667:     move.b  (A0,D2.W),D3
02:0003A162 5303            	  4668:     subq.b  #1,D3
                            	  4669:     ; Add the speed to the X coordinate.
                            	  4670:     ;
02:0003A164 10342070        	  4671:     move.b  ($70,A4,D2.W),D0
02:0003A168 023C00EE        	  4672:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A16C 41F90003A0D6    	  4673:     lea     (AquamentusSpeeds).l,A0
02:0003A172 12303000        	  4674:     move.b  (A0,D3.W),D1
02:0003A176 D101            	  4675:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
02:0003A178 19802070        	  4676:     move.b  D0,($70,A4,D2.W)
