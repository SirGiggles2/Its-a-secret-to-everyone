02:00038B1C 41EC00AC        	  1594:     lea     ($00AC,A4),A0
02:00038B20 10302000        	  1595:     move.b  (A0,D2.W),D0
02:00038B24 023C00EE        	  1596:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B28 123C0001        	  1597:     move.b  #$01,D1
02:00038B2C D101            	  1598:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038B2E 0C000006        	  1599:     cmpi.b  #$06,D0
02:00038B32 6502            	  1600:     bcs  _anon_z04_41
