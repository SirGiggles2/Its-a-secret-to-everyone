                            	  7882: PatraChild_State1:
                            	  7883:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	  7884:     ;
02:0003B96C 10342070        	  7885:     move.b  ($70,A4,D2.W),D0
02:0003B970 023C00EE        	  7886:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B974 122C046C        	  7887:     move.b  ($046C,A4),D1
02:0003B978 D101            	  7888:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003B97A 19802070        	  7889:     move.b  D0,($70,A4,D2.W)
02:0003B97E 41EC0084        	  7890:     lea     ($0084,A4),A0
02:0003B982 10302000        	  7891:     move.b  (A0,D2.W),D0
02:0003B986 023C00EE        	  7892:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B98A 122C0479        	  7893:     move.b  ($0479,A4),D1
02:0003B98E D101            	  7894:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003B990 41EC0084        	  7895:     lea     ($0084,A4),A0
02:0003B994 11802000        	  7896:     move.b  D0,(A0,D2.W)
                            	  7897:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  7898:     ;
02:0003B998 7000            	  7899:     moveq   #0,D0
02:0003B99A 1940000B        	  7900:     move.b  D0,($000B,A4)
                            	  7901:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  7902:     ; monster's angle by $70, else by $60 to go slower.
                            	  7903:     ;
02:0003B99E 7070            	  7904:     moveq   #112,D0
02:0003B9A0 7600            	  7905:     moveq   #0,D3
02:0003B9A2 41EC034F        	  7906:     lea     ($034F,A4),A0
02:0003B9A6 16302000        	  7907:     move.b  (A0,D2.W),D3
02:0003B9AA 0C030025        	  7908:     cmpi.b  #$25,D3
02:0003B9AE 6702            	  7909:     beq  _anon_z04_159
02:0003B9B0 7060            	  7910:     moveq   #96,D0
                            	  7911: _anon_z04_159:
02:0003B9B2 61000CC0        	  7912:     jsr     DecreaseObjectAngle
                            	  7913:     ; Load Patra's maneuver index.
                            	  7914:     ; It determines which counts of bits are looked up below.
                            	  7915:     ;
02:0003B9B6 7600            	  7916:     moveq   #0,D3
02:0003B9B8 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003B9BC 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003B9C0 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003B9C4 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003B9C8 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003B9CA 41F90003B8BC    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003B9D0 10303000        	  7927:     move.b  (A0,D3.W),D0
02:0003B9D4 1B00            	  7928:     move.b  D0,-(A5)  ; PHA
02:0003B9D6 41F90003B8C0    	  7929:     lea     (PatraChild1RotationSineBits).l,A0
02:0003B9DC 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0003B9E0 7600            	  7931:     moveq   #0,D3
02:0003B9E2 1600            	  7932:     move.b  D0,D3
02:0003B9E4 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0003B9E6 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  7939:     ; for both Y and X increment calculations in rotation. This leads to
                            	  7940:     ; a small circle (5) and a large circle (6).
                            	  7941:     ;
02:0003B9E8 41F90003B8BE    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0003B9EE 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0003B9F2 7600            	  7944:     moveq   #0,D3
02:0003B9F4 1600            	  7945:     move.b  D0,D3
                            	  7946:     even
