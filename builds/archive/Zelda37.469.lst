02:000399EA 41EC0420        	  3652:     lea     ($0420,A4),A0
02:000399EE 11803000        	  3653:     move.b  D0,(A0,D3.W)
02:000399F2 7002            	  3654:     moveq   #2,D0
02:000399F4 41EC0445        	  3655:     lea     ($0445,A4),A0
02:000399F8 11803000        	  3656:     move.b  D0,(A0,D3.W)
02:000399FC 7041            	  3657:     moveq   #65,D0
02:000399FE 41EC0350        	  3658:     lea     ($0350,A4),A0
02:00039A02 11803000        	  3659:     move.b  D0,(A0,D3.W)
