02:00034F40 41EC0302        	  4493:     lea     ($0302,A4),A0
02:00034F44 11803000        	  4494:     move.b  D0,(A0,D3.W)
02:00034F48 5303            	  4495:     subq.b  #1,D3
02:00034F4A 6AEA            	  4496:     bpl  _anon_z02_35
                            	  4497:     ; Load a character from the string and copy it to
                            	  4498:     ; the transfer record until we read character $FF.
                            	  4499:     ;
02:00034F4C 7600            	  4500:     moveq   #0,D3
02:00034F4E 162C0413        	  4501:     move.b  ($0413,A4),D3
02:00034F52 41F900034EEC    	  4502:     lea     (PeaceText).l,A0
02:00034F58 10303000        	  4503:     move.b  (A0,D3.W),D0
02:00034F5C 0C0000FF        	  4504:     cmpi.b  #$FF,D0
02:00034F60 6730            	  4505:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034F62 19400305        	  4506:     move.b  D0,($0305,A4)
                            	  4507:     ; A regular space takes as much time to emit as any character.
                            	  4508:     ; But it makes no sound.
                            	  4509:     ;
02:00034F66 0C000024        	  4510:     cmpi.b  #$24,D0
02:00034F6A 6706            	  4511:     beq  _anon_z02_36
