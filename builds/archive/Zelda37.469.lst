02:00039D76 19802070        	  4204:     move.b  D0,($70,A4,D2.W)
02:00039D7A 41EC0084        	  4205:     lea     ($0084,A4),A0
02:00039D7E 10302000        	  4206:     move.b  (A0,D2.W),D0
02:00039D82 023C00EE        	  4207:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039D86 41F900039C22    	  4208:     lea     (DigdoggerCornerOffsetsY).l,A0
02:00039D8C 12303000        	  4209:     move.b  (A0,D3.W),D1
02:00039D90 D101            	  4210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:00039D92 41EC0084        	  4211:     lea     ($0084,A4),A0
02:00039D96 11802000        	  4212:     move.b  D0,(A0,D2.W)
                            	  4213:     ; Check the room boundary and object collisions in this temporary location.
