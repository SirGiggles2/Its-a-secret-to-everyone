                            	  6712:     ; The object's Y is the sprite's.
                            	  6713:     ;
02:0003B0A0 41EC0084        	  6714:     lea     ($0084,A4),A0
02:0003B0A4 10302000        	  6715:     move.b  (A0,D2.W),D0
02:0003B0A8 19400001        	  6716:     move.b  D0,($0001,A4)
02:0003B0AC 612A            	  6717:     jsr     Gohma_SetSpriteAttributes
                            	  6718:     ; There are only two frame images for legs: left and right.
                            	  6719:     ; There are two animation frames. They are animated as follows:
                            	  6720:     ;
                            	  6721:     ; Frame 0:
                            	  6722:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  6723:     ; horizontal flipping = frame number = 0
                            	  6724:     ; 
                            	  6725:     ; Frame 1:
                            	  6726:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  6727:     ; horizontal flipping = frame number = 1
                            	  6728:     ;
02:0003B0AE 4EB90004904A    	  6729:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B0B4 1003            	  6730:     move.b  D3,D0
02:0003B0B6 023C00EE        	  6731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0BA 41EC03E4        	  6732:     lea     ($03E4,A4),A0
02:0003B0BE 12302000        	  6733:     move.b  (A0,D2.W),D1
02:0003B0C2 D101            	  6734:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0C4 02000001        	  6735:     andi.b #$01,D0
02:0003B0C8 023C00EE        	  6736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0CC 123C0004        	  6737:     move.b  #$04,D1
02:0003B0D0 D101            	  6738:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B0D2 4EF900030E04    	  6739:     jmp     DrawObjectNotMirrored
