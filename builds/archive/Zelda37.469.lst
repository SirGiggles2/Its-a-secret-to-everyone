02:00048468 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004846C 123C0001        	  4968:     move.b  #$01,D1
02:00048470 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048472 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
02:00048476 101D            	  4973:     move.b  (A5)+,D0  ; PLA
02:00048478 7600            	  4974:     moveq   #0,D3
02:0004847A 1600            	  4975:     move.b  D0,D3
02:0004847C 5303            	  4976:     subq.b  #1,D3
