02:0003DF30 6710            	  2764:     beq  _anon_z05_76
02:0003DF32 1003            	  2765:     move.b  D3,D0
02:0003DF34 023C00EE        	  2766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF38 123C0004        	  2767:     move.b  #$04,D1
02:0003DF3C D101            	  2768:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DF3E 7600            	  2769:     moveq   #0,D3
02:0003DF40 1600            	  2770:     move.b  D0,D3
                            	  2771: _anon_z05_76:
                            	  2772:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2773:     ;
02:0003DF42 7000            	  2774:     moveq   #0,D0
                            	  2775: ; Params:
                            	  2776: ; A: mask of buttons to block
                            	  2777: ; Y: offset into BorderBounds
                            	  2778: ; [00]: direction
                            	  2779: ; [02]: coordinate
                            	  2780: ;
                            	  2781: ; Returns:
                            	  2782: ; [01]: button mask that was used
                            	  2783: ;       (set to $FF if boundary not crossed)
                            	  2784: ;
                            	  2785:     even
                            	  2786: MaskInputInBorder:
02:0003DF44 19400001        	  2787:     move.b  D0,($0001,A4)
                            	  2788:     ; If direction is positive (right or down), then go handle it separately.
                            	  2789:     ;
02:0003DF48 1014            	  2790:     move.b  ($0000,A4),D0
