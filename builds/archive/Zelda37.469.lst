02:00039E84 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039E88 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039E8C B001            	  4315:     cmp.b   D1,D0
02:00039E8E 6704            	  4316:     beq.s  __far_z_04_0038
