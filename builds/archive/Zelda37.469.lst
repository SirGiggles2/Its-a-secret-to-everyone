02:0003E6B8 41F90003E63E    	  3915:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E6BE 12303000        	  3916:     move.b  (A0,D3.W),D1
02:0003E6C2 B001            	  3917:     cmp.b   D1,D0
