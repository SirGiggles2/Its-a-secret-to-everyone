02:0003B908 0C020009        	  7831:     cmpi.b  #$09,D2
02:0003B90C 6604            	  7832:     bne  _anon_z04_157
02:0003B90E 522C00AD        	  7833:     addq.b  #1,($00AD,A4)
                            	  7834: _anon_z04_157:
                            	  7835:     ; Go to state 1 to orbit.
                            	  7836:     ;
02:0003B912 41EC00AC        	  7837:     lea     ($00AC,A4),A0
02:0003B916 52302000        	  7838:     addq.b  #1,(A0,D2.W)
                            	  7839:     ; TODO: ?
                            	  7840:     ;
02:0003B91A 103C0080        	  7841:     move.b  #$80,D0
02:0003B91E 41EC0098        	  7842:     lea     ($0098,A4),A0
02:0003B922 11802000        	  7843:     move.b  D0,(A0,D2.W)
                            	  7844:     ; Set angle $18 (N).
                            	  7845:     ;
02:0003B926 7018            	  7846:     moveq   #24,D0
02:0003B928 41EC0394        	  7847:     lea     ($0394,A4),A0
02:0003B92C 11802000        	  7848:     move.b  D0,(A0,D2.W)
                            	  7849:     ; This location is right above Patra.
                            	  7850:     ; Set X coordinate to Patra's.
                            	  7851:     ;
02:0003B930 102C0071        	  7852:     move.b  ($0071,A4),D0
02:0003B934 19802070        	  7853:     move.b  D0,($70,A4,D2.W)
                            	  7854:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  7855:     ; Else use radius $18. Store the chosen value in [00].
                            	  7856:     ;
02:0003B938 702C            	  7857:     moveq   #44,D0
02:0003B93A 7600            	  7858:     moveq   #0,D3
02:0003B93C 41EC034F        	  7859:     lea     ($034F,A4),A0
02:0003B940 16302000        	  7860:     move.b  (A0,D2.W),D3
02:0003B944 0C030025        	  7861:     cmpi.b  #$25,D3
02:0003B948 6702            	  7862:     beq  _anon_z04_158
02:0003B94A 7018            	  7863:     moveq   #24,D0
                            	  7864: _anon_z04_158:
02:0003B94C 1880            	  7865:     move.b  D0,($0000,A4)
                            	  7866:     ; This location is right above Patra.
                            	  7867:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  7868:     ;
02:0003B94E 102C0085        	  7869:     move.b  ($0085,A4),D0
02:0003B952 003C0011        	  7870:     ori     #$11,CCR  ; SEC: set C+X
02:0003B956 1214            	  7871:     move.b  ($0000,A4),D1
02:0003B958 0A3C0010        	  7872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B95C 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003B95E 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B962 41EC0084        	  7875:     lea     ($0084,A4),A0
02:0003B966 11802000        	  7876:     move.b  D0,(A0,D2.W)
                            	  7877:     even
