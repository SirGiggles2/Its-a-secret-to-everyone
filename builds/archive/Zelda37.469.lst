02:000483FC 1214            	  4902:     move.b  ($0000,A4),D1
02:000483FE 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048402 9101            	  4904:     subx.b  D1,D0   ; SBC $00
02:00048404 0A3C0010        	  4905:     eori    #$10,CCR  ; restore X = 6502 C
