02:00034F72 522C0413        	  4517:     addq.b  #1,($0413,A4)
                            	  4518:     ; Replace the low byte of the VRAM address with the one
                            	  4519:     ; where the next character should be written.
                            	  4520:     ;
02:00034F76 41F900034EB8    	  4521:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00034F7C 10303000        	  4522:     move.b  (A0,D3.W),D0
02:00034F80 19400303        	  4523:     move.b  D0,($0303,A4)
