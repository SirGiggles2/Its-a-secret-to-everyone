                            	   798:     even
                            	   799: DemoPatternVramAddrs:
02:0002F5A6 0700            	   800:     dc.w    $0700
02:0002F5A8 1700            	   801:     dc.w    $1700
                            	   802: 
                            	   803:     even
                            	   804: TransferDemoPatterns:
02:0002F5AA 4EB900046DEA    	   805:     jsr     TurnOffAllVideo
02:0002F5B0 4EB90000E034    	   806:     jsr     _ppu_read_2  ; PPU $2002 read → D0
                            	   807:     even
                            	   808: _L_z01_TransferDemoPatterns_LoopBlock:
                            	   809:     ; Loop over each block.
                            	   810:     ;
02:0002F5B6 102C051D        	   811:     move.b  ($051D,A4),D0
02:0002F5BA E308            	   812:     lsl.b  #1,D0   ; ASL A
02:0002F5BC 7400            	   813:     moveq   #0,D2
02:0002F5BE 1400            	   814:     move.b  D0,D2
                            	   815:     ; Put block address in [00:01] and size in [03:02].
                            	   816:     ; Load destination VRAM address and set it.
                            	   817:     ; The size and VRAM address have the high byte first.
                            	   818:     ;
02:0002F5C0 41F90002F59A    	   819:     lea     (DemoPatternBlockAddrs).l,A0
02:0002F5C6 3A02            	   820:     move.w  D2,D5
02:0002F5C8 DA45            	   821:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:0002F5CA 2A305000        	   822:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0002F5CE 29450004        	   823:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002F5D2 41F90002F5A2    	   824:     lea     (DemoPatternBlockSizes).l,A0
02:0002F5D8 10302000        	   825:     move.b  (A0,D2.W),D0
02:0002F5DC 19400002        	   826:     move.b  D0,($0002,A4)
02:0002F5E0 41F90002F5A6    	   827:     lea     (DemoPatternVramAddrs).l,A0
02:0002F5E6 10302000        	   828:     move.b  (A0,D2.W),D0
02:0002F5EA 4EB90000E32C    	   829:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:0002F5F0 5202            	   830:     addq.b  #1,D2
                            	   831:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:0002F5F2 41F90002F5A2    	   832:     lea     (DemoPatternBlockSizes).l,A0
02:0002F5F8 10302000        	   833:     move.b  (A0,D2.W),D0
02:0002F5FC 19400003        	   834:     move.b  D0,($0003,A4)
02:0002F600 41F90002F5A6    	   835:     lea     (DemoPatternVramAddrs).l,A0
02:0002F606 10302000        	   836:     move.b  (A0,D2.W),D0
02:0002F60A 611E            	   837:     jsr     TransferPatternBlock_Bank1
                            	   838:     ; Loop until pattern block index = 2.
                            	   839:     ;
02:0002F60C 102C051D        	   840:     move.b  ($051D,A4),D0
02:0002F610 0C000002        	   841:     cmpi.b  #$02,D0
02:0002F614 66A0            	   842:     bne  _L_z01_TransferDemoPatterns_LoopBlock
02:0002F616 103C00A5        	   843:     move.b  #$A5,D0
02:0002F61A 194000F6        	   844:     move.b  D0,($00F6,A4)
02:0002F61E 7000            	   845:     moveq   #0,D0
