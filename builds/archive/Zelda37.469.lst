                            	  1279: AnimateDemoPhase0Subphase1:
02:00032E84 102C0438        	  1280:     move.b  ($0438,A4),D0
02:00032E88 666C            	  1281:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1282:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1283:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1284:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032E8A 7000            	  1285:     moveq   #0,D0
02:00032E8C 102C0437        	  1286:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032E90 EB48            	  1287:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032E92 41F900032C74    	  1288:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032E98 D0C0            	  1289:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1290:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032E9A 197C003F0302    	  1291:     move.b  #$3F,($0302,A4)
02:00032EA0 197C00000303    	  1292:     move.b  #$00,($0303,A4)
02:00032EA6 7020            	  1293:     moveq   #32,D0
02:00032EA8 19400304        	  1294:     move.b  D0,($0304,A4)
                            	  1295:     ; End marker at DynTileBuf+4+31
02:00032EAC 761F            	  1296:     moveq   #31,D3
02:00032EAE 103C00FF        	  1297:     move.b  #$FF,D0
02:00032EB2 43EC0306        	  1298:     lea     ($0306,A4),A1
02:00032EB6 13803000        	  1299:     move.b  D0,(A1,D3.W)
                            	  1300:     even
                            	  1301: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00032EBA 10303000        	  1302:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00032EBE 43EC0305        	  1303:     lea     ($0305,A4),A1
02:00032EC2 13803000        	  1304:     move.b  D0,(A1,D3.W)
02:00032EC6 5303            	  1305:     subq.b  #1,D3
02:00032EC8 6AF0            	  1306:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
                            	  1307:     ; Advance the subphase cycle.
                            	  1308:     ;
02:00032ECA 522C0437        	  1309:     addq.b  #1,($0437,A4)
