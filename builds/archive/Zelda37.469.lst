02:0003A068 10302000        	  4544:     move.b  (A0,D2.W),D0
02:0003A06C 023C00EE        	  4545:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A070 41F90003A032    	  4546:     lea     (DigdoggerSpriteOffsetsY).l,A0
