02:000394BC 6702            	  2991:     beq  _anon_z04_57
02:000394BE 7060            	  2992:     moveq   #96,D0
                            	  2993: _anon_z04_57:
                            	  2994:     ; If the player is not aligned with the dock, return.
                            	  2995:     ;
