                            	  3536: FindNextEdgeSpawnCell:
                            	  3537:     ; Load [0A] with the value before the call.
                            	  3538:     ;
02:0003E412 102C0525        	  3539:     move.b  ($0525,A4),D0
02:0003E416 1940000A        	  3540:     move.b  D0,($000A,A4)
                            	  3541:     even
                            	  3542: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3543:     ; Loop to look for a place to spawn a monster from the edge
                            	  3544:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3545:     ;
                            	  3546:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3547:     ; We'll move down $10 pixels.
                            	  3548:     ;
02:0003E41A 7610            	  3549:     moveq   #16,D3
02:0003E41C 102C000A        	  3550:     move.b  ($000A,A4),D0
02:0003E420 0200000F        	  3551:     andi.b #$0F,D0
02:0003E424 670A            	  3552:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3553:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3554:     ; Don't move vertically.
                            	  3555:     ;
02:0003E426 163C00F0        	  3556:     move.b  #$F0,D3
02:0003E42A 0C00000F        	  3557:     cmpi.b  #$0F,D0
02:0003E42E 6610            	  3558:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3559:     even
                            	  3560: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3561:     ; Else low nibble = $F. We're at the right edge,
                            	  3562:     ; and we'll move up $10 pixels.
                            	  3563:     ;
02:0003E430 1003            	  3564:     move.b  D3,D0
02:0003E432 023C00EE        	  3565:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E436 122C000A        	  3566:     move.b  ($000A,A4),D1
02:0003E43A D101            	  3567:     addx.b  D1,D0   ; ADC $0A
02:0003E43C 1940000A        	  3568:     move.b  D0,($000A,A4)
                            	  3569:     even
                            	  3570: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3571:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3572:     ; Move right one pixel.
                            	  3573:     ;
02:0003E440 102C000A        	  3574:     move.b  ($000A,A4),D0
02:0003E444 020000F0        	  3575:     andi.b #$F0,D0
02:0003E448 0C0000E0        	  3576:     cmpi.b  #$E0,D0
02:0003E44C 6606            	  3577:     bne  _anon_z05_88
02:0003E44E 522C000A        	  3578:     addq.b  #1,($000A,A4)
02:0003E452 600A            	  3579:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3580: 
                            	  3581: _anon_z05_88:
                            	  3582:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3583:     ; Dont' move horizontally.
                            	  3584:     ;
02:0003E454 0C000040        	  3585:     cmpi.b  #$40,D0
02:0003E458 6604            	  3586:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3587:     ; Else high nibble = 4. We're at the top edge.
                            	  3588:     ; Move left 1 pixel.
                            	  3589:     ;
02:0003E45A 532C000A        	  3590:     subq.b  #1,($000A,A4)
                            	  3591:     even
                            	  3592: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3593:     ; Time to get the address of the column.
                            	  3594:     ; Starting at the top of the leftmost column.
                            	  3595:     ;
02:0003E45E 61002590        	  3596:     jsr     FetchTileMapAddr
02:0003E462 7005            	  3597:     moveq   #5,D0
02:0003E464 4EB90002A9FA    	  3598:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3599:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3600:     ; in order to point to the column we want.
                            	  3601:     ;
02:0003E46A 102C000A        	  3602:     move.b  ($000A,A4),D0
02:0003E46E 0200000F        	  3603:     andi.b #$0F,D0
02:0003E472 7600            	  3604:     moveq   #0,D3
02:0003E474 1600            	  3605:     move.b  D0,D3
02:0003E476 670C            	  3606:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3607: _anon_z05_89:
02:0003E478 702C            	  3608:     moveq   #44,D0
02:0003E47A 4EB900030AB8    	  3609:     jsr     AddToInt16At0
02:0003E480 5303            	  3610:     subq.b  #1,D3
02:0003E482 66F4            	  3611:     bne  _anon_z05_89
                            	  3612:     even
                            	  3613: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3614:     ; Turn the row part of [0A] into a tile index.
                            	  3615:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3616:     ;
02:0003E484 102C000A        	  3617:     move.b  ($000A,A4),D0
02:0003E488 020000F0        	  3618:     andi.b #$F0,D0
02:0003E48C 003C0011        	  3619:     ori     #$11,CCR  ; SEC: set C+X
02:0003E490 123C0040        	  3620:     move.b  #$40,D1
02:0003E494 0A3C0010        	  3621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E498 9101            	  3622:     subx.b  D1,D0   ; SBC #$40
02:0003E49A 0A3C0010        	  3623:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E49E E208            	  3624:     lsr.b  #1,D0   ; LSR A
02:0003E4A0 E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003E4A2 E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:0003E4A4 7600            	  3627:     moveq   #0,D3
02:0003E4A6 1600            	  3628:     move.b  D0,D3
                            	  3629:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3630:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3631:     ; when coming in from the edges.
                            	  3632:     ;
02:0003E4A8 1214            	  3633:     move.b  ($00,A4),D1   ; ptr lo
02:0003E4AA 182C0001        	  3634:     move.b  ($01,A4),D4  ; ptr hi
02:0003E4AE 024100FF        	  3635:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003E4B2 E14C            	  3636:     lsl.w   #8,D4
02:0003E4B4 8841            	  3637:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003E4B6 48C4            	  3638:     ext.l   D4
02:0003E4B8 D8BC00FF0000    	  3639:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003E4BE 2044            	  3640:     movea.l D4,A0
02:0003E4C0 10303000        	  3641:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003E4C4 0C000084        	  3642:     cmpi.b  #$84,D0
02:0003E4C8 650E            	  3643:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3644:     ; Bottom of the loop.
                            	  3645:     ; If you reach the original cell, then stop.
                            	  3646:     ;
02:0003E4CA 102C000A        	  3647:     move.b  ($000A,A4),D0
02:0003E4CE 122C0525        	  3648:     move.b  ($0525,A4),D1
02:0003E4D2 B001            	  3649:     cmp.b   D1,D0
02:0003E4D4 6600FF44        	  3650:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3651:     even
                            	  3652: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3653:     ; Set the spawn cell to the one we found.
                            	  3654:     ;
02:0003E4D8 102C000A        	  3655:     move.b  ($000A,A4),D0
02:0003E4DC 19400525        	  3656:     move.b  D0,($0525,A4)
02:0003E4E0 4E75            	  3657:     rts
                            	  3658: 
