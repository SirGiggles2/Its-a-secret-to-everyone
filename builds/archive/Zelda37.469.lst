02:0004871A 023C00EE        	  5373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004871E 123C0010        	  5374:     move.b  #$10,D1
02:00048722 D101            	  5375:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:00048724 41EC00AC        	  5376:     lea     ($00AC,A4),A0
02:00048728 11802000        	  5377:     move.b  D0,(A0,D2.W)
                            	  5378:     even
