02:000390CC 661A            	  2393:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  2394:     ; Else check for all collisions.
                            	  2395:     ;
02:000390CE 610080A0        	  2396:     jsr     CheckMonsterCollisions
                            	  2397:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  2398:     ;
02:000390D2 41EC0405        	  2399:     lea     ($0405,A4),A0
02:000390D6 10302000        	  2400:     move.b  (A0,D2.W),D0
02:000390DA 670A            	  2401:     beq  _anon_z04_55
02:000390DC 705D            	  2402:     moveq   #93,D0
02:000390DE 41EC034F        	  2403:     lea     ($034F,A4),A0
02:000390E2 11802000        	  2404:     move.b  D0,(A0,D2.W)
