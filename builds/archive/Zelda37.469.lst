02:000399DA 102C0486        	  3646:     move.b  ($0486,A4),D0
02:000399DE 41EC0486        	  3647:     lea     ($0486,A4),A0
02:000399E2 11803000        	  3648:     move.b  D0,(A0,D3.W)
