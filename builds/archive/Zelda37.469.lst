02:0004840E 41EC0084        	  4915:     lea     ($0084,A4),A0
02:00048412 10302000        	  4916:     move.b  (A0,D2.W),D0
02:00048416 023C00EE        	  4917:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004841A 122C0003        	  4918:     move.b  ($0003,A4),D1
