                            	  2999:     ; Set the dock object's X.
                            	  3000:     ;
02:000394C8 19802070        	  3001:     move.b  D0,($70,A4,D2.W)
                            	  3002:     ; Determine whether Link is coming or going.
                            	  3003:     ; If Y = $3D, then he's at the top edge of the screen. Use state 1.
                            	  3004:     ;
02:000394CC 7601            	  3005:     moveq   #1,D3
02:000394CE 102C0084        	  3006:     move.b  ($0084,A4),D0
02:000394D2 0C00003D        	  3007:     cmpi.b  #$3D,D0
02:000394D6 6708            	  3008:     beq  _L_z04_UpdateDock_SetState
                            	  3009:     ; But if Y = $7D, then he's at the dock. Use state 2.
                            	  3010:     ; Otherwise, return.
