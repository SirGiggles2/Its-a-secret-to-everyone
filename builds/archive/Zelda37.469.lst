                            	  4477: UpdatePeaceTextbox:
                            	  4478:     ; Only emit a character once every 8 frames --
                            	  4479:     ; when (counter [0412] MOD 8) = 4.
                            	  4480:     ;
02:00034F22 522C0412        	  4481:     addq.b  #1,($0412,A4)
02:00034F26 102C0412        	  4482:     move.b  ($0412,A4),D0
02:00034F2A 02000007        	  4483:     andi.b #$07,D0
02:00034F2E 0C000004        	  4484:     cmpi.b  #$04,D0
02:00034F32 665C            	  4485:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4486:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4487:     ; to the dynamic transfer buf.
                            	  4488:     ;
02:00034F34 7604            	  4489:     moveq   #4,D3
                            	  4490: _anon_z02_35:
02:00034F36 41F900034EB2    	  4491:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
