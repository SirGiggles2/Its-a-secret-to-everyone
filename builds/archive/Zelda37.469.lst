02:00033882 41EC0201        	  2308:     lea     ($0201,A4),A0
02:00033886 11803000        	  2309:     move.b  D0,(A0,D3.W)
02:0003388A 5303            	  2310:     subq.b  #1,D3
02:0003388C 6AEA            	  2311:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:0003388E 7600            	  2312:     moveq   #0,D3
02:00033890 162C0016        	  2313:     move.b  ($0016,A4),D3
02:00033894 41F9000330FC    	  2314:     lea     (ModeEandFSlotCursorYs).l,A0
