02:0003AF5C 10302000        	  6552:     move.b  (A0,D2.W),D0
02:0003AF60 41EC0445        	  6553:     lea     ($0445,A4),A0
02:0003AF64 11802000        	  6554:     move.b  D0,(A0,D2.W)
02:0003AF68 41EC045F        	  6555:     lea     ($045F,A4),A0
