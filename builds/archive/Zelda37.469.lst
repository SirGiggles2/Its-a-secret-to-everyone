                            	  2413: UpdatePondFairy:
02:000390EC 610031C0        	  2414:     jsr     DrawFairy
                            	  2415:     ; If not in state 0, then go handle states 1 to 3.
                            	  2416:     ;
02:000390F0 102C00AD        	  2417:     move.b  ($00AD,A4),D0
02:000390F4 6702            	  2418:     beq.s  __far_z_04_0020
02:000390F6 602A            	  2419:     jmp  PondFairy_HandleOtherStates
                            	  2420: __far_z_04_0020:
                            	  2421:     ; State 0.
                            	  2422:     ;
                            	  2423:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2424:     ;
02:000390F8 102C0084        	  2425:     move.b  ($0084,A4),D0
02:000390FC 0C0000AD        	  2426:     cmpi.b  #$AD,D0
02:00039100 661E            	  2427:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2428:     ; If Link's X < $70 or >= $81, then return.
                            	  2429:     ;
02:00039102 102C0070        	  2430:     move.b  ($0070,A4),D0
02:00039106 0C000070        	  2431:     cmpi.b  #$70,D0
02:0003910A 6514            	  2432:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003910C 0C000081        	  2433:     cmpi.b  #$81,D0
02:00039110 640E            	  2434:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2435:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2436:     ; halt Link, and start filling hearts.
                            	  2437:     ;
02:00039112 522C00AD        	  2438:     addq.b  #1,($00AD,A4)
02:00039116 7040            	  2439:     moveq   #64,D0
02:00039118 194000AC        	  2440:     move.b  D0,($00AC,A4)
02:0003911C 19400063        	  2441:     move.b  D0,($0063,A4)
                            	  2442:     even
                            	  2443: _L_z04_UpdatePondFairy_Exit:
02:00039120 4E75            	  2444:     rts
                            	  2445: 
                            	  2446:     even
                            	  2447: PondFairy_HandleOtherStates:
02:00039122 0C000001        	  2448:     cmpi.b  #$01,D0
02:00039126 6610            	  2449:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2450:     ; State 1. Flying and filling hearts.
                            	  2451:     ;
                            	  2452:     ; If still filling hearts, then go draw Link and hearts.
                            	  2453:     ;
02:00039128 102C0063        	  2454:     move.b  ($0063,A4),D0
02:0003912C 6620            	  2455:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2456:     ; If not filling hearts anymore, then go to state 2,
                            	  2457:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2458:     ; a little while after we finish filling hearts.
                            	  2459:     ;
02:0003912E 522C00AD        	  2460:     addq.b  #1,($00AD,A4)
02:00039132 7050            	  2461:     moveq   #80,D0
02:00039134 19400029        	  2462:     move.b  D0,($0029,A4)
                            	  2463:     even
                            	  2464: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2465:     ; If state <> 2 (so, it's 3), then return.
                            	  2466:     ;
                            	  2467:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2468:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2469:     ; was set to, and we'll return.
                            	  2470:     ;
02:00039138 0C000002        	  2471:     cmpi.b  #$02,D0
02:0003913C 6634            	  2472:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2473:     ; State = 2.
                            	  2474:     ;
                            	  2475:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2476:     ;
02:0003913E 102C0029        	  2477:     move.b  ($0029,A4),D0
02:00039142 660A            	  2478:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2479:     ; Else go to state 3, and unhalt Link.
                            	  2480:     ;
02:00039144 522C00AD        	  2481:     addq.b  #1,($00AD,A4)
02:00039148 7000            	  2482:     moveq   #0,D0
02:0003914A 194000AC        	  2483:     move.b  D0,($00AC,A4)
                            	  2484:     even
                            	  2485: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  2486:     ; TODO: but why, since Link is halted?
