02:000483C6 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:000483CA 122C0002        	  4880:     move.b  ($0002,A4),D1
02:000483CE D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:000483D0 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:000483D2 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:000483D6 B001            	  4887:     cmp.b   D1,D0
02:000483D8 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:000483DA 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:000483DE 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:000483E0 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:000483E4 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:000483E8 0A3C0010        	  4893:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000483EC 9101            	  4894:     subx.b  D1,D0   ; SBC ObjX,X
02:000483EE 0A3C0010        	  4895:     eori    #$10,CCR  ; restore X = 6502 C
