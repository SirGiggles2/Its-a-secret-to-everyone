02:0003A0E8 0200000F        	  4607:     andi.b #$0F,D0
02:0003A0EC 00000007        	  4608:     ori.b #$07,D0
02:0003A0F0 41EC0394        	  4609:     lea     ($0394,A4),A0
02:0003A0F4 11802000        	  4610:     move.b  D0,(A0,D2.W)
02:0003A0F8 101D            	  4611:     move.b  (A5)+,D0  ; PLA
                            	  4612:     ; Randomly head left or right.
