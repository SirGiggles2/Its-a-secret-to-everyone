02:0003C9D0 0C0000DD        	   515:     cmpi.b  #$DD,D0
02:0003C9D4 640A            	   516:     bcc  _anon_z05_9
02:0003C9D6 123C0008        	   517:     move.b  #$08,D1
02:0003C9DA D101            	   518:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
