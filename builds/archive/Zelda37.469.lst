02:00047246 102C0005        	  2348:     move.b  ($0005,A4),D0
02:0004724A 41EC0305        	  2349:     lea     ($0305,A4),A0
02:0004724E 11802000        	  2350:     move.b  D0,(A0,D2.W)
02:00047252 41EC0306        	  2351:     lea     ($0306,A4),A0
02:00047256 11802000        	  2352:     move.b  D0,(A0,D2.W)
02:0004725A 41EC030A        	  2353:     lea     ($030A,A4),A0
02:0004725E 11802000        	  2354:     move.b  D0,(A0,D2.W)
02:00047262 41EC030B        	  2355:     lea     ($030B,A4),A0
02:00047266 11802000        	  2356:     move.b  D0,(A0,D2.W)
                            	  2357:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
