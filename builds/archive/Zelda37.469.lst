02:0004099A 003C0011        	  6972:     ori     #$11,CCR  ; SEC: set C+X
02:0004099E 123C0040        	  6973:     move.b  #$40,D1
02:000409A2 0A3C0010        	  6974:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000409A6 9101            	  6975:     subx.b  D1,D0   ; SBC #$40
02:000409A8 0A3C0010        	  6976:     eori    #$10,CCR  ; restore X = 6502 C
02:000409AC E208            	  6977:     lsr.b  #1,D0   ; LSR A
02:000409AE E208            	  6978:     lsr.b  #1,D0   ; LSR A
02:000409B0 E208            	  6979:     lsr.b  #1,D0   ; LSR A
                            	  6980:     ; Add this row offset to the column address.
                            	  6981:     ;
02:000409B2 4EB900030AB8    	  6982:     jsr     AddToInt16At0
                            	  6983:     ; Assume that we'll write a type 1 square with primary square
                            	  6984:     ; taken from [05]. If so, the square index doesn't matter
                            	  6985:     ; as long as >= $10. See WriteSquareOW.
                            	  6986:     ;
02:000409B8 7600            	  6987:     moveq   #0,D3
02:000409BA 7410            	  6988:     moveq   #16,D2
02:000409BC 102C0005        	  6989:     move.b  ($0005,A4),D0
                            	  6990:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  6991:     ; So, we have to look up the square index corresponding
                            	  6992:     ; to primary square/tile in [05].
                            	  6993:     ;
                            	  6994:     ; Look in primary square table from $E to 1. If a match is found,
                            	  6995:     ; then the X register will have the square index value.
                            	  6996:     ;
02:000409C0 0C000027        	  6997:     cmpi.b  #$27,D0
02:000409C4 6506            	  6998:     bcs  _anon_z05_148
02:000409C6 0C0000F3        	  6999:     cmpi.b  #$F3,D0
02:000409CA 6514            	  7000:     bcs  _L_z05_ChangePlayMapSquareOW_Write
