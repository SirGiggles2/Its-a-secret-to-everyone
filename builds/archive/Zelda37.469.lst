02:000399A2 7070            	  3624:     moveq   #112,D0
02:000399A4 41EC0085        	  3625:     lea     ($0085,A4),A0
02:000399A8 11803000        	  3626:     move.b  D0,(A0,D3.W)
                            	  3627:     ; Start with no direction, no deferred bounce direction,
                            	  3628:     ; and ready to update.
                            	  3629:     ;
02:000399AC 7000            	  3630:     moveq   #0,D0
02:000399AE 41EC0099        	  3631:     lea     ($0099,A4),A0
02:000399B2 11803000        	  3632:     move.b  D0,(A0,D3.W)
02:000399B6 41EC03BD        	  3633:     lea     ($03BD,A4),A0
02:000399BA 11803000        	  3634:     move.b  D0,(A0,D3.W)
02:000399BE 41EC0406        	  3635:     lea     ($0406,A4),A0
02:000399C2 11803000        	  3636:     move.b  D0,(A0,D3.W)
02:000399C6 41EC0493        	  3637:     lea     ($0493,A4),A0
