02:0003CA18 19400058        	   542:     move.b  D0,($0058,A4)
02:0003CA1C 103C00A0        	   543:     move.b  #$A0,D0
02:0003CA20 194000E2        	   544:     move.b  D0,($00E2,A4)
                            	   545:     even
