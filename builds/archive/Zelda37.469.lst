02:0003A0E0 662C            	  4602:     bne  _L_z04_Aquamentus_Move_Move
                            	  4603:     ; Set a random distance to move of 7 or $F pixels.
                            	  4604:     ;
02:0003A0E2 10342018        	  4605:     move.b  ($18,A4,D2.W),D0
