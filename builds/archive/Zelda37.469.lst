02:0003BF8E 41EC0306        	  8745:     lea     ($0306,A4),A0
02:0003BF92 11802000        	  8746:     move.b  D0,(A0,D2.W)
02:0003BF96 5303            	  8747:     subq.b  #1,D3
02:0003BF98 5302            	  8748:     subq.b  #1,D2
02:0003BF9A 6AE8            	  8749:     bpl  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_OverwriteColors
