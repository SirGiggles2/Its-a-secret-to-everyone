02:0003508A 12303000        	  4659:     move.b  (A0,D3.W),D1
02:0003508E B001            	  4660:     cmp.b   D1,D0
02:00035090 651C            	  4661:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
