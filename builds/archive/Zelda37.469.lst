                            	  3792: 
                            	  3793: DoorwayRequiredCoord:
02:0003E636 78              	  3794:     dc.b    $78, $78, $8D, $8D
02:0003E637 78
02:0003E638 8D
02:0003E639 8D
                            	  3795: 
                            	  3796: ; Player coordinate must be >= these bounds.
                            	  3797: ; Using these bounds; the player will be considered within the
                            	  3798: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3799: ;
                            	  3800:     even
                            	  3801: DoorwayBoundsMinOver:
