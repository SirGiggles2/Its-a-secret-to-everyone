                            	  2340: __far_z_04_0018:
                            	  2341:     ; Animate.
                            	  2342:     ;
                            	  2343:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  2344:     ; then only go draw.
                            	  2345:     ;
02:00039072 41EC03D0        	  2346:     lea     ($03D0,A4),A0
02:00039076 53302000        	  2347:     subq.b  #1,(A0,D2.W)
02:0003907A 6702            	  2348:     beq.s  __far_z_04_0019
02:0003907C 601E            	  2349:     jmp  DrawArmosAndCheckCollisions
                            	  2350: __far_z_04_0019:
                            	  2351:     ; Armos animation frames last 6 screen frames.
                            	  2352:     ;
02:0003907E 7006            	  2353:     moveq   #6,D0
02:00039080 41EC03D0        	  2354:     lea     ($03D0,A4),A0
02:00039084 11802000        	  2355:     move.b  D0,(A0,D2.W)
                            	  2356:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  2357:     ; change the position of the shield. To keep fixed it in place,
                            	  2358:     ; there are separate frame images for each animation frame.
                            	  2359:     ;
                            	  2360:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  2361:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  2362:     ;
                            	  2363:     ; Here flip between the two sets by XOR'ing with 2.
                            	  2364:     ; Then choose the direction at the point of drawing below.
                            	  2365:     ;
02:00039088 41EC03E4        	  2366:     lea     ($03E4,A4),A0
02:0003908C 10302000        	  2367:     move.b  (A0,D2.W),D0
02:00039090 0A000002        	  2368:     eori.b #$02,D0
02:00039094 41EC03E4        	  2369:     lea     ($03E4,A4),A0
02:00039098 11802000        	  2370:     move.b  D0,(A0,D2.W)
                            	  2371:     even
                            	  2372: DrawArmosAndCheckCollisions:
02:0003909C 4EB900049078    	  2373:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:000390A2 7600            	  2374:     moveq   #0,D3
02:000390A4 41EC0098        	  2375:     lea     ($0098,A4),A0
02:000390A8 16302000        	  2376:     move.b  (A0,D2.W),D3
                            	  2377:     ; If facing up, then use the second frame image in the set ("back").
                            	  2378:     ; Else use the second.
                            	  2379:     ;
02:000390AC 0C030008        	  2380:     cmpi.b  #$08,D3
02:000390B0 6602            	  2381:     bne  _anon_z04_54
02:000390B2 7001            	  2382:     moveq   #1,D0
                            	  2383: _anon_z04_54:
02:000390B4 023C00EE        	  2384:     andi    #$EE,CCR  ; CLC: clear C+X
02:000390B8 41EC03E4        	  2385:     lea     ($03E4,A4),A0
02:000390BC 12302000        	  2386:     move.b  (A0,D2.W),D1
02:000390C0 D101            	  2387:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000390C2 4EB900030E04    	  2388:     jsr     DrawObjectNotMirrored
                            	  2389:     ; If the armos is still fading in, then go for check collision with Link,
