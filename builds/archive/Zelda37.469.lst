02:00039A0E 02000007        	  3668:     andi.b #$07,D0
02:00039A12 7600            	  3669:     moveq   #0,D3
02:00039A14 1600            	  3670:     move.b  D0,D3
02:00039A16 41F90003C2FC    	  3671:     lea     (Directions8).l,A0
02:00039A1C 10303000        	  3672:     move.b  (A0,D3.W),D0
02:00039A20 1940009D        	  3673:     move.b  D0,($009D,A4)
02:00039A24 19400385        	  3674:     move.b  D0,($0385,A4)
02:00039A28 102C0022        	  3675:     move.b  ($0022,A4),D0
02:00039A2C 02000007        	  3676:     andi.b #$07,D0
02:00039A30 7600            	  3677:     moveq   #0,D3
02:00039A32 1600            	  3678:     move.b  D0,D3
02:00039A34 41F90003C2FC    	  3679:     lea     (Directions8).l,A0
02:00039A3A 10303000        	  3680:     move.b  (A0,D3.W),D0
02:00039A3E 194000A2        	  3681:     move.b  D0,($00A2,A4)
02:00039A42 1940038A        	  3682:     move.b  D0,($038A,A4)
                            	  3683:     ; Set minimum number of turns 1 for flying states.
