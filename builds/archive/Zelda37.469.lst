02:00039A80 670000C2        	  3718:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3719:     ; If the magic clock is missing, then move around (using the flying mechanism).
                            	  3720:     ;
02:00039A84 102C066C        	  3721:     move.b  ($066C,A4),D0
