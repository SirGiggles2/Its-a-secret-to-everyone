02:00038774 6748            	  1031:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038776 0C0000F0        	  1032:     cmpi.b  #$F0,D0
02:0003877A 6742            	  1033:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1034:     ; Turn the random value into a $10 pixel aligned Y coordinate.
