                            	  7627: __far_z_05_0086:
                            	  7628:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7629:     ; and represents the current row of the submenu being processed.
                            	  7630:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7631:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7632:     ;
                            	  7633:     ; If the bottom bit is set, go prepare the full black row.
                            	  7634:     ;
02:00041126 E208            	  7635:     lsr.b  #1,D0   ; LSR A
02:00041128 7600            	  7636:     moveq   #0,D3
02:0004112A 1600            	  7637:     move.b  D0,D3
02:0004112C 6402            	  7638:     bcc.s  __far_z_05_0087
02:0004112E 60B6            	  7639:     jmp  PrepFullBlackRow
