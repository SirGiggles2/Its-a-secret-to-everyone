02:0003C9F0 9101            	   525:     subx.b  D1,D0   ; SBC #$20
02:0003C9F2 0A3C0010        	   526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C9F6 194000E2        	   527:     move.b  D0,($00E2,A4)
02:0003C9FA 6404            	   528:     bcc  _anon_z05_10
02:0003C9FC 532C0058        	   529:     subq.b  #1,($0058,A4)
                            	   530: _anon_z05_10:
02:0003CA00 0C0000E0        	   531:     cmpi.b  #$E0,D0
02:0003CA04 661E            	   532:     bne  _L_z05_ScrollWorld_Exit
02:0003CA06 102C0058        	   533:     move.b  ($0058,A4),D0
02:0003CA0A 0C000020        	   534:     cmpi.b  #$20,D0
