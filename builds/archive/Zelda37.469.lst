                            	  4781: Aquamentus_Draw:
                            	  4782:     ; Every $10 screen frames, switch animation frames.
                            	  4783:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  4784:     ; The last tile of frame 0 is at index 5.
                            	  4785:     ; The last tile of frame 1 is at index $B.
                            	  4786:     ;
02:0003A220 7605            	  4787:     moveq   #5,D3
02:0003A222 102C0015        	  4788:     move.b  ($0015,A4),D0
02:0003A226 02000010        	  4789:     andi.b #$10,D0
02:0003A22A 6602            	  4790:     bne  _anon_z04_88
02:0003A22C 760B            	  4791:     moveq   #11,D3
                            	  4792: _anon_z04_88:
02:0003A22E 1943000A        	  4793:     move.b  D3,($000A,A4)
                            	  4794:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  4795:     ;
02:0003A232 7005            	  4796:     moveq   #5,D0
02:0003A234 1940000B        	  4797:     move.b  D0,($000B,A4)
                            	  4798:     even
                            	  4799: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A238 7600            	  4800:     moveq   #0,D3
02:0003A23A 162C000B        	  4801:     move.b  ($000B,A4),D3
                            	  4802:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  4803:     ; Store it in [00].
                            	  4804:     ;
02:0003A23E 10342070        	  4805:     move.b  ($70,A4,D2.W),D0
02:0003A242 023C00EE        	  4806:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A246 41F90003A21A    	  4807:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A24C 12303000        	  4808:     move.b  (A0,D3.W),D1
02:0003A250 D101            	  4809:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A252 1880            	  4810:     move.b  D0,($0000,A4)
                            	  4811:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  4812:     ; Store it in [01].
                            	  4813:     ;
02:0003A254 41EC0084        	  4814:     lea     ($0084,A4),A0
02:0003A258 10302000        	  4815:     move.b  (A0,D2.W),D0
02:0003A25C 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A260 41F90003A214    	  4817:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A266 12303000        	  4818:     move.b  (A0,D3.W),D1
02:0003A26A D101            	  4819:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A26C 19400001        	  4820:     move.b  D0,($0001,A4)
                            	  4821:     ; Calculate sprite attributes:
                            	  4822:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4823:     ;
                            	  4824:     ; If the boss is temporarily invincible, then
                            	  4825:     ; this makes it flash by cycling all the palette rows.
                            	  4826:     ;
                            	  4827:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4828:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4829:     ;
02:0003A270 41EC04F0        	  4830:     lea     ($04F0,A4),A0
02:0003A274 10302000        	  4831:     move.b  (A0,D2.W),D0
02:0003A278 02000003        	  4832:     andi.b #$03,D0
02:0003A27C 0A000003        	  4833:     eori.b #$03,D0
02:0003A280 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A284 7600            	  4835:     moveq   #0,D3
02:0003A286 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A28A 41F90003A208    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A290 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A294 12390003A208    	  4842:     move.b  (AquamentusTiles).l,D1
02:0003A29A B001            	  4843:     cmp.b   D1,D0
02:0003A29C 6610            	  4844:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4845:     ; Else it's the first one (the face tile).
                            	  4846:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  4847:     ;
                            	  4848:     ; $CC/CD shows the closed mouth face.
                            	  4849:     ; $C0/C1 shows the open mouth face.
                            	  4850:     ;
02:0003A29E 7600            	  4851:     moveq   #0,D3
02:0003A2A0 16342028        	  4852:     move.b  ($28,A4,D2.W),D3
02:0003A2A4 0C030020        	  4853:     cmpi.b  #$20,D3
02:0003A2A8 6404            	  4854:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A2AA 103C00C0        	  4855:     move.b  #$C0,D0
                            	  4856:     even
                            	  4857: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003A2AE 610E            	  4858:     jsr     WriteBossSprite
                            	  4859:     ; Bottom of the loop.
                            	  4860:     ; Decrement tile index and loop index.
                            	  4861:     ;
02:0003A2B0 532C000A        	  4862:     subq.b  #1,($000A,A4)
02:0003A2B4 532C000B        	  4863:     subq.b  #1,($000B,A4)
02:0003A2B8 6A00FF7E        	  4864:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A2BC 4E75            	  4865:     rts
                            	  4866: 
                            	  4867: ; Params:
                            	  4868: ; A: tile
                            	  4869: ; [00]: X
                            	  4870: ; [01]: Y
                            	  4871: ; [03]: sprite attributes
                            	  4872: ;
                            	  4873: ; Save the tile
                            	  4874:     even
                            	  4875: WriteBossSprite:
02:0003A2BE 1B00            	  4876:     move.b  D0,-(A5)  ; PHA
02:0003A2C0 7600            	  4877:     moveq   #0,D3
02:0003A2C2 162C0341        	  4878:     move.b  ($0341,A4),D3
02:0003A2C6 41F900030DCC    	  4879:     lea     (SpriteOffsets).l,A0
