02:00039D5A 41EC0478        	  4195:     lea     ($0478,A4),A0
02:00039D5E 16302000        	  4196:     move.b  (A0,D2.W),D3
                            	  4197:     ; Change the coordinates to one corner.
                            	  4198:     ;
02:00039D62 10342070        	  4199:     move.b  ($70,A4,D2.W),D0
02:00039D66 023C00EE        	  4200:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039D6A 41F900039C1E    	  4201:     lea     (DigdoggerCornerOffsetsX).l,A0
02:00039D70 12303000        	  4202:     move.b  (A0,D3.W),D1
