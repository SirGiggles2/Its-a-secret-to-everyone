02:00047E36 10302000        	  3980:     move.b  (A0,D2.W),D0
02:00047E3A 123C0000        	  3981:     move.b  #$00,D1
02:00047E3E 0A3C0010        	  3982:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00047E42 9101            	  3983:     subx.b  D1,D0   ; SBC #$00
02:00047E44 0A3C0010        	  3984:     eori    #$10,CCR  ; restore X = 6502 C
02:00047E48 41EC0084        	  3985:     lea     ($0084,A4),A0
02:00047E4C 11802000        	  3986:     move.b  D0,(A0,D2.W)
