02:0003AFB8 13C200000422    	  6599:     move.b  D2,(Gleook_HeadInfo0+GLEEOK_SPEEDX).l
02:0003AFBE 13C200000430    	  6600:     move.b  D2,(Gleook_HeadInfo1+GLEEOK_SPEEDY).l
02:0003AFC4 13C200000383    	  6601:     move.b  D2,(Gleook_HeadInfo2+GLEEOK_SPEEDX).l
02:0003AFCA 13C2000003AC    	  6602:     move.b  D2,(Gleook_HeadInfo3+GLEEOK_SPEEDY).l
