02:0003506E 7400            	  4648:     moveq   #0,D2
02:00035070 142C0016        	  4649:     move.b  ($0016,A4),D2
02:00035074 41EC062D        	  4650:     lea     ($062D,A4),A0
02:00035078 10302000        	  4651:     move.b  (A0,D2.W),D0
02:0003507C 6702            	  4652:     beq  _anon_z02_40
02:0003507E 5203            	  4653:     addq.b  #1,D3
                            	  4654: _anon_z02_40:
