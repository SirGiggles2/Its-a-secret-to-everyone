02:00048872 1940000F        	  5580:     move.b  D0,($000F,A4)
02:00048876 41EC0098        	  5581:     lea     ($0098,A4),A0
02:0004887A 11802000        	  5582:     move.b  D0,(A0,D2.W)
02:0004887E 1003            	  5583:     move.b  D3,D0
