02:00039A8A 610000BA        	  3723:     jsr     ControlMoldormFlight
02:00039A8E 61002894        	  3724:     jsr     MoveFlyer
                            	  3725: _anon_z04_79:
                            	  3726:     ; Draw with sprite attributes: normal, red palette row
                            	  3727:     ;
02:00039A92 7002            	  3728:     moveq   #2,D0
02:00039A94 19400003        	  3729:     move.b  D0,($0003,A4)
02:00039A98 7044            	  3730:     moveq   #68,D0
02:00039A9A 4EB900031100    	  3731:     jsr     Anim_WriteSprite
                            	  3732:     ; Check collisions, but never let them interfere with movement.
                            	  3733:     ;
02:00039AA0 41EC0098        	  3734:     lea     ($0098,A4),A0
02:00039AA4 10302000        	  3735:     move.b  (A0,D2.W),D0
02:00039AA8 1B00            	  3736:     move.b  D0,-(A5)  ; PHA
02:00039AAA 10342028        	  3737:     move.b  ($28,A4,D2.W),D0
02:00039AAE 1B00            	  3738:     move.b  D0,-(A5)  ; PHA
02:00039AB0 4EB900031170    	  3739:     jsr     CheckMonsterCollisions
02:00039AB6 101D            	  3740:     move.b  (A5)+,D0  ; PLA
02:00039AB8 19802028        	  3741:     move.b  D0,($28,A4,D2.W)
02:00039ABC 101D            	  3742:     move.b  (A5)+,D0  ; PLA
02:00039ABE 41EC0098        	  3743:     lea     ($0098,A4),A0
02:00039AC2 11802000        	  3744:     move.b  D0,(A0,D2.W)
                            	  3745:     ; If this segment is still alive, then return.
                            	  3746:     ;
02:00039AC6 41EC0405        	  3747:     lea     ($0405,A4),A0
02:00039ACA 10302000        	  3748:     move.b  (A0,D2.W),D0
02:00039ACE 6774            	  3749:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3750:     ; This segment is dead. We'll swap the tail segment with this
                            	  3751:     ; dead segment. This way, moldorm heads are always rooted
                            	  3752:     ; in slots 5 and $A; and the segments are continguous.
                            	  3753:     ;
                            	  3754:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  3755:     ;
                            	  3756:     ; Note that this is not a true swap, because the tail's HP
                            	  3757:     ; might be less than $20.
                            	  3758:     ;
02:00039AD0 7020            	  3759:     moveq   #32,D0
02:00039AD2 41EC0485        	  3760:     lea     ($0485,A4),A0
02:00039AD6 11802000        	  3761:     move.b  D0,(A0,D2.W)
02:00039ADA 610005F4        	  3762:     jsr     CheckBossHitReaction
                            	  3763:     ; Look for the tail segment, starting from the low end
                            	  3764:     ; of the chain that this dead segment belongs to.
                            	  3765:     ;
02:00039ADE 163C00FF        	  3766:     move.b  #$FF,D3
02:00039AE2 0C020006        	  3767:     cmpi.b  #$06,D2
02:00039AE6 6502            	  3768:     bcs  _anon_z04_80
02:00039AE8 7604            	  3769:     moveq   #4,D3
                            	  3770: _anon_z04_80:
02:00039AEA 5203            	  3771:     addq.b  #1,D3
02:00039AEC 41EC0350        	  3772:     lea     ($0350,A4),A0
02:00039AF0 10303000        	  3773:     move.b  (A0,D3.W),D0
02:00039AF4 0C000041        	  3774:     cmpi.b  #$41,D0
02:00039AF8 66F0            	  3775:     bne  _anon_z04_80
                            	  3776:     ; I don't know why the object timer of the tail segment that will
                            	  3777:     ; be made dead is set to $11. By setting its object type to $5D
                            	  3778:     ; below, its metastate will become $10 -- dying/dead. From
                            	  3779:     ; there, the object timer is set to 6.
                            	  3780:     ;
02:00039AFA 7011            	  3781:     moveq   #17,D0
02:00039AFC 19803029        	  3782:     move.b  D0,($29,A4,D3.W)
                            	  3783:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  3784:     ; segment to the tail segment.
                            	  3785:     ;
02:00039B00 41EC04F0        	  3786:     lea     ($04F0,A4),A0
02:00039B04 10302000        	  3787:     move.b  (A0,D2.W),D0
02:00039B08 41EC04F1        	  3788:     lea     ($04F1,A4),A0
02:00039B0C 11803000        	  3789:     move.b  D0,(A0,D3.W)
02:00039B10 10342070        	  3790:     move.b  ($70,A4,D2.W),D0
02:00039B14 19803071        	  3791:     move.b  D0,($71,A4,D3.W)
02:00039B18 41EC0084        	  3792:     lea     ($0084,A4),A0
02:00039B1C 10302000        	  3793:     move.b  (A0,D2.W),D0
02:00039B20 41EC0085        	  3794:     lea     ($0085,A4),A0
02:00039B24 11803000        	  3795:     move.b  D0,(A0,D3.W)
                            	  3796:     ; If the tail segment found is also a head, then
                            	  3797:     ; the last segment has died. Return.
                            	  3798:     ;
02:00039B28 0C030004        	  3799:     cmpi.b  #$04,D3
02:00039B2C 6716            	  3800:     beq  _L_z04_UpdateMoldorm_Exit
02:00039B2E 0C030009        	  3801:     cmpi.b  #$09,D3
02:00039B32 6710            	  3802:     beq  _L_z04_UpdateMoldorm_Exit
                            	  3803:     ; Else finish swapping the segments.
                            	  3804:     ; Set the tail segment's type to the dead dummy object.
                            	  3805:     ;
02:00039B34 705D            	  3806:     moveq   #93,D0
02:00039B36 41EC0350        	  3807:     lea     ($0350,A4),A0
02:00039B3A 11803000        	  3808:     move.b  D0,(A0,D3.W)
                            	  3809:     ; Reset the metastate of the current segment, so that it comes
                            	  3810:     ; back to life.
                            	  3811:     ;
02:00039B3E 4EB900049878    	  3812:     jsr     ResetObjMetastate
                            	  3813:     even
                            	  3814: _L_z04_UpdateMoldorm_Exit:
02:00039B44 4E75            	  3815:     rts
