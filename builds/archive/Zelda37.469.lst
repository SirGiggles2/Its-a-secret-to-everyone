02:0003AF70 41EC0479        	  6557:     lea     ($0479,A4),A0
02:0003AF74 11802000        	  6558:     move.b  D0,(A0,D2.W)
02:0003AF78 41EC03BD        	  6559:     lea     ($03BD,A4),A0
