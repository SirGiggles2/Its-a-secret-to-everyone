02:00047E1C 102C000F        	  3969:     move.b  ($000F,A4),D0
02:00047E20 E208            	  3970:     lsr.b  #1,D0   ; LSR A
02:00047E22 654C            	  3971:     bcs  _L_z07_MoveObject_Right
02:00047E24 E208            	  3972:     lsr.b  #1,D0   ; LSR A
02:00047E26 655E            	  3973:     bcs  _L_z07_MoveObject_Left
02:00047E28 E208            	  3974:     lsr.b  #1,D0   ; LSR A
02:00047E2A 6526            	  3975:     bcs  _L_z07_MoveObject_Down
