02:00035096 41F90003500A    	  4666:     lea     (CreditsLastVscrollList).l,A0
02:0003509C 12303000        	  4667:     move.b  (A0,D3.W),D1
02:000350A0 B001            	  4668:     cmp.b   D1,D0
02:000350A2 650A            	  4669:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4670:     ; But if we have, then go to the next submode, and set a timer
