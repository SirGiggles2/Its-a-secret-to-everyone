02:0003AF42 41EC046C        	  6544:     lea     ($046C,A4),A0
02:0003AF46 11802000        	  6545:     move.b  D0,(A0,D2.W)
02:0003AF4A 41EC0395        	  6546:     lea     ($0395,A4),A0
