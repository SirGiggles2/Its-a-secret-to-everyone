                            	  7112: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7113:     ; If the "monsters from edges" long timer expired, then
                            	  7114:     ; go bring the monster in.
                            	  7115:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7116:     ;
                            	  7117:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7118:     ; residual position so enemies keep their previous-room
                            	  7119:     ; positions instead of being re-edge-spawned (matches NES).
02:00049476 102C004B        	  7120:     move.b  ($004B,A4),D0
02:0004947A 662E            	  7121:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7122:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004947C 102C000F        	  7123:     move.b  ($000F,A4),D0
02:00049480 0C0000FF        	  7124:     cmpi.b  #$FF,D0
02:00049484 662E            	  7125:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:00049486 41EC0070        	  7126:     lea     ($0070,A4),A0
02:0004948A 10302000        	  7127:     move.b  (A0,D2.W),D0
02:0004948E 660A            	  7128:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:00049490 41EC0084        	  7129:     lea     ($0084,A4),A0
02:00049494 10302000        	  7130:     move.b  (A0,D2.W),D0
02:00049498 671A            	  7131:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7132:     even
