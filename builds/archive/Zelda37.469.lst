                            	  3446:     ;
                            	  3447:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3448:     ;
02:00047ADC 02000003        	  3449:     andi.b #$03,D0
02:00047AE0 671E            	  3450:     beq  _L_z07_Obj_Shove_Exit
                            	  3451:     even
