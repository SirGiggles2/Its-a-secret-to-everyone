                            	  8713: _anon_z04_165:
02:0003BF50 1003            	  8714:     move.b  D3,D0
02:0003BF52 1B00            	  8715:     move.b  D0,-(A5)  ; PHA
                            	  8716:     ; Get the length, to append to the dynamic transfer buf.
                            	  8717:     ;
02:0003BF54 7400            	  8718:     moveq   #0,D2
