                            	  7539: UpdateFluteSecret:
                            	  7540:     ; If secret color cycle >= $C, return.
                            	  7541:     ;
02:00049892 7600            	  7542:     moveq   #0,D3
02:00049894 162C051A        	  7543:     move.b  ($051A,A4),D3
02:00049898 0C03000C        	  7544:     cmpi.b  #$0C,D3
02:0004989C 6502            	  7545:     bcs.s  __far_z_07_0117
02:0004989E 605C            	  7546:     jmp  L1FF28_Exit
                            	  7547: __far_z_07_0117:
                            	  7548:     ; 7 of every 8 frames, return.
                            	  7549:     ;
02:000498A0 102C0015        	  7550:     move.b  ($0015,A4),D0
02:000498A4 02000007        	  7551:     andi.b #$07,D0
02:000498A8 0C000004        	  7552:     cmpi.b  #$04,D0
02:000498AC 6702            	  7553:     beq.s  __far_z_07_0118
02:000498AE 604C            	  7554:     jmp  L1FF28_Exit
                            	  7555: __far_z_07_0118:
                            	  7556:     ; So, every 8 frames:
                            	  7557:     ; 1. Increment the secret color cycle count.
                            	  7558:     ; 2. Change the water palette.
                            	  7559:     ;
                            	  7560:     ; But when the count = $B, go reveal the stairs.
                            	  7561:     ;
02:000498B0 522C051A        	  7562:     addq.b  #1,($051A,A4)
02:000498B4 0C03000B        	  7563:     cmpi.b  #$0B,D3
02:000498B8 6602            	  7564:     bne.s  __far_z_07_0119
02:000498BA 6042            	  7565:     jmp  RevealPondStairs
