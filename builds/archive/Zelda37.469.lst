02:0003BA02 611C            	  7951:     jsr     PatraChild_Draw
                            	  7952:     ; If Patra's state still = 0, then the last patra child has not
                            	  7953:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  7954:     ;
02:0003BA04 102C00AD        	  7955:     move.b  ($00AD,A4),D0
02:0003BA08 6714            	  7956:     beq  _L_z04_PatraChild_State1_Exit
02:0003BA0A 4EB900031170    	  7957:     jsr     CheckMonsterCollisions
                            	  7958:     ; If the monster died, then change to the dead dummy object.
