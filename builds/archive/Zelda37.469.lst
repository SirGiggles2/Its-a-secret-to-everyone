02:0000E60C 3A04            	  1073:     move.w  D4,D5
02:0000E60E E44D            	  1074:     lsr.w   #2,D5
02:0000E610 02450003        	  1075:     andi.w  #$0003,D5
02:0000E614 EB4D            	  1076:     lsl.w   #5,D5
02:0000E616 E14D            	  1077:     lsl.w   #8,D5
02:0000E618 5442            	  1078:     addq.w  #2,D2
02:0000E61A 610002D8        	  1079:     bsr     _attr_write_2x2
02:0000E61E 5542            	  1080:     subq.w  #2,D2
                            	  1081: 
