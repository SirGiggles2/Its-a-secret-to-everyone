02:000409D4 12302000        	  7005:     move.b  (A0,D2.W),D1
02:000409D8 B001            	  7006:     cmp.b   D1,D0
02:000409DA 6704            	  7007:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:000409DC 5302            	  7008:     subq.b  #1,D2
02:000409DE 66EE            	  7009:     bne  _anon_z05_149
