02:0003E6E2 B001            	  3939:     cmp.b   D1,D0
02:0003E6E4 6620            	  3940:     bne  _anon_z05_96
02:0003E6E6 102C0001        	  3941:     move.b  ($0001,A4),D0
02:0003E6EA 41F90003E642    	  3942:     lea     (DoorwayBoundsMinUnder).l,A0
02:0003E6F0 12303000        	  3943:     move.b  (A0,D3.W),D1
02:0003E6F4 B001            	  3944:     cmp.b   D1,D0
02:0003E6F6 650E            	  3945:     bcs  _anon_z05_96
02:0003E6F8 41F90003E646    	  3946:     lea     (DoorwayBoundsMaxUnder).l,A0
02:0003E6FE 12303000        	  3947:     move.b  (A0,D3.W),D1
02:0003E702 B001            	  3948:     cmp.b   D1,D0
