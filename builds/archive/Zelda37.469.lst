02:0003E662 12303000        	  3872:     move.b  (A0,D3.W),D1
02:0003E666 B001            	  3873:     cmp.b   D1,D0
02:0003E668 6622            	  3874:     bne  _anon_z05_95
02:0003E66A 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003E66E 41F90003E63A    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003E674 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003E678 B001            	  3878:     cmp.b   D1,D0
02:0003E67A 6510            	  3879:     bcs  _anon_z05_95
02:0003E67C 41F90003E63E    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E682 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E686 B001            	  3882:     cmp.b   D1,D0
02:0003E688 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
02:0003E68C 5303            	  3885:     subq.b  #1,D3
