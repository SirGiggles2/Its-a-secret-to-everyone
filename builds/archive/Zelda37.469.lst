                            	  6702: ; store the sprite's X in [00].
                            	  6703: ;
                            	  6704:     even
                            	  6705: Gohma_DrawLegsOneSide:
02:0003B08A 10342070        	  6706:     move.b  ($70,A4,D2.W),D0
02:0003B08E 023C00EE        	  6707:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B092 41F90003B068    	  6708:     lea     (GohmaLegOffsetsX).l,A0
