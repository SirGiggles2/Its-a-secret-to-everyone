02:00039BF0 41EC0381        	  3961:     lea     ($0381,A4),A0
02:00039BF4 11803000        	  3962:     move.b  D0,(A0,D3.W)
02:00039BF8 41EC0099        	  3963:     lea     ($0099,A4),A0
02:00039BFC 11803000        	  3964:     move.b  D0,(A0,D3.W)
                            	  3965:     ; Bottom of the loop.
