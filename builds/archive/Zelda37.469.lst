02:00047E90 123C0000        	  4021:     move.b  #$00,D1
02:00047E94 0A3C0010        	  4022:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00047E98 9101            	  4023:     subx.b  D1,D0   ; SBC #$00
02:00047E9A 0A3C0010        	  4024:     eori    #$10,CCR  ; restore X = 6502 C
