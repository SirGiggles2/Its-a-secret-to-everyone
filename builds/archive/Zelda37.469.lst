                            	  9358: TurnTowardsPlayer8:
                            	  9359:     ; Build a direction in [00] towards the player.
                            	  9360:     ;
                            	  9361:     ; First, calculate a horizontal component:
                            	  9362:     ;
                            	  9363:     ; If   observed player X = object X, [00] := 0 (none)
                            	  9364:     ; elif observed player X > object X, [00] := 1 (right)
                            	  9365:     ; else                               [00] := 2 (left)
                            	  9366:     ;
02:0003C394 7600            	  9367:     moveq   #0,D3
02:0003C396 1883            	  9368:     move.b  D3,($0000,A4)
02:0003C398 5203            	  9369:     addq.b  #1,D3
02:0003C39A 102C0061        	  9370:     move.b  ($0061,A4),D0
02:0003C39E 12342070        	  9371:     move.b  ($70,A4,D2.W),D1
02:0003C3A2 B001            	  9372:     cmp.b   D1,D0
02:0003C3A4 6706            	  9373:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003C3A6 6402            	  9374:     bcc  _anon_z04_175
