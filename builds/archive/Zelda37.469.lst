02:00038B40 1600            	  1608:     move.b  D0,D3
02:00038B42 41F900038ABC    	  1609:     lea     (BlueLeeverStateQSpeeds).l,A0
02:00038B48 10303000        	  1610:     move.b  (A0,D3.W),D0
02:00038B4C 41EC03BC        	  1611:     lea     ($03BC,A4),A0
