                            	  5416: CheckState30:
                            	  5417:     ; If major state <> $30, go check other states.
                            	  5418:     ;
02:0004876A 0C000030        	  5419:     cmpi.b  #$30,D0
02:0004876E 6656            	  5420:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5421:     ; State $3x. Slow down.
                            	  5422:     ;
                            	  5423:     ; Reset grid offset for movement.
                            	  5424:     ;
02:00048770 7000            	  5425:     moveq   #0,D0
02:00048772 41EC0394        	  5426:     lea     ($0394,A4),A0
02:00048776 11802000        	  5427:     move.b  D0,(A0,D2.W)
                            	  5428:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5429:     ;
02:0004877A 7040            	  5430:     moveq   #64,D0
02:0004877C 41EC03BC        	  5431:     lea     ($03BC,A4),A0
02:00048780 11802000        	  5432:     move.b  D0,(A0,D2.W)
                            	  5433:     ; If facing left and X < 2, then go change state to $40. The
                            	  5434:     ; boomerang is too close to the left edge of the screen.
                            	  5435:     ; Another move might make it wrap around.
                            	  5436:     ;
02:00048784 41EC0098        	  5437:     lea     ($0098,A4),A0
02:00048788 10302000        	  5438:     move.b  (A0,D2.W),D0
02:0004878C 1940000F        	  5439:     move.b  D0,($000F,A4)
02:00048790 02000002        	  5440:     andi.b #$02,D0
02:00048794 670A            	  5441:     beq  _L_z07_CheckState30_MoveBoomerang
02:00048796 10342070        	  5442:     move.b  ($70,A4,D2.W),D0
02:0004879A 0C000002        	  5443:     cmpi.b  #$02,D0
02:0004879E 650E            	  5444:     bcs  _L_z07_CheckState30_SetState40
                            	  5445:     even
                            	  5446: _L_z07_CheckState30_MoveBoomerang:
                            	  5447:     ; Move the boomerang.
                            	  5448:     ;
02:000487A0 6100F654        	  5449:     jsr     MoveObject
                            	  5450:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5451:     ; state to $40.
                            	  5452:     ;
02:000487A4 41EC0380        	  5453:     lea     ($0380,A4),A0
02:000487A8 53302000        	  5454:     subq.b  #1,(A0,D2.W)
02:000487AC 6614            	  5455:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5456:     even
                            	  5457: _L_z07_CheckState30_SetState40:
                            	  5458:     ; Set state $40, and a time to move of $20 frames.
                            	  5459:     ;
                            	  5460:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5461:     ;
                            	  5462:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5463:     ;
02:000487AE 7020            	  5464:     moveq   #32,D0
02:000487B0 41EC0380        	  5465:     lea     ($0380,A4),A0
02:000487B4 11802000        	  5466:     move.b  D0,(A0,D2.W)
02:000487B8 7040            	  5467:     moveq   #64,D0
02:000487BA 41EC00AC        	  5468:     lea     ($00AC,A4),A0
02:000487BE 11802000        	  5469:     move.b  D0,(A0,D2.W)
                            	  5470:     even
