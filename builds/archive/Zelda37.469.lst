02:0003877C 10343018        	  1037:     move.b  ($18,A4,D3.W),D0
02:00038780 E308            	  1038:     lsl.b  #1,D0   ; ASL A
02:00038782 E308            	  1039:     lsl.b  #1,D0   ; ASL A
02:00038784 E308            	  1040:     lsl.b  #1,D0   ; ASL A
02:00038786 E308            	  1041:     lsl.b  #1,D0   ; ASL A
02:00038788 0C000050        	  1042:     cmpi.b  #$50,D0
02:0003878C 6530            	  1043:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003878E 0C0000E0        	  1044:     cmpi.b  #$E0,D0
