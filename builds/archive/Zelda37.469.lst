02:00038490 41EC0098        	   624:     lea     ($0098,A4),A0
02:00038494 11802000        	   625:     move.b  D0,(A0,D2.W)
02:00038498 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:0003849C 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:000384A0 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:000384A4 7074            	   629:     moveq   #116,D0
02:000384A6 4EB9000471F0    	   630:     jsr     ChangeTileObjTiles
