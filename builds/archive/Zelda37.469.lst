                            	  4341: 
                            	  4342: ; Params:
                            	  4343: ; [02:03]: address of door tiles for direction and face
                            	  4344: ; [04]: count of tiles remaining
                            	  4345: ; [07]: current index (0 to 3) of the tile to copy
                            	  4346: ;       to the dynamic transfer buf
                            	  4347: ; [09]: door direction index
                            	  4348: ;
                            	  4349: ; Returns:
                            	  4350: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4351: ; [04]: original value - 1
                            	  4352: ; [07]: original value + 1
                            	  4353: ;
                            	  4354: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4355: ; vertically. The point of this routine is to access them
                            	  4356: ; horizontally in order to transfer them to a nametable.
                            	  4357: ;
                            	  4358: ;
                            	  4359: ; For the direction index in [09], look up the base offset of the
                            	  4360: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4361: ; the door face tiles at [02:03].
                            	  4362: ;
                            	  4363:     even
                            	  4364: WriteDoorFaceTileHorizontally:
02:0003EAC4 7600            	  4365:     moveq   #0,D3
02:0003EAC6 162C0009        	  4366:     move.b  ($0009,A4),D3
02:0003EACA 41F90003FCE8    	  4367:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:0003EAD0 10303000        	  4368:     move.b  (A0,D3.W),D0
                            	  4369:     ; Add [07] to the base offset we got above. This yields one
                            	  4370:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4371:     ;
02:0003EAD4 023C00EE        	  4372:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EAD8 122C0007        	  4373:     move.b  ($0007,A4),D1
02:0003EADC D101            	  4374:     addx.b  D1,D0   ; ADC $07
02:0003EADE 7600            	  4375:     moveq   #0,D3
02:0003EAE0 1600            	  4376:     move.b  D0,D3
                            	  4377:     ; With that index, look up the index to use with the door face
                            	  4378:     ; list of tiles at [02:03].
                            	  4379:     ;
02:0003EAE2 41F90003FCDA    	  4380:     lea     (HorizontalDoorFaceIndexes).l,A0
02:0003EAE8 10303000        	  4381:     move.b  (A0,D3.W),D0
02:0003EAEC 7600            	  4382:     moveq   #0,D3
02:0003EAEE 1600            	  4383:     move.b  D0,D3
                            	  4384:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4385:     ; and copy it to the dynamic transfer buf.
                            	  4386:     ;
02:0003EAF0 122C0002        	  4387:     move.b  ($02,A4),D1   ; ptr lo
02:0003EAF4 182C0003        	  4388:     move.b  ($03,A4),D4  ; ptr hi
02:0003EAF8 024100FF        	  4389:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003EAFC E14C            	  4390:     lsl.w   #8,D4
02:0003EAFE 8841            	  4391:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003EB00 48C4            	  4392:     ext.l   D4
02:0003EB02 D8BC00FF0000    	  4393:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003EB08 2044            	  4394:     movea.l D4,A0
02:0003EB0A 10303000        	  4395:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003EB0E 41EC0302        	  4396:     lea     ($0302,A4),A0
02:0003EB12 11802000        	  4397:     move.b  D0,(A0,D2.W)
                            	  4398:     ; Prepare for the next call:
                            	  4399:     ; - increment dynamic transfer buf pointer
                            	  4400:     ; - increment index of tile to copy [07]
                            	  4401:     ; - decrement count of tiles remaining
                            	  4402:     ;
02:0003EB16 5202            	  4403:     addq.b  #1,D2
02:0003EB18 522C0007        	  4404:     addq.b  #1,($0007,A4)
02:0003EB1C 532C0004        	  4405:     subq.b  #1,($0004,A4)
02:0003EB20 4E75            	  4406:     rts
