                            	  8720:     ; Copy the 8 bytes of the palette row transfer record template.
                            	  8721:     ;
02:0003BF5A 7600            	  8722:     moveq   #0,D3
                            	  8723:     even
                            	  8724: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003BF5C 41F90003BF34    	  8725:     lea     (GanonColorTransferRecord).l,A0
02:0003BF62 10303000        	  8726:     move.b  (A0,D3.W),D0
02:0003BF66 41EC0302        	  8727:     lea     ($0302,A4),A0
02:0003BF6A 11802000        	  8728:     move.b  D0,(A0,D2.W)
02:0003BF6E 5202            	  8729:     addq.b  #1,D2
02:0003BF70 5203            	  8730:     addq.b  #1,D3
02:0003BF72 0C030008        	  8731:     cmpi.b  #$08,D3
02:0003BF76 66E4            	  8732:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003BF78 19420301        	  8733:     move.b  D2,($0301,A4)
02:0003BF7C 101D            	  8734:     move.b  (A5)+,D0  ; PLA
02:0003BF7E 7600            	  8735:     moveq   #0,D3
02:0003BF80 1600            	  8736:     move.b  D0,D3
                            	  8737:     ; Overwrite the last 3 colors in the record, with the ones
                            	  8738:     ; ending at the index passed in.
                            	  8739:     ;
02:0003BF82 7402            	  8740:     moveq   #2,D2
                            	  8741:     even
