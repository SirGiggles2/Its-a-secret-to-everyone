02:00038B54 41F900038AC2    	  1613:     lea     (BlueLeeverStateTimes).l,A0
02:00038B5A 10303000        	  1614:     move.b  (A0,D3.W),D0
02:00038B5E 19802028        	  1615:     move.b  D0,($28,A4,D2.W)
                            	  1616:     even
                            	  1617: _L_z04_UpdateBurrower_Animate:
                            	  1618:     ; Advance the animation counter; possibly setting a new
                            	  1619:     ; value according to the new state.
                            	  1620:     ;
02:00038B62 7600            	  1621:     moveq   #0,D3
