02:0003BD64 8001            	  8451:     or.b  D1,D0
02:0003BD66 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BD6A 41F90003BC34    	  8453:     lea     (GanonBurstTiles).l,A0
02:0003BD70 10302000        	  8454:     move.b  (A0,D2.W),D0
02:0003BD74 4EB900031100    	  8455:     jsr     Anim_WriteSprite
                            	  8456:     ; Bottom of the loop.
                            	  8457:     ; Increment object slot while <= 9.
                            	  8458:     ;
02:0003BD7A 5202            	  8459:     addq.b  #1,D2
02:0003BD7C 0C02000A        	  8460:     cmpi.b  #$0A,D2
02:0003BD80 65AC            	  8461:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8462:     ; Restore the object index.
                            	  8463:     ;
02:0003BD82 101D            	  8464:     move.b  (A5)+,D0  ; PLA
02:0003BD84 19400340        	  8465:     move.b  D0,($0340,A4)
02:0003BD88 0A3C0001        	  8466:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BD8C 4E75            	  8467:     rts
