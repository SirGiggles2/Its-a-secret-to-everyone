                            	  4519: Digdogger_Draw:
02:0003A03A 7006            	  4520:     moveq   #6,D0
02:0003A03C 4EB900049072    	  4521:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  4522:     ; If this is a child digdogger, then go draw it.
                            	  4523:     ;
02:0003A042 41EC046B        	  4524:     lea     ($046B,A4),A0
02:0003A046 10302000        	  4525:     move.b  (A0,D2.W),D0
02:0003A04A 666C            	  4526:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  4527:     ; For each part of the big digdogger, from 0 to 3,
                            	  4528:     ; indexed by Y register:
                            	  4529:     ;
02:0003A04C 7600            	  4530:     moveq   #0,D3
                            	  4531:     even
                            	  4532: _L_z04_Digdogger_Draw_LoopPart:
                            	  4533:     ; Store in [00] the X coordinate offset for the current corner.
                            	  4534:     ;
02:0003A04E 10342070        	  4535:     move.b  ($70,A4,D2.W),D0
02:0003A052 023C00EE        	  4536:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A056 41F90003A02E    	  4537:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003A05C 12303000        	  4538:     move.b  (A0,D3.W),D1
02:0003A060 D101            	  4539:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003A062 1880            	  4540:     move.b  D0,($0000,A4)
                            	  4541:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  4542:     ;
