02:0004CD78 660C            	  6974:     bne  _anon_z07_39
02:0004CD7A 102C00AC        	  6975:     move.b  ($00AC,A4),D0
02:0004CD7E 020000C0        	  6976:     andi.b #$C0,D0
02:0004CD82 194000AC        	  6977:     move.b  D0,($00AC,A4)
