02:000452DC 7600            	  8756:     moveq   #0,D3
02:000452DE 1600            	  8757:     move.b  D0,D3
                            	  8758:     ; The map marks are arranged in the same order as all the
                            	  8759:     ; possible values of OpenDoorMask.
                            	  8760:     ;
                            	  8761:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8762:     ; dynamic transfer buf at the current offset.
                            	  8763:     ;
