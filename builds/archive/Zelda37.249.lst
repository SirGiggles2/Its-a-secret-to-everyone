02:0003C600 41EC0084        	  6087:     lea     ($0084,A4),A0
02:0003C604 11802000        	  6088:     move.b  D0,(A0,D2.W)
02:0003C608 101D            	  6089:     move.b  (A5)+,D0  ; PLA
02:0003C60A 19802070        	  6090:     move.b  D0,($70,A4,D2.W)
