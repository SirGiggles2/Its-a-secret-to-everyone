02:0003CEB0 4E75            	  7264:     rts
                            	  7265: 
                            	  7266: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7267: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7268: ;
                            	  7269: ; But these are not typical direction indexes. Instead a
                            	  7270: ; 5-way index is used.
                            	  7271: ; A direction shifted right once becomes a 5-way index.
                            	  7272: ; The fourth element is unused.
                            	  7273: ;
                            	  7274:     even
                            	  7275: DodongoFrameImages:
02:0003CEB2 00              	  7276:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CEB3 01
02:0003CEB4 06
02:0003CEB5 FF
02:0003CEB6 08
02:0003CEB7 02
02:0003CEB8 03
02:0003CEB9 06
