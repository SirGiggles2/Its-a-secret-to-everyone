                            	  2948:     ;
02:00041A58 102C0002        	  2949:     move.b  ($0002,A4),D0
02:00041A5C 41F9000419D0    	  2950:     lea     (BorderBounds).l,A0
02:00041A62 12303000        	  2951:     move.b  (A0,D3.W),D1
