                            	  3582: DrawGhiniAndCheckCollisions:
02:0003B440 4EB90004CD24    	  3583:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B446 1940000D        	  3584:     move.b  D0,($000D,A4)
                            	  3585:     ; If the direction has an "up" component, then keep the
                            	  3586:     ; frame image 0, and go figure out horizontal flipping.
                            	  3587:     ;
02:0003B44A 41EC0098        	  3588:     lea     ($0098,A4),A0
02:0003B44E 10302000        	  3589:     move.b  (A0,D2.W),D0
02:0003B452 02000008        	  3590:     andi.b #$08,D0
