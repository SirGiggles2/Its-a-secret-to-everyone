                            	 12073: PatraChild_State1:
                            	 12074:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12075:     ;
02:0003F2A2 10342070        	 12076:     move.b  ($70,A4,D2.W),D0
02:0003F2A6 023C00EE        	 12077:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F2AA 122C046C        	 12078:     move.b  ($046C,A4),D1
02:0003F2AE D101            	 12079:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003F2B0 19802070        	 12080:     move.b  D0,($70,A4,D2.W)
02:0003F2B4 41EC0084        	 12081:     lea     ($0084,A4),A0
02:0003F2B8 10302000        	 12082:     move.b  (A0,D2.W),D0
02:0003F2BC 023C00EE        	 12083:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F2C0 122C0479        	 12084:     move.b  ($0479,A4),D1
02:0003F2C4 D101            	 12085:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003F2C6 41EC0084        	 12086:     lea     ($0084,A4),A0
02:0003F2CA 11802000        	 12087:     move.b  D0,(A0,D2.W)
                            	 12088:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12089:     ;
02:0003F2CE 7000            	 12090:     moveq   #0,D0
02:0003F2D0 1940000B        	 12091:     move.b  D0,($000B,A4)
                            	 12092:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12093:     ; monster's angle by $70, else by $60 to go slower.
                            	 12094:     ;
02:0003F2D4 7070            	 12095:     moveq   #112,D0
02:0003F2D6 7600            	 12096:     moveq   #0,D3
02:0003F2D8 41EC034F        	 12097:     lea     ($034F,A4),A0
02:0003F2DC 16302000        	 12098:     move.b  (A0,D2.W),D3
02:0003F2E0 0C030025        	 12099:     cmpi.b  #$25,D3
02:0003F2E4 6702            	 12100:     beq  _anon_z04_159
02:0003F2E6 7060            	 12101:     moveq   #96,D0
                            	 12102: _anon_z04_159:
02:0003F2E8 61000D9C        	 12103:     jsr     DecreaseObjectAngle
                            	 12104:     ; Load Patra's maneuver index.
                            	 12105:     ; It determines which counts of bits are looked up below.
                            	 12106:     ;
02:0003F2EC 7600            	 12107:     moveq   #0,D3
02:0003F2EE 162C045F        	 12108:     move.b  ($045F,A4),D3
                            	 12109:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12110:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12111:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12112:     ;
02:0003F2F2 41EC034F        	 12113:     lea     ($034F,A4),A0
02:0003F2F6 10302000        	 12114:     move.b  (A0,D2.W),D0
02:0003F2FA 0C000025        	 12115:     cmpi.b  #$25,D0
02:0003F2FE 661E            	 12116:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F300 41F90003F1F2    	 12117:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F306 10303000        	 12118:     move.b  (A0,D3.W),D0
02:0003F30A 1B00            	 12119:     move.b  D0,-(A5)  ; PHA
02:0003F30C 41F90003F1F6    	 12120:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F312 10303000        	 12121:     move.b  (A0,D3.W),D0
02:0003F316 7600            	 12122:     moveq   #0,D3
02:0003F318 1600            	 12123:     move.b  D0,D3
02:0003F31A 101D            	 12124:     move.b  (A5)+,D0  ; PLA
02:0003F31C 600E            	 12125:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12126: 
                            	 12127:     even
                            	 12128: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12129:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12130:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12131:     ; a small circle (5) and a large circle (6).
                            	 12132:     ;
02:0003F31E 41F90003F1F4    	 12133:     lea     (PatraChild2RotationBits).l,A0
02:0003F324 10303000        	 12134:     move.b  (A0,D3.W),D0
02:0003F328 7600            	 12135:     moveq   #0,D3
02:0003F32A 1600            	 12136:     move.b  D0,D3
