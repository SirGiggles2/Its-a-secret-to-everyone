                            	  7132:     ;
02:000444BA 4EB9000314CC    	  7133:     jsr     AddToInt16At0
                            	  7134:     ; Assume that we'll write a type 1 square with primary square
                            	  7135:     ; taken from [05]. If so, the square index doesn't matter
                            	  7136:     ; as long as >= $10. See WriteSquareOW.
                            	  7137:     ;
02:000444C0 7600            	  7138:     moveq   #0,D3
02:000444C2 7410            	  7139:     moveq   #16,D2
02:000444C4 102C0005        	  7140:     move.b  ($0005,A4),D0
                            	  7141:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7142:     ; So, we have to look up the square index corresponding
                            	  7143:     ; to primary square/tile in [05].
                            	  7144:     ;
                            	  7145:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7146:     ; then the X register will have the square index value.
                            	  7147:     ;
02:000444C8 0C000027        	  7148:     cmpi.b  #$27,D0
02:000444CC 6506            	  7149:     bcs  _anon_z05_148
02:000444CE 0C0000F3        	  7150:     cmpi.b  #$F3,D0
02:000444D2 6514            	  7151:     bcs  _L_z05_ChangePlayMapSquareOW_Write
                            	  7152: _anon_z05_148:
02:000444D4 740E            	  7153:     moveq   #14,D2
                            	  7154: _anon_z05_149:
02:000444D6 41F900043E92    	  7155:     lea     (PrimarySquaresOW).l,A0
02:000444DC 12302000        	  7156:     move.b  (A0,D2.W),D1
02:000444E0 B001            	  7157:     cmp.b   D1,D0
02:000444E2 6704            	  7158:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:000444E4 5302            	  7159:     subq.b  #1,D2
02:000444E6 66EE            	  7160:     bne  _anon_z05_149
                            	  7161:     even
                            	  7162: _L_z05_ChangePlayMapSquareOW_Write:
                            	  7163:     ; Write the square.
                            	  7164:     ;
02:000444E8 1942000D        	  7165:     move.b  D2,($000D,A4)
02:000444EC 6100FCDA        	  7166:     jsr     WriteSquareOW
02:000444F0 101D            	  7167:     move.b  (A5)+,D0  ; PLA
02:000444F2 7400            	  7168:     moveq   #0,D2
02:000444F4 1400            	  7169:     move.b  D0,D2
02:000444F6 4E75            	  7170:     rts
                            	  7171: 
                            	  7172: ; Returns:
                            	  7173: ; [$00:01]: address of room tile map
                            	  7174:     even
