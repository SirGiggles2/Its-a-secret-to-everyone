                            	 12218:     ;
02:0003F3B6 102C051C        	 12219:     move.b  ($051C,A4),D0
02:0003F3BA 0200000F        	 12220:     andi.b #$0F,D0
02:0003F3BE 0C000004        	 12221:     cmpi.b  #$04,D0
02:0003F3C2 6702            	 12222:     beq.s  __far_z_04_0115
02:0003F3C4 6042            	 12223:     jmp  Ganon_DrawBodyFrame0
