02:0003B376 41EC0098        	  3463:     lea     ($0098,A4),A0
02:0003B37A 10302000        	  3464:     move.b  (A0,D2.W),D0
02:0003B37E 7600            	  3465:     moveq   #0,D3
02:0003B380 1600            	  3466:     move.b  D0,D3
02:0003B382 0200000C        	  3467:     andi.b #$0C,D0
