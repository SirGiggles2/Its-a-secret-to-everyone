02:0003F6DC 06              	 12677:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003F6DD 08
02:0003F6DE 07
02:0003F6DF 09
02:0003F6E0 00
02:0003F6E1 00
02:0003F6E2 01
02:0003F6E3 01
