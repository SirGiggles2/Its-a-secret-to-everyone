                            	 13114:     ;
02:0003FA10 700F            	 13115:     moveq   #15,D0
02:0003FA12 7600            	 13116:     moveq   #0,D3
02:0003FA14 162C0051        	 13117:     move.b  ($0051,A4),D3
02:0003FA18 6702            	 13118:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
02:0003FA1A 7000            	 13119:     moveq   #0,D0
                            	 13120:     even
