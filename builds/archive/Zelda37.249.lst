                            	  7750: _L_z05_PrepFullBlackRow_Add20H:
02:00044BF8 023C00EE        	  7751:     andi    #$EE,CCR  ; CLC: clear C+X
02:00044BFC 123C0020        	  7752:     move.b  #$20,D1
02:00044C00 D101            	  7753:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00044C02 6404            	  7754:     bcc  _anon_z05_169
02:00044C04 522C0302        	  7755:     addq.b  #1,($0302,A4)
