02:0003DF5E 122C0002        	  9502:     move.b  ($0002,A4),D1
02:0003DF62 E309            	  9503:     lsl.b  #1,D1   ; ASL $02
02:0003DF64 19410002        	  9504:     move.b  D1,($0002,A4)
02:0003DF68 122C0002        	  9505:     move.b  ($0002,A4),D1
02:0003DF6C C200            	  9506:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF6E 671E            	  9507:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DF70 41EC0084        	  9508:     lea     ($0084,A4),A0
02:0003DF74 10302000        	  9509:     move.b  (A0,D2.W),D0
02:0003DF78 122C0003        	  9510:     move.b  ($0003,A4),D1
02:0003DF7C 0A3C0010        	  9511:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
