02:0003E0F4 640A            	  9693:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003E0F6 7000            	  9694:     moveq   #0,D0
02:0003E0F8 41EC0451        	  9695:     lea     ($0451,A4),A0
