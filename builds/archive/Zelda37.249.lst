                            	   107: _L_z02_TransferCommonPatterns_LoopBlock:
02:00032952 102C051D        	   108:     move.b  ($051D,A4),D0
02:00032956 E308            	   109:     lsl.b  #1,D0   ; ASL A
02:00032958 7400            	   110:     moveq   #0,D2
02:0003295A 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:0003295C 41F90003292E    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:00032962 3A02            	   117:     move.w  D2,D5
02:00032964 DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:00032966 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:0003296A 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:0003296E 41F90003293A    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:00032974 10302000        	   122:     move.b  (A0,D2.W),D0
02:00032978 19400002        	   123:     move.b  D0,($0002,A4)
02:0003297C 41F900032940    	   124:     lea     (CommonPatternVramAddrs).l,A0
02:00032982 10302000        	   125:     move.b  (A0,D2.W),D0
02:00032986 4EB90000E32C    	   126:     jsr     _ppu_write_6  ; PPU $2006 write, D0=val
02:0003298C 5202            	   127:     addq.b  #1,D2
                            	   128:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:0003298E 41F90003293A    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:00032994 10302000        	   130:     move.b  (A0,D2.W),D0
02:00032998 19400003        	   131:     move.b  D0,($0003,A4)
02:0003299C 41F900032940    	   132:     lea     (CommonPatternVramAddrs).l,A0
02:000329A2 10302000        	   133:     move.b  (A0,D2.W),D0
02:000329A6 611C            	   134:     jsr     TransferPatternBlock_Bank2
                            	   135:     ; Loop until pattern block index = 3.
                            	   136:     ;
02:000329A8 102C051D        	   137:     move.b  ($051D,A4),D0
02:000329AC 0C000003        	   138:     cmpi.b  #$03,D0
02:000329B0 66A0            	   139:     bne  _L_z02_TransferCommonPatterns_LoopBlock
02:000329B2 705A            	   140:     moveq   #90,D0
02:000329B4 194000F5        	   141:     move.b  D0,($00F5,A4)
02:000329B8 7000            	   142:     moveq   #0,D0
02:000329BA 1940051D        	   143:     move.b  D0,($051D,A4)
02:000329BE 0A3C0001        	   144:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000329C2 4E75            	   145:     rts
                            	   146: 
                            	   147: ; Params:
                            	   148: ; [00:01]: source address
                            	   149: ; [03:02]: size
                            	   150: ; A: low byte of desination VRAM address
                            	   151: ;
                            	   152:     even
                            	   153: TransferPatternBlock_Bank2:
                            	   154:     ; PATCHED: fast bulk CHR transfer (bypasses per-byte _ppu_write_7)
02:000329C4 4EB90000E32C    	   155:     jsr     _ppu_write_6          ; complete PPU addr latch pair (sets PPU_VADDR)
02:000329CA 206C0004        	   156:     movea.l ($04,A4),A0           ; ROM source address
02:000329CE 323900FF0802    	   157:     move.w  (PPU_VADDR).l,D1      ; NES CHR destination address
02:000329D4 7400            	   158:     moveq   #0,D2
02:000329D6 142C0002        	   159:     move.b  ($0002,A4),D2         ; size hi byte
02:000329DA E14A            	   160:     lsl.w   #8,D2
02:000329DC 142C0003        	   161:     move.b  ($0003,A4),D2         ; size lo byte (D2.w = total bytes)
02:000329E0 48C2            	   162:     ext.l   D2                    ; D2.l = byte count
02:000329E2 610085B0        	   163:     jsr     _transfer_chr_block_fast
02:000329E6 522C051D        	   164:     addq.b  #1,($051D,A4)         ; increment block index
02:000329EA 4E75            	   165:     rts
