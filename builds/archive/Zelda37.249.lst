02:0003BF56 7401            	  5170:     moveq   #1,D2
                            	  5171:     even
                            	  5172: _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_LoopExtent:
                            	  5173:     ; If sprite X + extent >= $E9 or < $18, then
                            	  5174:     ; add priority attribute to show this sprite behind the background.
                            	  5175:     ;
