                            	  2596: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2597:     ; If reversal count >= 2, then
                            	  2598:     ; 1. invert the horizontal component of facing direction,
                            	  2599:     ;    to face away from the chase target
                            	  2600:     ; 2. reset the reversal count to 0.
                            	  2601:     ;
                            	  2602:     ; This prevents a jumper from getting stuck in a corner.
                            	  2603:     ;
                            	  2604:     ; For example, if a tektite's direction is down and right,
                            	  2605:     ; and jumps into the top right corner of the room:
                            	  2606:     ; 1. The right room boundary is hit. So the direction is
                            	  2607:     ;    automatically reversed to up and left.
                            	  2608:     ; 2. The next frame, the top room boundary is hit.
                            	  2609:     ;    The direction is reversed to down and right.
                            	  2610:     ;
                            	  2611:     ; As you can see, an endless loop has been made.
                            	  2612:     ;
02:0003ACE4 41EC0451        	  2613:     lea     ($0451,A4),A0
02:0003ACE8 10302000        	  2614:     move.b  (A0,D2.W),D0
02:0003ACEC 0C000002        	  2615:     cmpi.b  #$02,D0
02:0003ACF0 651E            	  2616:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:0003ACF2 41EC0098        	  2617:     lea     ($0098,A4),A0
02:0003ACF6 10302000        	  2618:     move.b  (A0,D2.W),D0
02:0003ACFA 0A000003        	  2619:     eori.b #$03,D0
02:0003ACFE 41EC0098        	  2620:     lea     ($0098,A4),A0
02:0003AD02 11802000        	  2621:     move.b  D0,(A0,D2.W)
02:0003AD06 7000            	  2622:     moveq   #0,D0
02:0003AD08 41EC0451        	  2623:     lea     ($0451,A4),A0
02:0003AD0C 11802000        	  2624:     move.b  D0,(A0,D2.W)
                            	  2625:     even
                            	  2626: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2627:     ; If the object is a boulder, then make sure its facing direction
                            	  2628:     ; has a down vertical component.
                            	  2629:     ;
02:0003AD10 610001F8        	  2630:     jsr     Jumper_PointBoulderDownward
                            	  2631:     ; For the given direction, get the Y offset of the destination
                            	  2632:     ; of the jump.
                            	  2633:     ;
                            	  2634:     ; Add it to the object's Y, and store this destination Y.
                            	  2635:     ;
02:0003AD14 7600            	  2636:     moveq   #0,D3
02:0003AD16 41EC0098        	  2637:     lea     ($0098,A4),A0
02:0003AD1A 16302000        	  2638:     move.b  (A0,D2.W),D3
02:0003AD1E 41EC0084        	  2639:     lea     ($0084,A4),A0
02:0003AD22 10302000        	  2640:     move.b  (A0,D2.W),D0
02:0003AD26 023C00EE        	  2641:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD2A 41F90003AC42    	  2642:     lea     (JumperYOffsets).l,A0
02:0003AD30 12303000        	  2643:     move.b  (A0,D3.W),D1
02:0003AD34 D101            	  2644:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003AD36 41EC0444        	  2645:     lea     ($0444,A4),A0
02:0003AD3A 11802000        	  2646:     move.b  D0,(A0,D2.W)
                            	  2647:     ; Set the starting speed, depending on the object type.
                            	  2648:     ;
02:0003AD3E 610001A0        	  2649:     jsr     Jumper_GetKind
