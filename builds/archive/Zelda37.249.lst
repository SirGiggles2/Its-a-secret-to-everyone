                            	  6784: UpdateDodongoState0_Move:
                            	  6785:     ; If facing left, then push X offset 0 on the stack.
                            	  6786:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6787:     ;
                            	  6788:     ; We would like to use one set of coordinates only.
                            	  6789:     ; But movement would break down, if we did; because
                            	  6790:     ; Dodongo is so long.
                            	  6791:     ;
                            	  6792:     ; So, when not facing left, we temporarily shift the
                            	  6793:     ; X coordinate to be closer to the other side of the monster.
                            	  6794:     ;
02:0003CB7C 7600            	  6795:     moveq   #0,D3
02:0003CB7E 41EC0098        	  6796:     lea     ($0098,A4),A0
02:0003CB82 10302000        	  6797:     move.b  (A0,D2.W),D0
02:0003CB86 0200000D        	  6798:     andi.b #$0D,D0
02:0003CB8A 6716            	  6799:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003CB8C 10342070        	  6800:     move.b  ($70,A4,D2.W),D0
02:0003CB90 023C00EE        	  6801:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB94 123C0010        	  6802:     move.b  #$10,D1
02:0003CB98 D101            	  6803:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CB9A 19802070        	  6804:     move.b  D0,($70,A4,D2.W)
02:0003CB9E 163C00F0        	  6805:     move.b  #$F0,D3
                            	  6806:     even
                            	  6807: _L_z04_UpdateDodongoState0_Move_Move:
02:0003CBA2 1003            	  6808:     move.b  D3,D0
02:0003CBA4 1B00            	  6809:     move.b  D0,-(A5)  ; PHA
02:0003CBA6 7020            	  6810:     moveq   #32,D0
02:0003CBA8 41EC041F        	  6811:     lea     ($041F,A4),A0
02:0003CBAC 11802000        	  6812:     move.b  D0,(A0,D2.W)
02:0003CBB0 6100D0F4        	  6813:     jsr     Wanderer_TargetPlayer
                            	  6814:     ; Pop the offset and add it to the X coordinate.
                            	  6815:     ;
                            	  6816:     ; This brings the X coordinate back to the unique value
                            	  6817:     ; that represents the position.
                            	  6818:     ;
02:0003CBB4 101D            	  6819:     move.b  (A5)+,D0  ; PLA
02:0003CBB6 023C00EE        	  6820:     andi    #$EE,CCR  ; CLC: clear C+X
