02:0003A5C6 610001F8        	  1495:     jsr     Gel_CheckCollisions
02:0003A5CA 41EC0405        	  1496:     lea     ($0405,A4),A0
02:0003A5CE 10302000        	  1497:     move.b  (A0,D2.W),D0
02:0003A5D2 664E            	  1498:     bne  _L_z04_Zol_CheckCollisions_Exit
02:0003A5D4 41EC04F0        	  1499:     lea     ($04F0,A4),A0
02:0003A5D8 10302000        	  1500:     move.b  (A0,D2.W),D0
02:0003A5DC 6744            	  1501:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1502:     ; If vertically aligned with the square grid, then
                            	  1503:     ; use a horizontal direction mask (3).
