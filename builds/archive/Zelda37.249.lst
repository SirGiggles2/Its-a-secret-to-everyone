02:000452AC 2044            	  8729:     movea.l D4,A0
02:000452AE 10303000        	  8730:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000452B2 02000020        	  8731:     andi.b #$20,D0
                            	  8732:     ; If it's been visited, then check each of the 4 doors,
