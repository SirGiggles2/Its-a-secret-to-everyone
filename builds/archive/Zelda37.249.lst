                            	  5171: UpdateBoomerangOrFood:
                            	  5172:     ; If state = 0, then not active. So, return.
                            	  5173:     ;
02:0004C13A 41EC00AC        	  5174:     lea     ($00AC,A4),A0
02:0004C13E 10302000        	  5175:     move.b  (A0,D2.W),D0
02:0004C142 6602            	  5176:     bne.s  __far_z_07_0078
02:0004C144 60F2            	  5177:     jmp  L1F49F_Exit
                            	  5178: __far_z_07_0078:
                            	  5179:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5180:     ;
02:0004C146 E308            	  5181:     lsl.b  #1,D0   ; ASL A
02:0004C148 6504            	  5182:     bcs.s  __far_z_07_0079
02:0004C14A 600000AA        	  5183:     jmp  UpdateArrowOrBoomerang
                            	  5184: __far_z_07_0079:
                            	  5185:     ; The object is food.
                            	  5186:     ;
                            	  5187:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5188:     ; If we reach state $83, then go deactivate the object.
                            	  5189:     ;
                            	  5190:     ; Nothing changes between the states. So, they are used as
                            	  5191:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5192:     ;
02:0004C14E 10342028        	  5193:     move.b  ($28,A4,D2.W),D0
02:0004C152 6622            	  5194:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:0004C154 41EC00AC        	  5195:     lea     ($00AC,A4),A0
02:0004C158 52302000        	  5196:     addq.b  #1,(A0,D2.W)
02:0004C15C 41EC00AC        	  5197:     lea     ($00AC,A4),A0
02:0004C160 10302000        	  5198:     move.b  (A0,D2.W),D0
02:0004C164 0200000F        	  5199:     andi.b #$0F,D0
02:0004C168 0C000003        	  5200:     cmpi.b  #$03,D0
02:0004C16C 674C            	  5201:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:0004C16E 103C00FF        	  5202:     move.b  #$FF,D0
