                            	  5711: Moldorm_ChangeFlyingState:
                            	  5712:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5713:     ;
02:0003C3C4 61000096        	  5714:     jsr     Flyer_MoldormDecideState
02:0003C3C8 7010            	  5715:     moveq   #16,D0
02:0003C3CA 19802028        	  5716:     move.b  D0,($28,A4,D2.W)
                            	  5717:     ; If the next lower slot's direction <> 0, then
                            	  5718:     ; go propagate direction changes down the chain.
                            	  5719:     ;
                            	  5720:     ; But you had to have propagated directions once for the
                            	  5721:     ; next lower direction to be set. How does it happen?
                            	  5722:     ;
                            	  5723:     ; Within a flyer state, the flying routines turn the flyer
                            	  5724:     ; and set the object timer to $10 several times. After any of
                            	  5725:     ; those times will the test succeed.
                            	  5726:     ;
                            	  5727:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5728:     ; in this block to set the timer to $10, and try to propagate
                            	  5729:     ; directions.
                            	  5730:     ;
                            	  5731:     ; But this is also the case the first time here.
                            	  5732:     ;
                            	  5733:     ; So, I believe that the point of this test is to delay moving
                            	  5734:     ; the lower (not head) segments when starting out.
                            	  5735:     ;
02:0003C3CE 41EC0097        	  5736:     lea     ($0097,A4),A0
02:0003C3D2 10302000        	  5737:     move.b  (A0,D2.W),D0
02:0003C3D6 6702            	  5738:     beq.s  __far_z_04_0042
02:0003C3D8 601C            	  5739:     jmp  Moldorm_PropagateDirs
                            	  5740: __far_z_04_0042:
02:0003C3DA 4E75            	  5741:     rts
                            	  5742: 
                            	  5743:     even
                            	  5744: Moldorm_Wander:
