02:0003BFDE 0C000060        	  5232:     cmpi.b  #$60,D0
02:0003BFE2 6718            	  5233:     beq  _L_z04_UpdateRope_CheckSpeed
02:0003BFE4 10342028        	  5234:     move.b  ($28,A4,D2.W),D0
02:0003BFE8 6612            	  5235:     bne  _L_z04_UpdateRope_CheckSpeed
02:0003BFEA 10342018        	  5236:     move.b  ($18,A4,D2.W),D0
02:0003BFEE 0200003F        	  5237:     andi.b #$3F,D0
02:0003BFF2 19802028        	  5238:     move.b  D0,($28,A4,D2.W)
02:0003BFF6 4EB90004BC10    	  5239:     jsr     _FaceUnblockedDir
                            	  5240:     even
                            	  5241: _L_z04_UpdateRope_CheckSpeed:
02:0003BFFC 101D            	  5242:     move.b  (A5)+,D0  ; PLA
                            	  5243:     ; If the facing direction has changed, then set qspeed to $20 (slow).
                            	  5244:     ;
02:0003BFFE 41EC0098        	  5245:     lea     ($0098,A4),A0
02:0003C002 12302000        	  5246:     move.b  (A0,D2.W),D1
02:0003C006 B001            	  5247:     cmp.b   D1,D0
02:0003C008 670A            	  5248:     beq  _anon_z04_76
02:0003C00A 7020            	  5249:     moveq   #32,D0
02:0003C00C 41EC03BC        	  5250:     lea     ($03BC,A4),A0
02:0003C010 11802000        	  5251:     move.b  D0,(A0,D2.W)
                            	  5252: _anon_z04_76:
                            	  5253:     ; If qspeed <> $20 or grid offset <> 0, then go draw.
                            	  5254:     ;
02:0003C014 41EC03BC        	  5255:     lea     ($03BC,A4),A0
02:0003C018 10302000        	  5256:     move.b  (A0,D2.W),D0
02:0003C01C 0C000020        	  5257:     cmpi.b  #$20,D0
02:0003C020 6660            	  5258:     bne  _L_z04_UpdateRope_Animate
02:0003C022 41EC0394        	  5259:     lea     ($0394,A4),A0
02:0003C026 10302000        	  5260:     move.b  (A0,D2.W),D0
02:0003C02A 6656            	  5261:     bne  _L_z04_UpdateRope_Animate
                            	  5262:     ; If the absolute horizontal distance between Link and the monster >= 8,
                            	  5263:     ; then go see if the vertical distance is smaller.
                            	  5264:     ;
02:0003C02C 102C0070        	  5265:     move.b  ($0070,A4),D0
02:0003C030 003C0011        	  5266:     ori     #$11,CCR  ; SEC: set C+X
02:0003C034 12342070        	  5267:     move.b  ($70,A4,D2.W),D1
02:0003C038 0A3C0010        	  5268:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C03C 9101            	  5269:     subx.b  D1,D0   ; SBC ObjX,X
02:0003C03E 0A3C0010        	  5270:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C042 4EB900031078    	  5271:     jsr     Abs
02:0003C048 0C000008        	  5272:     cmpi.b  #$08,D0
02:0003C04C 64000088        	  5273:     bcc  _L_z04_UpdateRope_CheckVertical
                            	  5274:     ; Face up.
                            	  5275:     ;
02:0003C050 7008            	  5276:     moveq   #8,D0
02:0003C052 41EC0098        	  5277:     lea     ($0098,A4),A0
02:0003C056 11802000        	  5278:     move.b  D0,(A0,D2.W)
                            	  5279:     ; But, if Link is down from the monster, then face down.
                            	  5280:     ;
