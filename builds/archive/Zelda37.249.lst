                            	  6669:     ; Store it in [00].
                            	  6670:     ;
02:0003CA96 10342070        	  6671:     move.b  ($70,A4,D2.W),D0
02:0003CA9A 023C00EE        	  6672:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA9E 41F90003CA72    	  6673:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003CAA4 12303000        	  6674:     move.b  (A0,D3.W),D1
02:0003CAA8 D101            	  6675:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003CAAA 1880            	  6676:     move.b  D0,($0000,A4)
                            	  6677:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6678:     ; Store it in [01].
                            	  6679:     ;
02:0003CAAC 41EC0084        	  6680:     lea     ($0084,A4),A0
02:0003CAB0 10302000        	  6681:     move.b  (A0,D2.W),D0
02:0003CAB4 023C00EE        	  6682:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAB8 41F90003CA6C    	  6683:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003CABE 12303000        	  6684:     move.b  (A0,D3.W),D1
02:0003CAC2 D101            	  6685:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003CAC4 19400001        	  6686:     move.b  D0,($0001,A4)
                            	  6687:     ; Calculate sprite attributes:
                            	  6688:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6689:     ;
                            	  6690:     ; If the boss is temporarily invincible, then
                            	  6691:     ; this makes it flash by cycling all the palette rows.
                            	  6692:     ;
                            	  6693:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6694:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6695:     ;
02:0003CAC8 41EC04F0        	  6696:     lea     ($04F0,A4),A0
02:0003CACC 10302000        	  6697:     move.b  (A0,D2.W),D0
02:0003CAD0 02000003        	  6698:     andi.b #$03,D0
02:0003CAD4 0A000003        	  6699:     eori.b #$03,D0
02:0003CAD8 19400003        	  6700:     move.b  D0,($0003,A4)
02:0003CADC 7600            	  6701:     moveq   #0,D3
02:0003CADE 162C000A        	  6702:     move.b  ($000A,A4),D3
                            	  6703:     ; Look up the tile for this sprite.
                            	  6704:     ; If it's not the first one (face), then go write the sprite record.
                            	  6705:     ;
02:0003CAE2 41F90003CA60    	  6706:     lea     (AquamentusTiles).l,A0
02:0003CAE8 10303000        	  6707:     move.b  (A0,D3.W),D0
02:0003CAEC 12390003CA60    	  6708:     move.b  (AquamentusTiles).l,D1
02:0003CAF2 B001            	  6709:     cmp.b   D1,D0
02:0003CAF4 6610            	  6710:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6711:     ; Else it's the first one (the face tile).
                            	  6712:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6713:     ;
                            	  6714:     ; $CC/CD shows the closed mouth face.
                            	  6715:     ; $C0/C1 shows the open mouth face.
                            	  6716:     ;
02:0003CAF6 7600            	  6717:     moveq   #0,D3
02:0003CAF8 16342028        	  6718:     move.b  ($28,A4,D2.W),D3
02:0003CAFC 0C030020        	  6719:     cmpi.b  #$20,D3
02:0003CB00 6404            	  6720:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003CB02 103C00C0        	  6721:     move.b  #$C0,D0
