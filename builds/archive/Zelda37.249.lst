                            	  3649: InitArmosOrFlyingGhini:
                            	  3650:     ; In UpdateObject, this object was flagged "initialized".
                            	  3651:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3652:     ;
02:0003B49E 10342028        	  3653:     move.b  ($28,A4,D2.W),D0
02:0003B4A2 41EC0492        	  3654:     lea     ($0492,A4),A0
02:0003B4A6 11802000        	  3655:     move.b  D0,(A0,D2.W)
                            	  3656:     ; If it's still fading in, then go finish some initialization needed
                            	  3657:     ; for fading in.
                            	  3658:     ;
02:0003B4AA 660000B6        	  3659:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3660:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3661:     ; go finish initializing it.
                            	  3662:     ;
02:0003B4AE 41EC034F        	  3663:     lea     ($034F,A4),A0
02:0003B4B2 10302000        	  3664:     move.b  (A0,D2.W),D0
02:0003B4B6 0C000022        	  3665:     cmpi.b  #$22,D0
02:0003B4BA 670000A6        	  3666:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3667:     ; Else we have an armos.
                            	  3668:     ;
                            	  3669:     ; Store stairs tile $70 in [00] for use later.
                            	  3670:     ;
02:0003B4BE 7070            	  3671:     moveq   #112,D0
02:0003B4C0 1880            	  3672:     move.b  D0,($0000,A4)
                            	  3673:     ; Look for the current room ID in an array of room ID's that
                            	  3674:     ; have armos secrets.
                            	  3675:     ;
02:0003B4C2 7606            	  3676:     moveq   #6,D3
                            	  3677:     even
                            	  3678: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B4C4 102C00EB        	  3679:     move.b  ($00EB,A4),D0
                            	  3680:     ; If this element does not match the current room ID, go loop again.
                            	  3681:     ;
02:0003B4C8 41F90003B48E    	  3682:     lea     (SecretArmosRoomIds).l,A0
02:0003B4CE 12303000        	  3683:     move.b  (A0,D3.W),D1
02:0003B4D2 B001            	  3684:     cmp.b   D1,D0
02:0003B4D4 6648            	  3685:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3686:     ; The secret (usually stairs) is under one of the armoses.
                            	  3687:     ;
                            	  3688:     ; If the armos's X coordinate does not match the one needed
                            	  3689:     ; for the current room in the list, then go loop again.
                            	  3690:     ;
02:0003B4D6 10342070        	  3691:     move.b  ($70,A4,D2.W),D0
02:0003B4DA 41F90003B496    	  3692:     lea     (SecretArmosXs).l,A0
02:0003B4E0 12303000        	  3693:     move.b  (A0,D3.W),D1
02:0003B4E4 B001            	  3694:     cmp.b   D1,D0
02:0003B4E6 6636            	  3695:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3696:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3697:     ;
02:0003B4E8 41EC0084        	  3698:     lea     ($0084,A4),A0
02:0003B4EC 10302000        	  3699:     move.b  (A0,D2.W),D0
02:0003B4F0 0C000080        	  3700:     cmpi.b  #$80,D0
02:0003B4F4 6628            	  3701:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3702:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3703:     ;
02:0003B4F6 4A03            	  3704:     cmpi.b  #$00,D3
02:0003B4F8 662C            	  3705:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3706:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3707:     ; has the power bracelet.
                            	  3708:     ;
                            	  3709:     ; Set up the room item with the armos's coordinates.
                            	  3710:     ;
02:0003B4FA 19400097        	  3711:     move.b  D0,($0097,A4)
02:0003B4FE 10342070        	  3712:     move.b  ($70,A4,D2.W),D0
02:0003B502 19400083        	  3713:     move.b  D0,($0083,A4)
                            	  3714:     ; This resets the room item's state, which activates it.
                            	  3715:     ;
02:0003B506 194300BF        	  3716:     move.b  D3,($00BF,A4)
                            	  3717:     ; Set the room item ID.
                            	  3718:     ;
02:0003B50A 7014            	  3719:     moveq   #20,D0
02:0003B50C 194000AB        	  3720:     move.b  D0,($00AB,A4)
                            	  3721:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3722:     ;
                            	  3723:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3724:     ;
                            	  3725:     ; Note that, if the item was already taken, then the room item
                            	  3726:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3727:     ; it will be ignored, because that routine checks whether
                            	  3728:     ; the item was taken.
                            	  3729:     ;
02:0003B510 4EB900031572    	  3730:     jsr     GetRoomFlagUWItemState
02:0003B516 660A            	  3731:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B518 6100069E        	  3732:     jsr     PlaySecretFoundTune
02:0003B51C 6604            	  3733:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3734:     even
                            	  3735: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3736:     ; Bottom of the loop.
                            	  3737:     ;
02:0003B51E 5303            	  3738:     subq.b  #1,D3
02:0003B520 6AA2            	  3739:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3740:     even
                            	  3741: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3742:     ; Not found, or found the power bracelet.
                            	  3743:     ; Use a floor tile $26 to replace the armos.
                            	  3744:     ;
02:0003B522 7026            	  3745:     moveq   #38,D0
02:0003B524 1880            	  3746:     move.b  D0,($0000,A4)
                            	  3747:     even
                            	  3748: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B526 1014            	  3749:     move.b  ($0000,A4),D0
                            	  3750:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3751:     ;
02:0003B528 1B00            	  3752:     move.b  D0,-(A5)  ; PHA
02:0003B52A 0C000070        	  3753:     cmpi.b  #$70,D0
02:0003B52E 6604            	  3754:     bne  _anon_z04_51
02:0003B530 61000686        	  3755:     jsr     PlaySecretFoundTune
                            	  3756: _anon_z04_51:
                            	  3757:     ; Replace the tile where the armos was.
                            	  3758:     ;
02:0003B534 522C00F7        	  3759:     addq.b  #1,($00F7,A4)
02:0003B538 101D            	  3760:     move.b  (A5)+,D0  ; PLA
02:0003B53A 4EB90004AD88    	  3761:     jsr     ChangeTileObjTiles
                            	  3762:     ; Because the armos object is aligned to the square grid
                            	  3763:     ; (because it was made from a square),
                            	  3764:     ; set its grid offset to 3 to compensate.
                            	  3765:     ;
                            	  3766:     ; Most objects are aligned to the grid vertically when the
                            	  3767:     ; low nibble is $D.
                            	  3768:     ;
02:0003B540 7003            	  3769:     moveq   #3,D0
02:0003B542 41EC0394        	  3770:     lea     ($0394,A4),A0
02:0003B546 11802000        	  3771:     move.b  D0,(A0,D2.W)
                            	  3772:     ; Set a speed (q-speed fraction) randomly:
                            	  3773:     ; $20 if random value < $80
                            	  3774:     ; $60 otherwise
                            	  3775:     ;
02:0003B54A 7020            	  3776:     moveq   #32,D0
02:0003B54C 7600            	  3777:     moveq   #0,D3
02:0003B54E 16342019        	  3778:     move.b  ($19,A4,D2.W),D3
02:0003B552 0C030080        	  3779:     cmpi.b  #$80,D3
02:0003B556 6502            	  3780:     bcs  _anon_z04_52
02:0003B558 7060            	  3781:     moveq   #96,D0
                            	  3782: _anon_z04_52:
02:0003B55A 41EC03BC        	  3783:     lea     ($03BC,A4),A0
02:0003B55E 11802000        	  3784:     move.b  D0,(A0,D2.W)
                            	  3785:     even
                            	  3786: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3787:     ; Facing and input directions down.
                            	  3788:     ;
02:0003B562 7004            	  3789:     moveq   #4,D0
02:0003B564 41EC03F8        	  3790:     lea     ($03F8,A4),A0
02:0003B568 11802000        	  3791:     move.b  D0,(A0,D2.W)
02:0003B56C 41EC0098        	  3792:     lea     ($0098,A4),A0
02:0003B570 11802000        	  3793:     move.b  D0,(A0,D2.W)
                            	  3794:     ; Every other frame, return without drawing.
                            	  3795:     ;
02:0003B574 10342028        	  3796:     move.b  ($28,A4,D2.W),D0
02:0003B578 E208            	  3797:     lsr.b  #1,D0   ; LSR A
02:0003B57A 6512            	  3798:     bcs  _anon_z04_53
                            	  3799:     ; Finish initializing based on type.
                            	  3800:     ;
02:0003B57C 41EC034F        	  3801:     lea     ($034F,A4),A0
02:0003B580 10302000        	  3802:     move.b  (A0,D2.W),D0
02:0003B584 0C000022        	  3803:     cmpi.b  #$22,D0
02:0003B588 6602            	  3804:     bne.s  __far_z_04_0032
02:0003B58A 6008            	  3805:     jmp  L_EndInitFlyingGhini
                            	  3806: __far_z_04_0032:
02:0003B58C 6158            	  3807:     jsr     DrawArmosAndCheckCollisions
                            	  3808: _anon_z04_53:
02:0003B58E 0A3C0001        	  3809:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B592 4E75            	  3810:     rts
