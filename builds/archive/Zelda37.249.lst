                            	  5473: __far_z_07_0083:
                            	  5474:     ; State $2x. Spark.
                            	  5475:     ;
                            	  5476:     ; Change the state to $28, and decrement animation counter.
                            	  5477:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5478:     ; (with Link, if this is a monster's boomerang).
                            	  5479:     ;
                            	  5480:     ; TODO: Why state $28?
                            	  5481:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5482:     ; start over again when spinning.
                            	  5483:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5484:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5485:     ; any drawing code depends on the minor state.
                            	  5486:     ;
02:0004C350 7028            	  5487:     moveq   #40,D0
02:0004C352 41EC00AC        	  5488:     lea     ($00AC,A4),A0
02:0004C356 11802000        	  5489:     move.b  D0,(A0,D2.W)
02:0004C35A 41EC03D0        	  5490:     lea     ($03D0,A4),A0
