02:00032112 19400004        	  6404:     move.b  D0,($0004,A4)
02:00032116 102C0084        	  6405:     move.b  ($0084,A4),D0
02:0003211A 023C00EE        	  6406:     andi    #$EE,CCR  ; CLC: clear C+X
