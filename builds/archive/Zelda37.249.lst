02:0003B1FC 102C0001        	  3277:     move.b  ($0001,A4),D0
02:0003B200 003C0011        	  3278:     ori     #$11,CCR  ; SEC: set C+X
02:0003B204 122C0002        	  3279:     move.b  ($0002,A4),D1
02:0003B208 0A3C0010        	  3280:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B20C 9101            	  3281:     subx.b  D1,D0   ; SBC $02
02:0003B20E 0A3C0010        	  3282:     eori    #$10,CCR  ; restore X = 6502 C
