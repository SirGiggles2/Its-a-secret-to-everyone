                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:000438EE 102C0054        	  5844:     move.b  ($0054,A4),D0
02:000438F2 0C000004        	  5845:     cmpi.b  #$04,D0
02:000438F6 6626            	  5846:     bne  _anon_z05_123
02:000438F8 7400            	  5847:     moveq   #0,D2
02:000438FA 142C0009        	  5848:     move.b  ($0009,A4),D2
02:000438FE 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:00043902 102C0055        	  5850:     move.b  ($0055,A4),D0
02:00043906 0A00000F        	  5851:     eori.b #$0F,D0
02:0004390A 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:0004390E C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043910 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:00043914 7000            	  5859:     moveq   #0,D0
02:00043916 19400054        	  5860:     move.b  D0,($0054,A4)
02:0004391A 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:0004391E 102C0055        	  5870:     move.b  ($0055,A4),D0
02:00043922 19400002        	  5871:     move.b  D0,($0002,A4)
02:00043926 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:0004392A 0C000007        	  5873:     cmpi.b  #$07,D0
02:0004392E 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:00043930 7400            	  5879:     moveq   #0,D2
02:00043932 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00043936 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:0004393A 1003            	  5884:     move.b  D3,D0
02:0004393C 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:00043940 41F9000437FC    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043946 12302000        	  5887:     move.b  (A0,D2.W),D1
02:0004394A D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0004394C 7600            	  5889:     moveq   #0,D3
02:0004394E 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:00043950 1002            	  5893:     move.b  D2,D0
02:00043952 0A000001        	  5894:     eori.b #$01,D0
02:00043956 7400            	  5895:     moveq   #0,D2
02:00043958 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:0004395A 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:0004395C 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:00043960 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043964 E14C            	  5902:     lsl.w   #8,D4
02:00043966 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043968 48C4            	  5904:     ext.l   D4
02:0004396A D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043970 2044            	  5906:     movea.l D4,A0
02:00043972 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043976 41F90004AAB8    	  5908:     lea     (LevelMasks).l,A0
02:0004397C 12302000        	  5909:     move.b  (A0,D2.W),D1
02:00043980 8001            	  5910:     or.b  D1,D0
02:00043982 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:00043984 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00043988 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004398C E14C            	  5914:     lsl.w   #8,D4
02:0004398E 8841            	  5915:     or.w    D1,D4
02:00043990 48C4            	  5916:     ext.l   D4
02:00043992 D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:00043998 2044            	  5918:     movea.l D4,A0
02:0004399A 11803000        	  5919:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:0004399E 102C0055        	  5924:     move.b  ($0055,A4),D0
02:000439A2 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:000439A6 8001            	  5926:     or.b  D1,D0
02:000439A8 6000FF66        	  5927:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:000439AC 102C0055        	  5954:     move.b  ($0055,A4),D0
02:000439B0 19400002        	  5955:     move.b  D0,($0002,A4)
02:000439B4 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:000439B8 0C000005        	  5957:     cmpi.b  #$05,D0
02:000439BC 650C            	  5958:     bcs  _anon_z05_125
02:000439BE 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:000439C0 7004            	  5960:     moveq   #4,D0
02:000439C2 4EB900030BE0    	  5961:     jsr     PlaySample
02:000439C8 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:000439CA 0C000004        	  5969:     cmpi.b  #$04,D0
02:000439CE 6602            	  5970:     bne  _anon_z05_126
02:000439D0 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:000439D2 0C000001        	  5973:     cmpi.b  #$01,D0
