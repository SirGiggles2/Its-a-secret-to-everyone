02:000321C4 522C000C        	  6510:     addq.b  #1,($000C,A4)
                            	  6511:     ; Unpack the damage points for the monster's type.
                            	  6512:     ; The low nibble is the high byte.
                            	  6513:     ; (Damage points byte AND $F0) is the low byte.
                            	  6514:     ;
02:000321C8 7600            	  6515:     moveq   #0,D3
02:000321CA 41EC034F        	  6516:     lea     ($034F,A4),A0
