02:00036A98 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:00036A9C 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:00036AA0 123C0000        	  5018:     move.b  #$00,D1
02:00036AA4 D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00036AA6 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
                            	  5024:     ;
02:00036AAA 0C0000F0        	  5025:     cmpi.b  #$F0,D0
02:00036AAE 7000            	  5026:     moveq   #0,D0
02:00036AB0 6508            	  5027:     bcs  _anon_z02_39
02:00036AB2 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:00036AB6 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
                            	  5031:     ; Roll the carry from the comparison above into bit 0.
                            	  5032:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5033:     ;
02:00036ABA E310            	  5034:     roxl.b  #1,D0   ; ROL A
02:00036ABC 1940005C        	  5035:     move.b  D0,($005C,A4)
                            	  5036:     ; Put the quest number in Y register.
                            	  5037:     ;
