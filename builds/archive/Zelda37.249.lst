02:0003F26A 19802070        	 12044:     move.b  D0,($70,A4,D2.W)
                            	 12045:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12046:     ; Else use radius $18. Store the chosen value in [00].
