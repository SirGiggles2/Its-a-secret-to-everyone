02:0003E020 0C030060        	  9594:     cmpi.b  #$60,D3
02:0003E024 6402            	  9595:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003E026 E308            	  9596:     lsl.b  #1,D0   ; ASL A
