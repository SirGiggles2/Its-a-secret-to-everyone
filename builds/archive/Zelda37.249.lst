02:0003D126 020000FC        	  7628:     andi.b #$FC,D0
02:0003D12A 0C0000B0        	  7629:     cmpi.b  #$B0,D0
02:0003D12E 6742            	  7630:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003D130 0C0000F4        	  7631:     cmpi.b  #$F4,D0
02:0003D134 643C            	  7632:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7633:     ; Else blocked by something else.
