02:000444A2 003C0011        	  7123:     ori     #$11,CCR  ; SEC: set C+X
02:000444A6 123C0040        	  7124:     move.b  #$40,D1
02:000444AA 0A3C0010        	  7125:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000444AE 9101            	  7126:     subx.b  D1,D0   ; SBC #$40
02:000444B0 0A3C0010        	  7127:     eori    #$10,CCR  ; restore X = 6502 C
02:000444B4 E208            	  7128:     lsr.b  #1,D0   ; LSR A
02:000444B6 E208            	  7129:     lsr.b  #1,D0   ; LSR A
02:000444B8 E208            	  7130:     lsr.b  #1,D0   ; LSR A
