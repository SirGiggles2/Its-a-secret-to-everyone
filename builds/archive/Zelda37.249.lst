                            	  6647: Aquamentus_Draw:
                            	  6648:     ; Every $10 screen frames, switch animation frames.
                            	  6649:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6650:     ; The last tile of frame 0 is at index 5.
                            	  6651:     ; The last tile of frame 1 is at index $B.
                            	  6652:     ;
02:0003CA78 7605            	  6653:     moveq   #5,D3
02:0003CA7A 102C0015        	  6654:     move.b  ($0015,A4),D0
02:0003CA7E 02000010        	  6655:     andi.b #$10,D0
