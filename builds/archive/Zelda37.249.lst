                            	  2140: DrawStatusBarItemsAndEnsureItemSelected:
                            	  2141:     ; Draws the selected item and the sword in the status bar.
                            	  2142:     ; Before drawing the item, it ensures that SelectedItemSlot
                            	  2143:     ; refers to an occupied, equippable item slot.
                            	  2144:     ;
                            	  2145:     ; This accounts for the fallback behavior between potions
                            	  2146:     ; and letters and the two boomerangs.
                            	  2147:     ;
                            	  2148:     ; Start at slot zero. Normally, it would be used to
                            	  2149:     ; check swords. When it's used as the selected item index;
                            	  2150:     ; it's a pseudo-slot used for checking boomerangs.
                            	  2151:     ;
02:0004AC1C 7400            	  2152:     moveq   #0,D2
02:0004AC1E 142C0656        	  2153:     move.b  ($0656,A4),D2
02:0004AC22 6602            	  2154:     bne.s  __far_z_07_0011
02:0004AC24 6040            	  2155:     jmp  DrawStatusBarBoomerang
