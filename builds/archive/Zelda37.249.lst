02:00032878 7040            	  7608:     moveq   #64,D0
02:0003287A 41EC00D3        	  7609:     lea     ($00D3,A4),A0
02:0003287E 11802000        	  7610:     move.b  D0,(A0,D2.W)
02:00032882 7010            	  7611:     moveq   #16,D0
02:00032884 41EC04F0        	  7612:     lea     ($04F0,A4),A0
02:00032888 11802000        	  7613:     move.b  D0,(A0,D2.W)
                            	  7614:     even
