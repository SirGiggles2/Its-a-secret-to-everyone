                            	  4907:     ;
02:000369C6 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:000369CA 41F90003690C    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000369D0 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000369D4 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
