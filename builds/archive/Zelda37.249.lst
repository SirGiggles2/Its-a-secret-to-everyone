                            	  7740: UpdatePolsVoiceState1_Jumping:
                            	  7741:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7742:     ;
02:0003D210 41EC0444        	  7743:     lea     ($0444,A4),A0
02:0003D214 10302000        	  7744:     move.b  (A0,D2.W),D0
02:0003D218 023C00EE        	  7745:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D21C 123C0038        	  7746:     move.b  #$38,D1
02:0003D220 D101            	  7747:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003D222 41EC0444        	  7748:     lea     ($0444,A4),A0
02:0003D226 11802000        	  7749:     move.b  D0,(A0,D2.W)
                            	  7750:     ; Add Carry to high speed byte (vertical).
                            	  7751:     ;
02:0003D22A 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003D22E 10302000        	  7753:     move.b  (A0,D2.W),D0
02:0003D232 123C0000        	  7754:     move.b  #$00,D1
02:0003D236 D101            	  7755:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D238 41EC0412        	  7756:     lea     ($0412,A4),A0
02:0003D23C 11802000        	  7757:     move.b  D0,(A0,D2.W)
                            	  7758:     ; Add high speed byte to Y coordinate.
                            	  7759:     ;
02:0003D240 023C00EE        	  7760:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D244 41EC0084        	  7761:     lea     ($0084,A4),A0
02:0003D248 12302000        	  7762:     move.b  (A0,D2.W),D1
02:0003D24C D101            	  7763:     addx.b  D1,D0   ; ADC ObjY,X
02:0003D24E 41EC0084        	  7764:     lea     ($0084,A4),A0
02:0003D252 11802000        	  7765:     move.b  D0,(A0,D2.W)
                            	  7766:     ; If the speed is still negative, then return.
                            	  7767:     ;
02:0003D256 41EC0412        	  7768:     lea     ($0412,A4),A0
02:0003D25A 10302000        	  7769:     move.b  (A0,D2.W),D0
02:0003D25E 6B0000AC        	  7770:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7771:     ; If Y coordinate still < target Y, then return.
                            	  7772:     ;
02:0003D262 41EC0084        	  7773:     lea     ($0084,A4),A0
02:0003D266 10302000        	  7774:     move.b  (A0,D2.W),D0
02:0003D26A 41EC042C        	  7775:     lea     ($042C,A4),A0
02:0003D26E 12302000        	  7776:     move.b  (A0,D2.W),D1
02:0003D272 B001            	  7777:     cmp.b   D1,D0
02:0003D274 65000096        	  7778:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7779:     ; Else reached the destination. Go to state 0.
                            	  7780:     ;
02:0003D278 7000            	  7781:     moveq   #0,D0
02:0003D27A 41EC00AC        	  7782:     lea     ($00AC,A4),A0
02:0003D27E 11802000        	  7783:     move.b  D0,(A0,D2.W)
                            	  7784:     ; Reset 16-bit vertical speed.
                            	  7785:     ;
02:0003D282 41EC0444        	  7786:     lea     ($0444,A4),A0
02:0003D286 11802000        	  7787:     move.b  D0,(A0,D2.W)
02:0003D28A 41EC0412        	  7788:     lea     ($0412,A4),A0
02:0003D28E 11802000        	  7789:     move.b  D0,(A0,D2.W)
                            	  7790:     ; Choose a random direction to face in.
                            	  7791:     ;
02:0003D292 10342018        	  7792:     move.b  ($18,A4,D2.W),D0
02:0003D296 02000003        	  7793:     andi.b #$03,D0
02:0003D29A 7600            	  7794:     moveq   #0,D3
02:0003D29C 1600            	  7795:     move.b  D0,D3
02:0003D29E 41F90003D0AE    	  7796:     lea     (PolsVoiceDirections).l,A0
02:0003D2A4 10303000        	  7797:     move.b  (A0,D3.W),D0
02:0003D2A8 41EC0098        	  7798:     lea     ($0098,A4),A0
02:0003D2AC 11802000        	  7799:     move.b  D0,(A0,D2.W)
                            	  7800:     ; Randomly set distance-to-move to $30 or $70.
                            	  7801:     ;
02:0003D2B0 10342018        	  7802:     move.b  ($18,A4,D2.W),D0
02:0003D2B4 02000040        	  7803:     andi.b #$40,D0
02:0003D2B8 123C0030        	  7804:     move.b  #$30,D1
02:0003D2BC D101            	  7805:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D2BE 41EC0394        	  7806:     lea     ($0394,A4),A0
02:0003D2C2 11802000        	  7807:     move.b  D0,(A0,D2.W)
                            	  7808:     ; Align the monster with a square horizontally.
                            	  7809:     ;
                            	  7810:     ; If in the left half of a square, align with that square.
                            	  7811:     ; If in the right half, align with the next square.
                            	  7812:     ;
02:0003D2C6 10342070        	  7813:     move.b  ($70,A4,D2.W),D0
02:0003D2CA 023C00EE        	  7814:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D2CE 123C0008        	  7815:     move.b  #$08,D1
02:0003D2D2 D101            	  7816:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D2D4 020000F0        	  7817:     andi.b #$F0,D0
02:0003D2D8 19802070        	  7818:     move.b  D0,($70,A4,D2.W)
                            	  7819:     ; Align the monster with a square vertically.
                            	  7820:     ;
                            	  7821:     ; If in the top half of a square, align with that square.
                            	  7822:     ; If in the bottom half, align with the next square.
                            	  7823:     ;
02:0003D2DC 41EC0084        	  7824:     lea     ($0084,A4),A0
02:0003D2E0 10302000        	  7825:     move.b  (A0,D2.W),D0
02:0003D2E4 023C00EE        	  7826:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D2E8 123C0008        	  7827:     move.b  #$08,D1
02:0003D2EC D101            	  7828:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D2EE 020000F0        	  7829:     andi.b #$F0,D0
                            	  7830:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7831:     ;
02:0003D2F2 003C0011        	  7832:     ori     #$11,CCR  ; SEC: set C+X
02:0003D2F6 123C0003        	  7833:     move.b  #$03,D1
02:0003D2FA 0A3C0010        	  7834:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D2FE 9101            	  7835:     subx.b  D1,D0   ; SBC #$03
02:0003D300 0A3C0010        	  7836:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D304 41EC0084        	  7837:     lea     ($0084,A4),A0
02:0003D308 11802000        	  7838:     move.b  D0,(A0,D2.W)
                            	  7839:     even
