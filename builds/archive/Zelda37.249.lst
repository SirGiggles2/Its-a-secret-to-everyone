                            	  7297: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7298:     ; If the "monsters from edges" long timer expired, then
                            	  7299:     ; go bring the monster in.
                            	  7300:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7301:     ;
                            	  7302:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7303:     ; residual position so enemies keep their previous-room
                            	  7304:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D122 102C004B        	  7305:     move.b  ($004B,A4),D0
02:0004D126 662E            	  7306:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7307:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004D128 102C000F        	  7308:     move.b  ($000F,A4),D0
02:0004D12C 0C0000FF        	  7309:     cmpi.b  #$FF,D0
02:0004D130 662E            	  7310:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D132 41EC0070        	  7311:     lea     ($0070,A4),A0
02:0004D136 10302000        	  7312:     move.b  (A0,D2.W),D0
02:0004D13A 660A            	  7313:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004D13C 41EC0084        	  7314:     lea     ($0084,A4),A0
02:0004D140 10302000        	  7315:     move.b  (A0,D2.W),D0
02:0004D144 671A            	  7316:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7317:     even
