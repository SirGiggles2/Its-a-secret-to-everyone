02:0003E0DE 61001C62        	  9684:     jsr     ReverseObjDir8
02:0003E0E2 41EC045E        	  9685:     lea     ($045E,A4),A0
02:0003E0E6 10302000        	  9686:     move.b  (A0,D2.W),D0
02:0003E0EA 41EC045E        	  9687:     lea     ($045E,A4),A0
02:0003E0EE 52302000        	  9688:     addq.b  #1,(A0,D2.W)
                            	  9689:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9690:     ; should randomly change direction.
