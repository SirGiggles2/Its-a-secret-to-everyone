                            	  1761:     ; Move.
                            	  1762:     ;
02:0003A79E 4EB90004B9AE    	  1763:     jsr     MoveObject
                            	  1764:     ; Mask the grid offset with $F (to a square length),
                            	  1765:     ; and return C=0.
                            	  1766:     ;
02:0003A7A4 41EC0394        	  1767:     lea     ($0394,A4),A0
02:0003A7A8 10302000        	  1768:     move.b  (A0,D2.W),D0
02:0003A7AC 0200000F        	  1769:     andi.b #$0F,D0
02:0003A7B0 023C00EE        	  1770:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7B4 6608            	  1771:     bne  _L_z04_Gel_MoveSplitting_Exit
02:0003A7B6 41EC0394        	  1772:     lea     ($0394,A4),A0
02:0003A7BA 11802000        	  1773:     move.b  D0,(A0,D2.W)
                            	  1774:     even
