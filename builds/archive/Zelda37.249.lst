02:0003DF34 19410002        	  9486:     move.b  D1,($0002,A4)
02:0003DF38 122C0002        	  9487:     move.b  ($0002,A4),D1
02:0003DF3C C200            	  9488:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF3E 6716            	  9489:     beq  _L_z04_Manhandla_Move_Up
02:0003DF40 41EC0084        	  9490:     lea     ($0084,A4),A0
02:0003DF44 10302000        	  9491:     move.b  (A0,D2.W),D0
02:0003DF48 122C0003        	  9492:     move.b  ($0003,A4),D1
