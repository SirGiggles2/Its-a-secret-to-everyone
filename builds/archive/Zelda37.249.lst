02:000321D2 41F900032034    	  6518:     lea     (ObjTypeToDamagePoints).l,A0
02:000321D8 10303000        	  6519:     move.b  (A0,D3.W),D0
02:000321DC 1B00            	  6520:     move.b  D0,-(A5)  ; PHA
02:000321DE 0200000F        	  6521:     andi.b #$0F,D0
02:000321E2 1940000D        	  6522:     move.b  D0,($000D,A4)
02:000321E6 101D            	  6523:     move.b  (A5)+,D0  ; PLA
02:000321E8 020000F0        	  6524:     andi.b #$F0,D0
02:000321EC 1940000E        	  6525:     move.b  D0,($000E,A4)
                            	  6526: ; Params:
                            	  6527: ; X: object index of the attacker
                            	  6528: ; [0D]: damage points high byte
                            	  6529: ; [0E]: damage points low byte
                            	  6530: ;
                            	  6531: ;
                            	  6532: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6533: ;
                            	  6534:     even
