02:0003F4D2 10302000        	 12415:     move.b  (A0,D2.W),D0
02:0003F4D6 660C            	 12416:     bne  _anon_z04_162
02:0003F4D8 103C00FF        	 12417:     move.b  #$FF,D0
02:0003F4DC 41EC042C        	 12418:     lea     ($042C,A4),A0
02:0003F4E0 11802000        	 12419:     move.b  D0,(A0,D2.W)
                            	 12420: _anon_z04_162:
