                            	  2092: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2093:     ; We got here in one of three ways:
                            	  2094:     ;
                            	  2095:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2096:     ;    explicitly.
                            	  2097:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2098:     ;    held an offset that was added to base palette attribute
                            	  2099:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2100:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2101:     ;    held absolute attributes.
                            	  2102:     ;
                            	  2103:     ; At this point, A holds the final sprite attributes.
02:0004ABEC 7400            	  2104:     moveq   #0,D2
02:0004ABEE 1942000C        	  2105:     move.b  D2,($000C,A4)
02:0004ABF2 740F            	  2106:     moveq   #15,D2
                            	  2107:     ; Write sprites.
                            	  2108:     ; A holds the calculated sprite attributes.
                            	  2109:     ; Y holds the item slot.
02:0004ABF4 4EF900031DD0    	  2110:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2111: 
                            	  2112:     even
                            	  2113: _L_z07_DrawItemBySlot_AddItemAndTableValue:
                            	  2114:     ; Calculate sprite attributes by adding item value / sprite palette
                            	  2115:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2116:     ; which here represents an offset from the palette row.
                            	  2117:     ;
02:0004ABFA 023C00EE        	  2118:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004ABFE 122C0004        	  2119:     move.b  ($0004,A4),D1
02:0004AC02 D101            	  2120:     addx.b  D1,D0   ; ADC $04
02:0004AC04 4A02            	  2121:     cmpi.b  #$00,D2
02:0004AC06 66E4            	  2122:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AC08 0C000002        	  2123:     cmpi.b  #$02,D0
02:0004AC0C 66DE            	  2124:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AC0E 7620            	  2125:     moveq   #32,D3
