                            	  6045: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  6046:     ; Digdogger is big, but room boundary checks and
                            	  6047:     ; object collision checks assume a 16x16 monster or smaller.
                            	  6048:     ; Therefore, we have to check these things four times,
                            	  6049:     ; in different corners of the boss.
                            	  6050:     ;
                            	  6051:     ; Loop 4 times, from 0 to 3.
                            	  6052:     ;
02:0003C59C 7600            	  6053:     moveq   #0,D3
02:0003C59E 41EC0478        	  6054:     lea     ($0478,A4),A0
02:0003C5A2 16302000        	  6055:     move.b  (A0,D2.W),D3
                            	  6056:     ; Change the coordinates to one corner.
                            	  6057:     ;
02:0003C5A6 10342070        	  6058:     move.b  ($70,A4,D2.W),D0
02:0003C5AA 023C00EE        	  6059:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C5AE 41F90003C462    	  6060:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C5B4 12303000        	  6061:     move.b  (A0,D3.W),D1
02:0003C5B8 D101            	  6062:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C5BA 19802070        	  6063:     move.b  D0,($70,A4,D2.W)
02:0003C5BE 41EC0084        	  6064:     lea     ($0084,A4),A0
02:0003C5C2 10302000        	  6065:     move.b  (A0,D2.W),D0
02:0003C5C6 023C00EE        	  6066:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C5CA 41F90003C466    	  6067:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C5D0 12303000        	  6068:     move.b  (A0,D3.W),D1
02:0003C5D4 D101            	  6069:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C5D6 41EC0084        	  6070:     lea     ($0084,A4),A0
02:0003C5DA 11802000        	  6071:     move.b  D0,(A0,D2.W)
                            	  6072:     ; Check the room boundary and object collisions in this temporary location.
                            	  6073:     ;
02:0003C5DE 61003734        	  6074:     jsr     BoundFlyer
02:0003C5E2 4EB900031F48    	  6075:     jsr     CheckMonsterCollisions
                            	  6076:     ; Increase the loop index, and loop again until it = 4.
                            	  6077:     ;
02:0003C5E8 41EC0478        	  6078:     lea     ($0478,A4),A0
02:0003C5EC 52302000        	  6079:     addq.b  #1,(A0,D2.W)
02:0003C5F0 41EC0478        	  6080:     lea     ($0478,A4),A0
02:0003C5F4 10302000        	  6081:     move.b  (A0,D2.W),D0
02:0003C5F8 0C000004        	  6082:     cmpi.b  #$04,D0
02:0003C5FC 659E            	  6083:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6084:     ; Restore the original coordinates.
                            	  6085:     ;
