02:00039F48 66000082        	   628:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   629:     ; Store in [00] the type of projectile the monster will throw.
                            	   630:     ;
02:00039F4C 1880            	   631:     move.b  D0,($0000,A4)
                            	   632:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   633:     ;
02:00039F4E 102C066C        	   634:     move.b  ($066C,A4),D0
02:00039F52 1234203D        	   635:     move.b  ($3D,A4,D2.W),D1
02:00039F56 8001            	   636:     or.b  D1,D0
02:00039F58 6672            	   637:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   638:     ; Try to shoot. Return, if it failed.
                            	   639:     ;
