                            	 12160: PatraChild_Draw:
02:0003F356 4EB900031EBC    	 12161:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
                            	 12162:     ; 2 was returned from the routine above in A.
                            	 12163:     ; Pass it as the animation counter value to the routine below.
                            	 12164:     ;
02:0003F35C 4EB90004CD1E    	 12165:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
