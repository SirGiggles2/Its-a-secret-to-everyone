02:0003A5E0 41EC0084        	  1509:     lea     ($0084,A4),A0
02:0003A5E4 10302000        	  1510:     move.b  (A0,D2.W),D0
02:0003A5E8 0200000F        	  1511:     andi.b #$0F,D0
02:0003A5EC 0C00000D        	  1512:     cmpi.b  #$0D,D0
02:0003A5F0 6602            	  1513:     bne  _anon_z04_26
02:0003A5F2 7603            	  1514:     moveq   #3,D3
                            	  1515: _anon_z04_26:
02:0003A5F4 1883            	  1516:     move.b  D3,($0000,A4)
                            	  1517:     ; If horizontally aligned with the square grid, then
                            	  1518:     ; use a vertical direction mask ($C).
                            	  1519:     ;
02:0003A5F6 7600            	  1520:     moveq   #0,D3
02:0003A5F8 10342070        	  1521:     move.b  ($70,A4,D2.W),D0
02:0003A5FC 0200000F        	  1522:     andi.b #$0F,D0
02:0003A600 6602            	  1523:     bne  _anon_z04_27
02:0003A602 760C            	  1524:     moveq   #12,D3
                            	  1525: _anon_z04_27:
02:0003A604 1003            	  1526:     move.b  D3,D0
                            	  1527:     ; Combine the two masks. At most one will be 0.
                            	  1528:     ;
02:0003A606 1214            	  1529:     move.b  ($0000,A4),D1
02:0003A608 8001            	  1530:     or.b  D1,D0
                            	  1531:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1532:     ; with the grid.
                            	  1533:     ;
                            	  1534:     ; If so, then go to state 1 to do a "big shove".
                            	  1535:     ; Else go to state 2, to immediately split in two.
                            	  1536:     ;
                            	  1537:     ; Examples:
                            	  1538:     ; It would be aligned, if moving left along a tile as usual.
                            	  1539:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1540:     ; - The collision check routines would have made the zol
                            	  1541:     ;   face in the direction of the weapon.
                            	  1542:     ; - See CheckMonsterWeaponCollision.
                            	  1543:     ;
02:0003A60A 122C0098        	  1544:     move.b  ($0098,A4),D1
02:0003A60E C001            	  1545:     and.b  D1,D0
02:0003A610 6608            	  1546:     bne  _anon_z04_28
02:0003A612 41EC00AC        	  1547:     lea     ($00AC,A4),A0
02:0003A616 52302000        	  1548:     addq.b  #1,(A0,D2.W)
