                            	  8122: ; Description:
                            	  8123: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8124: ; When walking, the object timer is set. When teleporting,
                            	  8125: ; the teleporting distance remaining is set.
                            	  8126: ;
                            	  8127: ; If we have the magic clock, then only go draw and check collisions.
                            	  8128: ;
                            	  8129:     even
                            	  8130: UpdateBlueWizzrobe:
02:0003D55C 102C066C        	  8131:     move.b  ($066C,A4),D0
02:0003D560 6702            	  8132:     beq.s  __far_z_04_0070
02:0003D562 6014            	  8133:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8134: __far_z_04_0070:
02:0003D564 6116            	  8135:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D566 61000318        	  8136:     jsr     BlueWizzrobe_TryShooting
                            	  8137:     even
                            	  8138: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8139:     ; If the teleporting distance remaining is even, then draw
                            	  8140:     ; and check collisions, else return.
                            	  8141:     ;
                            	  8142:     ; This means that when 0, the monster is walking.
                            	  8143:     ; So, draw and check collisions every frame.
                            	  8144:     ;
                            	  8145:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8146:     ; translucently -- every other frame.
                            	  8147:     ;
02:0003D56A 41EC0394        	  8148:     lea     ($0394,A4),A0
02:0003D56E 10302000        	  8149:     move.b  (A0,D2.W),D0
02:0003D572 E208            	  8150:     lsr.b  #1,D0   ; LSR A
02:0003D574 6402            	  8151:     bcc.s  __far_z_04_0071
02:0003D576 603A            	  8152:     jmp  L11E17_Exit
                            	  8153: __far_z_04_0071:
                            	  8154:     even
                            	  8155: L_Wizzrobe_DrawAndCheckCollisions:
02:0003D578 600004DE        	  8156:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8157: 
                            	  8158:     even
                            	  8159: BlueWizzrobe_WalkOrTeleport:
