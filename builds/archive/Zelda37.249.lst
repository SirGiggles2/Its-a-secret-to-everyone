                            	  5700:     ; Chase while flying, as usual.
                            	  5701:     ;
02:0003C3B8 610039CC        	  5702:     jsr     Flyer_Chase
                            	  5703:     ; If timer has not expired, then
                            	  5704:     ; go see if it's time to propagate direction changes down the chain.
                            	  5705:     ;
02:0003C3BC 10342028        	  5706:     move.b  ($28,A4,D2.W),D0
