                            	 12268:     ;
02:0003F3F6 194000AC        	 12269:     move.b  D0,($00AC,A4)
02:0003F3FA 19400505        	 12270:     move.b  D0,($0505,A4)
02:0003F3FE 7020            	 12271:     moveq   #32,D0
02:0003F400 19400600        	 12272:     move.b  D0,($0600,A4)
02:0003F404 522C0445        	 12273:     addq.b  #1,($0445,A4)
                            	 12274:     even
