02:0003D348 7600            	  7874:     moveq   #0,D3
02:0003D34A 41EC03E4        	  7875:     lea     ($03E4,A4),A0
02:0003D34E 16302000        	  7876:     move.b  (A0,D2.W),D3
02:0003D352 5203            	  7877:     addq.b  #1,D3
