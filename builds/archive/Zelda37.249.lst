                            	  2200: ; Params:
                            	  2201: ; A: Y coordinate
                            	  2202: ; X: object index
                            	  2203: ;
                            	  2204:     even
                            	  2205: InitWhirlwind:
02:000302EC 6000B95C        	  2206:     jmp     c_init_whirlwind
                            	  2207: 
                            	  2208: SetUpWhirlwind:
02:000302F0 6000B708        	  2209:     jmp     c_set_up_whirlwind
                            	  2210: 
                            	  2211: WhirlwindPrevRoomIdList:
02:000302F4 36              	  2212:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:000302F5 3B
02:000302F6 73
02:000302F7 44
02:000302F8 0A
02:000302F9 21
02:000302FA 41
02:000302FB 6C
                            	  2213: 
                            	  2214:     even
                            	  2215: UpdateWhirlwind_Full:
                            	  2216:     ; Get Link's halted state.
                            	  2217:     ;
02:000302FC 102C00AC        	  2218:     move.b  ($00AC,A4),D0
02:00030300 02000040        	  2219:     andi.b #$40,D0
02:00030304 7600            	  2220:     moveq   #0,D3
02:00030306 1600            	  2221:     move.b  D0,D3
                            	  2222:     ; Add 2 to whirlwind X.
                            	  2223:     ;
02:00030308 7002            	  2224:     moveq   #2,D0
02:0003030A 023C00EE        	  2225:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003030E 12342070        	  2226:     move.b  ($70,A4,D2.W),D1
02:00030312 D101            	  2227:     addx.b  D1,D0   ; ADC ObjX,X
02:00030314 19802070        	  2228:     move.b  D0,($70,A4,D2.W)
                            	  2229:     ; If Link is not halted or teleporting state = 0, then
                            	  2230:     ; go check for collision with Link.
                            	  2231:     ;
02:00030318 0C030040        	  2232:     cmpi.b  #$40,D3
02:0003031C 6638            	  2233:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0003031E 7600            	  2234:     moveq   #0,D3
02:00030320 162C0522        	  2235:     move.b  ($0522,A4),D3
02:00030324 6730            	  2236:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2237:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2238:     ;
                            	  2239:     ; Set Link's X to whirlwind's.
                            	  2240:     ;
02:00030326 19400070        	  2241:     move.b  D0,($0070,A4)
                            	  2242:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2243:     ; the right screen edge and draw.
                            	  2244:     ;
02:0003032A 5303            	  2245:     subq.b  #1,D3
02:0003032C 6776            	  2246:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0003032E 0C000080        	  2247:     cmpi.b  #$80,D0
02:00030332 6670            	  2248:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2249:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2250:     ;
                            	  2251:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2252:     ;
02:00030334 E308            	  2253:     lsl.b  #1,D0   ; ASL A
02:00030336 194000AC        	  2254:     move.b  D0,($00AC,A4)
02:0003033A 19400522        	  2255:     move.b  D0,($0522,A4)
02:0003033E 41EC034F        	  2256:     lea     ($034F,A4),A0
02:00030342 11802000        	  2257:     move.b  D0,(A0,D2.W)
                            	  2258:     ; Update the player position marker, and draw one last time.
                            	  2259:     ;
02:00030346 1002            	  2260:     move.b  D2,D0
02:00030348 1B00            	  2261:     move.b  D0,-(A5)  ; PHA
02:0003034A 6100106A        	  2262:     jsr     UpdatePlayerPositionMarker
02:0003034E 101D            	  2263:     move.b  (A5)+,D0  ; PLA
02:00030350 7400            	  2264:     moveq   #0,D2
02:00030352 1400            	  2265:     move.b  D0,D2
02:00030354 6070            	  2266:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2267: 
                            	  2268:     even
                            	  2269: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2270:     ; Link is not halted or teleporting state = 0.
                            	  2271:     ; Try to pick up Link.
                            	  2272:     ;
                            	  2273:     ; If the whirlwind does not collide with Link, then go check
                            	  2274:     ; for the screen's right edge.
                            	  2275:     ;
02:00030356 61001D3A        	  2276:     jsr     CheckLinkCollision
02:0003035A 102C0006        	  2277:     move.b  ($0006,A4),D0
02:0003035E 6744            	  2278:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2279:     ; Collided with Link.
                            	  2280:     ;
                            	  2281:     ; Make Link face right. Reset shove info and subroom type.
                            	  2282:     ;
02:00030360 7001            	  2283:     moveq   #1,D0
02:00030362 19400098        	  2284:     move.b  D0,($0098,A4)
02:00030366 E208            	  2285:     lsr.b  #1,D0   ; LSR A
02:00030368 194000C0        	  2286:     move.b  D0,($00C0,A4)
02:0003036C 194000D3        	  2287:     move.b  D0,($00D3,A4)
02:00030370 1940005A        	  2288:     move.b  D0,($005A,A4)
                            	  2289:     ; Halt Link (state $40), and hide him.
                            	  2290:     ;
02:00030374 7040            	  2291:     moveq   #64,D0
02:00030376 194000AC        	  2292:     move.b  D0,($00AC,A4)
02:0003037A 103C00F8        	  2293:     move.b  #$F8,D0
02:0003037E 19400248        	  2294:     move.b  D0,($0248,A4)
02:00030382 1940024C        	  2295:     move.b  D0,($024C,A4)
                            	  2296:     ; Find and set the room that will behave as the previous room
                            	  2297:     ; when scrolling right to the room with the level's entrance.
                            	  2298:     ;
02:00030386 102C0523        	  2299:     move.b  ($0523,A4),D0
02:0003038A 02000007        	  2300:     andi.b #$07,D0
02:0003038E 7600            	  2301:     moveq   #0,D3
02:00030390 1600            	  2302:     move.b  D0,D3
02:00030392 41F9000302F4    	  2303:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030398 10303000        	  2304:     move.b  (A0,D3.W),D0
02:0003039C 194000EA        	  2305:     move.b  D0,($00EA,A4)
                            	  2306:     ; Set teleporting state 1.
                            	  2307:     ;
02:000303A0 522C0522        	  2308:     addq.b  #1,($0522,A4)
                            	  2309:     even
                            	  2310: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2311:     ; If whirlwind's X < $F0, go draw.
                            	  2312:     ;
02:000303A4 10342070        	  2313:     move.b  ($70,A4,D2.W),D0
02:000303A8 0C0000F0        	  2314:     cmpi.b  #$F0,D0
02:000303AC 6518            	  2315:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2316:     ; The whirlwind has reached the right edge of the screen.
                            	  2317:     ;
                            	  2318:     ; Destroy the object.
                            	  2319:     ;
