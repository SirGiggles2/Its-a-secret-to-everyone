02:0003082C 11802000        	  2968:     move.b  D0,(A0,D2.W)
                            	  2969:     ; Set facing direction to the horizontal one that we determined.
                            	  2970:     ;
02:00030830 1003            	  2971:     move.b  D3,D0
02:00030832 41EC0098        	  2972:     lea     ($0098,A4),A0
02:00030836 11802000        	  2973:     move.b  D0,(A0,D2.W)
                            	  2974:     ; If the direction we determined is not allowed for this trap, then
                            	  2975:     ; go draw and check collisions.
                            	  2976:     ;
02:0003083A 41F9000307DB    	  2977:     lea     (TrapAllowedDirs-1).l,A0
02:00030840 12302000        	  2978:     move.b  (A0,D2.W),D1
02:00030844 C001            	  2979:     and.b  D1,D0
02:00030846 6712            	  2980:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  2981:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  2982:     ;
02:00030848 41EC00AC        	  2983:     lea     ($00AC,A4),A0
02:0003084C 52302000        	  2984:     addq.b  #1,(A0,D2.W)
02:00030850 7070            	  2985:     moveq   #112,D0
02:00030852 41EC03BC        	  2986:     lea     ($03BC,A4),A0
02:00030856 11802000        	  2987:     move.b  D0,(A0,D2.W)
                            	  2988:     even
                            	  2989: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:0003085A 60000102        	  2990:     jmp     L_Trap_DrawAndCheckCollisions
                            	  2991: 
                            	  2992:     even
                            	  2993: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  2994:     ; If the horizontal distance between Link and the trap >= $E,
                            	  2995:     ; then this trap definitely wasn't triggered.
                            	  2996:     ; Go draw and check collisions.
                            	  2997:     ;
02:0003085E 102C0070        	  2998:     move.b  ($0070,A4),D0
02:00030862 003C0011        	  2999:     ori     #$11,CCR  ; SEC: set C+X
02:00030866 12342070        	  3000:     move.b  ($70,A4,D2.W),D1
02:0003086A 0A3C0010        	  3001:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003086E 9101            	  3002:     subx.b  D1,D0   ; SBC ObjX,X
02:00030870 0A3C0010        	  3003:     eori    #$10,CCR  ; restore X = 6502 C
02:00030874 61000802        	  3004:     jsr     Abs
02:00030878 0C00000E        	  3005:     cmpi.b  #$0E,D0
02:0003087C 64DC            	  3006:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3007:     ; Determine the vertical direction toward Link;
                            	  3008:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3009:     ; along this axis. Go draw and check object collisions.
                            	  3010:     ;
02:0003087E 7604            	  3011:     moveq   #4,D3
02:00030880 102C0084        	  3012:     move.b  ($0084,A4),D0
02:00030884 41EC0084        	  3013:     lea     ($0084,A4),A0
02:00030888 12302000        	  3014:     move.b  (A0,D2.W),D1
02:0003088C B001            	  3015:     cmp.b   D1,D0
02:0003088E 67CA            	  3016:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:00030890 6402            	  3017:     bcc  _anon_z01_27
02:00030892 7608            	  3018:     moveq   #8,D3
                            	  3019: _anon_z01_27:
                            	  3020:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  3021:     ; set the vertical direction we determined, and other preparations.
                            	  3022:     ;
02:00030894 41EC0084        	  3023:     lea     ($0084,A4),A0
02:00030898 10302000        	  3024:     move.b  (A0,D2.W),D0
02:0003089C 668A            	  3025:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  3026:     even
                            	  3027: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  3028:     ; State 1 and 2.
                            	  3029:     ;
                            	  3030:     ; Move in the direction it's facing.
                            	  3031:     ;
02:0003089E 41EC0098        	  3032:     lea     ($0098,A4),A0
02:000308A2 10302000        	  3033:     move.b  (A0,D2.W),D0
02:000308A6 1940000F        	  3034:     move.b  D0,($000F,A4)
02:000308AA 4EB90004B9AE    	  3035:     jsr     MoveObject
                            	  3036:     ; Truncate the grid offset to square length ($10).
                            	  3037:     ;
02:000308B0 41EC0394        	  3038:     lea     ($0394,A4),A0
02:000308B4 10302000        	  3039:     move.b  (A0,D2.W),D0
02:000308B8 0200000F        	  3040:     andi.b #$0F,D0
02:000308BC 6608            	  3041:     bne  _anon_z01_28
02:000308BE 41EC0394        	  3042:     lea     ($0394,A4),A0
02:000308C2 11802000        	  3043:     move.b  D0,(A0,D2.W)
                            	  3044: _anon_z01_28:
                            	  3045:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3046:     ;
02:000308C6 610017CA        	  3047:     jsr     CheckLinkCollision
                            	  3048:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3049:     ; and current coordinate to the trap's X.
                            	  3050:     ;
02:000308CA 7600            	  3051:     moveq   #0,D3
02:000308CC 16342070        	  3052:     move.b  ($70,A4,D2.W),D3
02:000308D0 7078            	  3053:     moveq   #120,D0
02:000308D2 1880            	  3054:     move.b  D0,($0000,A4)
02:000308D4 41EC0098        	  3055:     lea     ($0098,A4),A0
02:000308D8 10302000        	  3056:     move.b  (A0,D2.W),D0
02:000308DC 0200000C        	  3057:     andi.b #$0C,D0
02:000308E0 6710            	  3058:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3059:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3060:     ; and current coordinate to the trap's Y.
                            	  3061:     ;
02:000308E2 7600            	  3062:     moveq   #0,D3
02:000308E4 41EC0084        	  3063:     lea     ($0084,A4),A0
02:000308E8 16302000        	  3064:     move.b  (A0,D2.W),D3
02:000308EC 103C0090        	  3065:     move.b  #$90,D0
02:000308F0 1880            	  3066:     move.b  D0,($0000,A4)
                            	  3067:     even
                            	  3068: _L_z01_UpdateTrap_Full_Finish:
                            	  3069:     ; If in state 2, then go finish handling it.
                            	  3070:     ;
02:000308F2 41EC00AC        	  3071:     lea     ($00AC,A4),A0
02:000308F6 10302000        	  3072:     move.b  (A0,D2.W),D0
02:000308FA 02000001        	  3073:     andi.b #$01,D0
02:000308FE 6744            	  3074:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  3075:     ; Finish handling state 1.
                            	  3076:     ;
                            	  3077:     ; Get the distance between the current coordinate and the target.
                            	  3078:     ;
02:00030900 1003            	  3079:     move.b  D3,D0
02:00030902 003C0011        	  3080:     ori     #$11,CCR  ; SEC: set C+X
02:00030906 1214            	  3081:     move.b  ($0000,A4),D1
02:00030908 0A3C0010        	  3082:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003090C 9101            	  3083:     subx.b  D1,D0   ; SBC $00
02:0003090E 0A3C0010        	  3084:     eori    #$10,CCR  ; restore X = 6502 C
02:00030912 61000764        	  3085:     jsr     Abs
                            	  3086:     ; If distance >= 5, go draw.
                            	  3087:     ;
02:00030916 0C000005        	  3088:     cmpi.b  #$05,D0
02:0003091A 6426            	  3089:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  3090:     ; Else reverse direction, and advace to state 2
                            	  3091:     ; with q-speed $20 (0.5 pixels a frame) (slow).
                            	  3092:     ;
02:0003091C 41EC0098        	  3093:     lea     ($0098,A4),A0
02:00030920 10302000        	  3094:     move.b  (A0,D2.W),D0
02:00030924 6100074E        	  3095:     jsr     GetOppositeDir
02:00030928 41EC0098        	  3096:     lea     ($0098,A4),A0
02:0003092C 11802000        	  3097:     move.b  D0,(A0,D2.W)
02:00030930 7020            	  3098:     moveq   #32,D0
02:00030932 41EC03BC        	  3099:     lea     ($03BC,A4),A0
02:00030936 11802000        	  3100:     move.b  D0,(A0,D2.W)
02:0003093A 41EC00AC        	  3101:     lea     ($00AC,A4),A0
02:0003093E 52302000        	  3102:     addq.b  #1,(A0,D2.W)
                            	  3103:     even
