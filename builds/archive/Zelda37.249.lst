02:0003EE96 7604            	 11488:     moveq   #4,D3
                            	 11489:     even
                            	 11490: _L_z04_UpdateLamnola_FindTail:
02:0003EE98 5203            	 11491:     addq.b  #1,D3
02:0003EE9A 41EC0350        	 11492:     lea     ($0350,A4),A0
02:0003EE9E 10303000        	 11493:     move.b  (A0,D3.W),D0
02:0003EEA2 122C04E7        	 11494:     move.b  ($04E7,A4),D1
02:0003EEA6 B001            	 11495:     cmp.b   D1,D0
02:0003EEA8 66EE            	 11496:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11497:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11498:     ;
02:0003EEAA 7011            	 11499:     moveq   #17,D0
02:0003EEAC 19803029        	 11500:     move.b  D0,($29,A4,D3.W)
                            	 11501:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11502:     ; to the tail segment.
                            	 11503:     ;
02:0003EEB0 41EC04F0        	 11504:     lea     ($04F0,A4),A0
02:0003EEB4 10302000        	 11505:     move.b  (A0,D2.W),D0
02:0003EEB8 41EC04F1        	 11506:     lea     ($04F1,A4),A0
02:0003EEBC 11803000        	 11507:     move.b  D0,(A0,D3.W)
02:0003EEC0 10342070        	 11508:     move.b  ($70,A4,D2.W),D0
02:0003EEC4 19803071        	 11509:     move.b  D0,($71,A4,D3.W)
02:0003EEC8 41EC0084        	 11510:     lea     ($0084,A4),A0
02:0003EECC 10302000        	 11511:     move.b  (A0,D2.W),D0
02:0003EED0 41EC0085        	 11512:     lea     ($0085,A4),A0
02:0003EED4 11803000        	 11513:     move.b  D0,(A0,D3.W)
                            	 11514:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11515:     ; So, return and leave it dead.
                            	 11516:     ;
02:0003EED8 0C030004        	 11517:     cmpi.b  #$04,D3
02:0003EEDC 6604            	 11518:     bne.s  __far_z_04_0110
02:0003EEDE 6000FF0C        	 11519:     jmp  L129EA_Exit
                            	 11520: __far_z_04_0110:
02:0003EEE2 0C030009        	 11521:     cmpi.b  #$09,D3
02:0003EEE6 6604            	 11522:     bne.s  __far_z_04_0111
02:0003EEE8 6000FF02        	 11523:     jmp  L129EA_Exit
                            	 11524: __far_z_04_0111:
                            	 11525:     ; Change the tail segment to the dead dummy object, and
                            	 11526:     ; bring the current segment back to life.
                            	 11527:     ;
02:0003EEEC 705D            	 11528:     moveq   #93,D0
02:0003EEEE 41EC0350        	 11529:     lea     ($0350,A4),A0
02:0003EEF2 11803000        	 11530:     move.b  D0,(A0,D3.W)
02:0003EEF6 4EF90004D524    	 11531:     jmp     ResetObjMetastate
                            	 11532: 
                            	 11533:     even
                            	 11534: L12A6F_Exit:
02:0003EEFC 4E75            	 11535:     rts
                            	 11536: 
                            	 11537:     even
                            	 11538: Lamnola_UpdateHead:
                            	 11539:     ; If X coordinate is not a multiple of 8, then return.
                            	 11540:     ;
02:0003EEFE 10342070        	 11541:     move.b  ($70,A4,D2.W),D0
02:0003EF02 02000007        	 11542:     andi.b #$07,D0
02:0003EF06 6702            	 11543:     beq.s  __far_z_04_0112
02:0003EF08 60F2            	 11544:     jmp  L12A6F_Exit
                            	 11545: __far_z_04_0112:
                            	 11546:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11547:     ; We had to account for the usual offset of 3.
                            	 11548:     ;
02:0003EF0A 41EC0084        	 11549:     lea     ($0084,A4),A0
02:0003EF0E 10302000        	 11550:     move.b  (A0,D2.W),D0
02:0003EF12 023C00EE        	 11551:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF16 123C0003        	 11552:     move.b  #$03,D1
02:0003EF1A D101            	 11553:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EF1C 02000007        	 11554:     andi.b #$07,D0
02:0003EF20 6702            	 11555:     beq.s  __far_z_04_0113
02:0003EF22 60D8            	 11556:     jmp  L12A6F_Exit
                            	 11557: __far_z_04_0113:
                            	 11558:     ; Will loop 4 times, propagating directions down the chain,
                            	 11559:     ; by pulling from the bottom.
                            	 11560:     ;
02:0003EF24 7004            	 11561:     moveq   #4,D0
02:0003EF26 1880            	 11562:     move.b  D0,($0000,A4)
                            	 11563:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11564:     ;
02:0003EF28 7600            	 11565:     moveq   #0,D3
02:0003EF2A 0C020005        	 11566:     cmpi.b  #$05,D2
02:0003EF2E 6702            	 11567:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EF30 7605            	 11568:     moveq   #5,D3
                            	 11569:     even
                            	 11570: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11571:     ; Loop over every segment under the head, starting from the tail.
                            	 11572:     ; Copy the next segment's direction to the current one in this loop.
                            	 11573:     ;
02:0003EF32 41EC009A        	 11574:     lea     ($009A,A4),A0
02:0003EF36 10303000        	 11575:     move.b  (A0,D3.W),D0
02:0003EF3A 41EC0099        	 11576:     lea     ($0099,A4),A0
02:0003EF3E 11803000        	 11577:     move.b  D0,(A0,D3.W)
02:0003EF42 5203            	 11578:     addq.b  #1,D3
02:0003EF44 5314            	 11579:     subq.b  #1,($0000,A4)
02:0003EF46 66EA            	 11580:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11581:     ; If this head segment is not aligned with a square, then return.
                            	 11582:     ;
02:0003EF48 10342070        	 11583:     move.b  ($70,A4,D2.W),D0
02:0003EF4C 0200000F        	 11584:     andi.b #$0F,D0
02:0003EF50 660000BA        	 11585:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11586:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11587:     ; We had to account for the usual offset of 3.
                            	 11588:     ;
02:0003EF54 41EC0084        	 11589:     lea     ($0084,A4),A0
02:0003EF58 10302000        	 11590:     move.b  (A0,D2.W),D0
02:0003EF5C 023C00EE        	 11591:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF60 123C0003        	 11592:     move.b  #$03,D1
02:0003EF64 D101            	 11593:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EF66 0200000F        	 11594:     andi.b #$0F,D0
02:0003EF6A 660000A0        	 11595:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11596:     ; Store the opposite of the facing direction in [00].
                            	 11597:     ;
02:0003EF6E 41EC0098        	 11598:     lea     ($0098,A4),A0
02:0003EF72 10302000        	 11599:     move.b  (A0,D2.W),D0
02:0003EF76 E208            	 11600:     lsr.b  #1,D0   ; LSR A
02:0003EF78 02000005        	 11601:     andi.b #$05,D0
02:0003EF7C 1880            	 11602:     move.b  D0,($0000,A4)
02:0003EF7E 41EC0098        	 11603:     lea     ($0098,A4),A0
02:0003EF82 10302000        	 11604:     move.b  (A0,D2.W),D0
02:0003EF86 E308            	 11605:     lsl.b  #1,D0   ; ASL A
02:0003EF88 0200000A        	 11606:     andi.b #$0A,D0
02:0003EF8C 1214            	 11607:     move.b  ($0000,A4),D1
02:0003EF8E 8001            	 11608:     or.b  D1,D0
                            	 11609:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11610:     ;
02:0003EF90 0A00000F        	 11611:     eori.b #$0F,D0
02:0003EF94 1940050F        	 11612:     move.b  D0,($050F,A4)
                            	 11613:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11614:     ;
02:0003EF98 10342018        	 11615:     move.b  ($18,A4,D2.W),D0
02:0003EF9C 0C000080        	 11616:     cmpi.b  #$80,D0
02:0003EFA0 656C            	 11617:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11618:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11619:     ; Load the monster's facing direction.
                            	 11620:     ;
02:0003EFA2 41EC0098        	 11621:     lea     ($0098,A4),A0
02:0003EFA6 10302000        	 11622:     move.b  (A0,D2.W),D0
                            	 11623:     ; Load the next random number into Y register.
                            	 11624:     ;
02:0003EFAA 7600            	 11625:     moveq   #0,D3
02:0003EFAC 16342019        	 11626:     move.b  ($19,A4,D2.W),D3
                            	 11627:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11628:     ; to keep moving straight.
                            	 11629:     ;
02:0003EFB0 0C030080        	 11630:     cmpi.b  #$80,D3
02:0003EFB4 6418            	 11631:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11632:     even
                            	 11633: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11634:     ; Loop to rotate the direction bit over the mask.
                            	 11635:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11636:     ; facing direction.
                            	 11637:     ;
                            	 11638:     ; Shift right the copy of the direction.
                            	 11639:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11640:     ;
02:0003EFB6 E208            	 11641:     lsr.b  #1,D0   ; LSR A
02:0003EFB8 6402            	 11642:     bcc  _anon_z04_151
02:0003EFBA 7008            	 11643:     moveq   #8,D0
                            	 11644: _anon_z04_151:
                            	 11645:     ; If the current direction bit is masked off, then we've reached
                            	 11646:     ; the opposite direction. Loop again.
                            	 11647:     ;
02:0003EFBC 122C050F        	 11648:     move.b  ($050F,A4),D1
02:0003EFC0 C200            	 11649:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EFC2 67F2            	 11650:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11651:     ; If Y register >= $40, then break out of the loop.
                            	 11652:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11653:     ;
02:0003EFC4 0C030040        	 11654:     cmpi.b  #$40,D3
02:0003EFC8 6404            	 11655:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11656:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11657:     ; and loop again now.
                            	 11658:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11659:     ;
02:0003EFCA 7640            	 11660:     moveq   #64,D3
02:0003EFCC 65E8            	 11661:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11662:     even
                            	 11663: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11664:     ; Change the facing direction to the direction found.
                            	 11665:     ;
02:0003EFCE 41EC0098        	 11666:     lea     ($0098,A4),A0
02:0003EFD2 11802000        	 11667:     move.b  D0,(A0,D2.W)
                            	 11668:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11669:     ;
02:0003EFD6 1940000F        	 11670:     move.b  D0,($000F,A4)
02:0003EFDA 4EB900030F7A    	 11671:     jsr     BoundByRoom
                            	 11672:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11673:     ;
02:0003EFE0 102C000F        	 11674:     move.b  ($000F,A4),D0
02:0003EFE4 6618            	 11675:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11676:     even
                            	 11677: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11678:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11679:     ; for looking for any non-opposite direction that is not blocked.
                            	 11680:     ;
02:0003EFE6 41EC0098        	 11681:     lea     ($0098,A4),A0
02:0003EFEA 10302000        	 11682:     move.b  (A0,D2.W),D0
                            	 11683:     even
                            	 11684: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11685:     ; Shift right the copy of the direction.
                            	 11686:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11687:     ;
02:0003EFEE E208            	 11688:     lsr.b  #1,D0   ; LSR A
02:0003EFF0 6402            	 11689:     bcc  _anon_z04_152
02:0003EFF2 7008            	 11690:     moveq   #8,D0
                            	 11691: _anon_z04_152:
                            	 11692:     ; If the current direction bit is not masked off, then go check the
                            	 11693:     ; room boundary in this direction.
                            	 11694:     ; Else we've reached the opposite direction. Loop again.
                            	 11695:     ;
02:0003EFF4 122C050F        	 11696:     move.b  ($050F,A4),D1
02:0003EFF8 C200            	 11697:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EFFA 66D2            	 11698:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EFFC 67F0            	 11699:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11700:     even
                            	 11701: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11702:     ; We found a direction that was not blocked by the room boundary.
                            	 11703:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11704:     ;
02:0003EFFE 4EB90004B65A    	 11705:     jsr     GetCollidingTileMoving
02:0003F004 122C034A        	 11706:     move.b  ($034A,A4),D1
02:0003F008 B001            	 11707:     cmp.b   D1,D0
02:0003F00A 64DA            	 11708:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11709:     even
                            	 11710: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11711:     ; TODO: confirm this
                            	 11712:     ;
                            	 11713:     ; If there were a room that had lamnolas, and they could get
                            	 11714:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11715:     ; an infinite loop.
                            	 11716:     ;
                            	 11717:     ; But, the only room with that configuration has those blocks
                            	 11718:     ; blocked off with a push block, which can only be pushed after
                            	 11719:     ; all monsters are killed.
                            	 11720:     ;
02:0003F00C 4E75            	 11721:     rts
                            	 11722: 
                            	 11723:     even
                            	 11724: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11725:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11726:     ;
02:0003F00E 7001            	 11727:     moveq   #1,D0
02:0003F010 19400002        	 11728:     move.b  D0,($0002,A4)
02:0003F014 102C0070        	 11729:     move.b  ($0070,A4),D0
02:0003F018 003C0011        	 11730:     ori     #$11,CCR  ; SEC: set C+X
02:0003F01C 12342070        	 11731:     move.b  ($70,A4,D2.W),D1
02:0003F020 0A3C0010        	 11732:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F024 9101            	 11733:     subx.b  D1,D0   ; SBC ObjX,X
02:0003F026 0A3C0010        	 11734:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F02A 640A            	 11735:     bcc  _anon_z04_153
02:0003F02C 122C0002        	 11736:     move.b  ($0002,A4),D1
02:0003F030 E309            	 11737:     lsl.b  #1,D1   ; ASL $02
02:0003F032 19410002        	 11738:     move.b  D1,($0002,A4)
                            	 11739: _anon_z04_153:
                            	 11740:     ; Find the vertical direction toward Link and store it in [03].
                            	 11741:     ;
02:0003F036 7004            	 11742:     moveq   #4,D0
02:0003F038 19400003        	 11743:     move.b  D0,($0003,A4)
02:0003F03C 102C0084        	 11744:     move.b  ($0084,A4),D0
02:0003F040 003C0011        	 11745:     ori     #$11,CCR  ; SEC: set C+X
02:0003F044 41EC0084        	 11746:     lea     ($0084,A4),A0
02:0003F048 12302000        	 11747:     move.b  (A0,D2.W),D1
02:0003F04C 0A3C0010        	 11748:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F050 9101            	 11749:     subx.b  D1,D0   ; SBC ObjY,X
02:0003F052 0A3C0010        	 11750:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F056 640A            	 11751:     bcc  _anon_z04_154
02:0003F058 122C0003        	 11752:     move.b  ($0003,A4),D1
02:0003F05C E309            	 11753:     lsl.b  #1,D1   ; ASL $03
02:0003F05E 19410003        	 11754:     move.b  D1,($0003,A4)
                            	 11755: _anon_z04_154:
                            	 11756:     ; If the horizontal direction toward Link is not allowed, then
                            	 11757:     ; go check the vertical direction.
                            	 11758:     ;
02:0003F062 102C0002        	 11759:     move.b  ($0002,A4),D0
02:0003F066 122C050F        	 11760:     move.b  ($050F,A4),D1
02:0003F06A C200            	 11761:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F06C 6708            	 11762:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11763:     ; If the horizontal direction toward Link is the same direction
                            	 11764:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11765:     ;
02:0003F06E 122C0098        	 11766:     move.b  ($0098,A4),D1
02:0003F072 C200            	 11767:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F074 6604            	 11768:     bne  _anon_z04_155
                            	 11769:     even
                            	 11770: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11771:     ; Load the vertical direction toward Link in order to test it for
                            	 11772:     ; room boundary and tile collision.
                            	 11773:     ;
02:0003F076 102C0003        	 11774:     move.b  ($0003,A4),D0
                            	 11775: _anon_z04_155:
                            	 11776:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11777:     ;
02:0003F07A 6000FF52        	 11778:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11779: 
                            	 11780:     even
                            	 11781: Lamnola_Move:
                            	 11782:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11783:     ;
                            	 11784:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11785:     ;
                            	 11786:     ; Start with a mask of $A1 in [02]:
                            	 11787:     ; - low nibble represents the right direction
                            	 11788:     ; - high nibble is used to set or clear carry as we go along
                            	 11789:     ;
02:0003F07E 103C00A1        	 11790:     move.b  #$A1,D0
02:0003F082 19400002        	 11791:     move.b  D0,($0002,A4)
                            	 11792:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11793:     ;
02:0003F086 41EC0098        	 11794:     lea     ($0098,A4),A0
02:0003F08A 10302000        	 11795:     move.b  (A0,D2.W),D0
02:0003F08E 122C0002        	 11796:     move.b  ($0002,A4),D1
02:0003F092 C200            	 11797:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F094 6712            	 11798:     beq  _L_z04_Lamnola_Move_Left
02:0003F096 10342070        	 11799:     move.b  ($70,A4,D2.W),D0
02:0003F09A 023C00EE        	 11800:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F09E 122C04E6        	 11801:     move.b  ($04E6,A4),D1
02:0003F0A2 D101            	 11802:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003F0A4 19802070        	 11803:     move.b  D0,($70,A4,D2.W)
                            	 11804:     even
                            	 11805: _L_z04_Lamnola_Move_Left:
                            	 11806:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 11807:     ;
02:0003F0A8 41EC0098        	 11808:     lea     ($0098,A4),A0
02:0003F0AC 10302000        	 11809:     move.b  (A0,D2.W),D0
02:0003F0B0 122C0002        	 11810:     move.b  ($0002,A4),D1
02:0003F0B4 E309            	 11811:     lsl.b  #1,D1   ; ASL $02
02:0003F0B6 19410002        	 11812:     move.b  D1,($0002,A4)
02:0003F0BA 122C0002        	 11813:     move.b  ($0002,A4),D1
02:0003F0BE C200            	 11814:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F0C0 6716            	 11815:     beq  _L_z04_Lamnola_Move_Down
02:0003F0C2 10342070        	 11816:     move.b  ($70,A4,D2.W),D0
02:0003F0C6 122C04E6        	 11817:     move.b  ($04E6,A4),D1
02:0003F0CA 0A3C0010        	 11818:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F0CE 9101            	 11819:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003F0D0 0A3C0010        	 11820:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F0D4 19802070        	 11821:     move.b  D0,($70,A4,D2.W)
                            	 11822:     even
                            	 11823: _L_z04_Lamnola_Move_Down:
                            	 11824:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	 11825:     ;
