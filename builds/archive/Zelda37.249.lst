                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:0004387E 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00043882 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00043886 1014            	  5783:     move.b  ($0000,A4),D0
02:00043888 41EC0302        	  5784:     lea     ($0302,A4),A0
02:0004388C 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:00043890 5202            	  5786:     addq.b  #1,D2
02:00043892 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00043896 41EC0302        	  5788:     lea     ($0302,A4),A0
02:0004389A 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:0004389E 5202            	  5790:     addq.b  #1,D2
02:000438A0 102C0006        	  5791:     move.b  ($0006,A4),D0
02:000438A4 41EC0302        	  5792:     lea     ($0302,A4),A0
02:000438A8 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:000438AC 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:000438AE 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:000438B2 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:000438B4 7020            	  5803:     moveq   #32,D0
02:000438B6 122C0001        	  5804:     move.b  ($0001,A4),D1
02:000438BA 8001            	  5805:     or.b  D1,D0
02:000438BC 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:000438C0 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:000438C4 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:000438C6 103C00FF        	  5815:     move.b  #$FF,D0
02:000438CA 41EC0302        	  5816:     lea     ($0302,A4),A0
02:000438CE 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:000438D2 1002            	  5818:     move.b  D2,D0
02:000438D4 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:000438D8 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:000438DC 102C0054        	  5829:     move.b  ($0054,A4),D0
02:000438E0 02000003        	  5830:     andi.b #$03,D0
02:000438E4 6708            	  5831:     beq  _anon_z05_122
02:000438E6 7008            	  5832:     moveq   #8,D0
02:000438E8 19400027        	  5833:     move.b  D0,($0027,A4)
02:000438EC 4E75            	  5834:     rts
