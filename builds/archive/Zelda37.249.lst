02:00039F5C 61005BEC        	   641:     jsr     _ShootIfWanted
02:00039F60 646A            	   642:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   643:     ; Set monster's state to $80 for delaying after shooting.
                            	   644:     ;
02:00039F62 103C0080        	   645:     move.b  #$80,D0
02:00039F66 41EC00AC        	   646:     lea     ($00AC,A4),A0
02:00039F6A 11802000        	   647:     move.b  D0,(A0,D2.W)
                            	   648:     ; Reset the "wants to shoot" flag.
                            	   649:     ;
02:00039F6E 7000            	   650:     moveq   #0,D0
02:00039F70 41EC0412        	   651:     lea     ($0412,A4),A0
02:00039F74 11802000        	   652:     move.b  D0,(A0,D2.W)
                            	   653:     ; Have the shot keep track of the monster.
                            	   654:     ;
02:00039F78 1002            	   655:     move.b  D2,D0
02:00039F7A 41EC042C        	   656:     lea     ($042C,A4),A0
02:00039F7E 11803000        	   657:     move.b  D0,(A0,D3.W)
                            	   658:     ; Have the monster keep track of the shot.
                            	   659:     ;
02:00039F82 1003            	   660:     move.b  D3,D0
02:00039F84 41EC042C        	   661:     lea     ($042C,A4),A0
02:00039F88 11802000        	   662:     move.b  D0,(A0,D2.W)
                            	   663:     ; Set the shot's state to $10, which is the flying state for them.
                            	   664:     ;
02:00039F8C 7010            	   665:     moveq   #16,D0
02:00039F8E 41EC00AC        	   666:     lea     ($00AC,A4),A0
02:00039F92 11803000        	   667:     move.b  D0,(A0,D3.W)
                            	   668:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   669:     ;
02:00039F96 103C00A0        	   670:     move.b  #$A0,D0
02:00039F9A 41EC03BC        	   671:     lea     ($03BC,A4),A0
02:00039F9E 11803000        	   672:     move.b  D0,(A0,D3.W)
                            	   673:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   674:     ;
