                            	  5819: CalcBoomerangFrame:
                            	  5820:     ; The minor state (low 3 bits of state) is used to
                            	  5821:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5822:     ;
                            	  5823:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5824:     ; In other words, don't offset the coordinate below.
                            	  5825:     ;
02:0004C5B6 7000            	  5826:     moveq   #0,D0
02:0004C5B8 1880            	  5827:     move.b  D0,($0000,A4)
02:0004C5BA 41EC00AC        	  5828:     lea     ($00AC,A4),A0
02:0004C5BE 10302000        	  5829:     move.b  (A0,D2.W),D0
02:0004C5C2 0200000F        	  5830:     andi.b #$0F,D0
02:0004C5C6 7600            	  5831:     moveq   #0,D3
02:0004C5C8 1600            	  5832:     move.b  D0,D3
02:0004C5CA 7000            	  5833:     moveq   #0,D0
02:0004C5CC 19400001        	  5834:     move.b  D0,($0001,A4)
02:0004C5D0 41F90004C1BE    	  5835:     lea     (BoomerangFrameCycle).l,A0
02:0004C5D6 10303000        	  5836:     move.b  (A0,D3.W),D0
02:0004C5DA 1940000C        	  5837:     move.b  D0,($000C,A4)
                            	  5838:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5839:     ;
02:0004C5DE 1003            	  5840:     move.b  D3,D0
02:0004C5E0 41F90004C1C8    	  5841:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004C5E6 10303000        	  5842:     move.b  (A0,D3.W),D0
02:0004C5EA 19400004        	  5843:     move.b  D0,($0004,A4)
                            	  5844:     ; TODO: ?
                            	  5845:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5846:     ; Else add the item value of the magic boomerang.
                            	  5847:     ;
                            	  5848:     ; But none of the values in the base sprite attributes array is 8.
                            	  5849:     ;
                            	  5850:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5851:     ; the inventory will always be added to the base sprite attribute.
                            	  5852:     ;
                            	  5853:     ; So, palette row 4 or 5 will be chosen.
                            	  5854:     ;
02:0004C5EE 7600            	  5855:     moveq   #0,D3
