                            	  6600: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6601:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6602:     ;   full heart=4 partial heart=$70
                            	  6603:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6604:     ; But the method here yields $3EF, because partial heart is
                            	  6605:     ; considered full when = $FF instead of $100.
                            	  6606:     ;
02:00032286 102C000E        	  6607:     move.b  ($000E,A4),D0
02:0003228A 003C0011        	  6608:     ori     #$11,CCR  ; SEC: set C+X
02:0003228E 122C0670        	  6609:     move.b  ($0670,A4),D1
02:00032292 0A3C0010        	  6610:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032296 9101            	  6611:     subx.b  D1,D0   ; SBC HeartPartial
02:00032298 0A3C0010        	  6612:     eori    #$10,CCR  ; restore X = 6502 C
02:0003229C 1940000E        	  6613:     move.b  D0,($000E,A4)
02:000322A0 102C066F        	  6614:     move.b  ($066F,A4),D0
02:000322A4 0200000F        	  6615:     andi.b #$0F,D0
02:000322A8 6710            	  6616:     beq  _L_z01_Link_BeHarmed_HandleDied
02:000322AA 532C066F        	  6617:     subq.b  #1,($066F,A4)
02:000322AE 103C00FF        	  6618:     move.b  #$FF,D0
02:000322B2 19400670        	  6619:     move.b  D0,($0670,A4)
02:000322B6 6600FF6E        	  6620:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6621:     even
                            	  6622: _L_z01_Link_BeHarmed_HandleDied:
                            	  6623:     ; Link died.
                            	  6624:     ;
                            	  6625:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6626:     ; Make Link face down.
                            	  6627:     ; Go to mode $11.
                            	  6628:     ;
02:000322BA 102C066F        	  6629:     move.b  ($066F,A4),D0
02:000322BE 020000F0        	  6630:     andi.b #$F0,D0
02:000322C2 1940066F        	  6631:     move.b  D0,($066F,A4)
02:000322C6 4EB90004B2D0    	  6632:     jsr     EndGameMode
02:000322CC 19400670        	  6633:     move.b  D0,($0670,A4)
02:000322D0 194000AC        	  6634:     move.b  D0,($00AC,A4)
02:000322D4 7011            	  6635:     moveq   #17,D0
02:000322D6 19400012        	  6636:     move.b  D0,($0012,A4)
02:000322DA 7004            	  6637:     moveq   #4,D0
02:000322DC 19400098        	  6638:     move.b  D0,($0098,A4)
                            	  6639: _anon_z01_87:
02:000322E0 4E75            	  6640:     rts
                            	  6641: 
                            	  6642: ; Params:
                            	  6643: ; X: monster slot
                            	  6644: ; Y: weapon slot
                            	  6645: ; [02]: monster mid X
                            	  6646: ; [03]: monster mid Y
                            	  6647: ;
                            	  6648: ; Returns:
                            	  6649: ; [00]: weapon slot
                            	  6650: ;
                            	  6651: ; If the weapon slot holds food (high bit of state is set), then return.
                            	  6652: ;
                            	  6653:     even
                            	  6654: CheckMonsterBoomerangOrFoodCollision:
02:000322E2 41EC00AC        	  6655:     lea     ($00AC,A4),A0
02:000322E6 10303000        	  6656:     move.b  (A0,D3.W),D0
02:000322EA E308            	  6657:     lsl.b  #1,D0   ; ASL A
02:000322EC 65F2            	  6658:     bcs  _anon_z01_87
02:000322EE 1883            	  6659:     move.b  D3,($0000,A4)
                            	  6660:     ; Set boomerang damage type (2) in [09].
                            	  6661:     ;
02:000322F0 7002            	  6662:     moveq   #2,D0
02:000322F2 19400009        	  6663:     move.b  D0,($0009,A4)
                            	  6664:     ; Set collision threshold $A in both axes.
                            	  6665:     ;
02:000322F6 700A            	  6666:     moveq   #10,D0
02:000322F8 1940000D        	  6667:     move.b  D0,($000D,A4)
02:000322FC 1940000E        	  6668:     move.b  D0,($000E,A4)
                            	  6669:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6670:     ;
02:00032300 10343070        	  6671:     move.b  ($70,A4,D3.W),D0
02:00032304 023C00EE        	  6672:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032308 123C0004        	  6673:     move.b  #$04,D1
