                            	  9610: _L_z04_UpdateGohma_Move:
                            	  9611:     ; Add $80 to the movement accumulator.
                            	  9612:     ;
02:0003E03C 41EC041F        	  9613:     lea     ($041F,A4),A0
02:0003E040 10302000        	  9614:     move.b  (A0,D2.W),D0
02:0003E044 023C00EE        	  9615:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E048 123C0080        	  9616:     move.b  #$80,D1
02:0003E04C D101            	  9617:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003E04E 41EC041F        	  9618:     lea     ($041F,A4),A0
02:0003E052 11802000        	  9619:     move.b  D0,(A0,D2.W)
                            	  9620:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9621:     ;
02:0003E056 640000A8        	  9622:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9623:     ; Increase the distance traveled, and move 1.
                            	  9624:     ;
02:0003E05A 41EC0412        	  9625:     lea     ($0412,A4),A0
02:0003E05E 52302000        	  9626:     addq.b  #1,(A0,D2.W)
                            	  9627:     ; Set a direction mask in [02], starting with right (1).
                            	  9628:     ;
02:0003E062 7001            	  9629:     moveq   #1,D0
02:0003E064 19400002        	  9630:     move.b  D0,($0002,A4)
                            	  9631:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9632:     ;
02:0003E068 41EC0098        	  9633:     lea     ($0098,A4),A0
02:0003E06C 10302000        	  9634:     move.b  (A0,D2.W),D0
02:0003E070 122C0002        	  9635:     move.b  ($0002,A4),D1
02:0003E074 C200            	  9636:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E076 6704            	  9637:     beq  _anon_z04_118
02:0003E078 52342070        	  9638:     addq.b  #1,($70,A4,D2.W)
                            	  9639: _anon_z04_118:
                            	  9640:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9641:     ;
02:0003E07C 122C0002        	  9642:     move.b  ($0002,A4),D1
02:0003E080 E309            	  9643:     lsl.b  #1,D1   ; ASL $02
02:0003E082 19410002        	  9644:     move.b  D1,($0002,A4)
02:0003E086 122C0002        	  9645:     move.b  ($0002,A4),D1
02:0003E08A C200            	  9646:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E08C 6704            	  9647:     beq  _anon_z04_119
02:0003E08E 53342070        	  9648:     subq.b  #1,($70,A4,D2.W)
                            	  9649: _anon_z04_119:
                            	  9650:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9651:     ;
02:0003E092 122C0002        	  9652:     move.b  ($0002,A4),D1
02:0003E096 E309            	  9653:     lsl.b  #1,D1   ; ASL $02
02:0003E098 19410002        	  9654:     move.b  D1,($0002,A4)
02:0003E09C 122C0002        	  9655:     move.b  ($0002,A4),D1
02:0003E0A0 C200            	  9656:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E0A2 6708            	  9657:     beq  _anon_z04_120
02:0003E0A4 41EC0084        	  9658:     lea     ($0084,A4),A0
02:0003E0A8 52302000        	  9659:     addq.b  #1,(A0,D2.W)
                            	  9660: _anon_z04_120:
                            	  9661:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9662:     ;
02:0003E0AC 122C0002        	  9663:     move.b  ($0002,A4),D1
02:0003E0B0 E309            	  9664:     lsl.b  #1,D1   ; ASL $02
02:0003E0B2 19410002        	  9665:     move.b  D1,($0002,A4)
02:0003E0B6 122C0002        	  9666:     move.b  ($0002,A4),D1
02:0003E0BA C200            	  9667:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E0BC 6708            	  9668:     beq  _anon_z04_121
02:0003E0BE 41EC0084        	  9669:     lea     ($0084,A4),A0
02:0003E0C2 53302000        	  9670:     subq.b  #1,(A0,D2.W)
                            	  9671: _anon_z04_121:
                            	  9672:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9673:     ;
02:0003E0C6 41EC0412        	  9674:     lea     ($0412,A4),A0
02:0003E0CA 10302000        	  9675:     move.b  (A0,D2.W),D0
02:0003E0CE 0C000020        	  9676:     cmpi.b  #$20,D0
02:0003E0D2 662C            	  9677:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9678:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
