02:0003D1A8 7607            	  7696:     moveq   #7,D3
                            	  7697: _anon_z04_98:
                            	  7698:     ; Set the vertical speed for the beginning of the jump.
                            	  7699:     ;
02:0003D1AA 41F90003D09E    	  7700:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
