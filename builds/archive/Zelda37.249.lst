02:0003F26E 702C            	 12048:     moveq   #44,D0
02:0003F270 7600            	 12049:     moveq   #0,D3
02:0003F272 41EC034F        	 12050:     lea     ($034F,A4),A0
02:0003F276 16302000        	 12051:     move.b  (A0,D2.W),D3
