                            	  6099:     ; The weapon is the sword.
                            	  6100:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6101:     ;
02:0004C7D6 023C00EE        	  6102:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C7DA 122C0657        	  6103:     move.b  ($0657,A4),D1
