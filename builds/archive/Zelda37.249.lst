                            	   819:     ;
02:0002E900 7010            	   820:     moveq   #16,D0
02:0002E902 19400604        	   821:     move.b  D0,($0604,A4)
                            	   822:     ; If the high 2 bits of character element = 0, then return.
                            	   823:     ;
02:0002E906 1214            	   824:     move.b  ($00,A4),D1   ; ptr lo
02:0002E908 182C0001        	   825:     move.b  ($01,A4),D4  ; ptr hi
02:0002E90C 024100FF        	   826:     andi.w  #$00FF,D1         ; zero-extend lo byte
