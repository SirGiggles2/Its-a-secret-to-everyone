02:0003BF5C 10303000        	  5177:     move.b  (A0,D3.W),D0
02:0003BF60 023C00EE        	  5178:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF64 41F900030E14    	  5179:     lea     (SpriteRelativeExtents).l,A0
02:0003BF6A 12302000        	  5180:     move.b  (A0,D2.W),D1
02:0003BF6E D101            	  5181:     addx.b  D1,D0   ; ADC SpriteRelativeExtents,X
02:0003BF70 0C0000E9        	  5182:     cmpi.b  #$E9,D0
02:0003BF74 6406            	  5183:     bcc  _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_AddPriorityBit
02:0003BF76 0C000018        	  5184:     cmpi.b  #$18,D0
02:0003BF7A 6414            	  5185:     bcc  _anon_z04_73
                            	  5186:     even
                            	  5187: _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_AddPriorityBit:
02:0003BF7C 41EC0202        	  5188:     lea     ($0202,A4),A0
02:0003BF80 10303000        	  5189:     move.b  (A0,D3.W),D0
02:0003BF84 00000020        	  5190:     ori.b #$20,D0
02:0003BF88 41EC0202        	  5191:     lea     ($0202,A4),A0
02:0003BF8C 11803000        	  5192:     move.b  D0,(A0,D3.W)
                            	  5193: _anon_z04_73:
02:0003BF90 5302            	  5194:     subq.b  #1,D2
02:0003BF92 6AC4            	  5195:     bpl  _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_LoopExtent
02:0003BF94 4E75            	  5196:     rts
