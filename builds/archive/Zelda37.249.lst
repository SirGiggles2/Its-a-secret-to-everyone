                            	  5754: _anon_z04_82:
                            	  5755:     ; Turn randomly while flying, as usual.
                            	  5756:     ;
02:0003C3EA 61003A78        	  5757:     jsr     Flyer_Wander
                            	  5758:     ; After every turn, the common flyer routines set timer to $10.
                            	  5759:     ; This can be used as a signal for moldorm to propagate
                            	  5760:     ; direction changes down the chain.
                            	  5761:     ;
                            	  5762:     ; Between each turn, timer <> $10.
                            	  5763:     ;
                            	  5764:     ; At the end of the delay after the last turn, timer = 0.
                            	  5765:     ; This is a signal that that flying state ended, and a new one
                            	  5766:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5767:     ; we can propagate direction changes again; and start
                            	  5768:     ; a new flying interval by setting timer to $10. This will make
                            	  5769:     ; the next flying state delay that amount of time before turning
                            	  5770:     ; the first time.
                            	  5771:     ;
                            	  5772:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5773:     ; arm the timer again, and shift directions down the chain.
                            	  5774:     ;
02:0003C3EE 10342028        	  5775:     move.b  ($28,A4,D2.W),D0
02:0003C3F2 6602            	  5776:     bne.s  __far_z_04_0044
02:0003C3F4 60CE            	  5777:     jmp  Moldorm_ChangeFlyingState
                            	  5778: __far_z_04_0044:
                            	  5779:     even
