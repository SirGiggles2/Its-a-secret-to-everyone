                            	  5660: AnimateAndDrawObjectWalking:
02:00031BBE 4EB90004CCC0    	  5661:     jsr     AnimateObjectWalking
02:00031BC4 1003            	  5662:     move.b  D3,D0
02:00031BC6 6004            	  5663:     jmp     DrawObjectNotMirrored
                            	  5664: 
                            	  5665: ; Params:
                            	  5666: ; A: frame image
                            	  5667: ; X: object index
                            	  5668: ; [00]: object X
                            	  5669: ; [01]: object Y
                            	  5670: ;
                            	  5671: ;
                            	  5672: ; Set [0C] mirrored.
                            	  5673:     even
                            	  5674: DrawObjectMirrored:
02:00031BC8 7601            	  5675:     moveq   #1,D3
02:00031BCA 6602            	  5676:     bne  _anon_z01_75
                            	  5677: ; Params:
                            	  5678: ; A: frame image
                            	  5679: ; X: object index
                            	  5680: ; [00]: object X
                            	  5681: ; [01]: object Y
                            	  5682: ; [0F]: flip horizontally
                            	  5683: ;
                            	  5684:     even
                            	  5685: DrawObjectNotMirrored:
02:00031BCC 7600            	  5686:     moveq   #0,D3
                            	  5687: _anon_z01_75:
02:00031BCE 1943000C        	  5688:     move.b  D3,($000C,A4)
                            	  5689:     ; Set animation index = object type + 1.
                            	  5690:     ;
02:00031BD2 7600            	  5691:     moveq   #0,D3
02:00031BD4 41EC034F        	  5692:     lea     ($034F,A4),A0
02:00031BD8 16302000        	  5693:     move.b  (A0,D2.W),D3
                            	  5694: ; Params:
                            	  5695: ; A: frame
                            	  5696: ; X: object index/cycle sprite index
                            	  5697: ; Y: object type
                            	  5698: ; [00]: object X
                            	  5699: ; [01]: object Y
                            	  5700: ; [0C]: mirrored
                            	  5701: ; [0F]: flip horizontally
                            	  5702: ;
                            	  5703: ; Note:
                            	  5704: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5705: ;
                            	  5706: ; The animation index of most objects is (object type + 1),
                            	  5707: ; to make up for the fact that Link uses two animation indexes.
                            	  5708: ;
                            	  5709:     even
                            	  5710: DrawObjectWithType:
02:00031BDC 5203            	  5711:     addq.b  #1,D3
                            	  5712: ; Params:
                            	  5713: ; A: frame
                            	  5714: ; X: object index/cycle sprite index
                            	  5715: ; Y: animation index
                            	  5716: ; [00]: object X
                            	  5717: ; [01]: object Y
                            	  5718: ; [0C]: mirrored
                            	  5719: ; [0F]: flip horizontally
                            	  5720: ;
                            	  5721: ; Note:
                            	  5722: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5723: ; But Link uses [0F] for flipping without checking [0C].
                            	  5724: ;
