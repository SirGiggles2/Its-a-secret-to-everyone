02:00032218 122C000E        	  6553:     move.b  ($000E,A4),D1
02:0003221C E211            	  6554:     roxr.b  #1,D1   ; ROR $0E
02:0003221E 1941000E        	  6555:     move.b  D1,($000E,A4)
