02:0003B598 41EC0492        	  3818:     lea     ($0492,A4),A0
02:0003B59C 10302000        	  3819:     move.b  (A0,D2.W),D0
02:0003B5A0 66EC            	  3820:     bne  _anon_z04_53
02:0003B5A2 4EB90004D51E    	  3821:     jsr     ResetObjMetastateAndTimer
02:0003B5A8 6000F45A        	  3822:     jmp     EndInitFlyer
