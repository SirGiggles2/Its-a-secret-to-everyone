                            	 12336:     ; The animation cycle has 6 frames.
                            	 12337:     ;
02:0003F456 41EC046B        	 12338:     lea     ($046B,A4),A0
02:0003F45A 10302000        	 12339:     move.b  (A0,D2.W),D0
02:0003F45E 0C000006        	 12340:     cmpi.b  #$06,D0
02:0003F462 660A            	 12341:     bne  _L_z04_Ganon_MoveAndShoot_Move
