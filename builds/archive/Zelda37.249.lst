                            	  5199: InitRope:
02:0003BF96 4EF90002C650    	  5200:     jmp     c_init_rope
                            	  5201: 
                            	  5202: UpdateRope:
                            	  5203:     ; Set the input direction to the facing direction.
                            	  5204:     ;
02:0003BF9C 41EC0098        	  5205:     lea     ($0098,A4),A0
02:0003BFA0 10302000        	  5206:     move.b  (A0,D2.W),D0
02:0003BFA4 41EC03F8        	  5207:     lea     ($03F8,A4),A0
02:0003BFA8 11802000        	  5208:     move.b  D0,(A0,D2.W)
02:0003BFAC 1B00            	  5209:     move.b  D0,-(A5)  ; PHA
                            	  5210:     ; If we have the clock, or the monster is stunned, then don't move.
                            	  5211:     ;
02:0003BFAE 102C066C        	  5212:     move.b  ($066C,A4),D0
02:0003BFB2 1234203D        	  5213:     move.b  ($3D,A4,D2.W),D1
02:0003BFB6 8001            	  5214:     or.b  D1,D0
02:0003BFB8 6642            	  5215:     bne  _L_z04_UpdateRope_CheckSpeed
02:0003BFBA 4EB90004B884    	  5216:     jsr     Walker_Move
                            	  5217:     ; Truncate the grid offset at $10.
                            	  5218:     ;
02:0003BFC0 41EC0394        	  5219:     lea     ($0394,A4),A0
02:0003BFC4 10302000        	  5220:     move.b  (A0,D2.W),D0
02:0003BFC8 0200000F        	  5221:     andi.b #$0F,D0
02:0003BFCC 6608            	  5222:     bne  _anon_z04_75
02:0003BFCE 41EC0394        	  5223:     lea     ($0394,A4),A0
02:0003BFD2 11802000        	  5224:     move.b  D0,(A0,D2.W)
                            	  5225: _anon_z04_75:
                            	  5226:     ; If not rushing (qspeed <> $60) and timer = 0, then
                            	  5227:     ; set timer to a random value up to $3F, and turn to face
                            	  5228:     ; an unblocked direction.
                            	  5229:     ;
