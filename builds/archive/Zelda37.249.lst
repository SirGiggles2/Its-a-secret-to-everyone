                            	  3488: _L_z04_UpdateOctorock_SaveOffset:
02:0003B3A0 1B00            	  3489:     move.b  D0,-(A5)  ; PHA
                            	  3490:     ; Decrement the animation counter, and roll over if needed.
                            	  3491:     ;
02:0003B3A2 41EC03D0        	  3492:     lea     ($03D0,A4),A0
