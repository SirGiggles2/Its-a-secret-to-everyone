02:00039FA4 41EC0380        	   676:     lea     ($0380,A4),A0
02:00039FA8 11803000        	   677:     move.b  D0,(A0,D3.W)
                            	   678:     ; Make it autonomous (ready to update on its own).
                            	   679:     ;
02:00039FAC 7000            	   680:     moveq   #0,D0
02:00039FAE 41EC0405        	   681:     lea     ($0405,A4),A0
02:00039FB2 11803000        	   682:     move.b  D0,(A0,D3.W)
                            	   683:     ; The first animation frame lasts 3 screen frames.
                            	   684:     ;
02:00039FB6 7003            	   685:     moveq   #3,D0
02:00039FB8 41EC03D0        	   686:     lea     ($03D0,A4),A0
02:00039FBC 11803000        	   687:     move.b  D0,(A0,D3.W)
                            	   688:     ; Have the monster wait a random amount of time, up to $3F frames.
                            	   689:     ;
