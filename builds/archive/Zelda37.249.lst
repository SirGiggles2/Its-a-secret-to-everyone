02:00036994 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00036998 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003699C 5303            	  4886:     subq.b  #1,D3
02:0003699E 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
