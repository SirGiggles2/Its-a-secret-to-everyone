                            	  5549: 
                            	  5550: ; Params:
                            	  5551: ; [02]: Y
                            	  5552: ; [03]: X
                            	  5553: ;
                            	  5554: ; Returns:
                            	  5555: ; [00]: high byte of PPU address
                            	  5556: ; [01]: low byte of PPU address
                            	  5557: ;
                            	  5558: ;
                            	  5559: ; Turn the 16-bit value 08YY into the PPU address
                            	  5560: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5561: ;
                            	  5562: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5563: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5564: ;
                            	  5565:     even
