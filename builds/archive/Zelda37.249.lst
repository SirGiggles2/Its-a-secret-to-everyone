                            	  9698: _L_z04_UpdateGohma_AnimateEye:
                            	  9699:     ; Animate the eye.
                            	  9700:     ;
                            	  9701:     ; First, if the counter for when to open the eye next = 0, then
                            	  9702:     ; set it to a random value at least $C0; and set the timer for
                            	  9703:     ; keeping the eye open to $80.
                            	  9704:     ;
                            	  9705:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9706:     ; every other frame.
                            	  9707:     ;
02:0003E100 41EC042C        	  9708:     lea     ($042C,A4),A0
02:0003E104 10302000        	  9709:     move.b  (A0,D2.W),D0
02:0003E108 661E            	  9710:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003E10A 103C0080        	  9711:     move.b  #$80,D0
02:0003E10E 41EC0444        	  9712:     lea     ($0444,A4),A0
02:0003E112 11802000        	  9713:     move.b  D0,(A0,D2.W)
02:0003E116 103C00C0        	  9714:     move.b  #$C0,D0
02:0003E11A 12342018        	  9715:     move.b  ($18,A4,D2.W),D1
02:0003E11E 8001            	  9716:     or.b  D1,D0
02:0003E120 41EC042C        	  9717:     lea     ($042C,A4),A0
02:0003E124 11802000        	  9718:     move.b  D0,(A0,D2.W)
                            	  9719:     even
                            	  9720: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9721:     ; Decrement the next-open-eye counter.
                            	  9722:     ;
02:0003E128 102C0015        	  9723:     move.b  ($0015,A4),D0
02:0003E12C E208            	  9724:     lsr.b  #1,D0   ; LSR A
02:0003E12E 6408            	  9725:     bcc  _anon_z04_122
02:0003E130 41EC042C        	  9726:     lea     ($042C,A4),A0
02:0003E134 53302000        	  9727:     subq.b  #1,(A0,D2.W)
                            	  9728: _anon_z04_122:
                            	  9729:     ; If open eye timer = 0, then the eye is closed.
                            	  9730:     ; Go animate it differently.
                            	  9731:     ;
02:0003E138 41EC0444        	  9732:     lea     ($0444,A4),A0
02:0003E13C 10302000        	  9733:     move.b  (A0,D2.W),D0
02:0003E140 674A            	  9734:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9735:     ; Else decrement the open eye timer.
                            	  9736:     ;
02:0003E142 41EC0444        	  9737:     lea     ($0444,A4),A0
02:0003E146 53302000        	  9738:     subq.b  #1,(A0,D2.W)
                            	  9739:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9740:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9741:     ;
02:0003E14A 7602            	  9742:     moveq   #2,D3
02:0003E14C 0C000070        	  9743:     cmpi.b  #$70,D0
02:0003E150 6408            	  9744:     bcc  _anon_z04_123
02:0003E152 0C000010        	  9745:     cmpi.b  #$10,D0
02:0003E156 6502            	  9746:     bcs  _anon_z04_123
02:0003E158 5203            	  9747:     addq.b  #1,D3
                            	  9748: _anon_z04_123:
