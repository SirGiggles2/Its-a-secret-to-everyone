                            	  4173:     ;
02:0004BA9E 41EC04BF        	  4174:     lea     ($04BF,A4),A0
02:0004BAA2 10302000        	  4175:     move.b  (A0,D2.W),D0
02:0004BAA6 02000010        	  4176:     andi.b #$10,D0
02:0004BAAA 6702            	  4177:     beq.s  __far_z_07_0051
