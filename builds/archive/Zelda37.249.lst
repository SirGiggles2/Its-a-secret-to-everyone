02:0003CF44 C001            	  7368:     and.b  D1,D0
02:0003CF46 6710            	  7369:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7370:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7371:     ; in order to index into the second set of frame image numbers.
                            	  7372:     ;
02:0003CF48 1003            	  7373:     move.b  D3,D0
