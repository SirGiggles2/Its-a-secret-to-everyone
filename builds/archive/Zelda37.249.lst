02:0004BF60 41EC034F        	  4895:     lea     ($034F,A4),A0
02:0004BF64 10302000        	  4896:     move.b  (A0,D2.W),D0
02:0004BF68 0C000057        	  4897:     cmpi.b  #$57,D0
