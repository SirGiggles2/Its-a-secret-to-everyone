02:0003C344 41EC04F0        	  5645:     lea     ($04F0,A4),A0
02:0003C348 10302000        	  5646:     move.b  (A0,D2.W),D0
02:0003C34C 41EC04F1        	  5647:     lea     ($04F1,A4),A0
