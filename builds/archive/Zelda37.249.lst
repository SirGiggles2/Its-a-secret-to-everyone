02:0003F4F6 123C0007        	 12437:     move.b  #$07,D1
02:0003F4FA D101            	 12438:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003F4FC 19802070        	 12439:     move.b  D0,($70,A4,D2.W)
02:0003F500 41EC0084        	 12440:     lea     ($0084,A4),A0
02:0003F504 10302000        	 12441:     move.b  (A0,D2.W),D0
02:0003F508 123C0008        	 12442:     move.b  #$08,D1
02:0003F50C D101            	 12443:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F50E 41EC0084        	 12444:     lea     ($0084,A4),A0
02:0003F512 11802000        	 12445:     move.b  D0,(A0,D2.W)
02:0003F516 615C            	 12446:     jsr     Ganon_SetUpBurstRays
02:0003F518 610003DA        	 12447:     jsr     PlayBossDeathCry
