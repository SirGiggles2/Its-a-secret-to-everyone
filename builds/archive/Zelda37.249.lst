                            	  7331: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D160 7400            	  7332:     moveq   #0,D2
02:0004D162 142C0340        	  7333:     move.b  ($0340,A4),D2
                            	  7334:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7335:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7336:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7337:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7338:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7339:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7340:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7341:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7342:     ; corrupting them and causing a deterministic address-error
                            	  7343:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7344:     ; identified by Codex static review.)
                            	  7345: _L_z07_P47_pre_check:
02:0004D166 102C0525        	  7346:     move.b  ($0525,A4),D0
02:0004D16A 020000F0        	  7347:     andi.b  #$F0,D0
02:0004D16E 0C000040        	  7348:     cmpi.b  #$40,D0
02:0004D172 6506            	  7349:     blo     _L_z07_P47_pre_snap
02:0004D174 0C0000E0        	  7350:     cmpi.b  #$E0,D0
02:0004D178 6506            	  7351:     blo     _L_z07_P47_pre_ok
                            	  7352: _L_z07_P47_pre_snap:
02:0004D17A 197C00480525    	  7353:     move.b  #$48,($0525,A4)
                            	  7354: _L_z07_P47_pre_ok:
02:0004D180 7005            	  7355:     moveq   #5,D0
02:0004D182 610004F4        	  7356:     jsr     SwitchBank
02:0004D186 4EB900041F1A    	  7357:     jsr     FindNextEdgeSpawnCell
                            	  7358:     ; Post-walk 1: bottom-edge snap.
02:0004D18C 102C0525        	  7359:     move.b  ($0525,A4),D0
02:0004D190 020000F0        	  7360:     andi.b  #$F0,D0
02:0004D194 0C0000E0        	  7361:     cmpi.b  #$E0,D0
02:0004D198 660C            	  7362:     bne     _L_z07_P47_post1_ok
02:0004D19A 197C00480525    	  7363:     move.b  #$48,($0525,A4)
02:0004D1A0 4EB900041F1A    	  7364:     jsr     FindNextEdgeSpawnCell
                            	  7365: _L_z07_P47_post1_ok:
                            	  7366:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7367:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D1A6 7600            	  7368:     moveq   #0,D3
02:0004D1A8 162C0525        	  7369:     move.b  ($0525,A4),D3
02:0004D1AC 0243000F        	  7370:     andi.w  #$000F,D3
02:0004D1B0 C6FC002C        	  7371:     mulu.w  #44,D3
02:0004D1B4 203C00FF6530    	  7372:     move.l  #$FF6530,D0
02:0004D1BA D083            	  7373:     add.l   D3,D0
02:0004D1BC 7600            	  7374:     moveq   #0,D3
02:0004D1BE 162C0525        	  7375:     move.b  ($0525,A4),D3
02:0004D1C2 E84B            	  7376:     lsr.w   #4,D3
02:0004D1C4 5943            	  7377:     subi.w  #4,D3
02:0004D1C6 E34B            	  7378:     lsl.w   #1,D3
02:0004D1C8 D083            	  7379:     add.l   D3,D0
02:0004D1CA 2040            	  7380:     movea.l D0,A0
02:0004D1CC 1010            	  7381:     move.b  (A0),D0
02:0004D1CE 0C000084        	  7382:     cmpi.b  #$84,D0
02:0004D1D2 6544            	  7383:     blo     _L_z07_P47_post2_ok
                            	  7384:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7385:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7386:     ; writes to the $05xx region.
02:0004D1D4 7800            	  7387:     moveq   #0,D4
                            	  7388: _L_z07_P47_fb_loop:
02:0004D1D6 41FAE48E        	  7389:     lea     _L_z07_P47_FallbackCells(pc),A0
