                            	  2717:     ; Because the visible part of the cursor block sprite is
                            	  2718:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2719:     ; above its ObjY.
02:0003530A 102C0084        	  2720:     move.b  ($0084,A4),D0
02:0003530E 003C0011        	  2721:     ori     #$11,CCR  ; SEC: set C+X
02:00035312 123C0008        	  2722:     move.b  #$08,D1
02:00035316 0A3C0010        	  2723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003531A 9101            	  2724:     subx.b  D1,D0   ; SBC #$08
02:0003531C 0A3C0010        	  2725:     eori    #$10,CCR  ; restore X = 6502 C
02:00035320 19400204        	  2726:     move.b  D0,($0204,A4)
02:00035324 7070            	  2727:     moveq   #112,D0
02:00035326 19400070        	  2728:     move.b  D0,($0070,A4)
02:0003532A 103C0087        	  2729:     move.b  #$87,D0
02:0003532E 19400085        	  2730:     move.b  D0,($0085,A4)
02:00035332 7030            	  2731:     moveq   #48,D0
02:00035334 19400071        	  2732:     move.b  D0,($0071,A4)
