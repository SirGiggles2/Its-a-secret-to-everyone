02:0003BE44 61000104        	  5020:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5021:     ; The default image is the hand open.
                            	  5022:     ; If animation frame = 0, then return.
                            	  5023:     ;
02:0003BE48 7400            	  5024:     moveq   #0,D2
02:0003BE4A 142C0340        	  5025:     move.b  ($0340,A4),D2
02:0003BE4E 41EC03E4        	  5026:     lea     ($03E4,A4),A0
02:0003BE52 10302000        	  5027:     move.b  (A0,D2.W),D0
02:0003BE56 6724            	  5028:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5029:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5030:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5031:     ; The right side is correctly the right side of a closed hand.
                            	  5032:     ; But the left side is Keese. So, we have to patch the left
                            	  5033:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5034:     ;
                            	  5035:     ; Keep in mind that left and right sprites might be flipped.
                            	  5036:     ;
02:0003BE58 7600            	  5037:     moveq   #0,D3
02:0003BE5A 1614            	  5038:     move.b  ($0000,A4),D3
02:0003BE5C 41EC0201        	  5039:     lea     ($0201,A4),A0
02:0003BE60 10303000        	  5040:     move.b  (A0,D3.W),D0
02:0003BE64 0C00009C        	  5041:     cmpi.b  #$9C,D0
02:0003BE68 6706            	  5042:     beq  _anon_z04_68
02:0003BE6A 7600            	  5043:     moveq   #0,D3
02:0003BE6C 162C0001        	  5044:     move.b  ($0001,A4),D3
                            	  5045: _anon_z04_68:
