02:00033A96 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033A9A 41EC0630        	   565:     lea     ($0630,A4),A0
02:00033A9E 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00033AA2 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00033AA6 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00033AAA 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
