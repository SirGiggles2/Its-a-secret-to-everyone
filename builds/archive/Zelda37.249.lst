02:0003B3AA 661E            	  3494:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B3AC 7006            	  3495:     moveq   #6,D0
02:0003B3AE 41EC03D0        	  3496:     lea     ($03D0,A4),A0
02:0003B3B2 11802000        	  3497:     move.b  D0,(A0,D2.W)
                            	  3498:     ; There are actually 6 frame images divided into 2 sets.
                            	  3499:     ; Each set depicts one animation frame. In each set there are
                            	  3500:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3501:     ;
                            	  3502:     ; The movement frame will keep track of the base offset of
                            	  3503:     ; the current set for the current animation frame: 0 or 3.
                            	  3504:     ;
                            	  3505:     ; So, XOR the movement frame with 3.
                            	  3506:     ;
02:0003B3B6 E208            	  3507:     lsr.b  #1,D0   ; LSR A
02:0003B3B8 41EC03E4        	  3508:     lea     ($03E4,A4),A0
02:0003B3BC 12302000        	  3509:     move.b  (A0,D2.W),D1
02:0003B3C0 B300            	  3510:     eor.b  D1,D0
02:0003B3C2 41EC03E4        	  3511:     lea     ($03E4,A4),A0
02:0003B3C6 11802000        	  3512:     move.b  D0,(A0,D2.W)
                            	  3513:     even
                            	  3514: _L_z04_UpdateOctorock_CalcFinalOffset:
