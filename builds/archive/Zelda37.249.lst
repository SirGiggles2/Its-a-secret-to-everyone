                            	  7592: _L_z04_UpdatePolsVoice_State0:
                            	  7593:     ; State 0. Walking.
                            	  7594:     ;
                            	  7595:     ; If grid offset = 0, then no more distance to cover.
                            	  7596:     ; So, go change to state 1 -- jumping.
                            	  7597:     ;
02:0003D0E4 41EC0394        	  7598:     lea     ($0394,A4),A0
02:0003D0E8 10302000        	  7599:     move.b  (A0,D2.W),D0
02:0003D0EC 67000084        	  7600:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7601:     ; Decrement grid offset / distance remaining.
                            	  7602:     ;
02:0003D0F0 41EC0394        	  7603:     lea     ($0394,A4),A0
02:0003D0F4 53302000        	  7604:     subq.b  #1,(A0,D2.W)
                            	  7605:     ; Move vertically.
                            	  7606:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7607:     ;
02:0003D0F8 41EC0084        	  7608:     lea     ($0084,A4),A0
02:0003D0FC 10302000        	  7609:     move.b  (A0,D2.W),D0
02:0003D100 023C00EE        	  7610:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D104 41F90003D094    	  7611:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003D10A 12303000        	  7612:     move.b  (A0,D3.W),D1
02:0003D10E D101            	  7613:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003D110 41EC0084        	  7614:     lea     ($0084,A4),A0
