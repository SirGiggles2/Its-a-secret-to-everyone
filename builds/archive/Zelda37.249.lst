02:0003B3D0 41EC03E4        	  3519:     lea     ($03E4,A4),A0
02:0003B3D4 12302000        	  3520:     move.b  (A0,D2.W),D1
02:0003B3D8 D101            	  3521:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B3DA 1B00            	  3522:     move.b  D0,-(A5)  ; PHA
