                            	  4708: _anon_z02_34:
02:000367F4 41F900FF6B7E    	  4709:     lea     (NES_SRAM+$0B7E).l,A0
02:000367FA 10303000        	  4710:     move.b  (A0,D3.W),D0
02:000367FE 41EC0302        	  4711:     lea     ($0302,A4),A0
02:00036802 11803000        	  4712:     move.b  D0,(A0,D3.W)
02:00036806 5303            	  4713:     subq.b  #1,D3
02:00036808 6AEA            	  4714:     bpl  _anon_z02_34
                            	  4715:     ; Use (timer MOD 4) as an index to look up a color.
                            	  4716:     ;
