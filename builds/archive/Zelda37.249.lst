                            	 12532: ;
                            	 12533:     even
                            	 12534: Ganon_DrawCloud:
02:0003F5B6 1014            	 12535:     move.b  ($0000,A4),D0
02:0003F5B8 1B00            	 12536:     move.b  D0,-(A5)  ; PHA
02:0003F5BA 102C0001        	 12537:     move.b  ($0001,A4),D0
02:0003F5BE 1B00            	 12538:     move.b  D0,-(A5)  ; PHA
                            	 12539:     ; If cloud distance < 6, then use frame image $C (medium).
