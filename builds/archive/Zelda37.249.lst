                            	  4087: PlayerScreenEdgeBounds:
02:0004BA60 3D              	  4088:     dc.b    $3D, $DD, $00, $F0
02:0004BA61 DD
02:0004BA62 00
02:0004BA63 F0
                            	  4089: 
                            	  4090: ; Params:
                            	  4091: ; [0E]: $FF, if blocked by a door
                            	  4092: ; [0F]: movement direction
                            	  4093: ;
                            	  4094: ; Returns:
                            	  4095: ; [0F]: untouched, or changed if blocked or need to change
                            	  4096: ;
                            	  4097: ; Summary:
                            	  4098: ;
                            	  4099: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4100: ; Then allow movement or go to the next room. Otherwise,
                            	  4101: ; check passive tile objects and stop moving.
                            	  4102: ;
                            	  4103: ; For other objects: First, if moving, test the colliding tile for
                            	  4104: ; walkability. Otherwise search for a walkable direction starting
                            	  4105: ; from input direction.
                            	  4106: ;
                            	  4107: ; When you find a walkable direction, see if it makes the object
                            	  4108: ; cross a boundary. If it doesn't, then make this direction
                            	  4109: ; the objection direction. Otherwise, keep looping.
                            	  4110: ;
                            	  4111: ; If no walkable direction is found, then stop moving.
                            	  4112: ;
                            	  4113: ;
                            	  4114: ; if is player
                            	  4115: ;   if at doorway
                            	  4116: ;     go handle a walkable direction
                            	  4117: ;   if blocked by door
                            	  4118: ;     return
                            	  4119: ;
                            	  4120:     even
                            	  4121: Walker_CheckTileCollision:
                            	  4122:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4123:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4124:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4125:     ; reset) for Link and every other object. Only the tile
                            	  4126:     ; walkability decision in CheckTiles is overridden.
02:0004BA64 4A02            	  4127:     cmpi.b  #$00,D2
02:0004BA66 6614            	  4128:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004BA68 102C0053        	  4129:     move.b  ($0053,A4),D0
02:0004BA6C 6704            	  4130:     beq  _anon_z07_16
02:0004BA6E 600000BE        	  4131:     jmp     GoWalkableDir
                            	  4132: 
