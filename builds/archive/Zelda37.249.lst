                            	   714: UpdateBlock0Idle:
                            	   715:     ; If there are monsters in the room, go reset the push timer and return.
                            	   716:     ;
02:00039FF0 102C034D        	   717:     move.b  ($034D,A4),D0
02:00039FF4 6604            	   718:     bne.s  __far_z_04_0005
02:00039FF6 600000DA        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:00039FFA 102C0070        	   725:     move.b  ($0070,A4),D0
02:00039FFE 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:0003A002 B001            	   727:     cmp.b   D1,D0
02:0003A004 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:0003A006 7600            	   729:     moveq   #0,D3
02:0003A008 102C0084        	   730:     move.b  ($0084,A4),D0
02:0003A00C 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A010 123C0003        	   732:     move.b  #$03,D1
02:0003A014 D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003A016 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:0003A01A 41EC0084        	   735:     lea     ($0084,A4),A0
02:0003A01E 12302000        	   736:     move.b  (A0,D2.W),D1
02:0003A022 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A026 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:0003A028 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A02C 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:0003A02E 102C0084        	   747:     move.b  ($0084,A4),D0
02:0003A032 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A036 123C0003        	   749:     move.b  #$03,D1
02:0003A03A D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003A03C 41EC0084        	   751:     lea     ($0084,A4),A0
02:0003A040 12302000        	   752:     move.b  (A0,D2.W),D1
02:0003A044 B001            	   753:     cmp.b   D1,D0
02:0003A046 6704            	   754:     beq.s  __far_z_04_0006
02:0003A048 60000088        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:0003A04C 7602            	   760:     moveq   #2,D3
02:0003A04E 102C0070        	   761:     move.b  ($0070,A4),D0
02:0003A052 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:0003A056 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:0003A05A 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A05E 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:0003A060 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:0003A064 6A08            	   776:     bpl  _anon_z04_14
02:0003A066 5203            	   777:     addq.b  #1,D3
02:0003A068 4EB90003107C    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
                            	   780:     ; If the distance >= $11, then go reset the push timer and return.
                            	   781:     ;
02:0003A06E 0C000011        	   782:     cmpi.b  #$11,D0
02:0003A072 6502            	   783:     bcs.s  __far_z_04_0007
02:0003A074 605C            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:0003A076 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:0003A07A 41F900039FCE    	   792:     lea     (BlockPushDirections).l,A0
02:0003A080 12303000        	   793:     move.b  (A0,D3.W),D1
02:0003A084 B001            	   794:     cmp.b   D1,D0
02:0003A086 6702            	   795:     beq.s  __far_z_04_0008
02:0003A088 6048            	   796:     jmp  ResetPushTimer
                            	   797: __far_z_04_0008:
                            	   798:     ; Link is truly pushing the block.
                            	   799:     ;
                            	   800:     ; Increase the push timer.
                            	   801:     ;
02:0003A08A 41EC0412        	   802:     lea     ($0412,A4),A0
02:0003A08E 52302000        	   803:     addq.b  #1,(A0,D2.W)
                            	   804:     ; If the push timer still < $10, return.
                            	   805:     ;
02:0003A092 7600            	   806:     moveq   #0,D3
02:0003A094 41EC0412        	   807:     lea     ($0412,A4),A0
02:0003A098 16302000        	   808:     move.b  (A0,D2.W),D3
02:0003A09C 0C030010        	   809:     cmpi.b  #$10,D3
02:0003A0A0 6402            	   810:     bcc.s  __far_z_04_0009
02:0003A0A2 6034            	   811:     jmp  L10262_Exit
