                            	 12694: Ganon_DrawBody:
                            	 12695:     ; Loop over four 16x16 images that make up Ganon.
                            	 12696:     ; There are 6 animation frames.
                            	 12697:     ;
02:0003F700 7603            	 12698:     moveq   #3,D3
                            	 12699:     even
                            	 12700: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12701:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12702:     ;
02:0003F702 10342070        	 12703:     move.b  ($70,A4,D2.W),D0
02:0003F706 023C00EE        	 12704:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F70A 41F90003F6F4    	 12705:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F710 12303000        	 12706:     move.b  (A0,D3.W),D1
02:0003F714 D101            	 12707:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F716 1880            	 12708:     move.b  D0,($0000,A4)
                            	 12709:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12710:     ;
02:0003F718 41EC0084        	 12711:     lea     ($0084,A4),A0
02:0003F71C 10302000        	 12712:     move.b  (A0,D2.W),D0
02:0003F720 023C00EE        	 12713:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F724 41F90003F6F8    	 12714:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F72A 12303000        	 12715:     move.b  (A0,D3.W),D1
02:0003F72E D101            	 12716:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F730 19400001        	 12717:     move.b  D0,($0001,A4)
                            	 12718:     ; Each part has a horizontal flipping flag.
                            	 12719:     ;
02:0003F734 41F90003F6FC    	 12720:     lea     (GanonSpriteHFlips).l,A0
02:0003F73A 10303000        	 12721:     move.b  (A0,D3.W),D0
02:0003F73E 1940000F        	 12722:     move.b  D0,($000F,A4)
                            	 12723:     ; Save and copy the loop index (the current part) to [07].
                            	 12724:     ;
02:0003F742 1003            	 12725:     move.b  D3,D0
02:0003F744 1B00            	 12726:     move.b  D0,-(A5)  ; PHA
02:0003F746 19400007        	 12727:     move.b  D0,($0007,A4)
                            	 12728:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12729:     ; that make it up.
                            	 12730:     ;
02:0003F74A 41EC046B        	 12731:     lea     ($046B,A4),A0
02:0003F74E 10302000        	 12732:     move.b  (A0,D2.W),D0
02:0003F752 E308            	 12733:     lsl.b  #1,D0   ; ASL A
02:0003F754 E308            	 12734:     lsl.b  #1,D0   ; ASL A
                            	 12735:     ; Add [07] -- the index of the current part.
                            	 12736:     ;
                            	 12737:     ; Now you have an index into the frame image table, for the
                            	 12738:     ; current image part of the current animation frame.
                            	 12739:     ;
02:0003F756 122C0007        	 12740:     move.b  ($0007,A4),D1
02:0003F75A D101            	 12741:     addx.b  D1,D0   ; ADC $07
02:0003F75C 7600            	 12742:     moveq   #0,D3
02:0003F75E 1600            	 12743:     move.b  D0,D3
02:0003F760 41F90003F6DC    	 12744:     lea     (GanonFrameImages).l,A0
02:0003F766 10303000        	 12745:     move.b  (A0,D3.W),D0
02:0003F76A 4EB900031BCC    	 12746:     jsr     DrawObjectNotMirrored
02:0003F770 101D            	 12747:     move.b  (A5)+,D0  ; PLA
                            	 12748:     ; Bottom of the part loop.
                            	 12749:     ;
02:0003F772 7600            	 12750:     moveq   #0,D3
02:0003F774 1600            	 12751:     move.b  D0,D3
02:0003F776 5303            	 12752:     subq.b  #1,D3
02:0003F778 6A88            	 12753:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F77A 4E75            	 12754:     rts
                            	 12755: 
