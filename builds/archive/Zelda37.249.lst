02:0003F254 41EC0098        	 12033:     lea     ($0098,A4),A0
02:0003F258 11802000        	 12034:     move.b  D0,(A0,D2.W)
                            	 12035:     ; Set angle $18 (N).
                            	 12036:     ;
02:0003F25C 7018            	 12037:     moveq   #24,D0
02:0003F25E 41EC0394        	 12038:     lea     ($0394,A4),A0
02:0003F262 11802000        	 12039:     move.b  D0,(A0,D2.W)
                            	 12040:     ; This location is right above Patra.
                            	 12041:     ; Set X coordinate to Patra's.
                            	 12042:     ;
