                            	  1820: UpdateStatues:
                            	  1821:     ; If person fireballs are enabled (from the two fires), then
                            	  1822:     ; go make fireballs with pattern 2.
                            	  1823:     ;
02:0003A7F8 7602            	  1824:     moveq   #2,D3
02:0003A7FA 102C04CC        	  1825:     move.b  ($04CC,A4),D0
02:0003A7FE 6620            	  1826:     bne  _L_z04_UpdateStatues_Shoot
                            	  1827:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1828:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1829:     ; - layout $23: pattern 1: 2 statues
                            	  1830:     ; - layout $24: pattern 0: 4 statues
                            	  1831:     ;
02:0003A800 4EB90004AD82    	  1832:     jsr     GetUniqueRoomId
02:0003A806 7601            	  1833:     moveq   #1,D3
                            	  1834: _anon_z04_30:
02:0003A808 41F90003A7DA    	  1835:     lea     (StatueRoomLayouts).l,A0
02:0003A80E 12303000        	  1836:     move.b  (A0,D3.W),D1
02:0003A812 B001            	  1837:     cmp.b   D1,D0
02:0003A814 670A            	  1838:     beq  _L_z04_UpdateStatues_Shoot
02:0003A816 5303            	  1839:     subq.b  #1,D3
02:0003A818 6AEE            	  1840:     bpl  _anon_z04_30
02:0003A81A 0A3C0001        	  1841:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A81E 4E75            	  1842:     rts
