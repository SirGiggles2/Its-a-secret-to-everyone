                            	  8712:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8713:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8714:     ; map mark tile.
                            	  8715:     ;
02:0004528A 7013            	  8716:     moveq   #19,D0
02:0004528C 1940033F        	  8717:     move.b  D0,($033F,A4)
                            	  8718:     ; Get the currently scanned room's visit state.
                            	  8719:     ;
02:00045290 7600            	  8720:     moveq   #0,D3
02:00045292 162C00EB        	  8721:     move.b  ($00EB,A4),D3
02:00045296 1214            	  8722:     move.b  ($00,A4),D1   ; ptr lo
02:00045298 182C0001        	  8723:     move.b  ($01,A4),D4  ; ptr hi
02:0004529C 024100FF        	  8724:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000452A0 E14C            	  8725:     lsl.w   #8,D4
02:000452A2 8841            	  8726:     or.w    D1,D4             ; D4 = NES ptr addr
02:000452A4 48C4            	  8727:     ext.l   D4
