02:0004217C 12303000        	  4028:     move.b  (A0,D3.W),D1
02:00042180 B001            	  4029:     cmp.b   D1,D0
02:00042182 6510            	  4030:     bcs  _anon_z05_95
02:00042184 41F900042146    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:0004218A 12303000        	  4032:     move.b  (A0,D3.W),D1
02:0004218E B001            	  4033:     cmp.b   D1,D0
02:00042190 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
