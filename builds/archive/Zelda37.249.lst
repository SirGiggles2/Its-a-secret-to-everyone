                            	  1845: _L_z04_UpdateStatues_Shoot:
                            	  1846:     ; Look for an empty monster slot.
                            	  1847:     ; If none is found, return.
                            	  1848:     ;
                            	  1849:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1850:     ; object. This routine takes a shooter object, and instantiates
                            	  1851:     ; a fireball object at the shooter's location.
                            	  1852:     ;
                            	  1853:     ; The object slot we set up here will behave as the shooter.
                            	  1854:     ; For each fireball index, this object slot will have its coordinates
                            	  1855:     ; changed.
                            	  1856:     ;
                            	  1857:     ; Note that this means that:
                            	  1858:     ; 1. The first fireball made will be its own shooter.
                            	  1859:     ;    Practically, there's nothing special about this.
                            	  1860:     ; 2. If there is more than one fireball made in a frame,
                            	  1861:     ;    then two of them will come from the same statue.
                            	  1862:     ;
                            	  1863:     ;
                            	  1864:     ; Save the fireball pattern.
02:0003A820 1003            	  1865:     move.b  D3,D0
02:0003A822 1B00            	  1866:     move.b  D0,-(A5)  ; PHA
02:0003A824 4EB90004D50C    	  1867:     jsr     FindEmptyMonsterSlot
02:0003A82A 0C000001        	  1868:     cmpi.b  #$01,D0
02:0003A82E 101D            	  1869:     move.b  (A5)+,D0  ; PLA
02:0003A830 6400010A        	  1870:     bcc  _L_z04_UpdateStatues_Exit
                            	  1871:     ; If we found a slot, but it < 6, return.
                            	  1872:     ;
02:0003A834 0C030006        	  1873:     cmpi.b  #$06,D3
02:0003A838 65000102        	  1874:     bcs  _L_z04_UpdateStatues_Exit
                            	  1875:     ; Store the object slot in [0A].
                            	  1876:     ; Store fireball pattern in [0B].
                            	  1877:     ;
02:0003A83C 1943000A        	  1878:     move.b  D3,($000A,A4)
02:0003A840 1940000B        	  1879:     move.b  D0,($000B,A4)
                            	  1880:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1881:     ;
02:0003A844 7600            	  1882:     moveq   #0,D3
02:0003A846 1600            	  1883:     move.b  D0,D3
02:0003A848 7400            	  1884:     moveq   #0,D2
02:0003A84A 41F90003A7DC    	  1885:     lea     (StatueFireballCounts).l,A0
02:0003A850 14303000        	  1886:     move.b  (A0,D3.W),D2
                            	  1887:     even
                            	  1888: _L_z04_UpdateStatues_LoopFireball:
                            	  1889:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1890:     ;
                            	  1891:     ; Decrement the fireball timer at this index.
                            	  1892:     ;
02:0003A854 7600            	  1893:     moveq   #0,D3
02:0003A856 41EC04E8        	  1894:     lea     ($04E8,A4),A0
02:0003A85A 16302000        	  1895:     move.b  (A0,D2.W),D3
02:0003A85E 5303            	  1896:     subq.b  #1,D3
02:0003A860 1003            	  1897:     move.b  D3,D0
02:0003A862 41EC04E8        	  1898:     lea     ($04E8,A4),A0
02:0003A866 11802000        	  1899:     move.b  D0,(A0,D2.W)
                            	  1900:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1901:     ; to make a fireball. Go loop again.
                            	  1902:     ;
02:0003A86A 5203            	  1903:     addq.b  #1,D3
02:0003A86C 660000C8        	  1904:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1905:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1906:     ; This fireball index will wait another $100 frames.
                            	  1907:     ;
02:0003A870 10342018        	  1908:     move.b  ($18,A4,D2.W),D0
02:0003A874 0C0000F0        	  1909:     cmpi.b  #$F0,D0
02:0003A878 640000BC        	  1910:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1911:     ; Else choose one of four start times for the fireball based on
                            	  1912:     ; the random value.
                            	  1913:     ;
02:0003A87C 02000003        	  1914:     andi.b #$03,D0
02:0003A880 7600            	  1915:     moveq   #0,D3
02:0003A882 1600            	  1916:     move.b  D0,D3
02:0003A884 41F90003A7E0    	  1917:     lea     (StatueFireballStartTimes).l,A0
02:0003A88A 10303000        	  1918:     move.b  (A0,D3.W),D0
02:0003A88E 41EC04E8        	  1919:     lea     ($04E8,A4),A0
02:0003A892 11802000        	  1920:     move.b  D0,(A0,D2.W)
                            	  1921:     ; The coordinate lists are divided into sets for each pattern.
                            	  1922:     ;
                            	  1923:     ; Look up the index of the base of the set for the pattern in use.
                            	  1924:     ; Add it to the fireball index in X register to get the index of
                            	  1925:     ; the coordinate we want within each coordinate list.
                            	  1926:     ;
                            	  1927:     ;
                            	  1928:     ; Pattern
02:0003A896 7600            	  1929:     moveq   #0,D3
02:0003A898 162C000B        	  1930:     move.b  ($000B,A4),D3
02:0003A89C 1002            	  1931:     move.b  D2,D0
02:0003A89E 023C00EE        	  1932:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8A2 41F90003A7E4    	  1933:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A8A8 12303000        	  1934:     move.b  (A0,D3.W),D1
02:0003A8AC D101            	  1935:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A8AE 7600            	  1936:     moveq   #0,D3
02:0003A8B0 1600            	  1937:     move.b  D0,D3
02:0003A8B2 1002            	  1938:     move.b  D2,D0
02:0003A8B4 1B00            	  1939:     move.b  D0,-(A5)  ; PHA
                            	  1940:     ; Get Link's coordinates into [00] and [01].
                            	  1941:     ;
02:0003A8B6 7400            	  1942:     moveq   #0,D2
02:0003A8B8 4EB90004CD24    	  1943:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1944:     ; Switch to the new fireball's object slot.
                            	  1945:     ;
02:0003A8BE 7400            	  1946:     moveq   #0,D2
02:0003A8C0 142C000A        	  1947:     move.b  ($000A,A4),D2
                            	  1948:     ; Look up and set the X coordinate for the fireball object.
                            	  1949:     ; Also store it in [02].
                            	  1950:     ;
02:0003A8C4 41F90003A7E8    	  1951:     lea     (StatueXs).l,A0
02:0003A8CA 10303000        	  1952:     move.b  (A0,D3.W),D0
02:0003A8CE 19400002        	  1953:     move.b  D0,($0002,A4)
02:0003A8D2 19802070        	  1954:     move.b  D0,($70,A4,D2.W)
                            	  1955:     ; Look up and set the Y coordinate for the fireball object.
                            	  1956:     ; Also store it in [03].
                            	  1957:     ;
