02:0004BA7C 41EC0394        	  4142:     lea     ($0394,A4),A0
02:0004BA80 10302000        	  4143:     move.b  (A0,D2.W),D0
02:0004BA84 6704            	  4144:     beq.s  __far_z_07_0048
02:0004BA86 6000009E        	  4145:     jmp  L1F148_Exit
                            	  4146: __far_z_07_0048:
                            	  4147:     ; Grid offset = 0.
                            	  4148:     ; The object is at a point between cells in the grid.
                            	  4149:     ; So, we can check tiles for collision.
                            	  4150:     ;
                            	  4151:     ; Reset [0E] alternate direction search step.
                            	  4152:     ;
02:0004BA8A 1940000E        	  4153:     move.b  D0,($000E,A4)
                            	  4154:     ; If there's a movement direction, go check tile collision.
                            	  4155:     ;
02:0004BA8E 102C000F        	  4156:     move.b  ($000F,A4),D0
02:0004BA92 6702            	  4157:     beq.s  __far_z_07_0049
02:0004BA94 602E            	  4158:     jmp  CheckTiles
