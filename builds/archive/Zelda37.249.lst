02:0004046C 41F9000403DA    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:00040472 10303000        	   605:     move.b  (A0,D3.W),D0
02:00040476 6004            	   606:     jmp     _anon_z05_7
