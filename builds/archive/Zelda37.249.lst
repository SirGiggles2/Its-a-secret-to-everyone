02:00036826 19400600        	  4736:     move.b  D0,($0600,A4)
                            	  4737:     ; Wait $40 frames at the beginning of the next mode
                            	  4738:     ; before showing text.
                            	  4739:     ;
02:0003682A 7040            	  4740:     moveq   #64,D0
02:0003682C 19400028        	  4741:     move.b  D0,($0028,A4)
                            	  4742:     ; Set a long timer of $40 ($280 frames) for the whole duration
                            	  4743:     ; of the next submode.
                            	  4744:     ;
