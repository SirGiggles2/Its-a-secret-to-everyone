                            	   848: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   849:     ; The index chooses the low VRAM address of the start
                            	   850:     ; of another line:
                            	   851:     ;   0: $C4: front of the second line
                            	   852:     ;   1: $E4: front of the third line
                            	   853:     ;   2: $A4: front of the first line
                            	   854:     ;
                            	   855:     ; Look up the low VRAM address and store it.
                            	   856:     ;
02:0002E93A 41F90002E868    	   857:     lea     (TextboxLineAddrsLo).l,A0
02:0002E940 10303000        	   858:     move.b  (A0,D3.W),D0
02:0002E944 1940045F        	   859:     move.b  D0,($045F,A4)
                            	   860:     ; If index = 2, then we've reached the end of the text,
                            	   861:     ; and low VRAM address is moved to the front of the first line.
                            	   862:     ; So, advance the state of the person object, and unhalt Link.
                            	   863:     ;
02:0002E948 0C030002        	   864:     cmpi.b  #$02,D3
02:0002E94C 6608            	   865:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E94E 522C00AD        	   866:     addq.b  #1,($00AD,A4)
02:0002E952 6100FB98        	   867:     jsr     UnhaltLink
                            	   868:     even
