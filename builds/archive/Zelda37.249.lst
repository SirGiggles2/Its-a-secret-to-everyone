02:00041A2E 4EB900031074    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
02:00041A34 102C0010        	  2914:     move.b  ($0010,A4),D0
02:00041A38 6710            	  2915:     beq  _anon_z05_76
02:00041A3A 1003            	  2916:     move.b  D3,D0
02:00041A3C 023C00EE        	  2917:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A40 123C0004        	  2918:     move.b  #$04,D1
02:00041A44 D101            	  2919:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00041A46 7600            	  2920:     moveq   #0,D3
02:00041A48 1600            	  2921:     move.b  D0,D3
                            	  2922: _anon_z05_76:
                            	  2923:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2924:     ;
02:00041A4A 7000            	  2925:     moveq   #0,D0
                            	  2926: ; Params:
                            	  2927: ; A: mask of buttons to block
                            	  2928: ; Y: offset into BorderBounds
                            	  2929: ; [00]: direction
                            	  2930: ; [02]: coordinate
                            	  2931: ;
                            	  2932: ; Returns:
                            	  2933: ; [01]: button mask that was used
                            	  2934: ;       (set to $FF if boundary not crossed)
                            	  2935: ;
                            	  2936:     even
                            	  2937: MaskInputInBorder:
