02:0003F630 1880            	 12591:     move.b  D0,($0000,A4)
02:0003F632 6100009C        	 12592:     jsr     Ganon_GetCurCloudTop
02:0003F636 6100FF7E        	 12593:     jsr     Ganon_DrawCloud
02:0003F63A 6100009A        	 12594:     jsr     Ganon_GetCurCloudBottom
02:0003F63E 6100FF76        	 12595:     jsr     Ganon_DrawCloud
                            	 12596:     ; Draw the left and right clouds.
                            	 12597:     ;
02:0003F642 61000080        	 12598:     jsr     Ganon_GetCurCloudLeft
02:0003F646 41EC0084        	 12599:     lea     ($0084,A4),A0
02:0003F64A 10302000        	 12600:     move.b  (A0,D2.W),D0
02:0003F64E 19400001        	 12601:     move.b  D0,($0001,A4)
02:0003F652 6100FF62        	 12602:     jsr     Ganon_DrawCloud
02:0003F656 6172            	 12603:     jsr     Ganon_GetCurCloudRight
02:0003F658 6100FF5C        	 12604:     jsr     Ganon_DrawCloud
                            	 12605:     ; Save the object index.
                            	 12606:     ;
02:0003F65C 102C0340        	 12607:     move.b  ($0340,A4),D0
02:0003F660 1B00            	 12608:     move.b  D0,-(A5)  ; PHA
                            	 12609:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12610:     ;
02:0003F662 7402            	 12611:     moveq   #2,D2
                            	 12612:     even
                            	 12613: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F664 19420340        	 12614:     move.b  D2,($0340,A4)
                            	 12615:     ; If object slot < 5 or = 7, then move every frame.
                            	 12616:     ; Else move 3 out of every 4 frames.
                            	 12617:     ;
                            	 12618:     ; This makes pieces spread out in somewhat of a circle,
                            	 12619:     ; by making the pieces at cardinal directions move at
                            	 12620:     ; full speed while the diagonal ones move a little slower.
                            	 12621:     ;
02:0003F668 0C020005        	 12622:     cmpi.b  #$05,D2
02:0003F66C 6510            	 12623:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F66E 0C020007        	 12624:     cmpi.b  #$07,D2
02:0003F672 670A            	 12625:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F674 102C0015        	 12626:     move.b  ($0015,A4),D0
02:0003F678 02000003        	 12627:     andi.b #$03,D0
02:0003F67C 6704            	 12628:     beq  _anon_z04_164
                            	 12629:     even
                            	 12630: _L_z04_Ganon_DrawBurst_Move:
02:0003F67E 6100E036        	 12631:     jsr     BlueWizzrobe_Move
                            	 12632: _anon_z04_164:
02:0003F682 4EB90004CD24    	 12633:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12634:     ; The frame counter will make the sprite flash.
                            	 12635:     ; The array has the horizontal and vertical flipping attributes.
                            	 12636:     ; Combine them into [03].
                            	 12637:     ;
02:0003F688 102C0015        	 12638:     move.b  ($0015,A4),D0
02:0003F68C 02000003        	 12639:     andi.b #$03,D0
02:0003F690 41F90003F560    	 12640:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F696 12302000        	 12641:     move.b  (A0,D2.W),D1
02:0003F69A 8001            	 12642:     or.b  D1,D0
02:0003F69C 19400003        	 12643:     move.b  D0,($0003,A4)
02:0003F6A0 41F90003F56A    	 12644:     lea     (GanonBurstTiles).l,A0
02:0003F6A6 10302000        	 12645:     move.b  (A0,D2.W),D0
02:0003F6AA 4EB900031EC8    	 12646:     jsr     Anim_WriteSprite
                            	 12647:     ; Bottom of the loop.
                            	 12648:     ; Increment object slot while <= 9.
                            	 12649:     ;
02:0003F6B0 5202            	 12650:     addq.b  #1,D2
02:0003F6B2 0C02000A        	 12651:     cmpi.b  #$0A,D2
02:0003F6B6 65AC            	 12652:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12653:     ; Restore the object index.
                            	 12654:     ;
02:0003F6B8 101D            	 12655:     move.b  (A5)+,D0  ; PLA
02:0003F6BA 19400340        	 12656:     move.b  D0,($0340,A4)
02:0003F6BE 0A3C0001        	 12657:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F6C2 4E75            	 12658:     rts
                            	 12659: 
