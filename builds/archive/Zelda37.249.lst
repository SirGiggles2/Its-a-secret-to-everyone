                            	 12252: ;
                            	 12253:     even
                            	 12254: Ganon_ScenePhase1:
02:0003F3E8 701B            	 12255:     moveq   #27,D0
02:0003F3EA 19400505        	 12256:     move.b  D0,($0505,A4)
                            	 12257:     ; If Link's timer hasn't expired, then go draw Ganon.
