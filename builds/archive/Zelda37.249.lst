02:0003D1C4 023C00EE        	  7709:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D1C8 41F90003D0A6    	  7710:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003D1CE 12303000        	  7711:     move.b  (A0,D3.W),D1
02:0003D1D2 D101            	  7712:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003D1D4 41EC042C        	  7713:     lea     ($042C,A4),A0
02:0003D1D8 11802000        	  7714:     move.b  D0,(A0,D2.W)
