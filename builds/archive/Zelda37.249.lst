02:0003FA04 6716            	 13103:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	 13104:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	 13105:     ; But there is a random chance that the item drop will be canceled.
                            	 13106:     ;
02:0003FA06 102C0050        	 13107:     move.b  ($0050,A4),D0
