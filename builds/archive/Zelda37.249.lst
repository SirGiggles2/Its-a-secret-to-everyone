                            	  8164:     ; Timer = 0. Only teleporting now.
                            	  8165:     ;
                            	  8166:     ; If there is still distance to go while translucent, then
                            	  8167:     ; decrement the distance remaining, and move.
                            	  8168:     ;
02:0003D582 41EC0394        	  8169:     lea     ($0394,A4),A0
02:0003D586 10302000        	  8170:     move.b  (A0,D2.W),D0
02:0003D58A 670A            	  8171:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003D58C 41EC0394        	  8172:     lea     ($0394,A4),A0
02:0003D590 53302000        	  8173:     subq.b  #1,(A0,D2.W)
02:0003D594 602A            	  8174:     jmp     BlueWizzrobe_MoveAndCheckTile
                            	  8175: 
                            	  8176:     even
                            	  8177: _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain:
                            	  8178:     ; Distance remaining = 0. Still teleporting.
                            	  8179:     ;
02:0003D596 6100021A        	  8180:     jsr     BlueWizzrobe_AlignWithNearestSquareAndRandomizeTimer
02:0003D59A 600000B0        	  8181:     jmp     BlueWizzrobe_TurnTowardLink
                            	  8182: 
                            	  8183:     even
                            	  8184: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  8185:     ; Timer:
                            	  8186:     ;   >= $10: Turn if needed and move every other frame
                            	  8187:     ;   > 1:    Do nothing
                            	  8188:     ;   = 1:    Choose a place to teleport to.
                            	  8189:     ;
                            	  8190:     ; Notice that walking is slower than teleporting; and there is
                            	  8191:     ; a pause of $10 frames at the end.
                            	  8192:     ;
02:0003D59E 0C000010        	  8193:     cmpi.b  #$10,D0
02:0003D5A2 6502            	  8194:     bcs.s  __far_z_04_0072
02:0003D5A4 600E            	  8195:     jmp  GoEveryOtherFrame
