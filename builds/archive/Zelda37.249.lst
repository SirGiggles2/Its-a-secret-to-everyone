                            	  3906: UpdatePondFairy:
02:0003B63A 610045AC        	  3907:     jsr     DrawFairy
                            	  3908:     ; If not in state 0, then go handle states 1 to 3.
                            	  3909:     ;
02:0003B63E 102C00AD        	  3910:     move.b  ($00AD,A4),D0
02:0003B642 6702            	  3911:     beq.s  __far_z_04_0035
02:0003B644 602A            	  3912:     jmp  PondFairy_HandleOtherStates
                            	  3913: __far_z_04_0035:
                            	  3914:     ; State 0.
                            	  3915:     ;
                            	  3916:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3917:     ;
02:0003B646 102C0084        	  3918:     move.b  ($0084,A4),D0
02:0003B64A 0C0000AD        	  3919:     cmpi.b  #$AD,D0
02:0003B64E 661E            	  3920:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3921:     ; If Link's X < $70 or >= $81, then return.
                            	  3922:     ;
02:0003B650 102C0070        	  3923:     move.b  ($0070,A4),D0
02:0003B654 0C000070        	  3924:     cmpi.b  #$70,D0
02:0003B658 6514            	  3925:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B65A 0C000081        	  3926:     cmpi.b  #$81,D0
02:0003B65E 640E            	  3927:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3928:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3929:     ; halt Link, and start filling hearts.
                            	  3930:     ;
02:0003B660 522C00AD        	  3931:     addq.b  #1,($00AD,A4)
02:0003B664 7040            	  3932:     moveq   #64,D0
02:0003B666 194000AC        	  3933:     move.b  D0,($00AC,A4)
02:0003B66A 19400063        	  3934:     move.b  D0,($0063,A4)
                            	  3935:     even
                            	  3936: _L_z04_UpdatePondFairy_Exit:
02:0003B66E 4E75            	  3937:     rts
                            	  3938: 
                            	  3939:     even
                            	  3940: PondFairy_HandleOtherStates:
02:0003B670 0C000001        	  3941:     cmpi.b  #$01,D0
02:0003B674 6610            	  3942:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3943:     ; State 1. Flying and filling hearts.
                            	  3944:     ;
                            	  3945:     ; If still filling hearts, then go draw Link and hearts.
                            	  3946:     ;
02:0003B676 102C0063        	  3947:     move.b  ($0063,A4),D0
02:0003B67A 6620            	  3948:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3949:     ; If not filling hearts anymore, then go to state 2,
                            	  3950:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3951:     ; a little while after we finish filling hearts.
                            	  3952:     ;
02:0003B67C 522C00AD        	  3953:     addq.b  #1,($00AD,A4)
02:0003B680 7050            	  3954:     moveq   #80,D0
02:0003B682 19400029        	  3955:     move.b  D0,($0029,A4)
                            	  3956:     even
                            	  3957: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3958:     ; If state <> 2 (so, it's 3), then return.
                            	  3959:     ;
                            	  3960:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3961:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3962:     ; was set to, and we'll return.
                            	  3963:     ;
02:0003B686 0C000002        	  3964:     cmpi.b  #$02,D0
02:0003B68A 6634            	  3965:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3966:     ; State = 2.
                            	  3967:     ;
                            	  3968:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3969:     ;
02:0003B68C 102C0029        	  3970:     move.b  ($0029,A4),D0
02:0003B690 660A            	  3971:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3972:     ; Else go to state 3, and unhalt Link.
                            	  3973:     ;
