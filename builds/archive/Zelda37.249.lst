                            	  7380: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7381:     ; Start preparing sprites.
                            	  7382:     ;
02:0003CF58 4EB90004CD24    	  7383:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CF5E 1003            	  7384:     move.b  D3,D0
02:0003CF60 1B00            	  7385:     move.b  D0,-(A5)  ; PHA
                            	  7386:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7387:     ;
02:0003CF62 41F90003CEBC    	  7388:     lea     (DodongoFrameHFlips).l,A0
02:0003CF68 10303000        	  7389:     move.b  (A0,D3.W),D0
02:0003CF6C 1940000F        	  7390:     move.b  D0,($000F,A4)
02:0003CF70 41F90003CEB2    	  7391:     lea     (DodongoFrameImages).l,A0
02:0003CF76 10303000        	  7392:     move.b  (A0,D3.W),D0
                            	  7393:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7394:     ; They are drawn mirrored.
                            	  7395:     ;
02:0003CF7A 0C000007        	  7396:     cmpi.b  #$07,D0
02:0003CF7E 6706            	  7397:     beq  _anon_z04_92
02:0003CF80 0C000009        	  7398:     cmpi.b  #$09,D0
