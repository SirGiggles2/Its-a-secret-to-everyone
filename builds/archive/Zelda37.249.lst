02:00032244 122C000E        	  6575:     move.b  ($000E,A4),D1
02:00032248 0A3C0010        	  6576:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003224C 9101            	  6577:     subx.b  D1,D0   ; SBC $0E
02:0003224E 0A3C0010        	  6578:     eori    #$10,CCR  ; restore X = 6502 C
02:00032252 19400670        	  6579:     move.b  D0,($0670,A4)
                            	  6580:     ; If full hearts >= high damage points byte, then simply
