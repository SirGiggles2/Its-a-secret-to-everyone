                            	  6255: Digdogger_Move:
                            	  6256:     ; This calculation is the same one used in Manhandla to
                            	  6257:     ; manifest the fractional speed over several frames.
                            	  6258:     ;
                            	  6259:     ; To summarize, the formula is:
                            	  6260:     ;
                            	  6261:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6262:     ;
                            	  6263:     ;   SA := SA + (SL AND $E0)
                            	  6264:     ;   [03] := SH + carry
                            	  6265:     ;
                            	  6266:     ; See 04:A28E Manhandla_Move.
                            	  6267:     ;
02:0003C776 41EC041F        	  6268:     lea     ($041F,A4),A0
02:0003C77A 10302000        	  6269:     move.b  (A0,D2.W),D0
02:0003C77E 020000E0        	  6270:     andi.b #$E0,D0
02:0003C782 023C00EE        	  6271:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C786 41EC0412        	  6272:     lea     ($0412,A4),A0
02:0003C78A 12302000        	  6273:     move.b  (A0,D2.W),D1
02:0003C78E D101            	  6274:     addx.b  D1,D0   ; ADC $0412,X
02:0003C790 41EC0412        	  6275:     lea     ($0412,A4),A0
02:0003C794 11802000        	  6276:     move.b  D0,(A0,D2.W)
                            	  6277:     ; Assign (high speed byte + carry) to [03].
                            	  6278:     ;
02:0003C798 41EC042C        	  6279:     lea     ($042C,A4),A0
