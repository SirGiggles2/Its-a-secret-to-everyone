02:0003272E 6412            	  7403:     bcc  _anon_z01_99
02:00032730 41EC04B2        	  7404:     lea     ($04B2,A4),A0
02:00032734 10302000        	  7405:     move.b  (A0,D2.W),D0
02:00032738 122C0009        	  7406:     move.b  ($0009,A4),D1
02:0003273C C001            	  7407:     and.b  D1,D0
02:0003273E 660000C4        	  7408:     bne  _L_z01_BeginShove_Exit
                            	  7409: _anon_z01_99:
                            	  7410:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7411:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7412:     ;
                            	  7413:     ; If instead a monster is defending, then all this calculation
                            	  7414:     ; won't matter, because the shove direction will be set to the
                            	  7415:     ; weapon's direction.
                            	  7416:     ;
                            	  7417:     ; As such, calculate a direction from the monster to the defender,
                            	  7418:     ; assuming it's Link.
                            	  7419:     ;
                            	  7420:     ; Start with an assumption that the direction is vertical:
                            	  7421:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7422:     ;
02:00032742 7008            	  7423:     moveq   #8,D0
02:00032744 19400008        	  7424:     move.b  D0,($0008,A4)
02:00032748 41EC0084        	  7425:     lea     ($0084,A4),A0
02:0003274C 10302000        	  7426:     move.b  (A0,D2.W),D0
02:00032750 19400004        	  7427:     move.b  D0,($0004,A4)
02:00032754 41EC0084        	  7428:     lea     ($0084,A4),A0
02:00032758 10303000        	  7429:     move.b  (A0,D3.W),D0
02:0003275C 19400005        	  7430:     move.b  D0,($0005,A4)
                            	  7431:     ; If the defender is Link and his grid offset <> 0 then
                            	  7432:     ; use his usual object direction variable to determine
                            	  7433:     ; which axis to check.
                            	  7434:     ;
02:00032760 4A03            	  7435:     cmpi.b  #$00,D3
02:00032762 6612            	  7436:     bne  _anon_z01_100
02:00032764 102C0394        	  7437:     move.b  ($0394,A4),D0
02:00032768 670C            	  7438:     beq  _anon_z01_100
02:0003276A 102C0098        	  7439:     move.b  ($0098,A4),D0
02:0003276E 02000003        	  7440:     andi.b #$03,D0
02:00032772 660C            	  7441:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032774 6720            	  7442:     beq  _L_z01_BeginShove_CheckVertical
                            	  7443: _anon_z01_100:
                            	  7444:     ; For monsters defending, or Link with grid offset = 0,
                            	  7445:     ; check direction in [0B].
                            	  7446:     ;
                            	  7447:     ; For monsters defending, this won't matter. For Link with grid
                            	  7448:     ; offset = 0, I believe the result will be arbitrary.
                            	  7449:     ;
                            	  7450:     ; TODO:
                            	  7451:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7452:     ; It doesn't seem to be if candle fire attacks him.
                            	  7453:     ;
02:00032776 102C000B        	  7454:     move.b  ($000B,A4),D0
02:0003277A 0C000004        	  7455:     cmpi.b  #$04,D0
02:0003277E 6416            	  7456:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7457:     even
                            	  7458: _L_z01_BeginShove_CheckHorizontal:
                            	  7459:     ; If the direction checked is left or right,
                            	  7460:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7461:     ;
02:00032780 7002            	  7462:     moveq   #2,D0
02:00032782 19400008        	  7463:     move.b  D0,($0008,A4)
02:00032786 10342070        	  7464:     move.b  ($70,A4,D2.W),D0
02:0003278A 19400004        	  7465:     move.b  D0,($0004,A4)
02:0003278E 10343070        	  7466:     move.b  ($70,A4,D3.W),D0
02:00032792 19400005        	  7467:     move.b  D0,($0005,A4)
                            	  7468:     even
                            	  7469: _L_z01_BeginShove_CheckVertical:
                            	  7470:     ; If the monster is down or right of the other object,
                            	  7471:     ; then use the opposite direction already in [08].
                            	  7472:     ; Else shift [08] right to turn it into the opposite
                            	  7473:     ; direction up or down.
                            	  7474:     ;
                            	  7475:     ; Again assuming Link is the defender; after this, [08] points
                            	  7476:     ; Link away from the monster.
                            	  7477:     ;
02:00032796 102C0004        	  7478:     move.b  ($0004,A4),D0
02:0003279A 122C0005        	  7479:     move.b  ($0005,A4),D1
02:0003279E B001            	  7480:     cmp.b   D1,D0
02:000327A0 640A            	  7481:     bcc  _anon_z01_101
02:000327A2 122C0008        	  7482:     move.b  ($0008,A4),D1
02:000327A6 E209            	  7483:     lsr.b  #1,D1   ; LSR $08
02:000327A8 19410008        	  7484:     move.b  D1,($0008,A4)
                            	  7485: _anon_z01_101:
                            	  7486:     ; If a monster is the defender, go handle it separately.
                            	  7487:     ;
02:000327AC 4A03            	  7488:     cmpi.b  #$00,D3
02:000327AE 6656            	  7489:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7490:     ; Link is the defender.
                            	  7491:     ;
                            	  7492:     ; If Link is invincible, return without shoving.
                            	  7493:     ;
02:000327B0 102C04F0        	  7494:     move.b  ($04F0,A4),D0
02:000327B4 664E            	  7495:     bne  _L_z01_BeginShove_Exit
                            	  7496:     ; Store the shove direction we determined.
                            	  7497:     ;
                            	  7498:     ; Turn on the high bit to indicate that the next time we try to
                            	  7499:     ; move by shoving, it will be the first time for this shove action.
                            	  7500:     ;
02:000327B6 102C0008        	  7501:     move.b  ($0008,A4),D0
02:000327BA 00000080        	  7502:     ori.b #$80,D0
02:000327BE 194000C0        	  7503:     move.b  D0,($00C0,A4)
                            	  7504:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7505:     ;
02:000327C2 7018            	  7506:     moveq   #24,D0
02:000327C4 194004F0        	  7507:     move.b  D0,($04F0,A4)
02:000327C8 7020            	  7508:     moveq   #32,D0
02:000327CA 194000D3        	  7509:     move.b  D0,($00D3,A4)
                            	  7510:     ; If Link was shoved by one of his own weapons, then
                            	  7511:     ; nothing else to do. Return.
                            	  7512:     ;
02:000327CE 0C02000D        	  7513:     cmpi.b  #$0D,D2
02:000327D2 6430            	  7514:     bcc  _L_z01_BeginShove_Exit
                            	  7515:     ; Link was shoved by a monster.
                            	  7516:     ;
                            	  7517:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7518:     ; then return.
                            	  7519:     ;
02:000327D4 41EC04BF        	  7520:     lea     ($04BF,A4),A0
02:000327D8 10302000        	  7521:     move.b  (A0,D2.W),D0
02:000327DC 02000080        	  7522:     andi.b #$80,D0
02:000327E0 6622            	  7523:     bne  _L_z01_BeginShove_Exit
                            	  7524:     ; If the attacker is a vire, then return.
                            	  7525:     ;
02:000327E2 41EC034F        	  7526:     lea     ($034F,A4),A0
02:000327E6 10302000        	  7527:     move.b  (A0,D2.W),D0
02:000327EA 0C000012        	  7528:     cmpi.b  #$12,D0
02:000327EE 6714            	  7529:     beq  _L_z01_BeginShove_Exit
                            	  7530:     ; Turn the attacker in the opposite direction.
                            	  7531:     ;
02:000327F0 41EC0098        	  7532:     lea     ($0098,A4),A0
02:000327F4 10302000        	  7533:     move.b  (A0,D2.W),D0
02:000327F8 6100E87A        	  7534:     jsr     GetOppositeDir
02:000327FC 41EC0098        	  7535:     lea     ($0098,A4),A0
02:00032800 11802000        	  7536:     move.b  D0,(A0,D2.W)
                            	  7537:     even
                            	  7538: _L_z01_BeginShove_Exit:
02:00032804 4E75            	  7539:     rts
                            	  7540: 
                            	  7541:     even
                            	  7542: _L_z01_BeginShove_MonsterDefender:
                            	  7543:     ; A monster is the defender. A weapon is the attacker.
                            	  7544:     ;
                            	  7545:     ; Set the shove direction to the weapon's direction,
                            	  7546:     ; instead of the direction passed in [0B].
                            	  7547:     ;
02:00032806 41EC0098        	  7548:     lea     ($0098,A4),A0
02:0003280A 10303000        	  7549:     move.b  (A0,D3.W),D0
02:0003280E 19400008        	  7550:     move.b  D0,($0008,A4)
                            	  7551:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7552:     ; combine the shove direction with $40.
                            	  7553:     ;
                            	  7554:     ; TODO:
                            	  7555:     ; But the shoving routing doesn't read this flag.
                            	  7556:     ;
02:00032812 41EC04BF        	  7557:     lea     ($04BF,A4),A0
02:00032816 10302000        	  7558:     move.b  (A0,D2.W),D0
02:0003281A 02000080        	  7559:     andi.b #$80,D0
02:0003281E 670C            	  7560:     beq  _anon_z01_102
02:00032820 102C0008        	  7561:     move.b  ($0008,A4),D0
02:00032824 00000040        	  7562:     ori.b #$40,D0
02:00032828 19400008        	  7563:     move.b  D0,($0008,A4)
                            	  7564: _anon_z01_102:
                            	  7565:     ; If the monster is invincible, then return without shoving.
                            	  7566:     ;
02:0003282C 41EC04F0        	  7567:     lea     ($04F0,A4),A0
02:00032830 10302000        	  7568:     move.b  (A0,D2.W),D0
02:00032834 6656            	  7569:     bne  _L_z01_BeginShove_Exit2
                            	  7570:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7571:     ;
02:00032836 41EC034F        	  7572:     lea     ($034F,A4),A0
02:0003283A 10302000        	  7573:     move.b  (A0,D2.W),D0
02:0003283E 0C000033        	  7574:     cmpi.b  #$33,D0
02:00032842 6706            	  7575:     beq  _L_z01_BeginShove_Gohma
02:00032844 0C000034        	  7576:     cmpi.b  #$34,D0
02:00032848 661E            	  7577:     bne  _L_z01_BeginShove_SetShoveDir
                            	  7578:     even
                            	  7579: _L_z01_BeginShove_Gohma:
                            	  7580:     ; This a Gohma, but if the current part [0F] is not an eye part (3 or 4),
                            	  7581:     ; then return, so that the hit doesn't register.
                            	  7582:     ;
02:0003284A 102C000F        	  7583:     move.b  ($000F,A4),D0
02:0003284E 0C000003        	  7584:     cmpi.b  #$03,D0
02:00032852 6706            	  7585:     beq  _anon_z01_103
02:00032854 0C000004        	  7586:     cmpi.b  #$04,D0
02:00032858 6632            	  7587:     bne  _L_z01_BeginShove_Exit2
                            	  7588: _anon_z01_103:
                            	  7589:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  7590:     ;
02:0003285A 41EC046B        	  7591:     lea     ($046B,A4),A0
02:0003285E 10302000        	  7592:     move.b  (A0,D2.W),D0
02:00032862 0C000003        	  7593:     cmpi.b  #$03,D0
02:00032866 6624            	  7594:     bne  _L_z01_BeginShove_Exit2
                            	  7595:     even
                            	  7596: _L_z01_BeginShove_SetShoveDir:
                            	  7597:     ; Store the shove direction for the monster.
