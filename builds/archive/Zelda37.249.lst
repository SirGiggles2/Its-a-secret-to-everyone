                            	  4929: __far_z_07_0074:
                            	  4930:     ; This is a magic shot.
                            	  4931:     ;
                            	  4932:     ; If missing the magic book, go deactivate the shot object.
                            	  4933:     ;
02:0004BF94 102C0661        	  4934:     move.b  ($0661,A4),D0
02:0004BF98 6602            	  4935:     bne.s  __far_z_07_0075
02:0004BF9A 6072            	  4936:     jmp  DeactivateShot
                            	  4937: __far_z_07_0075:
                            	  4938:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4939:     ; unused, so it only has to depend on having an empty slot.
                            	  4940:     ;
                            	  4941:     ; If successful, Link's state will have been changed to "using item".
                            	  4942:     ; But we don't want that in this case.
                            	  4943:     ;
                            	  4944:     ; For both these reasons, save state and restore it afterward.
                            	  4945:     ;
02:0004BF9C 102C00AC        	  4946:     move.b  ($00AC,A4),D0
02:0004BFA0 1B00            	  4947:     move.b  D0,-(A5)  ; PHA
02:0004BFA2 102C0513        	  4948:     move.b  ($0513,A4),D0
02:0004BFA6 1B00            	  4949:     move.b  D0,-(A5)  ; PHA
02:0004BFA8 7000            	  4950:     moveq   #0,D0
02:0004BFAA 19400513        	  4951:     move.b  D0,($0513,A4)
02:0004BFAE 4EB9000312BE    	  4952:     jsr     WieldCandle
02:0004BFB4 101D            	  4953:     move.b  (A5)+,D0  ; PLA
02:0004BFB6 19400513        	  4954:     move.b  D0,($0513,A4)
02:0004BFBA 101D            	  4955:     move.b  (A5)+,D0  ; PLA
02:0004BFBC 194000AC        	  4956:     move.b  D0,($00AC,A4)
                            	  4957:     ; State $21 means that a moving fire was just made.
                            	  4958:     ;
                            	  4959:     ; If it's any another value, then we didn't find an empty slot
                            	  4960:     ; to make a fire. In this case, all that's left to do is to go
                            	  4961:     ; deactivate the shot object.
                            	  4962:     ;
02:0004BFC0 41EC00AC        	  4963:     lea     ($00AC,A4),A0
02:0004BFC4 10302000        	  4964:     move.b  (A0,D2.W),D0
02:0004BFC8 0C000021        	  4965:     cmpi.b  #$21,D0
02:0004BFCC 6702            	  4966:     beq.s  __far_z_07_0076
02:0004BFCE 6038            	  4967:     jmp  DeactivateLinkShot
                            	  4968: __far_z_07_0076:
                            	  4969:     ; Make state $22 for a standing fire.
                            	  4970:     ;
02:0004BFD0 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:0004BFD4 52302000        	  4972:     addq.b  #1,(A0,D2.W)
                            	  4973:     ; Copy the shot's position and direction to the fire.
                            	  4974:     ;
02:0004BFD8 760E            	  4975:     moveq   #14,D3
02:0004BFDA 10343070        	  4976:     move.b  ($70,A4,D3.W),D0
02:0004BFDE 19802070        	  4977:     move.b  D0,($70,A4,D2.W)
02:0004BFE2 41EC0084        	  4978:     lea     ($0084,A4),A0
02:0004BFE6 10303000        	  4979:     move.b  (A0,D3.W),D0
02:0004BFEA 41EC0084        	  4980:     lea     ($0084,A4),A0
02:0004BFEE 11802000        	  4981:     move.b  D0,(A0,D2.W)
02:0004BFF2 41EC0098        	  4982:     lea     ($0098,A4),A0
02:0004BFF6 10303000        	  4983:     move.b  (A0,D3.W),D0
02:0004BFFA 41EC0098        	  4984:     lea     ($0098,A4),A0
02:0004BFFE 11802000        	  4985:     move.b  D0,(A0,D2.W)
                            	  4986:     ; The fire lasts $4F frames.
