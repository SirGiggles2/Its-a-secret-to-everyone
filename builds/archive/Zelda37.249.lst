                            	   207: InitCave:
                            	   208:     ; The person goes at location ($78, $80).
                            	   209:     ;
02:0002E4B6 7078            	   210:     moveq   #120,D0
02:0002E4B8 163C0080        	   211:     move.b  #$80,D3
02:0002E4BC 610001A0        	   212:     jsr     SetUpCommonCaveObjects
                            	   213:     ; If the cave/person does not remember state (give item, door charge),
                            	   214:     ; then go handle other kinds.
                            	   215:     ;
02:0002E4C0 102C0350        	   216:     move.b  ($0350,A4),D0
02:0002E4C4 0C000072        	   217:     cmpi.b  #$72,D0
02:0002E4C8 6714            	   218:     beq  _L_z01_InitCave_TakeType
02:0002E4CA 0C000071        	   219:     cmpi.b  #$71,D0
02:0002E4CE 670E            	   220:     beq  _L_z01_InitCave_TakeType
02:0002E4D0 0C00007B        	   221:     cmpi.b  #$7B,D0
02:0002E4D4 6408            	   222:     bcc  _L_z01_InitCave_TakeType
02:0002E4D6 0C00006E        	   223:     cmpi.b  #$6E,D0
02:0002E4DA 6502            	   224:     bcs.s  __far_z_01_0000
02:0002E4DC 6012            	   225:     jmp  InitCaveContinue
                            	   226: __far_z_01_0000:
                            	   227:     even
                            	   228: _L_z01_InitCave_TakeType:
                            	   229:     ; Else the cave/person simply does:
                            	   230:     ; - taken:     no person, no text
                            	   231:     ; - not taken: show a person and text
                            	   232:     ;
                            	   233:     ; So, if the item was not taken, then go set up the text.
                            	   234:     ;
02:0002E4DE 61003092        	   235:     jsr     GetRoomFlagUWItemState
02:0002E4E2 6602            	   236:     bne.s  __far_z_01_0001
02:0002E4E4 600A            	   237:     jmp  InitCaveContinue
                            	   238: __far_z_01_0001:
                            	   239:     ; Otherwise destroy the person object, and let Link continue.
                            	   240:     ;
02:0002E4E6 7000            	   241:     moveq   #0,D0
02:0002E4E8 19400350        	   242:     move.b  D0,($0350,A4)
                            	   243:     even
                            	   244: UnhaltLink:
02:0002E4EC 6000D500        	   245:     jmp     c_unhalt_link
                            	   246: 
                            	   247: InitCaveContinue:
                            	   248:     ; Get this cave's index (object type - $6A).
                            	   249:     ;
02:0002E4F0 102C0350        	   250:     move.b  ($0350,A4),D0
02:0002E4F4 003C0011        	   251:     ori     #$11,CCR  ; SEC: set C+X
02:0002E4F8 123C006A        	   252:     move.b  #$6A,D1
02:0002E4FC 0A3C0010        	   253:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E500 9101            	   254:     subx.b  D1,D0   ; SBC #$6A
02:0002E502 0A3C0010        	   255:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E506 7600            	   256:     moveq   #0,D3
02:0002E508 1600            	   257:     move.b  D0,D3
                            	   258:     ; Get the person text selector by looking up the text selector byte
                            	   259:     ; for this index, and masking it with $3F.
                            	   260:     ;
02:0002E50A 41F90002E488    	   261:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E510 10303000        	   262:     move.b  (A0,D3.W),D0
02:0002E514 1B00            	   263:     move.b  D0,-(A5)  ; PHA
02:0002E516 0200003F        	   264:     andi.b #$3F,D0
02:0002E51A 19400415        	   265:     move.b  D0,($0415,A4)
                            	   266:     ; Pop and mask the text selector byte with $C0 to get the
                            	   267:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   268:     ;
02:0002E51E 101D            	   269:     move.b  (A5)+,D0  ; PLA
02:0002E520 020000C0        	   270:     andi.b #$C0,D0
02:0002E524 19400003        	   271:     move.b  D0,($0003,A4)
                            	   272:     ; At this point, the Y register still has the cave index.
                            	   273:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   274:     ;
02:0002E528 103C00FD        	   275:     move.b  #$FD,D0
                            	   276: _anon_z01_0:
02:0002E52C 023C00EE        	   277:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E530 123C0003        	   278:     move.b  #$03,D1
02:0002E534 D101            	   279:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E536 5303            	   280:     subq.b  #1,D3
02:0002E538 6AF2            	   281:     bpl  _anon_z01_0
02:0002E53A 7600            	   282:     moveq   #0,D3
02:0002E53C 1600            	   283:     move.b  D0,D3
                            	   284:     ; Loop over the wares from 0 to 2.
                            	   285:     ;
02:0002E53E 7400            	   286:     moveq   #0,D2
                            	   287:     even
                            	   288: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   289:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   290:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   291:     ;
02:0002E540 41F900FF6A7E    	   292:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E546 10303000        	   293:     move.b  (A0,D3.W),D0
02:0002E54A 41EC0422        	   294:     lea     ($0422,A4),A0
02:0002E54E 11802000        	   295:     move.b  D0,(A0,D2.W)
                            	   296:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   297:     ;
02:0002E552 020000C0        	   298:     andi.b #$C0,D0
02:0002E556 19802000        	   299:     move.b  D0,($00,A4,D2.W)
                            	   300:     ; Copy 3 prices from the Cave level block info.
                            	   301:     ;
02:0002E55A 41F900FF6ABA    	   302:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E560 10303000        	   303:     move.b  (A0,D3.W),D0
02:0002E564 41EC0430        	   304:     lea     ($0430,A4),A0
02:0002E568 11802000        	   305:     move.b  D0,(A0,D2.W)
                            	   306:     ; Bottom of the wares copying loop.
                            	   307:     ;
02:0002E56C 5203            	   308:     addq.b  #1,D3
02:0002E56E 5202            	   309:     addq.b  #1,D2
02:0002E570 0C020003        	   310:     cmpi.b  #$03,D2
02:0002E574 66CA            	   311:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   312:     ; Get the top 2 bits of text selector byte in [03],
                            	   313:     ; shift them to the bottom, and combine them with [00].
                            	   314:     ;
02:0002E576 102C0003        	   315:     move.b  ($0003,A4),D0
02:0002E57A E308            	   316:     lsl.b  #1,D0   ; ASL A
02:0002E57C E310            	   317:     roxl.b  #1,D0   ; ROL A
02:0002E57E E310            	   318:     roxl.b  #1,D0   ; ROL A
02:0002E580 1214            	   319:     move.b  ($0000,A4),D1
02:0002E582 8001            	   320:     or.b  D1,D0
02:0002E584 1880            	   321:     move.b  D0,($0000,A4)
                            	   322:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   323:     ; and combine them with [00].
                            	   324:     ;
02:0002E586 102C0002        	   325:     move.b  ($0002,A4),D0
02:0002E58A E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002E58C E208            	   327:     lsr.b  #1,D0   ; LSR A
02:0002E58E E208            	   328:     lsr.b  #1,D0   ; LSR A
02:0002E590 E208            	   329:     lsr.b  #1,D0   ; LSR A
02:0002E592 1214            	   330:     move.b  ($0000,A4),D1
02:0002E594 8001            	   331:     or.b  D1,D0
02:0002E596 1880            	   332:     move.b  D0,($0000,A4)
                            	   333:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   334:     ; and combine them with [00] into CaveFlags.
                            	   335:     ;
02:0002E598 102C0001        	   336:     move.b  ($0001,A4),D0
02:0002E59C E208            	   337:     lsr.b  #1,D0   ; LSR A
02:0002E59E E208            	   338:     lsr.b  #1,D0   ; LSR A
02:0002E5A0 1214            	   339:     move.b  ($0000,A4),D1
02:0002E5A2 8001            	   340:     or.b  D1,D0
02:0002E5A4 19400413        	   341:     move.b  D0,($0413,A4)
                            	   342:     ; The end result is a byte with 8 cave flags.
                            	   343:     ;
                            	   344:     ; If cave flag "money game" is missing, then go finish up,
                            	   345:     ; instead of choosing random amounts for the money game.
                            	   346:     ;
02:0002E5A8 02000020        	   347:     andi.b #$20,D0
02:0002E5AC 6700009E        	   348:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   349:     ; Determine an index randomly with increasing probability,
                            	   350:     ; from 6 to 1. Start with the following test:
                            	   351:     ;
                            	   352:     ;   If $FF < Random, then go use index 6.
                            	   353:     ;
02:0002E5B0 103C00FF        	   354:     move.b  #$FF,D0
02:0002E5B4 7606            	   355:     moveq   #6,D3
                            	   356:     even
                            	   357: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E5B6 122C0019        	   358:     move.b  ($0019,A4),D1
02:0002E5BA B001            	   359:     cmp.b   D1,D0
02:0002E5BC 6516            	   360:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   361:     ; If the test fails, then subtract $2B from the reference number.
                            	   362:     ;
02:0002E5BE 003C0011        	   363:     ori     #$11,CCR  ; SEC: set C+X
02:0002E5C2 123C002B        	   364:     move.b  #$2B,D1
02:0002E5C6 0A3C0010        	   365:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E5CA 9101            	   366:     subx.b  D1,D0   ; SBC #$2B
02:0002E5CC 0A3C0010        	   367:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E5D0 5303            	   368:     subq.b  #1,D3
02:0002E5D2 66E2            	   369:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   370:     even
                            	   371: _L_z01_InitCaveContinue_FoundPermutation:
                            	   372:     ; The index chooses the last offset of a permutation of three indexes.
                            	   373:     ;
02:0002E5D4 7400            	   374:     moveq   #0,D2
02:0002E5D6 41F90002E4B0    	   375:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E5DC 14303000        	   376:     move.b  (A0,D3.W),D2
                            	   377:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   378:     ;
02:0002E5E0 7602            	   379:     moveq   #2,D3
                            	   380:     even
                            	   381: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E5E2 41F90002E49E    	   382:     lea     (MoneyGamePermutations).l,A0
02:0002E5E8 10302000        	   383:     move.b  (A0,D2.W),D0
02:0002E5EC 41EC046C        	   384:     lea     ($046C,A4),A0
02:0002E5F0 11803000        	   385:     move.b  D0,(A0,D3.W)
02:0002E5F4 5302            	   386:     subq.b  #1,D2
02:0002E5F6 5303            	   387:     subq.b  #1,D3
02:0002E5F8 6AE8            	   388:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   389:     ; With the first bit of another random number, choose 10 or 40
                            	   390:     ; to put in [046F]. This is a random amount to lose.
                            	   391:     ;
02:0002E5FA 102C001A        	   392:     move.b  ($001A,A4),D0
02:0002E5FE 02000001        	   393:     andi.b #$01,D0
02:0002E602 7600            	   394:     moveq   #0,D3
02:0002E604 1600            	   395:     move.b  D0,D3
02:0002E606 41F90002E49C    	   396:     lea     (MoneyGameLossAmounts).l,A0
02:0002E60C 10303000        	   397:     move.b  (A0,D3.W),D0
02:0002E610 1940046F        	   398:     move.b  D0,($046F,A4)
                            	   399:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   400:     ;
02:0002E614 700A            	   401:     moveq   #10,D0
02:0002E616 19400470        	   402:     move.b  D0,($0470,A4)
                            	   403:     ; With a different bit of the second random number,
                            	   404:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   405:     ;
02:0002E61A 7614            	   406:     moveq   #20,D3
02:0002E61C 102C001A        	   407:     move.b  ($001A,A4),D0
02:0002E620 02000002        	   408:     andi.b #$02,D0
02:0002E624 6702            	   409:     beq  _anon_z01_1
02:0002E626 7632            	   410:     moveq   #50,D3
                            	   411: _anon_z01_1:
02:0002E628 19430471        	   412:     move.b  D3,($0471,A4)
                            	   413:     ; The 3 amounts are now in [046F] to [0471].
                            	   414:     ; Reference these amounts using the permutation of indexes
                            	   415:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   416:     ;
02:0002E62C 7402            	   417:     moveq   #2,D2
                            	   418:     even
                            	   419: _L_z01_InitCaveContinue_ArrangeAmounts:
02:0002E62E 7600            	   420:     moveq   #0,D3
02:0002E630 41EC046C        	   421:     lea     ($046C,A4),A0
02:0002E634 16302000        	   422:     move.b  (A0,D2.W),D3
02:0002E638 41EC046F        	   423:     lea     ($046F,A4),A0
02:0002E63C 10303000        	   424:     move.b  (A0,D3.W),D0
02:0002E640 41EC0448        	   425:     lea     ($0448,A4),A0
02:0002E644 11802000        	   426:     move.b  D0,(A0,D2.W)
02:0002E648 5302            	   427:     subq.b  #1,D2
