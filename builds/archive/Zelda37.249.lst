                            	  5089: Wallmaster_CalcStartPosition:
02:0003BEC2 41EC0412        	  5090:     lea     ($0412,A4),A0
02:0003BEC6 11802000        	  5091:     move.b  D0,(A0,D2.W)
02:0003BECA 19430003        	  5092:     move.b  D3,($0003,A4)
                            	  5093:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5094:     ;
02:0003BECE 7024            	  5095:     moveq   #36,D0
02:0003BED0 7600            	  5096:     moveq   #0,D3
02:0003BED2 162C03F8        	  5097:     move.b  ($03F8,A4),D3
02:0003BED6 6702            	  5098:     beq  _anon_z04_70
02:0003BED8 7032            	  5099:     moveq   #50,D0
                            	  5100: _anon_z04_70:
                            	  5101:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5102:     ; 1. negate the distance
                            	  5103:     ; 2. add 8 to the instruction offset to access
                            	  5104:     ;    the opposite direction for the same wall
                            	  5105:     ;
02:0003BEDA 7600            	  5106:     moveq   #0,D3
02:0003BEDC 162C0098        	  5107:     move.b  ($0098,A4),D3
02:0003BEE0 122C0002        	  5108:     move.b  ($0002,A4),D1
02:0003BEE4 B601            	  5109:     cmp.b   D1,D3
02:0003BEE6 662A            	  5110:     bne  _anon_z04_71
02:0003BEE8 1B00            	  5111:     move.b  D0,-(A5)  ; PHA
02:0003BEEA 41EC0412        	  5112:     lea     ($0412,A4),A0
02:0003BEEE 10302000        	  5113:     move.b  (A0,D2.W),D0
02:0003BEF2 023C00EE        	  5114:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BEF6 123C0008        	  5115:     move.b  #$08,D1
02:0003BEFA D101            	  5116:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BEFC 41EC0412        	  5117:     lea     ($0412,A4),A0
02:0003BF00 11802000        	  5118:     move.b  D0,(A0,D2.W)
02:0003BF04 101D            	  5119:     move.b  (A5)+,D0  ; PLA
02:0003BF06 4600            	  5120:     eori.b #$FF,D0
02:0003BF08 023C00EE        	  5121:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF0C 123C0001        	  5122:     move.b  #$01,D1
02:0003BF10 D101            	  5123:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5124: _anon_z04_71:
                            	  5125:     ; Add the distance and Link's minor coordinate to calculate
                            	  5126:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5127:     ; In general, the monster will be put in front of Link.
                            	  5128:     ;
02:0003BF12 023C00EE        	  5129:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF16 1214            	  5130:     move.b  ($0000,A4),D1
02:0003BF18 D101            	  5131:     addx.b  D1,D0   ; ADC $00
02:0003BF1A 19400004        	  5132:     move.b  D0,($0004,A4)
                            	  5133:     ; By default, will return index 0 to choose the minimum value
                            	  5134:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5135:     ; if Link is at the wall with a smaller major coordinate.
                            	  5136:     ;
02:0003BF1E 7600            	  5137:     moveq   #0,D3
                            	  5138:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5139:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5140:     ; to access the block for the other direction along the same axis,
                            	  5141:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5142:     ;
02:0003BF20 102C0001        	  5143:     move.b  ($0001,A4),D0
02:0003BF24 122C0003        	  5144:     move.b  ($0003,A4),D1
02:0003BF28 B001            	  5145:     cmp.b   D1,D0
02:0003BF2A 671C            	  5146:     beq  _anon_z04_72
02:0003BF2C 41EC0412        	  5147:     lea     ($0412,A4),A0
02:0003BF30 10302000        	  5148:     move.b  (A0,D2.W),D0
02:0003BF34 023C00EE        	  5149:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF38 123C0010        	  5150:     move.b  #$10,D1
02:0003BF3C D101            	  5151:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BF3E 41EC0412        	  5152:     lea     ($0412,A4),A0
02:0003BF42 11802000        	  5153:     move.b  D0,(A0,D2.W)
02:0003BF46 5203            	  5154:     addq.b  #1,D3
                            	  5155: _anon_z04_72:
