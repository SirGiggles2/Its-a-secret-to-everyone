02:00035396 0A3C0010        	  2789:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003539A 9101            	  2790:     subx.b  D1,D0   ; SBC #$08
02:0003539C 0A3C0010        	  2791:     eori    #$10,CCR  ; restore X = 6502 C
02:000353A0 7600            	  2792:     moveq   #0,D3
02:000353A2 1600            	  2793:     move.b  D0,D3
02:000353A4 102C0015        	  2794:     move.b  ($0015,A4),D0
