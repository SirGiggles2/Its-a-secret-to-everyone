                            	  7684: Submenu_CueTransferRowUW:
                            	  7685:     ; If menu scroll value is negative, then we transferred everything.
                            	  7686:     ; So, return.
                            	  7687:     ;
02:00044BB4 102C005E        	  7688:     move.b  ($005E,A4),D0
02:00044BB8 6A02            	  7689:     bpl.s  __far_z_05_0084
02:00044BBA 6030            	  7690:     jmp  L1725A_Exit
                            	  7691: __far_z_05_0084:
                            	  7692:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7693:     ; and represents the current row of the submenu being processed.
                            	  7694:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7695:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7696:     ;
                            	  7697:     ; If the bottom bit is set, go prepare the full black row.
                            	  7698:     ;
02:00044BBC E208            	  7699:     lsr.b  #1,D0   ; LSR A
02:00044BBE 7600            	  7700:     moveq   #0,D3
02:00044BC0 1600            	  7701:     move.b  D0,D3
02:00044BC2 6402            	  7702:     bcc.s  __far_z_05_0085
02:00044BC4 6028            	  7703:     jmp  PrepFullBlackRow
                            	  7704: __far_z_05_0085:
                            	  7705:     ; Submenu rows $D to $15 are parts of the map.
                            	  7706:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7707:     ;
                            	  7708:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7709:     ; buffer for this row.
                            	  7710:     ;
02:00044BC6 0C00000D        	  7711:     cmpi.b  #$0D,D0
02:00044BCA 640C            	  7712:     bcc  _anon_z05_167
02:00044BCC 41F900044B90    	  7713:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044BD2 10303000        	  7714:     move.b  (A0,D3.W),D0
                            	  7715:     even
                            	  7716: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00044BD6 6070            	  7717:     jmp     SelectTransferBufAndDecCounter
                            	  7718: 
                            	  7719: _anon_z05_167:
                            	  7720:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7721:     ; of the big map sheet.
                            	  7722:     ;
02:00044BD8 0C000015        	  7723:     cmpi.b  #$15,D0
02:00044BDC 6604            	  7724:     bne  _anon_z05_168
02:00044BDE 7042            	  7725:     moveq   #66,D0
02:00044BE0 60F4            	  7726:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  7727: 
