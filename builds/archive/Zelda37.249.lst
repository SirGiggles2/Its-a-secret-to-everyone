02:00040414 14303000        	   547:     move.b  (A0,D3.W),D2
02:00040418 41F9000403F2    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0004041E 10303000        	   549:     move.b  (A0,D3.W),D0
02:00040422 41F90004741A    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
