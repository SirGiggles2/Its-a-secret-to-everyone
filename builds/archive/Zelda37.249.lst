02:0003286C 00000080        	  7603:     ori.b #$80,D0
02:00032870 41EC00C0        	  7604:     lea     ($00C0,A4),A0
02:00032874 11802000        	  7605:     move.b  D0,(A0,D2.W)
                            	  7606:     ; Mark the monster invincible $10 frames, and should move $40 pixels.
