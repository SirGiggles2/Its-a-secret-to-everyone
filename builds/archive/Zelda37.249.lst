                            	  3825: UpdateArmos:
02:0003B5AC 6100E828        	  3826:     jsr     UpdateGoriya
                            	  3827:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3828:     ;
02:0003B5B0 41EC00C0        	  3829:     lea     ($00C0,A4),A0
02:0003B5B4 10302000        	  3830:     move.b  (A0,D2.W),D0
02:0003B5B8 6702            	  3831:     beq.s  __far_z_04_0033
02:0003B5BA 602A            	  3832:     jmp  DrawArmosAndCheckCollisions
                            	  3833: __far_z_04_0033:
                            	  3834:     ; Animate.
                            	  3835:     ;
                            	  3836:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3837:     ; then only go draw.
                            	  3838:     ;
02:0003B5BC 41EC03D0        	  3839:     lea     ($03D0,A4),A0
02:0003B5C0 53302000        	  3840:     subq.b  #1,(A0,D2.W)
02:0003B5C4 6702            	  3841:     beq.s  __far_z_04_0034
02:0003B5C6 601E            	  3842:     jmp  DrawArmosAndCheckCollisions
                            	  3843: __far_z_04_0034:
                            	  3844:     ; Armos animation frames last 6 screen frames.
                            	  3845:     ;
02:0003B5C8 7006            	  3846:     moveq   #6,D0
02:0003B5CA 41EC03D0        	  3847:     lea     ($03D0,A4),A0
02:0003B5CE 11802000        	  3848:     move.b  D0,(A0,D2.W)
                            	  3849:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3850:     ; change the position of the shield. To keep fixed it in place,
                            	  3851:     ; there are separate frame images for each animation frame.
                            	  3852:     ;
                            	  3853:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3854:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3855:     ;
                            	  3856:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3857:     ; Then choose the direction at the point of drawing below.
                            	  3858:     ;
02:0003B5D2 41EC03E4        	  3859:     lea     ($03E4,A4),A0
02:0003B5D6 10302000        	  3860:     move.b  (A0,D2.W),D0
02:0003B5DA 0A000002        	  3861:     eori.b #$02,D0
02:0003B5DE 41EC03E4        	  3862:     lea     ($03E4,A4),A0
02:0003B5E2 11802000        	  3863:     move.b  D0,(A0,D2.W)
                            	  3864:     even
                            	  3865: DrawArmosAndCheckCollisions:
02:0003B5E6 4EB90004CD24    	  3866:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B5EC 7600            	  3867:     moveq   #0,D3
02:0003B5EE 41EC0098        	  3868:     lea     ($0098,A4),A0
02:0003B5F2 16302000        	  3869:     move.b  (A0,D2.W),D3
                            	  3870:     ; If facing up, then use the second frame image in the set ("back").
                            	  3871:     ; Else use the second.
                            	  3872:     ;
02:0003B5F6 0C030008        	  3873:     cmpi.b  #$08,D3
02:0003B5FA 6602            	  3874:     bne  _anon_z04_54
02:0003B5FC 7001            	  3875:     moveq   #1,D0
                            	  3876: _anon_z04_54:
02:0003B5FE 023C00EE        	  3877:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B602 41EC03E4        	  3878:     lea     ($03E4,A4),A0
02:0003B606 12302000        	  3879:     move.b  (A0,D2.W),D1
02:0003B60A D101            	  3880:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B60C 4EB900031BCC    	  3881:     jsr     DrawObjectNotMirrored
                            	  3882:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3883:     ; but not with weapons.
                            	  3884:     ;
02:0003B612 10342028        	  3885:     move.b  ($28,A4,D2.W),D0
02:0003B616 661C            	  3886:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3887:     ; Else check for all collisions.
                            	  3888:     ;
02:0003B618 4EB900031F48    	  3889:     jsr     CheckMonsterCollisions
                            	  3890:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3891:     ;
02:0003B61E 41EC0405        	  3892:     lea     ($0405,A4),A0
02:0003B622 10302000        	  3893:     move.b  (A0,D2.W),D0
02:0003B626 670A            	  3894:     beq  _anon_z04_55
02:0003B628 705D            	  3895:     moveq   #93,D0
02:0003B62A 41EC034F        	  3896:     lea     ($034F,A4),A0
02:0003B62E 11802000        	  3897:     move.b  D0,(A0,D2.W)
                            	  3898: _anon_z04_55:
02:0003B632 4E75            	  3899:     rts
                            	  3900: 
                            	  3901:     even
                            	  3902: _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision:
02:0003B634 4EF900032092    	  3903:     jmp     CheckLinkCollision
