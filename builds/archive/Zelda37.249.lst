                            	 12757: Ganon_CheckCollisions:
                            	 12758:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12759:     ; Store in [02] and [03].
                            	 12760:     ;
02:0003F77C 10342070        	 12761:     move.b  ($70,A4,D2.W),D0
02:0003F780 023C00EE        	 12762:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F784 123C0010        	 12763:     move.b  #$10,D1
02:0003F788 D101            	 12764:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F78A 19400002        	 12765:     move.b  D0,($0002,A4)
02:0003F78E 41EC0084        	 12766:     lea     ($0084,A4),A0
02:0003F792 10302000        	 12767:     move.b  (A0,D2.W),D0
02:0003F796 023C00EE        	 12768:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F79A 123C0010        	 12769:     move.b  #$10,D1
02:0003F79E D101            	 12770:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F7A0 19400003        	 12771:     move.b  D0,($0003,A4)
                            	 12772:     ; Check for a collision with Link.
                            	 12773:     ;
                            	 12774:     ; We can't call CheckLinkCollision, because we need to
                            	 12775:     ; customize Ganon's midpoint.
                            	 12776:     ;
                            	 12777:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12778:     ; detection, if Link is invincible. Initialize variables that will
                            	 12779:     ; be returned from the partial collision check routine. Then
                            	 12780:     ; call it.
                            	 12781:     ;
02:0003F7A4 102C04F0        	 12782:     move.b  ($04F0,A4),D0
02:0003F7A8 6616            	 12783:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F7AA 19400006        	 12784:     move.b  D0,($0006,A4)
02:0003F7AE 19400009        	 12785:     move.b  D0,($0009,A4)
02:0003F7B2 1940000C        	 12786:     move.b  D0,($000C,A4)
02:0003F7B6 7600            	 12787:     moveq   #0,D3
02:0003F7B8 1883            	 12788:     move.b  D3,($0000,A4)
02:0003F7BA 4EB9000320C8    	 12789:     jsr     CheckLinkCollisionPreinit
                            	 12790:     even
                            	 12791: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12792:     ; If Ganon is not in state 0, then he's brown.
                            	 12793:     ; Go check collision with an arrow.
                            	 12794:     ;
02:0003F7C0 41EC00AC        	 12795:     lea     ($00AC,A4),A0
02:0003F7C4 10302000        	 12796:     move.b  (A0,D2.W),D0
02:0003F7C8 6652            	 12797:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12798:     ; If timer <> 0, then Ganon is visible.
                            	 12799:     ; He can't be harmed like this. So, return.
                            	 12800:     ;
02:0003F7CA 10342028        	 12801:     move.b  ($28,A4,D2.W),D0
02:0003F7CE 664A            	 12802:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F7D0 760D            	 12803:     moveq   #13,D3
02:0003F7D2 4EB900032592    	 12804:     jsr     CheckMonsterSwordCollision
                            	 12805:     ; If Ganon has died according to the usual collision check rules
                            	 12806:     ; (HP = 0), then:
                            	 12807:     ; 1. Restore HP to the initial value $F0
                            	 12808:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12809:     ; 3. Change palette row 7 to make Ganon brown
                            	 12810:     ;
02:0003F7D8 41EC0405        	 12811:     lea     ($0405,A4),A0
02:0003F7DC 10302000        	 12812:     move.b  (A0,D2.W),D0
02:0003F7E0 6718            	 12813:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F7E2 103C00F0        	 12814:     move.b  #$F0,D0
02:0003F7E6 41EC0485        	 12815:     lea     ($0485,A4),A0
02:0003F7EA 11802000        	 12816:     move.b  D0,(A0,D2.W)
02:0003F7EE 41EC00AC        	 12817:     lea     ($00AC,A4),A0
02:0003F7F2 53302000        	 12818:     subq.b  #1,(A0,D2.W)
02:0003F7F6 61000084        	 12819:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12820:     even
                            	 12821: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12822:     ; If Ganon was harmed, then play the sound effect
                            	 12823:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12824:     ;
02:0003F7FA 41EC04F0        	 12825:     lea     ($04F0,A4),A0
02:0003F7FE 10302000        	 12826:     move.b  (A0,D2.W),D0
02:0003F802 670A            	 12827:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F804 6100A40C        	 12828:     jsr     PlayBossHitCryIfNeeded
02:0003F808 7040            	 12829:     moveq   #64,D0
02:0003F80A 19802028        	 12830:     move.b  D0,($28,A4,D2.W)
                            	 12831:     even
                            	 12832: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12833:     ; Reset metastate, because Ganon cannot die this way.
                            	 12834:     ;
02:0003F80E 4EB90004D524    	 12835:     jsr     ResetObjMetastate
                            	 12836:     ; Reset shove info and invincibility timer, because Ganon
                            	 12837:     ; doesn't react at all as a usual monster.
                            	 12838:     ;
02:0003F814 4EB90003249A    	 12839:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12840:     even
                            	 12841: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F81A 4E75            	 12842:     rts
                            	 12843: 
                            	 12844:     even
                            	 12845: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12846:     ; If the silver arrow is not in the inventory, then return.
                            	 12847:     ;
02:0003F81C 102C0659        	 12848:     move.b  ($0659,A4),D0
02:0003F820 0C000002        	 12849:     cmpi.b  #$02,D0
02:0003F824 66F4            	 12850:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12851:     ; Reset the collision return value [06].
