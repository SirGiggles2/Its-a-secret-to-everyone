                            	 11979: __far_z_04_0114:
                            	 11980:     ; State = 0.
                            	 11981:     ;
                            	 11982:     ; If the current object slot is 2, then go initialize the patra child.
                            	 11983:     ; This is the only patra child shown in the first fame.
                            	 11984:     ;
02:0003F206 0C020002        	 11985:     cmpi.b  #$02,D2
02:0003F20A 6732            	 11986:     beq  _L_z04_UpdatePatraChild_Ready
                            	 11987:     ; The patra child in slot 2 is the last one to be updated.
                            	 11988:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 11989:     ;
                            	 11990:     ; This means that in the first frame, slot 2 is the only one to be
                            	 11991:     ; shown.
                            	 11992:     ;
02:0003F20C 102C00AE        	 11993:     move.b  ($00AE,A4),D0
02:0003F210 6700008E        	 11994:     beq  _L_z04_UpdatePatraChild_Exit
                            	 11995:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 11996:     ; here to wait to be shown at the top position (N) one at a time.
                            	 11997:     ;
02:0003F214 1002            	 11998:     move.b  D2,D0
                            	 11999:     ; Subtract 3 from the object slot to get the angle where the
                            	 12000:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12001:     ;
02:0003F216 003C0011        	 12002:     ori     #$11,CCR  ; SEC: set C+X
02:0003F21A 123C0003        	 12003:     move.b  #$03,D1
02:0003F21E 0A3C0010        	 12004:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F222 9101            	 12005:     subx.b  D1,D0   ; SBC #$03
02:0003F224 0A3C0010        	 12006:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F228 7600            	 12007:     moveq   #0,D3
02:0003F22A 1600            	 12008:     move.b  D0,D3
                            	 12009:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12010:     ; then return.
                            	 12011:     ;
02:0003F22C 102C0396        	 12012:     move.b  ($0396,A4),D0
02:0003F230 41F90003F1EA    	 12013:     lea     (PatraChildStartAngles).l,A0
02:0003F236 12303000        	 12014:     move.b  (A0,D3.W),D1
02:0003F23A B001            	 12015:     cmp.b   D1,D0
02:0003F23C 6662            	 12016:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12017:     even
