02:0003F28C 1214            	 12062:     move.b  ($0000,A4),D1
02:0003F28E 0A3C0010        	 12063:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F292 9101            	 12064:     subx.b  D1,D0   ; SBC $00
02:0003F294 0A3C0010        	 12065:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F298 41EC0084        	 12066:     lea     ($0084,A4),A0
