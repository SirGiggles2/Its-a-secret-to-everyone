02:0003CF4E 123C0005        	  7375:     move.b  #$05,D1
02:0003CF52 D101            	  7376:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CF54 7600            	  7377:     moveq   #0,D3
02:0003CF56 1600            	  7378:     move.b  D0,D3
