02:0003F5E2 19400001        	 12556:     move.b  D0,($0001,A4)
02:0003F5E6 101D            	 12557:     move.b  (A5)+,D0  ; PLA
02:0003F5E8 1880            	 12558:     move.b  D0,($0000,A4)
02:0003F5EA 0A3C0001        	 12559:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
