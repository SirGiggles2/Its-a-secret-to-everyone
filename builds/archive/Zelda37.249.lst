                            	  7392:     ; Validate fallback cell walkable.
02:0004D1E2 7600            	  7393:     moveq   #0,D3
02:0004D1E4 1601            	  7394:     move.b  D1,D3
02:0004D1E6 0243000F        	  7395:     andi.w  #$000F,D3
02:0004D1EA C6FC002C        	  7396:     mulu.w  #44,D3
02:0004D1EE 203C00FF6530    	  7397:     move.l  #$FF6530,D0
