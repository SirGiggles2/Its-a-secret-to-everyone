                            	  2142: __far_z_04_0017:
02:0003AA1A 61000592        	  2143:     jsr     UpdateBurrower
                            	  2144:     ; If zora died in the call above, then it happened while in
                            	  2145:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2146:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2147:     ; not come back after killing it.
                            	  2148:     ;
                            	  2149:     ; If state <> 3 or timer <> $FD,
                            	  2150:     ; then go see if the object needs to be destroyed.
                            	  2151:     ;
02:0003AA1E 41EC00AC        	  2152:     lea     ($00AC,A4),A0
02:0003AA22 10302000        	  2153:     move.b  (A0,D2.W),D0
02:0003AA26 0C000003        	  2154:     cmpi.b  #$03,D0
02:0003AA2A 6616            	  2155:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003AA2C 10342028        	  2156:     move.b  ($28,A4,D2.W),D0
02:0003AA30 0C0000FD        	  2157:     cmpi.b  #$FD,D0
02:0003AA34 660C            	  2158:     bne  _L_z04_UpdateZora_DestroyWhenDone
