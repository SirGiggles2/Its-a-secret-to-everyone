                            	 12312: __far_z_04_0120:
                            	 12313:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12314:     ; Collisions were checked already.
                            	 12315:     ;
                            	 12316:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12317:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12318:     ;
02:0003F440 0C000001        	 12319:     cmpi.b  #$01,D0
02:0003F444 6702            	 12320:     beq.s  __far_z_04_0121
