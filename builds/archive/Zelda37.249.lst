02:00035388 1940020B        	  2771:     move.b  D0,($020B,A4)
02:0003538C 4E75            	  2772:     rts
                            	  2773: 
                            	  2774: ; Params:
                            	  2775: ; A: cursor Y
                            	  2776: ;
                            	  2777: ; Returns:
                            	  2778: ; Y: adjusted cursor Y, or $F8 to hide it
                            	  2779: ;
                            	  2780: ; Description:
                            	  2781: ; Adjust the Y coordinate to account for the visible part of
                            	  2782: ; block cursor being in the bottom half of sprite.
                            	  2783: ; Also, make the cursor flash.
