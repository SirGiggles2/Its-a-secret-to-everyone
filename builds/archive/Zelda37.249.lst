02:0003AF30 41EC041F        	  2906:     lea     ($041F,A4),A0
02:0003AF34 10302000        	  2907:     move.b  (A0,D2.W),D0
02:0003AF38 023C00EE        	  2908:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AF3C 1214            	  2909:     move.b  ($0000,A4),D1
02:0003AF3E D101            	  2910:     addx.b  D1,D0   ; ADC $00
02:0003AF40 41EC041F        	  2911:     lea     ($041F,A4),A0
02:0003AF44 11802000        	  2912:     move.b  D0,(A0,D2.W)
                            	  2913:     ; Carry over to the high speed byte.
                            	  2914:     ;
02:0003AF48 41EC0412        	  2915:     lea     ($0412,A4),A0
02:0003AF4C 10302000        	  2916:     move.b  (A0,D2.W),D0
02:0003AF50 123C0000        	  2917:     move.b  #$00,D1
02:0003AF54 D101            	  2918:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AF56 41EC0412        	  2919:     lea     ($0412,A4),A0
02:0003AF5A 11802000        	  2920:     move.b  D0,(A0,D2.W)
                            	  2921:     ; *Signed comparison*:
                            	  2922:     ; If the high speed byte < high max speed byte, then return.
                            	  2923:     ;
                            	  2924:     ; Note that this is not a general purpose signed comparison,
                            	  2925:     ; which would be more complicated. But it works because
                            	  2926:     ; the deviation from 0 of both values is small.
                            	  2927:     ;
02:0003AF5E 122C0002        	  2928:     move.b  ($0002,A4),D1
