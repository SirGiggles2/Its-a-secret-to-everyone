                            	  2202: _TryShooting:
02:0003AA74 19400001        	  2203:     move.b  D0,($0001,A4)
                            	  2204:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  2205:     ;
02:0003AA78 41EC034F        	  2206:     lea     ($034F,A4),A0
02:0003AA7C 10302000        	  2207:     move.b  (A0,D2.W),D0
02:0003AA80 0C000003        	  2208:     cmpi.b  #$03,D0
02:0003AA84 6726            	  2209:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA86 0C000001        	  2210:     cmpi.b  #$01,D0
02:0003AA8A 6720            	  2211:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA8C 0C000009        	  2212:     cmpi.b  #$09,D0
02:0003AA90 671A            	  2213:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA92 0C00000A        	  2214:     cmpi.b  #$0A,D0
02:0003AA96 6714            	  2215:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA98 41EC0451        	  2216:     lea     ($0451,A4),A0
02:0003AA9C 10302000        	  2217:     move.b  (A0,D2.W),D0
02:0003AAA0 660A            	  2218:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2219:     ; and a random value < $F8, then return.
                            	  2220:     ;
02:0003AAA2 10342018        	  2221:     move.b  ($18,A4,D2.W),D0
02:0003AAA6 0C0000F8        	  2222:     cmpi.b  #$F8,D0
02:0003AAAA 656C            	  2223:     bcs  _L_z04__TryShooting_Exit
                            	  2224:     even
                            	  2225: _L_z04__TryShooting_TryShootingNow:
                            	  2226:     ; Summary
                            	  2227:     ;
                            	  2228:     ; if temporarily invincible then
                            	  2229:     ;   shoot timer := 0
                            	  2230:     ; elif shoot timer > 0 then
                            	  2231:     ;   decrement shoot timer
                            	  2232:     ; elif wants to shoot then
                            	  2233:     ;   shoot timer := $30
                            	  2234:     ;
                            	  2235:     ; qspeed := [01]
                            	  2236:     ;
                            	  2237:     ; if shoot timer <> 0 then
                            	  2238:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2239:     ;     shoot
                            	  2240:     ;     if succeeded then
                            	  2241:     ;       shoot timer := 0
                            	  2242:     ;       qspeed := 0
                            	  2243:     ;   else
                            	  2244:     ;     qspeed := 0
                            	  2245:     ;
                            	  2246:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:0003AAAC 102C0001        	  2247:     move.b  ($0001,A4),D0
02:0003AAB0 1883            	  2248:     move.b  D3,($0000,A4)
02:0003AAB2 1B00            	  2249:     move.b  D0,-(A5)  ; PHA
02:0003AAB4 7600            	  2250:     moveq   #0,D3
                            	  2251:     ; If not temporarily invincible,
                            	  2252:     ;
02:0003AAB6 41EC04F0        	  2253:     lea     ($04F0,A4),A0
02:0003AABA 10302000        	  2254:     move.b  (A0,D2.W),D0
02:0003AABE 661A            	  2255:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2256:     ; then Y := shoot timer - 1
                            	  2257:     ;
02:0003AAC0 7600            	  2258:     moveq   #0,D3
02:0003AAC2 41EC0451        	  2259:     lea     ($0451,A4),A0
02:0003AAC6 16302000        	  2260:     move.b  (A0,D2.W),D3
02:0003AACA 5303            	  2261:     subq.b  #1,D3
                            	  2262:     ; If Y register < 0, then shoot timer is 0.
                            	  2263:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2264:     ; Else go set a non-zero speed and return.
                            	  2265:     ;
02:0003AACC 6A0C            	  2266:     bpl  _L_z04__TryShooting_SetShootTimer
02:0003AACE 41EC0412        	  2267:     lea     ($0412,A4),A0
02:0003AAD2 10302000        	  2268:     move.b  (A0,D2.W),D0
02:0003AAD6 6736            	  2269:     beq  _L_z04__TryShooting_SetSpeed
02:0003AAD8 7630            	  2270:     moveq   #48,D3
                            	  2271:     even
                            	  2272: _L_z04__TryShooting_SetShootTimer:
                            	  2273:     ; shoot timer := Y
                            	  2274:     ;
02:0003AADA 1003            	  2275:     move.b  D3,D0
02:0003AADC 41EC0451        	  2276:     lea     ($0451,A4),A0
02:0003AAE0 11802000        	  2277:     move.b  D0,(A0,D2.W)
                            	  2278:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2279:     ;
02:0003AAE4 6728            	  2280:     beq  _L_z04__TryShooting_SetSpeed
                            	  2281:     ; shoot timer <> 0
                            	  2282:     ; If shoot timer <> $10, then go set a zero speed.
                            	  2283:     ;
02:0003AAE6 0C030010        	  2284:     cmpi.b  #$10,D3
02:0003AAEA 661C            	  2285:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2286:     ; If we have the magic clock, or the monster is stunned, then
                            	  2287:     ; go set a zero speed.
                            	  2288:     ;
02:0003AAEC 102C066C        	  2289:     move.b  ($066C,A4),D0
02:0003AAF0 1234203D        	  2290:     move.b  ($3D,A4,D2.W),D1
02:0003AAF4 8001            	  2291:     or.b  D1,D0
02:0003AAF6 6610            	  2292:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2293:     ; Shoot.
                            	  2294:     ;
02:0003AAF8 1014            	  2295:     move.b  ($0000,A4),D0
02:0003AAFA 611E            	  2296:     jsr     _ShootIfWanted2
                            	  2297:     ; If it failed, go set a non-zero speed.
                            	  2298:     ;
02:0003AAFC 6510            	  2299:     bcs  _L_z04__TryShooting_SetSpeed
                            	  2300:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  2301:     ;
02:0003AAFE 7000            	  2302:     moveq   #0,D0
02:0003AB00 41EC0412        	  2303:     lea     ($0412,A4),A0
02:0003AB04 11802000        	  2304:     move.b  D0,(A0,D2.W)
                            	  2305:     even
                            	  2306: _L_z04__TryShooting_ZeroSpeed:
02:0003AB08 101D            	  2307:     move.b  (A5)+,D0  ; PLA
02:0003AB0A 7000            	  2308:     moveq   #0,D0
