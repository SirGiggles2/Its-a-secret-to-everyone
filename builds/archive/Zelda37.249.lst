                            	  9583:     ; If Random:
                            	  9584:     ;   >= $B0: right
                            	  9585:     ;   >= $60: left
                            	  9586:     ;   Else:   down
                            	  9587:     ;
02:0003E010 7001            	  9588:     moveq   #1,D0
02:0003E012 7600            	  9589:     moveq   #0,D3
02:0003E014 16342018        	  9590:     move.b  ($18,A4,D2.W),D3
02:0003E018 0C0300B0        	  9591:     cmpi.b  #$B0,D3
