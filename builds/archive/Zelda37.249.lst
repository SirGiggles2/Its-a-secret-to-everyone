                            	  4019: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4020:     ; If the current heart's state <> 0, then go move it.
                            	  4021:     ; Else we have to wait for it to come out at the right time.
                            	  4022:     ;
02:0003B6CC 41EC00AC        	  4023:     lea     ($00AC,A4),A0
02:0003B6D0 10302000        	  4024:     move.b  (A0,D2.W),D0
02:0003B6D4 667C            	  4025:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4026:     ; The current heart's state = 0.
                            	  4027:     ;
                            	  4028:     ; If object slot = 2, then go make it appear. This is the first
                            	  4029:     ; heart to show up.
                            	  4030:     ;
02:0003B6D6 0C020002        	  4031:     cmpi.b  #$02,D2
02:0003B6DA 6732            	  4032:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4033:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4034:     ; go start over.
                            	  4035:     ;
                            	  4036:     ; TODO:
                            	  4037:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4038:     ;
02:0003B6DC 102C00AE        	  4039:     move.b  ($00AE,A4),D0
02:0003B6E0 67EA            	  4040:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4041:     ; Look up the starting angle of this heart with the index
                            	  4042:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4043:     ; then loop again.
                            	  4044:     ;
02:0003B6E2 1002            	  4045:     move.b  D2,D0
02:0003B6E4 003C0011        	  4046:     ori     #$11,CCR  ; SEC: set C+X
02:0003B6E8 123C0003        	  4047:     move.b  #$03,D1
02:0003B6EC 0A3C0010        	  4048:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B6F0 9101            	  4049:     subx.b  D1,D0   ; SBC #$03
02:0003B6F2 0A3C0010        	  4050:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B6F6 7600            	  4051:     moveq   #0,D3
02:0003B6F8 1600            	  4052:     move.b  D0,D3
02:0003B6FA 102C0396        	  4053:     move.b  ($0396,A4),D0
02:0003B6FE 41F90003B6C2    	  4054:     lea     (PondHeartStartAngles).l,A0
02:0003B704 12303000        	  4055:     move.b  (A0,D3.W),D1
02:0003B708 B001            	  4056:     cmp.b   D1,D0
02:0003B70A 66000086        	  4057:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4058:     even
