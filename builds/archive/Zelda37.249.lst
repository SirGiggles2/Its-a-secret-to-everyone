                            	  3592:     ; Else make the frame image 1 for the "down" frame.
                            	  3593:     ; Note that this is the frame image to use, even if there's no
                            	  3594:     ; down component in the direction.
                            	  3595:     ;
02:0003B458 522C000D        	  3596:     addq.b  #1,($000D,A4)
