02:0002BF8E 670A            	  2199:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2200:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2201:     eori    #$01,CCR
02:0002BF98 4E75            	  2202:     rts
                            	  2203: .cc_cnr:
02:0002BF9A 023C00FE        	  2204:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2205:     eori    #$01,CCR
02:0002BFA2 4E75            	  2206:     rts
