02:0003225A 0200000F        	  6585:     andi.b #$0F,D0
02:0003225E 122C000D        	  6586:     move.b  ($000D,A4),D1
02:00032262 B001            	  6587:     cmp.b   D1,D0
02:00032264 6554            	  6588:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00032266 102C066F        	  6589:     move.b  ($066F,A4),D0
02:0003226A 003C0011        	  6590:     ori     #$11,CCR  ; SEC: set C+X
02:0003226E 122C000D        	  6591:     move.b  ($000D,A4),D1
02:00032272 0A3C0010        	  6592:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032276 9101            	  6593:     subx.b  D1,D0   ; SBC $0D
02:00032278 0A3C0010        	  6594:     eori    #$10,CCR  ; restore X = 6502 C
02:0003227C 1940066F        	  6595:     move.b  D0,($066F,A4)
02:00032280 0A3C0001        	  6596:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00032284 4E75            	  6597:     rts
