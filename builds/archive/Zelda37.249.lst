                            	 12575: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12576:     ; Draw the four clouds at diagonal corners.
                            	 12577:     ;
02:0003F60C 610000B6        	 12578:     jsr     Ganon_GetCurCloudLeft
02:0003F610 610000BE        	 12579:     jsr     Ganon_GetCurCloudTop
02:0003F614 61A0            	 12580:     jsr     Ganon_DrawCloud
02:0003F616 610000B2        	 12581:     jsr     Ganon_GetCurCloudRight
02:0003F61A 619A            	 12582:     jsr     Ganon_DrawCloud
02:0003F61C 610000A6        	 12583:     jsr     Ganon_GetCurCloudLeft
02:0003F620 610000B4        	 12584:     jsr     Ganon_GetCurCloudBottom
02:0003F624 6190            	 12585:     jsr     Ganon_DrawCloud
02:0003F626 610000A2        	 12586:     jsr     Ganon_GetCurCloudRight
02:0003F62A 618A            	 12587:     jsr     Ganon_DrawCloud
                            	 12588:     ; Draw the top and bottom clouds.
