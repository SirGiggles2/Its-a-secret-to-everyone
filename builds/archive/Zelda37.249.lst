                            	  7409:     even
                            	  7410: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CF94 101D            	  7411:     move.b  (A5)+,D0  ; PLA
02:0003CF96 7600            	  7412:     moveq   #0,D3
02:0003CF98 1600            	  7413:     move.b  D0,D3
                            	  7414:     ; If facing vertically, then return. There's no other side to draw.
                            	  7415:     ;
02:0003CF9A 41EC0098        	  7416:     lea     ($0098,A4),A0
02:0003CF9E 10302000        	  7417:     move.b  (A0,D2.W),D0
02:0003CFA2 02000003        	  7418:     andi.b #$03,D0
02:0003CFA6 6602            	  7419:     bne.s  __far_z_04_0067
02:0003CFA8 602C            	  7420:     jmp  L11B00_Exit
                            	  7421: __far_z_04_0067:
                            	  7422:     ; Else draw the right side.
                            	  7423:     ;
                            	  7424:     ; Keep the Y coordinate in [01].
                            	  7425:     ; But, store (X + $10) in [00].
                            	  7426:     ;
02:0003CFAA 10342070        	  7427:     move.b  ($70,A4,D2.W),D0
02:0003CFAE 023C00EE        	  7428:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFB2 123C0010        	  7429:     move.b  #$10,D1
02:0003CFB6 D101            	  7430:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CFB8 1880            	  7431:     move.b  D0,($0000,A4)
02:0003CFBA 6114            	  7432:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7433:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7434:     ;
                            	  7435:     ; So, if we had animation frame 1, direction left:
                            	  7436:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7437:     ; - frame image index = 6 (1 + 5)
                            	  7438:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7439:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7440:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7441:     ;
                            	  7442:     ; So, 3 would have been the frame number used above for
                            	  7443:     ; the left side.
                            	  7444:     ;
                            	  7445:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7446:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7447:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7448:     ; on the right.
                            	  7449:     ;
02:0003CFBC 41F90003CEB2    	  7450:     lea     (DodongoFrameImages).l,A0
02:0003CFC2 10303000        	  7451:     move.b  (A0,D3.W),D0
02:0003CFC6 0A000001        	  7452:     eori.b #$01,D0
02:0003CFCA 4EF900031BCC    	  7453:     jmp     DrawObjectNotMirrored
