                            	  7109: Dodongo_TryEatBomb:
                            	  7110:     ; Try to eat the bomb.
                            	  7111:     ;
                            	  7112:     ; If the bomb is not in range of the monster, then return.
                            	  7113:     ;
                            	  7114:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7115:     ;
02:0003CDDE 7601            	  7116:     moveq   #1,D3
02:0003CDE0 616E            	  7117:     jsr     Dodongo_IsBombInRange
02:0003CDE2 6666            	  7118:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7119:     ; Will loop from 1 to 0, indexed by [00].
                            	  7120:     ;
02:0003CDE4 7001            	  7121:     moveq   #1,D0
02:0003CDE6 1880            	  7122:     move.b  D0,($0000,A4)
                            	  7123:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7124:     ;
02:0003CDE8 41EC0098        	  7125:     lea     ($0098,A4),A0
02:0003CDEC 10302000        	  7126:     move.b  (A0,D2.W),D0
02:0003CDF0 E208            	  7127:     lsr.b  #1,D0   ; LSR A
02:0003CDF2 7600            	  7128:     moveq   #0,D3
02:0003CDF4 1600            	  7129:     move.b  D0,D3
                            	  7130:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7131:     ; position depends on the orientation of the monster.
                            	  7132:     ;
                            	  7133:     ; Start with the horizontal distance.
                            	  7134:     ;
02:0003CDF6 102C0004        	  7135:     move.b  ($0004,A4),D0
                            	  7136:     even
                            	  7137: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7138:     ; Look up the limits for the given direction.
                            	  7139:     ;
                            	  7140:     ; If the distance from the bomb < negative limit,
                            	  7141:     ; or >= positive limit, then return.
                            	  7142:     ;
                            	  7143:     ; Note that these are simple signed comparisons that work,
                            	  7144:     ; because the operands are in a small range.
                            	  7145:     ;
02:0003CDFA 41F90003CD34    	  7146:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CE00 12303000        	  7147:     move.b  (A0,D3.W),D1
02:0003CE04 B001            	  7148:     cmp.b   D1,D0
02:0003CE06 6B42            	  7149:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CE08 41F90003CD3A    	  7150:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CE0E 12303000        	  7151:     move.b  (A0,D3.W),D1
02:0003CE12 B001            	  7152:     cmp.b   D1,D0
02:0003CE14 6A34            	  7153:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7154:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7155:     ;
02:0003CE16 1003            	  7156:     move.b  D3,D0
02:0003CE18 023C00EE        	  7157:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE1C 123C000A        	  7158:     move.b  #$0A,D1
02:0003CE20 D101            	  7159:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CE22 7600            	  7160:     moveq   #0,D3
02:0003CE24 1600            	  7161:     move.b  D0,D3
                            	  7162:     ; Bottom of the loop.
                            	  7163:     ;
                            	  7164:     ; Load the vertical distance for the next iteration.
                            	  7165:     ; Decrement loop counter.
                            	  7166:     ;
02:0003CE26 102C0005        	  7167:     move.b  ($0005,A4),D0
02:0003CE2A 5314            	  7168:     subq.b  #1,($0000,A4)
02:0003CE2C 6ACC            	  7169:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7170:     ; If we get here, then the bomb was within range of the mouth.
                            	  7171:     ; Go to state 1 (bloated).
                            	  7172:     ;
02:0003CE2E 41EC00AC        	  7173:     lea     ($00AC,A4),A0
02:0003CE32 52302000        	  7174:     addq.b  #1,(A0,D2.W)
                            	  7175:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7176:     ;
02:0003CE36 7610            	  7177:     moveq   #16,D3
02:0003CE38 7000            	  7178:     moveq   #0,D0
02:0003CE3A 41EC00AC        	  7179:     lea     ($00AC,A4),A0
02:0003CE3E 11803000        	  7180:     move.b  D0,(A0,D3.W)
02:0003CE42 41EC042C        	  7181:     lea     ($042C,A4),A0
02:0003CE46 11802000        	  7182:     move.b  D0,(A0,D2.W)
                            	  7183:     even
                            	  7184: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CE4A 4E75            	  7185:     rts
                            	  7186: 
                            	  7187:     even
                            	  7188: DodongoBombPositiveLimits:
02:0003CE4C 0C              	  7189:     dc.b    $0C, $11
02:0003CE4D 11
                            	  7190: 
                            	  7191:     even
                            	  7192: DodongoBombNegativeLimits:
02:0003CE4E F4              	  7193:     dc.b    $F4, $F0
02:0003CE4F F0
                            	  7194: 
                            	  7195: ; Params:
                            	  7196: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7197: ; [00]: monster hotspot X
                            	  7198: ; [01]: monster hotspot Y
                            	  7199: ; [02]: bomb hotspot X
                            	  7200: ; [03]: bomb hotspot Y
                            	  7201: ;
                            	  7202: ; Returns:
                            	  7203: ; A: 0 if the bomb is in range of the monster
                            	  7204: ; Z: 1 if the bomb is in range of the monster
                            	  7205: ; [04]: horizontal distance
                            	  7206: ; [05]: vertical distance
                            	  7207: ;
                            	  7208: ; Store the positive limit in [06], and the negative one in [07].
                            	  7209: ;
                            	  7210:     even
                            	  7211: Dodongo_IsBombInRange:
02:0003CE50 41F90003CE4C    	  7212:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CE56 10303000        	  7213:     move.b  (A0,D3.W),D0
02:0003CE5A 19400006        	  7214:     move.b  D0,($0006,A4)
02:0003CE5E 41F90003CE4E    	  7215:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CE64 10303000        	  7216:     move.b  (A0,D3.W),D0
02:0003CE68 19400007        	  7217:     move.b  D0,($0007,A4)
                            	  7218:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7219:     ; the bomb is near enough the monster.
                            	  7220:     ;
02:0003CE6C 7003            	  7221:     moveq   #3,D0
02:0003CE6E 19400008        	  7222:     move.b  D0,($0008,A4)
                            	  7223:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7224:     ;
02:0003CE72 7601            	  7225:     moveq   #1,D3
                            	  7226:     even
                            	  7227: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7228:     ; Subtract the bomb's coordinate from the boss's,
                            	  7229:     ; The loop index determines the coordinate.
                            	  7230:     ;
02:0003CE74 10343000        	  7231:     move.b  ($00,A4,D3.W),D0
02:0003CE78 003C0011        	  7232:     ori     #$11,CCR  ; SEC: set C+X
02:0003CE7C 12343002        	  7233:     move.b  ($02,A4,D3.W),D1
02:0003CE80 0A3C0010        	  7234:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CE84 9101            	  7235:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CE86 0A3C0010        	  7236:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7237:     ; If the distance >= positive offset, or < negative offset;
                            	  7238:     ; then loop again.
                            	  7239:     ;
02:0003CE8A 122C0006        	  7240:     move.b  ($0006,A4),D1
02:0003CE8E B001            	  7241:     cmp.b   D1,D0
02:0003CE90 6A16            	  7242:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CE92 122C0007        	  7243:     move.b  ($0007,A4),D1
02:0003CE96 B001            	  7244:     cmp.b   D1,D0
02:0003CE98 6B0E            	  7245:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7246:     ; The distance is close enough in this axis.
                            	  7247:     ;
                            	  7248:     ; Store the distance in this axis in [05] or [04],
                            	  7249:     ; depending on the loop index.
                            	  7250:     ;
02:0003CE9A 19803004        	  7251:     move.b  D0,($04,A4,D3.W)
                            	  7252:     ; Shift [08] right, because we're in range in this axis.
                            	  7253:     ;
02:0003CE9E 122C0008        	  7254:     move.b  ($0008,A4),D1
02:0003CEA2 E209            	  7255:     lsr.b  #1,D1   ; LSR $08
02:0003CEA4 19410008        	  7256:     move.b  D1,($0008,A4)
                            	  7257:     even
