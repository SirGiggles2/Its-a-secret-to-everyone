                            	  4868: UpdatePeaceTextbox:
                            	  4869:     ; Only emit a character once every 8 frames --
                            	  4870:     ; when (counter [0412] MOD 8) = 4.
                            	  4871:     ;
02:00036976 522C0412        	  4872:     addq.b  #1,($0412,A4)
02:0003697A 102C0412        	  4873:     move.b  ($0412,A4),D0
02:0003697E 02000007        	  4874:     andi.b #$07,D0
02:00036982 0C000004        	  4875:     cmpi.b  #$04,D0
02:00036986 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4877:     ; Copy the 5 bytes of the textbox character transfer record template
