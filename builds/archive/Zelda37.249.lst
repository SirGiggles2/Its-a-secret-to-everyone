02:0003DF92 02000003        	  9523:     andi.b #$03,D0
02:0003DF96 023C00EE        	  9524:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF9A 122C0003        	  9525:     move.b  ($0003,A4),D1
02:0003DF9E D101            	  9526:     addx.b  D1,D0   ; ADC $03
02:0003DFA0 41EC0451        	  9527:     lea     ($0451,A4),A0
02:0003DFA4 12302000        	  9528:     move.b  (A0,D2.W),D1
