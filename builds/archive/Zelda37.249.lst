02:00036A8C 123C0080        	  5009:     move.b  #$80,D1
02:00036A90 D101            	  5010:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00036A92 19400058        	  5011:     move.b  D0,($0058,A4)
                            	  5012:     ; Carry over to the tile offset and current V-scroll.
                            	  5013:     ;
