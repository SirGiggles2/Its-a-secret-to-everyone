                            	  6470: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6471:     ; Link and the shot are facing opposite directions.
                            	  6472:     ; Link can parry certain weapons/shots.
                            	  6473:     ;
                            	  6474:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6475:     ; no harmful collision; but it still counts as a shot collision.
                            	  6476:     ; So, go treat this as a parry.
                            	  6477:     ;
02:00032196 41EC034F        	  6478:     lea     ($034F,A4),A0
02:0003219A 10302000        	  6479:     move.b  (A0,D2.W),D0
02:0003219E 0C000055        	  6480:     cmpi.b  #$55,D0
02:000321A2 650E            	  6481:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:000321A4 0C00005B        	  6482:     cmpi.b  #$5B,D0
02:000321A8 6408            	  6483:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6484:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6485:     ; So, go harm Link.
                            	  6486:     ;
02:000321AA 102C0676        	  6487:     move.b  ($0676,A4),D0
02:000321AE 6602            	  6488:     bne.s  __far_z_01_0066
02:000321B0 600E            	  6489:     jmp  HarmLink
                            	  6490: __far_z_01_0066:
