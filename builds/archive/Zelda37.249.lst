                            	  7361: ; Description:
                            	  7362: ; Two sets of 5 elements:
                            	  7363: ; * left bound for objects
                            	  7364: ; * right bound for objects
                            	  7365: ; * up bound for objects
                            	  7366: ; * down bound for objects
