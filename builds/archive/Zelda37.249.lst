02:00041DD2 023C00EE        	  3478:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041DD6 123C0003        	  3479:     move.b  #$03,D1
02:00041DDA D101            	  3480:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041DDC 003C0011        	  3481:     ori     #$11,CCR  ; SEC: set C+X
02:00041DE0 41EC0084        	  3482:     lea     ($0084,A4),A0
