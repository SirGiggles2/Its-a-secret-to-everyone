                            	  7673: __far_z_04_0069:
                            	  7674:     ; Go to state 1.
                            	  7675:     ;
02:0003D17E 41EC00AC        	  7676:     lea     ($00AC,A4),A0
02:0003D182 52302000        	  7677:     addq.b  #1,(A0,D2.W)
                            	  7678:     ; Subtract 1 from facing direction to make an index.
                            	  7679:     ;
02:0003D186 7600            	  7680:     moveq   #0,D3
02:0003D188 41EC0098        	  7681:     lea     ($0098,A4),A0
02:0003D18C 16302000        	  7682:     move.b  (A0,D2.W),D3
02:0003D190 5303            	  7683:     subq.b  #1,D3
                            	  7684:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7685:     ;
02:0003D192 41EC0084        	  7686:     lea     ($0084,A4),A0
02:0003D196 10302000        	  7687:     move.b  (A0,D2.W),D0
02:0003D19A 0C000078        	  7688:     cmpi.b  #$78,D0
02:0003D19E 6402            	  7689:     bcc  _anon_z04_97
02:0003D1A0 7603            	  7690:     moveq   #3,D3
                            	  7691: _anon_z04_97:
