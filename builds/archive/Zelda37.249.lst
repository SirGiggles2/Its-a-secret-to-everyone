02:0003F498 41EC00AC        	 12376:     lea     ($00AC,A4),A0
02:0003F49C 53302000        	 12377:     subq.b  #1,(A0,D2.W)
                            	 12378:     ; If the state becomes 0, then Ganon is blue again.
