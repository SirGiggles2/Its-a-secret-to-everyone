                            	   150: TransferCurTileBuf:
                            	   151:     ; PATCHED: DynTileBuf pending-record pre-check (generalized Bug C fix).
                            	   152:     ; If DynTileBuf is non-empty while TileBufSelector already points at a
                            	   153:     ; later static buffer, consume DynTileBuf first and leave selector intact
                            	   154:     ; for the next NMI. This preserves NES ordering for dynamic room/menu
                            	   155:     ; records that would otherwise be dropped by selector timing drift.
02:00045726 41F900FF0302    	   156:     lea     (NES_RAM+DynTileBuf).l,A0
02:0004572C 0C1000FF        	   157:     cmpi.b  #$FF,(A0)                  ; DynTileBuf empty sentinel?
02:00045730 672E            	   158:     beq.s   .no_pending_dyn
02:00045732 4A2C0014        	   159:     tst.b   ($0014,A4)                  ; TileBufSelector = 0 => normal DynTileBuf path
02:00045736 6728            	   160:     beq.s   .no_pending_dyn
02:00045738 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:0004573C 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:00045742 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:00045746 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
02:0004574E 703F            	   165:     moveq   #63,D0
02:00045750 19400300        	   166:     move.b  D0,($0300,A4)
02:00045754 7400            	   167:     moveq   #0,D2
02:00045756 1942005C        	   168:     move.b  D2,($005C,A4)
02:0004575A 19420301        	   169:     move.b  D2,($0301,A4)
02:0004575E 4E75            	   170:     rts
                            	   171: .no_pending_dyn:
                            	   172:     ; 32-bit pointer table lookup for main dispatch.
02:00045760 7400            	   173:     moveq   #0,D2
02:00045762 142C0014        	   174:     move.b  ($0014,A4),D2
02:00045766 D442            	   175:     add.w   D2,D2                       ; 2-byte index -> 4-byte index
02:00045768 43F9000474CE    	   176:     lea     (TransferBufPtrs).l,A1
02:0004576E 20312000        	   177:     move.l  (A1,D2.W),D0               ; D0 = 32-bit buffer pointer
02:00045772 2040            	   178:     movea.l D0,A0                      ; A0 = 32-bit buffer pointer
02:00045774 611C            	   179:     jsr     TransferTileBuf
02:00045776 703F            	   180:     moveq   #63,D0
02:00045778 19400300        	   181:     move.b  D0,($0300,A4)
02:0004577C 7400            	   182:     moveq   #0,D2
02:0004577E 19420014        	   183:     move.b  D2,($0014,A4)
02:00045782 1942005C        	   184:     move.b  D2,($005C,A4)
02:00045786 19420301        	   185:     move.b  D2,($0301,A4)
02:0004578A 5302            	   186:     subq.b  #1,D2
02:0004578C 19420302        	   187:     move.b  D2,($0302,A4)
02:00045790 4E75            	   188:     rts
