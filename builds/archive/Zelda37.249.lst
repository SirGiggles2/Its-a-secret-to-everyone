02:0003C3F6 10342028        	  5783:     move.b  ($28,A4,D2.W),D0
02:0003C3FA 0C000010        	  5784:     cmpi.b  #$10,D0
02:0003C3FE 6702            	  5785:     beq.s  __far_z_04_0045
02:0003C400 6058            	  5786:     jmp  L1156B_Exit
