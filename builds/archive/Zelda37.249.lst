                            	  2429:     ; Update dynamic buffer length with 10 new bytes.
                            	  2430:     ;
02:0004AE58 1002            	  2431:     move.b  D2,D0
02:0004AE5A 023C00EE        	  2432:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AE5E 123C000A        	  2433:     move.b  #$0A,D1
02:0004AE62 D101            	  2434:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0004AE64 19400301        	  2435:     move.b  D0,($0301,A4)
02:0004AE68 101D            	  2436:     move.b  (A5)+,D0  ; PLA
02:0004AE6A 7400            	  2437:     moveq   #0,D2
02:0004AE6C 1400            	  2438:     move.b  D0,D2
02:0004AE6E 7005            	  2439:     moveq   #5,D0
