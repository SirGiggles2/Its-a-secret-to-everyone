                            	  3605:     even
                            	  3606: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3607:     ; Set horizontal flipping if right is a direction component.
                            	  3608:     ; This essentially the same test as above, but for when we jump
                            	  3609:     ; from the "up" test.
                            	  3610:     ;
02:0003B46C 41EC0098        	  3611:     lea     ($0098,A4),A0
02:0003B470 10302000        	  3612:     move.b  (A0,D2.W),D0
02:0003B474 02000002        	  3613:     andi.b #$02,D0
02:0003B478 6704            	  3614:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3615:     even
                            	  3616: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B47A 522C000F        	  3617:     addq.b  #1,($000F,A4)
                            	  3618:     even
                            	  3619: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B47E 102C000D        	  3620:     move.b  ($000D,A4),D0
                            	  3621: ; Params:
                            	  3622: ; A: frame image
                            	  3623: ; X: object index
                            	  3624: ; [00]: object X
                            	  3625: ; [01]: object Y
                            	  3626: ; [0F]: flip horizontally
                            	  3627: ;
                            	  3628: ; Returns:
                            	  3629: ; [00]: 0 for Link slot
                            	  3630: ; [06]: 1 if objects collide
                            	  3631: ; [09]: 0 for Link damage type (none)
                            	  3632: ; [0C]: 1 if objects collide
                            	  3633: ; [034B]: ShotCollidesWithLink
                            	  3634: ;
