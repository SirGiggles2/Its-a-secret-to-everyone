                            	  6852: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6853:     ; Bloated timer =>
                            	  6854:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6855:     ; 1:     go advance the substate
                            	  6856:     ; other: go decrement Bloated timer
                            	  6857:     ;
02:0003CC02 7600            	  6858:     moveq   #0,D3
02:0003CC04 41EC045E        	  6859:     lea     ($045E,A4),A0
02:0003CC08 16302000        	  6860:     move.b  (A0,D2.W),D3
02:0003CC0C 5303            	  6861:     subq.b  #1,D3
02:0003CC0E 6750            	  6862:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CC10 6B04            	  6863:     bmi.s  __far_z_04_0058
02:0003CC12 60000080        	  6864:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6865: __far_z_04_0058:
                            	  6866:     ; Set the bloated timer according to the substate.
                            	  6867:     ;
02:0003CC16 7600            	  6868:     moveq   #0,D3
02:0003CC18 41EC042C        	  6869:     lea     ($042C,A4),A0
02:0003CC1C 16302000        	  6870:     move.b  (A0,D2.W),D3
02:0003CC20 41F90003CB5E    	  6871:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003CC26 10303000        	  6872:     move.b  (A0,D3.W),D0
02:0003CC2A 41EC045E        	  6873:     lea     ($045E,A4),A0
02:0003CC2E 11802000        	  6874:     move.b  D0,(A0,D2.W)
                            	  6875:     ; If substate <> 0, go decrement bloated timer.
                            	  6876:     ;
02:0003CC32 4A03            	  6877:     cmpi.b  #$00,D3
02:0003CC34 6702            	  6878:     beq.s  __far_z_04_0059
02:0003CC36 605C            	  6879:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6880: __far_z_04_0059:
                            	  6881:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  6882:     ;
02:0003CC38 7610            	  6883:     moveq   #16,D3
02:0003CC3A 7000            	  6884:     moveq   #0,D0
02:0003CC3C 41EC00AC        	  6885:     lea     ($00AC,A4),A0
02:0003CC40 11803000        	  6886:     move.b  D0,(A0,D3.W)
                            	  6887:     ; Increment the number of bomb hits.
                            	  6888:     ;
02:0003CC44 41EC0437        	  6889:     lea     ($0437,A4),A0
02:0003CC48 10302000        	  6890:     move.b  (A0,D2.W),D0
02:0003CC4C 023C00EE        	  6891:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC50 123C0001        	  6892:     move.b  #$01,D1
02:0003CC54 D101            	  6893:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003CC56 41EC0437        	  6894:     lea     ($0437,A4),A0
02:0003CC5A 11802000        	  6895:     move.b  D0,(A0,D2.W)
02:0003CC5E 6034            	  6896:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  6897: 
