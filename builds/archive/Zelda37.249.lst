                            	  6899: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  6900:     ; Advance the substate.
                            	  6901:     ;
02:0003CC60 41EC042C        	  6902:     lea     ($042C,A4),A0
02:0003CC64 52302000        	  6903:     addq.b  #1,(A0,D2.W)
                            	  6904:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  6905:     ;
02:0003CC68 41EC042C        	  6906:     lea     ($042C,A4),A0
02:0003CC6C 10302000        	  6907:     move.b  (A0,D2.W),D0
02:0003CC70 0C000002        	  6908:     cmpi.b  #$02,D0
02:0003CC74 6402            	  6909:     bcc.s  __far_z_04_0060
02:0003CC76 601C            	  6910:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6911: __far_z_04_0060:
                            	  6912:     ; New bloated substate >= 2.
                            	  6913:     ;
                            	  6914:     ; If bomb hits < 2, then set bloated substate 4,
                            	  6915:     ; which will transition to state 0 (moving).
                            	  6916:     ;
                            	  6917:     ; Note that if the bomb hits >= 2, then:
                            	  6918:     ; - If new substate = 2, then substate 2 will wait,
