02:0002E8AC 162C0415        	   781:     move.b  ($0415,A4),D3
02:0002E8B0 41F90002DEE6    	   782:     lea     (PersonTextAddrs).l,A0
02:0002E8B6 10303000        	   783:     move.b  (A0,D3.W),D0
02:0002E8BA 1880            	   784:     move.b  D0,($0000,A4)
02:0002E8BC 5203            	   785:     addq.b  #1,D3
02:0002E8BE 41F90002DEE6    	   786:     lea     (PersonTextAddrs).l,A0
02:0002E8C4 10303000        	   787:     move.b  (A0,D3.W),D0
02:0002E8C8 19400001        	   788:     move.b  D0,($0001,A4)
                            	   789:     ; Load the person text current character index.
                            	   790:     ;
02:0002E8CC 7600            	   791:     moveq   #0,D3
02:0002E8CE 162C0416        	   792:     move.b  ($0416,A4),D3
                            	   793:     ; Increment the index variable to point to the next character
                            	   794:     ; for next time.
                            	   795:     ;
02:0002E8D2 522C0416        	   796:     addq.b  #1,($0416,A4)
                            	   797:     ; Get the current character.
                            	   798:     ;
02:0002E8D6 1214            	   799:     move.b  ($00,A4),D1   ; ptr lo
02:0002E8D8 182C0001        	   800:     move.b  ($01,A4),D4  ; ptr hi
02:0002E8DC 024100FF        	   801:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E8E0 E14C            	   802:     lsl.w   #8,D4
02:0002E8E2 8841            	   803:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E8E4 48C4            	   804:     ext.l   D4
02:0002E8E6 D8BC00FF0000    	   805:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E8EC 2044            	   806:     movea.l D4,A0
02:0002E8EE 10303000        	   807:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   808:     ; If the character is $25, then it's a special space. It will still
                            	   809:     ; take up space, but will not take time to show -- meaning that
                            	   810:     ; we'll go look up the next character to transfer.
                            	   811:     ;
02:0002E8F2 0200003F        	   812:     andi.b #$3F,D0
02:0002E8F6 0C000025        	   813:     cmpi.b  #$25,D0
02:0002E8FA 67A2            	   814:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
