                            	  4011: PondFairy_MoveHearts:
                            	  4012:     ; Loop over each heart from object slot 2 to 9.
                            	  4013:     ;
                            	  4014:     ; Even though they are not standalone objects, their info
                            	  4015:     ; is stored in those object slots.
