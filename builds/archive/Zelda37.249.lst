02:000369A2 162C0413        	  4892:     move.b  ($0413,A4),D3
02:000369A6 41F900036940    	  4893:     lea     (PeaceText).l,A0
02:000369AC 10303000        	  4894:     move.b  (A0,D3.W),D0
02:000369B0 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:000369B4 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000369B6 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
