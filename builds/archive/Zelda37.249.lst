02:000421F8 12303000        	  4094:     move.b  (A0,D3.W),D1
02:000421FC B001            	  4095:     cmp.b   D1,D0
02:000421FE 650E            	  4096:     bcs  _anon_z05_96
02:00042200 41F90004214E    	  4097:     lea     (DoorwayBoundsMaxUnder).l,A0
02:00042206 12303000        	  4098:     move.b  (A0,D3.W),D1
