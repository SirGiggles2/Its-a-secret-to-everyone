                            	  7295: Dodongo_Draw:
02:0003CEDA 610000F4        	  7296:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7297:     ; Make a 5-way direction index out of the facing direction
                            	  7298:     ; by shifting right once, and store it in [00].
                            	  7299:     ;
02:0003CEDE 41EC0098        	  7300:     lea     ($0098,A4),A0
02:0003CEE2 10302000        	  7301:     move.b  (A0,D2.W),D0
02:0003CEE6 E208            	  7302:     lsr.b  #1,D0   ; LSR A
02:0003CEE8 1880            	  7303:     move.b  D0,($0000,A4)
                            	  7304:     ; If state = 0, go handle animating the two frames of this state.
                            	  7305:     ;
02:0003CEEA 7600            	  7306:     moveq   #0,D3
02:0003CEEC 41EC00AC        	  7307:     lea     ($00AC,A4),A0
02:0003CEF0 16302000        	  7308:     move.b  (A0,D2.W),D3
02:0003CEF4 6744            	  7309:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7310:     ; If state > 1, then the monster is stunned (state 2).
                            	  7311:     ; So, go switch frames every $20 screen frames.
                            	  7312:     ;
02:0003CEF6 7020            	  7313:     moveq   #32,D0
02:0003CEF8 5303            	  7314:     subq.b  #1,D3
02:0003CEFA 6640            	  7315:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7316:     ; State = 1. Bloated.
                            	  7317:     ;
                            	  7318:     ; In substate 0, go animate as usual for walking.
                            	  7319:     ;
02:0003CEFC 7600            	  7320:     moveq   #0,D3
02:0003CEFE 41EC042C        	  7321:     lea     ($042C,A4),A0
02:0003CF02 16302000        	  7322:     move.b  (A0,D2.W),D3
02:0003CF06 6732            	  7323:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7324:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7325:     ; go fade the boss; so that some frames are not drawn.
                            	  7326:     ;
02:0003CF08 0C030002        	  7327:     cmpi.b  #$02,D3
02:0003CF0C 6718            	  7328:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CF0E 0C030003        	  7329:     cmpi.b  #$03,D3
02:0003CF12 6712            	  7330:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7331:     ; State 1, substate 1
                            	  7332:     ;
                            	  7333:     ; Add $14 to the frame image index to index into the bloated
                            	  7334:     ; frame images and H-flips.
                            	  7335:     ;
02:0003CF14 1014            	  7336:     move.b  ($0000,A4),D0
02:0003CF16 023C00EE        	  7337:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF1A 123C0014        	  7338:     move.b  #$14,D1
02:0003CF1E D101            	  7339:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CF20 7600            	  7340:     moveq   #0,D3
02:0003CF22 1600            	  7341:     move.b  D0,D3
02:0003CF24 6032            	  7342:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7343: 
                            	  7344:     even
                            	  7345: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7346:     ; In bloated substates 2 and 3:
                            	  7347:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7348:     ;
02:0003CF26 102C0015        	  7349:     move.b  ($0015,A4),D0
02:0003CF2A 02000002        	  7350:     andi.b #$02,D0
02:0003CF2E 6604            	  7351:     bne.s  __far_z_04_0066
02:0003CF30 600000A4        	  7352:     jmp  L11B00_Exit
                            	  7353: __far_z_04_0066:
02:0003CF34 7600            	  7354:     moveq   #0,D3
02:0003CF36 1614            	  7355:     move.b  ($0000,A4),D3
02:0003CF38 601E            	  7356:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
