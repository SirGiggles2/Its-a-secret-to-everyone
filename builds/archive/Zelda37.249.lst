02:0003DF10 10342070        	  9472:     move.b  ($70,A4,D2.W),D0
02:0003DF14 122C0003        	  9473:     move.b  ($0003,A4),D1
02:0003DF18 0A3C0010        	  9474:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DF1C 9101            	  9475:     subx.b  D1,D0   ; SBC $03
02:0003DF1E 0A3C0010        	  9476:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DF22 19802070        	  9477:     move.b  D0,($70,A4,D2.W)
                            	  9478:     even
