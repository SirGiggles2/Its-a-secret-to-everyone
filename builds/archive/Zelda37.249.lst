                            	 12174:     even
                            	 12175: UpdateGanon_JumpTable:
02:0003F37A 0003F386        	 12176:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F37E 0003F3E8        	 12177:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F382 0003F416        	 12178:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12179: 
                            	 12180: ; Description:
                            	 12181: ; Lift up the Triforce of Courage while the room is dark.
                            	 12182: ;
                            	 12183: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12184: ;
                            	 12185:     even
                            	 12186: Ganon_ScenePhase0:
02:0003F386 701B            	 12187:     moveq   #27,D0
02:0003F388 19400505        	 12188:     move.b  D0,($0505,A4)
                            	 12189:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12190:     ;
02:0003F38C 102C0028        	 12191:     move.b  ($0028,A4),D0
02:0003F390 6644            	 12192:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12193:     ; Once the timer expires, it's time to brighten the room.
                            	 12194:     ;
                            	 12195:     ; Save the current object slot.
02:0003F392 1002            	 12196:     move.b  D2,D0
02:0003F394 1B00            	 12197:     move.b  D0,-(A5)  ; PHA
02:0003F396 610007F0        	 12198:     jsr     UpdateCandle
02:0003F39A 101D            	 12199:     move.b  (A5)+,D0  ; PLA
02:0003F39C 7400            	 12200:     moveq   #0,D2
02:0003F39E 1400            	 12201:     move.b  D0,D2
                            	 12202:     ; Turn off the room brightening flag, because we're controlling it
                            	 12203:     ; here instead of in the Mode 5 object update loop.
                            	 12204:     ;
02:0003F3A0 7000            	 12205:     moveq   #0,D0
02:0003F3A2 1940051E        	 12206:     move.b  D0,($051E,A4)
                            	 12207:     ; On the first frame of the fade-to-light cycle, play the
                            	 12208:     ; Triforce/Ganon song.
                            	 12209:     ;
02:0003F3A6 102C051C        	 12210:     move.b  ($051C,A4),D0
02:0003F3AA 0C0000C0        	 12211:     cmpi.b  #$C0,D0
02:0003F3AE 6606            	 12212:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F3B0 7002            	 12213:     moveq   #2,D0
02:0003F3B2 19400600        	 12214:     move.b  D0,($0600,A4)
                            	 12215:     even
                            	 12216: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
