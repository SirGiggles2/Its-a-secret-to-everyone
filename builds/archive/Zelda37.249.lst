02:0003E19C 0C000008        	  9787:     cmpi.b  #$08,D0
02:0003E1A0 66C2            	  9788:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9789:     ; Roll over the eye animation counter to 0.
                            	  9790:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9791:     ;
02:0003E1A2 7000            	  9792:     moveq   #0,D0
02:0003E1A4 41EC0478        	  9793:     lea     ($0478,A4),A0
02:0003E1A8 11802000        	  9794:     move.b  D0,(A0,D2.W)
02:0003E1AC 41EC046B        	  9795:     lea     ($046B,A4),A0
02:0003E1B0 10302000        	  9796:     move.b  (A0,D2.W),D0
02:0003E1B4 02000001        	  9797:     andi.b #$01,D0
02:0003E1B8 0A000001        	  9798:     eori.b #$01,D0
