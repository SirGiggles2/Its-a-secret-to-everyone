                            	  2849: ;==============================================================================
                            	  2850: ; _transfer_tilebuf_fast -- Native tile buffer interpreter.
                            	  2851: ;
                            	  2852: ; Replaces TransferTileBuf + ContinueTransferTileBuf.
                            	  2853: ; Parses tile buffer records and dispatches by PPU address range into
                            	  2854: ; tight inner loops, avoiding per-byte _ppu_write_7 overhead.
                            	  2855: ;
                            	  2856: ; Input:
                            	  2857: ;   ($0000,A4) / ($0001,A4) = 16-bit NES RAM pointer to buffer start
                            	  2858: ;   A4 = NES_RAM ($FF0000)
                            	  2859: ;
                            	  2860: ; Output:
                            	  2861: ;   ($0000,A4) / ($0001,A4) updated past last consumed record
                            	  2862: ;   PPU_VADDR, PPU_CTRL, NT_CACHE, CRAM updated per record contents
                            	  2863: ;
                            	  2864: ; Preserves: D0, D2, D3, D7, A4, A5 (6502 register convention)
                            	  2865: ;==============================================================================
                            	  2866:     even
                            	  2867: _transfer_tilebuf_fast:
                            	  2868:     ; Caller passes buffer pointer in A0 (32-bit absolute address).
02:0002B0E6 48E7FFF0        	  2869:     movem.l D0-D7/A0-A3,-(SP)
                            	  2870: 
                            	  2871:     ; Reset PPU latch (matches _ppu_read_2 in original TransferTileBuf)
02:0002B0EA 423900FF0800    	  2872:     clr.b   (PPU_LATCH).l
                            	  2873: 
                            	  2874:     ; HUD guard hoisted out of inner loop: compute once here, reused per
                            	  2875:     ; tile in the .ttf_nt_range loop. D7.b = 1 if any cave-mode predicate
                            	  2876:     ; is active and NT rows 0-6 writes must be suppressed; 0 otherwise.
                            	  2877:     ; Was previously 3 memory reads + 3 compares per NT tile; now 1
                            	  2878:     ; tst.b D7 per tile. Matters because HUD updates touch hundreds of
                            	  2879:     ; tiles per frame and the guard runs on every one.
02:0002B0F0 7E00            	  2880:     moveq   #0,D7
02:0002B0F2 0C2C000B0012    	  2881:     cmpi.b  #$0B,($0012,A4)         ; mode == cave?
02:0002B0F8 6710            	  2882:     beq.s   .ttf_hud_guard_on
02:0002B0FA 0C2C00100012    	  2883:     cmpi.b  #$10,($0012,A4)         ; mode == stair transition?
02:0002B100 6708            	  2884:     beq.s   .ttf_hud_guard_on
02:0002B102 0C2C000B005B    	  2885:     cmpi.b  #$0B,($005B,A4)         ; target mode == cave?
02:0002B108 6602            	  2886:     bne.s   .ttf_hud_guard_off
                            	  2887: .ttf_hud_guard_on:
02:0002B10A 7E01            	  2888:     moveq   #1,D7
                            	  2889: .ttf_hud_guard_off:
                            	  2890: 
                            	  2891:     ; A0 = buffer pointer (set by caller via TransferBufPtrs)
                            	  2892:     ; A3 = safety limit: bail if buffer exceeds 2048 bytes (prevents runaway parsing)
02:0002B10C 47E80800        	  2893:     lea     (2048,A0),A3            ; largest buffer is ~1121 bytes
                            	  2894: 
                            	  2895: .ttf_next_record:
02:0002B110 B1CB            	  2896:     cmpa.l  A3,A0                   ; safety limit: bail if past 128 records
02:0002B112 6C00052C        	  2897:     bge     .ttf_done
02:0002B116 1018            	  2898:     move.b  (A0)+,D0                ; first byte of record
02:0002B118 6B000526        	  2899:     bmi     .ttf_done               ; bit 7 set ($80-$FF) = sentinel -> done
                            	  2900: 
                            	  2901:     ; --- Parse record header ---
                            	  2902:     ; D0.b = PPU addr hi byte
02:0002B11C 7A00            	  2903:     moveq   #0,D5
02:0002B11E 1A00            	  2904:     move.b  D0,D5
02:0002B120 E14D            	  2905:     lsl.w   #8,D5
02:0002B122 1A18            	  2906:     move.b  (A0)+,D5                ; D5.w = PPU address
02:0002B124 02453FFF        	  2907:     andi.w  #$3FFF,D5
                            	  2908: 
02:0002B128 1C18            	  2909:     move.b  (A0)+,D6                ; D6.b = control byte
                            	  2910: 
                            	  2911:     ; Decode count (bits 5:0, 0 means 64)
02:0002B12A 7600            	  2912:     moveq   #0,D3
02:0002B12C 1606            	  2913:     move.b  D6,D3
02:0002B12E 0243003F        	  2914:     andi.w  #$003F,D3
02:0002B132 6602            	  2915:     bne.s   .ttf_count_ok
02:0002B134 7640            	  2916:     moveq   #64,D3
                            	  2917: .ttf_count_ok:
                            	  2918: 
                            	  2919:     ; NES control byte layout (after two ASLs in original 6502):
                            	  2920:     ;   Bit 7 = increment mode: 0 = horizontal (+1), 1 = vertical (+32)
                            	  2921:     ;   Bit 6 = repeat mode:    0 = sequential,      1 = repeat single byte
                            	  2922: 
                            	  2923:     ; Decode increment (bit 7): 1 or 32
02:0002B136 7201            	  2924:     moveq   #1,D1                   ; D1.w = increment
02:0002B138 08060007        	  2925:     btst    #7,D6
02:0002B13C 6702            	  2926:     beq.s   .ttf_inc_ok
02:0002B13E 7220            	  2927:     moveq   #32,D1
                            	  2928: .ttf_inc_ok:
                            	  2929: 
                            	  2930:     ; Decode repeat mode (bit 6): prefetch single data byte
02:0002B140 7800            	  2931:     moveq   #0,D4                   ; D4.b = 0 = sequential mode
02:0002B142 08060006        	  2932:     btst    #6,D6
02:0002B146 6704            	  2933:     beq.s   .ttf_no_repeat
02:0002B148 1418            	  2934:     move.b  (A0)+,D2                ; D2.b = repeat data byte
02:0002B14A 78FF            	  2935:     moveq   #-1,D4                  ; D4.b = $FF = repeat mode
                            	  2936: .ttf_no_repeat:
                            	  2937: 
                            	  2938:     ; Update PPU_CTRL bit 2 (increment mode) + NES RAM $00FF
02:0002B14C 102C00FF        	  2939:     move.b  ($00FF,A4),D0
02:0002B150 08060007        	  2940:     btst    #7,D6
