                            	  9405: Manhandla_Move:
                            	  9406:     ; Implement a way of manifesting the fractional part of the speed
                            	  9407:     ; in the movement.
                            	  9408:     ;
                            	  9409:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9410:     ; byte to add to the coordinates, then the effective speed would
                            	  9411:     ; be 1 pixel a frame instead of 1.25.
                            	  9412:     ;
                            	  9413:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9414:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9415:     ;
                            	  9416:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9417:     ;
                            	  9418:     ;   SA := SA + (SL AND $E0)
                            	  9419:     ;   [03] := SH + carry
                            	  9420:     ;
                            	  9421:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9422:     ;
02:0003DE98 41EC041F        	  9423:     lea     ($041F,A4),A0
02:0003DE9C 10302000        	  9424:     move.b  (A0,D2.W),D0
02:0003DEA0 020000E0        	  9425:     andi.b #$E0,D0
02:0003DEA4 023C00EE        	  9426:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DEA8 41EC0412        	  9427:     lea     ($0412,A4),A0
02:0003DEAC 12302000        	  9428:     move.b  (A0,D2.W),D1
02:0003DEB0 D101            	  9429:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DEB2 41EC0412        	  9430:     lea     ($0412,A4),A0
02:0003DEB6 11802000        	  9431:     move.b  D0,(A0,D2.W)
                            	  9432:     ; Assign (high speed byte + carry) to [03].
                            	  9433:     ;
02:0003DEBA 41EC042C        	  9434:     lea     ($042C,A4),A0
02:0003DEBE 10302000        	  9435:     move.b  (A0,D2.W),D0
02:0003DEC2 123C0000        	  9436:     move.b  #$00,D1
02:0003DEC6 D101            	  9437:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DEC8 19400003        	  9438:     move.b  D0,($0003,A4)
                            	  9439:     ; Change coordinates by the speed amount/offset in [03]
                            	  9440:     ; according to the direction.
                            	  9441:     ;
                            	  9442:     ; Start with a mask of $A1 in [02]:
                            	  9443:     ; - low nibble represents the right direction
                            	  9444:     ; - high nibble is used to set or clear carry as we go along
                            	  9445:     ;
02:0003DECC 103C00A1        	  9446:     move.b  #$A1,D0
02:0003DED0 19400002        	  9447:     move.b  D0,($0002,A4)
                            	  9448:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9449:     ;
02:0003DED4 41EC0098        	  9450:     lea     ($0098,A4),A0
02:0003DED8 10302000        	  9451:     move.b  (A0,D2.W),D0
02:0003DEDC 122C0002        	  9452:     move.b  ($0002,A4),D1
02:0003DEE0 C200            	  9453:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEE2 6712            	  9454:     beq  _L_z04_Manhandla_Move_Left
02:0003DEE4 10342070        	  9455:     move.b  ($70,A4,D2.W),D0
02:0003DEE8 023C00EE        	  9456:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DEEC 122C0003        	  9457:     move.b  ($0003,A4),D1
02:0003DEF0 D101            	  9458:     addx.b  D1,D0   ; ADC $03
02:0003DEF2 19802070        	  9459:     move.b  D0,($70,A4,D2.W)
                            	  9460:     even
                            	  9461: _L_z04_Manhandla_Move_Left:
