02:0003DEFE 122C0002        	  9466:     move.b  ($0002,A4),D1
02:0003DF02 E309            	  9467:     lsl.b  #1,D1   ; ASL $02
02:0003DF04 19410002        	  9468:     move.b  D1,($0002,A4)
02:0003DF08 122C0002        	  9469:     move.b  ($0002,A4),D1
02:0003DF0C C200            	  9470:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
