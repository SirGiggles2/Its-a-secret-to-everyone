                            	  2663: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2664:     ; State 1. Jumping.
                            	  2665:     ;
                            	  2666:     ; Keep the object inside the bounds of the room.
                            	  2667:     ;
02:0003AD5C 61004FB6        	  2668:     jsr     BoundFlyer
                            	  2669:     ; If the object was blocked at the room boundary, then
                            	  2670:     ; increase boundary reversal count, and go set up another jump.
                            	  2671:     ;
02:0003AD60 102C000F        	  2672:     move.b  ($000F,A4),D0
02:0003AD64 660C            	  2673:     bne  _anon_z04_37
02:0003AD66 41EC0451        	  2674:     lea     ($0451,A4),A0
02:0003AD6A 52302000        	  2675:     addq.b  #1,(A0,D2.W)
02:0003AD6E 6000FF74        	  2676:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2677: 
                            	  2678: _anon_z04_37:
02:0003AD72 61000196        	  2679:     jsr     Jumper_PointBoulderDownward
                            	  2680:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2681:     ;
02:0003AD76 7000            	  2682:     moveq   #0,D0
02:0003AD78 41EC0451        	  2683:     lea     ($0451,A4),A0
02:0003AD7C 11802000        	  2684:     move.b  D0,(A0,D2.W)
                            	  2685:     ; Get the base offset for the kind of jumper the object is.
                            	  2686:     ;
02:0003AD80 6100015E        	  2687:     jsr     Jumper_GetKind
02:0003AD84 41F90003AC70    	  2688:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003AD8A 10303000        	  2689:     move.b  (A0,D3.W),D0
                            	  2690:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2691:     ;
                            	  2692:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2693:     ; does not have $B elements like the tektites' sets.
                            	  2694:     ;
                            	  2695:     ; Boulder does not need the upward accelerations.
                            	  2696:     ; So, the elements for those are used for the starting speeds
                            	  2697:     ; at 04:88F2.
                            	  2698:     ;
02:0003AD8E 023C00EE        	  2699:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD92 41EC0098        	  2700:     lea     ($0098,A4),A0
02:0003AD96 12302000        	  2701:     move.b  (A0,D2.W),D1
02:0003AD9A D101            	  2702:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003AD9C 7600            	  2703:     moveq   #0,D3
02:0003AD9E 1600            	  2704:     move.b  D0,D3
02:0003ADA0 41F90003AC4E    	  2705:     lea     (JumperYAccelerations).l,A0
02:0003ADA6 10303000        	  2706:     move.b  (A0,D3.W),D0
02:0003ADAA 7602            	  2707:     moveq   #2,D3
02:0003ADAC 61000162        	  2708:     jsr     Jumper_MoveY
                            	  2709:     ; If the facing direction has a left component, then
                            	  2710:     ; subtract 1 from the object's X.
                            	  2711:     ;
                            	  2712:     ; Else add 1.
                            	  2713:     ;
02:0003ADB0 163C00FF        	  2714:     move.b  #$FF,D3
02:0003ADB4 41EC0098        	  2715:     lea     ($0098,A4),A0
02:0003ADB8 10302000        	  2716:     move.b  (A0,D2.W),D0
02:0003ADBC 02000002        	  2717:     andi.b #$02,D0
02:0003ADC0 6602            	  2718:     bne  _anon_z04_38
02:0003ADC2 7601            	  2719:     moveq   #1,D3
                            	  2720: _anon_z04_38:
02:0003ADC4 1003            	  2721:     move.b  D3,D0
02:0003ADC6 023C00EE        	  2722:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADCA 12342070        	  2723:     move.b  ($70,A4,D2.W),D1
02:0003ADCE D101            	  2724:     addx.b  D1,D0   ; ADC ObjX,X
02:0003ADD0 19802070        	  2725:     move.b  D0,($70,A4,D2.W)
                            	  2726:     ; If going up (negative v-speed high byte), then
                            	  2727:     ; go animate, draw, and check collisions.
                            	  2728:     ;
02:0003ADD4 41EC0412        	  2729:     lea     ($0412,A4),A0
02:0003ADD8 10302000        	  2730:     move.b  (A0,D2.W),D0
02:0003ADDC 6A04            	  2731:     bpl.s  __far_z_04_0022
02:0003ADDE 60000090        	  2732:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2733: __far_z_04_0022:
                            	  2734:     ; Going down. We have to consider the target Y.
                            	  2735:     ;
                            	  2736:     ; If the absolute vertical distance to the target position >= 3,
                            	  2737:     ; then go animate, draw, and check collisions.
                            	  2738:     ;
02:0003ADE2 41EC0084        	  2739:     lea     ($0084,A4),A0
02:0003ADE6 10302000        	  2740:     move.b  (A0,D2.W),D0
02:0003ADEA 003C0011        	  2741:     ori     #$11,CCR  ; SEC: set C+X
02:0003ADEE 41EC0444        	  2742:     lea     ($0444,A4),A0
02:0003ADF2 12302000        	  2743:     move.b  (A0,D2.W),D1
02:0003ADF6 0A3C0010        	  2744:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ADFA 9101            	  2745:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003ADFC 0A3C0010        	  2746:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AE00 4EB900031078    	  2747:     jsr     Abs
02:0003AE06 0C000003        	  2748:     cmpi.b  #$03,D0
02:0003AE0A 6502            	  2749:     bcs.s  __far_z_04_0023
02:0003AE0C 6062            	  2750:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2751: __far_z_04_0023:
                            	  2752:     ; Distance < 3. Go to state 0.
                            	  2753:     ;
                            	  2754:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2755:     ;
02:0003AE0E 4EB90004C8C2    	  2756:     jsr     ResetObjState
02:0003AE14 7600            	  2757:     moveq   #0,D3
02:0003AE16 41EC034F        	  2758:     lea     ($034F,A4),A0
02:0003AE1A 16302000        	  2759:     move.b  (A0,D2.W),D3
02:0003AE1E 0C030020        	  2760:     cmpi.b  #$20,D3
02:0003AE22 6748            	  2761:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2762:     ; Else calculate a timer value.
                            	  2763:     ;
                            	  2764:     ; t := (Random + $10)
                            	  2765:     ; if t < $20 then
                            	  2766:     ;   t := t - $40
                            	  2767:     ;
02:0003AE24 7010            	  2768:     moveq   #16,D0
02:0003AE26 023C00EE        	  2769:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE2A 12342019        	  2770:     move.b  ($19,A4,D2.W),D1
02:0003AE2E D101            	  2771:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AE30 0C000020        	  2772:     cmpi.b  #$20,D0
02:0003AE34 6412            	  2773:     bcc  _anon_z04_39
02:0003AE36 003C0011        	  2774:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE3A 123C0040        	  2775:     move.b  #$40,D1
02:0003AE3E 0A3C0010        	  2776:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE42 9101            	  2777:     subx.b  D1,D0   ; SBC #$40
02:0003AE44 0A3C0010        	  2778:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2779: _anon_z04_39:
                            	  2780:     ; If the object is a blue tektite, then go use this t.
                            	  2781:     ;
02:0003AE48 7600            	  2782:     moveq   #0,D3
02:0003AE4A 41EC034F        	  2783:     lea     ($034F,A4),A0
02:0003AE4E 16302000        	  2784:     move.b  (A0,D2.W),D3
02:0003AE52 0C03000D        	  2785:     cmpi.b  #$0D,D3
02:0003AE56 6714            	  2786:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2787:     ; t := t AND $7F
                            	  2788:     ;
02:0003AE58 0200007F        	  2789:     andi.b #$7F,D0
                            	  2790:     ; If Random < $A0, then go use this t.
                            	  2791:     ;
02:0003AE5C 7600            	  2792:     moveq   #0,D3
02:0003AE5E 16342019        	  2793:     move.b  ($19,A4,D2.W),D3
02:0003AE62 0C0300A0        	  2794:     cmpi.b  #$A0,D3
02:0003AE66 6504            	  2795:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2796:     ; t := t AND $F
                            	  2797:     ;
02:0003AE68 0200000F        	  2798:     andi.b #$0F,D0
                            	  2799:     even
