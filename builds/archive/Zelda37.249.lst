02:000352CA 41F900034B92    	  2697:     lea     (ModeEandFCursorSprites).l,A0
02:000352D0 10303000        	  2698:     move.b  (A0,D3.W),D0
02:000352D4 41EC0201        	  2699:     lea     ($0201,A4),A0
02:000352D8 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:000352DC 5303            	  2701:     subq.b  #1,D3
02:000352DE 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:000352E0 7600            	  2703:     moveq   #0,D3
02:000352E2 162C0016        	  2704:     move.b  ($0016,A4),D3
02:000352E6 41F900034B48    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:000352EC 10303000        	  2706:     move.b  (A0,D3.W),D0
02:000352F0 19400084        	  2707:     move.b  D0,($0084,A4)
02:000352F4 19400200        	  2708:     move.b  D0,($0200,A4)
02:000352F8 102C0012        	  2709:     move.b  ($0012,A4),D0
02:000352FC 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00035300 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
