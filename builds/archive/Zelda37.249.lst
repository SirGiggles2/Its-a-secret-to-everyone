                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:000419E8 4EB900031074    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:000419EE 102C0070        	  2879:     move.b  ($0070,A4),D0
02:000419F2 0C030002        	  2880:     cmpi.b  #$02,D3
02:000419F6 6404            	  2881:     bcc  _anon_z05_74
02:000419F8 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:000419FC 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:00041A00 1003            	  2887:     move.b  D3,D0
02:00041A02 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:00041A04 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A08 123C0008        	  2890:     move.b  #$08,D1
02:00041A0C D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041A0E 7600            	  2892:     moveq   #0,D3
02:00041A10 1600            	  2893:     move.b  D0,D3
02:00041A12 103C0080        	  2894:     move.b  #$80,D0
02:00041A16 6134            	  2895:     jsr     MaskInputInBorder
02:00041A18 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:00041A1A 7600            	  2897:     moveq   #0,D3
02:00041A1C 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:00041A1E 102C0001        	  2902:     move.b  ($0001,A4),D0
