02:00045278 6100586A        	  8704:     jsr     GetRoomFlags
02:0004527C 102C00EB        	  8705:     move.b  ($00EB,A4),D0
02:00045280 1B00            	  8706:     move.b  D0,-(A5)  ; PHA
                            	  8707:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8708:     ; in order to look up its information.
                            	  8709:     ;
