                            	  7033: Dodongo_CheckBombHit:
                            	  7034:     ; If state <> 0 (not moving), then return.
                            	  7035:     ;
02:0003CD4C 41EC00AC        	  7036:     lea     ($00AC,A4),A0
02:0003CD50 10302000        	  7037:     move.b  (A0,D2.W),D0
02:0003CD54 66000086        	  7038:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7039:     ; If facing vertically, then store (X + 8) in [00].
                            	  7040:     ; Else store (X + $10).
                            	  7041:     ;
02:0003CD58 10342070        	  7042:     move.b  ($70,A4,D2.W),D0
02:0003CD5C 023C00EE        	  7043:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD60 123C0008        	  7044:     move.b  #$08,D1
02:0003CD64 D101            	  7045:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD66 7600            	  7046:     moveq   #0,D3
02:0003CD68 41EC0098        	  7047:     lea     ($0098,A4),A0
02:0003CD6C 16302000        	  7048:     move.b  (A0,D2.W),D3
02:0003CD70 0C030004        	  7049:     cmpi.b  #$04,D3
02:0003CD74 6406            	  7050:     bcc  _anon_z04_91
02:0003CD76 123C0008        	  7051:     move.b  #$08,D1
02:0003CD7A D101            	  7052:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7053: _anon_z04_91:
02:0003CD7C 1880            	  7054:     move.b  D0,($0000,A4)
                            	  7055:     ; Store (Y + 8) in [01].
                            	  7056:     ;
02:0003CD7E 41EC0084        	  7057:     lea     ($0084,A4),A0
02:0003CD82 10302000        	  7058:     move.b  (A0,D2.W),D0
02:0003CD86 123C0008        	  7059:     move.b  #$08,D1
02:0003CD8A D101            	  7060:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD8C 19400001        	  7061:     move.b  D0,($0001,A4)
                            	  7062:     ; Only check the first bomb slot ($10).
                            	  7063:     ;
                            	  7064:     ; Store the bomb's (X + 8) in [02].
                            	  7065:     ;
02:0003CD90 7610            	  7066:     moveq   #16,D3
02:0003CD92 10343070        	  7067:     move.b  ($70,A4,D3.W),D0
02:0003CD96 123C0008        	  7068:     move.b  #$08,D1
02:0003CD9A D101            	  7069:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD9C 19400002        	  7070:     move.b  D0,($0002,A4)
                            	  7071:     ; Store the bomb's (Y + 8) in [03].
                            	  7072:     ;
02:0003CDA0 41EC0084        	  7073:     lea     ($0084,A4),A0
02:0003CDA4 10303000        	  7074:     move.b  (A0,D3.W),D0
02:0003CDA8 123C0008        	  7075:     move.b  #$08,D1
02:0003CDAC D101            	  7076:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CDAE 19400003        	  7077:     move.b  D0,($0003,A4)
                            	  7078:     ; But, if there's no bomb, then return.
                            	  7079:     ;
02:0003CDB2 41EC00AC        	  7080:     lea     ($00AC,A4),A0
02:0003CDB6 10303000        	  7081:     move.b  (A0,D3.W),D0
02:0003CDBA 6720            	  7082:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7083:     ; If the bomb has not exploded (state $12), then
                            	  7084:     ; go see if Dodongo will eat it.
                            	  7085:     ;
02:0003CDBC 0C000012        	  7086:     cmpi.b  #$12,D0
02:0003CDC0 6602            	  7087:     bne.s  __far_z_04_0065
02:0003CDC2 601A            	  7088:     jmp  Dodongo_TryEatBomb
                            	  7089: __far_z_04_0065:
                            	  7090:     ; If the object in the slot is actually a fire, then return.
                            	  7091:     ;
02:0003CDC4 0C000020        	  7092:     cmpi.b  #$20,D0
02:0003CDC8 6412            	  7093:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7094:     ; The bomb already blew up.
                            	  7095:     ; If the dust cloud is in range of the monster,
