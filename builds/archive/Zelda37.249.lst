                            	  4316: 
                            	  4317: ; Params:
                            	  4318: ; Y: middle speed index (4)
                            	  4319: ; [03]: horizontal distance
                            	  4320: ; [04]: vertical distance
                            	  4321: ; [0A]: vertical direction
                            	  4322: ; [0B]: horizontal direction
                            	  4323: ;
                            	  4324: ; Returns:
                            	  4325: ; Y: speed index (0 to 8) for the angle
                            	  4326: ;
                            	  4327: ;
                            	  4328: ; TODO: call it speed index or angle?
                            	  4329: ; Store the middle speed index in [00]. It will be changed to the
                            	  4330: ; right speed index to use incrementally.
                            	  4331: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4332: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4333: ;
                            	  4334:     even
                            	  4335: _CalcDiagonalSpeedIndex:
02:0003111A 1883            	  4336:     move.b  D3,($0000,A4)
                            	  4337:     ; Assuming horizontal distance >= vertical distance, the
                            	  4338:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4339:     ;
02:0003111C 103C00FF        	  4340:     move.b  #$FF,D0
02:00031120 19400001        	  4341:     move.b  D0,($0001,A4)
                            	  4342:     ; TODO:
                            	  4343:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4344:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4345:     ;
                            	  4346:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4347:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4348:     ; of the farther distance faster.
                            	  4349:     ;
02:00031124 102C0003        	  4350:     move.b  ($0003,A4),D0
02:00031128 122C0004        	  4351:     move.b  ($0004,A4),D1
02:0003112C B001            	  4352:     cmp.b   D1,D0
02:0003112E 6416            	  4353:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00031130 1B00            	  4354:     move.b  D0,-(A5)  ; PHA
02:00031132 102C0004        	  4355:     move.b  ($0004,A4),D0
02:00031136 19400003        	  4356:     move.b  D0,($0003,A4)
02:0003113A 101D            	  4357:     move.b  (A5)+,D0  ; PLA
02:0003113C 19400004        	  4358:     move.b  D0,($0004,A4)
02:00031140 7001            	  4359:     moveq   #1,D0
02:00031142 19400001        	  4360:     move.b  D0,($0001,A4)
                            	  4361:     even
                            	  4362: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4363:     ; TODO: call it speed index or angle?
                            	  4364:     ; If the difference in distances is within 8 pixels,
                            	  4365:     ; return the speed index (angle) we have.
                            	  4366:     ;
02:00031146 102C0003        	  4367:     move.b  ($0003,A4),D0
02:0003114A 003C0011        	  4368:     ori     #$11,CCR  ; SEC: set C+X
02:0003114E 122C0004        	  4369:     move.b  ($0004,A4),D1
02:00031152 0A3C0010        	  4370:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031156 9101            	  4371:     subx.b  D1,D0   ; SBC $04
02:00031158 0A3C0010        	  4372:     eori    #$10,CCR  ; restore X = 6502 C
02:0003115C 0C000008        	  4373:     cmpi.b  #$08,D0
02:00031160 6538            	  4374:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4375:     even
                            	  4376: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4377:     ; TODO: call it speed index or angle?
                            	  4378:     ; Otherwise, go to the next speed index (angle).
                            	  4379:     ;
02:00031162 1014            	  4380:     move.b  ($0000,A4),D0
02:00031164 023C00EE        	  4381:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031168 122C0001        	  4382:     move.b  ($0001,A4),D1
02:0003116C D101            	  4383:     addx.b  D1,D0   ; ADC $01
02:0003116E 1880            	  4384:     move.b  D0,($0000,A4)
                            	  4385:     ; TODO: call it speed index or angle?
                            	  4386:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4387:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4388:     ;
02:00031170 6728            	  4389:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00031172 0C000008        	  4390:     cmpi.b  #$08,D0
02:00031176 6722            	  4391:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4392:     ; Subtract the lesser distance from the greater distance.
                            	  4393:     ; If they still haven't crossed, then we can turn more.
                            	  4394:     ;
02:00031178 102C0003        	  4395:     move.b  ($0003,A4),D0
02:0003117C 003C0011        	  4396:     ori     #$11,CCR  ; SEC: set C+X
02:00031180 122C0004        	  4397:     move.b  ($0004,A4),D1
02:00031184 0A3C0010        	  4398:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031188 9101            	  4399:     subx.b  D1,D0   ; SBC $04
02:0003118A 0A3C0010        	  4400:     eori    #$10,CCR  ; restore X = 6502 C
02:0003118E 19400003        	  4401:     move.b  D0,($0003,A4)
02:00031192 122C0004        	  4402:     move.b  ($0004,A4),D1
02:00031196 B001            	  4403:     cmp.b   D1,D0
02:00031198 64C8            	  4404:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4405:     even
