                            	 12497: Ganon_SetUpBurstRays:
                            	 12498:     ; Loop over 8 burst rays, from 7 to 0, indexed by Y register.
                            	 12499:     ; Access object slots 9 to 2.
                            	 12500:     ;
02:0003F574 7607            	 12501:     moveq   #7,D3
                            	 12502:     even
                            	 12503: _L_z04_Ganon_SetUpBurstRays_LoopRay:
                            	 12504:     ; Start each piece at offset (4, 4) from Ganon's location.
                            	 12505:     ;
02:0003F576 10342070        	 12506:     move.b  ($70,A4,D2.W),D0
02:0003F57A 023C00EE        	 12507:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F57E 123C0004        	 12508:     move.b  #$04,D1
02:0003F582 D101            	 12509:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F584 19803072        	 12510:     move.b  D0,($72,A4,D3.W)
02:0003F588 41EC0084        	 12511:     lea     ($0084,A4),A0
02:0003F58C 10302000        	 12512:     move.b  (A0,D2.W),D0
02:0003F590 123C0004        	 12513:     move.b  #$04,D1
02:0003F594 D101            	 12514:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F596 41EC0086        	 12515:     lea     ($0086,A4),A0
02:0003F59A 11803000        	 12516:     move.b  D0,(A0,D3.W)
                            	 12517:     ; Set the direction.
                            	 12518:     ;
02:0003F59E 41F90003F558    	 12519:     lea     (GanonBurstDirs).l,A0
02:0003F5A4 10303000        	 12520:     move.b  (A0,D3.W),D0
02:0003F5A8 41EC009A        	 12521:     lea     ($009A,A4),A0
02:0003F5AC 11803000        	 12522:     move.b  D0,(A0,D3.W)
02:0003F5B0 5303            	 12523:     subq.b  #1,D3
02:0003F5B2 6AC2            	 12524:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003F5B4 4E75            	 12525:     rts
                            	 12526: 
