                            	  3632: _anon_z07_13:
02:0004A558 19430002        	  3633:     move.b  D3,($0002,A4)
                            	  3634:     ; We're OK to change the position. So, decrease the distance
                            	  3635:     ; that's left to move.
                            	  3636:     ;
02:0004A55C 41EC00D3        	  3637:     lea     ($00D3,A4),A0
