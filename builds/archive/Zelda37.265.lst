                            	 12753: Ganon_CheckCollisions:
                            	 12754:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12755:     ; Store in [02] and [03].
                            	 12756:     ;
02:0003E57A 10342070        	 12757:     move.b  ($70,A4,D2.W),D0
02:0003E57E 023C00EE        	 12758:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E582 123C0010        	 12759:     move.b  #$10,D1
02:0003E586 D101            	 12760:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003E588 19400002        	 12761:     move.b  D0,($0002,A4)
02:0003E58C 41EC0084        	 12762:     lea     ($0084,A4),A0
02:0003E590 10302000        	 12763:     move.b  (A0,D2.W),D0
02:0003E594 023C00EE        	 12764:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E598 123C0010        	 12765:     move.b  #$10,D1
02:0003E59C D101            	 12766:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003E59E 19400003        	 12767:     move.b  D0,($0003,A4)
                            	 12768:     ; Check for a collision with Link.
                            	 12769:     ;
                            	 12770:     ; We can't call CheckLinkCollision, because we need to
                            	 12771:     ; customize Ganon's midpoint.
                            	 12772:     ;
                            	 12773:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12774:     ; detection, if Link is invincible. Initialize variables that will
                            	 12775:     ; be returned from the partial collision check routine. Then
                            	 12776:     ; call it.
                            	 12777:     ;
02:0003E5A2 102C04F0        	 12778:     move.b  ($04F0,A4),D0
02:0003E5A6 6616            	 12779:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003E5A8 19400006        	 12780:     move.b  D0,($0006,A4)
02:0003E5AC 19400009        	 12781:     move.b  D0,($0009,A4)
02:0003E5B0 1940000C        	 12782:     move.b  D0,($000C,A4)
02:0003E5B4 7600            	 12783:     moveq   #0,D3
02:0003E5B6 1883            	 12784:     move.b  D3,($0000,A4)
02:0003E5B8 4EB9000312DC    	 12785:     jsr     CheckLinkCollisionPreinit
                            	 12786:     even
                            	 12787: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12788:     ; If Ganon is not in state 0, then he's brown.
                            	 12789:     ; Go check collision with an arrow.
                            	 12790:     ;
02:0003E5BE 41EC00AC        	 12791:     lea     ($00AC,A4),A0
02:0003E5C2 10302000        	 12792:     move.b  (A0,D2.W),D0
02:0003E5C6 6652            	 12793:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12794:     ; If timer <> 0, then Ganon is visible.
                            	 12795:     ; He can't be harmed like this. So, return.
                            	 12796:     ;
02:0003E5C8 10342028        	 12797:     move.b  ($28,A4,D2.W),D0
02:0003E5CC 664A            	 12798:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003E5CE 760D            	 12799:     moveq   #13,D3
02:0003E5D0 4EB900031522    	 12800:     jsr     CheckMonsterSwordCollision
                            	 12801:     ; If Ganon has died according to the usual collision check rules
                            	 12802:     ; (HP = 0), then:
                            	 12803:     ; 1. Restore HP to the initial value $F0
                            	 12804:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12805:     ; 3. Change palette row 7 to make Ganon brown
                            	 12806:     ;
02:0003E5D6 41EC0405        	 12807:     lea     ($0405,A4),A0
02:0003E5DA 10302000        	 12808:     move.b  (A0,D2.W),D0
02:0003E5DE 6718            	 12809:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003E5E0 103C00F0        	 12810:     move.b  #$F0,D0
02:0003E5E4 41EC0485        	 12811:     lea     ($0485,A4),A0
02:0003E5E8 11802000        	 12812:     move.b  D0,(A0,D2.W)
02:0003E5EC 41EC00AC        	 12813:     lea     ($00AC,A4),A0
02:0003E5F0 53302000        	 12814:     subq.b  #1,(A0,D2.W)
02:0003E5F4 61000084        	 12815:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12816:     even
                            	 12817: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12818:     ; If Ganon was harmed, then play the sound effect
                            	 12819:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12820:     ;
02:0003E5F8 41EC04F0        	 12821:     lea     ($04F0,A4),A0
02:0003E5FC 10302000        	 12822:     move.b  (A0,D2.W),D0
02:0003E600 670A            	 12823:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003E602 6100A41E        	 12824:     jsr     PlayBossHitCryIfNeeded
02:0003E606 7040            	 12825:     moveq   #64,D0
02:0003E608 19802028        	 12826:     move.b  D0,($28,A4,D2.W)
                            	 12827:     even
                            	 12828: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12829:     ; Reset metastate, because Ganon cannot die this way.
                            	 12830:     ;
02:0003E60C 4EB90004C324    	 12831:     jsr     ResetObjMetastate
                            	 12832:     ; Reset shove info and invincibility timer, because Ganon
                            	 12833:     ; doesn't react at all as a usual monster.
                            	 12834:     ;
02:0003E612 4EB900031510    	 12835:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12836:     even
                            	 12837: _L_z04_Ganon_CheckCollisions_Exit:
02:0003E618 4E75            	 12838:     rts
                            	 12839: 
                            	 12840:     even
                            	 12841: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12842:     ; If the silver arrow is not in the inventory, then return.
                            	 12843:     ;
02:0003E61A 102C0659        	 12844:     move.b  ($0659,A4),D0
02:0003E61E 0C000002        	 12845:     cmpi.b  #$02,D0
02:0003E622 66F4            	 12846:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12847:     ; Reset the collision return value [06].
                            	 12848:     ;
02:0003E624 7000            	 12849:     moveq   #0,D0
02:0003E626 19400006        	 12850:     move.b  D0,($0006,A4)
                            	 12851:     ; If there's no arrow in flight, then return.
                            	 12852:     ;
02:0003E62A 7612            	 12853:     moveq   #18,D3
02:0003E62C 41EC00AC        	 12854:     lea     ($00AC,A4),A0
02:0003E630 10303000        	 12855:     move.b  (A0,D3.W),D0
02:0003E634 0C000010        	 12856:     cmpi.b  #$10,D0
02:0003E638 66DE            	 12857:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12858:     ; Check for collision with an arrow; and return if no collision.
                            	 12859:     ;
02:0003E63A 4EB90003152A    	 12860:     jsr     CheckMonsterArrowOrRodCollision
02:0003E640 102C0006        	 12861:     move.b  ($0006,A4),D0
02:0003E644 67D2            	 12862:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 12863:     ; Set the Ganon phase to "dying".
                            	 12864:     ;
02:0003E646 41EC042C        	 12865:     lea     ($042C,A4),A0
02:0003E64A 52302000        	 12866:     addq.b  #1,(A0,D2.W)
                            	 12867:     ; Now his body does flash.
                            	 12868:     ;
02:0003E64E 7028            	 12869:     moveq   #40,D0
02:0003E650 41EC04F0        	 12870:     lea     ($04F0,A4),A0
02:0003E654 11802000        	 12871:     move.b  D0,(A0,D2.W)
                            	 12872:     ; Set initial cloud distance 8.
                            	 12873:     ;
02:0003E658 7008            	 12874:     moveq   #8,D0
02:0003E65A 41EC0478        	 12875:     lea     ($0478,A4),A0
02:0003E65E 11802000        	 12876:     move.b  D0,(A0,D2.W)
02:0003E662 0A3C0001        	 12877:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003E666 4E75            	 12878:     rts
                            	 12879: 
