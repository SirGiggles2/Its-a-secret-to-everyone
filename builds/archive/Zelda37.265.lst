02:0003A22E 7011            	  3567:     moveq   #17,D0
02:0003A230 41EC0405        	  3568:     lea     ($0405,A4),A0
02:0003A234 11803000        	  3569:     move.b  D0,(A0,D3.W)
                            	  3570: _anon_z04_50:
