02:000301D8 61000F42        	  1439:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  1440:     ; Flip horizontally based on movement frame, which is
                            	  1441:     ; switched based on animation counter.
                            	  1442:     ;
02:000301DC 4EB90004BAF6    	  1443:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:000301E2 7000            	  1444:     moveq   #0,D0
02:000301E4 60000C44        	  1445:     jmp     DrawObjectNotMirrored
