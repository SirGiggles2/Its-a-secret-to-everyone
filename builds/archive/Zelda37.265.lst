                            	  1818: _L_z01_InitTrap_Full_LoopTrap:
                            	  1819:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
                            	  1820:     ;
02:0003048C 1003            	  1821:     move.b  D3,D0
02:0003048E 023C00EE        	  1822:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  1823:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  1824:     ;
02:00030492 122C0340        	  1825:     move.b  ($0340,A4),D1
02:00030496 D101            	  1826:     addx.b  D1,D0   ; ADC CurObjIndex
02:00030498 7400            	  1827:     moveq   #0,D2
02:0003049A 1400            	  1828:     move.b  D0,D2
                            	  1829:     ; Look up and set the location for this iteration's individual trap.
                            	  1830:     ;
02:0003049C 41F900030460    	  1831:     lea     (TrapXs).l,A0
02:000304A2 10303000        	  1832:     move.b  (A0,D3.W),D0
02:000304A6 19802070        	  1833:     move.b  D0,($70,A4,D2.W)
02:000304AA 41F900030466    	  1834:     lea     (TrapYs).l,A0
02:000304B0 10303000        	  1835:     move.b  (A0,D3.W),D0
02:000304B4 41EC0084        	  1836:     lea     ($0084,A4),A0
02:000304B8 11802000        	  1837:     move.b  D0,(A0,D2.W)
02:000304BC 619E            	  1838:     jsr     InitOneSimpleObject
02:000304BE 5302            	  1839:     subq.b  #1,D2
02:000304C0 5303            	  1840:     subq.b  #1,D3
02:000304C2 6AC8            	  1841:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:000304C4 4E75            	  1842:     rts
                            	  1843: 
                            	  1844:     even
                            	  1845: TrapAllowedDirs:
02:000304C6 05              	  1846:     dc.b    $05, $09, $06, $0A, $01, $02
02:000304C7 09
02:000304C8 06
02:000304C9 0A
02:000304CA 01
02:000304CB 02
                            	  1847: 
                            	  1848:     even
                            	  1849: UpdateTrap_Full:
02:000304CC 41EC00AC        	  1850:     lea     ($00AC,A4),A0
02:000304D0 10302000        	  1851:     move.b  (A0,D2.W),D0
02:000304D4 660000B2        	  1852:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  1853:     ; State 0. Sensing.
                            	  1854:     ;
                            	  1855:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  1856:     ; then go see if the horizontal distance is shorter.
                            	  1857:     ;
02:000304D8 102C0084        	  1858:     move.b  ($0084,A4),D0
02:000304DC 003C0011        	  1859:     ori     #$11,CCR  ; SEC: set C+X
02:000304E0 41EC0084        	  1860:     lea     ($0084,A4),A0
02:000304E4 12302000        	  1861:     move.b  (A0,D2.W),D1
02:000304E8 0A3C0010        	  1862:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000304EC 9101            	  1863:     subx.b  D1,D0   ; SBC ObjY,X
02:000304EE 0A3C0010        	  1864:     eori    #$10,CCR  ; restore X = 6502 C
02:000304F2 61000430        	  1865:     jsr     Abs
02:000304F6 0C00000E        	  1866:     cmpi.b  #$0E,D0
02:000304FA 644C            	  1867:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1868:     ; Determine the horizontal direction toward Link;
                            	  1869:     ; and if Link and the trap are at the same X, then we can't move
                            	  1870:     ; along this axis. Go see about moving vertically.
                            	  1871:     ;
02:000304FC 7601            	  1872:     moveq   #1,D3
02:000304FE 102C0070        	  1873:     move.b  ($0070,A4),D0
02:00030502 12342070        	  1874:     move.b  ($70,A4,D2.W),D1
02:00030506 B001            	  1875:     cmp.b   D1,D0
02:00030508 673E            	  1876:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003050A 6402            	  1877:     bcc  _anon_z01_26
02:0003050C 7602            	  1878:     moveq   #2,D3
                            	  1879: _anon_z01_26:
                            	  1880:     ; Remember the original X coordinate.
                            	  1881:     ;
02:0003050E 10342070        	  1882:     move.b  ($70,A4,D2.W),D0
                            	  1883:     even
                            	  1884: _L_z01_UpdateTrap_Full_GoToState1:
02:00030512 41EC0380        	  1885:     lea     ($0380,A4),A0
02:00030516 11802000        	  1886:     move.b  D0,(A0,D2.W)
                            	  1887:     ; Set facing direction to the horizontal one that we determined.
                            	  1888:     ;
02:0003051A 1003            	  1889:     move.b  D3,D0
02:0003051C 41EC0098        	  1890:     lea     ($0098,A4),A0
02:00030520 11802000        	  1891:     move.b  D0,(A0,D2.W)
                            	  1892:     ; If the direction we determined is not allowed for this trap, then
                            	  1893:     ; go draw and check collisions.
                            	  1894:     ;
02:00030524 41F9000304C5    	  1895:     lea     (TrapAllowedDirs-1).l,A0
02:0003052A 12302000        	  1896:     move.b  (A0,D2.W),D1
02:0003052E C001            	  1897:     and.b  D1,D0
02:00030530 6712            	  1898:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1899:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  1900:     ;
02:00030532 41EC00AC        	  1901:     lea     ($00AC,A4),A0
02:00030536 52302000        	  1902:     addq.b  #1,(A0,D2.W)
02:0003053A 7070            	  1903:     moveq   #112,D0
02:0003053C 41EC03BC        	  1904:     lea     ($03BC,A4),A0
02:00030540 11802000        	  1905:     move.b  D0,(A0,D2.W)
                            	  1906:     even
                            	  1907: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:00030544 60000102        	  1908:     jmp     L_Trap_DrawAndCheckCollisions
                            	  1909: 
                            	  1910:     even
                            	  1911: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1912:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1913:     ; then this trap definitely wasn't triggered.
                            	  1914:     ; Go draw and check collisions.
                            	  1915:     ;
02:00030548 102C0070        	  1916:     move.b  ($0070,A4),D0
02:0003054C 003C0011        	  1917:     ori     #$11,CCR  ; SEC: set C+X
02:00030550 12342070        	  1918:     move.b  ($70,A4,D2.W),D1
02:00030554 0A3C0010        	  1919:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030558 9101            	  1920:     subx.b  D1,D0   ; SBC ObjX,X
02:0003055A 0A3C0010        	  1921:     eori    #$10,CCR  ; restore X = 6502 C
02:0003055E 610003C4        	  1922:     jsr     Abs
02:00030562 0C00000E        	  1923:     cmpi.b  #$0E,D0
02:00030566 64DC            	  1924:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1925:     ; Determine the vertical direction toward Link;
                            	  1926:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1927:     ; along this axis. Go draw and check object collisions.
                            	  1928:     ;
02:00030568 7604            	  1929:     moveq   #4,D3
02:0003056A 102C0084        	  1930:     move.b  ($0084,A4),D0
02:0003056E 41EC0084        	  1931:     lea     ($0084,A4),A0
02:00030572 12302000        	  1932:     move.b  (A0,D2.W),D1
02:00030576 B001            	  1933:     cmp.b   D1,D0
02:00030578 67CA            	  1934:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:0003057A 6402            	  1935:     bcc  _anon_z01_27
02:0003057C 7608            	  1936:     moveq   #8,D3
                            	  1937: _anon_z01_27:
                            	  1938:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  1939:     ; set the vertical direction we determined, and other preparations.
                            	  1940:     ;
02:0003057E 41EC0084        	  1941:     lea     ($0084,A4),A0
02:00030582 10302000        	  1942:     move.b  (A0,D2.W),D0
02:00030586 668A            	  1943:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  1944:     even
                            	  1945: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  1946:     ; State 1 and 2.
                            	  1947:     ;
                            	  1948:     ; Move in the direction it's facing.
                            	  1949:     ;
02:00030588 41EC0098        	  1950:     lea     ($0098,A4),A0
02:0003058C 10302000        	  1951:     move.b  (A0,D2.W),D0
02:00030590 1940000F        	  1952:     move.b  D0,($000F,A4)
02:00030594 4EB90004A7AC    	  1953:     jsr     MoveObject
                            	  1954:     ; Truncate the grid offset to square length ($10).
                            	  1955:     ;
02:0003059A 41EC0394        	  1956:     lea     ($0394,A4),A0
02:0003059E 10302000        	  1957:     move.b  (A0,D2.W),D0
02:000305A2 0200000F        	  1958:     andi.b #$0F,D0
02:000305A6 6608            	  1959:     bne  _anon_z01_28
02:000305A8 41EC0394        	  1960:     lea     ($0394,A4),A0
02:000305AC 11802000        	  1961:     move.b  D0,(A0,D2.W)
                            	  1962: _anon_z01_28:
                            	  1963:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  1964:     ;
02:000305B0 61000CF6        	  1965:     jsr     CheckLinkCollision
                            	  1966:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  1967:     ; and current coordinate to the trap's X.
                            	  1968:     ;
02:000305B4 7600            	  1969:     moveq   #0,D3
02:000305B6 16342070        	  1970:     move.b  ($70,A4,D2.W),D3
02:000305BA 7078            	  1971:     moveq   #120,D0
02:000305BC 1880            	  1972:     move.b  D0,($0000,A4)
02:000305BE 41EC0098        	  1973:     lea     ($0098,A4),A0
02:000305C2 10302000        	  1974:     move.b  (A0,D2.W),D0
02:000305C6 0200000C        	  1975:     andi.b #$0C,D0
02:000305CA 6710            	  1976:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  1977:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  1978:     ; and current coordinate to the trap's Y.
                            	  1979:     ;
02:000305CC 7600            	  1980:     moveq   #0,D3
02:000305CE 41EC0084        	  1981:     lea     ($0084,A4),A0
02:000305D2 16302000        	  1982:     move.b  (A0,D2.W),D3
02:000305D6 103C0090        	  1983:     move.b  #$90,D0
02:000305DA 1880            	  1984:     move.b  D0,($0000,A4)
                            	  1985:     even
                            	  1986: _L_z01_UpdateTrap_Full_Finish:
                            	  1987:     ; If in state 2, then go finish handling it.
                            	  1988:     ;
02:000305DC 41EC00AC        	  1989:     lea     ($00AC,A4),A0
02:000305E0 10302000        	  1990:     move.b  (A0,D2.W),D0
02:000305E4 02000001        	  1991:     andi.b #$01,D0
02:000305E8 6744            	  1992:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  1993:     ; Finish handling state 1.
                            	  1994:     ;
                            	  1995:     ; Get the distance between the current coordinate and the target.
                            	  1996:     ;
02:000305EA 1003            	  1997:     move.b  D3,D0
02:000305EC 003C0011        	  1998:     ori     #$11,CCR  ; SEC: set C+X
02:000305F0 1214            	  1999:     move.b  ($0000,A4),D1
02:000305F2 0A3C0010        	  2000:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000305F6 9101            	  2001:     subx.b  D1,D0   ; SBC $00
02:000305F8 0A3C0010        	  2002:     eori    #$10,CCR  ; restore X = 6502 C
02:000305FC 61000326        	  2003:     jsr     Abs
                            	  2004:     ; If distance >= 5, go draw.
                            	  2005:     ;
02:00030600 0C000005        	  2006:     cmpi.b  #$05,D0
02:00030604 6426            	  2007:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  2008:     ; Else reverse direction, and advace to state 2
                            	  2009:     ; with q-speed $20 (0.5 pixels a frame) (slow).
                            	  2010:     ;
02:00030606 41EC0098        	  2011:     lea     ($0098,A4),A0
02:0003060A 10302000        	  2012:     move.b  (A0,D2.W),D0
02:0003060E 61000310        	  2013:     jsr     GetOppositeDir
02:00030612 41EC0098        	  2014:     lea     ($0098,A4),A0
02:00030616 11802000        	  2015:     move.b  D0,(A0,D2.W)
02:0003061A 7020            	  2016:     moveq   #32,D0
02:0003061C 41EC03BC        	  2017:     lea     ($03BC,A4),A0
02:00030620 11802000        	  2018:     move.b  D0,(A0,D2.W)
02:00030624 41EC00AC        	  2019:     lea     ($00AC,A4),A0
02:00030628 52302000        	  2020:     addq.b  #1,(A0,D2.W)
