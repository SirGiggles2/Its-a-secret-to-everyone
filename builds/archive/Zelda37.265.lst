02:00040ACC 1600            	  3323:     move.b  D0,D3
02:00040ACE 41F900FF697E    	  3324:     lea     (NES_SRAM+$097E).l,A0
02:00040AD4 10303000        	  3325:     move.b  (A0,D3.W),D0
02:00040AD8 1B00            	  3326:     move.b  D0,-(A5)  ; PHA
02:00040ADA 020000F0        	  3327:     andi.b #$F0,D0
02:00040ADE 19400070        	  3328:     move.b  D0,($0070,A4)
02:00040AE2 101D            	  3329:     move.b  (A5)+,D0  ; PLA
