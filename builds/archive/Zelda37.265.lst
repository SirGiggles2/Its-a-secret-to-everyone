02:0003C042 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003C046 12302000        	  7758:     move.b  (A0,D2.W),D1
02:0003C04A D101            	  7759:     addx.b  D1,D0   ; ADC ObjY,X
