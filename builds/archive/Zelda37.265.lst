02:0004217E 6510            	  5048:     bcs  _anon_z05_106
02:00042180 7600            	  5049:     moveq   #0,D3
02:00042182 162C00EB        	  5050:     move.b  ($00EB,A4),D3
02:00042186 41F900FF68FE    	  5051:     lea     (NES_SRAM+$08FE).l,A0
02:0004218C 10303000        	  5052:     move.b  (A0,D3.W),D0
                            	  5053: _anon_z05_106:
