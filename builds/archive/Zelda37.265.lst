02:0003CFA2 41EC0478        	  9789:     lea     ($0478,A4),A0
02:0003CFA6 11802000        	  9790:     move.b  D0,(A0,D2.W)
02:0003CFAA 41EC046B        	  9791:     lea     ($046B,A4),A0
02:0003CFAE 10302000        	  9792:     move.b  (A0,D2.W),D0
02:0003CFB2 02000001        	  9793:     andi.b #$01,D0
02:0003CFB6 0A000001        	  9794:     eori.b #$01,D0
