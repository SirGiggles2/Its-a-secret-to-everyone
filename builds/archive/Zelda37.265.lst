02:0003A01C 122C034A        	  3290:     move.b  ($034A,A4),D1
02:0003A020 B001            	  3291:     cmp.b   D1,D0
02:0003A022 6400FF78        	  3292:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003A026 522C0510        	  3293:     addq.b  #1,($0510,A4)
                            	  3294:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3295:     ; and pick up whatever the new value is for state 1.
                            	  3296:     ;
02:0003A02A 7001            	  3297:     moveq   #1,D0
02:0003A02C 41EC03D0        	  3298:     lea     ($03D0,A4),A0
02:0003A030 11802000        	  3299:     move.b  D0,(A0,D2.W)
                            	  3300:     ; Set the long timer to 2, meaning 20 frames.
                            	  3301:     ;
02:0003A034 E308            	  3302:     lsl.b  #1,D0   ; ASL A
02:0003A036 1940004D        	  3303:     move.b  D0,($004D,A4)
02:0003A03A 6100008C        	  3304:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3305:     ; The leever has to face Link in order to move toward him.
                            	  3306:     ;
02:0003A03E 4EB90004AA04    	  3307:     jsr     ReverseObjDir
                            	  3308:     even
