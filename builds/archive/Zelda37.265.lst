02:000358B0 123C0000        	  5018:     move.b  #$00,D1
02:000358B4 D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000358B6 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
