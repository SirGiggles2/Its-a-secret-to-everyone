02:0002B724 2F00            	  1010:     move.l  D0,-(SP)
02:0002B726 4EB900000000    	  1011:     jsr     z05_reset_door_flag
02:0002B72C 588F            	  1012:     addq.l  #4,SP
02:0002B72E 4E75            	  1013:     rts
