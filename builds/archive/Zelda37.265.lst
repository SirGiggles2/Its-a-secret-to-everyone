                            	  1328: SummonWhirlwind:
                            	  1329:     ; If not in mode 5, return.
                            	  1330:     ;
02:0003013A 102C0012        	  1331:     move.b  ($0012,A4),D0
02:0003013E 0C000005        	  1332:     cmpi.b  #$05,D0
02:00030142 6704            	  1333:     beq.s  __far_z_01_0000
02:00030144 60000080        	  1334:     jmp  L6104_Exit
                            	  1335: __far_z_01_0000:
                            	  1336:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  1337:     ;
02:00030148 6178            	  1338:     jsr     AdvanceTeleportingLevelIndex
02:0003014A 102C0523        	  1339:     move.b  ($0523,A4),D0
02:0003014E 02000007        	  1340:     andi.b #$07,D0
02:00030152 7600            	  1341:     moveq   #0,D3
02:00030154 1600            	  1342:     move.b  D0,D3
02:00030156 41F9000498B6    	  1343:     lea     (LevelMasks).l,A0
02:0003015C 10303000        	  1344:     move.b  (A0,D3.W),D0
02:00030160 1880            	  1345:     move.b  D0,($0000,A4)
                            	  1346:     even
                            	  1347: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  1348:     ; If there are no triforce pieces, then return.
                            	  1349:     ;
02:00030162 102C0671        	  1350:     move.b  ($0671,A4),D0
02:00030166 6602            	  1351:     bne.s  __far_z_01_0001
02:00030168 605C            	  1352:     jmp  L6104_Exit
                            	  1353: __far_z_01_0001:
                            	  1354:     ; If we have gotten this triforce piece, then go try to make a
                            	  1355:     ; whirlwind.
                            	  1356:     ;
02:0003016A 1214            	  1357:     move.b  ($0000,A4),D1
02:0003016C C200            	  1358:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003016E 662C            	  1359:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  1360:     ; We have not gotten this piece.
                            	  1361:     ; First, advance the teleporting index again.
                            	  1362:     ;
02:00030170 6150            	  1363:     jsr     AdvanceTeleportingLevelIndex
                            	  1364:     ; If the direction Link is facing is an increasing one, then
                            	  1365:     ; rotate the level mask in [00] left to correspond to the higher
                            	  1366:     ; level number. Then go test this new mask.
                            	  1367:     ;
02:00030172 102C0098        	  1368:     move.b  ($0098,A4),D0
02:00030176 02000009        	  1369:     andi.b #$09,D0
02:0003017A 6710            	  1370:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:0003017C 1214            	  1371:     move.b  ($0000,A4),D1
02:0003017E E309            	  1372:     lsl.b  #1,D1   ; ASL $00
02:00030180 1881            	  1373:     move.b  D1,($0000,A4)
02:00030182 64DE            	  1374:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:00030184 1214            	  1375:     move.b  ($0000,A4),D1
02:00030186 E311            	  1376:     roxl.b  #1,D1   ; ROL $00
02:00030188 1881            	  1377:     move.b  D1,($0000,A4)
02:0003018A 60D6            	  1378:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1379: 
                            	  1380:     even
                            	  1381: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  1382:     ; If instead the direction is a decreasing one, then
                            	  1383:     ; rotate right to correspond to the lower level number.
                            	  1384:     ; Then go test this new mask.
                            	  1385:     ;
02:0003018C 1214            	  1386:     move.b  ($0000,A4),D1
02:0003018E E209            	  1387:     lsr.b  #1,D1   ; LSR $00
02:00030190 1881            	  1388:     move.b  D1,($0000,A4)
02:00030192 64CE            	  1389:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:00030194 1214            	  1390:     move.b  ($0000,A4),D1
02:00030196 E211            	  1391:     roxr.b  #1,D1   ; ROR $00
02:00030198 1881            	  1392:     move.b  D1,($0000,A4)
02:0003019A 60C6            	  1393:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1394: 
                            	  1395:     even
                            	  1396: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  1397:     ; If already summoned or in the middle of teleporting, then
                            	  1398:     ; return and don't summon another one.
                            	  1399:     ;
02:0003019C 102C0508        	  1400:     move.b  ($0508,A4),D0
02:000301A0 122C0522        	  1401:     move.b  ($0522,A4),D1
02:000301A4 8001            	  1402:     or.b  D1,D0
02:000301A6 6702            	  1403:     beq.s  __far_z_01_0002
02:000301A8 601C            	  1404:     jmp  L6104_Exit
                            	  1405: __far_z_01_0002:
                            	  1406:     ; Return if we can't find an empty monster slot.
                            	  1407:     ;
02:000301AA 4EB90004C30C    	  1408:     jsr     FindEmptyMonsterSlot
02:000301B0 6602            	  1409:     bne.s  __far_z_01_0003
02:000301B2 6012            	  1410:     jmp  L6104_Exit
                            	  1411: __far_z_01_0003:
                            	  1412:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  1413:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  1414:     ;
02:000301B4 522C0508        	  1415:     addq.b  #1,($0508,A4)
02:000301B8 1003            	  1416:     move.b  D3,D0
02:000301BA 7400            	  1417:     moveq   #0,D2
02:000301BC 1400            	  1418:     move.b  D0,D2
02:000301BE 6000FE9C        	  1419:     jmp     SetUpWhirlwind
                            	  1420: 
