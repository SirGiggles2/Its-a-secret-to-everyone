                            	  9606: _L_z04_UpdateGohma_Move:
                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003CE3A 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003CE3E 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003CE42 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE46 123C0080        	  9612:     move.b  #$80,D1
02:0003CE4A D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003CE4C 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003CE50 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003CE54 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
02:0003CE58 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003CE5C 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003CE60 7001            	  9625:     moveq   #1,D0
02:0003CE62 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003CE66 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003CE6A 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003CE6E 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003CE72 C200            	  9632:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CE74 6704            	  9633:     beq  _anon_z04_118
02:0003CE76 52342070        	  9634:     addq.b  #1,($70,A4,D2.W)
                            	  9635: _anon_z04_118:
                            	  9636:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9637:     ;
02:0003CE7A 122C0002        	  9638:     move.b  ($0002,A4),D1
02:0003CE7E E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003CE80 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003CE84 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003CE88 C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CE8A 6704            	  9643:     beq  _anon_z04_119
02:0003CE8C 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
                            	  9646:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9647:     ;
02:0003CE90 122C0002        	  9648:     move.b  ($0002,A4),D1
02:0003CE94 E309            	  9649:     lsl.b  #1,D1   ; ASL $02
02:0003CE96 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003CE9A 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003CE9E C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CEA0 6708            	  9653:     beq  _anon_z04_120
02:0003CEA2 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003CEA6 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
                            	  9657:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9658:     ;
02:0003CEAA 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003CEAE E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003CEB0 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003CEB4 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003CEB8 C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CEBA 6708            	  9664:     beq  _anon_z04_121
02:0003CEBC 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003CEC0 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003CEC4 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003CEC8 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003CECC 0C000020        	  9672:     cmpi.b  #$20,D0
02:0003CED0 662C            	  9673:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9674:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
