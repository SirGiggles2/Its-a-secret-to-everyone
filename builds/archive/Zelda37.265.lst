                            	   927: ;==============================================================================
                            	   928: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   929: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   930: ;==============================================================================
                            	   931: 
                            	   932: c_copy_column_to_tilebuf:
