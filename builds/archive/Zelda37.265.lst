02:00035882 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035886 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:00035888 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
