                            	  2358: ;==============================================================================
                            	  2359: ; EXPORT side — carry-returning shims.
                            	  2360: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2361: ; reproduces the original function's carry normalization.
                            	  2362: ;==============================================================================
                            	  2363: 
                            	  2364: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2365: c_copy_next_row_to_transfer_buf:
02:0002BF82 4EB900000000    	  2366:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF88 08000008        	  2367:     btst    #8,D0
02:0002BF8C 670A            	  2368:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2369:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2370:     eori    #$01,CCR
02:0002BF96 4E75            	  2371:     rts
                            	  2372: .cc_cnr:
02:0002BF98 023C00FE        	  2373:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2374:     eori    #$01,CCR
02:0002BFA0 4E75            	  2375:     rts
                            	  2376: 
                            	  2377: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2378: c_copy_next_row_advance_submode:
02:0002BFA2 4EB900000000    	  2379:     jsr     z05_copy_next_row_advance_submode
02:0002BFA8 08000008        	  2380:     btst    #8,D0
02:0002BFAC 670A            	  2381:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2382:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2383:     eori    #$01,CCR
02:0002BFB6 4E75            	  2384:     rts
                            	  2385: .cc_cnras:
02:0002BFB8 023C00FE        	  2386:     andi    #$FE,CCR
02:0002BFBC 0A3C0001        	  2387:     eori    #$01,CCR
02:0002BFC0 4E75            	  2388:     rts
                            	  2389: 
                            	  2390: ; IsQuestSecretMismatch — no args. Returns carry in bit 8.
                            	  2391: c_is_quest_secret_mismatch:
