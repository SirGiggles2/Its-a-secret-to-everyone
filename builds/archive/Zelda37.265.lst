                            	  3150: _anon_z04_42:
                            	  3151:     ; State 0.
                            	  3152:     ;
                            	  3153:     ; In state we determine whether to burst out of the ground.
                            	  3154:     ; If the long timer has not expired, then return.
                            	  3155:     ;
02:00039F22 102C004D        	  3156:     move.b  ($004D,A4),D0
02:00039F26 6674            	  3157:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3158:     ; Only allow two red leevers at a time.
                            	  3159:     ;
02:00039F28 102C0510        	  3160:     move.b  ($0510,A4),D0
02:00039F2C 0C000002        	  3161:     cmpi.b  #$02,D0
02:00039F30 646A            	  3162:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3163:     ; Face in the same direction as Link.
                            	  3164:     ;
02:00039F32 102C0098        	  3165:     move.b  ($0098,A4),D0
02:00039F36 41EC0098        	  3166:     lea     ($0098,A4),A0
02:00039F3A 11802000        	  3167:     move.b  D0,(A0,D2.W)
                            	  3168:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3169:     ;
02:00039F3E 10342019        	  3170:     move.b  ($19,A4,D2.W),D0
02:00039F42 0C0000C0        	  3171:     cmpi.b  #$C0,D0
02:00039F46 6506            	  3172:     bcs  _anon_z04_43
02:00039F48 4EB90004AA04    	  3173:     jsr     ReverseObjDir
                            	  3174: _anon_z04_43:
                            	  3175:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3176:     ;
02:00039F4E 41EC0098        	  3177:     lea     ($0098,A4),A0
02:00039F52 10302000        	  3178:     move.b  (A0,D2.W),D0
02:00039F56 0200000C        	  3179:     andi.b #$0C,D0
02:00039F5A 6742            	  3180:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3181:     ; Begin with the leever's X set to Link's X.
                            	  3182:     ;
02:00039F5C 102C0070        	  3183:     move.b  ($0070,A4),D0
02:00039F60 19802070        	  3184:     move.b  D0,($70,A4,D2.W)
                            	  3185:     ; If facing down, then use Y offset $28.
                            	  3186:     ; Else store Y offset -$28 in [00].
                            	  3187:     ;
02:00039F64 7628            	  3188:     moveq   #40,D3
02:00039F66 41EC0098        	  3189:     lea     ($0098,A4),A0
02:00039F6A 10302000        	  3190:     move.b  (A0,D2.W),D0
02:00039F6E 02000008        	  3191:     andi.b #$08,D0
02:00039F72 6704            	  3192:     beq  _anon_z04_44
02:00039F74 163C00D8        	  3193:     move.b  #$D8,D3
                            	  3194: _anon_z04_44:
02:00039F78 1883            	  3195:     move.b  D3,($0000,A4)
                            	  3196:     ; Add Link's Y and the vertical offset.
                            	  3197:     ;
02:00039F7A 102C0084        	  3198:     move.b  ($0084,A4),D0
02:00039F7E 023C00EE        	  3199:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039F82 1214            	  3200:     move.b  ($0000,A4),D1
02:00039F84 D101            	  3201:     addx.b  D1,D0   ; ADC $00
                            	  3202:     ; Sanitize the Y coordinate:
                            	  3203:     ; (Y AND $F0) OR $D
                            	  3204:     ;
02:00039F86 020000F0        	  3205:     andi.b #$F0,D0
02:00039F8A 0000000D        	  3206:     ori.b #$0D,D0
02:00039F8E 41EC0084        	  3207:     lea     ($0084,A4),A0
02:00039F92 11802000        	  3208:     move.b  D0,(A0,D2.W)
                            	  3209:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3210:     ; go see if the tile is valid to come out of.
                            	  3211:     ;
                            	  3212:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3213:     ;
02:00039F96 0C00005D        	  3214:     cmpi.b  #$5D,D0
02:00039F9A 647A            	  3215:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  3216:     even
