02:00030E72 704C            	  3181:     moveq   #76,D0
                            	  3182:     even
                            	  3183: DrawObjectWithAnimAndSpecificSprites:
02:00030E74 19400344        	  3184:     move.b  D0,($0344,A4)
02:00030E78 7600            	  3185:     moveq   #0,D3
02:00030E7A 162C000E        	  3186:     move.b  ($000E,A4),D3
02:00030E7E 7001            	  3187:     moveq   #1,D0
02:00030E80 19400007        	  3188:     move.b  D0,($0007,A4)
02:00030E84 7008            	  3189:     moveq   #8,D0
02:00030E86 1940000A        	  3190:     move.b  D0,($000A,A4)
02:00030E8A 41F900030BDA    	  3191:     lea     (ObjAnimations).l,A0
02:00030E90 10303000        	  3192:     move.b  (A0,D3.W),D0
02:00030E94 023C00EE        	  3193:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030E98 122C000D        	  3194:     move.b  ($000D,A4),D1
02:00030E9C D101            	  3195:     addx.b  D1,D0   ; ADC $0D
02:00030E9E 7600            	  3196:     moveq   #0,D3
02:00030EA0 1600            	  3197:     move.b  D0,D3
02:00030EA2 41F900030C5A    	  3198:     lea     (ObjAnimFrameHeap).l,A0
02:00030EA8 10303000        	  3199:     move.b  (A0,D3.W),D0
02:00030EAC 19400002        	  3200:     move.b  D0,($0002,A4)
02:00030EB0 023C00EE        	  3201:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EB4 123C0002        	  3202:     move.b  #$02,D1
02:00030EB8 D101            	  3203:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00030EBA 19400003        	  3204:     move.b  D0,($0003,A4)
                            	  3205:     ; If object is Link, or object index/slot >= $D (weapons, room item),
                            	  3206:     ; then go set attributes and write sprites.
                            	  3207:     ;
02:00030EBE 4A02            	  3208:     cmpi.b  #$00,D2
02:00030EC0 6722            	  3209:     beq  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
02:00030EC2 0C02000D        	  3210:     cmpi.b  #$0D,D2
02:00030EC6 641C            	  3211:     bcc  _L_z01_DrawObjectWithAnimAndSpecificSprites_UseTableAttr
                            	  3212:     ; If the object has a "half-width draw" attribute, then
                            	  3213:     ; go draw half-width.
                            	  3214:     ;
02:00030EC8 41EC04BF        	  3215:     lea     ($04BF,A4),A0
02:00030ECC 10302000        	  3216:     move.b  (A0,D2.W),D0
02:00030ED0 02000002        	  3217:     andi.b #$02,D0
02:00030ED4 6630            	  3218:     bne  _L_z01_DrawObjectWithAnimAndSpecificSprites_DrawHalfWidth
                            	  3219:     ; If the object has the "Ignore sprite attribute table" attribute,
                            	  3220:     ; then don't look up sprite attributes.
                            	  3221:     ;
02:00030ED6 41EC04BF        	  3222:     lea     ($04BF,A4),A0
02:00030EDA 10302000        	  3223:     move.b  (A0,D2.W),D0
02:00030EDE 02000008        	  3224:     andi.b #$08,D0
02:00030EE2 660E            	  3225:     bne  _anon_z01_76
                            	  3226:     even
