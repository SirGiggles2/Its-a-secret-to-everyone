                            	  6023: _L_z07_UpdateSwordOrRod_Add4:
                            	  6024:     ; Set [00] to (state - 1) * 4:
                            	  6025:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6026:     ;
02:0004B524 023C00EE        	  6027:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B528 123C0004        	  6028:     move.b  #$04,D1
02:0004B52C D101            	  6029:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004B52E 5303            	  6030:     subq.b  #1,D3
02:0004B530 66F2            	  6031:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004B532 1880            	  6032:     move.b  D0,($0000,A4)
                            	  6033:     ; Set object's direction to player's. It might have changed
                            	  6034:     ; since the last frame.
                            	  6035:     ;
02:0004B534 102C0098        	  6036:     move.b  ($0098,A4),D0
02:0004B538 41EC0098        	  6037:     lea     ($0098,A4),A0
02:0004B53C 11802000        	  6038:     move.b  D0,(A0,D2.W)
                            	  6039:     ; Add [00] and the reverse index of the direction to get
                            	  6040:     ; the byte offset of the pixel offset.
                            	  6041:     ;
02:0004B540 4EB900030920    	  6042:     jsr     GetOppositeDir
02:0004B546 1003            	  6043:     move.b  D3,D0
02:0004B548 023C00EE        	  6044:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B54C 1214            	  6045:     move.b  ($0000,A4),D1
02:0004B54E D101            	  6046:     addx.b  D1,D0   ; ADC $00
02:0004B550 7600            	  6047:     moveq   #0,D3
02:0004B552 1600            	  6048:     move.b  D0,D3
                            	  6049:     ; Set object's X to player's X + offset for state and direction.
                            	  6050:     ; Copy the result to [00].
                            	  6051:     ;
02:0004B554 102C0070        	  6052:     move.b  ($0070,A4),D0
02:0004B558 023C00EE        	  6053:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B55C 41F90004B488    	  6054:     lea     (PlayerToWeaponOffsetsX).l,A0
02:0004B562 12303000        	  6055:     move.b  (A0,D3.W),D1
02:0004B566 D101            	  6056:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:0004B568 19802070        	  6057:     move.b  D0,($70,A4,D2.W)
02:0004B56C 1880            	  6058:     move.b  D0,($0000,A4)
                            	  6059:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6060:     ; Copy the result to [01].
                            	  6061:     ;
02:0004B56E 102C0084        	  6062:     move.b  ($0084,A4),D0
02:0004B572 023C00EE        	  6063:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B576 41F90004B498    	  6064:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004B57C 12303000        	  6065:     move.b  (A0,D3.W),D1
02:0004B580 D101            	  6066:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004B582 41EC0084        	  6067:     lea     ($0084,A4),A0
02:0004B586 11802000        	  6068:     move.b  D0,(A0,D2.W)
02:0004B58A 19400001        	  6069:     move.b  D0,($0001,A4)
                            	  6070:     ; If state = 1, use up direction.
                            	  6071:     ; Else use object direction.
                            	  6072:     ;
02:0004B58E 41EC00AC        	  6073:     lea     ($00AC,A4),A0
02:0004B592 10302000        	  6074:     move.b  (A0,D2.W),D0
02:0004B596 0200000F        	  6075:     andi.b #$0F,D0
02:0004B59A 7600            	  6076:     moveq   #0,D3
02:0004B59C 1600            	  6077:     move.b  D0,D3
02:0004B59E 7008            	  6078:     moveq   #8,D0
02:0004B5A0 5303            	  6079:     subq.b  #1,D3
02:0004B5A2 6708            	  6080:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:0004B5A4 41EC0098        	  6081:     lea     ($0098,A4),A0
