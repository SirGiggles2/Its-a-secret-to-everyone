                            	  8712:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8713:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8714:     ; map mark tile.
                            	  8715:     ;
02:00044088 7013            	  8716:     moveq   #19,D0
02:0004408A 1940033F        	  8717:     move.b  D0,($033F,A4)
                            	  8718:     ; Get the currently scanned room's visit state.
                            	  8719:     ;
02:0004408E 7600            	  8720:     moveq   #0,D3
02:00044090 162C00EB        	  8721:     move.b  ($00EB,A4),D3
02:00044094 1214            	  8722:     move.b  ($00,A4),D1   ; ptr lo
02:00044096 182C0001        	  8723:     move.b  ($01,A4),D4  ; ptr hi
02:0004409A 024100FF        	  8724:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004409E E14C            	  8725:     lsl.w   #8,D4
02:000440A0 8841            	  8726:     or.w    D1,D4             ; D4 = NES ptr addr
02:000440A2 48C4            	  8727:     ext.l   D4
02:000440A4 D8BC00FF0000    	  8728:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000440AA 2044            	  8729:     movea.l D4,A0
02:000440AC 10303000        	  8730:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000440B0 02000020        	  8731:     andi.b #$20,D0
                            	  8732:     ; If it's been visited, then check each of the 4 doors,
                            	  8733:     ; and build an open door mask.
