02:0004250E 182C0003        	  5575:     move.b  ($03,A4),D4  ; ptr hi
02:00042512 024100FF        	  5576:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042516 E14C            	  5577:     lsl.w   #8,D4
02:00042518 8841            	  5578:     or.w    D1,D4             ; D4 = NES ptr addr
