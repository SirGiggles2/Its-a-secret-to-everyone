                            	 12069: PatraChild_State1:
                            	 12070:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12071:     ;
02:0003E0A0 10342070        	 12072:     move.b  ($70,A4,D2.W),D0
02:0003E0A4 023C00EE        	 12073:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E0A8 122C046C        	 12074:     move.b  ($046C,A4),D1
02:0003E0AC D101            	 12075:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003E0AE 19802070        	 12076:     move.b  D0,($70,A4,D2.W)
02:0003E0B2 41EC0084        	 12077:     lea     ($0084,A4),A0
02:0003E0B6 10302000        	 12078:     move.b  (A0,D2.W),D0
02:0003E0BA 023C00EE        	 12079:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E0BE 122C0479        	 12080:     move.b  ($0479,A4),D1
02:0003E0C2 D101            	 12081:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003E0C4 41EC0084        	 12082:     lea     ($0084,A4),A0
02:0003E0C8 11802000        	 12083:     move.b  D0,(A0,D2.W)
                            	 12084:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12085:     ;
02:0003E0CC 7000            	 12086:     moveq   #0,D0
02:0003E0CE 1940000B        	 12087:     move.b  D0,($000B,A4)
                            	 12088:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12089:     ; monster's angle by $70, else by $60 to go slower.
