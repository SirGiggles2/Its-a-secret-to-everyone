                            	 12171: UpdateGanon_JumpTable:
02:0003E178 0003E184        	 12172:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003E17C 0003E1E6        	 12173:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003E180 0003E214        	 12174:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12175: 
                            	 12176: ; Description:
                            	 12177: ; Lift up the Triforce of Courage while the room is dark.
                            	 12178: ;
                            	 12179: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12180: ;
                            	 12181:     even
                            	 12182: Ganon_ScenePhase0:
02:0003E184 701B            	 12183:     moveq   #27,D0
02:0003E186 19400505        	 12184:     move.b  D0,($0505,A4)
                            	 12185:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12186:     ;
02:0003E18A 102C0028        	 12187:     move.b  ($0028,A4),D0
02:0003E18E 6644            	 12188:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12189:     ; Once the timer expires, it's time to brighten the room.
                            	 12190:     ;
                            	 12191:     ; Save the current object slot.
02:0003E190 1002            	 12192:     move.b  D2,D0
02:0003E192 1B00            	 12193:     move.b  D0,-(A5)  ; PHA
02:0003E194 610007F0        	 12194:     jsr     UpdateCandle
02:0003E198 101D            	 12195:     move.b  (A5)+,D0  ; PLA
02:0003E19A 7400            	 12196:     moveq   #0,D2
02:0003E19C 1400            	 12197:     move.b  D0,D2
                            	 12198:     ; Turn off the room brightening flag, because we're controlling it
                            	 12199:     ; here instead of in the Mode 5 object update loop.
                            	 12200:     ;
02:0003E19E 7000            	 12201:     moveq   #0,D0
02:0003E1A0 1940051E        	 12202:     move.b  D0,($051E,A4)
                            	 12203:     ; On the first frame of the fade-to-light cycle, play the
                            	 12204:     ; Triforce/Ganon song.
                            	 12205:     ;
02:0003E1A4 102C051C        	 12206:     move.b  ($051C,A4),D0
02:0003E1A8 0C0000C0        	 12207:     cmpi.b  #$C0,D0
02:0003E1AC 6606            	 12208:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003E1AE 7002            	 12209:     moveq   #2,D0
02:0003E1B0 19400600        	 12210:     move.b  D0,($0600,A4)
                            	 12211:     even
