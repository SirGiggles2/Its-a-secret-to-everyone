                            	 13647: TurnTowardsPlayer8:
                            	 13648:     ; Build a direction in [00] towards the player.
                            	 13649:     ;
                            	 13650:     ; First, calculate a horizontal component:
                            	 13651:     ;
                            	 13652:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13653:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13654:     ; else                               [00] := 2 (left)
