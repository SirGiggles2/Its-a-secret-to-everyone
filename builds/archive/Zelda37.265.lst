                            	  6060: LayoutUWFloor:
02:00042886 7005            	  6061:     moveq   #5,D0
02:00042888 4EB90002A9FA    	  6062:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:0004288E 610072F0        	  6063:     jsr     GetUniqueRoomId
02:00042892 1B00            	  6064:     move.b  D0,-(A5)  ; PHA
