02:0004B60A 0200000F        	  6133:     andi.b #$0F,D0
02:0004B60E 0C000001        	  6134:     cmpi.b  #$01,D0
02:0004B612 6604            	  6135:     bne.s  __far_z_07_0091
02:0004B614 600000AA        	  6136:     jmp  L1F854_Exit
