                            	  4004: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  4005:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  4006:     ;   full heart=4 partial heart=$70
                            	  4007:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  4008:     ; But the method here yields $3EF, because partial heart is
                            	  4009:     ; considered full when = $FF instead of $100.
                            	  4010:     ;
02:0003149A 102C000E        	  4011:     move.b  ($000E,A4),D0
02:0003149E 003C0011        	  4012:     ori     #$11,CCR  ; SEC: set C+X
02:000314A2 122C0670        	  4013:     move.b  ($0670,A4),D1
02:000314A6 0A3C0010        	  4014:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000314AA 9101            	  4015:     subx.b  D1,D0   ; SBC HeartPartial
02:000314AC 0A3C0010        	  4016:     eori    #$10,CCR  ; restore X = 6502 C
02:000314B0 1940000E        	  4017:     move.b  D0,($000E,A4)
02:000314B4 102C066F        	  4018:     move.b  ($066F,A4),D0
02:000314B8 0200000F        	  4019:     andi.b #$0F,D0
