02:0003A808 6702            	  4480:     beq  _anon_z04_57
02:0003A80A 7060            	  4481:     moveq   #96,D0
                            	  4482: _anon_z04_57:
                            	  4483:     ; If the player is not aligned with the dock, return.
                            	  4484:     ;
