                            	  3221: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3222:     ; Begin with the leever's Y set to Link's Y.
                            	  3223:     ;
02:00039F9E 102C0084        	  3224:     move.b  ($0084,A4),D0
02:00039FA2 41EC0084        	  3225:     lea     ($0084,A4),A0
02:00039FA6 11802000        	  3226:     move.b  D0,(A0,D2.W)
                            	  3227:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3228:     ; it's too close to the top edge of the screen. So, return.
                            	  3229:     ;
02:00039FAA 0C00005D        	  3230:     cmpi.b  #$5D,D0
02:00039FAE 65EC            	  3231:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3232:     ; If facing right, then use X offset $28.
                            	  3233:     ; Else store X offset -$28 in [00].
                            	  3234:     ;
02:00039FB0 7628            	  3235:     moveq   #40,D3
02:00039FB2 41EC0098        	  3236:     lea     ($0098,A4),A0
02:00039FB6 10302000        	  3237:     move.b  (A0,D2.W),D0
02:00039FBA 02000002        	  3238:     andi.b #$02,D0
02:00039FBE 6704            	  3239:     beq  _anon_z04_45
02:00039FC0 163C00D8        	  3240:     move.b  #$D8,D3
                            	  3241: _anon_z04_45:
02:00039FC4 1883            	  3242:     move.b  D3,($0000,A4)
                            	  3243:     ; [01] holds Link's X coordinate.
                            	  3244:     ;
02:00039FC6 102C0070        	  3245:     move.b  ($0070,A4),D0
02:00039FCA 19400001        	  3246:     move.b  D0,($0001,A4)
                            	  3247:     ; Add Link's X and the horizontal offset.
                            	  3248:     ;
02:00039FCE 023C00EE        	  3249:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039FD2 1214            	  3250:     move.b  ($0000,A4),D1
02:00039FD4 D101            	  3251:     addx.b  D1,D0   ; ADC $00
                            	  3252:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3253:     ;
02:00039FD6 020000F8        	  3254:     andi.b #$F8,D0
                            	  3255:     ; Assign that result to the leever's X coordinate and [02].
                            	  3256:     ;
02:00039FDA 19802070        	  3257:     move.b  D0,($70,A4,D2.W)
02:00039FDE 19400002        	  3258:     move.b  D0,($0002,A4)
                            	  3259:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3260:     ;
02:00039FE2 122C0001        	  3261:     move.b  ($0001,A4),D1
02:00039FE6 B001            	  3262:     cmp.b   D1,D0
02:00039FE8 6510            	  3263:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00039FEA 1B00            	  3264:     move.b  D0,-(A5)  ; PHA
02:00039FEC 102C0001        	  3265:     move.b  ($0001,A4),D0
02:00039FF0 19400002        	  3266:     move.b  D0,($0002,A4)
02:00039FF4 101D            	  3267:     move.b  (A5)+,D0  ; PLA
02:00039FF6 19400001        	  3268:     move.b  D0,($0001,A4)
                            	  3269:     even
                            	  3270: _L_z04_UpdateRedLeever_Subtract:
                            	  3271:     ; The point is to get the absolute distance between the two.
                            	  3272:     ;
02:00039FFA 102C0001        	  3273:     move.b  ($0001,A4),D0
02:00039FFE 003C0011        	  3274:     ori     #$11,CCR  ; SEC: set C+X
02:0003A002 122C0002        	  3275:     move.b  ($0002,A4),D1
02:0003A006 0A3C0010        	  3276:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A00A 9101            	  3277:     subx.b  D1,D0   ; SBC $02
02:0003A00C 0A3C0010        	  3278:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3279:     ; If the absolute distance >= $30, then return.
                            	  3280:     ; It means that the leever's X coordinate wrapped around
                            	  3281:     ; the left or right edge of the screen.
                            	  3282:     ;
02:0003A010 0C000030        	  3283:     cmpi.b  #$30,D0
02:0003A014 6486            	  3284:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3285:     even
                            	  3286: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3287:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3288:     ;
