                            	  7559: _anon_z04_96:
                            	  7560:     ; If we have the magic clock, or is stunned, then
                            	  7561:     ; go draw and check collisions.
                            	  7562:     ;
02:0003BEB4 102C066C        	  7563:     move.b  ($066C,A4),D0
02:0003BEB8 1234203D        	  7564:     move.b  ($3D,A4,D2.W),D1
02:0003BEBC 8001            	  7565:     or.b  D1,D0
02:0003BEBE 660000AE        	  7566:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7567:     ; Every odd screen frame, go straight to drawing
                            	  7568:     ; and checking collisions.
                            	  7569:     ;
02:0003BEC2 102C0015        	  7570:     move.b  ($0015,A4),D0
02:0003BEC6 E208            	  7571:     lsr.b  #1,D0   ; LSR A
02:0003BEC8 6404            	  7572:     bcc.s  __far_z_04_0068
02:0003BECA 60000118        	  7573:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7574: __far_z_04_0068:
                            	  7575:     ; Otherwise move horizontally.
                            	  7576:     ;
02:0003BECE 61000248        	  7577:     jsr     PolsVoice_MoveX
                            	  7578:     ; If state <> 0, then the monster is jumping.
                            	  7579:     ; Go handle vertical movement.
                            	  7580:     ;
02:0003BED2 41EC00AC        	  7581:     lea     ($00AC,A4),A0
02:0003BED6 10302000        	  7582:     move.b  (A0,D2.W),D0
02:0003BEDA 6706            	  7583:     beq  _L_z04_UpdatePolsVoice_State0
02:0003BEDC 61000130        	  7584:     jsr     UpdatePolsVoiceState1_Jumping
02:0003BEE0 6034            	  7585:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  7586: 
                            	  7587:     even
                            	  7588: _L_z04_UpdatePolsVoice_State0:
                            	  7589:     ; State 0. Walking.
                            	  7590:     ;
                            	  7591:     ; If grid offset = 0, then no more distance to cover.
                            	  7592:     ; So, go change to state 1 -- jumping.
                            	  7593:     ;
02:0003BEE2 41EC0394        	  7594:     lea     ($0394,A4),A0
02:0003BEE6 10302000        	  7595:     move.b  (A0,D2.W),D0
02:0003BEEA 67000084        	  7596:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7597:     ; Decrement grid offset / distance remaining.
                            	  7598:     ;
02:0003BEEE 41EC0394        	  7599:     lea     ($0394,A4),A0
02:0003BEF2 53302000        	  7600:     subq.b  #1,(A0,D2.W)
                            	  7601:     ; Move vertically.
                            	  7602:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7603:     ;
02:0003BEF6 41EC0084        	  7604:     lea     ($0084,A4),A0
02:0003BEFA 10302000        	  7605:     move.b  (A0,D2.W),D0
02:0003BEFE 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF02 41F90003BE92    	  7607:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003BF08 12303000        	  7608:     move.b  (A0,D3.W),D1
02:0003BF0C D101            	  7609:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003BF0E 41EC0084        	  7610:     lea     ($0084,A4),A0
02:0003BF12 11802000        	  7611:     move.b  D0,(A0,D2.W)
                            	  7612:     even
                            	  7613: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7614:     ; If the square the monster is over is walkable, then
                            	  7615:     ; go draw and check object collisions.
                            	  7616:     ;
02:0003BF16 610001F4        	  7617:     jsr     PolsVoice_IsSquareWalkable
02:0003BF1A 6452            	  7618:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7619:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7620:     ; then go change to state 1.
                            	  7621:     ;
02:0003BF1C 41EC041F        	  7622:     lea     ($041F,A4),A0
02:0003BF20 10302000        	  7623:     move.b  (A0,D2.W),D0
02:0003BF24 020000FC        	  7624:     andi.b #$FC,D0
02:0003BF28 0C0000B0        	  7625:     cmpi.b  #$B0,D0
02:0003BF2C 6742            	  7626:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003BF2E 0C0000F4        	  7627:     cmpi.b  #$F4,D0
02:0003BF32 643C            	  7628:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7629:     ; Else blocked by something else.
