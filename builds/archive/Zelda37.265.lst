02:0003DEB4 19410002        	 11808:     move.b  D1,($0002,A4)
02:0003DEB8 122C0002        	 11809:     move.b  ($0002,A4),D1
02:0003DEBC C200            	 11810:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEBE 6716            	 11811:     beq  _L_z04_Lamnola_Move_Down
02:0003DEC0 10342070        	 11812:     move.b  ($70,A4,D2.W),D0
02:0003DEC4 122C04E6        	 11813:     move.b  ($04E6,A4),D1
02:0003DEC8 0A3C0010        	 11814:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DECC 9101            	 11815:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003DECE 0A3C0010        	 11816:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DED2 19802070        	 11817:     move.b  D0,($70,A4,D2.W)
                            	 11818:     even
