                            	  9676:     ;
02:0003CED2 7000            	  9677:     moveq   #0,D0
02:0003CED4 41EC0412        	  9678:     lea     ($0412,A4),A0
02:0003CED8 11802000        	  9679:     move.b  D0,(A0,D2.W)
02:0003CEDC 61001C62        	  9680:     jsr     ReverseObjDir8
02:0003CEE0 41EC045E        	  9681:     lea     ($045E,A4),A0
02:0003CEE4 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003CEE8 41EC045E        	  9683:     lea     ($045E,A4),A0
02:0003CEEC 52302000        	  9684:     addq.b  #1,(A0,D2.W)
                            	  9685:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9686:     ; should randomly change direction.
                            	  9687:     ;
02:0003CEF0 E208            	  9688:     lsr.b  #1,D0   ; LSR A
02:0003CEF2 640A            	  9689:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003CEF4 7000            	  9690:     moveq   #0,D0
02:0003CEF6 41EC0451        	  9691:     lea     ($0451,A4),A0
