02:000426C8 41EC0302        	  5816:     lea     ($0302,A4),A0
02:000426CC 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:000426D0 1002            	  5818:     move.b  D2,D0
02:000426D2 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:000426D6 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:000426DA 102C0054        	  5829:     move.b  ($0054,A4),D0
02:000426DE 02000003        	  5830:     andi.b #$03,D0
02:000426E2 6708            	  5831:     beq  _anon_z05_122
02:000426E4 7008            	  5832:     moveq   #8,D0
02:000426E6 19400027        	  5833:     move.b  D0,($0027,A4)
02:000426EA 4E75            	  5834:     rts
