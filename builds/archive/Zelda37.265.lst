02:0004A864 6614            	  4136:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004A866 102C0053        	  4137:     move.b  ($0053,A4),D0
02:0004A86A 6704            	  4138:     beq  _anon_z07_16
02:0004A86C 600000BE        	  4139:     jmp     GoWalkableDir
