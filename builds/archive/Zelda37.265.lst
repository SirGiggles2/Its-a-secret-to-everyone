02:0003D062 123C0008        	  9901:     move.b  #$08,D1
02:0003D066 D101            	  9902:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D068 19802070        	  9903:     move.b  D0,($70,A4,D2.W)
02:0003D06C 532C000F        	  9904:     subq.b  #1,($000F,A4)
