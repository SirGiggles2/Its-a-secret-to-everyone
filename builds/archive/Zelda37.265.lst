02:0003B050 02000007        	  5523:     andi.b #$07,D0
02:0003B054 7600            	  5524:     moveq   #0,D3
02:0003B056 1600            	  5525:     move.b  D0,D3
02:0003B058 41F90003EA34    	  5526:     lea     (Directions8).l,A0
02:0003B05E 10303000        	  5527:     move.b  (A0,D3.W),D0
02:0003B062 1940009D        	  5528:     move.b  D0,($009D,A4)
02:0003B066 19400385        	  5529:     move.b  D0,($0385,A4)
02:0003B06A 102C0022        	  5530:     move.b  ($0022,A4),D0
02:0003B06E 02000007        	  5531:     andi.b #$07,D0
02:0003B072 7600            	  5532:     moveq   #0,D3
02:0003B074 1600            	  5533:     move.b  D0,D3
02:0003B076 41F90003EA34    	  5534:     lea     (Directions8).l,A0
02:0003B07C 10303000        	  5535:     move.b  (A0,D3.W),D0
02:0003B080 194000A2        	  5536:     move.b  D0,($00A2,A4)
