                            	  2586: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2587:     ; Set state 1 to jump.
                            	  2588:     ;
02:00039ADA 41EC00AC        	  2589:     lea     ($00AC,A4),A0
02:00039ADE 52302000        	  2590:     addq.b  #1,(A0,D2.W)
                            	  2591:     even
                            	  2592: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2593:     ; If reversal count >= 2, then
                            	  2594:     ; 1. invert the horizontal component of facing direction,
                            	  2595:     ;    to face away from the chase target
                            	  2596:     ; 2. reset the reversal count to 0.
                            	  2597:     ;
                            	  2598:     ; This prevents a jumper from getting stuck in a corner.
                            	  2599:     ;
                            	  2600:     ; For example, if a tektite's direction is down and right,
                            	  2601:     ; and jumps into the top right corner of the room:
                            	  2602:     ; 1. The right room boundary is hit. So the direction is
                            	  2603:     ;    automatically reversed to up and left.
                            	  2604:     ; 2. The next frame, the top room boundary is hit.
                            	  2605:     ;    The direction is reversed to down and right.
                            	  2606:     ;
                            	  2607:     ; As you can see, an endless loop has been made.
                            	  2608:     ;
02:00039AE2 41EC0451        	  2609:     lea     ($0451,A4),A0
02:00039AE6 10302000        	  2610:     move.b  (A0,D2.W),D0
02:00039AEA 0C000002        	  2611:     cmpi.b  #$02,D0
02:00039AEE 651E            	  2612:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:00039AF0 41EC0098        	  2613:     lea     ($0098,A4),A0
02:00039AF4 10302000        	  2614:     move.b  (A0,D2.W),D0
02:00039AF8 0A000003        	  2615:     eori.b #$03,D0
02:00039AFC 41EC0098        	  2616:     lea     ($0098,A4),A0
02:00039B00 11802000        	  2617:     move.b  D0,(A0,D2.W)
02:00039B04 7000            	  2618:     moveq   #0,D0
02:00039B06 41EC0451        	  2619:     lea     ($0451,A4),A0
02:00039B0A 11802000        	  2620:     move.b  D0,(A0,D2.W)
                            	  2621:     even
                            	  2622: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2623:     ; If the object is a boulder, then make sure its facing direction
                            	  2624:     ; has a down vertical component.
                            	  2625:     ;
02:00039B0E 610001F8        	  2626:     jsr     Jumper_PointBoulderDownward
                            	  2627:     ; For the given direction, get the Y offset of the destination
                            	  2628:     ; of the jump.
                            	  2629:     ;
                            	  2630:     ; Add it to the object's Y, and store this destination Y.
                            	  2631:     ;
02:00039B12 7600            	  2632:     moveq   #0,D3
02:00039B14 41EC0098        	  2633:     lea     ($0098,A4),A0
02:00039B18 16302000        	  2634:     move.b  (A0,D2.W),D3
02:00039B1C 41EC0084        	  2635:     lea     ($0084,A4),A0
02:00039B20 10302000        	  2636:     move.b  (A0,D2.W),D0
02:00039B24 023C00EE        	  2637:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039B28 41F900039A40    	  2638:     lea     (JumperYOffsets).l,A0
02:00039B2E 12303000        	  2639:     move.b  (A0,D3.W),D1
02:00039B32 D101            	  2640:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:00039B34 41EC0444        	  2641:     lea     ($0444,A4),A0
02:00039B38 11802000        	  2642:     move.b  D0,(A0,D2.W)
                            	  2643:     ; Set the starting speed, depending on the object type.
                            	  2644:     ;
02:00039B3C 610001A0        	  2645:     jsr     Jumper_GetKind
02:00039B40 41F900039A6A    	  2646:     lea     (JumperStartSpeedsHi).l,A0
02:00039B46 10303000        	  2647:     move.b  (A0,D3.W),D0
02:00039B4A 41EC0412        	  2648:     lea     ($0412,A4),A0
02:00039B4E 11802000        	  2649:     move.b  D0,(A0,D2.W)
                            	  2650:     ; Reset the vertical speed low byte.
                            	  2651:     ; Then go animate, draw, and check collisions.
                            	  2652:     ;
02:00039B52 6100022E        	  2653:     jsr     Jumper_ResetVSpeedFrac
                            	  2654:     even
                            	  2655: _L_z04_UpdateTektiteOrBoulder_Animate:
02:00039B56 60000116        	  2656:     jmp     Jumper_AnimateAndCheckCollisions
                            	  2657: 
                            	  2658:     even
                            	  2659: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2660:     ; State 1. Jumping.
                            	  2661:     ;
                            	  2662:     ; Keep the object inside the bounds of the room.
                            	  2663:     ;
02:00039B5A 61004FB6        	  2664:     jsr     BoundFlyer
                            	  2665:     ; If the object was blocked at the room boundary, then
                            	  2666:     ; increase boundary reversal count, and go set up another jump.
                            	  2667:     ;
02:00039B5E 102C000F        	  2668:     move.b  ($000F,A4),D0
02:00039B62 660C            	  2669:     bne  _anon_z04_37
02:00039B64 41EC0451        	  2670:     lea     ($0451,A4),A0
02:00039B68 52302000        	  2671:     addq.b  #1,(A0,D2.W)
02:00039B6C 6000FF74        	  2672:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2673: 
                            	  2674: _anon_z04_37:
02:00039B70 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:00039B74 7000            	  2678:     moveq   #0,D0
02:00039B76 41EC0451        	  2679:     lea     ($0451,A4),A0
02:00039B7A 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:00039B7E 6100015E        	  2683:     jsr     Jumper_GetKind
02:00039B82 41F900039A6E    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:00039B88 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:00039B8C 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039B90 41EC0098        	  2696:     lea     ($0098,A4),A0
02:00039B94 12302000        	  2697:     move.b  (A0,D2.W),D1
02:00039B98 D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:00039B9A 7600            	  2699:     moveq   #0,D3
02:00039B9C 1600            	  2700:     move.b  D0,D3
02:00039B9E 41F900039A4C    	  2701:     lea     (JumperYAccelerations).l,A0
02:00039BA4 10303000        	  2702:     move.b  (A0,D3.W),D0
02:00039BA8 7602            	  2703:     moveq   #2,D3
02:00039BAA 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
                            	  2707:     ;
                            	  2708:     ; Else add 1.
                            	  2709:     ;
02:00039BAE 163C00FF        	  2710:     move.b  #$FF,D3
02:00039BB2 41EC0098        	  2711:     lea     ($0098,A4),A0
02:00039BB6 10302000        	  2712:     move.b  (A0,D2.W),D0
02:00039BBA 02000002        	  2713:     andi.b #$02,D0
02:00039BBE 6602            	  2714:     bne  _anon_z04_38
02:00039BC0 7601            	  2715:     moveq   #1,D3
                            	  2716: _anon_z04_38:
02:00039BC2 1003            	  2717:     move.b  D3,D0
02:00039BC4 023C00EE        	  2718:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039BC8 12342070        	  2719:     move.b  ($70,A4,D2.W),D1
02:00039BCC D101            	  2720:     addx.b  D1,D0   ; ADC ObjX,X
02:00039BCE 19802070        	  2721:     move.b  D0,($70,A4,D2.W)
                            	  2722:     ; If going up (negative v-speed high byte), then
                            	  2723:     ; go animate, draw, and check collisions.
                            	  2724:     ;
02:00039BD2 41EC0412        	  2725:     lea     ($0412,A4),A0
02:00039BD6 10302000        	  2726:     move.b  (A0,D2.W),D0
02:00039BDA 6A04            	  2727:     bpl.s  __far_z_04_0022
02:00039BDC 60000090        	  2728:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2729: __far_z_04_0022:
                            	  2730:     ; Going down. We have to consider the target Y.
                            	  2731:     ;
                            	  2732:     ; If the absolute vertical distance to the target position >= 3,
                            	  2733:     ; then go animate, draw, and check collisions.
                            	  2734:     ;
02:00039BE0 41EC0084        	  2735:     lea     ($0084,A4),A0
02:00039BE4 10302000        	  2736:     move.b  (A0,D2.W),D0
02:00039BE8 003C0011        	  2737:     ori     #$11,CCR  ; SEC: set C+X
02:00039BEC 41EC0444        	  2738:     lea     ($0444,A4),A0
02:00039BF0 12302000        	  2739:     move.b  (A0,D2.W),D1
02:00039BF4 0A3C0010        	  2740:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039BF8 9101            	  2741:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:00039BFA 0A3C0010        	  2742:     eori    #$10,CCR  ; restore X = 6502 C
02:00039BFE 4EB900030924    	  2743:     jsr     Abs
02:00039C04 0C000003        	  2744:     cmpi.b  #$03,D0
02:00039C08 6502            	  2745:     bcs.s  __far_z_04_0023
02:00039C0A 6062            	  2746:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2747: __far_z_04_0023:
                            	  2748:     ; Distance < 3. Go to state 0.
                            	  2749:     ;
                            	  2750:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2751:     ;
02:00039C0C 4EB90004B6C2    	  2752:     jsr     ResetObjState
02:00039C12 7600            	  2753:     moveq   #0,D3
