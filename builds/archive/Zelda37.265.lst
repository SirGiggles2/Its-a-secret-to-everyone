                            	  1469:     even
                            	  1470: _L_z01_CheckTileObjectsBlocking_Found:
02:00030216 41EC00AC        	  1471:     lea     ($00AC,A4),A0
02:0003021A 10302000        	  1472:     move.b  (A0,D2.W),D0
02:0003021E 0C000001        	  1473:     cmpi.b  #$01,D0
02:00030222 6654            	  1474:     bne  _L_z01_CheckTileObjectsBlocking_NextTileObj
                            	  1475:     ; If X distance between Link and the object >= $10, skip it.
                            	  1476:     ;
02:00030224 102C0070        	  1477:     move.b  ($0070,A4),D0
02:00030228 003C0011        	  1478:     ori     #$11,CCR  ; SEC: set C+X
02:0003022C 12342070        	  1479:     move.b  ($70,A4,D2.W),D1
02:00030230 0A3C0010        	  1480:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030234 9101            	  1481:     subx.b  D1,D0   ; SBC ObjX,X
02:00030236 0A3C0010        	  1482:     eori    #$10,CCR  ; restore X = 6502 C
02:0003023A 610006E8        	  1483:     jsr     Abs
