                            	   953: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   954: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   955:     move.l  D0,-(SP)
02:0002B6C8 7200            	   956:     moveq   #0,D1
02:0002B6CA 1202            	   957:     move.b  D2,D1
02:0002B6CC 2F01            	   958:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   959:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   960:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   961:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   962:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   963:     addq.l  #8,SP
02:0002B6E2 201F            	   964:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   965:     rts
