                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:0004271C 102C0055        	  5870:     move.b  ($0055,A4),D0
02:00042720 19400002        	  5871:     move.b  D0,($0002,A4)
02:00042724 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:00042728 0C000007        	  5873:     cmpi.b  #$07,D0
02:0004272C 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:0004272E 7400            	  5879:     moveq   #0,D2
02:00042730 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00042734 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00042738 1003            	  5884:     move.b  D3,D0
02:0004273A 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004273E 41F9000425FA    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00042744 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00042748 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0004274A 7600            	  5889:     moveq   #0,D3
02:0004274C 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:0004274E 1002            	  5893:     move.b  D2,D0
02:00042750 0A000001        	  5894:     eori.b #$01,D0
02:00042754 7400            	  5895:     moveq   #0,D2
02:00042756 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00042758 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:0004275A 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:0004275E 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042762 E14C            	  5902:     lsl.w   #8,D4
02:00042764 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042766 48C4            	  5904:     ext.l   D4
02:00042768 D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004276E 2044            	  5906:     movea.l D4,A0
02:00042770 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042774 41F9000498B6    	  5908:     lea     (LevelMasks).l,A0
02:0004277A 12302000        	  5909:     move.b  (A0,D2.W),D1
02:0004277E 8001            	  5910:     or.b  D1,D0
02:00042780 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:00042782 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00042786 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004278A E14C            	  5914:     lsl.w   #8,D4
02:0004278C 8841            	  5915:     or.w    D1,D4
02:0004278E 48C4            	  5916:     ext.l   D4
02:00042790 D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:00042796 2044            	  5918:     movea.l D4,A0
02:00042798 11803000        	  5919:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:0004279C 102C0055        	  5924:     move.b  ($0055,A4),D0
02:000427A0 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:000427A4 8001            	  5926:     or.b  D1,D0
02:000427A6 6000FF66        	  5927:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:000427AA 102C0055        	  5954:     move.b  ($0055,A4),D0
02:000427AE 19400002        	  5955:     move.b  D0,($0002,A4)
02:000427B2 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:000427B6 0C000005        	  5957:     cmpi.b  #$05,D0
02:000427BA 650C            	  5958:     bcs  _anon_z05_125
02:000427BC 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:000427BE 7004            	  5960:     moveq   #4,D0
02:000427C0 4EB9000307E6    	  5961:     jsr     PlaySample
02:000427C6 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:000427C8 0C000004        	  5969:     cmpi.b  #$04,D0
02:000427CC 6602            	  5970:     bne  _anon_z05_126
02:000427CE 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:000427D0 0C000001        	  5973:     cmpi.b  #$01,D0
02:000427D4 6602            	  5974:     bne  _anon_z05_127
02:000427D6 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:000427D8 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:000427DC 123C0003        	  5980:     move.b  #$03,D1
02:000427E0 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000427E4 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:000427E6 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:000427EA 7600            	  5984:     moveq   #0,D3
02:000427EC 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:000427EE 102C0008        	  5992:     move.b  ($0008,A4),D0
02:000427F2 6708            	  5993:     beq  _anon_z05_128
02:000427F4 0C030005        	  5994:     cmpi.b  #$05,D3
02:000427F8 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000427FA 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:000427FC 0C030003        	  5998:     cmpi.b  #$03,D3
02:00042800 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00042802 5303            	  6000:     subq.b  #1,D3
                            	  6001:     even
                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:00042804 7003            	  6008:     moveq   #3,D0
02:00042806 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:0004280A 122C0003        	  6010:     move.b  ($0003,A4),D1
02:0004280E 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042812 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:00042814 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6014:     ; Call this to put the address of door face tiles in [02:03].
                            	  6015:     ;
02:00042818 6100FD7A        	  6016:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6017:     ; Return the address of the door in the nametable in [01:00].
                            	  6018:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6019:     ;
02:0004281C 41F9000425F2    	  6020:     lea     (DoorVramAddrsHi).l,A0
02:00042822 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00042826 1880            	  6022:     move.b  D0,($0000,A4)
02:00042828 41F9000425F6    	  6023:     lea     (DoorVramAddrsLo).l,A0
02:0004282E 10302000        	  6024:     move.b  (A0,D2.W),D0
02:00042832 19400001        	  6025:     move.b  D0,($0001,A4)
                            	  6026:     ; Return the direction of the door in [09], and the dynamic
                            	  6027:     ; transfer buf length in X register.
                            	  6028:     ;
02:00042836 19420009        	  6029:     move.b  D2,($0009,A4)
02:0004283A 7400            	  6030:     moveq   #0,D2
02:0004283C 142C0301        	  6031:     move.b  ($0301,A4),D2
                            	  6032:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6033:     ;
02:00042840 7000            	  6034:     moveq   #0,D0
02:00042842 19400007        	  6035:     move.b  D0,($0007,A4)
02:00042846 7002            	  6036:     moveq   #2,D0
02:00042848 19400006        	  6037:     move.b  D0,($0006,A4)
02:0004284C 19400005        	  6038:     move.b  D0,($0005,A4)
02:00042850 0A3C0001        	  6039:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00042854 4E75            	  6040:     rts
