                            	  7631:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7632:     ;
02:0003BF34 41EC0098        	  7633:     lea     ($0098,A4),A0
02:0003BF38 10302000        	  7634:     move.b  (A0,D2.W),D0
02:0003BF3C 02000003        	  7635:     andi.b #$03,D0
02:0003BF40 6618            	  7636:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7637:     ; Else facing vertically. Flip the direction.
                            	  7638:     ; Go draw.
                            	  7639:     ;
02:0003BF42 41EC0098        	  7640:     lea     ($0098,A4),A0
02:0003BF46 10302000        	  7641:     move.b  (A0,D2.W),D0
02:0003BF4A 0A00000C        	  7642:     eori.b #$0C,D0
02:0003BF4E 41EC0098        	  7643:     lea     ($0098,A4),A0
02:0003BF52 11802000        	  7644:     move.b  D0,(A0,D2.W)
02:0003BF56 6000008C        	  7645:     jmp     L_PolsVoice_DrawAndCheckCollisions
