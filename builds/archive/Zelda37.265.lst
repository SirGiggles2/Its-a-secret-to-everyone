02:0003CDE8 0200000F        	  9562:     andi.b #$0F,D0
02:0003CDEC 0C000002        	  9563:     cmpi.b  #$02,D0
02:0003CDF0 670C            	  9564:     beq  _anon_z04_117
02:0003CDF2 0C000003        	  9565:     cmpi.b  #$03,D0
02:0003CDF6 6706            	  9566:     beq  _anon_z04_117
02:0003CDF8 4EF900030E26    	  9567:     jmp     DrawObjectMirrored
