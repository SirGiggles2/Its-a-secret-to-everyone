02:0004AD9A 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:0004AD9C 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:0004ADA0 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004ADA2 102C0513        	  4956:     move.b  ($0513,A4),D0
02:0004ADA6 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:0004ADA8 7000            	  4958:     moveq   #0,D0
02:0004ADAA 19400513        	  4959:     move.b  D0,($0513,A4)
02:0004ADAE 4EB90003097A    	  4960:     jsr     WieldCandle
