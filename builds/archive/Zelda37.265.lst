02:0003BE24 6100CC50        	  7486:     jsr     UpdateCommonWanderer
02:0003BE28 4EB9000311A6    	  7487:     jsr     CheckMonsterCollisions
                            	  7488:     ; Darknuts are never stunned.
                            	  7489:     ;
