02:00040EC6 122C0004        	  3901:     move.b  ($0004,A4),D1
02:00040ECA 0A3C0010        	  3902:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040ECE 9101            	  3903:     subx.b  D1,D0   ; SBC $04
