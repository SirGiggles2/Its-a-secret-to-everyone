02:0003E68A 142C0301        	 12906:     move.b  ($0301,A4),D2
                            	 12907:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 12908:     ;
02:0003E68E 7600            	 12909:     moveq   #0,D3
                            	 12910:     even
                            	 12911: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003E690 41F90003E668    	 12912:     lea     (GanonColorTransferRecord).l,A0
