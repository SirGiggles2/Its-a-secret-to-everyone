02:0002EAD2 7600            	   428:     moveq   #0,D3
02:0002EAD4 41EC046C        	   429:     lea     ($046C,A4),A0
02:0002EAD8 16302000        	   430:     move.b  (A0,D2.W),D3
02:0002EADC 41EC046F        	   431:     lea     ($046F,A4),A0
02:0002EAE0 10303000        	   432:     move.b  (A0,D3.W),D0
02:0002EAE4 41EC0448        	   433:     lea     ($0448,A4),A0
02:0002EAE8 11802000        	   434:     move.b  D0,(A0,D2.W)
02:0002EAEC 5302            	   435:     subq.b  #1,D2
02:0002EAEE 6AE2            	   436:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   437:     even
