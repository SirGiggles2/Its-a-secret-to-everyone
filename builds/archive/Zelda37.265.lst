                            	  7029: Dodongo_CheckBombHit:
                            	  7030:     ; If state <> 0 (not moving), then return.
                            	  7031:     ;
02:0003BB4A 41EC00AC        	  7032:     lea     ($00AC,A4),A0
02:0003BB4E 10302000        	  7033:     move.b  (A0,D2.W),D0
02:0003BB52 66000086        	  7034:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7035:     ; If facing vertically, then store (X + 8) in [00].
                            	  7036:     ; Else store (X + $10).
                            	  7037:     ;
02:0003BB56 10342070        	  7038:     move.b  ($70,A4,D2.W),D0
02:0003BB5A 023C00EE        	  7039:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB5E 123C0008        	  7040:     move.b  #$08,D1
02:0003BB62 D101            	  7041:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB64 7600            	  7042:     moveq   #0,D3
02:0003BB66 41EC0098        	  7043:     lea     ($0098,A4),A0
02:0003BB6A 16302000        	  7044:     move.b  (A0,D2.W),D3
02:0003BB6E 0C030004        	  7045:     cmpi.b  #$04,D3
02:0003BB72 6406            	  7046:     bcc  _anon_z04_91
02:0003BB74 123C0008        	  7047:     move.b  #$08,D1
02:0003BB78 D101            	  7048:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7049: _anon_z04_91:
02:0003BB7A 1880            	  7050:     move.b  D0,($0000,A4)
                            	  7051:     ; Store (Y + 8) in [01].
                            	  7052:     ;
02:0003BB7C 41EC0084        	  7053:     lea     ($0084,A4),A0
02:0003BB80 10302000        	  7054:     move.b  (A0,D2.W),D0
02:0003BB84 123C0008        	  7055:     move.b  #$08,D1
02:0003BB88 D101            	  7056:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB8A 19400001        	  7057:     move.b  D0,($0001,A4)
                            	  7058:     ; Only check the first bomb slot ($10).
                            	  7059:     ;
                            	  7060:     ; Store the bomb's (X + 8) in [02].
                            	  7061:     ;
02:0003BB8E 7610            	  7062:     moveq   #16,D3
02:0003BB90 10343070        	  7063:     move.b  ($70,A4,D3.W),D0
02:0003BB94 123C0008        	  7064:     move.b  #$08,D1
02:0003BB98 D101            	  7065:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BB9A 19400002        	  7066:     move.b  D0,($0002,A4)
                            	  7067:     ; Store the bomb's (Y + 8) in [03].
                            	  7068:     ;
02:0003BB9E 41EC0084        	  7069:     lea     ($0084,A4),A0
02:0003BBA2 10303000        	  7070:     move.b  (A0,D3.W),D0
02:0003BBA6 123C0008        	  7071:     move.b  #$08,D1
02:0003BBAA D101            	  7072:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BBAC 19400003        	  7073:     move.b  D0,($0003,A4)
                            	  7074:     ; But, if there's no bomb, then return.
                            	  7075:     ;
02:0003BBB0 41EC00AC        	  7076:     lea     ($00AC,A4),A0
02:0003BBB4 10303000        	  7077:     move.b  (A0,D3.W),D0
02:0003BBB8 6720            	  7078:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7079:     ; If the bomb has not exploded (state $12), then
                            	  7080:     ; go see if Dodongo will eat it.
                            	  7081:     ;
02:0003BBBA 0C000012        	  7082:     cmpi.b  #$12,D0
02:0003BBBE 6602            	  7083:     bne.s  __far_z_04_0065
02:0003BBC0 601A            	  7084:     jmp  Dodongo_TryEatBomb
                            	  7085: __far_z_04_0065:
                            	  7086:     ; If the object in the slot is actually a fire, then return.
                            	  7087:     ;
02:0003BBC2 0C000020        	  7088:     cmpi.b  #$20,D0
02:0003BBC6 6412            	  7089:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7090:     ; The bomb already blew up.
                            	  7091:     ; If the dust cloud is in range of the monster,
                            	  7092:     ; then set stunned state (2).
                            	  7093:     ;
02:0003BBC8 7600            	  7094:     moveq   #0,D3
02:0003BBCA 61000082        	  7095:     jsr     Dodongo_IsBombInRange
02:0003BBCE 660A            	  7096:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003BBD0 7002            	  7097:     moveq   #2,D0
02:0003BBD2 41EC00AC        	  7098:     lea     ($00AC,A4),A0
02:0003BBD6 11802000        	  7099:     move.b  D0,(A0,D2.W)
                            	  7100:     even
                            	  7101: _L_z04_Dodongo_CheckBombHit_Exit:
02:0003BBDA 4E75            	  7102:     rts
                            	  7103: 
