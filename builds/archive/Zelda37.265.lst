02:0003DE1E 0A3C0010        	 11728:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DE22 9101            	 11729:     subx.b  D1,D0   ; SBC ObjX,X
02:0003DE24 0A3C0010        	 11730:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DE28 640A            	 11731:     bcc  _anon_z04_153
02:0003DE2A 122C0002        	 11732:     move.b  ($0002,A4),D1
02:0003DE2E E309            	 11733:     lsl.b  #1,D1   ; ASL $02
02:0003DE30 19410002        	 11734:     move.b  D1,($0002,A4)
                            	 11735: _anon_z04_153:
                            	 11736:     ; Find the vertical direction toward Link and store it in [03].
                            	 11737:     ;
