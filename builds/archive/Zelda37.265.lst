                            	  7105: Dodongo_TryEatBomb:
                            	  7106:     ; Try to eat the bomb.
                            	  7107:     ;
                            	  7108:     ; If the bomb is not in range of the monster, then return.
                            	  7109:     ;
                            	  7110:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7111:     ;
02:0003BBDC 7601            	  7112:     moveq   #1,D3
02:0003BBDE 616E            	  7113:     jsr     Dodongo_IsBombInRange
02:0003BBE0 6666            	  7114:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7115:     ; Will loop from 1 to 0, indexed by [00].
                            	  7116:     ;
02:0003BBE2 7001            	  7117:     moveq   #1,D0
02:0003BBE4 1880            	  7118:     move.b  D0,($0000,A4)
                            	  7119:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7120:     ;
02:0003BBE6 41EC0098        	  7121:     lea     ($0098,A4),A0
02:0003BBEA 10302000        	  7122:     move.b  (A0,D2.W),D0
02:0003BBEE E208            	  7123:     lsr.b  #1,D0   ; LSR A
02:0003BBF0 7600            	  7124:     moveq   #0,D3
02:0003BBF2 1600            	  7125:     move.b  D0,D3
                            	  7126:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7127:     ; position depends on the orientation of the monster.
                            	  7128:     ;
                            	  7129:     ; Start with the horizontal distance.
                            	  7130:     ;
02:0003BBF4 102C0004        	  7131:     move.b  ($0004,A4),D0
                            	  7132:     even
                            	  7133: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7134:     ; Look up the limits for the given direction.
                            	  7135:     ;
                            	  7136:     ; If the distance from the bomb < negative limit,
                            	  7137:     ; or >= positive limit, then return.
                            	  7138:     ;
                            	  7139:     ; Note that these are simple signed comparisons that work,
                            	  7140:     ; because the operands are in a small range.
                            	  7141:     ;
02:0003BBF8 41F90003BB32    	  7142:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003BBFE 12303000        	  7143:     move.b  (A0,D3.W),D1
02:0003BC02 B001            	  7144:     cmp.b   D1,D0
02:0003BC04 6B42            	  7145:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003BC06 41F90003BB38    	  7146:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003BC0C 12303000        	  7147:     move.b  (A0,D3.W),D1
02:0003BC10 B001            	  7148:     cmp.b   D1,D0
02:0003BC12 6A34            	  7149:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7150:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7151:     ;
02:0003BC14 1003            	  7152:     move.b  D3,D0
02:0003BC16 023C00EE        	  7153:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC1A 123C000A        	  7154:     move.b  #$0A,D1
02:0003BC1E D101            	  7155:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003BC20 7600            	  7156:     moveq   #0,D3
02:0003BC22 1600            	  7157:     move.b  D0,D3
                            	  7158:     ; Bottom of the loop.
                            	  7159:     ;
                            	  7160:     ; Load the vertical distance for the next iteration.
                            	  7161:     ; Decrement loop counter.
                            	  7162:     ;
02:0003BC24 102C0005        	  7163:     move.b  ($0005,A4),D0
02:0003BC28 5314            	  7164:     subq.b  #1,($0000,A4)
02:0003BC2A 6ACC            	  7165:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7166:     ; If we get here, then the bomb was within range of the mouth.
                            	  7167:     ; Go to state 1 (bloated).
                            	  7168:     ;
02:0003BC2C 41EC00AC        	  7169:     lea     ($00AC,A4),A0
02:0003BC30 52302000        	  7170:     addq.b  #1,(A0,D2.W)
                            	  7171:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7172:     ;
02:0003BC34 7610            	  7173:     moveq   #16,D3
02:0003BC36 7000            	  7174:     moveq   #0,D0
02:0003BC38 41EC00AC        	  7175:     lea     ($00AC,A4),A0
02:0003BC3C 11803000        	  7176:     move.b  D0,(A0,D3.W)
02:0003BC40 41EC042C        	  7177:     lea     ($042C,A4),A0
02:0003BC44 11802000        	  7178:     move.b  D0,(A0,D2.W)
                            	  7179:     even
                            	  7180: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003BC48 4E75            	  7181:     rts
                            	  7182: 
                            	  7183:     even
                            	  7184: DodongoBombPositiveLimits:
02:0003BC4A 0C              	  7185:     dc.b    $0C, $11
02:0003BC4B 11
                            	  7186: 
                            	  7187:     even
                            	  7188: DodongoBombNegativeLimits:
02:0003BC4C F4              	  7189:     dc.b    $F4, $F0
02:0003BC4D F0
                            	  7190: 
                            	  7191: ; Params:
                            	  7192: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7193: ; [00]: monster hotspot X
                            	  7194: ; [01]: monster hotspot Y
                            	  7195: ; [02]: bomb hotspot X
                            	  7196: ; [03]: bomb hotspot Y
                            	  7197: ;
                            	  7198: ; Returns:
                            	  7199: ; A: 0 if the bomb is in range of the monster
                            	  7200: ; Z: 1 if the bomb is in range of the monster
                            	  7201: ; [04]: horizontal distance
                            	  7202: ; [05]: vertical distance
                            	  7203: ;
                            	  7204: ; Store the positive limit in [06], and the negative one in [07].
                            	  7205: ;
                            	  7206:     even
                            	  7207: Dodongo_IsBombInRange:
02:0003BC4E 41F90003BC4A    	  7208:     lea     (DodongoBombPositiveLimits).l,A0
02:0003BC54 10303000        	  7209:     move.b  (A0,D3.W),D0
02:0003BC58 19400006        	  7210:     move.b  D0,($0006,A4)
02:0003BC5C 41F90003BC4C    	  7211:     lea     (DodongoBombNegativeLimits).l,A0
02:0003BC62 10303000        	  7212:     move.b  (A0,D3.W),D0
02:0003BC66 19400007        	  7213:     move.b  D0,($0007,A4)
                            	  7214:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7215:     ; the bomb is near enough the monster.
                            	  7216:     ;
02:0003BC6A 7003            	  7217:     moveq   #3,D0
02:0003BC6C 19400008        	  7218:     move.b  D0,($0008,A4)
                            	  7219:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7220:     ;
02:0003BC70 7601            	  7221:     moveq   #1,D3
                            	  7222:     even
                            	  7223: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7224:     ; Subtract the bomb's coordinate from the boss's,
                            	  7225:     ; The loop index determines the coordinate.
                            	  7226:     ;
02:0003BC72 10343000        	  7227:     move.b  ($00,A4,D3.W),D0
02:0003BC76 003C0011        	  7228:     ori     #$11,CCR  ; SEC: set C+X
02:0003BC7A 12343002        	  7229:     move.b  ($02,A4,D3.W),D1
02:0003BC7E 0A3C0010        	  7230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BC82 9101            	  7231:     subx.b  D1,D0   ; SBC $0002,Y
02:0003BC84 0A3C0010        	  7232:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7233:     ; If the distance >= positive offset, or < negative offset;
                            	  7234:     ; then loop again.
                            	  7235:     ;
02:0003BC88 122C0006        	  7236:     move.b  ($0006,A4),D1
02:0003BC8C B001            	  7237:     cmp.b   D1,D0
02:0003BC8E 6A16            	  7238:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003BC90 122C0007        	  7239:     move.b  ($0007,A4),D1
02:0003BC94 B001            	  7240:     cmp.b   D1,D0
02:0003BC96 6B0E            	  7241:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7242:     ; The distance is close enough in this axis.
                            	  7243:     ;
                            	  7244:     ; Store the distance in this axis in [05] or [04],
                            	  7245:     ; depending on the loop index.
                            	  7246:     ;
02:0003BC98 19803004        	  7247:     move.b  D0,($04,A4,D3.W)
                            	  7248:     ; Shift [08] right, because we're in range in this axis.
                            	  7249:     ;
02:0003BC9C 122C0008        	  7250:     move.b  ($0008,A4),D1
02:0003BCA0 E209            	  7251:     lsr.b  #1,D1   ; LSR $08
02:0003BCA2 19410008        	  7252:     move.b  D1,($0008,A4)
                            	  7253:     even
                            	  7254: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003BCA6 5303            	  7255:     subq.b  #1,D3
02:0003BCA8 6AC8            	  7256:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7257:     ; If close enough in both axes, then [08] will be 0.
                            	  7258:     ;
02:0003BCAA 102C0008        	  7259:     move.b  ($0008,A4),D0
02:0003BCAE 4E75            	  7260:     rts
                            	  7261: 
                            	  7262: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7263: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7264: ;
                            	  7265: ; But these are not typical direction indexes. Instead a
                            	  7266: ; 5-way index is used.
                            	  7267: ; A direction shifted right once becomes a 5-way index.
                            	  7268: ; The fourth element is unused.
                            	  7269: ;
                            	  7270:     even
                            	  7271: DodongoFrameImages:
02:0003BCB0 00              	  7272:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003BCB1 01
02:0003BCB2 06
02:0003BCB3 FF
02:0003BCB4 08
02:0003BCB5 02
02:0003BCB6 03
02:0003BCB7 06
02:0003BCB8 FF              	  7273:     dc.b    $FF, $08
02:0003BCB9 08
                            	  7274: 
                            	  7275:     even
                            	  7276: DodongoFrameHFlips:
02:0003BCBA 00              	  7277:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003BCBB 40
02:0003BCBC 00
02:0003BCBD FF
02:0003BCBE 00
02:0003BCBF 00
02:0003BCC0 40
02:0003BCC1 40
02:0003BCC2 FF              	  7278:     dc.b    $FF, $40
02:0003BCC3 40
                            	  7279: 
                            	  7280:     even
                            	  7281: DodongoFrameImagesBloated:
02:0003BCC4 04              	  7282:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003BCC5 05
02:0003BCC6 07
02:0003BCC7 FF
02:0003BCC8 09
02:0003BCC9 04
02:0003BCCA 05
02:0003BCCB 07
02:0003BCCC FF              	  7283:     dc.b    $FF, $09
02:0003BCCD 09
                            	  7284: 
                            	  7285:     even
                            	  7286: DodongoFrameHFlipsBloated:
02:0003BCCE 00              	  7287:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003BCCF 40
02:0003BCD0 00
02:0003BCD1 FF
02:0003BCD2 00
02:0003BCD3 00
02:0003BCD4 40
02:0003BCD5 00
02:0003BCD6 FF              	  7288:     dc.b    $FF, $00
02:0003BCD7 00
                            	  7289: 
