02:000428BE 103C008C        	  6078:     move.b  #$8C,D0
02:000428C2 1880            	  6079:     move.b  D0,($0000,A4)
02:000428C4 7065            	  6080:     moveq   #101,D0
02:000428C6 19400001        	  6081:     move.b  D0,($0001,A4)
                            	  6082:     ; For each column in room, indexed by [06]:
