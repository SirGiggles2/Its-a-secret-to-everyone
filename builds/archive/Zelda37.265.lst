                            	  2865: 
                            	  2866: ; Each byte describes an item. The high nibble is the type.
                            	  2867: ; The low nibble is the value. Its meaning depends on the type.
                            	  2868: ;
                            	  2869: ; 0x - individuals
                            	  2870: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  2871: ; * bit mask: value doesn't matter.
                            	  2872: ;
                            	  2873: ; 1x - amounts
                            	  2874: ; Value is an amount to add.
                            	  2875: ;
                            	  2876: ; 2x - grades
                            	  2877: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  2878: ;
                            	  2879: ; 3x - error?
                            	  2880: ; Produces an item value of $FF.
                            	  2881: ;
                            	  2882:     even
