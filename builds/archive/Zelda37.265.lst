                            	  1816: UpdateStatues:
                            	  1817:     ; If person fireballs are enabled (from the two fires), then
                            	  1818:     ; go make fireballs with pattern 2.
                            	  1819:     ;
02:000395F6 7602            	  1820:     moveq   #2,D3
02:000395F8 102C04CC        	  1821:     move.b  ($04CC,A4),D0
02:000395FC 6620            	  1822:     bne  _L_z04_UpdateStatues_Shoot
                            	  1823:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1824:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1825:     ; - layout $23: pattern 1: 2 statues
                            	  1826:     ; - layout $24: pattern 0: 4 statues
                            	  1827:     ;
02:000395FE 4EB900049B80    	  1828:     jsr     GetUniqueRoomId
02:00039604 7601            	  1829:     moveq   #1,D3
                            	  1830: _anon_z04_30:
02:00039606 41F9000395D8    	  1831:     lea     (StatueRoomLayouts).l,A0
02:0003960C 12303000        	  1832:     move.b  (A0,D3.W),D1
02:00039610 B001            	  1833:     cmp.b   D1,D0
02:00039612 670A            	  1834:     beq  _L_z04_UpdateStatues_Shoot
02:00039614 5303            	  1835:     subq.b  #1,D3
02:00039616 6AEE            	  1836:     bpl  _anon_z04_30
02:00039618 0A3C0001        	  1837:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003961C 4E75            	  1838:     rts
                            	  1839: 
                            	  1840:     even
                            	  1841: _L_z04_UpdateStatues_Shoot:
                            	  1842:     ; Look for an empty monster slot.
                            	  1843:     ; If none is found, return.
                            	  1844:     ;
                            	  1845:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1846:     ; object. This routine takes a shooter object, and instantiates
                            	  1847:     ; a fireball object at the shooter's location.
                            	  1848:     ;
                            	  1849:     ; The object slot we set up here will behave as the shooter.
                            	  1850:     ; For each fireball index, this object slot will have its coordinates
                            	  1851:     ; changed.
                            	  1852:     ;
                            	  1853:     ; Note that this means that:
                            	  1854:     ; 1. The first fireball made will be its own shooter.
                            	  1855:     ;    Practically, there's nothing special about this.
                            	  1856:     ; 2. If there is more than one fireball made in a frame,
                            	  1857:     ;    then two of them will come from the same statue.
                            	  1858:     ;
                            	  1859:     ;
                            	  1860:     ; Save the fireball pattern.
02:0003961E 1003            	  1861:     move.b  D3,D0
02:00039620 1B00            	  1862:     move.b  D0,-(A5)  ; PHA
02:00039622 4EB90004C30C    	  1863:     jsr     FindEmptyMonsterSlot
02:00039628 0C000001        	  1864:     cmpi.b  #$01,D0
02:0003962C 101D            	  1865:     move.b  (A5)+,D0  ; PLA
02:0003962E 6400010A        	  1866:     bcc  _L_z04_UpdateStatues_Exit
                            	  1867:     ; If we found a slot, but it < 6, return.
                            	  1868:     ;
02:00039632 0C030006        	  1869:     cmpi.b  #$06,D3
02:00039636 65000102        	  1870:     bcs  _L_z04_UpdateStatues_Exit
                            	  1871:     ; Store the object slot in [0A].
                            	  1872:     ; Store fireball pattern in [0B].
                            	  1873:     ;
02:0003963A 1943000A        	  1874:     move.b  D3,($000A,A4)
02:0003963E 1940000B        	  1875:     move.b  D0,($000B,A4)
                            	  1876:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1877:     ;
02:00039642 7600            	  1878:     moveq   #0,D3
02:00039644 1600            	  1879:     move.b  D0,D3
02:00039646 7400            	  1880:     moveq   #0,D2
02:00039648 41F9000395DA    	  1881:     lea     (StatueFireballCounts).l,A0
02:0003964E 14303000        	  1882:     move.b  (A0,D3.W),D2
                            	  1883:     even
                            	  1884: _L_z04_UpdateStatues_LoopFireball:
                            	  1885:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1886:     ;
                            	  1887:     ; Decrement the fireball timer at this index.
                            	  1888:     ;
02:00039652 7600            	  1889:     moveq   #0,D3
02:00039654 41EC04E8        	  1890:     lea     ($04E8,A4),A0
02:00039658 16302000        	  1891:     move.b  (A0,D2.W),D3
02:0003965C 5303            	  1892:     subq.b  #1,D3
02:0003965E 1003            	  1893:     move.b  D3,D0
02:00039660 41EC04E8        	  1894:     lea     ($04E8,A4),A0
02:00039664 11802000        	  1895:     move.b  D0,(A0,D2.W)
                            	  1896:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1897:     ; to make a fireball. Go loop again.
                            	  1898:     ;
02:00039668 5203            	  1899:     addq.b  #1,D3
02:0003966A 660000C8        	  1900:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1901:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1902:     ; This fireball index will wait another $100 frames.
                            	  1903:     ;
02:0003966E 10342018        	  1904:     move.b  ($18,A4,D2.W),D0
02:00039672 0C0000F0        	  1905:     cmpi.b  #$F0,D0
02:00039676 640000BC        	  1906:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1907:     ; Else choose one of four start times for the fireball based on
                            	  1908:     ; the random value.
                            	  1909:     ;
02:0003967A 02000003        	  1910:     andi.b #$03,D0
02:0003967E 7600            	  1911:     moveq   #0,D3
02:00039680 1600            	  1912:     move.b  D0,D3
02:00039682 41F9000395DE    	  1913:     lea     (StatueFireballStartTimes).l,A0
02:00039688 10303000        	  1914:     move.b  (A0,D3.W),D0
02:0003968C 41EC04E8        	  1915:     lea     ($04E8,A4),A0
02:00039690 11802000        	  1916:     move.b  D0,(A0,D2.W)
                            	  1917:     ; The coordinate lists are divided into sets for each pattern.
                            	  1918:     ;
                            	  1919:     ; Look up the index of the base of the set for the pattern in use.
                            	  1920:     ; Add it to the fireball index in X register to get the index of
                            	  1921:     ; the coordinate we want within each coordinate list.
                            	  1922:     ;
                            	  1923:     ;
                            	  1924:     ; Pattern
02:00039694 7600            	  1925:     moveq   #0,D3
02:00039696 162C000B        	  1926:     move.b  ($000B,A4),D3
02:0003969A 1002            	  1927:     move.b  D2,D0
02:0003969C 023C00EE        	  1928:     andi    #$EE,CCR  ; CLC: clear C+X
02:000396A0 41F9000395E2    	  1929:     lea     (StatuePatternToBasePositionIndex).l,A0
02:000396A6 12303000        	  1930:     move.b  (A0,D3.W),D1
02:000396AA D101            	  1931:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:000396AC 7600            	  1932:     moveq   #0,D3
02:000396AE 1600            	  1933:     move.b  D0,D3
02:000396B0 1002            	  1934:     move.b  D2,D0
02:000396B2 1B00            	  1935:     move.b  D0,-(A5)  ; PHA
                            	  1936:     ; Get Link's coordinates into [00] and [01].
                            	  1937:     ;
02:000396B4 7400            	  1938:     moveq   #0,D2
02:000396B6 4EB90004BB24    	  1939:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1940:     ; Switch to the new fireball's object slot.
                            	  1941:     ;
02:000396BC 7400            	  1942:     moveq   #0,D2
02:000396BE 142C000A        	  1943:     move.b  ($000A,A4),D2
                            	  1944:     ; Look up and set the X coordinate for the fireball object.
                            	  1945:     ; Also store it in [02].
                            	  1946:     ;
02:000396C2 41F9000395E6    	  1947:     lea     (StatueXs).l,A0
02:000396C8 10303000        	  1948:     move.b  (A0,D3.W),D0
02:000396CC 19400002        	  1949:     move.b  D0,($0002,A4)
02:000396D0 19802070        	  1950:     move.b  D0,($70,A4,D2.W)
                            	  1951:     ; Look up and set the Y coordinate for the fireball object.
                            	  1952:     ; Also store it in [03].
                            	  1953:     ;
02:000396D4 41F9000395EE    	  1954:     lea     (StatueYs).l,A0
02:000396DA 10303000        	  1955:     move.b  (A0,D3.W),D0
02:000396DE 19400003        	  1956:     move.b  D0,($0003,A4)
02:000396E2 41EC0084        	  1957:     lea     ($0084,A4),A0
02:000396E6 11802000        	  1958:     move.b  D0,(A0,D2.W)
                            	  1959:     ; Set mask value 3 in [04].
                            	  1960:     ;
02:000396EA 7003            	  1961:     moveq   #3,D0
02:000396EC 19400004        	  1962:     move.b  D0,($0004,A4)
                            	  1963:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  1964:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  1965:     ;
02:000396F0 7601            	  1966:     moveq   #1,D3
                            	  1967:     even
                            	  1968: _L_z04_UpdateStatues_LoopAxis:
02:000396F2 10343000        	  1969:     move.b  ($00,A4,D3.W),D0
02:000396F6 003C0011        	  1970:     ori     #$11,CCR  ; SEC: set C+X
02:000396FA 12343002        	  1971:     move.b  ($02,A4,D3.W),D1
02:000396FE 0A3C0010        	  1972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039702 9101            	  1973:     subx.b  D1,D0   ; SBC $0002,Y
02:00039704 0A3C0010        	  1974:     eori    #$10,CCR  ; restore X = 6502 C
02:00039708 0C000018        	  1975:     cmpi.b  #$18,D0
02:0003970C 6A10            	  1976:     bpl  _anon_z04_31
02:0003970E 0C0000E8        	  1977:     cmpi.b  #$E8,D0
02:00039712 6B0A            	  1978:     bmi  _anon_z04_31
02:00039714 122C0004        	  1979:     move.b  ($0004,A4),D1
02:00039718 E209            	  1980:     lsr.b  #1,D1   ; LSR $04
02:0003971A 19410004        	  1981:     move.b  D1,($0004,A4)
                            	  1982: _anon_z04_31:
02:0003971E 5303            	  1983:     subq.b  #1,D3
02:00039720 6AD0            	  1984:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  1985:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  1986:     ; 0 or 1 time, instead of 2.
                            	  1987:     ;
                            	  1988:     ; This, in turn, means that the distance between Link and the
                            	  1989:     ; fireball was >= $18 in at least one axis.
                            	  1990:     ;
                            	  1991:     ; So, we're OK to finish making the fireball.
                            	  1992:     ;
02:00039722 102C0004        	  1993:     move.b  ($0004,A4),D0
02:00039726 6706            	  1994:     beq  _anon_z04_32
02:00039728 7055            	  1995:     moveq   #85,D0
02:0003972A 6100F83E        	  1996:     jsr     ShootFireball
                            	  1997: _anon_z04_32:
02:0003972E 101D            	  1998:     move.b  (A5)+,D0  ; PLA
02:00039730 7400            	  1999:     moveq   #0,D2
02:00039732 1400            	  2000:     move.b  D0,D2
                            	  2001:     even
                            	  2002: _L_z04_UpdateStatues_NextLoopFireball:
                            	  2003:     ; Bottom of the loop.
                            	  2004:     ; Loop while fireball index >= 0.
                            	  2005:     ;
02:00039734 5302            	  2006:     subq.b  #1,D2
02:00039736 6A00FF1A        	  2007:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  2008:     even
                            	  2009: _L_z04_UpdateStatues_Exit:
02:0003973A 4E75            	  2010:     rts
                            	  2011: 
                            	  2012: ; Unknown block
02:0003973C FF              	  2013:     dc.b    $FF, $FF, $FF
02:0003973D FF
02:0003973E FF
