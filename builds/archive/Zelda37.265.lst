02:00040FEC 102C0001        	  4092:     move.b  ($0001,A4),D0
02:00040FF0 41F900040F48    	  4093:     lea     (DoorwayBoundsMinUnder).l,A0
02:00040FF6 12303000        	  4094:     move.b  (A0,D3.W),D1
02:00040FFA B001            	  4095:     cmp.b   D1,D0
02:00040FFC 650E            	  4096:     bcs  _anon_z05_96
