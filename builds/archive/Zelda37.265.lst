                            	  9694: _L_z04_UpdateGohma_AnimateEye:
                            	  9695:     ; Animate the eye.
                            	  9696:     ;
                            	  9697:     ; First, if the counter for when to open the eye next = 0, then
                            	  9698:     ; set it to a random value at least $C0; and set the timer for
                            	  9699:     ; keeping the eye open to $80.
                            	  9700:     ;
                            	  9701:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9702:     ; every other frame.
                            	  9703:     ;
02:0003CEFE 41EC042C        	  9704:     lea     ($042C,A4),A0
02:0003CF02 10302000        	  9705:     move.b  (A0,D2.W),D0
02:0003CF06 661E            	  9706:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003CF08 103C0080        	  9707:     move.b  #$80,D0
02:0003CF0C 41EC0444        	  9708:     lea     ($0444,A4),A0
02:0003CF10 11802000        	  9709:     move.b  D0,(A0,D2.W)
02:0003CF14 103C00C0        	  9710:     move.b  #$C0,D0
02:0003CF18 12342018        	  9711:     move.b  ($18,A4,D2.W),D1
02:0003CF1C 8001            	  9712:     or.b  D1,D0
02:0003CF1E 41EC042C        	  9713:     lea     ($042C,A4),A0
02:0003CF22 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
                            	  9716: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9717:     ; Decrement the next-open-eye counter.
                            	  9718:     ;
02:0003CF26 102C0015        	  9719:     move.b  ($0015,A4),D0
02:0003CF2A E208            	  9720:     lsr.b  #1,D0   ; LSR A
02:0003CF2C 6408            	  9721:     bcc  _anon_z04_122
02:0003CF2E 41EC042C        	  9722:     lea     ($042C,A4),A0
02:0003CF32 53302000        	  9723:     subq.b  #1,(A0,D2.W)
                            	  9724: _anon_z04_122:
                            	  9725:     ; If open eye timer = 0, then the eye is closed.
                            	  9726:     ; Go animate it differently.
                            	  9727:     ;
02:0003CF36 41EC0444        	  9728:     lea     ($0444,A4),A0
02:0003CF3A 10302000        	  9729:     move.b  (A0,D2.W),D0
02:0003CF3E 674A            	  9730:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9731:     ; Else decrement the open eye timer.
                            	  9732:     ;
02:0003CF40 41EC0444        	  9733:     lea     ($0444,A4),A0
02:0003CF44 53302000        	  9734:     subq.b  #1,(A0,D2.W)
                            	  9735:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9736:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9737:     ;
02:0003CF48 7602            	  9738:     moveq   #2,D3
02:0003CF4A 0C000070        	  9739:     cmpi.b  #$70,D0
02:0003CF4E 6408            	  9740:     bcc  _anon_z04_123
02:0003CF50 0C000010        	  9741:     cmpi.b  #$10,D0
02:0003CF54 6502            	  9742:     bcs  _anon_z04_123
02:0003CF56 5203            	  9743:     addq.b  #1,D3
                            	  9744: _anon_z04_123:
