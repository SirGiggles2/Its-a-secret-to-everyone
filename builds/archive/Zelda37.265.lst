                            	  5135: DrawCredits:
                            	  5136:     ; Make a transfer record of a full row of blank tiles.
                            	  5137:     ;
02:00035B14 761F            	  5138:     moveq   #31,D3
02:00035B16 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
02:00035B18 41EC0305        	  5141:     lea     ($0305,A4),A0
02:00035B1C 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:00035B20 5303            	  5143:     subq.b  #1,D3
02:00035B22 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
                            	  5146:     ;
02:00035B24 102C050A        	  5147:     move.b  ($050A,A4),D0
02:00035B28 672C            	  5148:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5149:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5150:     ; Rows 2 to $2D get side walls.
                            	  5151:     ;
02:00035B2A 0C000001        	  5152:     cmpi.b  #$01,D0
02:00035B2E 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00035B30 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:00035B34 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00035B36 661E            	  5156:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5157:     even
                            	  5158: _L_z02_DrawCredits_WriteHorizontalWalls:
02:00035B38 7619            	  5159:     moveq   #25,D3
02:00035B3A 103C00FA        	  5160:     move.b  #$FA,D0
                            	  5161: _anon_z02_42:
02:00035B3E 41EC0308        	  5162:     lea     ($0308,A4),A0
02:00035B42 11803000        	  5163:     move.b  D0,(A0,D3.W)
02:00035B46 5303            	  5164:     subq.b  #1,D3
02:00035B48 6AF4            	  5165:     bpl  _anon_z02_42
                            	  5166:     even
                            	  5167: _L_z02_DrawCredits_WriteSideWalls:
02:00035B4A 103C00FA        	  5168:     move.b  #$FA,D0
02:00035B4E 19400308        	  5169:     move.b  D0,($0308,A4)
02:00035B52 19400321        	  5170:     move.b  D0,($0321,A4)
                            	  5171:     even
                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:00035B56 103C00FF        	  5176:     move.b  #$FF,D0
02:00035B5A 19400325        	  5177:     move.b  D0,($0325,A4)
02:00035B5E 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:00035B62 7020            	  5181:     moveq   #32,D0
02:00035B64 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:00035B68 7400            	  5185:     moveq   #0,D2
02:00035B6A 142C050C        	  5186:     move.b  ($050C,A4),D2
02:00035B6E 41F900035914    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:00035B74 10302000        	  5188:     move.b  (A0,D2.W),D0
02:00035B78 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:00035B7C 102C050D        	  5192:     move.b  ($050D,A4),D0
02:00035B80 7600            	  5193:     moveq   #0,D3
02:00035B82 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:00035B84 E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00035B86 E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:00035B88 E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:00035B8A E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:00035B8C E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:00035B8E 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:00035B92 41F900035920    	  5205:     lea     (CreditsPagesTextMasks).l,A0
02:00035B98 10302000        	  5206:     move.b  (A0,D2.W),D0
                            	  5207: _anon_z02_43:
                            	  5208:     ; Shift left as many times as the current VRAM line number,
                            	  5209:     ; to get the bit that indicates whether this line has text.
                            	  5210:     ;
02:00035B9C E308            	  5211:     lsl.b  #1,D0   ; ASL A
02:00035B9E 5303            	  5212:     subq.b  #1,D3
02:00035BA0 6AFA            	  5213:     bpl  _anon_z02_43
02:00035BA2 6400013E        	  5214:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5215:     ; The mask inidcates that it should have text.
                            	  5216:     ; But if line index >= $17, then it doesn't.
                            	  5217:     ;
02:00035BA6 7600            	  5218:     moveq   #0,D3
02:00035BA8 162C050E        	  5219:     move.b  ($050E,A4),D3
02:00035BAC 0C030017        	  5220:     cmpi.b  #$17,D3
02:00035BB0 64000130        	  5221:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5222:     ; In the first quest, don't consider line numbers >= $10.
                            	  5223:     ;
02:00035BB4 7400            	  5224:     moveq   #0,D2
02:00035BB6 142C0016        	  5225:     move.b  ($0016,A4),D2
02:00035BBA 41EC062D        	  5226:     lea     ($062D,A4),A0
02:00035BBE 10302000        	  5227:     move.b  (A0,D2.W),D0
