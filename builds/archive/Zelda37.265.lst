                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:0004267C 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00042680 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00042684 1014            	  5783:     move.b  ($0000,A4),D0
02:00042686 41EC0302        	  5784:     lea     ($0302,A4),A0
02:0004268A 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:0004268E 5202            	  5786:     addq.b  #1,D2
02:00042690 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00042694 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00042698 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:0004269C 5202            	  5790:     addq.b  #1,D2
02:0004269E 102C0006        	  5791:     move.b  ($0006,A4),D0
02:000426A2 41EC0302        	  5792:     lea     ($0302,A4),A0
02:000426A6 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:000426AA 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:000426AC 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:000426B0 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:000426B2 7020            	  5803:     moveq   #32,D0
02:000426B4 122C0001        	  5804:     move.b  ($0001,A4),D1
02:000426B8 8001            	  5805:     or.b  D1,D0
02:000426BA 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:000426BE 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:000426C2 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
