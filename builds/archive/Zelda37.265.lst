                            	  9535: Manhandla_Draw:
02:0003CDBA 4EB90004BB24    	  9536:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9537:     ; Push the "frame image and sprite attributes" value.
                            	  9538:     ;
02:0003CDC0 41EC0478        	  9539:     lea     ($0478,A4),A0
02:0003CDC4 10302000        	  9540:     move.b  (A0,D2.W),D0
02:0003CDC8 1B00            	  9541:     move.b  D0,-(A5)  ; PHA
                            	  9542:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9543:     ; passed along as is.
                            	  9544:     ;
02:0003CDCA 02000080        	  9545:     andi.b #$80,D0
02:0003CDCE 00000001        	  9546:     ori.b #$01,D0
02:0003CDD2 4EB90003111C    	  9547:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003CDD8 101D            	  9548:     move.b  (A5)+,D0  ; PLA
02:0003CDDA 1B00            	  9549:     move.b  D0,-(A5)  ; PHA
                            	  9550:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9551:     ;
02:0003CDDC 02000040        	  9552:     andi.b #$40,D0
02:0003CDE0 6704            	  9553:     beq  _anon_z04_116
02:0003CDE2 522C000F        	  9554:     addq.b  #1,($000F,A4)
                            	  9555: _anon_z04_116:
02:0003CDE6 101D            	  9556:     move.b  (A5)+,D0  ; PLA
                            	  9557:     ; If the low nibble = 2 or 3, then go draw not mirrored.
