02:0004C0A8 41F90004BB98    	  7493:     lea     (ObjectTypeToAttributes).l,A0
02:0004C0AE 10303000        	  7494:     move.b  (A0,D3.W),D0
02:0004C0B2 41EC04BF        	  7495:     lea     ($04BF,A4),A0
02:0004C0B6 11802000        	  7496:     move.b  D0,(A0,D2.W)
02:0004C0BA 1003            	  7497:     move.b  D3,D0
02:0004C0BC 1880            	  7498:     move.b  D0,($0000,A4)
                            	  7499:     ; Hit points are packed two values to a byte.
                            	  7500:     ; Divide the object type in half in order to index
                            	  7501:     ; into the hit points table.
                            	  7502:     ;
02:0004C0BE E208            	  7503:     lsr.b  #1,D0   ; LSR A
02:0004C0C0 7600            	  7504:     moveq   #0,D3
02:0004C0C2 1600            	  7505:     move.b  D0,D3
02:0004C0C4 41F90004BBF8    	  7506:     lea     (ObjectTypeToHpPairs).l,A0
02:0004C0CA 10303000        	  7507:     move.b  (A0,D3.W),D0
02:0004C0CE 4EB90003E6EC    	  7508:     jsr     ExtractHitPointValue
02:0004C0D4 41EC0485        	  7509:     lea     ($0485,A4),A0
02:0004C0D8 11802000        	  7510:     move.b  D0,(A0,D2.W)
                            	  7511:     ; If the object is a cave, go initialize it.
