                            	  9774: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9775:     ; Here the eye is closed. So animate it this way.
                            	  9776:     ; Increment the animation counter, and if <> 8, then
                            	  9777:     ; go shoot, draw, and check collisions.
                            	  9778:     ;
02:0003CF8A 41EC0478        	  9779:     lea     ($0478,A4),A0
