02:0004407E 1B00            	  8706:     move.b  D0,-(A5)  ; PHA
                            	  8707:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8708:     ; in order to look up its information.
                            	  8709:     ;
02:00044080 102C005D        	  8710:     move.b  ($005D,A4),D0
