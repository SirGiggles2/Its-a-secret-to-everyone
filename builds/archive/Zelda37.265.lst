02:0003A7B0 123C0008        	  4428:     move.b  #$08,D1
02:0003A7B4 D101            	  4429:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A7B6 19400004        	  4430:     move.b  D0,($0004,A4)
02:0003A7BA 41EC0084        	  4431:     lea     ($0084,A4),A0
02:0003A7BE 10303000        	  4432:     move.b  (A0,D3.W),D0
02:0003A7C2 023C00EE        	  4433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A7C6 123C0008        	  4434:     move.b  #$08,D1
02:0003A7CA D101            	  4435:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A7CC 19400005        	  4436:     move.b  D0,($0005,A4)
