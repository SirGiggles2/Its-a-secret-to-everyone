                            	  3843: ModifyObjCountByHistoryOW:
                            	  3844:     ;Look for the room in the history.
                            	  3845:     ;
02:00040E44 7605            	  3846:     moveq   #5,D3
02:00040E46 102C00EB        	  3847:     move.b  ($00EB,A4),D0
                            	  3848: _anon_z05_90:
02:00040E4A 41EC0621        	  3849:     lea     ($0621,A4),A0
02:00040E4E 12303000        	  3850:     move.b  (A0,D3.W),D1
02:00040E52 B001            	  3851:     cmp.b   D1,D0
02:00040E54 6752            	  3852:     beq  _anon_z05_91
02:00040E56 5303            	  3853:     subq.b  #1,D3
02:00040E58 6AF0            	  3854:     bpl  _anon_z05_90
                            	  3855:     ; It wasn't found. Check the kill count in the room flags.
                            	  3856:     ;
02:00040E5A 4EB9000498E2    	  3857:     jsr     GetRoomFlags
02:00040E60 02000007        	  3858:     andi.b #$07,D0
02:00040E64 0C000007        	  3859:     cmpi.b  #$07,D0
02:00040E68 663E            	  3860:     bne  _anon_z05_91
                            	  3861:     ; The room is not in history, and all foes were defeated.
                            	  3862:     ; So, reset the kill count in room flags.
                            	  3863:     ;
02:00040E6A 1214            	  3864:     move.b  ($00,A4),D1   ; ptr lo
02:00040E6C 182C0001        	  3865:     move.b  ($01,A4),D4  ; ptr hi
02:00040E70 024100FF        	  3866:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040E74 E14C            	  3867:     lsl.w   #8,D4
02:00040E76 8841            	  3868:     or.w    D1,D4             ; D4 = NES ptr addr
02:00040E78 48C4            	  3869:     ext.l   D4
02:00040E7A D8BC00FF0000    	  3870:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040E80 2044            	  3871:     movea.l D4,A0
02:00040E82 10303000        	  3872:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040E86 020000F8        	  3873:     andi.b #$F8,D0
02:00040E8A 1214            	  3874:     move.b  ($00,A4),D1   ; ptr lo
02:00040E8C 182C0001        	  3875:     move.b  ($01,A4),D4  ; ptr hi
02:00040E90 024100FF        	  3876:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040E94 E14C            	  3877:     lsl.w   #8,D4
02:00040E96 8841            	  3878:     or.w    D1,D4
02:00040E98 48C4            	  3879:     ext.l   D4
02:00040E9A D8BC00FF0000    	  3880:     add.l   #NES_RAM,D4
02:00040EA0 2044            	  3881:     movea.l D4,A0
02:00040EA2 11803000        	  3882:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  3883:     even
                            	  3884: _L_z05_ModifyObjCountByHistoryOW_Exit:
02:00040EA6 4E75            	  3885:     rts
                            	  3886: 
                            	  3887: _anon_z05_91:
                            	  3888:     ; If kill count in room flags = 0, leave object count alone, and return.
                            	  3889:     ;
