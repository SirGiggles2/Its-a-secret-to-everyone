02:000431E8 19400001        	  7035:     move.b  D0,($0001,A4)
02:000431EC 1003            	  7036:     move.b  D3,D0
02:000431EE 003C0011        	  7037:     ori     #$11,CCR  ; SEC: set C+X
02:000431F2 123C0040        	  7038:     move.b  #$40,D1
02:000431F6 0A3C0010        	  7039:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000431FA 9101            	  7040:     subx.b  D1,D0   ; SBC #$40
02:000431FC 0A3C0010        	  7041:     eori    #$10,CCR  ; restore X = 6502 C
02:00043200 E208            	  7042:     lsr.b  #1,D0   ; LSR A
02:00043202 E208            	  7043:     lsr.b  #1,D0   ; LSR A
02:00043204 E208            	  7044:     lsr.b  #1,D0   ; LSR A
02:00043206 7600            	  7045:     moveq   #0,D3
02:00043208 1600            	  7046:     move.b  D0,D3
02:0004320A 1214            	  7047:     move.b  ($00,A4),D1   ; ptr lo
02:0004320C 182C0001        	  7048:     move.b  ($01,A4),D4  ; ptr hi
