                            	  5022:     ;
02:0004AE2A 7000            	  5023:     moveq   #0,D0
02:0004AE2C 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:0004AE30 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:0004AE32 1003            	  5031:     move.b  D3,D0
02:0004AE34 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:0004AE36 102C0002        	  5035:     move.b  ($0002,A4),D0
02:0004AE3A 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:0004AE3C 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004AE40 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004AE42 102C0015        	  5046:     move.b  ($0015,A4),D0
02:0004AE46 02000003        	  5047:     andi.b #$03,D0
02:0004AE4A 41F90004ACA8    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004AE50 12303000        	  5049:     move.b  (A0,D3.W),D1
02:0004AE54 8001            	  5050:     or.b  D1,D0
02:0004AE56 4EB90003111C    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:0004AE5C 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004AE60 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AE64 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004AE68 D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004AE6A 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:0004AE6C 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004AE70 B001            	  5064:     cmp.b   D1,D0
02:0004AE72 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004AE74 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004AE78 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004AE7A 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004AE7E 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004AE82 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004AE86 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004AE88 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:0004AE8C 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:0004AE8E 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:0004AE92 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:0004AE96 1214            	  5079:     move.b  ($0000,A4),D1
02:0004AE98 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004AE9C 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004AE9E 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:0004AEA2 0C000020        	  5087:     cmpi.b  #$20,D0
02:0004AEA6 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004AEA8 41EC0084        	  5092:     lea     ($0084,A4),A0
02:0004AEAC 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004AEB0 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AEB4 122C0003        	  5095:     move.b  ($0003,A4),D1
02:0004AEB8 D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:0004AEBA 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:0004AEBE 7600            	  5100:     moveq   #0,D3
02:0004AEC0 162C0010        	  5101:     move.b  ($0010,A4),D3
