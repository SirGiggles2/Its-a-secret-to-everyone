02:00040FA0 610000DC        	  4052:     jsr     GetPlayerCoordsForDirection
02:00040FA4 101D            	  4053:     move.b  (A5)+,D0  ; PLA
02:00040FA6 4EB900030920    	  4054:     jsr     GetOppositeDir
02:00040FAC 102C0001        	  4055:     move.b  ($0001,A4),D0
                            	  4056:     ; If the player is within the bounds of the doorway for DoorwayDir
                            	  4057:     ; (for example the left door way, if DoorwayDir = left;
                            	  4058:     ; instead of right doorway while DoorwayDir = left),
                            	  4059:     ; and player is facing in DoorwayDir, then go repeat the
                            	  4060:     ; original search used to enter the doorway.
