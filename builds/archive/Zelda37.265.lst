02:0003B9AA 11802000        	  6808:     move.b  D0,(A0,D2.W)
02:0003B9AE 6100D104        	  6809:     jsr     Wanderer_TargetPlayer
                            	  6810:     ; Pop the offset and add it to the X coordinate.
