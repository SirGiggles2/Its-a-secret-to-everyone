02:00040B10 6076            	  3359:     jmp  L14F72_Exit
                            	  3360: __far_z_05_0060:
                            	  3361:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3362:     ;
02:00040B12 102C0084        	  3363:     move.b  ($0084,A4),D0
02:00040B16 0C00009D        	  3364:     cmpi.b  #$9D,D0
02:00040B1A 6702            	  3365:     beq.s  __far_z_05_0061
02:00040B1C 606C            	  3366:     jmp  CheckCaveEdge
                            	  3367: __far_z_05_0061:
                            	  3368:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3369:     ; X = $50: 1
                            	  3370:     ; X = $80: 2
                            	  3371:     ; X = $B0: 3
                            	  3372:     ;
                            	  3373:     ; If he's not on any, then return.
                            	  3374:     ;
02:00040B1E 7601            	  3375:     moveq   #1,D3
02:00040B20 102C0070        	  3376:     move.b  ($0070,A4),D0
02:00040B24 0C000050        	  3377:     cmpi.b  #$50,D0
02:00040B28 6712            	  3378:     beq  _anon_z05_83
02:00040B2A 5203            	  3379:     addq.b  #1,D3
02:00040B2C 0C000080        	  3380:     cmpi.b  #$80,D0
02:00040B30 670A            	  3381:     beq  _anon_z05_83
02:00040B32 5203            	  3382:     addq.b  #1,D3
02:00040B34 0C0000B0        	  3383:     cmpi.b  #$B0,D0
02:00040B38 6702            	  3384:     beq.s  __far_z_05_0062
02:00040B3A 604C            	  3385:     jmp  L14F72_Exit
                            	  3386: __far_z_05_0062:
                            	  3387: _anon_z05_83:
                            	  3388:     ; Look for the current room in the cellar/shortcut room array.
                            	  3389:     ;
02:00040B3C 1883            	  3390:     move.b  D3,($0000,A4)
02:00040B3E 163C00FF        	  3391:     move.b  #$FF,D3
02:00040B42 102C00EB        	  3392:     move.b  ($00EB,A4),D0
                            	  3393: _anon_z05_84:
02:00040B46 5203            	  3394:     addq.b  #1,D3
02:00040B48 41F900FF6BB2    	  3395:     lea     (NES_SRAM+$0BB2).l,A0
02:00040B4E 12303000        	  3396:     move.b  (A0,D3.W),D1
02:00040B52 B001            	  3397:     cmp.b   D1,D0
02:00040B54 66F0            	  3398:     bne  _anon_z05_84
                            	  3399:     ; Add the value of the shortcut chosen to whatever index
                            	  3400:     ; the current room has in the array.
                            	  3401:     ;
                            	  3402:     ; This yields the index of one of the three shortcut rooms
                            	  3403:     ; after the current one.
                            	  3404:     ;
02:00040B56 1003            	  3405:     move.b  D3,D0
02:00040B58 023C00EE        	  3406:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040B5C 1214            	  3407:     move.b  ($0000,A4),D1
02:00040B5E D101            	  3408:     addx.b  D1,D0   ; ADC $00
                            	  3409:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3410:     ;
02:00040B60 02000003        	  3411:     andi.b #$03,D0
02:00040B64 7600            	  3412:     moveq   #0,D3
02:00040B66 1600            	  3413:     move.b  D0,D3
02:00040B68 41F900FF6BB2    	  3414:     lea     (NES_SRAM+$0BB2).l,A0
02:00040B6E 10303000        	  3415:     move.b  (A0,D3.W),D0
                            	  3416: ; Params:
                            	  3417: ; A: destination room ID
                            	  3418: ;
                            	  3419:     even
                            	  3420: GoToModeAFromCellar:
02:00040B72 194000EB        	  3421:     move.b  D0,($00EB,A4)
02:00040B76 4EB9000498BE    	  3422:     jsr     MarkRoomVisited
                            	  3423:     even
                            	  3424: GoToModeAFromCave:
02:00040B7C 700A            	  3425:     moveq   #10,D0
02:00040B7E 19400012        	  3426:     move.b  D0,($0012,A4)
                            	  3427:     even
                            	  3428: EndPrepareMode:
02:00040B82 4EF90002C45A    	  3429:     jmp     c_end_prepare_mode
                            	  3430: 
