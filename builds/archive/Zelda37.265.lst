                            	   971: ;==============================================================================
                            	   972: ; EXPORT side — z_05 entry points (Stage 4b).
                            	   973: ;==============================================================================
                            	   974: 
                            	   975: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   976: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   977: c_split_room_id:
02:0002B6EC 4EB900000000    	   978:     jsr     z05_split_room_id
02:0002B6F2 7600            	   979:     moveq   #0,D3
02:0002B6F4 1600            	   980:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   981:     lsr.w   #8,D0
02:0002B6F8 7400            	   982:     moveq   #0,D2
02:0002B6FA 1400            	   983:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   984:     rts
                            	   985: 
                            	   986: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	   987: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	   988: c_is_dark_room:
02:0002B6FE 7000            	   989:     moveq   #0,D0
02:0002B700 3003            	   990:     move.w  D3,D0
02:0002B702 2F00            	   991:     move.l  D0,-(SP)
02:0002B704 4EB900000000    	   992:     jsr     z05_is_dark_room
02:0002B70A 588F            	   993:     addq.l  #4,SP
02:0002B70C 4A00            	   994:     tst.b   D0
02:0002B70E 4E75            	   995:     rts
                            	   996: 
                            	   997: ; SetDoorFlag — D2=dir_idx. Calls get_room_flags internally, writes flag.
