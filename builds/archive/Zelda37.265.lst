                            	  4751: DrawLinkZeldaTriforces:
                            	  4752:     ; The triforce over Link goes in the room object slot $13.
                            	  4753:     ; Set its location $10 pixels above Link.
                            	  4754:     ;
02:0003564C 102C0070        	  4755:     move.b  ($0070,A4),D0
02:00035650 19400083        	  4756:     move.b  D0,($0083,A4)
02:00035654 102C0084        	  4757:     move.b  ($0084,A4),D0
02:00035658 003C0011        	  4758:     ori     #$11,CCR  ; SEC: set C+X
02:0003565C 123C0010        	  4759:     move.b  #$10,D1
02:00035660 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035664 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:00035666 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
02:0003566A 19400097        	  4763:     move.b  D0,($0097,A4)
                            	  4764:     ; Draw Link.
                            	  4765:     ;
02:0003566E 7400            	  4766:     moveq   #0,D2
02:00035670 4EB90004BB24    	  4767:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00035676 6100BAA4        	  4768:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003567A 1940000C        	  4769:     move.b  D0,($000C,A4)
02:0003567E 7048            	  4770:     moveq   #72,D0
02:00035680 19400343        	  4771:     move.b  D0,($0343,A4)
02:00035684 704C            	  4772:     moveq   #76,D0
02:00035686 19400344        	  4773:     move.b  D0,($0344,A4)
02:0003568A 7621            	  4774:     moveq   #33,D3
02:0003568C 6100B9E0        	  4775:     jsr     Anim_WriteSpecificItemSprites
                            	  4776:     ; Draw triforce over Link.
                            	  4777:     ;
02:00035690 701B            	  4778:     moveq   #27,D0
02:00035692 7413            	  4779:     moveq   #19,D2
02:00035694 4EB90004993A    	  4780:     jsr     AnimateItemObject
02:0003569A 7401            	  4781:     moveq   #1,D2
02:0003569C 4EB90004BB24    	  4782:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4783:     ; Draw Zelda.
                            	  4784:     ;
