02:0003DC46 4EB900031126    	 11448:     jsr     Anim_WriteSprite
02:0003DC4C 101D            	 11449:     move.b  (A5)+,D0  ; PLA
02:0003DC4E 19802070        	 11450:     move.b  D0,($70,A4,D2.W)
02:0003DC52 41EC0098        	 11451:     lea     ($0098,A4),A0
02:0003DC56 10302000        	 11452:     move.b  (A0,D2.W),D0
02:0003DC5A 1B00            	 11453:     move.b  D0,-(A5)  ; PHA
02:0003DC5C 4EB9000311A6    	 11454:     jsr     CheckMonsterCollisions
02:0003DC62 101D            	 11455:     move.b  (A5)+,D0  ; PLA
02:0003DC64 41EC0098        	 11456:     lea     ($0098,A4),A0
02:0003DC68 11802000        	 11457:     move.b  D0,(A0,D2.W)
                            	 11458:     ; If still alive, then return.
                            	 11459:     ;
02:0003DC6C 41EC0405        	 11460:     lea     ($0405,A4),A0
02:0003DC70 10302000        	 11461:     move.b  (A0,D2.W),D0
