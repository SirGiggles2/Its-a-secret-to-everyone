02:0004ADF2 41EC0098        	  4990:     lea     ($0098,A4),A0
02:0004ADF6 10303000        	  4991:     move.b  (A0,D3.W),D0
02:0004ADFA 41EC0098        	  4992:     lea     ($0098,A4),A0
