                            	 12055:     ;
02:0003E082 102C0085        	 12056:     move.b  ($0085,A4),D0
02:0003E086 003C0011        	 12057:     ori     #$11,CCR  ; SEC: set C+X
02:0003E08A 1214            	 12058:     move.b  ($0000,A4),D1
02:0003E08C 0A3C0010        	 12059:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E090 9101            	 12060:     subx.b  D1,D0   ; SBC $00
02:0003E092 0A3C0010        	 12061:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E096 41EC0084        	 12062:     lea     ($0084,A4),A0
02:0003E09A 11802000        	 12063:     move.b  D0,(A0,D2.W)
