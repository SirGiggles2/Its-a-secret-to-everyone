02:000301FE 0C000068        	  1461:     cmpi.b  #$68,D0
02:00030202 6712            	  1462:     beq  _L_z01_CheckTileObjectsBlocking_Found
02:00030204 0C000062        	  1463:     cmpi.b  #$62,D0
02:00030208 670C            	  1464:     beq  _L_z01_CheckTileObjectsBlocking_Found
