02:0003A360 7004            	  3785:     moveq   #4,D0
02:0003A362 41EC03F8        	  3786:     lea     ($03F8,A4),A0
02:0003A366 11802000        	  3787:     move.b  D0,(A0,D2.W)
02:0003A36A 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003A36E 11802000        	  3789:     move.b  D0,(A0,D2.W)
                            	  3790:     ; Every other frame, return without drawing.
