                            	  2015:     even
                            	  2016: CheckZora:
                            	  2017:     ; If the zora attribute of this room is off, return.
                            	  2018:     ;
02:00039740 7600            	  2019:     moveq   #0,D3
02:00039742 162C00EB        	  2020:     move.b  ($00EB,A4),D3
02:00039746 41F900FF687E    	  2021:     lea     (NES_SRAM+$087E).l,A0
02:0003974C 10303000        	  2022:     move.b  (A0,D3.W),D0
02:00039750 02000008        	  2023:     andi.b #$08,D0
02:00039754 677C            	  2024:     beq  _L_z04_CheckZora_Exit
                            	  2025:     ; If zora is active, return.
                            	  2026:     ;
02:00039756 102C0514        	  2027:     move.b  ($0514,A4),D0
02:0003975A 6676            	  2028:     bne  _L_z04_CheckZora_Exit
                            	  2029:     ; Look for an empty monster slot. If none is found, return.
                            	  2030:     ;
02:0003975C 4EB90004C30C    	  2031:     jsr     FindEmptyMonsterSlot
02:00039762 676E            	  2032:     beq  _L_z04_CheckZora_Exit
                            	  2033:     ; Loop $D times looking for a water tile to put a zora on.
                            	  2034:     ; Indexed by [0D].
                            	  2035:     ;
02:00039764 700D            	  2036:     moveq   #13,D0
02:00039766 1940000D        	  2037:     move.b  D0,($000D,A4)
                            	  2038:     ; Switch to the new object slot.
                            	  2039:     ;
02:0003976A 7400            	  2040:     moveq   #0,D2
02:0003976C 142C0059        	  2041:     move.b  ($0059,A4),D2
                            	  2042:     even
                            	  2043: _L_z04_CheckZora_LoopTileCandidate:
                            	  2044:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2045:     ; If it = 0 or $F0, go loop again.
                            	  2046:     ;
02:00039770 7600            	  2047:     moveq   #0,D3
02:00039772 162C000D        	  2048:     move.b  ($000D,A4),D3
02:00039776 10343018        	  2049:     move.b  ($18,A4,D3.W),D0
02:0003977A 020000F0        	  2050:     andi.b #$F0,D0
02:0003977E 19802070        	  2051:     move.b  D0,($70,A4,D2.W)
02:00039782 6748            	  2052:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00039784 0C0000F0        	  2053:     cmpi.b  #$F0,D0
02:00039788 6742            	  2054:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2055:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2056:     ; If it < $50 or >= $E0, go loop again.
                            	  2057:     ;
02:0003978A 10343018        	  2058:     move.b  ($18,A4,D3.W),D0
02:0003978E E308            	  2059:     lsl.b  #1,D0   ; ASL A
02:00039790 E308            	  2060:     lsl.b  #1,D0   ; ASL A
02:00039792 E308            	  2061:     lsl.b  #1,D0   ; ASL A
02:00039794 E308            	  2062:     lsl.b  #1,D0   ; ASL A
02:00039796 0C000050        	  2063:     cmpi.b  #$50,D0
02:0003979A 6530            	  2064:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003979C 0C0000E0        	  2065:     cmpi.b  #$E0,D0
02:000397A0 642A            	  2066:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2067:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2068:     ;
