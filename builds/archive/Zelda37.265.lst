02:00040F4D DE
02:00040F4E 1F
02:00040F4F F1
                            	  3980: 
                            	  3981: ; Params:
                            	  3982: ; [0F]: moving direction
                            	  3983: ;
                            	  3984: ; Returns:
                            	  3985: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3986: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3987: ;
                            	  3988: ; When not at or in a doorway, this function leaves
                            	  3989: ; [0F] moving direction as is.
                            	  3990: ;
                            	  3991: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3992: ; will be left as is, assuming that it had been reset before this
                            	  3993: ; routine by BoundByRoom.
                            	  3994: ;
                            	  3995: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3996: ;
                            	  3997: ;
                            	  3998: ; If already in a doorway, go handle it separately.
                            	  3999: ;
                            	  4000:     even
                            	  4001: CheckDoorway:
02:00040F50 102C0053        	  4002:     move.b  ($0053,A4),D0
02:00040F54 6648            	  4003:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4004:     even
                            	  4005: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4006:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4007:     ;
                            	  4008:     ; To match a doorway:
                            	  4009:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4010:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4011:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4012:     ;
                            	  4013:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4014:     ; a doorway to be part of it.
                            	  4015:     ;
02:00040F56 102C0098        	  4016:     move.b  ($0098,A4),D0
02:00040F5A 61000122        	  4017:     jsr     GetPlayerCoordsForDirection
02:00040F5E 7603            	  4018:     moveq   #3,D3
                            	  4019:     even
                            	  4020: _L_z05_CheckDoorway_LoopOverflowBounds:
02:00040F60 1014            	  4021:     move.b  ($0000,A4),D0
02:00040F62 41F900040F3C    	  4022:     lea     (DoorwayRequiredCoord).l,A0
02:00040F68 12303000        	  4023:     move.b  (A0,D3.W),D1
02:00040F6C B001            	  4024:     cmp.b   D1,D0
02:00040F6E 6622            	  4025:     bne  _anon_z05_95
02:00040F70 102C0001        	  4026:     move.b  ($0001,A4),D0
02:00040F74 41F900040F40    	  4027:     lea     (DoorwayBoundsMinOver).l,A0
02:00040F7A 12303000        	  4028:     move.b  (A0,D3.W),D1
02:00040F7E B001            	  4029:     cmp.b   D1,D0
02:00040F80 6510            	  4030:     bcs  _anon_z05_95
02:00040F82 41F900040F44    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:00040F88 12303000        	  4032:     move.b  (A0,D3.W),D1
02:00040F8C B001            	  4033:     cmp.b   D1,D0
02:00040F8E 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4035: _anon_z05_95:
02:00040F92 5303            	  4036:     subq.b  #1,D3
