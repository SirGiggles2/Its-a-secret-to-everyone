                            	  4106: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  4107:     ;
                            	  4108:     ;
                            	  4109:     ; [0E] holds reverse index of doorway direction found.
                            	  4110:     ;
02:00041012 1943000E        	  4111:     move.b  D3,($000E,A4)
                            	  4112:     ; Store input direction in [02] and [0C].
                            	  4113:     ;
02:00041016 102C03F8        	  4114:     move.b  ($03F8,A4),D0
02:0004101A 0200000F        	  4115:     andi.b #$0F,D0
02:0004101E 19400002        	  4116:     move.b  D0,($0002,A4)
02:00041022 1940000C        	  4117:     move.b  D0,($000C,A4)
