                            	  1201: UpdateWhirlwind_Full:
                            	  1202:     ; Get Link's halted state.
                            	  1203:     ;
02:00030068 102C00AC        	  1204:     move.b  ($00AC,A4),D0
02:0003006C 02000040        	  1205:     andi.b #$40,D0
02:00030070 7600            	  1206:     moveq   #0,D3
02:00030072 1600            	  1207:     move.b  D0,D3
                            	  1208:     ; Add 2 to whirlwind X.
                            	  1209:     ;
02:00030074 7002            	  1210:     moveq   #2,D0
02:00030076 023C00EE        	  1211:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003007A 12342070        	  1212:     move.b  ($70,A4,D2.W),D1
02:0003007E D101            	  1213:     addx.b  D1,D0   ; ADC ObjX,X
02:00030080 19802070        	  1214:     move.b  D0,($70,A4,D2.W)
                            	  1215:     ; If Link is not halted or teleporting state = 0, then
                            	  1216:     ; go check for collision with Link.
                            	  1217:     ;
02:00030084 0C030040        	  1218:     cmpi.b  #$40,D3
02:00030088 6638            	  1219:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0003008A 7600            	  1220:     moveq   #0,D3
02:0003008C 162C0522        	  1221:     move.b  ($0522,A4),D3
02:00030090 6730            	  1222:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1223:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1224:     ;
                            	  1225:     ; Set Link's X to whirlwind's.
                            	  1226:     ;
02:00030092 19400070        	  1227:     move.b  D0,($0070,A4)
                            	  1228:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1229:     ; the right screen edge and draw.
                            	  1230:     ;
02:00030096 5303            	  1231:     subq.b  #1,D3
02:00030098 6776            	  1232:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0003009A 0C000080        	  1233:     cmpi.b  #$80,D0
02:0003009E 6670            	  1234:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1235:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1236:     ;
                            	  1237:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1238:     ;
02:000300A0 E308            	  1239:     lsl.b  #1,D0   ; ASL A
02:000300A2 194000AC        	  1240:     move.b  D0,($00AC,A4)
02:000300A6 19400522        	  1241:     move.b  D0,($0522,A4)
02:000300AA 41EC034F        	  1242:     lea     ($034F,A4),A0
02:000300AE 11802000        	  1243:     move.b  D0,(A0,D2.W)
                            	  1244:     ; Update the player position marker, and draw one last time.
                            	  1245:     ;
02:000300B2 1002            	  1246:     move.b  D2,D0
02:000300B4 1B00            	  1247:     move.b  D0,-(A5)  ; PHA
02:000300B6 61000910        	  1248:     jsr     UpdatePlayerPositionMarker
02:000300BA 101D            	  1249:     move.b  (A5)+,D0  ; PLA
02:000300BC 7400            	  1250:     moveq   #0,D2
02:000300BE 1400            	  1251:     move.b  D0,D2
02:000300C0 6070            	  1252:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1253: 
                            	  1254:     even
                            	  1255: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1256:     ; Link is not halted or teleporting state = 0.
                            	  1257:     ; Try to pick up Link.
                            	  1258:     ;
                            	  1259:     ; If the whirlwind does not collide with Link, then go check
                            	  1260:     ; for the screen's right edge.
                            	  1261:     ;
02:000300C2 610011E4        	  1262:     jsr     CheckLinkCollision
02:000300C6 102C0006        	  1263:     move.b  ($0006,A4),D0
02:000300CA 6744            	  1264:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1265:     ; Collided with Link.
                            	  1266:     ;
                            	  1267:     ; Make Link face right. Reset shove info and subroom type.
                            	  1268:     ;
02:000300CC 7001            	  1269:     moveq   #1,D0
02:000300CE 19400098        	  1270:     move.b  D0,($0098,A4)
02:000300D2 E208            	  1271:     lsr.b  #1,D0   ; LSR A
02:000300D4 194000C0        	  1272:     move.b  D0,($00C0,A4)
02:000300D8 194000D3        	  1273:     move.b  D0,($00D3,A4)
02:000300DC 1940005A        	  1274:     move.b  D0,($005A,A4)
                            	  1275:     ; Halt Link (state $40), and hide him.
                            	  1276:     ;
02:000300E0 7040            	  1277:     moveq   #64,D0
02:000300E2 194000AC        	  1278:     move.b  D0,($00AC,A4)
02:000300E6 103C00F8        	  1279:     move.b  #$F8,D0
02:000300EA 19400248        	  1280:     move.b  D0,($0248,A4)
02:000300EE 1940024C        	  1281:     move.b  D0,($024C,A4)
                            	  1282:     ; Find and set the room that will behave as the previous room
                            	  1283:     ; when scrolling right to the room with the level's entrance.
                            	  1284:     ;
02:000300F2 102C0523        	  1285:     move.b  ($0523,A4),D0
02:000300F6 02000007        	  1286:     andi.b #$07,D0
02:000300FA 7600            	  1287:     moveq   #0,D3
02:000300FC 1600            	  1288:     move.b  D0,D3
02:000300FE 41F900030060    	  1289:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030104 10303000        	  1290:     move.b  (A0,D3.W),D0
02:00030108 194000EA        	  1291:     move.b  D0,($00EA,A4)
                            	  1292:     ; Set teleporting state 1.
                            	  1293:     ;
02:0003010C 522C0522        	  1294:     addq.b  #1,($0522,A4)
                            	  1295:     even
                            	  1296: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1297:     ; If whirlwind's X < $F0, go draw.
                            	  1298:     ;
02:00030110 10342070        	  1299:     move.b  ($70,A4,D2.W),D0
02:00030114 0C0000F0        	  1300:     cmpi.b  #$F0,D0
02:00030118 6518            	  1301:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1302:     ; The whirlwind has reached the right edge of the screen.
                            	  1303:     ;
                            	  1304:     ; Destroy the object.
                            	  1305:     ;
02:0003011A 611A            	  1306:     jsr     DestroyWhirlwind
                            	  1307:     ; If teleporting state <> 0, we picked up Link.
                            	  1308:     ; So, go to the next mode.
                            	  1309:     ;
                            	  1310:     ; Either way, draw one last time.
                            	  1311:     ;
02:0003011C 102C0522        	  1312:     move.b  ($0522,A4),D0
02:00030120 6710            	  1313:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:00030122 1002            	  1314:     move.b  D2,D0
02:00030124 1B00            	  1315:     move.b  D0,-(A5)  ; PHA
02:00030126 4EB90004A99E    	  1316:     jsr     GoToNextModeFromPlay
02:0003012C 101D            	  1317:     move.b  (A5)+,D0  ; PLA
02:0003012E 7400            	  1318:     moveq   #0,D2
02:00030130 1400            	  1319:     move.b  D0,D2
                            	  1320:     even
                            	  1321: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030132 60000094        	  1322:     jmp     DrawWhirlwind
