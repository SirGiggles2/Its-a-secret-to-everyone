02:00040A7C 102C03F8        	  3281:     move.b  ($03F8,A4),D0
02:00040A80 02000008        	  3282:     andi.b #$08,D0
02:00040A84 6602            	  3283:     bne.s  __far_z_05_0058
02:00040A86 60BC            	  3284:     jmp  L14EC6_Exit
                            	  3285: __far_z_05_0058:
                            	  3286:     ; Look for this room's ID in the 6-element cellar room array.
                            	  3287:     ;
02:00040A88 7606            	  3288:     moveq   #6,D3
02:00040A8A 102C00EB        	  3289:     move.b  ($00EB,A4),D0
02:00040A8E 1B00            	  3290:     move.b  D0,-(A5)  ; PHA
                            	  3291: _anon_z05_81:
02:00040A90 5303            	  3292:     subq.b  #1,D3
02:00040A92 41F900FF6BB2    	  3293:     lea     (NES_SRAM+$0BB2).l,A0
02:00040A98 12303000        	  3294:     move.b  (A0,D3.W),D1
02:00040A9C B001            	  3295:     cmp.b   D1,D0
02:00040A9E 66F0            	  3296:     bne  _anon_z05_81
                            	  3297:     ; Determine the destination room ID, and go there.
