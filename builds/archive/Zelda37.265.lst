                            	  5827: CalcBoomerangFrame:
                            	  5828:     ; The minor state (low 3 bits of state) is used to
                            	  5829:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5830:     ;
                            	  5831:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5832:     ; In other words, don't offset the coordinate below.
                            	  5833:     ;
02:0004B3B6 7000            	  5834:     moveq   #0,D0
02:0004B3B8 1880            	  5835:     move.b  D0,($0000,A4)
02:0004B3BA 41EC00AC        	  5836:     lea     ($00AC,A4),A0
02:0004B3BE 10302000        	  5837:     move.b  (A0,D2.W),D0
02:0004B3C2 0200000F        	  5838:     andi.b #$0F,D0
02:0004B3C6 7600            	  5839:     moveq   #0,D3
02:0004B3C8 1600            	  5840:     move.b  D0,D3
