                            	  5558: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5559:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5560:     ;
02:000424F4 101D            	  5561:     move.b  (A5)+,D0  ; PLA
02:000424F6 1B00            	  5562:     move.b  D0,-(A5)  ; PHA
02:000424F8 7400            	  5563:     moveq   #0,D2
02:000424FA 1400            	  5564:     move.b  D0,D2
                            	  5565:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5566:     ; starting from highest index down to 0:
                            	  5567:     ;
02:000424FC 41F9000423EA    	  5568:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00042502 10302000        	  5569:     move.b  (A0,D2.W),D0
02:00042506 7400            	  5570:     moveq   #0,D2
02:00042508 1400            	  5571:     move.b  D0,D2
