02:0004BF48 1940004B        	  7328:     move.b  D0,($004B,A4)
02:0004BF4C 41EC0492        	  7329:     lea     ($0492,A4),A0
02:0004BF50 11802000        	  7330:     move.b  D0,(A0,D2.W)
02:0004BF54 4E75            	  7331:     rts
                            	  7332:     even
