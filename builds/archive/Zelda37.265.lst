02:000356AC 19400072        	  4791:     move.b  D0,($0072,A4)
02:000356B0 102C0085        	  4792:     move.b  ($0085,A4),D0
02:000356B4 003C0011        	  4793:     ori     #$11,CCR  ; SEC: set C+X
02:000356B8 123C0010        	  4794:     move.b  #$10,D1
02:000356BC 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000356C0 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:000356C2 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
02:000356C6 19400086        	  4798:     move.b  D0,($0086,A4)
                            	  4799:     ; Draw triforce over Zelda.
                            	  4800:     ;
