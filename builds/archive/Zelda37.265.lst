02:00040AF8 4EB9000308D6    	  3345:     jsr     CheckPersonBlocking
02:00040AFE 101D            	  3346:     move.b  (A5)+,D0  ; PLA
                            	  3347:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3348:     ;
02:00040B00 0C00000C        	  3349:     cmpi.b  #$0C,D0
02:00040B04 6704            	  3350:     beq.s  __far_z_05_0059
02:00040B06 60000082        	  3351:     jmp  CheckCaveEdge
                            	  3352: __far_z_05_0059:
                            	  3353:     ; In a shortcut cave (mode $C).
