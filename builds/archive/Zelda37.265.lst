                            	  3578: DrawGhiniAndCheckCollisions:
02:0003A23E 4EB90004BB24    	  3579:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003A244 1940000D        	  3580:     move.b  D0,($000D,A4)
                            	  3581:     ; If the direction has an "up" component, then keep the
                            	  3582:     ; frame image 0, and go figure out horizontal flipping.
                            	  3583:     ;
02:0003A248 41EC0098        	  3584:     lea     ($0098,A4),A0
02:0003A24C 10302000        	  3585:     move.b  (A0,D2.W),D0
02:0003A250 02000008        	  3586:     andi.b #$08,D0
02:0003A254 6614            	  3587:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3588:     ; Else make the frame image 1 for the "down" frame.
                            	  3589:     ; Note that this is the frame image to use, even if there's no
                            	  3590:     ; down component in the direction.
                            	  3591:     ;
02:0003A256 522C000D        	  3592:     addq.b  #1,($000D,A4)
                            	  3593:     ; If right is a component of the direction, then go set horizontal
                            	  3594:     ; flipping. Else leave horizontal flipping = 0.
                            	  3595:     ;
02:0003A25A 41EC0098        	  3596:     lea     ($0098,A4),A0
02:0003A25E 10302000        	  3597:     move.b  (A0,D2.W),D0
02:0003A262 02000001        	  3598:     andi.b #$01,D0
02:0003A266 6714            	  3599:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003A268 660E            	  3600:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3601:     even
                            	  3602: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3603:     ; Set horizontal flipping if right is a direction component.
                            	  3604:     ; This essentially the same test as above, but for when we jump
                            	  3605:     ; from the "up" test.
                            	  3606:     ;
02:0003A26A 41EC0098        	  3607:     lea     ($0098,A4),A0
02:0003A26E 10302000        	  3608:     move.b  (A0,D2.W),D0
02:0003A272 02000002        	  3609:     andi.b #$02,D0
02:0003A276 6704            	  3610:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3611:     even
                            	  3612: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003A278 522C000F        	  3613:     addq.b  #1,($000F,A4)
                            	  3614:     even
                            	  3615: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003A27C 102C000D        	  3616:     move.b  ($000D,A4),D0
                            	  3617: ; Params:
                            	  3618: ; A: frame image
                            	  3619: ; X: object index
                            	  3620: ; [00]: object X
                            	  3621: ; [01]: object Y
                            	  3622: ; [0F]: flip horizontally
                            	  3623: ;
                            	  3624: ; Returns:
                            	  3625: ; [00]: 0 for Link slot
                            	  3626: ; [06]: 1 if objects collide
                            	  3627: ; [09]: 0 for Link damage type (none)
                            	  3628: ; [0C]: 1 if objects collide
                            	  3629: ; [034B]: ShotCollidesWithLink
                            	  3630: ;
                            	  3631:     even
                            	  3632: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003A280 4EB900030E2A    	  3633:     jsr     DrawObjectNotMirrored
02:0003A286 4EF9000312A8    	  3634:     jmp     CheckLinkCollision
                            	  3635: 
                            	  3636:     even
                            	  3637: SecretArmosRoomIds:
02:0003A28C 24              	  3638:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003A28D 0B
02:0003A28E 1C
02:0003A28F 22
02:0003A290 34
02:0003A291 3D
02:0003A292 4E
                            	  3639: 
                            	  3640:     even
                            	  3641: SecretArmosXs:
02:0003A294 E0              	  3642:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003A295 B0
02:0003A296 B0
02:0003A297 30
02:0003A298 40
02:0003A299 90
02:0003A29A A0
                            	  3643: 
                            	  3644:     even
                            	  3645: InitArmosOrFlyingGhini:
                            	  3646:     ; In UpdateObject, this object was flagged "initialized".
                            	  3647:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3648:     ;
02:0003A29C 10342028        	  3649:     move.b  ($28,A4,D2.W),D0
02:0003A2A0 41EC0492        	  3650:     lea     ($0492,A4),A0
02:0003A2A4 11802000        	  3651:     move.b  D0,(A0,D2.W)
                            	  3652:     ; If it's still fading in, then go finish some initialization needed
                            	  3653:     ; for fading in.
                            	  3654:     ;
02:0003A2A8 660000B6        	  3655:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3656:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3657:     ; go finish initializing it.
                            	  3658:     ;
02:0003A2AC 41EC034F        	  3659:     lea     ($034F,A4),A0
02:0003A2B0 10302000        	  3660:     move.b  (A0,D2.W),D0
02:0003A2B4 0C000022        	  3661:     cmpi.b  #$22,D0
02:0003A2B8 670000A6        	  3662:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3663:     ; Else we have an armos.
                            	  3664:     ;
                            	  3665:     ; Store stairs tile $70 in [00] for use later.
                            	  3666:     ;
02:0003A2BC 7070            	  3667:     moveq   #112,D0
02:0003A2BE 1880            	  3668:     move.b  D0,($0000,A4)
                            	  3669:     ; Look for the current room ID in an array of room ID's that
                            	  3670:     ; have armos secrets.
                            	  3671:     ;
02:0003A2C0 7606            	  3672:     moveq   #6,D3
                            	  3673:     even
                            	  3674: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003A2C2 102C00EB        	  3675:     move.b  ($00EB,A4),D0
                            	  3676:     ; If this element does not match the current room ID, go loop again.
                            	  3677:     ;
02:0003A2C6 41F90003A28C    	  3678:     lea     (SecretArmosRoomIds).l,A0
02:0003A2CC 12303000        	  3679:     move.b  (A0,D3.W),D1
02:0003A2D0 B001            	  3680:     cmp.b   D1,D0
02:0003A2D2 6648            	  3681:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3682:     ; The secret (usually stairs) is under one of the armoses.
                            	  3683:     ;
                            	  3684:     ; If the armos's X coordinate does not match the one needed
                            	  3685:     ; for the current room in the list, then go loop again.
                            	  3686:     ;
02:0003A2D4 10342070        	  3687:     move.b  ($70,A4,D2.W),D0
02:0003A2D8 41F90003A294    	  3688:     lea     (SecretArmosXs).l,A0
02:0003A2DE 12303000        	  3689:     move.b  (A0,D3.W),D1
02:0003A2E2 B001            	  3690:     cmp.b   D1,D0
02:0003A2E4 6636            	  3691:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3692:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3693:     ;
02:0003A2E6 41EC0084        	  3694:     lea     ($0084,A4),A0
02:0003A2EA 10302000        	  3695:     move.b  (A0,D2.W),D0
02:0003A2EE 0C000080        	  3696:     cmpi.b  #$80,D0
02:0003A2F2 6628            	  3697:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3698:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3699:     ;
02:0003A2F4 4A03            	  3700:     cmpi.b  #$00,D3
02:0003A2F6 662C            	  3701:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3702:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3703:     ; has the power bracelet.
                            	  3704:     ;
                            	  3705:     ; Set up the room item with the armos's coordinates.
                            	  3706:     ;
02:0003A2F8 19400097        	  3707:     move.b  D0,($0097,A4)
02:0003A2FC 10342070        	  3708:     move.b  ($70,A4,D2.W),D0
02:0003A300 19400083        	  3709:     move.b  D0,($0083,A4)
                            	  3710:     ; This resets the room item's state, which activates it.
                            	  3711:     ;
02:0003A304 194300BF        	  3712:     move.b  D3,($00BF,A4)
                            	  3713:     ; Set the room item ID.
                            	  3714:     ;
02:0003A308 7014            	  3715:     moveq   #20,D0
02:0003A30A 194000AB        	  3716:     move.b  D0,($00AB,A4)
                            	  3717:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3718:     ;
                            	  3719:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3720:     ;
                            	  3721:     ; Note that, if the item was already taken, then the room item
                            	  3722:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3723:     ; it will be ignored, because that routine checks whether
                            	  3724:     ; the item was taken.
                            	  3725:     ;
02:0003A30E 4EB900030B62    	  3726:     jsr     GetRoomFlagUWItemState
02:0003A314 660A            	  3727:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003A316 6100069E        	  3728:     jsr     PlaySecretFoundTune
