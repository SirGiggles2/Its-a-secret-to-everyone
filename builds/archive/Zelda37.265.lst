02:0003F0DE 102C00FB        	   409:     move.b  ($00FB,A4),D0
02:0003F0E2 02000088        	   410:     andi.b #$88,D0
02:0003F0E6 0C000088        	   411:     cmpi.b  #$88,D0
02:0003F0EA 661A            	   412:     bne  _anon_z05_3
02:0003F0EC 4EB90004A0CE    	   413:     jsr     EndGameMode
02:0003F0F2 194000E1        	   414:     move.b  D0,($00E1,A4)
02:0003F0F6 7008            	   415:     moveq   #8,D0
02:0003F0F8 19400012        	   416:     move.b  D0,($0012,A4)
02:0003F0FC 7000            	   417:     moveq   #0,D0
02:0003F0FE 19400619        	   418:     move.b  D0,($0619,A4)
