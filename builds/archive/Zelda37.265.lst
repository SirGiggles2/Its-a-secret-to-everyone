                            	  4187: _anon_z01_99:
                            	  4188:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  4189:     ; if he is defending. The goal is to push Link away from the monster.
                            	  4190:     ;
                            	  4191:     ; If instead a monster is defending, then all this calculation
                            	  4192:     ; won't matter, because the shove direction will be set to the
                            	  4193:     ; weapon's direction.
                            	  4194:     ;
                            	  4195:     ; As such, calculate a direction from the monster to the defender,
                            	  4196:     ; assuming it's Link.
                            	  4197:     ;
                            	  4198:     ; Start with an assumption that the direction is vertical:
                            	  4199:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  4200:     ;
02:0003156C 7008            	  4201:     moveq   #8,D0
02:0003156E 19400008        	  4202:     move.b  D0,($0008,A4)
02:00031572 41EC0084        	  4203:     lea     ($0084,A4),A0
02:00031576 10302000        	  4204:     move.b  (A0,D2.W),D0
02:0003157A 19400004        	  4205:     move.b  D0,($0004,A4)
02:0003157E 41EC0084        	  4206:     lea     ($0084,A4),A0
02:00031582 10303000        	  4207:     move.b  (A0,D3.W),D0
02:00031586 19400005        	  4208:     move.b  D0,($0005,A4)
                            	  4209:     ; If the defender is Link and his grid offset <> 0 then
                            	  4210:     ; use his usual object direction variable to determine
                            	  4211:     ; which axis to check.
                            	  4212:     ;
02:0003158A 4A03            	  4213:     cmpi.b  #$00,D3
02:0003158C 6612            	  4214:     bne  _anon_z01_100
02:0003158E 102C0394        	  4215:     move.b  ($0394,A4),D0
02:00031592 670C            	  4216:     beq  _anon_z01_100
02:00031594 102C0098        	  4217:     move.b  ($0098,A4),D0
02:00031598 02000003        	  4218:     andi.b #$03,D0
02:0003159C 660C            	  4219:     bne  _L_z01_BeginShove_CheckHorizontal
02:0003159E 6720            	  4220:     beq  _L_z01_BeginShove_CheckVertical
                            	  4221: _anon_z01_100:
                            	  4222:     ; For monsters defending, or Link with grid offset = 0,
                            	  4223:     ; check direction in [0B].
                            	  4224:     ;
                            	  4225:     ; For monsters defending, this won't matter. For Link with grid
                            	  4226:     ; offset = 0, I believe the result will be arbitrary.
                            	  4227:     ;
                            	  4228:     ; TODO:
                            	  4229:     ; Is [0B] always set if Link's grid offset = 0?
                            	  4230:     ; It doesn't seem to be if candle fire attacks him.
                            	  4231:     ;
02:000315A0 102C000B        	  4232:     move.b  ($000B,A4),D0
02:000315A4 0C000004        	  4233:     cmpi.b  #$04,D0
02:000315A8 6416            	  4234:     bcc  _L_z01_BeginShove_CheckVertical
                            	  4235:     even
