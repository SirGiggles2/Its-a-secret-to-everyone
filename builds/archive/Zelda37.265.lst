02:0003E1B4 102C051C        	 12215:     move.b  ($051C,A4),D0
02:0003E1B8 0200000F        	 12216:     andi.b #$0F,D0
02:0003E1BC 0C000004        	 12217:     cmpi.b  #$04,D0
02:0003E1C0 6702            	 12218:     beq.s  __far_z_04_0115
02:0003E1C2 6042            	 12219:     jmp  Ganon_DrawBodyFrame0
                            	 12220: __far_z_04_0115:
