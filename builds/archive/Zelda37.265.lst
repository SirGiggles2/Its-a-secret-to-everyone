02:0002E9AE 41F90002E95E    	   269:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E9B4 10303000        	   270:     move.b  (A0,D3.W),D0
02:0002E9B8 1B00            	   271:     move.b  D0,-(A5)  ; PHA
02:0002E9BA 0200003F        	   272:     andi.b #$3F,D0
02:0002E9BE 19400415        	   273:     move.b  D0,($0415,A4)
                            	   274:     ; Pop and mask the text selector byte with $C0 to get the
                            	   275:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   276:     ;
02:0002E9C2 101D            	   277:     move.b  (A5)+,D0  ; PLA
02:0002E9C4 020000C0        	   278:     andi.b #$C0,D0
02:0002E9C8 19400003        	   279:     move.b  D0,($0003,A4)
                            	   280:     ; At this point, the Y register still has the cave index.
                            	   281:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   282:     ;
02:0002E9CC 103C00FD        	   283:     move.b  #$FD,D0
                            	   284: _anon_z01_0:
02:0002E9D0 023C00EE        	   285:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E9D4 123C0003        	   286:     move.b  #$03,D1
02:0002E9D8 D101            	   287:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E9DA 5303            	   288:     subq.b  #1,D3
02:0002E9DC 6AF2            	   289:     bpl  _anon_z01_0
02:0002E9DE 7600            	   290:     moveq   #0,D3
02:0002E9E0 1600            	   291:     move.b  D0,D3
                            	   292:     ; Loop over the wares from 0 to 2.
                            	   293:     ;
02:0002E9E2 7400            	   294:     moveq   #0,D2
                            	   295:     even
                            	   296: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   297:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   298:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   299:     ;
02:0002E9E4 41F900FF6A7E    	   300:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E9EA 10303000        	   301:     move.b  (A0,D3.W),D0
02:0002E9EE 41EC0422        	   302:     lea     ($0422,A4),A0
02:0002E9F2 11802000        	   303:     move.b  D0,(A0,D2.W)
                            	   304:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   305:     ;
02:0002E9F6 020000C0        	   306:     andi.b #$C0,D0
02:0002E9FA 19802000        	   307:     move.b  D0,($00,A4,D2.W)
                            	   308:     ; Copy 3 prices from the Cave level block info.
                            	   309:     ;
02:0002E9FE 41F900FF6ABA    	   310:     lea     (NES_SRAM+$0ABA).l,A0
02:0002EA04 10303000        	   311:     move.b  (A0,D3.W),D0
02:0002EA08 41EC0430        	   312:     lea     ($0430,A4),A0
02:0002EA0C 11802000        	   313:     move.b  D0,(A0,D2.W)
                            	   314:     ; Bottom of the wares copying loop.
                            	   315:     ;
02:0002EA10 5203            	   316:     addq.b  #1,D3
02:0002EA12 5202            	   317:     addq.b  #1,D2
02:0002EA14 0C020003        	   318:     cmpi.b  #$03,D2
02:0002EA18 66CA            	   319:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   320:     ; Get the top 2 bits of text selector byte in [03],
                            	   321:     ; shift them to the bottom, and combine them with [00].
                            	   322:     ;
02:0002EA1A 102C0003        	   323:     move.b  ($0003,A4),D0
02:0002EA1E E308            	   324:     lsl.b  #1,D0   ; ASL A
02:0002EA20 E310            	   325:     roxl.b  #1,D0   ; ROL A
02:0002EA22 E310            	   326:     roxl.b  #1,D0   ; ROL A
02:0002EA24 1214            	   327:     move.b  ($0000,A4),D1
02:0002EA26 8001            	   328:     or.b  D1,D0
02:0002EA28 1880            	   329:     move.b  D0,($0000,A4)
                            	   330:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   331:     ; and combine them with [00].
                            	   332:     ;
02:0002EA2A 102C0002        	   333:     move.b  ($0002,A4),D0
02:0002EA2E E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002EA30 E208            	   335:     lsr.b  #1,D0   ; LSR A
02:0002EA32 E208            	   336:     lsr.b  #1,D0   ; LSR A
02:0002EA34 E208            	   337:     lsr.b  #1,D0   ; LSR A
02:0002EA36 1214            	   338:     move.b  ($0000,A4),D1
02:0002EA38 8001            	   339:     or.b  D1,D0
02:0002EA3A 1880            	   340:     move.b  D0,($0000,A4)
                            	   341:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   342:     ; and combine them with [00] into CaveFlags.
                            	   343:     ;
02:0002EA3C 102C0001        	   344:     move.b  ($0001,A4),D0
02:0002EA40 E208            	   345:     lsr.b  #1,D0   ; LSR A
02:0002EA42 E208            	   346:     lsr.b  #1,D0   ; LSR A
02:0002EA44 1214            	   347:     move.b  ($0000,A4),D1
02:0002EA46 8001            	   348:     or.b  D1,D0
02:0002EA48 19400413        	   349:     move.b  D0,($0413,A4)
                            	   350:     ; The end result is a byte with 8 cave flags.
                            	   351:     ;
                            	   352:     ; If cave flag "money game" is missing, then go finish up,
                            	   353:     ; instead of choosing random amounts for the money game.
                            	   354:     ;
02:0002EA4C 02000020        	   355:     andi.b #$20,D0
02:0002EA50 6700009E        	   356:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   357:     ; Determine an index randomly with increasing probability,
                            	   358:     ; from 6 to 1. Start with the following test:
                            	   359:     ;
                            	   360:     ;   If $FF < Random, then go use index 6.
                            	   361:     ;
02:0002EA54 103C00FF        	   362:     move.b  #$FF,D0
02:0002EA58 7606            	   363:     moveq   #6,D3
                            	   364:     even
                            	   365: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002EA5A 122C0019        	   366:     move.b  ($0019,A4),D1
02:0002EA5E B001            	   367:     cmp.b   D1,D0
02:0002EA60 6516            	   368:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   369:     ; If the test fails, then subtract $2B from the reference number.
                            	   370:     ;
02:0002EA62 003C0011        	   371:     ori     #$11,CCR  ; SEC: set C+X
02:0002EA66 123C002B        	   372:     move.b  #$2B,D1
02:0002EA6A 0A3C0010        	   373:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EA6E 9101            	   374:     subx.b  D1,D0   ; SBC #$2B
02:0002EA70 0A3C0010        	   375:     eori    #$10,CCR  ; restore X = 6502 C
02:0002EA74 5303            	   376:     subq.b  #1,D3
02:0002EA76 66E2            	   377:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   378:     even
                            	   379: _L_z01_InitCaveContinue_FoundPermutation:
                            	   380:     ; The index chooses the last offset of a permutation of three indexes.
                            	   381:     ;
02:0002EA78 7400            	   382:     moveq   #0,D2
02:0002EA7A 41F90002E986    	   383:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002EA80 14303000        	   384:     move.b  (A0,D3.W),D2
                            	   385:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   386:     ;
02:0002EA84 7602            	   387:     moveq   #2,D3
                            	   388:     even
                            	   389: _L_z01_InitCaveContinue_CopyPermutation:
02:0002EA86 41F90002E974    	   390:     lea     (MoneyGamePermutations).l,A0
02:0002EA8C 10302000        	   391:     move.b  (A0,D2.W),D0
02:0002EA90 41EC046C        	   392:     lea     ($046C,A4),A0
02:0002EA94 11803000        	   393:     move.b  D0,(A0,D3.W)
02:0002EA98 5302            	   394:     subq.b  #1,D2
02:0002EA9A 5303            	   395:     subq.b  #1,D3
02:0002EA9C 6AE8            	   396:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   397:     ; With the first bit of another random number, choose 10 or 40
                            	   398:     ; to put in [046F]. This is a random amount to lose.
                            	   399:     ;
02:0002EA9E 102C001A        	   400:     move.b  ($001A,A4),D0
02:0002EAA2 02000001        	   401:     andi.b #$01,D0
02:0002EAA6 7600            	   402:     moveq   #0,D3
02:0002EAA8 1600            	   403:     move.b  D0,D3
02:0002EAAA 41F90002E972    	   404:     lea     (MoneyGameLossAmounts).l,A0
02:0002EAB0 10303000        	   405:     move.b  (A0,D3.W),D0
02:0002EAB4 1940046F        	   406:     move.b  D0,($046F,A4)
                            	   407:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   408:     ;
02:0002EAB8 700A            	   409:     moveq   #10,D0
02:0002EABA 19400470        	   410:     move.b  D0,($0470,A4)
                            	   411:     ; With a different bit of the second random number,
                            	   412:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   413:     ;
02:0002EABE 7614            	   414:     moveq   #20,D3
02:0002EAC0 102C001A        	   415:     move.b  ($001A,A4),D0
02:0002EAC4 02000002        	   416:     andi.b #$02,D0
02:0002EAC8 6702            	   417:     beq  _anon_z01_1
02:0002EACA 7632            	   418:     moveq   #50,D3
                            	   419: _anon_z01_1:
02:0002EACC 19430471        	   420:     move.b  D3,($0471,A4)
                            	   421:     ; The 3 amounts are now in [046F] to [0471].
                            	   422:     ; Reference these amounts using the permutation of indexes
                            	   423:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   424:     ;
02:0002EAD0 7402            	   425:     moveq   #2,D2
                            	   426:     even
