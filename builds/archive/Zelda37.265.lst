02:0003A1A8 661E            	  3490:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003A1AA 7006            	  3491:     moveq   #6,D0
02:0003A1AC 41EC03D0        	  3492:     lea     ($03D0,A4),A0
02:0003A1B0 11802000        	  3493:     move.b  D0,(A0,D2.W)
                            	  3494:     ; There are actually 6 frame images divided into 2 sets.
                            	  3495:     ; Each set depicts one animation frame. In each set there are
                            	  3496:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3497:     ;
                            	  3498:     ; The movement frame will keep track of the base offset of
                            	  3499:     ; the current set for the current animation frame: 0 or 3.
                            	  3500:     ;
                            	  3501:     ; So, XOR the movement frame with 3.
                            	  3502:     ;
02:0003A1B4 E208            	  3503:     lsr.b  #1,D0   ; LSR A
02:0003A1B6 41EC03E4        	  3504:     lea     ($03E4,A4),A0
02:0003A1BA 12302000        	  3505:     move.b  (A0,D2.W),D1
02:0003A1BE B300            	  3506:     eor.b  D1,D0
02:0003A1C0 41EC03E4        	  3507:     lea     ($03E4,A4),A0
02:0003A1C4 11802000        	  3508:     move.b  D0,(A0,D2.W)
                            	  3509:     even
                            	  3510: _L_z04_UpdateOctorock_CalcFinalOffset:
