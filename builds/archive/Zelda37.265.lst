                            	  1714: InitMode_EnterRoom:
02:0003FEE6 4EB900049E9A    	  1715:     jsr     DrawSpritesBetweenRooms
02:0003FEEC 4EB900049EB8    	  1716:     jsr     ResetPlayerState
                            	  1717:     ; Reset [0300] to [051F].
                            	  1718:     ;
02:0003FEF2 7005            	  1719:     moveq   #5,D0
02:0003FEF4 761F            	  1720:     moveq   #31,D3
02:0003FEF6 4EB900049718    	  1721:     jsr     ClearRam0300UpTo
                            	  1722:     ; Reset door trigger info.
                            	  1723:     ;
02:0003FEFC 7000            	  1724:     moveq   #0,D0
02:0003FEFE 19400054        	  1725:     move.b  D0,($0054,A4)
02:0003FF02 19400055        	  1726:     move.b  D0,($0055,A4)
                            	  1727:     ; Store level block attribute byte F for convenience.
                            	  1728:     ;
02:0003FF06 7600            	  1729:     moveq   #0,D3
02:0003FF08 162C00EB        	  1730:     move.b  ($00EB,A4),D3
02:0003FF0C 41F900FF6AFE    	  1731:     lea     (NES_SRAM+$0AFE).l,A0
02:0003FF12 10303000        	  1732:     move.b  (A0,D3.W),D0
02:0003FF16 194004CD        	  1733:     move.b  D0,($04CD,A4)
02:0003FF1A 610038A6        	  1734:     jsr     ResetInvObjState
                            	  1735:     ; There's more than one way to enter a room.
                            	  1736:     ;
                            	  1737:     ; 1: Out of a cave, dungeon, or cellar
                            	  1738:     ;     a. Walking exit
                            	  1739:     ;     b. Next to stairs
                            	  1740:     ; 2: Room to room
                            	  1741:     ;
                            	  1742:     ; Determine which one we need.
                            	  1743:     ;
02:0003FF1E 102C005A        	  1744:     move.b  ($005A,A4),D0
02:0003FF22 6770            	  1745:     beq  _L_z05_InitMode_EnterRoom_Method2
02:0003FF24 102C0010        	  1746:     move.b  ($0010,A4),D0
02:0003FF28 665C            	  1747:     bne  _anon_z05_42
                            	  1748:     ; Enter method 1.
                            	  1749:     ;
                            	  1750:     ; Set up Link's exit from underground.
                            	  1751:     ;
02:0003FF2A 7600            	  1752:     moveq   #0,D3
02:0003FF2C 162C00EB        	  1753:     move.b  ($00EB,A4),D3
02:0003FF30 41F900FF687E    	  1754:     lea     (NES_SRAM+$087E).l,A0
02:0003FF36 10303000        	  1755:     move.b  (A0,D3.W),D0
02:0003FF3A 020000F0        	  1756:     andi.b #$F0,D0
02:0003FF3E 19400070        	  1757:     move.b  D0,($0070,A4)
02:0003FF42 41F900FF6AFE    	  1758:     lea     (NES_SRAM+$0AFE).l,A0
02:0003FF48 10303000        	  1759:     move.b  (A0,D3.W),D0
02:0003FF4C 02000007        	  1760:     andi.b #$07,D0
02:0003FF50 E308            	  1761:     lsl.b  #1,D0   ; ASL A
02:0003FF52 E308            	  1762:     lsl.b  #1,D0   ; ASL A
02:0003FF54 E308            	  1763:     lsl.b  #1,D0   ; ASL A
02:0003FF56 E308            	  1764:     lsl.b  #1,D0   ; ASL A
                            	  1765:     ; Add the first Y where Link can come out of underground.
                            	  1766:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:0003FF58 123C004D        	  1767:     move.b  #$4D,D1
02:0003FF5C D101            	  1768:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:0003FF5E 19400084        	  1769:     move.b  D0,($0084,A4)
                            	  1770:     ; If the player didn't step on a cave entrance to go underground,
                            	  1771:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1772:     ;
02:0003FF62 7600            	  1773:     moveq   #0,D3
02:0003FF64 162C0065        	  1774:     move.b  ($0065,A4),D3
02:0003FF68 0C030024        	  1775:     cmpi.b  #$24,D3
02:0003FF6C 6618            	  1776:     bne  _anon_z05_42
                            	  1777:     ; Enter method 1-a.
                            	  1778:     ;
                            	  1779:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1780:     ;
02:0003FF6E 19400412        	  1781:     move.b  D0,($0412,A4)
02:0003FF72 023C00EE        	  1782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FF76 123C0010        	  1783:     move.b  #$10,D1
02:0003FF7A D101            	  1784:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003FF7C 19400084        	  1785:     move.b  D0,($0084,A4)
02:0003FF80 7008            	  1786:     moveq   #8,D0
02:0003FF82 19400603        	  1787:     move.b  D0,($0603,A4)
                            	  1788: _anon_z05_42:
                            	  1789:     ; This part is the same no matter if the player went
                            	  1790:     ; underground by stairs or a cave entrance.
                            	  1791:     ;
02:0003FF86 7004            	  1792:     moveq   #4,D0
02:0003FF88 19400098        	  1793:     move.b  D0,($0098,A4)
02:0003FF8C 7000            	  1794:     moveq   #0,D0
02:0003FF8E 19400053        	  1795:     move.b  D0,($0053,A4)
02:0003FF92 6064            	  1796:     jmp     _L_z05_InitMode_EnterRoom_PlaceObjects
