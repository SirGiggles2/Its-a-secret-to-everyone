                            	 11968: UpdatePatraChild:
                            	 11969:     ; If state = 1, then go orbit.
                            	 11970:     ;
02:0003DFF6 41EC00AC        	 11971:     lea     ($00AC,A4),A0
02:0003DFFA 10302000        	 11972:     move.b  (A0,D2.W),D0
02:0003DFFE 6704            	 11973:     beq.s  __far_z_04_0114
02:0003E000 6000009E        	 11974:     jmp  PatraChild_State1
                            	 11975: __far_z_04_0114:
                            	 11976:     ; State = 0.
                            	 11977:     ;
                            	 11978:     ; If the current object slot is 2, then go initialize the patra child.
                            	 11979:     ; This is the only patra child shown in the first fame.
                            	 11980:     ;
02:0003E004 0C020002        	 11981:     cmpi.b  #$02,D2
02:0003E008 6732            	 11982:     beq  _L_z04_UpdatePatraChild_Ready
                            	 11983:     ; The patra child in slot 2 is the last one to be updated.
                            	 11984:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 11985:     ;
                            	 11986:     ; This means that in the first frame, slot 2 is the only one to be
                            	 11987:     ; shown.
                            	 11988:     ;
02:0003E00A 102C00AE        	 11989:     move.b  ($00AE,A4),D0
02:0003E00E 6700008E        	 11990:     beq  _L_z04_UpdatePatraChild_Exit
                            	 11991:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 11992:     ; here to wait to be shown at the top position (N) one at a time.
                            	 11993:     ;
02:0003E012 1002            	 11994:     move.b  D2,D0
                            	 11995:     ; Subtract 3 from the object slot to get the angle where the
                            	 11996:     ; patra child in object slot 2 should be for the current one to appear.
                            	 11997:     ;
02:0003E014 003C0011        	 11998:     ori     #$11,CCR  ; SEC: set C+X
02:0003E018 123C0003        	 11999:     move.b  #$03,D1
02:0003E01C 0A3C0010        	 12000:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E020 9101            	 12001:     subx.b  D1,D0   ; SBC #$03
02:0003E022 0A3C0010        	 12002:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E026 7600            	 12003:     moveq   #0,D3
02:0003E028 1600            	 12004:     move.b  D0,D3
                            	 12005:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12006:     ; then return.
                            	 12007:     ;
02:0003E02A 102C0396        	 12008:     move.b  ($0396,A4),D0
02:0003E02E 41F90003DFE8    	 12009:     lea     (PatraChildStartAngles).l,A0
02:0003E034 12303000        	 12010:     move.b  (A0,D3.W),D1
02:0003E038 B001            	 12011:     cmp.b   D1,D0
02:0003E03A 6662            	 12012:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12013:     even
                            	 12014: _L_z04_UpdatePatraChild_Ready:
                            	 12015:     ; Once the patra child in the last slot (9) reaches here, advance
                            	 12016:     ; the patra parent's state.
                            	 12017:     ;
02:0003E03C 0C020009        	 12018:     cmpi.b  #$09,D2
02:0003E040 6604            	 12019:     bne  _anon_z04_157
02:0003E042 522C00AD        	 12020:     addq.b  #1,($00AD,A4)
                            	 12021: _anon_z04_157:
                            	 12022:     ; Go to state 1 to orbit.
                            	 12023:     ;
02:0003E046 41EC00AC        	 12024:     lea     ($00AC,A4),A0
02:0003E04A 52302000        	 12025:     addq.b  #1,(A0,D2.W)
                            	 12026:     ; TODO: ?
                            	 12027:     ;
02:0003E04E 103C0080        	 12028:     move.b  #$80,D0
02:0003E052 41EC0098        	 12029:     lea     ($0098,A4),A0
02:0003E056 11802000        	 12030:     move.b  D0,(A0,D2.W)
                            	 12031:     ; Set angle $18 (N).
                            	 12032:     ;
02:0003E05A 7018            	 12033:     moveq   #24,D0
02:0003E05C 41EC0394        	 12034:     lea     ($0394,A4),A0
02:0003E060 11802000        	 12035:     move.b  D0,(A0,D2.W)
                            	 12036:     ; This location is right above Patra.
                            	 12037:     ; Set X coordinate to Patra's.
                            	 12038:     ;
02:0003E064 102C0071        	 12039:     move.b  ($0071,A4),D0
02:0003E068 19802070        	 12040:     move.b  D0,($70,A4,D2.W)
                            	 12041:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12042:     ; Else use radius $18. Store the chosen value in [00].
                            	 12043:     ;
02:0003E06C 702C            	 12044:     moveq   #44,D0
02:0003E06E 7600            	 12045:     moveq   #0,D3
02:0003E070 41EC034F        	 12046:     lea     ($034F,A4),A0
02:0003E074 16302000        	 12047:     move.b  (A0,D2.W),D3
02:0003E078 0C030025        	 12048:     cmpi.b  #$25,D3
02:0003E07C 6702            	 12049:     beq  _anon_z04_158
02:0003E07E 7018            	 12050:     moveq   #24,D0
                            	 12051: _anon_z04_158:
02:0003E080 1880            	 12052:     move.b  D0,($0000,A4)
                            	 12053:     ; This location is right above Patra.
