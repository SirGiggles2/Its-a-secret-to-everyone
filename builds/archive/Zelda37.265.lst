02:0004AEC6 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004AECA 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:0004AECC 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:0004AED0 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:0004AED2 7002            	  5112:     moveq   #2,D0
02:0004AED4 1940000C        	  5113:     move.b  D0,($000C,A4)
02:0004AED8 7623            	  5114:     moveq   #35,D3
02:0004AEDA 4EB90003103C    	  5115:     jsr     Anim_WriteItemSprites
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:0004AEE0 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004AEE2 19400003        	  5123:     move.b  D0,($0003,A4)
02:0004AEE6 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004AEE8 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:0004AEEC 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:0004AEEE 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:0004AEF0 7600            	  5136:     moveq   #0,D3
02:0004AEF2 1600            	  5137:     move.b  D0,D3
02:0004AEF4 0C030001        	  5138:     cmpi.b  #$01,D3
02:0004AEF8 6602            	  5139:     bne  _anon_z07_25
02:0004AEFA 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:0004AEFC 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:0004AF00 4600            	  5143:     eori.b #$FF,D0
02:0004AF02 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AF06 123C0001        	  5145:     move.b  #$01,D1
02:0004AF0A D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004AF0C 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:0004AF10 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:0004AF12 7600            	  5151:     moveq   #0,D3
02:0004AF14 1600            	  5152:     move.b  D0,D3
02:0004AF16 5303            	  5153:     subq.b  #1,D3
02:0004AF18 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5155:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5156:     ;
                            	  5157:     ; Decrease the base negative offset to get farther away from
                            	  5158:     ; the center point.
                            	  5159:     ;
02:0004AF1C 41EC0098        	  5160:     lea     ($0098,A4),A0
02:0004AF20 53302000        	  5161:     subq.b  #1,(A0,D2.W)
                            	  5162:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5163:     ;
                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:0004AF24 41EC0098        	  5166:     lea     ($0098,A4),A0
02:0004AF28 10302000        	  5167:     move.b  (A0,D2.W),D0
02:0004AF2C 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:0004AF30 6702            	  5169:     beq.s  __far_z_07_0077
02:0004AF32 6004            	  5170:     jmp  L1F49F_Exit
