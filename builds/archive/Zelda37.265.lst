                            	  2539: _L_z04_UpdateTektiteOrBoulder_CheckStunned:
                            	  2540:     ; If we have the magic clock, or the monster is stunned; 
                            	  2541:     ; then go animate, draw, and check collisions.
                            	  2542:     ;
02:00039A84 102C066C        	  2543:     move.b  ($066C,A4),D0
02:00039A88 1234203D        	  2544:     move.b  ($3D,A4,D2.W),D1
02:00039A8C 8001            	  2545:     or.b  D1,D0
02:00039A8E 66F0            	  2546:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  2547:     ; If state <> 0, go update the jump.
                            	  2548:     ;
02:00039A90 41EC00AC        	  2549:     lea     ($00AC,A4),A0
02:00039A94 10302000        	  2550:     move.b  (A0,D2.W),D0
02:00039A98 660000C0        	  2551:     bne  _L_z04_UpdateTektiteOrBoulder_State1
                            	  2552:     ; State 0. On the ground.
                            	  2553:     ;
                            	  2554:     ; If timer <> 0, then go animate, draw, and check collisions.
                            	  2555:     ;
02:00039A9C 10342028        	  2556:     move.b  ($28,A4,D2.W),D0
02:00039AA0 660000B4        	  2557:     bne  _L_z04_UpdateTektiteOrBoulder_Animate
                            	  2558:     ; State = 0 and object timer expired. Time to jump.
                            	  2559:     ;
                            	  2560:     ; First, turn 1 step toward the chase target.
                            	  2561:     ;
02:00039AA4 610050FE        	  2562:     jsr     TurnTowardsPlayer8
                            	  2563:     ; If the facing direction has no horizontal component, then
                            	  2564:     ; find the horizontal direction toward the chase target.
                            	  2565:     ;
                            	  2566:     ; Then combine it with the facing direction.
                            	  2567:     ;
02:00039AA8 41EC0098        	  2568:     lea     ($0098,A4),A0
02:00039AAC 10302000        	  2569:     move.b  (A0,D2.W),D0
02:00039AB0 02000003        	  2570:     andi.b #$03,D0
02:00039AB4 6624            	  2571:     bne  _L_z04_UpdateTektiteOrBoulder_SetStateJump
02:00039AB6 7602            	  2572:     moveq   #2,D3
02:00039AB8 102C0061        	  2573:     move.b  ($0061,A4),D0
02:00039ABC 12342070        	  2574:     move.b  ($70,A4,D2.W),D1
02:00039AC0 B001            	  2575:     cmp.b   D1,D0
02:00039AC2 6502            	  2576:     bcs  _anon_z04_36
02:00039AC4 5303            	  2577:     subq.b  #1,D3
                            	  2578: _anon_z04_36:
02:00039AC6 1003            	  2579:     move.b  D3,D0
02:00039AC8 41EC0098        	  2580:     lea     ($0098,A4),A0
02:00039ACC 12302000        	  2581:     move.b  (A0,D2.W),D1
02:00039AD0 8001            	  2582:     or.b  D1,D0
