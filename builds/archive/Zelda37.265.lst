02:0003F11C 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003F120 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003F122 4EB900049712    	   434:     jsr     HideAllSprites
02:0003F128 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0003F12A 19400258        	   436:     move.b  D0,($0258,A4)
02:0003F12E 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:0003F130 19400254        	   438:     move.b  D0,($0254,A4)
02:0003F134 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0003F138 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F13C 4E75            	   441:     rts
