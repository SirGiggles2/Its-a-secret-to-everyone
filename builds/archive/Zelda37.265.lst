02:00040AE6 E308            	  3331:     lsl.b  #1,D0   ; ASL A
02:00040AE8 E308            	  3332:     lsl.b  #1,D0   ; ASL A
02:00040AEA E308            	  3333:     lsl.b  #1,D0   ; ASL A
