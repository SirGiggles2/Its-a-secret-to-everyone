02:0003A332 522C00F7        	  3755:     addq.b  #1,($00F7,A4)
02:0003A336 101D            	  3756:     move.b  (A5)+,D0  ; PLA
02:0003A338 4EB900049B86    	  3757:     jsr     ChangeTileObjTiles
                            	  3758:     ; Because the armos object is aligned to the square grid
                            	  3759:     ; (because it was made from a square),
                            	  3760:     ; set its grid offset to 3 to compensate.
                            	  3761:     ;
                            	  3762:     ; Most objects are aligned to the grid vertically when the
                            	  3763:     ; low nibble is $D.
                            	  3764:     ;
02:0003A33E 7003            	  3765:     moveq   #3,D0
02:0003A340 41EC0394        	  3766:     lea     ($0394,A4),A0
02:0003A344 11802000        	  3767:     move.b  D0,(A0,D2.W)
                            	  3768:     ; Set a speed (q-speed fraction) randomly:
                            	  3769:     ; $20 if random value < $80
                            	  3770:     ; $60 otherwise
                            	  3771:     ;
02:0003A348 7020            	  3772:     moveq   #32,D0
02:0003A34A 7600            	  3773:     moveq   #0,D3
02:0003A34C 16342019        	  3774:     move.b  ($19,A4,D2.W),D3
02:0003A350 0C030080        	  3775:     cmpi.b  #$80,D3
02:0003A354 6502            	  3776:     bcs  _anon_z04_52
02:0003A356 7060            	  3777:     moveq   #96,D0
                            	  3778: _anon_z04_52:
02:0003A358 41EC03BC        	  3779:     lea     ($03BC,A4),A0
