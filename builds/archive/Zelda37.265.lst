02:0003B0F8 101D            	  5595:     move.b  (A5)+,D0  ; PLA
02:0003B0FA 19802028        	  5596:     move.b  D0,($28,A4,D2.W)
02:0003B0FE 101D            	  5597:     move.b  (A5)+,D0  ; PLA
02:0003B100 41EC0098        	  5598:     lea     ($0098,A4),A0
02:0003B104 11802000        	  5599:     move.b  D0,(A0,D2.W)
                            	  5600:     ; If this segment is still alive, then return.
                            	  5601:     ;
02:0003B108 41EC0405        	  5602:     lea     ($0405,A4),A0
02:0003B10C 10302000        	  5603:     move.b  (A0,D2.W),D0
02:0003B110 6774            	  5604:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5605:     ; This segment is dead. We'll swap the tail segment with this
                            	  5606:     ; dead segment. This way, moldorm heads are always rooted
                            	  5607:     ; in slots 5 and $A; and the segments are continguous.
                            	  5608:     ;
                            	  5609:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5610:     ;
                            	  5611:     ; Note that this is not a true swap, because the tail's HP
                            	  5612:     ; might be less than $20.
                            	  5613:     ;
02:0003B112 7020            	  5614:     moveq   #32,D0
02:0003B114 41EC0485        	  5615:     lea     ($0485,A4),A0
02:0003B118 11802000        	  5616:     move.b  D0,(A0,D2.W)
02:0003B11C 61000608        	  5617:     jsr     CheckBossHitReaction
                            	  5618:     ; Look for the tail segment, starting from the low end
                            	  5619:     ; of the chain that this dead segment belongs to.
                            	  5620:     ;
02:0003B120 163C00FF        	  5621:     move.b  #$FF,D3
02:0003B124 0C020006        	  5622:     cmpi.b  #$06,D2
02:0003B128 6502            	  5623:     bcs  _anon_z04_80
02:0003B12A 7604            	  5624:     moveq   #4,D3
                            	  5625: _anon_z04_80:
02:0003B12C 5203            	  5626:     addq.b  #1,D3
02:0003B12E 41EC0350        	  5627:     lea     ($0350,A4),A0
02:0003B132 10303000        	  5628:     move.b  (A0,D3.W),D0
02:0003B136 0C000041        	  5629:     cmpi.b  #$41,D0
02:0003B13A 66F0            	  5630:     bne  _anon_z04_80
                            	  5631:     ; I don't know why the object timer of the tail segment that will
                            	  5632:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5633:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5634:     ; there, the object timer is set to 6.
                            	  5635:     ;
02:0003B13C 7011            	  5636:     moveq   #17,D0
02:0003B13E 19803029        	  5637:     move.b  D0,($29,A4,D3.W)
                            	  5638:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5639:     ; segment to the tail segment.
                            	  5640:     ;
02:0003B142 41EC04F0        	  5641:     lea     ($04F0,A4),A0
02:0003B146 10302000        	  5642:     move.b  (A0,D2.W),D0
02:0003B14A 41EC04F1        	  5643:     lea     ($04F1,A4),A0
02:0003B14E 11803000        	  5644:     move.b  D0,(A0,D3.W)
02:0003B152 10342070        	  5645:     move.b  ($70,A4,D2.W),D0
02:0003B156 19803071        	  5646:     move.b  D0,($71,A4,D3.W)
02:0003B15A 41EC0084        	  5647:     lea     ($0084,A4),A0
02:0003B15E 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003B162 41EC0085        	  5649:     lea     ($0085,A4),A0
02:0003B166 11803000        	  5650:     move.b  D0,(A0,D3.W)
                            	  5651:     ; If the tail segment found is also a head, then
                            	  5652:     ; the last segment has died. Return.
                            	  5653:     ;
02:0003B16A 0C030004        	  5654:     cmpi.b  #$04,D3
02:0003B16E 6716            	  5655:     beq  _L_z04_UpdateMoldorm_Exit
02:0003B170 0C030009        	  5656:     cmpi.b  #$09,D3
02:0003B174 6710            	  5657:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5658:     ; Else finish swapping the segments.
                            	  5659:     ; Set the tail segment's type to the dead dummy object.
                            	  5660:     ;
02:0003B176 705D            	  5661:     moveq   #93,D0
02:0003B178 41EC0350        	  5662:     lea     ($0350,A4),A0
02:0003B17C 11803000        	  5663:     move.b  D0,(A0,D3.W)
                            	  5664:     ; Reset the metastate of the current segment, so that it comes
