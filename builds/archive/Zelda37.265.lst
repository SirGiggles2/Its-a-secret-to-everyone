02:0002B710 7000            	   999:     moveq   #0,D0
02:0002B712 3002            	  1000:     move.w  D2,D0
02:0002B714 2F00            	  1001:     move.l  D0,-(SP)
02:0002B716 4EB900000000    	  1002:     jsr     z05_set_door_flag
02:0002B71C 588F            	  1003:     addq.l  #4,SP
02:0002B71E 4E75            	  1004:     rts
