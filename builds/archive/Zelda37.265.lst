                            	 11422: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003DC12 10342070        	 11423:     move.b  ($70,A4,D2.W),D0
02:0003DC16 1B00            	 11424:     move.b  D0,-(A5)  ; PHA
                            	 11425:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11426:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11427:     ;
02:0003DC18 023C00EE        	 11428:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC1C 123C0004        	 11429:     move.b  #$04,D1
02:0003DC20 D101            	 11430:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DC22 19802070        	 11431:     move.b  D0,($70,A4,D2.W)
                            	 11432:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11433:     ; to store in [03].
                            	 11434:     ;
02:0003DC26 102C04E6        	 11435:     move.b  ($04E6,A4),D0
02:0003DC2A 0A000003        	 11436:     eori.b #$03,D0
02:0003DC2E 19400003        	 11437:     move.b  D0,($0003,A4)
                            	 11438:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11439:     ;
02:0003DC32 103C009E        	 11440:     move.b  #$9E,D0
02:0003DC36 0C020005        	 11441:     cmpi.b  #$05,D2
02:0003DC3A 670A            	 11442:     beq  _L_z04_UpdateLamnola_Draw
02:0003DC3C 0C02000A        	 11443:     cmpi.b  #$0A,D2
02:0003DC40 6704            	 11444:     beq  _L_z04_UpdateLamnola_Draw
02:0003DC42 103C00A0        	 11445:     move.b  #$A0,D0
