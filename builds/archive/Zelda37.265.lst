                            	  3092: AnimateAndDrawObjectWalking:
02:00030E1C 4EB90004BAC0    	  3093:     jsr     AnimateObjectWalking
02:00030E22 1003            	  3094:     move.b  D3,D0
02:00030E24 6004            	  3095:     jmp     DrawObjectNotMirrored
                            	  3096: 
                            	  3097: ; Params:
                            	  3098: ; A: frame image
                            	  3099: ; X: object index
                            	  3100: ; [00]: object X
                            	  3101: ; [01]: object Y
                            	  3102: ;
                            	  3103: ;
                            	  3104: ; Set [0C] mirrored.
                            	  3105:     even
                            	  3106: DrawObjectMirrored:
02:00030E26 7601            	  3107:     moveq   #1,D3
02:00030E28 6602            	  3108:     bne  _anon_z01_75
                            	  3109: ; Params:
                            	  3110: ; A: frame image
                            	  3111: ; X: object index
                            	  3112: ; [00]: object X
                            	  3113: ; [01]: object Y
                            	  3114: ; [0F]: flip horizontally
                            	  3115: ;
                            	  3116:     even
                            	  3117: DrawObjectNotMirrored:
02:00030E2A 7600            	  3118:     moveq   #0,D3
                            	  3119: _anon_z01_75:
02:00030E2C 1943000C        	  3120:     move.b  D3,($000C,A4)
                            	  3121:     ; Set animation index = object type + 1.
                            	  3122:     ;
02:00030E30 7600            	  3123:     moveq   #0,D3
02:00030E32 41EC034F        	  3124:     lea     ($034F,A4),A0
02:00030E36 16302000        	  3125:     move.b  (A0,D2.W),D3
                            	  3126: ; Params:
                            	  3127: ; A: frame
                            	  3128: ; X: object index/cycle sprite index
                            	  3129: ; Y: object type
                            	  3130: ; [00]: object X
                            	  3131: ; [01]: object Y
                            	  3132: ; [0C]: mirrored
                            	  3133: ; [0F]: flip horizontally
                            	  3134: ;
                            	  3135: ; Note:
                            	  3136: ; If the object is not mirrored, then it's horizontally flippable.
                            	  3137: ;
                            	  3138: ; The animation index of most objects is (object type + 1),
                            	  3139: ; to make up for the fact that Link uses two animation indexes.
                            	  3140: ;
                            	  3141:     even
                            	  3142: DrawObjectWithType:
02:00030E3A 5203            	  3143:     addq.b  #1,D3
                            	  3144: ; Params:
                            	  3145: ; A: frame
                            	  3146: ; X: object index/cycle sprite index
                            	  3147: ; Y: animation index
                            	  3148: ; [00]: object X
                            	  3149: ; [01]: object Y
                            	  3150: ; [0C]: mirrored
                            	  3151: ; [0F]: flip horizontally
                            	  3152: ;
                            	  3153: ; Note:
                            	  3154: ; If the object is not mirrored, then it's horizontally flippable.
                            	  3155: ; But Link uses [0F] for flipping without checking [0C].
                            	  3156: ;
                            	  3157: ;
                            	  3158: ; [0D] holds frame.
                            	  3159:     even
                            	  3160: DrawObjectWithAnim:
02:00030E3C 1940000D        	  3161:     move.b  D0,($000D,A4)
02:00030E40 1943000E        	  3162:     move.b  D3,($000E,A4)
02:00030E44 19420008        	  3163:     move.b  D2,($0008,A4)
                            	  3164:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  3165:     ;
02:00030E48 7600            	  3166:     moveq   #0,D3
02:00030E4A 162C0341        	  3167:     move.b  ($0341,A4),D3
02:00030E4E 41F900030DF2    	  3168:     lea     (SpriteOffsets).l,A0
02:00030E54 10303000        	  3169:     move.b  (A0,D3.W),D0
02:00030E58 19400343        	  3170:     move.b  D0,($0343,A4)
02:00030E5C 41F900030DF3    	  3171:     lea     (SpriteOffsets+1).l,A0
02:00030E62 10303000        	  3172:     move.b  (A0,D3.W),D0
                            	  3173:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  3174:     ;
02:00030E66 4A02            	  3175:     cmpi.b  #$00,D2
02:00030E68 6702            	  3176:     beq.s  __far_z_01_0008
02:00030E6A 6008            	  3177:     jmp  DrawObjectWithAnimAndSpecificSprites
                            	  3178: __far_z_01_0008:
