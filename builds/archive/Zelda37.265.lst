02:0003A1CA 023C00EE        	  3514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A1CE 41EC03E4        	  3515:     lea     ($03E4,A4),A0
02:0003A1D2 12302000        	  3516:     move.b  (A0,D2.W),D1
02:0003A1D6 D101            	  3517:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003A1D8 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
                            	  3519:     ; If facing vertically, go draw mirrored.
                            	  3520:     ;
02:0003A1DA 41EC0098        	  3521:     lea     ($0098,A4),A0
02:0003A1DE 10302000        	  3522:     move.b  (A0,D2.W),D0
02:0003A1E2 0200000C        	  3523:     andi.b #$0C,D0
02:0003A1E6 660E            	  3524:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3525:     ; Else draw not mirrored.
                            	  3526:     ;
02:0003A1E8 101D            	  3527:     move.b  (A5)+,D0  ; PLA
02:0003A1EA 4EB900030E2A    	  3528:     jsr     DrawObjectNotMirrored
02:0003A1F0 4EF9000311A6    	  3529:     jmp     CheckMonsterCollisions
                            	  3530: 
                            	  3531:     even
