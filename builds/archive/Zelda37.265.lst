                            	  5096: _anon_z04_70:
                            	  5097:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5098:     ; 1. negate the distance
                            	  5099:     ; 2. add 8 to the instruction offset to access
                            	  5100:     ;    the opposite direction for the same wall
                            	  5101:     ;
02:0003ACD8 7600            	  5102:     moveq   #0,D3
02:0003ACDA 162C0098        	  5103:     move.b  ($0098,A4),D3
02:0003ACDE 122C0002        	  5104:     move.b  ($0002,A4),D1
02:0003ACE2 B601            	  5105:     cmp.b   D1,D3
02:0003ACE4 662A            	  5106:     bne  _anon_z04_71
02:0003ACE6 1B00            	  5107:     move.b  D0,-(A5)  ; PHA
02:0003ACE8 41EC0412        	  5108:     lea     ($0412,A4),A0
02:0003ACEC 10302000        	  5109:     move.b  (A0,D2.W),D0
02:0003ACF0 023C00EE        	  5110:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ACF4 123C0008        	  5111:     move.b  #$08,D1
02:0003ACF8 D101            	  5112:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003ACFA 41EC0412        	  5113:     lea     ($0412,A4),A0
02:0003ACFE 11802000        	  5114:     move.b  D0,(A0,D2.W)
02:0003AD02 101D            	  5115:     move.b  (A5)+,D0  ; PLA
02:0003AD04 4600            	  5116:     eori.b #$FF,D0
02:0003AD06 023C00EE        	  5117:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD0A 123C0001        	  5118:     move.b  #$01,D1
02:0003AD0E D101            	  5119:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5120: _anon_z04_71:
                            	  5121:     ; Add the distance and Link's minor coordinate to calculate
                            	  5122:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5123:     ; In general, the monster will be put in front of Link.
                            	  5124:     ;
02:0003AD10 023C00EE        	  5125:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD14 1214            	  5126:     move.b  ($0000,A4),D1
02:0003AD16 D101            	  5127:     addx.b  D1,D0   ; ADC $00
02:0003AD18 19400004        	  5128:     move.b  D0,($0004,A4)
                            	  5129:     ; By default, will return index 0 to choose the minimum value
                            	  5130:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5131:     ; if Link is at the wall with a smaller major coordinate.
                            	  5132:     ;
02:0003AD1C 7600            	  5133:     moveq   #0,D3
                            	  5134:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5135:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5136:     ; to access the block for the other direction along the same axis,
                            	  5137:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5138:     ;
02:0003AD1E 102C0001        	  5139:     move.b  ($0001,A4),D0
02:0003AD22 122C0003        	  5140:     move.b  ($0003,A4),D1
02:0003AD26 B001            	  5141:     cmp.b   D1,D0
02:0003AD28 671C            	  5142:     beq  _anon_z04_72
02:0003AD2A 41EC0412        	  5143:     lea     ($0412,A4),A0
02:0003AD2E 10302000        	  5144:     move.b  (A0,D2.W),D0
02:0003AD32 023C00EE        	  5145:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD36 123C0010        	  5146:     move.b  #$10,D1
02:0003AD3A D101            	  5147:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003AD3C 41EC0412        	  5148:     lea     ($0412,A4),A0
02:0003AD40 11802000        	  5149:     move.b  D0,(A0,D2.W)
02:0003AD44 5203            	  5150:     addq.b  #1,D3
