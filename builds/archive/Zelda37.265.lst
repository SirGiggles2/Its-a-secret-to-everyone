02:00044536 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:0004453A 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:00044540 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:00044544 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
