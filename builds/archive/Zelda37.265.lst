                            	  1799: _L_z05_InitMode_EnterRoom_Method2:
                            	  1800:     ; Enter method 2.
                            	  1801:     ; Room to room.
                            	  1802:     ;
                            	  1803:     ; Get the direction that the player is entering from.
                            	  1804:     ;
02:0003FF94 102C0098        	  1805:     move.b  ($0098,A4),D0
02:0003FF98 19400053        	  1806:     move.b  D0,($0053,A4)
02:0003FF9C 4EB900030920    	  1807:     jsr     GetOppositeDir
