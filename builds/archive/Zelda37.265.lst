                            	  1835: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1836:     ; Choose a distance to walk depending on the door you
                            	  1837:     ; come out of.
                            	  1838:     ;
                            	  1839:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1840:     ;
                            	  1841:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1842:     ; then you have shorter distance to cover. So use the
                            	  1843:     ; previous value as is to use indexes 0 and 1.
                            	  1844:     ;
                            	  1845:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1846:     ; to get out of the way of the wall or door.
                            	  1847:     ;
02:0003FFD4 610037F2        	  1848:     jsr     GetPassedDoorType
02:0003FFD8 02000007        	  1849:     andi.b #$07,D0
02:0003FFDC 6710            	  1850:     beq  _anon_z05_45
02:0003FFDE 0C000005        	  1851:     cmpi.b  #$05,D0
02:0003FFE2 670A            	  1852:     beq  _anon_z05_45
02:0003FFE4 0C000006        	  1853:     cmpi.b  #$06,D0
02:0003FFE8 6704            	  1854:     beq  _anon_z05_45
02:0003FFEA 5203            	  1855:     addq.b  #1,D3
02:0003FFEC 5203            	  1856:     addq.b  #1,D3
                            	  1857: _anon_z05_45:
02:0003FFEE 41F90003F94A    	  1858:     lea     (EnteringRoomRelativePositions).l,A0
02:0003FFF4 10303000        	  1859:     move.b  (A0,D3.W),D0
                            	  1860:     even
                            	  1861: _L_z05_InitMode_EnterRoom_PlaceObjects:
02:0003FFF8 19400394        	  1862:     move.b  D0,($0394,A4)
02:0003FFFC 6100375E        	  1863:     jsr     SetupObjRoomBounds
                            	  1864:     ; Set current object slot variable to $B, to be ready for the
                            	  1865:     ; first frame of mode 5. So, that it begins updating objects
                            	  1866:     ; at slot $B.
                            	  1867:     ;
02:00040000 740B            	  1868:     moveq   #11,D2
02:00040002 19420340        	  1869:     move.b  D2,($0340,A4)
                            	  1870: _anon_z05_46:
                            	  1871:     ; Reset common state of objects $B to 1.
