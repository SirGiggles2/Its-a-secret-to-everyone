                            	  7085: ChangePlayMapSquareOW:
02:0004325E 1002            	  7086:     move.b  D2,D0
02:00043260 1B00            	  7087:     move.b  D0,-(A5)  ; PHA
                            	  7088:     ; We're dealing with squares.
                            	  7089:     ; So, align the object's X coordinate with 16 pixels.
                            	  7090:     ;
02:00043262 10342070        	  7091:     move.b  ($70,A4,D2.W),D0
02:00043266 020000F0        	  7092:     andi.b #$F0,D0
                            	  7093:     ; Divide it by 4 to get the offset of the address of the column
                            	  7094:     ; in play area map.
                            	  7095:     ;
                            	  7096:     ; The calculation is: address offset = (X / 8) * 2
                            	  7097:     ; 8 for the width of the column; 2 for the width of the address
                            	  7098:     ;
02:0004326A E208            	  7099:     lsr.b  #1,D0   ; LSR A
02:0004326C E208            	  7100:     lsr.b  #1,D0   ; LSR A
02:0004326E 7400            	  7101:     moveq   #0,D2
02:00043270 1400            	  7102:     move.b  D0,D2
                            	  7103:     ; Store the address of the column in [00:01].
                            	  7104:     ;
02:00043272 41F90004941E    	  7105:     lea     (PlayAreaColumnAddrs).l,A0
02:00043278 10302000        	  7106:     move.b  (A0,D2.W),D0
02:0004327C 1880            	  7107:     move.b  D0,($0000,A4)
