02:0003FE7A 5302            	  1653:     subq.b  #1,D2
02:0003FE7C 6702            	  1654:     beq.s  __far_z_05_0024
02:0003FE7E 6058            	  1655:     jmp  InitMode4_Sub3
                            	  1656: __far_z_05_0024:
                            	  1657:     ; Submode 2.
                            	  1658:     ;
02:0003FE80 7600            	  1659:     moveq   #0,D3
02:0003FE82 162C00EB        	  1660:     move.b  ($00EB,A4),D3
02:0003FE86 61004280        	  1661:     jsr     IsDarkRoom_Bank5
02:0003FE8A 6702            	  1662:     beq.s  __far_z_05_0025
02:0003FE8C 6052            	  1663:     jmp  InitMode4_GoToSub0
                            	  1664: __far_z_05_0025:
                            	  1665:     ; This is a light room.
                            	  1666:     ; See if we have to brighten it after leaving a dark room.
                            	  1667:     ;
02:0003FE8E 102C0098        	  1668:     move.b  ($0098,A4),D0
02:0003FE92 610040BC        	  1669:     jsr     CalcNextRoomByDir
                            	  1670:     ; Subtract RoomId from next room ID that was calculated
                            	  1671:     ; to get room ID offset in that direction.
02:0003FE96 003C0011        	  1672:     ori     #$11,CCR  ; SEC: set C+X
02:0003FE9A 122C00EB        	  1673:     move.b  ($00EB,A4),D1
02:0003FE9E 0A3C0010        	  1674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FEA2 9101            	  1675:     subx.b  D1,D0   ; SBC RoomId
02:0003FEA4 0A3C0010        	  1676:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FEA8 4EB900030928    	  1677:     jsr     Negate
02:0003FEAE 023C00EE        	  1678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FEB2 122C00EB        	  1679:     move.b  ($00EB,A4),D1
02:0003FEB6 D101            	  1680:     addx.b  D1,D0   ; ADC RoomId
02:0003FEB8 7600            	  1681:     moveq   #0,D3
02:0003FEBA 1600            	  1682:     move.b  D0,D3
02:0003FEBC 6100424A        	  1683:     jsr     IsDarkRoom_Bank5
02:0003FEC0 6602            	  1684:     bne.s  __far_z_05_0026
02:0003FEC2 601C            	  1685:     jmp  InitMode4_GoToSub0
