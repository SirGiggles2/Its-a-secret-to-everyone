                            	  7720:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7721:     ; of the big map sheet.
                            	  7722:     ;
02:000439D6 0C000015        	  7723:     cmpi.b  #$15,D0
02:000439DA 6604            	  7724:     bne  _anon_z05_168
02:000439DC 7042            	  7725:     moveq   #66,D0
