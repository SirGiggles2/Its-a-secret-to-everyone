                            	 12098: _anon_z04_159:
02:0003E0E6 61000D9C        	 12099:     jsr     DecreaseObjectAngle
                            	 12100:     ; Load Patra's maneuver index.
                            	 12101:     ; It determines which counts of bits are looked up below.
                            	 12102:     ;
02:0003E0EA 7600            	 12103:     moveq   #0,D3
02:0003E0EC 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003E0F0 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003E0F4 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003E0F8 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003E0FC 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003E0FE 41F90003DFF0    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003E104 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003E108 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003E10A 41F90003DFF4    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003E110 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003E114 7600            	 12118:     moveq   #0,D3
02:0003E116 1600            	 12119:     move.b  D0,D3
02:0003E118 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003E11A 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003E11C 41F90003DFF2    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003E122 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003E126 7600            	 12131:     moveq   #0,D3
02:0003E128 1600            	 12132:     move.b  D0,D3
