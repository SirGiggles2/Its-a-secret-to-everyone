                            	  4007: PondFairy_MoveHearts:
                            	  4008:     ; Loop over each heart from object slot 2 to 9.
                            	  4009:     ;
                            	  4010:     ; Even though they are not standalone objects, their info
                            	  4011:     ; is stored in those object slots.
                            	  4012:     ;
02:0003A4C8 7402            	  4013:     moveq   #2,D2
                            	  4014:     even
                            	  4015: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4016:     ; If the current heart's state <> 0, then go move it.
                            	  4017:     ; Else we have to wait for it to come out at the right time.
                            	  4018:     ;
02:0003A4CA 41EC00AC        	  4019:     lea     ($00AC,A4),A0
02:0003A4CE 10302000        	  4020:     move.b  (A0,D2.W),D0
02:0003A4D2 667C            	  4021:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4022:     ; The current heart's state = 0.
                            	  4023:     ;
                            	  4024:     ; If object slot = 2, then go make it appear. This is the first
                            	  4025:     ; heart to show up.
                            	  4026:     ;
02:0003A4D4 0C020002        	  4027:     cmpi.b  #$02,D2
02:0003A4D8 6732            	  4028:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4029:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4030:     ; go start over.
                            	  4031:     ;
                            	  4032:     ; TODO:
                            	  4033:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4034:     ;
02:0003A4DA 102C00AE        	  4035:     move.b  ($00AE,A4),D0
02:0003A4DE 67EA            	  4036:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4037:     ; Look up the starting angle of this heart with the index
                            	  4038:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4039:     ; then loop again.
                            	  4040:     ;
02:0003A4E0 1002            	  4041:     move.b  D2,D0
02:0003A4E2 003C0011        	  4042:     ori     #$11,CCR  ; SEC: set C+X
02:0003A4E6 123C0003        	  4043:     move.b  #$03,D1
02:0003A4EA 0A3C0010        	  4044:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A4EE 9101            	  4045:     subx.b  D1,D0   ; SBC #$03
02:0003A4F0 0A3C0010        	  4046:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A4F4 7600            	  4047:     moveq   #0,D3
02:0003A4F6 1600            	  4048:     move.b  D0,D3
02:0003A4F8 102C0396        	  4049:     move.b  ($0396,A4),D0
02:0003A4FC 41F90003A4C0    	  4050:     lea     (PondHeartStartAngles).l,A0
02:0003A502 12303000        	  4051:     move.b  (A0,D3.W),D1
02:0003A506 B001            	  4052:     cmp.b   D1,D0
02:0003A508 66000086        	  4053:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4054:     even
                            	  4055: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  4056:     ; Set up this heart. Set its state to 1.
                            	  4057:     ;
02:0003A50C 41EC00AC        	  4058:     lea     ($00AC,A4),A0
02:0003A510 52302000        	  4059:     addq.b  #1,(A0,D2.W)
                            	  4060:     ; TODO: ?
                            	  4061:     ;
02:0003A514 103C0080        	  4062:     move.b  #$80,D0
02:0003A518 41EC0098        	  4063:     lea     ($0098,A4),A0
02:0003A51C 11802000        	  4064:     move.b  D0,(A0,D2.W)
                            	  4065:     ; Starting angle $18 (N).
                            	  4066:     ;
02:0003A520 7018            	  4067:     moveq   #24,D0
02:0003A522 41EC0394        	  4068:     lea     ($0394,A4),A0
02:0003A526 11802000        	  4069:     move.b  D0,(A0,D2.W)
                            	  4070:     ; This heart is right above the fairy. Set its X the same as the fairy's.
