02:0003DE8C 122C0002        	 11792:     move.b  ($0002,A4),D1
02:0003DE90 C200            	 11793:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE92 6712            	 11794:     beq  _L_z04_Lamnola_Move_Left
02:0003DE94 10342070        	 11795:     move.b  ($70,A4,D2.W),D0
