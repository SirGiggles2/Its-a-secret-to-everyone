02:0003D040 0A3C0010        	  9885:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D044 9101            	  9886:     subx.b  D1,D0   ; SBC #$10
02:0003D046 0A3C0010        	  9887:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D04A 19802070        	  9888:     move.b  D0,($70,A4,D2.W)
                            	  9889:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	  9890:     ; from left to right, indexed by [0F].
