                            	  1211:     ; Second, load the vertical direction into [0F].
                            	  1212:     ;
02:000391B6 41EC0437        	  1213:     lea     ($0437,A4),A0
02:000391BA 10302000        	  1214:     move.b  (A0,D2.W),D0
02:000391BE 1940000F        	  1215:     move.b  D0,($000F,A4)
                            	  1216:     ; Load the vertical q-speed and position fraction,
                            	  1217:     ; move, then save the position fraction.
                            	  1218:     ;
02:000391C2 41EC0444        	  1219:     lea     ($0444,A4),A0
02:000391C6 10302000        	  1220:     move.b  (A0,D2.W),D0
02:000391CA 7600            	  1221:     moveq   #0,D3
02:000391CC 41EC045E        	  1222:     lea     ($045E,A4),A0
02:000391D0 16302000        	  1223:     move.b  (A0,D2.W),D3
