                            	  1725: ; C: 1 if blocked
                            	  1726: ;
                            	  1727: ; Set the speed to maximum.
                            	  1728: ;
                            	  1729:     even
                            	  1730: Gel_MoveSplitting:
02:00039560 103C00FF        	  1731:     move.b  #$FF,D0
02:00039564 41EC03BC        	  1732:     lea     ($03BC,A4),A0
02:00039568 11802000        	  1733:     move.b  D0,(A0,D2.W)
                            	  1734:     ; Set moving direction to facing direction.
                            	  1735:     ;
02:0003956C 41EC0098        	  1736:     lea     ($0098,A4),A0
02:00039570 10302000        	  1737:     move.b  (A0,D2.W),D0
02:00039574 1940000F        	  1738:     move.b  D0,($000F,A4)
                            	  1739:     ; If at a tile boundary, then check for a tile collision.
                            	  1740:     ;
02:00039578 41EC0394        	  1741:     lea     ($0394,A4),A0
02:0003957C 10302000        	  1742:     move.b  (A0,D2.W),D0
02:00039580 660E            	  1743:     bne  _L_z04_Gel_MoveSplitting_CheckRoomBoundary
02:00039582 4EB90004A458    	  1744:     jsr     GetCollidingTileMoving
                            	  1745:     ; If blocked by a tile, then return C=1.
                            	  1746:     ;
02:00039588 122C034A        	  1747:     move.b  ($034A,A4),D1
02:0003958C B001            	  1748:     cmp.b   D1,D0
02:0003958E 642C            	  1749:     bcc  _L_z04_Gel_MoveSplitting_Exit
                            	  1750:     even
                            	  1751: _L_z04_Gel_MoveSplitting_CheckRoomBoundary:
                            	  1752:     ; If blocked by the room boundary, then return C=1.
                            	  1753:     ;
02:00039590 4EB900030910    	  1754:     jsr     BoundByRoom
02:00039596 003C0011        	  1755:     ori     #$11,CCR  ; SEC: set C+X
02:0003959A 6720            	  1756:     beq  _L_z04_Gel_MoveSplitting_Exit
                            	  1757:     ; Move.
                            	  1758:     ;
02:0003959C 4EB90004A7AC    	  1759:     jsr     MoveObject
                            	  1760:     ; Mask the grid offset with $F (to a square length),
                            	  1761:     ; and return C=0.
                            	  1762:     ;
02:000395A2 41EC0394        	  1763:     lea     ($0394,A4),A0
02:000395A6 10302000        	  1764:     move.b  (A0,D2.W),D0
02:000395AA 0200000F        	  1765:     andi.b #$0F,D0
02:000395AE 023C00EE        	  1766:     andi    #$EE,CCR  ; CLC: clear C+X
02:000395B2 6608            	  1767:     bne  _L_z04_Gel_MoveSplitting_Exit
02:000395B4 41EC0394        	  1768:     lea     ($0394,A4),A0
02:000395B8 11802000        	  1769:     move.b  D0,(A0,D2.W)
                            	  1770:     even
                            	  1771: _L_z04_Gel_MoveSplitting_Exit:
02:000395BC 4E75            	  1772:     rts
                            	  1773: 
                            	  1774:     even
