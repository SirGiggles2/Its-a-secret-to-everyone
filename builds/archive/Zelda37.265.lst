02:00030664 9101            	  2057:     subx.b  D1,D0   ; SBC ObjY,X
02:00030666 0A3C0010        	  2058:     eori    #$10,CCR  ; restore X = 6502 C
02:0003066A 610002B8        	  2059:     jsr     Abs
