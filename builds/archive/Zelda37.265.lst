02:0003D036 1B00            	  9879:     move.b  D0,-(A5)  ; PHA
                            	  9880:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  9881:     ; on the left side.
                            	  9882:     ;
02:0003D038 003C0011        	  9883:     ori     #$11,CCR  ; SEC: set C+X
