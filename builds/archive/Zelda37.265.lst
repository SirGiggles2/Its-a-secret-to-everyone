02:0003E0D6 41EC034F        	 12093:     lea     ($034F,A4),A0
02:0003E0DA 16302000        	 12094:     move.b  (A0,D2.W),D3
02:0003E0DE 0C030025        	 12095:     cmpi.b  #$25,D3
02:0003E0E2 6702            	 12096:     beq  _anon_z04_159
