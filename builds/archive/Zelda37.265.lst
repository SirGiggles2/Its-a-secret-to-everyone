                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:000426EC 102C0054        	  5844:     move.b  ($0054,A4),D0
02:000426F0 0C000004        	  5845:     cmpi.b  #$04,D0
02:000426F4 6626            	  5846:     bne  _anon_z05_123
02:000426F6 7400            	  5847:     moveq   #0,D2
02:000426F8 142C0009        	  5848:     move.b  ($0009,A4),D2
02:000426FC 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:00042700 102C0055        	  5850:     move.b  ($0055,A4),D0
02:00042704 0A00000F        	  5851:     eori.b #$0F,D0
02:00042708 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:0004270C C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004270E 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:00042712 7000            	  5859:     moveq   #0,D0
02:00042714 19400054        	  5860:     move.b  D0,($0054,A4)
02:00042718 6000FCD4        	  5861:     jmp     LayOutDoors
