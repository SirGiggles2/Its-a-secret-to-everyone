02:000356EE 6518            	  4818:     bcs  _L_z02_UpdateMode13WinGame_Sub1_Exit
02:000356F0 6100FF5A        	  4819:     jsr     DrawLinkZeldaTriforces
                            	  4820:     ; Once in submode 2, only delay, instead of emitting characters.
