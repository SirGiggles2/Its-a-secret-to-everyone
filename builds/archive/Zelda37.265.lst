02:0003067C 12342070        	  2064:     move.b  ($70,A4,D2.W),D1
02:00030680 0A3C0010        	  2065:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030684 9101            	  2066:     subx.b  D1,D0   ; SBC ObjX,X
02:00030686 0A3C0010        	  2067:     eori    #$10,CCR  ; restore X = 6502 C
02:0003068A 61000298        	  2068:     jsr     Abs
