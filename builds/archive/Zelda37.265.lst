02:00040FB0 41F900040F40    	  4062:     lea     (DoorwayBoundsMinOver).l,A0
02:00040FB6 12303000        	  4063:     move.b  (A0,D3.W),D1
02:00040FBA B001            	  4064:     cmp.b   D1,D0
02:00040FBC 651C            	  4065:     bcs  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:00040FBE 41F900040F44    	  4066:     lea     (DoorwayBoundsMaxOver).l,A0
02:00040FC4 12303000        	  4067:     move.b  (A0,D3.W),D1
02:00040FC8 B001            	  4068:     cmp.b   D1,D0
