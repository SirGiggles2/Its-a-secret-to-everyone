02:0003E148 10302000        	 12148:     move.b  (A0,D2.W),D0
02:0003E14C 6704            	 12149:     beq  _L_z04_PatraChild_State1_Exit
02:0003E14E 6100FA94        	 12150:     jsr     SetDeadDummyObjType
                            	 12151:     even
