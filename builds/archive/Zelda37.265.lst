02:000357A4 41EC0302        	  4884:     lea     ($0302,A4),A0
02:000357A8 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:000357AC 5303            	  4886:     subq.b  #1,D3
02:000357AE 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:000357B0 7600            	  4891:     moveq   #0,D3
02:000357B2 162C0413        	  4892:     move.b  ($0413,A4),D3
02:000357B6 41F900035750    	  4893:     lea     (PeaceText).l,A0
02:000357BC 10303000        	  4894:     move.b  (A0,D3.W),D0
02:000357C0 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:000357C4 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000357C6 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:000357CA 0C000024        	  4901:     cmpi.b  #$24,D0
02:000357CE 6706            	  4902:     beq  _anon_z02_36
02:000357D0 7010            	  4903:     moveq   #16,D0
02:000357D2 19400604        	  4904:     move.b  D0,($0604,A4)
                            	  4905: _anon_z02_36:
                            	  4906:     ; Point to the next character in the string.
                            	  4907:     ;
02:000357D6 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:000357DA 41F90003571C    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000357E0 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000357E4 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
                            	  4916:     ; increment the high address.
