02:00049B9A 10302000        	  2363:     move.b  (A0,D2.W),D0
02:00049B9E 19400002        	  2364:     move.b  D0,($0002,A4)
02:00049BA2 4EB900030BCC    	  2365:     jsr     MapScreenPosToPpuAddr
02:00049BA8 7400            	  2366:     moveq   #0,D2
02:00049BAA 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:00049BAE 1014            	  2375:     move.b  ($0000,A4),D0
02:00049BB0 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00049BB4 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:00049BB8 41EC0307        	  2378:     lea     ($0307,A4),A0
02:00049BBC 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:00049BC0 102C0001        	  2383:     move.b  ($0001,A4),D0
02:00049BC4 41EC0303        	  2384:     lea     ($0303,A4),A0
02:00049BC8 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:00049BCC 41EC0308        	  2386:     lea     ($0308,A4),A0
02:00049BD0 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:00049BD4 41EC0308        	  2388:     lea     ($0308,A4),A0
02:00049BD8 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:00049BDC 102C0005        	  2392:     move.b  ($0005,A4),D0
02:00049BE0 41EC0305        	  2393:     lea     ($0305,A4),A0
02:00049BE4 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:00049BE8 41EC0306        	  2395:     lea     ($0306,A4),A0
02:00049BEC 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:00049BF0 41EC030A        	  2397:     lea     ($030A,A4),A0
02:00049BF4 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:00049BF8 41EC030B        	  2399:     lea     ($030B,A4),A0
02:00049BFC 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
                            	  2403:     ; Here is an example result of this manipulation:
                            	  2404:     ;   record 1: $70, $71
                            	  2405:     ;   record 2: $72, $73
                            	  2406:     ;
02:00049C00 0C000046        	  2407:     cmpi.b  #$46,D0
02:00049C04 6530            	  2408:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00049C06 0C0000F3        	  2409:     cmpi.b  #$F3,D0
02:00049C0A 642A            	  2410:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00049C0C 023C00EE        	  2411:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049C10 123C0002        	  2412:     move.b  #$02,D1
02:00049C14 D101            	  2413:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049C16 41EC030A        	  2414:     lea     ($030A,A4),A0
02:00049C1A 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:00049C1E 41EC030B        	  2416:     lea     ($030B,A4),A0
02:00049C22 11802000        	  2417:     move.b  D0,(A0,D2.W)
02:00049C26 41EC0306        	  2418:     lea     ($0306,A4),A0
02:00049C2A 52302000        	  2419:     addq.b  #1,(A0,D2.W)
02:00049C2E 41EC030B        	  2420:     lea     ($030B,A4),A0
02:00049C32 52302000        	  2421:     addq.b  #1,(A0,D2.W)
