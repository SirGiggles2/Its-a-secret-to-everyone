                            	  4808: UpdateMode13WinGame_Sub1:
02:000356DA 102C004D        	  4809:     move.b  ($004D,A4),D0
02:000356DE 672A            	  4810:     beq  _L_z02_UpdateMode13WinGame_Sub1_AdvanceSubmode
02:000356E0 4EB900049712    	  4811:     jsr     HideAllSprites
                            	  4812:     ; Characters stop emitting when the long timer is $10.
                            	  4813:     ; So, keep showing Link and Zelda until it reaches 4.
                            	  4814:     ; Then hide them and wait until it reaches 0.
                            	  4815:     ;
02:000356E6 102C004D        	  4816:     move.b  ($004D,A4),D0
