02:0003B8D2 0A000003        	  6695:     eori.b #$03,D0
02:0003B8D6 19400003        	  6696:     move.b  D0,($0003,A4)
02:0003B8DA 7600            	  6697:     moveq   #0,D3
02:0003B8DC 162C000A        	  6698:     move.b  ($000A,A4),D3
