                            	 12612:     ; Else move 3 out of every 4 frames.
                            	 12613:     ;
                            	 12614:     ; This makes pieces spread out in somewhat of a circle,
                            	 12615:     ; by making the pieces at cardinal directions move at
                            	 12616:     ; full speed while the diagonal ones move a little slower.
                            	 12617:     ;
02:0003E466 0C020005        	 12618:     cmpi.b  #$05,D2
02:0003E46A 6510            	 12619:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003E46C 0C020007        	 12620:     cmpi.b  #$07,D2
02:0003E470 670A            	 12621:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003E472 102C0015        	 12622:     move.b  ($0015,A4),D0
02:0003E476 02000003        	 12623:     andi.b #$03,D0
02:0003E47A 6704            	 12624:     beq  _anon_z04_164
                            	 12625:     even
                            	 12626: _L_z04_Ganon_DrawBurst_Move:
02:0003E47C 6100E036        	 12627:     jsr     BlueWizzrobe_Move
                            	 12628: _anon_z04_164:
02:0003E480 4EB90004BB24    	 12629:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12630:     ; The frame counter will make the sprite flash.
                            	 12631:     ; The array has the horizontal and vertical flipping attributes.
                            	 12632:     ; Combine them into [03].
                            	 12633:     ;
02:0003E486 102C0015        	 12634:     move.b  ($0015,A4),D0
02:0003E48A 02000003        	 12635:     andi.b #$03,D0
02:0003E48E 41F90003E35E    	 12636:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003E494 12302000        	 12637:     move.b  (A0,D2.W),D1
02:0003E498 8001            	 12638:     or.b  D1,D0
02:0003E49A 19400003        	 12639:     move.b  D0,($0003,A4)
02:0003E49E 41F90003E368    	 12640:     lea     (GanonBurstTiles).l,A0
02:0003E4A4 10302000        	 12641:     move.b  (A0,D2.W),D0
02:0003E4A8 4EB900031126    	 12642:     jsr     Anim_WriteSprite
                            	 12643:     ; Bottom of the loop.
                            	 12644:     ; Increment object slot while <= 9.
                            	 12645:     ;
02:0003E4AE 5202            	 12646:     addq.b  #1,D2
02:0003E4B0 0C02000A        	 12647:     cmpi.b  #$0A,D2
02:0003E4B4 65AC            	 12648:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12649:     ; Restore the object index.
                            	 12650:     ;
02:0003E4B6 101D            	 12651:     move.b  (A5)+,D0  ; PLA
02:0003E4B8 19400340        	 12652:     move.b  D0,($0340,A4)
02:0003E4BC 0A3C0001        	 12653:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003E4C0 4E75            	 12654:     rts
                            	 12655: 
                            	 12656: ; Returns:
                            	 12657: ; [00]: X coordinate
                            	 12658: ;
                            	 12659:     even
                            	 12660: Ganon_GetCurCloudLeft:
