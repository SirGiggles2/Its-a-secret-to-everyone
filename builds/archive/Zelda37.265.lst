                            	  9334: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9335:     ; At this point, we have a hand that just died.
                            	  9336:     ;
                            	  9337:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9338:     ;
02:0003CC4A 7603            	  9339:     moveq   #3,D3
                            	  9340:     ; Count how many are allocated.
                            	  9341:     ; This includes the current dead one, and the other living ones.
                            	  9342:     ; Store the count in [00].
                            	  9343:     ;
02:0003CC4C 7000            	  9344:     moveq   #0,D0
02:0003CC4E 1880            	  9345:     move.b  D0,($0000,A4)
                            	  9346:     even
