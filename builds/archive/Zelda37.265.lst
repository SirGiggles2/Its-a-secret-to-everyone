02:0003E69A 41EC0302        	 12914:     lea     ($0302,A4),A0
02:0003E69E 11802000        	 12915:     move.b  D0,(A0,D2.W)
02:0003E6A2 5202            	 12916:     addq.b  #1,D2
02:0003E6A4 5203            	 12917:     addq.b  #1,D3
02:0003E6A6 0C030008        	 12918:     cmpi.b  #$08,D3
02:0003E6AA 66E4            	 12919:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003E6AC 19420301        	 12920:     move.b  D2,($0301,A4)
02:0003E6B0 101D            	 12921:     move.b  (A5)+,D0  ; PLA
02:0003E6B2 7600            	 12922:     moveq   #0,D3
02:0003E6B4 1600            	 12923:     move.b  D0,D3
                            	 12924:     ; Overwrite the last 3 colors in the record, with the ones
                            	 12925:     ; ending at the index passed in.
                            	 12926:     ;
02:0003E6B6 7402            	 12927:     moveq   #2,D2
                            	 12928:     even
