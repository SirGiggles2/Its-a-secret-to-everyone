02:0003BE30 1980203D        	  7491:     move.b  D0,($3D,A4,D2.W)
02:0003BE34 7008            	  7492:     moveq   #8,D0
02:0003BE36 4EB90004BB1E    	  7493:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7494:     ; If facing left, then enable horizontal flipping.
                            	  7495:     ;
02:0003BE3C 41EC0098        	  7496:     lea     ($0098,A4),A0
02:0003BE40 10302000        	  7497:     move.b  (A0,D2.W),D0
02:0003BE44 0C000002        	  7498:     cmpi.b  #$02,D0
02:0003BE48 6604            	  7499:     bne  _anon_z04_94
02:0003BE4A 522C000F        	  7500:     addq.b  #1,($000F,A4)
                            	  7501: _anon_z04_94:
                            	  7502:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7503:     ; This is the base frame image.
                            	  7504:     ;
02:0003BE4E E208            	  7505:     lsr.b  #1,D0   ; LSR A
02:0003BE50 E208            	  7506:     lsr.b  #1,D0   ; LSR A
                            	  7507:     ; If movement frame = 1, add 3 to frame image to access
                            	  7508:     ; the second animation frame's images.
                            	  7509:     ;
02:0003BE52 7600            	  7510:     moveq   #0,D3
02:0003BE54 41EC03E4        	  7511:     lea     ($03E4,A4),A0
02:0003BE58 16302000        	  7512:     move.b  (A0,D2.W),D3
02:0003BE5C 671E            	  7513:     beq  _anon_z04_95
02:0003BE5E 023C00EE        	  7514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE62 123C0003        	  7515:     move.b  #$03,D1
02:0003BE66 D101            	  7516:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7517:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7518:     ;
                            	  7519:     ; Down has two frame images, but up only has one. By flipping
                            	  7520:     ; horizontally, you get two frame images.
                            	  7521:     ;
02:0003BE68 7600            	  7522:     moveq   #0,D3
02:0003BE6A 41EC0098        	  7523:     lea     ($0098,A4),A0
02:0003BE6E 16302000        	  7524:     move.b  (A0,D2.W),D3
02:0003BE72 0C030008        	  7525:     cmpi.b  #$08,D3
02:0003BE76 6604            	  7526:     bne  _anon_z04_95
02:0003BE78 522C000F        	  7527:     addq.b  #1,($000F,A4)
                            	  7528: _anon_z04_95:
02:0003BE7C 4EB900030E2A    	  7529:     jsr     DrawObjectNotMirrored
02:0003BE82 0A3C0001        	  7530:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
