02:0004004C 41F900FF697E    	  1894:     lea     (NES_SRAM+$097E).l,A0
02:00040052 10303000        	  1895:     move.b  (A0,D3.W),D0
02:00040056 1B00            	  1896:     move.b  D0,-(A5)  ; PHA
