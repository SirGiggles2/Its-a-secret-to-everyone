                            	  7748: __far_z_07_0125:
                            	  7749:     ; So, every 8 frames:
                            	  7750:     ; 1. Increment the secret color cycle count.
                            	  7751:     ; 2. Change the water palette.
                            	  7752:     ;
                            	  7753:     ; But when the count = $B, go reveal the stairs.
                            	  7754:     ;
