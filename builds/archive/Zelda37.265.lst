02:000358BA 0C0000F0        	  5025:     cmpi.b  #$F0,D0
02:000358BE 7000            	  5026:     moveq   #0,D0
02:000358C0 6508            	  5027:     bcs  _anon_z02_39
02:000358C2 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:000358C6 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
