02:00040E06 000438B8        	  3821:     dc.l    InitModeB_Sub5_FillTileAttrsAndTransferTopHalf   ; jump table entry (32-bit for _m68k_tablejump)
02:00040E0A 000438C2        	  3822:     dc.l    InitModeAOrB_TransferBottomHalfAttrs   ; jump table entry (32-bit for _m68k_tablejump)
02:00040E0E 000307EE        	  3823:     dc.l    InitModeB_EnterCave_Bank5   ; jump table entry (32-bit for _m68k_tablejump)
02:00040E12 000438D4        	  3824:     dc.l    InitMode_WalkCave   ; jump table entry (32-bit for _m68k_tablejump)
