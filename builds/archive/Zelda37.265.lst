                            	  5715: __far_z_05_0076:
                            	  5716:     ; Turn the door command into the desired open or closed state
                            	  5717:     ; to store in [08].
                            	  5718:     ;
                            	  5719:     ; cmd:  7 6 3 2 
                            	  5720:     ; [08]: 2 0 0 0
                            	  5721:     ;
                            	  5722:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5723:     ; commands intended to be used.
                            	  5724:     ;
                            	  5725:     ; 3 is the end state of 2: close
                            	  5726:     ; 7 is the end state of 6: open
                            	  5727:     ;
02:0004261A 02000007        	  5728:     andi.b #$07,D0
02:0004261E 7601            	  5729:     moveq   #1,D3
02:00042620 19430002        	  5730:     move.b  D3,($0002,A4)
02:00042624 122C0002        	  5731:     move.b  ($0002,A4),D1
02:00042628 C200            	  5732:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0004262A 6702            	  5733:     beq  _anon_z05_118
02:0004262C E208            	  5734:     lsr.b  #1,D0   ; LSR A
                            	  5735: _anon_z05_118:
02:0004262E 0C000002        	  5736:     cmpi.b  #$02,D0
02:00042632 6606            	  5737:     bne  _anon_z05_119
                            	  5738:     ; Command 2 sets Link's timer to $30.
                            	  5739:     ;
02:00042634 7630            	  5740:     moveq   #48,D3
02:00042636 19430028        	  5741:     move.b  D3,($0028,A4)
                            	  5742: _anon_z05_119:
02:0004263A 02000003        	  5743:     andi.b #$03,D0
02:0004263E 003C0011        	  5744:     ori     #$11,CCR  ; SEC: set C+X
02:00042642 123C0001        	  5745:     move.b  #$01,D1
02:00042646 0A3C0010        	  5746:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004264A 9101            	  5747:     subx.b  D1,D0   ; SBC #$01
02:0004264C 0A3C0010        	  5748:     eori    #$10,CCR  ; restore X = 6502 C
02:00042650 02000002        	  5749:     andi.b #$02,D0
02:00042654 19400008        	  5750:     move.b  D0,($0008,A4)
                            	  5751:     ; The command to close a key door or bombable wall does not
                            	  5752:     ; do anything.
                            	  5753:     ;
