02:0003DE6C 122C0098        	 11762:     move.b  ($0098,A4),D1
02:0003DE70 C200            	 11763:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE72 6604            	 11764:     bne  _anon_z04_155
                            	 11765:     even
