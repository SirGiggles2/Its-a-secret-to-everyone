                            	  3821: UpdateArmos:
02:0003A3AA 6100E838        	  3822:     jsr     UpdateGoriya
                            	  3823:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3824:     ;
02:0003A3AE 41EC00C0        	  3825:     lea     ($00C0,A4),A0
02:0003A3B2 10302000        	  3826:     move.b  (A0,D2.W),D0
02:0003A3B6 6702            	  3827:     beq.s  __far_z_04_0033
02:0003A3B8 602A            	  3828:     jmp  DrawArmosAndCheckCollisions
                            	  3829: __far_z_04_0033:
                            	  3830:     ; Animate.
                            	  3831:     ;
                            	  3832:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3833:     ; then only go draw.
                            	  3834:     ;
02:0003A3BA 41EC03D0        	  3835:     lea     ($03D0,A4),A0
02:0003A3BE 53302000        	  3836:     subq.b  #1,(A0,D2.W)
02:0003A3C2 6702            	  3837:     beq.s  __far_z_04_0034
02:0003A3C4 601E            	  3838:     jmp  DrawArmosAndCheckCollisions
                            	  3839: __far_z_04_0034:
                            	  3840:     ; Armos animation frames last 6 screen frames.
                            	  3841:     ;
02:0003A3C6 7006            	  3842:     moveq   #6,D0
02:0003A3C8 41EC03D0        	  3843:     lea     ($03D0,A4),A0
02:0003A3CC 11802000        	  3844:     move.b  D0,(A0,D2.W)
                            	  3845:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3846:     ; change the position of the shield. To keep fixed it in place,
                            	  3847:     ; there are separate frame images for each animation frame.
                            	  3848:     ;
                            	  3849:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3850:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3851:     ;
                            	  3852:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3853:     ; Then choose the direction at the point of drawing below.
                            	  3854:     ;
02:0003A3D0 41EC03E4        	  3855:     lea     ($03E4,A4),A0
02:0003A3D4 10302000        	  3856:     move.b  (A0,D2.W),D0
02:0003A3D8 0A000002        	  3857:     eori.b #$02,D0
02:0003A3DC 41EC03E4        	  3858:     lea     ($03E4,A4),A0
02:0003A3E0 11802000        	  3859:     move.b  D0,(A0,D2.W)
                            	  3860:     even
                            	  3861: DrawArmosAndCheckCollisions:
02:0003A3E4 4EB90004BB24    	  3862:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003A3EA 7600            	  3863:     moveq   #0,D3
02:0003A3EC 41EC0098        	  3864:     lea     ($0098,A4),A0
02:0003A3F0 16302000        	  3865:     move.b  (A0,D2.W),D3
                            	  3866:     ; If facing up, then use the second frame image in the set ("back").
                            	  3867:     ; Else use the second.
                            	  3868:     ;
02:0003A3F4 0C030008        	  3869:     cmpi.b  #$08,D3
02:0003A3F8 6602            	  3870:     bne  _anon_z04_54
02:0003A3FA 7001            	  3871:     moveq   #1,D0
                            	  3872: _anon_z04_54:
02:0003A3FC 023C00EE        	  3873:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A400 41EC03E4        	  3874:     lea     ($03E4,A4),A0
02:0003A404 12302000        	  3875:     move.b  (A0,D2.W),D1
02:0003A408 D101            	  3876:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003A40A 4EB900030E2A    	  3877:     jsr     DrawObjectNotMirrored
                            	  3878:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3879:     ; but not with weapons.
                            	  3880:     ;
02:0003A410 10342028        	  3881:     move.b  ($28,A4,D2.W),D0
02:0003A414 661C            	  3882:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3883:     ; Else check for all collisions.
                            	  3884:     ;
02:0003A416 4EB9000311A6    	  3885:     jsr     CheckMonsterCollisions
                            	  3886:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3887:     ;
02:0003A41C 41EC0405        	  3888:     lea     ($0405,A4),A0
02:0003A420 10302000        	  3889:     move.b  (A0,D2.W),D0
02:0003A424 670A            	  3890:     beq  _anon_z04_55
02:0003A426 705D            	  3891:     moveq   #93,D0
02:0003A428 41EC034F        	  3892:     lea     ($034F,A4),A0
02:0003A42C 11802000        	  3893:     move.b  D0,(A0,D2.W)
                            	  3894: _anon_z04_55:
02:0003A430 4E75            	  3895:     rts
                            	  3896: 
