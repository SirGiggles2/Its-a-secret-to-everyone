02:0003C0E2 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C0E6 123C0008        	  7823:     move.b  #$08,D1
02:0003C0EA D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
