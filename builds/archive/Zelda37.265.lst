02:0002BFC8 08000008        	  2393:     btst    #8,D0
02:0002BFCC 670A            	  2394:     beq.s   .cc_iqsm
02:0002BFCE 003C0001        	  2395:     ori     #$01,CCR
02:0002BFD2 0A3C0001        	  2396:     eori    #$01,CCR
02:0002BFD6 4E75            	  2397:     rts
                            	  2398: .cc_iqsm:
02:0002BFD8 023C00FE        	  2399:     andi    #$FE,CCR
02:0002BFDC 0A3C0001        	  2400:     eori    #$01,CCR
02:0002BFE0 4E75            	  2401:     rts
