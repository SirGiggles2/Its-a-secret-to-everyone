                            	  6780: UpdateDodongoState0_Move:
                            	  6781:     ; If facing left, then push X offset 0 on the stack.
                            	  6782:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6783:     ;
                            	  6784:     ; We would like to use one set of coordinates only.
                            	  6785:     ; But movement would break down, if we did; because
                            	  6786:     ; Dodongo is so long.
                            	  6787:     ;
                            	  6788:     ; So, when not facing left, we temporarily shift the
                            	  6789:     ; X coordinate to be closer to the other side of the monster.
                            	  6790:     ;
02:0003B97A 7600            	  6791:     moveq   #0,D3
02:0003B97C 41EC0098        	  6792:     lea     ($0098,A4),A0
02:0003B980 10302000        	  6793:     move.b  (A0,D2.W),D0
02:0003B984 0200000D        	  6794:     andi.b #$0D,D0
02:0003B988 6716            	  6795:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003B98A 10342070        	  6796:     move.b  ($70,A4,D2.W),D0
02:0003B98E 023C00EE        	  6797:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B992 123C0010        	  6798:     move.b  #$10,D1
02:0003B996 D101            	  6799:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003B998 19802070        	  6800:     move.b  D0,($70,A4,D2.W)
02:0003B99C 163C00F0        	  6801:     move.b  #$F0,D3
                            	  6802:     even
                            	  6803: _L_z04_UpdateDodongoState0_Move_Move:
02:0003B9A0 1003            	  6804:     move.b  D3,D0
