02:00040024 1980203D        	  1880:     move.b  D0,($3D,A4,D2.W)
02:00040028 41EC03D0        	  1881:     lea     ($03D0,A4),A0
02:0004002C 52302000        	  1882:     addq.b  #1,(A0,D2.W)
02:00040030 41EC0405        	  1883:     lea     ($0405,A4),A0
02:00040034 52302000        	  1884:     addq.b  #1,(A0,D2.W)
02:00040038 7020            	  1885:     moveq   #32,D0
02:0004003A 41EC03BC        	  1886:     lea     ($03BC,A4),A0
02:0004003E 11802000        	  1887:     move.b  D0,(A0,D2.W)
