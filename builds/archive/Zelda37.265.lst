02:0004ADB6 19400513        	  4962:     move.b  D0,($0513,A4)
02:0004ADBA 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:0004ADBC 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:0004ADC0 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:0004ADC4 10302000        	  4972:     move.b  (A0,D2.W),D0
02:0004ADC8 0C000021        	  4973:     cmpi.b  #$21,D0
02:0004ADCC 6702            	  4974:     beq.s  __far_z_07_0076
02:0004ADCE 6038            	  4975:     jmp  DeactivateLinkShot
