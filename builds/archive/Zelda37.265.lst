02:0003CC74 7010            	  9375:     moveq   #16,D0
02:0003CC76 1940040A        	  9376:     move.b  D0,($040A,A4)
02:0003CC7A 1940002D        	  9377:     move.b  D0,($002D,A4)
                            	  9378:     even
