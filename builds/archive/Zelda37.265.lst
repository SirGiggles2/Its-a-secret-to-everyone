02:000431BE 4EB90002A9FA    	  7020:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
02:000431C4 4EB90003097E    	  7021:     jsr     GetShortcutOrItemXY
                            	  7022:     ; Divide X coordinate by 4 to get offset into column address table.
                            	  7023:     ; Think of it this way. Divide X by 8 to get tile column number.
