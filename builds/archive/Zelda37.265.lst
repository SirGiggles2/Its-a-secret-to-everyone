                            	  6251: Digdogger_Move:
                            	  6252:     ; This calculation is the same one used in Manhandla to
                            	  6253:     ; manifest the fractional speed over several frames.
                            	  6254:     ;
                            	  6255:     ; To summarize, the formula is:
                            	  6256:     ;
                            	  6257:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6258:     ;
                            	  6259:     ;   SA := SA + (SL AND $E0)
                            	  6260:     ;   [03] := SH + carry
                            	  6261:     ;
                            	  6262:     ; See 04:A28E Manhandla_Move.
                            	  6263:     ;
02:0003B574 41EC041F        	  6264:     lea     ($041F,A4),A0
02:0003B578 10302000        	  6265:     move.b  (A0,D2.W),D0
02:0003B57C 020000E0        	  6266:     andi.b #$E0,D0
02:0003B580 023C00EE        	  6267:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B584 41EC0412        	  6268:     lea     ($0412,A4),A0
02:0003B588 12302000        	  6269:     move.b  (A0,D2.W),D1
02:0003B58C D101            	  6270:     addx.b  D1,D0   ; ADC $0412,X
02:0003B58E 41EC0412        	  6271:     lea     ($0412,A4),A0
02:0003B592 11802000        	  6272:     move.b  D0,(A0,D2.W)
                            	  6273:     ; Assign (high speed byte + carry) to [03].
                            	  6274:     ;
02:0003B596 41EC042C        	  6275:     lea     ($042C,A4),A0
02:0003B59A 10302000        	  6276:     move.b  (A0,D2.W),D0
02:0003B59E 123C0000        	  6277:     move.b  #$00,D1
02:0003B5A2 D101            	  6278:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003B5A4 19400003        	  6279:     move.b  D0,($0003,A4)
                            	  6280:     ; Change coordinates by the speed amount/offset in [03]
                            	  6281:     ; according to the direction.
                            	  6282:     ;
                            	  6283:     ; Start with a mask of $A1 in [02]:
                            	  6284:     ; - low nibble represents the right direction
                            	  6285:     ; - high nibble is used to set or clear carry as we go along
                            	  6286:     ;
02:0003B5A8 103C00A1        	  6287:     move.b  #$A1,D0
02:0003B5AC 19400002        	  6288:     move.b  D0,($0002,A4)
                            	  6289:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6290:     ;
02:0003B5B0 41EC0098        	  6291:     lea     ($0098,A4),A0
02:0003B5B4 10302000        	  6292:     move.b  (A0,D2.W),D0
02:0003B5B8 122C0002        	  6293:     move.b  ($0002,A4),D1
02:0003B5BC C200            	  6294:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B5BE 6712            	  6295:     beq  _L_z04_Digdogger_Move_Left
02:0003B5C0 10342070        	  6296:     move.b  ($70,A4,D2.W),D0
02:0003B5C4 023C00EE        	  6297:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B5C8 122C0003        	  6298:     move.b  ($0003,A4),D1
02:0003B5CC D101            	  6299:     addx.b  D1,D0   ; ADC $03
02:0003B5CE 19802070        	  6300:     move.b  D0,($70,A4,D2.W)
                            	  6301:     even
                            	  6302: _L_z04_Digdogger_Move_Left:
                            	  6303:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6304:     ;
02:0003B5D2 41EC0098        	  6305:     lea     ($0098,A4),A0
02:0003B5D6 10302000        	  6306:     move.b  (A0,D2.W),D0
02:0003B5DA 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003B5DE E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003B5E0 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003B5E4 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003B5E8 C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B5EA 6716            	  6312:     beq  _L_z04_Digdogger_Move_Down
02:0003B5EC 10342070        	  6313:     move.b  ($70,A4,D2.W),D0
02:0003B5F0 122C0003        	  6314:     move.b  ($0003,A4),D1
02:0003B5F4 0A3C0010        	  6315:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B5F8 9101            	  6316:     subx.b  D1,D0   ; SBC $03
02:0003B5FA 0A3C0010        	  6317:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B5FE 19802070        	  6318:     move.b  D0,($70,A4,D2.W)
                            	  6319:     even
                            	  6320: _L_z04_Digdogger_Move_Down:
                            	  6321:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6322:     ;
02:0003B602 41EC0098        	  6323:     lea     ($0098,A4),A0
02:0003B606 10302000        	  6324:     move.b  (A0,D2.W),D0
02:0003B60A 122C0002        	  6325:     move.b  ($0002,A4),D1
02:0003B60E E309            	  6326:     lsl.b  #1,D1   ; ASL $02
02:0003B610 19410002        	  6327:     move.b  D1,($0002,A4)
02:0003B614 122C0002        	  6328:     move.b  ($0002,A4),D1
02:0003B618 C200            	  6329:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B61A 6716            	  6330:     beq  _L_z04_Digdogger_Move_Up
02:0003B61C 41EC0084        	  6331:     lea     ($0084,A4),A0
02:0003B620 10302000        	  6332:     move.b  (A0,D2.W),D0
02:0003B624 122C0003        	  6333:     move.b  ($0003,A4),D1
02:0003B628 D101            	  6334:     addx.b  D1,D0   ; ADC $03
02:0003B62A 41EC0084        	  6335:     lea     ($0084,A4),A0
02:0003B62E 11802000        	  6336:     move.b  D0,(A0,D2.W)
                            	  6337:     even
                            	  6338: _L_z04_Digdogger_Move_Up:
                            	  6339:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  6340:     ;
02:0003B632 41EC0098        	  6341:     lea     ($0098,A4),A0
02:0003B636 10302000        	  6342:     move.b  (A0,D2.W),D0
02:0003B63A 122C0002        	  6343:     move.b  ($0002,A4),D1
02:0003B63E E309            	  6344:     lsl.b  #1,D1   ; ASL $02
02:0003B640 19410002        	  6345:     move.b  D1,($0002,A4)
02:0003B644 122C0002        	  6346:     move.b  ($0002,A4),D1
02:0003B648 C200            	  6347:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B64A 671E            	  6348:     beq  _L_z04_Digdogger_Move_End
02:0003B64C 41EC0084        	  6349:     lea     ($0084,A4),A0
02:0003B650 10302000        	  6350:     move.b  (A0,D2.W),D0
02:0003B654 122C0003        	  6351:     move.b  ($0003,A4),D1
02:0003B658 0A3C0010        	  6352:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B65C 9101            	  6353:     subx.b  D1,D0   ; SBC $03
02:0003B65E 0A3C0010        	  6354:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B662 41EC0084        	  6355:     lea     ($0084,A4),A0
