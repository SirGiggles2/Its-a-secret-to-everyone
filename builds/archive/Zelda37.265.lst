                            	  1824:     ;
02:0003FFBA 7600            	  1825:     moveq   #0,D3
02:0003FFBC 102C0098        	  1826:     move.b  ($0098,A4),D0
02:0003FFC0 02000003        	  1827:     andi.b #$03,D0
