02:0004AF58 52302000        	  5204:     addq.b  #1,(A0,D2.W)
02:0004AF5C 41EC00AC        	  5205:     lea     ($00AC,A4),A0
02:0004AF60 10302000        	  5206:     move.b  (A0,D2.W),D0
02:0004AF64 0200000F        	  5207:     andi.b #$0F,D0
02:0004AF68 0C000003        	  5208:     cmpi.b  #$03,D0
02:0004AF6C 674C            	  5209:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
