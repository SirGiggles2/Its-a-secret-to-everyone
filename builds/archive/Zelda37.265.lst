                            	   941: 
                            	   942: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   943: c_has_compass:
02:0002B6B2 4EB900000000    	   944:     jsr     z05_has_compass
02:0002B6B8 4A00            	   945:     tst.b   D0
02:0002B6BA 4E75            	   946:     rts
                            	   947: 
                            	   948: c_has_map:
02:0002B6BC 4EB900000000    	   949:     jsr     z05_has_map
02:0002B6C2 4A00            	   950:     tst.b   D0
02:0002B6C4 4E75            	   951:     rts
