                            	  2686:     ;
02:000309B4 0C030012        	  2687:     cmpi.b  #$12,D3
02:000309B8 6706            	  2688:     beq  _anon_z01_55
02:000309BA 0C03000D        	  2689:     cmpi.b  #$0D,D3
02:000309BE 6606            	  2690:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  2691: _anon_z01_55:
02:000309C0 E308            	  2692:     lsl.b  #1,D0   ; ASL A
                            	  2693:     even
