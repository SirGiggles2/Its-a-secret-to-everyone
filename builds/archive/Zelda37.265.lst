                            	  7276: InitObject:
02:0004BED8 7400            	  7277:     moveq   #0,D2
02:0004BEDA 142C0340        	  7278:     move.b  ($0340,A4),D2
                            	  7279:     ; We want to handle "enemies from the edges of the screen".
                            	  7280:     ;
                            	  7281:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7282:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7283:     ; that does not spawn with a cloud (type >= $53);
                            	  7284:     ; 
                            	  7285:     ; then go initialize the object.
                            	  7286:     ;
02:0004BEDE 102C0010        	  7287:     move.b  ($0010,A4),D0
02:0004BEE2 66000196        	  7288:     bne  _L_z07_InitObject_NormalSpawn
02:0004BEE6 102C04CD        	  7289:     move.b  ($04CD,A4),D0
02:0004BEEA 02000008        	  7290:     andi.b #$08,D0
02:0004BEEE 6700018A        	  7291:     beq  _L_z07_InitObject_NormalSpawn
02:0004BEF2 41EC034F        	  7292:     lea     ($034F,A4),A0
02:0004BEF6 10302000        	  7293:     move.b  (A0,D2.W),D0
02:0004BEFA 0C000011        	  7294:     cmpi.b  #$11,D0
02:0004BEFE 6700017A        	  7295:     beq  _L_z07_InitObject_NormalSpawn
02:0004BF02 0C000040        	  7296:     cmpi.b  #$40,D0
02:0004BF06 67000172        	  7297:     beq  _L_z07_InitObject_NormalSpawn
02:0004BF0A 0C00001E        	  7298:     cmpi.b  #$1E,D0
02:0004BF0E 6700016A        	  7299:     beq  _L_z07_InitObject_NormalSpawn
02:0004BF12 0C00002E        	  7300:     cmpi.b  #$2E,D0
02:0004BF16 67000162        	  7301:     beq  _L_z07_InitObject_NormalSpawn
02:0004BF1A 0C000053        	  7302:     cmpi.b  #$53,D0
02:0004BF1E 6400015A        	  7303:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7304:     even
                            	  7305: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7306:     ; If the "monsters from edges" long timer expired, then
                            	  7307:     ; go bring the monster in.
                            	  7308:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7309:     ;
                            	  7310:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7311:     ; residual position so enemies keep their previous-room
                            	  7312:     ; positions instead of being re-edge-spawned (matches NES).
02:0004BF22 102C004B        	  7313:     move.b  ($004B,A4),D0
02:0004BF26 662E            	  7314:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7315:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004BF28 102C000F        	  7316:     move.b  ($000F,A4),D0
02:0004BF2C 0C0000FF        	  7317:     cmpi.b  #$FF,D0
02:0004BF30 662E            	  7318:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004BF32 41EC0070        	  7319:     lea     ($0070,A4),A0
02:0004BF36 10302000        	  7320:     move.b  (A0,D2.W),D0
02:0004BF3A 660A            	  7321:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004BF3C 41EC0084        	  7322:     lea     ($0084,A4),A0
02:0004BF40 10302000        	  7323:     move.b  (A0,D2.W),D0
02:0004BF44 671A            	  7324:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7325:     even
                            	  7326: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
