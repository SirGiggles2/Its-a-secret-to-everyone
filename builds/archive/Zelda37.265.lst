Source: "genesis_shell.asm"
                            	   619:     include "nes_io.asm"

Source: "nes_io.asm"
                            	     1: ;==============================================================================
                            	     2: ; nes_io.asm — NES I/O emulation layer
                            	     3: ;
                            	     4: ; Included by genesis_shell.asm BEFORE z_07.asm (and all other bank files).
                            	     5: ; Provides real implementations of all _ppu_*, _apu_*, _ctrl_*, _oam_*,
                            	     6: ; _mmc1_* helpers that the transpiled Zelda code calls via BSR/JSR.
                            	     7: ;
                            	     8: ; T5 milestone: PPUADDR two-write latch + PPUDATA → Genesis VDP VRAM byte writes.
                            	     9: ;
                            	    10: ; Register contract (must match transpiler mapping):
                            	    11: ;   D0  = NES accumulator A
                            	    12: ;   D2  = NES X index
                            	    13: ;   D3  = NES Y index
                            	    14: ;   D7  = NES SP shadow
                            	    15: ;   A4  = NES RAM base ($FF0000)
                            	    16: ;   A5  = NES stack pointer (NES_RAM + $0100 region)
                            	    17: ;
                            	    18: ; All NES I/O functions must preserve D1–D7, A0–A6 except as documented.
                            	    19: ; They receive their argument in D0.b and return results in D0.b.
                            	    20: ;==============================================================================
                            	    21: 
                            	    22: ;------------------------------------------------------------------------------
                            	    23: ; CHR_EXPANSION_ENABLED — feature flag for the 4x sprite CHR expansion.
                            	    24: ;
                            	    25: ; When 1: every sprite CHR tile is stored in Gen VRAM as 4 copies, each with
                            	    26: ;   pixel values pre-biased +0/+4/+8/+12 to index into packed PAL2 slots
                            	    27: ;   0..15.  _oam_dma selects the copy via tile-index bias; tile word palette
                            	    28: ;   bits are always %10 (PAL2).  NES $3F10-$3F1F palette writes pack into
                            	    29: ;   PAL2 slots 0..15 sequentially.  This preserves all 4 NES sprite sub-
                            	    30: ;   palettes simultaneously, eliminating the multiplex loss.
                            	    31: ;
                            	    32: ; When 0: legacy last-write-wins sprite palette multiplex (SP0,SP2→PAL2,
                            	    33: ;   SP1,SP3→PAL3).  Default until the expansion path is fully verified.
                            	    34: ;
                            	    35: ; See memory/project_chr_expansion.md for the staged rollout plan.
                            	    36: ;------------------------------------------------------------------------------
                            	    37: CHR_EXPANSION_ENABLED equ 1
                            	    38: 
                            	    39: ;------------------------------------------------------------------------------
                            	    40: ; PPU state RAM — placed at $FF0800 (immediately after 2KB NES work RAM).
                            	    41: ; Initialised to zero by genesis_shell before jsr IsrReset.
                            	    42: ;
                            	    43: ; Layout (12 bytes):
                            	    44: ;   +0  PPU_LATCH   (byte) write-toggle shared by $2005/$2006 (0=1st, 1=2nd)
                            	    45: ;   +1  (pad)
                            	    46: ;   +2  PPU_VADDR   (word) assembled 16-bit VRAM address
                            	    47: ;   +4  PPU_CTRL    (byte) PPUCTRL  ($2000) shadow
                            	    48: ;   +5  PPU_MASK    (byte) PPUMASK  ($2001) shadow
                            	    49: ;   +6  PPU_SCRL_X  (byte) scroll X (from first  $2005 write)
                            	    50: ;   +7  PPU_SCRL_Y  (byte) scroll Y (from second $2005 write)
                            	    51: ;   +8  PPU_DBUF    (byte) PPUDATA even-address byte buffer
                            	    52: ;   +9  PPU_DHALF   (byte) 1 when an even-address byte is buffered
                            	    53: ;   +10 (pad × 2)
                            	    54: ;------------------------------------------------------------------------------
                            	    55: PPU_STATE_BASE  equ $00FF0800
                            	    56: 
                            	    57: PPU_LATCH       equ PPU_STATE_BASE+0    ; byte: w register (0=first write)
                            	    58: PPU_VADDR       equ PPU_STATE_BASE+2    ; word: current VRAM address
                            	    59: PPU_CTRL        equ PPU_STATE_BASE+4    ; byte: PPUCTRL shadow
                            	    60: PPU_MASK        equ PPU_STATE_BASE+5    ; byte: PPUMASK shadow
                            	    61: PPU_SCRL_X      equ PPU_STATE_BASE+6    ; byte: horizontal scroll value
                            	    62: PPU_SCRL_Y      equ PPU_STATE_BASE+7    ; byte: vertical scroll value
                            	    63: PPU_DBUF        equ PPU_STATE_BASE+8    ; byte: buffered even-addr byte
                            	    64: PPU_DHALF       equ PPU_STATE_BASE+9    ; byte: 1 if even-addr byte pending
                            	    65: PPU_S0_TOGGLE   equ PPU_STATE_BASE+10   ; byte: toggles bit 6 across _ppu_read_2 calls
                            	    66:                                          ; so both wait-for-set and wait-for-clear
                            	    67:                                          ; sprite-0 loops terminate on Genesis.
                            	    68: ;------------------------------------------------------------------------------
                            	    69: ; MMC1 state RAM — placed at $FF0810 (immediately after 16-byte PPU block).
                            	    70: ; Initialised to zero by genesis_shell before jsr IsrReset.
                            	    71: ;
                            	    72: ; Layout (6 bytes):
                            	    73: ;   +0  MMC1_SHIFT  (byte) shift register accumulator (LSB-first)
                            	    74: ;   +1  MMC1_COUNT  (byte) number of bits accumulated (0–4)
                            	    75: ;   +2  MMC1_CTRL   (byte) MMC1 control register ($8000 target)
                            	    76: ;   +3  MMC1_CHR0   (byte) CHR bank 0 register   ($A000 target)
                            	    77: ;   +4  MMC1_CHR1   (byte) CHR bank 1 register   ($C000 target)
                            	    78: ;   +5  MMC1_PRG    (byte) PRG bank register      ($E000 target)
                            	    79: ;------------------------------------------------------------------------------
                            	    80: MMC1_STATE_BASE equ PPU_STATE_BASE+$10  ; $FF0810
                            	    81: 
                            	    82: MMC1_SHIFT      equ MMC1_STATE_BASE+0   ; byte: shift accumulator
                            	    83: MMC1_COUNT      equ MMC1_STATE_BASE+1   ; byte: bits accumulated (0-4)
                            	    84: MMC1_CTRL       equ MMC1_STATE_BASE+2   ; byte: control reg ($8000)
                            	    85: MMC1_CHR0       equ MMC1_STATE_BASE+3   ; byte: CHR bank 0 ($A000)
                            	    86: MMC1_CHR1       equ MMC1_STATE_BASE+4   ; byte: CHR bank 1 ($C000)
                            	    87: MMC1_PRG        equ MMC1_STATE_BASE+5   ; byte: PRG bank ($E000)
                            	    88: 
                            	    89: ;------------------------------------------------------------------------------
                            	    90: ; CHR tile upload buffer — placed at $FF0820.
                            	    91: ; Accumulates one 16-byte NES 2BPP tile then converts it to Genesis 4BPP (32 bytes)
                            	    92: ; and DMA-writes the result to VDP VRAM.
                            	    93: ;
                            	    94: ; Layout (21 bytes):
                            	    95: ;   +0…+15  CHR_TILE_BUF  (16 bytes) raw NES 2BPP tile data
                            	    96: ;              bytes 0–7  = plane 0 (bit 0 of each pixel, row 0 first)
                            	    97: ;              bytes 8–15 = plane 1 (bit 1 of each pixel, row 0 first)
                            	    98: ;   +16     CHR_BUF_CNT   (byte) number of bytes accumulated (0–15)
                            	    99: ;   +17     (pad byte — keeps CHR_BUF_VADDR word-aligned)
                            	   100: ;   +18–19  CHR_BUF_VADDR (word) NES PPU address at start of this tile  ← $FF0832 (even)
                            	   101: ;   +20     CHR_HIT_COUNT (byte) total CHR write calls (debug counter)
                            	   102: ;------------------------------------------------------------------------------
                            	   103: CHR_STATE_BASE  equ PPU_STATE_BASE+$20  ; $FF0820
                            	   104: 
                            	   105: CHR_TILE_BUF    equ CHR_STATE_BASE+0    ; 16 bytes: raw NES tile bytes
                            	   106: CHR_BUF_CNT     equ CHR_STATE_BASE+16   ; byte: bytes accumulated
                            	   107:                                          ; +17: pad byte (alignment)
                            	   108: CHR_BUF_VADDR   equ CHR_STATE_BASE+18   ; word: tile's NES base address ($FF0832, even)
                            	   109: CHR_HIT_COUNT   equ CHR_STATE_BASE+20   ; byte: total CHR write calls (debug counter)
                            	   110: 
                            	   111: ;------------------------------------------------------------------------------
                            	   112: ; Nametable tile-index cache — placed at $FF0840.
                            	   113: ; 32 × 60 = 1920 bytes (NT0 rows 0-29 + NT1 rows 30-59 for V64 plane).
                            	   114: ; NT_CACHE[row*32 + col] = tile index.  NT1 entries at offset 960.
                            	   115: ;------------------------------------------------------------------------------
                            	   116: NT_CACHE_BASE   equ CHR_STATE_BASE+$20  ; $FF0840  (32×60 = 1920 bytes)
                            	   117: NT_ATTR_CACHE_BASE equ $00FF1400        ; 32×60 = 1920 bytes, raw palette id per tile
                            	   118: 
                            	   119: ;------------------------------------------------------------------------------
                            	   120: ; Staged scroll state written by _ags_flush and consumed by _ags_prearm on the
                            	   121: ; next frame. Lives in the unused tail of the PPU shadow block at $FF080A..0F.
                            	   122: ;------------------------------------------------------------------------------
                            	   123: STAGED_SCROLL_MODE equ PPU_STATE_BASE+$0A ; byte: next-frame mode
                            	   124: STAGED_HINT_CTR    equ PPU_STATE_BASE+$0B ; byte: next-frame Reg 10 counter
                            	   125: STAGED_BASE_VSRAM  equ PPU_STATE_BASE+$0C ; word: next-frame start-of-frame VSRAM
                            	   126: STAGED_EVENT_VSRAM equ PPU_STATE_BASE+$0E ; word: next-frame H-int VSRAM
                            	   127: 
                            	   128: ;------------------------------------------------------------------------------
                            	   129: ; Active scroll state promoted by _ags_prearm and consumed by the currently
                            	   130: ; rendered frame. Stored in the unused tail between CHR state and NT cache.
                            	   131: ;------------------------------------------------------------------------------
                            	   132: ACTIVE_BASE_VSRAM  equ CHR_STATE_BASE+$16 ; $FF0836 word: current-frame base VSRAM
                            	   133: ACTIVE_EVENT_VSRAM equ CHR_STATE_BASE+$18 ; $FF0838 word: current-frame event VSRAM
                            	   134: ACTIVE_HINT_CTR    equ CHR_STATE_BASE+$1A ; $FF083A byte: current-frame Reg 10 counter
                            	   135: 
                            	   136: ;------------------------------------------------------------------------------
                            	   137: ; Phase 1 (diary re-integration) state.
                            	   138: ;
                            	   139: ; VRamForceBlankGate — when set (=1), _ppu_write_1 forces PPUMASK video-enable
                            	   140: ;   bits ($18) off so the VDP stays in force-blank.  Held while UpdateMode0/1
                            	   141: ;   init is streaming CHR/VRAM and cleared by the transpiler-injected marker
                            	   142: ;   at the end of the full init chain (_patch_z02).  Prevents a beam-race
                            	   143: ;   visible when Start is pressed at certain frame phases.
                            	   144: ;
                            	   145: ; LAST_GAMEMODE — shadow of $0012 (GameMode) read by _mode_transition_check
                            	   146: ;   from VBlankISR.  On change the check re-zeros PPU latch/address/scroll
                            	   147: ;   state and direct-writes 0 to VSRAM[0]/[1] so scroll bleed from the prior
                            	   148: ;   mode cannot contaminate the new mode's first frame.  Seeded to $FF at
                            	   149: ;   cold boot so the first frame always fires a transition. Kept out of the
                            	   150: ;   MMC1 block so mapper writes cannot stomp the mode-transition shadow.
                            	   151: ;------------------------------------------------------------------------------
                            	   152: VRamForceBlankGate equ CHR_STATE_BASE+$1D ; $FF083D byte: 1 = force-blank hold
                            	   153: LAST_GAMEMODE      equ CHR_STATE_BASE+$1E ; $FF083E byte: shadow of $0012
                            	   154: ; Attempt 6a: FrontendStartReleaseGate — set by UpdateMode0Demo_Sub0 at the
                            	   155: ; moment title mode accepts Start and begins the file-select init chain.
                            	   156: ; While non-zero, UpdateMode1Menu_Sub0 ignores Start so the held press from
                            	   157: ; the title transition cannot immediately punch through to gameplay.
                            	   158: ; Cleared the frame the Start button bit ($00F8 & $10) first becomes zero.
                            	   159: FrontendStartReleaseGate equ $FF042B ; 1 byte in NES scratch-record region
                            	   160: ;------------------------------------------------------------------------------
                            	   161: ; Demand-driven NES PRG bank window (P33).
                            	   162: ;
                            	   163: ; Non-jump .ADDR tables now hold true NES CPU addresses ($8000-$BFFF).  Table
                            	   164: ; consumers add NES_RAM and dereference, so we mirror the active 16KB PRG bank
                            	   165: ; image at $FF8000. Then NES_RAM + $8xxx resolves into this window.
                            	   166: ;------------------------------------------------------------------------------
                            	   167: BANK_WINDOW_BASE      equ $00FF8000
                            	   168: BANK_WINDOW_SIZE      equ $4000
                            	   169: _current_window_bank  equ $00FF083F ; byte cache: last copied bank ($FF = none)
                            	   170: ;------------------------------------------------------------------------------
                            	   171: ; Scroll composition modes shared between staged state and INTRO_SCROLL_MODE.
                            	   172: ;------------------------------------------------------------------------------
                            	   173: INTRO_SCROLL_NO_SPLIT   equ 0
                            	   174: INTRO_SCROLL_GAME_SPLIT equ 1
                            	   175: 
                            	   176: ;------------------------------------------------------------------------------
                            	   177: ; SAT shadow (Phase 1: VDP DMA for OAM).
                            	   178: ;
                            	   179: ; Double-buffered Genesis sprite attribute table mirror in 68k RAM.
                            	   180: ;   SAT_SHADOW_A at $FF2000 (512 bytes) — bank A
                            	   181: ;   SAT_SHADOW_B at $FF2200 (512 bytes) — bank B
                            	   182: ;   SAT_ACTIVE_BANK at $FF2400 (byte) — 0=A, 1=B; bank currently FILLED by _oam_dma
                            	   183: ;
                            	   184: ; Flow:
                            	   185: ;   Frame N: _oam_dma writes SAT_SHADOW_[A|B] at bank = SAT_ACTIVE_BANK.
                            	   186: ;   Frame N+1 VBlankISR (top): _oam_dma_flush DMAs that same bank into
                            	   187: ;     VRAM $F800, then flips SAT_ACTIVE_BANK. Frame N+1's _oam_dma then
                            	   188: ;     writes the other bank.
                            	   189: ; One-frame OAM display latency — standard Genesis pattern.
                            	   190: ;
                            	   191: ; Address range $FF2000-$FF2400 confirmed clear of APU shadow ($FF0A00),
                            	   192: ; NT_CACHE ($FF0840-$FF0FBF), probe counters ($FF1000-), FileBChecksums
                            	   193: ; ($FF1200), NT_ATTR_CACHE ($FF1400-$FF1B7F), and NES_SRAM ($FF6000).
                            	   194: ;------------------------------------------------------------------------------
                            	   195: SAT_SHADOW_A        equ $00FF2000
                            	   196: SAT_SHADOW_B        equ $00FF2200
                            	   197: SAT_SHADOW_SIZE     equ 512
                            	   198: SAT_ACTIVE_BANK     equ $00FF2400
                            	   199: 
                            	   200: ;==============================================================================
                            	   201: ; PPU register reads ($2000–$2007 → _ppu_read_0 … _ppu_read_7)
                            	   202: ;==============================================================================
                            	   203: 
                            	   204: ;------------------------------------------------------------------------------
                            	   205: ; _ppu_read_0 — PPUCTRL ($2000) — write-only on real NES, reads return open bus.
                            	   206: ; Return 0 so caller's AND/BEQ tests see nothing set.
                            	   207: ;------------------------------------------------------------------------------
                            	   208: _ppu_read_0:
02:0000E02C 7000            	   209:     moveq   #0,D0
02:0000E02E 4E75            	   210:     rts
                            	   211: 
                            	   212: ;------------------------------------------------------------------------------
                            	   213: ; _ppu_read_1 — PPUMASK ($2001) — write-only, open bus.
                            	   214: ;------------------------------------------------------------------------------
                            	   215: _ppu_read_1:
02:0000E030 7000            	   216:     moveq   #0,D0
02:0000E032 4E75            	   217:     rts
                            	   218: 
                            	   219: ;------------------------------------------------------------------------------
                            	   220: ; _ppu_read_2 — PPUSTATUS ($2002)
                            	   221: ;
                            	   222: ; Bit 7 = VBlank flag.  Cleared on read.  The shared write-latch (w) is also
                            	   223: ; reset on any $2002 read.
                            	   224: ;
                            	   225: ; T5 implementation: always returns $80 (VBlank always set) so IsrReset's
                            	   226: ; two warmup polling loops exit immediately.  A real VBlank flag will be
                            	   227: ; wired in T6 (software flag toggled by VBlankISR).
                            	   228: ;
                            	   229: ; IMPORTANT: must reset the PPU write-latch (PPU_LATCH).
                            	   230: ;------------------------------------------------------------------------------
                            	   231: _ppu_read_2:
02:0000E034 423900FF0800    	   232:     clr.b   (PPU_LATCH).l          ; reading $2002 resets the w register
                            	   233:     ; b7 (VBlank) always set — exits warmup loops.
                            	   234:     ; b6 (sprite-0-hit) toggles each call — lets BOTH wait-for-set
                            	   235:     ; (WaitAndScrollToSplitBottom, z_05:1530) AND wait-for-clear
                            	   236:     ; (IsrNmi_WaitVBlankEnd, z_07:1533) loops terminate in ≤2 iters.
                            	   237:     ; Gen has no scanline split — skipping is correct.
02:0000E03A 103900FF080A    	   238:     move.b  (PPU_S0_TOGGLE).l,D0
02:0000E040 0A000040        	   239:     eori.b  #$40,D0
02:0000E044 13C000FF080A    	   240:     move.b  D0,(PPU_S0_TOGGLE).l
02:0000E04A 00000080        	   241:     ori.b   #$80,D0                ; always assert VBlank bit
02:0000E04E 4E75            	   242:     rts
                            	   243: 
                            	   244: ;------------------------------------------------------------------------------
                            	   245: ; _ppu_read_3 — OAM addr ($2003) — write-only.
                            	   246: ; _ppu_read_4 — OAM data ($2004) — return 0 for now.
                            	   247: ; _ppu_read_5 — PPUSCROLL ($2005) — write-only.
                            	   248: ; _ppu_read_6 — PPUADDR  ($2006) — write-only.
                            	   249: ;------------------------------------------------------------------------------
                            	   250: _ppu_read_3:
                            	   251: _ppu_read_4:
                            	   252: _ppu_read_5:
                            	   253: _ppu_read_6:
02:0000E050 7000            	   254:     moveq   #0,D0
02:0000E052 4E75            	   255:     rts
                            	   256: 
                            	   257: ;------------------------------------------------------------------------------
                            	   258: ; _ppu_read_7 — PPUDATA ($2007) read
                            	   259: ;
                            	   260: ; T5: return 0.  Palette reads have a special one-cycle-delay buffer on real
                            	   261: ; NES hardware.  No reads of $2007 in Zelda's critical path; defer to T8+.
                            	   262: ;------------------------------------------------------------------------------
                            	   263: _ppu_read_7:
02:0000E054 7000            	   264:     moveq   #0,D0
02:0000E056 4E75            	   265:     rts
                            	   266: 
                            	   267: ;==============================================================================
                            	   268: ; PPU register writes ($2000–$2007 → _ppu_write_0 … _ppu_write_7)
                            	   269: ;==============================================================================
                            	   270: 
                            	   271: ;------------------------------------------------------------------------------
                            	   272: ; _ppu_write_0 — PPUCTRL ($2000)
                            	   273: ;
                            	   274: ; D0.b = value to write.
                            	   275: ; Bits of interest:
                            	   276: ;   bit 2 = VRAM address increment (0 → +1 horizontal, 1 → +32 vertical)
                            	   277: ;   bit 7 = NMI enable (0 = disable, 1 = enable on VBlank)
                            	   278: ;
                            	   279: ; We store the value so _ppu_write_7 can read the increment flag.
                            	   280: ; NMI enable is handled at the hardware level (VBlank ISR always fires);
                            	   281: ; Zelda controls this register to gate per-frame updates.
                            	   282: ;------------------------------------------------------------------------------
                            	   283: _ppu_write_0:
                            	   284:     ; Check if bit 4 (BG pattern table) changed — if so, update Plane A tiles
02:0000E058 123900FF0804    	   285:     move.b  (PPU_CTRL).l,D1
02:0000E05E B101            	   286:     eor.b   D0,D1                   ; D1 = changed bits
02:0000E060 13C000FF0804    	   287:     move.b  D0,(PPU_CTRL).l         ; store new value
02:0000E066 08010004        	   288:     btst    #4,D1
02:0000E06A 6602            	   289:     bne.s   .ppuw0_pt_changed
02:0000E06C 4E75            	   290:     rts
                            	   291: .ppuw0_pt_changed:
                            	   292:     ; BG pattern table bit changed.  Rebuild all 960 Plane A tile words from
                            	   293:     ; NT_CACHE, applying the new PPUCTRL bit 4 offset.  Palette bits are set
                            	   294:     ; to 0 (subsequent attribute processing will restore correct palettes).
02:0000E06E 48E7FCC0        	   295:     movem.l D0-D5/A0-A1,-(SP)
                            	   296: 
02:0000E072 41F900FF0840    	   297:     lea     (NT_CACHE_BASE).l,A0
02:0000E078 343CC000        	   298:     move.w  #$C000,D2               ; Plane A VDP address
                            	   299: 
02:0000E07C 761D            	   300:     moveq   #30-1,D3                ; 30 rows
                            	   301: .ppuw0_row:
02:0000E07E 781F            	   302:     moveq   #32-1,D4                ; 32 cols
                            	   303: .ppuw0_col:
                            	   304:     ; Build tile word from NT_CACHE
02:0000E080 7000            	   305:     moveq   #0,D0
02:0000E082 1018            	   306:     move.b  (A0)+,D0                ; raw tile index from cache
02:0000E084 61000856        	   307:     bsr     _compose_bg_tile_word
                            	   308: 
                            	   309:     ; Issue VDP write command for current Plane A address
02:0000E088 7200            	   310:     moveq   #0,D1
02:0000E08A 3202            	   311:     move.w  D2,D1
02:0000E08C 028100003FFF    	   312:     andi.l  #$00003FFF,D1
02:0000E092 4841            	   313:     swap    D1
02:0000E094 008140000003    	   314:     ori.l   #$40000003,D1
02:0000E09A 23C100C00004    	   315:     move.l  D1,(VDP_CTRL).l
02:0000E0A0 33C000C00000    	   316:     move.w  D0,(VDP_DATA).l
                            	   317: 
02:0000E0A6 5442            	   318:     addq.w  #2,D2                   ; next col
02:0000E0A8 51CCFFD6        	   319:     dbf     D4,.ppuw0_col
                            	   320: 
02:0000E0AC 06420040        	   321:     addi.w  #$40,D2                 ; skip 32 unused cols in 64-wide plane
02:0000E0B0 51CBFFCC        	   322:     dbf     D3,.ppuw0_row
                            	   323: 
02:0000E0B4 4CDF033F        	   324:     movem.l (SP)+,D0-D5/A0-A1
02:0000E0B8 4E75            	   325:     rts
                            	   326: 
                            	   327: ;------------------------------------------------------------------------------
                            	   328: ; _ppu_write_1 — PPUMASK ($2001)
                            	   329: ; Store shadow for potential video-enable logic in T6+.
                            	   330: ;
                            	   331: ; Phase 1 gate: if VRamForceBlankGate is set, the incoming D0 has its
                            	   332: ; BG/sprite enable bits ($18) masked off and the PPU_MASK shadow is stored
                            	   333: ; with those bits cleared.  This keeps the VDP in force-blank while an init
                            	   334: ; chain (UpdateMode0Demo_Sub0 → InitMode1_Sub6) is still streaming VRAM,
                            	   335: ; so an ill-timed Start press cannot make the VDP race the beam while tiles
                            	   336: ; are mid-DMA.  The gate is released by the transpiler marker at the end of
                            	   337: ; InitMode1_Sub6 (see _patch_z02 P11).
                            	   338: ;------------------------------------------------------------------------------
                            	   339: _ppu_write_1:
02:0000E0BA 4A3900FF083D    	   340:     tst.b   (VRamForceBlankGate).l
02:0000E0C0 6704            	   341:     beq.s   .ppuw1_no_gate
02:0000E0C2 020000E7        	   342:     andi.b  #$E7,D0                 ; clear bits 3+4 (BG + sprite enable)
                            	   343: .ppuw1_no_gate:
02:0000E0C6 13C000FF0805    	   344:     move.b  D0,(PPU_MASK).l
                            	   345:     ; Toggle VDP display enable to match NES PPUMASK rendering state.
                            	   346:     ; When NES BG+sprites are off (bits 3-4 = 0), blank the Genesis display
                            	   347:     ; to prevent stale VRAM content from showing during mode transitions.
02:0000E0CC 3F00            	   348:     move.w  D0,-(SP)
02:0000E0CE 02000018        	   349:     andi.b  #$18,D0                 ; isolate BG (bit 3) + sprites (bit 4)
02:0000E0D2 660C            	   350:     bne.s   .ppuw1_display_on
                            	   351:     ; Display OFF: VDP Reg 1 = $34 (display disabled, VBlank IRQ, DMA, M5)
02:0000E0D4 33FC813400C00004	   352:     move.w  #$8134,(VDP_CTRL).l
02:0000E0DC 301F            	   353:     move.w  (SP)+,D0
02:0000E0DE 4E75            	   354:     rts
                            	   355: .ppuw1_display_on:
                            	   356:     ; Display ON: VDP Reg 1 = $74 (display enabled, VBlank IRQ, DMA, M5)
02:0000E0E0 33FC817400C00004	   357:     move.w  #$8174,(VDP_CTRL).l
02:0000E0E8 301F            	   358:     move.w  (SP)+,D0
02:0000E0EA 4E75            	   359:     rts
                            	   360: 
                            	   361: ;------------------------------------------------------------------------------
                            	   362: ; _ppu_write_2 — PPUSTATUS ($2002) — write-only on real NES (no effect).
                            	   363: ;------------------------------------------------------------------------------
                            	   364: _ppu_write_2:
02:0000E0EC 4E75            	   365:     rts
                            	   366: 
                            	   367: ;------------------------------------------------------------------------------
                            	   368: ; _ppu_write_3 — OAM address ($2003) — store for future OAM DMA logic.
                            	   369: ;------------------------------------------------------------------------------
                            	   370: _ppu_write_3:
02:0000E0EE 4E75            	   371:     rts
                            	   372: 
                            	   373: ;------------------------------------------------------------------------------
                            	   374: ; _ppu_write_4 — OAM data ($2004) — T5: stub (OAM DMA via $4014 covers Zelda).
                            	   375: ;------------------------------------------------------------------------------
                            	   376: _ppu_write_4:
02:0000E0F0 4E75            	   377:     rts
                            	   378: 
                            	   379: ;------------------------------------------------------------------------------
                            	   380: ; _ppu_write_5 — PPUSCROLL ($2005)
                            	   381: ;
                            	   382: ; First  write (PPU_LATCH=0): horizontal scroll → PPU_SCRL_X, latch → 1.
                            	   383: ; Second write (PPU_LATCH=1): vertical   scroll → PPU_SCRL_Y, latch → 0.
                            	   384: ;
                            	   385: ; Writing to VDP scroll registers is deferred to T6 (visual output pass).
                            	   386: ; For T5 we just store the values so they're available when needed.
                            	   387: ;------------------------------------------------------------------------------
                            	   388: _ppu_write_5:
                            	   389:     ; Phase 9: PPU_SCRL_X / PPU_SCRL_Y stores removed (dead — never read).
                            	   390:     ; Genesis scroll is driven by _ags_* machinery from NES RAM gameplay
                            	   391:     ; state, not these $2005 shadow bytes.  Latch toggle retained for
                            	   392:     ; $2006 PPUADDR correctness (shares write-toggle with $2005 on NES).
02:0000E0F2 103900FF0800    	   393:     move.b  (PPU_LATCH).l,D0          ; reuse D0 (scroll byte discarded)
02:0000E0F8 0A000001        	   394:     eori.b  #1,D0
02:0000E0FC 13C000FF0800    	   395:     move.b  D0,(PPU_LATCH).l
02:0000E102 4E75            	   396:     rts
                            	   397: 
                            	   398: ;------------------------------------------------------------------------------
                            	   399: ; _apply_genesis_scroll — current-frame scroll apply hook.
                            	   400: ;
                            	   401: ; The transpiler injects `bsr _apply_genesis_scroll` twice inside IsrNmi:
                            	   402: ;   P1 after SetScroll updates the current frame's PPU shadows
                            	   403: ;   P2 after later game logic may have prepared next-frame shadows
                            	   404: ;
                            	   405: ; We want the CURRENT frame's VDP state to come from the latest finalized
                            	   406: ; scroll shadows that are still available during vblank. So each hook always
                            	   407: ; recomputes staged state, but it only promotes/applies that state while the
                            	   408: ; VDP still reports vblank active. Once vblank has ended, the hook stages
                            	   409: ; state for the NEXT frame only and leaves the live frame alone.
                            	   410: ;
                            	   411: ; Preserves: D5-D7, A0-A6.
                            	   412: ;------------------------------------------------------------------------------
                            	   413: _apply_genesis_scroll:
02:0000E104 48E7F800        	   414:     movem.l D0-D4,-(SP)
02:0000E108 611A            	   415:     bsr     _ags_compute_stage
02:0000E10A 303900C00004    	   416:     move.w  (VDP_CTRL).l,D0
02:0000E110 08000003        	   417:     btst    #3,D0                      ; VBlank still active?
02:0000E114 6708            	   418:     beq.s   .ags_hook_done
02:0000E116 610000B4        	   419:     bsr     _ags_activate_staged
02:0000E11A 61000116        	   420:     bsr     _ags_apply_active
                            	   421: .ags_hook_done:
02:0000E11E 4CDF001F        	   422:     movem.l (SP)+,D0-D4
02:0000E122 4E75            	   423:     rts
                            	   424: 
                            	   425: ;------------------------------------------------------------------------------
                            	   426: ; _ags_compute_stage — Convert current NES scroll shadows into staged Genesis
                            	   427: ;                      composition state for one whole frame.
                            	   428: ;
                            	   429: ; Assumes A4 = NES RAM base ($FF0000). Writes STAGED_* only.
                            	   430: ; Clobbers D0-D4.
                            	   431: ;------------------------------------------------------------------------------
                            	   432: _ags_compute_stage:
02:0000E124 7000            	   433:     moveq   #0,D0
02:0000E126 102C00FC        	   434:     move.b  ($00FC,A4),D0              ; CurVScroll
02:0000E12A 5040            	   435:     addi.w  #8,D0                      ; overscan
                            	   436: 
02:0000E12C 122C00FF        	   437:     move.b  ($00FF,A4),D1
02:0000E130 4A2C005C        	   438:     tst.b   ($005C,A4)
02:0000E134 6704            	   439:     beq.s   .no_toggle
02:0000E136 0A010002        	   440:     eori.b  #$02,D1
                            	   441: .no_toggle:
02:0000E13A 08010001        	   442:     btst    #1,D1
02:0000E13E 6704            	   443:     beq.s   .no_nt
02:0000E140 064000F0        	   444:     addi.w  #240,D0
                            	   445: .no_nt:
                            	   446:     ; Wrap at 480 (NOT 512): plane rows 60-63 (VSRAM 480-511) are the
                            	   447:     ; V64 blank dead zone — no tile content lives there.  The NES scroll
                            	   448:     ; model wraps at 480 (two 240-row NTs), so end-of-NT_B (VSRAM 479)
                            	   449:     ; must fold directly to start-of-NT_A (VSRAM 0).  Letting VSRAM climb
                            	   450:     ; into 480-511 puts a blank strip at the top of the screen until the
                            	   451:     ; next NT toggle triggers a visible teleport.
02:0000E144 0C4001E0        	   452:     cmpi.w  #480,D0
02:0000E148 6504            	   453:     blo.s   .no_wrap
02:0000E14A 044001E0        	   454:     subi.w  #480,D0
                            	   455: .no_wrap:
                            	   456: 
02:0000E14E 33C000FF080C    	   457:     move.w  D0,(STAGED_BASE_VSRAM).l
02:0000E154 33C000FF080E    	   458:     move.w  D0,(STAGED_EVENT_VSRAM).l
                            	   459: 
02:0000E15A 4A2C00E3        	   460:     tst.b   ($00E3,A4)
02:0000E15E 671E            	   461:     beq.s   .no_split
02:0000E160 13FC000100FF080A	   462:     move.b  #INTRO_SCROLL_GAME_SPLIT,(STAGED_SCROLL_MODE).l
02:0000E168 427900FF080C    	   463:     clr.w   (STAGED_BASE_VSRAM).l
02:0000E16E 13FC002700FF080B	   464:     move.b  #39,(STAGED_HINT_CTR).l
02:0000E176 33C000FF080E    	   465:     move.w  D0,(STAGED_EVENT_VSRAM).l
02:0000E17C 4E75            	   466:     rts
                            	   467: .no_split:
02:0000E17E 13FC000000FF080A	   468:     move.b  #INTRO_SCROLL_NO_SPLIT,(STAGED_SCROLL_MODE).l
02:0000E186 423900FF080B    	   469:     clr.b   (STAGED_HINT_CTR).l
02:0000E18C 4E75            	   470:     rts
                            	   471: 
                            	   472: ;------------------------------------------------------------------------------
                            	   473: ; _ags_flush — Stage the NEXT frame's Genesis composition state and write
                            	   474: ;              H-scroll after IsrNmi has finalized the scroll shadows.
                            	   475: ;
                            	   476: ; This must not touch active-frame VSRAM/H-int state; the first
                            	   477: ; _apply_genesis_scroll hook inside IsrNmi owns current-frame application.
                            	   478: ;
                            	   479: ; Preserves: D5-D7, A0-A6.
                            	   480: ;------------------------------------------------------------------------------
                            	   481: _ags_flush:
02:0000E18E 48E7F800        	   482:     movem.l D0-D4,-(SP)
02:0000E192 6190            	   483:     bsr     _ags_compute_stage
                            	   484: 
                            	   485: .ags_hscroll:
                            	   486:     ; --- H-scroll (Plane A H-scroll table entry 0) ---
02:0000E194 7000            	   487:     moveq   #0,D0
02:0000E196 102C00FD        	   488:     move.b  ($00FD,A4),D0              ; CurHScroll
02:0000E19A 4440            	   489:     neg.w   D0
02:0000E19C 024001FF        	   490:     andi.w  #$01FF,D0
02:0000E1A0 23FC7C00000300C0	   491:     move.l  #$7C000003,(VDP_CTRL).l    ; VRAM write at $FC00
02:0000E1A8 0004
02:0000E1AA 33C000C00000    	   492:     move.w  D0,(VDP_DATA).l            ; Plane A H-scroll
02:0000E1B0 7000            	   493:     moveq   #0,D0
02:0000E1B2 33C000C00000    	   494:     move.w  D0,(VDP_DATA).l            ; Plane B H-scroll = 0
02:0000E1B8 4CDF001F        	   495:     movem.l (SP)+,D0-D4
02:0000E1BC 4E75            	   496:     rts
                            	   497: 
                            	   498: ;------------------------------------------------------------------------------
                            	   499: ; _ags_prearm — Promote the previously staged scroll state into the active
                            	   500: ;               queue at START of vblank, BEFORE IsrNmi runs. This guarantees
                            	   501: ;               a coherent current-frame fallback even if the post-NMI flush
                            	   502: ;               finishes too late to safely touch VDP state for the same frame.
                            	   503: ;
                            	   504: ; Promotes the staged scroll state prepared by the previous frame's _ags_flush
                            	   505: ; into the active queue consumed by HBlankISR, then applies it immediately.
                            	   506: ;
                            	   507: ; Reads:  STAGED_SCROLL_MODE, STAGED_HINT_CTR, STAGED_BASE_VSRAM,
                            	   508: ;         STAGED_EVENT_VSRAM
                            	   509: ; Writes: HINT_Q_COUNT, HINT_Q0_CTR, HINT_Q0_VSRAM, HINT_PEND_SPLIT,
                            	   510: ;         INTRO_SCROLL_MODE
                            	   511: ; Preserves: D1-D7, A0-A6  (clobbers D0 internally, saved/restored)
                            	   512: ;------------------------------------------------------------------------------
                            	   513: _ags_prearm:
02:0000E1BE 48E78000        	   514:     movem.l D0,-(SP)
02:0000E1C2 6108            	   515:     bsr     _ags_activate_staged
02:0000E1C4 616C            	   516:     bsr     _ags_apply_active
02:0000E1C6 4CDF0001        	   517:     movem.l (SP)+,D0
02:0000E1CA 4E75            	   518:     rts
                            	   519: 
                            	   520: ;------------------------------------------------------------------------------
                            	   521: ; _ags_activate_staged — Promote STAGED_* into the active queue/debug state.
                            	   522: ; Clobbers D0.
                            	   523: ;------------------------------------------------------------------------------
                            	   524: _ags_activate_staged:
02:0000E1CC 103900FF080A    	   525:     move.b  (STAGED_SCROLL_MODE).l,D0
02:0000E1D2 13C000FF081F    	   526:     move.b  D0,(INTRO_SCROLL_MODE).l
02:0000E1D8 33F900FF080C00FF	   527:     move.w  (STAGED_BASE_VSRAM).l,(ACTIVE_BASE_VSRAM).l
02:0000E1E0 0836
02:0000E1E2 33F900FF080E00FF	   528:     move.w  (STAGED_EVENT_VSRAM).l,(ACTIVE_EVENT_VSRAM).l
02:0000E1EA 0838
02:0000E1EC 13F900FF080B00FF	   529:     move.b  (STAGED_HINT_CTR).l,(ACTIVE_HINT_CTR).l
02:0000E1F4 083A
02:0000E1F6 4A00            	   530:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,D0
02:0000E1F8 6726            	   531:     beq.s   .aas_no_split
02:0000E1FA 13FC000100FF081E	   532:     move.b  #1,(HINT_PEND_SPLIT).l
02:0000E202 13FC000100FF0816	   533:     move.b  #1,(HINT_Q_COUNT).l
02:0000E20A 13F900FF080B00FF	   534:     move.b  (STAGED_HINT_CTR).l,(HINT_Q0_CTR).l
02:0000E212 0817
02:0000E214 33F900FF080E00FF	   535:     move.w  (STAGED_EVENT_VSRAM).l,(HINT_Q0_VSRAM).l
02:0000E21C 0818
02:0000E21E 4E75            	   536:     rts
                            	   537: .aas_no_split:
02:0000E220 13FC000000FF081E	   538:     move.b  #0,(HINT_PEND_SPLIT).l
02:0000E228 13FC000000FF0816	   539:     move.b  #0,(HINT_Q_COUNT).l
02:0000E230 4E75            	   540:     rts
                            	   541: 
                            	   542: ;------------------------------------------------------------------------------
                            	   543: ; _ags_apply_active — Program VDP VSRAM/H-int state for the current frame from
                            	   544: ; the active queue/debug state set by _ags_activate_staged. For no-split and
                            	   545: ; intro dead-zone modes, the base VSRAM comes from ACTIVE_BASE_VSRAM.
                            	   546: ;
                            	   547: ; Clobbers D0.
                            	   548: ;------------------------------------------------------------------------------
                            	   549: _ags_apply_active:
02:0000E232 4A3900FF081F    	   550:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E238 6636            	   551:     bne.s   .aaa_split
                            	   552:     ; No-split path. When DMC is NOT active, do the full H-int off sequence.
                            	   553:     ; When DMC IS active, skip the Reg 10 / Reg 0 writes so dmc_trigger's
                            	   554:     ; HINT arm survives -- DMC only fires in no-split contexts (see
                            	   555:     ; dmc_trigger gate), so there's no scroll-split to service this frame.
02:0000E23A 4A3900FFE100    	   556:     tst.b   (dmc_active).l
02:0000E240 6610            	   557:     bne.s   .aaa_dmc_vsram_only
02:0000E242 33FC8AFF00C00004	   558:     move.w  #$8AFF,(VDP_CTRL).l             ; Reg 10 = $FF (inactive)
02:0000E24A 33FC800400C00004	   559:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: H-int off
                            	   560: .aaa_dmc_vsram_only:
02:0000E252 23FC4000001000C0	   561:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E25A 0004
02:0000E25C 33F900FF083600C0	   562:     move.w  (ACTIVE_BASE_VSRAM).l,(VDP_DATA).l
02:0000E264 0000
02:0000E266 7000            	   563:     moveq   #0,D0
02:0000E268 33C000C00000    	   564:     move.w  D0,(VDP_DATA).l
02:0000E26E 4E75            	   565:     rts
                            	   566: .aaa_split:
02:0000E270 23FC4000001000C0	   567:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E278 0004
02:0000E27A 7000            	   568:     moveq   #0,D0
02:0000E27C 0C39000100FF081F	   569:     cmpi.b  #INTRO_SCROLL_GAME_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E284 6706            	   570:     beq.s   .aaa_base_ready
02:0000E286 303900FF0836    	   571:     move.w  (ACTIVE_BASE_VSRAM).l,D0
                            	   572: .aaa_base_ready:
02:0000E28C 33C000C00000    	   573:     move.w  D0,(VDP_DATA).l
02:0000E292 7000            	   574:     moveq   #0,D0
02:0000E294 33C000C00000    	   575:     move.w  D0,(VDP_DATA).l
02:0000E29A 7000            	   576:     moveq   #0,D0
02:0000E29C 103900FF0817    	   577:     move.b  (HINT_Q0_CTR).l,D0
02:0000E2A2 024000FF        	   578:     andi.w  #$00FF,D0
02:0000E2A6 807C8A00        	   579:     or.w    #$8A00,D0
02:0000E2AA 33C000C00004    	   580:     move.w  D0,(VDP_CTRL).l                 ; Reg 10 = active H-int scanline
02:0000E2B0 33FC801400C00004	   581:     move.w  #$8014,(VDP_CTRL).l             ; Reg 0: enable H-int (+colorfix bit)
02:0000E2B8 4E75            	   582:     rts
                            	   583: 
                            	   584: ;------------------------------------------------------------------------------
                            	   585: ; _mode_transition_check — runs from VBlankISR after _ags_prearm, before
                            	   586: ; IsrNmi.  Detects a change in GameMode ($0012) against the LAST_GAMEMODE
                            	   587: ; shadow and, on transition, purges stale scroll latches, zeros the two
                            	   588: ; VSRAM words directly via the VDP control port, and rewinds the DynTileBuf
                            	   589: ; palette-precheck state so _patch_z06 P3 runs fresh on the new mode's
                            	   590: ; first tile transfer.
                            	   591: ;
                            	   592: ; Fixes VSRAM bleed-through seen when leaving attract → file-select →
                            	   593: ; gameplay: the new mode inherited the old mode's vertical scroll register
                            	   594: ; value for a single frame before the first _ags_flush landed.
                            	   595: ;
                            	   596: ; Preserves: D1-D7, A0-A6 (clobbers D0 internally and restores it).
                            	   597: ;------------------------------------------------------------------------------
                            	   598: _mode_transition_check:
02:0000E2BA 2F00            	   599:     move.l  D0,-(SP)
02:0000E2BC 102C0012        	   600:     move.b  ($0012,A4),D0
02:0000E2C0 B03900FF083E    	   601:     cmp.b   (LAST_GAMEMODE).l,D0
02:0000E2C6 6760            	   602:     beq.s   .mtc_done
                            	   603:     ; --- mode changed: latch new shadow and purge stale PPU state ---
02:0000E2C8 13C000FF083E    	   604:     move.b  D0,(LAST_GAMEMODE).l
02:0000E2CE 423900FF0800    	   605:     clr.b   (PPU_LATCH).l
02:0000E2D4 427900FF0802    	   606:     clr.w   (PPU_VADDR).l
02:0000E2DA 423900FF0809    	   607:     clr.b   (PPU_DHALF).l
