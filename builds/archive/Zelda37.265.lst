                            	  9573: UpdateGohma:
                            	  9574:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9575:     ;
02:0003CE04 41EC0451        	  9576:     lea     ($0451,A4),A0
02:0003CE08 10302000        	  9577:     move.b  (A0,D2.W),D0
02:0003CE0C 662C            	  9578:     bne  _L_z04_UpdateGohma_Move
                            	  9579:     ; If Random:
                            	  9580:     ;   >= $B0: right
                            	  9581:     ;   >= $60: left
                            	  9582:     ;   Else:   down
                            	  9583:     ;
02:0003CE0E 7001            	  9584:     moveq   #1,D0
02:0003CE10 7600            	  9585:     moveq   #0,D3
02:0003CE12 16342018        	  9586:     move.b  ($18,A4,D2.W),D3
02:0003CE16 0C0300B0        	  9587:     cmpi.b  #$B0,D3
02:0003CE1A 640A            	  9588:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003CE1C E308            	  9589:     lsl.b  #1,D0   ; ASL A
02:0003CE1E 0C030060        	  9590:     cmpi.b  #$60,D3
02:0003CE22 6402            	  9591:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003CE24 E308            	  9592:     lsl.b  #1,D0   ; ASL A
                            	  9593:     even
                            	  9594: _L_z04_UpdateGohma_ChangeDir:
02:0003CE26 41EC0098        	  9595:     lea     ($0098,A4),A0
02:0003CE2A 11802000        	  9596:     move.b  D0,(A0,D2.W)
                            	  9597:     ; Now we can go straight without changing direction for some time.
                            	  9598:     ;
02:0003CE2E 41EC0451        	  9599:     lea     ($0451,A4),A0
02:0003CE32 52302000        	  9600:     addq.b  #1,(A0,D2.W)
                            	  9601:     ; Go animate the eye.
                            	  9602:     ;
