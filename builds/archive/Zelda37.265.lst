                            	   818: ;------------------------------------------------------------------------------
                            	   819: ; _c_move_object_shim — MoveObject trampoline.
                            	   820: ;
                            	   821: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   822: ;   Input:     D2 = slot (0..11)
                            	   823: ;   Preserves: D2, A4, A5
                            	   824: ;   Clobbers:  D0, D1, D3, A0
                            	   825: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   826: ;
                            	   827: ; GCC side:
                            	   828: ;   void c_move_object(unsigned short slot);
                            	   829: ;     slot arrives as a 16-bit value on the stack.
                            	   830: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   831: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   832: ;   never clobbered by gcc.
                            	   833: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   834: ;   semantics can exist in a pure C port).
                            	   835: ;------------------------------------------------------------------------------
                            	   836: _c_move_object_shim:
                            	   837:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   838:     move.b  #$AA,($0900,A4)
                            	   839:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   840:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   841:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   842:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   843:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   844:     moveq   #0,D0
02:0002B658 3002            	   845:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   846:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   847:     jsr     c_move_object
02:0002B662 588F            	   848:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   849:     rts
                            	   850: 
                            	   851: ;==============================================================================
                            	   852: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   853: ; and tail-call the native asm function.
                            	   854: ;
                            	   855: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   856: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   857: ; sign-extended).
                            	   858: ;==============================================================================
                            	   859: 
                            	   860: ;------------------------------------------------------------------------------
                            	   861: ; void c_copy_bank_to_window(unsigned int bank);
                            	   862: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   863: ;------------------------------------------------------------------------------
                            	   864: c_copy_bank_to_window:
02:0002B666 202F0004        	   865:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   866:     jmp     _copy_bank_to_window
                            	   867: 
                            	   868: ;------------------------------------------------------------------------------
                            	   869: ; unsigned char c_ppu_read_2(void);
                            	   870: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   871: ; C return: gcc expects result in D0.
                            	   872: ;------------------------------------------------------------------------------
                            	   873: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   874:     jmp     _ppu_read_2
                            	   875: 
                            	   876: ;------------------------------------------------------------------------------
                            	   877: ; void c_ppu_write_6(unsigned int val);
                            	   878: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   879: ;------------------------------------------------------------------------------
                            	   880: c_ppu_write_6:
02:0002B674 202F0004        	   881:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   882:     jmp     _ppu_write_6
                            	   883: 
                            	   884: ;------------------------------------------------------------------------------
                            	   885: ; void c_ppu_write_7(unsigned int val);
                            	   886: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   887: ;------------------------------------------------------------------------------
                            	   888: c_ppu_write_7:
02:0002B67E 202F0004        	   889:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   890:     jmp     _ppu_write_7
                            	   891: 
                            	   892: ;------------------------------------------------------------------------------
                            	   893: ; void c_turn_off_all_video(void);
                            	   894: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   895: ;------------------------------------------------------------------------------
                            	   896: c_turn_off_all_video:
02:0002B688 4EF900049762    	   897:     jmp     TurnOffAllVideo
                            	   898: 
                            	   899: ;==============================================================================
                            	   900: ; EXPORT side — z_03 entry point.
                            	   901: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   902: ; the transpiler emits that label pointing to this shim instead of the
                            	   903: ; z_03 asm body. The C function takes no args and returns void.
                            	   904: ;==============================================================================
                            	   905: 
                            	   906: ;------------------------------------------------------------------------------
                            	   907: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   908: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   909: ;------------------------------------------------------------------------------
                            	   910: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   911:     jmp     z03_transfer_level_pattern_blocks
                            	   912: 
                            	   913: ;==============================================================================
                            	   914: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   915: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   916: ;==============================================================================
                            	   917: 
