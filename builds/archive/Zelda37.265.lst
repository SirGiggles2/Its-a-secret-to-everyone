02:0003DE36 19400003        	 11739:     move.b  D0,($0003,A4)
02:0003DE3A 102C0084        	 11740:     move.b  ($0084,A4),D0
02:0003DE3E 003C0011        	 11741:     ori     #$11,CCR  ; SEC: set C+X
02:0003DE42 41EC0084        	 11742:     lea     ($0084,A4),A0
02:0003DE46 12302000        	 11743:     move.b  (A0,D2.W),D1
02:0003DE4A 0A3C0010        	 11744:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DE4E 9101            	 11745:     subx.b  D1,D0   ; SBC ObjY,X
02:0003DE50 0A3C0010        	 11746:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DE54 640A            	 11747:     bcc  _anon_z04_154
02:0003DE56 122C0003        	 11748:     move.b  ($0003,A4),D1
02:0003DE5A E309            	 11749:     lsl.b  #1,D1   ; ASL $03
02:0003DE5C 19410003        	 11750:     move.b  D1,($0003,A4)
                            	 11751: _anon_z04_154:
                            	 11752:     ; If the horizontal direction toward Link is not allowed, then
                            	 11753:     ; go check the vertical direction.
                            	 11754:     ;
02:0003DE60 102C0002        	 11755:     move.b  ($0002,A4),D0
02:0003DE64 122C050F        	 11756:     move.b  ($050F,A4),D1
