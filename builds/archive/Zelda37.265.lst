                            	  5707: Moldorm_ChangeFlyingState:
                            	  5708:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5709:     ;
02:0003B1C2 61000096        	  5710:     jsr     Flyer_MoldormDecideState
02:0003B1C6 7010            	  5711:     moveq   #16,D0
02:0003B1C8 19802028        	  5712:     move.b  D0,($28,A4,D2.W)
                            	  5713:     ; If the next lower slot's direction <> 0, then
                            	  5714:     ; go propagate direction changes down the chain.
                            	  5715:     ;
                            	  5716:     ; But you had to have propagated directions once for the
                            	  5717:     ; next lower direction to be set. How does it happen?
                            	  5718:     ;
                            	  5719:     ; Within a flyer state, the flying routines turn the flyer
                            	  5720:     ; and set the object timer to $10 several times. After any of
                            	  5721:     ; those times will the test succeed.
                            	  5722:     ;
                            	  5723:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5724:     ; in this block to set the timer to $10, and try to propagate
                            	  5725:     ; directions.
                            	  5726:     ;
                            	  5727:     ; But this is also the case the first time here.
                            	  5728:     ;
                            	  5729:     ; So, I believe that the point of this test is to delay moving
                            	  5730:     ; the lower (not head) segments when starting out.
                            	  5731:     ;
02:0003B1CC 41EC0097        	  5732:     lea     ($0097,A4),A0
02:0003B1D0 10302000        	  5733:     move.b  (A0,D2.W),D0
02:0003B1D4 6702            	  5734:     beq.s  __far_z_04_0042
02:0003B1D6 601C            	  5735:     jmp  Moldorm_PropagateDirs
                            	  5736: __far_z_04_0042:
02:0003B1D8 4E75            	  5737:     rts
                            	  5738: 
                            	  5739:     even
                            	  5740: Moldorm_Wander:
                            	  5741:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5742:     ; Only the head controls the movement direction.
                            	  5743:     ;
02:0003B1DA 0C020005        	  5744:     cmpi.b  #$05,D2
02:0003B1DE 6708            	  5745:     beq  _anon_z04_82
02:0003B1E0 0C02000A        	  5746:     cmpi.b  #$0A,D2
02:0003B1E4 6702            	  5747:     beq.s  __far_z_04_0043
02:0003B1E6 6070            	  5748:     jmp  L1156B_Exit
