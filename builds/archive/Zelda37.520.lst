                            	  1205:     ;
02:0003892E 6728            	  1206:     beq  _L_z04__TryShooting_SetSpeed
                            	  1207:     ; shoot timer <> 0
                            	  1208:     ; If shoot timer <> $10, then go set a zero speed.
