                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:00038406 103C0080        	   455:     move.b  #$80,D0
02:0003840A 41EC00AC        	   456:     lea     ($00AC,A4),A0
