02:00038C50 0C030005        	  1654:     cmpi.b  #$05,D3
02:00038C54 640A            	  1655:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038C56 41EC0098        	  1656:     lea     ($0098,A4),A0
