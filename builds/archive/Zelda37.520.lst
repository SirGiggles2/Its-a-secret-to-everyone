                            	  4417: UpdateMode13WinGame_Sub1:
02:00034F1E 102C004D        	  4418:     move.b  ($004D,A4),D0
02:00034F22 672A            	  4419:     beq  _L_z02_UpdateMode13WinGame_Sub1_AdvanceSubmode
02:00034F24 4EB900046E86    	  4420:     jsr     HideAllSprites
                            	  4421:     ; Characters stop emitting when the long timer is $10.
                            	  4422:     ; So, keep showing Link and Zelda until it reaches 4.
