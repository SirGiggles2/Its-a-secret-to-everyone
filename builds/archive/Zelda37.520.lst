02:0003A594 103C0080        	  5177:     move.b  #$80,D0
02:0003A598 6100DCF4        	  5178:     jsr     UpdateCommonWanderer
02:0003A59C 4EB900031218    	  5179:     jsr     CheckMonsterCollisions
