02:00038450 7000            	   490:     moveq   #0,D0
02:00038452 41EC0405        	   491:     lea     ($0405,A4),A0
02:00038456 11803000        	   492:     move.b  D0,(A0,D3.W)
                            	   493:     ; The first animation frame lasts 3 screen frames.
