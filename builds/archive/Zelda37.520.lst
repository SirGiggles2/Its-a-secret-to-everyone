02:00038540 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:00038544 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:00038548 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:0003854C 7074            	   629:     moveq   #116,D0
02:0003854E 4EB900047298    	   630:     jsr     ChangeTileObjTiles
