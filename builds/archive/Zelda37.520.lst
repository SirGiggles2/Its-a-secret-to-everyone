                            	  6003: _L_z07_UpdateSwordOrRod_MakeMagicShot:
                            	  6004:     ; Play "magic shot" tune.
                            	  6005:     ;
02:00048C68 7004            	  6006:     moveq   #4,D0
02:00048C6A 19400604        	  6007:     move.b  D0,($0604,A4)
