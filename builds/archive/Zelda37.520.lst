                            	  6934: ChangePlayMapSquareOW:
02:00040A00 1002            	  6935:     move.b  D2,D0
02:00040A02 1B00            	  6936:     move.b  D0,-(A5)  ; PHA
                            	  6937:     ; We're dealing with squares.
                            	  6938:     ; So, align the object's X coordinate with 16 pixels.
                            	  6939:     ;
02:00040A04 10342070        	  6940:     move.b  ($70,A4,D2.W),D0
02:00040A08 020000F0        	  6941:     andi.b #$F0,D0
                            	  6942:     ; Divide it by 4 to get the offset of the address of the column
                            	  6943:     ; in play area map.
                            	  6944:     ;
                            	  6945:     ; The calculation is: address offset = (X / 8) * 2
                            	  6946:     ; 8 for the width of the column; 2 for the width of the address
                            	  6947:     ;
02:00040A0C E208            	  6948:     lsr.b  #1,D0   ; LSR A
02:00040A0E E208            	  6949:     lsr.b  #1,D0   ; LSR A
02:00040A10 7400            	  6950:     moveq   #0,D2
02:00040A12 1400            	  6951:     move.b  D0,D2
                            	  6952:     ; Store the address of the column in [00:01].
                            	  6953:     ;
02:00040A14 41F900046B92    	  6954:     lea     (PlayAreaColumnAddrs).l,A0
02:00040A1A 10302000        	  6955:     move.b  (A0,D2.W),D0
02:00040A1E 1880            	  6956:     move.b  D0,($0000,A4)
02:00040A20 41F900046B93    	  6957:     lea     (PlayAreaColumnAddrs+1).l,A0
02:00040A26 10302000        	  6958:     move.b  (A0,D2.W),D0
02:00040A2A 19400001        	  6959:     move.b  D0,($0001,A4)
02:00040A2E 101D            	  6960:     move.b  (A5)+,D0  ; PLA
02:00040A30 1B00            	  6961:     move.b  D0,-(A5)  ; PHA
02:00040A32 7400            	  6962:     moveq   #0,D2
02:00040A34 1400            	  6963:     move.b  D0,D2
                            	  6964:     ; Align the object's Y coordinate with 16 pixels.
                            	  6965:     ;
02:00040A36 41EC0084        	  6966:     lea     ($0084,A4),A0
02:00040A3A 10302000        	  6967:     move.b  (A0,D2.W),D0
02:00040A3E 020000F0        	  6968:     andi.b #$F0,D0
                            	  6969:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  6970:     ; the height of each row.
                            	  6971:     ;
02:00040A42 003C0011        	  6972:     ori     #$11,CCR  ; SEC: set C+X
02:00040A46 123C0040        	  6973:     move.b  #$40,D1
02:00040A4A 0A3C0010        	  6974:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040A4E 9101            	  6975:     subx.b  D1,D0   ; SBC #$40
02:00040A50 0A3C0010        	  6976:     eori    #$10,CCR  ; restore X = 6502 C
02:00040A54 E208            	  6977:     lsr.b  #1,D0   ; LSR A
02:00040A56 E208            	  6978:     lsr.b  #1,D0   ; LSR A
02:00040A58 E208            	  6979:     lsr.b  #1,D0   ; LSR A
                            	  6980:     ; Add this row offset to the column address.
                            	  6981:     ;
02:00040A5A 4EB900030B60    	  6982:     jsr     AddToInt16At0
                            	  6983:     ; Assume that we'll write a type 1 square with primary square
                            	  6984:     ; taken from [05]. If so, the square index doesn't matter
                            	  6985:     ; as long as >= $10. See WriteSquareOW.
                            	  6986:     ;
02:00040A60 7600            	  6987:     moveq   #0,D3
02:00040A62 7410            	  6988:     moveq   #16,D2
02:00040A64 102C0005        	  6989:     move.b  ($0005,A4),D0
                            	  6990:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  6991:     ; So, we have to look up the square index corresponding
                            	  6992:     ; to primary square/tile in [05].
                            	  6993:     ;
                            	  6994:     ; Look in primary square table from $E to 1. If a match is found,
                            	  6995:     ; then the X register will have the square index value.
                            	  6996:     ;
02:00040A68 0C000027        	  6997:     cmpi.b  #$27,D0
02:00040A6C 6506            	  6998:     bcs  _anon_z05_148
02:00040A6E 0C0000F3        	  6999:     cmpi.b  #$F3,D0
