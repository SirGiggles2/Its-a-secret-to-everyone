                            	  7146: _L_z07_InitObject_InitMonsterFromEdge:
02:0004955C 7400            	  7147:     moveq   #0,D2
02:0004955E 142C0340        	  7148:     move.b  ($0340,A4),D2
                            	  7149:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7150:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7151:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7152:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7153:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7154:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7155:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7156:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7157:     ; corrupting them and causing a deterministic address-error
                            	  7158:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7159:     ; identified by Codex static review.)
                            	  7160: _L_z07_P47_pre_check:
02:00049562 102C0525        	  7161:     move.b  ($0525,A4),D0
02:00049566 020000F0        	  7162:     andi.b  #$F0,D0
02:0004956A 0C000040        	  7163:     cmpi.b  #$40,D0
02:0004956E 6506            	  7164:     blo     _L_z07_P47_pre_snap
02:00049570 0C0000E0        	  7165:     cmpi.b  #$E0,D0
02:00049574 6506            	  7166:     blo     _L_z07_P47_pre_ok
                            	  7167: _L_z07_P47_pre_snap:
02:00049576 197C00480525    	  7168:     move.b  #$48,($0525,A4)
                            	  7169: _L_z07_P47_pre_ok:
02:0004957C 7005            	  7170:     moveq   #5,D0
02:0004957E 610004F4        	  7171:     jsr     SwitchBank
02:00049582 4EB90003E4BA    	  7172:     jsr     FindNextEdgeSpawnCell
                            	  7173:     ; Post-walk 1: bottom-edge snap.
02:00049588 102C0525        	  7174:     move.b  ($0525,A4),D0
02:0004958C 020000F0        	  7175:     andi.b  #$F0,D0
02:00049590 0C0000E0        	  7176:     cmpi.b  #$E0,D0
02:00049594 660C            	  7177:     bne     _L_z07_P47_post1_ok
02:00049596 197C00480525    	  7178:     move.b  #$48,($0525,A4)
02:0004959C 4EB90003E4BA    	  7179:     jsr     FindNextEdgeSpawnCell
                            	  7180: _L_z07_P47_post1_ok:
                            	  7181:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7182:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:000495A2 7600            	  7183:     moveq   #0,D3
02:000495A4 162C0525        	  7184:     move.b  ($0525,A4),D3
02:000495A8 0243000F        	  7185:     andi.w  #$000F,D3
02:000495AC C6FC002C        	  7186:     mulu.w  #44,D3
02:000495B0 203C00FF6530    	  7187:     move.l  #$FF6530,D0
02:000495B6 D083            	  7188:     add.l   D3,D0
02:000495B8 7600            	  7189:     moveq   #0,D3
02:000495BA 162C0525        	  7190:     move.b  ($0525,A4),D3
02:000495BE E84B            	  7191:     lsr.w   #4,D3
02:000495C0 5943            	  7192:     subi.w  #4,D3
02:000495C2 E34B            	  7193:     lsl.w   #1,D3
02:000495C4 D083            	  7194:     add.l   D3,D0
02:000495C6 2040            	  7195:     movea.l D0,A0
02:000495C8 1010            	  7196:     move.b  (A0),D0
02:000495CA 0C000084        	  7197:     cmpi.b  #$84,D0
02:000495CE 6544            	  7198:     blo     _L_z07_P47_post2_ok
                            	  7199:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7200:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7201:     ; writes to the $05xx region.
02:000495D0 7800            	  7202:     moveq   #0,D4
                            	  7203: _L_z07_P47_fb_loop:
02:000495D2 41FAE582        	  7204:     lea     _L_z07_P47_FallbackCells(pc),A0
02:000495D6 12304000        	  7205:     move.b  (A0,D4.W),D1
02:000495DA 19410525        	  7206:     move.b  D1,($0525,A4)
                            	  7207:     ; Validate fallback cell walkable.
02:000495DE 7600            	  7208:     moveq   #0,D3
02:000495E0 1601            	  7209:     move.b  D1,D3
02:000495E2 0243000F        	  7210:     andi.w  #$000F,D3
02:000495E6 C6FC002C        	  7211:     mulu.w  #44,D3
02:000495EA 203C00FF6530    	  7212:     move.l  #$FF6530,D0
02:000495F0 D083            	  7213:     add.l   D3,D0
02:000495F2 7600            	  7214:     moveq   #0,D3
02:000495F4 1601            	  7215:     move.b  D1,D3
02:000495F6 E84B            	  7216:     lsr.w   #4,D3
02:000495F8 5943            	  7217:     subi.w  #4,D3
02:000495FA E34B            	  7218:     lsl.w   #1,D3
02:000495FC D083            	  7219:     add.l   D3,D0
02:000495FE 2040            	  7220:     movea.l D0,A0
02:00049600 0C100084        	  7221:     cmpi.b  #$84,(A0)
02:00049604 650E            	  7222:     blo     _L_z07_P47_post2_ok
02:00049606 5204            	  7223:     addq.b  #1,D4
02:00049608 0C040008        	  7224:     cmpi.b  #8,D4
02:0004960C 65C4            	  7225:     blo     _L_z07_P47_fb_loop
                            	  7226:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7227:     ; rather than looping).
02:0004960E 197C00480525    	  7228:     move.b  #$48,($0525,A4)
                            	  7229: _L_z07_P47_post2_ok:
                            	  7230:     ; Extract and set the monster's location.
                            	  7231:     ;
02:00049614 102C0525        	  7232:     move.b  ($0525,A4),D0
                            	  7233:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7234:     ;
02:00049618 1B00            	  7235:     move.b  D0,-(A5)  ; PHA
02:0004961A E308            	  7236:     lsl.b  #1,D0   ; ASL A
02:0004961C E308            	  7237:     lsl.b  #1,D0   ; ASL A
02:0004961E E308            	  7238:     lsl.b  #1,D0   ; ASL A
02:00049620 E308            	  7239:     lsl.b  #1,D0   ; ASL A
02:00049622 19802070        	  7240:     move.b  D0,($70,A4,D2.W)
                            	  7241:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7242:     ;
02:00049626 101D            	  7243:     move.b  (A5)+,D0  ; PLA
02:00049628 020000F0        	  7244:     andi.b #$F0,D0
02:0004962C 003C0011        	  7245:     ori     #$11,CCR  ; SEC: set C+X
02:00049630 123C0003        	  7246:     move.b  #$03,D1
02:00049634 0A3C0010        	  7247:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049638 9101            	  7248:     subx.b  D1,D0   ; SBC #$03
02:0004963A 0A3C0010        	  7249:     eori    #$10,CCR  ; restore X = 6502 C
02:0004963E 41EC0084        	  7250:     lea     ($0084,A4),A0
02:00049642 11802000        	  7251:     move.b  D0,(A0,D2.W)
                            	  7252:     ; Set the monsters-from-edges long timer to a random value
                            	  7253:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7254:     ;
02:00049646 10342019        	  7255:     move.b  ($19,A4,D2.W),D0
02:0004964A 02000003        	  7256:     andi.b #$03,D0
02:0004964E 023C00EE        	  7257:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049652 123C0002        	  7258:     move.b  #$02,D1
02:00049656 D101            	  7259:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049658 1940004B        	  7260:     move.b  D0,($004B,A4)
                            	  7261:     ; If the distance to Link is too close to Link, then
                            	  7262:     ; go flag the monster uninitialized again, so we can
                            	  7263:     ; try to spawn it again next time.
                            	  7264:     ;
02:0004965C 7005            	  7265:     moveq   #5,D0
02:0004965E 61000414        	  7266:     jsr     SwitchBank
02:00049662 4EB90003DACE    	  7267:     jsr     IsDistanceSafeToSpawn
02:00049668 6500FEB4        	  7268:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7269:     ; OK to spawn.
                            	  7270:     ; In this situation, monsters don't spawn from a cloud.
                            	  7271:     ;
02:0004966C 7000            	  7272:     moveq   #0,D0
02:0004966E 41EC0405        	  7273:     lea     ($0405,A4),A0
02:00049672 11802000        	  7274:     move.b  D0,(A0,D2.W)
                            	  7275:     even
                            	  7276: _L_z07_InitObject_NormalSpawn:
02:00049676 7004            	  7277:     moveq   #4,D0
02:00049678 610003FA        	  7278:     jsr     SwitchBank
                            	  7279:     ; For monsters that spawn in a cloud, set their start time to
                            	  7280:     ; the same value as the object slot; so that they all start
                            	  7281:     ; moving at different times.
                            	  7282:     ;
02:0004967C 7400            	  7283:     moveq   #0,D2
02:0004967E 142C0340        	  7284:     move.b  ($0340,A4),D2
02:00049682 7600            	  7285:     moveq   #0,D3
02:00049684 41EC034F        	  7286:     lea     ($034F,A4),A0
02:00049688 16302000        	  7287:     move.b  (A0,D2.W),D3
02:0004968C 0C03001E        	  7288:     cmpi.b  #$1E,D3
02:00049690 6712            	  7289:     beq  _L_z07_InitObject_FetchAttrs
02:00049692 0C030022        	  7290:     cmpi.b  #$22,D3
02:00049696 670C            	  7291:     beq  _L_z07_InitObject_FetchAttrs
02:00049698 0C030053        	  7292:     cmpi.b  #$53,D3
02:0004969C 6406            	  7293:     bcc  _L_z07_InitObject_FetchAttrs
02:0004969E 1002            	  7294:     move.b  D2,D0
02:000496A0 19802028        	  7295:     move.b  D0,($28,A4,D2.W)
                            	  7296:     even
                            	  7297: _L_z07_InitObject_FetchAttrs:
                            	  7298:     ; Store the object attributes for fast access.
                            	  7299:     ;
02:000496A4 41F900049194    	  7300:     lea     (ObjectTypeToAttributes).l,A0
02:000496AA 10303000        	  7301:     move.b  (A0,D3.W),D0
02:000496AE 41EC04BF        	  7302:     lea     ($04BF,A4),A0
02:000496B2 11802000        	  7303:     move.b  D0,(A0,D2.W)
02:000496B6 1003            	  7304:     move.b  D3,D0
02:000496B8 1880            	  7305:     move.b  D0,($0000,A4)
                            	  7306:     ; Hit points are packed two values to a byte.
                            	  7307:     ; Divide the object type in half in order to index
                            	  7308:     ; into the hit points table.
                            	  7309:     ;
02:000496BA E208            	  7310:     lsr.b  #1,D0   ; LSR A
02:000496BC 7600            	  7311:     moveq   #0,D3
02:000496BE 1600            	  7312:     move.b  D0,D3
02:000496C0 41F9000491F4    	  7313:     lea     (ObjectTypeToHpPairs).l,A0
02:000496C6 10303000        	  7314:     move.b  (A0,D3.W),D0
