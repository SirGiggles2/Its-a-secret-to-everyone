02:000383A8 41EC0098        	   402:     lea     ($0098,A4),A0
02:000383AC 10302000        	   403:     move.b  (A0,D2.W),D0
02:000383B0 41EC03F8        	   404:     lea     ($03F8,A4),A0
02:000383B4 11802000        	   405:     move.b  D0,(A0,D2.W)
                            	   406:     ; Goriya will throw a boomerang (object type $5C).
                            	   407:     ;
02:000383B8 705C            	   408:     moveq   #92,D0
                            	   409:     ; If the monster is a blue goriya, go check the timer.
                            	   410:     ;
02:000383BA 7600            	   411:     moveq   #0,D3
02:000383BC 41EC034F        	   412:     lea     ($034F,A4),A0
02:000383C0 16302000        	   413:     move.b  (A0,D2.W),D3
02:000383C4 0C030005        	   414:     cmpi.b  #$05,D3
02:000383C8 671C            	   415:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   416:     ; If it's not a red goriya either, then return.
