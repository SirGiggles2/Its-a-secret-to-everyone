                            	  3955: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  3956:     ;
                            	  3957:     ;
                            	  3958:     ; [0E] holds reverse index of doorway direction found.
                            	  3959:     ;
02:0003E7B4 1943000E        	  3960:     move.b  D3,($000E,A4)
                            	  3961:     ; Store input direction in [02] and [0C].
                            	  3962:     ;
02:0003E7B8 102C03F8        	  3963:     move.b  ($03F8,A4),D0
02:0003E7BC 0200000F        	  3964:     andi.b #$0F,D0
