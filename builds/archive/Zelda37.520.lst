02:0003FDD6 7630            	  5589:     moveq   #48,D3
02:0003FDD8 19430028        	  5590:     move.b  D3,($0028,A4)
                            	  5591: _anon_z05_119:
02:0003FDDC 02000003        	  5592:     andi.b #$03,D0
