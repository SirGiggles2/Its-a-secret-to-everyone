Source: "audio_driver.asm"
                            	  1420: 

Source: "genesis_shell.asm"
                            	   715:     include "nes_io.asm"

Source: "nes_io.asm"
                            	     1: ;==============================================================================
                            	     2: ; nes_io.asm — NES I/O emulation layer
                            	     3: ;
                            	     4: ; Included by genesis_shell.asm BEFORE z_07.asm (and all other bank files).
                            	     5: ; Provides real implementations of all _ppu_*, _apu_*, _ctrl_*, _oam_*,
                            	     6: ; _mmc1_* helpers that the transpiled Zelda code calls via BSR/JSR.
                            	     7: ;
                            	     8: ; T5 milestone: PPUADDR two-write latch + PPUDATA → Genesis VDP VRAM byte writes.
                            	     9: ;
                            	    10: ; Register contract (must match transpiler mapping):
                            	    11: ;   D0  = NES accumulator A
                            	    12: ;   D2  = NES X index
                            	    13: ;   D3  = NES Y index
                            	    14: ;   D7  = NES SP shadow
                            	    15: ;   A4  = NES RAM base ($FF0000)
                            	    16: ;   A5  = NES stack pointer (NES_RAM + $0100 region)
                            	    17: ;
                            	    18: ; All NES I/O functions must preserve D1–D7, A0–A6 except as documented.
                            	    19: ; They receive their argument in D0.b and return results in D0.b.
                            	    20: ;==============================================================================
                            	    21: 
                            	    22: ;------------------------------------------------------------------------------
                            	    23: ; CHR_EXPANSION_ENABLED — feature flag for the 4x sprite CHR expansion.
                            	    24: ;
                            	    25: ; When 1: every sprite CHR tile is stored in Gen VRAM as 4 copies, each with
                            	    26: ;   pixel values pre-biased +0/+4/+8/+12 to index into packed PAL2 slots
                            	    27: ;   0..15.  _oam_dma selects the copy via tile-index bias; tile word palette
                            	    28: ;   bits are always %10 (PAL2).  NES $3F10-$3F1F palette writes pack into
                            	    29: ;   PAL2 slots 0..15 sequentially.  This preserves all 4 NES sprite sub-
                            	    30: ;   palettes simultaneously, eliminating the multiplex loss.
                            	    31: ;
                            	    32: ; When 0: legacy last-write-wins sprite palette multiplex (SP0,SP2→PAL2,
                            	    33: ;   SP1,SP3→PAL3).  Default until the expansion path is fully verified.
                            	    34: ;
                            	    35: ; See memory/project_chr_expansion.md for the staged rollout plan.
                            	    36: ;------------------------------------------------------------------------------
                            	    37: CHR_EXPANSION_ENABLED equ 1
                            	    38: 
                            	    39: ;------------------------------------------------------------------------------
                            	    40: ; PPU state RAM — placed at $FF0800 (immediately after 2KB NES work RAM).
                            	    41: ; Initialised to zero by genesis_shell before jsr IsrReset.
                            	    42: ;
                            	    43: ; Layout (12 bytes):
                            	    44: ;   +0  PPU_LATCH   (byte) write-toggle shared by $2005/$2006 (0=1st, 1=2nd)
                            	    45: ;   +1  (pad)
                            	    46: ;   +2  PPU_VADDR   (word) assembled 16-bit VRAM address
                            	    47: ;   +4  PPU_CTRL    (byte) PPUCTRL  ($2000) shadow
                            	    48: ;   +5  PPU_MASK    (byte) PPUMASK  ($2001) shadow
                            	    49: ;   +6  PPU_SCRL_X  (byte) scroll X (from first  $2005 write)
                            	    50: ;   +7  PPU_SCRL_Y  (byte) scroll Y (from second $2005 write)
                            	    51: ;   +8  PPU_DBUF    (byte) PPUDATA even-address byte buffer
                            	    52: ;   +9  PPU_DHALF   (byte) 1 when an even-address byte is buffered
                            	    53: ;   +10 (pad × 2)
                            	    54: ;------------------------------------------------------------------------------
                            	    55: PPU_STATE_BASE  equ $00FF0800
                            	    56: 
                            	    57: PPU_LATCH       equ PPU_STATE_BASE+0    ; byte: w register (0=first write)
                            	    58: PPU_VADDR       equ PPU_STATE_BASE+2    ; word: current VRAM address
                            	    59: PPU_CTRL        equ PPU_STATE_BASE+4    ; byte: PPUCTRL shadow
                            	    60: PPU_MASK        equ PPU_STATE_BASE+5    ; byte: PPUMASK shadow
                            	    61: PPU_SCRL_X      equ PPU_STATE_BASE+6    ; byte: horizontal scroll value
                            	    62: PPU_SCRL_Y      equ PPU_STATE_BASE+7    ; byte: vertical scroll value
                            	    63: PPU_DBUF        equ PPU_STATE_BASE+8    ; byte: buffered even-addr byte
                            	    64: PPU_DHALF       equ PPU_STATE_BASE+9    ; byte: 1 if even-addr byte pending
                            	    65: PPU_S0_TOGGLE   equ PPU_STATE_BASE+10   ; byte: toggles bit 6 across _ppu_read_2 calls
                            	    66:                                          ; so both wait-for-set and wait-for-clear
                            	    67:                                          ; sprite-0 loops terminate on Genesis.
                            	    68: ;------------------------------------------------------------------------------
                            	    69: ; MMC1 state RAM — placed at $FF0810 (immediately after 16-byte PPU block).
                            	    70: ; Initialised to zero by genesis_shell before jsr IsrReset.
                            	    71: ;
                            	    72: ; Layout (6 bytes):
                            	    73: ;   +0  MMC1_SHIFT  (byte) shift register accumulator (LSB-first)
                            	    74: ;   +1  MMC1_COUNT  (byte) number of bits accumulated (0–4)
                            	    75: ;   +2  MMC1_CTRL   (byte) MMC1 control register ($8000 target)
                            	    76: ;   +3  MMC1_CHR0   (byte) CHR bank 0 register   ($A000 target)
                            	    77: ;   +4  MMC1_CHR1   (byte) CHR bank 1 register   ($C000 target)
                            	    78: ;   +5  MMC1_PRG    (byte) PRG bank register      ($E000 target)
                            	    79: ;------------------------------------------------------------------------------
                            	    80: MMC1_STATE_BASE equ PPU_STATE_BASE+$10  ; $FF0810
                            	    81: 
                            	    82: MMC1_SHIFT      equ MMC1_STATE_BASE+0   ; byte: shift accumulator
                            	    83: MMC1_COUNT      equ MMC1_STATE_BASE+1   ; byte: bits accumulated (0-4)
                            	    84: MMC1_CTRL       equ MMC1_STATE_BASE+2   ; byte: control reg ($8000)
                            	    85: MMC1_CHR0       equ MMC1_STATE_BASE+3   ; byte: CHR bank 0 ($A000)
                            	    86: MMC1_CHR1       equ MMC1_STATE_BASE+4   ; byte: CHR bank 1 ($C000)
                            	    87: MMC1_PRG        equ MMC1_STATE_BASE+5   ; byte: PRG bank ($E000)
                            	    88: 
                            	    89: ;------------------------------------------------------------------------------
                            	    90: ; CHR tile upload buffer — placed at $FF0820.
                            	    91: ; Accumulates one 16-byte NES 2BPP tile then converts it to Genesis 4BPP (32 bytes)
                            	    92: ; and DMA-writes the result to VDP VRAM.
                            	    93: ;
                            	    94: ; Layout (21 bytes):
                            	    95: ;   +0…+15  CHR_TILE_BUF  (16 bytes) raw NES 2BPP tile data
                            	    96: ;              bytes 0–7  = plane 0 (bit 0 of each pixel, row 0 first)
                            	    97: ;              bytes 8–15 = plane 1 (bit 1 of each pixel, row 0 first)
                            	    98: ;   +16     CHR_BUF_CNT   (byte) number of bytes accumulated (0–15)
                            	    99: ;   +17     (pad byte — keeps CHR_BUF_VADDR word-aligned)
                            	   100: ;   +18–19  CHR_BUF_VADDR (word) NES PPU address at start of this tile  ← $FF0832 (even)
                            	   101: ;   +20     CHR_HIT_COUNT (byte) total CHR write calls (debug counter)
                            	   102: ;------------------------------------------------------------------------------
                            	   103: CHR_STATE_BASE  equ PPU_STATE_BASE+$20  ; $FF0820
                            	   104: 
                            	   105: CHR_TILE_BUF    equ CHR_STATE_BASE+0    ; 16 bytes: raw NES tile bytes
                            	   106: CHR_BUF_CNT     equ CHR_STATE_BASE+16   ; byte: bytes accumulated
                            	   107:                                          ; +17: pad byte (alignment)
                            	   108: CHR_BUF_VADDR   equ CHR_STATE_BASE+18   ; word: tile's NES base address ($FF0832, even)
                            	   109: CHR_HIT_COUNT   equ CHR_STATE_BASE+20   ; byte: total CHR write calls (debug counter)
                            	   110: 
                            	   111: ;------------------------------------------------------------------------------
                            	   112: ; Nametable tile-index cache — placed at $FF0840.
                            	   113: ; 32 × 60 = 1920 bytes (NT0 rows 0-29 + NT1 rows 30-59 for V64 plane).
                            	   114: ; NT_CACHE[row*32 + col] = tile index.  NT1 entries at offset 960.
                            	   115: ;------------------------------------------------------------------------------
                            	   116: NT_CACHE_BASE   equ CHR_STATE_BASE+$20  ; $FF0840  (32×60 = 1920 bytes)
                            	   117: NT_ATTR_CACHE_BASE equ $00FF1400        ; 32×60 = 1920 bytes, raw palette id per tile
                            	   118: 
                            	   119: ;------------------------------------------------------------------------------
                            	   120: ; Staged scroll state written by _ags_flush and consumed by _ags_prearm on the
                            	   121: ; next frame. Lives in the unused tail of the PPU shadow block at $FF080A..0F.
                            	   122: ;------------------------------------------------------------------------------
                            	   123: STAGED_SCROLL_MODE equ PPU_STATE_BASE+$0A ; byte: next-frame mode
                            	   124: STAGED_HINT_CTR    equ PPU_STATE_BASE+$0B ; byte: next-frame Reg 10 counter
                            	   125: STAGED_BASE_VSRAM  equ PPU_STATE_BASE+$0C ; word: next-frame start-of-frame VSRAM
                            	   126: STAGED_EVENT_VSRAM equ PPU_STATE_BASE+$0E ; word: next-frame H-int VSRAM
                            	   127: 
                            	   128: ;------------------------------------------------------------------------------
                            	   129: ; Active scroll state promoted by _ags_prearm and consumed by the currently
                            	   130: ; rendered frame. Stored in the unused tail between CHR state and NT cache.
                            	   131: ;------------------------------------------------------------------------------
                            	   132: ACTIVE_BASE_VSRAM  equ CHR_STATE_BASE+$16 ; $FF0836 word: current-frame base VSRAM
                            	   133: ACTIVE_EVENT_VSRAM equ CHR_STATE_BASE+$18 ; $FF0838 word: current-frame event VSRAM
                            	   134: ACTIVE_HINT_CTR    equ CHR_STATE_BASE+$1A ; $FF083A byte: current-frame Reg 10 counter
                            	   135: 
                            	   136: ;------------------------------------------------------------------------------
                            	   137: ; Phase 1 (diary re-integration) state.
                            	   138: ;
                            	   139: ; VRamForceBlankGate — when set (=1), _ppu_write_1 forces PPUMASK video-enable
                            	   140: ;   bits ($18) off so the VDP stays in force-blank.  Held while UpdateMode0/1
                            	   141: ;   init is streaming CHR/VRAM and cleared by the transpiler-injected marker
                            	   142: ;   at the end of the full init chain (_patch_z02).  Prevents a beam-race
                            	   143: ;   visible when Start is pressed at certain frame phases.
                            	   144: ;
                            	   145: ; LAST_GAMEMODE — shadow of $0012 (GameMode) read by _mode_transition_check
                            	   146: ;   from VBlankISR.  On change the check re-zeros PPU latch/address/scroll
                            	   147: ;   state and direct-writes 0 to VSRAM[0]/[1] so scroll bleed from the prior
                            	   148: ;   mode cannot contaminate the new mode's first frame.  Seeded to $FF at
                            	   149: ;   cold boot so the first frame always fires a transition. Kept out of the
                            	   150: ;   MMC1 block so mapper writes cannot stomp the mode-transition shadow.
                            	   151: ;------------------------------------------------------------------------------
                            	   152: VRamForceBlankGate equ CHR_STATE_BASE+$1D ; $FF083D byte: 1 = force-blank hold
                            	   153: LAST_GAMEMODE      equ CHR_STATE_BASE+$1E ; $FF083E byte: shadow of $0012
                            	   154: ; Attempt 6a: FrontendStartReleaseGate — set by UpdateMode0Demo_Sub0 at the
                            	   155: ; moment title mode accepts Start and begins the file-select init chain.
                            	   156: ; While non-zero, UpdateMode1Menu_Sub0 ignores Start so the held press from
                            	   157: ; the title transition cannot immediately punch through to gameplay.
                            	   158: ; Cleared the frame the Start button bit ($00F8 & $10) first becomes zero.
                            	   159: FrontendStartReleaseGate equ $FF042B ; 1 byte in NES scratch-record region
                            	   160: ;------------------------------------------------------------------------------
                            	   161: ; Demand-driven NES PRG bank window (P33).
                            	   162: ;
                            	   163: ; Non-jump .ADDR tables now hold true NES CPU addresses ($8000-$BFFF).  Table
                            	   164: ; consumers add NES_RAM and dereference, so we mirror the active 16KB PRG bank
                            	   165: ; image at $FF8000. Then NES_RAM + $8xxx resolves into this window.
                            	   166: ;------------------------------------------------------------------------------
                            	   167: BANK_WINDOW_BASE      equ $00FF8000
                            	   168: BANK_WINDOW_SIZE      equ $4000
                            	   169: _current_window_bank  equ $00FF083F ; byte cache: last copied bank ($FF = none)
                            	   170: ;------------------------------------------------------------------------------
                            	   171: ; Scroll composition modes shared between staged state and INTRO_SCROLL_MODE.
                            	   172: ;------------------------------------------------------------------------------
                            	   173: INTRO_SCROLL_NO_SPLIT   equ 0
                            	   174: INTRO_SCROLL_GAME_SPLIT equ 1
                            	   175: 
                            	   176: ;------------------------------------------------------------------------------
                            	   177: ; SAT shadow (Phase 1: VDP DMA for OAM).
                            	   178: ;
                            	   179: ; Double-buffered Genesis sprite attribute table mirror in 68k RAM.
                            	   180: ;   SAT_SHADOW_A at $FF2000 (512 bytes) — bank A
                            	   181: ;   SAT_SHADOW_B at $FF2200 (512 bytes) — bank B
                            	   182: ;   SAT_ACTIVE_BANK at $FF2400 (byte) — 0=A, 1=B; bank currently FILLED by _oam_dma
                            	   183: ;
                            	   184: ; Flow:
                            	   185: ;   Frame N: _oam_dma writes SAT_SHADOW_[A|B] at bank = SAT_ACTIVE_BANK.
                            	   186: ;   Frame N+1 VBlankISR (top): _oam_dma_flush DMAs that same bank into
                            	   187: ;     VRAM $F800, then flips SAT_ACTIVE_BANK. Frame N+1's _oam_dma then
                            	   188: ;     writes the other bank.
                            	   189: ; One-frame OAM display latency — standard Genesis pattern.
                            	   190: ;
                            	   191: ; Address range $FF2000-$FF2400 confirmed clear of APU shadow ($FF0A00),
                            	   192: ; NT_CACHE ($FF0840-$FF0FBF), probe counters ($FF1000-), FileBChecksums
                            	   193: ; ($FF1200), NT_ATTR_CACHE ($FF1400-$FF1B7F), and NES_SRAM ($FF6000).
                            	   194: ;------------------------------------------------------------------------------
                            	   195: SAT_SHADOW_A        equ $00FF2000
                            	   196: SAT_SHADOW_B        equ $00FF2200
                            	   197: SAT_SHADOW_SIZE     equ 512
                            	   198: SAT_ACTIVE_BANK     equ $00FF2400
                            	   199: 
                            	   200: ;==============================================================================
                            	   201: ; PPU register reads ($2000–$2007 → _ppu_read_0 … _ppu_read_7)
                            	   202: ;==============================================================================
                            	   203: 
                            	   204: ;------------------------------------------------------------------------------
                            	   205: ; _ppu_read_0 — PPUCTRL ($2000) — write-only on real NES, reads return open bus.
                            	   206: ; Return 0 so caller's AND/BEQ tests see nothing set.
                            	   207: ;------------------------------------------------------------------------------
                            	   208: _ppu_read_0:
02:0000E0D4 7000            	   209:     moveq   #0,D0
02:0000E0D6 4E75            	   210:     rts
                            	   211: 
                            	   212: ;------------------------------------------------------------------------------
                            	   213: ; _ppu_read_1 — PPUMASK ($2001) — write-only, open bus.
                            	   214: ;------------------------------------------------------------------------------
                            	   215: _ppu_read_1:
02:0000E0D8 7000            	   216:     moveq   #0,D0
02:0000E0DA 4E75            	   217:     rts
                            	   218: 
                            	   219: ;------------------------------------------------------------------------------
                            	   220: ; _ppu_read_2 — PPUSTATUS ($2002)
                            	   221: ;
                            	   222: ; Bit 7 = VBlank flag.  Cleared on read.  The shared write-latch (w) is also
                            	   223: ; reset on any $2002 read.
                            	   224: ;
                            	   225: ; T5 implementation: always returns $80 (VBlank always set) so IsrReset's
                            	   226: ; two warmup polling loops exit immediately.  A real VBlank flag will be
                            	   227: ; wired in T6 (software flag toggled by VBlankISR).
                            	   228: ;
                            	   229: ; IMPORTANT: must reset the PPU write-latch (PPU_LATCH).
                            	   230: ;------------------------------------------------------------------------------
                            	   231: _ppu_read_2:
02:0000E0DC 423900FF0800    	   232:     clr.b   (PPU_LATCH).l          ; reading $2002 resets the w register
                            	   233:     ; b7 (VBlank) always set — exits warmup loops.
                            	   234:     ; b6 (sprite-0-hit) toggles each call — lets BOTH wait-for-set
                            	   235:     ; (WaitAndScrollToSplitBottom, z_05:1530) AND wait-for-clear
                            	   236:     ; (IsrNmi_WaitVBlankEnd, z_07:1533) loops terminate in ≤2 iters.
                            	   237:     ; Gen has no scanline split — skipping is correct.
02:0000E0E2 103900FF080A    	   238:     move.b  (PPU_S0_TOGGLE).l,D0
02:0000E0E8 0A000040        	   239:     eori.b  #$40,D0
02:0000E0EC 13C000FF080A    	   240:     move.b  D0,(PPU_S0_TOGGLE).l
02:0000E0F2 00000080        	   241:     ori.b   #$80,D0                ; always assert VBlank bit
02:0000E0F6 4E75            	   242:     rts
                            	   243: 
                            	   244: ;------------------------------------------------------------------------------
                            	   245: ; _ppu_read_3 — OAM addr ($2003) — write-only.
                            	   246: ; _ppu_read_4 — OAM data ($2004) — return 0 for now.
                            	   247: ; _ppu_read_5 — PPUSCROLL ($2005) — write-only.
                            	   248: ; _ppu_read_6 — PPUADDR  ($2006) — write-only.
                            	   249: ;------------------------------------------------------------------------------
                            	   250: _ppu_read_3:
                            	   251: _ppu_read_4:
                            	   252: _ppu_read_5:
                            	   253: _ppu_read_6:
02:0000E0F8 7000            	   254:     moveq   #0,D0
02:0000E0FA 4E75            	   255:     rts
                            	   256: 
                            	   257: ;------------------------------------------------------------------------------
                            	   258: ; _ppu_read_7 — PPUDATA ($2007) read
                            	   259: ;
                            	   260: ; T5: return 0.  Palette reads have a special one-cycle-delay buffer on real
                            	   261: ; NES hardware.  No reads of $2007 in Zelda's critical path; defer to T8+.
                            	   262: ;------------------------------------------------------------------------------
                            	   263: _ppu_read_7:
02:0000E0FC 7000            	   264:     moveq   #0,D0
02:0000E0FE 4E75            	   265:     rts
                            	   266: 
                            	   267: ;==============================================================================
                            	   268: ; PPU register writes ($2000–$2007 → _ppu_write_0 … _ppu_write_7)
                            	   269: ;==============================================================================
                            	   270: 
                            	   271: ;------------------------------------------------------------------------------
                            	   272: ; _ppu_write_0 — PPUCTRL ($2000)
                            	   273: ;
                            	   274: ; D0.b = value to write.
                            	   275: ; Bits of interest:
                            	   276: ;   bit 2 = VRAM address increment (0 → +1 horizontal, 1 → +32 vertical)
                            	   277: ;   bit 7 = NMI enable (0 = disable, 1 = enable on VBlank)
                            	   278: ;
                            	   279: ; We store the value so _ppu_write_7 can read the increment flag.
                            	   280: ; NMI enable is handled at the hardware level (VBlank ISR always fires);
                            	   281: ; Zelda controls this register to gate per-frame updates.
                            	   282: ;------------------------------------------------------------------------------
                            	   283: _ppu_write_0:
                            	   284:     ; Check if bit 4 (BG pattern table) changed — if so, update Plane A tiles
02:0000E100 123900FF0804    	   285:     move.b  (PPU_CTRL).l,D1
02:0000E106 B101            	   286:     eor.b   D0,D1                   ; D1 = changed bits
02:0000E108 13C000FF0804    	   287:     move.b  D0,(PPU_CTRL).l         ; store new value
02:0000E10E 08010004        	   288:     btst    #4,D1
02:0000E112 6602            	   289:     bne.s   .ppuw0_pt_changed
02:0000E114 4E75            	   290:     rts
                            	   291: .ppuw0_pt_changed:
                            	   292:     ; BG pattern table bit changed.  Rebuild all 960 Plane A tile words from
                            	   293:     ; NT_CACHE, applying the new PPUCTRL bit 4 offset.  Palette bits are set
                            	   294:     ; to 0 (subsequent attribute processing will restore correct palettes).
02:0000E116 48E7FCC0        	   295:     movem.l D0-D5/A0-A1,-(SP)
                            	   296: 
02:0000E11A 41F900FF0840    	   297:     lea     (NT_CACHE_BASE).l,A0
02:0000E120 343CC000        	   298:     move.w  #$C000,D2               ; Plane A VDP address
                            	   299: 
02:0000E124 761D            	   300:     moveq   #30-1,D3                ; 30 rows
                            	   301: .ppuw0_row:
02:0000E126 781F            	   302:     moveq   #32-1,D4                ; 32 cols
                            	   303: .ppuw0_col:
                            	   304:     ; Build tile word from NT_CACHE
02:0000E128 7000            	   305:     moveq   #0,D0
02:0000E12A 1018            	   306:     move.b  (A0)+,D0                ; raw tile index from cache
02:0000E12C 61000856        	   307:     bsr     _compose_bg_tile_word
                            	   308: 
                            	   309:     ; Issue VDP write command for current Plane A address
02:0000E130 7200            	   310:     moveq   #0,D1
02:0000E132 3202            	   311:     move.w  D2,D1
02:0000E134 028100003FFF    	   312:     andi.l  #$00003FFF,D1
02:0000E13A 4841            	   313:     swap    D1
02:0000E13C 008140000003    	   314:     ori.l   #$40000003,D1
02:0000E142 23C100C00004    	   315:     move.l  D1,(VDP_CTRL).l
02:0000E148 33C000C00000    	   316:     move.w  D0,(VDP_DATA).l
                            	   317: 
02:0000E14E 5442            	   318:     addq.w  #2,D2                   ; next col
02:0000E150 51CCFFD6        	   319:     dbf     D4,.ppuw0_col
                            	   320: 
02:0000E154 06420040        	   321:     addi.w  #$40,D2                 ; skip 32 unused cols in 64-wide plane
02:0000E158 51CBFFCC        	   322:     dbf     D3,.ppuw0_row
                            	   323: 
02:0000E15C 4CDF033F        	   324:     movem.l (SP)+,D0-D5/A0-A1
02:0000E160 4E75            	   325:     rts
                            	   326: 
                            	   327: ;------------------------------------------------------------------------------
                            	   328: ; _ppu_write_1 — PPUMASK ($2001)
                            	   329: ; Store shadow for potential video-enable logic in T6+.
                            	   330: ;
                            	   331: ; Phase 1 gate: if VRamForceBlankGate is set, the incoming D0 has its
                            	   332: ; BG/sprite enable bits ($18) masked off and the PPU_MASK shadow is stored
                            	   333: ; with those bits cleared.  This keeps the VDP in force-blank while an init
                            	   334: ; chain (UpdateMode0Demo_Sub0 → InitMode1_Sub6) is still streaming VRAM,
                            	   335: ; so an ill-timed Start press cannot make the VDP race the beam while tiles
                            	   336: ; are mid-DMA.  The gate is released by the transpiler marker at the end of
                            	   337: ; InitMode1_Sub6 (see _patch_z02 P11).
                            	   338: ;------------------------------------------------------------------------------
                            	   339: _ppu_write_1:
02:0000E162 4A3900FF083D    	   340:     tst.b   (VRamForceBlankGate).l
02:0000E168 6704            	   341:     beq.s   .ppuw1_no_gate
02:0000E16A 020000E7        	   342:     andi.b  #$E7,D0                 ; clear bits 3+4 (BG + sprite enable)
                            	   343: .ppuw1_no_gate:
02:0000E16E 13C000FF0805    	   344:     move.b  D0,(PPU_MASK).l
                            	   345:     ; Toggle VDP display enable to match NES PPUMASK rendering state.
                            	   346:     ; When NES BG+sprites are off (bits 3-4 = 0), blank the Genesis display
                            	   347:     ; to prevent stale VRAM content from showing during mode transitions.
02:0000E174 3F00            	   348:     move.w  D0,-(SP)
02:0000E176 02000018        	   349:     andi.b  #$18,D0                 ; isolate BG (bit 3) + sprites (bit 4)
02:0000E17A 660C            	   350:     bne.s   .ppuw1_display_on
                            	   351:     ; Display OFF: VDP Reg 1 = $34 (display disabled, VBlank IRQ, DMA, M5)
02:0000E17C 33FC813400C00004	   352:     move.w  #$8134,(VDP_CTRL).l
02:0000E184 301F            	   353:     move.w  (SP)+,D0
02:0000E186 4E75            	   354:     rts
                            	   355: .ppuw1_display_on:
                            	   356:     ; Display ON: VDP Reg 1 = $74 (display enabled, VBlank IRQ, DMA, M5)
02:0000E188 33FC817400C00004	   357:     move.w  #$8174,(VDP_CTRL).l
02:0000E190 301F            	   358:     move.w  (SP)+,D0
02:0000E192 4E75            	   359:     rts
                            	   360: 
                            	   361: ;------------------------------------------------------------------------------
                            	   362: ; _ppu_write_2 — PPUSTATUS ($2002) — write-only on real NES (no effect).
                            	   363: ;------------------------------------------------------------------------------
                            	   364: _ppu_write_2:
02:0000E194 4E75            	   365:     rts
                            	   366: 
                            	   367: ;------------------------------------------------------------------------------
                            	   368: ; _ppu_write_3 — OAM address ($2003) — store for future OAM DMA logic.
                            	   369: ;------------------------------------------------------------------------------
                            	   370: _ppu_write_3:
02:0000E196 4E75            	   371:     rts
                            	   372: 
                            	   373: ;------------------------------------------------------------------------------
                            	   374: ; _ppu_write_4 — OAM data ($2004) — T5: stub (OAM DMA via $4014 covers Zelda).
                            	   375: ;------------------------------------------------------------------------------
                            	   376: _ppu_write_4:
02:0000E198 4E75            	   377:     rts
                            	   378: 
                            	   379: ;------------------------------------------------------------------------------
                            	   380: ; _ppu_write_5 — PPUSCROLL ($2005)
                            	   381: ;
                            	   382: ; First  write (PPU_LATCH=0): horizontal scroll → PPU_SCRL_X, latch → 1.
                            	   383: ; Second write (PPU_LATCH=1): vertical   scroll → PPU_SCRL_Y, latch → 0.
                            	   384: ;
                            	   385: ; Writing to VDP scroll registers is deferred to T6 (visual output pass).
                            	   386: ; For T5 we just store the values so they're available when needed.
                            	   387: ;------------------------------------------------------------------------------
                            	   388: _ppu_write_5:
                            	   389:     ; Phase 9: PPU_SCRL_X / PPU_SCRL_Y stores removed (dead — never read).
                            	   390:     ; Genesis scroll is driven by _ags_* machinery from NES RAM gameplay
                            	   391:     ; state, not these $2005 shadow bytes.  Latch toggle retained for
                            	   392:     ; $2006 PPUADDR correctness (shares write-toggle with $2005 on NES).
02:0000E19A 103900FF0800    	   393:     move.b  (PPU_LATCH).l,D0          ; reuse D0 (scroll byte discarded)
02:0000E1A0 0A000001        	   394:     eori.b  #1,D0
02:0000E1A4 13C000FF0800    	   395:     move.b  D0,(PPU_LATCH).l
02:0000E1AA 4E75            	   396:     rts
                            	   397: 
                            	   398: ;------------------------------------------------------------------------------
                            	   399: ; _apply_genesis_scroll — current-frame scroll apply hook.
                            	   400: ;
                            	   401: ; The transpiler injects `bsr _apply_genesis_scroll` twice inside IsrNmi:
                            	   402: ;   P1 after SetScroll updates the current frame's PPU shadows
                            	   403: ;   P2 after later game logic may have prepared next-frame shadows
                            	   404: ;
                            	   405: ; We want the CURRENT frame's VDP state to come from the latest finalized
                            	   406: ; scroll shadows that are still available during vblank. So each hook always
                            	   407: ; recomputes staged state, but it only promotes/applies that state while the
                            	   408: ; VDP still reports vblank active. Once vblank has ended, the hook stages
                            	   409: ; state for the NEXT frame only and leaves the live frame alone.
                            	   410: ;
                            	   411: ; Preserves: D5-D7, A0-A6.
                            	   412: ;------------------------------------------------------------------------------
                            	   413: _apply_genesis_scroll:
02:0000E1AC 48E7F800        	   414:     movem.l D0-D4,-(SP)
02:0000E1B0 611A            	   415:     bsr     _ags_compute_stage
02:0000E1B2 303900C00004    	   416:     move.w  (VDP_CTRL).l,D0
02:0000E1B8 08000003        	   417:     btst    #3,D0                      ; VBlank still active?
02:0000E1BC 6708            	   418:     beq.s   .ags_hook_done
02:0000E1BE 610000B4        	   419:     bsr     _ags_activate_staged
02:0000E1C2 61000116        	   420:     bsr     _ags_apply_active
                            	   421: .ags_hook_done:
02:0000E1C6 4CDF001F        	   422:     movem.l (SP)+,D0-D4
02:0000E1CA 4E75            	   423:     rts
                            	   424: 
                            	   425: ;------------------------------------------------------------------------------
                            	   426: ; _ags_compute_stage — Convert current NES scroll shadows into staged Genesis
                            	   427: ;                      composition state for one whole frame.
                            	   428: ;
                            	   429: ; Assumes A4 = NES RAM base ($FF0000). Writes STAGED_* only.
                            	   430: ; Clobbers D0-D4.
                            	   431: ;------------------------------------------------------------------------------
                            	   432: _ags_compute_stage:
02:0000E1CC 7000            	   433:     moveq   #0,D0
02:0000E1CE 102C00FC        	   434:     move.b  ($00FC,A4),D0              ; CurVScroll
02:0000E1D2 5040            	   435:     addi.w  #8,D0                      ; overscan
                            	   436: 
02:0000E1D4 122C00FF        	   437:     move.b  ($00FF,A4),D1
02:0000E1D8 4A2C005C        	   438:     tst.b   ($005C,A4)
02:0000E1DC 6704            	   439:     beq.s   .no_toggle
02:0000E1DE 0A010002        	   440:     eori.b  #$02,D1
                            	   441: .no_toggle:
02:0000E1E2 08010001        	   442:     btst    #1,D1
02:0000E1E6 6704            	   443:     beq.s   .no_nt
02:0000E1E8 064000F0        	   444:     addi.w  #240,D0
                            	   445: .no_nt:
                            	   446:     ; Wrap at 480 (NOT 512): plane rows 60-63 (VSRAM 480-511) are the
                            	   447:     ; V64 blank dead zone — no tile content lives there.  The NES scroll
                            	   448:     ; model wraps at 480 (two 240-row NTs), so end-of-NT_B (VSRAM 479)
                            	   449:     ; must fold directly to start-of-NT_A (VSRAM 0).  Letting VSRAM climb
                            	   450:     ; into 480-511 puts a blank strip at the top of the screen until the
                            	   451:     ; next NT toggle triggers a visible teleport.
02:0000E1EC 0C4001E0        	   452:     cmpi.w  #480,D0
02:0000E1F0 6504            	   453:     blo.s   .no_wrap
02:0000E1F2 044001E0        	   454:     subi.w  #480,D0
                            	   455: .no_wrap:
                            	   456: 
02:0000E1F6 33C000FF080C    	   457:     move.w  D0,(STAGED_BASE_VSRAM).l
02:0000E1FC 33C000FF080E    	   458:     move.w  D0,(STAGED_EVENT_VSRAM).l
                            	   459: 
02:0000E202 4A2C00E3        	   460:     tst.b   ($00E3,A4)
02:0000E206 671E            	   461:     beq.s   .no_split
02:0000E208 13FC000100FF080A	   462:     move.b  #INTRO_SCROLL_GAME_SPLIT,(STAGED_SCROLL_MODE).l
02:0000E210 427900FF080C    	   463:     clr.w   (STAGED_BASE_VSRAM).l
02:0000E216 13FC002700FF080B	   464:     move.b  #39,(STAGED_HINT_CTR).l
02:0000E21E 33C000FF080E    	   465:     move.w  D0,(STAGED_EVENT_VSRAM).l
02:0000E224 4E75            	   466:     rts
                            	   467: .no_split:
02:0000E226 13FC000000FF080A	   468:     move.b  #INTRO_SCROLL_NO_SPLIT,(STAGED_SCROLL_MODE).l
02:0000E22E 423900FF080B    	   469:     clr.b   (STAGED_HINT_CTR).l
02:0000E234 4E75            	   470:     rts
                            	   471: 
                            	   472: ;------------------------------------------------------------------------------
                            	   473: ; _ags_flush — Stage the NEXT frame's Genesis composition state and write
                            	   474: ;              H-scroll after IsrNmi has finalized the scroll shadows.
                            	   475: ;
                            	   476: ; This must not touch active-frame VSRAM/H-int state; the first
                            	   477: ; _apply_genesis_scroll hook inside IsrNmi owns current-frame application.
                            	   478: ;
                            	   479: ; Preserves: D5-D7, A0-A6.
                            	   480: ;------------------------------------------------------------------------------
                            	   481: _ags_flush:
02:0000E236 48E7F800        	   482:     movem.l D0-D4,-(SP)
02:0000E23A 6190            	   483:     bsr     _ags_compute_stage
                            	   484: 
                            	   485: .ags_hscroll:
                            	   486:     ; --- H-scroll (Plane A H-scroll table entry 0) ---
02:0000E23C 7000            	   487:     moveq   #0,D0
02:0000E23E 102C00FD        	   488:     move.b  ($00FD,A4),D0              ; CurHScroll
02:0000E242 4440            	   489:     neg.w   D0
02:0000E244 024001FF        	   490:     andi.w  #$01FF,D0
02:0000E248 23FC7C00000300C0	   491:     move.l  #$7C000003,(VDP_CTRL).l    ; VRAM write at $FC00
02:0000E250 0004
02:0000E252 33C000C00000    	   492:     move.w  D0,(VDP_DATA).l            ; Plane A H-scroll
02:0000E258 7000            	   493:     moveq   #0,D0
02:0000E25A 33C000C00000    	   494:     move.w  D0,(VDP_DATA).l            ; Plane B H-scroll = 0
02:0000E260 4CDF001F        	   495:     movem.l (SP)+,D0-D4
02:0000E264 4E75            	   496:     rts
                            	   497: 
                            	   498: ;------------------------------------------------------------------------------
                            	   499: ; _ags_prearm — Promote the previously staged scroll state into the active
                            	   500: ;               queue at START of vblank, BEFORE IsrNmi runs. This guarantees
                            	   501: ;               a coherent current-frame fallback even if the post-NMI flush
                            	   502: ;               finishes too late to safely touch VDP state for the same frame.
                            	   503: ;
                            	   504: ; Promotes the staged scroll state prepared by the previous frame's _ags_flush
                            	   505: ; into the active queue consumed by HBlankISR, then applies it immediately.
                            	   506: ;
                            	   507: ; Reads:  STAGED_SCROLL_MODE, STAGED_HINT_CTR, STAGED_BASE_VSRAM,
                            	   508: ;         STAGED_EVENT_VSRAM
                            	   509: ; Writes: HINT_Q_COUNT, HINT_Q0_CTR, HINT_Q0_VSRAM, HINT_PEND_SPLIT,
                            	   510: ;         INTRO_SCROLL_MODE
                            	   511: ; Preserves: D1-D7, A0-A6  (clobbers D0 internally, saved/restored)
                            	   512: ;------------------------------------------------------------------------------
                            	   513: _ags_prearm:
02:0000E266 48E78000        	   514:     movem.l D0,-(SP)
02:0000E26A 6108            	   515:     bsr     _ags_activate_staged
02:0000E26C 616C            	   516:     bsr     _ags_apply_active
02:0000E26E 4CDF0001        	   517:     movem.l (SP)+,D0
02:0000E272 4E75            	   518:     rts
                            	   519: 
                            	   520: ;------------------------------------------------------------------------------
                            	   521: ; _ags_activate_staged — Promote STAGED_* into the active queue/debug state.
                            	   522: ; Clobbers D0.
                            	   523: ;------------------------------------------------------------------------------
                            	   524: _ags_activate_staged:
02:0000E274 103900FF080A    	   525:     move.b  (STAGED_SCROLL_MODE).l,D0
02:0000E27A 13C000FF081F    	   526:     move.b  D0,(INTRO_SCROLL_MODE).l
02:0000E280 33F900FF080C00FF	   527:     move.w  (STAGED_BASE_VSRAM).l,(ACTIVE_BASE_VSRAM).l
02:0000E288 0836
02:0000E28A 33F900FF080E00FF	   528:     move.w  (STAGED_EVENT_VSRAM).l,(ACTIVE_EVENT_VSRAM).l
02:0000E292 0838
02:0000E294 13F900FF080B00FF	   529:     move.b  (STAGED_HINT_CTR).l,(ACTIVE_HINT_CTR).l
02:0000E29C 083A
02:0000E29E 4A00            	   530:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,D0
02:0000E2A0 6726            	   531:     beq.s   .aas_no_split
02:0000E2A2 13FC000100FF081E	   532:     move.b  #1,(HINT_PEND_SPLIT).l
02:0000E2AA 13FC000100FF0816	   533:     move.b  #1,(HINT_Q_COUNT).l
02:0000E2B2 13F900FF080B00FF	   534:     move.b  (STAGED_HINT_CTR).l,(HINT_Q0_CTR).l
02:0000E2BA 0817
02:0000E2BC 33F900FF080E00FF	   535:     move.w  (STAGED_EVENT_VSRAM).l,(HINT_Q0_VSRAM).l
02:0000E2C4 0818
02:0000E2C6 4E75            	   536:     rts
                            	   537: .aas_no_split:
02:0000E2C8 13FC000000FF081E	   538:     move.b  #0,(HINT_PEND_SPLIT).l
02:0000E2D0 13FC000000FF0816	   539:     move.b  #0,(HINT_Q_COUNT).l
02:0000E2D8 4E75            	   540:     rts
                            	   541: 
                            	   542: ;------------------------------------------------------------------------------
                            	   543: ; _ags_apply_active — Program VDP VSRAM/H-int state for the current frame from
                            	   544: ; the active queue/debug state set by _ags_activate_staged. For no-split and
                            	   545: ; intro dead-zone modes, the base VSRAM comes from ACTIVE_BASE_VSRAM.
                            	   546: ;
                            	   547: ; Clobbers D0.
                            	   548: ;------------------------------------------------------------------------------
                            	   549: _ags_apply_active:
02:0000E2DA 4A3900FF081F    	   550:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E2E0 6636            	   551:     bne.s   .aaa_split
                            	   552:     ; No-split path. When DMC is NOT active, do the full H-int off sequence.
                            	   553:     ; When DMC IS active, skip the Reg 10 / Reg 0 writes so dmc_trigger's
                            	   554:     ; HINT arm survives -- DMC only fires in no-split contexts (see
                            	   555:     ; dmc_trigger gate), so there's no scroll-split to service this frame.
02:0000E2E2 4A3900FFE100    	   556:     tst.b   (dmc_active).l
02:0000E2E8 6610            	   557:     bne.s   .aaa_dmc_vsram_only
02:0000E2EA 33FC8AFF00C00004	   558:     move.w  #$8AFF,(VDP_CTRL).l             ; Reg 10 = $FF (inactive)
02:0000E2F2 33FC800400C00004	   559:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: H-int off
                            	   560: .aaa_dmc_vsram_only:
02:0000E2FA 23FC4000001000C0	   561:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E302 0004
02:0000E304 33F900FF083600C0	   562:     move.w  (ACTIVE_BASE_VSRAM).l,(VDP_DATA).l
02:0000E30C 0000
02:0000E30E 7000            	   563:     moveq   #0,D0
02:0000E310 33C000C00000    	   564:     move.w  D0,(VDP_DATA).l
02:0000E316 4E75            	   565:     rts
                            	   566: .aaa_split:
02:0000E318 23FC4000001000C0	   567:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E320 0004
02:0000E322 7000            	   568:     moveq   #0,D0
02:0000E324 0C39000100FF081F	   569:     cmpi.b  #INTRO_SCROLL_GAME_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E32C 6706            	   570:     beq.s   .aaa_base_ready
02:0000E32E 303900FF0836    	   571:     move.w  (ACTIVE_BASE_VSRAM).l,D0
                            	   572: .aaa_base_ready:
02:0000E334 33C000C00000    	   573:     move.w  D0,(VDP_DATA).l
02:0000E33A 7000            	   574:     moveq   #0,D0
02:0000E33C 33C000C00000    	   575:     move.w  D0,(VDP_DATA).l
02:0000E342 7000            	   576:     moveq   #0,D0
02:0000E344 103900FF0817    	   577:     move.b  (HINT_Q0_CTR).l,D0
02:0000E34A 024000FF        	   578:     andi.w  #$00FF,D0
02:0000E34E 807C8A00        	   579:     or.w    #$8A00,D0
02:0000E352 33C000C00004    	   580:     move.w  D0,(VDP_CTRL).l                 ; Reg 10 = active H-int scanline
02:0000E358 33FC801400C00004	   581:     move.w  #$8014,(VDP_CTRL).l             ; Reg 0: enable H-int (+colorfix bit)
02:0000E360 4E75            	   582:     rts
                            	   583: 
                            	   584: ;------------------------------------------------------------------------------
                            	   585: ; _mode_transition_check — runs from VBlankISR after _ags_prearm, before
                            	   586: ; IsrNmi.  Detects a change in GameMode ($0012) against the LAST_GAMEMODE
                            	   587: ; shadow and, on transition, purges stale scroll latches, zeros the two
                            	   588: ; VSRAM words directly via the VDP control port, and rewinds the DynTileBuf
                            	   589: ; palette-precheck state so _patch_z06 P3 runs fresh on the new mode's
                            	   590: ; first tile transfer.
                            	   591: ;
                            	   592: ; Fixes VSRAM bleed-through seen when leaving attract → file-select →
                            	   593: ; gameplay: the new mode inherited the old mode's vertical scroll register
                            	   594: ; value for a single frame before the first _ags_flush landed.
                            	   595: ;
                            	   596: ; Preserves: D1-D7, A0-A6 (clobbers D0 internally and restores it).
                            	   597: ;------------------------------------------------------------------------------
                            	   598: _mode_transition_check:
02:0000E362 2F00            	   599:     move.l  D0,-(SP)
02:0000E364 102C0012        	   600:     move.b  ($0012,A4),D0
02:0000E368 B03900FF083E    	   601:     cmp.b   (LAST_GAMEMODE).l,D0
02:0000E36E 6760            	   602:     beq.s   .mtc_done
                            	   603:     ; --- mode changed: latch new shadow and purge stale PPU state ---
02:0000E370 13C000FF083E    	   604:     move.b  D0,(LAST_GAMEMODE).l
02:0000E376 423900FF0800    	   605:     clr.b   (PPU_LATCH).l
02:0000E37C 427900FF0802    	   606:     clr.w   (PPU_VADDR).l
02:0000E382 423900FF0809    	   607:     clr.b   (PPU_DHALF).l
02:0000E388 423900FF0808    	   608:     clr.b   (PPU_DBUF).l
                            	   609:     ; Phase 9: PPU_SCRL_X/Y clears removed (dead — never read)
                            	   610:     ; Direct VSRAM[0] + VSRAM[1] = 0 (inside vblank window).
02:0000E38E 23FC4000001000C0	   611:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E396 0004
02:0000E398 33FC000000C00000	   612:     move.w  #0,(VDP_DATA).l          ; Plane A V-scroll
02:0000E3A0 33FC000000C00000	   613:     move.w  #0,(VDP_DATA).l          ; Plane B V-scroll
                            	   614:     ; Preserve any live transfer work across a mode transition.
                            	   615:     ;
                            	   616:     ; Two cases matter:
                            	   617:     ;  1) DynTileBuf non-empty: pending dynamic record must survive.
                            	   618:     ;  2) TileBufSelector non-zero: pending static transfer request must survive.
                            	   619:     ;
                            	   620:     ; Room scroll transitions rely on selector-driven transfers after the mode
                            	   621:     ; has already changed, so clearing $0014 here when DynTileBuf is empty is
                            	   622:     ; too aggressive.
02:0000E3A8 4A2C0014        	   623:     tst.b   ($0014,A4)
02:0000E3AC 6622            	   624:     bne.s   .mtc_keep_pending
02:0000E3AE 0C2C00FF0302    	   625:     cmpi.b  #$FF,($0302,A4)
02:0000E3B4 661A            	   626:     bne.s   .mtc_keep_pending
                            	   627:     ; No pending selector and DynTileBuf empty: safe to rewind the
                            	   628:     ; palette-precheck state and clear stale one-shots from the old mode.
02:0000E3B6 422C0014        	   629:     clr.b   ($0014,A4)               ; PPU update request byte
02:0000E3BA 422C005C        	   630:     clr.b   ($005C,A4)               ; SwitchNameTablesReq one-shot
02:0000E3BE 197C003F0300    	   631:     move.b  #63,($0300,A4)
02:0000E3C4 197C00000301    	   632:     move.b  #0,($0301,A4)
02:0000E3CA 197C00FF0302    	   633:     move.b  #$FF,($0302,A4)
                            	   634: .mtc_keep_pending:
                            	   635: .mtc_done:
02:0000E3D0 201F            	   636:     move.l  (SP)+,D0
02:0000E3D2 4E75            	   637:     rts
                            	   638: 
                            	   639: 
                            	   640: 
                            	   641: ;------------------------------------------------------------------------------
                            	   642: ; _ppu_write_6 — PPUADDR ($2006)  ← T5 key implementation
                            	   643: ;
                            	   644: ; The NES PPU address register uses a two-write protocol (shared "w" latch):
                            	   645: ;   First  write: high byte of 15-bit VRAM address (bit 14 is forced clear by
                            	   646: ;                 hardware — valid VRAM is $0000–$3FFF).
                            	   647: ;   Second write: low byte.  After this write PPU_VADDR is fully updated and
                            	   648: ;                 the latch resets to 0.
                            	   649: ;
                            	   650: ; Side effect: resets the even-byte PPUDATA buffer (PPU_DHALF = 0) so that a
                            	   651: ; fresh address is always treated as the start of a new word-pair.
                            	   652: ;
                            	   653: ; Preserves: D1.
                            	   654: ;------------------------------------------------------------------------------
                            	   655: _ppu_write_6:
02:0000E3D4 48E74000        	   656:     movem.l D1,-(SP)
02:0000E3D8 123900FF0800    	   657:     move.b  (PPU_LATCH).l,D1
02:0000E3DE 4A01            	   658:     tst.b   D1
02:0000E3E0 6618            	   659:     bne.s   .second_write_6
                            	   660:     ; ---- First write: high byte ----
                            	   661:     ; High byte goes into PPU_VADDR+0.  Force bit 6 (addr bit 14) clear to
                            	   662:     ; keep address in the valid $0000–$3FFF window (matches NES hardware).
02:0000E3E2 0200003F        	   663:     andi.b  #$3F,D0
02:0000E3E6 13C000FF0802    	   664:     move.b  D0,(PPU_VADDR).l        ; store high byte
02:0000E3EC 13FC000100FF0800	   665:     move.b  #1,(PPU_LATCH).l
02:0000E3F4 4CDF0002        	   666:     movem.l (SP)+,D1
02:0000E3F8 4E75            	   667:     rts
                            	   668: .second_write_6:
                            	   669:     ; ---- Second write: low byte ----
02:0000E3FA 13C000FF0803    	   670:     move.b  D0,(PPU_VADDR+1).l      ; store low byte
02:0000E400 423900FF0800    	   671:     clr.b   (PPU_LATCH).l           ; reset w register
02:0000E406 423900FF0809    	   672:     clr.b   (PPU_DHALF).l           ; discard any pending even-byte buffer
02:0000E40C 4CDF0002        	   673:     movem.l (SP)+,D1
02:0000E410 4E75            	   674:     rts
                            	   675: 
                            	   676: ;------------------------------------------------------------------------------
                            	   677: ; _ppu_write_7 — PPUDATA ($2007)  ← T16 full implementation
                            	   678: ;
                            	   679: ; Routes byte writes to one of two paths based on PPU_VADDR:
                            	   680: ;
                            	   681: ;   CHR-RAM path  (PPU_VADDR $0000–$1FFF):
                            	   682: ;     Accumulates 16 bytes per NES tile in CHR_TILE_BUF, then on the 16th
                            	   683: ;     byte converts the 2BPP NES tile to 4BPP Genesis format and writes the
                            	   684: ;     32-byte result to VDP VRAM at Genesis addr = NES_addr × 2.
                            	   685: ;
                            	   686: ;   Nametable/palette path (PPU_VADDR $2000–$3FFF):
                            	   687: ;     Buffers even-address bytes and flushes pairs as 16-bit VDP words
                            	   688: ;     (unchanged from T5 — correct for nametable clears and palette writes).
                            	   689: ;
                            	   690: ; NES 2BPP → Genesis 4BPP conversion:
                            	   691: ;   16 bytes in: 8 bytes plane-0 then 8 bytes plane-1 (one bit per pixel)
                            	   692: ;   32 bytes out: 4 bytes per row, 2 pixels per byte, high-nibble = left pixel
                            	   693: ;   Pixel color = (plane1_bit << 1) | plane0_bit   (values 0–3)
                            	   694: ;
                            	   695: ; VDP auto-increment = 2 (Reg 15 = $8F02 set by genesis_shell).
                            	   696: ; PPU_VADDR increments by 1 (horizontal mode, bit 2 of PPUCTRL = 0).
                            	   697: ;
                            	   698: ; Preserves: D0–D6, A0–A6 (all saved/restored).
                            	   699: ;------------------------------------------------------------------------------
                            	   700: _ppu_write_7:
02:0000E412 48E7FEC0        	   701:     movem.l D0-D6/A0-A1,-(SP)       ; save all working registers (A1 used by LUT in .chr_convert_upload)
                            	   702: 
02:0000E416 323900FF0802    	   703:     move.w  (PPU_VADDR).l,D1        ; D1 = current NES PPU address
                            	   704: 
                            	   705:     ; Route: CHR range ($0000–$1FFF) vs nametable/palette ($2000–$3FFF)
02:0000E41C 0C412000        	   706:     cmpi.w  #$2000,D1
02:0000E420 647E            	   707:     bhs     .nt_write               ; ≥$2000 → nametable / palette path
                            	   708: 
                            	   709:     ;==========================================================================
                            	   710:     ; CHR TILE BUFFER PATH
                            	   711:     ;==========================================================================
                            	   712:     ; Buffer each byte.  On the 16th byte, convert the tile and upload it.
02:0000E422 523900FF0834    	   713:     addq.b  #1,(CHR_HIT_COUNT).l   ; DEBUG: count every CHR path entry (wraps at 255)
02:0000E428 7400            	   714:     moveq   #0,D2
02:0000E42A 143900FF0830    	   715:     move.b  (CHR_BUF_CNT).l,D2     ; D2 = bytes accumulated so far (0–15)
                            	   716: 
                            	   717:     ; Save this tile's base address on the first byte (aligned to 16 bytes)
02:0000E430 4A02            	   718:     tst.b   D2
02:0000E432 660C            	   719:     bne.s   .chr_store_byte
02:0000E434 3601            	   720:     move.w  D1,D3
02:0000E436 0243FFF0        	   721:     andi.w  #$FFF0,D3               ; round down to 16-byte tile boundary
02:0000E43A 33C300FF0832    	   722:     move.w  D3,(CHR_BUF_VADDR).l
                            	   723: 
                            	   724: .chr_store_byte:
02:0000E440 41F900FF0820    	   725:     lea     (CHR_TILE_BUF).l,A0
02:0000E446 11802000        	   726:     move.b  D0,(A0,D2.w)            ; CHR_TILE_BUF[count] = byte
02:0000E44A 523900FF0830    	   727:     addq.b  #1,(CHR_BUF_CNT).l     ; increment count
02:0000E450 6100032C        	   728:     bsr     .inc_ppuaddr            ; advance PPU_VADDR
                            	   729: 
02:0000E454 0C39001000FF0830	   730:     cmpi.b  #16,(CHR_BUF_CNT).l
02:0000E45C 663C            	   731:     bne.s   .chr_ret                ; not yet 16 bytes — keep buffering
                            	   732: 
                            	   733:     ; Complete tile — convert 2BPP → 4BPP and upload to VDP VRAM
                            	   734:     ifne CHR_EXPANSION_ENABLED
                            	   735:     ; Dispatch by NES address bit 12:
                            	   736:     ;   bit12=0 ($0000-$0FFF) → sprite half → _chr_upload_sprite_4x (4 copies)
                            	   737:     ;   bit12=1 ($1000-$1FFF) → BG half     → _chr_convert_upload   (1 copy)
                            	   738:     ; Preflight (reports/chr_preflight.txt) confirms PPUCTRL bit 3 = 0 always,
                            	   739:     ; so sprites live at $0000-$0FFF for all current scenes.
02:0000E45E 343900FF0832    	   740:     move.w  (CHR_BUF_VADDR).l,D2
02:0000E464 0802000C        	   741:     btst    #12,D2
02:0000E468 6606            	   742:     bne.s   .chr_bg_dispatch
02:0000E46A 610003D6        	   743:     bsr     _chr_upload_sprite_4x
02:0000E46E 6024            	   744:     bra.s   .chr_uploaded
                            	   745: .chr_bg_dispatch:
02:0000E470 61000330        	   746:     bsr     _chr_convert_upload
02:0000E474 0839000500FF0804	   747:     btst    #5,(PPU_CTRL).l
02:0000E47C 6716            	   748:     beq.s   .chr_uploaded
02:0000E47E 303900FF0832    	   749:     move.w  (CHR_BUF_VADDR).l,D0
02:0000E484 0C401F20        	   750:     cmpi.w  #$1F20,D0
02:0000E488 650A            	   751:     blo.s   .chr_uploaded
02:0000E48A 0C401F40        	   752:     cmpi.w  #$1F40,D0
02:0000E48E 6404            	   753:     bhs.s   .chr_uploaded
02:0000E490 610003B0        	   754:     bsr     _chr_upload_sprite_4x
                            	   755: .chr_uploaded:
                            	   756:     else
                            	   757:     bsr     _chr_convert_upload
                            	   758:     endc
02:0000E494 423900FF0830    	   759:     clr.b   (CHR_BUF_CNT).l
                            	   760: 
                            	   761: .chr_ret:
02:0000E49A 4CDF037F        	   762:     movem.l (SP)+,D0-D6/A0-A1
02:0000E49E 4E75            	   763:     rts
                            	   764: 
                            	   765:     ;==========================================================================
                            	   766:     ; NAMETABLE / PALETTE PATH  (PPU_VADDR $2000–$3FFF)
                            	   767:     ;==========================================================================
                            	   768:     ; Word-pair buffering: buffer even-address byte, flush word on odd address.
                            	   769:     ;==========================================================================
                            	   770: .nt_write:
                            	   771:     ;======================================================================
                            	   772:     ; Nametable → Genesis Plane A row mapping:
                            	   773:     ;   NES NT_A tiles ($2000–$23BF, and mirrored $2400–$27BF)
                            	   774:     ;       → Plane A rows 0–29  (VDP $C000–$C5FF)
                            	   775:     ;   NES NT_B tiles ($2800–$2BBF, and mirrored $2C00–$2FBF)
                            	   776:     ;       → Plane A rows 30–59 (VDP $CF00–$D4FF)
                            	   777:     ;
                            	   778:     ; Zelda uses vertical mirroring so NT_A and NT_B are the only two
                            	   779:     ; physical nametables. Story-scroll (intro) writes new rows to NT_B
                            	   780:     ; via $2800+ as the scroll crosses the NT boundary — previously these
                            	   781:     ; writes were dropped, leaving Plane A rows 30..59 stale.
                            	   782:     ;
                            	   783:     ; Each row is 64 tiles × 2 bytes = $80 bytes wide in Plane A.
                            	   784:     ;   vdp_addr = $C000 + row * $80 + col * 2
                            	   785:     ;======================================================================
                            	   786:     ; Fold $2C00 mirror → $2800 (vertical mirroring alias for NT_B).
02:0000E4A0 0C412C00        	   787:     cmpi.w  #$2C00,D1
02:0000E4A4 650A            	   788:     blo.s   .nt_no_b_mirror
02:0000E4A6 0C413000        	   789:     cmpi.w  #$3000,D1
02:0000E4AA 6404            	   790:     bhs.s   .nt_no_b_mirror
02:0000E4AC 04410400        	   791:     subi.w  #$0400,D1
                            	   792: .nt_no_b_mirror:
                            	   793:     ; T39 HUD/playfield split (Zelda 4-screen semantics).
                            	   794:     ; Track original source range before folding $2400 → $2000:
                            	   795:     ;   D7 = 0 → source was $2000 (HUD region; rows 0-3 only)
                            	   796:     ;   D7 = 1 → source was $2400 (playfield region; rows 4-29 only)
                            	   797:     ; NES renders HUD from $2000 for scanlines 0-31 and playfield from
                            	   798:     ; $2400 for scanlines 32-239 via a mid-frame scroll split. On Gen we
                            	   799:     ; collapse both into Plane A, so we gate writes to avoid one source
                            	   800:     ; clobbering the other's rows. Overworld only writes $2400 rows 4-29
                            	   801:     ; (so the bug was latent), but cave rooms write $2400 rows 0-29 which
                            	   802:     ; stomped the HUD — see builds/reports/t39_stage_a_render_classification.md.
02:0000E4B0 7E00            	   803:     moveq   #0,D7
02:0000E4B2 0C412400        	   804:     cmpi.w  #$2400,D1
02:0000E4B6 6508            	   805:     blo.s   .nt_src_detected
02:0000E4B8 0C412800        	   806:     cmpi.w  #$2800,D1
02:0000E4BC 6402            	   807:     bhs.s   .nt_src_detected
02:0000E4BE 7E01            	   808:     moveq   #1,D7
                            	   809: .nt_src_detected:
                            	   810:     ; Fold $2400 mirror → $2000 (vertical mirroring alias for NT_A).
02:0000E4C0 0C412400        	   811:     cmpi.w  #$2400,D1
02:0000E4C4 650A            	   812:     blo.s   .nt_no_a_mirror
