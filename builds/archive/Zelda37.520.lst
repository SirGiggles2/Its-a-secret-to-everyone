02:0002F286 6000C80E        	   269:     jmp     c_unhalt_link
                            	   270: 
                            	   271: InitCaveContinue:
                            	   272:     ; Get this cave's index (object type - $6A).
                            	   273:     ;
02:0002F28A 102C0350        	   274:     move.b  ($0350,A4),D0
02:0002F28E 003C0011        	   275:     ori     #$11,CCR  ; SEC: set C+X
02:0002F292 123C006A        	   276:     move.b  #$6A,D1
02:0002F296 0A3C0010        	   277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002F29A 9101            	   278:     subx.b  D1,D0   ; SBC #$6A
02:0002F29C 0A3C0010        	   279:     eori    #$10,CCR  ; restore X = 6502 C
02:0002F2A0 7600            	   280:     moveq   #0,D3
02:0002F2A2 1600            	   281:     move.b  D0,D3
                            	   282:     ; Get the person text selector by looking up the text selector byte
                            	   283:     ; for this index, and masking it with $3F.
                            	   284:     ;
02:0002F2A4 41F90002F254    	   285:     lea     (OverworldPersonTextSelectors).l,A0
02:0002F2AA 10303000        	   286:     move.b  (A0,D3.W),D0
02:0002F2AE 1B00            	   287:     move.b  D0,-(A5)  ; PHA
02:0002F2B0 0200003F        	   288:     andi.b #$3F,D0
02:0002F2B4 19400415        	   289:     move.b  D0,($0415,A4)
                            	   290:     ; Pop and mask the text selector byte with $C0 to get the
                            	   291:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   292:     ;
02:0002F2B8 101D            	   293:     move.b  (A5)+,D0  ; PLA
02:0002F2BA 020000C0        	   294:     andi.b #$C0,D0
02:0002F2BE 19400003        	   295:     move.b  D0,($0003,A4)
                            	   296:     ; At this point, the Y register still has the cave index.
                            	   297:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   298:     ;
02:0002F2C2 103C00FD        	   299:     move.b  #$FD,D0
                            	   300: _anon_z01_0:
02:0002F2C6 023C00EE        	   301:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F2CA 123C0003        	   302:     move.b  #$03,D1
02:0002F2CE D101            	   303:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002F2D0 5303            	   304:     subq.b  #1,D3
02:0002F2D2 6AF2            	   305:     bpl  _anon_z01_0
02:0002F2D4 7600            	   306:     moveq   #0,D3
02:0002F2D6 1600            	   307:     move.b  D0,D3
                            	   308:     ; Loop over the wares from 0 to 2.
                            	   309:     ;
02:0002F2D8 7400            	   310:     moveq   #0,D2
                            	   311:     even
                            	   312: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   313:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   314:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   315:     ;
02:0002F2DA 41F900FF6A7E    	   316:     lea     (NES_SRAM+$0A7E).l,A0
02:0002F2E0 10303000        	   317:     move.b  (A0,D3.W),D0
02:0002F2E4 41EC0422        	   318:     lea     ($0422,A4),A0
02:0002F2E8 11802000        	   319:     move.b  D0,(A0,D2.W)
                            	   320:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   321:     ;
02:0002F2EC 020000C0        	   322:     andi.b #$C0,D0
02:0002F2F0 19802000        	   323:     move.b  D0,($00,A4,D2.W)
                            	   324:     ; Copy 3 prices from the Cave level block info.
                            	   325:     ;
02:0002F2F4 41F900FF6ABA    	   326:     lea     (NES_SRAM+$0ABA).l,A0
02:0002F2FA 10303000        	   327:     move.b  (A0,D3.W),D0
02:0002F2FE 41EC0430        	   328:     lea     ($0430,A4),A0
02:0002F302 11802000        	   329:     move.b  D0,(A0,D2.W)
                            	   330:     ; Bottom of the wares copying loop.
                            	   331:     ;
02:0002F306 5203            	   332:     addq.b  #1,D3
02:0002F308 5202            	   333:     addq.b  #1,D2
02:0002F30A 0C020003        	   334:     cmpi.b  #$03,D2
02:0002F30E 66CA            	   335:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   336:     ; Get the top 2 bits of text selector byte in [03],
                            	   337:     ; shift them to the bottom, and combine them with [00].
                            	   338:     ;
02:0002F310 102C0003        	   339:     move.b  ($0003,A4),D0
02:0002F314 E308            	   340:     lsl.b  #1,D0   ; ASL A
02:0002F316 E310            	   341:     roxl.b  #1,D0   ; ROL A
02:0002F318 E310            	   342:     roxl.b  #1,D0   ; ROL A
02:0002F31A 1214            	   343:     move.b  ($0000,A4),D1
02:0002F31C 8001            	   344:     or.b  D1,D0
02:0002F31E 1880            	   345:     move.b  D0,($0000,A4)
                            	   346:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   347:     ; and combine them with [00].
                            	   348:     ;
02:0002F320 102C0002        	   349:     move.b  ($0002,A4),D0
02:0002F324 E208            	   350:     lsr.b  #1,D0   ; LSR A
02:0002F326 E208            	   351:     lsr.b  #1,D0   ; LSR A
02:0002F328 E208            	   352:     lsr.b  #1,D0   ; LSR A
02:0002F32A E208            	   353:     lsr.b  #1,D0   ; LSR A
02:0002F32C 1214            	   354:     move.b  ($0000,A4),D1
02:0002F32E 8001            	   355:     or.b  D1,D0
02:0002F330 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   358:     ; and combine them with [00] into CaveFlags.
                            	   359:     ;
02:0002F332 102C0001        	   360:     move.b  ($0001,A4),D0
02:0002F336 E208            	   361:     lsr.b  #1,D0   ; LSR A
02:0002F338 E208            	   362:     lsr.b  #1,D0   ; LSR A
02:0002F33A 1214            	   363:     move.b  ($0000,A4),D1
02:0002F33C 8001            	   364:     or.b  D1,D0
02:0002F33E 19400413        	   365:     move.b  D0,($0413,A4)
                            	   366:     ; The end result is a byte with 8 cave flags.
                            	   367:     ;
                            	   368:     ; If cave flag "money game" is missing, then go finish up,
                            	   369:     ; instead of choosing random amounts for the money game.
                            	   370:     ;
02:0002F342 02000020        	   371:     andi.b #$20,D0
02:0002F346 6700009E        	   372:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   373:     ; Determine an index randomly with increasing probability,
                            	   374:     ; from 6 to 1. Start with the following test:
                            	   375:     ;
                            	   376:     ;   If $FF < Random, then go use index 6.
                            	   377:     ;
02:0002F34A 103C00FF        	   378:     move.b  #$FF,D0
02:0002F34E 7606            	   379:     moveq   #6,D3
                            	   380:     even
                            	   381: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002F350 122C0019        	   382:     move.b  ($0019,A4),D1
02:0002F354 B001            	   383:     cmp.b   D1,D0
02:0002F356 6516            	   384:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   385:     ; If the test fails, then subtract $2B from the reference number.
                            	   386:     ;
02:0002F358 003C0011        	   387:     ori     #$11,CCR  ; SEC: set C+X
02:0002F35C 123C002B        	   388:     move.b  #$2B,D1
02:0002F360 0A3C0010        	   389:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002F364 9101            	   390:     subx.b  D1,D0   ; SBC #$2B
