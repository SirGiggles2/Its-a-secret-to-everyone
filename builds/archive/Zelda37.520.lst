                            	  4781: Aquamentus_Draw:
                            	  4782:     ; Every $10 screen frames, switch animation frames.
                            	  4783:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  4784:     ; The last tile of frame 0 is at index 5.
                            	  4785:     ; The last tile of frame 1 is at index $B.
                            	  4786:     ;
02:0003A2C8 7605            	  4787:     moveq   #5,D3
02:0003A2CA 102C0015        	  4788:     move.b  ($0015,A4),D0
02:0003A2CE 02000010        	  4789:     andi.b #$10,D0
02:0003A2D2 6602            	  4790:     bne  _anon_z04_88
02:0003A2D4 760B            	  4791:     moveq   #11,D3
                            	  4792: _anon_z04_88:
02:0003A2D6 1943000A        	  4793:     move.b  D3,($000A,A4)
                            	  4794:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  4795:     ;
02:0003A2DA 7005            	  4796:     moveq   #5,D0
02:0003A2DC 1940000B        	  4797:     move.b  D0,($000B,A4)
                            	  4798:     even
                            	  4799: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A2E0 7600            	  4800:     moveq   #0,D3
02:0003A2E2 162C000B        	  4801:     move.b  ($000B,A4),D3
                            	  4802:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  4803:     ; Store it in [00].
                            	  4804:     ;
02:0003A2E6 10342070        	  4805:     move.b  ($70,A4,D2.W),D0
02:0003A2EA 023C00EE        	  4806:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2EE 41F90003A2C2    	  4807:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A2F4 12303000        	  4808:     move.b  (A0,D3.W),D1
02:0003A2F8 D101            	  4809:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A2FA 1880            	  4810:     move.b  D0,($0000,A4)
                            	  4811:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  4812:     ; Store it in [01].
                            	  4813:     ;
02:0003A2FC 41EC0084        	  4814:     lea     ($0084,A4),A0
02:0003A300 10302000        	  4815:     move.b  (A0,D2.W),D0
02:0003A304 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A308 41F90003A2BC    	  4817:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A30E 12303000        	  4818:     move.b  (A0,D3.W),D1
02:0003A312 D101            	  4819:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A314 19400001        	  4820:     move.b  D0,($0001,A4)
                            	  4821:     ; Calculate sprite attributes:
                            	  4822:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4823:     ;
                            	  4824:     ; If the boss is temporarily invincible, then
                            	  4825:     ; this makes it flash by cycling all the palette rows.
                            	  4826:     ;
                            	  4827:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4828:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4829:     ;
02:0003A318 41EC04F0        	  4830:     lea     ($04F0,A4),A0
02:0003A31C 10302000        	  4831:     move.b  (A0,D2.W),D0
02:0003A320 02000003        	  4832:     andi.b #$03,D0
02:0003A324 0A000003        	  4833:     eori.b #$03,D0
02:0003A328 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A32C 7600            	  4835:     moveq   #0,D3
02:0003A32E 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A332 41F90003A2B0    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A338 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A33C 12390003A2B0    	  4842:     move.b  (AquamentusTiles).l,D1
02:0003A342 B001            	  4843:     cmp.b   D1,D0
02:0003A344 6610            	  4844:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4845:     ; Else it's the first one (the face tile).
                            	  4846:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  4847:     ;
                            	  4848:     ; $CC/CD shows the closed mouth face.
                            	  4849:     ; $C0/C1 shows the open mouth face.
                            	  4850:     ;
02:0003A346 7600            	  4851:     moveq   #0,D3
02:0003A348 16342028        	  4852:     move.b  ($28,A4,D2.W),D3
02:0003A34C 0C030020        	  4853:     cmpi.b  #$20,D3
02:0003A350 6404            	  4854:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A352 103C00C0        	  4855:     move.b  #$C0,D0
