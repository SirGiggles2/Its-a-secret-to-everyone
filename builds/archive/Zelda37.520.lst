02:0002B71C 202F0004        	  1016:     move.l  4(SP),D0
02:0002B720 4EF90000E3D4    	  1017:     jmp     _ppu_write_6
                            	  1018: 
                            	  1019: ;------------------------------------------------------------------------------
                            	  1020: ; void c_ppu_write_7(unsigned int val);
                            	  1021: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1022: ;------------------------------------------------------------------------------
                            	  1023: c_ppu_write_7:
02:0002B726 202F0004        	  1024:     move.l  4(SP),D0
02:0002B72A 4EF90000E412    	  1025:     jmp     _ppu_write_7
                            	  1026: 
