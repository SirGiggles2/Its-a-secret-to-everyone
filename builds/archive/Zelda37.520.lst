02:0003BDB8 41EC0084        	  8408:     lea     ($0084,A4),A0
02:0003BDBC 10302000        	  8409:     move.b  (A0,D2.W),D0
02:0003BDC0 19400001        	  8410:     move.b  D0,($0001,A4)
02:0003BDC4 6100FF62        	  8411:     jsr     Ganon_DrawCloud
02:0003BDC8 6172            	  8412:     jsr     Ganon_GetCurCloudRight
02:0003BDCA 6100FF5C        	  8413:     jsr     Ganon_DrawCloud
                            	  8414:     ; Save the object index.
                            	  8415:     ;
02:0003BDCE 102C0340        	  8416:     move.b  ($0340,A4),D0
02:0003BDD2 1B00            	  8417:     move.b  D0,-(A5)  ; PHA
                            	  8418:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8419:     ;
02:0003BDD4 7402            	  8420:     moveq   #2,D2
                            	  8421:     even
                            	  8422: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003BDD6 19420340        	  8423:     move.b  D2,($0340,A4)
                            	  8424:     ; If object slot < 5 or = 7, then move every frame.
                            	  8425:     ; Else move 3 out of every 4 frames.
                            	  8426:     ;
                            	  8427:     ; This makes pieces spread out in somewhat of a circle,
                            	  8428:     ; by making the pieces at cardinal directions move at
                            	  8429:     ; full speed while the diagonal ones move a little slower.
                            	  8430:     ;
02:0003BDDA 0C020005        	  8431:     cmpi.b  #$05,D2
02:0003BDDE 6510            	  8432:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003BDE0 0C020007        	  8433:     cmpi.b  #$07,D2
02:0003BDE4 670A            	  8434:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003BDE6 102C0015        	  8435:     move.b  ($0015,A4),D0
02:0003BDEA 02000003        	  8436:     andi.b #$03,D0
02:0003BDEE 6704            	  8437:     beq  _anon_z04_164
                            	  8438:     even
                            	  8439: _L_z04_Ganon_DrawBurst_Move:
02:0003BDF0 6100EDA2        	  8440:     jsr     BlueWizzrobe_Move
                            	  8441: _anon_z04_164:
02:0003BDF4 4EB900049120    	  8442:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8443:     ; The frame counter will make the sprite flash.
                            	  8444:     ; The array has the horizontal and vertical flipping attributes.
                            	  8445:     ; Combine them into [03].
                            	  8446:     ;
02:0003BDFA 102C0015        	  8447:     move.b  ($0015,A4),D0
02:0003BDFE 02000003        	  8448:     andi.b #$03,D0
02:0003BE02 41F90003BCD2    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BE08 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003BE0C 8001            	  8451:     or.b  D1,D0
02:0003BE0E 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BE12 41F90003BCDC    	  8453:     lea     (GanonBurstTiles).l,A0
02:0003BE18 10302000        	  8454:     move.b  (A0,D2.W),D0
02:0003BE1C 4EB9000311A8    	  8455:     jsr     Anim_WriteSprite
                            	  8456:     ; Bottom of the loop.
                            	  8457:     ; Increment object slot while <= 9.
                            	  8458:     ;
02:0003BE22 5202            	  8459:     addq.b  #1,D2
02:0003BE24 0C02000A        	  8460:     cmpi.b  #$0A,D2
02:0003BE28 65AC            	  8461:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8462:     ; Restore the object index.
                            	  8463:     ;
02:0003BE2A 101D            	  8464:     move.b  (A5)+,D0  ; PLA
02:0003BE2C 19400340        	  8465:     move.b  D0,($0340,A4)
02:0003BE30 0A3C0001        	  8466:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BE34 4E75            	  8467:     rts
                            	  8468: 
                            	  8469: ; Returns:
                            	  8470: ; [00]: X coordinate
                            	  8471: ;
