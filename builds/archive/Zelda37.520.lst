02:0003843E 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:00038442 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
