                            	  2250: ;==============================================================================
                            	  2251: ; _oam_dma_flush — Phase 1: transfer previous-frame SAT_SHADOW bank via VDP
                            	  2252: ;   68k→VRAM DMA to sprite attribute table at $F800.
                            	  2253: ;
                            	  2254: ; Must be called at the TOP of VBlankISR (before IsrNmi).  IsrNmi can extend
                            	  2255: ; into active display past scanline 40, so scheduling the DMA at the tail of
                            	  2256: ; VBlankISR would miss vblank.  The DMA source is the bank CURRENTLY flagged
                            	  2257: ; by SAT_ACTIVE_BANK — that is, the bank the previous frame's _oam_dma just
                            	  2258: ; finished filling.  After DMA setup the flag flips so the new frame's
                            	  2259: ; _oam_dma writes the OTHER bank.
                            	  2260: ;
                            	  2261: ; DMA params:
                            	  2262: ;   Reg 19/20: length = 256 words ($0100)
                            	  2263: ;   Reg 21/22/23: source = SAT_SHADOW_A or SAT_SHADOW_B (word address / 2)
                            	  2264: ;   VDP cmd: $78000083 (VRAM write $F800 + CD5 DMA bit)
                            	  2265: ;
                            	  2266: ; No busy-poll needed: DMA is fire-and-forget from 68k RAM.  Next VDP access
                            	  2267: ; (later in VBlankISR) will stall briefly if transfer still in flight.
                            	  2268: ;==============================================================================
                            	  2269:     even
                            	  2270: _oam_dma_flush:
02:0002AD94 48E7C000        	  2271:     movem.l D0/D1,-(SP)
02:0002AD98 7000            	  2272:     moveq   #0,D0
02:0002AD9A 103900FF2400    	  2273:     move.b  (SAT_ACTIVE_BANK).l,D0
                            	  2274:     ; D0 = 0 → source = SAT_SHADOW_A; D0 = 1 → source = SAT_SHADOW_B
02:0002ADA0 223C00FF2000    	  2275:     move.l  #SAT_SHADOW_A,D1
02:0002ADA6 4A00            	  2276:     tst.b   D0
02:0002ADA8 6706            	  2277:     beq.s   .oflush_src_ready
02:0002ADAA 223C00FF2200    	  2278:     move.l  #SAT_SHADOW_B,D1
                            	  2279: .oflush_src_ready:
                            	  2280:     ; Length: 256 words. Reg 19 = lo byte = $00, Reg 20 = hi byte = $01
02:0002ADB0 33FC930000C00004	  2281:     move.w  #$9300,(VDP_CTRL).l   ; Reg 19: length lo = $00
02:0002ADB8 33FC940100C00004	  2282:     move.w  #$9401,(VDP_CTRL).l   ; Reg 20: length hi = $01
                            	  2283:     ; Source addr in words: D1 >> 1
02:0002ADC0 E289            	  2284:     lsr.l   #1,D1
                            	  2285:     ; Reg 21 = source[7:0]
02:0002ADC2 3001            	  2286:     move.w  D1,D0
02:0002ADC4 024000FF        	  2287:     andi.w  #$00FF,D0
02:0002ADC8 00409500        	  2288:     ori.w   #$9500,D0
02:0002ADCC 33C000C00004    	  2289:     move.w  D0,(VDP_CTRL).l
                            	  2290:     ; Reg 22 = source[15:8]
02:0002ADD2 2001            	  2291:     move.l  D1,D0
02:0002ADD4 E088            	  2292:     lsr.l   #8,D0
02:0002ADD6 024000FF        	  2293:     andi.w  #$00FF,D0
02:0002ADDA 00409600        	  2294:     ori.w   #$9600,D0
02:0002ADDE 33C000C00004    	  2295:     move.w  D0,(VDP_CTRL).l
                            	  2296:     ; Reg 23 = source[22:16] with bit 7 clear (68k→VRAM mode)
02:0002ADE4 2001            	  2297:     move.l  D1,D0
02:0002ADE6 E088            	  2298:     lsr.l   #8,D0
02:0002ADE8 E088            	  2299:     lsr.l   #8,D0
02:0002ADEA 0240007F        	  2300:     andi.w  #$007F,D0
02:0002ADEE 00409700        	  2301:     ori.w   #$9700,D0
02:0002ADF2 33C000C00004    	  2302:     move.w  D0,(VDP_CTRL).l
                            	  2303:     ; VDP command: VRAM write $F800 + DMA trigger bit
02:0002ADF8 23FC7800008300C0	  2304:     move.l  #$78000083,(VDP_CTRL).l
02:0002AE00 0004
                            	  2305:     ; Flip active bank: bank just DMA'd becomes "previous"; other bank becomes active
02:0002AE02 0A39000100FF2400	  2306:     eori.b  #1,(SAT_ACTIVE_BANK).l
02:0002AE0A 4CDF0003        	  2307:     movem.l (SP)+,D0/D1
02:0002AE0E 4E75            	  2308:     rts
                            	  2309: 
                            	  2310: ;==============================================================================
                            	  2311: ; MMC1 mapper writes ($8000 / $A000 / $C000 / $E000)
                            	  2312: ;==============================================================================
                            	  2313: ;
                            	  2314: ; T11b: real MMC1 shift-register decoder.
                            	  2315: ;
                            	  2316: ; Protocol: five consecutive writes to a register address.  Each write
                            	  2317: ; contributes bit 0 (LSB first) to the 5-bit shift accumulator.  Writing
                            	  2318: ; any byte with bit 7 set resets the shift register immediately.  On the
                            	  2319: ; 5th valid write the accumulated 5-bit value is stored in the corresponding
                            	  2320: ; MMC1 state register and the accumulator resets.
                            	  2321: ;
                            	  2322: ; MMC1 register map (Genesis RAM, $FF0812–$FF0815):
                            	  2323: ;   $8000 writes → MMC1_CTRL  (mirroring, PRG mode, CHR mode)
                            	  2324: ;   $A000 writes → MMC1_CHR0  (CHR bank 0)
                            	  2325: ;   $C000 writes → MMC1_CHR1  (CHR bank 1)
                            	  2326: ;   $E000 writes → MMC1_PRG   (PRG bank + RAM enable)
                            	  2327: ;
                            	  2328: ; Register contract:
                            	  2329: ;   D0.b = write value (NES accumulator, from transpiler)
                            	  2330: ;   D1-D3 saved/restored  (D3 = NES Y index — MUST be preserved)
                            	  2331: ;   D3 repurposed internally as target register offset (0-3 from MMC1_CTRL)
                            	  2332: ;   D1 = bit count (work), D2 = bit value (work)
                            	  2333: ;
                            	  2334: ; Expected state at LoopForever (T11b probe):
                            	  2335: ;   MMC1_CTRL = $0F  (IsrReset → SetMMC1Control($0F))
                            	  2336: ;   MMC1_PRG  = $05  (RunGame  → SwitchBank(5))
                            	  2337: ;   MMC1_SHIFT = $00, MMC1_COUNT = $00  (reset after each 5th write)
                            	  2338: ;==============================================================================
                            	  2339: 
                            	  2340: _mmc1_write_8000:
02:0002AE10 48E77000        	  2341:     movem.l D1-D3,-(SP)
02:0002AE14 7600            	  2342:     moveq   #0,D3                   ; CTRL is at offset 0 from MMC1_CTRL
02:0002AE16 6016            	  2343:     bra.s   _mmc1_common
                            	  2344: 
                            	  2345: _mmc1_write_a000:
02:0002AE18 48E77000        	  2346:     movem.l D1-D3,-(SP)
02:0002AE1C 7601            	  2347:     moveq   #1,D3                   ; CHR0 is at offset 1
02:0002AE1E 600E            	  2348:     bra.s   _mmc1_common
                            	  2349: 
                            	  2350: _mmc1_write_c000:
02:0002AE20 48E77000        	  2351:     movem.l D1-D3,-(SP)
02:0002AE24 7602            	  2352:     moveq   #2,D3                   ; CHR1 is at offset 2
02:0002AE26 6006            	  2353:     bra.s   _mmc1_common
                            	  2354: 
                            	  2355: _mmc1_write_e000:
02:0002AE28 48E77000        	  2356:     movem.l D1-D3,-(SP)
02:0002AE2C 7603            	  2357:     moveq   #3,D3                   ; PRG is at offset 3
                            	  2358:     ; fall through to _mmc1_common
                            	  2359: 
                            	  2360: _mmc1_common:
                            	  2361:     ; Check bit 7 — reset strobe
02:0002AE2E 08000007        	  2362:     btst    #7,D0
02:0002AE32 6712            	  2363:     beq.s   .no_reset
02:0002AE34 423900FF0810    	  2364:     clr.b   (MMC1_SHIFT).l
02:0002AE3A 423900FF0811    	  2365:     clr.b   (MMC1_COUNT).l
02:0002AE40 4CDF000E        	  2366:     movem.l (SP)+,D1-D3
02:0002AE44 4E75            	  2367:     rts
                            	  2368: 
                            	  2369: .no_reset:
                            	  2370:     ; Shift bit 0 of D0 into position MMC1_COUNT of the accumulator
02:0002AE46 123900FF0811    	  2371:     move.b  (MMC1_COUNT).l,D1      ; D1.b = current count (0–4)
02:0002AE4C 1400            	  2372:     move.b  D0,D2
02:0002AE4E 02020001        	  2373:     andi.b  #1,D2                   ; D2.b = bit 0 of write value
02:0002AE52 E32A            	  2374:     lsl.b   D1,D2                   ; D2.b = bit shifted to correct position
02:0002AE54 853900FF0810    	  2375:     or.b    D2,(MMC1_SHIFT).l       ; accumulate into shift register
                            	  2376: 
                            	  2377:     ; Increment count; check for completion
02:0002AE5A 523900FF0811    	  2378:     addq.b  #1,(MMC1_COUNT).l
02:0002AE60 0C39000500FF0811	  2379:     cmpi.b  #5,(MMC1_COUNT).l
02:0002AE68 6620            	  2380:     bne.s   .mmc1_done              ; not yet 5 bits — wait for more writes
                            	  2381: 
                            	  2382:     ; 5th write: copy 5-bit shift value to the target state register
02:0002AE6A 143900FF0810    	  2383:     move.b  (MMC1_SHIFT).l,D2
02:0002AE70 0202001F        	  2384:     andi.b  #$1F,D2                 ; mask to 5 bits
02:0002AE74 41F900FF0812    	  2385:     lea     (MMC1_CTRL).l,A0        ; A0 = base of MMC1_CTRL ($FF0812)
02:0002AE7A 11823000        	  2386:     move.b  D2,(A0,D3.w)            ; store at MMC1_CTRL + D3 offset
                            	  2387: 
                            	  2388:     ; T36 Stage H experiment: universal auto-refresh of the PRG bank
                            	  2389:     ; window on $E000 writes. REVERTED — incompatible with the existing
                            	  2390:     ; manual P33b/P33c pins (z_01/z_03/z_05/z_06) which deliberately
                            	  2391:     ; set _current_window_bank to a bank that differs from MMC1_PRG.
                            	  2392:     ; Auto-refresh undid every pin on the next MMC1 write, breaking
                            	  2393:     ; Link movement in mode $05 (walk_left never reached x=$40, cave
                            	  2394:     ; entry never triggered). Full evidence in
                            	  2395:     ; builds/reports/t36_mmc1_autorefresh_finding.md. Next attempt
                            	  2396:     ; should target specific cave-interior pointer sites with P33b-
                            	  2397:     ; style pins instead of a universal write-side refresh.
                            	  2398: 
                            	  2399:     ; Reset accumulator
02:0002AE7E 423900FF0810    	  2400:     clr.b   (MMC1_SHIFT).l
02:0002AE84 423900FF0811    	  2401:     clr.b   (MMC1_COUNT).l
                            	  2402: 
                            	  2403: .mmc1_done:
02:0002AE8A 4CDF000E        	  2404:     movem.l (SP)+,D1-D3
02:0002AE8E 4E75            	  2405:     rts
                            	  2406: 
                            	  2407: ;==============================================================================
                            	  2408: ; APU writes ($4000–$4017)
                            	  2409: ;
                            	  2410: ; Most NES APU register writes are no-ops — the native M68K music player in
                            	  2411: ; audio_driver.asm drives YM2612/PSG directly from song scripts and ignores
                            	  2412: ; channel state, so every stub here is a plain rts.
                            	  2413: ;==============================================================================
                            	  2414: 
                            	  2415: _apu_write_4000:
                            	  2416: _apu_write_4001:
                            	  2417: _apu_write_4002:
                            	  2418: _apu_write_4003:
                            	  2419: _apu_write_4004:
                            	  2420: _apu_write_4005:
                            	  2421: _apu_write_4006:
                            	  2422: _apu_write_4007:
                            	  2423: _apu_write_4008:
                            	  2424: _apu_write_400a:
                            	  2425: _apu_write_400b:
                            	  2426: _apu_write_4011:
                            	  2427: _apu_write_4016:
                            	  2428: _apu_write_4017:
02:0002AE90 4E75            	  2429:     rts
                            	  2430: 
                            	  2431: ; Noise-channel APU writes. Zelda's SFX engine (PlaySfxNote) writes
                            	  2432: ; $400E (period), $400C (volume + const-vol bit), $400F (length trigger)
                            	  2433: ; per sfx-tick. We cache E+C and emit PSG on the F trigger. Arbitration
                            	  2434: ; is via $FF0606 (Effect) -- the music driver skips PSG noise writes
                            	  2435: ; when $0606 != 0, so SFX owns the channel for the duration of the hit.
                            	  2436: _apu_write_400c:
02:0002AE92 13C000FFE029    	  2437:     move.b  D0,(m_sfx_vol).l
02:0002AE98 4E75            	  2438:     rts
                            	  2439: 
                            	  2440: _apu_write_400e:
02:0002AE9A 13C000FFE02A    	  2441:     move.b  D0,(m_sfx_ctrl_raw).l
02:0002AEA0 4E75            	  2442:     rts
                            	  2443: 
                            	  2444: _apu_write_400f:
02:0002AEA2 4A3900FF0606    	  2445:     tst.b   ($00FF0606).l                  ; SFX active on game side?
02:0002AEA8 6758            	  2446:     beq.s   .f_skip
02:0002AEAA 48E7C000        	  2447:     movem.l D0-D1,-(SP)
                            	  2448:     ; PSG noise control byte from cached $400E (low 4 bits = period idx).
                            	  2449:     ; Map NES 16-period index to 4-bucket PSG noise control ($E4..$E7).
02:0002AEAE 103900FFE02A    	  2450:     move.b  (m_sfx_ctrl_raw).l,D0
02:0002AEB4 0200000F        	  2451:     andi.b  #$0F,D0
02:0002AEB8 0C000004        	  2452:     cmpi.b  #$04,D0
02:0002AEBC 6512            	  2453:     bcs.s   .pg_short
02:0002AEBE 0C000008        	  2454:     cmpi.b  #$08,D0
02:0002AEC2 6512            	  2455:     bcs.s   .pg_mid
02:0002AEC4 0C00000C        	  2456:     cmpi.b  #$0C,D0
02:0002AEC8 6512            	  2457:     bcs.s   .pg_long
02:0002AECA 103C00E7        	  2458:     move.b  #$E7,D0
02:0002AECE 6010            	  2459:     bra.s   .pg_ready
                            	  2460: .pg_short:
02:0002AED0 103C00E4        	  2461:     move.b  #$E4,D0
02:0002AED4 600A            	  2462:     bra.s   .pg_ready
                            	  2463: .pg_mid:
02:0002AED6 103C00E5        	  2464:     move.b  #$E5,D0
02:0002AEDA 6004            	  2465:     bra.s   .pg_ready
                            	  2466: .pg_long:
02:0002AEDC 103C00E6        	  2467:     move.b  #$E6,D0
                            	  2468: .pg_ready:
02:0002AEE0 13C000C00011    	  2469:     move.b  D0,(PSG_PORT).l                ; noise control ($Ex)
                            	  2470:     ; PSG attenuation from cached $400C (low 4 bits = volume nibble).
02:0002AEE6 103900FFE029    	  2471:     move.b  (m_sfx_vol).l,D0
02:0002AEEC 0200000F        	  2472:     andi.b  #$0F,D0
02:0002AEF0 0A00000F        	  2473:     eori.b  #$0F,D0                        ; NES 15=loud -> PSG 0=loud
02:0002AEF4 000000F0        	  2474:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:0002AEF8 13C000C00011    	  2475:     move.b  D0,(PSG_PORT).l
02:0002AEFE 4CDF0003        	  2476:     movem.l (SP)+,D0-D1
