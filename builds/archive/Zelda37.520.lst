02:0003BD36 41EC0478        	  8353:     lea     ($0478,A4),A0
02:0003BD3A 16302000        	  8354:     move.b  (A0,D2.W),D3
02:0003BD3E 0C030006        	  8355:     cmpi.b  #$06,D3
02:0003BD42 6402            	  8356:     bcc  _anon_z04_163
02:0003BD44 700D            	  8357:     moveq   #13,D0
                            	  8358: _anon_z04_163:
