02:0003A5B0 41EC0098        	  5188:     lea     ($0098,A4),A0
02:0003A5B4 10302000        	  5189:     move.b  (A0,D2.W),D0
02:0003A5B8 0C000002        	  5190:     cmpi.b  #$02,D0
02:0003A5BC 6604            	  5191:     bne  _anon_z04_94
02:0003A5BE 522C000F        	  5192:     addq.b  #1,($000F,A4)
                            	  5193: _anon_z04_94:
                            	  5194:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  5195:     ; This is the base frame image.
                            	  5196:     ;
02:0003A5C2 E208            	  5197:     lsr.b  #1,D0   ; LSR A
02:0003A5C4 E208            	  5198:     lsr.b  #1,D0   ; LSR A
                            	  5199:     ; If movement frame = 1, add 3 to frame image to access
                            	  5200:     ; the second animation frame's images.
                            	  5201:     ;
02:0003A5C6 7600            	  5202:     moveq   #0,D3
02:0003A5C8 41EC03E4        	  5203:     lea     ($03E4,A4),A0
02:0003A5CC 16302000        	  5204:     move.b  (A0,D2.W),D3
02:0003A5D0 671E            	  5205:     beq  _anon_z04_95
02:0003A5D2 023C00EE        	  5206:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5D6 123C0003        	  5207:     move.b  #$03,D1
02:0003A5DA D101            	  5208:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  5209:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  5210:     ;
                            	  5211:     ; Down has two frame images, but up only has one. By flipping
                            	  5212:     ; horizontally, you get two frame images.
                            	  5213:     ;
02:0003A5DC 7600            	  5214:     moveq   #0,D3
02:0003A5DE 41EC0098        	  5215:     lea     ($0098,A4),A0
02:0003A5E2 16302000        	  5216:     move.b  (A0,D2.W),D3
02:0003A5E6 0C030008        	  5217:     cmpi.b  #$08,D3
02:0003A5EA 6604            	  5218:     bne  _anon_z04_95
02:0003A5EC 522C000F        	  5219:     addq.b  #1,($000F,A4)
