                            	  7911: _anon_z04_159:
02:0003BA5A 61000CC0        	  7912:     jsr     DecreaseObjectAngle
                            	  7913:     ; Load Patra's maneuver index.
                            	  7914:     ; It determines which counts of bits are looked up below.
                            	  7915:     ;
02:0003BA5E 7600            	  7916:     moveq   #0,D3
02:0003BA60 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003BA64 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003BA68 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003BA6C 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003BA70 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BA72 41F90003B964    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003BA78 10303000        	  7927:     move.b  (A0,D3.W),D0
02:0003BA7C 1B00            	  7928:     move.b  D0,-(A5)  ; PHA
02:0003BA7E 41F90003B968    	  7929:     lea     (PatraChild1RotationSineBits).l,A0
02:0003BA84 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0003BA88 7600            	  7931:     moveq   #0,D3
02:0003BA8A 1600            	  7932:     move.b  D0,D3
02:0003BA8C 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0003BA8E 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  7939:     ; for both Y and X increment calculations in rotation. This leads to
                            	  7940:     ; a small circle (5) and a large circle (6).
                            	  7941:     ;
02:0003BA90 41F90003B966    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0003BA96 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0003BA9A 7600            	  7944:     moveq   #0,D3
