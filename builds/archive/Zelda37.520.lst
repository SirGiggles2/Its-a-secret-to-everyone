                            	  1463: ; [end inline] dat\ObjListAddrs.inc
                            	  1464: 
                            	  1465:     even
                            	  1466: InitMode4:
02:0003D5FE 7400            	  1467:     moveq   #0,D2
02:0003D600 142C0013        	  1468:     move.b  ($0013,A4),D2
02:0003D604 6604            	  1469:     bne.s  __far_z_05_0023
02:0003D606 60000084        	  1470:     jmp  InitMode_EnterRoom
                            	  1471: __far_z_05_0023:
02:0003D60A 5302            	  1472:     subq.b  #1,D2
02:0003D60C 6612            	  1473:     bne  _L_z05_InitMode4_CheckSub2
                            	  1474:     ; Submode 1.
                            	  1475:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1476:     ;
                            	  1477:     ; TODO:
                            	  1478:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1479:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1480:     ; A positive value triggers this submode 1 to transfer
                            	  1481:     ; the whole play area.
                            	  1482:     ;
                            	  1483:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1484:     ; a good state reflecting the new room. The only thing
                            	  1485:     ; needed is possibly to brighten the room by way of
                            	  1486:     ; changing the palette.
                            	  1487:     ;
                            	  1488:     ; So why does mode 7 trigger this?
                            	  1489:     ; Is there another mode that truly needs this behavior?
                            	  1490:     ;
02:0003D60E 102C00E9        	  1491:     move.b  ($00E9,A4),D0
02:0003D612 6B06            	  1492:     bmi  _anon_z05_40
02:0003D614 6100348E        	  1493:     jsr     CopyNextRowToTransferBuf
02:0003D618 6404            	  1494:     bcc  _L_z05_InitMode4_Exit
                            	  1495: _anon_z05_40:
02:0003D61A 522C0013        	  1496:     addq.b  #1,($0013,A4)
                            	  1497:     even
                            	  1498: _L_z05_InitMode4_Exit:
02:0003D61E 4E75            	  1499:     rts
                            	  1500: 
                            	  1501:     even
                            	  1502: _L_z05_InitMode4_CheckSub2:
02:0003D620 5302            	  1503:     subq.b  #1,D2
02:0003D622 6702            	  1504:     beq.s  __far_z_05_0024
02:0003D624 6058            	  1505:     jmp  InitMode4_Sub3
                            	  1506: __far_z_05_0024:
                            	  1507:     ; Submode 2.
                            	  1508:     ;
02:0003D626 7600            	  1509:     moveq   #0,D3
02:0003D628 162C00EB        	  1510:     move.b  ($00EB,A4),D3
02:0003D62C 6100424E        	  1511:     jsr     IsDarkRoom_Bank5
02:0003D630 6702            	  1512:     beq.s  __far_z_05_0025
02:0003D632 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
                            	  1516:     ; See if we have to brighten it after leaving a dark room.
                            	  1517:     ;
02:0003D634 102C0098        	  1518:     move.b  ($0098,A4),D0
02:0003D638 6100408A        	  1519:     jsr     CalcNextRoomByDir
                            	  1520:     ; Subtract RoomId from next room ID that was calculated
