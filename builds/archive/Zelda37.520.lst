                            	  8145:     ; The animation cycle has 6 frames.
                            	  8146:     ;
02:0003BBC8 41EC046B        	  8147:     lea     ($046B,A4),A0
02:0003BBCC 10302000        	  8148:     move.b  (A0,D2.W),D0
