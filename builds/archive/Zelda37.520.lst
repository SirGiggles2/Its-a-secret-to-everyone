02:0003BD9E 10342070        	  8399:     move.b  ($70,A4,D2.W),D0
02:0003BDA2 1880            	  8400:     move.b  D0,($0000,A4)
02:0003BDA4 6100009C        	  8401:     jsr     Ganon_GetCurCloudTop
02:0003BDA8 6100FF7E        	  8402:     jsr     Ganon_DrawCloud
02:0003BDAC 6100009A        	  8403:     jsr     Ganon_GetCurCloudBottom
02:0003BDB0 6100FF76        	  8404:     jsr     Ganon_DrawCloud
                            	  8405:     ; Draw the left and right clouds.
