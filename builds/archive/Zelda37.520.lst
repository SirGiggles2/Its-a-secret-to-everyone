02:0003A386 1014            	  4886:     move.b  ($0000,A4),D0
02:0003A388 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003A38C 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003A390 102C0001        	  4889:     move.b  ($0001,A4),D0
