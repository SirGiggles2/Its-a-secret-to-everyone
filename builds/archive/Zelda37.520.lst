                            	  2048: 
                            	  2049: ; Params:
                            	  2050: ; A: frame image
                            	  2051: ; X: object index
                            	  2052: ; [00]: object X
                            	  2053: ; [01]: object Y
                            	  2054: ;
                            	  2055: ;
                            	  2056: ; Set [0C] mirrored.
                            	  2057:     even
                            	  2058: DrawObjectMirrored:
02:00030EA8 7601            	  2059:     moveq   #1,D3
02:00030EAA 6602            	  2060:     bne  _anon_z01_75
                            	  2061: ; Params:
                            	  2062: ; A: frame image
                            	  2063: ; X: object index
                            	  2064: ; [00]: object X
                            	  2065: ; [01]: object Y
                            	  2066: ; [0F]: flip horizontally
                            	  2067: ;
                            	  2068:     even
                            	  2069: DrawObjectNotMirrored:
02:00030EAC 7600            	  2070:     moveq   #0,D3
                            	  2071: _anon_z01_75:
02:00030EAE 1943000C        	  2072:     move.b  D3,($000C,A4)
                            	  2073:     ; Set animation index = object type + 1.
                            	  2074:     ;
02:00030EB2 7600            	  2075:     moveq   #0,D3
02:00030EB4 41EC034F        	  2076:     lea     ($034F,A4),A0
02:00030EB8 16302000        	  2077:     move.b  (A0,D2.W),D3
                            	  2078: ; Params:
                            	  2079: ; A: frame
                            	  2080: ; X: object index/cycle sprite index
                            	  2081: ; Y: object type
                            	  2082: ; [00]: object X
                            	  2083: ; [01]: object Y
                            	  2084: ; [0C]: mirrored
                            	  2085: ; [0F]: flip horizontally
                            	  2086: ;
                            	  2087: ; Note:
                            	  2088: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2089: ;
                            	  2090: ; The animation index of most objects is (object type + 1),
                            	  2091: ; to make up for the fact that Link uses two animation indexes.
                            	  2092: ;
                            	  2093:     even
                            	  2094: DrawObjectWithType:
02:00030EBC 5203            	  2095:     addq.b  #1,D3
                            	  2096: ; Params:
                            	  2097: ; A: frame
                            	  2098: ; X: object index/cycle sprite index
                            	  2099: ; Y: animation index
                            	  2100: ; [00]: object X
                            	  2101: ; [01]: object Y
                            	  2102: ; [0C]: mirrored
                            	  2103: ; [0F]: flip horizontally
                            	  2104: ;
                            	  2105: ; Note:
                            	  2106: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2107: ; But Link uses [0F] for flipping without checking [0C].
                            	  2108: ;
                            	  2109: ;
                            	  2110: ; [0D] holds frame.
                            	  2111:     even
                            	  2112: DrawObjectWithAnim:
02:00030EBE 1940000D        	  2113:     move.b  D0,($000D,A4)
02:00030EC2 1943000E        	  2114:     move.b  D3,($000E,A4)
02:00030EC6 19420008        	  2115:     move.b  D2,($0008,A4)
                            	  2116:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  2117:     ;
02:00030ECA 7600            	  2118:     moveq   #0,D3
02:00030ECC 162C0341        	  2119:     move.b  ($0341,A4),D3
02:00030ED0 41F900030E74    	  2120:     lea     (SpriteOffsets).l,A0
02:00030ED6 10303000        	  2121:     move.b  (A0,D3.W),D0
02:00030EDA 19400343        	  2122:     move.b  D0,($0343,A4)
02:00030EDE 41F900030E75    	  2123:     lea     (SpriteOffsets+1).l,A0
02:00030EE4 10303000        	  2124:     move.b  (A0,D3.W),D0
