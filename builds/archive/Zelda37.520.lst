02:00038446 7051            	   485:     moveq   #81,D0
02:00038448 41EC0380        	   486:     lea     ($0380,A4),A0
02:0003844C 11803000        	   487:     move.b  D0,(A0,D3.W)
                            	   488:     ; Make it autonomous (ready to update on its own).
