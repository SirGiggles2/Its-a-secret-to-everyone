02:0003A1AA 5203            	  4617:     addq.b  #1,D3
02:0003A1AC 41EC0098        	  4618:     lea     ($0098,A4),A0
02:0003A1B0 11832000        	  4619:     move.b  D3,(A0,D2.W)
