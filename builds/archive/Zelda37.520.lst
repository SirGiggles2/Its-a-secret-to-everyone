                            	  8586:     ; The map marks are arranged in the same order as all the
                            	  8587:     ; possible values of OpenDoorMask.
                            	  8588:     ;
                            	  8589:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8590:     ; dynamic transfer buf at the current offset.
