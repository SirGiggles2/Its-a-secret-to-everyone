02:0003C168 1880            	  8905:     move.b  D0,($0000,A4)
                            	  8906:     ; If the global kill count = $10, set the dropped item to a fairy.
                            	  8907:     ;
02:0003C16A 7023            	  8908:     moveq   #35,D0
02:0003C16C 7600            	  8909:     moveq   #0,D3
02:0003C16E 162C0627        	  8910:     move.b  ($0627,A4),D3
02:0003C172 0C030010        	  8911:     cmpi.b  #$10,D3
02:0003C176 6716            	  8912:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	  8913:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	  8914:     ; But there is a random chance that the item drop will be canceled.
                            	  8915:     ;
02:0003C178 102C0050        	  8916:     move.b  ($0050,A4),D0
02:0003C17C 0C00000A        	  8917:     cmpi.b  #$0A,D0
02:0003C180 651A            	  8918:     bcs  _L_z04_SetUpDroppedItem_RandomlyCancel
                            	  8919:     ; Otherwise, the item will be guaranteed to be made.
