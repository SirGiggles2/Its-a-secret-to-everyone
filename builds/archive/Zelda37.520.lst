02:0002B618 13806000        	  3449:     move.b  D0,(A1,D6.W)
02:0002B61C 0646001F        	  3450:     addi.w  #31,D6
02:0002B620 13806000        	  3451:     move.b  D0,(A1,D6.W)
02:0002B624 5246            	  3452:     addq.w  #1,D6
