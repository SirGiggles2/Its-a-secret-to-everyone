02:00038EEA 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038EEE 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038EF2 41F900038CE4    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038EF8 10303000        	  2007:     move.b  (A0,D3.W),D0
