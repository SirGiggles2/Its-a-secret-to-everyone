02:0003E720 B001            	  3878:     cmp.b   D1,D0
02:0003E722 6510            	  3879:     bcs  _anon_z05_95
02:0003E724 41F90003E6E6    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E72A 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E72E B001            	  3882:     cmp.b   D1,D0
02:0003E730 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
