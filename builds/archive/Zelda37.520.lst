                            	  4188:     ; Get the next direction to check, and set moving direction to it.
                            	  4189:     ; If not at the end of the loop, go test the new direction's walkability.
                            	  4190:     ;
02:00047FE4 61000080        	  4191:     jsr     Walker_GetNextAltDir
02:00047FE8 1940000F        	  4192:     move.b  D0,($000F,A4)
02:00047FEC 102C000E        	  4193:     move.b  ($000E,A4),D0
02:00047FF0 6702            	  4194:     beq.s  __far_z_07_0054
02:00047FF2 60C0            	  4195:     jmp  CheckTiles
