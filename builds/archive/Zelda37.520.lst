                            	  5016:     ; The object is food.
                            	  5017:     ;
                            	  5018:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5019:     ; If we reach state $83, then go deactivate the object.
                            	  5020:     ;
                            	  5021:     ; Nothing changes between the states. So, they are used as
                            	  5022:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5023:     ;
02:0004855C 10342028        	  5024:     move.b  ($28,A4,D2.W),D0
