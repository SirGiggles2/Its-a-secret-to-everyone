02:00039BB0 41EC04F1        	  3788:     lea     ($04F1,A4),A0
02:00039BB4 11803000        	  3789:     move.b  D0,(A0,D3.W)
02:00039BB8 10342070        	  3790:     move.b  ($70,A4,D2.W),D0
