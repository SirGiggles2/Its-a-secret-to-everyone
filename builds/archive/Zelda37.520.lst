02:000392D4 4EB900049120    	  2616:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2617:     ; The variable for the currently updating object slot has to be
                            	  2618:     ; set to the heart's object slot for this drawing routine to work.
                            	  2619:     ;
02:000392DA 7400            	  2620:     moveq   #0,D2
02:000392DC 142C0340        	  2621:     move.b  ($0340,A4),D2
02:000392E0 4EB900030EAC    	  2622:     jsr     DrawObjectNotMirrored
02:000392E6 101D            	  2623:     move.b  (A5)+,D0  ; PLA
