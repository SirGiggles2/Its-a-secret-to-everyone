02:0003E2B8 0C00009D        	  3213:     cmpi.b  #$9D,D0
02:0003E2BC 6702            	  3214:     beq.s  __far_z_05_0061
02:0003E2BE 606C            	  3215:     jmp  CheckCaveEdge
                            	  3216: __far_z_05_0061:
                            	  3217:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3218:     ; X = $50: 1
                            	  3219:     ; X = $80: 2
                            	  3220:     ; X = $B0: 3
                            	  3221:     ;
                            	  3222:     ; If he's not on any, then return.
                            	  3223:     ;
02:0003E2C0 7601            	  3224:     moveq   #1,D3
02:0003E2C2 102C0070        	  3225:     move.b  ($0070,A4),D0
02:0003E2C6 0C000050        	  3226:     cmpi.b  #$50,D0
02:0003E2CA 6712            	  3227:     beq  _anon_z05_83
02:0003E2CC 5203            	  3228:     addq.b  #1,D3
02:0003E2CE 0C000080        	  3229:     cmpi.b  #$80,D0
02:0003E2D2 670A            	  3230:     beq  _anon_z05_83
02:0003E2D4 5203            	  3231:     addq.b  #1,D3
02:0003E2D6 0C0000B0        	  3232:     cmpi.b  #$B0,D0
02:0003E2DA 6702            	  3233:     beq.s  __far_z_05_0062
02:0003E2DC 604C            	  3234:     jmp  L14F72_Exit
