02:0003A5A4 1980203D        	  5183:     move.b  D0,($3D,A4,D2.W)
02:0003A5A8 7008            	  5184:     moveq   #8,D0
02:0003A5AA 4EB90004911A    	  5185:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5186:     ; If facing left, then enable horizontal flipping.
