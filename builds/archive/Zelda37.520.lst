02:000337B0 5202            	  2117:     addq.b  #1,D2
02:000337B2 41F9000331FA    	  2118:     lea     (ModeE_CharBoardYOffsetsAndBounds).l,A0
02:000337B8 12302000        	  2119:     move.b  (A0,D2.W),D1
