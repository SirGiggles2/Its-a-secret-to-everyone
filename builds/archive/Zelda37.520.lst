02:0002C058 08000008        	  2520:     btst    #8,D0
02:0002C05C 670A            	  2521:     beq.s   .cc_cnras
02:0002C05E 003C0001        	  2522:     ori     #$01,CCR
02:0002C062 0A3C0001        	  2523:     eori    #$01,CCR
02:0002C066 4E75            	  2524:     rts
                            	  2525: .cc_cnras:
02:0002C068 023C00FE        	  2526:     andi    #$FE,CCR
02:0002C06C 0A3C0001        	  2527:     eori    #$01,CCR
02:0002C070 4E75            	  2528:     rts
