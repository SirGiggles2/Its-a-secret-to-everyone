                            	  1712: _bank_rom_bases:
02:0002AA82 0000EA82        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA86 00012A82
02:0002AA8A 00016A82        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
