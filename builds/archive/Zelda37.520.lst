02:0003BA40 7000            	  7899:     moveq   #0,D0
02:0003BA42 1940000B        	  7900:     move.b  D0,($000B,A4)
                            	  7901:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  7902:     ; monster's angle by $70, else by $60 to go slower.
                            	  7903:     ;
02:0003BA46 7070            	  7904:     moveq   #112,D0
