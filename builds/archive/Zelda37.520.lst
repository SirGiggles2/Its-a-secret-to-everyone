                            	  3829: 
                            	  3830: ; Params:
                            	  3831: ; [0F]: moving direction
                            	  3832: ;
                            	  3833: ; Returns:
                            	  3834: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3835: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3836: ;
                            	  3837: ; When not at or in a doorway, this function leaves
                            	  3838: ; [0F] moving direction as is.
                            	  3839: ;
                            	  3840: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3841: ; will be left as is, assuming that it had been reset before this
                            	  3842: ; routine by BoundByRoom.
                            	  3843: ;
                            	  3844: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3845: ;
                            	  3846: ;
                            	  3847: ; If already in a doorway, go handle it separately.
                            	  3848: ;
                            	  3849:     even
