02:00040A80 B001            	  7006:     cmp.b   D1,D0
02:00040A82 6704            	  7007:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00040A84 5302            	  7008:     subq.b  #1,D2
02:00040A86 66EE            	  7009:     bne  _anon_z05_149
                            	  7010:     even
