02:0003FDE4 123C0001        	  5594:     move.b  #$01,D1
02:0003FDE8 0A3C0010        	  5595:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FDEC 9101            	  5596:     subx.b  D1,D0   ; SBC #$01
02:0003FDEE 0A3C0010        	  5597:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FDF2 02000002        	  5598:     andi.b #$02,D0
02:0003FDF6 19400008        	  5599:     move.b  D0,($0008,A4)
