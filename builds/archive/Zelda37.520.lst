                            	  4744: DrawCredits:
                            	  4745:     ; Make a transfer record of a full row of blank tiles.
                            	  4746:     ;
02:00035358 761F            	  4747:     moveq   #31,D3
02:0003535A 7024            	  4748:     moveq   #36,D0
                            	  4749: _anon_z02_41:
02:0003535C 41EC0305        	  4750:     lea     ($0305,A4),A0
02:00035360 11803000        	  4751:     move.b  D0,(A0,D3.W)
02:00035364 5303            	  4752:     subq.b  #1,D3
02:00035366 6AF4            	  4753:     bpl  _anon_z02_41
                            	  4754:     ; No wall tiles go in row 0.
                            	  4755:     ;
02:00035368 102C050A        	  4756:     move.b  ($050A,A4),D0
02:0003536C 672C            	  4757:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  4758:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  4759:     ; Rows 2 to $2D get side walls.
                            	  4760:     ;
02:0003536E 0C000001        	  4761:     cmpi.b  #$01,D0
02:00035372 6708            	  4762:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00035374 0C00002E        	  4763:     cmpi.b  #$2E,D0
02:00035378 6514            	  4764:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:0003537A 661E            	  4765:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  4766:     even
                            	  4767: _L_z02_DrawCredits_WriteHorizontalWalls:
02:0003537C 7619            	  4768:     moveq   #25,D3
02:0003537E 103C00FA        	  4769:     move.b  #$FA,D0
                            	  4770: _anon_z02_42:
02:00035382 41EC0308        	  4771:     lea     ($0308,A4),A0
02:00035386 11803000        	  4772:     move.b  D0,(A0,D3.W)
02:0003538A 5303            	  4773:     subq.b  #1,D3
02:0003538C 6AF4            	  4774:     bpl  _anon_z02_42
                            	  4775:     even
                            	  4776: _L_z02_DrawCredits_WriteSideWalls:
02:0003538E 103C00FA        	  4777:     move.b  #$FA,D0
02:00035392 19400308        	  4778:     move.b  D0,($0308,A4)
02:00035396 19400321        	  4779:     move.b  D0,($0321,A4)
                            	  4780:     even
                            	  4781: _L_z02_DrawCredits_TerminateRecords:
                            	  4782:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  4783:     ; attributes or only tiles.
                            	  4784:     ;
02:0003539A 103C00FF        	  4785:     move.b  #$FF,D0
02:0003539E 19400325        	  4786:     move.b  D0,($0325,A4)
02:000353A2 19400330        	  4787:     move.b  D0,($0330,A4)
                            	  4788:     ; Specify that we're transferring $20 bytes/tiles.
                            	  4789:     ;
02:000353A6 7020            	  4790:     moveq   #32,D0
02:000353A8 19400304        	  4791:     move.b  D0,($0304,A4)
                            	  4792:     ; Write the high byte of the current VRAM page.
                            	  4793:     ;
02:000353AC 7400            	  4794:     moveq   #0,D2
02:000353AE 142C050C        	  4795:     move.b  ($050C,A4),D2
02:000353B2 41F900035158    	  4796:     lea     (CreditLineVramAddrsHi).l,A0
02:000353B8 10302000        	  4797:     move.b  (A0,D2.W),D0
02:000353BC 19400302        	  4798:     move.b  D0,($0302,A4)
                            	  4799:     ; The line number will be used to shift the task mask below.
                            	  4800:     ;
02:000353C0 102C050D        	  4801:     move.b  ($050D,A4),D0
02:000353C4 7600            	  4802:     moveq   #0,D3
02:000353C6 1600            	  4803:     move.b  D0,D3
                            	  4804:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  4805:     ;
02:000353C8 E308            	  4806:     lsl.b  #1,D0   ; ASL A
02:000353CA E308            	  4807:     lsl.b  #1,D0   ; ASL A
02:000353CC E308            	  4808:     lsl.b  #1,D0   ; ASL A
02:000353CE E308            	  4809:     lsl.b  #1,D0   ; ASL A
02:000353D0 E308            	  4810:     lsl.b  #1,D0   ; ASL A
02:000353D2 19400303        	  4811:     move.b  D0,($0303,A4)
                            	  4812:     ; Get the mask for the current VRAM page.
                            	  4813:     ;
02:000353D6 41F900035164    	  4814:     lea     (CreditsPagesTextMasks).l,A0
02:000353DC 10302000        	  4815:     move.b  (A0,D2.W),D0
                            	  4816: _anon_z02_43:
                            	  4817:     ; Shift left as many times as the current VRAM line number,
                            	  4818:     ; to get the bit that indicates whether this line has text.
                            	  4819:     ;
02:000353E0 E308            	  4820:     lsl.b  #1,D0   ; ASL A
02:000353E2 5303            	  4821:     subq.b  #1,D3
02:000353E4 6AFA            	  4822:     bpl  _anon_z02_43
02:000353E6 6400013E        	  4823:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  4824:     ; The mask inidcates that it should have text.
                            	  4825:     ; But if line index >= $17, then it doesn't.
                            	  4826:     ;
02:000353EA 7600            	  4827:     moveq   #0,D3
02:000353EC 162C050E        	  4828:     move.b  ($050E,A4),D3
02:000353F0 0C030017        	  4829:     cmpi.b  #$17,D3
02:000353F4 64000130        	  4830:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  4831:     ; In the first quest, don't consider line numbers >= $10.
                            	  4832:     ;
02:000353F8 7400            	  4833:     moveq   #0,D2
02:000353FA 142C0016        	  4834:     move.b  ($0016,A4),D2
02:000353FE 41EC062D        	  4835:     lea     ($062D,A4),A0
02:00035402 10302000        	  4836:     move.b  (A0,D2.W),D0
02:00035406 6608            	  4837:     bne  _anon_z02_44
02:00035408 0C030010        	  4838:     cmpi.b  #$10,D3
02:0003540C 64000114        	  4839:     bcc  _L_z02_DrawCredits_IncLine
                            	  4840: _anon_z02_44:
02:00035410 7400            	  4841:     moveq   #0,D2
02:00035412 142C0016        	  4842:     move.b  ($0016,A4),D2
02:00035416 41EC062D        	  4843:     lea     ($062D,A4),A0
02:0003541A 10302000        	  4844:     move.b  (A0,D2.W),D0
                            	  4845:     ; In the second quest, skip lines $C to $F.
                            	  4846:     ;
02:0003541E 670E            	  4847:     beq  _anon_z02_45
02:00035420 0C03000C        	  4848:     cmpi.b  #$0C,D3
02:00035424 6508            	  4849:     bcs  _anon_z02_45
02:00035426 0C030010        	  4850:     cmpi.b  #$10,D3
02:0003542A 650000F6        	  4851:     bcs  _L_z02_DrawCredits_IncLine
                            	  4852: _anon_z02_45:
02:0003542E 41F900035170    	  4853:     lea     (CreditsTextAddrsLo).l,A0
02:00035434 10303000        	  4854:     move.b  (A0,D3.W),D0
02:00035438 1880            	  4855:     move.b  D0,($0000,A4)
02:0003543A 41F900035188    	  4856:     lea     (CreditsTextAddrsHi).l,A0
02:00035440 10303000        	  4857:     move.b  (A0,D3.W),D0
02:00035444 19400001        	  4858:     move.b  D0,($0001,A4)
                            	  4859:     ; First read the length of the string.
                            	  4860:     ;
02:00035448 7600            	  4861:     moveq   #0,D3
02:0003544A 1214            	  4862:     move.b  ($00,A4),D1   ; ptr lo
02:0003544C 182C0001        	  4863:     move.b  ($01,A4),D4  ; ptr hi
02:00035450 024100FF        	  4864:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035454 E14C            	  4865:     lsl.w   #8,D4
02:00035456 8841            	  4866:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035458 48C4            	  4867:     ext.l   D4
02:0003545A D8BC00FF0000    	  4868:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035460 2044            	  4869:     movea.l D4,A0
02:00035462 10303000        	  4870:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00035466 19400002        	  4871:     move.b  D0,($0002,A4)
                            	  4872:     ; Second, read the offset where the first character goes
                            	  4873:     ; in the line.
                            	  4874:     ;
02:0003546A 5203            	  4875:     addq.b  #1,D3
02:0003546C 1214            	  4876:     move.b  ($00,A4),D1   ; ptr lo
02:0003546E 182C0001        	  4877:     move.b  ($01,A4),D4  ; ptr hi
02:00035472 024100FF        	  4878:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035476 E14C            	  4879:     lsl.w   #8,D4
02:00035478 8841            	  4880:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003547A 48C4            	  4881:     ext.l   D4
02:0003547C D8BC00FF0000    	  4882:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035482 2044            	  4883:     movea.l D4,A0
02:00035484 10303000        	  4884:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00035488 7400            	  4885:     moveq   #0,D2
02:0003548A 1400            	  4886:     move.b  D0,D2
                            	  4887:     ; Loop over each character in the rest of the credits source record.
                            	  4888:     ;
02:0003548C 5203            	  4889:     addq.b  #1,D3
                            	  4890: _anon_z02_46:
02:0003548E 1214            	  4891:     move.b  ($00,A4),D1   ; ptr lo
02:00035490 182C0001        	  4892:     move.b  ($01,A4),D4  ; ptr hi
02:00035494 024100FF        	  4893:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035498 E14C            	  4894:     lsl.w   #8,D4
02:0003549A 8841            	  4895:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003549C 48C4            	  4896:     ext.l   D4
02:0003549E D8BC00FF0000    	  4897:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000354A4 2044            	  4898:     movea.l D4,A0
02:000354A6 10303000        	  4899:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000354AA 41EC0305        	  4900:     lea     ($0305,A4),A0
02:000354AE 11802000        	  4901:     move.b  D0,(A0,D2.W)
02:000354B2 5203            	  4902:     addq.b  #1,D3
02:000354B4 5202            	  4903:     addq.b  #1,D2
02:000354B6 532C0002        	  4904:     subq.b  #1,($0002,A4)
02:000354BA 66D2            	  4905:     bne  _anon_z02_46
                            	  4906:     ; If line index <> $11, go increment.
                            	  4907:     ;
02:000354BC 7600            	  4908:     moveq   #0,D3
02:000354BE 162C050E        	  4909:     move.b  ($050E,A4),D3
02:000354C2 0C03000C        	  4910:     cmpi.b  #$0C,D3
02:000354C6 655A            	  4911:     bcs  _L_z02_DrawCredits_IncLine
02:000354C8 0C030011        	  4912:     cmpi.b  #$11,D3
02:000354CC 6654            	  4913:     bne  _L_z02_DrawCredits_IncLine
                            	  4914:     ; Line index = $11, prepare to read the player's name.
                            	  4915:     ;
02:000354CE 102C0016        	  4916:     move.b  ($0016,A4),D0
02:000354D2 E308            	  4917:     lsl.b  #1,D0   ; ASL A
02:000354D4 E308            	  4918:     lsl.b  #1,D0   ; ASL A
02:000354D6 E308            	  4919:     lsl.b  #1,D0   ; ASL A
02:000354D8 7600            	  4920:     moveq   #0,D3
02:000354DA 1600            	  4921:     move.b  D0,D3
                            	  4922:     ; Copy the player's name at offset 9 in string to transfer.
                            	  4923:     ;
02:000354DC 7400            	  4924:     moveq   #0,D2
                            	  4925: _anon_z02_47:
02:000354DE 41EC0638        	  4926:     lea     ($0638,A4),A0
02:000354E2 10303000        	  4927:     move.b  (A0,D3.W),D0
02:000354E6 41EC030E        	  4928:     lea     ($030E,A4),A0
02:000354EA 11802000        	  4929:     move.b  D0,(A0,D2.W)
02:000354EE 5203            	  4930:     addq.b  #1,D3
02:000354F0 5202            	  4931:     addq.b  #1,D2
02:000354F2 0C020008        	  4932:     cmpi.b  #$08,D2
02:000354F6 65E6            	  4933:     bcs  _anon_z02_47
                            	  4934:     ; Format the death count for the current save slot.
                            	  4935:     ;
02:000354F8 7600            	  4936:     moveq   #0,D3
02:000354FA 162C0016        	  4937:     move.b  ($0016,A4),D3
02:000354FE 41EC0630        	  4938:     lea     ($0630,A4),A0
02:00035502 10303000        	  4939:     move.b  (A0,D3.W),D0
02:00035506 6100B58E        	  4940:     jsr     FormatDecimalByte
                            	  4941:     ; Copy the decimal death count at offset 19 in string to transfer.
                            	  4942:     ;
02:0003550A 7402            	  4943:     moveq   #2,D2
                            	  4944: _anon_z02_48:
02:0003550C 10342001        	  4945:     move.b  ($01,A4,D2.W),D0
02:00035510 41EC0318        	  4946:     lea     ($0318,A4),A0
02:00035514 11802000        	  4947:     move.b  D0,(A0,D2.W)
02:00035518 5302            	  4948:     subq.b  #1,D2
02:0003551A 6AF0            	  4949:     bpl  _anon_z02_48
02:0003551C 7600            	  4950:     moveq   #0,D3
02:0003551E 162C050E        	  4951:     move.b  ($050E,A4),D3
                            	  4952:     even
                            	  4953: _L_z02_DrawCredits_IncLine:
02:00035522 522C050E        	  4954:     addq.b  #1,($050E,A4)
                            	  4955:     even
                            	  4956: _L_z02_DrawCredits_IncVramLine:
02:00035526 522C050D        	  4957:     addq.b  #1,($050D,A4)
                            	  4958:     ; In each VRAM page there are 8 lines, except in ones where
                            	  4959:     ; (page MOD 4) = 3. This means $23xx and $2Bxx.
                            	  4960:     ; These pages have 6 lines.
                            	  4961:     ;
02:0003552A 102C050C        	  4962:     move.b  ($050C,A4),D0
02:0003552E 02000003        	  4963:     andi.b #$03,D0
02:00035532 0C000003        	  4964:     cmpi.b  #$03,D0
02:00035536 7008            	  4965:     moveq   #8,D0
02:00035538 6502            	  4966:     bcs  _anon_z02_49
02:0003553A 7006            	  4967:     moveq   #6,D0
                            	  4968: _anon_z02_49:
                            	  4969:     ; If the VRAM line number has not just been incremented to
                            	  4970:     ; the reference line number count, then go write NT attributes.
                            	  4971:     ;
02:0003553C 122C050D        	  4972:     move.b  ($050D,A4),D1
02:00035540 B001            	  4973:     cmp.b   D1,D0
02:00035542 661C            	  4974:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  4975:     ; Else roll over the VRAM line to 0.
                            	  4976:     ;
02:00035544 7000            	  4977:     moveq   #0,D0
02:00035546 1940050D        	  4978:     move.b  D0,($050D,A4)
                            	  4979:     ; Increment the VRAM page number.
                            	  4980:     ;
02:0003554A 7600            	  4981:     moveq   #0,D3
02:0003554C 162C050C        	  4982:     move.b  ($050C,A4),D3
02:00035550 5203            	  4983:     addq.b  #1,D3
                            	  4984:     ; If it has reached $C, then roll it over to 0.
                            	  4985:     ;
02:00035552 0C03000C        	  4986:     cmpi.b  #$0C,D3
02:00035556 6504            	  4987:     bcs  _anon_z02_50
02:00035558 7600            	  4988:     moveq   #0,D3
02:0003555A 1600            	  4989:     move.b  D0,D3
                            	  4990: _anon_z02_50:
02:0003555C 1943050C        	  4991:     move.b  D3,($050C,A4)
                            	  4992:     even
                            	  4993: _L_z02_DrawCredits_WriteAttributes:
                            	  4994:     ; Every 4 rows, we have to transfer NT attributes.
                            	  4995:     ; So, when (counter MOD 4) <> 0, skip filling an attribute record.
                            	  4996:     ;
02:00035560 102C050A        	  4997:     move.b  ($050A,A4),D0
02:00035564 E208            	  4998:     lsr.b  #1,D0   ; LSR A
02:00035566 6556            	  4999:     bcs  _L_z02_DrawCredits_IncRow
02:00035568 E208            	  5000:     lsr.b  #1,D0   ; LSR A
02:0003556A 6552            	  5001:     bcs  _L_z02_DrawCredits_IncRow
                            	  5002:     ; Attributes for the left and right blocks are 0.
                            	  5003:     ;
02:0003556C 7400            	  5004:     moveq   #0,D2
02:0003556E 19420328        	  5005:     move.b  D2,($0328,A4)
02:00035572 1942032F        	  5006:     move.b  D2,($032F,A4)
                            	  5007:     ; The row was already divided by 4. So now it refers to an
                            	  5008:     ; NT attribute block row. Look up the attribute byte to use
                            	  5009:     ; for almost every block in this NT attribute block row.
                            	  5010:     ;
02:00035576 7600            	  5011:     moveq   #0,D3
02:00035578 1600            	  5012:     move.b  D0,D3
02:0003557A 41F90003533E    	  5013:     lea     (CreditsAttrs).l,A0
02:00035580 10303000        	  5014:     move.b  (A0,D3.W),D0
                            	  5015:     ; Fill a record with this byte, so the whole NT attribute block
                            	  5016:     ; row is changed.
                            	  5017:     ;
02:00035584 7605            	  5018:     moveq   #5,D3
                            	  5019: _anon_z02_51:
02:00035586 41EC0329        	  5020:     lea     ($0329,A4),A0
02:0003558A 11803000        	  5021:     move.b  D0,(A0,D3.W)
02:0003558E 5303            	  5022:     subq.b  #1,D3
02:00035590 6AF4            	  5023:     bpl  _anon_z02_51
                            	  5024:     ; If tiles are being written to NT 1 (>= $2800), then
                            	  5025:     ; write the high byte of NT 1's attribute space (>= $2BC0).
                            	  5026:     ; Else write the high byte of NT 0's attribute space (>= $23C0).
                            	  5027:     ;
02:00035592 7623            	  5028:     moveq   #35,D3
02:00035594 102C0302        	  5029:     move.b  ($0302,A4),D0
02:00035598 02000008        	  5030:     andi.b #$08,D0
02:0003559C 6702            	  5031:     beq  _anon_z02_52
02:0003559E 762B            	  5032:     moveq   #43,D3
                            	  5033: _anon_z02_52:
02:000355A0 19430325        	  5034:     move.b  D3,($0325,A4)
                            	  5035:     ; Every attribute block row is at an offset (tile row * 2).
                            	  5036:     ;
02:000355A4 102C050A        	  5037:     move.b  ($050A,A4),D0
02:000355A8 0200001F        	  5038:     andi.b #$1F,D0
02:000355AC E308            	  5039:     lsl.b  #1,D0   ; ASL A
                            	  5040:     ; Add the offset to the low byte of attribute space base
                            	  5041:     ; ($23C0 or $2BC0); and write it to the record.
                            	  5042:     ;
02:000355AE 123C00C0        	  5043:     move.b  #$C0,D1
02:000355B2 D101            	  5044:     addx.b  D1,D0   ; ADC #$C0 (X flag = 6502 C)
02:000355B4 19400326        	  5045:     move.b  D0,($0326,A4)
02:000355B8 7008            	  5046:     moveq   #8,D0
02:000355BA 19400327        	  5047:     move.b  D0,($0327,A4)
                            	  5048:     even
                            	  5049: _L_z02_DrawCredits_IncRow:
                            	  5050:     ; Add 1 to the row.
                            	  5051:     ;
02:000355BE 7600            	  5052:     moveq   #0,D3
02:000355C0 162C050A        	  5053:     move.b  ($050A,A4),D3
02:000355C4 5203            	  5054:     addq.b  #1,D3
                            	  5055:     ; Skip the last two rows in each cycle.
                            	  5056:     ; When (row MOD $20) gets to $1E, add 2.
                            	  5057:     ;
                            	  5058:     ; Again, this is because there are
                            	  5059:     ; 240 pixels vertically instead of 256.
                            	  5060:     ;
02:000355C6 1003            	  5061:     move.b  D3,D0
02:000355C8 0200001F        	  5062:     andi.b #$1F,D0
02:000355CC 0C00001E        	  5063:     cmpi.b  #$1E,D0
02:000355D0 6504            	  5064:     bcs  _anon_z02_53
02:000355D2 5203            	  5065:     addq.b  #1,D3
02:000355D4 5203            	  5066:     addq.b  #1,D3
                            	  5067: _anon_z02_53:
02:000355D6 1943050A        	  5068:     move.b  D3,($050A,A4)
02:000355DA 0A3C0001        	  5069:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000355DE 4E75            	  5070:     rts
