02:000383F2 102C066C        	   444:     move.b  ($066C,A4),D0
02:000383F6 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:000383FA 8001            	   446:     or.b  D1,D0
02:000383FC 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
