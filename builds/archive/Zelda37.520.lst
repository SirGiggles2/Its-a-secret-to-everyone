                            	  4866: ; Params:
                            	  4867: ; [02]: bitmask for target door.
                            	  4868: ;
                            	  4869: ; Returns:
                            	  4870: ; A: door attribute for desired direction in current room.
                            	  4871: ; [01]: same as [02] if found; $10 otherwise
                            	  4872: ; [03]: reverse direction index
                            	  4873: ;
                            	  4874: ; Door bits:
                            	  4875: ; 1: E
                            	  4876: ; 2: W
                            	  4877: ; 4: S
                            	  4878: ; 8: N
                            	  4879: ;
                            	  4880: ;
                            	  4881: ; Start with single-bit mask 1.
                            	  4882:     even
