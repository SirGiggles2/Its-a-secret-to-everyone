02:00048562 41EC00AC        	  5026:     lea     ($00AC,A4),A0
02:00048566 52302000        	  5027:     addq.b  #1,(A0,D2.W)
02:0004856A 41EC00AC        	  5028:     lea     ($00AC,A4),A0
02:0004856E 10302000        	  5029:     move.b  (A0,D2.W),D0
02:00048572 0200000F        	  5030:     andi.b #$0F,D0
02:00048576 0C000003        	  5031:     cmpi.b  #$03,D0
02:0004857A 674C            	  5032:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
