02:00034E2E 102C0506        	  4302:     move.b  ($0506,A4),D0
02:00034E32 0C0000C0        	  4303:     cmpi.b  #$C0,D0
02:00034E36 6740            	  4304:     beq  _L_z02_UpdateMode13WinGame_Sub0_Flash_AdvanceSubmode
