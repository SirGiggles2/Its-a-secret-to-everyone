                            	  2393:     ; Update dynamic buffer length with 10 new bytes.
                            	  2394:     ;
02:00047368 1002            	  2395:     move.b  D2,D0
02:0004736A 023C00EE        	  2396:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004736E 123C000A        	  2397:     move.b  #$0A,D1
02:00047372 D101            	  2398:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:00047374 19400301        	  2399:     move.b  D0,($0301,A4)
02:00047378 101D            	  2400:     move.b  (A5)+,D0  ; PLA
02:0004737A 7400            	  2401:     moveq   #0,D2
02:0004737C 1400            	  2402:     move.b  D0,D2
02:0004737E 7005            	  2403:     moveq   #5,D0
