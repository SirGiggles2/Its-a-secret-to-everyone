                            	  2268: ; PATCH P25b: FS2-E backspace handler.
                            	  2269: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2270: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2271: ; one column (8 px), and writes a space ($24) to the erased
                            	  2272: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2273: ; cannot cross into a previous slot's name field.
                            	  2274: _L_z02_ModeE_HandleAOrB_Backspace:
02:000338E0 7600            	  2275:     moveq   #0,D3
02:000338E2 162C0016        	  2276:     move.b  ($0016,A4),D3        ; D3 = current slot
02:000338E6 41F900033204    	  2277:     lea     (SlotToNameOffset).l,A0
02:000338EC 12303000        	  2278:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:000338F0 102C0421        	  2279:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:000338F4 B001            	  2280:     cmp.b   D1,D0
02:000338F6 6322            	  2281:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:000338F8 5300            	  2282:     subq.b  #1,D0
02:000338FA 19400421        	  2283:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:000338FE 532C0423        	  2284:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00033902 122C0070        	  2285:     move.b  ($0070,A4),D1
02:00033906 5101            	  2286:     subi.b  #8,D1
02:00033908 19410070        	  2287:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:0003390C 7224            	  2288:     moveq   #$24,D1              ; space tile
02:0003390E 7600            	  2289:     moveq   #0,D3
02:00033910 1600            	  2290:     move.b  D0,D3                ; D3 = erased offset
02:00033912 41EC0638        	  2291:     lea     ($0638,A4),A0
02:00033916 11813000        	  2292:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2293:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2294:     even
