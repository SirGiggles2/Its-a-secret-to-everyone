                            	  2970:     ;==========================================================================
                            	  2971:     ; CHR RANGE ($0000-$1FFF): 2BPP tile data -> VDP VRAM
                            	  2972:     ;==========================================================================
                            	  2973: .ttf_chr_range:
                            	  2974:     ; Fast path: sequential + horizontal (+1) + tile-aligned
02:0002B25A B27C0001        	  2975:     cmp.w   #1,D1                   ; horizontal increment?
02:0002B25E 6622            	  2976:     bne.s   .ttf_chr_slow
02:0002B260 4A04            	  2977:     tst.b   D4                      ; sequential mode?
02:0002B262 661E            	  2978:     bne.s   .ttf_chr_slow
02:0002B264 3005            	  2979:     move.w  D5,D0
02:0002B266 0240000F        	  2980:     andi.w  #$000F,D0               ; offset within tile
02:0002B26A 4A40            	  2981:     tst.w   D0
02:0002B26C 6614            	  2982:     bne.s   .ttf_chr_slow           ; not tile-aligned
                            	  2983: 
                            	  2984:     ; Delegate to _transfer_chr_block_fast (A0=source, D1.w=dest, D2.l=count)
02:0002B26E 2248            	  2985:     movea.l A0,A1                   ; save source pointer
02:0002B270 3205            	  2986:     move.w  D5,D1                   ; D1.w = PPU dest
02:0002B272 7400            	  2987:     moveq   #0,D2
02:0002B274 3403            	  2988:     move.w  D3,D2                   ; D2.l = byte count
02:0002B276 6100FDC4        	  2989:     bsr     _transfer_chr_block_fast
02:0002B27A D3C3            	  2990:     adda.l  D3,A1                   ; advance past consumed bytes
02:0002B27C 2049            	  2991:     movea.l A1,A0
02:0002B27E 6000045E        	  2992:     bra     .ttf_post_record
