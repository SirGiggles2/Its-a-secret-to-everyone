02:000409C8 0C0000C4        	  6905:     cmpi.b  #$C4,D0
02:000409CC 6728            	  6906:     beq  _L_z05_CheckShortcut_WriteStairs
02:000409CE 0C0000BC        	  6907:     cmpi.b  #$BC,D0
02:000409D2 6720            	  6908:     beq  _L_z05_CheckShortcut_Exit
