                            	  4307: _L_z02_UpdateMode13WinGame_Sub0_Flash_ChangePalette:
02:00034E3A 7400            	  4308:     moveq   #0,D2
02:00034E3C 142C0506        	  4309:     move.b  ($0506,A4),D2
                            	  4310:     ; Don't flash until $40 frames have passed.
                            	  4311:     ;
02:00034E40 0C020040        	  4312:     cmpi.b  #$40,D2
02:00034E44 6530            	  4313:     bcs  _L_z02_UpdateMode13WinGame_Sub0_Flash_Exit
                            	  4314:     ; Copy the level palette transfer buf.
                            	  4315:     ;
02:00034E46 7623            	  4316:     moveq   #35,D3
                            	  4317: _anon_z02_34:
02:00034E48 41F900FF6B7E    	  4318:     lea     (NES_SRAM+$0B7E).l,A0
02:00034E4E 10303000        	  4319:     move.b  (A0,D3.W),D0
02:00034E52 41EC0302        	  4320:     lea     ($0302,A4),A0
02:00034E56 11803000        	  4321:     move.b  D0,(A0,D3.W)
02:00034E5A 5303            	  4322:     subq.b  #1,D3
02:00034E5C 6AEA            	  4323:     bpl  _anon_z02_34
                            	  4324:     ; Use (timer MOD 4) as an index to look up a color.
                            	  4325:     ;
02:00034E5E 1002            	  4326:     move.b  D2,D0
02:00034E60 02000003        	  4327:     andi.b #$03,D0
02:00034E64 7400            	  4328:     moveq   #0,D2
02:00034E66 1400            	  4329:     move.b  D0,D2
                            	  4330:     ; Change element 0 of palette 4 in buffer to change
                            	  4331:     ; the background color.
                            	  4332:     ;
02:00034E68 41F900034E20    	  4333:     lea     (EndingFlashColors).l,A0
02:00034E6E 10302000        	  4334:     move.b  (A0,D2.W),D0
02:00034E72 19400315        	  4335:     move.b  D0,($0315,A4)
                            	  4336:     even
