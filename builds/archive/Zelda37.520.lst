02:00038BD0 123C0001        	  1597:     move.b  #$01,D1
02:00038BD4 D101            	  1598:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038BD6 0C000006        	  1599:     cmpi.b  #$06,D0
