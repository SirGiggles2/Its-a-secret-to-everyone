                            	  8339: ;
                            	  8340: ; Save the coordinates.
                            	  8341: ;
                            	  8342:     even
                            	  8343: Ganon_DrawCloud:
02:0003BD28 1014            	  8344:     move.b  ($0000,A4),D0
