02:00034E7A 19400600        	  4345:     move.b  D0,($0600,A4)
                            	  4346:     ; Wait $40 frames at the beginning of the next mode
                            	  4347:     ; before showing text.
                            	  4348:     ;
02:00034E7E 7040            	  4349:     moveq   #64,D0
02:00034E80 19400028        	  4350:     move.b  D0,($0028,A4)
                            	  4351:     ; Set a long timer of $40 ($280 frames) for the whole duration
                            	  4352:     ; of the next submode.
                            	  4353:     ;
02:00034E84 7040            	  4354:     moveq   #64,D0
02:00034E86 1940004D        	  4355:     move.b  D0,($004D,A4)
02:00034E8A 522C0013        	  4356:     addq.b  #1,($0013,A4)
02:00034E8E 60AA            	  4357:     jmp     _L_z02_UpdateMode13WinGame_Sub0_Flash_ChangePalette
