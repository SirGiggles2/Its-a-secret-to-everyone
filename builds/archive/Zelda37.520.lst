02:0002B28E 3005            	  3007:     move.w  D5,D0
02:0002B290 0240000F        	  3008:     andi.w  #$000F,D0
02:0002B294 15820000        	  3009:     move.b  D2,(A2,D0.W)           ; CHR_TILE_BUF[offset] = byte
                            	  3010: 
