                            	  2415:     ; If not in state 0, then go handle states 1 to 3.
                            	  2416:     ;
02:00039198 102C00AD        	  2417:     move.b  ($00AD,A4),D0
02:0003919C 6702            	  2418:     beq.s  __far_z_04_0020
02:0003919E 602A            	  2419:     jmp  PondFairy_HandleOtherStates
                            	  2420: __far_z_04_0020:
                            	  2421:     ; State 0.
                            	  2422:     ;
                            	  2423:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2424:     ;
02:000391A0 102C0084        	  2425:     move.b  ($0084,A4),D0
