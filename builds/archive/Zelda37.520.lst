02:00039306 660000AA        	  2646:     bne  _L_z04_UpdateRockOrGravestone_State1
                            	  2647:     ; State 0.
                            	  2648:     ;
                            	  2649:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  2650:     ; bracelet, then return.
                            	  2651:     ;
02:0003930A 41EC034F        	  2652:     lea     ($034F,A4),A0
02:0003930E 10302000        	  2653:     move.b  (A0,D2.W),D0
02:00039312 0C000065        	  2654:     cmpi.b  #$65,D0
02:00039316 6708            	  2655:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
