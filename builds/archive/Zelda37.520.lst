02:000388D0 0C000001        	  1136:     cmpi.b  #$01,D0
02:000388D4 6720            	  1137:     beq  _L_z04__TryShooting_TryShootingNow
02:000388D6 0C000009        	  1138:     cmpi.b  #$09,D0
02:000388DA 671A            	  1139:     beq  _L_z04__TryShooting_TryShootingNow
02:000388DC 0C00000A        	  1140:     cmpi.b  #$0A,D0
02:000388E0 6714            	  1141:     beq  _L_z04__TryShooting_TryShootingNow
02:000388E2 41EC0451        	  1142:     lea     ($0451,A4),A0
02:000388E6 10302000        	  1143:     move.b  (A0,D2.W),D0
02:000388EA 660A            	  1144:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1145:     ; and a random value < $F8, then return.
