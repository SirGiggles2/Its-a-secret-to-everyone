02:0002B600 E048            	  3440:     lsr.w   #8,D0
02:0002B602 EA48            	  3441:     lsr.w   #5,D0                   ; D0.w = raw palette id 0..3
02:0002B604 43F900FF1400    	  3442:     lea     (NT_ATTR_CACHE_BASE).l,A1
02:0002B60A 7C00            	  3443:     moveq   #0,D6
02:0002B60C 3C03            	  3444:     move.w  D3,D6
02:0002B60E EB4E            	  3445:     lsl.w   #5,D6
