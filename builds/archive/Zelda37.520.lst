                            	  5250:     bne  _anon_z04_96
                            	  5251: _anon_z04_96:
                            	  5252:     ; If we have the magic clock, or is stunned, then
                            	  5253:     ; go draw and check collisions.
                            	  5254:     ;
02:0003A628 102C066C        	  5255:     move.b  ($066C,A4),D0
02:0003A62C 1234203D        	  5256:     move.b  ($3D,A4,D2.W),D1
02:0003A630 8001            	  5257:     or.b  D1,D0
02:0003A632 660000AE        	  5258:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5259:     ; Every odd screen frame, go straight to drawing
                            	  5260:     ; and checking collisions.
                            	  5261:     ;
02:0003A636 102C0015        	  5262:     move.b  ($0015,A4),D0
02:0003A63A E208            	  5263:     lsr.b  #1,D0   ; LSR A
02:0003A63C 6404            	  5264:     bcc.s  __far_z_04_0047
02:0003A63E 60000118        	  5265:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5266: __far_z_04_0047:
                            	  5267:     ; Otherwise move horizontally.
                            	  5268:     ;
02:0003A642 61000248        	  5269:     jsr     PolsVoice_MoveX
                            	  5270:     ; If state <> 0, then the monster is jumping.
                            	  5271:     ; Go handle vertical movement.
                            	  5272:     ;
02:0003A646 41EC00AC        	  5273:     lea     ($00AC,A4),A0
02:0003A64A 10302000        	  5274:     move.b  (A0,D2.W),D0
02:0003A64E 6706            	  5275:     beq  _L_z04_UpdatePolsVoice_State0
02:0003A650 61000130        	  5276:     jsr     UpdatePolsVoiceState1_Jumping
02:0003A654 6034            	  5277:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  5278: 
                            	  5279:     even
                            	  5280: _L_z04_UpdatePolsVoice_State0:
                            	  5281:     ; State 0. Walking.
                            	  5282:     ;
                            	  5283:     ; If grid offset = 0, then no more distance to cover.
                            	  5284:     ; So, go change to state 1 -- jumping.
                            	  5285:     ;
02:0003A656 41EC0394        	  5286:     lea     ($0394,A4),A0
02:0003A65A 10302000        	  5287:     move.b  (A0,D2.W),D0
02:0003A65E 67000084        	  5288:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5289:     ; Decrement grid offset / distance remaining.
                            	  5290:     ;
02:0003A662 41EC0394        	  5291:     lea     ($0394,A4),A0
02:0003A666 53302000        	  5292:     subq.b  #1,(A0,D2.W)
                            	  5293:     ; Move vertically.
                            	  5294:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5295:     ;
02:0003A66A 41EC0084        	  5296:     lea     ($0084,A4),A0
02:0003A66E 10302000        	  5297:     move.b  (A0,D2.W),D0
02:0003A672 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A676 41F90003A606    	  5299:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003A67C 12303000        	  5300:     move.b  (A0,D3.W),D1
02:0003A680 D101            	  5301:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003A682 41EC0084        	  5302:     lea     ($0084,A4),A0
02:0003A686 11802000        	  5303:     move.b  D0,(A0,D2.W)
                            	  5304:     even
                            	  5305: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5306:     ; If the square the monster is over is walkable, then
                            	  5307:     ; go draw and check object collisions.
                            	  5308:     ;
02:0003A68A 610001F4        	  5309:     jsr     PolsVoice_IsSquareWalkable
02:0003A68E 6452            	  5310:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5311:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5312:     ; then go change to state 1.
                            	  5313:     ;
02:0003A690 41EC041F        	  5314:     lea     ($041F,A4),A0
02:0003A694 10302000        	  5315:     move.b  (A0,D2.W),D0
02:0003A698 020000FC        	  5316:     andi.b #$FC,D0
02:0003A69C 0C0000B0        	  5317:     cmpi.b  #$B0,D0
02:0003A6A0 6742            	  5318:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003A6A2 0C0000F4        	  5319:     cmpi.b  #$F4,D0
02:0003A6A6 643C            	  5320:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5321:     ; Else blocked by something else.
                            	  5322:     ;
                            	  5323:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5324:     ;
02:0003A6A8 41EC0098        	  5325:     lea     ($0098,A4),A0
02:0003A6AC 10302000        	  5326:     move.b  (A0,D2.W),D0
02:0003A6B0 02000003        	  5327:     andi.b #$03,D0
02:0003A6B4 6618            	  5328:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5329:     ; Else facing vertically. Flip the direction.
                            	  5330:     ; Go draw.
                            	  5331:     ;
02:0003A6B6 41EC0098        	  5332:     lea     ($0098,A4),A0
02:0003A6BA 10302000        	  5333:     move.b  (A0,D2.W),D0
02:0003A6BE 0A00000C        	  5334:     eori.b #$0C,D0
02:0003A6C2 41EC0098        	  5335:     lea     ($0098,A4),A0
02:0003A6C6 11802000        	  5336:     move.b  D0,(A0,D2.W)
02:0003A6CA 6000008C        	  5337:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5338: 
                            	  5339:     even
                            	  5340: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  5341:     ; Facing horizontally. Flip the direction.
                            	  5342:     ; Move two pixels, and go draw.
                            	  5343:     ;
02:0003A6CE 0A000003        	  5344:     eori.b #$03,D0
02:0003A6D2 41EC0098        	  5345:     lea     ($0098,A4),A0
02:0003A6D6 11802000        	  5346:     move.b  D0,(A0,D2.W)
02:0003A6DA 610001B0        	  5347:     jsr     PolsVoice_MoveX
02:0003A6DE 610001AC        	  5348:     jsr     PolsVoice_MoveX
                            	  5349:     even
                            	  5350: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003A6E2 6074            	  5351:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5352: 
                            	  5353:     even
                            	  5354: _L_z04_UpdatePolsVoice_SetState1:
                            	  5355:     ; If already in state 1, then go draw and check collisions.
                            	  5356:     ;
02:0003A6E4 41EC00AC        	  5357:     lea     ($00AC,A4),A0
02:0003A6E8 10302000        	  5358:     move.b  (A0,D2.W),D0
02:0003A6EC 6702            	  5359:     beq.s  __far_z_04_0048
02:0003A6EE 6068            	  5360:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5361: __far_z_04_0048:
                            	  5362:     ; Go to state 1.
                            	  5363:     ;
02:0003A6F0 41EC00AC        	  5364:     lea     ($00AC,A4),A0
02:0003A6F4 52302000        	  5365:     addq.b  #1,(A0,D2.W)
                            	  5366:     ; Subtract 1 from facing direction to make an index.
                            	  5367:     ;
02:0003A6F8 7600            	  5368:     moveq   #0,D3
02:0003A6FA 41EC0098        	  5369:     lea     ($0098,A4),A0
02:0003A6FE 16302000        	  5370:     move.b  (A0,D2.W),D3
02:0003A702 5303            	  5371:     subq.b  #1,D3
                            	  5372:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5373:     ;
02:0003A704 41EC0084        	  5374:     lea     ($0084,A4),A0
02:0003A708 10302000        	  5375:     move.b  (A0,D2.W),D0
02:0003A70C 0C000078        	  5376:     cmpi.b  #$78,D0
02:0003A710 6402            	  5377:     bcc  _anon_z04_97
02:0003A712 7603            	  5378:     moveq   #3,D3
                            	  5379: _anon_z04_97:
                            	  5380:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5381:     ;
02:0003A714 0C0000A8        	  5382:     cmpi.b  #$A8,D0
02:0003A718 6502            	  5383:     bcs  _anon_z04_98
02:0003A71A 7607            	  5384:     moveq   #7,D3
                            	  5385: _anon_z04_98:
                            	  5386:     ; Set the vertical speed for the beginning of the jump.
                            	  5387:     ;
02:0003A71C 41F90003A610    	  5388:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003A722 10303000        	  5389:     move.b  (A0,D3.W),D0
02:0003A726 41EC0412        	  5390:     lea     ($0412,A4),A0
02:0003A72A 11802000        	  5391:     move.b  D0,(A0,D2.W)
                            	  5392:     ; Look up the Y offset for the current direction.
                            	  5393:     ; Add it to object Y to set the destination Y of the jump.
                            	  5394:     ;
02:0003A72E 41EC0084        	  5395:     lea     ($0084,A4),A0
02:0003A732 10302000        	  5396:     move.b  (A0,D2.W),D0
02:0003A736 023C00EE        	  5397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A73A 41F90003A618    	  5398:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003A740 12303000        	  5399:     move.b  (A0,D3.W),D1
02:0003A744 D101            	  5400:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003A746 41EC042C        	  5401:     lea     ($042C,A4),A0
02:0003A74A 11802000        	  5402:     move.b  D0,(A0,D2.W)
                            	  5403:     ; Turn the index into a direction again by adding 1.
                            	  5404:     ; Store the facing direction.
                            	  5405:     ;
02:0003A74E 5203            	  5406:     addq.b  #1,D3
