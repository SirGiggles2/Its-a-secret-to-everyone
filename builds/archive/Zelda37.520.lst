02:00038C32 41EC034F        	  1645:     lea     ($034F,A4),A0
02:00038C36 16302000        	  1646:     move.b  (A0,D2.W),D3
02:00038C3A 0C030011        	  1647:     cmpi.b  #$11,D3
02:00038C3E 6620            	  1648:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038C40 7600            	  1649:     moveq   #0,D3
02:00038C42 41EC00AC        	  1650:     lea     ($00AC,A4),A0
02:00038C46 16302000        	  1651:     move.b  (A0,D2.W),D3
02:00038C4A 0C030002        	  1652:     cmpi.b  #$02,D3
