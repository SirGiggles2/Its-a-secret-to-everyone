                            	  2074:     even
                            	  2075: _L_z04_UpdateOctorock_SaveOffset:
02:00038F74 1B00            	  2076:     move.b  D0,-(A5)  ; PHA
                            	  2077:     ; Decrement the animation counter, and roll over if needed.
                            	  2078:     ;
02:00038F76 41EC03D0        	  2079:     lea     ($03D0,A4),A0
02:00038F7A 53302000        	  2080:     subq.b  #1,(A0,D2.W)
02:00038F7E 661E            	  2081:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:00038F80 7006            	  2082:     moveq   #6,D0
02:00038F82 41EC03D0        	  2083:     lea     ($03D0,A4),A0
02:00038F86 11802000        	  2084:     move.b  D0,(A0,D2.W)
                            	  2085:     ; There are actually 6 frame images divided into 2 sets.
                            	  2086:     ; Each set depicts one animation frame. In each set there are
                            	  2087:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2088:     ;
                            	  2089:     ; The movement frame will keep track of the base offset of
                            	  2090:     ; the current set for the current animation frame: 0 or 3.
                            	  2091:     ;
                            	  2092:     ; So, XOR the movement frame with 3.
                            	  2093:     ;
02:00038F8A E208            	  2094:     lsr.b  #1,D0   ; LSR A
02:00038F8C 41EC03E4        	  2095:     lea     ($03E4,A4),A0
02:00038F90 12302000        	  2096:     move.b  (A0,D2.W),D1
02:00038F94 B300            	  2097:     eor.b  D1,D0
02:00038F96 41EC03E4        	  2098:     lea     ($03E4,A4),A0
02:00038F9A 11802000        	  2099:     move.b  D0,(A0,D2.W)
                            	  2100:     even
                            	  2101: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  2102:     ; Add the base offset and the directional offset, and save the result.
                            	  2103:     ;
02:00038F9E 101D            	  2104:     move.b  (A5)+,D0  ; PLA
02:00038FA0 023C00EE        	  2105:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038FA4 41EC03E4        	  2106:     lea     ($03E4,A4),A0
02:00038FA8 12302000        	  2107:     move.b  (A0,D2.W),D1
02:00038FAC D101            	  2108:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
