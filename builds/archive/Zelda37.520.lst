                            	   389: UpdateMenuStartOW:
                            	   390:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   391:     ; make it look completely empty, and no piece has been won.
                            	   392:     ;
02:0003C9AE 7617            	   393:     moveq   #23,D3
                            	   394: _anon_z05_6:
02:0003C9B0 7400            	   395:     moveq   #0,D2
02:0003C9B2 41F90003C966    	   396:     lea     (TriforceTransferBufOffsets).l,A0
02:0003C9B8 14303000        	   397:     move.b  (A0,D3.W),D2
02:0003C9BC 41F90003C996    	   398:     lea     (TriforceTransferBufTiles).l,A0
02:0003C9C2 10303000        	   399:     move.b  (A0,D3.W),D0
02:0003C9C6 41F90004398C    	   400:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003C9CC 11802000        	   401:     move.b  D0,(A0,D2.W)
02:0003C9D0 5303            	   402:     subq.b  #1,D3
02:0003C9D2 6ADC            	   403:     bpl  _anon_z05_6
                            	   404:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   405:     ;
02:0003C9D4 5203            	   406:     addq.b  #1,D3
                            	   407:     ; Outer loop.
                            	   408:     ; A level test bit in [06] will be used to see whether
                            	   409:     ; we have a triforce piece.
                            	   410:     ;
02:0003C9D6 7001            	   411:     moveq   #1,D0
02:0003C9D8 19400006        	   412:     move.b  D0,($0006,A4)
                            	   413:     even
                            	   414: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   415:     ; Inner loop.
                            	   416:     ; Each level bit will make 3 triforce tile slots be
                            	   417:     ; checked and replaced.
                            	   418:     ;
02:0003C9DC 7003            	   419:     moveq   #3,D0
02:0003C9DE 19400007        	   420:     move.b  D0,($0007,A4)
                            	   421:     even
                            	   422: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   423:     ; Get the offset into the submenu triforce transfer buffers of
                            	   424:     ; the current tile slot.
                            	   425:     ;
02:0003C9E2 7400            	   426:     moveq   #0,D2
02:0003C9E4 41F90003C966    	   427:     lea     (TriforceTransferBufOffsets).l,A0
02:0003C9EA 14303000        	   428:     move.b  (A0,D3.W),D2
                            	   429:     ; If the level test bit is not in the triforce mask, then we don't
                            	   430:     ; have this piece. So, go loop again, and leave the tile in the
                            	   431:     ; empty state.
                            	   432:     ;
                            	   433:     ;
                            	   434:     ; [06] level test mask
02:0003C9EE 102C0006        	   435:     move.b  ($0006,A4),D0
02:0003C9F2 122C0671        	   436:     move.b  ($0671,A4),D1
02:0003C9F6 C200            	   437:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C9F8 6730            	   438:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   439:     ; We have the triforce piece.
                            	   440:     ;
                            	   441:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   442:     ; then make it $F5. These are tiles that were half full, and now
                            	   443:     ; need to be full.
                            	   444:     ;
                            	   445:     ; Else replace it with the one at the current triforce tile slot
                            	   446:     ; in the replacement list.
                            	   447:     ;
02:0003C9FA 41F90004398C    	   448:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003CA00 10302000        	   449:     move.b  (A0,D2.W),D0
02:0003CA04 0C0000E5        	   450:     cmpi.b  #$E5,D0
02:0003CA08 6712            	   451:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003CA0A 0C0000E6        	   452:     cmpi.b  #$E6,D0
02:0003CA0E 670C            	   453:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003CA10 41F90003C97E    	   454:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003CA16 10303000        	   455:     move.b  (A0,D3.W),D0
02:0003CA1A 6004            	   456:     jmp     _anon_z05_7
                            	   457: 
                            	   458:     even
                            	   459: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003CA1C 103C00F5        	   460:     move.b  #$F5,D0
                            	   461: _anon_z05_7:
02:0003CA20 41F90004398C    	   462:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003CA26 11802000        	   463:     move.b  D0,(A0,D2.W)
                            	   464:     even
                            	   465: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   466:     ; Bottom of the inner loop.
                            	   467:     ;
                            	   468:     ; Increment the triforce tile slot.
                            	   469:     ; Decrement [07] and loop again, if it's not 0.
                            	   470:     ;
02:0003CA2A 5203            	   471:     addq.b  #1,D3
02:0003CA2C 532C0007        	   472:     subq.b  #1,($0007,A4)
02:0003CA30 66B0            	   473:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   474:     ; Bottom of the outer loop.
                            	   475:     ;
                            	   476:     ; Shift the level test bit [06] left to test the next level.
                            	   477:     ; When it becomes 0, we're done.
                            	   478:     ;
02:0003CA32 122C0006        	   479:     move.b  ($0006,A4),D1
02:0003CA36 E309            	   480:     lsl.b  #1,D1   ; ASL $06
02:0003CA38 19410006        	   481:     move.b  D1,($0006,A4)
02:0003CA3C 669E            	   482:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003CA3E 522C00E1        	   483:     addq.b  #1,($00E1,A4)
02:0003CA42 4E75            	   484:     rts
                            	   485: 
                            	   486:     even
                            	   487: ScrollWorld:
02:0003CA44 102C0015        	   488:     move.b  ($0015,A4),D0
                            	   489:     ; The purpose of this is to delay vertical scrolling.
                            	   490:     ; OW: once every two frames
                            	   491:     ; UW: once every four frames
                            	   492:     ; Horizontal scrolling happens every frame.
02:0003CA48 02000003        	   493:     andi.b #$03,D0
