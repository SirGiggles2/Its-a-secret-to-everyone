                            	  1778:     ;
02:00038D3A 7628            	  1779:     moveq   #40,D3
02:00038D3C 41EC0098        	  1780:     lea     ($0098,A4),A0
02:00038D40 10302000        	  1781:     move.b  (A0,D2.W),D0
02:00038D44 02000008        	  1782:     andi.b #$08,D0
02:00038D48 6704            	  1783:     beq  _anon_z04_44
02:00038D4A 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:00038D4E 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
02:00038D50 102C0084        	  1789:     move.b  ($0084,A4),D0
02:00038D54 023C00EE        	  1790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D58 1214            	  1791:     move.b  ($0000,A4),D1
02:00038D5A D101            	  1792:     addx.b  D1,D0   ; ADC $00
                            	  1793:     ; Sanitize the Y coordinate:
                            	  1794:     ; (Y AND $F0) OR $D
                            	  1795:     ;
02:00038D5C 020000F0        	  1796:     andi.b #$F0,D0
02:00038D60 0000000D        	  1797:     ori.b #$0D,D0
02:00038D64 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038D68 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
                            	  1802:     ;
                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038D6C 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038D70 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
02:00038D72 4E75            	  1809:     rts
                            	  1810: 
                            	  1811:     even
                            	  1812: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  1813:     ; Begin with the leever's Y set to Link's Y.
                            	  1814:     ;
02:00038D74 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038D78 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038D7C 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038D80 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038D84 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038D86 7628            	  1826:     moveq   #40,D3
02:00038D88 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038D8C 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038D90 02000002        	  1829:     andi.b #$02,D0
02:00038D94 6704            	  1830:     beq  _anon_z04_45
02:00038D96 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038D9A 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038D9C 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038DA0 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038DA4 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038DA8 1214            	  1841:     move.b  ($0000,A4),D1
02:00038DAA D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038DAC 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038DB0 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038DB4 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038DB8 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038DBC B001            	  1853:     cmp.b   D1,D0
02:00038DBE 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038DC0 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038DC2 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038DC6 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038DCA 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038DCC 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038DD0 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038DD4 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038DD8 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038DDC 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038DE0 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038DE2 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038DE6 0C000030        	  1874:     cmpi.b  #$30,D0
02:00038DEA 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
                            	  1877: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1878:     ; The leever can't come out of an unwalkable tile. So, return.
