                            	  4245:     ; The object is Link. We end up here regardless of walkability.
                            	  4246:     ;
                            	  4247:     ; If not in mode 5 or ladder is in use, return.
                            	  4248:     ;
02:00048024 102C0012        	  4249:     move.b  ($0012,A4),D0
02:00048028 0C000005        	  4250:     cmpi.b  #$05,D0
02:0004802C 6702            	  4251:     beq.s  __far_z_07_0057
