                            	  3840: _anon_z04_81:
                            	  3841:     ; Chase while flying, as usual.
                            	  3842:     ;
02:00039C1C 610027FE        	  3843:     jsr     Flyer_Chase
                            	  3844:     ; If timer has not expired, then
                            	  3845:     ; go see if it's time to propagate direction changes down the chain.
                            	  3846:     ;
02:00039C20 10342028        	  3847:     move.b  ($28,A4,D2.W),D0
02:00039C24 6702            	  3848:     beq.s  __far_z_04_0026
02:00039C26 6032            	  3849:     jmp  Moldorm_PropagateDirs
                            	  3850: __far_z_04_0026:
