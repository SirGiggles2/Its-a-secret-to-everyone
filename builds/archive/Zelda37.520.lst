                            	  3830: Moldorm_Chase:
                            	  3831:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  3832:     ; Only the head controls the movement direction.
                            	  3833:     ;
02:00039C0C 0C020005        	  3834:     cmpi.b  #$05,D2
02:00039C10 670A            	  3835:     beq  _anon_z04_81
02:00039C12 0C02000A        	  3836:     cmpi.b  #$0A,D2
02:00039C16 6704            	  3837:     beq.s  __far_z_04_0025
