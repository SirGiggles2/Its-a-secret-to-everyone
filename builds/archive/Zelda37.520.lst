02:00039286 102C0071        	  2583:     move.b  ($0071,A4),D0
02:0003928A 19802070        	  2584:     move.b  D0,($70,A4,D2.W)
                            	  2585:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  2586:     ;
02:0003928E 102C0085        	  2587:     move.b  ($0085,A4),D0
02:00039292 003C0011        	  2588:     ori     #$11,CCR  ; SEC: set C+X
02:00039296 123C001C        	  2589:     move.b  #$1C,D1
02:0003929A 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003929E 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:000392A0 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:000392A4 41EC0084        	  2593:     lea     ($0084,A4),A0
02:000392A8 11802000        	  2594:     move.b  D0,(A0,D2.W)
                            	  2595:     even
                            	  2596: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  2597:     ; Decrease the angle by $00.60.
                            	  2598:     ;
02:000392AC 7000            	  2599:     moveq   #0,D0
