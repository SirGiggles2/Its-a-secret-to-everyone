02:0003938C 11802000        	  2716:     move.b  D0,(A0,D2.W)
02:00039390 41EC00AC        	  2717:     lea     ($00AC,A4),A0
02:00039394 52302000        	  2718:     addq.b  #1,(A0,D2.W)
                            	  2719:     ; Store current room ID.
