                            	  2056: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2057:     ; We got here in one of three ways:
                            	  2058:     ;
                            	  2059:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2060:     ;    explicitly.
                            	  2061:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2062:     ;    held an offset that was added to base palette attribute
                            	  2063:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2064:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2065:     ;    held absolute attributes.
                            	  2066:     ;
                            	  2067:     ; At this point, A holds the final sprite attributes.
02:000470FC 7400            	  2068:     moveq   #0,D2
02:000470FE 1942000C        	  2069:     move.b  D2,($000C,A4)
02:00047102 740F            	  2070:     moveq   #15,D2
                            	  2071:     ; Write sprites.
                            	  2072:     ; A holds the calculated sprite attributes.
                            	  2073:     ; Y holds the item slot.
02:00047104 4EF9000310B0    	  2074:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2075: 
                            	  2076:     even
                            	  2077: _L_z07_DrawItemBySlot_AddItemAndTableValue:
                            	  2078:     ; Calculate sprite attributes by adding item value / sprite palette
                            	  2079:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2080:     ; which here represents an offset from the palette row.
                            	  2081:     ;
02:0004710A 023C00EE        	  2082:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004710E 122C0004        	  2083:     move.b  ($0004,A4),D1
02:00047112 D101            	  2084:     addx.b  D1,D0   ; ADC $04
02:00047114 4A02            	  2085:     cmpi.b  #$00,D2
02:00047116 66E4            	  2086:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00047118 0C000002        	  2087:     cmpi.b  #$02,D0
02:0004711C 66DE            	  2088:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004711E 7620            	  2089:     moveq   #32,D3
02:00047120 60DA            	  2090:     jmp     _L_z07_DrawItemBySlot_WriteSprites
