02:0003BA04 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003BA06 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BA0A 41EC0084        	  7875:     lea     ($0084,A4),A0
