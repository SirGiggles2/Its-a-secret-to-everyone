                            	  2544: ;==============================================================================
                            	  2545: ; _indirect_stub — JMP (abs) indirect placeholder.
                            	  2546: ; Called when the transpiler can't resolve an indirect jump target at
                            	  2547: ; translate-time.  Halts via an infinite bra so BizHawk shows PC stuck here.
                            	  2548: ; In T9+ these will be replaced by computed dispatch tables.
                            	  2549: ;==============================================================================
                            	  2550: _indirect_stub:
02:0002AF70 60FE            	  2551:     bra.s   _indirect_stub          ; spin — caught as deliberate halt in T9+
                            	  2552: 
                            	  2553: ;==============================================================================
                            	  2554: ; _m68k_tablejump — M68K-native replacement for the NES JSR-trick TableJump.
                            	  2555: ;
                            	  2556: ; On NES, "JSR TableJump" is a JSR-trick: the bytes after the JSR are a
                            	  2557: ; table of 16-bit vectors.  TableJump pops the return address from the 6502
                            	  2558: ; stack to find the table base, then jumps through it using the value in A.
                            	  2559: ;
                            	  2560: ; In M68K, BSR pushes the return address (= table base) onto A7 (M68K stack),
                            	  2561: ; not A5 (our NES stack).  The original TableJump pulled from A5 (zeros),
                            	  2562: ; constructing a bogus NES address and jumping into garbage.
                            	  2563: ;
                            	  2564: ; This replacement correctly pops the M68K return address as the dc.l table
                            	  2565: ; base, indexes by D0.b × 4, and dispatches.
                            	  2566: ;
                            	  2567: ; Calling convention:
                            	  2568: ;   D0.b = mode index
                            	  2569: ;   (A7)  = base address of the dc.l jump table (pushed by BSR)
                            	  2570: ;   Jumps directly to the selected target (does not RTS).
                            	  2571: ;==============================================================================
                            	  2572: _m68k_tablejump:
02:0002AF72 205F            	  2573:     movea.l (SP)+,A0        ; pop M68K return address = dc.l table base
02:0002AF74 C07C00FF        	  2574:     and.w   #$00FF,D0       ; zero-extend mode byte → word
02:0002AF78 E548            	  2575:     lsl.w   #2,D0           ; D0.w = index × 4  (each dc.l = 4 bytes)
02:0002AF7A 20700000        	  2576:     movea.l (A0,D0.W),A0   ; load 32-bit target address from table
02:0002AF7E 4ED0            	  2577:     jmp     (A0)            ; dispatch (no return)
                            	  2578: 
                            	  2579: ;==============================================================================
                            	  2580: ; _clear_nametable_fast — Fast replacement for ClearNameTable.
                            	  2581: ;
                            	  2582: ; Fills Plane A with a tile word directly via VDP_DATA (bypassing _ppu_write_7)
                            	  2583: ; and clears NT_CACHE.  V64 plane: NT0 ($20) → rows 0-29, NT1 ($28) → rows 30-59.
                            	  2584: ;
                            	  2585: ; Input:
                            	  2586: ;   D0.b = hi byte of NES PPU address ($20 = nametable 0, $28 = nametable 1)
                            	  2587: ;   D2.b = tile index to fill with
                            	  2588: ;   D3.b = attribute byte (always 0 for Zelda clear; palette 0 used)
                            	  2589: ;
                            	  2590: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2591: ; Updates PPU_VADDR to the post-clear address (matching original behavior).
                            	  2592: ;==============================================================================
                            	  2593:     even
                            	  2594: _clear_nametable_fast:
02:0002AF80 48E7F880        	  2595:     movem.l D0-D4/A0,-(SP)
                            	  2596: 
                            	  2597:     ; Save NT selection before D0 is clobbered
02:0002AF84 1800            	  2598:     move.b  D0,D4                   ; D4.b = NT hi byte ($20 or $28)
                            	  2599: 
                            	  2600:     ; Compute the end PPU_VADDR: start + 1024 tiles + 64 attributes = +$0440
02:0002AF86 024000FF        	  2601:     andi.w  #$00FF,D0
02:0002AF8A E148            	  2602:     lsl.w   #8,D0                   ; D0.w = PPU base ($2000 or $2800)
02:0002AF8C 06400440        	  2603:     addi.w  #$0440,D0
02:0002AF90 33C000FF0802    	  2604:     move.w  D0,(PPU_VADDR).l        ; set PPU_VADDR to expected end value
                            	  2605: 
                            	  2606:     ; Build tile word from the current BG pattern-table selection
02:0002AF96 7000            	  2607:     moveq   #0,D0
02:0002AF98 1002            	  2608:     move.b  D2,D0                   ; D0.w = raw tile index
02:0002AF9A 4EB90000E984    	  2609:     bsr     _compose_bg_tile_word
02:0002AFA0 3200            	  2610:     move.w  D0,D1                   ; D1.w = tile word to write
                            	  2611: 
                            	  2612:     ; Determine VRAM start address based on NT selection
02:0002AFA2 0C040028        	  2613:     cmpi.b  #$28,D4
02:0002AFA6 672A            	  2614:     beq.s   .cnf_nt1
                            	  2615: 
                            	  2616:     ; ---- NT0: Fill Plane A rows 0-29 starting at $C000 ----
                            	  2617:     ; Phase 2c: also fill Window nametable rows 0-7 (256 tiles = 512 bytes).
                            	  2618:     ; Without this, NT0-clear requests leave stale HUD tiles in Window
                            	  2619:     ; after a mode transition that clears NT0.
02:0002AFA8 23FC7000000200C0	  2620:     move.l  #$70000002,(VDP_CTRL).l ; VRAM write at $B000 (Window)
02:0002AFB0 0004
02:0002AFB2 363C00FF        	  2621:     move.w  #255,D3                 ; 32 cols * 8 rows - 1
                            	  2622: .cnf_window_fill:
02:0002AFB6 33C100C00000    	  2623:     move.w  D1,(VDP_DATA).l
02:0002AFBC 51CBFFF8        	  2624:     dbf     D3,.cnf_window_fill
                            	  2625: 
02:0002AFC0 23FC4000000300C0	  2626:     move.l  #$40000003,(VDP_CTRL).l ; VRAM write at $C000
02:0002AFC8 0004
                            	  2627:     ; Clear NT_CACHE offsets 0-959 (NT0)
02:0002AFCA 41F900FF0840    	  2628:     lea     (NT_CACHE_BASE).l,A0
02:0002AFD0 6010            	  2629:     bra.s   .cnf_fill
                            	  2630: 
                            	  2631: .cnf_nt1:
                            	  2632:     ; ---- NT1: Fill Plane A rows 30-63 starting at $CF00 ----
                            	  2633:     ; 34 rows = 30 NT1 rows + 4 gap rows (prevents garbage when scroll wraps).
                            	  2634:     ; $CF00 = $C000 + 30*$80.  VDP command: ($CF00 & $3FFF)<<16 | $40000003
                            	  2635:     ; NT1 doesn't touch HUD range — skip Window fill.
02:0002AFD2 23FC4F00000300C0	  2636:     move.l  #$4F000003,(VDP_CTRL).l ; VRAM write at $CF00
02:0002AFDA 0004
                            	  2637:     ; Clear NT_CACHE offsets 960-1919 (NT1)
02:0002AFDC 41F900FF0C00    	  2638:     lea     (NT_CACHE_BASE+960).l,A0
                            	  2639: 
                            	  2640: .cnf_fill:
                            	  2641:     ; Write tiles to Plane A rows.  Plane A is 64 tiles wide,
                            	  2642:     ; so after each 32-tile NES row we must skip 32 unused tiles.
                            	  2643:     ; NT0: 30 rows (0-29).  NT1: 34 rows (30-63, includes 4 gap rows).
02:0002AFE2 0C040028        	  2644:     cmpi.b  #$28,D4
02:0002AFE6 6604            	  2645:     bne.s   .cnf_nt0_count
02:0002AFE8 7621            	  2646:     moveq   #34-1,D3                ; NT1: 34 rows (fills gap rows 60-63)
02:0002AFEA 6002            	  2647:     bra.s   .cnf_row
                            	  2648: .cnf_nt0_count:
02:0002AFEC 761D            	  2649:     moveq   #30-1,D3                ; NT0: 30 rows
                            	  2650: .cnf_row:
02:0002AFEE 781F            	  2651:     moveq   #32-1,D4                ; 32 cols per row
                            	  2652: .cnf_col:
02:0002AFF0 33C100C00000    	  2653:     move.w  D1,(VDP_DATA).l
02:0002AFF6 51CCFFF8        	  2654:     dbf     D4,.cnf_col
                            	  2655: 
                            	  2656:     ; Skip 32 unused tile slots (64 bytes) in Plane A row.
02:0002AFFA 781F            	  2657:     moveq   #32-1,D4
                            	  2658: .cnf_skip:
02:0002AFFC 33C100C00000    	  2659:     move.w  D1,(VDP_DATA).l         ; write same tile to unused slots (harmless)
02:0002B002 51CCFFF8        	  2660:     dbf     D4,.cnf_skip
                            	  2661: 
02:0002B006 51CBFFE6        	  2662:     dbf     D3,.cnf_row
                            	  2663: 
                            	  2664:     ; ---- Clear NT_CACHE (960 bytes for the selected NT) ----
02:0002B00A 363C03BF        	  2665:     move.w  #960-1,D3
02:0002B00E 1001            	  2666:     move.b  D1,D0                   ; fill byte = tile index
                            	  2667: .cnf_cache:
02:0002B010 10C0            	  2668:     move.b  D0,(A0)+
02:0002B012 51CBFFFC        	  2669:     dbf     D3,.cnf_cache
                            	  2670: 
                            	  2671:     ; Clear matching transfer-interpreter palette shadow for this NT.
02:0002B016 0C040028        	  2672:     cmpi.b  #$28,D4
02:0002B01A 6708            	  2673:     beq.s   .cnf_attr_nt1
02:0002B01C 41F900FF1400    	  2674:     lea     (NT_ATTR_CACHE_BASE).l,A0
02:0002B022 6006            	  2675:     bra.s   .cnf_attr_fill
                            	  2676: .cnf_attr_nt1:
02:0002B024 41F900FF17C0    	  2677:     lea     (NT_ATTR_CACHE_BASE+960).l,A0
                            	  2678: .cnf_attr_fill:
02:0002B02A 363C03BF        	  2679:     move.w  #960-1,D3
02:0002B02E 4200            	  2680:     clr.b   D0
                            	  2681: .cnf_attr_loop:
02:0002B030 10C0            	  2682:     move.b  D0,(A0)+
02:0002B032 51CBFFFC        	  2683:     dbf     D3,.cnf_attr_loop
                            	  2684: 
                            	  2685: .cnf_done:
02:0002B036 4CDF011F        	  2686:     movem.l (SP)+,D0-D4/A0
02:0002B03A 4E75            	  2687:     rts
                            	  2688: 
                            	  2689: ;==============================================================================
                            	  2690: ; _transfer_chr_block_fast — Bulk 2BPP→4BPP tile transfer to VDP VRAM.
                            	  2691: ;
                            	  2692: ; Bypasses _ppu_write_7 entirely.  Reads NES 2BPP tile data from a ROM source
                            	  2693: ; address, converts each 16-byte tile to 32-byte Genesis 4BPP, and writes
                            	  2694: ; directly to VDP VRAM.  Processes full tiles (16 bytes each).
                            	  2695: ;
                            	  2696: ; Input:
                            	  2697: ;   A0     = ROM source address (32-bit, points to NES 2BPP tile data)
                            	  2698: ;   D1.w   = NES PPU destination address (CHR range $0000–$1FFF)
                            	  2699: ;   D2.l   = byte count (must be multiple of 16)
                            	  2700: ;
                            	  2701: ; Output:
                            	  2702: ;   PPU_VADDR updated to D1 + D2 (post-transfer address)
                            	  2703: ;
                            	  2704: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2705: ;==============================================================================
                            	  2706:     even
                            	  2707: _transfer_chr_block_fast:
                            	  2708:     ifne CHR_EXPANSION_ENABLED
                            	  2709:     ; If destination is sprite half ($0000-$0FFF), stage each 16-byte tile
                            	  2710:     ; through CHR_TILE_BUF and call _chr_upload_sprite_4x (emits 4 biased
                            	  2711:     ; copies).  BG half ($1000-$1FFF) takes the legacy 1x fast path below.
02:0002B03C 3A01            	  2712:     move.w  D1,D5
02:0002B03E 02451000        	  2713:     andi.w  #$1000,D5
02:0002B042 663A            	  2714:     bne.s   .tcbf_legacy_entry
02:0002B044 48E7FFE0        	  2715:     movem.l D0-D7/A0-A2,-(SP)
                            	  2716: .tcbf_4x_loop:
02:0002B048 4A82            	  2717:     tst.l   D2
02:0002B04A 6F26            	  2718:     ble.s   .tcbf_4x_done
02:0002B04C 43F900FF0820    	  2719:     lea     (CHR_TILE_BUF).l,A1
02:0002B052 22D8            	  2720:     move.l  (A0)+,(A1)+
02:0002B054 22D8            	  2721:     move.l  (A0)+,(A1)+
02:0002B056 22D8            	  2722:     move.l  (A0)+,(A1)+
02:0002B058 22D8            	  2723:     move.l  (A0)+,(A1)+
02:0002B05A 33C100FF0832    	  2724:     move.w  D1,(CHR_BUF_VADDR).l
02:0002B060 4EB90000E842    	  2725:     bsr     _chr_upload_sprite_4x
02:0002B066 06410010        	  2726:     addi.w  #16,D1
02:0002B06A 048200000010    	  2727:     subi.l  #16,D2
02:0002B070 60D6            	  2728:     bra.s   .tcbf_4x_loop
                            	  2729: .tcbf_4x_done:
02:0002B072 33C100FF0802    	  2730:     move.w  D1,(PPU_VADDR).l
02:0002B078 4CDF07FF        	  2731:     movem.l (SP)+,D0-D7/A0-A2
02:0002B07C 4E75            	  2732:     rts
                            	  2733: .tcbf_legacy_entry:
                            	  2734:     endc
02:0002B07E 48E7FEE0        	  2735:     movem.l D0-D6/A0-A2,-(SP)
                            	  2736: 
                            	  2737:     ; Save byte count for PPU_VADDR update at end
02:0002B082 2002            	  2738:     move.l  D2,D0                   ; D0.l = total byte count
                            	  2739: 
                            	  2740:     ; A2 = LUT base (kept across all tiles)
02:0002B084 45F90002B16E    	  2741:     lea     (.fast_expand_lut).l,A2
                            	  2742: 
                            	  2743:     ; A0 = ROM source (already set by caller)
                            	  2744:     ; D1.w = NES PPU dest address
                            	  2745: 
                            	  2746: .ftcb_tile:
02:0002B08A 4A82            	  2747:     tst.l   D2
02:0002B08C 6F0000D4        	  2748:     ble     .ftcb_done
                            	  2749: 
02:0002B090 0839000500FF0804	  2750:     btst    #5,(PPU_CTRL).l
02:0002B098 672C            	  2751:     beq.s   .ftcb_no_stage_hi_sprite
02:0002B09A 0C411F20        	  2752:     cmpi.w  #$1F20,D1
02:0002B09E 6526            	  2753:     blo.s   .ftcb_no_stage_hi_sprite
02:0002B0A0 0C411F40        	  2754:     cmpi.w  #$1F40,D1
02:0002B0A4 6420            	  2755:     bhs.s   .ftcb_no_stage_hi_sprite
02:0002B0A6 43F900FF0820    	  2756:     lea     (CHR_TILE_BUF).l,A1
02:0002B0AC 2290            	  2757:     move.l  0(A0),(A1)
02:0002B0AE 236800040004    	  2758:     move.l  4(A0),4(A1)
02:0002B0B4 236800080008    	  2759:     move.l  8(A0),8(A1)
02:0002B0BA 2368000C000C    	  2760:     move.l  12(A0),12(A1)
02:0002B0C0 33C100FF0832    	  2761:     move.w  D1,(CHR_BUF_VADDR).l
                            	  2762: .ftcb_no_stage_hi_sprite:
                            	  2763: 
                            	  2764:     ; Set VDP write address: Genesis VRAM addr = NES CHR addr × 2
02:0002B0C6 3601            	  2765:     move.w  D1,D3
02:0002B0C8 D643            	  2766:     add.w   D3,D3                   ; D3.w = VDP VRAM address
02:0002B0CA 7800            	  2767:     moveq   #0,D4
02:0002B0CC 3803            	  2768:     move.w  D3,D4
02:0002B0CE 4844            	  2769:     swap    D4                      ; D4 = addr << 16
02:0002B0D0 008440000000    	  2770:     ori.l   #$40000000,D4           ; VDP VRAM-write command
02:0002B0D6 23C400C00004    	  2771:     move.l  D4,(VDP_CTRL).l
                            	  2772: 
                            	  2773:     ; Convert 8 rows of this tile
02:0002B0DC 7A07            	  2774:     moveq   #7,D5                   ; row counter
                            	  2775: 
                            	  2776: .ftcb_row:
                            	  2777:     ; plane0 = (A0), plane1 = 8(A0)
02:0002B0DE 7600            	  2778:     moveq   #0,D3
02:0002B0E0 1610            	  2779:     move.b  (A0),D3                 ; D3.b = plane 0 row byte
02:0002B0E2 7800            	  2780:     moveq   #0,D4
02:0002B0E4 18280008        	  2781:     move.b  8(A0),D4                ; D4.b = plane 1 row byte
                            	  2782: 
                            	  2783:     ; ---- Pixels 0-3 (upper nibbles) ----
02:0002B0E8 1C03            	  2784:     move.b  D3,D6
02:0002B0EA E80E            	  2785:     lsr.b   #4,D6
02:0002B0EC 0246000F        	  2786:     andi.w  #$000F,D6
02:0002B0F0 DC46            	  2787:     add.w   D6,D6
02:0002B0F2 3C326000        	  2788:     move.w  (A2,D6.W),D6           ; D6.w = plane0 upper expanded
                            	  2789: 
02:0002B0F6 1004            	  2790:     move.b  D4,D0
02:0002B0F8 E808            	  2791:     lsr.b   #4,D0
02:0002B0FA 0240000F        	  2792:     andi.w  #$000F,D0
02:0002B0FE D040            	  2793:     add.w   D0,D0
02:0002B100 30320000        	  2794:     move.w  (A2,D0.W),D0           ; D0.w = plane1 upper expanded
02:0002B104 E348            	  2795:     lsl.w   #1,D0                   ; shift plane1 to bit 1
02:0002B106 8046            	  2796:     or.w    D6,D0                   ; combine
02:0002B108 33C000C00000    	  2797:     move.w  D0,(VDP_DATA).l         ; write pixels 0-3
                            	  2798: 
                            	  2799:     ; ---- Pixels 4-7 (lower nibbles) ----
02:0002B10E 1C03            	  2800:     move.b  D3,D6
02:0002B110 0246000F        	  2801:     andi.w  #$000F,D6
02:0002B114 DC46            	  2802:     add.w   D6,D6
02:0002B116 3C326000        	  2803:     move.w  (A2,D6.W),D6           ; D6.w = plane0 lower expanded
                            	  2804: 
02:0002B11A 1004            	  2805:     move.b  D4,D0
02:0002B11C 0240000F        	  2806:     andi.w  #$000F,D0
02:0002B120 D040            	  2807:     add.w   D0,D0
02:0002B122 30320000        	  2808:     move.w  (A2,D0.W),D0           ; D0.w = plane1 lower expanded
02:0002B126 E348            	  2809:     lsl.w   #1,D0
02:0002B128 8046            	  2810:     or.w    D6,D0
02:0002B12A 33C000C00000    	  2811:     move.w  D0,(VDP_DATA).l         ; write pixels 4-7
                            	  2812: 
02:0002B130 5288            	  2813:     addq.l  #1,A0                   ; next plane-0 row
02:0002B132 5305            	  2814:     subq.b  #1,D5
02:0002B134 6CA8            	  2815:     bge.s   .ftcb_row
                            	  2816: 
                            	  2817:     ; Skip past plane-1 bytes (A0 is now at +8, plane1 starts at +8 from tile start)
02:0002B136 5088            	  2818:     addq.l  #8,A0                   ; A0 now points to next tile
                            	  2819: 
02:0002B138 0839000500FF0804	  2820:     btst    #5,(PPU_CTRL).l
02:0002B140 6712            	  2821:     beq.s   .ftcb_no_hi_sprite_upload
02:0002B142 0C411F20        	  2822:     cmpi.w  #$1F20,D1
02:0002B146 650C            	  2823:     blo.s   .ftcb_no_hi_sprite_upload
