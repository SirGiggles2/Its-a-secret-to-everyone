02:0000E6B8 02450003        	  1075:     andi.w  #$0003,D5
02:0000E6BC EB4D            	  1076:     lsl.w   #5,D5
02:0000E6BE E14D            	  1077:     lsl.w   #8,D5
02:0000E6C0 5442            	  1078:     addq.w  #2,D2
02:0000E6C2 610002D8        	  1079:     bsr     _attr_write_2x2
02:0000E6C6 5542            	  1080:     subq.w  #2,D2
                            	  1081: 
