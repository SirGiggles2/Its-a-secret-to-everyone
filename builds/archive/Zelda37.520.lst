02:00048C82 41EC0098        	  6020:     lea     ($0098,A4),A0
02:00048C86 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00048C8A 02000003        	  6022:     andi.b #$03,D0
02:00048C8E 6714            	  6023:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:00048C90 10342070        	  6024:     move.b  ($70,A4,D2.W),D0
