                            	  8921:     ; - 0:     5 rupees
                            	  8922:     ; - other: bomb
                            	  8923:     ;
02:0003C182 700F            	  8924:     moveq   #15,D0
02:0003C184 7600            	  8925:     moveq   #0,D3
02:0003C186 162C0051        	  8926:     move.b  ($0051,A4),D3
02:0003C18A 6702            	  8927:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
02:0003C18C 7000            	  8928:     moveq   #0,D0
                            	  8929:     even
