                            	  8889: _L_z04_SetUpDroppedItem_LookUpItem:
                            	  8890:     ; Look up the base offset of the row in the drop item table.
                            	  8891:     ; Add it and WorldKillCycle to look up the dropped item for
                            	  8892:     ; this object type and store it in [00].
                            	  8893:     ;
