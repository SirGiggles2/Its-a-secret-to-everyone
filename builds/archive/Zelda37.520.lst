02:00048CF8 E208            	  6093:     lsr.b  #1,D0   ; LSR A
02:00048CFA E208            	  6094:     lsr.b  #1,D0   ; LSR A
02:00048CFC E208            	  6095:     lsr.b  #1,D0   ; LSR A
02:00048CFE E208            	  6096:     lsr.b  #1,D0   ; LSR A
02:00048D00 1214            	  6097:     move.b  ($0000,A4),D1
02:00048D02 B001            	  6098:     cmp.b   D1,D0
