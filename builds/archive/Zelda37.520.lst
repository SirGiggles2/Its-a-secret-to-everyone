02:0003B9E4 41EC034F        	  7859:     lea     ($034F,A4),A0
02:0003B9E8 16302000        	  7860:     move.b  (A0,D2.W),D3
02:0003B9EC 0C030025        	  7861:     cmpi.b  #$25,D3
02:0003B9F0 6702            	  7862:     beq  _anon_z04_158
