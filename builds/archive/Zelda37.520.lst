02:00038908 661A            	  1181:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1182:     ; then Y := shoot timer - 1
                            	  1183:     ;
02:0003890A 7600            	  1184:     moveq   #0,D3
02:0003890C 41EC0451        	  1185:     lea     ($0451,A4),A0
02:00038910 16302000        	  1186:     move.b  (A0,D2.W),D3
02:00038914 5303            	  1187:     subq.b  #1,D3
                            	  1188:     ; If Y register < 0, then shoot timer is 0.
                            	  1189:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1190:     ; Else go set a non-zero speed and return.
                            	  1191:     ;
02:00038916 6A0C            	  1192:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038918 41EC0412        	  1193:     lea     ($0412,A4),A0
