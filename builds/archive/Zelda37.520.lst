02:00041802 7600            	  8548:     moveq   #0,D3
02:00041804 162C00EB        	  8549:     move.b  ($00EB,A4),D3
02:00041808 1214            	  8550:     move.b  ($00,A4),D1   ; ptr lo
02:0004180A 182C0001        	  8551:     move.b  ($01,A4),D4  ; ptr hi
02:0004180E 024100FF        	  8552:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041812 E14C            	  8553:     lsl.w   #8,D4
