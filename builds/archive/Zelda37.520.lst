02:00038F24 7020            	  2032:     moveq   #32,D0
02:00038F26 7600            	  2033:     moveq   #0,D3
02:00038F28 41EC034F        	  2034:     lea     ($034F,A4),A0
02:00038F2C 16302000        	  2035:     move.b  (A0,D2.W),D3
02:00038F30 0C030007        	  2036:     cmpi.b  #$07,D3
02:00038F34 6708            	  2037:     beq  _L_z04_UpdateOctorock_Shoot
02:00038F36 0C030009        	  2038:     cmpi.b  #$09,D3
02:00038F3A 6702            	  2039:     beq  _L_z04_UpdateOctorock_Shoot
02:00038F3C E308            	  2040:     lsl.b  #1,D0   ; ASL A
                            	  2041:     even
                            	  2042: _L_z04_UpdateOctorock_Shoot:
                            	  2043:     ; Shoot a flying rock (object type $53).
                            	  2044:     ;
02:00038F3E 7653            	  2045:     moveq   #83,D3
02:00038F40 6100F97C        	  2046:     jsr     _TryShooting
02:00038F44 4EB900049120    	  2047:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2048:     ; If facing down, then use frame image offset 2.
                            	  2049:     ;
02:00038F4A 41EC0098        	  2050:     lea     ($0098,A4),A0
02:00038F4E 10302000        	  2051:     move.b  (A0,D2.W),D0
02:00038F52 7600            	  2052:     moveq   #0,D3
02:00038F54 1600            	  2053:     move.b  D0,D3
02:00038F56 0200000C        	  2054:     andi.b #$0C,D0
02:00038F5A 670C            	  2055:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038F5C 7002            	  2056:     moveq   #2,D0
02:00038F5E 0C030008        	  2057:     cmpi.b  #$08,D3
02:00038F62 6610            	  2058:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2059:     ; Else facing up. Use frame image offset 1.
                            	  2060:     ;
