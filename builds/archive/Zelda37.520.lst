                            	  4860:     ; Decrement tile index and loop index.
                            	  4861:     ;
02:0003A358 532C000A        	  4862:     subq.b  #1,($000A,A4)
02:0003A35C 532C000B        	  4863:     subq.b  #1,($000B,A4)
02:0003A360 6A00FF7E        	  4864:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
