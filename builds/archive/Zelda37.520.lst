02:000392B8 7006            	  2607:     moveq   #6,D0
02:000392BA 7600            	  2608:     moveq   #0,D3
02:000392BC 1600            	  2609:     move.b  D0,D3
02:000392BE 610032AC        	  2610:     jsr     RotateObjectLocation
02:000392C2 41EC0084        	  2611:     lea     ($0084,A4),A0
