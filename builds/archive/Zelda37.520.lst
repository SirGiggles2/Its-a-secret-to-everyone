                            	  3679:     ;
                            	  3680:     ; If it was the first room in the list, handle it specially.
                            	  3681:     ; This room is the only one in Q1 with a flute secret. It's also
                            	  3682:     ; the only one in the list without a flute secret in Q2.
                            	  3683:     ;
                            	  3684:     ; In Q2, go summon the whirlwind. In Q1, continue to reveal
                            	  3685:     ; the secret.
                            	  3686:     ;
