                            	  4360: DrawLinkZeldaTriforces:
                            	  4361:     ; The triforce over Link goes in the room object slot $13.
                            	  4362:     ; Set its location $10 pixels above Link.
                            	  4363:     ;
02:00034E90 102C0070        	  4364:     move.b  ($0070,A4),D0
02:00034E94 19400083        	  4365:     move.b  D0,($0083,A4)
02:00034E98 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00034E9C 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00034EA0 123C0010        	  4368:     move.b  #$10,D1
02:00034EA4 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034EA8 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034EAA 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00034EAE 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
                            	  4374:     ;
02:00034EB2 7400            	  4375:     moveq   #0,D2
02:00034EB4 4EB900049120    	  4376:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00034EBA 6100C2E2        	  4377:     jsr     Anim_SetSpriteDescriptorAttributes
02:00034EBE 1940000C        	  4378:     move.b  D0,($000C,A4)
02:00034EC2 7048            	  4379:     moveq   #72,D0
02:00034EC4 19400343        	  4380:     move.b  D0,($0343,A4)
02:00034EC8 704C            	  4381:     moveq   #76,D0
02:00034ECA 19400344        	  4382:     move.b  D0,($0344,A4)
02:00034ECE 7621            	  4383:     moveq   #33,D3
02:00034ED0 6100C21E        	  4384:     jsr     Anim_WriteSpecificItemSprites
                            	  4385:     ; Draw triforce over Link.
                            	  4386:     ;
02:00034ED4 701B            	  4387:     moveq   #27,D0
02:00034ED6 7413            	  4388:     moveq   #19,D2
02:00034ED8 4EB90004704C    	  4389:     jsr     AnimateItemObject
02:00034EDE 7401            	  4390:     moveq   #1,D2
02:00034EE0 4EB900049120    	  4391:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4392:     ; Draw Zelda.
                            	  4393:     ;
02:00034EE6 1002            	  4394:     move.b  D2,D0
02:00034EE8 6100BFBE        	  4395:     jsr     DrawObjectMirrored
                            	  4396:     ; The triforce over Zelda goes in slot 2.
                            	  4397:     ; Set its location $10 pixels above her.
                            	  4398:     ;
02:00034EEC 102C0071        	  4399:     move.b  ($0071,A4),D0
02:00034EF0 19400072        	  4400:     move.b  D0,($0072,A4)
02:00034EF4 102C0085        	  4401:     move.b  ($0085,A4),D0
02:00034EF8 003C0011        	  4402:     ori     #$11,CCR  ; SEC: set C+X
02:00034EFC 123C0010        	  4403:     move.b  #$10,D1
02:00034F00 0A3C0010        	  4404:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F04 9101            	  4405:     subx.b  D1,D0   ; SBC #$10
02:00034F06 0A3C0010        	  4406:     eori    #$10,CCR  ; restore X = 6502 C
02:00034F0A 19400086        	  4407:     move.b  D0,($0086,A4)
                            	  4408:     ; Draw triforce over Zelda.
                            	  4409:     ;
02:00034F0E 7402            	  4410:     moveq   #2,D2
02:00034F10 701B            	  4411:     moveq   #27,D0
02:00034F12 4EB90004704C    	  4412:     jsr     AnimateItemObject
02:00034F18 0A3C0001        	  4413:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
