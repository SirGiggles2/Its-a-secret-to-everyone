02:0003841E 41EC042C        	   466:     lea     ($042C,A4),A0
02:00038422 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:00038426 1003            	   470:     move.b  D3,D0
02:00038428 41EC042C        	   471:     lea     ($042C,A4),A0
02:0003842C 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
