02:0003C154 122C052A        	  8899:     move.b  ($052A,A4),D1
02:0003C158 D101            	  8900:     addx.b  D1,D0   ; ADC WorldKillCycle
02:0003C15A 7600            	  8901:     moveq   #0,D3
02:0003C15C 1600            	  8902:     move.b  D0,D3
02:0003C15E 41F90003C096    	  8903:     lea     (DropItemTable).l,A0
