                            	  8495: GanonSpriteOffsetsY:
02:0003BE6A 00              	  8496:     dc.b    $00, $00, $10, $10
02:0003BE6B 00
02:0003BE6C 10
02:0003BE6D 10
                            	  8497: 
                            	  8498:     even
                            	  8499: GanonSpriteHFlips:
