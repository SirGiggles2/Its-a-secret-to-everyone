                            	  8384: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	  8385:     ; Draw the four clouds at diagonal corners.
                            	  8386:     ;
02:0003BD7E 610000B6        	  8387:     jsr     Ganon_GetCurCloudLeft
02:0003BD82 610000BE        	  8388:     jsr     Ganon_GetCurCloudTop
02:0003BD86 61A0            	  8389:     jsr     Ganon_DrawCloud
02:0003BD88 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0003BD8C 619A            	  8391:     jsr     Ganon_DrawCloud
02:0003BD8E 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
02:0003BD92 610000B4        	  8393:     jsr     Ganon_GetCurCloudBottom
02:0003BD96 6190            	  8394:     jsr     Ganon_DrawCloud
02:0003BD98 610000A2        	  8395:     jsr     Ganon_GetCurCloudRight
02:0003BD9C 618A            	  8396:     jsr     Ganon_DrawCloud
                            	  8397:     ; Draw the top and bottom clouds.
