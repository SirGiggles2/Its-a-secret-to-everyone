                            	  3424: Obj_Shove:
                            	  3425:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3426:     ; then go handle it separately.
                            	  3427:     ;
02:00047AAA 41EC00C0        	  3428:     lea     ($00C0,A4),A0
02:00047AAE 10302000        	  3429:     move.b  (A0,D2.W),D0
02:00047AB2 E308            	  3430:     lsl.b  #1,D0   ; ASL A
02:00047AB4 6448            	  3431:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3432:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3433:     ;
02:00047AB6 E208            	  3434:     lsr.b  #1,D0   ; LSR A
02:00047AB8 41EC00C0        	  3435:     lea     ($00C0,A4),A0
02:00047ABC 11802000        	  3436:     move.b  D0,(A0,D2.W)
                            	  3437:     ; If the object faces horizontally, go check which axis shove
                            	  3438:     ; direction is on.
                            	  3439:     ;
02:00047AC0 7600            	  3440:     moveq   #0,D3
02:00047AC2 41EC0098        	  3441:     lea     ($0098,A4),A0
02:00047AC6 16302000        	  3442:     move.b  (A0,D2.W),D3
02:00047ACA 0C030003        	  3443:     cmpi.b  #$03,D3
02:00047ACE 6526            	  3444:     bcs  _L_z07_Obj_Shove_FacingHorizontally
                            	  3445:     ; The object faces vertically.
                            	  3446:     ;
                            	  3447:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3448:     ;
02:00047AD0 02000003        	  3449:     andi.b #$03,D0
02:00047AD4 671E            	  3450:     beq  _L_z07_Obj_Shove_Exit
                            	  3451:     even
