02:0003B102 123C0008        	  6775:     move.b  #$08,D1
02:0003B106 D101            	  6776:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B108 19802070        	  6777:     move.b  D0,($70,A4,D2.W)
02:0003B10C 532C000F        	  6778:     subq.b  #1,($000F,A4)
