02:0003BD78 19400340        	  8465:     move.b  D0,($0340,A4)
02:0003BD7C 0A3C0001        	  8466:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BD80 4E75            	  8467:     rts
