                            	  3897: _L_z05_CheckDoorway_InDoorway:
                            	  3898:     ; In a doorway. DoorwayDir is in A.
                            	  3899:     ;
02:0003E68C 1B00            	  3900:     move.b  D0,-(A5)  ; PHA
02:0003E68E 610000DC        	  3901:     jsr     GetPlayerCoordsForDirection
02:0003E692 101D            	  3902:     move.b  (A5)+,D0  ; PLA
