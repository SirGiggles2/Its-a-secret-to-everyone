02:00039E74 10302000        	  4312:     move.b  (A0,D2.W),D0
02:00039E78 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039E7C 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039E80 B001            	  4315:     cmp.b   D1,D0
02:00039E82 6704            	  4316:     beq.s  __far_z_04_0038
02:00039E84 6000009E        	  4317:     jmp  L116EA_Exit
                            	  4318: __far_z_04_0038:
02:00039E88 41EC042C        	  4319:     lea     ($042C,A4),A0
02:00039E8C 10302000        	  4320:     move.b  (A0,D2.W),D0
02:00039E90 41EC0444        	  4321:     lea     ($0444,A4),A0
02:00039E94 12302000        	  4322:     move.b  (A0,D2.W),D1
02:00039E98 B001            	  4323:     cmp.b   D1,D0
02:00039E9A 6704            	  4324:     beq.s  __far_z_04_0039
02:00039E9C 60000086        	  4325:     jmp  L116EA_Exit
                            	  4326: __far_z_04_0039:
                            	  4327:     ; Set speed flag to 1 meaning decelerate.
