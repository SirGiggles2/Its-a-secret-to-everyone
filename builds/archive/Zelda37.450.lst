02:00047E84 123C0000        	  4021:     move.b  #$00,D1
02:00047E88 0A3C0010        	  4022:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00047E8C 9101            	  4023:     subx.b  D1,D0   ; SBC #$00
02:00047E8E 0A3C0010        	  4024:     eori    #$10,CCR  ; restore X = 6502 C
02:00047E92 19802070        	  4025:     move.b  D0,($70,A4,D2.W)
