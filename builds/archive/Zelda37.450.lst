02:00047DF0 4A02            	  3953:     cmpi.b  #$00,D2
02:00047DF2 6706            	  3954:     beq  _anon_z07_15
02:00047DF4 7010            	  3955:     moveq   #16,D0
02:00047DF6 163C00F0        	  3956:     move.b  #$F0,D3
                            	  3957: _anon_z07_15:
02:00047DFA 1940010E        	  3958:     move.b  D0,($010E,A4)
02:00047DFE 1943010F        	  3959:     move.b  D3,($010F,A4)
02:00047E02 102C000F        	  3960:     move.b  ($000F,A4),D0
02:00047E06 673C            	  3961:     beq  _L_z07_MoveObject_Exit
                            	  3962:     ; To allow a wide speed range, we keep the quarter speed.
                            	  3963:     ; Here, apply it 4 times to get the full speed.
02:00047E08 6106            	  3964:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
02:00047E0A 6104            	  3965:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
02:00047E0C 61000002        	  3966:     bsr     _L_z07_MoveObject_ApplyQSpeedToPosition
                            	  3967:     even
                            	  3968: _L_z07_MoveObject_ApplyQSpeedToPosition:
02:00047E10 102C000F        	  3969:     move.b  ($000F,A4),D0
02:00047E14 E208            	  3970:     lsr.b  #1,D0   ; LSR A
02:00047E16 654C            	  3971:     bcs  _L_z07_MoveObject_Right
02:00047E18 E208            	  3972:     lsr.b  #1,D0   ; LSR A
02:00047E1A 655E            	  3973:     bcs  _L_z07_MoveObject_Left
02:00047E1C E208            	  3974:     lsr.b  #1,D0   ; LSR A
02:00047E1E 6526            	  3975:     bcs  _L_z07_MoveObject_Down
                            	  3976:     ; Up
                            	  3977:     ;
02:00047E20 4EB900030A20    	  3978:     jsr     SubQSpeedFromPositionFraction
02:00047E26 41EC0084        	  3979:     lea     ($0084,A4),A0
02:00047E2A 10302000        	  3980:     move.b  (A0,D2.W),D0
02:00047E2E 123C0000        	  3981:     move.b  #$00,D1
02:00047E32 0A3C0010        	  3982:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00047E36 9101            	  3983:     subx.b  D1,D0   ; SBC #$00
02:00047E38 0A3C0010        	  3984:     eori    #$10,CCR  ; restore X = 6502 C
02:00047E3C 41EC0084        	  3985:     lea     ($0084,A4),A0
02:00047E40 11802000        	  3986:     move.b  D0,(A0,D2.W)
                            	  3987:     even
