02:0003B09C 19400001        	  6716:     move.b  D0,($0001,A4)
02:0003B0A0 612A            	  6717:     jsr     Gohma_SetSpriteAttributes
                            	  6718:     ; There are only two frame images for legs: left and right.
                            	  6719:     ; There are two animation frames. They are animated as follows:
                            	  6720:     ;
                            	  6721:     ; Frame 0:
                            	  6722:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  6723:     ; horizontal flipping = frame number = 0
                            	  6724:     ; 
                            	  6725:     ; Frame 1:
                            	  6726:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  6727:     ; horizontal flipping = frame number = 1
                            	  6728:     ;
02:0003B0A2 4EB90004903E    	  6729:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B0A8 1003            	  6730:     move.b  D3,D0
02:0003B0AA 023C00EE        	  6731:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0AE 41EC03E4        	  6732:     lea     ($03E4,A4),A0
02:0003B0B2 12302000        	  6733:     move.b  (A0,D2.W),D1
02:0003B0B6 D101            	  6734:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0B8 02000001        	  6735:     andi.b #$01,D0
02:0003B0BC 023C00EE        	  6736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0C0 123C0004        	  6737:     move.b  #$04,D1
02:0003B0C4 D101            	  6738:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B0C6 4EF900030DF8    	  6739:     jmp     DrawObjectNotMirrored
