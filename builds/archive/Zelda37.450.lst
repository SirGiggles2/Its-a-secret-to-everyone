02:0003AF4A 41F90003AF16    	  6551:     lea     (GleeokSegmentYs).l,A0
02:0003AF50 10302000        	  6552:     move.b  (A0,D2.W),D0
02:0003AF54 41EC0445        	  6553:     lea     ($0445,A4),A0
02:0003AF58 11802000        	  6554:     move.b  D0,(A0,D2.W)
02:0003AF5C 41EC045F        	  6555:     lea     ($045F,A4),A0
02:0003AF60 11802000        	  6556:     move.b  D0,(A0,D2.W)
02:0003AF64 41EC0479        	  6557:     lea     ($0479,A4),A0
02:0003AF68 11802000        	  6558:     move.b  D0,(A0,D2.W)
02:0003AF6C 41EC03BD        	  6559:     lea     ($03BD,A4),A0
02:0003AF70 11802000        	  6560:     move.b  D0,(A0,D2.W)
