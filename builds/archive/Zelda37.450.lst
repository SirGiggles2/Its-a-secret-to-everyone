                            	  2518: PondFairy_MoveHearts:
                            	  2519:     ; Loop over each heart from object slot 2 to 9.
                            	  2520:     ;
                            	  2521:     ; Even though they are not standalone objects, their info
                            	  2522:     ; is stored in those object slots.
                            	  2523:     ;
02:00039170 7402            	  2524:     moveq   #2,D2
                            	  2525:     even
                            	  2526: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  2527:     ; If the current heart's state <> 0, then go move it.
                            	  2528:     ; Else we have to wait for it to come out at the right time.
                            	  2529:     ;
02:00039172 41EC00AC        	  2530:     lea     ($00AC,A4),A0
02:00039176 10302000        	  2531:     move.b  (A0,D2.W),D0
02:0003917A 667C            	  2532:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  2533:     ; The current heart's state = 0.
                            	  2534:     ;
                            	  2535:     ; If object slot = 2, then go make it appear. This is the first
                            	  2536:     ; heart to show up.
                            	  2537:     ;
02:0003917C 0C020002        	  2538:     cmpi.b  #$02,D2
02:00039180 6732            	  2539:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  2540:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  2541:     ; go start over.
                            	  2542:     ;
                            	  2543:     ; TODO:
                            	  2544:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  2545:     ;
02:00039182 102C00AE        	  2546:     move.b  ($00AE,A4),D0
02:00039186 67EA            	  2547:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  2548:     ; Look up the starting angle of this heart with the index
                            	  2549:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  2550:     ; then loop again.
                            	  2551:     ;
02:00039188 1002            	  2552:     move.b  D2,D0
02:0003918A 003C0011        	  2553:     ori     #$11,CCR  ; SEC: set C+X
02:0003918E 123C0003        	  2554:     move.b  #$03,D1
02:00039192 0A3C0010        	  2555:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039196 9101            	  2556:     subx.b  D1,D0   ; SBC #$03
02:00039198 0A3C0010        	  2557:     eori    #$10,CCR  ; restore X = 6502 C
02:0003919C 7600            	  2558:     moveq   #0,D3
02:0003919E 1600            	  2559:     move.b  D0,D3
02:000391A0 102C0396        	  2560:     move.b  ($0396,A4),D0
02:000391A4 41F900039168    	  2561:     lea     (PondHeartStartAngles).l,A0
02:000391AA 12303000        	  2562:     move.b  (A0,D3.W),D1
02:000391AE B001            	  2563:     cmp.b   D1,D0
02:000391B0 66000086        	  2564:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  2565:     even
                            	  2566: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  2567:     ; Set up this heart. Set its state to 1.
                            	  2568:     ;
02:000391B4 41EC00AC        	  2569:     lea     ($00AC,A4),A0
02:000391B8 52302000        	  2570:     addq.b  #1,(A0,D2.W)
                            	  2571:     ; TODO: ?
                            	  2572:     ;
02:000391BC 103C0080        	  2573:     move.b  #$80,D0
02:000391C0 41EC0098        	  2574:     lea     ($0098,A4),A0
02:000391C4 11802000        	  2575:     move.b  D0,(A0,D2.W)
                            	  2576:     ; Starting angle $18 (N).
                            	  2577:     ;
02:000391C8 7018            	  2578:     moveq   #24,D0
02:000391CA 41EC0394        	  2579:     lea     ($0394,A4),A0
02:000391CE 11802000        	  2580:     move.b  D0,(A0,D2.W)
                            	  2581:     ; This heart is right above the fairy. Set its X the same as the fairy's.
