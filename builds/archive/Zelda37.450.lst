                            	  2362:     ;
02:0004725E 0C000046        	  2363:     cmpi.b  #$46,D0
02:00047262 6530            	  2364:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047264 0C0000F3        	  2365:     cmpi.b  #$F3,D0
