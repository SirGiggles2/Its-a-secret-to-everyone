                            	  4788:     ;
02:00048330 7622            	  4789:     moveq   #34,D3
02:00048332 0C02000D        	  4790:     cmpi.b  #$0D,D2
02:00048336 6410            	  4791:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:00048338 41EC034F        	  4792:     lea     ($034F,A4),A0
02:0004833C 10302000        	  4793:     move.b  (A0,D2.W),D0
02:00048340 0C000057        	  4794:     cmpi.b  #$57,D0
02:00048344 6710            	  4795:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
