02:00048770 41EC03BC        	  5431:     lea     ($03BC,A4),A0
02:00048774 11802000        	  5432:     move.b  D0,(A0,D2.W)
                            	  5433:     ; If facing left and X < 2, then go change state to $40. The
                            	  5434:     ; boomerang is too close to the left edge of the screen.
                            	  5435:     ; Another move might make it wrap around.
                            	  5436:     ;
02:00048778 41EC0098        	  5437:     lea     ($0098,A4),A0
02:0004877C 10302000        	  5438:     move.b  (A0,D2.W),D0
02:00048780 1940000F        	  5439:     move.b  D0,($000F,A4)
02:00048784 02000002        	  5440:     andi.b #$02,D0
