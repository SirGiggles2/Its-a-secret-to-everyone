                            	  6563:     ; Set HP of each neck to $A0.
                            	  6564:     ;
                            	  6565:     ; Because there's only one HP value for each neck,
                            	  6566:     ; it's stored right in the object slot -- unlike coordinates.
                            	  6567:     ;
                            	  6568:     ; Also, note that even though these aren't independent objects
                            	  6569:     ; in the object slots -- because object type = 0 -- the values in
