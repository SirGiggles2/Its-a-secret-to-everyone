                            	  4721:     ; Make the fireballs spread out.
                            	  4722:     ;
                            	  4723:     ; For each object slot from $B to 1:
                            	  4724:     ;
02:0003A1B4 740B            	  4725:     moveq   #11,D2
                            	  4726:     even
                            	  4727: _L_z04_Aquamentus_Shoot_LoopObject:
