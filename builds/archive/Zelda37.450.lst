02:0004121C 162C0010        	  7814:     move.b  ($0010,A4),D3
02:00041220 6700008C        	  7815:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7816:     ; In UW. There are two input directions, and they're both walkable.
                            	  7817:     ;
                            	  7818:     ; Normally, turn to the direction that's perpendicular to object
                            	  7819:     ; direction. But keep going straight after that, while diagonal
                            	  7820:     ; input is held.
                            	  7821:     ;
                            	  7822:     ; Handle special cases for doors.
                            	  7823:     ;
                            	  7824:     ;
                            	  7825:     ; 1. Link at horizontal doors.
                            	  7826:     ;
                            	  7827:     ; If Link's X = $20 or $D0 then
                            	  7828:     ;   If Link's Y = $85 and facing down then
                            	  7829:     ;     Go set object direction and input direction to object
                            	  7830:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7831:     ;     Link_GoStraightWhenDiagInput.
                            	  7832:     ;   Else
                            	  7833:     ;     Go turn to the perpendicular direction
                            	  7834:     ;
02:00041224 7600            	  7835:     moveq   #0,D3
02:00041226 162C0070        	  7836:     move.b  ($0070,A4),D3
02:0004122A 0C030020        	  7837:     cmpi.b  #$20,D3
02:0004122E 6706            	  7838:     beq  _anon_z05_175
02:00041230 0C0300D0        	  7839:     cmpi.b  #$D0,D3
02:00041234 661C            	  7840:     bne  _anon_z05_176
