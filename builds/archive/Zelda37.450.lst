                            	  7030:     ; Metastate = $14
                            	  7031:     ;
                            	  7032:     ; Copy the object type, so that it can be used in setting up
                            	  7033:     ; a dropped item.
                            	  7034:     ;
02:000493AA 41EC034F        	  7035:     lea     ($034F,A4),A0
02:000493AE 10302000        	  7036:     move.b  (A0,D2.W),D0
