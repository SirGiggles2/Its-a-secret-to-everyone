02:0004887E 1600            	  5590:     move.b  D0,D3
02:00048880 41F900048536    	  5591:     lea     (BoomerangQSpeedFracsX).l,A0
02:00048886 10303000        	  5592:     move.b  (A0,D3.W),D0
02:0004888A 4EB900030A40    	  5593:     jsr     SetBoomerangSpeed
02:00048890 102C000B        	  5594:     move.b  ($000B,A4),D0
02:00048894 1940000F        	  5595:     move.b  D0,($000F,A4)
02:00048898 41EC0098        	  5596:     lea     ($0098,A4),A0
02:0004889C 11802000        	  5597:     move.b  D0,(A0,D2.W)
02:000488A0 6100F548        	  5598:     jsr     MoveObject
                            	  5599:     even
                            	  5600: AnimateBoomerangAndCheckCollision:
                            	  5601:     ; Decrement animation counter; and when it reaches 0:
                            	  5602:     ; 1. arm it again for 2 frames
                            	  5603:     ; 2. advance the minor state within a cycle of 8
                            	  5604:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5605:     ;
02:000488A4 41EC03D0        	  5606:     lea     ($03D0,A4),A0
