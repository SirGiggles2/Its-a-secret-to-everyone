                            	  8713: _anon_z04_165:
02:0003BF44 1003            	  8714:     move.b  D3,D0
02:0003BF46 1B00            	  8715:     move.b  D0,-(A5)  ; PHA
                            	  8716:     ; Get the length, to append to the dynamic transfer buf.
                            	  8717:     ;
02:0003BF48 7400            	  8718:     moveq   #0,D2
02:0003BF4A 142C0301        	  8719:     move.b  ($0301,A4),D2
                            	  8720:     ; Copy the 8 bytes of the palette row transfer record template.
                            	  8721:     ;
02:0003BF4E 7600            	  8722:     moveq   #0,D3
                            	  8723:     even
                            	  8724: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003BF50 41F90003BF28    	  8725:     lea     (GanonColorTransferRecord).l,A0
