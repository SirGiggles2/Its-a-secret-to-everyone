02:00033892 19400084        	  2316:     move.b  D0,($0084,A4)
02:00033896 19400200        	  2317:     move.b  D0,($0200,A4)
02:0003389A 102C0012        	  2318:     move.b  ($0012,A4),D0
02:0003389E 0C00000F        	  2319:     cmpi.b  #$0F,D0
                            	  2320:     ; There's more work in mode $E.
                            	  2321:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2322:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:000338A2 6736            	  2323:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
