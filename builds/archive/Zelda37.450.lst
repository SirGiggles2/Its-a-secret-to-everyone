02:0003A806 7600            	  5562:     moveq   #0,D3
02:0003A808 41EC03E4        	  5563:     lea     ($03E4,A4),A0
02:0003A80C 16302000        	  5564:     move.b  (A0,D2.W),D3
02:0003A810 5203            	  5565:     addq.b  #1,D3
02:0003A812 1003            	  5566:     move.b  D3,D0
