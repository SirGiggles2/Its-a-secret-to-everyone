02:0003BF5A 41EC0302        	  8727:     lea     ($0302,A4),A0
02:0003BF5E 11802000        	  8728:     move.b  D0,(A0,D2.W)
02:0003BF62 5202            	  8729:     addq.b  #1,D2
02:0003BF64 5203            	  8730:     addq.b  #1,D3
02:0003BF66 0C030008        	  8731:     cmpi.b  #$08,D3
02:0003BF6A 66E4            	  8732:     bne  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes
02:0003BF6C 19420301        	  8733:     move.b  D2,($0301,A4)
02:0003BF70 101D            	  8734:     move.b  (A5)+,D0  ; PLA
02:0003BF72 7600            	  8735:     moveq   #0,D3
02:0003BF74 1600            	  8736:     move.b  D0,D3
                            	  8737:     ; Overwrite the last 3 colors in the record, with the ones
                            	  8738:     ; ending at the index passed in.
                            	  8739:     ;
02:0003BF76 7402            	  8740:     moveq   #2,D2
                            	  8741:     even
