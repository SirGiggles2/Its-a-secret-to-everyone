                            	  2148: SecretArmosRoomIds:
02:00038F38 24              	  2149:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:00038F39 0B
02:00038F3A 1C
02:00038F3B 22
02:00038F3C 34
02:00038F3D 3D
02:00038F3E 4E
                            	  2150: 
                            	  2151:     even
                            	  2152: SecretArmosXs:
02:00038F40 E0              	  2153:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:00038F41 B0
02:00038F42 B0
02:00038F43 30
02:00038F44 40
02:00038F45 90
02:00038F46 A0
                            	  2154: 
