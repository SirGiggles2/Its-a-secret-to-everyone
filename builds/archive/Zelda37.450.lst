02:00038E3A 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038E3E 41F900038C30    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038E44 10303000        	  2007:     move.b  (A0,D3.W),D0
