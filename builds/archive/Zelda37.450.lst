                            	  2078: ; Params:
                            	  2079: ; A: frame
                            	  2080: ; X: object index/cycle sprite index
                            	  2081: ; Y: object type
                            	  2082: ; [00]: object X
                            	  2083: ; [01]: object Y
                            	  2084: ; [0C]: mirrored
                            	  2085: ; [0F]: flip horizontally
