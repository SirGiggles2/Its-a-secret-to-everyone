02:0003A1CA 651E            	  4738:     bcs  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  4739:     ; Add the displacement for this fireball to its Y coordinate.
                            	  4740:     ;
02:0003A1CC 41EC0084        	  4741:     lea     ($0084,A4),A0
02:0003A1D0 10302000        	  4742:     move.b  (A0,D2.W),D0
02:0003A1D4 023C00EE        	  4743:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A1D8 41EC0478        	  4744:     lea     ($0478,A4),A0
02:0003A1DC 12302000        	  4745:     move.b  (A0,D2.W),D1
02:0003A1E0 D101            	  4746:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003A1E2 41EC0084        	  4747:     lea     ($0084,A4),A0
02:0003A1E6 11802000        	  4748:     move.b  D0,(A0,D2.W)
                            	  4749:     even
                            	  4750: _L_z04_Aquamentus_Shoot_NextLoopObject:
