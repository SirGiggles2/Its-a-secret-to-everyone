                            	  4939:     even
                            	  4940: _L_z07_SpreadShot_NextCorner:
                            	  4941:     ; Prepare to process the next corner.
                            	  4942:     ;
                            	  4943:     ; First, restore X offset [02] and Y offset [03].
                            	  4944:     ;
02:0004843A 101D            	  4945:     move.b  (A5)+,D0  ; PLA
02:0004843C 19400003        	  4946:     move.b  D0,($0003,A4)
02:00048440 101D            	  4947:     move.b  (A5)+,D0  ; PLA
02:00048442 19400002        	  4948:     move.b  D0,($0002,A4)
                            	  4949:     ; Take turns negating X offset or Y offset for the next round.
                            	  4950:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4951:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4952:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4953:     ; - Fourth turn: doesn't matter
                            	  4954:     ;
                            	  4955:     ;
                            	  4956:     ; Get the loop index.
02:00048446 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:00048448 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:0004844A 7600            	  4959:     moveq   #0,D3
02:0004844C 1600            	  4960:     move.b  D0,D3
02:0004844E 0C030001        	  4961:     cmpi.b  #$01,D3
02:00048452 6602            	  4962:     bne  _anon_z07_25
02:00048454 7603            	  4963:     moveq   #3,D3
                            	  4964: _anon_z07_25:
02:00048456 10343000        	  4965:     move.b  ($00,A4,D3.W),D0
02:0004845A 4600            	  4966:     eori.b #$FF,D0
02:0004845C 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048460 123C0001        	  4968:     move.b  #$01,D1
02:00048464 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048466 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
02:0004846A 101D            	  4973:     move.b  (A5)+,D0  ; PLA
02:0004846C 7600            	  4974:     moveq   #0,D3
02:0004846E 1600            	  4975:     move.b  D0,D3
02:00048470 5303            	  4976:     subq.b  #1,D3
02:00048472 6A00FF18        	  4977:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  4978:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4979:     ;
                            	  4980:     ; Decrease the base negative offset to get farther away from
                            	  4981:     ; the center point.
                            	  4982:     ;
02:00048476 41EC0098        	  4983:     lea     ($0098,A4),A0
02:0004847A 53302000        	  4984:     subq.b  #1,(A0,D2.W)
                            	  4985:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4986:     ;
                            	  4987:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  4988:     ;
02:0004847E 41EC0098        	  4989:     lea     ($0098,A4),A0
02:00048482 10302000        	  4990:     move.b  (A0,D2.W),D0
02:00048486 0C0000E8        	  4991:     cmpi.b  #$E8,D0
02:0004848A 6702            	  4992:     beq.s  __far_z_07_0071
02:0004848C 6004            	  4993:     jmp  L1F49F_Exit
