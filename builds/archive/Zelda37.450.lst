                            	  4276: CheckBoundary:
                            	  4277:     ; If object crossed a boundary, then go check object
                            	  4278:     ; attribute $10 and another direction.
                            	  4279:     ; Else set object direction to moving direction [0F] and return.
                            	  4280:     ;
