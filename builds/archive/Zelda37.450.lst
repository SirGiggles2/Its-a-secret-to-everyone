02:0003E6D6 B001            	  3939:     cmp.b   D1,D0
02:0003E6D8 6620            	  3940:     bne  _anon_z05_96
02:0003E6DA 102C0001        	  3941:     move.b  ($0001,A4),D0
02:0003E6DE 41F90003E636    	  3942:     lea     (DoorwayBoundsMinUnder).l,A0
02:0003E6E4 12303000        	  3943:     move.b  (A0,D3.W),D1
02:0003E6E8 B001            	  3944:     cmp.b   D1,D0
02:0003E6EA 650E            	  3945:     bcs  _anon_z05_96
02:0003E6EC 41F90003E63A    	  3946:     lea     (DoorwayBoundsMaxUnder).l,A0
02:0003E6F2 12303000        	  3947:     move.b  (A0,D3.W),D1
02:0003E6F6 B001            	  3948:     cmp.b   D1,D0
02:0003E6F8 6506            	  3949:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3950: _anon_z05_96:
