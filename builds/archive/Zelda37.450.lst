                            	  9384:     ; if observed player Y <> object Y then
                            	  9385:     ;   if observed player Y < object Y then
                            	  9386:     ;     Y := Y << 1   -- makes it 8 (up)
                            	  9387:     ;   [00] := [00] | Y
                            	  9388:     ;
