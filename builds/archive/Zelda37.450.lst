                            	  4600: UpdateMode13WinGame_Sub3:
                            	  4601:     ; After scrolling 8 pixels, draw another tile row.
                            	  4602:     ;
02:00035000 102C050B        	  4603:     move.b  ($050B,A4),D0
02:00035004 0C000008        	  4604:     cmpi.b  #$08,D0
02:00035008 6B1A            	  4605:     bmi  _anon_z02_37
02:0003500A 102C050B        	  4606:     move.b  ($050B,A4),D0
02:0003500E 123C0008        	  4607:     move.b  #$08,D1
02:00035012 0A3C0010        	  4608:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035016 9101            	  4609:     subx.b  D1,D0   ; SBC #$08
02:00035018 0A3C0010        	  4610:     eori    #$10,CCR  ; restore X = 6502 C
02:0003501C 1940050B        	  4611:     move.b  D0,($050B,A4)
02:00035020 61000282        	  4612:     jsr     DrawCredits
                            	  4613: _anon_z02_37:
                            	  4614:     ; Add $80 to the scroll speed fraction.
                            	  4615:     ;
02:00035024 102C0058        	  4616:     move.b  ($0058,A4),D0
02:00035028 023C00EE        	  4617:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003502C 123C0080        	  4618:     move.b  #$80,D1
02:00035030 D101            	  4619:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00035032 19400058        	  4620:     move.b  D0,($0058,A4)
                            	  4621:     ; Carry over to the tile offset and current V-scroll.
                            	  4622:     ;
02:00035036 6404            	  4623:     bcc  _anon_z02_38
02:00035038 522C050B        	  4624:     addq.b  #1,($050B,A4)
                            	  4625: _anon_z02_38:
02:0003503C 102C00FC        	  4626:     move.b  ($00FC,A4),D0
02:00035040 123C0000        	  4627:     move.b  #$00,D1
02:00035044 D101            	  4628:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035046 194000FC        	  4629:     move.b  D0,($00FC,A4)
                            	  4630:     ; If we've reached the bottom of a nametable, then
                            	  4631:     ; roll over current V-scroll to 0, and increase number of
                            	  4632:     ; screens scrolled.
                            	  4633:     ;
02:0003504A 0C0000F0        	  4634:     cmpi.b  #$F0,D0
02:0003504E 7000            	  4635:     moveq   #0,D0
02:00035050 6508            	  4636:     bcs  _anon_z02_39
02:00035052 194000FC        	  4637:     move.b  D0,($00FC,A4)
02:00035056 522C00E2        	  4638:     addq.b  #1,($00E2,A4)
                            	  4639: _anon_z02_39:
                            	  4640:     ; Roll the carry from the comparison above into bit 0.
                            	  4641:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  4642:     ;
02:0003505A E310            	  4643:     roxl.b  #1,D0   ; ROL A
02:0003505C 1940005C        	  4644:     move.b  D0,($005C,A4)
                            	  4645:     ; Put the quest number in Y register.
                            	  4646:     ;
02:00035060 7600            	  4647:     moveq   #0,D3
02:00035062 7400            	  4648:     moveq   #0,D2
02:00035064 142C0016        	  4649:     move.b  ($0016,A4),D2
02:00035068 41EC062D        	  4650:     lea     ($062D,A4),A0
02:0003506C 10302000        	  4651:     move.b  (A0,D2.W),D0
02:00035070 6702            	  4652:     beq  _anon_z02_40
02:00035072 5203            	  4653:     addq.b  #1,D3
                            	  4654: _anon_z02_40:
                            	  4655:     ; If we're not showing the last screen, then return.
                            	  4656:     ;
02:00035074 102C00E2        	  4657:     move.b  ($00E2,A4),D0
02:00035078 41F900034FFC    	  4658:     lea     (CreditsLastScreenList).l,A0
02:0003507E 12303000        	  4659:     move.b  (A0,D3.W),D1
02:00035082 B001            	  4660:     cmp.b   D1,D0
02:00035084 651C            	  4661:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4662:     ; If we haven't scrolled the last amount in the last screen,
                            	  4663:     ; then return.
                            	  4664:     ;
02:00035086 102C00FC        	  4665:     move.b  ($00FC,A4),D0
02:0003508A 41F900034FFE    	  4666:     lea     (CreditsLastVscrollList).l,A0
02:00035090 12303000        	  4667:     move.b  (A0,D3.W),D1
02:00035094 B001            	  4668:     cmp.b   D1,D0
02:00035096 650A            	  4669:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4670:     ; But if we have, then go to the next submode, and set a timer
                            	  4671:     ; to wait $40 frames in the next submode.
