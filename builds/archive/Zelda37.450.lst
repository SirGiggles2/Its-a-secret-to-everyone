02:0003848C 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:00038490 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:00038494 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:00038498 7074            	   629:     moveq   #116,D0
