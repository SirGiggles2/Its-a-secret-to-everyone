02:0003A8EC 41EC0405        	  5662:     lea     ($0405,A4),A0
02:0003A8F0 10302000        	  5663:     move.b  (A0,D2.W),D0
02:0003A8F4 678A            	  5664:     beq  _L_z04_UpdateLikeLike_Exit
                            	  5665:     ; But once it has died, then let Link move again.
                            	  5666:     ;
02:0003A8F6 7000            	  5667:     moveq   #0,D0
02:0003A8F8 19400512        	  5668:     move.b  D0,($0512,A4)
