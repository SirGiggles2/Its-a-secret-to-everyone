02:00038296 7601            	   339:     moveq   #1,D3
02:00038298 102C0061        	   340:     move.b  ($0061,A4),D0
02:0003829C 12342070        	   341:     move.b  ($70,A4,D2.W),D1
02:000382A0 B001            	   342:     cmp.b   D1,D0
02:000382A2 6402            	   343:     bcc  _L_z04_Exit_SetDirTowardTarget
