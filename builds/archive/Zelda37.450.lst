02:0003E6AC 41F90003E632    	  3915:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E6B2 12303000        	  3916:     move.b  (A0,D3.W),D1
02:0003E6B6 B001            	  3917:     cmp.b   D1,D0
02:0003E6B8 640E            	  3918:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0003E6BA 102C0053        	  3919:     move.b  ($0053,A4),D0
02:0003E6BE 122C0098        	  3920:     move.b  ($0098,A4),D1
02:0003E6C2 B001            	  3921:     cmp.b   D1,D0
02:0003E6C4 6700FF7E        	  3922:     beq  _L_z05_CheckDoorway_SearchOverflowBounds
                            	  3923:     even
                            	  3924: _L_z05_CheckDoorway_SearchUnderflowDoorway:
                            	  3925:     ; The player might be in the original doorway facing backwards,
