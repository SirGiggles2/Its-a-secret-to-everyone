02:0004882E 41EC042C        	  5555:     lea     ($042C,A4),A0
02:00048832 16302000        	  5556:     move.b  (A0,D2.W),D3
02:00048836 19803028        	  5557:     move.b  D0,($28,A4,D3.W)
