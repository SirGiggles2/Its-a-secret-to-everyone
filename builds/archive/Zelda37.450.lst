                            	  7149:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7150:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7151:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7152:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7153:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7154:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7155:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7156:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7157:     ; corrupting them and causing a deterministic address-error
                            	  7158:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7159:     ; identified by Codex static review.)
                            	  7160: _L_z07_P47_pre_check:
02:000494AE 102C0525        	  7161:     move.b  ($0525,A4),D0
02:000494B2 020000F0        	  7162:     andi.b  #$F0,D0
02:000494B6 0C000040        	  7163:     cmpi.b  #$40,D0
02:000494BA 6506            	  7164:     blo     _L_z07_P47_pre_snap
02:000494BC 0C0000E0        	  7165:     cmpi.b  #$E0,D0
02:000494C0 6506            	  7166:     blo     _L_z07_P47_pre_ok
                            	  7167: _L_z07_P47_pre_snap:
02:000494C2 197C00480525    	  7168:     move.b  #$48,($0525,A4)
                            	  7169: _L_z07_P47_pre_ok:
02:000494C8 7005            	  7170:     moveq   #5,D0
02:000494CA 610004F4        	  7171:     jsr     SwitchBank
02:000494CE 4EB90003E406    	  7172:     jsr     FindNextEdgeSpawnCell
                            	  7173:     ; Post-walk 1: bottom-edge snap.
02:000494D4 102C0525        	  7174:     move.b  ($0525,A4),D0
02:000494D8 020000F0        	  7175:     andi.b  #$F0,D0
02:000494DC 0C0000E0        	  7176:     cmpi.b  #$E0,D0
02:000494E0 660C            	  7177:     bne     _L_z07_P47_post1_ok
02:000494E2 197C00480525    	  7178:     move.b  #$48,($0525,A4)
02:000494E8 4EB90003E406    	  7179:     jsr     FindNextEdgeSpawnCell
                            	  7180: _L_z07_P47_post1_ok:
                            	  7181:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7182:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:000494EE 7600            	  7183:     moveq   #0,D3
02:000494F0 162C0525        	  7184:     move.b  ($0525,A4),D3
02:000494F4 0243000F        	  7185:     andi.w  #$000F,D3
02:000494F8 C6FC002C        	  7186:     mulu.w  #44,D3
02:000494FC 203C00FF6530    	  7187:     move.l  #$FF6530,D0
02:00049502 D083            	  7188:     add.l   D3,D0
02:00049504 7600            	  7189:     moveq   #0,D3
02:00049506 162C0525        	  7190:     move.b  ($0525,A4),D3
02:0004950A E84B            	  7191:     lsr.w   #4,D3
02:0004950C 5943            	  7192:     subi.w  #4,D3
02:0004950E E34B            	  7193:     lsl.w   #1,D3
02:00049510 D083            	  7194:     add.l   D3,D0
02:00049512 2040            	  7195:     movea.l D0,A0
02:00049514 1010            	  7196:     move.b  (A0),D0
02:00049516 0C000084        	  7197:     cmpi.b  #$84,D0
02:0004951A 6544            	  7198:     blo     _L_z07_P47_post2_ok
                            	  7199:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7200:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7201:     ; writes to the $05xx region.
02:0004951C 7800            	  7202:     moveq   #0,D4
                            	  7203: _L_z07_P47_fb_loop:
02:0004951E 41FAE582        	  7204:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049522 12304000        	  7205:     move.b  (A0,D4.W),D1
02:00049526 19410525        	  7206:     move.b  D1,($0525,A4)
                            	  7207:     ; Validate fallback cell walkable.
02:0004952A 7600            	  7208:     moveq   #0,D3
02:0004952C 1601            	  7209:     move.b  D1,D3
02:0004952E 0243000F        	  7210:     andi.w  #$000F,D3
02:00049532 C6FC002C        	  7211:     mulu.w  #44,D3
02:00049536 203C00FF6530    	  7212:     move.l  #$FF6530,D0
02:0004953C D083            	  7213:     add.l   D3,D0
02:0004953E 7600            	  7214:     moveq   #0,D3
02:00049540 1601            	  7215:     move.b  D1,D3
02:00049542 E84B            	  7216:     lsr.w   #4,D3
02:00049544 5943            	  7217:     subi.w  #4,D3
02:00049546 E34B            	  7218:     lsl.w   #1,D3
02:00049548 D083            	  7219:     add.l   D3,D0
02:0004954A 2040            	  7220:     movea.l D0,A0
02:0004954C 0C100084        	  7221:     cmpi.b  #$84,(A0)
02:00049550 650E            	  7222:     blo     _L_z07_P47_post2_ok
02:00049552 5204            	  7223:     addq.b  #1,D4
02:00049554 0C040008        	  7224:     cmpi.b  #8,D4
02:00049558 65C4            	  7225:     blo     _L_z07_P47_fb_loop
                            	  7226:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7227:     ; rather than looping).
02:0004955A 197C00480525    	  7228:     move.b  #$48,($0525,A4)
                            	  7229: _L_z07_P47_post2_ok:
                            	  7230:     ; Extract and set the monster's location.
                            	  7231:     ;
02:00049560 102C0525        	  7232:     move.b  ($0525,A4),D0
                            	  7233:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7234:     ;
02:00049564 1B00            	  7235:     move.b  D0,-(A5)  ; PHA
02:00049566 E308            	  7236:     lsl.b  #1,D0   ; ASL A
02:00049568 E308            	  7237:     lsl.b  #1,D0   ; ASL A
02:0004956A E308            	  7238:     lsl.b  #1,D0   ; ASL A
02:0004956C E308            	  7239:     lsl.b  #1,D0   ; ASL A
02:0004956E 19802070        	  7240:     move.b  D0,($70,A4,D2.W)
                            	  7241:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7242:     ;
02:00049572 101D            	  7243:     move.b  (A5)+,D0  ; PLA
02:00049574 020000F0        	  7244:     andi.b #$F0,D0
02:00049578 003C0011        	  7245:     ori     #$11,CCR  ; SEC: set C+X
02:0004957C 123C0003        	  7246:     move.b  #$03,D1
02:00049580 0A3C0010        	  7247:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049584 9101            	  7248:     subx.b  D1,D0   ; SBC #$03
02:00049586 0A3C0010        	  7249:     eori    #$10,CCR  ; restore X = 6502 C
02:0004958A 41EC0084        	  7250:     lea     ($0084,A4),A0
02:0004958E 11802000        	  7251:     move.b  D0,(A0,D2.W)
                            	  7252:     ; Set the monsters-from-edges long timer to a random value
                            	  7253:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7254:     ;
02:00049592 10342019        	  7255:     move.b  ($19,A4,D2.W),D0
02:00049596 02000003        	  7256:     andi.b #$03,D0
02:0004959A 023C00EE        	  7257:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004959E 123C0002        	  7258:     move.b  #$02,D1
02:000495A2 D101            	  7259:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000495A4 1940004B        	  7260:     move.b  D0,($004B,A4)
                            	  7261:     ; If the distance to Link is too close to Link, then
                            	  7262:     ; go flag the monster uninitialized again, so we can
                            	  7263:     ; try to spawn it again next time.
                            	  7264:     ;
02:000495A8 7005            	  7265:     moveq   #5,D0
02:000495AA 61000414        	  7266:     jsr     SwitchBank
02:000495AE 4EB90003DA1A    	  7267:     jsr     IsDistanceSafeToSpawn
02:000495B4 6500FEB4        	  7268:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7269:     ; OK to spawn.
                            	  7270:     ; In this situation, monsters don't spawn from a cloud.
                            	  7271:     ;
02:000495B8 7000            	  7272:     moveq   #0,D0
02:000495BA 41EC0405        	  7273:     lea     ($0405,A4),A0
02:000495BE 11802000        	  7274:     move.b  D0,(A0,D2.W)
                            	  7275:     even
