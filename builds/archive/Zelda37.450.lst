02:0003E4E0 00040F2E        	  3665:     dc.l    InitModeSubroom_Sub0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003E4E4 00040F8E        	  3666:     dc.l    InitModeB_Sub1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003E4E8 00040F5A        	  3667:     dc.l    InitModeSubroom_AdvanceSubmode   ; jump table entry (32-bit for _m68k_tablejump)
