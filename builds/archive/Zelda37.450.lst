                            	  6679: ;
                            	  6680: ; Draw the eye with the frame image passed in.
                            	  6681: ;
                            	  6682:     even
                            	  6683: Gohma_AnimateAndDraw:
02:0003B05E 1B00            	  6684:     move.b  D0,-(A5)  ; PHA
