                            	  6698: ; Params:
                            	  6699: ; Y: side: 0 for left, 1 for right
                            	  6700: ;
                            	  6701: ; Add the horizontal offset for the current side to Gohma's X to
                            	  6702: ; store the sprite's X in [00].
                            	  6703: ;
                            	  6704:     even
                            	  6705: Gohma_DrawLegsOneSide:
02:0003B07E 10342070        	  6706:     move.b  ($70,A4,D2.W),D0
02:0003B082 023C00EE        	  6707:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B086 41F90003B05C    	  6708:     lea     (GohmaLegOffsetsX).l,A0
