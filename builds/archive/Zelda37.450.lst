                            	  7020: UpdateMetaObjectEnd:
                            	  7021:     ; Metastate = 4 or $14.
                            	  7022:     ;
                            	  7023:     ; If it's 4, go reset the metastate. The object is ready to update
                            	  7024:     ; on its own.
                            	  7025:     ;
