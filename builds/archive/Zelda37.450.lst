02:0003A85A 19400028        	  5595:     move.b  D0,($0028,A4)
02:0003A85E 19400405        	  5596:     move.b  D0,($0405,A4)
02:0003A862 194000C0        	  5597:     move.b  D0,($00C0,A4)
02:0003A866 194000D3        	  5598:     move.b  D0,($00D3,A4)
                            	  5599:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  5600:     ;
02:0003A86A 41EC03E4        	  5601:     lea     ($03E4,A4),A0
02:0003A86E 11802000        	  5602:     move.b  D0,(A0,D2.W)
