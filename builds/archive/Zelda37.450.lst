02:0003AF2E 41EC0452        	  6542:     lea     ($0452,A4),A0
02:0003AF32 11802000        	  6543:     move.b  D0,(A0,D2.W)
02:0003AF36 41EC046C        	  6544:     lea     ($046C,A4),A0
02:0003AF3A 11802000        	  6545:     move.b  D0,(A0,D2.W)
02:0003AF3E 41EC0395        	  6546:     lea     ($0395,A4),A0
02:0003AF42 11802000        	  6547:     move.b  D0,(A0,D2.W)
02:0003AF46 19802071        	  6548:     move.b  D0,($71,A4,D2.W)
                            	  6549:     ; Look up and set the Y of the current segment of each neck.
