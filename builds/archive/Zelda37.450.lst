                            	  5770:     ; decrement the distance remaining, and move.
                            	  5771:     ;
02:0003A9AC 41EC0394        	  5772:     lea     ($0394,A4),A0
02:0003A9B0 10302000        	  5773:     move.b  (A0,D2.W),D0
02:0003A9B4 670A            	  5774:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003A9B6 41EC0394        	  5775:     lea     ($0394,A4),A0
