02:0004726E 123C0002        	  2368:     move.b  #$02,D1
02:00047272 D101            	  2369:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00047274 41EC030A        	  2370:     lea     ($030A,A4),A0
02:00047278 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:0004727C 41EC030B        	  2372:     lea     ($030B,A4),A0
02:00047280 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:00047284 41EC0306        	  2374:     lea     ($0306,A4),A0
02:00047288 52302000        	  2375:     addq.b  #1,(A0,D2.W)
02:0004728C 41EC030B        	  2376:     lea     ($030B,A4),A0
