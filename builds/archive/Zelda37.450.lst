02:0004705A 122C0004        	  2083:     move.b  ($0004,A4),D1
02:0004705E D101            	  2084:     addx.b  D1,D0   ; ADC $04
02:00047060 4A02            	  2085:     cmpi.b  #$00,D2
02:00047062 66E4            	  2086:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00047064 0C000002        	  2087:     cmpi.b  #$02,D0
02:00047068 66DE            	  2088:     bne  _L_z07_DrawItemBySlot_WriteSprites
