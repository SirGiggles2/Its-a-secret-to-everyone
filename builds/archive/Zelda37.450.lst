02:0003BD4E 41F90003BC1E    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BD54 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003BD58 8001            	  8451:     or.b  D1,D0
02:0003BD5A 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BD5E 41F90003BC28    	  8453:     lea     (GanonBurstTiles).l,A0
