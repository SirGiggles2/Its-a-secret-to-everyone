                            	  2327:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2328:     ; above its ObjY.
02:000338AC 102C0084        	  2329:     move.b  ($0084,A4),D0
02:000338B0 003C0011        	  2330:     ori     #$11,CCR  ; SEC: set C+X
02:000338B4 123C0008        	  2331:     move.b  #$08,D1
02:000338B8 0A3C0010        	  2332:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000338BC 9101            	  2333:     subx.b  D1,D0   ; SBC #$08
02:000338BE 0A3C0010        	  2334:     eori    #$10,CCR  ; restore X = 6502 C
02:000338C2 19400204        	  2335:     move.b  D0,($0204,A4)
02:000338C6 7070            	  2336:     moveq   #112,D0
02:000338C8 19400070        	  2337:     move.b  D0,($0070,A4)
02:000338CC 103C0087        	  2338:     move.b  #$87,D0
02:000338D0 19400085        	  2339:     move.b  D0,($0085,A4)
02:000338D4 7030            	  2340:     moveq   #48,D0
02:000338D6 19400071        	  2341:     move.b  D0,($0071,A4)
                            	  2342:     even
