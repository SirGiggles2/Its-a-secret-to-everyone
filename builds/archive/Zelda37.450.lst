02:0003BCD4 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0003BCD8 619A            	  8391:     jsr     Ganon_DrawCloud
02:0003BCDA 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
