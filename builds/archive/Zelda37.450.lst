                            	  4477: UpdatePeaceTextbox:
                            	  4478:     ; Only emit a character once every 8 frames --
                            	  4479:     ; when (counter [0412] MOD 8) = 4.
                            	  4480:     ;
02:00034F16 522C0412        	  4481:     addq.b  #1,($0412,A4)
02:00034F1A 102C0412        	  4482:     move.b  ($0412,A4),D0
02:00034F1E 02000007        	  4483:     andi.b #$07,D0
02:00034F22 0C000004        	  4484:     cmpi.b  #$04,D0
02:00034F26 665C            	  4485:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4486:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4487:     ; to the dynamic transfer buf.
                            	  4488:     ;
02:00034F28 7604            	  4489:     moveq   #4,D3
                            	  4490: _anon_z02_35:
02:00034F2A 41F900034EA6    	  4491:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00034F30 10303000        	  4492:     move.b  (A0,D3.W),D0
02:00034F34 41EC0302        	  4493:     lea     ($0302,A4),A0
02:00034F38 11803000        	  4494:     move.b  D0,(A0,D3.W)
02:00034F3C 5303            	  4495:     subq.b  #1,D3
02:00034F3E 6AEA            	  4496:     bpl  _anon_z02_35
                            	  4497:     ; Load a character from the string and copy it to
                            	  4498:     ; the transfer record until we read character $FF.
                            	  4499:     ;
02:00034F40 7600            	  4500:     moveq   #0,D3
02:00034F42 162C0413        	  4501:     move.b  ($0413,A4),D3
02:00034F46 41F900034EE0    	  4502:     lea     (PeaceText).l,A0
02:00034F4C 10303000        	  4503:     move.b  (A0,D3.W),D0
02:00034F50 0C0000FF        	  4504:     cmpi.b  #$FF,D0
02:00034F54 6730            	  4505:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034F56 19400305        	  4506:     move.b  D0,($0305,A4)
                            	  4507:     ; A regular space takes as much time to emit as any character.
                            	  4508:     ; But it makes no sound.
                            	  4509:     ;
02:00034F5A 0C000024        	  4510:     cmpi.b  #$24,D0
02:00034F5E 6706            	  4511:     beq  _anon_z02_36
02:00034F60 7010            	  4512:     moveq   #16,D0
02:00034F62 19400604        	  4513:     move.b  D0,($0604,A4)
                            	  4514: _anon_z02_36:
                            	  4515:     ; Point to the next character in the string.
                            	  4516:     ;
02:00034F66 522C0413        	  4517:     addq.b  #1,($0413,A4)
                            	  4518:     ; Replace the low byte of the VRAM address with the one
                            	  4519:     ; where the next character should be written.
                            	  4520:     ;
02:00034F6A 41F900034EAC    	  4521:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:00034F70 10303000        	  4522:     move.b  (A0,D3.W),D0
02:00034F74 19400303        	  4523:     move.b  D0,($0303,A4)
                            	  4524:     ; Once the low VRAM address rolls over,
                            	  4525:     ; increment the high address.
                            	  4526:     ;
02:00034F78 0C0000A0        	  4527:     cmpi.b  #$A0,D0
02:00034F7C 6406            	  4528:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:00034F7E 7023            	  4529:     moveq   #35,D0
