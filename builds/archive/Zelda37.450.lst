02:00047E6E 123C0000        	  4010:     move.b  #$00,D1
02:00047E72 D101            	  4011:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00047E74 19802070        	  4012:     move.b  D0,($70,A4,D2.W)
