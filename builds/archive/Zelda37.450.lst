02:0004123C 0C030085        	  7844:     cmpi.b  #$85,D3
02:00041240 6642            	  7845:     bne  _anon_z05_177
02:00041242 102C0098        	  7846:     move.b  ($0098,A4),D0
02:00041246 02000004        	  7847:     andi.b #$04,D0
