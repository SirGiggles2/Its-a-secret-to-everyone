                            	  7795: _anon_z05_174:
                            	  7796:     ; Two input directions, and at least one of them is walkable.
                            	  7797:     ;
                            	  7798:     ; Make Link go straight in one direction on the next grid line.
                            	  7799:     ;
02:00041204 7600            	  7800:     moveq   #0,D3
02:00041206 1600            	  7801:     move.b  D0,D3
02:00041208 522C0057        	  7802:     addq.b  #1,($0057,A4)
                            	  7803:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7804:     ; object direction and input direction to last walkable direction
                            	  7805:     ; found, and set Link's speed.
                            	  7806:     ;
                            	  7807:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7808:     ;
02:0004120C 7400            	  7809:     moveq   #0,D2
02:0004120E 102C000D        	  7810:     move.b  ($000D,A4),D0
02:00041212 0C030001        	  7811:     cmpi.b  #$01,D3
02:00041216 67000096        	  7812:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
