02:0003AFA8 6A00FF7A        	  6590:     bpl  _anon_z04_108
                            	  6591:     ; Set speed flags to $FF (non-0/decelerate):
                            	  6592:     ; * neck 0 X
                            	  6593:     ; * neck 1 Y
                            	  6594:     ; * neck 2 X
                            	  6595:     ; * neck 3 Y
                            	  6596:     ;
                            	  6597:     ; Leave the other other speed flags 0 (accelerate).
                            	  6598:     ;
02:0003AFAC 13C200000422    	  6599:     move.b  D2,(Gleook_HeadInfo0+GLEEOK_SPEEDX).l
02:0003AFB2 13C200000430    	  6600:     move.b  D2,(Gleook_HeadInfo1+GLEEOK_SPEEDY).l
02:0003AFB8 13C200000383    	  6601:     move.b  D2,(Gleook_HeadInfo2+GLEEOK_SPEEDX).l
02:0003AFBE 13C2000003AC    	  6602:     move.b  D2,(Gleook_HeadInfo3+GLEEOK_SPEEDY).l
                            	  6603:     ; Set the V-direction counter of all necks to 3.
