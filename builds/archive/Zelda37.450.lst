                            	  3772: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3773:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3774:     ;
                            	  3775:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3776:     ;         or object direction when <> 0.
                            	  3777:     ;
                            	  3778:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3779:     ;
                            	  3780:     ; if slot = 0 and grid offset <> 0 then
                            	  3781:     ;   if input dir = 0 then
                            	  3782:     ;     use 0
                            	  3783:     ;   else
                            	  3784:     ;     use object direction
                            	  3785:     ; else
                            	  3786:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3787:     ;     return
                            	  3788:     ;   else
                            	  3789:     ;     if input dir = 0
                            	  3790:     ;       use 0
                            	  3791:     ;     else
                            	  3792:     ;       use input direction
                            	  3793:     ;
02:00047CCE 4A02            	  3794:     cmpi.b  #$00,D2
02:00047CD0 6612            	  3795:     bne  _L_z07_Walker_Move_CheckStunned
02:00047CD2 102C0394        	  3796:     move.b  ($0394,A4),D0
