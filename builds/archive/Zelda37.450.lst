                            	  2498: ;==============================================================================
                            	  2499: ; EXPORT side — carry-returning shims.
                            	  2500: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2501: ; reproduces the original function's carry normalization.
                            	  2502: ;==============================================================================
                            	  2503: 
                            	  2504: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2505: c_copy_next_row_to_transfer_buf:
02:0002BF8A 4EB900000000    	  2506:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF90 08000008        	  2507:     btst    #8,D0
02:0002BF94 670A            	  2508:     beq.s   .cc_cnr
02:0002BF96 003C0001        	  2509:     ori     #$01,CCR
02:0002BF9A 0A3C0001        	  2510:     eori    #$01,CCR
02:0002BF9E 4E75            	  2511:     rts
                            	  2512: .cc_cnr:
02:0002BFA0 023C00FE        	  2513:     andi    #$FE,CCR
02:0002BFA4 0A3C0001        	  2514:     eori    #$01,CCR
02:0002BFA8 4E75            	  2515:     rts
                            	  2516: 
                            	  2517: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2518: c_copy_next_row_advance_submode:
02:0002BFAA 4EB900000000    	  2519:     jsr     z05_copy_next_row_advance_submode
02:0002BFB0 08000008        	  2520:     btst    #8,D0
02:0002BFB4 670A            	  2521:     beq.s   .cc_cnras
02:0002BFB6 003C0001        	  2522:     ori     #$01,CCR
02:0002BFBA 0A3C0001        	  2523:     eori    #$01,CCR
02:0002BFBE 4E75            	  2524:     rts
                            	  2525: .cc_cnras:
02:0002BFC0 023C00FE        	  2526:     andi    #$FE,CCR
02:0002BFC4 0A3C0001        	  2527:     eori    #$01,CCR
02:0002BFC8 4E75            	  2528:     rts
                            	  2529: 
