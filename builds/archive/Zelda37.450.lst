02:00048820 7650            	  5547:     moveq   #80,D3
02:00048822 0C000070        	  5548:     cmpi.b  #$70,D0
02:00048826 6502            	  5549:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:00048828 7670            	  5550:     moveq   #112,D3
