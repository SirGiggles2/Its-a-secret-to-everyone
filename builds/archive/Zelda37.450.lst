                            	  4519: Digdogger_Draw:
02:0003A02E 7006            	  4520:     moveq   #6,D0
02:0003A030 4EB900049066    	  4521:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  4522:     ; If this is a child digdogger, then go draw it.
                            	  4523:     ;
02:0003A036 41EC046B        	  4524:     lea     ($046B,A4),A0
02:0003A03A 10302000        	  4525:     move.b  (A0,D2.W),D0
02:0003A03E 666C            	  4526:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  4527:     ; For each part of the big digdogger, from 0 to 3,
                            	  4528:     ; indexed by Y register:
                            	  4529:     ;
02:0003A040 7600            	  4530:     moveq   #0,D3
                            	  4531:     even
                            	  4532: _L_z04_Digdogger_Draw_LoopPart:
                            	  4533:     ; Store in [00] the X coordinate offset for the current corner.
                            	  4534:     ;
02:0003A042 10342070        	  4535:     move.b  ($70,A4,D2.W),D0
02:0003A046 023C00EE        	  4536:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A04A 41F90003A022    	  4537:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003A050 12303000        	  4538:     move.b  (A0,D3.W),D1
02:0003A054 D101            	  4539:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003A056 1880            	  4540:     move.b  D0,($0000,A4)
                            	  4541:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  4542:     ;
02:0003A058 41EC0084        	  4543:     lea     ($0084,A4),A0
02:0003A05C 10302000        	  4544:     move.b  (A0,D2.W),D0
02:0003A060 023C00EE        	  4545:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A064 41F90003A026    	  4546:     lea     (DigdoggerSpriteOffsetsY).l,A0
02:0003A06A 12303000        	  4547:     move.b  (A0,D3.W),D1
02:0003A06E D101            	  4548:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsY,Y
02:0003A070 19400001        	  4549:     move.b  D0,($0001,A4)
                            	  4550:     ; Load and set the sprite attributes for this part.
                            	  4551:     ; Vertical flipping is set appropriately here.
                            	  4552:     ;
02:0003A074 41F90003A02A    	  4553:     lea     (DigdoggerSpriteAttrs).l,A0
02:0003A07A 10303000        	  4554:     move.b  (A0,D3.W),D0
02:0003A07E 4EB9000310EA    	  4555:     jsr     Anim_SetSpriteDescriptorAttributes
