02:0003AFE0 13C000000420    	  6613:     move.b  D0,(Gleook_HeadInfo0+GLEEOK_DIRCOUNTERH).l
02:0003AFE6 13C00000042D    	  6614:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DIRCOUNTERH).l
02:0003AFEC 13C000000381    	  6615:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DIRCOUNTERH).l
02:0003AFF2 13C0000003A9    	  6616:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DIRCOUNTERH).l
                            	  6617:     ; Set neck 1 head delay timer to 12.
