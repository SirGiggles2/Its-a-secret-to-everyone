02:000399E6 7002            	  3654:     moveq   #2,D0
02:000399E8 41EC0445        	  3655:     lea     ($0445,A4),A0
02:000399EC 11803000        	  3656:     move.b  D0,(A0,D3.W)
02:000399F0 7041            	  3657:     moveq   #65,D0
