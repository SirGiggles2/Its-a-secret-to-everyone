02:0003BF86 11802000        	  8746:     move.b  D0,(A0,D2.W)
02:0003BF8A 5303            	  8747:     subq.b  #1,D3
02:0003BF8C 5302            	  8748:     subq.b  #1,D2
02:0003BF8E 6AE8            	  8749:     bpl  _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_OverwriteColors
