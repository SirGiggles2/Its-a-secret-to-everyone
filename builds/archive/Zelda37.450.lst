                            	  7797:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  7798:     ;
                            	  7799:     ; This means that in the first frame, slot 2 is the only one to be
                            	  7800:     ; shown.
                            	  7801:     ;
02:0003B8CA 102C00AE        	  7802:     move.b  ($00AE,A4),D0
02:0003B8CE 6700008E        	  7803:     beq  _L_z04_UpdatePatraChild_Exit
                            	  7804:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  7805:     ; here to wait to be shown at the top position (N) one at a time.
                            	  7806:     ;
02:0003B8D2 1002            	  7807:     move.b  D2,D0
                            	  7808:     ; Subtract 3 from the object slot to get the angle where the
                            	  7809:     ; patra child in object slot 2 should be for the current one to appear.
                            	  7810:     ;
02:0003B8D4 003C0011        	  7811:     ori     #$11,CCR  ; SEC: set C+X
02:0003B8D8 123C0003        	  7812:     move.b  #$03,D1
02:0003B8DC 0A3C0010        	  7813:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B8E0 9101            	  7814:     subx.b  D1,D0   ; SBC #$03
02:0003B8E2 0A3C0010        	  7815:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B8E6 7600            	  7816:     moveq   #0,D3
02:0003B8E8 1600            	  7817:     move.b  D0,D3
                            	  7818:     ; If the patra child in slot 2 has not reached the required angle,
                            	  7819:     ; then return.
                            	  7820:     ;
02:0003B8EA 102C0396        	  7821:     move.b  ($0396,A4),D0
02:0003B8EE 41F90003B8A8    	  7822:     lea     (PatraChildStartAngles).l,A0
02:0003B8F4 12303000        	  7823:     move.b  (A0,D3.W),D1
02:0003B8F8 B001            	  7824:     cmp.b   D1,D0
02:0003B8FA 6662            	  7825:     bne  _L_z04_UpdatePatraChild_Exit
                            	  7826:     even
                            	  7827: _L_z04_UpdatePatraChild_Ready:
                            	  7828:     ; Once the patra child in the last slot (9) reaches here, advance
                            	  7829:     ; the patra parent's state.
