                            	  2544: ;==============================================================================
                            	  2545: ; _indirect_stub — JMP (abs) indirect placeholder.
                            	  2546: ; Called when the transpiler can't resolve an indirect jump target at
                            	  2547: ; translate-time.  Halts via an infinite bra so BizHawk shows PC stuck here.
                            	  2548: ; In T9+ these will be replaced by computed dispatch tables.
                            	  2549: ;==============================================================================
                            	  2550: _indirect_stub:
02:0002AEC8 60FE            	  2551:     bra.s   _indirect_stub          ; spin — caught as deliberate halt in T9+
                            	  2552: 
                            	  2553: ;==============================================================================
                            	  2554: ; _m68k_tablejump — M68K-native replacement for the NES JSR-trick TableJump.
                            	  2555: ;
                            	  2556: ; On NES, "JSR TableJump" is a JSR-trick: the bytes after the JSR are a
                            	  2557: ; table of 16-bit vectors.  TableJump pops the return address from the 6502
                            	  2558: ; stack to find the table base, then jumps through it using the value in A.
                            	  2559: ;
                            	  2560: ; In M68K, BSR pushes the return address (= table base) onto A7 (M68K stack),
                            	  2561: ; not A5 (our NES stack).  The original TableJump pulled from A5 (zeros),
                            	  2562: ; constructing a bogus NES address and jumping into garbage.
                            	  2563: ;
                            	  2564: ; This replacement correctly pops the M68K return address as the dc.l table
                            	  2565: ; base, indexes by D0.b × 4, and dispatches.
                            	  2566: ;
                            	  2567: ; Calling convention:
                            	  2568: ;   D0.b = mode index
                            	  2569: ;   (A7)  = base address of the dc.l jump table (pushed by BSR)
                            	  2570: ;   Jumps directly to the selected target (does not RTS).
                            	  2571: ;==============================================================================
                            	  2572: _m68k_tablejump:
02:0002AECA 205F            	  2573:     movea.l (SP)+,A0        ; pop M68K return address = dc.l table base
02:0002AECC C07C00FF        	  2574:     and.w   #$00FF,D0       ; zero-extend mode byte → word
02:0002AED0 E548            	  2575:     lsl.w   #2,D0           ; D0.w = index × 4  (each dc.l = 4 bytes)
02:0002AED2 20700000        	  2576:     movea.l (A0,D0.W),A0   ; load 32-bit target address from table
02:0002AED6 4ED0            	  2577:     jmp     (A0)            ; dispatch (no return)
                            	  2578: 
                            	  2579: ;==============================================================================
                            	  2580: ; _clear_nametable_fast — Fast replacement for ClearNameTable.
                            	  2581: ;
                            	  2582: ; Fills Plane A with a tile word directly via VDP_DATA (bypassing _ppu_write_7)
                            	  2583: ; and clears NT_CACHE.  V64 plane: NT0 ($20) → rows 0-29, NT1 ($28) → rows 30-59.
                            	  2584: ;
                            	  2585: ; Input:
                            	  2586: ;   D0.b = hi byte of NES PPU address ($20 = nametable 0, $28 = nametable 1)
                            	  2587: ;   D2.b = tile index to fill with
                            	  2588: ;   D3.b = attribute byte (always 0 for Zelda clear; palette 0 used)
                            	  2589: ;
                            	  2590: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2591: ; Updates PPU_VADDR to the post-clear address (matching original behavior).
                            	  2592: ;==============================================================================
                            	  2593:     even
                            	  2594: _clear_nametable_fast:
02:0002AED8 48E7F880        	  2595:     movem.l D0-D4/A0,-(SP)
                            	  2596: 
                            	  2597:     ; Save NT selection before D0 is clobbered
02:0002AEDC 1800            	  2598:     move.b  D0,D4                   ; D4.b = NT hi byte ($20 or $28)
                            	  2599: 
                            	  2600:     ; Compute the end PPU_VADDR: start + 1024 tiles + 64 attributes = +$0440
02:0002AEDE 024000FF        	  2601:     andi.w  #$00FF,D0
02:0002AEE2 E148            	  2602:     lsl.w   #8,D0                   ; D0.w = PPU base ($2000 or $2800)
02:0002AEE4 06400440        	  2603:     addi.w  #$0440,D0
02:0002AEE8 33C000FF0802    	  2604:     move.w  D0,(PPU_VADDR).l        ; set PPU_VADDR to expected end value
                            	  2605: 
                            	  2606:     ; Build tile word from the current BG pattern-table selection
02:0002AEEE 7000            	  2607:     moveq   #0,D0
02:0002AEF0 1002            	  2608:     move.b  D2,D0                   ; D0.w = raw tile index
02:0002AEF2 4EB90000E8DC    	  2609:     bsr     _compose_bg_tile_word
02:0002AEF8 3200            	  2610:     move.w  D0,D1                   ; D1.w = tile word to write
                            	  2611: 
                            	  2612:     ; Determine VRAM start address based on NT selection
02:0002AEFA 0C040028        	  2613:     cmpi.b  #$28,D4
02:0002AEFE 672A            	  2614:     beq.s   .cnf_nt1
                            	  2615: 
                            	  2616:     ; ---- NT0: Fill Plane A rows 0-29 starting at $C000 ----
                            	  2617:     ; Phase 2c: also fill Window nametable rows 0-7 (256 tiles = 512 bytes).
                            	  2618:     ; Without this, NT0-clear requests leave stale HUD tiles in Window
                            	  2619:     ; after a mode transition that clears NT0.
02:0002AF00 23FC7000000200C0	  2620:     move.l  #$70000002,(VDP_CTRL).l ; VRAM write at $B000 (Window)
02:0002AF08 0004
02:0002AF0A 363C00FF        	  2621:     move.w  #255,D3                 ; 32 cols * 8 rows - 1
                            	  2622: .cnf_window_fill:
02:0002AF0E 33C100C00000    	  2623:     move.w  D1,(VDP_DATA).l
02:0002AF14 51CBFFF8        	  2624:     dbf     D3,.cnf_window_fill
                            	  2625: 
02:0002AF18 23FC4000000300C0	  2626:     move.l  #$40000003,(VDP_CTRL).l ; VRAM write at $C000
02:0002AF20 0004
                            	  2627:     ; Clear NT_CACHE offsets 0-959 (NT0)
02:0002AF22 41F900FF0840    	  2628:     lea     (NT_CACHE_BASE).l,A0
02:0002AF28 6010            	  2629:     bra.s   .cnf_fill
                            	  2630: 
                            	  2631: .cnf_nt1:
                            	  2632:     ; ---- NT1: Fill Plane A rows 30-63 starting at $CF00 ----
                            	  2633:     ; 34 rows = 30 NT1 rows + 4 gap rows (prevents garbage when scroll wraps).
                            	  2634:     ; $CF00 = $C000 + 30*$80.  VDP command: ($CF00 & $3FFF)<<16 | $40000003
                            	  2635:     ; NT1 doesn't touch HUD range — skip Window fill.
02:0002AF2A 23FC4F00000300C0	  2636:     move.l  #$4F000003,(VDP_CTRL).l ; VRAM write at $CF00
02:0002AF32 0004
                            	  2637:     ; Clear NT_CACHE offsets 960-1919 (NT1)
02:0002AF34 41F900FF0C00    	  2638:     lea     (NT_CACHE_BASE+960).l,A0
                            	  2639: 
                            	  2640: .cnf_fill:
                            	  2641:     ; Write tiles to Plane A rows.  Plane A is 64 tiles wide,
                            	  2642:     ; so after each 32-tile NES row we must skip 32 unused tiles.
                            	  2643:     ; NT0: 30 rows (0-29).  NT1: 34 rows (30-63, includes 4 gap rows).
02:0002AF3A 0C040028        	  2644:     cmpi.b  #$28,D4
02:0002AF3E 6604            	  2645:     bne.s   .cnf_nt0_count
02:0002AF40 7621            	  2646:     moveq   #34-1,D3                ; NT1: 34 rows (fills gap rows 60-63)
02:0002AF42 6002            	  2647:     bra.s   .cnf_row
                            	  2648: .cnf_nt0_count:
02:0002AF44 761D            	  2649:     moveq   #30-1,D3                ; NT0: 30 rows
                            	  2650: .cnf_row:
02:0002AF46 781F            	  2651:     moveq   #32-1,D4                ; 32 cols per row
                            	  2652: .cnf_col:
02:0002AF48 33C100C00000    	  2653:     move.w  D1,(VDP_DATA).l
02:0002AF4E 51CCFFF8        	  2654:     dbf     D4,.cnf_col
                            	  2655: 
                            	  2656:     ; Skip 32 unused tile slots (64 bytes) in Plane A row.
02:0002AF52 781F            	  2657:     moveq   #32-1,D4
                            	  2658: .cnf_skip:
02:0002AF54 33C100C00000    	  2659:     move.w  D1,(VDP_DATA).l         ; write same tile to unused slots (harmless)
02:0002AF5A 51CCFFF8        	  2660:     dbf     D4,.cnf_skip
                            	  2661: 
02:0002AF5E 51CBFFE6        	  2662:     dbf     D3,.cnf_row
                            	  2663: 
                            	  2664:     ; ---- Clear NT_CACHE (960 bytes for the selected NT) ----
02:0002AF62 363C03BF        	  2665:     move.w  #960-1,D3
02:0002AF66 1001            	  2666:     move.b  D1,D0                   ; fill byte = tile index
                            	  2667: .cnf_cache:
02:0002AF68 10C0            	  2668:     move.b  D0,(A0)+
02:0002AF6A 51CBFFFC        	  2669:     dbf     D3,.cnf_cache
                            	  2670: 
                            	  2671:     ; Clear matching transfer-interpreter palette shadow for this NT.
02:0002AF6E 0C040028        	  2672:     cmpi.b  #$28,D4
02:0002AF72 6708            	  2673:     beq.s   .cnf_attr_nt1
02:0002AF74 41F900FF1400    	  2674:     lea     (NT_ATTR_CACHE_BASE).l,A0
02:0002AF7A 6006            	  2675:     bra.s   .cnf_attr_fill
                            	  2676: .cnf_attr_nt1:
02:0002AF7C 41F900FF17C0    	  2677:     lea     (NT_ATTR_CACHE_BASE+960).l,A0
                            	  2678: .cnf_attr_fill:
02:0002AF82 363C03BF        	  2679:     move.w  #960-1,D3
02:0002AF86 4200            	  2680:     clr.b   D0
                            	  2681: .cnf_attr_loop:
02:0002AF88 10C0            	  2682:     move.b  D0,(A0)+
02:0002AF8A 51CBFFFC        	  2683:     dbf     D3,.cnf_attr_loop
                            	  2684: 
                            	  2685: .cnf_done:
02:0002AF8E 4CDF011F        	  2686:     movem.l (SP)+,D0-D4/A0
02:0002AF92 4E75            	  2687:     rts
