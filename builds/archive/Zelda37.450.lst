02:0003AFC6 13C000000421    	  6606:     move.b  D0,(Gleook_HeadInfo0+GLEEOK_DIRCOUNTERV).l
02:0003AFCC 13C00000042E    	  6607:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DIRCOUNTERV).l
02:0003AFD2 13C000000382    	  6608:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DIRCOUNTERV).l
02:0003AFD8 13C0000003AA    	  6609:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DIRCOUNTERV).l
                            	  6610:     ; Set the H-direction counter of all necks to 6.
