                            	  5193: _anon_z04_94:
                            	  5194:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  5195:     ; This is the base frame image.
                            	  5196:     ;
02:0003A50E E208            	  5197:     lsr.b  #1,D0   ; LSR A
02:0003A510 E208            	  5198:     lsr.b  #1,D0   ; LSR A
