02:0003E4D6 102C0013        	  3661:     move.b  ($0013,A4),D0
02:0003E4DA 4EB90002AECA    	  3662:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  3663:     even
