                            	  7459:     ; Each cellar can have two destination rooms: A and B.
                            	  7460:     ; Tunnels use both. Treasure rooms only use room A.
                            	  7461:     ;
                            	  7462:     ; If the room that Link came from is the room A of this cellar,
                            	  7463:     ; then look up the X coordinate of the ladder on the left at index 0.
