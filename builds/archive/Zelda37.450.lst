                            	  6749: Gohma_CheckCollisions:
                            	  6750:     ; Save the boss's X coordinate.
                            	  6751:     ;
02:0003B0D2 10342070        	  6752:     move.b  ($70,A4,D2.W),D0
02:0003B0D6 1B00            	  6753:     move.b  D0,-(A5)  ; PHA
                            	  6754:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  6755:     ; on the left side.
                            	  6756:     ;
02:0003B0D8 003C0011        	  6757:     ori     #$11,CCR  ; SEC: set C+X
02:0003B0DC 123C0010        	  6758:     move.b  #$10,D1
02:0003B0E0 0A3C0010        	  6759:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B0E4 9101            	  6760:     subx.b  D1,D0   ; SBC #$10
02:0003B0E6 0A3C0010        	  6761:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B0EA 19802070        	  6762:     move.b  D0,($70,A4,D2.W)
                            	  6763:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	  6764:     ; from left to right, indexed by [0F].
