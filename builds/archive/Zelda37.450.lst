02:0003BD0C 19400001        	  8410:     move.b  D0,($0001,A4)
02:0003BD10 6100FF62        	  8411:     jsr     Ganon_DrawCloud
02:0003BD14 6172            	  8412:     jsr     Ganon_GetCurCloudRight
02:0003BD16 6100FF5C        	  8413:     jsr     Ganon_DrawCloud
                            	  8414:     ; Save the object index.
                            	  8415:     ;
02:0003BD1A 102C0340        	  8416:     move.b  ($0340,A4),D0
02:0003BD1E 1B00            	  8417:     move.b  D0,-(A5)  ; PHA
                            	  8418:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
