02:00048310 8001            	  4772:     or.b  D1,D0
02:00048312 4EB9000310EA    	  4773:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4774:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4775:     ;
02:00048318 41F900048540    	  4776:     lea     (RDirectionToWeaponFrame).l,A0
