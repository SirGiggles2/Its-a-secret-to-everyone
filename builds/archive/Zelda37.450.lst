02:0003A82A 10302000        	  5576:     move.b  (A0,D2.W),D0
02:0003A82E 4EB900030DF4    	  5577:     jsr     DrawObjectMirrored
                            	  5578:     ; Check collisions. If Link was not captured, then return.
