02:0003BA32 4EB90002AECA    	  7982:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7983:     even
                            	  7984: UpdateGanon_JumpTable:
02:0003BA38 0003BA44        	  7985:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BA3C 0003BAA6        	  7986:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BA40 0003BAD4        	  7987:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  7988: 
                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0003BA44 701B            	  7996:     moveq   #27,D0
02:0003BA46 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0003BA4A 102C0028        	  8000:     move.b  ($0028,A4),D0
02:0003BA4E 6644            	  8001:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8002:     ; Once the timer expires, it's time to brighten the room.
                            	  8003:     ;
                            	  8004:     ; Save the current object slot.
02:0003BA50 1002            	  8005:     move.b  D2,D0
02:0003BA52 1B00            	  8006:     move.b  D0,-(A5)  ; PHA
02:0003BA54 610007F0        	  8007:     jsr     UpdateCandle
02:0003BA58 101D            	  8008:     move.b  (A5)+,D0  ; PLA
02:0003BA5A 7400            	  8009:     moveq   #0,D2
02:0003BA5C 1400            	  8010:     move.b  D0,D2
                            	  8011:     ; Turn off the room brightening flag, because we're controlling it
                            	  8012:     ; here instead of in the Mode 5 object update loop.
                            	  8013:     ;
02:0003BA5E 7000            	  8014:     moveq   #0,D0
02:0003BA60 1940051E        	  8015:     move.b  D0,($051E,A4)
                            	  8016:     ; On the first frame of the fade-to-light cycle, play the
                            	  8017:     ; Triforce/Ganon song.
                            	  8018:     ;
02:0003BA64 102C051C        	  8019:     move.b  ($051C,A4),D0
02:0003BA68 0C0000C0        	  8020:     cmpi.b  #$C0,D0
02:0003BA6C 6606            	  8021:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BA6E 7002            	  8022:     moveq   #2,D0
02:0003BA70 19400600        	  8023:     move.b  D0,($0600,A4)
                            	  8024:     even
                            	  8025: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8026:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8027:     ;
02:0003BA74 102C051C        	  8028:     move.b  ($051C,A4),D0
02:0003BA78 0200000F        	  8029:     andi.b #$0F,D0
02:0003BA7C 0C000004        	  8030:     cmpi.b  #$04,D0
02:0003BA80 6702            	  8031:     beq.s  __far_z_04_0087
02:0003BA82 6042            	  8032:     jmp  Ganon_DrawBodyFrame0
                            	  8033: __far_z_04_0087:
                            	  8034:     ; Set Link's timer to $C0 for the next scene phase.
                            	  8035:     ;
