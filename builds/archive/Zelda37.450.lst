02:0003A10A 666C            	  4628:     bne  _L_z04_Aquamentus_Move_Exit
                            	  4629:     ; If the boss crossed the left limit, then
                            	  4630:     ; put it back at the left limit ($88), and face right.
                            	  4631:     ;
