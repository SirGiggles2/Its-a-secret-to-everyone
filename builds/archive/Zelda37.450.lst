                            	  1587: _anon_z04_40:
02:00038B08 41EC0098        	  1588:     lea     ($0098,A4),A0
02:00038B0C 11832000        	  1589:     move.b  D3,(A0,D2.W)
                            	  1590:     even
                            	  1591: _L_z04_UpdateBurrower_CycleState:
                            	  1592:     ; Cycle the state between 0 and 5.
                            	  1593:     ;
02:00038B10 41EC00AC        	  1594:     lea     ($00AC,A4),A0
02:00038B14 10302000        	  1595:     move.b  (A0,D2.W),D0
02:00038B18 023C00EE        	  1596:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B1C 123C0001        	  1597:     move.b  #$01,D1
02:00038B20 D101            	  1598:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00038B22 0C000006        	  1599:     cmpi.b  #$06,D0
02:00038B26 6502            	  1600:     bcs  _anon_z04_41
02:00038B28 7000            	  1601:     moveq   #0,D0
                            	  1602: _anon_z04_41:
02:00038B2A 41EC00AC        	  1603:     lea     ($00AC,A4),A0
02:00038B2E 11802000        	  1604:     move.b  D0,(A0,D2.W)
                            	  1605:     ; Look up and set the speed and timer for the current state.
                            	  1606:     ;
02:00038B32 7600            	  1607:     moveq   #0,D3
02:00038B34 1600            	  1608:     move.b  D0,D3
02:00038B36 41F900038AB0    	  1609:     lea     (BlueLeeverStateQSpeeds).l,A0
02:00038B3C 10303000        	  1610:     move.b  (A0,D3.W),D0
02:00038B40 41EC03BC        	  1611:     lea     ($03BC,A4),A0
02:00038B44 11802000        	  1612:     move.b  D0,(A0,D2.W)
02:00038B48 41F900038AB6    	  1613:     lea     (BlueLeeverStateTimes).l,A0
02:00038B4E 10303000        	  1614:     move.b  (A0,D3.W),D0
02:00038B52 19802028        	  1615:     move.b  D0,($28,A4,D2.W)
                            	  1616:     even
                            	  1617: _L_z04_UpdateBurrower_Animate:
                            	  1618:     ; Advance the animation counter; possibly setting a new
                            	  1619:     ; value according to the new state.
                            	  1620:     ;
02:00038B56 7600            	  1621:     moveq   #0,D3
02:00038B58 41EC00AC        	  1622:     lea     ($00AC,A4),A0
02:00038B5C 16302000        	  1623:     move.b  (A0,D2.W),D3
02:00038B60 41F900038ABC    	  1624:     lea     (BlueLeeverStateAnimTimes).l,A0
02:00038B66 10303000        	  1625:     move.b  (A0,D3.W),D0
                            	  1626: ; Params:
                            	  1627: ; A: new value for animation counter, in case it rolls over
                            	  1628: ; X: object index
                            	  1629: ;
                            	  1630: ; Note:
                            	  1631: ; Advances the animation counter first.
                            	  1632: ;
                            	  1633:     even
                            	  1634: Burrower_AnimateDrawAndCheckCollisions:
02:00038B6A 4EB900049066    	  1635:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  1636:     ; If state = 0, return.
                            	  1637:     ;
02:00038B70 41EC00AC        	  1638:     lea     ($00AC,A4),A0
02:00038B74 10302000        	  1639:     move.b  (A0,D2.W),D0
02:00038B78 670000A8        	  1640:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1641:     ; If is zora, and state >= 2 and < 5, then use frame image 2 or 3
                            	  1642:     ; (front or back), which was stored in ObjDir above.
                            	  1643:     ;
02:00038B7C 7600            	  1644:     moveq   #0,D3
02:00038B7E 41EC034F        	  1645:     lea     ($034F,A4),A0
02:00038B82 16302000        	  1646:     move.b  (A0,D2.W),D3
02:00038B86 0C030011        	  1647:     cmpi.b  #$11,D3
02:00038B8A 6620            	  1648:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B8C 7600            	  1649:     moveq   #0,D3
02:00038B8E 41EC00AC        	  1650:     lea     ($00AC,A4),A0
02:00038B92 16302000        	  1651:     move.b  (A0,D2.W),D3
02:00038B96 0C030002        	  1652:     cmpi.b  #$02,D3
02:00038B9A 6510            	  1653:     bcs  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038B9C 0C030005        	  1654:     cmpi.b  #$05,D3
02:00038BA0 640A            	  1655:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038BA2 41EC0098        	  1656:     lea     ($0098,A4),A0
02:00038BA6 10302000        	  1657:     move.b  (A0,D2.W),D0
02:00038BAA 6622            	  1658:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw
                            	  1659:     even
                            	  1660: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  1661:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1662:     ; the mound frame images:
                            	  1663:     ;
                            	  1664:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1665:     ;
                            	  1666:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1667:     ;
                            	  1668:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1669:     ;
02:00038BAC 003C0011        	  1670:     ori     #$11,CCR  ; SEC: set C+X
02:00038BB0 123C0001        	  1671:     move.b  #$01,D1
02:00038BB4 0A3C0010        	  1672:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038BB8 9101            	  1673:     subx.b  D1,D0   ; SBC #$01
02:00038BBA 0A3C0010        	  1674:     eori    #$10,CCR  ; restore X = 6502 C
02:00038BBE E308            	  1675:     lsl.b  #1,D0   ; ASL A
02:00038BC0 023C00EE        	  1676:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038BC4 41EC03E4        	  1677:     lea     ($03E4,A4),A0
02:00038BC8 12302000        	  1678:     move.b  (A0,D2.W),D1
02:00038BCC D101            	  1679:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1680:     even
                            	  1681: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw:
02:00038BCE 61008224        	  1682:     jsr     DrawObjectMirrored
                            	  1683:     ; If not zora and state <> 3, 
                            	  1684:     ; or zora and state <> 2, 3, 4;
                            	  1685:     ; then return.
                            	  1686:     ;
02:00038BD2 41EC034F        	  1687:     lea     ($034F,A4),A0
02:00038BD6 10302000        	  1688:     move.b  (A0,D2.W),D0
02:00038BDA 0C000011        	  1689:     cmpi.b  #$11,D0
02:00038BDE 6614            	  1690:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00038BE0 41EC00AC        	  1691:     lea     ($00AC,A4),A0
02:00038BE4 10302000        	  1692:     move.b  (A0,D2.W),D0
02:00038BE8 0C000002        	  1693:     cmpi.b  #$02,D0
02:00038BEC 6714            	  1694:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
02:00038BEE 0C000004        	  1695:     cmpi.b  #$04,D0
02:00038BF2 670E            	  1696:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
                            	  1697:     even
                            	  1698: _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions:
02:00038BF4 41EC00AC        	  1699:     lea     ($00AC,A4),A0
02:00038BF8 10302000        	  1700:     move.b  (A0,D2.W),D0
02:00038BFC 0C000003        	  1701:     cmpi.b  #$03,D0
02:00038C00 6620            	  1702:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1703:     even
                            	  1704: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions:
02:00038C02 61008560        	  1705:     jsr     CheckMonsterCollisions
                            	  1706:     ; If not dying, then return.
                            	  1707:     ;
02:00038C06 41EC0405        	  1708:     lea     ($0405,A4),A0
02:00038C0A 10302000        	  1709:     move.b  (A0,D2.W),D0
02:00038C0E 6712            	  1710:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1711:     ; If monster is a red leever, then decrement the red leever count.
                            	  1712:     ;
02:00038C10 41EC034F        	  1713:     lea     ($034F,A4),A0
02:00038C14 10302000        	  1714:     move.b  (A0,D2.W),D0
02:00038C18 0C000010        	  1715:     cmpi.b  #$10,D0
02:00038C1C 6604            	  1716:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
02:00038C1E 532C0510        	  1717:     subq.b  #1,($0510,A4)
                            	  1718:     even
                            	  1719: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit:
02:00038C22 4E75            	  1720:     rts
                            	  1721: 
                            	  1722:     even
                            	  1723: RedLeeverStateQSpeeds:
02:00038C24 00              	  1724:     dc.b    $00, $00, $00, $20, $00, $00
02:00038C25 00
02:00038C26 00
02:00038C27 20
02:00038C28 00
02:00038C29 00
                            	  1725: 
                            	  1726:     even
                            	  1727: RedLeeverStateTimes:
02:00038C2A 00              	  1728:     dc.b    $00, $10, $08, $FF, $08, $10
02:00038C2B 10
02:00038C2C 08
02:00038C2D FF
02:00038C2E 08
02:00038C2F 10
                            	  1729: 
                            	  1730:     even
                            	  1731: RedLeeverStateAnimTimes:
02:00038C30 10              	  1732:     dc.b    $10, $08, $08, $05, $08, $08
02:00038C31 08
02:00038C32 08
02:00038C33 05
02:00038C34 08
02:00038C35 08
                            	  1733: 
                            	  1734:     even
                            	  1735: UpdateRedLeever:
02:00038C36 41EC00AC        	  1736:     lea     ($00AC,A4),A0
02:00038C3A 10302000        	  1737:     move.b  (A0,D2.W),D0
02:00038C3E 6704            	  1738:     beq  _anon_z04_42
02:00038C40 60000124        	  1739:     jmp     _L_z04_UpdateRedLeever_CheckOtherStates
                            	  1740: 
                            	  1741: _anon_z04_42:
                            	  1742:     ; State 0.
                            	  1743:     ;
                            	  1744:     ; In state we determine whether to burst out of the ground.
                            	  1745:     ; If the long timer has not expired, then return.
                            	  1746:     ;
02:00038C44 102C004D        	  1747:     move.b  ($004D,A4),D0
02:00038C48 6674            	  1748:     bne  _L_z04_UpdateRedLeever_Exit
                            	  1749:     ; Only allow two red leevers at a time.
                            	  1750:     ;
02:00038C4A 102C0510        	  1751:     move.b  ($0510,A4),D0
02:00038C4E 0C000002        	  1752:     cmpi.b  #$02,D0
02:00038C52 646A            	  1753:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1754:     ; Face in the same direction as Link.
                            	  1755:     ;
02:00038C54 102C0098        	  1756:     move.b  ($0098,A4),D0
02:00038C58 41EC0098        	  1757:     lea     ($0098,A4),A0
02:00038C5C 11802000        	  1758:     move.b  D0,(A0,D2.W)
                            	  1759:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  1760:     ;
02:00038C60 10342019        	  1761:     move.b  ($19,A4,D2.W),D0
02:00038C64 0C0000C0        	  1762:     cmpi.b  #$C0,D0
02:00038C68 6506            	  1763:     bcs  _anon_z04_43
02:00038C6A 4EB900047FDC    	  1764:     jsr     ReverseObjDir
                            	  1765: _anon_z04_43:
                            	  1766:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  1767:     ;
02:00038C70 41EC0098        	  1768:     lea     ($0098,A4),A0
02:00038C74 10302000        	  1769:     move.b  (A0,D2.W),D0
02:00038C78 0200000C        	  1770:     andi.b #$0C,D0
02:00038C7C 6742            	  1771:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  1772:     ; Begin with the leever's X set to Link's X.
                            	  1773:     ;
02:00038C7E 102C0070        	  1774:     move.b  ($0070,A4),D0
02:00038C82 19802070        	  1775:     move.b  D0,($70,A4,D2.W)
                            	  1776:     ; If facing down, then use Y offset $28.
                            	  1777:     ; Else store Y offset -$28 in [00].
                            	  1778:     ;
02:00038C86 7628            	  1779:     moveq   #40,D3
02:00038C88 41EC0098        	  1780:     lea     ($0098,A4),A0
02:00038C8C 10302000        	  1781:     move.b  (A0,D2.W),D0
02:00038C90 02000008        	  1782:     andi.b #$08,D0
02:00038C94 6704            	  1783:     beq  _anon_z04_44
02:00038C96 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:00038C9A 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
02:00038C9C 102C0084        	  1789:     move.b  ($0084,A4),D0
02:00038CA0 023C00EE        	  1790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038CA4 1214            	  1791:     move.b  ($0000,A4),D1
02:00038CA6 D101            	  1792:     addx.b  D1,D0   ; ADC $00
                            	  1793:     ; Sanitize the Y coordinate:
                            	  1794:     ; (Y AND $F0) OR $D
                            	  1795:     ;
02:00038CA8 020000F0        	  1796:     andi.b #$F0,D0
02:00038CAC 0000000D        	  1797:     ori.b #$0D,D0
02:00038CB0 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038CB4 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
                            	  1802:     ;
                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038CB8 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038CBC 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
02:00038CBE 4E75            	  1809:     rts
                            	  1810: 
                            	  1811:     even
                            	  1812: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  1813:     ; Begin with the leever's Y set to Link's Y.
                            	  1814:     ;
02:00038CC0 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038CC4 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038CC8 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038CCC 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038CD0 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038CD2 7628            	  1826:     moveq   #40,D3
02:00038CD4 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038CD8 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038CDC 02000002        	  1829:     andi.b #$02,D0
02:00038CE0 6704            	  1830:     beq  _anon_z04_45
02:00038CE2 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038CE6 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038CE8 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038CEC 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038CF0 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038CF4 1214            	  1841:     move.b  ($0000,A4),D1
02:00038CF6 D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038CF8 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038CFC 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038D00 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038D04 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038D08 B001            	  1853:     cmp.b   D1,D0
02:00038D0A 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038D0C 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038D0E 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038D12 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038D16 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038D18 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038D1C 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038D20 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038D24 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038D28 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038D2C 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038D2E 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038D32 0C000030        	  1874:     cmpi.b  #$30,D0
02:00038D36 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
                            	  1877: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1878:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  1879:     ;
02:00038D38 4EB900047A90    	  1880:     jsr     GetCollidableTileStill
02:00038D3E 122C034A        	  1881:     move.b  ($034A,A4),D1
02:00038D42 B001            	  1882:     cmp.b   D1,D0
02:00038D44 6400FF78        	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
02:00038D48 522C0510        	  1884:     addq.b  #1,($0510,A4)
                            	  1885:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1886:     ; and pick up whatever the new value is for state 1.
                            	  1887:     ;
02:00038D4C 7001            	  1888:     moveq   #1,D0
02:00038D4E 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:00038D52 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
02:00038D56 E308            	  1893:     lsl.b  #1,D0   ; ASL A
02:00038D58 1940004D        	  1894:     move.b  D0,($004D,A4)
02:00038D5C 6100008C        	  1895:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  1896:     ; The leever has to face Link in order to move toward him.
                            	  1897:     ;
02:00038D60 4EB900047FDC    	  1898:     jsr     ReverseObjDir
                            	  1899:     even
                            	  1900: _L_z04_UpdateRedLeever_CheckOtherStates:
