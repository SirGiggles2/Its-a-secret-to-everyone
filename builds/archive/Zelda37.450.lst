02:0004878A 10342070        	  5442:     move.b  ($70,A4,D2.W),D0
02:0004878E 0C000002        	  5443:     cmpi.b  #$02,D0
02:00048792 650E            	  5444:     bcs  _L_z07_CheckState30_SetState40
                            	  5445:     even
