02:00039A08 1600            	  3670:     move.b  D0,D3
02:00039A0A 41F90003C2F0    	  3671:     lea     (Directions8).l,A0
02:00039A10 10303000        	  3672:     move.b  (A0,D3.W),D0
02:00039A14 1940009D        	  3673:     move.b  D0,($009D,A4)
02:00039A18 19400385        	  3674:     move.b  D0,($0385,A4)
02:00039A1C 102C0022        	  3675:     move.b  ($0022,A4),D0
02:00039A20 02000007        	  3676:     andi.b #$07,D0
02:00039A24 7600            	  3677:     moveq   #0,D3
02:00039A26 1600            	  3678:     move.b  D0,D3
02:00039A28 41F90003C2F0    	  3679:     lea     (Directions8).l,A0
02:00039A2E 10303000        	  3680:     move.b  (A0,D3.W),D0
