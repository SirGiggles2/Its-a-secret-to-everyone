02:0003A874 41EC03D0        	  5604:     lea     ($03D0,A4),A0
02:0003A878 11802000        	  5605:     move.b  D0,(A0,D2.W)
                            	  5606:     ; Now Link can't move.
                            	  5607:     ;
02:0003A87C 522C0512        	  5608:     addq.b  #1,($0512,A4)
                            	  5609:     even
