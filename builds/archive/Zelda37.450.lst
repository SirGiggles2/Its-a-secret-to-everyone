                            	  1175: 
                            	  1176:     ; Issue VDP CRAM write command
02:0000E69E 7400            	  1177:     moveq   #0,D2
02:0000E6A0 3403            	  1178:     move.w  D3,D2
02:0000E6A2 4842            	  1179:     swap    D2                      ; D2 = CRAM_addr << 16
02:0000E6A4 0082C0000000    	  1180:     ori.l   #$C0000000,D2           ; VDP CRAM-write command ($C0 = CD bits for CRAM write)
02:0000E6AA 23C200C00004    	  1181:     move.l  D2,(VDP_CTRL).l
                            	  1182: 
                            	  1183:     ; Look up NES color index (D0.b, 0..63) in NES→Genesis 16-bit color table
02:0000E6B0 0240003F        	  1184:     andi.w  #$003F,D0               ; D0.w = NES color index (mask high bits)
02:0000E6B4 41F90000E95A    	  1185:     lea     (nes_palette_to_genesis).l,A0
02:0000E6BA E348            	  1186:     lsl.w   #1,D0                   ; D0.w = byte offset into 16-bit word table
02:0000E6BC 34300000        	  1187:     move.w  (A0,D0.W),D2            ; D2.w = Genesis color word ($0BGR)
02:0000E6C0 33C200C00000    	  1188:     move.w  D2,(VDP_DATA).l         ; write Genesis color to CRAM
