                            	  4832: SpreadShot:
                            	  4833:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4834:     ;
                            	  4835:     ; The shot is spreading out.
                            	  4836:     ;
                            	  4837:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4838:     ; These will be negated appropriately for each corner.
                            	  4839:     ;
02:00048374 41EC0098        	  4840:     lea     ($0098,A4),A0
02:00048378 10302000        	  4841:     move.b  (A0,D2.W),D0
02:0004837C 19400002        	  4842:     move.b  D0,($0002,A4)
02:00048380 19400003        	  4843:     move.b  D0,($0003,A4)
                            	  4844:     ; Reset [0F] to not flip horizontally.
                            	  4845:     ;
02:00048384 7000            	  4846:     moveq   #0,D0
02:00048386 1940000F        	  4847:     move.b  D0,($000F,A4)
                            	  4848:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4849:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4850:     ;
02:0004838A 7603            	  4851:     moveq   #3,D3
                            	  4852:     even
                            	  4853: _L_z07_SpreadShot_DrawShotCorner:
02:0004838C 1003            	  4854:     move.b  D3,D0
02:0004838E 1B00            	  4855:     move.b  D0,-(A5)  ; PHA
                            	  4856:     ; Save offset X [02] and Y offset [03].
                            	  4857:     ;
02:00048390 102C0002        	  4858:     move.b  ($0002,A4),D0
02:00048394 1B00            	  4859:     move.b  D0,-(A5)  ; PHA
02:00048396 102C0003        	  4860:     move.b  ($0003,A4),D0
02:0004839A 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Calculate and set sprite attributes for this corner:
                            	  4863:     ;   base attribute OR (frame counter AND 3)
                            	  4864:     ;
                            	  4865:     ; The base attribute defines how to flip the sprite.
                            	  4866:     ; The frame counter makes the shot flash by cycling each
                            	  4867:     ; palette row.
                            	  4868:     ;
02:0004839C 102C0015        	  4869:     move.b  ($0015,A4),D0
02:000483A0 02000003        	  4870:     andi.b #$03,D0
02:000483A4 41F900048280    	  4871:     lea     (SwordShotSpreadBaseAttr).l,A0
02:000483AA 12303000        	  4872:     move.b  (A0,D3.W),D1
02:000483AE 8001            	  4873:     or.b  D1,D0
02:000483B0 4EB9000310EA    	  4874:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4875:     ; Add the object's X (the center of the spread) and the
                            	  4876:     ; current offset in [02] to set sprite X in [00].
                            	  4877:     ;
02:000483B6 10342070        	  4878:     move.b  ($70,A4,D2.W),D0
02:000483BA 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:000483BE 122C0002        	  4880:     move.b  ($0002,A4),D1
02:000483C2 D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:000483C4 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:000483C6 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:000483CA B001            	  4887:     cmp.b   D1,D0
02:000483CC 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:000483CE 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:000483D2 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:000483D4 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:000483D8 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:000483DC 0A3C0010        	  4893:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000483E0 9101            	  4894:     subx.b  D1,D0   ; SBC ObjX,X
02:000483E2 0A3C0010        	  4895:     eori    #$10,CCR  ; restore X = 6502 C
02:000483E6 6014            	  4896:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4897: 
                            	  4898:     even
                            	  4899: _L_z07_SpreadShot_ReverseSub:
02:000483E8 10342070        	  4900:     move.b  ($70,A4,D2.W),D0
02:000483EC 003C0011        	  4901:     ori     #$11,CCR  ; SEC: set C+X
02:000483F0 1214            	  4902:     move.b  ($0000,A4),D1
02:000483F2 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000483F6 9101            	  4904:     subx.b  D1,D0   ; SBC $00
02:000483F8 0A3C0010        	  4905:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4906:     even
                            	  4907: _L_z07_SpreadShot_CheckDistance:
                            	  4908:     ; If distance >= $20, skip this corner.
                            	  4909:     ;
02:000483FC 0C000020        	  4910:     cmpi.b  #$20,D0
02:00048400 6438            	  4911:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4912:     ; Add the object's Y (the center of the spread) and the
                            	  4913:     ; current offset in [03] to set sprite Y in [01].
                            	  4914:     ;
02:00048402 41EC0084        	  4915:     lea     ($0084,A4),A0
02:00048406 10302000        	  4916:     move.b  (A0,D2.W),D0
02:0004840A 023C00EE        	  4917:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004840E 122C0003        	  4918:     move.b  ($0003,A4),D1
02:00048412 D101            	  4919:     addx.b  D1,D0   ; ADC $03
02:00048414 19400001        	  4920:     move.b  D0,($0001,A4)
                            	  4921:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4922:     ;
02:00048418 7600            	  4923:     moveq   #0,D3
02:0004841A 162C0010        	  4924:     move.b  ($0010,A4),D3
02:0004841E 670C            	  4925:     beq  _L_z07_SpreadShot_Draw
02:00048420 0C00003E        	  4926:     cmpi.b  #$3E,D0
02:00048424 6514            	  4927:     bcs  _L_z07_SpreadShot_NextCorner
02:00048426 0C0000E8        	  4928:     cmpi.b  #$E8,D0
02:0004842A 640E            	  4929:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4930:     even
                            	  4931: _L_z07_SpreadShot_Draw:
                            	  4932:     ; Draw the corner.
                            	  4933:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4934:     ;
02:0004842C 7002            	  4935:     moveq   #2,D0
02:0004842E 1940000C        	  4936:     move.b  D0,($000C,A4)
