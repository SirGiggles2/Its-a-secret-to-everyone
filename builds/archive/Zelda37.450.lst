                            	  4288: 
                            	  4289: ; Description:
                            	  4290: ; Calculates the next alternate direction to move in while
                            	  4291: ; searching for an unblocked direction.
                            	  4292: ;
                            	  4293: ; Params:
                            	  4294: ; [0E]: the current step
                            	  4295: ;
                            	  4296: ; Returns:
                            	  4297: ; A: a direction for the current step, or 0 at the end of the loop
                            	  4298: ; [0E]: the next step, or 0 to end the loop
