                            	  5416: CheckState30:
                            	  5417:     ; If major state <> $30, go check other states.
                            	  5418:     ;
02:0004875E 0C000030        	  5419:     cmpi.b  #$30,D0
02:00048762 6656            	  5420:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5421:     ; State $3x. Slow down.
                            	  5422:     ;
                            	  5423:     ; Reset grid offset for movement.
                            	  5424:     ;
02:00048764 7000            	  5425:     moveq   #0,D0
02:00048766 41EC0394        	  5426:     lea     ($0394,A4),A0
02:0004876A 11802000        	  5427:     move.b  D0,(A0,D2.W)
                            	  5428:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5429:     ;
