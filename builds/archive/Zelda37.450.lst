02:0003386C 41F90003313A    	  2306:     lea     (ModeEandFCursorSprites).l,A0
02:00033872 10303000        	  2307:     move.b  (A0,D3.W),D0
02:00033876 41EC0201        	  2308:     lea     ($0201,A4),A0
02:0003387A 11803000        	  2309:     move.b  D0,(A0,D3.W)
02:0003387E 5303            	  2310:     subq.b  #1,D3
02:00033880 6AEA            	  2311:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033882 7600            	  2312:     moveq   #0,D3
02:00033884 162C0016        	  2313:     move.b  ($0016,A4),D3
02:00033888 41F9000330F0    	  2314:     lea     (ModeEandFSlotCursorYs).l,A0
