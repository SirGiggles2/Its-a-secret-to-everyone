02:000495B4 0200000F        	  6132:     andi.b #$0F,D0
02:000495B8 1880            	  6133:     move.b  D0,($0000,A4)
02:000495BA 101D            	  6134:     move.b  (A5)+,D0  ; PLA
02:000495BC E208            	  6135:     lsr.b  #1,D0   ; LSR A
02:000495BE E208            	  6136:     lsr.b  #1,D0   ; LSR A
02:000495C0 E208            	  6137:     lsr.b  #1,D0   ; LSR A
02:000495C2 E208            	  6138:     lsr.b  #1,D0   ; LSR A
02:000495C4 1214            	  6139:     move.b  ($0000,A4),D1
02:000495C6 B001            	  6140:     cmp.b   D1,D0
02:000495C8 6702            	  6141:     beq.s  __far_z_07_0093
02:000495CA 60C6            	  6142:     jmp  L1F854_Exit
                            	  6143: __far_z_07_0093:
                            	  6144:     ; If partial heart is less than half full, return.
                            	  6145:     ;
02:000495CC 102C0670        	  6146:     move.b  ($0670,A4),D0
