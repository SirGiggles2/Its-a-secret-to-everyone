                            	  2713: Link_FilterInput:
                            	  2714:     ; [00] holds the opposite of Link's facing direction.
                            	  2715:     ;
02:0003E5E6 102C0098        	  2716:     move.b  ($0098,A4),D0
02:0003E5EA 4EB90003091A    	  2717:     jsr     GetOppositeDir
02:0003E5F0 1880            	  2718:     move.b  D0,($0000,A4)
                            	  2719:     ; Call GetOppositeDir again to use this mapping:
                            	  2720:     ; In Dir: 1 2 4 8
                            	  2721:     ;         -------
                            	  2722:     ; Index:  2 3 0 1
                            	  2723:     ;
02:0003E5F2 4EB90003091A    	  2724:     jsr     GetOppositeDir
                            	  2725:     ; Get the appropriate coordinate for the direction:
                            	  2726:     ; X for horizontal
                            	  2727:     ; Y for vertical
                            	  2728:     ;
02:0003E5F8 102C0070        	  2729:     move.b  ($0070,A4),D0
02:0003E5FC 0C030002        	  2730:     cmpi.b  #$02,D3
02:0003E600 6404            	  2731:     bcc  _anon_z05_74
02:0003E602 102C0084        	  2732:     move.b  ($0084,A4),D0
                            	  2733: _anon_z05_74:
02:0003E606 19400002        	  2734:     move.b  D0,($0002,A4)
                            	  2735:     ; Mask A button and directions if inner border is crossed.
                            	  2736:     ;
02:0003E60A 1003            	  2737:     move.b  D3,D0
02:0003E60C 1B00            	  2738:     move.b  D0,-(A5)  ; PHA
02:0003E60E 023C00EE        	  2739:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E612 123C0008        	  2740:     move.b  #$08,D1
02:0003E616 D101            	  2741:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E618 7600            	  2742:     moveq   #0,D3
02:0003E61A 1600            	  2743:     move.b  D0,D3
02:0003E61C 103C0080        	  2744:     move.b  #$80,D0
02:0003E620 6134            	  2745:     jsr     MaskInputInBorder
02:0003E622 101D            	  2746:     move.b  (A5)+,D0  ; PLA
02:0003E624 7600            	  2747:     moveq   #0,D3
02:0003E626 1600            	  2748:     move.b  D0,D3
                            	  2749:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2750:     ; boundary using player's direction and reverse direction index.
                            	  2751:     ;
