02:0003C444 6510            	  9216:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003C446 0C020007        	  9217:     cmpi.b  #$07,D2
02:0003C44A 670A            	  9218:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003C44C 102C0015        	  9219:     move.b  ($0015,A4),D0
