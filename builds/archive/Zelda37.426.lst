                            	  1921: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  1922:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1923:     ; the mound frame images:
                            	  1924:     ;
                            	  1925:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1926:     ;
                            	  1927:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1928:     ;
                            	  1929:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1930:     ;
02:00038EA8 003C0011        	  1931:     ori     #$11,CCR  ; SEC: set C+X
02:00038EAC 123C0001        	  1932:     move.b  #$01,D1
02:00038EB0 0A3C0010        	  1933:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038EB4 9101            	  1934:     subx.b  D1,D0   ; SBC #$01
02:00038EB6 0A3C0010        	  1935:     eori    #$10,CCR  ; restore X = 6502 C
02:00038EBA E308            	  1936:     lsl.b  #1,D0   ; ASL A
02:00038EBC 023C00EE        	  1937:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038EC0 41EC03E4        	  1938:     lea     ($03E4,A4),A0
02:00038EC4 12302000        	  1939:     move.b  (A0,D2.W),D1
02:00038EC8 D101            	  1940:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1941:     even
                            	  1942: _L_z04_Burrower_AnimateDrawAndCheckCollisions_Draw:
02:00038ECA 4EB900030CE6    	  1943:     jsr     DrawObjectMirrored
                            	  1944:     ; If not zora and state <> 3, 
                            	  1945:     ; or zora and state <> 2, 3, 4;
                            	  1946:     ; then return.
                            	  1947:     ;
02:00038ED0 41EC034F        	  1948:     lea     ($034F,A4),A0
02:00038ED4 10302000        	  1949:     move.b  (A0,D2.W),D0
02:00038ED8 0C000011        	  1950:     cmpi.b  #$11,D0
02:00038EDC 6614            	  1951:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
02:00038EDE 41EC00AC        	  1952:     lea     ($00AC,A4),A0
02:00038EE2 10302000        	  1953:     move.b  (A0,D2.W),D0
02:00038EE6 0C000002        	  1954:     cmpi.b  #$02,D0
02:00038EEA 6714            	  1955:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CheckCollisions
02:00038EEC 0C000004        	  1956:     cmpi.b  #$04,D0
