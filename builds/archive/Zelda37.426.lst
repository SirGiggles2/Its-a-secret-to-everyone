02:00048E2A 52302000        	  5069:     addq.b  #1,(A0,D2.W)
02:00048E2E 41EC00AC        	  5070:     lea     ($00AC,A4),A0
02:00048E32 10302000        	  5071:     move.b  (A0,D2.W),D0
02:00048E36 0200000F        	  5072:     andi.b #$0F,D0
02:00048E3A 0C000003        	  5073:     cmpi.b  #$03,D0
