02:00038EF6 10302000        	  1961:     move.b  (A0,D2.W),D0
02:00038EFA 0C000003        	  1962:     cmpi.b  #$03,D0
02:00038EFE 6620            	  1963:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1964:     even
