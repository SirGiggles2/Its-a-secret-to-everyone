                            	  2661: L_EndInitFlyingGhini:
02:000393B2 6100FEAA        	  2662:     jsr     DrawGhiniAndCheckCollisions
                            	  2663:     ; If we're finally leaving the object flagged "initialized",
                            	  2664:     ; then reset metastate and initialize this as a flyer.
