                            	  9206: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003C43C 19420340        	  9207:     move.b  D2,($0340,A4)
                            	  9208:     ; If object slot < 5 or = 7, then move every frame.
                            	  9209:     ; Else move 3 out of every 4 frames.
                            	  9210:     ;
                            	  9211:     ; This makes pieces spread out in somewhat of a circle,
                            	  9212:     ; by making the pieces at cardinal directions move at
                            	  9213:     ; full speed while the diagonal ones move a little slower.
                            	  9214:     ;
