                            	  2673: UpdateArmos:
02:000393CA 6100F022        	  2674:     jsr     UpdateGoriya
                            	  2675:     ; If it's still shoved, then don't animate. Only go draw.
                            	  2676:     ;
02:000393CE 41EC00C0        	  2677:     lea     ($00C0,A4),A0
02:000393D2 10302000        	  2678:     move.b  (A0,D2.W),D0
02:000393D6 6702            	  2679:     beq.s  __far_z_04_0024
02:000393D8 602A            	  2680:     jmp  DrawArmosAndCheckCollisions
                            	  2681: __far_z_04_0024:
                            	  2682:     ; Animate.
                            	  2683:     ;
                            	  2684:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  2685:     ; then only go draw.
                            	  2686:     ;
02:000393DA 41EC03D0        	  2687:     lea     ($03D0,A4),A0
02:000393DE 53302000        	  2688:     subq.b  #1,(A0,D2.W)
02:000393E2 6702            	  2689:     beq.s  __far_z_04_0025
02:000393E4 601E            	  2690:     jmp  DrawArmosAndCheckCollisions
                            	  2691: __far_z_04_0025:
                            	  2692:     ; Armos animation frames last 6 screen frames.
                            	  2693:     ;
02:000393E6 7006            	  2694:     moveq   #6,D0
02:000393E8 41EC03D0        	  2695:     lea     ($03D0,A4),A0
02:000393EC 11802000        	  2696:     move.b  D0,(A0,D2.W)
                            	  2697:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  2698:     ; change the position of the shield. To keep fixed it in place,
                            	  2699:     ; there are separate frame images for each animation frame.
                            	  2700:     ;
                            	  2701:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  2702:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  2703:     ;
                            	  2704:     ; Here flip between the two sets by XOR'ing with 2.
                            	  2705:     ; Then choose the direction at the point of drawing below.
                            	  2706:     ;
02:000393F0 41EC03E4        	  2707:     lea     ($03E4,A4),A0
02:000393F4 10302000        	  2708:     move.b  (A0,D2.W),D0
02:000393F8 0A000002        	  2709:     eori.b #$02,D0
02:000393FC 41EC03E4        	  2710:     lea     ($03E4,A4),A0
02:00039400 11802000        	  2711:     move.b  D0,(A0,D2.W)
                            	  2712:     even
                            	  2713: DrawArmosAndCheckCollisions:
02:00039404 4EB9000499E4    	  2714:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003940A 7600            	  2715:     moveq   #0,D3
02:0003940C 41EC0098        	  2716:     lea     ($0098,A4),A0
02:00039410 16302000        	  2717:     move.b  (A0,D2.W),D3
                            	  2718:     ; If facing up, then use the second frame image in the set ("back").
                            	  2719:     ; Else use the second.
                            	  2720:     ;
02:00039414 0C030008        	  2721:     cmpi.b  #$08,D3
02:00039418 6602            	  2722:     bne  _anon_z04_54
02:0003941A 7001            	  2723:     moveq   #1,D0
                            	  2724: _anon_z04_54:
02:0003941C 023C00EE        	  2725:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039420 41EC03E4        	  2726:     lea     ($03E4,A4),A0
02:00039424 12302000        	  2727:     move.b  (A0,D2.W),D1
02:00039428 D101            	  2728:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003942A 4EB900030CEA    	  2729:     jsr     DrawObjectNotMirrored
                            	  2730:     ; If the armos is still fading in, then go for check collision with Link,
                            	  2731:     ; but not with weapons.
                            	  2732:     ;
02:00039430 10342028        	  2733:     move.b  ($28,A4,D2.W),D0
02:00039434 661C            	  2734:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  2735:     ; Else check for all collisions.
                            	  2736:     ;
02:00039436 4EB900031056    	  2737:     jsr     CheckMonsterCollisions
                            	  2738:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  2739:     ;
02:0003943C 41EC0405        	  2740:     lea     ($0405,A4),A0
02:00039440 10302000        	  2741:     move.b  (A0,D2.W),D0
02:00039444 670A            	  2742:     beq  _anon_z04_55
02:00039446 705D            	  2743:     moveq   #93,D0
02:00039448 41EC034F        	  2744:     lea     ($034F,A4),A0
02:0003944C 11802000        	  2745:     move.b  D0,(A0,D2.W)
                            	  2746: _anon_z04_55:
02:00039450 4E75            	  2747:     rts
                            	  2748: 
                            	  2749:     even
