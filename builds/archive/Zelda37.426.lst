02:0004953A 11802000        	  6056:     move.b  D0,(A0,D2.W)
02:0004953E 7010            	  6057:     moveq   #16,D0
02:00049540 4EB900030950    	  6058:     jsr     PlaceWeapon
                            	  6059:     ; If the direction is horizontal, and X < $14 or >= $EC, then
                            	  6060:     ; deactivate the shot object.
                            	  6061:     ;
02:00049546 41EC0098        	  6062:     lea     ($0098,A4),A0
02:0004954A 10302000        	  6063:     move.b  (A0,D2.W),D0
02:0004954E 02000003        	  6064:     andi.b #$03,D0
02:00049552 6714            	  6065:     beq  _L_z07_SetUpWeaponWithState_ChooseSpeed
02:00049554 10342070        	  6066:     move.b  ($70,A4,D2.W),D0
02:00049558 0C000014        	  6067:     cmpi.b  #$14,D0
02:0004955C 6402            	  6068:     bcc.s  __far_z_07_0090
02:0004955E 6034            	  6069:     jmp  ResetObjState
                            	  6070: __far_z_07_0090:
02:00049560 0C0000EC        	  6071:     cmpi.b  #$EC,D0
02:00049564 6502            	  6072:     bcs.s  __far_z_07_0091
02:00049566 602C            	  6073:     jmp  ResetObjState
