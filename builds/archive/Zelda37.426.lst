                            	  4186:     ; go see if it's time to propagate direction changes down the chain.
                            	  4187:     ;
02:00039EE4 10342028        	  4188:     move.b  ($28,A4,D2.W),D0
02:00039EE8 6702            	  4189:     beq.s  __far_z_04_0032
02:00039EEA 6032            	  4190:     jmp  Moldorm_PropagateDirs
