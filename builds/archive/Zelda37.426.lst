02:00039EF2 19802028        	  4198:     move.b  D0,($28,A4,D2.W)
                            	  4199:     ; If the next lower slot's direction <> 0, then
                            	  4200:     ; go propagate direction changes down the chain.
                            	  4201:     ;
                            	  4202:     ; But you had to have propagated directions once for the
                            	  4203:     ; next lower direction to be set. How does it happen?
                            	  4204:     ;
                            	  4205:     ; Within a flyer state, the flying routines turn the flyer
                            	  4206:     ; and set the object timer to $10 several times. After any of
                            	  4207:     ; those times will the test succeed.
                            	  4208:     ;
                            	  4209:     ; When a flying state ends, timer will be 0, triggering the code
                            	  4210:     ; in this block to set the timer to $10, and try to propagate
                            	  4211:     ; directions.
                            	  4212:     ;
                            	  4213:     ; But this is also the case the first time here.
                            	  4214:     ;
                            	  4215:     ; So, I believe that the point of this test is to delay moving
                            	  4216:     ; the lower (not head) segments when starting out.
                            	  4217:     ;
02:00039EF6 41EC0097        	  4218:     lea     ($0097,A4),A0
02:00039EFA 10302000        	  4219:     move.b  (A0,D2.W),D0
02:00039EFE 6702            	  4220:     beq.s  __far_z_04_0033
02:00039F00 601C            	  4221:     jmp  Moldorm_PropagateDirs
                            	  4222: __far_z_04_0033:
02:00039F02 4E75            	  4223:     rts
                            	  4224: 
                            	  4225:     even
                            	  4226: Moldorm_Wander:
                            	  4227:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  4228:     ; Only the head controls the movement direction.
                            	  4229:     ;
02:00039F04 0C020005        	  4230:     cmpi.b  #$05,D2
02:00039F08 6708            	  4231:     beq  _anon_z04_82
02:00039F0A 0C02000A        	  4232:     cmpi.b  #$0A,D2
02:00039F0E 6702            	  4233:     beq.s  __far_z_04_0034
