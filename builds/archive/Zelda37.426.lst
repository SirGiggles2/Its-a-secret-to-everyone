02:00039C62 61000082        	  3868:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  3869:     ; The default image is the hand open.
                            	  3870:     ; If animation frame = 0, then return.
                            	  3871:     ;
02:00039C66 7400            	  3872:     moveq   #0,D2
02:00039C68 142C0340        	  3873:     move.b  ($0340,A4),D2
02:00039C6C 41EC03E4        	  3874:     lea     ($03E4,A4),A0
02:00039C70 10302000        	  3875:     move.b  (A0,D2.W),D0
02:00039C74 6724            	  3876:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  3877:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  3878:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  3879:     ; The right side is correctly the right side of a closed hand.
                            	  3880:     ; But the left side is Keese. So, we have to patch the left
                            	  3881:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  3882:     ;
                            	  3883:     ; Keep in mind that left and right sprites might be flipped.
                            	  3884:     ;
02:00039C76 7600            	  3885:     moveq   #0,D3
02:00039C78 1614            	  3886:     move.b  ($0000,A4),D3
02:00039C7A 41EC0201        	  3887:     lea     ($0201,A4),A0
02:00039C7E 10303000        	  3888:     move.b  (A0,D3.W),D0
02:00039C82 0C00009C        	  3889:     cmpi.b  #$9C,D0
02:00039C86 6706            	  3890:     beq  _anon_z04_68
02:00039C88 7600            	  3891:     moveq   #0,D3
02:00039C8A 162C0001        	  3892:     move.b  ($0001,A4),D3
