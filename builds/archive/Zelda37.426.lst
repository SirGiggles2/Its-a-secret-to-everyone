                            	  4264:     ;
02:00039F1E 10342028        	  4265:     move.b  ($28,A4,D2.W),D0
02:00039F22 0C000010        	  4266:     cmpi.b  #$10,D0
02:00039F26 6702            	  4267:     beq.s  __far_z_04_0036
02:00039F28 6058            	  4268:     jmp  L1156B_Exit
