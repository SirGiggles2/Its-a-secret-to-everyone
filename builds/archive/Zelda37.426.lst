                            	  4982: _L_z07_SpreadShot_NextCorner:
                            	  4983:     ; Prepare to process the next corner.
                            	  4984:     ;
                            	  4985:     ; First, restore X offset [02] and Y offset [03].
                            	  4986:     ;
02:00048DB2 101D            	  4987:     move.b  (A5)+,D0  ; PLA
02:00048DB4 19400003        	  4988:     move.b  D0,($0003,A4)
02:00048DB8 101D            	  4989:     move.b  (A5)+,D0  ; PLA
02:00048DBA 19400002        	  4990:     move.b  D0,($0002,A4)
                            	  4991:     ; Take turns negating X offset or Y offset for the next round.
                            	  4992:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4993:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4994:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4995:     ; - Fourth turn: doesn't matter
                            	  4996:     ;
                            	  4997:     ;
                            	  4998:     ; Get the loop index.
02:00048DBE 101D            	  4999:     move.b  (A5)+,D0  ; PLA
02:00048DC0 1B00            	  5000:     move.b  D0,-(A5)  ; PHA
02:00048DC2 7600            	  5001:     moveq   #0,D3
02:00048DC4 1600            	  5002:     move.b  D0,D3
02:00048DC6 0C030001        	  5003:     cmpi.b  #$01,D3
02:00048DCA 6602            	  5004:     bne  _anon_z07_25
02:00048DCC 7603            	  5005:     moveq   #3,D3
                            	  5006: _anon_z07_25:
02:00048DCE 10343000        	  5007:     move.b  ($00,A4,D3.W),D0
02:00048DD2 4600            	  5008:     eori.b #$FF,D0
02:00048DD4 023C00EE        	  5009:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048DD8 123C0001        	  5010:     move.b  #$01,D1
02:00048DDC D101            	  5011:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048DDE 19803000        	  5012:     move.b  D0,($00,A4,D3.W)
                            	  5013:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5014:     ;
02:00048DE2 101D            	  5015:     move.b  (A5)+,D0  ; PLA
02:00048DE4 7600            	  5016:     moveq   #0,D3
02:00048DE6 1600            	  5017:     move.b  D0,D3
02:00048DE8 5303            	  5018:     subq.b  #1,D3
02:00048DEA 6A00FF18        	  5019:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5020:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5021:     ;
                            	  5022:     ; Decrease the base negative offset to get farther away from
                            	  5023:     ; the center point.
                            	  5024:     ;
02:00048DEE 41EC0098        	  5025:     lea     ($0098,A4),A0
02:00048DF2 53302000        	  5026:     subq.b  #1,(A0,D2.W)
