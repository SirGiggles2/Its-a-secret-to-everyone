02:0003ABA8 41EC03D0        	  5916:     lea     ($03D0,A4),A0
02:0003ABAC 11802000        	  5917:     move.b  D0,(A0,D2.W)
02:0003ABB0 7600            	  5918:     moveq   #0,D3
02:0003ABB2 41EC03E4        	  5919:     lea     ($03E4,A4),A0
02:0003ABB6 16302000        	  5920:     move.b  (A0,D2.W),D3
02:0003ABBA 5203            	  5921:     addq.b  #1,D3
02:0003ABBC 1003            	  5922:     move.b  D3,D0
02:0003ABBE 02000003        	  5923:     andi.b #$03,D0
02:0003ABC2 41EC03E4        	  5924:     lea     ($03E4,A4),A0
02:0003ABC6 11802000        	  5925:     move.b  D0,(A0,D2.W)
                            	  5926:     even
                            	  5927: _L_z04_UpdateLikeLike_Draw:
                            	  5928:     ; Draw.
                            	  5929:     ;
