02:0003C3EE 610000B2        	  9174:     jsr     Ganon_GetCurCloudRight
02:0003C3F2 619A            	  9175:     jsr     Ganon_DrawCloud
02:0003C3F4 610000A6        	  9176:     jsr     Ganon_GetCurCloudLeft
