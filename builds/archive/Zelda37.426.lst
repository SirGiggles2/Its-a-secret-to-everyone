                            	   933: 
                            	   934: ;------------------------------------------------------------------------------
                            	   935: ; _c_move_object_shim — MoveObject trampoline.
                            	   936: ;
                            	   937: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   938: ;   Input:     D2 = slot (0..11)
                            	   939: ;   Preserves: D2, A4, A5
                            	   940: ;   Clobbers:  D0, D1, D3, A0
                            	   941: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   942: ;
                            	   943: ; GCC side:
                            	   944: ;   void c_move_object(unsigned short slot);
                            	   945: ;     slot arrives as a 16-bit value on the stack.
                            	   946: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   947: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   948: ;   never clobbered by gcc.
                            	   949: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   950: ;   semantics can exist in a pure C port).
                            	   951: ;------------------------------------------------------------------------------
                            	   952: _c_move_object_shim:
                            	   953:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   954:     move.b  #$AA,($0900,A4)
                            	   955:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   956:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   957:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   958:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   959:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   960:     moveq   #0,D0
02:0002B658 3002            	   961:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   962:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   963:     jsr     c_move_object
02:0002B662 588F            	   964:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   965:     rts
                            	   966: 
                            	   967: ;==============================================================================
                            	   968: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   969: ; and tail-call the native asm function.
                            	   970: ;
                            	   971: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   972: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   973: ; sign-extended).
                            	   974: ;==============================================================================
                            	   975: 
                            	   976: ;------------------------------------------------------------------------------
                            	   977: ; void c_copy_bank_to_window(unsigned int bank);
                            	   978: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   979: ;------------------------------------------------------------------------------
                            	   980: c_copy_bank_to_window:
02:0002B666 202F0004        	   981:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   982:     jmp     _copy_bank_to_window
                            	   983: 
                            	   984: ;------------------------------------------------------------------------------
                            	   985: ; unsigned char c_ppu_read_2(void);
                            	   986: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   987: ; C return: gcc expects result in D0.
                            	   988: ;------------------------------------------------------------------------------
                            	   989: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   990:     jmp     _ppu_read_2
                            	   991: 
                            	   992: ;------------------------------------------------------------------------------
                            	   993: ; void c_ppu_write_6(unsigned int val);
                            	   994: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   995: ;------------------------------------------------------------------------------
                            	   996: c_ppu_write_6:
02:0002B674 202F0004        	   997:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   998:     jmp     _ppu_write_6
                            	   999: 
                            	  1000: ;------------------------------------------------------------------------------
                            	  1001: ; void c_ppu_write_7(unsigned int val);
                            	  1002: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1003: ;------------------------------------------------------------------------------
                            	  1004: c_ppu_write_7:
02:0002B67E 202F0004        	  1005:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1006:     jmp     _ppu_write_7
                            	  1007: 
                            	  1008: ;------------------------------------------------------------------------------
                            	  1009: ; void c_turn_off_all_video(void);
                            	  1010: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1011: ;------------------------------------------------------------------------------
                            	  1012: c_turn_off_all_video:
02:0002B688 4EF9000476FC    	  1013:     jmp     TurnOffAllVideo
                            	  1014: 
                            	  1015: ;==============================================================================
                            	  1016: ; EXPORT side — z_03 entry point.
                            	  1017: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1018: ; the transpiler emits that label pointing to this shim instead of the
                            	  1019: ; z_03 asm body. The C function takes no args and returns void.
                            	  1020: ;==============================================================================
                            	  1021: 
                            	  1022: ;------------------------------------------------------------------------------
                            	  1023: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1024: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1025: ;------------------------------------------------------------------------------
                            	  1026: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1027:     jmp     z03_transfer_level_pattern_blocks
                            	  1028: 
                            	  1029: ;==============================================================================
                            	  1030: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1031: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1032: ;==============================================================================
                            	  1033: 
                            	  1034: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1035:     jmp     z06_init_mode2_submodes
                            	  1036: 
                            	  1037: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1038:     jmp     z06_copy_common_data_to_ram
                            	  1039: 
                            	  1040: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1041:     jmp     z06_update_mode2_load_full
                            	  1042: 
                            	  1043: ;==============================================================================
                            	  1044: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1045: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1046: ;==============================================================================
                            	  1047: 
                            	  1048: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	  1049:     jmp     z05_copy_column_to_tilebuf
                            	  1050: 
                            	  1051: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	  1052:     jmp     z05_copy_row_to_tilebuf
