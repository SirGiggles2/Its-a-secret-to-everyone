                            	  4353: UpdateZeldaTextbox:
02:00034D6C 4EB9000489A4    	  4354:     jsr     Link_EndMoveAndDraw
                            	  4355:     ; If Zelda's timer has not expired, then return.
                            	  4356:     ;
02:00034D72 102C0029        	  4357:     move.b  ($0029,A4),D0
