                            	  5129: Aquamentus_Draw:
                            	  5130:     ; Every $10 screen frames, switch animation frames.
                            	  5131:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  5132:     ; The last tile of frame 0 is at index 5.
                            	  5133:     ; The last tile of frame 1 is at index $B.
                            	  5134:     ;
02:0003A5A0 7605            	  5135:     moveq   #5,D3
02:0003A5A2 102C0015        	  5136:     move.b  ($0015,A4),D0
02:0003A5A6 02000010        	  5137:     andi.b #$10,D0
02:0003A5AA 6602            	  5138:     bne  _anon_z04_88
02:0003A5AC 760B            	  5139:     moveq   #11,D3
                            	  5140: _anon_z04_88:
02:0003A5AE 1943000A        	  5141:     move.b  D3,($000A,A4)
                            	  5142:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  5143:     ;
02:0003A5B2 7005            	  5144:     moveq   #5,D0
02:0003A5B4 1940000B        	  5145:     move.b  D0,($000B,A4)
                            	  5146:     even
                            	  5147: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A5B8 7600            	  5148:     moveq   #0,D3
02:0003A5BA 162C000B        	  5149:     move.b  ($000B,A4),D3
                            	  5150:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  5151:     ; Store it in [00].
                            	  5152:     ;
02:0003A5BE 10342070        	  5153:     move.b  ($70,A4,D2.W),D0
02:0003A5C2 023C00EE        	  5154:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5C6 41F90003A59A    	  5155:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A5CC 12303000        	  5156:     move.b  (A0,D3.W),D1
02:0003A5D0 D101            	  5157:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A5D2 1880            	  5158:     move.b  D0,($0000,A4)
                            	  5159:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  5160:     ; Store it in [01].
                            	  5161:     ;
02:0003A5D4 41EC0084        	  5162:     lea     ($0084,A4),A0
02:0003A5D8 10302000        	  5163:     move.b  (A0,D2.W),D0
02:0003A5DC 023C00EE        	  5164:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5E0 41F90003A594    	  5165:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A5E6 12303000        	  5166:     move.b  (A0,D3.W),D1
02:0003A5EA D101            	  5167:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A5EC 19400001        	  5168:     move.b  D0,($0001,A4)
                            	  5169:     ; Calculate sprite attributes:
                            	  5170:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  5171:     ;
                            	  5172:     ; If the boss is temporarily invincible, then
                            	  5173:     ; this makes it flash by cycling all the palette rows.
                            	  5174:     ;
                            	  5175:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  5176:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  5177:     ;
02:0003A5F0 41EC04F0        	  5178:     lea     ($04F0,A4),A0
02:0003A5F4 10302000        	  5179:     move.b  (A0,D2.W),D0
02:0003A5F8 02000003        	  5180:     andi.b #$03,D0
02:0003A5FC 0A000003        	  5181:     eori.b #$03,D0
02:0003A600 19400003        	  5182:     move.b  D0,($0003,A4)
02:0003A604 7600            	  5183:     moveq   #0,D3
02:0003A606 162C000A        	  5184:     move.b  ($000A,A4),D3
                            	  5185:     ; Look up the tile for this sprite.
                            	  5186:     ; If it's not the first one (face), then go write the sprite record.
                            	  5187:     ;
02:0003A60A 41F90003A588    	  5188:     lea     (AquamentusTiles).l,A0
02:0003A610 10303000        	  5189:     move.b  (A0,D3.W),D0
02:0003A614 12390003A588    	  5190:     move.b  (AquamentusTiles).l,D1
02:0003A61A B001            	  5191:     cmp.b   D1,D0
02:0003A61C 6610            	  5192:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  5193:     ; Else it's the first one (the face tile).
                            	  5194:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
