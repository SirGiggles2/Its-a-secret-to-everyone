02:00048D98 0C00003E        	  4968:     cmpi.b  #$3E,D0
02:00048D9C 6514            	  4969:     bcs  _L_z07_SpreadShot_NextCorner
02:00048D9E 0C0000E8        	  4970:     cmpi.b  #$E8,D0
