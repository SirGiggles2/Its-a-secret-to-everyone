                            	  5199: LayOutDoors:
                            	  5200:     ; Copies the right door face for the direction, type, and state
                            	  5201:     ; of the door to the play area tile map.
                            	  5202:     ;
                            	  5203:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5204:     ; that are not true doors.
                            	  5205:     ;
02:000401FA 7403            	  5206:     moveq   #3,D2
                            	  5207:     even
                            	  5208: L_LayOutDoors_LoopDoors:
                            	  5209:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5210:     ;
02:000401FC 7001            	  5211:     moveq   #1,D0
                            	  5212:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5213:     ;
                            	  5214:     ; [06] indicates whether we're handling the first half of
                            	  5215:     ; the door: Left half for N/S, Top half for E/W.
                            	  5216:     ;
02:000401FE 19400006        	  5217:     move.b  D0,($0006,A4)
                            	  5218:     even
                            	  5219: L_LayOutDoors_LoopHalves:
02:00040202 1002            	  5220:     move.b  D2,D0
02:00040204 1B00            	  5221:     move.b  D0,-(A5)  ; PHA
02:00040206 1940000B        	  5222:     move.b  D0,($000B,A4)
02:0004020A 41F9000401D6    	  5223:     lea     (DoorBits).l,A0
02:00040210 10302000        	  5224:     move.b  (A0,D2.W),D0
02:00040214 19400002        	  5225:     move.b  D0,($0002,A4)
02:00040218 6100FD4A        	  5226:     jsr     FindDoorAttrByDoorBit
                            	  5227:     ; Begin looking for the door face for the door attribute.
                            	  5228:     ; In general, use the door type as the provisional face;
                            	  5229:     ; except turn 4 into 8.
                            	  5230:     ;
02:0004021C 0C000005        	  5231:     cmpi.b  #$05,D0
02:00040220 642A            	  5232:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00040222 0C000004        	  5233:     cmpi.b  #$04,D0
02:00040226 6608            	  5234:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:00040228 7008            	  5235:     moveq   #8,D0
02:0004022A 6620            	  5236:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5237:     even
                            	  5238: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5239:     ; We jump here if the door type is bombable and was opened.
                            	  5240:     ; Change the provisional door face to value 9, which
                            	  5241:     ; will become the "hole in the wall".
                            	  5242:     ;
02:0004022C 7009            	  5243:     moveq   #9,D0
02:0004022E 665A            	  5244:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5245:     even
                            	  5246: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5247:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5248:     ; the mask of opened doors, because this is not a true door.
                            	  5249:     ;
02:00040230 1B00            	  5250:     move.b  D0,-(A5)  ; PHA
02:00040232 102C0002        	  5251:     move.b  ($0002,A4),D0
02:00040236 4600            	  5252:     eori.b #$FF,D0
02:00040238 122C00EE        	  5253:     move.b  ($00EE,A4),D1
02:0004023C C001            	  5254:     and.b  D1,D0
02:0004023E 194000EE        	  5255:     move.b  D0,($00EE,A4)
02:00040242 101D            	  5256:     move.b  (A5)+,D0  ; PLA
                            	  5257:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5258:     ;
02:00040244 0C000001        	  5259:     cmpi.b  #$01,D0
02:00040248 6402            	  5260:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004024A 7004            	  5261:     moveq   #4,D0
                            	  5262:     even
                            	  5263: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5264:     ; The door attribute (DA) has been mapped to a
                            	  5265:     ; provisional door face value (PF) in %A as follows:
                            	  5266:     ;
                            	  5267:     ; DA PF Meaning
                            	  5268:     ; -------------
                            	  5269:     ; 0  4  open
                            	  5270:     ; 1  1  wall
                            	  5271:     ; 2  2  false wall
                            	  5272:     ; 3  3  false wall 2
                            	  5273:     ; 4  8  bombable
                            	  5274:     ; 5  5  key
                            	  5275:     ; 6  6  key 2
                            	  5276:     ; 7  7  shutter
                            	  5277:     ;
                            	  5278:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5279:     ; has been cleared, if the type was "open" or any wall.
                            	  5280:     ;
                            	  5281:     ;
                            	  5282:     ; Save the provisional face.
02:0004024C 1B00            	  5283:     move.b  D0,-(A5)  ; PHA
                            	  5284:     ; If the current direction points to a door that has been opened,
                            	  5285:     ; then see if we need to set door flags.
                            	  5286:     ;
02:0004024E 102C00EE        	  5287:     move.b  ($00EE,A4),D0
02:00040252 122C0002        	  5288:     move.b  ($0002,A4),D1
02:00040256 C001            	  5289:     and.b  D1,D0
02:00040258 7400            	  5290:     moveq   #0,D2
02:0004025A 1400            	  5291:     move.b  D0,D2
02:0004025C 101D            	  5292:     move.b  (A5)+,D0  ; PLA
02:0004025E 122C0002        	  5293:     move.b  ($0002,A4),D1
02:00040262 B401            	  5294:     cmp.b   D1,D2
02:00040264 6624            	  5295:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5296:     ; The current direction points to a door that has been opened.
                            	  5297:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5298:     ;
                            	  5299:     ;
                            	  5300:     ; Save provisional door face in Y register.
02:00040266 7600            	  5301:     moveq   #0,D3
02:00040268 1600            	  5302:     move.b  D0,D3
02:0004026A 101D            	  5303:     move.b  (A5)+,D0  ; PLA
02:0004026C 1B00            	  5304:     move.b  D0,-(A5)  ; PHA
02:0004026E 7400            	  5305:     moveq   #0,D2
02:00040270 1400            	  5306:     move.b  D0,D2
02:00040272 1003            	  5307:     move.b  D3,D0
                            	  5308:     ; If provisional door face is not for a shutter, then
                            	  5309:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5310:     ;
                            	  5311:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5312:     ;
02:00040274 0C000007        	  5313:     cmpi.b  #$07,D0
02:00040278 670E            	  5314:     beq  _anon_z05_111
02:0004027A 1B00            	  5315:     move.b  D0,-(A5)  ; PHA
02:0004027C 6100DF68        	  5316:     jsr     SetDoorFlag
02:00040280 101D            	  5317:     move.b  (A5)+,D0  ; PLA
