02:00049FC8 000382CE        	  7387:     dc.l    InitWalker   ; jump table entry (32-bit for _m68k_tablejump)
02:00049FCC 000382CE        	  7388:     dc.l    InitWalker   ; jump table entry (32-bit for _m68k_tablejump)
02:00049FD0 000382CE        	  7389:     dc.l    InitWalker   ; jump table entry (32-bit for _m68k_tablejump)
