02:0003AC04 19400028        	  5951:     move.b  D0,($0028,A4)
02:0003AC08 19400405        	  5952:     move.b  D0,($0405,A4)
02:0003AC0C 194000C0        	  5953:     move.b  D0,($00C0,A4)
02:0003AC10 194000D3        	  5954:     move.b  D0,($00D3,A4)
                            	  5955:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  5956:     ;
02:0003AC14 41EC03E4        	  5957:     lea     ($03E4,A4),A0
02:0003AC18 11802000        	  5958:     move.b  D0,(A0,D2.W)
