                            	  7292:     ; Draw the left legs.
                            	  7293:     ;
02:0003B602 7600            	  7294:     moveq   #0,D3
                            	  7295: ; Params:
                            	  7296: ; Y: side: 0 for left, 1 for right
                            	  7297: ;
                            	  7298: ; Add the horizontal offset for the current side to Gohma's X to
                            	  7299: ; store the sprite's X in [00].
                            	  7300: ;
                            	  7301:     even
                            	  7302: Gohma_DrawLegsOneSide:
02:0003B604 10342070        	  7303:     move.b  ($70,A4,D2.W),D0
02:0003B608 023C00EE        	  7304:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B60C 41F90003B5E2    	  7305:     lea     (GohmaLegOffsetsX).l,A0
02:0003B612 12303000        	  7306:     move.b  (A0,D3.W),D1
02:0003B616 D101            	  7307:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B618 1880            	  7308:     move.b  D0,($0000,A4)
                            	  7309:     ; The object's Y is the sprite's.
                            	  7310:     ;
02:0003B61A 41EC0084        	  7311:     lea     ($0084,A4),A0
02:0003B61E 10302000        	  7312:     move.b  (A0,D2.W),D0
02:0003B622 19400001        	  7313:     move.b  D0,($0001,A4)
02:0003B626 612A            	  7314:     jsr     Gohma_SetSpriteAttributes
                            	  7315:     ; There are only two frame images for legs: left and right.
                            	  7316:     ; There are two animation frames. They are animated as follows:
                            	  7317:     ;
                            	  7318:     ; Frame 0:
                            	  7319:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  7320:     ; horizontal flipping = frame number = 0
                            	  7321:     ; 
                            	  7322:     ; Frame 1:
                            	  7323:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  7324:     ; horizontal flipping = frame number = 1
                            	  7325:     ;
02:0003B628 4EB9000499B6    	  7326:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B62E 1003            	  7327:     move.b  D3,D0
02:0003B630 023C00EE        	  7328:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B634 41EC03E4        	  7329:     lea     ($03E4,A4),A0
02:0003B638 12302000        	  7330:     move.b  (A0,D2.W),D1
02:0003B63C D101            	  7331:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B63E 02000001        	  7332:     andi.b #$01,D0
02:0003B642 023C00EE        	  7333:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B646 123C0004        	  7334:     move.b  #$04,D1
02:0003B64A D101            	  7335:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B64C 4EF900030CEA    	  7336:     jmp     DrawObjectNotMirrored
