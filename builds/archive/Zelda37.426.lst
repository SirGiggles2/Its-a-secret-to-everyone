02:0003A374 671E            	  4834:     beq  _L_z04_Digdogger_Move_End
02:0003A376 41EC0084        	  4835:     lea     ($0084,A4),A0
02:0003A37A 10302000        	  4836:     move.b  (A0,D2.W),D0
02:0003A37E 122C0003        	  4837:     move.b  ($0003,A4),D1
02:0003A382 0A3C0010        	  4838:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A386 9101            	  4839:     subx.b  D1,D0   ; SBC $03
02:0003A388 0A3C0010        	  4840:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A38C 41EC0084        	  4841:     lea     ($0084,A4),A0
