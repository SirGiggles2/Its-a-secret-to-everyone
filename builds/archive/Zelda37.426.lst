02:0003887E 41EC0451        	  1019:     lea     ($0451,A4),A0
02:00038882 11802000        	  1020:     move.b  D0,(A0,D2.W)
                            	  1021:     ; Second, load the vertical direction into [0F].
                            	  1022:     ;
02:00038886 41EC0437        	  1023:     lea     ($0437,A4),A0
02:0003888A 10302000        	  1024:     move.b  (A0,D2.W),D0
02:0003888E 1940000F        	  1025:     move.b  D0,($000F,A4)
                            	  1026:     ; Load the vertical q-speed and position fraction,
                            	  1027:     ; move, then save the position fraction.
                            	  1028:     ;
02:00038892 41EC0444        	  1029:     lea     ($0444,A4),A0
02:00038896 10302000        	  1030:     move.b  (A0,D2.W),D0
02:0003889A 7600            	  1031:     moveq   #0,D3
02:0003889C 41EC045E        	  1032:     lea     ($045E,A4),A0
02:000388A0 16302000        	  1033:     move.b  (A0,D2.W),D3
