                            	  3955: InitMoldorm:
                            	  3956:     ; Loop to make 10 moldrom segments, from 9 to 0, indexed by Y register.
                            	  3957:     ; Object slots $A to 1 will be used.
                            	  3958:     ;
02:00039D04 7609            	  3959:     moveq   #9,D3
                            	  3960: _anon_z04_77:
                            	  3961:     ; Start at position ($80, $70).
                            	  3962:     ;
02:00039D06 103C0080        	  3963:     move.b  #$80,D0
02:00039D0A 19803071        	  3964:     move.b  D0,($71,A4,D3.W)
02:00039D0E 7070            	  3965:     moveq   #112,D0
02:00039D10 41EC0085        	  3966:     lea     ($0085,A4),A0
02:00039D14 11803000        	  3967:     move.b  D0,(A0,D3.W)
                            	  3968:     ; Start with no direction, no deferred bounce direction,
                            	  3969:     ; and ready to update.
                            	  3970:     ;
02:00039D18 7000            	  3971:     moveq   #0,D0
02:00039D1A 41EC0099        	  3972:     lea     ($0099,A4),A0
02:00039D1E 11803000        	  3973:     move.b  D0,(A0,D3.W)
02:00039D22 41EC03BD        	  3974:     lea     ($03BD,A4),A0
02:00039D26 11803000        	  3975:     move.b  D0,(A0,D3.W)
02:00039D2A 41EC0406        	  3976:     lea     ($0406,A4),A0
02:00039D2E 11803000        	  3977:     move.b  D0,(A0,D3.W)
02:00039D32 41EC0493        	  3978:     lea     ($0493,A4),A0
02:00039D36 11803000        	  3979:     move.b  D0,(A0,D3.W)
                            	  3980:     ; Copy object attributes from the first monster slot.
                            	  3981:     ;
02:00039D3A 102C04C0        	  3982:     move.b  ($04C0,A4),D0
02:00039D3E 41EC04C0        	  3983:     lea     ($04C0,A4),A0
02:00039D42 11803000        	  3984:     move.b  D0,(A0,D3.W)
                            	  3985:     ; Copy HP from the first monster slot.
                            	  3986:     ;
02:00039D46 102C0486        	  3987:     move.b  ($0486,A4),D0
02:00039D4A 41EC0486        	  3988:     lea     ($0486,A4),A0
02:00039D4E 11803000        	  3989:     move.b  D0,(A0,D3.W)
                            	  3990:     ; Start with flying speed $80, and in flying state 2.
                            	  3991:     ;
02:00039D52 103C0080        	  3992:     move.b  #$80,D0
02:00039D56 41EC0420        	  3993:     lea     ($0420,A4),A0
02:00039D5A 11803000        	  3994:     move.b  D0,(A0,D3.W)
02:00039D5E 7002            	  3995:     moveq   #2,D0
02:00039D60 41EC0445        	  3996:     lea     ($0445,A4),A0
02:00039D64 11803000        	  3997:     move.b  D0,(A0,D3.W)
02:00039D68 7041            	  3998:     moveq   #65,D0
02:00039D6A 41EC0350        	  3999:     lea     ($0350,A4),A0
02:00039D6E 11803000        	  4000:     move.b  D0,(A0,D3.W)
                            	  4001:     ; Bottom of the loop.
                            	  4002:     ;
02:00039D72 5303            	  4003:     subq.b  #1,D3
02:00039D74 6A90            	  4004:     bpl  _anon_z04_77
                            	  4005:     ; Choose a random 8-way direction for the head segments
                            	  4006:     ; in slots 4 and 9.
                            	  4007:     ;
02:00039D76 102C001D        	  4008:     move.b  ($001D,A4),D0
02:00039D7A 02000007        	  4009:     andi.b #$07,D0
02:00039D7E 7600            	  4010:     moveq   #0,D3
02:00039D80 1600            	  4011:     move.b  D0,D3
02:00039D82 41F90003CA0A    	  4012:     lea     (Directions8).l,A0
02:00039D88 10303000        	  4013:     move.b  (A0,D3.W),D0
02:00039D8C 1940009D        	  4014:     move.b  D0,($009D,A4)
02:00039D90 19400385        	  4015:     move.b  D0,($0385,A4)
02:00039D94 102C0022        	  4016:     move.b  ($0022,A4),D0
02:00039D98 02000007        	  4017:     andi.b #$07,D0
02:00039D9C 7600            	  4018:     moveq   #0,D3
02:00039D9E 1600            	  4019:     move.b  D0,D3
02:00039DA0 41F90003CA0A    	  4020:     lea     (Directions8).l,A0
02:00039DA6 10303000        	  4021:     move.b  (A0,D3.W),D0
02:00039DAA 194000A2        	  4022:     move.b  D0,($00A2,A4)
02:00039DAE 1940038A        	  4023:     move.b  D0,($038A,A4)
                            	  4024:     ; Set minimum number of turns 1 for flying states.
                            	  4025:     ;
                            	  4026:     ; By setting this, the first time that a flight control routine
                            	  4027:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  4028:     ; that flying state will immediately end, and object timer
                            	  4029:     ; will be left 0: ready for moldorm to decide a flying state
                            	  4030:     ; randomly and set timer to $10.
                            	  4031:     ;
02:00039DB2 7001            	  4032:     moveq   #1,D0
02:00039DB4 19400431        	  4033:     move.b  D0,($0431,A4)
02:00039DB8 19400436        	  4034:     move.b  D0,($0436,A4)
02:00039DBC 103C0080        	  4035:     move.b  #$80,D0
02:00039DC0 194004D1        	  4036:     move.b  D0,($04D1,A4)
02:00039DC4 7008            	  4037:     moveq   #8,D0
02:00039DC6 1940034E        	  4038:     move.b  D0,($034E,A4)
02:00039DCA 4E75            	  4039:     rts
                            	  4040: 
