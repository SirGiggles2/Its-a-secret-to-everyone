                            	  8664: 
                            	  8665:     even
                            	  8666: PatraChild_State1:
                            	  8667:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	  8668:     ;
02:0003C07A 10342070        	  8669:     move.b  ($70,A4,D2.W),D0
02:0003C07E 023C00EE        	  8670:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C082 122C046C        	  8671:     move.b  ($046C,A4),D1
02:0003C086 D101            	  8672:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003C088 19802070        	  8673:     move.b  D0,($70,A4,D2.W)
02:0003C08C 41EC0084        	  8674:     lea     ($0084,A4),A0
02:0003C090 10302000        	  8675:     move.b  (A0,D2.W),D0
02:0003C094 023C00EE        	  8676:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C098 122C0479        	  8677:     move.b  ($0479,A4),D1
02:0003C09C D101            	  8678:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003C09E 41EC0084        	  8679:     lea     ($0084,A4),A0
02:0003C0A2 11802000        	  8680:     move.b  D0,(A0,D2.W)
                            	  8681:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  8682:     ;
02:0003C0A6 7000            	  8683:     moveq   #0,D0
02:0003C0A8 1940000B        	  8684:     move.b  D0,($000B,A4)
                            	  8685:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  8686:     ; monster's angle by $70, else by $60 to go slower.
                            	  8687:     ;
02:0003C0AC 7070            	  8688:     moveq   #112,D0
02:0003C0AE 7600            	  8689:     moveq   #0,D3
02:0003C0B0 41EC034F        	  8690:     lea     ($034F,A4),A0
02:0003C0B4 16302000        	  8691:     move.b  (A0,D2.W),D3
02:0003C0B8 0C030025        	  8692:     cmpi.b  #$25,D3
02:0003C0BC 6702            	  8693:     beq  _anon_z04_159
02:0003C0BE 7060            	  8694:     moveq   #96,D0
                            	  8695: _anon_z04_159:
02:0003C0C0 61000CC0        	  8696:     jsr     DecreaseObjectAngle
                            	  8697:     ; Load Patra's maneuver index.
                            	  8698:     ; It determines which counts of bits are looked up below.
                            	  8699:     ;
02:0003C0C4 7600            	  8700:     moveq   #0,D3
02:0003C0C6 162C045F        	  8701:     move.b  ($045F,A4),D3
                            	  8702:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  8703:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  8704:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  8705:     ;
02:0003C0CA 41EC034F        	  8706:     lea     ($034F,A4),A0
02:0003C0CE 10302000        	  8707:     move.b  (A0,D2.W),D0
02:0003C0D2 0C000025        	  8708:     cmpi.b  #$25,D0
02:0003C0D6 661E            	  8709:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003C0D8 41F90003BFCA    	  8710:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003C0DE 10303000        	  8711:     move.b  (A0,D3.W),D0
02:0003C0E2 1B00            	  8712:     move.b  D0,-(A5)  ; PHA
02:0003C0E4 41F90003BFCE    	  8713:     lea     (PatraChild1RotationSineBits).l,A0
02:0003C0EA 10303000        	  8714:     move.b  (A0,D3.W),D0
02:0003C0EE 7600            	  8715:     moveq   #0,D3
02:0003C0F0 1600            	  8716:     move.b  D0,D3
02:0003C0F2 101D            	  8717:     move.b  (A5)+,D0  ; PLA
02:0003C0F4 600E            	  8718:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  8719: 
                            	  8720:     even
                            	  8721: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  8722:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  8723:     ; for both Y and X increment calculations in rotation. This leads to
                            	  8724:     ; a small circle (5) and a large circle (6).
                            	  8725:     ;
02:0003C0F6 41F90003BFCC    	  8726:     lea     (PatraChild2RotationBits).l,A0
02:0003C0FC 10303000        	  8727:     move.b  (A0,D3.W),D0
02:0003C100 7600            	  8728:     moveq   #0,D3
02:0003C102 1600            	  8729:     move.b  D0,D3
                            	  8730:     even
