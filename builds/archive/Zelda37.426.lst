                            	  7765: L17295_Exit:
02:00041962 4E75            	  7766:     rts
                            	  7767: 
                            	  7768: ; Indexed by reverse direction index.
                            	  7769: ;
                            	  7770: ; Is used in mapping a direction to a mask for its axis.
                            	  7771: ; For example:
                            	  7772: ; - right masks off up and down
                            	  7773: ; - up masks off left and right
                            	  7774: ;
                            	  7775:     even
                            	  7776: AxisMasks:
02:00041964 0C              	  7777:     dc.b    $0C, $0C, $03, $03
