                            	  1537: UpdateMonsterArrow:
                            	  1538:     ; Set q-speed $80 (2 pixels a frame).
                            	  1539:     ;
02:00038BC6 103C0080        	  1540:     move.b  #$80,D0
02:00038BCA 41EC03BC        	  1541:     lea     ($03BC,A4),A0
02:00038BCE 11802000        	  1542:     move.b  D0,(A0,D2.W)
                            	  1543:     ; If the timer has not expired, then go draw,
                            	  1544:     ; and see if the shooter's still alive.
                            	  1545:     ;
02:00038BD2 10342028        	  1546:     move.b  ($28,A4,D2.W),D0
02:00038BD6 6626            	  1547:     bne  _L_z04_UpdateMonsterArrow_CheckShooter
                            	  1548:     ; If the arrow is sparking, then go update the base arrow.
                            	  1549:     ;
02:00038BD8 41EC00AC        	  1550:     lea     ($00AC,A4),A0
02:00038BDC 10302000        	  1551:     move.b  (A0,D2.W),D0
02:00038BE0 020000F0        	  1552:     andi.b #$F0,D0
