                            	  3806: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3807:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3808:     ;
                            	  3809:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3810:     ;         or object direction when <> 0.
                            	  3811:     ;
                            	  3812:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3813:     ;
                            	  3814:     ; if slot = 0 and grid offset <> 0 then
                            	  3815:     ;   if input dir = 0 then
                            	  3816:     ;     use 0
                            	  3817:     ;   else
                            	  3818:     ;     use object direction
                            	  3819:     ; else
                            	  3820:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3821:     ;     return
                            	  3822:     ;   else
                            	  3823:     ;     if input dir = 0
                            	  3824:     ;       use 0
                            	  3825:     ;     else
                            	  3826:     ;       use input direction
                            	  3827:     ;
