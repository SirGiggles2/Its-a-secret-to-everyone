                            	  5197:     ; $C0/C1 shows the open mouth face.
                            	  5198:     ;
02:0003A61E 7600            	  5199:     moveq   #0,D3
02:0003A620 16342028        	  5200:     move.b  ($28,A4,D2.W),D3
02:0003A624 0C030020        	  5201:     cmpi.b  #$20,D3
02:0003A628 6404            	  5202:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
