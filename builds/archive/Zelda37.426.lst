                            	 10366: ; Params:
                            	 10367: ; A: high bits of cosine to use in calculating Y increment
                            	 10368: ; Y: high bits of sine to use in calculating X increment
                            	 10369: ; X: object index
                            	 10370: ;
                            	 10371: ; Returns:
                            	 10372: ; A: new Y coordinate of object
                            	 10373: ;
                            	 10374: ; [06] holds the number of high bits of cosine to use
                            	 10375:     even
                            	 10376: RotateObjectLocation:
02:0003CBD2 19400006        	 10377:     move.b  D0,($0006,A4)
02:0003CBD6 19430005        	 10378:     move.b  D3,($0005,A4)
                            	 10379:     ; First, rotate the X coordinate.
                            	 10380:     ;
                            	 10381:     ; Look up the sine for the current angle, and store it in [00].
                            	 10382:     ;
02:0003CBDA 41EC0394        	 10383:     lea     ($0394,A4),A0
02:0003CBDE 10302000        	 10384:     move.b  (A0,D2.W),D0
02:0003CBE2 0200000F        	 10385:     andi.b #$0F,D0
02:0003CBE6 7600            	 10386:     moveq   #0,D3
02:0003CBE8 1600            	 10387:     move.b  D0,D3
02:0003CBEA 41F90003CBC2    	 10388:     lea     (PatraSines).l,A0
02:0003CBF0 10303000        	 10389:     move.b  (A0,D3.W),D0
02:0003CBF4 1880            	 10390:     move.b  D0,($0000,A4)
                            	 10391:     ; Mutliply q-speed by [00].
                            	 10392:     ;
                            	 10393:     ; Q-speed has the default value $20 set when entering the room.
                            	 10394:     ;
02:0003CBF6 41EC03BC        	 10395:     lea     ($03BC,A4),A0
02:0003CBFA 10302000        	 10396:     move.b  (A0,D2.W),D0
02:0003CBFE 7600            	 10397:     moveq   #0,D3
02:0003CC00 162C0005        	 10398:     move.b  ($0005,A4),D3
02:0003CC04 61000136        	 10399:     jsr     ShiftMultiply
                            	 10400:     ; The absolute X increment for the current angle is now in [02:03].
                            	 10401:     ;
                            	 10402:     ; If angle >= $10, then the monster is in the top half of circle going left.
                            	 10403:     ;
02:0003CC08 41EC0394        	 10404:     lea     ($0394,A4),A0
02:0003CC0C 10302000        	 10405:     move.b  (A0,D2.W),D0
02:0003CC10 02000018        	 10406:     andi.b #$18,D0
02:0003CC14 0C000010        	 10407:     cmpi.b  #$10,D0
02:0003CC18 6536            	 10408:     bcs  _L_z04_RotateObjectLocation_AddToX
                            	 10409:     ; Subtract the product's fraction from the X coordinate fraction.
                            	 10410:     ;
02:0003CC1A 41EC0412        	 10411:     lea     ($0412,A4),A0
02:0003CC1E 10302000        	 10412:     move.b  (A0,D2.W),D0
