02:000354C8 D8BC00FF0000    	  5081:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000354CE 2044            	  5082:     movea.l D4,A0
02:000354D0 10303000        	  5083:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000354D4 7400            	  5084:     moveq   #0,D2
