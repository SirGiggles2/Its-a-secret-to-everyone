02:0003A300 10302000        	  4792:     move.b  (A0,D2.W),D0
02:0003A304 122C0002        	  4793:     move.b  ($0002,A4),D1
02:0003A308 E309            	  4794:     lsl.b  #1,D1   ; ASL $02
02:0003A30A 19410002        	  4795:     move.b  D1,($0002,A4)
02:0003A30E 122C0002        	  4796:     move.b  ($0002,A4),D1
02:0003A312 C200            	  4797:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
