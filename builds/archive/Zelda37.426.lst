                            	  4171: Moldorm_Chase:
                            	  4172:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  4173:     ; Only the head controls the movement direction.
                            	  4174:     ;
02:00039ED0 0C020005        	  4175:     cmpi.b  #$05,D2
02:00039ED4 670A            	  4176:     beq  _anon_z04_81
02:00039ED6 0C02000A        	  4177:     cmpi.b  #$0A,D2
