                            	  3543: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3544:     ; Loop to look for a place to spawn a monster from the edge
                            	  3545:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3546:     ;
                            	  3547:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3548:     ; We'll move down $10 pixels.
                            	  3549:     ;
02:0003EB2C 7610            	  3550:     moveq   #16,D3
02:0003EB2E 102C000A        	  3551:     move.b  ($000A,A4),D0
02:0003EB32 0200000F        	  3552:     andi.b #$0F,D0
02:0003EB36 670A            	  3553:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3554:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3555:     ; Don't move vertically.
                            	  3556:     ;
02:0003EB38 163C00F0        	  3557:     move.b  #$F0,D3
02:0003EB3C 0C00000F        	  3558:     cmpi.b  #$0F,D0
02:0003EB40 6610            	  3559:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3560:     even
                            	  3561: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3562:     ; Else low nibble = $F. We're at the right edge,
                            	  3563:     ; and we'll move up $10 pixels.
                            	  3564:     ;
02:0003EB42 1003            	  3565:     move.b  D3,D0
02:0003EB44 023C00EE        	  3566:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EB48 122C000A        	  3567:     move.b  ($000A,A4),D1
02:0003EB4C D101            	  3568:     addx.b  D1,D0   ; ADC $0A
02:0003EB4E 1940000A        	  3569:     move.b  D0,($000A,A4)
                            	  3570:     even
                            	  3571: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3572:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3573:     ; Move right one pixel.
                            	  3574:     ;
02:0003EB52 102C000A        	  3575:     move.b  ($000A,A4),D0
02:0003EB56 020000F0        	  3576:     andi.b #$F0,D0
02:0003EB5A 0C0000E0        	  3577:     cmpi.b  #$E0,D0
02:0003EB5E 6606            	  3578:     bne  _anon_z05_88
02:0003EB60 522C000A        	  3579:     addq.b  #1,($000A,A4)
02:0003EB64 600A            	  3580:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3581: 
                            	  3582: _anon_z05_88:
                            	  3583:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3584:     ; Dont' move horizontally.
                            	  3585:     ;
02:0003EB66 0C000040        	  3586:     cmpi.b  #$40,D0
02:0003EB6A 6604            	  3587:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3588:     ; Else high nibble = 4. We're at the top edge.
                            	  3589:     ; Move left 1 pixel.
                            	  3590:     ;
02:0003EB6C 532C000A        	  3591:     subq.b  #1,($000A,A4)
                            	  3592:     even
                            	  3593: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3594:     ; Time to get the address of the column.
                            	  3595:     ; Starting at the top of the leftmost column.
                            	  3596:     ;
