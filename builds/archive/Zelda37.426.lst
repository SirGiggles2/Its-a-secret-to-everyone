                            	  4236: _anon_z04_82:
                            	  4237:     ; Turn randomly while flying, as usual.
                            	  4238:     ;
02:00039F12 61002C4C        	  4239:     jsr     Flyer_Wander
                            	  4240:     ; After every turn, the common flyer routines set timer to $10.
                            	  4241:     ; This can be used as a signal for moldorm to propagate
                            	  4242:     ; direction changes down the chain.
                            	  4243:     ;
                            	  4244:     ; Between each turn, timer <> $10.
                            	  4245:     ;
                            	  4246:     ; At the end of the delay after the last turn, timer = 0.
                            	  4247:     ; This is a signal that that flying state ended, and a new one
                            	  4248:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  4249:     ; we can propagate direction changes again; and start
                            	  4250:     ; a new flying interval by setting timer to $10. This will make
                            	  4251:     ; the next flying state delay that amount of time before turning
                            	  4252:     ; the first time.
                            	  4253:     ;
                            	  4254:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  4255:     ; arm the timer again, and shift directions down the chain.
                            	  4256:     ;
02:00039F16 10342028        	  4257:     move.b  ($28,A4,D2.W),D0
02:00039F1A 6602            	  4258:     bne.s  __far_z_04_0035
02:00039F1C 60CE            	  4259:     jmp  Moldorm_ChangeFlyingState
