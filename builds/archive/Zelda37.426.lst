02:00039276 522C000D        	  2444:     addq.b  #1,($000D,A4)
                            	  2445:     ; If right is a component of the direction, then go set horizontal
                            	  2446:     ; flipping. Else leave horizontal flipping = 0.
                            	  2447:     ;
02:0003927A 41EC0098        	  2448:     lea     ($0098,A4),A0
02:0003927E 10302000        	  2449:     move.b  (A0,D2.W),D0
02:00039282 02000001        	  2450:     andi.b #$01,D0
02:00039286 6714            	  2451:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
