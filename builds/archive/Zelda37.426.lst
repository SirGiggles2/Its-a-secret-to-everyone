02:000391EE 41EC03E4        	  2367:     lea     ($03E4,A4),A0
02:000391F2 12302000        	  2368:     move.b  (A0,D2.W),D1
02:000391F6 D101            	  2369:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
