02:0002D104 1203            	  5106:     move.b  D3,D1
02:0002D106 0281000000FF    	  5107:     andi.l  #$FF,D1
02:0002D10C 2F01            	  5108:     move.l  D1,-(SP)              ; arg2 init_major_min
