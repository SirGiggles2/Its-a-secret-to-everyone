02:00038A88 0C00008D        	  1308:     cmpi.b  #$8D,D0
02:00038A8C 6512            	  1309:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A8E 0C000099        	  1310:     cmpi.b  #$99,D0
02:00038A92 640C            	  1311:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
