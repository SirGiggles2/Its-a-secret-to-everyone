                            	  2859: PondFairy_MoveHearts:
                            	  2860:     ; Loop over each heart from object slot 2 to 9.
                            	  2861:     ;
                            	  2862:     ; Even though they are not standalone objects, their info
                            	  2863:     ; is stored in those object slots.
                            	  2864:     ;
