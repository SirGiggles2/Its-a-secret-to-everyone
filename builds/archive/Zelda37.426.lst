                            	  5266: UpdateDodongoState0_Move:
                            	  5267:     ; If facing left, then push X offset 0 on the stack.
                            	  5268:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  5269:     ;
                            	  5270:     ; We would like to use one set of coordinates only.
                            	  5271:     ; But movement would break down, if we did; because
                            	  5272:     ; Dodongo is so long.
                            	  5273:     ;
                            	  5274:     ; So, when not facing left, we temporarily shift the
                            	  5275:     ; X coordinate to be closer to the other side of the monster.
                            	  5276:     ;
02:0003A6A4 7600            	  5277:     moveq   #0,D3
02:0003A6A6 41EC0098        	  5278:     lea     ($0098,A4),A0
02:0003A6AA 10302000        	  5279:     move.b  (A0,D2.W),D0
02:0003A6AE 0200000D        	  5280:     andi.b #$0D,D0
02:0003A6B2 6716            	  5281:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003A6B4 10342070        	  5282:     move.b  ($70,A4,D2.W),D0
02:0003A6B8 023C00EE        	  5283:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A6BC 123C0010        	  5284:     move.b  #$10,D1
02:0003A6C0 D101            	  5285:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A6C2 19802070        	  5286:     move.b  D0,($70,A4,D2.W)
02:0003A6C6 163C00F0        	  5287:     move.b  #$F0,D3
                            	  5288:     even
                            	  5289: _L_z04_UpdateDodongoState0_Move_Move:
02:0003A6CA 1003            	  5290:     move.b  D3,D0
02:0003A6CC 1B00            	  5291:     move.b  D0,-(A5)  ; PHA
02:0003A6CE 7020            	  5292:     moveq   #32,D0
02:0003A6D0 41EC041F        	  5293:     lea     ($041F,A4),A0
02:0003A6D4 11802000        	  5294:     move.b  D0,(A0,D2.W)
02:0003A6D8 6100DC06        	  5295:     jsr     Wanderer_TargetPlayer
                            	  5296:     ; Pop the offset and add it to the X coordinate.
                            	  5297:     ;
                            	  5298:     ; This brings the X coordinate back to the unique value
                            	  5299:     ; that represents the position.
                            	  5300:     ;
02:0003A6DC 101D            	  5301:     move.b  (A5)+,D0  ; PLA
02:0003A6DE 023C00EE        	  5302:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A6E2 12342070        	  5303:     move.b  ($70,A4,D2.W),D1
02:0003A6E6 D101            	  5304:     addx.b  D1,D0   ; ADC ObjX,X
02:0003A6E8 19802070        	  5305:     move.b  D0,($70,A4,D2.W)
                            	  5306:     ; If X coordinate < $20, then face right.
                            	  5307:     ;
02:0003A6EC 0C000020        	  5308:     cmpi.b  #$20,D0
02:0003A6F0 640A            	  5309:     bcc  _anon_z04_89
02:0003A6F2 7001            	  5310:     moveq   #1,D0
02:0003A6F4 41EC0098        	  5311:     lea     ($0098,A4),A0
02:0003A6F8 11802000        	  5312:     move.b  D0,(A0,D2.W)
