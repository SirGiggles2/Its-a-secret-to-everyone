02:00047B38 19400002        	  2335:     move.b  D0,($0002,A4)
02:00047B3C 4EB900030A8C    	  2336:     jsr     MapScreenPosToPpuAddr
02:00047B42 7400            	  2337:     moveq   #0,D2
02:00047B44 142C0301        	  2338:     move.b  ($0301,A4),D2
                            	  2339:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2340:     ;
                            	  2341:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2342:     ; In total, 11 bytes will be written.
                            	  2343:     ;
                            	  2344:     ; First, write the high byte of PPU address in each record.
                            	  2345:     ;
02:00047B48 1014            	  2346:     move.b  ($0000,A4),D0
02:00047B4A 41EC0302        	  2347:     lea     ($0302,A4),A0
02:00047B4E 11802000        	  2348:     move.b  D0,(A0,D2.W)
02:00047B52 41EC0307        	  2349:     lea     ($0307,A4),A0
02:00047B56 11802000        	  2350:     move.b  D0,(A0,D2.W)
                            	  2351:     ; Write the low address in the first record. In the second record,
                            	  2352:     ; write (low address + 1).
                            	  2353:     ;
02:00047B5A 102C0001        	  2354:     move.b  ($0001,A4),D0
02:00047B5E 41EC0303        	  2355:     lea     ($0303,A4),A0
02:00047B62 11802000        	  2356:     move.b  D0,(A0,D2.W)
02:00047B66 41EC0308        	  2357:     lea     ($0308,A4),A0
02:00047B6A 11802000        	  2358:     move.b  D0,(A0,D2.W)
02:00047B6E 41EC0308        	  2359:     lea     ($0308,A4),A0
02:00047B72 52302000        	  2360:     addq.b  #1,(A0,D2.W)
                            	  2361:     ; Write the first tile twice in each record. Patch them later.
                            	  2362:     ;
02:00047B76 102C0005        	  2363:     move.b  ($0005,A4),D0
02:00047B7A 41EC0305        	  2364:     lea     ($0305,A4),A0
02:00047B7E 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:00047B82 41EC0306        	  2366:     lea     ($0306,A4),A0
02:00047B86 11802000        	  2367:     move.b  D0,(A0,D2.W)
02:00047B8A 41EC030A        	  2368:     lea     ($030A,A4),A0
02:00047B8E 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:00047B92 41EC030B        	  2370:     lea     ($030B,A4),A0
02:00047B96 11802000        	  2371:     move.b  D0,(A0,D2.W)
                            	  2372:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2373:     ; Add 1 more to the second byte in each record.
                            	  2374:     ; Here is an example result of this manipulation:
                            	  2375:     ;   record 1: $70, $71
                            	  2376:     ;   record 2: $72, $73
                            	  2377:     ;
02:00047B9A 0C000046        	  2378:     cmpi.b  #$46,D0
02:00047B9E 6530            	  2379:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047BA0 0C0000F3        	  2380:     cmpi.b  #$F3,D0
02:00047BA4 642A            	  2381:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047BA6 023C00EE        	  2382:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047BAA 123C0002        	  2383:     move.b  #$02,D1
02:00047BAE D101            	  2384:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00047BB0 41EC030A        	  2385:     lea     ($030A,A4),A0
02:00047BB4 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:00047BB8 41EC030B        	  2387:     lea     ($030B,A4),A0
02:00047BBC 11802000        	  2388:     move.b  D0,(A0,D2.W)
02:00047BC0 41EC0306        	  2389:     lea     ($0306,A4),A0
02:00047BC4 52302000        	  2390:     addq.b  #1,(A0,D2.W)
02:00047BC8 41EC030B        	  2391:     lea     ($030B,A4),A0
02:00047BCC 52302000        	  2392:     addq.b  #1,(A0,D2.W)
