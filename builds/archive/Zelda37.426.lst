02:00039264 1940000D        	  2432:     move.b  D0,($000D,A4)
                            	  2433:     ; If the direction has an "up" component, then keep the
                            	  2434:     ; frame image 0, and go figure out horizontal flipping.
                            	  2435:     ;
02:00039268 41EC0098        	  2436:     lea     ($0098,A4),A0
02:0003926C 10302000        	  2437:     move.b  (A0,D2.W),D0
02:00039270 02000008        	  2438:     andi.b #$08,D0
