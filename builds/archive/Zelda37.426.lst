02:0003B5A4 10342019        	  7239:     move.b  ($19,A4,D2.W),D0
02:0003B5A8 0C0000E0        	  7240:     cmpi.b  #$E0,D0
02:0003B5AC 650C            	  7241:     bcs  _L_z04_UpdateManhandla_Draw
02:0003B5AE 102C0356        	  7242:     move.b  ($0356,A4),D0
