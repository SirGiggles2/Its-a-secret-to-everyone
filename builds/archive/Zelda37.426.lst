02:00049D48 023C00EE        	  7092:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049D4C 123C0001        	  7093:     move.b  #$01,D1
02:00049D50 D101            	  7094:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00049D52 0C00000A        	  7095:     cmpi.b  #$0A,D0
