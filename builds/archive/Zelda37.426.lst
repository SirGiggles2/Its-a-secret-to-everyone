02:000393A8 6008            	  2653:     jmp  L_EndInitFlyingGhini
                            	  2654: __far_z_04_0023:
02:000393AA 6158            	  2655:     jsr     DrawArmosAndCheckCollisions
                            	  2656: _anon_z04_53:
02:000393AC 0A3C0001        	  2657:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000393B0 4E75            	  2658:     rts
                            	  2659: 
