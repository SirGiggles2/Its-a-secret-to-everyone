02:0003EB74 7005            	  3598:     moveq   #5,D0
02:0003EB76 4EB90002A9FA    	  3599:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3600:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3601:     ; in order to point to the column we want.
                            	  3602:     ;
02:0003EB7C 102C000A        	  3603:     move.b  ($000A,A4),D0
02:0003EB80 0200000F        	  3604:     andi.b #$0F,D0
02:0003EB84 7600            	  3605:     moveq   #0,D3
02:0003EB86 1600            	  3606:     move.b  D0,D3
02:0003EB88 670C            	  3607:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3608: _anon_z05_89:
