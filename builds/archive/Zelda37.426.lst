                            	  4054: UpdateMoldorm:
                            	  4055:     ; If facing direction = 0, return.
                            	  4056:     ;
02:00039DE4 41EC0098        	  4057:     lea     ($0098,A4),A0
02:00039DE8 10302000        	  4058:     move.b  (A0,D2.W),D0
02:00039DEC 670000C2        	  4059:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4060:     ; If the magic clock is missing, then move around (using the flying mechanism).
                            	  4061:     ;
02:00039DF0 102C066C        	  4062:     move.b  ($066C,A4),D0
02:00039DF4 6608            	  4063:     bne  _anon_z04_79
02:00039DF6 610000BA        	  4064:     jsr     ControlMoldormFlight
02:00039DFA 61002C36        	  4065:     jsr     MoveFlyer
                            	  4066: _anon_z04_79:
                            	  4067:     ; Draw with sprite attributes: normal, red palette row
                            	  4068:     ;
02:00039DFE 7002            	  4069:     moveq   #2,D0
02:00039E00 19400003        	  4070:     move.b  D0,($0003,A4)
02:00039E04 7044            	  4071:     moveq   #68,D0
02:00039E06 4EB900030FE6    	  4072:     jsr     Anim_WriteSprite
                            	  4073:     ; Check collisions, but never let them interfere with movement.
                            	  4074:     ;
02:00039E0C 41EC0098        	  4075:     lea     ($0098,A4),A0
02:00039E10 10302000        	  4076:     move.b  (A0,D2.W),D0
02:00039E14 1B00            	  4077:     move.b  D0,-(A5)  ; PHA
02:00039E16 10342028        	  4078:     move.b  ($28,A4,D2.W),D0
02:00039E1A 1B00            	  4079:     move.b  D0,-(A5)  ; PHA
02:00039E1C 4EB900031056    	  4080:     jsr     CheckMonsterCollisions
02:00039E22 101D            	  4081:     move.b  (A5)+,D0  ; PLA
02:00039E24 19802028        	  4082:     move.b  D0,($28,A4,D2.W)
02:00039E28 101D            	  4083:     move.b  (A5)+,D0  ; PLA
02:00039E2A 41EC0098        	  4084:     lea     ($0098,A4),A0
02:00039E2E 11802000        	  4085:     move.b  D0,(A0,D2.W)
                            	  4086:     ; If this segment is still alive, then return.
                            	  4087:     ;
02:00039E32 41EC0405        	  4088:     lea     ($0405,A4),A0
02:00039E36 10302000        	  4089:     move.b  (A0,D2.W),D0
02:00039E3A 6774            	  4090:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4091:     ; This segment is dead. We'll swap the tail segment with this
                            	  4092:     ; dead segment. This way, moldorm heads are always rooted
                            	  4093:     ; in slots 5 and $A; and the segments are continguous.
                            	  4094:     ;
                            	  4095:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  4096:     ;
                            	  4097:     ; Note that this is not a true swap, because the tail's HP
                            	  4098:     ; might be less than $20.
                            	  4099:     ;
02:00039E3C 7020            	  4100:     moveq   #32,D0
02:00039E3E 41EC0485        	  4101:     lea     ($0485,A4),A0
02:00039E42 11802000        	  4102:     move.b  D0,(A0,D2.W)
02:00039E46 61000608        	  4103:     jsr     CheckBossHitReaction
                            	  4104:     ; Look for the tail segment, starting from the low end
                            	  4105:     ; of the chain that this dead segment belongs to.
                            	  4106:     ;
02:00039E4A 163C00FF        	  4107:     move.b  #$FF,D3
02:00039E4E 0C020006        	  4108:     cmpi.b  #$06,D2
02:00039E52 6502            	  4109:     bcs  _anon_z04_80
02:00039E54 7604            	  4110:     moveq   #4,D3
                            	  4111: _anon_z04_80:
02:00039E56 5203            	  4112:     addq.b  #1,D3
02:00039E58 41EC0350        	  4113:     lea     ($0350,A4),A0
02:00039E5C 10303000        	  4114:     move.b  (A0,D3.W),D0
02:00039E60 0C000041        	  4115:     cmpi.b  #$41,D0
02:00039E64 66F0            	  4116:     bne  _anon_z04_80
                            	  4117:     ; I don't know why the object timer of the tail segment that will
                            	  4118:     ; be made dead is set to $11. By setting its object type to $5D
                            	  4119:     ; below, its metastate will become $10 -- dying/dead. From
                            	  4120:     ; there, the object timer is set to 6.
                            	  4121:     ;
02:00039E66 7011            	  4122:     moveq   #17,D0
02:00039E68 19803029        	  4123:     move.b  D0,($29,A4,D3.W)
                            	  4124:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  4125:     ; segment to the tail segment.
                            	  4126:     ;
02:00039E6C 41EC04F0        	  4127:     lea     ($04F0,A4),A0
02:00039E70 10302000        	  4128:     move.b  (A0,D2.W),D0
02:00039E74 41EC04F1        	  4129:     lea     ($04F1,A4),A0
02:00039E78 11803000        	  4130:     move.b  D0,(A0,D3.W)
02:00039E7C 10342070        	  4131:     move.b  ($70,A4,D2.W),D0
02:00039E80 19803071        	  4132:     move.b  D0,($71,A4,D3.W)
02:00039E84 41EC0084        	  4133:     lea     ($0084,A4),A0
02:00039E88 10302000        	  4134:     move.b  (A0,D2.W),D0
02:00039E8C 41EC0085        	  4135:     lea     ($0085,A4),A0
02:00039E90 11803000        	  4136:     move.b  D0,(A0,D3.W)
                            	  4137:     ; If the tail segment found is also a head, then
                            	  4138:     ; the last segment has died. Return.
                            	  4139:     ;
02:00039E94 0C030004        	  4140:     cmpi.b  #$04,D3
02:00039E98 6716            	  4141:     beq  _L_z04_UpdateMoldorm_Exit
02:00039E9A 0C030009        	  4142:     cmpi.b  #$09,D3
02:00039E9E 6710            	  4143:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4144:     ; Else finish swapping the segments.
                            	  4145:     ; Set the tail segment's type to the dead dummy object.
                            	  4146:     ;
02:00039EA0 705D            	  4147:     moveq   #93,D0
02:00039EA2 41EC0350        	  4148:     lea     ($0350,A4),A0
02:00039EA6 11803000        	  4149:     move.b  D0,(A0,D3.W)
                            	  4150:     ; Reset the metastate of the current segment, so that it comes
                            	  4151:     ; back to life.
                            	  4152:     ;
02:00039EAA 4EB90004A1E4    	  4153:     jsr     ResetObjMetastate
                            	  4154:     even
