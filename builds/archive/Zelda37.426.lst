                            	  6097: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  6098:     ; If the teleporting distance remaining is even, then draw
                            	  6099:     ; and check collisions, else return.
                            	  6100:     ;
                            	  6101:     ; This means that when 0, the monster is walking.
                            	  6102:     ; So, draw and check collisions every frame.
                            	  6103:     ;
                            	  6104:     ; When not 0, the monster is teleporting, and must be drawn
                            	  6105:     ; translucently -- every other frame.
                            	  6106:     ;
02:0003AD3E 41EC0394        	  6107:     lea     ($0394,A4),A0
02:0003AD42 10302000        	  6108:     move.b  (A0,D2.W),D0
02:0003AD46 E208            	  6109:     lsr.b  #1,D0   ; LSR A
02:0003AD48 6402            	  6110:     bcc.s  __far_z_04_0056
02:0003AD4A 603A            	  6111:     jmp  L11E17_Exit
