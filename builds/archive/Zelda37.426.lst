                            	  7125: InitObject:
02:00049D98 7400            	  7126:     moveq   #0,D2
02:00049D9A 142C0340        	  7127:     move.b  ($0340,A4),D2
                            	  7128:     ; We want to handle "enemies from the edges of the screen".
                            	  7129:     ;
                            	  7130:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7131:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7132:     ; that does not spawn with a cloud (type >= $53);
                            	  7133:     ; 
                            	  7134:     ; then go initialize the object.
                            	  7135:     ;
02:00049D9E 102C0010        	  7136:     move.b  ($0010,A4),D0
02:00049DA2 66000196        	  7137:     bne  _L_z07_InitObject_NormalSpawn
02:00049DA6 102C04CD        	  7138:     move.b  ($04CD,A4),D0
02:00049DAA 02000008        	  7139:     andi.b #$08,D0
02:00049DAE 6700018A        	  7140:     beq  _L_z07_InitObject_NormalSpawn
02:00049DB2 41EC034F        	  7141:     lea     ($034F,A4),A0
02:00049DB6 10302000        	  7142:     move.b  (A0,D2.W),D0
02:00049DBA 0C000011        	  7143:     cmpi.b  #$11,D0
02:00049DBE 6700017A        	  7144:     beq  _L_z07_InitObject_NormalSpawn
02:00049DC2 0C000040        	  7145:     cmpi.b  #$40,D0
02:00049DC6 67000172        	  7146:     beq  _L_z07_InitObject_NormalSpawn
02:00049DCA 0C00001E        	  7147:     cmpi.b  #$1E,D0
02:00049DCE 6700016A        	  7148:     beq  _L_z07_InitObject_NormalSpawn
02:00049DD2 0C00002E        	  7149:     cmpi.b  #$2E,D0
02:00049DD6 67000162        	  7150:     beq  _L_z07_InitObject_NormalSpawn
02:00049DDA 0C000053        	  7151:     cmpi.b  #$53,D0
02:00049DDE 6400015A        	  7152:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7153:     even
                            	  7154: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7155:     ; If the "monsters from edges" long timer expired, then
                            	  7156:     ; go bring the monster in.
                            	  7157:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7158:     ;
                            	  7159:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7160:     ; residual position so enemies keep their previous-room
                            	  7161:     ; positions instead of being re-edge-spawned (matches NES).
02:00049DE2 102C004B        	  7162:     move.b  ($004B,A4),D0
02:00049DE6 662E            	  7163:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7164:     ; timer == 0. Check for fresh room-entry + residual position.
02:00049DE8 102C000F        	  7165:     move.b  ($000F,A4),D0
02:00049DEC 0C0000FF        	  7166:     cmpi.b  #$FF,D0
02:00049DF0 662E            	  7167:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:00049DF2 41EC0070        	  7168:     lea     ($0070,A4),A0
02:00049DF6 10302000        	  7169:     move.b  (A0,D2.W),D0
02:00049DFA 660A            	  7170:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:00049DFC 41EC0084        	  7171:     lea     ($0084,A4),A0
02:00049E00 10302000        	  7172:     move.b  (A0,D2.W),D0
02:00049E04 671A            	  7173:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7174:     even
                            	  7175: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:00049E06 7001            	  7176:     moveq   #1,D0
02:00049E08 1940004B        	  7177:     move.b  D0,($004B,A4)
02:00049E0C 41EC0492        	  7178:     lea     ($0492,A4),A0
02:00049E10 11802000        	  7179:     move.b  D0,(A0,D2.W)
02:00049E14 4E75            	  7180:     rts
                            	  7181:     even
                            	  7182: _L_z07_InitObject_UninitMonsterFromEdge_Gate:
02:00049E16 41EC0492        	  7183:     lea     ($0492,A4),A0
02:00049E1A 11802000        	  7184:     move.b  D0,(A0,D2.W)
02:00049E1E 4E75            	  7185:     rts
