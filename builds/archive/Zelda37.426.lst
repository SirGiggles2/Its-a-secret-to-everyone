02:0002F1E0 102C001A        	   431:     move.b  ($001A,A4),D0
02:0002F1E4 02000002        	   432:     andi.b #$02,D0
02:0002F1E8 6702            	   433:     beq  _anon_z01_1
02:0002F1EA 7632            	   434:     moveq   #50,D3
