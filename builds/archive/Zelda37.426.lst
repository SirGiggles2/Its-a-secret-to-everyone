02:00038A62 E308            	  1291:     lsl.b  #1,D0   ; ASL A
02:00038A64 E308            	  1292:     lsl.b  #1,D0   ; ASL A
02:00038A66 E308            	  1293:     lsl.b  #1,D0   ; ASL A
02:00038A68 E308            	  1294:     lsl.b  #1,D0   ; ASL A
02:00038A6A 0C000050        	  1295:     cmpi.b  #$50,D0
02:00038A6E 6530            	  1296:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A70 0C0000E0        	  1297:     cmpi.b  #$E0,D0
02:00038A74 642A            	  1298:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1299:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1300:     ;
02:00038A76 0000000D        	  1301:     ori.b #$0D,D0
02:00038A7A 41EC0084        	  1302:     lea     ($0084,A4),A0
02:00038A7E 11802000        	  1303:     move.b  D0,(A0,D2.W)
