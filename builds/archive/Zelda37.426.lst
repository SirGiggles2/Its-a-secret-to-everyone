02:00038A4A 10343018        	  1281:     move.b  ($18,A4,D3.W),D0
02:00038A4E 020000F0        	  1282:     andi.b #$F0,D0
02:00038A52 19802070        	  1283:     move.b  D0,($70,A4,D2.W)
02:00038A56 6748            	  1284:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A58 0C0000F0        	  1285:     cmpi.b  #$F0,D0
02:00038A5C 6742            	  1286:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1287:     ; Turn the random value into a $10 pixel aligned Y coordinate.
