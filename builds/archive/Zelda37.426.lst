                            	  6075:     even
                            	  6076: _L_z07_SetUpWeaponWithState_ChooseSpeed:
                            	  6077:     ; If high bit of state is set, use $A0 else $C0 for the q-speed fraction.
                            	  6078:     ;
                            	  6079:     ; The high bit is set for magic shot, and reset for sword shot.
                            	  6080:     ;
02:00049568 163C00C0        	  6081:     move.b  #$C0,D3
02:0004956C 41EC00AC        	  6082:     lea     ($00AC,A4),A0
02:00049570 10302000        	  6083:     move.b  (A0,D2.W),D0
02:00049574 E308            	  6084:     lsl.b  #1,D0   ; ASL A
02:00049576 6404            	  6085:     bcc  _anon_z07_35
02:00049578 163C00A0        	  6086:     move.b  #$A0,D3
                            	  6087: _anon_z07_35:
02:0004957C 1003            	  6088:     move.b  D3,D0
02:0004957E 41EC03BC        	  6089:     lea     ($03BC,A4),A0
02:00049582 11802000        	  6090:     move.b  D0,(A0,D2.W)
                            	  6091:     ; Set the shot object's grid offset the same as the player's.
