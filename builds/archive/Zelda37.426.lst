                            	  5692: CalcBoomerangFrame:
                            	  5693:     ; The minor state (low 3 bits of state) is used to
                            	  5694:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5695:     ;
                            	  5696:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5697:     ; In other words, don't offset the coordinate below.
                            	  5698:     ;
02:00049288 7000            	  5699:     moveq   #0,D0
02:0004928A 1880            	  5700:     move.b  D0,($0000,A4)
02:0004928C 41EC00AC        	  5701:     lea     ($00AC,A4),A0
