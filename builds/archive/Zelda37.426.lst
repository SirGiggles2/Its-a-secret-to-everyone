                            	  5604: UpdatePolsVoice:
02:0003A91A 0C020001        	  5605:     cmpi.b  #$01,D2
                            	  5606:     bne  _anon_z04_96
                            	  5607: _anon_z04_96:
                            	  5608:     ; If we have the magic clock, or is stunned, then
                            	  5609:     ; go draw and check collisions.
                            	  5610:     ;
02:0003A91E 102C066C        	  5611:     move.b  ($066C,A4),D0
02:0003A922 1234203D        	  5612:     move.b  ($3D,A4,D2.W),D1
02:0003A926 8001            	  5613:     or.b  D1,D0
02:0003A928 660000AE        	  5614:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5615:     ; Every odd screen frame, go straight to drawing
                            	  5616:     ; and checking collisions.
                            	  5617:     ;
02:0003A92C 102C0015        	  5618:     move.b  ($0015,A4),D0
02:0003A930 E208            	  5619:     lsr.b  #1,D0   ; LSR A
02:0003A932 6404            	  5620:     bcc.s  __far_z_04_0053
02:0003A934 60000118        	  5621:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5622: __far_z_04_0053:
                            	  5623:     ; Otherwise move horizontally.
                            	  5624:     ;
02:0003A938 61000248        	  5625:     jsr     PolsVoice_MoveX
                            	  5626:     ; If state <> 0, then the monster is jumping.
                            	  5627:     ; Go handle vertical movement.
                            	  5628:     ;
02:0003A93C 41EC00AC        	  5629:     lea     ($00AC,A4),A0
02:0003A940 10302000        	  5630:     move.b  (A0,D2.W),D0
02:0003A944 6706            	  5631:     beq  _L_z04_UpdatePolsVoice_State0
02:0003A946 61000130        	  5632:     jsr     UpdatePolsVoiceState1_Jumping
02:0003A94A 6034            	  5633:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  5634: 
                            	  5635:     even
                            	  5636: _L_z04_UpdatePolsVoice_State0:
                            	  5637:     ; State 0. Walking.
                            	  5638:     ;
                            	  5639:     ; If grid offset = 0, then no more distance to cover.
                            	  5640:     ; So, go change to state 1 -- jumping.
                            	  5641:     ;
02:0003A94C 41EC0394        	  5642:     lea     ($0394,A4),A0
02:0003A950 10302000        	  5643:     move.b  (A0,D2.W),D0
02:0003A954 67000084        	  5644:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5645:     ; Decrement grid offset / distance remaining.
                            	  5646:     ;
02:0003A958 41EC0394        	  5647:     lea     ($0394,A4),A0
02:0003A95C 53302000        	  5648:     subq.b  #1,(A0,D2.W)
                            	  5649:     ; Move vertically.
                            	  5650:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5651:     ;
02:0003A960 41EC0084        	  5652:     lea     ($0084,A4),A0
02:0003A964 10302000        	  5653:     move.b  (A0,D2.W),D0
02:0003A968 023C00EE        	  5654:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A96C 41F90003A8FC    	  5655:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003A972 12303000        	  5656:     move.b  (A0,D3.W),D1
02:0003A976 D101            	  5657:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003A978 41EC0084        	  5658:     lea     ($0084,A4),A0
02:0003A97C 11802000        	  5659:     move.b  D0,(A0,D2.W)
                            	  5660:     even
                            	  5661: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5662:     ; If the square the monster is over is walkable, then
                            	  5663:     ; go draw and check object collisions.
                            	  5664:     ;
02:0003A980 610001F4        	  5665:     jsr     PolsVoice_IsSquareWalkable
02:0003A984 6452            	  5666:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5667:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5668:     ; then go change to state 1.
                            	  5669:     ;
02:0003A986 41EC041F        	  5670:     lea     ($041F,A4),A0
02:0003A98A 10302000        	  5671:     move.b  (A0,D2.W),D0
02:0003A98E 020000FC        	  5672:     andi.b #$FC,D0
02:0003A992 0C0000B0        	  5673:     cmpi.b  #$B0,D0
02:0003A996 6742            	  5674:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003A998 0C0000F4        	  5675:     cmpi.b  #$F4,D0
02:0003A99C 643C            	  5676:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5677:     ; Else blocked by something else.
                            	  5678:     ;
                            	  5679:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  5680:     ;
02:0003A99E 41EC0098        	  5681:     lea     ($0098,A4),A0
02:0003A9A2 10302000        	  5682:     move.b  (A0,D2.W),D0
02:0003A9A6 02000003        	  5683:     andi.b #$03,D0
02:0003A9AA 6618            	  5684:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  5685:     ; Else facing vertically. Flip the direction.
                            	  5686:     ; Go draw.
                            	  5687:     ;
02:0003A9AC 41EC0098        	  5688:     lea     ($0098,A4),A0
02:0003A9B0 10302000        	  5689:     move.b  (A0,D2.W),D0
02:0003A9B4 0A00000C        	  5690:     eori.b #$0C,D0
02:0003A9B8 41EC0098        	  5691:     lea     ($0098,A4),A0
02:0003A9BC 11802000        	  5692:     move.b  D0,(A0,D2.W)
02:0003A9C0 6000008C        	  5693:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5694: 
                            	  5695:     even
                            	  5696: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  5697:     ; Facing horizontally. Flip the direction.
                            	  5698:     ; Move two pixels, and go draw.
                            	  5699:     ;
02:0003A9C4 0A000003        	  5700:     eori.b #$03,D0
02:0003A9C8 41EC0098        	  5701:     lea     ($0098,A4),A0
02:0003A9CC 11802000        	  5702:     move.b  D0,(A0,D2.W)
02:0003A9D0 610001B0        	  5703:     jsr     PolsVoice_MoveX
02:0003A9D4 610001AC        	  5704:     jsr     PolsVoice_MoveX
                            	  5705:     even
                            	  5706: _L_z04_UpdatePolsVoice_DrawAndCheckCollisions:
02:0003A9D8 6074            	  5707:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  5708: 
                            	  5709:     even
                            	  5710: _L_z04_UpdatePolsVoice_SetState1:
                            	  5711:     ; If already in state 1, then go draw and check collisions.
                            	  5712:     ;
02:0003A9DA 41EC00AC        	  5713:     lea     ($00AC,A4),A0
02:0003A9DE 10302000        	  5714:     move.b  (A0,D2.W),D0
02:0003A9E2 6702            	  5715:     beq.s  __far_z_04_0054
02:0003A9E4 6068            	  5716:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  5717: __far_z_04_0054:
                            	  5718:     ; Go to state 1.
                            	  5719:     ;
02:0003A9E6 41EC00AC        	  5720:     lea     ($00AC,A4),A0
02:0003A9EA 52302000        	  5721:     addq.b  #1,(A0,D2.W)
                            	  5722:     ; Subtract 1 from facing direction to make an index.
                            	  5723:     ;
02:0003A9EE 7600            	  5724:     moveq   #0,D3
02:0003A9F0 41EC0098        	  5725:     lea     ($0098,A4),A0
02:0003A9F4 16302000        	  5726:     move.b  (A0,D2.W),D3
02:0003A9F8 5303            	  5727:     subq.b  #1,D3
                            	  5728:     ; If Y coordinate < $78, make the index 3 for down.
                            	  5729:     ;
02:0003A9FA 41EC0084        	  5730:     lea     ($0084,A4),A0
02:0003A9FE 10302000        	  5731:     move.b  (A0,D2.W),D0
02:0003AA02 0C000078        	  5732:     cmpi.b  #$78,D0
02:0003AA06 6402            	  5733:     bcc  _anon_z04_97
02:0003AA08 7603            	  5734:     moveq   #3,D3
                            	  5735: _anon_z04_97:
                            	  5736:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  5737:     ;
02:0003AA0A 0C0000A8        	  5738:     cmpi.b  #$A8,D0
02:0003AA0E 6502            	  5739:     bcs  _anon_z04_98
02:0003AA10 7607            	  5740:     moveq   #7,D3
                            	  5741: _anon_z04_98:
                            	  5742:     ; Set the vertical speed for the beginning of the jump.
                            	  5743:     ;
02:0003AA12 41F90003A906    	  5744:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003AA18 10303000        	  5745:     move.b  (A0,D3.W),D0
02:0003AA1C 41EC0412        	  5746:     lea     ($0412,A4),A0
02:0003AA20 11802000        	  5747:     move.b  D0,(A0,D2.W)
                            	  5748:     ; Look up the Y offset for the current direction.
                            	  5749:     ; Add it to object Y to set the destination Y of the jump.
                            	  5750:     ;
02:0003AA24 41EC0084        	  5751:     lea     ($0084,A4),A0
02:0003AA28 10302000        	  5752:     move.b  (A0,D2.W),D0
02:0003AA2C 023C00EE        	  5753:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA30 41F90003A90E    	  5754:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003AA36 12303000        	  5755:     move.b  (A0,D3.W),D1
02:0003AA3A D101            	  5756:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003AA3C 41EC042C        	  5757:     lea     ($042C,A4),A0
02:0003AA40 11802000        	  5758:     move.b  D0,(A0,D2.W)
                            	  5759:     ; Turn the index into a direction again by adding 1.
                            	  5760:     ; Store the facing direction.
                            	  5761:     ;
02:0003AA44 5203            	  5762:     addq.b  #1,D3
02:0003AA46 41EC0098        	  5763:     lea     ($0098,A4),A0
02:0003AA4A 11832000        	  5764:     move.b  D3,(A0,D2.W)
                            	  5765:     even
                            	  5766: L_PolsVoice_DrawAndCheckCollisions:
02:0003AA4E 7008            	  5767:     moveq   #8,D0
02:0003AA50 4EB9000499DE    	  5768:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003AA56 41EC03E4        	  5769:     lea     ($03E4,A4),A0
02:0003AA5A 10302000        	  5770:     move.b  (A0,D2.W),D0
02:0003AA5E 4EB900030CE6    	  5771:     jsr     DrawObjectMirrored
                            	  5772:     ; Pols Voice is invincible to everything but the sword,
                            	  5773:     ; during normal collision detection.
                            	  5774:     ;
                            	  5775:     ; The arrow is a special case.
                            	  5776:     ;
02:0003AA64 103C00FE        	  5777:     move.b  #$FE,D0
02:0003AA68 41EC04B2        	  5778:     lea     ($04B2,A4),A0
02:0003AA6C 11802000        	  5779:     move.b  D0,(A0,D2.W)
02:0003AA70 4EB900031056    	  5780:     jsr     CheckMonsterCollisions
02:0003AA76 4E75            	  5781:     rts
                            	  5782: 
                            	  5783:     even
                            	  5784: UpdatePolsVoiceState1_Jumping:
                            	  5785:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5786:     ;
02:0003AA78 41EC0444        	  5787:     lea     ($0444,A4),A0
02:0003AA7C 10302000        	  5788:     move.b  (A0,D2.W),D0
02:0003AA80 023C00EE        	  5789:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA84 123C0038        	  5790:     move.b  #$38,D1
02:0003AA88 D101            	  5791:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003AA8A 41EC0444        	  5792:     lea     ($0444,A4),A0
02:0003AA8E 11802000        	  5793:     move.b  D0,(A0,D2.W)
                            	  5794:     ; Add Carry to high speed byte (vertical).
                            	  5795:     ;
02:0003AA92 41EC0412        	  5796:     lea     ($0412,A4),A0
02:0003AA96 10302000        	  5797:     move.b  (A0,D2.W),D0
02:0003AA9A 123C0000        	  5798:     move.b  #$00,D1
02:0003AA9E D101            	  5799:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AAA0 41EC0412        	  5800:     lea     ($0412,A4),A0
02:0003AAA4 11802000        	  5801:     move.b  D0,(A0,D2.W)
                            	  5802:     ; Add high speed byte to Y coordinate.
                            	  5803:     ;
02:0003AAA8 023C00EE        	  5804:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AAAC 41EC0084        	  5805:     lea     ($0084,A4),A0
02:0003AAB0 12302000        	  5806:     move.b  (A0,D2.W),D1
02:0003AAB4 D101            	  5807:     addx.b  D1,D0   ; ADC ObjY,X
02:0003AAB6 41EC0084        	  5808:     lea     ($0084,A4),A0
02:0003AABA 11802000        	  5809:     move.b  D0,(A0,D2.W)
                            	  5810:     ; If the speed is still negative, then return.
                            	  5811:     ;
02:0003AABE 41EC0412        	  5812:     lea     ($0412,A4),A0
02:0003AAC2 10302000        	  5813:     move.b  (A0,D2.W),D0
02:0003AAC6 6B0000AC        	  5814:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5815:     ; If Y coordinate still < target Y, then return.
                            	  5816:     ;
02:0003AACA 41EC0084        	  5817:     lea     ($0084,A4),A0
02:0003AACE 10302000        	  5818:     move.b  (A0,D2.W),D0
02:0003AAD2 41EC042C        	  5819:     lea     ($042C,A4),A0
02:0003AAD6 12302000        	  5820:     move.b  (A0,D2.W),D1
02:0003AADA B001            	  5821:     cmp.b   D1,D0
02:0003AADC 65000096        	  5822:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5823:     ; Else reached the destination. Go to state 0.
                            	  5824:     ;
02:0003AAE0 7000            	  5825:     moveq   #0,D0
02:0003AAE2 41EC00AC        	  5826:     lea     ($00AC,A4),A0
02:0003AAE6 11802000        	  5827:     move.b  D0,(A0,D2.W)
                            	  5828:     ; Reset 16-bit vertical speed.
                            	  5829:     ;
02:0003AAEA 41EC0444        	  5830:     lea     ($0444,A4),A0
02:0003AAEE 11802000        	  5831:     move.b  D0,(A0,D2.W)
02:0003AAF2 41EC0412        	  5832:     lea     ($0412,A4),A0
02:0003AAF6 11802000        	  5833:     move.b  D0,(A0,D2.W)
                            	  5834:     ; Choose a random direction to face in.
                            	  5835:     ;
02:0003AAFA 10342018        	  5836:     move.b  ($18,A4,D2.W),D0
02:0003AAFE 02000003        	  5837:     andi.b #$03,D0
02:0003AB02 7600            	  5838:     moveq   #0,D3
02:0003AB04 1600            	  5839:     move.b  D0,D3
02:0003AB06 41F90003A916    	  5840:     lea     (PolsVoiceDirections).l,A0
02:0003AB0C 10303000        	  5841:     move.b  (A0,D3.W),D0
02:0003AB10 41EC0098        	  5842:     lea     ($0098,A4),A0
02:0003AB14 11802000        	  5843:     move.b  D0,(A0,D2.W)
                            	  5844:     ; Randomly set distance-to-move to $30 or $70.
                            	  5845:     ;
02:0003AB18 10342018        	  5846:     move.b  ($18,A4,D2.W),D0
02:0003AB1C 02000040        	  5847:     andi.b #$40,D0
02:0003AB20 123C0030        	  5848:     move.b  #$30,D1
02:0003AB24 D101            	  5849:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003AB26 41EC0394        	  5850:     lea     ($0394,A4),A0
02:0003AB2A 11802000        	  5851:     move.b  D0,(A0,D2.W)
                            	  5852:     ; Align the monster with a square horizontally.
                            	  5853:     ;
                            	  5854:     ; If in the left half of a square, align with that square.
                            	  5855:     ; If in the right half, align with the next square.
                            	  5856:     ;
02:0003AB2E 10342070        	  5857:     move.b  ($70,A4,D2.W),D0
02:0003AB32 023C00EE        	  5858:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB36 123C0008        	  5859:     move.b  #$08,D1
02:0003AB3A D101            	  5860:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AB3C 020000F0        	  5861:     andi.b #$F0,D0
02:0003AB40 19802070        	  5862:     move.b  D0,($70,A4,D2.W)
                            	  5863:     ; Align the monster with a square vertically.
                            	  5864:     ;
                            	  5865:     ; If in the top half of a square, align with that square.
                            	  5866:     ; If in the bottom half, align with the next square.
                            	  5867:     ;
02:0003AB44 41EC0084        	  5868:     lea     ($0084,A4),A0
02:0003AB48 10302000        	  5869:     move.b  (A0,D2.W),D0
02:0003AB4C 023C00EE        	  5870:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB50 123C0008        	  5871:     move.b  #$08,D1
02:0003AB54 D101            	  5872:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AB56 020000F0        	  5873:     andi.b #$F0,D0
                            	  5874:     ; Make sure the lower nibble of Y is $D as usual.
                            	  5875:     ;
02:0003AB5A 003C0011        	  5876:     ori     #$11,CCR  ; SEC: set C+X
02:0003AB5E 123C0003        	  5877:     move.b  #$03,D1
02:0003AB62 0A3C0010        	  5878:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AB66 9101            	  5879:     subx.b  D1,D0   ; SBC #$03
02:0003AB68 0A3C0010        	  5880:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AB6C 41EC0084        	  5881:     lea     ($0084,A4),A0
02:0003AB70 11802000        	  5882:     move.b  D0,(A0,D2.W)
                            	  5883:     even
