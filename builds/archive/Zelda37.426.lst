                            	  8695: Submenu_WriteScanningMapRoomMark:
02:00041FC0 1003            	  8696:     move.b  D3,D0
02:00041FC2 1B00            	  8697:     move.b  D0,-(A5)  ; PHA
02:00041FC4 610058B6        	  8698:     jsr     GetRoomFlags
02:00041FC8 102C00EB        	  8699:     move.b  ($00EB,A4),D0
02:00041FCC 1B00            	  8700:     move.b  D0,-(A5)  ; PHA
                            	  8701:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8702:     ; in order to look up its information.
                            	  8703:     ;
02:00041FCE 102C005D        	  8704:     move.b  ($005D,A4),D0
02:00041FD2 194000EB        	  8705:     move.b  D0,($00EB,A4)
                            	  8706:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8707:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8708:     ; map mark tile.
                            	  8709:     ;
02:00041FD6 7013            	  8710:     moveq   #19,D0
02:00041FD8 1940033F        	  8711:     move.b  D0,($033F,A4)
                            	  8712:     ; Get the currently scanned room's visit state.
                            	  8713:     ;
02:00041FDC 7600            	  8714:     moveq   #0,D3
02:00041FDE 162C00EB        	  8715:     move.b  ($00EB,A4),D3
02:00041FE2 1214            	  8716:     move.b  ($00,A4),D1   ; ptr lo
02:00041FE4 182C0001        	  8717:     move.b  ($01,A4),D4  ; ptr hi
02:00041FE8 024100FF        	  8718:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041FEC E14C            	  8719:     lsl.w   #8,D4
02:00041FEE 8841            	  8720:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041FF0 48C4            	  8721:     ext.l   D4
02:00041FF2 D8BC00FF0000    	  8722:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041FF8 2044            	  8723:     movea.l D4,A0
02:00041FFA 10303000        	  8724:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041FFE 02000020        	  8725:     andi.b #$20,D0
                            	  8726:     ; If it's been visited, then check each of the 4 doors,
                            	  8727:     ; and build an open door mask.
                            	  8728:     ;
                            	  8729:     ; Start with direction up and direction index 3.
                            	  8730:     ;
02:00042002 671C            	  8731:     beq  _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile
02:00042004 7008            	  8732:     moveq   #8,D0
02:00042006 19400002        	  8733:     move.b  D0,($0002,A4)
02:0004200A 7403            	  8734:     moveq   #3,D2
                            	  8735: _anon_z05_204:
02:0004200C 6100DF56        	  8736:     jsr     FindDoorAttrByDoorBit
02:00042010 6132            	  8737:     jsr     CalcOpenDoorwayMask
02:00042012 5302            	  8738:     subq.b  #1,D2
