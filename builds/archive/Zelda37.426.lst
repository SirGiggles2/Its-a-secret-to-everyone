                            	  6006: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  6007:     ; In this state, we have to draw Like-like over Link.
                            	  6008:     ; So, don't use the usual sprite writing code that cycles sprites.
                            	  6009:     ;
02:0003AC7E 4EB9000499E4    	  6010:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003AC84 41EC03E4        	  6011:     lea     ($03E4,A4),A0
