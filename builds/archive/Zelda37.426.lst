                            	  3189: _L_z05_CheckSubroom_InCave:
                            	  3190:     ; In a cave.
                            	  3191:     ;
                            	  3192:     ; Check whether a person is blocking the upper half of the room.
                            	  3193:     ;
02:0003E902 1B00            	  3194:     move.b  D0,-(A5)  ; PHA
02:0003E904 4EB9000308D0    	  3195:     jsr     CheckPersonBlocking
02:0003E90A 101D            	  3196:     move.b  (A5)+,D0  ; PLA
                            	  3197:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3198:     ;
02:0003E90C 0C00000C        	  3199:     cmpi.b  #$0C,D0
02:0003E910 6704            	  3200:     beq.s  __far_z_05_0059
02:0003E912 60000082        	  3201:     jmp  CheckCaveEdge
                            	  3202: __far_z_05_0059:
                            	  3203:     ; In a shortcut cave (mode $C).
                            	  3204:     ;
                            	  3205:     ; If grid offset <> 0, return.
