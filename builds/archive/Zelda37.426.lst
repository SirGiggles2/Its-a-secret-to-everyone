                            	   404:     even
                            	   405: _L_z01_InitCaveContinue_CopyPermutation:
02:0002F1A6 41F90002F094    	   406:     lea     (MoneyGamePermutations).l,A0
02:0002F1AC 10302000        	   407:     move.b  (A0,D2.W),D0
02:0002F1B0 41EC046C        	   408:     lea     ($046C,A4),A0
02:0002F1B4 11803000        	   409:     move.b  D0,(A0,D3.W)
02:0002F1B8 5302            	   410:     subq.b  #1,D2
02:0002F1BA 5303            	   411:     subq.b  #1,D3
02:0002F1BC 6AE8            	   412:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   413:     ; With the first bit of another random number, choose 10 or 40
                            	   414:     ; to put in [046F]. This is a random amount to lose.
                            	   415:     ;
02:0002F1BE 102C001A        	   416:     move.b  ($001A,A4),D0
02:0002F1C2 02000001        	   417:     andi.b #$01,D0
02:0002F1C6 7600            	   418:     moveq   #0,D3
02:0002F1C8 1600            	   419:     move.b  D0,D3
02:0002F1CA 41F90002F092    	   420:     lea     (MoneyGameLossAmounts).l,A0
02:0002F1D0 10303000        	   421:     move.b  (A0,D3.W),D0
02:0002F1D4 1940046F        	   422:     move.b  D0,($046F,A4)
                            	   423:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   424:     ;
