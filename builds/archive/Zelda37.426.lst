                            	  2834:     ;
                            	  2835:     ; TODO: but why, since Link is halted?
                            	  2836:     ;
02:000394C0 102C00AC        	  2837:     move.b  ($00AC,A4),D0
02:000394C4 1B00            	  2838:     move.b  D0,-(A5)  ; PHA
02:000394C6 194300AC        	  2839:     move.b  D3,($00AC,A4)
02:000394CA 4EB900048988    	  2840:     jsr     Link_EndMoveAndAnimate_Bank4
