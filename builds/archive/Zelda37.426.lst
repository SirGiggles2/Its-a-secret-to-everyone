02:0003CC26 122C0002        	 10414:     move.b  ($0002,A4),D1
02:0003CC2A 0A3C0010        	 10415:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CC2E 9101            	 10416:     subx.b  D1,D0   ; SBC $02
02:0003CC30 0A3C0010        	 10417:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CC34 41EC0412        	 10418:     lea     ($0412,A4),A0
