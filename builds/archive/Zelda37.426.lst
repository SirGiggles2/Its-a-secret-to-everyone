                            	  7188: _L_z07_InitObject_InitMonsterFromEdge:
02:00049E20 7400            	  7189:     moveq   #0,D2
02:00049E22 142C0340        	  7190:     move.b  ($0340,A4),D2
                            	  7191:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7192:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7193:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7194:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7195:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7196:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7197:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7198:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7199:     ; corrupting them and causing a deterministic address-error
                            	  7200:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7201:     ; identified by Codex static review.)
                            	  7202: _L_z07_P47_pre_check:
02:00049E26 102C0525        	  7203:     move.b  ($0525,A4),D0
02:00049E2A 020000F0        	  7204:     andi.b  #$F0,D0
02:00049E2E 0C000040        	  7205:     cmpi.b  #$40,D0
02:00049E32 6506            	  7206:     blo     _L_z07_P47_pre_snap
02:00049E34 0C0000E0        	  7207:     cmpi.b  #$E0,D0
02:00049E38 6506            	  7208:     blo     _L_z07_P47_pre_ok
                            	  7209: _L_z07_P47_pre_snap:
02:00049E3A 197C00480525    	  7210:     move.b  #$48,($0525,A4)
                            	  7211: _L_z07_P47_pre_ok:
02:00049E40 7005            	  7212:     moveq   #5,D0
02:00049E42 610004F4        	  7213:     jsr     SwitchBank
02:00049E46 4EB90003EB24    	  7214:     jsr     FindNextEdgeSpawnCell
                            	  7215:     ; Post-walk 1: bottom-edge snap.
02:00049E4C 102C0525        	  7216:     move.b  ($0525,A4),D0
02:00049E50 020000F0        	  7217:     andi.b  #$F0,D0
02:00049E54 0C0000E0        	  7218:     cmpi.b  #$E0,D0
02:00049E58 660C            	  7219:     bne     _L_z07_P47_post1_ok
02:00049E5A 197C00480525    	  7220:     move.b  #$48,($0525,A4)
02:00049E60 4EB90003EB24    	  7221:     jsr     FindNextEdgeSpawnCell
                            	  7222: _L_z07_P47_post1_ok:
                            	  7223:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7224:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:00049E66 7600            	  7225:     moveq   #0,D3
02:00049E68 162C0525        	  7226:     move.b  ($0525,A4),D3
02:00049E6C 0243000F        	  7227:     andi.w  #$000F,D3
02:00049E70 C6FC002C        	  7228:     mulu.w  #44,D3
02:00049E74 203C00FF6530    	  7229:     move.l  #$FF6530,D0
02:00049E7A D083            	  7230:     add.l   D3,D0
02:00049E7C 7600            	  7231:     moveq   #0,D3
02:00049E7E 162C0525        	  7232:     move.b  ($0525,A4),D3
02:00049E82 E84B            	  7233:     lsr.w   #4,D3
02:00049E84 5943            	  7234:     subi.w  #4,D3
02:00049E86 E34B            	  7235:     lsl.w   #1,D3
02:00049E88 D083            	  7236:     add.l   D3,D0
02:00049E8A 2040            	  7237:     movea.l D0,A0
02:00049E8C 1010            	  7238:     move.b  (A0),D0
02:00049E8E 0C000084        	  7239:     cmpi.b  #$84,D0
02:00049E92 6544            	  7240:     blo     _L_z07_P47_post2_ok
                            	  7241:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7242:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7243:     ; writes to the $05xx region.
02:00049E94 7800            	  7244:     moveq   #0,D4
                            	  7245: _L_z07_P47_fb_loop:
02:00049E96 41FAE566        	  7246:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049E9A 12304000        	  7247:     move.b  (A0,D4.W),D1
02:00049E9E 19410525        	  7248:     move.b  D1,($0525,A4)
                            	  7249:     ; Validate fallback cell walkable.
02:00049EA2 7600            	  7250:     moveq   #0,D3
02:00049EA4 1601            	  7251:     move.b  D1,D3
02:00049EA6 0243000F        	  7252:     andi.w  #$000F,D3
02:00049EAA C6FC002C        	  7253:     mulu.w  #44,D3
02:00049EAE 203C00FF6530    	  7254:     move.l  #$FF6530,D0
02:00049EB4 D083            	  7255:     add.l   D3,D0
02:00049EB6 7600            	  7256:     moveq   #0,D3
02:00049EB8 1601            	  7257:     move.b  D1,D3
02:00049EBA E84B            	  7258:     lsr.w   #4,D3
02:00049EBC 5943            	  7259:     subi.w  #4,D3
02:00049EBE E34B            	  7260:     lsl.w   #1,D3
02:00049EC0 D083            	  7261:     add.l   D3,D0
02:00049EC2 2040            	  7262:     movea.l D0,A0
02:00049EC4 0C100084        	  7263:     cmpi.b  #$84,(A0)
02:00049EC8 650E            	  7264:     blo     _L_z07_P47_post2_ok
02:00049ECA 5204            	  7265:     addq.b  #1,D4
02:00049ECC 0C040008        	  7266:     cmpi.b  #8,D4
02:00049ED0 65C4            	  7267:     blo     _L_z07_P47_fb_loop
                            	  7268:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7269:     ; rather than looping).
02:00049ED2 197C00480525    	  7270:     move.b  #$48,($0525,A4)
                            	  7271: _L_z07_P47_post2_ok:
                            	  7272:     ; Extract and set the monster's location.
                            	  7273:     ;
02:00049ED8 102C0525        	  7274:     move.b  ($0525,A4),D0
                            	  7275:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7276:     ;
02:00049EDC 1B00            	  7277:     move.b  D0,-(A5)  ; PHA
02:00049EDE E308            	  7278:     lsl.b  #1,D0   ; ASL A
02:00049EE0 E308            	  7279:     lsl.b  #1,D0   ; ASL A
02:00049EE2 E308            	  7280:     lsl.b  #1,D0   ; ASL A
02:00049EE4 E308            	  7281:     lsl.b  #1,D0   ; ASL A
02:00049EE6 19802070        	  7282:     move.b  D0,($70,A4,D2.W)
                            	  7283:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7284:     ;
02:00049EEA 101D            	  7285:     move.b  (A5)+,D0  ; PLA
02:00049EEC 020000F0        	  7286:     andi.b #$F0,D0
02:00049EF0 003C0011        	  7287:     ori     #$11,CCR  ; SEC: set C+X
02:00049EF4 123C0003        	  7288:     move.b  #$03,D1
02:00049EF8 0A3C0010        	  7289:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049EFC 9101            	  7290:     subx.b  D1,D0   ; SBC #$03
02:00049EFE 0A3C0010        	  7291:     eori    #$10,CCR  ; restore X = 6502 C
02:00049F02 41EC0084        	  7292:     lea     ($0084,A4),A0
02:00049F06 11802000        	  7293:     move.b  D0,(A0,D2.W)
                            	  7294:     ; Set the monsters-from-edges long timer to a random value
                            	  7295:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7296:     ;
02:00049F0A 10342019        	  7297:     move.b  ($19,A4,D2.W),D0
02:00049F0E 02000003        	  7298:     andi.b #$03,D0
02:00049F12 023C00EE        	  7299:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049F16 123C0002        	  7300:     move.b  #$02,D1
02:00049F1A D101            	  7301:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049F1C 1940004B        	  7302:     move.b  D0,($004B,A4)
                            	  7303:     ; If the distance to Link is too close to Link, then
                            	  7304:     ; go flag the monster uninitialized again, so we can
                            	  7305:     ; try to spawn it again next time.
                            	  7306:     ;
02:00049F20 7005            	  7307:     moveq   #5,D0
02:00049F22 61000414        	  7308:     jsr     SwitchBank
02:00049F26 4EB90003E134    	  7309:     jsr     IsDistanceSafeToSpawn
02:00049F2C 6500FEB4        	  7310:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7311:     ; OK to spawn.
                            	  7312:     ; In this situation, monsters don't spawn from a cloud.
                            	  7313:     ;
02:00049F30 7000            	  7314:     moveq   #0,D0
02:00049F32 41EC0405        	  7315:     lea     ($0405,A4),A0
02:00049F36 11802000        	  7316:     move.b  D0,(A0,D2.W)
                            	  7317:     even
                            	  7318: _L_z07_InitObject_NormalSpawn:
02:00049F3A 7004            	  7319:     moveq   #4,D0
02:00049F3C 610003FA        	  7320:     jsr     SwitchBank
                            	  7321:     ; For monsters that spawn in a cloud, set their start time to
                            	  7322:     ; the same value as the object slot; so that they all start
                            	  7323:     ; moving at different times.
                            	  7324:     ;
02:00049F40 7400            	  7325:     moveq   #0,D2
02:00049F42 142C0340        	  7326:     move.b  ($0340,A4),D2
02:00049F46 7600            	  7327:     moveq   #0,D3
02:00049F48 41EC034F        	  7328:     lea     ($034F,A4),A0
02:00049F4C 16302000        	  7329:     move.b  (A0,D2.W),D3
02:00049F50 0C03001E        	  7330:     cmpi.b  #$1E,D3
02:00049F54 6712            	  7331:     beq  _L_z07_InitObject_FetchAttrs
02:00049F56 0C030022        	  7332:     cmpi.b  #$22,D3
02:00049F5A 670C            	  7333:     beq  _L_z07_InitObject_FetchAttrs
02:00049F5C 0C030053        	  7334:     cmpi.b  #$53,D3
02:00049F60 6406            	  7335:     bcc  _L_z07_InitObject_FetchAttrs
02:00049F62 1002            	  7336:     move.b  D2,D0
02:00049F64 19802028        	  7337:     move.b  D0,($28,A4,D2.W)
                            	  7338:     even
                            	  7339: _L_z07_InitObject_FetchAttrs:
                            	  7340:     ; Store the object attributes for fast access.
                            	  7341:     ;
02:00049F68 41F900049A58    	  7342:     lea     (ObjectTypeToAttributes).l,A0
02:00049F6E 10303000        	  7343:     move.b  (A0,D3.W),D0
02:00049F72 41EC04BF        	  7344:     lea     ($04BF,A4),A0
02:00049F76 11802000        	  7345:     move.b  D0,(A0,D2.W)
02:00049F7A 1003            	  7346:     move.b  D3,D0
02:00049F7C 1880            	  7347:     move.b  D0,($0000,A4)
                            	  7348:     ; Hit points are packed two values to a byte.
                            	  7349:     ; Divide the object type in half in order to index
                            	  7350:     ; into the hit points table.
                            	  7351:     ;
02:00049F7E E208            	  7352:     lsr.b  #1,D0   ; LSR A
02:00049F80 7600            	  7353:     moveq   #0,D3
02:00049F82 1600            	  7354:     move.b  D0,D3
02:00049F84 41F900049AB8    	  7355:     lea     (ObjectTypeToHpPairs).l,A0
02:00049F8A 10303000        	  7356:     move.b  (A0,D3.W),D0
02:00049F8E 4EB90003C6C6    	  7357:     jsr     ExtractHitPointValue
02:00049F94 41EC0485        	  7358:     lea     ($0485,A4),A0
02:00049F98 11802000        	  7359:     move.b  D0,(A0,D2.W)
                            	  7360:     ; If the object is a cave, go initialize it.
                            	  7361:     ;
02:00049F9C 1014            	  7362:     move.b  ($0000,A4),D0
02:00049F9E 0C00006A        	  7363:     cmpi.b  #$6A,D0
02:00049FA2 650C            	  7364:     bcs  _L_z07_InitObject_CheckTileObj
02:00049FA4 7001            	  7365:     moveq   #1,D0
02:00049FA6 61000390        	  7366:     jsr     SwitchBank
02:00049FAA 4EF90002F0AC    	  7367:     jmp     InitCave
                            	  7368: 
                            	  7369:     even
                            	  7370: _L_z07_InitObject_CheckTileObj:
                            	  7371:     ; If object is a cave or tile object (type >= $5F),
                            	  7372:     ; go assign object attribute $81, and get
                            	  7373:     ; it ready to behave autonomously and updating.
