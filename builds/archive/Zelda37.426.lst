                            	  2754: UpdatePondFairy:
02:00039458 61003562        	  2755:     jsr     DrawFairy
                            	  2756:     ; If not in state 0, then go handle states 1 to 3.
                            	  2757:     ;
02:0003945C 102C00AD        	  2758:     move.b  ($00AD,A4),D0
02:00039460 6702            	  2759:     beq.s  __far_z_04_0026
02:00039462 602A            	  2760:     jmp  PondFairy_HandleOtherStates
                            	  2761: __far_z_04_0026:
                            	  2762:     ; State 0.
                            	  2763:     ;
                            	  2764:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2765:     ;
02:00039464 102C0084        	  2766:     move.b  ($0084,A4),D0
02:00039468 0C0000AD        	  2767:     cmpi.b  #$AD,D0
02:0003946C 661E            	  2768:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2769:     ; If Link's X < $70 or >= $81, then return.
                            	  2770:     ;
02:0003946E 102C0070        	  2771:     move.b  ($0070,A4),D0
02:00039472 0C000070        	  2772:     cmpi.b  #$70,D0
02:00039476 6514            	  2773:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039478 0C000081        	  2774:     cmpi.b  #$81,D0
02:0003947C 640E            	  2775:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2776:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2777:     ; halt Link, and start filling hearts.
                            	  2778:     ;
02:0003947E 522C00AD        	  2779:     addq.b  #1,($00AD,A4)
02:00039482 7040            	  2780:     moveq   #64,D0
02:00039484 194000AC        	  2781:     move.b  D0,($00AC,A4)
02:00039488 19400063        	  2782:     move.b  D0,($0063,A4)
                            	  2783:     even
                            	  2784: _L_z04_UpdatePondFairy_Exit:
02:0003948C 4E75            	  2785:     rts
                            	  2786: 
                            	  2787:     even
                            	  2788: PondFairy_HandleOtherStates:
02:0003948E 0C000001        	  2789:     cmpi.b  #$01,D0
02:00039492 6610            	  2790:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2791:     ; State 1. Flying and filling hearts.
                            	  2792:     ;
                            	  2793:     ; If still filling hearts, then go draw Link and hearts.
                            	  2794:     ;
02:00039494 102C0063        	  2795:     move.b  ($0063,A4),D0
02:00039498 6620            	  2796:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2797:     ; If not filling hearts anymore, then go to state 2,
                            	  2798:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2799:     ; a little while after we finish filling hearts.
                            	  2800:     ;
02:0003949A 522C00AD        	  2801:     addq.b  #1,($00AD,A4)
02:0003949E 7050            	  2802:     moveq   #80,D0
02:000394A0 19400029        	  2803:     move.b  D0,($0029,A4)
                            	  2804:     even
                            	  2805: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2806:     ; If state <> 2 (so, it's 3), then return.
                            	  2807:     ;
                            	  2808:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2809:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2810:     ; was set to, and we'll return.
                            	  2811:     ;
02:000394A4 0C000002        	  2812:     cmpi.b  #$02,D0
02:000394A8 6634            	  2813:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2814:     ; State = 2.
                            	  2815:     ;
                            	  2816:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2817:     ;
02:000394AA 102C0029        	  2818:     move.b  ($0029,A4),D0
02:000394AE 660A            	  2819:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2820:     ; Else go to state 3, and unhalt Link.
                            	  2821:     ;
02:000394B0 522C00AD        	  2822:     addq.b  #1,($00AD,A4)
02:000394B4 7000            	  2823:     moveq   #0,D0
02:000394B6 194000AC        	  2824:     move.b  D0,($00AC,A4)
                            	  2825:     even
                            	  2826: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  2827:     ; TODO: but why, since Link is halted?
                            	  2828:     ;
