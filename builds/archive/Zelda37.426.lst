02:000393B6 41EC0492        	  2666:     lea     ($0492,A4),A0
02:000393BA 10302000        	  2667:     move.b  (A0,D2.W),D0
02:000393BE 66EC            	  2668:     bne  _anon_z04_53
02:000393C0 4EB90004A1DE    	  2669:     jsr     ResetObjMetastateAndTimer
02:000393C6 6000F70E        	  2670:     jmp     EndInitFlyer
