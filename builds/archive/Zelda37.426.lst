02:0003AC1E 41EC03D0        	  5960:     lea     ($03D0,A4),A0
02:0003AC22 11802000        	  5961:     move.b  D0,(A0,D2.W)
                            	  5962:     ; Now Link can't move.
                            	  5963:     ;
02:0003AC26 522C0512        	  5964:     addq.b  #1,($0512,A4)
                            	  5965:     even
