02:0003ABF2 19802070        	  5944:     move.b  D0,($70,A4,D2.W)
02:0003ABF6 102C0084        	  5945:     move.b  ($0084,A4),D0
02:0003ABFA 41EC0084        	  5946:     lea     ($0084,A4),A0
