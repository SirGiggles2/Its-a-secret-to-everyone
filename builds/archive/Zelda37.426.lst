02:00040452 0A3C0010        	  5596:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040456 9101            	  5597:     subx.b  D1,D0   ; SBC #$01
02:00040458 0A3C0010        	  5598:     eori    #$10,CCR  ; restore X = 6502 C
02:0004045C 02000002        	  5599:     andi.b #$02,D0
