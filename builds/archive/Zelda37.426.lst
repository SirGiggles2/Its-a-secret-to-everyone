02:00038E44 41F900038DB2    	  1874:     lea     (BlueLeeverStateTimes).l,A0
02:00038E4A 10303000        	  1875:     move.b  (A0,D3.W),D0
02:00038E4E 19802028        	  1876:     move.b  D0,($28,A4,D2.W)
