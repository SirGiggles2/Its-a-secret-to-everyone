                            	  8565: UpdatePatraChild:
                            	  8566:     ; If state = 1, then go orbit.
                            	  8567:     ;
02:0003BFD0 41EC00AC        	  8568:     lea     ($00AC,A4),A0
02:0003BFD4 10302000        	  8569:     move.b  (A0,D2.W),D0
02:0003BFD8 6704            	  8570:     beq.s  __far_z_04_0096
02:0003BFDA 6000009E        	  8571:     jmp  PatraChild_State1
                            	  8572: __far_z_04_0096:
                            	  8573:     ; State = 0.
                            	  8574:     ;
                            	  8575:     ; If the current object slot is 2, then go initialize the patra child.
                            	  8576:     ; This is the only patra child shown in the first fame.
                            	  8577:     ;
02:0003BFDE 0C020002        	  8578:     cmpi.b  #$02,D2
02:0003BFE2 6732            	  8579:     beq  _L_z04_UpdatePatraChild_Ready
                            	  8580:     ; The patra child in slot 2 is the last one to be updated.
                            	  8581:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  8582:     ;
                            	  8583:     ; This means that in the first frame, slot 2 is the only one to be
                            	  8584:     ; shown.
                            	  8585:     ;
02:0003BFE4 102C00AE        	  8586:     move.b  ($00AE,A4),D0
02:0003BFE8 6700008E        	  8587:     beq  _L_z04_UpdatePatraChild_Exit
                            	  8588:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  8589:     ; here to wait to be shown at the top position (N) one at a time.
                            	  8590:     ;
02:0003BFEC 1002            	  8591:     move.b  D2,D0
                            	  8592:     ; Subtract 3 from the object slot to get the angle where the
                            	  8593:     ; patra child in object slot 2 should be for the current one to appear.
                            	  8594:     ;
02:0003BFEE 003C0011        	  8595:     ori     #$11,CCR  ; SEC: set C+X
02:0003BFF2 123C0003        	  8596:     move.b  #$03,D1
02:0003BFF6 0A3C0010        	  8597:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BFFA 9101            	  8598:     subx.b  D1,D0   ; SBC #$03
02:0003BFFC 0A3C0010        	  8599:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C000 7600            	  8600:     moveq   #0,D3
02:0003C002 1600            	  8601:     move.b  D0,D3
                            	  8602:     ; If the patra child in slot 2 has not reached the required angle,
                            	  8603:     ; then return.
                            	  8604:     ;
02:0003C004 102C0396        	  8605:     move.b  ($0396,A4),D0
02:0003C008 41F90003BFC2    	  8606:     lea     (PatraChildStartAngles).l,A0
02:0003C00E 12303000        	  8607:     move.b  (A0,D3.W),D1
02:0003C012 B001            	  8608:     cmp.b   D1,D0
02:0003C014 6662            	  8609:     bne  _L_z04_UpdatePatraChild_Exit
                            	  8610:     even
