02:0004201A 19410002        	  8741:     move.b  D1,($0002,A4)
02:0004201E 66EC            	  8742:     bne  _anon_z05_204
                            	  8743:     even
                            	  8744: _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile:
                            	  8745:     ; Restore current room ID and dynamic buffer offset.
                            	  8746:     ;
02:00042020 101D            	  8747:     move.b  (A5)+,D0  ; PLA
02:00042022 194000EB        	  8748:     move.b  D0,($00EB,A4)
02:00042026 101D            	  8749:     move.b  (A5)+,D0  ; PLA
02:00042028 7600            	  8750:     moveq   #0,D3
02:0004202A 1600            	  8751:     move.b  D0,D3
                            	  8752:     ; The map marks are arranged in the same order as all the
                            	  8753:     ; possible values of OpenDoorMask.
                            	  8754:     ;
                            	  8755:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8756:     ; dynamic transfer buf at the current offset.
                            	  8757:     ;
02:0004202C 102C033F        	  8758:     move.b  ($033F,A4),D0
02:00042030 023C00EE        	  8759:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042034 123C00E2        	  8760:     move.b  #$E2,D1
02:00042038 D101            	  8761:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:0004203A 41EC0304        	  8762:     lea     ($0304,A4),A0
02:0004203E 11803000        	  8763:     move.b  D0,(A0,D3.W)
02:00042042 4E75            	  8764:     rts
                            	  8765: 
                            	  8766: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8767: ; based on doorway type and room flags. Each call will shift the next
                            	  8768: ; doorway state bit into OpenDoorwayMask.
                            	  8769: ;
                            	  8770: ; Params:
                            	  8771: ; A: door attribute
                            	  8772: ; X: direction index
                            	  8773: ;
                            	  8774: ; Returns:
                            	  8775: ; A: untouched
                            	  8776: ;
                            	  8777:     even
                            	  8778: CalcOpenDoorwayMask:
02:00042044 7600            	  8779:     moveq   #0,D3
02:00042046 1B00            	  8780:     move.b  D0,-(A5)  ; PHA
02:00042048 0C000004        	  8781:     cmpi.b  #$04,D0
02:0004204C 6548            	  8782:     bcs  _L_z05_CalcOpenDoorwayMask_ByDoorType
                            	  8783:     ; Else we have to find out the walkability from the room flags.
