02:0003C380 41EC009A        	  9114:     lea     ($009A,A4),A0
02:0003C384 11803000        	  9115:     move.b  D0,(A0,D3.W)
02:0003C388 5303            	  9116:     subq.b  #1,D3
02:0003C38A 6AC2            	  9117:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003C38C 4E75            	  9118:     rts
