                            	  2336: _L_z04_UpdateOctorock_SaveOffset:
02:000391BE 1B00            	  2337:     move.b  D0,-(A5)  ; PHA
                            	  2338:     ; Decrement the animation counter, and roll over if needed.
                            	  2339:     ;
02:000391C0 41EC03D0        	  2340:     lea     ($03D0,A4),A0
