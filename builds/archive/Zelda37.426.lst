                            	  7925: __far_z_04_0085:
                            	  7926:     ; The animation timer has expired. There are two choices for arming it.
                            	  7927:     ;
                            	  7928:     ; When writhing after a hit, Gleeok animates faster.
                            	  7929:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	  7930:     ; Otherwise, set a longer time ($10).
                            	  7931:     ;
