                            	  4366: ; AnimateAndDrawCommonObject(val, slot) — ASM: D0=val, D2=slot
                            	  4367: c_animate_and_draw_common_object:
02:0002CCC4 2F02            	  4368:     move.l  D2,-(SP)        ; save D2
02:0002CCC6 2F02            	  4369:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CCC8 2F00            	  4370:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4371:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4372:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4373:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4374:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CCCA 4EB900000000    	  4375:     jsr     z04_animate_and_draw_common_object
02:0002CCD0 508F            	  4376:     addq.l  #8,SP           ; pop val+slot
02:0002CCD2 241F            	  4377:     move.l  (SP)+,D2        ; restore D2
02:0002CCD4 4E75            	  4378:     rts
