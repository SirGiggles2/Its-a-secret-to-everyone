02:00049294 0200000F        	  5703:     andi.b #$0F,D0
02:00049298 7600            	  5704:     moveq   #0,D3
02:0004929A 1600            	  5705:     move.b  D0,D3
02:0004929C 7000            	  5706:     moveq   #0,D0
02:0004929E 19400001        	  5707:     move.b  D0,($0001,A4)
