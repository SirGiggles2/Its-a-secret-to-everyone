                            	  4174: CheckTiles:
                            	  4175:     ifne TURBO_LINK
                            	  4176:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4177:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004885C 4A02            	  4178:     tst.b   D2
02:0004885E 6608            	  4179:     bne.s   _L_z07_CheckTiles_notLink
02:00048860 197C0024049E    	  4180:     move.b  #$24,($049E,A4)
02:00048866 605E            	  4181:     jmp     GoWalkableDir
                            	  4182: _L_z07_CheckTiles_notLink:
                            	  4183:     endc
                            	  4184:     ; The code below applies to Link and other objects.
                            	  4185:     ;
                            	  4186:     ; Test the moving direction's walkability.
                            	  4187:     ;
                            	  4188:     ; For the player, this is enough. For other objects, this 
                            	  4189:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4190:     ;
                            	  4191:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4192:     ;
02:00048868 6100FB88        	  4193:     jsr     GetCollidingTileMoving
02:0004886C 122C034A        	  4194:     move.b  ($034A,A4),D1
02:00048870 B001            	  4195:     cmp.b   D1,D0
02:00048872 6402            	  4196:     bcc.s  __far_z_07_0052
02:00048874 6050            	  4197:     jmp  GoWalkableDir
                            	  4198: __far_z_07_0052:
                            	  4199:     ; The colliding tile is unwalkable.
                            	  4200:     ;
                            	  4201:     ; If object is the player, then go check passive tile objects and
                            	  4202:     ; the screen edge, or stop moving.
                            	  4203:     ;
02:00048876 4A02            	  4204:     cmpi.b  #$00,D2
02:00048878 6602            	  4205:     bne.s  __far_z_07_0053
02:0004887A 6022            	  4206:     jmp  PlayerUnwalkable
                            	  4207: __far_z_07_0053:
