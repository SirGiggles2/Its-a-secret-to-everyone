02:000391CA 7006            	  2343:     moveq   #6,D0
02:000391CC 41EC03D0        	  2344:     lea     ($03D0,A4),A0
02:000391D0 11802000        	  2345:     move.b  D0,(A0,D2.W)
                            	  2346:     ; There are actually 6 frame images divided into 2 sets.
                            	  2347:     ; Each set depicts one animation frame. In each set there are
                            	  2348:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2349:     ;
                            	  2350:     ; The movement frame will keep track of the base offset of
                            	  2351:     ; the current set for the current animation frame: 0 or 3.
                            	  2352:     ;
                            	  2353:     ; So, XOR the movement frame with 3.
                            	  2354:     ;
02:000391D4 E208            	  2355:     lsr.b  #1,D0   ; LSR A
02:000391D6 41EC03E4        	  2356:     lea     ($03E4,A4),A0
02:000391DA 12302000        	  2357:     move.b  (A0,D2.W),D1
02:000391DE B300            	  2358:     eor.b  D1,D0
02:000391E0 41EC03E4        	  2359:     lea     ($03E4,A4),A0
02:000391E4 11802000        	  2360:     move.b  D0,(A0,D2.W)
                            	  2361:     even
