02:0003E660 6748            	  2793:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2794:     ; The direction is negative (left or up).
                            	  2795:     ;
                            	  2796:     ; If the coordinate does not cross (<) the boundary, then
                            	  2797:     ; go set mask $FF, so that no button is excluded.
                            	  2798:     ;
02:0003E662 102C0002        	  2799:     move.b  ($0002,A4),D0
02:0003E666 41F90003E5DA    	  2800:     lea     (BorderBounds).l,A0
02:0003E66C 12303000        	  2801:     move.b  (A0,D3.W),D1
02:0003E670 B001            	  2802:     cmp.b   D1,D0
02:0003E672 6548            	  2803:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2804:     even
