                            	  5334: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5335:     ; Bloated timer =>
                            	  5336:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5337:     ; 1:     go advance the substate
                            	  5338:     ; other: go decrement Bloated timer
                            	  5339:     ;
02:0003A72A 7600            	  5340:     moveq   #0,D3
02:0003A72C 41EC045E        	  5341:     lea     ($045E,A4),A0
02:0003A730 16302000        	  5342:     move.b  (A0,D2.W),D3
02:0003A734 5303            	  5343:     subq.b  #1,D3
02:0003A736 6750            	  5344:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A738 6B04            	  5345:     bmi.s  __far_z_04_0049
02:0003A73A 60000080        	  5346:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5347: __far_z_04_0049:
                            	  5348:     ; Set the bloated timer according to the substate.
                            	  5349:     ;
02:0003A73E 7600            	  5350:     moveq   #0,D3
02:0003A740 41EC042C        	  5351:     lea     ($042C,A4),A0
02:0003A744 16302000        	  5352:     move.b  (A0,D2.W),D3
02:0003A748 41F90003A686    	  5353:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A74E 10303000        	  5354:     move.b  (A0,D3.W),D0
02:0003A752 41EC045E        	  5355:     lea     ($045E,A4),A0
02:0003A756 11802000        	  5356:     move.b  D0,(A0,D2.W)
                            	  5357:     ; If substate <> 0, go decrement bloated timer.
                            	  5358:     ;
02:0003A75A 4A03            	  5359:     cmpi.b  #$00,D3
02:0003A75C 6702            	  5360:     beq.s  __far_z_04_0050
02:0003A75E 605C            	  5361:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5362: __far_z_04_0050:
                            	  5363:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5364:     ;
02:0003A760 7610            	  5365:     moveq   #16,D3
02:0003A762 7000            	  5366:     moveq   #0,D0
02:0003A764 41EC00AC        	  5367:     lea     ($00AC,A4),A0
02:0003A768 11803000        	  5368:     move.b  D0,(A0,D3.W)
                            	  5369:     ; Increment the number of bomb hits.
                            	  5370:     ;
02:0003A76C 41EC0437        	  5371:     lea     ($0437,A4),A0
02:0003A770 10302000        	  5372:     move.b  (A0,D2.W),D0
02:0003A774 023C00EE        	  5373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A778 123C0001        	  5374:     move.b  #$01,D1
02:0003A77C D101            	  5375:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A77E 41EC0437        	  5376:     lea     ($0437,A4),A0
02:0003A782 11802000        	  5377:     move.b  D0,(A0,D2.W)
02:0003A786 6034            	  5378:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  5379: 
                            	  5380:     even
                            	  5381: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5382:     ; Advance the substate.
                            	  5383:     ;
02:0003A788 41EC042C        	  5384:     lea     ($042C,A4),A0
02:0003A78C 52302000        	  5385:     addq.b  #1,(A0,D2.W)
                            	  5386:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5387:     ;
02:0003A790 41EC042C        	  5388:     lea     ($042C,A4),A0
02:0003A794 10302000        	  5389:     move.b  (A0,D2.W),D0
02:0003A798 0C000002        	  5390:     cmpi.b  #$02,D0
02:0003A79C 6402            	  5391:     bcc.s  __far_z_04_0051
02:0003A79E 601C            	  5392:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5393: __far_z_04_0051:
                            	  5394:     ; New bloated substate >= 2.
                            	  5395:     ;
                            	  5396:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5397:     ; which will transition to state 0 (moving).
                            	  5398:     ;
                            	  5399:     ; Note that if the bomb hits >= 2, then:
                            	  5400:     ; - If new substate = 2, then substate 2 will wait,
                            	  5401:     ;   and then transition to substate 3.
                            	  5402:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5403:     ;
02:0003A7A0 7600            	  5404:     moveq   #0,D3
02:0003A7A2 41EC0437        	  5405:     lea     ($0437,A4),A0
02:0003A7A6 16302000        	  5406:     move.b  (A0,D2.W),D3
02:0003A7AA 0C030002        	  5407:     cmpi.b  #$02,D3
02:0003A7AE 6502            	  5408:     bcs.s  __far_z_04_0052
02:0003A7B0 600A            	  5409:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5410: __far_z_04_0052:
02:0003A7B2 7004            	  5411:     moveq   #4,D0
02:0003A7B4 41EC042C        	  5412:     lea     ($042C,A4),A0
02:0003A7B8 11802000        	  5413:     move.b  D0,(A0,D2.W)
                            	  5414:     even
