02:0003928A 41EC0098        	  2459:     lea     ($0098,A4),A0
02:0003928E 10302000        	  2460:     move.b  (A0,D2.W),D0
02:00039292 02000002        	  2461:     andi.b #$02,D0
02:00039296 6704            	  2462:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  2463:     even
