                            	  6016:     ;
02:0003AC90 4EB900031056    	  6017:     jsr     CheckMonsterCollisions
02:0003AC96 41EC0405        	  6018:     lea     ($0405,A4),A0
02:0003AC9A 10302000        	  6019:     move.b  (A0,D2.W),D0
02:0003AC9E 678A            	  6020:     beq  _L_z04_UpdateLikeLike_Exit
                            	  6021:     ; But once it has died, then let Link move again.
                            	  6022:     ;
02:0003ACA0 7000            	  6023:     moveq   #0,D0
02:0003ACA2 19400512        	  6024:     move.b  D0,($0512,A4)
