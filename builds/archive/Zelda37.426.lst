                            	  6126:     ; decrement the distance remaining, and move.
                            	  6127:     ;
02:0003AD56 41EC0394        	  6128:     lea     ($0394,A4),A0
02:0003AD5A 10302000        	  6129:     move.b  (A0,D2.W),D0
02:0003AD5E 670A            	  6130:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003AD60 41EC0394        	  6131:     lea     ($0394,A4),A0
