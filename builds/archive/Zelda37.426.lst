02:0003E8F4 E308            	  3182:     lsl.b  #1,D0   ; ASL A
02:0003E8F6 E308            	  3183:     lsl.b  #1,D0   ; ASL A
02:0003E8F8 0000000D        	  3184:     ori.b #$0D,D0
02:0003E8FC 19400084        	  3185:     move.b  D0,($0084,A4)
