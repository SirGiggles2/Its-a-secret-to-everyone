                            	  2497: InitArmosOrFlyingGhini:
                            	  2498:     ; In UpdateObject, this object was flagged "initialized".
                            	  2499:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2500:     ;
02:000392BC 10342028        	  2501:     move.b  ($28,A4,D2.W),D0
02:000392C0 41EC0492        	  2502:     lea     ($0492,A4),A0
02:000392C4 11802000        	  2503:     move.b  D0,(A0,D2.W)
                            	  2504:     ; If it's still fading in, then go finish some initialization needed
                            	  2505:     ; for fading in.
                            	  2506:     ;
02:000392C8 660000B6        	  2507:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2508:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2509:     ; go finish initializing it.
                            	  2510:     ;
02:000392CC 41EC034F        	  2511:     lea     ($034F,A4),A0
02:000392D0 10302000        	  2512:     move.b  (A0,D2.W),D0
02:000392D4 0C000022        	  2513:     cmpi.b  #$22,D0
02:000392D8 670000A6        	  2514:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2515:     ; Else we have an armos.
                            	  2516:     ;
                            	  2517:     ; Store stairs tile $70 in [00] for use later.
                            	  2518:     ;
02:000392DC 7070            	  2519:     moveq   #112,D0
02:000392DE 1880            	  2520:     move.b  D0,($0000,A4)
                            	  2521:     ; Look for the current room ID in an array of room ID's that
                            	  2522:     ; have armos secrets.
                            	  2523:     ;
02:000392E0 7606            	  2524:     moveq   #6,D3
                            	  2525:     even
                            	  2526: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:000392E2 102C00EB        	  2527:     move.b  ($00EB,A4),D0
                            	  2528:     ; If this element does not match the current room ID, go loop again.
                            	  2529:     ;
02:000392E6 41F9000392AC    	  2530:     lea     (SecretArmosRoomIds).l,A0
02:000392EC 12303000        	  2531:     move.b  (A0,D3.W),D1
02:000392F0 B001            	  2532:     cmp.b   D1,D0
02:000392F2 6648            	  2533:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2534:     ; The secret (usually stairs) is under one of the armoses.
                            	  2535:     ;
                            	  2536:     ; If the armos's X coordinate does not match the one needed
                            	  2537:     ; for the current room in the list, then go loop again.
                            	  2538:     ;
02:000392F4 10342070        	  2539:     move.b  ($70,A4,D2.W),D0
02:000392F8 41F9000392B4    	  2540:     lea     (SecretArmosXs).l,A0
02:000392FE 12303000        	  2541:     move.b  (A0,D3.W),D1
02:00039302 B001            	  2542:     cmp.b   D1,D0
02:00039304 6636            	  2543:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2544:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2545:     ;
02:00039306 41EC0084        	  2546:     lea     ($0084,A4),A0
02:0003930A 10302000        	  2547:     move.b  (A0,D2.W),D0
02:0003930E 0C000080        	  2548:     cmpi.b  #$80,D0
02:00039312 6628            	  2549:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2550:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2551:     ;
02:00039314 4A03            	  2552:     cmpi.b  #$00,D3
02:00039316 662C            	  2553:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2554:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2555:     ; has the power bracelet.
                            	  2556:     ;
                            	  2557:     ; Set up the room item with the armos's coordinates.
                            	  2558:     ;
02:00039318 19400097        	  2559:     move.b  D0,($0097,A4)
02:0003931C 10342070        	  2560:     move.b  ($70,A4,D2.W),D0
02:00039320 19400083        	  2561:     move.b  D0,($0083,A4)
                            	  2562:     ; This resets the room item's state, which activates it.
                            	  2563:     ;
02:00039324 194300BF        	  2564:     move.b  D3,($00BF,A4)
                            	  2565:     ; Set the room item ID.
                            	  2566:     ;
02:00039328 7014            	  2567:     moveq   #20,D0
02:0003932A 194000AB        	  2568:     move.b  D0,($00AB,A4)
                            	  2569:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2570:     ;
                            	  2571:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2572:     ;
                            	  2573:     ; Note that, if the item was already taken, then the room item
                            	  2574:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2575:     ; it will be ignored, because that routine checks whether
                            	  2576:     ; the item was taken.
                            	  2577:     ;
02:0003932E 4EB900030A22    	  2578:     jsr     GetRoomFlagUWItemState
02:00039334 660A            	  2579:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00039336 6100069E        	  2580:     jsr     PlaySecretFoundTune
02:0003933A 6604            	  2581:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2582:     even
                            	  2583: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  2584:     ; Bottom of the loop.
                            	  2585:     ;
02:0003933C 5303            	  2586:     subq.b  #1,D3
02:0003933E 6AA2            	  2587:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  2588:     even
                            	  2589: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  2590:     ; Not found, or found the power bracelet.
                            	  2591:     ; Use a floor tile $26 to replace the armos.
                            	  2592:     ;
02:00039340 7026            	  2593:     moveq   #38,D0
02:00039342 1880            	  2594:     move.b  D0,($0000,A4)
                            	  2595:     even
                            	  2596: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:00039344 1014            	  2597:     move.b  ($0000,A4),D0
                            	  2598:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  2599:     ;
02:00039346 1B00            	  2600:     move.b  D0,-(A5)  ; PHA
02:00039348 0C000070        	  2601:     cmpi.b  #$70,D0
02:0003934C 6604            	  2602:     bne  _anon_z04_51
02:0003934E 61000686        	  2603:     jsr     PlaySecretFoundTune
                            	  2604: _anon_z04_51:
                            	  2605:     ; Replace the tile where the armos was.
                            	  2606:     ;
02:00039352 522C00F7        	  2607:     addq.b  #1,($00F7,A4)
02:00039356 101D            	  2608:     move.b  (A5)+,D0  ; PLA
02:00039358 4EB900047B20    	  2609:     jsr     ChangeTileObjTiles
                            	  2610:     ; Because the armos object is aligned to the square grid
                            	  2611:     ; (because it was made from a square),
                            	  2612:     ; set its grid offset to 3 to compensate.
                            	  2613:     ;
                            	  2614:     ; Most objects are aligned to the grid vertically when the
                            	  2615:     ; low nibble is $D.
                            	  2616:     ;
02:0003935E 7003            	  2617:     moveq   #3,D0
02:00039360 41EC0394        	  2618:     lea     ($0394,A4),A0
02:00039364 11802000        	  2619:     move.b  D0,(A0,D2.W)
                            	  2620:     ; Set a speed (q-speed fraction) randomly:
                            	  2621:     ; $20 if random value < $80
                            	  2622:     ; $60 otherwise
                            	  2623:     ;
02:00039368 7020            	  2624:     moveq   #32,D0
02:0003936A 7600            	  2625:     moveq   #0,D3
02:0003936C 16342019        	  2626:     move.b  ($19,A4,D2.W),D3
02:00039370 0C030080        	  2627:     cmpi.b  #$80,D3
02:00039374 6502            	  2628:     bcs  _anon_z04_52
02:00039376 7060            	  2629:     moveq   #96,D0
                            	  2630: _anon_z04_52:
02:00039378 41EC03BC        	  2631:     lea     ($03BC,A4),A0
02:0003937C 11802000        	  2632:     move.b  D0,(A0,D2.W)
                            	  2633:     even
                            	  2634: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  2635:     ; Facing and input directions down.
                            	  2636:     ;
02:00039380 7004            	  2637:     moveq   #4,D0
02:00039382 41EC03F8        	  2638:     lea     ($03F8,A4),A0
02:00039386 11802000        	  2639:     move.b  D0,(A0,D2.W)
02:0003938A 41EC0098        	  2640:     lea     ($0098,A4),A0
02:0003938E 11802000        	  2641:     move.b  D0,(A0,D2.W)
                            	  2642:     ; Every other frame, return without drawing.
                            	  2643:     ;
02:00039392 10342028        	  2644:     move.b  ($28,A4,D2.W),D0
02:00039396 E208            	  2645:     lsr.b  #1,D0   ; LSR A
02:00039398 6512            	  2646:     bcs  _anon_z04_53
                            	  2647:     ; Finish initializing based on type.
                            	  2648:     ;
02:0003939A 41EC034F        	  2649:     lea     ($034F,A4),A0
02:0003939E 10302000        	  2650:     move.b  (A0,D2.W),D0
02:000393A2 0C000022        	  2651:     cmpi.b  #$22,D0
