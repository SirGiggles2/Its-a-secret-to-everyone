02:0003CF2C 1B00            	   283:     move.b  D0,-(A5)  ; PHA
02:0003CF2E 4EB9000476F0    	   284:     jsr     HideAllSprites
02:0003CF34 101D            	   285:     move.b  (A5)+,D0  ; PLA
