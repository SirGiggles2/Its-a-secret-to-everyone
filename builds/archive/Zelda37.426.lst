02:00048D78 6438            	  4953:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4954:     ; Add the object's Y (the center of the spread) and the
                            	  4955:     ; current offset in [03] to set sprite Y in [01].
                            	  4956:     ;
02:00048D7A 41EC0084        	  4957:     lea     ($0084,A4),A0
02:00048D7E 10302000        	  4958:     move.b  (A0,D2.W),D0
02:00048D82 023C00EE        	  4959:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048D86 122C0003        	  4960:     move.b  ($0003,A4),D1
02:00048D8A D101            	  4961:     addx.b  D1,D0   ; ADC $03
02:00048D8C 19400001        	  4962:     move.b  D0,($0001,A4)
                            	  4963:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4964:     ;
02:00048D90 7600            	  4965:     moveq   #0,D3
02:00048D92 162C0010        	  4966:     move.b  ($0010,A4),D3
