                            	  4066: PlayerScreenEdgeBounds:
02:000487F8 3D              	  4067:     dc.b    $3D, $DD, $00, $F0
02:000487F9 DD
02:000487FA 00
02:000487FB F0
                            	  4068: 
                            	  4069: ; Params:
                            	  4070: ; [0E]: $FF, if blocked by a door
                            	  4071: ; [0F]: movement direction
                            	  4072: ;
                            	  4073: ; Returns:
                            	  4074: ; [0F]: untouched, or changed if blocked or need to change
                            	  4075: ;
                            	  4076: ; Summary:
                            	  4077: ;
                            	  4078: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4079: ; Then allow movement or go to the next room. Otherwise,
                            	  4080: ; check passive tile objects and stop moving.
                            	  4081: ;
                            	  4082: ; For other objects: First, if moving, test the colliding tile for
                            	  4083: ; walkability. Otherwise search for a walkable direction starting
                            	  4084: ; from input direction.
                            	  4085: ;
                            	  4086: ; When you find a walkable direction, see if it makes the object
                            	  4087: ; cross a boundary. If it doesn't, then make this direction
                            	  4088: ; the objection direction. Otherwise, keep looping.
                            	  4089: ;
                            	  4090: ; If no walkable direction is found, then stop moving.
                            	  4091: ;
                            	  4092: ;
                            	  4093: ; if is player
                            	  4094: ;   if at doorway
                            	  4095: ;     go handle a walkable direction
                            	  4096: ;   if blocked by door
                            	  4097: ;     return
                            	  4098: ;
                            	  4099:     even
                            	  4100: Walker_CheckTileCollision:
                            	  4101:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4102:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4103:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4104:     ; reset) for Link and every other object. Only the tile
                            	  4105:     ; walkability decision in CheckTiles is overridden.
02:000487FC 4A02            	  4106:     cmpi.b  #$00,D2
02:000487FE 6614            	  4107:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:00048800 102C0053        	  4108:     move.b  ($0053,A4),D0
02:00048804 6704            	  4109:     beq  _anon_z07_16
02:00048806 600000BE        	  4110:     jmp     GoWalkableDir
                            	  4111: 
                            	  4112: _anon_z07_16:
02:0004880A 102C000E        	  4113:     move.b  ($000E,A4),D0
02:0004880E 6A04            	  4114:     bpl.s  __far_z_07_0047
02:00048810 600000AC        	  4115:     jmp  L1F148_Exit
                            	  4116: __far_z_07_0047:
                            	  4117:     even
                            	  4118: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4119:     ; If grid offset <> 0, return.
                            	  4120:     ;
02:00048814 41EC0394        	  4121:     lea     ($0394,A4),A0
02:00048818 10302000        	  4122:     move.b  (A0,D2.W),D0
02:0004881C 6704            	  4123:     beq.s  __far_z_07_0048
02:0004881E 6000009E        	  4124:     jmp  L1F148_Exit
                            	  4125: __far_z_07_0048:
                            	  4126:     ; Grid offset = 0.
                            	  4127:     ; The object is at a point between cells in the grid.
                            	  4128:     ; So, we can check tiles for collision.
                            	  4129:     ;
                            	  4130:     ; Reset [0E] alternate direction search step.
                            	  4131:     ;
02:00048822 1940000E        	  4132:     move.b  D0,($000E,A4)
                            	  4133:     ; If there's a movement direction, go check tile collision.
                            	  4134:     ;
02:00048826 102C000F        	  4135:     move.b  ($000F,A4),D0
02:0004882A 6702            	  4136:     beq.s  __far_z_07_0049
02:0004882C 602E            	  4137:     jmp  CheckTiles
                            	  4138: __far_z_07_0049:
                            	  4139:     ; Moving direction = 0.
                            	  4140:     ; If object is the player, return.
                            	  4141:     ;
02:0004882E 4A02            	  4142:     cmpi.b  #$00,D2
02:00048830 6604            	  4143:     bne.s  __far_z_07_0050
02:00048832 6000008A        	  4144:     jmp  L1F148_Exit
                            	  4145: __far_z_07_0050:
                            	  4146:     ; Moving direction = 0.
                            	  4147:     ; The object is not the player.
