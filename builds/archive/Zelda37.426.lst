02:0003EB8C 4EB90003099E    	  3610:     jsr     AddToInt16At0
02:0003EB92 5303            	  3611:     subq.b  #1,D3
02:0003EB94 66F4            	  3612:     bne  _anon_z05_89
                            	  3613:     even
                            	  3614: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3615:     ; Turn the row part of [0A] into a tile index.
                            	  3616:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3617:     ;
02:0003EB96 102C000A        	  3618:     move.b  ($000A,A4),D0
02:0003EB9A 020000F0        	  3619:     andi.b #$F0,D0
02:0003EB9E 003C0011        	  3620:     ori     #$11,CCR  ; SEC: set C+X
02:0003EBA2 123C0040        	  3621:     move.b  #$40,D1
02:0003EBA6 0A3C0010        	  3622:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EBAA 9101            	  3623:     subx.b  D1,D0   ; SBC #$40
02:0003EBAC 0A3C0010        	  3624:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EBB0 E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003EBB2 E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:0003EBB4 E208            	  3627:     lsr.b  #1,D0   ; LSR A
02:0003EBB6 7600            	  3628:     moveq   #0,D3
02:0003EBB8 1600            	  3629:     move.b  D0,D3
                            	  3630:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3631:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3632:     ; when coming in from the edges.
                            	  3633:     ;
02:0003EBBA 1214            	  3634:     move.b  ($00,A4),D1   ; ptr lo
02:0003EBBC 182C0001        	  3635:     move.b  ($01,A4),D4  ; ptr hi
02:0003EBC0 024100FF        	  3636:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003EBC4 E14C            	  3637:     lsl.w   #8,D4
02:0003EBC6 8841            	  3638:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003EBC8 48C4            	  3639:     ext.l   D4
02:0003EBCA D8BC00FF0000    	  3640:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003EBD0 2044            	  3641:     movea.l D4,A0
02:0003EBD2 10303000        	  3642:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003EBD6 0C000084        	  3643:     cmpi.b  #$84,D0
02:0003EBDA 650E            	  3644:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3645:     ; Bottom of the loop.
                            	  3646:     ; If you reach the original cell, then stop.
                            	  3647:     ;
02:0003EBDC 102C000A        	  3648:     move.b  ($000A,A4),D0
02:0003EBE0 122C0525        	  3649:     move.b  ($0525,A4),D1
02:0003EBE4 B001            	  3650:     cmp.b   D1,D0
02:0003EBE6 6600FF44        	  3651:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3652:     even
