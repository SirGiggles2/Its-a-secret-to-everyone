02:0003CC40 122C0003        	 10423:     move.b  ($0003,A4),D1
02:0003CC44 0A3C0010        	 10424:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CC48 9101            	 10425:     subx.b  D1,D0   ; SBC $03
02:0003CC4A 0A3C0010        	 10426:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CC4E 6024            	 10427:     jmp     _L_z04_RotateObjectLocation_SetXRotateY
                            	 10428: 
