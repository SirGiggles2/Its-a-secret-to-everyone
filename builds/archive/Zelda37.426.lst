                            	  9006:     ; is the letter, but we have a potion, then skip this.
                            	  9007:     ;
                            	  9008:     ; If the letter is selected and there's no potion, then make
                            	  9009:     ; the item value 1 in [04]. Except that, the call to 05:B81C
                            	  9010:     ; below will overwrite [04].
