02:0004169E 1B00            	  7358:     move.b  D0,-(A5)  ; PHA
02:000416A0 02000007        	  7359:     andi.b #$07,D0
02:000416A4 0C000002        	  7360:     cmpi.b  #$02,D0
02:000416A8 6606            	  7361:     bne  _anon_z05_156
02:000416AA 7004            	  7362:     moveq   #4,D0
