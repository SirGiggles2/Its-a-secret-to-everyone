                            	  2474: ;==============================================================================
                            	  2475: ; EXPORT side — carry-returning shims.
                            	  2476: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2477: ; reproduces the original function's carry normalization.
                            	  2478: ;==============================================================================
                            	  2479: 
                            	  2480: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2481: c_copy_next_row_to_transfer_buf:
02:0002BF82 4EB900000000    	  2482:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF88 08000008        	  2483:     btst    #8,D0
02:0002BF8C 670A            	  2484:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2485:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2486:     eori    #$01,CCR
02:0002BF96 4E75            	  2487:     rts
                            	  2488: .cc_cnr:
02:0002BF98 023C00FE        	  2489:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2490:     eori    #$01,CCR
02:0002BFA0 4E75            	  2491:     rts
                            	  2492: 
