02:00038E52 7600            	  1882:     moveq   #0,D3
02:00038E54 41EC00AC        	  1883:     lea     ($00AC,A4),A0
02:00038E58 16302000        	  1884:     move.b  (A0,D2.W),D3
02:00038E5C 41F900038DB8    	  1885:     lea     (BlueLeeverStateAnimTimes).l,A0
