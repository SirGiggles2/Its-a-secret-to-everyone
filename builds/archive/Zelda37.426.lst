                            	  9350: Ganon_CheckCollisions:
                            	  9351:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  9352:     ; Store in [02] and [03].
                            	  9353:     ;
02:0003C554 10342070        	  9354:     move.b  ($70,A4,D2.W),D0
02:0003C558 023C00EE        	  9355:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C55C 123C0010        	  9356:     move.b  #$10,D1
02:0003C560 D101            	  9357:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C562 19400002        	  9358:     move.b  D0,($0002,A4)
02:0003C566 41EC0084        	  9359:     lea     ($0084,A4),A0
02:0003C56A 10302000        	  9360:     move.b  (A0,D2.W),D0
02:0003C56E 023C00EE        	  9361:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C572 123C0010        	  9362:     move.b  #$10,D1
02:0003C576 D101            	  9363:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C578 19400003        	  9364:     move.b  D0,($0003,A4)
                            	  9365:     ; Check for a collision with Link.
                            	  9366:     ;
                            	  9367:     ; We can't call CheckLinkCollision, because we need to
                            	  9368:     ; customize Ganon's midpoint.
                            	  9369:     ;
                            	  9370:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  9371:     ; detection, if Link is invincible. Initialize variables that will
                            	  9372:     ; be returned from the partial collision check routine. Then
                            	  9373:     ; call it.
                            	  9374:     ;
02:0003C57C 102C04F0        	  9375:     move.b  ($04F0,A4),D0
02:0003C580 6616            	  9376:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C582 19400006        	  9377:     move.b  D0,($0006,A4)
02:0003C586 19400009        	  9378:     move.b  D0,($0009,A4)
02:0003C58A 1940000C        	  9379:     move.b  D0,($000C,A4)
02:0003C58E 7600            	  9380:     moveq   #0,D3
02:0003C590 1883            	  9381:     move.b  D3,($0000,A4)
02:0003C592 4EB9000310C0    	  9382:     jsr     CheckLinkCollisionPreinit
                            	  9383:     even
                            	  9384: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  9385:     ; If Ganon is not in state 0, then he's brown.
                            	  9386:     ; Go check collision with an arrow.
                            	  9387:     ;
02:0003C598 41EC00AC        	  9388:     lea     ($00AC,A4),A0
02:0003C59C 10302000        	  9389:     move.b  (A0,D2.W),D0
02:0003C5A0 6652            	  9390:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  9391:     ; If timer <> 0, then Ganon is visible.
                            	  9392:     ; He can't be harmed like this. So, return.
                            	  9393:     ;
02:0003C5A2 10342028        	  9394:     move.b  ($28,A4,D2.W),D0
02:0003C5A6 664A            	  9395:     bne  _L_z04_Ganon_CheckCollisions_Exit
