02:000406AC 101D            	  5919:     move.b  (A5)+,D0  ; PLA
02:000406AE E308            	  5920:     lsl.b  #1,D0   ; ASL A
02:000406B0 E308            	  5921:     lsl.b  #1,D0   ; ASL A
02:000406B2 1880            	  5922:     move.b  D0,($0000,A4)
02:000406B4 4EB9000309A6    	  5923:     jsr     AddToInt16At2
02:000406BA 1014            	  5924:     move.b  ($0000,A4),D0
02:000406BC 4EB9000309A6    	  5925:     jsr     AddToInt16At2
02:000406C2 1014            	  5926:     move.b  ($0000,A4),D0
02:000406C4 4EB9000309A6    	  5927:     jsr     AddToInt16At2
02:000406CA 103C008C        	  5928:     move.b  #$8C,D0
