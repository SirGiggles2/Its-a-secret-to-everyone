02:00040692 7005            	  5911:     moveq   #5,D0
02:00040694 4EB90002A9FA    	  5912:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:0004069A 6100747E        	  5913:     jsr     GetUniqueRoomId
