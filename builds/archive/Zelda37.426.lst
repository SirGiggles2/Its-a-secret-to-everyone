02:0003C468 41F90003C338    	  9233:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003C46E 12302000        	  9234:     move.b  (A0,D2.W),D1
02:0003C472 8001            	  9235:     or.b  D1,D0
02:0003C474 19400003        	  9236:     move.b  D0,($0003,A4)
02:0003C478 41F90003C342    	  9237:     lea     (GanonBurstTiles).l,A0
