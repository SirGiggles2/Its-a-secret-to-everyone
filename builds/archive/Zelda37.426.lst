                            	  5651:     ; in order to work on the second row of door tiles.
                            	  5652:     ;
02:000404BE 7020            	  5653:     moveq   #32,D0
02:000404C0 122C0001        	  5654:     move.b  ($0001,A4),D1
02:000404C4 8001            	  5655:     or.b  D1,D0
02:000404C6 19400001        	  5656:     move.b  D0,($0001,A4)
                            	  5657:     ; Bottom of the loop.
                            	  5658:     ; Loop again to write the second transfer record for the
                            	  5659:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5660:     ;
02:000404CA 532C0005        	  5661:     subq.b  #1,($0005,A4)
02:000404CE 66B8            	  5662:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5663:     ; Write the end marker, and update buffer length.
                            	  5664:     ;
02:000404D0 103C00FF        	  5665:     move.b  #$FF,D0
02:000404D4 41EC0302        	  5666:     lea     ($0302,A4),A0
02:000404D8 11802000        	  5667:     move.b  D0,(A0,D2.W)
02:000404DC 1002            	  5668:     move.b  D2,D0
02:000404DE 19400301        	  5669:     move.b  D0,($0301,A4)
                            	  5670:     ; Increment the command.
                            	  5671:     ;
02:000404E2 522C0054        	  5672:     addq.b  #1,($0054,A4)
                            	  5673:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5674:     ; and resetting the door command.
                            	  5675:     ; This ends up catching original states 3 and 7.
                            	  5676:     ;
                            	  5677:     ; Else set door timer to 8 and return.
                            	  5678:     ;
02:000404E6 102C0054        	  5679:     move.b  ($0054,A4),D0
02:000404EA 02000003        	  5680:     andi.b #$03,D0
02:000404EE 6708            	  5681:     beq  _anon_z05_122
02:000404F0 7008            	  5682:     moveq   #8,D0
02:000404F2 19400027        	  5683:     move.b  D0,($0027,A4)
02:000404F6 4E75            	  5684:     rts
                            	  5685: 
                            	  5686: _anon_z05_122:
                            	  5687:     ; If the door command = 4 after incrementing it, then
                            	  5688:     ; it was 3 (close door). So:
                            	  5689:     ; 1. reset this door's flag
                            	  5690:     ; 2. remove it from the opened door mask
                            	  5691:     ; 3. reset the door command
                            	  5692:     ; 4. go lay out doors in the play area map
                            	  5693:     ;
02:000404F8 102C0054        	  5694:     move.b  ($0054,A4),D0
02:000404FC 0C000004        	  5695:     cmpi.b  #$04,D0
02:00040500 6626            	  5696:     bne  _anon_z05_123
02:00040502 7400            	  5697:     moveq   #0,D2
02:00040504 142C0009        	  5698:     move.b  ($0009,A4),D2
02:00040508 6100DCE2        	  5699:     jsr     ResetDoorFlag
02:0004050C 102C0055        	  5700:     move.b  ($0055,A4),D0
02:00040510 0A00000F        	  5701:     eori.b #$0F,D0
02:00040514 122C00EE        	  5702:     move.b  ($00EE,A4),D1
02:00040518 C001            	  5703:     and.b  D1,D0
                            	  5704:     even
                            	  5705: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004051A 194000EE        	  5706:     move.b  D0,($00EE,A4)
                            	  5707:     even
                            	  5708: L_ResetDoorCmdAndLayOutDoors:
02:0004051E 7000            	  5709:     moveq   #0,D0
02:00040520 19400054        	  5710:     move.b  D0,($0054,A4)
02:00040524 6000FCD4        	  5711:     jmp     LayOutDoors
                            	  5712: 
                            	  5713: _anon_z05_123:
                            	  5714:     ; Door command <> 4.
                            	  5715:     ; It must be 8, which means it was 7: open door.
                            	  5716:     ;
                            	  5717:     ; If the door is a shutter (7), then go add the door to the
                            	  5718:     ; opened door mask, reset door command, and lay out doors.
                            	  5719:     ;
02:00040528 102C0055        	  5720:     move.b  ($0055,A4),D0
02:0004052C 19400002        	  5721:     move.b  D0,($0002,A4)
02:00040530 6100FA32        	  5722:     jsr     FindDoorAttrByDoorBit
02:00040534 0C000007        	  5723:     cmpi.b  #$07,D0
02:00040538 676E            	  5724:     beq  _anon_z05_124
                            	  5725:     ; Else the door is not a shutter.
                            	  5726:     ;
                            	  5727:     ;
                            	  5728:     ; [09] door direction index
02:0004053A 7400            	  5729:     moveq   #0,D2
02:0004053C 142C0009        	  5730:     move.b  ($0009,A4),D2
02:00040540 6100DCA4        	  5731:     jsr     SetDoorFlag
                            	  5732:     ; Get the next room's ID.
                            	  5733:     ;
02:00040544 1003            	  5734:     move.b  D3,D0
02:00040546 023C00EE        	  5735:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004054A 41F900040406    	  5736:     lea     (DoorNextRoomIdOffsets).l,A0
02:00040550 12302000        	  5737:     move.b  (A0,D2.W),D1
02:00040554 D101            	  5738:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00040556 7600            	  5739:     moveq   #0,D3
02:00040558 1600            	  5740:     move.b  D0,D3
                            	  5741:     ; Flip the door direction index.
                            	  5742:     ;
02:0004055A 1002            	  5743:     move.b  D2,D0
02:0004055C 0A000001        	  5744:     eori.b #$01,D0
02:00040560 7400            	  5745:     moveq   #0,D2
02:00040562 1400            	  5746:     move.b  D0,D2
                            	  5747:     ; Set the door flag for the opposite door in the next room.
                            	  5748:     ;
02:00040564 1214            	  5749:     move.b  ($00,A4),D1   ; ptr lo
02:00040566 182C0001        	  5750:     move.b  ($01,A4),D4  ; ptr hi
02:0004056A 024100FF        	  5751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004056E E14C            	  5752:     lsl.w   #8,D4
02:00040570 8841            	  5753:     or.w    D1,D4             ; D4 = NES ptr addr
02:00040572 48C4            	  5754:     ext.l   D4
02:00040574 D8BC00FF0000    	  5755:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004057A 2044            	  5756:     movea.l D4,A0
02:0004057C 10303000        	  5757:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040580 41F900047850    	  5758:     lea     (LevelMasks).l,A0
02:00040586 12302000        	  5759:     move.b  (A0,D2.W),D1
02:0004058A 8001            	  5760:     or.b  D1,D0
02:0004058C 1214            	  5761:     move.b  ($00,A4),D1   ; ptr lo
02:0004058E 182C0001        	  5762:     move.b  ($01,A4),D4  ; ptr hi
02:00040592 024100FF        	  5763:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040596 E14C            	  5764:     lsl.w   #8,D4
02:00040598 8841            	  5765:     or.w    D1,D4
02:0004059A 48C4            	  5766:     ext.l   D4
02:0004059C D8BC00FF0000    	  5767:     add.l   #NES_RAM,D4
02:000405A2 2044            	  5768:     movea.l D4,A0
02:000405A4 11803000        	  5769:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5770: _anon_z05_124:
                            	  5771:     ; Add the door to the opened door mask, reset door command,
                            	  5772:     ; and lay out doors.
                            	  5773:     ;
02:000405A8 102C0055        	  5774:     move.b  ($0055,A4),D0
02:000405AC 122C00EE        	  5775:     move.b  ($00EE,A4),D1
02:000405B0 8001            	  5776:     or.b  D1,D0
02:000405B2 6000FF66        	  5777:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5778: 
                            	  5779: ; Params:
                            	  5780: ; [08]: 0 if closed
                            	  5781: ;
                            	  5782: ; Returns:
                            	  5783: ; X: current length of dynamic transfer buf
                            	  5784: ; [00]: door VRAM address high byte
                            	  5785: ; [01]: door VRAM address low byte
                            	  5786: ; [02:03]: address of door tiles for direction and face
                            	  5787: ; [05]: 2, the number of transfer records to write
                            	  5788: ; [06]: 2, the number of tiles in each record
                            	  5789: ; [07]: 0, the first index of a tile to transfer
                            	  5790: ; [09]: door direction index
                            	  5791: ;
                            	  5792: ; Note that this routine is called with triggered doors:
                            	  5793: ; doors that can change state. Their door type numbers are >= 4.
                            	  5794: ;
                            	  5795: ; If this routine were ever called with a fixed door
                            	  5796: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5797: ; values for the door face.
                            	  5798: ;
                            	  5799: ;
                            	  5800: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5801: ;
                            	  5802:     even
                            	  5803: PrepareWriteHorizontalDoorTransferRecords:
02:000405B6 102C0055        	  5804:     move.b  ($0055,A4),D0
02:000405BA 19400002        	  5805:     move.b  D0,($0002,A4)
02:000405BE 6100F9A4        	  5806:     jsr     FindDoorAttrByDoorBit
02:000405C2 0C000005        	  5807:     cmpi.b  #$05,D0
02:000405C6 650C            	  5808:     bcs  _anon_z05_125
02:000405C8 1B00            	  5809:     move.b  D0,-(A5)  ; PHA
02:000405CA 7004            	  5810:     moveq   #4,D0
02:000405CC 4EB900030868    	  5811:     jsr     PlaySample
02:000405D2 101D            	  5812:     move.b  (A5)+,D0  ; PLA
                            	  5813: _anon_z05_125:
                            	  5814:     ; Calculate the door face index in three parts.
                            	  5815:     ;
                            	  5816:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5817:     ; (provisional face index in Y register).
                            	  5818:     ;
02:000405D4 0C000004        	  5819:     cmpi.b  #$04,D0
02:000405D8 6602            	  5820:     bne  _anon_z05_126
02:000405DA 7008            	  5821:     moveq   #8,D0
                            	  5822: _anon_z05_126:
02:000405DC 0C000001        	  5823:     cmpi.b  #$01,D0
02:000405E0 6602            	  5824:     bne  _anon_z05_127
02:000405E2 7004            	  5825:     moveq   #4,D0
                            	  5826: _anon_z05_127:
                            	  5827:     ; Second, subtract 3 from provisional face index.
                            	  5828:     ;
02:000405E4 003C0011        	  5829:     ori     #$11,CCR  ; SEC: set C+X
02:000405E8 123C0003        	  5830:     move.b  #$03,D1
02:000405EC 0A3C0010        	  5831:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000405F0 9101            	  5832:     subx.b  D1,D0   ; SBC #$03
02:000405F2 0A3C0010        	  5833:     eori    #$10,CCR  ; restore X = 6502 C
02:000405F6 7600            	  5834:     moveq   #0,D3
02:000405F8 1600            	  5835:     move.b  D0,D3
                            	  5836:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5837:     ; face index >= 3, then subtract 1 from it.
                            	  5838:     ;
                            	  5839:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5840:     ; then make it 1.
                            	  5841:     ;
02:000405FA 102C0008        	  5842:     move.b  ($0008,A4),D0
02:000405FE 6708            	  5843:     beq  _anon_z05_128
02:00040600 0C030005        	  5844:     cmpi.b  #$05,D3
02:00040604 670A            	  5845:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00040606 7601            	  5846:     moveq   #1,D3
                            	  5847: _anon_z05_128:
02:00040608 0C030003        	  5848:     cmpi.b  #$03,D3
02:0004060C 6502            	  5849:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0004060E 5303            	  5850:     subq.b  #1,D3
                            	  5851:     even
                            	  5852: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5853:     ; The routine that returned the door type also returned its
                            	  5854:     ; reverse direction index in [03].
                            	  5855:     ;
                            	  5856:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5857:     ;
02:00040610 7003            	  5858:     moveq   #3,D0
02:00040612 003C0011        	  5859:     ori     #$11,CCR  ; SEC: set C+X
02:00040616 122C0003        	  5860:     move.b  ($0003,A4),D1
02:0004061A 0A3C0010        	  5861:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004061E 9101            	  5862:     subx.b  D1,D0   ; SBC $03
02:00040620 0A3C0010        	  5863:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5864:     ; Call this to put the address of door face tiles in [02:03].
                            	  5865:     ;
02:00040624 6100FD7A        	  5866:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5867:     ; Return the address of the door in the nametable in [01:00].
                            	  5868:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5869:     ;
02:00040628 41F9000403FE    	  5870:     lea     (DoorVramAddrsHi).l,A0
02:0004062E 10302000        	  5871:     move.b  (A0,D2.W),D0
02:00040632 1880            	  5872:     move.b  D0,($0000,A4)
02:00040634 41F900040402    	  5873:     lea     (DoorVramAddrsLo).l,A0
02:0004063A 10302000        	  5874:     move.b  (A0,D2.W),D0
02:0004063E 19400001        	  5875:     move.b  D0,($0001,A4)
                            	  5876:     ; Return the direction of the door in [09], and the dynamic
                            	  5877:     ; transfer buf length in X register.
                            	  5878:     ;
02:00040642 19420009        	  5879:     move.b  D2,($0009,A4)
02:00040646 7400            	  5880:     moveq   #0,D2
02:00040648 142C0301        	  5881:     move.b  ($0301,A4),D2
                            	  5882:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5883:     ;
02:0004064C 7000            	  5884:     moveq   #0,D0
02:0004064E 19400007        	  5885:     move.b  D0,($0007,A4)
02:00040652 7002            	  5886:     moveq   #2,D0
02:00040654 19400006        	  5887:     move.b  D0,($0006,A4)
02:00040658 19400005        	  5888:     move.b  D0,($0005,A4)
02:0004065C 0A3C0001        	  5889:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00040660 4E75            	  5890:     rts
                            	  5891: 
                            	  5892:     even
