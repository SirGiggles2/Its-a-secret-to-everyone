02:0003ABD0 41EC03E4        	  5931:     lea     ($03E4,A4),A0
02:0003ABD4 10302000        	  5932:     move.b  (A0,D2.W),D0
02:0003ABD8 4EB900030CE6    	  5933:     jsr     DrawObjectMirrored
                            	  5934:     ; Check collisions. If Link was not captured, then return.
                            	  5935:     ;
02:0003ABDE 4EB900031056    	  5936:     jsr     CheckMonsterCollisions
02:0003ABE4 41EC042C        	  5937:     lea     ($042C,A4),A0
02:0003ABE8 10302000        	  5938:     move.b  (A0,D2.W),D0
02:0003ABEC 673C            	  5939:     beq  _L_z04_UpdateLikeLike_Exit
                            	  5940:     ; The monster captured Link.
                            	  5941:     ; Put the monster at the same location as him.
                            	  5942:     ;
