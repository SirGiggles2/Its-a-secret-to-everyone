                            	  7185: _anon_z04_111:
                            	  7186:     ; Store in [00] the animation frame that you get from the frame accumulator:
                            	  7187:     ; frame := ((accumulator AND $10) >> 4
                            	  7188:     ;
02:0003B550 41EC0451        	  7189:     lea     ($0451,A4),A0
02:0003B554 10302000        	  7190:     move.b  (A0,D2.W),D0
02:0003B558 02000010        	  7191:     andi.b #$10,D0
02:0003B55C E208            	  7192:     lsr.b  #1,D0   ; LSR A
02:0003B55E E208            	  7193:     lsr.b  #1,D0   ; LSR A
02:0003B560 E208            	  7194:     lsr.b  #1,D0   ; LSR A
02:0003B562 E208            	  7195:     lsr.b  #1,D0   ; LSR A
02:0003B564 1880            	  7196:     move.b  D0,($0000,A4)
                            	  7197:     ; Copy the animation frame bit into the "frame image and
                            	  7198:     ; sprite attributes" byte.
                            	  7199:     ;
02:0003B566 41EC0478        	  7200:     lea     ($0478,A4),A0
02:0003B56A 10302000        	  7201:     move.b  (A0,D2.W),D0
02:0003B56E 020000FE        	  7202:     andi.b #$FE,D0
02:0003B572 1214            	  7203:     move.b  ($0000,A4),D1
02:0003B574 8001            	  7204:     or.b  D1,D0
02:0003B576 41EC0478        	  7205:     lea     ($0478,A4),A0
02:0003B57A 11802000        	  7206:     move.b  D0,(A0,D2.W)
                            	  7207:     ; If this segment is the base, then go draw.
                            	  7208:     ;
02:0003B57E 0C020005        	  7209:     cmpi.b  #$05,D2
02:0003B582 6736            	  7210:     beq  _L_z04_UpdateManhandla_Draw
                            	  7211:     ; If the old and new "frame image and sprite attributes" variables
                            	  7212:     ; are the same, then go draw.
                            	  7213:     ;
                            	  7214:     ; The previous frame value begins with value 0, because all
                            	  7215:     ; room data was reset on entry.
                            	  7216:     ;
02:0003B584 41EC0478        	  7217:     lea     ($0478,A4),A0
02:0003B588 10302000        	  7218:     move.b  (A0,D2.W),D0
02:0003B58C 41EC0437        	  7219:     lea     ($0437,A4),A0
02:0003B590 12302000        	  7220:     move.b  (A0,D2.W),D1
02:0003B594 B001            	  7221:     cmp.b   D1,D0
02:0003B596 6722            	  7222:     beq  _L_z04_UpdateManhandla_Draw
                            	  7223:     ; Copy the new value to the old variable, so that they're the same.
                            	  7224:     ;
02:0003B598 41EC0437        	  7225:     lea     ($0437,A4),A0
02:0003B59C 11802000        	  7226:     move.b  D0,(A0,D2.W)
                            	  7227:     ; If animation frame = 1, then go draw.
                            	  7228:     ;
                            	  7229:     ; The low bit of "frame image and sprite attributes" byte
                            	  7230:     ; represents the animation frame.
                            	  7231:     ;
02:0003B5A0 E208            	  7232:     lsr.b  #1,D0   ; LSR A
02:0003B5A2 6516            	  7233:     bcs  _L_z04_UpdateManhandla_Draw
                            	  7234:     ; If the random value for the next slot up < $E0,
                            	  7235:     ; or there's an object in slot 7; then go draw.
