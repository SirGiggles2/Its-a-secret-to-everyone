02:0003E916 102C0394        	  3207:     move.b  ($0394,A4),D0
02:0003E91A 6702            	  3208:     beq.s  __far_z_05_0060
02:0003E91C 6076            	  3209:     jmp  L14F72_Exit
                            	  3210: __far_z_05_0060:
                            	  3211:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3212:     ;
02:0003E91E 102C0084        	  3213:     move.b  ($0084,A4),D0
02:0003E922 0C00009D        	  3214:     cmpi.b  #$9D,D0
02:0003E926 6702            	  3215:     beq.s  __far_z_05_0061
02:0003E928 606C            	  3216:     jmp  CheckCaveEdge
                            	  3217: __far_z_05_0061:
                            	  3218:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3219:     ; X = $50: 1
                            	  3220:     ; X = $80: 2
                            	  3221:     ; X = $B0: 3
                            	  3222:     ;
                            	  3223:     ; If he's not on any, then return.
                            	  3224:     ;
02:0003E92A 7601            	  3225:     moveq   #1,D3
02:0003E92C 102C0070        	  3226:     move.b  ($0070,A4),D0
02:0003E930 0C000050        	  3227:     cmpi.b  #$50,D0
02:0003E934 6712            	  3228:     beq  _anon_z05_83
02:0003E936 5203            	  3229:     addq.b  #1,D3
02:0003E938 0C000080        	  3230:     cmpi.b  #$80,D0
02:0003E93C 670A            	  3231:     beq  _anon_z05_83
02:0003E93E 5203            	  3232:     addq.b  #1,D3
02:0003E940 0C0000B0        	  3233:     cmpi.b  #$B0,D0
02:0003E944 6702            	  3234:     beq.s  __far_z_05_0062
02:0003E946 604C            	  3235:     jmp  L14F72_Exit
                            	  3236: __far_z_05_0062:
                            	  3237: _anon_z05_83:
                            	  3238:     ; Look for the current room in the cellar/shortcut room array.
                            	  3239:     ;
02:0003E948 1883            	  3240:     move.b  D3,($0000,A4)
02:0003E94A 163C00FF        	  3241:     move.b  #$FF,D3
02:0003E94E 102C00EB        	  3242:     move.b  ($00EB,A4),D0
                            	  3243: _anon_z05_84:
02:0003E952 5203            	  3244:     addq.b  #1,D3
02:0003E954 41F900FF6BB2    	  3245:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E95A 12303000        	  3246:     move.b  (A0,D3.W),D1
02:0003E95E B001            	  3247:     cmp.b   D1,D0
02:0003E960 66F0            	  3248:     bne  _anon_z05_84
                            	  3249:     ; Add the value of the shortcut chosen to whatever index
                            	  3250:     ; the current room has in the array.
                            	  3251:     ;
                            	  3252:     ; This yields the index of one of the three shortcut rooms
                            	  3253:     ; after the current one.
                            	  3254:     ;
02:0003E962 1003            	  3255:     move.b  D3,D0
02:0003E964 023C00EE        	  3256:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E968 1214            	  3257:     move.b  ($0000,A4),D1
02:0003E96A D101            	  3258:     addx.b  D1,D0   ; ADC $00
                            	  3259:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3260:     ;
02:0003E96C 02000003        	  3261:     andi.b #$03,D0
02:0003E970 7600            	  3262:     moveq   #0,D3
02:0003E972 1600            	  3263:     move.b  D0,D3
02:0003E974 41F900FF6BB2    	  3264:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E97A 10303000        	  3265:     move.b  (A0,D3.W),D0
                            	  3266: ; Params:
                            	  3267: ; A: destination room ID
                            	  3268: ;
                            	  3269:     even
                            	  3270: GoToModeAFromCellar:
02:0003E97E 194000EB        	  3271:     move.b  D0,($00EB,A4)
02:0003E982 4EB900047858    	  3272:     jsr     MarkRoomVisited
                            	  3273:     even
                            	  3274: GoToModeAFromCave:
02:0003E988 700A            	  3275:     moveq   #10,D0
02:0003E98A 19400012        	  3276:     move.b  D0,($0012,A4)
                            	  3277:     even
                            	  3278: EndPrepareMode:
02:0003E98E 4EF90002C45A    	  3279:     jmp     c_end_prepare_mode
                            	  3280: 
                            	  3281: L14F72_Exit:
02:0003E994 4E75            	  3282:     rts
                            	  3283: 
