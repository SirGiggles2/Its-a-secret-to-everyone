02:0003A89A 1980203D        	  5539:     move.b  D0,($3D,A4,D2.W)
02:0003A89E 7008            	  5540:     moveq   #8,D0
02:0003A8A0 4EB9000499DE    	  5541:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5542:     ; If facing left, then enable horizontal flipping.
                            	  5543:     ;
02:0003A8A6 41EC0098        	  5544:     lea     ($0098,A4),A0
02:0003A8AA 10302000        	  5545:     move.b  (A0,D2.W),D0
02:0003A8AE 0C000002        	  5546:     cmpi.b  #$02,D0
02:0003A8B2 6604            	  5547:     bne  _anon_z04_94
02:0003A8B4 522C000F        	  5548:     addq.b  #1,($000F,A4)
                            	  5549: _anon_z04_94:
                            	  5550:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  5551:     ; This is the base frame image.
                            	  5552:     ;
02:0003A8B8 E208            	  5553:     lsr.b  #1,D0   ; LSR A
02:0003A8BA E208            	  5554:     lsr.b  #1,D0   ; LSR A
                            	  5555:     ; If movement frame = 1, add 3 to frame image to access
                            	  5556:     ; the second animation frame's images.
                            	  5557:     ;
02:0003A8BC 7600            	  5558:     moveq   #0,D3
02:0003A8BE 41EC03E4        	  5559:     lea     ($03E4,A4),A0
02:0003A8C2 16302000        	  5560:     move.b  (A0,D2.W),D3
02:0003A8C6 671E            	  5561:     beq  _anon_z04_95
02:0003A8C8 023C00EE        	  5562:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8CC 123C0003        	  5563:     move.b  #$03,D1
02:0003A8D0 D101            	  5564:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  5565:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  5566:     ;
                            	  5567:     ; Down has two frame images, but up only has one. By flipping
                            	  5568:     ; horizontally, you get two frame images.
                            	  5569:     ;
02:0003A8D2 7600            	  5570:     moveq   #0,D3
02:0003A8D4 41EC0098        	  5571:     lea     ($0098,A4),A0
02:0003A8D8 16302000        	  5572:     move.b  (A0,D2.W),D3
02:0003A8DC 0C030008        	  5573:     cmpi.b  #$08,D3
02:0003A8E0 6604            	  5574:     bne  _anon_z04_95
02:0003A8E2 522C000F        	  5575:     addq.b  #1,($000F,A4)
