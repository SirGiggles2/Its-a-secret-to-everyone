                            	  5030:     ;
02:00048DF6 41EC0098        	  5031:     lea     ($0098,A4),A0
02:00048DFA 10302000        	  5032:     move.b  (A0,D2.W),D0
02:00048DFE 0C0000E8        	  5033:     cmpi.b  #$E8,D0
02:00048E02 6702            	  5034:     beq.s  __far_z_07_0072
02:00048E04 6004            	  5035:     jmp  L1F49F_Exit
