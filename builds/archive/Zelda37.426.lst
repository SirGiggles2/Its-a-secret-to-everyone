                            	  4973: _L_z07_SpreadShot_Draw:
                            	  4974:     ; Draw the corner.
                            	  4975:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4976:     ;
02:00048DA4 7002            	  4977:     moveq   #2,D0
02:00048DA6 1940000C        	  4978:     move.b  D0,($000C,A4)
02:00048DAA 7623            	  4979:     moveq   #35,D3
