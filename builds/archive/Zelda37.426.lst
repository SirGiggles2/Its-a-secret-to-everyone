                            	  4149:     ; If object does not have attribute $10, then
                            	  4150:     ; set movement direction to input direction,
                            	  4151:     ; and go try to turn to an unblocked direction in order to move.
                            	  4152:     ;
02:00048836 41EC04BF        	  4153:     lea     ($04BF,A4),A0
02:0004883A 10302000        	  4154:     move.b  (A0,D2.W),D0
02:0004883E 02000010        	  4155:     andi.b #$10,D0
02:00048842 6702            	  4156:     beq.s  __far_z_07_0051
02:00048844 600E            	  4157:     jmp  Reverse
