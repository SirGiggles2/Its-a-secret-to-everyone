                            	  4689: ;==============================================================================
                            	  4690: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4691: ;==============================================================================
                            	  4692: 
                            	  4693:     xref    _ShootIfWanted
                            	  4694: 
                            	  4695: ; ShootIfWanted(type, slot)
                            	  4696: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4697: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4698: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4699: c_shoot_if_wanted:
02:0002CEDE 2F02            	  4700:     move.l  D2,-(SP)
02:0002CEE0 202F0008        	  4701:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CEE4 242F000C        	  4702:     move.l  12(SP),D2       ; arg2 = slot
02:0002CEE8 4EB90003C922    	  4703:     jsr     _ShootIfWanted
02:0002CEEE 640C            	  4704:     bcc.s   .csiw_fail
02:0002CEF0 7000            	  4705:     moveq   #0,D0
02:0002CEF2 1003            	  4706:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CEF4 008000000100    	  4707:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CEFA 6002            	  4708:     bra.s   .csiw_done
                            	  4709: .csiw_fail:
02:0002CEFC 7000            	  4710:     moveq   #0,D0
                            	  4711: .csiw_done:
02:0002CEFE 241F            	  4712:     move.l  (SP)+,D2
02:0002CF00 4E75            	  4713:     rts
