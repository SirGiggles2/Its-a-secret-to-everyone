                            	  5854:     ; Go to the next state.
                            	  5855:     ;
02:000493B6 41EC00AC        	  5856:     lea     ($00AC,A4),A0
02:000493BA 52302000        	  5857:     addq.b  #1,(A0,D2.W)
                            	  5858:     ; Once we reach state 6, deactivate the object.
                            	  5859:     ; Otherwise, go draw it.
                            	  5860:     ;
02:000493BE 41EC00AC        	  5861:     lea     ($00AC,A4),A0
02:000493C2 10302000        	  5862:     move.b  (A0,D2.W),D0
02:000493C6 0200000F        	  5863:     andi.b #$0F,D0
02:000493CA 0C000006        	  5864:     cmpi.b  #$06,D0
02:000493CE 6506            	  5865:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:000493D0 610001C2        	  5866:     jsr     ResetObjState
                            	  5867:     even
