02:0003C02C 41EC0098        	  8626:     lea     ($0098,A4),A0
02:0003C030 11802000        	  8627:     move.b  D0,(A0,D2.W)
                            	  8628:     ; Set angle $18 (N).
                            	  8629:     ;
02:0003C034 7018            	  8630:     moveq   #24,D0
02:0003C036 41EC0394        	  8631:     lea     ($0394,A4),A0
02:0003C03A 11802000        	  8632:     move.b  D0,(A0,D2.W)
                            	  8633:     ; This location is right above Patra.
                            	  8634:     ; Set X coordinate to Patra's.
                            	  8635:     ;
02:0003C03E 102C0071        	  8636:     move.b  ($0071,A4),D0
02:0003C042 19802070        	  8637:     move.b  D0,($70,A4,D2.W)
                            	  8638:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	  8639:     ; Else use radius $18. Store the chosen value in [00].
                            	  8640:     ;
02:0003C046 702C            	  8641:     moveq   #44,D0
02:0003C048 7600            	  8642:     moveq   #0,D3
02:0003C04A 41EC034F        	  8643:     lea     ($034F,A4),A0
02:0003C04E 16302000        	  8644:     move.b  (A0,D2.W),D3
02:0003C052 0C030025        	  8645:     cmpi.b  #$25,D3
02:0003C056 6702            	  8646:     beq  _anon_z04_158
02:0003C058 7018            	  8647:     moveq   #24,D0
                            	  8648: _anon_z04_158:
02:0003C05A 1880            	  8649:     move.b  D0,($0000,A4)
                            	  8650:     ; This location is right above Patra.
                            	  8651:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  8652:     ;
02:0003C05C 102C0085        	  8653:     move.b  ($0085,A4),D0
02:0003C060 003C0011        	  8654:     ori     #$11,CCR  ; SEC: set C+X
02:0003C064 1214            	  8655:     move.b  ($0000,A4),D1
02:0003C066 0A3C0010        	  8656:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C06A 9101            	  8657:     subx.b  D1,D0   ; SBC $00
02:0003C06C 0A3C0010        	  8658:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C070 41EC0084        	  8659:     lea     ($0084,A4),A0
02:0003C074 11802000        	  8660:     move.b  D0,(A0,D2.W)
                            	  8661:     even
