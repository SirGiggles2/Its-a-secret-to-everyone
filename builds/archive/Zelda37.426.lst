                            	  4737: Digdogger_Move:
                            	  4738:     ; This calculation is the same one used in Manhandla to
                            	  4739:     ; manifest the fractional speed over several frames.
                            	  4740:     ;
                            	  4741:     ; To summarize, the formula is:
                            	  4742:     ;
                            	  4743:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4744:     ;
                            	  4745:     ;   SA := SA + (SL AND $E0)
                            	  4746:     ;   [03] := SH + carry
                            	  4747:     ;
                            	  4748:     ; See 04:A28E Manhandla_Move.
                            	  4749:     ;
02:0003A29E 41EC041F        	  4750:     lea     ($041F,A4),A0
02:0003A2A2 10302000        	  4751:     move.b  (A0,D2.W),D0
02:0003A2A6 020000E0        	  4752:     andi.b #$E0,D0
02:0003A2AA 023C00EE        	  4753:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2AE 41EC0412        	  4754:     lea     ($0412,A4),A0
02:0003A2B2 12302000        	  4755:     move.b  (A0,D2.W),D1
02:0003A2B6 D101            	  4756:     addx.b  D1,D0   ; ADC $0412,X
02:0003A2B8 41EC0412        	  4757:     lea     ($0412,A4),A0
02:0003A2BC 11802000        	  4758:     move.b  D0,(A0,D2.W)
                            	  4759:     ; Assign (high speed byte + carry) to [03].
                            	  4760:     ;
02:0003A2C0 41EC042C        	  4761:     lea     ($042C,A4),A0
02:0003A2C4 10302000        	  4762:     move.b  (A0,D2.W),D0
02:0003A2C8 123C0000        	  4763:     move.b  #$00,D1
02:0003A2CC D101            	  4764:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A2CE 19400003        	  4765:     move.b  D0,($0003,A4)
                            	  4766:     ; Change coordinates by the speed amount/offset in [03]
                            	  4767:     ; according to the direction.
                            	  4768:     ;
                            	  4769:     ; Start with a mask of $A1 in [02]:
                            	  4770:     ; - low nibble represents the right direction
                            	  4771:     ; - high nibble is used to set or clear carry as we go along
                            	  4772:     ;
02:0003A2D2 103C00A1        	  4773:     move.b  #$A1,D0
02:0003A2D6 19400002        	  4774:     move.b  D0,($0002,A4)
                            	  4775:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4776:     ;
02:0003A2DA 41EC0098        	  4777:     lea     ($0098,A4),A0
02:0003A2DE 10302000        	  4778:     move.b  (A0,D2.W),D0
02:0003A2E2 122C0002        	  4779:     move.b  ($0002,A4),D1
02:0003A2E6 C200            	  4780:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A2E8 6712            	  4781:     beq  _L_z04_Digdogger_Move_Left
02:0003A2EA 10342070        	  4782:     move.b  ($70,A4,D2.W),D0
02:0003A2EE 023C00EE        	  4783:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2F2 122C0003        	  4784:     move.b  ($0003,A4),D1
02:0003A2F6 D101            	  4785:     addx.b  D1,D0   ; ADC $03
02:0003A2F8 19802070        	  4786:     move.b  D0,($70,A4,D2.W)
                            	  4787:     even
