02:0003E642 6710            	  2765:     beq  _anon_z05_76
02:0003E644 1003            	  2766:     move.b  D3,D0
02:0003E646 023C00EE        	  2767:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E64A 123C0004        	  2768:     move.b  #$04,D1
02:0003E64E D101            	  2769:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
