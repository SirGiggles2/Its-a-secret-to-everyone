02:00048D02 7603            	  4893:     moveq   #3,D3
                            	  4894:     even
                            	  4895: _L_z07_SpreadShot_DrawShotCorner:
02:00048D04 1003            	  4896:     move.b  D3,D0
02:00048D06 1B00            	  4897:     move.b  D0,-(A5)  ; PHA
                            	  4898:     ; Save offset X [02] and Y offset [03].
                            	  4899:     ;
02:00048D08 102C0002        	  4900:     move.b  ($0002,A4),D0
02:00048D0C 1B00            	  4901:     move.b  D0,-(A5)  ; PHA
02:00048D0E 102C0003        	  4902:     move.b  ($0003,A4),D0
02:00048D12 1B00            	  4903:     move.b  D0,-(A5)  ; PHA
                            	  4904:     ; Calculate and set sprite attributes for this corner:
                            	  4905:     ;   base attribute OR (frame counter AND 3)
                            	  4906:     ;
                            	  4907:     ; The base attribute defines how to flip the sprite.
                            	  4908:     ; The frame counter makes the shot flash by cycling each
                            	  4909:     ; palette row.
                            	  4910:     ;
02:00048D14 102C0015        	  4911:     move.b  ($0015,A4),D0
02:00048D18 02000003        	  4912:     andi.b #$03,D0
02:00048D1C 41F900048BF8    	  4913:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048D22 12303000        	  4914:     move.b  (A0,D3.W),D1
02:00048D26 8001            	  4915:     or.b  D1,D0
02:00048D28 4EB900030FDC    	  4916:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4917:     ; Add the object's X (the center of the spread) and the
                            	  4918:     ; current offset in [02] to set sprite X in [00].
                            	  4919:     ;
02:00048D2E 10342070        	  4920:     move.b  ($70,A4,D2.W),D0
02:00048D32 023C00EE        	  4921:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048D36 122C0002        	  4922:     move.b  ($0002,A4),D1
02:00048D3A D101            	  4923:     addx.b  D1,D0   ; ADC $02
02:00048D3C 1880            	  4924:     move.b  D0,($0000,A4)
                            	  4925:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4926:     ; Else calculate the distance from object X to sprite X.
                            	  4927:     ;
02:00048D3E 12342070        	  4928:     move.b  ($70,A4,D2.W),D1
02:00048D42 B001            	  4929:     cmp.b   D1,D0
02:00048D44 651A            	  4930:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048D46 0C0000FC        	  4931:     cmpi.b  #$FC,D0
02:00048D4A 6466            	  4932:     bcc  _L_z07_SpreadShot_NextCorner
02:00048D4C 003C0011        	  4933:     ori     #$11,CCR  ; SEC: set C+X
02:00048D50 12342070        	  4934:     move.b  ($70,A4,D2.W),D1
02:00048D54 0A3C0010        	  4935:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048D58 9101            	  4936:     subx.b  D1,D0   ; SBC ObjX,X
02:00048D5A 0A3C0010        	  4937:     eori    #$10,CCR  ; restore X = 6502 C
02:00048D5E 6014            	  4938:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4939: 
                            	  4940:     even
                            	  4941: _L_z07_SpreadShot_ReverseSub:
02:00048D60 10342070        	  4942:     move.b  ($70,A4,D2.W),D0
02:00048D64 003C0011        	  4943:     ori     #$11,CCR  ; SEC: set C+X
02:00048D68 1214            	  4944:     move.b  ($0000,A4),D1
02:00048D6A 0A3C0010        	  4945:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048D6E 9101            	  4946:     subx.b  D1,D0   ; SBC $00
02:00048D70 0A3C0010        	  4947:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4948:     even
                            	  4949: _L_z07_SpreadShot_CheckDistance:
                            	  4950:     ; If distance >= $20, skip this corner.
