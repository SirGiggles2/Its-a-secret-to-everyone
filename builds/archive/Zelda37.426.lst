                            	  9292:     even
                            	  9293: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  9294:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  9295:     ;
02:0003C4DA 10342070        	  9296:     move.b  ($70,A4,D2.W),D0
02:0003C4DE 023C00EE        	  9297:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4E2 41F90003C4CC    	  9298:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C4E8 12303000        	  9299:     move.b  (A0,D3.W),D1
02:0003C4EC D101            	  9300:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C4EE 1880            	  9301:     move.b  D0,($0000,A4)
                            	  9302:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  9303:     ;
02:0003C4F0 41EC0084        	  9304:     lea     ($0084,A4),A0
02:0003C4F4 10302000        	  9305:     move.b  (A0,D2.W),D0
02:0003C4F8 023C00EE        	  9306:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4FC 41F90003C4D0    	  9307:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C502 12303000        	  9308:     move.b  (A0,D3.W),D1
02:0003C506 D101            	  9309:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C508 19400001        	  9310:     move.b  D0,($0001,A4)
                            	  9311:     ; Each part has a horizontal flipping flag.
                            	  9312:     ;
02:0003C50C 41F90003C4D4    	  9313:     lea     (GanonSpriteHFlips).l,A0
02:0003C512 10303000        	  9314:     move.b  (A0,D3.W),D0
02:0003C516 1940000F        	  9315:     move.b  D0,($000F,A4)
                            	  9316:     ; Save and copy the loop index (the current part) to [07].
                            	  9317:     ;
02:0003C51A 1003            	  9318:     move.b  D3,D0
02:0003C51C 1B00            	  9319:     move.b  D0,-(A5)  ; PHA
02:0003C51E 19400007        	  9320:     move.b  D0,($0007,A4)
                            	  9321:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  9322:     ; that make it up.
                            	  9323:     ;
02:0003C522 41EC046B        	  9324:     lea     ($046B,A4),A0
02:0003C526 10302000        	  9325:     move.b  (A0,D2.W),D0
02:0003C52A E308            	  9326:     lsl.b  #1,D0   ; ASL A
02:0003C52C E308            	  9327:     lsl.b  #1,D0   ; ASL A
                            	  9328:     ; Add [07] -- the index of the current part.
                            	  9329:     ;
                            	  9330:     ; Now you have an index into the frame image table, for the
                            	  9331:     ; current image part of the current animation frame.
                            	  9332:     ;
02:0003C52E 122C0007        	  9333:     move.b  ($0007,A4),D1
02:0003C532 D101            	  9334:     addx.b  D1,D0   ; ADC $07
02:0003C534 7600            	  9335:     moveq   #0,D3
02:0003C536 1600            	  9336:     move.b  D0,D3
02:0003C538 41F90003C4B4    	  9337:     lea     (GanonFrameImages).l,A0
02:0003C53E 10303000        	  9338:     move.b  (A0,D3.W),D0
02:0003C542 4EB900030CEA    	  9339:     jsr     DrawObjectNotMirrored
02:0003C548 101D            	  9340:     move.b  (A5)+,D0  ; PLA
                            	  9341:     ; Bottom of the part loop.
                            	  9342:     ;
02:0003C54A 7600            	  9343:     moveq   #0,D3
02:0003C54C 1600            	  9344:     move.b  D0,D3
02:0003C54E 5303            	  9345:     subq.b  #1,D3
02:0003C550 6A88            	  9346:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C552 4E75            	  9347:     rts
