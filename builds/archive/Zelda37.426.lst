02:0003A33A 19410002        	  4813:     move.b  D1,($0002,A4)
02:0003A33E 122C0002        	  4814:     move.b  ($0002,A4),D1
02:0003A342 C200            	  4815:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A344 6716            	  4816:     beq  _L_z04_Digdogger_Move_Up
02:0003A346 41EC0084        	  4817:     lea     ($0084,A4),A0
02:0003A34A 10302000        	  4818:     move.b  (A0,D2.W),D0
02:0003A34E 122C0003        	  4819:     move.b  ($0003,A4),D1
02:0003A352 D101            	  4820:     addx.b  D1,D0   ; ADC $03
