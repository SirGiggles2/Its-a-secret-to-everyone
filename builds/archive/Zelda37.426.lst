                            	  7735: __far_z_05_0086:
                            	  7736:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7737:     ; and represents the current row of the submenu being processed.
                            	  7738:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7739:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7740:     ;
                            	  7741:     ; If the bottom bit is set, go prepare the full black row.
                            	  7742:     ;
02:00041940 E208            	  7743:     lsr.b  #1,D0   ; LSR A
02:00041942 7600            	  7744:     moveq   #0,D3
02:00041944 1600            	  7745:     move.b  D0,D3
02:00041946 6402            	  7746:     bcc.s  __far_z_05_0087
