02:000493D4 4E75            	  5869:     rts
                            	  5870: 
                            	  5871:     even
                            	  5872: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  5873:     ; Reset horizontal flipping in [0F].
                            	  5874:     ;
02:000493D6 7000            	  5875:     moveq   #0,D0
02:000493D8 1940000F        	  5876:     move.b  D0,($000F,A4)
                            	  5877:     ; If state = 5, return without drawing.
                            	  5878:     ;
02:000493DC 41EC00AC        	  5879:     lea     ($00AC,A4),A0
02:000493E0 10302000        	  5880:     move.b  (A0,D2.W),D0
02:000493E4 0200000F        	  5881:     andi.b #$0F,D0
02:000493E8 7600            	  5882:     moveq   #0,D3
02:000493EA 1600            	  5883:     move.b  D0,D3
02:000493EC 103C00FC        	  5884:     move.b  #$FC,D0
02:000493F0 0C030005        	  5885:     cmpi.b  #$05,D3
02:000493F4 67DE            	  5886:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5887:     even
                            	  5888: _L_z07_UpdateSwordOrRod_Add4:
                            	  5889:     ; Set [00] to (state - 1) * 4:
                            	  5890:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5891:     ;
02:000493F6 023C00EE        	  5892:     andi    #$EE,CCR  ; CLC: clear C+X
02:000493FA 123C0004        	  5893:     move.b  #$04,D1
02:000493FE D101            	  5894:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00049400 5303            	  5895:     subq.b  #1,D3
02:00049402 66F2            	  5896:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00049404 1880            	  5897:     move.b  D0,($0000,A4)
                            	  5898:     ; Set object's direction to player's. It might have changed
                            	  5899:     ; since the last frame.
                            	  5900:     ;
02:00049406 102C0098        	  5901:     move.b  ($0098,A4),D0
02:0004940A 41EC0098        	  5902:     lea     ($0098,A4),A0
02:0004940E 11802000        	  5903:     move.b  D0,(A0,D2.W)
                            	  5904:     ; Add [00] and the reverse index of the direction to get
                            	  5905:     ; the byte offset of the pixel offset.
                            	  5906:     ;
02:00049412 4EB90003091A    	  5907:     jsr     GetOppositeDir
02:00049418 1003            	  5908:     move.b  D3,D0
02:0004941A 023C00EE        	  5909:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004941E 1214            	  5910:     move.b  ($0000,A4),D1
02:00049420 D101            	  5911:     addx.b  D1,D0   ; ADC $00
02:00049422 7600            	  5912:     moveq   #0,D3
02:00049424 1600            	  5913:     move.b  D0,D3
                            	  5914:     ; Set object's X to player's X + offset for state and direction.
                            	  5915:     ; Copy the result to [00].
                            	  5916:     ;
02:00049426 102C0070        	  5917:     move.b  ($0070,A4),D0
02:0004942A 023C00EE        	  5918:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004942E 41F90004935A    	  5919:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00049434 12303000        	  5920:     move.b  (A0,D3.W),D1
02:00049438 D101            	  5921:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:0004943A 19802070        	  5922:     move.b  D0,($70,A4,D2.W)
02:0004943E 1880            	  5923:     move.b  D0,($0000,A4)
                            	  5924:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5925:     ; Copy the result to [01].
                            	  5926:     ;
02:00049440 102C0084        	  5927:     move.b  ($0084,A4),D0
02:00049444 023C00EE        	  5928:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049448 41F90004936A    	  5929:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004944E 12303000        	  5930:     move.b  (A0,D3.W),D1
02:00049452 D101            	  5931:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00049454 41EC0084        	  5932:     lea     ($0084,A4),A0
02:00049458 11802000        	  5933:     move.b  D0,(A0,D2.W)
02:0004945C 19400001        	  5934:     move.b  D0,($0001,A4)
                            	  5935:     ; If state = 1, use up direction.
                            	  5936:     ; Else use object direction.
                            	  5937:     ;
02:00049460 41EC00AC        	  5938:     lea     ($00AC,A4),A0
02:00049464 10302000        	  5939:     move.b  (A0,D2.W),D0
02:00049468 0200000F        	  5940:     andi.b #$0F,D0
02:0004946C 7600            	  5941:     moveq   #0,D3
02:0004946E 1600            	  5942:     move.b  D0,D3
02:00049470 7008            	  5943:     moveq   #8,D0
02:00049472 5303            	  5944:     subq.b  #1,D3
02:00049474 6708            	  5945:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00049476 41EC0098        	  5946:     lea     ($0098,A4),A0
02:0004947A 10302000        	  5947:     move.b  (A0,D2.W),D0
                            	  5948:     even
                            	  5949: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5950:     ; Store the weapon's frame (horizontal or vertical)
                            	  5951:     ; for the direction chosen above in [0C].
                            	  5952:     ;
02:0004947E 4EB90003091A    	  5953:     jsr     GetOppositeDir
02:00049484 41F900048EB8    	  5954:     lea     (RDirectionToWeaponFrame).l,A0
02:0004948A 10303000        	  5955:     move.b  (A0,D3.W),D0
02:0004948E 1940000C        	  5956:     move.b  D0,($000C,A4)
                            	  5957:     ; Calculate sprite attributes.
                            	  5958:     ;
                            	  5959:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5960:     ;   base attribute OR 1
                            	  5961:     ; So, it uses palette row 5.
                            	  5962:     ;
02:00049492 41F900048EBC    	  5963:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049498 10303000        	  5964:     move.b  (A0,D3.W),D0
02:0004949C 0C02000D        	  5965:     cmpi.b  #$0D,D2
02:000494A0 6706            	  5966:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:000494A2 00000001        	  5967:     ori.b #$01,D0
02:000494A6 601C            	  5968:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5969: 
                            	  5970:     even
                            	  5971: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5972:     ; The weapon is the sword.
                            	  5973:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5974:     ;
02:000494A8 023C00EE        	  5975:     andi    #$EE,CCR  ; CLC: clear C+X
02:000494AC 122C0657        	  5976:     move.b  ($0657,A4),D1
02:000494B0 D101            	  5977:     addx.b  D1,D0   ; ADC Items
02:000494B2 003C0011        	  5978:     ori     #$11,CCR  ; SEC: set C+X
02:000494B6 123C0001        	  5979:     move.b  #$01,D1
02:000494BA 0A3C0010        	  5980:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000494BE 9101            	  5981:     subx.b  D1,D0   ; SBC #$01
02:000494C0 0A3C0010        	  5982:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5983:     even
                            	  5984: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5985:     ; Set sprite attributes to the calculated value above.
                            	  5986:     ;
02:000494C4 4EB900030FDC    	  5987:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5988:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5989:     ;
02:000494CA 0C030002        	  5990:     cmpi.b  #$02,D3
02:000494CE 6604            	  5991:     bne  _anon_z07_33
02:000494D0 522C000F        	  5992:     addq.b  #1,($000F,A4)
                            	  5993: _anon_z07_33:
                            	  5994:     ; If state = 1, return. Don't show the weapon.
                            	  5995:     ;
02:000494D4 41EC00AC        	  5996:     lea     ($00AC,A4),A0
02:000494D8 10302000        	  5997:     move.b  (A0,D2.W),D0
02:000494DC 0200000F        	  5998:     andi.b #$0F,D0
02:000494E0 0C000001        	  5999:     cmpi.b  #$01,D0
02:000494E4 6604            	  6000:     bne.s  __far_z_07_0086
02:000494E6 600000AA        	  6001:     jmp  L1F854_Exit
                            	  6002: __far_z_07_0086:
                            	  6003:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  6004:     ; sword or rod
                            	  6005:     ;
                            	  6006:     ;
                            	  6007:     ; Sword slot
02:000494EA 7600            	  6008:     moveq   #0,D3
02:000494EC 0C02000D        	  6009:     cmpi.b  #$0D,D2
02:000494F0 6702            	  6010:     beq  _anon_z07_34
02:000494F2 7608            	  6011:     moveq   #8,D3
                            	  6012: _anon_z07_34:
02:000494F4 4EB900030EFC    	  6013:     jsr     Anim_WriteItemSprites
                            	  6014:     ; If state <> 3, return.
                            	  6015:     ;
02:000494FA 41EC00AC        	  6016:     lea     ($00AC,A4),A0
02:000494FE 10302000        	  6017:     move.b  (A0,D2.W),D0
02:00049502 0200000F        	  6018:     andi.b #$0F,D0
02:00049506 0C000003        	  6019:     cmpi.b  #$03,D0
02:0004950A 6704            	  6020:     beq.s  __far_z_07_0087
02:0004950C 60000084        	  6021:     jmp  L1F854_Exit
                            	  6022: __far_z_07_0087:
                            	  6023:     ; State = 3. Time to instantiate a shot.
                            	  6024:     ;
                            	  6025:     ; If object slot is not the rod's, go instantiate the sword shot separately.
                            	  6026:     ;
02:00049510 0C020012        	  6027:     cmpi.b  #$12,D2
02:00049514 6704            	  6028:     beq.s  __far_z_07_0088
02:00049516 60000082        	  6029:     jmp  MakeSwordShot
                            	  6030: __far_z_07_0088:
                            	  6031:     ; Instantiate a magic shot (rod shot).
                            	  6032:     ; Switch to the shot slot $E.
                            	  6033:     ;
02:0004951A 740E            	  6034:     moveq   #14,D2
                            	  6035:     ; If high bit of state is set, return. It's already active.
                            	  6036:     ;
02:0004951C 41EC00AC        	  6037:     lea     ($00AC,A4),A0
02:00049520 10302000        	  6038:     move.b  (A0,D2.W),D0
02:00049524 6706            	  6039:     beq  _L_z07_UpdateSwordOrRod_MakeMagicShot
02:00049526 E308            	  6040:     lsl.b  #1,D0   ; ASL A
02:00049528 6402            	  6041:     bcc.s  __far_z_07_0089
02:0004952A 6066            	  6042:     jmp  L1F854_Exit
                            	  6043: __far_z_07_0089:
                            	  6044:     even
                            	  6045: _L_z07_UpdateSwordOrRod_MakeMagicShot:
                            	  6046:     ; Play "magic shot" tune.
                            	  6047:     ;
02:0004952C 7004            	  6048:     moveq   #4,D0
02:0004952E 19400604        	  6049:     move.b  D0,($0604,A4)
                            	  6050:     ; Activate the shot object (state $80).
                            	  6051:     ;
02:00049532 103C0080        	  6052:     move.b  #$80,D0
                            	  6053:     even
                            	  6054: SetUpWeaponWithState:
