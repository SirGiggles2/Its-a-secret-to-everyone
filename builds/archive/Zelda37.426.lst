02:0003C16E 610007F0        	  8791:     jsr     UpdateCandle
02:0003C172 101D            	  8792:     move.b  (A5)+,D0  ; PLA
02:0003C174 7400            	  8793:     moveq   #0,D2
02:0003C176 1400            	  8794:     move.b  D0,D2
                            	  8795:     ; Turn off the room brightening flag, because we're controlling it
                            	  8796:     ; here instead of in the Mode 5 object update loop.
                            	  8797:     ;
02:0003C178 7000            	  8798:     moveq   #0,D0
02:0003C17A 1940051E        	  8799:     move.b  D0,($051E,A4)
