02:0003D756 6100FF76        	 12178:     jsr     Ganon_DrawCloud
                            	 12179:     ; Draw the left and right clouds.
                            	 12180:     ;
02:0003D75A 61000080        	 12181:     jsr     Ganon_GetCurCloudLeft
02:0003D75E 41EC0084        	 12182:     lea     ($0084,A4),A0
02:0003D762 10302000        	 12183:     move.b  (A0,D2.W),D0
02:0003D766 19400001        	 12184:     move.b  D0,($0001,A4)
02:0003D76A 6100FF62        	 12185:     jsr     Ganon_DrawCloud
02:0003D76E 6172            	 12186:     jsr     Ganon_GetCurCloudRight
02:0003D770 6100FF5C        	 12187:     jsr     Ganon_DrawCloud
                            	 12188:     ; Save the object index.
                            	 12189:     ;
02:0003D774 102C0340        	 12190:     move.b  ($0340,A4),D0
02:0003D778 1B00            	 12191:     move.b  D0,-(A5)  ; PHA
                            	 12192:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12193:     ;
02:0003D77A 7402            	 12194:     moveq   #2,D2
                            	 12195:     even
                            	 12196: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003D77C 19420340        	 12197:     move.b  D2,($0340,A4)
                            	 12198:     ; If object slot < 5 or = 7, then move every frame.
                            	 12199:     ; Else move 3 out of every 4 frames.
                            	 12200:     ;
                            	 12201:     ; This makes pieces spread out in somewhat of a circle,
                            	 12202:     ; by making the pieces at cardinal directions move at
                            	 12203:     ; full speed while the diagonal ones move a little slower.
                            	 12204:     ;
02:0003D780 0C020005        	 12205:     cmpi.b  #$05,D2
02:0003D784 6510            	 12206:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003D786 0C020007        	 12207:     cmpi.b  #$07,D2
02:0003D78A 670A            	 12208:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003D78C 102C0015        	 12209:     move.b  ($0015,A4),D0
02:0003D790 02000003        	 12210:     andi.b #$03,D0
02:0003D794 6704            	 12211:     beq  _anon_z04_164
                            	 12212:     even
                            	 12213: _L_z04_Ganon_DrawBurst_Move:
02:0003D796 6100E036        	 12214:     jsr     BlueWizzrobe_Move
                            	 12215: _anon_z04_164:
02:0003D79A 4EB90004AFFA    	 12216:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12217:     ; The frame counter will make the sprite flash.
                            	 12218:     ; The array has the horizontal and vertical flipping attributes.
                            	 12219:     ; Combine them into [03].
                            	 12220:     ;
02:0003D7A0 102C0015        	 12221:     move.b  ($0015,A4),D0
02:0003D7A4 02000003        	 12222:     andi.b #$03,D0
02:0003D7A8 41F90003D678    	 12223:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003D7AE 12302000        	 12224:     move.b  (A0,D2.W),D1
02:0003D7B2 8001            	 12225:     or.b  D1,D0
02:0003D7B4 19400003        	 12226:     move.b  D0,($0003,A4)
02:0003D7B8 41F90003D682    	 12227:     lea     (GanonBurstTiles).l,A0
02:0003D7BE 10302000        	 12228:     move.b  (A0,D2.W),D0
02:0003D7C2 4EB900030C0E    	 12229:     jsr     Anim_WriteSprite
                            	 12230:     ; Bottom of the loop.
                            	 12231:     ; Increment object slot while <= 9.
                            	 12232:     ;
02:0003D7C8 5202            	 12233:     addq.b  #1,D2
02:0003D7CA 0C02000A        	 12234:     cmpi.b  #$0A,D2
02:0003D7CE 65AC            	 12235:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12236:     ; Restore the object index.
                            	 12237:     ;
02:0003D7D0 101D            	 12238:     move.b  (A5)+,D0  ; PLA
02:0003D7D2 19400340        	 12239:     move.b  D0,($0340,A4)
02:0003D7D6 0A3C0001        	 12240:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D7DA 4E75            	 12241:     rts
                            	 12242: 
