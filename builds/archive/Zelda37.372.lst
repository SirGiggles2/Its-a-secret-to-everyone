                            	  3200:     ; If facing down, then use frame image offset 2.
                            	  3201:     ;
02:00039604 41EC0098        	  3202:     lea     ($0098,A4),A0
02:00039608 10302000        	  3203:     move.b  (A0,D2.W),D0
02:0003960C 7600            	  3204:     moveq   #0,D3
02:0003960E 1600            	  3205:     move.b  D0,D3
02:00039610 0200000C        	  3206:     andi.b #$0C,D0
02:00039614 670C            	  3207:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00039616 7002            	  3208:     moveq   #2,D0
