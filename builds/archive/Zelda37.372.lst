                            	 11952: Ganon_UpdateBrownState:
                            	 11953:     ; Every other frame decrement the state.
                            	 11954:     ; But every frame draw Ganon either translucent or opaque.
                            	 11955:     ;
02:0003D5A8 102C0015        	 11956:     move.b  ($0015,A4),D0
02:0003D5AC E208            	 11957:     lsr.b  #1,D0   ; LSR A
02:0003D5AE 6410            	 11958:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003D5B0 41EC00AC        	 11959:     lea     ($00AC,A4),A0
02:0003D5B4 53302000        	 11960:     subq.b  #1,(A0,D2.W)
                            	 11961:     ; If the state becomes 0, then Ganon is blue again.
                            	 11962:     ; Go switch his palette row to reflect it.
                            	 11963:     ;
02:0003D5B8 6606            	 11964:     bne  _L_z04_Ganon_UpdateBrownState_Draw
