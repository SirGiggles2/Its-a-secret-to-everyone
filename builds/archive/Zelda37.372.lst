                            	 11555: UpdatePatraChild:
                            	 11556:     ; If state = 1, then go orbit.
                            	 11557:     ;
02:0003D310 41EC00AC        	 11558:     lea     ($00AC,A4),A0
02:0003D314 10302000        	 11559:     move.b  (A0,D2.W),D0
02:0003D318 6704            	 11560:     beq.s  __far_z_04_0112
02:0003D31A 6000009E        	 11561:     jmp  PatraChild_State1
                            	 11562: __far_z_04_0112:
                            	 11563:     ; State = 0.
                            	 11564:     ;
                            	 11565:     ; If the current object slot is 2, then go initialize the patra child.
                            	 11566:     ; This is the only patra child shown in the first fame.
                            	 11567:     ;
02:0003D31E 0C020002        	 11568:     cmpi.b  #$02,D2
02:0003D322 6732            	 11569:     beq  _L_z04_UpdatePatraChild_Ready
                            	 11570:     ; The patra child in slot 2 is the last one to be updated.
                            	 11571:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 11572:     ;
                            	 11573:     ; This means that in the first frame, slot 2 is the only one to be
                            	 11574:     ; shown.
                            	 11575:     ;
02:0003D324 102C00AE        	 11576:     move.b  ($00AE,A4),D0
02:0003D328 6700008E        	 11577:     beq  _L_z04_UpdatePatraChild_Exit
                            	 11578:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 11579:     ; here to wait to be shown at the top position (N) one at a time.
                            	 11580:     ;
02:0003D32C 1002            	 11581:     move.b  D2,D0
                            	 11582:     ; Subtract 3 from the object slot to get the angle where the
                            	 11583:     ; patra child in object slot 2 should be for the current one to appear.
                            	 11584:     ;
02:0003D32E 003C0011        	 11585:     ori     #$11,CCR  ; SEC: set C+X
02:0003D332 123C0003        	 11586:     move.b  #$03,D1
02:0003D336 0A3C0010        	 11587:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D33A 9101            	 11588:     subx.b  D1,D0   ; SBC #$03
02:0003D33C 0A3C0010        	 11589:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D340 7600            	 11590:     moveq   #0,D3
02:0003D342 1600            	 11591:     move.b  D0,D3
                            	 11592:     ; If the patra child in slot 2 has not reached the required angle,
                            	 11593:     ; then return.
                            	 11594:     ;
02:0003D344 102C0396        	 11595:     move.b  ($0396,A4),D0
02:0003D348 41F90003D302    	 11596:     lea     (PatraChildStartAngles).l,A0
02:0003D34E 12303000        	 11597:     move.b  (A0,D3.W),D1
02:0003D352 B001            	 11598:     cmp.b   D1,D0
02:0003D354 6662            	 11599:     bne  _L_z04_UpdatePatraChild_Exit
                            	 11600:     even
                            	 11601: _L_z04_UpdatePatraChild_Ready:
                            	 11602:     ; Once the patra child in the last slot (9) reaches here, advance
                            	 11603:     ; the patra parent's state.
                            	 11604:     ;
02:0003D356 0C020009        	 11605:     cmpi.b  #$09,D2
02:0003D35A 6604            	 11606:     bne  _anon_z04_157
02:0003D35C 522C00AD        	 11607:     addq.b  #1,($00AD,A4)
                            	 11608: _anon_z04_157:
                            	 11609:     ; Go to state 1 to orbit.
                            	 11610:     ;
02:0003D360 41EC00AC        	 11611:     lea     ($00AC,A4),A0
02:0003D364 52302000        	 11612:     addq.b  #1,(A0,D2.W)
                            	 11613:     ; TODO: ?
                            	 11614:     ;
02:0003D368 103C0080        	 11615:     move.b  #$80,D0
02:0003D36C 41EC0098        	 11616:     lea     ($0098,A4),A0
02:0003D370 11802000        	 11617:     move.b  D0,(A0,D2.W)
                            	 11618:     ; Set angle $18 (N).
                            	 11619:     ;
02:0003D374 7018            	 11620:     moveq   #24,D0
02:0003D376 41EC0394        	 11621:     lea     ($0394,A4),A0
02:0003D37A 11802000        	 11622:     move.b  D0,(A0,D2.W)
                            	 11623:     ; This location is right above Patra.
                            	 11624:     ; Set X coordinate to Patra's.
                            	 11625:     ;
02:0003D37E 102C0071        	 11626:     move.b  ($0071,A4),D0
02:0003D382 19802070        	 11627:     move.b  D0,($70,A4,D2.W)
                            	 11628:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 11629:     ; Else use radius $18. Store the chosen value in [00].
                            	 11630:     ;
02:0003D386 702C            	 11631:     moveq   #44,D0
02:0003D388 7600            	 11632:     moveq   #0,D3
02:0003D38A 41EC034F        	 11633:     lea     ($034F,A4),A0
02:0003D38E 16302000        	 11634:     move.b  (A0,D2.W),D3
02:0003D392 0C030025        	 11635:     cmpi.b  #$25,D3
02:0003D396 6702            	 11636:     beq  _anon_z04_158
02:0003D398 7018            	 11637:     moveq   #24,D0
                            	 11638: _anon_z04_158:
02:0003D39A 1880            	 11639:     move.b  D0,($0000,A4)
                            	 11640:     ; This location is right above Patra.
                            	 11641:     ; Set Y coordinate to (Patra's Y - [00]).
                            	 11642:     ;
02:0003D39C 102C0085        	 11643:     move.b  ($0085,A4),D0
02:0003D3A0 003C0011        	 11644:     ori     #$11,CCR  ; SEC: set C+X
02:0003D3A4 1214            	 11645:     move.b  ($0000,A4),D1
02:0003D3A6 0A3C0010        	 11646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D3AA 9101            	 11647:     subx.b  D1,D0   ; SBC $00
02:0003D3AC 0A3C0010        	 11648:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D3B0 41EC0084        	 11649:     lea     ($0084,A4),A0
02:0003D3B4 11802000        	 11650:     move.b  D0,(A0,D2.W)
                            	 11651:     even
