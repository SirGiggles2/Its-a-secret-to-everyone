02:0003ABEC 0A000003        	  6282:     eori.b #$03,D0
02:0003ABF0 19400003        	  6283:     move.b  D0,($0003,A4)
02:0003ABF4 7600            	  6284:     moveq   #0,D3
02:0003ABF6 162C000A        	  6285:     move.b  ($000A,A4),D3
                            	  6286:     ; Look up the tile for this sprite.
                            	  6287:     ; If it's not the first one (face), then go write the sprite record.
