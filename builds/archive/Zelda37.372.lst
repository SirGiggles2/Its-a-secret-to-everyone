                            	  8921: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  8922:     ; At this point, we have a hand that just died.
                            	  8923:     ;
                            	  8924:     ; For each hand, from 3 to 0, indexed by 0:
                            	  8925:     ;
02:0003BF64 7603            	  8926:     moveq   #3,D3
                            	  8927:     ; Count how many are allocated.
                            	  8928:     ; This includes the current dead one, and the other living ones.
                            	  8929:     ; Store the count in [00].
                            	  8930:     ;
02:0003BF66 7000            	  8931:     moveq   #0,D0
02:0003BF68 1880            	  8932:     move.b  D0,($0000,A4)
                            	  8933:     even
                            	  8934: _L_z04_Manhandla_CheckCollisions_LoopHand:
02:0003BF6A 41EC0350        	  8935:     lea     ($0350,A4),A0
02:0003BF6E 10303000        	  8936:     move.b  (A0,D3.W),D0
02:0003BF72 0C00003C        	  8937:     cmpi.b  #$3C,D0
02:0003BF76 6602            	  8938:     bne  _anon_z04_113
02:0003BF78 5214            	  8939:     addq.b  #1,($0000,A4)
                            	  8940: _anon_z04_113:
02:0003BF7A 5303            	  8941:     subq.b  #1,D3
02:0003BF7C 6AEC            	  8942:     bpl  _L_z04_Manhandla_CheckCollisions_LoopHand
                            	  8943:     ; Decrease by 1, to account for the current dead one.
                            	  8944:     ;
02:0003BF7E 5314            	  8945:     subq.b  #1,($0000,A4)
                            	  8946:     ; If the count >= 0 (signed comparison), then
                            	  8947:     ; go change this hand object to the dead dummy.
                            	  8948:     ;
02:0003BF80 6B02            	  8949:     bmi  _anon_z04_114
02:0003BF82 661A            	  8950:     bne  _L_z04_Manhandla_CheckCollisions_MakeDeadDummy
                            	  8951: _anon_z04_114:
                            	  8952:     ; The last hand died. So, kill the base.
                            	  8953:     ;
                            	  8954:     ; Change the base segment's object type to the dead dummy.
                            	  8955:     ; Immediately set metastate to $10, instead of waiting for
                            	  8956:     ; the dead dummy object's update routine to do it.
                            	  8957:     ; Also set its timer to $10.
                            	  8958:     ;
02:0003BF84 61001A86        	  8959:     jsr     PlayBossDeathCry
02:0003BF88 705D            	  8960:     moveq   #93,D0
02:0003BF8A 19400354        	  8961:     move.b  D0,($0354,A4)
02:0003BF8E 7010            	  8962:     moveq   #16,D0
02:0003BF90 1940040A        	  8963:     move.b  D0,($040A,A4)
02:0003BF94 1940002D        	  8964:     move.b  D0,($002D,A4)
                            	  8965:     even
