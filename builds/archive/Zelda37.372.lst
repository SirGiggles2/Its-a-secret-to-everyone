                            	  3271:     ; Else go loop again.
                            	  3272:     ;
02:000497BA 7400            	  3273:     moveq   #0,D2
02:000497BC 142C0340        	  3274:     move.b  ($0340,A4),D2
02:000497C0 41EC0405        	  3275:     lea     ($0405,A4),A0
02:000497C4 10302000        	  3276:     move.b  (A0,D2.W),D0
02:000497C8 662E            	  3277:     bne  _L_z07_BeginUpdateWorld_NextObject
02:000497CA 41EC04BF        	  3278:     lea     ($04BF,A4),A0
02:000497CE 10302000        	  3279:     move.b  (A0,D2.W),D0
02:000497D2 02000001        	  3280:     andi.b #$01,D0
02:000497D6 6620            	  3281:     bne  _L_z07_BeginUpdateWorld_NextObject
                            	  3282:     ; If no attribute 1, then it indicates not to skip drawing. So, animate and draw.
                            	  3283:     ;
02:000497D8 41EC04BF        	  3284:     lea     ($04BF,A4),A0
02:000497DC 10302000        	  3285:     move.b  (A0,D2.W),D0
02:000497E0 02000004        	  3286:     andi.b #$04,D0
02:000497E4 6606            	  3287:     bne  _anon_z07_10
02:000497E6 4EB900030904    	  3288:     jsr     AnimateAndDrawObjectWalking
                            	  3289: _anon_z07_10:
