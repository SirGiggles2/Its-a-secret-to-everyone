02:0003D23A 41EC0084        	 11435:     lea     ($0084,A4),A0
02:0003D23E 10302000        	 11436:     move.b  (A0,D2.W),D0
02:0003D242 122C04E6        	 11437:     move.b  ($04E6,A4),D1
