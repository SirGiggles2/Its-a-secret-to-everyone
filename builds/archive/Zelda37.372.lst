02:0003B53C 6100D05E        	  7552:     jsr     DrawObjectMirroredOverLink
                            	  7553:     ; Check object collisions.
                            	  7554:     ; If this monster hasn't died, then return.
                            	  7555:     ;
02:0003B540 4EB900030C7E    	  7556:     jsr     CheckMonsterCollisions
02:0003B546 41EC0405        	  7557:     lea     ($0405,A4),A0
