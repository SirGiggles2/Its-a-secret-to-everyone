                            	  1523: UpdateNormalZolOrGel:
02:00038A44 41EC03BC        	  1524:     lea     ($03BC,A4),A0
02:00038A48 11802000        	  1525:     move.b  D0,(A0,D2.W)
                            	  1526:     ; If object timer >= 5, then return.
                            	  1527:     ;
02:00038A4C 10342028        	  1528:     move.b  ($28,A4,D2.W),D0
02:00038A50 0C000005        	  1529:     cmpi.b  #$05,D0
02:00038A54 644E            	  1530:     bcc  _L_z04_UpdateNormalZolOrGel_Exit
02:00038A56 7020            	  1531:     moveq   #32,D0
02:00038A58 41EC041F        	  1532:     lea     ($041F,A4),A0
02:00038A5C 11802000        	  1533:     move.b  D0,(A0,D2.W)
02:00038A60 6100F6B4        	  1534:     jsr     Wanderer_TargetPlayer
                            	  1535:     ; If the monster is between squares, or timer <> 0; then return.
                            	  1536:     ;
02:00038A64 41EC0394        	  1537:     lea     ($0394,A4),A0
02:00038A68 10302000        	  1538:     move.b  (A0,D2.W),D0
02:00038A6C 12342028        	  1539:     move.b  ($28,A4,D2.W),D1
02:00038A70 8001            	  1540:     or.b  D1,D0
02:00038A72 6630            	  1541:     bne  _L_z04_UpdateNormalZolOrGel_Exit
                            	  1542:     ; Choose a random index (0 to 3) to look up an amount of time.
                            	  1543:     ;
02:00038A74 10342018        	  1544:     move.b  ($18,A4,D2.W),D0
02:00038A78 02000003        	  1545:     andi.b #$03,D0
02:00038A7C 7600            	  1546:     moveq   #0,D3
02:00038A7E 1600            	  1547:     move.b  D0,D3
                            	  1548:     ; If the monster is Zol, then go use this index as is.
                            	  1549:     ;
02:00038A80 41EC034F        	  1550:     lea     ($034F,A4),A0
02:00038A84 10302000        	  1551:     move.b  (A0,D2.W),D0
02:00038A88 0C000013        	  1552:     cmpi.b  #$13,D0
02:00038A8C 6708            	  1553:     beq  _L_z04_UpdateNormalZolOrGel_SetDelay
                            	  1554:     ; Else it's a gel. Add 4 to the index to look in the set of times
                            	  1555:     ; for Gel.
                            	  1556:     ;
02:00038A8E 5203            	  1557:     addq.b  #1,D3
02:00038A90 5203            	  1558:     addq.b  #1,D3
02:00038A92 5203            	  1559:     addq.b  #1,D3
02:00038A94 5203            	  1560:     addq.b  #1,D3
                            	  1561:     even
