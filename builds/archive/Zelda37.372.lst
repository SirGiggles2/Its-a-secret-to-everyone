                            	  7545: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  7546:     ; In this state, we have to draw Like-like over Link.
                            	  7547:     ; So, don't use the usual sprite writing code that cycles sprites.
                            	  7548:     ;
02:0003B52E 4EB90004AFFA    	  7549:     jsr     Anim_FetchObjPosForSpriteDescriptor
