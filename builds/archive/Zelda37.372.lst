02:0004A37E 1214            	  5079:     move.b  ($0000,A4),D1
02:0004A380 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A384 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004A386 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
