02:0003B460 7600            	  7457:     moveq   #0,D3
02:0003B462 41EC03E4        	  7458:     lea     ($03E4,A4),A0
02:0003B466 16302000        	  7459:     move.b  (A0,D2.W),D3
02:0003B46A 5203            	  7460:     addq.b  #1,D3
02:0003B46C 1003            	  7461:     move.b  D3,D0
02:0003B46E 02000003        	  7462:     andi.b #$03,D0
