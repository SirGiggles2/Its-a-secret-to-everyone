02:0003E042 0A3C0010        	 13506:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E046 9101            	 13507:     subx.b  D1,D0   ; SBC $02
02:0003E048 0A3C0010        	 13508:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E04C 41EC0412        	 13509:     lea     ($0412,A4),A0
