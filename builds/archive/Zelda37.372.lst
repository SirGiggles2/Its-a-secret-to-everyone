02:0003E5A8 19410006        	   631:     move.b  D1,($0006,A4)
02:0003E5AC 669E            	   632:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003E5AE 522C00E1        	   633:     addq.b  #1,($00E1,A4)
02:0003E5B2 4E75            	   634:     rts
