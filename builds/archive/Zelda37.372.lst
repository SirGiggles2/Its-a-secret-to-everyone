02:000497A4 41EC034F        	  3262:     lea     ($034F,A4),A0
02:000497A8 10302000        	  3263:     move.b  (A0,D2.W),D0
02:000497AC 674A            	  3264:     beq  _L_z07_BeginUpdateWorld_NextObject
02:000497AE 41EC034F        	  3265:     lea     ($034F,A4),A0
02:000497B2 10302000        	  3266:     move.b  (A0,D2.W),D0
02:000497B6 6100193C        	  3267:     jsr     UpdateObject
                            	  3268:     ; If the object is autonomous and not checking collisions itself,
                            	  3269:     ; then see about checking collisions and drawing on its behalf.
