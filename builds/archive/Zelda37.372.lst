                            	  2032: _L_z04__TryShooting_TryShootingNow:
                            	  2033:     ; Summary
                            	  2034:     ;
                            	  2035:     ; if temporarily invincible then
                            	  2036:     ;   shoot timer := 0
                            	  2037:     ; elif shoot timer > 0 then
                            	  2038:     ;   decrement shoot timer
                            	  2039:     ; elif wants to shoot then
                            	  2040:     ;   shoot timer := $30
                            	  2041:     ;
                            	  2042:     ; qspeed := [01]
                            	  2043:     ;
                            	  2044:     ; if shoot timer <> 0 then
                            	  2045:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  2046:     ;     shoot
                            	  2047:     ;     if succeeded then
                            	  2048:     ;       shoot timer := 0
                            	  2049:     ;       qspeed := 0
                            	  2050:     ;   else
                            	  2051:     ;     qspeed := 0
                            	  2052:     ;
                            	  2053:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038DB6 102C0001        	  2054:     move.b  ($0001,A4),D0
02:00038DBA 1883            	  2055:     move.b  D3,($0000,A4)
02:00038DBC 1B00            	  2056:     move.b  D0,-(A5)  ; PHA
02:00038DBE 7600            	  2057:     moveq   #0,D3
                            	  2058:     ; If not temporarily invincible,
                            	  2059:     ;
02:00038DC0 41EC04F0        	  2060:     lea     ($04F0,A4),A0
02:00038DC4 10302000        	  2061:     move.b  (A0,D2.W),D0
02:00038DC8 661A            	  2062:     bne  _L_z04__TryShooting_SetShootTimer
                            	  2063:     ; then Y := shoot timer - 1
                            	  2064:     ;
02:00038DCA 7600            	  2065:     moveq   #0,D3
02:00038DCC 41EC0451        	  2066:     lea     ($0451,A4),A0
02:00038DD0 16302000        	  2067:     move.b  (A0,D2.W),D3
02:00038DD4 5303            	  2068:     subq.b  #1,D3
                            	  2069:     ; If Y register < 0, then shoot timer is 0.
                            	  2070:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  2071:     ; Else go set a non-zero speed and return.
                            	  2072:     ;
02:00038DD6 6A0C            	  2073:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038DD8 41EC0412        	  2074:     lea     ($0412,A4),A0
02:00038DDC 10302000        	  2075:     move.b  (A0,D2.W),D0
02:00038DE0 6736            	  2076:     beq  _L_z04__TryShooting_SetSpeed
