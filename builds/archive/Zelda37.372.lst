                            	 13457: ; Params:
                            	 13458: ; A: high bits of cosine to use in calculating Y increment
                            	 13459: ; Y: high bits of sine to use in calculating X increment
                            	 13460: ; X: object index
                            	 13461: ;
                            	 13462: ; Returns:
