02:0003AA58 0200000F        	  6056:     andi.b #$0F,D0
02:0003AA5C 00000007        	  6057:     ori.b #$07,D0
02:0003AA60 41EC0394        	  6058:     lea     ($0394,A4),A0
02:0003AA64 11802000        	  6059:     move.b  D0,(A0,D2.W)
02:0003AA68 101D            	  6060:     move.b  (A5)+,D0  ; PLA
                            	  6061:     ; Randomly head left or right.
                            	  6062:     ;
