02:000393F0 19802070        	  2927:     move.b  D0,($70,A4,D2.W)
                            	  2928:     ; If facing down, then use Y offset $28.
                            	  2929:     ; Else store Y offset -$28 in [00].
                            	  2930:     ;
02:000393F4 7628            	  2931:     moveq   #40,D3
02:000393F6 41EC0098        	  2932:     lea     ($0098,A4),A0
02:000393FA 10302000        	  2933:     move.b  (A0,D2.W),D0
02:000393FE 02000008        	  2934:     andi.b #$08,D0
02:00039402 6704            	  2935:     beq  _anon_z04_44
02:00039404 163C00D8        	  2936:     move.b  #$D8,D3
                            	  2937: _anon_z04_44:
02:00039408 1883            	  2938:     move.b  D3,($0000,A4)
                            	  2939:     ; Add Link's Y and the vertical offset.
                            	  2940:     ;
02:0003940A 102C0084        	  2941:     move.b  ($0084,A4),D0
