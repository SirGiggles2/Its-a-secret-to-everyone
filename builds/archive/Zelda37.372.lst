                            	  5283:     ; Chase while flying, as usual.
                            	  5284:     ;
02:0003A4D0 610039C8        	  5285:     jsr     Flyer_Chase
                            	  5286:     ; If timer has not expired, then
                            	  5287:     ; go see if it's time to propagate direction changes down the chain.
                            	  5288:     ;
02:0003A4D4 10342028        	  5289:     move.b  ($28,A4,D2.W),D0
02:0003A4D8 6702            	  5290:     beq.s  __far_z_04_0039
