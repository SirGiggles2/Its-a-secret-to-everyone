02:0003B382 41EC042C        	  7358:     lea     ($042C,A4),A0
02:0003B386 12302000        	  7359:     move.b  (A0,D2.W),D1
02:0003B38A B001            	  7360:     cmp.b   D1,D0
02:0003B38C 65000096        	  7361:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
