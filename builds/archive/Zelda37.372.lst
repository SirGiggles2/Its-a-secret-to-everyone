02:0003D540 6100AB6E        	 11880:     jsr     PlayBossHitCryIfNeeded
                            	 11881:     ; Go handle the brown state specially.
                            	 11882:     ;
02:0003D544 41EC00AC        	 11883:     lea     ($00AC,A4),A0
02:0003D548 10302000        	 11884:     move.b  (A0,D2.W),D0
02:0003D54C 6702            	 11885:     beq.s  __far_z_04_0117
