02:0003D4F6 19400601        	 11826:     move.b  D0,($0601,A4)
                            	 11827: _anon_z04_160:
02:0003D4FA 0A3C0001        	 11828:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D4FE 4E75            	 11829:     rts
                            	 11830: 
                            	 11831: ; Description:
                            	 11832: ; Lift up the Triforce of Courage while the room is light.
                            	 11833: ;
                            	 11834: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 11835: ;
                            	 11836:     even
                            	 11837: Ganon_ScenePhase1:
02:0003D500 701B            	 11838:     moveq   #27,D0
02:0003D502 19400505        	 11839:     move.b  D0,($0505,A4)
                            	 11840:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 11841:     ;
02:0003D506 102C0028        	 11842:     move.b  ($0028,A4),D0
02:0003D50A 6702            	 11843:     beq.s  __far_z_04_0115
02:0003D50C 6012            	 11844:     jmp  Ganon_DrawBodyFrame0
                            	 11845: __far_z_04_0115:
                            	 11846:     ; Once the timer expires:
                            	 11847:     ; 1. unhalt Link
                            	 11848:     ; 2. clear the item to lift
                            	 11849:     ; 3. play level 9 song
                            	 11850:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 11851:     ;
02:0003D50E 194000AC        	 11852:     move.b  D0,($00AC,A4)
02:0003D512 19400505        	 11853:     move.b  D0,($0505,A4)
02:0003D516 7020            	 11854:     moveq   #32,D0
02:0003D518 19400600        	 11855:     move.b  D0,($0600,A4)
02:0003D51C 522C0445        	 11856:     addq.b  #1,($0445,A4)
                            	 11857:     even
                            	 11858: Ganon_DrawBodyFrame0:
                            	 11859:     ; When holding the Triforce of Courage, only draw Ganon
                            	 11860:     ; with animation frame 0.
                            	 11861:     ;
02:0003D520 7000            	 11862:     moveq   #0,D0
02:0003D522 41EC046B        	 11863:     lea     ($046B,A4),A0
02:0003D526 11802000        	 11864:     move.b  D0,(A0,D2.W)
02:0003D52A 600002EC        	 11865:     jmp     Ganon_DrawBody
                            	 11866: 
                            	 11867: ; Description:
                            	 11868: ; Fighting Ganon.
                            	 11869: ;
