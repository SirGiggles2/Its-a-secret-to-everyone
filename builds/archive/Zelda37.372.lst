                            	  1170: ScrollHorizontal:
                            	  1171:     ; Scrolling left or right.
                            	  1172:     ;
                            	  1173:     ; Keep in mind that columns will not be copied if CurColumn
                            	  1174:     ; is not between 1 and $20.
                            	  1175:     ;
                            	  1176:     ; Set up a starting column number well past the beginning or
                            	  1177:     ; end of the play area; so that we don't write to a part of
