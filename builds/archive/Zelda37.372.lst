                            	  7323: UpdatePolsVoiceState1_Jumping:
                            	  7324:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7325:     ;
02:0003B328 41EC0444        	  7326:     lea     ($0444,A4),A0
02:0003B32C 10302000        	  7327:     move.b  (A0,D2.W),D0
02:0003B330 023C00EE        	  7328:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B334 123C0038        	  7329:     move.b  #$38,D1
02:0003B338 D101            	  7330:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003B33A 41EC0444        	  7331:     lea     ($0444,A4),A0
02:0003B33E 11802000        	  7332:     move.b  D0,(A0,D2.W)
                            	  7333:     ; Add Carry to high speed byte (vertical).
                            	  7334:     ;
02:0003B342 41EC0412        	  7335:     lea     ($0412,A4),A0
02:0003B346 10302000        	  7336:     move.b  (A0,D2.W),D0
02:0003B34A 123C0000        	  7337:     move.b  #$00,D1
02:0003B34E D101            	  7338:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003B350 41EC0412        	  7339:     lea     ($0412,A4),A0
02:0003B354 11802000        	  7340:     move.b  D0,(A0,D2.W)
                            	  7341:     ; Add high speed byte to Y coordinate.
                            	  7342:     ;
02:0003B358 023C00EE        	  7343:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B35C 41EC0084        	  7344:     lea     ($0084,A4),A0
02:0003B360 12302000        	  7345:     move.b  (A0,D2.W),D1
02:0003B364 D101            	  7346:     addx.b  D1,D0   ; ADC ObjY,X
02:0003B366 41EC0084        	  7347:     lea     ($0084,A4),A0
02:0003B36A 11802000        	  7348:     move.b  D0,(A0,D2.W)
                            	  7349:     ; If the speed is still negative, then return.
                            	  7350:     ;
02:0003B36E 41EC0412        	  7351:     lea     ($0412,A4),A0
02:0003B372 10302000        	  7352:     move.b  (A0,D2.W),D0
