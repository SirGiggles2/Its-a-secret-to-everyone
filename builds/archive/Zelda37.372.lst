02:0003D266 11802000        	 11465:     move.b  D0,(A0,D2.W)
02:0003D26A 41EC0478        	 11466:     lea     ($0478,A4),A0
02:0003D26E 11802000        	 11467:     move.b  D0,(A0,D2.W)
