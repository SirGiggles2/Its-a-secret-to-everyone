02:0003BF30 0C020005        	  8896:     cmpi.b  #$05,D2
02:0003BF34 660A            	  8897:     bne  _anon_z04_112
02:0003BF36 7000            	  8898:     moveq   #0,D0
02:0003BF38 41EC04F0        	  8899:     lea     ($04F0,A4),A0
02:0003BF3C 11802000        	  8900:     move.b  D0,(A0,D2.W)
                            	  8901: _anon_z04_112:
02:0003BF40 6100C16E        	  8902:     jsr     PlayBossHitCryIfNeeded
                            	  8903:     ; If still alive, then return.
                            	  8904:     ;
02:0003BF44 41EC0405        	  8905:     lea     ($0405,A4),A0
02:0003BF48 10302000        	  8906:     move.b  (A0,D2.W),D0
02:0003BF4C 674E            	  8907:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003BF4E 4EB9000499B4    	  8908:     jsr     ResetShoveInfo
                            	  8909:     ; Don't let the base die on its own.
                            	  8910:     ; If this is the base, then reset metastate, and return.
                            	  8911:     ;
                            	  8912:     ; The base only dies once the last hand dies.
                            	  8913:     ;
02:0003BF54 0C020005        	  8914:     cmpi.b  #$05,D2
02:0003BF58 660A            	  8915:     bne  _L_z04_Manhandla_CheckCollisions_CountHands
02:0003BF5A 41EC0405        	  8916:     lea     ($0405,A4),A0
02:0003BF5E 11802000        	  8917:     move.b  D0,(A0,D2.W)
02:0003BF62 6038            	  8918:     jmp     _L_z04_Manhandla_CheckCollisions_Exit
