                            	  9121:     even
                            	  9122: Manhandla_Draw:
02:0003C0D4 4EB90004AFFA    	  9123:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9124:     ; Push the "frame image and sprite attributes" value.
                            	  9125:     ;
02:0003C0DA 41EC0478        	  9126:     lea     ($0478,A4),A0
02:0003C0DE 10302000        	  9127:     move.b  (A0,D2.W),D0
02:0003C0E2 1B00            	  9128:     move.b  D0,-(A5)  ; PHA
                            	  9129:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9130:     ; passed along as is.
                            	  9131:     ;
02:0003C0E4 02000080        	  9132:     andi.b #$80,D0
02:0003C0E8 00000001        	  9133:     ori.b #$01,D0
02:0003C0EC 4EB900030C04    	  9134:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003C0F2 101D            	  9135:     move.b  (A5)+,D0  ; PLA
02:0003C0F4 1B00            	  9136:     move.b  D0,-(A5)  ; PHA
                            	  9137:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9138:     ;
02:0003C0F6 02000040        	  9139:     andi.b #$40,D0
02:0003C0FA 6704            	  9140:     beq  _anon_z04_116
02:0003C0FC 522C000F        	  9141:     addq.b  #1,($000F,A4)
                            	  9142: _anon_z04_116:
02:0003C100 101D            	  9143:     move.b  (A5)+,D0  ; PLA
                            	  9144:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9145:     ; These are the 2 frame images of the horizontal hands.
                            	  9146:     ;
                            	  9147:     ; Else draw the base and vertical hands mirrored.
                            	  9148:     ;
02:0003C102 0200000F        	  9149:     andi.b #$0F,D0
02:0003C106 0C000002        	  9150:     cmpi.b  #$02,D0
02:0003C10A 670C            	  9151:     beq  _anon_z04_117
02:0003C10C 0C000003        	  9152:     cmpi.b  #$03,D0
02:0003C110 6706            	  9153:     beq  _anon_z04_117
02:0003C112 4EF90003090E    	  9154:     jmp     DrawObjectMirrored
                            	  9155: 
