02:0002BFAE 003C0001        	  2483:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2484:     eori    #$01,CCR
02:0002BFB6 4E75            	  2485:     rts
                            	  2486: .cc_cnras:
02:0002BFB8 023C00FE        	  2487:     andi    #$FE,CCR
