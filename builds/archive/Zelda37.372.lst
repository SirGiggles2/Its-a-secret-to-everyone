                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004A390 41EC0084        	  5092:     lea     ($0084,A4),A0
02:0004A394 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004A398 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
