                            	  1444: Gel_Move:
                            	  1445:     ; Go handle state 0 or 2 as appropriate.
                            	  1446:     ;
02:000389C4 7600            	  1447:     moveq   #0,D3
02:000389C6 41EC00AC        	  1448:     lea     ($00AC,A4),A0
02:000389CA 16302000        	  1449:     move.b  (A0,D2.W),D3
02:000389CE 6758            	  1450:     beq  _L_z04_Gel_Move_State0
02:000389D0 5303            	  1451:     subq.b  #1,D3
02:000389D2 666E            	  1452:     bne  _L_z04_Gel_Move_State2
                            	  1453:     ; State 1.
                            	  1454:     ;
                            	  1455:     ; If the timer has not expired, then move.
                            	  1456:     ;
02:000389D4 10342028        	  1457:     move.b  ($28,A4,D2.W),D0
02:000389D8 6706            	  1458:     beq  _L_z04_Gel_Move_Move
02:000389DA 610000D2        	  1459:     jsr     Gel_MoveSplitting
                            	  1460:     ; If not blocked while moving, then return.
                            	  1461:     ;
02:000389DE 6446            	  1462:     bcc  _L_z04_Gel_Move_Exit
                            	  1463:     even
                            	  1464: _L_z04_Gel_Move_Move:
                            	  1465:     ; Blocked or timer expired.
                            	  1466:     ;
                            	  1467:     ; Set X coordinate to ((X + 8) AND $F0).
                            	  1468:     ;
02:000389E0 10342070        	  1469:     move.b  ($70,A4,D2.W),D0
02:000389E4 023C00EE        	  1470:     andi    #$EE,CCR  ; CLC: clear C+X
02:000389E8 123C0008        	  1471:     move.b  #$08,D1
02:000389EC D101            	  1472:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000389EE 020000F0        	  1473:     andi.b #$F0,D0
02:000389F2 19802070        	  1474:     move.b  D0,($70,A4,D2.W)
                            	  1475:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1476:     ;
02:000389F6 41EC0084        	  1477:     lea     ($0084,A4),A0
02:000389FA 10302000        	  1478:     move.b  (A0,D2.W),D0
02:000389FE 123C0008        	  1479:     move.b  #$08,D1
02:00038A02 D101            	  1480:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00038A04 020000F0        	  1481:     andi.b #$F0,D0
02:00038A08 0000000D        	  1482:     ori.b #$0D,D0
02:00038A0C 41EC0084        	  1483:     lea     ($0084,A4),A0
02:00038A10 11802000        	  1484:     move.b  D0,(A0,D2.W)
                            	  1485:     ; Reset the grid offset, and go to state 2.
                            	  1486:     ;
02:00038A14 7000            	  1487:     moveq   #0,D0
02:00038A16 41EC0394        	  1488:     lea     ($0394,A4),A0
02:00038A1A 11802000        	  1489:     move.b  D0,(A0,D2.W)
02:00038A1E 41EC00AC        	  1490:     lea     ($00AC,A4),A0
02:00038A22 52302000        	  1491:     addq.b  #1,(A0,D2.W)
                            	  1492:     even
