                            	  7876: Submenu_CueTransferRowOW:
                            	  7877:     ;
                            	  7878:     ;
                            	  7879:     ; If menu scroll value is negative, then we transferred everything.
                            	  7880:     ; So, return.
                            	  7881:     ;
