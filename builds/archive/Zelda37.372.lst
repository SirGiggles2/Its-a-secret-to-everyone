                            	  6482: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  6483:     ; Advance the substate.
                            	  6484:     ;
02:0003AD78 41EC042C        	  6485:     lea     ($042C,A4),A0
02:0003AD7C 52302000        	  6486:     addq.b  #1,(A0,D2.W)
                            	  6487:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  6488:     ;
02:0003AD80 41EC042C        	  6489:     lea     ($042C,A4),A0
