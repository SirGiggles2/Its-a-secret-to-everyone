02:000386AC 41EC0084        	  1030:     lea     ($0084,A4),A0
02:000386B0 10302000        	  1031:     move.b  (A0,D2.W),D0
02:000386B4 023C00EE        	  1032:     andi    #$EE,CCR  ; CLC: clear C+X
02:000386B8 41F9000385CE    	  1033:     lea     (ShotBounceHeights).l,A0
02:000386BE 12303000        	  1034:     move.b  (A0,D3.W),D1
02:000386C2 D101            	  1035:     addx.b  D1,D0   ; ADC ShotBounceHeights,Y
02:000386C4 41EC0084        	  1036:     lea     ($0084,A4),A0
02:000386C8 11802000        	  1037:     move.b  D0,(A0,D2.W)
02:000386CC 10342070        	  1038:     move.b  ($70,A4,D2.W),D0
02:000386D0 023C00EE        	  1039:     andi    #$EE,CCR  ; CLC: clear C+X
02:000386D4 41F9000385CC    	  1040:     lea     (ShotBounceWidths).l,A0
02:000386DA 12303000        	  1041:     move.b  (A0,D3.W),D1
02:000386DE D101            	  1042:     addx.b  D1,D0   ; ADC ShotBounceWidths,Y
02:000386E0 19802070        	  1043:     move.b  D0,($70,A4,D2.W)
                            	  1044:     ; Add 2 to the bounce distance.
                            	  1045:     ; The absolute value of one of the displacements is 2.
                            	  1046:     ;
02:000386E4 41EC0394        	  1047:     lea     ($0394,A4),A0
02:000386E8 10302000        	  1048:     move.b  (A0,D2.W),D0
02:000386EC 023C00EE        	  1049:     andi    #$EE,CCR  ; CLC: clear C+X
02:000386F0 123C0002        	  1050:     move.b  #$02,D1
02:000386F4 D101            	  1051:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000386F6 41EC0394        	  1052:     lea     ($0394,A4),A0
02:000386FA 11802000        	  1053:     move.b  D0,(A0,D2.W)
