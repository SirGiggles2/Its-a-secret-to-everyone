02:0003A414 19802028        	  5183:     move.b  D0,($28,A4,D2.W)
02:0003A418 101D            	  5184:     move.b  (A5)+,D0  ; PLA
02:0003A41A 41EC0098        	  5185:     lea     ($0098,A4),A0
02:0003A41E 11802000        	  5186:     move.b  D0,(A0,D2.W)
                            	  5187:     ; If this segment is still alive, then return.
                            	  5188:     ;
02:0003A422 41EC0405        	  5189:     lea     ($0405,A4),A0
02:0003A426 10302000        	  5190:     move.b  (A0,D2.W),D0
02:0003A42A 6774            	  5191:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5192:     ; This segment is dead. We'll swap the tail segment with this
                            	  5193:     ; dead segment. This way, moldorm heads are always rooted
                            	  5194:     ; in slots 5 and $A; and the segments are continguous.
                            	  5195:     ;
                            	  5196:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5197:     ;
                            	  5198:     ; Note that this is not a true swap, because the tail's HP
                            	  5199:     ; might be less than $20.
                            	  5200:     ;
02:0003A42C 7020            	  5201:     moveq   #32,D0
02:0003A42E 41EC0485        	  5202:     lea     ($0485,A4),A0
02:0003A432 11802000        	  5203:     move.b  D0,(A0,D2.W)
02:0003A436 61000608        	  5204:     jsr     CheckBossHitReaction
                            	  5205:     ; Look for the tail segment, starting from the low end
                            	  5206:     ; of the chain that this dead segment belongs to.
                            	  5207:     ;
02:0003A43A 163C00FF        	  5208:     move.b  #$FF,D3
02:0003A43E 0C020006        	  5209:     cmpi.b  #$06,D2
02:0003A442 6502            	  5210:     bcs  _anon_z04_80
02:0003A444 7604            	  5211:     moveq   #4,D3
                            	  5212: _anon_z04_80:
02:0003A446 5203            	  5213:     addq.b  #1,D3
02:0003A448 41EC0350        	  5214:     lea     ($0350,A4),A0
02:0003A44C 10303000        	  5215:     move.b  (A0,D3.W),D0
02:0003A450 0C000041        	  5216:     cmpi.b  #$41,D0
02:0003A454 66F0            	  5217:     bne  _anon_z04_80
                            	  5218:     ; I don't know why the object timer of the tail segment that will
                            	  5219:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5220:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5221:     ; there, the object timer is set to 6.
                            	  5222:     ;
02:0003A456 7011            	  5223:     moveq   #17,D0
02:0003A458 19803029        	  5224:     move.b  D0,($29,A4,D3.W)
                            	  5225:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5226:     ; segment to the tail segment.
                            	  5227:     ;
02:0003A45C 41EC04F0        	  5228:     lea     ($04F0,A4),A0
02:0003A460 10302000        	  5229:     move.b  (A0,D2.W),D0
02:0003A464 41EC04F1        	  5230:     lea     ($04F1,A4),A0
02:0003A468 11803000        	  5231:     move.b  D0,(A0,D3.W)
02:0003A46C 10342070        	  5232:     move.b  ($70,A4,D2.W),D0
02:0003A470 19803071        	  5233:     move.b  D0,($71,A4,D3.W)
02:0003A474 41EC0084        	  5234:     lea     ($0084,A4),A0
02:0003A478 10302000        	  5235:     move.b  (A0,D2.W),D0
02:0003A47C 41EC0085        	  5236:     lea     ($0085,A4),A0
02:0003A480 11803000        	  5237:     move.b  D0,(A0,D3.W)
                            	  5238:     ; If the tail segment found is also a head, then
                            	  5239:     ; the last segment has died. Return.
