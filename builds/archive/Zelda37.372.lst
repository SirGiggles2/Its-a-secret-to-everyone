                            	 12497:     even
                            	 12498: _L_z04_Ganon_AppendPaletteRowTransferRecord_Triforce_CopyBytes:
02:0003D9AA 41F90003D982    	 12499:     lea     (GanonColorTransferRecord).l,A0
02:0003D9B0 10303000        	 12500:     move.b  (A0,D3.W),D0
02:0003D9B4 41EC0302        	 12501:     lea     ($0302,A4),A0
02:0003D9B8 11802000        	 12502:     move.b  D0,(A0,D2.W)
02:0003D9BC 5202            	 12503:     addq.b  #1,D2
