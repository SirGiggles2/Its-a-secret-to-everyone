                            	  8033: HaveInput:
                            	  8034:     ; There were input directions.
                            	  8035:     ;
                            	  8036:     ; If there was only one input direction, go set object direction
                            	  8037:     ; to input direction, and set Link's speed.
                            	  8038:     ;
                            	  8039:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  8040:     ; (X is still 0, because it's Link's object index).
                            	  8041:     ;
02:00042F1E 102C000F        	  8042:     move.b  ($000F,A4),D0
02:00042F22 0C030001        	  8043:     cmpi.b  #$01,D3
02:00042F26 670000B6        	  8044:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8045:     ; There were more than one input directions.
                            	  8046:     ;
                            	  8047:     ; If none were walkable, go set input direction to 0, and return.
                            	  8048:     ;
02:00042F2A 102C000C        	  8049:     move.b  ($000C,A4),D0
02:00042F2E 6604            	  8050:     bne  _anon_z05_174
02:00042F30 60000128        	  8051:     jmp     SetLinkInputDir
