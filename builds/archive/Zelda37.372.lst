                            	 12491:     ;
02:0003D9A2 7400            	 12492:     moveq   #0,D2
02:0003D9A4 142C0301        	 12493:     move.b  ($0301,A4),D2
                            	 12494:     ; Copy the 8 bytes of the palette row transfer record template.
                            	 12495:     ;
