02:00048EE4 122C0004        	  2127:     move.b  ($0004,A4),D1
02:00048EE8 D101            	  2128:     addx.b  D1,D0   ; ADC $04
02:00048EEA 4A02            	  2129:     cmpi.b  #$00,D2
02:00048EEC 66E4            	  2130:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00048EEE 0C000002        	  2131:     cmpi.b  #$02,D0
02:00048EF2 66DE            	  2132:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:00048EF4 7620            	  2133:     moveq   #32,D3
