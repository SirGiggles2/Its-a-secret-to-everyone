02:00040290 12303000        	  4028:     move.b  (A0,D3.W),D1
02:00040294 B001            	  4029:     cmp.b   D1,D0
02:00040296 6510            	  4030:     bcs  _anon_z05_95
02:00040298 41F90004025A    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:0004029E 12303000        	  4032:     move.b  (A0,D3.W),D1
02:000402A2 B001            	  4033:     cmp.b   D1,D0
02:000402A4 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
