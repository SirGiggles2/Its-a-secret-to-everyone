                            	  6878: Dodongo_Draw:
02:0003AFF2 610000F4        	  6879:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  6880:     ; Make a 5-way direction index out of the facing direction
                            	  6881:     ; by shifting right once, and store it in [00].
                            	  6882:     ;
02:0003AFF6 41EC0098        	  6883:     lea     ($0098,A4),A0
02:0003AFFA 10302000        	  6884:     move.b  (A0,D2.W),D0
02:0003AFFE E208            	  6885:     lsr.b  #1,D0   ; LSR A
02:0003B000 1880            	  6886:     move.b  D0,($0000,A4)
                            	  6887:     ; If state = 0, go handle animating the two frames of this state.
                            	  6888:     ;
02:0003B002 7600            	  6889:     moveq   #0,D3
02:0003B004 41EC00AC        	  6890:     lea     ($00AC,A4),A0
02:0003B008 16302000        	  6891:     move.b  (A0,D2.W),D3
02:0003B00C 6744            	  6892:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  6893:     ; If state > 1, then the monster is stunned (state 2).
                            	  6894:     ; So, go switch frames every $20 screen frames.
                            	  6895:     ;
02:0003B00E 7020            	  6896:     moveq   #32,D0
02:0003B010 5303            	  6897:     subq.b  #1,D3
02:0003B012 6640            	  6898:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  6899:     ; State = 1. Bloated.
                            	  6900:     ;
                            	  6901:     ; In substate 0, go animate as usual for walking.
                            	  6902:     ;
02:0003B014 7600            	  6903:     moveq   #0,D3
02:0003B016 41EC042C        	  6904:     lea     ($042C,A4),A0
02:0003B01A 16302000        	  6905:     move.b  (A0,D2.W),D3
02:0003B01E 6732            	  6906:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  6907:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  6908:     ; go fade the boss; so that some frames are not drawn.
                            	  6909:     ;
02:0003B020 0C030002        	  6910:     cmpi.b  #$02,D3
02:0003B024 6718            	  6911:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003B026 0C030003        	  6912:     cmpi.b  #$03,D3
02:0003B02A 6712            	  6913:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  6914:     ; State 1, substate 1
                            	  6915:     ;
                            	  6916:     ; Add $14 to the frame image index to index into the bloated
                            	  6917:     ; frame images and H-flips.
                            	  6918:     ;
02:0003B02C 1014            	  6919:     move.b  ($0000,A4),D0
02:0003B02E 023C00EE        	  6920:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B032 123C0014        	  6921:     move.b  #$14,D1
02:0003B036 D101            	  6922:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003B038 7600            	  6923:     moveq   #0,D3
02:0003B03A 1600            	  6924:     move.b  D0,D3
02:0003B03C 6032            	  6925:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  6926: 
