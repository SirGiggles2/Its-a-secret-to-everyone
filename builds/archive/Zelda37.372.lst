                            	  2329: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2330:     ; Set state 1 to jump.
                            	  2331:     ;
02:00038F6A 41EC00AC        	  2332:     lea     ($00AC,A4),A0
