02:0004A6CE 1940000C        	  5580:     move.b  D0,($000C,A4)
02:0004A6D2 7000            	  5581:     moveq   #0,D0
02:0004A6D4 1940000F        	  5582:     move.b  D0,($000F,A4)
                            	  5583:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5584:     ; and go draw.
                            	  5585:     ;
02:0004A6D8 41EC0098        	  5586:     lea     ($0098,A4),A0
02:0004A6DC 10302000        	  5587:     move.b  (A0,D2.W),D0
02:0004A6E0 4EB900030542    	  5588:     jsr     GetOppositeDir
