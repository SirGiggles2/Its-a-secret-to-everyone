02:000390BE 0C000020        	  2511:     cmpi.b  #$20,D0
02:000390C2 6412            	  2512:     bcc  _anon_z04_39
02:000390C4 003C0011        	  2513:     ori     #$11,CCR  ; SEC: set C+X
02:000390C8 123C0040        	  2514:     move.b  #$40,D1
02:000390CC 0A3C0010        	  2515:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
