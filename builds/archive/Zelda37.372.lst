02:00049F7C 19400394        	  4546:     move.b  D0,($0394,A4)
02:00049F80 7600            	  4547:     moveq   #0,D3
02:00049F82 162C0012        	  4548:     move.b  ($0012,A4),D3
02:00049F86 0C030005        	  4549:     cmpi.b  #$05,D3
02:00049F8A 66EA            	  4550:     bne  _L_z07_Link_EndMoveAndAnimate_CheckWarpsAndAnimate
                            	  4551:     ; Grid offset was a multiple of 8. So, we've stepped a whole tile,
                            	  4552:     ; and need to reset the subroom indicator.
