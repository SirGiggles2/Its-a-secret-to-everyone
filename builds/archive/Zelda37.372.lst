02:0004192E 60C4            	  5714:     jmp  L165D4_Exit
                            	  5715: __far_z_05_0076:
                            	  5716:     ; Turn the door command into the desired open or closed state
                            	  5717:     ; to store in [08].
                            	  5718:     ;
                            	  5719:     ; cmd:  7 6 3 2 
                            	  5720:     ; [08]: 2 0 0 0
                            	  5721:     ;
                            	  5722:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5723:     ; commands intended to be used.
                            	  5724:     ;
                            	  5725:     ; 3 is the end state of 2: close
                            	  5726:     ; 7 is the end state of 6: open
                            	  5727:     ;
02:00041930 02000007        	  5728:     andi.b #$07,D0
02:00041934 7601            	  5729:     moveq   #1,D3
02:00041936 19430002        	  5730:     move.b  D3,($0002,A4)
02:0004193A 122C0002        	  5731:     move.b  ($0002,A4),D1
02:0004193E C200            	  5732:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00041940 6702            	  5733:     beq  _anon_z05_118
02:00041942 E208            	  5734:     lsr.b  #1,D0   ; LSR A
                            	  5735: _anon_z05_118:
02:00041944 0C000002        	  5736:     cmpi.b  #$02,D0
02:00041948 6606            	  5737:     bne  _anon_z05_119
                            	  5738:     ; Command 2 sets Link's timer to $30.
                            	  5739:     ;
02:0004194A 7630            	  5740:     moveq   #48,D3
02:0004194C 19430028        	  5741:     move.b  D3,($0028,A4)
                            	  5742: _anon_z05_119:
02:00041950 02000003        	  5743:     andi.b #$03,D0
02:00041954 003C0011        	  5744:     ori     #$11,CCR  ; SEC: set C+X
02:00041958 123C0001        	  5745:     move.b  #$01,D1
02:0004195C 0A3C0010        	  5746:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041960 9101            	  5747:     subx.b  D1,D0   ; SBC #$01
02:00041962 0A3C0010        	  5748:     eori    #$10,CCR  ; restore X = 6502 C
02:00041966 02000002        	  5749:     andi.b #$02,D0
02:0004196A 19400008        	  5750:     move.b  D0,($0008,A4)
                            	  5751:     ; The command to close a key door or bombable wall does not
                            	  5752:     ; do anything.
                            	  5753:     ;
02:0004196E 102C0054        	  5754:     move.b  ($0054,A4),D0
02:00041972 0C000005        	  5755:     cmpi.b  #$05,D0
02:00041976 6416            	  5756:     bcc  _anon_z05_120
02:00041978 102C0055        	  5757:     move.b  ($0055,A4),D0
02:0004197C 19400002        	  5758:     move.b  D0,($0002,A4)
02:00041980 6100FAEC        	  5759:     jsr     FindDoorAttrByDoorBit
02:00041984 0C000007        	  5760:     cmpi.b  #$07,D0
02:00041988 6704            	  5761:     beq  _anon_z05_120
02:0004198A 6000009C        	  5762:     jmp     L_ResetDoorCmdAndLayOutDoors
                            	  5763: 
                            	  5764: _anon_z05_120:
                            	  5765:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5766:     ;
                            	  5767:     ; Shutters and the commands to open a door always change
                            	  5768:     ; tiles.
                            	  5769:     ;
02:0004198E 61000130        	  5770:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5771:     even
                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:00041992 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00041996 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:0004199A 1014            	  5783:     move.b  ($0000,A4),D0
02:0004199C 41EC0302        	  5784:     lea     ($0302,A4),A0
02:000419A0 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:000419A4 5202            	  5786:     addq.b  #1,D2
02:000419A6 102C0001        	  5787:     move.b  ($0001,A4),D0
02:000419AA 41EC0302        	  5788:     lea     ($0302,A4),A0
02:000419AE 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:000419B2 5202            	  5790:     addq.b  #1,D2
02:000419B4 102C0006        	  5791:     move.b  ($0006,A4),D0
02:000419B8 41EC0302        	  5792:     lea     ($0302,A4),A0
02:000419BC 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:000419C0 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:000419C2 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:000419C6 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:000419C8 7020            	  5803:     moveq   #32,D0
02:000419CA 122C0001        	  5804:     move.b  ($0001,A4),D1
02:000419CE 8001            	  5805:     or.b  D1,D0
02:000419D0 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:000419D4 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:000419D8 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:000419DA 103C00FF        	  5815:     move.b  #$FF,D0
02:000419DE 41EC0302        	  5816:     lea     ($0302,A4),A0
02:000419E2 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:000419E6 1002            	  5818:     move.b  D2,D0
02:000419E8 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:000419EC 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:000419F0 102C0054        	  5829:     move.b  ($0054,A4),D0
02:000419F4 02000003        	  5830:     andi.b #$03,D0
02:000419F8 6708            	  5831:     beq  _anon_z05_122
02:000419FA 7008            	  5832:     moveq   #8,D0
02:000419FC 19400027        	  5833:     move.b  D0,($0027,A4)
02:00041A00 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:00041A02 102C0054        	  5844:     move.b  ($0054,A4),D0
02:00041A06 0C000004        	  5845:     cmpi.b  #$04,D0
02:00041A0A 6626            	  5846:     bne  _anon_z05_123
02:00041A0C 7400            	  5847:     moveq   #0,D2
02:00041A0E 142C0009        	  5848:     move.b  ($0009,A4),D2
02:00041A12 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:00041A16 102C0055        	  5850:     move.b  ($0055,A4),D0
02:00041A1A 0A00000F        	  5851:     eori.b #$0F,D0
02:00041A1E 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:00041A22 C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00041A24 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:00041A28 7000            	  5859:     moveq   #0,D0
02:00041A2A 19400054        	  5860:     move.b  D0,($0054,A4)
02:00041A2E 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:00041A32 102C0055        	  5870:     move.b  ($0055,A4),D0
02:00041A36 19400002        	  5871:     move.b  D0,($0002,A4)
02:00041A3A 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:00041A3E 0C000007        	  5873:     cmpi.b  #$07,D0
02:00041A42 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:00041A44 7400            	  5879:     moveq   #0,D2
02:00041A46 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00041A4A 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00041A4E 1003            	  5884:     move.b  D3,D0
02:00041A50 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A54 41F900041910    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00041A5A 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00041A5E D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00041A60 7600            	  5889:     moveq   #0,D3
02:00041A62 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:00041A64 1002            	  5893:     move.b  D2,D0
02:00041A66 0A000001        	  5894:     eori.b #$01,D0
02:00041A6A 7400            	  5895:     moveq   #0,D2
02:00041A6C 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00041A6E 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:00041A70 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:00041A74 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041A78 E14C            	  5902:     lsl.w   #8,D4
02:00041A7A 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041A7C 48C4            	  5904:     ext.l   D4
02:00041A7E D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041A84 2044            	  5906:     movea.l D4,A0
02:00041A86 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041A8A 41F900048D9E    	  5908:     lea     (LevelMasks).l,A0
02:00041A90 12302000        	  5909:     move.b  (A0,D2.W),D1
02:00041A94 8001            	  5910:     or.b  D1,D0
02:00041A96 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:00041A98 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00041A9C 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041AA0 E14C            	  5914:     lsl.w   #8,D4
02:00041AA2 8841            	  5915:     or.w    D1,D4
02:00041AA4 48C4            	  5916:     ext.l   D4
02:00041AA6 D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:00041AAC 2044            	  5918:     movea.l D4,A0
02:00041AAE 11803000        	  5919:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:00041AB2 102C0055        	  5924:     move.b  ($0055,A4),D0
02:00041AB6 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:00041ABA 8001            	  5926:     or.b  D1,D0
02:00041ABC 6000FF66        	  5927:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:00041AC0 102C0055        	  5954:     move.b  ($0055,A4),D0
02:00041AC4 19400002        	  5955:     move.b  D0,($0002,A4)
02:00041AC8 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:00041ACC 0C000005        	  5957:     cmpi.b  #$05,D0
02:00041AD0 650C            	  5958:     bcs  _anon_z05_125
02:00041AD2 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:00041AD4 7004            	  5960:     moveq   #4,D0
02:00041AD6 4EB900030490    	  5961:     jsr     PlaySample
02:00041ADC 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:00041ADE 0C000004        	  5969:     cmpi.b  #$04,D0
02:00041AE2 6602            	  5970:     bne  _anon_z05_126
02:00041AE4 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:00041AE6 0C000001        	  5973:     cmpi.b  #$01,D0
02:00041AEA 6602            	  5974:     bne  _anon_z05_127
02:00041AEC 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:00041AEE 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:00041AF2 123C0003        	  5980:     move.b  #$03,D1
02:00041AF6 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041AFA 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:00041AFC 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:00041B00 7600            	  5984:     moveq   #0,D3
02:00041B02 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:00041B04 102C0008        	  5992:     move.b  ($0008,A4),D0
02:00041B08 6708            	  5993:     beq  _anon_z05_128
02:00041B0A 0C030005        	  5994:     cmpi.b  #$05,D3
02:00041B0E 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00041B10 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:00041B12 0C030003        	  5998:     cmpi.b  #$03,D3
02:00041B16 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00041B18 5303            	  6000:     subq.b  #1,D3
                            	  6001:     even
                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:00041B1A 7003            	  6008:     moveq   #3,D0
02:00041B1C 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:00041B20 122C0003        	  6010:     move.b  ($0003,A4),D1
02:00041B24 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041B28 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:00041B2A 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6014:     ; Call this to put the address of door face tiles in [02:03].
                            	  6015:     ;
02:00041B2E 6100FD7A        	  6016:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6017:     ; Return the address of the door in the nametable in [01:00].
                            	  6018:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6019:     ;
02:00041B32 41F900041908    	  6020:     lea     (DoorVramAddrsHi).l,A0
02:00041B38 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00041B3C 1880            	  6022:     move.b  D0,($0000,A4)
02:00041B3E 41F90004190C    	  6023:     lea     (DoorVramAddrsLo).l,A0
02:00041B44 10302000        	  6024:     move.b  (A0,D2.W),D0
02:00041B48 19400001        	  6025:     move.b  D0,($0001,A4)
                            	  6026:     ; Return the direction of the door in [09], and the dynamic
                            	  6027:     ; transfer buf length in X register.
                            	  6028:     ;
02:00041B4C 19420009        	  6029:     move.b  D2,($0009,A4)
02:00041B50 7400            	  6030:     moveq   #0,D2
02:00041B52 142C0301        	  6031:     move.b  ($0301,A4),D2
                            	  6032:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6033:     ;
02:00041B56 7000            	  6034:     moveq   #0,D0
02:00041B58 19400007        	  6035:     move.b  D0,($0007,A4)
02:00041B5C 7002            	  6036:     moveq   #2,D0
02:00041B5E 19400006        	  6037:     move.b  D0,($0006,A4)
02:00041B62 19400005        	  6038:     move.b  D0,($0005,A4)
02:00041B66 0A3C0001        	  6039:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00041B6A 4E75            	  6040:     rts
                            	  6041: 
                            	  6042:     even
                            	  6043: ColumnDirectoryUW:
02:00041B6C 00041348        	  6044:     dc.l    ColumnHeapUW0
02:00041B70 00041358        	  6045:     dc.l    ColumnHeapUW1
02:00041B74 00041376        	  6046:     dc.l    ColumnHeapUW2
02:00041B78 00041388        	  6047:     dc.l    ColumnHeapUW3
02:00041B7C 0004139A        	  6048:     dc.l    ColumnHeapUW4
02:00041B80 000413B2        	  6049:     dc.l    ColumnHeapUW5
