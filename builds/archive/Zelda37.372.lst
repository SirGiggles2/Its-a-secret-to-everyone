02:00033794 19400200        	  2708:     move.b  D0,($0200,A4)
02:00033798 102C0012        	  2709:     move.b  ($0012,A4),D0
02:0003379C 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:000337A0 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
