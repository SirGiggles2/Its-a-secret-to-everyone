                            	  3875: UpdateRockOrGravestone:
02:00039A32 41EC00AC        	  3876:     lea     ($00AC,A4),A0
02:00039A36 10302000        	  3877:     move.b  (A0,D2.W),D0
02:00039A3A 660000AA        	  3878:     bne  _L_z04_UpdateRockOrGravestone_State1
                            	  3879:     ; State 0.
                            	  3880:     ;
                            	  3881:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  3882:     ; bracelet, then return.
                            	  3883:     ;
02:00039A3E 41EC034F        	  3884:     lea     ($034F,A4),A0
02:00039A42 10302000        	  3885:     move.b  (A0,D2.W),D0
02:00039A46 0C000065        	  3886:     cmpi.b  #$65,D0
02:00039A4A 6708            	  3887:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
02:00039A4C 102C0665        	  3888:     move.b  ($0665,A4),D0
02:00039A50 67000092        	  3889:     beq  _L_z04_UpdateRockOrGravestone_Exit
                            	  3890:     even
                            	  3891: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  3892:     ; If there is a mismatch between the current quest and the quest
                            	  3893:     ; needed for the secret in this room, then return.
                            	  3894:     ;
02:00039A54 6100021C        	  3895:     jsr     IsQuestSecretMismatch
02:00039A58 6500008A        	  3896:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  3897:     ; The gravestone and rocks can only be pushed vertically.
                            	  3898:     ; Return, if X's don't match.
                            	  3899:     ;
02:00039A5C 102C0070        	  3900:     move.b  ($0070,A4),D0
02:00039A60 12342070        	  3901:     move.b  ($70,A4,D2.W),D1
02:00039A64 B001            	  3902:     cmp.b   D1,D0
02:00039A66 667C            	  3903:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  3904:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  3905:     ; is positive; then go use it along with a flag that indicates that
                            	  3906:     ; Link is "down" from the object.
                            	  3907:     ;
02:00039A68 7600            	  3908:     moveq   #0,D3
02:00039A6A 102C0084        	  3909:     move.b  ($0084,A4),D0
02:00039A6E 023C00EE        	  3910:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039A72 123C0003        	  3911:     move.b  #$03,D1
02:00039A76 D101            	  3912:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039A78 003C0011        	  3913:     ori     #$11,CCR  ; SEC: set C+X
02:00039A7C 41EC0084        	  3914:     lea     ($0084,A4),A0
02:00039A80 12302000        	  3915:     move.b  (A0,D2.W),D1
02:00039A84 0A3C0010        	  3916:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039A88 9101            	  3917:     subx.b  D1,D0   ; SBC ObjY,X
02:00039A8A 0A3C0010        	  3918:     eori    #$10,CCR  ; restore X = 6502 C
02:00039A8E 6A0E            	  3919:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  3920:     ; Else negate it, and indicate Link is "up" from the object.
                            	  3921:     ;
02:00039A90 5203            	  3922:     addq.b  #1,D3
02:00039A92 4600            	  3923:     eori.b #$FF,D0
02:00039A94 023C00EE        	  3924:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039A98 123C0001        	  3925:     move.b  #$01,D1
02:00039A9C D101            	  3926:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  3927:     even
                            	  3928: _L_z04_UpdateRockOrGravestone_CheckDistance:
                            	  3929:     ; If the distance >= $11, return.
                            	  3930:     ;
02:00039A9E 0C000011        	  3931:     cmpi.b  #$11,D0
02:00039AA2 6440            	  3932:     bcc  _L_z04_UpdateRockOrGravestone_Exit
                            	  3933:     ; If the input direction has no vertical component, then return.
                            	  3934:     ;
02:00039AA4 102C03F8        	  3935:     move.b  ($03F8,A4),D0
02:00039AA8 0200000C        	  3936:     andi.b #$0C,D0
02:00039AAC 6736            	  3937:     beq  _L_z04_UpdateRockOrGravestone_Exit
                            	  3938:     ; If this vertical input direction does not match the one needed
