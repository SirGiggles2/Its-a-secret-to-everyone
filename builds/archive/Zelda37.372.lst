                            	  5167: _anon_z04_79:
                            	  5168:     ; Draw with sprite attributes: normal, red palette row
                            	  5169:     ;
02:0003A3EE 7002            	  5170:     moveq   #2,D0
02:0003A3F0 19400003        	  5171:     move.b  D0,($0003,A4)
