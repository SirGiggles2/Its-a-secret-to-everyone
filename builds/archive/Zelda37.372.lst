                            	  7747:     ; Timer = 0. Only teleporting now.
                            	  7748:     ;
                            	  7749:     ; If there is still distance to go while translucent, then
                            	  7750:     ; decrement the distance remaining, and move.
                            	  7751:     ;
02:0003B69A 41EC0394        	  7752:     lea     ($0394,A4),A0
02:0003B69E 10302000        	  7753:     move.b  (A0,D2.W),D0
02:0003B6A2 670A            	  7754:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003B6A4 41EC0394        	  7755:     lea     ($0394,A4),A0
