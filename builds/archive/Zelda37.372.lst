                            	 11408:     ;
02:0003D1F0 41EC0098        	 11409:     lea     ($0098,A4),A0
02:0003D1F4 10302000        	 11410:     move.b  (A0,D2.W),D0
02:0003D1F8 122C0002        	 11411:     move.b  ($0002,A4),D1
02:0003D1FC E309            	 11412:     lsl.b  #1,D1   ; ASL $02
02:0003D1FE 19410002        	 11413:     move.b  D1,($0002,A4)
02:0003D202 122C0002        	 11414:     move.b  ($0002,A4),D1
02:0003D206 C200            	 11415:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D208 6716            	 11416:     beq  _L_z04_Lamnola_Move_Up
02:0003D20A 41EC0084        	 11417:     lea     ($0084,A4),A0
02:0003D20E 10302000        	 11418:     move.b  (A0,D2.W),D0
02:0003D212 122C04E6        	 11419:     move.b  ($04E6,A4),D1
02:0003D216 D101            	 11420:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003D218 41EC0084        	 11421:     lea     ($0084,A4),A0
02:0003D21C 11802000        	 11422:     move.b  D0,(A0,D2.W)
                            	 11423:     even
