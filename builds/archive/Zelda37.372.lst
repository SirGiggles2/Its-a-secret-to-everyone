02:0003DFEE 19430005        	 13469:     move.b  D3,($0005,A4)
                            	 13470:     ; First, rotate the X coordinate.
                            	 13471:     ;
                            	 13472:     ; Look up the sine for the current angle, and store it in [00].
                            	 13473:     ;
02:0003DFF2 41EC0394        	 13474:     lea     ($0394,A4),A0
02:0003DFF6 10302000        	 13475:     move.b  (A0,D2.W),D0
02:0003DFFA 0200000F        	 13476:     andi.b #$0F,D0
02:0003DFFE 7600            	 13477:     moveq   #0,D3
02:0003E000 1600            	 13478:     move.b  D0,D3
02:0003E002 41F90003DFDA    	 13479:     lea     (PatraSines).l,A0
02:0003E008 10303000        	 13480:     move.b  (A0,D3.W),D0
02:0003E00C 1880            	 13481:     move.b  D0,($0000,A4)
                            	 13482:     ; Mutliply q-speed by [00].
                            	 13483:     ;
                            	 13484:     ; Q-speed has the default value $20 set when entering the room.
                            	 13485:     ;
02:0003E00E 41EC03BC        	 13486:     lea     ($03BC,A4),A0
02:0003E012 10302000        	 13487:     move.b  (A0,D2.W),D0
02:0003E016 7600            	 13488:     moveq   #0,D3
02:0003E018 162C0005        	 13489:     move.b  ($0005,A4),D3
02:0003E01C 61000136        	 13490:     jsr     ShiftMultiply
                            	 13491:     ; The absolute X increment for the current angle is now in [02:03].
                            	 13492:     ;
                            	 13493:     ; If angle >= $10, then the monster is in the top half of circle going left.
                            	 13494:     ;
02:0003E020 41EC0394        	 13495:     lea     ($0394,A4),A0
02:0003E024 10302000        	 13496:     move.b  (A0,D2.W),D0
02:0003E028 02000018        	 13497:     andi.b #$18,D0
02:0003E02C 0C000010        	 13498:     cmpi.b  #$10,D0
02:0003E030 6536            	 13499:     bcs  _L_z04_RotateObjectLocation_AddToX
                            	 13500:     ; Subtract the product's fraction from the X coordinate fraction.
                            	 13501:     ;
