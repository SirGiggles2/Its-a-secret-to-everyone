02:0003BF12 1B00            	  8885:     move.b  D0,-(A5)  ; PHA
02:0003BF14 10342028        	  8886:     move.b  ($28,A4,D2.W),D0
02:0003BF18 1B00            	  8887:     move.b  D0,-(A5)  ; PHA
02:0003BF1A 4EB900030C7E    	  8888:     jsr     CheckMonsterCollisions
02:0003BF20 101D            	  8889:     move.b  (A5)+,D0  ; PLA
02:0003BF22 19802028        	  8890:     move.b  D0,($28,A4,D2.W)
02:0003BF26 101D            	  8891:     move.b  (A5)+,D0  ; PLA
