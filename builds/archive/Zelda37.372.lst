02:00031F3C 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:00031F40 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031F44 E14C            	   559:     lsl.w   #8,D4
02:00031F46 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031F48 48C4            	   561:     ext.l   D4
02:00031F4A D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031F50 2044            	   563:     movea.l D4,A0
02:00031F52 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031F56 41EC0630        	   565:     lea     ($0630,A4),A0
02:00031F5A 11803000        	   566:     move.b  D0,(A0,D3.W)
