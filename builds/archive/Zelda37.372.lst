                            	   700: UpdateBlock0Idle:
                            	   701:     ; If there are monsters in the room, go reset the push timer and return.
                            	   702:     ;
02:00038460 102C034D        	   703:     move.b  ($034D,A4),D0
02:00038464 6604            	   704:     bne.s  __far_z_04_0005
02:00038466 600000D6        	   705:     jmp  ResetPushTimer
                            	   706: __far_z_04_0005:
                            	   707:     ; If Link's X is aligned with the block's, then get the difference
                            	   708:     ; between Link's (Y + 3) and the block's Y.
                            	   709:     ; Then go test the difference.
                            	   710:     ;
02:0003846A 102C0070        	   711:     move.b  ($0070,A4),D0
02:0003846E 12342070        	   712:     move.b  ($70,A4,D2.W),D1
02:00038472 B001            	   713:     cmp.b   D1,D0
02:00038474 6628            	   714:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00038476 7600            	   715:     moveq   #0,D3
02:00038478 102C0084        	   716:     move.b  ($0084,A4),D0
02:0003847C 023C00EE        	   717:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038480 123C0003        	   718:     move.b  #$03,D1
02:00038484 D101            	   719:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038486 003C0011        	   720:     ori     #$11,CCR  ; SEC: set C+X
02:0003848A 41EC0084        	   721:     lea     ($0084,A4),A0
02:0003848E 12302000        	   722:     move.b  (A0,D2.W),D1
02:00038492 0A3C0010        	   723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038496 9101            	   724:     subx.b  D1,D0   ; SBC ObjY,X
02:00038498 0A3C0010        	   725:     eori    #$10,CCR  ; restore X = 6502 C
02:0003849C 6036            	   726:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   727: 
                            	   728:     even
                            	   729: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   730:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   731:     ; go reset the push timer.
                            	   732:     ;
02:0003849E 102C0084        	   733:     move.b  ($0084,A4),D0
02:000384A2 023C00EE        	   734:     andi    #$EE,CCR  ; CLC: clear C+X
02:000384A6 123C0003        	   735:     move.b  #$03,D1
02:000384AA D101            	   736:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000384AC 41EC0084        	   737:     lea     ($0084,A4),A0
02:000384B0 12302000        	   738:     move.b  (A0,D2.W),D1
02:000384B4 B001            	   739:     cmp.b   D1,D0
02:000384B6 6704            	   740:     beq.s  __far_z_04_0006
02:000384B8 60000084        	   741:     jmp  ResetPushTimer
                            	   742: __far_z_04_0006:
                            	   743:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   744:     ; Get the difference in X.
                            	   745:     ;
02:000384BC 7602            	   746:     moveq   #2,D3
02:000384BE 102C0070        	   747:     move.b  ($0070,A4),D0
02:000384C2 003C0011        	   748:     ori     #$11,CCR  ; SEC: set C+X
02:000384C6 12342070        	   749:     move.b  ($70,A4,D2.W),D1
02:000384CA 0A3C0010        	   750:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000384CE 9101            	   751:     subx.b  D1,D0   ; SBC ObjX,X
02:000384D0 0A3C0010        	   752:     eori    #$10,CCR  ; restore X = 6502 C
                            	   753:     even
                            	   754: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   755:     ; If the difference in coordinates is negative, then Link is
                            	   756:     ; up or left of the block.
                            	   757:     ;
                            	   758:     ; In that case, increase Y register to index the correct opposite
                            	   759:     ; direction below. Also, negate the difference, so we test
                            	   760:     ; positive values.
                            	   761:     ;
02:000384D4 6A06            	   762:     bpl  _anon_z04_14
02:000384D6 5203            	   763:     addq.b  #1,D3
02:000384D8 61008070        	   764:     jsr     Negate
                            	   765: _anon_z04_14:
                            	   766:     ; If the distance >= $11, then go reset the push timer and return.
                            	   767:     ;
02:000384DC 0C000011        	   768:     cmpi.b  #$11,D0
02:000384E0 6502            	   769:     bcs.s  __far_z_04_0007
02:000384E2 605A            	   770:     jmp  ResetPushTimer
                            	   771: __far_z_04_0007:
                            	   772:     ; At this point, Link is aligned with the block.
                            	   773:     ;
                            	   774:     ; If the input direction is not the required direction based on
                            	   775:     ; Link's placement; then go reset the push timer and return.
                            	   776:     ;
02:000384E4 102C03F8        	   777:     move.b  ($03F8,A4),D0
02:000384E8 41F90003843E    	   778:     lea     (BlockPushDirections).l,A0
02:000384EE 12303000        	   779:     move.b  (A0,D3.W),D1
02:000384F2 B001            	   780:     cmp.b   D1,D0
02:000384F4 6702            	   781:     beq.s  __far_z_04_0008
02:000384F6 6046            	   782:     jmp  ResetPushTimer
                            	   783: __far_z_04_0008:
                            	   784:     ; Link is truly pushing the block.
                            	   785:     ;
                            	   786:     ; Increase the push timer.
                            	   787:     ;
02:000384F8 41EC0412        	   788:     lea     ($0412,A4),A0
02:000384FC 52302000        	   789:     addq.b  #1,(A0,D2.W)
                            	   790:     ; If the push timer still < $10, return.
                            	   791:     ;
02:00038500 7600            	   792:     moveq   #0,D3
02:00038502 41EC0412        	   793:     lea     ($0412,A4),A0
02:00038506 16302000        	   794:     move.b  (A0,D2.W),D3
02:0003850A 0C030010        	   795:     cmpi.b  #$10,D3
02:0003850E 6402            	   796:     bcc.s  __far_z_04_0009
02:00038510 6032            	   797:     jmp  L10262_Exit
