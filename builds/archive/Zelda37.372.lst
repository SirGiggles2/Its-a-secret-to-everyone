02:0003FEAC 60E4            	  3442:     jmp  GoToModeAFromCave
                            	  3443: __far_z_05_0063:
02:0003FEAE 4E75            	  3444:     rts
                            	  3445: 
                            	  3446: ; Params:
                            	  3447: ; [0F]: movement direction
                            	  3448: ;
                            	  3449: ; Returns:
                            	  3450: ; [0F]: movement direction or 0
                            	  3451: ;
                            	  3452: ;
                            	  3453: ; If the ladder's not in use, return.
                            	  3454: ;
                            	  3455:     even
                            	  3456: CheckLadder:
02:0003FEB0 7400            	  3457:     moveq   #0,D2
02:0003FEB2 142C0064        	  3458:     move.b  ($0064,A4),D2
02:0003FEB6 670000BE        	  3459:     beq  _L_z05_CheckLadder_Exit
                            	  3460:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3461:     ;
02:0003FEBA 41EC00AC        	  3462:     lea     ($00AC,A4),A0
02:0003FEBE 10302000        	  3463:     move.b  (A0,D2.W),D0
02:0003FEC2 670000A6        	  3464:     beq  _L_z05_CheckLadder_StashLadder
                            	  3465:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3466:     ; between the ladder and Link.
                            	  3467:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3468:     ;
02:0003FEC6 41EC0098        	  3469:     lea     ($0098,A4),A0
02:0003FECA 10302000        	  3470:     move.b  (A0,D2.W),D0
02:0003FECE 0200000C        	  3471:     andi.b #$0C,D0
02:0003FED2 6734            	  3472:     beq  _anon_z05_85
02:0003FED4 102C0070        	  3473:     move.b  ($0070,A4),D0
02:0003FED8 12342070        	  3474:     move.b  ($70,A4,D2.W),D1
02:0003FEDC B001            	  3475:     cmp.b   D1,D0
02:0003FEDE 6600008A        	  3476:     bne  _L_z05_CheckLadder_StashLadder
02:0003FEE2 102C0084        	  3477:     move.b  ($0084,A4),D0
02:0003FEE6 023C00EE        	  3478:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FEEA 123C0003        	  3479:     move.b  #$03,D1
02:0003FEEE D101            	  3480:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003FEF0 003C0011        	  3481:     ori     #$11,CCR  ; SEC: set C+X
02:0003FEF4 41EC0084        	  3482:     lea     ($0084,A4),A0
02:0003FEF8 12302000        	  3483:     move.b  (A0,D2.W),D1
02:0003FEFC 0A3C0010        	  3484:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF00 9101            	  3485:     subx.b  D1,D0   ; SBC ObjY,X
02:0003FF02 0A3C0010        	  3486:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FF06 6030            	  3487:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3488: 
                            	  3489: _anon_z05_85:
                            	  3490:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3491:     ; between the ladder and Link.
                            	  3492:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3493:     ;
02:0003FF08 102C0084        	  3494:     move.b  ($0084,A4),D0
02:0003FF0C 023C00EE        	  3495:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FF10 123C0003        	  3496:     move.b  #$03,D1
02:0003FF14 D101            	  3497:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003FF16 41EC0084        	  3498:     lea     ($0084,A4),A0
02:0003FF1A 12302000        	  3499:     move.b  (A0,D2.W),D1
02:0003FF1E B001            	  3500:     cmp.b   D1,D0
02:0003FF20 6648            	  3501:     bne  _L_z05_CheckLadder_StashLadder
02:0003FF22 102C0070        	  3502:     move.b  ($0070,A4),D0
02:0003FF26 003C0011        	  3503:     ori     #$11,CCR  ; SEC: set C+X
02:0003FF2A 12342070        	  3504:     move.b  ($70,A4,D2.W),D1
02:0003FF2E 0A3C0010        	  3505:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF32 9101            	  3506:     subx.b  D1,D0   ; SBC ObjX,X
02:0003FF34 0A3C0010        	  3507:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3508:     even
                            	  3509: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3510:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3511:     ; If > $10, go put the ladder away.
                            	  3512:     ;
02:0003FF38 4EB900030546    	  3513:     jsr     Abs
02:0003FF3E 1880            	  3514:     move.b  D0,($0000,A4)
02:0003FF40 0C000010        	  3515:     cmpi.b  #$10,D0
02:0003FF44 6532            	  3516:     bcs  _L_z05_CheckLadder_SetState2
02:0003FF46 0C000010        	  3517:     cmpi.b  #$10,D0
02:0003FF4A 661E            	  3518:     bne  _L_z05_CheckLadder_StashLadder
                            	  3519:     ; Distance = $10. If player's not facing in the same direction as
                            	  3520:     ; the ladder, go put away the ladder.
                            	  3521:     ;
02:0003FF4C 102C0098        	  3522:     move.b  ($0098,A4),D0
02:0003FF50 41EC0098        	  3523:     lea     ($0098,A4),A0
02:0003FF54 12302000        	  3524:     move.b  (A0,D2.W),D1
02:0003FF58 B001            	  3525:     cmp.b   D1,D0
02:0003FF5A 660E            	  3526:     bne  _L_z05_CheckLadder_StashLadder
                            	  3527:     ; Distance = $10, and player's facing in the same direction.
                            	  3528:     ;
                            	  3529:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3530:     ; ladder and had not stepped onto it yet.
                            	  3531:     ; Go handle movement on it, but don't change state yet.
                            	  3532:     ;
                            	  3533:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3534:     ; off of the ladder. So the ladder should be put away. In this
                            	  3535:     ; case, fall thru.
                            	  3536:     ;
02:0003FF5C 41EC00AC        	  3537:     lea     ($00AC,A4),A0
02:0003FF60 10302000        	  3538:     move.b  (A0,D2.W),D0
02:0003FF64 0C000001        	  3539:     cmpi.b  #$01,D0
02:0003FF68 6718            	  3540:     beq  _L_z05_CheckLadder_HandleInput
                            	  3541:     even
                            	  3542: _L_z05_CheckLadder_StashLadder:
                            	  3543:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3544:     ;
02:0003FF6A 7000            	  3545:     moveq   #0,D0
02:0003FF6C 19400064        	  3546:     move.b  D0,($0064,A4)
02:0003FF70 4EB90004B7D6    	  3547:     jsr     DestroyMonster
                            	  3548:     even
                            	  3549: _L_z05_CheckLadder_Exit:
02:0003FF76 4E75            	  3550:     rts
                            	  3551: 
                            	  3552:     even
                            	  3553: _L_z05_CheckLadder_SetState2:
                            	  3554:     ;  Set state 2, because we're on the ladder.
                            	  3555:     ;
02:0003FF78 7002            	  3556:     moveq   #2,D0
02:0003FF7A 41EC00AC        	  3557:     lea     ($00AC,A4),A0
02:0003FF7E 11802000        	  3558:     move.b  D0,(A0,D2.W)
                            	  3559:     even
                            	  3560: _L_z05_CheckLadder_HandleInput:
                            	  3561:     ; If input direction = 0, go draw and reset moving direction.
                            	  3562:     ;
02:0003FF82 102C03F8        	  3563:     move.b  ($03F8,A4),D0
02:0003FF86 67000086        	  3564:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3565:     ; Input direction <> 0. The player intends to move.
                            	  3566:     ; So, see if we need to override the moving direction.
                            	  3567:     ;
                            	  3568:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3569:     ; go draw and set moving direction to Link's direction.
                            	  3570:     ;
                            	  3571:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3572:     ; been blocked by the water.
                            	  3573:     ;
                            	  3574:     ; Or, Link already passed over the point right over the ladder
                            	  3575:     ; and was allowed to move onto the tiles after the ladder.
                            	  3576:     ;
02:0003FF8A 102C0098        	  3577:     move.b  ($0098,A4),D0
02:0003FF8E 7600            	  3578:     moveq   #0,D3
02:0003FF90 1614            	  3579:     move.b  ($0000,A4),D3
02:0003FF92 670C            	  3580:     beq  _anon_z05_86
02:0003FF94 41EC0098        	  3581:     lea     ($0098,A4),A0
02:0003FF98 12302000        	  3582:     move.b  (A0,D2.W),D1
02:0003FF9C B001            	  3583:     cmp.b   D1,D0
02:0003FF9E 676E            	  3584:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3585: _anon_z05_86:
                            	  3586:     ; Distance = 0, or facing different directions.
                            	  3587:     ;
                            	  3588:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3589:     ; then go draw and keep moving.
                            	  3590:     ;
                            	  3591:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3592:     ;
                            	  3593:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3594:     ; to move onto the tiles after the ladder.
                            	  3595:     ;
                            	  3596:     ; Note that if Link is not moving, then this test will fail,
                            	  3597:     ; and case (D) will catch it.
                            	  3598:     ;
02:0003FFA0 41EC0098        	  3599:     lea     ($0098,A4),A0
02:0003FFA4 10302000        	  3600:     move.b  (A0,D2.W),D0
02:0003FFA8 122C000F        	  3601:     move.b  ($000F,A4),D1
02:0003FFAC B001            	  3602:     cmp.b   D1,D0
02:0003FFAE 675E            	  3603:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3604:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3605:     ; then go draw and move in ladder's direction.
                            	  3606:     ;
                            	  3607:     ; You can always step off the ladder where you came from.
                            	  3608:     ;
02:0003FFB0 4EB900030542    	  3609:     jsr     GetOppositeDir
02:0003FFB6 122C0098        	  3610:     move.b  ($0098,A4),D1
02:0003FFBA B001            	  3611:     cmp.b   D1,D0
02:0003FFBC 6750            	  3612:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3613:     ; D. If opposite of ladder's direction <> down,
                            	  3614:     ; or input direction <> up,
                            	  3615:     ; then go reset moving direction, and draw.
                            	  3616:     ;
                            	  3617:     ; This will catch all cases of Link facing perpendicular to
                            	  3618:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3619:     ; ladder direction is up and input direction is up (E).
                            	  3620:     ;
02:0003FFBE 0C000004        	  3621:     cmpi.b  #$04,D0
02:0003FFC2 6648            	  3622:     bne  _anon_z05_87
02:0003FFC4 102C03F8        	  3623:     move.b  ($03F8,A4),D0
02:0003FFC8 0C000008        	  3624:     cmpi.b  #$08,D0
02:0003FFCC 663E            	  3625:     bne  _anon_z05_87
                            	  3626:     ; E. The ladder's direction is up and input direction is up.
                            	  3627:     ;
                            	  3628:     ; An earlier call to check tile collision would have blocked
                            	  3629:     ; movement, because the tile under Link's top half is a water tile.
                            	  3630:     ; But because Link is squarely on the ladder, we really have
                            	  3631:     ; to check the tile above that one.
                            	  3632:     ;
                            	  3633:     ; Set moving direction to input direction (up) and switch X to
                            	  3634:     ; the player's slot for the purpose of checking tile collision below.
                            	  3635:     ; Based on that, we'll set moving direction according to walkability.
                            	  3636:     ;
02:0003FFCE 6158            	  3637:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3638:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3639:     ;
02:0003FFD0 102C0084        	  3640:     move.b  ($0084,A4),D0
02:0003FFD4 1B00            	  3641:     move.b  D0,-(A5)  ; PHA
02:0003FFD6 003C0011        	  3642:     ori     #$11,CCR  ; SEC: set C+X
02:0003FFDA 123C0008        	  3643:     move.b  #$08,D1
02:0003FFDE 0A3C0010        	  3644:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FFE2 9101            	  3645:     subx.b  D1,D0   ; SBC #$08
02:0003FFE4 0A3C0010        	  3646:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FFE8 19400084        	  3647:     move.b  D0,($0084,A4)
02:0003FFEC 4EB900049940    	  3648:     jsr     GetCollidingTileMoving
02:0003FFF2 101D            	  3649:     move.b  (A5)+,D0  ; PLA
02:0003FFF4 19400084        	  3650:     move.b  D0,($0084,A4)
                            	  3651:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3652:     ; direction as the input direction (in a roundabout way).
                            	  3653:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3654:     ;
02:0003FFF8 102C000F        	  3655:     move.b  ($000F,A4),D0
02:0003FFFC 7600            	  3656:     moveq   #0,D3
02:0003FFFE 162C049E        	  3657:     move.b  ($049E,A4),D3
02:00040002 122C034A        	  3658:     move.b  ($034A,A4),D1
02:00040006 B601            	  3659:     cmp.b   D1,D3
02:00040008 6500FF78        	  3660:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3661: _anon_z05_87:
                            	  3662:     ; Set A to reset moving direction in [0F].
                            	  3663:     ;
02:0004000C 7000            	  3664:     moveq   #0,D0
                            	  3665:     even
                            	  3666: _L_z05_CheckLadder_DrawLadder:
                            	  3667:     ; Draw the ladder.
                            	  3668:     ;
02:0004000E 1B00            	  3669:     move.b  D0,-(A5)  ; PHA
02:00040010 7400            	  3670:     moveq   #0,D2
02:00040012 142C0064        	  3671:     move.b  ($0064,A4),D2
02:00040016 4EB90004AFFA    	  3672:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0004001C 760C            	  3673:     moveq   #12,D3
02:0004001E 7000            	  3674:     moveq   #0,D0
02:00040020 4EB900030B16    	  3675:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00040026 101D            	  3676:     move.b  (A5)+,D0  ; PLA
                            	  3677: ; Params:
                            	  3678: ; A: direction
                            	  3679: ;
                            	  3680: ; Returns:
                            	  3681: ; [0F]: direction
                            	  3682: ;
                            	  3683:     even
