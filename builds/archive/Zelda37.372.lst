02:000391DA 10302000        	  2655:     move.b  (A0,D2.W),D0
02:000391DE 123C0000        	  2656:     move.b  #$00,D1
02:000391E2 D101            	  2657:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
