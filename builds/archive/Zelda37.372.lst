02:0003AD68 123C0001        	  6475:     move.b  #$01,D1
02:0003AD6C D101            	  6476:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003AD6E 41EC0437        	  6477:     lea     ($0437,A4),A0
02:0003AD72 11802000        	  6478:     move.b  D0,(A0,D2.W)
