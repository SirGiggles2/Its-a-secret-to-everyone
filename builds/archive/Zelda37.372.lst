                            	  7705: ; Description:
                            	  7706: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  7707: ; When walking, the object timer is set. When teleporting,
                            	  7708: ; the teleporting distance remaining is set.
                            	  7709: ;
                            	  7710: ; If we have the magic clock, then only go draw and check collisions.
                            	  7711: ;
                            	  7712:     even
                            	  7713: UpdateBlueWizzrobe:
02:0003B674 102C066C        	  7714:     move.b  ($066C,A4),D0
02:0003B678 6702            	  7715:     beq.s  __far_z_04_0068
02:0003B67A 6014            	  7716:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  7717: __far_z_04_0068:
02:0003B67C 6116            	  7718:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003B67E 61000318        	  7719:     jsr     BlueWizzrobe_TryShooting
                            	  7720:     even
                            	  7721: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  7722:     ; If the teleporting distance remaining is even, then draw
                            	  7723:     ; and check collisions, else return.
                            	  7724:     ;
                            	  7725:     ; This means that when 0, the monster is walking.
                            	  7726:     ; So, draw and check collisions every frame.
                            	  7727:     ;
                            	  7728:     ; When not 0, the monster is teleporting, and must be drawn
                            	  7729:     ; translucently -- every other frame.
                            	  7730:     ;
02:0003B682 41EC0394        	  7731:     lea     ($0394,A4),A0
02:0003B686 10302000        	  7732:     move.b  (A0,D2.W),D0
02:0003B68A E208            	  7733:     lsr.b  #1,D0   ; LSR A
02:0003B68C 6402            	  7734:     bcc.s  __far_z_04_0069
02:0003B68E 603A            	  7735:     jmp  L11E17_Exit
                            	  7736: __far_z_04_0069:
                            	  7737:     even
                            	  7738: L_Wizzrobe_DrawAndCheckCollisions:
02:0003B690 600004DE        	  7739:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  7740: 
                            	  7741:     even
