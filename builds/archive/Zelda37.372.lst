                            	  7791: Submenu_CueTransferRowUW:
                            	  7792:     ; If menu scroll value is negative, then we transferred everything.
                            	  7793:     ; So, return.
                            	  7794:     ;
02:00042DD0 102C005E        	  7795:     move.b  ($005E,A4),D0
02:00042DD4 6A02            	  7796:     bpl.s  __far_z_05_0084
02:00042DD6 6030            	  7797:     jmp  L1725A_Exit
                            	  7798: __far_z_05_0084:
                            	  7799:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7800:     ; and represents the current row of the submenu being processed.
                            	  7801:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7802:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7803:     ;
                            	  7804:     ; If the bottom bit is set, go prepare the full black row.
                            	  7805:     ;
02:00042DD8 E208            	  7806:     lsr.b  #1,D0   ; LSR A
02:00042DDA 7600            	  7807:     moveq   #0,D3
02:00042DDC 1600            	  7808:     move.b  D0,D3
02:00042DDE 6402            	  7809:     bcc.s  __far_z_05_0085
02:00042DE0 6028            	  7810:     jmp  PrepFullBlackRow
                            	  7811: __far_z_05_0085:
                            	  7812:     ; Submenu rows $D to $15 are parts of the map.
                            	  7813:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7814:     ;
                            	  7815:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7816:     ; buffer for this row.
                            	  7817:     ;
02:00042DE2 0C00000D        	  7818:     cmpi.b  #$0D,D0
02:00042DE6 640C            	  7819:     bcc  _anon_z05_167
02:00042DE8 41F900042DAC    	  7820:     lea     (SubmenuTransferBufSelectorsUW).l,A0
