                            	 11458: UpdatePatra:
02:0003D25C 61000080        	 11459:     jsr     ControlPatraFlight
                            	 11460:     ; Reset flying distance traveled, so that we know what offset to
                            	 11461:     ; apply to the children.
                            	 11462:     ;
02:0003D260 7000            	 11463:     moveq   #0,D0
