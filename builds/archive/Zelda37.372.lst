                            	  8053: _anon_z05_174:
                            	  8054:     ; Two input directions, and at least one of them is walkable.
                            	  8055:     ;
                            	  8056:     ; Make Link go straight in one direction on the next grid line.
                            	  8057:     ;
02:00042F34 7600            	  8058:     moveq   #0,D3
02:00042F36 1600            	  8059:     move.b  D0,D3
02:00042F38 522C0057        	  8060:     addq.b  #1,($0057,A4)
                            	  8061:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8062:     ; object direction and input direction to last walkable direction
                            	  8063:     ; found, and set Link's speed.
                            	  8064:     ;
                            	  8065:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8066:     ;
02:00042F3C 7400            	  8067:     moveq   #0,D2
02:00042F3E 102C000D        	  8068:     move.b  ($000D,A4),D0
02:00042F42 0C030001        	  8069:     cmpi.b  #$01,D3
02:00042F46 67000096        	  8070:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00042F4A 7600            	  8071:     moveq   #0,D3
02:00042F4C 162C0010        	  8072:     move.b  ($0010,A4),D3
02:00042F50 6700008C        	  8073:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8074:     ; In UW. There are two input directions, and they're both walkable.
                            	  8075:     ;
                            	  8076:     ; Normally, turn to the direction that's perpendicular to object
                            	  8077:     ; direction. But keep going straight after that, while diagonal
                            	  8078:     ; input is held.
                            	  8079:     ;
                            	  8080:     ; Handle special cases for doors.
                            	  8081:     ;
                            	  8082:     ;
                            	  8083:     ; 1. Link at horizontal doors.
                            	  8084:     ;
                            	  8085:     ; If Link's X = $20 or $D0 then
                            	  8086:     ;   If Link's Y = $85 and facing down then
                            	  8087:     ;     Go set object direction and input direction to object
                            	  8088:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8089:     ;     Link_GoStraightWhenDiagInput.
                            	  8090:     ;   Else
                            	  8091:     ;     Go turn to the perpendicular direction
                            	  8092:     ;
02:00042F54 7600            	  8093:     moveq   #0,D3
02:00042F56 162C0070        	  8094:     move.b  ($0070,A4),D3
02:00042F5A 0C030020        	  8095:     cmpi.b  #$20,D3
02:00042F5E 6706            	  8096:     beq  _anon_z05_175
02:00042F60 0C0300D0        	  8097:     cmpi.b  #$D0,D3
02:00042F64 661C            	  8098:     bne  _anon_z05_176
