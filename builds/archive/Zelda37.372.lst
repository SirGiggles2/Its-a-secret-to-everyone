                            	  5624:     ; Move the boomerang.
                            	  5625:     ;
02:0004A722 6100F570        	  5626:     jsr     MoveObject
                            	  5627:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5628:     ; state to $40.
                            	  5629:     ;
02:0004A726 41EC0380        	  5630:     lea     ($0380,A4),A0
02:0004A72A 53302000        	  5631:     subq.b  #1,(A0,D2.W)
02:0004A72E 6614            	  5632:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5633:     even
                            	  5634: _L_z07_CheckState30_SetState40:
                            	  5635:     ; Set state $40, and a time to move of $20 frames.
                            	  5636:     ;
                            	  5637:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5638:     ;
                            	  5639:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5640:     ;
02:0004A730 7020            	  5641:     moveq   #32,D0
02:0004A732 41EC0380        	  5642:     lea     ($0380,A4),A0
02:0004A736 11802000        	  5643:     move.b  D0,(A0,D2.W)
02:0004A73A 7040            	  5644:     moveq   #64,D0
02:0004A73C 41EC00AC        	  5645:     lea     ($00AC,A4),A0
02:0004A740 11802000        	  5646:     move.b  D0,(A0,D2.W)
                            	  5647:     even
