                            	  1668: UpdateStatues:
                            	  1669:     ; If person fireballs are enabled (from the two fires), then
                            	  1670:     ; go make fireballs with pattern 2.
                            	  1671:     ;
02:00038B42 7602            	  1672:     moveq   #2,D3
02:00038B44 102C04CC        	  1673:     move.b  ($04CC,A4),D0
02:00038B48 6620            	  1674:     bne  _L_z04_UpdateStatues_Shoot
                            	  1675:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1676:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1677:     ; - layout $23: pattern 1: 2 statues
                            	  1678:     ; - layout $24: pattern 0: 4 statues
                            	  1679:     ;
02:00038B4A 4EB900049068    	  1680:     jsr     GetUniqueRoomId
02:00038B50 7601            	  1681:     moveq   #1,D3
                            	  1682: _anon_z04_30:
02:00038B52 41F900038B24    	  1683:     lea     (StatueRoomLayouts).l,A0
02:00038B58 12303000        	  1684:     move.b  (A0,D3.W),D1
02:00038B5C B001            	  1685:     cmp.b   D1,D0
02:00038B5E 670A            	  1686:     beq  _L_z04_UpdateStatues_Shoot
02:00038B60 5303            	  1687:     subq.b  #1,D3
02:00038B62 6AEE            	  1688:     bpl  _anon_z04_30
02:00038B64 0A3C0001        	  1689:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00038B68 4E75            	  1690:     rts
