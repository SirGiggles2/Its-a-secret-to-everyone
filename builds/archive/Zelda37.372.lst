                            	  7767: _L_z04_BlueWizzrobe_WalkOrTeleport_Walk:
                            	  7768:     ; Timer:
                            	  7769:     ;   >= $10: Turn if needed and move every other frame
                            	  7770:     ;   > 1:    Do nothing
                            	  7771:     ;   = 1:    Choose a place to teleport to.
                            	  7772:     ;
                            	  7773:     ; Notice that walking is slower than teleporting; and there is
                            	  7774:     ; a pause of $10 frames at the end.
                            	  7775:     ;
