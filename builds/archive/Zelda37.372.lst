                            	  1073: _L_z02_AnimateDemoPhase1Subphase2_CopyLine:
                            	  1074:     ; X (D2) = offset into destination line.
                            	  1075:     ; Y (D3) = offset into source tiles of current text record.
                            	  1076:     ; A0 = pointer to current text field (preserved across loop).
02:000326D0 5203            	  1077:     addq.b  #1,D3
02:000326D2 10303000        	  1078:     move.b  (A0,D3.W),D0        ; read next tile from ROM
