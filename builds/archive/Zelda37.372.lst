                            	  5838: Digdogger_Move:
                            	  5839:     ; This calculation is the same one used in Manhandla to
                            	  5840:     ; manifest the fractional speed over several frames.
                            	  5841:     ;
                            	  5842:     ; To summarize, the formula is:
                            	  5843:     ;
                            	  5844:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  5845:     ;
                            	  5846:     ;   SA := SA + (SL AND $E0)
                            	  5847:     ;   [03] := SH + carry
                            	  5848:     ;
                            	  5849:     ; See 04:A28E Manhandla_Move.
                            	  5850:     ;
02:0003A88E 41EC041F        	  5851:     lea     ($041F,A4),A0
02:0003A892 10302000        	  5852:     move.b  (A0,D2.W),D0
02:0003A896 020000E0        	  5853:     andi.b #$E0,D0
02:0003A89A 023C00EE        	  5854:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A89E 41EC0412        	  5855:     lea     ($0412,A4),A0
02:0003A8A2 12302000        	  5856:     move.b  (A0,D2.W),D1
02:0003A8A6 D101            	  5857:     addx.b  D1,D0   ; ADC $0412,X
02:0003A8A8 41EC0412        	  5858:     lea     ($0412,A4),A0
02:0003A8AC 11802000        	  5859:     move.b  D0,(A0,D2.W)
                            	  5860:     ; Assign (high speed byte + carry) to [03].
                            	  5861:     ;
02:0003A8B0 41EC042C        	  5862:     lea     ($042C,A4),A0
02:0003A8B4 10302000        	  5863:     move.b  (A0,D2.W),D0
02:0003A8B8 123C0000        	  5864:     move.b  #$00,D1
02:0003A8BC D101            	  5865:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A8BE 19400003        	  5866:     move.b  D0,($0003,A4)
                            	  5867:     ; Change coordinates by the speed amount/offset in [03]
                            	  5868:     ; according to the direction.
                            	  5869:     ;
                            	  5870:     ; Start with a mask of $A1 in [02]:
                            	  5871:     ; - low nibble represents the right direction
                            	  5872:     ; - high nibble is used to set or clear carry as we go along
                            	  5873:     ;
02:0003A8C2 103C00A1        	  5874:     move.b  #$A1,D0
02:0003A8C6 19400002        	  5875:     move.b  D0,($0002,A4)
                            	  5876:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  5877:     ;
02:0003A8CA 41EC0098        	  5878:     lea     ($0098,A4),A0
02:0003A8CE 10302000        	  5879:     move.b  (A0,D2.W),D0
02:0003A8D2 122C0002        	  5880:     move.b  ($0002,A4),D1
02:0003A8D6 C200            	  5881:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A8D8 6712            	  5882:     beq  _L_z04_Digdogger_Move_Left
02:0003A8DA 10342070        	  5883:     move.b  ($70,A4,D2.W),D0
02:0003A8DE 023C00EE        	  5884:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8E2 122C0003        	  5885:     move.b  ($0003,A4),D1
02:0003A8E6 D101            	  5886:     addx.b  D1,D0   ; ADC $03
02:0003A8E8 19802070        	  5887:     move.b  D0,($70,A4,D2.W)
                            	  5888:     even
                            	  5889: _L_z04_Digdogger_Move_Left:
                            	  5890:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  5891:     ;
02:0003A8EC 41EC0098        	  5892:     lea     ($0098,A4),A0
02:0003A8F0 10302000        	  5893:     move.b  (A0,D2.W),D0
02:0003A8F4 122C0002        	  5894:     move.b  ($0002,A4),D1
02:0003A8F8 E309            	  5895:     lsl.b  #1,D1   ; ASL $02
02:0003A8FA 19410002        	  5896:     move.b  D1,($0002,A4)
02:0003A8FE 122C0002        	  5897:     move.b  ($0002,A4),D1
02:0003A902 C200            	  5898:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A904 6716            	  5899:     beq  _L_z04_Digdogger_Move_Down
02:0003A906 10342070        	  5900:     move.b  ($70,A4,D2.W),D0
02:0003A90A 122C0003        	  5901:     move.b  ($0003,A4),D1
02:0003A90E 0A3C0010        	  5902:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A912 9101            	  5903:     subx.b  D1,D0   ; SBC $03
02:0003A914 0A3C0010        	  5904:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A918 19802070        	  5905:     move.b  D0,($70,A4,D2.W)
                            	  5906:     even
                            	  5907: _L_z04_Digdogger_Move_Down:
                            	  5908:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  5909:     ;
02:0003A91C 41EC0098        	  5910:     lea     ($0098,A4),A0
02:0003A920 10302000        	  5911:     move.b  (A0,D2.W),D0
02:0003A924 122C0002        	  5912:     move.b  ($0002,A4),D1
02:0003A928 E309            	  5913:     lsl.b  #1,D1   ; ASL $02
02:0003A92A 19410002        	  5914:     move.b  D1,($0002,A4)
02:0003A92E 122C0002        	  5915:     move.b  ($0002,A4),D1
02:0003A932 C200            	  5916:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A934 6716            	  5917:     beq  _L_z04_Digdogger_Move_Up
02:0003A936 41EC0084        	  5918:     lea     ($0084,A4),A0
02:0003A93A 10302000        	  5919:     move.b  (A0,D2.W),D0
02:0003A93E 122C0003        	  5920:     move.b  ($0003,A4),D1
02:0003A942 D101            	  5921:     addx.b  D1,D0   ; ADC $03
02:0003A944 41EC0084        	  5922:     lea     ($0084,A4),A0
02:0003A948 11802000        	  5923:     move.b  D0,(A0,D2.W)
                            	  5924:     even
                            	  5925: _L_z04_Digdogger_Move_Up:
                            	  5926:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  5927:     ;
02:0003A94C 41EC0098        	  5928:     lea     ($0098,A4),A0
02:0003A950 10302000        	  5929:     move.b  (A0,D2.W),D0
02:0003A954 122C0002        	  5930:     move.b  ($0002,A4),D1
02:0003A958 E309            	  5931:     lsl.b  #1,D1   ; ASL $02
02:0003A95A 19410002        	  5932:     move.b  D1,($0002,A4)
02:0003A95E 122C0002        	  5933:     move.b  ($0002,A4),D1
02:0003A962 C200            	  5934:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A964 671E            	  5935:     beq  _L_z04_Digdogger_Move_End
02:0003A966 41EC0084        	  5936:     lea     ($0084,A4),A0
02:0003A96A 10302000        	  5937:     move.b  (A0,D2.W),D0
02:0003A96E 122C0003        	  5938:     move.b  ($0003,A4),D1
