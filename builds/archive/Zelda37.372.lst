02:000393CA 11802000        	  2910:     move.b  D0,(A0,D2.W)
                            	  2911:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  2912:     ;
02:000393CE 10342019        	  2913:     move.b  ($19,A4,D2.W),D0
02:000393D2 0C0000C0        	  2914:     cmpi.b  #$C0,D0
