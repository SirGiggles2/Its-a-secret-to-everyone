                            	  3858:     even
                            	  3859: _L_z04_PondFairy_MoveHearts_NextLoopHeart:
                            	  3860:     ; Bottom of the loop.
                            	  3861:     ; Increase the object slot.
                            	  3862:     ;
02:00039A20 5202            	  3863:     addq.b  #1,D2
02:00039A22 0C02000A        	  3864:     cmpi.b  #$0A,D2
02:00039A26 6600FF32        	  3865:     bne  _L_z04_PondFairy_MoveHearts_LoopHeart
02:00039A2A 0A3C0001        	  3866:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00039A2E 4E75            	  3867:     rts
