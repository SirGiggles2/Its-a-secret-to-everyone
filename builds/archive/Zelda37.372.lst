                            	  2964: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  2965:     ; Begin with the leever's Y set to Link's Y.
                            	  2966:     ;
02:0003942E 102C0084        	  2967:     move.b  ($0084,A4),D0
02:00039432 41EC0084        	  2968:     lea     ($0084,A4),A0
02:00039436 11802000        	  2969:     move.b  D0,(A0,D2.W)
                            	  2970:     ; If Y coordinate < $5D (top of the third square row), then
                            	  2971:     ; it's too close to the top edge of the screen. So, return.
                            	  2972:     ;
02:0003943A 0C00005D        	  2973:     cmpi.b  #$5D,D0
02:0003943E 65EC            	  2974:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  2975:     ; If facing right, then use X offset $28.
                            	  2976:     ; Else store X offset -$28 in [00].
                            	  2977:     ;
02:00039440 7628            	  2978:     moveq   #40,D3
02:00039442 41EC0098        	  2979:     lea     ($0098,A4),A0
02:00039446 10302000        	  2980:     move.b  (A0,D2.W),D0
02:0003944A 02000002        	  2981:     andi.b #$02,D0
02:0003944E 6704            	  2982:     beq  _anon_z04_45
02:00039450 163C00D8        	  2983:     move.b  #$D8,D3
                            	  2984: _anon_z04_45:
02:00039454 1883            	  2985:     move.b  D3,($0000,A4)
                            	  2986:     ; [01] holds Link's X coordinate.
                            	  2987:     ;
02:00039456 102C0070        	  2988:     move.b  ($0070,A4),D0
02:0003945A 19400001        	  2989:     move.b  D0,($0001,A4)
                            	  2990:     ; Add Link's X and the horizontal offset.
                            	  2991:     ;
02:0003945E 023C00EE        	  2992:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039462 1214            	  2993:     move.b  ($0000,A4),D1
02:00039464 D101            	  2994:     addx.b  D1,D0   ; ADC $00
                            	  2995:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  2996:     ;
02:00039466 020000F8        	  2997:     andi.b #$F8,D0
                            	  2998:     ; Assign that result to the leever's X coordinate and [02].
                            	  2999:     ;
02:0003946A 19802070        	  3000:     move.b  D0,($70,A4,D2.W)
02:0003946E 19400002        	  3001:     move.b  D0,($0002,A4)
                            	  3002:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3003:     ;
02:00039472 122C0001        	  3004:     move.b  ($0001,A4),D1
02:00039476 B001            	  3005:     cmp.b   D1,D0
02:00039478 6510            	  3006:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003947A 1B00            	  3007:     move.b  D0,-(A5)  ; PHA
02:0003947C 102C0001        	  3008:     move.b  ($0001,A4),D0
02:00039480 19400002        	  3009:     move.b  D0,($0002,A4)
02:00039484 101D            	  3010:     move.b  (A5)+,D0  ; PLA
02:00039486 19400001        	  3011:     move.b  D0,($0001,A4)
                            	  3012:     even
                            	  3013: _L_z04_UpdateRedLeever_Subtract:
                            	  3014:     ; The point is to get the absolute distance between the two.
                            	  3015:     ;
02:0003948A 102C0001        	  3016:     move.b  ($0001,A4),D0
02:0003948E 003C0011        	  3017:     ori     #$11,CCR  ; SEC: set C+X
02:00039492 122C0002        	  3018:     move.b  ($0002,A4),D1
02:00039496 0A3C0010        	  3019:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003949A 9101            	  3020:     subx.b  D1,D0   ; SBC $02
02:0003949C 0A3C0010        	  3021:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3022:     ; If the absolute distance >= $30, then return.
                            	  3023:     ; It means that the leever's X coordinate wrapped around
                            	  3024:     ; the left or right edge of the screen.
                            	  3025:     ;
02:000394A0 0C000030        	  3026:     cmpi.b  #$30,D0
02:000394A4 6486            	  3027:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3028:     even
                            	  3029: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3030:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3031:     ;
