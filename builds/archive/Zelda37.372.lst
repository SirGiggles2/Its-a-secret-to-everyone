                            	  6771: DodongoBombPositiveLimits:
02:0003AF64 0C              	  6772:     dc.b    $0C, $11
02:0003AF65 11
                            	  6773: 
                            	  6774:     even
                            	  6775: DodongoBombNegativeLimits:
02:0003AF66 F4              	  6776:     dc.b    $F4, $F0
02:0003AF67 F0
                            	  6777: 
                            	  6778: ; Params:
                            	  6779: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  6780: ; [00]: monster hotspot X
                            	  6781: ; [01]: monster hotspot Y
                            	  6782: ; [02]: bomb hotspot X
                            	  6783: ; [03]: bomb hotspot Y
                            	  6784: ;
                            	  6785: ; Returns:
                            	  6786: ; A: 0 if the bomb is in range of the monster
                            	  6787: ; Z: 1 if the bomb is in range of the monster
                            	  6788: ; [04]: horizontal distance
                            	  6789: ; [05]: vertical distance
                            	  6790: ;
                            	  6791: ; Store the positive limit in [06], and the negative one in [07].
                            	  6792: ;
                            	  6793:     even
                            	  6794: Dodongo_IsBombInRange:
02:0003AF68 41F90003AF64    	  6795:     lea     (DodongoBombPositiveLimits).l,A0
02:0003AF6E 10303000        	  6796:     move.b  (A0,D3.W),D0
02:0003AF72 19400006        	  6797:     move.b  D0,($0006,A4)
02:0003AF76 41F90003AF66    	  6798:     lea     (DodongoBombNegativeLimits).l,A0
02:0003AF7C 10303000        	  6799:     move.b  (A0,D3.W),D0
02:0003AF80 19400007        	  6800:     move.b  D0,($0007,A4)
                            	  6801:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  6802:     ; the bomb is near enough the monster.
                            	  6803:     ;
02:0003AF84 7003            	  6804:     moveq   #3,D0
02:0003AF86 19400008        	  6805:     move.b  D0,($0008,A4)
                            	  6806:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  6807:     ;
02:0003AF8A 7601            	  6808:     moveq   #1,D3
                            	  6809:     even
                            	  6810: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  6811:     ; Subtract the bomb's coordinate from the boss's,
                            	  6812:     ; The loop index determines the coordinate.
                            	  6813:     ;
02:0003AF8C 10343000        	  6814:     move.b  ($00,A4,D3.W),D0
02:0003AF90 003C0011        	  6815:     ori     #$11,CCR  ; SEC: set C+X
02:0003AF94 12343002        	  6816:     move.b  ($02,A4,D3.W),D1
02:0003AF98 0A3C0010        	  6817:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AF9C 9101            	  6818:     subx.b  D1,D0   ; SBC $0002,Y
02:0003AF9E 0A3C0010        	  6819:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6820:     ; If the distance >= positive offset, or < negative offset;
                            	  6821:     ; then loop again.
                            	  6822:     ;
02:0003AFA2 122C0006        	  6823:     move.b  ($0006,A4),D1
02:0003AFA6 B001            	  6824:     cmp.b   D1,D0
02:0003AFA8 6A16            	  6825:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003AFAA 122C0007        	  6826:     move.b  ($0007,A4),D1
02:0003AFAE B001            	  6827:     cmp.b   D1,D0
02:0003AFB0 6B0E            	  6828:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  6829:     ; The distance is close enough in this axis.
                            	  6830:     ;
                            	  6831:     ; Store the distance in this axis in [05] or [04],
                            	  6832:     ; depending on the loop index.
                            	  6833:     ;
02:0003AFB2 19803004        	  6834:     move.b  D0,($04,A4,D3.W)
                            	  6835:     ; Shift [08] right, because we're in range in this axis.
                            	  6836:     ;
02:0003AFB6 122C0008        	  6837:     move.b  ($0008,A4),D1
02:0003AFBA E209            	  6838:     lsr.b  #1,D1   ; LSR $08
02:0003AFBC 19410008        	  6839:     move.b  D1,($0008,A4)
                            	  6840:     even
                            	  6841: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003AFC0 5303            	  6842:     subq.b  #1,D3
02:0003AFC2 6AC8            	  6843:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  6844:     ; If close enough in both axes, then [08] will be 0.
                            	  6845:     ;
02:0003AFC4 102C0008        	  6846:     move.b  ($0008,A4),D0
02:0003AFC8 4E75            	  6847:     rts
                            	  6848: 
                            	  6849: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  6850: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  6851: ;
                            	  6852: ; But these are not typical direction indexes. Instead a
                            	  6853: ; 5-way index is used.
                            	  6854: ; A direction shifted right once becomes a 5-way index.
                            	  6855: ; The fourth element is unused.
                            	  6856: ;
                            	  6857:     even
                            	  6858: DodongoFrameImages:
02:0003AFCA 00              	  6859:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003AFCB 01
02:0003AFCC 06
02:0003AFCD FF
02:0003AFCE 08
02:0003AFCF 02
02:0003AFD0 03
02:0003AFD1 06
02:0003AFD2 FF              	  6860:     dc.b    $FF, $08
02:0003AFD3 08
                            	  6861: 
                            	  6862:     even
                            	  6863: DodongoFrameHFlips:
02:0003AFD4 00              	  6864:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003AFD5 40
02:0003AFD6 00
02:0003AFD7 FF
02:0003AFD8 00
02:0003AFD9 00
02:0003AFDA 40
02:0003AFDB 40
02:0003AFDC FF              	  6865:     dc.b    $FF, $40
02:0003AFDD 40
                            	  6866: 
                            	  6867:     even
                            	  6868: DodongoFrameImagesBloated:
02:0003AFDE 04              	  6869:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003AFDF 05
02:0003AFE0 07
02:0003AFE1 FF
02:0003AFE2 09
02:0003AFE3 04
02:0003AFE4 05
02:0003AFE5 07
02:0003AFE6 FF              	  6870:     dc.b    $FF, $09
02:0003AFE7 09
                            	  6871: 
                            	  6872:     even
                            	  6873: DodongoFrameHFlipsBloated:
02:0003AFE8 00              	  6874:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003AFE9 40
02:0003AFEA 00
02:0003AFEB FF
02:0003AFEC 00
02:0003AFED 00
02:0003AFEE 40
02:0003AFEF 00
02:0003AFF0 FF              	  6875:     dc.b    $FF, $00
02:0003AFF1 00
