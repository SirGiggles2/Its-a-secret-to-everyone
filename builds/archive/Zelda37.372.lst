02:0004A6A0 123C0010        	  5551:     move.b  #$10,D1
02:0004A6A4 D101            	  5552:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004A6A6 41EC00AC        	  5553:     lea     ($00AC,A4),A0
02:0004A6AA 11802000        	  5554:     move.b  D0,(A0,D2.W)
