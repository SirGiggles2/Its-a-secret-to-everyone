02:0003CF9C 41EC0485        	 11059:     lea     ($0485,A4),A0
02:0003CFA0 11802000        	 11060:     move.b  D0,(A0,D2.W)
                            	 11061:     ; Find the tail of the lamnola that the current segment belongs to.
