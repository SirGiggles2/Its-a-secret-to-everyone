                            	  7143: UpdatePolsVoice:
02:0003B1CA 0C020001        	  7144:     cmpi.b  #$01,D2
                            	  7145:     bne  _anon_z04_96
                            	  7146: _anon_z04_96:
                            	  7147:     ; If we have the magic clock, or is stunned, then
                            	  7148:     ; go draw and check collisions.
                            	  7149:     ;
02:0003B1CE 102C066C        	  7150:     move.b  ($066C,A4),D0
02:0003B1D2 1234203D        	  7151:     move.b  ($3D,A4,D2.W),D1
02:0003B1D6 8001            	  7152:     or.b  D1,D0
02:0003B1D8 660000AE        	  7153:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7154:     ; Every odd screen frame, go straight to drawing
                            	  7155:     ; and checking collisions.
                            	  7156:     ;
02:0003B1DC 102C0015        	  7157:     move.b  ($0015,A4),D0
02:0003B1E0 E208            	  7158:     lsr.b  #1,D0   ; LSR A
02:0003B1E2 6404            	  7159:     bcc.s  __far_z_04_0066
02:0003B1E4 60000118        	  7160:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7161: __far_z_04_0066:
                            	  7162:     ; Otherwise move horizontally.
                            	  7163:     ;
02:0003B1E8 61000248        	  7164:     jsr     PolsVoice_MoveX
                            	  7165:     ; If state <> 0, then the monster is jumping.
                            	  7166:     ; Go handle vertical movement.
                            	  7167:     ;
02:0003B1EC 41EC00AC        	  7168:     lea     ($00AC,A4),A0
02:0003B1F0 10302000        	  7169:     move.b  (A0,D2.W),D0
02:0003B1F4 6706            	  7170:     beq  _L_z04_UpdatePolsVoice_State0
02:0003B1F6 61000130        	  7171:     jsr     UpdatePolsVoiceState1_Jumping
02:0003B1FA 6034            	  7172:     jmp     _L_z04_UpdatePolsVoice_CheckWalkability
                            	  7173: 
                            	  7174:     even
                            	  7175: _L_z04_UpdatePolsVoice_State0:
                            	  7176:     ; State 0. Walking.
                            	  7177:     ;
                            	  7178:     ; If grid offset = 0, then no more distance to cover.
                            	  7179:     ; So, go change to state 1 -- jumping.
                            	  7180:     ;
02:0003B1FC 41EC0394        	  7181:     lea     ($0394,A4),A0
02:0003B200 10302000        	  7182:     move.b  (A0,D2.W),D0
02:0003B204 67000084        	  7183:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7184:     ; Decrement grid offset / distance remaining.
                            	  7185:     ;
02:0003B208 41EC0394        	  7186:     lea     ($0394,A4),A0
02:0003B20C 53302000        	  7187:     subq.b  #1,(A0,D2.W)
                            	  7188:     ; Move vertically.
                            	  7189:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7190:     ;
02:0003B210 41EC0084        	  7191:     lea     ($0084,A4),A0
02:0003B214 10302000        	  7192:     move.b  (A0,D2.W),D0
02:0003B218 023C00EE        	  7193:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B21C 41F90003B1AC    	  7194:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003B222 12303000        	  7195:     move.b  (A0,D3.W),D1
02:0003B226 D101            	  7196:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003B228 41EC0084        	  7197:     lea     ($0084,A4),A0
02:0003B22C 11802000        	  7198:     move.b  D0,(A0,D2.W)
                            	  7199:     even
                            	  7200: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7201:     ; If the square the monster is over is walkable, then
                            	  7202:     ; go draw and check object collisions.
                            	  7203:     ;
02:0003B230 610001F4        	  7204:     jsr     PolsVoice_IsSquareWalkable
02:0003B234 6452            	  7205:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7206:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7207:     ; then go change to state 1.
                            	  7208:     ;
02:0003B236 41EC041F        	  7209:     lea     ($041F,A4),A0
02:0003B23A 10302000        	  7210:     move.b  (A0,D2.W),D0
02:0003B23E 020000FC        	  7211:     andi.b #$FC,D0
02:0003B242 0C0000B0        	  7212:     cmpi.b  #$B0,D0
02:0003B246 6742            	  7213:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003B248 0C0000F4        	  7214:     cmpi.b  #$F4,D0
02:0003B24C 643C            	  7215:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7216:     ; Else blocked by something else.
                            	  7217:     ;
                            	  7218:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7219:     ;
02:0003B24E 41EC0098        	  7220:     lea     ($0098,A4),A0
02:0003B252 10302000        	  7221:     move.b  (A0,D2.W),D0
02:0003B256 02000003        	  7222:     andi.b #$03,D0
02:0003B25A 6618            	  7223:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7224:     ; Else facing vertically. Flip the direction.
                            	  7225:     ; Go draw.
                            	  7226:     ;
02:0003B25C 41EC0098        	  7227:     lea     ($0098,A4),A0
02:0003B260 10302000        	  7228:     move.b  (A0,D2.W),D0
02:0003B264 0A00000C        	  7229:     eori.b #$0C,D0
02:0003B268 41EC0098        	  7230:     lea     ($0098,A4),A0
02:0003B26C 11802000        	  7231:     move.b  D0,(A0,D2.W)
02:0003B270 6000008C        	  7232:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  7233: 
