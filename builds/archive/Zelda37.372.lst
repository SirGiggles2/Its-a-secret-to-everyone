                            	  6680:     ;
02:0003AEE2 7600            	  6681:     moveq   #0,D3
02:0003AEE4 61000082        	  6682:     jsr     Dodongo_IsBombInRange
02:0003AEE8 660A            	  6683:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003AEEA 7002            	  6684:     moveq   #2,D0
02:0003AEEC 41EC00AC        	  6685:     lea     ($00AC,A4),A0
02:0003AEF0 11802000        	  6686:     move.b  D0,(A0,D2.W)
                            	  6687:     even
