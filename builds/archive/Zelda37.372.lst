                            	  3357:     even
                            	  3358: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003970C 102C000D        	  3359:     move.b  ($000D,A4),D0
                            	  3360: ; Params:
                            	  3361: ; A: frame image
                            	  3362: ; X: object index
                            	  3363: ; [00]: object X
                            	  3364: ; [01]: object Y
                            	  3365: ; [0F]: flip horizontally
                            	  3366: ;
                            	  3367: ; Returns:
                            	  3368: ; [00]: 0 for Link slot
                            	  3369: ; [06]: 1 if objects collide
                            	  3370: ; [09]: 0 for Link damage type (none)
                            	  3371: ; [0C]: 1 if objects collide
                            	  3372: ; [034B]: ShotCollidesWithLink
                            	  3373: ;
                            	  3374:     even
