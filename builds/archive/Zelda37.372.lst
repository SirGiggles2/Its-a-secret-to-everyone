02:00030936 41F9000308DA    	  2135:     lea     (SpriteOffsets).l,A0
02:0003093C 10303000        	  2136:     move.b  (A0,D3.W),D0
02:00030940 19400343        	  2137:     move.b  D0,($0343,A4)
02:00030944 41F9000308DB    	  2138:     lea     (SpriteOffsets+1).l,A0
02:0003094A 10303000        	  2139:     move.b  (A0,D3.W),D0
