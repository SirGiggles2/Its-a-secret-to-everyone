                            	  1799: _L_z05_InitMode_EnterRoom_Method2:
                            	  1800:     ; Enter method 2.
                            	  1801:     ; Room to room.
                            	  1802:     ;
                            	  1803:     ; Get the direction that the player is entering from.
                            	  1804:     ;
02:0003F2AA 102C0098        	  1805:     move.b  ($0098,A4),D0
02:0003F2AE 19400053        	  1806:     move.b  D0,($0053,A4)
02:0003F2B2 4EB900030542    	  1807:     jsr     GetOppositeDir
                            	  1808:     ; If the player is entering from a door that was opened, then
                            	  1809:     ; set the "close" door command.
                            	  1810:     ;
02:0003F2B8 122C00EE        	  1811:     move.b  ($00EE,A4),D1
02:0003F2BC C001            	  1812:     and.b  D1,D0
02:0003F2BE 19400055        	  1813:     move.b  D0,($0055,A4)
02:0003F2C2 6706            	  1814:     beq  _anon_z05_43
02:0003F2C4 7002            	  1815:     moveq   #2,D0
02:0003F2C6 19400054        	  1816:     move.b  D0,($0054,A4)
                            	  1817: _anon_z05_43:
                            	  1818:     ; If in OW, go reset Link's relative position, and work on objects.
                            	  1819:     ;
02:0003F2CA 102C0010        	  1820:     move.b  ($0010,A4),D0
02:0003F2CE 673E            	  1821:     beq  _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1822:     ; If facing right, then set Link's X to 0 at the left edge.
                            	  1823:     ; If direction is left, then set Link's X to $F0 at the right edge.
                            	  1824:     ;
02:0003F2D0 7600            	  1825:     moveq   #0,D3
02:0003F2D2 102C0098        	  1826:     move.b  ($0098,A4),D0
02:0003F2D6 02000003        	  1827:     andi.b #$03,D0
02:0003F2DA 670E            	  1828:     beq  _L_z05_InitMode_EnterRoom_ChooseWalkDistance
02:0003F2DC 02000001        	  1829:     andi.b #$01,D0
02:0003F2E0 6604            	  1830:     bne  _anon_z05_44
02:0003F2E2 163C00F0        	  1831:     move.b  #$F0,D3
                            	  1832: _anon_z05_44:
02:0003F2E6 19430070        	  1833:     move.b  D3,($0070,A4)
                            	  1834:     even
                            	  1835: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1836:     ; Choose a distance to walk depending on the door you
                            	  1837:     ; come out of.
                            	  1838:     ;
                            	  1839:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1840:     ;
                            	  1841:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1842:     ; then you have shorter distance to cover. So use the
                            	  1843:     ; previous value as is to use indexes 0 and 1.
                            	  1844:     ;
                            	  1845:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1846:     ; to get out of the way of the wall or door.
                            	  1847:     ;
02:0003F2EA 610038FA        	  1848:     jsr     GetPassedDoorType
02:0003F2EE 02000007        	  1849:     andi.b #$07,D0
02:0003F2F2 6710            	  1850:     beq  _anon_z05_45
02:0003F2F4 0C000005        	  1851:     cmpi.b  #$05,D0
02:0003F2F8 670A            	  1852:     beq  _anon_z05_45
02:0003F2FA 0C000006        	  1853:     cmpi.b  #$06,D0
02:0003F2FE 6704            	  1854:     beq  _anon_z05_45
02:0003F300 5203            	  1855:     addq.b  #1,D3
02:0003F302 5203            	  1856:     addq.b  #1,D3
                            	  1857: _anon_z05_45:
02:0003F304 41F90003EC60    	  1858:     lea     (EnteringRoomRelativePositions).l,A0
02:0003F30A 10303000        	  1859:     move.b  (A0,D3.W),D0
                            	  1860:     even
                            	  1861: _L_z05_InitMode_EnterRoom_PlaceObjects:
02:0003F30E 19400394        	  1862:     move.b  D0,($0394,A4)
02:0003F312 61003866        	  1863:     jsr     SetupObjRoomBounds
                            	  1864:     ; Set current object slot variable to $B, to be ready for the
                            	  1865:     ; first frame of mode 5. So, that it begins updating objects
                            	  1866:     ; at slot $B.
                            	  1867:     ;
02:0003F316 740B            	  1868:     moveq   #11,D2
02:0003F318 19420340        	  1869:     move.b  D2,($0340,A4)
                            	  1870: _anon_z05_46:
                            	  1871:     ; Reset common state of objects $B to 1.
                            	  1872:     ;
02:0003F31C 41EC0492        	  1873:     lea     ($0492,A4),A0
02:0003F320 53302000        	  1874:     subq.b  #1,(A0,D2.W)
02:0003F324 4EB9000499B4    	  1875:     jsr     ResetShoveInfo
02:0003F32A 41EC00AC        	  1876:     lea     ($00AC,A4),A0
02:0003F32E 11802000        	  1877:     move.b  D0,(A0,D2.W)
02:0003F332 41EC0098        	  1878:     lea     ($0098,A4),A0
02:0003F336 11802000        	  1879:     move.b  D0,(A0,D2.W)
02:0003F33A 1980203D        	  1880:     move.b  D0,($3D,A4,D2.W)
02:0003F33E 41EC03D0        	  1881:     lea     ($03D0,A4),A0
02:0003F342 52302000        	  1882:     addq.b  #1,(A0,D2.W)
