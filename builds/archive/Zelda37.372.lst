02:00038B14 41EC0084        	  1634:     lea     ($0084,A4),A0
02:00038B18 10302000        	  1635:     move.b  (A0,D2.W),D0
02:00038B1C 19400003        	  1636:     move.b  D0,($0003,A4)
02:00038B20 6000815C        	  1637:     jmp     CheckMonsterCollisions
