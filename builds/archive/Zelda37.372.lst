                            	  1365: Zol_CheckCollisions:
                            	  1366:     ; If not in state 0, then return.
                            	  1367:     ;
02:00038950 41EC00AC        	  1368:     lea     ($00AC,A4),A0
02:00038954 10302000        	  1369:     move.b  (A0,D2.W),D0
02:00038958 665C            	  1370:     bne  _L_z04_Zol_CheckCollisions_Exit
                            	  1371:     ; Check collisions.
                            	  1372:     ;
                            	  1373:     ; If killed, or got hit but didn't get hurt (invincibility timer = 0),
                            	  1374:     ; then return.
                            	  1375:     ;
02:0003895A 610001B0        	  1376:     jsr     Gel_CheckCollisions
02:0003895E 41EC0405        	  1377:     lea     ($0405,A4),A0
02:00038962 10302000        	  1378:     move.b  (A0,D2.W),D0
02:00038966 664E            	  1379:     bne  _L_z04_Zol_CheckCollisions_Exit
02:00038968 41EC04F0        	  1380:     lea     ($04F0,A4),A0
02:0003896C 10302000        	  1381:     move.b  (A0,D2.W),D0
02:00038970 6744            	  1382:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1383:     ; If vertically aligned with the square grid, then
                            	  1384:     ; use a horizontal direction mask (3).
                            	  1385:     ;
                            	  1386:     ; Keep in mind that most objects are aligned vertically when
                            	  1387:     ; the low nibble of their Y is $D.
                            	  1388:     ;
02:00038972 7600            	  1389:     moveq   #0,D3
02:00038974 41EC0084        	  1390:     lea     ($0084,A4),A0
02:00038978 10302000        	  1391:     move.b  (A0,D2.W),D0
02:0003897C 0200000F        	  1392:     andi.b #$0F,D0
02:00038980 0C00000D        	  1393:     cmpi.b  #$0D,D0
02:00038984 6602            	  1394:     bne  _anon_z04_26
02:00038986 7603            	  1395:     moveq   #3,D3
                            	  1396: _anon_z04_26:
02:00038988 1883            	  1397:     move.b  D3,($0000,A4)
                            	  1398:     ; If horizontally aligned with the square grid, then
                            	  1399:     ; use a vertical direction mask ($C).
                            	  1400:     ;
02:0003898A 7600            	  1401:     moveq   #0,D3
02:0003898C 10342070        	  1402:     move.b  ($70,A4,D2.W),D0
02:00038990 0200000F        	  1403:     andi.b #$0F,D0
02:00038994 6602            	  1404:     bne  _anon_z04_27
02:00038996 760C            	  1405:     moveq   #12,D3
                            	  1406: _anon_z04_27:
02:00038998 1003            	  1407:     move.b  D3,D0
                            	  1408:     ; Combine the two masks. At most one will be 0.
                            	  1409:     ;
02:0003899A 1214            	  1410:     move.b  ($0000,A4),D1
02:0003899C 8001            	  1411:     or.b  D1,D0
                            	  1412:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1413:     ; with the grid.
                            	  1414:     ;
                            	  1415:     ; If so, then go to state 1 to do a "big shove".
                            	  1416:     ; Else go to state 2, to immediately split in two.
                            	  1417:     ;
                            	  1418:     ; Examples:
                            	  1419:     ; It would be aligned, if moving left along a tile as usual.
                            	  1420:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1421:     ; - The collision check routines would have made the zol
                            	  1422:     ;   face in the direction of the weapon.
                            	  1423:     ; - See CheckMonsterWeaponCollision.
                            	  1424:     ;
02:0003899E 122C0098        	  1425:     move.b  ($0098,A4),D1
02:000389A2 C001            	  1426:     and.b  D1,D0
02:000389A4 6608            	  1427:     bne  _anon_z04_28
02:000389A6 41EC00AC        	  1428:     lea     ($00AC,A4),A0
02:000389AA 52302000        	  1429:     addq.b  #1,(A0,D2.W)
                            	  1430: _anon_z04_28:
02:000389AE 41EC00AC        	  1431:     lea     ($00AC,A4),A0
02:000389B2 52302000        	  1432:     addq.b  #1,(A0,D2.W)
                            	  1433:     even
