02:00038DFA 1234203D        	  2097:     move.b  ($3D,A4,D2.W),D1
02:00038DFE 8001            	  2098:     or.b  D1,D0
02:00038E00 6610            	  2099:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2100:     ; Shoot.
