02:0003A33A 41EC0486        	  5089:     lea     ($0486,A4),A0
02:0003A33E 11803000        	  5090:     move.b  D0,(A0,D3.W)
                            	  5091:     ; Start with flying speed $80, and in flying state 2.
                            	  5092:     ;
