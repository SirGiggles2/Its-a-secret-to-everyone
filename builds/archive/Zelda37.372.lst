02:00038FD0 41F900038EFA    	  2389:     lea     (JumperStartSpeedsHi).l,A0
02:00038FD6 10303000        	  2390:     move.b  (A0,D3.W),D0
02:00038FDA 41EC0412        	  2391:     lea     ($0412,A4),A0
02:00038FDE 11802000        	  2392:     move.b  D0,(A0,D2.W)
                            	  2393:     ; Reset the vertical speed low byte.
                            	  2394:     ; Then go animate, draw, and check collisions.
                            	  2395:     ;
02:00038FE2 6100022E        	  2396:     jsr     Jumper_ResetVSpeedFrac
