02:0003B416 9101            	  7418:     subx.b  D1,D0   ; SBC #$03
02:0003B418 0A3C0010        	  7419:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B41C 41EC0084        	  7420:     lea     ($0084,A4),A0
