                            	  9281: _L_z04_UpdateGohma_AnimateEye:
                            	  9282:     ; Animate the eye.
                            	  9283:     ;
                            	  9284:     ; First, if the counter for when to open the eye next = 0, then
                            	  9285:     ; set it to a random value at least $C0; and set the timer for
                            	  9286:     ; keeping the eye open to $80.
                            	  9287:     ;
                            	  9288:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9289:     ; every other frame.
                            	  9290:     ;
02:0003C218 41EC042C        	  9291:     lea     ($042C,A4),A0
02:0003C21C 10302000        	  9292:     move.b  (A0,D2.W),D0
