                            	  2812: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  2813:     ; Or else if is zora in state 1 or 5, then use one of
                            	  2814:     ; the mound frame images:
                            	  2815:     ;
                            	  2816:     ; frame image := ((state - 1) * 2) + movement frame
                            	  2817:     ;
                            	  2818:     ; This yields 0/1 or 8/9, depending on the state.
                            	  2819:     ;
                            	  2820:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  2821:     ;
02:00039316 003C0011        	  2822:     ori     #$11,CCR  ; SEC: set C+X
02:0003931A 123C0001        	  2823:     move.b  #$01,D1
02:0003931E 0A3C0010        	  2824:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039322 9101            	  2825:     subx.b  D1,D0   ; SBC #$01
02:00039324 0A3C0010        	  2826:     eori    #$10,CCR  ; restore X = 6502 C
02:00039328 E308            	  2827:     lsl.b  #1,D0   ; ASL A
02:0003932A 023C00EE        	  2828:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003932E 41EC03E4        	  2829:     lea     ($03E4,A4),A0
02:00039332 12302000        	  2830:     move.b  (A0,D2.W),D1
02:00039336 D101            	  2831:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  2832:     even
