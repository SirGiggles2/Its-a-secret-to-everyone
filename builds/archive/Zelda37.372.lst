02:0003A484 0C030004        	  5241:     cmpi.b  #$04,D3
02:0003A488 6716            	  5242:     beq  _L_z04_UpdateMoldorm_Exit
02:0003A48A 0C030009        	  5243:     cmpi.b  #$09,D3
02:0003A48E 6710            	  5244:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5245:     ; Else finish swapping the segments.
                            	  5246:     ; Set the tail segment's type to the dead dummy object.
                            	  5247:     ;
02:0003A490 705D            	  5248:     moveq   #93,D0
02:0003A492 41EC0350        	  5249:     lea     ($0350,A4),A0
02:0003A496 11803000        	  5250:     move.b  D0,(A0,D3.W)
                            	  5251:     ; Reset the metastate of the current segment, so that it comes
