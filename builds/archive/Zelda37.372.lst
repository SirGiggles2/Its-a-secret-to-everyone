02:000387F4 41EC041F        	  1189:     lea     ($041F,A4),A0
02:000387F8 10302000        	  1190:     move.b  (A0,D2.W),D0
02:000387FC 7600            	  1191:     moveq   #0,D3
02:000387FE 41EC0451        	  1192:     lea     ($0451,A4),A0
02:00038802 16302000        	  1193:     move.b  (A0,D2.W),D3
02:00038806 613E            	  1194:     jsr     Fireball_MoveOneAxis
02:00038808 41EC0451        	  1195:     lea     ($0451,A4),A0
02:0003880C 11802000        	  1196:     move.b  D0,(A0,D2.W)
                            	  1197:     ; Second, load the vertical direction into [0F].
                            	  1198:     ;
02:00038810 41EC0437        	  1199:     lea     ($0437,A4),A0
02:00038814 10302000        	  1200:     move.b  (A0,D2.W),D0
02:00038818 1940000F        	  1201:     move.b  D0,($000F,A4)
                            	  1202:     ; Load the vertical q-speed and position fraction,
                            	  1203:     ; move, then save the position fraction.
                            	  1204:     ;
02:0003881C 41EC0444        	  1205:     lea     ($0444,A4),A0
02:00038820 10302000        	  1206:     move.b  (A0,D2.W),D0
02:00038824 7600            	  1207:     moveq   #0,D3
