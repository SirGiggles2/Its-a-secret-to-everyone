                            	  5155: UpdateMoldorm:
                            	  5156:     ; If facing direction = 0, return.
                            	  5157:     ;
02:0003A3D4 41EC0098        	  5158:     lea     ($0098,A4),A0
02:0003A3D8 10302000        	  5159:     move.b  (A0,D2.W),D0
02:0003A3DC 670000C2        	  5160:     beq  _L_z04_UpdateMoldorm_Exit
