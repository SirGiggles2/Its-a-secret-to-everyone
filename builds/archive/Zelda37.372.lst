                            	  1497: _L_z04_Gel_Move_State0:
                            	  1498:     ; State 0.
                            	  1499:     ;
                            	  1500:     ; Immediately go to state 1 with QSpeed $20 (half a pixel a frame),
                            	  1501:     ; and 5 frame timer.
                            	  1502:     ;
02:00038A28 7020            	  1503:     moveq   #32,D0
02:00038A2A 41EC03BC        	  1504:     lea     ($03BC,A4),A0
02:00038A2E 11802000        	  1505:     move.b  D0,(A0,D2.W)
02:00038A32 7005            	  1506:     moveq   #5,D0
02:00038A34 19802028        	  1507:     move.b  D0,($28,A4,D2.W)
02:00038A38 41EC00AC        	  1508:     lea     ($00AC,A4),A0
02:00038A3C 52302000        	  1509:     addq.b  #1,(A0,D2.W)
02:00038A40 4E75            	  1510:     rts
