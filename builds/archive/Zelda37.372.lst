02:0003C222 103C0080        	  9294:     move.b  #$80,D0
02:0003C226 41EC0444        	  9295:     lea     ($0444,A4),A0
02:0003C22A 11802000        	  9296:     move.b  D0,(A0,D2.W)
02:0003C22E 103C00C0        	  9297:     move.b  #$C0,D0
02:0003C232 12342018        	  9298:     move.b  ($18,A4,D2.W),D1
