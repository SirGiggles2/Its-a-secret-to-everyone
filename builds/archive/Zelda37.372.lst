02:00042F70 6642            	  8103:     bne  _anon_z05_177
02:00042F72 102C0098        	  8104:     move.b  ($0098,A4),D0
02:00042F76 02000004        	  8105:     andi.b #$04,D0
02:00042F7A 6738            	  8106:     beq  _anon_z05_177
