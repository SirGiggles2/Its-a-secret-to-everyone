                            	  3321: DrawGhiniAndCheckCollisions:
02:000396CE 4EB90004AFFA    	  3322:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:000396D4 1940000D        	  3323:     move.b  D0,($000D,A4)
                            	  3324:     ; If the direction has an "up" component, then keep the
                            	  3325:     ; frame image 0, and go figure out horizontal flipping.
                            	  3326:     ;
02:000396D8 41EC0098        	  3327:     lea     ($0098,A4),A0
02:000396DC 10302000        	  3328:     move.b  (A0,D2.W),D0
02:000396E0 02000008        	  3329:     andi.b #$08,D0
02:000396E4 6614            	  3330:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3331:     ; Else make the frame image 1 for the "down" frame.
                            	  3332:     ; Note that this is the frame image to use, even if there's no
                            	  3333:     ; down component in the direction.
                            	  3334:     ;
02:000396E6 522C000D        	  3335:     addq.b  #1,($000D,A4)
                            	  3336:     ; If right is a component of the direction, then go set horizontal
                            	  3337:     ; flipping. Else leave horizontal flipping = 0.
                            	  3338:     ;
02:000396EA 41EC0098        	  3339:     lea     ($0098,A4),A0
02:000396EE 10302000        	  3340:     move.b  (A0,D2.W),D0
02:000396F2 02000001        	  3341:     andi.b #$01,D0
02:000396F6 6714            	  3342:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:000396F8 660E            	  3343:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3344:     even
                            	  3345: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3346:     ; Set horizontal flipping if right is a direction component.
                            	  3347:     ; This essentially the same test as above, but for when we jump
                            	  3348:     ; from the "up" test.
                            	  3349:     ;
02:000396FA 41EC0098        	  3350:     lea     ($0098,A4),A0
02:000396FE 10302000        	  3351:     move.b  (A0,D2.W),D0
02:00039702 02000002        	  3352:     andi.b #$02,D0
02:00039706 6704            	  3353:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3354:     even
