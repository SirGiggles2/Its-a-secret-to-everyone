02:0003AA6E 7600            	  6064:     moveq   #0,D3
02:0003AA70 1600            	  6065:     move.b  D0,D3
02:0003AA72 5203            	  6066:     addq.b  #1,D3
02:0003AA74 41EC0098        	  6067:     lea     ($0098,A4),A0
02:0003AA78 11832000        	  6068:     move.b  D3,(A0,D2.W)
02:0003AA7C 4E75            	  6069:     rts
