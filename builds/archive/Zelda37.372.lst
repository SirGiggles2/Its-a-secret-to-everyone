02:0003E0D0 003C0011        	 13569:     ori     #$11,CCR  ; SEC: set C+X
02:0003E0D4 123C0008        	 13570:     move.b  #$08,D1
02:0003E0D8 0A3C0010        	 13571:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E0DC 9101            	 13572:     subx.b  D1,D0   ; SBC #$08
02:0003E0DE 0A3C0010        	 13573:     eori    #$10,CCR  ; restore X = 6502 C
