02:0003E86C 660A            	   983:     bne  _L_z05_InitMode7_Sub3And4_TransferPlayAreaAttrsToNT2_Vertical
02:0003E86E E208            	   984:     lsr.b  #1,D0   ; LSR A
02:0003E870 122C0098        	   985:     move.b  ($0098,A4),D1
02:0003E874 C200            	   986:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
