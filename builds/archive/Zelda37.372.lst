                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:0003E51E 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:0003E520 7400            	   545:     moveq   #0,D2
02:0003E522 41F90003E4D6    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0003E528 14303000        	   547:     move.b  (A0,D3.W),D2
02:0003E52C 41F90003E506    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0003E532 10303000        	   549:     move.b  (A0,D3.W),D0
02:0003E536 41F900045700    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E53C 11802000        	   551:     move.b  D0,(A0,D2.W)
02:0003E540 5303            	   552:     subq.b  #1,D3
02:0003E542 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0003E544 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0003E546 7001            	   561:     moveq   #1,D0
02:0003E548 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0003E54C 7003            	   569:     moveq   #3,D0
02:0003E54E 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:0003E552 7400            	   576:     moveq   #0,D2
02:0003E554 41F90003E4D6    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0003E55A 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:0003E55E 102C0006        	   585:     move.b  ($0006,A4),D0
02:0003E562 122C0671        	   586:     move.b  ($0671,A4),D1
02:0003E566 C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E568 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:0003E56A 41F900045700    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E570 10302000        	   599:     move.b  (A0,D2.W),D0
02:0003E574 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:0003E578 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003E57A 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:0003E57E 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003E580 41F90003E4EE    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003E586 10303000        	   605:     move.b  (A0,D3.W),D0
02:0003E58A 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003E58C 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:0003E590 41F900045700    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E596 11802000        	   613:     move.b  D0,(A0,D2.W)
