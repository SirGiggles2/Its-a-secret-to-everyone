                            	  5827: CalcBoomerangFrame:
                            	  5828:     ; The minor state (low 3 bits of state) is used to
                            	  5829:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5830:     ;
                            	  5831:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5832:     ; In other words, don't offset the coordinate below.
                            	  5833:     ;
02:0004A89E 7000            	  5834:     moveq   #0,D0
02:0004A8A0 1880            	  5835:     move.b  D0,($0000,A4)
02:0004A8A2 41EC00AC        	  5836:     lea     ($00AC,A4),A0
02:0004A8A6 10302000        	  5837:     move.b  (A0,D2.W),D0
02:0004A8AA 0200000F        	  5838:     andi.b #$0F,D0
02:0004A8AE 7600            	  5839:     moveq   #0,D3
02:0004A8B0 1600            	  5840:     move.b  D0,D3
02:0004A8B2 7000            	  5841:     moveq   #0,D0
02:0004A8B4 19400001        	  5842:     move.b  D0,($0001,A4)
02:0004A8B8 41F90004A4A6    	  5843:     lea     (BoomerangFrameCycle).l,A0
02:0004A8BE 10303000        	  5844:     move.b  (A0,D3.W),D0
02:0004A8C2 1940000C        	  5845:     move.b  D0,($000C,A4)
                            	  5846:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5847:     ;
02:0004A8C6 1003            	  5848:     move.b  D3,D0
02:0004A8C8 41F90004A4B0    	  5849:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004A8CE 10303000        	  5850:     move.b  (A0,D3.W),D0
02:0004A8D2 19400004        	  5851:     move.b  D0,($0004,A4)
                            	  5852:     ; TODO: ?
                            	  5853:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5854:     ; Else add the item value of the magic boomerang.
                            	  5855:     ;
                            	  5856:     ; But none of the values in the base sprite attributes array is 8.
                            	  5857:     ;
                            	  5858:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5859:     ; the inventory will always be added to the base sprite attribute.
                            	  5860:     ;
                            	  5861:     ; So, palette row 4 or 5 will be chosen.
                            	  5862:     ;
02:0004A8D6 7600            	  5863:     moveq   #0,D3
02:0004A8D8 0C000008        	  5864:     cmpi.b  #$08,D0
02:0004A8DC 6706            	  5865:     beq  _anon_z07_31
02:0004A8DE 7600            	  5866:     moveq   #0,D3
02:0004A8E0 162C0675        	  5867:     move.b  ($0675,A4),D3
