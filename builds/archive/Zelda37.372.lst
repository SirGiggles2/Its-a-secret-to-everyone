                            	  1627: Gel_CheckCollisions:
                            	  1628:     ; TODO:
                            	  1629:     ; CheckMonsterCollisions calls GetObjectMiddle which
                            	  1630:     ; overwrites [02] and [03]. So, I don't know why these are set here.
                            	  1631:     ;
02:00038B0C 10342070        	  1632:     move.b  ($70,A4,D2.W),D0
