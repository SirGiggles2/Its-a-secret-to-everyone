02:00033626 102C0420        	  2536:     move.b  ($0420,A4),D0
                            	  2537:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2538:     ; the name field.
02:0003362A 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:0003362C 7600            	  2540:     moveq   #0,D3
02:0003362E 162C0016        	  2541:     move.b  ($0016,A4),D3
02:00033632 0C030003        	  2542:     cmpi.b  #$03,D3
02:00033636 6602            	  2543:     bne.s  __far_z_02_0007
02:00033638 60E6            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:0003363A 41F90003304E    	  2548:     lea     (SlotToNameOffset).l,A0
02:00033640 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00033644 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00033648 7400            	  2553:     moveq   #0,D2
02:0003364A 41F900033052    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033650 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00033654 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00033656 41F90003301E    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:0003365C 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00033660 41EC0422        	  2561:     lea     ($0422,A4),A0
02:00033664 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00033668 5302            	  2563:     subq.b  #1,D2
02:0003366A 5303            	  2564:     subq.b  #1,D3
02:0003366C 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:0003366E 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:00033672 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:00033676 020000C0        	  2577:     andi.b #$C0,D0
02:0003367A 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:0003367E 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033682 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:00033686 7620            	  2586:     moveq   #32,D3
02:00033688 19430604        	  2587:     move.b  D3,($0604,A4)
02:0003368C 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:0003368E 41EC0422        	  2591:     lea     ($0422,A4),A0
02:00033692 10303000        	  2592:     move.b  (A0,D3.W),D0
02:00033696 41EC0302        	  2593:     lea     ($0302,A4),A0
02:0003369A 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:0003369E 5303            	  2595:     subq.b  #1,D3
02:000336A0 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:000336A2 19430306        	  2597:     move.b  D3,($0306,A4)
02:000336A6 7400            	  2598:     moveq   #0,D2
02:000336A8 142C0421        	  2599:     move.b  ($0421,A4),D2
02:000336AC 7600            	  2600:     moveq   #0,D3
02:000336AE 162C041F        	  2601:     move.b  ($041F,A4),D3
02:000336B2 41F900032FF2    	  2602:     lea     (ModeE_CharMap).l,A0
02:000336B8 10303000        	  2603:     move.b  (A0,D3.W),D0
02:000336BC 19400305        	  2604:     move.b  D0,($0305,A4)
02:000336C0 41EC0638        	  2605:     lea     ($0638,A4),A0
02:000336C4 11802000        	  2606:     move.b  D0,(A0,D2.W)
                            	  2607:     even
                            	  2608: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:000336C8 102C0070        	  2609:     move.b  ($0070,A4),D0
02:000336CC 023C00EE        	  2610:     andi    #$EE,CCR  ; CLC: clear C+X
02:000336D0 123C0008        	  2611:     move.b  #$08,D1
02:000336D4 D101            	  2612:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000336D6 19400070        	  2613:     move.b  D0,($0070,A4)
02:000336DA 522C0421        	  2614:     addq.b  #1,($0421,A4)
02:000336DE 522C0423        	  2615:     addq.b  #1,($0423,A4)
                            	  2616:     ; If VRAM address still points inside the name field,
                            	  2617:     ; then go finish.
                            	  2618:     ;
                            	  2619:     ; The idea is that each name field in nametable begins at
                            	  2620:     ; an address ending in $E. For example, slot 0 has a name
                            	  2621:     ; at VRAM addresses $20CE to $20D5.
                            	  2622:     ;
                            	  2623:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2624:     ; the name field.
                            	  2625:     ;
                            	  2626:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2627:     ; record header.
                            	  2628:     ;
02:000336E2 102C0070        	  2629:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:000336E6 0C0000B0        	  2630:     cmpi.b  #$B0,D0
02:000336EA 6678            	  2631:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2632:     ; The VRAM address now points outside the name field.
                            	  2633:     ; So, wrap around to the beginning of the name field.
                            	  2634:     ;
                            	  2635:     ; For example, $20D6 -> $20CE.
                            	  2636:     ;
02:000336EC 102C0423        	  2637:     move.b  ($0423,A4),D0
02:000336F0 003C0011        	  2638:     ori     #$11,CCR  ; SEC: set C+X
02:000336F4 123C0008        	  2639:     move.b  #$08,D1
02:000336F8 0A3C0010        	  2640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000336FC 9101            	  2641:     subx.b  D1,D0   ; SBC #$08
02:000336FE 0A3C0010        	  2642:     eori    #$10,CCR  ; restore X = 6502 C
02:00033702 19400423        	  2643:     move.b  D0,($0423,A4)
                            	  2644:     ; It also means that we went past the end of the save slot
                            	  2645:     ; info name. Set the offset to the beginning of the name.
02:00033706 7600            	  2646:     moveq   #0,D3
02:00033708 162C0016        	  2647:     move.b  ($0016,A4),D3
02:0003370C 41F90003304E    	  2648:     lea     (SlotToNameOffset).l,A0
02:00033712 10303000        	  2649:     move.b  (A0,D3.W),D0
02:00033716 19400421        	  2650:     move.b  D0,($0421,A4)
                            	  2651:     ; If the name cursor has gone past the end of the field,
                            	  2652:     ; then wrap around.
02:0003371A 102C0070        	  2653:     move.b  ($0070,A4),D0
02:0003371E 0C0000B0        	  2654:     cmpi.b  #$B0,D0
02:00033722 6640            	  2655:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00033724 7070            	  2656:     moveq   #112,D0
02:00033726 19400070        	  2657:     move.b  D0,($0070,A4)
                            	  2658:     even
                            	  2659: ; PATCH P25b: FS2-E backspace handler.
                            	  2660: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2661: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2662: ; one column (8 px), and writes a space ($24) to the erased
                            	  2663: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2664: ; cannot cross into a previous slot's name field.
                            	  2665: _L_z02_ModeE_HandleAOrB_Backspace:
02:0003372A 7600            	  2666:     moveq   #0,D3
02:0003372C 162C0016        	  2667:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00033730 41F90003304E    	  2668:     lea     (SlotToNameOffset).l,A0
02:00033736 12303000        	  2669:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:0003373A 102C0421        	  2670:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:0003373E B001            	  2671:     cmp.b   D1,D0
02:00033740 6322            	  2672:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00033742 5300            	  2673:     subq.b  #1,D0
02:00033744 19400421        	  2674:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00033748 532C0423        	  2675:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:0003374C 122C0070        	  2676:     move.b  ($0070,A4),D1
02:00033750 5101            	  2677:     subi.b  #8,D1
02:00033752 19410070        	  2678:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00033756 7224            	  2679:     moveq   #$24,D1              ; space tile
02:00033758 7600            	  2680:     moveq   #0,D3
02:0003375A 1600            	  2681:     move.b  D0,D3                ; D3 = erased offset
02:0003375C 41EC0638        	  2682:     lea     ($0638,A4),A0
02:00033760 11813000        	  2683:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2684:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2685:     even
