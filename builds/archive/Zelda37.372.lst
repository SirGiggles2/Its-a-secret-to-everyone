02:00033774 41EC0201        	  2699:     lea     ($0201,A4),A0
02:00033778 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:0003377C 5303            	  2701:     subq.b  #1,D3
02:0003377E 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033780 7600            	  2703:     moveq   #0,D3
02:00033782 162C0016        	  2704:     move.b  ($0016,A4),D3
02:00033786 41F900032FEE    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:0003378C 10303000        	  2706:     move.b  (A0,D3.W),D0
