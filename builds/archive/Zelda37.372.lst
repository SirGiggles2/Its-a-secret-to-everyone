                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:000490A8 102C0001        	  2383:     move.b  ($0001,A4),D0
02:000490AC 41EC0303        	  2384:     lea     ($0303,A4),A0
02:000490B0 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:000490B4 41EC0308        	  2386:     lea     ($0308,A4),A0
02:000490B8 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:000490BC 41EC0308        	  2388:     lea     ($0308,A4),A0
