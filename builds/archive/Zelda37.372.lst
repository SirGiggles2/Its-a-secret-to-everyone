02:0003E058 122C0003        	 13514:     move.b  ($0003,A4),D1
02:0003E05C 0A3C0010        	 13515:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E060 9101            	 13516:     subx.b  D1,D0   ; SBC $03
02:0003E062 0A3C0010        	 13517:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E066 6024            	 13518:     jmp     _L_z04_RotateObjectLocation_SetXRotateY
