02:0003D44C 11802000        	 11724:     move.b  D0,(A0,D2.W)
02:0003D450 611C            	 11725:     jsr     PatraChild_Draw
                            	 11726:     ; If Patra's state still = 0, then the last patra child has not
                            	 11727:     ; shown up yet. In this case don't check collisions yet, only return.
                            	 11728:     ;
02:0003D452 102C00AD        	 11729:     move.b  ($00AD,A4),D0
02:0003D456 6714            	 11730:     beq  _L_z04_PatraChild_State1_Exit
02:0003D458 4EB900030C7E    	 11731:     jsr     CheckMonsterCollisions
                            	 11732:     ; If the monster died, then change to the dead dummy object.
                            	 11733:     ;
02:0003D45E 41EC0405        	 11734:     lea     ($0405,A4),A0
02:0003D462 10302000        	 11735:     move.b  (A0,D2.W),D0
02:0003D466 6704            	 11736:     beq  _L_z04_PatraChild_State1_Exit
02:0003D468 6100FA94        	 11737:     jsr     SetDeadDummyObjType
                            	 11738:     even
