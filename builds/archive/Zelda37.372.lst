02:0003902A 7600            	  2442:     moveq   #0,D3
02:0003902C 1600            	  2443:     move.b  D0,D3
02:0003902E 41F900038EDC    	  2444:     lea     (JumperYAccelerations).l,A0
02:00039034 10303000        	  2445:     move.b  (A0,D3.W),D0
02:00039038 7602            	  2446:     moveq   #2,D3
02:0003903A 61000162        	  2447:     jsr     Jumper_MoveY
                            	  2448:     ; If the facing direction has a left component, then
