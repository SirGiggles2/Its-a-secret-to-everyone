                            	  5744: _L_z07_CheckState30_MoveTowardThrower:
                            	  5745:     ; Move towards the thrower.
                            	  5746:     ;
                            	  5747:     ; Middle speed index 4 goes equally fast in X and Y axes.
                            	  5748:     ;
02:0004A7D8 7604            	  5749:     moveq   #4,D3
02:0004A7DA 4EB900030556    	  5750:     jsr     _CalcDiagonalSpeedIndex
