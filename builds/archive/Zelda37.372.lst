                            	  2063: 
                            	  2064: ; Params:
                            	  2065: ; A: frame image
                            	  2066: ; X: object index
                            	  2067: ; [00]: object X
                            	  2068: ; [01]: object Y
                            	  2069: ;
                            	  2070: ;
                            	  2071: ; Set [0C] mirrored.
                            	  2072:     even
