02:00038908 0C000004        	  1327:     cmpi.b  #$04,D0
02:0003890C 7002            	  1328:     moveq   #2,D0
02:0003890E 6402            	  1329:     bcc  _anon_z04_25
02:00038910 7008            	  1330:     moveq   #8,D0
                            	  1331: _anon_z04_25:
02:00038912 41EC0098        	  1332:     lea     ($0098,A4),A0
