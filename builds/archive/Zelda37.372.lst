                            	  1616: InitMode4:
02:0003F16E 7400            	  1617:     moveq   #0,D2
02:0003F170 142C0013        	  1618:     move.b  ($0013,A4),D2
02:0003F174 6604            	  1619:     bne.s  __far_z_05_0023
02:0003F176 60000084        	  1620:     jmp  InitMode_EnterRoom
                            	  1621: __far_z_05_0023:
02:0003F17A 5302            	  1622:     subq.b  #1,D2
02:0003F17C 6612            	  1623:     bne  _L_z05_InitMode4_CheckSub2
                            	  1624:     ; Submode 1.
                            	  1625:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1626:     ;
                            	  1627:     ; TODO:
                            	  1628:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1629:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1630:     ; A positive value triggers this submode 1 to transfer
                            	  1631:     ; the whole play area.
                            	  1632:     ;
                            	  1633:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1634:     ; a good state reflecting the new room. The only thing
                            	  1635:     ; needed is possibly to brighten the room by way of
                            	  1636:     ; changing the palette.
                            	  1637:     ;
                            	  1638:     ; So why does mode 7 trigger this?
                            	  1639:     ; Is there another mode that truly needs this behavior?
                            	  1640:     ;
02:0003F17E 102C00E9        	  1641:     move.b  ($00E9,A4),D0
02:0003F182 6B06            	  1642:     bmi  _anon_z05_40
02:0003F184 6100359A        	  1643:     jsr     CopyNextRowToTransferBuf
02:0003F188 6404            	  1644:     bcc  _L_z05_InitMode4_Exit
                            	  1645: _anon_z05_40:
02:0003F18A 522C0013        	  1646:     addq.b  #1,($0013,A4)
                            	  1647:     even
                            	  1648: _L_z05_InitMode4_Exit:
02:0003F18E 4E75            	  1649:     rts
                            	  1650: 
                            	  1651:     even
                            	  1652: _L_z05_InitMode4_CheckSub2:
02:0003F190 5302            	  1653:     subq.b  #1,D2
02:0003F192 6702            	  1654:     beq.s  __far_z_05_0024
02:0003F194 6058            	  1655:     jmp  InitMode4_Sub3
                            	  1656: __far_z_05_0024:
                            	  1657:     ; Submode 2.
                            	  1658:     ;
02:0003F196 7600            	  1659:     moveq   #0,D3
02:0003F198 162C00EB        	  1660:     move.b  ($00EB,A4),D3
02:0003F19C 61004452        	  1661:     jsr     IsDarkRoom_Bank5
02:0003F1A0 6702            	  1662:     beq.s  __far_z_05_0025
02:0003F1A2 6052            	  1663:     jmp  InitMode4_GoToSub0
                            	  1664: __far_z_05_0025:
                            	  1665:     ; This is a light room.
                            	  1666:     ; See if we have to brighten it after leaving a dark room.
                            	  1667:     ;
02:0003F1A4 102C0098        	  1668:     move.b  ($0098,A4),D0
02:0003F1A8 610041C4        	  1669:     jsr     CalcNextRoomByDir
                            	  1670:     ; Subtract RoomId from next room ID that was calculated
                            	  1671:     ; to get room ID offset in that direction.
02:0003F1AC 003C0011        	  1672:     ori     #$11,CCR  ; SEC: set C+X
02:0003F1B0 122C00EB        	  1673:     move.b  ($00EB,A4),D1
02:0003F1B4 0A3C0010        	  1674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F1B8 9101            	  1675:     subx.b  D1,D0   ; SBC RoomId
02:0003F1BA 0A3C0010        	  1676:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F1BE 4EB90003054A    	  1677:     jsr     Negate
02:0003F1C4 023C00EE        	  1678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F1C8 122C00EB        	  1679:     move.b  ($00EB,A4),D1
02:0003F1CC D101            	  1680:     addx.b  D1,D0   ; ADC RoomId
02:0003F1CE 7600            	  1681:     moveq   #0,D3
02:0003F1D0 1600            	  1682:     move.b  D0,D3
02:0003F1D2 6100441C        	  1683:     jsr     IsDarkRoom_Bank5
02:0003F1D6 6602            	  1684:     bne.s  __far_z_05_0026
02:0003F1D8 601C            	  1685:     jmp  InitMode4_GoToSub0
                            	  1686: __far_z_05_0026:
                            	  1687:     ; The previous room was dark.
                            	  1688:     ;
02:0003F1DA 102C051F        	  1689:     move.b  ($051F,A4),D0
02:0003F1DE 6702            	  1690:     beq.s  __far_z_05_0027
02:0003F1E0 6014            	  1691:     jmp  InitMode4_GoToSub0
