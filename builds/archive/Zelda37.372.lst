                            	  7885: __far_z_05_0086:
                            	  7886:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7887:     ; and represents the current row of the submenu being processed.
                            	  7888:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7889:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7890:     ;
                            	  7891:     ; If the bottom bit is set, go prepare the full black row.
                            	  7892:     ;
02:00042E4A E208            	  7893:     lsr.b  #1,D0   ; LSR A
02:00042E4C 7600            	  7894:     moveq   #0,D3
02:00042E4E 1600            	  7895:     move.b  D0,D3
02:00042E50 6402            	  7896:     bcc.s  __far_z_05_0087
02:00042E52 60B6            	  7897:     jmp  PrepFullBlackRow
