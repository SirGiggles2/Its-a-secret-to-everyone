                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:0004A31E 102C0002        	  5035:     move.b  ($0002,A4),D0
02:0004A322 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:0004A324 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004A328 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004A32A 102C0015        	  5046:     move.b  ($0015,A4),D0
02:0004A32E 02000003        	  5047:     andi.b #$03,D0
02:0004A332 41F90004A190    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004A338 12303000        	  5049:     move.b  (A0,D3.W),D1
02:0004A33C 8001            	  5050:     or.b  D1,D0
02:0004A33E 4EB900030C04    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:0004A344 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004A348 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A34C 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004A350 D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004A352 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:0004A354 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004A358 B001            	  5064:     cmp.b   D1,D0
02:0004A35A 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004A35C 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004A360 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004A362 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004A366 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004A36A 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A36E 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004A370 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A374 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
