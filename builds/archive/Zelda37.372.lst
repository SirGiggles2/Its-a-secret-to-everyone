02:0003B14A 1980203D        	  7078:     move.b  D0,($3D,A4,D2.W)
02:0003B14E 7008            	  7079:     moveq   #8,D0
02:0003B150 4EB90004AFF4    	  7080:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7081:     ; If facing left, then enable horizontal flipping.
                            	  7082:     ;
02:0003B156 41EC0098        	  7083:     lea     ($0098,A4),A0
02:0003B15A 10302000        	  7084:     move.b  (A0,D2.W),D0
02:0003B15E 0C000002        	  7085:     cmpi.b  #$02,D0
02:0003B162 6604            	  7086:     bne  _anon_z04_94
02:0003B164 522C000F        	  7087:     addq.b  #1,($000F,A4)
                            	  7088: _anon_z04_94:
                            	  7089:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7090:     ; This is the base frame image.
                            	  7091:     ;
02:0003B168 E208            	  7092:     lsr.b  #1,D0   ; LSR A
02:0003B16A E208            	  7093:     lsr.b  #1,D0   ; LSR A
                            	  7094:     ; If movement frame = 1, add 3 to frame image to access
                            	  7095:     ; the second animation frame's images.
                            	  7096:     ;
02:0003B16C 7600            	  7097:     moveq   #0,D3
02:0003B16E 41EC03E4        	  7098:     lea     ($03E4,A4),A0
02:0003B172 16302000        	  7099:     move.b  (A0,D2.W),D3
02:0003B176 671E            	  7100:     beq  _anon_z04_95
02:0003B178 023C00EE        	  7101:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B17C 123C0003        	  7102:     move.b  #$03,D1
02:0003B180 D101            	  7103:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7104:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7105:     ;
                            	  7106:     ; Down has two frame images, but up only has one. By flipping
                            	  7107:     ; horizontally, you get two frame images.
                            	  7108:     ;
02:0003B182 7600            	  7109:     moveq   #0,D3
02:0003B184 41EC0098        	  7110:     lea     ($0098,A4),A0
02:0003B188 16302000        	  7111:     move.b  (A0,D2.W),D3
02:0003B18C 0C030008        	  7112:     cmpi.b  #$08,D3
02:0003B190 6604            	  7113:     bne  _anon_z04_95
02:0003B192 522C000F        	  7114:     addq.b  #1,($000F,A4)
                            	  7115: _anon_z04_95:
02:0003B196 4EB900030912    	  7116:     jsr     DrawObjectNotMirrored
