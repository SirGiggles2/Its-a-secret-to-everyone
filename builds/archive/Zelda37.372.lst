                            	  3388: InitArmosOrFlyingGhini:
                            	  3389:     ; In UpdateObject, this object was flagged "initialized".
                            	  3390:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3391:     ;
02:0003972C 10342028        	  3392:     move.b  ($28,A4,D2.W),D0
02:00039730 41EC0492        	  3393:     lea     ($0492,A4),A0
02:00039734 11802000        	  3394:     move.b  D0,(A0,D2.W)
                            	  3395:     ; If it's still fading in, then go finish some initialization needed
                            	  3396:     ; for fading in.
                            	  3397:     ;
02:00039738 660000B6        	  3398:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3399:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3400:     ; go finish initializing it.
                            	  3401:     ;
02:0003973C 41EC034F        	  3402:     lea     ($034F,A4),A0
02:00039740 10302000        	  3403:     move.b  (A0,D2.W),D0
02:00039744 0C000022        	  3404:     cmpi.b  #$22,D0
02:00039748 670000A6        	  3405:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3406:     ; Else we have an armos.
                            	  3407:     ;
                            	  3408:     ; Store stairs tile $70 in [00] for use later.
                            	  3409:     ;
02:0003974C 7070            	  3410:     moveq   #112,D0
02:0003974E 1880            	  3411:     move.b  D0,($0000,A4)
                            	  3412:     ; Look for the current room ID in an array of room ID's that
                            	  3413:     ; have armos secrets.
                            	  3414:     ;
02:00039750 7606            	  3415:     moveq   #6,D3
                            	  3416:     even
                            	  3417: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:00039752 102C00EB        	  3418:     move.b  ($00EB,A4),D0
                            	  3419:     ; If this element does not match the current room ID, go loop again.
                            	  3420:     ;
02:00039756 41F90003971C    	  3421:     lea     (SecretArmosRoomIds).l,A0
02:0003975C 12303000        	  3422:     move.b  (A0,D3.W),D1
02:00039760 B001            	  3423:     cmp.b   D1,D0
02:00039762 6648            	  3424:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3425:     ; The secret (usually stairs) is under one of the armoses.
                            	  3426:     ;
                            	  3427:     ; If the armos's X coordinate does not match the one needed
                            	  3428:     ; for the current room in the list, then go loop again.
                            	  3429:     ;
02:00039764 10342070        	  3430:     move.b  ($70,A4,D2.W),D0
02:00039768 41F900039724    	  3431:     lea     (SecretArmosXs).l,A0
02:0003976E 12303000        	  3432:     move.b  (A0,D3.W),D1
02:00039772 B001            	  3433:     cmp.b   D1,D0
02:00039774 6636            	  3434:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3435:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3436:     ;
02:00039776 41EC0084        	  3437:     lea     ($0084,A4),A0
02:0003977A 10302000        	  3438:     move.b  (A0,D2.W),D0
02:0003977E 0C000080        	  3439:     cmpi.b  #$80,D0
02:00039782 6628            	  3440:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3441:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3442:     ;
02:00039784 4A03            	  3443:     cmpi.b  #$00,D3
02:00039786 662C            	  3444:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3445:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3446:     ; has the power bracelet.
                            	  3447:     ;
                            	  3448:     ; Set up the room item with the armos's coordinates.
                            	  3449:     ;
02:00039788 19400097        	  3450:     move.b  D0,($0097,A4)
02:0003978C 10342070        	  3451:     move.b  ($70,A4,D2.W),D0
02:00039790 19400083        	  3452:     move.b  D0,($0083,A4)
                            	  3453:     ; This resets the room item's state, which activates it.
                            	  3454:     ;
02:00039794 194300BF        	  3455:     move.b  D3,($00BF,A4)
                            	  3456:     ; Set the room item ID.
                            	  3457:     ;
02:00039798 7014            	  3458:     moveq   #20,D0
02:0003979A 194000AB        	  3459:     move.b  D0,($00AB,A4)
                            	  3460:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3461:     ;
                            	  3462:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3463:     ;
                            	  3464:     ; Note that, if the item was already taken, then the room item
                            	  3465:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3466:     ; it will be ignored, because that routine checks whether
                            	  3467:     ; the item was taken.
                            	  3468:     ;
02:0003979E 4EB90003064A    	  3469:     jsr     GetRoomFlagUWItemState
02:000397A4 660A            	  3470:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:000397A6 6100069E        	  3471:     jsr     PlaySecretFoundTune
02:000397AA 6604            	  3472:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3473:     even
                            	  3474: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3475:     ; Bottom of the loop.
                            	  3476:     ;
02:000397AC 5303            	  3477:     subq.b  #1,D3
02:000397AE 6AA2            	  3478:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3479:     even
                            	  3480: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3481:     ; Not found, or found the power bracelet.
                            	  3482:     ; Use a floor tile $26 to replace the armos.
                            	  3483:     ;
02:000397B0 7026            	  3484:     moveq   #38,D0
02:000397B2 1880            	  3485:     move.b  D0,($0000,A4)
                            	  3486:     even
                            	  3487: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:000397B4 1014            	  3488:     move.b  ($0000,A4),D0
                            	  3489:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3490:     ;
02:000397B6 1B00            	  3491:     move.b  D0,-(A5)  ; PHA
02:000397B8 0C000070        	  3492:     cmpi.b  #$70,D0
02:000397BC 6604            	  3493:     bne  _anon_z04_51
02:000397BE 61000686        	  3494:     jsr     PlaySecretFoundTune
                            	  3495: _anon_z04_51:
                            	  3496:     ; Replace the tile where the armos was.
                            	  3497:     ;
02:000397C2 522C00F7        	  3498:     addq.b  #1,($00F7,A4)
02:000397C6 101D            	  3499:     move.b  (A5)+,D0  ; PLA
02:000397C8 4EB90004906E    	  3500:     jsr     ChangeTileObjTiles
                            	  3501:     ; Because the armos object is aligned to the square grid
                            	  3502:     ; (because it was made from a square),
                            	  3503:     ; set its grid offset to 3 to compensate.
                            	  3504:     ;
                            	  3505:     ; Most objects are aligned to the grid vertically when the
                            	  3506:     ; low nibble is $D.
                            	  3507:     ;
02:000397CE 7003            	  3508:     moveq   #3,D0
02:000397D0 41EC0394        	  3509:     lea     ($0394,A4),A0
02:000397D4 11802000        	  3510:     move.b  D0,(A0,D2.W)
                            	  3511:     ; Set a speed (q-speed fraction) randomly:
                            	  3512:     ; $20 if random value < $80
                            	  3513:     ; $60 otherwise
                            	  3514:     ;
02:000397D8 7020            	  3515:     moveq   #32,D0
02:000397DA 7600            	  3516:     moveq   #0,D3
02:000397DC 16342019        	  3517:     move.b  ($19,A4,D2.W),D3
02:000397E0 0C030080        	  3518:     cmpi.b  #$80,D3
02:000397E4 6502            	  3519:     bcs  _anon_z04_52
02:000397E6 7060            	  3520:     moveq   #96,D0
                            	  3521: _anon_z04_52:
02:000397E8 41EC03BC        	  3522:     lea     ($03BC,A4),A0
02:000397EC 11802000        	  3523:     move.b  D0,(A0,D2.W)
                            	  3524:     even
                            	  3525: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3526:     ; Facing and input directions down.
                            	  3527:     ;
02:000397F0 7004            	  3528:     moveq   #4,D0
02:000397F2 41EC03F8        	  3529:     lea     ($03F8,A4),A0
02:000397F6 11802000        	  3530:     move.b  D0,(A0,D2.W)
02:000397FA 41EC0098        	  3531:     lea     ($0098,A4),A0
02:000397FE 11802000        	  3532:     move.b  D0,(A0,D2.W)
                            	  3533:     ; Every other frame, return without drawing.
                            	  3534:     ;
02:00039802 10342028        	  3535:     move.b  ($28,A4,D2.W),D0
02:00039806 E208            	  3536:     lsr.b  #1,D0   ; LSR A
02:00039808 6512            	  3537:     bcs  _anon_z04_53
                            	  3538:     ; Finish initializing based on type.
                            	  3539:     ;
02:0003980A 41EC034F        	  3540:     lea     ($034F,A4),A0
02:0003980E 10302000        	  3541:     move.b  (A0,D2.W),D0
02:00039812 0C000022        	  3542:     cmpi.b  #$22,D0
02:00039816 6602            	  3543:     bne.s  __far_z_04_0030
02:00039818 6008            	  3544:     jmp  L_EndInitFlyingGhini
                            	  3545: __far_z_04_0030:
02:0003981A 6158            	  3546:     jsr     DrawArmosAndCheckCollisions
                            	  3547: _anon_z04_53:
02:0003981C 0A3C0001        	  3548:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00039820 4E75            	  3549:     rts
