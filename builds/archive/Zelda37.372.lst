                            	  2952:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  2953:     ; go see if the tile is valid to come out of.
                            	  2954:     ;
                            	  2955:     ; Else it's too close to the top edge of the screen. So, return.
                            	  2956:     ;
02:00039426 0C00005D        	  2957:     cmpi.b  #$5D,D0
