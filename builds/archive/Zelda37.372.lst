02:0003CFC8 41EC04F0        	 11087:     lea     ($04F0,A4),A0
02:0003CFCC 10302000        	 11088:     move.b  (A0,D2.W),D0
02:0003CFD0 41EC04F1        	 11089:     lea     ($04F1,A4),A0
02:0003CFD4 11803000        	 11090:     move.b  D0,(A0,D3.W)
02:0003CFD8 10342070        	 11091:     move.b  ($70,A4,D2.W),D0
02:0003CFDC 19803071        	 11092:     move.b  D0,($71,A4,D3.W)
02:0003CFE0 41EC0084        	 11093:     lea     ($0084,A4),A0
02:0003CFE4 10302000        	 11094:     move.b  (A0,D2.W),D0
02:0003CFE8 41EC0085        	 11095:     lea     ($0085,A4),A0
02:0003CFEC 11803000        	 11096:     move.b  D0,(A0,D3.W)
