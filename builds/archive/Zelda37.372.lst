02:0003CF30 1B00            	 11011:     move.b  D0,-(A5)  ; PHA
                            	 11012:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11013:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11014:     ;
