                            	 11913: Ganon_MoveAndShoot:
                            	 11914:     ; Change the animation frame every screen frame; so that
                            	 11915:     ; when Ganon is hit, he appears in a random pose.
                            	 11916:     ;
02:0003D566 41EC046B        	 11917:     lea     ($046B,A4),A0
02:0003D56A 52302000        	 11918:     addq.b  #1,(A0,D2.W)
                            	 11919:     ; The animation cycle has 6 frames.
                            	 11920:     ;
02:0003D56E 41EC046B        	 11921:     lea     ($046B,A4),A0
02:0003D572 10302000        	 11922:     move.b  (A0,D2.W),D0
02:0003D576 0C000006        	 11923:     cmpi.b  #$06,D0
02:0003D57A 660A            	 11924:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003D57C 7000            	 11925:     moveq   #0,D0
02:0003D57E 41EC046B        	 11926:     lea     ($046B,A4),A0
