02:000393E6 0200000C        	  2922:     andi.b #$0C,D0
02:000393EA 6742            	  2923:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  2924:     ; Begin with the leever's X set to Link's X.
                            	  2925:     ;
