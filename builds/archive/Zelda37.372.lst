                            	  4352: c_animate_and_draw_common_object:
02:0002CCC4 2F02            	  4353:     move.l  D2,-(SP)        ; save D2
02:0002CCC6 2F02            	  4354:     move.l  D2,-(SP)        ; push slot (arg2, pushed first = at SP+4 after jsr)
02:0002CCC8 2F00            	  4355:     move.l  D0,-(SP)        ; push val  (arg1, pushed last  = at SP+8 after jsr)
                            	  4356:     ; wait — GCC right-to-left: arg2 pushed first, arg1 second
                            	  4357:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4358:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4359:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
02:0002CCCA 4EB900000000    	  4360:     jsr     z04_animate_and_draw_common_object
02:0002CCD0 508F            	  4361:     addq.l  #8,SP           ; pop val+slot
02:0002CCD2 241F            	  4362:     move.l  (SP)+,D2        ; restore D2
02:0002CCD4 4E75            	  4363:     rts
