02:00039412 1214            	  2943:     move.b  ($0000,A4),D1
02:00039414 D101            	  2944:     addx.b  D1,D0   ; ADC $00
                            	  2945:     ; Sanitize the Y coordinate:
                            	  2946:     ; (Y AND $F0) OR $D
                            	  2947:     ;
02:00039416 020000F0        	  2948:     andi.b #$F0,D0
02:0003941A 0000000D        	  2949:     ori.b #$0D,D0
02:0003941E 41EC0084        	  2950:     lea     ($0084,A4),A0
