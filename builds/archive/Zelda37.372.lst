02:0003D22C E309            	 11430:     lsl.b  #1,D1   ; ASL $02
02:0003D22E 19410002        	 11431:     move.b  D1,($0002,A4)
02:0003D232 122C0002        	 11432:     move.b  ($0002,A4),D1
02:0003D236 C200            	 11433:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
