02:0003B3D4 D101            	  7388:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003B3D6 41EC0394        	  7389:     lea     ($0394,A4),A0
02:0003B3DA 11802000        	  7390:     move.b  D0,(A0,D2.W)
                            	  7391:     ; Align the monster with a square horizontally.
                            	  7392:     ;
                            	  7393:     ; If in the left half of a square, align with that square.
                            	  7394:     ; If in the right half, align with the next square.
                            	  7395:     ;
02:0003B3DE 10342070        	  7396:     move.b  ($70,A4,D2.W),D0
02:0003B3E2 023C00EE        	  7397:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B3E6 123C0008        	  7398:     move.b  #$08,D1
02:0003B3EA D101            	  7399:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B3EC 020000F0        	  7400:     andi.b #$F0,D0
02:0003B3F0 19802070        	  7401:     move.b  D0,($70,A4,D2.W)
                            	  7402:     ; Align the monster with a square vertically.
                            	  7403:     ;
