02:0003D24A 9101            	 11439:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003D24C 0A3C0010        	 11440:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D250 41EC0084        	 11441:     lea     ($0084,A4),A0
