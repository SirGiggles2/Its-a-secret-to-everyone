                            	  2424:     ; Get the base offset for the kind of jumper the object is.
                            	  2425:     ;
02:0003900E 6100015E        	  2426:     jsr     Jumper_GetKind
02:00039012 41F900038EFE    	  2427:     lea     (JumperYAccelerationBaseOffsets).l,A0
