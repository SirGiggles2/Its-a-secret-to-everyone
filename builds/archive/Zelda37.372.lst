02:00034C98 10303000        	  4710:     move.b  (A0,D3.W),D0
02:00034C9C 41EC0302        	  4711:     lea     ($0302,A4),A0
02:00034CA0 11803000        	  4712:     move.b  D0,(A0,D3.W)
02:00034CA4 5303            	  4713:     subq.b  #1,D3
