                            	 11754: UpdateGanon:
02:0003D488 102C0445        	 11755:     move.b  ($0445,A4),D0
02:0003D48C 4EB90002AECA    	 11756:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	 11757:     even
                            	 11758: UpdateGanon_JumpTable:
02:0003D492 0003D49E        	 11759:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003D496 0003D500        	 11760:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003D49A 0003D52E        	 11761:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 11762: 
                            	 11763: ; Description:
                            	 11764: ; Lift up the Triforce of Courage while the room is dark.
                            	 11765: ;
                            	 11766: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 11767: ;
                            	 11768:     even
                            	 11769: Ganon_ScenePhase0:
02:0003D49E 701B            	 11770:     moveq   #27,D0
02:0003D4A0 19400505        	 11771:     move.b  D0,($0505,A4)
                            	 11772:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 11773:     ;
02:0003D4A4 102C0028        	 11774:     move.b  ($0028,A4),D0
02:0003D4A8 6644            	 11775:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 11776:     ; Once the timer expires, it's time to brighten the room.
                            	 11777:     ;
                            	 11778:     ; Save the current object slot.
02:0003D4AA 1002            	 11779:     move.b  D2,D0
02:0003D4AC 1B00            	 11780:     move.b  D0,-(A5)  ; PHA
02:0003D4AE 610007F0        	 11781:     jsr     UpdateCandle
02:0003D4B2 101D            	 11782:     move.b  (A5)+,D0  ; PLA
02:0003D4B4 7400            	 11783:     moveq   #0,D2
02:0003D4B6 1400            	 11784:     move.b  D0,D2
                            	 11785:     ; Turn off the room brightening flag, because we're controlling it
                            	 11786:     ; here instead of in the Mode 5 object update loop.
                            	 11787:     ;
02:0003D4B8 7000            	 11788:     moveq   #0,D0
02:0003D4BA 1940051E        	 11789:     move.b  D0,($051E,A4)
                            	 11790:     ; On the first frame of the fade-to-light cycle, play the
                            	 11791:     ; Triforce/Ganon song.
                            	 11792:     ;
02:0003D4BE 102C051C        	 11793:     move.b  ($051C,A4),D0
02:0003D4C2 0C0000C0        	 11794:     cmpi.b  #$C0,D0
02:0003D4C6 6606            	 11795:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003D4C8 7002            	 11796:     moveq   #2,D0
02:0003D4CA 19400600        	 11797:     move.b  D0,($0600,A4)
                            	 11798:     even
                            	 11799: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 11800:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 11801:     ;
02:0003D4CE 102C051C        	 11802:     move.b  ($051C,A4),D0
02:0003D4D2 0200000F        	 11803:     andi.b #$0F,D0
02:0003D4D6 0C000004        	 11804:     cmpi.b  #$04,D0
02:0003D4DA 6702            	 11805:     beq.s  __far_z_04_0113
02:0003D4DC 6042            	 11806:     jmp  Ganon_DrawBodyFrame0
                            	 11807: __far_z_04_0113:
                            	 11808:     ; Set Link's timer to $C0 for the next scene phase.
                            	 11809:     ;
02:0003D4DE 103C00C0        	 11810:     move.b  #$C0,D0
02:0003D4E2 19400028        	 11811:     move.b  D0,($0028,A4)
                            	 11812:     ; Set scene phase 1, and go draw Ganon.
                            	 11813:     ;
02:0003D4E6 522C0445        	 11814:     addq.b  #1,($0445,A4)
02:0003D4EA 6702            	 11815:     beq.s  __far_z_04_0114
02:0003D4EC 6032            	 11816:     jmp  Ganon_DrawBodyFrame0
                            	 11817: __far_z_04_0114:
                            	 11818:     even
                            	 11819: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	 11820:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	 11821:     ; In this case, I think it means Ganon is shouting.
