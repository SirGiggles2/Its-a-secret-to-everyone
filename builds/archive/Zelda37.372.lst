                            	   270: 
                            	   271: InitCaveContinue:
                            	   272:     ; Get this cave's index (object type - $6A).
                            	   273:     ;
02:0002ECDC 102C0350        	   274:     move.b  ($0350,A4),D0
02:0002ECE0 003C0011        	   275:     ori     #$11,CCR  ; SEC: set C+X
02:0002ECE4 123C006A        	   276:     move.b  #$6A,D1
02:0002ECE8 0A3C0010        	   277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002ECEC 9101            	   278:     subx.b  D1,D0   ; SBC #$6A
02:0002ECEE 0A3C0010        	   279:     eori    #$10,CCR  ; restore X = 6502 C
02:0002ECF2 7600            	   280:     moveq   #0,D3
02:0002ECF4 1600            	   281:     move.b  D0,D3
                            	   282:     ; Get the person text selector by looking up the text selector byte
                            	   283:     ; for this index, and masking it with $3F.
                            	   284:     ;
02:0002ECF6 41F90002ECA6    	   285:     lea     (OverworldPersonTextSelectors).l,A0
02:0002ECFC 10303000        	   286:     move.b  (A0,D3.W),D0
02:0002ED00 1B00            	   287:     move.b  D0,-(A5)  ; PHA
02:0002ED02 0200003F        	   288:     andi.b #$3F,D0
02:0002ED06 19400415        	   289:     move.b  D0,($0415,A4)
                            	   290:     ; Pop and mask the text selector byte with $C0 to get the
                            	   291:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   292:     ;
02:0002ED0A 101D            	   293:     move.b  (A5)+,D0  ; PLA
02:0002ED0C 020000C0        	   294:     andi.b #$C0,D0
02:0002ED10 19400003        	   295:     move.b  D0,($0003,A4)
                            	   296:     ; At this point, the Y register still has the cave index.
                            	   297:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   298:     ;
02:0002ED14 103C00FD        	   299:     move.b  #$FD,D0
                            	   300: _anon_z01_0:
02:0002ED18 023C00EE        	   301:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002ED1C 123C0003        	   302:     move.b  #$03,D1
02:0002ED20 D101            	   303:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002ED22 5303            	   304:     subq.b  #1,D3
02:0002ED24 6AF2            	   305:     bpl  _anon_z01_0
02:0002ED26 7600            	   306:     moveq   #0,D3
02:0002ED28 1600            	   307:     move.b  D0,D3
                            	   308:     ; Loop over the wares from 0 to 2.
                            	   309:     ;
02:0002ED2A 7400            	   310:     moveq   #0,D2
                            	   311:     even
                            	   312: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   313:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   314:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   315:     ;
02:0002ED2C 41F900FF6A7E    	   316:     lea     (NES_SRAM+$0A7E).l,A0
02:0002ED32 10303000        	   317:     move.b  (A0,D3.W),D0
02:0002ED36 41EC0422        	   318:     lea     ($0422,A4),A0
02:0002ED3A 11802000        	   319:     move.b  D0,(A0,D2.W)
                            	   320:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   321:     ;
02:0002ED3E 020000C0        	   322:     andi.b #$C0,D0
02:0002ED42 19802000        	   323:     move.b  D0,($00,A4,D2.W)
                            	   324:     ; Copy 3 prices from the Cave level block info.
                            	   325:     ;
02:0002ED46 41F900FF6ABA    	   326:     lea     (NES_SRAM+$0ABA).l,A0
02:0002ED4C 10303000        	   327:     move.b  (A0,D3.W),D0
02:0002ED50 41EC0430        	   328:     lea     ($0430,A4),A0
02:0002ED54 11802000        	   329:     move.b  D0,(A0,D2.W)
                            	   330:     ; Bottom of the wares copying loop.
                            	   331:     ;
02:0002ED58 5203            	   332:     addq.b  #1,D3
02:0002ED5A 5202            	   333:     addq.b  #1,D2
02:0002ED5C 0C020003        	   334:     cmpi.b  #$03,D2
02:0002ED60 66CA            	   335:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   336:     ; Get the top 2 bits of text selector byte in [03],
                            	   337:     ; shift them to the bottom, and combine them with [00].
                            	   338:     ;
02:0002ED62 102C0003        	   339:     move.b  ($0003,A4),D0
02:0002ED66 E308            	   340:     lsl.b  #1,D0   ; ASL A
02:0002ED68 E310            	   341:     roxl.b  #1,D0   ; ROL A
02:0002ED6A E310            	   342:     roxl.b  #1,D0   ; ROL A
02:0002ED6C 1214            	   343:     move.b  ($0000,A4),D1
02:0002ED6E 8001            	   344:     or.b  D1,D0
02:0002ED70 1880            	   345:     move.b  D0,($0000,A4)
                            	   346:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   347:     ; and combine them with [00].
                            	   348:     ;
02:0002ED72 102C0002        	   349:     move.b  ($0002,A4),D0
02:0002ED76 E208            	   350:     lsr.b  #1,D0   ; LSR A
02:0002ED78 E208            	   351:     lsr.b  #1,D0   ; LSR A
02:0002ED7A E208            	   352:     lsr.b  #1,D0   ; LSR A
02:0002ED7C E208            	   353:     lsr.b  #1,D0   ; LSR A
02:0002ED7E 1214            	   354:     move.b  ($0000,A4),D1
02:0002ED80 8001            	   355:     or.b  D1,D0
02:0002ED82 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   358:     ; and combine them with [00] into CaveFlags.
                            	   359:     ;
02:0002ED84 102C0001        	   360:     move.b  ($0001,A4),D0
02:0002ED88 E208            	   361:     lsr.b  #1,D0   ; LSR A
02:0002ED8A E208            	   362:     lsr.b  #1,D0   ; LSR A
02:0002ED8C 1214            	   363:     move.b  ($0000,A4),D1
02:0002ED8E 8001            	   364:     or.b  D1,D0
02:0002ED90 19400413        	   365:     move.b  D0,($0413,A4)
                            	   366:     ; The end result is a byte with 8 cave flags.
                            	   367:     ;
                            	   368:     ; If cave flag "money game" is missing, then go finish up,
                            	   369:     ; instead of choosing random amounts for the money game.
                            	   370:     ;
02:0002ED94 02000020        	   371:     andi.b #$20,D0
02:0002ED98 6700009E        	   372:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   373:     ; Determine an index randomly with increasing probability,
                            	   374:     ; from 6 to 1. Start with the following test:
                            	   375:     ;
                            	   376:     ;   If $FF < Random, then go use index 6.
                            	   377:     ;
02:0002ED9C 103C00FF        	   378:     move.b  #$FF,D0
02:0002EDA0 7606            	   379:     moveq   #6,D3
                            	   380:     even
                            	   381: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002EDA2 122C0019        	   382:     move.b  ($0019,A4),D1
02:0002EDA6 B001            	   383:     cmp.b   D1,D0
02:0002EDA8 6516            	   384:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   385:     ; If the test fails, then subtract $2B from the reference number.
                            	   386:     ;
02:0002EDAA 003C0011        	   387:     ori     #$11,CCR  ; SEC: set C+X
02:0002EDAE 123C002B        	   388:     move.b  #$2B,D1
02:0002EDB2 0A3C0010        	   389:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EDB6 9101            	   390:     subx.b  D1,D0   ; SBC #$2B
02:0002EDB8 0A3C0010        	   391:     eori    #$10,CCR  ; restore X = 6502 C
02:0002EDBC 5303            	   392:     subq.b  #1,D3
02:0002EDBE 66E2            	   393:     bne  _L_z01_InitCaveContinue_ChoosePermutation
