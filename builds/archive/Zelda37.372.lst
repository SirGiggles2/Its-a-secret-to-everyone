                            	  1059:     ; PATCHED (P8): Replace broken NES indirect-pointer text lookup with
                            	  1060:     ; direct M68K addressing. DemoLineTextAddrs contains word offsets.
02:000326AA 102C042E        	  1061:     move.b  ($042E,A4),D0
02:000326AE 024000FF        	  1062:     andi.w  #$00FF,D0
02:000326B2 E348            	  1063:     lsl.w   #1,D0                ; * 2 for word-sized offset table
02:000326B4 41F900032426    	  1064:     lea     (DemoLineTextAddrs).l,A0
02:000326BA 30300000        	  1065:     move.w  (A0,D0.W),D0        ; D0.w = offset into DemoTextFields
02:000326BE 41F900032212    	  1066:     lea     (DemoTextFields).l,A0
02:000326C4 D0C0            	  1067:     adda.w  D0,A0               ; A0 -> text field entry in ROM
02:000326C6 7600            	  1068:     moveq   #0,D3               ; Y index into text field
02:000326C8 10303000        	  1069:     move.b  (A0,D3.W),D0        ; first byte = column offset
02:000326CC 7400            	  1070:     moveq   #0,D2
