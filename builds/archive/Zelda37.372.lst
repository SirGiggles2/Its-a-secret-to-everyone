                            	  5573: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:00041820 122C0002        	  5574:     move.b  ($02,A4),D1   ; ptr lo
02:00041824 182C0003        	  5575:     move.b  ($03,A4),D4  ; ptr hi
02:00041828 024100FF        	  5576:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004182C E14C            	  5577:     lsl.w   #8,D4
02:0004182E 8841            	  5578:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041830 48C4            	  5579:     ext.l   D4
02:00041832 D8BC00FF0000    	  5580:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041838 2044            	  5581:     movea.l D4,A0
02:0004183A 10303000        	  5582:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004183E 1214            	  5583:     move.b  ($00,A4),D1   ; ptr lo
02:00041840 182C0001        	  5584:     move.b  ($01,A4),D4  ; ptr hi
02:00041844 024100FF        	  5585:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041848 E14C            	  5586:     lsl.w   #8,D4
02:0004184A 8841            	  5587:     or.w    D1,D4
02:0004184C 48C4            	  5588:     ext.l   D4
02:0004184E D8BC00FF0000    	  5589:     add.l   #NES_RAM,D4
02:00041854 2044            	  5590:     movea.l D4,A0
02:00041856 11803000        	  5591:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:0004185A 4EB9000305CA    	  5592:     jsr     Add1ToInt16At2
02:00041860 41F9000416F4    	  5593:     lea     (NextDoorTileOffsets).l,A0
02:00041866 10302000        	  5594:     move.b  (A0,D2.W),D0
02:0004186A 4EB9000305C6    	  5595:     jsr     AddToInt16At0
                            	  5596:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5597:     ; go 1 more tile down, to start the next column at the right place.
                            	  5598:     ; We have to compensate for the fact that E/W doors are 
                            	  5599:     ; shorter vertically than N/S doors.
02:00041870 4A02            	  5600:     cmpi.b  #$00,D2
02:00041872 6610            	  5601:     bne  _anon_z05_115
02:00041874 101D            	  5602:     move.b  (A5)+,D0  ; PLA
02:00041876 1B00            	  5603:     move.b  D0,-(A5)  ; PHA
02:00041878 0C000002        	  5604:     cmpi.b  #$02,D0
02:0004187C 6406            	  5605:     bcc  _anon_z05_115
02:0004187E 4EB9000305C2    	  5606:     jsr     Add1ToInt16At0
