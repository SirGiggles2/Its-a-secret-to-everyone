                            	  2085:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  2086:     ;
02:00038DEE 6728            	  2087:     beq  _L_z04__TryShooting_SetSpeed
                            	  2088:     ; shoot timer <> 0
                            	  2089:     ; If shoot timer <> $10, then go set a zero speed.
