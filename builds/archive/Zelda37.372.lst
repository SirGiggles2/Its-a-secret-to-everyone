                            	  6928: _L_z04_Dodongo_Draw_DrawFaded:
                            	  6929:     ; In bloated substates 2 and 3:
                            	  6930:     ; Every two screen frames, don't draw for two frames. Return.
                            	  6931:     ;
02:0003B03E 102C0015        	  6932:     move.b  ($0015,A4),D0
02:0003B042 02000002        	  6933:     andi.b #$02,D0
02:0003B046 6604            	  6934:     bne.s  __far_z_04_0064
02:0003B048 600000A4        	  6935:     jmp  L11B00_Exit
                            	  6936: __far_z_04_0064:
02:0003B04C 7600            	  6937:     moveq   #0,D3
02:0003B04E 1614            	  6938:     move.b  ($0000,A4),D3
02:0003B050 601E            	  6939:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  6940: 
                            	  6941:     even
                            	  6942: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  6943:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  6944:     ;
02:0003B052 7008            	  6945:     moveq   #8,D0
                            	  6946:     even
                            	  6947: _L_z04_Dodongo_Draw_DrawWalking:
02:0003B054 7600            	  6948:     moveq   #0,D3
02:0003B056 1614            	  6949:     move.b  ($0000,A4),D3
02:0003B058 122C0015        	  6950:     move.b  ($0015,A4),D1
02:0003B05C C001            	  6951:     and.b  D1,D0
02:0003B05E 6710            	  6952:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  6953:     ; For animation frame 1, add 5 to the index in Y register,
                            	  6954:     ; in order to index into the second set of frame image numbers.
                            	  6955:     ;
02:0003B060 1003            	  6956:     move.b  D3,D0
02:0003B062 023C00EE        	  6957:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B066 123C0005        	  6958:     move.b  #$05,D1
02:0003B06A D101            	  6959:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003B06C 7600            	  6960:     moveq   #0,D3
02:0003B06E 1600            	  6961:     move.b  D0,D3
                            	  6962:     even
                            	  6963: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  6964:     ; Start preparing sprites.
                            	  6965:     ;
02:0003B070 4EB90004AFFA    	  6966:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B076 1003            	  6967:     move.b  D3,D0
02:0003B078 1B00            	  6968:     move.b  D0,-(A5)  ; PHA
                            	  6969:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  6970:     ;
02:0003B07A 41F90003AFD4    	  6971:     lea     (DodongoFrameHFlips).l,A0
02:0003B080 10303000        	  6972:     move.b  (A0,D3.W),D0
02:0003B084 1940000F        	  6973:     move.b  D0,($000F,A4)
02:0003B088 41F90003AFCA    	  6974:     lea     (DodongoFrameImages).l,A0
02:0003B08E 10303000        	  6975:     move.b  (A0,D3.W),D0
                            	  6976:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  6977:     ; They are drawn mirrored.
                            	  6978:     ;
02:0003B092 0C000007        	  6979:     cmpi.b  #$07,D0
02:0003B096 6706            	  6980:     beq  _anon_z04_92
02:0003B098 0C000009        	  6981:     cmpi.b  #$09,D0
02:0003B09C 6608            	  6982:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  6983: _anon_z04_92:
02:0003B09E 4EB90003090E    	  6984:     jsr     DrawObjectMirrored
02:0003B0A4 6006            	  6985:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  6986: 
