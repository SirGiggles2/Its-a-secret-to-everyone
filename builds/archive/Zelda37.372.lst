02:00038FC4 41EC0444        	  2384:     lea     ($0444,A4),A0
02:00038FC8 11802000        	  2385:     move.b  D0,(A0,D2.W)
                            	  2386:     ; Set the starting speed, depending on the object type.
                            	  2387:     ;
