                            	  1868: CheckZora:
                            	  1869:     ; If the zora attribute of this room is off, return.
                            	  1870:     ;
02:00038C8C 7600            	  1871:     moveq   #0,D3
02:00038C8E 162C00EB        	  1872:     move.b  ($00EB,A4),D3
02:00038C92 41F900FF687E    	  1873:     lea     (NES_SRAM+$087E).l,A0
02:00038C98 10303000        	  1874:     move.b  (A0,D3.W),D0
02:00038C9C 02000008        	  1875:     andi.b #$08,D0
02:00038CA0 677C            	  1876:     beq  _L_z04_CheckZora_Exit
                            	  1877:     ; If zora is active, return.
                            	  1878:     ;
02:00038CA2 102C0514        	  1879:     move.b  ($0514,A4),D0
02:00038CA6 6676            	  1880:     bne  _L_z04_CheckZora_Exit
                            	  1881:     ; Look for an empty monster slot. If none is found, return.
                            	  1882:     ;
02:00038CA8 4EB90004B7E2    	  1883:     jsr     FindEmptyMonsterSlot
02:00038CAE 676E            	  1884:     beq  _L_z04_CheckZora_Exit
                            	  1885:     ; Loop $D times looking for a water tile to put a zora on.
                            	  1886:     ; Indexed by [0D].
                            	  1887:     ;
02:00038CB0 700D            	  1888:     moveq   #13,D0
02:00038CB2 1940000D        	  1889:     move.b  D0,($000D,A4)
                            	  1890:     ; Switch to the new object slot.
                            	  1891:     ;
02:00038CB6 7400            	  1892:     moveq   #0,D2
02:00038CB8 142C0059        	  1893:     move.b  ($0059,A4),D2
                            	  1894:     even
                            	  1895: _L_z04_CheckZora_LoopTileCandidate:
                            	  1896:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  1897:     ; If it = 0 or $F0, go loop again.
                            	  1898:     ;
02:00038CBC 7600            	  1899:     moveq   #0,D3
02:00038CBE 162C000D        	  1900:     move.b  ($000D,A4),D3
02:00038CC2 10343018        	  1901:     move.b  ($18,A4,D3.W),D0
02:00038CC6 020000F0        	  1902:     andi.b #$F0,D0
02:00038CCA 19802070        	  1903:     move.b  D0,($70,A4,D2.W)
02:00038CCE 6748            	  1904:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038CD0 0C0000F0        	  1905:     cmpi.b  #$F0,D0
02:00038CD4 6742            	  1906:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1907:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1908:     ; If it < $50 or >= $E0, go loop again.
                            	  1909:     ;
02:00038CD6 10343018        	  1910:     move.b  ($18,A4,D3.W),D0
02:00038CDA E308            	  1911:     lsl.b  #1,D0   ; ASL A
02:00038CDC E308            	  1912:     lsl.b  #1,D0   ; ASL A
02:00038CDE E308            	  1913:     lsl.b  #1,D0   ; ASL A
02:00038CE0 E308            	  1914:     lsl.b  #1,D0   ; ASL A
02:00038CE2 0C000050        	  1915:     cmpi.b  #$50,D0
02:00038CE6 6530            	  1916:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038CE8 0C0000E0        	  1917:     cmpi.b  #$E0,D0
02:00038CEC 642A            	  1918:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1919:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1920:     ;
02:00038CEE 0000000D        	  1921:     ori.b #$0D,D0
02:00038CF2 41EC0084        	  1922:     lea     ($0084,A4),A0
02:00038CF6 11802000        	  1923:     move.b  D0,(A0,D2.W)
                            	  1924:     ; Get the tile at that location.
                            	  1925:     ; If it's not a water tile, then go loop again.
                            	  1926:     ;
02:00038CFA 4EB90004993A    	  1927:     jsr     GetCollidableTileStill
02:00038D00 0C00008D        	  1928:     cmpi.b  #$8D,D0
02:00038D04 6512            	  1929:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038D06 0C000099        	  1930:     cmpi.b  #$99,D0
02:00038D0A 640C            	  1931:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1932:     ; Flag the zora active, and set up the object.
                            	  1933:     ;
02:00038D0C 522C0514        	  1934:     addq.b  #1,($0514,A4)
02:00038D10 7011            	  1935:     moveq   #17,D0
02:00038D12 4EF90004B7DC    	  1936:     jmp     SetTypeAndClearObject
                            	  1937: 
                            	  1938:     even
                            	  1939: _L_z04_CheckZora_NextLoopTileCandidate:
                            	  1940:     ; Bottom of the loop. Keep going until loop index [0D] = 0.
                            	  1941:     ;
02:00038D18 532C000D        	  1942:     subq.b  #1,($000D,A4)
02:00038D1C 669E            	  1943:     bne  _L_z04_CheckZora_LoopTileCandidate
                            	  1944:     even
