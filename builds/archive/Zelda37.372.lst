                            	 12340: Ganon_CheckCollisions:
                            	 12341:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12342:     ; Store in [02] and [03].
                            	 12343:     ;
02:0003D894 10342070        	 12344:     move.b  ($70,A4,D2.W),D0
02:0003D898 023C00EE        	 12345:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D89C 123C0010        	 12346:     move.b  #$10,D1
02:0003D8A0 D101            	 12347:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D8A2 19400002        	 12348:     move.b  D0,($0002,A4)
02:0003D8A6 41EC0084        	 12349:     lea     ($0084,A4),A0
02:0003D8AA 10302000        	 12350:     move.b  (A0,D2.W),D0
02:0003D8AE 023C00EE        	 12351:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D8B2 123C0010        	 12352:     move.b  #$10,D1
02:0003D8B6 D101            	 12353:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D8B8 19400003        	 12354:     move.b  D0,($0003,A4)
                            	 12355:     ; Check for a collision with Link.
                            	 12356:     ;
                            	 12357:     ; We can't call CheckLinkCollision, because we need to
                            	 12358:     ; customize Ganon's midpoint.
                            	 12359:     ;
                            	 12360:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12361:     ; detection, if Link is invincible. Initialize variables that will
                            	 12362:     ; be returned from the partial collision check routine. Then
                            	 12363:     ; call it.
                            	 12364:     ;
02:0003D8BC 102C04F0        	 12365:     move.b  ($04F0,A4),D0
02:0003D8C0 6616            	 12366:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003D8C2 19400006        	 12367:     move.b  D0,($0006,A4)
02:0003D8C6 19400009        	 12368:     move.b  D0,($0009,A4)
02:0003D8CA 1940000C        	 12369:     move.b  D0,($000C,A4)
02:0003D8CE 7600            	 12370:     moveq   #0,D3
02:0003D8D0 1883            	 12371:     move.b  D3,($0000,A4)
02:0003D8D2 4EB900030CE8    	 12372:     jsr     CheckLinkCollisionPreinit
                            	 12373:     even
                            	 12374: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12375:     ; If Ganon is not in state 0, then he's brown.
                            	 12376:     ; Go check collision with an arrow.
                            	 12377:     ;
02:0003D8D8 41EC00AC        	 12378:     lea     ($00AC,A4),A0
02:0003D8DC 10302000        	 12379:     move.b  (A0,D2.W),D0
02:0003D8E0 6652            	 12380:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12381:     ; If timer <> 0, then Ganon is visible.
                            	 12382:     ; He can't be harmed like this. So, return.
                            	 12383:     ;
02:0003D8E2 10342028        	 12384:     move.b  ($28,A4,D2.W),D0
02:0003D8E6 664A            	 12385:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003D8E8 760D            	 12386:     moveq   #13,D3
02:0003D8EA 4EB900030D22    	 12387:     jsr     CheckMonsterSwordCollision
                            	 12388:     ; If Ganon has died according to the usual collision check rules
                            	 12389:     ; (HP = 0), then:
                            	 12390:     ; 1. Restore HP to the initial value $F0
                            	 12391:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12392:     ; 3. Change palette row 7 to make Ganon brown
                            	 12393:     ;
02:0003D8F0 41EC0405        	 12394:     lea     ($0405,A4),A0
02:0003D8F4 10302000        	 12395:     move.b  (A0,D2.W),D0
02:0003D8F8 6718            	 12396:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003D8FA 103C00F0        	 12397:     move.b  #$F0,D0
02:0003D8FE 41EC0485        	 12398:     lea     ($0485,A4),A0
02:0003D902 11802000        	 12399:     move.b  D0,(A0,D2.W)
02:0003D906 41EC00AC        	 12400:     lea     ($00AC,A4),A0
02:0003D90A 53302000        	 12401:     subq.b  #1,(A0,D2.W)
02:0003D90E 61000084        	 12402:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12403:     even
                            	 12404: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12405:     ; If Ganon was harmed, then play the sound effect
                            	 12406:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12407:     ;
02:0003D912 41EC04F0        	 12408:     lea     ($04F0,A4),A0
02:0003D916 10302000        	 12409:     move.b  (A0,D2.W),D0
02:0003D91A 670A            	 12410:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003D91C 6100A792        	 12411:     jsr     PlayBossHitCryIfNeeded
02:0003D920 7040            	 12412:     moveq   #64,D0
02:0003D922 19802028        	 12413:     move.b  D0,($28,A4,D2.W)
                            	 12414:     even
                            	 12415: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12416:     ; Reset metastate, because Ganon cannot die this way.
                            	 12417:     ;
02:0003D926 4EB90004B7FA    	 12418:     jsr     ResetObjMetastate
                            	 12419:     ; Reset shove info and invincibility timer, because Ganon
                            	 12420:     ; doesn't react at all as a usual monster.
                            	 12421:     ;
02:0003D92C 4EB900030D10    	 12422:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12423:     even
                            	 12424: _L_z04_Ganon_CheckCollisions_Exit:
02:0003D932 4E75            	 12425:     rts
                            	 12426: 
                            	 12427:     even
                            	 12428: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12429:     ; If the silver arrow is not in the inventory, then return.
                            	 12430:     ;
02:0003D934 102C0659        	 12431:     move.b  ($0659,A4),D0
02:0003D938 0C000002        	 12432:     cmpi.b  #$02,D0
02:0003D93C 66F4            	 12433:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12434:     ; Reset the collision return value [06].
                            	 12435:     ;
02:0003D93E 7000            	 12436:     moveq   #0,D0
02:0003D940 19400006        	 12437:     move.b  D0,($0006,A4)
                            	 12438:     ; If there's no arrow in flight, then return.
                            	 12439:     ;
02:0003D944 7612            	 12440:     moveq   #18,D3
02:0003D946 41EC00AC        	 12441:     lea     ($00AC,A4),A0
02:0003D94A 10303000        	 12442:     move.b  (A0,D3.W),D0
02:0003D94E 0C000010        	 12443:     cmpi.b  #$10,D0
02:0003D952 66DE            	 12444:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12445:     ; Check for collision with an arrow; and return if no collision.
                            	 12446:     ;
02:0003D954 4EB900030D2A    	 12447:     jsr     CheckMonsterArrowOrRodCollision
02:0003D95A 102C0006        	 12448:     move.b  ($0006,A4),D0
02:0003D95E 67D2            	 12449:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 12450:     ; Set the Ganon phase to "dying".
                            	 12451:     ;
02:0003D960 41EC042C        	 12452:     lea     ($042C,A4),A0
02:0003D964 52302000        	 12453:     addq.b  #1,(A0,D2.W)
                            	 12454:     ; Now his body does flash.
                            	 12455:     ;
02:0003D968 7028            	 12456:     moveq   #40,D0
02:0003D96A 41EC04F0        	 12457:     lea     ($04F0,A4),A0
02:0003D96E 11802000        	 12458:     move.b  D0,(A0,D2.W)
                            	 12459:     ; Set initial cloud distance 8.
                            	 12460:     ;
02:0003D972 7008            	 12461:     moveq   #8,D0
02:0003D974 41EC0478        	 12462:     lea     ($0478,A4),A0
02:0003D978 11802000        	 12463:     move.b  D0,(A0,D2.W)
02:0003D97C 0A3C0001        	 12464:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D980 4E75            	 12465:     rts
                            	 12466: 
                            	 12467:     even
