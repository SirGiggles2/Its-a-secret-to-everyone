02:000394AC 122C034A        	  3033:     move.b  ($034A,A4),D1
02:000394B0 B001            	  3034:     cmp.b   D1,D0
02:000394B2 6400FF78        	  3035:     bcc  _L_z04_UpdateRedLeever_Exit
02:000394B6 522C0510        	  3036:     addq.b  #1,($0510,A4)
                            	  3037:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3038:     ; and pick up whatever the new value is for state 1.
                            	  3039:     ;
02:000394BA 7001            	  3040:     moveq   #1,D0
02:000394BC 41EC03D0        	  3041:     lea     ($03D0,A4),A0
02:000394C0 11802000        	  3042:     move.b  D0,(A0,D2.W)
                            	  3043:     ; Set the long timer to 2, meaning 20 frames.
                            	  3044:     ;
02:000394C4 E308            	  3045:     lsl.b  #1,D0   ; ASL A
02:000394C6 1940004D        	  3046:     move.b  D0,($004D,A4)
02:000394CA 6100008C        	  3047:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3048:     ; The leever has to face Link in order to move toward him.
                            	  3049:     ;
02:000394CE 4EB900049EEC    	  3050:     jsr     ReverseObjDir
                            	  3051:     even
                            	  3052: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  3053:     ; If not in state 3, go check the object timer in order to draw and such.
