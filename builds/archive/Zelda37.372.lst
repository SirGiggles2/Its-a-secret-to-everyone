02:0002C8FC 08000008        	  3816:     btst    #8,D0
02:0002C900 6706            	  3817:     beq.s   .cc_aqspf
02:0002C902 003C0011        	  3818:     ori     #$11,CCR
02:0002C906 4E75            	  3819:     rts
                            	  3820: .cc_aqspf:
02:0002C908 023C00EE        	  3821:     andi    #$EE,CCR
02:0002C90C 4E75            	  3822:     rts
