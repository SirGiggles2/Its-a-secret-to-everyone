02:0003A36A 02000007        	  5110:     andi.b #$07,D0
02:0003A36E 7600            	  5111:     moveq   #0,D3
02:0003A370 1600            	  5112:     move.b  D0,D3
02:0003A372 41F90003DD4A    	  5113:     lea     (Directions8).l,A0
02:0003A378 10303000        	  5114:     move.b  (A0,D3.W),D0
02:0003A37C 1940009D        	  5115:     move.b  D0,($009D,A4)
02:0003A380 19400385        	  5116:     move.b  D0,($0385,A4)
02:0003A384 102C0022        	  5117:     move.b  ($0022,A4),D0
02:0003A388 02000007        	  5118:     andi.b #$07,D0
02:0003A38C 7600            	  5119:     moveq   #0,D3
02:0003A38E 1600            	  5120:     move.b  D0,D3
02:0003A390 41F90003DD4A    	  5121:     lea     (Directions8).l,A0
02:0003A396 10303000        	  5122:     move.b  (A0,D3.W),D0
02:0003A39A 194000A2        	  5123:     move.b  D0,($00A2,A4)
02:0003A39E 1940038A        	  5124:     move.b  D0,($038A,A4)
                            	  5125:     ; Set minimum number of turns 1 for flying states.
