02:0003B3B2 7600            	  7377:     moveq   #0,D3
02:0003B3B4 1600            	  7378:     move.b  D0,D3
02:0003B3B6 41F90003B1C6    	  7379:     lea     (PolsVoiceDirections).l,A0
02:0003B3BC 10303000        	  7380:     move.b  (A0,D3.W),D0
02:0003B3C0 41EC0098        	  7381:     lea     ($0098,A4),A0
02:0003B3C4 11802000        	  7382:     move.b  D0,(A0,D2.W)
                            	  7383:     ; Randomly set distance-to-move to $30 or $70.
