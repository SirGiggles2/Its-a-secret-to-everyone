02:0004019C 020000F8        	  3873:     andi.b #$F8,D0
02:000401A0 1214            	  3874:     move.b  ($00,A4),D1   ; ptr lo
02:000401A2 182C0001        	  3875:     move.b  ($01,A4),D4  ; ptr hi
02:000401A6 024100FF        	  3876:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000401AA E14C            	  3877:     lsl.w   #8,D4
02:000401AC 8841            	  3878:     or.w    D1,D4
02:000401AE 48C4            	  3879:     ext.l   D4
