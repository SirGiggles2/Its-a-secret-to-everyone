                            	  1573: ZolGelDelays:
02:00038AA6 18              	  1574:     dc.b    $18, $28, $38, $48, $08, $18, $28, $38
02:00038AA7 28
02:00038AA8 38
02:00038AA9 48
02:00038AAA 08
02:00038AAB 18
02:00038AAC 28
02:00038AAD 38
                            	  1575: 
                            	  1576: ; Returns:
                            	  1577: ; C: 1 if blocked
                            	  1578: ;
                            	  1579: ; Set the speed to maximum.
                            	  1580: ;
                            	  1581:     even
                            	  1582: Gel_MoveSplitting:
02:00038AAE 103C00FF        	  1583:     move.b  #$FF,D0
02:00038AB2 41EC03BC        	  1584:     lea     ($03BC,A4),A0
02:00038AB6 11802000        	  1585:     move.b  D0,(A0,D2.W)
                            	  1586:     ; Set moving direction to facing direction.
                            	  1587:     ;
02:00038ABA 41EC0098        	  1588:     lea     ($0098,A4),A0
02:00038ABE 10302000        	  1589:     move.b  (A0,D2.W),D0
02:00038AC2 1940000F        	  1590:     move.b  D0,($000F,A4)
                            	  1591:     ; If at a tile boundary, then check for a tile collision.
                            	  1592:     ;
02:00038AC6 41EC0394        	  1593:     lea     ($0394,A4),A0
02:00038ACA 10302000        	  1594:     move.b  (A0,D2.W),D0
02:00038ACE 660E            	  1595:     bne  _L_z04_Gel_MoveSplitting_CheckRoomBoundary
02:00038AD0 4EB900049940    	  1596:     jsr     GetCollidingTileMoving
                            	  1597:     ; If blocked by a tile, then return C=1.
                            	  1598:     ;
02:00038AD6 122C034A        	  1599:     move.b  ($034A,A4),D1
02:00038ADA B001            	  1600:     cmp.b   D1,D0
02:00038ADC 642C            	  1601:     bcc  _L_z04_Gel_MoveSplitting_Exit
                            	  1602:     even
                            	  1603: _L_z04_Gel_MoveSplitting_CheckRoomBoundary:
                            	  1604:     ; If blocked by the room boundary, then return C=1.
                            	  1605:     ;
02:00038ADE 4EB900030532    	  1606:     jsr     BoundByRoom
