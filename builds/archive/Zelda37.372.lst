                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:0004A3C8 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004A3CA 19400003        	  5123:     move.b  D0,($0003,A4)
02:0004A3CE 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004A3D0 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:0004A3D4 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:0004A3D6 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:0004A3D8 7600            	  5136:     moveq   #0,D3
02:0004A3DA 1600            	  5137:     move.b  D0,D3
02:0004A3DC 0C030001        	  5138:     cmpi.b  #$01,D3
02:0004A3E0 6602            	  5139:     bne  _anon_z07_25
02:0004A3E2 7603            	  5140:     moveq   #3,D3
