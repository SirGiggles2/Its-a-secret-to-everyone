02:0003958C 41EC03BC        	  3148:     lea     ($03BC,A4),A0
02:00039590 11802000        	  3149:     move.b  D0,(A0,D2.W)
02:00039594 41F900039398    	  3150:     lea     (RedLeeverStateTimes).l,A0
