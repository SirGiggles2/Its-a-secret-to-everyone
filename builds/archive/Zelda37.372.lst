02:0003D034 02000007        	 11137:     andi.b #$07,D0
02:0003D038 6702            	 11138:     beq.s  __far_z_04_0111
02:0003D03A 60D8            	 11139:     jmp  L12A6F_Exit
                            	 11140: __far_z_04_0111:
                            	 11141:     ; Will loop 4 times, propagating directions down the chain,
                            	 11142:     ; by pulling from the bottom.
                            	 11143:     ;
02:0003D03C 7004            	 11144:     moveq   #4,D0
02:0003D03E 1880            	 11145:     move.b  D0,($0000,A4)
                            	 11146:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11147:     ;
02:0003D040 7600            	 11148:     moveq   #0,D3
02:0003D042 0C020005        	 11149:     cmpi.b  #$05,D2
02:0003D046 6702            	 11150:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003D048 7605            	 11151:     moveq   #5,D3
                            	 11152:     even
                            	 11153: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11154:     ; Loop over every segment under the head, starting from the tail.
                            	 11155:     ; Copy the next segment's direction to the current one in this loop.
                            	 11156:     ;
02:0003D04A 41EC009A        	 11157:     lea     ($009A,A4),A0
02:0003D04E 10303000        	 11158:     move.b  (A0,D3.W),D0
02:0003D052 41EC0099        	 11159:     lea     ($0099,A4),A0
02:0003D056 11803000        	 11160:     move.b  D0,(A0,D3.W)
02:0003D05A 5203            	 11161:     addq.b  #1,D3
02:0003D05C 5314            	 11162:     subq.b  #1,($0000,A4)
02:0003D05E 66EA            	 11163:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11164:     ; If this head segment is not aligned with a square, then return.
                            	 11165:     ;
02:0003D060 10342070        	 11166:     move.b  ($70,A4,D2.W),D0
02:0003D064 0200000F        	 11167:     andi.b #$0F,D0
02:0003D068 660000BA        	 11168:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11169:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11170:     ; We had to account for the usual offset of 3.
                            	 11171:     ;
02:0003D06C 41EC0084        	 11172:     lea     ($0084,A4),A0
02:0003D070 10302000        	 11173:     move.b  (A0,D2.W),D0
02:0003D074 023C00EE        	 11174:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D078 123C0003        	 11175:     move.b  #$03,D1
02:0003D07C D101            	 11176:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003D07E 0200000F        	 11177:     andi.b #$0F,D0
02:0003D082 660000A0        	 11178:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11179:     ; Store the opposite of the facing direction in [00].
                            	 11180:     ;
02:0003D086 41EC0098        	 11181:     lea     ($0098,A4),A0
02:0003D08A 10302000        	 11182:     move.b  (A0,D2.W),D0
02:0003D08E E208            	 11183:     lsr.b  #1,D0   ; LSR A
02:0003D090 02000005        	 11184:     andi.b #$05,D0
02:0003D094 1880            	 11185:     move.b  D0,($0000,A4)
02:0003D096 41EC0098        	 11186:     lea     ($0098,A4),A0
02:0003D09A 10302000        	 11187:     move.b  (A0,D2.W),D0
02:0003D09E E308            	 11188:     lsl.b  #1,D0   ; ASL A
02:0003D0A0 0200000A        	 11189:     andi.b #$0A,D0
02:0003D0A4 1214            	 11190:     move.b  ($0000,A4),D1
02:0003D0A6 8001            	 11191:     or.b  D1,D0
                            	 11192:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11193:     ;
02:0003D0A8 0A00000F        	 11194:     eori.b #$0F,D0
02:0003D0AC 1940050F        	 11195:     move.b  D0,($050F,A4)
                            	 11196:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11197:     ;
02:0003D0B0 10342018        	 11198:     move.b  ($18,A4,D2.W),D0
02:0003D0B4 0C000080        	 11199:     cmpi.b  #$80,D0
02:0003D0B8 656C            	 11200:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11201:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11202:     ; Load the monster's facing direction.
                            	 11203:     ;
02:0003D0BA 41EC0098        	 11204:     lea     ($0098,A4),A0
02:0003D0BE 10302000        	 11205:     move.b  (A0,D2.W),D0
                            	 11206:     ; Load the next random number into Y register.
                            	 11207:     ;
02:0003D0C2 7600            	 11208:     moveq   #0,D3
02:0003D0C4 16342019        	 11209:     move.b  ($19,A4,D2.W),D3
                            	 11210:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11211:     ; to keep moving straight.
                            	 11212:     ;
02:0003D0C8 0C030080        	 11213:     cmpi.b  #$80,D3
02:0003D0CC 6418            	 11214:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11215:     even
                            	 11216: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11217:     ; Loop to rotate the direction bit over the mask.
                            	 11218:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11219:     ; facing direction.
                            	 11220:     ;
                            	 11221:     ; Shift right the copy of the direction.
                            	 11222:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11223:     ;
02:0003D0CE E208            	 11224:     lsr.b  #1,D0   ; LSR A
02:0003D0D0 6402            	 11225:     bcc  _anon_z04_151
02:0003D0D2 7008            	 11226:     moveq   #8,D0
                            	 11227: _anon_z04_151:
                            	 11228:     ; If the current direction bit is masked off, then we've reached
                            	 11229:     ; the opposite direction. Loop again.
                            	 11230:     ;
02:0003D0D4 122C050F        	 11231:     move.b  ($050F,A4),D1
02:0003D0D8 C200            	 11232:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D0DA 67F2            	 11233:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11234:     ; If Y register >= $40, then break out of the loop.
                            	 11235:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11236:     ;
02:0003D0DC 0C030040        	 11237:     cmpi.b  #$40,D3
02:0003D0E0 6404            	 11238:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11239:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11240:     ; and loop again now.
                            	 11241:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11242:     ;
02:0003D0E2 7640            	 11243:     moveq   #64,D3
02:0003D0E4 65E8            	 11244:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11245:     even
                            	 11246: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11247:     ; Change the facing direction to the direction found.
                            	 11248:     ;
02:0003D0E6 41EC0098        	 11249:     lea     ($0098,A4),A0
02:0003D0EA 11802000        	 11250:     move.b  D0,(A0,D2.W)
                            	 11251:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11252:     ;
02:0003D0EE 1940000F        	 11253:     move.b  D0,($000F,A4)
02:0003D0F2 4EB900030532    	 11254:     jsr     BoundByRoom
                            	 11255:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11256:     ;
02:0003D0F8 102C000F        	 11257:     move.b  ($000F,A4),D0
02:0003D0FC 6618            	 11258:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11259:     even
                            	 11260: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11261:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11262:     ; for looking for any non-opposite direction that is not blocked.
                            	 11263:     ;
02:0003D0FE 41EC0098        	 11264:     lea     ($0098,A4),A0
02:0003D102 10302000        	 11265:     move.b  (A0,D2.W),D0
                            	 11266:     even
                            	 11267: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11268:     ; Shift right the copy of the direction.
                            	 11269:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11270:     ;
02:0003D106 E208            	 11271:     lsr.b  #1,D0   ; LSR A
02:0003D108 6402            	 11272:     bcc  _anon_z04_152
02:0003D10A 7008            	 11273:     moveq   #8,D0
                            	 11274: _anon_z04_152:
                            	 11275:     ; If the current direction bit is not masked off, then go check the
                            	 11276:     ; room boundary in this direction.
                            	 11277:     ; Else we've reached the opposite direction. Loop again.
                            	 11278:     ;
02:0003D10C 122C050F        	 11279:     move.b  ($050F,A4),D1
02:0003D110 C200            	 11280:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D112 66D2            	 11281:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003D114 67F0            	 11282:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11283:     even
                            	 11284: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11285:     ; We found a direction that was not blocked by the room boundary.
                            	 11286:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11287:     ;
02:0003D116 4EB900049940    	 11288:     jsr     GetCollidingTileMoving
02:0003D11C 122C034A        	 11289:     move.b  ($034A,A4),D1
02:0003D120 B001            	 11290:     cmp.b   D1,D0
02:0003D122 64DA            	 11291:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11292:     even
                            	 11293: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11294:     ; TODO: confirm this
                            	 11295:     ;
                            	 11296:     ; If there were a room that had lamnolas, and they could get
                            	 11297:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11298:     ; an infinite loop.
                            	 11299:     ;
                            	 11300:     ; But, the only room with that configuration has those blocks
                            	 11301:     ; blocked off with a push block, which can only be pushed after
                            	 11302:     ; all monsters are killed.
                            	 11303:     ;
02:0003D124 4E75            	 11304:     rts
                            	 11305: 
                            	 11306:     even
                            	 11307: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11308:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11309:     ;
02:0003D126 7001            	 11310:     moveq   #1,D0
02:0003D128 19400002        	 11311:     move.b  D0,($0002,A4)
02:0003D12C 102C0070        	 11312:     move.b  ($0070,A4),D0
02:0003D130 003C0011        	 11313:     ori     #$11,CCR  ; SEC: set C+X
02:0003D134 12342070        	 11314:     move.b  ($70,A4,D2.W),D1
02:0003D138 0A3C0010        	 11315:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D13C 9101            	 11316:     subx.b  D1,D0   ; SBC ObjX,X
02:0003D13E 0A3C0010        	 11317:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D142 640A            	 11318:     bcc  _anon_z04_153
02:0003D144 122C0002        	 11319:     move.b  ($0002,A4),D1
02:0003D148 E309            	 11320:     lsl.b  #1,D1   ; ASL $02
02:0003D14A 19410002        	 11321:     move.b  D1,($0002,A4)
                            	 11322: _anon_z04_153:
                            	 11323:     ; Find the vertical direction toward Link and store it in [03].
                            	 11324:     ;
02:0003D14E 7004            	 11325:     moveq   #4,D0
02:0003D150 19400003        	 11326:     move.b  D0,($0003,A4)
02:0003D154 102C0084        	 11327:     move.b  ($0084,A4),D0
02:0003D158 003C0011        	 11328:     ori     #$11,CCR  ; SEC: set C+X
02:0003D15C 41EC0084        	 11329:     lea     ($0084,A4),A0
02:0003D160 12302000        	 11330:     move.b  (A0,D2.W),D1
02:0003D164 0A3C0010        	 11331:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D168 9101            	 11332:     subx.b  D1,D0   ; SBC ObjY,X
02:0003D16A 0A3C0010        	 11333:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D16E 640A            	 11334:     bcc  _anon_z04_154
02:0003D170 122C0003        	 11335:     move.b  ($0003,A4),D1
02:0003D174 E309            	 11336:     lsl.b  #1,D1   ; ASL $03
02:0003D176 19410003        	 11337:     move.b  D1,($0003,A4)
                            	 11338: _anon_z04_154:
                            	 11339:     ; If the horizontal direction toward Link is not allowed, then
                            	 11340:     ; go check the vertical direction.
                            	 11341:     ;
02:0003D17A 102C0002        	 11342:     move.b  ($0002,A4),D0
02:0003D17E 122C050F        	 11343:     move.b  ($050F,A4),D1
02:0003D182 C200            	 11344:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D184 6708            	 11345:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11346:     ; If the horizontal direction toward Link is the same direction
                            	 11347:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11348:     ;
02:0003D186 122C0098        	 11349:     move.b  ($0098,A4),D1
02:0003D18A C200            	 11350:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D18C 6604            	 11351:     bne  _anon_z04_155
                            	 11352:     even
                            	 11353: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 11354:     ; Load the vertical direction toward Link in order to test it for
                            	 11355:     ; room boundary and tile collision.
                            	 11356:     ;
02:0003D18E 102C0003        	 11357:     move.b  ($0003,A4),D0
                            	 11358: _anon_z04_155:
                            	 11359:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 11360:     ;
02:0003D192 6000FF52        	 11361:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11362: 
                            	 11363:     even
                            	 11364: Lamnola_Move:
                            	 11365:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 11366:     ;
                            	 11367:     ; Change coordinates by the appropriate speed according to the direction.
                            	 11368:     ;
                            	 11369:     ; Start with a mask of $A1 in [02]:
                            	 11370:     ; - low nibble represents the right direction
                            	 11371:     ; - high nibble is used to set or clear carry as we go along
                            	 11372:     ;
02:0003D196 103C00A1        	 11373:     move.b  #$A1,D0
02:0003D19A 19400002        	 11374:     move.b  D0,($0002,A4)
                            	 11375:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 11376:     ;
02:0003D19E 41EC0098        	 11377:     lea     ($0098,A4),A0
02:0003D1A2 10302000        	 11378:     move.b  (A0,D2.W),D0
02:0003D1A6 122C0002        	 11379:     move.b  ($0002,A4),D1
02:0003D1AA C200            	 11380:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D1AC 6712            	 11381:     beq  _L_z04_Lamnola_Move_Left
02:0003D1AE 10342070        	 11382:     move.b  ($70,A4,D2.W),D0
02:0003D1B2 023C00EE        	 11383:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D1B6 122C04E6        	 11384:     move.b  ($04E6,A4),D1
02:0003D1BA D101            	 11385:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003D1BC 19802070        	 11386:     move.b  D0,($70,A4,D2.W)
                            	 11387:     even
                            	 11388: _L_z04_Lamnola_Move_Left:
                            	 11389:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	 11390:     ;
02:0003D1C0 41EC0098        	 11391:     lea     ($0098,A4),A0
02:0003D1C4 10302000        	 11392:     move.b  (A0,D2.W),D0
02:0003D1C8 122C0002        	 11393:     move.b  ($0002,A4),D1
02:0003D1CC E309            	 11394:     lsl.b  #1,D1   ; ASL $02
02:0003D1CE 19410002        	 11395:     move.b  D1,($0002,A4)
02:0003D1D2 122C0002        	 11396:     move.b  ($0002,A4),D1
02:0003D1D6 C200            	 11397:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D1D8 6716            	 11398:     beq  _L_z04_Lamnola_Move_Down
02:0003D1DA 10342070        	 11399:     move.b  ($70,A4,D2.W),D0
02:0003D1DE 122C04E6        	 11400:     move.b  ($04E6,A4),D1
02:0003D1E2 0A3C0010        	 11401:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D1E6 9101            	 11402:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003D1E8 0A3C0010        	 11403:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D1EC 19802070        	 11404:     move.b  D0,($70,A4,D2.W)
                            	 11405:     even
                            	 11406: _L_z04_Lamnola_Move_Down:
