02:0004A3EE 123C0001        	  5145:     move.b  #$01,D1
02:0004A3F2 D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004A3F4 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
