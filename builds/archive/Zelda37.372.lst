                            	   918: 
                            	   919: ;------------------------------------------------------------------------------
                            	   920: ; _c_move_object_shim — MoveObject trampoline.
                            	   921: ;
                            	   922: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   923: ;   Input:     D2 = slot (0..11)
                            	   924: ;   Preserves: D2, A4, A5
                            	   925: ;   Clobbers:  D0, D1, D3, A0
                            	   926: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   927: ;
                            	   928: ; GCC side:
                            	   929: ;   void c_move_object(unsigned short slot);
                            	   930: ;     slot arrives as a 16-bit value on the stack.
                            	   931: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   932: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   933: ;   never clobbered by gcc.
                            	   934: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   935: ;   semantics can exist in a pure C port).
                            	   936: ;------------------------------------------------------------------------------
                            	   937: _c_move_object_shim:
                            	   938:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   939:     move.b  #$AA,($0900,A4)
                            	   940:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   941:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   942:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   943:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   944:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   945:     moveq   #0,D0
02:0002B658 3002            	   946:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   947:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   948:     jsr     c_move_object
02:0002B662 588F            	   949:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   950:     rts
                            	   951: 
                            	   952: ;==============================================================================
                            	   953: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   954: ; and tail-call the native asm function.
                            	   955: ;
                            	   956: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   957: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   958: ; sign-extended).
                            	   959: ;==============================================================================
                            	   960: 
                            	   961: ;------------------------------------------------------------------------------
                            	   962: ; void c_copy_bank_to_window(unsigned int bank);
                            	   963: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   964: ;------------------------------------------------------------------------------
                            	   965: c_copy_bank_to_window:
02:0002B666 202F0004        	   966:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   967:     jmp     _copy_bank_to_window
                            	   968: 
                            	   969: ;------------------------------------------------------------------------------
                            	   970: ; unsigned char c_ppu_read_2(void);
                            	   971: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   972: ; C return: gcc expects result in D0.
                            	   973: ;------------------------------------------------------------------------------
                            	   974: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   975:     jmp     _ppu_read_2
                            	   976: 
                            	   977: ;------------------------------------------------------------------------------
                            	   978: ; void c_ppu_write_6(unsigned int val);
                            	   979: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   980: ;------------------------------------------------------------------------------
                            	   981: c_ppu_write_6:
02:0002B674 202F0004        	   982:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   983:     jmp     _ppu_write_6
                            	   984: 
                            	   985: ;------------------------------------------------------------------------------
                            	   986: ; void c_ppu_write_7(unsigned int val);
                            	   987: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   988: ;------------------------------------------------------------------------------
                            	   989: c_ppu_write_7:
02:0002B67E 202F0004        	   990:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   991:     jmp     _ppu_write_7
                            	   992: 
                            	   993: ;------------------------------------------------------------------------------
                            	   994: ; void c_turn_off_all_video(void);
                            	   995: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   996: ;------------------------------------------------------------------------------
                            	   997: c_turn_off_all_video:
02:0002B688 4EF900048C4A    	   998:     jmp     TurnOffAllVideo
                            	   999: 
                            	  1000: ;==============================================================================
                            	  1001: ; EXPORT side — z_03 entry point.
                            	  1002: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1003: ; the transpiler emits that label pointing to this shim instead of the
                            	  1004: ; z_03 asm body. The C function takes no args and returns void.
                            	  1005: ;==============================================================================
                            	  1006: 
                            	  1007: ;------------------------------------------------------------------------------
                            	  1008: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1009: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1010: ;------------------------------------------------------------------------------
                            	  1011: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1012:     jmp     z03_transfer_level_pattern_blocks
                            	  1013: 
                            	  1014: ;==============================================================================
                            	  1015: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1016: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1017: ;==============================================================================
                            	  1018: 
                            	  1019: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1020:     jmp     z06_init_mode2_submodes
                            	  1021: 
                            	  1022: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1023:     jmp     z06_copy_common_data_to_ram
                            	  1024: 
                            	  1025: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1026:     jmp     z06_update_mode2_load_full
                            	  1027: 
                            	  1028: ;==============================================================================
                            	  1029: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1030: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1031: ;==============================================================================
                            	  1032: 
                            	  1033: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	  1034:     jmp     z05_copy_column_to_tilebuf
                            	  1035: 
                            	  1036: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	  1037:     jmp     z05_copy_row_to_tilebuf
                            	  1038: 
                            	  1039: ;==============================================================================
                            	  1040: ; EXPORT side — z_05 entry points (Stage 4a).
                            	  1041: ;==============================================================================
                            	  1042: 
                            	  1043: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	  1044: c_has_compass:
02:0002B6B2 4EB900000000    	  1045:     jsr     z05_has_compass
02:0002B6B8 4A00            	  1046:     tst.b   D0
02:0002B6BA 4E75            	  1047:     rts
                            	  1048: 
                            	  1049: c_has_map:
02:0002B6BC 4EB900000000    	  1050:     jsr     z05_has_map
02:0002B6C2 4A00            	  1051:     tst.b   D0
02:0002B6C4 4E75            	  1052:     rts
                            	  1053: 
                            	  1054: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
