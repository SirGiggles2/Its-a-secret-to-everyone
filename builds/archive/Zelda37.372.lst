                            	  7368:     ;
02:0003B39A 41EC0444        	  7369:     lea     ($0444,A4),A0
02:0003B39E 11802000        	  7370:     move.b  D0,(A0,D2.W)
02:0003B3A2 41EC0412        	  7371:     lea     ($0412,A4),A0
02:0003B3A6 11802000        	  7372:     move.b  D0,(A0,D2.W)
                            	  7373:     ; Choose a random direction to face in.
