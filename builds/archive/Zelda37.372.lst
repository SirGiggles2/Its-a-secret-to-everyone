02:0003D69C 19803072        	 12093:     move.b  D0,($72,A4,D3.W)
02:0003D6A0 41EC0084        	 12094:     lea     ($0084,A4),A0
02:0003D6A4 10302000        	 12095:     move.b  (A0,D2.W),D0
02:0003D6A8 123C0004        	 12096:     move.b  #$04,D1
02:0003D6AC D101            	 12097:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003D6AE 41EC0086        	 12098:     lea     ($0086,A4),A0
02:0003D6B2 11803000        	 12099:     move.b  D0,(A0,D3.W)
                            	 12100:     ; Set the direction.
