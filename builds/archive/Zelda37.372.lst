                            	  5530:     ; including clearing object type.
                            	  5531:     ;
02:0004A678 0C02000D        	  5532:     cmpi.b  #$0D,D2
02:0004A67C 6406            	  5533:     bcc  _anon_z07_29
02:0004A67E 4EB900038698    	  5534:     jsr     DestroyCountedMonsterShot
