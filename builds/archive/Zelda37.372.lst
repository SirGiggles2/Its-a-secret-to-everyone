02:0003E3F4 102C00FB        	   409:     move.b  ($00FB,A4),D0
02:0003E3F8 02000088        	   410:     andi.b #$88,D0
02:0003E3FC 0C000088        	   411:     cmpi.b  #$88,D0
02:0003E400 661A            	   412:     bne  _anon_z05_3
02:0003E402 4EB9000495B6    	   413:     jsr     EndGameMode
02:0003E408 194000E1        	   414:     move.b  D0,($00E1,A4)
02:0003E40C 7008            	   415:     moveq   #8,D0
02:0003E40E 19400012        	   416:     move.b  D0,($0012,A4)
02:0003E412 7000            	   417:     moveq   #0,D0
02:0003E414 19400619        	   418:     move.b  D0,($0619,A4)
02:0003E418 600012CE        	   419:     jmp     SilenceSound
