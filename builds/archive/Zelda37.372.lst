                            	  6692: Dodongo_TryEatBomb:
                            	  6693:     ; Try to eat the bomb.
                            	  6694:     ;
                            	  6695:     ; If the bomb is not in range of the monster, then return.
                            	  6696:     ;
                            	  6697:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  6698:     ;
02:0003AEF6 7601            	  6699:     moveq   #1,D3
02:0003AEF8 616E            	  6700:     jsr     Dodongo_IsBombInRange
02:0003AEFA 6666            	  6701:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  6702:     ; Will loop from 1 to 0, indexed by [00].
                            	  6703:     ;
02:0003AEFC 7001            	  6704:     moveq   #1,D0
02:0003AEFE 1880            	  6705:     move.b  D0,($0000,A4)
                            	  6706:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  6707:     ;
02:0003AF00 41EC0098        	  6708:     lea     ($0098,A4),A0
02:0003AF04 10302000        	  6709:     move.b  (A0,D2.W),D0
02:0003AF08 E208            	  6710:     lsr.b  #1,D0   ; LSR A
02:0003AF0A 7600            	  6711:     moveq   #0,D3
02:0003AF0C 1600            	  6712:     move.b  D0,D3
                            	  6713:     ; Now we have to see if it's near the mouth. But the mouth
                            	  6714:     ; position depends on the orientation of the monster.
                            	  6715:     ;
                            	  6716:     ; Start with the horizontal distance.
                            	  6717:     ;
02:0003AF0E 102C0004        	  6718:     move.b  ($0004,A4),D0
                            	  6719:     even
                            	  6720: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  6721:     ; Look up the limits for the given direction.
                            	  6722:     ;
                            	  6723:     ; If the distance from the bomb < negative limit,
                            	  6724:     ; or >= positive limit, then return.
                            	  6725:     ;
                            	  6726:     ; Note that these are simple signed comparisons that work,
                            	  6727:     ; because the operands are in a small range.
                            	  6728:     ;
02:0003AF12 41F90003AE4C    	  6729:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003AF18 12303000        	  6730:     move.b  (A0,D3.W),D1
02:0003AF1C B001            	  6731:     cmp.b   D1,D0
02:0003AF1E 6B42            	  6732:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003AF20 41F90003AE52    	  6733:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003AF26 12303000        	  6734:     move.b  (A0,D3.W),D1
02:0003AF2A B001            	  6735:     cmp.b   D1,D0
02:0003AF2C 6A34            	  6736:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  6737:     ; Add $A to the index to look into the second set for vertical limits.
                            	  6738:     ;
02:0003AF2E 1003            	  6739:     move.b  D3,D0
02:0003AF30 023C00EE        	  6740:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AF34 123C000A        	  6741:     move.b  #$0A,D1
02:0003AF38 D101            	  6742:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003AF3A 7600            	  6743:     moveq   #0,D3
02:0003AF3C 1600            	  6744:     move.b  D0,D3
                            	  6745:     ; Bottom of the loop.
                            	  6746:     ;
                            	  6747:     ; Load the vertical distance for the next iteration.
                            	  6748:     ; Decrement loop counter.
                            	  6749:     ;
02:0003AF3E 102C0005        	  6750:     move.b  ($0005,A4),D0
02:0003AF42 5314            	  6751:     subq.b  #1,($0000,A4)
02:0003AF44 6ACC            	  6752:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  6753:     ; If we get here, then the bomb was within range of the mouth.
                            	  6754:     ; Go to state 1 (bloated).
                            	  6755:     ;
02:0003AF46 41EC00AC        	  6756:     lea     ($00AC,A4),A0
02:0003AF4A 52302000        	  6757:     addq.b  #1,(A0,D2.W)
                            	  6758:     ; Deactivate the bomb, and reset the bloated substate.
                            	  6759:     ;
02:0003AF4E 7610            	  6760:     moveq   #16,D3
02:0003AF50 7000            	  6761:     moveq   #0,D0
02:0003AF52 41EC00AC        	  6762:     lea     ($00AC,A4),A0
02:0003AF56 11803000        	  6763:     move.b  D0,(A0,D3.W)
02:0003AF5A 41EC042C        	  6764:     lea     ($042C,A4),A0
02:0003AF5E 11802000        	  6765:     move.b  D0,(A0,D2.W)
                            	  6766:     even
                            	  6767: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003AF62 4E75            	  6768:     rts
