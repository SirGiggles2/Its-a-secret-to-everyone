02:00039AAE 41F900039A30    	  3941:     lea     (RockPushDirections).l,A0
02:00039AB4 12303000        	  3942:     move.b  (A0,D3.W),D1
02:00039AB8 B001            	  3943:     cmp.b   D1,D0
02:00039ABA 6628            	  3944:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  3945:     ; Set it to the object's direction. Go to the next state.
                            	  3946:     ;
02:00039ABC 41EC0098        	  3947:     lea     ($0098,A4),A0
02:00039AC0 11802000        	  3948:     move.b  D0,(A0,D2.W)
02:00039AC4 41EC00AC        	  3949:     lea     ($00AC,A4),A0
02:00039AC8 52302000        	  3950:     addq.b  #1,(A0,D2.W)
                            	  3951:     ; Store current room ID.
                            	  3952:     ;
02:00039ACC 102C00EB        	  3953:     move.b  ($00EB,A4),D0
02:00039AD0 41EC0412        	  3954:     lea     ($0412,A4),A0
02:00039AD4 11802000        	  3955:     move.b  D0,(A0,D2.W)
