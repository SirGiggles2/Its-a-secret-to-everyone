02:0003E42C 102C0254        	   430:     move.b  ($0254,A4),D0
02:0003E430 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0003E432 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003E436 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003E438 4EB900048BFA    	   434:     jsr     HideAllSprites
02:0003E43E 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0003E440 19400258        	   436:     move.b  D0,($0258,A4)
02:0003E444 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:0003E446 19400254        	   438:     move.b  D0,($0254,A4)
02:0003E44A 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0003E44E 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003E452 4E75            	   441:     rts
