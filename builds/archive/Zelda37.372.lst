02:00034F08 102C050B        	  4997:     move.b  ($050B,A4),D0
02:00034F0C 123C0008        	  4998:     move.b  #$08,D1
02:00034F10 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F14 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:00034F16 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
