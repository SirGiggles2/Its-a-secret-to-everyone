02:000426CA 9101            	  7233:     subx.b  D1,D0   ; SBC #$40
02:000426CC 0A3C0010        	  7234:     eori    #$10,CCR  ; restore X = 6502 C
02:000426D0 E208            	  7235:     lsr.b  #1,D0   ; LSR A
02:000426D2 E208            	  7236:     lsr.b  #1,D0   ; LSR A
02:000426D4 E208            	  7237:     lsr.b  #1,D0   ; LSR A
