                            	  9159:     even
                            	  9160: UpdateGohma:
                            	  9161:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9162:     ;
02:0003C11E 41EC0451        	  9163:     lea     ($0451,A4),A0
02:0003C122 10302000        	  9164:     move.b  (A0,D2.W),D0
02:0003C126 662C            	  9165:     bne  _L_z04_UpdateGohma_Move
                            	  9166:     ; If Random:
                            	  9167:     ;   >= $B0: right
                            	  9168:     ;   >= $60: left
                            	  9169:     ;   Else:   down
                            	  9170:     ;
02:0003C128 7001            	  9171:     moveq   #1,D0
02:0003C12A 7600            	  9172:     moveq   #0,D3
02:0003C12C 16342018        	  9173:     move.b  ($18,A4,D2.W),D3
02:0003C130 0C0300B0        	  9174:     cmpi.b  #$B0,D3
02:0003C134 640A            	  9175:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003C136 E308            	  9176:     lsl.b  #1,D0   ; ASL A
02:0003C138 0C030060        	  9177:     cmpi.b  #$60,D3
02:0003C13C 6402            	  9178:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003C13E E308            	  9179:     lsl.b  #1,D0   ; ASL A
                            	  9180:     even
