02:0002BF88 08000008        	  2468:     btst    #8,D0
02:0002BF8C 670A            	  2469:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2470:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2471:     eori    #$01,CCR
02:0002BF96 4E75            	  2472:     rts
                            	  2473: .cc_cnr:
02:0002BF98 023C00FE        	  2474:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2475:     eori    #$01,CCR
02:0002BFA0 4E75            	  2476:     rts
