02:000393D8 4EB900049EEC    	  2916:     jsr     ReverseObjDir
                            	  2917: _anon_z04_43:
                            	  2918:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  2919:     ;
02:000393DE 41EC0098        	  2920:     lea     ($0098,A4),A0
