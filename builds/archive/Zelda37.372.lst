                            	  3564: UpdateArmos:
02:0003983A 6100EA0A        	  3565:     jsr     UpdateGoriya
                            	  3566:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3567:     ;
02:0003983E 41EC00C0        	  3568:     lea     ($00C0,A4),A0
02:00039842 10302000        	  3569:     move.b  (A0,D2.W),D0
02:00039846 6702            	  3570:     beq.s  __far_z_04_0031
02:00039848 602A            	  3571:     jmp  DrawArmosAndCheckCollisions
                            	  3572: __far_z_04_0031:
                            	  3573:     ; Animate.
                            	  3574:     ;
                            	  3575:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3576:     ; then only go draw.
                            	  3577:     ;
02:0003984A 41EC03D0        	  3578:     lea     ($03D0,A4),A0
02:0003984E 53302000        	  3579:     subq.b  #1,(A0,D2.W)
02:00039852 6702            	  3580:     beq.s  __far_z_04_0032
02:00039854 601E            	  3581:     jmp  DrawArmosAndCheckCollisions
                            	  3582: __far_z_04_0032:
                            	  3583:     ; Armos animation frames last 6 screen frames.
                            	  3584:     ;
02:00039856 7006            	  3585:     moveq   #6,D0
02:00039858 41EC03D0        	  3586:     lea     ($03D0,A4),A0
02:0003985C 11802000        	  3587:     move.b  D0,(A0,D2.W)
                            	  3588:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3589:     ; change the position of the shield. To keep fixed it in place,
                            	  3590:     ; there are separate frame images for each animation frame.
                            	  3591:     ;
                            	  3592:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3593:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3594:     ;
                            	  3595:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3596:     ; Then choose the direction at the point of drawing below.
                            	  3597:     ;
02:00039860 41EC03E4        	  3598:     lea     ($03E4,A4),A0
02:00039864 10302000        	  3599:     move.b  (A0,D2.W),D0
02:00039868 0A000002        	  3600:     eori.b #$02,D0
02:0003986C 41EC03E4        	  3601:     lea     ($03E4,A4),A0
02:00039870 11802000        	  3602:     move.b  D0,(A0,D2.W)
                            	  3603:     even
                            	  3604: DrawArmosAndCheckCollisions:
02:00039874 4EB90004AFFA    	  3605:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003987A 7600            	  3606:     moveq   #0,D3
02:0003987C 41EC0098        	  3607:     lea     ($0098,A4),A0
02:00039880 16302000        	  3608:     move.b  (A0,D2.W),D3
                            	  3609:     ; If facing up, then use the second frame image in the set ("back").
                            	  3610:     ; Else use the second.
                            	  3611:     ;
02:00039884 0C030008        	  3612:     cmpi.b  #$08,D3
02:00039888 6602            	  3613:     bne  _anon_z04_54
02:0003988A 7001            	  3614:     moveq   #1,D0
                            	  3615: _anon_z04_54:
02:0003988C 023C00EE        	  3616:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039890 41EC03E4        	  3617:     lea     ($03E4,A4),A0
02:00039894 12302000        	  3618:     move.b  (A0,D2.W),D1
02:00039898 D101            	  3619:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003989A 4EB900030912    	  3620:     jsr     DrawObjectNotMirrored
                            	  3621:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3622:     ; but not with weapons.
                            	  3623:     ;
02:000398A0 10342028        	  3624:     move.b  ($28,A4,D2.W),D0
02:000398A4 661C            	  3625:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3626:     ; Else check for all collisions.
                            	  3627:     ;
02:000398A6 4EB900030C7E    	  3628:     jsr     CheckMonsterCollisions
                            	  3629:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3630:     ;
02:000398AC 41EC0405        	  3631:     lea     ($0405,A4),A0
02:000398B0 10302000        	  3632:     move.b  (A0,D2.W),D0
02:000398B4 670A            	  3633:     beq  _anon_z04_55
02:000398B6 705D            	  3634:     moveq   #93,D0
02:000398B8 41EC034F        	  3635:     lea     ($034F,A4),A0
02:000398BC 11802000        	  3636:     move.b  D0,(A0,D2.W)
