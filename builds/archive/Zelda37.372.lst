                            	 11073: _L_z04_UpdateLamnola_FindTail:
02:0003CFB0 5203            	 11074:     addq.b  #1,D3
02:0003CFB2 41EC0350        	 11075:     lea     ($0350,A4),A0
02:0003CFB6 10303000        	 11076:     move.b  (A0,D3.W),D0
02:0003CFBA 122C04E7        	 11077:     move.b  ($04E7,A4),D1
