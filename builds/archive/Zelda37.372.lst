                            	  6616: Dodongo_CheckBombHit:
                            	  6617:     ; If state <> 0 (not moving), then return.
                            	  6618:     ;
02:0003AE64 41EC00AC        	  6619:     lea     ($00AC,A4),A0
02:0003AE68 10302000        	  6620:     move.b  (A0,D2.W),D0
02:0003AE6C 66000086        	  6621:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  6622:     ; If facing vertically, then store (X + 8) in [00].
                            	  6623:     ; Else store (X + $10).
                            	  6624:     ;
02:0003AE70 10342070        	  6625:     move.b  ($70,A4,D2.W),D0
02:0003AE74 023C00EE        	  6626:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE78 123C0008        	  6627:     move.b  #$08,D1
02:0003AE7C D101            	  6628:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AE7E 7600            	  6629:     moveq   #0,D3
02:0003AE80 41EC0098        	  6630:     lea     ($0098,A4),A0
02:0003AE84 16302000        	  6631:     move.b  (A0,D2.W),D3
02:0003AE88 0C030004        	  6632:     cmpi.b  #$04,D3
02:0003AE8C 6406            	  6633:     bcc  _anon_z04_91
02:0003AE8E 123C0008        	  6634:     move.b  #$08,D1
02:0003AE92 D101            	  6635:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6636: _anon_z04_91:
02:0003AE94 1880            	  6637:     move.b  D0,($0000,A4)
                            	  6638:     ; Store (Y + 8) in [01].
                            	  6639:     ;
02:0003AE96 41EC0084        	  6640:     lea     ($0084,A4),A0
02:0003AE9A 10302000        	  6641:     move.b  (A0,D2.W),D0
02:0003AE9E 123C0008        	  6642:     move.b  #$08,D1
02:0003AEA2 D101            	  6643:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AEA4 19400001        	  6644:     move.b  D0,($0001,A4)
                            	  6645:     ; Only check the first bomb slot ($10).
                            	  6646:     ;
                            	  6647:     ; Store the bomb's (X + 8) in [02].
                            	  6648:     ;
02:0003AEA8 7610            	  6649:     moveq   #16,D3
02:0003AEAA 10343070        	  6650:     move.b  ($70,A4,D3.W),D0
02:0003AEAE 123C0008        	  6651:     move.b  #$08,D1
02:0003AEB2 D101            	  6652:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AEB4 19400002        	  6653:     move.b  D0,($0002,A4)
                            	  6654:     ; Store the bomb's (Y + 8) in [03].
                            	  6655:     ;
02:0003AEB8 41EC0084        	  6656:     lea     ($0084,A4),A0
02:0003AEBC 10303000        	  6657:     move.b  (A0,D3.W),D0
02:0003AEC0 123C0008        	  6658:     move.b  #$08,D1
02:0003AEC4 D101            	  6659:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AEC6 19400003        	  6660:     move.b  D0,($0003,A4)
                            	  6661:     ; But, if there's no bomb, then return.
                            	  6662:     ;
02:0003AECA 41EC00AC        	  6663:     lea     ($00AC,A4),A0
02:0003AECE 10303000        	  6664:     move.b  (A0,D3.W),D0
02:0003AED2 6720            	  6665:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  6666:     ; If the bomb has not exploded (state $12), then
                            	  6667:     ; go see if Dodongo will eat it.
                            	  6668:     ;
02:0003AED4 0C000012        	  6669:     cmpi.b  #$12,D0
02:0003AED8 6602            	  6670:     bne.s  __far_z_04_0063
02:0003AEDA 601A            	  6671:     jmp  Dodongo_TryEatBomb
                            	  6672: __far_z_04_0063:
                            	  6673:     ; If the object in the slot is actually a fire, then return.
                            	  6674:     ;
02:0003AEDC 0C000020        	  6675:     cmpi.b  #$20,D0
02:0003AEE0 6412            	  6676:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  6677:     ; The bomb already blew up.
                            	  6678:     ; If the dust cloud is in range of the monster,
