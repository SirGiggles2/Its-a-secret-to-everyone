                            	  5593: CheckState30:
                            	  5594:     ; If major state <> $30, go check other states.
                            	  5595:     ;
02:0004A6EC 0C000030        	  5596:     cmpi.b  #$30,D0
02:0004A6F0 6656            	  5597:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5598:     ; State $3x. Slow down.
                            	  5599:     ;
                            	  5600:     ; Reset grid offset for movement.
                            	  5601:     ;
02:0004A6F2 7000            	  5602:     moveq   #0,D0
02:0004A6F4 41EC0394        	  5603:     lea     ($0394,A4),A0
02:0004A6F8 11802000        	  5604:     move.b  D0,(A0,D2.W)
                            	  5605:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5606:     ;
02:0004A6FC 7040            	  5607:     moveq   #64,D0
02:0004A6FE 41EC03BC        	  5608:     lea     ($03BC,A4),A0
02:0004A702 11802000        	  5609:     move.b  D0,(A0,D2.W)
                            	  5610:     ; If facing left and X < 2, then go change state to $40. The
                            	  5611:     ; boomerang is too close to the left edge of the screen.
                            	  5612:     ; Another move might make it wrap around.
                            	  5613:     ;
02:0004A706 41EC0098        	  5614:     lea     ($0098,A4),A0
02:0004A70A 10302000        	  5615:     move.b  (A0,D2.W),D0
02:0004A70E 1940000F        	  5616:     move.b  D0,($000F,A4)
02:0004A712 02000002        	  5617:     andi.b #$02,D0
02:0004A716 670A            	  5618:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004A718 10342070        	  5619:     move.b  ($70,A4,D2.W),D0
02:0004A71C 0C000002        	  5620:     cmpi.b  #$02,D0
02:0004A720 650E            	  5621:     bcs  _L_z07_CheckState30_SetState40
                            	  5622:     even
