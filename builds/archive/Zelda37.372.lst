02:0003D6C0 41EC009A        	 12104:     lea     ($009A,A4),A0
02:0003D6C4 11803000        	 12105:     move.b  D0,(A0,D3.W)
02:0003D6C8 5303            	 12106:     subq.b  #1,D3
