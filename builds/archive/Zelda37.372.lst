                            	  3645: UpdatePondFairy:
02:000398C8 61004432        	  3646:     jsr     DrawFairy
                            	  3647:     ; If not in state 0, then go handle states 1 to 3.
                            	  3648:     ;
02:000398CC 102C00AD        	  3649:     move.b  ($00AD,A4),D0
02:000398D0 6702            	  3650:     beq.s  __far_z_04_0033
02:000398D2 602A            	  3651:     jmp  PondFairy_HandleOtherStates
                            	  3652: __far_z_04_0033:
                            	  3653:     ; State 0.
                            	  3654:     ;
                            	  3655:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3656:     ;
02:000398D4 102C0084        	  3657:     move.b  ($0084,A4),D0
02:000398D8 0C0000AD        	  3658:     cmpi.b  #$AD,D0
02:000398DC 661E            	  3659:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3660:     ; If Link's X < $70 or >= $81, then return.
                            	  3661:     ;
02:000398DE 102C0070        	  3662:     move.b  ($0070,A4),D0
02:000398E2 0C000070        	  3663:     cmpi.b  #$70,D0
02:000398E6 6514            	  3664:     bcs  _L_z04_UpdatePondFairy_Exit
02:000398E8 0C000081        	  3665:     cmpi.b  #$81,D0
02:000398EC 640E            	  3666:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3667:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3668:     ; halt Link, and start filling hearts.
                            	  3669:     ;
02:000398EE 522C00AD        	  3670:     addq.b  #1,($00AD,A4)
02:000398F2 7040            	  3671:     moveq   #64,D0
02:000398F4 194000AC        	  3672:     move.b  D0,($00AC,A4)
02:000398F8 19400063        	  3673:     move.b  D0,($0063,A4)
                            	  3674:     even
                            	  3675: _L_z04_UpdatePondFairy_Exit:
02:000398FC 4E75            	  3676:     rts
                            	  3677: 
                            	  3678:     even
                            	  3679: PondFairy_HandleOtherStates:
02:000398FE 0C000001        	  3680:     cmpi.b  #$01,D0
02:00039902 6610            	  3681:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3682:     ; State 1. Flying and filling hearts.
                            	  3683:     ;
                            	  3684:     ; If still filling hearts, then go draw Link and hearts.
                            	  3685:     ;
02:00039904 102C0063        	  3686:     move.b  ($0063,A4),D0
02:00039908 6620            	  3687:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3688:     ; If not filling hearts anymore, then go to state 2,
                            	  3689:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3690:     ; a little while after we finish filling hearts.
                            	  3691:     ;
02:0003990A 522C00AD        	  3692:     addq.b  #1,($00AD,A4)
02:0003990E 7050            	  3693:     moveq   #80,D0
02:00039910 19400029        	  3694:     move.b  D0,($0029,A4)
                            	  3695:     even
                            	  3696: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3697:     ; If state <> 2 (so, it's 3), then return.
                            	  3698:     ;
                            	  3699:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3700:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3701:     ; was set to, and we'll return.
                            	  3702:     ;
02:00039914 0C000002        	  3703:     cmpi.b  #$02,D0
02:00039918 6634            	  3704:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3705:     ; State = 2.
                            	  3706:     ;
                            	  3707:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3708:     ;
02:0003991A 102C0029        	  3709:     move.b  ($0029,A4),D0
02:0003991E 660A            	  3710:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3711:     ; Else go to state 3, and unhalt Link.
                            	  3712:     ;
02:00039920 522C00AD        	  3713:     addq.b  #1,($00AD,A4)
02:00039924 7000            	  3714:     moveq   #0,D0
02:00039926 194000AC        	  3715:     move.b  D0,($00AC,A4)
                            	  3716:     even
                            	  3717: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  3718:     ; TODO: but why, since Link is halted?
                            	  3719:     ;
                            	  3720:     ; Reset the input direction, so that Link doesn't animate
                            	  3721:     ; when drawing him.
02:0003992A 7600            	  3722:     moveq   #0,D3
02:0003992C 194303F8        	  3723:     move.b  D3,($03F8,A4)
                            	  3724:     ; Save and reset Link's state.
                            	  3725:     ;
                            	  3726:     ; TODO: but why, since Link is halted?
                            	  3727:     ;
02:00039930 102C00AC        	  3728:     move.b  ($00AC,A4),D0
02:00039934 1B00            	  3729:     move.b  D0,-(A5)  ; PHA
02:00039936 194300AC        	  3730:     move.b  D3,($00AC,A4)
02:0003993A 4EB900049F20    	  3731:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  3732:     ; Restore Link's state.
                            	  3733:     ;
02:00039940 101D            	  3734:     move.b  (A5)+,D0  ; PLA
02:00039942 194000AC        	  3735:     move.b  D0,($00AC,A4)
02:00039946 6110            	  3736:     jsr     PondFairy_MoveHearts
                            	  3737:     ; Restore the object slot.
                            	  3738:     ;
02:00039948 7400            	  3739:     moveq   #0,D2
02:0003994A 142C0340        	  3740:     move.b  ($0340,A4),D2
                            	  3741:     even
