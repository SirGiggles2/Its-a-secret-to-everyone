02:0003A7E0 41EC0437        	  5755:     lea     ($0437,A4),A0
02:0003A7E4 12302000        	  5756:     move.b  (A0,D2.W),D1
02:0003A7E8 B001            	  5757:     cmp.b   D1,D0
02:0003A7EA 6704            	  5758:     beq.s  __far_z_04_0051
