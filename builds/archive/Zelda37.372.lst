02:000395F4 6702            	  3191:     beq  _L_z04_UpdateOctorock_Shoot
02:000395F6 E308            	  3192:     lsl.b  #1,D0   ; ASL A
                            	  3193:     even
                            	  3194: _L_z04_UpdateOctorock_Shoot:
