                            	  1693: _L_z04_UpdateStatues_Shoot:
                            	  1694:     ; Look for an empty monster slot.
                            	  1695:     ; If none is found, return.
                            	  1696:     ;
                            	  1697:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1698:     ; object. This routine takes a shooter object, and instantiates
                            	  1699:     ; a fireball object at the shooter's location.
                            	  1700:     ;
                            	  1701:     ; The object slot we set up here will behave as the shooter.
                            	  1702:     ; For each fireball index, this object slot will have its coordinates
                            	  1703:     ; changed.
                            	  1704:     ;
                            	  1705:     ; Note that this means that:
                            	  1706:     ; 1. The first fireball made will be its own shooter.
                            	  1707:     ;    Practically, there's nothing special about this.
                            	  1708:     ; 2. If there is more than one fireball made in a frame,
                            	  1709:     ;    then two of them will come from the same statue.
                            	  1710:     ;
                            	  1711:     ;
                            	  1712:     ; Save the fireball pattern.
02:00038B6A 1003            	  1713:     move.b  D3,D0
02:00038B6C 1B00            	  1714:     move.b  D0,-(A5)  ; PHA
02:00038B6E 4EB90004B7E2    	  1715:     jsr     FindEmptyMonsterSlot
02:00038B74 0C000001        	  1716:     cmpi.b  #$01,D0
02:00038B78 101D            	  1717:     move.b  (A5)+,D0  ; PLA
02:00038B7A 6400010A        	  1718:     bcc  _L_z04_UpdateStatues_Exit
                            	  1719:     ; If we found a slot, but it < 6, return.
                            	  1720:     ;
02:00038B7E 0C030006        	  1721:     cmpi.b  #$06,D3
02:00038B82 65000102        	  1722:     bcs  _L_z04_UpdateStatues_Exit
                            	  1723:     ; Store the object slot in [0A].
                            	  1724:     ; Store fireball pattern in [0B].
                            	  1725:     ;
02:00038B86 1943000A        	  1726:     move.b  D3,($000A,A4)
02:00038B8A 1940000B        	  1727:     move.b  D0,($000B,A4)
                            	  1728:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1729:     ;
02:00038B8E 7600            	  1730:     moveq   #0,D3
02:00038B90 1600            	  1731:     move.b  D0,D3
02:00038B92 7400            	  1732:     moveq   #0,D2
02:00038B94 41F900038B26    	  1733:     lea     (StatueFireballCounts).l,A0
02:00038B9A 14303000        	  1734:     move.b  (A0,D3.W),D2
                            	  1735:     even
                            	  1736: _L_z04_UpdateStatues_LoopFireball:
                            	  1737:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1738:     ;
                            	  1739:     ; Decrement the fireball timer at this index.
                            	  1740:     ;
02:00038B9E 7600            	  1741:     moveq   #0,D3
02:00038BA0 41EC04E8        	  1742:     lea     ($04E8,A4),A0
02:00038BA4 16302000        	  1743:     move.b  (A0,D2.W),D3
02:00038BA8 5303            	  1744:     subq.b  #1,D3
02:00038BAA 1003            	  1745:     move.b  D3,D0
02:00038BAC 41EC04E8        	  1746:     lea     ($04E8,A4),A0
02:00038BB0 11802000        	  1747:     move.b  D0,(A0,D2.W)
                            	  1748:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1749:     ; to make a fireball. Go loop again.
                            	  1750:     ;
02:00038BB4 5203            	  1751:     addq.b  #1,D3
02:00038BB6 660000C8        	  1752:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1753:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1754:     ; This fireball index will wait another $100 frames.
                            	  1755:     ;
02:00038BBA 10342018        	  1756:     move.b  ($18,A4,D2.W),D0
02:00038BBE 0C0000F0        	  1757:     cmpi.b  #$F0,D0
02:00038BC2 640000BC        	  1758:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1759:     ; Else choose one of four start times for the fireball based on
                            	  1760:     ; the random value.
                            	  1761:     ;
02:00038BC6 02000003        	  1762:     andi.b #$03,D0
02:00038BCA 7600            	  1763:     moveq   #0,D3
02:00038BCC 1600            	  1764:     move.b  D0,D3
02:00038BCE 41F900038B2A    	  1765:     lea     (StatueFireballStartTimes).l,A0
02:00038BD4 10303000        	  1766:     move.b  (A0,D3.W),D0
02:00038BD8 41EC04E8        	  1767:     lea     ($04E8,A4),A0
02:00038BDC 11802000        	  1768:     move.b  D0,(A0,D2.W)
                            	  1769:     ; The coordinate lists are divided into sets for each pattern.
                            	  1770:     ;
                            	  1771:     ; Look up the index of the base of the set for the pattern in use.
                            	  1772:     ; Add it to the fireball index in X register to get the index of
                            	  1773:     ; the coordinate we want within each coordinate list.
                            	  1774:     ;
                            	  1775:     ;
                            	  1776:     ; Pattern
02:00038BE0 7600            	  1777:     moveq   #0,D3
02:00038BE2 162C000B        	  1778:     move.b  ($000B,A4),D3
02:00038BE6 1002            	  1779:     move.b  D2,D0
02:00038BE8 023C00EE        	  1780:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038BEC 41F900038B2E    	  1781:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00038BF2 12303000        	  1782:     move.b  (A0,D3.W),D1
02:00038BF6 D101            	  1783:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:00038BF8 7600            	  1784:     moveq   #0,D3
02:00038BFA 1600            	  1785:     move.b  D0,D3
02:00038BFC 1002            	  1786:     move.b  D2,D0
02:00038BFE 1B00            	  1787:     move.b  D0,-(A5)  ; PHA
                            	  1788:     ; Get Link's coordinates into [00] and [01].
                            	  1789:     ;
02:00038C00 7400            	  1790:     moveq   #0,D2
02:00038C02 4EB90004AFFA    	  1791:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1792:     ; Switch to the new fireball's object slot.
                            	  1793:     ;
02:00038C08 7400            	  1794:     moveq   #0,D2
02:00038C0A 142C000A        	  1795:     move.b  ($000A,A4),D2
                            	  1796:     ; Look up and set the X coordinate for the fireball object.
                            	  1797:     ; Also store it in [02].
                            	  1798:     ;
02:00038C0E 41F900038B32    	  1799:     lea     (StatueXs).l,A0
02:00038C14 10303000        	  1800:     move.b  (A0,D3.W),D0
02:00038C18 19400002        	  1801:     move.b  D0,($0002,A4)
02:00038C1C 19802070        	  1802:     move.b  D0,($70,A4,D2.W)
                            	  1803:     ; Look up and set the Y coordinate for the fireball object.
                            	  1804:     ; Also store it in [03].
                            	  1805:     ;
02:00038C20 41F900038B3A    	  1806:     lea     (StatueYs).l,A0
02:00038C26 10303000        	  1807:     move.b  (A0,D3.W),D0
02:00038C2A 19400003        	  1808:     move.b  D0,($0003,A4)
02:00038C2E 41EC0084        	  1809:     lea     ($0084,A4),A0
02:00038C32 11802000        	  1810:     move.b  D0,(A0,D2.W)
                            	  1811:     ; Set mask value 3 in [04].
                            	  1812:     ;
02:00038C36 7003            	  1813:     moveq   #3,D0
02:00038C38 19400004        	  1814:     move.b  D0,($0004,A4)
                            	  1815:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  1816:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  1817:     ;
02:00038C3C 7601            	  1818:     moveq   #1,D3
                            	  1819:     even
                            	  1820: _L_z04_UpdateStatues_LoopAxis:
02:00038C3E 10343000        	  1821:     move.b  ($00,A4,D3.W),D0
02:00038C42 003C0011        	  1822:     ori     #$11,CCR  ; SEC: set C+X
02:00038C46 12343002        	  1823:     move.b  ($02,A4,D3.W),D1
02:00038C4A 0A3C0010        	  1824:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038C4E 9101            	  1825:     subx.b  D1,D0   ; SBC $0002,Y
02:00038C50 0A3C0010        	  1826:     eori    #$10,CCR  ; restore X = 6502 C
02:00038C54 0C000018        	  1827:     cmpi.b  #$18,D0
02:00038C58 6A10            	  1828:     bpl  _anon_z04_31
02:00038C5A 0C0000E8        	  1829:     cmpi.b  #$E8,D0
02:00038C5E 6B0A            	  1830:     bmi  _anon_z04_31
02:00038C60 122C0004        	  1831:     move.b  ($0004,A4),D1
02:00038C64 E209            	  1832:     lsr.b  #1,D1   ; LSR $04
02:00038C66 19410004        	  1833:     move.b  D1,($0004,A4)
                            	  1834: _anon_z04_31:
02:00038C6A 5303            	  1835:     subq.b  #1,D3
02:00038C6C 6AD0            	  1836:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  1837:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  1838:     ; 0 or 1 time, instead of 2.
                            	  1839:     ;
                            	  1840:     ; This, in turn, means that the distance between Link and the
                            	  1841:     ; fireball was >= $18 in at least one axis.
                            	  1842:     ;
                            	  1843:     ; So, we're OK to finish making the fireball.
                            	  1844:     ;
02:00038C6E 102C0004        	  1845:     move.b  ($0004,A4),D0
02:00038C72 6706            	  1846:     beq  _anon_z04_32
02:00038C74 7055            	  1847:     moveq   #85,D0
02:00038C76 6100F94E        	  1848:     jsr     ShootFireball
                            	  1849: _anon_z04_32:
02:00038C7A 101D            	  1850:     move.b  (A5)+,D0  ; PLA
02:00038C7C 7400            	  1851:     moveq   #0,D2
02:00038C7E 1400            	  1852:     move.b  D0,D2
                            	  1853:     even
                            	  1854: _L_z04_UpdateStatues_NextLoopFireball:
                            	  1855:     ; Bottom of the loop.
                            	  1856:     ; Loop while fireball index >= 0.
                            	  1857:     ;
02:00038C80 5302            	  1858:     subq.b  #1,D2
02:00038C82 6A00FF1A        	  1859:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  1860:     even
                            	  1861: _L_z04_UpdateStatues_Exit:
02:00038C86 4E75            	  1862:     rts
                            	  1863: 
