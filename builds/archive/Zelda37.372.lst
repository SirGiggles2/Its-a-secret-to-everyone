                            	  4839: _anon_z04_70:
                            	  4840:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  4841:     ; 1. negate the distance
                            	  4842:     ; 2. add 8 to the instruction offset to access
                            	  4843:     ;    the opposite direction for the same wall
                            	  4844:     ;
02:0003A168 7600            	  4845:     moveq   #0,D3
02:0003A16A 162C0098        	  4846:     move.b  ($0098,A4),D3
02:0003A16E 122C0002        	  4847:     move.b  ($0002,A4),D1
02:0003A172 B601            	  4848:     cmp.b   D1,D3
02:0003A174 662A            	  4849:     bne  _anon_z04_71
02:0003A176 1B00            	  4850:     move.b  D0,-(A5)  ; PHA
02:0003A178 41EC0412        	  4851:     lea     ($0412,A4),A0
02:0003A17C 10302000        	  4852:     move.b  (A0,D2.W),D0
02:0003A180 023C00EE        	  4853:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A184 123C0008        	  4854:     move.b  #$08,D1
02:0003A188 D101            	  4855:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A18A 41EC0412        	  4856:     lea     ($0412,A4),A0
02:0003A18E 11802000        	  4857:     move.b  D0,(A0,D2.W)
02:0003A192 101D            	  4858:     move.b  (A5)+,D0  ; PLA
02:0003A194 4600            	  4859:     eori.b #$FF,D0
02:0003A196 023C00EE        	  4860:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A19A 123C0001        	  4861:     move.b  #$01,D1
02:0003A19E D101            	  4862:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4863: _anon_z04_71:
                            	  4864:     ; Add the distance and Link's minor coordinate to calculate
                            	  4865:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  4866:     ; In general, the monster will be put in front of Link.
                            	  4867:     ;
02:0003A1A0 023C00EE        	  4868:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A1A4 1214            	  4869:     move.b  ($0000,A4),D1
02:0003A1A6 D101            	  4870:     addx.b  D1,D0   ; ADC $00
02:0003A1A8 19400004        	  4871:     move.b  D0,($0004,A4)
                            	  4872:     ; By default, will return index 0 to choose the minimum value
                            	  4873:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  4874:     ; if Link is at the wall with a smaller major coordinate.
                            	  4875:     ;
02:0003A1AC 7600            	  4876:     moveq   #0,D3
                            	  4877:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  4878:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  4879:     ; to access the block for the other direction along the same axis,
                            	  4880:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  4881:     ;
02:0003A1AE 102C0001        	  4882:     move.b  ($0001,A4),D0
02:0003A1B2 122C0003        	  4883:     move.b  ($0003,A4),D1
02:0003A1B6 B001            	  4884:     cmp.b   D1,D0
02:0003A1B8 671C            	  4885:     beq  _anon_z04_72
02:0003A1BA 41EC0412        	  4886:     lea     ($0412,A4),A0
02:0003A1BE 10302000        	  4887:     move.b  (A0,D2.W),D0
02:0003A1C2 023C00EE        	  4888:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A1C6 123C0010        	  4889:     move.b  #$10,D1
02:0003A1CA D101            	  4890:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A1CC 41EC0412        	  4891:     lea     ($0412,A4),A0
02:0003A1D0 11802000        	  4892:     move.b  D0,(A0,D2.W)
02:0003A1D4 5203            	  4893:     addq.b  #1,D3
