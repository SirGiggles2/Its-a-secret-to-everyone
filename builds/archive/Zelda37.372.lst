                            	  4541: _L_z07_Link_EndMoveAndAnimate_TruncGridOffset:
                            	  4542:     ; Grid offset is a multiple of 8. So set it to 0.
                            	  4543:     ; If not in mode 5, go check warps and animate.
                            	  4544:     ;
