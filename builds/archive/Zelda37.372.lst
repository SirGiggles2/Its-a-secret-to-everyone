                            	  6494: __far_z_04_0058:
                            	  6495:     ; New bloated substate >= 2.
                            	  6496:     ;
                            	  6497:     ; If bomb hits < 2, then set bloated substate 4,
                            	  6498:     ; which will transition to state 0 (moving).
                            	  6499:     ;
                            	  6500:     ; Note that if the bomb hits >= 2, then:
                            	  6501:     ; - If new substate = 2, then substate 2 will wait,
                            	  6502:     ;   and then transition to substate 3.
                            	  6503:     ; - If new substate = 3, then the next frame the monster will die.
                            	  6504:     ;
02:0003AD90 7600            	  6505:     moveq   #0,D3
02:0003AD92 41EC0437        	  6506:     lea     ($0437,A4),A0
02:0003AD96 16302000        	  6507:     move.b  (A0,D2.W),D3
02:0003AD9A 0C030002        	  6508:     cmpi.b  #$02,D3
02:0003AD9E 6502            	  6509:     bcs.s  __far_z_04_0059
02:0003ADA0 600A            	  6510:     jmp  L_Dodongo_DecrementBloatedTimer
