02:0003FE5E 41F900FF6BB2    	  3395:     lea     (NES_SRAM+$0BB2).l,A0
02:0003FE64 12303000        	  3396:     move.b  (A0,D3.W),D1
02:0003FE68 B001            	  3397:     cmp.b   D1,D0
02:0003FE6A 66F0            	  3398:     bne  _anon_z05_84
                            	  3399:     ; Add the value of the shortcut chosen to whatever index
                            	  3400:     ; the current room has in the array.
                            	  3401:     ;
                            	  3402:     ; This yields the index of one of the three shortcut rooms
                            	  3403:     ; after the current one.
                            	  3404:     ;
02:0003FE6C 1003            	  3405:     move.b  D3,D0
02:0003FE6E 023C00EE        	  3406:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FE72 1214            	  3407:     move.b  ($0000,A4),D1
02:0003FE74 D101            	  3408:     addx.b  D1,D0   ; ADC $00
                            	  3409:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3410:     ;
02:0003FE76 02000003        	  3411:     andi.b #$03,D0
02:0003FE7A 7600            	  3412:     moveq   #0,D3
02:0003FE7C 1600            	  3413:     move.b  D0,D3
02:0003FE7E 41F900FF6BB2    	  3414:     lea     (NES_SRAM+$0BB2).l,A0
02:0003FE84 10303000        	  3415:     move.b  (A0,D3.W),D0
                            	  3416: ; Params:
