02:00038AE8 6720            	  1608:     beq  _L_z04_Gel_MoveSplitting_Exit
                            	  1609:     ; Move.
                            	  1610:     ;
02:00038AEA 4EB900049C94    	  1611:     jsr     MoveObject
                            	  1612:     ; Mask the grid offset with $F (to a square length),
                            	  1613:     ; and return C=0.
                            	  1614:     ;
02:00038AF0 41EC0394        	  1615:     lea     ($0394,A4),A0
02:00038AF4 10302000        	  1616:     move.b  (A0,D2.W),D0
02:00038AF8 0200000F        	  1617:     andi.b #$0F,D0
02:00038AFC 023C00EE        	  1618:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B00 6608            	  1619:     bne  _L_z04_Gel_MoveSplitting_Exit
