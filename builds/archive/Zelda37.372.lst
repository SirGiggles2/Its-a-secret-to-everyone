02:00034F54 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
                            	  5031:     ; Roll the carry from the comparison above into bit 0.
                            	  5032:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  5033:     ;
