02:0003B0A6 4EB900030912    	  6991:     jsr     DrawObjectNotMirrored
                            	  6992:     even
                            	  6993: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003B0AC 101D            	  6994:     move.b  (A5)+,D0  ; PLA
02:0003B0AE 7600            	  6995:     moveq   #0,D3
02:0003B0B0 1600            	  6996:     move.b  D0,D3
                            	  6997:     ; If facing vertically, then return. There's no other side to draw.
                            	  6998:     ;
02:0003B0B2 41EC0098        	  6999:     lea     ($0098,A4),A0
02:0003B0B6 10302000        	  7000:     move.b  (A0,D2.W),D0
02:0003B0BA 02000003        	  7001:     andi.b #$03,D0
02:0003B0BE 6602            	  7002:     bne.s  __far_z_04_0065
02:0003B0C0 602C            	  7003:     jmp  L11B00_Exit
                            	  7004: __far_z_04_0065:
                            	  7005:     ; Else draw the right side.
                            	  7006:     ;
                            	  7007:     ; Keep the Y coordinate in [01].
                            	  7008:     ; But, store (X + $10) in [00].
                            	  7009:     ;
02:0003B0C2 10342070        	  7010:     move.b  ($70,A4,D2.W),D0
02:0003B0C6 023C00EE        	  7011:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0CA 123C0010        	  7012:     move.b  #$10,D1
02:0003B0CE D101            	  7013:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003B0D0 1880            	  7014:     move.b  D0,($0000,A4)
02:0003B0D2 6114            	  7015:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7016:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7017:     ;
                            	  7018:     ; So, if we had animation frame 1, direction left:
                            	  7019:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7020:     ; - frame image index = 6 (1 + 5)
                            	  7021:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7022:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7023:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7024:     ;
                            	  7025:     ; So, 3 would have been the frame number used above for
                            	  7026:     ; the left side.
                            	  7027:     ;
                            	  7028:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7029:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7030:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7031:     ; on the right.
                            	  7032:     ;
02:0003B0D4 41F90003AFCA    	  7033:     lea     (DodongoFrameImages).l,A0
02:0003B0DA 10303000        	  7034:     move.b  (A0,D3.W),D0
02:0003B0DE 0A000001        	  7035:     eori.b #$01,D0
02:0003B0E2 4EF900030912    	  7036:     jmp     DrawObjectNotMirrored
                            	  7037: 
                            	  7038: ; Returns:
                            	  7039: ; A: 3
                            	  7040: ; [04]: left sprite attributes
                            	  7041: ; [05]: right sprite attributes
                            	  7042: ;
                            	  7043:     even
                            	  7044: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003B0E8 4EF90002C310    	  7045:     jmp     c_anim_set_sprite_desc_level_palette_row
