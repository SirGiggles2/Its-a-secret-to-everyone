                            	  3750: PondFairy_MoveHearts:
                            	  3751:     ; Loop over each heart from object slot 2 to 9.
                            	  3752:     ;
                            	  3753:     ; Even though they are not standalone objects, their info
                            	  3754:     ; is stored in those object slots.
                            	  3755:     ;
02:00039958 7402            	  3756:     moveq   #2,D2
                            	  3757:     even
                            	  3758: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  3759:     ; If the current heart's state <> 0, then go move it.
                            	  3760:     ; Else we have to wait for it to come out at the right time.
                            	  3761:     ;
02:0003995A 41EC00AC        	  3762:     lea     ($00AC,A4),A0
02:0003995E 10302000        	  3763:     move.b  (A0,D2.W),D0
02:00039962 667C            	  3764:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  3765:     ; The current heart's state = 0.
                            	  3766:     ;
                            	  3767:     ; If object slot = 2, then go make it appear. This is the first
                            	  3768:     ; heart to show up.
                            	  3769:     ;
02:00039964 0C020002        	  3770:     cmpi.b  #$02,D2
02:00039968 6732            	  3771:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  3772:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  3773:     ; go start over.
                            	  3774:     ;
                            	  3775:     ; TODO:
                            	  3776:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  3777:     ;
02:0003996A 102C00AE        	  3778:     move.b  ($00AE,A4),D0
02:0003996E 67EA            	  3779:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  3780:     ; Look up the starting angle of this heart with the index
                            	  3781:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  3782:     ; then loop again.
                            	  3783:     ;
02:00039970 1002            	  3784:     move.b  D2,D0
02:00039972 003C0011        	  3785:     ori     #$11,CCR  ; SEC: set C+X
02:00039976 123C0003        	  3786:     move.b  #$03,D1
02:0003997A 0A3C0010        	  3787:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003997E 9101            	  3788:     subx.b  D1,D0   ; SBC #$03
02:00039980 0A3C0010        	  3789:     eori    #$10,CCR  ; restore X = 6502 C
02:00039984 7600            	  3790:     moveq   #0,D3
02:00039986 1600            	  3791:     move.b  D0,D3
02:00039988 102C0396        	  3792:     move.b  ($0396,A4),D0
02:0003998C 41F900039950    	  3793:     lea     (PondHeartStartAngles).l,A0
02:00039992 12303000        	  3794:     move.b  (A0,D3.W),D1
02:00039996 B001            	  3795:     cmp.b   D1,D0
02:00039998 66000086        	  3796:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  3797:     even
                            	  3798: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  3799:     ; Set up this heart. Set its state to 1.
                            	  3800:     ;
02:0003999C 41EC00AC        	  3801:     lea     ($00AC,A4),A0
02:000399A0 52302000        	  3802:     addq.b  #1,(A0,D2.W)
                            	  3803:     ; TODO: ?
                            	  3804:     ;
02:000399A4 103C0080        	  3805:     move.b  #$80,D0
02:000399A8 41EC0098        	  3806:     lea     ($0098,A4),A0
02:000399AC 11802000        	  3807:     move.b  D0,(A0,D2.W)
                            	  3808:     ; Starting angle $18 (N).
                            	  3809:     ;
02:000399B0 7018            	  3810:     moveq   #24,D0
02:000399B2 41EC0394        	  3811:     lea     ($0394,A4),A0
02:000399B6 11802000        	  3812:     move.b  D0,(A0,D2.W)
                            	  3813:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  3814:     ;
02:000399BA 102C0071        	  3815:     move.b  ($0071,A4),D0
02:000399BE 19802070        	  3816:     move.b  D0,($70,A4,D2.W)
                            	  3817:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  3818:     ;
02:000399C2 102C0085        	  3819:     move.b  ($0085,A4),D0
02:000399C6 003C0011        	  3820:     ori     #$11,CCR  ; SEC: set C+X
02:000399CA 123C001C        	  3821:     move.b  #$1C,D1
02:000399CE 0A3C0010        	  3822:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000399D2 9101            	  3823:     subx.b  D1,D0   ; SBC #$1C
02:000399D4 0A3C0010        	  3824:     eori    #$10,CCR  ; restore X = 6502 C
02:000399D8 41EC0084        	  3825:     lea     ($0084,A4),A0
02:000399DC 11802000        	  3826:     move.b  D0,(A0,D2.W)
                            	  3827:     even
                            	  3828: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  3829:     ; Decrease the angle by $00.60.
                            	  3830:     ;
02:000399E0 7000            	  3831:     moveq   #0,D0
02:000399E2 1940000B        	  3832:     move.b  D0,($000B,A4)
02:000399E6 7060            	  3833:     moveq   #96,D0
02:000399E8 610047B0        	  3834:     jsr     DecreaseObjectAngle
                            	  3835:     ; Rotate the heart's location by the change in angle.
                            	  3836:     ; Use 6 for the number of bits of sine/cosine to use
                            	  3837:     ; for a large ring.
                            	  3838:     ;
02:000399EC 7006            	  3839:     moveq   #6,D0
02:000399EE 7600            	  3840:     moveq   #0,D3
02:000399F0 1600            	  3841:     move.b  D0,D3
02:000399F2 610045F6        	  3842:     jsr     RotateObjectLocation
02:000399F6 41EC0084        	  3843:     lea     ($0084,A4),A0
02:000399FA 11802000        	  3844:     move.b  D0,(A0,D2.W)
02:000399FE 1002            	  3845:     move.b  D2,D0
02:00039A00 1B00            	  3846:     move.b  D0,-(A5)  ; PHA
02:00039A02 4EB900030C02    	  3847:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
02:00039A08 4EB90004AFFA    	  3848:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3849:     ; The variable for the currently updating object slot has to be
                            	  3850:     ; set to the heart's object slot for this drawing routine to work.
                            	  3851:     ;
02:00039A0E 7400            	  3852:     moveq   #0,D2
02:00039A10 142C0340        	  3853:     move.b  ($0340,A4),D2
02:00039A14 4EB900030912    	  3854:     jsr     DrawObjectNotMirrored
02:00039A1A 101D            	  3855:     move.b  (A5)+,D0  ; PLA
02:00039A1C 7400            	  3856:     moveq   #0,D2
