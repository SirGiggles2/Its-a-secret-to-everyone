                            	  7405:     ; If in the bottom half, align with the next square.
                            	  7406:     ;
02:0003B3F4 41EC0084        	  7407:     lea     ($0084,A4),A0
02:0003B3F8 10302000        	  7408:     move.b  (A0,D2.W),D0
02:0003B3FC 023C00EE        	  7409:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B400 123C0008        	  7410:     move.b  #$08,D1
02:0003B404 D101            	  7411:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B406 020000F0        	  7412:     andi.b #$F0,D0
