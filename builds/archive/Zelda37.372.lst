                            	 11656: PatraChild_State1:
                            	 11657:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 11658:     ;
02:0003D3BA 10342070        	 11659:     move.b  ($70,A4,D2.W),D0
02:0003D3BE 023C00EE        	 11660:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D3C2 122C046C        	 11661:     move.b  ($046C,A4),D1
02:0003D3C6 D101            	 11662:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003D3C8 19802070        	 11663:     move.b  D0,($70,A4,D2.W)
02:0003D3CC 41EC0084        	 11664:     lea     ($0084,A4),A0
02:0003D3D0 10302000        	 11665:     move.b  (A0,D2.W),D0
02:0003D3D4 023C00EE        	 11666:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D3D8 122C0479        	 11667:     move.b  ($0479,A4),D1
02:0003D3DC D101            	 11668:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003D3DE 41EC0084        	 11669:     lea     ($0084,A4),A0
02:0003D3E2 11802000        	 11670:     move.b  D0,(A0,D2.W)
                            	 11671:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 11672:     ;
02:0003D3E6 7000            	 11673:     moveq   #0,D0
02:0003D3E8 1940000B        	 11674:     move.b  D0,($000B,A4)
                            	 11675:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 11676:     ; monster's angle by $70, else by $60 to go slower.
                            	 11677:     ;
02:0003D3EC 7070            	 11678:     moveq   #112,D0
02:0003D3EE 7600            	 11679:     moveq   #0,D3
02:0003D3F0 41EC034F        	 11680:     lea     ($034F,A4),A0
02:0003D3F4 16302000        	 11681:     move.b  (A0,D2.W),D3
02:0003D3F8 0C030025        	 11682:     cmpi.b  #$25,D3
02:0003D3FC 6702            	 11683:     beq  _anon_z04_159
02:0003D3FE 7060            	 11684:     moveq   #96,D0
                            	 11685: _anon_z04_159:
02:0003D400 61000D98        	 11686:     jsr     DecreaseObjectAngle
                            	 11687:     ; Load Patra's maneuver index.
                            	 11688:     ; It determines which counts of bits are looked up below.
                            	 11689:     ;
02:0003D404 7600            	 11690:     moveq   #0,D3
02:0003D406 162C045F        	 11691:     move.b  ($045F,A4),D3
                            	 11692:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 11693:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 11694:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 11695:     ;
02:0003D40A 41EC034F        	 11696:     lea     ($034F,A4),A0
02:0003D40E 10302000        	 11697:     move.b  (A0,D2.W),D0
02:0003D412 0C000025        	 11698:     cmpi.b  #$25,D0
02:0003D416 661E            	 11699:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003D418 41F90003D30A    	 11700:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003D41E 10303000        	 11701:     move.b  (A0,D3.W),D0
02:0003D422 1B00            	 11702:     move.b  D0,-(A5)  ; PHA
02:0003D424 41F90003D30E    	 11703:     lea     (PatraChild1RotationSineBits).l,A0
02:0003D42A 10303000        	 11704:     move.b  (A0,D3.W),D0
02:0003D42E 7600            	 11705:     moveq   #0,D3
02:0003D430 1600            	 11706:     move.b  D0,D3
02:0003D432 101D            	 11707:     move.b  (A5)+,D0  ; PLA
02:0003D434 600E            	 11708:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 11709: 
                            	 11710:     even
                            	 11711: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 11712:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 11713:     ; for both Y and X increment calculations in rotation. This leads to
                            	 11714:     ; a small circle (5) and a large circle (6).
                            	 11715:     ;
02:0003D436 41F90003D30C    	 11716:     lea     (PatraChild2RotationBits).l,A0
02:0003D43C 10303000        	 11717:     move.b  (A0,D3.W),D0
02:0003D440 7600            	 11718:     moveq   #0,D3
02:0003D442 1600            	 11719:     move.b  D0,D3
                            	 11720:     even
