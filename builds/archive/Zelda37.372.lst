                            	 12277: Ganon_DrawBody:
                            	 12278:     ; Loop over four 16x16 images that make up Ganon.
                            	 12279:     ; There are 6 animation frames.
                            	 12280:     ;
02:0003D818 7603            	 12281:     moveq   #3,D3
                            	 12282:     even
                            	 12283: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12284:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12285:     ;
02:0003D81A 10342070        	 12286:     move.b  ($70,A4,D2.W),D0
02:0003D81E 023C00EE        	 12287:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D822 41F90003D80C    	 12288:     lea     (GanonSpriteOffsetsX).l,A0
02:0003D828 12303000        	 12289:     move.b  (A0,D3.W),D1
02:0003D82C D101            	 12290:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003D82E 1880            	 12291:     move.b  D0,($0000,A4)
                            	 12292:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12293:     ;
02:0003D830 41EC0084        	 12294:     lea     ($0084,A4),A0
02:0003D834 10302000        	 12295:     move.b  (A0,D2.W),D0
02:0003D838 023C00EE        	 12296:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D83C 41F90003D810    	 12297:     lea     (GanonSpriteOffsetsY).l,A0
02:0003D842 12303000        	 12298:     move.b  (A0,D3.W),D1
02:0003D846 D101            	 12299:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003D848 19400001        	 12300:     move.b  D0,($0001,A4)
                            	 12301:     ; Each part has a horizontal flipping flag.
                            	 12302:     ;
02:0003D84C 41F90003D814    	 12303:     lea     (GanonSpriteHFlips).l,A0
02:0003D852 10303000        	 12304:     move.b  (A0,D3.W),D0
02:0003D856 1940000F        	 12305:     move.b  D0,($000F,A4)
                            	 12306:     ; Save and copy the loop index (the current part) to [07].
                            	 12307:     ;
02:0003D85A 1003            	 12308:     move.b  D3,D0
02:0003D85C 1B00            	 12309:     move.b  D0,-(A5)  ; PHA
02:0003D85E 19400007        	 12310:     move.b  D0,($0007,A4)
                            	 12311:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12312:     ; that make it up.
                            	 12313:     ;
02:0003D862 41EC046B        	 12314:     lea     ($046B,A4),A0
02:0003D866 10302000        	 12315:     move.b  (A0,D2.W),D0
02:0003D86A E308            	 12316:     lsl.b  #1,D0   ; ASL A
02:0003D86C E308            	 12317:     lsl.b  #1,D0   ; ASL A
                            	 12318:     ; Add [07] -- the index of the current part.
                            	 12319:     ;
                            	 12320:     ; Now you have an index into the frame image table, for the
                            	 12321:     ; current image part of the current animation frame.
                            	 12322:     ;
02:0003D86E 122C0007        	 12323:     move.b  ($0007,A4),D1
02:0003D872 D101            	 12324:     addx.b  D1,D0   ; ADC $07
02:0003D874 7600            	 12325:     moveq   #0,D3
02:0003D876 1600            	 12326:     move.b  D0,D3
02:0003D878 41F90003D7F4    	 12327:     lea     (GanonFrameImages).l,A0
02:0003D87E 10303000        	 12328:     move.b  (A0,D3.W),D0
02:0003D882 4EB900030912    	 12329:     jsr     DrawObjectNotMirrored
02:0003D888 101D            	 12330:     move.b  (A5)+,D0  ; PLA
                            	 12331:     ; Bottom of the part loop.
                            	 12332:     ;
02:0003D88A 7600            	 12333:     moveq   #0,D3
02:0003D88C 1600            	 12334:     move.b  D0,D3
02:0003D88E 5303            	 12335:     subq.b  #1,D3
02:0003D890 6A88            	 12336:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003D892 4E75            	 12337:     rts
