02:00034F36 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:00034F3A 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:00034F3E 123C0000        	  5018:     move.b  #$00,D1
02:00034F42 D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00034F44 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
                            	  5022:     ; roll over current V-scroll to 0, and increase number of
                            	  5023:     ; screens scrolled.
