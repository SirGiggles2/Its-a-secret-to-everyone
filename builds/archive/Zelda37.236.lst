02:0003CAEA 6750            	  7010:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CAEC 6B04            	  7011:     bmi.s  __far_z_04_0058
02:0003CAEE 60000080        	  7012:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7013: __far_z_04_0058:
                            	  7014:     ; Set the bloated timer according to the substate.
                            	  7015:     ;
02:0003CAF2 7600            	  7016:     moveq   #0,D3
02:0003CAF4 41EC042C        	  7017:     lea     ($042C,A4),A0
02:0003CAF8 16302000        	  7018:     move.b  (A0,D2.W),D3
02:0003CAFC 41F90003CA3A    	  7019:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003CB02 10303000        	  7020:     move.b  (A0,D3.W),D0
02:0003CB06 41EC045E        	  7021:     lea     ($045E,A4),A0
02:0003CB0A 11802000        	  7022:     move.b  D0,(A0,D2.W)
                            	  7023:     ; If substate <> 0, go decrement bloated timer.
                            	  7024:     ;
02:0003CB0E 4A03            	  7025:     cmpi.b  #$00,D3
02:0003CB10 6702            	  7026:     beq.s  __far_z_04_0059
02:0003CB12 605C            	  7027:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7028: __far_z_04_0059:
                            	  7029:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  7030:     ;
02:0003CB14 7610            	  7031:     moveq   #16,D3
02:0003CB16 7000            	  7032:     moveq   #0,D0
02:0003CB18 41EC00AC        	  7033:     lea     ($00AC,A4),A0
02:0003CB1C 11803000        	  7034:     move.b  D0,(A0,D3.W)
