02:00041C16 0C000040        	  3280:     cmpi.b  #$40,D0
02:00041C1A 6502            	  3281:     bcs.s  __far_z_05_0057
02:00041C1C 60C8            	  3282:     jmp  L14EC6_Exit
                            	  3283: __far_z_05_0057:
