02:00041C46 102C0070        	  3309:     move.b  ($0070,A4),D0
02:00041C4A 0C000080        	  3310:     cmpi.b  #$80,D0
02:00041C4E 640C            	  3311:     bcc  _L_z05_CheckSubroom_GetRightSideRoom
02:00041C50 41F900FF687E    	  3312:     lea     (NES_SRAM+$087E).l,A0
02:00041C56 10303000        	  3313:     move.b  (A0,D3.W),D0
