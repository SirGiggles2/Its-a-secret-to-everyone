                            	  5055:     ;
02:000368C2 102C00FC        	  5056:     move.b  ($00FC,A4),D0
02:000368C6 41F90003683A    	  5057:     lea     (CreditsLastVscrollList).l,A0
02:000368CC 12303000        	  5058:     move.b  (A0,D3.W),D1
02:000368D0 B001            	  5059:     cmp.b   D1,D0
02:000368D2 650A            	  5060:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  5061:     ; But if we have, then go to the next submode, and set a timer
