02:000437E4 101D            	  5710:     move.b  (A5)+,D0  ; PLA
02:000437E6 1B00            	  5711:     move.b  D0,-(A5)  ; PHA
02:000437E8 0C000002        	  5712:     cmpi.b  #$02,D0
02:000437EC 6406            	  5713:     bcc  _anon_z05_115
02:000437EE 4EB9000312A6    	  5714:     jsr     Add1ToInt16At0
