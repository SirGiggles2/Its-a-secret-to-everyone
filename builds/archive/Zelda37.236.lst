                            	  5598: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow:
                            	  5599:     ; Start preparing to draw an arrow.
                            	  5600:     ;
                            	  5601:     ; Set arrow slot frame 2 (spark) in [0C],
                            	  5602:     ; and no horizontal flipping in [0F].
                            	  5603:     ;
02:0004C50C 7002            	  5604:     moveq   #2,D0
02:0004C50E 1940000C        	  5605:     move.b  D0,($000C,A4)
02:0004C512 7000            	  5606:     moveq   #0,D0
02:0004C514 1940000F        	  5607:     move.b  D0,($000F,A4)
                            	  5608:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5609:     ; and go draw.
                            	  5610:     ;
02:0004C518 41EC0098        	  5611:     lea     ($0098,A4),A0
02:0004C51C 10302000        	  5612:     move.b  (A0,D2.W),D0
02:0004C520 4EB900030E52    	  5613:     jsr     GetOppositeDir
02:0004C526 7000            	  5614:     moveq   #0,D0
02:0004C528 6000FEF0        	  5615:     jmp     SetAttrAndDrawArrow
                            	  5616: 
                            	  5617:     even
                            	  5618: CheckState30:
                            	  5619:     ; If major state <> $30, go check other states.
                            	  5620:     ;
02:0004C52C 0C000030        	  5621:     cmpi.b  #$30,D0
02:0004C530 6656            	  5622:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5623:     ; State $3x. Slow down.
                            	  5624:     ;
                            	  5625:     ; Reset grid offset for movement.
                            	  5626:     ;
02:0004C532 7000            	  5627:     moveq   #0,D0
02:0004C534 41EC0394        	  5628:     lea     ($0394,A4),A0
02:0004C538 11802000        	  5629:     move.b  D0,(A0,D2.W)
                            	  5630:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5631:     ;
02:0004C53C 7040            	  5632:     moveq   #64,D0
02:0004C53E 41EC03BC        	  5633:     lea     ($03BC,A4),A0
02:0004C542 11802000        	  5634:     move.b  D0,(A0,D2.W)
                            	  5635:     ; If facing left and X < 2, then go change state to $40. The
                            	  5636:     ; boomerang is too close to the left edge of the screen.
                            	  5637:     ; Another move might make it wrap around.
                            	  5638:     ;
02:0004C546 41EC0098        	  5639:     lea     ($0098,A4),A0
02:0004C54A 10302000        	  5640:     move.b  (A0,D2.W),D0
02:0004C54E 1940000F        	  5641:     move.b  D0,($000F,A4)
02:0004C552 02000002        	  5642:     andi.b #$02,D0
02:0004C556 670A            	  5643:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004C558 10342070        	  5644:     move.b  ($70,A4,D2.W),D0
02:0004C55C 0C000002        	  5645:     cmpi.b  #$02,D0
02:0004C560 650E            	  5646:     bcs  _L_z07_CheckState30_SetState40
                            	  5647:     even
                            	  5648: _L_z07_CheckState30_MoveBoomerang:
                            	  5649:     ; Move the boomerang.
                            	  5650:     ;
02:0004C562 6100F54C        	  5651:     jsr     MoveObject
                            	  5652:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5653:     ; state to $40.
                            	  5654:     ;
02:0004C566 41EC0380        	  5655:     lea     ($0380,A4),A0
02:0004C56A 53302000        	  5656:     subq.b  #1,(A0,D2.W)
02:0004C56E 6614            	  5657:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5658:     even
                            	  5659: _L_z07_CheckState30_SetState40:
                            	  5660:     ; Set state $40, and a time to move of $20 frames.
                            	  5661:     ;
                            	  5662:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5663:     ;
                            	  5664:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5665:     ;
02:0004C570 7020            	  5666:     moveq   #32,D0
02:0004C572 41EC0380        	  5667:     lea     ($0380,A4),A0
02:0004C576 11802000        	  5668:     move.b  D0,(A0,D2.W)
02:0004C57A 7040            	  5669:     moveq   #64,D0
02:0004C57C 41EC00AC        	  5670:     lea     ($00AC,A4),A0
02:0004C580 11802000        	  5671:     move.b  D0,(A0,D2.W)
                            	  5672:     even
