02:0003C772 023C00EE        	  6543:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C776 41F90003C74E    	  6544:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003C77C 12303000        	  6545:     move.b  (A0,D3.W),D1
02:0003C780 D101            	  6546:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003C782 1880            	  6547:     move.b  D0,($0000,A4)
                            	  6548:     ; Store in [01] the Y coordinate offset for the current corner.
