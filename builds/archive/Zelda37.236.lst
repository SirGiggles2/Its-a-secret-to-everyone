                            	  2828: __far_z_04_0022:
                            	  2829:     ; Going down. We have to consider the target Y.
                            	  2830:     ;
                            	  2831:     ; If the absolute vertical distance to the target position >= 3,
                            	  2832:     ; then go animate, draw, and check collisions.
                            	  2833:     ;
02:0003AC66 41EC0084        	  2834:     lea     ($0084,A4),A0
02:0003AC6A 10302000        	  2835:     move.b  (A0,D2.W),D0
02:0003AC6E 003C0011        	  2836:     ori     #$11,CCR  ; SEC: set C+X
02:0003AC72 41EC0444        	  2837:     lea     ($0444,A4),A0
02:0003AC76 12302000        	  2838:     move.b  (A0,D2.W),D1
02:0003AC7A 0A3C0010        	  2839:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AC7E 9101            	  2840:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AC80 0A3C0010        	  2841:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AC84 4EB900030E56    	  2842:     jsr     Abs
02:0003AC8A 0C000003        	  2843:     cmpi.b  #$03,D0
02:0003AC8E 6502            	  2844:     bcs.s  __far_z_04_0023
