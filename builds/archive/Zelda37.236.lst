                            	  7842: Submenu_CueTransferRowUW:
                            	  7843:     ; If menu scroll value is negative, then we transferred everything.
                            	  7844:     ; So, return.
                            	  7845:     ;
02:00044C7A 102C005E        	  7846:     move.b  ($005E,A4),D0
02:00044C7E 6A02            	  7847:     bpl.s  __far_z_05_0095
02:00044C80 602E            	  7848:     jmp  L1725A_Exit
                            	  7849: __far_z_05_0095:
                            	  7850:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7851:     ; and represents the current row of the submenu being processed.
                            	  7852:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7853:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7854:     ;
                            	  7855:     ; If the bottom bit is set, go prepare the full black row.
                            	  7856:     ;
02:00044C82 E208            	  7857:     lsr.b  #1,D0   ; LSR A
02:00044C84 7600            	  7858:     moveq   #0,D3
02:00044C86 1600            	  7859:     move.b  D0,D3
02:00044C88 6402            	  7860:     bcc.s  __far_z_05_0096
02:00044C8A 6026            	  7861:     jmp  PrepFullBlackRow
                            	  7862: __far_z_05_0096:
                            	  7863:     ; Submenu rows $D to $15 are parts of the map.
                            	  7864:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7865:     ;
                            	  7866:     ; If submenu row < $D, cue a transfer of the static transfer
