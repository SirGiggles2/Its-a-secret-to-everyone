                            	  5816: Moldorm_Chase:
                            	  5817:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5818:     ; Only the head controls the movement direction.
                            	  5819:     ;
02:0003C262 0C020005        	  5820:     cmpi.b  #$05,D2
02:0003C266 670A            	  5821:     beq  _anon_z04_81
02:0003C268 0C02000A        	  5822:     cmpi.b  #$0A,D2
02:0003C26C 6704            	  5823:     beq.s  __far_z_04_0040
