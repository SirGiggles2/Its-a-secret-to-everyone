                            	  4600: 
                            	  4601: ; Params:
                            	  4602: ; [02:03]: address of door tiles for direction and face
                            	  4603: ; [04]: count of tiles remaining
                            	  4604: ; [07]: current index (0 to 3) of the tile to copy
                            	  4605: ;       to the dynamic transfer buf
                            	  4606: ; [09]: door direction index
                            	  4607: ;
                            	  4608: ; Returns:
                            	  4609: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4610: ; [04]: original value - 1
                            	  4611: ; [07]: original value + 1
                            	  4612: ;
                            	  4613: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4614: ; vertically. The point of this routine is to access them
                            	  4615: ; horizontally in order to transfer them to a nametable.
                            	  4616: ;
                            	  4617: ;
                            	  4618: ; For the direction index in [09], look up the base offset of the
                            	  4619: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4620: ; the door face tiles at [02:03].
                            	  4621: ;
                            	  4622:     even
                            	  4623: WriteDoorFaceTileHorizontally:
02:00042650 7600            	  4624:     moveq   #0,D3
02:00042652 162C0009        	  4625:     move.b  ($0009,A4),D3
02:00042656 41F900043874    	  4626:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:0004265C 10303000        	  4627:     move.b  (A0,D3.W),D0
                            	  4628:     ; Add [07] to the base offset we got above. This yields one
                            	  4629:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4630:     ;
02:00042660 023C00EE        	  4631:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042664 122C0007        	  4632:     move.b  ($0007,A4),D1
02:00042668 D101            	  4633:     addx.b  D1,D0   ; ADC $07
02:0004266A 7600            	  4634:     moveq   #0,D3
02:0004266C 1600            	  4635:     move.b  D0,D3
                            	  4636:     ; With that index, look up the index to use with the door face
                            	  4637:     ; list of tiles at [02:03].
                            	  4638:     ;
02:0004266E 41F900043866    	  4639:     lea     (HorizontalDoorFaceIndexes).l,A0
02:00042674 10303000        	  4640:     move.b  (A0,D3.W),D0
02:00042678 7600            	  4641:     moveq   #0,D3
02:0004267A 1600            	  4642:     move.b  D0,D3
                            	  4643:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4644:     ; and copy it to the dynamic transfer buf.
                            	  4645:     ;
02:0004267C 122C0002        	  4646:     move.b  ($02,A4),D1   ; ptr lo
02:00042680 182C0003        	  4647:     move.b  ($03,A4),D4  ; ptr hi
02:00042684 024100FF        	  4648:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042688 E14C            	  4649:     lsl.w   #8,D4
02:0004268A 8841            	  4650:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004268C 48C4            	  4651:     ext.l   D4
02:0004268E D8BC00FF0000    	  4652:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042694 2044            	  4653:     movea.l D4,A0
02:00042696 10303000        	  4654:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004269A 41EC0302        	  4655:     lea     ($0302,A4),A0
02:0004269E 11802000        	  4656:     move.b  D0,(A0,D2.W)
                            	  4657:     ; Prepare for the next call:
                            	  4658:     ; - increment dynamic transfer buf pointer
                            	  4659:     ; - increment index of tile to copy [07]
                            	  4660:     ; - decrement count of tiles remaining
                            	  4661:     ;
02:000426A2 5202            	  4662:     addq.b  #1,D2
02:000426A4 522C0007        	  4663:     addq.b  #1,($0007,A4)
02:000426A8 532C0004        	  4664:     subq.b  #1,($0004,A4)
02:000426AC 4E75            	  4665:     rts
                            	  4666: 
