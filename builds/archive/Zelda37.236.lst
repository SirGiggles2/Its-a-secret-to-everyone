                            	 11632: UpdateLamnola:
                            	 11633:     ; If the direction of this segment is not set, then it has not started
                            	 11634:     ; moving yet. So, return.
                            	 11635:     ;
02:0003ED32 41EC0098        	 11636:     lea     ($0098,A4),A0
