                            	  5565: HandleArrowOrBoomerangBlocked:
                            	  5566:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5567:     ;
02:0004C4CA 7003            	  5568:     moveq   #3,D0
02:0004C4CC 41EC03D0        	  5569:     lea     ($03D0,A4),A0
02:0004C4D0 11802000        	  5570:     move.b  D0,(A0,D2.W)
                            	  5571:     ; Add $10 to the state to make it $2x.
                            	  5572:     ;
02:0004C4D4 41EC00AC        	  5573:     lea     ($00AC,A4),A0
02:0004C4D8 10302000        	  5574:     move.b  (A0,D2.W),D0
02:0004C4DC 023C00EE        	  5575:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C4E0 123C0010        	  5576:     move.b  #$10,D1
02:0004C4E4 D101            	  5577:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004C4E6 41EC00AC        	  5578:     lea     ($00AC,A4),A0
02:0004C4EA 11802000        	  5579:     move.b  D0,(A0,D2.W)
                            	  5580:     even
