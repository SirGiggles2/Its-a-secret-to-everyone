                            	  8145:     ;
02:0003D33E 7000            	  8146:     moveq   #0,D0
02:0003D340 19400512        	  8147:     move.b  D0,($0512,A4)
02:0003D344 6000CC26        	  8148:     jmp     HideSpritesOverLink
