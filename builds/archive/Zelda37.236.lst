                            	   281:     ;
02:0002E2F0 7400            	   282:     moveq   #0,D2
                            	   283:     even
                            	   284: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   285:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   286:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   287:     ;
02:0002E2F2 41F900FF6A7E    	   288:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E2F8 10303000        	   289:     move.b  (A0,D3.W),D0
02:0002E2FC 41EC0422        	   290:     lea     ($0422,A4),A0
02:0002E300 11802000        	   291:     move.b  D0,(A0,D2.W)
                            	   292:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   293:     ;
02:0002E304 020000C0        	   294:     andi.b #$C0,D0
02:0002E308 19802000        	   295:     move.b  D0,($00,A4,D2.W)
                            	   296:     ; Copy 3 prices from the Cave level block info.
                            	   297:     ;
02:0002E30C 41F900FF6ABA    	   298:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E312 10303000        	   299:     move.b  (A0,D3.W),D0
02:0002E316 41EC0430        	   300:     lea     ($0430,A4),A0
02:0002E31A 11802000        	   301:     move.b  D0,(A0,D2.W)
                            	   302:     ; Bottom of the wares copying loop.
                            	   303:     ;
02:0002E31E 5203            	   304:     addq.b  #1,D3
02:0002E320 5202            	   305:     addq.b  #1,D2
02:0002E322 0C020003        	   306:     cmpi.b  #$03,D2
02:0002E326 66CA            	   307:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   308:     ; Get the top 2 bits of text selector byte in [03],
                            	   309:     ; shift them to the bottom, and combine them with [00].
                            	   310:     ;
02:0002E328 102C0003        	   311:     move.b  ($0003,A4),D0
02:0002E32C E308            	   312:     lsl.b  #1,D0   ; ASL A
02:0002E32E E310            	   313:     roxl.b  #1,D0   ; ROL A
02:0002E330 E310            	   314:     roxl.b  #1,D0   ; ROL A
02:0002E332 1214            	   315:     move.b  ($0000,A4),D1
02:0002E334 8001            	   316:     or.b  D1,D0
02:0002E336 1880            	   317:     move.b  D0,($0000,A4)
                            	   318:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   319:     ; and combine them with [00].
                            	   320:     ;
02:0002E338 102C0002        	   321:     move.b  ($0002,A4),D0
02:0002E33C E208            	   322:     lsr.b  #1,D0   ; LSR A
02:0002E33E E208            	   323:     lsr.b  #1,D0   ; LSR A
02:0002E340 E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E342 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E344 1214            	   326:     move.b  ($0000,A4),D1
02:0002E346 8001            	   327:     or.b  D1,D0
02:0002E348 1880            	   328:     move.b  D0,($0000,A4)
                            	   329:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   330:     ; and combine them with [00] into CaveFlags.
                            	   331:     ;
02:0002E34A 102C0001        	   332:     move.b  ($0001,A4),D0
02:0002E34E E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E350 E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E352 1214            	   335:     move.b  ($0000,A4),D1
02:0002E354 8001            	   336:     or.b  D1,D0
02:0002E356 19400413        	   337:     move.b  D0,($0413,A4)
                            	   338:     ; The end result is a byte with 8 cave flags.
                            	   339:     ;
                            	   340:     ; If cave flag "money game" is missing, then go finish up,
                            	   341:     ; instead of choosing random amounts for the money game.
                            	   342:     ;
02:0002E35A 02000020        	   343:     andi.b #$20,D0
02:0002E35E 6700009E        	   344:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   345:     ; Determine an index randomly with increasing probability,
                            	   346:     ; from 6 to 1. Start with the following test:
                            	   347:     ;
                            	   348:     ;   If $FF < Random, then go use index 6.
                            	   349:     ;
02:0002E362 103C00FF        	   350:     move.b  #$FF,D0
02:0002E366 7606            	   351:     moveq   #6,D3
                            	   352:     even
                            	   353: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E368 122C0019        	   354:     move.b  ($0019,A4),D1
02:0002E36C B001            	   355:     cmp.b   D1,D0
02:0002E36E 6516            	   356:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   357:     ; If the test fails, then subtract $2B from the reference number.
                            	   358:     ;
02:0002E370 003C0011        	   359:     ori     #$11,CCR  ; SEC: set C+X
02:0002E374 123C002B        	   360:     move.b  #$2B,D1
02:0002E378 0A3C0010        	   361:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E37C 9101            	   362:     subx.b  D1,D0   ; SBC #$2B
02:0002E37E 0A3C0010        	   363:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E382 5303            	   364:     subq.b  #1,D3
02:0002E384 66E2            	   365:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   366:     even
                            	   367: _L_z01_InitCaveContinue_FoundPermutation:
                            	   368:     ; The index chooses the last offset of a permutation of three indexes.
                            	   369:     ;
02:0002E386 7400            	   370:     moveq   #0,D2
02:0002E388 41F90002E262    	   371:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E38E 14303000        	   372:     move.b  (A0,D3.W),D2
                            	   373:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   374:     ;
02:0002E392 7602            	   375:     moveq   #2,D3
                            	   376:     even
                            	   377: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E394 41F90002E250    	   378:     lea     (MoneyGamePermutations).l,A0
02:0002E39A 10302000        	   379:     move.b  (A0,D2.W),D0
02:0002E39E 41EC046C        	   380:     lea     ($046C,A4),A0
02:0002E3A2 11803000        	   381:     move.b  D0,(A0,D3.W)
02:0002E3A6 5302            	   382:     subq.b  #1,D2
02:0002E3A8 5303            	   383:     subq.b  #1,D3
02:0002E3AA 6AE8            	   384:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   385:     ; With the first bit of another random number, choose 10 or 40
                            	   386:     ; to put in [046F]. This is a random amount to lose.
                            	   387:     ;
02:0002E3AC 102C001A        	   388:     move.b  ($001A,A4),D0
02:0002E3B0 02000001        	   389:     andi.b #$01,D0
02:0002E3B4 7600            	   390:     moveq   #0,D3
02:0002E3B6 1600            	   391:     move.b  D0,D3
02:0002E3B8 41F90002E24E    	   392:     lea     (MoneyGameLossAmounts).l,A0
02:0002E3BE 10303000        	   393:     move.b  (A0,D3.W),D0
02:0002E3C2 1940046F        	   394:     move.b  D0,($046F,A4)
                            	   395:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   396:     ;
02:0002E3C6 700A            	   397:     moveq   #10,D0
02:0002E3C8 19400470        	   398:     move.b  D0,($0470,A4)
                            	   399:     ; With a different bit of the second random number,
                            	   400:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   401:     ;
02:0002E3CC 7614            	   402:     moveq   #20,D3
02:0002E3CE 102C001A        	   403:     move.b  ($001A,A4),D0
02:0002E3D2 02000002        	   404:     andi.b #$02,D0
02:0002E3D6 6702            	   405:     beq  _anon_z01_1
02:0002E3D8 7632            	   406:     moveq   #50,D3
                            	   407: _anon_z01_1:
