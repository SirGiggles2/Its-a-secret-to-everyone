02:0003BDD0 123C0010        	  5262:     move.b  #$10,D1
02:0003BDD4 D101            	  5263:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BDD6 41EC0412        	  5264:     lea     ($0412,A4),A0
02:0003BDDA 11802000        	  5265:     move.b  D0,(A0,D2.W)
02:0003BDDE 5203            	  5266:     addq.b  #1,D3
