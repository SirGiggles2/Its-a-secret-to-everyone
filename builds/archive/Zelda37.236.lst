                            	  6795: Aquamentus_Draw:
                            	  6796:     ; Every $10 screen frames, switch animation frames.
                            	  6797:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6798:     ; The last tile of frame 0 is at index 5.
                            	  6799:     ; The last tile of frame 1 is at index $B.
                            	  6800:     ;
02:0003C954 7605            	  6801:     moveq   #5,D3
02:0003C956 102C0015        	  6802:     move.b  ($0015,A4),D0
02:0003C95A 02000010        	  6803:     andi.b #$10,D0
02:0003C95E 6602            	  6804:     bne  _anon_z04_88
02:0003C960 760B            	  6805:     moveq   #11,D3
                            	  6806: _anon_z04_88:
02:0003C962 1943000A        	  6807:     move.b  D3,($000A,A4)
                            	  6808:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6809:     ;
02:0003C966 7005            	  6810:     moveq   #5,D0
02:0003C968 1940000B        	  6811:     move.b  D0,($000B,A4)
                            	  6812:     even
                            	  6813: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C96C 7600            	  6814:     moveq   #0,D3
02:0003C96E 162C000B        	  6815:     move.b  ($000B,A4),D3
                            	  6816:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6817:     ; Store it in [00].
                            	  6818:     ;
02:0003C972 10342070        	  6819:     move.b  ($70,A4,D2.W),D0
02:0003C976 023C00EE        	  6820:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C97A 41F90003C94E    	  6821:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C980 12303000        	  6822:     move.b  (A0,D3.W),D1
02:0003C984 D101            	  6823:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C986 1880            	  6824:     move.b  D0,($0000,A4)
                            	  6825:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6826:     ; Store it in [01].
                            	  6827:     ;
02:0003C988 41EC0084        	  6828:     lea     ($0084,A4),A0
02:0003C98C 10302000        	  6829:     move.b  (A0,D2.W),D0
02:0003C990 023C00EE        	  6830:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C994 41F90003C948    	  6831:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C99A 12303000        	  6832:     move.b  (A0,D3.W),D1
02:0003C99E D101            	  6833:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C9A0 19400001        	  6834:     move.b  D0,($0001,A4)
                            	  6835:     ; Calculate sprite attributes:
                            	  6836:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6837:     ;
                            	  6838:     ; If the boss is temporarily invincible, then
                            	  6839:     ; this makes it flash by cycling all the palette rows.
                            	  6840:     ;
                            	  6841:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6842:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6843:     ;
02:0003C9A4 41EC04F0        	  6844:     lea     ($04F0,A4),A0
02:0003C9A8 10302000        	  6845:     move.b  (A0,D2.W),D0
02:0003C9AC 02000003        	  6846:     andi.b #$03,D0
02:0003C9B0 0A000003        	  6847:     eori.b #$03,D0
02:0003C9B4 19400003        	  6848:     move.b  D0,($0003,A4)
02:0003C9B8 7600            	  6849:     moveq   #0,D3
02:0003C9BA 162C000A        	  6850:     move.b  ($000A,A4),D3
                            	  6851:     ; Look up the tile for this sprite.
                            	  6852:     ; If it's not the first one (face), then go write the sprite record.
                            	  6853:     ;
02:0003C9BE 41F90003C93C    	  6854:     lea     (AquamentusTiles).l,A0
02:0003C9C4 10303000        	  6855:     move.b  (A0,D3.W),D0
02:0003C9C8 12390003C93C    	  6856:     move.b  (AquamentusTiles).l,D1
02:0003C9CE B001            	  6857:     cmp.b   D1,D0
02:0003C9D0 6610            	  6858:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6859:     ; Else it's the first one (the face tile).
                            	  6860:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6861:     ;
                            	  6862:     ; $CC/CD shows the closed mouth face.
                            	  6863:     ; $C0/C1 shows the open mouth face.
                            	  6864:     ;
02:0003C9D2 7600            	  6865:     moveq   #0,D3
02:0003C9D4 16342028        	  6866:     move.b  ($28,A4,D2.W),D3
02:0003C9D8 0C030020        	  6867:     cmpi.b  #$20,D3
02:0003C9DC 6404            	  6868:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003C9DE 103C00C0        	  6869:     move.b  #$C0,D0
                            	  6870:     even
                            	  6871: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003C9E2 610E            	  6872:     jsr     WriteBossSprite
                            	  6873:     ; Bottom of the loop.
                            	  6874:     ; Decrement tile index and loop index.
                            	  6875:     ;
02:0003C9E4 532C000A        	  6876:     subq.b  #1,($000A,A4)
02:0003C9E8 532C000B        	  6877:     subq.b  #1,($000B,A4)
02:0003C9EC 6A00FF7E        	  6878:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003C9F0 4E75            	  6879:     rts
