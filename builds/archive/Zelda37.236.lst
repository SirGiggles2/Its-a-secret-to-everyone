02:0002BFAA 08000008        	  2124:     btst    #8,D0
02:0002BFAE 670A            	  2125:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2126:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2127:     eori    #$01,CCR
02:0002BFB8 4E75            	  2128:     rts
                            	  2129: .cc_cnras:
02:0002BFBA 023C00FE        	  2130:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2131:     eori    #$01,CCR
02:0002BFC2 4E75            	  2132:     rts
