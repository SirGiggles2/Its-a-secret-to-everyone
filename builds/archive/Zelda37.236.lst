02:0003B52A 1B00            	  4085:     move.b  D0,-(A5)  ; PHA
02:0003B52C 194300AC        	  4086:     move.b  D3,($00AC,A4)
02:0003B530 4EB90004BD60    	  4087:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  4088:     ; Restore Link's state.
