                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:000403E0 7400            	   576:     moveq   #0,D2
02:000403E2 41F900040364    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:000403E8 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:000403EC 102C0006        	   585:     move.b  ($0006,A4),D0
02:000403F0 122C0671        	   586:     move.b  ($0671,A4),D1
02:000403F4 C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000403F6 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:000403F8 41F9000474F6    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403FE 10302000        	   599:     move.b  (A0,D2.W),D0
02:00040402 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:00040406 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:00040408 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:0004040C 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0004040E 41F90004037C    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:00040414 10303000        	   605:     move.b  (A0,D3.W),D0
02:00040418 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0004041A 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:0004041E 41F9000474F6    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:00040424 11802000        	   613:     move.b  D0,(A0,D2.W)
                            	   614:     even
                            	   615: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   616:     ; Bottom of the inner loop.
                            	   617:     ;
                            	   618:     ; Increment the triforce tile slot.
                            	   619:     ; Decrement [07] and loop again, if it's not 0.
                            	   620:     ;
02:00040428 5203            	   621:     addq.b  #1,D3
02:0004042A 532C0007        	   622:     subq.b  #1,($0007,A4)
02:0004042E 66B0            	   623:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   624:     ; Bottom of the outer loop.
                            	   625:     ;
                            	   626:     ; Shift the level test bit [06] left to test the next level.
                            	   627:     ; When it becomes 0, we're done.
                            	   628:     ;
02:00040430 122C0006        	   629:     move.b  ($0006,A4),D1
