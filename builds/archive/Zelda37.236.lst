02:0004C106 19802070        	  5010:     move.b  D0,($70,A4,D2.W)
02:0004C10A 41EC0084        	  5011:     lea     ($0084,A4),A0
02:0004C10E 10303000        	  5012:     move.b  (A0,D3.W),D0
02:0004C112 41EC0084        	  5013:     lea     ($0084,A4),A0
