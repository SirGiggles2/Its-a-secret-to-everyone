02:0003ABE4 102C000F        	  2767:     move.b  ($000F,A4),D0
02:0003ABE8 660C            	  2768:     bne  _anon_z04_37
02:0003ABEA 41EC0451        	  2769:     lea     ($0451,A4),A0
02:0003ABEE 52302000        	  2770:     addq.b  #1,(A0,D2.W)
02:0003ABF2 6000FF74        	  2771:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
