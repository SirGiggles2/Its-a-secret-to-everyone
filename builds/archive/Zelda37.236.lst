02:00031FF0 1941000D        	  6578:     move.b  D1,($000D,A4)
02:00031FF4 122C000E        	  6579:     move.b  ($000E,A4),D1
02:00031FF8 E211            	  6580:     roxr.b  #1,D1   ; ROR $0E
02:00031FFA 1941000E        	  6581:     move.b  D1,($000E,A4)
02:00031FFE 5303            	  6582:     subq.b  #1,D3
