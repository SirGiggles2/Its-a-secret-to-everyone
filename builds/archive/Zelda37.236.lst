02:0004CE0A 0200000C        	  6887:     andi.b #$0C,D0
02:0004CE0E 6602            	  6888:     bne.s  __far_z_07_0122
02:0004CE10 6012            	  6889:     jmp  SetUpHorizontalWalkingSprites
