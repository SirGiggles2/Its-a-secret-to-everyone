                            	  6442: __far_z_01_0060:
                            	  6443:     ; They collide. Now find out how they collide.
                            	  6444:     ;
                            	  6445:     ; If it's a regular monster, go harm Link.
                            	  6446:     ;
02:00031F10 41EC034F        	  6447:     lea     ($034F,A4),A0
02:00031F14 10302000        	  6448:     move.b  (A0,D2.W),D0
02:00031F18 0C000053        	  6449:     cmpi.b  #$53,D0
02:00031F1C 6402            	  6450:     bcc.s  __far_z_01_0061
02:00031F1E 607C            	  6451:     jmp  HarmLink
                            	  6452: __far_z_01_0061:
                            	  6453:     ; Here, the attacker is a monster's shot/projectile.
                            	  6454:     ; Flag this kind of collision.
                            	  6455:     ;
02:00031F20 522C034B        	  6456:     addq.b  #1,($034B,A4)
                            	  6457:     ; If object type = Fireball2 ($56) or $5A, or Link is not idle;
