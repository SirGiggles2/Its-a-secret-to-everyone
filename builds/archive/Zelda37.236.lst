                            	  8098:     ; There were more than one input directions.
                            	  8099:     ;
                            	  8100:     ; If none were walkable, go set input direction to 0, and return.
                            	  8101:     ;
02:00044DD2 102C000C        	  8102:     move.b  ($000C,A4),D0
