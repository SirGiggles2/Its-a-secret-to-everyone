02:0003B31A E0              	  3741:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B31B B0
02:0003B31C B0
02:0003B31D 30
02:0003B31E 40
02:0003B31F 90
02:0003B320 A0
