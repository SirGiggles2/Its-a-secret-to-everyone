02:00041C84 101D            	  3332:     move.b  (A5)+,D0  ; PLA
02:00041C86 E308            	  3333:     lsl.b  #1,D0   ; ASL A
02:00041C88 E308            	  3334:     lsl.b  #1,D0   ; ASL A
02:00041C8A E308            	  3335:     lsl.b  #1,D0   ; ASL A
02:00041C8C E308            	  3336:     lsl.b  #1,D0   ; ASL A
