                            	  1908: _L_z04_UpdateStatues_Shoot:
                            	  1909:     ; Look for an empty monster slot.
                            	  1910:     ; If none is found, return.
                            	  1911:     ;
                            	  1912:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1913:     ; object. This routine takes a shooter object, and instantiates
                            	  1914:     ; a fireball object at the shooter's location.
                            	  1915:     ;
                            	  1916:     ; The object slot we set up here will behave as the shooter.
                            	  1917:     ; For each fireball index, this object slot will have its coordinates
                            	  1918:     ; changed.
                            	  1919:     ;
                            	  1920:     ; Note that this means that:
                            	  1921:     ; 1. The first fireball made will be its own shooter.
                            	  1922:     ;    Practically, there's nothing special about this.
                            	  1923:     ; 2. If there is more than one fireball made in a frame,
                            	  1924:     ;    then two of them will come from the same statue.
                            	  1925:     ;
                            	  1926:     ;
                            	  1927:     ; Save the fireball pattern.
02:0003A66E 1003            	  1928:     move.b  D3,D0
02:0003A670 1B00            	  1929:     move.b  D0,-(A5)  ; PHA
02:0003A672 4EB90004D63C    	  1930:     jsr     FindEmptyMonsterSlot
02:0003A678 0C000001        	  1931:     cmpi.b  #$01,D0
02:0003A67C 101D            	  1932:     move.b  (A5)+,D0  ; PLA
02:0003A67E 6400010A        	  1933:     bcc  _L_z04_UpdateStatues_Exit
                            	  1934:     ; If we found a slot, but it < 6, return.
                            	  1935:     ;
02:0003A682 0C030006        	  1936:     cmpi.b  #$06,D3
02:0003A686 65000102        	  1937:     bcs  _L_z04_UpdateStatues_Exit
                            	  1938:     ; Store the object slot in [0A].
                            	  1939:     ; Store fireball pattern in [0B].
                            	  1940:     ;
02:0003A68A 1943000A        	  1941:     move.b  D3,($000A,A4)
02:0003A68E 1940000B        	  1942:     move.b  D0,($000B,A4)
                            	  1943:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1944:     ;
02:0003A692 7600            	  1945:     moveq   #0,D3
02:0003A694 1600            	  1946:     move.b  D0,D3
02:0003A696 7400            	  1947:     moveq   #0,D2
02:0003A698 41F90003A62A    	  1948:     lea     (StatueFireballCounts).l,A0
02:0003A69E 14303000        	  1949:     move.b  (A0,D3.W),D2
                            	  1950:     even
                            	  1951: _L_z04_UpdateStatues_LoopFireball:
                            	  1952:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1953:     ;
                            	  1954:     ; Decrement the fireball timer at this index.
                            	  1955:     ;
02:0003A6A2 7600            	  1956:     moveq   #0,D3
02:0003A6A4 41EC04E8        	  1957:     lea     ($04E8,A4),A0
02:0003A6A8 16302000        	  1958:     move.b  (A0,D2.W),D3
02:0003A6AC 5303            	  1959:     subq.b  #1,D3
02:0003A6AE 1003            	  1960:     move.b  D3,D0
02:0003A6B0 41EC04E8        	  1961:     lea     ($04E8,A4),A0
02:0003A6B4 11802000        	  1962:     move.b  D0,(A0,D2.W)
                            	  1963:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1964:     ; to make a fireball. Go loop again.
                            	  1965:     ;
02:0003A6B8 5203            	  1966:     addq.b  #1,D3
02:0003A6BA 660000C8        	  1967:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1968:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1969:     ; This fireball index will wait another $100 frames.
                            	  1970:     ;
02:0003A6BE 10342018        	  1971:     move.b  ($18,A4,D2.W),D0
02:0003A6C2 0C0000F0        	  1972:     cmpi.b  #$F0,D0
02:0003A6C6 640000BC        	  1973:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1974:     ; Else choose one of four start times for the fireball based on
                            	  1975:     ; the random value.
                            	  1976:     ;
02:0003A6CA 02000003        	  1977:     andi.b #$03,D0
02:0003A6CE 7600            	  1978:     moveq   #0,D3
02:0003A6D0 1600            	  1979:     move.b  D0,D3
02:0003A6D2 41F90003A62E    	  1980:     lea     (StatueFireballStartTimes).l,A0
02:0003A6D8 10303000        	  1981:     move.b  (A0,D3.W),D0
02:0003A6DC 41EC04E8        	  1982:     lea     ($04E8,A4),A0
02:0003A6E0 11802000        	  1983:     move.b  D0,(A0,D2.W)
                            	  1984:     ; The coordinate lists are divided into sets for each pattern.
                            	  1985:     ;
                            	  1986:     ; Look up the index of the base of the set for the pattern in use.
                            	  1987:     ; Add it to the fireball index in X register to get the index of
                            	  1988:     ; the coordinate we want within each coordinate list.
                            	  1989:     ;
                            	  1990:     ;
                            	  1991:     ; Pattern
02:0003A6E4 7600            	  1992:     moveq   #0,D3
02:0003A6E6 162C000B        	  1993:     move.b  ($000B,A4),D3
02:0003A6EA 1002            	  1994:     move.b  D2,D0
02:0003A6EC 023C00EE        	  1995:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A6F0 41F90003A632    	  1996:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A6F6 12303000        	  1997:     move.b  (A0,D3.W),D1
02:0003A6FA D101            	  1998:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A6FC 7600            	  1999:     moveq   #0,D3
02:0003A6FE 1600            	  2000:     move.b  D0,D3
02:0003A700 1002            	  2001:     move.b  D2,D0
02:0003A702 1B00            	  2002:     move.b  D0,-(A5)  ; PHA
                            	  2003:     ; Get Link's coordinates into [00] and [01].
                            	  2004:     ;
02:0003A704 7400            	  2005:     moveq   #0,D2
02:0003A706 4EB90004CE4C    	  2006:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2007:     ; Switch to the new fireball's object slot.
                            	  2008:     ;
02:0003A70C 7400            	  2009:     moveq   #0,D2
02:0003A70E 142C000A        	  2010:     move.b  ($000A,A4),D2
                            	  2011:     ; Look up and set the X coordinate for the fireball object.
                            	  2012:     ; Also store it in [02].
                            	  2013:     ;
02:0003A712 41F90003A636    	  2014:     lea     (StatueXs).l,A0
02:0003A718 10303000        	  2015:     move.b  (A0,D3.W),D0
02:0003A71C 19400002        	  2016:     move.b  D0,($0002,A4)
02:0003A720 19802070        	  2017:     move.b  D0,($70,A4,D2.W)
                            	  2018:     ; Look up and set the Y coordinate for the fireball object.
                            	  2019:     ; Also store it in [03].
                            	  2020:     ;
02:0003A724 41F90003A63E    	  2021:     lea     (StatueYs).l,A0
02:0003A72A 10303000        	  2022:     move.b  (A0,D3.W),D0
02:0003A72E 19400003        	  2023:     move.b  D0,($0003,A4)
02:0003A732 41EC0084        	  2024:     lea     ($0084,A4),A0
