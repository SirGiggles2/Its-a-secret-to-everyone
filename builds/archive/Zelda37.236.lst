02:0003CDEE 0C030003        	  7478:     cmpi.b  #$03,D3
02:0003CDF2 6712            	  7479:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7480:     ; State 1, substate 1
                            	  7481:     ;
                            	  7482:     ; Add $14 to the frame image index to index into the bloated
                            	  7483:     ; frame images and H-flips.
                            	  7484:     ;
02:0003CDF4 1014            	  7485:     move.b  ($0000,A4),D0
02:0003CDF6 023C00EE        	  7486:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDFA 123C0014        	  7487:     move.b  #$14,D1
02:0003CDFE D101            	  7488:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CE00 7600            	  7489:     moveq   #0,D3
02:0003CE02 1600            	  7490:     move.b  D0,D3
02:0003CE04 6032            	  7491:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7492: 
                            	  7493:     even
                            	  7494: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7495:     ; In bloated substates 2 and 3:
                            	  7496:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7497:     ;
02:0003CE06 102C0015        	  7498:     move.b  ($0015,A4),D0
02:0003CE0A 02000002        	  7499:     andi.b #$02,D0
02:0003CE0E 6604            	  7500:     bne.s  __far_z_04_0066
02:0003CE10 600000A4        	  7501:     jmp  L11B00_Exit
                            	  7502: __far_z_04_0066:
02:0003CE14 7600            	  7503:     moveq   #0,D3
02:0003CE16 1614            	  7504:     move.b  ($0000,A4),D3
02:0003CE18 601E            	  7505:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7506: 
                            	  7507:     even
                            	  7508: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7509:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7510:     ;
02:0003CE1A 7008            	  7511:     moveq   #8,D0
                            	  7512:     even
                            	  7513: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CE1C 7600            	  7514:     moveq   #0,D3
02:0003CE1E 1614            	  7515:     move.b  ($0000,A4),D3
02:0003CE20 122C0015        	  7516:     move.b  ($0015,A4),D1
02:0003CE24 C001            	  7517:     and.b  D1,D0
02:0003CE26 6710            	  7518:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7519:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7520:     ; in order to index into the second set of frame image numbers.
                            	  7521:     ;
02:0003CE28 1003            	  7522:     move.b  D3,D0
02:0003CE2A 023C00EE        	  7523:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE2E 123C0005        	  7524:     move.b  #$05,D1
02:0003CE32 D101            	  7525:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CE34 7600            	  7526:     moveq   #0,D3
02:0003CE36 1600            	  7527:     move.b  D0,D3
                            	  7528:     even
                            	  7529: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7530:     ; Start preparing sprites.
                            	  7531:     ;
02:0003CE38 4EB90004CE4C    	  7532:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CE3E 1003            	  7533:     move.b  D3,D0
02:0003CE40 1B00            	  7534:     move.b  D0,-(A5)  ; PHA
                            	  7535:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7536:     ;
02:0003CE42 41F90003CD9C    	  7537:     lea     (DodongoFrameHFlips).l,A0
02:0003CE48 10303000        	  7538:     move.b  (A0,D3.W),D0
02:0003CE4C 1940000F        	  7539:     move.b  D0,($000F,A4)
02:0003CE50 41F90003CD92    	  7540:     lea     (DodongoFrameImages).l,A0
02:0003CE56 10303000        	  7541:     move.b  (A0,D3.W),D0
                            	  7542:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7543:     ; They are drawn mirrored.
                            	  7544:     ;
02:0003CE5A 0C000007        	  7545:     cmpi.b  #$07,D0
02:0003CE5E 6706            	  7546:     beq  _anon_z04_92
02:0003CE60 0C000009        	  7547:     cmpi.b  #$09,D0
02:0003CE64 6608            	  7548:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7549: _anon_z04_92:
02:0003CE66 4EB9000319A4    	  7550:     jsr     DrawObjectMirrored
02:0003CE6C 6006            	  7551:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7552: 
                            	  7553:     even
                            	  7554: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7555:     ; No other frame images are mirrored.
                            	  7556:     ;
02:0003CE6E 4EB9000319A8    	  7557:     jsr     DrawObjectNotMirrored
                            	  7558:     even
                            	  7559: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CE74 101D            	  7560:     move.b  (A5)+,D0  ; PLA
02:0003CE76 7600            	  7561:     moveq   #0,D3
02:0003CE78 1600            	  7562:     move.b  D0,D3
                            	  7563:     ; If facing vertically, then return. There's no other side to draw.
                            	  7564:     ;
02:0003CE7A 41EC0098        	  7565:     lea     ($0098,A4),A0
02:0003CE7E 10302000        	  7566:     move.b  (A0,D2.W),D0
02:0003CE82 02000003        	  7567:     andi.b #$03,D0
02:0003CE86 6602            	  7568:     bne.s  __far_z_04_0067
02:0003CE88 602C            	  7569:     jmp  L11B00_Exit
                            	  7570: __far_z_04_0067:
                            	  7571:     ; Else draw the right side.
                            	  7572:     ;
                            	  7573:     ; Keep the Y coordinate in [01].
                            	  7574:     ; But, store (X + $10) in [00].
                            	  7575:     ;
02:0003CE8A 10342070        	  7576:     move.b  ($70,A4,D2.W),D0
02:0003CE8E 023C00EE        	  7577:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE92 123C0010        	  7578:     move.b  #$10,D1
02:0003CE96 D101            	  7579:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CE98 1880            	  7580:     move.b  D0,($0000,A4)
02:0003CE9A 6114            	  7581:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7582:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7583:     ;
                            	  7584:     ; So, if we had animation frame 1, direction left:
                            	  7585:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7586:     ; - frame image index = 6 (1 + 5)
                            	  7587:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7588:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7589:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7590:     ;
                            	  7591:     ; So, 3 would have been the frame number used above for
                            	  7592:     ; the left side.
                            	  7593:     ;
                            	  7594:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7595:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7596:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7597:     ; on the right.
                            	  7598:     ;
02:0003CE9C 41F90003CD92    	  7599:     lea     (DodongoFrameImages).l,A0
02:0003CEA2 10303000        	  7600:     move.b  (A0,D3.W),D0
02:0003CEA6 0A000001        	  7601:     eori.b #$01,D0
02:0003CEAA 4EF9000319A8    	  7602:     jmp     DrawObjectNotMirrored
                            	  7603: 
                            	  7604: ; Returns:
                            	  7605: ; A: 3
