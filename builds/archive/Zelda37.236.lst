                            	  6678: ;
                            	  6679:     even
                            	  6680: CheckMonsterBoomerangOrFoodCollision:
02:000320BE 41EC00AC        	  6681:     lea     ($00AC,A4),A0
02:000320C2 10303000        	  6682:     move.b  (A0,D3.W),D0
02:000320C6 E308            	  6683:     lsl.b  #1,D0   ; ASL A
02:000320C8 65F2            	  6684:     bcs  _anon_z01_87
