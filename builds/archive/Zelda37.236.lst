02:0004377E 7400            	  5671:     moveq   #0,D2
02:00043780 1400            	  5672:     move.b  D0,D2
                            	  5673:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5674:     ; starting from highest index down to 0:
                            	  5675:     ;
02:00043782 41F900043670    	  5676:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00043788 10302000        	  5677:     move.b  (A0,D2.W),D0
02:0004378C 7400            	  5678:     moveq   #0,D2
02:0004378E 1400            	  5679:     move.b  D0,D2
                            	  5680:     even
