                            	  6891:     ; Facing up or down.
                            	  6892:     ;
                            	  6893:     ;
                            	  6894:     ; Assume animation frame 3 (up).
02:0004CE12 7603            	  6895:     moveq   #3,D3
02:0004CE14 02000008        	  6896:     andi.b #$08,D0
02:0004CE18 6702            	  6897:     beq.s  __far_z_07_0123
02:0004CE1A 6002            	  6898:     jmp  Anim_SetObjHFlipForSpriteDescriptor
