                            	  4970: 
                            	  4971: ; Each byte describes an item. The high nibble is the type.
                            	  4972: ; The low nibble is the value. Its meaning depends on the type.
                            	  4973: ;
                            	  4974: ; 0x - individuals
                            	  4975: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4976: ; * bit mask: value doesn't matter.
                            	  4977: ;
                            	  4978: ; 1x - amounts
                            	  4979: ; Value is an amount to add.
                            	  4980: ;
                            	  4981: ; 2x - grades
                            	  4982: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4983: ;
                            	  4984: ; 3x - error?
                            	  4985: ; Produces an item value of $FF.
                            	  4986: ;
                            	  4987:     even
