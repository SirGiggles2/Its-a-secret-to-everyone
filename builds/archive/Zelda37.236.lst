02:000364B4 600000C6        	  4551:     jmp  LA9F4_Exit
                            	  4552: __far_z_02_0009:
                            	  4553:     ; Set the timer to wait 6 frames after the next character about
                            	  4554:     ; to be shown.
                            	  4555:     ;
02:000364B8 7006            	  4556:     moveq   #6,D0
02:000364BA 19400029        	  4557:     move.b  D0,($0029,A4)
                            	  4558:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4559:     ; to the dynamic transfer buf.
                            	  4560:     ;
02:000364BE 7604            	  4561:     moveq   #4,D3
                            	  4562: _anon_z02_31:
02:000364C0 41F90003649E    	  4563:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:000364C6 10303000        	  4564:     move.b  (A0,D3.W),D0
02:000364CA 41EC0302        	  4565:     lea     ($0302,A4),A0
