                            	  6496: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6497:     ; Link and the shot are facing opposite directions.
                            	  6498:     ; Link can parry certain weapons/shots.
                            	  6499:     ;
                            	  6500:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6501:     ; no harmful collision; but it still counts as a shot collision.
                            	  6502:     ; So, go treat this as a parry.
                            	  6503:     ;
02:00031F72 41EC034F        	  6504:     lea     ($034F,A4),A0
02:00031F76 10302000        	  6505:     move.b  (A0,D2.W),D0
02:00031F7A 0C000055        	  6506:     cmpi.b  #$55,D0
02:00031F7E 650E            	  6507:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031F80 0C00005B        	  6508:     cmpi.b  #$5B,D0
02:00031F84 6408            	  6509:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6510:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6511:     ; So, go harm Link.
                            	  6512:     ;
02:00031F86 102C0676        	  6513:     move.b  ($0676,A4),D0
02:00031F8A 6602            	  6514:     bne.s  __far_z_01_0066
02:00031F8C 600E            	  6515:     jmp  HarmLink
                            	  6516: __far_z_01_0066:
                            	  6517:     even
