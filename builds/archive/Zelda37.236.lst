02:0003B008 1214            	  3299:     move.b  ($0000,A4),D1
02:0003B00A D101            	  3300:     addx.b  D1,D0   ; ADC $00
                            	  3301:     ; Sanitize the Y coordinate:
                            	  3302:     ; (Y AND $F0) OR $D
                            	  3303:     ;
02:0003B00C 020000F0        	  3304:     andi.b #$F0,D0
02:0003B010 0000000D        	  3305:     ori.b #$0D,D0
02:0003B014 41EC0084        	  3306:     lea     ($0084,A4),A0
