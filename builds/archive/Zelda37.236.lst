                            	  7377: ; Params:
                            	  7378: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7379: ; [00]: weapon object slot (unused)
                            	  7380: ; [02]: object 1 mid X
                            	  7381: ; [03]: object 1 mid Y
                            	  7382: ; [04]: object 2 mid X
                            	  7383: ; [05]: object 2 mid Y
                            	  7384: ;
                            	  7385: ; Returns:
                            	  7386: ; A: 1 if objects collide
                            	  7387: ; Y: weapon object slot
                            	  7388: ; Z: 0 if objects collide
                            	  7389: ; [06]: 1 if objects collide
                            	  7390: ; [0A]: horizontal distance
                            	  7391: ; [0B]: vertical distance
                            	  7392: ;
                            	  7393: ;
                            	  7394: ; Use the same threshold value horizontally and vertically.
                            	  7395: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7396: ;
                            	  7397:     even
