02:0003058A D101            	  2934:     addx.b  D1,D0   ; ADC CurObjIndex
02:0003058C 7400            	  2935:     moveq   #0,D2
02:0003058E 1400            	  2936:     move.b  D0,D2
                            	  2937:     ; Look up and set the location for this iteration's individual trap.
                            	  2938:     ;
02:00030590 41F900030554    	  2939:     lea     (TrapXs).l,A0
02:00030596 10303000        	  2940:     move.b  (A0,D3.W),D0
02:0003059A 19802070        	  2941:     move.b  D0,($70,A4,D2.W)
02:0003059E 41F90003055A    	  2942:     lea     (TrapYs).l,A0
