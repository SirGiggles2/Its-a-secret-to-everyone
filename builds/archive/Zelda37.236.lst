02:00042022 2044            	  3874:     movea.l D4,A0
02:00042024 10303000        	  3875:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042028 020000F8        	  3876:     andi.b #$F8,D0
02:0004202C 1214            	  3877:     move.b  ($00,A4),D1   ; ptr lo
02:0004202E 182C0001        	  3878:     move.b  ($01,A4),D4  ; ptr hi
02:00042032 024100FF        	  3879:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042036 E14C            	  3880:     lsl.w   #8,D4
02:00042038 8841            	  3881:     or.w    D1,D4
02:0004203A 48C4            	  3882:     ext.l   D4
