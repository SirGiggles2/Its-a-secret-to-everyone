02:0003B4BE 610046A0        	  4002:     jsr     DrawFairy
                            	  4003:     ; If not in state 0, then go handle states 1 to 3.
                            	  4004:     ;
02:0003B4C2 102C00AD        	  4005:     move.b  ($00AD,A4),D0
