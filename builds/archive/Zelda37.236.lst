                            	  5034: SpreadShot:
                            	  5035:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5036:     ;
                            	  5037:     ; The shot is spreading out.
                            	  5038:     ;
                            	  5039:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5040:     ; These will be negated appropriately for each corner.
                            	  5041:     ;
02:0004C142 41EC0098        	  5042:     lea     ($0098,A4),A0
02:0004C146 10302000        	  5043:     move.b  (A0,D2.W),D0
02:0004C14A 19400002        	  5044:     move.b  D0,($0002,A4)
02:0004C14E 19400003        	  5045:     move.b  D0,($0003,A4)
                            	  5046:     ; Reset [0F] to not flip horizontally.
                            	  5047:     ;
02:0004C152 7000            	  5048:     moveq   #0,D0
02:0004C154 1940000F        	  5049:     move.b  D0,($000F,A4)
                            	  5050:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5051:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5052:     ;
02:0004C158 7603            	  5053:     moveq   #3,D3
                            	  5054:     even
                            	  5055: _L_z07_SpreadShot_DrawShotCorner:
02:0004C15A 1003            	  5056:     move.b  D3,D0
02:0004C15C 1B00            	  5057:     move.b  D0,-(A5)  ; PHA
                            	  5058:     ; Save offset X [02] and Y offset [03].
                            	  5059:     ;
02:0004C15E 102C0002        	  5060:     move.b  ($0002,A4),D0
02:0004C162 1B00            	  5061:     move.b  D0,-(A5)  ; PHA
02:0004C164 102C0003        	  5062:     move.b  ($0003,A4),D0
02:0004C168 1B00            	  5063:     move.b  D0,-(A5)  ; PHA
                            	  5064:     ; Calculate and set sprite attributes for this corner:
                            	  5065:     ;   base attribute OR (frame counter AND 3)
                            	  5066:     ;
                            	  5067:     ; The base attribute defines how to flip the sprite.
                            	  5068:     ; The frame counter makes the shot flash by cycling each
                            	  5069:     ; palette row.
                            	  5070:     ;
02:0004C16A 102C0015        	  5071:     move.b  ($0015,A4),D0
02:0004C16E 02000003        	  5072:     andi.b #$03,D0
02:0004C172 41F90004BFD0    	  5073:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C178 12303000        	  5074:     move.b  (A0,D3.W),D1
02:0004C17C 8001            	  5075:     or.b  D1,D0
02:0004C17E 4EB900031C9A    	  5076:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5077:     ; Add the object's X (the center of the spread) and the
                            	  5078:     ; current offset in [02] to set sprite X in [00].
                            	  5079:     ;
02:0004C184 10342070        	  5080:     move.b  ($70,A4,D2.W),D0
02:0004C188 023C00EE        	  5081:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C18C 122C0002        	  5082:     move.b  ($0002,A4),D1
02:0004C190 D101            	  5083:     addx.b  D1,D0   ; ADC $02
02:0004C192 1880            	  5084:     move.b  D0,($0000,A4)
                            	  5085:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5086:     ; Else calculate the distance from object X to sprite X.
                            	  5087:     ;
02:0004C194 12342070        	  5088:     move.b  ($70,A4,D2.W),D1
02:0004C198 B001            	  5089:     cmp.b   D1,D0
02:0004C19A 651A            	  5090:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C19C 0C0000FC        	  5091:     cmpi.b  #$FC,D0
02:0004C1A0 6466            	  5092:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C1A2 003C0011        	  5093:     ori     #$11,CCR  ; SEC: set C+X
02:0004C1A6 12342070        	  5094:     move.b  ($70,A4,D2.W),D1
02:0004C1AA 0A3C0010        	  5095:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C1AE 9101            	  5096:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C1B0 0A3C0010        	  5097:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C1B4 6014            	  5098:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5099: 
                            	  5100:     even
                            	  5101: _L_z07_SpreadShot_ReverseSub:
02:0004C1B6 10342070        	  5102:     move.b  ($70,A4,D2.W),D0
02:0004C1BA 003C0011        	  5103:     ori     #$11,CCR  ; SEC: set C+X
02:0004C1BE 1214            	  5104:     move.b  ($0000,A4),D1
02:0004C1C0 0A3C0010        	  5105:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C1C4 9101            	  5106:     subx.b  D1,D0   ; SBC $00
02:0004C1C6 0A3C0010        	  5107:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5108:     even
                            	  5109: _L_z07_SpreadShot_CheckDistance:
                            	  5110:     ; If distance >= $20, skip this corner.
                            	  5111:     ;
02:0004C1CA 0C000020        	  5112:     cmpi.b  #$20,D0
02:0004C1CE 6438            	  5113:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5114:     ; Add the object's Y (the center of the spread) and the
                            	  5115:     ; current offset in [03] to set sprite Y in [01].
                            	  5116:     ;
02:0004C1D0 41EC0084        	  5117:     lea     ($0084,A4),A0
02:0004C1D4 10302000        	  5118:     move.b  (A0,D2.W),D0
02:0004C1D8 023C00EE        	  5119:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C1DC 122C0003        	  5120:     move.b  ($0003,A4),D1
02:0004C1E0 D101            	  5121:     addx.b  D1,D0   ; ADC $03
02:0004C1E2 19400001        	  5122:     move.b  D0,($0001,A4)
                            	  5123:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5124:     ;
02:0004C1E6 7600            	  5125:     moveq   #0,D3
02:0004C1E8 162C0010        	  5126:     move.b  ($0010,A4),D3
02:0004C1EC 670C            	  5127:     beq  _L_z07_SpreadShot_Draw
02:0004C1EE 0C00003E        	  5128:     cmpi.b  #$3E,D0
02:0004C1F2 6514            	  5129:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C1F4 0C0000E8        	  5130:     cmpi.b  #$E8,D0
02:0004C1F8 640E            	  5131:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5132:     even
                            	  5133: _L_z07_SpreadShot_Draw:
                            	  5134:     ; Draw the corner.
                            	  5135:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5136:     ;
02:0004C1FA 7002            	  5137:     moveq   #2,D0
02:0004C1FC 1940000C        	  5138:     move.b  D0,($000C,A4)
