02:0004C620 41F90004C2FA    	  5778:     lea     (BoomerangQSpeedFracsY).l,A0
02:0004C626 10303000        	  5779:     move.b  (A0,D3.W),D0
02:0004C62A 4EB900030F7E    	  5780:     jsr     SetBoomerangSpeed
