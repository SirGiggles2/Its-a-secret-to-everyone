                            	  7341: DodongoBombNegativeLimits:
02:0003CD2E F4              	  7342:     dc.b    $F4, $F0
02:0003CD2F F0
                            	  7343: 
                            	  7344: ; Params:
                            	  7345: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7346: ; [00]: monster hotspot X
                            	  7347: ; [01]: monster hotspot Y
                            	  7348: ; [02]: bomb hotspot X
                            	  7349: ; [03]: bomb hotspot Y
                            	  7350: ;
                            	  7351: ; Returns:
                            	  7352: ; A: 0 if the bomb is in range of the monster
                            	  7353: ; Z: 1 if the bomb is in range of the monster
                            	  7354: ; [04]: horizontal distance
                            	  7355: ; [05]: vertical distance
                            	  7356: ;
                            	  7357: ; Store the positive limit in [06], and the negative one in [07].
                            	  7358: ;
                            	  7359:     even
                            	  7360: Dodongo_IsBombInRange:
02:0003CD30 41F90003CD2C    	  7361:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CD36 10303000        	  7362:     move.b  (A0,D3.W),D0
02:0003CD3A 19400006        	  7363:     move.b  D0,($0006,A4)
02:0003CD3E 41F90003CD2E    	  7364:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CD44 10303000        	  7365:     move.b  (A0,D3.W),D0
02:0003CD48 19400007        	  7366:     move.b  D0,($0007,A4)
                            	  7367:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7368:     ; the bomb is near enough the monster.
                            	  7369:     ;
02:0003CD4C 7003            	  7370:     moveq   #3,D0
02:0003CD4E 19400008        	  7371:     move.b  D0,($0008,A4)
                            	  7372:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7373:     ;
02:0003CD52 7601            	  7374:     moveq   #1,D3
                            	  7375:     even
                            	  7376: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7377:     ; Subtract the bomb's coordinate from the boss's,
                            	  7378:     ; The loop index determines the coordinate.
                            	  7379:     ;
02:0003CD54 10343000        	  7380:     move.b  ($00,A4,D3.W),D0
02:0003CD58 003C0011        	  7381:     ori     #$11,CCR  ; SEC: set C+X
02:0003CD5C 12343002        	  7382:     move.b  ($02,A4,D3.W),D1
02:0003CD60 0A3C0010        	  7383:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CD64 9101            	  7384:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CD66 0A3C0010        	  7385:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7386:     ; If the distance >= positive offset, or < negative offset;
                            	  7387:     ; then loop again.
                            	  7388:     ;
02:0003CD6A 122C0006        	  7389:     move.b  ($0006,A4),D1
02:0003CD6E B001            	  7390:     cmp.b   D1,D0
02:0003CD70 6A16            	  7391:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CD72 122C0007        	  7392:     move.b  ($0007,A4),D1
02:0003CD76 B001            	  7393:     cmp.b   D1,D0
02:0003CD78 6B0E            	  7394:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7395:     ; The distance is close enough in this axis.
                            	  7396:     ;
                            	  7397:     ; Store the distance in this axis in [05] or [04],
                            	  7398:     ; depending on the loop index.
                            	  7399:     ;
02:0003CD7A 19803004        	  7400:     move.b  D0,($04,A4,D3.W)
                            	  7401:     ; Shift [08] right, because we're in range in this axis.
                            	  7402:     ;
02:0003CD7E 122C0008        	  7403:     move.b  ($0008,A4),D1
02:0003CD82 E209            	  7404:     lsr.b  #1,D1   ; LSR $08
02:0003CD84 19410008        	  7405:     move.b  D1,($0008,A4)
                            	  7406:     even
                            	  7407: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CD88 5303            	  7408:     subq.b  #1,D3
02:0003CD8A 6AC8            	  7409:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7410:     ; If close enough in both axes, then [08] will be 0.
                            	  7411:     ;
02:0003CD8C 102C0008        	  7412:     move.b  ($0008,A4),D0
02:0003CD90 4E75            	  7413:     rts
                            	  7414: 
                            	  7415: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7416: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7417: ;
                            	  7418: ; But these are not typical direction indexes. Instead a
                            	  7419: ; 5-way index is used.
                            	  7420: ; A direction shifted right once becomes a 5-way index.
                            	  7421: ; The fourth element is unused.
                            	  7422: ;
                            	  7423:     even
