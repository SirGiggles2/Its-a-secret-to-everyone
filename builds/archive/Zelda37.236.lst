02:0003C308 10302000        	  5961:     move.b  (A0,D2.W),D0
02:0003C30C 41EC0380        	  5962:     lea     ($0380,A4),A0
02:0003C310 11802000        	  5963:     move.b  D0,(A0,D2.W)
                            	  5964:     even
