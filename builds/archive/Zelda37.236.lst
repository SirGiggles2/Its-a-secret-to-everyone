02:0003CB28 023C00EE        	  7039:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB2C 123C0001        	  7040:     move.b  #$01,D1
02:0003CB30 D101            	  7041:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003CB32 41EC0437        	  7042:     lea     ($0437,A4),A0
02:0003CB36 11802000        	  7043:     move.b  D0,(A0,D2.W)
