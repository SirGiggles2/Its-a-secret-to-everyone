02:0003C710 41EC0098        	  6493:     lea     ($0098,A4),A0
02:0003C714 10302000        	  6494:     move.b  (A0,D2.W),D0
02:0003C718 122C0002        	  6495:     move.b  ($0002,A4),D1
02:0003C71C E309            	  6496:     lsl.b  #1,D1   ; ASL $02
02:0003C71E 19410002        	  6497:     move.b  D1,($0002,A4)
02:0003C722 122C0002        	  6498:     move.b  ($0002,A4),D1
02:0003C726 C200            	  6499:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C728 671E            	  6500:     beq  _L_z04_Digdogger_Move_End
02:0003C72A 41EC0084        	  6501:     lea     ($0084,A4),A0
02:0003C72E 10302000        	  6502:     move.b  (A0,D2.W),D0
02:0003C732 122C0003        	  6503:     move.b  ($0003,A4),D1
02:0003C736 0A3C0010        	  6504:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C73A 9101            	  6505:     subx.b  D1,D0   ; SBC $03
02:0003C73C 0A3C0010        	  6506:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C740 41EC0084        	  6507:     lea     ($0084,A4),A0
02:0003C744 11802000        	  6508:     move.b  D0,(A0,D2.W)
                            	  6509:     even
