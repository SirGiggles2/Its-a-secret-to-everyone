                            	 12943: Ganon_DrawBody:
                            	 12944:     ; Loop over four 16x16 images that make up Ganon.
                            	 12945:     ; There are 6 animation frames.
                            	 12946:     ;
02:0003F666 7603            	 12947:     moveq   #3,D3
                            	 12948:     even
                            	 12949: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12950:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12951:     ;
02:0003F668 10342070        	 12952:     move.b  ($70,A4,D2.W),D0
02:0003F66C 023C00EE        	 12953:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F670 41F90003F65A    	 12954:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F676 12303000        	 12955:     move.b  (A0,D3.W),D1
02:0003F67A D101            	 12956:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F67C 1880            	 12957:     move.b  D0,($0000,A4)
                            	 12958:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12959:     ;
02:0003F67E 41EC0084        	 12960:     lea     ($0084,A4),A0
02:0003F682 10302000        	 12961:     move.b  (A0,D2.W),D0
02:0003F686 023C00EE        	 12962:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F68A 41F90003F65E    	 12963:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F690 12303000        	 12964:     move.b  (A0,D3.W),D1
02:0003F694 D101            	 12965:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F696 19400001        	 12966:     move.b  D0,($0001,A4)
                            	 12967:     ; Each part has a horizontal flipping flag.
                            	 12968:     ;
02:0003F69A 41F90003F662    	 12969:     lea     (GanonSpriteHFlips).l,A0
02:0003F6A0 10303000        	 12970:     move.b  (A0,D3.W),D0
02:0003F6A4 1940000F        	 12971:     move.b  D0,($000F,A4)
                            	 12972:     ; Save and copy the loop index (the current part) to [07].
                            	 12973:     ;
02:0003F6A8 1003            	 12974:     move.b  D3,D0
02:0003F6AA 1B00            	 12975:     move.b  D0,-(A5)  ; PHA
02:0003F6AC 19400007        	 12976:     move.b  D0,($0007,A4)
                            	 12977:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12978:     ; that make it up.
                            	 12979:     ;
02:0003F6B0 41EC046B        	 12980:     lea     ($046B,A4),A0
02:0003F6B4 10302000        	 12981:     move.b  (A0,D2.W),D0
02:0003F6B8 E308            	 12982:     lsl.b  #1,D0   ; ASL A
02:0003F6BA E308            	 12983:     lsl.b  #1,D0   ; ASL A
                            	 12984:     ; Add [07] -- the index of the current part.
                            	 12985:     ;
                            	 12986:     ; Now you have an index into the frame image table, for the
                            	 12987:     ; current image part of the current animation frame.
                            	 12988:     ;
02:0003F6BC 122C0007        	 12989:     move.b  ($0007,A4),D1
02:0003F6C0 D101            	 12990:     addx.b  D1,D0   ; ADC $07
02:0003F6C2 7600            	 12991:     moveq   #0,D3
02:0003F6C4 1600            	 12992:     move.b  D0,D3
02:0003F6C6 41F90003F642    	 12993:     lea     (GanonFrameImages).l,A0
02:0003F6CC 10303000        	 12994:     move.b  (A0,D3.W),D0
02:0003F6D0 4EB9000319A8    	 12995:     jsr     DrawObjectNotMirrored
02:0003F6D6 101D            	 12996:     move.b  (A5)+,D0  ; PLA
                            	 12997:     ; Bottom of the part loop.
                            	 12998:     ;
02:0003F6D8 7600            	 12999:     moveq   #0,D3
02:0003F6DA 1600            	 13000:     move.b  D0,D3
02:0003F6DC 5303            	 13001:     subq.b  #1,D3
02:0003F6DE 6A88            	 13002:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F6E0 4E75            	 13003:     rts
