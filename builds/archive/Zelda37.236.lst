                            	  6625:     even
                            	  6626: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6627:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6628:     ;   full heart=4 partial heart=$70
                            	  6629:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6630:     ; But the method here yields $3EF, because partial heart is
                            	  6631:     ; considered full when = $FF instead of $100.
                            	  6632:     ;
02:00032062 102C000E        	  6633:     move.b  ($000E,A4),D0
02:00032066 003C0011        	  6634:     ori     #$11,CCR  ; SEC: set C+X
02:0003206A 122C0670        	  6635:     move.b  ($0670,A4),D1
02:0003206E 0A3C0010        	  6636:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032072 9101            	  6637:     subx.b  D1,D0   ; SBC HeartPartial
02:00032074 0A3C0010        	  6638:     eori    #$10,CCR  ; restore X = 6502 C
02:00032078 1940000E        	  6639:     move.b  D0,($000E,A4)
02:0003207C 102C066F        	  6640:     move.b  ($066F,A4),D0
02:00032080 0200000F        	  6641:     andi.b #$0F,D0
02:00032084 6710            	  6642:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00032086 532C066F        	  6643:     subq.b  #1,($066F,A4)
02:0003208A 103C00FF        	  6644:     move.b  #$FF,D0
02:0003208E 19400670        	  6645:     move.b  D0,($0670,A4)
02:00032092 6600FF6E        	  6646:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6647:     even
                            	  6648: _L_z01_Link_BeHarmed_HandleDied:
                            	  6649:     ; Link died.
                            	  6650:     ;
                            	  6651:     ; Set full hearts, partial heart, and Link's object state to 0.
                            	  6652:     ; Make Link face down.
                            	  6653:     ; Go to mode $11.
                            	  6654:     ;
02:00032096 102C066F        	  6655:     move.b  ($066F,A4),D0
02:0003209A 020000F0        	  6656:     andi.b #$F0,D0
02:0003209E 1940066F        	  6657:     move.b  D0,($066F,A4)
02:000320A2 4EB90004B3D2    	  6658:     jsr     EndGameMode
02:000320A8 19400670        	  6659:     move.b  D0,($0670,A4)
02:000320AC 194000AC        	  6660:     move.b  D0,($00AC,A4)
02:000320B0 7011            	  6661:     moveq   #17,D0
02:000320B2 19400012        	  6662:     move.b  D0,($0012,A4)
02:000320B6 7004            	  6663:     moveq   #4,D0
02:000320B8 19400098        	  6664:     move.b  D0,($0098,A4)
                            	  6665: _anon_z01_87:
02:000320BC 4E75            	  6666:     rts
                            	  6667: 
                            	  6668: ; Params:
                            	  6669: ; X: monster slot
                            	  6670: ; Y: weapon slot
                            	  6671: ; [02]: monster mid X
                            	  6672: ; [03]: monster mid Y
                            	  6673: ;
                            	  6674: ; Returns:
                            	  6675: ; [00]: weapon slot
                            	  6676: ;
