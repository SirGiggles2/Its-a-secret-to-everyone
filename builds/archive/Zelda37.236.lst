02:0003C4C8 52302000        	  6227:     addq.b  #1,(A0,D2.W)
02:0003C4CC 41EC0478        	  6228:     lea     ($0478,A4),A0
02:0003C4D0 10302000        	  6229:     move.b  (A0,D2.W),D0
02:0003C4D4 0C000004        	  6230:     cmpi.b  #$04,D0
02:0003C4D8 659E            	  6231:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  6232:     ; Restore the original coordinates.
