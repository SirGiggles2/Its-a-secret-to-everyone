02:0004033A 102C0010        	   501:     move.b  ($0010,A4),D0
02:0004033E 6606            	   502:     bne.s  __far_z_05_0002
02:00040340 4EF90002D554    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:00040346 61004FFC        	   505:     jsr     HasCompass
02:0004034A 6606            	   506:     bne.s  __far_z_05_0003
