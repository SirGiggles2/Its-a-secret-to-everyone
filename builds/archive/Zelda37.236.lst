                            	  4962: __far_z_07_0075:
                            	  4963:     ; This is a magic shot.
                            	  4964:     ;
                            	  4965:     ; If missing the magic book, go deactivate the shot object.
                            	  4966:     ;
02:0004C0BC 102C0661        	  4967:     move.b  ($0661,A4),D0
