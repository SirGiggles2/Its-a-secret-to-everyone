02:000421C6 41F900042188    	  4090:     lea     (DoorwayBoundsMaxOver).l,A0
02:000421CC 12303000        	  4091:     move.b  (A0,D3.W),D1
02:000421D0 B001            	  4092:     cmp.b   D1,D0
