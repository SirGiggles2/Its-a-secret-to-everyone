                            	  7444: Dodongo_Draw:
02:0003CDBA 610000F4        	  7445:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7446:     ; Make a 5-way direction index out of the facing direction
                            	  7447:     ; by shifting right once, and store it in [00].
                            	  7448:     ;
02:0003CDBE 41EC0098        	  7449:     lea     ($0098,A4),A0
02:0003CDC2 10302000        	  7450:     move.b  (A0,D2.W),D0
02:0003CDC6 E208            	  7451:     lsr.b  #1,D0   ; LSR A
02:0003CDC8 1880            	  7452:     move.b  D0,($0000,A4)
                            	  7453:     ; If state = 0, go handle animating the two frames of this state.
                            	  7454:     ;
02:0003CDCA 7600            	  7455:     moveq   #0,D3
02:0003CDCC 41EC00AC        	  7456:     lea     ($00AC,A4),A0
02:0003CDD0 16302000        	  7457:     move.b  (A0,D2.W),D3
02:0003CDD4 6744            	  7458:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7459:     ; If state > 1, then the monster is stunned (state 2).
                            	  7460:     ; So, go switch frames every $20 screen frames.
                            	  7461:     ;
02:0003CDD6 7020            	  7462:     moveq   #32,D0
02:0003CDD8 5303            	  7463:     subq.b  #1,D3
02:0003CDDA 6640            	  7464:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7465:     ; State = 1. Bloated.
                            	  7466:     ;
                            	  7467:     ; In substate 0, go animate as usual for walking.
                            	  7468:     ;
02:0003CDDC 7600            	  7469:     moveq   #0,D3
02:0003CDDE 41EC042C        	  7470:     lea     ($042C,A4),A0
02:0003CDE2 16302000        	  7471:     move.b  (A0,D2.W),D3
02:0003CDE6 6732            	  7472:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7473:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7474:     ; go fade the boss; so that some frames are not drawn.
