02:0003D1A0 7600            	  7961:     moveq   #0,D3
02:0003D1A2 1600            	  7962:     move.b  D0,D3
02:0003D1A4 41F90003CFB4    	  7963:     lea     (PolsVoiceDirections).l,A0
02:0003D1AA 10303000        	  7964:     move.b  (A0,D3.W),D0
02:0003D1AE 41EC0098        	  7965:     lea     ($0098,A4),A0
02:0003D1B2 11802000        	  7966:     move.b  D0,(A0,D2.W)
                            	  7967:     ; Randomly set distance-to-move to $30 or $70.
                            	  7968:     ;
