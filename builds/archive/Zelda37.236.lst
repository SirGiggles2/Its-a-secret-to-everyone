                            	  6521:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6522:     ;
02:00031F8E 7001            	  6523:     moveq   #1,D0
02:00031F90 19400604        	  6524:     move.b  D0,($0604,A4)
02:00031F94 7000            	  6525:     moveq   #0,D0
