                            	  2773: _anon_z04_37:
02:0003ABF6 61000196        	  2774:     jsr     Jumper_PointBoulderDownward
                            	  2775:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2776:     ;
02:0003ABFA 7000            	  2777:     moveq   #0,D0
02:0003ABFC 41EC0451        	  2778:     lea     ($0451,A4),A0
02:0003AC00 11802000        	  2779:     move.b  D0,(A0,D2.W)
                            	  2780:     ; Get the base offset for the kind of jumper the object is.
                            	  2781:     ;
02:0003AC04 6100015E        	  2782:     jsr     Jumper_GetKind
02:0003AC08 41F90003AAF4    	  2783:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003AC0E 10303000        	  2784:     move.b  (A0,D3.W),D0
                            	  2785:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2786:     ;
                            	  2787:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2788:     ; does not have $B elements like the tektites' sets.
                            	  2789:     ;
                            	  2790:     ; Boulder does not need the upward accelerations.
                            	  2791:     ; So, the elements for those are used for the starting speeds
                            	  2792:     ; at 04:88F2.
                            	  2793:     ;
02:0003AC12 023C00EE        	  2794:     andi    #$EE,CCR  ; CLC: clear C+X
