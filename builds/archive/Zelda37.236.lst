                            	  9744: UpdateGohma:
                            	  9745:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9746:     ;
02:0003DF0C 41EC0451        	  9747:     lea     ($0451,A4),A0
02:0003DF10 10302000        	  9748:     move.b  (A0,D2.W),D0
02:0003DF14 662C            	  9749:     bne  _L_z04_UpdateGohma_Move
                            	  9750:     ; If Random:
                            	  9751:     ;   >= $B0: right
                            	  9752:     ;   >= $60: left
                            	  9753:     ;   Else:   down
                            	  9754:     ;
02:0003DF16 7001            	  9755:     moveq   #1,D0
02:0003DF18 7600            	  9756:     moveq   #0,D3
02:0003DF1A 16342018        	  9757:     move.b  ($18,A4,D2.W),D3
02:0003DF1E 0C0300B0        	  9758:     cmpi.b  #$B0,D3
02:0003DF22 640A            	  9759:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DF24 E308            	  9760:     lsl.b  #1,D0   ; ASL A
02:0003DF26 0C030060        	  9761:     cmpi.b  #$60,D3
02:0003DF2A 6402            	  9762:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DF2C E308            	  9763:     lsl.b  #1,D0   ; ASL A
