                            	   764: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   765:     ; Replace the low byte of the VRAM address with the one
                            	   766:     ; where the next character should be written.
                            	   767:     ;
02:0002E650 102C045F        	   768:     move.b  ($045F,A4),D0
02:0002E654 19400303        	   769:     move.b  D0,($0303,A4)
                            	   770:     ; Increment the low VRAM address for the next character.
                            	   771:     ;
02:0002E658 522C045F        	   772:     addq.b  #1,($045F,A4)
                            	   773:     ; Use the person text selector to look up the address of the
                            	   774:     ; text for the textbox. Store the address in [00:01].
                            	   775:     ;
02:0002E65C 7600            	   776:     moveq   #0,D3
02:0002E65E 162C0415        	   777:     move.b  ($0415,A4),D3
02:0002E662 41F90002DC98    	   778:     lea     (PersonTextAddrs).l,A0
02:0002E668 10303000        	   779:     move.b  (A0,D3.W),D0
02:0002E66C 1880            	   780:     move.b  D0,($0000,A4)
02:0002E66E 5203            	   781:     addq.b  #1,D3
02:0002E670 41F90002DC98    	   782:     lea     (PersonTextAddrs).l,A0
02:0002E676 10303000        	   783:     move.b  (A0,D3.W),D0
02:0002E67A 19400001        	   784:     move.b  D0,($0001,A4)
                            	   785:     ; Load the person text current character index.
                            	   786:     ;
02:0002E67E 7600            	   787:     moveq   #0,D3
02:0002E680 162C0416        	   788:     move.b  ($0416,A4),D3
                            	   789:     ; Increment the index variable to point to the next character
                            	   790:     ; for next time.
                            	   791:     ;
02:0002E684 522C0416        	   792:     addq.b  #1,($0416,A4)
                            	   793:     ; Get the current character.
                            	   794:     ;
02:0002E688 1214            	   795:     move.b  ($00,A4),D1   ; ptr lo
02:0002E68A 182C0001        	   796:     move.b  ($01,A4),D4  ; ptr hi
02:0002E68E 024100FF        	   797:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E692 E14C            	   798:     lsl.w   #8,D4
02:0002E694 8841            	   799:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E696 48C4            	   800:     ext.l   D4
02:0002E698 D8BC00FF0000    	   801:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E69E 2044            	   802:     movea.l D4,A0
02:0002E6A0 10303000        	   803:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   804:     ; If the character is $25, then it's a special space. It will still
                            	   805:     ; take up space, but will not take time to show -- meaning that
                            	   806:     ; we'll go look up the next character to transfer.
                            	   807:     ;
02:0002E6A4 0200003F        	   808:     andi.b #$3F,D0
02:0002E6A8 0C000025        	   809:     cmpi.b  #$25,D0
02:0002E6AC 67A2            	   810:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   811:     ; We have a non-space character. Put it in the transfer record.
                            	   812:     ;
02:0002E6AE 19400305        	   813:     move.b  D0,($0305,A4)
                            	   814:     ; Play the "heart taken/character" sound effect.
                            	   815:     ;
02:0002E6B2 7010            	   816:     moveq   #16,D0
02:0002E6B4 19400604        	   817:     move.b  D0,($0604,A4)
                            	   818:     ; If the high 2 bits of character element = 0, then return.
                            	   819:     ;
02:0002E6B8 1214            	   820:     move.b  ($00,A4),D1   ; ptr lo
02:0002E6BA 182C0001        	   821:     move.b  ($01,A4),D4  ; ptr hi
02:0002E6BE 024100FF        	   822:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E6C2 E14C            	   823:     lsl.w   #8,D4
02:0002E6C4 8841            	   824:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E6C6 48C4            	   825:     ext.l   D4
02:0002E6C8 D8BC00FF0000    	   826:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E6CE 2044            	   827:     movea.l D4,A0
02:0002E6D0 10303000        	   828:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E6D4 020000C0        	   829:     andi.b #$C0,D0
02:0002E6D8 672E            	   830:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   831:     ; Determine an index based on the high 2 bits of the character element:
                            	   832:     ;   $80: 0
                            	   833:     ;   $40: 1
                            	   834:     ;   $C0: 2
                            	   835:     ;
02:0002E6DA 7602            	   836:     moveq   #2,D3
02:0002E6DC 0C0000C0        	   837:     cmpi.b  #$C0,D0
02:0002E6E0 670A            	   838:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E6E2 5303            	   839:     subq.b  #1,D3
