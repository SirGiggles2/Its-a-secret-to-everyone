                            	  8305: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8306:     ; If the teleporting distance remaining is even, then draw
                            	  8307:     ; and check collisions, else return.
                            	  8308:     ;
                            	  8309:     ; This means that when 0, the monster is walking.
                            	  8310:     ; So, draw and check collisions every frame.
                            	  8311:     ;
                            	  8312:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8313:     ; translucently -- every other frame.
                            	  8314:     ;
02:0003D470 41EC0394        	  8315:     lea     ($0394,A4),A0
02:0003D474 10302000        	  8316:     move.b  (A0,D2.W),D0
02:0003D478 E208            	  8317:     lsr.b  #1,D0   ; LSR A
02:0003D47A 6402            	  8318:     bcc.s  __far_z_04_0071
02:0003D47C 603A            	  8319:     jmp  L11E17_Exit
                            	  8320: __far_z_04_0071:
                            	  8321:     even
