02:0003ED3A 6602            	 11638:     bne.s  __far_z_04_0114
02:0003ED3C 60F2            	 11639:     jmp  L129EA_Exit
                            	 11640: __far_z_04_0114:
                            	 11641:     ; If we have the magic clock, then go draw and check collisions.
                            	 11642:     ;
02:0003ED3E 102C066C        	 11643:     move.b  ($066C,A4),D0
02:0003ED42 6614            	 11644:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
02:0003ED44 6100027C        	 11645:     jsr     Lamnola_Move
                            	 11646:     ; If the current segment is a head, then update the direction it's facing.
                            	 11647:     ;
02:0003ED48 0C020005        	 11648:     cmpi.b  #$05,D2
02:0003ED4C 6706            	 11649:     beq  _anon_z04_150
02:0003ED4E 0C02000A        	 11650:     cmpi.b  #$0A,D2
02:0003ED52 6604            	 11651:     bne  _L_z04_UpdateLamnola_DrawAndCheckCollisions
                            	 11652: _anon_z04_150:
