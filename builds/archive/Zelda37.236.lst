                            	  9647:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9648:     ;
02:0003DE2C 41EC0098        	  9649:     lea     ($0098,A4),A0
02:0003DE30 10302000        	  9650:     move.b  (A0,D2.W),D0
02:0003DE34 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003DE38 E309            	  9652:     lsl.b  #1,D1   ; ASL $02
02:0003DE3A 19410002        	  9653:     move.b  D1,($0002,A4)
02:0003DE3E 122C0002        	  9654:     move.b  ($0002,A4),D1
02:0003DE42 C200            	  9655:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE44 6716            	  9656:     beq  _L_z04_Manhandla_Move_Up
02:0003DE46 41EC0084        	  9657:     lea     ($0084,A4),A0
02:0003DE4A 10302000        	  9658:     move.b  (A0,D2.W),D0
02:0003DE4E 122C0003        	  9659:     move.b  ($0003,A4),D1
02:0003DE52 D101            	  9660:     addx.b  D1,D0   ; ADC $03
02:0003DE54 41EC0084        	  9661:     lea     ($0084,A4),A0
