                            	  5145:     ; First, restore X offset [02] and Y offset [03].
                            	  5146:     ;
02:0004C208 101D            	  5147:     move.b  (A5)+,D0  ; PLA
02:0004C20A 19400003        	  5148:     move.b  D0,($0003,A4)
