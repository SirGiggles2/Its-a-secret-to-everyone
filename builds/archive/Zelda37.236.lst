02:0003AFEC 41EC0098        	  3288:     lea     ($0098,A4),A0
02:0003AFF0 10302000        	  3289:     move.b  (A0,D2.W),D0
02:0003AFF4 02000008        	  3290:     andi.b #$08,D0
02:0003AFF8 6704            	  3291:     beq  _anon_z04_44
02:0003AFFA 163C00D8        	  3292:     move.b  #$D8,D3
                            	  3293: _anon_z04_44:
