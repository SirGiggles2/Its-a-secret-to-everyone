                            	  3920: UpdateArmos:
02:0003B430 6100E7EA        	  3921:     jsr     UpdateGoriya
                            	  3922:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3923:     ;
02:0003B434 41EC00C0        	  3924:     lea     ($00C0,A4),A0
02:0003B438 10302000        	  3925:     move.b  (A0,D2.W),D0
02:0003B43C 6702            	  3926:     beq.s  __far_z_04_0033
02:0003B43E 602A            	  3927:     jmp  DrawArmosAndCheckCollisions
                            	  3928: __far_z_04_0033:
                            	  3929:     ; Animate.
                            	  3930:     ;
                            	  3931:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3932:     ; then only go draw.
                            	  3933:     ;
02:0003B440 41EC03D0        	  3934:     lea     ($03D0,A4),A0
02:0003B444 53302000        	  3935:     subq.b  #1,(A0,D2.W)
02:0003B448 6702            	  3936:     beq.s  __far_z_04_0034
02:0003B44A 601E            	  3937:     jmp  DrawArmosAndCheckCollisions
                            	  3938: __far_z_04_0034:
                            	  3939:     ; Armos animation frames last 6 screen frames.
                            	  3940:     ;
02:0003B44C 7006            	  3941:     moveq   #6,D0
02:0003B44E 41EC03D0        	  3942:     lea     ($03D0,A4),A0
02:0003B452 11802000        	  3943:     move.b  D0,(A0,D2.W)
                            	  3944:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3945:     ; change the position of the shield. To keep fixed it in place,
                            	  3946:     ; there are separate frame images for each animation frame.
                            	  3947:     ;
                            	  3948:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3949:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3950:     ;
                            	  3951:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3952:     ; Then choose the direction at the point of drawing below.
                            	  3953:     ;
02:0003B456 41EC03E4        	  3954:     lea     ($03E4,A4),A0
02:0003B45A 10302000        	  3955:     move.b  (A0,D2.W),D0
02:0003B45E 0A000002        	  3956:     eori.b #$02,D0
02:0003B462 41EC03E4        	  3957:     lea     ($03E4,A4),A0
02:0003B466 11802000        	  3958:     move.b  D0,(A0,D2.W)
                            	  3959:     even
                            	  3960: DrawArmosAndCheckCollisions:
02:0003B46A 4EB90004CE4C    	  3961:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B470 7600            	  3962:     moveq   #0,D3
02:0003B472 41EC0098        	  3963:     lea     ($0098,A4),A0
02:0003B476 16302000        	  3964:     move.b  (A0,D2.W),D3
                            	  3965:     ; If facing up, then use the second frame image in the set ("back").
                            	  3966:     ; Else use the second.
                            	  3967:     ;
02:0003B47A 0C030008        	  3968:     cmpi.b  #$08,D3
02:0003B47E 6602            	  3969:     bne  _anon_z04_54
02:0003B480 7001            	  3970:     moveq   #1,D0
                            	  3971: _anon_z04_54:
02:0003B482 023C00EE        	  3972:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B486 41EC03E4        	  3973:     lea     ($03E4,A4),A0
02:0003B48A 12302000        	  3974:     move.b  (A0,D2.W),D1
02:0003B48E D101            	  3975:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B490 4EB9000319A8    	  3976:     jsr     DrawObjectNotMirrored
                            	  3977:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3978:     ; but not with weapons.
                            	  3979:     ;
02:0003B496 10342028        	  3980:     move.b  ($28,A4,D2.W),D0
