02:0003A5EA 6720            	  1823:     beq  _L_z04_Gel_MoveSplitting_Exit
                            	  1824:     ; Move.
                            	  1825:     ;
02:0003A5EC 4EB90004BAB0    	  1826:     jsr     MoveObject
                            	  1827:     ; Mask the grid offset with $F (to a square length),
                            	  1828:     ; and return C=0.
                            	  1829:     ;
02:0003A5F2 41EC0394        	  1830:     lea     ($0394,A4),A0
02:0003A5F6 10302000        	  1831:     move.b  (A0,D2.W),D0
02:0003A5FA 0200000F        	  1832:     andi.b #$0F,D0
02:0003A5FE 023C00EE        	  1833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A602 6608            	  1834:     bne  _L_z04_Gel_MoveSplitting_Exit
02:0003A604 41EC0394        	  1835:     lea     ($0394,A4),A0
02:0003A608 11802000        	  1836:     move.b  D0,(A0,D2.W)
                            	  1837:     even
