                            	  4342: 
                            	  4343: ; Params:
                            	  4344: ; Y: middle speed index (4)
                            	  4345: ; [03]: horizontal distance
                            	  4346: ; [04]: vertical distance
                            	  4347: ; [0A]: vertical direction
                            	  4348: ; [0B]: horizontal direction
                            	  4349: ;
                            	  4350: ; Returns:
                            	  4351: ; Y: speed index (0 to 8) for the angle
                            	  4352: ;
                            	  4353: ;
                            	  4354: ; TODO: call it speed index or angle?
                            	  4355: ; Store the middle speed index in [00]. It will be changed to the
                            	  4356: ; right speed index to use incrementally.
                            	  4357: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4358: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4359: ;
                            	  4360:     even
                            	  4361: _CalcDiagonalSpeedIndex:
02:00030EF8 1883            	  4362:     move.b  D3,($0000,A4)
                            	  4363:     ; Assuming horizontal distance >= vertical distance, the
                            	  4364:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4365:     ;
02:00030EFA 103C00FF        	  4366:     move.b  #$FF,D0
02:00030EFE 19400001        	  4367:     move.b  D0,($0001,A4)
                            	  4368:     ; TODO:
                            	  4369:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4370:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4371:     ;
                            	  4372:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4373:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4374:     ; of the farther distance faster.
                            	  4375:     ;
02:00030F02 102C0003        	  4376:     move.b  ($0003,A4),D0
02:00030F06 122C0004        	  4377:     move.b  ($0004,A4),D1
02:00030F0A B001            	  4378:     cmp.b   D1,D0
02:00030F0C 6416            	  4379:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:00030F0E 1B00            	  4380:     move.b  D0,-(A5)  ; PHA
02:00030F10 102C0004        	  4381:     move.b  ($0004,A4),D0
02:00030F14 19400003        	  4382:     move.b  D0,($0003,A4)
02:00030F18 101D            	  4383:     move.b  (A5)+,D0  ; PLA
02:00030F1A 19400004        	  4384:     move.b  D0,($0004,A4)
02:00030F1E 7001            	  4385:     moveq   #1,D0
02:00030F20 19400001        	  4386:     move.b  D0,($0001,A4)
                            	  4387:     even
                            	  4388: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4389:     ; TODO: call it speed index or angle?
                            	  4390:     ; If the difference in distances is within 8 pixels,
                            	  4391:     ; return the speed index (angle) we have.
                            	  4392:     ;
02:00030F24 102C0003        	  4393:     move.b  ($0003,A4),D0
02:00030F28 003C0011        	  4394:     ori     #$11,CCR  ; SEC: set C+X
02:00030F2C 122C0004        	  4395:     move.b  ($0004,A4),D1
02:00030F30 0A3C0010        	  4396:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030F34 9101            	  4397:     subx.b  D1,D0   ; SBC $04
02:00030F36 0A3C0010        	  4398:     eori    #$10,CCR  ; restore X = 6502 C
02:00030F3A 0C000008        	  4399:     cmpi.b  #$08,D0
02:00030F3E 6538            	  4400:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4401:     even
                            	  4402: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4403:     ; TODO: call it speed index or angle?
                            	  4404:     ; Otherwise, go to the next speed index (angle).
                            	  4405:     ;
02:00030F40 1014            	  4406:     move.b  ($0000,A4),D0
02:00030F42 023C00EE        	  4407:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030F46 122C0001        	  4408:     move.b  ($0001,A4),D1
02:00030F4A D101            	  4409:     addx.b  D1,D0   ; ADC $01
02:00030F4C 1880            	  4410:     move.b  D0,($0000,A4)
                            	  4411:     ; TODO: call it speed index or angle?
                            	  4412:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4413:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4414:     ;
02:00030F4E 6728            	  4415:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030F50 0C000008        	  4416:     cmpi.b  #$08,D0
02:00030F54 6722            	  4417:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4418:     ; Subtract the lesser distance from the greater distance.
                            	  4419:     ; If they still haven't crossed, then we can turn more.
                            	  4420:     ;
02:00030F56 102C0003        	  4421:     move.b  ($0003,A4),D0
02:00030F5A 003C0011        	  4422:     ori     #$11,CCR  ; SEC: set C+X
02:00030F5E 122C0004        	  4423:     move.b  ($0004,A4),D1
02:00030F62 0A3C0010        	  4424:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030F66 9101            	  4425:     subx.b  D1,D0   ; SBC $04
02:00030F68 0A3C0010        	  4426:     eori    #$10,CCR  ; restore X = 6502 C
02:00030F6C 19400003        	  4427:     move.b  D0,($0003,A4)
02:00030F70 122C0004        	  4428:     move.b  ($0004,A4),D1
02:00030F74 B001            	  4429:     cmp.b   D1,D0
02:00030F76 64C8            	  4430:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4431:     even
