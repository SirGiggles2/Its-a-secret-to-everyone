                            	  3331:     ; If facing right, then use X offset $28.
                            	  3332:     ; Else store X offset -$28 in [00].
                            	  3333:     ;
02:0003B036 7628            	  3334:     moveq   #40,D3
02:0003B038 41EC0098        	  3335:     lea     ($0098,A4),A0
