                            	  7258: Dodongo_TryEatBomb:
                            	  7259:     ; Try to eat the bomb.
                            	  7260:     ;
                            	  7261:     ; If the bomb is not in range of the monster, then return.
                            	  7262:     ;
                            	  7263:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7264:     ;
02:0003CCBE 7601            	  7265:     moveq   #1,D3
02:0003CCC0 616E            	  7266:     jsr     Dodongo_IsBombInRange
02:0003CCC2 6666            	  7267:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7268:     ; Will loop from 1 to 0, indexed by [00].
                            	  7269:     ;
02:0003CCC4 7001            	  7270:     moveq   #1,D0
02:0003CCC6 1880            	  7271:     move.b  D0,($0000,A4)
                            	  7272:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7273:     ;
02:0003CCC8 41EC0098        	  7274:     lea     ($0098,A4),A0
02:0003CCCC 10302000        	  7275:     move.b  (A0,D2.W),D0
02:0003CCD0 E208            	  7276:     lsr.b  #1,D0   ; LSR A
02:0003CCD2 7600            	  7277:     moveq   #0,D3
02:0003CCD4 1600            	  7278:     move.b  D0,D3
                            	  7279:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7280:     ; position depends on the orientation of the monster.
                            	  7281:     ;
                            	  7282:     ; Start with the horizontal distance.
                            	  7283:     ;
02:0003CCD6 102C0004        	  7284:     move.b  ($0004,A4),D0
                            	  7285:     even
                            	  7286: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7287:     ; Look up the limits for the given direction.
                            	  7288:     ;
                            	  7289:     ; If the distance from the bomb < negative limit,
                            	  7290:     ; or >= positive limit, then return.
                            	  7291:     ;
                            	  7292:     ; Note that these are simple signed comparisons that work,
                            	  7293:     ; because the operands are in a small range.
                            	  7294:     ;
02:0003CCDA 41F90003CC14    	  7295:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CCE0 12303000        	  7296:     move.b  (A0,D3.W),D1
02:0003CCE4 B001            	  7297:     cmp.b   D1,D0
02:0003CCE6 6B42            	  7298:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CCE8 41F90003CC1A    	  7299:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CCEE 12303000        	  7300:     move.b  (A0,D3.W),D1
02:0003CCF2 B001            	  7301:     cmp.b   D1,D0
02:0003CCF4 6A34            	  7302:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7303:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7304:     ;
02:0003CCF6 1003            	  7305:     move.b  D3,D0
02:0003CCF8 023C00EE        	  7306:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCFC 123C000A        	  7307:     move.b  #$0A,D1
