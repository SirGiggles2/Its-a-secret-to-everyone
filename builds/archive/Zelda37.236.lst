                            	  3438: CheckCaveEdge:
02:00041D2C 4EB90004BC56    	  3439:     jsr     CheckScreenEdge
                            	  3440:     ; If the player touched the edge of the screen and triggered
                            	  3441:     ; a transition to another mode, then go set up the right mode.
                            	  3442:     ;
02:00041D32 102C0011        	  3443:     move.b  ($0011,A4),D0
02:00041D36 6602            	  3444:     bne.s  __far_z_05_0063
02:00041D38 60E4            	  3445:     jmp  GoToModeAFromCave
                            	  3446: __far_z_05_0063:
02:00041D3A 4E75            	  3447:     rts
                            	  3448: 
                            	  3449: ; Params:
                            	  3450: ; [0F]: movement direction
                            	  3451: ;
                            	  3452: ; Returns:
                            	  3453: ; [0F]: movement direction or 0
                            	  3454: ;
                            	  3455: ;
                            	  3456: ; If the ladder's not in use, return.
                            	  3457: ;
                            	  3458:     even
                            	  3459: CheckLadder:
02:00041D3C 7400            	  3460:     moveq   #0,D2
02:00041D3E 142C0064        	  3461:     move.b  ($0064,A4),D2
02:00041D42 670000BE        	  3462:     beq  _L_z05_CheckLadder_Exit
                            	  3463:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3464:     ;
02:00041D46 41EC00AC        	  3465:     lea     ($00AC,A4),A0
02:00041D4A 10302000        	  3466:     move.b  (A0,D2.W),D0
02:00041D4E 670000A6        	  3467:     beq  _L_z05_CheckLadder_StashLadder
                            	  3468:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3469:     ; between the ladder and Link.
                            	  3470:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3471:     ;
02:00041D52 41EC0098        	  3472:     lea     ($0098,A4),A0
02:00041D56 10302000        	  3473:     move.b  (A0,D2.W),D0
02:00041D5A 0200000C        	  3474:     andi.b #$0C,D0
02:00041D5E 6734            	  3475:     beq  _anon_z05_85
02:00041D60 102C0070        	  3476:     move.b  ($0070,A4),D0
02:00041D64 12342070        	  3477:     move.b  ($70,A4,D2.W),D1
02:00041D68 B001            	  3478:     cmp.b   D1,D0
02:00041D6A 6600008A        	  3479:     bne  _L_z05_CheckLadder_StashLadder
02:00041D6E 102C0084        	  3480:     move.b  ($0084,A4),D0
02:00041D72 023C00EE        	  3481:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D76 123C0003        	  3482:     move.b  #$03,D1
02:00041D7A D101            	  3483:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D7C 003C0011        	  3484:     ori     #$11,CCR  ; SEC: set C+X
02:00041D80 41EC0084        	  3485:     lea     ($0084,A4),A0
02:00041D84 12302000        	  3486:     move.b  (A0,D2.W),D1
02:00041D88 0A3C0010        	  3487:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D8C 9101            	  3488:     subx.b  D1,D0   ; SBC ObjY,X
02:00041D8E 0A3C0010        	  3489:     eori    #$10,CCR  ; restore X = 6502 C
02:00041D92 6030            	  3490:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3491: 
                            	  3492: _anon_z05_85:
                            	  3493:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3494:     ; between the ladder and Link.
                            	  3495:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3496:     ;
02:00041D94 102C0084        	  3497:     move.b  ($0084,A4),D0
02:00041D98 023C00EE        	  3498:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D9C 123C0003        	  3499:     move.b  #$03,D1
02:00041DA0 D101            	  3500:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041DA2 41EC0084        	  3501:     lea     ($0084,A4),A0
02:00041DA6 12302000        	  3502:     move.b  (A0,D2.W),D1
02:00041DAA B001            	  3503:     cmp.b   D1,D0
02:00041DAC 6648            	  3504:     bne  _L_z05_CheckLadder_StashLadder
02:00041DAE 102C0070        	  3505:     move.b  ($0070,A4),D0
02:00041DB2 003C0011        	  3506:     ori     #$11,CCR  ; SEC: set C+X
02:00041DB6 12342070        	  3507:     move.b  ($70,A4,D2.W),D1
02:00041DBA 0A3C0010        	  3508:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DBE 9101            	  3509:     subx.b  D1,D0   ; SBC ObjX,X
02:00041DC0 0A3C0010        	  3510:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3511:     even
                            	  3512: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3513:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3514:     ; If > $10, go put the ladder away.
                            	  3515:     ;
02:00041DC4 4EB900030E56    	  3516:     jsr     Abs
02:00041DCA 1880            	  3517:     move.b  D0,($0000,A4)
02:00041DCC 0C000010        	  3518:     cmpi.b  #$10,D0
02:00041DD0 6532            	  3519:     bcs  _L_z05_CheckLadder_SetState2
02:00041DD2 0C000010        	  3520:     cmpi.b  #$10,D0
02:00041DD6 661E            	  3521:     bne  _L_z05_CheckLadder_StashLadder
                            	  3522:     ; Distance = $10. If player's not facing in the same direction as
                            	  3523:     ; the ladder, go put away the ladder.
                            	  3524:     ;
02:00041DD8 102C0098        	  3525:     move.b  ($0098,A4),D0
02:00041DDC 41EC0098        	  3526:     lea     ($0098,A4),A0
02:00041DE0 12302000        	  3527:     move.b  (A0,D2.W),D1
02:00041DE4 B001            	  3528:     cmp.b   D1,D0
02:00041DE6 660E            	  3529:     bne  _L_z05_CheckLadder_StashLadder
                            	  3530:     ; Distance = $10, and player's facing in the same direction.
                            	  3531:     ;
                            	  3532:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3533:     ; ladder and had not stepped onto it yet.
                            	  3534:     ; Go handle movement on it, but don't change state yet.
                            	  3535:     ;
                            	  3536:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3537:     ; off of the ladder. So the ladder should be put away. In this
                            	  3538:     ; case, fall thru.
                            	  3539:     ;
02:00041DE8 41EC00AC        	  3540:     lea     ($00AC,A4),A0
02:00041DEC 10302000        	  3541:     move.b  (A0,D2.W),D0
02:00041DF0 0C000001        	  3542:     cmpi.b  #$01,D0
02:00041DF4 6718            	  3543:     beq  _L_z05_CheckLadder_HandleInput
                            	  3544:     even
                            	  3545: _L_z05_CheckLadder_StashLadder:
                            	  3546:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3547:     ;
02:00041DF6 7000            	  3548:     moveq   #0,D0
02:00041DF8 19400064        	  3549:     move.b  D0,($0064,A4)
02:00041DFC 4EB90004D630    	  3550:     jsr     DestroyMonster
                            	  3551:     even
                            	  3552: _L_z05_CheckLadder_Exit:
02:00041E02 4E75            	  3553:     rts
                            	  3554: 
                            	  3555:     even
                            	  3556: _L_z05_CheckLadder_SetState2:
                            	  3557:     ;  Set state 2, because we're on the ladder.
                            	  3558:     ;
02:00041E04 7002            	  3559:     moveq   #2,D0
02:00041E06 41EC00AC        	  3560:     lea     ($00AC,A4),A0
02:00041E0A 11802000        	  3561:     move.b  D0,(A0,D2.W)
                            	  3562:     even
                            	  3563: _L_z05_CheckLadder_HandleInput:
                            	  3564:     ; If input direction = 0, go draw and reset moving direction.
                            	  3565:     ;
02:00041E0E 102C03F8        	  3566:     move.b  ($03F8,A4),D0
02:00041E12 67000086        	  3567:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3568:     ; Input direction <> 0. The player intends to move.
                            	  3569:     ; So, see if we need to override the moving direction.
                            	  3570:     ;
                            	  3571:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3572:     ; go draw and set moving direction to Link's direction.
                            	  3573:     ;
                            	  3574:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3575:     ; been blocked by the water.
                            	  3576:     ;
                            	  3577:     ; Or, Link already passed over the point right over the ladder
                            	  3578:     ; and was allowed to move onto the tiles after the ladder.
                            	  3579:     ;
02:00041E16 102C0098        	  3580:     move.b  ($0098,A4),D0
02:00041E1A 7600            	  3581:     moveq   #0,D3
02:00041E1C 1614            	  3582:     move.b  ($0000,A4),D3
02:00041E1E 670C            	  3583:     beq  _anon_z05_86
02:00041E20 41EC0098        	  3584:     lea     ($0098,A4),A0
02:00041E24 12302000        	  3585:     move.b  (A0,D2.W),D1
02:00041E28 B001            	  3586:     cmp.b   D1,D0
02:00041E2A 676E            	  3587:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3588: _anon_z05_86:
                            	  3589:     ; Distance = 0, or facing different directions.
                            	  3590:     ;
                            	  3591:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3592:     ; then go draw and keep moving.
                            	  3593:     ;
                            	  3594:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3595:     ;
                            	  3596:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3597:     ; to move onto the tiles after the ladder.
                            	  3598:     ;
                            	  3599:     ; Note that if Link is not moving, then this test will fail,
                            	  3600:     ; and case (D) will catch it.
                            	  3601:     ;
02:00041E2C 41EC0098        	  3602:     lea     ($0098,A4),A0
02:00041E30 10302000        	  3603:     move.b  (A0,D2.W),D0
02:00041E34 122C000F        	  3604:     move.b  ($000F,A4),D1
02:00041E38 B001            	  3605:     cmp.b   D1,D0
02:00041E3A 675E            	  3606:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3607:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3608:     ; then go draw and move in ladder's direction.
                            	  3609:     ;
                            	  3610:     ; You can always step off the ladder where you came from.
                            	  3611:     ;
02:00041E3C 4EB900030E52    	  3612:     jsr     GetOppositeDir
02:00041E42 122C0098        	  3613:     move.b  ($0098,A4),D1
02:00041E46 B001            	  3614:     cmp.b   D1,D0
02:00041E48 6750            	  3615:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3616:     ; D. If opposite of ladder's direction <> down,
                            	  3617:     ; or input direction <> up,
                            	  3618:     ; then go reset moving direction, and draw.
                            	  3619:     ;
                            	  3620:     ; This will catch all cases of Link facing perpendicular to
                            	  3621:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3622:     ; ladder direction is up and input direction is up (E).
                            	  3623:     ;
02:00041E4A 0C000004        	  3624:     cmpi.b  #$04,D0
02:00041E4E 6648            	  3625:     bne  _anon_z05_87
02:00041E50 102C03F8        	  3626:     move.b  ($03F8,A4),D0
02:00041E54 0C000008        	  3627:     cmpi.b  #$08,D0
02:00041E58 663E            	  3628:     bne  _anon_z05_87
                            	  3629:     ; E. The ladder's direction is up and input direction is up.
                            	  3630:     ;
                            	  3631:     ; An earlier call to check tile collision would have blocked
                            	  3632:     ; movement, because the tile under Link's top half is a water tile.
                            	  3633:     ; But because Link is squarely on the ladder, we really have
                            	  3634:     ; to check the tile above that one.
                            	  3635:     ;
                            	  3636:     ; Set moving direction to input direction (up) and switch X to
                            	  3637:     ; the player's slot for the purpose of checking tile collision below.
                            	  3638:     ; Based on that, we'll set moving direction according to walkability.
                            	  3639:     ;
02:00041E5A 6158            	  3640:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3641:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3642:     ;
02:00041E5C 102C0084        	  3643:     move.b  ($0084,A4),D0
02:00041E60 1B00            	  3644:     move.b  D0,-(A5)  ; PHA
02:00041E62 003C0011        	  3645:     ori     #$11,CCR  ; SEC: set C+X
02:00041E66 123C0008        	  3646:     move.b  #$08,D1
02:00041E6A 0A3C0010        	  3647:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041E6E 9101            	  3648:     subx.b  D1,D0   ; SBC #$08
02:00041E70 0A3C0010        	  3649:     eori    #$10,CCR  ; restore X = 6502 C
02:00041E74 19400084        	  3650:     move.b  D0,($0084,A4)
02:00041E78 4EB90004B75C    	  3651:     jsr     GetCollidingTileMoving
02:00041E7E 101D            	  3652:     move.b  (A5)+,D0  ; PLA
02:00041E80 19400084        	  3653:     move.b  D0,($0084,A4)
                            	  3654:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3655:     ; direction as the input direction (in a roundabout way).
                            	  3656:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3657:     ;
02:00041E84 102C000F        	  3658:     move.b  ($000F,A4),D0
02:00041E88 7600            	  3659:     moveq   #0,D3
02:00041E8A 162C049E        	  3660:     move.b  ($049E,A4),D3
02:00041E8E 122C034A        	  3661:     move.b  ($034A,A4),D1
02:00041E92 B601            	  3662:     cmp.b   D1,D3
02:00041E94 6500FF78        	  3663:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3664: _anon_z05_87:
                            	  3665:     ; Set A to reset moving direction in [0F].
                            	  3666:     ;
02:00041E98 7000            	  3667:     moveq   #0,D0
                            	  3668:     even
                            	  3669: _L_z05_CheckLadder_DrawLadder:
                            	  3670:     ; Draw the ladder.
                            	  3671:     ;
02:00041E9A 1B00            	  3672:     move.b  D0,-(A5)  ; PHA
02:00041E9C 7400            	  3673:     moveq   #0,D2
02:00041E9E 142C0064        	  3674:     move.b  ($0064,A4),D2
02:00041EA2 4EB90004CE4C    	  3675:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041EA8 760C            	  3676:     moveq   #12,D3
02:00041EAA 7000            	  3677:     moveq   #0,D0
02:00041EAC 4EB900031BAC    	  3678:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041EB2 101D            	  3679:     move.b  (A5)+,D0  ; PLA
                            	  3680: ; Params:
                            	  3681: ; A: direction
                            	  3682: ;
                            	  3683: ; Returns:
                            	  3684: ; [0F]: direction
                            	  3685: ;
                            	  3686:     even
                            	  3687: SetMovingDirAndSwitchToPlayerSlot:
02:00041EB4 4EF90002C048    	  3688:     jmp     c_set_moving_dir_switch_player
