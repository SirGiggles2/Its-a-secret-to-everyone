                            	  6932: UpdateDodongoState0_Move:
                            	  6933:     ; If facing left, then push X offset 0 on the stack.
                            	  6934:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6935:     ;
                            	  6936:     ; We would like to use one set of coordinates only.
                            	  6937:     ; But movement would break down, if we did; because
                            	  6938:     ; Dodongo is so long.
                            	  6939:     ;
                            	  6940:     ; So, when not facing left, we temporarily shift the
                            	  6941:     ; X coordinate to be closer to the other side of the monster.
                            	  6942:     ;
02:0003CA58 7600            	  6943:     moveq   #0,D3
02:0003CA5A 41EC0098        	  6944:     lea     ($0098,A4),A0
02:0003CA5E 10302000        	  6945:     move.b  (A0,D2.W),D0
02:0003CA62 0200000D        	  6946:     andi.b #$0D,D0
02:0003CA66 6716            	  6947:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003CA68 10342070        	  6948:     move.b  ($70,A4,D2.W),D0
02:0003CA6C 023C00EE        	  6949:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA70 123C0010        	  6950:     move.b  #$10,D1
02:0003CA74 D101            	  6951:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CA76 19802070        	  6952:     move.b  D0,($70,A4,D2.W)
02:0003CA7A 163C00F0        	  6953:     move.b  #$F0,D3
                            	  6954:     even
                            	  6955: _L_z04_UpdateDodongoState0_Move_Move:
02:0003CA7E 1003            	  6956:     move.b  D3,D0
02:0003CA80 1B00            	  6957:     move.b  D0,-(A5)  ; PHA
02:0003CA82 7020            	  6958:     moveq   #32,D0
02:0003CA84 41EC041F        	  6959:     lea     ($041F,A4),A0
02:0003CA88 11802000        	  6960:     move.b  D0,(A0,D2.W)
02:0003CA8C 6100D05E        	  6961:     jsr     Wanderer_TargetPlayer
                            	  6962:     ; Pop the offset and add it to the X coordinate.
                            	  6963:     ;
                            	  6964:     ; This brings the X coordinate back to the unique value
                            	  6965:     ; that represents the position.
                            	  6966:     ;
02:0003CA90 101D            	  6967:     move.b  (A5)+,D0  ; PLA
02:0003CA92 023C00EE        	  6968:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA96 12342070        	  6969:     move.b  ($70,A4,D2.W),D1
02:0003CA9A D101            	  6970:     addx.b  D1,D0   ; ADC ObjX,X
02:0003CA9C 19802070        	  6971:     move.b  D0,($70,A4,D2.W)
                            	  6972:     ; If X coordinate < $20, then face right.
                            	  6973:     ;
02:0003CAA0 0C000020        	  6974:     cmpi.b  #$20,D0
02:0003CAA4 640A            	  6975:     bcc  _anon_z04_89
02:0003CAA6 7001            	  6976:     moveq   #1,D0
02:0003CAA8 41EC0098        	  6977:     lea     ($0098,A4),A0
02:0003CAAC 11802000        	  6978:     move.b  D0,(A0,D2.W)
                            	  6979: _anon_z04_89:
