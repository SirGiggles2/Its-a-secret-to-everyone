                            	  3340: _anon_z04_45:
02:0003B04A 1883            	  3341:     move.b  D3,($0000,A4)
                            	  3342:     ; [01] holds Link's X coordinate.
                            	  3343:     ;
02:0003B04C 102C0070        	  3344:     move.b  ($0070,A4),D0
02:0003B050 19400001        	  3345:     move.b  D0,($0001,A4)
                            	  3346:     ; Add Link's X and the horizontal offset.
                            	  3347:     ;
02:0003B054 023C00EE        	  3348:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B058 1214            	  3349:     move.b  ($0000,A4),D1
02:0003B05A D101            	  3350:     addx.b  D1,D0   ; ADC $00
                            	  3351:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3352:     ;
02:0003B05C 020000F8        	  3353:     andi.b #$F8,D0
                            	  3354:     ; Assign that result to the leever's X coordinate and [02].
                            	  3355:     ;
