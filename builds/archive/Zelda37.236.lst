02:0003387A 11803000        	   566:     move.b  D0,(A0,D3.W)
02:0003387E 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00033882 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00033886 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
