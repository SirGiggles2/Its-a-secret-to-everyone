02:000320CE 19400009        	  6689:     move.b  D0,($0009,A4)
                            	  6690:     ; Set collision threshold $A in both axes.
                            	  6691:     ;
02:000320D2 700A            	  6692:     moveq   #10,D0
02:000320D4 1940000D        	  6693:     move.b  D0,($000D,A4)
02:000320D8 1940000E        	  6694:     move.b  D0,($000E,A4)
                            	  6695:     ; The boomerang's middle X is 4 pixels to the right. Store in [04].
                            	  6696:     ;
02:000320DC 10343070        	  6697:     move.b  ($70,A4,D3.W),D0
02:000320E0 023C00EE        	  6698:     andi    #$EE,CCR  ; CLC: clear C+X
02:000320E4 123C0004        	  6699:     move.b  #$04,D1
02:000320E8 D101            	  6700:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000320EA 19400004        	  6701:     move.b  D0,($0004,A4)
                            	  6702:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6703:     ;
02:000320EE 41EC0084        	  6704:     lea     ($0084,A4),A0
02:000320F2 10303000        	  6705:     move.b  (A0,D3.W),D0
02:000320F6 023C00EE        	  6706:     andi    #$EE,CCR  ; CLC: clear C+X
02:000320FA 123C0008        	  6707:     move.b  #$08,D1
02:000320FE D101            	  6708:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6709: ; Params:
                            	  6710: ; A: weapon object mid Y
                            	  6711: ; X: monster object slot
                            	  6712: ; Y: weapon object slot
                            	  6713: ; [00]: weapon object slot
                            	  6714: ; [02]: monster object mid X
                            	  6715: ; [03]: monster object mid Y
                            	  6716: ; [04]: weapon object mid X
                            	  6717: ; [07]: damage points
                            	  6718: ; [09]: damage type
                            	  6719: ; [0D]: horizontal threshold
                            	  6720: ; [0E]: vertical threshold
                            	  6721: ;
                            	  6722: ; Returns:
                            	  6723: ; [06]: 1 if objects collide
                            	  6724: ;
                            	  6725:     even
