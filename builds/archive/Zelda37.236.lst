02:00031EE0 102C0070        	  6426:     move.b  ($0070,A4),D0
02:00031EE4 023C00EE        	  6427:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031EE8 123C0008        	  6428:     move.b  #$08,D1
02:00031EEC D101            	  6429:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031EEE 19400004        	  6430:     move.b  D0,($0004,A4)
02:00031EF2 102C0084        	  6431:     move.b  ($0084,A4),D0
02:00031EF6 023C00EE        	  6432:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031EFA 123C0008        	  6433:     move.b  #$08,D1
02:00031EFE D101            	  6434:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031F00 19400005        	  6435:     move.b  D0,($0005,A4)
