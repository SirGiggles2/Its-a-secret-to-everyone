                            	  6532: HarmLink:
02:00031F9C 61000564        	  6533:     jsr     BeginShove
                            	  6534:     ; Flag collision with [0C], even though [06] was already set.
                            	  6535:     ;
02:00031FA0 522C000C        	  6536:     addq.b  #1,($000C,A4)
                            	  6537:     ; Unpack the damage points for the monster's type.
                            	  6538:     ; The low nibble is the high byte.
                            	  6539:     ; (Damage points byte AND $F0) is the low byte.
                            	  6540:     ;
02:00031FA4 7600            	  6541:     moveq   #0,D3
02:00031FA6 41EC034F        	  6542:     lea     ($034F,A4),A0
02:00031FAA 16302000        	  6543:     move.b  (A0,D2.W),D3
02:00031FAE 41F900031E10    	  6544:     lea     (ObjTypeToDamagePoints).l,A0
02:00031FB4 10303000        	  6545:     move.b  (A0,D3.W),D0
02:00031FB8 1B00            	  6546:     move.b  D0,-(A5)  ; PHA
02:00031FBA 0200000F        	  6547:     andi.b #$0F,D0
02:00031FBE 1940000D        	  6548:     move.b  D0,($000D,A4)
02:00031FC2 101D            	  6549:     move.b  (A5)+,D0  ; PLA
02:00031FC4 020000F0        	  6550:     andi.b #$F0,D0
02:00031FC8 1940000E        	  6551:     move.b  D0,($000E,A4)
                            	  6552: ; Params:
                            	  6553: ; X: object index of the attacker
                            	  6554: ; [0D]: damage points high byte
                            	  6555: ; [0E]: damage points low byte
                            	  6556: ;
                            	  6557: ;
                            	  6558: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6559: ;
                            	  6560:     even
                            	  6561: Link_BeHarmed:
02:00031FCC 7600            	  6562:     moveq   #0,D3
02:00031FCE 41EC034F        	  6563:     lea     ($034F,A4),A0
02:00031FD2 16302000        	  6564:     move.b  (A0,D2.W),D3
02:00031FD6 0C03002E        	  6565:     cmpi.b  #$2E,D3
02:00031FDA 6706            	  6566:     beq  _anon_z01_85
02:00031FDC 7008            	  6567:     moveq   #8,D0
02:00031FDE 6100E9DE        	  6568:     jsr     PlaySample
