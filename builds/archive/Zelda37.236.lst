                            	  7484: _L_z01_BeginShove_CheckHorizontal:
                            	  7485:     ; If the direction checked is left or right,
                            	  7486:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7487:     ;
02:0003255C 7002            	  7488:     moveq   #2,D0
02:0003255E 19400008        	  7489:     move.b  D0,($0008,A4)
02:00032562 10342070        	  7490:     move.b  ($70,A4,D2.W),D0
02:00032566 19400004        	  7491:     move.b  D0,($0004,A4)
02:0003256A 10343070        	  7492:     move.b  ($70,A4,D3.W),D0
02:0003256E 19400005        	  7493:     move.b  D0,($0005,A4)
                            	  7494:     even
                            	  7495: _L_z01_BeginShove_CheckVertical:
                            	  7496:     ; If the monster is down or right of the other object,
                            	  7497:     ; then use the opposite direction already in [08].
                            	  7498:     ; Else shift [08] right to turn it into the opposite
                            	  7499:     ; direction up or down.
                            	  7500:     ;
                            	  7501:     ; Again assuming Link is the defender; after this, [08] points
                            	  7502:     ; Link away from the monster.
                            	  7503:     ;
02:00032572 102C0004        	  7504:     move.b  ($0004,A4),D0
02:00032576 122C0005        	  7505:     move.b  ($0005,A4),D1
02:0003257A B001            	  7506:     cmp.b   D1,D0
02:0003257C 640A            	  7507:     bcc  _anon_z01_101
02:0003257E 122C0008        	  7508:     move.b  ($0008,A4),D1
02:00032582 E209            	  7509:     lsr.b  #1,D1   ; LSR $08
02:00032584 19410008        	  7510:     move.b  D1,($0008,A4)
                            	  7511: _anon_z01_101:
                            	  7512:     ; If a monster is the defender, go handle it separately.
                            	  7513:     ;
02:00032588 4A03            	  7514:     cmpi.b  #$00,D3
02:0003258A 6656            	  7515:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7516:     ; Link is the defender.
                            	  7517:     ;
                            	  7518:     ; If Link is invincible, return without shoving.
                            	  7519:     ;
02:0003258C 102C04F0        	  7520:     move.b  ($04F0,A4),D0
02:00032590 664E            	  7521:     bne  _L_z01_BeginShove_Exit
                            	  7522:     ; Store the shove direction we determined.
                            	  7523:     ;
                            	  7524:     ; Turn on the high bit to indicate that the next time we try to
                            	  7525:     ; move by shoving, it will be the first time for this shove action.
                            	  7526:     ;
02:00032592 102C0008        	  7527:     move.b  ($0008,A4),D0
02:00032596 00000080        	  7528:     ori.b #$80,D0
02:0003259A 194000C0        	  7529:     move.b  D0,($00C0,A4)
                            	  7530:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7531:     ;
02:0003259E 7018            	  7532:     moveq   #24,D0
02:000325A0 194004F0        	  7533:     move.b  D0,($04F0,A4)
02:000325A4 7020            	  7534:     moveq   #32,D0
02:000325A6 194000D3        	  7535:     move.b  D0,($00D3,A4)
                            	  7536:     ; If Link was shoved by one of his own weapons, then
                            	  7537:     ; nothing else to do. Return.
                            	  7538:     ;
02:000325AA 0C02000D        	  7539:     cmpi.b  #$0D,D2
02:000325AE 6430            	  7540:     bcc  _L_z01_BeginShove_Exit
                            	  7541:     ; Link was shoved by a monster.
                            	  7542:     ;
                            	  7543:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7544:     ; then return.
                            	  7545:     ;
02:000325B0 41EC04BF        	  7546:     lea     ($04BF,A4),A0
02:000325B4 10302000        	  7547:     move.b  (A0,D2.W),D0
02:000325B8 02000080        	  7548:     andi.b #$80,D0
02:000325BC 6622            	  7549:     bne  _L_z01_BeginShove_Exit
                            	  7550:     ; If the attacker is a vire, then return.
                            	  7551:     ;
02:000325BE 41EC034F        	  7552:     lea     ($034F,A4),A0
02:000325C2 10302000        	  7553:     move.b  (A0,D2.W),D0
02:000325C6 0C000012        	  7554:     cmpi.b  #$12,D0
02:000325CA 6714            	  7555:     beq  _L_z01_BeginShove_Exit
                            	  7556:     ; Turn the attacker in the opposite direction.
                            	  7557:     ;
02:000325CC 41EC0098        	  7558:     lea     ($0098,A4),A0
02:000325D0 10302000        	  7559:     move.b  (A0,D2.W),D0
02:000325D4 6100E87C        	  7560:     jsr     GetOppositeDir
02:000325D8 41EC0098        	  7561:     lea     ($0098,A4),A0
