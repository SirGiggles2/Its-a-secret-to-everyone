02:00032002 7000            	  6588:     moveq   #0,D0
02:00032004 19400627        	  6589:     move.b  D0,($0627,A4)
02:00032008 19400050        	  6590:     move.b  D0,($0050,A4)
02:0003200C 19400051        	  6591:     move.b  D0,($0051,A4)
                            	  6592:     ; If heart partial >= low damage points byte, then simply
                            	  6593:     ; subtract the damage byte from heart partial.
                            	  6594:     ; Else go borrow from full hearts.
