                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:00036B22 103C00FF        	  5176:     move.b  #$FF,D0
02:00036B26 19400325        	  5177:     move.b  D0,($0325,A4)
02:00036B2A 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:00036B2E 7020            	  5181:     moveq   #32,D0
02:00036B30 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:00036B34 7400            	  5185:     moveq   #0,D2
02:00036B36 142C050C        	  5186:     move.b  ($050C,A4),D2
02:00036B3A 41F9000368E0    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:00036B40 10302000        	  5188:     move.b  (A0,D2.W),D0
02:00036B44 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:00036B48 102C050D        	  5192:     move.b  ($050D,A4),D0
02:00036B4C 7600            	  5193:     moveq   #0,D3
02:00036B4E 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:00036B50 E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00036B52 E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:00036B54 E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:00036B56 E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:00036B58 E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:00036B5A 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:00036B5E 41F9000368EC    	  5205:     lea     (CreditsPagesTextMasks).l,A0
