                            	  7627:     ; If the darknut is red, then move at q-speed $20 (0.5 pixels a frame).
                            	  7628:     ;
02:0003CEE4 7020            	  7629:     moveq   #32,D0
02:0003CEE6 7600            	  7630:     moveq   #0,D3
02:0003CEE8 41EC034F        	  7631:     lea     ($034F,A4),A0
