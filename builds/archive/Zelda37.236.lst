                            	  3326:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3327:     ; it's too close to the top edge of the screen. So, return.
                            	  3328:     ;
02:0003B030 0C00005D        	  3329:     cmpi.b  #$5D,D0
