02:00032010 102C0670        	  6596:     move.b  ($0670,A4),D0
02:00032014 122C000E        	  6597:     move.b  ($000E,A4),D1
02:00032018 B001            	  6598:     cmp.b   D1,D0
02:0003201A 6546            	  6599:     bcs  _L_z01_Link_BeHarmed_BorrowHeart
02:0003201C 003C0011        	  6600:     ori     #$11,CCR  ; SEC: set C+X
02:00032020 122C000E        	  6601:     move.b  ($000E,A4),D1
02:00032024 0A3C0010        	  6602:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032028 9101            	  6603:     subx.b  D1,D0   ; SBC $0E
02:0003202A 0A3C0010        	  6604:     eori    #$10,CCR  ; restore X = 6502 C
02:0003202E 19400670        	  6605:     move.b  D0,($0670,A4)
                            	  6606:     ; If full hearts >= high damage points byte, then simply
                            	  6607:     ; subtract the damage byte from full hearts.
