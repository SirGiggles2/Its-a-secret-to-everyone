                            	  6843: __far_z_07_0119:
02:0004CDE0 102C03F8        	  6844:     move.b  ($03F8,A4),D0
02:0004CDE4 6602            	  6845:     bne.s  __far_z_07_0120
02:0004CDE6 6018            	  6846:     jmp  SetUpWalkingSprites
                            	  6847: __far_z_07_0120:
                            	  6848: ; Params:
                            	  6849: ; X: object index
                            	  6850: ;
                            	  6851: ; Returns:
                            	  6852: ; Y: animation frame
                            	  6853: ; [00]: object X
                            	  6854: ; [01]: object Y
                            	  6855: ; [0F]: flip horizontal
                            	  6856: ;
                            	  6857: ; As the object walks, the animation counter rolls down.
                            	  6858: ;
                            	  6859:     even
                            	  6860: AnimateObjectWalking:
02:0004CDE8 41EC03D0        	  6861:     lea     ($03D0,A4),A0
02:0004CDEC 53302000        	  6862:     subq.b  #1,(A0,D2.W)
02:0004CDF0 6702            	  6863:     beq.s  __far_z_07_0121
02:0004CDF2 600C            	  6864:     jmp  SetUpWalkingSprites
                            	  6865: __far_z_07_0121:
                            	  6866:     ; Once the counter reaches 0, and if object is the player,
                            	  6867:     ; animate Link's object state.
                            	  6868:     ;
02:0004CDF4 4A02            	  6869:     cmpi.b  #$00,D2
02:0004CDF6 6602            	  6870:     bne  _anon_z07_36
02:0004CDF8 615E            	  6871:     jsr     AnimateLinkObjState
                            	  6872: _anon_z07_36:
                            	  6873:     ; Roll over the counter (6 frames).
                            	  6874:     ;
02:0004CDFA 7006            	  6875:     moveq   #6,D0
02:0004CDFC 1880            	  6876:     move.b  D0,($0000,A4)
02:0004CDFE 6152            	  6877:     jsr     RollOverAnimCounter
                            	  6878:     even
                            	  6879: SetUpWalkingSprites:
