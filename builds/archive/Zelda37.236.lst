                            	 13006: Ganon_CheckCollisions:
                            	 13007:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13008:     ; Store in [02] and [03].
                            	 13009:     ;
02:0003F6E2 10342070        	 13010:     move.b  ($70,A4,D2.W),D0
02:0003F6E6 023C00EE        	 13011:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F6EA 123C0010        	 13012:     move.b  #$10,D1
02:0003F6EE D101            	 13013:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F6F0 19400002        	 13014:     move.b  D0,($0002,A4)
02:0003F6F4 41EC0084        	 13015:     lea     ($0084,A4),A0
02:0003F6F8 10302000        	 13016:     move.b  (A0,D2.W),D0
02:0003F6FC 023C00EE        	 13017:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F700 123C0010        	 13018:     move.b  #$10,D1
02:0003F704 D101            	 13019:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F706 19400003        	 13020:     move.b  D0,($0003,A4)
                            	 13021:     ; Check for a collision with Link.
                            	 13022:     ;
                            	 13023:     ; We can't call CheckLinkCollision, because we need to
                            	 13024:     ; customize Ganon's midpoint.
                            	 13025:     ;
                            	 13026:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13027:     ; detection, if Link is invincible. Initialize variables that will
                            	 13028:     ; be returned from the partial collision check routine. Then
                            	 13029:     ; call it.
                            	 13030:     ;
02:0003F70A 102C04F0        	 13031:     move.b  ($04F0,A4),D0
02:0003F70E 6616            	 13032:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F710 19400006        	 13033:     move.b  D0,($0006,A4)
02:0003F714 19400009        	 13034:     move.b  D0,($0009,A4)
02:0003F718 1940000C        	 13035:     move.b  D0,($000C,A4)
02:0003F71C 7600            	 13036:     moveq   #0,D3
02:0003F71E 1883            	 13037:     move.b  D3,($0000,A4)
02:0003F720 4EB900031EA4    	 13038:     jsr     CheckLinkCollisionPreinit
                            	 13039:     even
                            	 13040: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13041:     ; If Ganon is not in state 0, then he's brown.
                            	 13042:     ; Go check collision with an arrow.
                            	 13043:     ;
02:0003F726 41EC00AC        	 13044:     lea     ($00AC,A4),A0
02:0003F72A 10302000        	 13045:     move.b  (A0,D2.W),D0
02:0003F72E 6652            	 13046:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13047:     ; If timer <> 0, then Ganon is visible.
                            	 13048:     ; He can't be harmed like this. So, return.
                            	 13049:     ;
02:0003F730 10342028        	 13050:     move.b  ($28,A4,D2.W),D0
02:0003F734 664A            	 13051:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F736 760D            	 13052:     moveq   #13,D3
02:0003F738 4EB90003236E    	 13053:     jsr     CheckMonsterSwordCollision
                            	 13054:     ; If Ganon has died according to the usual collision check rules
                            	 13055:     ; (HP = 0), then:
                            	 13056:     ; 1. Restore HP to the initial value $F0
                            	 13057:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13058:     ; 3. Change palette row 7 to make Ganon brown
                            	 13059:     ;
02:0003F73E 41EC0405        	 13060:     lea     ($0405,A4),A0
02:0003F742 10302000        	 13061:     move.b  (A0,D2.W),D0
02:0003F746 6718            	 13062:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F748 103C00F0        	 13063:     move.b  #$F0,D0
02:0003F74C 41EC0485        	 13064:     lea     ($0485,A4),A0
02:0003F750 11802000        	 13065:     move.b  D0,(A0,D2.W)
02:0003F754 41EC00AC        	 13066:     lea     ($00AC,A4),A0
02:0003F758 53302000        	 13067:     subq.b  #1,(A0,D2.W)
02:0003F75C 61000084        	 13068:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13069:     even
                            	 13070: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13071:     ; If Ganon was harmed, then play the sound effect
                            	 13072:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13073:     ;
02:0003F760 41EC04F0        	 13074:     lea     ($04F0,A4),A0
02:0003F764 10302000        	 13075:     move.b  (A0,D2.W),D0
02:0003F768 670A            	 13076:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F76A 6100A282        	 13077:     jsr     PlayBossHitCryIfNeeded
02:0003F76E 7040            	 13078:     moveq   #64,D0
02:0003F770 19802028        	 13079:     move.b  D0,($28,A4,D2.W)
                            	 13080:     even
                            	 13081: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13082:     ; Reset metastate, because Ganon cannot die this way.
                            	 13083:     ;
02:0003F774 4EB90004D654    	 13084:     jsr     ResetObjMetastate
                            	 13085:     ; Reset shove info and invincibility timer, because Ganon
                            	 13086:     ; doesn't react at all as a usual monster.
                            	 13087:     ;
02:0003F77A 4EB900032276    	 13088:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13089:     even
                            	 13090: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F780 4E75            	 13091:     rts
                            	 13092: 
                            	 13093:     even
                            	 13094: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13095:     ; If the silver arrow is not in the inventory, then return.
                            	 13096:     ;
02:0003F782 102C0659        	 13097:     move.b  ($0659,A4),D0
02:0003F786 0C000002        	 13098:     cmpi.b  #$02,D0
02:0003F78A 66F4            	 13099:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13100:     ; Reset the collision return value [06].
                            	 13101:     ;
02:0003F78C 7000            	 13102:     moveq   #0,D0
02:0003F78E 19400006        	 13103:     move.b  D0,($0006,A4)
                            	 13104:     ; If there's no arrow in flight, then return.
                            	 13105:     ;
02:0003F792 7612            	 13106:     moveq   #18,D3
02:0003F794 41EC00AC        	 13107:     lea     ($00AC,A4),A0
02:0003F798 10303000        	 13108:     move.b  (A0,D3.W),D0
02:0003F79C 0C000010        	 13109:     cmpi.b  #$10,D0
02:0003F7A0 66DE            	 13110:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13111:     ; Check for collision with an arrow; and return if no collision.
                            	 13112:     ;
02:0003F7A2 4EB9000323CA    	 13113:     jsr     CheckMonsterArrowOrRodCollision
02:0003F7A8 102C0006        	 13114:     move.b  ($0006,A4),D0
02:0003F7AC 67D2            	 13115:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13116:     ; Set the Ganon phase to "dying".
                            	 13117:     ;
02:0003F7AE 41EC042C        	 13118:     lea     ($042C,A4),A0
02:0003F7B2 52302000        	 13119:     addq.b  #1,(A0,D2.W)
                            	 13120:     ; Now his body does flash.
                            	 13121:     ;
02:0003F7B6 7028            	 13122:     moveq   #40,D0
02:0003F7B8 41EC04F0        	 13123:     lea     ($04F0,A4),A0
02:0003F7BC 11802000        	 13124:     move.b  D0,(A0,D2.W)
                            	 13125:     ; Set initial cloud distance 8.
                            	 13126:     ;
02:0003F7C0 7008            	 13127:     moveq   #8,D0
02:0003F7C2 41EC0478        	 13128:     lea     ($0478,A4),A0
02:0003F7C6 11802000        	 13129:     move.b  D0,(A0,D2.W)
02:0003F7CA 0A3C0001        	 13130:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F7CE 4E75            	 13131:     rts
