                            	  3688:     ; Note that this is the frame image to use, even if there's no
                            	  3689:     ; down component in the direction.
                            	  3690:     ;
02:0003B2DC 522C000D        	  3691:     addq.b  #1,($000D,A4)
                            	  3692:     ; If right is a component of the direction, then go set horizontal
                            	  3693:     ; flipping. Else leave horizontal flipping = 0.
                            	  3694:     ;
02:0003B2E0 41EC0098        	  3695:     lea     ($0098,A4),A0
02:0003B2E4 10302000        	  3696:     move.b  (A0,D2.W),D0
02:0003B2E8 02000001        	  3697:     andi.b #$01,D0
02:0003B2EC 6714            	  3698:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B2EE 660E            	  3699:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3700:     even
                            	  3701: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3702:     ; Set horizontal flipping if right is a direction component.
                            	  3703:     ; This essentially the same test as above, but for when we jump
                            	  3704:     ; from the "up" test.
                            	  3705:     ;
02:0003B2F0 41EC0098        	  3706:     lea     ($0098,A4),A0
02:0003B2F4 10302000        	  3707:     move.b  (A0,D2.W),D0
02:0003B2F8 02000002        	  3708:     andi.b #$02,D0
02:0003B2FC 6704            	  3709:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3710:     even
                            	  3711: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B2FE 522C000F        	  3712:     addq.b  #1,($000F,A4)
                            	  3713:     even
                            	  3714: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B302 102C000D        	  3715:     move.b  ($000D,A4),D0
                            	  3716: ; Params:
                            	  3717: ; A: frame image
                            	  3718: ; X: object index
                            	  3719: ; [00]: object X
                            	  3720: ; [01]: object Y
                            	  3721: ; [0F]: flip horizontally
                            	  3722: ;
                            	  3723: ; Returns:
                            	  3724: ; [00]: 0 for Link slot
                            	  3725: ; [06]: 1 if objects collide
                            	  3726: ; [09]: 0 for Link damage type (none)
                            	  3727: ; [0C]: 1 if objects collide
                            	  3728: ; [034B]: ShotCollidesWithLink
                            	  3729: ;
                            	  3730:     even
