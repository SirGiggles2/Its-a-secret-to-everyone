                            	 11599:     ; Mode $13 will start with a curtain furling effect.
                            	 11600:     ; Set up the decreasing column ($20), and the increasing column (1).
                            	 11601:     ; Prepare the background by filling the tile map with blank tile $24.
                            	 11602:     ;
02:0003ECFA 7020            	 11603:     moveq   #32,D0
02:0003ECFC 1940007C        	 11604:     move.b  D0,($007C,A4)
02:0003ED00 7001            	 11605:     moveq   #1,D0
02:0003ED02 1940007D        	 11606:     move.b  D0,($007D,A4)
02:0003ED06 7024            	 11607:     moveq   #36,D0
02:0003ED08 1940000A        	 11608:     move.b  D0,($000A,A4)
02:0003ED0C 4EF90004AF68    	 11609:     jmp     FillTileMap
                            	 11610: 
                            	 11611:     even
                            	 11612: UpdateGuardFire:
02:0003ED12 7006            	 11613:     moveq   #6,D0
02:0003ED14 6100B5C8        	 11614:     jsr     AnimateAndDrawCommonObject
02:0003ED18 4EB900031D24    	 11615:     jsr     CheckMonsterCollisions
                            	 11616:     ; If the object has not been killed, then return.
