02:00044578 B001            	  7278:     cmp.b   D1,D0
02:0004457A 6704            	  7279:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:0004457C 5302            	  7280:     subq.b  #1,D2
02:0004457E 66EE            	  7281:     bne  _anon_z05_149
                            	  7282:     even
