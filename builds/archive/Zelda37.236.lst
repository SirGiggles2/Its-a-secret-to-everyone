02:000319A2 6004            	  5689:     jmp     DrawObjectNotMirrored
                            	  5690: 
                            	  5691: ; Params:
                            	  5692: ; A: frame image
                            	  5693: ; X: object index
                            	  5694: ; [00]: object X
                            	  5695: ; [01]: object Y
                            	  5696: ;
                            	  5697: ;
                            	  5698: ; Set [0C] mirrored.
                            	  5699:     even
                            	  5700: DrawObjectMirrored:
02:000319A4 7601            	  5701:     moveq   #1,D3
02:000319A6 6602            	  5702:     bne  _anon_z01_75
                            	  5703: ; Params:
                            	  5704: ; A: frame image
                            	  5705: ; X: object index
                            	  5706: ; [00]: object X
                            	  5707: ; [01]: object Y
                            	  5708: ; [0F]: flip horizontally
                            	  5709: ;
                            	  5710:     even
                            	  5711: DrawObjectNotMirrored:
02:000319A8 7600            	  5712:     moveq   #0,D3
                            	  5713: _anon_z01_75:
02:000319AA 1943000C        	  5714:     move.b  D3,($000C,A4)
                            	  5715:     ; Set animation index = object type + 1.
                            	  5716:     ;
02:000319AE 7600            	  5717:     moveq   #0,D3
02:000319B0 41EC034F        	  5718:     lea     ($034F,A4),A0
02:000319B4 16302000        	  5719:     move.b  (A0,D2.W),D3
                            	  5720: ; Params:
                            	  5721: ; A: frame
                            	  5722: ; X: object index/cycle sprite index
                            	  5723: ; Y: object type
                            	  5724: ; [00]: object X
                            	  5725: ; [01]: object Y
                            	  5726: ; [0C]: mirrored
                            	  5727: ; [0F]: flip horizontally
                            	  5728: ;
                            	  5729: ; Note:
                            	  5730: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5731: ;
                            	  5732: ; The animation index of most objects is (object type + 1),
                            	  5733: ; to make up for the fact that Link uses two animation indexes.
                            	  5734: ;
                            	  5735:     even
                            	  5736: DrawObjectWithType:
02:000319B8 5203            	  5737:     addq.b  #1,D3
                            	  5738: ; Params:
                            	  5739: ; A: frame
                            	  5740: ; X: object index/cycle sprite index
                            	  5741: ; Y: animation index
                            	  5742: ; [00]: object X
                            	  5743: ; [01]: object Y
                            	  5744: ; [0C]: mirrored
                            	  5745: ; [0F]: flip horizontally
                            	  5746: ;
                            	  5747: ; Note:
                            	  5748: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5749: ; But Link uses [0F] for flipping without checking [0C].
                            	  5750: ;
                            	  5751: ;
                            	  5752: ; [0D] holds frame.
                            	  5753:     even
                            	  5754: DrawObjectWithAnim:
02:000319BA 1940000D        	  5755:     move.b  D0,($000D,A4)
02:000319BE 1943000E        	  5756:     move.b  D3,($000E,A4)
02:000319C2 19420008        	  5757:     move.b  D2,($0008,A4)
                            	  5758:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5759:     ;
02:000319C6 7600            	  5760:     moveq   #0,D3
02:000319C8 162C0341        	  5761:     move.b  ($0341,A4),D3
02:000319CC 41F900031970    	  5762:     lea     (SpriteOffsets).l,A0
02:000319D2 10303000        	  5763:     move.b  (A0,D3.W),D0
02:000319D6 19400343        	  5764:     move.b  D0,($0343,A4)
02:000319DA 41F900031971    	  5765:     lea     (SpriteOffsets+1).l,A0
02:000319E0 10303000        	  5766:     move.b  (A0,D3.W),D0
                            	  5767:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  5768:     ;
02:000319E4 4A02            	  5769:     cmpi.b  #$00,D2
02:000319E6 6702            	  5770:     beq.s  __far_z_01_0049
