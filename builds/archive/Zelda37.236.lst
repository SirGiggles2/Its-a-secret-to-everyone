02:0003043E 1600            	  2757:     move.b  D0,D3
02:00030440 1014            	  2758:     move.b  ($0000,A4),D0
02:00030442 0C030002        	  2759:     cmpi.b  #$02,D3
02:00030446 640A            	  2760:     bcc  _anon_z01_24
02:00030448 023C00EE        	  2761:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003044C 123C0008        	  2762:     move.b  #$08,D1
02:00030450 D101            	  2763:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
