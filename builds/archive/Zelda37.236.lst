                            	  8106: _anon_z05_174:
                            	  8107:     ; Two input directions, and at least one of them is walkable.
                            	  8108:     ;
                            	  8109:     ; Make Link go straight in one direction on the next grid line.
                            	  8110:     ;
02:00044DDC 7600            	  8111:     moveq   #0,D3
02:00044DDE 1600            	  8112:     move.b  D0,D3
02:00044DE0 522C0057        	  8113:     addq.b  #1,($0057,A4)
                            	  8114:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8115:     ; object direction and input direction to last walkable direction
                            	  8116:     ; found, and set Link's speed.
                            	  8117:     ;
                            	  8118:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8119:     ;
02:00044DE4 7400            	  8120:     moveq   #0,D2
02:00044DE6 102C000D        	  8121:     move.b  ($000D,A4),D0
02:00044DEA 0C030001        	  8122:     cmpi.b  #$01,D3
02:00044DEE 67000096        	  8123:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
02:00044DF2 7600            	  8124:     moveq   #0,D3
02:00044DF4 162C0010        	  8125:     move.b  ($0010,A4),D3
02:00044DF8 6700008C        	  8126:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8127:     ; In UW. There are two input directions, and they're both walkable.
                            	  8128:     ;
                            	  8129:     ; Normally, turn to the direction that's perpendicular to object
                            	  8130:     ; direction. But keep going straight after that, while diagonal
                            	  8131:     ; input is held.
                            	  8132:     ;
                            	  8133:     ; Handle special cases for doors.
                            	  8134:     ;
                            	  8135:     ;
                            	  8136:     ; 1. Link at horizontal doors.
                            	  8137:     ;
                            	  8138:     ; If Link's X = $20 or $D0 then
                            	  8139:     ;   If Link's Y = $85 and facing down then
                            	  8140:     ;     Go set object direction and input direction to object
                            	  8141:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8142:     ;     Link_GoStraightWhenDiagInput.
                            	  8143:     ;   Else
                            	  8144:     ;     Go turn to the perpendicular direction
                            	  8145:     ;
02:00044DFC 7600            	  8146:     moveq   #0,D3
02:00044DFE 162C0070        	  8147:     move.b  ($0070,A4),D3
02:00044E02 0C030020        	  8148:     cmpi.b  #$20,D3
02:00044E06 6706            	  8149:     beq  _anon_z05_175
02:00044E08 0C0300D0        	  8150:     cmpi.b  #$D0,D3
02:00044E0C 661C            	  8151:     bne  _anon_z05_176
