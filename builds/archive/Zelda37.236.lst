                            	  8086: HaveInput:
                            	  8087:     ; There were input directions.
                            	  8088:     ;
                            	  8089:     ; If there was only one input direction, go set object direction
                            	  8090:     ; to input direction, and set Link's speed.
                            	  8091:     ;
                            	  8092:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  8093:     ; (X is still 0, because it's Link's object index).
                            	  8094:     ;
02:00044DC6 102C000F        	  8095:     move.b  ($000F,A4),D0
