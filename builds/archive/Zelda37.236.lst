02:0003A5BC 41EC0098        	  1803:     lea     ($0098,A4),A0
02:0003A5C0 10302000        	  1804:     move.b  (A0,D2.W),D0
02:0003A5C4 1940000F        	  1805:     move.b  D0,($000F,A4)
                            	  1806:     ; If at a tile boundary, then check for a tile collision.
                            	  1807:     ;
02:0003A5C8 41EC0394        	  1808:     lea     ($0394,A4),A0
02:0003A5CC 10302000        	  1809:     move.b  (A0,D2.W),D0
02:0003A5D0 660E            	  1810:     bne  _L_z04_Gel_MoveSplitting_CheckRoomBoundary
02:0003A5D2 4EB90004B75C    	  1811:     jsr     GetCollidingTileMoving
                            	  1812:     ; If blocked by a tile, then return C=1.
                            	  1813:     ;
02:0003A5D8 122C034A        	  1814:     move.b  ($034A,A4),D1
