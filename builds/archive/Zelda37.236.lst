02:0003F1A4 0C020009        	 12271:     cmpi.b  #$09,D2
02:0003F1A8 6604            	 12272:     bne  _anon_z04_157
02:0003F1AA 522C00AD        	 12273:     addq.b  #1,($00AD,A4)
                            	 12274: _anon_z04_157:
                            	 12275:     ; Go to state 1 to orbit.
                            	 12276:     ;
02:0003F1AE 41EC00AC        	 12277:     lea     ($00AC,A4),A0
02:0003F1B2 52302000        	 12278:     addq.b  #1,(A0,D2.W)
                            	 12279:     ; TODO: ?
                            	 12280:     ;
02:0003F1B6 103C0080        	 12281:     move.b  #$80,D0
02:0003F1BA 41EC0098        	 12282:     lea     ($0098,A4),A0
02:0003F1BE 11802000        	 12283:     move.b  D0,(A0,D2.W)
                            	 12284:     ; Set angle $18 (N).
                            	 12285:     ;
02:0003F1C2 7018            	 12286:     moveq   #24,D0
02:0003F1C4 41EC0394        	 12287:     lea     ($0394,A4),A0
02:0003F1C8 11802000        	 12288:     move.b  D0,(A0,D2.W)
                            	 12289:     ; This location is right above Patra.
                            	 12290:     ; Set X coordinate to Patra's.
                            	 12291:     ;
02:0003F1CC 102C0071        	 12292:     move.b  ($0071,A4),D0
02:0003F1D0 19802070        	 12293:     move.b  D0,($70,A4,D2.W)
                            	 12294:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12295:     ; Else use radius $18. Store the chosen value in [00].
                            	 12296:     ;
02:0003F1D4 702C            	 12297:     moveq   #44,D0
02:0003F1D6 7600            	 12298:     moveq   #0,D3
02:0003F1D8 41EC034F        	 12299:     lea     ($034F,A4),A0
02:0003F1DC 16302000        	 12300:     move.b  (A0,D2.W),D3
02:0003F1E0 0C030025        	 12301:     cmpi.b  #$25,D3
02:0003F1E4 6702            	 12302:     beq  _anon_z04_158
02:0003F1E6 7018            	 12303:     moveq   #24,D0
                            	 12304: _anon_z04_158:
02:0003F1E8 1880            	 12305:     move.b  D0,($0000,A4)
                            	 12306:     ; This location is right above Patra.
                            	 12307:     ; Set Y coordinate to (Patra's Y - [00]).
                            	 12308:     ;
02:0003F1EA 102C0085        	 12309:     move.b  ($0085,A4),D0
02:0003F1EE 003C0011        	 12310:     ori     #$11,CCR  ; SEC: set C+X
02:0003F1F2 1214            	 12311:     move.b  ($0000,A4),D1
02:0003F1F4 0A3C0010        	 12312:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F1F8 9101            	 12313:     subx.b  D1,D0   ; SBC $00
02:0003F1FA 0A3C0010        	 12314:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F1FE 41EC0084        	 12315:     lea     ($0084,A4),A0
02:0003F202 11802000        	 12316:     move.b  D0,(A0,D2.W)
                            	 12317:     even
                            	 12318: _L_z04_UpdatePatraChild_Exit:
02:0003F206 4E75            	 12319:     rts
                            	 12320: 
                            	 12321:     even
                            	 12322: PatraChild_State1:
                            	 12323:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12324:     ;
02:0003F208 10342070        	 12325:     move.b  ($70,A4,D2.W),D0
02:0003F20C 023C00EE        	 12326:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F210 122C046C        	 12327:     move.b  ($046C,A4),D1
02:0003F214 D101            	 12328:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003F216 19802070        	 12329:     move.b  D0,($70,A4,D2.W)
02:0003F21A 41EC0084        	 12330:     lea     ($0084,A4),A0
02:0003F21E 10302000        	 12331:     move.b  (A0,D2.W),D0
02:0003F222 023C00EE        	 12332:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F226 122C0479        	 12333:     move.b  ($0479,A4),D1
02:0003F22A D101            	 12334:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003F22C 41EC0084        	 12335:     lea     ($0084,A4),A0
02:0003F230 11802000        	 12336:     move.b  D0,(A0,D2.W)
                            	 12337:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12338:     ;
02:0003F234 7000            	 12339:     moveq   #0,D0
02:0003F236 1940000B        	 12340:     move.b  D0,($000B,A4)
                            	 12341:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12342:     ; monster's angle by $70, else by $60 to go slower.
                            	 12343:     ;
02:0003F23A 7070            	 12344:     moveq   #112,D0
02:0003F23C 7600            	 12345:     moveq   #0,D3
02:0003F23E 41EC034F        	 12346:     lea     ($034F,A4),A0
02:0003F242 16302000        	 12347:     move.b  (A0,D2.W),D3
02:0003F246 0C030025        	 12348:     cmpi.b  #$25,D3
02:0003F24A 6702            	 12349:     beq  _anon_z04_159
02:0003F24C 7060            	 12350:     moveq   #96,D0
                            	 12351: _anon_z04_159:
02:0003F24E 61000DD8        	 12352:     jsr     DecreaseObjectAngle
                            	 12353:     ; Load Patra's maneuver index.
                            	 12354:     ; It determines which counts of bits are looked up below.
                            	 12355:     ;
02:0003F252 7600            	 12356:     moveq   #0,D3
02:0003F254 162C045F        	 12357:     move.b  ($045F,A4),D3
                            	 12358:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12359:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12360:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12361:     ;
02:0003F258 41EC034F        	 12362:     lea     ($034F,A4),A0
02:0003F25C 10302000        	 12363:     move.b  (A0,D2.W),D0
02:0003F260 0C000025        	 12364:     cmpi.b  #$25,D0
02:0003F264 661E            	 12365:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F266 41F90003F158    	 12366:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F26C 10303000        	 12367:     move.b  (A0,D3.W),D0
02:0003F270 1B00            	 12368:     move.b  D0,-(A5)  ; PHA
02:0003F272 41F90003F15C    	 12369:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F278 10303000        	 12370:     move.b  (A0,D3.W),D0
02:0003F27C 7600            	 12371:     moveq   #0,D3
02:0003F27E 1600            	 12372:     move.b  D0,D3
02:0003F280 101D            	 12373:     move.b  (A5)+,D0  ; PLA
02:0003F282 600E            	 12374:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12375: 
                            	 12376:     even
                            	 12377: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12378:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12379:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12380:     ; a small circle (5) and a large circle (6).
                            	 12381:     ;
02:0003F284 41F90003F15A    	 12382:     lea     (PatraChild2RotationBits).l,A0
02:0003F28A 10303000        	 12383:     move.b  (A0,D3.W),D0
02:0003F28E 7600            	 12384:     moveq   #0,D3
02:0003F290 1600            	 12385:     move.b  D0,D3
                            	 12386:     even
                            	 12387: _L_z04_PatraChild_State1_Rotate:
02:0003F292 61000BE4        	 12388:     jsr     RotateObjectLocation
02:0003F296 41EC0084        	 12389:     lea     ($0084,A4),A0
02:0003F29A 11802000        	 12390:     move.b  D0,(A0,D2.W)
02:0003F29E 611C            	 12391:     jsr     PatraChild_Draw
                            	 12392:     ; If Patra's state still = 0, then the last patra child has not
                            	 12393:     ; shown up yet. In this case don't check collisions yet, only return.
                            	 12394:     ;
02:0003F2A0 102C00AD        	 12395:     move.b  ($00AD,A4),D0
02:0003F2A4 6714            	 12396:     beq  _L_z04_PatraChild_State1_Exit
02:0003F2A6 4EB900031D24    	 12397:     jsr     CheckMonsterCollisions
                            	 12398:     ; If the monster died, then change to the dead dummy object.
                            	 12399:     ;
02:0003F2AC 41EC0405        	 12400:     lea     ($0405,A4),A0
02:0003F2B0 10302000        	 12401:     move.b  (A0,D2.W),D0
02:0003F2B4 6704            	 12402:     beq  _L_z04_PatraChild_State1_Exit
02:0003F2B6 6100FA72        	 12403:     jsr     SetDeadDummyObjType
                            	 12404:     even
                            	 12405: _L_z04_PatraChild_State1_Exit:
02:0003F2BA 4E75            	 12406:     rts
                            	 12407: 
