02:0003AC1A 12302000        	  2796:     move.b  (A0,D2.W),D1
02:0003AC1E D101            	  2797:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003AC20 7600            	  2798:     moveq   #0,D3
02:0003AC22 1600            	  2799:     move.b  D0,D3
02:0003AC24 41F90003AAD2    	  2800:     lea     (JumperYAccelerations).l,A0
