                            	  5826: _anon_z04_81:
                            	  5827:     ; Chase while flying, as usual.
                            	  5828:     ;
02:0003C272 61003AB4        	  5829:     jsr     Flyer_Chase
                            	  5830:     ; If timer has not expired, then
                            	  5831:     ; go see if it's time to propagate direction changes down the chain.
                            	  5832:     ;
02:0003C276 10342028        	  5833:     move.b  ($28,A4,D2.W),D0
02:0003C27A 6702            	  5834:     beq.s  __far_z_04_0041
02:0003C27C 6032            	  5835:     jmp  Moldorm_PropagateDirs
                            	  5836: __far_z_04_0041:
                            	  5837:     even
                            	  5838: Moldorm_ChangeFlyingState:
                            	  5839:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5840:     ;
02:0003C27E 61000096        	  5841:     jsr     Flyer_MoldormDecideState
02:0003C282 7010            	  5842:     moveq   #16,D0
02:0003C284 19802028        	  5843:     move.b  D0,($28,A4,D2.W)
                            	  5844:     ; If the next lower slot's direction <> 0, then
                            	  5845:     ; go propagate direction changes down the chain.
                            	  5846:     ;
                            	  5847:     ; But you had to have propagated directions once for the
                            	  5848:     ; next lower direction to be set. How does it happen?
                            	  5849:     ;
                            	  5850:     ; Within a flyer state, the flying routines turn the flyer
                            	  5851:     ; and set the object timer to $10 several times. After any of
                            	  5852:     ; those times will the test succeed.
                            	  5853:     ;
                            	  5854:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5855:     ; in this block to set the timer to $10, and try to propagate
                            	  5856:     ; directions.
                            	  5857:     ;
                            	  5858:     ; But this is also the case the first time here.
                            	  5859:     ;
                            	  5860:     ; So, I believe that the point of this test is to delay moving
                            	  5861:     ; the lower (not head) segments when starting out.
                            	  5862:     ;
02:0003C288 41EC0097        	  5863:     lea     ($0097,A4),A0
02:0003C28C 10302000        	  5864:     move.b  (A0,D2.W),D0
02:0003C290 6702            	  5865:     beq.s  __far_z_04_0042
02:0003C292 601C            	  5866:     jmp  Moldorm_PropagateDirs
                            	  5867: __far_z_04_0042:
02:0003C294 4E75            	  5868:     rts
                            	  5869: 
                            	  5870:     even
                            	  5871: Moldorm_Wander:
                            	  5872:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5873:     ; Only the head controls the movement direction.
                            	  5874:     ;
02:0003C296 0C020005        	  5875:     cmpi.b  #$05,D2
02:0003C29A 6708            	  5876:     beq  _anon_z04_82
02:0003C29C 0C02000A        	  5877:     cmpi.b  #$0A,D2
02:0003C2A0 6702            	  5878:     beq.s  __far_z_04_0043
02:0003C2A2 6070            	  5879:     jmp  L1156B_Exit
                            	  5880: __far_z_04_0043:
                            	  5881: _anon_z04_82:
                            	  5882:     ; Turn randomly while flying, as usual.
                            	  5883:     ;
02:0003C2A4 61003B60        	  5884:     jsr     Flyer_Wander
                            	  5885:     ; After every turn, the common flyer routines set timer to $10.
                            	  5886:     ; This can be used as a signal for moldorm to propagate
                            	  5887:     ; direction changes down the chain.
                            	  5888:     ;
                            	  5889:     ; Between each turn, timer <> $10.
                            	  5890:     ;
                            	  5891:     ; At the end of the delay after the last turn, timer = 0.
                            	  5892:     ; This is a signal that that flying state ended, and a new one
                            	  5893:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5894:     ; we can propagate direction changes again; and start
                            	  5895:     ; a new flying interval by setting timer to $10. This will make
                            	  5896:     ; the next flying state delay that amount of time before turning
                            	  5897:     ; the first time.
                            	  5898:     ;
                            	  5899:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5900:     ; arm the timer again, and shift directions down the chain.
                            	  5901:     ;
02:0003C2A8 10342028        	  5902:     move.b  ($28,A4,D2.W),D0
02:0003C2AC 6602            	  5903:     bne.s  __far_z_04_0044
02:0003C2AE 60CE            	  5904:     jmp  Moldorm_ChangeFlyingState
                            	  5905: __far_z_04_0044:
                            	  5906:     even
                            	  5907: Moldorm_PropagateDirs:
                            	  5908:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5909:     ;
02:0003C2B0 10342028        	  5910:     move.b  ($28,A4,D2.W),D0
02:0003C2B4 0C000010        	  5911:     cmpi.b  #$10,D0
02:0003C2B8 6702            	  5912:     beq.s  __far_z_04_0045
02:0003C2BA 6058            	  5913:     jmp  L1156B_Exit
                            	  5914: __far_z_04_0045:
                            	  5915:     ; Timer = $10.
                            	  5916:     ;
                            	  5917:     ; If deferred bounce direction <> 0, then
                            	  5918:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  5919:     ;
02:0003C2BC 41EC03BC        	  5920:     lea     ($03BC,A4),A0
02:0003C2C0 10302000        	  5921:     move.b  (A0,D2.W),D0
02:0003C2C4 6712            	  5922:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003C2C6 41EC0098        	  5923:     lea     ($0098,A4),A0
02:0003C2CA 11802000        	  5924:     move.b  D0,(A0,D2.W)
02:0003C2CE 7000            	  5925:     moveq   #0,D0
02:0003C2D0 41EC03BC        	  5926:     lea     ($03BC,A4),A0
02:0003C2D4 11802000        	  5927:     move.b  D0,(A0,D2.W)
                            	  5928:     even
                            	  5929: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  5930:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  5931:     ;
02:0003C2D8 7004            	  5932:     moveq   #4,D0
02:0003C2DA 1880            	  5933:     move.b  D0,($0000,A4)
                            	  5934:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  5935:     ;
02:0003C2DC 7600            	  5936:     moveq   #0,D3
02:0003C2DE 0C020005        	  5937:     cmpi.b  #$05,D2
02:0003C2E2 6702            	  5938:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C2E4 7605            	  5939:     moveq   #5,D3
                            	  5940:     even
                            	  5941: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  5942:     ; Copy old direction from a higher slot to the lower one;
                            	  5943:     ; and to the lower one's facing direction.
                            	  5944:     ;
02:0003C2E6 41EC0382        	  5945:     lea     ($0382,A4),A0
02:0003C2EA 10303000        	  5946:     move.b  (A0,D3.W),D0
02:0003C2EE 41EC0381        	  5947:     lea     ($0381,A4),A0
02:0003C2F2 11803000        	  5948:     move.b  D0,(A0,D3.W)
02:0003C2F6 41EC0099        	  5949:     lea     ($0099,A4),A0
02:0003C2FA 11803000        	  5950:     move.b  D0,(A0,D3.W)
                            	  5951:     ; Bottom of the loop.
                            	  5952:     ; Increment segment index.
                            	  5953:     ; Decrement loop counter.
                            	  5954:     ;
02:0003C2FE 5203            	  5955:     addq.b  #1,D3
02:0003C300 5314            	  5956:     subq.b  #1,($0000,A4)
02:0003C302 66E2            	  5957:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  5958:     ; Copy current direction to old direction.
                            	  5959:     ;
