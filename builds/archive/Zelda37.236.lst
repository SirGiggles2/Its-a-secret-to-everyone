02:0003CC56 123C0008        	  7200:     move.b  #$08,D1
02:0003CC5A D101            	  7201:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7202: _anon_z04_91:
02:0003CC5C 1880            	  7203:     move.b  D0,($0000,A4)
                            	  7204:     ; Store (Y + 8) in [01].
                            	  7205:     ;
02:0003CC5E 41EC0084        	  7206:     lea     ($0084,A4),A0
02:0003CC62 10302000        	  7207:     move.b  (A0,D2.W),D0
02:0003CC66 123C0008        	  7208:     move.b  #$08,D1
02:0003CC6A D101            	  7209:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC6C 19400001        	  7210:     move.b  D0,($0001,A4)
                            	  7211:     ; Only check the first bomb slot ($10).
                            	  7212:     ;
                            	  7213:     ; Store the bomb's (X + 8) in [02].
                            	  7214:     ;
02:0003CC70 7610            	  7215:     moveq   #16,D3
02:0003CC72 10343070        	  7216:     move.b  ($70,A4,D3.W),D0
02:0003CC76 123C0008        	  7217:     move.b  #$08,D1
02:0003CC7A D101            	  7218:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC7C 19400002        	  7219:     move.b  D0,($0002,A4)
                            	  7220:     ; Store the bomb's (Y + 8) in [03].
                            	  7221:     ;
02:0003CC80 41EC0084        	  7222:     lea     ($0084,A4),A0
02:0003CC84 10303000        	  7223:     move.b  (A0,D3.W),D0
02:0003CC88 123C0008        	  7224:     move.b  #$08,D1
02:0003CC8C D101            	  7225:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC8E 19400003        	  7226:     move.b  D0,($0003,A4)
                            	  7227:     ; But, if there's no bomb, then return.
                            	  7228:     ;
02:0003CC92 41EC00AC        	  7229:     lea     ($00AC,A4),A0
02:0003CC96 10303000        	  7230:     move.b  (A0,D3.W),D0
02:0003CC9A 6720            	  7231:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7232:     ; If the bomb has not exploded (state $12), then
                            	  7233:     ; go see if Dodongo will eat it.
