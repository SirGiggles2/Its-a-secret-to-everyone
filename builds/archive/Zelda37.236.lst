                            	  5575: 
                            	  5576: ; Params:
                            	  5577: ; [02]: Y
                            	  5578: ; [03]: X
                            	  5579: ;
                            	  5580: ; Returns:
                            	  5581: ; [00]: high byte of PPU address
                            	  5582: ; [01]: low byte of PPU address
                            	  5583: ;
                            	  5584: ;
                            	  5585: ; Turn the 16-bit value 08YY into the PPU address
                            	  5586: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5587: ;
                            	  5588: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5589: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5590: ;
                            	  5591:     even
