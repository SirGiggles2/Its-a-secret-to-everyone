                            	   561: 
                            	   562: ;------------------------------------------------------------------------------
                            	   563: ; _c_move_object_shim — MoveObject trampoline.
                            	   564: ;
                            	   565: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   566: ;   Input:     D2 = slot (0..11)
                            	   567: ;   Preserves: D2, A4, A5
                            	   568: ;   Clobbers:  D0, D1, D3, A0
                            	   569: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   570: ;
                            	   571: ; GCC side:
                            	   572: ;   void c_move_object(unsigned short slot);
                            	   573: ;     slot arrives as a 16-bit value on the stack.
                            	   574: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   575: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   576: ;   never clobbered by gcc.
                            	   577: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   578: ;   semantics can exist in a pure C port).
                            	   579: ;------------------------------------------------------------------------------
                            	   580: _c_move_object_shim:
                            	   581:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   582:     move.b  #$AA,($0900,A4)
                            	   583:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   584:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   585:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   586:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   587:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   588:     moveq   #0,D0
02:0002B658 3002            	   589:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   590:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   591:     jsr     c_move_object
02:0002B662 588F            	   592:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   593:     rts
                            	   594: 
                            	   595: ;==============================================================================
                            	   596: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   597: ; and tail-call the native asm function.
                            	   598: ;
                            	   599: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   600: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   601: ; sign-extended).
                            	   602: ;==============================================================================
                            	   603: 
                            	   604: ;------------------------------------------------------------------------------
                            	   605: ; void c_copy_bank_to_window(unsigned int bank);
                            	   606: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   607: ;------------------------------------------------------------------------------
                            	   608: c_copy_bank_to_window:
02:0002B666 202F0004        	   609:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   610:     jmp     _copy_bank_to_window
                            	   611: 
                            	   612: ;------------------------------------------------------------------------------
                            	   613: ; unsigned char c_ppu_read_2(void);
                            	   614: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   615: ; C return: gcc expects result in D0.
                            	   616: ;------------------------------------------------------------------------------
                            	   617: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   618:     jmp     _ppu_read_2
                            	   619: 
                            	   620: ;------------------------------------------------------------------------------
                            	   621: ; void c_ppu_write_6(unsigned int val);
                            	   622: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   623: ;------------------------------------------------------------------------------
                            	   624: c_ppu_write_6:
02:0002B674 202F0004        	   625:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   626:     jmp     _ppu_write_6
                            	   627: 
                            	   628: ;------------------------------------------------------------------------------
                            	   629: ; void c_ppu_write_7(unsigned int val);
                            	   630: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   631: ;------------------------------------------------------------------------------
                            	   632: c_ppu_write_7:
02:0002B67E 202F0004        	   633:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   634:     jmp     _ppu_write_7
                            	   635: 
                            	   636: ;------------------------------------------------------------------------------
                            	   637: ; void c_turn_off_all_video(void);
                            	   638: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   639: ;------------------------------------------------------------------------------
                            	   640: c_turn_off_all_video:
02:0002B688 4EF90004AA40    	   641:     jmp     TurnOffAllVideo
                            	   642: 
                            	   643: ;==============================================================================
                            	   644: ; EXPORT side — z_03 entry point.
                            	   645: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   646: ; the transpiler emits that label pointing to this shim instead of the
                            	   647: ; z_03 asm body. The C function takes no args and returns void.
                            	   648: ;==============================================================================
                            	   649: 
                            	   650: ;------------------------------------------------------------------------------
                            	   651: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   652: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   653: ;------------------------------------------------------------------------------
                            	   654: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   655:     jmp     z03_transfer_level_pattern_blocks
                            	   656: 
                            	   657: ;==============================================================================
                            	   658: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   659: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   660: ;==============================================================================
                            	   661: 
                            	   662: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   663:     jmp     z06_init_mode2_submodes
                            	   664: 
                            	   665: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   666:     jmp     z06_copy_common_data_to_ram
                            	   667: 
                            	   668: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   669:     jmp     z06_update_mode2_load_full
                            	   670: 
                            	   671: ;==============================================================================
                            	   672: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   673: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   674: ;==============================================================================
                            	   675: 
                            	   676: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   677:     jmp     z05_copy_column_to_tilebuf
                            	   678: 
                            	   679: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   680:     jmp     z05_copy_row_to_tilebuf
                            	   681: 
                            	   682: ;==============================================================================
                            	   683: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   684: ;==============================================================================
                            	   685: 
                            	   686: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   687: c_has_compass:
02:0002B6B2 4EB900000000    	   688:     jsr     z05_has_compass
02:0002B6B8 4A00            	   689:     tst.b   D0
02:0002B6BA 4E75            	   690:     rts
                            	   691: 
                            	   692: c_has_map:
02:0002B6BC 4EB900000000    	   693:     jsr     z05_has_map
02:0002B6C2 4A00            	   694:     tst.b   D0
02:0002B6C4 4E75            	   695:     rts
                            	   696: 
                            	   697: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
