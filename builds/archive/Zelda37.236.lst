                            	  2736:     ; We'll be computing the location of the square.
                            	  2737:     ; Start with Link's location.
                            	  2738:     ;
02:0003041C 102C0070        	  2739:     move.b  ($0070,A4),D0
02:00030420 1880            	  2740:     move.b  D0,($0000,A4)
02:00030422 102C0084        	  2741:     move.b  ($0084,A4),D0
02:00030426 19400001        	  2742:     move.b  D0,($0001,A4)
02:0003042A 102C0098        	  2743:     move.b  ($0098,A4),D0
02:0003042E 0200000C        	  2744:     andi.b #$0C,D0
02:00030432 6726            	  2745:     beq  _L_z01_CheckPassiveTileObjects_CheckHorizontal
                            	  2746:     ; Link is facing vertically.
                            	  2747:     ;
                            	  2748:     ; If Link touched the left side of the square with the right side
                            	  2749:     ; of his body, then add 8 to X.
                            	  2750:     ;
                            	  2751:     ; If Link touched the right side of the square with the left side
                            	  2752:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2753:     ;
02:00030434 102C0002        	  2754:     move.b  ($0002,A4),D0
02:00030438 02000003        	  2755:     andi.b #$03,D0
