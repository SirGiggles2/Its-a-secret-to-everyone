                            	  7412: ; Y: weapon or Link object slot (copied from [00])
                            	  7413: ; Z: 0 if objects collide
                            	  7414: ; [06]: 1 if objects collide
                            	  7415: ; [0A]: horizontal distance
                            	  7416: ; [0B]: vertical distance
