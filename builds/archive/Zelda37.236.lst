02:0003D1C4 41EC0394        	  7973:     lea     ($0394,A4),A0
02:0003D1C8 11802000        	  7974:     move.b  D0,(A0,D2.W)
                            	  7975:     ; Align the monster with a square horizontally.
                            	  7976:     ;
                            	  7977:     ; If in the left half of a square, align with that square.
                            	  7978:     ; If in the right half, align with the next square.
                            	  7979:     ;
02:0003D1CC 10342070        	  7980:     move.b  ($70,A4,D2.W),D0
02:0003D1D0 023C00EE        	  7981:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D1D4 123C0008        	  7982:     move.b  #$08,D1
02:0003D1D8 D101            	  7983:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D1DA 020000F0        	  7984:     andi.b #$F0,D0
02:0003D1DE 19802070        	  7985:     move.b  D0,($70,A4,D2.W)
                            	  7986:     ; Align the monster with a square vertically.
                            	  7987:     ;
                            	  7988:     ; If in the top half of a square, align with that square.
                            	  7989:     ; If in the bottom half, align with the next square.
                            	  7990:     ;
02:0003D1E2 41EC0084        	  7991:     lea     ($0084,A4),A0
02:0003D1E6 10302000        	  7992:     move.b  (A0,D2.W),D0
02:0003D1EA 023C00EE        	  7993:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D1EE 123C0008        	  7994:     move.b  #$08,D1
02:0003D1F2 D101            	  7995:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D1F4 020000F0        	  7996:     andi.b #$F0,D0
                            	  7997:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7998:     ;
02:0003D1F8 003C0011        	  7999:     ori     #$11,CCR  ; SEC: set C+X
02:0003D1FC 123C0003        	  8000:     move.b  #$03,D1
02:0003D200 0A3C0010        	  8001:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D204 9101            	  8002:     subx.b  D1,D0   ; SBC #$03
02:0003D206 0A3C0010        	  8003:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D20A 41EC0084        	  8004:     lea     ($0084,A4),A0
02:0003D20E 11802000        	  8005:     move.b  D0,(A0,D2.W)
                            	  8006:     even
