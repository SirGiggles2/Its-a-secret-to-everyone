02:0002E3E6 16302000        	   418:     move.b  (A0,D2.W),D3
02:0002E3EA 41EC046F        	   419:     lea     ($046F,A4),A0
02:0002E3EE 10303000        	   420:     move.b  (A0,D3.W),D0
02:0002E3F2 41EC0448        	   421:     lea     ($0448,A4),A0
02:0002E3F6 11802000        	   422:     move.b  D0,(A0,D2.W)
02:0002E3FA 5302            	   423:     subq.b  #1,D2
02:0002E3FC 6AE2            	   424:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   425:     even
