                            	  2846: __far_z_04_0023:
                            	  2847:     ; Distance < 3. Go to state 0.
                            	  2848:     ;
                            	  2849:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2850:     ;
02:0003AC92 4EB90004C9EA    	  2851:     jsr     ResetObjState
02:0003AC98 7600            	  2852:     moveq   #0,D3
02:0003AC9A 41EC034F        	  2853:     lea     ($034F,A4),A0
02:0003AC9E 16302000        	  2854:     move.b  (A0,D2.W),D3
02:0003ACA2 0C030020        	  2855:     cmpi.b  #$20,D3
02:0003ACA6 6748            	  2856:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2857:     ; Else calculate a timer value.
                            	  2858:     ;
                            	  2859:     ; t := (Random + $10)
                            	  2860:     ; if t < $20 then
                            	  2861:     ;   t := t - $40
                            	  2862:     ;
02:0003ACA8 7010            	  2863:     moveq   #16,D0
02:0003ACAA 023C00EE        	  2864:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ACAE 12342019        	  2865:     move.b  ($19,A4,D2.W),D1
02:0003ACB2 D101            	  2866:     addx.b  D1,D0   ; ADC Random+1,X
02:0003ACB4 0C000020        	  2867:     cmpi.b  #$20,D0
02:0003ACB8 6412            	  2868:     bcc  _anon_z04_39
02:0003ACBA 003C0011        	  2869:     ori     #$11,CCR  ; SEC: set C+X
02:0003ACBE 123C0040        	  2870:     move.b  #$40,D1
02:0003ACC2 0A3C0010        	  2871:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ACC6 9101            	  2872:     subx.b  D1,D0   ; SBC #$40
02:0003ACC8 0A3C0010        	  2873:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2874: _anon_z04_39:
                            	  2875:     ; If the object is a blue tektite, then go use this t.
                            	  2876:     ;
02:0003ACCC 7600            	  2877:     moveq   #0,D3
02:0003ACCE 41EC034F        	  2878:     lea     ($034F,A4),A0
