02:000305D4 41EC0084        	  2968:     lea     ($0084,A4),A0
02:000305D8 12302000        	  2969:     move.b  (A0,D2.W),D1
02:000305DC 0A3C0010        	  2970:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000305E0 9101            	  2971:     subx.b  D1,D0   ; SBC ObjY,X
02:000305E2 0A3C0010        	  2972:     eori    #$10,CCR  ; restore X = 6502 C
02:000305E6 6100086E        	  2973:     jsr     Abs
02:000305EA 0C00000E        	  2974:     cmpi.b  #$0E,D0
