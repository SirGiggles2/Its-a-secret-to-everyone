                            	  3982:     ; Else check for all collisions.
                            	  3983:     ;
02:0003B49C 4EB900031D24    	  3984:     jsr     CheckMonsterCollisions
                            	  3985:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3986:     ;
02:0003B4A2 41EC0405        	  3987:     lea     ($0405,A4),A0
02:0003B4A6 10302000        	  3988:     move.b  (A0,D2.W),D0
02:0003B4AA 670A            	  3989:     beq  _anon_z04_55
02:0003B4AC 705D            	  3990:     moveq   #93,D0
02:0003B4AE 41EC034F        	  3991:     lea     ($034F,A4),A0
02:0003B4B2 11802000        	  3992:     move.b  D0,(A0,D2.W)
