02:0004C634 1940000F        	  5782:     move.b  D0,($000F,A4)
02:0004C638 41EC0098        	  5783:     lea     ($0098,A4),A0
02:0004C63C 11802000        	  5784:     move.b  D0,(A0,D2.W)
02:0004C640 1003            	  5785:     move.b  D3,D0
02:0004C642 1B00            	  5786:     move.b  D0,-(A5)  ; PHA
02:0004C644 6100F46A        	  5787:     jsr     MoveObject
                            	  5788:     ; Move horizontally towards the thrower.
                            	  5789:     ;
02:0004C648 101D            	  5790:     move.b  (A5)+,D0  ; PLA
02:0004C64A 7600            	  5791:     moveq   #0,D3
02:0004C64C 1600            	  5792:     move.b  D0,D3
02:0004C64E 41F90004C304    	  5793:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004C654 10303000        	  5794:     move.b  (A0,D3.W),D0
02:0004C658 4EB900030F7E    	  5795:     jsr     SetBoomerangSpeed
02:0004C65E 102C000B        	  5796:     move.b  ($000B,A4),D0
02:0004C662 1940000F        	  5797:     move.b  D0,($000F,A4)
02:0004C666 41EC0098        	  5798:     lea     ($0098,A4),A0
02:0004C66A 11802000        	  5799:     move.b  D0,(A0,D2.W)
02:0004C66E 6100F440        	  5800:     jsr     MoveObject
                            	  5801:     even
                            	  5802: AnimateBoomerangAndCheckCollision:
                            	  5803:     ; Decrement animation counter; and when it reaches 0:
                            	  5804:     ; 1. arm it again for 2 frames
                            	  5805:     ; 2. advance the minor state within a cycle of 8
                            	  5806:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5807:     ;
