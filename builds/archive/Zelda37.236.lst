                            	 12409: PatraChild_Draw:
02:0003F2BC 4EB900031C98    	 12410:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
                            	 12411:     ; 2 was returned from the routine above in A.
                            	 12412:     ; Pass it as the animation counter value to the routine below.
                            	 12413:     ;
02:0003F2C2 4EB90004CE46    	 12414:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003F2C8 41EC03E4        	 12415:     lea     ($03E4,A4),A0
02:0003F2CC 10302000        	 12416:     move.b  (A0,D2.W),D0
02:0003F2D0 4EF9000319A8    	 12417:     jmp     DrawObjectNotMirrored
