                            	  9572: Manhandla_Move:
                            	  9573:     ; Implement a way of manifesting the fractional part of the speed
                            	  9574:     ; in the movement.
                            	  9575:     ;
                            	  9576:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9577:     ; byte to add to the coordinates, then the effective speed would
                            	  9578:     ; be 1 pixel a frame instead of 1.25.
                            	  9579:     ;
                            	  9580:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9581:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9582:     ;
                            	  9583:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9584:     ;
                            	  9585:     ;   SA := SA + (SL AND $E0)
                            	  9586:     ;   [03] := SH + carry
                            	  9587:     ;
                            	  9588:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9589:     ;
02:0003DD9E 41EC041F        	  9590:     lea     ($041F,A4),A0
02:0003DDA2 10302000        	  9591:     move.b  (A0,D2.W),D0
02:0003DDA6 020000E0        	  9592:     andi.b #$E0,D0
02:0003DDAA 023C00EE        	  9593:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDAE 41EC0412        	  9594:     lea     ($0412,A4),A0
02:0003DDB2 12302000        	  9595:     move.b  (A0,D2.W),D1
02:0003DDB6 D101            	  9596:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DDB8 41EC0412        	  9597:     lea     ($0412,A4),A0
02:0003DDBC 11802000        	  9598:     move.b  D0,(A0,D2.W)
                            	  9599:     ; Assign (high speed byte + carry) to [03].
                            	  9600:     ;
02:0003DDC0 41EC042C        	  9601:     lea     ($042C,A4),A0
02:0003DDC4 10302000        	  9602:     move.b  (A0,D2.W),D0
02:0003DDC8 123C0000        	  9603:     move.b  #$00,D1
02:0003DDCC D101            	  9604:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DDCE 19400003        	  9605:     move.b  D0,($0003,A4)
                            	  9606:     ; Change coordinates by the speed amount/offset in [03]
                            	  9607:     ; according to the direction.
                            	  9608:     ;
                            	  9609:     ; Start with a mask of $A1 in [02]:
                            	  9610:     ; - low nibble represents the right direction
                            	  9611:     ; - high nibble is used to set or clear carry as we go along
                            	  9612:     ;
02:0003DDD2 103C00A1        	  9613:     move.b  #$A1,D0
02:0003DDD6 19400002        	  9614:     move.b  D0,($0002,A4)
                            	  9615:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9616:     ;
02:0003DDDA 41EC0098        	  9617:     lea     ($0098,A4),A0
02:0003DDDE 10302000        	  9618:     move.b  (A0,D2.W),D0
02:0003DDE2 122C0002        	  9619:     move.b  ($0002,A4),D1
02:0003DDE6 C200            	  9620:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DDE8 6712            	  9621:     beq  _L_z04_Manhandla_Move_Left
02:0003DDEA 10342070        	  9622:     move.b  ($70,A4,D2.W),D0
02:0003DDEE 023C00EE        	  9623:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDF2 122C0003        	  9624:     move.b  ($0003,A4),D1
02:0003DDF6 D101            	  9625:     addx.b  D1,D0   ; ADC $03
02:0003DDF8 19802070        	  9626:     move.b  D0,($70,A4,D2.W)
                            	  9627:     even
                            	  9628: _L_z04_Manhandla_Move_Left:
                            	  9629:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9630:     ;
02:0003DDFC 41EC0098        	  9631:     lea     ($0098,A4),A0
02:0003DE00 10302000        	  9632:     move.b  (A0,D2.W),D0
02:0003DE04 122C0002        	  9633:     move.b  ($0002,A4),D1
02:0003DE08 E309            	  9634:     lsl.b  #1,D1   ; ASL $02
02:0003DE0A 19410002        	  9635:     move.b  D1,($0002,A4)
02:0003DE0E 122C0002        	  9636:     move.b  ($0002,A4),D1
02:0003DE12 C200            	  9637:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE14 6716            	  9638:     beq  _L_z04_Manhandla_Move_Down
02:0003DE16 10342070        	  9639:     move.b  ($70,A4,D2.W),D0
02:0003DE1A 122C0003        	  9640:     move.b  ($0003,A4),D1
02:0003DE1E 0A3C0010        	  9641:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DE22 9101            	  9642:     subx.b  D1,D0   ; SBC $03
02:0003DE24 0A3C0010        	  9643:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DE28 19802070        	  9644:     move.b  D0,($70,A4,D2.W)
                            	  9645:     even
