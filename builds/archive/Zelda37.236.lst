02:0003EF3C C200            	 11926:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF3E 66D2            	 11927:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EF40 67F0            	 11928:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
