02:0004453E 123C0040        	  7245:     move.b  #$40,D1
02:00044542 0A3C0010        	  7246:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044546 9101            	  7247:     subx.b  D1,D0   ; SBC #$40
02:00044548 0A3C0010        	  7248:     eori    #$10,CCR  ; restore X = 6502 C
