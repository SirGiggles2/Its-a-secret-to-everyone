                            	  6403: Digdogger_Move:
                            	  6404:     ; This calculation is the same one used in Manhandla to
                            	  6405:     ; manifest the fractional speed over several frames.
                            	  6406:     ;
                            	  6407:     ; To summarize, the formula is:
                            	  6408:     ;
                            	  6409:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6410:     ;
                            	  6411:     ;   SA := SA + (SL AND $E0)
                            	  6412:     ;   [03] := SH + carry
                            	  6413:     ;
                            	  6414:     ; See 04:A28E Manhandla_Move.
                            	  6415:     ;
02:0003C652 41EC041F        	  6416:     lea     ($041F,A4),A0
02:0003C656 10302000        	  6417:     move.b  (A0,D2.W),D0
02:0003C65A 020000E0        	  6418:     andi.b #$E0,D0
02:0003C65E 023C00EE        	  6419:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C662 41EC0412        	  6420:     lea     ($0412,A4),A0
02:0003C666 12302000        	  6421:     move.b  (A0,D2.W),D1
02:0003C66A D101            	  6422:     addx.b  D1,D0   ; ADC $0412,X
02:0003C66C 41EC0412        	  6423:     lea     ($0412,A4),A0
02:0003C670 11802000        	  6424:     move.b  D0,(A0,D2.W)
                            	  6425:     ; Assign (high speed byte + carry) to [03].
                            	  6426:     ;
02:0003C674 41EC042C        	  6427:     lea     ($042C,A4),A0
02:0003C678 10302000        	  6428:     move.b  (A0,D2.W),D0
02:0003C67C 123C0000        	  6429:     move.b  #$00,D1
02:0003C680 D101            	  6430:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C682 19400003        	  6431:     move.b  D0,($0003,A4)
                            	  6432:     ; Change coordinates by the speed amount/offset in [03]
                            	  6433:     ; according to the direction.
                            	  6434:     ;
                            	  6435:     ; Start with a mask of $A1 in [02]:
                            	  6436:     ; - low nibble represents the right direction
                            	  6437:     ; - high nibble is used to set or clear carry as we go along
                            	  6438:     ;
02:0003C686 103C00A1        	  6439:     move.b  #$A1,D0
02:0003C68A 19400002        	  6440:     move.b  D0,($0002,A4)
                            	  6441:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6442:     ;
02:0003C68E 41EC0098        	  6443:     lea     ($0098,A4),A0
02:0003C692 10302000        	  6444:     move.b  (A0,D2.W),D0
02:0003C696 122C0002        	  6445:     move.b  ($0002,A4),D1
02:0003C69A C200            	  6446:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C69C 6712            	  6447:     beq  _L_z04_Digdogger_Move_Left
02:0003C69E 10342070        	  6448:     move.b  ($70,A4,D2.W),D0
02:0003C6A2 023C00EE        	  6449:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C6A6 122C0003        	  6450:     move.b  ($0003,A4),D1
02:0003C6AA D101            	  6451:     addx.b  D1,D0   ; ADC $03
02:0003C6AC 19802070        	  6452:     move.b  D0,($70,A4,D2.W)
                            	  6453:     even
                            	  6454: _L_z04_Digdogger_Move_Left:
                            	  6455:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6456:     ;
02:0003C6B0 41EC0098        	  6457:     lea     ($0098,A4),A0
02:0003C6B4 10302000        	  6458:     move.b  (A0,D2.W),D0
02:0003C6B8 122C0002        	  6459:     move.b  ($0002,A4),D1
02:0003C6BC E309            	  6460:     lsl.b  #1,D1   ; ASL $02
02:0003C6BE 19410002        	  6461:     move.b  D1,($0002,A4)
02:0003C6C2 122C0002        	  6462:     move.b  ($0002,A4),D1
02:0003C6C6 C200            	  6463:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C6C8 6716            	  6464:     beq  _L_z04_Digdogger_Move_Down
02:0003C6CA 10342070        	  6465:     move.b  ($70,A4,D2.W),D0
02:0003C6CE 122C0003        	  6466:     move.b  ($0003,A4),D1
02:0003C6D2 0A3C0010        	  6467:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C6D6 9101            	  6468:     subx.b  D1,D0   ; SBC $03
02:0003C6D8 0A3C0010        	  6469:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C6DC 19802070        	  6470:     move.b  D0,($70,A4,D2.W)
                            	  6471:     even
                            	  6472: _L_z04_Digdogger_Move_Down:
                            	  6473:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  6474:     ;
02:0003C6E0 41EC0098        	  6475:     lea     ($0098,A4),A0
02:0003C6E4 10302000        	  6476:     move.b  (A0,D2.W),D0
02:0003C6E8 122C0002        	  6477:     move.b  ($0002,A4),D1
02:0003C6EC E309            	  6478:     lsl.b  #1,D1   ; ASL $02
02:0003C6EE 19410002        	  6479:     move.b  D1,($0002,A4)
02:0003C6F2 122C0002        	  6480:     move.b  ($0002,A4),D1
02:0003C6F6 C200            	  6481:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C6F8 6716            	  6482:     beq  _L_z04_Digdogger_Move_Up
02:0003C6FA 41EC0084        	  6483:     lea     ($0084,A4),A0
02:0003C6FE 10302000        	  6484:     move.b  (A0,D2.W),D0
02:0003C702 122C0003        	  6485:     move.b  ($0003,A4),D1
02:0003C706 D101            	  6486:     addx.b  D1,D0   ; ADC $03
02:0003C708 41EC0084        	  6487:     lea     ($0084,A4),A0
02:0003C70C 11802000        	  6488:     move.b  D0,(A0,D2.W)
                            	  6489:     even
