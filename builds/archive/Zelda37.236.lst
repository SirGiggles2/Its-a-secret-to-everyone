                            	  9706: Manhandla_Draw:
02:0003DEC2 4EB90004CE4C    	  9707:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9708:     ; Push the "frame image and sprite attributes" value.
                            	  9709:     ;
02:0003DEC8 41EC0478        	  9710:     lea     ($0478,A4),A0
02:0003DECC 10302000        	  9711:     move.b  (A0,D2.W),D0
02:0003DED0 1B00            	  9712:     move.b  D0,-(A5)  ; PHA
                            	  9713:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9714:     ; passed along as is.
                            	  9715:     ;
02:0003DED2 02000080        	  9716:     andi.b #$80,D0
02:0003DED6 00000001        	  9717:     ori.b #$01,D0
02:0003DEDA 4EB900031C9A    	  9718:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DEE0 101D            	  9719:     move.b  (A5)+,D0  ; PLA
02:0003DEE2 1B00            	  9720:     move.b  D0,-(A5)  ; PHA
                            	  9721:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9722:     ;
02:0003DEE4 02000040        	  9723:     andi.b #$40,D0
02:0003DEE8 6704            	  9724:     beq  _anon_z04_116
02:0003DEEA 522C000F        	  9725:     addq.b  #1,($000F,A4)
                            	  9726: _anon_z04_116:
02:0003DEEE 101D            	  9727:     move.b  (A5)+,D0  ; PLA
                            	  9728:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9729:     ; These are the 2 frame images of the horizontal hands.
                            	  9730:     ;
                            	  9731:     ; Else draw the base and vertical hands mirrored.
                            	  9732:     ;
02:0003DEF0 0200000F        	  9733:     andi.b #$0F,D0
02:0003DEF4 0C000002        	  9734:     cmpi.b  #$02,D0
02:0003DEF8 670C            	  9735:     beq  _anon_z04_117
02:0003DEFA 0C000003        	  9736:     cmpi.b  #$03,D0
02:0003DEFE 6706            	  9737:     beq  _anon_z04_117
02:0003DF00 4EF9000319A4    	  9738:     jmp     DrawObjectMirrored
                            	  9739: 
