                            	  5582:     ; If the weapon is a boomerang (not a monster arrow nor player arrow),
                            	  5583:     ; then go draw it and check for a collision.
                            	  5584:     ;
02:0004C4EE 0C02000D        	  5585:     cmpi.b  #$0D,D2
02:0004C4F2 640E            	  5586:     bcc  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_DrawPlayerWeapon
02:0004C4F4 41EC034F        	  5587:     lea     ($034F,A4),A0
02:0004C4F8 10302000        	  5588:     move.b  (A0,D2.W),D0
02:0004C4FC 0C00005B        	  5589:     cmpi.b  #$5B,D0
02:0004C500 670A            	  5590:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
                            	  5591:     even
                            	  5592: _L_z07_DrawArrowOrBoomerangAndCheckCollisions_DrawPlayerWeapon:
02:0004C502 0C020012        	  5593:     cmpi.b  #$12,D2
02:0004C506 6704            	  5594:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
