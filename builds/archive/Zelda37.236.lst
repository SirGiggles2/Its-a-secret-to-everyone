                            	  3249: _anon_z04_42:
                            	  3250:     ; State 0.
                            	  3251:     ;
                            	  3252:     ; In state we determine whether to burst out of the ground.
                            	  3253:     ; If the long timer has not expired, then return.
                            	  3254:     ;
