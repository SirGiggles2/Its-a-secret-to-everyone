02:0003B5BC 003C0011        	  4176:     ori     #$11,CCR  ; SEC: set C+X
02:0003B5C0 123C001C        	  4177:     move.b  #$1C,D1
02:0003B5C4 0A3C0010        	  4178:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B5C8 9101            	  4179:     subx.b  D1,D0   ; SBC #$1C
02:0003B5CA 0A3C0010        	  4180:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B5CE 41EC0084        	  4181:     lea     ($0084,A4),A0
