                            	  3308:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  3309:     ; go see if the tile is valid to come out of.
                            	  3310:     ;
                            	  3311:     ; Else it's too close to the top edge of the screen. So, return.
                            	  3312:     ;
02:0003B01C 0C00005D        	  3313:     cmpi.b  #$5D,D0
