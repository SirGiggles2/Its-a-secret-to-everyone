                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:000403AC 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:000403AE 7400            	   545:     moveq   #0,D2
02:000403B0 41F900040364    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:000403B6 14303000        	   547:     move.b  (A0,D3.W),D2
02:000403BA 41F900040394    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:000403C0 10303000        	   549:     move.b  (A0,D3.W),D0
02:000403C4 41F9000474F6    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000403CA 11802000        	   551:     move.b  D0,(A0,D2.W)
02:000403CE 5303            	   552:     subq.b  #1,D3
02:000403D0 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:000403D2 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
