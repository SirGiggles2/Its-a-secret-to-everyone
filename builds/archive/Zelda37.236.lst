                            	  5552: _L_z07_CheckState20_Deactivate:
02:0004C4B4 61000534        	  5553:     jsr     ResetObjState
                            	  5554:     ; If it's a monster's arrow, then destroy it in the monster slot,
                            	  5555:     ; including clearing object type.
                            	  5556:     ;
02:0004C4B8 0C02000D        	  5557:     cmpi.b  #$0D,D2
02:0004C4BC 6406            	  5558:     bcc  _anon_z07_29
02:0004C4BE 4EB90003A07A    	  5559:     jsr     DestroyCountedMonsterShot
                            	  5560: _anon_z07_29:
02:0004C4C4 0A3C0001        	  5561:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C4C8 4E75            	  5562:     rts
