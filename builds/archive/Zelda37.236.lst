                            	 12420: UpdateGanon:
02:0003F2D6 102C0445        	 12421:     move.b  ($0445,A4),D0
02:0003F2DA 4EB90002AECA    	 12422:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	 12423:     even
                            	 12424: UpdateGanon_JumpTable:
02:0003F2E0 0003F2EC        	 12425:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F2E4 0003F34E        	 12426:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F2E8 0003F37C        	 12427:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12428: 
                            	 12429: ; Description:
                            	 12430: ; Lift up the Triforce of Courage while the room is dark.
                            	 12431: ;
                            	 12432: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12433: ;
                            	 12434:     even
                            	 12435: Ganon_ScenePhase0:
02:0003F2EC 701B            	 12436:     moveq   #27,D0
02:0003F2EE 19400505        	 12437:     move.b  D0,($0505,A4)
                            	 12438:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12439:     ;
02:0003F2F2 102C0028        	 12440:     move.b  ($0028,A4),D0
02:0003F2F6 6644            	 12441:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12442:     ; Once the timer expires, it's time to brighten the room.
                            	 12443:     ;
                            	 12444:     ; Save the current object slot.
02:0003F2F8 1002            	 12445:     move.b  D2,D0
02:0003F2FA 1B00            	 12446:     move.b  D0,-(A5)  ; PHA
02:0003F2FC 610007F0        	 12447:     jsr     UpdateCandle
02:0003F300 101D            	 12448:     move.b  (A5)+,D0  ; PLA
02:0003F302 7400            	 12449:     moveq   #0,D2
02:0003F304 1400            	 12450:     move.b  D0,D2
                            	 12451:     ; Turn off the room brightening flag, because we're controlling it
                            	 12452:     ; here instead of in the Mode 5 object update loop.
                            	 12453:     ;
02:0003F306 7000            	 12454:     moveq   #0,D0
02:0003F308 1940051E        	 12455:     move.b  D0,($051E,A4)
                            	 12456:     ; On the first frame of the fade-to-light cycle, play the
                            	 12457:     ; Triforce/Ganon song.
                            	 12458:     ;
02:0003F30C 102C051C        	 12459:     move.b  ($051C,A4),D0
02:0003F310 0C0000C0        	 12460:     cmpi.b  #$C0,D0
02:0003F314 6606            	 12461:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F316 7002            	 12462:     moveq   #2,D0
02:0003F318 19400600        	 12463:     move.b  D0,($0600,A4)
                            	 12464:     even
                            	 12465: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12466:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12467:     ;
02:0003F31C 102C051C        	 12468:     move.b  ($051C,A4),D0
02:0003F320 0200000F        	 12469:     andi.b #$0F,D0
02:0003F324 0C000004        	 12470:     cmpi.b  #$04,D0
02:0003F328 6702            	 12471:     beq.s  __far_z_04_0121
02:0003F32A 6042            	 12472:     jmp  Ganon_DrawBodyFrame0
                            	 12473: __far_z_04_0121:
                            	 12474:     ; Set Link's timer to $C0 for the next scene phase.
                            	 12475:     ;
02:0003F32C 103C00C0        	 12476:     move.b  #$C0,D0
02:0003F330 19400028        	 12477:     move.b  D0,($0028,A4)
                            	 12478:     ; Set scene phase 1, and go draw Ganon.
                            	 12479:     ;
02:0003F334 522C0445        	 12480:     addq.b  #1,($0445,A4)
02:0003F338 6702            	 12481:     beq.s  __far_z_04_0122
02:0003F33A 6032            	 12482:     jmp  Ganon_DrawBodyFrame0
                            	 12483: __far_z_04_0122:
                            	 12484:     even
                            	 12485: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	 12486:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	 12487:     ; In this case, I think it means Ganon is shouting.
                            	 12488:     ;
02:0003F33C 0C000001        	 12489:     cmpi.b  #$01,D0
02:0003F340 6606            	 12490:     bne  _anon_z04_160
02:0003F342 7002            	 12491:     moveq   #2,D0
02:0003F344 19400601        	 12492:     move.b  D0,($0601,A4)
                            	 12493: _anon_z04_160:
02:0003F348 0A3C0001        	 12494:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F34C 4E75            	 12495:     rts
                            	 12496: 
                            	 12497: ; Description:
                            	 12498: ; Lift up the Triforce of Courage while the room is light.
                            	 12499: ;
                            	 12500: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12501: ;
                            	 12502:     even
                            	 12503: Ganon_ScenePhase1:
02:0003F34E 701B            	 12504:     moveq   #27,D0
02:0003F350 19400505        	 12505:     move.b  D0,($0505,A4)
                            	 12506:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12507:     ;
02:0003F354 102C0028        	 12508:     move.b  ($0028,A4),D0
02:0003F358 6702            	 12509:     beq.s  __far_z_04_0123
02:0003F35A 6012            	 12510:     jmp  Ganon_DrawBodyFrame0
                            	 12511: __far_z_04_0123:
                            	 12512:     ; Once the timer expires:
                            	 12513:     ; 1. unhalt Link
                            	 12514:     ; 2. clear the item to lift
                            	 12515:     ; 3. play level 9 song
                            	 12516:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12517:     ;
02:0003F35C 194000AC        	 12518:     move.b  D0,($00AC,A4)
02:0003F360 19400505        	 12519:     move.b  D0,($0505,A4)
02:0003F364 7020            	 12520:     moveq   #32,D0
02:0003F366 19400600        	 12521:     move.b  D0,($0600,A4)
02:0003F36A 522C0445        	 12522:     addq.b  #1,($0445,A4)
                            	 12523:     even
                            	 12524: Ganon_DrawBodyFrame0:
                            	 12525:     ; When holding the Triforce of Courage, only draw Ganon
                            	 12526:     ; with animation frame 0.
                            	 12527:     ;
02:0003F36E 7000            	 12528:     moveq   #0,D0
02:0003F370 41EC046B        	 12529:     lea     ($046B,A4),A0
02:0003F374 11802000        	 12530:     move.b  D0,(A0,D2.W)
02:0003F378 600002EC        	 12531:     jmp     Ganon_DrawBody
                            	 12532: 
                            	 12533: ; Description:
                            	 12534: ; Fighting Ganon.
                            	 12535: ;
                            	 12536: ; If Ganon is dying, go handle it.
                            	 12537: ;
                            	 12538:     even
                            	 12539: Ganon_ScenePhase2:
02:0003F37C 41EC042C        	 12540:     lea     ($042C,A4),A0
02:0003F380 10302000        	 12541:     move.b  (A0,D2.W),D0
02:0003F384 6704            	 12542:     beq.s  __far_z_04_0124
02:0003F386 600000A4        	 12543:     jmp  Ganon_Dying
                            	 12544: __far_z_04_0124:
02:0003F38A 61000356        	 12545:     jsr     Ganon_CheckCollisions
02:0003F38E 6100A65E        	 12546:     jsr     PlayBossHitCryIfNeeded
                            	 12547:     ; Go handle the brown state specially.
                            	 12548:     ;
02:0003F392 41EC00AC        	 12549:     lea     ($00AC,A4),A0
02:0003F396 10302000        	 12550:     move.b  (A0,D2.W),D0
02:0003F39A 6702            	 12551:     beq.s  __far_z_04_0125
02:0003F39C 6058            	 12552:     jmp  Ganon_UpdateBrownState
                            	 12553: __far_z_04_0125:
                            	 12554:     ; State = 0: Blue
                            	 12555:     ;
                            	 12556:     ; If timer = 0, then go move around and shoot.
                            	 12557:     ;
02:0003F39E 10342028        	 12558:     move.b  ($28,A4,D2.W),D0
02:0003F3A2 6602            	 12559:     bne.s  __far_z_04_0126
02:0003F3A4 600E            	 12560:     jmp  Ganon_MoveAndShoot
                            	 12561: __far_z_04_0126:
                            	 12562:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12563:     ; Collisions were checked already.
                            	 12564:     ;
                            	 12565:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12566:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12567:     ;
02:0003F3A6 0C000001        	 12568:     cmpi.b  #$01,D0
02:0003F3AA 6702            	 12569:     beq.s  __far_z_04_0127
02:0003F3AC 6078            	 12570:     jmp  L_Ganon_DrawBody
                            	 12571: __far_z_04_0127:
                            	 12572: ; Description:
                            	 12573: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	 12574: ;
                            	 12575:     even
                            	 12576: Ganon_RandomizeLocation:
02:0003F3AE 4EF90002BA30    	 12577:     jmp     c_ganon_randomize_location
                            	 12578: 
                            	 12579: Ganon_MoveAndShoot:
                            	 12580:     ; Change the animation frame every screen frame; so that
                            	 12581:     ; when Ganon is hit, he appears in a random pose.
                            	 12582:     ;
02:0003F3B4 41EC046B        	 12583:     lea     ($046B,A4),A0
02:0003F3B8 52302000        	 12584:     addq.b  #1,(A0,D2.W)
                            	 12585:     ; The animation cycle has 6 frames.
                            	 12586:     ;
02:0003F3BC 41EC046B        	 12587:     lea     ($046B,A4),A0
