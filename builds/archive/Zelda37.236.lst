                            	  5675: 
                            	  5676:     even
                            	  5677: _L_z07_CheckState30_CheckOtherStates:
                            	  5678:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5679:     ;
                            	  5680:     ; The boomerang will now return. Reset the grid offset.
                            	  5681:     ;
02:0004C588 7000            	  5682:     moveq   #0,D0
02:0004C58A 41EC0394        	  5683:     lea     ($0394,A4),A0
02:0004C58E 11802000        	  5684:     move.b  D0,(A0,D2.W)
                            	  5685:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5686:     ;
02:0004C592 0C02000D        	  5687:     cmpi.b  #$0D,D2
02:0004C596 6408            	  5688:     bcc  _anon_z07_30
02:0004C598 41EC042C        	  5689:     lea     ($042C,A4),A0
02:0004C59C 10302000        	  5690:     move.b  (A0,D2.W),D0
                            	  5691: _anon_z07_30:
02:0004C5A0 4EB900030EAA    	  5692:     jsr     GetDirectionsAndDistancesToTarget
                            	  5693:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5694:     ; then go move towards the thrower, draw, and check collisions.
                            	  5695:     ;
02:0004C5A6 1014            	  5696:     move.b  ($0000,A4),D0
02:0004C5A8 0C000002        	  5697:     cmpi.b  #$02,D0
02:0004C5AC 666A            	  5698:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5699:     ; The boomerang has reached the thrower.
                            	  5700:     ;
                            	  5701:     ; Reset the distance to move.
                            	  5702:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5703:     ;
02:0004C5AE 7000            	  5704:     moveq   #0,D0
02:0004C5B0 41EC0380        	  5705:     lea     ($0380,A4),A0
02:0004C5B4 11802000        	  5706:     move.b  D0,(A0,D2.W)
02:0004C5B8 0C02000D        	  5707:     cmpi.b  #$0D,D2
02:0004C5BC 6524            	  5708:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5709:     ; Link has caught the boomerang.
                            	  5710:     ;
                            	  5711:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5712:     ;
                            	  5713:     ; If Link catches it some time after throwing it,
                            	  5714:     ; his state will become $20, and he will show the catch animation.
                            	  5715:     ;
                            	  5716:     ; But if he catches it right after throwing it, the state becomes
                            	  5717:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5718:     ;
02:0004C5BE 102C00AC        	  5719:     move.b  ($00AC,A4),D0
02:0004C5C2 00000020        	  5720:     ori.b #$20,D0
02:0004C5C6 194000AC        	  5721:     move.b  D0,($00AC,A4)
                            	  5722:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5723:     ; up the new state.
                            	  5724:     ;
02:0004C5CA 7001            	  5725:     moveq   #1,D0
02:0004C5CC 194003D0        	  5726:     move.b  D0,($03D0,A4)
                            	  5727:     ; Deactivate the boomerang.
                            	  5728:     ;
02:0004C5D0 760F            	  5729:     moveq   #15,D3
02:0004C5D2 7000            	  5730:     moveq   #0,D0
02:0004C5D4 41EC00AC        	  5731:     lea     ($00AC,A4),A0
02:0004C5D8 11803000        	  5732:     move.b  D0,(A0,D3.W)
02:0004C5DC 0A3C0001        	  5733:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C5E0 4E75            	  5734:     rts
                            	  5735: 
                            	  5736:     even
                            	  5737: _L_z07_CheckState30_CatchBoomerang:
                            	  5738:     ; A monster caught the boomerang that it threw.
                            	  5739:     ;
                            	  5740:     ; Set a timer for the thrower based on a random value:
                            	  5741:     ; < $30: $30
                            	  5742:     ; < $70: $50
                            	  5743:     ; Else:  $70
                            	  5744:     ;
02:0004C5E2 7630            	  5745:     moveq   #48,D3
02:0004C5E4 10342018        	  5746:     move.b  ($18,A4,D2.W),D0
02:0004C5E8 0C000030        	  5747:     cmpi.b  #$30,D0
02:0004C5EC 650A            	  5748:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004C5EE 7650            	  5749:     moveq   #80,D3
02:0004C5F0 0C000070        	  5750:     cmpi.b  #$70,D0
02:0004C5F4 6502            	  5751:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004C5F6 7670            	  5752:     moveq   #112,D3
                            	  5753:     even
                            	  5754: _L_z07_CheckState30_SetThrowerTimer:
02:0004C5F8 1003            	  5755:     move.b  D3,D0
02:0004C5FA 7600            	  5756:     moveq   #0,D3
02:0004C5FC 41EC042C        	  5757:     lea     ($042C,A4),A0
02:0004C600 16302000        	  5758:     move.b  (A0,D2.W),D3
02:0004C604 19803028        	  5759:     move.b  D0,($28,A4,D3.W)
                            	  5760:     ; Reset the thrower's state to make it idle or restart its state machine.
                            	  5761:     ; Destroy the monster's boomerang.
                            	  5762:     ;
02:0004C608 7000            	  5763:     moveq   #0,D0
02:0004C60A 41EC00AC        	  5764:     lea     ($00AC,A4),A0
02:0004C60E 11803000        	  5765:     move.b  D0,(A0,D3.W)
02:0004C612 4EF90003A07A    	  5766:     jmp     DestroyCountedMonsterShot
                            	  5767: 
                            	  5768:     even
                            	  5769: _L_z07_CheckState30_MoveTowardThrower:
                            	  5770:     ; Move towards the thrower.
                            	  5771:     ;
                            	  5772:     ; Middle speed index 4 goes equally fast in X and Y axes.
                            	  5773:     ;
02:0004C618 7604            	  5774:     moveq   #4,D3
02:0004C61A 4EB900030EF8    	  5775:     jsr     _CalcDiagonalSpeedIndex
                            	  5776:     ; Move vertically towards the thrower.
