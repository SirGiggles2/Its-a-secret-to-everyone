                            	  5151:     ;
02:00036AF6 0C000001        	  5152:     cmpi.b  #$01,D0
02:00036AFA 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00036AFC 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:00036B00 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
