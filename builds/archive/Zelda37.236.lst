                            	  7000: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7001:     ; Bloated timer =>
                            	  7002:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7003:     ; 1:     go advance the substate
                            	  7004:     ; other: go decrement Bloated timer
                            	  7005:     ;
02:0003CADE 7600            	  7006:     moveq   #0,D3
02:0003CAE0 41EC045E        	  7007:     lea     ($045E,A4),A0
02:0003CAE4 16302000        	  7008:     move.b  (A0,D2.W),D3
