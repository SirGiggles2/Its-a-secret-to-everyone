                            	  7435: _anon_z01_99:
                            	  7436:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7437:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7438:     ;
                            	  7439:     ; If instead a monster is defending, then all this calculation
                            	  7440:     ; won't matter, because the shove direction will be set to the
                            	  7441:     ; weapon's direction.
                            	  7442:     ;
                            	  7443:     ; As such, calculate a direction from the monster to the defender,
                            	  7444:     ; assuming it's Link.
                            	  7445:     ;
                            	  7446:     ; Start with an assumption that the direction is vertical:
                            	  7447:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7448:     ;
02:0003251E 7008            	  7449:     moveq   #8,D0
02:00032520 19400008        	  7450:     move.b  D0,($0008,A4)
02:00032524 41EC0084        	  7451:     lea     ($0084,A4),A0
02:00032528 10302000        	  7452:     move.b  (A0,D2.W),D0
02:0003252C 19400004        	  7453:     move.b  D0,($0004,A4)
02:00032530 41EC0084        	  7454:     lea     ($0084,A4),A0
02:00032534 10303000        	  7455:     move.b  (A0,D3.W),D0
02:00032538 19400005        	  7456:     move.b  D0,($0005,A4)
                            	  7457:     ; If the defender is Link and his grid offset <> 0 then
                            	  7458:     ; use his usual object direction variable to determine
                            	  7459:     ; which axis to check.
                            	  7460:     ;
02:0003253C 4A03            	  7461:     cmpi.b  #$00,D3
02:0003253E 6612            	  7462:     bne  _anon_z01_100
02:00032540 102C0394        	  7463:     move.b  ($0394,A4),D0
02:00032544 670C            	  7464:     beq  _anon_z01_100
02:00032546 102C0098        	  7465:     move.b  ($0098,A4),D0
02:0003254A 02000003        	  7466:     andi.b #$03,D0
02:0003254E 660C            	  7467:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032550 6720            	  7468:     beq  _L_z01_BeginShove_CheckVertical
                            	  7469: _anon_z01_100:
                            	  7470:     ; For monsters defending, or Link with grid offset = 0,
                            	  7471:     ; check direction in [0B].
                            	  7472:     ;
                            	  7473:     ; For monsters defending, this won't matter. For Link with grid
                            	  7474:     ; offset = 0, I believe the result will be arbitrary.
                            	  7475:     ;
                            	  7476:     ; TODO:
                            	  7477:     ; Is [0B] always set if Link's grid offset = 0?
