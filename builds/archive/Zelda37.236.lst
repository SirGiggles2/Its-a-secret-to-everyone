02:00041C22 02000008        	  3285:     andi.b #$08,D0
02:00041C26 6602            	  3286:     bne.s  __far_z_05_0058
02:00041C28 60BC            	  3287:     jmp  L14EC6_Exit
                            	  3288: __far_z_05_0058:
                            	  3289:     ; Look for this room's ID in the 6-element cellar room array.
                            	  3290:     ;
02:00041C2A 7606            	  3291:     moveq   #6,D3
02:00041C2C 102C00EB        	  3292:     move.b  ($00EB,A4),D0
02:00041C30 1B00            	  3293:     move.b  D0,-(A5)  ; PHA
                            	  3294: _anon_z05_81:
02:00041C32 5303            	  3295:     subq.b  #1,D3
02:00041C34 41F900FF6BB2    	  3296:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C3A 12303000        	  3297:     move.b  (A0,D3.W),D1
02:00041C3E B001            	  3298:     cmp.b   D1,D0
02:00041C40 66F0            	  3299:     bne  _anon_z05_81
                            	  3300:     ; Determine the destination room ID, and go there.
                            	  3301:     ;
                            	  3302:     ; If Link's X < $80 look in level block attributes A, else B.
