                            	  4868: UpdatePeaceTextbox:
                            	  4869:     ; Only emit a character once every 8 frames --
                            	  4870:     ; when (counter [0412] MOD 8) = 4.
                            	  4871:     ;
02:00036752 522C0412        	  4872:     addq.b  #1,($0412,A4)
02:00036756 102C0412        	  4873:     move.b  ($0412,A4),D0
02:0003675A 02000007        	  4874:     andi.b #$07,D0
02:0003675E 0C000004        	  4875:     cmpi.b  #$04,D0
02:00036762 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4877:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4878:     ; to the dynamic transfer buf.
                            	  4879:     ;
02:00036764 7604            	  4880:     moveq   #4,D3
                            	  4881: _anon_z02_35:
02:00036766 41F9000366E2    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:0003676C 10303000        	  4883:     move.b  (A0,D3.W),D0
02:00036770 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00036774 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:00036778 5303            	  4886:     subq.b  #1,D3
02:0003677A 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:0003677C 7600            	  4891:     moveq   #0,D3
02:0003677E 162C0413        	  4892:     move.b  ($0413,A4),D3
02:00036782 41F90003671C    	  4893:     lea     (PeaceText).l,A0
02:00036788 10303000        	  4894:     move.b  (A0,D3.W),D0
02:0003678C 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:00036790 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00036792 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:00036796 0C000024        	  4901:     cmpi.b  #$24,D0
02:0003679A 6706            	  4902:     beq  _anon_z02_36
02:0003679C 7010            	  4903:     moveq   #16,D0
02:0003679E 19400604        	  4904:     move.b  D0,($0604,A4)
                            	  4905: _anon_z02_36:
                            	  4906:     ; Point to the next character in the string.
                            	  4907:     ;
02:000367A2 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:000367A6 41F9000366E8    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000367AC 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000367B0 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
                            	  4916:     ; increment the high address.
                            	  4917:     ;
02:000367B4 0C0000A0        	  4918:     cmpi.b  #$A0,D0
02:000367B8 6406            	  4919:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:000367BA 7023            	  4920:     moveq   #35,D0
02:000367BC 19400302        	  4921:     move.b  D0,($0302,A4)
