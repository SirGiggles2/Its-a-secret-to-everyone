                            	 12237:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12238:     ;
                            	 12239:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12240:     ; shown.
                            	 12241:     ;
02:0003F172 102C00AE        	 12242:     move.b  ($00AE,A4),D0
02:0003F176 6700008E        	 12243:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12244:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 12245:     ; here to wait to be shown at the top position (N) one at a time.
                            	 12246:     ;
02:0003F17A 1002            	 12247:     move.b  D2,D0
                            	 12248:     ; Subtract 3 from the object slot to get the angle where the
                            	 12249:     ; patra child in object slot 2 should be for the current one to appear.
                            	 12250:     ;
02:0003F17C 003C0011        	 12251:     ori     #$11,CCR  ; SEC: set C+X
02:0003F180 123C0003        	 12252:     move.b  #$03,D1
02:0003F184 0A3C0010        	 12253:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F188 9101            	 12254:     subx.b  D1,D0   ; SBC #$03
02:0003F18A 0A3C0010        	 12255:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F18E 7600            	 12256:     moveq   #0,D3
02:0003F190 1600            	 12257:     move.b  D0,D3
                            	 12258:     ; If the patra child in slot 2 has not reached the required angle,
                            	 12259:     ; then return.
                            	 12260:     ;
02:0003F192 102C0396        	 12261:     move.b  ($0396,A4),D0
02:0003F196 41F90003F150    	 12262:     lea     (PatraChildStartAngles).l,A0
02:0003F19C 12303000        	 12263:     move.b  (A0,D3.W),D1
02:0003F1A0 B001            	 12264:     cmp.b   D1,D0
02:0003F1A2 6662            	 12265:     bne  _L_z04_UpdatePatraChild_Exit
                            	 12266:     even
                            	 12267: _L_z04_UpdatePatraChild_Ready:
                            	 12268:     ; Once the patra child in the last slot (9) reaches here, advance
                            	 12269:     ; the patra parent's state.
