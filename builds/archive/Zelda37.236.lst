                            	  4751: DrawLinkZeldaTriforces:
                            	  4752:     ; The triforce over Link goes in the room object slot $13.
                            	  4753:     ; Set its location $10 pixels above Link.
                            	  4754:     ;
02:00036618 102C0070        	  4755:     move.b  ($0070,A4),D0
02:0003661C 19400083        	  4756:     move.b  D0,($0083,A4)
02:00036620 102C0084        	  4757:     move.b  ($0084,A4),D0
02:00036624 003C0011        	  4758:     ori     #$11,CCR  ; SEC: set C+X
02:00036628 123C0010        	  4759:     move.b  #$10,D1
02:0003662C 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036630 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:00036632 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
