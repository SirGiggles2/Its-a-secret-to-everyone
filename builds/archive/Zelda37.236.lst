                            	  1720:     ;
02:00041096 7005            	  1721:     moveq   #5,D0
02:00041098 761F            	  1722:     moveq   #31,D3
02:0004109A 4EB90004A9F6    	  1723:     jsr     ClearRam0300UpTo
                            	  1724:     ; Reset door trigger info.
                            	  1725:     ;
02:000410A0 7000            	  1726:     moveq   #0,D0
02:000410A2 19400054        	  1727:     move.b  D0,($0054,A4)
02:000410A6 19400055        	  1728:     move.b  D0,($0055,A4)
                            	  1729:     ; Store level block attribute byte F for convenience.
                            	  1730:     ;
02:000410AA 7600            	  1731:     moveq   #0,D3
02:000410AC 162C00EB        	  1732:     move.b  ($00EB,A4),D3
02:000410B0 41F900FF6AFE    	  1733:     lea     (NES_SRAM+$0AFE).l,A0
