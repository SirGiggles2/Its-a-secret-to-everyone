02:0003ACE2 16342019        	  2888:     move.b  ($19,A4,D2.W),D3
02:0003ACE6 0C0300A0        	  2889:     cmpi.b  #$A0,D3
02:0003ACEA 6504            	  2890:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2891:     ; t := t AND $F
                            	  2892:     ;
02:0003ACEC 0200000F        	  2893:     andi.b #$0F,D0
