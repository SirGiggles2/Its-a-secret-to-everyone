02:00043794 182C0003        	  5683:     move.b  ($03,A4),D4  ; ptr hi
02:00043798 024100FF        	  5684:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004379C E14C            	  5685:     lsl.w   #8,D4
02:0004379E 8841            	  5686:     or.w    D1,D4             ; D4 = NES ptr addr
02:000437A0 48C4            	  5687:     ext.l   D4
02:000437A2 D8BC00FF0000    	  5688:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000437A8 2044            	  5689:     movea.l D4,A0
02:000437AA 10303000        	  5690:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000437AE 1214            	  5691:     move.b  ($00,A4),D1   ; ptr lo
02:000437B0 182C0001        	  5692:     move.b  ($01,A4),D4  ; ptr hi
02:000437B4 024100FF        	  5693:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000437B8 E14C            	  5694:     lsl.w   #8,D4
02:000437BA 8841            	  5695:     or.w    D1,D4
02:000437BC 48C4            	  5696:     ext.l   D4
02:000437BE D8BC00FF0000    	  5697:     add.l   #NES_RAM,D4
02:000437C4 2044            	  5698:     movea.l D4,A0
02:000437C6 11803000        	  5699:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000437CA 4EB9000312AE    	  5700:     jsr     Add1ToInt16At2
