                            	  7059: __far_z_04_0060:
                            	  7060:     ; New bloated substate >= 2.
                            	  7061:     ;
                            	  7062:     ; If bomb hits < 2, then set bloated substate 4,
                            	  7063:     ; which will transition to state 0 (moving).
                            	  7064:     ;
                            	  7065:     ; Note that if the bomb hits >= 2, then:
                            	  7066:     ; - If new substate = 2, then substate 2 will wait,
                            	  7067:     ;   and then transition to substate 3.
                            	  7068:     ; - If new substate = 3, then the next frame the monster will die.
                            	  7069:     ;
02:0003CB54 7600            	  7070:     moveq   #0,D3
02:0003CB56 41EC0437        	  7071:     lea     ($0437,A4),A0
02:0003CB5A 16302000        	  7072:     move.b  (A0,D2.W),D3
02:0003CB5E 0C030002        	  7073:     cmpi.b  #$02,D3
02:0003CB62 6502            	  7074:     bcs.s  __far_z_04_0061
02:0003CB64 600A            	  7075:     jmp  L_Dodongo_DecrementBloatedTimer
