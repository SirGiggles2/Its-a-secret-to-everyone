02:0003C47A 41EC0478        	  6202:     lea     ($0478,A4),A0
02:0003C47E 16302000        	  6203:     move.b  (A0,D2.W),D3
                            	  6204:     ; Change the coordinates to one corner.
                            	  6205:     ;
02:0003C482 10342070        	  6206:     move.b  ($70,A4,D2.W),D0
02:0003C486 023C00EE        	  6207:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C48A 41F90003C33E    	  6208:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C490 12303000        	  6209:     move.b  (A0,D3.W),D1
02:0003C494 D101            	  6210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C496 19802070        	  6211:     move.b  D0,($70,A4,D2.W)
02:0003C49A 41EC0084        	  6212:     lea     ($0084,A4),A0
02:0003C49E 10302000        	  6213:     move.b  (A0,D2.W),D0
02:0003C4A2 023C00EE        	  6214:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C4A6 41F90003C342    	  6215:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C4AC 12303000        	  6216:     move.b  (A0,D3.W),D1
02:0003C4B0 D101            	  6217:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C4B2 41EC0084        	  6218:     lea     ($0084,A4),A0
02:0003C4B6 11802000        	  6219:     move.b  D0,(A0,D2.W)
                            	  6220:     ; Check the room boundary and object collisions in this temporary location.
                            	  6221:     ;
02:0003C4BA 610037FA        	  6222:     jsr     BoundFlyer
02:0003C4BE 4EB900031D24    	  6223:     jsr     CheckMonsterCollisions
                            	  6224:     ; Increase the loop index, and loop again until it = 4.
