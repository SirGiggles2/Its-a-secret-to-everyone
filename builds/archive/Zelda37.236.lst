                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:00034FAE 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:00034FB2 020000C0        	  2577:     andi.b #$C0,D0
02:00034FB6 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:00034FBA 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034FBE 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:00034FC2 7620            	  2586:     moveq   #32,D3
02:00034FC4 19430604        	  2587:     move.b  D3,($0604,A4)
02:00034FC8 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00034FCA 41EC0422        	  2591:     lea     ($0422,A4),A0
02:00034FCE 10303000        	  2592:     move.b  (A0,D3.W),D0
02:00034FD2 41EC0302        	  2593:     lea     ($0302,A4),A0
02:00034FD6 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:00034FDA 5303            	  2595:     subq.b  #1,D3
02:00034FDC 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034FDE 19430306        	  2597:     move.b  D3,($0306,A4)
02:00034FE2 7400            	  2598:     moveq   #0,D2
02:00034FE4 142C0421        	  2599:     move.b  ($0421,A4),D2
02:00034FE8 7600            	  2600:     moveq   #0,D3
02:00034FEA 162C041F        	  2601:     move.b  ($041F,A4),D3
02:00034FEE 41F900034928    	  2602:     lea     (ModeE_CharMap).l,A0
02:00034FF4 10303000        	  2603:     move.b  (A0,D3.W),D0
02:00034FF8 19400305        	  2604:     move.b  D0,($0305,A4)
02:00034FFC 41EC0638        	  2605:     lea     ($0638,A4),A0
