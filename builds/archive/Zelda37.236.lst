02:000410BA 194004CD        	  1735:     move.b  D0,($04CD,A4)
02:000410BE 610039C4        	  1736:     jsr     ResetInvObjState
                            	  1737:     ; There's more than one way to enter a room.
                            	  1738:     ;
                            	  1739:     ; 1: Out of a cave, dungeon, or cellar
                            	  1740:     ;     a. Walking exit
                            	  1741:     ;     b. Next to stairs
                            	  1742:     ; 2: Room to room
                            	  1743:     ;
                            	  1744:     ; Determine which one we need.
                            	  1745:     ;
02:000410C2 102C005A        	  1746:     move.b  ($005A,A4),D0
02:000410C6 6770            	  1747:     beq  _L_z05_InitMode_EnterRoom_Method2
02:000410C8 102C0010        	  1748:     move.b  ($0010,A4),D0
02:000410CC 665C            	  1749:     bne  _anon_z05_42
                            	  1750:     ; Enter method 1.
                            	  1751:     ;
                            	  1752:     ; Set up Link's exit from underground.
                            	  1753:     ;
02:000410CE 7600            	  1754:     moveq   #0,D3
02:000410D0 162C00EB        	  1755:     move.b  ($00EB,A4),D3
02:000410D4 41F900FF687E    	  1756:     lea     (NES_SRAM+$087E).l,A0
02:000410DA 10303000        	  1757:     move.b  (A0,D3.W),D0
02:000410DE 020000F0        	  1758:     andi.b #$F0,D0
02:000410E2 19400070        	  1759:     move.b  D0,($0070,A4)
02:000410E6 41F900FF6AFE    	  1760:     lea     (NES_SRAM+$0AFE).l,A0
02:000410EC 10303000        	  1761:     move.b  (A0,D3.W),D0
02:000410F0 02000007        	  1762:     andi.b #$07,D0
02:000410F4 E308            	  1763:     lsl.b  #1,D0   ; ASL A
02:000410F6 E308            	  1764:     lsl.b  #1,D0   ; ASL A
02:000410F8 E308            	  1765:     lsl.b  #1,D0   ; ASL A
02:000410FA E308            	  1766:     lsl.b  #1,D0   ; ASL A
                            	  1767:     ; Add the first Y where Link can come out of underground.
                            	  1768:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:000410FC 123C004D        	  1769:     move.b  #$4D,D1
02:00041100 D101            	  1770:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00041102 19400084        	  1771:     move.b  D0,($0084,A4)
                            	  1772:     ; If the player didn't step on a cave entrance to go underground,
                            	  1773:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1774:     ;
02:00041106 7600            	  1775:     moveq   #0,D3
02:00041108 162C0065        	  1776:     move.b  ($0065,A4),D3
02:0004110C 0C030024        	  1777:     cmpi.b  #$24,D3
02:00041110 6618            	  1778:     bne  _anon_z05_42
                            	  1779:     ; Enter method 1-a.
                            	  1780:     ;
                            	  1781:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1782:     ;
02:00041112 19400412        	  1783:     move.b  D0,($0412,A4)
02:00041116 023C00EE        	  1784:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004111A 123C0010        	  1785:     move.b  #$10,D1
02:0004111E D101            	  1786:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:00041120 19400084        	  1787:     move.b  D0,($0084,A4)
02:00041124 7008            	  1788:     moveq   #8,D0
02:00041126 19400603        	  1789:     move.b  D0,($0603,A4)
                            	  1790: _anon_z05_42:
                            	  1791:     ; This part is the same no matter if the player went
                            	  1792:     ; underground by stairs or a cave entrance.
                            	  1793:     ;
02:0004112A 7004            	  1794:     moveq   #4,D0
02:0004112C 19400098        	  1795:     move.b  D0,($0098,A4)
02:00041130 7000            	  1796:     moveq   #0,D0
02:00041132 19400053        	  1797:     move.b  D0,($0053,A4)
