02:00031F40 102C0098        	  6479:     move.b  ($0098,A4),D0
02:00031F44 41EC0098        	  6480:     lea     ($0098,A4),A0
02:00031F48 12302000        	  6481:     move.b  (A0,D2.W),D1
02:00031F4C 8001            	  6482:     or.b  D1,D0
02:00031F4E 0200000C        	  6483:     andi.b #$0C,D0
02:00031F52 0C00000C        	  6484:     cmpi.b  #$0C,D0
02:00031F56 671A            	  6485:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031F58 102C0098        	  6486:     move.b  ($0098,A4),D0
02:00031F5C 41EC0098        	  6487:     lea     ($0098,A4),A0
02:00031F60 12302000        	  6488:     move.b  (A0,D2.W),D1
02:00031F64 8001            	  6489:     or.b  D1,D0
02:00031F66 02000003        	  6490:     andi.b #$03,D0
02:00031F6A 0C000003        	  6491:     cmpi.b  #$03,D0
02:00031F6E 6702            	  6492:     beq.s  __far_z_01_0065
02:00031F70 602A            	  6493:     jmp  HarmLink
