                            	  2758: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2759:     ; State 1. Jumping.
                            	  2760:     ;
                            	  2761:     ; Keep the object inside the bounds of the room.
                            	  2762:     ;
02:0003ABE0 610050D4        	  2763:     jsr     BoundFlyer
                            	  2764:     ; If the object was blocked at the room boundary, then
                            	  2765:     ; increase boundary reversal count, and go set up another jump.
