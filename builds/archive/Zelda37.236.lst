                            	   243: InitCaveContinue:
                            	   244:     ; Get this cave's index (object type - $6A).
                            	   245:     ;
02:0002E2A2 102C0350        	   246:     move.b  ($0350,A4),D0
02:0002E2A6 003C0011        	   247:     ori     #$11,CCR  ; SEC: set C+X
02:0002E2AA 123C006A        	   248:     move.b  #$6A,D1
02:0002E2AE 0A3C0010        	   249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E2B2 9101            	   250:     subx.b  D1,D0   ; SBC #$6A
02:0002E2B4 0A3C0010        	   251:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E2B8 7600            	   252:     moveq   #0,D3
02:0002E2BA 1600            	   253:     move.b  D0,D3
                            	   254:     ; Get the person text selector by looking up the text selector byte
                            	   255:     ; for this index, and masking it with $3F.
                            	   256:     ;
02:0002E2BC 41F90002E23A    	   257:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E2C2 10303000        	   258:     move.b  (A0,D3.W),D0
02:0002E2C6 1B00            	   259:     move.b  D0,-(A5)  ; PHA
02:0002E2C8 0200003F        	   260:     andi.b #$3F,D0
02:0002E2CC 19400415        	   261:     move.b  D0,($0415,A4)
                            	   262:     ; Pop and mask the text selector byte with $C0 to get the
                            	   263:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   264:     ;
02:0002E2D0 101D            	   265:     move.b  (A5)+,D0  ; PLA
02:0002E2D2 020000C0        	   266:     andi.b #$C0,D0
02:0002E2D6 19400003        	   267:     move.b  D0,($0003,A4)
                            	   268:     ; At this point, the Y register still has the cave index.
                            	   269:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   270:     ;
02:0002E2DA 103C00FD        	   271:     move.b  #$FD,D0
                            	   272: _anon_z01_0:
02:0002E2DE 023C00EE        	   273:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E2E2 123C0003        	   274:     move.b  #$03,D1
02:0002E2E6 D101            	   275:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E2E8 5303            	   276:     subq.b  #1,D3
02:0002E2EA 6AF2            	   277:     bpl  _anon_z01_0
02:0002E2EC 7600            	   278:     moveq   #0,D3
02:0002E2EE 1600            	   279:     move.b  D0,D3
