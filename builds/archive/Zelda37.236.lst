                            	  2415: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2416:     ; Set the count byte in each record to $82:
                            	  2417:     ; 2 tiles arranged vertically
                            	  2418:     ;
02:0004AF14 103C0082        	  2419:     move.b  #$82,D0
02:0004AF18 41EC0304        	  2420:     lea     ($0304,A4),A0
02:0004AF1C 11802000        	  2421:     move.b  D0,(A0,D2.W)
