                            	  2196: ; Params:
                            	  2197: ; A: Y coordinate
                            	  2198: ; X: object index
                            	  2199: ;
                            	  2200:     even
                            	  2201: InitWhirlwind:
02:0003009E 6000BBAA        	  2202:     jmp     c_init_whirlwind
                            	  2203: 
                            	  2204: SetUpWhirlwind:
02:000300A2 6000B956        	  2205:     jmp     c_set_up_whirlwind
                            	  2206: 
                            	  2207: WhirlwindPrevRoomIdList:
02:000300A6 36              	  2208:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:000300A7 3B
02:000300A8 73
02:000300A9 44
02:000300AA 0A
02:000300AB 21
02:000300AC 41
02:000300AD 6C
                            	  2209: 
                            	  2210:     even
                            	  2211: UpdateWhirlwind_Full:
                            	  2212:     ; Get Link's halted state.
                            	  2213:     ;
02:000300AE 102C00AC        	  2214:     move.b  ($00AC,A4),D0
02:000300B2 02000040        	  2215:     andi.b #$40,D0
02:000300B6 7600            	  2216:     moveq   #0,D3
02:000300B8 1600            	  2217:     move.b  D0,D3
                            	  2218:     ; Add 2 to whirlwind X.
                            	  2219:     ;
02:000300BA 7002            	  2220:     moveq   #2,D0
02:000300BC 023C00EE        	  2221:     andi    #$EE,CCR  ; CLC: clear C+X
02:000300C0 12342070        	  2222:     move.b  ($70,A4,D2.W),D1
02:000300C4 D101            	  2223:     addx.b  D1,D0   ; ADC ObjX,X
02:000300C6 19802070        	  2224:     move.b  D0,($70,A4,D2.W)
                            	  2225:     ; If Link is not halted or teleporting state = 0, then
                            	  2226:     ; go check for collision with Link.
                            	  2227:     ;
02:000300CA 0C030040        	  2228:     cmpi.b  #$40,D3
02:000300CE 6638            	  2229:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:000300D0 7600            	  2230:     moveq   #0,D3
02:000300D2 162C0522        	  2231:     move.b  ($0522,A4),D3
02:000300D6 6730            	  2232:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2233:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2234:     ;
                            	  2235:     ; Set Link's X to whirlwind's.
                            	  2236:     ;
02:000300D8 19400070        	  2237:     move.b  D0,($0070,A4)
                            	  2238:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2239:     ; the right screen edge and draw.
                            	  2240:     ;
02:000300DC 5303            	  2241:     subq.b  #1,D3
02:000300DE 6776            	  2242:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:000300E0 0C000080        	  2243:     cmpi.b  #$80,D0
02:000300E4 6670            	  2244:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2245:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2246:     ;
                            	  2247:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2248:     ;
02:000300E6 E308            	  2249:     lsl.b  #1,D0   ; ASL A
02:000300E8 194000AC        	  2250:     move.b  D0,($00AC,A4)
02:000300EC 19400522        	  2251:     move.b  D0,($0522,A4)
02:000300F0 41EC034F        	  2252:     lea     ($034F,A4),A0
02:000300F4 11802000        	  2253:     move.b  D0,(A0,D2.W)
                            	  2254:     ; Update the player position marker, and draw one last time.
                            	  2255:     ;
02:000300F8 1002            	  2256:     move.b  D2,D0
02:000300FA 1B00            	  2257:     move.b  D0,-(A5)  ; PHA
02:000300FC 61001096        	  2258:     jsr     UpdatePlayerPositionMarker
02:00030100 101D            	  2259:     move.b  (A5)+,D0  ; PLA
02:00030102 7400            	  2260:     moveq   #0,D2
02:00030104 1400            	  2261:     move.b  D0,D2
02:00030106 6070            	  2262:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2263: 
                            	  2264:     even
                            	  2265: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2266:     ; Link is not halted or teleporting state = 0.
                            	  2267:     ; Try to pick up Link.
                            	  2268:     ;
                            	  2269:     ; If the whirlwind does not collide with Link, then go check
                            	  2270:     ; for the screen's right edge.
                            	  2271:     ;
02:00030108 61001D64        	  2272:     jsr     CheckLinkCollision
02:0003010C 102C0006        	  2273:     move.b  ($0006,A4),D0
02:00030110 6744            	  2274:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2275:     ; Collided with Link.
                            	  2276:     ;
                            	  2277:     ; Make Link face right. Reset shove info and subroom type.
                            	  2278:     ;
02:00030112 7001            	  2279:     moveq   #1,D0
02:00030114 19400098        	  2280:     move.b  D0,($0098,A4)
02:00030118 E208            	  2281:     lsr.b  #1,D0   ; LSR A
02:0003011A 194000C0        	  2282:     move.b  D0,($00C0,A4)
02:0003011E 194000D3        	  2283:     move.b  D0,($00D3,A4)
02:00030122 1940005A        	  2284:     move.b  D0,($005A,A4)
                            	  2285:     ; Halt Link (state $40), and hide him.
                            	  2286:     ;
02:00030126 7040            	  2287:     moveq   #64,D0
02:00030128 194000AC        	  2288:     move.b  D0,($00AC,A4)
02:0003012C 103C00F8        	  2289:     move.b  #$F8,D0
02:00030130 19400248        	  2290:     move.b  D0,($0248,A4)
02:00030134 1940024C        	  2291:     move.b  D0,($024C,A4)
                            	  2292:     ; Find and set the room that will behave as the previous room
                            	  2293:     ; when scrolling right to the room with the level's entrance.
                            	  2294:     ;
02:00030138 102C0523        	  2295:     move.b  ($0523,A4),D0
02:0003013C 02000007        	  2296:     andi.b #$07,D0
02:00030140 7600            	  2297:     moveq   #0,D3
02:00030142 1600            	  2298:     move.b  D0,D3
02:00030144 41F9000300A6    	  2299:     lea     (WhirlwindPrevRoomIdList).l,A0
02:0003014A 10303000        	  2300:     move.b  (A0,D3.W),D0
02:0003014E 194000EA        	  2301:     move.b  D0,($00EA,A4)
                            	  2302:     ; Set teleporting state 1.
                            	  2303:     ;
02:00030152 522C0522        	  2304:     addq.b  #1,($0522,A4)
                            	  2305:     even
                            	  2306: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2307:     ; If whirlwind's X < $F0, go draw.
                            	  2308:     ;
02:00030156 10342070        	  2309:     move.b  ($70,A4,D2.W),D0
02:0003015A 0C0000F0        	  2310:     cmpi.b  #$F0,D0
02:0003015E 6518            	  2311:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2312:     ; The whirlwind has reached the right edge of the screen.
                            	  2313:     ;
                            	  2314:     ; Destroy the object.
                            	  2315:     ;
02:00030160 611A            	  2316:     jsr     DestroyWhirlwind
                            	  2317:     ; If teleporting state <> 0, we picked up Link.
                            	  2318:     ; So, go to the next mode.
                            	  2319:     ;
                            	  2320:     ; Either way, draw one last time.
                            	  2321:     ;
02:00030162 102C0522        	  2322:     move.b  ($0522,A4),D0
02:00030166 6710            	  2323:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:00030168 1002            	  2324:     move.b  D2,D0
02:0003016A 1B00            	  2325:     move.b  D0,-(A5)  ; PHA
02:0003016C 4EB90004BCA2    	  2326:     jsr     GoToNextModeFromPlay
02:00030172 101D            	  2327:     move.b  (A5)+,D0  ; PLA
02:00030174 7400            	  2328:     moveq   #0,D2
02:00030176 1400            	  2329:     move.b  D0,D2
                            	  2330:     even
                            	  2331: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030178 600000A8        	  2332:     jmp     DrawWhirlwind
                            	  2333: 
                            	  2334:     even
                            	  2335: DestroyWhirlwind:
02:0003017C 6000B696        	  2336:     jmp     c_destroy_whirlwind
                            	  2337: 
                            	  2338: SummonWhirlwind:
                            	  2339:     ; If not in mode 5, return.
                            	  2340:     ;
02:00030180 102C0012        	  2341:     move.b  ($0012,A4),D0
02:00030184 0C000005        	  2342:     cmpi.b  #$05,D0
02:00030188 6704            	  2343:     beq.s  __far_z_01_0012
02:0003018A 60000094        	  2344:     jmp  L6104_Exit
                            	  2345: __far_z_01_0012:
                            	  2346:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2347:     ;
02:0003018E 6178            	  2348:     jsr     AdvanceTeleportingLevelIndex
02:00030190 102C0523        	  2349:     move.b  ($0523,A4),D0
02:00030194 02000007        	  2350:     andi.b #$07,D0
02:00030198 7600            	  2351:     moveq   #0,D3
02:0003019A 1600            	  2352:     move.b  D0,D3
02:0003019C 41F90004AB94    	  2353:     lea     (LevelMasks).l,A0
02:000301A2 10303000        	  2354:     move.b  (A0,D3.W),D0
02:000301A6 1880            	  2355:     move.b  D0,($0000,A4)
                            	  2356:     even
                            	  2357: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2358:     ; If there are no triforce pieces, then return.
                            	  2359:     ;
02:000301A8 102C0671        	  2360:     move.b  ($0671,A4),D0
02:000301AC 6602            	  2361:     bne.s  __far_z_01_0013
02:000301AE 6070            	  2362:     jmp  L6104_Exit
                            	  2363: __far_z_01_0013:
                            	  2364:     ; If we have gotten this triforce piece, then go try to make a
                            	  2365:     ; whirlwind.
                            	  2366:     ;
02:000301B0 1214            	  2367:     move.b  ($0000,A4),D1
02:000301B2 C200            	  2368:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000301B4 662C            	  2369:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2370:     ; We have not gotten this piece.
                            	  2371:     ; First, advance the teleporting index again.
                            	  2372:     ;
02:000301B6 6150            	  2373:     jsr     AdvanceTeleportingLevelIndex
                            	  2374:     ; If the direction Link is facing is an increasing one, then
                            	  2375:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2376:     ; level number. Then go test this new mask.
                            	  2377:     ;
02:000301B8 102C0098        	  2378:     move.b  ($0098,A4),D0
02:000301BC 02000009        	  2379:     andi.b #$09,D0
02:000301C0 6710            	  2380:     beq  _L_z01_SummonWhirlwind_DecreasingDir
