                            	  7182: Dodongo_CheckBombHit:
                            	  7183:     ; If state <> 0 (not moving), then return.
                            	  7184:     ;
02:0003CC2C 41EC00AC        	  7185:     lea     ($00AC,A4),A0
02:0003CC30 10302000        	  7186:     move.b  (A0,D2.W),D0
02:0003CC34 66000086        	  7187:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7188:     ; If facing vertically, then store (X + 8) in [00].
                            	  7189:     ; Else store (X + $10).
                            	  7190:     ;
02:0003CC38 10342070        	  7191:     move.b  ($70,A4,D2.W),D0
02:0003CC3C 023C00EE        	  7192:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC40 123C0008        	  7193:     move.b  #$08,D1
02:0003CC44 D101            	  7194:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CC46 7600            	  7195:     moveq   #0,D3
02:0003CC48 41EC0098        	  7196:     lea     ($0098,A4),A0
02:0003CC4C 16302000        	  7197:     move.b  (A0,D2.W),D3
