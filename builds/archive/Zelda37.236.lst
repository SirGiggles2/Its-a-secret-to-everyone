02:00036AE0 761F            	  5138:     moveq   #31,D3
02:00036AE2 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
02:00036AE4 41EC0305        	  5141:     lea     ($0305,A4),A0
02:00036AE8 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:00036AEC 5303            	  5143:     subq.b  #1,D3
02:00036AEE 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
                            	  5146:     ;
02:00036AF0 102C050A        	  5147:     move.b  ($050A,A4),D0
02:00036AF4 672C            	  5148:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5149:     ; Rows 1 and $2E get horizontal wall tiles.
