02:0003C9FA 41F900031970    	  6893:     lea     (SpriteOffsets).l,A0
02:0003CA00 10303000        	  6894:     move.b  (A0,D3.W),D0
02:0003CA04 7600            	  6895:     moveq   #0,D3
02:0003CA06 1600            	  6896:     move.b  D0,D3
02:0003CA08 101D            	  6897:     move.b  (A5)+,D0  ; PLA
02:0003CA0A 41EC0201        	  6898:     lea     ($0201,A4),A0
02:0003CA0E 11803000        	  6899:     move.b  D0,(A0,D3.W)
02:0003CA12 1014            	  6900:     move.b  ($0000,A4),D0
