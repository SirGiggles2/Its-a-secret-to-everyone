02:00041C6E 1600            	  3326:     move.b  D0,D3
02:00041C70 41F900FF697E    	  3327:     lea     (NES_SRAM+$097E).l,A0
02:00041C76 10303000        	  3328:     move.b  (A0,D3.W),D0
02:00041C7A 1B00            	  3329:     move.b  D0,-(A5)  ; PHA
