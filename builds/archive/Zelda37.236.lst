02:0003DE6A 19410002        	  9671:     move.b  D1,($0002,A4)
02:0003DE6E 122C0002        	  9672:     move.b  ($0002,A4),D1
02:0003DE72 C200            	  9673:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE74 671E            	  9674:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DE76 41EC0084        	  9675:     lea     ($0084,A4),A0
02:0003DE7A 10302000        	  9676:     move.b  (A0,D2.W),D0
02:0003DE7E 122C0003        	  9677:     move.b  ($0003,A4),D1
02:0003DE82 0A3C0010        	  9678:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DE86 9101            	  9679:     subx.b  D1,D0   ; SBC $03
02:0003DE88 0A3C0010        	  9680:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DE8C 41EC0084        	  9681:     lea     ($0084,A4),A0
02:0003DE90 11802000        	  9682:     move.b  D0,(A0,D2.W)
                            	  9683:     even
                            	  9684: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9685:     ; To the frame accumulator, add:
                            	  9686:     ; - a random value between 0 and 3
                            	  9687:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9688:     ;
02:0003DE94 10342019        	  9689:     move.b  ($19,A4,D2.W),D0
02:0003DE98 02000003        	  9690:     andi.b #$03,D0
02:0003DE9C 023C00EE        	  9691:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DEA0 122C0003        	  9692:     move.b  ($0003,A4),D1
02:0003DEA4 D101            	  9693:     addx.b  D1,D0   ; ADC $03
02:0003DEA6 41EC0451        	  9694:     lea     ($0451,A4),A0
02:0003DEAA 12302000        	  9695:     move.b  (A0,D2.W),D1
02:0003DEAE D101            	  9696:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DEB0 41EC0451        	  9697:     lea     ($0451,A4),A0
02:0003DEB4 11802000        	  9698:     move.b  D0,(A0,D2.W)
