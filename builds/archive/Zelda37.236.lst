                            	  7365: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D284 7400            	  7366:     moveq   #0,D2
02:0004D286 142C0340        	  7367:     move.b  ($0340,A4),D2
                            	  7368:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7369:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7370:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7371:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7372:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7373:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7374:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7375:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7376:     ; corrupting them and causing a deterministic address-error
                            	  7377:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7378:     ; identified by Codex static review.)
                            	  7379: _L_z07_P47_pre_check:
02:0004D28A 102C0525        	  7380:     move.b  ($0525,A4),D0
02:0004D28E 020000F0        	  7381:     andi.b  #$F0,D0
02:0004D292 0C000040        	  7382:     cmpi.b  #$40,D0
02:0004D296 6506            	  7383:     blo     _L_z07_P47_pre_snap
02:0004D298 0C0000E0        	  7384:     cmpi.b  #$E0,D0
02:0004D29C 6506            	  7385:     blo     _L_z07_P47_pre_ok
                            	  7386: _L_z07_P47_pre_snap:
02:0004D29E 197C00480525    	  7387:     move.b  #$48,($0525,A4)
                            	  7388: _L_z07_P47_pre_ok:
02:0004D2A4 7005            	  7389:     moveq   #5,D0
02:0004D2A6 61000500        	  7390:     jsr     SwitchBank
02:0004D2AA 4EB900041EBA    	  7391:     jsr     FindNextEdgeSpawnCell
                            	  7392:     ; Post-walk 1: bottom-edge snap.
02:0004D2B0 102C0525        	  7393:     move.b  ($0525,A4),D0
02:0004D2B4 020000F0        	  7394:     andi.b  #$F0,D0
02:0004D2B8 0C0000E0        	  7395:     cmpi.b  #$E0,D0
02:0004D2BC 660C            	  7396:     bne     _L_z07_P47_post1_ok
02:0004D2BE 197C00480525    	  7397:     move.b  #$48,($0525,A4)
02:0004D2C4 4EB900041EBA    	  7398:     jsr     FindNextEdgeSpawnCell
                            	  7399: _L_z07_P47_post1_ok:
                            	  7400:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7401:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D2CA 7600            	  7402:     moveq   #0,D3
02:0004D2CC 162C0525        	  7403:     move.b  ($0525,A4),D3
02:0004D2D0 0243000F        	  7404:     andi.w  #$000F,D3
02:0004D2D4 C6FC002C        	  7405:     mulu.w  #44,D3
02:0004D2D8 203C00FF6530    	  7406:     move.l  #$FF6530,D0
02:0004D2DE D083            	  7407:     add.l   D3,D0
02:0004D2E0 7600            	  7408:     moveq   #0,D3
02:0004D2E2 162C0525        	  7409:     move.b  ($0525,A4),D3
02:0004D2E6 E84B            	  7410:     lsr.w   #4,D3
02:0004D2E8 5943            	  7411:     subi.w  #4,D3
02:0004D2EA E34B            	  7412:     lsl.w   #1,D3
02:0004D2EC D083            	  7413:     add.l   D3,D0
02:0004D2EE 2040            	  7414:     movea.l D0,A0
02:0004D2F0 1010            	  7415:     move.b  (A0),D0
02:0004D2F2 0C000084        	  7416:     cmpi.b  #$84,D0
02:0004D2F6 6544            	  7417:     blo     _L_z07_P47_post2_ok
                            	  7418:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7419:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7420:     ; writes to the $05xx region.
02:0004D2F8 7800            	  7421:     moveq   #0,D4
                            	  7422: _L_z07_P47_fb_loop:
02:0004D2FA 41FAE46C        	  7423:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D2FE 12304000        	  7424:     move.b  (A0,D4.W),D1
02:0004D302 19410525        	  7425:     move.b  D1,($0525,A4)
                            	  7426:     ; Validate fallback cell walkable.
02:0004D306 7600            	  7427:     moveq   #0,D3
02:0004D308 1601            	  7428:     move.b  D1,D3
02:0004D30A 0243000F        	  7429:     andi.w  #$000F,D3
02:0004D30E C6FC002C        	  7430:     mulu.w  #44,D3
02:0004D312 203C00FF6530    	  7431:     move.l  #$FF6530,D0
02:0004D318 D083            	  7432:     add.l   D3,D0
02:0004D31A 7600            	  7433:     moveq   #0,D3
02:0004D31C 1601            	  7434:     move.b  D1,D3
02:0004D31E E84B            	  7435:     lsr.w   #4,D3
02:0004D320 5943            	  7436:     subi.w  #4,D3
02:0004D322 E34B            	  7437:     lsl.w   #1,D3
02:0004D324 D083            	  7438:     add.l   D3,D0
02:0004D326 2040            	  7439:     movea.l D0,A0
02:0004D328 0C100084        	  7440:     cmpi.b  #$84,(A0)
02:0004D32C 650E            	  7441:     blo     _L_z07_P47_post2_ok
02:0004D32E 5204            	  7442:     addq.b  #1,D4
02:0004D330 0C040008        	  7443:     cmpi.b  #8,D4
02:0004D334 65C4            	  7444:     blo     _L_z07_P47_fb_loop
                            	  7445:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7446:     ; rather than looping).
02:0004D336 197C00480525    	  7447:     move.b  #$48,($0525,A4)
                            	  7448: _L_z07_P47_post2_ok:
                            	  7449:     ; Extract and set the monster's location.
                            	  7450:     ;
02:0004D33C 102C0525        	  7451:     move.b  ($0525,A4),D0
                            	  7452:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7453:     ;
02:0004D340 1B00            	  7454:     move.b  D0,-(A5)  ; PHA
02:0004D342 E308            	  7455:     lsl.b  #1,D0   ; ASL A
02:0004D344 E308            	  7456:     lsl.b  #1,D0   ; ASL A
02:0004D346 E308            	  7457:     lsl.b  #1,D0   ; ASL A
02:0004D348 E308            	  7458:     lsl.b  #1,D0   ; ASL A
02:0004D34A 19802070        	  7459:     move.b  D0,($70,A4,D2.W)
                            	  7460:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7461:     ;
02:0004D34E 101D            	  7462:     move.b  (A5)+,D0  ; PLA
02:0004D350 020000F0        	  7463:     andi.b #$F0,D0
02:0004D354 003C0011        	  7464:     ori     #$11,CCR  ; SEC: set C+X
02:0004D358 123C0003        	  7465:     move.b  #$03,D1
02:0004D35C 0A3C0010        	  7466:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D360 9101            	  7467:     subx.b  D1,D0   ; SBC #$03
02:0004D362 0A3C0010        	  7468:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D366 41EC0084        	  7469:     lea     ($0084,A4),A0
02:0004D36A 11802000        	  7470:     move.b  D0,(A0,D2.W)
                            	  7471:     ; Set the monsters-from-edges long timer to a random value
                            	  7472:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7473:     ;
02:0004D36E 10342019        	  7474:     move.b  ($19,A4,D2.W),D0
02:0004D372 02000003        	  7475:     andi.b #$03,D0
02:0004D376 023C00EE        	  7476:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004D37A 123C0002        	  7477:     move.b  #$02,D1
02:0004D37E D101            	  7478:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004D380 1940004B        	  7479:     move.b  D0,($004B,A4)
                            	  7480:     ; If the distance to Link is too close to Link, then
                            	  7481:     ; go flag the monster uninitialized again, so we can
                            	  7482:     ; try to spawn it again next time.
