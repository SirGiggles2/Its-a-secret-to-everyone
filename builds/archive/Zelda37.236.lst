                            	 11655: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003ED58 10342070        	 11656:     move.b  ($70,A4,D2.W),D0
02:0003ED5C 1B00            	 11657:     move.b  D0,-(A5)  ; PHA
                            	 11658:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11659:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11660:     ;
02:0003ED5E 023C00EE        	 11661:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED62 123C0004        	 11662:     move.b  #$04,D1
02:0003ED66 D101            	 11663:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003ED68 19802070        	 11664:     move.b  D0,($70,A4,D2.W)
                            	 11665:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11666:     ; to store in [03].
                            	 11667:     ;
02:0003ED6C 102C04E6        	 11668:     move.b  ($04E6,A4),D0
02:0003ED70 0A000003        	 11669:     eori.b #$03,D0
02:0003ED74 19400003        	 11670:     move.b  D0,($0003,A4)
                            	 11671:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11672:     ;
02:0003ED78 103C009E        	 11673:     move.b  #$9E,D0
02:0003ED7C 0C020005        	 11674:     cmpi.b  #$05,D2
02:0003ED80 670A            	 11675:     beq  _L_z04_UpdateLamnola_Draw
02:0003ED82 0C02000A        	 11676:     cmpi.b  #$0A,D2
02:0003ED86 6704            	 11677:     beq  _L_z04_UpdateLamnola_Draw
02:0003ED88 103C00A0        	 11678:     move.b  #$A0,D0
                            	 11679:     even
                            	 11680: _L_z04_UpdateLamnola_Draw:
02:0003ED8C 4EB900031CA4    	 11681:     jsr     Anim_WriteSprite
02:0003ED92 101D            	 11682:     move.b  (A5)+,D0  ; PLA
02:0003ED94 19802070        	 11683:     move.b  D0,($70,A4,D2.W)
02:0003ED98 41EC0098        	 11684:     lea     ($0098,A4),A0
02:0003ED9C 10302000        	 11685:     move.b  (A0,D2.W),D0
02:0003EDA0 1B00            	 11686:     move.b  D0,-(A5)  ; PHA
02:0003EDA2 4EB900031D24    	 11687:     jsr     CheckMonsterCollisions
02:0003EDA8 101D            	 11688:     move.b  (A5)+,D0  ; PLA
02:0003EDAA 41EC0098        	 11689:     lea     ($0098,A4),A0
02:0003EDAE 11802000        	 11690:     move.b  D0,(A0,D2.W)
                            	 11691:     ; If still alive, then return.
                            	 11692:     ;
02:0003EDB2 41EC0405        	 11693:     lea     ($0405,A4),A0
02:0003EDB6 10302000        	 11694:     move.b  (A0,D2.W),D0
02:0003EDBA 6604            	 11695:     bne.s  __far_z_04_0115
02:0003EDBC 6000FF72        	 11696:     jmp  L129EA_Exit
                            	 11697: __far_z_04_0115:
                            	 11698:     ; Otherwise, the segment is dead.
                            	 11699:     ;
02:0003EDC0 4EB90004B7D0    	 11700:     jsr     ResetShoveInfo
                            	 11701:     ; Set the current segment's HP to the initial value in anticipation
                            	 11702:     ; of bringing this segment back to life.
                            	 11703:     ;
02:0003EDC6 7020            	 11704:     moveq   #32,D0
02:0003EDC8 41EC0485        	 11705:     lea     ($0485,A4),A0
02:0003EDCC 11802000        	 11706:     move.b  D0,(A0,D2.W)
                            	 11707:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11708:     ;
                            	 11709:     ; From the lowest slot, look for one that has the original lamnola
                            	 11710:     ; object type.
                            	 11711:     ;
                            	 11712:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11713:     ;
02:0003EDD0 163C00FF        	 11714:     move.b  #$FF,D3
02:0003EDD4 0C020006        	 11715:     cmpi.b  #$06,D2
02:0003EDD8 6502            	 11716:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003EDDA 7604            	 11717:     moveq   #4,D3
                            	 11718:     even
                            	 11719: _L_z04_UpdateLamnola_FindTail:
02:0003EDDC 5203            	 11720:     addq.b  #1,D3
02:0003EDDE 41EC0350        	 11721:     lea     ($0350,A4),A0
02:0003EDE2 10303000        	 11722:     move.b  (A0,D3.W),D0
02:0003EDE6 122C04E7        	 11723:     move.b  ($04E7,A4),D1
02:0003EDEA B001            	 11724:     cmp.b   D1,D0
02:0003EDEC 66EE            	 11725:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11726:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11727:     ;
02:0003EDEE 7011            	 11728:     moveq   #17,D0
02:0003EDF0 19803029        	 11729:     move.b  D0,($29,A4,D3.W)
                            	 11730:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11731:     ; to the tail segment.
                            	 11732:     ;
02:0003EDF4 41EC04F0        	 11733:     lea     ($04F0,A4),A0
02:0003EDF8 10302000        	 11734:     move.b  (A0,D2.W),D0
02:0003EDFC 41EC04F1        	 11735:     lea     ($04F1,A4),A0
02:0003EE00 11803000        	 11736:     move.b  D0,(A0,D3.W)
02:0003EE04 10342070        	 11737:     move.b  ($70,A4,D2.W),D0
02:0003EE08 19803071        	 11738:     move.b  D0,($71,A4,D3.W)
02:0003EE0C 41EC0084        	 11739:     lea     ($0084,A4),A0
02:0003EE10 10302000        	 11740:     move.b  (A0,D2.W),D0
02:0003EE14 41EC0085        	 11741:     lea     ($0085,A4),A0
02:0003EE18 11803000        	 11742:     move.b  D0,(A0,D3.W)
                            	 11743:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11744:     ; So, return and leave it dead.
                            	 11745:     ;
02:0003EE1C 0C030004        	 11746:     cmpi.b  #$04,D3
02:0003EE20 6604            	 11747:     bne.s  __far_z_04_0116
02:0003EE22 6000FF0C        	 11748:     jmp  L129EA_Exit
                            	 11749: __far_z_04_0116:
02:0003EE26 0C030009        	 11750:     cmpi.b  #$09,D3
02:0003EE2A 6604            	 11751:     bne.s  __far_z_04_0117
02:0003EE2C 6000FF02        	 11752:     jmp  L129EA_Exit
                            	 11753: __far_z_04_0117:
                            	 11754:     ; Change the tail segment to the dead dummy object, and
                            	 11755:     ; bring the current segment back to life.
                            	 11756:     ;
02:0003EE30 705D            	 11757:     moveq   #93,D0
02:0003EE32 41EC0350        	 11758:     lea     ($0350,A4),A0
02:0003EE36 11803000        	 11759:     move.b  D0,(A0,D3.W)
02:0003EE3A 4EF90004D654    	 11760:     jmp     ResetObjMetastate
                            	 11761: 
                            	 11762:     even
                            	 11763: L12A6F_Exit:
02:0003EE40 4E75            	 11764:     rts
                            	 11765: 
                            	 11766:     even
                            	 11767: Lamnola_UpdateHead:
                            	 11768:     ; If X coordinate is not a multiple of 8, then return.
                            	 11769:     ;
02:0003EE42 10342070        	 11770:     move.b  ($70,A4,D2.W),D0
02:0003EE46 02000007        	 11771:     andi.b #$07,D0
02:0003EE4A 6702            	 11772:     beq.s  __far_z_04_0118
02:0003EE4C 60F2            	 11773:     jmp  L12A6F_Exit
                            	 11774: __far_z_04_0118:
                            	 11775:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11776:     ; We had to account for the usual offset of 3.
                            	 11777:     ;
02:0003EE4E 41EC0084        	 11778:     lea     ($0084,A4),A0
02:0003EE52 10302000        	 11779:     move.b  (A0,D2.W),D0
02:0003EE56 023C00EE        	 11780:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EE5A 123C0003        	 11781:     move.b  #$03,D1
02:0003EE5E D101            	 11782:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EE60 02000007        	 11783:     andi.b #$07,D0
02:0003EE64 6702            	 11784:     beq.s  __far_z_04_0119
02:0003EE66 60D8            	 11785:     jmp  L12A6F_Exit
                            	 11786: __far_z_04_0119:
                            	 11787:     ; Will loop 4 times, propagating directions down the chain,
                            	 11788:     ; by pulling from the bottom.
                            	 11789:     ;
02:0003EE68 7004            	 11790:     moveq   #4,D0
02:0003EE6A 1880            	 11791:     move.b  D0,($0000,A4)
                            	 11792:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11793:     ;
02:0003EE6C 7600            	 11794:     moveq   #0,D3
02:0003EE6E 0C020005        	 11795:     cmpi.b  #$05,D2
02:0003EE72 6702            	 11796:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003EE74 7605            	 11797:     moveq   #5,D3
                            	 11798:     even
                            	 11799: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11800:     ; Loop over every segment under the head, starting from the tail.
                            	 11801:     ; Copy the next segment's direction to the current one in this loop.
                            	 11802:     ;
02:0003EE76 41EC009A        	 11803:     lea     ($009A,A4),A0
02:0003EE7A 10303000        	 11804:     move.b  (A0,D3.W),D0
02:0003EE7E 41EC0099        	 11805:     lea     ($0099,A4),A0
02:0003EE82 11803000        	 11806:     move.b  D0,(A0,D3.W)
02:0003EE86 5203            	 11807:     addq.b  #1,D3
02:0003EE88 5314            	 11808:     subq.b  #1,($0000,A4)
02:0003EE8A 66EA            	 11809:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11810:     ; If this head segment is not aligned with a square, then return.
                            	 11811:     ;
02:0003EE8C 10342070        	 11812:     move.b  ($70,A4,D2.W),D0
02:0003EE90 0200000F        	 11813:     andi.b #$0F,D0
02:0003EE94 660000BA        	 11814:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11815:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11816:     ; We had to account for the usual offset of 3.
                            	 11817:     ;
02:0003EE98 41EC0084        	 11818:     lea     ($0084,A4),A0
02:0003EE9C 10302000        	 11819:     move.b  (A0,D2.W),D0
02:0003EEA0 023C00EE        	 11820:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EEA4 123C0003        	 11821:     move.b  #$03,D1
02:0003EEA8 D101            	 11822:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EEAA 0200000F        	 11823:     andi.b #$0F,D0
02:0003EEAE 660000A0        	 11824:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11825:     ; Store the opposite of the facing direction in [00].
                            	 11826:     ;
02:0003EEB2 41EC0098        	 11827:     lea     ($0098,A4),A0
02:0003EEB6 10302000        	 11828:     move.b  (A0,D2.W),D0
02:0003EEBA E208            	 11829:     lsr.b  #1,D0   ; LSR A
02:0003EEBC 02000005        	 11830:     andi.b #$05,D0
02:0003EEC0 1880            	 11831:     move.b  D0,($0000,A4)
02:0003EEC2 41EC0098        	 11832:     lea     ($0098,A4),A0
02:0003EEC6 10302000        	 11833:     move.b  (A0,D2.W),D0
02:0003EECA E308            	 11834:     lsl.b  #1,D0   ; ASL A
02:0003EECC 0200000A        	 11835:     andi.b #$0A,D0
02:0003EED0 1214            	 11836:     move.b  ($0000,A4),D1
02:0003EED2 8001            	 11837:     or.b  D1,D0
                            	 11838:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11839:     ;
02:0003EED4 0A00000F        	 11840:     eori.b #$0F,D0
02:0003EED8 1940050F        	 11841:     move.b  D0,($050F,A4)
                            	 11842:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11843:     ;
02:0003EEDC 10342018        	 11844:     move.b  ($18,A4,D2.W),D0
02:0003EEE0 0C000080        	 11845:     cmpi.b  #$80,D0
02:0003EEE4 656C            	 11846:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11847:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11848:     ; Load the monster's facing direction.
                            	 11849:     ;
02:0003EEE6 41EC0098        	 11850:     lea     ($0098,A4),A0
02:0003EEEA 10302000        	 11851:     move.b  (A0,D2.W),D0
                            	 11852:     ; Load the next random number into Y register.
                            	 11853:     ;
02:0003EEEE 7600            	 11854:     moveq   #0,D3
02:0003EEF0 16342019        	 11855:     move.b  ($19,A4,D2.W),D3
                            	 11856:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11857:     ; to keep moving straight.
                            	 11858:     ;
02:0003EEF4 0C030080        	 11859:     cmpi.b  #$80,D3
02:0003EEF8 6418            	 11860:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11861:     even
                            	 11862: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11863:     ; Loop to rotate the direction bit over the mask.
                            	 11864:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11865:     ; facing direction.
                            	 11866:     ;
                            	 11867:     ; Shift right the copy of the direction.
                            	 11868:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11869:     ;
02:0003EEFA E208            	 11870:     lsr.b  #1,D0   ; LSR A
02:0003EEFC 6402            	 11871:     bcc  _anon_z04_151
02:0003EEFE 7008            	 11872:     moveq   #8,D0
                            	 11873: _anon_z04_151:
                            	 11874:     ; If the current direction bit is masked off, then we've reached
                            	 11875:     ; the opposite direction. Loop again.
                            	 11876:     ;
02:0003EF00 122C050F        	 11877:     move.b  ($050F,A4),D1
02:0003EF04 C200            	 11878:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF06 67F2            	 11879:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11880:     ; If Y register >= $40, then break out of the loop.
                            	 11881:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11882:     ;
02:0003EF08 0C030040        	 11883:     cmpi.b  #$40,D3
02:0003EF0C 6404            	 11884:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11885:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11886:     ; and loop again now.
                            	 11887:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11888:     ;
02:0003EF0E 7640            	 11889:     moveq   #64,D3
02:0003EF10 65E8            	 11890:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11891:     even
                            	 11892: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11893:     ; Change the facing direction to the direction found.
                            	 11894:     ;
02:0003EF12 41EC0098        	 11895:     lea     ($0098,A4),A0
