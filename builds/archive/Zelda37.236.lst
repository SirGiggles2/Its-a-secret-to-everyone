02:0003E77C 1B00            	 10881:     move.b  D0,-(A5)  ; PHA
                            	 10882:     ; To calculate the base offset of the sprite record:
                            	 10883:     ; offset := neck index * 8
                            	 10884:     ;
                            	 10885:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 10886:     ; at an even index.
                            	 10887:     ;
02:0003E77E 102C04D7        	 10888:     move.b  ($04D7,A4),D0
