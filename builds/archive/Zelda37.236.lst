02:0003EC9E 102C0084        	 11550:     move.b  ($0084,A4),D0
02:0003ECA2 0C000095        	 11551:     cmpi.b  #$95,D0
02:0003ECA6 6702            	 11552:     beq.s  __far_z_04_0111
02:0003ECA8 602E            	 11553:     jmp  L129B7_Exit
                            	 11554: __far_z_04_0111:
                            	 11555:     ; Else Link is near enough to Zelda.
