02:0002EDBE 1400            	  1818:     move.b  D0,D2
                            	  1819:     ; Put block address in [00:01] and size in [03:02].
                            	  1820:     ; Load destination VRAM address and set it.
                            	  1821:     ; The size and VRAM address have the high byte first.
                            	  1822:     ;
02:0002EDC0 41F90002ED9A    	  1823:     lea     (DemoPatternBlockAddrs).l,A0
