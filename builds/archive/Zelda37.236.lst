02:00041026 162C00EB        	  1662:     move.b  ($00EB,A4),D3
02:0004102A 610043BA        	  1663:     jsr     IsDarkRoom_Bank5
02:0004102E 6702            	  1664:     beq.s  __far_z_05_0025
02:00041030 6052            	  1665:     jmp  InitMode4_GoToSub0
                            	  1666: __far_z_05_0025:
                            	  1667:     ; This is a light room.
                            	  1668:     ; See if we have to brighten it after leaving a dark room.
                            	  1669:     ;
02:00041032 102C0098        	  1670:     move.b  ($0098,A4),D0
02:00041036 610041F6        	  1671:     jsr     CalcNextRoomByDir
                            	  1672:     ; Subtract RoomId from next room ID that was calculated
                            	  1673:     ; to get room ID offset in that direction.
02:0004103A 003C0011        	  1674:     ori     #$11,CCR  ; SEC: set C+X
02:0004103E 122C00EB        	  1675:     move.b  ($00EB,A4),D1
02:00041042 0A3C0010        	  1676:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041046 9101            	  1677:     subx.b  D1,D0   ; SBC RoomId
02:00041048 0A3C0010        	  1678:     eori    #$10,CCR  ; restore X = 6502 C
02:0004104C 4EB900030E5A    	  1679:     jsr     Negate
02:00041052 023C00EE        	  1680:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041056 122C00EB        	  1681:     move.b  ($00EB,A4),D1
