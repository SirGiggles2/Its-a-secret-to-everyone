                            	  7047: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7048:     ; Advance the substate.
                            	  7049:     ;
02:0003CB3C 41EC042C        	  7050:     lea     ($042C,A4),A0
02:0003CB40 52302000        	  7051:     addq.b  #1,(A0,D2.W)
                            	  7052:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7053:     ;
02:0003CB44 41EC042C        	  7054:     lea     ($042C,A4),A0
02:0003CB48 10302000        	  7055:     move.b  (A0,D2.W),D0
02:0003CB4C 0C000002        	  7056:     cmpi.b  #$02,D0
