                            	 13942: TurnTowardsPlayer8:
                            	 13943:     ; Build a direction in [00] towards the player.
                            	 13944:     ;
                            	 13945:     ; First, calculate a horizontal component:
                            	 13946:     ;
                            	 13947:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13948:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13949:     ; else                               [00] := 2 (left)
                            	 13950:     ;
02:0003FD48 7600            	 13951:     moveq   #0,D3
02:0003FD4A 1883            	 13952:     move.b  D3,($0000,A4)
02:0003FD4C 5203            	 13953:     addq.b  #1,D3
02:0003FD4E 102C0061        	 13954:     move.b  ($0061,A4),D0
02:0003FD52 12342070        	 13955:     move.b  ($70,A4,D2.W),D1
02:0003FD56 B001            	 13956:     cmp.b   D1,D0
02:0003FD58 6706            	 13957:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003FD5A 6402            	 13958:     bcc  _anon_z04_175
02:0003FD5C 5203            	 13959:     addq.b  #1,D3
                            	 13960: _anon_z04_175:
02:0003FD5E 1883            	 13961:     move.b  D3,($0000,A4)
                            	 13962:     even
                            	 13963: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 13964:     ; Second, calculate a vertical component.
                            	 13965:     ; Combine it with the horizontal component:
                            	 13966:     ;
                            	 13967:     ; Y := 4 (down)
                            	 13968:     ; if observed player Y <> object Y then
                            	 13969:     ;   if observed player Y < object Y then
                            	 13970:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 13971:     ;   [00] := [00] | Y
                            	 13972:     ;
02:0003FD60 7601            	 13973:     moveq   #1,D3
02:0003FD62 102C0062        	 13974:     move.b  ($0062,A4),D0
02:0003FD66 41EC0084        	 13975:     lea     ($0084,A4),A0
02:0003FD6A 12302000        	 13976:     move.b  (A0,D2.W),D1
02:0003FD6E B001            	 13977:     cmp.b   D1,D0
