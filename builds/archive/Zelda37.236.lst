02:0003D2A2 19400028        	  8074:     move.b  D0,($0028,A4)
02:0003D2A6 19400405        	  8075:     move.b  D0,($0405,A4)
02:0003D2AA 194000C0        	  8076:     move.b  D0,($00C0,A4)
02:0003D2AE 194000D3        	  8077:     move.b  D0,($00D3,A4)
                            	  8078:     ; Restart the monster's movement frame cycle: frame 0, counter 4
