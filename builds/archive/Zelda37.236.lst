02:0003CD1A 41EC00AC        	  7328:     lea     ($00AC,A4),A0
02:0003CD1E 11803000        	  7329:     move.b  D0,(A0,D3.W)
02:0003CD22 41EC042C        	  7330:     lea     ($042C,A4),A0
