02:0004C0C2 6072            	  4969:     jmp  DeactivateShot
                            	  4970: __far_z_07_0076:
                            	  4971:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4972:     ; unused, so it only has to depend on having an empty slot.
                            	  4973:     ;
                            	  4974:     ; If successful, Link's state will have been changed to "using item".
                            	  4975:     ; But we don't want that in this case.
                            	  4976:     ;
                            	  4977:     ; For both these reasons, save state and restore it afterward.
                            	  4978:     ;
02:0004C0C4 102C00AC        	  4979:     move.b  ($00AC,A4),D0
02:0004C0C8 1B00            	  4980:     move.b  D0,-(A5)  ; PHA
02:0004C0CA 102C0513        	  4981:     move.b  ($0513,A4),D0
02:0004C0CE 1B00            	  4982:     move.b  D0,-(A5)  ; PHA
02:0004C0D0 7000            	  4983:     moveq   #0,D0
02:0004C0D2 19400513        	  4984:     move.b  D0,($0513,A4)
02:0004C0D6 4EB90003109C    	  4985:     jsr     WieldCandle
02:0004C0DC 101D            	  4986:     move.b  (A5)+,D0  ; PLA
02:0004C0DE 19400513        	  4987:     move.b  D0,($0513,A4)
02:0004C0E2 101D            	  4988:     move.b  (A5)+,D0  ; PLA
02:0004C0E4 194000AC        	  4989:     move.b  D0,($00AC,A4)
                            	  4990:     ; State $21 means that a moving fire was just made.
                            	  4991:     ;
                            	  4992:     ; If it's any another value, then we didn't find an empty slot
                            	  4993:     ; to make a fire. In this case, all that's left to do is to go
                            	  4994:     ; deactivate the shot object.
                            	  4995:     ;
02:0004C0E8 41EC00AC        	  4996:     lea     ($00AC,A4),A0
02:0004C0EC 10302000        	  4997:     move.b  (A0,D2.W),D0
02:0004C0F0 0C000021        	  4998:     cmpi.b  #$21,D0
02:0004C0F4 6702            	  4999:     beq.s  __far_z_07_0077
02:0004C0F6 6038            	  5000:     jmp  DeactivateLinkShot
                            	  5001: __far_z_07_0077:
                            	  5002:     ; Make state $22 for a standing fire.
