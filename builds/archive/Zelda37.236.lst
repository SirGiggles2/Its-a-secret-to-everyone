                            	  9865: _L_z04_UpdateGohma_AnimateEye:
                            	  9866:     ; Animate the eye.
                            	  9867:     ;
                            	  9868:     ; First, if the counter for when to open the eye next = 0, then
                            	  9869:     ; set it to a random value at least $C0; and set the timer for
                            	  9870:     ; keeping the eye open to $80.
                            	  9871:     ;
                            	  9872:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9873:     ; every other frame.
                            	  9874:     ;
02:0003E006 41EC042C        	  9875:     lea     ($042C,A4),A0
02:0003E00A 10302000        	  9876:     move.b  (A0,D2.W),D0
02:0003E00E 661E            	  9877:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003E010 103C0080        	  9878:     move.b  #$80,D0
02:0003E014 41EC0444        	  9879:     lea     ($0444,A4),A0
02:0003E018 11802000        	  9880:     move.b  D0,(A0,D2.W)
02:0003E01C 103C00C0        	  9881:     move.b  #$C0,D0
02:0003E020 12342018        	  9882:     move.b  ($18,A4,D2.W),D1
02:0003E024 8001            	  9883:     or.b  D1,D0
02:0003E026 41EC042C        	  9884:     lea     ($042C,A4),A0
02:0003E02A 11802000        	  9885:     move.b  D0,(A0,D2.W)
                            	  9886:     even
