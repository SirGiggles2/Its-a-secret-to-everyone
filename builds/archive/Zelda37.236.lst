02:0003ADB0 11802000        	  2998:     move.b  D0,(A0,D2.W)
                            	  2999:     ; Add the acceleration to the speed fraction (low byte).
                            	  3000:     ;
02:0003ADB4 41EC041F        	  3001:     lea     ($041F,A4),A0
02:0003ADB8 10302000        	  3002:     move.b  (A0,D2.W),D0
02:0003ADBC 023C00EE        	  3003:     andi    #$EE,CCR  ; CLC: clear C+X
