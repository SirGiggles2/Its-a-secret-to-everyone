                            	  3744: InitArmosOrFlyingGhini:
                            	  3745:     ; In UpdateObject, this object was flagged "initialized".
                            	  3746:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3747:     ;
02:0003B322 10342028        	  3748:     move.b  ($28,A4,D2.W),D0
02:0003B326 41EC0492        	  3749:     lea     ($0492,A4),A0
02:0003B32A 11802000        	  3750:     move.b  D0,(A0,D2.W)
                            	  3751:     ; If it's still fading in, then go finish some initialization needed
                            	  3752:     ; for fading in.
                            	  3753:     ;
02:0003B32E 660000B6        	  3754:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3755:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3756:     ; go finish initializing it.
                            	  3757:     ;
02:0003B332 41EC034F        	  3758:     lea     ($034F,A4),A0
02:0003B336 10302000        	  3759:     move.b  (A0,D2.W),D0
02:0003B33A 0C000022        	  3760:     cmpi.b  #$22,D0
02:0003B33E 670000A6        	  3761:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3762:     ; Else we have an armos.
                            	  3763:     ;
                            	  3764:     ; Store stairs tile $70 in [00] for use later.
                            	  3765:     ;
02:0003B342 7070            	  3766:     moveq   #112,D0
02:0003B344 1880            	  3767:     move.b  D0,($0000,A4)
                            	  3768:     ; Look for the current room ID in an array of room ID's that
                            	  3769:     ; have armos secrets.
                            	  3770:     ;
02:0003B346 7606            	  3771:     moveq   #6,D3
                            	  3772:     even
                            	  3773: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B348 102C00EB        	  3774:     move.b  ($00EB,A4),D0
                            	  3775:     ; If this element does not match the current room ID, go loop again.
                            	  3776:     ;
02:0003B34C 41F90003B312    	  3777:     lea     (SecretArmosRoomIds).l,A0
02:0003B352 12303000        	  3778:     move.b  (A0,D3.W),D1
02:0003B356 B001            	  3779:     cmp.b   D1,D0
02:0003B358 6648            	  3780:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3781:     ; The secret (usually stairs) is under one of the armoses.
                            	  3782:     ;
                            	  3783:     ; If the armos's X coordinate does not match the one needed
                            	  3784:     ; for the current room in the list, then go loop again.
                            	  3785:     ;
02:0003B35A 10342070        	  3786:     move.b  ($70,A4,D2.W),D0
02:0003B35E 41F90003B31A    	  3787:     lea     (SecretArmosXs).l,A0
02:0003B364 12303000        	  3788:     move.b  (A0,D3.W),D1
02:0003B368 B001            	  3789:     cmp.b   D1,D0
02:0003B36A 6636            	  3790:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3791:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3792:     ;
02:0003B36C 41EC0084        	  3793:     lea     ($0084,A4),A0
02:0003B370 10302000        	  3794:     move.b  (A0,D2.W),D0
02:0003B374 0C000080        	  3795:     cmpi.b  #$80,D0
02:0003B378 6628            	  3796:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3797:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3798:     ;
02:0003B37A 4A03            	  3799:     cmpi.b  #$00,D3
02:0003B37C 662C            	  3800:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3801:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3802:     ; has the power bracelet.
                            	  3803:     ;
                            	  3804:     ; Set up the room item with the armos's coordinates.
                            	  3805:     ;
02:0003B37E 19400097        	  3806:     move.b  D0,($0097,A4)
02:0003B382 10342070        	  3807:     move.b  ($70,A4,D2.W),D0
02:0003B386 19400083        	  3808:     move.b  D0,($0083,A4)
                            	  3809:     ; This resets the room item's state, which activates it.
                            	  3810:     ;
02:0003B38A 194300BF        	  3811:     move.b  D3,($00BF,A4)
                            	  3812:     ; Set the room item ID.
                            	  3813:     ;
02:0003B38E 7014            	  3814:     moveq   #20,D0
02:0003B390 194000AB        	  3815:     move.b  D0,($00AB,A4)
                            	  3816:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3817:     ;
                            	  3818:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3819:     ;
                            	  3820:     ; Note that, if the item was already taken, then the room item
                            	  3821:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3822:     ; it will be ignored, because that routine checks whether
                            	  3823:     ; the item was taken.
                            	  3824:     ;
02:0003B394 4EB900031350    	  3825:     jsr     GetRoomFlagUWItemState
02:0003B39A 660A            	  3826:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B39C 610006B2        	  3827:     jsr     PlaySecretFoundTune
02:0003B3A0 6604            	  3828:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3829:     even
                            	  3830: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3831:     ; Bottom of the loop.
                            	  3832:     ;
02:0003B3A2 5303            	  3833:     subq.b  #1,D3
02:0003B3A4 6AA2            	  3834:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3835:     even
                            	  3836: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3837:     ; Not found, or found the power bracelet.
                            	  3838:     ; Use a floor tile $26 to replace the armos.
                            	  3839:     ;
02:0003B3A6 7026            	  3840:     moveq   #38,D0
02:0003B3A8 1880            	  3841:     move.b  D0,($0000,A4)
                            	  3842:     even
                            	  3843: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B3AA 1014            	  3844:     move.b  ($0000,A4),D0
                            	  3845:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3846:     ;
02:0003B3AC 1B00            	  3847:     move.b  D0,-(A5)  ; PHA
02:0003B3AE 0C000070        	  3848:     cmpi.b  #$70,D0
02:0003B3B2 6604            	  3849:     bne  _anon_z04_51
02:0003B3B4 6100069A        	  3850:     jsr     PlaySecretFoundTune
                            	  3851: _anon_z04_51:
                            	  3852:     ; Replace the tile where the armos was.
                            	  3853:     ;
02:0003B3B8 522C00F7        	  3854:     addq.b  #1,($00F7,A4)
02:0003B3BC 101D            	  3855:     move.b  (A5)+,D0  ; PLA
02:0003B3BE 4EB90004AE64    	  3856:     jsr     ChangeTileObjTiles
                            	  3857:     ; Because the armos object is aligned to the square grid
                            	  3858:     ; (because it was made from a square),
                            	  3859:     ; set its grid offset to 3 to compensate.
                            	  3860:     ;
                            	  3861:     ; Most objects are aligned to the grid vertically when the
                            	  3862:     ; low nibble is $D.
                            	  3863:     ;
02:0003B3C4 7003            	  3864:     moveq   #3,D0
02:0003B3C6 41EC0394        	  3865:     lea     ($0394,A4),A0
02:0003B3CA 11802000        	  3866:     move.b  D0,(A0,D2.W)
                            	  3867:     ; Set a speed (q-speed fraction) randomly:
                            	  3868:     ; $20 if random value < $80
                            	  3869:     ; $60 otherwise
                            	  3870:     ;
02:0003B3CE 7020            	  3871:     moveq   #32,D0
02:0003B3D0 7600            	  3872:     moveq   #0,D3
02:0003B3D2 16342019        	  3873:     move.b  ($19,A4,D2.W),D3
02:0003B3D6 0C030080        	  3874:     cmpi.b  #$80,D3
02:0003B3DA 6502            	  3875:     bcs  _anon_z04_52
02:0003B3DC 7060            	  3876:     moveq   #96,D0
                            	  3877: _anon_z04_52:
02:0003B3DE 41EC03BC        	  3878:     lea     ($03BC,A4),A0
02:0003B3E2 11802000        	  3879:     move.b  D0,(A0,D2.W)
                            	  3880:     even
                            	  3881: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3882:     ; Facing and input directions down.
                            	  3883:     ;
02:0003B3E6 7004            	  3884:     moveq   #4,D0
02:0003B3E8 41EC03F8        	  3885:     lea     ($03F8,A4),A0
02:0003B3EC 11802000        	  3886:     move.b  D0,(A0,D2.W)
02:0003B3F0 41EC0098        	  3887:     lea     ($0098,A4),A0
02:0003B3F4 11802000        	  3888:     move.b  D0,(A0,D2.W)
                            	  3889:     ; Every other frame, return without drawing.
                            	  3890:     ;
02:0003B3F8 10342028        	  3891:     move.b  ($28,A4,D2.W),D0
02:0003B3FC E208            	  3892:     lsr.b  #1,D0   ; LSR A
02:0003B3FE 6512            	  3893:     bcs  _anon_z04_53
                            	  3894:     ; Finish initializing based on type.
                            	  3895:     ;
02:0003B400 41EC034F        	  3896:     lea     ($034F,A4),A0
02:0003B404 10302000        	  3897:     move.b  (A0,D2.W),D0
02:0003B408 0C000022        	  3898:     cmpi.b  #$22,D0
02:0003B40C 6602            	  3899:     bne.s  __far_z_04_0032
02:0003B40E 6008            	  3900:     jmp  L_EndInitFlyingGhini
