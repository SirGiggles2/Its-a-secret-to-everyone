02:0003A4EE D101            	  1687:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A4F0 020000F0        	  1688:     andi.b #$F0,D0
02:0003A4F4 19802070        	  1689:     move.b  D0,($70,A4,D2.W)
