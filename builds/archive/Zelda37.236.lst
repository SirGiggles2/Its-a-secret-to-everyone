02:00030640 003C0011        	  3025:     ori     #$11,CCR  ; SEC: set C+X
02:00030644 12342070        	  3026:     move.b  ($70,A4,D2.W),D1
02:00030648 0A3C0010        	  3027:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
