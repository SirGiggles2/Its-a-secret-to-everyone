02:0003ACD6 0C03000D        	  2880:     cmpi.b  #$0D,D3
02:0003ACDA 6714            	  2881:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2882:     ; t := t AND $7F
                            	  2883:     ;
02:0003ACDC 0200007F        	  2884:     andi.b #$7F,D0
                            	  2885:     ; If Random < $A0, then go use this t.
                            	  2886:     ;
