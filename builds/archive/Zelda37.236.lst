                            	  2102: ;==============================================================================
                            	  2103: ; EXPORT side — carry-returning shims.
                            	  2104: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2105: ; reproduces the original function's carry normalization.
                            	  2106: ;==============================================================================
                            	  2107: 
                            	  2108: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2109: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2110:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2111:     btst    #8,D0
02:0002BF8E 670A            	  2112:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2113:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2114:     eori    #$01,CCR
02:0002BF98 4E75            	  2115:     rts
                            	  2116: .cc_cnr:
02:0002BF9A 023C00FE        	  2117:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2118:     eori    #$01,CCR
02:0002BFA2 4E75            	  2119:     rts
                            	  2120: 
