02:0004C43E D101            	  5478:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004C440 661C            	  5479:     bne  _L_z07_SetAttrAndDrawArrow_SetAttr
                            	  5480:     even
