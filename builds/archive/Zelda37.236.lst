02:00032036 0200000F        	  6611:     andi.b #$0F,D0
02:0003203A 122C000D        	  6612:     move.b  ($000D,A4),D1
02:0003203E B001            	  6613:     cmp.b   D1,D0
02:00032040 6554            	  6614:     bcs  _L_z01_Link_BeHarmed_HandleDied
02:00032042 102C066F        	  6615:     move.b  ($066F,A4),D0
02:00032046 003C0011        	  6616:     ori     #$11,CCR  ; SEC: set C+X
02:0003204A 122C000D        	  6617:     move.b  ($000D,A4),D1
02:0003204E 0A3C0010        	  6618:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032052 9101            	  6619:     subx.b  D1,D0   ; SBC $0D
02:00032054 0A3C0010        	  6620:     eori    #$10,CCR  ; restore X = 6502 C
02:00032058 1940066F        	  6621:     move.b  D0,($066F,A4)
02:0003205C 0A3C0001        	  6622:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00032060 4E75            	  6623:     rts
