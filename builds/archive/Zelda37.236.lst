02:0003D24A 11802000        	  8040:     move.b  D0,(A0,D2.W)
02:0003D24E 7600            	  8041:     moveq   #0,D3
02:0003D250 41EC03E4        	  8042:     lea     ($03E4,A4),A0
02:0003D254 16302000        	  8043:     move.b  (A0,D2.W),D3
02:0003D258 5203            	  8044:     addq.b  #1,D3
02:0003D25A 1003            	  8045:     move.b  D3,D0
02:0003D25C 02000003        	  8046:     andi.b #$03,D0
02:0003D260 41EC03E4        	  8047:     lea     ($03E4,A4),A0
02:0003D264 11802000        	  8048:     move.b  D0,(A0,D2.W)
                            	  8049:     even
                            	  8050: _L_z04_UpdateLikeLike_Draw:
                            	  8051:     ; Draw.
                            	  8052:     ;
02:0003D268 4EB90004CE4C    	  8053:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D26E 41EC03E4        	  8054:     lea     ($03E4,A4),A0
02:0003D272 10302000        	  8055:     move.b  (A0,D2.W),D0
02:0003D276 4EB9000319A4    	  8056:     jsr     DrawObjectMirrored
                            	  8057:     ; Check collisions. If Link was not captured, then return.
                            	  8058:     ;
02:0003D27C 4EB900031D24    	  8059:     jsr     CheckMonsterCollisions
02:0003D282 41EC042C        	  8060:     lea     ($042C,A4),A0
02:0003D286 10302000        	  8061:     move.b  (A0,D2.W),D0
02:0003D28A 673C            	  8062:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8063:     ; The monster captured Link.
                            	  8064:     ; Put the monster at the same location as him.
