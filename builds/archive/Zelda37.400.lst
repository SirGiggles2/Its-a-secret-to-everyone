                            	  8876:     even
                            	  8877: UpdateGanon_JumpTable:
02:0003C200 0003C20C        	  8878:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C204 0003C26E        	  8879:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003C208 0003C29C        	  8880:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  8881: 
                            	  8882: ; Description:
                            	  8883: ; Lift up the Triforce of Courage while the room is dark.
                            	  8884: ;
                            	  8885: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8886: ;
                            	  8887:     even
                            	  8888: Ganon_ScenePhase0:
02:0003C20C 701B            	  8889:     moveq   #27,D0
02:0003C20E 19400505        	  8890:     move.b  D0,($0505,A4)
                            	  8891:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  8892:     ;
02:0003C212 102C0028        	  8893:     move.b  ($0028,A4),D0
02:0003C216 6644            	  8894:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8895:     ; Once the timer expires, it's time to brighten the room.
                            	  8896:     ;
                            	  8897:     ; Save the current object slot.
02:0003C218 1002            	  8898:     move.b  D2,D0
02:0003C21A 1B00            	  8899:     move.b  D0,-(A5)  ; PHA
02:0003C21C 610007F0        	  8900:     jsr     UpdateCandle
02:0003C220 101D            	  8901:     move.b  (A5)+,D0  ; PLA
02:0003C222 7400            	  8902:     moveq   #0,D2
02:0003C224 1400            	  8903:     move.b  D0,D2
                            	  8904:     ; Turn off the room brightening flag, because we're controlling it
                            	  8905:     ; here instead of in the Mode 5 object update loop.
                            	  8906:     ;
02:0003C226 7000            	  8907:     moveq   #0,D0
02:0003C228 1940051E        	  8908:     move.b  D0,($051E,A4)
                            	  8909:     ; On the first frame of the fade-to-light cycle, play the
                            	  8910:     ; Triforce/Ganon song.
                            	  8911:     ;
02:0003C22C 102C051C        	  8912:     move.b  ($051C,A4),D0
02:0003C230 0C0000C0        	  8913:     cmpi.b  #$C0,D0
02:0003C234 6606            	  8914:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003C236 7002            	  8915:     moveq   #2,D0
02:0003C238 19400600        	  8916:     move.b  D0,($0600,A4)
                            	  8917:     even
                            	  8918: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8919:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8920:     ;
02:0003C23C 102C051C        	  8921:     move.b  ($051C,A4),D0
02:0003C240 0200000F        	  8922:     andi.b #$0F,D0
02:0003C244 0C000004        	  8923:     cmpi.b  #$04,D0
02:0003C248 6702            	  8924:     beq.s  __far_z_04_0097
02:0003C24A 6042            	  8925:     jmp  Ganon_DrawBodyFrame0
                            	  8926: __far_z_04_0097:
                            	  8927:     ; Set Link's timer to $C0 for the next scene phase.
                            	  8928:     ;
02:0003C24C 103C00C0        	  8929:     move.b  #$C0,D0
02:0003C250 19400028        	  8930:     move.b  D0,($0028,A4)
                            	  8931:     ; Set scene phase 1, and go draw Ganon.
                            	  8932:     ;
02:0003C254 522C0445        	  8933:     addq.b  #1,($0445,A4)
02:0003C258 6702            	  8934:     beq.s  __far_z_04_0098
02:0003C25A 6032            	  8935:     jmp  Ganon_DrawBodyFrame0
                            	  8936: __far_z_04_0098:
                            	  8937:     even
                            	  8938: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	  8939:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8940:     ; In this case, I think it means Ganon is shouting.
                            	  8941:     ;
02:0003C25C 0C000001        	  8942:     cmpi.b  #$01,D0
