02:000393A6 41EC0492        	  2666:     lea     ($0492,A4),A0
02:000393AA 10302000        	  2667:     move.b  (A0,D2.W),D0
02:000393AE 66EC            	  2668:     bne  _anon_z04_53
02:000393B0 4EB90004A27A    	  2669:     jsr     ResetObjMetastateAndTimer
