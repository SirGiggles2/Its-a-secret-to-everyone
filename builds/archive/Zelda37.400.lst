02:0004919C 670A            	  5483:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004919E 10342070        	  5484:     move.b  ($70,A4,D2.W),D0
02:000491A2 0C000002        	  5485:     cmpi.b  #$02,D0
02:000491A6 650E            	  5486:     bcs  _L_z07_CheckState30_SetState40
