                            	  4636: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  4637:     ; Digdogger is big, but room boundary checks and
                            	  4638:     ; object collision checks assume a 16x16 monster or smaller.
                            	  4639:     ; Therefore, we have to check these things four times,
                            	  4640:     ; in different corners of the boss.
                            	  4641:     ;
                            	  4642:     ; Loop 4 times, from 0 to 3.
                            	  4643:     ;
02:0003A172 7600            	  4644:     moveq   #0,D3
02:0003A174 41EC0478        	  4645:     lea     ($0478,A4),A0
02:0003A178 16302000        	  4646:     move.b  (A0,D2.W),D3
                            	  4647:     ; Change the coordinates to one corner.
                            	  4648:     ;
02:0003A17C 10342070        	  4649:     move.b  ($70,A4,D2.W),D0
02:0003A180 023C00EE        	  4650:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A184 41F90003A038    	  4651:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A18A 12303000        	  4652:     move.b  (A0,D3.W),D1
02:0003A18E D101            	  4653:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003A190 19802070        	  4654:     move.b  D0,($70,A4,D2.W)
02:0003A194 41EC0084        	  4655:     lea     ($0084,A4),A0
02:0003A198 10302000        	  4656:     move.b  (A0,D2.W),D0
02:0003A19C 023C00EE        	  4657:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A1A0 41F90003A03C    	  4658:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A1A6 12303000        	  4659:     move.b  (A0,D3.W),D1
02:0003A1AA D101            	  4660:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A1AC 41EC0084        	  4661:     lea     ($0084,A4),A0
02:0003A1B0 11802000        	  4662:     move.b  D0,(A0,D2.W)
                            	  4663:     ; Check the room boundary and object collisions in this temporary location.
