                            	  2497: InitArmosOrFlyingGhini:
                            	  2498:     ; In UpdateObject, this object was flagged "initialized".
                            	  2499:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2500:     ;
02:000392AC 10342028        	  2501:     move.b  ($28,A4,D2.W),D0
02:000392B0 41EC0492        	  2502:     lea     ($0492,A4),A0
02:000392B4 11802000        	  2503:     move.b  D0,(A0,D2.W)
                            	  2504:     ; If it's still fading in, then go finish some initialization needed
                            	  2505:     ; for fading in.
                            	  2506:     ;
02:000392B8 660000B6        	  2507:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2508:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2509:     ; go finish initializing it.
                            	  2510:     ;
02:000392BC 41EC034F        	  2511:     lea     ($034F,A4),A0
02:000392C0 10302000        	  2512:     move.b  (A0,D2.W),D0
02:000392C4 0C000022        	  2513:     cmpi.b  #$22,D0
02:000392C8 670000A6        	  2514:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2515:     ; Else we have an armos.
                            	  2516:     ;
                            	  2517:     ; Store stairs tile $70 in [00] for use later.
                            	  2518:     ;
02:000392CC 7070            	  2519:     moveq   #112,D0
02:000392CE 1880            	  2520:     move.b  D0,($0000,A4)
                            	  2521:     ; Look for the current room ID in an array of room ID's that
                            	  2522:     ; have armos secrets.
                            	  2523:     ;
02:000392D0 7606            	  2524:     moveq   #6,D3
                            	  2525:     even
                            	  2526: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:000392D2 102C00EB        	  2527:     move.b  ($00EB,A4),D0
                            	  2528:     ; If this element does not match the current room ID, go loop again.
                            	  2529:     ;
02:000392D6 41F90003929C    	  2530:     lea     (SecretArmosRoomIds).l,A0
02:000392DC 12303000        	  2531:     move.b  (A0,D3.W),D1
02:000392E0 B001            	  2532:     cmp.b   D1,D0
02:000392E2 6648            	  2533:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2534:     ; The secret (usually stairs) is under one of the armoses.
                            	  2535:     ;
                            	  2536:     ; If the armos's X coordinate does not match the one needed
                            	  2537:     ; for the current room in the list, then go loop again.
                            	  2538:     ;
02:000392E4 10342070        	  2539:     move.b  ($70,A4,D2.W),D0
02:000392E8 41F9000392A4    	  2540:     lea     (SecretArmosXs).l,A0
02:000392EE 12303000        	  2541:     move.b  (A0,D3.W),D1
02:000392F2 B001            	  2542:     cmp.b   D1,D0
02:000392F4 6636            	  2543:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2544:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2545:     ;
02:000392F6 41EC0084        	  2546:     lea     ($0084,A4),A0
02:000392FA 10302000        	  2547:     move.b  (A0,D2.W),D0
02:000392FE 0C000080        	  2548:     cmpi.b  #$80,D0
02:00039302 6628            	  2549:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2550:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2551:     ;
02:00039304 4A03            	  2552:     cmpi.b  #$00,D3
02:00039306 662C            	  2553:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2554:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2555:     ; has the power bracelet.
                            	  2556:     ;
                            	  2557:     ; Set up the room item with the armos's coordinates.
                            	  2558:     ;
02:00039308 19400097        	  2559:     move.b  D0,($0097,A4)
02:0003930C 10342070        	  2560:     move.b  ($70,A4,D2.W),D0
02:00039310 19400083        	  2561:     move.b  D0,($0083,A4)
                            	  2562:     ; This resets the room item's state, which activates it.
                            	  2563:     ;
02:00039314 194300BF        	  2564:     move.b  D3,($00BF,A4)
                            	  2565:     ; Set the room item ID.
                            	  2566:     ;
02:00039318 7014            	  2567:     moveq   #20,D0
02:0003931A 194000AB        	  2568:     move.b  D0,($00AB,A4)
                            	  2569:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2570:     ;
                            	  2571:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2572:     ;
                            	  2573:     ; Note that, if the item was already taken, then the room item
                            	  2574:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2575:     ; it will be ignored, because that routine checks whether
                            	  2576:     ; the item was taken.
                            	  2577:     ;
02:0003931E 4EB900030A12    	  2578:     jsr     GetRoomFlagUWItemState
02:00039324 660A            	  2579:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00039326 6100069E        	  2580:     jsr     PlaySecretFoundTune
02:0003932A 6604            	  2581:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  2582:     even
