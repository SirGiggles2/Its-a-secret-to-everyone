02:00049370 122C0004        	  5736:     move.b  ($0004,A4),D1
02:00049374 D101            	  5737:     addx.b  D1,D0   ; ADC $04
02:00049376 19400004        	  5738:     move.b  D0,($0004,A4)
02:0004937A 761D            	  5739:     moveq   #29,D3
02:0004937C 601C            	  5740:     jmp     L_DrawArrowOrBoomerang
