02:0003C1D0 10302000        	  8854:     move.b  (A0,D2.W),D0
02:0003C1D4 6704            	  8855:     beq  _L_z04_PatraChild_State1_Exit
02:0003C1D6 6100FCCC        	  8856:     jsr     SetDeadDummyObjType
                            	  8857:     even
