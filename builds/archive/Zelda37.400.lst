02:00049DDA 0C00001C        	  7087:     cmpi.b  #$1C,D0
02:00049DDE 672C            	  7088:     beq  _L_z07_UpdateMetaObjectEnd_DropItem
                            	  7089:     ; Advance the world kill cycle (0 to 9).
