                            	  3822: ; AddQSpeedToPositionFraction — D2=slot. Returns carry in CCR (C=1 if advanced).
                            	  3823: ; ASM MoveObject_Right/Down consume this via `addx.b`, which reads CCR.X (bit 4).
                            	  3824: ; 6502 convention: X mirrors C. Set/clear both bits 0 (C) and 4 (X).
                            	  3825: c_add_q_speed_to_position_fraction:
02:0002C8EE 7000            	  3826:     moveq   #0,D0
02:0002C8F0 3002            	  3827:     move.w  D2,D0
