                            	  5238: Aquamentus_Draw:
                            	  5239:     ; Every $10 screen frames, switch animation frames.
                            	  5240:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  5241:     ; The last tile of frame 0 is at index 5.
                            	  5242:     ; The last tile of frame 1 is at index $B.
                            	  5243:     ;
02:0003A64E 7605            	  5244:     moveq   #5,D3
02:0003A650 102C0015        	  5245:     move.b  ($0015,A4),D0
02:0003A654 02000010        	  5246:     andi.b #$10,D0
02:0003A658 6602            	  5247:     bne  _anon_z04_88
02:0003A65A 760B            	  5248:     moveq   #11,D3
                            	  5249: _anon_z04_88:
02:0003A65C 1943000A        	  5250:     move.b  D3,($000A,A4)
                            	  5251:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  5252:     ;
02:0003A660 7005            	  5253:     moveq   #5,D0
02:0003A662 1940000B        	  5254:     move.b  D0,($000B,A4)
                            	  5255:     even
                            	  5256: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A666 7600            	  5257:     moveq   #0,D3
02:0003A668 162C000B        	  5258:     move.b  ($000B,A4),D3
                            	  5259:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  5260:     ; Store it in [00].
                            	  5261:     ;
02:0003A66C 10342070        	  5262:     move.b  ($70,A4,D2.W),D0
02:0003A670 023C00EE        	  5263:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A674 41F90003A648    	  5264:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A67A 12303000        	  5265:     move.b  (A0,D3.W),D1
02:0003A67E D101            	  5266:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A680 1880            	  5267:     move.b  D0,($0000,A4)
                            	  5268:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  5269:     ; Store it in [01].
                            	  5270:     ;
02:0003A682 41EC0084        	  5271:     lea     ($0084,A4),A0
02:0003A686 10302000        	  5272:     move.b  (A0,D2.W),D0
02:0003A68A 023C00EE        	  5273:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A68E 41F90003A642    	  5274:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A694 12303000        	  5275:     move.b  (A0,D3.W),D1
02:0003A698 D101            	  5276:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A69A 19400001        	  5277:     move.b  D0,($0001,A4)
                            	  5278:     ; Calculate sprite attributes:
                            	  5279:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  5280:     ;
                            	  5281:     ; If the boss is temporarily invincible, then
                            	  5282:     ; this makes it flash by cycling all the palette rows.
                            	  5283:     ;
                            	  5284:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  5285:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  5286:     ;
02:0003A69E 41EC04F0        	  5287:     lea     ($04F0,A4),A0
02:0003A6A2 10302000        	  5288:     move.b  (A0,D2.W),D0
02:0003A6A6 02000003        	  5289:     andi.b #$03,D0
02:0003A6AA 0A000003        	  5290:     eori.b #$03,D0
02:0003A6AE 19400003        	  5291:     move.b  D0,($0003,A4)
02:0003A6B2 7600            	  5292:     moveq   #0,D3
02:0003A6B4 162C000A        	  5293:     move.b  ($000A,A4),D3
                            	  5294:     ; Look up the tile for this sprite.
                            	  5295:     ; If it's not the first one (face), then go write the sprite record.
                            	  5296:     ;
02:0003A6B8 41F90003A636    	  5297:     lea     (AquamentusTiles).l,A0
02:0003A6BE 10303000        	  5298:     move.b  (A0,D3.W),D0
02:0003A6C2 12390003A636    	  5299:     move.b  (AquamentusTiles).l,D1
02:0003A6C8 B001            	  5300:     cmp.b   D1,D0
02:0003A6CA 6610            	  5301:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  5302:     ; Else it's the first one (the face tile).
                            	  5303:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  5304:     ;
                            	  5305:     ; $CC/CD shows the closed mouth face.
                            	  5306:     ; $C0/C1 shows the open mouth face.
                            	  5307:     ;
02:0003A6CC 7600            	  5308:     moveq   #0,D3
02:0003A6CE 16342028        	  5309:     move.b  ($28,A4,D2.W),D3
02:0003A6D2 0C030020        	  5310:     cmpi.b  #$20,D3
02:0003A6D6 6404            	  5311:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A6D8 103C00C0        	  5312:     move.b  #$C0,D0
