                            	  4163: UpdateMoldorm:
                            	  4164:     ; If facing direction = 0, return.
                            	  4165:     ;
02:00039E92 41EC0098        	  4166:     lea     ($0098,A4),A0
02:00039E96 10302000        	  4167:     move.b  (A0,D2.W),D0
02:00039E9A 670000C2        	  4168:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4169:     ; If the magic clock is missing, then move around (using the flying mechanism).
                            	  4170:     ;
02:00039E9E 102C066C        	  4171:     move.b  ($066C,A4),D0
02:00039EA2 6608            	  4172:     bne  _anon_z04_79
02:00039EA4 610000BA        	  4173:     jsr     ControlMoldormFlight
02:00039EA8 61002C36        	  4174:     jsr     MoveFlyer
                            	  4175: _anon_z04_79:
                            	  4176:     ; Draw with sprite attributes: normal, red palette row
                            	  4177:     ;
02:00039EAC 7002            	  4178:     moveq   #2,D0
02:00039EAE 19400003        	  4179:     move.b  D0,($0003,A4)
02:00039EB2 7044            	  4180:     moveq   #68,D0
02:00039EB4 4EB900030FD6    	  4181:     jsr     Anim_WriteSprite
                            	  4182:     ; Check collisions, but never let them interfere with movement.
                            	  4183:     ;
02:00039EBA 41EC0098        	  4184:     lea     ($0098,A4),A0
02:00039EBE 10302000        	  4185:     move.b  (A0,D2.W),D0
02:00039EC2 1B00            	  4186:     move.b  D0,-(A5)  ; PHA
02:00039EC4 10342028        	  4187:     move.b  ($28,A4,D2.W),D0
02:00039EC8 1B00            	  4188:     move.b  D0,-(A5)  ; PHA
02:00039ECA 4EB900031046    	  4189:     jsr     CheckMonsterCollisions
02:00039ED0 101D            	  4190:     move.b  (A5)+,D0  ; PLA
02:00039ED2 19802028        	  4191:     move.b  D0,($28,A4,D2.W)
02:00039ED6 101D            	  4192:     move.b  (A5)+,D0  ; PLA
02:00039ED8 41EC0098        	  4193:     lea     ($0098,A4),A0
02:00039EDC 11802000        	  4194:     move.b  D0,(A0,D2.W)
                            	  4195:     ; If this segment is still alive, then return.
                            	  4196:     ;
02:00039EE0 41EC0405        	  4197:     lea     ($0405,A4),A0
02:00039EE4 10302000        	  4198:     move.b  (A0,D2.W),D0
02:00039EE8 6774            	  4199:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4200:     ; This segment is dead. We'll swap the tail segment with this
                            	  4201:     ; dead segment. This way, moldorm heads are always rooted
                            	  4202:     ; in slots 5 and $A; and the segments are continguous.
                            	  4203:     ;
                            	  4204:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  4205:     ;
                            	  4206:     ; Note that this is not a true swap, because the tail's HP
                            	  4207:     ; might be less than $20.
                            	  4208:     ;
02:00039EEA 7020            	  4209:     moveq   #32,D0
02:00039EEC 41EC0485        	  4210:     lea     ($0485,A4),A0
02:00039EF0 11802000        	  4211:     move.b  D0,(A0,D2.W)
02:00039EF4 61000608        	  4212:     jsr     CheckBossHitReaction
                            	  4213:     ; Look for the tail segment, starting from the low end
                            	  4214:     ; of the chain that this dead segment belongs to.
                            	  4215:     ;
02:00039EF8 163C00FF        	  4216:     move.b  #$FF,D3
02:00039EFC 0C020006        	  4217:     cmpi.b  #$06,D2
02:00039F00 6502            	  4218:     bcs  _anon_z04_80
