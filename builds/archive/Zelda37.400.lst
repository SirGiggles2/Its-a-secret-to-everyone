02:0003511C 123C0080        	  4817:     move.b  #$80,D1
02:00035120 D101            	  4818:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:00035122 19400058        	  4819:     move.b  D0,($0058,A4)
                            	  4820:     ; Carry over to the tile offset and current V-scroll.
                            	  4821:     ;
