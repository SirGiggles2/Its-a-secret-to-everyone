02:000492C6 41EC03D0        	  5654:     lea     ($03D0,A4),A0
02:000492CA 11802000        	  5655:     move.b  D0,(A0,D2.W)
02:000492CE 41EC00AC        	  5656:     lea     ($00AC,A4),A0
02:000492D2 52302000        	  5657:     addq.b  #1,(A0,D2.W)
02:000492D6 41EC00AC        	  5658:     lea     ($00AC,A4),A0
02:000492DA 10302000        	  5659:     move.b  (A0,D2.W),D0
02:000492DE 02000077        	  5660:     andi.b #$77,D0
02:000492E2 41EC00AC        	  5661:     lea     ($00AC,A4),A0
02:000492E6 11802000        	  5662:     move.b  D0,(A0,D2.W)
02:000492EA 0C02000D        	  5663:     cmpi.b  #$0D,D2
02:000492EE 6402            	  5664:     bcc.s  __far_z_07_0082
02:000492F0 6032            	  5665:     jmp  CalcBoomerangFrame
                            	  5666: __far_z_07_0082:
