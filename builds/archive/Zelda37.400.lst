                            	  8759:     ; This location is right above Patra.
                            	  8760:     ; Set Y coordinate to (Patra's Y - [00]).
                            	  8761:     ;
02:0003C10A 102C0085        	  8762:     move.b  ($0085,A4),D0
02:0003C10E 003C0011        	  8763:     ori     #$11,CCR  ; SEC: set C+X
02:0003C112 1214            	  8764:     move.b  ($0000,A4),D1
02:0003C114 0A3C0010        	  8765:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C118 9101            	  8766:     subx.b  D1,D0   ; SBC $00
02:0003C11A 0A3C0010        	  8767:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C11E 41EC0084        	  8768:     lea     ($0084,A4),A0
02:0003C122 11802000        	  8769:     move.b  D0,(A0,D2.W)
                            	  8770:     even
