                            	  5949: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5950:     ; Store the weapon's frame (horizontal or vertical)
                            	  5951:     ; for the direction chosen above in [0C].
                            	  5952:     ;
02:0004951A 4EB90003090A    	  5953:     jsr     GetOppositeDir
02:00049520 41F900048F54    	  5954:     lea     (RDirectionToWeaponFrame).l,A0
02:00049526 10303000        	  5955:     move.b  (A0,D3.W),D0
02:0004952A 1940000C        	  5956:     move.b  D0,($000C,A4)
                            	  5957:     ; Calculate sprite attributes.
                            	  5958:     ;
                            	  5959:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5960:     ;   base attribute OR 1
                            	  5961:     ; So, it uses palette row 5.
                            	  5962:     ;
02:0004952E 41F900048F58    	  5963:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049534 10303000        	  5964:     move.b  (A0,D3.W),D0
02:00049538 0C02000D        	  5965:     cmpi.b  #$0D,D2
02:0004953C 6706            	  5966:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:0004953E 00000001        	  5967:     ori.b #$01,D0
02:00049542 601C            	  5968:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5969: 
                            	  5970:     even
                            	  5971: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5972:     ; The weapon is the sword.
                            	  5973:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5974:     ;
02:00049544 023C00EE        	  5975:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049548 122C0657        	  5976:     move.b  ($0657,A4),D1
02:0004954C D101            	  5977:     addx.b  D1,D0   ; ADC Items
02:0004954E 003C0011        	  5978:     ori     #$11,CCR  ; SEC: set C+X
02:00049552 123C0001        	  5979:     move.b  #$01,D1
02:00049556 0A3C0010        	  5980:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004955A 9101            	  5981:     subx.b  D1,D0   ; SBC #$01
02:0004955C 0A3C0010        	  5982:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5983:     even
                            	  5984: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5985:     ; Set sprite attributes to the calculated value above.
