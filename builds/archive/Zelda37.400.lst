                            	  5692: CalcBoomerangFrame:
                            	  5693:     ; The minor state (low 3 bits of state) is used to
                            	  5694:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5695:     ;
                            	  5696:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5697:     ; In other words, don't offset the coordinate below.
                            	  5698:     ;
02:00049324 7000            	  5699:     moveq   #0,D0
02:00049326 1880            	  5700:     move.b  D0,($0000,A4)
02:00049328 41EC00AC        	  5701:     lea     ($00AC,A4),A0
02:0004932C 10302000        	  5702:     move.b  (A0,D2.W),D0
02:00049330 0200000F        	  5703:     andi.b #$0F,D0
02:00049334 7600            	  5704:     moveq   #0,D3
02:00049336 1600            	  5705:     move.b  D0,D3
02:00049338 7000            	  5706:     moveq   #0,D0
02:0004933A 19400001        	  5707:     move.b  D0,($0001,A4)
02:0004933E 41F900048F2C    	  5708:     lea     (BoomerangFrameCycle).l,A0
02:00049344 10303000        	  5709:     move.b  (A0,D3.W),D0
02:00049348 1940000C        	  5710:     move.b  D0,($000C,A4)
                            	  5711:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5712:     ;
02:0004934C 1003            	  5713:     move.b  D3,D0
02:0004934E 41F900048F36    	  5714:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:00049354 10303000        	  5715:     move.b  (A0,D3.W),D0
02:00049358 19400004        	  5716:     move.b  D0,($0004,A4)
                            	  5717:     ; TODO: ?
                            	  5718:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5719:     ; Else add the item value of the magic boomerang.
                            	  5720:     ;
                            	  5721:     ; But none of the values in the base sprite attributes array is 8.
                            	  5722:     ;
                            	  5723:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5724:     ; the inventory will always be added to the base sprite attribute.
                            	  5725:     ;
                            	  5726:     ; So, palette row 4 or 5 will be chosen.
                            	  5727:     ;
02:0004935C 7600            	  5728:     moveq   #0,D3
02:0004935E 0C000008        	  5729:     cmpi.b  #$08,D0
02:00049362 6706            	  5730:     beq  _anon_z07_31
02:00049364 7600            	  5731:     moveq   #0,D3
02:00049366 162C0675        	  5732:     move.b  ($0675,A4),D3
                            	  5733: _anon_z07_31:
