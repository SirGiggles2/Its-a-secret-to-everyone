02:0003DD44 6702            	  1512:     beq.s  __far_z_05_0025
02:0003DD46 6052            	  1513:     jmp  InitMode4_GoToSub0
                            	  1514: __far_z_05_0025:
                            	  1515:     ; This is a light room.
