                            	  2343: ModeE_HandleAOrB:
02:00033816 102C0420        	  2344:     move.b  ($0420,A4),D0
                            	  2345:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2346:     ; the name field.
02:0003381A 6646            	  2347:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:0003381C 7600            	  2348:     moveq   #0,D3
02:0003381E 162C0016        	  2349:     move.b  ($0016,A4),D3
02:00033822 0C030003        	  2350:     cmpi.b  #$03,D3
02:00033826 6602            	  2351:     bne.s  __far_z_02_0003
02:00033828 60E6            	  2352:     jmp  LA10A_Exit
                            	  2353: __far_z_02_0003:
                            	  2354:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2355:     ; in the current slot's name.
02:0003382A 41F90003323E    	  2356:     lea     (SlotToNameOffset).l,A0
02:00033830 10303000        	  2357:     move.b  (A0,D3.W),D0
02:00033834 19400421        	  2358:     move.b  D0,($0421,A4)
                            	  2359:     ; Get the offset of the end of the initial name character
                            	  2360:     ; transfer record header for the current slot.
02:00033838 7400            	  2361:     moveq   #0,D2
02:0003383A 41F900033242    	  2362:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033840 14303000        	  2363:     move.b  (A0,D3.W),D2
02:00033844 7602            	  2364:     moveq   #2,D3
                            	  2365:     even
                            	  2366: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00033846 41F90003320E    	  2367:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:0003384C 10302000        	  2368:     move.b  (A0,D2.W),D0
02:00033850 41EC0422        	  2369:     lea     ($0422,A4),A0
02:00033854 11803000        	  2370:     move.b  D0,(A0,D3.W)
02:00033858 5302            	  2371:     subq.b  #1,D2
02:0003385A 5303            	  2372:     subq.b  #1,D3
02:0003385C 6AE8            	  2373:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:0003385E 522C0420        	  2374:     addq.b  #1,($0420,A4)
                            	  2375:     even
                            	  2376: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2377:     ; At this point:
                            	  2378:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2379:     ;   - This will be changed as the player inputs characters.
                            	  2380:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2381:     ;   - This will be changed as the player inputs characters.
                            	  2382:     ; - InitializedNameField [$0420] is set to 1.
                            	  2383:     ;
02:00033862 102C00F8        	  2384:     move.b  ($00F8,A4),D0
02:00033866 020000C0        	  2385:     andi.b #$C0,D0
02:0003386A 670000E8        	  2386:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2387:     ; A or B was pressed.
                            	  2388:     ;
02:0003386E 0C000040        	  2389:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033872 660000A6        	  2390:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2391:     ; A was pressed.
                            	  2392:     ;
                            	  2393:     ; Request to play the character click tune (same as bomb set).
02:00033876 7620            	  2394:     moveq   #32,D3
02:00033878 19430604        	  2395:     move.b  D3,($0604,A4)
02:0003387C 7602            	  2396:     moveq   #2,D3
                            	  2397:     even
                            	  2398: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:0003387E 41EC0422        	  2399:     lea     ($0422,A4),A0
02:00033882 10303000        	  2400:     move.b  (A0,D3.W),D0
02:00033886 41EC0302        	  2401:     lea     ($0302,A4),A0
02:0003388A 11803000        	  2402:     move.b  D0,(A0,D3.W)
02:0003388E 5303            	  2403:     subq.b  #1,D3
02:00033890 6AEC            	  2404:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033892 19430306        	  2405:     move.b  D3,($0306,A4)
02:00033896 7400            	  2406:     moveq   #0,D2
02:00033898 142C0421        	  2407:     move.b  ($0421,A4),D2
02:0003389C 7600            	  2408:     moveq   #0,D3
02:0003389E 162C041F        	  2409:     move.b  ($041F,A4),D3
02:000338A2 41F9000331E2    	  2410:     lea     (ModeE_CharMap).l,A0
02:000338A8 10303000        	  2411:     move.b  (A0,D3.W),D0
02:000338AC 19400305        	  2412:     move.b  D0,($0305,A4)
02:000338B0 41EC0638        	  2413:     lea     ($0638,A4),A0
02:000338B4 11802000        	  2414:     move.b  D0,(A0,D2.W)
                            	  2415:     even
                            	  2416: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:000338B8 102C0070        	  2417:     move.b  ($0070,A4),D0
02:000338BC 023C00EE        	  2418:     andi    #$EE,CCR  ; CLC: clear C+X
02:000338C0 123C0008        	  2419:     move.b  #$08,D1
02:000338C4 D101            	  2420:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000338C6 19400070        	  2421:     move.b  D0,($0070,A4)
02:000338CA 522C0421        	  2422:     addq.b  #1,($0421,A4)
02:000338CE 522C0423        	  2423:     addq.b  #1,($0423,A4)
                            	  2424:     ; If VRAM address still points inside the name field,
                            	  2425:     ; then go finish.
                            	  2426:     ;
                            	  2427:     ; The idea is that each name field in nametable begins at
                            	  2428:     ; an address ending in $E. For example, slot 0 has a name
                            	  2429:     ; at VRAM addresses $20CE to $20D5.
                            	  2430:     ;
                            	  2431:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2432:     ; the name field.
                            	  2433:     ;
                            	  2434:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2435:     ; record header.
                            	  2436:     ;
02:000338D2 102C0070        	  2437:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:000338D6 0C0000B0        	  2438:     cmpi.b  #$B0,D0
02:000338DA 6678            	  2439:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2440:     ; The VRAM address now points outside the name field.
                            	  2441:     ; So, wrap around to the beginning of the name field.
                            	  2442:     ;
                            	  2443:     ; For example, $20D6 -> $20CE.
                            	  2444:     ;
02:000338DC 102C0423        	  2445:     move.b  ($0423,A4),D0
02:000338E0 003C0011        	  2446:     ori     #$11,CCR  ; SEC: set C+X
02:000338E4 123C0008        	  2447:     move.b  #$08,D1
02:000338E8 0A3C0010        	  2448:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000338EC 9101            	  2449:     subx.b  D1,D0   ; SBC #$08
02:000338EE 0A3C0010        	  2450:     eori    #$10,CCR  ; restore X = 6502 C
02:000338F2 19400423        	  2451:     move.b  D0,($0423,A4)
                            	  2452:     ; It also means that we went past the end of the save slot
                            	  2453:     ; info name. Set the offset to the beginning of the name.
02:000338F6 7600            	  2454:     moveq   #0,D3
02:000338F8 162C0016        	  2455:     move.b  ($0016,A4),D3
02:000338FC 41F90003323E    	  2456:     lea     (SlotToNameOffset).l,A0
02:00033902 10303000        	  2457:     move.b  (A0,D3.W),D0
02:00033906 19400421        	  2458:     move.b  D0,($0421,A4)
                            	  2459:     ; If the name cursor has gone past the end of the field,
                            	  2460:     ; then wrap around.
02:0003390A 102C0070        	  2461:     move.b  ($0070,A4),D0
02:0003390E 0C0000B0        	  2462:     cmpi.b  #$B0,D0
02:00033912 6640            	  2463:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00033914 7070            	  2464:     moveq   #112,D0
02:00033916 19400070        	  2465:     move.b  D0,($0070,A4)
                            	  2466:     even
                            	  2467: ; PATCH P25b: FS2-E backspace handler.
                            	  2468: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2469: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2470: ; one column (8 px), and writes a space ($24) to the erased
                            	  2471: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2472: ; cannot cross into a previous slot's name field.
                            	  2473: _L_z02_ModeE_HandleAOrB_Backspace:
02:0003391A 7600            	  2474:     moveq   #0,D3
02:0003391C 162C0016        	  2475:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00033920 41F90003323E    	  2476:     lea     (SlotToNameOffset).l,A0
02:00033926 12303000        	  2477:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:0003392A 102C0421        	  2478:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:0003392E B001            	  2479:     cmp.b   D1,D0
02:00033930 6322            	  2480:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00033932 5300            	  2481:     subq.b  #1,D0
02:00033934 19400421        	  2482:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00033938 532C0423        	  2483:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:0003393C 122C0070        	  2484:     move.b  ($0070,A4),D1
02:00033940 5101            	  2485:     subi.b  #8,D1
02:00033942 19410070        	  2486:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00033946 7224            	  2487:     moveq   #$24,D1              ; space tile
02:00033948 7600            	  2488:     moveq   #0,D3
02:0003394A 1600            	  2489:     move.b  D0,D3                ; D3 = erased offset
02:0003394C 41EC0638        	  2490:     lea     ($0638,A4),A0
02:00033950 11813000        	  2491:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2492:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2493:     even
                            	  2494: _L_z02_ModeE_HandleAOrB_Exit:
02:00033954 60000096        	  2495:     jmp     ModeE_SetNameCursorSpriteX
                            	  2496: 
                            	  2497:     even
                            	  2498: ModeEandF_SetUpCursorSprites:
                            	  2499:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2500:     ; Sprites block. Only sprite 0 byte 0 is missing.
                            	  2501:     ; These are the cursor sprites.
02:00033958 760A            	  2502:     moveq   #10,D3
                            	  2503:     even
                            	  2504: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:0003395A 41F900033228    	  2505:     lea     (ModeEandFCursorSprites).l,A0
02:00033960 10303000        	  2506:     move.b  (A0,D3.W),D0
02:00033964 41EC0201        	  2507:     lea     ($0201,A4),A0
02:00033968 11803000        	  2508:     move.b  D0,(A0,D3.W)
02:0003396C 5303            	  2509:     subq.b  #1,D3
02:0003396E 6AEA            	  2510:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033970 7600            	  2511:     moveq   #0,D3
02:00033972 162C0016        	  2512:     move.b  ($0016,A4),D3
02:00033976 41F9000331DE    	  2513:     lea     (ModeEandFSlotCursorYs).l,A0
02:0003397C 10303000        	  2514:     move.b  (A0,D3.W),D0
02:00033980 19400084        	  2515:     move.b  D0,($0084,A4)
02:00033984 19400200        	  2516:     move.b  D0,($0200,A4)
02:00033988 102C0012        	  2517:     move.b  ($0012,A4),D0
02:0003398C 0C00000F        	  2518:     cmpi.b  #$0F,D0
                            	  2519:     ; There's more work in mode $E.
                            	  2520:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2521:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00033990 6736            	  2522:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00033992 103C00F3        	  2523:     move.b  #$F3,D0
02:00033996 19400201        	  2524:     move.b  D0,($0201,A4)
                            	  2525:     ; Because the visible part of the cursor block sprite is
                            	  2526:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2527:     ; above its ObjY.
02:0003399A 102C0084        	  2528:     move.b  ($0084,A4),D0
02:0003399E 003C0011        	  2529:     ori     #$11,CCR  ; SEC: set C+X
02:000339A2 123C0008        	  2530:     move.b  #$08,D1
02:000339A6 0A3C0010        	  2531:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000339AA 9101            	  2532:     subx.b  D1,D0   ; SBC #$08
02:000339AC 0A3C0010        	  2533:     eori    #$10,CCR  ; restore X = 6502 C
02:000339B0 19400204        	  2534:     move.b  D0,($0204,A4)
02:000339B4 7070            	  2535:     moveq   #112,D0
02:000339B6 19400070        	  2536:     move.b  D0,($0070,A4)
02:000339BA 103C0087        	  2537:     move.b  #$87,D0
02:000339BE 19400085        	  2538:     move.b  D0,($0085,A4)
02:000339C2 7030            	  2539:     moveq   #48,D0
02:000339C4 19400071        	  2540:     move.b  D0,($0071,A4)
                            	  2541:     even
