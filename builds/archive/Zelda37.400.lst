02:0002BFAE 003C0001        	  2498:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2499:     eori    #$01,CCR
02:0002BFB6 4E75            	  2500:     rts
                            	  2501: .cc_cnras:
02:0002BFB8 023C00FE        	  2502:     andi    #$FE,CCR
