02:00038F02 10302000        	  1975:     move.b  (A0,D2.W),D0
02:00038F06 0C000010        	  1976:     cmpi.b  #$10,D0
02:00038F0A 6604            	  1977:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
