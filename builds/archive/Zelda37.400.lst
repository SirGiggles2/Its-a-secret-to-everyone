                            	  5893: UpdatePolsVoiceState1_Jumping:
                            	  5894:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5895:     ;
02:0003AB26 41EC0444        	  5896:     lea     ($0444,A4),A0
02:0003AB2A 10302000        	  5897:     move.b  (A0,D2.W),D0
02:0003AB2E 023C00EE        	  5898:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB32 123C0038        	  5899:     move.b  #$38,D1
02:0003AB36 D101            	  5900:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003AB38 41EC0444        	  5901:     lea     ($0444,A4),A0
02:0003AB3C 11802000        	  5902:     move.b  D0,(A0,D2.W)
                            	  5903:     ; Add Carry to high speed byte (vertical).
                            	  5904:     ;
02:0003AB40 41EC0412        	  5905:     lea     ($0412,A4),A0
02:0003AB44 10302000        	  5906:     move.b  (A0,D2.W),D0
02:0003AB48 123C0000        	  5907:     move.b  #$00,D1
02:0003AB4C D101            	  5908:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003AB4E 41EC0412        	  5909:     lea     ($0412,A4),A0
02:0003AB52 11802000        	  5910:     move.b  D0,(A0,D2.W)
                            	  5911:     ; Add high speed byte to Y coordinate.
                            	  5912:     ;
02:0003AB56 023C00EE        	  5913:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB5A 41EC0084        	  5914:     lea     ($0084,A4),A0
02:0003AB5E 12302000        	  5915:     move.b  (A0,D2.W),D1
02:0003AB62 D101            	  5916:     addx.b  D1,D0   ; ADC ObjY,X
02:0003AB64 41EC0084        	  5917:     lea     ($0084,A4),A0
02:0003AB68 11802000        	  5918:     move.b  D0,(A0,D2.W)
                            	  5919:     ; If the speed is still negative, then return.
                            	  5920:     ;
02:0003AB6C 41EC0412        	  5921:     lea     ($0412,A4),A0
02:0003AB70 10302000        	  5922:     move.b  (A0,D2.W),D0
02:0003AB74 6B0000AC        	  5923:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5924:     ; If Y coordinate still < target Y, then return.
                            	  5925:     ;
02:0003AB78 41EC0084        	  5926:     lea     ($0084,A4),A0
02:0003AB7C 10302000        	  5927:     move.b  (A0,D2.W),D0
02:0003AB80 41EC042C        	  5928:     lea     ($042C,A4),A0
02:0003AB84 12302000        	  5929:     move.b  (A0,D2.W),D1
02:0003AB88 B001            	  5930:     cmp.b   D1,D0
02:0003AB8A 65000096        	  5931:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5932:     ; Else reached the destination. Go to state 0.
                            	  5933:     ;
02:0003AB8E 7000            	  5934:     moveq   #0,D0
02:0003AB90 41EC00AC        	  5935:     lea     ($00AC,A4),A0
02:0003AB94 11802000        	  5936:     move.b  D0,(A0,D2.W)
                            	  5937:     ; Reset 16-bit vertical speed.
                            	  5938:     ;
02:0003AB98 41EC0444        	  5939:     lea     ($0444,A4),A0
02:0003AB9C 11802000        	  5940:     move.b  D0,(A0,D2.W)
02:0003ABA0 41EC0412        	  5941:     lea     ($0412,A4),A0
02:0003ABA4 11802000        	  5942:     move.b  D0,(A0,D2.W)
                            	  5943:     ; Choose a random direction to face in.
                            	  5944:     ;
02:0003ABA8 10342018        	  5945:     move.b  ($18,A4,D2.W),D0
02:0003ABAC 02000003        	  5946:     andi.b #$03,D0
02:0003ABB0 7600            	  5947:     moveq   #0,D3
02:0003ABB2 1600            	  5948:     move.b  D0,D3
02:0003ABB4 41F90003A9C4    	  5949:     lea     (PolsVoiceDirections).l,A0
02:0003ABBA 10303000        	  5950:     move.b  (A0,D3.W),D0
02:0003ABBE 41EC0098        	  5951:     lea     ($0098,A4),A0
02:0003ABC2 11802000        	  5952:     move.b  D0,(A0,D2.W)
                            	  5953:     ; Randomly set distance-to-move to $30 or $70.
                            	  5954:     ;
02:0003ABC6 10342018        	  5955:     move.b  ($18,A4,D2.W),D0
02:0003ABCA 02000040        	  5956:     andi.b #$40,D0
02:0003ABCE 123C0030        	  5957:     move.b  #$30,D1
02:0003ABD2 D101            	  5958:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003ABD4 41EC0394        	  5959:     lea     ($0394,A4),A0
02:0003ABD8 11802000        	  5960:     move.b  D0,(A0,D2.W)
                            	  5961:     ; Align the monster with a square horizontally.
                            	  5962:     ;
                            	  5963:     ; If in the left half of a square, align with that square.
                            	  5964:     ; If in the right half, align with the next square.
                            	  5965:     ;
02:0003ABDC 10342070        	  5966:     move.b  ($70,A4,D2.W),D0
02:0003ABE0 023C00EE        	  5967:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ABE4 123C0008        	  5968:     move.b  #$08,D1
02:0003ABE8 D101            	  5969:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003ABEA 020000F0        	  5970:     andi.b #$F0,D0
02:0003ABEE 19802070        	  5971:     move.b  D0,($70,A4,D2.W)
                            	  5972:     ; Align the monster with a square vertically.
                            	  5973:     ;
                            	  5974:     ; If in the top half of a square, align with that square.
                            	  5975:     ; If in the bottom half, align with the next square.
                            	  5976:     ;
02:0003ABF2 41EC0084        	  5977:     lea     ($0084,A4),A0
02:0003ABF6 10302000        	  5978:     move.b  (A0,D2.W),D0
02:0003ABFA 023C00EE        	  5979:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ABFE 123C0008        	  5980:     move.b  #$08,D1
02:0003AC02 D101            	  5981:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003AC04 020000F0        	  5982:     andi.b #$F0,D0
                            	  5983:     ; Make sure the lower nibble of Y is $D as usual.
                            	  5984:     ;
02:0003AC08 003C0011        	  5985:     ori     #$11,CCR  ; SEC: set C+X
02:0003AC0C 123C0003        	  5986:     move.b  #$03,D1
02:0003AC10 0A3C0010        	  5987:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AC14 9101            	  5988:     subx.b  D1,D0   ; SBC #$03
02:0003AC16 0A3C0010        	  5989:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AC1A 41EC0084        	  5990:     lea     ($0084,A4),A0
02:0003AC1E 11802000        	  5991:     move.b  D0,(A0,D2.W)
