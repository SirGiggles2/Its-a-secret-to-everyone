                            	  7678:     ; of the big map sheet.
                            	  7679:     ;
02:00041998 0C000015        	  7680:     cmpi.b  #$15,D0
02:0004199C 6604            	  7681:     bne  _anon_z05_168
02:0004199E 7042            	  7682:     moveq   #66,D0
02:000419A0 60F4            	  7683:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  7684: 
