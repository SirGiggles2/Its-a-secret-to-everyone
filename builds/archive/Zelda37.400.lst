                            	  8804: _anon_z04_159:
02:0003C16E 61000CC0        	  8805:     jsr     DecreaseObjectAngle
                            	  8806:     ; Load Patra's maneuver index.
                            	  8807:     ; It determines which counts of bits are looked up below.
                            	  8808:     ;
02:0003C172 7600            	  8809:     moveq   #0,D3
02:0003C174 162C045F        	  8810:     move.b  ($045F,A4),D3
                            	  8811:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  8812:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  8813:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  8814:     ;
02:0003C178 41EC034F        	  8815:     lea     ($034F,A4),A0
02:0003C17C 10302000        	  8816:     move.b  (A0,D2.W),D0
02:0003C180 0C000025        	  8817:     cmpi.b  #$25,D0
02:0003C184 661E            	  8818:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003C186 41F90003C078    	  8819:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003C18C 10303000        	  8820:     move.b  (A0,D3.W),D0
02:0003C190 1B00            	  8821:     move.b  D0,-(A5)  ; PHA
02:0003C192 41F90003C07C    	  8822:     lea     (PatraChild1RotationSineBits).l,A0
02:0003C198 10303000        	  8823:     move.b  (A0,D3.W),D0
02:0003C19C 7600            	  8824:     moveq   #0,D3
02:0003C19E 1600            	  8825:     move.b  D0,D3
02:0003C1A0 101D            	  8826:     move.b  (A5)+,D0  ; PLA
02:0003C1A2 600E            	  8827:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  8828: 
                            	  8829:     even
                            	  8830: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  8831:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  8832:     ; for both Y and X increment calculations in rotation. This leads to
                            	  8833:     ; a small circle (5) and a large circle (6).
                            	  8834:     ;
02:0003C1A4 41F90003C07A    	  8835:     lea     (PatraChild2RotationBits).l,A0
02:0003C1AA 10303000        	  8836:     move.b  (A0,D3.W),D0
02:0003C1AE 7600            	  8837:     moveq   #0,D3
02:0003C1B0 1600            	  8838:     move.b  D0,D3
                            	  8839:     even
                            	  8840: _L_z04_PatraChild_State1_Rotate:
02:0003C1B2 61000ACC        	  8841:     jsr     RotateObjectLocation
02:0003C1B6 41EC0084        	  8842:     lea     ($0084,A4),A0
02:0003C1BA 11802000        	  8843:     move.b  D0,(A0,D2.W)
02:0003C1BE 611C            	  8844:     jsr     PatraChild_Draw
                            	  8845:     ; If Patra's state still = 0, then the last patra child has not
                            	  8846:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  8847:     ;
02:0003C1C0 102C00AD        	  8848:     move.b  ($00AD,A4),D0
