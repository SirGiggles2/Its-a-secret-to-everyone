                            	  6813: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6814:     ; To animate the state, the animation counter had to have
                            	  6815:     ; reached 0. Right after this routine, the counter will be
                            	  6816:     ; rolled over, and the movement frame will be switched.
                            	  6817:     ;
                            	  6818:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6819:     ; the animation here, in order to immediately change it to
                            	  6820:     ; 0 (legs apart) after this.
                            	  6821:     ;
02:00049AC8 7001            	  6822:     moveq   #1,D0
02:00049ACA 194003E4        	  6823:     move.b  D0,($03E4,A4)
02:00049ACE 4E75            	  6824:     rts
                            	  6825: 
                            	  6826:     even
                            	  6827: _L_z07_AnimateLinkObjState_CheckState30:
                            	  6828:     ; If in state $30, then make Link idle, except for halting.
