                            	  5079:     ; If the template object type in the room is one of:
                            	  5080:     ; moblin, goriya, octorock, vire, keese
                            	  5081:     ; then attract these monsters to the food.
                            	  5082:     ;
                            	  5083:     ; They will chase the food instead of Link when given a chance.
                            	  5084:     ;
02:00048EE4 102C035F        	  5085:     move.b  ($035F,A4),D0
02:00048EE8 0C000003        	  5086:     cmpi.b  #$03,D0
02:00048EEC 652C            	  5087:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:00048EEE 0C00000B        	  5088:     cmpi.b  #$0B,D0
02:00048EF2 6512            	  5089:     bcs  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:00048EF4 0C000012        	  5090:     cmpi.b  #$12,D0
02:00048EF8 670C            	  5091:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:00048EFA 0C00001B        	  5092:     cmpi.b  #$1B,D0
02:00048EFE 6706            	  5093:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
