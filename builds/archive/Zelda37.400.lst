02:0003DEE2 41EC03D0        	  1731:     lea     ($03D0,A4),A0
02:0003DEE6 52302000        	  1732:     addq.b  #1,(A0,D2.W)
02:0003DEEA 41EC0405        	  1733:     lea     ($0405,A4),A0
