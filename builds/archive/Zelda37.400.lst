                            	  9420:     ; Each part has a horizontal flipping flag.
                            	  9421:     ;
02:0003C5BA 41F90003C582    	  9422:     lea     (GanonSpriteHFlips).l,A0
02:0003C5C0 10303000        	  9423:     move.b  (A0,D3.W),D0
02:0003C5C4 1940000F        	  9424:     move.b  D0,($000F,A4)
                            	  9425:     ; Save and copy the loop index (the current part) to [07].
                            	  9426:     ;
02:0003C5C8 1003            	  9427:     move.b  D3,D0
02:0003C5CA 1B00            	  9428:     move.b  D0,-(A5)  ; PHA
02:0003C5CC 19400007        	  9429:     move.b  D0,($0007,A4)
                            	  9430:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  9431:     ; that make it up.
                            	  9432:     ;
02:0003C5D0 41EC046B        	  9433:     lea     ($046B,A4),A0
02:0003C5D4 10302000        	  9434:     move.b  (A0,D2.W),D0
02:0003C5D8 E308            	  9435:     lsl.b  #1,D0   ; ASL A
02:0003C5DA E308            	  9436:     lsl.b  #1,D0   ; ASL A
                            	  9437:     ; Add [07] -- the index of the current part.
                            	  9438:     ;
                            	  9439:     ; Now you have an index into the frame image table, for the
                            	  9440:     ; current image part of the current animation frame.
                            	  9441:     ;
02:0003C5DC 122C0007        	  9442:     move.b  ($0007,A4),D1
02:0003C5E0 D101            	  9443:     addx.b  D1,D0   ; ADC $07
02:0003C5E2 7600            	  9444:     moveq   #0,D3
02:0003C5E4 1600            	  9445:     move.b  D0,D3
02:0003C5E6 41F90003C562    	  9446:     lea     (GanonFrameImages).l,A0
02:0003C5EC 10303000        	  9447:     move.b  (A0,D3.W),D0
02:0003C5F0 4EB900030CDA    	  9448:     jsr     DrawObjectNotMirrored
02:0003C5F6 101D            	  9449:     move.b  (A5)+,D0  ; PLA
                            	  9450:     ; Bottom of the part loop.
                            	  9451:     ;
02:0003C5F8 7600            	  9452:     moveq   #0,D3
02:0003C5FA 1600            	  9453:     move.b  D0,D3
02:0003C5FC 5303            	  9454:     subq.b  #1,D3
02:0003C5FE 6A88            	  9455:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
