                            	  1536:     even
                            	  1537: UpdateMonsterArrow:
                            	  1538:     ; Set q-speed $80 (2 pixels a frame).
                            	  1539:     ;
02:00038BB6 103C0080        	  1540:     move.b  #$80,D0
02:00038BBA 41EC03BC        	  1541:     lea     ($03BC,A4),A0
02:00038BBE 11802000        	  1542:     move.b  D0,(A0,D2.W)
                            	  1543:     ; If the timer has not expired, then go draw,
                            	  1544:     ; and see if the shooter's still alive.
                            	  1545:     ;
02:00038BC2 10342028        	  1546:     move.b  ($28,A4,D2.W),D0
02:00038BC6 6626            	  1547:     bne  _L_z04_UpdateMonsterArrow_CheckShooter
                            	  1548:     ; If the arrow is sparking, then go update the base arrow.
                            	  1549:     ;
02:00038BC8 41EC00AC        	  1550:     lea     ($00AC,A4),A0
02:00038BCC 10302000        	  1551:     move.b  (A0,D2.W),D0
02:00038BD0 020000F0        	  1552:     andi.b #$F0,D0
02:00038BD4 0C000020        	  1553:     cmpi.b  #$20,D0
02:00038BD8 6732            	  1554:     beq  _L_z04_UpdateMonsterArrow_UpdateBase
                            	  1555:     ; If the arrow is not flying, then
                            	  1556:     ; go handle it bouncing off of Link's shield.
                            	  1557:     ;
02:00038BDA 0C000010        	  1558:     cmpi.b  #$10,D0
02:00038BDE 6654            	  1559:     bne  _L_z04_UpdateMonsterArrow_CheckBounce
                            	  1560:     ; TODO: But is this necessary?
                            	  1561:     ; Set the moving direction in [0F].
                            	  1562:     ; Then go update the base arrow.
                            	  1563:     ;
02:00038BE0 41EC0098        	  1564:     lea     ($0098,A4),A0
02:00038BE4 10302000        	  1565:     move.b  (A0,D2.W),D0
02:00038BE8 1940000F        	  1566:     move.b  D0,($000F,A4)
02:00038BEC 601E            	  1567:     jmp     _L_z04_UpdateMonsterArrow_UpdateBase
                            	  1568: 
                            	  1569:     even
                            	  1570: _L_z04_UpdateMonsterArrow_CheckShooter:
                            	  1571:     ; If the shooter is gone, then reset the arrow's object timer;
                            	  1572:     ; so that it flies right away.
                            	  1573:     ;
02:00038BEE 7600            	  1574:     moveq   #0,D3
02:00038BF0 41EC042C        	  1575:     lea     ($042C,A4),A0
