                            	  4117:     even
                            	  4118: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4119:     ; If grid offset <> 0, return.
                            	  4120:     ;
02:000488BE 41EC0394        	  4121:     lea     ($0394,A4),A0
02:000488C2 10302000        	  4122:     move.b  (A0,D2.W),D0
02:000488C6 6704            	  4123:     beq.s  __far_z_07_0048
02:000488C8 60000090        	  4124:     jmp  L1F148_Exit
                            	  4125: __far_z_07_0048:
                            	  4126:     ; Grid offset = 0.
                            	  4127:     ; The object is at a point between cells in the grid.
                            	  4128:     ; So, we can check tiles for collision.
                            	  4129:     ;
                            	  4130:     ; Reset [0E] alternate direction search step.
                            	  4131:     ;
