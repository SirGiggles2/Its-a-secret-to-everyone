                            	  7075:     ; a dropped item.
                            	  7076:     ;
02:00049DBE 41EC034F        	  7077:     lea     ($034F,A4),A0
02:00049DC2 10302000        	  7078:     move.b  (A0,D2.W),D0
02:00049DC6 41EC0412        	  7079:     lea     ($0412,A4),A0
