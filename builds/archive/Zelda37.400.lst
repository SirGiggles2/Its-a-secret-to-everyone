02:0003DDAC 7005            	  1569:     moveq   #5,D0
02:0003DDAE 761F            	  1570:     moveq   #31,D3
02:0003DDB0 4EB9000477A4    	  1571:     jsr     ClearRam0300UpTo
                            	  1572:     ; Reset door trigger info.
