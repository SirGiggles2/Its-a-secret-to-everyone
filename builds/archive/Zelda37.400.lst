                            	  2455:     ; Set horizontal flipping if right is a direction component.
                            	  2456:     ; This essentially the same test as above, but for when we jump
                            	  2457:     ; from the "up" test.
                            	  2458:     ;
02:0003927A 41EC0098        	  2459:     lea     ($0098,A4),A0
02:0003927E 10302000        	  2460:     move.b  (A0,D2.W),D0
02:00039282 02000002        	  2461:     andi.b #$02,D0
02:00039286 6704            	  2462:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  2463:     even
                            	  2464: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:00039288 522C000F        	  2465:     addq.b  #1,($000F,A4)
                            	  2466:     even
                            	  2467: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003928C 102C000D        	  2468:     move.b  ($000D,A4),D0
                            	  2469: ; Params:
                            	  2470: ; A: frame image
                            	  2471: ; X: object index
                            	  2472: ; [00]: object X
                            	  2473: ; [01]: object Y
                            	  2474: ; [0F]: flip horizontally
                            	  2475: ;
                            	  2476: ; Returns:
                            	  2477: ; [00]: 0 for Link slot
                            	  2478: ; [06]: 1 if objects collide
                            	  2479: ; [09]: 0 for Link damage type (none)
                            	  2480: ; [0C]: 1 if objects collide
                            	  2481: ; [034B]: ShotCollidesWithLink
                            	  2482: ;
                            	  2483:     even
