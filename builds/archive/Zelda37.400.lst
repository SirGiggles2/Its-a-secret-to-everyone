                            	  2071: _L_z07_DrawItemBySlot_WriteSprites:
                            	  2072:     ; We got here in one of three ways:
                            	  2073:     ;
                            	  2074:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2075:     ;    explicitly.
                            	  2076:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2077:     ;    held an offset that was added to base palette attribute
                            	  2078:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2079:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2080:     ;    held absolute attributes.
                            	  2081:     ;
                            	  2082:     ; At this point, A holds the final sprite attributes.
02:00047A32 7400            	  2083:     moveq   #0,D2
02:00047A34 1942000C        	  2084:     move.b  D2,($000C,A4)
02:00047A38 740F            	  2085:     moveq   #15,D2
                            	  2086:     ; Write sprites.
                            	  2087:     ; A holds the calculated sprite attributes.
                            	  2088:     ; Y holds the item slot.
02:00047A3A 4EF900030EDE    	  2089:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2090: 
                            	  2091:     even
                            	  2092: _L_z07_DrawItemBySlot_AddItemAndTableValue:
                            	  2093:     ; Calculate sprite attributes by adding item value / sprite palette
                            	  2094:     ; row attribute and the element from ItemSlotToPaletteOffsetsOrValues,
                            	  2095:     ; which here represents an offset from the palette row.
                            	  2096:     ;
02:00047A40 023C00EE        	  2097:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047A44 122C0004        	  2098:     move.b  ($0004,A4),D1
