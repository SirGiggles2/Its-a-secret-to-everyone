02:00039D6E 102C066C        	  4019:     move.b  ($066C,A4),D0
02:00039D72 1234203D        	  4020:     move.b  ($3D,A4,D2.W),D1
02:00039D76 8001            	  4021:     or.b  D1,D0
02:00039D78 6626            	  4022:     bne  _L_z04_UpdateStalfos_ZeroSpeed
                            	  4023:     ; Try to shoot a sword shot.
                            	  4024:     ;
