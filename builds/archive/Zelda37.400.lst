02:0003C262 7002            	  8944:     moveq   #2,D0
02:0003C264 19400601        	  8945:     move.b  D0,($0601,A4)
                            	  8946: _anon_z04_160:
02:0003C268 0A3C0001        	  8947:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C26C 4E75            	  8948:     rts
                            	  8949: 
                            	  8950: ; Description:
                            	  8951: ; Lift up the Triforce of Courage while the room is light.
                            	  8952: ;
                            	  8953: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8954: ;
                            	  8955:     even
                            	  8956: Ganon_ScenePhase1:
02:0003C26E 701B            	  8957:     moveq   #27,D0
02:0003C270 19400505        	  8958:     move.b  D0,($0505,A4)
                            	  8959:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8960:     ;
02:0003C274 102C0028        	  8961:     move.b  ($0028,A4),D0
02:0003C278 6702            	  8962:     beq.s  __far_z_04_0099
02:0003C27A 6012            	  8963:     jmp  Ganon_DrawBodyFrame0
                            	  8964: __far_z_04_0099:
                            	  8965:     ; Once the timer expires:
                            	  8966:     ; 1. unhalt Link
                            	  8967:     ; 2. clear the item to lift
                            	  8968:     ; 3. play level 9 song
                            	  8969:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8970:     ;
02:0003C27C 194000AC        	  8971:     move.b  D0,($00AC,A4)
02:0003C280 19400505        	  8972:     move.b  D0,($0505,A4)
02:0003C284 7020            	  8973:     moveq   #32,D0
02:0003C286 19400600        	  8974:     move.b  D0,($0600,A4)
02:0003C28A 522C0445        	  8975:     addq.b  #1,($0445,A4)
                            	  8976:     even
                            	  8977: Ganon_DrawBodyFrame0:
                            	  8978:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8979:     ; with animation frame 0.
                            	  8980:     ;
02:0003C28E 7000            	  8981:     moveq   #0,D0
02:0003C290 41EC046B        	  8982:     lea     ($046B,A4),A0
02:0003C294 11802000        	  8983:     move.b  D0,(A0,D2.W)
02:0003C298 600002EC        	  8984:     jmp     Ganon_DrawBody
                            	  8985: 
                            	  8986: ; Description:
                            	  8987: ; Fighting Ganon.
                            	  8988: ;
                            	  8989: ; If Ganon is dying, go handle it.
                            	  8990: ;
                            	  8991:     even
                            	  8992: Ganon_ScenePhase2:
02:0003C29C 41EC042C        	  8993:     lea     ($042C,A4),A0
02:0003C2A0 10302000        	  8994:     move.b  (A0,D2.W),D0
02:0003C2A4 6704            	  8995:     beq.s  __far_z_04_0100
02:0003C2A6 600000A4        	  8996:     jmp  Ganon_Dying
                            	  8997: __far_z_04_0100:
02:0003C2AA 61000356        	  8998:     jsr     Ganon_CheckCollisions
02:0003C2AE 6100BFF2        	  8999:     jsr     PlayBossHitCryIfNeeded
                            	  9000:     ; Go handle the brown state specially.
                            	  9001:     ;
02:0003C2B2 41EC00AC        	  9002:     lea     ($00AC,A4),A0
02:0003C2B6 10302000        	  9003:     move.b  (A0,D2.W),D0
02:0003C2BA 6702            	  9004:     beq.s  __far_z_04_0101
02:0003C2BC 6058            	  9005:     jmp  Ganon_UpdateBrownState
                            	  9006: __far_z_04_0101:
                            	  9007:     ; State = 0: Blue
                            	  9008:     ;
                            	  9009:     ; If timer = 0, then go move around and shoot.
                            	  9010:     ;
02:0003C2BE 10342028        	  9011:     move.b  ($28,A4,D2.W),D0
02:0003C2C2 6602            	  9012:     bne.s  __far_z_04_0102
02:0003C2C4 600E            	  9013:     jmp  Ganon_MoveAndShoot
                            	  9014: __far_z_04_0102:
                            	  9015:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  9016:     ; Collisions were checked already.
                            	  9017:     ;
                            	  9018:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  9019:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  9020:     ;
02:0003C2C6 0C000001        	  9021:     cmpi.b  #$01,D0
02:0003C2CA 6702            	  9022:     beq.s  __far_z_04_0103
02:0003C2CC 6078            	  9023:     jmp  L_Ganon_DrawBody
                            	  9024: __far_z_04_0103:
                            	  9025: ; Description:
                            	  9026: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	  9027: ;
                            	  9028:     even
                            	  9029: Ganon_RandomizeLocation:
02:0003C2CE 4EF90002BA30    	  9030:     jmp     c_ganon_randomize_location
                            	  9031: 
                            	  9032: Ganon_MoveAndShoot:
                            	  9033:     ; Change the animation frame every screen frame; so that
                            	  9034:     ; when Ganon is hit, he appears in a random pose.
                            	  9035:     ;
02:0003C2D4 41EC046B        	  9036:     lea     ($046B,A4),A0
