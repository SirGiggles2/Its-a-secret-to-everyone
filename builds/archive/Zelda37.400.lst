02:00049184 41EC03BC        	  5473:     lea     ($03BC,A4),A0
02:00049188 11802000        	  5474:     move.b  D0,(A0,D2.W)
                            	  5475:     ; If facing left and X < 2, then go change state to $40. The
                            	  5476:     ; boomerang is too close to the left edge of the screen.
