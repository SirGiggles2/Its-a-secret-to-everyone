02:0003C128 10342070        	  8778:     move.b  ($70,A4,D2.W),D0
02:0003C12C 023C00EE        	  8779:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C130 122C046C        	  8780:     move.b  ($046C,A4),D1
02:0003C134 D101            	  8781:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003C136 19802070        	  8782:     move.b  D0,($70,A4,D2.W)
02:0003C13A 41EC0084        	  8783:     lea     ($0084,A4),A0
02:0003C13E 10302000        	  8784:     move.b  (A0,D2.W),D0
02:0003C142 023C00EE        	  8785:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C146 122C0479        	  8786:     move.b  ($0479,A4),D1
02:0003C14A D101            	  8787:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003C14C 41EC0084        	  8788:     lea     ($0084,A4),A0
02:0003C150 11802000        	  8789:     move.b  D0,(A0,D2.W)
                            	  8790:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	  8791:     ;
02:0003C154 7000            	  8792:     moveq   #0,D0
02:0003C156 1940000B        	  8793:     move.b  D0,($000B,A4)
                            	  8794:     ; If the monster is type $25 Patra Child1, then decrease the
                            	  8795:     ; monster's angle by $70, else by $60 to go slower.
