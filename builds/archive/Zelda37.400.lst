02:0003DDD0 194004CD        	  1583:     move.b  D0,($04CD,A4)
02:0003DDD4 610039AE        	  1584:     jsr     ResetInvObjState
                            	  1585:     ; There's more than one way to enter a room.
                            	  1586:     ;
                            	  1587:     ; 1: Out of a cave, dungeon, or cellar
                            	  1588:     ;     a. Walking exit
                            	  1589:     ;     b. Next to stairs
                            	  1590:     ; 2: Room to room
                            	  1591:     ;
                            	  1592:     ; Determine which one we need.
                            	  1593:     ;
02:0003DDD8 102C005A        	  1594:     move.b  ($005A,A4),D0
02:0003DDDC 6770            	  1595:     beq  _L_z05_InitMode_EnterRoom_Method2
02:0003DDDE 102C0010        	  1596:     move.b  ($0010,A4),D0
02:0003DDE2 665C            	  1597:     bne  _anon_z05_42
                            	  1598:     ; Enter method 1.
                            	  1599:     ;
                            	  1600:     ; Set up Link's exit from underground.
                            	  1601:     ;
02:0003DDE4 7600            	  1602:     moveq   #0,D3
02:0003DDE6 162C00EB        	  1603:     move.b  ($00EB,A4),D3
02:0003DDEA 41F900FF687E    	  1604:     lea     (NES_SRAM+$087E).l,A0
02:0003DDF0 10303000        	  1605:     move.b  (A0,D3.W),D0
02:0003DDF4 020000F0        	  1606:     andi.b #$F0,D0
02:0003DDF8 19400070        	  1607:     move.b  D0,($0070,A4)
02:0003DDFC 41F900FF6AFE    	  1608:     lea     (NES_SRAM+$0AFE).l,A0
02:0003DE02 10303000        	  1609:     move.b  (A0,D3.W),D0
02:0003DE06 02000007        	  1610:     andi.b #$07,D0
02:0003DE0A E308            	  1611:     lsl.b  #1,D0   ; ASL A
02:0003DE0C E308            	  1612:     lsl.b  #1,D0   ; ASL A
02:0003DE0E E308            	  1613:     lsl.b  #1,D0   ; ASL A
02:0003DE10 E308            	  1614:     lsl.b  #1,D0   ; ASL A
                            	  1615:     ; Add the first Y where Link can come out of underground.
                            	  1616:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:0003DE12 123C004D        	  1617:     move.b  #$4D,D1
02:0003DE16 D101            	  1618:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:0003DE18 19400084        	  1619:     move.b  D0,($0084,A4)
                            	  1620:     ; If the player didn't step on a cave entrance to go underground,
                            	  1621:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1622:     ;
02:0003DE1C 7600            	  1623:     moveq   #0,D3
02:0003DE1E 162C0065        	  1624:     move.b  ($0065,A4),D3
02:0003DE22 0C030024        	  1625:     cmpi.b  #$24,D3
02:0003DE26 6618            	  1626:     bne  _anon_z05_42
                            	  1627:     ; Enter method 1-a.
                            	  1628:     ;
                            	  1629:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1630:     ;
02:0003DE28 19400412        	  1631:     move.b  D0,($0412,A4)
02:0003DE2C 023C00EE        	  1632:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE30 123C0010        	  1633:     move.b  #$10,D1
02:0003DE34 D101            	  1634:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003DE36 19400084        	  1635:     move.b  D0,($0084,A4)
02:0003DE3A 7008            	  1636:     moveq   #8,D0
02:0003DE3C 19400603        	  1637:     move.b  D0,($0603,A4)
                            	  1638: _anon_z05_42:
                            	  1639:     ; This part is the same no matter if the player went
                            	  1640:     ; underground by stairs or a cave entrance.
                            	  1641:     ;
02:0003DE40 7004            	  1642:     moveq   #4,D0
02:0003DE42 19400098        	  1643:     move.b  D0,($0098,A4)
02:0003DE46 7000            	  1644:     moveq   #0,D0
02:0003DE48 19400053        	  1645:     move.b  D0,($0053,A4)
