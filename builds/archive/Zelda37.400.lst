                            	  1685: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1686:     ; Choose a distance to walk depending on the door you
                            	  1687:     ; come out of.
                            	  1688:     ;
                            	  1689:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1690:     ;
                            	  1691:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1692:     ; then you have shorter distance to cover. So use the
                            	  1693:     ; previous value as is to use indexes 0 and 1.
                            	  1694:     ;
                            	  1695:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1696:     ; to get out of the way of the wall or door.
                            	  1697:     ;
02:0003DE8E 610038FA        	  1698:     jsr     GetPassedDoorType
02:0003DE92 02000007        	  1699:     andi.b #$07,D0
02:0003DE96 6710            	  1700:     beq  _anon_z05_45
02:0003DE98 0C000005        	  1701:     cmpi.b  #$05,D0
02:0003DE9C 670A            	  1702:     beq  _anon_z05_45
02:0003DE9E 0C000006        	  1703:     cmpi.b  #$06,D0
02:0003DEA2 6704            	  1704:     beq  _anon_z05_45
02:0003DEA4 5203            	  1705:     addq.b  #1,D3
02:0003DEA6 5203            	  1706:     addq.b  #1,D3
                            	  1707: _anon_z05_45:
02:0003DEA8 41F90003D804    	  1708:     lea     (EnteringRoomRelativePositions).l,A0
