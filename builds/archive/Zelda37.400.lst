02:0003EE28 6622            	  3875:     bne  _anon_z05_95
02:0003EE2A 102C0001        	  3876:     move.b  ($0001,A4),D0
02:0003EE2E 41F90003EDFA    	  3877:     lea     (DoorwayBoundsMinOver).l,A0
02:0003EE34 12303000        	  3878:     move.b  (A0,D3.W),D1
02:0003EE38 B001            	  3879:     cmp.b   D1,D0
02:0003EE3A 6510            	  3880:     bcs  _anon_z05_95
02:0003EE3C 41F90003EDFE    	  3881:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EE42 12303000        	  3882:     move.b  (A0,D3.W),D1
02:0003EE46 B001            	  3883:     cmp.b   D1,D0
02:0003EE48 65000082        	  3884:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
