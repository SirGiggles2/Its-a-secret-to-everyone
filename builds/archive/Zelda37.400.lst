                            	  5571: 
                            	  5572: ; Params:
                            	  5573: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  5574: ; [00]: monster hotspot X
                            	  5575: ; [01]: monster hotspot Y
                            	  5576: ; [02]: bomb hotspot X
                            	  5577: ; [03]: bomb hotspot Y
                            	  5578: ;
                            	  5579: ; Returns:
                            	  5580: ; A: 0 if the bomb is in range of the monster
                            	  5581: ; Z: 1 if the bomb is in range of the monster
                            	  5582: ; [04]: horizontal distance
                            	  5583: ; [05]: vertical distance
                            	  5584: ;
                            	  5585: ; Store the positive limit in [06], and the negative one in [07].
                            	  5586: ;
                            	  5587:     even
