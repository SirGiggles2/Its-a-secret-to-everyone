                            	  8034: __far_z_04_0085:
                            	  8035:     ; The animation timer has expired. There are two choices for arming it.
                            	  8036:     ;
                            	  8037:     ; When writhing after a hit, Gleeok animates faster.
                            	  8038:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	  8039:     ; Otherwise, set a longer time ($10).
                            	  8040:     ;
02:0003BB68 7010            	  8041:     moveq   #16,D0
02:0003BB6A 7600            	  8042:     moveq   #0,D3
02:0003BB6C 162C0510        	  8043:     move.b  ($0510,A4),D3
02:0003BB70 6706            	  8044:     beq  _anon_z04_144
02:0003BB72 532C0510        	  8045:     subq.b  #1,($0510,A4)
02:0003BB76 7006            	  8046:     moveq   #6,D0
                            	  8047: _anon_z04_144:
