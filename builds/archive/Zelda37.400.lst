                            	  5435: UpdateDodongoState1_Bloated_JumpTable:
02:0003A7C4 0003A7D8        	  5436:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A7C8 0003A7D8        	  5437:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A7CC 0003A7D8        	  5438:     dc.l    UpdateDodongoState1_Bloated_Sub_Wait   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A7D0 0003A870        	  5439:     dc.l    UpdateDodongoState1_Bloated_Sub_Die   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A7D4 0003A876        	  5440:     dc.l    UpdateDodongoState1_Bloated_Sub_End   ; jump table entry (32-bit for _m68k_tablejump)
