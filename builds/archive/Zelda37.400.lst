02:000391DE 41EC03E4        	  2367:     lea     ($03E4,A4),A0
02:000391E2 12302000        	  2368:     move.b  (A0,D2.W),D1
02:000391E6 D101            	  2369:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000391E8 1B00            	  2370:     move.b  D0,-(A5)  ; PHA
                            	  2371:     ; If facing vertically, go draw mirrored.
