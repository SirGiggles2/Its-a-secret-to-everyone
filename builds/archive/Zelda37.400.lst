                            	  4291:     ; Chase while flying, as usual.
                            	  4292:     ;
02:00039F8E 61002BA0        	  4293:     jsr     Flyer_Chase
                            	  4294:     ; If timer has not expired, then
                            	  4295:     ; go see if it's time to propagate direction changes down the chain.
                            	  4296:     ;
02:00039F92 10342028        	  4297:     move.b  ($28,A4,D2.W),D0
02:00039F96 6702            	  4298:     beq.s  __far_z_04_0032
