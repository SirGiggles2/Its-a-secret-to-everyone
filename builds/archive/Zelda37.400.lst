                            	 10251: TurnTowardsPlayer8:
                            	 10252:     ; Build a direction in [00] towards the player.
                            	 10253:     ;
                            	 10254:     ; First, calculate a horizontal component:
                            	 10255:     ;
                            	 10256:     ; If   observed player X = object X, [00] := 0 (none)
                            	 10257:     ; elif observed player X > object X, [00] := 1 (right)
                            	 10258:     ; else                               [00] := 2 (left)
                            	 10259:     ;
02:0003CB50 7600            	 10260:     moveq   #0,D3
02:0003CB52 1883            	 10261:     move.b  D3,($0000,A4)
02:0003CB54 5203            	 10262:     addq.b  #1,D3
02:0003CB56 102C0061        	 10263:     move.b  ($0061,A4),D0
02:0003CB5A 12342070        	 10264:     move.b  ($70,A4,D2.W),D1
02:0003CB5E B001            	 10265:     cmp.b   D1,D0
02:0003CB60 6706            	 10266:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003CB62 6402            	 10267:     bcc  _anon_z04_175
02:0003CB64 5203            	 10268:     addq.b  #1,D3
                            	 10269: _anon_z04_175:
02:0003CB66 1883            	 10270:     move.b  D3,($0000,A4)
                            	 10271:     even
                            	 10272: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 10273:     ; Second, calculate a vertical component.
                            	 10274:     ; Combine it with the horizontal component:
                            	 10275:     ;
                            	 10276:     ; Y := 4 (down)
                            	 10277:     ; if observed player Y <> object Y then
                            	 10278:     ;   if observed player Y < object Y then
                            	 10279:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 10280:     ;   [00] := [00] | Y
                            	 10281:     ;
02:0003CB68 7601            	 10282:     moveq   #1,D3
02:0003CB6A 102C0062        	 10283:     move.b  ($0062,A4),D0
02:0003CB6E 41EC0084        	 10284:     lea     ($0084,A4),A0
02:0003CB72 12302000        	 10285:     move.b  (A0,D2.W),D1
02:0003CB76 B001            	 10286:     cmp.b   D1,D0
02:0003CB78 6710            	 10287:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003CB7A 6402            	 10288:     bcc  _anon_z04_176
02:0003CB7C 5203            	 10289:     addq.b  #1,D3
