02:00049E42 102C04CD        	  7138:     move.b  ($04CD,A4),D0
02:00049E46 02000008        	  7139:     andi.b #$08,D0
02:00049E4A 6700018A        	  7140:     beq  _L_z07_InitObject_NormalSpawn
02:00049E4E 41EC034F        	  7141:     lea     ($034F,A4),A0
02:00049E52 10302000        	  7142:     move.b  (A0,D2.W),D0
02:00049E56 0C000011        	  7143:     cmpi.b  #$11,D0
02:00049E5A 6700017A        	  7144:     beq  _L_z07_InitObject_NormalSpawn
02:00049E5E 0C000040        	  7145:     cmpi.b  #$40,D0
02:00049E62 67000172        	  7146:     beq  _L_z07_InitObject_NormalSpawn
02:00049E66 0C00001E        	  7147:     cmpi.b  #$1E,D0
02:00049E6A 6700016A        	  7148:     beq  _L_z07_InitObject_NormalSpawn
02:00049E6E 0C00002E        	  7149:     cmpi.b  #$2E,D0
02:00049E72 67000162        	  7150:     beq  _L_z07_InitObject_NormalSpawn
02:00049E76 0C000053        	  7151:     cmpi.b  #$53,D0
