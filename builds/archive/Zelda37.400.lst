02:00038E64 670000AA        	  1901:     beq  _L_z04_Burrower_AnimateDrawAndCheckCollisions_Exit
                            	  1902:     ; If is zora, and state >= 2 and < 5, then use frame image 2 or 3
                            	  1903:     ; (front or back), which was stored in ObjDir above.
                            	  1904:     ;
02:00038E68 7600            	  1905:     moveq   #0,D3
