02:00049176 6656            	  5462:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5463:     ; State $3x. Slow down.
                            	  5464:     ;
                            	  5465:     ; Reset grid offset for movement.
                            	  5466:     ;
02:00049178 7000            	  5467:     moveq   #0,D0
