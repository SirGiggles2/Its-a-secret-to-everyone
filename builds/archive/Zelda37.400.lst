                            	  7154: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7155:     ; If the "monsters from edges" long timer expired, then
                            	  7156:     ; go bring the monster in.
                            	  7157:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7158:     ;
                            	  7159:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7160:     ; residual position so enemies keep their previous-room
                            	  7161:     ; positions instead of being re-edge-spawned (matches NES).
02:00049E7E 102C004B        	  7162:     move.b  ($004B,A4),D0
02:00049E82 662E            	  7163:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7164:     ; timer == 0. Check for fresh room-entry + residual position.
02:00049E84 102C000F        	  7165:     move.b  ($000F,A4),D0
02:00049E88 0C0000FF        	  7166:     cmpi.b  #$FF,D0
02:00049E8C 662E            	  7167:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:00049E8E 41EC0070        	  7168:     lea     ($0070,A4),A0
02:00049E92 10302000        	  7169:     move.b  (A0,D2.W),D0
02:00049E96 660A            	  7170:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:00049E98 41EC0084        	  7171:     lea     ($0084,A4),A0
02:00049E9C 10302000        	  7172:     move.b  (A0,D2.W),D0
02:00049EA0 671A            	  7173:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7174:     even
                            	  7175: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:00049EA2 7001            	  7176:     moveq   #1,D0
02:00049EA4 1940004B        	  7177:     move.b  D0,($004B,A4)
02:00049EA8 41EC0492        	  7178:     lea     ($0492,A4),A0
02:00049EAC 11802000        	  7179:     move.b  D0,(A0,D2.W)
02:00049EB0 4E75            	  7180:     rts
                            	  7181:     even
