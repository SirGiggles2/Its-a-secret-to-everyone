                            	     9: ;   D2 = 6502 X  (X index register)
                            	    10: ;   D3 = 6502 Y  (Y index register)
                            	    11: ;   D4,D5 = scratch (used by indirect addressing sequences)
                            	    12: ;   D6 = scratch
                            	    13: ;   D7 = 6502 SP shadow (NES stack pointer, $0100 area)
                            	    14: ;   A4 = NES RAM base ($FF0000) — init by genesis_shell.asm
                            	    15: ;   A5 = NES stack pointer ($FF0200 initially, grows downward)
