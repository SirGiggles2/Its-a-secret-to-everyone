                            	  7906:     ; Make Link go straight in one direction on the next grid line.
                            	  7907:     ;
02:00041AD8 7600            	  7908:     moveq   #0,D3
02:00041ADA 1600            	  7909:     move.b  D0,D3
02:00041ADC 522C0057        	  7910:     addq.b  #1,($0057,A4)
                            	  7911:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7912:     ; object direction and input direction to last walkable direction
                            	  7913:     ; found, and set Link's speed.
                            	  7914:     ;
                            	  7915:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7916:     ;
02:00041AE0 7400            	  7917:     moveq   #0,D2
02:00041AE2 102C000D        	  7918:     move.b  ($000D,A4),D0
