02:00039E24 102C001D        	  4117:     move.b  ($001D,A4),D0
02:00039E28 02000007        	  4118:     andi.b #$07,D0
02:00039E2C 7600            	  4119:     moveq   #0,D3
02:00039E2E 1600            	  4120:     move.b  D0,D3
02:00039E30 41F90003CAB8    	  4121:     lea     (Directions8).l,A0
02:00039E36 10303000        	  4122:     move.b  (A0,D3.W),D0
02:00039E3A 1940009D        	  4123:     move.b  D0,($009D,A4)
02:00039E3E 19400385        	  4124:     move.b  D0,($0385,A4)
02:00039E42 102C0022        	  4125:     move.b  ($0022,A4),D0
02:00039E46 02000007        	  4126:     andi.b #$07,D0
02:00039E4A 7600            	  4127:     moveq   #0,D3
02:00039E4C 1600            	  4128:     move.b  D0,D3
02:00039E4E 41F90003CAB8    	  4129:     lea     (Directions8).l,A0
02:00039E54 10303000        	  4130:     move.b  (A0,D3.W),D0
02:00039E58 194000A2        	  4131:     move.b  D0,($00A2,A4)
02:00039E5C 1940038A        	  4132:     move.b  D0,($038A,A4)
                            	  4133:     ; Set minimum number of turns 1 for flying states.
                            	  4134:     ;
                            	  4135:     ; By setting this, the first time that a flight control routine
                            	  4136:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  4137:     ; that flying state will immediately end, and object timer
