02:0003AC5E 7600            	  6027:     moveq   #0,D3
02:0003AC60 41EC03E4        	  6028:     lea     ($03E4,A4),A0
02:0003AC64 16302000        	  6029:     move.b  (A0,D2.W),D3
02:0003AC68 5203            	  6030:     addq.b  #1,D3
02:0003AC6A 1003            	  6031:     move.b  D3,D0
