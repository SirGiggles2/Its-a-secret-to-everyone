                            	  7455: Gohma_CheckCollisions:
                            	  7456:     ; Save the boss's X coordinate.
                            	  7457:     ;
02:0003B706 10342070        	  7458:     move.b  ($70,A4,D2.W),D0
02:0003B70A 1B00            	  7459:     move.b  D0,-(A5)  ; PHA
                            	  7460:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  7461:     ; on the left side.
                            	  7462:     ;
02:0003B70C 003C0011        	  7463:     ori     #$11,CCR  ; SEC: set C+X
02:0003B710 123C0010        	  7464:     move.b  #$10,D1
02:0003B714 0A3C0010        	  7465:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B718 9101            	  7466:     subx.b  D1,D0   ; SBC #$10
