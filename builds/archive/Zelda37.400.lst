                            	  5346: __far_z_07_0078:
                            	  5347:     ; State $2x. Spark.
                            	  5348:     ;
                            	  5349:     ; Change the state to $28, and decrement animation counter.
                            	  5350:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5351:     ; (with Link, if this is a monster's boomerang).
                            	  5352:     ;
                            	  5353:     ; TODO: Why state $28?
                            	  5354:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5355:     ; start over again when spinning.
                            	  5356:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5357:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5358:     ; any drawing code depends on the minor state.
                            	  5359:     ;
02:000490BE 7028            	  5360:     moveq   #40,D0
02:000490C0 41EC00AC        	  5361:     lea     ($00AC,A4),A0
02:000490C4 11802000        	  5362:     move.b  D0,(A0,D2.W)
02:000490C8 41EC03D0        	  5363:     lea     ($03D0,A4),A0
