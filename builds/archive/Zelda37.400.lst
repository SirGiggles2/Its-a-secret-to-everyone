02:0003BB84 123C0001        	  8053:     move.b  #$01,D1
02:0003BB88 D101            	  8054:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003BB8A 02000003        	  8055:     andi.b #$03,D0
02:0003BB8E 194004E7        	  8056:     move.b  D0,($04E7,A4)
                            	  8057:     even
