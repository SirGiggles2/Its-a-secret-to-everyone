02:000402D8 6620            	  5236:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5237:     even
                            	  5238: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5239:     ; We jump here if the door type is bombable and was opened.
                            	  5240:     ; Change the provisional door face to value 9, which
                            	  5241:     ; will become the "hole in the wall".
                            	  5242:     ;
02:000402DA 7009            	  5243:     moveq   #9,D0
02:000402DC 665A            	  5244:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5245:     even
                            	  5246: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5247:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5248:     ; the mask of opened doors, because this is not a true door.
                            	  5249:     ;
02:000402DE 1B00            	  5250:     move.b  D0,-(A5)  ; PHA
02:000402E0 102C0002        	  5251:     move.b  ($0002,A4),D0
02:000402E4 4600            	  5252:     eori.b #$FF,D0
02:000402E6 122C00EE        	  5253:     move.b  ($00EE,A4),D1
02:000402EA C001            	  5254:     and.b  D1,D0
02:000402EC 194000EE        	  5255:     move.b  D0,($00EE,A4)
02:000402F0 101D            	  5256:     move.b  (A5)+,D0  ; PLA
                            	  5257:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5258:     ;
02:000402F2 0C000001        	  5259:     cmpi.b  #$01,D0
02:000402F6 6402            	  5260:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000402F8 7004            	  5261:     moveq   #4,D0
                            	  5262:     even
                            	  5263: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5264:     ; The door attribute (DA) has been mapped to a
                            	  5265:     ; provisional door face value (PF) in %A as follows:
                            	  5266:     ;
                            	  5267:     ; DA PF Meaning
                            	  5268:     ; -------------
                            	  5269:     ; 0  4  open
                            	  5270:     ; 1  1  wall
                            	  5271:     ; 2  2  false wall
                            	  5272:     ; 3  3  false wall 2
                            	  5273:     ; 4  8  bombable
                            	  5274:     ; 5  5  key
                            	  5275:     ; 6  6  key 2
                            	  5276:     ; 7  7  shutter
                            	  5277:     ;
                            	  5278:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5279:     ; has been cleared, if the type was "open" or any wall.
                            	  5280:     ;
                            	  5281:     ;
                            	  5282:     ; Save the provisional face.
02:000402FA 1B00            	  5283:     move.b  D0,-(A5)  ; PHA
                            	  5284:     ; If the current direction points to a door that has been opened,
                            	  5285:     ; then see if we need to set door flags.
                            	  5286:     ;
02:000402FC 102C00EE        	  5287:     move.b  ($00EE,A4),D0
02:00040300 122C0002        	  5288:     move.b  ($0002,A4),D1
02:00040304 C001            	  5289:     and.b  D1,D0
02:00040306 7400            	  5290:     moveq   #0,D2
02:00040308 1400            	  5291:     move.b  D0,D2
02:0004030A 101D            	  5292:     move.b  (A5)+,D0  ; PLA
02:0004030C 122C0002        	  5293:     move.b  ($0002,A4),D1
02:00040310 B401            	  5294:     cmp.b   D1,D2
02:00040312 6624            	  5295:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5296:     ; The current direction points to a door that has been opened.
                            	  5297:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5298:     ;
                            	  5299:     ;
                            	  5300:     ; Save provisional door face in Y register.
02:00040314 7600            	  5301:     moveq   #0,D3
02:00040316 1600            	  5302:     move.b  D0,D3
02:00040318 101D            	  5303:     move.b  (A5)+,D0  ; PLA
02:0004031A 1B00            	  5304:     move.b  D0,-(A5)  ; PHA
02:0004031C 7400            	  5305:     moveq   #0,D2
02:0004031E 1400            	  5306:     move.b  D0,D2
02:00040320 1003            	  5307:     move.b  D3,D0
                            	  5308:     ; If provisional door face is not for a shutter, then
                            	  5309:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5310:     ;
                            	  5311:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5312:     ;
02:00040322 0C000007        	  5313:     cmpi.b  #$07,D0
02:00040326 670E            	  5314:     beq  _anon_z05_111
02:00040328 1B00            	  5315:     move.b  D0,-(A5)  ; PHA
02:0004032A 6100DF68        	  5316:     jsr     SetDoorFlag
02:0004032E 101D            	  5317:     move.b  (A5)+,D0  ; PLA
                            	  5318:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5319:     ; then go make it 9 (open "bombable").
                            	  5320:     ; Else make it 4 (open "door").
                            	  5321:     ;
02:00040330 0C000008        	  5322:     cmpi.b  #$08,D0
02:00040334 67A4            	  5323:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5324: _anon_z05_111:
02:00040336 7004            	  5325:     moveq   #4,D0
                            	  5326:     even
                            	  5327: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5328:     ; For opened doors, the provisional door face has become:
                            	  5329:     ;
                            	  5330:     ; DA PF Meaning
                            	  5331:     ; -------------
                            	  5332:     ; 0  4  open
                            	  5333:     ; 1  1  wall
                            	  5334:     ; 2  2  false wall
                            	  5335:     ; 3  3  false wall 2
                            	  5336:     ; 4  9  bombable
                            	  5337:     ; 5  4  key
                            	  5338:     ; 6  4  key 2
                            	  5339:     ; 7  4  shutter
                            	  5340:     ;
                            	  5341:     ;
                            	  5342:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5343:     ;
02:00040338 7400            	  5344:     moveq   #0,D2
02:0004033A 142C0006        	  5345:     move.b  ($0006,A4),D2
02:0004033E 6712            	  5346:     beq  _anon_z05_112
02:00040340 7400            	  5347:     moveq   #0,D2
02:00040342 142C000B        	  5348:     move.b  ($000B,A4),D2
02:00040346 1B00            	  5349:     move.b  D0,-(A5)  ; PHA
02:00040348 6100FCC8        	  5350:     jsr     FindDoorAttrByDoorBit
02:0004034C 61001DA4        	  5351:     jsr     CalcOpenDoorwayMask
02:00040350 101D            	  5352:     move.b  (A5)+,D0  ; PLA
                            	  5353: _anon_z05_112:
                            	  5354:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5355:     ; because the visible door face is already a wall.
                            	  5356:     ;
02:00040352 0C000004        	  5357:     cmpi.b  #$04,D0
02:00040356 650000DC        	  5358:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5359:     ; For all other provisional face values, calculate:
                            	  5360:     ; door face := provisional face - 3
02:0004035A 003C0011        	  5361:     ori     #$11,CCR  ; SEC: set C+X
02:0004035E 123C0003        	  5362:     move.b  #$03,D1
02:00040362 0A3C0010        	  5363:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040366 9101            	  5364:     subx.b  D1,D0   ; SBC #$03
02:00040368 0A3C0010        	  5365:     eori    #$10,CCR  ; restore X = 6502 C
02:0004036C 7600            	  5366:     moveq   #0,D3
02:0004036E 1600            	  5367:     move.b  D0,D3
                            	  5368:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5369:     ; subtract one.
                            	  5370:     ;
02:00040370 0C030003        	  5371:     cmpi.b  #$03,D3
02:00040374 6502            	  5372:     bcs  _anon_z05_113
02:00040376 5303            	  5373:     subq.b  #1,D3
                            	  5374: _anon_z05_113:
                            	  5375:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5376:     ;
                            	  5377:     ; DT DFC DFO Meaning
                            	  5378:     ; ------------------
                            	  5379:     ; 0  1   1   open
                            	  5380:     ; 4  4   5   bombable
                            	  5381:     ; 5  2   1   key
                            	  5382:     ; 6  2   1   key 2
                            	  5383:     ; 7  3   1   shutter
                            	  5384:     ;
                            	  5385:     ;
                            	  5386:     ; Get the direction index.
02:00040378 101D            	  5387:     move.b  (A5)+,D0  ; PLA
02:0004037A 1B00            	  5388:     move.b  D0,-(A5)  ; PHA
02:0004037C 610000D0        	  5389:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5390:     ; If handling the second half, then offset to the second half
                            	  5391:     ; of the tiles.
                            	  5392:     ;
02:00040380 102C0006        	  5393:     move.b  ($0006,A4),D0
02:00040384 6618            	  5394:     bne  _anon_z05_114
02:00040386 41F90004029C    	  5395:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:0004038C 10302000        	  5396:     move.b  (A0,D2.W),D0
02:00040390 4EB90003098E    	  5397:     jsr     AddToInt16At0
02:00040396 7006            	  5398:     moveq   #6,D0
02:00040398 4EB900030996    	  5399:     jsr     AddToInt16At2
                            	  5400: _anon_z05_114:
                            	  5401:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5402:     ; Pointers will be incremented instead of Y.
02:0004039E 7600            	  5403:     moveq   #0,D3
02:000403A0 41F9000402A0    	  5404:     lea     (DirIndexToDoorColumnCount).l,A0
02:000403A6 10302000        	  5405:     move.b  (A0,D2.W),D0
02:000403AA 19400005        	  5406:     move.b  D0,($0005,A4)
                            	  5407:     even
                            	  5408: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5409:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5410:     ;
02:000403AE 101D            	  5411:     move.b  (A5)+,D0  ; PLA
02:000403B0 1B00            	  5412:     move.b  D0,-(A5)  ; PHA
02:000403B2 7400            	  5413:     moveq   #0,D2
02:000403B4 1400            	  5414:     move.b  D0,D2
                            	  5415:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5416:     ; starting from highest index down to 0:
                            	  5417:     ;
02:000403B6 41F9000402A4    	  5418:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:000403BC 10302000        	  5419:     move.b  (A0,D2.W),D0
02:000403C0 7400            	  5420:     moveq   #0,D2
02:000403C2 1400            	  5421:     move.b  D0,D2
                            	  5422:     even
                            	  5423: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:000403C4 122C0002        	  5424:     move.b  ($02,A4),D1   ; ptr lo
02:000403C8 182C0003        	  5425:     move.b  ($03,A4),D4  ; ptr hi
02:000403CC 024100FF        	  5426:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000403D0 E14C            	  5427:     lsl.w   #8,D4
02:000403D2 8841            	  5428:     or.w    D1,D4             ; D4 = NES ptr addr
02:000403D4 48C4            	  5429:     ext.l   D4
02:000403D6 D8BC00FF0000    	  5430:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000403DC 2044            	  5431:     movea.l D4,A0
02:000403DE 10303000        	  5432:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000403E2 1214            	  5433:     move.b  ($00,A4),D1   ; ptr lo
02:000403E4 182C0001        	  5434:     move.b  ($01,A4),D4  ; ptr hi
02:000403E8 024100FF        	  5435:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000403EC E14C            	  5436:     lsl.w   #8,D4
02:000403EE 8841            	  5437:     or.w    D1,D4
02:000403F0 48C4            	  5438:     ext.l   D4
02:000403F2 D8BC00FF0000    	  5439:     add.l   #NES_RAM,D4
02:000403F8 2044            	  5440:     movea.l D4,A0
02:000403FA 11803000        	  5441:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:000403FE 4EB900030992    	  5442:     jsr     Add1ToInt16At2
