                            	  4874: SpreadShot:
                            	  4875:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4876:     ;
                            	  4877:     ; The shot is spreading out.
                            	  4878:     ;
                            	  4879:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4880:     ; These will be negated appropriately for each corner.
                            	  4881:     ;
02:00048D88 41EC0098        	  4882:     lea     ($0098,A4),A0
02:00048D8C 10302000        	  4883:     move.b  (A0,D2.W),D0
02:00048D90 19400002        	  4884:     move.b  D0,($0002,A4)
02:00048D94 19400003        	  4885:     move.b  D0,($0003,A4)
                            	  4886:     ; Reset [0F] to not flip horizontally.
                            	  4887:     ;
02:00048D98 7000            	  4888:     moveq   #0,D0
02:00048D9A 1940000F        	  4889:     move.b  D0,($000F,A4)
                            	  4890:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4891:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4892:     ;
02:00048D9E 7603            	  4893:     moveq   #3,D3
                            	  4894:     even
                            	  4895: _L_z07_SpreadShot_DrawShotCorner:
02:00048DA0 1003            	  4896:     move.b  D3,D0
02:00048DA2 1B00            	  4897:     move.b  D0,-(A5)  ; PHA
                            	  4898:     ; Save offset X [02] and Y offset [03].
                            	  4899:     ;
02:00048DA4 102C0002        	  4900:     move.b  ($0002,A4),D0
02:00048DA8 1B00            	  4901:     move.b  D0,-(A5)  ; PHA
02:00048DAA 102C0003        	  4902:     move.b  ($0003,A4),D0
02:00048DAE 1B00            	  4903:     move.b  D0,-(A5)  ; PHA
                            	  4904:     ; Calculate and set sprite attributes for this corner:
                            	  4905:     ;   base attribute OR (frame counter AND 3)
                            	  4906:     ;
                            	  4907:     ; The base attribute defines how to flip the sprite.
                            	  4908:     ; The frame counter makes the shot flash by cycling each
                            	  4909:     ; palette row.
                            	  4910:     ;
02:00048DB0 102C0015        	  4911:     move.b  ($0015,A4),D0
02:00048DB4 02000003        	  4912:     andi.b #$03,D0
02:00048DB8 41F900048C94    	  4913:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048DBE 12303000        	  4914:     move.b  (A0,D3.W),D1
02:00048DC2 8001            	  4915:     or.b  D1,D0
02:00048DC4 4EB900030FCC    	  4916:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4917:     ; Add the object's X (the center of the spread) and the
                            	  4918:     ; current offset in [02] to set sprite X in [00].
                            	  4919:     ;
02:00048DCA 10342070        	  4920:     move.b  ($70,A4,D2.W),D0
02:00048DCE 023C00EE        	  4921:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048DD2 122C0002        	  4922:     move.b  ($0002,A4),D1
02:00048DD6 D101            	  4923:     addx.b  D1,D0   ; ADC $02
02:00048DD8 1880            	  4924:     move.b  D0,($0000,A4)
                            	  4925:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4926:     ; Else calculate the distance from object X to sprite X.
                            	  4927:     ;
02:00048DDA 12342070        	  4928:     move.b  ($70,A4,D2.W),D1
02:00048DDE B001            	  4929:     cmp.b   D1,D0
02:00048DE0 651A            	  4930:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048DE2 0C0000FC        	  4931:     cmpi.b  #$FC,D0
02:00048DE6 6466            	  4932:     bcc  _L_z07_SpreadShot_NextCorner
02:00048DE8 003C0011        	  4933:     ori     #$11,CCR  ; SEC: set C+X
02:00048DEC 12342070        	  4934:     move.b  ($70,A4,D2.W),D1
02:00048DF0 0A3C0010        	  4935:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048DF4 9101            	  4936:     subx.b  D1,D0   ; SBC ObjX,X
02:00048DF6 0A3C0010        	  4937:     eori    #$10,CCR  ; restore X = 6502 C
02:00048DFA 6014            	  4938:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4939: 
                            	  4940:     even
                            	  4941: _L_z07_SpreadShot_ReverseSub:
02:00048DFC 10342070        	  4942:     move.b  ($70,A4,D2.W),D0
02:00048E00 003C0011        	  4943:     ori     #$11,CCR  ; SEC: set C+X
02:00048E04 1214            	  4944:     move.b  ($0000,A4),D1
02:00048E06 0A3C0010        	  4945:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048E0A 9101            	  4946:     subx.b  D1,D0   ; SBC $00
02:00048E0C 0A3C0010        	  4947:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4948:     even
                            	  4949: _L_z07_SpreadShot_CheckDistance:
                            	  4950:     ; If distance >= $20, skip this corner.
                            	  4951:     ;
02:00048E10 0C000020        	  4952:     cmpi.b  #$20,D0
02:00048E14 6438            	  4953:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4954:     ; Add the object's Y (the center of the spread) and the
                            	  4955:     ; current offset in [03] to set sprite Y in [01].
                            	  4956:     ;
02:00048E16 41EC0084        	  4957:     lea     ($0084,A4),A0
02:00048E1A 10302000        	  4958:     move.b  (A0,D2.W),D0
02:00048E1E 023C00EE        	  4959:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048E22 122C0003        	  4960:     move.b  ($0003,A4),D1
02:00048E26 D101            	  4961:     addx.b  D1,D0   ; ADC $03
02:00048E28 19400001        	  4962:     move.b  D0,($0001,A4)
                            	  4963:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4964:     ;
02:00048E2C 7600            	  4965:     moveq   #0,D3
02:00048E2E 162C0010        	  4966:     move.b  ($0010,A4),D3
02:00048E32 670C            	  4967:     beq  _L_z07_SpreadShot_Draw
02:00048E34 0C00003E        	  4968:     cmpi.b  #$3E,D0
02:00048E38 6514            	  4969:     bcs  _L_z07_SpreadShot_NextCorner
02:00048E3A 0C0000E8        	  4970:     cmpi.b  #$E8,D0
02:00048E3E 640E            	  4971:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4972:     even
                            	  4973: _L_z07_SpreadShot_Draw:
                            	  4974:     ; Draw the corner.
                            	  4975:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4976:     ;
02:00048E40 7002            	  4977:     moveq   #2,D0
02:00048E42 1940000C        	  4978:     move.b  D0,($000C,A4)
02:00048E46 7623            	  4979:     moveq   #35,D3
02:00048E48 4EB900030EEC    	  4980:     jsr     Anim_WriteItemSprites
                            	  4981:     even
                            	  4982: _L_z07_SpreadShot_NextCorner:
                            	  4983:     ; Prepare to process the next corner.
                            	  4984:     ;
                            	  4985:     ; First, restore X offset [02] and Y offset [03].
                            	  4986:     ;
02:00048E4E 101D            	  4987:     move.b  (A5)+,D0  ; PLA
02:00048E50 19400003        	  4988:     move.b  D0,($0003,A4)
02:00048E54 101D            	  4989:     move.b  (A5)+,D0  ; PLA
02:00048E56 19400002        	  4990:     move.b  D0,($0002,A4)
                            	  4991:     ; Take turns negating X offset or Y offset for the next round.
                            	  4992:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4993:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4994:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4995:     ; - Fourth turn: doesn't matter
                            	  4996:     ;
                            	  4997:     ;
                            	  4998:     ; Get the loop index.
02:00048E5A 101D            	  4999:     move.b  (A5)+,D0  ; PLA
02:00048E5C 1B00            	  5000:     move.b  D0,-(A5)  ; PHA
02:00048E5E 7600            	  5001:     moveq   #0,D3
02:00048E60 1600            	  5002:     move.b  D0,D3
02:00048E62 0C030001        	  5003:     cmpi.b  #$01,D3
02:00048E66 6602            	  5004:     bne  _anon_z07_25
02:00048E68 7603            	  5005:     moveq   #3,D3
                            	  5006: _anon_z07_25:
02:00048E6A 10343000        	  5007:     move.b  ($00,A4,D3.W),D0
02:00048E6E 4600            	  5008:     eori.b #$FF,D0
02:00048E70 023C00EE        	  5009:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048E74 123C0001        	  5010:     move.b  #$01,D1
02:00048E78 D101            	  5011:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048E7A 19803000        	  5012:     move.b  D0,($00,A4,D3.W)
                            	  5013:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5014:     ;
02:00048E7E 101D            	  5015:     move.b  (A5)+,D0  ; PLA
02:00048E80 7600            	  5016:     moveq   #0,D3
02:00048E82 1600            	  5017:     move.b  D0,D3
02:00048E84 5303            	  5018:     subq.b  #1,D3
02:00048E86 6A00FF18        	  5019:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5020:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5021:     ;
                            	  5022:     ; Decrease the base negative offset to get farther away from
                            	  5023:     ; the center point.
                            	  5024:     ;
02:00048E8A 41EC0098        	  5025:     lea     ($0098,A4),A0
02:00048E8E 53302000        	  5026:     subq.b  #1,(A0,D2.W)
                            	  5027:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5028:     ;
                            	  5029:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5030:     ;
02:00048E92 41EC0098        	  5031:     lea     ($0098,A4),A0
02:00048E96 10302000        	  5032:     move.b  (A0,D2.W),D0
02:00048E9A 0C0000E8        	  5033:     cmpi.b  #$E8,D0
02:00048E9E 6702            	  5034:     beq.s  __far_z_07_0072
02:00048EA0 6004            	  5035:     jmp  L1F49F_Exit
                            	  5036: __far_z_07_0072:
02:00048EA2 6000FED2        	  5037:     jmp     DeactivateLinkShot
                            	  5038: 
                            	  5039:     even
                            	  5040: L1F49F_Exit:
