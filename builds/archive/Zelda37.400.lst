02:0003B656 0C0000E0        	  7349:     cmpi.b  #$E0,D0
02:0003B65A 650C            	  7350:     bcs  _L_z04_UpdateManhandla_Draw
02:0003B65C 102C0356        	  7351:     move.b  ($0356,A4),D0
