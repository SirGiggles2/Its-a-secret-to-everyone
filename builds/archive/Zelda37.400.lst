02:000494DC 102C0084        	  5927:     move.b  ($0084,A4),D0
02:000494E0 023C00EE        	  5928:     andi    #$EE,CCR  ; CLC: clear C+X
02:000494E4 41F900049406    	  5929:     lea     (PlayerToWeaponOffsetsY).l,A0
02:000494EA 12303000        	  5930:     move.b  (A0,D3.W),D1
