                            	  5044: UpdateBoomerangOrFood:
                            	  5045:     ; If state = 0, then not active. So, return.
                            	  5046:     ;
02:00048EA8 41EC00AC        	  5047:     lea     ($00AC,A4),A0
02:00048EAC 10302000        	  5048:     move.b  (A0,D2.W),D0
02:00048EB0 6602            	  5049:     bne.s  __far_z_07_0073
02:00048EB2 60F2            	  5050:     jmp  L1F49F_Exit
                            	  5051: __far_z_07_0073:
                            	  5052:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5053:     ;
02:00048EB4 E308            	  5054:     lsl.b  #1,D0   ; ASL A
02:00048EB6 6504            	  5055:     bcs.s  __far_z_07_0074
02:00048EB8 600000AA        	  5056:     jmp  UpdateArrowOrBoomerang
                            	  5057: __far_z_07_0074:
                            	  5058:     ; The object is food.
                            	  5059:     ;
                            	  5060:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5061:     ; If we reach state $83, then go deactivate the object.
                            	  5062:     ;
                            	  5063:     ; Nothing changes between the states. So, they are used as
                            	  5064:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5065:     ;
02:00048EBC 10342028        	  5066:     move.b  ($28,A4,D2.W),D0
02:00048EC0 6622            	  5067:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:00048EC2 41EC00AC        	  5068:     lea     ($00AC,A4),A0
02:00048EC6 52302000        	  5069:     addq.b  #1,(A0,D2.W)
02:00048ECA 41EC00AC        	  5070:     lea     ($00AC,A4),A0
02:00048ECE 10302000        	  5071:     move.b  (A0,D2.W),D0
02:00048ED2 0200000F        	  5072:     andi.b #$0F,D0
02:00048ED6 0C000003        	  5073:     cmpi.b  #$03,D0
02:00048EDA 674C            	  5074:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:00048EDC 103C00FF        	  5075:     move.b  #$FF,D0
02:00048EE0 19802028        	  5076:     move.b  D0,($28,A4,D2.W)
                            	  5077:     even
