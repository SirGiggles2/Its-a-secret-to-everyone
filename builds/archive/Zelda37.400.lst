                            	  2336: _L_z04_UpdateOctorock_SaveOffset:
02:000391AE 1B00            	  2337:     move.b  D0,-(A5)  ; PHA
                            	  2338:     ; Decrement the animation counter, and roll over if needed.
                            	  2339:     ;
02:000391B0 41EC03D0        	  2340:     lea     ($03D0,A4),A0
02:000391B4 53302000        	  2341:     subq.b  #1,(A0,D2.W)
02:000391B8 661E            	  2342:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:000391BA 7006            	  2343:     moveq   #6,D0
02:000391BC 41EC03D0        	  2344:     lea     ($03D0,A4),A0
02:000391C0 11802000        	  2345:     move.b  D0,(A0,D2.W)
                            	  2346:     ; There are actually 6 frame images divided into 2 sets.
                            	  2347:     ; Each set depicts one animation frame. In each set there are
                            	  2348:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2349:     ;
                            	  2350:     ; The movement frame will keep track of the base offset of
                            	  2351:     ; the current set for the current animation frame: 0 or 3.
                            	  2352:     ;
                            	  2353:     ; So, XOR the movement frame with 3.
                            	  2354:     ;
02:000391C4 E208            	  2355:     lsr.b  #1,D0   ; LSR A
02:000391C6 41EC03E4        	  2356:     lea     ($03E4,A4),A0
02:000391CA 12302000        	  2357:     move.b  (A0,D2.W),D1
02:000391CE B300            	  2358:     eor.b  D1,D0
02:000391D0 41EC03E4        	  2359:     lea     ($03E4,A4),A0
02:000391D4 11802000        	  2360:     move.b  D0,(A0,D2.W)
                            	  2361:     even
                            	  2362: _L_z04_UpdateOctorock_CalcFinalOffset:
