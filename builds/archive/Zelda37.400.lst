                            	  4846: Digdogger_Move:
                            	  4847:     ; This calculation is the same one used in Manhandla to
                            	  4848:     ; manifest the fractional speed over several frames.
                            	  4849:     ;
                            	  4850:     ; To summarize, the formula is:
                            	  4851:     ;
                            	  4852:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4853:     ;
                            	  4854:     ;   SA := SA + (SL AND $E0)
                            	  4855:     ;   [03] := SH + carry
                            	  4856:     ;
                            	  4857:     ; See 04:A28E Manhandla_Move.
                            	  4858:     ;
02:0003A34C 41EC041F        	  4859:     lea     ($041F,A4),A0
02:0003A350 10302000        	  4860:     move.b  (A0,D2.W),D0
02:0003A354 020000E0        	  4861:     andi.b #$E0,D0
02:0003A358 023C00EE        	  4862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A35C 41EC0412        	  4863:     lea     ($0412,A4),A0
02:0003A360 12302000        	  4864:     move.b  (A0,D2.W),D1
02:0003A364 D101            	  4865:     addx.b  D1,D0   ; ADC $0412,X
02:0003A366 41EC0412        	  4866:     lea     ($0412,A4),A0
02:0003A36A 11802000        	  4867:     move.b  D0,(A0,D2.W)
                            	  4868:     ; Assign (high speed byte + carry) to [03].
                            	  4869:     ;
02:0003A36E 41EC042C        	  4870:     lea     ($042C,A4),A0
02:0003A372 10302000        	  4871:     move.b  (A0,D2.W),D0
02:0003A376 123C0000        	  4872:     move.b  #$00,D1
02:0003A37A D101            	  4873:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A37C 19400003        	  4874:     move.b  D0,($0003,A4)
                            	  4875:     ; Change coordinates by the speed amount/offset in [03]
                            	  4876:     ; according to the direction.
                            	  4877:     ;
                            	  4878:     ; Start with a mask of $A1 in [02]:
                            	  4879:     ; - low nibble represents the right direction
                            	  4880:     ; - high nibble is used to set or clear carry as we go along
                            	  4881:     ;
02:0003A380 103C00A1        	  4882:     move.b  #$A1,D0
02:0003A384 19400002        	  4883:     move.b  D0,($0002,A4)
                            	  4884:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4885:     ;
02:0003A388 41EC0098        	  4886:     lea     ($0098,A4),A0
02:0003A38C 10302000        	  4887:     move.b  (A0,D2.W),D0
02:0003A390 122C0002        	  4888:     move.b  ($0002,A4),D1
02:0003A394 C200            	  4889:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A396 6712            	  4890:     beq  _L_z04_Digdogger_Move_Left
