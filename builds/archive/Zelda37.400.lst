02:0002C8FC 08000008        	  3831:     btst    #8,D0
02:0002C900 6706            	  3832:     beq.s   .cc_aqspf
02:0002C902 003C0011        	  3833:     ori     #$11,CCR
02:0002C906 4E75            	  3834:     rts
                            	  3835: .cc_aqspf:
02:0002C908 023C00EE        	  3836:     andi    #$EE,CCR
02:0002C90C 4E75            	  3837:     rts
                            	  3838: 
                            	  3839: ; SubQSpeedFromPositionFraction — D2=slot. Returns carry (C=0 if advanced).
