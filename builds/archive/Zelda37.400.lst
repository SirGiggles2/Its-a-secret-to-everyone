                            	  3207:     ; If Link's X has not changed since the last frame
                            	  3208:     ; (when Link was the target), then XOR the chase target
                            	  3209:     ; coordinates (which were Link's coordinates last frame).
                            	  3210:     ;
                            	  3211:     ; This ends up reflecting Link's coordinates across the room;
                            	  3212:     ; so that monsters chase away from him.
                            	  3213:     ;
                            	  3214:     ; But if Link's X has changed since the last frame, then
                            	  3215:     ; leave the chase target coordinates with his old coordinates.
                            	  3216:     ;
02:000482DE 102C0061        	  3217:     move.b  ($0061,A4),D0
