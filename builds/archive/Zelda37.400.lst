                            	  4077:     ; Start with no direction, no deferred bounce direction,
                            	  4078:     ; and ready to update.
                            	  4079:     ;
02:00039DC6 7000            	  4080:     moveq   #0,D0
02:00039DC8 41EC0099        	  4081:     lea     ($0099,A4),A0
02:00039DCC 11803000        	  4082:     move.b  D0,(A0,D3.W)
02:00039DD0 41EC03BD        	  4083:     lea     ($03BD,A4),A0
02:00039DD4 11803000        	  4084:     move.b  D0,(A0,D3.W)
02:00039DD8 41EC0406        	  4085:     lea     ($0406,A4),A0
02:00039DDC 11803000        	  4086:     move.b  D0,(A0,D3.W)
02:00039DE0 41EC0493        	  4087:     lea     ($0493,A4),A0
02:00039DE4 11803000        	  4088:     move.b  D0,(A0,D3.W)
                            	  4089:     ; Copy object attributes from the first monster slot.
                            	  4090:     ;
02:00039DE8 102C04C0        	  4091:     move.b  ($04C0,A4),D0
02:00039DEC 41EC04C0        	  4092:     lea     ($04C0,A4),A0
02:00039DF0 11803000        	  4093:     move.b  D0,(A0,D3.W)
                            	  4094:     ; Copy HP from the first monster slot.
                            	  4095:     ;
02:00039DF4 102C0486        	  4096:     move.b  ($0486,A4),D0
02:00039DF8 41EC0486        	  4097:     lea     ($0486,A4),A0
02:00039DFC 11803000        	  4098:     move.b  D0,(A0,D3.W)
                            	  4099:     ; Start with flying speed $80, and in flying state 2.
                            	  4100:     ;
02:00039E00 103C0080        	  4101:     move.b  #$80,D0
02:00039E04 41EC0420        	  4102:     lea     ($0420,A4),A0
02:00039E08 11803000        	  4103:     move.b  D0,(A0,D3.W)
02:00039E0C 7002            	  4104:     moveq   #2,D0
02:00039E0E 41EC0445        	  4105:     lea     ($0445,A4),A0
02:00039E12 11803000        	  4106:     move.b  D0,(A0,D3.W)
02:00039E16 7041            	  4107:     moveq   #65,D0
02:00039E18 41EC0350        	  4108:     lea     ($0350,A4),A0
02:00039E1C 11803000        	  4109:     move.b  D0,(A0,D3.W)
                            	  4110:     ; Bottom of the loop.
                            	  4111:     ;
02:00039E20 5303            	  4112:     subq.b  #1,D3
02:00039E22 6A90            	  4113:     bpl  _anon_z04_77
                            	  4114:     ; Choose a random 8-way direction for the head segments
                            	  4115:     ; in slots 4 and 9.
