                            	  4212:     ; to reverse direction.
                            	  4213:     ;
02:00048918 41EC04BF        	  4214:     lea     ($04BF,A4),A0
02:0004891C 10302000        	  4215:     move.b  (A0,D2.W),D0
02:00048920 02000010        	  4216:     andi.b #$10,D0
02:00048924 6702            	  4217:     beq.s  __far_z_07_0054
02:00048926 60D4            	  4218:     jmp  Reverse
