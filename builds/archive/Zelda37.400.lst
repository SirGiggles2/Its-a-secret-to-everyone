02:0003DEB2 19400394        	  1712:     move.b  D0,($0394,A4)
02:0003DEB6 61003866        	  1713:     jsr     SetupObjRoomBounds
                            	  1714:     ; Set current object slot variable to $B, to be ready for the
                            	  1715:     ; first frame of mode 5. So, that it begins updating objects
                            	  1716:     ; at slot $B.
