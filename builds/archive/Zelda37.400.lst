                            	  7388:     even
                            	  7389: Gohma_AnimateAndDraw:
02:0003B692 1B00            	  7390:     move.b  D0,-(A5)  ; PHA
02:0003B694 4EB900049A80    	  7391:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B69A 6164            	  7392:     jsr     Gohma_SetSpriteAttributes
02:0003B69C 101D            	  7393:     move.b  (A5)+,D0  ; PLA
02:0003B69E 4EB900030CD6    	  7394:     jsr     DrawObjectMirrored
02:0003B6A4 7010            	  7395:     moveq   #16,D0
02:0003B6A6 4EB900049A7A    	  7396:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7397:     ; Draw the right legs.
                            	  7398:     ;
02:0003B6AC 7601            	  7399:     moveq   #1,D3
02:0003B6AE 6102            	  7400:     jsr     Gohma_DrawLegsOneSide
                            	  7401:     ; Draw the left legs.
                            	  7402:     ;
02:0003B6B0 7600            	  7403:     moveq   #0,D3
                            	  7404: ; Params:
                            	  7405: ; Y: side: 0 for left, 1 for right
                            	  7406: ;
                            	  7407: ; Add the horizontal offset for the current side to Gohma's X to
                            	  7408: ; store the sprite's X in [00].
                            	  7409: ;
                            	  7410:     even
                            	  7411: Gohma_DrawLegsOneSide:
02:0003B6B2 10342070        	  7412:     move.b  ($70,A4,D2.W),D0
02:0003B6B6 023C00EE        	  7413:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6BA 41F90003B690    	  7414:     lea     (GohmaLegOffsetsX).l,A0
02:0003B6C0 12303000        	  7415:     move.b  (A0,D3.W),D1
02:0003B6C4 D101            	  7416:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B6C6 1880            	  7417:     move.b  D0,($0000,A4)
                            	  7418:     ; The object's Y is the sprite's.
                            	  7419:     ;
02:0003B6C8 41EC0084        	  7420:     lea     ($0084,A4),A0
02:0003B6CC 10302000        	  7421:     move.b  (A0,D2.W),D0
02:0003B6D0 19400001        	  7422:     move.b  D0,($0001,A4)
02:0003B6D4 612A            	  7423:     jsr     Gohma_SetSpriteAttributes
                            	  7424:     ; There are only two frame images for legs: left and right.
                            	  7425:     ; There are two animation frames. They are animated as follows:
                            	  7426:     ;
                            	  7427:     ; Frame 0:
                            	  7428:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  7429:     ; horizontal flipping = frame number = 0
                            	  7430:     ; 
                            	  7431:     ; Frame 1:
                            	  7432:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  7433:     ; horizontal flipping = frame number = 1
                            	  7434:     ;
02:0003B6D6 4EB900049A52    	  7435:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B6DC 1003            	  7436:     move.b  D3,D0
02:0003B6DE 023C00EE        	  7437:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6E2 41EC03E4        	  7438:     lea     ($03E4,A4),A0
02:0003B6E6 12302000        	  7439:     move.b  (A0,D2.W),D1
02:0003B6EA D101            	  7440:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B6EC 02000001        	  7441:     andi.b #$01,D0
02:0003B6F0 023C00EE        	  7442:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6F4 123C0004        	  7443:     move.b  #$04,D1
02:0003B6F8 D101            	  7444:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B6FA 4EF900030CDA    	  7445:     jmp     DrawObjectNotMirrored
                            	  7446: 
                            	  7447: ; Returns:
                            	  7448: ; [04]: left side sprite attributes
                            	  7449: ; [05]: right side sprite attributes
                            	  7450: ;
                            	  7451:     even
