                            	  5642: AnimateBoomerangAndCheckCollision:
                            	  5643:     ; Decrement animation counter; and when it reaches 0:
                            	  5644:     ; 1. arm it again for 2 frames
                            	  5645:     ; 2. advance the minor state within a cycle of 8
                            	  5646:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5647:     ;
02:000492B8 41EC03D0        	  5648:     lea     ($03D0,A4),A0
02:000492BC 53302000        	  5649:     subq.b  #1,(A0,D2.W)
02:000492C0 6702            	  5650:     beq.s  __far_z_07_0081
02:000492C2 6036            	  5651:     jmp  DrawBoomerangAndCheckCollision
                            	  5652: __far_z_07_0081:
