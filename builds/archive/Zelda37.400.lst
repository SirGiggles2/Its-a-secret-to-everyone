02:0003ED3A 2044            	  3721:     movea.l D4,A0
02:0003ED3C 10303000        	  3722:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003ED40 020000F8        	  3723:     andi.b #$F8,D0
02:0003ED44 1214            	  3724:     move.b  ($00,A4),D1   ; ptr lo
02:0003ED46 182C0001        	  3725:     move.b  ($01,A4),D4  ; ptr hi
02:0003ED4A 024100FF        	  3726:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003ED4E E14C            	  3727:     lsl.w   #8,D4
02:0003ED50 8841            	  3728:     or.w    D1,D4
02:0003ED52 48C4            	  3729:     ext.l   D4
02:0003ED54 D8BC00FF0000    	  3730:     add.l   #NES_RAM,D4
02:0003ED5A 2044            	  3731:     movea.l D4,A0
02:0003ED5C 11803000        	  3732:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
