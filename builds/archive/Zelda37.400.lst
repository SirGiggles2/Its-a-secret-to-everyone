02:00038E6E 16302000        	  1907:     move.b  (A0,D2.W),D3
02:00038E72 0C030011        	  1908:     cmpi.b  #$11,D3
02:00038E76 6620            	  1909:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038E78 7600            	  1910:     moveq   #0,D3
02:00038E7A 41EC00AC        	  1911:     lea     ($00AC,A4),A0
02:00038E7E 16302000        	  1912:     move.b  (A0,D2.W),D3
02:00038E82 0C030002        	  1913:     cmpi.b  #$02,D3
02:00038E86 6510            	  1914:     bcs  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038E88 0C030005        	  1915:     cmpi.b  #$05,D3
02:00038E8C 640A            	  1916:     bcc  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038E8E 41EC0098        	  1917:     lea     ($0098,A4),A0
02:00038E92 10302000        	  1918:     move.b  (A0,D2.W),D0
