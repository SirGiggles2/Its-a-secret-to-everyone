02:0002C91A 588F            	  3846:     addq.l  #4,SP
02:0002C91C 08000008        	  3847:     btst    #8,D0
02:0002C920 6706            	  3848:     beq.s   .cc_sqspf
02:0002C922 003C0011        	  3849:     ori     #$11,CCR
02:0002C926 4E75            	  3850:     rts
                            	  3851: .cc_sqspf:
