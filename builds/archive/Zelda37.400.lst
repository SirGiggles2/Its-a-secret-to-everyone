                            	  3537: FindNextEdgeSpawnCell:
                            	  3538:     ; Load [0A] with the value before the call.
                            	  3539:     ;
02:0003EBD2 102C0525        	  3540:     move.b  ($0525,A4),D0
02:0003EBD6 1940000A        	  3541:     move.b  D0,($000A,A4)
                            	  3542:     even
                            	  3543: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3544:     ; Loop to look for a place to spawn a monster from the edge
                            	  3545:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3546:     ;
                            	  3547:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3548:     ; We'll move down $10 pixels.
                            	  3549:     ;
02:0003EBDA 7610            	  3550:     moveq   #16,D3
02:0003EBDC 102C000A        	  3551:     move.b  ($000A,A4),D0
02:0003EBE0 0200000F        	  3552:     andi.b #$0F,D0
02:0003EBE4 670A            	  3553:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3554:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3555:     ; Don't move vertically.
                            	  3556:     ;
02:0003EBE6 163C00F0        	  3557:     move.b  #$F0,D3
02:0003EBEA 0C00000F        	  3558:     cmpi.b  #$0F,D0
02:0003EBEE 6610            	  3559:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3560:     even
                            	  3561: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3562:     ; Else low nibble = $F. We're at the right edge,
                            	  3563:     ; and we'll move up $10 pixels.
                            	  3564:     ;
02:0003EBF0 1003            	  3565:     move.b  D3,D0
02:0003EBF2 023C00EE        	  3566:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EBF6 122C000A        	  3567:     move.b  ($000A,A4),D1
02:0003EBFA D101            	  3568:     addx.b  D1,D0   ; ADC $0A
02:0003EBFC 1940000A        	  3569:     move.b  D0,($000A,A4)
                            	  3570:     even
                            	  3571: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3572:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3573:     ; Move right one pixel.
                            	  3574:     ;
02:0003EC00 102C000A        	  3575:     move.b  ($000A,A4),D0
02:0003EC04 020000F0        	  3576:     andi.b #$F0,D0
02:0003EC08 0C0000E0        	  3577:     cmpi.b  #$E0,D0
02:0003EC0C 6606            	  3578:     bne  _anon_z05_88
02:0003EC0E 522C000A        	  3579:     addq.b  #1,($000A,A4)
02:0003EC12 600A            	  3580:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3581: 
                            	  3582: _anon_z05_88:
                            	  3583:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3584:     ; Dont' move horizontally.
                            	  3585:     ;
02:0003EC14 0C000040        	  3586:     cmpi.b  #$40,D0
02:0003EC18 6604            	  3587:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3588:     ; Else high nibble = 4. We're at the top edge.
                            	  3589:     ; Move left 1 pixel.
                            	  3590:     ;
02:0003EC1A 532C000A        	  3591:     subq.b  #1,($000A,A4)
                            	  3592:     even
                            	  3593: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3594:     ; Time to get the address of the column.
                            	  3595:     ; Starting at the top of the leftmost column.
                            	  3596:     ;
02:0003EC1E 61002698        	  3597:     jsr     FetchTileMapAddr
02:0003EC22 7005            	  3598:     moveq   #5,D0
02:0003EC24 4EB90002A9FA    	  3599:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3600:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3601:     ; in order to point to the column we want.
                            	  3602:     ;
02:0003EC2A 102C000A        	  3603:     move.b  ($000A,A4),D0
02:0003EC2E 0200000F        	  3604:     andi.b #$0F,D0
02:0003EC32 7600            	  3605:     moveq   #0,D3
02:0003EC34 1600            	  3606:     move.b  D0,D3
02:0003EC36 670C            	  3607:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3608: _anon_z05_89:
02:0003EC38 702C            	  3609:     moveq   #44,D0
02:0003EC3A 4EB90003098E    	  3610:     jsr     AddToInt16At0
02:0003EC40 5303            	  3611:     subq.b  #1,D3
02:0003EC42 66F4            	  3612:     bne  _anon_z05_89
                            	  3613:     even
                            	  3614: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3615:     ; Turn the row part of [0A] into a tile index.
                            	  3616:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3617:     ;
02:0003EC44 102C000A        	  3618:     move.b  ($000A,A4),D0
02:0003EC48 020000F0        	  3619:     andi.b #$F0,D0
02:0003EC4C 003C0011        	  3620:     ori     #$11,CCR  ; SEC: set C+X
02:0003EC50 123C0040        	  3621:     move.b  #$40,D1
02:0003EC54 0A3C0010        	  3622:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EC58 9101            	  3623:     subx.b  D1,D0   ; SBC #$40
02:0003EC5A 0A3C0010        	  3624:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EC5E E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:0003EC60 E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:0003EC62 E208            	  3627:     lsr.b  #1,D0   ; LSR A
02:0003EC64 7600            	  3628:     moveq   #0,D3
02:0003EC66 1600            	  3629:     move.b  D0,D3
                            	  3630:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3631:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3632:     ; when coming in from the edges.
                            	  3633:     ;
02:0003EC68 1214            	  3634:     move.b  ($00,A4),D1   ; ptr lo
02:0003EC6A 182C0001        	  3635:     move.b  ($01,A4),D4  ; ptr hi
02:0003EC6E 024100FF        	  3636:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003EC72 E14C            	  3637:     lsl.w   #8,D4
02:0003EC74 8841            	  3638:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003EC76 48C4            	  3639:     ext.l   D4
02:0003EC78 D8BC00FF0000    	  3640:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003EC7E 2044            	  3641:     movea.l D4,A0
02:0003EC80 10303000        	  3642:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003EC84 0C000084        	  3643:     cmpi.b  #$84,D0
02:0003EC88 650E            	  3644:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3645:     ; Bottom of the loop.
                            	  3646:     ; If you reach the original cell, then stop.
                            	  3647:     ;
02:0003EC8A 102C000A        	  3648:     move.b  ($000A,A4),D0
02:0003EC8E 122C0525        	  3649:     move.b  ($0525,A4),D1
02:0003EC92 B001            	  3650:     cmp.b   D1,D0
02:0003EC94 6600FF44        	  3651:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3652:     even
                            	  3653: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3654:     ; Set the spawn cell to the one we found.
                            	  3655:     ;
02:0003EC98 102C000A        	  3656:     move.b  ($000A,A4),D0
02:0003EC9C 19400525        	  3657:     move.b  D0,($0525,A4)
02:0003ECA0 4E75            	  3658:     rts
