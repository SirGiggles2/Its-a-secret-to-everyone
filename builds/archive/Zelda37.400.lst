02:00049A9A 102C00AC        	  6786:     move.b  ($00AC,A4),D0
02:00049A9E 0200000F        	  6787:     andi.b #$0F,D0
02:00049AA2 6618            	  6788:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
