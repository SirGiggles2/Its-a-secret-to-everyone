                            	  7294: _anon_z04_111:
                            	  7295:     ; Store in [00] the animation frame that you get from the frame accumulator:
                            	  7296:     ; frame := ((accumulator AND $10) >> 4
                            	  7297:     ;
02:0003B5FE 41EC0451        	  7298:     lea     ($0451,A4),A0
02:0003B602 10302000        	  7299:     move.b  (A0,D2.W),D0
02:0003B606 02000010        	  7300:     andi.b #$10,D0
02:0003B60A E208            	  7301:     lsr.b  #1,D0   ; LSR A
02:0003B60C E208            	  7302:     lsr.b  #1,D0   ; LSR A
02:0003B60E E208            	  7303:     lsr.b  #1,D0   ; LSR A
02:0003B610 E208            	  7304:     lsr.b  #1,D0   ; LSR A
02:0003B612 1880            	  7305:     move.b  D0,($0000,A4)
                            	  7306:     ; Copy the animation frame bit into the "frame image and
                            	  7307:     ; sprite attributes" byte.
                            	  7308:     ;
02:0003B614 41EC0478        	  7309:     lea     ($0478,A4),A0
02:0003B618 10302000        	  7310:     move.b  (A0,D2.W),D0
02:0003B61C 020000FE        	  7311:     andi.b #$FE,D0
02:0003B620 1214            	  7312:     move.b  ($0000,A4),D1
