                            	  7188: _L_z07_InitObject_InitMonsterFromEdge:
02:00049EBC 7400            	  7189:     moveq   #0,D2
02:00049EBE 142C0340        	  7190:     move.b  ($0340,A4),D2
                            	  7191:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7192:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7193:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7194:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7195:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7196:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7197:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7198:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7199:     ; corrupting them and causing a deterministic address-error
                            	  7200:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7201:     ; identified by Codex static review.)
                            	  7202: _L_z07_P47_pre_check:
02:00049EC2 102C0525        	  7203:     move.b  ($0525,A4),D0
02:00049EC6 020000F0        	  7204:     andi.b  #$F0,D0
02:00049ECA 0C000040        	  7205:     cmpi.b  #$40,D0
02:00049ECE 6506            	  7206:     blo     _L_z07_P47_pre_snap
02:00049ED0 0C0000E0        	  7207:     cmpi.b  #$E0,D0
02:00049ED4 6506            	  7208:     blo     _L_z07_P47_pre_ok
                            	  7209: _L_z07_P47_pre_snap:
02:00049ED6 197C00480525    	  7210:     move.b  #$48,($0525,A4)
                            	  7211: _L_z07_P47_pre_ok:
02:00049EDC 7005            	  7212:     moveq   #5,D0
02:00049EDE 610004F4        	  7213:     jsr     SwitchBank
02:00049EE2 4EB90003EBD2    	  7214:     jsr     FindNextEdgeSpawnCell
                            	  7215:     ; Post-walk 1: bottom-edge snap.
02:00049EE8 102C0525        	  7216:     move.b  ($0525,A4),D0
02:00049EEC 020000F0        	  7217:     andi.b  #$F0,D0
02:00049EF0 0C0000E0        	  7218:     cmpi.b  #$E0,D0
02:00049EF4 660C            	  7219:     bne     _L_z07_P47_post1_ok
02:00049EF6 197C00480525    	  7220:     move.b  #$48,($0525,A4)
02:00049EFC 4EB90003EBD2    	  7221:     jsr     FindNextEdgeSpawnCell
                            	  7222: _L_z07_P47_post1_ok:
                            	  7223:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7224:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:00049F02 7600            	  7225:     moveq   #0,D3
02:00049F04 162C0525        	  7226:     move.b  ($0525,A4),D3
02:00049F08 0243000F        	  7227:     andi.w  #$000F,D3
02:00049F0C C6FC002C        	  7228:     mulu.w  #44,D3
02:00049F10 203C00FF6530    	  7229:     move.l  #$FF6530,D0
02:00049F16 D083            	  7230:     add.l   D3,D0
02:00049F18 7600            	  7231:     moveq   #0,D3
02:00049F1A 162C0525        	  7232:     move.b  ($0525,A4),D3
02:00049F1E E84B            	  7233:     lsr.w   #4,D3
02:00049F20 5943            	  7234:     subi.w  #4,D3
02:00049F22 E34B            	  7235:     lsl.w   #1,D3
02:00049F24 D083            	  7236:     add.l   D3,D0
02:00049F26 2040            	  7237:     movea.l D0,A0
02:00049F28 1010            	  7238:     move.b  (A0),D0
02:00049F2A 0C000084        	  7239:     cmpi.b  #$84,D0
02:00049F2E 6544            	  7240:     blo     _L_z07_P47_post2_ok
                            	  7241:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7242:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7243:     ; writes to the $05xx region.
02:00049F30 7800            	  7244:     moveq   #0,D4
                            	  7245: _L_z07_P47_fb_loop:
02:00049F32 41FAE574        	  7246:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049F36 12304000        	  7247:     move.b  (A0,D4.W),D1
02:00049F3A 19410525        	  7248:     move.b  D1,($0525,A4)
                            	  7249:     ; Validate fallback cell walkable.
02:00049F3E 7600            	  7250:     moveq   #0,D3
02:00049F40 1601            	  7251:     move.b  D1,D3
02:00049F42 0243000F        	  7252:     andi.w  #$000F,D3
02:00049F46 C6FC002C        	  7253:     mulu.w  #44,D3
02:00049F4A 203C00FF6530    	  7254:     move.l  #$FF6530,D0
02:00049F50 D083            	  7255:     add.l   D3,D0
02:00049F52 7600            	  7256:     moveq   #0,D3
02:00049F54 1601            	  7257:     move.b  D1,D3
02:00049F56 E84B            	  7258:     lsr.w   #4,D3
02:00049F58 5943            	  7259:     subi.w  #4,D3
02:00049F5A E34B            	  7260:     lsl.w   #1,D3
02:00049F5C D083            	  7261:     add.l   D3,D0
02:00049F5E 2040            	  7262:     movea.l D0,A0
02:00049F60 0C100084        	  7263:     cmpi.b  #$84,(A0)
02:00049F64 650E            	  7264:     blo     _L_z07_P47_post2_ok
02:00049F66 5204            	  7265:     addq.b  #1,D4
02:00049F68 0C040008        	  7266:     cmpi.b  #8,D4
02:00049F6C 65C4            	  7267:     blo     _L_z07_P47_fb_loop
                            	  7268:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7269:     ; rather than looping).
02:00049F6E 197C00480525    	  7270:     move.b  #$48,($0525,A4)
                            	  7271: _L_z07_P47_post2_ok:
                            	  7272:     ; Extract and set the monster's location.
                            	  7273:     ;
02:00049F74 102C0525        	  7274:     move.b  ($0525,A4),D0
                            	  7275:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7276:     ;
02:00049F78 1B00            	  7277:     move.b  D0,-(A5)  ; PHA
02:00049F7A E308            	  7278:     lsl.b  #1,D0   ; ASL A
02:00049F7C E308            	  7279:     lsl.b  #1,D0   ; ASL A
02:00049F7E E308            	  7280:     lsl.b  #1,D0   ; ASL A
02:00049F80 E308            	  7281:     lsl.b  #1,D0   ; ASL A
02:00049F82 19802070        	  7282:     move.b  D0,($70,A4,D2.W)
                            	  7283:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7284:     ;
02:00049F86 101D            	  7285:     move.b  (A5)+,D0  ; PLA
02:00049F88 020000F0        	  7286:     andi.b #$F0,D0
02:00049F8C 003C0011        	  7287:     ori     #$11,CCR  ; SEC: set C+X
02:00049F90 123C0003        	  7288:     move.b  #$03,D1
02:00049F94 0A3C0010        	  7289:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049F98 9101            	  7290:     subx.b  D1,D0   ; SBC #$03
02:00049F9A 0A3C0010        	  7291:     eori    #$10,CCR  ; restore X = 6502 C
02:00049F9E 41EC0084        	  7292:     lea     ($0084,A4),A0
02:00049FA2 11802000        	  7293:     move.b  D0,(A0,D2.W)
                            	  7294:     ; Set the monsters-from-edges long timer to a random value
                            	  7295:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7296:     ;
02:00049FA6 10342019        	  7297:     move.b  ($19,A4,D2.W),D0
02:00049FAA 02000003        	  7298:     andi.b #$03,D0
02:00049FAE 023C00EE        	  7299:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049FB2 123C0002        	  7300:     move.b  #$02,D1
02:00049FB6 D101            	  7301:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00049FB8 1940004B        	  7302:     move.b  D0,($004B,A4)
                            	  7303:     ; If the distance to Link is too close to Link, then
                            	  7304:     ; go flag the monster uninitialized again, so we can
                            	  7305:     ; try to spawn it again next time.
                            	  7306:     ;
02:00049FBC 7005            	  7307:     moveq   #5,D0
02:00049FBE 61000414        	  7308:     jsr     SwitchBank
02:00049FC2 4EB90003E1E2    	  7309:     jsr     IsDistanceSafeToSpawn
02:00049FC8 6500FEB4        	  7310:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7311:     ; OK to spawn.
                            	  7312:     ; In this situation, monsters don't spawn from a cloud.
                            	  7313:     ;
02:00049FCC 7000            	  7314:     moveq   #0,D0
02:00049FCE 41EC0405        	  7315:     lea     ($0405,A4),A0
02:00049FD2 11802000        	  7316:     move.b  D0,(A0,D2.W)
                            	  7317:     even
                            	  7318: _L_z07_InitObject_NormalSpawn:
02:00049FD6 7004            	  7319:     moveq   #4,D0
02:00049FD8 610003FA        	  7320:     jsr     SwitchBank
                            	  7321:     ; For monsters that spawn in a cloud, set their start time to
                            	  7322:     ; the same value as the object slot; so that they all start
                            	  7323:     ; moving at different times.
                            	  7324:     ;
