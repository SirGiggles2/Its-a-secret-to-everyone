                            	  1381: _anon_z04_34:
02:00038AF4 7020            	  1382:     moveq   #32,D0
                            	  1383: ; Params:
                            	  1384: ; A: q-speed of the monster
                            	  1385: ; Y: shot object type
                            	  1386: ;
                            	  1387: ; [01] holds the q-speed of the monster
                            	  1388:     even
                            	  1389: _TryShooting:
02:00038AF6 19400001        	  1390:     move.b  D0,($0001,A4)
                            	  1391:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  1392:     ;
02:00038AFA 41EC034F        	  1393:     lea     ($034F,A4),A0
02:00038AFE 10302000        	  1394:     move.b  (A0,D2.W),D0
02:00038B02 0C000003        	  1395:     cmpi.b  #$03,D0
02:00038B06 6726            	  1396:     beq  _L_z04__TryShooting_TryShootingNow
02:00038B08 0C000001        	  1397:     cmpi.b  #$01,D0
02:00038B0C 6720            	  1398:     beq  _L_z04__TryShooting_TryShootingNow
02:00038B0E 0C000009        	  1399:     cmpi.b  #$09,D0
02:00038B12 671A            	  1400:     beq  _L_z04__TryShooting_TryShootingNow
02:00038B14 0C00000A        	  1401:     cmpi.b  #$0A,D0
02:00038B18 6714            	  1402:     beq  _L_z04__TryShooting_TryShootingNow
02:00038B1A 41EC0451        	  1403:     lea     ($0451,A4),A0
02:00038B1E 10302000        	  1404:     move.b  (A0,D2.W),D0
02:00038B22 660A            	  1405:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1406:     ; and a random value < $F8, then return.
                            	  1407:     ;
02:00038B24 10342018        	  1408:     move.b  ($18,A4,D2.W),D0
02:00038B28 0C0000F8        	  1409:     cmpi.b  #$F8,D0
02:00038B2C 656C            	  1410:     bcs  _L_z04__TryShooting_Exit
                            	  1411:     even
                            	  1412: _L_z04__TryShooting_TryShootingNow:
                            	  1413:     ; Summary
                            	  1414:     ;
                            	  1415:     ; if temporarily invincible then
                            	  1416:     ;   shoot timer := 0
                            	  1417:     ; elif shoot timer > 0 then
                            	  1418:     ;   decrement shoot timer
                            	  1419:     ; elif wants to shoot then
                            	  1420:     ;   shoot timer := $30
                            	  1421:     ;
                            	  1422:     ; qspeed := [01]
                            	  1423:     ;
                            	  1424:     ; if shoot timer <> 0 then
                            	  1425:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1426:     ;     shoot
                            	  1427:     ;     if succeeded then
                            	  1428:     ;       shoot timer := 0
                            	  1429:     ;       qspeed := 0
                            	  1430:     ;   else
                            	  1431:     ;     qspeed := 0
                            	  1432:     ;
                            	  1433:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038B2E 102C0001        	  1434:     move.b  ($0001,A4),D0
02:00038B32 1883            	  1435:     move.b  D3,($0000,A4)
02:00038B34 1B00            	  1436:     move.b  D0,-(A5)  ; PHA
02:00038B36 7600            	  1437:     moveq   #0,D3
                            	  1438:     ; If not temporarily invincible,
                            	  1439:     ;
02:00038B38 41EC04F0        	  1440:     lea     ($04F0,A4),A0
02:00038B3C 10302000        	  1441:     move.b  (A0,D2.W),D0
02:00038B40 661A            	  1442:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1443:     ; then Y := shoot timer - 1
                            	  1444:     ;
02:00038B42 7600            	  1445:     moveq   #0,D3
02:00038B44 41EC0451        	  1446:     lea     ($0451,A4),A0
02:00038B48 16302000        	  1447:     move.b  (A0,D2.W),D3
02:00038B4C 5303            	  1448:     subq.b  #1,D3
                            	  1449:     ; If Y register < 0, then shoot timer is 0.
                            	  1450:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1451:     ; Else go set a non-zero speed and return.
                            	  1452:     ;
02:00038B4E 6A0C            	  1453:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038B50 41EC0412        	  1454:     lea     ($0412,A4),A0
02:00038B54 10302000        	  1455:     move.b  (A0,D2.W),D0
02:00038B58 6736            	  1456:     beq  _L_z04__TryShooting_SetSpeed
02:00038B5A 7630            	  1457:     moveq   #48,D3
                            	  1458:     even
                            	  1459: _L_z04__TryShooting_SetShootTimer:
                            	  1460:     ; shoot timer := Y
                            	  1461:     ;
02:00038B5C 1003            	  1462:     move.b  D3,D0
02:00038B5E 41EC0451        	  1463:     lea     ($0451,A4),A0
02:00038B62 11802000        	  1464:     move.b  D0,(A0,D2.W)
                            	  1465:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  1466:     ;
02:00038B66 6728            	  1467:     beq  _L_z04__TryShooting_SetSpeed
                            	  1468:     ; shoot timer <> 0
                            	  1469:     ; If shoot timer <> $10, then go set a zero speed.
                            	  1470:     ;
02:00038B68 0C030010        	  1471:     cmpi.b  #$10,D3
02:00038B6C 661C            	  1472:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1473:     ; If we have the magic clock, or the monster is stunned, then
                            	  1474:     ; go set a zero speed.
                            	  1475:     ;
02:00038B6E 102C066C        	  1476:     move.b  ($066C,A4),D0
02:00038B72 1234203D        	  1477:     move.b  ($3D,A4,D2.W),D1
02:00038B76 8001            	  1478:     or.b  D1,D0
02:00038B78 6610            	  1479:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1480:     ; Shoot.
                            	  1481:     ;
02:00038B7A 1014            	  1482:     move.b  ($0000,A4),D0
02:00038B7C 611E            	  1483:     jsr     _ShootIfWanted2
                            	  1484:     ; If it failed, go set a non-zero speed.
                            	  1485:     ;
02:00038B7E 6510            	  1486:     bcs  _L_z04__TryShooting_SetSpeed
                            	  1487:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  1488:     ;
02:00038B80 7000            	  1489:     moveq   #0,D0
02:00038B82 41EC0412        	  1490:     lea     ($0412,A4),A0
02:00038B86 11802000        	  1491:     move.b  D0,(A0,D2.W)
                            	  1492:     even
                            	  1493: _L_z04__TryShooting_ZeroSpeed:
02:00038B8A 101D            	  1494:     move.b  (A5)+,D0  ; PLA
02:00038B8C 7000            	  1495:     moveq   #0,D0
02:00038B8E 1B00            	  1496:     move.b  D0,-(A5)  ; PHA
                            	  1497:     even
                            	  1498: _L_z04__TryShooting_SetSpeed:
                            	  1499:     ; Set the speed to whatever was determined: 0 or the value passed in [01].
                            	  1500:     ;
02:00038B90 101D            	  1501:     move.b  (A5)+,D0  ; PLA
02:00038B92 41EC03BC        	  1502:     lea     ($03BC,A4),A0
02:00038B96 11802000        	  1503:     move.b  D0,(A0,D2.W)
                            	  1504:     even
                            	  1505: _L_z04__TryShooting_Exit:
02:00038B9A 4E75            	  1506:     rts
                            	  1507: 
                            	  1508: ; Params:
                            	  1509: ; A: shot object type
                            	  1510: ; X: shooter object index
                            	  1511: ;
                            	  1512: ; Returns:
                            	  1513: ; C: 1 if succeeded
                            	  1514: ; Y: shot slot
                            	  1515: ;
                            	  1516:     even
                            	  1517: _ShootIfWanted2:
02:00038B9C 61003E32        	  1518:     jsr     _ShootIfWanted
