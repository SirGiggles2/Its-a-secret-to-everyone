02:0003A1C2 52302000        	  4670:     addq.b  #1,(A0,D2.W)
02:0003A1C6 41EC0478        	  4671:     lea     ($0478,A4),A0
02:0003A1CA 10302000        	  4672:     move.b  (A0,D2.W),D0
02:0003A1CE 0C000004        	  4673:     cmpi.b  #$04,D0
02:0003A1D2 659E            	  4674:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
