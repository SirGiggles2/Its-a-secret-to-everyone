02:00035128 522C050B        	  4823:     addq.b  #1,($050B,A4)
                            	  4824: _anon_z02_38:
02:0003512C 102C00FC        	  4825:     move.b  ($00FC,A4),D0
02:00035130 123C0000        	  4826:     move.b  #$00,D1
02:00035134 D101            	  4827:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035136 194000FC        	  4828:     move.b  D0,($00FC,A4)
