02:00038A3A 10343018        	  1281:     move.b  ($18,A4,D3.W),D0
02:00038A3E 020000F0        	  1282:     andi.b #$F0,D0
02:00038A42 19802070        	  1283:     move.b  D0,($70,A4,D2.W)
02:00038A46 6748            	  1284:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A48 0C0000F0        	  1285:     cmpi.b  #$F0,D0
02:00038A4C 6742            	  1286:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1287:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  1288:     ; If it < $50 or >= $E0, go loop again.
                            	  1289:     ;
02:00038A4E 10343018        	  1290:     move.b  ($18,A4,D3.W),D0
02:00038A52 E308            	  1291:     lsl.b  #1,D0   ; ASL A
02:00038A54 E308            	  1292:     lsl.b  #1,D0   ; ASL A
02:00038A56 E308            	  1293:     lsl.b  #1,D0   ; ASL A
02:00038A58 E308            	  1294:     lsl.b  #1,D0   ; ASL A
02:00038A5A 0C000050        	  1295:     cmpi.b  #$50,D0
02:00038A5E 6530            	  1296:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A60 0C0000E0        	  1297:     cmpi.b  #$E0,D0
02:00038A64 642A            	  1298:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1299:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  1300:     ;
02:00038A66 0000000D        	  1301:     ori.b #$0D,D0
02:00038A6A 41EC0084        	  1302:     lea     ($0084,A4),A0
02:00038A6E 11802000        	  1303:     move.b  D0,(A0,D2.W)
                            	  1304:     ; Get the tile at that location.
                            	  1305:     ; If it's not a water tile, then go loop again.
                            	  1306:     ;
02:00038A72 4EB900048496    	  1307:     jsr     GetCollidableTileStill
02:00038A78 0C00008D        	  1308:     cmpi.b  #$8D,D0
02:00038A7C 6512            	  1309:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A7E 0C000099        	  1310:     cmpi.b  #$99,D0
02:00038A82 640C            	  1311:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1312:     ; Flag the zora active, and set up the object.
