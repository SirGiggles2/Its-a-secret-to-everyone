02:000391EA 41EC0098        	  2373:     lea     ($0098,A4),A0
02:000391EE 10302000        	  2374:     move.b  (A0,D2.W),D0
02:000391F2 0200000C        	  2375:     andi.b #$0C,D0
02:000391F6 660E            	  2376:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2377:     ; Else draw not mirrored.
                            	  2378:     ;
02:000391F8 101D            	  2379:     move.b  (A5)+,D0  ; PLA
02:000391FA 4EB900030CDA    	  2380:     jsr     DrawObjectNotMirrored
02:00039200 4EF900031046    	  2381:     jmp     CheckMonsterCollisions
