02:00039D5E 41EC0451        	  4008:     lea     ($0451,A4),A0
02:00039D62 11802000        	  4009:     move.b  D0,(A0,D2.W)
                            	  4010:     ; If shoot timer = 0, then we're not shooting.
                            	  4011:     ; Go set the qspeed.
                            	  4012:     ;
02:00039D66 673E            	  4013:     beq  _L_z04_UpdateStalfos_SetSpeed
                            	  4014:     ; If shoot timer <> $10, or we have the magic clock, or stunned;
                            	  4015:     ; then go reset qspeed.
