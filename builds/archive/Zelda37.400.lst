02:00048D20 12303000        	  4813:     move.b  (A0,D3.W),D1
02:00048D24 8001            	  4814:     or.b  D1,D0
02:00048D26 4EB900030FCC    	  4815:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4816:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4817:     ;
02:00048D2C 41F900048F54    	  4818:     lea     (RDirectionToWeaponFrame).l,A0
02:00048D32 10303000        	  4819:     move.b  (A0,D3.W),D0
02:00048D36 1940000C        	  4820:     move.b  D0,($000C,A4)
                            	  4821:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4822:     ;
02:00048D3A 0C030002        	  4823:     cmpi.b  #$02,D3
02:00048D3E 6604            	  4824:     bne  _anon_z07_24
02:00048D40 522C000F        	  4825:     addq.b  #1,($000F,A4)
                            	  4826: _anon_z07_24:
                            	  4827:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4828:     ;   $57 (sword shot) => $22
                            	  4829:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4830:     ;
02:00048D44 7622            	  4831:     moveq   #34,D3
02:00048D46 0C02000D        	  4832:     cmpi.b  #$0D,D2
02:00048D4A 6410            	  4833:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:00048D4C 41EC034F        	  4834:     lea     ($034F,A4),A0
02:00048D50 10302000        	  4835:     move.b  (A0,D2.W),D0
02:00048D54 0C000057        	  4836:     cmpi.b  #$57,D0
02:00048D58 6710            	  4837:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:00048D5A 660C            	  4838:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4839:     even
                            	  4840: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4841:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4842:     ;   high bit set (magic)   => $23
                            	  4843:     ;   high bit clear (sword) => $22
                            	  4844:     ;
02:00048D5C 41EC00AC        	  4845:     lea     ($00AC,A4),A0
02:00048D60 10302000        	  4846:     move.b  (A0,D2.W),D0
02:00048D64 E308            	  4847:     lsl.b  #1,D0   ; ASL A
02:00048D66 6402            	  4848:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4849:     even
