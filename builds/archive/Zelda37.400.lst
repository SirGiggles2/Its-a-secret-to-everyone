02:0003C15A 7070            	  8797:     moveq   #112,D0
02:0003C15C 7600            	  8798:     moveq   #0,D3
02:0003C15E 41EC034F        	  8799:     lea     ($034F,A4),A0
02:0003C162 16302000        	  8800:     move.b  (A0,D2.W),D3
