02:00048F0A 19400061        	  5099:     move.b  D0,($0061,A4)
02:00048F0E 41EC0084        	  5100:     lea     ($0084,A4),A0
02:00048F12 10302000        	  5101:     move.b  (A0,D2.W),D0
02:00048F16 19400062        	  5102:     move.b  D0,($0062,A4)
