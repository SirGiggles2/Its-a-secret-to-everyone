02:00034D3E 611C            	  4330:     jsr     UpdateZeldaTextbox
02:00034D40 102C00AD        	  4331:     move.b  ($00AD,A4),D0
02:00034D44 670A            	  4332:     beq  _anon_z02_30
                            	  4333:     ; Set a delay of $50 frames in the next submode.
                            	  4334:     ;
