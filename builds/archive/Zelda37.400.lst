                            	  4867: ; Params:
                            	  4868: ; [02]: bitmask for target door.
                            	  4869: ;
                            	  4870: ; Returns:
                            	  4871: ; A: door attribute for desired direction in current room.
                            	  4872: ; [01]: same as [02] if found; $10 otherwise
                            	  4873: ; [03]: reverse direction index
