                            	  1521:     ; to get room ID offset in that direction.
02:0003DD50 003C0011        	  1522:     ori     #$11,CCR  ; SEC: set C+X
02:0003DD54 122C00EB        	  1523:     move.b  ($00EB,A4),D1
02:0003DD58 0A3C0010        	  1524:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD5C 9101            	  1525:     subx.b  D1,D0   ; SBC RoomId
02:0003DD5E 0A3C0010        	  1526:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD62 4EB900030912    	  1527:     jsr     Negate
02:0003DD68 023C00EE        	  1528:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD6C 122C00EB        	  1529:     move.b  ($00EB,A4),D1
