02:00034CF4 41EC0302        	  4303:     lea     ($0302,A4),A0
02:00034CF8 11803000        	  4304:     move.b  D0,(A0,D3.W)
02:00034CFC 5303            	  4305:     subq.b  #1,D3
02:00034CFE 6AEA            	  4306:     bpl  _anon_z02_29
