02:00047C92 103C00FF        	  2405:     move.b  #$FF,D0
02:00047C96 41EC030C        	  2406:     lea     ($030C,A4),A0
02:00047C9A 11802000        	  2407:     move.b  D0,(A0,D2.W)
                            	  2408:     ; Update dynamic buffer length with 10 new bytes.
                            	  2409:     ;
02:00047C9E 1002            	  2410:     move.b  D2,D0
02:00047CA0 023C00EE        	  2411:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047CA4 123C000A        	  2412:     move.b  #$0A,D1
02:00047CA8 D101            	  2413:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:00047CAA 19400301        	  2414:     move.b  D0,($0301,A4)
02:00047CAE 101D            	  2415:     move.b  (A5)+,D0  ; PLA
02:00047CB0 7400            	  2416:     moveq   #0,D2
02:00047CB2 1400            	  2417:     move.b  D0,D2
02:00047CB4 7005            	  2418:     moveq   #5,D0
