02:0004942E 41EC00AC        	  5838:     lea     ($00AC,A4),A0
02:00049432 10302000        	  5839:     move.b  (A0,D2.W),D0
02:00049436 0200000F        	  5840:     andi.b #$0F,D0
02:0004943A 7600            	  5841:     moveq   #0,D3
02:0004943C 1600            	  5842:     move.b  D0,D3
02:0004943E 7008            	  5843:     moveq   #8,D0
02:00049440 5303            	  5844:     subq.b  #1,D3
