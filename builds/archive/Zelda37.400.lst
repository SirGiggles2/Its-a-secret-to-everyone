                            	  2754: UpdatePondFairy:
02:00039448 61003620        	  2755:     jsr     DrawFairy
                            	  2756:     ; If not in state 0, then go handle states 1 to 3.
                            	  2757:     ;
02:0003944C 102C00AD        	  2758:     move.b  ($00AD,A4),D0
02:00039450 6702            	  2759:     beq.s  __far_z_04_0026
02:00039452 602A            	  2760:     jmp  PondFairy_HandleOtherStates
                            	  2761: __far_z_04_0026:
                            	  2762:     ; State 0.
                            	  2763:     ;
                            	  2764:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2765:     ;
02:00039454 102C0084        	  2766:     move.b  ($0084,A4),D0
02:00039458 0C0000AD        	  2767:     cmpi.b  #$AD,D0
02:0003945C 661E            	  2768:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2769:     ; If Link's X < $70 or >= $81, then return.
                            	  2770:     ;
02:0003945E 102C0070        	  2771:     move.b  ($0070,A4),D0
02:00039462 0C000070        	  2772:     cmpi.b  #$70,D0
02:00039466 6514            	  2773:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039468 0C000081        	  2774:     cmpi.b  #$81,D0
02:0003946C 640E            	  2775:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2776:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2777:     ; halt Link, and start filling hearts.
                            	  2778:     ;
02:0003946E 522C00AD        	  2779:     addq.b  #1,($00AD,A4)
02:00039472 7040            	  2780:     moveq   #64,D0
02:00039474 194000AC        	  2781:     move.b  D0,($00AC,A4)
02:00039478 19400063        	  2782:     move.b  D0,($0063,A4)
                            	  2783:     even
                            	  2784: _L_z04_UpdatePondFairy_Exit:
02:0003947C 4E75            	  2785:     rts
                            	  2786: 
                            	  2787:     even
                            	  2788: PondFairy_HandleOtherStates:
02:0003947E 0C000001        	  2789:     cmpi.b  #$01,D0
02:00039482 6610            	  2790:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2791:     ; State 1. Flying and filling hearts.
                            	  2792:     ;
                            	  2793:     ; If still filling hearts, then go draw Link and hearts.
                            	  2794:     ;
02:00039484 102C0063        	  2795:     move.b  ($0063,A4),D0
02:00039488 6620            	  2796:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2797:     ; If not filling hearts anymore, then go to state 2,
                            	  2798:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2799:     ; a little while after we finish filling hearts.
                            	  2800:     ;
02:0003948A 522C00AD        	  2801:     addq.b  #1,($00AD,A4)
02:0003948E 7050            	  2802:     moveq   #80,D0
02:00039490 19400029        	  2803:     move.b  D0,($0029,A4)
                            	  2804:     even
                            	  2805: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2806:     ; If state <> 2 (so, it's 3), then return.
                            	  2807:     ;
                            	  2808:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2809:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2810:     ; was set to, and we'll return.
                            	  2811:     ;
02:00039494 0C000002        	  2812:     cmpi.b  #$02,D0
02:00039498 6634            	  2813:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2814:     ; State = 2.
                            	  2815:     ;
                            	  2816:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2817:     ;
02:0003949A 102C0029        	  2818:     move.b  ($0029,A4),D0
02:0003949E 660A            	  2819:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2820:     ; Else go to state 3, and unhalt Link.
                            	  2821:     ;
02:000394A0 522C00AD        	  2822:     addq.b  #1,($00AD,A4)
02:000394A4 7000            	  2823:     moveq   #0,D0
02:000394A6 194000AC        	  2824:     move.b  D0,($00AC,A4)
                            	  2825:     even
                            	  2826: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  2827:     ; TODO: but why, since Link is halted?
                            	  2828:     ;
                            	  2829:     ; Reset the input direction, so that Link doesn't animate
                            	  2830:     ; when drawing him.
02:000394AA 7600            	  2831:     moveq   #0,D3
02:000394AC 194303F8        	  2832:     move.b  D3,($03F8,A4)
                            	  2833:     ; Save and reset Link's state.
                            	  2834:     ;
                            	  2835:     ; TODO: but why, since Link is halted?
                            	  2836:     ;
02:000394B0 102C00AC        	  2837:     move.b  ($00AC,A4),D0
02:000394B4 1B00            	  2838:     move.b  D0,-(A5)  ; PHA
02:000394B6 194300AC        	  2839:     move.b  D3,($00AC,A4)
02:000394BA 4EB900048A24    	  2840:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  2841:     ; Restore Link's state.
                            	  2842:     ;
02:000394C0 101D            	  2843:     move.b  (A5)+,D0  ; PLA
02:000394C2 194000AC        	  2844:     move.b  D0,($00AC,A4)
02:000394C6 6110            	  2845:     jsr     PondFairy_MoveHearts
                            	  2846:     ; Restore the object slot.
                            	  2847:     ;
02:000394C8 7400            	  2848:     moveq   #0,D2
02:000394CA 142C0340        	  2849:     move.b  ($0340,A4),D2
                            	  2850:     even
                            	  2851: _L_z04_PondFairy_HandleOtherStates_Exit:
02:000394CE 4E75            	  2852:     rts
                            	  2853: 
                            	  2854:     even
                            	  2855: PondHeartStartAngles:
02:000394D0 14              	  2856:     dc.b    $14, $10, $0C, $08, $04, $00, $1C
02:000394D1 10
02:000394D2 0C
02:000394D3 08
02:000394D4 04
02:000394D5 00
02:000394D6 1C
                            	  2857: 
