02:00047BCE 19400005        	  2328:     move.b  D0,($0005,A4)
02:00047BD2 1002            	  2329:     move.b  D2,D0
02:00047BD4 1B00            	  2330:     move.b  D0,-(A5)  ; PHA
02:00047BD6 10342070        	  2331:     move.b  ($70,A4,D2.W),D0
02:00047BDA 19400003        	  2332:     move.b  D0,($0003,A4)
02:00047BDE 41EC0084        	  2333:     lea     ($0084,A4),A0
02:00047BE2 10302000        	  2334:     move.b  (A0,D2.W),D0
02:00047BE6 19400002        	  2335:     move.b  D0,($0002,A4)
02:00047BEA 4EB900030A7C    	  2336:     jsr     MapScreenPosToPpuAddr
02:00047BF0 7400            	  2337:     moveq   #0,D2
02:00047BF2 142C0301        	  2338:     move.b  ($0301,A4),D2
                            	  2339:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2340:     ;
                            	  2341:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2342:     ; In total, 11 bytes will be written.
                            	  2343:     ;
                            	  2344:     ; First, write the high byte of PPU address in each record.
                            	  2345:     ;
02:00047BF6 1014            	  2346:     move.b  ($0000,A4),D0
02:00047BF8 41EC0302        	  2347:     lea     ($0302,A4),A0
02:00047BFC 11802000        	  2348:     move.b  D0,(A0,D2.W)
02:00047C00 41EC0307        	  2349:     lea     ($0307,A4),A0
02:00047C04 11802000        	  2350:     move.b  D0,(A0,D2.W)
                            	  2351:     ; Write the low address in the first record. In the second record,
                            	  2352:     ; write (low address + 1).
                            	  2353:     ;
02:00047C08 102C0001        	  2354:     move.b  ($0001,A4),D0
02:00047C0C 41EC0303        	  2355:     lea     ($0303,A4),A0
02:00047C10 11802000        	  2356:     move.b  D0,(A0,D2.W)
02:00047C14 41EC0308        	  2357:     lea     ($0308,A4),A0
02:00047C18 11802000        	  2358:     move.b  D0,(A0,D2.W)
02:00047C1C 41EC0308        	  2359:     lea     ($0308,A4),A0
02:00047C20 52302000        	  2360:     addq.b  #1,(A0,D2.W)
                            	  2361:     ; Write the first tile twice in each record. Patch them later.
                            	  2362:     ;
02:00047C24 102C0005        	  2363:     move.b  ($0005,A4),D0
02:00047C28 41EC0305        	  2364:     lea     ($0305,A4),A0
02:00047C2C 11802000        	  2365:     move.b  D0,(A0,D2.W)
02:00047C30 41EC0306        	  2366:     lea     ($0306,A4),A0
02:00047C34 11802000        	  2367:     move.b  D0,(A0,D2.W)
02:00047C38 41EC030A        	  2368:     lea     ($030A,A4),A0
02:00047C3C 11802000        	  2369:     move.b  D0,(A0,D2.W)
02:00047C40 41EC030B        	  2370:     lea     ($030B,A4),A0
02:00047C44 11802000        	  2371:     move.b  D0,(A0,D2.W)
                            	  2372:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2373:     ; Add 1 more to the second byte in each record.
                            	  2374:     ; Here is an example result of this manipulation:
                            	  2375:     ;   record 1: $70, $71
                            	  2376:     ;   record 2: $72, $73
                            	  2377:     ;
02:00047C48 0C000046        	  2378:     cmpi.b  #$46,D0
02:00047C4C 6530            	  2379:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047C4E 0C0000F3        	  2380:     cmpi.b  #$F3,D0
02:00047C52 642A            	  2381:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047C54 023C00EE        	  2382:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047C58 123C0002        	  2383:     move.b  #$02,D1
02:00047C5C D101            	  2384:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00047C5E 41EC030A        	  2385:     lea     ($030A,A4),A0
02:00047C62 11802000        	  2386:     move.b  D0,(A0,D2.W)
02:00047C66 41EC030B        	  2387:     lea     ($030B,A4),A0
02:00047C6A 11802000        	  2388:     move.b  D0,(A0,D2.W)
02:00047C6E 41EC0306        	  2389:     lea     ($0306,A4),A0
02:00047C72 52302000        	  2390:     addq.b  #1,(A0,D2.W)
02:00047C76 41EC030B        	  2391:     lea     ($030B,A4),A0
02:00047C7A 52302000        	  2392:     addq.b  #1,(A0,D2.W)
                            	  2393:     even
                            	  2394: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2395:     ; Set the count byte in each record to $82:
                            	  2396:     ; 2 tiles arranged vertically
                            	  2397:     ;
02:00047C7E 103C0082        	  2398:     move.b  #$82,D0
02:00047C82 41EC0304        	  2399:     lea     ($0304,A4),A0
02:00047C86 11802000        	  2400:     move.b  D0,(A0,D2.W)
02:00047C8A 41EC0309        	  2401:     lea     ($0309,A4),A0
02:00047C8E 11802000        	  2402:     move.b  D0,(A0,D2.W)
                            	  2403:     ; Write the end marker.
