                            	  2001: 
                            	  2002: _anon_z04_42:
                            	  2003:     ; State 0.
                            	  2004:     ;
                            	  2005:     ; In state we determine whether to burst out of the ground.
                            	  2006:     ; If the long timer has not expired, then return.
                            	  2007:     ;
02:00038F32 102C004D        	  2008:     move.b  ($004D,A4),D0
02:00038F36 6674            	  2009:     bne  _L_z04_UpdateRedLeever_Exit
                            	  2010:     ; Only allow two red leevers at a time.
                            	  2011:     ;
02:00038F38 102C0510        	  2012:     move.b  ($0510,A4),D0
02:00038F3C 0C000002        	  2013:     cmpi.b  #$02,D0
02:00038F40 646A            	  2014:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2015:     ; Face in the same direction as Link.
                            	  2016:     ;
02:00038F42 102C0098        	  2017:     move.b  ($0098,A4),D0
02:00038F46 41EC0098        	  2018:     lea     ($0098,A4),A0
02:00038F4A 11802000        	  2019:     move.b  D0,(A0,D2.W)
                            	  2020:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  2021:     ;
02:00038F4E 10342019        	  2022:     move.b  ($19,A4,D2.W),D0
02:00038F52 0C0000C0        	  2023:     cmpi.b  #$C0,D0
02:00038F56 6506            	  2024:     bcs  _anon_z04_43
02:00038F58 4EB9000489F0    	  2025:     jsr     ReverseObjDir
                            	  2026: _anon_z04_43:
                            	  2027:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  2028:     ;
02:00038F5E 41EC0098        	  2029:     lea     ($0098,A4),A0
02:00038F62 10302000        	  2030:     move.b  (A0,D2.W),D0
02:00038F66 0200000C        	  2031:     andi.b #$0C,D0
02:00038F6A 6742            	  2032:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  2033:     ; Begin with the leever's X set to Link's X.
                            	  2034:     ;
02:00038F6C 102C0070        	  2035:     move.b  ($0070,A4),D0
02:00038F70 19802070        	  2036:     move.b  D0,($70,A4,D2.W)
                            	  2037:     ; If facing down, then use Y offset $28.
                            	  2038:     ; Else store Y offset -$28 in [00].
                            	  2039:     ;
02:00038F74 7628            	  2040:     moveq   #40,D3
02:00038F76 41EC0098        	  2041:     lea     ($0098,A4),A0
02:00038F7A 10302000        	  2042:     move.b  (A0,D2.W),D0
02:00038F7E 02000008        	  2043:     andi.b #$08,D0
02:00038F82 6704            	  2044:     beq  _anon_z04_44
02:00038F84 163C00D8        	  2045:     move.b  #$D8,D3
                            	  2046: _anon_z04_44:
02:00038F88 1883            	  2047:     move.b  D3,($0000,A4)
                            	  2048:     ; Add Link's Y and the vertical offset.
                            	  2049:     ;
02:00038F8A 102C0084        	  2050:     move.b  ($0084,A4),D0
02:00038F8E 023C00EE        	  2051:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038F92 1214            	  2052:     move.b  ($0000,A4),D1
02:00038F94 D101            	  2053:     addx.b  D1,D0   ; ADC $00
                            	  2054:     ; Sanitize the Y coordinate:
                            	  2055:     ; (Y AND $F0) OR $D
                            	  2056:     ;
02:00038F96 020000F0        	  2057:     andi.b #$F0,D0
02:00038F9A 0000000D        	  2058:     ori.b #$0D,D0
02:00038F9E 41EC0084        	  2059:     lea     ($0084,A4),A0
02:00038FA2 11802000        	  2060:     move.b  D0,(A0,D2.W)
                            	  2061:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  2062:     ; go see if the tile is valid to come out of.
                            	  2063:     ;
                            	  2064:     ; Else it's too close to the top edge of the screen. So, return.
                            	  2065:     ;
02:00038FA6 0C00005D        	  2066:     cmpi.b  #$5D,D0
02:00038FAA 647A            	  2067:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  2068:     even
                            	  2069: _L_z04_UpdateRedLeever_Exit:
02:00038FAC 4E75            	  2070:     rts
                            	  2071: 
                            	  2072:     even
                            	  2073: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  2074:     ; Begin with the leever's Y set to Link's Y.
                            	  2075:     ;
02:00038FAE 102C0084        	  2076:     move.b  ($0084,A4),D0
02:00038FB2 41EC0084        	  2077:     lea     ($0084,A4),A0
02:00038FB6 11802000        	  2078:     move.b  D0,(A0,D2.W)
                            	  2079:     ; If Y coordinate < $5D (top of the third square row), then
                            	  2080:     ; it's too close to the top edge of the screen. So, return.
                            	  2081:     ;
02:00038FBA 0C00005D        	  2082:     cmpi.b  #$5D,D0
02:00038FBE 65EC            	  2083:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  2084:     ; If facing right, then use X offset $28.
                            	  2085:     ; Else store X offset -$28 in [00].
                            	  2086:     ;
02:00038FC0 7628            	  2087:     moveq   #40,D3
02:00038FC2 41EC0098        	  2088:     lea     ($0098,A4),A0
02:00038FC6 10302000        	  2089:     move.b  (A0,D2.W),D0
02:00038FCA 02000002        	  2090:     andi.b #$02,D0
02:00038FCE 6704            	  2091:     beq  _anon_z04_45
02:00038FD0 163C00D8        	  2092:     move.b  #$D8,D3
                            	  2093: _anon_z04_45:
02:00038FD4 1883            	  2094:     move.b  D3,($0000,A4)
                            	  2095:     ; [01] holds Link's X coordinate.
                            	  2096:     ;
02:00038FD6 102C0070        	  2097:     move.b  ($0070,A4),D0
02:00038FDA 19400001        	  2098:     move.b  D0,($0001,A4)
                            	  2099:     ; Add Link's X and the horizontal offset.
                            	  2100:     ;
02:00038FDE 023C00EE        	  2101:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038FE2 1214            	  2102:     move.b  ($0000,A4),D1
02:00038FE4 D101            	  2103:     addx.b  D1,D0   ; ADC $00
                            	  2104:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  2105:     ;
02:00038FE6 020000F8        	  2106:     andi.b #$F8,D0
                            	  2107:     ; Assign that result to the leever's X coordinate and [02].
                            	  2108:     ;
02:00038FEA 19802070        	  2109:     move.b  D0,($70,A4,D2.W)
02:00038FEE 19400002        	  2110:     move.b  D0,($0002,A4)
                            	  2111:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  2112:     ;
02:00038FF2 122C0001        	  2113:     move.b  ($0001,A4),D1
02:00038FF6 B001            	  2114:     cmp.b   D1,D0
02:00038FF8 6510            	  2115:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038FFA 1B00            	  2116:     move.b  D0,-(A5)  ; PHA
02:00038FFC 102C0001        	  2117:     move.b  ($0001,A4),D0
02:00039000 19400002        	  2118:     move.b  D0,($0002,A4)
02:00039004 101D            	  2119:     move.b  (A5)+,D0  ; PLA
02:00039006 19400001        	  2120:     move.b  D0,($0001,A4)
                            	  2121:     even
                            	  2122: _L_z04_UpdateRedLeever_Subtract:
                            	  2123:     ; The point is to get the absolute distance between the two.
                            	  2124:     ;
02:0003900A 102C0001        	  2125:     move.b  ($0001,A4),D0
02:0003900E 003C0011        	  2126:     ori     #$11,CCR  ; SEC: set C+X
02:00039012 122C0002        	  2127:     move.b  ($0002,A4),D1
02:00039016 0A3C0010        	  2128:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003901A 9101            	  2129:     subx.b  D1,D0   ; SBC $02
02:0003901C 0A3C0010        	  2130:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2131:     ; If the absolute distance >= $30, then return.
                            	  2132:     ; It means that the leever's X coordinate wrapped around
                            	  2133:     ; the left or right edge of the screen.
                            	  2134:     ;
02:00039020 0C000030        	  2135:     cmpi.b  #$30,D0
02:00039024 6486            	  2136:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2137:     even
                            	  2138: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  2139:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  2140:     ;
02:00039026 4EB900048496    	  2141:     jsr     GetCollidableTileStill
02:0003902C 122C034A        	  2142:     move.b  ($034A,A4),D1
02:00039030 B001            	  2143:     cmp.b   D1,D0
02:00039032 6400FF78        	  2144:     bcc  _L_z04_UpdateRedLeever_Exit
02:00039036 522C0510        	  2145:     addq.b  #1,($0510,A4)
                            	  2146:     ; Set animation counter to 1, so that it will roll over this frame
                            	  2147:     ; and pick up whatever the new value is for state 1.
                            	  2148:     ;
02:0003903A 7001            	  2149:     moveq   #1,D0
02:0003903C 41EC03D0        	  2150:     lea     ($03D0,A4),A0
02:00039040 11802000        	  2151:     move.b  D0,(A0,D2.W)
                            	  2152:     ; Set the long timer to 2, meaning 20 frames.
                            	  2153:     ;
02:00039044 E308            	  2154:     lsl.b  #1,D0   ; ASL A
02:00039046 1940004D        	  2155:     move.b  D0,($004D,A4)
02:0003904A 6100008C        	  2156:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  2157:     ; The leever has to face Link in order to move toward him.
                            	  2158:     ;
02:0003904E 4EB9000489F0    	  2159:     jsr     ReverseObjDir
                            	  2160:     even
                            	  2161: _L_z04_UpdateRedLeever_CheckOtherStates:
