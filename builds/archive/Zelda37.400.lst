02:0004040A 10302000        	  5444:     move.b  (A0,D2.W),D0
02:0004040E 4EB90003098E    	  5445:     jsr     AddToInt16At0
                            	  5446:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5447:     ; go 1 more tile down, to start the next column at the right place.
                            	  5448:     ; We have to compensate for the fact that E/W doors are 
                            	  5449:     ; shorter vertically than N/S doors.
02:00040414 4A02            	  5450:     cmpi.b  #$00,D2
02:00040416 6610            	  5451:     bne  _anon_z05_115
02:00040418 101D            	  5452:     move.b  (A5)+,D0  ; PLA
02:0004041A 1B00            	  5453:     move.b  D0,-(A5)  ; PHA
02:0004041C 0C000002        	  5454:     cmpi.b  #$02,D0
02:00040420 6406            	  5455:     bcc  _anon_z05_115
02:00040422 4EB90003098A    	  5456:     jsr     Add1ToInt16At0
