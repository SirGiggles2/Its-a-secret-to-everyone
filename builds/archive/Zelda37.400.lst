                            	  5517: _L_z07_CheckState30_CheckOtherStates:
                            	  5518:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5519:     ;
                            	  5520:     ; The boomerang will now return. Reset the grid offset.
                            	  5521:     ;
02:000491CE 7000            	  5522:     moveq   #0,D0
02:000491D0 41EC0394        	  5523:     lea     ($0394,A4),A0
02:000491D4 11802000        	  5524:     move.b  D0,(A0,D2.W)
                            	  5525:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5526:     ;
02:000491D8 0C02000D        	  5527:     cmpi.b  #$0D,D2
02:000491DC 6408            	  5528:     bcc  _anon_z07_30
02:000491DE 41EC042C        	  5529:     lea     ($042C,A4),A0
02:000491E2 10302000        	  5530:     move.b  (A0,D2.W),D0
                            	  5531: _anon_z07_30:
02:000491E6 4EB90003091A    	  5532:     jsr     GetDirectionsAndDistancesToTarget
                            	  5533:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5534:     ; then go move towards the thrower, draw, and check collisions.
                            	  5535:     ;
02:000491EC 1014            	  5536:     move.b  ($0000,A4),D0
02:000491EE 0C000002        	  5537:     cmpi.b  #$02,D0
02:000491F2 666A            	  5538:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5539:     ; The boomerang has reached the thrower.
                            	  5540:     ;
                            	  5541:     ; Reset the distance to move.
                            	  5542:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5543:     ;
02:000491F4 7000            	  5544:     moveq   #0,D0
02:000491F6 41EC0380        	  5545:     lea     ($0380,A4),A0
02:000491FA 11802000        	  5546:     move.b  D0,(A0,D2.W)
02:000491FE 0C02000D        	  5547:     cmpi.b  #$0D,D2
02:00049202 6524            	  5548:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5549:     ; Link has caught the boomerang.
                            	  5550:     ;
                            	  5551:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5552:     ;
                            	  5553:     ; If Link catches it some time after throwing it,
                            	  5554:     ; his state will become $20, and he will show the catch animation.
                            	  5555:     ;
                            	  5556:     ; But if he catches it right after throwing it, the state becomes
                            	  5557:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5558:     ;
02:00049204 102C00AC        	  5559:     move.b  ($00AC,A4),D0
02:00049208 00000020        	  5560:     ori.b #$20,D0
02:0004920C 194000AC        	  5561:     move.b  D0,($00AC,A4)
                            	  5562:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5563:     ; up the new state.
                            	  5564:     ;
02:00049210 7001            	  5565:     moveq   #1,D0
02:00049212 194003D0        	  5566:     move.b  D0,($03D0,A4)
                            	  5567:     ; Deactivate the boomerang.
                            	  5568:     ;
02:00049216 760F            	  5569:     moveq   #15,D3
02:00049218 7000            	  5570:     moveq   #0,D0
02:0004921A 41EC00AC        	  5571:     lea     ($00AC,A4),A0
02:0004921E 11803000        	  5572:     move.b  D0,(A0,D3.W)
02:00049222 0A3C0001        	  5573:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00049226 4E75            	  5574:     rts
                            	  5575: 
                            	  5576:     even
