02:0003A52C 7600            	  5072:     moveq   #0,D3
02:0003A52E 1600            	  5073:     move.b  D0,D3
02:0003A530 5203            	  5074:     addq.b  #1,D3
02:0003A532 41EC0098        	  5075:     lea     ($0098,A4),A0
02:0003A536 11832000        	  5076:     move.b  D3,(A0,D2.W)
02:0003A53A 4E75            	  5077:     rts
