                            	  5641: UpdateDarknut:
02:0003A938 103C0080        	  5642:     move.b  #$80,D0
02:0003A93C 6100D98C        	  5643:     jsr     UpdateCommonWanderer
02:0003A940 4EB900031046    	  5644:     jsr     CheckMonsterCollisions
                            	  5645:     ; Darknuts are never stunned.
                            	  5646:     ;
02:0003A946 7000            	  5647:     moveq   #0,D0
02:0003A948 1980203D        	  5648:     move.b  D0,($3D,A4,D2.W)
02:0003A94C 7008            	  5649:     moveq   #8,D0
02:0003A94E 4EB900049A7A    	  5650:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5651:     ; If facing left, then enable horizontal flipping.
                            	  5652:     ;
02:0003A954 41EC0098        	  5653:     lea     ($0098,A4),A0
02:0003A958 10302000        	  5654:     move.b  (A0,D2.W),D0
02:0003A95C 0C000002        	  5655:     cmpi.b  #$02,D0
02:0003A960 6604            	  5656:     bne  _anon_z04_94
02:0003A962 522C000F        	  5657:     addq.b  #1,($000F,A4)
                            	  5658: _anon_z04_94:
                            	  5659:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  5660:     ; This is the base frame image.
                            	  5661:     ;
02:0003A966 E208            	  5662:     lsr.b  #1,D0   ; LSR A
02:0003A968 E208            	  5663:     lsr.b  #1,D0   ; LSR A
                            	  5664:     ; If movement frame = 1, add 3 to frame image to access
                            	  5665:     ; the second animation frame's images.
                            	  5666:     ;
02:0003A96A 7600            	  5667:     moveq   #0,D3
02:0003A96C 41EC03E4        	  5668:     lea     ($03E4,A4),A0
02:0003A970 16302000        	  5669:     move.b  (A0,D2.W),D3
02:0003A974 671E            	  5670:     beq  _anon_z04_95
02:0003A976 023C00EE        	  5671:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A97A 123C0003        	  5672:     move.b  #$03,D1
02:0003A97E D101            	  5673:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  5674:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  5675:     ;
                            	  5676:     ; Down has two frame images, but up only has one. By flipping
                            	  5677:     ; horizontally, you get two frame images.
                            	  5678:     ;
02:0003A980 7600            	  5679:     moveq   #0,D3
02:0003A982 41EC0098        	  5680:     lea     ($0098,A4),A0
02:0003A986 16302000        	  5681:     move.b  (A0,D2.W),D3
02:0003A98A 0C030008        	  5682:     cmpi.b  #$08,D3
02:0003A98E 6604            	  5683:     bne  _anon_z04_95
02:0003A990 522C000F        	  5684:     addq.b  #1,($000F,A4)
