02:0003EA50 60E4            	  3292:     jmp  GoToModeAFromCave
                            	  3293: __far_z_05_0063:
02:0003EA52 4E75            	  3294:     rts
                            	  3295: 
                            	  3296: ; Params:
                            	  3297: ; [0F]: movement direction
                            	  3298: ;
                            	  3299: ; Returns:
                            	  3300: ; [0F]: movement direction or 0
                            	  3301: ;
                            	  3302: ;
                            	  3303: ; If the ladder's not in use, return.
                            	  3304: ;
                            	  3305:     even
                            	  3306: CheckLadder:
02:0003EA54 7400            	  3307:     moveq   #0,D2
02:0003EA56 142C0064        	  3308:     move.b  ($0064,A4),D2
02:0003EA5A 670000BE        	  3309:     beq  _L_z05_CheckLadder_Exit
                            	  3310:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3311:     ;
02:0003EA5E 41EC00AC        	  3312:     lea     ($00AC,A4),A0
02:0003EA62 10302000        	  3313:     move.b  (A0,D2.W),D0
02:0003EA66 670000A6        	  3314:     beq  _L_z05_CheckLadder_StashLadder
                            	  3315:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3316:     ; between the ladder and Link.
                            	  3317:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3318:     ;
02:0003EA6A 41EC0098        	  3319:     lea     ($0098,A4),A0
02:0003EA6E 10302000        	  3320:     move.b  (A0,D2.W),D0
02:0003EA72 0200000C        	  3321:     andi.b #$0C,D0
02:0003EA76 6734            	  3322:     beq  _anon_z05_85
02:0003EA78 102C0070        	  3323:     move.b  ($0070,A4),D0
02:0003EA7C 12342070        	  3324:     move.b  ($70,A4,D2.W),D1
02:0003EA80 B001            	  3325:     cmp.b   D1,D0
02:0003EA82 6600008A        	  3326:     bne  _L_z05_CheckLadder_StashLadder
02:0003EA86 102C0084        	  3327:     move.b  ($0084,A4),D0
02:0003EA8A 023C00EE        	  3328:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EA8E 123C0003        	  3329:     move.b  #$03,D1
02:0003EA92 D101            	  3330:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EA94 003C0011        	  3331:     ori     #$11,CCR  ; SEC: set C+X
02:0003EA98 41EC0084        	  3332:     lea     ($0084,A4),A0
02:0003EA9C 12302000        	  3333:     move.b  (A0,D2.W),D1
02:0003EAA0 0A3C0010        	  3334:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EAA4 9101            	  3335:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EAA6 0A3C0010        	  3336:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EAAA 6030            	  3337:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3338: 
                            	  3339: _anon_z05_85:
                            	  3340:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3341:     ; between the ladder and Link.
                            	  3342:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3343:     ;
02:0003EAAC 102C0084        	  3344:     move.b  ($0084,A4),D0
02:0003EAB0 023C00EE        	  3345:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EAB4 123C0003        	  3346:     move.b  #$03,D1
02:0003EAB8 D101            	  3347:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003EABA 41EC0084        	  3348:     lea     ($0084,A4),A0
02:0003EABE 12302000        	  3349:     move.b  (A0,D2.W),D1
02:0003EAC2 B001            	  3350:     cmp.b   D1,D0
02:0003EAC4 6648            	  3351:     bne  _L_z05_CheckLadder_StashLadder
02:0003EAC6 102C0070        	  3352:     move.b  ($0070,A4),D0
02:0003EACA 003C0011        	  3353:     ori     #$11,CCR  ; SEC: set C+X
02:0003EACE 12342070        	  3354:     move.b  ($70,A4,D2.W),D1
02:0003EAD2 0A3C0010        	  3355:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EAD6 9101            	  3356:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EAD8 0A3C0010        	  3357:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3358:     even
                            	  3359: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3360:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3361:     ; If > $10, go put the ladder away.
                            	  3362:     ;
02:0003EADC 4EB90003090E    	  3363:     jsr     Abs
02:0003EAE2 1880            	  3364:     move.b  D0,($0000,A4)
02:0003EAE4 0C000010        	  3365:     cmpi.b  #$10,D0
02:0003EAE8 6532            	  3366:     bcs  _L_z05_CheckLadder_SetState2
02:0003EAEA 0C000010        	  3367:     cmpi.b  #$10,D0
02:0003EAEE 661E            	  3368:     bne  _L_z05_CheckLadder_StashLadder
                            	  3369:     ; Distance = $10. If player's not facing in the same direction as
                            	  3370:     ; the ladder, go put away the ladder.
                            	  3371:     ;
02:0003EAF0 102C0098        	  3372:     move.b  ($0098,A4),D0
02:0003EAF4 41EC0098        	  3373:     lea     ($0098,A4),A0
02:0003EAF8 12302000        	  3374:     move.b  (A0,D2.W),D1
02:0003EAFC B001            	  3375:     cmp.b   D1,D0
02:0003EAFE 660E            	  3376:     bne  _L_z05_CheckLadder_StashLadder
                            	  3377:     ; Distance = $10, and player's facing in the same direction.
                            	  3378:     ;
                            	  3379:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3380:     ; ladder and had not stepped onto it yet.
                            	  3381:     ; Go handle movement on it, but don't change state yet.
                            	  3382:     ;
                            	  3383:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3384:     ; off of the ladder. So the ladder should be put away. In this
                            	  3385:     ; case, fall thru.
                            	  3386:     ;
02:0003EB00 41EC00AC        	  3387:     lea     ($00AC,A4),A0
02:0003EB04 10302000        	  3388:     move.b  (A0,D2.W),D0
02:0003EB08 0C000001        	  3389:     cmpi.b  #$01,D0
02:0003EB0C 6718            	  3390:     beq  _L_z05_CheckLadder_HandleInput
                            	  3391:     even
                            	  3392: _L_z05_CheckLadder_StashLadder:
                            	  3393:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3394:     ;
02:0003EB0E 7000            	  3395:     moveq   #0,D0
02:0003EB10 19400064        	  3396:     move.b  D0,($0064,A4)
02:0003EB14 4EB90004A25C    	  3397:     jsr     DestroyMonster
                            	  3398:     even
                            	  3399: _L_z05_CheckLadder_Exit:
02:0003EB1A 4E75            	  3400:     rts
                            	  3401: 
                            	  3402:     even
                            	  3403: _L_z05_CheckLadder_SetState2:
                            	  3404:     ;  Set state 2, because we're on the ladder.
                            	  3405:     ;
02:0003EB1C 7002            	  3406:     moveq   #2,D0
02:0003EB1E 41EC00AC        	  3407:     lea     ($00AC,A4),A0
02:0003EB22 11802000        	  3408:     move.b  D0,(A0,D2.W)
                            	  3409:     even
                            	  3410: _L_z05_CheckLadder_HandleInput:
                            	  3411:     ; If input direction = 0, go draw and reset moving direction.
                            	  3412:     ;
02:0003EB26 102C03F8        	  3413:     move.b  ($03F8,A4),D0
02:0003EB2A 67000086        	  3414:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3415:     ; Input direction <> 0. The player intends to move.
                            	  3416:     ; So, see if we need to override the moving direction.
                            	  3417:     ;
                            	  3418:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3419:     ; go draw and set moving direction to Link's direction.
                            	  3420:     ;
                            	  3421:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3422:     ; been blocked by the water.
                            	  3423:     ;
                            	  3424:     ; Or, Link already passed over the point right over the ladder
                            	  3425:     ; and was allowed to move onto the tiles after the ladder.
                            	  3426:     ;
02:0003EB2E 102C0098        	  3427:     move.b  ($0098,A4),D0
02:0003EB32 7600            	  3428:     moveq   #0,D3
02:0003EB34 1614            	  3429:     move.b  ($0000,A4),D3
02:0003EB36 670C            	  3430:     beq  _anon_z05_86
02:0003EB38 41EC0098        	  3431:     lea     ($0098,A4),A0
02:0003EB3C 12302000        	  3432:     move.b  (A0,D2.W),D1
02:0003EB40 B001            	  3433:     cmp.b   D1,D0
02:0003EB42 676E            	  3434:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3435: _anon_z05_86:
                            	  3436:     ; Distance = 0, or facing different directions.
                            	  3437:     ;
                            	  3438:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3439:     ; then go draw and keep moving.
                            	  3440:     ;
                            	  3441:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3442:     ;
                            	  3443:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3444:     ; to move onto the tiles after the ladder.
                            	  3445:     ;
                            	  3446:     ; Note that if Link is not moving, then this test will fail,
                            	  3447:     ; and case (D) will catch it.
                            	  3448:     ;
02:0003EB44 41EC0098        	  3449:     lea     ($0098,A4),A0
02:0003EB48 10302000        	  3450:     move.b  (A0,D2.W),D0
02:0003EB4C 122C000F        	  3451:     move.b  ($000F,A4),D1
02:0003EB50 B001            	  3452:     cmp.b   D1,D0
02:0003EB52 675E            	  3453:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3454:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3455:     ; then go draw and move in ladder's direction.
                            	  3456:     ;
                            	  3457:     ; You can always step off the ladder where you came from.
                            	  3458:     ;
02:0003EB54 4EB90003090A    	  3459:     jsr     GetOppositeDir
02:0003EB5A 122C0098        	  3460:     move.b  ($0098,A4),D1
02:0003EB5E B001            	  3461:     cmp.b   D1,D0
02:0003EB60 6750            	  3462:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3463:     ; D. If opposite of ladder's direction <> down,
                            	  3464:     ; or input direction <> up,
                            	  3465:     ; then go reset moving direction, and draw.
                            	  3466:     ;
                            	  3467:     ; This will catch all cases of Link facing perpendicular to
                            	  3468:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3469:     ; ladder direction is up and input direction is up (E).
                            	  3470:     ;
02:0003EB62 0C000004        	  3471:     cmpi.b  #$04,D0
02:0003EB66 6648            	  3472:     bne  _anon_z05_87
02:0003EB68 102C03F8        	  3473:     move.b  ($03F8,A4),D0
02:0003EB6C 0C000008        	  3474:     cmpi.b  #$08,D0
02:0003EB70 663E            	  3475:     bne  _anon_z05_87
                            	  3476:     ; E. The ladder's direction is up and input direction is up.
                            	  3477:     ;
                            	  3478:     ; An earlier call to check tile collision would have blocked
                            	  3479:     ; movement, because the tile under Link's top half is a water tile.
                            	  3480:     ; But because Link is squarely on the ladder, we really have
                            	  3481:     ; to check the tile above that one.
                            	  3482:     ;
                            	  3483:     ; Set moving direction to input direction (up) and switch X to
                            	  3484:     ; the player's slot for the purpose of checking tile collision below.
                            	  3485:     ; Based on that, we'll set moving direction according to walkability.
                            	  3486:     ;
02:0003EB72 6158            	  3487:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3488:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3489:     ;
02:0003EB74 102C0084        	  3490:     move.b  ($0084,A4),D0
02:0003EB78 1B00            	  3491:     move.b  D0,-(A5)  ; PHA
02:0003EB7A 003C0011        	  3492:     ori     #$11,CCR  ; SEC: set C+X
02:0003EB7E 123C0008        	  3493:     move.b  #$08,D1
02:0003EB82 0A3C0010        	  3494:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EB86 9101            	  3495:     subx.b  D1,D0   ; SBC #$08
02:0003EB88 0A3C0010        	  3496:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EB8C 19400084        	  3497:     move.b  D0,($0084,A4)
02:0003EB90 4EB90004849C    	  3498:     jsr     GetCollidingTileMoving
02:0003EB96 101D            	  3499:     move.b  (A5)+,D0  ; PLA
02:0003EB98 19400084        	  3500:     move.b  D0,($0084,A4)
                            	  3501:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3502:     ; direction as the input direction (in a roundabout way).
                            	  3503:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3504:     ;
02:0003EB9C 102C000F        	  3505:     move.b  ($000F,A4),D0
02:0003EBA0 7600            	  3506:     moveq   #0,D3
02:0003EBA2 162C049E        	  3507:     move.b  ($049E,A4),D3
02:0003EBA6 122C034A        	  3508:     move.b  ($034A,A4),D1
02:0003EBAA B601            	  3509:     cmp.b   D1,D3
02:0003EBAC 6500FF78        	  3510:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3511: _anon_z05_87:
                            	  3512:     ; Set A to reset moving direction in [0F].
                            	  3513:     ;
02:0003EBB0 7000            	  3514:     moveq   #0,D0
                            	  3515:     even
                            	  3516: _L_z05_CheckLadder_DrawLadder:
                            	  3517:     ; Draw the ladder.
                            	  3518:     ;
02:0003EBB2 1B00            	  3519:     move.b  D0,-(A5)  ; PHA
02:0003EBB4 7400            	  3520:     moveq   #0,D2
02:0003EBB6 142C0064        	  3521:     move.b  ($0064,A4),D2
02:0003EBBA 4EB900049A80    	  3522:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003EBC0 760C            	  3523:     moveq   #12,D3
02:0003EBC2 7000            	  3524:     moveq   #0,D0
02:0003EBC4 4EB900030EDE    	  3525:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:0003EBCA 101D            	  3526:     move.b  (A5)+,D0  ; PLA
                            	  3527: ; Params:
                            	  3528: ; A: direction
                            	  3529: ;
                            	  3530: ; Returns:
                            	  3531: ; [0F]: direction
                            	  3532: ;
                            	  3533:     even
