02:0003EA16 1214            	  3257:     move.b  ($0000,A4),D1
02:0003EA18 D101            	  3258:     addx.b  D1,D0   ; ADC $00
                            	  3259:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3260:     ;
02:0003EA1A 02000003        	  3261:     andi.b #$03,D0
02:0003EA1E 7600            	  3262:     moveq   #0,D3
02:0003EA20 1600            	  3263:     move.b  D0,D3
02:0003EA22 41F900FF6BB2    	  3264:     lea     (NES_SRAM+$0BB2).l,A0
02:0003EA28 10303000        	  3265:     move.b  (A0,D3.W),D0
