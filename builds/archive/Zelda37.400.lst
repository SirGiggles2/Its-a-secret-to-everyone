                            	  9038:     ; The animation cycle has 6 frames.
                            	  9039:     ;
02:0003C2DC 41EC046B        	  9040:     lea     ($046B,A4),A0
02:0003C2E0 10302000        	  9041:     move.b  (A0,D2.W),D0
02:0003C2E4 0C000006        	  9042:     cmpi.b  #$06,D0
02:0003C2E8 660A            	  9043:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003C2EA 7000            	  9044:     moveq   #0,D0
02:0003C2EC 41EC046B        	  9045:     lea     ($046B,A4),A0
02:0003C2F0 11802000        	  9046:     move.b  D0,(A0,D2.W)
                            	  9047:     even
