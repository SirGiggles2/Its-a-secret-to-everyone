02:0003EA02 41F900FF6BB2    	  3245:     lea     (NES_SRAM+$0BB2).l,A0
02:0003EA08 12303000        	  3246:     move.b  (A0,D3.W),D1
02:0003EA0C B001            	  3247:     cmp.b   D1,D0
02:0003EA0E 66F0            	  3248:     bne  _anon_z05_84
                            	  3249:     ; Add the value of the shortcut chosen to whatever index
                            	  3250:     ; the current room has in the array.
                            	  3251:     ;
                            	  3252:     ; This yields the index of one of the three shortcut rooms
                            	  3253:     ; after the current one.
                            	  3254:     ;
02:0003EA10 1003            	  3255:     move.b  D3,D0
