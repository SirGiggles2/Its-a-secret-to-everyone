                            	  5888: _L_z07_UpdateSwordOrRod_Add4:
                            	  5889:     ; Set [00] to (state - 1) * 4:
                            	  5890:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5891:     ;
02:00049492 023C00EE        	  5892:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049496 123C0004        	  5893:     move.b  #$04,D1
02:0004949A D101            	  5894:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004949C 5303            	  5895:     subq.b  #1,D3
02:0004949E 66F2            	  5896:     bne  _L_z07_UpdateSwordOrRod_Add4
02:000494A0 1880            	  5897:     move.b  D0,($0000,A4)
                            	  5898:     ; Set object's direction to player's. It might have changed
                            	  5899:     ; since the last frame.
                            	  5900:     ;
02:000494A2 102C0098        	  5901:     move.b  ($0098,A4),D0
02:000494A6 41EC0098        	  5902:     lea     ($0098,A4),A0
02:000494AA 11802000        	  5903:     move.b  D0,(A0,D2.W)
                            	  5904:     ; Add [00] and the reverse index of the direction to get
                            	  5905:     ; the byte offset of the pixel offset.
                            	  5906:     ;
02:000494AE 4EB90003090A    	  5907:     jsr     GetOppositeDir
02:000494B4 1003            	  5908:     move.b  D3,D0
02:000494B6 023C00EE        	  5909:     andi    #$EE,CCR  ; CLC: clear C+X
02:000494BA 1214            	  5910:     move.b  ($0000,A4),D1
02:000494BC D101            	  5911:     addx.b  D1,D0   ; ADC $00
02:000494BE 7600            	  5912:     moveq   #0,D3
02:000494C0 1600            	  5913:     move.b  D0,D3
                            	  5914:     ; Set object's X to player's X + offset for state and direction.
