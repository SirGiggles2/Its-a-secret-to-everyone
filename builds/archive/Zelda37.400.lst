                            	   524: UpdateBlock0Idle:
                            	   525:     ; If there are monsters in the room, go reset the push timer and return.
                            	   526:     ;
02:000384D0 102C034D        	   527:     move.b  ($034D,A4),D0
02:000384D4 6604            	   528:     bne.s  __far_z_04_0000
02:000384D6 600000D6        	   529:     jmp  ResetPushTimer
                            	   530: __far_z_04_0000:
                            	   531:     ; If Link's X is aligned with the block's, then get the difference
                            	   532:     ; between Link's (Y + 3) and the block's Y.
                            	   533:     ; Then go test the difference.
                            	   534:     ;
02:000384DA 102C0070        	   535:     move.b  ($0070,A4),D0
02:000384DE 12342070        	   536:     move.b  ($70,A4,D2.W),D1
02:000384E2 B001            	   537:     cmp.b   D1,D0
02:000384E4 6628            	   538:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:000384E6 7600            	   539:     moveq   #0,D3
02:000384E8 102C0084        	   540:     move.b  ($0084,A4),D0
02:000384EC 023C00EE        	   541:     andi    #$EE,CCR  ; CLC: clear C+X
02:000384F0 123C0003        	   542:     move.b  #$03,D1
02:000384F4 D101            	   543:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000384F6 003C0011        	   544:     ori     #$11,CCR  ; SEC: set C+X
02:000384FA 41EC0084        	   545:     lea     ($0084,A4),A0
02:000384FE 12302000        	   546:     move.b  (A0,D2.W),D1
02:00038502 0A3C0010        	   547:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038506 9101            	   548:     subx.b  D1,D0   ; SBC ObjY,X
02:00038508 0A3C0010        	   549:     eori    #$10,CCR  ; restore X = 6502 C
02:0003850C 6036            	   550:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   551: 
                            	   552:     even
                            	   553: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   554:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   555:     ; go reset the push timer.
                            	   556:     ;
02:0003850E 102C0084        	   557:     move.b  ($0084,A4),D0
02:00038512 023C00EE        	   558:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038516 123C0003        	   559:     move.b  #$03,D1
02:0003851A D101            	   560:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003851C 41EC0084        	   561:     lea     ($0084,A4),A0
02:00038520 12302000        	   562:     move.b  (A0,D2.W),D1
02:00038524 B001            	   563:     cmp.b   D1,D0
02:00038526 6704            	   564:     beq.s  __far_z_04_0001
02:00038528 60000084        	   565:     jmp  ResetPushTimer
                            	   566: __far_z_04_0001:
                            	   567:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   568:     ; Get the difference in X.
                            	   569:     ;
02:0003852C 7602            	   570:     moveq   #2,D3
02:0003852E 102C0070        	   571:     move.b  ($0070,A4),D0
02:00038532 003C0011        	   572:     ori     #$11,CCR  ; SEC: set C+X
02:00038536 12342070        	   573:     move.b  ($70,A4,D2.W),D1
02:0003853A 0A3C0010        	   574:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003853E 9101            	   575:     subx.b  D1,D0   ; SBC ObjX,X
02:00038540 0A3C0010        	   576:     eori    #$10,CCR  ; restore X = 6502 C
                            	   577:     even
                            	   578: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   579:     ; If the difference in coordinates is negative, then Link is
                            	   580:     ; up or left of the block.
                            	   581:     ;
                            	   582:     ; In that case, increase Y register to index the correct opposite
                            	   583:     ; direction below. Also, negate the difference, so we test
                            	   584:     ; positive values.
                            	   585:     ;
02:00038544 6A06            	   586:     bpl  _anon_z04_14
02:00038546 5203            	   587:     addq.b  #1,D3
02:00038548 610083C8        	   588:     jsr     Negate
                            	   589: _anon_z04_14:
                            	   590:     ; If the distance >= $11, then go reset the push timer and return.
                            	   591:     ;
02:0003854C 0C000011        	   592:     cmpi.b  #$11,D0
02:00038550 6502            	   593:     bcs.s  __far_z_04_0002
02:00038552 605A            	   594:     jmp  ResetPushTimer
                            	   595: __far_z_04_0002:
                            	   596:     ; At this point, Link is aligned with the block.
                            	   597:     ;
                            	   598:     ; If the input direction is not the required direction based on
                            	   599:     ; Link's placement; then go reset the push timer and return.
                            	   600:     ;
02:00038554 102C03F8        	   601:     move.b  ($03F8,A4),D0
02:00038558 41F9000384AE    	   602:     lea     (BlockPushDirections).l,A0
02:0003855E 12303000        	   603:     move.b  (A0,D3.W),D1
02:00038562 B001            	   604:     cmp.b   D1,D0
02:00038564 6702            	   605:     beq.s  __far_z_04_0003
02:00038566 6046            	   606:     jmp  ResetPushTimer
                            	   607: __far_z_04_0003:
                            	   608:     ; Link is truly pushing the block.
                            	   609:     ;
                            	   610:     ; Increase the push timer.
                            	   611:     ;
02:00038568 41EC0412        	   612:     lea     ($0412,A4),A0
02:0003856C 52302000        	   613:     addq.b  #1,(A0,D2.W)
                            	   614:     ; If the push timer still < $10, return.
                            	   615:     ;
02:00038570 7600            	   616:     moveq   #0,D3
02:00038572 41EC0412        	   617:     lea     ($0412,A4),A0
02:00038576 16302000        	   618:     move.b  (A0,D2.W),D3
02:0003857A 0C030010        	   619:     cmpi.b  #$10,D3
02:0003857E 6402            	   620:     bcc.s  __far_z_04_0004
02:00038580 6032            	   621:     jmp  L10262_Exit
