02:00049AA6 0C000020        	  6797:     cmpi.b  #$20,D0
02:00049AAA 6624            	  6798:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:00049AAC 102C00AC        	  6799:     move.b  ($00AC,A4),D0
02:00049AB0 0200000F        	  6800:     andi.b #$0F,D0
02:00049AB4 6606            	  6801:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
                            	  6802:     even
