                            	 12498: Ganon_UpdateBrownState:
                            	 12499:     ; Every other frame decrement the state.
                            	 12500:     ; But every frame draw Ganon either translucent or opaque.
                            	 12501:     ;
02:0003F4F2 102C0015        	 12502:     move.b  ($0015,A4),D0
02:0003F4F6 E208            	 12503:     lsr.b  #1,D0   ; LSR A
02:0003F4F8 6410            	 12504:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003F4FA 41EC00AC        	 12505:     lea     ($00AC,A4),A0
02:0003F4FE 53302000        	 12506:     subq.b  #1,(A0,D2.W)
                            	 12507:     ; If the state becomes 0, then Ganon is blue again.
                            	 12508:     ; Go switch his palette row to reflect it.
