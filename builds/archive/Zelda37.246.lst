02:0004224E 6620            	  4093:     bne  _anon_z05_96
02:00042250 102C0001        	  4094:     move.b  ($0001,A4),D0
02:00042254 41F9000421AC    	  4095:     lea     (DoorwayBoundsMinUnder).l,A0
02:0004225A 12303000        	  4096:     move.b  (A0,D3.W),D1
02:0004225E B001            	  4097:     cmp.b   D1,D0
02:00042260 650E            	  4098:     bcs  _anon_z05_96
02:00042262 41F9000421B0    	  4099:     lea     (DoorwayBoundsMaxUnder).l,A0
02:00042268 12303000        	  4100:     move.b  (A0,D3.W),D1
02:0004226C B001            	  4101:     cmp.b   D1,D0
