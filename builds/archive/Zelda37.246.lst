                            	  9377:     ; If this segment is the base, then go draw.
                            	  9378:     ;
02:0003DE0C 0C020005        	  9379:     cmpi.b  #$05,D2
02:0003DE10 6736            	  9380:     beq  _L_z04_UpdateManhandla_Draw
                            	  9381:     ; If the old and new "frame image and sprite attributes" variables
                            	  9382:     ; are the same, then go draw.
                            	  9383:     ;
                            	  9384:     ; The previous frame value begins with value 0, because all
                            	  9385:     ; room data was reset on entry.
                            	  9386:     ;
02:0003DE12 41EC0478        	  9387:     lea     ($0478,A4),A0
02:0003DE16 10302000        	  9388:     move.b  (A0,D2.W),D0
02:0003DE1A 41EC0437        	  9389:     lea     ($0437,A4),A0
02:0003DE1E 12302000        	  9390:     move.b  (A0,D2.W),D1
02:0003DE22 B001            	  9391:     cmp.b   D1,D0
02:0003DE24 6722            	  9392:     beq  _L_z04_UpdateManhandla_Draw
