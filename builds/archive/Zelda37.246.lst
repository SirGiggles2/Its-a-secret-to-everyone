                            	 12202: PatraChild_State1:
                            	 12203:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 12204:     ;
02:0003F304 10342070        	 12205:     move.b  ($70,A4,D2.W),D0
02:0003F308 023C00EE        	 12206:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F30C 122C046C        	 12207:     move.b  ($046C,A4),D1
02:0003F310 D101            	 12208:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003F312 19802070        	 12209:     move.b  D0,($70,A4,D2.W)
02:0003F316 41EC0084        	 12210:     lea     ($0084,A4),A0
02:0003F31A 10302000        	 12211:     move.b  (A0,D2.W),D0
02:0003F31E 023C00EE        	 12212:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F322 122C0479        	 12213:     move.b  ($0479,A4),D1
02:0003F326 D101            	 12214:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003F328 41EC0084        	 12215:     lea     ($0084,A4),A0
02:0003F32C 11802000        	 12216:     move.b  D0,(A0,D2.W)
                            	 12217:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 12218:     ;
02:0003F330 7000            	 12219:     moveq   #0,D0
02:0003F332 1940000B        	 12220:     move.b  D0,($000B,A4)
                            	 12221:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 12222:     ; monster's angle by $70, else by $60 to go slower.
                            	 12223:     ;
02:0003F336 7070            	 12224:     moveq   #112,D0
02:0003F338 7600            	 12225:     moveq   #0,D3
02:0003F33A 41EC034F        	 12226:     lea     ($034F,A4),A0
02:0003F33E 16302000        	 12227:     move.b  (A0,D2.W),D3
02:0003F342 0C030025        	 12228:     cmpi.b  #$25,D3
02:0003F346 6702            	 12229:     beq  _anon_z04_159
02:0003F348 7060            	 12230:     moveq   #96,D0
                            	 12231: _anon_z04_159:
02:0003F34A 61000D9C        	 12232:     jsr     DecreaseObjectAngle
                            	 12233:     ; Load Patra's maneuver index.
                            	 12234:     ; It determines which counts of bits are looked up below.
                            	 12235:     ;
02:0003F34E 7600            	 12236:     moveq   #0,D3
02:0003F350 162C045F        	 12237:     move.b  ($045F,A4),D3
                            	 12238:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12239:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12240:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12241:     ;
02:0003F354 41EC034F        	 12242:     lea     ($034F,A4),A0
02:0003F358 10302000        	 12243:     move.b  (A0,D2.W),D0
02:0003F35C 0C000025        	 12244:     cmpi.b  #$25,D0
02:0003F360 661E            	 12245:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F362 41F90003F254    	 12246:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003F368 10303000        	 12247:     move.b  (A0,D3.W),D0
02:0003F36C 1B00            	 12248:     move.b  D0,-(A5)  ; PHA
02:0003F36E 41F90003F258    	 12249:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F374 10303000        	 12250:     move.b  (A0,D3.W),D0
02:0003F378 7600            	 12251:     moveq   #0,D3
02:0003F37A 1600            	 12252:     move.b  D0,D3
02:0003F37C 101D            	 12253:     move.b  (A5)+,D0  ; PLA
02:0003F37E 600E            	 12254:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12255: 
                            	 12256:     even
                            	 12257: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12258:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12259:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12260:     ; a small circle (5) and a large circle (6).
                            	 12261:     ;
02:0003F380 41F90003F256    	 12262:     lea     (PatraChild2RotationBits).l,A0
02:0003F386 10303000        	 12263:     move.b  (A0,D3.W),D0
02:0003F38A 7600            	 12264:     moveq   #0,D3
