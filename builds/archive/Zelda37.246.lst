02:0003F48A 6100A6F4        	 12426:     jsr     PlayBossHitCryIfNeeded
                            	 12427:     ; Go handle the brown state specially.
                            	 12428:     ;
02:0003F48E 41EC00AC        	 12429:     lea     ($00AC,A4),A0
