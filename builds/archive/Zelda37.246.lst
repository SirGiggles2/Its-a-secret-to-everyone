02:00044D94 162C0010        	  7973:     move.b  ($0010,A4),D3
02:00044D98 6700008C        	  7974:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7975:     ; In UW. There are two input directions, and they're both walkable.
                            	  7976:     ;
                            	  7977:     ; Normally, turn to the direction that's perpendicular to object
                            	  7978:     ; direction. But keep going straight after that, while diagonal
                            	  7979:     ; input is held.
                            	  7980:     ;
                            	  7981:     ; Handle special cases for doors.
                            	  7982:     ;
                            	  7983:     ;
                            	  7984:     ; 1. Link at horizontal doors.
                            	  7985:     ;
                            	  7986:     ; If Link's X = $20 or $D0 then
                            	  7987:     ;   If Link's Y = $85 and facing down then
                            	  7988:     ;     Go set object direction and input direction to object
                            	  7989:     ;     direction, and set Link's speed. Also, *RESET*
                            	  7990:     ;     Link_GoStraightWhenDiagInput.
                            	  7991:     ;   Else
                            	  7992:     ;     Go turn to the perpendicular direction
                            	  7993:     ;
