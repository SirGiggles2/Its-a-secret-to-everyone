                            	  6962: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6963:     ; Bloated timer =>
                            	  6964:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6965:     ; 1:     go advance the substate
                            	  6966:     ; other: go decrement Bloated timer
                            	  6967:     ;
02:0003CC3A 7600            	  6968:     moveq   #0,D3
02:0003CC3C 41EC045E        	  6969:     lea     ($045E,A4),A0
02:0003CC40 16302000        	  6970:     move.b  (A0,D2.W),D3
02:0003CC44 5303            	  6971:     subq.b  #1,D3
02:0003CC46 6750            	  6972:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003CC48 6B04            	  6973:     bmi.s  __far_z_04_0058
02:0003CC4A 60000080        	  6974:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6975: __far_z_04_0058:
                            	  6976:     ; Set the bloated timer according to the substate.
                            	  6977:     ;
02:0003CC4E 7600            	  6978:     moveq   #0,D3
02:0003CC50 41EC042C        	  6979:     lea     ($042C,A4),A0
02:0003CC54 16302000        	  6980:     move.b  (A0,D2.W),D3
02:0003CC58 41F90003CB96    	  6981:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003CC5E 10303000        	  6982:     move.b  (A0,D3.W),D0
02:0003CC62 41EC045E        	  6983:     lea     ($045E,A4),A0
02:0003CC66 11802000        	  6984:     move.b  D0,(A0,D2.W)
                            	  6985:     ; If substate <> 0, go decrement bloated timer.
                            	  6986:     ;
02:0003CC6A 4A03            	  6987:     cmpi.b  #$00,D3
02:0003CC6C 6702            	  6988:     beq.s  __far_z_04_0059
02:0003CC6E 605C            	  6989:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6990: __far_z_04_0059:
                            	  6991:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  6992:     ;
02:0003CC70 7610            	  6993:     moveq   #16,D3
02:0003CC72 7000            	  6994:     moveq   #0,D0
02:0003CC74 41EC00AC        	  6995:     lea     ($00AC,A4),A0
02:0003CC78 11803000        	  6996:     move.b  D0,(A0,D3.W)
                            	  6997:     ; Increment the number of bomb hits.
                            	  6998:     ;
02:0003CC7C 41EC0437        	  6999:     lea     ($0437,A4),A0
02:0003CC80 10302000        	  7000:     move.b  (A0,D2.W),D0
02:0003CC84 023C00EE        	  7001:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC88 123C0001        	  7002:     move.b  #$01,D1
02:0003CC8C D101            	  7003:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003CC8E 41EC0437        	  7004:     lea     ($0437,A4),A0
02:0003CC92 11802000        	  7005:     move.b  D0,(A0,D2.W)
02:0003CC96 6034            	  7006:     jmp     L_Dodongo_DecrementBloatedTimer
