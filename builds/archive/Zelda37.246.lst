02:00032638 6726            	  7343:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:0003263A 10343070        	  7344:     move.b  ($70,A4,D3.W),D0
02:0003263E 023C00EE        	  7345:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032642 123C0006        	  7346:     move.b  #$06,D1
02:00032646 D101            	  7347:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00032648 19400004        	  7348:     move.b  D0,($0004,A4)
02:0003264C 41EC0084        	  7349:     lea     ($0084,A4),A0
02:00032650 10303000        	  7350:     move.b  (A0,D3.W),D0
02:00032654 023C00EE        	  7351:     andi    #$EE,CCR  ; CLC: clear C+X
