                            	  5769: AnimateBoomerangAndCheckCollision:
                            	  5770:     ; Decrement animation counter; and when it reaches 0:
                            	  5771:     ; 1. arm it again for 2 frames
                            	  5772:     ; 2. advance the minor state within a cycle of 8
                            	  5773:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5774:     ;
02:0004C5B0 41EC03D0        	  5775:     lea     ($03D0,A4),A0
02:0004C5B4 53302000        	  5776:     subq.b  #1,(A0,D2.W)
02:0004C5B8 6702            	  5777:     beq.s  __far_z_07_0086
02:0004C5BA 6036            	  5778:     jmp  DrawBoomerangAndCheckCollision
                            	  5779: __far_z_07_0086:
02:0004C5BC 7002            	  5780:     moveq   #2,D0
02:0004C5BE 41EC03D0        	  5781:     lea     ($03D0,A4),A0
02:0004C5C2 11802000        	  5782:     move.b  D0,(A0,D2.W)
02:0004C5C6 41EC00AC        	  5783:     lea     ($00AC,A4),A0
02:0004C5CA 52302000        	  5784:     addq.b  #1,(A0,D2.W)
02:0004C5CE 41EC00AC        	  5785:     lea     ($00AC,A4),A0
02:0004C5D2 10302000        	  5786:     move.b  (A0,D2.W),D0
02:0004C5D6 02000077        	  5787:     andi.b #$77,D0
02:0004C5DA 41EC00AC        	  5788:     lea     ($00AC,A4),A0
02:0004C5DE 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:0004C5E2 0C02000D        	  5790:     cmpi.b  #$0D,D2
02:0004C5E6 6402            	  5791:     bcc.s  __far_z_07_0087
02:0004C5E8 6032            	  5792:     jmp  CalcBoomerangFrame
                            	  5793: __far_z_07_0087:
