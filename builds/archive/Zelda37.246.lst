02:0004BFB8 6604            	  4885:     bne  _anon_z07_24
02:0004BFBA 522C000F        	  4886:     addq.b  #1,($000F,A4)
                            	  4887: _anon_z07_24:
                            	  4888:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4889:     ;   $57 (sword shot) => $22
                            	  4890:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4891:     ;
02:0004BFBE 7622            	  4892:     moveq   #34,D3
02:0004BFC0 0C02000D        	  4893:     cmpi.b  #$0D,D2
02:0004BFC4 6410            	  4894:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BFC6 41EC034F        	  4895:     lea     ($034F,A4),A0
02:0004BFCA 10302000        	  4896:     move.b  (A0,D2.W),D0
02:0004BFCE 0C000057        	  4897:     cmpi.b  #$57,D0
02:0004BFD2 6710            	  4898:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
