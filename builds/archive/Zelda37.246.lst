                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:0004036A 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0004036E 02000010        	   426:     andi.b #$10,D0
02:00040372 6606            	   427:     bne.s  __far_z_05_0000
02:00040374 4EF90002D6E4    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:0004037A 102C0254        	   430:     move.b  ($0254,A4),D0
02:0004037E 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:00040380 102C0258        	   432:     move.b  ($0258,A4),D0
02:00040384 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:00040386 4EB90004A978    	   434:     jsr     HideAllSprites
02:0004038C 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0004038E 19400258        	   436:     move.b  D0,($0258,A4)
02:00040392 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:00040394 19400254        	   438:     move.b  D0,($0254,A4)
