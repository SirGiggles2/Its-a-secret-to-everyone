                            	  2846: __far_z_04_0023:
                            	  2847:     ; Distance < 3. Go to state 0.
                            	  2848:     ;
                            	  2849:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2850:     ;
02:0003AE24 4EB90004C928    	  2851:     jsr     ResetObjState
02:0003AE2A 7600            	  2852:     moveq   #0,D3
02:0003AE2C 41EC034F        	  2853:     lea     ($034F,A4),A0
02:0003AE30 16302000        	  2854:     move.b  (A0,D2.W),D3
02:0003AE34 0C030020        	  2855:     cmpi.b  #$20,D3
