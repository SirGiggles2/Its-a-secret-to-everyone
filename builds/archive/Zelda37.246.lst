02:0003F43E 7002            	 12371:     moveq   #2,D0
02:0003F440 19400601        	 12372:     move.b  D0,($0601,A4)
                            	 12373: _anon_z04_160:
02:0003F444 0A3C0001        	 12374:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F448 4E75            	 12375:     rts
                            	 12376: 
                            	 12377: ; Description:
                            	 12378: ; Lift up the Triforce of Courage while the room is light.
                            	 12379: ;
                            	 12380: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12381: ;
                            	 12382:     even
                            	 12383: Ganon_ScenePhase1:
02:0003F44A 701B            	 12384:     moveq   #27,D0
02:0003F44C 19400505        	 12385:     move.b  D0,($0505,A4)
                            	 12386:     ; If Link's timer hasn't expired, then go draw Ganon.
