02:00031BFA 10303000        	  5825:     move.b  (A0,D3.W),D0
02:00031BFE 6100022C        	  5826:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5827: _anon_z01_76:
                            	  5828:     ; If it's Link, write the sprites. He's never mirrored.
                            	  5829:     ;
02:00031C02 4A02            	  5830:     cmpi.b  #$00,D2
02:00031C04 6602            	  5831:     bne.s  __far_z_01_0050
02:00031C06 6014            	  5832:     jmp  Anim_WriteHorizontallyFlippableSpritePair
                            	  5833: __far_z_01_0050:
                            	  5834:     ; For other objects, the caller controls mirroring and flipping.
                            	  5835:     ;
                            	  5836:     ; If mirrored [0C], then draw it mirrored.
                            	  5837:     ; Else draw it horizontally flippable, controlled by [0F].
                            	  5838:     ;
02:00031C08 7600            	  5839:     moveq   #0,D3
02:00031C0A 162C000C        	  5840:     move.b  ($000C,A4),D3
02:00031C0E 6602            	  5841:     bne.s  __far_z_01_0051
02:00031C10 600A            	  5842:     jmp  Anim_WriteHorizontallyFlippableSpritePair
