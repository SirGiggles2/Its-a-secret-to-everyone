                            	  2202:     even
                            	  2203: InitWhirlwind:
02:0003022E 6000BA1A        	  2204:     jmp     c_init_whirlwind
                            	  2205: 
                            	  2206: SetUpWhirlwind:
02:00030232 6000B7C6        	  2207:     jmp     c_set_up_whirlwind
                            	  2208: 
                            	  2209: WhirlwindPrevRoomIdList:
02:00030236 36              	  2210:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:00030237 3B
02:00030238 73
02:00030239 44
02:0003023A 0A
02:0003023B 21
02:0003023C 41
02:0003023D 6C
