                            	 12101: UpdatePatraChild:
                            	 12102:     ; If state = 1, then go orbit.
                            	 12103:     ;
02:0003F25A 41EC00AC        	 12104:     lea     ($00AC,A4),A0
02:0003F25E 10302000        	 12105:     move.b  (A0,D2.W),D0
02:0003F262 6704            	 12106:     beq.s  __far_z_04_0114
