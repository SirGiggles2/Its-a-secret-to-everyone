02:0004C604 6602            	  5809:     bne.s  __far_z_07_0089
02:0004C606 6014            	  5810:     jmp  CalcBoomerangFrame
                            	  5811: __far_z_07_0089:
02:0004C608 7003            	  5812:     moveq   #3,D0
02:0004C60A 41EC03D0        	  5813:     lea     ($03D0,A4),A0
02:0004C60E 11802000        	  5814:     move.b  D0,(A0,D2.W)
02:0004C612 7020            	  5815:     moveq   #32,D0
02:0004C614 41EC00AC        	  5816:     lea     ($00AC,A4),A0
02:0004C618 11802000        	  5817:     move.b  D0,(A0,D2.W)
                            	  5818:     even
                            	  5819: CalcBoomerangFrame:
                            	  5820:     ; The minor state (low 3 bits of state) is used to
                            	  5821:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5822:     ;
                            	  5823:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5824:     ; In other words, don't offset the coordinate below.
                            	  5825:     ;
02:0004C61C 7000            	  5826:     moveq   #0,D0
02:0004C61E 1880            	  5827:     move.b  D0,($0000,A4)
02:0004C620 41EC00AC        	  5828:     lea     ($00AC,A4),A0
02:0004C624 10302000        	  5829:     move.b  (A0,D2.W),D0
