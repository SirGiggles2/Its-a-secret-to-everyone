                            	  4900:     even
                            	  4901: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4902:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4903:     ;   high bit set (magic)   => $23
                            	  4904:     ;   high bit clear (sword) => $22
