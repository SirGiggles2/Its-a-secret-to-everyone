02:0003C5E6 41F90003C49A    	  6170:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003C5EC 12303000        	  6171:     move.b  (A0,D3.W),D1
02:0003C5F0 D101            	  6172:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003C5F2 19802070        	  6173:     move.b  D0,($70,A4,D2.W)
02:0003C5F6 41EC0084        	  6174:     lea     ($0084,A4),A0
02:0003C5FA 10302000        	  6175:     move.b  (A0,D2.W),D0
02:0003C5FE 023C00EE        	  6176:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C602 41F90003C49E    	  6177:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003C608 12303000        	  6178:     move.b  (A0,D3.W),D1
02:0003C60C D101            	  6179:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003C60E 41EC0084        	  6180:     lea     ($0084,A4),A0
02:0003C612 11802000        	  6181:     move.b  D0,(A0,D2.W)
                            	  6182:     ; Check the room boundary and object collisions in this temporary location.
                            	  6183:     ;
