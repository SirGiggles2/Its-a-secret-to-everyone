                            	  3744: InitArmosOrFlyingGhini:
                            	  3745:     ; In UpdateObject, this object was flagged "initialized".
                            	  3746:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3747:     ;
02:0003B4B4 10342028        	  3748:     move.b  ($28,A4,D2.W),D0
02:0003B4B8 41EC0492        	  3749:     lea     ($0492,A4),A0
02:0003B4BC 11802000        	  3750:     move.b  D0,(A0,D2.W)
                            	  3751:     ; If it's still fading in, then go finish some initialization needed
                            	  3752:     ; for fading in.
                            	  3753:     ;
02:0003B4C0 660000B6        	  3754:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3755:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3756:     ; go finish initializing it.
                            	  3757:     ;
02:0003B4C4 41EC034F        	  3758:     lea     ($034F,A4),A0
02:0003B4C8 10302000        	  3759:     move.b  (A0,D2.W),D0
02:0003B4CC 0C000022        	  3760:     cmpi.b  #$22,D0
02:0003B4D0 670000A6        	  3761:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3762:     ; Else we have an armos.
                            	  3763:     ;
                            	  3764:     ; Store stairs tile $70 in [00] for use later.
                            	  3765:     ;
02:0003B4D4 7070            	  3766:     moveq   #112,D0
02:0003B4D6 1880            	  3767:     move.b  D0,($0000,A4)
                            	  3768:     ; Look for the current room ID in an array of room ID's that
                            	  3769:     ; have armos secrets.
                            	  3770:     ;
02:0003B4D8 7606            	  3771:     moveq   #6,D3
                            	  3772:     even
                            	  3773: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B4DA 102C00EB        	  3774:     move.b  ($00EB,A4),D0
                            	  3775:     ; If this element does not match the current room ID, go loop again.
                            	  3776:     ;
02:0003B4DE 41F90003B4A4    	  3777:     lea     (SecretArmosRoomIds).l,A0
02:0003B4E4 12303000        	  3778:     move.b  (A0,D3.W),D1
02:0003B4E8 B001            	  3779:     cmp.b   D1,D0
02:0003B4EA 6648            	  3780:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3781:     ; The secret (usually stairs) is under one of the armoses.
                            	  3782:     ;
                            	  3783:     ; If the armos's X coordinate does not match the one needed
                            	  3784:     ; for the current room in the list, then go loop again.
                            	  3785:     ;
02:0003B4EC 10342070        	  3786:     move.b  ($70,A4,D2.W),D0
02:0003B4F0 41F90003B4AC    	  3787:     lea     (SecretArmosXs).l,A0
02:0003B4F6 12303000        	  3788:     move.b  (A0,D3.W),D1
02:0003B4FA B001            	  3789:     cmp.b   D1,D0
02:0003B4FC 6636            	  3790:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3791:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3792:     ;
02:0003B4FE 41EC0084        	  3793:     lea     ($0084,A4),A0
02:0003B502 10302000        	  3794:     move.b  (A0,D2.W),D0
02:0003B506 0C000080        	  3795:     cmpi.b  #$80,D0
02:0003B50A 6628            	  3796:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3797:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3798:     ;
02:0003B50C 4A03            	  3799:     cmpi.b  #$00,D3
02:0003B50E 662C            	  3800:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3801:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3802:     ; has the power bracelet.
                            	  3803:     ;
                            	  3804:     ; Set up the room item with the armos's coordinates.
                            	  3805:     ;
02:0003B510 19400097        	  3806:     move.b  D0,($0097,A4)
02:0003B514 10342070        	  3807:     move.b  ($70,A4,D2.W),D0
02:0003B518 19400083        	  3808:     move.b  D0,($0083,A4)
                            	  3809:     ; This resets the room item's state, which activates it.
                            	  3810:     ;
02:0003B51C 194300BF        	  3811:     move.b  D3,($00BF,A4)
                            	  3812:     ; Set the room item ID.
                            	  3813:     ;
02:0003B520 7014            	  3814:     moveq   #20,D0
02:0003B522 194000AB        	  3815:     move.b  D0,($00AB,A4)
                            	  3816:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3817:     ;
                            	  3818:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3819:     ;
                            	  3820:     ; Note that, if the item was already taken, then the room item
                            	  3821:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3822:     ; it will be ignored, because that routine checks whether
                            	  3823:     ; the item was taken.
                            	  3824:     ;
02:0003B526 4EB9000314E0    	  3825:     jsr     GetRoomFlagUWItemState
02:0003B52C 660A            	  3826:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B52E 6100069E        	  3827:     jsr     PlaySecretFoundTune
02:0003B532 6604            	  3828:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3829:     even
                            	  3830: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3831:     ; Bottom of the loop.
                            	  3832:     ;
02:0003B534 5303            	  3833:     subq.b  #1,D3
02:0003B536 6AA2            	  3834:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3835:     even
