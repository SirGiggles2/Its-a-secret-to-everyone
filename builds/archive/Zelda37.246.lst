                            	  3716: ; Params:
                            	  3717: ; A: frame image
                            	  3718: ; X: object index
                            	  3719: ; [00]: object X
                            	  3720: ; [01]: object Y
                            	  3721: ; [0F]: flip horizontally
                            	  3722: ;
                            	  3723: ; Returns:
                            	  3724: ; [00]: 0 for Link slot
