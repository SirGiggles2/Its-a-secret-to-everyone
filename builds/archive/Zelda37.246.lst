02:0003F71A 101D            	 12784:     move.b  (A5)+,D0  ; PLA
02:0003F71C 19400340        	 12785:     move.b  D0,($0340,A4)
02:0003F720 0A3C0001        	 12786:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F724 4E75            	 12787:     rts
