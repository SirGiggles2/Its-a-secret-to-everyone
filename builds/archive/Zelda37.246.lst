02:0003B540 0C000070        	  3848:     cmpi.b  #$70,D0
02:0003B544 6604            	  3849:     bne  _anon_z04_51
02:0003B546 61000686        	  3850:     jsr     PlaySecretFoundTune
                            	  3851: _anon_z04_51:
                            	  3852:     ; Replace the tile where the armos was.
                            	  3853:     ;
02:0003B54A 522C00F7        	  3854:     addq.b  #1,($00F7,A4)
02:0003B54E 101D            	  3855:     move.b  (A5)+,D0  ; PLA
02:0003B550 4EB90004ADEC    	  3856:     jsr     ChangeTileObjTiles
                            	  3857:     ; Because the armos object is aligned to the square grid
                            	  3858:     ; (because it was made from a square),
                            	  3859:     ; set its grid offset to 3 to compensate.
                            	  3860:     ;
                            	  3861:     ; Most objects are aligned to the grid vertically when the
                            	  3862:     ; low nibble is $D.
                            	  3863:     ;
02:0003B556 7003            	  3864:     moveq   #3,D0
02:0003B558 41EC0394        	  3865:     lea     ($0394,A4),A0
02:0003B55C 11802000        	  3866:     move.b  D0,(A0,D2.W)
                            	  3867:     ; Set a speed (q-speed fraction) randomly:
                            	  3868:     ; $20 if random value < $80
                            	  3869:     ; $60 otherwise
                            	  3870:     ;
02:0003B560 7020            	  3871:     moveq   #32,D0
02:0003B562 7600            	  3872:     moveq   #0,D3
02:0003B564 16342019        	  3873:     move.b  ($19,A4,D2.W),D3
02:0003B568 0C030080        	  3874:     cmpi.b  #$80,D3
