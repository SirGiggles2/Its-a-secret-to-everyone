02:0003F2E6 102C0085        	 12189:     move.b  ($0085,A4),D0
02:0003F2EA 003C0011        	 12190:     ori     #$11,CCR  ; SEC: set C+X
02:0003F2EE 1214            	 12191:     move.b  ($0000,A4),D1
02:0003F2F0 0A3C0010        	 12192:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F2F4 9101            	 12193:     subx.b  D1,D0   ; SBC $00
02:0003F2F6 0A3C0010        	 12194:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F2FA 41EC0084        	 12195:     lea     ($0084,A4),A0
02:0003F2FE 11802000        	 12196:     move.b  D0,(A0,D2.W)
                            	 12197:     even
