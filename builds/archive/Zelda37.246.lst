02:00043A2A 101D            	  5964:     move.b  (A5)+,D0  ; PLA
                            	  5965: _anon_z05_125:
                            	  5966:     ; Calculate the door face index in three parts.
                            	  5967:     ;
                            	  5968:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5969:     ; (provisional face index in Y register).
                            	  5970:     ;
02:00043A2C 0C000004        	  5971:     cmpi.b  #$04,D0
02:00043A30 6602            	  5972:     bne  _anon_z05_126
02:00043A32 7008            	  5973:     moveq   #8,D0
                            	  5974: _anon_z05_126:
02:00043A34 0C000001        	  5975:     cmpi.b  #$01,D0
02:00043A38 6602            	  5976:     bne  _anon_z05_127
02:00043A3A 7004            	  5977:     moveq   #4,D0
                            	  5978: _anon_z05_127:
                            	  5979:     ; Second, subtract 3 from provisional face index.
                            	  5980:     ;
02:00043A3C 003C0011        	  5981:     ori     #$11,CCR  ; SEC: set C+X
02:00043A40 123C0003        	  5982:     move.b  #$03,D1
02:00043A44 0A3C0010        	  5983:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A48 9101            	  5984:     subx.b  D1,D0   ; SBC #$03
02:00043A4A 0A3C0010        	  5985:     eori    #$10,CCR  ; restore X = 6502 C
02:00043A4E 7600            	  5986:     moveq   #0,D3
02:00043A50 1600            	  5987:     move.b  D0,D3
                            	  5988:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5989:     ; face index >= 3, then subtract 1 from it.
                            	  5990:     ;
                            	  5991:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5992:     ; then make it 1.
                            	  5993:     ;
02:00043A52 102C0008        	  5994:     move.b  ($0008,A4),D0
02:00043A56 6708            	  5995:     beq  _anon_z05_128
02:00043A58 0C030005        	  5996:     cmpi.b  #$05,D3
02:00043A5C 670A            	  5997:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043A5E 7601            	  5998:     moveq   #1,D3
                            	  5999: _anon_z05_128:
02:00043A60 0C030003        	  6000:     cmpi.b  #$03,D3
02:00043A64 6502            	  6001:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00043A66 5303            	  6002:     subq.b  #1,D3
                            	  6003:     even
                            	  6004: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6005:     ; The routine that returned the door type also returned its
                            	  6006:     ; reverse direction index in [03].
                            	  6007:     ;
                            	  6008:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6009:     ;
02:00043A68 7003            	  6010:     moveq   #3,D0
02:00043A6A 003C0011        	  6011:     ori     #$11,CCR  ; SEC: set C+X
02:00043A6E 122C0003        	  6012:     move.b  ($0003,A4),D1
02:00043A72 0A3C0010        	  6013:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043A76 9101            	  6014:     subx.b  D1,D0   ; SBC $03
02:00043A78 0A3C0010        	  6015:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6016:     ; Call this to put the address of door face tiles in [02:03].
                            	  6017:     ;
02:00043A7C 6100FD7A        	  6018:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6019:     ; Return the address of the door in the nametable in [01:00].
                            	  6020:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6021:     ;
02:00043A80 41F900043856    	  6022:     lea     (DoorVramAddrsHi).l,A0
02:00043A86 10302000        	  6023:     move.b  (A0,D2.W),D0
02:00043A8A 1880            	  6024:     move.b  D0,($0000,A4)
02:00043A8C 41F90004385A    	  6025:     lea     (DoorVramAddrsLo).l,A0
02:00043A92 10302000        	  6026:     move.b  (A0,D2.W),D0
02:00043A96 19400001        	  6027:     move.b  D0,($0001,A4)
                            	  6028:     ; Return the direction of the door in [09], and the dynamic
                            	  6029:     ; transfer buf length in X register.
                            	  6030:     ;
02:00043A9A 19420009        	  6031:     move.b  D2,($0009,A4)
02:00043A9E 7400            	  6032:     moveq   #0,D2
02:00043AA0 142C0301        	  6033:     move.b  ($0301,A4),D2
                            	  6034:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6035:     ;
02:00043AA4 7000            	  6036:     moveq   #0,D0
02:00043AA6 19400007        	  6037:     move.b  D0,($0007,A4)
02:00043AAA 7002            	  6038:     moveq   #2,D0
02:00043AAC 19400006        	  6039:     move.b  D0,($0006,A4)
02:00043AB0 19400005        	  6040:     move.b  D0,($0005,A4)
02:00043AB4 0A3C0001        	  6041:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043AB8 4E75            	  6042:     rts
