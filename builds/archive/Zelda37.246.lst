                            	  7217:     ; Copy the object type, so that it can be used in setting up
                            	  7218:     ; a dropped item.
                            	  7219:     ;
02:0004D0C8 41EC034F        	  7220:     lea     ($034F,A4),A0
02:0004D0CC 10302000        	  7221:     move.b  (A0,D2.W),D0
