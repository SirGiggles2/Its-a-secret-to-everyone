02:0004BF84 101D            	  4864:     move.b  (A5)+,D0  ; PLA
                            	  4865:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4866:     ; This makes the shot flash by cycling all the palettes, one each frame.
