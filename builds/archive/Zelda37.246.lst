02:0003F2A4 6604            	 12152:     bne  _anon_z04_157
02:0003F2A6 522C00AD        	 12153:     addq.b  #1,($00AD,A4)
                            	 12154: _anon_z04_157:
                            	 12155:     ; Go to state 1 to orbit.
                            	 12156:     ;
02:0003F2AA 41EC00AC        	 12157:     lea     ($00AC,A4),A0
02:0003F2AE 52302000        	 12158:     addq.b  #1,(A0,D2.W)
                            	 12159:     ; TODO: ?
                            	 12160:     ;
02:0003F2B2 103C0080        	 12161:     move.b  #$80,D0
02:0003F2B6 41EC0098        	 12162:     lea     ($0098,A4),A0
02:0003F2BA 11802000        	 12163:     move.b  D0,(A0,D2.W)
                            	 12164:     ; Set angle $18 (N).
                            	 12165:     ;
02:0003F2BE 7018            	 12166:     moveq   #24,D0
02:0003F2C0 41EC0394        	 12167:     lea     ($0394,A4),A0
02:0003F2C4 11802000        	 12168:     move.b  D0,(A0,D2.W)
                            	 12169:     ; This location is right above Patra.
                            	 12170:     ; Set X coordinate to Patra's.
                            	 12171:     ;
02:0003F2C8 102C0071        	 12172:     move.b  ($0071,A4),D0
02:0003F2CC 19802070        	 12173:     move.b  D0,($70,A4,D2.W)
                            	 12174:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12175:     ; Else use radius $18. Store the chosen value in [00].
                            	 12176:     ;
02:0003F2D0 702C            	 12177:     moveq   #44,D0
02:0003F2D2 7600            	 12178:     moveq   #0,D3
02:0003F2D4 41EC034F        	 12179:     lea     ($034F,A4),A0
02:0003F2D8 16302000        	 12180:     move.b  (A0,D2.W),D3
02:0003F2DC 0C030025        	 12181:     cmpi.b  #$25,D3
02:0003F2E0 6702            	 12182:     beq  _anon_z04_158
02:0003F2E2 7018            	 12183:     moveq   #24,D0
                            	 12184: _anon_z04_158:
02:0003F2E4 1880            	 12185:     move.b  D0,($0000,A4)
