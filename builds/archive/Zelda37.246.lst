02:0003CD08 123C0010        	  7076:     move.b  #$10,D1
02:0003CD0C D101            	  7077:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD0E 19802070        	  7078:     move.b  D0,($70,A4,D2.W)
