02:0003F558 123C0007        	 12566:     move.b  #$07,D1
02:0003F55C D101            	 12567:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003F55E 19802070        	 12568:     move.b  D0,($70,A4,D2.W)
02:0003F562 41EC0084        	 12569:     lea     ($0084,A4),A0
02:0003F566 10302000        	 12570:     move.b  (A0,D2.W),D0
02:0003F56A 123C0008        	 12571:     move.b  #$08,D1
02:0003F56E D101            	 12572:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F570 41EC0084        	 12573:     lea     ($0084,A4),A0
02:0003F574 11802000        	 12574:     move.b  D0,(A0,D2.W)
