02:0003F6EA 102C0015        	 12767:     move.b  ($0015,A4),D0
02:0003F6EE 02000003        	 12768:     andi.b #$03,D0
02:0003F6F2 41F90003F5C2    	 12769:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F6F8 12302000        	 12770:     move.b  (A0,D2.W),D1
02:0003F6FC 8001            	 12771:     or.b  D1,D0
02:0003F6FE 19400003        	 12772:     move.b  D0,($0003,A4)
02:0003F702 41F90003F5CC    	 12773:     lea     (GanonBurstTiles).l,A0
02:0003F708 10302000        	 12774:     move.b  (A0,D2.W),D0
02:0003F70C 4EB900031E36    	 12775:     jsr     Anim_WriteSprite
