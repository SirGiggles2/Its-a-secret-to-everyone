02:00033A58 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033A5C 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:00033A5E 1002            	   594:     move.b  D2,D0
02:00033A60 E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:00033A62 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
02:00033A64 101D            	   601:     move.b  (A5)+,D0  ; PLA
02:00033A66 020000F0        	   602:     andi.b #$F0,D0
02:00033A6A 1940000C        	   603:     move.b  D0,($000C,A4)
02:00033A6E E208            	   604:     lsr.b  #1,D0   ; LSR A
02:00033A70 E208            	   605:     lsr.b  #1,D0   ; LSR A
02:00033A72 E208            	   606:     lsr.b  #1,D0   ; LSR A
02:00033A74 E208            	   607:     lsr.b  #1,D0   ; LSR A
02:00033A76 122C000C        	   608:     move.b  ($000C,A4),D1
02:00033A7A 8001            	   609:     or.b  D1,D0
02:00033A7C 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
