                            	  2213: UpdateWhirlwind_Full:
                            	  2214:     ; Get Link's halted state.
                            	  2215:     ;
02:0003023E 102C00AC        	  2216:     move.b  ($00AC,A4),D0
02:00030242 02000040        	  2217:     andi.b #$40,D0
02:00030246 7600            	  2218:     moveq   #0,D3
02:00030248 1600            	  2219:     move.b  D0,D3
                            	  2220:     ; Add 2 to whirlwind X.
                            	  2221:     ;
02:0003024A 7002            	  2222:     moveq   #2,D0
02:0003024C 023C00EE        	  2223:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030250 12342070        	  2224:     move.b  ($70,A4,D2.W),D1
02:00030254 D101            	  2225:     addx.b  D1,D0   ; ADC ObjX,X
02:00030256 19802070        	  2226:     move.b  D0,($70,A4,D2.W)
                            	  2227:     ; If Link is not halted or teleporting state = 0, then
                            	  2228:     ; go check for collision with Link.
                            	  2229:     ;
02:0003025A 0C030040        	  2230:     cmpi.b  #$40,D3
02:0003025E 6638            	  2231:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:00030260 7600            	  2232:     moveq   #0,D3
02:00030262 162C0522        	  2233:     move.b  ($0522,A4),D3
02:00030266 6730            	  2234:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2235:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2236:     ;
                            	  2237:     ; Set Link's X to whirlwind's.
                            	  2238:     ;
02:00030268 19400070        	  2239:     move.b  D0,($0070,A4)
                            	  2240:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2241:     ; the right screen edge and draw.
                            	  2242:     ;
02:0003026C 5303            	  2243:     subq.b  #1,D3
02:0003026E 6776            	  2244:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:00030270 0C000080        	  2245:     cmpi.b  #$80,D0
02:00030274 6670            	  2246:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2247:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2248:     ;
                            	  2249:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2250:     ;
02:00030276 E308            	  2251:     lsl.b  #1,D0   ; ASL A
02:00030278 194000AC        	  2252:     move.b  D0,($00AC,A4)
02:0003027C 19400522        	  2253:     move.b  D0,($0522,A4)
02:00030280 41EC034F        	  2254:     lea     ($034F,A4),A0
02:00030284 11802000        	  2255:     move.b  D0,(A0,D2.W)
                            	  2256:     ; Update the player position marker, and draw one last time.
                            	  2257:     ;
02:00030288 1002            	  2258:     move.b  D2,D0
02:0003028A 1B00            	  2259:     move.b  D0,-(A5)  ; PHA
02:0003028C 61001096        	  2260:     jsr     UpdatePlayerPositionMarker
02:00030290 101D            	  2261:     move.b  (A5)+,D0  ; PLA
02:00030292 7400            	  2262:     moveq   #0,D2
02:00030294 1400            	  2263:     move.b  D0,D2
02:00030296 6070            	  2264:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2265: 
                            	  2266:     even
                            	  2267: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2268:     ; Link is not halted or teleporting state = 0.
                            	  2269:     ; Try to pick up Link.
                            	  2270:     ;
                            	  2271:     ; If the whirlwind does not collide with Link, then go check
                            	  2272:     ; for the screen's right edge.
                            	  2273:     ;
02:00030298 61001D66        	  2274:     jsr     CheckLinkCollision
02:0003029C 102C0006        	  2275:     move.b  ($0006,A4),D0
02:000302A0 6744            	  2276:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2277:     ; Collided with Link.
                            	  2278:     ;
                            	  2279:     ; Make Link face right. Reset shove info and subroom type.
                            	  2280:     ;
02:000302A2 7001            	  2281:     moveq   #1,D0
02:000302A4 19400098        	  2282:     move.b  D0,($0098,A4)
02:000302A8 E208            	  2283:     lsr.b  #1,D0   ; LSR A
02:000302AA 194000C0        	  2284:     move.b  D0,($00C0,A4)
02:000302AE 194000D3        	  2285:     move.b  D0,($00D3,A4)
02:000302B2 1940005A        	  2286:     move.b  D0,($005A,A4)
                            	  2287:     ; Halt Link (state $40), and hide him.
                            	  2288:     ;
02:000302B6 7040            	  2289:     moveq   #64,D0
02:000302B8 194000AC        	  2290:     move.b  D0,($00AC,A4)
02:000302BC 103C00F8        	  2291:     move.b  #$F8,D0
02:000302C0 19400248        	  2292:     move.b  D0,($0248,A4)
02:000302C4 1940024C        	  2293:     move.b  D0,($024C,A4)
                            	  2294:     ; Find and set the room that will behave as the previous room
                            	  2295:     ; when scrolling right to the room with the level's entrance.
                            	  2296:     ;
02:000302C8 102C0523        	  2297:     move.b  ($0523,A4),D0
02:000302CC 02000007        	  2298:     andi.b #$07,D0
02:000302D0 7600            	  2299:     moveq   #0,D3
02:000302D2 1600            	  2300:     move.b  D0,D3
02:000302D4 41F900030236    	  2301:     lea     (WhirlwindPrevRoomIdList).l,A0
02:000302DA 10303000        	  2302:     move.b  (A0,D3.W),D0
02:000302DE 194000EA        	  2303:     move.b  D0,($00EA,A4)
                            	  2304:     ; Set teleporting state 1.
                            	  2305:     ;
02:000302E2 522C0522        	  2306:     addq.b  #1,($0522,A4)
                            	  2307:     even
                            	  2308: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  2309:     ; If whirlwind's X < $F0, go draw.
                            	  2310:     ;
02:000302E6 10342070        	  2311:     move.b  ($70,A4,D2.W),D0
02:000302EA 0C0000F0        	  2312:     cmpi.b  #$F0,D0
02:000302EE 6518            	  2313:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  2314:     ; The whirlwind has reached the right edge of the screen.
                            	  2315:     ;
                            	  2316:     ; Destroy the object.
                            	  2317:     ;
02:000302F0 611A            	  2318:     jsr     DestroyWhirlwind
                            	  2319:     ; If teleporting state <> 0, we picked up Link.
                            	  2320:     ; So, go to the next mode.
                            	  2321:     ;
                            	  2322:     ; Either way, draw one last time.
                            	  2323:     ;
02:000302F2 102C0522        	  2324:     move.b  ($0522,A4),D0
02:000302F6 6710            	  2325:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:000302F8 1002            	  2326:     move.b  D2,D0
02:000302FA 1B00            	  2327:     move.b  D0,-(A5)  ; PHA
02:000302FC 4EB90004BC04    	  2328:     jsr     GoToNextModeFromPlay
02:00030302 101D            	  2329:     move.b  (A5)+,D0  ; PLA
02:00030304 7400            	  2330:     moveq   #0,D2
02:00030306 1400            	  2331:     move.b  D0,D2
                            	  2332:     even
                            	  2333: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030308 600000A8        	  2334:     jmp     DrawWhirlwind
                            	  2335: 
                            	  2336:     even
                            	  2337: DestroyWhirlwind:
02:0003030C 6000B506        	  2338:     jmp     c_destroy_whirlwind
                            	  2339: 
                            	  2340: SummonWhirlwind:
                            	  2341:     ; If not in mode 5, return.
                            	  2342:     ;
02:00030310 102C0012        	  2343:     move.b  ($0012,A4),D0
02:00030314 0C000005        	  2344:     cmpi.b  #$05,D0
02:00030318 6704            	  2345:     beq.s  __far_z_01_0012
02:0003031A 60000094        	  2346:     jmp  L6104_Exit
                            	  2347: __far_z_01_0012:
                            	  2348:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2349:     ;
02:0003031E 6178            	  2350:     jsr     AdvanceTeleportingLevelIndex
02:00030320 102C0523        	  2351:     move.b  ($0523,A4),D0
02:00030324 02000007        	  2352:     andi.b #$07,D0
02:00030328 7600            	  2353:     moveq   #0,D3
02:0003032A 1600            	  2354:     move.b  D0,D3
02:0003032C 41F90004AB1C    	  2355:     lea     (LevelMasks).l,A0
02:00030332 10303000        	  2356:     move.b  (A0,D3.W),D0
02:00030336 1880            	  2357:     move.b  D0,($0000,A4)
                            	  2358:     even
                            	  2359: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2360:     ; If there are no triforce pieces, then return.
                            	  2361:     ;
02:00030338 102C0671        	  2362:     move.b  ($0671,A4),D0
02:0003033C 6602            	  2363:     bne.s  __far_z_01_0013
02:0003033E 6070            	  2364:     jmp  L6104_Exit
                            	  2365: __far_z_01_0013:
                            	  2366:     ; If we have gotten this triforce piece, then go try to make a
                            	  2367:     ; whirlwind.
                            	  2368:     ;
02:00030340 1214            	  2369:     move.b  ($0000,A4),D1
02:00030342 C200            	  2370:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00030344 662C            	  2371:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2372:     ; We have not gotten this piece.
                            	  2373:     ; First, advance the teleporting index again.
                            	  2374:     ;
02:00030346 6150            	  2375:     jsr     AdvanceTeleportingLevelIndex
                            	  2376:     ; If the direction Link is facing is an increasing one, then
                            	  2377:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2378:     ; level number. Then go test this new mask.
                            	  2379:     ;
02:00030348 102C0098        	  2380:     move.b  ($0098,A4),D0
02:0003034C 02000009        	  2381:     andi.b #$09,D0
02:00030350 6710            	  2382:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:00030352 1214            	  2383:     move.b  ($0000,A4),D1
02:00030354 E309            	  2384:     lsl.b  #1,D1   ; ASL $00
02:00030356 1881            	  2385:     move.b  D1,($0000,A4)
02:00030358 64DE            	  2386:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0003035A 1214            	  2387:     move.b  ($0000,A4),D1
02:0003035C E311            	  2388:     roxl.b  #1,D1   ; ROL $00
02:0003035E 1881            	  2389:     move.b  D1,($0000,A4)
02:00030360 60D6            	  2390:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2391: 
                            	  2392:     even
                            	  2393: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2394:     ; If instead the direction is a decreasing one, then
                            	  2395:     ; rotate right to correspond to the lower level number.
                            	  2396:     ; Then go test this new mask.
                            	  2397:     ;
02:00030362 1214            	  2398:     move.b  ($0000,A4),D1
02:00030364 E209            	  2399:     lsr.b  #1,D1   ; LSR $00
02:00030366 1881            	  2400:     move.b  D1,($0000,A4)
02:00030368 64CE            	  2401:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:0003036A 1214            	  2402:     move.b  ($0000,A4),D1
02:0003036C E211            	  2403:     roxr.b  #1,D1   ; ROR $00
02:0003036E 1881            	  2404:     move.b  D1,($0000,A4)
02:00030370 60C6            	  2405:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2406: 
                            	  2407:     even
                            	  2408: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  2409:     ; If already summoned or in the middle of teleporting, then
                            	  2410:     ; return and don't summon another one.
                            	  2411:     ;
02:00030372 102C0508        	  2412:     move.b  ($0508,A4),D0
02:00030376 122C0522        	  2413:     move.b  ($0522,A4),D1
02:0003037A 8001            	  2414:     or.b  D1,D0
02:0003037C 6702            	  2415:     beq.s  __far_z_01_0014
02:0003037E 6030            	  2416:     jmp  L6104_Exit
                            	  2417: __far_z_01_0014:
                            	  2418:     ; Return if we can't find an empty monster slot.
                            	  2419:     ;
02:00030380 4EB90004D572    	  2420:     jsr     FindEmptyMonsterSlot
02:00030386 6602            	  2421:     bne.s  __far_z_01_0015
02:00030388 6026            	  2422:     jmp  L6104_Exit
                            	  2423: __far_z_01_0015:
                            	  2424:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  2425:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  2426:     ;
02:0003038A 522C0508        	  2427:     addq.b  #1,($0508,A4)
02:0003038E 1003            	  2428:     move.b  D3,D0
02:00030390 7400            	  2429:     moveq   #0,D2
02:00030392 1400            	  2430:     move.b  D0,D2
02:00030394 6000FE9C        	  2431:     jmp     SetUpWhirlwind
                            	  2432: 
                            	  2433:     even
                            	  2434: AdvanceTeleportingLevelIndex:
                            	  2435:     ; If Link is facing an increasing direction (right or down), then
                            	  2436:     ; increase the index. Otherwise, decrease it.
                            	  2437:     ;
02:00030398 522C0523        	  2438:     addq.b  #1,($0523,A4)
02:0003039C 102C0098        	  2439:     move.b  ($0098,A4),D0
02:000303A0 02000009        	  2440:     andi.b #$09,D0
02:000303A4 6702            	  2441:     beq.s  __far_z_01_0016
