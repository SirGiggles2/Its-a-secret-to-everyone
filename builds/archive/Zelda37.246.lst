02:000339F2 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000339F6 E14C            	   559:     lsl.w   #8,D4
02:000339F8 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
