02:0003E0C0 52302000        	  9755:     addq.b  #1,(A0,D2.W)
                            	  9756:     ; Set a direction mask in [02], starting with right (1).
                            	  9757:     ;
02:0003E0C4 7001            	  9758:     moveq   #1,D0
02:0003E0C6 19400002        	  9759:     move.b  D0,($0002,A4)
                            	  9760:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9761:     ;
