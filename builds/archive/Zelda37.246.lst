02:00044D9E 162C0070        	  7995:     move.b  ($0070,A4),D3
02:00044DA2 0C030020        	  7996:     cmpi.b  #$20,D3
02:00044DA6 6706            	  7997:     beq  _anon_z05_175
02:00044DA8 0C0300D0        	  7998:     cmpi.b  #$D0,D3
