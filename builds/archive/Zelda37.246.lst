02:00041E30 102C0084        	  3479:     move.b  ($0084,A4),D0
02:00041E34 023C00EE        	  3480:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041E38 123C0003        	  3481:     move.b  #$03,D1
02:00041E3C D101            	  3482:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041E3E 003C0011        	  3483:     ori     #$11,CCR  ; SEC: set C+X
02:00041E42 41EC0084        	  3484:     lea     ($0084,A4),A0
02:00041E46 12302000        	  3485:     move.b  (A0,D2.W),D1
02:00041E4A 0A3C0010        	  3486:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041E4E 9101            	  3487:     subx.b  D1,D0   ; SBC ObjY,X
02:00041E50 0A3C0010        	  3488:     eori    #$10,CCR  ; restore X = 6502 C
02:00041E54 6030            	  3489:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3490: 
                            	  3491: _anon_z05_85:
                            	  3492:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3493:     ; between the ladder and Link.
                            	  3494:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3495:     ;
02:00041E56 102C0084        	  3496:     move.b  ($0084,A4),D0
02:00041E5A 023C00EE        	  3497:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041E5E 123C0003        	  3498:     move.b  #$03,D1
02:00041E62 D101            	  3499:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041E64 41EC0084        	  3500:     lea     ($0084,A4),A0
02:00041E68 12302000        	  3501:     move.b  (A0,D2.W),D1
02:00041E6C B001            	  3502:     cmp.b   D1,D0
02:00041E6E 6648            	  3503:     bne  _L_z05_CheckLadder_StashLadder
02:00041E70 102C0070        	  3504:     move.b  ($0070,A4),D0
02:00041E74 003C0011        	  3505:     ori     #$11,CCR  ; SEC: set C+X
02:00041E78 12342070        	  3506:     move.b  ($70,A4,D2.W),D1
02:00041E7C 0A3C0010        	  3507:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041E80 9101            	  3508:     subx.b  D1,D0   ; SBC ObjX,X
02:00041E82 0A3C0010        	  3509:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3510:     even
                            	  3511: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3512:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3513:     ; If > $10, go put the ladder away.
                            	  3514:     ;
02:00041E86 4EB900030FE6    	  3515:     jsr     Abs
02:00041E8C 1880            	  3516:     move.b  D0,($0000,A4)
02:00041E8E 0C000010        	  3517:     cmpi.b  #$10,D0
02:00041E92 6532            	  3518:     bcs  _L_z05_CheckLadder_SetState2
02:00041E94 0C000010        	  3519:     cmpi.b  #$10,D0
02:00041E98 661E            	  3520:     bne  _L_z05_CheckLadder_StashLadder
                            	  3521:     ; Distance = $10. If player's not facing in the same direction as
                            	  3522:     ; the ladder, go put away the ladder.
                            	  3523:     ;
02:00041E9A 102C0098        	  3524:     move.b  ($0098,A4),D0
02:00041E9E 41EC0098        	  3525:     lea     ($0098,A4),A0
02:00041EA2 12302000        	  3526:     move.b  (A0,D2.W),D1
02:00041EA6 B001            	  3527:     cmp.b   D1,D0
02:00041EA8 660E            	  3528:     bne  _L_z05_CheckLadder_StashLadder
                            	  3529:     ; Distance = $10, and player's facing in the same direction.
                            	  3530:     ;
                            	  3531:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3532:     ; ladder and had not stepped onto it yet.
                            	  3533:     ; Go handle movement on it, but don't change state yet.
                            	  3534:     ;
                            	  3535:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3536:     ; off of the ladder. So the ladder should be put away. In this
                            	  3537:     ; case, fall thru.
                            	  3538:     ;
02:00041EAA 41EC00AC        	  3539:     lea     ($00AC,A4),A0
02:00041EAE 10302000        	  3540:     move.b  (A0,D2.W),D0
02:00041EB2 0C000001        	  3541:     cmpi.b  #$01,D0
02:00041EB6 6718            	  3542:     beq  _L_z05_CheckLadder_HandleInput
                            	  3543:     even
                            	  3544: _L_z05_CheckLadder_StashLadder:
                            	  3545:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3546:     ;
02:00041EB8 7000            	  3547:     moveq   #0,D0
02:00041EBA 19400064        	  3548:     move.b  D0,($0064,A4)
02:00041EBE 4EB90004D566    	  3549:     jsr     DestroyMonster
                            	  3550:     even
                            	  3551: _L_z05_CheckLadder_Exit:
02:00041EC4 4E75            	  3552:     rts
                            	  3553: 
                            	  3554:     even
                            	  3555: _L_z05_CheckLadder_SetState2:
                            	  3556:     ;  Set state 2, because we're on the ladder.
                            	  3557:     ;
02:00041EC6 7002            	  3558:     moveq   #2,D0
02:00041EC8 41EC00AC        	  3559:     lea     ($00AC,A4),A0
02:00041ECC 11802000        	  3560:     move.b  D0,(A0,D2.W)
                            	  3561:     even
                            	  3562: _L_z05_CheckLadder_HandleInput:
                            	  3563:     ; If input direction = 0, go draw and reset moving direction.
                            	  3564:     ;
02:00041ED0 102C03F8        	  3565:     move.b  ($03F8,A4),D0
02:00041ED4 67000086        	  3566:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3567:     ; Input direction <> 0. The player intends to move.
                            	  3568:     ; So, see if we need to override the moving direction.
                            	  3569:     ;
                            	  3570:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3571:     ; go draw and set moving direction to Link's direction.
                            	  3572:     ;
                            	  3573:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3574:     ; been blocked by the water.
                            	  3575:     ;
                            	  3576:     ; Or, Link already passed over the point right over the ladder
                            	  3577:     ; and was allowed to move onto the tiles after the ladder.
                            	  3578:     ;
02:00041ED8 102C0098        	  3579:     move.b  ($0098,A4),D0
02:00041EDC 7600            	  3580:     moveq   #0,D3
02:00041EDE 1614            	  3581:     move.b  ($0000,A4),D3
02:00041EE0 670C            	  3582:     beq  _anon_z05_86
02:00041EE2 41EC0098        	  3583:     lea     ($0098,A4),A0
02:00041EE6 12302000        	  3584:     move.b  (A0,D2.W),D1
02:00041EEA B001            	  3585:     cmp.b   D1,D0
02:00041EEC 676E            	  3586:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3587: _anon_z05_86:
                            	  3588:     ; Distance = 0, or facing different directions.
                            	  3589:     ;
                            	  3590:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3591:     ; then go draw and keep moving.
                            	  3592:     ;
                            	  3593:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3594:     ;
                            	  3595:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3596:     ; to move onto the tiles after the ladder.
                            	  3597:     ;
                            	  3598:     ; Note that if Link is not moving, then this test will fail,
                            	  3599:     ; and case (D) will catch it.
                            	  3600:     ;
02:00041EEE 41EC0098        	  3601:     lea     ($0098,A4),A0
02:00041EF2 10302000        	  3602:     move.b  (A0,D2.W),D0
02:00041EF6 122C000F        	  3603:     move.b  ($000F,A4),D1
02:00041EFA B001            	  3604:     cmp.b   D1,D0
02:00041EFC 675E            	  3605:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3606:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3607:     ; then go draw and move in ladder's direction.
                            	  3608:     ;
                            	  3609:     ; You can always step off the ladder where you came from.
                            	  3610:     ;
02:00041EFE 4EB900030FE2    	  3611:     jsr     GetOppositeDir
02:00041F04 122C0098        	  3612:     move.b  ($0098,A4),D1
02:00041F08 B001            	  3613:     cmp.b   D1,D0
02:00041F0A 6750            	  3614:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3615:     ; D. If opposite of ladder's direction <> down,
                            	  3616:     ; or input direction <> up,
                            	  3617:     ; then go reset moving direction, and draw.
                            	  3618:     ;
                            	  3619:     ; This will catch all cases of Link facing perpendicular to
                            	  3620:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3621:     ; ladder direction is up and input direction is up (E).
                            	  3622:     ;
02:00041F0C 0C000004        	  3623:     cmpi.b  #$04,D0
02:00041F10 6648            	  3624:     bne  _anon_z05_87
02:00041F12 102C03F8        	  3625:     move.b  ($03F8,A4),D0
02:00041F16 0C000008        	  3626:     cmpi.b  #$08,D0
02:00041F1A 663E            	  3627:     bne  _anon_z05_87
                            	  3628:     ; E. The ladder's direction is up and input direction is up.
                            	  3629:     ;
                            	  3630:     ; An earlier call to check tile collision would have blocked
                            	  3631:     ; movement, because the tile under Link's top half is a water tile.
                            	  3632:     ; But because Link is squarely on the ladder, we really have
                            	  3633:     ; to check the tile above that one.
                            	  3634:     ;
                            	  3635:     ; Set moving direction to input direction (up) and switch X to
                            	  3636:     ; the player's slot for the purpose of checking tile collision below.
                            	  3637:     ; Based on that, we'll set moving direction according to walkability.
                            	  3638:     ;
02:00041F1C 6158            	  3639:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3640:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3641:     ;
02:00041F1E 102C0084        	  3642:     move.b  ($0084,A4),D0
02:00041F22 1B00            	  3643:     move.b  D0,-(A5)  ; PHA
02:00041F24 003C0011        	  3644:     ori     #$11,CCR  ; SEC: set C+X
02:00041F28 123C0008        	  3645:     move.b  #$08,D1
02:00041F2C 0A3C0010        	  3646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041F30 9101            	  3647:     subx.b  D1,D0   ; SBC #$08
02:00041F32 0A3C0010        	  3648:     eori    #$10,CCR  ; restore X = 6502 C
02:00041F36 19400084        	  3649:     move.b  D0,($0084,A4)
02:00041F3A 4EB90004B6BE    	  3650:     jsr     GetCollidingTileMoving
02:00041F40 101D            	  3651:     move.b  (A5)+,D0  ; PLA
02:00041F42 19400084        	  3652:     move.b  D0,($0084,A4)
                            	  3653:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3654:     ; direction as the input direction (in a roundabout way).
                            	  3655:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3656:     ;
02:00041F46 102C000F        	  3657:     move.b  ($000F,A4),D0
02:00041F4A 7600            	  3658:     moveq   #0,D3
02:00041F4C 162C049E        	  3659:     move.b  ($049E,A4),D3
02:00041F50 122C034A        	  3660:     move.b  ($034A,A4),D1
02:00041F54 B601            	  3661:     cmp.b   D1,D3
02:00041F56 6500FF78        	  3662:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3663: _anon_z05_87:
                            	  3664:     ; Set A to reset moving direction in [0F].
                            	  3665:     ;
02:00041F5A 7000            	  3666:     moveq   #0,D0
                            	  3667:     even
                            	  3668: _L_z05_CheckLadder_DrawLadder:
                            	  3669:     ; Draw the ladder.
                            	  3670:     ;
02:00041F5C 1B00            	  3671:     move.b  D0,-(A5)  ; PHA
02:00041F5E 7400            	  3672:     moveq   #0,D2
02:00041F60 142C0064        	  3673:     move.b  ($0064,A4),D2
02:00041F64 4EB90004CD8A    	  3674:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041F6A 760C            	  3675:     moveq   #12,D3
02:00041F6C 7000            	  3676:     moveq   #0,D0
02:00041F6E 4EB900031D3E    	  3677:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041F74 101D            	  3678:     move.b  (A5)+,D0  ; PLA
                            	  3679: ; Params:
                            	  3680: ; A: direction
                            	  3681: ;
                            	  3682: ; Returns:
                            	  3683: ; [0F]: direction
                            	  3684: ;
                            	  3685:     even
                            	  3686: SetMovingDirAndSwitchToPlayerSlot:
02:00041F76 4EF90002C048    	  3687:     jmp     c_set_moving_dir_switch_player
                            	  3688: 
                            	  3689: FindNextEdgeSpawnCell:
                            	  3690:     ; Load [0A] with the value before the call.
                            	  3691:     ;
02:00041F7C 102C0525        	  3692:     move.b  ($0525,A4),D0
02:00041F80 1940000A        	  3693:     move.b  D0,($000A,A4)
                            	  3694:     even
                            	  3695: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3696:     ; Loop to look for a place to spawn a monster from the edge
                            	  3697:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3698:     ;
                            	  3699:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3700:     ; We'll move down $10 pixels.
                            	  3701:     ;
02:00041F84 7610            	  3702:     moveq   #16,D3
02:00041F86 102C000A        	  3703:     move.b  ($000A,A4),D0
02:00041F8A 0200000F        	  3704:     andi.b #$0F,D0
02:00041F8E 670A            	  3705:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3706:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3707:     ; Don't move vertically.
                            	  3708:     ;
02:00041F90 163C00F0        	  3709:     move.b  #$F0,D3
02:00041F94 0C00000F        	  3710:     cmpi.b  #$0F,D0
02:00041F98 6610            	  3711:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3712:     even
                            	  3713: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3714:     ; Else low nibble = $F. We're at the right edge,
                            	  3715:     ; and we'll move up $10 pixels.
                            	  3716:     ;
02:00041F9A 1003            	  3717:     move.b  D3,D0
02:00041F9C 023C00EE        	  3718:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041FA0 122C000A        	  3719:     move.b  ($000A,A4),D1
02:00041FA4 D101            	  3720:     addx.b  D1,D0   ; ADC $0A
02:00041FA6 1940000A        	  3721:     move.b  D0,($000A,A4)
                            	  3722:     even
                            	  3723: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3724:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3725:     ; Move right one pixel.
                            	  3726:     ;
02:00041FAA 102C000A        	  3727:     move.b  ($000A,A4),D0
02:00041FAE 020000F0        	  3728:     andi.b #$F0,D0
02:00041FB2 0C0000E0        	  3729:     cmpi.b  #$E0,D0
02:00041FB6 6606            	  3730:     bne  _anon_z05_88
02:00041FB8 522C000A        	  3731:     addq.b  #1,($000A,A4)
02:00041FBC 600A            	  3732:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3733: 
                            	  3734: _anon_z05_88:
                            	  3735:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3736:     ; Dont' move horizontally.
                            	  3737:     ;
02:00041FBE 0C000040        	  3738:     cmpi.b  #$40,D0
02:00041FC2 6604            	  3739:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3740:     ; Else high nibble = 4. We're at the top edge.
                            	  3741:     ; Move left 1 pixel.
                            	  3742:     ;
02:00041FC4 532C000A        	  3743:     subq.b  #1,($000A,A4)
                            	  3744:     even
                            	  3745: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3746:     ; Time to get the address of the column.
                            	  3747:     ; Starting at the top of the leftmost column.
                            	  3748:     ;
02:00041FC8 61002590        	  3749:     jsr     FetchTileMapAddr
02:00041FCC 7005            	  3750:     moveq   #5,D0
02:00041FCE 4EB90002A9FA    	  3751:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3752:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3753:     ; in order to point to the column we want.
                            	  3754:     ;
02:00041FD4 102C000A        	  3755:     move.b  ($000A,A4),D0
02:00041FD8 0200000F        	  3756:     andi.b #$0F,D0
02:00041FDC 7600            	  3757:     moveq   #0,D3
02:00041FDE 1600            	  3758:     move.b  D0,D3
02:00041FE0 670C            	  3759:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3760: _anon_z05_89:
02:00041FE2 702C            	  3761:     moveq   #44,D0
02:00041FE4 4EB90003143A    	  3762:     jsr     AddToInt16At0
02:00041FEA 5303            	  3763:     subq.b  #1,D3
02:00041FEC 66F4            	  3764:     bne  _anon_z05_89
                            	  3765:     even
                            	  3766: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3767:     ; Turn the row part of [0A] into a tile index.
                            	  3768:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3769:     ;
02:00041FEE 102C000A        	  3770:     move.b  ($000A,A4),D0
02:00041FF2 020000F0        	  3771:     andi.b #$F0,D0
02:00041FF6 003C0011        	  3772:     ori     #$11,CCR  ; SEC: set C+X
02:00041FFA 123C0040        	  3773:     move.b  #$40,D1
02:00041FFE 0A3C0010        	  3774:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042002 9101            	  3775:     subx.b  D1,D0   ; SBC #$40
02:00042004 0A3C0010        	  3776:     eori    #$10,CCR  ; restore X = 6502 C
02:00042008 E208            	  3777:     lsr.b  #1,D0   ; LSR A
02:0004200A E208            	  3778:     lsr.b  #1,D0   ; LSR A
02:0004200C E208            	  3779:     lsr.b  #1,D0   ; LSR A
02:0004200E 7600            	  3780:     moveq   #0,D3
02:00042010 1600            	  3781:     move.b  D0,D3
                            	  3782:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3783:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3784:     ; when coming in from the edges.
                            	  3785:     ;
02:00042012 1214            	  3786:     move.b  ($00,A4),D1   ; ptr lo
02:00042014 182C0001        	  3787:     move.b  ($01,A4),D4  ; ptr hi
02:00042018 024100FF        	  3788:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004201C E14C            	  3789:     lsl.w   #8,D4
02:0004201E 8841            	  3790:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042020 48C4            	  3791:     ext.l   D4
02:00042022 D8BC00FF0000    	  3792:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042028 2044            	  3793:     movea.l D4,A0
02:0004202A 10303000        	  3794:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004202E 0C000084        	  3795:     cmpi.b  #$84,D0
02:00042032 650E            	  3796:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3797:     ; Bottom of the loop.
                            	  3798:     ; If you reach the original cell, then stop.
                            	  3799:     ;
02:00042034 102C000A        	  3800:     move.b  ($000A,A4),D0
02:00042038 122C0525        	  3801:     move.b  ($0525,A4),D1
02:0004203C B001            	  3802:     cmp.b   D1,D0
02:0004203E 6600FF44        	  3803:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3804:     even
                            	  3805: _L_z05_FindNextEdgeSpawnCell_SetSpawnCell:
                            	  3806:     ; Set the spawn cell to the one we found.
