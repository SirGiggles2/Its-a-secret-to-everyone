                            	  7406: Dodongo_Draw:
02:0003CF16 610000F4        	  7407:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7408:     ; Make a 5-way direction index out of the facing direction
                            	  7409:     ; by shifting right once, and store it in [00].
                            	  7410:     ;
02:0003CF1A 41EC0098        	  7411:     lea     ($0098,A4),A0
02:0003CF1E 10302000        	  7412:     move.b  (A0,D2.W),D0
02:0003CF22 E208            	  7413:     lsr.b  #1,D0   ; LSR A
02:0003CF24 1880            	  7414:     move.b  D0,($0000,A4)
                            	  7415:     ; If state = 0, go handle animating the two frames of this state.
                            	  7416:     ;
02:0003CF26 7600            	  7417:     moveq   #0,D3
02:0003CF28 41EC00AC        	  7418:     lea     ($00AC,A4),A0
02:0003CF2C 16302000        	  7419:     move.b  (A0,D2.W),D3
02:0003CF30 6744            	  7420:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7421:     ; If state > 1, then the monster is stunned (state 2).
                            	  7422:     ; So, go switch frames every $20 screen frames.
                            	  7423:     ;
02:0003CF32 7020            	  7424:     moveq   #32,D0
02:0003CF34 5303            	  7425:     subq.b  #1,D3
02:0003CF36 6640            	  7426:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7427:     ; State = 1. Bloated.
                            	  7428:     ;
                            	  7429:     ; In substate 0, go animate as usual for walking.
                            	  7430:     ;
02:0003CF38 7600            	  7431:     moveq   #0,D3
02:0003CF3A 41EC042C        	  7432:     lea     ($042C,A4),A0
02:0003CF3E 16302000        	  7433:     move.b  (A0,D2.W),D3
02:0003CF42 6732            	  7434:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7435:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7436:     ; go fade the boss; so that some frames are not drawn.
