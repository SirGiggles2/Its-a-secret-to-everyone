                            	  7009: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7010:     ; Advance the substate.
                            	  7011:     ;
02:0003CC98 41EC042C        	  7012:     lea     ($042C,A4),A0
02:0003CC9C 52302000        	  7013:     addq.b  #1,(A0,D2.W)
                            	  7014:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7015:     ;
02:0003CCA0 41EC042C        	  7016:     lea     ($042C,A4),A0
02:0003CCA4 10302000        	  7017:     move.b  (A0,D2.W),D0
02:0003CCA8 0C000002        	  7018:     cmpi.b  #$02,D0
