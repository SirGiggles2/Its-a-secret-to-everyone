                            	  7934: HaveInput:
                            	  7935:     ; There were input directions.
                            	  7936:     ;
                            	  7937:     ; If there was only one input direction, go set object direction
                            	  7938:     ; to input direction, and set Link's speed.
                            	  7939:     ;
                            	  7940:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7941:     ; (X is still 0, because it's Link's object index).
                            	  7942:     ;
02:00044D66 102C000F        	  7943:     move.b  ($000F,A4),D0
