                            	  5658: _anon_z07_30:
02:0004C4DE 4EB90003103A    	  5659:     jsr     GetDirectionsAndDistancesToTarget
                            	  5660:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5661:     ; then go move towards the thrower, draw, and check collisions.
                            	  5662:     ;
02:0004C4E4 1014            	  5663:     move.b  ($0000,A4),D0
