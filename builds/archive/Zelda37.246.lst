                            	  1890:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1891:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1892:     ; - layout $23: pattern 1: 2 statues
                            	  1893:     ; - layout $24: pattern 0: 4 statues
                            	  1894:     ;
02:0003A7E0 4EB90004ADE6    	  1895:     jsr     GetUniqueRoomId
02:0003A7E6 7601            	  1896:     moveq   #1,D3
                            	  1897: _anon_z04_30:
02:0003A7E8 41F90003A7BA    	  1898:     lea     (StatueRoomLayouts).l,A0
02:0003A7EE 12303000        	  1899:     move.b  (A0,D3.W),D1
02:0003A7F2 B001            	  1900:     cmp.b   D1,D0
02:0003A7F4 670A            	  1901:     beq  _L_z04_UpdateStatues_Shoot
02:0003A7F6 5303            	  1902:     subq.b  #1,D3
02:0003A7F8 6AEE            	  1903:     bpl  _anon_z04_30
