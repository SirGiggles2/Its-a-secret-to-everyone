02:0003F60A 41EC009A        	 12650:     lea     ($009A,A4),A0
02:0003F60E 11803000        	 12651:     move.b  D0,(A0,D3.W)
02:0003F612 5303            	 12652:     subq.b  #1,D3
02:0003F614 6AC2            	 12653:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003F616 4E75            	 12654:     rts
