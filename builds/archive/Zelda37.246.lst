02:000367BA 123C0010        	  4759:     move.b  #$10,D1
02:000367BE 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000367C2 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:000367C4 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
