02:000310EA 003C0011        	  4424:     ori     #$11,CCR  ; SEC: set C+X
02:000310EE 122C0004        	  4425:     move.b  ($0004,A4),D1
02:000310F2 0A3C0010        	  4426:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000310F6 9101            	  4427:     subx.b  D1,D0   ; SBC $04
02:000310F8 0A3C0010        	  4428:     eori    #$10,CCR  ; restore X = 6502 C
02:000310FC 19400003        	  4429:     move.b  D0,($0003,A4)
02:00031100 122C0004        	  4430:     move.b  ($0004,A4),D1
02:00031104 B001            	  4431:     cmp.b   D1,D0
