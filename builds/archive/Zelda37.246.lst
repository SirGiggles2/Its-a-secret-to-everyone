02:00041A9A 6710            	  2917:     beq  _anon_z05_76
02:00041A9C 1003            	  2918:     move.b  D3,D0
02:00041A9E 023C00EE        	  2919:     andi    #$EE,CCR  ; CLC: clear C+X
