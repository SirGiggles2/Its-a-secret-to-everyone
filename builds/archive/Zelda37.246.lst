                            	  2429:     ; Update dynamic buffer length with 10 new bytes.
                            	  2430:     ;
02:0004AEBC 1002            	  2431:     move.b  D2,D0
02:0004AEBE 023C00EE        	  2432:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AEC2 123C000A        	  2433:     move.b  #$0A,D1
02:0004AEC6 D101            	  2434:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
