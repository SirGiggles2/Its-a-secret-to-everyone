                            	   766: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   767:     ; Replace the low byte of the VRAM address with the one
                            	   768:     ; where the next character should be written.
                            	   769:     ;
02:0002E7E0 102C045F        	   770:     move.b  ($045F,A4),D0
02:0002E7E4 19400303        	   771:     move.b  D0,($0303,A4)
                            	   772:     ; Increment the low VRAM address for the next character.
                            	   773:     ;
02:0002E7E8 522C045F        	   774:     addq.b  #1,($045F,A4)
                            	   775:     ; Use the person text selector to look up the address of the
                            	   776:     ; text for the textbox. Store the address in [00:01].
                            	   777:     ;
02:0002E7EC 7600            	   778:     moveq   #0,D3
02:0002E7EE 162C0415        	   779:     move.b  ($0415,A4),D3
02:0002E7F2 41F90002DE28    	   780:     lea     (PersonTextAddrs).l,A0
02:0002E7F8 10303000        	   781:     move.b  (A0,D3.W),D0
02:0002E7FC 1880            	   782:     move.b  D0,($0000,A4)
02:0002E7FE 5203            	   783:     addq.b  #1,D3
02:0002E800 41F90002DE28    	   784:     lea     (PersonTextAddrs).l,A0
02:0002E806 10303000        	   785:     move.b  (A0,D3.W),D0
02:0002E80A 19400001        	   786:     move.b  D0,($0001,A4)
                            	   787:     ; Load the person text current character index.
                            	   788:     ;
02:0002E80E 7600            	   789:     moveq   #0,D3
02:0002E810 162C0416        	   790:     move.b  ($0416,A4),D3
                            	   791:     ; Increment the index variable to point to the next character
                            	   792:     ; for next time.
                            	   793:     ;
02:0002E814 522C0416        	   794:     addq.b  #1,($0416,A4)
                            	   795:     ; Get the current character.
                            	   796:     ;
02:0002E818 1214            	   797:     move.b  ($00,A4),D1   ; ptr lo
02:0002E81A 182C0001        	   798:     move.b  ($01,A4),D4  ; ptr hi
02:0002E81E 024100FF        	   799:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E822 E14C            	   800:     lsl.w   #8,D4
02:0002E824 8841            	   801:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E826 48C4            	   802:     ext.l   D4
02:0002E828 D8BC00FF0000    	   803:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E82E 2044            	   804:     movea.l D4,A0
02:0002E830 10303000        	   805:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   806:     ; If the character is $25, then it's a special space. It will still
                            	   807:     ; take up space, but will not take time to show -- meaning that
                            	   808:     ; we'll go look up the next character to transfer.
                            	   809:     ;
02:0002E834 0200003F        	   810:     andi.b #$3F,D0
02:0002E838 0C000025        	   811:     cmpi.b  #$25,D0
02:0002E83C 67A2            	   812:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   813:     ; We have a non-space character. Put it in the transfer record.
                            	   814:     ;
02:0002E83E 19400305        	   815:     move.b  D0,($0305,A4)
                            	   816:     ; Play the "heart taken/character" sound effect.
                            	   817:     ;
02:0002E842 7010            	   818:     moveq   #16,D0
02:0002E844 19400604        	   819:     move.b  D0,($0604,A4)
                            	   820:     ; If the high 2 bits of character element = 0, then return.
                            	   821:     ;
02:0002E848 1214            	   822:     move.b  ($00,A4),D1   ; ptr lo
02:0002E84A 182C0001        	   823:     move.b  ($01,A4),D4  ; ptr hi
02:0002E84E 024100FF        	   824:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E852 E14C            	   825:     lsl.w   #8,D4
02:0002E854 8841            	   826:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E856 48C4            	   827:     ext.l   D4
02:0002E858 D8BC00FF0000    	   828:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E85E 2044            	   829:     movea.l D4,A0
02:0002E860 10303000        	   830:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E864 020000C0        	   831:     andi.b #$C0,D0
02:0002E868 672E            	   832:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   833:     ; Determine an index based on the high 2 bits of the character element:
                            	   834:     ;   $80: 0
