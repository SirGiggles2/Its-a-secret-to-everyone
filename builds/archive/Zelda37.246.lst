                            	  7521: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CFD0 101D            	  7522:     move.b  (A5)+,D0  ; PLA
02:0003CFD2 7600            	  7523:     moveq   #0,D3
02:0003CFD4 1600            	  7524:     move.b  D0,D3
                            	  7525:     ; If facing vertically, then return. There's no other side to draw.
                            	  7526:     ;
02:0003CFD6 41EC0098        	  7527:     lea     ($0098,A4),A0
02:0003CFDA 10302000        	  7528:     move.b  (A0,D2.W),D0
02:0003CFDE 02000003        	  7529:     andi.b #$03,D0
02:0003CFE2 6602            	  7530:     bne.s  __far_z_04_0067
02:0003CFE4 602C            	  7531:     jmp  L11B00_Exit
                            	  7532: __far_z_04_0067:
                            	  7533:     ; Else draw the right side.
                            	  7534:     ;
                            	  7535:     ; Keep the Y coordinate in [01].
                            	  7536:     ; But, store (X + $10) in [00].
                            	  7537:     ;
02:0003CFE6 10342070        	  7538:     move.b  ($70,A4,D2.W),D0
02:0003CFEA 023C00EE        	  7539:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFEE 123C0010        	  7540:     move.b  #$10,D1
02:0003CFF2 D101            	  7541:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CFF4 1880            	  7542:     move.b  D0,($0000,A4)
02:0003CFF6 6114            	  7543:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7544:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7545:     ;
                            	  7546:     ; So, if we had animation frame 1, direction left:
                            	  7547:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7548:     ; - frame image index = 6 (1 + 5)
                            	  7549:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7550:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7551:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7552:     ;
                            	  7553:     ; So, 3 would have been the frame number used above for
                            	  7554:     ; the left side.
                            	  7555:     ;
                            	  7556:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7557:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7558:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7559:     ; on the right.
                            	  7560:     ;
02:0003CFF8 41F90003CEEE    	  7561:     lea     (DodongoFrameImages).l,A0
02:0003CFFE 10303000        	  7562:     move.b  (A0,D3.W),D0
02:0003D002 0A000001        	  7563:     eori.b #$01,D0
02:0003D006 4EF900031B3A    	  7564:     jmp     DrawObjectNotMirrored
