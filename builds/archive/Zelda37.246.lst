02:000421D0 B001            	  4026:     cmp.b   D1,D0
02:000421D2 6622            	  4027:     bne  _anon_z05_95
02:000421D4 102C0001        	  4028:     move.b  ($0001,A4),D0
02:000421D8 41F9000421A4    	  4029:     lea     (DoorwayBoundsMinOver).l,A0
02:000421DE 12303000        	  4030:     move.b  (A0,D3.W),D1
02:000421E2 B001            	  4031:     cmp.b   D1,D0
02:000421E4 6510            	  4032:     bcs  _anon_z05_95
02:000421E6 41F9000421A8    	  4033:     lea     (DoorwayBoundsMaxOver).l,A0
02:000421EC 12303000        	  4034:     move.b  (A0,D3.W),D1
02:000421F0 B001            	  4035:     cmp.b   D1,D0
02:000421F2 65000082        	  4036:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4037: _anon_z05_95:
02:000421F6 5303            	  4038:     subq.b  #1,D3
