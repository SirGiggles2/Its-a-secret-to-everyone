02:00030726 10303000        	  2942:     move.b  (A0,D3.W),D0
02:0003072A 19802070        	  2943:     move.b  D0,($70,A4,D2.W)
02:0003072E 41F9000306EA    	  2944:     lea     (TrapYs).l,A0
02:00030734 10303000        	  2945:     move.b  (A0,D3.W),D0
