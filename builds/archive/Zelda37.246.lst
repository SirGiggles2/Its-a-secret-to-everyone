02:00030792 10342070        	  2992:     move.b  ($70,A4,D2.W),D0
                            	  2993:     even
                            	  2994: _L_z01_UpdateTrap_Full_GoToState1:
02:00030796 41EC0380        	  2995:     lea     ($0380,A4),A0
02:0003079A 11802000        	  2996:     move.b  D0,(A0,D2.W)
                            	  2997:     ; Set facing direction to the horizontal one that we determined.
