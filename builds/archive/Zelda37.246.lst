                            	  5892:     ;
02:0003C42E 10342028        	  5893:     move.b  ($28,A4,D2.W),D0
02:0003C432 0C000010        	  5894:     cmpi.b  #$10,D0
02:0003C436 6702            	  5895:     beq.s  __far_z_04_0045
02:0003C438 6058            	  5896:     jmp  L1156B_Exit
