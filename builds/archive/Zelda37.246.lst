                            	  9907: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9908:     ; Here the eye is closed. So animate it this way.
                            	  9909:     ; Increment the animation counter, and if <> 8, then
                            	  9910:     ; go shoot, draw, and check collisions.
                            	  9911:     ;
02:0003E1EE 41EC0478        	  9912:     lea     ($0478,A4),A0
02:0003E1F2 52302000        	  9913:     addq.b  #1,(A0,D2.W)
02:0003E1F6 41EC0478        	  9914:     lea     ($0478,A4),A0
02:0003E1FA 10302000        	  9915:     move.b  (A0,D2.W),D0
02:0003E1FE 0C000008        	  9916:     cmpi.b  #$08,D0
02:0003E202 66C2            	  9917:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9918:     ; Roll over the eye animation counter to 0.
                            	  9919:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9920:     ;
02:0003E204 7000            	  9921:     moveq   #0,D0
02:0003E206 41EC0478        	  9922:     lea     ($0478,A4),A0
02:0003E20A 11802000        	  9923:     move.b  D0,(A0,D2.W)
02:0003E20E 41EC046B        	  9924:     lea     ($046B,A4),A0
