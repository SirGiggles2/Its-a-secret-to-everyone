                            	  5652:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5653:     ;
02:0004C4D0 0C02000D        	  5654:     cmpi.b  #$0D,D2
02:0004C4D4 6408            	  5655:     bcc  _anon_z07_30
02:0004C4D6 41EC042C        	  5656:     lea     ($042C,A4),A0
