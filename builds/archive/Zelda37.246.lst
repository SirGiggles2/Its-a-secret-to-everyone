02:0004BF70 6712            	  4856:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004BF72 102C0001        	  4857:     move.b  ($0001,A4),D0
02:0004BF76 023C00EE        	  4858:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BF7A 123C0003        	  4859:     move.b  #$03,D1
02:0004BF7E D101            	  4860:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004BF80 19400001        	  4861:     move.b  D0,($0001,A4)
                            	  4862:     even
