                            	  4166: __far_z_07_0050:
                            	  4167:     ; Moving direction = 0.
                            	  4168:     ; The object is not the player.
                            	  4169:     ;
                            	  4170:     ; If object does not have attribute $10, then
                            	  4171:     ; set movement direction to input direction,
                            	  4172:     ; and go try to turn to an unblocked direction in order to move.
                            	  4173:     ;
02:0004BB02 41EC04BF        	  4174:     lea     ($04BF,A4),A0
02:0004BB06 10302000        	  4175:     move.b  (A0,D2.W),D0
02:0004BB0A 02000010        	  4176:     andi.b #$10,D0
02:0004BB0E 6702            	  4177:     beq.s  __far_z_07_0051
02:0004BB10 600E            	  4178:     jmp  Reverse
                            	  4179: __far_z_07_0051:
