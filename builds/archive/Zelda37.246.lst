02:00042222 41F9000421A8    	  4068:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042228 12303000        	  4069:     move.b  (A0,D3.W),D1
02:0004222C B001            	  4070:     cmp.b   D1,D0
