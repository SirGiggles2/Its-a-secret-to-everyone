                            	  7786: __far_z_05_0086:
                            	  7787:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7788:     ; and represents the current row of the submenu being processed.
                            	  7789:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7790:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7791:     ;
                            	  7792:     ; If the bottom bit is set, go prepare the full black row.
                            	  7793:     ;
02:00044C92 E208            	  7794:     lsr.b  #1,D0   ; LSR A
02:00044C94 7600            	  7795:     moveq   #0,D3
02:00044C96 1600            	  7796:     move.b  D0,D3
02:00044C98 6402            	  7797:     bcc.s  __far_z_05_0087
02:00044C9A 60B6            	  7798:     jmp  PrepFullBlackRow
