02:0003F6A8 41EC0084        	 12728:     lea     ($0084,A4),A0
02:0003F6AC 10302000        	 12729:     move.b  (A0,D2.W),D0
02:0003F6B0 19400001        	 12730:     move.b  D0,($0001,A4)
02:0003F6B4 6100FF62        	 12731:     jsr     Ganon_DrawCloud
02:0003F6B8 6172            	 12732:     jsr     Ganon_GetCurCloudRight
02:0003F6BA 6100FF5C        	 12733:     jsr     Ganon_DrawCloud
                            	 12734:     ; Save the object index.
                            	 12735:     ;
02:0003F6BE 102C0340        	 12736:     move.b  ($0340,A4),D0
