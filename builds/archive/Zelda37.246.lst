02:00030758 660000B2        	  2962:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2963:     ; State 0. Sensing.
                            	  2964:     ;
                            	  2965:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2966:     ; then go see if the horizontal distance is shorter.
                            	  2967:     ;
02:0003075C 102C0084        	  2968:     move.b  ($0084,A4),D0
02:00030760 003C0011        	  2969:     ori     #$11,CCR  ; SEC: set C+X
02:00030764 41EC0084        	  2970:     lea     ($0084,A4),A0
02:00030768 12302000        	  2971:     move.b  (A0,D2.W),D1
02:0003076C 0A3C0010        	  2972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030770 9101            	  2973:     subx.b  D1,D0   ; SBC ObjY,X
02:00030772 0A3C0010        	  2974:     eori    #$10,CCR  ; restore X = 6502 C
02:00030776 6100086E        	  2975:     jsr     Abs
02:0003077A 0C00000E        	  2976:     cmpi.b  #$0E,D0
02:0003077E 644C            	  2977:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2978:     ; Determine the horizontal direction toward Link;
                            	  2979:     ; and if Link and the trap are at the same X, then we can't move
                            	  2980:     ; along this axis. Go see about moving vertically.
