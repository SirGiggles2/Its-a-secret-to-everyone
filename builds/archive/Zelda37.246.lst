02:00040536 0C0000DD        	   665:     cmpi.b  #$DD,D0
02:0004053A 640A            	   666:     bcc  _anon_z05_9
02:0004053C 123C0008        	   667:     move.b  #$08,D1
02:00040540 D101            	   668:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00040542 19400084        	   669:     move.b  D0,($0084,A4)
                            	   670: _anon_z05_9:
02:00040546 102C00E2        	   671:     move.b  ($00E2,A4),D0
02:0004054A 003C0011        	   672:     ori     #$11,CCR  ; SEC: set C+X
02:0004054E 123C0020        	   673:     move.b  #$20,D1
02:00040552 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040556 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:00040558 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:0004055C 194000E2        	   677:     move.b  D0,($00E2,A4)
02:00040560 6404            	   678:     bcc  _anon_z05_10
02:00040562 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
02:00040566 0C0000E0        	   681:     cmpi.b  #$E0,D0
02:0004056A 661E            	   682:     bne  _L_z05_ScrollWorld_Exit
02:0004056C 102C0058        	   683:     move.b  ($0058,A4),D0
02:00040570 0C000020        	   684:     cmpi.b  #$20,D0
