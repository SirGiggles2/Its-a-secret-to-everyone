                            	  2920:     ; then we'll make 4 traps.
                            	  2921:     ;
02:00030702 41EC034F        	  2922:     lea     ($034F,A4),A0
02:00030706 12302000        	  2923:     move.b  (A0,D2.W),D1
02:0003070A B001            	  2924:     cmp.b   D1,D0
