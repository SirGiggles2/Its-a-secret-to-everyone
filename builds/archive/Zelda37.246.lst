                            	 12433: __far_z_04_0119:
                            	 12434:     ; State = 0: Blue
                            	 12435:     ;
                            	 12436:     ; If timer = 0, then go move around and shoot.
                            	 12437:     ;
02:0003F49A 10342028        	 12438:     move.b  ($28,A4,D2.W),D0
02:0003F49E 6602            	 12439:     bne.s  __far_z_04_0120
02:0003F4A0 600E            	 12440:     jmp  Ganon_MoveAndShoot
                            	 12441: __far_z_04_0120:
                            	 12442:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12443:     ; Collisions were checked already.
                            	 12444:     ;
                            	 12445:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12446:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12447:     ;
02:0003F4A2 0C000001        	 12448:     cmpi.b  #$01,D0
02:0003F4A6 6702            	 12449:     beq.s  __far_z_04_0121
02:0003F4A8 6078            	 12450:     jmp  L_Ganon_DrawBody
                            	 12451: __far_z_04_0121:
