02:0003B58A 10342028        	  3891:     move.b  ($28,A4,D2.W),D0
02:0003B58E E208            	  3892:     lsr.b  #1,D0   ; LSR A
02:0003B590 6512            	  3893:     bcs  _anon_z04_53
