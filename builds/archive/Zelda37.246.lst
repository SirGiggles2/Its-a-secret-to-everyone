                            	  3928: __far_z_04_0033:
                            	  3929:     ; Animate.
                            	  3930:     ;
                            	  3931:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3932:     ; then only go draw.
                            	  3933:     ;
02:0003B5D2 41EC03D0        	  3934:     lea     ($03D0,A4),A0
02:0003B5D6 53302000        	  3935:     subq.b  #1,(A0,D2.W)
02:0003B5DA 6702            	  3936:     beq.s  __far_z_04_0034
02:0003B5DC 601E            	  3937:     jmp  DrawArmosAndCheckCollisions
                            	  3938: __far_z_04_0034:
                            	  3939:     ; Armos animation frames last 6 screen frames.
                            	  3940:     ;
02:0003B5DE 7006            	  3941:     moveq   #6,D0
02:0003B5E0 41EC03D0        	  3942:     lea     ($03D0,A4),A0
02:0003B5E4 11802000        	  3943:     move.b  D0,(A0,D2.W)
                            	  3944:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3945:     ; change the position of the shield. To keep fixed it in place,
                            	  3946:     ; there are separate frame images for each animation frame.
                            	  3947:     ;
                            	  3948:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3949:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3950:     ;
                            	  3951:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3952:     ; Then choose the direction at the point of drawing below.
                            	  3953:     ;
02:0003B5E8 41EC03E4        	  3954:     lea     ($03E4,A4),A0
02:0003B5EC 10302000        	  3955:     move.b  (A0,D2.W),D0
02:0003B5F0 0A000002        	  3956:     eori.b #$02,D0
02:0003B5F4 41EC03E4        	  3957:     lea     ($03E4,A4),A0
02:0003B5F8 11802000        	  3958:     move.b  D0,(A0,D2.W)
                            	  3959:     even
                            	  3960: DrawArmosAndCheckCollisions:
02:0003B5FC 4EB90004CD8A    	  3961:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B602 7600            	  3962:     moveq   #0,D3
02:0003B604 41EC0098        	  3963:     lea     ($0098,A4),A0
02:0003B608 16302000        	  3964:     move.b  (A0,D2.W),D3
                            	  3965:     ; If facing up, then use the second frame image in the set ("back").
                            	  3966:     ; Else use the second.
                            	  3967:     ;
02:0003B60C 0C030008        	  3968:     cmpi.b  #$08,D3
02:0003B610 6602            	  3969:     bne  _anon_z04_54
02:0003B612 7001            	  3970:     moveq   #1,D0
                            	  3971: _anon_z04_54:
02:0003B614 023C00EE        	  3972:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B618 41EC03E4        	  3973:     lea     ($03E4,A4),A0
02:0003B61C 12302000        	  3974:     move.b  (A0,D2.W),D1
02:0003B620 D101            	  3975:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B622 4EB900031B3A    	  3976:     jsr     DrawObjectNotMirrored
                            	  3977:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3978:     ; but not with weapons.
                            	  3979:     ;
02:0003B628 10342028        	  3980:     move.b  ($28,A4,D2.W),D0
02:0003B62C 661C            	  3981:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3982:     ; Else check for all collisions.
                            	  3983:     ;
02:0003B62E 4EB900031EB6    	  3984:     jsr     CheckMonsterCollisions
                            	  3985:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3986:     ;
02:0003B634 41EC0405        	  3987:     lea     ($0405,A4),A0
02:0003B638 10302000        	  3988:     move.b  (A0,D2.W),D0
02:0003B63C 670A            	  3989:     beq  _anon_z04_55
02:0003B63E 705D            	  3990:     moveq   #93,D0
02:0003B640 41EC034F        	  3991:     lea     ($034F,A4),A0
02:0003B644 11802000        	  3992:     move.b  D0,(A0,D2.W)
