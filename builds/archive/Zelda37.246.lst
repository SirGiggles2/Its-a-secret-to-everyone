                            	  5743:     ; Move vertically towards the thrower.
                            	  5744:     ;
02:0004C55E 41F90004C238    	  5745:     lea     (BoomerangQSpeedFracsY).l,A0
02:0004C564 10303000        	  5746:     move.b  (A0,D3.W),D0
02:0004C568 4EB90003110E    	  5747:     jsr     SetBoomerangSpeed
02:0004C56E 102C000A        	  5748:     move.b  ($000A,A4),D0
02:0004C572 1940000F        	  5749:     move.b  D0,($000F,A4)
02:0004C576 41EC0098        	  5750:     lea     ($0098,A4),A0
02:0004C57A 11802000        	  5751:     move.b  D0,(A0,D2.W)
02:0004C57E 1003            	  5752:     move.b  D3,D0
02:0004C580 1B00            	  5753:     move.b  D0,-(A5)  ; PHA
02:0004C582 6100F48E        	  5754:     jsr     MoveObject
