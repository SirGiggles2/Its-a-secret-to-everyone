                            	  4494: 
                            	  4495: ; Params:
                            	  4496: ; [02:03]: address of door tiles for direction and face
                            	  4497: ; [04]: count of tiles remaining
                            	  4498: ; [07]: current index (0 to 3) of the tile to copy
                            	  4499: ;       to the dynamic transfer buf
                            	  4500: ; [09]: door direction index
                            	  4501: ;
                            	  4502: ; Returns:
                            	  4503: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4504: ; [04]: original value - 1
                            	  4505: ; [07]: original value + 1
                            	  4506: ;
                            	  4507: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4508: ; vertically. The point of this routine is to access them
                            	  4509: ; horizontally in order to transfer them to a nametable.
                            	  4510: ;
                            	  4511: ;
                            	  4512: ; For the direction index in [09], look up the base offset of the
                            	  4513: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4514: ; the door face tiles at [02:03].
                            	  4515: ;
                            	  4516:     even
                            	  4517: WriteDoorFaceTileHorizontally:
02:0004262E 7600            	  4518:     moveq   #0,D3
02:00042630 162C0009        	  4519:     move.b  ($0009,A4),D3
02:00042634 41F900043852    	  4520:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:0004263A 10303000        	  4521:     move.b  (A0,D3.W),D0
                            	  4522:     ; Add [07] to the base offset we got above. This yields one
                            	  4523:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4524:     ;
02:0004263E 023C00EE        	  4525:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042642 122C0007        	  4526:     move.b  ($0007,A4),D1
02:00042646 D101            	  4527:     addx.b  D1,D0   ; ADC $07
02:00042648 7600            	  4528:     moveq   #0,D3
02:0004264A 1600            	  4529:     move.b  D0,D3
                            	  4530:     ; With that index, look up the index to use with the door face
                            	  4531:     ; list of tiles at [02:03].
                            	  4532:     ;
02:0004264C 41F900043844    	  4533:     lea     (HorizontalDoorFaceIndexes).l,A0
02:00042652 10303000        	  4534:     move.b  (A0,D3.W),D0
02:00042656 7600            	  4535:     moveq   #0,D3
02:00042658 1600            	  4536:     move.b  D0,D3
                            	  4537:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4538:     ; and copy it to the dynamic transfer buf.
                            	  4539:     ;
02:0004265A 122C0002        	  4540:     move.b  ($02,A4),D1   ; ptr lo
02:0004265E 182C0003        	  4541:     move.b  ($03,A4),D4  ; ptr hi
02:00042662 024100FF        	  4542:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042666 E14C            	  4543:     lsl.w   #8,D4
02:00042668 8841            	  4544:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004266A 48C4            	  4545:     ext.l   D4
02:0004266C D8BC00FF0000    	  4546:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042672 2044            	  4547:     movea.l D4,A0
02:00042674 10303000        	  4548:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042678 41EC0302        	  4549:     lea     ($0302,A4),A0
02:0004267C 11802000        	  4550:     move.b  D0,(A0,D2.W)
                            	  4551:     ; Prepare for the next call:
                            	  4552:     ; - increment dynamic transfer buf pointer
                            	  4553:     ; - increment index of tile to copy [07]
                            	  4554:     ; - decrement count of tiles remaining
                            	  4555:     ;
02:00042680 5202            	  4556:     addq.b  #1,D2
02:00042682 522C0007        	  4557:     addq.b  #1,($0007,A4)
02:00042686 532C0004        	  4558:     subq.b  #1,($0004,A4)
02:0004268A 4E75            	  4559:     rts
