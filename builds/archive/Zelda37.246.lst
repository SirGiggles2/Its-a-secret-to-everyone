02:00041A66 023C00EE        	  2891:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041A6A 123C0008        	  2892:     move.b  #$08,D1
02:00041A6E D101            	  2893:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00041A70 7600            	  2894:     moveq   #0,D3
02:00041A72 1600            	  2895:     move.b  D0,D3
02:00041A74 103C0080        	  2896:     move.b  #$80,D0
