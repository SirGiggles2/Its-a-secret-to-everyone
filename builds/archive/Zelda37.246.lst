                            	  7692: Submenu_CueTransferRowUW:
                            	  7693:     ; If menu scroll value is negative, then we transferred everything.
                            	  7694:     ; So, return.
                            	  7695:     ;
02:00044C18 102C005E        	  7696:     move.b  ($005E,A4),D0
02:00044C1C 6A02            	  7697:     bpl.s  __far_z_05_0084
02:00044C1E 6030            	  7698:     jmp  L1725A_Exit
                            	  7699: __far_z_05_0084:
                            	  7700:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7701:     ; and represents the current row of the submenu being processed.
                            	  7702:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7703:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7704:     ;
                            	  7705:     ; If the bottom bit is set, go prepare the full black row.
                            	  7706:     ;
02:00044C20 E208            	  7707:     lsr.b  #1,D0   ; LSR A
02:00044C22 7600            	  7708:     moveq   #0,D3
02:00044C24 1600            	  7709:     move.b  D0,D3
02:00044C26 6402            	  7710:     bcc.s  __far_z_05_0085
02:00044C28 6028            	  7711:     jmp  PrepFullBlackRow
                            	  7712: __far_z_05_0085:
                            	  7713:     ; Submenu rows $D to $15 are parts of the map.
                            	  7714:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7715:     ;
                            	  7716:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7717:     ; buffer for this row.
                            	  7718:     ;
02:00044C2A 0C00000D        	  7719:     cmpi.b  #$0D,D0
02:00044C2E 640C            	  7720:     bcc  _anon_z05_167
02:00044C30 41F900044BF4    	  7721:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044C36 10303000        	  7722:     move.b  (A0,D3.W),D0
                            	  7723:     even
