02:0003B57E 11802000        	  3886:     move.b  D0,(A0,D2.W)
02:0003B582 41EC0098        	  3887:     lea     ($0098,A4),A0
02:0003B586 11802000        	  3888:     move.b  D0,(A0,D2.W)
