                            	  4868: UpdatePeaceTextbox:
                            	  4869:     ; Only emit a character once every 8 frames --
                            	  4870:     ; when (counter [0412] MOD 8) = 4.
                            	  4871:     ;
02:000368E4 522C0412        	  4872:     addq.b  #1,($0412,A4)
02:000368E8 102C0412        	  4873:     move.b  ($0412,A4),D0
02:000368EC 02000007        	  4874:     andi.b #$07,D0
02:000368F0 0C000004        	  4875:     cmpi.b  #$04,D0
02:000368F4 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4877:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4878:     ; to the dynamic transfer buf.
