02:0003A6AE 11802000        	  1704:     move.b  D0,(A0,D2.W)
02:0003A6B2 41EC00AC        	  1705:     lea     ($00AC,A4),A0
02:0003A6B6 52302000        	  1706:     addq.b  #1,(A0,D2.W)
