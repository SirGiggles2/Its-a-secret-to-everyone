02:0003E1A2 674A            	  9863:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9864:     ; Else decrement the open eye timer.
                            	  9865:     ;
02:0003E1A4 41EC0444        	  9866:     lea     ($0444,A4),A0
02:0003E1A8 53302000        	  9867:     subq.b  #1,(A0,D2.W)
                            	  9868:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9869:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9870:     ;
02:0003E1AC 7602            	  9871:     moveq   #2,D3
02:0003E1AE 0C000070        	  9872:     cmpi.b  #$70,D0
02:0003E1B2 6408            	  9873:     bcc  _anon_z04_123
02:0003E1B4 0C000010        	  9874:     cmpi.b  #$10,D0
02:0003E1B8 6502            	  9875:     bcs  _anon_z04_123
02:0003E1BA 5203            	  9876:     addq.b  #1,D3
                            	  9877: _anon_z04_123:
