02:0003B3CE 41EC03E4        	  3603:     lea     ($03E4,A4),A0
02:0003B3D2 12302000        	  3604:     move.b  (A0,D2.W),D1
02:0003B3D6 B300            	  3605:     eor.b  D1,D0
02:0003B3D8 41EC03E4        	  3606:     lea     ($03E4,A4),A0
