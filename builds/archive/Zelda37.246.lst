                            	  3920: UpdateArmos:
02:0003B5C2 6100E7EA        	  3921:     jsr     UpdateGoriya
                            	  3922:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3923:     ;
02:0003B5C6 41EC00C0        	  3924:     lea     ($00C0,A4),A0
02:0003B5CA 10302000        	  3925:     move.b  (A0,D2.W),D0
02:0003B5CE 6702            	  3926:     beq.s  __far_z_04_0033
