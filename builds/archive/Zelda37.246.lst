                            	  2857:     ; Else calculate a timer value.
                            	  2858:     ;
                            	  2859:     ; t := (Random + $10)
                            	  2860:     ; if t < $20 then
                            	  2861:     ;   t := t - $40
                            	  2862:     ;
02:0003AE3A 7010            	  2863:     moveq   #16,D0
02:0003AE3C 023C00EE        	  2864:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE40 12342019        	  2865:     move.b  ($19,A4,D2.W),D1
02:0003AE44 D101            	  2866:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AE46 0C000020        	  2867:     cmpi.b  #$20,D0
02:0003AE4A 6412            	  2868:     bcc  _anon_z04_39
02:0003AE4C 003C0011        	  2869:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE50 123C0040        	  2870:     move.b  #$40,D1
02:0003AE54 0A3C0010        	  2871:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE58 9101            	  2872:     subx.b  D1,D0   ; SBC #$40
02:0003AE5A 0A3C0010        	  2873:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2874: _anon_z04_39:
                            	  2875:     ; If the object is a blue tektite, then go use this t.
                            	  2876:     ;
02:0003AE5E 7600            	  2877:     moveq   #0,D3
02:0003AE60 41EC034F        	  2878:     lea     ($034F,A4),A0
