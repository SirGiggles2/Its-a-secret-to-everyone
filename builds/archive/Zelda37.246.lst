                            	  2828: __far_z_04_0022:
                            	  2829:     ; Going down. We have to consider the target Y.
                            	  2830:     ;
                            	  2831:     ; If the absolute vertical distance to the target position >= 3,
                            	  2832:     ; then go animate, draw, and check collisions.
                            	  2833:     ;
02:0003ADF8 41EC0084        	  2834:     lea     ($0084,A4),A0
02:0003ADFC 10302000        	  2835:     move.b  (A0,D2.W),D0
02:0003AE00 003C0011        	  2836:     ori     #$11,CCR  ; SEC: set C+X
02:0003AE04 41EC0444        	  2837:     lea     ($0444,A4),A0
02:0003AE08 12302000        	  2838:     move.b  (A0,D2.W),D1
02:0003AE0C 0A3C0010        	  2839:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AE10 9101            	  2840:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:0003AE12 0A3C0010        	  2841:     eori    #$10,CCR  ; restore X = 6502 C
02:0003AE16 4EB900030FE6    	  2842:     jsr     Abs
02:0003AE1C 0C000003        	  2843:     cmpi.b  #$03,D0
02:0003AE20 6502            	  2844:     bcs.s  __far_z_04_0023
