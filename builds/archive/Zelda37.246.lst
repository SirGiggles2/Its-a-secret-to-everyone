                            	  2911:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2912:     ;
02:000306FC 7605            	  2913:     moveq   #5,D3
                            	  2914:     ; The individual trap objects to make will be of type $49.
                            	  2915:     ; Store it in [00].
                            	  2916:     ;
