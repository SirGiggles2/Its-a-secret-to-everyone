02:00030780 7601            	  2982:     moveq   #1,D3
02:00030782 102C0070        	  2983:     move.b  ($0070,A4),D0
02:00030786 12342070        	  2984:     move.b  ($70,A4,D2.W),D1
02:0003078A B001            	  2985:     cmp.b   D1,D0
02:0003078C 673E            	  2986:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003078E 6402            	  2987:     bcc  _anon_z01_26
02:00030790 7602            	  2988:     moveq   #2,D3
                            	  2989: _anon_z01_26:
                            	  2990:     ; Remember the original X coordinate.
