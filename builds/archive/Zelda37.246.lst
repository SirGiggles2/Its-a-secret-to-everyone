02:0003B1EC D101            	  3350:     addx.b  D1,D0   ; ADC $00
                            	  3351:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3352:     ;
02:0003B1EE 020000F8        	  3353:     andi.b #$F8,D0
