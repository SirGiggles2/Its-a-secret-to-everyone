                            	  9534: Manhandla_Move:
                            	  9535:     ; Implement a way of manifesting the fractional part of the speed
                            	  9536:     ; in the movement.
                            	  9537:     ;
                            	  9538:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9539:     ; byte to add to the coordinates, then the effective speed would
                            	  9540:     ; be 1 pixel a frame instead of 1.25.
                            	  9541:     ;
                            	  9542:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9543:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9544:     ;
                            	  9545:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9546:     ;
                            	  9547:     ;   SA := SA + (SL AND $E0)
                            	  9548:     ;   [03] := SH + carry
                            	  9549:     ;
                            	  9550:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9551:     ;
02:0003DEFA 41EC041F        	  9552:     lea     ($041F,A4),A0
02:0003DEFE 10302000        	  9553:     move.b  (A0,D2.W),D0
02:0003DF02 020000E0        	  9554:     andi.b #$E0,D0
02:0003DF06 023C00EE        	  9555:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF0A 41EC0412        	  9556:     lea     ($0412,A4),A0
02:0003DF0E 12302000        	  9557:     move.b  (A0,D2.W),D1
02:0003DF12 D101            	  9558:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DF14 41EC0412        	  9559:     lea     ($0412,A4),A0
02:0003DF18 11802000        	  9560:     move.b  D0,(A0,D2.W)
                            	  9561:     ; Assign (high speed byte + carry) to [03].
                            	  9562:     ;
02:0003DF1C 41EC042C        	  9563:     lea     ($042C,A4),A0
02:0003DF20 10302000        	  9564:     move.b  (A0,D2.W),D0
02:0003DF24 123C0000        	  9565:     move.b  #$00,D1
02:0003DF28 D101            	  9566:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DF2A 19400003        	  9567:     move.b  D0,($0003,A4)
                            	  9568:     ; Change coordinates by the speed amount/offset in [03]
                            	  9569:     ; according to the direction.
                            	  9570:     ;
                            	  9571:     ; Start with a mask of $A1 in [02]:
                            	  9572:     ; - low nibble represents the right direction
                            	  9573:     ; - high nibble is used to set or clear carry as we go along
                            	  9574:     ;
02:0003DF2E 103C00A1        	  9575:     move.b  #$A1,D0
02:0003DF32 19400002        	  9576:     move.b  D0,($0002,A4)
                            	  9577:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9578:     ;
02:0003DF36 41EC0098        	  9579:     lea     ($0098,A4),A0
02:0003DF3A 10302000        	  9580:     move.b  (A0,D2.W),D0
02:0003DF3E 122C0002        	  9581:     move.b  ($0002,A4),D1
02:0003DF42 C200            	  9582:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF44 6712            	  9583:     beq  _L_z04_Manhandla_Move_Left
02:0003DF46 10342070        	  9584:     move.b  ($70,A4,D2.W),D0
02:0003DF4A 023C00EE        	  9585:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF4E 122C0003        	  9586:     move.b  ($0003,A4),D1
02:0003DF52 D101            	  9587:     addx.b  D1,D0   ; ADC $03
02:0003DF54 19802070        	  9588:     move.b  D0,($70,A4,D2.W)
                            	  9589:     even
                            	  9590: _L_z04_Manhandla_Move_Left:
                            	  9591:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9592:     ;
02:0003DF58 41EC0098        	  9593:     lea     ($0098,A4),A0
02:0003DF5C 10302000        	  9594:     move.b  (A0,D2.W),D0
02:0003DF60 122C0002        	  9595:     move.b  ($0002,A4),D1
02:0003DF64 E309            	  9596:     lsl.b  #1,D1   ; ASL $02
02:0003DF66 19410002        	  9597:     move.b  D1,($0002,A4)
02:0003DF6A 122C0002        	  9598:     move.b  ($0002,A4),D1
02:0003DF6E C200            	  9599:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF70 6716            	  9600:     beq  _L_z04_Manhandla_Move_Down
02:0003DF72 10342070        	  9601:     move.b  ($70,A4,D2.W),D0
02:0003DF76 122C0003        	  9602:     move.b  ($0003,A4),D1
02:0003DF7A 0A3C0010        	  9603:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DF7E 9101            	  9604:     subx.b  D1,D0   ; SBC $03
02:0003DF80 0A3C0010        	  9605:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DF84 19802070        	  9606:     move.b  D0,($70,A4,D2.W)
                            	  9607:     even
                            	  9608: _L_z04_Manhandla_Move_Down:
                            	  9609:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9610:     ;
02:0003DF88 41EC0098        	  9611:     lea     ($0098,A4),A0
