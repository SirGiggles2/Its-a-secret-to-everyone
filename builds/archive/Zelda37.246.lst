02:00030830 11802000        	  3071:     move.b  D0,(A0,D2.W)
                            	  3072: _anon_z01_28:
                            	  3073:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  3074:     ;
02:00030834 610017CA        	  3075:     jsr     CheckLinkCollision
                            	  3076:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  3077:     ; and current coordinate to the trap's X.
                            	  3078:     ;
02:00030838 7600            	  3079:     moveq   #0,D3
02:0003083A 16342070        	  3080:     move.b  ($70,A4,D2.W),D3
02:0003083E 7078            	  3081:     moveq   #120,D0
02:00030840 1880            	  3082:     move.b  D0,($0000,A4)
02:00030842 41EC0098        	  3083:     lea     ($0098,A4),A0
02:00030846 10302000        	  3084:     move.b  (A0,D2.W),D0
02:0003084A 0200000C        	  3085:     andi.b #$0C,D0
02:0003084E 6710            	  3086:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  3087:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  3088:     ; and current coordinate to the trap's Y.
