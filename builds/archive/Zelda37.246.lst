                            	  3828:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3829:     ;
                            	  3830:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3831:     ;         or object direction when <> 0.
                            	  3832:     ;
                            	  3833:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3834:     ;
                            	  3835:     ; if slot = 0 and grid offset <> 0 then
                            	  3836:     ;   if input dir = 0 then
                            	  3837:     ;     use 0
                            	  3838:     ;   else
                            	  3839:     ;     use object direction
                            	  3840:     ; else
                            	  3841:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3842:     ;     return
                            	  3843:     ;   else
                            	  3844:     ;     if input dir = 0
                            	  3845:     ;       use 0
                            	  3846:     ;     else
