                            	  4001: UpdatePondFairy:
02:0003B650 610045F8        	  4002:     jsr     DrawFairy
                            	  4003:     ; If not in state 0, then go handle states 1 to 3.
                            	  4004:     ;
02:0003B654 102C00AD        	  4005:     move.b  ($00AD,A4),D0
02:0003B658 6702            	  4006:     beq.s  __far_z_04_0035
02:0003B65A 602A            	  4007:     jmp  PondFairy_HandleOtherStates
                            	  4008: __far_z_04_0035:
                            	  4009:     ; State 0.
                            	  4010:     ;
                            	  4011:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4012:     ;
02:0003B65C 102C0084        	  4013:     move.b  ($0084,A4),D0
02:0003B660 0C0000AD        	  4014:     cmpi.b  #$AD,D0
02:0003B664 661E            	  4015:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4016:     ; If Link's X < $70 or >= $81, then return.
                            	  4017:     ;
02:0003B666 102C0070        	  4018:     move.b  ($0070,A4),D0
02:0003B66A 0C000070        	  4019:     cmpi.b  #$70,D0
02:0003B66E 6514            	  4020:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B670 0C000081        	  4021:     cmpi.b  #$81,D0
02:0003B674 640E            	  4022:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4023:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4024:     ; halt Link, and start filling hearts.
                            	  4025:     ;
02:0003B676 522C00AD        	  4026:     addq.b  #1,($00AD,A4)
02:0003B67A 7040            	  4027:     moveq   #64,D0
02:0003B67C 194000AC        	  4028:     move.b  D0,($00AC,A4)
02:0003B680 19400063        	  4029:     move.b  D0,($0063,A4)
                            	  4030:     even
                            	  4031: _L_z04_UpdatePondFairy_Exit:
02:0003B684 4E75            	  4032:     rts
                            	  4033: 
                            	  4034:     even
                            	  4035: PondFairy_HandleOtherStates:
02:0003B686 0C000001        	  4036:     cmpi.b  #$01,D0
02:0003B68A 6610            	  4037:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4038:     ; State 1. Flying and filling hearts.
                            	  4039:     ;
                            	  4040:     ; If still filling hearts, then go draw Link and hearts.
                            	  4041:     ;
02:0003B68C 102C0063        	  4042:     move.b  ($0063,A4),D0
02:0003B690 6620            	  4043:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4044:     ; If not filling hearts anymore, then go to state 2,
                            	  4045:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4046:     ; a little while after we finish filling hearts.
                            	  4047:     ;
02:0003B692 522C00AD        	  4048:     addq.b  #1,($00AD,A4)
02:0003B696 7050            	  4049:     moveq   #80,D0
02:0003B698 19400029        	  4050:     move.b  D0,($0029,A4)
                            	  4051:     even
                            	  4052: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4053:     ; If state <> 2 (so, it's 3), then return.
                            	  4054:     ;
                            	  4055:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4056:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4057:     ; was set to, and we'll return.
                            	  4058:     ;
02:0003B69C 0C000002        	  4059:     cmpi.b  #$02,D0
02:0003B6A0 6634            	  4060:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4061:     ; State = 2.
                            	  4062:     ;
                            	  4063:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4064:     ;
02:0003B6A2 102C0029        	  4065:     move.b  ($0029,A4),D0
02:0003B6A6 660A            	  4066:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4067:     ; Else go to state 3, and unhalt Link.
                            	  4068:     ;
