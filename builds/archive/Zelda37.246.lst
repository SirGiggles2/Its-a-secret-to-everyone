                            	  5666:     ; The boomerang has reached the thrower.
                            	  5667:     ;
                            	  5668:     ; Reset the distance to move.
                            	  5669:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5670:     ;
02:0004C4EC 7000            	  5671:     moveq   #0,D0
02:0004C4EE 41EC0380        	  5672:     lea     ($0380,A4),A0
02:0004C4F2 11802000        	  5673:     move.b  D0,(A0,D2.W)
02:0004C4F6 0C02000D        	  5674:     cmpi.b  #$0D,D2
02:0004C4FA 6524            	  5675:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5676:     ; Link has caught the boomerang.
                            	  5677:     ;
                            	  5678:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5679:     ;
                            	  5680:     ; If Link catches it some time after throwing it,
                            	  5681:     ; his state will become $20, and he will show the catch animation.
                            	  5682:     ;
                            	  5683:     ; But if he catches it right after throwing it, the state becomes
                            	  5684:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5685:     ;
02:0004C4FC 102C00AC        	  5686:     move.b  ($00AC,A4),D0
02:0004C500 00000020        	  5687:     ori.b #$20,D0
02:0004C504 194000AC        	  5688:     move.b  D0,($00AC,A4)
                            	  5689:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5690:     ; up the new state.
                            	  5691:     ;
02:0004C508 7001            	  5692:     moveq   #1,D0
02:0004C50A 194003D0        	  5693:     move.b  D0,($03D0,A4)
                            	  5694:     ; Deactivate the boomerang.
                            	  5695:     ;
