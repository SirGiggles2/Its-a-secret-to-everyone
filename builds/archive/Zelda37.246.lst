02:0004BF8C 102C0015        	  4871:     move.b  ($0015,A4),D0
02:0004BF90 02000003        	  4872:     andi.b #$03,D0
02:0004BF94 41F90004C250    	  4873:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004BF9A 12303000        	  4874:     move.b  (A0,D3.W),D1
02:0004BF9E 8001            	  4875:     or.b  D1,D0
02:0004BFA0 4EB900031E2C    	  4876:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4877:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
