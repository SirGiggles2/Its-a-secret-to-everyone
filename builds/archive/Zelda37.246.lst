02:0004453E 12302000        	  7158:     move.b  (A0,D2.W),D1
02:00044542 B001            	  7159:     cmp.b   D1,D0
02:00044544 6704            	  7160:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00044546 5302            	  7161:     subq.b  #1,D2
02:00044548 66EE            	  7162:     bne  _anon_z05_149
                            	  7163:     even
