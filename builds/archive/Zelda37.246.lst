                            	  3369: _L_z04_UpdateRedLeever_Subtract:
                            	  3370:     ; The point is to get the absolute distance between the two.
                            	  3371:     ;
02:0003B212 102C0001        	  3372:     move.b  ($0001,A4),D0
02:0003B216 003C0011        	  3373:     ori     #$11,CCR  ; SEC: set C+X
02:0003B21A 122C0002        	  3374:     move.b  ($0002,A4),D1
02:0003B21E 0A3C0010        	  3375:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B222 9101            	  3376:     subx.b  D1,D0   ; SBC $02
02:0003B224 0A3C0010        	  3377:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3378:     ; If the absolute distance >= $30, then return.
                            	  3379:     ; It means that the leever's X coordinate wrapped around
