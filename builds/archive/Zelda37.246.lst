                            	 12738:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12739:     ;
02:0003F6C4 7402            	 12740:     moveq   #2,D2
                            	 12741:     even
                            	 12742: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F6C6 19420340        	 12743:     move.b  D2,($0340,A4)
                            	 12744:     ; If object slot < 5 or = 7, then move every frame.
                            	 12745:     ; Else move 3 out of every 4 frames.
                            	 12746:     ;
                            	 12747:     ; This makes pieces spread out in somewhat of a circle,
                            	 12748:     ; by making the pieces at cardinal directions move at
                            	 12749:     ; full speed while the diagonal ones move a little slower.
                            	 12750:     ;
02:0003F6CA 0C020005        	 12751:     cmpi.b  #$05,D2
02:0003F6CE 6510            	 12752:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F6D0 0C020007        	 12753:     cmpi.b  #$07,D2
02:0003F6D4 670A            	 12754:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F6D6 102C0015        	 12755:     move.b  ($0015,A4),D0
02:0003F6DA 02000003        	 12756:     andi.b #$03,D0
02:0003F6DE 6704            	 12757:     beq  _anon_z04_164
                            	 12758:     even
                            	 12759: _L_z04_Ganon_DrawBurst_Move:
02:0003F6E0 6100E036        	 12760:     jsr     BlueWizzrobe_Move
                            	 12761: _anon_z04_164:
02:0003F6E4 4EB90004CD8A    	 12762:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12763:     ; The frame counter will make the sprite flash.
                            	 12764:     ; The array has the horizontal and vertical flipping attributes.
                            	 12765:     ; Combine them into [03].
