02:00033A42 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:00033A46 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033A4A E14C            	   587:     lsl.w   #8,D4
02:00033A4C 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:00033A4E 48C4            	   589:     ext.l   D4
02:00033A50 D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
