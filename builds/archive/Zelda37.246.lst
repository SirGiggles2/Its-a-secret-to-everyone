02:0004C586 101D            	  5757:     move.b  (A5)+,D0  ; PLA
02:0004C588 7600            	  5758:     moveq   #0,D3
02:0004C58A 1600            	  5759:     move.b  D0,D3
02:0004C58C 41F90004C242    	  5760:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004C592 10303000        	  5761:     move.b  (A0,D3.W),D0
02:0004C596 4EB90003110E    	  5762:     jsr     SetBoomerangSpeed
02:0004C59C 102C000B        	  5763:     move.b  ($000B,A4),D0
02:0004C5A0 1940000F        	  5764:     move.b  D0,($000F,A4)
