02:0003214C 0200000F        	  6549:     andi.b #$0F,D0
02:00032150 1940000D        	  6550:     move.b  D0,($000D,A4)
02:00032154 101D            	  6551:     move.b  (A5)+,D0  ; PLA
02:00032156 020000F0        	  6552:     andi.b #$F0,D0
02:0003215A 1940000E        	  6553:     move.b  D0,($000E,A4)
