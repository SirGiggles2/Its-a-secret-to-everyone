02:00033A80 41EC0650        	   614:     lea     ($0650,A4),A0
02:00033A84 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00033A88 5203            	   618:     addq.b  #1,D3
02:00033A8A 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:00033A8C 0C020006        	   622:     cmpi.b  #$06,D2
02:00033A90 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:00033A92 1002            	   624:     move.b  D2,D0
02:00033A94 E208            	   625:     lsr.b  #1,D0   ; LSR A
02:00033A96 65A8            	   626:     bcs  _L_z02_UpdateMode0Demo_Sub2_LoopHeart
                            	   627:     ; The 3 files are consecutive in the set.
                            	   628:     ; Point to the hearts value in the next slot.
02:00033A98 1003            	   629:     move.b  D3,D0
02:00033A9A 123C0026        	   630:     move.b  #$26,D1
02:00033A9E D101            	   631:     addx.b  D1,D0   ; ADC #$26 (X flag = 6502 C)
