02:0004C5EC 4EB900030C18    	  5795:     jsr     PlayBoomerangSfx
                            	  5796:     even
                            	  5797: DrawBoomerangAndCheckCollision:
                            	  5798:     ; If the boomerang belongs to a monster, then check for
                            	  5799:     ; collision with Link.
                            	  5800:     ;
                            	  5801:     ; If they collide, then set state $20 and animation counter 3.
                            	  5802:     ;
02:0004C5F2 0C02000D        	  5803:     cmpi.b  #$0D,D2
02:0004C5F6 6502            	  5804:     bcs.s  __far_z_07_0088
02:0004C5F8 6022            	  5805:     jmp  CalcBoomerangFrame
