02:00035246 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:0003524A 5303            	  2701:     subq.b  #1,D3
02:0003524C 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:0003524E 7600            	  2703:     moveq   #0,D3
