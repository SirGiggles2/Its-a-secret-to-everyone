                            	  7956:     ;
                            	  7957:     ; Make Link go straight in one direction on the next grid line.
                            	  7958:     ;
02:00044D7C 7600            	  7959:     moveq   #0,D3
02:00044D7E 1600            	  7960:     move.b  D0,D3
02:00044D80 522C0057        	  7961:     addq.b  #1,($0057,A4)
                            	  7962:     ; If in OW or only one direction of the two is walkable, then go set
                            	  7963:     ; object direction and input direction to last walkable direction
                            	  7964:     ; found, and set Link's speed.
                            	  7965:     ;
                            	  7966:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  7967:     ;
02:00044D84 7400            	  7968:     moveq   #0,D2
02:00044D86 102C000D        	  7969:     move.b  ($000D,A4),D0
02:00044D8A 0C030001        	  7970:     cmpi.b  #$01,D3
02:00044D8E 67000096        	  7971:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
