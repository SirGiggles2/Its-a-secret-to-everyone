02:00041AAA 1600            	  2923:     move.b  D0,D3
                            	  2924: _anon_z05_76:
                            	  2925:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2926:     ;
02:00041AAC 7000            	  2927:     moveq   #0,D0
                            	  2928: ; Params:
                            	  2929: ; A: mask of buttons to block
                            	  2930: ; Y: offset into BorderBounds
                            	  2931: ; [00]: direction
                            	  2932: ; [02]: coordinate
                            	  2933: ;
                            	  2934: ; Returns:
                            	  2935: ; [01]: button mask that was used
                            	  2936: ;       (set to $FF if boundary not crossed)
                            	  2937: ;
                            	  2938:     even
                            	  2939: MaskInputInBorder:
