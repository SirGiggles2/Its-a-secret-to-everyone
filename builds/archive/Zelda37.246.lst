                            	  2164: ;==============================================================================
                            	  2165: ; EXPORT side — carry-returning shims.
                            	  2166: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2167: ; reproduces the original function's carry normalization.
                            	  2168: ;==============================================================================
                            	  2169: 
                            	  2170: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2171: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2172:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2173:     btst    #8,D0
02:0002BF8E 670A            	  2174:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2175:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2176:     eori    #$01,CCR
02:0002BF98 4E75            	  2177:     rts
                            	  2178: .cc_cnr:
02:0002BF9A 023C00FE        	  2179:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2180:     eori    #$01,CCR
02:0002BFA2 4E75            	  2181:     rts
                            	  2182: 
                            	  2183: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
                            	  2184: c_copy_next_row_advance_submode:
02:0002BFA4 4EB900000000    	  2185:     jsr     z05_copy_next_row_advance_submode
02:0002BFAA 08000008        	  2186:     btst    #8,D0
