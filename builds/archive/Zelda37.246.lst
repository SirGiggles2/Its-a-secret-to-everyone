                            	  2730:     ;
02:0003AD2A 7600            	  2731:     moveq   #0,D3
02:0003AD2C 41EC0098        	  2732:     lea     ($0098,A4),A0
02:0003AD30 16302000        	  2733:     move.b  (A0,D2.W),D3
02:0003AD34 41EC0084        	  2734:     lea     ($0084,A4),A0
02:0003AD38 10302000        	  2735:     move.b  (A0,D2.W),D0
