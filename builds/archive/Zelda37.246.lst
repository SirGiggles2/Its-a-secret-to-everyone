02:000310E0 0C000008        	  4418:     cmpi.b  #$08,D0
02:000310E4 6722            	  4419:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4420:     ; Subtract the lesser distance from the greater distance.
