02:000407B8 C200            	   982:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000407BA 660A            	   983:     bne  _L_z05_InitMode7_Sub3And4_TransferPlayAreaAttrsToNT2_Vertical
02:000407BC E208            	   984:     lsr.b  #1,D0   ; LSR A
02:000407BE 122C0098        	   985:     move.b  ($0098,A4),D1
02:000407C2 C200            	   986:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
