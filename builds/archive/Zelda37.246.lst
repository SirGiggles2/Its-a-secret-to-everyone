                            	   636:     even
                            	   637: ScrollWorld:
02:00040502 102C0015        	   638:     move.b  ($0015,A4),D0
                            	   639:     ; The purpose of this is to delay vertical scrolling.
                            	   640:     ; OW: once every two frames
                            	   641:     ; UW: once every four frames
                            	   642:     ; Horizontal scrolling happens every frame.
02:00040506 02000003        	   643:     andi.b #$03,D0
