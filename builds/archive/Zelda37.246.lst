                            	  5810:     ; Chase while flying, as usual.
                            	  5811:     ;
02:0003C3F0 610039F6        	  5812:     jsr     Flyer_Chase
                            	  5813:     ; If timer has not expired, then
                            	  5814:     ; go see if it's time to propagate direction changes down the chain.
                            	  5815:     ;
02:0003C3F4 10342028        	  5816:     move.b  ($28,A4,D2.W),D0
02:0003C3F8 6702            	  5817:     beq.s  __far_z_04_0041
