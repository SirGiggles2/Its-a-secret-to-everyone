                            	 13782:     ;
                            	 13783:     ; First, calculate a horizontal component:
                            	 13784:     ;
                            	 13785:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13786:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13787:     ; else                               [00] := 2 (left)
                            	 13788:     ;
02:0003FE08 7600            	 13789:     moveq   #0,D3
