                            	  6757: Aquamentus_Draw:
                            	  6758:     ; Every $10 screen frames, switch animation frames.
                            	  6759:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6760:     ; The last tile of frame 0 is at index 5.
                            	  6761:     ; The last tile of frame 1 is at index $B.
                            	  6762:     ;
02:0003CAB0 7605            	  6763:     moveq   #5,D3
02:0003CAB2 102C0015        	  6764:     move.b  ($0015,A4),D0
02:0003CAB6 02000010        	  6765:     andi.b #$10,D0
02:0003CABA 6602            	  6766:     bne  _anon_z04_88
02:0003CABC 760B            	  6767:     moveq   #11,D3
                            	  6768: _anon_z04_88:
02:0003CABE 1943000A        	  6769:     move.b  D3,($000A,A4)
                            	  6770:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6771:     ;
02:0003CAC2 7005            	  6772:     moveq   #5,D0
02:0003CAC4 1940000B        	  6773:     move.b  D0,($000B,A4)
                            	  6774:     even
                            	  6775: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003CAC8 7600            	  6776:     moveq   #0,D3
02:0003CACA 162C000B        	  6777:     move.b  ($000B,A4),D3
                            	  6778:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6779:     ; Store it in [00].
                            	  6780:     ;
02:0003CACE 10342070        	  6781:     move.b  ($70,A4,D2.W),D0
02:0003CAD2 023C00EE        	  6782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAD6 41F90003CAAA    	  6783:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003CADC 12303000        	  6784:     move.b  (A0,D3.W),D1
02:0003CAE0 D101            	  6785:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003CAE2 1880            	  6786:     move.b  D0,($0000,A4)
                            	  6787:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6788:     ; Store it in [01].
                            	  6789:     ;
02:0003CAE4 41EC0084        	  6790:     lea     ($0084,A4),A0
02:0003CAE8 10302000        	  6791:     move.b  (A0,D2.W),D0
02:0003CAEC 023C00EE        	  6792:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAF0 41F90003CAA4    	  6793:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003CAF6 12303000        	  6794:     move.b  (A0,D3.W),D1
02:0003CAFA D101            	  6795:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003CAFC 19400001        	  6796:     move.b  D0,($0001,A4)
                            	  6797:     ; Calculate sprite attributes:
                            	  6798:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6799:     ;
                            	  6800:     ; If the boss is temporarily invincible, then
                            	  6801:     ; this makes it flash by cycling all the palette rows.
                            	  6802:     ;
                            	  6803:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6804:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6805:     ;
02:0003CB00 41EC04F0        	  6806:     lea     ($04F0,A4),A0
02:0003CB04 10302000        	  6807:     move.b  (A0,D2.W),D0
02:0003CB08 02000003        	  6808:     andi.b #$03,D0
02:0003CB0C 0A000003        	  6809:     eori.b #$03,D0
02:0003CB10 19400003        	  6810:     move.b  D0,($0003,A4)
02:0003CB14 7600            	  6811:     moveq   #0,D3
02:0003CB16 162C000A        	  6812:     move.b  ($000A,A4),D3
                            	  6813:     ; Look up the tile for this sprite.
                            	  6814:     ; If it's not the first one (face), then go write the sprite record.
                            	  6815:     ;
02:0003CB1A 41F90003CA98    	  6816:     lea     (AquamentusTiles).l,A0
02:0003CB20 10303000        	  6817:     move.b  (A0,D3.W),D0
02:0003CB24 12390003CA98    	  6818:     move.b  (AquamentusTiles).l,D1
02:0003CB2A B001            	  6819:     cmp.b   D1,D0
02:0003CB2C 6610            	  6820:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6821:     ; Else it's the first one (the face tile).
                            	  6822:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6823:     ;
                            	  6824:     ; $CC/CD shows the closed mouth face.
                            	  6825:     ; $C0/C1 shows the open mouth face.
                            	  6826:     ;
02:0003CB2E 7600            	  6827:     moveq   #0,D3
02:0003CB30 16342028        	  6828:     move.b  ($28,A4,D2.W),D3
02:0003CB34 0C030020        	  6829:     cmpi.b  #$20,D3
02:0003CB38 6404            	  6830:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003CB3A 103C00C0        	  6831:     move.b  #$C0,D0
                            	  6832:     even
                            	  6833: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003CB3E 610E            	  6834:     jsr     WriteBossSprite
                            	  6835:     ; Bottom of the loop.
                            	  6836:     ; Decrement tile index and loop index.
                            	  6837:     ;
02:0003CB40 532C000A        	  6838:     subq.b  #1,($000A,A4)
02:0003CB44 532C000B        	  6839:     subq.b  #1,($000B,A4)
02:0003CB48 6A00FF7E        	  6840:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003CB4C 4E75            	  6841:     rts
                            	  6842: 
