                            	   836:     ;   $C0: 2
                            	   837:     ;
02:0002E86A 7602            	   838:     moveq   #2,D3
02:0002E86C 0C0000C0        	   839:     cmpi.b  #$C0,D0
02:0002E870 670A            	   840:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E872 5303            	   841:     subq.b  #1,D3
02:0002E874 0C000040        	   842:     cmpi.b  #$40,D0
02:0002E878 6702            	   843:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E87A 5303            	   844:     subq.b  #1,D3
                            	   845:     even
                            	   846: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   847:     ; The index chooses the low VRAM address of the start
                            	   848:     ; of another line:
                            	   849:     ;   0: $C4: front of the second line
                            	   850:     ;   1: $E4: front of the third line
                            	   851:     ;   2: $A4: front of the first line
                            	   852:     ;
                            	   853:     ; Look up the low VRAM address and store it.
                            	   854:     ;
02:0002E87C 41F90002E7AA    	   855:     lea     (TextboxLineAddrsLo).l,A0
02:0002E882 10303000        	   856:     move.b  (A0,D3.W),D0
02:0002E886 1940045F        	   857:     move.b  D0,($045F,A4)
                            	   858:     ; If index = 2, then we've reached the end of the text,
                            	   859:     ; and low VRAM address is moved to the front of the first line.
                            	   860:     ; So, advance the state of the person object, and unhalt Link.
                            	   861:     ;
02:0002E88A 0C030002        	   862:     cmpi.b  #$02,D3
02:0002E88E 6608            	   863:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E890 522C00AD        	   864:     addq.b  #1,($00AD,A4)
02:0002E894 6100FB98        	   865:     jsr     UnhaltLink
                            	   866:     even
