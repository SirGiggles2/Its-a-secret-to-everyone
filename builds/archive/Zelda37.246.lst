02:0004C510 7000            	  5697:     moveq   #0,D0
02:0004C512 41EC00AC        	  5698:     lea     ($00AC,A4),A0
02:0004C516 11803000        	  5699:     move.b  D0,(A0,D3.W)
02:0004C51A 0A3C0001        	  5700:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C51E 4E75            	  5701:     rts
                            	  5702: 
                            	  5703:     even
