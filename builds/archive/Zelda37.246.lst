02:0003CD14 101D            	  7082:     move.b  (A5)+,D0  ; PLA
02:0003CD16 19802070        	  7083:     move.b  D0,($70,A4,D2.W)
                            	  7084:     ; If not harmed, then return.
                            	  7085:     ;
02:0003CD1A 41EC04F0        	  7086:     lea     ($04F0,A4),A0
