02:0003F678 610000B2        	 12710:     jsr     Ganon_GetCurCloudRight
02:0003F67C 619A            	 12711:     jsr     Ganon_DrawCloud
02:0003F67E 610000A6        	 12712:     jsr     Ganon_GetCurCloudLeft
02:0003F682 610000B4        	 12713:     jsr     Ganon_GetCurCloudBottom
02:0003F686 6190            	 12714:     jsr     Ganon_DrawCloud
