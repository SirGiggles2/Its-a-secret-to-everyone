                            	  5625:     even
                            	  5626: _L_z07_CheckState30_SetState40:
                            	  5627:     ; Set state $40, and a time to move of $20 frames.
                            	  5628:     ;
                            	  5629:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5630:     ;
