                            	  7777: Submenu_CueTransferRowOW:
                            	  7778:     ;
                            	  7779:     ;
                            	  7780:     ; If menu scroll value is negative, then we transferred everything.
                            	  7781:     ; So, return.
                            	  7782:     ;
02:00044C8A 102C005E        	  7783:     move.b  ($005E,A4),D0
