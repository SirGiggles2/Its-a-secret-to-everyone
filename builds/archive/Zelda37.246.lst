02:00033A08 41EC0630        	   565:     lea     ($0630,A4),A0
02:00033A0C 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00033A10 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00033A14 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00033A18 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00033A1C E14C            	   570:     lsl.w   #8,D4
02:00033A1E 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
