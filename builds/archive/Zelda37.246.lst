                            	 12304: UpdateGanon_JumpTable:
02:0003F3DC 0003F3E8        	 12305:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F3E0 0003F44A        	 12306:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F3E4 0003F478        	 12307:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12308: 
                            	 12309: ; Description:
                            	 12310: ; Lift up the Triforce of Courage while the room is dark.
                            	 12311: ;
                            	 12312: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12313: ;
                            	 12314:     even
                            	 12315: Ganon_ScenePhase0:
02:0003F3E8 701B            	 12316:     moveq   #27,D0
02:0003F3EA 19400505        	 12317:     move.b  D0,($0505,A4)
                            	 12318:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12319:     ;
02:0003F3EE 102C0028        	 12320:     move.b  ($0028,A4),D0
02:0003F3F2 6644            	 12321:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12322:     ; Once the timer expires, it's time to brighten the room.
                            	 12323:     ;
                            	 12324:     ; Save the current object slot.
02:0003F3F4 1002            	 12325:     move.b  D2,D0
02:0003F3F6 1B00            	 12326:     move.b  D0,-(A5)  ; PHA
02:0003F3F8 610007F0        	 12327:     jsr     UpdateCandle
02:0003F3FC 101D            	 12328:     move.b  (A5)+,D0  ; PLA
02:0003F3FE 7400            	 12329:     moveq   #0,D2
02:0003F400 1400            	 12330:     move.b  D0,D2
                            	 12331:     ; Turn off the room brightening flag, because we're controlling it
                            	 12332:     ; here instead of in the Mode 5 object update loop.
                            	 12333:     ;
02:0003F402 7000            	 12334:     moveq   #0,D0
02:0003F404 1940051E        	 12335:     move.b  D0,($051E,A4)
                            	 12336:     ; On the first frame of the fade-to-light cycle, play the
                            	 12337:     ; Triforce/Ganon song.
                            	 12338:     ;
02:0003F408 102C051C        	 12339:     move.b  ($051C,A4),D0
02:0003F40C 0C0000C0        	 12340:     cmpi.b  #$C0,D0
02:0003F410 6606            	 12341:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F412 7002            	 12342:     moveq   #2,D0
02:0003F414 19400600        	 12343:     move.b  D0,($0600,A4)
                            	 12344:     even
                            	 12345: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	 12346:     ; If the fade cycle has not ended, then go draw Ganon.
                            	 12347:     ;
02:0003F418 102C051C        	 12348:     move.b  ($051C,A4),D0
02:0003F41C 0200000F        	 12349:     andi.b #$0F,D0
02:0003F420 0C000004        	 12350:     cmpi.b  #$04,D0
02:0003F424 6702            	 12351:     beq.s  __far_z_04_0115
02:0003F426 6042            	 12352:     jmp  Ganon_DrawBodyFrame0
                            	 12353: __far_z_04_0115:
                            	 12354:     ; Set Link's timer to $C0 for the next scene phase.
                            	 12355:     ;
02:0003F428 103C00C0        	 12356:     move.b  #$C0,D0
02:0003F42C 19400028        	 12357:     move.b  D0,($0028,A4)
                            	 12358:     ; Set scene phase 1, and go draw Ganon.
                            	 12359:     ;
02:0003F430 522C0445        	 12360:     addq.b  #1,($0445,A4)
02:0003F434 6702            	 12361:     beq.s  __far_z_04_0116
02:0003F436 6032            	 12362:     jmp  Ganon_DrawBodyFrame0
                            	 12363: __far_z_04_0116:
                            	 12364:     even
                            	 12365: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	 12366:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	 12367:     ; In this case, I think it means Ganon is shouting.
                            	 12368:     ;
