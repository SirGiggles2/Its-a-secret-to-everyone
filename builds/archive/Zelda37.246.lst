02:0004BFD6 41EC00AC        	  4906:     lea     ($00AC,A4),A0
02:0004BFDA 10302000        	  4907:     move.b  (A0,D2.W),D0
02:0004BFDE E308            	  4908:     lsl.b  #1,D0   ; ASL A
02:0004BFE0 6402            	  4909:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4910:     even
