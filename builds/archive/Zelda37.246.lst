                            	  5585: CheckState30:
                            	  5586:     ; If major state <> $30, go check other states.
                            	  5587:     ;
02:0004C46A 0C000030        	  5588:     cmpi.b  #$30,D0
02:0004C46E 6656            	  5589:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5590:     ; State $3x. Slow down.
                            	  5591:     ;
                            	  5592:     ; Reset grid offset for movement.
                            	  5593:     ;
02:0004C470 7000            	  5594:     moveq   #0,D0
02:0004C472 41EC0394        	  5595:     lea     ($0394,A4),A0
02:0004C476 11802000        	  5596:     move.b  D0,(A0,D2.W)
                            	  5597:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
