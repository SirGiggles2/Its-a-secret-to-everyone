02:0003CF44 0C030002        	  7438:     cmpi.b  #$02,D3
02:0003CF48 6718            	  7439:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CF4A 0C030003        	  7440:     cmpi.b  #$03,D3
02:0003CF4E 6712            	  7441:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7442:     ; State 1, substate 1
                            	  7443:     ;
                            	  7444:     ; Add $14 to the frame image index to index into the bloated
                            	  7445:     ; frame images and H-flips.
                            	  7446:     ;
02:0003CF50 1014            	  7447:     move.b  ($0000,A4),D0
02:0003CF52 023C00EE        	  7448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF56 123C0014        	  7449:     move.b  #$14,D1
02:0003CF5A D101            	  7450:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CF5C 7600            	  7451:     moveq   #0,D3
02:0003CF5E 1600            	  7452:     move.b  D0,D3
02:0003CF60 6032            	  7453:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
