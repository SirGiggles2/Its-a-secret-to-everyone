02:000310C4 9101            	  4399:     subx.b  D1,D0   ; SBC $04
02:000310C6 0A3C0010        	  4400:     eori    #$10,CCR  ; restore X = 6502 C
02:000310CA 0C000008        	  4401:     cmpi.b  #$08,D0
