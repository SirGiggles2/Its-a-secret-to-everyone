02:0003F5E0 123C0004        	 12637:     move.b  #$04,D1
02:0003F5E4 D101            	 12638:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F5E6 19803072        	 12639:     move.b  D0,($72,A4,D3.W)
02:0003F5EA 41EC0084        	 12640:     lea     ($0084,A4),A0
02:0003F5EE 10302000        	 12641:     move.b  (A0,D2.W),D0
02:0003F5F2 123C0004        	 12642:     move.b  #$04,D1
02:0003F5F6 D101            	 12643:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003F5F8 41EC0086        	 12644:     lea     ($0086,A4),A0
02:0003F5FC 11803000        	 12645:     move.b  D0,(A0,D3.W)
                            	 12646:     ; Set the direction.
