02:0003CF8A 123C0005        	  7486:     move.b  #$05,D1
02:0003CF8E D101            	  7487:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CF90 7600            	  7488:     moveq   #0,D3
