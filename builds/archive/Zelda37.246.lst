02:0003FA66 6716            	 13232:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	 13233:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	 13234:     ; But there is a random chance that the item drop will be canceled.
                            	 13235:     ;
02:0003FA68 102C0050        	 13236:     move.b  ($0050,A4),D0
