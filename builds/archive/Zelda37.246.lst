                            	  7331: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D1C6 7400            	  7332:     moveq   #0,D2
02:0004D1C8 142C0340        	  7333:     move.b  ($0340,A4),D2
                            	  7334:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7335:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7336:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7337:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7338:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7339:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7340:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7341:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7342:     ; corrupting them and causing a deterministic address-error
                            	  7343:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7344:     ; identified by Codex static review.)
                            	  7345: _L_z07_P47_pre_check:
02:0004D1CC 102C0525        	  7346:     move.b  ($0525,A4),D0
02:0004D1D0 020000F0        	  7347:     andi.b  #$F0,D0
02:0004D1D4 0C000040        	  7348:     cmpi.b  #$40,D0
02:0004D1D8 6506            	  7349:     blo     _L_z07_P47_pre_snap
02:0004D1DA 0C0000E0        	  7350:     cmpi.b  #$E0,D0
02:0004D1DE 6506            	  7351:     blo     _L_z07_P47_pre_ok
                            	  7352: _L_z07_P47_pre_snap:
02:0004D1E0 197C00480525    	  7353:     move.b  #$48,($0525,A4)
                            	  7354: _L_z07_P47_pre_ok:
02:0004D1E6 7005            	  7355:     moveq   #5,D0
02:0004D1E8 610004F4        	  7356:     jsr     SwitchBank
02:0004D1EC 4EB900041F7C    	  7357:     jsr     FindNextEdgeSpawnCell
                            	  7358:     ; Post-walk 1: bottom-edge snap.
02:0004D1F2 102C0525        	  7359:     move.b  ($0525,A4),D0
02:0004D1F6 020000F0        	  7360:     andi.b  #$F0,D0
02:0004D1FA 0C0000E0        	  7361:     cmpi.b  #$E0,D0
02:0004D1FE 660C            	  7362:     bne     _L_z07_P47_post1_ok
02:0004D200 197C00480525    	  7363:     move.b  #$48,($0525,A4)
02:0004D206 4EB900041F7C    	  7364:     jsr     FindNextEdgeSpawnCell
                            	  7365: _L_z07_P47_post1_ok:
                            	  7366:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7367:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D20C 7600            	  7368:     moveq   #0,D3
02:0004D20E 162C0525        	  7369:     move.b  ($0525,A4),D3
02:0004D212 0243000F        	  7370:     andi.w  #$000F,D3
02:0004D216 C6FC002C        	  7371:     mulu.w  #44,D3
02:0004D21A 203C00FF6530    	  7372:     move.l  #$FF6530,D0
02:0004D220 D083            	  7373:     add.l   D3,D0
