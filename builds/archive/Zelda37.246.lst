02:0003C5D6 41EC0478        	  6164:     lea     ($0478,A4),A0
02:0003C5DA 16302000        	  6165:     move.b  (A0,D2.W),D3
                            	  6166:     ; Change the coordinates to one corner.
                            	  6167:     ;
02:0003C5DE 10342070        	  6168:     move.b  ($70,A4,D2.W),D0
