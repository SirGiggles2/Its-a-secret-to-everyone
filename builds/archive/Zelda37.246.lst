                            	  5774: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5775:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5776:     ; We need to remember how many tiles need to be copied
                            	  5777:     ; in each transfer record.
                            	  5778:     ;
02:000438E0 102C0006        	  5779:     move.b  ($0006,A4),D0
02:000438E4 19400004        	  5780:     move.b  D0,($0004,A4)
                            	  5781:     ; Write the transfer record header for the door.
                            	  5782:     ;
                            	  5783:     ;
                            	  5784:     ; VRAM address high byte of door
02:000438E8 1014            	  5785:     move.b  ($0000,A4),D0
02:000438EA 41EC0302        	  5786:     lea     ($0302,A4),A0
02:000438EE 11802000        	  5787:     move.b  D0,(A0,D2.W)
02:000438F2 5202            	  5788:     addq.b  #1,D2
02:000438F4 102C0001        	  5789:     move.b  ($0001,A4),D0
02:000438F8 41EC0302        	  5790:     lea     ($0302,A4),A0
02:000438FC 11802000        	  5791:     move.b  D0,(A0,D2.W)
02:00043900 5202            	  5792:     addq.b  #1,D2
02:00043902 102C0006        	  5793:     move.b  ($0006,A4),D0
02:00043906 41EC0302        	  5794:     lea     ($0302,A4),A0
02:0004390A 11802000        	  5795:     move.b  D0,(A0,D2.W)
02:0004390E 5202            	  5796:     addq.b  #1,D2
                            	  5797: _anon_z05_121:
                            	  5798:     ; Write two tiles in a short loop indexed by [04].
                            	  5799:     ;
02:00043910 6100ED1C        	  5800:     jsr     WriteDoorFaceTileHorizontally
02:00043914 66FA            	  5801:     bne  _anon_z05_121
                            	  5802:     ; OR the low VRAM address with $20 to go down one row
                            	  5803:     ; in order to work on the second row of door tiles.
                            	  5804:     ;
02:00043916 7020            	  5805:     moveq   #32,D0
02:00043918 122C0001        	  5806:     move.b  ($0001,A4),D1
02:0004391C 8001            	  5807:     or.b  D1,D0
02:0004391E 19400001        	  5808:     move.b  D0,($0001,A4)
                            	  5809:     ; Bottom of the loop.
                            	  5810:     ; Loop again to write the second transfer record for the
                            	  5811:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5812:     ;
02:00043922 532C0005        	  5813:     subq.b  #1,($0005,A4)
02:00043926 66B8            	  5814:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5815:     ; Write the end marker, and update buffer length.
                            	  5816:     ;
02:00043928 103C00FF        	  5817:     move.b  #$FF,D0
02:0004392C 41EC0302        	  5818:     lea     ($0302,A4),A0
02:00043930 11802000        	  5819:     move.b  D0,(A0,D2.W)
02:00043934 1002            	  5820:     move.b  D2,D0
02:00043936 19400301        	  5821:     move.b  D0,($0301,A4)
                            	  5822:     ; Increment the command.
                            	  5823:     ;
02:0004393A 522C0054        	  5824:     addq.b  #1,($0054,A4)
                            	  5825:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5826:     ; and resetting the door command.
                            	  5827:     ; This ends up catching original states 3 and 7.
                            	  5828:     ;
                            	  5829:     ; Else set door timer to 8 and return.
                            	  5830:     ;
02:0004393E 102C0054        	  5831:     move.b  ($0054,A4),D0
02:00043942 02000003        	  5832:     andi.b #$03,D0
02:00043946 6708            	  5833:     beq  _anon_z05_122
02:00043948 7008            	  5834:     moveq   #8,D0
02:0004394A 19400027        	  5835:     move.b  D0,($0027,A4)
02:0004394E 4E75            	  5836:     rts
                            	  5837: 
                            	  5838: _anon_z05_122:
                            	  5839:     ; If the door command = 4 after incrementing it, then
                            	  5840:     ; it was 3 (close door). So:
                            	  5841:     ; 1. reset this door's flag
                            	  5842:     ; 2. remove it from the opened door mask
                            	  5843:     ; 3. reset the door command
                            	  5844:     ; 4. go lay out doors in the play area map
                            	  5845:     ;
02:00043950 102C0054        	  5846:     move.b  ($0054,A4),D0
02:00043954 0C000004        	  5847:     cmpi.b  #$04,D0
02:00043958 6626            	  5848:     bne  _anon_z05_123
02:0004395A 7400            	  5849:     moveq   #0,D2
02:0004395C 142C0009        	  5850:     move.b  ($0009,A4),D2
02:00043960 6100DCE2        	  5851:     jsr     ResetDoorFlag
02:00043964 102C0055        	  5852:     move.b  ($0055,A4),D0
02:00043968 0A00000F        	  5853:     eori.b #$0F,D0
02:0004396C 122C00EE        	  5854:     move.b  ($00EE,A4),D1
02:00043970 C001            	  5855:     and.b  D1,D0
                            	  5856:     even
                            	  5857: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00043972 194000EE        	  5858:     move.b  D0,($00EE,A4)
                            	  5859:     even
                            	  5860: L_ResetDoorCmdAndLayOutDoors:
02:00043976 7000            	  5861:     moveq   #0,D0
02:00043978 19400054        	  5862:     move.b  D0,($0054,A4)
02:0004397C 6000FCD4        	  5863:     jmp     LayOutDoors
                            	  5864: 
                            	  5865: _anon_z05_123:
                            	  5866:     ; Door command <> 4.
                            	  5867:     ; It must be 8, which means it was 7: open door.
                            	  5868:     ;
                            	  5869:     ; If the door is a shutter (7), then go add the door to the
                            	  5870:     ; opened door mask, reset door command, and lay out doors.
                            	  5871:     ;
02:00043980 102C0055        	  5872:     move.b  ($0055,A4),D0
02:00043984 19400002        	  5873:     move.b  D0,($0002,A4)
02:00043988 6100FA32        	  5874:     jsr     FindDoorAttrByDoorBit
02:0004398C 0C000007        	  5875:     cmpi.b  #$07,D0
02:00043990 676E            	  5876:     beq  _anon_z05_124
                            	  5877:     ; Else the door is not a shutter.
                            	  5878:     ;
                            	  5879:     ;
                            	  5880:     ; [09] door direction index
02:00043992 7400            	  5881:     moveq   #0,D2
02:00043994 142C0009        	  5882:     move.b  ($0009,A4),D2
02:00043998 6100DCA4        	  5883:     jsr     SetDoorFlag
                            	  5884:     ; Get the next room's ID.
                            	  5885:     ;
02:0004399C 1003            	  5886:     move.b  D3,D0
02:0004399E 023C00EE        	  5887:     andi    #$EE,CCR  ; CLC: clear C+X
02:000439A2 41F90004385E    	  5888:     lea     (DoorNextRoomIdOffsets).l,A0
02:000439A8 12302000        	  5889:     move.b  (A0,D2.W),D1
02:000439AC D101            	  5890:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000439AE 7600            	  5891:     moveq   #0,D3
02:000439B0 1600            	  5892:     move.b  D0,D3
                            	  5893:     ; Flip the door direction index.
                            	  5894:     ;
02:000439B2 1002            	  5895:     move.b  D2,D0
02:000439B4 0A000001        	  5896:     eori.b #$01,D0
02:000439B8 7400            	  5897:     moveq   #0,D2
02:000439BA 1400            	  5898:     move.b  D0,D2
                            	  5899:     ; Set the door flag for the opposite door in the next room.
                            	  5900:     ;
02:000439BC 1214            	  5901:     move.b  ($00,A4),D1   ; ptr lo
02:000439BE 182C0001        	  5902:     move.b  ($01,A4),D4  ; ptr hi
02:000439C2 024100FF        	  5903:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439C6 E14C            	  5904:     lsl.w   #8,D4
02:000439C8 8841            	  5905:     or.w    D1,D4             ; D4 = NES ptr addr
02:000439CA 48C4            	  5906:     ext.l   D4
02:000439CC D8BC00FF0000    	  5907:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000439D2 2044            	  5908:     movea.l D4,A0
02:000439D4 10303000        	  5909:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000439D8 41F90004AB1C    	  5910:     lea     (LevelMasks).l,A0
02:000439DE 12302000        	  5911:     move.b  (A0,D2.W),D1
02:000439E2 8001            	  5912:     or.b  D1,D0
02:000439E4 1214            	  5913:     move.b  ($00,A4),D1   ; ptr lo
02:000439E6 182C0001        	  5914:     move.b  ($01,A4),D4  ; ptr hi
02:000439EA 024100FF        	  5915:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000439EE E14C            	  5916:     lsl.w   #8,D4
02:000439F0 8841            	  5917:     or.w    D1,D4
02:000439F2 48C4            	  5918:     ext.l   D4
02:000439F4 D8BC00FF0000    	  5919:     add.l   #NES_RAM,D4
02:000439FA 2044            	  5920:     movea.l D4,A0
02:000439FC 11803000        	  5921:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5922: _anon_z05_124:
                            	  5923:     ; Add the door to the opened door mask, reset door command,
                            	  5924:     ; and lay out doors.
                            	  5925:     ;
02:00043A00 102C0055        	  5926:     move.b  ($0055,A4),D0
02:00043A04 122C00EE        	  5927:     move.b  ($00EE,A4),D1
02:00043A08 8001            	  5928:     or.b  D1,D0
02:00043A0A 6000FF66        	  5929:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5930: 
                            	  5931: ; Params:
                            	  5932: ; [08]: 0 if closed
                            	  5933: ;
                            	  5934: ; Returns:
                            	  5935: ; X: current length of dynamic transfer buf
                            	  5936: ; [00]: door VRAM address high byte
                            	  5937: ; [01]: door VRAM address low byte
                            	  5938: ; [02:03]: address of door tiles for direction and face
                            	  5939: ; [05]: 2, the number of transfer records to write
                            	  5940: ; [06]: 2, the number of tiles in each record
                            	  5941: ; [07]: 0, the first index of a tile to transfer
                            	  5942: ; [09]: door direction index
                            	  5943: ;
                            	  5944: ; Note that this routine is called with triggered doors:
                            	  5945: ; doors that can change state. Their door type numbers are >= 4.
                            	  5946: ;
                            	  5947: ; If this routine were ever called with a fixed door
                            	  5948: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5949: ; values for the door face.
                            	  5950: ;
                            	  5951: ;
                            	  5952: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5953: ;
                            	  5954:     even
                            	  5955: PrepareWriteHorizontalDoorTransferRecords:
02:00043A0E 102C0055        	  5956:     move.b  ($0055,A4),D0
02:00043A12 19400002        	  5957:     move.b  D0,($0002,A4)
02:00043A16 6100F9A4        	  5958:     jsr     FindDoorAttrByDoorBit
02:00043A1A 0C000005        	  5959:     cmpi.b  #$05,D0
02:00043A1E 650C            	  5960:     bcs  _anon_z05_125
02:00043A20 1B00            	  5961:     move.b  D0,-(A5)  ; PHA
02:00043A22 7004            	  5962:     moveq   #4,D0
