02:0004C44A 7002            	  5571:     moveq   #2,D0
02:0004C44C 1940000C        	  5572:     move.b  D0,($000C,A4)
02:0004C450 7000            	  5573:     moveq   #0,D0
02:0004C452 1940000F        	  5574:     move.b  D0,($000F,A4)
                            	  5575:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5576:     ; and go draw.
                            	  5577:     ;
02:0004C456 41EC0098        	  5578:     lea     ($0098,A4),A0
02:0004C45A 10302000        	  5579:     move.b  (A0,D2.W),D0
02:0004C45E 4EB900030FE2    	  5580:     jsr     GetOppositeDir
