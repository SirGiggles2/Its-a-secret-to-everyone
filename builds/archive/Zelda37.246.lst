02:0002E5D4 6644            	   473:     bne  _L_z01_UpdateCavePerson_DrawItems
02:0002E5D6 102C0666        	   474:     move.b  ($0666,A4),D0
02:0002E5DA 0C000002        	   475:     cmpi.b  #$02,D0
02:0002E5DE 673A            	   476:     beq  _L_z01_UpdateCavePerson_DrawItems
                            	   477:     ; If the letter is selected, and B is pressed, then go use the letter.
