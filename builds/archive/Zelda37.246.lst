02:00036902 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00036906 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003690A 5303            	  4886:     subq.b  #1,D3
02:0003690C 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:0003690E 7600            	  4891:     moveq   #0,D3
02:00036910 162C0413        	  4892:     move.b  ($0413,A4),D3
02:00036914 41F9000368AE    	  4893:     lea     (PeaceText).l,A0
02:0003691A 10303000        	  4894:     move.b  (A0,D3.W),D0
02:0003691E 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:00036922 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00036924 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:00036928 0C000024        	  4901:     cmpi.b  #$24,D0
02:0003692C 6706            	  4902:     beq  _anon_z02_36
