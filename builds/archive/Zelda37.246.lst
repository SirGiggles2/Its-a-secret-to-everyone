                            	  1683:     ;
02:0003A674 10342070        	  1684:     move.b  ($70,A4,D2.W),D0
02:0003A678 023C00EE        	  1685:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A67C 123C0008        	  1686:     move.b  #$08,D1
02:0003A680 D101            	  1687:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A682 020000F0        	  1688:     andi.b #$F0,D0
02:0003A686 19802070        	  1689:     move.b  D0,($70,A4,D2.W)
                            	  1690:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1691:     ;
02:0003A68A 41EC0084        	  1692:     lea     ($0084,A4),A0
02:0003A68E 10302000        	  1693:     move.b  (A0,D2.W),D0
02:0003A692 123C0008        	  1694:     move.b  #$08,D1
02:0003A696 D101            	  1695:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A698 020000F0        	  1696:     andi.b #$F0,D0
02:0003A69C 0000000D        	  1697:     ori.b #$0D,D0
02:0003A6A0 41EC0084        	  1698:     lea     ($0084,A4),A0
02:0003A6A4 11802000        	  1699:     move.b  D0,(A0,D2.W)
