                            	  3943: Link_ModifyDirInDoorway:
02:0004219A 4EF90002C05C    	  3944:     jmp     c_link_modify_dir_in_doorway
                            	  3945: 
                            	  3946: DoorwayRequiredCoord:
02:000421A0 78              	  3947:     dc.b    $78, $78, $8D, $8D
02:000421A1 78
02:000421A2 8D
02:000421A3 8D
                            	  3948: 
                            	  3949: ; Player coordinate must be >= these bounds.
                            	  3950: ; Using these bounds; the player will be considered within the
                            	  3951: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3952: ;
                            	  3953:     even
                            	  3954: DoorwayBoundsMinOver:
02:000421A4 3D              	  3955:     dc.b    $3D, $BD, $00, $CF
02:000421A5 BD
02:000421A6 00
02:000421A7 CF
                            	  3956: 
                            	  3957: ; Player coordinate must be < these bounds.
                            	  3958: ; Using these bounds; the player will be considered within the
                            	  3959: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  3960: ;
                            	  3961:     even
                            	  3962: DoorwayBoundsMaxOver:
02:000421A8 5E              	  3963:     dc.b    $5E, $DE, $21, $F1
02:000421A9 DE
02:000421AA 21
02:000421AB F1
                            	  3964: 
                            	  3965: ; Player coordinate must be >= these bounds.
                            	  3966: ; Using these bounds; the player will be considered within the
                            	  3967: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3968: ; at the edge.
                            	  3969: ;
                            	  3970:     even
                            	  3971: DoorwayBoundsMinUnder:
02:000421AC 3D              	  3972:     dc.b    $3D, $BF, $00, $D2
02:000421AD BF
02:000421AE 00
02:000421AF D2
                            	  3973: 
                            	  3974: ; Player coordinate must be < these bounds.
                            	  3975: ; Using these bounds; the player will be considered within the
                            	  3976: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  3977: ; at the edge.
                            	  3978: ;
                            	  3979:     even
                            	  3980: DoorwayBoundsMaxUnder:
02:000421B0 5C              	  3981:     dc.b    $5C, $DE, $1F, $F1
02:000421B1 DE
02:000421B2 1F
02:000421B3 F1
                            	  3982: 
                            	  3983: ; Params:
                            	  3984: ; [0F]: moving direction
                            	  3985: ;
                            	  3986: ; Returns:
                            	  3987: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  3988: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  3989: ;
                            	  3990: ; When not at or in a doorway, this function leaves
                            	  3991: ; [0F] moving direction as is.
                            	  3992: ;
                            	  3993: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  3994: ; will be left as is, assuming that it had been reset before this
                            	  3995: ; routine by BoundByRoom.
                            	  3996: ;
                            	  3997: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  3998: ;
                            	  3999: ;
                            	  4000: ; If already in a doorway, go handle it separately.
                            	  4001: ;
                            	  4002:     even
                            	  4003: CheckDoorway:
02:000421B4 102C0053        	  4004:     move.b  ($0053,A4),D0
02:000421B8 6648            	  4005:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4006:     even
                            	  4007: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4008:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4009:     ;
                            	  4010:     ; To match a doorway:
                            	  4011:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4012:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4013:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4014:     ;
                            	  4015:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4016:     ; a doorway to be part of it.
                            	  4017:     ;
02:000421BA 102C0098        	  4018:     move.b  ($0098,A4),D0
02:000421BE 61000122        	  4019:     jsr     GetPlayerCoordsForDirection
02:000421C2 7603            	  4020:     moveq   #3,D3
                            	  4021:     even
