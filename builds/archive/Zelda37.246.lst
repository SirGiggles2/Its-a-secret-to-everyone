02:00035254 41F900034AB6    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:0003525A 10303000        	  2706:     move.b  (A0,D3.W),D0
02:0003525E 19400084        	  2707:     move.b  D0,($0084,A4)
02:00035262 19400200        	  2708:     move.b  D0,($0200,A4)
02:00035266 102C0012        	  2709:     move.b  ($0012,A4),D0
02:0003526A 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
