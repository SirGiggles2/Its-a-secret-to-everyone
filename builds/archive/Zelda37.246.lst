02:0003CF7C 122C0015        	  7478:     move.b  ($0015,A4),D1
02:0003CF80 C001            	  7479:     and.b  D1,D0
02:0003CF82 6710            	  7480:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7481:     ; For animation frame 1, add 5 to the index in Y register,
