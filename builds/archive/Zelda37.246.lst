                            	   455: UpdateCavePerson:
                            	   456:     ; If in state 4, then every other frame skip drawing the person
                            	   457:     ; and items; and go straight to the state code for each kind of cave.
                            	   458:     ;
02:0002E5B6 102C00AD        	   459:     move.b  ($00AD,A4),D0
02:0002E5BA 0C000004        	   460:     cmpi.b  #$04,D0
02:0002E5BE 660A            	   461:     bne  _anon_z01_2
02:0002E5C0 102C0015        	   462:     move.b  ($0015,A4),D0
