                            	  4159: __far_z_07_0049:
                            	  4160:     ; Moving direction = 0.
                            	  4161:     ; If object is the player, return.
                            	  4162:     ;
02:0004BAFA 4A02            	  4163:     cmpi.b  #$00,D2
