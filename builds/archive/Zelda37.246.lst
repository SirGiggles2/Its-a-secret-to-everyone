                            	   623: 
                            	   624: ;------------------------------------------------------------------------------
                            	   625: ; _c_move_object_shim — MoveObject trampoline.
                            	   626: ;
                            	   627: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   628: ;   Input:     D2 = slot (0..11)
                            	   629: ;   Preserves: D2, A4, A5
                            	   630: ;   Clobbers:  D0, D1, D3, A0
                            	   631: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   632: ;
                            	   633: ; GCC side:
                            	   634: ;   void c_move_object(unsigned short slot);
                            	   635: ;     slot arrives as a 16-bit value on the stack.
                            	   636: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   637: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   638: ;   never clobbered by gcc.
                            	   639: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   640: ;   semantics can exist in a pure C port).
                            	   641: ;------------------------------------------------------------------------------
                            	   642: _c_move_object_shim:
                            	   643:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   644:     move.b  #$AA,($0900,A4)
                            	   645:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   646:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   647:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   648:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   649:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   650:     moveq   #0,D0
02:0002B658 3002            	   651:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   652:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   653:     jsr     c_move_object
02:0002B662 588F            	   654:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   655:     rts
                            	   656: 
                            	   657: ;==============================================================================
                            	   658: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   659: ; and tail-call the native asm function.
                            	   660: ;
                            	   661: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   662: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   663: ; sign-extended).
                            	   664: ;==============================================================================
                            	   665: 
                            	   666: ;------------------------------------------------------------------------------
                            	   667: ; void c_copy_bank_to_window(unsigned int bank);
                            	   668: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   669: ;------------------------------------------------------------------------------
                            	   670: c_copy_bank_to_window:
02:0002B666 202F0004        	   671:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   672:     jmp     _copy_bank_to_window
                            	   673: 
                            	   674: ;------------------------------------------------------------------------------
                            	   675: ; unsigned char c_ppu_read_2(void);
                            	   676: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   677: ; C return: gcc expects result in D0.
                            	   678: ;------------------------------------------------------------------------------
                            	   679: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   680:     jmp     _ppu_read_2
                            	   681: 
                            	   682: ;------------------------------------------------------------------------------
                            	   683: ; void c_ppu_write_6(unsigned int val);
                            	   684: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   685: ;------------------------------------------------------------------------------
                            	   686: c_ppu_write_6:
02:0002B674 202F0004        	   687:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   688:     jmp     _ppu_write_6
