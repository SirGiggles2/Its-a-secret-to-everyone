                            	 12823: Ganon_DrawBody:
                            	 12824:     ; Loop over four 16x16 images that make up Ganon.
                            	 12825:     ; There are 6 animation frames.
                            	 12826:     ;
02:0003F762 7603            	 12827:     moveq   #3,D3
                            	 12828:     even
                            	 12829: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12830:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12831:     ;
02:0003F764 10342070        	 12832:     move.b  ($70,A4,D2.W),D0
02:0003F768 023C00EE        	 12833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F76C 41F90003F756    	 12834:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F772 12303000        	 12835:     move.b  (A0,D3.W),D1
02:0003F776 D101            	 12836:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F778 1880            	 12837:     move.b  D0,($0000,A4)
                            	 12838:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12839:     ;
02:0003F77A 41EC0084        	 12840:     lea     ($0084,A4),A0
02:0003F77E 10302000        	 12841:     move.b  (A0,D2.W),D0
02:0003F782 023C00EE        	 12842:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F786 41F90003F75A    	 12843:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F78C 12303000        	 12844:     move.b  (A0,D3.W),D1
02:0003F790 D101            	 12845:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F792 19400001        	 12846:     move.b  D0,($0001,A4)
                            	 12847:     ; Each part has a horizontal flipping flag.
                            	 12848:     ;
02:0003F796 41F90003F75E    	 12849:     lea     (GanonSpriteHFlips).l,A0
02:0003F79C 10303000        	 12850:     move.b  (A0,D3.W),D0
02:0003F7A0 1940000F        	 12851:     move.b  D0,($000F,A4)
                            	 12852:     ; Save and copy the loop index (the current part) to [07].
                            	 12853:     ;
02:0003F7A4 1003            	 12854:     move.b  D3,D0
02:0003F7A6 1B00            	 12855:     move.b  D0,-(A5)  ; PHA
02:0003F7A8 19400007        	 12856:     move.b  D0,($0007,A4)
                            	 12857:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12858:     ; that make it up.
                            	 12859:     ;
02:0003F7AC 41EC046B        	 12860:     lea     ($046B,A4),A0
02:0003F7B0 10302000        	 12861:     move.b  (A0,D2.W),D0
02:0003F7B4 E308            	 12862:     lsl.b  #1,D0   ; ASL A
02:0003F7B6 E308            	 12863:     lsl.b  #1,D0   ; ASL A
                            	 12864:     ; Add [07] -- the index of the current part.
                            	 12865:     ;
                            	 12866:     ; Now you have an index into the frame image table, for the
                            	 12867:     ; current image part of the current animation frame.
                            	 12868:     ;
02:0003F7B8 122C0007        	 12869:     move.b  ($0007,A4),D1
02:0003F7BC D101            	 12870:     addx.b  D1,D0   ; ADC $07
02:0003F7BE 7600            	 12871:     moveq   #0,D3
02:0003F7C0 1600            	 12872:     move.b  D0,D3
02:0003F7C2 41F90003F73E    	 12873:     lea     (GanonFrameImages).l,A0
02:0003F7C8 10303000        	 12874:     move.b  (A0,D3.W),D0
02:0003F7CC 4EB900031B3A    	 12875:     jsr     DrawObjectNotMirrored
02:0003F7D2 101D            	 12876:     move.b  (A5)+,D0  ; PLA
                            	 12877:     ; Bottom of the part loop.
                            	 12878:     ;
02:0003F7D4 7600            	 12879:     moveq   #0,D3
02:0003F7D6 1600            	 12880:     move.b  D0,D3
02:0003F7D8 5303            	 12881:     subq.b  #1,D3
02:0003F7DA 6A88            	 12882:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F7DC 4E75            	 12883:     rts
