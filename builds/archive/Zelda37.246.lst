                            	 12886: Ganon_CheckCollisions:
                            	 12887:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12888:     ; Store in [02] and [03].
                            	 12889:     ;
02:0003F7DE 10342070        	 12890:     move.b  ($70,A4,D2.W),D0
02:0003F7E2 023C00EE        	 12891:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F7E6 123C0010        	 12892:     move.b  #$10,D1
02:0003F7EA D101            	 12893:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F7EC 19400002        	 12894:     move.b  D0,($0002,A4)
02:0003F7F0 41EC0084        	 12895:     lea     ($0084,A4),A0
02:0003F7F4 10302000        	 12896:     move.b  (A0,D2.W),D0
02:0003F7F8 023C00EE        	 12897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F7FC 123C0010        	 12898:     move.b  #$10,D1
02:0003F800 D101            	 12899:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F802 19400003        	 12900:     move.b  D0,($0003,A4)
                            	 12901:     ; Check for a collision with Link.
                            	 12902:     ;
                            	 12903:     ; We can't call CheckLinkCollision, because we need to
                            	 12904:     ; customize Ganon's midpoint.
                            	 12905:     ;
                            	 12906:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12907:     ; detection, if Link is invincible. Initialize variables that will
                            	 12908:     ; be returned from the partial collision check routine. Then
                            	 12909:     ; call it.
                            	 12910:     ;
02:0003F806 102C04F0        	 12911:     move.b  ($04F0,A4),D0
02:0003F80A 6616            	 12912:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F80C 19400006        	 12913:     move.b  D0,($0006,A4)
02:0003F810 19400009        	 12914:     move.b  D0,($0009,A4)
02:0003F814 1940000C        	 12915:     move.b  D0,($000C,A4)
02:0003F818 7600            	 12916:     moveq   #0,D3
02:0003F81A 1883            	 12917:     move.b  D3,($0000,A4)
02:0003F81C 4EB900032036    	 12918:     jsr     CheckLinkCollisionPreinit
                            	 12919:     even
                            	 12920: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12921:     ; If Ganon is not in state 0, then he's brown.
                            	 12922:     ; Go check collision with an arrow.
                            	 12923:     ;
02:0003F822 41EC00AC        	 12924:     lea     ($00AC,A4),A0
02:0003F826 10302000        	 12925:     move.b  (A0,D2.W),D0
02:0003F82A 6652            	 12926:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12927:     ; If timer <> 0, then Ganon is visible.
                            	 12928:     ; He can't be harmed like this. So, return.
                            	 12929:     ;
02:0003F82C 10342028        	 12930:     move.b  ($28,A4,D2.W),D0
02:0003F830 664A            	 12931:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F832 760D            	 12932:     moveq   #13,D3
02:0003F834 4EB900032500    	 12933:     jsr     CheckMonsterSwordCollision
                            	 12934:     ; If Ganon has died according to the usual collision check rules
                            	 12935:     ; (HP = 0), then:
                            	 12936:     ; 1. Restore HP to the initial value $F0
                            	 12937:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12938:     ; 3. Change palette row 7 to make Ganon brown
                            	 12939:     ;
02:0003F83A 41EC0405        	 12940:     lea     ($0405,A4),A0
02:0003F83E 10302000        	 12941:     move.b  (A0,D2.W),D0
02:0003F842 6718            	 12942:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F844 103C00F0        	 12943:     move.b  #$F0,D0
02:0003F848 41EC0485        	 12944:     lea     ($0485,A4),A0
02:0003F84C 11802000        	 12945:     move.b  D0,(A0,D2.W)
02:0003F850 41EC00AC        	 12946:     lea     ($00AC,A4),A0
02:0003F854 53302000        	 12947:     subq.b  #1,(A0,D2.W)
02:0003F858 61000084        	 12948:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12949:     even
                            	 12950: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12951:     ; If Ganon was harmed, then play the sound effect
