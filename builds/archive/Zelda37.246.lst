                            	  7498:     ;
02:0003CF9E 41F90003CEF8    	  7499:     lea     (DodongoFrameHFlips).l,A0
02:0003CFA4 10303000        	  7500:     move.b  (A0,D3.W),D0
02:0003CFA8 1940000F        	  7501:     move.b  D0,($000F,A4)
02:0003CFAC 41F90003CEEE    	  7502:     lea     (DodongoFrameImages).l,A0
02:0003CFB2 10303000        	  7503:     move.b  (A0,D3.W),D0
                            	  7504:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7505:     ; They are drawn mirrored.
                            	  7506:     ;
02:0003CFB6 0C000007        	  7507:     cmpi.b  #$07,D0
02:0003CFBA 6706            	  7508:     beq  _anon_z04_92
