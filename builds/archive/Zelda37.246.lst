02:0003C628 41EC0478        	  6190:     lea     ($0478,A4),A0
02:0003C62C 10302000        	  6191:     move.b  (A0,D2.W),D0
02:0003C630 0C000004        	  6192:     cmpi.b  #$04,D0
02:0003C634 659E            	  6193:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
