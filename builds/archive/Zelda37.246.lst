02:0002E41C 6502            	   222:     bcs.s  __far_z_01_0000
02:0002E41E 6012            	   223:     jmp  InitCaveContinue
                            	   224: __far_z_01_0000:
                            	   225:     even
                            	   226: _L_z01_InitCave_TakeType:
                            	   227:     ; Else the cave/person simply does:
                            	   228:     ; - taken:     no person, no text
                            	   229:     ; - not taken: show a person and text
                            	   230:     ;
                            	   231:     ; So, if the item was not taken, then go set up the text.
                            	   232:     ;
02:0002E420 610030BE        	   233:     jsr     GetRoomFlagUWItemState
02:0002E424 6602            	   234:     bne.s  __far_z_01_0001
02:0002E426 600A            	   235:     jmp  InitCaveContinue
                            	   236: __far_z_01_0001:
                            	   237:     ; Otherwise destroy the person object, and let Link continue.
                            	   238:     ;
02:0002E428 7000            	   239:     moveq   #0,D0
02:0002E42A 19400350        	   240:     move.b  D0,($0350,A4)
                            	   241:     even
                            	   242: UnhaltLink:
02:0002E42E 6000D5BE        	   243:     jmp     c_unhalt_link
                            	   244: 
                            	   245: InitCaveContinue:
                            	   246:     ; Get this cave's index (object type - $6A).
                            	   247:     ;
02:0002E432 102C0350        	   248:     move.b  ($0350,A4),D0
02:0002E436 003C0011        	   249:     ori     #$11,CCR  ; SEC: set C+X
02:0002E43A 123C006A        	   250:     move.b  #$6A,D1
02:0002E43E 0A3C0010        	   251:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E442 9101            	   252:     subx.b  D1,D0   ; SBC #$6A
02:0002E444 0A3C0010        	   253:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E448 7600            	   254:     moveq   #0,D3
02:0002E44A 1600            	   255:     move.b  D0,D3
                            	   256:     ; Get the person text selector by looking up the text selector byte
                            	   257:     ; for this index, and masking it with $3F.
                            	   258:     ;
02:0002E44C 41F90002E3CA    	   259:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E452 10303000        	   260:     move.b  (A0,D3.W),D0
02:0002E456 1B00            	   261:     move.b  D0,-(A5)  ; PHA
02:0002E458 0200003F        	   262:     andi.b #$3F,D0
02:0002E45C 19400415        	   263:     move.b  D0,($0415,A4)
                            	   264:     ; Pop and mask the text selector byte with $C0 to get the
                            	   265:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   266:     ;
02:0002E460 101D            	   267:     move.b  (A5)+,D0  ; PLA
02:0002E462 020000C0        	   268:     andi.b #$C0,D0
02:0002E466 19400003        	   269:     move.b  D0,($0003,A4)
                            	   270:     ; At this point, the Y register still has the cave index.
                            	   271:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   272:     ;
02:0002E46A 103C00FD        	   273:     move.b  #$FD,D0
                            	   274: _anon_z01_0:
02:0002E46E 023C00EE        	   275:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E472 123C0003        	   276:     move.b  #$03,D1
02:0002E476 D101            	   277:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E478 5303            	   278:     subq.b  #1,D3
02:0002E47A 6AF2            	   279:     bpl  _anon_z01_0
02:0002E47C 7600            	   280:     moveq   #0,D3
02:0002E47E 1600            	   281:     move.b  D0,D3
                            	   282:     ; Loop over the wares from 0 to 2.
                            	   283:     ;
02:0002E480 7400            	   284:     moveq   #0,D2
                            	   285:     even
                            	   286: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   287:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   288:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   289:     ;
02:0002E482 41F900FF6A7E    	   290:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E488 10303000        	   291:     move.b  (A0,D3.W),D0
02:0002E48C 41EC0422        	   292:     lea     ($0422,A4),A0
02:0002E490 11802000        	   293:     move.b  D0,(A0,D2.W)
                            	   294:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   295:     ;
02:0002E494 020000C0        	   296:     andi.b #$C0,D0
02:0002E498 19802000        	   297:     move.b  D0,($00,A4,D2.W)
                            	   298:     ; Copy 3 prices from the Cave level block info.
                            	   299:     ;
02:0002E49C 41F900FF6ABA    	   300:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E4A2 10303000        	   301:     move.b  (A0,D3.W),D0
02:0002E4A6 41EC0430        	   302:     lea     ($0430,A4),A0
02:0002E4AA 11802000        	   303:     move.b  D0,(A0,D2.W)
                            	   304:     ; Bottom of the wares copying loop.
                            	   305:     ;
02:0002E4AE 5203            	   306:     addq.b  #1,D3
02:0002E4B0 5202            	   307:     addq.b  #1,D2
02:0002E4B2 0C020003        	   308:     cmpi.b  #$03,D2
02:0002E4B6 66CA            	   309:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   310:     ; Get the top 2 bits of text selector byte in [03],
                            	   311:     ; shift them to the bottom, and combine them with [00].
                            	   312:     ;
02:0002E4B8 102C0003        	   313:     move.b  ($0003,A4),D0
02:0002E4BC E308            	   314:     lsl.b  #1,D0   ; ASL A
02:0002E4BE E310            	   315:     roxl.b  #1,D0   ; ROL A
02:0002E4C0 E310            	   316:     roxl.b  #1,D0   ; ROL A
02:0002E4C2 1214            	   317:     move.b  ($0000,A4),D1
02:0002E4C4 8001            	   318:     or.b  D1,D0
02:0002E4C6 1880            	   319:     move.b  D0,($0000,A4)
                            	   320:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   321:     ; and combine them with [00].
                            	   322:     ;
02:0002E4C8 102C0002        	   323:     move.b  ($0002,A4),D0
02:0002E4CC E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E4CE E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E4D0 E208            	   326:     lsr.b  #1,D0   ; LSR A
02:0002E4D2 E208            	   327:     lsr.b  #1,D0   ; LSR A
02:0002E4D4 1214            	   328:     move.b  ($0000,A4),D1
02:0002E4D6 8001            	   329:     or.b  D1,D0
02:0002E4D8 1880            	   330:     move.b  D0,($0000,A4)
                            	   331:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   332:     ; and combine them with [00] into CaveFlags.
                            	   333:     ;
02:0002E4DA 102C0001        	   334:     move.b  ($0001,A4),D0
02:0002E4DE E208            	   335:     lsr.b  #1,D0   ; LSR A
02:0002E4E0 E208            	   336:     lsr.b  #1,D0   ; LSR A
02:0002E4E2 1214            	   337:     move.b  ($0000,A4),D1
02:0002E4E4 8001            	   338:     or.b  D1,D0
02:0002E4E6 19400413        	   339:     move.b  D0,($0413,A4)
                            	   340:     ; The end result is a byte with 8 cave flags.
                            	   341:     ;
                            	   342:     ; If cave flag "money game" is missing, then go finish up,
                            	   343:     ; instead of choosing random amounts for the money game.
                            	   344:     ;
02:0002E4EA 02000020        	   345:     andi.b #$20,D0
02:0002E4EE 6700009E        	   346:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   347:     ; Determine an index randomly with increasing probability,
                            	   348:     ; from 6 to 1. Start with the following test:
                            	   349:     ;
                            	   350:     ;   If $FF < Random, then go use index 6.
                            	   351:     ;
02:0002E4F2 103C00FF        	   352:     move.b  #$FF,D0
02:0002E4F6 7606            	   353:     moveq   #6,D3
                            	   354:     even
                            	   355: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E4F8 122C0019        	   356:     move.b  ($0019,A4),D1
02:0002E4FC B001            	   357:     cmp.b   D1,D0
02:0002E4FE 6516            	   358:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   359:     ; If the test fails, then subtract $2B from the reference number.
                            	   360:     ;
02:0002E500 003C0011        	   361:     ori     #$11,CCR  ; SEC: set C+X
02:0002E504 123C002B        	   362:     move.b  #$2B,D1
02:0002E508 0A3C0010        	   363:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E50C 9101            	   364:     subx.b  D1,D0   ; SBC #$2B
02:0002E50E 0A3C0010        	   365:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E512 5303            	   366:     subq.b  #1,D3
02:0002E514 66E2            	   367:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   368:     even
                            	   369: _L_z01_InitCaveContinue_FoundPermutation:
                            	   370:     ; The index chooses the last offset of a permutation of three indexes.
                            	   371:     ;
02:0002E516 7400            	   372:     moveq   #0,D2
02:0002E518 41F90002E3F2    	   373:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E51E 14303000        	   374:     move.b  (A0,D3.W),D2
                            	   375:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   376:     ;
02:0002E522 7602            	   377:     moveq   #2,D3
                            	   378:     even
                            	   379: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E524 41F90002E3E0    	   380:     lea     (MoneyGamePermutations).l,A0
02:0002E52A 10302000        	   381:     move.b  (A0,D2.W),D0
02:0002E52E 41EC046C        	   382:     lea     ($046C,A4),A0
02:0002E532 11803000        	   383:     move.b  D0,(A0,D3.W)
02:0002E536 5302            	   384:     subq.b  #1,D2
02:0002E538 5303            	   385:     subq.b  #1,D3
02:0002E53A 6AE8            	   386:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   387:     ; With the first bit of another random number, choose 10 or 40
                            	   388:     ; to put in [046F]. This is a random amount to lose.
                            	   389:     ;
02:0002E53C 102C001A        	   390:     move.b  ($001A,A4),D0
02:0002E540 02000001        	   391:     andi.b #$01,D0
02:0002E544 7600            	   392:     moveq   #0,D3
02:0002E546 1600            	   393:     move.b  D0,D3
02:0002E548 41F90002E3DE    	   394:     lea     (MoneyGameLossAmounts).l,A0
02:0002E54E 10303000        	   395:     move.b  (A0,D3.W),D0
02:0002E552 1940046F        	   396:     move.b  D0,($046F,A4)
                            	   397:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   398:     ;
02:0002E556 700A            	   399:     moveq   #10,D0
02:0002E558 19400470        	   400:     move.b  D0,($0470,A4)
                            	   401:     ; With a different bit of the second random number,
                            	   402:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   403:     ;
02:0002E55C 7614            	   404:     moveq   #20,D3
02:0002E55E 102C001A        	   405:     move.b  ($001A,A4),D0
02:0002E562 02000002        	   406:     andi.b #$02,D0
02:0002E566 6702            	   407:     beq  _anon_z01_1
02:0002E568 7632            	   408:     moveq   #50,D3
                            	   409: _anon_z01_1:
02:0002E56A 19430471        	   410:     move.b  D3,($0471,A4)
                            	   411:     ; The 3 amounts are now in [046F] to [0471].
                            	   412:     ; Reference these amounts using the permutation of indexes
                            	   413:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   414:     ;
02:0002E56E 7402            	   415:     moveq   #2,D2
                            	   416:     even
                            	   417: _L_z01_InitCaveContinue_ArrangeAmounts:
02:0002E570 7600            	   418:     moveq   #0,D3
02:0002E572 41EC046C        	   419:     lea     ($046C,A4),A0
02:0002E576 16302000        	   420:     move.b  (A0,D2.W),D3
02:0002E57A 41EC046F        	   421:     lea     ($046F,A4),A0
02:0002E57E 10303000        	   422:     move.b  (A0,D3.W),D0
02:0002E582 41EC0448        	   423:     lea     ($0448,A4),A0
02:0002E586 11802000        	   424:     move.b  D0,(A0,D2.W)
02:0002E58A 5302            	   425:     subq.b  #1,D2
02:0002E58C 6AE2            	   426:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   427:     even
                            	   428: _L_z01_InitCaveContinue_ResetTextbox:
                            	   429:     ; Reset the current character index.
