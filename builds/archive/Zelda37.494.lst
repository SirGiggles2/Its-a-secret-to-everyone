                            	  8071: __far_z_04_0089:
                            	  8072:     ; Once the timer expires:
                            	  8073:     ; 1. unhalt Link
                            	  8074:     ; 2. clear the item to lift
                            	  8075:     ; 3. play level 9 song
                            	  8076:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8077:     ;
02:0003BB38 194000AC        	  8078:     move.b  D0,($00AC,A4)
02:0003BB3C 19400505        	  8079:     move.b  D0,($0505,A4)
02:0003BB40 7020            	  8080:     moveq   #32,D0
02:0003BB42 19400600        	  8081:     move.b  D0,($0600,A4)
