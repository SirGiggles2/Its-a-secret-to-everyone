                            	  8372: Ganon_DrawBurst:
                            	  8373:     ; If cloud distance <> 0, then decrement it once every 8 frames.
                            	  8374:     ;
02:0003BD32 41EC0478        	  8375:     lea     ($0478,A4),A0
02:0003BD36 10302000        	  8376:     move.b  (A0,D2.W),D0
02:0003BD3A 6712            	  8377:     beq  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003BD3C 102C0015        	  8378:     move.b  ($0015,A4),D0
02:0003BD40 02000007        	  8379:     andi.b #$07,D0
02:0003BD44 6608            	  8380:     bne  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003BD46 41EC0478        	  8381:     lea     ($0478,A4),A0
02:0003BD4A 53302000        	  8382:     subq.b  #1,(A0,D2.W)
