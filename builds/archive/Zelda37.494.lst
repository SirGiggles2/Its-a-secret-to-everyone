02:0003B9A0 41EC0394        	  7847:     lea     ($0394,A4),A0
02:0003B9A4 11802000        	  7848:     move.b  D0,(A0,D2.W)
                            	  7849:     ; This location is right above Patra.
                            	  7850:     ; Set X coordinate to Patra's.
