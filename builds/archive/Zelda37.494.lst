                            	  4918: UpdateDodongoState0_Move:
                            	  4919:     ; If facing left, then push X offset 0 on the stack.
                            	  4920:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  4921:     ;
                            	  4922:     ; We would like to use one set of coordinates only.
                            	  4923:     ; But movement would break down, if we did; because
                            	  4924:     ; Dodongo is so long.
                            	  4925:     ;
                            	  4926:     ; So, when not facing left, we temporarily shift the
                            	  4927:     ; X coordinate to be closer to the other side of the monster.
                            	  4928:     ;
02:0003A39C 7600            	  4929:     moveq   #0,D3
02:0003A39E 41EC0098        	  4930:     lea     ($0098,A4),A0
02:0003A3A2 10302000        	  4931:     move.b  (A0,D2.W),D0
02:0003A3A6 0200000D        	  4932:     andi.b #$0D,D0
02:0003A3AA 6716            	  4933:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003A3AC 10342070        	  4934:     move.b  ($70,A4,D2.W),D0
02:0003A3B0 023C00EE        	  4935:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3B4 123C0010        	  4936:     move.b  #$10,D1
02:0003A3B8 D101            	  4937:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A3BA 19802070        	  4938:     move.b  D0,($70,A4,D2.W)
02:0003A3BE 163C00F0        	  4939:     move.b  #$F0,D3
                            	  4940:     even
                            	  4941: _L_z04_UpdateDodongoState0_Move_Move:
02:0003A3C2 1003            	  4942:     move.b  D3,D0
02:0003A3C4 1B00            	  4943:     move.b  D0,-(A5)  ; PHA
02:0003A3C6 7020            	  4944:     moveq   #32,D0
02:0003A3C8 41EC041F        	  4945:     lea     ($041F,A4),A0
02:0003A3CC 11802000        	  4946:     move.b  D0,(A0,D2.W)
02:0003A3D0 6100DE92        	  4947:     jsr     Wanderer_TargetPlayer
                            	  4948:     ; Pop the offset and add it to the X coordinate.
                            	  4949:     ;
                            	  4950:     ; This brings the X coordinate back to the unique value
                            	  4951:     ; that represents the position.
                            	  4952:     ;
02:0003A3D4 101D            	  4953:     move.b  (A5)+,D0  ; PLA
02:0003A3D6 023C00EE        	  4954:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3DA 12342070        	  4955:     move.b  ($70,A4,D2.W),D1
02:0003A3DE D101            	  4956:     addx.b  D1,D0   ; ADC ObjX,X
02:0003A3E0 19802070        	  4957:     move.b  D0,($70,A4,D2.W)
                            	  4958:     ; If X coordinate < $20, then face right.
                            	  4959:     ;
02:0003A3E4 0C000020        	  4960:     cmpi.b  #$20,D0
02:0003A3E8 640A            	  4961:     bcc  _anon_z04_89
02:0003A3EA 7001            	  4962:     moveq   #1,D0
02:0003A3EC 41EC0098        	  4963:     lea     ($0098,A4),A0
02:0003A3F0 11802000        	  4964:     move.b  D0,(A0,D2.W)
