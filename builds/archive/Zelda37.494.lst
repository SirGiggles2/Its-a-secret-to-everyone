02:00030E76 6004            	  2047:     jmp     DrawObjectNotMirrored
                            	  2048: 
                            	  2049: ; Params:
                            	  2050: ; A: frame image
                            	  2051: ; X: object index
                            	  2052: ; [00]: object X
                            	  2053: ; [01]: object Y
                            	  2054: ;
                            	  2055: ;
                            	  2056: ; Set [0C] mirrored.
                            	  2057:     even
                            	  2058: DrawObjectMirrored:
