02:00030EDC 41F900030C2C    	  2143:     lea     (ObjAnimations).l,A0
02:00030EE2 10303000        	  2144:     move.b  (A0,D3.W),D0
02:00030EE6 023C00EE        	  2145:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EEA 122C000D        	  2146:     move.b  ($000D,A4),D1
02:00030EEE D101            	  2147:     addx.b  D1,D0   ; ADC $0D
02:00030EF0 7600            	  2148:     moveq   #0,D3
