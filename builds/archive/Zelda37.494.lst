02:000353CE 41EC062D        	  4835:     lea     ($062D,A4),A0
02:000353D2 10302000        	  4836:     move.b  (A0,D2.W),D0
02:000353D6 6608            	  4837:     bne  _anon_z02_44
02:000353D8 0C030010        	  4838:     cmpi.b  #$10,D3
