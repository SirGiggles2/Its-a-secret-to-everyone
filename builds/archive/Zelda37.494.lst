02:00048410 1003            	  4854:     move.b  D3,D0
02:00048412 1B00            	  4855:     move.b  D0,-(A5)  ; PHA
                            	  4856:     ; Save offset X [02] and Y offset [03].
                            	  4857:     ;
02:00048414 102C0002        	  4858:     move.b  ($0002,A4),D0
02:00048418 1B00            	  4859:     move.b  D0,-(A5)  ; PHA
02:0004841A 102C0003        	  4860:     move.b  ($0003,A4),D0
02:0004841E 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Calculate and set sprite attributes for this corner:
                            	  4863:     ;   base attribute OR (frame counter AND 3)
                            	  4864:     ;
                            	  4865:     ; The base attribute defines how to flip the sprite.
                            	  4866:     ; The frame counter makes the shot flash by cycling each
                            	  4867:     ; palette row.
                            	  4868:     ;
02:00048420 102C0015        	  4869:     move.b  ($0015,A4),D0
02:00048424 02000003        	  4870:     andi.b #$03,D0
02:00048428 41F900048304    	  4871:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004842E 12303000        	  4872:     move.b  (A0,D3.W),D1
02:00048432 8001            	  4873:     or.b  D1,D0
02:00048434 4EB90003116E    	  4874:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4875:     ; Add the object's X (the center of the spread) and the
                            	  4876:     ; current offset in [02] to set sprite X in [00].
                            	  4877:     ;
02:0004843A 10342070        	  4878:     move.b  ($70,A4,D2.W),D0
02:0004843E 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048442 122C0002        	  4880:     move.b  ($0002,A4),D1
02:00048446 D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:00048448 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:0004844A 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:0004844E B001            	  4887:     cmp.b   D1,D0
02:00048450 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048452 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:00048456 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:00048458 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:0004845C 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:00048460 0A3C0010        	  4893:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048464 9101            	  4894:     subx.b  D1,D0   ; SBC ObjX,X
02:00048466 0A3C0010        	  4895:     eori    #$10,CCR  ; restore X = 6502 C
02:0004846A 6014            	  4896:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4897: 
                            	  4898:     even
                            	  4899: _L_z07_SpreadShot_ReverseSub:
02:0004846C 10342070        	  4900:     move.b  ($70,A4,D2.W),D0
02:00048470 003C0011        	  4901:     ori     #$11,CCR  ; SEC: set C+X
02:00048474 1214            	  4902:     move.b  ($0000,A4),D1
02:00048476 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004847A 9101            	  4904:     subx.b  D1,D0   ; SBC $00
02:0004847C 0A3C0010        	  4905:     eori    #$10,CCR  ; restore X = 6502 C
