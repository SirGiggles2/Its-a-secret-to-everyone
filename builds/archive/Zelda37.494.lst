02:0003FDF2 19400004        	  5627:     move.b  D0,($0004,A4)
                            	  5628:     ; Write the transfer record header for the door.
                            	  5629:     ;
                            	  5630:     ;
                            	  5631:     ; VRAM address high byte of door
02:0003FDF6 1014            	  5632:     move.b  ($0000,A4),D0
02:0003FDF8 41EC0302        	  5633:     lea     ($0302,A4),A0
02:0003FDFC 11802000        	  5634:     move.b  D0,(A0,D2.W)
02:0003FE00 5202            	  5635:     addq.b  #1,D2
02:0003FE02 102C0001        	  5636:     move.b  ($0001,A4),D0
02:0003FE06 41EC0302        	  5637:     lea     ($0302,A4),A0
02:0003FE0A 11802000        	  5638:     move.b  D0,(A0,D2.W)
02:0003FE0E 5202            	  5639:     addq.b  #1,D2
02:0003FE10 102C0006        	  5640:     move.b  ($0006,A4),D0
02:0003FE14 41EC0302        	  5641:     lea     ($0302,A4),A0
02:0003FE18 11802000        	  5642:     move.b  D0,(A0,D2.W)
02:0003FE1C 5202            	  5643:     addq.b  #1,D2
                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:0003FE1E 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:0003FE22 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:0003FE24 7020            	  5652:     moveq   #32,D0
02:0003FE26 122C0001        	  5653:     move.b  ($0001,A4),D1
02:0003FE2A 8001            	  5654:     or.b  D1,D0
02:0003FE2C 19400001        	  5655:     move.b  D0,($0001,A4)
                            	  5656:     ; Bottom of the loop.
                            	  5657:     ; Loop again to write the second transfer record for the
                            	  5658:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5659:     ;
02:0003FE30 532C0005        	  5660:     subq.b  #1,($0005,A4)
02:0003FE34 66B8            	  5661:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5662:     ; Write the end marker, and update buffer length.
                            	  5663:     ;
02:0003FE36 103C00FF        	  5664:     move.b  #$FF,D0
02:0003FE3A 41EC0302        	  5665:     lea     ($0302,A4),A0
02:0003FE3E 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:0003FE42 1002            	  5667:     move.b  D2,D0
02:0003FE44 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:0003FE48 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:0003FE4C 102C0054        	  5678:     move.b  ($0054,A4),D0
02:0003FE50 02000003        	  5679:     andi.b #$03,D0
02:0003FE54 6708            	  5680:     beq  _anon_z05_122
02:0003FE56 7008            	  5681:     moveq   #8,D0
02:0003FE58 19400027        	  5682:     move.b  D0,($0027,A4)
02:0003FE5C 4E75            	  5683:     rts
