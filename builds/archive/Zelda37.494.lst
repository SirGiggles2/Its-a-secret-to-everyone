02:0003A328 532C000A        	  4862:     subq.b  #1,($000A,A4)
02:0003A32C 532C000B        	  4863:     subq.b  #1,($000B,A4)
02:0003A330 6A00FF7E        	  4864:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
