                            	  1151: _L_z04__TryShooting_TryShootingNow:
                            	  1152:     ; Summary
                            	  1153:     ;
                            	  1154:     ; if temporarily invincible then
                            	  1155:     ;   shoot timer := 0
                            	  1156:     ; elif shoot timer > 0 then
                            	  1157:     ;   decrement shoot timer
                            	  1158:     ; elif wants to shoot then
                            	  1159:     ;   shoot timer := $30
                            	  1160:     ;
                            	  1161:     ; qspeed := [01]
                            	  1162:     ;
                            	  1163:     ; if shoot timer <> 0 then
                            	  1164:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1165:     ;     shoot
                            	  1166:     ;     if succeeded then
                            	  1167:     ;       shoot timer := 0
                            	  1168:     ;       qspeed := 0
                            	  1169:     ;   else
                            	  1170:     ;     qspeed := 0
                            	  1171:     ;
                            	  1172:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:000388C6 102C0001        	  1173:     move.b  ($0001,A4),D0
02:000388CA 1883            	  1174:     move.b  D3,($0000,A4)
02:000388CC 1B00            	  1175:     move.b  D0,-(A5)  ; PHA
02:000388CE 7600            	  1176:     moveq   #0,D3
                            	  1177:     ; If not temporarily invincible,
                            	  1178:     ;
02:000388D0 41EC04F0        	  1179:     lea     ($04F0,A4),A0
02:000388D4 10302000        	  1180:     move.b  (A0,D2.W),D0
02:000388D8 661A            	  1181:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1182:     ; then Y := shoot timer - 1
                            	  1183:     ;
02:000388DA 7600            	  1184:     moveq   #0,D3
02:000388DC 41EC0451        	  1185:     lea     ($0451,A4),A0
02:000388E0 16302000        	  1186:     move.b  (A0,D2.W),D3
02:000388E4 5303            	  1187:     subq.b  #1,D3
                            	  1188:     ; If Y register < 0, then shoot timer is 0.
                            	  1189:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1190:     ; Else go set a non-zero speed and return.
                            	  1191:     ;
02:000388E6 6A0C            	  1192:     bpl  _L_z04__TryShooting_SetShootTimer
02:000388E8 41EC0412        	  1193:     lea     ($0412,A4),A0
02:000388EC 10302000        	  1194:     move.b  (A0,D2.W),D0
02:000388F0 6736            	  1195:     beq  _L_z04__TryShooting_SetSpeed
02:000388F2 7630            	  1196:     moveq   #48,D3
                            	  1197:     even
                            	  1198: _L_z04__TryShooting_SetShootTimer:
                            	  1199:     ; shoot timer := Y
                            	  1200:     ;
02:000388F4 1003            	  1201:     move.b  D3,D0
02:000388F6 41EC0451        	  1202:     lea     ($0451,A4),A0
02:000388FA 11802000        	  1203:     move.b  D0,(A0,D2.W)
                            	  1204:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  1205:     ;
02:000388FE 6728            	  1206:     beq  _L_z04__TryShooting_SetSpeed
                            	  1207:     ; shoot timer <> 0
                            	  1208:     ; If shoot timer <> $10, then go set a zero speed.
                            	  1209:     ;
02:00038900 0C030010        	  1210:     cmpi.b  #$10,D3
02:00038904 661C            	  1211:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1212:     ; If we have the magic clock, or the monster is stunned, then
                            	  1213:     ; go set a zero speed.
                            	  1214:     ;
02:00038906 102C066C        	  1215:     move.b  ($066C,A4),D0
02:0003890A 1234203D        	  1216:     move.b  ($3D,A4,D2.W),D1
02:0003890E 8001            	  1217:     or.b  D1,D0
02:00038910 6610            	  1218:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1219:     ; Shoot.
                            	  1220:     ;
02:00038912 1014            	  1221:     move.b  ($0000,A4),D0
02:00038914 611E            	  1222:     jsr     _ShootIfWanted2
                            	  1223:     ; If it failed, go set a non-zero speed.
                            	  1224:     ;
02:00038916 6510            	  1225:     bcs  _L_z04__TryShooting_SetSpeed
                            	  1226:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  1227:     ;
02:00038918 7000            	  1228:     moveq   #0,D0
02:0003891A 41EC0412        	  1229:     lea     ($0412,A4),A0
02:0003891E 11802000        	  1230:     move.b  D0,(A0,D2.W)
                            	  1231:     even
