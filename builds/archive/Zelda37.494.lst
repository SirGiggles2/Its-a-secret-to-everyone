                            	  5033: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5034:     ; Advance the substate.
                            	  5035:     ;
02:0003A480 41EC042C        	  5036:     lea     ($042C,A4),A0
02:0003A484 52302000        	  5037:     addq.b  #1,(A0,D2.W)
                            	  5038:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5039:     ;
02:0003A488 41EC042C        	  5040:     lea     ($042C,A4),A0
02:0003A48C 10302000        	  5041:     move.b  (A0,D2.W),D0
02:0003A490 0C000002        	  5042:     cmpi.b  #$02,D0
02:0003A494 6402            	  5043:     bcc.s  __far_z_04_0045
02:0003A496 601C            	  5044:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5045: __far_z_04_0045:
                            	  5046:     ; New bloated substate >= 2.
                            	  5047:     ;
                            	  5048:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5049:     ; which will transition to state 0 (moving).
                            	  5050:     ;
                            	  5051:     ; Note that if the bomb hits >= 2, then:
                            	  5052:     ; - If new substate = 2, then substate 2 will wait,
                            	  5053:     ;   and then transition to substate 3.
                            	  5054:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5055:     ;
02:0003A498 7600            	  5056:     moveq   #0,D3
02:0003A49A 41EC0437        	  5057:     lea     ($0437,A4),A0
02:0003A49E 16302000        	  5058:     move.b  (A0,D2.W),D3
02:0003A4A2 0C030002        	  5059:     cmpi.b  #$02,D3
02:0003A4A6 6502            	  5060:     bcs.s  __far_z_04_0046
02:0003A4A8 600A            	  5061:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5062: __far_z_04_0046:
02:0003A4AA 7004            	  5063:     moveq   #4,D0
02:0003A4AC 41EC042C        	  5064:     lea     ($042C,A4),A0
02:0003A4B0 11802000        	  5065:     move.b  D0,(A0,D2.W)
                            	  5066:     even
