                            	   884: ;==============================================================================
                            	   885: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   886: ;==============================================================================
                            	   887: tick_sq1:
02:00000910 533900FFE00D    	   888:     subq.b  #1,(m_sq1_cnt).l
02:00000916 6600010E        	   889:     bne     tick_sq0                     ; no new note
                            	   890: .read:
02:0000091A 207900FFE008    	   891:     move.l  (m_script_ptr).l,A0
02:00000920 7200            	   892:     moveq   #0,D1
02:00000922 123900FFE00C    	   893:     move.b  (m_sq1_off).l,D1
02:00000928 523900FFE00C    	   894:     addq.b  #1,(m_sq1_off).l
02:0000092E 10301000        	   895:     move.b  (A0,D1.w),D0
02:00000932 673A            	   896:     beq.s   .song_ended
02:00000934 4A00            	   897:     tst.b   D0
02:00000936 6B02            	   898:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:00000938 6022            	   899:     bra.s   .play_note
                            	   900: .prep_then_note:
02:0000093A 6100027C        	   901:     bsr     get_song_note_length         ; D0 in → D0 length
02:0000093E 13C000FFE00E    	   902:     move.b  D0,(m_sq1_len).l
02:00000944 207900FFE008    	   903:     move.l  (m_script_ptr).l,A0
02:0000094A 7200            	   904:     moveq   #0,D1
02:0000094C 123900FFE00C    	   905:     move.b  (m_sq1_off).l,D1
02:00000952 523900FFE00C    	   906:     addq.b  #1,(m_sq1_off).l
02:00000958 10301000        	   907:     move.b  (A0,D1.w),D0
                            	   908: .play_note:
02:0000095C 61000274        	   909:     bsr     emit_note_sq1                 ; D0 = note id
02:00000960 13F900FFE00E00FF	   910:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:00000968 E00D
02:0000096A 600000BA        	   911:     bra     tick_sq0
                            	   912: .song_ended:
02:0000096E 103900FFE000    	   913:     move.b  (m_song).l,D0
02:00000974 020000F1        	   914:     andi.b  #$F1,D0
02:00000978 6604            	   915:     bne.s   .play_again
02:0000097A 60000430        	   916:     bra     music_silence
                            	   917: .play_again:
02:0000097E 6102            	   918:     bsr     play_next_phrase_no_tick
02:00000980 6098            	   919:     bra.s   .read
                            	   920: 
                            	   921: ;----------------------------------------------------------------------
                            	   922: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   923: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   924: ; to restart a looping song when $00 opcode is read.
                            	   925: ;----------------------------------------------------------------------
                            	   926: play_next_phrase_no_tick:
02:00000982 103900FFE000    	   927:     move.b  (m_song).l,D0
02:00000988 6B7E            	   928:     bmi     .nsp_demo
02:0000098A B03C0001        	   929:     cmp.b   #$01,D0
02:0000098E 675A            	   930:     beq     .nsp_ow
02:00000990 B03C0040        	   931:     cmp.b   #$40,D0
02:00000994 6738            	   932:     beq     .nsp_uw
02:00000996 B03C0010        	   933:     cmp.b   #$10,D0
02:0000099A 6716            	   934:     beq     .nsp_ending
                            	   935:     ; single-phrase: rebuild phrase from bit
02:0000099C 7200            	   936:     moveq   #0,D1
02:0000099E 7400            	   937:     moveq   #0,D2
02:000009A0 1400            	   938:     move.b  D0,D2
                            	   939: .nsp_loop:
02:000009A2 5201            	   940:     addq.b  #1,D1
02:000009A4 E20A            	   941:     lsr.b   #1,D2
02:000009A6 64FA            	   942:     bcc     .nsp_loop
02:000009A8 13C100FFE002    	   943:     move.b  D1,(m_phrase).l
02:000009AE 6000FEAC        	   944:     bra     prep_phrase
                            	   945: .nsp_ending:
02:000009B2 523900FFE002    	   946:     addq.b  #1,(m_phrase).l
02:000009B8 0C39001A00FFE002	   947:     cmpi.b  #$1A,(m_phrase).l
02:000009C0 6600FE9A        	   948:     bne     prep_phrase
02:000009C4 13FC001400FFE002	   949:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:000009CC 60B4            	   950:     bra     play_next_phrase_no_tick
                            	   951: .nsp_uw:
02:000009CE 523900FFE002    	   952:     addq.b  #1,(m_phrase).l
02:000009D4 0C39001200FFE002	   953:     cmpi.b  #$12,(m_phrase).l
02:000009DC 6600FE7E        	   954:     bne     prep_phrase
02:000009E0 13FC000F00FFE002	   955:     move.b  #$0F,(m_phrase).l
02:000009E8 6098            	   956:     bra     play_next_phrase_no_tick
                            	   957: .nsp_ow:
02:000009EA 523900FFE002    	   958:     addq.b  #1,(m_phrase).l
02:000009F0 0C39001000FFE002	   959:     cmpi.b  #$10,(m_phrase).l
02:000009F8 6600FE62        	   960:     bne     prep_phrase
02:000009FC 13FC000900FFE002	   961:     move.b  #$09,(m_phrase).l
02:00000A04 6000FF7C        	   962:     bra     play_next_phrase_no_tick
                            	   963: .nsp_demo:
02:00000A08 523900FFE002    	   964:     addq.b  #1,(m_phrase).l
02:00000A0E 0C39002400FFE002	   965:     cmpi.b  #$24,(m_phrase).l
02:00000A16 6600FE44        	   966:     bne     prep_phrase
02:00000A1A 13FC001900FFE002	   967:     move.b  #$19,(m_phrase).l
02:00000A22 6000FF5E        	   968:     bra     play_next_phrase_no_tick
