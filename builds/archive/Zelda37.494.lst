                            	  5907: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5908:     ; Store the weapon's frame (horizontal or vertical)
                            	  5909:     ; for the direction chosen above in [0C].
                            	  5910:     ;
02:00048B8A 4EB900030AAC    	  5911:     jsr     GetOppositeDir
02:00048B90 41F9000485C4    	  5912:     lea     (RDirectionToWeaponFrame).l,A0
02:00048B96 10303000        	  5913:     move.b  (A0,D3.W),D0
02:00048B9A 1940000C        	  5914:     move.b  D0,($000C,A4)
                            	  5915:     ; Calculate sprite attributes.
                            	  5916:     ;
                            	  5917:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5918:     ;   base attribute OR 1
                            	  5919:     ; So, it uses palette row 5.
                            	  5920:     ;
02:00048B9E 41F9000485C8    	  5921:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00048BA4 10303000        	  5922:     move.b  (A0,D3.W),D0
02:00048BA8 0C02000D        	  5923:     cmpi.b  #$0D,D2
02:00048BAC 6706            	  5924:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00048BAE 00000001        	  5925:     ori.b #$01,D0
02:00048BB2 601C            	  5926:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5927: 
                            	  5928:     even
                            	  5929: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5930:     ; The weapon is the sword.
                            	  5931:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5932:     ;
02:00048BB4 023C00EE        	  5933:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048BB8 122C0657        	  5934:     move.b  ($0657,A4),D1
02:00048BBC D101            	  5935:     addx.b  D1,D0   ; ADC Items
02:00048BBE 003C0011        	  5936:     ori     #$11,CCR  ; SEC: set C+X
02:00048BC2 123C0001        	  5937:     move.b  #$01,D1
02:00048BC6 0A3C0010        	  5938:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048BCA 9101            	  5939:     subx.b  D1,D0   ; SBC #$01
02:00048BCC 0A3C0010        	  5940:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5941:     even
                            	  5942: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5943:     ; Set sprite attributes to the calculated value above.
                            	  5944:     ;
02:00048BD0 4EB90003116E    	  5945:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5946:     ; If the direction is left, set [0F] to flip horizontally.
                            	  5947:     ;
02:00048BD6 0C030002        	  5948:     cmpi.b  #$02,D3
02:00048BDA 6604            	  5949:     bne  _anon_z07_33
02:00048BDC 522C000F        	  5950:     addq.b  #1,($000F,A4)
                            	  5951: _anon_z07_33:
                            	  5952:     ; If state = 1, return. Don't show the weapon.
                            	  5953:     ;
02:00048BE0 41EC00AC        	  5954:     lea     ($00AC,A4),A0
02:00048BE4 10302000        	  5955:     move.b  (A0,D2.W),D0
02:00048BE8 0200000F        	  5956:     andi.b #$0F,D0
02:00048BEC 0C000001        	  5957:     cmpi.b  #$01,D0
02:00048BF0 6604            	  5958:     bne.s  __far_z_07_0085
02:00048BF2 600000AA        	  5959:     jmp  L1F854_Exit
                            	  5960: __far_z_07_0085:
                            	  5961:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  5962:     ; sword or rod
                            	  5963:     ;
                            	  5964:     ;
                            	  5965:     ; Sword slot
