02:0003BAC0 0003BB2A        	  7986:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003BAC4 0003BB58        	  7987:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  7988: 
                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0003BAC8 701B            	  7996:     moveq   #27,D0
02:0003BACA 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0003BACE 102C0028        	  8000:     move.b  ($0028,A4),D0
