02:0003B9CA 003C0011        	  7870:     ori     #$11,CCR  ; SEC: set C+X
02:0003B9CE 1214            	  7871:     move.b  ($0000,A4),D1
02:0003B9D0 0A3C0010        	  7872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B9D4 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003B9D6 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B9DA 41EC0084        	  7875:     lea     ($0084,A4),A0
