                            	  3581: .ttf_done:
                            	  3582:     ; Reset VDP to VRAM write mode so stale CRAM targeting doesn't
                            	  3583:     ; corrupt palette on subsequent VDP_DATA writes.
                            	  3584:     ; Target $FFFC (unused VRAM) to avoid corrupting tile 0 on stray writes.
02:0002B6B8 23FC7FFC000300C0	  3585:     move.l  #$7FFC0003,(VDP_CTRL).l
02:0002B6C0 0004
02:0002B6C2 4CDF0FFF        	  3586:     movem.l (SP)+,D0-D7/A0-A3
02:0002B6C6 4E75            	  3587:     rts
