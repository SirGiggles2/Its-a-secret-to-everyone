02:0002B2A6 6718            	  3038:     beq.s   .ttf_chr_uploaded
02:0002B2A8 303900FF0832    	  3039:     move.w  (CHR_BUF_VADDR).l,D0
02:0002B2AE 0C401F20        	  3040:     cmpi.w  #$1F20,D0
02:0002B2B2 650C            	  3041:     blo.s   .ttf_chr_uploaded
02:0002B2B4 0C401F40        	  3042:     cmpi.w  #$1F40,D0
02:0002B2B8 6406            	  3043:     bhs.s   .ttf_chr_uploaded
02:0002B2BA 4EB90000E812    	  3044:     bsr     _chr_upload_sprite_4x
