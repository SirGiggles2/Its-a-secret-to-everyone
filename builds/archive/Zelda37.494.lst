02:000383EC 1002            	   465:     move.b  D2,D0
02:000383EE 41EC042C        	   466:     lea     ($042C,A4),A0
02:000383F2 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:000383F6 1003            	   470:     move.b  D3,D0
02:000383F8 41EC042C        	   471:     lea     ($042C,A4),A0
02:000383FC 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
