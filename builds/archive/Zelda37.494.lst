02:0003B9A8 102C0071        	  7852:     move.b  ($0071,A4),D0
02:0003B9AC 19802070        	  7853:     move.b  D0,($70,A4,D2.W)
                            	  7854:     ; If patra child type = $25, then the radius of its orbit is $2C.
