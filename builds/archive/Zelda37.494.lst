02:00034E34 7400            	  4328:     moveq   #0,D2
02:00034E36 1400            	  4329:     move.b  D0,D2
                            	  4330:     ; Change element 0 of palette 4 in buffer to change
                            	  4331:     ; the background color.
                            	  4332:     ;
02:00034E38 41F900034DF0    	  4333:     lea     (EndingFlashColors).l,A0
02:00034E3E 10302000        	  4334:     move.b  (A0,D2.W),D0
02:00034E42 19400315        	  4335:     move.b  D0,($0315,A4)
