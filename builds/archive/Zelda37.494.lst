02:0003539A E308            	  4807:     lsl.b  #1,D0   ; ASL A
02:0003539C E308            	  4808:     lsl.b  #1,D0   ; ASL A
02:0003539E E308            	  4809:     lsl.b  #1,D0   ; ASL A
02:000353A0 E308            	  4810:     lsl.b  #1,D0   ; ASL A
02:000353A2 19400303        	  4811:     move.b  D0,($0303,A4)
                            	  4812:     ; Get the mask for the current VRAM page.
                            	  4813:     ;
