02:00040A52 6704            	  7007:     beq  _L_z05_ChangePlayMapSquareOW_Write
02:00040A54 5302            	  7008:     subq.b  #1,D2
02:00040A56 66EE            	  7009:     bne  _anon_z05_149
                            	  7010:     even
