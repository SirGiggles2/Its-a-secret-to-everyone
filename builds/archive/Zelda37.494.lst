02:0004848A 10302000        	  4916:     move.b  (A0,D2.W),D0
02:0004848E 023C00EE        	  4917:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048492 122C0003        	  4918:     move.b  ($0003,A4),D1
02:00048496 D101            	  4919:     addx.b  D1,D0   ; ADC $03
02:00048498 19400001        	  4920:     move.b  D0,($0001,A4)
