02:00038508 41EC0098        	   624:     lea     ($0098,A4),A0
02:0003850C 11802000        	   625:     move.b  D0,(A0,D2.W)
02:00038510 41EC00AC        	   626:     lea     ($00AC,A4),A0
02:00038514 52302000        	   627:     addq.b  #1,(A0,D2.W)
02:00038518 522C00F7        	   628:     addq.b  #1,($00F7,A4)
02:0003851C 7074            	   629:     moveq   #116,D0
02:0003851E 4EB900047268    	   630:     jsr     ChangeTileObjTiles
