02:00048CF4 41EC00AC        	  6123:     lea     ($00AC,A4),A0
02:00048CF8 10302000        	  6124:     move.b  (A0,D2.W),D0
02:00048CFC 0C000021        	  6125:     cmpi.b  #$21,D0
02:00048D00 6656            	  6126:     bne  _L_z07_UpdateFire_StandingFie
                            	  6127:     ; Move as if grid offset were 0.
