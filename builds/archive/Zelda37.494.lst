                            	   443:     ;
02:000383C2 102C066C        	   444:     move.b  ($066C,A4),D0
02:000383C6 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:000383CA 8001            	   446:     or.b  D1,D0
02:000383CC 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
