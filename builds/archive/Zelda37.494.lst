02:00048D02 41EC0394        	  6129:     lea     ($0394,A4),A0
02:00048D06 10302000        	  6130:     move.b  (A0,D2.W),D0
02:00048D0A 1B00            	  6131:     move.b  D0,-(A5)  ; PHA
02:00048D0C 7000            	  6132:     moveq   #0,D0
