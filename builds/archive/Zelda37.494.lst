                            	  7555: __far_z_07_0118:
                            	  7556:     ; So, every 8 frames:
                            	  7557:     ; 1. Increment the secret color cycle count.
                            	  7558:     ; 2. Change the water palette.
                            	  7559:     ;
                            	  7560:     ; But when the count = $B, go reveal the stairs.
                            	  7561:     ;
