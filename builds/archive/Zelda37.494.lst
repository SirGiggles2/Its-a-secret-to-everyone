02:0003E2A4 5203            	  3231:     addq.b  #1,D3
02:0003E2A6 0C0000B0        	  3232:     cmpi.b  #$B0,D0
02:0003E2AA 6702            	  3233:     beq.s  __far_z_05_0062
02:0003E2AC 604C            	  3234:     jmp  L14F72_Exit
                            	  3235: __far_z_05_0062:
                            	  3236: _anon_z05_83:
                            	  3237:     ; Look for the current room in the cellar/shortcut room array.
                            	  3238:     ;
02:0003E2AE 1883            	  3239:     move.b  D3,($0000,A4)
02:0003E2B0 163C00FF        	  3240:     move.b  #$FF,D3
02:0003E2B4 102C00EB        	  3241:     move.b  ($00EB,A4),D0
                            	  3242: _anon_z05_84:
02:0003E2B8 5203            	  3243:     addq.b  #1,D3
02:0003E2BA 41F900FF6BB2    	  3244:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E2C0 12303000        	  3245:     move.b  (A0,D3.W),D1
02:0003E2C4 B001            	  3246:     cmp.b   D1,D0
02:0003E2C6 66F0            	  3247:     bne  _anon_z05_84
                            	  3248:     ; Add the value of the shortcut chosen to whatever index
                            	  3249:     ; the current room has in the array.
                            	  3250:     ;
                            	  3251:     ; This yields the index of one of the three shortcut rooms
                            	  3252:     ; after the current one.
                            	  3253:     ;
02:0003E2C8 1003            	  3254:     move.b  D3,D0
02:0003E2CA 023C00EE        	  3255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E2CE 1214            	  3256:     move.b  ($0000,A4),D1
02:0003E2D0 D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:0003E2D2 02000003        	  3260:     andi.b #$03,D0
02:0003E2D6 7600            	  3261:     moveq   #0,D3
02:0003E2D8 1600            	  3262:     move.b  D0,D3
02:0003E2DA 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E2E0 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
                            	  3266: ; A: destination room ID
                            	  3267: ;
                            	  3268:     even
                            	  3269: GoToModeAFromCellar:
02:0003E2E4 194000EB        	  3270:     move.b  D0,($00EB,A4)
02:0003E2E8 4EB900046FBE    	  3271:     jsr     MarkRoomVisited
                            	  3272:     even
