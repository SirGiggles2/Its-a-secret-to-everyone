02:0003E2EE 700A            	  3274:     moveq   #10,D0
02:0003E2F0 19400012        	  3275:     move.b  D0,($0012,A4)
                            	  3276:     even
                            	  3277: EndPrepareMode:
02:0003E2F4 4EF90002C508    	  3278:     jmp     c_end_prepare_mode
                            	  3279: 
