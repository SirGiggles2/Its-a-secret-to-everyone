02:000383D0 61003EBA        	   451:     jsr     _ShootIfWanted
02:000383D4 646A            	   452:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:000383D6 103C0080        	   455:     move.b  #$80,D0
02:000383DA 41EC00AC        	   456:     lea     ($00AC,A4),A0
02:000383DE 11802000        	   457:     move.b  D0,(A0,D2.W)
