                            	   739: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F586 1214            	   740:     move.b  ($00,A4),D1   ; ptr lo
02:0002F588 182C0001        	   741:     move.b  ($01,A4),D4  ; ptr hi
02:0002F58C 024100FF        	   742:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F590 E14C            	   743:     lsl.w   #8,D4
02:0002F592 8841            	   744:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F594 48C4            	   745:     ext.l   D4
02:0002F596 D8BC00FF0000    	   746:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002F59C 2044            	   747:     movea.l D4,A0
02:0002F59E 10303000        	   748:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002F5A2 122C0002        	   749:     move.b  ($02,A4),D1   ; ptr lo
02:0002F5A6 182C0003        	   750:     move.b  ($03,A4),D4  ; ptr hi
02:0002F5AA 024100FF        	   751:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F5AE E14C            	   752:     lsl.w   #8,D4
02:0002F5B0 8841            	   753:     or.w    D1,D4
02:0002F5B2 48C4            	   754:     ext.l   D4
02:0002F5B4 D8BC00FF0000    	   755:     add.l   #NES_RAM,D4
02:0002F5BA 2044            	   756:     movea.l D4,A0
02:0002F5BC 11803000        	   757:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
