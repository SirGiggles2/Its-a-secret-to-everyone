                            	   107: _L_z02_TransferCommonPatterns_LoopBlock:
02:0003137E 102C051D        	   108:     move.b  ($051D,A4),D0
02:00031382 E308            	   109:     lsl.b  #1,D0   ; ASL A
02:00031384 7400            	   110:     moveq   #0,D2
02:00031386 1400            	   111:     move.b  D0,D2
                            	   112:     ; Put block address in [00:01] and size in [03:02].
                            	   113:     ; Load destination VRAM address and set it.
                            	   114:     ; The size and VRAM address have the high byte first.
                            	   115:     ;
02:00031388 41F90003135A    	   116:     lea     (CommonPatternBlockAddrs).l,A0
02:0003138E 3A02            	   117:     move.w  D2,D5
02:00031390 DA45            	   118:     add.w   D5,D5              ; D5 = 4*block_idx (dc.l = 4 bytes)
02:00031392 2A305000        	   119:     move.l  (A0,D5.W),D5      ; D5 = 32-bit Genesis ROM source addr
02:00031396 29450004        	   120:     move.l  D5,($04,A4)       ; store to [$04:$07] (avoids size overlap)
02:0003139A 41F900031366    	   121:     lea     (CommonPatternBlockSizes).l,A0
02:000313A0 10302000        	   122:     move.b  (A0,D2.W),D0
02:000313A4 19400002        	   123:     move.b  D0,($0002,A4)
