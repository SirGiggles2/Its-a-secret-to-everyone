02:0003299A 102C042E        	   809:     move.b  ($042E,A4),D0
02:0003299E 024000FF        	   810:     andi.w  #$00FF,D0
02:000329A2 E348            	   811:     lsl.w   #1,D0                ; * 2 for word-sized offset table
02:000329A4 41F9000327B8    	   812:     lea     (DemoLineTextAddrs).l,A0
02:000329AA 30300000        	   813:     move.w  (A0,D0.W),D0        ; D0.w = offset into DemoTextFields
02:000329AE 41F9000325A4    	   814:     lea     (DemoTextFields).l,A0
02:000329B4 D0C0            	   815:     adda.w  D0,A0               ; A0 -> text field entry in ROM
02:000329B6 7600            	   816:     moveq   #0,D3               ; Y index into text field
02:000329B8 10303000        	   817:     move.b  (A0,D3.W),D0        ; first byte = column offset
