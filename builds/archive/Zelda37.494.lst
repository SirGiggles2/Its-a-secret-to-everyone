                            	  2865: __far_z_05_0045:
                            	  2866:     ; Switch to the sword slot.
                            	  2867:     ;
02:0003E034 740D            	  2868:     moveq   #13,D2
                            	  2869:     ; If state <> 0, then sword or item is in use. So, return.
                            	  2870:     ;
02:0003E036 41EC00AC        	  2871:     lea     ($00AC,A4),A0
02:0003E03A 10302000        	  2872:     move.b  (A0,D2.W),D0
02:0003E03E 6702            	  2873:     beq.s  __far_z_05_0046
02:0003E040 60E8            	  2874:     jmp  L14DFF_Exit
                            	  2875: __far_z_05_0046:
                            	  2876:     ; The first state lasts 5 frames.
