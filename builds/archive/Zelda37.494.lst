                            	  4172: CheckBigDigdoggerCollisions:
                            	  4173:     ; Save the original coordinates.
                            	  4174:     ;
02:00039DB6 10342070        	  4175:     move.b  ($70,A4,D2.W),D0
02:00039DBA 1B00            	  4176:     move.b  D0,-(A5)  ; PHA
02:00039DBC 41EC0084        	  4177:     lea     ($0084,A4),A0
02:00039DC0 10302000        	  4178:     move.b  (A0,D2.W),D0
02:00039DC4 1B00            	  4179:     move.b  D0,-(A5)  ; PHA
                            	  4180:     ; Reset the index of the current part.
                            	  4181:     ;
02:00039DC6 7000            	  4182:     moveq   #0,D0
