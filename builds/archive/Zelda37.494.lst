02:0002B2F4 0246001F        	  3095:     andi.w  #$001F,D6               ; col = index & 31
02:0002B2F8 E34E            	  3096:     lsl.w   #1,D6                   ; col * 2
02:0002B2FA EA48            	  3097:     lsr.w   #5,D0                   ; row = index >> 5
02:0002B2FC 0C400008        	  3098:     cmpi.w  #8,D0
02:0002B300 6524            	  3099:     blo.s   .ttf_nt_window          ; Window plane path
                            	  3100: 
02:0002B302 C0FC0080        	  3101:     mulu.w  #$0080,D0              ; row * $80
02:0002B306 D046            	  3102:     add.w   D6,D0                   ; row*$80 + col*2
