02:000417DA 182C0001        	  8551:     move.b  ($01,A4),D4  ; ptr hi
02:000417DE 024100FF        	  8552:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000417E2 E14C            	  8553:     lsl.w   #8,D4
