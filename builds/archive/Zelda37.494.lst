02:00039ABE 7001            	  3691:     moveq   #1,D0
02:00039AC0 19400431        	  3692:     move.b  D0,($0431,A4)
02:00039AC4 19400436        	  3693:     move.b  D0,($0436,A4)
02:00039AC8 103C0080        	  3694:     move.b  #$80,D0
02:00039ACC 194004D1        	  3695:     move.b  D0,($04D1,A4)
02:00039AD0 7008            	  3696:     moveq   #8,D0
02:00039AD2 1940034E        	  3697:     move.b  D0,($034E,A4)
02:00039AD6 4E75            	  3698:     rts
