02:00035388 10302000        	  4797:     move.b  (A0,D2.W),D0
02:0003538C 19400302        	  4798:     move.b  D0,($0302,A4)
                            	  4799:     ; The line number will be used to shift the task mask below.
                            	  4800:     ;
02:00035390 102C050D        	  4801:     move.b  ($050D,A4),D0
02:00035394 7600            	  4802:     moveq   #0,D3
