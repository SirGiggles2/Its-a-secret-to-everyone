02:0003926A 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003926E 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:00039270 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:00039274 41EC0084        	  2593:     lea     ($0084,A4),A0
