                            	  4376: SetTargetSpeed:
02:00039F82 41EC0437        	  4377:     lea     ($0437,A4),A0
02:00039F86 11802000        	  4378:     move.b  D0,(A0,D2.W)
02:00039F8A 7000            	  4379:     moveq   #0,D0
02:00039F8C 41EC0444        	  4380:     lea     ($0444,A4),A0
02:00039F90 11802000        	  4381:     move.b  D0,(A0,D2.W)
                            	  4382:     ; But if this is a child, then make the target speed $0180.
                            	  4383:     ;
02:00039F94 41EC046B        	  4384:     lea     ($046B,A4),A0
