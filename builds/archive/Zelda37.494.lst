                            	  4792: _anon_z04_88:
02:0003A2A6 1943000A        	  4793:     move.b  D3,($000A,A4)
                            	  4794:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  4795:     ;
02:0003A2AA 7005            	  4796:     moveq   #5,D0
02:0003A2AC 1940000B        	  4797:     move.b  D0,($000B,A4)
