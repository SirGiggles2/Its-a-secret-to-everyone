02:0004096E 0A3C0010        	  6890:     eori    #$10,CCR  ; restore X = 6502 C
02:00040972 E208            	  6891:     lsr.b  #1,D0   ; LSR A
02:00040974 E208            	  6892:     lsr.b  #1,D0   ; LSR A
02:00040976 E208            	  6893:     lsr.b  #1,D0   ; LSR A
