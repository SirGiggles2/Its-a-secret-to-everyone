02:0003A33E 41F900030E44    	  4879:     lea     (SpriteOffsets).l,A0
02:0003A344 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003A348 7600            	  4881:     moveq   #0,D3
02:0003A34A 1600            	  4882:     move.b  D0,D3
02:0003A34C 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003A34E 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003A352 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003A356 1014            	  4886:     move.b  ($0000,A4),D0
02:0003A358 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003A35C 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003A360 102C0001        	  4889:     move.b  ($0001,A4),D0
