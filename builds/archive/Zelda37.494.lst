                            	   821: _L_z02_AnimateDemoPhase1Subphase2_CopyLine:
                            	   822:     ; X (D2) = offset into destination line.
                            	   823:     ; Y (D3) = offset into source tiles of current text record.
                            	   824:     ; A0 = pointer to current text field (preserved across loop).
02:000329C0 5203            	   825:     addq.b  #1,D3
02:000329C2 10303000        	   826:     move.b  (A0,D3.W),D0        ; read next tile from ROM
