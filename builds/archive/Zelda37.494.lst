02:0002B60A 0C453F20        	  3471:     cmpi.w  #$3F20,D5
02:0002B60E 6478            	  3472:     bhs.s   .ttf_pal_skip
                            	  3473: 
                            	  3474:     ; Compute palette offset
02:0002B610 3005            	  3475:     move.w  D5,D0
02:0002B612 04403F00        	  3476:     subi.w  #$3F00,D0
02:0002B616 0240001F        	  3477:     andi.w  #$001F,D0               ; offset 0..31
                            	  3478: 
                            	  3479:     ; NES palette mirroring & sprite palette remap
                            	  3480:     ; Entry-0 offsets (16,20,24,28) mirror universal BG color → remap to BG
                            	  3481:     ; Non-entry-0 sprite colors → remap to Genesis CRAM palettes 2-3
02:0002B61A 0C400010        	  3482:     cmpi.w  #$10,D0
02:0002B61E 6534            	  3483:     blo.s   .ttf_pal_bg
02:0002B620 3C00            	  3484:     move.w  D0,D6
02:0002B622 02460003        	  3485:     andi.w  #$0003,D6
02:0002B626 6606            	  3486:     bne.s   .ttf_pal_spr            ; non-zero slot → sprite palette
02:0002B628 04400010        	  3487:     subi.w  #$10,D0                 ; entry-0: remap 16→0, 20→4, 24→8, 28→12
02:0002B62C 6026            	  3488:     bra.s   .ttf_pal_bg
                            	  3489: .ttf_pal_spr:
                            	  3490:     ifne CHR_EXPANSION_ENABLED
                            	  3491:     ; T-CHR S8 v2: pack sprite sub-palettes into unused tail slots of BG
                            	  3492:     ; palettes (PAL0[4..15] + PAL1[4..7]).  See .t19_spr_cram_base for the
                            	  3493:     ; mapping table.  Using an inline table to avoid cross-scope lea.
02:0002B62E 3C00            	  3494:     move.w  D0,D6
02:0002B630 04460010        	  3495:     subi.w  #$10,D6
02:0002B634 E44E            	  3496:     lsr.w   #2,D6                   ; D6 = sub-pal (0..3)
02:0002B636 DC46            	  3497:     add.w   D6,D6                   ; * 2 for word index
02:0002B638 45FA0010        	  3498:     lea     (.ttf_spr_cram_base,PC),A2
02:0002B63C 3C326000        	  3499:     move.w  (A2,D6.W),D6            ; D6 = CRAM base for this sub-pal
02:0002B640 02400003        	  3500:     andi.w  #$0003,D0               ; color slot (1..3)
02:0002B644 D040            	  3501:     add.w   D0,D0                   ; * 2
02:0002B646 DC40            	  3502:     add.w   D0,D6                   ; D6 = CRAM address
                            	  3503:     ; D2 preserved (holds palette data byte for later .ttf_pal_have_cram lookup)
02:0002B648 6008            	  3504:     bra.s   .ttf_pal_have_cram_new
                            	  3505: .ttf_spr_cram_base:
02:0002B64A 0008            	  3506:     dc.w    $08                     ; sub-pal 0 → PAL0[4]
02:0002B64C 0010            	  3507:     dc.w    $10                     ; sub-pal 1 → PAL0[8]
02:0002B64E 0018            	  3508:     dc.w    $18                     ; sub-pal 2 → PAL0[12]
02:0002B650 0028            	  3509:     dc.w    $28                     ; sub-pal 3 → PAL1[4]
                            	  3510: .ttf_pal_have_cram_new:
                            	  3511:     else
                            	  3512:     ; Legacy: remap NES sprite pal 0-3 → Genesis pal 2-3 (last-write-wins).
                            	  3513:     move.w  D0,D6
                            	  3514:     subi.w  #$10,D6
                            	  3515:     lsr.w   #2,D6                   ; NES sprite pal (0-3)
                            	  3516:     ori.w   #$0002,D6               ; Genesis pal = NES_pal | 2 (0→2, 1→3, 2→2, 3→3)
                            	  3517:     andi.w  #$0003,D6
                            	  3518:     lsl.w   #5,D6                   ; * $20
                            	  3519:     andi.w  #$0003,D0               ; color slot
                            	  3520:     lsl.w   #1,D0                   ; * 2
                            	  3521:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3522:     endc
02:0002B652 600E            	  3523:     bra.s   .ttf_pal_have_cram
                            	  3524: .ttf_pal_bg:
                            	  3525: 
                            	  3526:     ; Compute CRAM address: palette_idx*$20 + color_slot*2
02:0002B654 3C00            	  3527:     move.w  D0,D6
02:0002B656 E44E            	  3528:     lsr.w   #2,D6                   ; palette index (0..3)
02:0002B658 EB4E            	  3529:     lsl.w   #5,D6                   ; * $20
02:0002B65A 02400003        	  3530:     andi.w  #$0003,D0               ; color slot
02:0002B65E E348            	  3531:     lsl.w   #1,D0                   ; * 2
02:0002B660 DC40            	  3532:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3533: .ttf_pal_have_cram:
                            	  3534: 
                            	  3535:     ; VDP CRAM write command
02:0002B662 7000            	  3536:     moveq   #0,D0
02:0002B664 3006            	  3537:     move.w  D6,D0
02:0002B666 4840            	  3538:     swap    D0
02:0002B668 0080C0000000    	  3539:     ori.l   #$C0000000,D0
02:0002B66E 23C000C00004    	  3540:     move.l  D0,(VDP_CTRL).l
                            	  3541: 
                            	  3542:     ; Look up NES->Genesis color
02:0002B674 7000            	  3543:     moveq   #0,D0
02:0002B676 1002            	  3544:     move.b  D2,D0
02:0002B678 0240003F        	  3545:     andi.w  #$003F,D0               ; mask to valid color index
02:0002B67C E348            	  3546:     lsl.w   #1,D0                   ; word offset
02:0002B67E 30330000        	  3547:     move.w  (A3,D0.W),D0           ; Genesis color word
02:0002B682 33C000C00000    	  3548:     move.w  D0,(VDP_DATA).l
                            	  3549: 
                            	  3550: .ttf_pal_skip:
02:0002B688 DA41            	  3551:     add.w   D1,D5                   ; advance PPU_VADDR
02:0002B68A 02453FFF        	  3552:     andi.w  #$3FFF,D5
02:0002B68E 5343            	  3553:     subq.w  #1,D3
02:0002B690 6600FF72        	  3554:     bne     .ttf_pal_loop
                            	  3555: 
                            	  3556:     ; Palette post-reset: set PPU_VADDR to $0000, clear latch
02:0002B694 33FC000000FF0802	  3557:     move.w  #$0000,(PPU_VADDR).l
02:0002B69C 423900FF0800    	  3558:     clr.b   (PPU_LATCH).l
02:0002B6A2 265F            	  3559:     movea.l (SP)+,A3                ; restore safety limit
02:0002B6A4 6000FAE2        	  3560:     bra     .ttf_next_record        ; skip .ttf_post_record
                            	  3561: 
                            	  3562:     ;==========================================================================
                            	  3563:     ; SKIP: unhandled PPU address range — consume payload and continue
                            	  3564:     ;==========================================================================
                            	  3565: .ttf_skip_range:
02:0002B6A8 4A04            	  3566:     tst.b   D4                      ; repeat mode?
02:0002B6AA 6602            	  3567:     bne.s   .ttf_post_record        ; repeat: 1 byte already consumed
02:0002B6AC D0C3            	  3568:     adda.w  D3,A0                   ; sequential: skip D3 bytes
                            	  3569:     bra     .ttf_post_record
                            	  3570: 
                            	  3571:     ;==========================================================================
                            	  3572:     ; POST-RECORD: update PPU_VADDR and loop to next record
                            	  3573:     ;==========================================================================
                            	  3574: .ttf_post_record:
02:0002B6AE 33C500FF0802    	  3575:     move.w  D5,(PPU_VADDR).l
02:0002B6B4 6000FAD2        	  3576:     bra     .ttf_next_record
