                            	  4360: DrawLinkZeldaTriforces:
                            	  4361:     ; The triforce over Link goes in the room object slot $13.
                            	  4362:     ; Set its location $10 pixels above Link.
                            	  4363:     ;
02:00034E60 102C0070        	  4364:     move.b  ($0070,A4),D0
02:00034E64 19400083        	  4365:     move.b  D0,($0083,A4)
02:00034E68 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00034E6C 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00034E70 123C0010        	  4368:     move.b  #$10,D1
02:00034E74 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E78 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034E7A 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E7E 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
                            	  4374:     ;
02:00034E82 7400            	  4375:     moveq   #0,D2
02:00034E84 4EB9000490F0    	  4376:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00034E8A 6100C2E2        	  4377:     jsr     Anim_SetSpriteDescriptorAttributes
02:00034E8E 1940000C        	  4378:     move.b  D0,($000C,A4)
02:00034E92 7048            	  4379:     moveq   #72,D0
02:00034E94 19400343        	  4380:     move.b  D0,($0343,A4)
02:00034E98 704C            	  4381:     moveq   #76,D0
02:00034E9A 19400344        	  4382:     move.b  D0,($0344,A4)
02:00034E9E 7621            	  4383:     moveq   #33,D3
02:00034EA0 6100C21E        	  4384:     jsr     Anim_WriteSpecificItemSprites
                            	  4385:     ; Draw triforce over Link.
                            	  4386:     ;
02:00034EA4 701B            	  4387:     moveq   #27,D0
02:00034EA6 7413            	  4388:     moveq   #19,D2
02:00034EA8 4EB90004701C    	  4389:     jsr     AnimateItemObject
02:00034EAE 7401            	  4390:     moveq   #1,D2
02:00034EB0 4EB9000490F0    	  4391:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4392:     ; Draw Zelda.
                            	  4393:     ;
