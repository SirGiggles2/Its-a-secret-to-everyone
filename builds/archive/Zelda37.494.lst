02:0000E2DC 0000
02:0000E2DE 7000            	   563:     moveq   #0,D0
02:0000E2E0 33C000C00000    	   564:     move.w  D0,(VDP_DATA).l
02:0000E2E6 4E75            	   565:     rts
                            	   566: .aaa_split:
02:0000E2E8 23FC4000001000C0	   567:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E2F0 0004
02:0000E2F2 7000            	   568:     moveq   #0,D0
02:0000E2F4 0C39000100FF081F	   569:     cmpi.b  #INTRO_SCROLL_GAME_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E2FC 6706            	   570:     beq.s   .aaa_base_ready
02:0000E2FE 303900FF0836    	   571:     move.w  (ACTIVE_BASE_VSRAM).l,D0
