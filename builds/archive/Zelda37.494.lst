                            	  2498: ;==============================================================================
                            	  2499: ; EXPORT side — carry-returning shims.
                            	  2500: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2501: ; reproduces the original function's carry normalization.
                            	  2502: ;==============================================================================
                            	  2503: 
                            	  2504: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2505: c_copy_next_row_to_transfer_buf:
02:0002C002 4EB900000000    	  2506:     jsr     z05_copy_next_row_to_transfer_buf
02:0002C008 08000008        	  2507:     btst    #8,D0
02:0002C00C 670A            	  2508:     beq.s   .cc_cnr
02:0002C00E 003C0001        	  2509:     ori     #$01,CCR
02:0002C012 0A3C0001        	  2510:     eori    #$01,CCR
02:0002C016 4E75            	  2511:     rts
                            	  2512: .cc_cnr:
02:0002C018 023C00FE        	  2513:     andi    #$FE,CCR
02:0002C01C 0A3C0001        	  2514:     eori    #$01,CCR
02:0002C020 4E75            	  2515:     rts
                            	  2516: 
