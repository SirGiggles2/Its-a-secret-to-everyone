02:0000E666 0C430004        	  1054:     cmpi.w  #4,D3
02:0000E66A 650000D2        	  1055:     blo     .nt_skip_write
                            	  1056: .nt_attr_row_ok:
02:0000E66E 02420007        	  1057:     andi.w  #$0007,D2
02:0000E672 E54A            	  1058:     lsl.w   #2,D2                   ; D2.w = tile_base_col (0..28)
