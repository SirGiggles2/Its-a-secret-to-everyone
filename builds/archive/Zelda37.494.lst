02:0000E646 0C412400        	  1030:     cmpi.w  #$2400,D1
02:0000E64A 640000F2        	  1031:     bhs     .nt_skip_write          ; ≥$2400: overflow past attr table — skip
                            	  1032: 
                            	  1033:     ; ── T20 attribute decode ────────────────────────────�
                            	  1034:     ; offset = PPU_VADDR - $23C0 (0..63)
02:0000E64E 3401            	  1035:     move.w  D1,D2
02:0000E650 044223C0        	  1036:     subi.w  #$23C0,D2               ; D2.w = attribute offset (0..63)
                            	  1037: 
                            	  1038:     ; tile_base_col = (offset & 7) * 4,  tile_base_row = (offset >> 3) * 4
02:0000E654 3602            	  1039:     move.w  D2,D3
02:0000E656 E64B            	  1040:     lsr.w   #3,D3
02:0000E658 E54B            	  1041:     lsl.w   #2,D3                   ; D3.w = tile_base_row (0..28)
                            	  1042:     ; T39 HUD/playfield split: same gate as the tile path. tile_base_row
                            	  1043:     ; is always a multiple of 4 (0, 4, 8, …, 28); an attr byte at row 0
                            	  1044:     ; covers tile rows 0-3 (HUD), at row 4+ covers playfield. Route
                            	  1045:     ; $2000-source attrs to HUD only, $2400-source attrs to playfield only.
02:0000E65A 4A47            	  1046:     tst.w   D7
02:0000E65C 6608            	  1047:     bne.s   .nt_attr_src_2400
                            	  1048:     ; $2000-source: allow only tile_base_row == 0 (HUD rows 0-3).
02:0000E65E 4A43            	  1049:     tst.w   D3
02:0000E660 660000DC        	  1050:     bne     .nt_skip_write
02:0000E664 6008            	  1051:     bra.s   .nt_attr_row_ok
