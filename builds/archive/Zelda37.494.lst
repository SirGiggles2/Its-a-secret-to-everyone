                            	   970: ;==============================================================================
                            	   971: ; tick_sq0 — Sq0 channel update
                            	   972: ;==============================================================================
                            	   973: tick_sq0:
02:00000A26 4A3900FFE014    	   974:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:00000A2C 6754            	   975:     beq     tick_trg
02:00000A2E 533900FFE015    	   976:     subq.b  #1,(m_sq0_cnt).l
02:00000A34 664C            	   977:     bne     tick_trg
02:00000A36 207900FFE008    	   978:     move.l  (m_script_ptr).l,A0
02:00000A3C 7200            	   979:     moveq   #0,D1
02:00000A3E 123900FFE014    	   980:     move.b  (m_sq0_off).l,D1
02:00000A44 523900FFE014    	   981:     addq.b  #1,(m_sq0_off).l
02:00000A4A 10301000        	   982:     move.b  (A0,D1.w),D0
02:00000A4E 4A00            	   983:     tst.b   D0
02:00000A50 6A22            	   984:     bpl.s   .play
02:00000A52 61000164        	   985:     bsr     get_song_note_length
02:00000A56 13C000FFE016    	   986:     move.b  D0,(m_sq0_len).l
02:00000A5C 207900FFE008    	   987:     move.l  (m_script_ptr).l,A0
02:00000A62 7200            	   988:     moveq   #0,D1
02:00000A64 123900FFE014    	   989:     move.b  (m_sq0_off).l,D1
02:00000A6A 523900FFE014    	   990:     addq.b  #1,(m_sq0_off).l
02:00000A70 10301000        	   991:     move.b  (A0,D1.w),D0
                            	   992: .play:
02:00000A74 610001BA        	   993:     bsr     emit_note_sq0
02:00000A78 13F900FFE01600FF	   994:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A80 E015
                            	   995:     bra     tick_trg
                            	   996: 
                            	   997: ;==============================================================================
                            	   998: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	   999: ;==============================================================================
                            	  1000: tick_trg:
02:00000A82 4A3900FFE01C    	  1001:     tst.b   (m_trg_off).l
02:00000A88 6700009E        	  1002:     beq     tick_noise
02:00000A8C 533900FFE01D    	  1003:     subq.b  #1,(m_trg_cnt).l
02:00000A92 66000094        	  1004:     bne     tick_noise
                            	  1005: .prep_note_or_passage:
02:00000A96 207900FFE008    	  1006:     move.l  (m_script_ptr).l,A0
02:00000A9C 7200            	  1007:     moveq   #0,D1
02:00000A9E 123900FFE01C    	  1008:     move.b  (m_trg_off).l,D1
02:00000AA4 523900FFE01C    	  1009:     addq.b  #1,(m_trg_off).l
02:00000AAA 10301000        	  1010:     move.b  (A0,D1.w),D0
02:00000AAE 676A            	  1011:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000AB0 4A00            	  1012:     tst.b   D0
02:00000AB2 6A56            	  1013:     bpl.s   .play_note_trg                ; direct note
02:00000AB4 0C0000F0        	  1014:     cmpi.b  #$F0,D0
02:00000AB8 6718            	  1015:     beq.s   .end_of_passage
02:00000ABA 652A            	  1016:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1017:     ; $F1-$FF → start passage
02:00000ABC 040000F0        	  1018:     subi.b  #$F0,D0
02:00000AC0 13C000FFE021    	  1019:     move.b  D0,(m_trg_rep_n).l
02:00000AC6 13F900FFE01C00FF	  1020:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000ACE E022
02:00000AD0 60C4            	  1021:     bra.s   .prep_note_or_passage
                            	  1022: .end_of_passage:
02:00000AD2 533900FFE021    	  1023:     subq.b  #1,(m_trg_rep_n).l
02:00000AD8 670A            	  1024:     beq.s   .pass_done
02:00000ADA 13F900FFE02200FF	  1025:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000AE2 E01C
                            	  1026: .pass_done:
02:00000AE4 60B0            	  1027:     bra.s   .prep_note_or_passage
                            	  1028: .prep_note_trg:
02:00000AE6 610000D0        	  1029:     bsr     get_song_note_length
02:00000AEA 13C000FFE01E    	  1030:     move.b  D0,(m_trg_len).l
02:00000AF0 207900FFE008    	  1031:     move.l  (m_script_ptr).l,A0
02:00000AF6 7200            	  1032:     moveq   #0,D1
02:00000AF8 123900FFE01C    	  1033:     move.b  (m_trg_off).l,D1
02:00000AFE 523900FFE01C    	  1034:     addq.b  #1,(m_trg_off).l
02:00000B04 10301000        	  1035:     move.b  (A0,D1.w),D0
02:00000B08 6710            	  1036:     beq.s   .silence_trg
                            	  1037: .play_note_trg:
02:00000B0A 61000182        	  1038:     bsr     emit_note_trg
02:00000B0E 13F900FFE01E00FF	  1039:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B16 E01D
02:00000B18 600E            	  1040:     bra     tick_noise
                            	  1041: .silence_trg:
02:00000B1A 610001E6        	  1042:     bsr     key_off_trg
02:00000B1E 13F900FFE01E00FF	  1043:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B26 E01D
                            	  1044:     bra     tick_noise
                            	  1045: 
                            	  1046: ;==============================================================================
                            	  1047: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1048: ;==============================================================================
                            	  1049: tick_noise:
02:00000B28 103900FFE000    	  1050:     move.b  (m_song).l,D0
02:00000B2E 02000091        	  1051:     andi.b  #$91,D0
02:00000B32 67000082        	  1052:     beq     .tn_done
                            	  1053:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1054:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1055:     ; a hit fires below.
02:00000B36 61000250        	  1056:     bsr     noise_decay_tick
02:00000B3A 533900FFE025    	  1057:     subq.b  #1,(m_noise_cnt).l
02:00000B40 6674            	  1058:     bne     .tn_done
                            	  1059: .read:
02:00000B42 207900FFE008    	  1060:     move.l  (m_script_ptr).l,A0
02:00000B48 7200            	  1061:     moveq   #0,D1
02:00000B4A 123900FFE024    	  1062:     move.b  (m_noise_off).l,D1
02:00000B50 523900FFE024    	  1063:     addq.b  #1,(m_noise_off).l
02:00000B56 10301000        	  1064:     move.b  (A0,D1.w),D0
02:00000B5A 660C            	  1065:     bne.s   .got
02:00000B5C 13F900FFE00600FF	  1066:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B64 E024
02:00000B66 60DA            	  1067:     bra.s   .read
                            	  1068: .got:
02:00000B68 1800            	  1069:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1070:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1071:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1072:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1073:     ; (0,7,6). For our port we replicate exactly.
02:00000B6A 7400            	  1074:     moveq   #0,D2
02:00000B6C 1404            	  1075:     move.b  D4,D2
                            	  1076:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B6E 7000            	  1077:     moveq   #0,D0
02:00000B70 08020000        	  1078:     btst    #0,D2
02:00000B74 6704            	  1079:     beq.s   .b0
02:00000B76 08C00002        	  1080:     bset    #2,D0
                            	  1081: .b0:
02:00000B7A 08020007        	  1082:     btst    #7,D2
02:00000B7E 6704            	  1083:     beq.s   .b7
02:00000B80 08C00001        	  1084:     bset    #1,D0
                            	  1085: .b7:
02:00000B84 08020006        	  1086:     btst    #6,D2
02:00000B88 6704            	  1087:     beq.s   .b6
02:00000B8A 08C00000        	  1088:     bset    #0,D0
                            	  1089: .b6:
02:00000B8E 7200            	  1090:     moveq   #0,D1
02:00000B90 123900FFE003    	  1091:     move.b  (m_len_base).l,D1
02:00000B96 D240            	  1092:     add.w   D0,D1
02:00000B98 43F900000E3A    	  1093:     lea     (NoteLengthTables).l,A1
02:00000B9E 13F1100000FFE025	  1094:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1095:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000BA6 1004            	  1096:     move.b  D4,D0
02:00000BA8 0200003E        	  1097:     andi.b  #$3E,D0
02:00000BAC E808            	  1098:     lsr.b   #4,D0
02:00000BAE 7200            	  1099:     moveq   #0,D1
02:00000BB0 1200            	  1100:     move.b  D0,D1
                            	  1101:     ; Map to PSG noise: set volume + period
02:00000BB2 6100015A        	  1102:     bsr     set_psg_noise
                            	  1103: .tn_done:
02:00000BB6 4E75            	  1104:     rts
                            	  1105: 
                            	  1106: ;==============================================================================
                            	  1107: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1108: ; Input: D0 = control byte → Output: D0 = length
                            	  1109: ;==============================================================================
                            	  1110: get_song_note_length:
02:00000BB8 02400007        	  1111:     andi.w  #$07,D0
02:00000BBC 7200            	  1112:     moveq   #0,D1
02:00000BBE 123900FFE003    	  1113:     move.b  (m_len_base).l,D1
02:00000BC4 D240            	  1114:     add.w   D0,D1
02:00000BC6 43F900000E3A    	  1115:     lea     (NoteLengthTables).l,A1
02:00000BCC 10311000        	  1116:     move.b  (A1,D1.w),D0
02:00000BD0 4E75            	  1117:     rts
                            	  1118: 
                            	  1119: ;==============================================================================
                            	  1120: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1121: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1122: ;==============================================================================
                            	  1123: emit_note_sq1:
02:00000BD2 024000FF        	  1124:     andi.w  #$FF,D0
02:00000BD6 43F900000DC8    	  1125:     lea     (MusicNotePeriodTable).l,A1
02:00000BDC 7400            	  1126:     moveq   #0,D2
02:00000BDE 14310001        	  1127:     move.b  1(A1,D0.w),D2                 ; lo
02:00000BE2 67000106        	  1128:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000BE6 7600            	  1129:     moveq   #0,D3
02:00000BE8 16310000        	  1130:     move.b  0(A1,D0.w),D3                 ; hi
02:00000BEC E14B            	  1131:     lsl.w   #8,D3
02:00000BEE 8642            	  1132:     or.w    D2,D3                          ; D3.w = period
02:00000BF0 024307FF        	  1133:     andi.w  #$07FF,D3
02:00000BF4 13C200FFE010    	  1134:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000BFA 3403            	  1135:     move.w  D3,D2
02:00000BFC 263C00021986    	  1136:     move.l  #NES_YM_K5_PULSE,D3
02:00000C02 6100F804        	  1137:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1138:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000C06 103C0028        	  1139:     move.b  #$28,D0
02:00000C0A 7200            	  1140:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000C0C 6100F7B2        	  1141:     bsr     ym_write1
02:00000C10 103C00A4        	  1142:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000C14 1202            	  1143:     move.b  D2,D1
02:00000C16 6100F7A8        	  1144:     bsr     ym_write1
02:00000C1A 103C00A0        	  1145:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000C1E 1203            	  1146:     move.b  D3,D1
02:00000C20 6100F79E        	  1147:     bsr     ym_write1
                            	  1148:     ; Key on ch 0, all ops
02:00000C24 103C0028        	  1149:     move.b  #$28,D0
02:00000C28 123C00F0        	  1150:     move.b  #$F0,D1
02:00000C2C 6000F792        	  1151:     bra     ym_write1
                            	  1152: 
                            	  1153: ;==============================================================================
                            	  1154: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1155: ;==============================================================================
                            	  1156: emit_note_sq0:
02:00000C30 024000FF        	  1157:     andi.w  #$FF,D0
02:00000C34 43F900000DC8    	  1158:     lea     (MusicNotePeriodTable).l,A1
02:00000C3A 7400            	  1159:     moveq   #0,D2
02:00000C3C 14310001        	  1160:     move.b  1(A1,D0.w),D2
02:00000C40 670000B4        	  1161:     beq     key_off_sq0
02:00000C44 7600            	  1162:     moveq   #0,D3
02:00000C46 16310000        	  1163:     move.b  0(A1,D0.w),D3
02:00000C4A E14B            	  1164:     lsl.w   #8,D3
02:00000C4C 8642            	  1165:     or.w    D2,D3
02:00000C4E 024307FF        	  1166:     andi.w  #$07FF,D3
02:00000C52 13C200FFE018    	  1167:     move.b  D2,(m_sq0_per).l
02:00000C58 3403            	  1168:     move.w  D3,D2
02:00000C5A 263C00021986    	  1169:     move.l  #NES_YM_K5_PULSE,D3
02:00000C60 6100F7A6        	  1170:     bsr     nes_to_ym_freq
                            	  1171:     ; Key off first so the envelope attack phase retriggers
02:00000C64 103C0028        	  1172:     move.b  #$28,D0
02:00000C68 7201            	  1173:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000C6A 6100F754        	  1174:     bsr     ym_write1
02:00000C6E 103C00A5        	  1175:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000C72 1202            	  1176:     move.b  D2,D1
02:00000C74 6100F74A        	  1177:     bsr     ym_write1
02:00000C78 103C00A1        	  1178:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000C7C 1203            	  1179:     move.b  D3,D1
02:00000C7E 6100F740        	  1180:     bsr     ym_write1
02:00000C82 103C0028        	  1181:     move.b  #$28,D0
02:00000C86 123C00F1        	  1182:     move.b  #$F1,D1
02:00000C8A 6000F734        	  1183:     bra     ym_write1
                            	  1184: 
                            	  1185: ;==============================================================================
                            	  1186: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1187: ;==============================================================================
                            	  1188: emit_note_trg:
02:00000C8E 024000FF        	  1189:     andi.w  #$FF,D0
02:00000C92 43F900000DC8    	  1190:     lea     (MusicNotePeriodTable).l,A1
02:00000C98 7400            	  1191:     moveq   #0,D2
02:00000C9A 14310001        	  1192:     move.b  1(A1,D0.w),D2
02:00000C9E 6762            	  1193:     beq     key_off_trg
02:00000CA0 7600            	  1194:     moveq   #0,D3
02:00000CA2 16310000        	  1195:     move.b  0(A1,D0.w),D3
02:00000CA6 E14B            	  1196:     lsl.w   #8,D3
02:00000CA8 8642            	  1197:     or.w    D2,D3
02:00000CAA 024307FF        	  1198:     andi.w  #$07FF,D3
02:00000CAE 13C200FFE020    	  1199:     move.b  D2,(m_trg_per).l
02:00000CB4 3403            	  1200:     move.w  D3,D2
02:00000CB6 263C00010CC3    	  1201:     move.l  #NES_YM_K5_TRI,D3
02:00000CBC 6100F74A        	  1202:     bsr     nes_to_ym_freq
                            	  1203:     ; Key off first so the bass envelope retriggers per note
02:00000CC0 103C0028        	  1204:     move.b  #$28,D0
02:00000CC4 7202            	  1205:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000CC6 6100F6F8        	  1206:     bsr     ym_write1
02:00000CCA 103C00A6        	  1207:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000CCE 1202            	  1208:     move.b  D2,D1
02:00000CD0 6100F6EE        	  1209:     bsr     ym_write1
02:00000CD4 103C00A2        	  1210:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000CD8 1203            	  1211:     move.b  D3,D1
02:00000CDA 6100F6E4        	  1212:     bsr     ym_write1
02:00000CDE 103C0028        	  1213:     move.b  #$28,D0
02:00000CE2 123C00F2        	  1214:     move.b  #$F2,D1
02:00000CE6 6000F6D8        	  1215:     bra     ym_write1
                            	  1216: 
                            	  1217: ;==============================================================================
                            	  1218: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1219: ;==============================================================================
                            	  1220: key_off_sq1:
02:00000CEA 103C0028        	  1221:     move.b  #$28,D0
02:00000CEE 123C0000        	  1222:     move.b  #$00,D1
02:00000CF2 6000F6CC        	  1223:     bra     ym_write1
                            	  1224: key_off_sq0:
02:00000CF6 103C0028        	  1225:     move.b  #$28,D0
02:00000CFA 123C0001        	  1226:     move.b  #$01,D1
02:00000CFE 6000F6C0        	  1227:     bra     ym_write1
                            	  1228: key_off_trg:
02:00000D02 103C0028        	  1229:     move.b  #$28,D0
02:00000D06 123C0002        	  1230:     move.b  #$02,D1
02:00000D0A 6000F6B4        	  1231:     bra     ym_write1
                            	  1232: 
                            	  1233: ;==============================================================================
                            	  1234: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1235: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1236: ;
                            	  1237: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1238: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1239: ;     PsgDrumTable.
                            	  1240: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1241: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1242: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1243: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1244: ;     noise_decay_tick.
                            	  1245: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1246: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1247: ;==============================================================================
                            	  1248: set_psg_noise:
                            	  1249:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1250:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1251:     ; music drums resume on the next beat.
02:00000D0E 4A3900FF0606    	  1252:     tst.b   ($00FF0606).l
02:00000D14 661A            	  1253:     bne.s   .sfx_owns_psg
02:00000D16 4A01            	  1254:     tst.b   D1
02:00000D18 6618            	  1255:     bne.s   .not_rest
                            	  1256:     ; Rest: silence the PSG noise channel immediately.
02:00000D1A 423900FFE026    	  1257:     clr.b   (m_noise_level).l
02:00000D20 423900FFE027    	  1258:     clr.b   (m_noise_decay).l
02:00000D26 13FC00FF00C00011	  1259:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000D2E 4E75            	  1260:     rts
                            	  1261: .sfx_owns_psg:
02:00000D30 4E75            	  1262:     rts
                            	  1263: .not_rest:
02:00000D32 7000            	  1264:     moveq   #0,D0
02:00000D34 1001            	  1265:     move.b  D1,D0
02:00000D36 E548            	  1266:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000D38 43F900000E6E    	  1267:     lea     (PsgDrumTable).l,A1
02:00000D3E D3C0            	  1268:     adda.l  D0,A1
02:00000D40 1019            	  1269:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1270:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000D42 B03900FFE028    	  1271:     cmp.b   (m_last_psg_nc).l,D0
02:00000D48 670C            	  1272:     beq.s   .nc_same
02:00000D4A 13C000FFE028    	  1273:     move.b  D0,(m_last_psg_nc).l
02:00000D50 13C000C00011    	  1274:     move.b  D0,(PSG_PORT).l
                            	  1275: .nc_same:
02:00000D56 1019            	  1276:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000D58 13C000FFE026    	  1277:     move.b  D0,(m_noise_level).l
02:00000D5E 1019            	  1278:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000D60 13C000FFE027    	  1279:     move.b  D0,(m_noise_decay).l
                            	  1280:     bra     write_psg_noise_vol
                            	  1281: 
                            	  1282: ;==============================================================================
                            	  1283: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1284: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1285: ; Preserves D1.
                            	  1286: ;==============================================================================
                            	  1287: write_psg_noise_vol:
02:00000D66 4A3900FF0606    	  1288:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000D6C 6618            	  1289:     bne.s   .wpnv_skip
02:00000D6E 7000            	  1290:     moveq   #0,D0
02:00000D70 103900FFE026    	  1291:     move.b  (m_noise_level).l,D0
02:00000D76 E808            	  1292:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000D78 0A00000F        	  1293:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000D7C 000000F0        	  1294:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000D80 13C000C00011    	  1295:     move.b  D0,(PSG_PORT).l
                            	  1296: .wpnv_skip:
02:00000D86 4E75            	  1297:     rts
                            	  1298: 
                            	  1299: ;==============================================================================
                            	  1300: ; noise_decay_tick — linear envelope decay step.
                            	  1301: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1302: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1303: ; Preserves D1.
                            	  1304: ;==============================================================================
                            	  1305: noise_decay_tick:
02:00000D88 4A3900FF0606    	  1306:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000D8E 661A            	  1307:     bne.s   .nd_done
02:00000D90 103900FFE026    	  1308:     move.b  (m_noise_level).l,D0
02:00000D96 6712            	  1309:     beq.s   .nd_done                        ; already silent
02:00000D98 903900FFE027    	  1310:     sub.b   (m_noise_decay).l,D0
02:00000D9E 6402            	  1311:     bcc.s   .nd_store                       ; no underflow → new level
02:00000DA0 7000            	  1312:     moveq   #0,D0                           ; underflow → silent
                            	  1313: .nd_store:
02:00000DA2 13C000FFE026    	  1314:     move.b  D0,(m_noise_level).l
02:00000DA8 60BC            	  1315:     bra     write_psg_noise_vol
                            	  1316: .nd_done:
02:00000DAA 4E75            	  1317:     rts
                            	  1318: 
                            	  1319: ;==============================================================================
                            	  1320: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1321: ;==============================================================================
                            	  1322: music_silence:
02:00000DAC 423900FFE000    	  1323:     clr.b   (m_song).l
02:00000DB2 6100FF36        	  1324:     bsr     key_off_sq1
02:00000DB6 6100FF3E        	  1325:     bsr     key_off_sq0
02:00000DBA 6100FF46        	  1326:     bsr     key_off_trg
02:00000DBE 13FC00FF00C00011	  1327:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000DC6 4E75            	  1328:     rts
                            	  1329: 
                            	  1330: ;==============================================================================
                            	  1331: ; Music data tables
                            	  1332: ;==============================================================================
                            	  1333:     even
                            	  1334: 
                            	  1335: ; MusicNotePeriodTable — 114 bytes, big-endian 16-bit periods indexed by
                            	  1336: ; even note IDs (byte offsets).  Pulled from reference Z_00.asm.
                            	  1337: ; (Local copy to avoid label collision with the transpiled MusicNotePeriodTable
                            	  1338: ; in zelda_translated/z_00.asm, whose in-memory layout may have `even`
                            	  1339: ; padding that breaks offset math.)
                            	  1340: MusicNotePeriodTable:
02:00000DC8 00              	  1341:     dc.b    $00,$23,$00,$6A,$03,$27,$00,$97
02:00000DC9 23
02:00000DCA 00
02:00000DCB 6A
02:00000DCC 03
02:00000DCD 27
02:00000DCE 00
02:00000DCF 97
02:00000DD0 00              	  1342:     dc.b    $00,$00,$02,$F9,$02,$CF,$02,$A6
02:00000DD1 00
02:00000DD2 02
02:00000DD3 F9
02:00000DD4 02
02:00000DD5 CF
02:00000DD6 02
02:00000DD7 A6
02:00000DD8 02              	  1343:     dc.b    $02,$80,$02,$5C,$02,$3A,$02,$1A
02:00000DD9 80
02:00000DDA 02
02:00000DDB 5C
02:00000DDC 02
02:00000DDD 3A
02:00000DDE 02
02:00000DDF 1A
02:00000DE0 01              	  1344:     dc.b    $01,$FC,$01,$DF,$01,$C4,$01,$AB
02:00000DE1 FC
02:00000DE2 01
02:00000DE3 DF
02:00000DE4 01
02:00000DE5 C4
