                            	  8485: GanonFrameImages:
02:0003BE1E 06              	  8486:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003BE1F 08
02:0003BE20 07
02:0003BE21 09
02:0003BE22 00
02:0003BE23 00
02:0003BE24 01
02:0003BE25 01
02:0003BE26 02              	  8487:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003BE27 02
02:0003BE28 03
02:0003BE29 03
02:0003BE2A 04
02:0003BE2B 00
02:0003BE2C 05
02:0003BE2D 01
02:0003BE2E 04              	  8488:     dc.b    $04, $04, $05, $05, $00, $04, $01, $05
02:0003BE2F 04
02:0003BE30 05
02:0003BE31 05
02:0003BE32 00
02:0003BE33 04
02:0003BE34 01
02:0003BE35 05
