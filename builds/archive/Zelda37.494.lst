02:0000E30C 33C000C00000    	   575:     move.w  D0,(VDP_DATA).l
02:0000E312 7000            	   576:     moveq   #0,D0
02:0000E314 103900FF0817    	   577:     move.b  (HINT_Q0_CTR).l,D0
02:0000E31A 024000FF        	   578:     andi.w  #$00FF,D0
02:0000E31E 807C8A00        	   579:     or.w    #$8A00,D0
02:0000E322 33C000C00004    	   580:     move.w  D0,(VDP_CTRL).l                 ; Reg 10 = active H-int scanline
02:0000E328 33FC801400C00004	   581:     move.w  #$8014,(VDP_CTRL).l             ; Reg 0: enable H-int (+colorfix bit)
