02:00048CC8 E208            	  6093:     lsr.b  #1,D0   ; LSR A
02:00048CCA E208            	  6094:     lsr.b  #1,D0   ; LSR A
02:00048CCC E208            	  6095:     lsr.b  #1,D0   ; LSR A
02:00048CCE E208            	  6096:     lsr.b  #1,D0   ; LSR A
02:00048CD0 1214            	  6097:     move.b  ($0000,A4),D1
02:00048CD2 B001            	  6098:     cmp.b   D1,D0
02:00048CD4 6702            	  6099:     beq.s  __far_z_07_0092
02:00048CD6 60C6            	  6100:     jmp  L1F854_Exit
