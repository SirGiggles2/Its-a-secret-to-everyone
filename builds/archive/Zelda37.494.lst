02:00048D1E 1940000F        	  6137:     move.b  D0,($000F,A4)
02:00048D22 6100F14A        	  6138:     jsr     MoveObject
02:00048D26 101D            	  6139:     move.b  (A5)+,D0  ; PLA
                            	  6140:     ; Add grid offset after the move to the original.
                            	  6141:     ; This makes it continuous, and useful as a distance traveled.
                            	  6142:     ;
02:00048D28 023C00EE        	  6143:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048D2C 41EC0394        	  6144:     lea     ($0394,A4),A0
02:00048D30 12302000        	  6145:     move.b  (A0,D2.W),D1
02:00048D34 D101            	  6146:     addx.b  D1,D0   ; ADC ObjGridOffset,X
02:00048D36 41EC0394        	  6147:     lea     ($0394,A4),A0
02:00048D3A 11802000        	  6148:     move.b  D0,(A0,D2.W)
                            	  6149:     ; If the absolute value of grid offset < $10, go draw.
