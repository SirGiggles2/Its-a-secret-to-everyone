                            	  4300: Digdogger_SpeedUp:
                            	  4301:     ; Add 1 to 16-bit speed.
                            	  4302:     ;
02:00039EE2 41EC041F        	  4303:     lea     ($041F,A4),A0
02:00039EE6 52302000        	  4304:     addq.b  #1,(A0,D2.W)
02:00039EEA 6608            	  4305:     bne  _anon_z04_85
02:00039EEC 41EC042C        	  4306:     lea     ($042C,A4),A0
02:00039EF0 52302000        	  4307:     addq.b  #1,(A0,D2.W)
                            	  4308: _anon_z04_85:
                            	  4309:     ; If the 16-bit speed has not reached the 16-bit target speed, then return.
                            	  4310:     ;
02:00039EF4 41EC041F        	  4311:     lea     ($041F,A4),A0
02:00039EF8 10302000        	  4312:     move.b  (A0,D2.W),D0
02:00039EFC 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039F00 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039F04 B001            	  4315:     cmp.b   D1,D0
02:00039F06 6704            	  4316:     beq.s  __far_z_04_0038
02:00039F08 6000009E        	  4317:     jmp  L116EA_Exit
                            	  4318: __far_z_04_0038:
02:00039F0C 41EC042C        	  4319:     lea     ($042C,A4),A0
02:00039F10 10302000        	  4320:     move.b  (A0,D2.W),D0
02:00039F14 41EC0444        	  4321:     lea     ($0444,A4),A0
02:00039F18 12302000        	  4322:     move.b  (A0,D2.W),D1
02:00039F1C B001            	  4323:     cmp.b   D1,D0
02:00039F1E 6704            	  4324:     beq.s  __far_z_04_0039
02:00039F20 60000086        	  4325:     jmp  L116EA_Exit
                            	  4326: __far_z_04_0039:
                            	  4327:     ; Set speed flag to 1 meaning decelerate.
                            	  4328:     ;
02:00039F24 41EC045E        	  4329:     lea     ($045E,A4),A0
02:00039F28 52302000        	  4330:     addq.b  #1,(A0,D2.W)
                            	  4331:     ; Go set target speed to $0040 (or $0140 if this is a child).
                            	  4332:     ;
02:00039F2C 7040            	  4333:     moveq   #64,D0
02:00039F2E 6052            	  4334:     jmp     SetTargetSpeed
                            	  4335: 
                            	  4336:     even
                            	  4337: Digdogger_SlowDown:
                            	  4338:     ; Subtract 1 from 16-bit speed.
                            	  4339:     ;
02:00039F30 41EC041F        	  4340:     lea     ($041F,A4),A0
02:00039F34 53302000        	  4341:     subq.b  #1,(A0,D2.W)
02:00039F38 41EC041F        	  4342:     lea     ($041F,A4),A0
02:00039F3C 10302000        	  4343:     move.b  (A0,D2.W),D0
02:00039F40 0C0000FF        	  4344:     cmpi.b  #$FF,D0
02:00039F44 6603            	  4345:     bne  _anon_z04_86
                            	  4346: ; Unknown block
02:00039F46 DE              	  4347:     dc.b    $DE, $2C, $04
02:00039F47 2C
02:00039F48 04
                            	  4348: 
