                            	  5712: _anon_z05_123:
                            	  5713:     ; Door command <> 4.
                            	  5714:     ; It must be 8, which means it was 7: open door.
                            	  5715:     ;
                            	  5716:     ; If the door is a shutter (7), then go add the door to the
                            	  5717:     ; opened door mask, reset door command, and lay out doors.
                            	  5718:     ;
02:0003FE8E 102C0055        	  5719:     move.b  ($0055,A4),D0
02:0003FE92 19400002        	  5720:     move.b  D0,($0002,A4)
02:0003FE96 6100FA32        	  5721:     jsr     FindDoorAttrByDoorBit
02:0003FE9A 0C000007        	  5722:     cmpi.b  #$07,D0
02:0003FE9E 676E            	  5723:     beq  _anon_z05_124
                            	  5724:     ; Else the door is not a shutter.
                            	  5725:     ;
                            	  5726:     ;
                            	  5727:     ; [09] door direction index
02:0003FEA0 7400            	  5728:     moveq   #0,D2
02:0003FEA2 142C0009        	  5729:     move.b  ($0009,A4),D2
02:0003FEA6 6100DCA8        	  5730:     jsr     SetDoorFlag
                            	  5731:     ; Get the next room's ID.
                            	  5732:     ;
02:0003FEAA 1003            	  5733:     move.b  D3,D0
02:0003FEAC 023C00EE        	  5734:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FEB0 41F90003FD6C    	  5735:     lea     (DoorNextRoomIdOffsets).l,A0
02:0003FEB6 12302000        	  5736:     move.b  (A0,D2.W),D1
02:0003FEBA D101            	  5737:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0003FEBC 7600            	  5738:     moveq   #0,D3
02:0003FEBE 1600            	  5739:     move.b  D0,D3
                            	  5740:     ; Flip the door direction index.
                            	  5741:     ;
02:0003FEC0 1002            	  5742:     move.b  D2,D0
02:0003FEC2 0A000001        	  5743:     eori.b #$01,D0
02:0003FEC6 7400            	  5744:     moveq   #0,D2
02:0003FEC8 1400            	  5745:     move.b  D0,D2
                            	  5746:     ; Set the door flag for the opposite door in the next room.
                            	  5747:     ;
02:0003FECA 1214            	  5748:     move.b  ($00,A4),D1   ; ptr lo
02:0003FECC 182C0001        	  5749:     move.b  ($01,A4),D4  ; ptr hi
02:0003FED0 024100FF        	  5750:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003FED4 E14C            	  5751:     lsl.w   #8,D4
02:0003FED6 8841            	  5752:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003FED8 48C4            	  5753:     ext.l   D4
02:0003FEDA D8BC00FF0000    	  5754:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003FEE0 2044            	  5755:     movea.l D4,A0
02:0003FEE2 10303000        	  5756:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003FEE6 41F900046FB6    	  5757:     lea     (LevelMasks).l,A0
02:0003FEEC 12302000        	  5758:     move.b  (A0,D2.W),D1
02:0003FEF0 8001            	  5759:     or.b  D1,D0
02:0003FEF2 1214            	  5760:     move.b  ($00,A4),D1   ; ptr lo
02:0003FEF4 182C0001        	  5761:     move.b  ($01,A4),D4  ; ptr hi
02:0003FEF8 024100FF        	  5762:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003FEFC E14C            	  5763:     lsl.w   #8,D4
02:0003FEFE 8841            	  5764:     or.w    D1,D4
02:0003FF00 48C4            	  5765:     ext.l   D4
02:0003FF02 D8BC00FF0000    	  5766:     add.l   #NES_RAM,D4
02:0003FF08 2044            	  5767:     movea.l D4,A0
02:0003FF0A 11803000        	  5768:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5769: _anon_z05_124:
                            	  5770:     ; Add the door to the opened door mask, reset door command,
                            	  5771:     ; and lay out doors.
                            	  5772:     ;
02:0003FF0E 102C0055        	  5773:     move.b  ($0055,A4),D0
02:0003FF12 122C00EE        	  5774:     move.b  ($00EE,A4),D1
02:0003FF16 8001            	  5775:     or.b  D1,D0
02:0003FF18 6000FF66        	  5776:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:0003FF1C 102C0055        	  5803:     move.b  ($0055,A4),D0
02:0003FF20 19400002        	  5804:     move.b  D0,($0002,A4)
02:0003FF24 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:0003FF28 0C000005        	  5806:     cmpi.b  #$05,D0
02:0003FF2C 650C            	  5807:     bcs  _anon_z05_125
02:0003FF2E 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:0003FF30 7004            	  5809:     moveq   #4,D0
02:0003FF32 4EB900030A06    	  5810:     jsr     PlaySample
02:0003FF38 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:0003FF3A 0C000004        	  5818:     cmpi.b  #$04,D0
02:0003FF3E 6602            	  5819:     bne  _anon_z05_126
02:0003FF40 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:0003FF42 0C000001        	  5822:     cmpi.b  #$01,D0
02:0003FF46 6602            	  5823:     bne  _anon_z05_127
02:0003FF48 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:0003FF4A 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:0003FF4E 123C0003        	  5829:     move.b  #$03,D1
02:0003FF52 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF56 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:0003FF58 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003FF5C 7600            	  5833:     moveq   #0,D3
02:0003FF5E 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:0003FF60 102C0008        	  5841:     move.b  ($0008,A4),D0
02:0003FF64 6708            	  5842:     beq  _anon_z05_128
02:0003FF66 0C030005        	  5843:     cmpi.b  #$05,D3
02:0003FF6A 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FF6C 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:0003FF6E 0C030003        	  5847:     cmpi.b  #$03,D3
02:0003FF72 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003FF74 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:0003FF76 7003            	  5857:     moveq   #3,D0
02:0003FF78 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:0003FF7C 122C0003        	  5859:     move.b  ($0003,A4),D1
02:0003FF80 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FF84 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:0003FF86 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:0003FF8A 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:0003FF8E 41F90003FD64    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:0003FF94 10302000        	  5870:     move.b  (A0,D2.W),D0
02:0003FF98 1880            	  5871:     move.b  D0,($0000,A4)
02:0003FF9A 41F90003FD68    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:0003FFA0 10302000        	  5873:     move.b  (A0,D2.W),D0
02:0003FFA4 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:0003FFA8 19420009        	  5878:     move.b  D2,($0009,A4)
02:0003FFAC 7400            	  5879:     moveq   #0,D2
02:0003FFAE 142C0301        	  5880:     move.b  ($0301,A4),D2
                            	  5881:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5882:     ;
02:0003FFB2 7000            	  5883:     moveq   #0,D0
02:0003FFB4 19400007        	  5884:     move.b  D0,($0007,A4)
02:0003FFB8 7002            	  5885:     moveq   #2,D0
02:0003FFBA 19400006        	  5886:     move.b  D0,($0006,A4)
02:0003FFBE 19400005        	  5887:     move.b  D0,($0005,A4)
02:0003FFC2 0A3C0001        	  5888:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003FFC6 4E75            	  5889:     rts
