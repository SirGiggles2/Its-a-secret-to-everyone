                            	  1761: ;==============================================================================
                            	  1762: ; Controller I/O
                            	  1763: ;==============================================================================
                            	  1764: 
                            	  1765: ;------------------------------------------------------------------------------
                            	  1766: ; _ctrl_strobe — $4016 write (T27).
                            	  1767: ;
                            	  1768: ; On every call: read Genesis controller 1 via hardware I/O (TH two-phase),
                            	  1769: ; build an 8-bit NES button latch byte, and reset the serial read index.
                            	  1770: ;
                            	  1771: ; NES button order (bit0=A, bit1=B, bit2=Sel, bit3=Start,
                            	  1772: ;                   bit4=Up, bit5=Down, bit6=Left, bit7=Right).
                            	  1773: ; Genesis bits are active-low (0 = pressed).
                            	  1774: ;
                            	  1775: ; Latch storage (in Genesis work-RAM above NES address space):
                            	  1776: ;   CTL1_LATCH = ($1100,A4) = $FF1100 — latched NES button byte
                            	  1777: ;   CTL1_IDX   = ($1101,A4) = $FF1101 — serial read index (0–7)
                            	  1778: ;------------------------------------------------------------------------------
                            	  1779: _ctrl_strobe:
                            	  1780:     ; Gate: the NES protocol writes $01 then $00 to $4016.  The transpiled
                            	  1781:     ; code preserves this as two jsr _ctrl_strobe calls — first with D0=1
                            	  1782:     ; (strobe-on), then D0=0 (strobe-off = latch).  Only the D0=0 call
                            	  1783:     ; needs to actually poll the pad.  Skipping the D0=1 call halves the
                            	  1784:     ; TH toggle frequency, which prevents ReadOneController's debounce
                            	  1785:     ; loop from trapping on real hardware where rapid toggling produces
                            	  1786:     ; inconsistent reads from the 3-button pad multiplexer.
02:0002AAD2 4A00            	  1787:     tst.b   D0
02:0002AAD4 660000A0        	  1788:     bne     .cs_skip             ; D0 != 0 → strobe-on phase, no-op
                            	  1789: 
02:0002AAD8 48E77000        	  1790:     movem.l D1-D3,-(SP)
                            	  1791:     ; Phase 1: TH=1 → bits[5:4]=C,B  bits[3:0]=Right,Left,Down,Up (active low)
                            	  1792:     ; CTRL register ($A10009) already set to $40 by EntryPoint init.
02:0002AADC 13FC004000A10003	  1793:     move.b  #$40,($A10003).l    ; assert TH=1
02:0002AAE4 4E71            	  1794:     nop                          ; 4 NOPs settling time for real hardware
02:0002AAE6 4E71            	  1795:     nop
02:0002AAE8 4E71            	  1796:     nop
02:0002AAEA 4E71            	  1797:     nop
02:0002AAEC 123900A10003    	  1798:     move.b  ($A10003).l,D1      ; D1 = TH=1 data
                            	  1799:     ; Phase 2: TH=0 → bits[5:4]=Start,A  bits[3:0]=Right,Left,Down,Up (active low)
02:0002AAF2 13FC000000A10003	  1800:     move.b  #$00,($A10003).l    ; assert TH=0
02:0002AAFA 4E71            	  1801:     nop
02:0002AAFC 4E71            	  1802:     nop
02:0002AAFE 4E71            	  1803:     nop
02:0002AB00 4E71            	  1804:     nop
02:0002AB02 143900A10003    	  1805:     move.b  ($A10003).l,D2      ; D2 = TH=0 data
                            	  1806:     ; Restore TH=1 idle state (standard Genesis practice)
02:0002AB08 13FC004000A10003	  1807:     move.b  #$40,($A10003).l
                            	  1808:     ; Build NES button byte
                            	  1809:     ; Button mapping (user request): NES B = Genesis A, NES A = Genesis B.
                            	  1810:     ; Genesis B sits where the user's primary attack thumb lands, so it
                            	  1811:     ; drives the NES "sword/attack" (NES A).  Genesis A falls to NES B
                            	  1812:     ; ("item" — boomerang, bombs, candle, etc.).
02:0002AB10 7600            	  1813:     moveq   #0,D3
02:0002AB12 08010004        	  1814:     btst    #4,D1               ; Genesis B: TH=1 bit4 (active low) → NES A
02:0002AB16 6604            	  1815:     bne.s   .cs_no_a
02:0002AB18 08C30000        	  1816:     bset    #0,D3
                            	  1817: .cs_no_a:
02:0002AB1C 08020004        	  1818:     btst    #4,D2               ; Genesis A: TH=0 bit4 (active low) → NES B
02:0002AB20 6604            	  1819:     bne.s   .cs_no_b
02:0002AB22 08C30001        	  1820:     bset    #1,D3
                            	  1821: .cs_no_b:
                            	  1822:     ; Phase 2.3: Genesis C → NES Select remap.  The 3-button pad has no
                            	  1823:     ; hardware Select; the diary standardized on C so the user can
                            	  1824:     ; eliminate save slots in file-select and access the NES pause menu.
02:0002AB26 08010005        	  1825:     btst    #5,D1               ; C button: TH=1 bit5 (active low)
02:0002AB2A 6604            	  1826:     bne.s   .cs_no_select
02:0002AB2C 08C30002        	  1827:     bset    #2,D3               ; NES Select
                            	  1828: .cs_no_select:
02:0002AB30 08020005        	  1829:     btst    #5,D2               ; Start: TH=0 bit5 (active low)
02:0002AB34 6604            	  1830:     bne.s   .cs_no_start
02:0002AB36 08C30003        	  1831:     bset    #3,D3
                            	  1832: .cs_no_start:
02:0002AB3A 08010000        	  1833:     btst    #0,D1               ; Up: TH=1 bit0 (active low)
02:0002AB3E 6604            	  1834:     bne.s   .cs_no_up
02:0002AB40 08C30004        	  1835:     bset    #4,D3
                            	  1836: .cs_no_up:
02:0002AB44 08010001        	  1837:     btst    #1,D1               ; Down: TH=1 bit1 (active low)
02:0002AB48 6604            	  1838:     bne.s   .cs_no_down
02:0002AB4A 08C30005        	  1839:     bset    #5,D3
                            	  1840: .cs_no_down:
02:0002AB4E 08010002        	  1841:     btst    #2,D1               ; Left: TH=1 bit2 (active low)
02:0002AB52 6604            	  1842:     bne.s   .cs_no_left
02:0002AB54 08C30006        	  1843:     bset    #6,D3
                            	  1844: .cs_no_left:
02:0002AB58 08010003        	  1845:     btst    #3,D1               ; Right: TH=1 bit3 (active low)
02:0002AB5C 6604            	  1846:     bne.s   .cs_no_right
02:0002AB5E 08C30007        	  1847:     bset    #7,D3
                            	  1848: .cs_no_right:
02:0002AB62 19431100        	  1849:     move.b  D3,($1100,A4)       ; store latched NES button byte
02:0002AB66 197C00001101    	  1850:     move.b  #0,($1101,A4)       ; reset serial index
02:0002AB6C 523900FF100A    	  1851:     addq.b  #1,($00FF100A).l    ; Phase 2.4: input-poll probe counter
02:0002AB72 4CDF000E        	  1852:     movem.l (SP)+,D1-D3
                            	  1853: .cs_skip:
02:0002AB76 4E75            	  1854:     rts
                            	  1855: 
                            	  1856: ;------------------------------------------------------------------------------
                            	  1857: ; _ctrl_read_1 — $4016 read (T27).
                            	  1858: ;
                            	  1859: ; Returns the next button bit from the latch in D0.b (bit0 = button state,
                            	  1860: ; 1 = pressed).  Buttons are in NES order: A, B, Sel, Start, Up, Down, Left,
                            	  1861: ; Right (index 0–7).  Returns 0 when index overflows past 7.
                            	  1862: ;------------------------------------------------------------------------------
                            	  1863: _ctrl_read_1:
02:0002AB78 7200            	  1864:     moveq   #0,D1
02:0002AB7A 122C1101        	  1865:     move.b  ($1101,A4),D1       ; D1.l = current index (zero-extended)
02:0002AB7E 0C010008        	  1866:     cmpi.b  #8,D1
02:0002AB82 6C12            	  1867:     bge.s   .cr1_overflow
02:0002AB84 522C1101        	  1868:     addq.b  #1,($1101,A4)       ; advance index for next read
02:0002AB88 7000            	  1869:     moveq   #0,D0
02:0002AB8A 102C1100        	  1870:     move.b  ($1100,A4),D0       ; D0 = latched button byte
02:0002AB8E E228            	  1871:     lsr.b   D1,D0               ; shift right by index → target bit in bit0
02:0002AB90 02000001        	  1872:     andi.b  #1,D0               ; isolate bit0
02:0002AB94 4E75            	  1873:     rts
                            	  1874: .cr1_overflow:
02:0002AB96 7000            	  1875:     moveq   #0,D0
02:0002AB98 4E75            	  1876:     rts
                            	  1877: 
                            	  1878: ;------------------------------------------------------------------------------
                            	  1879: ; _ctrl_read_2 — $4017 read: controller 2 / frame counter.
                            	  1880: ; Return 0.
                            	  1881: ;------------------------------------------------------------------------------
                            	  1882: _ctrl_read_2:
02:0002AB9A 7000            	  1883:     moveq   #0,D0
02:0002AB9C 4E75            	  1884:     rts
                            	  1885: 
                            	  1886: ;==============================================================================
                            	  1887: ; SRAM helpers (Phase 9.7)
                            	  1888: ;==============================================================================
                            	  1889: ;
                            	  1890: ; Genesis cartridges declare battery-backed SRAM in the ROM header at
                            	  1891: ; $1B0-$1BB.  We declare a 4 KB odd-byte SRAM region at $200001-$203FFF
                            	  1892: ; (genesis_shell.asm).  In gpgx and on real Mega Everdrive flashcarts the
                            	  1893: ; cart area at $200000 is shared between ROM and SRAM; writing $01 to the
                            	  1894: ; mapper port at $A130F1 swaps SRAM in.  Writing $00 swaps ROM back.
                            	  1895: ;
                            	  1896: ; Logical SRAM offset N (0 .. $1FFF) maps to bus address $200001 + (N << 1):
                            	  1897: ; only the odd byte of each word is wired up, hence the 8 KB cart-address
                            	  1898: ; window for 4 KB of usable storage.
                            	  1899: ;
                            	  1900: ; Helpers leave the mapping in the SRAM-enabled state after _sram_enable so
                            	  1901: ; the save-slot read/write helpers in 9.8 don't have to toggle the port on
                            	  1902: ; every byte.  Boot calls _sram_enable once from EntryPoint.
                            	  1903: ;------------------------------------------------------------------------------
                            	  1904: 
                            	  1905: SRAM_PORT       equ $A130F1
                            	  1906: SRAM_BASE_ODD   equ $200001
                            	  1907: 
                            	  1908: ;------------------------------------------------------------------------------
                            	  1909: ; P31: FileBChecksums — relocated from ROM code label to writable work RAM.
                            	  1910: ;
                            	  1911: ; On NES, this was a RAM variable holding 6 bytes (3 slots × 2-byte checksum).
                            	  1912: ; The transpiler incorrectly placed it as a code label inside z_01.asm, which
                            	  1913: ; maps to ROM on Genesis.  All writes silently fail on real hardware, breaking
                            	  1914: ; the File B → File A copy chain (checksums never match on re-read).
                            	  1915: ;
                            	  1916: ; $FF1200 is in the NES RAM mirror range ($0800-$1FFF) which is valid writable
                            	  1917: ; work RAM on Genesis but unused by any NES game code.
                            	  1918: ;------------------------------------------------------------------------------
                            	  1919: FileBChecksums  equ $00FF1200
                            	  1920: 
                            	  1921: ;------------------------------------------------------------------------------
                            	  1922: ; _sram_enable — switch cart area to SRAM mapping.  Clobbers nothing.
                            	  1923: ;------------------------------------------------------------------------------
                            	  1924: _sram_enable:
02:0002AB9E 13FC000100A130F1	  1925:     move.b  #$01,(SRAM_PORT).l
02:0002ABA6 4E75            	  1926:     rts
                            	  1927: 
                            	  1928: ;------------------------------------------------------------------------------
                            	  1929: ; _sram_disable — switch cart area back to ROM.  Used by tooling only;
                            	  1930: ; gameplay leaves SRAM mapped in continuously.
                            	  1931: ;------------------------------------------------------------------------------
                            	  1932: _sram_disable:
02:0002ABA8 13FC000000A130F1	  1933:     move.b  #$00,(SRAM_PORT).l
02:0002ABB0 4E75            	  1934:     rts
                            	  1935: 
                            	  1936: ;------------------------------------------------------------------------------
                            	  1937: ; _sram_read_byte — read one byte from logical SRAM offset.
                            	  1938: ; In:  D0.w = offset (0 .. $1FFF)
                            	  1939: ; Out: D0.b = byte
                            	  1940: ;------------------------------------------------------------------------------
                            	  1941: _sram_read_byte:
02:0002ABB2 48E70080        	  1942:     movem.l A0,-(SP)
02:0002ABB6 028000001FFF    	  1943:     andi.l  #$00001FFF,D0
02:0002ABBC D080            	  1944:     add.l   D0,D0                       ; offset *= 2 (odd-byte stride)
02:0002ABBE 207C00200001    	  1945:     movea.l #SRAM_BASE_ODD,A0
02:0002ABC4 10300800        	  1946:     move.b  (A0,D0.L),D0
02:0002ABC8 205F            	  1947:     movem.l (SP)+,A0
02:0002ABCA 4E75            	  1948:     rts
                            	  1949: 
                            	  1950: ;------------------------------------------------------------------------------
                            	  1951: ; _sram_write_byte — write one byte to logical SRAM offset.
                            	  1952: ; In:  D0.w = offset (0 .. $1FFF)
                            	  1953: ;      D1.b = byte to store
                            	  1954: ;------------------------------------------------------------------------------
                            	  1955: _sram_write_byte:
02:0002ABCC 48E78080        	  1956:     movem.l A0/D0,-(SP)
02:0002ABD0 028000001FFF    	  1957:     andi.l  #$00001FFF,D0
02:0002ABD6 D080            	  1958:     add.l   D0,D0                       ; offset *= 2 (odd-byte stride)
02:0002ABD8 207C00200001    	  1959:     movea.l #SRAM_BASE_ODD,A0
02:0002ABDE 11810800        	  1960:     move.b  D1,(A0,D0.L)
02:0002ABE2 4CDF0101        	  1961:     movem.l (SP)+,A0/D0
02:0002ABE6 4E75            	  1962:     rts
                            	  1963: 
                            	  1964: ;------------------------------------------------------------------------------
                            	  1965: ; Phase 9.8 — bulk save-slot copy helpers.
                            	  1966: ;
                            	  1967: ; NES Zelda's three save slots live at NES $6000-$67FF (2 KB), which the
                            	  1968: ; shell mirrors at work RAM $FF6000-$FF67FF.  z_02 reads/writes go to that
                            	  1969: ; mirror via NES_SRAM equ $FF6000.  To make saves persist across power
                            	  1970: ; cycles we copy:
                            	  1971: ;   _sram_load_save_slots    cart SRAM → mirror   (called once at boot)
                            	  1972: ;   _sram_commit_save_slots  mirror   → cart SRAM (called from save funnel)
                            	  1973: ;
                            	  1974: ; Cart SRAM is odd-byte at $200001 with stride 2; logical offset N (0..$7FF)
                            	  1975: ; lands at bus $200001 + N*2.
                            	  1976: ;
                            	  1977: ; Both helpers preserve all caller registers.
                            	  1978: ;------------------------------------------------------------------------------
                            	  1979: _sram_load_save_slots:
02:0002ABE8 48E7C0C0        	  1980:     movem.l D0/D1/A0/A1,-(SP)
02:0002ABEC 207C00FF6000    	  1981:     movea.l #$00FF6000,A0               ; mirror destination
02:0002ABF2 227C00200001    	  1982:     movea.l #SRAM_BASE_ODD,A1           ; cart SRAM source ($200001)
02:0002ABF8 323C07FF        	  1983:     move.w  #$07FF,D1                   ; 2048 bytes - 1
                            	  1984: .lsl_loop:
02:0002ABFC 1011            	  1985:     move.b  (A1),D0
02:0002ABFE 10C0            	  1986:     move.b  D0,(A0)+
02:0002AC00 5489            	  1987:     addq.l  #2,A1                       ; advance odd-byte stride
02:0002AC02 51C9FFF8        	  1988:     dbra    D1,.lsl_loop
                            	  1989:     ; T36: Zero-fill the remainder of the NES SRAM window ($FF6800..$FF7FFF).
                            	  1990:     ; NES has 8 KB of SRAM at $6000-$7FFF but Zelda's save-slots only occupy
                            	  1991:     ; the first 2 KB ($6000-$67FF).  z_05 AssignObjSpawnPositions reads
                            	  1992:     ; SRAM[$08FE+$00EB] which can land past offset $7FF (e.g. $FF6975 for
                            	  1993:     ; OW room $77).  On NES those bytes read 0 (unmapped or cleared by
                            	  1994:     ; ROM init).  Without this zero-fill, the read hits work-RAM residue
                            	  1995:     ; and corrupts the cave-dweller type calculation ($0350 := $6A+idx),
                            	  1996:     ; spawning a phantom cave-person that halts Link via $00AC=$40.
                            	  1997:     ; A0 already points at $FF6800 after the slot copy.
02:0002AC06 323C17FF        	  1998:     move.w  #$17FF,D1                   ; 6144 bytes - 1 ($6800..$7FFF)
02:0002AC0A 7000            	  1999:     moveq   #0,D0
                            	  2000: .lsl_zero:
02:0002AC0C 10C0            	  2001:     move.b  D0,(A0)+
02:0002AC0E 51C9FFFC        	  2002:     dbra    D1,.lsl_zero
02:0002AC12 4CDF0303        	  2003:     movem.l (SP)+,D0/D1/A0/A1
02:0002AC16 4E75            	  2004:     rts
                            	  2005: 
                            	  2006: _sram_commit_save_slots:
02:0002AC18 48E7C0C0        	  2007:     movem.l D0/D1/A0/A1,-(SP)
02:0002AC1C 207C00FF6000    	  2008:     movea.l #$00FF6000,A0               ; mirror source
02:0002AC22 227C00200001    	  2009:     movea.l #SRAM_BASE_ODD,A1           ; cart SRAM destination
02:0002AC28 323C07FF        	  2010:     move.w  #$07FF,D1                   ; 2048 bytes - 1
                            	  2011: .csl_loop:
02:0002AC2C 1018            	  2012:     move.b  (A0)+,D0
02:0002AC2E 1280            	  2013:     move.b  D0,(A1)
02:0002AC30 5489            	  2014:     addq.l  #2,A1
02:0002AC32 51C9FFF8        	  2015:     dbra    D1,.csl_loop
02:0002AC36 4CDF0303        	  2016:     movem.l (SP)+,D0/D1/A0/A1
02:0002AC3A 4E75            	  2017:     rts
                            	  2018: 
                            	  2019: ;==============================================================================
                            	  2020: ; OAM DMA
                            	  2021: ;==============================================================================
                            	  2022: 
                            	  2023: ;------------------------------------------------------------------------------
                            	  2024: ; _oam_dma — $4014 write: OAM DMA transfer.
                            	  2025: ;
                            	  2026: ; On NES, writing page number P to $4014 copies 256 bytes from CPU page P
                            	  2027: ; ($PP00–$PPFF) to OAM.  Zelda writes #$02, meaning copy from $0200–$02FF.
                            	  2028: ; NES $0200–$02FF = Genesis $FF0200–$FF02FF.
                            	  2029: ;
                            	  2030: ; T23: Convert 64 NES OAM entries → 64 Genesis SAT entries, write to VRAM $D800.
                            	  2031: ;
                            	  2032: ; NES OAM entry layout (4 bytes, address is OAM byte index):
                            	  2033: ;   [0] Y position (sprite top − 1; visible on scanline Y+1)
                            	  2034: ;   [1] Tile index (0–255, pattern table determined by PPUCTRL bit 3)
                            	  2035: ;   [2] Attribute: bit7=Vflip, bit6=Hflip, bit5=behind-BG, bits1:0=sprite palette
                            	  2036: ;   [3] X position (sprite left edge, 0–255)
                            	  2037: ;
                            	  2038: ; Genesis SAT entry layout (8 bytes at VRAM $D800 + sprite*8):
                            	  2039: ;   Word 0 [bits 8:0]: Y position (=NES_Y+129 for 240-line; 128=top of screen)
                            	  2040: ;   Word 1 [bits 11:8]: size (00=8×8 px); [bits 6:0]: link to next sprite index
                            	  2041: ;   Word 2: tile word → bit15=priority, bits14:13=palette, bit12=Vflip, bit11=Hflip,
                            	  2042: ;                        bits10:0=tile index
                            	  2043: ;   Word 3 [bits 8:0]: X position (=NES_X+128; 128=left of screen)
                            	  2044: ;
                            	  2045: ; Sprite palette mapping: NES sprite palette 0–3 → Genesis palette 0–3 directly.
                            	  2046: ;   (T25 will map NES sprite palettes to CRAM entries 32–63 = Genesis palettes 2–3.)
                            	  2047: ; Priority: bit15 = 1 (sprites always above background planes).
                            	  2048: ; Off-screen: NES Y+129 ≥ 368 means off-screen naturally; no special case needed.
                            	  2049: ;------------------------------------------------------------------------------
                            	  2050: _oam_dma:
                            	  2051:     ifne CHR_EXPANSION_ENABLED
02:0002AC3C 48E7FFE0        	  2052:     movem.l D0-D7/A0-A2,-(SP)
                            	  2053:     else
                            	  2054:     movem.l D0-D7/A0/A2,-(SP)
                            	  2055:     endc
                            	  2056: 
                            	  2057:     ; VSRAM scroll is now driven by _apply_genesis_scroll in IsrNmi.
                            	  2058:     ; The old static 8px bias has been removed.
                            	  2059: 
                            	  2060:     ; Phase 1 (HW adoption): write into SAT_SHADOW bank instead of VDP data
                            	  2061:     ; port.  DMA from the same bank happens at the top of the NEXT frame's
                            	  2062:     ; VBlankISR via _oam_dma_flush.  One-frame OAM display latency.
02:0002AC40 45F900FF2000    	  2063:     lea     (SAT_SHADOW_A).l,A2
02:0002AC46 4A3900FF2400    	  2064:     tst.b   (SAT_ACTIVE_BANK).l
02:0002AC4C 6706            	  2065:     beq.s   .sat_bank_picked
02:0002AC4E 45F900FF2200    	  2066:     lea     (SAT_SHADOW_B).l,A2
                            	  2067: .sat_bank_picked:
                            	  2068: 
02:0002AC54 41F900FF0200    	  2069:     lea     (NES_RAM_BASE+$0200).l,A0  ; A0 → NES OAM buffer ($FF0200)
02:0002AC5A 7E3F            	  2070:     moveq   #63,D7                     ; loop: 64 sprites (dbra counts 63→0)
02:0002AC5C 7C00            	  2071:     moveq   #0,D6                      ; D6 = current sprite index (0..63)
                            	  2072:     ; V64 gap compensation: when the display wraps through the 32px gap
                            	  2073:     ; at pixels 480-511, BG content below the gap is shifted 32px down.
                            	  2074:     ; Compute the Genesis Y threshold: sprites at or below this line need
                            	  2075:     ; +32 to match their shifted BG text.  Store in D6 upper word (0=no gap).
02:0002AC5E 3A3900FF0838    	  2076:     move.w  (ACTIVE_EVENT_VSRAM).l,D5
02:0002AC64 064500E0        	  2077:     addi.w  #224,D5
02:0002AC68 0C450200        	  2078:     cmpi.w  #512,D5
02:0002AC6C 6310            	  2079:     bls.s   .oam_no_gap_setup          ; display doesn't wrap through gap
02:0002AC6E 3A3C0260        	  2080:     move.w  #608,D5                    ; 608 = 480 (gap start) + 128 (Y origin)
02:0002AC72 9A7900FF0838    	  2081:     sub.w   (ACTIVE_EVENT_VSRAM).l,D5  ; D5 = gap threshold in Genesis Y
02:0002AC78 4846            	  2082:     swap    D6
02:0002AC7A 3C05            	  2083:     move.w  D5,D6
02:0002AC7C 4846            	  2084:     swap    D6
                            	  2085: .oam_no_gap_setup:
                            	  2086: 
                            	  2087: .oam_loop:
                            	  2088:     ; ── Read 4 NES OAM bytes ────────────────────────────�
02:0002AC7E 7000            	  2089:     moveq   #0,D0
02:0002AC80 1018            	  2090:     move.b  (A0)+,D0            ; D0.w = NES Y (sprite top − 1)
02:0002AC82 7200            	  2091:     moveq   #0,D1
02:0002AC84 1218            	  2092:     move.b  (A0)+,D1            ; D1.w = tile index
02:0002AC86 7400            	  2093:     moveq   #0,D2
02:0002AC88 1418            	  2094:     move.b  (A0)+,D2            ; D2.w = attribute byte
02:0002AC8A 7600            	  2095:     moveq   #0,D3
02:0002AC8C 1618            	  2096:     move.b  (A0)+,D3            ; D3.w = NES X
                            	  2097: 
                            	  2098:     ; ── Word 0: Genesis Y ─────────────────────────────�
                            	  2099:     ; NES sprite is visible on scanline (NES_Y + 1).
                            	  2100:     ; Genesis 240-line: screen line 0 is at Y=128 → Genesis Y = 128 + screen_line
                            	  2101:     ;   = 128 + (NES_Y + 1) = NES_Y + 129
                            	  2102:     ; Sprites with NES_Y ≥ 239 produce Genesis Y ≥ 368 which is naturally off-screen.
02:0002AC8E 3800            	  2103:     move.w  D0,D4
02:0002AC90 06440081        	  2104:     addi.w  #129,D4
                            	  2105:     ; Phase 12: _ags_compute_stage adds +8 to VSRAM for overscan in ALL
                            	  2106:     ; modes.  This shifts the BG up 8px.  Sprites must compensate with a
                            	  2107:     ; matching -8 Y lift, otherwise they appear 8px too low relative to
                            	  2108:     ; background text/tiles.  Previously gated to Mode 0 only (Diary #26),
                            	  2109:     ; but fs2_probe confirmed VSRAM=8 during file-select, proving the lift
                            	  2110:     ; must be unconditional.
02:0002AC94 0C000008        	  2111:     cmpi.b  #8,D0
02:0002AC98 6502            	  2112:     bcs.s   .oam_gap_check          ; NES Y < 8 → skip lift (top-edge)
02:0002AC9A 5144            	  2113:     subi.w  #8,D4
                            	  2114: .oam_gap_check:
02:0002AC9C 4846            	  2115:     swap    D6                      ; access gap threshold from upper word
02:0002AC9E 4A46            	  2116:     tst.w   D6
02:0002ACA0 6712            	  2117:     beq.s   .oam_gap_done           ; 0 = no gap visible
                            	  2118:     ; Gradual ramp: offset = clamp(sprite_Y - gap_top + 1, 0, 32).
                            	  2119:     ; Sprites well above the gap get 0 (untouched); sprites crossing the gap
                            	  2120:     ; boundary ramp in at 1px/frame up to a max +32 shift to match the shifted
                            	  2121:     ; BG below the V64 dead zone.  Avoids the single-frame 32px teleport that
                            	  2122:     ; occurred with a hard threshold.  D0 is scratch here — it's reloaded at
                            	  2123:     ; the top of the next .oam_loop iteration.
02:0002ACA2 3004            	  2124:     move.w  D4,D0                   ; D0 = adjusted sprite Y
02:0002ACA4 9046            	  2125:     sub.w   D6,D0                   ; D0 = Y - gap_top
02:0002ACA6 5240            	  2126:     addq.w  #1,D0                   ; D0 = Y - gap_top + 1
02:0002ACA8 6F0A            	  2127:     ble.s   .oam_gap_done           ; <= 0: sprite above gap, no offset
02:0002ACAA 0C400020        	  2128:     cmpi.w  #32,D0
02:0002ACAE 6302            	  2129:     bls.s   .oam_gap_apply
02:0002ACB0 7020            	  2130:     moveq   #32,D0                  ; cap ramp at full 32px shift
                            	  2131: .oam_gap_apply:
02:0002ACB2 D840            	  2132:     add.w   D0,D4                   ; apply gradual offset
                            	  2133: .oam_gap_done:
02:0002ACB4 4846            	  2134:     swap    D6                      ; restore sprite index in low word
                            	  2135: .oam_write_y:
02:0002ACB6 34C4            	  2136:     move.w  D4,(A2)+                ; Phase 1: SAT_SHADOW write (was VDP_DATA)
                            	  2137: 
                            	  2138:     ; ── Word 1: size | link ────────────────────────────�
                            	  2139:     ; Link field: chain sprites 0→1→2→...→63→0
02:0002ACB8 3806            	  2140:     move.w  D6,D4
02:0002ACBA 5244            	  2141:     addq.w  #1,D4               ; D4 = this_sprite_index + 1
02:0002ACBC 0C440040        	  2142:     cmpi.w  #64,D4              ; is this the last sprite?
02:0002ACC0 6602            	  2143:     bne     .write_link
02:0002ACC2 7800            	  2144:     moveq   #0,D4               ; yes → link = 0 (terminate list)
                            	  2145: .write_link:
                            	  2146:     ; Size: check PPUCTRL bit 5 for 8×16 sprite mode
                            	  2147:     ; Genesis SAT word 1: [11:10]=H-size, [9:8]=V-size, [6:0]=link
02:0002ACC4 0839000500FF0804	  2148:     btst    #5,(PPU_CTRL).l
02:0002ACCC 6704            	  2149:     beq.s   .oam_size_done
02:0002ACCE 00440100        	  2150:     ori.w   #$0100,D4           ; V-size = 2 (8×16: two 8×8 cells stacked)
                            	  2151: .oam_size_done:
02:0002ACD2 34C4            	  2152:     move.w  D4,(A2)+            ; Phase 1: SAT_SHADOW write size | link
                            	  2153: 
                            	  2154:     ; ── Word 2: tile word (priority | palette | Vflip | Hflip | tile) ────
                            	  2155:     ; Compute Genesis tile index based on sprite size mode
02:0002ACD4 0839000500FF0804	  2156:     btst    #5,(PPU_CTRL).l
02:0002ACDC 6712            	  2157:     beq.s   .oam_8x8
                            	  2158:     ; 8×16 mode: tile byte bit 0 = pattern table, bits 7:1 = tile pair
02:0002ACDE 3A01            	  2159:     move.w  D1,D5
02:0002ACE0 02450001        	  2160:     andi.w  #$0001,D5           ; pattern table bit
02:0002ACE4 E14D            	  2161:     lsl.w   #8,D5               ; $0000 or $0100
02:0002ACE6 3801            	  2162:     move.w  D1,D4
02:0002ACE8 024400FE        	  2163:     andi.w  #$00FE,D4           ; tile pair (even tile number)
02:0002ACEC 8A44            	  2164:     or.w    D4,D5               ; Genesis tile index
02:0002ACEE 6014            	  2165:     bra.s   .oam_have_tile
                            	  2166: .oam_8x8:
                            	  2167:     ; 8×8 mode: check PPUCTRL bit 3 for sprite pattern table
02:0002ACF0 3A01            	  2168:     move.w  D1,D5
02:0002ACF2 024500FF        	  2169:     andi.w  #$00FF,D5
02:0002ACF6 0839000300FF0804	  2170:     btst    #3,(PPU_CTRL).l
02:0002ACFE 6704            	  2171:     beq.s   .oam_have_tile
02:0002AD00 00450100        	  2172:     ori.w   #$0100,D5           ; pattern table $1000 → tile +$100
                            	  2173: .oam_have_tile:
                            	  2174:     ifne CHR_EXPANSION_ENABLED
                            	  2175:     ; T-CHR S9 v8: NES sprite sub-palettes packed into UNUSED TAIL SLOTS of BG
                            	  2176:     ; palettes — sub-pal 0/1/2 → PAL0 (biased to slots 4/8/12), sub-pal 3 → PAL1
                            	  2177:     ; (biased to slot 4).  BG palettes themselves untouched.  CHR tiles live in
                            	  2178:     ; copy N (0..3) at VRAM $0000/$4000/$6000/$8000.
02:0002AD04 3802            	  2179:     move.w  D2,D4
02:0002AD06 02440003        	  2180:     andi.w  #$0003,D4           ; NES sub-palette (0..3)
02:0002AD0A D844            	  2181:     add.w   D4,D4               ; word index
02:0002AD0C 43FA0046        	  2182:     lea     (.oam_tile_bias_tbl,PC),A1
02:0002AD10 DA714000        	  2183:     add.w   (A1,D4.W),D5        ; apply per-copy tile bias
02:0002AD14 024507FF        	  2184:     andi.w  #$07FF,D5           ; keep bits 10:0 only
                            	  2185:     ; Attempt 5g: honor NES sprite attr bit 5 (behind background).  When set,
                            	  2186:     ; leave bit 15 clear so Plane A (now high priority) renders in front.
02:0002AD18 08020005        	  2187:     btst    #5,D2
02:0002AD1C 6604            	  2188:     bne.s   .spr_low_prio_che
02:0002AD1E 00458000        	  2189:     ori.w   #$8000,D5           ; bit 15 = high priority
                            	  2190: .spr_low_prio_che:
02:0002AD22 43FA0038        	  2191:     lea     (.oam_pal_bits_tbl,PC),A1
02:0002AD26 8A714000        	  2192:     or.w    (A1,D4.W),D5        ; OR in palette bits (PAL0/PAL0/PAL0/PAL1)
                            	  2193:     else
                            	  2194:     andi.w  #$07FF,D5           ; keep bits 10:0 only
                            	  2195:     ; Attempt 5g: honor NES sprite attr bit 5 (behind background).  When set,
                            	  2196:     ; leave bit 15 clear so Plane A (now high priority) renders in front.
                            	  2197:     btst    #5,D2
                            	  2198:     bne.s   .spr_low_prio_noche
                            	  2199:     ori.w   #$8000,D5           ; bit 15 = high priority (sprite over planes)
                            	  2200: .spr_low_prio_noche:
                            	  2201:     ; Palette: NES sprite attr[1:0] → Genesis bits[14:13], offset +2
                            	  2202:     move.w  D2,D4
                            	  2203:     andi.w  #$0003,D4           ; isolate NES sprite palette (0–3)
                            	  2204:     ori.w   #$0002,D4           ; offset: NES sprite pal 0,1→Genesis pal 2,3
                            	  2205:     andi.w  #$0003,D4           ; mask (0→2, 1→3, 2→2, 3→3)
                            	  2206:     lsl.w   #5,D4               ; shift left 5
                            	  2207:     lsl.w   #8,D4               ; shift left 8 more → total shift 13 → bits[14:13]
                            	  2208:     or.w    D4,D5               ; merge palette
                            	  2209:     endc
                            	  2210:     ; V-flip: NES attr bit 7 → Genesis tile word bit 12
02:0002AD2A 08020007        	  2211:     btst    #7,D2
02:0002AD2E 6704            	  2212:     beq     .no_vflip
02:0002AD30 00451000        	  2213:     ori.w   #$1000,D5           ; set bit 12
                            	  2214: .no_vflip:
                            	  2215:     ; H-flip: NES attr bit 6 → Genesis tile word bit 11
02:0002AD34 08020006        	  2216:     btst    #6,D2
02:0002AD38 6704            	  2217:     beq     .no_hflip
02:0002AD3A 00450800        	  2218:     ori.w   #$0800,D5           ; set bit 11
                            	  2219: .no_hflip:
02:0002AD3E 34C5            	  2220:     move.w  D5,(A2)+            ; Phase 1: SAT_SHADOW write tile word
                            	  2221: 
                            	  2222:     ; ── Word 3: Genesis X ─────────────────────────────�
                            	  2223:     ; Genesis 40-cell: screen column 0 is at X=128 → Genesis X = NES_X + 128
02:0002AD40 3803            	  2224:     move.w  D3,D4
02:0002AD42 06440080        	  2225:     addi.w  #128,D4
02:0002AD46 34C4            	  2226:     move.w  D4,(A2)+            ; Phase 1: SAT_SHADOW write X
                            	  2227: 
02:0002AD48 5246            	  2228:     addq.w  #1,D6               ; advance sprite index
02:0002AD4A 51CFFF32        	  2229:     dbra    D7,.oam_loop
                            	  2230:     ifne CHR_EXPANSION_ENABLED
02:0002AD4E 4CDF07FF        	  2231:     movem.l (SP)+,D0-D7/A0-A2
                            	  2232:     else
                            	  2233:     movem.l (SP)+,D0-D7/A0/A2
                            	  2234:     endc
02:0002AD52 4E75            	  2235:     rts
                            	  2236: 
                            	  2237:     ifne CHR_EXPANSION_ENABLED
                            	  2238: .oam_tile_bias_tbl:
02:0002AD54 0000            	  2239:     dc.w    0                   ; NES sub-pal 0 → shared bank A @ VRAM $0000
02:0002AD56 0200            	  2240:     dc.w    512                 ; NES sub-pal 1 → bank B @ VRAM $4000 (tile 512)
02:0002AD58 0400            	  2241:     dc.w    1024                ; NES sub-pal 2 → bank C @ VRAM $8000 (tile 1024)
02:0002AD5A 0000            	  2242:     dc.w    0                   ; NES sub-pal 3 → shared bank A @ VRAM $0000
                            	  2243: .oam_pal_bits_tbl:
02:0002AD5C 0000            	  2244:     dc.w    $0000               ; sub-pal 0 → PAL0 (bits 14:13 = 00)
02:0002AD5E 0000            	  2245:     dc.w    $0000               ; sub-pal 1 → PAL0
02:0002AD60 0000            	  2246:     dc.w    $0000               ; sub-pal 2 → PAL0
02:0002AD62 2000            	  2247:     dc.w    $2000               ; sub-pal 3 → PAL1 (bits 14:13 = 01)
                            	  2248:     endc
                            	  2249: 
                            	  2250: ;==============================================================================
                            	  2251: ; _oam_dma_flush — Phase 1: transfer previous-frame SAT_SHADOW bank via VDP
                            	  2252: ;   68k→VRAM DMA to sprite attribute table at $F800.
                            	  2253: ;
                            	  2254: ; Must be called at the TOP of VBlankISR (before IsrNmi).  IsrNmi can extend
                            	  2255: ; into active display past scanline 40, so scheduling the DMA at the tail of
                            	  2256: ; VBlankISR would miss vblank.  The DMA source is the bank CURRENTLY flagged
                            	  2257: ; by SAT_ACTIVE_BANK — that is, the bank the previous frame's _oam_dma just
                            	  2258: ; finished filling.  After DMA setup the flag flips so the new frame's
                            	  2259: ; _oam_dma writes the OTHER bank.
                            	  2260: ;
                            	  2261: ; DMA params:
                            	  2262: ;   Reg 19/20: length = 256 words ($0100)
                            	  2263: ;   Reg 21/22/23: source = SAT_SHADOW_A or SAT_SHADOW_B (word address / 2)
                            	  2264: ;   VDP cmd: $78000083 (VRAM write $F800 + CD5 DMA bit)
                            	  2265: ;
                            	  2266: ; No busy-poll needed: DMA is fire-and-forget from 68k RAM.  Next VDP access
                            	  2267: ; (later in VBlankISR) will stall briefly if transfer still in flight.
                            	  2268: ;==============================================================================
                            	  2269:     even
                            	  2270: _oam_dma_flush:
02:0002AD64 48E7C000        	  2271:     movem.l D0/D1,-(SP)
02:0002AD68 7000            	  2272:     moveq   #0,D0
02:0002AD6A 103900FF2400    	  2273:     move.b  (SAT_ACTIVE_BANK).l,D0
                            	  2274:     ; D0 = 0 → source = SAT_SHADOW_A; D0 = 1 → source = SAT_SHADOW_B
02:0002AD70 223C00FF2000    	  2275:     move.l  #SAT_SHADOW_A,D1
02:0002AD76 4A00            	  2276:     tst.b   D0
02:0002AD78 6706            	  2277:     beq.s   .oflush_src_ready
02:0002AD7A 223C00FF2200    	  2278:     move.l  #SAT_SHADOW_B,D1
                            	  2279: .oflush_src_ready:
                            	  2280:     ; Length: 256 words. Reg 19 = lo byte = $00, Reg 20 = hi byte = $01
02:0002AD80 33FC930000C00004	  2281:     move.w  #$9300,(VDP_CTRL).l   ; Reg 19: length lo = $00
02:0002AD88 33FC940100C00004	  2282:     move.w  #$9401,(VDP_CTRL).l   ; Reg 20: length hi = $01
                            	  2283:     ; Source addr in words: D1 >> 1
02:0002AD90 E289            	  2284:     lsr.l   #1,D1
                            	  2285:     ; Reg 21 = source[7:0]
02:0002AD92 3001            	  2286:     move.w  D1,D0
02:0002AD94 024000FF        	  2287:     andi.w  #$00FF,D0
02:0002AD98 00409500        	  2288:     ori.w   #$9500,D0
02:0002AD9C 33C000C00004    	  2289:     move.w  D0,(VDP_CTRL).l
                            	  2290:     ; Reg 22 = source[15:8]
02:0002ADA2 2001            	  2291:     move.l  D1,D0
02:0002ADA4 E088            	  2292:     lsr.l   #8,D0
02:0002ADA6 024000FF        	  2293:     andi.w  #$00FF,D0
02:0002ADAA 00409600        	  2294:     ori.w   #$9600,D0
02:0002ADAE 33C000C00004    	  2295:     move.w  D0,(VDP_CTRL).l
                            	  2296:     ; Reg 23 = source[22:16] with bit 7 clear (68k→VRAM mode)
02:0002ADB4 2001            	  2297:     move.l  D1,D0
02:0002ADB6 E088            	  2298:     lsr.l   #8,D0
02:0002ADB8 E088            	  2299:     lsr.l   #8,D0
02:0002ADBA 0240007F        	  2300:     andi.w  #$007F,D0
02:0002ADBE 00409700        	  2301:     ori.w   #$9700,D0
02:0002ADC2 33C000C00004    	  2302:     move.w  D0,(VDP_CTRL).l
                            	  2303:     ; VDP command: VRAM write $F800 + DMA trigger bit
02:0002ADC8 23FC7800008300C0	  2304:     move.l  #$78000083,(VDP_CTRL).l
02:0002ADD0 0004
                            	  2305:     ; Flip active bank: bank just DMA'd becomes "previous"; other bank becomes active
02:0002ADD2 0A39000100FF2400	  2306:     eori.b  #1,(SAT_ACTIVE_BANK).l
02:0002ADDA 4CDF0003        	  2307:     movem.l (SP)+,D0/D1
02:0002ADDE 4E75            	  2308:     rts
                            	  2309: 
                            	  2310: ;==============================================================================
                            	  2311: ; MMC1 mapper writes ($8000 / $A000 / $C000 / $E000)
                            	  2312: ;==============================================================================
                            	  2313: ;
                            	  2314: ; T11b: real MMC1 shift-register decoder.
                            	  2315: ;
                            	  2316: ; Protocol: five consecutive writes to a register address.  Each write
                            	  2317: ; contributes bit 0 (LSB first) to the 5-bit shift accumulator.  Writing
                            	  2318: ; any byte with bit 7 set resets the shift register immediately.  On the
                            	  2319: ; 5th valid write the accumulated 5-bit value is stored in the corresponding
                            	  2320: ; MMC1 state register and the accumulator resets.
                            	  2321: ;
                            	  2322: ; MMC1 register map (Genesis RAM, $FF0812–$FF0815):
                            	  2323: ;   $8000 writes → MMC1_CTRL  (mirroring, PRG mode, CHR mode)
                            	  2324: ;   $A000 writes → MMC1_CHR0  (CHR bank 0)
                            	  2325: ;   $C000 writes → MMC1_CHR1  (CHR bank 1)
                            	  2326: ;   $E000 writes → MMC1_PRG   (PRG bank + RAM enable)
                            	  2327: ;
                            	  2328: ; Register contract:
                            	  2329: ;   D0.b = write value (NES accumulator, from transpiler)
                            	  2330: ;   D1-D3 saved/restored  (D3 = NES Y index — MUST be preserved)
                            	  2331: ;   D3 repurposed internally as target register offset (0-3 from MMC1_CTRL)
                            	  2332: ;   D1 = bit count (work), D2 = bit value (work)
                            	  2333: ;
                            	  2334: ; Expected state at LoopForever (T11b probe):
                            	  2335: ;   MMC1_CTRL = $0F  (IsrReset → SetMMC1Control($0F))
                            	  2336: ;   MMC1_PRG  = $05  (RunGame  → SwitchBank(5))
                            	  2337: ;   MMC1_SHIFT = $00, MMC1_COUNT = $00  (reset after each 5th write)
                            	  2338: ;==============================================================================
                            	  2339: 
                            	  2340: _mmc1_write_8000:
02:0002ADE0 48E77000        	  2341:     movem.l D1-D3,-(SP)
02:0002ADE4 7600            	  2342:     moveq   #0,D3                   ; CTRL is at offset 0 from MMC1_CTRL
02:0002ADE6 6016            	  2343:     bra.s   _mmc1_common
                            	  2344: 
                            	  2345: _mmc1_write_a000:
02:0002ADE8 48E77000        	  2346:     movem.l D1-D3,-(SP)
02:0002ADEC 7601            	  2347:     moveq   #1,D3                   ; CHR0 is at offset 1
02:0002ADEE 600E            	  2348:     bra.s   _mmc1_common
                            	  2349: 
                            	  2350: _mmc1_write_c000:
02:0002ADF0 48E77000        	  2351:     movem.l D1-D3,-(SP)
02:0002ADF4 7602            	  2352:     moveq   #2,D3                   ; CHR1 is at offset 2
02:0002ADF6 6006            	  2353:     bra.s   _mmc1_common
                            	  2354: 
                            	  2355: _mmc1_write_e000:
02:0002ADF8 48E77000        	  2356:     movem.l D1-D3,-(SP)
02:0002ADFC 7603            	  2357:     moveq   #3,D3                   ; PRG is at offset 3
                            	  2358:     ; fall through to _mmc1_common
                            	  2359: 
                            	  2360: _mmc1_common:
                            	  2361:     ; Check bit 7 — reset strobe
02:0002ADFE 08000007        	  2362:     btst    #7,D0
02:0002AE02 6712            	  2363:     beq.s   .no_reset
02:0002AE04 423900FF0810    	  2364:     clr.b   (MMC1_SHIFT).l
02:0002AE0A 423900FF0811    	  2365:     clr.b   (MMC1_COUNT).l
02:0002AE10 4CDF000E        	  2366:     movem.l (SP)+,D1-D3
02:0002AE14 4E75            	  2367:     rts
                            	  2368: 
                            	  2369: .no_reset:
                            	  2370:     ; Shift bit 0 of D0 into position MMC1_COUNT of the accumulator
02:0002AE16 123900FF0811    	  2371:     move.b  (MMC1_COUNT).l,D1      ; D1.b = current count (0–4)
02:0002AE1C 1400            	  2372:     move.b  D0,D2
02:0002AE1E 02020001        	  2373:     andi.b  #1,D2                   ; D2.b = bit 0 of write value
02:0002AE22 E32A            	  2374:     lsl.b   D1,D2                   ; D2.b = bit shifted to correct position
02:0002AE24 853900FF0810    	  2375:     or.b    D2,(MMC1_SHIFT).l       ; accumulate into shift register
                            	  2376: 
                            	  2377:     ; Increment count; check for completion
02:0002AE2A 523900FF0811    	  2378:     addq.b  #1,(MMC1_COUNT).l
02:0002AE30 0C39000500FF0811	  2379:     cmpi.b  #5,(MMC1_COUNT).l
02:0002AE38 6620            	  2380:     bne.s   .mmc1_done              ; not yet 5 bits — wait for more writes
                            	  2381: 
                            	  2382:     ; 5th write: copy 5-bit shift value to the target state register
02:0002AE3A 143900FF0810    	  2383:     move.b  (MMC1_SHIFT).l,D2
02:0002AE40 0202001F        	  2384:     andi.b  #$1F,D2                 ; mask to 5 bits
02:0002AE44 41F900FF0812    	  2385:     lea     (MMC1_CTRL).l,A0        ; A0 = base of MMC1_CTRL ($FF0812)
02:0002AE4A 11823000        	  2386:     move.b  D2,(A0,D3.w)            ; store at MMC1_CTRL + D3 offset
                            	  2387: 
                            	  2388:     ; T36 Stage H experiment: universal auto-refresh of the PRG bank
                            	  2389:     ; window on $E000 writes. REVERTED — incompatible with the existing
                            	  2390:     ; manual P33b/P33c pins (z_01/z_03/z_05/z_06) which deliberately
                            	  2391:     ; set _current_window_bank to a bank that differs from MMC1_PRG.
                            	  2392:     ; Auto-refresh undid every pin on the next MMC1 write, breaking
                            	  2393:     ; Link movement in mode $05 (walk_left never reached x=$40, cave
                            	  2394:     ; entry never triggered). Full evidence in
                            	  2395:     ; builds/reports/t36_mmc1_autorefresh_finding.md. Next attempt
                            	  2396:     ; should target specific cave-interior pointer sites with P33b-
                            	  2397:     ; style pins instead of a universal write-side refresh.
                            	  2398: 
                            	  2399:     ; Reset accumulator
02:0002AE4E 423900FF0810    	  2400:     clr.b   (MMC1_SHIFT).l
02:0002AE54 423900FF0811    	  2401:     clr.b   (MMC1_COUNT).l
                            	  2402: 
                            	  2403: .mmc1_done:
02:0002AE5A 4CDF000E        	  2404:     movem.l (SP)+,D1-D3
02:0002AE5E 4E75            	  2405:     rts
                            	  2406: 
                            	  2407: ;==============================================================================
                            	  2408: ; APU writes ($4000–$4017)
                            	  2409: ;
                            	  2410: ; Most NES APU register writes are no-ops — the native M68K music player in
                            	  2411: ; audio_driver.asm drives YM2612/PSG directly from song scripts and ignores
                            	  2412: ; channel state, so every stub here is a plain rts.
                            	  2413: ;==============================================================================
                            	  2414: 
                            	  2415: _apu_write_4000:
                            	  2416: _apu_write_4001:
                            	  2417: _apu_write_4002:
                            	  2418: _apu_write_4003:
                            	  2419: _apu_write_4004:
                            	  2420: _apu_write_4005:
                            	  2421: _apu_write_4006:
                            	  2422: _apu_write_4007:
                            	  2423: _apu_write_4008:
                            	  2424: _apu_write_400a:
                            	  2425: _apu_write_400b:
                            	  2426: _apu_write_4011:
                            	  2427: _apu_write_4016:
                            	  2428: _apu_write_4017:
02:0002AE60 4E75            	  2429:     rts
                            	  2430: 
                            	  2431: ; Noise-channel APU writes. Zelda's SFX engine (PlaySfxNote) writes
                            	  2432: ; $400E (period), $400C (volume + const-vol bit), $400F (length trigger)
                            	  2433: ; per sfx-tick. We cache E+C and emit PSG on the F trigger. Arbitration
                            	  2434: ; is via $FF0606 (Effect) -- the music driver skips PSG noise writes
                            	  2435: ; when $0606 != 0, so SFX owns the channel for the duration of the hit.
                            	  2436: _apu_write_400c:
02:0002AE62 13C000FFE029    	  2437:     move.b  D0,(m_sfx_vol).l
02:0002AE68 4E75            	  2438:     rts
                            	  2439: 
                            	  2440: _apu_write_400e:
02:0002AE6A 13C000FFE02A    	  2441:     move.b  D0,(m_sfx_ctrl_raw).l
02:0002AE70 4E75            	  2442:     rts
                            	  2443: 
                            	  2444: _apu_write_400f:
02:0002AE72 4A3900FF0606    	  2445:     tst.b   ($00FF0606).l                  ; SFX active on game side?
02:0002AE78 6758            	  2446:     beq.s   .f_skip
02:0002AE7A 48E7C000        	  2447:     movem.l D0-D1,-(SP)
                            	  2448:     ; PSG noise control byte from cached $400E (low 4 bits = period idx).
                            	  2449:     ; Map NES 16-period index to 4-bucket PSG noise control ($E4..$E7).
02:0002AE7E 103900FFE02A    	  2450:     move.b  (m_sfx_ctrl_raw).l,D0
02:0002AE84 0200000F        	  2451:     andi.b  #$0F,D0
02:0002AE88 0C000004        	  2452:     cmpi.b  #$04,D0
02:0002AE8C 6512            	  2453:     bcs.s   .pg_short
02:0002AE8E 0C000008        	  2454:     cmpi.b  #$08,D0
02:0002AE92 6512            	  2455:     bcs.s   .pg_mid
02:0002AE94 0C00000C        	  2456:     cmpi.b  #$0C,D0
02:0002AE98 6512            	  2457:     bcs.s   .pg_long
02:0002AE9A 103C00E7        	  2458:     move.b  #$E7,D0
02:0002AE9E 6010            	  2459:     bra.s   .pg_ready
                            	  2460: .pg_short:
02:0002AEA0 103C00E4        	  2461:     move.b  #$E4,D0
02:0002AEA4 600A            	  2462:     bra.s   .pg_ready
                            	  2463: .pg_mid:
02:0002AEA6 103C00E5        	  2464:     move.b  #$E5,D0
02:0002AEAA 6004            	  2465:     bra.s   .pg_ready
                            	  2466: .pg_long:
02:0002AEAC 103C00E6        	  2467:     move.b  #$E6,D0
                            	  2468: .pg_ready:
02:0002AEB0 13C000C00011    	  2469:     move.b  D0,(PSG_PORT).l                ; noise control ($Ex)
                            	  2470:     ; PSG attenuation from cached $400C (low 4 bits = volume nibble).
02:0002AEB6 103900FFE029    	  2471:     move.b  (m_sfx_vol).l,D0
02:0002AEBC 0200000F        	  2472:     andi.b  #$0F,D0
02:0002AEC0 0A00000F        	  2473:     eori.b  #$0F,D0                        ; NES 15=loud -> PSG 0=loud
02:0002AEC4 000000F0        	  2474:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:0002AEC8 13C000C00011    	  2475:     move.b  D0,(PSG_PORT).l
02:0002AECE 4CDF0003        	  2476:     movem.l (SP)+,D0-D1
                            	  2477: .f_skip:
02:0002AED2 4E75            	  2478:     rts
