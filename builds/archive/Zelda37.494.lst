                            	   739: 
                            	   740: ;==============================================================================
                            	   741: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   742: ;
                            	   743: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   744: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   745: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   746: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   747: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   748: ;
                            	   749: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   750: ;
                            	   751: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   752: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   753: ;==============================================================================
                            	   754:     ifne DEBUG_TELEPORT
                            	   755: _debug_teleport_check:
                            	   756:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   757:     tst.b   ($0010,A4)
                            	   758:     bne     .dtc_no
                            	   759:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   760:     cmpi.b  #$05,($0012,A4)
                            	   761:     bne     .dtc_no
                            	   762:     tst.b   ($0013,A4)
                            	   763:     bne     .dtc_no
                            	   764:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   765:     ;
                            	   766:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   767:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   768:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   769:     ; So the bit map is:
                            	   770:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   771:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   772:     move.b  ($00F8,A4),D1
                            	   773:     andi.b  #$0F,D1
                            	   774:     beq     .dtc_no
                            	   775:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   776:     moveq   #0,D0
                            	   777:     btst    #3,D1                   ; Up
                            	   778:     bne.s   .dtc_dir_set
                            	   779:     moveq   #1,D0
                            	   780:     btst    #2,D1                   ; Down
                            	   781:     bne.s   .dtc_dir_set
                            	   782:     moveq   #2,D0
                            	   783:     btst    #1,D1                   ; Left
                            	   784:     bne.s   .dtc_dir_set
                            	   785:     moveq   #3,D0                   ; Right (bit 0)
                            	   786: .dtc_dir_set:
                            	   787:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   788:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   789:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   790:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   791:     move.b  ($00EB,A4),D2
                            	   792:     move.b  D2,D3
                            	   793:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   794:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   795:     tst.b   D0
                            	   796:     bne.s   .dtc_not_up
                            	   797:     tst.b   D2
                            	   798:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   799:     bra.s   .dtc_apply
                            	   800: .dtc_not_up:
                            	   801:     cmpi.b  #1,D0
                            	   802:     bne.s   .dtc_not_down
                            	   803:     cmpi.b  #7,D2
                            	   804:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   805:     bra.s   .dtc_apply
                            	   806: .dtc_not_down:
                            	   807:     cmpi.b  #2,D0
                            	   808:     bne.s   .dtc_not_left
                            	   809:     tst.b   D3
                            	   810:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   811:     bra.s   .dtc_apply
                            	   812: .dtc_not_left:
                            	   813:     cmpi.b  #$0F,D3
                            	   814:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   815: .dtc_apply:
                            	   816:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   817:     lea     (NextRoomIdOffsets).l,A0
                            	   818:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   819:     move.b  ($00EB,A4),D0
                            	   820:     add.b   D1,D0
                            	   821:     move.b  D0,($00EB,A4)
                            	   822:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   823:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   824:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   825:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   826:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   827:     ; movement update doesn't immediately retrigger the edge.
                            	   828:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   829:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   830:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   831:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   832:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   833:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   834:     ; skip that setup.
                            	   835:     jsr     LayOutRoom
                            	   836:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   837:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   838:     ; kick that from here with arbitrary state causes crashes when the
                            	   839:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   840:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   841:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   842:     ; per target room.
                            	   843:     clr.b   ($00F8,A4)
                            	   844:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   845:                                          ; doesn't walk during sweep settle
                            	   846:     moveq   #1,D0
                            	   847:     rts
                            	   848: .dtc_edge:
                            	   849:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   850:     ; interpret it as "walk into wall" animation.
                            	   851:     clr.b   ($00F8,A4)
                            	   852:     clr.b   ($00FA,A4)
                            	   853:     moveq   #1,D0
                            	   854:     rts
                            	   855: .dtc_no:
                            	   856:     moveq   #0,D0
                            	   857:     rts
                            	   858:     endc
                            	   859: 
                            	   860: ;==============================================================================
                            	   861: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   862: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   863: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   864: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   865: ;==============================================================================
                            	   866:     ifne TURBO_LINK
                            	   867: _turbo_link_boost:
                            	   868:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   869:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   870:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   871:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:00049A82 4E75            	   872:     rts
                            	   873: _turbo_link_boost_disabled:
                            	   874:     ; OW gate
02:00049A84 4A2C0010        	   875:     tst.b   ($0010,A4)
02:00049A88 6670            	   876:     bne     .tlb_exit
                            	   877:     ; Mode 5 / Submode 0 only
02:00049A8A 0C2C00050012    	   878:     cmpi.b  #$05,($0012,A4)
02:00049A90 6668            	   879:     bne     .tlb_exit
02:00049A92 4A2C0013        	   880:     tst.b   ($0013,A4)
02:00049A96 6662            	   881:     bne     .tlb_exit
                            	   882:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:00049A98 122C00FA        	   883:     move.b  ($00FA,A4),D1
02:00049A9C 0201000F        	   884:     andi.b  #$0F,D1
02:00049AA0 6758            	   885:     beq     .tlb_exit
                            	   886:     ; Edge-safe clamps.
02:00049AA2 08010003        	   887:     btst    #3,D1                   ; Up (bit 3)
02:00049AA6 6710            	   888:     beq     .tlb_no_up
02:00049AA8 102C0084        	   889:     move.b  ($0084,A4),D0
02:00049AAC 0C000040        	   890:     cmpi.b  #$40,D0
02:00049AB0 6306            	   891:     bls     .tlb_no_up
02:00049AB2 5900            	   892:     subi.b  #4,D0
02:00049AB4 19400084        	   893:     move.b  D0,($0084,A4)
                            	   894: .tlb_no_up:
02:00049AB8 08010002        	   895:     btst    #2,D1                   ; Down (bit 2)
02:00049ABC 6710            	   896:     beq     .tlb_no_down
02:00049ABE 102C0084        	   897:     move.b  ($0084,A4),D0
02:00049AC2 0C0000D0        	   898:     cmpi.b  #$D0,D0
02:00049AC6 6406            	   899:     bcc     .tlb_no_down
02:00049AC8 5800            	   900:     addi.b  #4,D0
02:00049ACA 19400084        	   901:     move.b  D0,($0084,A4)
                            	   902: .tlb_no_down:
02:00049ACE 08010001        	   903:     btst    #1,D1                   ; Left (bit 1)
02:00049AD2 6710            	   904:     beq     .tlb_no_left
02:00049AD4 102C0070        	   905:     move.b  ($0070,A4),D0
02:00049AD8 0C00000A        	   906:     cmpi.b  #$0A,D0
02:00049ADC 6306            	   907:     bls     .tlb_no_left
02:00049ADE 5900            	   908:     subi.b  #4,D0
02:00049AE0 19400070        	   909:     move.b  D0,($0070,A4)
                            	   910: .tlb_no_left:
02:00049AE4 08010000        	   911:     btst    #0,D1                   ; Right (bit 0)
02:00049AE8 6710            	   912:     beq     .tlb_no_right
02:00049AEA 102C0070        	   913:     move.b  ($0070,A4),D0
02:00049AEE 0C0000E6        	   914:     cmpi.b  #$E6,D0
02:00049AF2 6406            	   915:     bcc     .tlb_no_right
02:00049AF4 5800            	   916:     addi.b  #4,D0
02:00049AF6 19400070        	   917:     move.b  D0,($0070,A4)
                            	   918: .tlb_no_right:
                            	   919: .tlb_exit:
02:00049AFA 4E75            	   920:     rts
                            	   921:     endc
