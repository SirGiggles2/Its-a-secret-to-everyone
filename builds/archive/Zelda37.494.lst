                            	   712: 
                            	   713: ;==============================================================================
                            	   714: ; Zelda translated code — generated by tools/transpile_6502.py --all --no-stubs
                            	   715: ;
                            	   716: ; z_07.asm is the NES fixed bank ($E000-$FFFF): IsrReset, IsrNmi, RunGame,
                            	   717: ; and ALL shared equates (NES RAM variables).  It must be included first.
                            	   718: ;
                            	   719: ; z_00–z_06 are the switchable PRG banks.  They carry no equate block in
                            	   720: ; --all mode (suppressed by transpiler to avoid vasm duplicate-symbol errors).
                            	   721: ; All cross-bank import stubs are also suppressed — every symbol resolves
                            	   722: ; directly by label across the flat Genesis ROM.
                            	   723: ;
                            	   724: ; vasm CWD is src/ (set by build.bat pushd), so paths are relative to src/.
                            	   725: ;==============================================================================
                            	   726:     ; All 8 banks included in ascending order (z_00 first so its definitions of
                            	   727:     ; multiply-exported symbols like Exit are canonical).  z_07 is included last
                            	   728:     ; so its cross-bank stubs (which are suppressed for globally-exported symbols)
                            	   729:     ; don't conflict with real definitions from z_00-z_06.
                            	   730:     ; Equates are only in z_07 (other banks omit them in --all mode).
                            	   731:     include "zelda_translated/z_00.asm"

Source: "zelda_translated\z_00.asm"
