                            	  5685: _anon_z05_122:
                            	  5686:     ; If the door command = 4 after incrementing it, then
                            	  5687:     ; it was 3 (close door). So:
                            	  5688:     ; 1. reset this door's flag
                            	  5689:     ; 2. remove it from the opened door mask
                            	  5690:     ; 3. reset the door command
                            	  5691:     ; 4. go lay out doors in the play area map
                            	  5692:     ;
02:0003FE5E 102C0054        	  5693:     move.b  ($0054,A4),D0
02:0003FE62 0C000004        	  5694:     cmpi.b  #$04,D0
02:0003FE66 6626            	  5695:     bne  _anon_z05_123
02:0003FE68 7400            	  5696:     moveq   #0,D2
02:0003FE6A 142C0009        	  5697:     move.b  ($0009,A4),D2
02:0003FE6E 6100DCE6        	  5698:     jsr     ResetDoorFlag
02:0003FE72 102C0055        	  5699:     move.b  ($0055,A4),D0
02:0003FE76 0A00000F        	  5700:     eori.b #$0F,D0
02:0003FE7A 122C00EE        	  5701:     move.b  ($00EE,A4),D1
02:0003FE7E C001            	  5702:     and.b  D1,D0
                            	  5703:     even
                            	  5704: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0003FE80 194000EE        	  5705:     move.b  D0,($00EE,A4)
                            	  5706:     even
                            	  5707: L_ResetDoorCmdAndLayOutDoors:
02:0003FE84 7000            	  5708:     moveq   #0,D0
02:0003FE86 19400054        	  5709:     move.b  D0,($0054,A4)
02:0003FE8A 6000FCD4        	  5710:     jmp     LayOutDoors
