                            	  1741: _anon_z04_42:
                            	  1742:     ; State 0.
                            	  1743:     ;
                            	  1744:     ; In state we determine whether to burst out of the ground.
                            	  1745:     ; If the long timer has not expired, then return.
                            	  1746:     ;
02:00038CC8 102C004D        	  1747:     move.b  ($004D,A4),D0
02:00038CCC 6674            	  1748:     bne  _L_z04_UpdateRedLeever_Exit
                            	  1749:     ; Only allow two red leevers at a time.
                            	  1750:     ;
02:00038CCE 102C0510        	  1751:     move.b  ($0510,A4),D0
02:00038CD2 0C000002        	  1752:     cmpi.b  #$02,D0
02:00038CD6 646A            	  1753:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1754:     ; Face in the same direction as Link.
                            	  1755:     ;
02:00038CD8 102C0098        	  1756:     move.b  ($0098,A4),D0
