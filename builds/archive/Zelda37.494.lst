                            	   740: ;==============================================================================
                            	   741: ; change_song — ported from @ChangeSong
                            	   742: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   743: ;
                            	   744: ; Selects the starting phrase index for the new song, then falls into
                            	   745: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   746: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   747: ;==============================================================================
                            	   748: change_song:
02:00000768 4A00            	   749:     tst.b   D0
02:0000076A 6B46            	   750:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:0000076C B03C0006        	   751:     cmp.b   #$06,D0
02:00000770 6610            	   752:     bne.s   .not_zelda
02:00000772 13FC002400FFE002	   753:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:0000077A 610000E0        	   754:     bsr     prep_phrase
02:0000077E 60000190        	   755:     bra     tick_sq1
                            	   756: .not_zelda:
02:00000782 B03C0001        	   757:     cmp.b   #$01,D0
02:00000786 6716            	   758:     beq.s   .first_ow
02:00000788 B03C0040        	   759:     cmp.b   #$40,D0
02:0000078C 671A            	   760:     beq.s   .first_uw
02:0000078E B03C0010        	   761:     cmp.b   #$10,D0
02:00000792 6626            	   762:     bne     play_next_phrase            ; single-phrase song
02:00000794 13FC001100FFE002	   763:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:0000079C 601C            	   764:     bra     play_next_phrase
                            	   765: .first_ow:
02:0000079E 13FC000800FFE002	   766:     move.b  #$08,(m_phrase).l
02:000007A6 6012            	   767:     bra     play_next_phrase
                            	   768: .first_uw:
02:000007A8 13FC000F00FFE002	   769:     move.b  #$0F,(m_phrase).l
02:000007B0 6008            	   770:     bra     play_next_phrase
                            	   771: .first_demo:
02:000007B2 13FC001900FFE002	   772:     move.b  #$19,(m_phrase).l
                            	   773:     bra     play_next_phrase
                            	   774: 
                            	   775: ;==============================================================================
                            	   776: ; play_next_phrase — ported from PlayNextPhrase
                            	   777: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   778: ; calls prep_phrase and falls into tick_sq1.
                            	   779: ;==============================================================================
                            	   780: play_next_phrase:
02:000007BA 103900FFE000    	   781:     move.b  (m_song).l,D0
02:000007C0 6B78            	   782:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:000007C2 B03C0001        	   783:     cmp.b   #$01,D0
02:000007C6 6758            	   784:     beq.s   .next_ow
02:000007C8 B03C0040        	   785:     cmp.b   #$40,D0
02:000007CC 6738            	   786:     beq.s   .next_uw
02:000007CE B03C0010        	   787:     cmp.b   #$10,D0
02:000007D2 6718            	   788:     beq.s   .next_ending
                            	   789:     ; Single-phrase song: find bit position, phrase = index
02:000007D4 7200            	   790:     moveq   #0,D1
02:000007D6 7400            	   791:     moveq   #0,D2
02:000007D8 1400            	   792:     move.b  D0,D2
                            	   793: .bitloop:
02:000007DA 5201            	   794:     addq.b  #1,D1
02:000007DC E20A            	   795:     lsr.b   #1,D2
02:000007DE 64FA            	   796:     bcc.s   .bitloop
02:000007E0 13C100FFE002    	   797:     move.b  D1,(m_phrase).l
02:000007E6 6174            	   798:     bsr     prep_phrase
02:000007E8 60000126        	   799:     bra     tick_sq1
                            	   800: .next_ending:
02:000007EC 523900FFE002    	   801:     addq.b  #1,(m_phrase).l
02:000007F2 0C39001A00FFE002	   802:     cmpi.b  #$1A,(m_phrase).l
02:000007FA 665A            	   803:     bne.s   .prep_and_tick
02:000007FC 13FC001400FFE002	   804:     move.b  #$14,(m_phrase).l
02:00000804 60B4            	   805:     bra     play_next_phrase
                            	   806: .next_uw:
02:00000806 523900FFE002    	   807:     addq.b  #1,(m_phrase).l
02:0000080C 0C39001200FFE002	   808:     cmpi.b  #$12,(m_phrase).l
02:00000814 6640            	   809:     bne.s   .prep_and_tick
02:00000816 13FC000F00FFE002	   810:     move.b  #$0F,(m_phrase).l
02:0000081E 609A            	   811:     bra     play_next_phrase
                            	   812: .next_ow:
02:00000820 523900FFE002    	   813:     addq.b  #1,(m_phrase).l
02:00000826 0C39001000FFE002	   814:     cmpi.b  #$10,(m_phrase).l
02:0000082E 6626            	   815:     bne.s   .prep_and_tick
02:00000830 13FC000900FFE002	   816:     move.b  #$09,(m_phrase).l
02:00000838 6080            	   817:     bra     play_next_phrase
                            	   818: .next_demo:
02:0000083A 523900FFE002    	   819:     addq.b  #1,(m_phrase).l
02:00000840 0C39002400FFE002	   820:     cmpi.b  #$24,(m_phrase).l
02:00000848 660C            	   821:     bne.s   .prep_and_tick
02:0000084A 13FC001900FFE002	   822:     move.b  #$19,(m_phrase).l
02:00000852 6000FF66        	   823:     bra     play_next_phrase
                            	   824: .prep_and_tick:
02:00000856 6104            	   825:     bsr     prep_phrase
02:00000858 600000B6        	   826:     bra     tick_sq1
                            	   827: 
                            	   828: ;==============================================================================
                            	   829: ; prep_phrase — ported from PrepPhrase
                            	   830: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   831: ;==============================================================================
                            	   832: prep_phrase:
02:0000085C 43F900000E7E    	   833:     lea     (MusicBlob).l,A1
02:00000862 7200            	   834:     moveq   #0,D1
02:00000864 123900FFE002    	   835:     move.b  (m_phrase).l,D1
02:0000086A 5341            	   836:     subq.w  #1,D1
02:0000086C 12311000        	   837:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000870 024100FF        	   838:     andi.w  #$FF,D1
                            	   839: 
                            	   840:     ; byte 0: NoteLengthTableBase
02:00000874 13F1100000FFE003	   841:     move.b  (A1,D1.w),(m_len_base).l
02:0000087C 5241            	   842:     addq.w  #1,D1
                            	   843:     ; byte 1: script ptr lo
02:0000087E 7400            	   844:     moveq   #0,D2
02:00000880 14311000        	   845:     move.b  (A1,D1.w),D2
02:00000884 5241            	   846:     addq.w  #1,D1
                            	   847:     ; byte 2: script ptr hi
02:00000886 7600            	   848:     moveq   #0,D3
02:00000888 16311000        	   849:     move.b  (A1,D1.w),D3
02:0000088C 5241            	   850:     addq.w  #1,D1
02:0000088E E14B            	   851:     lsl.w   #8,D3
02:00000890 8642            	   852:     or.w    D2,D3                        ; D3 = NES CPU address
02:00000892 967C8D60        	   853:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:00000896 02830000FFFF    	   854:     andi.l  #$FFFF,D3
02:0000089C 41F900000E7E    	   855:     lea     (MusicBlob).l,A0
02:000008A2 D1C3            	   856:     adda.l  D3,A0                        ; A0 = M68K script base
02:000008A4 23C800FFE008    	   857:     move.l  A0,(m_script_ptr).l
                            	   858: 
                            	   859:     ; byte 3: NoteOffsetSongTrg
02:000008AA 13F1100000FFE01C	   860:     move.b  (A1,D1.w),(m_trg_off).l
02:000008B2 5241            	   861:     addq.w  #1,D1
                            	   862:     ; byte 4: NoteOffsetSongSq0
02:000008B4 13F1100000FFE014	   863:     move.b  (A1,D1.w),(m_sq0_off).l
02:000008BC 5241            	   864:     addq.w  #1,D1
                            	   865:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:000008BE 13F1100000FFE024	   866:     move.b  (A1,D1.w),(m_noise_off).l
02:000008C6 13F1100000FFE006	   867:     move.b  (A1,D1.w),(m_noise_first).l
02:000008CE 5241            	   868:     addq.w  #1,D1
                            	   869:     ; byte 6: SongEnvelopeSelector
02:000008D0 13F1100000FFE004	   870:     move.b  (A1,D1.w),(m_env_sel).l
02:000008D8 5241            	   871:     addq.w  #1,D1
                            	   872:     ; byte 7: mystery
02:000008DA 13F1100000FFE005	   873:     move.b  (A1,D1.w),(m_mystery).l
                            	   874: 
                            	   875:     ; Reset counters and Sq1 offset
02:000008E2 13FC000100FFE00D	   876:     move.b  #1,(m_sq1_cnt).l
02:000008EA 13FC000100FFE015	   877:     move.b  #1,(m_sq0_cnt).l
02:000008F2 13FC000100FFE01D	   878:     move.b  #1,(m_trg_cnt).l
02:000008FA 13FC000100FFE025	   879:     move.b  #1,(m_noise_cnt).l
02:00000902 423900FFE00C    	   880:     clr.b   (m_sq1_off).l
02:00000908 423900FFE021    	   881:     clr.b   (m_trg_rep_n).l
02:0000090E 4E75            	   882:     rts
