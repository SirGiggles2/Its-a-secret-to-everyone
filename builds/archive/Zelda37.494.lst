                            	  1374: ;----------------------------------------------------------------------
                            	  1375: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1376: ; Layout per slot:
                            	  1377: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1378: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1379: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1380: ;   +3 reserved
                            	  1381: ;
                            	  1382: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1383: ; values are placeholders.
                            	  1384: ;----------------------------------------------------------------------
