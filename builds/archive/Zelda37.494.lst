                            	  7775: HaveInput:
                            	  7776:     ; There were input directions.
                            	  7777:     ;
                            	  7778:     ; If there was only one input direction, go set object direction
                            	  7779:     ; to input direction, and set Link's speed.
                            	  7780:     ;
                            	  7781:     ; Also, *RESET* Link_GoStraightWhenDiagInput
                            	  7782:     ; (X is still 0, because it's Link's object index).
                            	  7783:     ;
02:00041272 102C000F        	  7784:     move.b  ($000F,A4),D0
02:00041276 0C030001        	  7785:     cmpi.b  #$01,D3
02:0004127A 670000B6        	  7786:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  7787:     ; There were more than one input directions.
                            	  7788:     ;
                            	  7789:     ; If none were walkable, go set input direction to 0, and return.
                            	  7790:     ;
02:0004127E 102C000C        	  7791:     move.b  ($000C,A4),D0
02:00041282 6604            	  7792:     bne  _anon_z05_174
02:00041284 600000FC        	  7793:     jmp     SetLinkInputDir
