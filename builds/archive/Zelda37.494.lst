                            	  3058: .ttf_nt_range:
02:0002B2C8 45F900FF0840    	  3059:     lea     (NT_CACHE_BASE).l,A2
                            	  3060: 
                            	  3061: .ttf_nt_loop:
                            	  3062:     ; Get data byte
02:0002B2CE 4A04            	  3063:     tst.b   D4                      ; repeat mode?
02:0002B2D0 6602            	  3064:     bne.s   .ttf_nt_have_byte
02:0002B2D2 1418            	  3065:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3066: .ttf_nt_have_byte:
                            	  3067: 
                            	  3068:     ; Bounds check
02:0002B2D4 0C4523C0        	  3069:     cmpi.w  #$23C0,D5
02:0002B2D8 64000098        	  3070:     bhs     .ttf_nt_skip            ; long branch (added HUD guard ops)
                            	  3071: 
