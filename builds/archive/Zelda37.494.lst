                            	  2848: 
                            	  2849: ;==============================================================================
                            	  2850: ; _transfer_tilebuf_fast -- Native tile buffer interpreter.
                            	  2851: ;
                            	  2852: ; Replaces TransferTileBuf + ContinueTransferTileBuf.
                            	  2853: ; Parses tile buffer records and dispatches by PPU address range into
                            	  2854: ; tight inner loops, avoiding per-byte _ppu_write_7 overhead.
                            	  2855: ;
                            	  2856: ; Input:
                            	  2857: ;   ($0000,A4) / ($0001,A4) = 16-bit NES RAM pointer to buffer start
                            	  2858: ;   A4 = NES_RAM ($FF0000)
                            	  2859: ;
                            	  2860: ; Output:
                            	  2861: ;   ($0000,A4) / ($0001,A4) updated past last consumed record
                            	  2862: ;   PPU_VADDR, PPU_CTRL, NT_CACHE, CRAM updated per record contents
                            	  2863: ;
                            	  2864: ; Preserves: D0, D2, D3, D7, A4, A5 (6502 register convention)
                            	  2865: ;==============================================================================
                            	  2866:     even
                            	  2867: _transfer_tilebuf_fast:
                            	  2868:     ; Caller passes buffer pointer in A0 (32-bit absolute address).
02:0002B15E 48E7FFF0        	  2869:     movem.l D0-D7/A0-A3,-(SP)
                            	  2870: 
                            	  2871:     ; Reset PPU latch (matches _ppu_read_2 in original TransferTileBuf)
02:0002B162 423900FF0800    	  2872:     clr.b   (PPU_LATCH).l
                            	  2873: 
                            	  2874:     ; HUD guard hoisted out of inner loop: compute once here, reused per
                            	  2875:     ; tile in the .ttf_nt_range loop. D7.b = 1 if any cave-mode predicate
                            	  2876:     ; is active and NT rows 0-6 writes must be suppressed; 0 otherwise.
                            	  2877:     ; Was previously 3 memory reads + 3 compares per NT tile; now 1
                            	  2878:     ; tst.b D7 per tile. Matters because HUD updates touch hundreds of
                            	  2879:     ; tiles per frame and the guard runs on every one.
02:0002B168 7E00            	  2880:     moveq   #0,D7
02:0002B16A 0C2C000B0012    	  2881:     cmpi.b  #$0B,($0012,A4)         ; mode == cave?
02:0002B170 6710            	  2882:     beq.s   .ttf_hud_guard_on
02:0002B172 0C2C00100012    	  2883:     cmpi.b  #$10,($0012,A4)         ; mode == stair transition?
02:0002B178 6708            	  2884:     beq.s   .ttf_hud_guard_on
02:0002B17A 0C2C000B005B    	  2885:     cmpi.b  #$0B,($005B,A4)         ; target mode == cave?
02:0002B180 6602            	  2886:     bne.s   .ttf_hud_guard_off
                            	  2887: .ttf_hud_guard_on:
02:0002B182 7E01            	  2888:     moveq   #1,D7
                            	  2889: .ttf_hud_guard_off:
                            	  2890: 
                            	  2891:     ; A0 = buffer pointer (set by caller via TransferBufPtrs)
                            	  2892:     ; A3 = safety limit: bail if buffer exceeds 2048 bytes (prevents runaway parsing)
02:0002B184 47E80800        	  2893:     lea     (2048,A0),A3            ; largest buffer is ~1121 bytes
                            	  2894: 
                            	  2895: .ttf_next_record:
02:0002B188 B1CB            	  2896:     cmpa.l  A3,A0                   ; safety limit: bail if past 128 records
02:0002B18A 6C00052C        	  2897:     bge     .ttf_done
02:0002B18E 1018            	  2898:     move.b  (A0)+,D0                ; first byte of record
02:0002B190 6B000526        	  2899:     bmi     .ttf_done               ; bit 7 set ($80-$FF) = sentinel -> done
                            	  2900: 
                            	  2901:     ; --- Parse record header ---
                            	  2902:     ; D0.b = PPU addr hi byte
02:0002B194 7A00            	  2903:     moveq   #0,D5
02:0002B196 1A00            	  2904:     move.b  D0,D5
02:0002B198 E14D            	  2905:     lsl.w   #8,D5
02:0002B19A 1A18            	  2906:     move.b  (A0)+,D5                ; D5.w = PPU address
02:0002B19C 02453FFF        	  2907:     andi.w  #$3FFF,D5
                            	  2908: 
02:0002B1A0 1C18            	  2909:     move.b  (A0)+,D6                ; D6.b = control byte
                            	  2910: 
                            	  2911:     ; Decode count (bits 5:0, 0 means 64)
02:0002B1A2 7600            	  2912:     moveq   #0,D3
02:0002B1A4 1606            	  2913:     move.b  D6,D3
02:0002B1A6 0243003F        	  2914:     andi.w  #$003F,D3
02:0002B1AA 6602            	  2915:     bne.s   .ttf_count_ok
02:0002B1AC 7640            	  2916:     moveq   #64,D3
                            	  2917: .ttf_count_ok:
                            	  2918: 
                            	  2919:     ; NES control byte layout (after two ASLs in original 6502):
                            	  2920:     ;   Bit 7 = increment mode: 0 = horizontal (+1), 1 = vertical (+32)
                            	  2921:     ;   Bit 6 = repeat mode:    0 = sequential,      1 = repeat single byte
                            	  2922: 
                            	  2923:     ; Decode increment (bit 7): 1 or 32
02:0002B1AE 7201            	  2924:     moveq   #1,D1                   ; D1.w = increment
02:0002B1B0 08060007        	  2925:     btst    #7,D6
02:0002B1B4 6702            	  2926:     beq.s   .ttf_inc_ok
02:0002B1B6 7220            	  2927:     moveq   #32,D1
                            	  2928: .ttf_inc_ok:
                            	  2929: 
                            	  2930:     ; Decode repeat mode (bit 6): prefetch single data byte
02:0002B1B8 7800            	  2931:     moveq   #0,D4                   ; D4.b = 0 = sequential mode
02:0002B1BA 08060006        	  2932:     btst    #6,D6
02:0002B1BE 6704            	  2933:     beq.s   .ttf_no_repeat
02:0002B1C0 1418            	  2934:     move.b  (A0)+,D2                ; D2.b = repeat data byte
02:0002B1C2 78FF            	  2935:     moveq   #-1,D4                  ; D4.b = $FF = repeat mode
                            	  2936: .ttf_no_repeat:
                            	  2937: 
                            	  2938:     ; Update PPU_CTRL bit 2 (increment mode) + NES RAM $00FF
02:0002B1C4 102C00FF        	  2939:     move.b  ($00FF,A4),D0
02:0002B1C8 08060007        	  2940:     btst    #7,D6
02:0002B1CC 6706            	  2941:     beq.s   .ttf_ctrl_h
02:0002B1CE 00000004        	  2942:     ori.b   #$04,D0                 ; set bit 2 = +32 mode
02:0002B1D2 6004            	  2943:     bra.s   .ttf_ctrl_s
                            	  2944: .ttf_ctrl_h:
02:0002B1D4 020000FB        	  2945:     andi.b  #$FB,D0                 ; clear bit 2 = +1 mode
                            	  2946: .ttf_ctrl_s:
02:0002B1D8 194000FF        	  2947:     move.b  D0,($00FF,A4)          ; update NES RAM CurPpuControl
02:0002B1DC 13C000FF0804    	  2948:     move.b  D0,(PPU_CTRL).l        ; update PPU_CTRL shadow
02:0002B1E2 33C500FF0802    	  2949:     move.w  D5,(PPU_VADDR).l       ; set PPU_VADDR to record start
                            	  2950: 
                            	  2951:     ; --- Dispatch by PPU address range ---
02:0002B1E8 0C452000        	  2952:     cmpi.w  #$2000,D5
02:0002B1EC 653C            	  2953:     blo     .ttf_chr_range          ; $0000-$1FFF = CHR
02:0002B1EE 0C4523C0        	  2954:     cmpi.w  #$23C0,D5
02:0002B1F2 650000D4        	  2955:     blo     .ttf_nt_range           ; $2000-$23BF = nametable 0 tiles
02:0002B1F6 0C452400        	  2956:     cmpi.w  #$2400,D5
02:0002B1FA 65000186        	  2957:     blo     .ttf_attr_range         ; $23C0-$23FF = nametable 0 attributes
02:0002B1FE 0C452800        	  2958:     cmpi.w  #$2800,D5
02:0002B202 650004A4        	  2959:     blo     .ttf_skip_range         ; $2400-$27FF = NT mirror (unused w/ vert mirror)
02:0002B206 0C452BC0        	  2960:     cmpi.w  #$2BC0,D5
02:0002B20A 6500025A        	  2961:     blo     .ttf_nt1_range          ; $2800-$2BBF = nametable 1 tiles
02:0002B20E 0C452C00        	  2962:     cmpi.w  #$2C00,D5
02:0002B212 65000300        	  2963:     blo     .ttf_attr1_range        ; $2BC0-$2BFF = nametable 1 attributes
02:0002B216 0C453F00        	  2964:     cmpi.w  #$3F00,D5
02:0002B21A 6500048C        	  2965:     blo     .ttf_skip_range         ; $2C00-$3EFF = unhandled
02:0002B21E 0C453F20        	  2966:     cmpi.w  #$3F20,D5
02:0002B222 650003D8        	  2967:     blo     .ttf_palette_range      ; $3F00-$3F1F = palette
02:0002B226 60000480        	  2968:     bra     .ttf_skip_range         ; $3F20+ = unhandled
                            	  2969: 
                            	  2970:     ;==========================================================================
                            	  2971:     ; CHR RANGE ($0000-$1FFF): 2BPP tile data -> VDP VRAM
                            	  2972:     ;==========================================================================
                            	  2973: .ttf_chr_range:
                            	  2974:     ; Fast path: sequential + horizontal (+1) + tile-aligned
02:0002B22A B27C0001        	  2975:     cmp.w   #1,D1                   ; horizontal increment?
02:0002B22E 6622            	  2976:     bne.s   .ttf_chr_slow
02:0002B230 4A04            	  2977:     tst.b   D4                      ; sequential mode?
02:0002B232 661E            	  2978:     bne.s   .ttf_chr_slow
02:0002B234 3005            	  2979:     move.w  D5,D0
02:0002B236 0240000F        	  2980:     andi.w  #$000F,D0               ; offset within tile
02:0002B23A 4A40            	  2981:     tst.w   D0
02:0002B23C 6614            	  2982:     bne.s   .ttf_chr_slow           ; not tile-aligned
                            	  2983: 
                            	  2984:     ; Delegate to _transfer_chr_block_fast (A0=source, D1.w=dest, D2.l=count)
02:0002B23E 2248            	  2985:     movea.l A0,A1                   ; save source pointer
02:0002B240 3205            	  2986:     move.w  D5,D1                   ; D1.w = PPU dest
02:0002B242 7400            	  2987:     moveq   #0,D2
02:0002B244 3403            	  2988:     move.w  D3,D2                   ; D2.l = byte count
02:0002B246 6100FDC4        	  2989:     bsr     _transfer_chr_block_fast
02:0002B24A D3C3            	  2990:     adda.l  D3,A1                   ; advance past consumed bytes
02:0002B24C 2049            	  2991:     movea.l A1,A0
02:0002B24E 6000045E        	  2992:     bra     .ttf_post_record
                            	  2993: 
                            	  2994: .ttf_chr_slow:
                            	  2995:     ; Byte-by-byte CHR buffering (handles non-aligned, vertical, repeat)
                            	  2996:     ; Use existing CHR_TILE_BUF accumulation logic
02:0002B252 45F900FF0820    	  2997:     lea     (CHR_TILE_BUF).l,A2
                            	  2998: 
                            	  2999: .ttf_chr_slow_loop:
                            	  3000:     ; Get data byte
02:0002B258 4A04            	  3001:     tst.b   D4                      ; repeat mode?
02:0002B25A 6602            	  3002:     bne.s   .ttf_chr_have_byte
02:0002B25C 1418            	  3003:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3004: .ttf_chr_have_byte:
                            	  3005: 
                            	  3006:     ; Store in CHR_TILE_BUF at (PPU_VADDR & $F)
02:0002B25E 3005            	  3007:     move.w  D5,D0
02:0002B260 0240000F        	  3008:     andi.w  #$000F,D0
02:0002B264 15820000        	  3009:     move.b  D2,(A2,D0.W)           ; CHR_TILE_BUF[offset] = byte
                            	  3010: 
                            	  3011:     ; Check if first byte of tile: save base address
02:0002B268 4A40            	  3012:     tst.w   D0
02:0002B26A 660C            	  3013:     bne.s   .ttf_chr_no_base
02:0002B26C 3005            	  3014:     move.w  D5,D0
02:0002B26E 0240FFF0        	  3015:     andi.w  #$FFF0,D0
02:0002B272 33C000FF0832    	  3016:     move.w  D0,(CHR_BUF_VADDR).l
                            	  3017: .ttf_chr_no_base:
                            	  3018: 
                            	  3019:     ; Advance PPU_VADDR
02:0002B278 DA41            	  3020:     add.w   D1,D5
                            	  3021: 
                            	  3022:     ; Check if we just completed a tile (16 bytes)
02:0002B27A 3005            	  3023:     move.w  D5,D0
02:0002B27C 0240000F        	  3024:     andi.w  #$000F,D0
02:0002B280 4A40            	  3025:     tst.w   D0
02:0002B282 663C            	  3026:     bne.s   .ttf_chr_no_convert
                            	  3027: 
                            	  3028:     ; Convert and upload the completed tile
                            	  3029:     ifne CHR_EXPANSION_ENABLED
02:0002B284 303900FF0832    	  3030:     move.w  (CHR_BUF_VADDR).l,D0
02:0002B28A 0800000C        	  3031:     btst    #12,D0
02:0002B28E 6608            	  3032:     bne.s   .ttf_chr_bg_dispatch
02:0002B290 4EB90000E812    	  3033:     bsr     _chr_upload_sprite_4x
02:0002B296 6028            	  3034:     bra.s   .ttf_chr_uploaded
                            	  3035: .ttf_chr_bg_dispatch:
02:0002B298 4EB90000E772    	  3036:     bsr     _chr_convert_upload
