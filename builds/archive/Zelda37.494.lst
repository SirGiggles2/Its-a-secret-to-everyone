02:00039F4A 41EC041F        	  4352:     lea     ($041F,A4),A0
02:00039F4E 10302000        	  4353:     move.b  (A0,D2.W),D0
02:00039F52 41EC0437        	  4354:     lea     ($0437,A4),A0
02:00039F56 12302000        	  4355:     move.b  (A0,D2.W),D1
02:00039F5A B001            	  4356:     cmp.b   D1,D0
