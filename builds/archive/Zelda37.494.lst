                            	  1712: _bank_rom_bases:
02:0002AA52 0000EA52        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA56 00012A52
02:0002AA5A 00016A52        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
