                            	  4396: Digdogger_Move:
                            	  4397:     ; This calculation is the same one used in Manhandla to
                            	  4398:     ; manifest the fractional speed over several frames.
                            	  4399:     ;
                            	  4400:     ; To summarize, the formula is:
                            	  4401:     ;
                            	  4402:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4403:     ;
                            	  4404:     ;   SA := SA + (SL AND $E0)
                            	  4405:     ;   [03] := SH + carry
                            	  4406:     ;
                            	  4407:     ; See 04:A28E Manhandla_Move.
                            	  4408:     ;
02:00039FAA 41EC041F        	  4409:     lea     ($041F,A4),A0
02:00039FAE 10302000        	  4410:     move.b  (A0,D2.W),D0
02:00039FB2 020000E0        	  4411:     andi.b #$E0,D0
02:00039FB6 023C00EE        	  4412:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039FBA 41EC0412        	  4413:     lea     ($0412,A4),A0
02:00039FBE 12302000        	  4414:     move.b  (A0,D2.W),D1
02:00039FC2 D101            	  4415:     addx.b  D1,D0   ; ADC $0412,X
02:00039FC4 41EC0412        	  4416:     lea     ($0412,A4),A0
02:00039FC8 11802000        	  4417:     move.b  D0,(A0,D2.W)
                            	  4418:     ; Assign (high speed byte + carry) to [03].
                            	  4419:     ;
02:00039FCC 41EC042C        	  4420:     lea     ($042C,A4),A0
02:00039FD0 10302000        	  4421:     move.b  (A0,D2.W),D0
02:00039FD4 123C0000        	  4422:     move.b  #$00,D1
02:00039FD8 D101            	  4423:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00039FDA 19400003        	  4424:     move.b  D0,($0003,A4)
                            	  4425:     ; Change coordinates by the speed amount/offset in [03]
                            	  4426:     ; according to the direction.
                            	  4427:     ;
                            	  4428:     ; Start with a mask of $A1 in [02]:
                            	  4429:     ; - low nibble represents the right direction
                            	  4430:     ; - high nibble is used to set or clear carry as we go along
                            	  4431:     ;
02:00039FDE 103C00A1        	  4432:     move.b  #$A1,D0
02:00039FE2 19400002        	  4433:     move.b  D0,($0002,A4)
                            	  4434:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4435:     ;
02:00039FE6 41EC0098        	  4436:     lea     ($0098,A4),A0
02:00039FEA 10302000        	  4437:     move.b  (A0,D2.W),D0
02:00039FEE 122C0002        	  4438:     move.b  ($0002,A4),D1
02:00039FF2 C200            	  4439:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00039FF4 6712            	  4440:     beq  _L_z04_Digdogger_Move_Left
02:00039FF6 10342070        	  4441:     move.b  ($70,A4,D2.W),D0
02:00039FFA 023C00EE        	  4442:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039FFE 122C0003        	  4443:     move.b  ($0003,A4),D1
02:0003A002 D101            	  4444:     addx.b  D1,D0   ; ADC $03
02:0003A004 19802070        	  4445:     move.b  D0,($70,A4,D2.W)
                            	  4446:     even
                            	  4447: _L_z04_Digdogger_Move_Left:
                            	  4448:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  4449:     ;
02:0003A008 41EC0098        	  4450:     lea     ($0098,A4),A0
02:0003A00C 10302000        	  4451:     move.b  (A0,D2.W),D0
02:0003A010 122C0002        	  4452:     move.b  ($0002,A4),D1
02:0003A014 E309            	  4453:     lsl.b  #1,D1   ; ASL $02
02:0003A016 19410002        	  4454:     move.b  D1,($0002,A4)
02:0003A01A 122C0002        	  4455:     move.b  ($0002,A4),D1
02:0003A01E C200            	  4456:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A020 6716            	  4457:     beq  _L_z04_Digdogger_Move_Down
02:0003A022 10342070        	  4458:     move.b  ($70,A4,D2.W),D0
02:0003A026 122C0003        	  4459:     move.b  ($0003,A4),D1
02:0003A02A 0A3C0010        	  4460:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A02E 9101            	  4461:     subx.b  D1,D0   ; SBC $03
02:0003A030 0A3C0010        	  4462:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A034 19802070        	  4463:     move.b  D0,($70,A4,D2.W)
                            	  4464:     even
                            	  4465: _L_z04_Digdogger_Move_Down:
                            	  4466:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  4467:     ;
02:0003A038 41EC0098        	  4468:     lea     ($0098,A4),A0
02:0003A03C 10302000        	  4469:     move.b  (A0,D2.W),D0
02:0003A040 122C0002        	  4470:     move.b  ($0002,A4),D1
