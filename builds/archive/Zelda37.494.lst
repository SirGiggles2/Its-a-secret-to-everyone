02:0002C02C 670A            	  2521:     beq.s   .cc_cnras
02:0002C02E 003C0001        	  2522:     ori     #$01,CCR
02:0002C032 0A3C0001        	  2523:     eori    #$01,CCR
02:0002C036 4E75            	  2524:     rts
                            	  2525: .cc_cnras:
02:0002C038 023C00FE        	  2526:     andi    #$FE,CCR
02:0002C03C 0A3C0001        	  2527:     eori    #$01,CCR
02:0002C040 4E75            	  2528:     rts
