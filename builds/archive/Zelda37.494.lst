02:00038C02 41EC034F        	  1645:     lea     ($034F,A4),A0
02:00038C06 16302000        	  1646:     move.b  (A0,D2.W),D3
02:00038C0A 0C030011        	  1647:     cmpi.b  #$11,D3
02:00038C0E 6620            	  1648:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00038C10 7600            	  1649:     moveq   #0,D3
02:00038C12 41EC00AC        	  1650:     lea     ($00AC,A4),A0
02:00038C16 16302000        	  1651:     move.b  (A0,D2.W),D3
02:00038C1A 0C030002        	  1652:     cmpi.b  #$02,D3
