                            	  7941:     ;
02:0003BA60 41F90003B936    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0003BA66 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0003BA6A 7600            	  7944:     moveq   #0,D3
