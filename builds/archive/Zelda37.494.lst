02:00038C5A 10302000        	  1688:     move.b  (A0,D2.W),D0
02:00038C5E 0C000011        	  1689:     cmpi.b  #$11,D0
02:00038C62 6614            	  1690:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_NoState3Collisions
