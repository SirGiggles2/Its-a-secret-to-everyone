02:000313BA 41F900031366    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:000313C0 10302000        	   130:     move.b  (A0,D2.W),D0
02:000313C4 19400003        	   131:     move.b  D0,($0003,A4)
02:000313C8 41F90003136C    	   132:     lea     (CommonPatternVramAddrs).l,A0
