02:00039F64 10302000        	  4361:     move.b  (A0,D2.W),D0
02:00039F68 41EC0444        	  4362:     lea     ($0444,A4),A0
02:00039F6C 12302000        	  4363:     move.b  (A0,D2.W),D1
02:00039F70 B001            	  4364:     cmp.b   D1,D0
02:00039F72 6702            	  4365:     beq.s  __far_z_04_0041
