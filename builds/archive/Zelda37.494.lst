02:000383E2 7000            	   460:     moveq   #0,D0
02:000383E4 41EC0412        	   461:     lea     ($0412,A4),A0
02:000383E8 11802000        	   462:     move.b  D0,(A0,D2.W)
                            	   463:     ; Have the shot keep track of the monster.
