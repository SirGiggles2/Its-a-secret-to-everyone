02:00048996 1880            	  5658:     move.b  D0,($0000,A4)
02:00048998 41EC00AC        	  5659:     lea     ($00AC,A4),A0
02:0004899C 10302000        	  5660:     move.b  (A0,D2.W),D0
02:000489A0 0200000F        	  5661:     andi.b #$0F,D0
02:000489A4 7600            	  5662:     moveq   #0,D3
02:000489A6 1600            	  5663:     move.b  D0,D3
02:000489A8 7000            	  5664:     moveq   #0,D0
02:000489AA 19400001        	  5665:     move.b  D0,($0001,A4)
