                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A752 41EC0444        	  5431:     lea     ($0444,A4),A0
