                            	  8495: GanonSpriteOffsetsY:
02:0003BE3A 00              	  8496:     dc.b    $00, $00, $10, $10
02:0003BE3B 00
02:0003BE3C 10
02:0003BE3D 10
                            	  8497: 
                            	  8498:     even
                            	  8499: GanonSpriteHFlips:
