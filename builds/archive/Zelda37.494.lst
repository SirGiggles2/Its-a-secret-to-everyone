02:00038E94 7600            	  1992:     moveq   #0,D3
02:00038E96 1600            	  1993:     move.b  D0,D3
02:00038E98 41F900038CA8    	  1994:     lea     (RedLeeverStateQSpeeds).l,A0
02:00038E9E 10303000        	  1995:     move.b  (A0,D3.W),D0
02:00038EA2 41EC03BC        	  1996:     lea     ($03BC,A4),A0
02:00038EA6 11802000        	  1997:     move.b  D0,(A0,D2.W)
02:00038EAA 41F900038CAE    	  1998:     lea     (RedLeeverStateTimes).l,A0
02:00038EB0 10303000        	  1999:     move.b  (A0,D3.W),D0
02:00038EB4 19802028        	  2000:     move.b  D0,($28,A4,D2.W)
                            	  2001:     even
                            	  2002: RedLeever_AnimateAndCheckCollisions:
02:00038EB8 7600            	  2003:     moveq   #0,D3
02:00038EBA 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038EBE 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038EC2 41F900038CB4    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038EC8 10303000        	  2007:     move.b  (A0,D3.W),D0
