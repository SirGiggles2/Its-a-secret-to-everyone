02:0003840E 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:00038412 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   484:     ;
02:00038416 7051            	   485:     moveq   #81,D0
02:00038418 41EC0380        	   486:     lea     ($0380,A4),A0
02:0003841C 11803000        	   487:     move.b  D0,(A0,D3.W)
                            	   488:     ; Make it autonomous (ready to update on its own).
