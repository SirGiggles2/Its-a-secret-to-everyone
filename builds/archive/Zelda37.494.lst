                            	  5846: _L_z07_UpdateSwordOrRod_Add4:
                            	  5847:     ; Set [00] to (state - 1) * 4:
                            	  5848:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5849:     ;
02:00048B02 023C00EE        	  5850:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B06 123C0004        	  5851:     move.b  #$04,D1
02:00048B0A D101            	  5852:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048B0C 5303            	  5853:     subq.b  #1,D3
02:00048B0E 66F2            	  5854:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048B10 1880            	  5855:     move.b  D0,($0000,A4)
                            	  5856:     ; Set object's direction to player's. It might have changed
                            	  5857:     ; since the last frame.
                            	  5858:     ;
02:00048B12 102C0098        	  5859:     move.b  ($0098,A4),D0
02:00048B16 41EC0098        	  5860:     lea     ($0098,A4),A0
02:00048B1A 11802000        	  5861:     move.b  D0,(A0,D2.W)
                            	  5862:     ; Add [00] and the reverse index of the direction to get
                            	  5863:     ; the byte offset of the pixel offset.
                            	  5864:     ;
02:00048B1E 4EB900030AAC    	  5865:     jsr     GetOppositeDir
02:00048B24 1003            	  5866:     move.b  D3,D0
02:00048B26 023C00EE        	  5867:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B2A 1214            	  5868:     move.b  ($0000,A4),D1
02:00048B2C D101            	  5869:     addx.b  D1,D0   ; ADC $00
02:00048B2E 7600            	  5870:     moveq   #0,D3
02:00048B30 1600            	  5871:     move.b  D0,D3
                            	  5872:     ; Set object's X to player's X + offset for state and direction.
                            	  5873:     ; Copy the result to [00].
                            	  5874:     ;
02:00048B32 102C0070        	  5875:     move.b  ($0070,A4),D0
02:00048B36 023C00EE        	  5876:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B3A 41F900048A66    	  5877:     lea     (PlayerToWeaponOffsetsX).l,A0
02:00048B40 12303000        	  5878:     move.b  (A0,D3.W),D1
02:00048B44 D101            	  5879:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:00048B46 19802070        	  5880:     move.b  D0,($70,A4,D2.W)
02:00048B4A 1880            	  5881:     move.b  D0,($0000,A4)
                            	  5882:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5883:     ; Copy the result to [01].
                            	  5884:     ;
02:00048B4C 102C0084        	  5885:     move.b  ($0084,A4),D0
02:00048B50 023C00EE        	  5886:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048B54 41F900048A76    	  5887:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048B5A 12303000        	  5888:     move.b  (A0,D3.W),D1
02:00048B5E D101            	  5889:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048B60 41EC0084        	  5890:     lea     ($0084,A4),A0
02:00048B64 11802000        	  5891:     move.b  D0,(A0,D2.W)
02:00048B68 19400001        	  5892:     move.b  D0,($0001,A4)
                            	  5893:     ; If state = 1, use up direction.
                            	  5894:     ; Else use object direction.
                            	  5895:     ;
02:00048B6C 41EC00AC        	  5896:     lea     ($00AC,A4),A0
02:00048B70 10302000        	  5897:     move.b  (A0,D2.W),D0
02:00048B74 0200000F        	  5898:     andi.b #$0F,D0
02:00048B78 7600            	  5899:     moveq   #0,D3
02:00048B7A 1600            	  5900:     move.b  D0,D3
02:00048B7C 7008            	  5901:     moveq   #8,D0
02:00048B7E 5303            	  5902:     subq.b  #1,D3
02:00048B80 6708            	  5903:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:00048B82 41EC0098        	  5904:     lea     ($0098,A4),A0
02:00048B86 10302000        	  5905:     move.b  (A0,D2.W),D0
