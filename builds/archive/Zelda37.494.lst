02:0003842A 7003            	   495:     moveq   #3,D0
02:0003842C 41EC03D0        	   496:     lea     ($03D0,A4),A0
02:00038430 11803000        	   497:     move.b  D0,(A0,D3.W)
                            	   498:     ; Have the monster wait a random amount of time, up to $3F frames.
