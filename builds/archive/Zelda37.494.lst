                            	  2332: UpdateArmos:
02:000390DA 6100F296        	  2333:     jsr     UpdateGoriya
                            	  2334:     ; If it's still shoved, then don't animate. Only go draw.
                            	  2335:     ;
02:000390DE 41EC00C0        	  2336:     lea     ($00C0,A4),A0
02:000390E2 10302000        	  2337:     move.b  (A0,D2.W),D0
02:000390E6 6702            	  2338:     beq.s  __far_z_04_0018
02:000390E8 602A            	  2339:     jmp  DrawArmosAndCheckCollisions
                            	  2340: __far_z_04_0018:
                            	  2341:     ; Animate.
                            	  2342:     ;
                            	  2343:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  2344:     ; then only go draw.
                            	  2345:     ;
02:000390EA 41EC03D0        	  2346:     lea     ($03D0,A4),A0
02:000390EE 53302000        	  2347:     subq.b  #1,(A0,D2.W)
02:000390F2 6702            	  2348:     beq.s  __far_z_04_0019
02:000390F4 601E            	  2349:     jmp  DrawArmosAndCheckCollisions
                            	  2350: __far_z_04_0019:
                            	  2351:     ; Armos animation frames last 6 screen frames.
                            	  2352:     ;
02:000390F6 7006            	  2353:     moveq   #6,D0
02:000390F8 41EC03D0        	  2354:     lea     ($03D0,A4),A0
02:000390FC 11802000        	  2355:     move.b  D0,(A0,D2.W)
                            	  2356:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  2357:     ; change the position of the shield. To keep fixed it in place,
                            	  2358:     ; there are separate frame images for each animation frame.
                            	  2359:     ;
                            	  2360:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  2361:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  2362:     ;
                            	  2363:     ; Here flip between the two sets by XOR'ing with 2.
                            	  2364:     ; Then choose the direction at the point of drawing below.
                            	  2365:     ;
02:00039100 41EC03E4        	  2366:     lea     ($03E4,A4),A0
02:00039104 10302000        	  2367:     move.b  (A0,D2.W),D0
02:00039108 0A000002        	  2368:     eori.b #$02,D0
02:0003910C 41EC03E4        	  2369:     lea     ($03E4,A4),A0
02:00039110 11802000        	  2370:     move.b  D0,(A0,D2.W)
                            	  2371:     even
                            	  2372: DrawArmosAndCheckCollisions:
02:00039114 4EB9000490F0    	  2373:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003911A 7600            	  2374:     moveq   #0,D3
02:0003911C 41EC0098        	  2375:     lea     ($0098,A4),A0
02:00039120 16302000        	  2376:     move.b  (A0,D2.W),D3
                            	  2377:     ; If facing up, then use the second frame image in the set ("back").
                            	  2378:     ; Else use the second.
                            	  2379:     ;
02:00039124 0C030008        	  2380:     cmpi.b  #$08,D3
02:00039128 6602            	  2381:     bne  _anon_z04_54
02:0003912A 7001            	  2382:     moveq   #1,D0
                            	  2383: _anon_z04_54:
02:0003912C 023C00EE        	  2384:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039130 41EC03E4        	  2385:     lea     ($03E4,A4),A0
02:00039134 12302000        	  2386:     move.b  (A0,D2.W),D1
02:00039138 D101            	  2387:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003913A 4EB900030E7C    	  2388:     jsr     DrawObjectNotMirrored
                            	  2389:     ; If the armos is still fading in, then go for check collision with Link,
                            	  2390:     ; but not with weapons.
                            	  2391:     ;
02:00039140 10342028        	  2392:     move.b  ($28,A4,D2.W),D0
02:00039144 661A            	  2393:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  2394:     ; Else check for all collisions.
                            	  2395:     ;
02:00039146 610080A0        	  2396:     jsr     CheckMonsterCollisions
                            	  2397:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  2398:     ;
02:0003914A 41EC0405        	  2399:     lea     ($0405,A4),A0
02:0003914E 10302000        	  2400:     move.b  (A0,D2.W),D0
02:00039152 670A            	  2401:     beq  _anon_z04_55
02:00039154 705D            	  2402:     moveq   #93,D0
02:00039156 41EC034F        	  2403:     lea     ($034F,A4),A0
02:0003915A 11802000        	  2404:     move.b  D0,(A0,D2.W)
                            	  2405: _anon_z04_55:
02:0003915E 4E75            	  2406:     rts
                            	  2407: 
                            	  2408:     even
                            	  2409: _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision:
02:00039160 600080EC        	  2410:     jmp     CheckLinkCollision
                            	  2411: 
                            	  2412:     even
                            	  2413: UpdatePondFairy:
02:00039164 610031C0        	  2414:     jsr     DrawFairy
                            	  2415:     ; If not in state 0, then go handle states 1 to 3.
                            	  2416:     ;
02:00039168 102C00AD        	  2417:     move.b  ($00AD,A4),D0
02:0003916C 6702            	  2418:     beq.s  __far_z_04_0020
02:0003916E 602A            	  2419:     jmp  PondFairy_HandleOtherStates
                            	  2420: __far_z_04_0020:
                            	  2421:     ; State 0.
                            	  2422:     ;
                            	  2423:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2424:     ;
02:00039170 102C0084        	  2425:     move.b  ($0084,A4),D0
02:00039174 0C0000AD        	  2426:     cmpi.b  #$AD,D0
02:00039178 661E            	  2427:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2428:     ; If Link's X < $70 or >= $81, then return.
                            	  2429:     ;
02:0003917A 102C0070        	  2430:     move.b  ($0070,A4),D0
02:0003917E 0C000070        	  2431:     cmpi.b  #$70,D0
02:00039182 6514            	  2432:     bcs  _L_z04_UpdatePondFairy_Exit
02:00039184 0C000081        	  2433:     cmpi.b  #$81,D0
02:00039188 640E            	  2434:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2435:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2436:     ; halt Link, and start filling hearts.
                            	  2437:     ;
02:0003918A 522C00AD        	  2438:     addq.b  #1,($00AD,A4)
02:0003918E 7040            	  2439:     moveq   #64,D0
02:00039190 194000AC        	  2440:     move.b  D0,($00AC,A4)
02:00039194 19400063        	  2441:     move.b  D0,($0063,A4)
                            	  2442:     even
                            	  2443: _L_z04_UpdatePondFairy_Exit:
02:00039198 4E75            	  2444:     rts
                            	  2445: 
                            	  2446:     even
                            	  2447: PondFairy_HandleOtherStates:
02:0003919A 0C000001        	  2448:     cmpi.b  #$01,D0
02:0003919E 6610            	  2449:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2450:     ; State 1. Flying and filling hearts.
                            	  2451:     ;
                            	  2452:     ; If still filling hearts, then go draw Link and hearts.
                            	  2453:     ;
02:000391A0 102C0063        	  2454:     move.b  ($0063,A4),D0
02:000391A4 6620            	  2455:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2456:     ; If not filling hearts anymore, then go to state 2,
                            	  2457:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2458:     ; a little while after we finish filling hearts.
                            	  2459:     ;
02:000391A6 522C00AD        	  2460:     addq.b  #1,($00AD,A4)
02:000391AA 7050            	  2461:     moveq   #80,D0
02:000391AC 19400029        	  2462:     move.b  D0,($0029,A4)
                            	  2463:     even
                            	  2464: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2465:     ; If state <> 2 (so, it's 3), then return.
                            	  2466:     ;
                            	  2467:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2468:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2469:     ; was set to, and we'll return.
                            	  2470:     ;
02:000391B0 0C000002        	  2471:     cmpi.b  #$02,D0
02:000391B4 6634            	  2472:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2473:     ; State = 2.
                            	  2474:     ;
                            	  2475:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2476:     ;
02:000391B6 102C0029        	  2477:     move.b  ($0029,A4),D0
02:000391BA 660A            	  2478:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2479:     ; Else go to state 3, and unhalt Link.
                            	  2480:     ;
02:000391BC 522C00AD        	  2481:     addq.b  #1,($00AD,A4)
02:000391C0 7000            	  2482:     moveq   #0,D0
02:000391C2 194000AC        	  2483:     move.b  D0,($00AC,A4)
