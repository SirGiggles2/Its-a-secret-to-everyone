                            	  4940: _L_z07_SpreadShot_NextCorner:
                            	  4941:     ; Prepare to process the next corner.
                            	  4942:     ;
                            	  4943:     ; First, restore X offset [02] and Y offset [03].
                            	  4944:     ;
02:000484BE 101D            	  4945:     move.b  (A5)+,D0  ; PLA
02:000484C0 19400003        	  4946:     move.b  D0,($0003,A4)
02:000484C4 101D            	  4947:     move.b  (A5)+,D0  ; PLA
02:000484C6 19400002        	  4948:     move.b  D0,($0002,A4)
                            	  4949:     ; Take turns negating X offset or Y offset for the next round.
                            	  4950:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4951:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4952:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4953:     ; - Fourth turn: doesn't matter
                            	  4954:     ;
                            	  4955:     ;
                            	  4956:     ; Get the loop index.
02:000484CA 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:000484CC 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:000484CE 7600            	  4959:     moveq   #0,D3
02:000484D0 1600            	  4960:     move.b  D0,D3
02:000484D2 0C030001        	  4961:     cmpi.b  #$01,D3
02:000484D6 6602            	  4962:     bne  _anon_z07_25
02:000484D8 7603            	  4963:     moveq   #3,D3
                            	  4964: _anon_z07_25:
02:000484DA 10343000        	  4965:     move.b  ($00,A4,D3.W),D0
02:000484DE 4600            	  4966:     eori.b #$FF,D0
02:000484E0 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:000484E4 123C0001        	  4968:     move.b  #$01,D1
02:000484E8 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:000484EA 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
02:000484EE 101D            	  4973:     move.b  (A5)+,D0  ; PLA
02:000484F0 7600            	  4974:     moveq   #0,D3
02:000484F2 1600            	  4975:     move.b  D0,D3
02:000484F4 5303            	  4976:     subq.b  #1,D3
02:000484F6 6A00FF18        	  4977:     bpl  _L_z07_SpreadShot_DrawShotCorner
