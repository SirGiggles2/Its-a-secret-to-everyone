02:0003CC8A 19400001        	  9842:     move.b  D0,($0001,A4)
02:0003CC8E 612A            	  9843:     jsr     Gohma_SetSpriteAttributes
                            	  9844:     ; There are only two frame images for legs: left and right.
                            	  9845:     ; There are two animation frames. They are animated as follows:
                            	  9846:     ;
                            	  9847:     ; Frame 0:
                            	  9848:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9849:     ; horizontal flipping = frame number = 0
                            	  9850:     ; 
                            	  9851:     ; Frame 1:
                            	  9852:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9853:     ; horizontal flipping = frame number = 1
                            	  9854:     ;
02:0003CC90 4EB90004B782    	  9855:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003CC96 1003            	  9856:     move.b  D3,D0
02:0003CC98 023C00EE        	  9857:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC9C 41EC03E4        	  9858:     lea     ($03E4,A4),A0
02:0003CCA0 12302000        	  9859:     move.b  (A0,D2.W),D1
02:0003CCA4 D101            	  9860:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003CCA6 02000001        	  9861:     andi.b #$01,D0
02:0003CCAA 023C00EE        	  9862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCAE 123C0004        	  9863:     move.b  #$04,D1
02:0003CCB2 D101            	  9864:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003CCB4 4EF900030E66    	  9865:     jmp     DrawObjectNotMirrored
