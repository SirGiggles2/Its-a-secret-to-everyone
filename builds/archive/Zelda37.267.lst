                            	  3221: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3222:     ; Begin with the leever's Y set to Link's Y.
                            	  3223:     ;
02:00039C2C 102C0084        	  3224:     move.b  ($0084,A4),D0
02:00039C30 41EC0084        	  3225:     lea     ($0084,A4),A0
02:00039C34 11802000        	  3226:     move.b  D0,(A0,D2.W)
                            	  3227:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3228:     ; it's too close to the top edge of the screen. So, return.
                            	  3229:     ;
02:00039C38 0C00005D        	  3230:     cmpi.b  #$5D,D0
02:00039C3C 65EC            	  3231:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3232:     ; If facing right, then use X offset $28.
                            	  3233:     ; Else store X offset -$28 in [00].
                            	  3234:     ;
02:00039C3E 7628            	  3235:     moveq   #40,D3
02:00039C40 41EC0098        	  3236:     lea     ($0098,A4),A0
