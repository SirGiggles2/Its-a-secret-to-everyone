02:0003999E 19430002        	  2890:     move.b  D3,($0002,A4)
                            	  2891:     ; Add the high speed byte to the Y coordinate.
                            	  2892:     ;
02:000399A2 41EC0412        	  2893:     lea     ($0412,A4),A0
