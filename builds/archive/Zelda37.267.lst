                            	  6814:     ;
02:0003B640 101D            	  6815:     move.b  (A5)+,D0  ; PLA
02:0003B642 023C00EE        	  6816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B646 12342070        	  6817:     move.b  ($70,A4,D2.W),D1
