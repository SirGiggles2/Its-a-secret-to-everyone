02:00043D38 2044            	  8729:     movea.l D4,A0
02:00043D3A 10303000        	  8730:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00043D3E 02000020        	  8731:     andi.b #$20,D0
