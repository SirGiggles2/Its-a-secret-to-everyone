02:0004AFD2 6100F466        	  5775:     jsr     MoveObject
                            	  5776:     even
                            	  5777: AnimateBoomerangAndCheckCollision:
                            	  5778:     ; Decrement animation counter; and when it reaches 0:
                            	  5779:     ; 1. arm it again for 2 frames
                            	  5780:     ; 2. advance the minor state within a cycle of 8
                            	  5781:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5782:     ;
02:0004AFD6 41EC03D0        	  5783:     lea     ($03D0,A4),A0
02:0004AFDA 53302000        	  5784:     subq.b  #1,(A0,D2.W)
02:0004AFDE 6702            	  5785:     beq.s  __far_z_07_0086
02:0004AFE0 6036            	  5786:     jmp  DrawBoomerangAndCheckCollision
                            	  5787: __far_z_07_0086:
02:0004AFE2 7002            	  5788:     moveq   #2,D0
02:0004AFE4 41EC03D0        	  5789:     lea     ($03D0,A4),A0
02:0004AFE8 11802000        	  5790:     move.b  D0,(A0,D2.W)
02:0004AFEC 41EC00AC        	  5791:     lea     ($00AC,A4),A0
02:0004AFF0 52302000        	  5792:     addq.b  #1,(A0,D2.W)
02:0004AFF4 41EC00AC        	  5793:     lea     ($00AC,A4),A0
02:0004AFF8 10302000        	  5794:     move.b  (A0,D2.W),D0
02:0004AFFC 02000077        	  5795:     andi.b #$77,D0
02:0004B000 41EC00AC        	  5796:     lea     ($00AC,A4),A0
02:0004B004 11802000        	  5797:     move.b  D0,(A0,D2.W)
02:0004B008 0C02000D        	  5798:     cmpi.b  #$0D,D2
02:0004B00C 6402            	  5799:     bcc.s  __far_z_07_0087
02:0004B00E 6032            	  5800:     jmp  CalcBoomerangFrame
                            	  5801: __far_z_07_0087:
02:0004B010 7602            	  5802:     moveq   #2,D3
02:0004B012 4EB9000308EC    	  5803:     jsr     PlayBoomerangSfx
                            	  5804:     even
                            	  5805: DrawBoomerangAndCheckCollision:
                            	  5806:     ; If the boomerang belongs to a monster, then check for
                            	  5807:     ; collision with Link.
                            	  5808:     ;
                            	  5809:     ; If they collide, then set state $20 and animation counter 3.
                            	  5810:     ;
02:0004B018 0C02000D        	  5811:     cmpi.b  #$0D,D2
02:0004B01C 6502            	  5812:     bcs.s  __far_z_07_0088
02:0004B01E 6022            	  5813:     jmp  CalcBoomerangFrame
