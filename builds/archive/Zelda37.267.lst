                            	  7718: L_PolsVoice_DrawAndCheckCollisions:
02:0003BC72 7008            	  7719:     moveq   #8,D0
02:0003BC74 4EB90004B7AA    	  7720:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0003BC7A 41EC03E4        	  7721:     lea     ($03E4,A4),A0
