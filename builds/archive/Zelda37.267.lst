                            	  9573: UpdateGohma:
                            	  9574:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9575:     ;
02:0003CA92 41EC0451        	  9576:     lea     ($0451,A4),A0
02:0003CA96 10302000        	  9577:     move.b  (A0,D2.W),D0
02:0003CA9A 662C            	  9578:     bne  _L_z04_UpdateGohma_Move
                            	  9579:     ; If Random:
                            	  9580:     ;   >= $B0: right
                            	  9581:     ;   >= $60: left
                            	  9582:     ;   Else:   down
                            	  9583:     ;
02:0003CA9C 7001            	  9584:     moveq   #1,D0
02:0003CA9E 7600            	  9585:     moveq   #0,D3
02:0003CAA0 16342018        	  9586:     move.b  ($18,A4,D2.W),D3
02:0003CAA4 0C0300B0        	  9587:     cmpi.b  #$B0,D3
02:0003CAA8 640A            	  9588:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003CAAA E308            	  9589:     lsl.b  #1,D0   ; ASL A
02:0003CAAC 0C030060        	  9590:     cmpi.b  #$60,D3
02:0003CAB0 6402            	  9591:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003CAB2 E308            	  9592:     lsl.b  #1,D0   ; ASL A
                            	  9593:     even
                            	  9594: _L_z04_UpdateGohma_ChangeDir:
02:0003CAB4 41EC0098        	  9595:     lea     ($0098,A4),A0
02:0003CAB8 11802000        	  9596:     move.b  D0,(A0,D2.W)
                            	  9597:     ; Now we can go straight without changing direction for some time.
                            	  9598:     ;
02:0003CABC 41EC0451        	  9599:     lea     ($0451,A4),A0
02:0003CAC0 52302000        	  9600:     addq.b  #1,(A0,D2.W)
                            	  9601:     ; Go animate the eye.
                            	  9602:     ;
02:0003CAC4 600000C6        	  9603:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9604: 
                            	  9605:     even
                            	  9606: _L_z04_UpdateGohma_Move:
                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003CAC8 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003CACC 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003CAD0 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAD4 123C0080        	  9612:     move.b  #$80,D1
02:0003CAD8 D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003CADA 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003CADE 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003CAE2 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
02:0003CAE6 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003CAEA 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003CAEE 7001            	  9625:     moveq   #1,D0
02:0003CAF0 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003CAF4 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003CAF8 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003CAFC 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003CB00 C200            	  9632:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CB02 6704            	  9633:     beq  _anon_z04_118
02:0003CB04 52342070        	  9634:     addq.b  #1,($70,A4,D2.W)
                            	  9635: _anon_z04_118:
                            	  9636:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9637:     ;
02:0003CB08 122C0002        	  9638:     move.b  ($0002,A4),D1
02:0003CB0C E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003CB0E 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003CB12 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003CB16 C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CB18 6704            	  9643:     beq  _anon_z04_119
02:0003CB1A 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
                            	  9646:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9647:     ;
02:0003CB1E 122C0002        	  9648:     move.b  ($0002,A4),D1
02:0003CB22 E309            	  9649:     lsl.b  #1,D1   ; ASL $02
02:0003CB24 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003CB28 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003CB2C C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CB2E 6708            	  9653:     beq  _anon_z04_120
02:0003CB30 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003CB34 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
                            	  9657:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9658:     ;
02:0003CB38 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003CB3C E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003CB3E 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003CB42 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003CB46 C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CB48 6708            	  9664:     beq  _anon_z04_121
02:0003CB4A 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003CB4E 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003CB52 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003CB56 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003CB5A 0C000020        	  9672:     cmpi.b  #$20,D0
02:0003CB5E 662C            	  9673:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9674:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9675:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9676:     ;
02:0003CB60 7000            	  9677:     moveq   #0,D0
02:0003CB62 41EC0412        	  9678:     lea     ($0412,A4),A0
02:0003CB66 11802000        	  9679:     move.b  D0,(A0,D2.W)
02:0003CB6A 61001C62        	  9680:     jsr     ReverseObjDir8
02:0003CB6E 41EC045E        	  9681:     lea     ($045E,A4),A0
02:0003CB72 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003CB76 41EC045E        	  9683:     lea     ($045E,A4),A0
02:0003CB7A 52302000        	  9684:     addq.b  #1,(A0,D2.W)
                            	  9685:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9686:     ; should randomly change direction.
                            	  9687:     ;
02:0003CB7E E208            	  9688:     lsr.b  #1,D0   ; LSR A
02:0003CB80 640A            	  9689:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003CB82 7000            	  9690:     moveq   #0,D0
02:0003CB84 41EC0451        	  9691:     lea     ($0451,A4),A0
02:0003CB88 11802000        	  9692:     move.b  D0,(A0,D2.W)
                            	  9693:     even
                            	  9694: _L_z04_UpdateGohma_AnimateEye:
                            	  9695:     ; Animate the eye.
                            	  9696:     ;
                            	  9697:     ; First, if the counter for when to open the eye next = 0, then
                            	  9698:     ; set it to a random value at least $C0; and set the timer for
                            	  9699:     ; keeping the eye open to $80.
                            	  9700:     ;
                            	  9701:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9702:     ; every other frame.
                            	  9703:     ;
02:0003CB8C 41EC042C        	  9704:     lea     ($042C,A4),A0
02:0003CB90 10302000        	  9705:     move.b  (A0,D2.W),D0
02:0003CB94 661E            	  9706:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003CB96 103C0080        	  9707:     move.b  #$80,D0
02:0003CB9A 41EC0444        	  9708:     lea     ($0444,A4),A0
02:0003CB9E 11802000        	  9709:     move.b  D0,(A0,D2.W)
02:0003CBA2 103C00C0        	  9710:     move.b  #$C0,D0
02:0003CBA6 12342018        	  9711:     move.b  ($18,A4,D2.W),D1
02:0003CBAA 8001            	  9712:     or.b  D1,D0
02:0003CBAC 41EC042C        	  9713:     lea     ($042C,A4),A0
02:0003CBB0 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
                            	  9716: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9717:     ; Decrement the next-open-eye counter.
                            	  9718:     ;
02:0003CBB4 102C0015        	  9719:     move.b  ($0015,A4),D0
02:0003CBB8 E208            	  9720:     lsr.b  #1,D0   ; LSR A
02:0003CBBA 6408            	  9721:     bcc  _anon_z04_122
02:0003CBBC 41EC042C        	  9722:     lea     ($042C,A4),A0
02:0003CBC0 53302000        	  9723:     subq.b  #1,(A0,D2.W)
                            	  9724: _anon_z04_122:
                            	  9725:     ; If open eye timer = 0, then the eye is closed.
                            	  9726:     ; Go animate it differently.
                            	  9727:     ;
02:0003CBC4 41EC0444        	  9728:     lea     ($0444,A4),A0
02:0003CBC8 10302000        	  9729:     move.b  (A0,D2.W),D0
02:0003CBCC 674A            	  9730:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9731:     ; Else decrement the open eye timer.
                            	  9732:     ;
02:0003CBCE 41EC0444        	  9733:     lea     ($0444,A4),A0
02:0003CBD2 53302000        	  9734:     subq.b  #1,(A0,D2.W)
                            	  9735:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9736:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9737:     ;
02:0003CBD6 7602            	  9738:     moveq   #2,D3
02:0003CBD8 0C000070        	  9739:     cmpi.b  #$70,D0
02:0003CBDC 6408            	  9740:     bcc  _anon_z04_123
02:0003CBDE 0C000010        	  9741:     cmpi.b  #$10,D0
02:0003CBE2 6502            	  9742:     bcs  _anon_z04_123
02:0003CBE4 5203            	  9743:     addq.b  #1,D3
                            	  9744: _anon_z04_123:
02:0003CBE6 1003            	  9745:     move.b  D3,D0
                            	  9746:     even
                            	  9747: _L_z04_UpdateGohma_SetEyeStateAndShoot:
02:0003CBE8 41EC046B        	  9748:     lea     ($046B,A4),A0
02:0003CBEC 11802000        	  9749:     move.b  D0,(A0,D2.W)
                            	  9750:     even
                            	  9751: _L_z04_UpdateGohma_ShootAnimateCollide:
                            	  9752:     ; Decrement the shoot timer.
                            	  9753:     ;
02:0003CBF0 41EC0380        	  9754:     lea     ($0380,A4),A0
02:0003CBF4 53302000        	  9755:     subq.b  #1,(A0,D2.W)
                            	  9756:     ; If it became 0, then set it to $41, and shoot fireball $56.
                            	  9757:     ;
