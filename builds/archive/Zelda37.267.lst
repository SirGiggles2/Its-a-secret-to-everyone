02:0003B632 7020            	  6806:     moveq   #32,D0
02:0003B634 41EC041F        	  6807:     lea     ($041F,A4),A0
02:0003B638 11802000        	  6808:     move.b  D0,(A0,D2.W)
02:0003B63C 6100D110        	  6809:     jsr     Wanderer_TargetPlayer
                            	  6810:     ; Pop the offset and add it to the X coordinate.
                            	  6811:     ;
                            	  6812:     ; This brings the X coordinate back to the unique value
