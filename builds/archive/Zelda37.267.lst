                            	  1431: DrawWhirlwind:
                            	  1432:     ; Frames last 1 screen frame.
                            	  1433:     ;
02:00030204 7001            	  1434:     moveq   #1,D0
02:00030206 4EB90004B7AA    	  1435:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  1436:     ; The whirlwind flashes by using a palette row based on the
                            	  1437:     ; screen frame counter.
                            	  1438:     ;
02:0003020C 102C0015        	  1439:     move.b  ($0015,A4),D0
02:00030210 02000003        	  1440:     andi.b #$03,D0
02:00030214 61000F42        	  1441:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  1442:     ; Flip horizontally based on movement frame, which is
                            	  1443:     ; switched based on animation counter.
                            	  1444:     ;
02:00030218 4EB90004B782    	  1445:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003021E 7000            	  1446:     moveq   #0,D0
02:00030220 60000C44        	  1447:     jmp     DrawObjectNotMirrored
