02:0003E254 6652            	 12793:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12794:     ; If timer <> 0, then Ganon is visible.
                            	 12795:     ; He can't be harmed like this. So, return.
                            	 12796:     ;
02:0003E256 10342028        	 12797:     move.b  ($28,A4,D2.W),D0
02:0003E25A 664A            	 12798:     bne  _L_z04_Ganon_CheckCollisions_Exit
