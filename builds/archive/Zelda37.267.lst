02:0003B80E 10302000        	  7054:     move.b  (A0,D2.W),D0
02:0003B812 123C0008        	  7055:     move.b  #$08,D1
02:0003B816 D101            	  7056:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B818 19400001        	  7057:     move.b  D0,($0001,A4)
                            	  7058:     ; Only check the first bomb slot ($10).
                            	  7059:     ;
                            	  7060:     ; Store the bomb's (X + 8) in [02].
