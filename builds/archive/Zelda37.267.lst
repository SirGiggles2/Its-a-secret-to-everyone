02:0002B722 3002            	  1019:     move.w  D2,D0
02:0002B724 2F00            	  1020:     move.l  D0,-(SP)
02:0002B726 4EB900000000    	  1021:     jsr     z05_reset_door_flag
02:0002B72C 588F            	  1022:     addq.l  #4,SP
02:0002B72E 4E75            	  1023:     rts
