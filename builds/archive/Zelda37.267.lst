02:0003BF40 102C066C        	  8041:     move.b  ($066C,A4),D0
02:0003BF44 1234203D        	  8042:     move.b  ($3D,A4,D2.W),D1
02:0003BF48 8001            	  8043:     or.b  D1,D0
02:0003BF4A 6640            	  8044:     bne  _L_z04_UpdateVireState0_Exit
