02:0003BE26 7000            	  7902:     moveq   #0,D0
02:0003BE28 19400028        	  7903:     move.b  D0,($0028,A4)
02:0003BE2C 19400405        	  7904:     move.b  D0,($0405,A4)
02:0003BE30 194000C0        	  7905:     move.b  D0,($00C0,A4)
02:0003BE34 194000D3        	  7906:     move.b  D0,($00D3,A4)
                            	  7907:     ; Restart the monster's movement frame cycle: frame 0, counter 4
