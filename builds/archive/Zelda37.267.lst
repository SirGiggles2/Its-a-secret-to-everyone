                            	  5612:     ; might be less than $20.
                            	  5613:     ;
02:0003ADA0 7020            	  5614:     moveq   #32,D0
02:0003ADA2 41EC0485        	  5615:     lea     ($0485,A4),A0
02:0003ADA6 11802000        	  5616:     move.b  D0,(A0,D2.W)
02:0003ADAA 61000608        	  5617:     jsr     CheckBossHitReaction
                            	  5618:     ; Look for the tail segment, starting from the low end
                            	  5619:     ; of the chain that this dead segment belongs to.
                            	  5620:     ;
02:0003ADAE 163C00FF        	  5621:     move.b  #$FF,D3
02:0003ADB2 0C020006        	  5622:     cmpi.b  #$06,D2
02:0003ADB6 6502            	  5623:     bcs  _anon_z04_80
02:0003ADB8 7604            	  5624:     moveq   #4,D3
                            	  5625: _anon_z04_80:
02:0003ADBA 5203            	  5626:     addq.b  #1,D3
02:0003ADBC 41EC0350        	  5627:     lea     ($0350,A4),A0
02:0003ADC0 10303000        	  5628:     move.b  (A0,D3.W),D0
02:0003ADC4 0C000041        	  5629:     cmpi.b  #$41,D0
02:0003ADC8 66F0            	  5630:     bne  _anon_z04_80
                            	  5631:     ; I don't know why the object timer of the tail segment that will
                            	  5632:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5633:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5634:     ; there, the object timer is set to 6.
                            	  5635:     ;
02:0003ADCA 7011            	  5636:     moveq   #17,D0
02:0003ADCC 19803029        	  5637:     move.b  D0,($29,A4,D3.W)
                            	  5638:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5639:     ; segment to the tail segment.
                            	  5640:     ;
02:0003ADD0 41EC04F0        	  5641:     lea     ($04F0,A4),A0
02:0003ADD4 10302000        	  5642:     move.b  (A0,D2.W),D0
02:0003ADD8 41EC04F1        	  5643:     lea     ($04F1,A4),A0
02:0003ADDC 11803000        	  5644:     move.b  D0,(A0,D3.W)
02:0003ADE0 10342070        	  5645:     move.b  ($70,A4,D2.W),D0
02:0003ADE4 19803071        	  5646:     move.b  D0,($71,A4,D3.W)
02:0003ADE8 41EC0084        	  5647:     lea     ($0084,A4),A0
02:0003ADEC 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003ADF0 41EC0085        	  5649:     lea     ($0085,A4),A0
02:0003ADF4 11803000        	  5650:     move.b  D0,(A0,D3.W)
                            	  5651:     ; If the tail segment found is also a head, then
                            	  5652:     ; the last segment has died. Return.
                            	  5653:     ;
02:0003ADF8 0C030004        	  5654:     cmpi.b  #$04,D3
02:0003ADFC 6716            	  5655:     beq  _L_z04_UpdateMoldorm_Exit
02:0003ADFE 0C030009        	  5656:     cmpi.b  #$09,D3
02:0003AE02 6710            	  5657:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5658:     ; Else finish swapping the segments.
