02:00039C58 19400001        	  3246:     move.b  D0,($0001,A4)
                            	  3247:     ; Add Link's X and the horizontal offset.
                            	  3248:     ;
02:00039C5C 023C00EE        	  3249:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039C60 1214            	  3250:     move.b  ($0000,A4),D1
02:00039C62 D101            	  3251:     addx.b  D1,D0   ; ADC $00
                            	  3252:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3253:     ;
02:00039C64 020000F8        	  3254:     andi.b #$F8,D0
                            	  3255:     ; Assign that result to the leever's X coordinate and [02].
                            	  3256:     ;
