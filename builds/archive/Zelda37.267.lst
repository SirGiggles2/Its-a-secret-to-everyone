                            	 12801:     ; If Ganon has died according to the usual collision check rules
                            	 12802:     ; (HP = 0), then:
                            	 12803:     ; 1. Restore HP to the initial value $F0
                            	 12804:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12805:     ; 3. Change palette row 7 to make Ganon brown
                            	 12806:     ;
02:0003E264 41EC0405        	 12807:     lea     ($0405,A4),A0
02:0003E268 10302000        	 12808:     move.b  (A0,D2.W),D0
02:0003E26C 6718            	 12809:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003E26E 103C00F0        	 12810:     move.b  #$F0,D0
02:0003E272 41EC0485        	 12811:     lea     ($0485,A4),A0
02:0003E276 11802000        	 12812:     move.b  D0,(A0,D2.W)
02:0003E27A 41EC00AC        	 12813:     lea     ($00AC,A4),A0
02:0003E27E 53302000        	 12814:     subq.b  #1,(A0,D2.W)
02:0003E282 61000084        	 12815:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12816:     even
