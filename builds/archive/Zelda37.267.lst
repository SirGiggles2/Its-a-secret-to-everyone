                            	  2900:     ; Add the acceleration to the speed fraction (low byte).
                            	  2901:     ;
02:000399BC 41EC041F        	  2902:     lea     ($041F,A4),A0
02:000399C0 10302000        	  2903:     move.b  (A0,D2.W),D0
02:000399C4 023C00EE        	  2904:     andi    #$EE,CCR  ; CLC: clear C+X
