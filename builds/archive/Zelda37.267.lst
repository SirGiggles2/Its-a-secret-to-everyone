                            	  2659: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2660:     ; State 1. Jumping.
                            	  2661:     ;
                            	  2662:     ; Keep the object inside the bounds of the room.
                            	  2663:     ;
02:000397E8 61004FB6        	  2664:     jsr     BoundFlyer
                            	  2665:     ; If the object was blocked at the room boundary, then
                            	  2666:     ; increase boundary reversal count, and go set up another jump.
                            	  2667:     ;
02:000397EC 102C000F        	  2668:     move.b  ($000F,A4),D0
02:000397F0 660C            	  2669:     bne  _anon_z04_37
02:000397F2 41EC0451        	  2670:     lea     ($0451,A4),A0
02:000397F6 52302000        	  2671:     addq.b  #1,(A0,D2.W)
02:000397FA 6000FF74        	  2672:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2673: 
                            	  2674: _anon_z04_37:
02:000397FE 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:00039802 7000            	  2678:     moveq   #0,D0
02:00039804 41EC0451        	  2679:     lea     ($0451,A4),A0
02:00039808 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:0003980C 6100015E        	  2683:     jsr     Jumper_GetKind
02:00039810 41F9000396FC    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:00039816 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:0003981A 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003981E 41EC0098        	  2696:     lea     ($0098,A4),A0
02:00039822 12302000        	  2697:     move.b  (A0,D2.W),D1
02:00039826 D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:00039828 7600            	  2699:     moveq   #0,D3
02:0003982A 1600            	  2700:     move.b  D0,D3
02:0003982C 41F9000396DA    	  2701:     lea     (JumperYAccelerations).l,A0
02:00039832 10303000        	  2702:     move.b  (A0,D3.W),D0
02:00039836 7602            	  2703:     moveq   #2,D3
02:00039838 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
                            	  2707:     ;
                            	  2708:     ; Else add 1.
                            	  2709:     ;
02:0003983C 163C00FF        	  2710:     move.b  #$FF,D3
02:00039840 41EC0098        	  2711:     lea     ($0098,A4),A0
02:00039844 10302000        	  2712:     move.b  (A0,D2.W),D0
02:00039848 02000002        	  2713:     andi.b #$02,D0
02:0003984C 6602            	  2714:     bne  _anon_z04_38
02:0003984E 7601            	  2715:     moveq   #1,D3
                            	  2716: _anon_z04_38:
02:00039850 1003            	  2717:     move.b  D3,D0
02:00039852 023C00EE        	  2718:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039856 12342070        	  2719:     move.b  ($70,A4,D2.W),D1
02:0003985A D101            	  2720:     addx.b  D1,D0   ; ADC ObjX,X
02:0003985C 19802070        	  2721:     move.b  D0,($70,A4,D2.W)
                            	  2722:     ; If going up (negative v-speed high byte), then
                            	  2723:     ; go animate, draw, and check collisions.
                            	  2724:     ;
02:00039860 41EC0412        	  2725:     lea     ($0412,A4),A0
02:00039864 10302000        	  2726:     move.b  (A0,D2.W),D0
02:00039868 6A04            	  2727:     bpl.s  __far_z_04_0022
02:0003986A 60000090        	  2728:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2729: __far_z_04_0022:
                            	  2730:     ; Going down. We have to consider the target Y.
                            	  2731:     ;
                            	  2732:     ; If the absolute vertical distance to the target position >= 3,
                            	  2733:     ; then go animate, draw, and check collisions.
                            	  2734:     ;
02:0003986E 41EC0084        	  2735:     lea     ($0084,A4),A0
02:00039872 10302000        	  2736:     move.b  (A0,D2.W),D0
02:00039876 003C0011        	  2737:     ori     #$11,CCR  ; SEC: set C+X
02:0003987A 41EC0444        	  2738:     lea     ($0444,A4),A0
02:0003987E 12302000        	  2739:     move.b  (A0,D2.W),D1
02:00039882 0A3C0010        	  2740:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039886 9101            	  2741:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:00039888 0A3C0010        	  2742:     eori    #$10,CCR  ; restore X = 6502 C
02:0003988C 4EB900030960    	  2743:     jsr     Abs
02:00039892 0C000003        	  2744:     cmpi.b  #$03,D0
02:00039896 6502            	  2745:     bcs.s  __far_z_04_0023
02:00039898 6062            	  2746:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2747: __far_z_04_0023:
                            	  2748:     ; Distance < 3. Go to state 0.
                            	  2749:     ;
                            	  2750:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2751:     ;
02:0003989A 4EB90004B34E    	  2752:     jsr     ResetObjState
02:000398A0 7600            	  2753:     moveq   #0,D3
02:000398A2 41EC034F        	  2754:     lea     ($034F,A4),A0
02:000398A6 16302000        	  2755:     move.b  (A0,D2.W),D3
02:000398AA 0C030020        	  2756:     cmpi.b  #$20,D3
02:000398AE 6748            	  2757:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2758:     ; Else calculate a timer value.
                            	  2759:     ;
                            	  2760:     ; t := (Random + $10)
                            	  2761:     ; if t < $20 then
                            	  2762:     ;   t := t - $40
                            	  2763:     ;
02:000398B0 7010            	  2764:     moveq   #16,D0
02:000398B2 023C00EE        	  2765:     andi    #$EE,CCR  ; CLC: clear C+X
02:000398B6 12342019        	  2766:     move.b  ($19,A4,D2.W),D1
02:000398BA D101            	  2767:     addx.b  D1,D0   ; ADC Random+1,X
02:000398BC 0C000020        	  2768:     cmpi.b  #$20,D0
02:000398C0 6412            	  2769:     bcc  _anon_z04_39
02:000398C2 003C0011        	  2770:     ori     #$11,CCR  ; SEC: set C+X
02:000398C6 123C0040        	  2771:     move.b  #$40,D1
02:000398CA 0A3C0010        	  2772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000398CE 9101            	  2773:     subx.b  D1,D0   ; SBC #$40
02:000398D0 0A3C0010        	  2774:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2775: _anon_z04_39:
                            	  2776:     ; If the object is a blue tektite, then go use this t.
                            	  2777:     ;
02:000398D4 7600            	  2778:     moveq   #0,D3
02:000398D6 41EC034F        	  2779:     lea     ($034F,A4),A0
02:000398DA 16302000        	  2780:     move.b  (A0,D2.W),D3
02:000398DE 0C03000D        	  2781:     cmpi.b  #$0D,D3
02:000398E2 6714            	  2782:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2783:     ; t := t AND $7F
                            	  2784:     ;
02:000398E4 0200007F        	  2785:     andi.b #$7F,D0
                            	  2786:     ; If Random < $A0, then go use this t.
                            	  2787:     ;
02:000398E8 7600            	  2788:     moveq   #0,D3
02:000398EA 16342019        	  2789:     move.b  ($19,A4,D2.W),D3
02:000398EE 0C0300A0        	  2790:     cmpi.b  #$A0,D3
02:000398F2 6504            	  2791:     bcs  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2792:     ; t := t AND $F
                            	  2793:     ;
02:000398F4 0200000F        	  2794:     andi.b #$0F,D0
                            	  2795:     even
