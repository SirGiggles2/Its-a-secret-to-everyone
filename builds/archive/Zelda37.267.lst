02:0004B020 4EB9000312E4    	  5815:     jsr     CheckLinkCollision
02:0004B026 102C034B        	  5816:     move.b  ($034B,A4),D0
02:0004B02A 6602            	  5817:     bne.s  __far_z_07_0089
02:0004B02C 6014            	  5818:     jmp  CalcBoomerangFrame
                            	  5819: __far_z_07_0089:
02:0004B02E 7003            	  5820:     moveq   #3,D0
02:0004B030 41EC03D0        	  5821:     lea     ($03D0,A4),A0
02:0004B034 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:0004B038 7020            	  5823:     moveq   #32,D0
02:0004B03A 41EC00AC        	  5824:     lea     ($00AC,A4),A0
02:0004B03E 11802000        	  5825:     move.b  D0,(A0,D2.W)
                            	  5826:     even
                            	  5827: CalcBoomerangFrame:
                            	  5828:     ; The minor state (low 3 bits of state) is used to
                            	  5829:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5830:     ;
                            	  5831:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5832:     ; In other words, don't offset the coordinate below.
                            	  5833:     ;
02:0004B042 7000            	  5834:     moveq   #0,D0
02:0004B044 1880            	  5835:     move.b  D0,($0000,A4)
02:0004B046 41EC00AC        	  5836:     lea     ($00AC,A4),A0
02:0004B04A 10302000        	  5837:     move.b  (A0,D2.W),D0
02:0004B04E 0200000F        	  5838:     andi.b #$0F,D0
02:0004B052 7600            	  5839:     moveq   #0,D3
02:0004B054 1600            	  5840:     move.b  D0,D3
02:0004B056 7000            	  5841:     moveq   #0,D0
02:0004B058 19400001        	  5842:     move.b  D0,($0001,A4)
02:0004B05C 41F90004AC4A    	  5843:     lea     (BoomerangFrameCycle).l,A0
02:0004B062 10303000        	  5844:     move.b  (A0,D3.W),D0
02:0004B066 1940000C        	  5845:     move.b  D0,($000C,A4)
                            	  5846:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5847:     ;
02:0004B06A 1003            	  5848:     move.b  D3,D0
02:0004B06C 41F90004AC54    	  5849:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004B072 10303000        	  5850:     move.b  (A0,D3.W),D0
02:0004B076 19400004        	  5851:     move.b  D0,($0004,A4)
                            	  5852:     ; TODO: ?
                            	  5853:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5854:     ; Else add the item value of the magic boomerang.
                            	  5855:     ;
                            	  5856:     ; But none of the values in the base sprite attributes array is 8.
