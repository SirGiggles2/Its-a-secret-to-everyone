02:0003E84C 102C0062        	 13679:     move.b  ($0062,A4),D0
02:0003E850 41EC0084        	 13680:     lea     ($0084,A4),A0
02:0003E854 12302000        	 13681:     move.b  (A0,D2.W),D1
