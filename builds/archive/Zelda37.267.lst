02:0003051C 41EC0084        	  1862:     lea     ($0084,A4),A0
02:00030520 12302000        	  1863:     move.b  (A0,D2.W),D1
02:00030524 0A3C0010        	  1864:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030528 9101            	  1865:     subx.b  D1,D0   ; SBC ObjY,X
02:0003052A 0A3C0010        	  1866:     eori    #$10,CCR  ; restore X = 6502 C
02:0003052E 61000430        	  1867:     jsr     Abs
02:00030532 0C00000E        	  1868:     cmpi.b  #$0E,D0
02:00030536 644C            	  1869:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1870:     ; Determine the horizontal direction toward Link;
                            	  1871:     ; and if Link and the trap are at the same X, then we can't move
                            	  1872:     ; along this axis. Go see about moving vertically.
                            	  1873:     ;
02:00030538 7601            	  1874:     moveq   #1,D3
02:0003053A 102C0070        	  1875:     move.b  ($0070,A4),D0
02:0003053E 12342070        	  1876:     move.b  ($70,A4,D2.W),D1
02:00030542 B001            	  1877:     cmp.b   D1,D0
02:00030544 673E            	  1878:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030546 6402            	  1879:     bcc  _anon_z01_26
02:00030548 7602            	  1880:     moveq   #2,D3
                            	  1881: _anon_z01_26:
                            	  1882:     ; Remember the original X coordinate.
