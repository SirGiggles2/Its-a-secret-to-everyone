                            	  3578: DrawGhiniAndCheckCollisions:
02:00039ECC 4EB90004B7B0    	  3579:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00039ED2 1940000D        	  3580:     move.b  D0,($000D,A4)
                            	  3581:     ; If the direction has an "up" component, then keep the
                            	  3582:     ; frame image 0, and go figure out horizontal flipping.
                            	  3583:     ;
02:00039ED6 41EC0098        	  3584:     lea     ($0098,A4),A0
02:00039EDA 10302000        	  3585:     move.b  (A0,D2.W),D0
02:00039EDE 02000008        	  3586:     andi.b #$08,D0
02:00039EE2 6614            	  3587:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3588:     ; Else make the frame image 1 for the "down" frame.
                            	  3589:     ; Note that this is the frame image to use, even if there's no
                            	  3590:     ; down component in the direction.
                            	  3591:     ;
02:00039EE4 522C000D        	  3592:     addq.b  #1,($000D,A4)
                            	  3593:     ; If right is a component of the direction, then go set horizontal
                            	  3594:     ; flipping. Else leave horizontal flipping = 0.
                            	  3595:     ;
02:00039EE8 41EC0098        	  3596:     lea     ($0098,A4),A0
02:00039EEC 10302000        	  3597:     move.b  (A0,D2.W),D0
02:00039EF0 02000001        	  3598:     andi.b #$01,D0
02:00039EF4 6714            	  3599:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:00039EF6 660E            	  3600:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3601:     even
                            	  3602: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3603:     ; Set horizontal flipping if right is a direction component.
                            	  3604:     ; This essentially the same test as above, but for when we jump
                            	  3605:     ; from the "up" test.
                            	  3606:     ;
02:00039EF8 41EC0098        	  3607:     lea     ($0098,A4),A0
02:00039EFC 10302000        	  3608:     move.b  (A0,D2.W),D0
02:00039F00 02000002        	  3609:     andi.b #$02,D0
02:00039F04 6704            	  3610:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3611:     even
                            	  3612: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:00039F06 522C000F        	  3613:     addq.b  #1,($000F,A4)
                            	  3614:     even
                            	  3615: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:00039F0A 102C000D        	  3616:     move.b  ($000D,A4),D0
                            	  3617: ; Params:
                            	  3618: ; A: frame image
                            	  3619: ; X: object index
                            	  3620: ; [00]: object X
                            	  3621: ; [01]: object Y
                            	  3622: ; [0F]: flip horizontally
                            	  3623: ;
                            	  3624: ; Returns:
                            	  3625: ; [00]: 0 for Link slot
                            	  3626: ; [06]: 1 if objects collide
                            	  3627: ; [09]: 0 for Link damage type (none)
                            	  3628: ; [0C]: 1 if objects collide
                            	  3629: ; [034B]: ShotCollidesWithLink
                            	  3630: ;
                            	  3631:     even
