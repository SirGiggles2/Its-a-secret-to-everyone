                            	   828: ;------------------------------------------------------------------------------
                            	   829: ; _c_move_object_shim — MoveObject trampoline.
                            	   830: ;
                            	   831: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   832: ;   Input:     D2 = slot (0..11)
                            	   833: ;   Preserves: D2, A4, A5
                            	   834: ;   Clobbers:  D0, D1, D3, A0
                            	   835: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   836: ;
                            	   837: ; GCC side:
                            	   838: ;   void c_move_object(unsigned short slot);
                            	   839: ;     slot arrives as a 16-bit value on the stack.
                            	   840: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   841: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   842: ;   never clobbered by gcc.
                            	   843: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   844: ;   semantics can exist in a pure C port).
                            	   845: ;------------------------------------------------------------------------------
                            	   846: _c_move_object_shim:
                            	   847:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   848:     move.b  #$AA,($0900,A4)
                            	   849:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   850:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   851:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   852:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   853:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   854:     moveq   #0,D0
02:0002B658 3002            	   855:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   856:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   857:     jsr     c_move_object
02:0002B662 588F            	   858:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   859:     rts
                            	   860: 
                            	   861: ;==============================================================================
                            	   862: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   863: ; and tail-call the native asm function.
                            	   864: ;
                            	   865: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   866: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   867: ; sign-extended).
                            	   868: ;==============================================================================
                            	   869: 
                            	   870: ;------------------------------------------------------------------------------
                            	   871: ; void c_copy_bank_to_window(unsigned int bank);
                            	   872: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   873: ;------------------------------------------------------------------------------
                            	   874: c_copy_bank_to_window:
02:0002B666 202F0004        	   875:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   876:     jmp     _copy_bank_to_window
                            	   877: 
                            	   878: ;------------------------------------------------------------------------------
                            	   879: ; unsigned char c_ppu_read_2(void);
                            	   880: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   881: ; C return: gcc expects result in D0.
                            	   882: ;------------------------------------------------------------------------------
                            	   883: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   884:     jmp     _ppu_read_2
                            	   885: 
                            	   886: ;------------------------------------------------------------------------------
                            	   887: ; void c_ppu_write_6(unsigned int val);
                            	   888: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   889: ;------------------------------------------------------------------------------
                            	   890: c_ppu_write_6:
02:0002B674 202F0004        	   891:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   892:     jmp     _ppu_write_6
                            	   893: 
                            	   894: ;------------------------------------------------------------------------------
                            	   895: ; void c_ppu_write_7(unsigned int val);
                            	   896: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   897: ;------------------------------------------------------------------------------
                            	   898: c_ppu_write_7:
02:0002B67E 202F0004        	   899:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   900:     jmp     _ppu_write_7
                            	   901: 
                            	   902: ;------------------------------------------------------------------------------
                            	   903: ; void c_turn_off_all_video(void);
                            	   904: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   905: ;------------------------------------------------------------------------------
                            	   906: c_turn_off_all_video:
02:0002B688 4EF9000493F0    	   907:     jmp     TurnOffAllVideo
                            	   908: 
                            	   909: ;==============================================================================
                            	   910: ; EXPORT side — z_03 entry point.
                            	   911: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   912: ; the transpiler emits that label pointing to this shim instead of the
                            	   913: ; z_03 asm body. The C function takes no args and returns void.
                            	   914: ;==============================================================================
                            	   915: 
                            	   916: ;------------------------------------------------------------------------------
                            	   917: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   918: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   919: ;------------------------------------------------------------------------------
                            	   920: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   921:     jmp     z03_transfer_level_pattern_blocks
                            	   922: 
                            	   923: ;==============================================================================
                            	   924: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   925: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   926: ;==============================================================================
                            	   927: 
                            	   928: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   929:     jmp     z06_init_mode2_submodes
