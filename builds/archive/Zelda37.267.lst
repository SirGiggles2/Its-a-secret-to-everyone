                            	  3645: InitArmosOrFlyingGhini:
                            	  3646:     ; In UpdateObject, this object was flagged "initialized".
                            	  3647:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3648:     ;
02:00039F2A 10342028        	  3649:     move.b  ($28,A4,D2.W),D0
02:00039F2E 41EC0492        	  3650:     lea     ($0492,A4),A0
02:00039F32 11802000        	  3651:     move.b  D0,(A0,D2.W)
                            	  3652:     ; If it's still fading in, then go finish some initialization needed
                            	  3653:     ; for fading in.
                            	  3654:     ;
02:00039F36 660000B6        	  3655:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3656:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3657:     ; go finish initializing it.
                            	  3658:     ;
02:00039F3A 41EC034F        	  3659:     lea     ($034F,A4),A0
02:00039F3E 10302000        	  3660:     move.b  (A0,D2.W),D0
02:00039F42 0C000022        	  3661:     cmpi.b  #$22,D0
02:00039F46 670000A6        	  3662:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3663:     ; Else we have an armos.
                            	  3664:     ;
                            	  3665:     ; Store stairs tile $70 in [00] for use later.
                            	  3666:     ;
02:00039F4A 7070            	  3667:     moveq   #112,D0
02:00039F4C 1880            	  3668:     move.b  D0,($0000,A4)
                            	  3669:     ; Look for the current room ID in an array of room ID's that
                            	  3670:     ; have armos secrets.
                            	  3671:     ;
02:00039F4E 7606            	  3672:     moveq   #6,D3
                            	  3673:     even
                            	  3674: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:00039F50 102C00EB        	  3675:     move.b  ($00EB,A4),D0
                            	  3676:     ; If this element does not match the current room ID, go loop again.
                            	  3677:     ;
02:00039F54 41F900039F1A    	  3678:     lea     (SecretArmosRoomIds).l,A0
02:00039F5A 12303000        	  3679:     move.b  (A0,D3.W),D1
02:00039F5E B001            	  3680:     cmp.b   D1,D0
02:00039F60 6648            	  3681:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3682:     ; The secret (usually stairs) is under one of the armoses.
                            	  3683:     ;
                            	  3684:     ; If the armos's X coordinate does not match the one needed
                            	  3685:     ; for the current room in the list, then go loop again.
                            	  3686:     ;
02:00039F62 10342070        	  3687:     move.b  ($70,A4,D2.W),D0
02:00039F66 41F900039F22    	  3688:     lea     (SecretArmosXs).l,A0
02:00039F6C 12303000        	  3689:     move.b  (A0,D3.W),D1
02:00039F70 B001            	  3690:     cmp.b   D1,D0
02:00039F72 6636            	  3691:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3692:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3693:     ;
02:00039F74 41EC0084        	  3694:     lea     ($0084,A4),A0
02:00039F78 10302000        	  3695:     move.b  (A0,D2.W),D0
02:00039F7C 0C000080        	  3696:     cmpi.b  #$80,D0
02:00039F80 6628            	  3697:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3698:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3699:     ;
02:00039F82 4A03            	  3700:     cmpi.b  #$00,D3
02:00039F84 662C            	  3701:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3702:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3703:     ; has the power bracelet.
                            	  3704:     ;
                            	  3705:     ; Set up the room item with the armos's coordinates.
                            	  3706:     ;
02:00039F86 19400097        	  3707:     move.b  D0,($0097,A4)
02:00039F8A 10342070        	  3708:     move.b  ($70,A4,D2.W),D0
02:00039F8E 19400083        	  3709:     move.b  D0,($0083,A4)
                            	  3710:     ; This resets the room item's state, which activates it.
                            	  3711:     ;
02:00039F92 194300BF        	  3712:     move.b  D3,($00BF,A4)
                            	  3713:     ; Set the room item ID.
                            	  3714:     ;
02:00039F96 7014            	  3715:     moveq   #20,D0
02:00039F98 194000AB        	  3716:     move.b  D0,($00AB,A4)
                            	  3717:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3718:     ;
                            	  3719:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3720:     ;
                            	  3721:     ; Note that, if the item was already taken, then the room item
                            	  3722:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3723:     ; it will be ignored, because that routine checks whether
                            	  3724:     ; the item was taken.
                            	  3725:     ;
02:00039F9C 4EB900030B9E    	  3726:     jsr     GetRoomFlagUWItemState
02:00039FA2 660A            	  3727:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:00039FA4 6100069E        	  3728:     jsr     PlaySecretFoundTune
02:00039FA8 6604            	  3729:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3730:     even
                            	  3731: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3732:     ; Bottom of the loop.
                            	  3733:     ;
02:00039FAA 5303            	  3734:     subq.b  #1,D3
02:00039FAC 6AA2            	  3735:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3736:     even
                            	  3737: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3738:     ; Not found, or found the power bracelet.
                            	  3739:     ; Use a floor tile $26 to replace the armos.
                            	  3740:     ;
02:00039FAE 7026            	  3741:     moveq   #38,D0
02:00039FB0 1880            	  3742:     move.b  D0,($0000,A4)
                            	  3743:     even
                            	  3744: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:00039FB2 1014            	  3745:     move.b  ($0000,A4),D0
                            	  3746:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3747:     ;
02:00039FB4 1B00            	  3748:     move.b  D0,-(A5)  ; PHA
02:00039FB6 0C000070        	  3749:     cmpi.b  #$70,D0
02:00039FBA 6604            	  3750:     bne  _anon_z04_51
02:00039FBC 61000686        	  3751:     jsr     PlaySecretFoundTune
                            	  3752: _anon_z04_51:
                            	  3753:     ; Replace the tile where the armos was.
                            	  3754:     ;
02:00039FC0 522C00F7        	  3755:     addq.b  #1,($00F7,A4)
02:00039FC4 101D            	  3756:     move.b  (A5)+,D0  ; PLA
02:00039FC6 4EB900049814    	  3757:     jsr     ChangeTileObjTiles
                            	  3758:     ; Because the armos object is aligned to the square grid
                            	  3759:     ; (because it was made from a square),
                            	  3760:     ; set its grid offset to 3 to compensate.
                            	  3761:     ;
                            	  3762:     ; Most objects are aligned to the grid vertically when the
                            	  3763:     ; low nibble is $D.
                            	  3764:     ;
02:00039FCC 7003            	  3765:     moveq   #3,D0
02:00039FCE 41EC0394        	  3766:     lea     ($0394,A4),A0
02:00039FD2 11802000        	  3767:     move.b  D0,(A0,D2.W)
                            	  3768:     ; Set a speed (q-speed fraction) randomly:
                            	  3769:     ; $20 if random value < $80
                            	  3770:     ; $60 otherwise
                            	  3771:     ;
02:00039FD6 7020            	  3772:     moveq   #32,D0
02:00039FD8 7600            	  3773:     moveq   #0,D3
02:00039FDA 16342019        	  3774:     move.b  ($19,A4,D2.W),D3
02:00039FDE 0C030080        	  3775:     cmpi.b  #$80,D3
02:00039FE2 6502            	  3776:     bcs  _anon_z04_52
02:00039FE4 7060            	  3777:     moveq   #96,D0
                            	  3778: _anon_z04_52:
02:00039FE6 41EC03BC        	  3779:     lea     ($03BC,A4),A0
02:00039FEA 11802000        	  3780:     move.b  D0,(A0,D2.W)
                            	  3781:     even
                            	  3782: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3783:     ; Facing and input directions down.
                            	  3784:     ;
02:00039FEE 7004            	  3785:     moveq   #4,D0
02:00039FF0 41EC03F8        	  3786:     lea     ($03F8,A4),A0
02:00039FF4 11802000        	  3787:     move.b  D0,(A0,D2.W)
02:00039FF8 41EC0098        	  3788:     lea     ($0098,A4),A0
02:00039FFC 11802000        	  3789:     move.b  D0,(A0,D2.W)
                            	  3790:     ; Every other frame, return without drawing.
                            	  3791:     ;
02:0003A000 10342028        	  3792:     move.b  ($28,A4,D2.W),D0
02:0003A004 E208            	  3793:     lsr.b  #1,D0   ; LSR A
02:0003A006 6512            	  3794:     bcs  _anon_z04_53
                            	  3795:     ; Finish initializing based on type.
                            	  3796:     ;
02:0003A008 41EC034F        	  3797:     lea     ($034F,A4),A0
02:0003A00C 10302000        	  3798:     move.b  (A0,D2.W),D0
02:0003A010 0C000022        	  3799:     cmpi.b  #$22,D0
02:0003A014 6602            	  3800:     bne.s  __far_z_04_0032
02:0003A016 6008            	  3801:     jmp  L_EndInitFlyingGhini
                            	  3802: __far_z_04_0032:
02:0003A018 6158            	  3803:     jsr     DrawArmosAndCheckCollisions
                            	  3804: _anon_z04_53:
02:0003A01A 0A3C0001        	  3805:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A01E 4E75            	  3806:     rts
