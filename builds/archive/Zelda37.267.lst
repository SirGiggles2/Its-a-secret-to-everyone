02:0003B81C 7610            	  7062:     moveq   #16,D3
02:0003B81E 10343070        	  7063:     move.b  ($70,A4,D3.W),D0
02:0003B822 123C0008        	  7064:     move.b  #$08,D1
02:0003B826 D101            	  7065:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B828 19400002        	  7066:     move.b  D0,($0002,A4)
                            	  7067:     ; Store the bomb's (Y + 8) in [03].
                            	  7068:     ;
02:0003B82C 41EC0084        	  7069:     lea     ($0084,A4),A0
02:0003B830 10303000        	  7070:     move.b  (A0,D3.W),D0
02:0003B834 123C0008        	  7071:     move.b  #$08,D1
02:0003B838 D101            	  7072:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B83A 19400003        	  7073:     move.b  D0,($0003,A4)
                            	  7074:     ; But, if there's no bomb, then return.
                            	  7075:     ;
02:0003B83E 41EC00AC        	  7076:     lea     ($00AC,A4),A0
