02:00039BC8 11802000        	  3167:     move.b  D0,(A0,D2.W)
                            	  3168:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3169:     ;
02:00039BCC 10342019        	  3170:     move.b  ($19,A4,D2.W),D0
02:00039BD0 0C0000C0        	  3171:     cmpi.b  #$C0,D0
02:00039BD4 6506            	  3172:     bcs  _anon_z04_43
02:00039BD6 4EB90004A690    	  3173:     jsr     ReverseObjDir
                            	  3174: _anon_z04_43:
                            	  3175:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3176:     ;
02:00039BDC 41EC0098        	  3177:     lea     ($0098,A4),A0
02:00039BE0 10302000        	  3178:     move.b  (A0,D2.W),D0
02:00039BE4 0200000C        	  3179:     andi.b #$0C,D0
02:00039BE8 6742            	  3180:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3181:     ; Begin with the leever's X set to Link's X.
                            	  3182:     ;
