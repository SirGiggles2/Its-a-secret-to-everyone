02:0003BF4C 41EC0098        	  8047:     lea     ($0098,A4),A0
02:0003BF50 10302000        	  8048:     move.b  (A0,D2.W),D0
02:0003BF54 02000003        	  8049:     andi.b #$03,D0
02:0003BF58 6732            	  8050:     beq  _L_z04_UpdateVireState0_Exit
                            	  8051:     ; Get the absolute value of the grid offset (0 to $F);
                            	  8052:     ; so it becomes an index into the jump offset array.
                            	  8053:     ;
02:0003BF5A 41EC0394        	  8054:     lea     ($0394,A4),A0
