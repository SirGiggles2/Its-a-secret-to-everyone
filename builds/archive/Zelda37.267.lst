02:00042444 0C000005        	  5957:     cmpi.b  #$05,D0
02:00042448 650C            	  5958:     bcs  _anon_z05_125
02:0004244A 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:0004244C 7004            	  5960:     moveq   #4,D0
02:0004244E 4EB900030822    	  5961:     jsr     PlaySample
