02:0003CE0C 123C0042        	 10043:     move.b  #$42,D1
02:0003CE10 0A3C0010        	 10044:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CE14 9101            	 10045:     subx.b  D1,D0   ; SBC #$42
02:0003CE16 0A3C0010        	 10046:     eori    #$10,CCR  ; restore X = 6502 C
                            	 10047:     ; For each neck, counting down:
                            	 10048:     ;
