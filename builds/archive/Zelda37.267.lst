02:00040C0C B001            	  4029:     cmp.b   D1,D0
02:00040C0E 6510            	  4030:     bcs  _anon_z05_95
02:00040C10 41F900040BD2    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:00040C16 12303000        	  4032:     move.b  (A0,D3.W),D1
02:00040C1A B001            	  4033:     cmp.b   D1,D0
02:00040C1C 65000082        	  4034:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4035: _anon_z05_95:
