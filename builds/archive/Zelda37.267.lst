02:00038AEE 6704            	   754:     beq.s  __far_z_04_0006
02:00038AF0 60000086        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:00038AF4 7602            	   760:     moveq   #2,D3
02:00038AF6 102C0070        	   761:     move.b  ($0070,A4),D0
02:00038AFA 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:00038AFE 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:00038B02 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038B06 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:00038B08 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:00038B0C 6A08            	   776:     bpl  _anon_z04_14
02:00038B0E 5203            	   777:     addq.b  #1,D3
02:00038B10 4EB900030964    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
                            	   780:     ; If the distance >= $11, then go reset the push timer and return.
                            	   781:     ;
02:00038B16 0C000011        	   782:     cmpi.b  #$11,D0
02:00038B1A 6502            	   783:     bcs.s  __far_z_04_0007
02:00038B1C 605A            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:00038B1E 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:00038B22 41F900038A76    	   792:     lea     (BlockPushDirections).l,A0
02:00038B28 12303000        	   793:     move.b  (A0,D3.W),D1
02:00038B2C B001            	   794:     cmp.b   D1,D0
02:00038B2E 6702            	   795:     beq.s  __far_z_04_0008
02:00038B30 6046            	   796:     jmp  ResetPushTimer
                            	   797: __far_z_04_0008:
                            	   798:     ; Link is truly pushing the block.
                            	   799:     ;
                            	   800:     ; Increase the push timer.
                            	   801:     ;
