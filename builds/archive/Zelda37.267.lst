                            	 12102:     ;
02:0003DD78 7600            	 12103:     moveq   #0,D3
02:0003DD7A 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003DD7E 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003DD82 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003DD86 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003DD8A 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003DD8C 41F90003DC7E    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003DD92 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003DD96 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003DD98 41F90003DC82    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003DD9E 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003DDA2 7600            	 12118:     moveq   #0,D3
02:0003DDA4 1600            	 12119:     move.b  D0,D3
02:0003DDA6 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003DDA8 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003DDAA 41F90003DC80    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003DDB0 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003DDB4 7600            	 12131:     moveq   #0,D3
02:0003DDB6 1600            	 12132:     move.b  D0,D3
                            	 12133:     even
