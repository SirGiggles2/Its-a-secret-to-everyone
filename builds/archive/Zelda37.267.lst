02:00035532 023C00EE        	  5008:     andi    #$EE,CCR  ; CLC: clear C+X
02:00035536 123C0080        	  5009:     move.b  #$80,D1
02:0003553A D101            	  5010:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003553C 19400058        	  5011:     move.b  D0,($0058,A4)
                            	  5012:     ; Carry over to the tile offset and current V-scroll.
                            	  5013:     ;
02:00035540 6404            	  5014:     bcc  _anon_z02_38
02:00035542 522C050B        	  5015:     addq.b  #1,($050B,A4)
                            	  5016: _anon_z02_38:
02:00035546 102C00FC        	  5017:     move.b  ($00FC,A4),D0
02:0003554A 123C0000        	  5018:     move.b  #$00,D1
02:0003554E D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035550 194000FC        	  5020:     move.b  D0,($00FC,A4)
                            	  5021:     ; If we've reached the bottom of a nametable, then
