02:00043D24 182C0001        	  8723:     move.b  ($01,A4),D4  ; ptr hi
02:00043D28 024100FF        	  8724:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043D2C E14C            	  8725:     lsl.w   #8,D4
