02:0003BF0A 1600            	  8015:     move.b  D0,D3
02:0003BF0C 5303            	  8016:     subq.b  #1,D3
02:0003BF0E 6AE2            	  8017:     bpl  _L_z04_UpdateVire_LoopMakeKeese
02:0003BF10 4E75            	  8018:     rts
