                            	  7501: _anon_z04_94:
                            	  7502:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7503:     ; This is the base frame image.
                            	  7504:     ;
02:0003BADC E208            	  7505:     lsr.b  #1,D0   ; LSR A
02:0003BADE E208            	  7506:     lsr.b  #1,D0   ; LSR A
                            	  7507:     ; If movement frame = 1, add 3 to frame image to access
                            	  7508:     ; the second animation frame's images.
                            	  7509:     ;
02:0003BAE0 7600            	  7510:     moveq   #0,D3
02:0003BAE2 41EC03E4        	  7511:     lea     ($03E4,A4),A0
02:0003BAE6 16302000        	  7512:     move.b  (A0,D2.W),D3
02:0003BAEA 671E            	  7513:     beq  _anon_z04_95
02:0003BAEC 023C00EE        	  7514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BAF0 123C0003        	  7515:     move.b  #$03,D1
02:0003BAF4 D101            	  7516:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7517:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7518:     ;
                            	  7519:     ; Down has two frame images, but up only has one. By flipping
                            	  7520:     ; horizontally, you get two frame images.
                            	  7521:     ;
02:0003BAF6 7600            	  7522:     moveq   #0,D3
02:0003BAF8 41EC0098        	  7523:     lea     ($0098,A4),A0
02:0003BAFC 16302000        	  7524:     move.b  (A0,D2.W),D3
02:0003BB00 0C030008        	  7525:     cmpi.b  #$08,D3
02:0003BB04 6604            	  7526:     bne  _anon_z04_95
02:0003BB06 522C000F        	  7527:     addq.b  #1,($000F,A4)
