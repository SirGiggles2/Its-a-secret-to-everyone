02:0002BF88 08000008        	  2377:     btst    #8,D0
02:0002BF8C 670A            	  2378:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2379:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2380:     eori    #$01,CCR
02:0002BF96 4E75            	  2381:     rts
                            	  2382: .cc_cnr:
02:0002BF98 023C00FE        	  2383:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2384:     eori    #$01,CCR
02:0002BFA0 4E75            	  2385:     rts
                            	  2386: 
