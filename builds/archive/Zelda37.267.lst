                            	  1913: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1914:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1915:     ; then this trap definitely wasn't triggered.
                            	  1916:     ; Go draw and check collisions.
                            	  1917:     ;
02:00030584 102C0070        	  1918:     move.b  ($0070,A4),D0
02:00030588 003C0011        	  1919:     ori     #$11,CCR  ; SEC: set C+X
02:0003058C 12342070        	  1920:     move.b  ($70,A4,D2.W),D1
02:00030590 0A3C0010        	  1921:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030594 9101            	  1922:     subx.b  D1,D0   ; SBC ObjX,X
02:00030596 0A3C0010        	  1923:     eori    #$10,CCR  ; restore X = 6502 C
02:0003059A 610003C4        	  1924:     jsr     Abs
02:0003059E 0C00000E        	  1925:     cmpi.b  #$0E,D0
02:000305A2 64DC            	  1926:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1927:     ; Determine the vertical direction toward Link;
                            	  1928:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1929:     ; along this axis. Go draw and check object collisions.
                            	  1930:     ;
