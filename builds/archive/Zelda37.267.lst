                            	  7588: _L_z04_UpdatePolsVoice_State0:
                            	  7589:     ; State 0. Walking.
                            	  7590:     ;
                            	  7591:     ; If grid offset = 0, then no more distance to cover.
                            	  7592:     ; So, go change to state 1 -- jumping.
                            	  7593:     ;
02:0003BB70 41EC0394        	  7594:     lea     ($0394,A4),A0
02:0003BB74 10302000        	  7595:     move.b  (A0,D2.W),D0
02:0003BB78 67000084        	  7596:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7597:     ; Decrement grid offset / distance remaining.
                            	  7598:     ;
02:0003BB7C 41EC0394        	  7599:     lea     ($0394,A4),A0
02:0003BB80 53302000        	  7600:     subq.b  #1,(A0,D2.W)
                            	  7601:     ; Move vertically.
                            	  7602:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7603:     ;
02:0003BB84 41EC0084        	  7604:     lea     ($0084,A4),A0
02:0003BB88 10302000        	  7605:     move.b  (A0,D2.W),D0
02:0003BB8C 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BB90 41F90003BB20    	  7607:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003BB96 12303000        	  7608:     move.b  (A0,D3.W),D1
02:0003BB9A D101            	  7609:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003BB9C 41EC0084        	  7610:     lea     ($0084,A4),A0
02:0003BBA0 11802000        	  7611:     move.b  D0,(A0,D2.W)
                            	  7612:     even
                            	  7613: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7614:     ; If the square the monster is over is walkable, then
                            	  7615:     ; go draw and check object collisions.
                            	  7616:     ;
02:0003BBA4 610001F4        	  7617:     jsr     PolsVoice_IsSquareWalkable
02:0003BBA8 6452            	  7618:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7619:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7620:     ; then go change to state 1.
                            	  7621:     ;
02:0003BBAA 41EC041F        	  7622:     lea     ($041F,A4),A0
02:0003BBAE 10302000        	  7623:     move.b  (A0,D2.W),D0
02:0003BBB2 020000FC        	  7624:     andi.b #$FC,D0
02:0003BBB6 0C0000B0        	  7625:     cmpi.b  #$B0,D0
02:0003BBBA 6742            	  7626:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003BBBC 0C0000F4        	  7627:     cmpi.b  #$F4,D0
02:0003BBC0 643C            	  7628:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7629:     ; Else blocked by something else.
                            	  7630:     ;
                            	  7631:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7632:     ;
02:0003BBC2 41EC0098        	  7633:     lea     ($0098,A4),A0
02:0003BBC6 10302000        	  7634:     move.b  (A0,D2.W),D0
02:0003BBCA 02000003        	  7635:     andi.b #$03,D0
02:0003BBCE 6618            	  7636:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7637:     ; Else facing vertically. Flip the direction.
                            	  7638:     ; Go draw.
                            	  7639:     ;
02:0003BBD0 41EC0098        	  7640:     lea     ($0098,A4),A0
02:0003BBD4 10302000        	  7641:     move.b  (A0,D2.W),D0
02:0003BBD8 0A00000C        	  7642:     eori.b #$0C,D0
02:0003BBDC 41EC0098        	  7643:     lea     ($0098,A4),A0
02:0003BBE0 11802000        	  7644:     move.b  D0,(A0,D2.W)
02:0003BBE4 6000008C        	  7645:     jmp     L_PolsVoice_DrawAndCheckCollisions
