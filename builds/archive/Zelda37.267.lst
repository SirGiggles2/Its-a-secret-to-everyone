02:00040C3E 41F900040BCE    	  4062:     lea     (DoorwayBoundsMinOver).l,A0
02:00040C44 12303000        	  4063:     move.b  (A0,D3.W),D1
02:00040C48 B001            	  4064:     cmp.b   D1,D0
