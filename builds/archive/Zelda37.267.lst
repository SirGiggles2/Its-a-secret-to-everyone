                            	 12696: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12697:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12698:     ;
02:0003E18E 10342070        	 12699:     move.b  ($70,A4,D2.W),D0
02:0003E192 023C00EE        	 12700:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E196 41F90003E180    	 12701:     lea     (GanonSpriteOffsetsX).l,A0
02:0003E19C 12303000        	 12702:     move.b  (A0,D3.W),D1
02:0003E1A0 D101            	 12703:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003E1A2 1880            	 12704:     move.b  D0,($0000,A4)
                            	 12705:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12706:     ;
02:0003E1A4 41EC0084        	 12707:     lea     ($0084,A4),A0
02:0003E1A8 10302000        	 12708:     move.b  (A0,D2.W),D0
02:0003E1AC 023C00EE        	 12709:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E1B0 41F90003E184    	 12710:     lea     (GanonSpriteOffsetsY).l,A0
02:0003E1B6 12303000        	 12711:     move.b  (A0,D3.W),D1
02:0003E1BA D101            	 12712:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003E1BC 19400001        	 12713:     move.b  D0,($0001,A4)
                            	 12714:     ; Each part has a horizontal flipping flag.
                            	 12715:     ;
02:0003E1C0 41F90003E188    	 12716:     lea     (GanonSpriteHFlips).l,A0
02:0003E1C6 10303000        	 12717:     move.b  (A0,D3.W),D0
02:0003E1CA 1940000F        	 12718:     move.b  D0,($000F,A4)
                            	 12719:     ; Save and copy the loop index (the current part) to [07].
                            	 12720:     ;
02:0003E1CE 1003            	 12721:     move.b  D3,D0
02:0003E1D0 1B00            	 12722:     move.b  D0,-(A5)  ; PHA
02:0003E1D2 19400007        	 12723:     move.b  D0,($0007,A4)
                            	 12724:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12725:     ; that make it up.
                            	 12726:     ;
02:0003E1D6 41EC046B        	 12727:     lea     ($046B,A4),A0
02:0003E1DA 10302000        	 12728:     move.b  (A0,D2.W),D0
02:0003E1DE E308            	 12729:     lsl.b  #1,D0   ; ASL A
02:0003E1E0 E308            	 12730:     lsl.b  #1,D0   ; ASL A
                            	 12731:     ; Add [07] -- the index of the current part.
                            	 12732:     ;
                            	 12733:     ; Now you have an index into the frame image table, for the
                            	 12734:     ; current image part of the current animation frame.
                            	 12735:     ;
02:0003E1E2 122C0007        	 12736:     move.b  ($0007,A4),D1
02:0003E1E6 D101            	 12737:     addx.b  D1,D0   ; ADC $07
02:0003E1E8 7600            	 12738:     moveq   #0,D3
02:0003E1EA 1600            	 12739:     move.b  D0,D3
02:0003E1EC 41F90003E168    	 12740:     lea     (GanonFrameImages).l,A0
02:0003E1F2 10303000        	 12741:     move.b  (A0,D3.W),D0
02:0003E1F6 4EB900030E66    	 12742:     jsr     DrawObjectNotMirrored
02:0003E1FC 101D            	 12743:     move.b  (A5)+,D0  ; PLA
                            	 12744:     ; Bottom of the part loop.
                            	 12745:     ;
02:0003E1FE 7600            	 12746:     moveq   #0,D3
02:0003E200 1600            	 12747:     move.b  D0,D3
02:0003E202 5303            	 12748:     subq.b  #1,D3
02:0003E204 6A88            	 12749:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003E206 4E75            	 12750:     rts
