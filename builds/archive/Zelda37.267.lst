02:0003543E 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00035442 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:00035446 5303            	  4886:     subq.b  #1,D3
02:00035448 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:0003544A 7600            	  4891:     moveq   #0,D3
02:0003544C 162C0413        	  4892:     move.b  ($0413,A4),D3
02:00035450 41F9000353EA    	  4893:     lea     (PeaceText).l,A0
02:00035456 10303000        	  4894:     move.b  (A0,D3.W),D0
02:0003545A 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:0003545E 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00035460 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
