                            	   369: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   370:     ; Add the offset we calculated, and $62 to [00] to get
                            	   371:     ; the position marker's X coordinate.
                            	   372:     ;
02:0003ED2C 023C00EE        	   373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED30 1214            	   374:     move.b  ($0000,A4),D1
02:0003ED32 D101            	   375:     addx.b  D1,D0   ; ADC $00
02:0003ED34 023C00EE        	   376:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED38 123C0062        	   377:     move.b  #$62,D1
02:0003ED3C D101            	   378:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:0003ED3E 19400253        	   379:     move.b  D0,($0253,A4)
                            	   380:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   381:     ; Divide by 2 to get a multiple of the tile height.
                            	   382:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   383:     ;
02:0003ED42 102C00EB        	   384:     move.b  ($00EB,A4),D0
02:0003ED46 020000F0        	   385:     andi.b #$F0,D0
