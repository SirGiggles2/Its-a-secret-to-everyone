02:000324F8 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:000324FC 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00032500 E14C            	   528:     lsl.w   #8,D4
02:00032502 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00032504 48C4            	   530:     ext.l   D4
02:00032506 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003250C 2044            	   532:     movea.l D4,A0
02:0003250E 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00032512 41EC0633        	   534:     lea     ($0633,A4),A0
02:00032516 11803000        	   535:     move.b  D0,(A0,D3.W)
02:0003251A 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:0003251C 1003            	   537:     move.b  D3,D0
02:0003251E 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:00032520 19430016        	   539:     move.b  D3,($0016,A4)
02:00032524 6100E386        	   540:     jsr     FetchFileAAddressSet
02:00032528 61001C26        	   541:     jsr     FormatFileA
02:0003252C 7000            	   542:     moveq   #0,D0
02:0003252E 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:00032532 6100E378        	   550:     jsr     FetchFileAAddressSet
02:00032536 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00032538 7600            	   552:     moveq   #0,D3
02:0003253A 1600            	   553:     move.b  D0,D3
                            	   554:     even
