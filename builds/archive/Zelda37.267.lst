02:0003550E 0C000008        	  4995:     cmpi.b  #$08,D0
02:00035512 6B1A            	  4996:     bmi  _anon_z02_37
02:00035514 102C050B        	  4997:     move.b  ($050B,A4),D0
02:00035518 123C0008        	  4998:     move.b  #$08,D1
02:0003551C 0A3C0010        	  4999:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035520 9101            	  5000:     subx.b  D1,D0   ; SBC #$08
02:00035522 0A3C0010        	  5001:     eori    #$10,CCR  ; restore X = 6502 C
