02:0003B268 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003B26C E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003B26E 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003B272 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003B276 C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B278 6716            	  6312:     beq  _L_z04_Digdogger_Move_Down
02:0003B27A 10342070        	  6313:     move.b  ($70,A4,D2.W),D0
