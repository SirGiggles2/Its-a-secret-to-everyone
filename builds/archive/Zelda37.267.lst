02:00039C4E 163C00D8        	  3240:     move.b  #$D8,D3
                            	  3241: _anon_z04_45:
02:00039C52 1883            	  3242:     move.b  D3,($0000,A4)
                            	  3243:     ; [01] holds Link's X coordinate.
                            	  3244:     ;
