02:0004A9A6 19400001        	  4869:     move.b  D0,($0001,A4)
                            	  4870:     even
                            	  4871: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:0004A9AA 101D            	  4872:     move.b  (A5)+,D0  ; PLA
                            	  4873:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4874:     ; This makes the shot flash by cycling all the palettes, one each frame.
                            	  4875:     ;
                            	  4876:     ;
                            	  4877:     ; Call this only to get reverse direction index.
02:0004A9AC 4EB90003095C    	  4878:     jsr     GetOppositeDir
02:0004A9B2 102C0015        	  4879:     move.b  ($0015,A4),D0
02:0004A9B6 02000003        	  4880:     andi.b #$03,D0
02:0004A9BA 41F90004AC76    	  4881:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004A9C0 12303000        	  4882:     move.b  (A0,D3.W),D1
02:0004A9C4 8001            	  4883:     or.b  D1,D0
02:0004A9C6 4EB900031158    	  4884:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4885:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4886:     ;
02:0004A9CC 41F90004AC72    	  4887:     lea     (RDirectionToWeaponFrame).l,A0
02:0004A9D2 10303000        	  4888:     move.b  (A0,D3.W),D0
02:0004A9D6 1940000C        	  4889:     move.b  D0,($000C,A4)
                            	  4890:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4891:     ;
02:0004A9DA 0C030002        	  4892:     cmpi.b  #$02,D3
02:0004A9DE 6604            	  4893:     bne  _anon_z07_24
02:0004A9E0 522C000F        	  4894:     addq.b  #1,($000F,A4)
                            	  4895: _anon_z07_24:
                            	  4896:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4897:     ;   $57 (sword shot) => $22
                            	  4898:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4899:     ;
02:0004A9E4 7622            	  4900:     moveq   #34,D3
02:0004A9E6 0C02000D        	  4901:     cmpi.b  #$0D,D2
02:0004A9EA 6410            	  4902:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004A9EC 41EC034F        	  4903:     lea     ($034F,A4),A0
02:0004A9F0 10302000        	  4904:     move.b  (A0,D2.W),D0
02:0004A9F4 0C000057        	  4905:     cmpi.b  #$57,D0
02:0004A9F8 6710            	  4906:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004A9FA 660C            	  4907:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4908:     even
                            	  4909: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4910:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4911:     ;   high bit set (magic)   => $23
                            	  4912:     ;   high bit clear (sword) => $22
                            	  4913:     ;
02:0004A9FC 41EC00AC        	  4914:     lea     ($00AC,A4),A0
02:0004AA00 10302000        	  4915:     move.b  (A0,D2.W),D0
02:0004AA04 E308            	  4916:     lsl.b  #1,D0   ; ASL A
02:0004AA06 6402            	  4917:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4918:     even
