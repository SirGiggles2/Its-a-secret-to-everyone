02:00035558 7000            	  5026:     moveq   #0,D0
02:0003555A 6508            	  5027:     bcs  _anon_z02_39
02:0003555C 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:00035560 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
