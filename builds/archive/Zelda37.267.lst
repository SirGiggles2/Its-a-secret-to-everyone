                            	  7291: Dodongo_Draw:
02:0003B966 610000F4        	  7292:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7293:     ; Make a 5-way direction index out of the facing direction
                            	  7294:     ; by shifting right once, and store it in [00].
                            	  7295:     ;
02:0003B96A 41EC0098        	  7296:     lea     ($0098,A4),A0
02:0003B96E 10302000        	  7297:     move.b  (A0,D2.W),D0
02:0003B972 E208            	  7298:     lsr.b  #1,D0   ; LSR A
02:0003B974 1880            	  7299:     move.b  D0,($0000,A4)
                            	  7300:     ; If state = 0, go handle animating the two frames of this state.
                            	  7301:     ;
02:0003B976 7600            	  7302:     moveq   #0,D3
02:0003B978 41EC00AC        	  7303:     lea     ($00AC,A4),A0
02:0003B97C 16302000        	  7304:     move.b  (A0,D2.W),D3
02:0003B980 6744            	  7305:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7306:     ; If state > 1, then the monster is stunned (state 2).
                            	  7307:     ; So, go switch frames every $20 screen frames.
                            	  7308:     ;
02:0003B982 7020            	  7309:     moveq   #32,D0
02:0003B984 5303            	  7310:     subq.b  #1,D3
02:0003B986 6640            	  7311:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7312:     ; State = 1. Bloated.
                            	  7313:     ;
                            	  7314:     ; In substate 0, go animate as usual for walking.
                            	  7315:     ;
02:0003B988 7600            	  7316:     moveq   #0,D3
02:0003B98A 41EC042C        	  7317:     lea     ($042C,A4),A0
02:0003B98E 16302000        	  7318:     move.b  (A0,D2.W),D3
02:0003B992 6732            	  7319:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7320:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7321:     ; go fade the boss; so that some frames are not drawn.
                            	  7322:     ;
02:0003B994 0C030002        	  7323:     cmpi.b  #$02,D3
02:0003B998 6718            	  7324:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003B99A 0C030003        	  7325:     cmpi.b  #$03,D3
02:0003B99E 6712            	  7326:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7327:     ; State 1, substate 1
                            	  7328:     ;
                            	  7329:     ; Add $14 to the frame image index to index into the bloated
                            	  7330:     ; frame images and H-flips.
                            	  7331:     ;
02:0003B9A0 1014            	  7332:     move.b  ($0000,A4),D0
02:0003B9A2 023C00EE        	  7333:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B9A6 123C0014        	  7334:     move.b  #$14,D1
02:0003B9AA D101            	  7335:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003B9AC 7600            	  7336:     moveq   #0,D3
02:0003B9AE 1600            	  7337:     move.b  D0,D3
02:0003B9B0 6032            	  7338:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7339: 
                            	  7340:     even
                            	  7341: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7342:     ; In bloated substates 2 and 3:
                            	  7343:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7344:     ;
02:0003B9B2 102C0015        	  7345:     move.b  ($0015,A4),D0
02:0003B9B6 02000002        	  7346:     andi.b #$02,D0
02:0003B9BA 6604            	  7347:     bne.s  __far_z_04_0066
02:0003B9BC 600000A4        	  7348:     jmp  L11B00_Exit
                            	  7349: __far_z_04_0066:
02:0003B9C0 7600            	  7350:     moveq   #0,D3
02:0003B9C2 1614            	  7351:     move.b  ($0000,A4),D3
02:0003B9C4 601E            	  7352:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7353: 
                            	  7354:     even
                            	  7355: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7356:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7357:     ;
02:0003B9C6 7008            	  7358:     moveq   #8,D0
                            	  7359:     even
                            	  7360: _L_z04_Dodongo_Draw_DrawWalking:
02:0003B9C8 7600            	  7361:     moveq   #0,D3
02:0003B9CA 1614            	  7362:     move.b  ($0000,A4),D3
02:0003B9CC 122C0015        	  7363:     move.b  ($0015,A4),D1
02:0003B9D0 C001            	  7364:     and.b  D1,D0
02:0003B9D2 6710            	  7365:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7366:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7367:     ; in order to index into the second set of frame image numbers.
                            	  7368:     ;
02:0003B9D4 1003            	  7369:     move.b  D3,D0
02:0003B9D6 023C00EE        	  7370:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B9DA 123C0005        	  7371:     move.b  #$05,D1
02:0003B9DE D101            	  7372:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003B9E0 7600            	  7373:     moveq   #0,D3
02:0003B9E2 1600            	  7374:     move.b  D0,D3
                            	  7375:     even
                            	  7376: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7377:     ; Start preparing sprites.
                            	  7378:     ;
02:0003B9E4 4EB90004B7B0    	  7379:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B9EA 1003            	  7380:     move.b  D3,D0
02:0003B9EC 1B00            	  7381:     move.b  D0,-(A5)  ; PHA
                            	  7382:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7383:     ;
02:0003B9EE 41F90003B948    	  7384:     lea     (DodongoFrameHFlips).l,A0
02:0003B9F4 10303000        	  7385:     move.b  (A0,D3.W),D0
02:0003B9F8 1940000F        	  7386:     move.b  D0,($000F,A4)
02:0003B9FC 41F90003B93E    	  7387:     lea     (DodongoFrameImages).l,A0
02:0003BA02 10303000        	  7388:     move.b  (A0,D3.W),D0
                            	  7389:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7390:     ; They are drawn mirrored.
                            	  7391:     ;
02:0003BA06 0C000007        	  7392:     cmpi.b  #$07,D0
02:0003BA0A 6706            	  7393:     beq  _anon_z04_92
02:0003BA0C 0C000009        	  7394:     cmpi.b  #$09,D0
02:0003BA10 6608            	  7395:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7396: _anon_z04_92:
02:0003BA12 4EB900030E62    	  7397:     jsr     DrawObjectMirrored
02:0003BA18 6006            	  7398:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7399: 
                            	  7400:     even
                            	  7401: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7402:     ; No other frame images are mirrored.
                            	  7403:     ;
02:0003BA1A 4EB900030E66    	  7404:     jsr     DrawObjectNotMirrored
                            	  7405:     even
                            	  7406: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003BA20 101D            	  7407:     move.b  (A5)+,D0  ; PLA
02:0003BA22 7600            	  7408:     moveq   #0,D3
02:0003BA24 1600            	  7409:     move.b  D0,D3
                            	  7410:     ; If facing vertically, then return. There's no other side to draw.
                            	  7411:     ;
02:0003BA26 41EC0098        	  7412:     lea     ($0098,A4),A0
02:0003BA2A 10302000        	  7413:     move.b  (A0,D2.W),D0
02:0003BA2E 02000003        	  7414:     andi.b #$03,D0
02:0003BA32 6602            	  7415:     bne.s  __far_z_04_0067
02:0003BA34 602C            	  7416:     jmp  L11B00_Exit
                            	  7417: __far_z_04_0067:
                            	  7418:     ; Else draw the right side.
                            	  7419:     ;
                            	  7420:     ; Keep the Y coordinate in [01].
                            	  7421:     ; But, store (X + $10) in [00].
                            	  7422:     ;
02:0003BA36 10342070        	  7423:     move.b  ($70,A4,D2.W),D0
02:0003BA3A 023C00EE        	  7424:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA3E 123C0010        	  7425:     move.b  #$10,D1
02:0003BA42 D101            	  7426:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BA44 1880            	  7427:     move.b  D0,($0000,A4)
02:0003BA46 6114            	  7428:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7429:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7430:     ;
                            	  7431:     ; So, if we had animation frame 1, direction left:
                            	  7432:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7433:     ; - frame image index = 6 (1 + 5)
                            	  7434:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7435:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7436:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7437:     ;
                            	  7438:     ; So, 3 would have been the frame number used above for
                            	  7439:     ; the left side.
                            	  7440:     ;
                            	  7441:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7442:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7443:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7444:     ; on the right.
                            	  7445:     ;
02:0003BA48 41F90003B93E    	  7446:     lea     (DodongoFrameImages).l,A0
02:0003BA4E 10303000        	  7447:     move.b  (A0,D3.W),D0
02:0003BA52 0A000001        	  7448:     eori.b #$01,D0
02:0003BA56 4EF900030E66    	  7449:     jmp     DrawObjectNotMirrored
                            	  7450: 
                            	  7451: ; Returns:
                            	  7452: ; A: 3
                            	  7453: ; [04]: left sprite attributes
                            	  7454: ; [05]: right sprite attributes
                            	  7455: ;
                            	  7456:     even
                            	  7457: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003BA5C 4EF90002C310    	  7458:     jmp     c_anim_set_sprite_desc_level_palette_row
