02:0003B286 9101            	  6316:     subx.b  D1,D0   ; SBC $03
02:0003B288 0A3C0010        	  6317:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B28C 19802070        	  6318:     move.b  D0,($70,A4,D2.W)
                            	  6319:     even
