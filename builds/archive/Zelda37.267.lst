02:00039AF4 7600            	  3058:     moveq   #0,D3
02:00039AF6 41EC00AC        	  3059:     lea     ($00AC,A4),A0
02:00039AFA 16302000        	  3060:     move.b  (A0,D2.W),D3
02:00039AFE 0C030002        	  3061:     cmpi.b  #$02,D3
