02:0004B114 FF              	  5943:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004B115 01
02:0004B116 00
02:0004B117 F8
02:0004B118 FF
02:0004B119 01
02:0004B11A F5
02:0004B11B 0B
02:0004B11C FF              	  5944:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004B11D 01
02:0004B11E F9
02:0004B11F 07
02:0004B120 FF
02:0004B121 01
02:0004B122 FD
02:0004B123 03
                            	  5945: 
                            	  5946: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5947: ; Each set contains 4 offsets in reverse direction index order:
                            	  5948: ; up, down, left, right
                            	  5949: ;
                            	  5950: ; These offsets are added to player Y to get weapon Y.
                            	  5951: ;
                            	  5952:     even
