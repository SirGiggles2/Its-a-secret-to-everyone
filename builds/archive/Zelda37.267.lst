02:00039DFC 4EB90004B7B0    	  3456:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3457:     ; If facing down, then use frame image offset 2.
                            	  3458:     ;
02:00039E02 41EC0098        	  3459:     lea     ($0098,A4),A0
02:00039E06 10302000        	  3460:     move.b  (A0,D2.W),D0
02:00039E0A 7600            	  3461:     moveq   #0,D3
02:00039E0C 1600            	  3462:     move.b  D0,D3
02:00039E0E 0200000C        	  3463:     andi.b #$0C,D0
