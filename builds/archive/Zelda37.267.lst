                            	  5786:     ; If deferred bounce direction <> 0, then
                            	  5787:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  5788:     ;
02:0003AE8E 41EC03BC        	  5789:     lea     ($03BC,A4),A0
02:0003AE92 10302000        	  5790:     move.b  (A0,D2.W),D0
02:0003AE96 6712            	  5791:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003AE98 41EC0098        	  5792:     lea     ($0098,A4),A0
02:0003AE9C 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:0003AEA0 7000            	  5794:     moveq   #0,D0
02:0003AEA2 41EC03BC        	  5795:     lea     ($03BC,A4),A0
02:0003AEA6 11802000        	  5796:     move.b  D0,(A0,D2.W)
                            	  5797:     even
                            	  5798: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  5799:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  5800:     ;
02:0003AEAA 7004            	  5801:     moveq   #4,D0
02:0003AEAC 1880            	  5802:     move.b  D0,($0000,A4)
                            	  5803:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  5804:     ;
02:0003AEAE 7600            	  5805:     moveq   #0,D3
02:0003AEB0 0C020005        	  5806:     cmpi.b  #$05,D2
02:0003AEB4 6702            	  5807:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003AEB6 7605            	  5808:     moveq   #5,D3
                            	  5809:     even
                            	  5810: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  5811:     ; Copy old direction from a higher slot to the lower one;
                            	  5812:     ; and to the lower one's facing direction.
                            	  5813:     ;
02:0003AEB8 41EC0382        	  5814:     lea     ($0382,A4),A0
02:0003AEBC 10303000        	  5815:     move.b  (A0,D3.W),D0
02:0003AEC0 41EC0381        	  5816:     lea     ($0381,A4),A0
02:0003AEC4 11803000        	  5817:     move.b  D0,(A0,D3.W)
02:0003AEC8 41EC0099        	  5818:     lea     ($0099,A4),A0
02:0003AECC 11803000        	  5819:     move.b  D0,(A0,D3.W)
                            	  5820:     ; Bottom of the loop.
                            	  5821:     ; Increment segment index.
                            	  5822:     ; Decrement loop counter.
                            	  5823:     ;
02:0003AED0 5203            	  5824:     addq.b  #1,D3
02:0003AED2 5314            	  5825:     subq.b  #1,($0000,A4)
02:0003AED4 66E2            	  5826:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  5827:     ; Copy current direction to old direction.
                            	  5828:     ;
02:0003AED6 41EC0098        	  5829:     lea     ($0098,A4),A0
02:0003AEDA 10302000        	  5830:     move.b  (A0,D2.W),D0
02:0003AEDE 41EC0380        	  5831:     lea     ($0380,A4),A0
02:0003AEE2 11802000        	  5832:     move.b  D0,(A0,D2.W)
                            	  5833:     even
