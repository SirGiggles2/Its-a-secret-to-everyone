                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:0003EE96 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:0003EE98 7400            	   545:     moveq   #0,D2
02:0003EE9A 41F90003EE4E    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0003EEA0 14303000        	   547:     move.b  (A0,D3.W),D2
02:0003EEA4 41F90003EE7E    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0003EEAA 10303000        	   549:     move.b  (A0,D3.W),D0
02:0003EEAE 41F900045EA6    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003EEB4 11802000        	   551:     move.b  D0,(A0,D2.W)
02:0003EEB8 5303            	   552:     subq.b  #1,D3
02:0003EEBA 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0003EEBC 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0003EEBE 7001            	   561:     moveq   #1,D0
02:0003EEC0 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0003EEC4 7003            	   569:     moveq   #3,D0
02:0003EEC6 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:0003EECA 7400            	   576:     moveq   #0,D2
02:0003EECC 41F90003EE4E    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0003EED2 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:0003EED6 102C0006        	   585:     move.b  ($0006,A4),D0
02:0003EEDA 122C0671        	   586:     move.b  ($0671,A4),D1
02:0003EEDE C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EEE0 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:0003EEE2 41F900045EA6    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003EEE8 10302000        	   599:     move.b  (A0,D2.W),D0
02:0003EEEC 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:0003EEF0 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003EEF2 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:0003EEF6 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003EEF8 41F90003EE66    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003EEFE 10303000        	   605:     move.b  (A0,D3.W),D0
02:0003EF02 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003EF04 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:0003EF08 41F900045EA6    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003EF0E 11802000        	   613:     move.b  D0,(A0,D2.W)
                            	   614:     even
                            	   615: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   616:     ; Bottom of the inner loop.
                            	   617:     ;
                            	   618:     ; Increment the triforce tile slot.
                            	   619:     ; Decrement [07] and loop again, if it's not 0.
                            	   620:     ;
02:0003EF12 5203            	   621:     addq.b  #1,D3
02:0003EF14 532C0007        	   622:     subq.b  #1,($0007,A4)
02:0003EF18 66B0            	   623:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   624:     ; Bottom of the outer loop.
                            	   625:     ;
                            	   626:     ; Shift the level test bit [06] left to test the next level.
                            	   627:     ; When it becomes 0, we're done.
                            	   628:     ;
02:0003EF1A 122C0006        	   629:     move.b  ($0006,A4),D1
02:0003EF1E E309            	   630:     lsl.b  #1,D1   ; ASL $06
02:0003EF20 19410006        	   631:     move.b  D1,($0006,A4)
02:0003EF24 669E            	   632:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003EF26 522C00E1        	   633:     addq.b  #1,($00E1,A4)
02:0003EF2A 4E75            	   634:     rts
                            	   635: 
                            	   636:     even
                            	   637: ScrollWorld:
02:0003EF2C 102C0015        	   638:     move.b  ($0015,A4),D0
                            	   639:     ; The purpose of this is to delay vertical scrolling.
                            	   640:     ; OW: once every two frames
                            	   641:     ; UW: once every four frames
                            	   642:     ; Horizontal scrolling happens every frame.
02:0003EF30 02000003        	   643:     andi.b #$03,D0
02:0003EF34 7600            	   644:     moveq   #0,D3
02:0003EF36 162C0010        	   645:     move.b  ($0010,A4),D3
02:0003EF3A 6604            	   646:     bne  _anon_z05_8
02:0003EF3C 02000001        	   647:     andi.b #$01,D0
                            	   648: _anon_z05_8:
02:0003EF40 122C00E6        	   649:     move.b  ($00E6,A4),D1
02:0003EF44 B001            	   650:     cmp.b   D1,D0
02:0003EF46 6704            	   651:     beq.s  __far_z_05_0004
02:0003EF48 600000DE        	   652:     jmp  ScrollWorldH
                            	   653: __far_z_05_0004:
02:0003EF4C 7008            	   654:     moveq   #8,D0
02:0003EF4E 122C0098        	   655:     move.b  ($0098,A4),D1
02:0003EF52 C200            	   656:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EF54 6602            	   657:     bne.s  __far_z_05_0005
02:0003EF56 606E            	   658:     jmp  ScrollWorldDownOrH
                            	   659: __far_z_05_0005:
                            	   660:     ; then scroll up.
                            	   661:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   662:     ;
02:0003EF58 532C00E9        	   663:     subq.b  #1,($00E9,A4)
02:0003EF5C 102C0084        	   664:     move.b  ($0084,A4),D0
02:0003EF60 0C0000DD        	   665:     cmpi.b  #$DD,D0
02:0003EF64 640A            	   666:     bcc  _anon_z05_9
02:0003EF66 123C0008        	   667:     move.b  #$08,D1
02:0003EF6A D101            	   668:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003EF6C 19400084        	   669:     move.b  D0,($0084,A4)
                            	   670: _anon_z05_9:
02:0003EF70 102C00E2        	   671:     move.b  ($00E2,A4),D0
02:0003EF74 003C0011        	   672:     ori     #$11,CCR  ; SEC: set C+X
02:0003EF78 123C0020        	   673:     move.b  #$20,D1
02:0003EF7C 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EF80 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:0003EF82 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF86 194000E2        	   677:     move.b  D0,($00E2,A4)
02:0003EF8A 6404            	   678:     bcc  _anon_z05_10
02:0003EF8C 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
02:0003EF90 0C0000E0        	   681:     cmpi.b  #$E0,D0
02:0003EF94 661E            	   682:     bne  _L_z05_ScrollWorld_Exit
02:0003EF96 102C0058        	   683:     move.b  ($0058,A4),D0
02:0003EF9A 0C000020        	   684:     cmpi.b  #$20,D0
02:0003EF9E 6716            	   685:     beq  _L_z05_ScrollWorld_LimitLow
02:0003EFA0 0C000027        	   686:     cmpi.b  #$27,D0
02:0003EFA4 660E            	   687:     bne  _L_z05_ScrollWorld_Exit
                            	   688:     ; VScroll address is $27E0. So, we rolled from the
                            	   689:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   690:     ; to $23A0, the true last row of NT 0.
02:0003EFA6 7023            	   691:     moveq   #35,D0
02:0003EFA8 19400058        	   692:     move.b  D0,($0058,A4)
02:0003EFAC 103C00A0        	   693:     move.b  #$A0,D0
02:0003EFB0 194000E2        	   694:     move.b  D0,($00E2,A4)
                            	   695:     even
                            	   696: _L_z05_ScrollWorld_Exit:
02:0003EFB4 4E75            	   697:     rts
                            	   698: 
                            	   699:     even
                            	   700: _L_z05_ScrollWorld_LimitLow:
                            	   701:     ; Don't let the scroll position go above $2100, the bottom of
                            	   702:     ; the status bar; nor below $2800, the top of NT 2.
02:0003EFB6 522C0058        	   703:     addq.b  #1,($0058,A4)
                            	   704:     even
