                            	  1823:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1824:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1825:     ; - layout $23: pattern 1: 2 statues
                            	  1826:     ; - layout $24: pattern 0: 4 statues
                            	  1827:     ;
02:0003928C 4EB90004980E    	  1828:     jsr     GetUniqueRoomId
02:00039292 7601            	  1829:     moveq   #1,D3
                            	  1830: _anon_z04_30:
02:00039294 41F900039266    	  1831:     lea     (StatueRoomLayouts).l,A0
02:0003929A 12303000        	  1832:     move.b  (A0,D3.W),D1
02:0003929E B001            	  1833:     cmp.b   D1,D0
02:000392A0 670A            	  1834:     beq  _L_z04_UpdateStatues_Shoot
02:000392A2 5303            	  1835:     subq.b  #1,D3
02:000392A4 6AEE            	  1836:     bpl  _anon_z04_30
