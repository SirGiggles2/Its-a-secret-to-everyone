02:0004AF8E 4EB900030974    	  5755:     jsr     SetBoomerangSpeed
02:0004AF94 102C000A        	  5756:     move.b  ($000A,A4),D0
02:0004AF98 1940000F        	  5757:     move.b  D0,($000F,A4)
02:0004AF9C 41EC0098        	  5758:     lea     ($0098,A4),A0
02:0004AFA0 11802000        	  5759:     move.b  D0,(A0,D2.W)
