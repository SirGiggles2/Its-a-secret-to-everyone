                            	 10069: _L_z04_UpdateGleeok_LoadNeckBytes:
                            	 10070:     ; Load neck data.
                            	 10071:     ;
                            	 10072:     ; For each segment from 5 to 0, indexed by Y register:
                            	 10073:     ; - load coordinates into object slots 6 to 1
                            	 10074:     ; - load miscellany into an array at [0413]
                            	 10075:     ;
02:0003CE3E 1214            	 10076:     move.b  ($00,A4),D1   ; ptr lo
02:0003CE40 182C0001        	 10077:     move.b  ($01,A4),D4  ; ptr hi
02:0003CE44 024100FF        	 10078:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003CE48 E14C            	 10079:     lsl.w   #8,D4
02:0003CE4A 8841            	 10080:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003CE4C 48C4            	 10081:     ext.l   D4
02:0003CE4E D8BC00FF0000    	 10082:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003CE54 2044            	 10083:     movea.l D4,A0
02:0003CE56 10303000        	 10084:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003CE5A 19803071        	 10085:     move.b  D0,($71,A4,D3.W)
02:0003CE5E 122C0002        	 10086:     move.b  ($02,A4),D1   ; ptr lo
02:0003CE62 182C0003        	 10087:     move.b  ($03,A4),D4  ; ptr hi
02:0003CE66 024100FF        	 10088:     andi.w  #$00FF,D1         ; zero-extend lo byte
