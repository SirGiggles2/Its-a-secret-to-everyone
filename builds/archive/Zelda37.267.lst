02:00039DE4 16302000        	  3444:     move.b  (A0,D2.W),D3
02:00039DE8 0C030007        	  3445:     cmpi.b  #$07,D3
02:00039DEC 6708            	  3446:     beq  _L_z04_UpdateOctorock_Shoot
02:00039DEE 0C030009        	  3447:     cmpi.b  #$09,D3
02:00039DF2 6702            	  3448:     beq  _L_z04_UpdateOctorock_Shoot
02:00039DF4 E308            	  3449:     lsl.b  #1,D0   ; ASL A
                            	  3450:     even
                            	  3451: _L_z04_UpdateOctorock_Shoot:
                            	  3452:     ; Shoot a flying rock (object type $53).
