02:0003B2D2 122C0002        	  6346:     move.b  ($0002,A4),D1
02:0003B2D6 C200            	  6347:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B2D8 671E            	  6348:     beq  _L_z04_Digdogger_Move_End
02:0003B2DA 41EC0084        	  6349:     lea     ($0084,A4),A0
02:0003B2DE 10302000        	  6350:     move.b  (A0,D2.W),D0
02:0003B2E2 122C0003        	  6351:     move.b  ($0003,A4),D1
02:0003B2E6 0A3C0010        	  6352:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B2EA 9101            	  6353:     subx.b  D1,D0   ; SBC $03
02:0003B2EC 0A3C0010        	  6354:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B2F0 41EC0084        	  6355:     lea     ($0084,A4),A0
