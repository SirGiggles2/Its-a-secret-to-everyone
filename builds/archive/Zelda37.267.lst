                            	  1203: UpdateWhirlwind_Full:
                            	  1204:     ; Get Link's halted state.
                            	  1205:     ;
02:000300A4 102C00AC        	  1206:     move.b  ($00AC,A4),D0
02:000300A8 02000040        	  1207:     andi.b #$40,D0
02:000300AC 7600            	  1208:     moveq   #0,D3
02:000300AE 1600            	  1209:     move.b  D0,D3
                            	  1210:     ; Add 2 to whirlwind X.
                            	  1211:     ;
02:000300B0 7002            	  1212:     moveq   #2,D0
02:000300B2 023C00EE        	  1213:     andi    #$EE,CCR  ; CLC: clear C+X
02:000300B6 12342070        	  1214:     move.b  ($70,A4,D2.W),D1
02:000300BA D101            	  1215:     addx.b  D1,D0   ; ADC ObjX,X
02:000300BC 19802070        	  1216:     move.b  D0,($70,A4,D2.W)
                            	  1217:     ; If Link is not halted or teleporting state = 0, then
                            	  1218:     ; go check for collision with Link.
                            	  1219:     ;
02:000300C0 0C030040        	  1220:     cmpi.b  #$40,D3
02:000300C4 6638            	  1221:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:000300C6 7600            	  1222:     moveq   #0,D3
02:000300C8 162C0522        	  1223:     move.b  ($0522,A4),D3
02:000300CC 6730            	  1224:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1225:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1226:     ;
                            	  1227:     ; Set Link's X to whirlwind's.
                            	  1228:     ;
02:000300CE 19400070        	  1229:     move.b  D0,($0070,A4)
                            	  1230:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1231:     ; the right screen edge and draw.
                            	  1232:     ;
02:000300D2 5303            	  1233:     subq.b  #1,D3
02:000300D4 6776            	  1234:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:000300D6 0C000080        	  1235:     cmpi.b  #$80,D0
02:000300DA 6670            	  1236:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1237:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1238:     ;
                            	  1239:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1240:     ;
02:000300DC E308            	  1241:     lsl.b  #1,D0   ; ASL A
02:000300DE 194000AC        	  1242:     move.b  D0,($00AC,A4)
02:000300E2 19400522        	  1243:     move.b  D0,($0522,A4)
02:000300E6 41EC034F        	  1244:     lea     ($034F,A4),A0
02:000300EA 11802000        	  1245:     move.b  D0,(A0,D2.W)
                            	  1246:     ; Update the player position marker, and draw one last time.
                            	  1247:     ;
02:000300EE 1002            	  1248:     move.b  D2,D0
02:000300F0 1B00            	  1249:     move.b  D0,-(A5)  ; PHA
02:000300F2 61000910        	  1250:     jsr     UpdatePlayerPositionMarker
02:000300F6 101D            	  1251:     move.b  (A5)+,D0  ; PLA
02:000300F8 7400            	  1252:     moveq   #0,D2
02:000300FA 1400            	  1253:     move.b  D0,D2
02:000300FC 6070            	  1254:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1255: 
                            	  1256:     even
                            	  1257: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1258:     ; Link is not halted or teleporting state = 0.
                            	  1259:     ; Try to pick up Link.
                            	  1260:     ;
                            	  1261:     ; If the whirlwind does not collide with Link, then go check
                            	  1262:     ; for the screen's right edge.
                            	  1263:     ;
02:000300FE 610011E4        	  1264:     jsr     CheckLinkCollision
02:00030102 102C0006        	  1265:     move.b  ($0006,A4),D0
02:00030106 6744            	  1266:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1267:     ; Collided with Link.
                            	  1268:     ;
                            	  1269:     ; Make Link face right. Reset shove info and subroom type.
                            	  1270:     ;
02:00030108 7001            	  1271:     moveq   #1,D0
02:0003010A 19400098        	  1272:     move.b  D0,($0098,A4)
02:0003010E E208            	  1273:     lsr.b  #1,D0   ; LSR A
02:00030110 194000C0        	  1274:     move.b  D0,($00C0,A4)
02:00030114 194000D3        	  1275:     move.b  D0,($00D3,A4)
02:00030118 1940005A        	  1276:     move.b  D0,($005A,A4)
                            	  1277:     ; Halt Link (state $40), and hide him.
                            	  1278:     ;
02:0003011C 7040            	  1279:     moveq   #64,D0
02:0003011E 194000AC        	  1280:     move.b  D0,($00AC,A4)
02:00030122 103C00F8        	  1281:     move.b  #$F8,D0
02:00030126 19400248        	  1282:     move.b  D0,($0248,A4)
02:0003012A 1940024C        	  1283:     move.b  D0,($024C,A4)
                            	  1284:     ; Find and set the room that will behave as the previous room
                            	  1285:     ; when scrolling right to the room with the level's entrance.
                            	  1286:     ;
02:0003012E 102C0523        	  1287:     move.b  ($0523,A4),D0
02:00030132 02000007        	  1288:     andi.b #$07,D0
02:00030136 7600            	  1289:     moveq   #0,D3
02:00030138 1600            	  1290:     move.b  D0,D3
02:0003013A 41F90003009C    	  1291:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030140 10303000        	  1292:     move.b  (A0,D3.W),D0
02:00030144 194000EA        	  1293:     move.b  D0,($00EA,A4)
                            	  1294:     ; Set teleporting state 1.
                            	  1295:     ;
02:00030148 522C0522        	  1296:     addq.b  #1,($0522,A4)
                            	  1297:     even
                            	  1298: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1299:     ; If whirlwind's X < $F0, go draw.
                            	  1300:     ;
02:0003014C 10342070        	  1301:     move.b  ($70,A4,D2.W),D0
02:00030150 0C0000F0        	  1302:     cmpi.b  #$F0,D0
02:00030154 6518            	  1303:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1304:     ; The whirlwind has reached the right edge of the screen.
                            	  1305:     ;
                            	  1306:     ; Destroy the object.
                            	  1307:     ;
02:00030156 611A            	  1308:     jsr     DestroyWhirlwind
                            	  1309:     ; If teleporting state <> 0, we picked up Link.
                            	  1310:     ; So, go to the next mode.
                            	  1311:     ;
                            	  1312:     ; Either way, draw one last time.
                            	  1313:     ;
02:00030158 102C0522        	  1314:     move.b  ($0522,A4),D0
02:0003015C 6710            	  1315:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0003015E 1002            	  1316:     move.b  D2,D0
02:00030160 1B00            	  1317:     move.b  D0,-(A5)  ; PHA
02:00030162 4EB90004A62A    	  1318:     jsr     GoToNextModeFromPlay
02:00030168 101D            	  1319:     move.b  (A5)+,D0  ; PLA
02:0003016A 7400            	  1320:     moveq   #0,D2
02:0003016C 1400            	  1321:     move.b  D0,D2
                            	  1322:     even
                            	  1323: _L_z01_UpdateWhirlwind_Full_Draw:
02:0003016E 60000094        	  1324:     jmp     DrawWhirlwind
                            	  1325: 
                            	  1326:     even
                            	  1327: DestroyWhirlwind:
02:00030172 6000B6A0        	  1328:     jmp     c_destroy_whirlwind
                            	  1329: 
                            	  1330: SummonWhirlwind:
                            	  1331:     ; If not in mode 5, return.
                            	  1332:     ;
02:00030176 102C0012        	  1333:     move.b  ($0012,A4),D0
02:0003017A 0C000005        	  1334:     cmpi.b  #$05,D0
02:0003017E 6704            	  1335:     beq.s  __far_z_01_0000
02:00030180 60000080        	  1336:     jmp  L6104_Exit
                            	  1337: __far_z_01_0000:
                            	  1338:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  1339:     ;
02:00030184 6178            	  1340:     jsr     AdvanceTeleportingLevelIndex
02:00030186 102C0523        	  1341:     move.b  ($0523,A4),D0
02:0003018A 02000007        	  1342:     andi.b #$07,D0
02:0003018E 7600            	  1343:     moveq   #0,D3
02:00030190 1600            	  1344:     move.b  D0,D3
02:00030192 41F900049544    	  1345:     lea     (LevelMasks).l,A0
02:00030198 10303000        	  1346:     move.b  (A0,D3.W),D0
02:0003019C 1880            	  1347:     move.b  D0,($0000,A4)
                            	  1348:     even
                            	  1349: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  1350:     ; If there are no triforce pieces, then return.
                            	  1351:     ;
02:0003019E 102C0671        	  1352:     move.b  ($0671,A4),D0
02:000301A2 6602            	  1353:     bne.s  __far_z_01_0001
02:000301A4 605C            	  1354:     jmp  L6104_Exit
                            	  1355: __far_z_01_0001:
                            	  1356:     ; If we have gotten this triforce piece, then go try to make a
                            	  1357:     ; whirlwind.
                            	  1358:     ;
02:000301A6 1214            	  1359:     move.b  ($0000,A4),D1
02:000301A8 C200            	  1360:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000301AA 662C            	  1361:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  1362:     ; We have not gotten this piece.
                            	  1363:     ; First, advance the teleporting index again.
                            	  1364:     ;
02:000301AC 6150            	  1365:     jsr     AdvanceTeleportingLevelIndex
                            	  1366:     ; If the direction Link is facing is an increasing one, then
                            	  1367:     ; rotate the level mask in [00] left to correspond to the higher
                            	  1368:     ; level number. Then go test this new mask.
                            	  1369:     ;
02:000301AE 102C0098        	  1370:     move.b  ($0098,A4),D0
02:000301B2 02000009        	  1371:     andi.b #$09,D0
02:000301B6 6710            	  1372:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:000301B8 1214            	  1373:     move.b  ($0000,A4),D1
02:000301BA E309            	  1374:     lsl.b  #1,D1   ; ASL $00
02:000301BC 1881            	  1375:     move.b  D1,($0000,A4)
02:000301BE 64DE            	  1376:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:000301C0 1214            	  1377:     move.b  ($0000,A4),D1
02:000301C2 E311            	  1378:     roxl.b  #1,D1   ; ROL $00
02:000301C4 1881            	  1379:     move.b  D1,($0000,A4)
02:000301C6 60D6            	  1380:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1381: 
                            	  1382:     even
                            	  1383: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  1384:     ; If instead the direction is a decreasing one, then
                            	  1385:     ; rotate right to correspond to the lower level number.
                            	  1386:     ; Then go test this new mask.
                            	  1387:     ;
02:000301C8 1214            	  1388:     move.b  ($0000,A4),D1
02:000301CA E209            	  1389:     lsr.b  #1,D1   ; LSR $00
02:000301CC 1881            	  1390:     move.b  D1,($0000,A4)
02:000301CE 64CE            	  1391:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:000301D0 1214            	  1392:     move.b  ($0000,A4),D1
02:000301D2 E211            	  1393:     roxr.b  #1,D1   ; ROR $00
02:000301D4 1881            	  1394:     move.b  D1,($0000,A4)
02:000301D6 60C6            	  1395:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1396: 
                            	  1397:     even
                            	  1398: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  1399:     ; If already summoned or in the middle of teleporting, then
                            	  1400:     ; return and don't summon another one.
                            	  1401:     ;
02:000301D8 102C0508        	  1402:     move.b  ($0508,A4),D0
02:000301DC 122C0522        	  1403:     move.b  ($0522,A4),D1
02:000301E0 8001            	  1404:     or.b  D1,D0
02:000301E2 6702            	  1405:     beq.s  __far_z_01_0002
02:000301E4 601C            	  1406:     jmp  L6104_Exit
                            	  1407: __far_z_01_0002:
                            	  1408:     ; Return if we can't find an empty monster slot.
                            	  1409:     ;
02:000301E6 4EB90004BF98    	  1410:     jsr     FindEmptyMonsterSlot
02:000301EC 6602            	  1411:     bne.s  __far_z_01_0003
02:000301EE 6012            	  1412:     jmp  L6104_Exit
                            	  1413: __far_z_01_0003:
                            	  1414:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  1415:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  1416:     ;
02:000301F0 522C0508        	  1417:     addq.b  #1,($0508,A4)
02:000301F4 1003            	  1418:     move.b  D3,D0
02:000301F6 7400            	  1419:     moveq   #0,D2
02:000301F8 1400            	  1420:     move.b  D0,D2
02:000301FA 6000FE9C        	  1421:     jmp     SetUpWhirlwind
                            	  1422: 
                            	  1423:     even
