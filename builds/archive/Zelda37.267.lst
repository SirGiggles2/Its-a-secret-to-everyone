02:0004AF36 7000            	  5705:     moveq   #0,D0
02:0004AF38 41EC00AC        	  5706:     lea     ($00AC,A4),A0
02:0004AF3C 11803000        	  5707:     move.b  D0,(A0,D3.W)
02:0004AF40 0A3C0001        	  5708:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004AF44 4E75            	  5709:     rts
                            	  5710: 
