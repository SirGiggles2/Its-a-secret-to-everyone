                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:00042456 0C000004        	  5969:     cmpi.b  #$04,D0
02:0004245A 6602            	  5970:     bne  _anon_z05_126
02:0004245C 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:0004245E 0C000001        	  5973:     cmpi.b  #$01,D0
02:00042462 6602            	  5974:     bne  _anon_z05_127
02:00042464 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:00042466 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:0004246A 123C0003        	  5980:     move.b  #$03,D1
02:0004246E 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042472 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:00042474 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:00042478 7600            	  5984:     moveq   #0,D3
02:0004247A 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:0004247C 102C0008        	  5992:     move.b  ($0008,A4),D0
02:00042480 6708            	  5993:     beq  _anon_z05_128
02:00042482 0C030005        	  5994:     cmpi.b  #$05,D3
02:00042486 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00042488 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
