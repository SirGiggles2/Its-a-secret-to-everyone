                            	  5767:     ; Shutters and the commands to open a door always change
                            	  5768:     ; tiles.
                            	  5769:     ;
02:00042306 61000130        	  5770:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5771:     even
                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:0004230A 102C0006        	  5777:     move.b  ($0006,A4),D0
02:0004230E 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00042312 1014            	  5783:     move.b  ($0000,A4),D0
02:00042314 41EC0302        	  5784:     lea     ($0302,A4),A0
02:00042318 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:0004231C 5202            	  5786:     addq.b  #1,D2
02:0004231E 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00042322 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00042326 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:0004232A 5202            	  5790:     addq.b  #1,D2
02:0004232C 102C0006        	  5791:     move.b  ($0006,A4),D0
02:00042330 41EC0302        	  5792:     lea     ($0302,A4),A0
02:00042334 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:00042338 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:0004233A 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:0004233E 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:00042340 7020            	  5803:     moveq   #32,D0
02:00042342 122C0001        	  5804:     move.b  ($0001,A4),D1
02:00042346 8001            	  5805:     or.b  D1,D0
02:00042348 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:0004234C 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:00042350 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:00042352 103C00FF        	  5815:     move.b  #$FF,D0
02:00042356 41EC0302        	  5816:     lea     ($0302,A4),A0
02:0004235A 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:0004235E 1002            	  5818:     move.b  D2,D0
02:00042360 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:00042364 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:00042368 102C0054        	  5829:     move.b  ($0054,A4),D0
02:0004236C 02000003        	  5830:     andi.b #$03,D0
02:00042370 6708            	  5831:     beq  _anon_z05_122
02:00042372 7008            	  5832:     moveq   #8,D0
02:00042374 19400027        	  5833:     move.b  D0,($0027,A4)
02:00042378 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:0004237A 102C0054        	  5844:     move.b  ($0054,A4),D0
02:0004237E 0C000004        	  5845:     cmpi.b  #$04,D0
02:00042382 6626            	  5846:     bne  _anon_z05_123
02:00042384 7400            	  5847:     moveq   #0,D2
02:00042386 142C0009        	  5848:     move.b  ($0009,A4),D2
02:0004238A 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:0004238E 102C0055        	  5850:     move.b  ($0055,A4),D0
02:00042392 0A00000F        	  5851:     eori.b #$0F,D0
02:00042396 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:0004239A C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004239C 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:000423A0 7000            	  5859:     moveq   #0,D0
02:000423A2 19400054        	  5860:     move.b  D0,($0054,A4)
02:000423A6 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:000423AA 102C0055        	  5870:     move.b  ($0055,A4),D0
02:000423AE 19400002        	  5871:     move.b  D0,($0002,A4)
02:000423B2 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:000423B6 0C000007        	  5873:     cmpi.b  #$07,D0
02:000423BA 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:000423BC 7400            	  5879:     moveq   #0,D2
02:000423BE 142C0009        	  5880:     move.b  ($0009,A4),D2
02:000423C2 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:000423C6 1003            	  5884:     move.b  D3,D0
02:000423C8 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:000423CC 41F900042288    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:000423D2 12302000        	  5887:     move.b  (A0,D2.W),D1
02:000423D6 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000423D8 7600            	  5889:     moveq   #0,D3
02:000423DA 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:000423DC 1002            	  5893:     move.b  D2,D0
02:000423DE 0A000001        	  5894:     eori.b #$01,D0
02:000423E2 7400            	  5895:     moveq   #0,D2
02:000423E4 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:000423E6 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:000423E8 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:000423EC 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000423F0 E14C            	  5902:     lsl.w   #8,D4
02:000423F2 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:000423F4 48C4            	  5904:     ext.l   D4
02:000423F6 D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000423FC 2044            	  5906:     movea.l D4,A0
02:000423FE 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042402 41F900049544    	  5908:     lea     (LevelMasks).l,A0
02:00042408 12302000        	  5909:     move.b  (A0,D2.W),D1
02:0004240C 8001            	  5910:     or.b  D1,D0
02:0004240E 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:00042410 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00042414 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00042418 E14C            	  5914:     lsl.w   #8,D4
