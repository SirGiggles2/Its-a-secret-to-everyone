02:000304B8 1880            	  1810:     move.b  D0,($0000,A4)
                            	  1811:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  1812:     ; then we'll make 4 traps.
                            	  1813:     ;
02:000304BA 41EC034F        	  1814:     lea     ($034F,A4),A0
02:000304BE 12302000        	  1815:     move.b  (A0,D2.W),D1
02:000304C2 B001            	  1816:     cmp.b   D1,D0
02:000304C4 6702            	  1817:     beq  _L_z01_InitTrap_Full_LoopTrap
