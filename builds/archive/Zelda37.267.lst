                            	  4048: _L_z05_CheckDoorway_InDoorway:
                            	  4049:     ; In a doorway. DoorwayDir is in A.
                            	  4050:     ;
02:00040C2C 1B00            	  4051:     move.b  D0,-(A5)  ; PHA
02:00040C2E 610000DC        	  4052:     jsr     GetPlayerCoordsForDirection
02:00040C32 101D            	  4053:     move.b  (A5)+,D0  ; PLA
