02:0003BFC4 41EC0098        	  8107:     lea     ($0098,A4),A0
02:0003BFC8 10302000        	  8108:     move.b  (A0,D2.W),D0
02:0003BFCC 02000008        	  8109:     andi.b #$08,D0
02:0003BFD0 E208            	  8110:     lsr.b  #1,D0   ; LSR A
02:0003BFD2 E208            	  8111:     lsr.b  #1,D0   ; LSR A
02:0003BFD4 023C00EE        	  8112:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BFD8 41EC03E4        	  8113:     lea     ($03E4,A4),A0
02:0003BFDC 12302000        	  8114:     move.b  (A0,D2.W),D1
02:0003BFE0 D101            	  8115:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003BFE2 4EF900030E62    	  8116:     jmp     DrawObjectMirrored
                            	  8117: 
                            	  8118: ; Description:
                            	  8119: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8120: ; When walking, the object timer is set. When teleporting,
                            	  8121: ; the teleporting distance remaining is set.
                            	  8122: ;
                            	  8123: ; If we have the magic clock, then only go draw and check collisions.
                            	  8124: ;
                            	  8125:     even
                            	  8126: UpdateBlueWizzrobe:
02:0003BFE8 102C066C        	  8127:     move.b  ($066C,A4),D0
02:0003BFEC 6702            	  8128:     beq.s  __far_z_04_0070
02:0003BFEE 6014            	  8129:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8130: __far_z_04_0070:
02:0003BFF0 6116            	  8131:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003BFF2 61000318        	  8132:     jsr     BlueWizzrobe_TryShooting
                            	  8133:     even
                            	  8134: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8135:     ; If the teleporting distance remaining is even, then draw
                            	  8136:     ; and check collisions, else return.
                            	  8137:     ;
                            	  8138:     ; This means that when 0, the monster is walking.
                            	  8139:     ; So, draw and check collisions every frame.
                            	  8140:     ;
                            	  8141:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8142:     ; translucently -- every other frame.
                            	  8143:     ;
02:0003BFF6 41EC0394        	  8144:     lea     ($0394,A4),A0
02:0003BFFA 10302000        	  8145:     move.b  (A0,D2.W),D0
02:0003BFFE E208            	  8146:     lsr.b  #1,D0   ; LSR A
02:0003C000 6402            	  8147:     bcc.s  __far_z_04_0071
02:0003C002 603A            	  8148:     jmp  L11E17_Exit
