02:00039AE6 41EC034F        	  3054:     lea     ($034F,A4),A0
02:00039AEA 16302000        	  3055:     move.b  (A0,D2.W),D3
02:00039AEE 0C030011        	  3056:     cmpi.b  #$11,D3
