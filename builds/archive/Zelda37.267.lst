                            	  3813:     ;
02:0003A024 41EC0492        	  3814:     lea     ($0492,A4),A0
02:0003A028 10302000        	  3815:     move.b  (A0,D2.W),D0
02:0003A02C 66EC            	  3816:     bne  _anon_z04_53
