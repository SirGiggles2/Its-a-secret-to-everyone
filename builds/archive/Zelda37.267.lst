                            	  7559: _anon_z04_96:
                            	  7560:     ; If we have the magic clock, or is stunned, then
                            	  7561:     ; go draw and check collisions.
                            	  7562:     ;
02:0003BB42 102C066C        	  7563:     move.b  ($066C,A4),D0
02:0003BB46 1234203D        	  7564:     move.b  ($3D,A4,D2.W),D1
02:0003BB4A 8001            	  7565:     or.b  D1,D0
02:0003BB4C 660000AE        	  7566:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7567:     ; Every odd screen frame, go straight to drawing
                            	  7568:     ; and checking collisions.
                            	  7569:     ;
02:0003BB50 102C0015        	  7570:     move.b  ($0015,A4),D0
02:0003BB54 E208            	  7571:     lsr.b  #1,D0   ; LSR A
02:0003BB56 6404            	  7572:     bcc.s  __far_z_04_0068
02:0003BB58 60000118        	  7573:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7574: __far_z_04_0068:
                            	  7575:     ; Otherwise move horizontally.
                            	  7576:     ;
02:0003BB5C 61000248        	  7577:     jsr     PolsVoice_MoveX
                            	  7578:     ; If state <> 0, then the monster is jumping.
                            	  7579:     ; Go handle vertical movement.
                            	  7580:     ;
02:0003BB60 41EC00AC        	  7581:     lea     ($00AC,A4),A0
02:0003BB64 10302000        	  7582:     move.b  (A0,D2.W),D0
02:0003BB68 6706            	  7583:     beq  _L_z04_UpdatePolsVoice_State0
02:0003BB6A 61000130        	  7584:     jsr     UpdatePolsVoiceState1_Jumping
