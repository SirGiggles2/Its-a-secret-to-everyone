                            	 12753: Ganon_CheckCollisions:
                            	 12754:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12755:     ; Store in [02] and [03].
                            	 12756:     ;
02:0003E208 10342070        	 12757:     move.b  ($70,A4,D2.W),D0
02:0003E20C 023C00EE        	 12758:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E210 123C0010        	 12759:     move.b  #$10,D1
02:0003E214 D101            	 12760:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003E216 19400002        	 12761:     move.b  D0,($0002,A4)
02:0003E21A 41EC0084        	 12762:     lea     ($0084,A4),A0
02:0003E21E 10302000        	 12763:     move.b  (A0,D2.W),D0
02:0003E222 023C00EE        	 12764:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E226 123C0010        	 12765:     move.b  #$10,D1
02:0003E22A D101            	 12766:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003E22C 19400003        	 12767:     move.b  D0,($0003,A4)
                            	 12768:     ; Check for a collision with Link.
                            	 12769:     ;
                            	 12770:     ; We can't call CheckLinkCollision, because we need to
                            	 12771:     ; customize Ganon's midpoint.
                            	 12772:     ;
                            	 12773:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12774:     ; detection, if Link is invincible. Initialize variables that will
                            	 12775:     ; be returned from the partial collision check routine. Then
                            	 12776:     ; call it.
                            	 12777:     ;
02:0003E230 102C04F0        	 12778:     move.b  ($04F0,A4),D0
02:0003E234 6616            	 12779:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
