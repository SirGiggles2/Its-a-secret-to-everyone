                            	  4922: _L_z07_DrawSwordShotOrMagicShot_WriteSprites:
02:0004AA0A 4EF900031078    	  4923:     jmp     Anim_WriteItemSprites
                            	  4924: 
                            	  4925: ; Params:
                            	  4926: ; X: shot object index
                            	  4927: ;
                            	  4928: ; If the object is a sword shot, go spread out the shot.
                            	  4929: ;
                            	  4930:     even
                            	  4931: HandleShotBlocked:
02:0004AA10 41EC00AC        	  4932:     lea     ($00AC,A4),A0
02:0004AA14 10302000        	  4933:     move.b  (A0,D2.W),D0
02:0004AA18 E308            	  4934:     lsl.b  #1,D0   ; ASL A
02:0004AA1A 6504            	  4935:     bcs.s  __far_z_07_0074
02:0004AA1C 60000082        	  4936:     jmp  SetShotSpreadingState
                            	  4937: __far_z_07_0074:
                            	  4938:     ; This is a magic shot.
                            	  4939:     ;
                            	  4940:     ; If missing the magic book, go deactivate the shot object.
                            	  4941:     ;
02:0004AA20 102C0661        	  4942:     move.b  ($0661,A4),D0
02:0004AA24 6602            	  4943:     bne.s  __far_z_07_0075
02:0004AA26 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:0004AA28 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:0004AA2C 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004AA2E 102C0513        	  4956:     move.b  ($0513,A4),D0
02:0004AA32 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:0004AA34 7000            	  4958:     moveq   #0,D0
02:0004AA36 19400513        	  4959:     move.b  D0,($0513,A4)
02:0004AA3A 4EB9000309B6    	  4960:     jsr     WieldCandle
02:0004AA40 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:0004AA42 19400513        	  4962:     move.b  D0,($0513,A4)
02:0004AA46 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:0004AA48 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:0004AA4C 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:0004AA50 10302000        	  4972:     move.b  (A0,D2.W),D0
02:0004AA54 0C000021        	  4973:     cmpi.b  #$21,D0
02:0004AA58 6702            	  4974:     beq.s  __far_z_07_0076
02:0004AA5A 6038            	  4975:     jmp  DeactivateLinkShot
                            	  4976: __far_z_07_0076:
                            	  4977:     ; Make state $22 for a standing fire.
                            	  4978:     ;
02:0004AA5C 41EC00AC        	  4979:     lea     ($00AC,A4),A0
02:0004AA60 52302000        	  4980:     addq.b  #1,(A0,D2.W)
                            	  4981:     ; Copy the shot's position and direction to the fire.
                            	  4982:     ;
02:0004AA64 760E            	  4983:     moveq   #14,D3
02:0004AA66 10343070        	  4984:     move.b  ($70,A4,D3.W),D0
02:0004AA6A 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:0004AA6E 41EC0084        	  4986:     lea     ($0084,A4),A0
02:0004AA72 10303000        	  4987:     move.b  (A0,D3.W),D0
02:0004AA76 41EC0084        	  4988:     lea     ($0084,A4),A0
02:0004AA7A 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:0004AA7E 41EC0098        	  4990:     lea     ($0098,A4),A0
02:0004AA82 10303000        	  4991:     move.b  (A0,D3.W),D0
02:0004AA86 41EC0098        	  4992:     lea     ($0098,A4),A0
02:0004AA8A 11802000        	  4993:     move.b  D0,(A0,D2.W)
                            	  4994:     ; The fire lasts $4F frames.
                            	  4995:     ; Deactivate the shot.
                            	  4996:     ;
02:0004AA8E 704F            	  4997:     moveq   #79,D0
02:0004AA90 19802028        	  4998:     move.b  D0,($28,A4,D2.W)
                            	  4999:     even
                            	  5000: DeactivateLinkShot:
02:0004AA94 4EF90002BC8C    	  5001:     jmp     c_deactivate_link_shot
                            	  5002: 
