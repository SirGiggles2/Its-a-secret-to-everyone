                            	  2655: UpdateBombFlashEffect:
                            	  2656:     ; If state <> $13, return.
                            	  2657:     ;
02:000309C6 41EC00AC        	  2658:     lea     ($00AC,A4),A0
02:000309CA 10302000        	  2659:     move.b  (A0,D2.W),D0
02:000309CE 0C000013        	  2660:     cmpi.b  #$13,D0
02:000309D2 662E            	  2661:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  2662:     ; The effect involves turning grayscale rendering on and off
                            	  2663:     ; in PPUMASK.
                            	  2664:     ;
                            	  2665:     ; Start by setting A register to the PPU mask shifted right to
                            	  2666:     ; throw away the grayscale bit.
                            	  2667:     ;
02:000309D4 102C00FE        	  2668:     move.b  ($00FE,A4),D0
02:000309D8 E208            	  2669:     lsr.b  #1,D0   ; LSR A
                            	  2670:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  2671:     ;
02:000309DA 7600            	  2672:     moveq   #0,D3
02:000309DC 16342028        	  2673:     move.b  ($28,A4,D2.W),D3
                            	  2674:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  2675:     ; Carry will have been set, because of the comparison (CPY).
                            	  2676:     ;
02:000309E0 0C030016        	  2677:     cmpi.b  #$16,D3
02:000309E4 6706            	  2678:     beq  _anon_z01_54
02:000309E6 0C030011        	  2679:     cmpi.b  #$11,D3
02:000309EA 6604            	  2680:     bne  _L_z01_UpdateBombFlashEffect_Clear
                            	  2681: _anon_z01_54:
02:000309EC E310            	  2682:     roxl.b  #1,D0   ; ROL A
