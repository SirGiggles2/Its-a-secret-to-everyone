02:0002BFAC 670A            	  2391:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2392:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2393:     eori    #$01,CCR
02:0002BFB6 4E75            	  2394:     rts
                            	  2395: .cc_cnras:
02:0002BFB8 023C00FE        	  2396:     andi    #$FE,CCR
02:0002BFBC 0A3C0001        	  2397:     eori    #$01,CCR
02:0002BFC0 4E75            	  2398:     rts
