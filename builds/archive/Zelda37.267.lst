02:0004B1BA 5303            	  6030:     subq.b  #1,D3
02:0004B1BC 66F2            	  6031:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004B1BE 1880            	  6032:     move.b  D0,($0000,A4)
                            	  6033:     ; Set object's direction to player's. It might have changed
