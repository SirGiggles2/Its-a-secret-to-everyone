02:0003BE12 102C0070        	  7895:     move.b  ($0070,A4),D0
02:0003BE16 19802070        	  7896:     move.b  D0,($70,A4,D2.W)
02:0003BE1A 102C0084        	  7897:     move.b  ($0084,A4),D0
02:0003BE1E 41EC0084        	  7898:     lea     ($0084,A4),A0
