02:0003BE42 41EC03D0        	  7912:     lea     ($03D0,A4),A0
02:0003BE46 11802000        	  7913:     move.b  D0,(A0,D2.W)
                            	  7914:     ; Now Link can't move.
                            	  7915:     ;
02:0003BE4A 522C0512        	  7916:     addq.b  #1,($0512,A4)
                            	  7917:     even
