02:0003ECB2 102C00FC        	   306:     move.b  ($00FC,A4),D0
02:0003ECB6 003C0011        	   307:     ori     #$11,CCR  ; SEC: set C+X
02:0003ECBA 123C0003        	   308:     move.b  #$03,D1
02:0003ECBE 0A3C0010        	   309:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
