                            	  7339: _L_z07_InitObject_InitMonsterFromEdge:
02:0004BBEC 7400            	  7340:     moveq   #0,D2
02:0004BBEE 142C0340        	  7341:     move.b  ($0340,A4),D2
                            	  7342:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7343:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7344:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7345:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7346:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7347:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7348:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7349:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7350:     ; corrupting them and causing a deterministic address-error
                            	  7351:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7352:     ; identified by Codex static review.)
                            	  7353: _L_z07_P47_pre_check:
02:0004BBF2 102C0525        	  7354:     move.b  ($0525,A4),D0
02:0004BBF6 020000F0        	  7355:     andi.b  #$F0,D0
02:0004BBFA 0C000040        	  7356:     cmpi.b  #$40,D0
02:0004BBFE 6506            	  7357:     blo     _L_z07_P47_pre_snap
02:0004BC00 0C0000E0        	  7358:     cmpi.b  #$E0,D0
02:0004BC04 6506            	  7359:     blo     _L_z07_P47_pre_ok
                            	  7360: _L_z07_P47_pre_snap:
02:0004BC06 197C00480525    	  7361:     move.b  #$48,($0525,A4)
                            	  7362: _L_z07_P47_pre_ok:
02:0004BC0C 7005            	  7363:     moveq   #5,D0
02:0004BC0E 610004F4        	  7364:     jsr     SwitchBank
02:0004BC12 4EB9000409A6    	  7365:     jsr     FindNextEdgeSpawnCell
                            	  7366:     ; Post-walk 1: bottom-edge snap.
02:0004BC18 102C0525        	  7367:     move.b  ($0525,A4),D0
02:0004BC1C 020000F0        	  7368:     andi.b  #$F0,D0
02:0004BC20 0C0000E0        	  7369:     cmpi.b  #$E0,D0
02:0004BC24 660C            	  7370:     bne     _L_z07_P47_post1_ok
02:0004BC26 197C00480525    	  7371:     move.b  #$48,($0525,A4)
02:0004BC2C 4EB9000409A6    	  7372:     jsr     FindNextEdgeSpawnCell
                            	  7373: _L_z07_P47_post1_ok:
                            	  7374:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7375:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004BC32 7600            	  7376:     moveq   #0,D3
02:0004BC34 162C0525        	  7377:     move.b  ($0525,A4),D3
02:0004BC38 0243000F        	  7378:     andi.w  #$000F,D3
02:0004BC3C C6FC002C        	  7379:     mulu.w  #44,D3
02:0004BC40 203C00FF6530    	  7380:     move.l  #$FF6530,D0
02:0004BC46 D083            	  7381:     add.l   D3,D0
02:0004BC48 7600            	  7382:     moveq   #0,D3
02:0004BC4A 162C0525        	  7383:     move.b  ($0525,A4),D3
02:0004BC4E E84B            	  7384:     lsr.w   #4,D3
02:0004BC50 5943            	  7385:     subi.w  #4,D3
02:0004BC52 E34B            	  7386:     lsl.w   #1,D3
02:0004BC54 D083            	  7387:     add.l   D3,D0
02:0004BC56 2040            	  7388:     movea.l D0,A0
02:0004BC58 1010            	  7389:     move.b  (A0),D0
02:0004BC5A 0C000084        	  7390:     cmpi.b  #$84,D0
02:0004BC5E 6544            	  7391:     blo     _L_z07_P47_post2_ok
                            	  7392:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7393:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7394:     ; writes to the $05xx region.
02:0004BC60 7800            	  7395:     moveq   #0,D4
