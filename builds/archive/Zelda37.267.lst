                            	  3150: _anon_z04_42:
                            	  3151:     ; State 0.
                            	  3152:     ;
                            	  3153:     ; In state we determine whether to burst out of the ground.
                            	  3154:     ; If the long timer has not expired, then return.
                            	  3155:     ;
02:00039BB0 102C004D        	  3156:     move.b  ($004D,A4),D0
02:00039BB4 6674            	  3157:     bne  _L_z04_UpdateRedLeever_Exit
                            	  3158:     ; Only allow two red leevers at a time.
                            	  3159:     ;
02:00039BB6 102C0510        	  3160:     move.b  ($0510,A4),D0
