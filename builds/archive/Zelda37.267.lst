                            	  2525: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2526: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2527: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2528: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2529: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2530: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2531:     even
                            	  2532: ModeE_SyncCharBoardCursorToIndex:
02:00033C2A 4EF90002BADA    	  2533:     jmp     c_mode_e_sync_char_board_cursor
                            	  2534: 
                            	  2535: ModeE_HandleAOrB:
02:00033C30 102C0420        	  2536:     move.b  ($0420,A4),D0
                            	  2537:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2538:     ; the name field.
02:00033C34 6646            	  2539:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00033C36 7600            	  2540:     moveq   #0,D3
02:00033C38 162C0016        	  2541:     move.b  ($0016,A4),D3
02:00033C3C 0C030003        	  2542:     cmpi.b  #$03,D3
02:00033C40 6602            	  2543:     bne.s  __far_z_02_0007
02:00033C42 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:00033C44 41F900033652    	  2548:     lea     (SlotToNameOffset).l,A0
02:00033C4A 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00033C4E 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00033C52 7400            	  2553:     moveq   #0,D2
02:00033C54 41F900033656    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00033C5A 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00033C5E 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00033C60 41F900033622    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00033C66 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00033C6A 41EC0422        	  2561:     lea     ($0422,A4),A0
02:00033C6E 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00033C72 5302            	  2563:     subq.b  #1,D2
02:00033C74 5303            	  2564:     subq.b  #1,D3
02:00033C76 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00033C78 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:00033C7C 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:00033C80 020000C0        	  2577:     andi.b #$C0,D0
02:00033C84 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:00033C88 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00033C8C 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:00033C90 7620            	  2586:     moveq   #32,D3
02:00033C92 19430604        	  2587:     move.b  D3,($0604,A4)
02:00033C96 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00033C98 41EC0422        	  2591:     lea     ($0422,A4),A0
02:00033C9C 10303000        	  2592:     move.b  (A0,D3.W),D0
02:00033CA0 41EC0302        	  2593:     lea     ($0302,A4),A0
02:00033CA4 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:00033CA8 5303            	  2595:     subq.b  #1,D3
02:00033CAA 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00033CAC 19430306        	  2597:     move.b  D3,($0306,A4)
02:00033CB0 7400            	  2598:     moveq   #0,D2
02:00033CB2 142C0421        	  2599:     move.b  ($0421,A4),D2
02:00033CB6 7600            	  2600:     moveq   #0,D3
02:00033CB8 162C041F        	  2601:     move.b  ($041F,A4),D3
02:00033CBC 41F9000335F6    	  2602:     lea     (ModeE_CharMap).l,A0
02:00033CC2 10303000        	  2603:     move.b  (A0,D3.W),D0
02:00033CC6 19400305        	  2604:     move.b  D0,($0305,A4)
02:00033CCA 41EC0638        	  2605:     lea     ($0638,A4),A0
02:00033CCE 11802000        	  2606:     move.b  D0,(A0,D2.W)
                            	  2607:     even
                            	  2608: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00033CD2 102C0070        	  2609:     move.b  ($0070,A4),D0
02:00033CD6 023C00EE        	  2610:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033CDA 123C0008        	  2611:     move.b  #$08,D1
02:00033CDE D101            	  2612:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00033CE0 19400070        	  2613:     move.b  D0,($0070,A4)
02:00033CE4 522C0421        	  2614:     addq.b  #1,($0421,A4)
02:00033CE8 522C0423        	  2615:     addq.b  #1,($0423,A4)
                            	  2616:     ; If VRAM address still points inside the name field,
                            	  2617:     ; then go finish.
                            	  2618:     ;
                            	  2619:     ; The idea is that each name field in nametable begins at
                            	  2620:     ; an address ending in $E. For example, slot 0 has a name
                            	  2621:     ; at VRAM addresses $20CE to $20D5.
                            	  2622:     ;
                            	  2623:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2624:     ; the name field.
                            	  2625:     ;
                            	  2626:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2627:     ; record header.
                            	  2628:     ;
02:00033CEC 102C0070        	  2629:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:00033CF0 0C0000B0        	  2630:     cmpi.b  #$B0,D0
02:00033CF4 6678            	  2631:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2632:     ; The VRAM address now points outside the name field.
                            	  2633:     ; So, wrap around to the beginning of the name field.
                            	  2634:     ;
                            	  2635:     ; For example, $20D6 -> $20CE.
                            	  2636:     ;
02:00033CF6 102C0423        	  2637:     move.b  ($0423,A4),D0
02:00033CFA 003C0011        	  2638:     ori     #$11,CCR  ; SEC: set C+X
02:00033CFE 123C0008        	  2639:     move.b  #$08,D1
02:00033D02 0A3C0010        	  2640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00033D06 9101            	  2641:     subx.b  D1,D0   ; SBC #$08
02:00033D08 0A3C0010        	  2642:     eori    #$10,CCR  ; restore X = 6502 C
02:00033D0C 19400423        	  2643:     move.b  D0,($0423,A4)
                            	  2644:     ; It also means that we went past the end of the save slot
                            	  2645:     ; info name. Set the offset to the beginning of the name.
02:00033D10 7600            	  2646:     moveq   #0,D3
02:00033D12 162C0016        	  2647:     move.b  ($0016,A4),D3
02:00033D16 41F900033652    	  2648:     lea     (SlotToNameOffset).l,A0
02:00033D1C 10303000        	  2649:     move.b  (A0,D3.W),D0
02:00033D20 19400421        	  2650:     move.b  D0,($0421,A4)
                            	  2651:     ; If the name cursor has gone past the end of the field,
                            	  2652:     ; then wrap around.
02:00033D24 102C0070        	  2653:     move.b  ($0070,A4),D0
02:00033D28 0C0000B0        	  2654:     cmpi.b  #$B0,D0
02:00033D2C 6640            	  2655:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:00033D2E 7070            	  2656:     moveq   #112,D0
02:00033D30 19400070        	  2657:     move.b  D0,($0070,A4)
                            	  2658:     even
                            	  2659: ; PATCH P25b: FS2-E backspace handler.
                            	  2660: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2661: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2662: ; one column (8 px), and writes a space ($24) to the erased
                            	  2663: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2664: ; cannot cross into a previous slot's name field.
                            	  2665: _L_z02_ModeE_HandleAOrB_Backspace:
02:00033D34 7600            	  2666:     moveq   #0,D3
02:00033D36 162C0016        	  2667:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00033D3A 41F900033652    	  2668:     lea     (SlotToNameOffset).l,A0
02:00033D40 12303000        	  2669:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:00033D44 102C0421        	  2670:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:00033D48 B001            	  2671:     cmp.b   D1,D0
02:00033D4A 6322            	  2672:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:00033D4C 5300            	  2673:     subq.b  #1,D0
02:00033D4E 19400421        	  2674:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:00033D52 532C0423        	  2675:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:00033D56 122C0070        	  2676:     move.b  ($0070,A4),D1
02:00033D5A 5101            	  2677:     subi.b  #8,D1
02:00033D5C 19410070        	  2678:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:00033D60 7224            	  2679:     moveq   #$24,D1              ; space tile
02:00033D62 7600            	  2680:     moveq   #0,D3
02:00033D64 1600            	  2681:     move.b  D0,D3                ; D3 = erased offset
02:00033D66 41EC0638        	  2682:     lea     ($0638,A4),A0
02:00033D6A 11813000        	  2683:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2684:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2685:     even
                            	  2686: _L_z02_ModeE_HandleAOrB_Exit:
02:00033D6E 60000096        	  2687:     jmp     ModeE_SetNameCursorSpriteX
                            	  2688: 
                            	  2689:     even
                            	  2690: ModeEandF_SetUpCursorSprites:
                            	  2691:     ; Copy almost 3 sprite records ($B bytes) to byte 1 of
                            	  2692:     ; Sprites block. Only sprite 0 byte 0 is missing.
                            	  2693:     ; These are the cursor sprites.
02:00033D72 760A            	  2694:     moveq   #10,D3
                            	  2695:     even
                            	  2696: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:00033D74 41F90003363C    	  2697:     lea     (ModeEandFCursorSprites).l,A0
02:00033D7A 10303000        	  2698:     move.b  (A0,D3.W),D0
02:00033D7E 41EC0201        	  2699:     lea     ($0201,A4),A0
02:00033D82 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:00033D86 5303            	  2701:     subq.b  #1,D3
02:00033D88 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:00033D8A 7600            	  2703:     moveq   #0,D3
02:00033D8C 162C0016        	  2704:     move.b  ($0016,A4),D3
02:00033D90 41F9000335F2    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:00033D96 10303000        	  2706:     move.b  (A0,D3.W),D0
02:00033D9A 19400084        	  2707:     move.b  D0,($0084,A4)
02:00033D9E 19400200        	  2708:     move.b  D0,($0200,A4)
02:00033DA2 102C0012        	  2709:     move.b  ($0012,A4),D0
02:00033DA6 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:00033DAA 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:00033DAC 103C00F3        	  2715:     move.b  #$F3,D0
02:00033DB0 19400201        	  2716:     move.b  D0,($0201,A4)
                            	  2717:     ; Because the visible part of the cursor block sprite is
                            	  2718:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2719:     ; above its ObjY.
02:00033DB4 102C0084        	  2720:     move.b  ($0084,A4),D0
02:00033DB8 003C0011        	  2721:     ori     #$11,CCR  ; SEC: set C+X
02:00033DBC 123C0008        	  2722:     move.b  #$08,D1
02:00033DC0 0A3C0010        	  2723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00033DC4 9101            	  2724:     subx.b  D1,D0   ; SBC #$08
02:00033DC6 0A3C0010        	  2725:     eori    #$10,CCR  ; restore X = 6502 C
02:00033DCA 19400204        	  2726:     move.b  D0,($0204,A4)
02:00033DCE 7070            	  2727:     moveq   #112,D0
02:00033DD0 19400070        	  2728:     move.b  D0,($0070,A4)
02:00033DD4 103C0087        	  2729:     move.b  #$87,D0
02:00033DD8 19400085        	  2730:     move.b  D0,($0085,A4)
02:00033DDC 7030            	  2731:     moveq   #48,D0
02:00033DDE 19400071        	  2732:     move.b  D0,($0071,A4)
                            	  2733:     even
