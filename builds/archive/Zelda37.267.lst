02:0004981C 10342070        	  2360:     move.b  ($70,A4,D2.W),D0
02:00049820 19400003        	  2361:     move.b  D0,($0003,A4)
02:00049824 41EC0084        	  2362:     lea     ($0084,A4),A0
02:00049828 10302000        	  2363:     move.b  (A0,D2.W),D0
02:0004982C 19400002        	  2364:     move.b  D0,($0002,A4)
02:00049830 4EB900030C08    	  2365:     jsr     MapScreenPosToPpuAddr
02:00049836 7400            	  2366:     moveq   #0,D2
02:00049838 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:0004983C 1014            	  2375:     move.b  ($0000,A4),D0
02:0004983E 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00049842 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:00049846 41EC0307        	  2378:     lea     ($0307,A4),A0
02:0004984A 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:0004984E 102C0001        	  2383:     move.b  ($0001,A4),D0
02:00049852 41EC0303        	  2384:     lea     ($0303,A4),A0
02:00049856 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:0004985A 41EC0308        	  2386:     lea     ($0308,A4),A0
02:0004985E 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:00049862 41EC0308        	  2388:     lea     ($0308,A4),A0
02:00049866 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:0004986A 102C0005        	  2392:     move.b  ($0005,A4),D0
02:0004986E 41EC0305        	  2393:     lea     ($0305,A4),A0
02:00049872 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:00049876 41EC0306        	  2395:     lea     ($0306,A4),A0
02:0004987A 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:0004987E 41EC030A        	  2397:     lea     ($030A,A4),A0
02:00049882 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:00049886 41EC030B        	  2399:     lea     ($030B,A4),A0
02:0004988A 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
                            	  2403:     ; Here is an example result of this manipulation:
                            	  2404:     ;   record 1: $70, $71
                            	  2405:     ;   record 2: $72, $73
                            	  2406:     ;
02:0004988E 0C000046        	  2407:     cmpi.b  #$46,D0
02:00049892 6530            	  2408:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00049894 0C0000F3        	  2409:     cmpi.b  #$F3,D0
02:00049898 642A            	  2410:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004989A 023C00EE        	  2411:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004989E 123C0002        	  2412:     move.b  #$02,D1
02:000498A2 D101            	  2413:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000498A4 41EC030A        	  2414:     lea     ($030A,A4),A0
02:000498A8 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:000498AC 41EC030B        	  2416:     lea     ($030B,A4),A0
02:000498B0 11802000        	  2417:     move.b  D0,(A0,D2.W)
02:000498B4 41EC0306        	  2418:     lea     ($0306,A4),A0
02:000498B8 52302000        	  2419:     addq.b  #1,(A0,D2.W)
02:000498BC 41EC030B        	  2420:     lea     ($030B,A4),A0
02:000498C0 52302000        	  2421:     addq.b  #1,(A0,D2.W)
                            	  2422:     even
                            	  2423: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2424:     ; Set the count byte in each record to $82:
                            	  2425:     ; 2 tiles arranged vertically
                            	  2426:     ;
02:000498C4 103C0082        	  2427:     move.b  #$82,D0
02:000498C8 41EC0304        	  2428:     lea     ($0304,A4),A0
02:000498CC 11802000        	  2429:     move.b  D0,(A0,D2.W)
02:000498D0 41EC0309        	  2430:     lea     ($0309,A4),A0
02:000498D4 11802000        	  2431:     move.b  D0,(A0,D2.W)
                            	  2432:     ; Write the end marker.
                            	  2433:     ;
02:000498D8 103C00FF        	  2434:     move.b  #$FF,D0
02:000498DC 41EC030C        	  2435:     lea     ($030C,A4),A0
02:000498E0 11802000        	  2436:     move.b  D0,(A0,D2.W)
                            	  2437:     ; Update dynamic buffer length with 10 new bytes.
                            	  2438:     ;
02:000498E4 1002            	  2439:     move.b  D2,D0
02:000498E6 023C00EE        	  2440:     andi    #$EE,CCR  ; CLC: clear C+X
02:000498EA 123C000A        	  2441:     move.b  #$0A,D1
02:000498EE D101            	  2442:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:000498F0 19400301        	  2443:     move.b  D0,($0301,A4)
02:000498F4 101D            	  2444:     move.b  (A5)+,D0  ; PLA
02:000498F6 7400            	  2445:     moveq   #0,D2
02:000498F8 1400            	  2446:     move.b  D0,D2
02:000498FA 7005            	  2447:     moveq   #5,D0
02:000498FC 61002806        	  2448:     jsr     SwitchBank
