                            	  4007: PondFairy_MoveHearts:
                            	  4008:     ; Loop over each heart from object slot 2 to 9.
                            	  4009:     ;
                            	  4010:     ; Even though they are not standalone objects, their info
                            	  4011:     ; is stored in those object slots.
                            	  4012:     ;
02:0003A156 7402            	  4013:     moveq   #2,D2
                            	  4014:     even
                            	  4015: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4016:     ; If the current heart's state <> 0, then go move it.
                            	  4017:     ; Else we have to wait for it to come out at the right time.
                            	  4018:     ;
02:0003A158 41EC00AC        	  4019:     lea     ($00AC,A4),A0
02:0003A15C 10302000        	  4020:     move.b  (A0,D2.W),D0
02:0003A160 667C            	  4021:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4022:     ; The current heart's state = 0.
                            	  4023:     ;
                            	  4024:     ; If object slot = 2, then go make it appear. This is the first
                            	  4025:     ; heart to show up.
                            	  4026:     ;
02:0003A162 0C020002        	  4027:     cmpi.b  #$02,D2
02:0003A166 6732            	  4028:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4029:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4030:     ; go start over.
                            	  4031:     ;
                            	  4032:     ; TODO:
                            	  4033:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4034:     ;
02:0003A168 102C00AE        	  4035:     move.b  ($00AE,A4),D0
02:0003A16C 67EA            	  4036:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4037:     ; Look up the starting angle of this heart with the index
                            	  4038:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4039:     ; then loop again.
                            	  4040:     ;
02:0003A16E 1002            	  4041:     move.b  D2,D0
02:0003A170 003C0011        	  4042:     ori     #$11,CCR  ; SEC: set C+X
02:0003A174 123C0003        	  4043:     move.b  #$03,D1
02:0003A178 0A3C0010        	  4044:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A17C 9101            	  4045:     subx.b  D1,D0   ; SBC #$03
02:0003A17E 0A3C0010        	  4046:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A182 7600            	  4047:     moveq   #0,D3
02:0003A184 1600            	  4048:     move.b  D0,D3
02:0003A186 102C0396        	  4049:     move.b  ($0396,A4),D0
02:0003A18A 41F90003A14E    	  4050:     lea     (PondHeartStartAngles).l,A0
02:0003A190 12303000        	  4051:     move.b  (A0,D3.W),D1
02:0003A194 B001            	  4052:     cmp.b   D1,D0
02:0003A196 66000086        	  4053:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4054:     even
                            	  4055: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  4056:     ; Set up this heart. Set its state to 1.
                            	  4057:     ;
02:0003A19A 41EC00AC        	  4058:     lea     ($00AC,A4),A0
02:0003A19E 52302000        	  4059:     addq.b  #1,(A0,D2.W)
                            	  4060:     ; TODO: ?
                            	  4061:     ;
02:0003A1A2 103C0080        	  4062:     move.b  #$80,D0
02:0003A1A6 41EC0098        	  4063:     lea     ($0098,A4),A0
02:0003A1AA 11802000        	  4064:     move.b  D0,(A0,D2.W)
                            	  4065:     ; Starting angle $18 (N).
                            	  4066:     ;
02:0003A1AE 7018            	  4067:     moveq   #24,D0
02:0003A1B0 41EC0394        	  4068:     lea     ($0394,A4),A0
02:0003A1B4 11802000        	  4069:     move.b  D0,(A0,D2.W)
                            	  4070:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  4071:     ;
02:0003A1B8 102C0071        	  4072:     move.b  ($0071,A4),D0
02:0003A1BC 19802070        	  4073:     move.b  D0,($70,A4,D2.W)
                            	  4074:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  4075:     ;
02:0003A1C0 102C0085        	  4076:     move.b  ($0085,A4),D0
02:0003A1C4 003C0011        	  4077:     ori     #$11,CCR  ; SEC: set C+X
02:0003A1C8 123C001C        	  4078:     move.b  #$1C,D1
02:0003A1CC 0A3C0010        	  4079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A1D0 9101            	  4080:     subx.b  D1,D0   ; SBC #$1C
02:0003A1D2 0A3C0010        	  4081:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A1D6 41EC0084        	  4082:     lea     ($0084,A4),A0
02:0003A1DA 11802000        	  4083:     move.b  D0,(A0,D2.W)
                            	  4084:     even
                            	  4085: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  4086:     ; Decrease the angle by $00.60.
                            	  4087:     ;
02:0003A1DE 7000            	  4088:     moveq   #0,D0
02:0003A1E0 1940000B        	  4089:     move.b  D0,($000B,A4)
02:0003A1E4 7060            	  4090:     moveq   #96,D0
02:0003A1E6 6100492A        	  4091:     jsr     DecreaseObjectAngle
                            	  4092:     ; Rotate the heart's location by the change in angle.
                            	  4093:     ; Use 6 for the number of bits of sine/cosine to use
                            	  4094:     ; for a large ring.
                            	  4095:     ;
02:0003A1EA 7006            	  4096:     moveq   #6,D0
02:0003A1EC 7600            	  4097:     moveq   #0,D3
02:0003A1EE 1600            	  4098:     move.b  D0,D3
02:0003A1F0 61004770        	  4099:     jsr     RotateObjectLocation
02:0003A1F4 41EC0084        	  4100:     lea     ($0084,A4),A0
02:0003A1F8 11802000        	  4101:     move.b  D0,(A0,D2.W)
02:0003A1FC 1002            	  4102:     move.b  D2,D0
02:0003A1FE 1B00            	  4103:     move.b  D0,-(A5)  ; PHA
02:0003A200 4EB900031156    	  4104:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
02:0003A206 4EB90004B7B0    	  4105:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4106:     ; The variable for the currently updating object slot has to be
                            	  4107:     ; set to the heart's object slot for this drawing routine to work.
                            	  4108:     ;
02:0003A20C 7400            	  4109:     moveq   #0,D2
02:0003A20E 142C0340        	  4110:     move.b  ($0340,A4),D2
02:0003A212 4EB900030E66    	  4111:     jsr     DrawObjectNotMirrored
02:0003A218 101D            	  4112:     move.b  (A5)+,D0  ; PLA
02:0003A21A 7400            	  4113:     moveq   #0,D2
02:0003A21C 1400            	  4114:     move.b  D0,D2
                            	  4115:     even
                            	  4116: _L_z04_PondFairy_MoveHearts_NextLoopHeart:
                            	  4117:     ; Bottom of the loop.
