                            	  3821: UpdateArmos:
02:0003A038 6100E844        	  3822:     jsr     UpdateGoriya
                            	  3823:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3824:     ;
02:0003A03C 41EC00C0        	  3825:     lea     ($00C0,A4),A0
02:0003A040 10302000        	  3826:     move.b  (A0,D2.W),D0
02:0003A044 6702            	  3827:     beq.s  __far_z_04_0033
02:0003A046 602A            	  3828:     jmp  DrawArmosAndCheckCollisions
                            	  3829: __far_z_04_0033:
                            	  3830:     ; Animate.
                            	  3831:     ;
                            	  3832:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3833:     ; then only go draw.
                            	  3834:     ;
02:0003A048 41EC03D0        	  3835:     lea     ($03D0,A4),A0
02:0003A04C 53302000        	  3836:     subq.b  #1,(A0,D2.W)
02:0003A050 6702            	  3837:     beq.s  __far_z_04_0034
02:0003A052 601E            	  3838:     jmp  DrawArmosAndCheckCollisions
                            	  3839: __far_z_04_0034:
                            	  3840:     ; Armos animation frames last 6 screen frames.
                            	  3841:     ;
02:0003A054 7006            	  3842:     moveq   #6,D0
02:0003A056 41EC03D0        	  3843:     lea     ($03D0,A4),A0
02:0003A05A 11802000        	  3844:     move.b  D0,(A0,D2.W)
                            	  3845:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3846:     ; change the position of the shield. To keep fixed it in place,
                            	  3847:     ; there are separate frame images for each animation frame.
                            	  3848:     ;
                            	  3849:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3850:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3851:     ;
                            	  3852:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3853:     ; Then choose the direction at the point of drawing below.
                            	  3854:     ;
02:0003A05E 41EC03E4        	  3855:     lea     ($03E4,A4),A0
02:0003A062 10302000        	  3856:     move.b  (A0,D2.W),D0
02:0003A066 0A000002        	  3857:     eori.b #$02,D0
02:0003A06A 41EC03E4        	  3858:     lea     ($03E4,A4),A0
02:0003A06E 11802000        	  3859:     move.b  D0,(A0,D2.W)
                            	  3860:     even
                            	  3861: DrawArmosAndCheckCollisions:
02:0003A072 4EB90004B7B0    	  3862:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003A078 7600            	  3863:     moveq   #0,D3
02:0003A07A 41EC0098        	  3864:     lea     ($0098,A4),A0
02:0003A07E 16302000        	  3865:     move.b  (A0,D2.W),D3
                            	  3866:     ; If facing up, then use the second frame image in the set ("back").
                            	  3867:     ; Else use the second.
                            	  3868:     ;
02:0003A082 0C030008        	  3869:     cmpi.b  #$08,D3
02:0003A086 6602            	  3870:     bne  _anon_z04_54
02:0003A088 7001            	  3871:     moveq   #1,D0
                            	  3872: _anon_z04_54:
02:0003A08A 023C00EE        	  3873:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A08E 41EC03E4        	  3874:     lea     ($03E4,A4),A0
02:0003A092 12302000        	  3875:     move.b  (A0,D2.W),D1
02:0003A096 D101            	  3876:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003A098 4EB900030E66    	  3877:     jsr     DrawObjectNotMirrored
                            	  3878:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3879:     ; but not with weapons.
                            	  3880:     ;
02:0003A09E 10342028        	  3881:     move.b  ($28,A4,D2.W),D0
02:0003A0A2 661C            	  3882:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3883:     ; Else check for all collisions.
                            	  3884:     ;
02:0003A0A4 4EB9000311E2    	  3885:     jsr     CheckMonsterCollisions
                            	  3886:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3887:     ;
02:0003A0AA 41EC0405        	  3888:     lea     ($0405,A4),A0
02:0003A0AE 10302000        	  3889:     move.b  (A0,D2.W),D0
02:0003A0B2 670A            	  3890:     beq  _anon_z04_55
02:0003A0B4 705D            	  3891:     moveq   #93,D0
02:0003A0B6 41EC034F        	  3892:     lea     ($034F,A4),A0
02:0003A0BA 11802000        	  3893:     move.b  D0,(A0,D2.W)
                            	  3894: _anon_z04_55:
