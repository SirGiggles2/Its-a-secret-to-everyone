02:00039BBE 646A            	  3162:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3163:     ; Face in the same direction as Link.
                            	  3164:     ;
02:00039BC0 102C0098        	  3165:     move.b  ($0098,A4),D0
