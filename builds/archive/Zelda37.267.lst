02:00038A9E 600000D8        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:00038AA2 102C0070        	   725:     move.b  ($0070,A4),D0
02:00038AA6 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:00038AAA B001            	   727:     cmp.b   D1,D0
02:00038AAC 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00038AAE 7600            	   729:     moveq   #0,D3
02:00038AB0 102C0084        	   730:     move.b  ($0084,A4),D0
02:00038AB4 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038AB8 123C0003        	   732:     move.b  #$03,D1
02:00038ABC D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038ABE 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:00038AC2 41EC0084        	   735:     lea     ($0084,A4),A0
02:00038AC6 12302000        	   736:     move.b  (A0,D2.W),D1
02:00038ACA 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038ACE 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:00038AD0 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:00038AD4 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:00038AD6 102C0084        	   747:     move.b  ($0084,A4),D0
02:00038ADA 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038ADE 123C0003        	   749:     move.b  #$03,D1
02:00038AE2 D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038AE4 41EC0084        	   751:     lea     ($0084,A4),A0
02:00038AE8 12302000        	   752:     move.b  (A0,D2.W),D1
