02:0003AF1A 6724            	  5879:     beq  _L_z04_L_Digdogger_AfterFlute_MakeChildren
                            	  5880:     ; Every 8 frames, switch between behaving as a big and little digdogger.
                            	  5881:     ;
                            	  5882:     ; TODO:
                            	  5883:     ; But is this possible, given the following?
                            	  5884:     ; a. all object timers run concurrently
                            	  5885:     ; b. all object updates are paused until the flute timer expires
                            	  5886:     ; c. the flute timer lasts longer
