                            	  4878:     ; to the dynamic transfer buf.
                            	  4879:     ;
02:00035432 7604            	  4880:     moveq   #4,D3
                            	  4881: _anon_z02_35:
02:00035434 41F9000353B0    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
