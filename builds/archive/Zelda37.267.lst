02:0003A2BE 11802000        	  4205:     move.b  D0,(A0,D2.W)
02:0003A2C2 41EC00AC        	  4206:     lea     ($00AC,A4),A0
02:0003A2C6 52302000        	  4207:     addq.b  #1,(A0,D2.W)
                            	  4208:     ; Store current room ID.
