02:000304D2 D101            	  1828:     addx.b  D1,D0   ; ADC CurObjIndex
02:000304D4 7400            	  1829:     moveq   #0,D2
02:000304D6 1400            	  1830:     move.b  D0,D2
                            	  1831:     ; Look up and set the location for this iteration's individual trap.
                            	  1832:     ;
02:000304D8 41F90003049C    	  1833:     lea     (TrapXs).l,A0
02:000304DE 10303000        	  1834:     move.b  (A0,D3.W),D0
02:000304E2 19802070        	  1835:     move.b  D0,($70,A4,D2.W)
02:000304E6 41F9000304A2    	  1836:     lea     (TrapYs).l,A0
02:000304EC 10303000        	  1837:     move.b  (A0,D3.W),D0
02:000304F0 41EC0084        	  1838:     lea     ($0084,A4),A0
02:000304F4 11802000        	  1839:     move.b  D0,(A0,D2.W)
02:000304F8 619E            	  1840:     jsr     InitOneSimpleObject
