                            	  7662: _L_z04_UpdatePolsVoice_SetState1:
                            	  7663:     ; If already in state 1, then go draw and check collisions.
                            	  7664:     ;
02:0003BBFE 41EC00AC        	  7665:     lea     ($00AC,A4),A0
02:0003BC02 10302000        	  7666:     move.b  (A0,D2.W),D0
02:0003BC06 6702            	  7667:     beq.s  __far_z_04_0069
02:0003BC08 6068            	  7668:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7669: __far_z_04_0069:
                            	  7670:     ; Go to state 1.
                            	  7671:     ;
02:0003BC0A 41EC00AC        	  7672:     lea     ($00AC,A4),A0
02:0003BC0E 52302000        	  7673:     addq.b  #1,(A0,D2.W)
                            	  7674:     ; Subtract 1 from facing direction to make an index.
                            	  7675:     ;
02:0003BC12 7600            	  7676:     moveq   #0,D3
02:0003BC14 41EC0098        	  7677:     lea     ($0098,A4),A0
02:0003BC18 16302000        	  7678:     move.b  (A0,D2.W),D3
02:0003BC1C 5303            	  7679:     subq.b  #1,D3
                            	  7680:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7681:     ;
02:0003BC1E 41EC0084        	  7682:     lea     ($0084,A4),A0
02:0003BC22 10302000        	  7683:     move.b  (A0,D2.W),D0
02:0003BC26 0C000078        	  7684:     cmpi.b  #$78,D0
02:0003BC2A 6402            	  7685:     bcc  _anon_z04_97
02:0003BC2C 7603            	  7686:     moveq   #3,D3
                            	  7687: _anon_z04_97:
                            	  7688:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7689:     ;
02:0003BC2E 0C0000A8        	  7690:     cmpi.b  #$A8,D0
02:0003BC32 6502            	  7691:     bcs  _anon_z04_98
02:0003BC34 7607            	  7692:     moveq   #7,D3
                            	  7693: _anon_z04_98:
                            	  7694:     ; Set the vertical speed for the beginning of the jump.
                            	  7695:     ;
02:0003BC36 41F90003BB2A    	  7696:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003BC3C 10303000        	  7697:     move.b  (A0,D3.W),D0
02:0003BC40 41EC0412        	  7698:     lea     ($0412,A4),A0
02:0003BC44 11802000        	  7699:     move.b  D0,(A0,D2.W)
                            	  7700:     ; Look up the Y offset for the current direction.
                            	  7701:     ; Add it to object Y to set the destination Y of the jump.
                            	  7702:     ;
02:0003BC48 41EC0084        	  7703:     lea     ($0084,A4),A0
02:0003BC4C 10302000        	  7704:     move.b  (A0,D2.W),D0
02:0003BC50 023C00EE        	  7705:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC54 41F90003BB32    	  7706:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003BC5A 12303000        	  7707:     move.b  (A0,D3.W),D1
02:0003BC5E D101            	  7708:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003BC60 41EC042C        	  7709:     lea     ($042C,A4),A0
02:0003BC64 11802000        	  7710:     move.b  D0,(A0,D2.W)
                            	  7711:     ; Turn the index into a direction again by adding 1.
                            	  7712:     ; Store the facing direction.
                            	  7713:     ;
02:0003BC68 5203            	  7714:     addq.b  #1,D3
02:0003BC6A 41EC0098        	  7715:     lea     ($0098,A4),A0
