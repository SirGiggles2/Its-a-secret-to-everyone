                            	   948: ;==============================================================================
                            	   949: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   950: ;==============================================================================
                            	   951: 
                            	   952: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   953: c_has_compass:
02:0002B6B2 4EB900000000    	   954:     jsr     z05_has_compass
02:0002B6B8 4A00            	   955:     tst.b   D0
02:0002B6BA 4E75            	   956:     rts
                            	   957: 
                            	   958: c_has_map:
02:0002B6BC 4EB900000000    	   959:     jsr     z05_has_map
02:0002B6C2 4A00            	   960:     tst.b   D0
02:0002B6C4 4E75            	   961:     rts
                            	   962: 
                            	   963: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   964: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   965:     move.l  D0,-(SP)
02:0002B6C8 7200            	   966:     moveq   #0,D1
02:0002B6CA 1202            	   967:     move.b  D2,D1
02:0002B6CC 2F01            	   968:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   969:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   970:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   971:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   972:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   973:     addq.l  #8,SP
02:0002B6E2 201F            	   974:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   975:     rts
                            	   976: 
                            	   977: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	   978: c_add_door_flags:
02:0002B6E6 4EF900000000    	   979:     jmp     z05_add_door_flags
                            	   980: 
                            	   981: ;==============================================================================
                            	   982: ; EXPORT side — z_05 entry points (Stage 4b).
                            	   983: ;==============================================================================
                            	   984: 
                            	   985: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   986: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   987: c_split_room_id:
02:0002B6EC 4EB900000000    	   988:     jsr     z05_split_room_id
02:0002B6F2 7600            	   989:     moveq   #0,D3
02:0002B6F4 1600            	   990:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   991:     lsr.w   #8,D0
02:0002B6F8 7400            	   992:     moveq   #0,D2
02:0002B6FA 1400            	   993:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   994:     rts
                            	   995: 
                            	   996: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	   997: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	   998: c_is_dark_room:
02:0002B6FE 7000            	   999:     moveq   #0,D0
02:0002B700 3003            	  1000:     move.w  D3,D0
02:0002B702 2F00            	  1001:     move.l  D0,-(SP)
02:0002B704 4EB900000000    	  1002:     jsr     z05_is_dark_room
02:0002B70A 588F            	  1003:     addq.l  #4,SP
02:0002B70C 4A00            	  1004:     tst.b   D0
02:0002B70E 4E75            	  1005:     rts
                            	  1006: 
                            	  1007: ; SetDoorFlag — D2=dir_idx. Calls get_room_flags internally, writes flag.
                            	  1008: c_set_door_flag:
02:0002B710 7000            	  1009:     moveq   #0,D0
02:0002B712 3002            	  1010:     move.w  D2,D0
02:0002B714 2F00            	  1011:     move.l  D0,-(SP)
02:0002B716 4EB900000000    	  1012:     jsr     z05_set_door_flag
02:0002B71C 588F            	  1013:     addq.l  #4,SP
02:0002B71E 4E75            	  1014:     rts
                            	  1015: 
