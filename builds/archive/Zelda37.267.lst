02:0003BFA6 6612            	  8087:     bne  _L_z04_CheckVireCollisions_Exit
                            	  8088:     ; If temporarily invincible, then it was harmed.
                            	  8089:     ; Advance the state to split up.
                            	  8090:     ;
02:0003BFA8 41EC04F0        	  8091:     lea     ($04F0,A4),A0
02:0003BFAC 10302000        	  8092:     move.b  (A0,D2.W),D0
02:0003BFB0 6708            	  8093:     beq  _L_z04_CheckVireCollisions_Exit
02:0003BFB2 41EC00AC        	  8094:     lea     ($00AC,A4),A0
02:0003BFB6 52302000        	  8095:     addq.b  #1,(A0,D2.W)
