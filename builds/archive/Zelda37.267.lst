                            	  9535: Manhandla_Draw:
02:0003CA48 4EB90004B7B0    	  9536:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9537:     ; Push the "frame image and sprite attributes" value.
                            	  9538:     ;
02:0003CA4E 41EC0478        	  9539:     lea     ($0478,A4),A0
02:0003CA52 10302000        	  9540:     move.b  (A0,D2.W),D0
02:0003CA56 1B00            	  9541:     move.b  D0,-(A5)  ; PHA
                            	  9542:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9543:     ; passed along as is.
                            	  9544:     ;
02:0003CA58 02000080        	  9545:     andi.b #$80,D0
02:0003CA5C 00000001        	  9546:     ori.b #$01,D0
02:0003CA60 4EB900031158    	  9547:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003CA66 101D            	  9548:     move.b  (A5)+,D0  ; PLA
02:0003CA68 1B00            	  9549:     move.b  D0,-(A5)  ; PHA
                            	  9550:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9551:     ;
02:0003CA6A 02000040        	  9552:     andi.b #$40,D0
02:0003CA6E 6704            	  9553:     beq  _anon_z04_116
02:0003CA70 522C000F        	  9554:     addq.b  #1,($000F,A4)
                            	  9555: _anon_z04_116:
02:0003CA74 101D            	  9556:     move.b  (A5)+,D0  ; PLA
                            	  9557:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9558:     ; These are the 2 frame images of the horizontal hands.
                            	  9559:     ;
                            	  9560:     ; Else draw the base and vertical hands mirrored.
                            	  9561:     ;
02:0003CA76 0200000F        	  9562:     andi.b #$0F,D0
02:0003CA7A 0C000002        	  9563:     cmpi.b  #$02,D0
02:0003CA7E 670C            	  9564:     beq  _anon_z04_117
02:0003CA80 0C000003        	  9565:     cmpi.b  #$03,D0
02:0003CA84 6706            	  9566:     beq  _anon_z04_117
02:0003CA86 4EF900030E62    	  9567:     jmp     DrawObjectMirrored
                            	  9568: 
