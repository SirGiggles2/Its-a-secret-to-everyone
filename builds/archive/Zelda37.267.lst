02:0002EB18 41EC046F        	   433:     lea     ($046F,A4),A0
02:0002EB1C 10303000        	   434:     move.b  (A0,D3.W),D0
02:0002EB20 41EC0448        	   435:     lea     ($0448,A4),A0
02:0002EB24 11802000        	   436:     move.b  D0,(A0,D2.W)
02:0002EB28 5302            	   437:     subq.b  #1,D2
02:0002EB2A 6AE2            	   438:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
