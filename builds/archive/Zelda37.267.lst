02:0003ECD4 522C00E1        	   321:     addq.b  #1,($00E1,A4)
02:0003ECD8 102C0010        	   322:     move.b  ($0010,A4),D0
02:0003ECDC 67000084        	   323:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:0003ECE0 102C0012        	   324:     move.b  ($0012,A4),D0
02:0003ECE4 0C000009        	   325:     cmpi.b  #$09,D0
02:0003ECE8 6778            	   326:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   327:     ; Calculate the X coordinate of the submenu position marker.
                            	   328:     ;
                            	   329:     ; First, mask off the high nibble of the room ID and multiply by
                            	   330:     ; the width of a tile, 8. Store the result in [00].
                            	   331:     ;
02:0003ECEA 102C00EB        	   332:     move.b  ($00EB,A4),D0
02:0003ECEE 0200000F        	   333:     andi.b #$0F,D0
02:0003ECF2 E308            	   334:     lsl.b  #1,D0   ; ASL A
02:0003ECF4 E308            	   335:     lsl.b  #1,D0   ; ASL A
02:0003ECF6 E308            	   336:     lsl.b  #1,D0   ; ASL A
02:0003ECF8 1880            	   337:     move.b  D0,($0000,A4)
                            	   338:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   339:     ; negative or left rotation by ($10 - rotation value).
                            	   340:     ;
                            	   341:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   342:     ; the width of a tile. Then negate it. The final result is the
                            	   343:     ; negative offset.
                            	   344:     ;
02:0003ECFA 103900FF6BAB    	   345:     move.b  (NES_SRAM+$0BAB).l,D0
02:0003ED00 0C000008        	   346:     cmpi.b  #$08,D0
02:0003ED04 6520            	   347:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:0003ED06 7010            	   348:     moveq   #16,D0
02:0003ED08 123900FF6BAB    	   349:     move.b  (NES_SRAM+$0BAB).l,D1
02:0003ED0E 0A3C0010        	   350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003ED12 9101            	   351:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:0003ED14 0A3C0010        	   352:     eori    #$10,CCR  ; restore X = 6502 C
02:0003ED18 E308            	   353:     lsl.b  #1,D0   ; ASL A
02:0003ED1A E308            	   354:     lsl.b  #1,D0   ; ASL A
02:0003ED1C E308            	   355:     lsl.b  #1,D0   ; ASL A
