02:0003BDCC 41EC03D0        	  7868:     lea     ($03D0,A4),A0
02:0003BDD0 11802000        	  7869:     move.b  D0,(A0,D2.W)
02:0003BDD4 7600            	  7870:     moveq   #0,D3
02:0003BDD6 41EC03E4        	  7871:     lea     ($03E4,A4),A0
02:0003BDDA 16302000        	  7872:     move.b  (A0,D2.W),D3
02:0003BDDE 5203            	  7873:     addq.b  #1,D3
02:0003BDE0 1003            	  7874:     move.b  D3,D0
02:0003BDE2 02000003        	  7875:     andi.b #$03,D0
02:0003BDE6 41EC03E4        	  7876:     lea     ($03E4,A4),A0
02:0003BDEA 11802000        	  7877:     move.b  D0,(A0,D2.W)
                            	  7878:     even
                            	  7879: _L_z04_UpdateLikeLike_Draw:
                            	  7880:     ; Draw.
                            	  7881:     ;
02:0003BDEE 4EB90004B7B0    	  7882:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003BDF4 41EC03E4        	  7883:     lea     ($03E4,A4),A0
02:0003BDF8 10302000        	  7884:     move.b  (A0,D2.W),D0
02:0003BDFC 4EB900030E62    	  7885:     jsr     DrawObjectMirrored
                            	  7886:     ; Check collisions. If Link was not captured, then return.
                            	  7887:     ;
02:0003BE02 4EB9000311E2    	  7888:     jsr     CheckMonsterCollisions
02:0003BE08 41EC042C        	  7889:     lea     ($042C,A4),A0
02:0003BE0C 10302000        	  7890:     move.b  (A0,D2.W),D0
