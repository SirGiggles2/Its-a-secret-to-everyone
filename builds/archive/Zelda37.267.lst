                            	  7736: UpdatePolsVoiceState1_Jumping:
                            	  7737:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7738:     ;
02:0003BC9C 41EC0444        	  7739:     lea     ($0444,A4),A0
02:0003BCA0 10302000        	  7740:     move.b  (A0,D2.W),D0
02:0003BCA4 023C00EE        	  7741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BCA8 123C0038        	  7742:     move.b  #$38,D1
02:0003BCAC D101            	  7743:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003BCAE 41EC0444        	  7744:     lea     ($0444,A4),A0
02:0003BCB2 11802000        	  7745:     move.b  D0,(A0,D2.W)
                            	  7746:     ; Add Carry to high speed byte (vertical).
                            	  7747:     ;
02:0003BCB6 41EC0412        	  7748:     lea     ($0412,A4),A0
02:0003BCBA 10302000        	  7749:     move.b  (A0,D2.W),D0
02:0003BCBE 123C0000        	  7750:     move.b  #$00,D1
02:0003BCC2 D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003BCC4 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003BCC8 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
02:0003BCCC 023C00EE        	  7756:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BCD0 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003BCD4 12302000        	  7758:     move.b  (A0,D2.W),D1
02:0003BCD8 D101            	  7759:     addx.b  D1,D0   ; ADC ObjY,X
02:0003BCDA 41EC0084        	  7760:     lea     ($0084,A4),A0
02:0003BCDE 11802000        	  7761:     move.b  D0,(A0,D2.W)
                            	  7762:     ; If the speed is still negative, then return.
                            	  7763:     ;
02:0003BCE2 41EC0412        	  7764:     lea     ($0412,A4),A0
02:0003BCE6 10302000        	  7765:     move.b  (A0,D2.W),D0
02:0003BCEA 6B0000AC        	  7766:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7767:     ; If Y coordinate still < target Y, then return.
                            	  7768:     ;
02:0003BCEE 41EC0084        	  7769:     lea     ($0084,A4),A0
02:0003BCF2 10302000        	  7770:     move.b  (A0,D2.W),D0
02:0003BCF6 41EC042C        	  7771:     lea     ($042C,A4),A0
02:0003BCFA 12302000        	  7772:     move.b  (A0,D2.W),D1
02:0003BCFE B001            	  7773:     cmp.b   D1,D0
02:0003BD00 65000096        	  7774:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7775:     ; Else reached the destination. Go to state 0.
                            	  7776:     ;
02:0003BD04 7000            	  7777:     moveq   #0,D0
02:0003BD06 41EC00AC        	  7778:     lea     ($00AC,A4),A0
02:0003BD0A 11802000        	  7779:     move.b  D0,(A0,D2.W)
                            	  7780:     ; Reset 16-bit vertical speed.
                            	  7781:     ;
02:0003BD0E 41EC0444        	  7782:     lea     ($0444,A4),A0
02:0003BD12 11802000        	  7783:     move.b  D0,(A0,D2.W)
02:0003BD16 41EC0412        	  7784:     lea     ($0412,A4),A0
02:0003BD1A 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     ; Choose a random direction to face in.
                            	  7787:     ;
02:0003BD1E 10342018        	  7788:     move.b  ($18,A4,D2.W),D0
02:0003BD22 02000003        	  7789:     andi.b #$03,D0
02:0003BD26 7600            	  7790:     moveq   #0,D3
02:0003BD28 1600            	  7791:     move.b  D0,D3
02:0003BD2A 41F90003BB3A    	  7792:     lea     (PolsVoiceDirections).l,A0
02:0003BD30 10303000        	  7793:     move.b  (A0,D3.W),D0
02:0003BD34 41EC0098        	  7794:     lea     ($0098,A4),A0
02:0003BD38 11802000        	  7795:     move.b  D0,(A0,D2.W)
                            	  7796:     ; Randomly set distance-to-move to $30 or $70.
                            	  7797:     ;
02:0003BD3C 10342018        	  7798:     move.b  ($18,A4,D2.W),D0
02:0003BD40 02000040        	  7799:     andi.b #$40,D0
02:0003BD44 123C0030        	  7800:     move.b  #$30,D1
02:0003BD48 D101            	  7801:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003BD4A 41EC0394        	  7802:     lea     ($0394,A4),A0
02:0003BD4E 11802000        	  7803:     move.b  D0,(A0,D2.W)
                            	  7804:     ; Align the monster with a square horizontally.
                            	  7805:     ;
                            	  7806:     ; If in the left half of a square, align with that square.
                            	  7807:     ; If in the right half, align with the next square.
                            	  7808:     ;
02:0003BD52 10342070        	  7809:     move.b  ($70,A4,D2.W),D0
02:0003BD56 023C00EE        	  7810:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD5A 123C0008        	  7811:     move.b  #$08,D1
02:0003BD5E D101            	  7812:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BD60 020000F0        	  7813:     andi.b #$F0,D0
02:0003BD64 19802070        	  7814:     move.b  D0,($70,A4,D2.W)
                            	  7815:     ; Align the monster with a square vertically.
                            	  7816:     ;
                            	  7817:     ; If in the top half of a square, align with that square.
                            	  7818:     ; If in the bottom half, align with the next square.
                            	  7819:     ;
02:0003BD68 41EC0084        	  7820:     lea     ($0084,A4),A0
02:0003BD6C 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003BD70 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BD74 123C0008        	  7823:     move.b  #$08,D1
02:0003BD78 D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
