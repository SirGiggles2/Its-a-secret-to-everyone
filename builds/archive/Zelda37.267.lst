02:0003A230 41EC00AC        	  4133:     lea     ($00AC,A4),A0
02:0003A234 10302000        	  4134:     move.b  (A0,D2.W),D0
02:0003A238 660000AA        	  4135:     bne  _L_z04_UpdateRockOrGravestone_State1
                            	  4136:     ; State 0.
                            	  4137:     ;
                            	  4138:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  4139:     ; bracelet, then return.
                            	  4140:     ;
02:0003A23C 41EC034F        	  4141:     lea     ($034F,A4),A0
02:0003A240 10302000        	  4142:     move.b  (A0,D2.W),D0
02:0003A244 0C000065        	  4143:     cmpi.b  #$65,D0
02:0003A248 6708            	  4144:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
02:0003A24A 102C0665        	  4145:     move.b  ($0665,A4),D0
02:0003A24E 67000092        	  4146:     beq  _L_z04_UpdateRockOrGravestone_Exit
                            	  4147:     even
                            	  4148: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  4149:     ; If there is a mismatch between the current quest and the quest
                            	  4150:     ; needed for the secret in this room, then return.
                            	  4151:     ;
02:0003A252 6100021C        	  4152:     jsr     IsQuestSecretMismatch
02:0003A256 6500008A        	  4153:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  4154:     ; The gravestone and rocks can only be pushed vertically.
                            	  4155:     ; Return, if X's don't match.
                            	  4156:     ;
02:0003A25A 102C0070        	  4157:     move.b  ($0070,A4),D0
02:0003A25E 12342070        	  4158:     move.b  ($70,A4,D2.W),D1
02:0003A262 B001            	  4159:     cmp.b   D1,D0
02:0003A264 667C            	  4160:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  4161:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  4162:     ; is positive; then go use it along with a flag that indicates that
                            	  4163:     ; Link is "down" from the object.
                            	  4164:     ;
02:0003A266 7600            	  4165:     moveq   #0,D3
02:0003A268 102C0084        	  4166:     move.b  ($0084,A4),D0
02:0003A26C 023C00EE        	  4167:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A270 123C0003        	  4168:     move.b  #$03,D1
02:0003A274 D101            	  4169:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003A276 003C0011        	  4170:     ori     #$11,CCR  ; SEC: set C+X
02:0003A27A 41EC0084        	  4171:     lea     ($0084,A4),A0
02:0003A27E 12302000        	  4172:     move.b  (A0,D2.W),D1
02:0003A282 0A3C0010        	  4173:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A286 9101            	  4174:     subx.b  D1,D0   ; SBC ObjY,X
02:0003A288 0A3C0010        	  4175:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A28C 6A0E            	  4176:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  4177:     ; Else negate it, and indicate Link is "up" from the object.
                            	  4178:     ;
02:0003A28E 5203            	  4179:     addq.b  #1,D3
02:0003A290 4600            	  4180:     eori.b #$FF,D0
02:0003A292 023C00EE        	  4181:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A296 123C0001        	  4182:     move.b  #$01,D1
02:0003A29A D101            	  4183:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4184:     even
                            	  4185: _L_z04_UpdateRockOrGravestone_CheckDistance:
                            	  4186:     ; If the distance >= $11, return.
