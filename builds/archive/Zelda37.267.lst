                            	  8101: DrawVire:
02:0003BFBC 700A            	  8102:     moveq   #10,D0
02:0003BFBE 4EB90004B7AA    	  8103:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  8104:     ; The movement frame is the fram image number, unless facing up.
                            	  8105:     ; In this case, add 2 to the frame image.
