                            	  2863: Link_FilterInput:
                            	  2864:     ; [00] holds the opposite of Link's facing direction.
                            	  2865:     ;
02:00040468 102C0098        	  2866:     move.b  ($0098,A4),D0
02:0004046C 4EB90003095C    	  2867:     jsr     GetOppositeDir
02:00040472 1880            	  2868:     move.b  D0,($0000,A4)
                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:00040474 4EB90003095C    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:0004047A 102C0070        	  2879:     move.b  ($0070,A4),D0
02:0004047E 0C030002        	  2880:     cmpi.b  #$02,D3
02:00040482 6404            	  2881:     bcc  _anon_z05_74
02:00040484 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:00040488 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:0004048C 1003            	  2887:     move.b  D3,D0
02:0004048E 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:00040490 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040494 123C0008        	  2890:     move.b  #$08,D1
02:00040498 D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0004049A 7600            	  2892:     moveq   #0,D3
02:0004049C 1600            	  2893:     move.b  D0,D3
02:0004049E 103C0080        	  2894:     move.b  #$80,D0
02:000404A2 6134            	  2895:     jsr     MaskInputInBorder
02:000404A4 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:000404A6 7600            	  2897:     moveq   #0,D3
02:000404A8 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:000404AA 102C0001        	  2902:     move.b  ($0001,A4),D0
02:000404AE 0C0000FF        	  2903:     cmpi.b  #$FF,D0
02:000404B2 660C            	  2904:     bne  _anon_z05_75
02:000404B4 102C0098        	  2905:     move.b  ($0098,A4),D0
02:000404B8 1880            	  2906:     move.b  D0,($0000,A4)
02:000404BA 4EB90003095C    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
02:000404C0 102C0010        	  2914:     move.b  ($0010,A4),D0
02:000404C4 6710            	  2915:     beq  _anon_z05_76
02:000404C6 1003            	  2916:     move.b  D3,D0
02:000404C8 023C00EE        	  2917:     andi    #$EE,CCR  ; CLC: clear C+X
02:000404CC 123C0004        	  2918:     move.b  #$04,D1
02:000404D0 D101            	  2919:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000404D2 7600            	  2920:     moveq   #0,D3
02:000404D4 1600            	  2921:     move.b  D0,D3
                            	  2922: _anon_z05_76:
                            	  2923:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2924:     ;
02:000404D6 7000            	  2925:     moveq   #0,D0
                            	  2926: ; Params:
                            	  2927: ; A: mask of buttons to block
                            	  2928: ; Y: offset into BorderBounds
                            	  2929: ; [00]: direction
                            	  2930: ; [02]: coordinate
                            	  2931: ;
                            	  2932: ; Returns:
                            	  2933: ; [01]: button mask that was used
                            	  2934: ;       (set to $FF if boundary not crossed)
                            	  2935: ;
                            	  2936:     even
                            	  2937: MaskInputInBorder:
02:000404D8 19400001        	  2938:     move.b  D0,($0001,A4)
                            	  2939:     ; If direction is positive (right or down), then go handle it separately.
                            	  2940:     ;
02:000404DC 1014            	  2941:     move.b  ($0000,A4),D0
02:000404DE 0200000A        	  2942:     andi.b #$0A,D0
02:000404E2 6748            	  2943:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2944:     ; The direction is negative (left or up).
                            	  2945:     ;
                            	  2946:     ; If the coordinate does not cross (<) the boundary, then
                            	  2947:     ; go set mask $FF, so that no button is excluded.
                            	  2948:     ;
02:000404E4 102C0002        	  2949:     move.b  ($0002,A4),D0
02:000404E8 41F90004045C    	  2950:     lea     (BorderBounds).l,A0
02:000404EE 12303000        	  2951:     move.b  (A0,D3.W),D1
02:000404F2 B001            	  2952:     cmp.b   D1,D0
02:000404F4 6548            	  2953:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2954:     even
                            	  2955: _L_z05_MaskInputInBorder_MaskButtons:
                            	  2956:     ; The boundary was crossed. Mask buttons.
                            	  2957:     ;
02:000404F6 102C00F8        	  2958:     move.b  ($00F8,A4),D0
02:000404FA 122C0001        	  2959:     move.b  ($0001,A4),D1
02:000404FE C001            	  2960:     and.b  D1,D0
02:00040500 194000F8        	  2961:     move.b  D0,($00F8,A4)
                            	  2962:     ; If in OW or button mask <> 0, return.
                            	  2963:     ;
02:00040504 102C0010        	  2964:     move.b  ($0010,A4),D0
02:00040508 6720            	  2965:     beq  _L_z05_MaskInputInBorder_Exit
02:0004050A 102C0001        	  2966:     move.b  ($0001,A4),D0
02:0004050E 661A            	  2967:     bne  _L_z05_MaskInputInBorder_Exit
                            	  2968:     ; Mask off input directions perpendicular to player's facing.
                            	  2969:     ;
02:00040510 760C            	  2970:     moveq   #12,D3
02:00040512 102C0098        	  2971:     move.b  ($0098,A4),D0
02:00040516 0200000C        	  2972:     andi.b #$0C,D0
02:0004051A 6602            	  2973:     bne  _anon_z05_77
02:0004051C 7603            	  2974:     moveq   #3,D3
                            	  2975: _anon_z05_77:
02:0004051E 1003            	  2976:     move.b  D3,D0
02:00040520 122C03F8        	  2977:     move.b  ($03F8,A4),D1
02:00040524 C001            	  2978:     and.b  D1,D0
02:00040526 194003F8        	  2979:     move.b  D0,($03F8,A4)
                            	  2980:     even
                            	  2981: _L_z05_MaskInputInBorder_Exit:
02:0004052A 4E75            	  2982:     rts
                            	  2983: 
                            	  2984:     even
                            	  2985: _L_z05_MaskInputInBorder_PositiveDir:
                            	  2986:     ; The direction is positive.
                            	  2987:     ;
                            	  2988:     ; If the coordinate crosses (<) the boundary, then
                            	  2989:     ; go mask buttons.
                            	  2990:     ;
                            	  2991:     ;
                            	  2992:     ; Get coordinate in [02].
02:0004052C 102C0002        	  2993:     move.b  ($0002,A4),D0
02:00040530 41F90004045C    	  2994:     lea     (BorderBounds).l,A0
02:00040536 12303000        	  2995:     move.b  (A0,D3.W),D1
02:0004053A B001            	  2996:     cmp.b   D1,D0
02:0004053C 65B8            	  2997:     bcs  _L_z05_MaskInputInBorder_MaskButtons
                            	  2998:     even
                            	  2999: _L_z05_MaskInputInBorder_ExcludeNone:
                            	  3000:     ; The coordinate is not crossed; then set mask $FF,
                            	  3001:     ; so that no button is excluded.
                            	  3002:     ;
02:0004053E 103C00FF        	  3003:     move.b  #$FF,D0
02:00040542 19400001        	  3004:     move.b  D0,($0001,A4)
                            	  3005:     even
