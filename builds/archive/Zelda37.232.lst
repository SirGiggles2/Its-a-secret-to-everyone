02:0003C5A6 122C0002        	  6495:     move.b  ($0002,A4),D1
02:0003C5AA E309            	  6496:     lsl.b  #1,D1   ; ASL $02
02:0003C5AC 19410002        	  6497:     move.b  D1,($0002,A4)
02:0003C5B0 122C0002        	  6498:     move.b  ($0002,A4),D1
02:0003C5B4 C200            	  6499:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5B6 671E            	  6500:     beq  _L_z04_Digdogger_Move_End
02:0003C5B8 41EC0084        	  6501:     lea     ($0084,A4),A0
02:0003C5BC 10302000        	  6502:     move.b  (A0,D2.W),D0
02:0003C5C0 122C0003        	  6503:     move.b  ($0003,A4),D1
02:0003C5C4 0A3C0010        	  6504:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5C8 9101            	  6505:     subx.b  D1,D0   ; SBC $03
02:0003C5CA 0A3C0010        	  6506:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C5CE 41EC0084        	  6507:     lea     ($0084,A4),A0
02:0003C5D2 11802000        	  6508:     move.b  D0,(A0,D2.W)
