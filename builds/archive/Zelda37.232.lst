02:00041C40 19400011        	  3527:     move.b  D0,($0011,A4)
02:00041C44 1940000F        	  3528:     move.b  D0,($000F,A4)
02:00041C48 194000AC        	  3529:     move.b  D0,($00AC,A4)
02:00041C4C 194000C0        	  3530:     move.b  D0,($00C0,A4)
02:00041C50 194000D3        	  3531:     move.b  D0,($00D3,A4)
02:00041C54 194004F0        	  3532:     move.b  D0,($04F0,A4)
