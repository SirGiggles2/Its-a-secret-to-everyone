02:0003F202 7000            	 12531:     moveq   #0,D0
02:0003F204 41EC046B        	 12532:     lea     ($046B,A4),A0
02:0003F208 11802000        	 12533:     move.b  D0,(A0,D2.W)
02:0003F20C 600002EC        	 12534:     jmp     Ganon_DrawBody
