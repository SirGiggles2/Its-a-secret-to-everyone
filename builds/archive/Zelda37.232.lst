                            	 12588:     ; The animation cycle has 6 frames.
                            	 12589:     ;
02:0003F250 41EC046B        	 12590:     lea     ($046B,A4),A0
02:0003F254 10302000        	 12591:     move.b  (A0,D2.W),D0
02:0003F258 0C000006        	 12592:     cmpi.b  #$06,D0
