02:0003EC90 41EC04F1        	 11738:     lea     ($04F1,A4),A0
02:0003EC94 11803000        	 11739:     move.b  D0,(A0,D3.W)
02:0003EC98 10342070        	 11740:     move.b  ($70,A4,D2.W),D0
02:0003EC9C 19803071        	 11741:     move.b  D0,($71,A4,D3.W)
02:0003ECA0 41EC0084        	 11742:     lea     ($0084,A4),A0
