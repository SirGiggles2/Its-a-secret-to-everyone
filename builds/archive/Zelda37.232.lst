                            	 13009: Ganon_CheckCollisions:
                            	 13010:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 13011:     ; Store in [02] and [03].
                            	 13012:     ;
02:0003F576 10342070        	 13013:     move.b  ($70,A4,D2.W),D0
02:0003F57A 023C00EE        	 13014:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F57E 123C0010        	 13015:     move.b  #$10,D1
02:0003F582 D101            	 13016:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F584 19400002        	 13017:     move.b  D0,($0002,A4)
02:0003F588 41EC0084        	 13018:     lea     ($0084,A4),A0
02:0003F58C 10302000        	 13019:     move.b  (A0,D2.W),D0
02:0003F590 023C00EE        	 13020:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F594 123C0010        	 13021:     move.b  #$10,D1
02:0003F598 D101            	 13022:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003F59A 19400003        	 13023:     move.b  D0,($0003,A4)
                            	 13024:     ; Check for a collision with Link.
                            	 13025:     ;
                            	 13026:     ; We can't call CheckLinkCollision, because we need to
                            	 13027:     ; customize Ganon's midpoint.
                            	 13028:     ;
                            	 13029:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 13030:     ; detection, if Link is invincible. Initialize variables that will
                            	 13031:     ; be returned from the partial collision check routine. Then
                            	 13032:     ; call it.
                            	 13033:     ;
02:0003F59E 102C04F0        	 13034:     move.b  ($04F0,A4),D0
02:0003F5A2 6616            	 13035:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F5A4 19400006        	 13036:     move.b  D0,($0006,A4)
02:0003F5A8 19400009        	 13037:     move.b  D0,($0009,A4)
02:0003F5AC 1940000C        	 13038:     move.b  D0,($000C,A4)
02:0003F5B0 7600            	 13039:     moveq   #0,D3
02:0003F5B2 1883            	 13040:     move.b  D3,($0000,A4)
02:0003F5B4 4EB900031D32    	 13041:     jsr     CheckLinkCollisionPreinit
                            	 13042:     even
                            	 13043: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 13044:     ; If Ganon is not in state 0, then he's brown.
                            	 13045:     ; Go check collision with an arrow.
                            	 13046:     ;
02:0003F5BA 41EC00AC        	 13047:     lea     ($00AC,A4),A0
02:0003F5BE 10302000        	 13048:     move.b  (A0,D2.W),D0
02:0003F5C2 6652            	 13049:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 13050:     ; If timer <> 0, then Ganon is visible.
                            	 13051:     ; He can't be harmed like this. So, return.
                            	 13052:     ;
02:0003F5C4 10342028        	 13053:     move.b  ($28,A4,D2.W),D0
02:0003F5C8 664A            	 13054:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F5CA 760D            	 13055:     moveq   #13,D3
02:0003F5CC 4EB9000321FC    	 13056:     jsr     CheckMonsterSwordCollision
                            	 13057:     ; If Ganon has died according to the usual collision check rules
                            	 13058:     ; (HP = 0), then:
                            	 13059:     ; 1. Restore HP to the initial value $F0
                            	 13060:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 13061:     ; 3. Change palette row 7 to make Ganon brown
                            	 13062:     ;
02:0003F5D2 41EC0405        	 13063:     lea     ($0405,A4),A0
02:0003F5D6 10302000        	 13064:     move.b  (A0,D2.W),D0
02:0003F5DA 6718            	 13065:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F5DC 103C00F0        	 13066:     move.b  #$F0,D0
02:0003F5E0 41EC0485        	 13067:     lea     ($0485,A4),A0
02:0003F5E4 11802000        	 13068:     move.b  D0,(A0,D2.W)
02:0003F5E8 41EC00AC        	 13069:     lea     ($00AC,A4),A0
02:0003F5EC 53302000        	 13070:     subq.b  #1,(A0,D2.W)
02:0003F5F0 61000084        	 13071:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 13072:     even
                            	 13073: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 13074:     ; If Ganon was harmed, then play the sound effect
                            	 13075:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 13076:     ;
02:0003F5F4 41EC04F0        	 13077:     lea     ($04F0,A4),A0
02:0003F5F8 10302000        	 13078:     move.b  (A0,D2.W),D0
02:0003F5FC 670A            	 13079:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003F5FE 6100A27C        	 13080:     jsr     PlayBossHitCryIfNeeded
02:0003F602 7040            	 13081:     moveq   #64,D0
02:0003F604 19802028        	 13082:     move.b  D0,($28,A4,D2.W)
                            	 13083:     even
                            	 13084: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 13085:     ; Reset metastate, because Ganon cannot die this way.
                            	 13086:     ;
02:0003F608 4EB90004D582    	 13087:     jsr     ResetObjMetastate
                            	 13088:     ; Reset shove info and invincibility timer, because Ganon
                            	 13089:     ; doesn't react at all as a usual monster.
                            	 13090:     ;
02:0003F60E 4EB900032104    	 13091:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 13092:     even
                            	 13093: _L_z04_Ganon_CheckCollisions_Exit:
02:0003F614 4E75            	 13094:     rts
                            	 13095: 
                            	 13096:     even
                            	 13097: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 13098:     ; If the silver arrow is not in the inventory, then return.
                            	 13099:     ;
02:0003F616 102C0659        	 13100:     move.b  ($0659,A4),D0
02:0003F61A 0C000002        	 13101:     cmpi.b  #$02,D0
02:0003F61E 66F4            	 13102:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13103:     ; Reset the collision return value [06].
                            	 13104:     ;
02:0003F620 7000            	 13105:     moveq   #0,D0
02:0003F622 19400006        	 13106:     move.b  D0,($0006,A4)
                            	 13107:     ; If there's no arrow in flight, then return.
                            	 13108:     ;
02:0003F626 7612            	 13109:     moveq   #18,D3
02:0003F628 41EC00AC        	 13110:     lea     ($00AC,A4),A0
02:0003F62C 10303000        	 13111:     move.b  (A0,D3.W),D0
02:0003F630 0C000010        	 13112:     cmpi.b  #$10,D0
02:0003F634 66DE            	 13113:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 13114:     ; Check for collision with an arrow; and return if no collision.
                            	 13115:     ;
02:0003F636 4EB900032258    	 13116:     jsr     CheckMonsterArrowOrRodCollision
02:0003F63C 102C0006        	 13117:     move.b  ($0006,A4),D0
02:0003F640 67D2            	 13118:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 13119:     ; Set the Ganon phase to "dying".
                            	 13120:     ;
02:0003F642 41EC042C        	 13121:     lea     ($042C,A4),A0
02:0003F646 52302000        	 13122:     addq.b  #1,(A0,D2.W)
                            	 13123:     ; Now his body does flash.
                            	 13124:     ;
02:0003F64A 7028            	 13125:     moveq   #40,D0
02:0003F64C 41EC04F0        	 13126:     lea     ($04F0,A4),A0
02:0003F650 11802000        	 13127:     move.b  D0,(A0,D2.W)
                            	 13128:     ; Set initial cloud distance 8.
                            	 13129:     ;
02:0003F654 7008            	 13130:     moveq   #8,D0
02:0003F656 41EC0478        	 13131:     lea     ($0478,A4),A0
02:0003F65A 11802000        	 13132:     move.b  D0,(A0,D2.W)
02:0003F65E 0A3C0001        	 13133:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F662 4E75            	 13134:     rts
                            	 13135: 
