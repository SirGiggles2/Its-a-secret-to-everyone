02:0003F014 123C0003        	 12255:     move.b  #$03,D1
02:0003F018 0A3C0010        	 12256:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F01C 9101            	 12257:     subx.b  D1,D0   ; SBC #$03
02:0003F01E 0A3C0010        	 12258:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F022 7600            	 12259:     moveq   #0,D3
02:0003F024 1600            	 12260:     move.b  D0,D3
