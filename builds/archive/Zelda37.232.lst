02:0003AB3C 12342019        	  2865:     move.b  ($19,A4,D2.W),D1
02:0003AB40 D101            	  2866:     addx.b  D1,D0   ; ADC Random+1,X
02:0003AB42 0C000020        	  2867:     cmpi.b  #$20,D0
02:0003AB46 6412            	  2868:     bcc  _anon_z04_39
02:0003AB48 003C0011        	  2869:     ori     #$11,CCR  ; SEC: set C+X
02:0003AB4C 123C0040        	  2870:     move.b  #$40,D1
02:0003AB50 0A3C0010        	  2871:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AB54 9101            	  2872:     subx.b  D1,D0   ; SBC #$40
02:0003AB56 0A3C0010        	  2873:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2874: _anon_z04_39:
