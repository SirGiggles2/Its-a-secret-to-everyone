                            	  7961: Submenu_CueTransferRowUW:
                            	  7962:     ; If menu scroll value is negative, then we transferred everything.
                            	  7963:     ; So, return.
                            	  7964:     ;
02:00044BA8 102C005E        	  7965:     move.b  ($005E,A4),D0
02:00044BAC 6A02            	  7966:     bpl.s  __far_z_05_0103
02:00044BAE 602E            	  7967:     jmp  L1725A_Exit
                            	  7968: __far_z_05_0103:
                            	  7969:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7970:     ; and represents the current row of the submenu being processed.
                            	  7971:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7972:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7973:     ;
                            	  7974:     ; If the bottom bit is set, go prepare the full black row.
                            	  7975:     ;
02:00044BB0 E208            	  7976:     lsr.b  #1,D0   ; LSR A
02:00044BB2 7600            	  7977:     moveq   #0,D3
02:00044BB4 1600            	  7978:     move.b  D0,D3
02:00044BB6 6402            	  7979:     bcc.s  __far_z_05_0104
02:00044BB8 6026            	  7980:     jmp  PrepFullBlackRow
                            	  7981: __far_z_05_0104:
                            	  7982:     ; Submenu rows $D to $15 are parts of the map.
                            	  7983:     ; Submenu rows 0 to $C are fixed text and boxes.
                            	  7984:     ;
                            	  7985:     ; If submenu row < $D, cue a transfer of the static transfer
                            	  7986:     ; buffer for this row.
                            	  7987:     ;
02:00044BBA 0C00000D        	  7988:     cmpi.b  #$0D,D0
02:00044BBE 640C            	  7989:     bcc  _anon_z05_167
02:00044BC0 41F900044B84    	  7990:     lea     (SubmenuTransferBufSelectorsUW).l,A0
02:00044BC6 10303000        	  7991:     move.b  (A0,D3.W),D0
                            	  7992:     even
                            	  7993: _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf:
02:00044BCA 606E            	  7994:     jmp     SelectTransferBufAndDecCounter
                            	  7995: 
                            	  7996: _anon_z05_167:
                            	  7997:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7998:     ; of the big map sheet.
                            	  7999:     ;
02:00044BCC 0C000015        	  8000:     cmpi.b  #$15,D0
02:00044BD0 6604            	  8001:     bne  _anon_z05_168
02:00044BD2 7042            	  8002:     moveq   #66,D0
02:00044BD4 60F4            	  8003:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  8004: 
                            	  8005: _anon_z05_168:
                            	  8006:     ; Else row is between $D and $14. Prepare a map row.
                            	  8007:     ;
02:00044BD6 610005B8        	  8008:     jsr     Submenu_WriteSheetMapRowTransferRecord
                            	  8009:     even
