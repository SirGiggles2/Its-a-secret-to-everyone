02:0003DFFE 123C0008        	 10075:     move.b  #$08,D1
02:0003E002 D101            	 10076:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E004 19802070        	 10077:     move.b  D0,($70,A4,D2.W)
02:0003E008 532C000F        	 10078:     subq.b  #1,($000F,A4)
