                            	 12039:     ;
02:0003EE80 41EC0098        	 12040:     lea     ($0098,A4),A0
02:0003EE84 10302000        	 12041:     move.b  (A0,D2.W),D0
02:0003EE88 122C0002        	 12042:     move.b  ($0002,A4),D1
02:0003EE8C E309            	 12043:     lsl.b  #1,D1   ; ASL $02
02:0003EE8E 19410002        	 12044:     move.b  D1,($0002,A4)
02:0003EE92 122C0002        	 12045:     move.b  ($0002,A4),D1
02:0003EE96 C200            	 12046:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE98 6716            	 12047:     beq  _L_z04_Lamnola_Move_Down
02:0003EE9A 10342070        	 12048:     move.b  ($70,A4,D2.W),D0
02:0003EE9E 122C04E6        	 12049:     move.b  ($04E6,A4),D1
02:0003EEA2 0A3C0010        	 12050:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EEA6 9101            	 12051:     subx.b  D1,D0   ; SBC Lamnola_Speed
02:0003EEA8 0A3C0010        	 12052:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EEAC 19802070        	 12053:     move.b  D0,($70,A4,D2.W)
                            	 12054:     even
