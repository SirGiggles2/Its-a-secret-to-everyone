                            	  9575: Manhandla_Move:
                            	  9576:     ; Implement a way of manifesting the fractional part of the speed
                            	  9577:     ; in the movement.
                            	  9578:     ;
                            	  9579:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9580:     ; byte to add to the coordinates, then the effective speed would
                            	  9581:     ; be 1 pixel a frame instead of 1.25.
                            	  9582:     ;
                            	  9583:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9584:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9585:     ;
                            	  9586:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9587:     ;
                            	  9588:     ;   SA := SA + (SL AND $E0)
                            	  9589:     ;   [03] := SH + carry
                            	  9590:     ;
                            	  9591:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9592:     ;
02:0003DC32 41EC041F        	  9593:     lea     ($041F,A4),A0
02:0003DC36 10302000        	  9594:     move.b  (A0,D2.W),D0
02:0003DC3A 020000E0        	  9595:     andi.b #$E0,D0
02:0003DC3E 023C00EE        	  9596:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC42 41EC0412        	  9597:     lea     ($0412,A4),A0
02:0003DC46 12302000        	  9598:     move.b  (A0,D2.W),D1
02:0003DC4A D101            	  9599:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003DC4C 41EC0412        	  9600:     lea     ($0412,A4),A0
02:0003DC50 11802000        	  9601:     move.b  D0,(A0,D2.W)
                            	  9602:     ; Assign (high speed byte + carry) to [03].
                            	  9603:     ;
02:0003DC54 41EC042C        	  9604:     lea     ($042C,A4),A0
02:0003DC58 10302000        	  9605:     move.b  (A0,D2.W),D0
02:0003DC5C 123C0000        	  9606:     move.b  #$00,D1
02:0003DC60 D101            	  9607:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003DC62 19400003        	  9608:     move.b  D0,($0003,A4)
                            	  9609:     ; Change coordinates by the speed amount/offset in [03]
                            	  9610:     ; according to the direction.
                            	  9611:     ;
                            	  9612:     ; Start with a mask of $A1 in [02]:
                            	  9613:     ; - low nibble represents the right direction
                            	  9614:     ; - high nibble is used to set or clear carry as we go along
                            	  9615:     ;
02:0003DC66 103C00A1        	  9616:     move.b  #$A1,D0
02:0003DC6A 19400002        	  9617:     move.b  D0,($0002,A4)
                            	  9618:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9619:     ;
02:0003DC6E 41EC0098        	  9620:     lea     ($0098,A4),A0
02:0003DC72 10302000        	  9621:     move.b  (A0,D2.W),D0
02:0003DC76 122C0002        	  9622:     move.b  ($0002,A4),D1
02:0003DC7A C200            	  9623:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DC7C 6712            	  9624:     beq  _L_z04_Manhandla_Move_Left
02:0003DC7E 10342070        	  9625:     move.b  ($70,A4,D2.W),D0
02:0003DC82 023C00EE        	  9626:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC86 122C0003        	  9627:     move.b  ($0003,A4),D1
02:0003DC8A D101            	  9628:     addx.b  D1,D0   ; ADC $03
02:0003DC8C 19802070        	  9629:     move.b  D0,($70,A4,D2.W)
                            	  9630:     even
                            	  9631: _L_z04_Manhandla_Move_Left:
                            	  9632:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9633:     ;
02:0003DC90 41EC0098        	  9634:     lea     ($0098,A4),A0
02:0003DC94 10302000        	  9635:     move.b  (A0,D2.W),D0
02:0003DC98 122C0002        	  9636:     move.b  ($0002,A4),D1
02:0003DC9C E309            	  9637:     lsl.b  #1,D1   ; ASL $02
02:0003DC9E 19410002        	  9638:     move.b  D1,($0002,A4)
02:0003DCA2 122C0002        	  9639:     move.b  ($0002,A4),D1
02:0003DCA6 C200            	  9640:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCA8 6716            	  9641:     beq  _L_z04_Manhandla_Move_Down
02:0003DCAA 10342070        	  9642:     move.b  ($70,A4,D2.W),D0
02:0003DCAE 122C0003        	  9643:     move.b  ($0003,A4),D1
02:0003DCB2 0A3C0010        	  9644:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DCB6 9101            	  9645:     subx.b  D1,D0   ; SBC $03
02:0003DCB8 0A3C0010        	  9646:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DCBC 19802070        	  9647:     move.b  D0,($70,A4,D2.W)
                            	  9648:     even
                            	  9649: _L_z04_Manhandla_Move_Down:
                            	  9650:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9651:     ;
02:0003DCC0 41EC0098        	  9652:     lea     ($0098,A4),A0
02:0003DCC4 10302000        	  9653:     move.b  (A0,D2.W),D0
02:0003DCC8 122C0002        	  9654:     move.b  ($0002,A4),D1
02:0003DCCC E309            	  9655:     lsl.b  #1,D1   ; ASL $02
02:0003DCCE 19410002        	  9656:     move.b  D1,($0002,A4)
02:0003DCD2 122C0002        	  9657:     move.b  ($0002,A4),D1
02:0003DCD6 C200            	  9658:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCD8 6716            	  9659:     beq  _L_z04_Manhandla_Move_Up
02:0003DCDA 41EC0084        	  9660:     lea     ($0084,A4),A0
02:0003DCDE 10302000        	  9661:     move.b  (A0,D2.W),D0
02:0003DCE2 122C0003        	  9662:     move.b  ($0003,A4),D1
02:0003DCE6 D101            	  9663:     addx.b  D1,D0   ; ADC $03
02:0003DCE8 41EC0084        	  9664:     lea     ($0084,A4),A0
02:0003DCEC 11802000        	  9665:     move.b  D0,(A0,D2.W)
                            	  9666:     even
                            	  9667: _L_z04_Manhandla_Move_Up:
                            	  9668:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9669:     ;
02:0003DCF0 41EC0098        	  9670:     lea     ($0098,A4),A0
02:0003DCF4 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003DCF8 122C0002        	  9672:     move.b  ($0002,A4),D1
02:0003DCFC E309            	  9673:     lsl.b  #1,D1   ; ASL $02
02:0003DCFE 19410002        	  9674:     move.b  D1,($0002,A4)
02:0003DD02 122C0002        	  9675:     move.b  ($0002,A4),D1
02:0003DD06 C200            	  9676:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD08 671E            	  9677:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DD0A 41EC0084        	  9678:     lea     ($0084,A4),A0
02:0003DD0E 10302000        	  9679:     move.b  (A0,D2.W),D0
02:0003DD12 122C0003        	  9680:     move.b  ($0003,A4),D1
02:0003DD16 0A3C0010        	  9681:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD1A 9101            	  9682:     subx.b  D1,D0   ; SBC $03
02:0003DD1C 0A3C0010        	  9683:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD20 41EC0084        	  9684:     lea     ($0084,A4),A0
02:0003DD24 11802000        	  9685:     move.b  D0,(A0,D2.W)
                            	  9686:     even
                            	  9687: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9688:     ; To the frame accumulator, add:
                            	  9689:     ; - a random value between 0 and 3
                            	  9690:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9691:     ;
02:0003DD28 10342019        	  9692:     move.b  ($19,A4,D2.W),D0
02:0003DD2C 02000003        	  9693:     andi.b #$03,D0
02:0003DD30 023C00EE        	  9694:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD34 122C0003        	  9695:     move.b  ($0003,A4),D1
02:0003DD38 D101            	  9696:     addx.b  D1,D0   ; ADC $03
02:0003DD3A 41EC0451        	  9697:     lea     ($0451,A4),A0
02:0003DD3E 12302000        	  9698:     move.b  (A0,D2.W),D1
02:0003DD42 D101            	  9699:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003DD44 41EC0451        	  9700:     lea     ($0451,A4),A0
02:0003DD48 11802000        	  9701:     move.b  D0,(A0,D2.W)
02:0003DD4C 61001E0A        	  9702:     jsr     BoundFlyer
                            	  9703:     ; TODO:
                            	  9704:     ; I don't see why this is needed.
