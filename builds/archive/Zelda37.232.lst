                            	 12231: __far_z_04_0120:
                            	 12232:     ; State = 0.
                            	 12233:     ;
                            	 12234:     ; If the current object slot is 2, then go initialize the patra child.
                            	 12235:     ; This is the only patra child shown in the first fame.
                            	 12236:     ;
02:0003F000 0C020002        	 12237:     cmpi.b  #$02,D2
02:0003F004 6732            	 12238:     beq  _L_z04_UpdatePatraChild_Ready
                            	 12239:     ; The patra child in slot 2 is the last one to be updated.
                            	 12240:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 12241:     ;
                            	 12242:     ; This means that in the first frame, slot 2 is the only one to be
                            	 12243:     ; shown.
                            	 12244:     ;
02:0003F006 102C00AE        	 12245:     move.b  ($00AE,A4),D0
02:0003F00A 6700008E        	 12246:     beq  _L_z04_UpdatePatraChild_Exit
                            	 12247:     ; In subsequent frames, patra children in slots >= 3 will reach
