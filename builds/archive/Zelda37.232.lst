                            	  5783:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5784:     ; starting from highest index down to 0:
                            	  5785:     ;
02:000436B6 41F9000435A4    	  5786:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:000436BC 10302000        	  5787:     move.b  (A0,D2.W),D0
