                            	  7334: ; Returns:
                            	  7335: ; [06]: 1 if objects collide
                            	  7336: ;
                            	  7337:     even
                            	  7338: CheckMonsterSlenderWeaponCollision2:
02:00032328 7600            	  7339:     moveq   #0,D3
02:0003232A 1614            	  7340:     move.b  ($0000,A4),D3
                            	  7341:     ; If Link is facing vertically, then:
                            	  7342:     ; [04] := (weapon X + 6)
                            	  7343:     ; A    := (weapon Y + 8)
                            	  7344:     ;
                            	  7345:     ; Shouldn't it be based on the weapon's direction?
                            	  7346:     ;
02:0003232C 102C0098        	  7347:     move.b  ($0098,A4),D0
02:00032330 0200000C        	  7348:     andi.b #$0C,D0
02:00032334 6726            	  7349:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:00032336 10343070        	  7350:     move.b  ($70,A4,D3.W),D0
02:0003233A 023C00EE        	  7351:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003233E 123C0006        	  7352:     move.b  #$06,D1
02:00032342 D101            	  7353:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:00032344 19400004        	  7354:     move.b  D0,($0004,A4)
02:00032348 41EC0084        	  7355:     lea     ($0084,A4),A0
02:0003234C 10303000        	  7356:     move.b  (A0,D3.W),D0
02:00032350 023C00EE        	  7357:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032354 123C0008        	  7358:     move.b  #$08,D1
02:00032358 D101            	  7359:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003235A 6024            	  7360:     jmp     _anon_z01_98
                            	  7361: 
                            	  7362:     even
                            	  7363: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  7364:     ; Else Link is facing horizontally.
                            	  7365:     ; [04] := (weapon X + 8)
                            	  7366:     ; A    := (weapon Y + 6)
                            	  7367:     ;
                            	  7368:     ; Shouldn't it be based on the weapon's direction?
                            	  7369:     ;
02:0003235C 10343070        	  7370:     move.b  ($70,A4,D3.W),D0
02:00032360 023C00EE        	  7371:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032364 123C0008        	  7372:     move.b  #$08,D1
02:00032368 D101            	  7373:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003236A 19400004        	  7374:     move.b  D0,($0004,A4)
02:0003236E 41EC0084        	  7375:     lea     ($0084,A4),A0
02:00032372 10303000        	  7376:     move.b  (A0,D3.W),D0
02:00032376 023C00EE        	  7377:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003237A 123C0006        	  7378:     move.b  #$06,D1
02:0003237E D101            	  7379:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  7380: _anon_z01_98:
                            	  7381:     ; The A register will be copied to [05] and used here.
                            	  7382:     ;
02:00032380 6000FC0C        	  7383:     jmp     CheckMonsterWeaponCollision
                            	  7384: 
                            	  7385: ; Params:
                            	  7386: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  7387: ; [00]: weapon object slot (unused)
                            	  7388: ; [02]: object 1 mid X
                            	  7389: ; [03]: object 1 mid Y
                            	  7390: ; [04]: object 2 mid X
                            	  7391: ; [05]: object 2 mid Y
                            	  7392: ;
                            	  7393: ; Returns:
                            	  7394: ; A: 1 if objects collide
                            	  7395: ; Y: weapon object slot
                            	  7396: ; Z: 0 if objects collide
                            	  7397: ; [06]: 1 if objects collide
                            	  7398: ; [0A]: horizontal distance
                            	  7399: ; [0B]: vertical distance
                            	  7400: ;
                            	  7401: ;
                            	  7402: ; Use the same threshold value horizontally and vertically.
                            	  7403: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  7404: ;
                            	  7405:     even
                            	  7406: DoObjectsCollide:
02:00032384 1940000D        	  7407:     move.b  D0,($000D,A4)
02:00032388 1940000E        	  7408:     move.b  D0,($000E,A4)
                            	  7409: ; Params:
                            	  7410: ; [00]: weapon or Link object slot (unused)
                            	  7411: ; [02]: object 1 mid X
                            	  7412: ; [03]: object 1 mid Y
                            	  7413: ; [04]: object 2 mid X
                            	  7414: ; [05]: object 2 mid Y
                            	  7415: ; [0D]: horizontal threshold
                            	  7416: ; [0E]: vertical threshold
                            	  7417: ;
                            	  7418: ; Returns:
                            	  7419: ; A: 1 if objects collide
                            	  7420: ; Y: weapon or Link object slot (copied from [00])
                            	  7421: ; Z: 0 if objects collide
                            	  7422: ; [06]: 1 if objects collide
                            	  7423: ; [0A]: horizontal distance
                            	  7424: ; [0B]: vertical distance
                            	  7425: ;
                            	  7426: ;
                            	  7427: ; Reset [06] to indicate no collision by default.
                            	  7428: ;
                            	  7429:     even
                            	  7430: DoObjectsCollideWithThresholds:
02:0003238C 60009D32        	  7431:     jmp     c_do_objects_collide_with_thresholds
                            	  7432: 
                            	  7433: BeginShove:
02:00032390 7600            	  7434:     moveq   #0,D3
02:00032392 1614            	  7435:     move.b  ($0000,A4),D3
02:00032394 0C02000D        	  7436:     cmpi.b  #$0D,D2
02:00032398 6412            	  7437:     bcc  _anon_z01_99
02:0003239A 41EC04B2        	  7438:     lea     ($04B2,A4),A0
02:0003239E 10302000        	  7439:     move.b  (A0,D2.W),D0
02:000323A2 122C0009        	  7440:     move.b  ($0009,A4),D1
02:000323A6 C001            	  7441:     and.b  D1,D0
02:000323A8 660000C4        	  7442:     bne  _L_z01_BeginShove_Exit
                            	  7443: _anon_z01_99:
                            	  7444:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7445:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7446:     ;
                            	  7447:     ; If instead a monster is defending, then all this calculation
                            	  7448:     ; won't matter, because the shove direction will be set to the
                            	  7449:     ; weapon's direction.
                            	  7450:     ;
                            	  7451:     ; As such, calculate a direction from the monster to the defender,
                            	  7452:     ; assuming it's Link.
                            	  7453:     ;
                            	  7454:     ; Start with an assumption that the direction is vertical:
                            	  7455:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7456:     ;
02:000323AC 7008            	  7457:     moveq   #8,D0
02:000323AE 19400008        	  7458:     move.b  D0,($0008,A4)
02:000323B2 41EC0084        	  7459:     lea     ($0084,A4),A0
02:000323B6 10302000        	  7460:     move.b  (A0,D2.W),D0
02:000323BA 19400004        	  7461:     move.b  D0,($0004,A4)
02:000323BE 41EC0084        	  7462:     lea     ($0084,A4),A0
02:000323C2 10303000        	  7463:     move.b  (A0,D3.W),D0
02:000323C6 19400005        	  7464:     move.b  D0,($0005,A4)
                            	  7465:     ; If the defender is Link and his grid offset <> 0 then
                            	  7466:     ; use his usual object direction variable to determine
                            	  7467:     ; which axis to check.
                            	  7468:     ;
02:000323CA 4A03            	  7469:     cmpi.b  #$00,D3
02:000323CC 6612            	  7470:     bne  _anon_z01_100
02:000323CE 102C0394        	  7471:     move.b  ($0394,A4),D0
02:000323D2 670C            	  7472:     beq  _anon_z01_100
02:000323D4 102C0098        	  7473:     move.b  ($0098,A4),D0
02:000323D8 02000003        	  7474:     andi.b #$03,D0
02:000323DC 660C            	  7475:     bne  _L_z01_BeginShove_CheckHorizontal
02:000323DE 6720            	  7476:     beq  _L_z01_BeginShove_CheckVertical
                            	  7477: _anon_z01_100:
                            	  7478:     ; For monsters defending, or Link with grid offset = 0,
                            	  7479:     ; check direction in [0B].
                            	  7480:     ;
                            	  7481:     ; For monsters defending, this won't matter. For Link with grid
                            	  7482:     ; offset = 0, I believe the result will be arbitrary.
                            	  7483:     ;
                            	  7484:     ; TODO:
                            	  7485:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7486:     ; It doesn't seem to be if candle fire attacks him.
                            	  7487:     ;
02:000323E0 102C000B        	  7488:     move.b  ($000B,A4),D0
02:000323E4 0C000004        	  7489:     cmpi.b  #$04,D0
02:000323E8 6416            	  7490:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7491:     even
                            	  7492: _L_z01_BeginShove_CheckHorizontal:
                            	  7493:     ; If the direction checked is left or right,
                            	  7494:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7495:     ;
02:000323EA 7002            	  7496:     moveq   #2,D0
02:000323EC 19400008        	  7497:     move.b  D0,($0008,A4)
02:000323F0 10342070        	  7498:     move.b  ($70,A4,D2.W),D0
02:000323F4 19400004        	  7499:     move.b  D0,($0004,A4)
02:000323F8 10343070        	  7500:     move.b  ($70,A4,D3.W),D0
02:000323FC 19400005        	  7501:     move.b  D0,($0005,A4)
                            	  7502:     even
                            	  7503: _L_z01_BeginShove_CheckVertical:
                            	  7504:     ; If the monster is down or right of the other object,
                            	  7505:     ; then use the opposite direction already in [08].
                            	  7506:     ; Else shift [08] right to turn it into the opposite
                            	  7507:     ; direction up or down.
                            	  7508:     ;
                            	  7509:     ; Again assuming Link is the defender; after this, [08] points
                            	  7510:     ; Link away from the monster.
                            	  7511:     ;
02:00032400 102C0004        	  7512:     move.b  ($0004,A4),D0
02:00032404 122C0005        	  7513:     move.b  ($0005,A4),D1
02:00032408 B001            	  7514:     cmp.b   D1,D0
02:0003240A 640A            	  7515:     bcc  _anon_z01_101
02:0003240C 122C0008        	  7516:     move.b  ($0008,A4),D1
02:00032410 E209            	  7517:     lsr.b  #1,D1   ; LSR $08
02:00032412 19410008        	  7518:     move.b  D1,($0008,A4)
                            	  7519: _anon_z01_101:
                            	  7520:     ; If a monster is the defender, go handle it separately.
                            	  7521:     ;
02:00032416 4A03            	  7522:     cmpi.b  #$00,D3
02:00032418 6656            	  7523:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7524:     ; Link is the defender.
                            	  7525:     ;
                            	  7526:     ; If Link is invincible, return without shoving.
                            	  7527:     ;
02:0003241A 102C04F0        	  7528:     move.b  ($04F0,A4),D0
02:0003241E 664E            	  7529:     bne  _L_z01_BeginShove_Exit
                            	  7530:     ; Store the shove direction we determined.
                            	  7531:     ;
                            	  7532:     ; Turn on the high bit to indicate that the next time we try to
                            	  7533:     ; move by shoving, it will be the first time for this shove action.
                            	  7534:     ;
02:00032420 102C0008        	  7535:     move.b  ($0008,A4),D0
02:00032424 00000080        	  7536:     ori.b #$80,D0
02:00032428 194000C0        	  7537:     move.b  D0,($00C0,A4)
                            	  7538:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7539:     ;
02:0003242C 7018            	  7540:     moveq   #24,D0
02:0003242E 194004F0        	  7541:     move.b  D0,($04F0,A4)
02:00032432 7020            	  7542:     moveq   #32,D0
02:00032434 194000D3        	  7543:     move.b  D0,($00D3,A4)
                            	  7544:     ; If Link was shoved by one of his own weapons, then
                            	  7545:     ; nothing else to do. Return.
                            	  7546:     ;
02:00032438 0C02000D        	  7547:     cmpi.b  #$0D,D2
02:0003243C 6430            	  7548:     bcc  _L_z01_BeginShove_Exit
                            	  7549:     ; Link was shoved by a monster.
                            	  7550:     ;
                            	  7551:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7552:     ; then return.
                            	  7553:     ;
02:0003243E 41EC04BF        	  7554:     lea     ($04BF,A4),A0
02:00032442 10302000        	  7555:     move.b  (A0,D2.W),D0
02:00032446 02000080        	  7556:     andi.b #$80,D0
02:0003244A 6622            	  7557:     bne  _L_z01_BeginShove_Exit
                            	  7558:     ; If the attacker is a vire, then return.
                            	  7559:     ;
02:0003244C 41EC034F        	  7560:     lea     ($034F,A4),A0
02:00032450 10302000        	  7561:     move.b  (A0,D2.W),D0
02:00032454 0C000012        	  7562:     cmpi.b  #$12,D0
02:00032458 6714            	  7563:     beq  _L_z01_BeginShove_Exit
                            	  7564:     ; Turn the attacker in the opposite direction.
                            	  7565:     ;
02:0003245A 41EC0098        	  7566:     lea     ($0098,A4),A0
02:0003245E 10302000        	  7567:     move.b  (A0,D2.W),D0
02:00032462 6100E87E        	  7568:     jsr     GetOppositeDir
02:00032466 41EC0098        	  7569:     lea     ($0098,A4),A0
02:0003246A 11802000        	  7570:     move.b  D0,(A0,D2.W)
                            	  7571:     even
                            	  7572: _L_z01_BeginShove_Exit:
02:0003246E 4E75            	  7573:     rts
                            	  7574: 
                            	  7575:     even
                            	  7576: _L_z01_BeginShove_MonsterDefender:
                            	  7577:     ; A monster is the defender. A weapon is the attacker.
                            	  7578:     ;
                            	  7579:     ; Set the shove direction to the weapon's direction,
                            	  7580:     ; instead of the direction passed in [0B].
                            	  7581:     ;
02:00032470 41EC0098        	  7582:     lea     ($0098,A4),A0
02:00032474 10303000        	  7583:     move.b  (A0,D3.W),D0
02:00032478 19400008        	  7584:     move.b  D0,($0008,A4)
                            	  7585:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7586:     ; combine the shove direction with $40.
                            	  7587:     ;
                            	  7588:     ; TODO:
                            	  7589:     ; But the shoving routing doesn't read this flag.
                            	  7590:     ;
02:0003247C 41EC04BF        	  7591:     lea     ($04BF,A4),A0
02:00032480 10302000        	  7592:     move.b  (A0,D2.W),D0
02:00032484 02000080        	  7593:     andi.b #$80,D0
02:00032488 670C            	  7594:     beq  _anon_z01_102
02:0003248A 102C0008        	  7595:     move.b  ($0008,A4),D0
02:0003248E 00000040        	  7596:     ori.b #$40,D0
02:00032492 19400008        	  7597:     move.b  D0,($0008,A4)
                            	  7598: _anon_z01_102:
                            	  7599:     ; If the monster is invincible, then return without shoving.
                            	  7600:     ;
02:00032496 41EC04F0        	  7601:     lea     ($04F0,A4),A0
02:0003249A 10302000        	  7602:     move.b  (A0,D2.W),D0
02:0003249E 6656            	  7603:     bne  _L_z01_BeginShove_Exit2
                            	  7604:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7605:     ;
02:000324A0 41EC034F        	  7606:     lea     ($034F,A4),A0
02:000324A4 10302000        	  7607:     move.b  (A0,D2.W),D0
02:000324A8 0C000033        	  7608:     cmpi.b  #$33,D0
02:000324AC 6706            	  7609:     beq  _L_z01_BeginShove_Gohma
02:000324AE 0C000034        	  7610:     cmpi.b  #$34,D0
02:000324B2 661E            	  7611:     bne  _L_z01_BeginShove_SetShoveDir
                            	  7612:     even
                            	  7613: _L_z01_BeginShove_Gohma:
                            	  7614:     ; This a Gohma, but if the current part [0F] is not an eye part (3 or 4),
                            	  7615:     ; then return, so that the hit doesn't register.
                            	  7616:     ;
02:000324B4 102C000F        	  7617:     move.b  ($000F,A4),D0
02:000324B8 0C000003        	  7618:     cmpi.b  #$03,D0
02:000324BC 6706            	  7619:     beq  _anon_z01_103
02:000324BE 0C000004        	  7620:     cmpi.b  #$04,D0
02:000324C2 6632            	  7621:     bne  _L_z01_BeginShove_Exit2
                            	  7622: _anon_z01_103:
                            	  7623:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  7624:     ;
02:000324C4 41EC046B        	  7625:     lea     ($046B,A4),A0
02:000324C8 10302000        	  7626:     move.b  (A0,D2.W),D0
02:000324CC 0C000003        	  7627:     cmpi.b  #$03,D0
02:000324D0 6624            	  7628:     bne  _L_z01_BeginShove_Exit2
                            	  7629:     even
                            	  7630: _L_z01_BeginShove_SetShoveDir:
                            	  7631:     ; Store the shove direction for the monster.
                            	  7632:     ;
                            	  7633:     ; Turn on the high bit to indicate that the next time we try to
                            	  7634:     ; move by shoving, it will be the first time for this shove action.
                            	  7635:     ;
02:000324D2 102C0008        	  7636:     move.b  ($0008,A4),D0
02:000324D6 00000080        	  7637:     ori.b #$80,D0
02:000324DA 41EC00C0        	  7638:     lea     ($00C0,A4),A0
02:000324DE 11802000        	  7639:     move.b  D0,(A0,D2.W)
                            	  7640:     ; Mark the monster invincible $10 frames, and should move $40 pixels.
                            	  7641:     ;
02:000324E2 7040            	  7642:     moveq   #64,D0
02:000324E4 41EC00D3        	  7643:     lea     ($00D3,A4),A0
02:000324E8 11802000        	  7644:     move.b  D0,(A0,D2.W)
02:000324EC 7010            	  7645:     moveq   #16,D0
02:000324EE 41EC04F0        	  7646:     lea     ($04F0,A4),A0
02:000324F2 11802000        	  7647:     move.b  D0,(A0,D2.W)
                            	  7648:     even
                            	  7649: _L_z01_BeginShove_Exit2:
02:000324F6 4E75            	  7650:     rts
                            	  7651: 
                            	  7652:     even
