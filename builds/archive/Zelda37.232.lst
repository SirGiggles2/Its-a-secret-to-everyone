                            	  5234: 
                            	  5235: ; Params:
                            	  5236: ; [02]: bitmask for target door.
                            	  5237: ;
                            	  5238: ; Returns:
                            	  5239: ; A: door attribute for desired direction in current room.
                            	  5240: ; [01]: same as [02] if found; $10 otherwise
                            	  5241: ; [03]: reverse direction index
                            	  5242: ;
                            	  5243: ; Door bits:
                            	  5244: ; 1: E
                            	  5245: ; 2: W
                            	  5246: ; 4: S
                            	  5247: ; 8: N
                            	  5248: ;
                            	  5249: ;
                            	  5250: ; Start with single-bit mask 1.
                            	  5251:     even
                            	  5252: FindDoorAttrByDoorBit:
