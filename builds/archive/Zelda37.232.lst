02:0003D0C2 6600009A        	  8032:     bne  _L_z04_UpdateLikeLike_HandleCaptured
02:0003D0C6 103C0080        	  8033:     move.b  #$80,D0
02:0003D0CA 6100C870        	  8034:     jsr     UpdateCommonWanderer
                            	  8035:     ; Like-like has a 4 animation frame cycle unlike most monsters
                            	  8036:     ; which have 2.
                            	  8037:     ;
02:0003D0CE 41EC03D0        	  8038:     lea     ($03D0,A4),A0
