02:0003CEAA 41EC0084        	  7784:     lea     ($0084,A4),A0
02:0003CEAE 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     even
                            	  7787: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7788:     ; If the square the monster is over is walkable, then
                            	  7789:     ; go draw and check object collisions.
