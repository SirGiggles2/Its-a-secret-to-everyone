02:0003B470 7006            	  4195:     moveq   #6,D0
02:0003B472 7600            	  4196:     moveq   #0,D3
02:0003B474 1600            	  4197:     move.b  D0,D3
02:0003B476 610048BC        	  4198:     jsr     RotateObjectLocation
02:0003B47A 41EC0084        	  4199:     lea     ($0084,A4),A0
02:0003B47E 11802000        	  4200:     move.b  D0,(A0,D2.W)
02:0003B482 1002            	  4201:     move.b  D2,D0
02:0003B484 1B00            	  4202:     move.b  D0,-(A5)  ; PHA
02:0003B486 4EB900031B26    	  4203:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
02:0003B48C 4EB90004CD7A    	  4204:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4205:     ; The variable for the currently updating object slot has to be
