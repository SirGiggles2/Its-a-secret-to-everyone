                            	  2207: WhirlwindPrevRoomIdList:
02:0002FF36 36              	  2208:     dc.b    $36, $3B, $73, $44, $0A, $21, $41, $6C
02:0002FF37 3B
02:0002FF38 73
02:0002FF39 44
02:0002FF3A 0A
02:0002FF3B 21
02:0002FF3C 41
02:0002FF3D 6C
                            	  2209: 
                            	  2210:     even
                            	  2211: UpdateWhirlwind_Full:
                            	  2212:     ; Get Link's halted state.
                            	  2213:     ;
02:0002FF3E 102C00AC        	  2214:     move.b  ($00AC,A4),D0
02:0002FF42 02000040        	  2215:     andi.b #$40,D0
02:0002FF46 7600            	  2216:     moveq   #0,D3
02:0002FF48 1600            	  2217:     move.b  D0,D3
                            	  2218:     ; Add 2 to whirlwind X.
                            	  2219:     ;
02:0002FF4A 7002            	  2220:     moveq   #2,D0
02:0002FF4C 023C00EE        	  2221:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002FF50 12342070        	  2222:     move.b  ($70,A4,D2.W),D1
02:0002FF54 D101            	  2223:     addx.b  D1,D0   ; ADC ObjX,X
02:0002FF56 19802070        	  2224:     move.b  D0,($70,A4,D2.W)
                            	  2225:     ; If Link is not halted or teleporting state = 0, then
                            	  2226:     ; go check for collision with Link.
                            	  2227:     ;
02:0002FF5A 0C030040        	  2228:     cmpi.b  #$40,D3
02:0002FF5E 6638            	  2229:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0002FF60 7600            	  2230:     moveq   #0,D3
02:0002FF62 162C0522        	  2231:     move.b  ($0522,A4),D3
02:0002FF66 6730            	  2232:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2233:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2234:     ;
                            	  2235:     ; Set Link's X to whirlwind's.
                            	  2236:     ;
02:0002FF68 19400070        	  2237:     move.b  D0,($0070,A4)
                            	  2238:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2239:     ; the right screen edge and draw.
                            	  2240:     ;
02:0002FF6C 5303            	  2241:     subq.b  #1,D3
02:0002FF6E 6776            	  2242:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0002FF70 0C000080        	  2243:     cmpi.b  #$80,D0
02:0002FF74 6670            	  2244:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2245:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2246:     ;
