                            	  1588: _anon_z04_27:
02:0003A2E0 1003            	  1589:     move.b  D3,D0
                            	  1590:     ; Combine the two masks. At most one will be 0.
                            	  1591:     ;
02:0003A2E2 1214            	  1592:     move.b  ($0000,A4),D1
02:0003A2E4 8001            	  1593:     or.b  D1,D0
                            	  1594:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1595:     ; with the grid.
                            	  1596:     ;
                            	  1597:     ; If so, then go to state 1 to do a "big shove".
                            	  1598:     ; Else go to state 2, to immediately split in two.
                            	  1599:     ;
                            	  1600:     ; Examples:
                            	  1601:     ; It would be aligned, if moving left along a tile as usual.
                            	  1602:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1603:     ; - The collision check routines would have made the zol
                            	  1604:     ;   face in the direction of the weapon.
                            	  1605:     ; - See CheckMonsterWeaponCollision.
                            	  1606:     ;
02:0003A2E6 122C0098        	  1607:     move.b  ($0098,A4),D1
02:0003A2EA C001            	  1608:     and.b  D1,D0
02:0003A2EC 6608            	  1609:     bne  _anon_z04_28
02:0003A2EE 41EC00AC        	  1610:     lea     ($00AC,A4),A0
02:0003A2F2 52302000        	  1611:     addq.b  #1,(A0,D2.W)
