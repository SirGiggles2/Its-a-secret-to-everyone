                            	  6600:     ; If heart partial >= low damage points byte, then simply
                            	  6601:     ; subtract the damage byte from heart partial.
                            	  6602:     ; Else go borrow from full hearts.
                            	  6603:     ;
02:00031E9E 102C0670        	  6604:     move.b  ($0670,A4),D0
