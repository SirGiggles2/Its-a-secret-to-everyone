                            	 10870: __far_z_04_0100:
                            	 10871: ; Description:
                            	 10872: ; This block applies to heads and the bottom segment of a neck.
                            	 10873: ; These are drawn with sprites that come first in order, so that
                            	 10874: ; they are drawn above all other sprites, including Link.
                            	 10875: ;
                            	 10876: ; Params:
                            	 10877: ; A: tile number
                            	 10878: ;
                            	 10879: ; Normal sprite with level palette row
                            	 10880:     even
                            	 10881: Gleeok_WriteHeadOrBaseSpriteAndCheckCollisions:
02:0003E60A 7603            	 10882:     moveq   #3,D3
02:0003E60C 19430003        	 10883:     move.b  D3,($0003,A4)
02:0003E610 1B00            	 10884:     move.b  D0,-(A5)  ; PHA
                            	 10885:     ; To calculate the base offset of the sprite record:
                            	 10886:     ; offset := neck index * 8
                            	 10887:     ;
                            	 10888:     ; This ends up pointing to one of the first 8 eight sprites,
                            	 10889:     ; at an even index.
                            	 10890:     ;
02:0003E612 102C04D7        	 10891:     move.b  ($04D7,A4),D0
02:0003E616 E308            	 10892:     lsl.b  #1,D0   ; ASL A
02:0003E618 E308            	 10893:     lsl.b  #1,D0   ; ASL A
02:0003E61A E308            	 10894:     lsl.b  #1,D0   ; ASL A
                            	 10895:     ; But if the segment is not a head (not at object slot 5), then
                            	 10896:     ; add $20. This moves the offset to the second set of 8 sprites.
                            	 10897:     ;
02:0003E61C 0C020005        	 10898:     cmpi.b  #$05,D2
02:0003E620 670A            	 10899:     beq  _anon_z04_139
02:0003E622 023C00EE        	 10900:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E626 123C0020        	 10901:     move.b  #$20,D1
02:0003E62A D101            	 10902:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
                            	 10903: _anon_z04_139:
02:0003E62C 7600            	 10904:     moveq   #0,D3
02:0003E62E 1600            	 10905:     move.b  D0,D3
02:0003E630 101D            	 10906:     move.b  (A5)+,D0  ; PLA
02:0003E632 4EB900031B60    	 10907:     jsr     Anim_WriteSpecificSprite
02:0003E638 6026            	 10908:     jmp     Gleeok_CheckCollisions
                            	 10909: 
                            	 10910:     even
