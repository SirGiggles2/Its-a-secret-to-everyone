                            	  3922:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3923:     ;
02:0003B2C2 41EC00C0        	  3924:     lea     ($00C0,A4),A0
02:0003B2C6 10302000        	  3925:     move.b  (A0,D2.W),D0
02:0003B2CA 6702            	  3926:     beq.s  __far_z_04_0033
