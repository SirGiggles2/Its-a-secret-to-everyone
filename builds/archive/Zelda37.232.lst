                            	  4343: ; Params:
                            	  4344: ; Y: middle speed index (4)
                            	  4345: ; [03]: horizontal distance
                            	  4346: ; [04]: vertical distance
                            	  4347: ; [0A]: vertical direction
                            	  4348: ; [0B]: horizontal direction
                            	  4349: ;
                            	  4350: ; Returns:
                            	  4351: ; Y: speed index (0 to 8) for the angle
                            	  4352: ;
                            	  4353: ;
                            	  4354: ; TODO: call it speed index or angle?
                            	  4355: ; Store the middle speed index in [00]. It will be changed to the
                            	  4356: ; right speed index to use incrementally.
                            	  4357: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4358: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4359: ;
                            	  4360:     even
                            	  4361: _CalcDiagonalSpeedIndex:
02:00030D88 1883            	  4362:     move.b  D3,($0000,A4)
                            	  4363:     ; Assuming horizontal distance >= vertical distance, the
                            	  4364:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4365:     ;
02:00030D8A 103C00FF        	  4366:     move.b  #$FF,D0
02:00030D8E 19400001        	  4367:     move.b  D0,($0001,A4)
                            	  4368:     ; TODO:
                            	  4369:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4370:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4371:     ;
                            	  4372:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4373:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4374:     ; of the farther distance faster.
                            	  4375:     ;
02:00030D92 102C0003        	  4376:     move.b  ($0003,A4),D0
02:00030D96 122C0004        	  4377:     move.b  ($0004,A4),D1
02:00030D9A B001            	  4378:     cmp.b   D1,D0
02:00030D9C 6416            	  4379:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
