02:0003C9B2 41EC0437        	  7039:     lea     ($0437,A4),A0
02:0003C9B6 10302000        	  7040:     move.b  (A0,D2.W),D0
02:0003C9BA 023C00EE        	  7041:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C9BE 123C0001        	  7042:     move.b  #$01,D1
02:0003C9C2 D101            	  7043:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003C9C4 41EC0437        	  7044:     lea     ($0437,A4),A0
02:0003C9C8 11802000        	  7045:     move.b  D0,(A0,D2.W)
02:0003C9CC 6034            	  7046:     jmp     L_Dodongo_DecrementBloatedTimer
