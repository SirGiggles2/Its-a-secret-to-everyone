02:0003F4EF 10
02:0003F4F0 00
02:0003F4F1 10
                            	 12936: 
                            	 12937:     even
                            	 12938: GanonSpriteOffsetsY:
02:0003F4F2 00              	 12939:     dc.b    $00, $00, $10, $10
02:0003F4F3 00
