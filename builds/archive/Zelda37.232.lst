02:0004D206 203C00FF6530    	  7406:     move.l  #$FF6530,D0
02:0004D20C D083            	  7407:     add.l   D3,D0
02:0004D20E 7600            	  7408:     moveq   #0,D3
02:0004D210 162C0525        	  7409:     move.b  ($0525,A4),D3
02:0004D214 E84B            	  7410:     lsr.w   #4,D3
02:0004D216 5943            	  7411:     subi.w  #4,D3
02:0004D218 E34B            	  7412:     lsl.w   #1,D3
02:0004D21A D083            	  7413:     add.l   D3,D0
02:0004D21C 2040            	  7414:     movea.l D0,A0
02:0004D21E 1010            	  7415:     move.b  (A0),D0
02:0004D220 0C000084        	  7416:     cmpi.b  #$84,D0
02:0004D224 6544            	  7417:     blo     _L_z07_P47_post2_ok
                            	  7418:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
