                            	  4008: __far_z_04_0035:
                            	  4009:     ; State 0.
                            	  4010:     ;
                            	  4011:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  4012:     ;
02:0003B358 102C0084        	  4013:     move.b  ($0084,A4),D0
02:0003B35C 0C0000AD        	  4014:     cmpi.b  #$AD,D0
02:0003B360 661E            	  4015:     bne  _L_z04_UpdatePondFairy_Exit
                            	  4016:     ; If Link's X < $70 or >= $81, then return.
                            	  4017:     ;
02:0003B362 102C0070        	  4018:     move.b  ($0070,A4),D0
02:0003B366 0C000070        	  4019:     cmpi.b  #$70,D0
02:0003B36A 6514            	  4020:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B36C 0C000081        	  4021:     cmpi.b  #$81,D0
02:0003B370 640E            	  4022:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  4023:     ; Link is at the edge of the pond. Advance to state 1,
                            	  4024:     ; halt Link, and start filling hearts.
                            	  4025:     ;
02:0003B372 522C00AD        	  4026:     addq.b  #1,($00AD,A4)
02:0003B376 7040            	  4027:     moveq   #64,D0
02:0003B378 194000AC        	  4028:     move.b  D0,($00AC,A4)
02:0003B37C 19400063        	  4029:     move.b  D0,($0063,A4)
                            	  4030:     even
                            	  4031: _L_z04_UpdatePondFairy_Exit:
02:0003B380 4E75            	  4032:     rts
                            	  4033: 
                            	  4034:     even
                            	  4035: PondFairy_HandleOtherStates:
02:0003B382 0C000001        	  4036:     cmpi.b  #$01,D0
02:0003B386 6610            	  4037:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  4038:     ; State 1. Flying and filling hearts.
                            	  4039:     ;
                            	  4040:     ; If still filling hearts, then go draw Link and hearts.
                            	  4041:     ;
02:0003B388 102C0063        	  4042:     move.b  ($0063,A4),D0
02:0003B38C 6620            	  4043:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4044:     ; If not filling hearts anymore, then go to state 2,
                            	  4045:     ; and set Link's object timer to $50, to keep showing hearts
                            	  4046:     ; a little while after we finish filling hearts.
                            	  4047:     ;
02:0003B38E 522C00AD        	  4048:     addq.b  #1,($00AD,A4)
02:0003B392 7050            	  4049:     moveq   #80,D0
02:0003B394 19400029        	  4050:     move.b  D0,($0029,A4)
                            	  4051:     even
                            	  4052: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  4053:     ; If state <> 2 (so, it's 3), then return.
                            	  4054:     ;
                            	  4055:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  4056:     ; In this case, A has $50 -- the value that Link's object timer
                            	  4057:     ; was set to, and we'll return.
                            	  4058:     ;
02:0003B398 0C000002        	  4059:     cmpi.b  #$02,D0
02:0003B39C 6634            	  4060:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  4061:     ; State = 2.
                            	  4062:     ;
                            	  4063:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  4064:     ;
02:0003B39E 102C0029        	  4065:     move.b  ($0029,A4),D0
02:0003B3A2 660A            	  4066:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  4067:     ; Else go to state 3, and unhalt Link.
                            	  4068:     ;
02:0003B3A4 522C00AD        	  4069:     addq.b  #1,($00AD,A4)
02:0003B3A8 7000            	  4070:     moveq   #0,D0
02:0003B3AA 194000AC        	  4071:     move.b  D0,($00AC,A4)
                            	  4072:     even
                            	  4073: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  4074:     ; TODO: but why, since Link is halted?
                            	  4075:     ;
                            	  4076:     ; Reset the input direction, so that Link doesn't animate
                            	  4077:     ; when drawing him.
02:0003B3AE 7600            	  4078:     moveq   #0,D3
02:0003B3B0 194303F8        	  4079:     move.b  D3,($03F8,A4)
                            	  4080:     ; Save and reset Link's state.
                            	  4081:     ;
                            	  4082:     ; TODO: but why, since Link is halted?
                            	  4083:     ;
02:0003B3B4 102C00AC        	  4084:     move.b  ($00AC,A4),D0
02:0003B3B8 1B00            	  4085:     move.b  D0,-(A5)  ; PHA
02:0003B3BA 194300AC        	  4086:     move.b  D3,($00AC,A4)
02:0003B3BE 4EB90004BC8E    	  4087:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  4088:     ; Restore Link's state.
                            	  4089:     ;
02:0003B3C4 101D            	  4090:     move.b  (A5)+,D0  ; PLA
02:0003B3C6 194000AC        	  4091:     move.b  D0,($00AC,A4)
