                            	  2062: ;==============================================================================
                            	  2063: ; EXPORT side — carry-returning shims.
                            	  2064: ; Bit 8 of D0 = raw M68K carry. Extracted into CCR, then eori #$01,CCR
                            	  2065: ; reproduces the original function's carry normalization.
                            	  2066: ;==============================================================================
                            	  2067: 
                            	  2068: ; CopyNextRowToTransferBuf — no args. Returns D0.b=row, carry in bit 8.
                            	  2069: c_copy_next_row_to_transfer_buf:
02:0002BF84 4EB900000000    	  2070:     jsr     z05_copy_next_row_to_transfer_buf
02:0002BF8A 08000008        	  2071:     btst    #8,D0
02:0002BF8E 670A            	  2072:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2073:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2074:     eori    #$01,CCR
02:0002BF98 4E75            	  2075:     rts
                            	  2076: .cc_cnr:
02:0002BF9A 023C00FE        	  2077:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2078:     eori    #$01,CCR
02:0002BFA2 4E75            	  2079:     rts
                            	  2080: 
                            	  2081: ; CopyNextRowToTransferBufAndAdvanceSubmodeWhenDone — no args. Carry-returning.
