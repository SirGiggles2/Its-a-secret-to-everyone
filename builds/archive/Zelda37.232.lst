                            	  6797: Aquamentus_Draw:
                            	  6798:     ; Every $10 screen frames, switch animation frames.
                            	  6799:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6800:     ; The last tile of frame 0 is at index 5.
                            	  6801:     ; The last tile of frame 1 is at index $B.
                            	  6802:     ;
02:0003C7E6 7605            	  6803:     moveq   #5,D3
02:0003C7E8 102C0015        	  6804:     move.b  ($0015,A4),D0
02:0003C7EC 02000010        	  6805:     andi.b #$10,D0
02:0003C7F0 6602            	  6806:     bne  _anon_z04_88
02:0003C7F2 760B            	  6807:     moveq   #11,D3
                            	  6808: _anon_z04_88:
02:0003C7F4 1943000A        	  6809:     move.b  D3,($000A,A4)
                            	  6810:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6811:     ;
02:0003C7F8 7005            	  6812:     moveq   #5,D0
02:0003C7FA 1940000B        	  6813:     move.b  D0,($000B,A4)
                            	  6814:     even
                            	  6815: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003C7FE 7600            	  6816:     moveq   #0,D3
02:0003C800 162C000B        	  6817:     move.b  ($000B,A4),D3
                            	  6818:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6819:     ; Store it in [00].
                            	  6820:     ;
02:0003C804 10342070        	  6821:     move.b  ($70,A4,D2.W),D0
02:0003C808 023C00EE        	  6822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C80C 41F90003C7E0    	  6823:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003C812 12303000        	  6824:     move.b  (A0,D3.W),D1
02:0003C816 D101            	  6825:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003C818 1880            	  6826:     move.b  D0,($0000,A4)
                            	  6827:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6828:     ; Store it in [01].
                            	  6829:     ;
02:0003C81A 41EC0084        	  6830:     lea     ($0084,A4),A0
02:0003C81E 10302000        	  6831:     move.b  (A0,D2.W),D0
02:0003C822 023C00EE        	  6832:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C826 41F90003C7DA    	  6833:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003C82C 12303000        	  6834:     move.b  (A0,D3.W),D1
02:0003C830 D101            	  6835:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003C832 19400001        	  6836:     move.b  D0,($0001,A4)
                            	  6837:     ; Calculate sprite attributes:
                            	  6838:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6839:     ;
                            	  6840:     ; If the boss is temporarily invincible, then
                            	  6841:     ; this makes it flash by cycling all the palette rows.
                            	  6842:     ;
                            	  6843:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6844:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6845:     ;
02:0003C836 41EC04F0        	  6846:     lea     ($04F0,A4),A0
02:0003C83A 10302000        	  6847:     move.b  (A0,D2.W),D0
02:0003C83E 02000003        	  6848:     andi.b #$03,D0
02:0003C842 0A000003        	  6849:     eori.b #$03,D0
02:0003C846 19400003        	  6850:     move.b  D0,($0003,A4)
02:0003C84A 7600            	  6851:     moveq   #0,D3
02:0003C84C 162C000A        	  6852:     move.b  ($000A,A4),D3
                            	  6853:     ; Look up the tile for this sprite.
                            	  6854:     ; If it's not the first one (face), then go write the sprite record.
                            	  6855:     ;
02:0003C850 41F90003C7CE    	  6856:     lea     (AquamentusTiles).l,A0
02:0003C856 10303000        	  6857:     move.b  (A0,D3.W),D0
02:0003C85A 12390003C7CE    	  6858:     move.b  (AquamentusTiles).l,D1
02:0003C860 B001            	  6859:     cmp.b   D1,D0
02:0003C862 6610            	  6860:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6861:     ; Else it's the first one (the face tile).
                            	  6862:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6863:     ;
                            	  6864:     ; $CC/CD shows the closed mouth face.
                            	  6865:     ; $C0/C1 shows the open mouth face.
                            	  6866:     ;
02:0003C864 7600            	  6867:     moveq   #0,D3
02:0003C866 16342028        	  6868:     move.b  ($28,A4,D2.W),D3
02:0003C86A 0C030020        	  6869:     cmpi.b  #$20,D3
