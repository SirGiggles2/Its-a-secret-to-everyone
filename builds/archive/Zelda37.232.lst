                            	  3986:     ;
02:0003B330 41EC0405        	  3987:     lea     ($0405,A4),A0
02:0003B334 10302000        	  3988:     move.b  (A0,D2.W),D0
02:0003B338 670A            	  3989:     beq  _anon_z04_55
02:0003B33A 705D            	  3990:     moveq   #93,D0
02:0003B33C 41EC034F        	  3991:     lea     ($034F,A4),A0
02:0003B340 11802000        	  3992:     move.b  D0,(A0,D2.W)
