02:00044BEE 123C0020        	  8031:     move.b  #$20,D1
02:00044BF2 D101            	  8032:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00044BF4 6404            	  8033:     bcc  _anon_z05_169
02:00044BF6 522C0302        	  8034:     addq.b  #1,($0302,A4)
                            	  8035: _anon_z05_169:
02:00044BFA 5303            	  8036:     subq.b  #1,D3
02:00044BFC 6AEC            	  8037:     bpl  _L_z05_PrepFullBlackRow_Add20H
02:00044BFE 19400303        	  8038:     move.b  D0,($0303,A4)
02:00044C02 7060            	  8039:     moveq   #96,D0
02:00044C04 19400304        	  8040:     move.b  D0,($0304,A4)
02:00044C08 7024            	  8041:     moveq   #36,D0
02:00044C0A 19400305        	  8042:     move.b  D0,($0305,A4)
02:00044C0E 103C00FF        	  8043:     move.b  #$FF,D0
02:00044C12 19400306        	  8044:     move.b  D0,($0306,A4)
02:00044C16 60C2            	  8045:     jmp     DecSubmenuScroll
