02:0003041A D101            	  2934:     addx.b  D1,D0   ; ADC CurObjIndex
02:0003041C 7400            	  2935:     moveq   #0,D2
02:0003041E 1400            	  2936:     move.b  D0,D2
                            	  2937:     ; Look up and set the location for this iteration's individual trap.
