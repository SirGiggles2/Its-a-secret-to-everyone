02:00044D22 162C0010        	  8244:     move.b  ($0010,A4),D3
02:00044D26 6700008C        	  8245:     beq  _L_z05_HaveInput_SetLinkDirAndSpeed
                            	  8246:     ; In UW. There are two input directions, and they're both walkable.
                            	  8247:     ;
                            	  8248:     ; Normally, turn to the direction that's perpendicular to object
                            	  8249:     ; direction. But keep going straight after that, while diagonal
                            	  8250:     ; input is held.
                            	  8251:     ;
                            	  8252:     ; Handle special cases for doors.
                            	  8253:     ;
                            	  8254:     ;
                            	  8255:     ; 1. Link at horizontal doors.
                            	  8256:     ;
                            	  8257:     ; If Link's X = $20 or $D0 then
                            	  8258:     ;   If Link's Y = $85 and facing down then
                            	  8259:     ;     Go set object direction and input direction to object
                            	  8260:     ;     direction, and set Link's speed. Also, *RESET*
                            	  8261:     ;     Link_GoStraightWhenDiagInput.
                            	  8262:     ;   Else
                            	  8263:     ;     Go turn to the perpendicular direction
                            	  8264:     ;
02:00044D2A 7600            	  8265:     moveq   #0,D3
02:00044D2C 162C0070        	  8266:     move.b  ($0070,A4),D3
02:00044D30 0C030020        	  8267:     cmpi.b  #$20,D3
02:00044D34 6706            	  8268:     beq  _anon_z05_175
02:00044D36 0C0300D0        	  8269:     cmpi.b  #$D0,D3
02:00044D3A 661C            	  8270:     bne  _anon_z05_176
