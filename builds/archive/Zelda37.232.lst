                            	  7365: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D1B2 7400            	  7366:     moveq   #0,D2
02:0004D1B4 142C0340        	  7367:     move.b  ($0340,A4),D2
                            	  7368:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7369:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7370:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7371:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7372:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7373:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7374:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7375:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7376:     ; corrupting them and causing a deterministic address-error
                            	  7377:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7378:     ; identified by Codex static review.)
                            	  7379: _L_z07_P47_pre_check:
02:0004D1B8 102C0525        	  7380:     move.b  ($0525,A4),D0
02:0004D1BC 020000F0        	  7381:     andi.b  #$F0,D0
02:0004D1C0 0C000040        	  7382:     cmpi.b  #$40,D0
02:0004D1C4 6506            	  7383:     blo     _L_z07_P47_pre_snap
02:0004D1C6 0C0000E0        	  7384:     cmpi.b  #$E0,D0
02:0004D1CA 6506            	  7385:     blo     _L_z07_P47_pre_ok
                            	  7386: _L_z07_P47_pre_snap:
02:0004D1CC 197C00480525    	  7387:     move.b  #$48,($0525,A4)
                            	  7388: _L_z07_P47_pre_ok:
02:0004D1D2 7005            	  7389:     moveq   #5,D0
02:0004D1D4 61000500        	  7390:     jsr     SwitchBank
02:0004D1D8 4EB900041DE8    	  7391:     jsr     FindNextEdgeSpawnCell
                            	  7392:     ; Post-walk 1: bottom-edge snap.
02:0004D1DE 102C0525        	  7393:     move.b  ($0525,A4),D0
02:0004D1E2 020000F0        	  7394:     andi.b  #$F0,D0
02:0004D1E6 0C0000E0        	  7395:     cmpi.b  #$E0,D0
02:0004D1EA 660C            	  7396:     bne     _L_z07_P47_post1_ok
02:0004D1EC 197C00480525    	  7397:     move.b  #$48,($0525,A4)
02:0004D1F2 4EB900041DE8    	  7398:     jsr     FindNextEdgeSpawnCell
                            	  7399: _L_z07_P47_post1_ok:
                            	  7400:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7401:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
