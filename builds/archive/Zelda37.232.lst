                            	  5625:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5626:     ;
02:000435F2 0C000001        	  5627:     cmpi.b  #$01,D0
02:000435F6 6402            	  5628:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000435F8 7004            	  5629:     moveq   #4,D0
                            	  5630:     even
                            	  5631: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5632:     ; The door attribute (DA) has been mapped to a
                            	  5633:     ; provisional door face value (PF) in %A as follows:
                            	  5634:     ;
                            	  5635:     ; DA PF Meaning
                            	  5636:     ; -------------
                            	  5637:     ; 0  4  open
                            	  5638:     ; 1  1  wall
                            	  5639:     ; 2  2  false wall
                            	  5640:     ; 3  3  false wall 2
                            	  5641:     ; 4  8  bombable
                            	  5642:     ; 5  5  key
                            	  5643:     ; 6  6  key 2
                            	  5644:     ; 7  7  shutter
                            	  5645:     ;
                            	  5646:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5647:     ; has been cleared, if the type was "open" or any wall.
                            	  5648:     ;
                            	  5649:     ;
                            	  5650:     ; Save the provisional face.
02:000435FA 1B00            	  5651:     move.b  D0,-(A5)  ; PHA
                            	  5652:     ; If the current direction points to a door that has been opened,
                            	  5653:     ; then see if we need to set door flags.
                            	  5654:     ;
02:000435FC 102C00EE        	  5655:     move.b  ($00EE,A4),D0
02:00043600 122C0002        	  5656:     move.b  ($0002,A4),D1
02:00043604 C001            	  5657:     and.b  D1,D0
02:00043606 7400            	  5658:     moveq   #0,D2
02:00043608 1400            	  5659:     move.b  D0,D2
02:0004360A 101D            	  5660:     move.b  (A5)+,D0  ; PLA
02:0004360C 122C0002        	  5661:     move.b  ($0002,A4),D1
02:00043610 B401            	  5662:     cmp.b   D1,D2
02:00043612 6624            	  5663:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5664:     ; The current direction points to a door that has been opened.
                            	  5665:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5666:     ;
                            	  5667:     ;
                            	  5668:     ; Save provisional door face in Y register.
02:00043614 7600            	  5669:     moveq   #0,D3
02:00043616 1600            	  5670:     move.b  D0,D3
02:00043618 101D            	  5671:     move.b  (A5)+,D0  ; PLA
02:0004361A 1B00            	  5672:     move.b  D0,-(A5)  ; PHA
02:0004361C 7400            	  5673:     moveq   #0,D2
02:0004361E 1400            	  5674:     move.b  D0,D2
02:00043620 1003            	  5675:     move.b  D3,D0
                            	  5676:     ; If provisional door face is not for a shutter, then
                            	  5677:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5678:     ;
                            	  5679:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5680:     ;
02:00043622 0C000007        	  5681:     cmpi.b  #$07,D0
02:00043626 670E            	  5682:     beq  _anon_z05_111
02:00043628 1B00            	  5683:     move.b  D0,-(A5)  ; PHA
02:0004362A 6100DE0E        	  5684:     jsr     SetDoorFlag
02:0004362E 101D            	  5685:     move.b  (A5)+,D0  ; PLA
                            	  5686:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5687:     ; then go make it 9 (open "bombable").
                            	  5688:     ; Else make it 4 (open "door").
                            	  5689:     ;
02:00043630 0C000008        	  5690:     cmpi.b  #$08,D0
02:00043634 67A4            	  5691:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5692: _anon_z05_111:
02:00043636 7004            	  5693:     moveq   #4,D0
                            	  5694:     even
                            	  5695: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5696:     ; For opened doors, the provisional door face has become:
                            	  5697:     ;
                            	  5698:     ; DA PF Meaning
                            	  5699:     ; -------------
                            	  5700:     ; 0  4  open
                            	  5701:     ; 1  1  wall
                            	  5702:     ; 2  2  false wall
                            	  5703:     ; 3  3  false wall 2
                            	  5704:     ; 4  9  bombable
                            	  5705:     ; 5  4  key
                            	  5706:     ; 6  4  key 2
                            	  5707:     ; 7  4  shutter
                            	  5708:     ;
                            	  5709:     ;
                            	  5710:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5711:     ;
02:00043638 7400            	  5712:     moveq   #0,D2
02:0004363A 142C0006        	  5713:     move.b  ($0006,A4),D2
02:0004363E 6712            	  5714:     beq  _anon_z05_112
02:00043640 7400            	  5715:     moveq   #0,D2
02:00043642 142C000B        	  5716:     move.b  ($000B,A4),D2
02:00043646 1B00            	  5717:     move.b  D0,-(A5)  ; PHA
02:00043648 6100FCC8        	  5718:     jsr     FindDoorAttrByDoorBit
02:0004364C 61001CB4        	  5719:     jsr     CalcOpenDoorwayMask
02:00043650 101D            	  5720:     move.b  (A5)+,D0  ; PLA
                            	  5721: _anon_z05_112:
                            	  5722:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5723:     ; because the visible door face is already a wall.
                            	  5724:     ;
02:00043652 0C000004        	  5725:     cmpi.b  #$04,D0
02:00043656 650000DC        	  5726:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5727:     ; For all other provisional face values, calculate:
                            	  5728:     ; door face := provisional face - 3
02:0004365A 003C0011        	  5729:     ori     #$11,CCR  ; SEC: set C+X
02:0004365E 123C0003        	  5730:     move.b  #$03,D1
02:00043662 0A3C0010        	  5731:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043666 9101            	  5732:     subx.b  D1,D0   ; SBC #$03
02:00043668 0A3C0010        	  5733:     eori    #$10,CCR  ; restore X = 6502 C
02:0004366C 7600            	  5734:     moveq   #0,D3
02:0004366E 1600            	  5735:     move.b  D0,D3
                            	  5736:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5737:     ; subtract one.
                            	  5738:     ;
02:00043670 0C030003        	  5739:     cmpi.b  #$03,D3
02:00043674 6502            	  5740:     bcs  _anon_z05_113
02:00043676 5303            	  5741:     subq.b  #1,D3
                            	  5742: _anon_z05_113:
                            	  5743:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5744:     ;
                            	  5745:     ; DT DFC DFO Meaning
                            	  5746:     ; ------------------
                            	  5747:     ; 0  1   1   open
                            	  5748:     ; 4  4   5   bombable
                            	  5749:     ; 5  2   1   key
                            	  5750:     ; 6  2   1   key 2
                            	  5751:     ; 7  3   1   shutter
                            	  5752:     ;
                            	  5753:     ;
                            	  5754:     ; Get the direction index.
02:00043678 101D            	  5755:     move.b  (A5)+,D0  ; PLA
02:0004367A 1B00            	  5756:     move.b  D0,-(A5)  ; PHA
02:0004367C 610000D0        	  5757:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5758:     ; If handling the second half, then offset to the second half
                            	  5759:     ; of the tiles.
                            	  5760:     ;
02:00043680 102C0006        	  5761:     move.b  ($0006,A4),D0
02:00043684 6618            	  5762:     bne  _anon_z05_114
02:00043686 41F90004359C    	  5763:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:0004368C 10302000        	  5764:     move.b  (A0,D2.W),D0
02:00043690 4EB900031138    	  5765:     jsr     AddToInt16At0
02:00043696 7006            	  5766:     moveq   #6,D0
02:00043698 4EB900031140    	  5767:     jsr     AddToInt16At2
