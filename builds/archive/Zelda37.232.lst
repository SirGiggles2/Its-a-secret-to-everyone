02:0003CACA 10342070        	  7193:     move.b  ($70,A4,D2.W),D0
02:0003CACE 023C00EE        	  7194:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CAD2 123C0008        	  7195:     move.b  #$08,D1
02:0003CAD6 D101            	  7196:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAD8 7600            	  7197:     moveq   #0,D3
02:0003CADA 41EC0098        	  7198:     lea     ($0098,A4),A0
02:0003CADE 16302000        	  7199:     move.b  (A0,D2.W),D3
02:0003CAE2 0C030004        	  7200:     cmpi.b  #$04,D3
02:0003CAE6 6406            	  7201:     bcc  _anon_z04_91
02:0003CAE8 123C0008        	  7202:     move.b  #$08,D1
02:0003CAEC D101            	  7203:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7204: _anon_z04_91:
02:0003CAEE 1880            	  7205:     move.b  D0,($0000,A4)
                            	  7206:     ; Store (Y + 8) in [01].
                            	  7207:     ;
02:0003CAF0 41EC0084        	  7208:     lea     ($0084,A4),A0
02:0003CAF4 10302000        	  7209:     move.b  (A0,D2.W),D0
02:0003CAF8 123C0008        	  7210:     move.b  #$08,D1
02:0003CAFC D101            	  7211:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CAFE 19400001        	  7212:     move.b  D0,($0001,A4)
                            	  7213:     ; Only check the first bomb slot ($10).
                            	  7214:     ;
                            	  7215:     ; Store the bomb's (X + 8) in [02].
                            	  7216:     ;
02:0003CB02 7610            	  7217:     moveq   #16,D3
02:0003CB04 10343070        	  7218:     move.b  ($70,A4,D3.W),D0
02:0003CB08 123C0008        	  7219:     move.b  #$08,D1
02:0003CB0C D101            	  7220:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB0E 19400002        	  7221:     move.b  D0,($0002,A4)
                            	  7222:     ; Store the bomb's (Y + 8) in [03].
                            	  7223:     ;
02:0003CB12 41EC0084        	  7224:     lea     ($0084,A4),A0
02:0003CB16 10303000        	  7225:     move.b  (A0,D3.W),D0
02:0003CB1A 123C0008        	  7226:     move.b  #$08,D1
02:0003CB1E D101            	  7227:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB20 19400003        	  7228:     move.b  D0,($0003,A4)
                            	  7229:     ; But, if there's no bomb, then return.
                            	  7230:     ;
02:0003CB24 41EC00AC        	  7231:     lea     ($00AC,A4),A0
02:0003CB28 10303000        	  7232:     move.b  (A0,D3.W),D0
02:0003CB2C 6720            	  7233:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7234:     ; If the bomb has not exploded (state $12), then
                            	  7235:     ; go see if Dodongo will eat it.
                            	  7236:     ;
02:0003CB2E 0C000012        	  7237:     cmpi.b  #$12,D0
02:0003CB32 6602            	  7238:     bne.s  __far_z_04_0065
02:0003CB34 601A            	  7239:     jmp  Dodongo_TryEatBomb
                            	  7240: __far_z_04_0065:
                            	  7241:     ; If the object in the slot is actually a fire, then return.
                            	  7242:     ;
02:0003CB36 0C000020        	  7243:     cmpi.b  #$20,D0
02:0003CB3A 6412            	  7244:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7245:     ; The bomb already blew up.
                            	  7246:     ; If the dust cloud is in range of the monster,
                            	  7247:     ; then set stunned state (2).
                            	  7248:     ;
02:0003CB3C 7600            	  7249:     moveq   #0,D3
02:0003CB3E 61000082        	  7250:     jsr     Dodongo_IsBombInRange
02:0003CB42 660A            	  7251:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003CB44 7002            	  7252:     moveq   #2,D0
02:0003CB46 41EC00AC        	  7253:     lea     ($00AC,A4),A0
02:0003CB4A 11802000        	  7254:     move.b  D0,(A0,D2.W)
                            	  7255:     even
                            	  7256: _L_z04_Dodongo_CheckBombHit_Exit:
02:0003CB4E 4E75            	  7257:     rts
