02:0003CE50 102C066C        	  7737:     move.b  ($066C,A4),D0
02:0003CE54 1234203D        	  7738:     move.b  ($3D,A4,D2.W),D1
02:0003CE58 8001            	  7739:     or.b  D1,D0
02:0003CE5A 660000AE        	  7740:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7741:     ; Every odd screen frame, go straight to drawing
                            	  7742:     ; and checking collisions.
                            	  7743:     ;
02:0003CE5E 102C0015        	  7744:     move.b  ($0015,A4),D0
02:0003CE62 E208            	  7745:     lsr.b  #1,D0   ; LSR A
02:0003CE64 6404            	  7746:     bcc.s  __far_z_04_0068
02:0003CE66 60000118        	  7747:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7748: __far_z_04_0068:
                            	  7749:     ; Otherwise move horizontally.
                            	  7750:     ;
02:0003CE6A 61000248        	  7751:     jsr     PolsVoice_MoveX
                            	  7752:     ; If state <> 0, then the monster is jumping.
                            	  7753:     ; Go handle vertical movement.
                            	  7754:     ;
02:0003CE6E 41EC00AC        	  7755:     lea     ($00AC,A4),A0
02:0003CE72 10302000        	  7756:     move.b  (A0,D2.W),D0
02:0003CE76 6706            	  7757:     beq  _L_z04_UpdatePolsVoice_State0
02:0003CE78 61000130        	  7758:     jsr     UpdatePolsVoiceState1_Jumping
