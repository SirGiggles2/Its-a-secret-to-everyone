02:00044D0E 522C0057        	  8232:     addq.b  #1,($0057,A4)
                            	  8233:     ; If in OW or only one direction of the two is walkable, then go set
                            	  8234:     ; object direction and input direction to last walkable direction
                            	  8235:     ; found, and set Link's speed.
                            	  8236:     ;
                            	  8237:     ; Also, *RESET* Link_GoStraightWhenDiagInput.
                            	  8238:     ;
02:00044D12 7400            	  8239:     moveq   #0,D2
02:00044D14 102C000D        	  8240:     move.b  ($000D,A4),D0
02:00044D18 0C030001        	  8241:     cmpi.b  #$01,D3
