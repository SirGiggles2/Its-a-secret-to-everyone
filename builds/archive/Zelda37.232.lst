                            	  9508: _L_z04_Manhandla_CheckCollisions_CountHands:
                            	  9509:     ; At this point, we have a hand that just died.
                            	  9510:     ;
                            	  9511:     ; For each hand, from 3 to 0, indexed by 0:
                            	  9512:     ;
02:0003DBE6 7603            	  9513:     moveq   #3,D3
                            	  9514:     ; Count how many are allocated.
                            	  9515:     ; This includes the current dead one, and the other living ones.
                            	  9516:     ; Store the count in [00].
                            	  9517:     ;
02:0003DBE8 7000            	  9518:     moveq   #0,D0
02:0003DBEA 1880            	  9519:     move.b  D0,($0000,A4)
                            	  9520:     even
                            	  9521: _L_z04_Manhandla_CheckCollisions_LoopHand:
02:0003DBEC 41EC0350        	  9522:     lea     ($0350,A4),A0
02:0003DBF0 10303000        	  9523:     move.b  (A0,D3.W),D0
02:0003DBF4 0C00003C        	  9524:     cmpi.b  #$3C,D0
02:0003DBF8 6602            	  9525:     bne  _anon_z04_113
02:0003DBFA 5214            	  9526:     addq.b  #1,($0000,A4)
                            	  9527: _anon_z04_113:
02:0003DBFC 5303            	  9528:     subq.b  #1,D3
02:0003DBFE 6AEC            	  9529:     bpl  _L_z04_Manhandla_CheckCollisions_LoopHand
                            	  9530:     ; Decrease by 1, to account for the current dead one.
                            	  9531:     ;
02:0003DC00 5314            	  9532:     subq.b  #1,($0000,A4)
                            	  9533:     ; If the count >= 0 (signed comparison), then
                            	  9534:     ; go change this hand object to the dead dummy.
                            	  9535:     ;
02:0003DC02 6B02            	  9536:     bmi  _anon_z04_114
02:0003DC04 661A            	  9537:     bne  _L_z04_Manhandla_CheckCollisions_MakeDeadDummy
                            	  9538: _anon_z04_114:
                            	  9539:     ; The last hand died. So, kill the base.
                            	  9540:     ;
                            	  9541:     ; Change the base segment's object type to the dead dummy.
                            	  9542:     ; Immediately set metastate to $10, instead of waiting for
                            	  9543:     ; the dead dummy object's update routine to do it.
                            	  9544:     ; Also set its timer to $10.
                            	  9545:     ;
02:0003DC06 61001AE6        	  9546:     jsr     PlayBossDeathCry
02:0003DC0A 705D            	  9547:     moveq   #93,D0
02:0003DC0C 19400354        	  9548:     move.b  D0,($0354,A4)
02:0003DC10 7010            	  9549:     moveq   #16,D0
02:0003DC12 1940040A        	  9550:     move.b  D0,($040A,A4)
02:0003DC16 1940002D        	  9551:     move.b  D0,($002D,A4)
                            	  9552:     even
