02:00031D80 102C0084        	  6439:     move.b  ($0084,A4),D0
02:00031D84 023C00EE        	  6440:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031D88 123C0008        	  6441:     move.b  #$08,D1
