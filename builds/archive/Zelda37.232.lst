                            	  2237: __far_z_04_0017:
02:0003A72C 61000592        	  2238:     jsr     UpdateBurrower
                            	  2239:     ; If zora died in the call above, then it happened while in
                            	  2240:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2241:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2242:     ; not come back after killing it.
                            	  2243:     ;
                            	  2244:     ; If state <> 3 or timer <> $FD,
                            	  2245:     ; then go see if the object needs to be destroyed.
                            	  2246:     ;
