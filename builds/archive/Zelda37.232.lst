02:0003DF76 6102            	  9994:     jsr     Gohma_DrawLegsOneSide
                            	  9995:     ; Draw the left legs.
                            	  9996:     ;
02:0003DF78 7600            	  9997:     moveq   #0,D3
                            	  9998: ; Params:
                            	  9999: ; Y: side: 0 for left, 1 for right
                            	 10000: ;
                            	 10001: ; Add the horizontal offset for the current side to Gohma's X to
                            	 10002: ; store the sprite's X in [00].
                            	 10003: ;
                            	 10004:     even
                            	 10005: Gohma_DrawLegsOneSide:
02:0003DF7A 10342070        	 10006:     move.b  ($70,A4,D2.W),D0
02:0003DF7E 023C00EE        	 10007:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF82 41F90003DF58    	 10008:     lea     (GohmaLegOffsetsX).l,A0
02:0003DF88 12303000        	 10009:     move.b  (A0,D3.W),D1
02:0003DF8C D101            	 10010:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DF8E 1880            	 10011:     move.b  D0,($0000,A4)
                            	 10012:     ; The object's Y is the sprite's.
                            	 10013:     ;
02:0003DF90 41EC0084        	 10014:     lea     ($0084,A4),A0
02:0003DF94 10302000        	 10015:     move.b  (A0,D2.W),D0
02:0003DF98 19400001        	 10016:     move.b  D0,($0001,A4)
02:0003DF9C 612A            	 10017:     jsr     Gohma_SetSpriteAttributes
                            	 10018:     ; There are only two frame images for legs: left and right.
                            	 10019:     ; There are two animation frames. They are animated as follows:
                            	 10020:     ;
                            	 10021:     ; Frame 0:
                            	 10022:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	 10023:     ; horizontal flipping = frame number = 0
                            	 10024:     ; 
                            	 10025:     ; Frame 1:
                            	 10026:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	 10027:     ; horizontal flipping = frame number = 1
                            	 10028:     ;
02:0003DF9E 4EB90004CD4C    	 10029:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DFA4 1003            	 10030:     move.b  D3,D0
02:0003DFA6 023C00EE        	 10031:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFAA 41EC03E4        	 10032:     lea     ($03E4,A4),A0
02:0003DFAE 12302000        	 10033:     move.b  (A0,D2.W),D1
02:0003DFB2 D101            	 10034:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003DFB4 02000001        	 10035:     andi.b #$01,D0
02:0003DFB8 023C00EE        	 10036:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFBC 123C0004        	 10037:     move.b  #$04,D1
02:0003DFC0 D101            	 10038:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DFC2 4EF900031836    	 10039:     jmp     DrawObjectNotMirrored
                            	 10040: 
