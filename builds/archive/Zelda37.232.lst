02:0004446A 020000F0        	  7354:     andi.b #$F0,D0
                            	  7355:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7356:     ; the height of each row.
                            	  7357:     ;
02:0004446E 003C0011        	  7358:     ori     #$11,CCR  ; SEC: set C+X
02:00044472 123C0040        	  7359:     move.b  #$40,D1
02:00044476 0A3C0010        	  7360:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004447A 9101            	  7361:     subx.b  D1,D0   ; SBC #$40
02:0004447C 0A3C0010        	  7362:     eori    #$10,CCR  ; restore X = 6502 C
02:00044480 E208            	  7363:     lsr.b  #1,D0   ; LSR A
02:00044482 E208            	  7364:     lsr.b  #1,D0   ; LSR A
02:00044484 E208            	  7365:     lsr.b  #1,D0   ; LSR A
                            	  7366:     ; Add this row offset to the column address.
                            	  7367:     ;
02:00044486 4EB900031138    	  7368:     jsr     AddToInt16At0
                            	  7369:     ; Assume that we'll write a type 1 square with primary square
                            	  7370:     ; taken from [05]. If so, the square index doesn't matter
                            	  7371:     ; as long as >= $10. See WriteSquareOW.
                            	  7372:     ;
02:0004448C 7600            	  7373:     moveq   #0,D3
02:0004448E 7410            	  7374:     moveq   #16,D2
02:00044490 102C0005        	  7375:     move.b  ($0005,A4),D0
                            	  7376:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7377:     ; So, we have to look up the square index corresponding
                            	  7378:     ; to primary square/tile in [05].
                            	  7379:     ;
