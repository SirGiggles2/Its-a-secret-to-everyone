02:0003BBD6 6100E228        	  5186:     jsr     DrawObjectNotMirroredOverLink
                            	  5187:     ; Store the offsets of the sprites to show over Link
                            	  5188:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
                            	  5189:     ;
