                            	  4207:     ;
02:0003B492 7400            	  4208:     moveq   #0,D2
02:0003B494 142C0340        	  4209:     move.b  ($0340,A4),D2
02:0003B498 4EB900031836    	  4210:     jsr     DrawObjectNotMirrored
02:0003B49E 101D            	  4211:     move.b  (A5)+,D0  ; PLA
02:0003B4A0 7400            	  4212:     moveq   #0,D2
02:0003B4A2 1400            	  4213:     move.b  D0,D2
                            	  4214:     even
