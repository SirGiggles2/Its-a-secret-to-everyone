02:00030DDE 6728            	  4415:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030DE0 0C000008        	  4416:     cmpi.b  #$08,D0
02:00030DE4 6722            	  4417:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
