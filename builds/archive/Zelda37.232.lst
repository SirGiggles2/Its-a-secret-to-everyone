02:0003C98E 41F90003C8CC    	  7021:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003C994 10303000        	  7022:     move.b  (A0,D3.W),D0
02:0003C998 41EC045E        	  7023:     lea     ($045E,A4),A0
02:0003C99C 11802000        	  7024:     move.b  D0,(A0,D2.W)
                            	  7025:     ; If substate <> 0, go decrement bloated timer.
                            	  7026:     ;
02:0003C9A0 4A03            	  7027:     cmpi.b  #$00,D3
02:0003C9A2 6702            	  7028:     beq.s  __far_z_04_0059
02:0003C9A4 605C            	  7029:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7030: __far_z_04_0059:
                            	  7031:     ; Deactivate the bomb in the first bomb slot ($10).
