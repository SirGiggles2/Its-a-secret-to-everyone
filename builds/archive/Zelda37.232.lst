02:00042122 41F9000420B2    	  4221:     lea     (DoorwayBoundsMinOver).l,A0
02:00042128 12303000        	  4222:     move.b  (A0,D3.W),D1
02:0004212C B001            	  4223:     cmp.b   D1,D0
02:0004212E 651C            	  4224:     bcs  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:00042130 41F9000420B6    	  4225:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042136 12303000        	  4226:     move.b  (A0,D3.W),D1
02:0004213A B001            	  4227:     cmp.b   D1,D0
02:0004213C 640E            	  4228:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0004213E 102C0053        	  4229:     move.b  ($0053,A4),D0
02:00042142 122C0098        	  4230:     move.b  ($0098,A4),D1
02:00042146 B001            	  4231:     cmp.b   D1,D0
02:00042148 6700FF7E        	  4232:     beq  _L_z05_CheckDoorway_SearchOverflowBounds
                            	  4233:     even
                            	  4234: _L_z05_CheckDoorway_SearchUnderflowDoorway:
                            	  4235:     ; The player might be in the original doorway facing backwards,
                            	  4236:     ; outside it, or in the other doorway along the axis.
