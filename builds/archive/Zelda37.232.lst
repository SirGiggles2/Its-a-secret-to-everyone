02:0003CF5E 023C00EE        	  7879:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF62 41F90003CE40    	  7880:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003CF68 12303000        	  7881:     move.b  (A0,D3.W),D1
