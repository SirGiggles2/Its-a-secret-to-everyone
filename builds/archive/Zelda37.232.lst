                            	  9709: Manhandla_Draw:
02:0003DD56 4EB90004CD7A    	  9710:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9711:     ; Push the "frame image and sprite attributes" value.
                            	  9712:     ;
02:0003DD5C 41EC0478        	  9713:     lea     ($0478,A4),A0
02:0003DD60 10302000        	  9714:     move.b  (A0,D2.W),D0
02:0003DD64 1B00            	  9715:     move.b  D0,-(A5)  ; PHA
                            	  9716:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9717:     ; passed along as is.
                            	  9718:     ;
02:0003DD66 02000080        	  9719:     andi.b #$80,D0
02:0003DD6A 00000001        	  9720:     ori.b #$01,D0
02:0003DD6E 4EB900031B28    	  9721:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DD74 101D            	  9722:     move.b  (A5)+,D0  ; PLA
02:0003DD76 1B00            	  9723:     move.b  D0,-(A5)  ; PHA
                            	  9724:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9725:     ;
02:0003DD78 02000040        	  9726:     andi.b #$40,D0
02:0003DD7C 6704            	  9727:     beq  _anon_z04_116
02:0003DD7E 522C000F        	  9728:     addq.b  #1,($000F,A4)
                            	  9729: _anon_z04_116:
02:0003DD82 101D            	  9730:     move.b  (A5)+,D0  ; PLA
                            	  9731:     ; If the low nibble = 2 or 3, then go draw not mirrored.
                            	  9732:     ; These are the 2 frame images of the horizontal hands.
                            	  9733:     ;
                            	  9734:     ; Else draw the base and vertical hands mirrored.
