02:0003D16C 41EC03D0        	  8104:     lea     ($03D0,A4),A0
02:0003D170 53302000        	  8105:     subq.b  #1,(A0,D2.W)
02:0003D174 6612            	  8106:     bne  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003D176 E308            	  8107:     lsl.b  #1,D0   ; ASL A
02:0003D178 41EC03D0        	  8108:     lea     ($03D0,A4),A0
02:0003D17C 11802000        	  8109:     move.b  D0,(A0,D2.W)
02:0003D180 41EC03E4        	  8110:     lea     ($03E4,A4),A0
02:0003D184 52302000        	  8111:     addq.b  #1,(A0,D2.W)
                            	  8112:     even
                            	  8113: _L_z04_UpdateLikeLike_IncCaptureTime:
                            	  8114:     ; Increment capture time.
                            	  8115:     ;
