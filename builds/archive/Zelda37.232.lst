02:0003F230 6058            	 12555:     jmp  Ganon_UpdateBrownState
                            	 12556: __far_z_04_0125:
                            	 12557:     ; State = 0: Blue
                            	 12558:     ;
                            	 12559:     ; If timer = 0, then go move around and shoot.
                            	 12560:     ;
02:0003F232 10342028        	 12561:     move.b  ($28,A4,D2.W),D0
02:0003F236 6602            	 12562:     bne.s  __far_z_04_0126
02:0003F238 600E            	 12563:     jmp  Ganon_MoveAndShoot
                            	 12564: __far_z_04_0126:
                            	 12565:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 12566:     ; Collisions were checked already.
                            	 12567:     ;
                            	 12568:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 12569:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 12570:     ;
02:0003F23A 0C000001        	 12571:     cmpi.b  #$01,D0
