02:0003B428 103C0080        	  4161:     move.b  #$80,D0
02:0003B42C 41EC0098        	  4162:     lea     ($0098,A4),A0
02:0003B430 11802000        	  4163:     move.b  D0,(A0,D2.W)
                            	  4164:     ; Starting angle $18 (N).
                            	  4165:     ;
02:0003B434 7018            	  4166:     moveq   #24,D0
