02:00031E46 1B00            	  6554:     move.b  D0,-(A5)  ; PHA
02:00031E48 0200000F        	  6555:     andi.b #$0F,D0
02:00031E4C 1940000D        	  6556:     move.b  D0,($000D,A4)
02:00031E50 101D            	  6557:     move.b  (A5)+,D0  ; PLA
02:00031E52 020000F0        	  6558:     andi.b #$F0,D0
02:00031E56 1940000E        	  6559:     move.b  D0,($000E,A4)
                            	  6560: ; Params:
                            	  6561: ; X: object index of the attacker
                            	  6562: ; [0D]: damage points high byte
                            	  6563: ; [0E]: damage points low byte
                            	  6564: ;
                            	  6565: ;
                            	  6566: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6567: ;
                            	  6568:     even
                            	  6569: Link_BeHarmed:
02:00031E5A 7600            	  6570:     moveq   #0,D3
02:00031E5C 41EC034F        	  6571:     lea     ($034F,A4),A0
02:00031E60 16302000        	  6572:     move.b  (A0,D2.W),D3
02:00031E64 0C03002E        	  6573:     cmpi.b  #$2E,D3
