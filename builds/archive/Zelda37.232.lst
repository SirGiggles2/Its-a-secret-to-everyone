02:0003D0D6 6624            	  8040:     bne  _L_z04_UpdateLikeLike_Draw
02:0003D0D8 7008            	  8041:     moveq   #8,D0
02:0003D0DA 41EC03D0        	  8042:     lea     ($03D0,A4),A0
02:0003D0DE 11802000        	  8043:     move.b  D0,(A0,D2.W)
02:0003D0E2 7600            	  8044:     moveq   #0,D3
02:0003D0E4 41EC03E4        	  8045:     lea     ($03E4,A4),A0
02:0003D0E8 16302000        	  8046:     move.b  (A0,D2.W),D3
02:0003D0EC 5203            	  8047:     addq.b  #1,D3
02:0003D0EE 1003            	  8048:     move.b  D3,D0
02:0003D0F0 02000003        	  8049:     andi.b #$03,D0
02:0003D0F4 41EC03E4        	  8050:     lea     ($03E4,A4),A0
02:0003D0F8 11802000        	  8051:     move.b  D0,(A0,D2.W)
                            	  8052:     even
                            	  8053: _L_z04_UpdateLikeLike_Draw:
                            	  8054:     ; Draw.
                            	  8055:     ;
02:0003D0FC 4EB90004CD7A    	  8056:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003D102 41EC03E4        	  8057:     lea     ($03E4,A4),A0
02:0003D106 10302000        	  8058:     move.b  (A0,D2.W),D0
02:0003D10A 4EB900031832    	  8059:     jsr     DrawObjectMirrored
                            	  8060:     ; Check collisions. If Link was not captured, then return.
                            	  8061:     ;
02:0003D110 4EB900031BB2    	  8062:     jsr     CheckMonsterCollisions
02:0003D116 41EC042C        	  8063:     lea     ($042C,A4),A0
02:0003D11A 10302000        	  8064:     move.b  (A0,D2.W),D0
02:0003D11E 673C            	  8065:     beq  _L_z04_UpdateLikeLike_Exit
                            	  8066:     ; The monster captured Link.
                            	  8067:     ; Put the monster at the same location as him.
                            	  8068:     ;
02:0003D120 102C0070        	  8069:     move.b  ($0070,A4),D0
02:0003D124 19802070        	  8070:     move.b  D0,($70,A4,D2.W)
02:0003D128 102C0084        	  8071:     move.b  ($0084,A4),D0
02:0003D12C 41EC0084        	  8072:     lea     ($0084,A4),A0
02:0003D130 11802000        	  8073:     move.b  D0,(A0,D2.W)
                            	  8074:     ; Reset Link's timer, metastate, and shove info.
                            	  8075:     ;
02:0003D134 7000            	  8076:     moveq   #0,D0
02:0003D136 19400028        	  8077:     move.b  D0,($0028,A4)
02:0003D13A 19400405        	  8078:     move.b  D0,($0405,A4)
02:0003D13E 194000C0        	  8079:     move.b  D0,($00C0,A4)
02:0003D142 194000D3        	  8080:     move.b  D0,($00D3,A4)
                            	  8081:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  8082:     ;
02:0003D146 41EC03E4        	  8083:     lea     ($03E4,A4),A0
02:0003D14A 11802000        	  8084:     move.b  D0,(A0,D2.W)
02:0003D14E 7004            	  8085:     moveq   #4,D0
02:0003D150 41EC03D0        	  8086:     lea     ($03D0,A4),A0
02:0003D154 11802000        	  8087:     move.b  D0,(A0,D2.W)
                            	  8088:     ; Now Link can't move.
                            	  8089:     ;
02:0003D158 522C0512        	  8090:     addq.b  #1,($0512,A4)
                            	  8091:     even
