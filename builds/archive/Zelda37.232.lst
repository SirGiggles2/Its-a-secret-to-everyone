02:0003CD00 4EB900031836    	  7559:     jsr     DrawObjectNotMirrored
                            	  7560:     even
                            	  7561: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CD06 101D            	  7562:     move.b  (A5)+,D0  ; PLA
02:0003CD08 7600            	  7563:     moveq   #0,D3
02:0003CD0A 1600            	  7564:     move.b  D0,D3
                            	  7565:     ; If facing vertically, then return. There's no other side to draw.
                            	  7566:     ;
02:0003CD0C 41EC0098        	  7567:     lea     ($0098,A4),A0
02:0003CD10 10302000        	  7568:     move.b  (A0,D2.W),D0
02:0003CD14 02000003        	  7569:     andi.b #$03,D0
02:0003CD18 6602            	  7570:     bne.s  __far_z_04_0067
02:0003CD1A 602E            	  7571:     jmp  L11B00_Exit
                            	  7572: __far_z_04_0067:
                            	  7573:     ; Else draw the right side.
                            	  7574:     ;
                            	  7575:     ; Keep the Y coordinate in [01].
                            	  7576:     ; But, store (X + $10) in [00].
                            	  7577:     ;
02:0003CD1C 10342070        	  7578:     move.b  ($70,A4,D2.W),D0
02:0003CD20 023C00EE        	  7579:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD24 123C0010        	  7580:     move.b  #$10,D1
02:0003CD28 D101            	  7581:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CD2A 1880            	  7582:     move.b  D0,($0000,A4)
02:0003CD2C 6114            	  7583:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7584:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7585:     ;
                            	  7586:     ; So, if we had animation frame 1, direction left:
                            	  7587:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7588:     ; - frame image index = 6 (1 + 5)
                            	  7589:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7590:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7591:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7592:     ;
                            	  7593:     ; So, 3 would have been the frame number used above for
                            	  7594:     ; the left side.
                            	  7595:     ;
                            	  7596:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7597:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7598:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7599:     ; on the right.
                            	  7600:     ;
02:0003CD2E 41F90003CC24    	  7601:     lea     (DodongoFrameImages).l,A0
02:0003CD34 10303000        	  7602:     move.b  (A0,D3.W),D0
02:0003CD38 0A000001        	  7603:     eori.b #$01,D0
02:0003CD3C 4EF900031836    	  7604:     jmp     DrawObjectNotMirrored
                            	  7605: 
                            	  7606: ; Returns:
                            	  7607: ; A: 3
                            	  7608: ; [04]: left sprite attributes
                            	  7609: ; [05]: right sprite attributes
                            	  7610: ;
                            	  7611:     even
                            	  7612: Anim_SetSpriteDescriptorLevelPaletteRow:
02:0003CD42 7003            	  7613:     moveq   #3,D0
02:0003CD44 4EB900031B28    	  7614:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  7615:     even
