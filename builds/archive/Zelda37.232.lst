                            	  7762: _L_z04_UpdatePolsVoice_State0:
                            	  7763:     ; State 0. Walking.
                            	  7764:     ;
                            	  7765:     ; If grid offset = 0, then no more distance to cover.
                            	  7766:     ; So, go change to state 1 -- jumping.
                            	  7767:     ;
02:0003CE7E 41EC0394        	  7768:     lea     ($0394,A4),A0
02:0003CE82 10302000        	  7769:     move.b  (A0,D2.W),D0
02:0003CE86 67000084        	  7770:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7771:     ; Decrement grid offset / distance remaining.
                            	  7772:     ;
02:0003CE8A 41EC0394        	  7773:     lea     ($0394,A4),A0
02:0003CE8E 53302000        	  7774:     subq.b  #1,(A0,D2.W)
                            	  7775:     ; Move vertically.
                            	  7776:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7777:     ;
02:0003CE92 41EC0084        	  7778:     lea     ($0084,A4),A0
02:0003CE96 10302000        	  7779:     move.b  (A0,D2.W),D0
02:0003CE9A 023C00EE        	  7780:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE9E 41F90003CE2E    	  7781:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003CEA4 12303000        	  7782:     move.b  (A0,D3.W),D1
