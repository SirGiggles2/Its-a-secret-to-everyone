02:0002EAD4 123C0010        	  1639:     move.b  #$10,D1
02:0002EAD8 0A3C0010        	  1640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EADC 9101            	  1641:     subx.b  D1,D0   ; SBC #$10
02:0002EADE 0A3C0010        	  1642:     eori    #$10,CCR  ; restore X = 6502 C
