                            	   516:     xref    z05_switch_to_nt1
                            	   517:     xref    z05_update_mode11_death_set_timer_inc_submode
                            	   518:     xref    z05_update_mode11_death_sub4
                            	   519:     xref    z05_update_mode11_death_sub5
                            	   520:     xref    z05_update_mode11_death_sub9
                            	   521: 
                            	   522: ;------------------------------------------------------------------------------
                            	   523: ; _c_move_object_shim — MoveObject trampoline.
                            	   524: ;
                            	   525: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   526: ;   Input:     D2 = slot (0..11)
                            	   527: ;   Preserves: D2, A4, A5
                            	   528: ;   Clobbers:  D0, D1, D3, A0
                            	   529: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   530: ;
                            	   531: ; GCC side:
                            	   532: ;   void c_move_object(unsigned short slot);
                            	   533: ;     slot arrives as a 16-bit value on the stack.
                            	   534: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   535: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   536: ;   never clobbered by gcc.
                            	   537: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   538: ;   semantics can exist in a pure C port).
                            	   539: ;------------------------------------------------------------------------------
                            	   540: _c_move_object_shim:
                            	   541:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   542:     move.b  #$AA,($0900,A4)
                            	   543:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   544:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   545:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   546:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   547:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   548:     moveq   #0,D0
02:0002B658 3002            	   549:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   550:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   551:     jsr     c_move_object
02:0002B662 588F            	   552:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   553:     rts
                            	   554: 
                            	   555: ;==============================================================================
                            	   556: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   557: ; and tail-call the native asm function.
                            	   558: ;
                            	   559: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   560: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   561: ; sign-extended).
                            	   562: ;==============================================================================
                            	   563: 
                            	   564: ;------------------------------------------------------------------------------
                            	   565: ; void c_copy_bank_to_window(unsigned int bank);
                            	   566: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   567: ;------------------------------------------------------------------------------
                            	   568: c_copy_bank_to_window:
02:0002B666 202F0004        	   569:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   570:     jmp     _copy_bank_to_window
                            	   571: 
                            	   572: ;------------------------------------------------------------------------------
                            	   573: ; unsigned char c_ppu_read_2(void);
                            	   574: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   575: ; C return: gcc expects result in D0.
                            	   576: ;------------------------------------------------------------------------------
                            	   577: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   578:     jmp     _ppu_read_2
                            	   579: 
                            	   580: ;------------------------------------------------------------------------------
                            	   581: ; void c_ppu_write_6(unsigned int val);
                            	   582: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   583: ;------------------------------------------------------------------------------
                            	   584: c_ppu_write_6:
02:0002B674 202F0004        	   585:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   586:     jmp     _ppu_write_6
                            	   587: 
                            	   588: ;------------------------------------------------------------------------------
                            	   589: ; void c_ppu_write_7(unsigned int val);
                            	   590: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   591: ;------------------------------------------------------------------------------
                            	   592: c_ppu_write_7:
02:0002B67E 202F0004        	   593:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   594:     jmp     _ppu_write_7
                            	   595: 
                            	   596: ;------------------------------------------------------------------------------
                            	   597: ; void c_turn_off_all_video(void);
                            	   598: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   599: ;------------------------------------------------------------------------------
                            	   600: c_turn_off_all_video:
02:0002B688 4EF90004A96E    	   601:     jmp     TurnOffAllVideo
                            	   602: 
                            	   603: ;==============================================================================
                            	   604: ; EXPORT side — z_03 entry point.
                            	   605: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   606: ; the transpiler emits that label pointing to this shim instead of the
                            	   607: ; z_03 asm body. The C function takes no args and returns void.
                            	   608: ;==============================================================================
                            	   609: 
                            	   610: ;------------------------------------------------------------------------------
                            	   611: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   612: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   613: ;------------------------------------------------------------------------------
                            	   614: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   615:     jmp     z03_transfer_level_pattern_blocks
                            	   616: 
                            	   617: ;==============================================================================
                            	   618: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   619: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   620: ;==============================================================================
                            	   621: 
                            	   622: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   623:     jmp     z06_init_mode2_submodes
                            	   624: 
                            	   625: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   626:     jmp     z06_copy_common_data_to_ram
                            	   627: 
                            	   628: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   629:     jmp     z06_update_mode2_load_full
                            	   630: 
                            	   631: ;==============================================================================
                            	   632: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   633: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   634: ;==============================================================================
                            	   635: 
                            	   636: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   637:     jmp     z05_copy_column_to_tilebuf
                            	   638: 
                            	   639: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   640:     jmp     z05_copy_row_to_tilebuf
                            	   641: 
                            	   642: ;==============================================================================
                            	   643: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   644: ;==============================================================================
                            	   645: 
                            	   646: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   647: c_has_compass:
02:0002B6B2 4EB900000000    	   648:     jsr     z05_has_compass
02:0002B6B8 4A00            	   649:     tst.b   D0
02:0002B6BA 4E75            	   650:     rts
                            	   651: 
                            	   652: c_has_map:
02:0002B6BC 4EB900000000    	   653:     jsr     z05_has_map
02:0002B6C2 4A00            	   654:     tst.b   D0
02:0002B6C4 4E75            	   655:     rts
                            	   656: 
                            	   657: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   658: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   659:     move.l  D0,-(SP)
02:0002B6C8 7200            	   660:     moveq   #0,D1
02:0002B6CA 1202            	   661:     move.b  D2,D1
02:0002B6CC 2F01            	   662:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   663:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   664:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   665:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   666:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   667:     addq.l  #8,SP
02:0002B6E2 201F            	   668:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   669:     rts
                            	   670: 
                            	   671: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	   672: c_add_door_flags:
02:0002B6E6 4EF900000000    	   673:     jmp     z05_add_door_flags
                            	   674: 
                            	   675: ;==============================================================================
                            	   676: ; EXPORT side — z_05 entry points (Stage 4b).
                            	   677: ;==============================================================================
                            	   678: 
                            	   679: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	   680: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	   681: c_split_room_id:
02:0002B6EC 4EB900000000    	   682:     jsr     z05_split_room_id
02:0002B6F2 7600            	   683:     moveq   #0,D3
02:0002B6F4 1600            	   684:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	   685:     lsr.w   #8,D0
02:0002B6F8 7400            	   686:     moveq   #0,D2
02:0002B6FA 1400            	   687:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	   688:     rts
                            	   689: 
                            	   690: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	   691: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	   692: c_is_dark_room:
02:0002B6FE 7000            	   693:     moveq   #0,D0
02:0002B700 3003            	   694:     move.w  D3,D0
02:0002B702 2F00            	   695:     move.l  D0,-(SP)
