02:0002E4C8 7604            	   755:     moveq   #4,D3
                            	   756: _anon_z01_7:
02:0002E4CA 41F90002E4A4    	   757:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E4D0 10303000        	   758:     move.b  (A0,D3.W),D0
02:0002E4D4 41EC0302        	   759:     lea     ($0302,A4),A0
02:0002E4D8 11803000        	   760:     move.b  D0,(A0,D3.W)
