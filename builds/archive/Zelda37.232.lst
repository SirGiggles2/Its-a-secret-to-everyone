                            	  8048: Submenu_CueTransferRowOW:
                            	  8049:     ;
                            	  8050:     ;
                            	  8051:     ; If menu scroll value is negative, then we transferred everything.
                            	  8052:     ; So, return.
                            	  8053:     ;
02:00044C18 102C005E        	  8054:     move.b  ($005E,A4),D0
02:00044C1C 6A02            	  8055:     bpl.s  __far_z_05_0105
02:00044C1E 6022            	  8056:     jmp  L17295_Exit
                            	  8057: __far_z_05_0105:
                            	  8058:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  8059:     ; and represents the current row of the submenu being processed.
                            	  8060:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  8061:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  8062:     ;
                            	  8063:     ; If the bottom bit is set, go prepare the full black row.
                            	  8064:     ;
02:00044C20 E208            	  8065:     lsr.b  #1,D0   ; LSR A
02:00044C22 7600            	  8066:     moveq   #0,D3
02:00044C24 1600            	  8067:     move.b  D0,D3
02:00044C26 6402            	  8068:     bcc.s  __far_z_05_0106
02:00044C28 60B6            	  8069:     jmp  PrepFullBlackRow
                            	  8070: __far_z_05_0106:
                            	  8071:     ; There's nothing to do for row $15.
                            	  8072:     ; If submenu row < $15, cue a transfer of a triforce or other
                            	  8073:     ; transfer buffer for this row.
                            	  8074:     ;
02:00044C2A 0C000015        	  8075:     cmpi.b  #$15,D0
02:00044C2E 640E            	  8076:     bcc  _anon_z05_170
02:00044C30 41F900044B92    	  8077:     lea     (SubmenuTransferBufSelectorsOW).l,A0
02:00044C36 10303000        	  8078:     move.b  (A0,D3.W),D0
                            	  8079:     even
                            	  8080: SelectTransferBufAndDecCounter:
02:00044C3A 19400014        	  8081:     move.b  D0,($0014,A4)
                            	  8082: _anon_z05_170:
                            	  8083:     ; Decrease the counter for the next frame.
                            	  8084:     ;
02:00044C3E 532C005E        	  8085:     subq.b  #1,($005E,A4)
                            	  8086:     even
                            	  8087: L17295_Exit:
02:00044C42 4E75            	  8088:     rts
                            	  8089: 
                            	  8090: ; Indexed by reverse direction index.
                            	  8091: ;
                            	  8092: ; Is used in mapping a direction to a mask for its axis.
                            	  8093: ; For example:
                            	  8094: ; - right masks off up and down
