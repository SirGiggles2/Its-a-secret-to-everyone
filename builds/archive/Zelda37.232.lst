02:0003C056 10302000        	  5734:     move.b  (A0,D2.W),D0
02:0003C05A 6774            	  5735:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5736:     ; This segment is dead. We'll swap the tail segment with this
                            	  5737:     ; dead segment. This way, moldorm heads are always rooted
                            	  5738:     ; in slots 5 and $A; and the segments are continguous.
