                            	  6504: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6505:     ; Link and the shot are facing opposite directions.
                            	  6506:     ; Link can parry certain weapons/shots.
                            	  6507:     ;
                            	  6508:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6509:     ; no harmful collision; but it still counts as a shot collision.
                            	  6510:     ; So, go treat this as a parry.
                            	  6511:     ;
02:00031E00 41EC034F        	  6512:     lea     ($034F,A4),A0
02:00031E04 10302000        	  6513:     move.b  (A0,D2.W),D0
02:00031E08 0C000055        	  6514:     cmpi.b  #$55,D0
02:00031E0C 650E            	  6515:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031E0E 0C00005B        	  6516:     cmpi.b  #$5B,D0
02:00031E12 6408            	  6517:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6518:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6519:     ; So, go harm Link.
                            	  6520:     ;
02:00031E14 102C0676        	  6521:     move.b  ($0676,A4),D0
02:00031E18 6602            	  6522:     bne.s  __far_z_01_0066
02:00031E1A 600E            	  6523:     jmp  HarmLink
                            	  6524: __far_z_01_0066:
                            	  6525:     even
