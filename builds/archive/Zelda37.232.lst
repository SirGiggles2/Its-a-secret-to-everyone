                            	  9747: UpdateGohma:
                            	  9748:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9749:     ;
02:0003DDA0 41EC0451        	  9750:     lea     ($0451,A4),A0
02:0003DDA4 10302000        	  9751:     move.b  (A0,D2.W),D0
02:0003DDA8 662C            	  9752:     bne  _L_z04_UpdateGohma_Move
                            	  9753:     ; If Random:
                            	  9754:     ;   >= $B0: right
                            	  9755:     ;   >= $60: left
                            	  9756:     ;   Else:   down
                            	  9757:     ;
02:0003DDAA 7001            	  9758:     moveq   #1,D0
02:0003DDAC 7600            	  9759:     moveq   #0,D3
02:0003DDAE 16342018        	  9760:     move.b  ($18,A4,D2.W),D3
02:0003DDB2 0C0300B0        	  9761:     cmpi.b  #$B0,D3
02:0003DDB6 640A            	  9762:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDB8 E308            	  9763:     lsl.b  #1,D0   ; ASL A
02:0003DDBA 0C030060        	  9764:     cmpi.b  #$60,D3
02:0003DDBE 6402            	  9765:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DDC0 E308            	  9766:     lsl.b  #1,D0   ; ASL A
                            	  9767:     even
                            	  9768: _L_z04_UpdateGohma_ChangeDir:
