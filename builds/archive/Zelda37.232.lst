02:0002E5FE 123C0098        	   936:     move.b  #$98,D1
02:0002E602 0A3C0010        	   937:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E606 9101            	   938:     subx.b  D1,D0   ; SBC #$98
02:0002E608 0A3C0010        	   939:     eori    #$10,CCR  ; restore X = 6502 C
