                            	  5279:     ; Loop twice, from 1 to 0, in order to check the left and right
                            	  5280:     ; extents of the sprite (X and X+8).
                            	  5281:     ;
02:0003BC7C 7401            	  5282:     moveq   #1,D2
                            	  5283:     even
