02:0003DBB6 660A            	  9484:     bne  _anon_z04_112
02:0003DBB8 7000            	  9485:     moveq   #0,D0
02:0003DBBA 41EC04F0        	  9486:     lea     ($04F0,A4),A0
02:0003DBBE 11802000        	  9487:     move.b  D0,(A0,D2.W)
                            	  9488: _anon_z04_112:
02:0003DBC2 6100BCB8        	  9489:     jsr     PlayBossHitCryIfNeeded
                            	  9490:     ; If still alive, then return.
