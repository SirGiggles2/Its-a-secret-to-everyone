02:0002BFAA 08000008        	  2084:     btst    #8,D0
02:0002BFAE 670A            	  2085:     beq.s   .cc_cnras
02:0002BFB0 003C0001        	  2086:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2087:     eori    #$01,CCR
02:0002BFB8 4E75            	  2088:     rts
                            	  2089: .cc_cnras:
02:0002BFBA 023C00FE        	  2090:     andi    #$FE,CCR
02:0002BFBE 0A3C0001        	  2091:     eori    #$01,CCR
02:0002BFC2 4E75            	  2092:     rts
                            	  2093: 
