                            	  4106: ; Player coordinate must be >= these bounds.
                            	  4107: ; Using these bounds; the player will be considered within the
                            	  4108: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4109: ;
                            	  4110:     even
                            	  4111: DoorwayBoundsMinOver:
02:000420B2 3D              	  4112:     dc.b    $3D, $BD, $00, $CF
02:000420B3 BD
02:000420B4 00
02:000420B5 CF
                            	  4113: 
                            	  4114: ; Player coordinate must be < these bounds.
                            	  4115: ; Using these bounds; the player will be considered within the
                            	  4116: ; bounds of a doorway, if strictly inside or 1 pixel outside.
                            	  4117: ;
                            	  4118:     even
                            	  4119: DoorwayBoundsMaxOver:
02:000420B6 5E              	  4120:     dc.b    $5E, $DE, $21, $F1
02:000420B7 DE
02:000420B8 21
02:000420B9 F1
                            	  4121: 
                            	  4122: ; Player coordinate must be >= these bounds.
                            	  4123: ; Using these bounds; the player will be considered within the
                            	  4124: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4125: ; at the edge.
                            	  4126: ;
                            	  4127:     even
                            	  4128: DoorwayBoundsMinUnder:
02:000420BA 3D              	  4129:     dc.b    $3D, $BF, $00, $D2
02:000420BB BF
02:000420BC 00
02:000420BD D2
                            	  4130: 
                            	  4131: ; Player coordinate must be < these bounds.
                            	  4132: ; Using these bounds; the player will be considered within the
                            	  4133: ; bounds of a doorway, if strictly inside except for 1 or 2 pixels
                            	  4134: ; at the edge.
                            	  4135: ;
                            	  4136:     even
                            	  4137: DoorwayBoundsMaxUnder:
02:000420BE 5C              	  4138:     dc.b    $5C, $DE, $1F, $F1
02:000420BF DE
02:000420C0 1F
02:000420C1 F1
                            	  4139: 
                            	  4140: ; Params:
                            	  4141: ; [0F]: moving direction
                            	  4142: ;
                            	  4143: ; Returns:
                            	  4144: ; [0E]: reverse index of doorway direction found, or $FF if blocked
                            	  4145: ; [0F]: untouched, or changed from 0 to a moving direction
                            	  4146: ;
                            	  4147: ; When not at or in a doorway, this function leaves
                            	  4148: ; [0F] moving direction as is.
                            	  4149: ;
                            	  4150: ; When blocked by a door, [0E] will be set to $FF. But [0F]
                            	  4151: ; will be left as is, assuming that it had been reset before this
                            	  4152: ; routine by BoundByRoom.
                            	  4153: ;
                            	  4154: ; Otherwise, [0F] will be changed from 0 to the door's direction.
                            	  4155: ;
                            	  4156: ;
                            	  4157: ; If already in a doorway, go handle it separately.
                            	  4158: ;
                            	  4159:     even
                            	  4160: CheckDoorway:
02:000420C2 102C0053        	  4161:     move.b  ($0053,A4),D0
02:000420C6 6648            	  4162:     bne  _L_z05_CheckDoorway_InDoorway
                            	  4163:     even
                            	  4164: _L_z05_CheckDoorway_SearchOverflowBounds:
                            	  4165:     ; Not in a doorway. Look for a doorway that Link might be in.
                            	  4166:     ;
                            	  4167:     ; To match a doorway:
                            	  4168:     ; 1. Link's [00] coordinate has to match the doorway's
                            	  4169:     ;    (X=$78 for verticals, Y=$8D for horizontals)
                            	  4170:     ; 2. Link's [01] coordinate has to >=  min bound, and < max bound
                            	  4171:     ;
                            	  4172:     ; The "overflow" bounds are used that consider 1 pixel outside
                            	  4173:     ; a doorway to be part of it.
                            	  4174:     ;
02:000420C8 102C0098        	  4175:     move.b  ($0098,A4),D0
02:000420CC 61000122        	  4176:     jsr     GetPlayerCoordsForDirection
02:000420D0 7603            	  4177:     moveq   #3,D3
                            	  4178:     even
