02:0003CEBC 10302000        	  7797:     move.b  (A0,D2.W),D0
02:0003CEC0 020000FC        	  7798:     andi.b #$FC,D0
02:0003CEC4 0C0000B0        	  7799:     cmpi.b  #$B0,D0
