                            	  2197: ; A: Y coordinate
                            	  2198: ; X: object index
                            	  2199: ;
                            	  2200:     even
                            	  2201: InitWhirlwind:
02:0002FF2E 6000BD1A        	  2202:     jmp     c_init_whirlwind
                            	  2203: 
                            	  2204: SetUpWhirlwind:
