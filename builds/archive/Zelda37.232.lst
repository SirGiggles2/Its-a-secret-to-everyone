                            	  3496: Obj_Shove:
                            	  3497:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3498:     ; then go handle it separately.
                            	  3499:     ;
02:0004B69E 41EC00C0        	  3500:     lea     ($00C0,A4),A0
02:0004B6A2 10302000        	  3501:     move.b  (A0,D2.W),D0
