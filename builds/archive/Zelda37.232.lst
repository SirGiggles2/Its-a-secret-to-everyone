                            	  5577: _L_z01_CheckMazes_PlaySecretTune:
                            	  5578:     ; Play secret tune, and let the player leave the maze.
                            	  5579:     ;
02:000315D0 7004            	  5580:     moveq   #4,D0
02:000315D2 19400602        	  5581:     move.b  D0,($0602,A4)
02:000315D6 4E75            	  5582:     rts
                            	  5583: 
                            	  5584: ; Params:
                            	  5585: ; [02]: Y
                            	  5586: ; [03]: X
                            	  5587: ;
                            	  5588: ; Returns:
                            	  5589: ; [00]: high byte of PPU address
                            	  5590: ; [01]: low byte of PPU address
                            	  5591: ;
                            	  5592: ;
                            	  5593: ; Turn the 16-bit value 08YY into the PPU address
                            	  5594: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5595: ;
                            	  5596: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5597: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5598: ;
                            	  5599:     even
                            	  5600: MapScreenPosToPpuAddr:
02:000315D8 6000A48C        	  5601:     jmp     c_map_screen_pos_to_ppu_addr
