02:0004442E 1B00            	  7322:     move.b  D0,-(A5)  ; PHA
                            	  7323:     ; We're dealing with squares.
                            	  7324:     ; So, align the object's X coordinate with 16 pixels.
                            	  7325:     ;
02:00044430 10342070        	  7326:     move.b  ($70,A4,D2.W),D0
02:00044434 020000F0        	  7327:     andi.b #$F0,D0
                            	  7328:     ; Divide it by 4 to get the offset of the address of the column
                            	  7329:     ; in play area map.
                            	  7330:     ;
                            	  7331:     ; The calculation is: address offset = (X / 8) * 2
                            	  7332:     ; 8 for the width of the column; 2 for the width of the address
                            	  7333:     ;
02:00044438 E208            	  7334:     lsr.b  #1,D0   ; LSR A
02:0004443A E208            	  7335:     lsr.b  #1,D0   ; LSR A
