                            	  4746: UpdateBombFlashEffect:
                            	  4747:     ; If state <> $13, return.
                            	  4748:     ;
02:00030FE6 41EC00AC        	  4749:     lea     ($00AC,A4),A0
02:00030FEA 10302000        	  4750:     move.b  (A0,D2.W),D0
02:00030FEE 0C000013        	  4751:     cmpi.b  #$13,D0
02:00030FF2 662E            	  4752:     bne  _L_z01_UpdateBombFlashEffect_Exit
                            	  4753:     ; The effect involves turning grayscale rendering on and off
                            	  4754:     ; in PPUMASK.
                            	  4755:     ;
                            	  4756:     ; Start by setting A register to the PPU mask shifted right to
                            	  4757:     ; throw away the grayscale bit.
                            	  4758:     ;
02:00030FF4 102C00FE        	  4759:     move.b  ($00FE,A4),D0
02:00030FF8 E208            	  4760:     lsr.b  #1,D0   ; LSR A
                            	  4761:     ; Then, based on the timer value, shift in a 1 or 0 in the low bit.
                            	  4762:     ;
02:00030FFA 7600            	  4763:     moveq   #0,D3
02:00030FFC 16342028        	  4764:     move.b  ($28,A4,D2.W),D3
                            	  4765:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4766:     ; Carry will have been set, because of the comparison (CPY).
                            	  4767:     ;
02:00031000 0C030016        	  4768:     cmpi.b  #$16,D3
02:00031004 6706            	  4769:     beq  _anon_z01_54
02:00031006 0C030011        	  4770:     cmpi.b  #$11,D3
02:0003100A 6604            	  4771:     bne  _L_z01_UpdateBombFlashEffect_Clear
