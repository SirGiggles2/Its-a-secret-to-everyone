                            	 12499: 
                            	 12500: ; Description:
                            	 12501: ; Lift up the Triforce of Courage while the room is light.
                            	 12502: ;
                            	 12503: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12504: ;
                            	 12505:     even
                            	 12506: Ganon_ScenePhase1:
02:0003F1E2 701B            	 12507:     moveq   #27,D0
02:0003F1E4 19400505        	 12508:     move.b  D0,($0505,A4)
                            	 12509:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 12510:     ;
02:0003F1E8 102C0028        	 12511:     move.b  ($0028,A4),D0
02:0003F1EC 6702            	 12512:     beq.s  __far_z_04_0123
02:0003F1EE 6012            	 12513:     jmp  Ganon_DrawBodyFrame0
                            	 12514: __far_z_04_0123:
                            	 12515:     ; Once the timer expires:
                            	 12516:     ; 1. unhalt Link
                            	 12517:     ; 2. clear the item to lift
                            	 12518:     ; 3. play level 9 song
                            	 12519:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 12520:     ;
02:0003F1F0 194000AC        	 12521:     move.b  D0,($00AC,A4)
02:0003F1F4 19400505        	 12522:     move.b  D0,($0505,A4)
02:0003F1F8 7020            	 12523:     moveq   #32,D0
02:0003F1FA 19400600        	 12524:     move.b  D0,($0600,A4)
02:0003F1FE 522C0445        	 12525:     addq.b  #1,($0445,A4)
                            	 12526:     even
                            	 12527: Ganon_DrawBodyFrame0:
                            	 12528:     ; When holding the Triforce of Courage, only draw Ganon
                            	 12529:     ; with animation frame 0.
