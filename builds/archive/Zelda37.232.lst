                            	  3253:     ; leave the chase target coordinates with his old coordinates.
                            	  3254:     ;
02:0004B4C8 102C0061        	  3255:     move.b  ($0061,A4),D0
02:0004B4CC 122C0070        	  3256:     move.b  ($0070,A4),D1
02:0004B4D0 B001            	  3257:     cmp.b   D1,D0
02:0004B4D2 6610            	  3258:     bne  _L_z07_BeginUpdateWorld_LoopObject
