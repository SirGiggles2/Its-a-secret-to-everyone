                            	  1617:     even
                            	  1618: InitMode4:
02:00040EB8 7400            	  1619:     moveq   #0,D2
02:00040EBA 142C0013        	  1620:     move.b  ($0013,A4),D2
02:00040EBE 6604            	  1621:     bne.s  __far_z_05_0023
02:00040EC0 60000084        	  1622:     jmp  InitMode_EnterRoom
                            	  1623: __far_z_05_0023:
02:00040EC4 5302            	  1624:     subq.b  #1,D2
02:00040EC6 6612            	  1625:     bne  _L_z05_InitMode4_CheckSub2
                            	  1626:     ; Submode 1.
                            	  1627:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1628:     ;
                            	  1629:     ; TODO:
                            	  1630:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1631:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1632:     ; A positive value triggers this submode 1 to transfer
                            	  1633:     ; the whole play area.
                            	  1634:     ;
                            	  1635:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1636:     ; a good state reflecting the new room. The only thing
                            	  1637:     ; needed is possibly to brighten the room by way of
                            	  1638:     ; changing the palette.
                            	  1639:     ;
                            	  1640:     ; So why does mode 7 trigger this?
                            	  1641:     ; Is there another mode that truly needs this behavior?
                            	  1642:     ;
02:00040EC8 102C00E9        	  1643:     move.b  ($00E9,A4),D0
02:00040ECC 6B06            	  1644:     bmi  _anon_z05_40
02:00040ECE 61003600        	  1645:     jsr     CopyNextRowToTransferBuf
02:00040ED2 6404            	  1646:     bcc  _L_z05_InitMode4_Exit
                            	  1647: _anon_z05_40:
02:00040ED4 522C0013        	  1648:     addq.b  #1,($0013,A4)
                            	  1649:     even
                            	  1650: _L_z05_InitMode4_Exit:
02:00040ED8 4E75            	  1651:     rts
                            	  1652: 
                            	  1653:     even
                            	  1654: _L_z05_InitMode4_CheckSub2:
02:00040EDA 5302            	  1655:     subq.b  #1,D2
02:00040EDC 6702            	  1656:     beq.s  __far_z_05_0024
02:00040EDE 6058            	  1657:     jmp  InitMode4_Sub3
                            	  1658: __far_z_05_0024:
                            	  1659:     ; Submode 2.
                            	  1660:     ;
02:00040EE0 7600            	  1661:     moveq   #0,D3
02:00040EE2 162C00EB        	  1662:     move.b  ($00EB,A4),D3
02:00040EE6 6100442C        	  1663:     jsr     IsDarkRoom_Bank5
02:00040EEA 6702            	  1664:     beq.s  __far_z_05_0025
02:00040EEC 6052            	  1665:     jmp  InitMode4_GoToSub0
                            	  1666: __far_z_05_0025:
                            	  1667:     ; This is a light room.
                            	  1668:     ; See if we have to brighten it after leaving a dark room.
                            	  1669:     ;
02:00040EEE 102C0098        	  1670:     move.b  ($0098,A4),D0
02:00040EF2 61004268        	  1671:     jsr     CalcNextRoomByDir
                            	  1672:     ; Subtract RoomId from next room ID that was calculated
                            	  1673:     ; to get room ID offset in that direction.
02:00040EF6 003C0011        	  1674:     ori     #$11,CCR  ; SEC: set C+X
02:00040EFA 122C00EB        	  1675:     move.b  ($00EB,A4),D1
02:00040EFE 0A3C0010        	  1676:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040F02 9101            	  1677:     subx.b  D1,D0   ; SBC RoomId
02:00040F04 0A3C0010        	  1678:     eori    #$10,CCR  ; restore X = 6502 C
02:00040F08 4EB900030CEA    	  1679:     jsr     Negate
02:00040F0E 023C00EE        	  1680:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040F12 122C00EB        	  1681:     move.b  ($00EB,A4),D1
02:00040F16 D101            	  1682:     addx.b  D1,D0   ; ADC RoomId
02:00040F18 7600            	  1683:     moveq   #0,D3
02:00040F1A 1600            	  1684:     move.b  D0,D3
02:00040F1C 610043F6        	  1685:     jsr     IsDarkRoom_Bank5
02:00040F20 6602            	  1686:     bne.s  __far_z_05_0026
02:00040F22 601C            	  1687:     jmp  InitMode4_GoToSub0
                            	  1688: __far_z_05_0026:
                            	  1689:     ; The previous room was dark.
                            	  1690:     ;
02:00040F24 102C051F        	  1691:     move.b  ($051F,A4),D0
02:00040F28 6702            	  1692:     beq.s  __far_z_05_0027
02:00040F2A 6014            	  1693:     jmp  InitMode4_GoToSub0
                            	  1694: __far_z_05_0027:
02:00040F2C 103C00C0        	  1695:     move.b  #$C0,D0
                            	  1696: ; Params:
                            	  1697: ; A: start index of cycle
                            	  1698: ;
                            	  1699:     even
                            	  1700: SetFadeCycleAndAdvanceSubmode:
02:00040F30 4EF90002C036    	  1701:     jmp     c_set_fade_cycle_advance_submode
                            	  1702: 
                            	  1703: _anon_z05_41:
02:00040F36 4E75            	  1704:     rts
                            	  1705: 
                            	  1706:     even
                            	  1707: InitMode4_Sub3:
                            	  1708:     ; Submode 3.
                            	  1709:     ;
02:00040F38 4EB9000314B4    	  1710:     jsr     AnimateWorldFading
02:00040F3E 66F6            	  1711:     bne  _anon_z05_41
                            	  1712:     even
                            	  1713: InitMode4_GoToSub0:
02:00040F40 4EF90002B9E8    	  1714:     jmp     c_init_mode4_go_to_sub0
                            	  1715: 
                            	  1716: InitMode_EnterRoom:
02:00040F46 4EB90004B0CC    	  1717:     jsr     DrawSpritesBetweenRooms
02:00040F4C 4EB90004B0EA    	  1718:     jsr     ResetPlayerState
                            	  1719:     ; Reset [0300] to [051F].
                            	  1720:     ;
02:00040F52 7005            	  1721:     moveq   #5,D0
02:00040F54 761F            	  1722:     moveq   #31,D3
02:00040F56 4EB90004A924    	  1723:     jsr     ClearRam0300UpTo
                            	  1724:     ; Reset door trigger info.
                            	  1725:     ;
02:00040F5C 7000            	  1726:     moveq   #0,D0
02:00040F5E 19400054        	  1727:     move.b  D0,($0054,A4)
02:00040F62 19400055        	  1728:     move.b  D0,($0055,A4)
                            	  1729:     ; Store level block attribute byte F for convenience.
                            	  1730:     ;
02:00040F66 7600            	  1731:     moveq   #0,D3
02:00040F68 162C00EB        	  1732:     move.b  ($00EB,A4),D3
02:00040F6C 41F900FF6AFE    	  1733:     lea     (NES_SRAM+$0AFE).l,A0
02:00040F72 10303000        	  1734:     move.b  (A0,D3.W),D0
02:00040F76 194004CD        	  1735:     move.b  D0,($04CD,A4)
02:00040F7A 61003A3C        	  1736:     jsr     ResetInvObjState
                            	  1737:     ; There's more than one way to enter a room.
                            	  1738:     ;
                            	  1739:     ; 1: Out of a cave, dungeon, or cellar
                            	  1740:     ;     a. Walking exit
                            	  1741:     ;     b. Next to stairs
                            	  1742:     ; 2: Room to room
                            	  1743:     ;
                            	  1744:     ; Determine which one we need.
                            	  1745:     ;
02:00040F7E 102C005A        	  1746:     move.b  ($005A,A4),D0
02:00040F82 6770            	  1747:     beq  _L_z05_InitMode_EnterRoom_Method2
02:00040F84 102C0010        	  1748:     move.b  ($0010,A4),D0
02:00040F88 665C            	  1749:     bne  _anon_z05_42
                            	  1750:     ; Enter method 1.
                            	  1751:     ;
                            	  1752:     ; Set up Link's exit from underground.
                            	  1753:     ;
02:00040F8A 7600            	  1754:     moveq   #0,D3
02:00040F8C 162C00EB        	  1755:     move.b  ($00EB,A4),D3
02:00040F90 41F900FF687E    	  1756:     lea     (NES_SRAM+$087E).l,A0
02:00040F96 10303000        	  1757:     move.b  (A0,D3.W),D0
02:00040F9A 020000F0        	  1758:     andi.b #$F0,D0
02:00040F9E 19400070        	  1759:     move.b  D0,($0070,A4)
02:00040FA2 41F900FF6AFE    	  1760:     lea     (NES_SRAM+$0AFE).l,A0
02:00040FA8 10303000        	  1761:     move.b  (A0,D3.W),D0
02:00040FAC 02000007        	  1762:     andi.b #$07,D0
02:00040FB0 E308            	  1763:     lsl.b  #1,D0   ; ASL A
02:00040FB2 E308            	  1764:     lsl.b  #1,D0   ; ASL A
02:00040FB4 E308            	  1765:     lsl.b  #1,D0   ; ASL A
02:00040FB6 E308            	  1766:     lsl.b  #1,D0   ; ASL A
                            	  1767:     ; Add the first Y where Link can come out of underground.
                            	  1768:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:00040FB8 123C004D        	  1769:     move.b  #$4D,D1
02:00040FBC D101            	  1770:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00040FBE 19400084        	  1771:     move.b  D0,($0084,A4)
                            	  1772:     ; If the player didn't step on a cave entrance to go underground,
                            	  1773:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1774:     ;
02:00040FC2 7600            	  1775:     moveq   #0,D3
02:00040FC4 162C0065        	  1776:     move.b  ($0065,A4),D3
02:00040FC8 0C030024        	  1777:     cmpi.b  #$24,D3
02:00040FCC 6618            	  1778:     bne  _anon_z05_42
                            	  1779:     ; Enter method 1-a.
                            	  1780:     ;
                            	  1781:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1782:     ;
02:00040FCE 19400412        	  1783:     move.b  D0,($0412,A4)
