                            	  1250: _L_z04_UpdateFireball_Move:
                            	  1251:     ; A movement routine is used that works along one axis.
                            	  1252:     ; So, load its parameters, and call it for each axis individually.
                            	  1253:     ;
                            	  1254:     ; First, load the horizontal direction into [0F].
                            	  1255:     ;
02:0003A05A 41EC0412        	  1256:     lea     ($0412,A4),A0
02:0003A05E 10302000        	  1257:     move.b  (A0,D2.W),D0
02:0003A062 1940000F        	  1258:     move.b  D0,($000F,A4)
                            	  1259:     ; Load the horizontal q-speed and position fraction,
                            	  1260:     ; move, then save the position fraction.
                            	  1261:     ;
02:0003A066 41EC041F        	  1262:     lea     ($041F,A4),A0
02:0003A06A 10302000        	  1263:     move.b  (A0,D2.W),D0
02:0003A06E 7600            	  1264:     moveq   #0,D3
02:0003A070 41EC0451        	  1265:     lea     ($0451,A4),A0
02:0003A074 16302000        	  1266:     move.b  (A0,D2.W),D3
02:0003A078 613E            	  1267:     jsr     Fireball_MoveOneAxis
02:0003A07A 41EC0451        	  1268:     lea     ($0451,A4),A0
02:0003A07E 11802000        	  1269:     move.b  D0,(A0,D2.W)
                            	  1270:     ; Second, load the vertical direction into [0F].
                            	  1271:     ;
02:0003A082 41EC0437        	  1272:     lea     ($0437,A4),A0
02:0003A086 10302000        	  1273:     move.b  (A0,D2.W),D0
02:0003A08A 1940000F        	  1274:     move.b  D0,($000F,A4)
                            	  1275:     ; Load the vertical q-speed and position fraction,
                            	  1276:     ; move, then save the position fraction.
                            	  1277:     ;
02:0003A08E 41EC0444        	  1278:     lea     ($0444,A4),A0
02:0003A092 10302000        	  1279:     move.b  (A0,D2.W),D0
02:0003A096 7600            	  1280:     moveq   #0,D3
02:0003A098 41EC045E        	  1281:     lea     ($045E,A4),A0
02:0003A09C 16302000        	  1282:     move.b  (A0,D2.W),D3
02:0003A0A0 6116            	  1283:     jsr     Fireball_MoveOneAxis
