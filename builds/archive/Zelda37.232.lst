                            	  5933: __far_z_05_0087:
                            	  5934:     ; Turn the door command into the desired open or closed state
                            	  5935:     ; to store in [08].
                            	  5936:     ;
                            	  5937:     ; cmd:  7 6 3 2 
                            	  5938:     ; [08]: 2 0 0 0
                            	  5939:     ;
                            	  5940:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5941:     ; commands intended to be used.
                            	  5942:     ;
                            	  5943:     ; 3 is the end state of 2: close
                            	  5944:     ; 7 is the end state of 6: open
                            	  5945:     ;
02:000437D4 02000007        	  5946:     andi.b #$07,D0
02:000437D8 7601            	  5947:     moveq   #1,D3
02:000437DA 19430002        	  5948:     move.b  D3,($0002,A4)
02:000437DE 122C0002        	  5949:     move.b  ($0002,A4),D1
