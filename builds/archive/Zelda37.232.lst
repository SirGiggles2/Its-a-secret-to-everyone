                            	 12827: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12828:     ; Draw the four clouds at diagonal corners.
                            	 12829:     ;
02:0003F406 610000B6        	 12830:     jsr     Ganon_GetCurCloudLeft
02:0003F40A 610000BE        	 12831:     jsr     Ganon_GetCurCloudTop
02:0003F40E 61A0            	 12832:     jsr     Ganon_DrawCloud
02:0003F410 610000B2        	 12833:     jsr     Ganon_GetCurCloudRight
02:0003F414 619A            	 12834:     jsr     Ganon_DrawCloud
02:0003F416 610000A6        	 12835:     jsr     Ganon_GetCurCloudLeft
02:0003F41A 610000B4        	 12836:     jsr     Ganon_GetCurCloudBottom
02:0003F41E 6190            	 12837:     jsr     Ganon_DrawCloud
02:0003F420 610000A2        	 12838:     jsr     Ganon_GetCurCloudRight
02:0003F424 618A            	 12839:     jsr     Ganon_DrawCloud
                            	 12840:     ; Draw the top and bottom clouds.
                            	 12841:     ;
02:0003F426 10342070        	 12842:     move.b  ($70,A4,D2.W),D0
02:0003F42A 1880            	 12843:     move.b  D0,($0000,A4)
02:0003F42C 6100009C        	 12844:     jsr     Ganon_GetCurCloudTop
02:0003F430 6100FF7E        	 12845:     jsr     Ganon_DrawCloud
02:0003F434 6100009A        	 12846:     jsr     Ganon_GetCurCloudBottom
02:0003F438 6100FF76        	 12847:     jsr     Ganon_DrawCloud
                            	 12848:     ; Draw the left and right clouds.
                            	 12849:     ;
02:0003F43C 61000080        	 12850:     jsr     Ganon_GetCurCloudLeft
02:0003F440 41EC0084        	 12851:     lea     ($0084,A4),A0
02:0003F444 10302000        	 12852:     move.b  (A0,D2.W),D0
02:0003F448 19400001        	 12853:     move.b  D0,($0001,A4)
02:0003F44C 6100FF62        	 12854:     jsr     Ganon_DrawCloud
02:0003F450 6172            	 12855:     jsr     Ganon_GetCurCloudRight
02:0003F452 6100FF5C        	 12856:     jsr     Ganon_DrawCloud
                            	 12857:     ; Save the object index.
                            	 12858:     ;
02:0003F456 102C0340        	 12859:     move.b  ($0340,A4),D0
02:0003F45A 1B00            	 12860:     move.b  D0,-(A5)  ; PHA
                            	 12861:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12862:     ;
02:0003F45C 7402            	 12863:     moveq   #2,D2
                            	 12864:     even
                            	 12865: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F45E 19420340        	 12866:     move.b  D2,($0340,A4)
                            	 12867:     ; If object slot < 5 or = 7, then move every frame.
                            	 12868:     ; Else move 3 out of every 4 frames.
                            	 12869:     ;
                            	 12870:     ; This makes pieces spread out in somewhat of a circle,
                            	 12871:     ; by making the pieces at cardinal directions move at
                            	 12872:     ; full speed while the diagonal ones move a little slower.
                            	 12873:     ;
02:0003F462 0C020005        	 12874:     cmpi.b  #$05,D2
02:0003F466 6510            	 12875:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F468 0C020007        	 12876:     cmpi.b  #$07,D2
02:0003F46C 670A            	 12877:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F46E 102C0015        	 12878:     move.b  ($0015,A4),D0
02:0003F472 02000003        	 12879:     andi.b #$03,D0
02:0003F476 6704            	 12880:     beq  _anon_z04_164
                            	 12881:     even
                            	 12882: _L_z04_Ganon_DrawBurst_Move:
02:0003F478 6100DFD6        	 12883:     jsr     BlueWizzrobe_Move
                            	 12884: _anon_z04_164:
02:0003F47C 4EB90004CD7A    	 12885:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12886:     ; The frame counter will make the sprite flash.
                            	 12887:     ; The array has the horizontal and vertical flipping attributes.
                            	 12888:     ; Combine them into [03].
                            	 12889:     ;
02:0003F482 102C0015        	 12890:     move.b  ($0015,A4),D0
02:0003F486 02000003        	 12891:     andi.b #$03,D0
02:0003F48A 41F90003F35A    	 12892:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F490 12302000        	 12893:     move.b  (A0,D2.W),D1
02:0003F494 8001            	 12894:     or.b  D1,D0
02:0003F496 19400003        	 12895:     move.b  D0,($0003,A4)
02:0003F49A 41F90003F364    	 12896:     lea     (GanonBurstTiles).l,A0
02:0003F4A0 10302000        	 12897:     move.b  (A0,D2.W),D0
02:0003F4A4 4EB900031B32    	 12898:     jsr     Anim_WriteSprite
                            	 12899:     ; Bottom of the loop.
                            	 12900:     ; Increment object slot while <= 9.
                            	 12901:     ;
02:0003F4AA 5202            	 12902:     addq.b  #1,D2
02:0003F4AC 0C02000A        	 12903:     cmpi.b  #$0A,D2
02:0003F4B0 65AC            	 12904:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12905:     ; Restore the object index.
                            	 12906:     ;
02:0003F4B2 101D            	 12907:     move.b  (A5)+,D0  ; PLA
02:0003F4B4 19400340        	 12908:     move.b  D0,($0340,A4)
02:0003F4B8 0A3C0001        	 12909:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F4BC 4E75            	 12910:     rts
                            	 12911: 
                            	 12912: ; Returns:
                            	 12913: ; [00]: X coordinate
                            	 12914: ;
                            	 12915:     even
                            	 12916: Ganon_GetCurCloudLeft:
02:0003F4BE 4EF90002BED2    	 12917:     jmp     c_ganon_get_cur_cloud_left
                            	 12918: 
