02:0003CDE0 0C000002        	  7672:     cmpi.b  #$02,D0
02:0003CDE4 6604            	  7673:     bne  _anon_z04_94
02:0003CDE6 522C000F        	  7674:     addq.b  #1,($000F,A4)
                            	  7675: _anon_z04_94:
                            	  7676:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7677:     ; This is the base frame image.
                            	  7678:     ;
02:0003CDEA E208            	  7679:     lsr.b  #1,D0   ; LSR A
02:0003CDEC E208            	  7680:     lsr.b  #1,D0   ; LSR A
                            	  7681:     ; If movement frame = 1, add 3 to frame image to access
                            	  7682:     ; the second animation frame's images.
                            	  7683:     ;
02:0003CDEE 7600            	  7684:     moveq   #0,D3
02:0003CDF0 41EC03E4        	  7685:     lea     ($03E4,A4),A0
02:0003CDF4 16302000        	  7686:     move.b  (A0,D2.W),D3
02:0003CDF8 671E            	  7687:     beq  _anon_z04_95
02:0003CDFA 023C00EE        	  7688:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDFE 123C0003        	  7689:     move.b  #$03,D1
02:0003CE02 D101            	  7690:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7691:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7692:     ;
                            	  7693:     ; Down has two frame images, but up only has one. By flipping
                            	  7694:     ; horizontally, you get two frame images.
                            	  7695:     ;
02:0003CE04 7600            	  7696:     moveq   #0,D3
02:0003CE06 41EC0098        	  7697:     lea     ($0098,A4),A0
02:0003CE0A 16302000        	  7698:     move.b  (A0,D2.W),D3
02:0003CE0E 0C030008        	  7699:     cmpi.b  #$08,D3
02:0003CE12 6604            	  7700:     bne  _anon_z04_95
02:0003CE14 522C000F        	  7701:     addq.b  #1,($000F,A4)
