                            	 10927: __far_z_04_0102:
                            	 10928:     ; The segment is not a head nor bottom. So, we can use a
                            	 10929:     ; standard routine to draw. It uses one of the rolling sprites
                            	 10930:     ; that is drawn under Link and the heads.
                            	 10931:     ;
02:0003E65A 4EB900031B2C    	 10932:     jsr     Anim_WriteLevelPaletteSprite
                            	 10933:     even
                            	 10934: Gleeok_CheckCollisions:
                            	 10935:     ; If this segment is not the head nor the bottom of the neck,
                            	 10936:     ; then loop again to process the next segment.
                            	 10937:     ;
                            	 10938:     ; This kind of segment is only drawn, and is not checked
                            	 10939:     ; for object collisions.
                            	 10940:     ;
02:0003E660 0C020005        	 10941:     cmpi.b  #$05,D2
02:0003E664 670A            	 10942:     beq  _anon_z04_141
02:0003E666 0C020001        	 10943:     cmpi.b  #$01,D2
02:0003E66A 6704            	 10944:     beq  _anon_z04_141
02:0003E66C 6000010C        	 10945:     jmp     _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 10946: 
                            	 10947: _anon_z04_141:
02:0003E670 4EB900031BB2    	 10948:     jsr     CheckMonsterCollisions
                            	 10949:     ; If this segment was harmed, then set the writhing counter,
                            	 10950:     ; and the animation counter to its lower value.
                            	 10951:     ;
02:0003E676 41EC00C0        	 10952:     lea     ($00C0,A4),A0
02:0003E67A 10302000        	 10953:     move.b  (A0,D2.W),D0
02:0003E67E 670A            	 10954:     beq  _anon_z04_142
02:0003E680 7006            	 10955:     moveq   #6,D0
02:0003E682 194004E6        	 10956:     move.b  D0,($04E6,A4)
02:0003E686 19400510        	 10957:     move.b  D0,($0510,A4)
                            	 10958: _anon_z04_142:
02:0003E68A 4EB90004B6FE    	 10959:     jsr     ResetShoveInfo
                            	 10960:     ; If this is the bottom segment, then go reset metastate and loop again.
                            	 10961:     ; Gleeok can writhe when it's hit here, but it can't die.
                            	 10962:     ;
02:0003E690 0C020001        	 10963:     cmpi.b  #$01,D2
02:0003E694 670000DE        	 10964:     beq  _L_z04_Gleeok_CheckCollisions_ResetMetastate
02:0003E698 6100B1E2        	 10965:     jsr     PlayBossHitCryIfNeeded
                            	 10966:     ; If this neck has not died, then go loop again.
                            	 10967:     ;
02:0003E69C 41EC0405        	 10968:     lea     ($0405,A4),A0
02:0003E6A0 10302000        	 10969:     move.b  (A0,D2.W),D0
02:0003E6A4 670000D4        	 10970:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 10971:     ; This neck died. So, prepare to make a flying head.
                            	 10972:     ;
02:0003E6A8 7060            	 10973:     moveq   #96,D0
02:0003E6AA 41EC0485        	 10974:     lea     ($0485,A4),A0
02:0003E6AE 11802000        	 10975:     move.b  D0,(A0,D2.W)
02:0003E6B2 1002            	 10976:     move.b  D2,D0
02:0003E6B4 1B00            	 10977:     move.b  D0,-(A5)  ; PHA
                            	 10978:     ; If the segment is not a head, then skip making a flying head.
                            	 10979:     ;
                            	 10980:     ; TODO:
                            	 10981:     ; But how can we get here in this case, since earlier branches
                            	 10982:     ; would have been taken to skip all this for all other segments?
                            	 10983:     ;
02:0003E6B6 0C020005        	 10984:     cmpi.b  #$05,D2
02:0003E6BA 663C            	 10985:     bne  _L_z04_Gleeok_CheckCollisions_DestroyNeck
                            	 10986:     ; The flying head will go in slot (neck index + 7).
                            	 10987:     ; Switch the X register to it.
                            	 10988:     ;
02:0003E6BC 102C04D7        	 10989:     move.b  ($04D7,A4),D0
02:0003E6C0 023C00EE        	 10990:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E6C4 123C0007        	 10991:     move.b  #$07,D1
02:0003E6C8 D101            	 10992:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003E6CA 7400            	 10993:     moveq   #0,D2
02:0003E6CC 1400            	 10994:     move.b  D0,D2
                            	 10995:     ; Flag it uninitialized, so that it will be initialized next frame.
                            	 10996:     ;
02:0003E6CE 103C00FF        	 10997:     move.b  #$FF,D0
02:0003E6D2 41EC0492        	 10998:     lea     ($0492,A4),A0
02:0003E6D6 11802000        	 10999:     move.b  D0,(A0,D2.W)
                            	 11000:     ; Copy the original head's coordinates to it.
                            	 11001:     ;
02:0003E6DA 102C0075        	 11002:     move.b  ($0075,A4),D0
02:0003E6DE 19802070        	 11003:     move.b  D0,($70,A4,D2.W)
02:0003E6E2 102C0089        	 11004:     move.b  ($0089,A4),D0
02:0003E6E6 41EC0084        	 11005:     lea     ($0084,A4),A0
02:0003E6EA 11802000        	 11006:     move.b  D0,(A0,D2.W)
                            	 11007:     ; Set object type $46 (flying head).
                            	 11008:     ;
02:0003E6EE 7046            	 11009:     moveq   #70,D0
02:0003E6F0 41EC034F        	 11010:     lea     ($034F,A4),A0
02:0003E6F4 11802000        	 11011:     move.b  D0,(A0,D2.W)
                            	 11012:     even
                            	 11013: _L_z04_Gleeok_CheckCollisions_DestroyNeck:
02:0003E6F8 101D            	 11014:     move.b  (A5)+,D0  ; PLA
02:0003E6FA 7400            	 11015:     moveq   #0,D2
02:0003E6FC 1400            	 11016:     move.b  D0,D2
                            	 11017:     ; Hide the original head's sprite, and the base segment's sprite.
                            	 11018:     ;
02:0003E6FE 102C04D7        	 11019:     move.b  ($04D7,A4),D0
02:0003E702 E308            	 11020:     lsl.b  #1,D0   ; ASL A
02:0003E704 E308            	 11021:     lsl.b  #1,D0   ; ASL A
02:0003E706 E308            	 11022:     lsl.b  #1,D0   ; ASL A
02:0003E708 7600            	 11023:     moveq   #0,D3
02:0003E70A 1600            	 11024:     move.b  D0,D3
02:0003E70C 103C00F8        	 11025:     move.b  #$F8,D0
02:0003E710 41EC0200        	 11026:     lea     ($0200,A4),A0
02:0003E714 11803000        	 11027:     move.b  D0,(A0,D3.W)
02:0003E718 41EC0220        	 11028:     lea     ($0220,A4),A0
02:0003E71C 11803000        	 11029:     move.b  D0,(A0,D3.W)
                            	 11030:     ; Add the bit for this neck to the dead neck mask.
                            	 11031:     ; Copy it to [00].
                            	 11032:     ;
02:0003E720 7600            	 11033:     moveq   #0,D3
02:0003E722 162C04D7        	 11034:     move.b  ($04D7,A4),D3
02:0003E726 41F90004AAC2    	 11035:     lea     (LevelMasks).l,A0
02:0003E72C 10303000        	 11036:     move.b  (A0,D3.W),D0
02:0003E730 122C0511        	 11037:     move.b  ($0511,A4),D1
02:0003E734 8001            	 11038:     or.b  D1,D0
02:0003E736 19400511        	 11039:     move.b  D0,($0511,A4)
02:0003E73A 1880            	 11040:     move.b  D0,($0000,A4)
                            	 11041:     ; Loop over the four bits in the copy of the dead neck mask.
                            	 11042:     ; Count them up, and store the amount in [00].
                            	 11043:     ;
02:0003E73C 7000            	 11044:     moveq   #0,D0
02:0003E73E 7604            	 11045:     moveq   #4,D3
                            	 11046: _anon_z04_143:
02:0003E740 1214            	 11047:     move.b  ($0000,A4),D1
02:0003E742 E209            	 11048:     lsr.b  #1,D1   ; LSR $00
02:0003E744 1881            	 11049:     move.b  D1,($0000,A4)
02:0003E746 123C0000        	 11050:     move.b  #$00,D1
02:0003E74A D101            	 11051:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003E74C 5303            	 11052:     subq.b  #1,D3
02:0003E74E 66F0            	 11053:     bne  _anon_z04_143
02:0003E750 1880            	 11054:     move.b  D0,($0000,A4)
                            	 11055:     ; Compare the number of dead necks to the original number
                            	 11056:     ; (object type - $41).
                            	 11057:     ;
02:0003E752 102C0350        	 11058:     move.b  ($0350,A4),D0
02:0003E756 003C0011        	 11059:     ori     #$11,CCR  ; SEC: set C+X
02:0003E75A 123C0041        	 11060:     move.b  #$41,D1
02:0003E75E 0A3C0010        	 11061:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E762 9101            	 11062:     subx.b  D1,D0   ; SBC #$41
02:0003E764 0A3C0010        	 11063:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E768 1214            	 11064:     move.b  ($0000,A4),D1
02:0003E76A B001            	 11065:     cmp.b   D1,D0
                            	 11066:     ; If they're equal, then go handle the whole boss dying.
                            	 11067:     ;
