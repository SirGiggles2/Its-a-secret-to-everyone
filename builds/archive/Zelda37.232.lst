                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:00040166 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0004016A 02000010        	   426:     andi.b #$10,D0
02:0004016E 6606            	   427:     bne.s  __far_z_05_0000
02:00040170 4EF90002D3E4    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:00040176 102C0254        	   430:     move.b  ($0254,A4),D0
02:0004017A 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0004017C 102C0258        	   432:     move.b  ($0258,A4),D0
02:00040180 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:00040182 4EB90004A91E    	   434:     jsr     HideAllSprites
02:00040188 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0004018A 19400258        	   436:     move.b  D0,($0258,A4)
02:0004018E 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:00040190 19400254        	   438:     move.b  D0,($0254,A4)
02:00040194 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:00040198 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004019C 4E75            	   441:     rts
