                            	   203: InitCave:
                            	   204:     ; The person goes at location ($78, $80).
                            	   205:     ;
02:0002E0F8 7078            	   206:     moveq   #120,D0
02:0002E0FA 163C0080        	   207:     move.b  #$80,D3
02:0002E0FE 610001A0        	   208:     jsr     SetUpCommonCaveObjects
                            	   209:     ; If the cave/person does not remember state (give item, door charge),
                            	   210:     ; then go handle other kinds.
                            	   211:     ;
02:0002E102 102C0350        	   212:     move.b  ($0350,A4),D0
02:0002E106 0C000072        	   213:     cmpi.b  #$72,D0
02:0002E10A 6714            	   214:     beq  _L_z01_InitCave_TakeType
02:0002E10C 0C000071        	   215:     cmpi.b  #$71,D0
02:0002E110 670E            	   216:     beq  _L_z01_InitCave_TakeType
02:0002E112 0C00007B        	   217:     cmpi.b  #$7B,D0
02:0002E116 6408            	   218:     bcc  _L_z01_InitCave_TakeType
02:0002E118 0C00006E        	   219:     cmpi.b  #$6E,D0
02:0002E11C 6502            	   220:     bcs.s  __far_z_01_0000
02:0002E11E 6012            	   221:     jmp  InitCaveContinue
                            	   222: __far_z_01_0000:
                            	   223:     even
                            	   224: _L_z01_InitCave_TakeType:
                            	   225:     ; Else the cave/person simply does:
                            	   226:     ; - taken:     no person, no text
                            	   227:     ; - not taken: show a person and text
                            	   228:     ;
                            	   229:     ; So, if the item was not taken, then go set up the text.
                            	   230:     ;
02:0002E120 610030BC        	   231:     jsr     GetRoomFlagUWItemState
02:0002E124 6602            	   232:     bne.s  __far_z_01_0001
02:0002E126 600A            	   233:     jmp  InitCaveContinue
                            	   234: __far_z_01_0001:
                            	   235:     ; Otherwise destroy the person object, and let Link continue.
                            	   236:     ;
02:0002E128 7000            	   237:     moveq   #0,D0
02:0002E12A 19400350        	   238:     move.b  D0,($0350,A4)
                            	   239:     even
                            	   240: UnhaltLink:
02:0002E12E 6000D8BE        	   241:     jmp     c_unhalt_link
                            	   242: 
                            	   243: InitCaveContinue:
                            	   244:     ; Get this cave's index (object type - $6A).
                            	   245:     ;
02:0002E132 102C0350        	   246:     move.b  ($0350,A4),D0
02:0002E136 003C0011        	   247:     ori     #$11,CCR  ; SEC: set C+X
02:0002E13A 123C006A        	   248:     move.b  #$6A,D1
02:0002E13E 0A3C0010        	   249:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E142 9101            	   250:     subx.b  D1,D0   ; SBC #$6A
02:0002E144 0A3C0010        	   251:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E148 7600            	   252:     moveq   #0,D3
02:0002E14A 1600            	   253:     move.b  D0,D3
                            	   254:     ; Get the person text selector by looking up the text selector byte
                            	   255:     ; for this index, and masking it with $3F.
                            	   256:     ;
02:0002E14C 41F90002E0CA    	   257:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E152 10303000        	   258:     move.b  (A0,D3.W),D0
02:0002E156 1B00            	   259:     move.b  D0,-(A5)  ; PHA
02:0002E158 0200003F        	   260:     andi.b #$3F,D0
02:0002E15C 19400415        	   261:     move.b  D0,($0415,A4)
                            	   262:     ; Pop and mask the text selector byte with $C0 to get the
                            	   263:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   264:     ;
02:0002E160 101D            	   265:     move.b  (A5)+,D0  ; PLA
02:0002E162 020000C0        	   266:     andi.b #$C0,D0
02:0002E166 19400003        	   267:     move.b  D0,($0003,A4)
                            	   268:     ; At this point, the Y register still has the cave index.
                            	   269:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   270:     ;
02:0002E16A 103C00FD        	   271:     move.b  #$FD,D0
                            	   272: _anon_z01_0:
02:0002E16E 023C00EE        	   273:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E172 123C0003        	   274:     move.b  #$03,D1
02:0002E176 D101            	   275:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E178 5303            	   276:     subq.b  #1,D3
02:0002E17A 6AF2            	   277:     bpl  _anon_z01_0
02:0002E17C 7600            	   278:     moveq   #0,D3
02:0002E17E 1600            	   279:     move.b  D0,D3
                            	   280:     ; Loop over the wares from 0 to 2.
                            	   281:     ;
02:0002E180 7400            	   282:     moveq   #0,D2
                            	   283:     even
                            	   284: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   285:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   286:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   287:     ;
02:0002E182 41F900FF6A7E    	   288:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E188 10303000        	   289:     move.b  (A0,D3.W),D0
02:0002E18C 41EC0422        	   290:     lea     ($0422,A4),A0
02:0002E190 11802000        	   291:     move.b  D0,(A0,D2.W)
                            	   292:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   293:     ;
02:0002E194 020000C0        	   294:     andi.b #$C0,D0
02:0002E198 19802000        	   295:     move.b  D0,($00,A4,D2.W)
                            	   296:     ; Copy 3 prices from the Cave level block info.
                            	   297:     ;
02:0002E19C 41F900FF6ABA    	   298:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E1A2 10303000        	   299:     move.b  (A0,D3.W),D0
02:0002E1A6 41EC0430        	   300:     lea     ($0430,A4),A0
02:0002E1AA 11802000        	   301:     move.b  D0,(A0,D2.W)
                            	   302:     ; Bottom of the wares copying loop.
                            	   303:     ;
02:0002E1AE 5203            	   304:     addq.b  #1,D3
02:0002E1B0 5202            	   305:     addq.b  #1,D2
02:0002E1B2 0C020003        	   306:     cmpi.b  #$03,D2
02:0002E1B6 66CA            	   307:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   308:     ; Get the top 2 bits of text selector byte in [03],
                            	   309:     ; shift them to the bottom, and combine them with [00].
                            	   310:     ;
02:0002E1B8 102C0003        	   311:     move.b  ($0003,A4),D0
02:0002E1BC E308            	   312:     lsl.b  #1,D0   ; ASL A
02:0002E1BE E310            	   313:     roxl.b  #1,D0   ; ROL A
02:0002E1C0 E310            	   314:     roxl.b  #1,D0   ; ROL A
02:0002E1C2 1214            	   315:     move.b  ($0000,A4),D1
02:0002E1C4 8001            	   316:     or.b  D1,D0
02:0002E1C6 1880            	   317:     move.b  D0,($0000,A4)
                            	   318:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   319:     ; and combine them with [00].
                            	   320:     ;
02:0002E1C8 102C0002        	   321:     move.b  ($0002,A4),D0
02:0002E1CC E208            	   322:     lsr.b  #1,D0   ; LSR A
02:0002E1CE E208            	   323:     lsr.b  #1,D0   ; LSR A
02:0002E1D0 E208            	   324:     lsr.b  #1,D0   ; LSR A
02:0002E1D2 E208            	   325:     lsr.b  #1,D0   ; LSR A
02:0002E1D4 1214            	   326:     move.b  ($0000,A4),D1
02:0002E1D6 8001            	   327:     or.b  D1,D0
02:0002E1D8 1880            	   328:     move.b  D0,($0000,A4)
                            	   329:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   330:     ; and combine them with [00] into CaveFlags.
                            	   331:     ;
02:0002E1DA 102C0001        	   332:     move.b  ($0001,A4),D0
02:0002E1DE E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E1E0 E208            	   334:     lsr.b  #1,D0   ; LSR A
02:0002E1E2 1214            	   335:     move.b  ($0000,A4),D1
02:0002E1E4 8001            	   336:     or.b  D1,D0
02:0002E1E6 19400413        	   337:     move.b  D0,($0413,A4)
                            	   338:     ; The end result is a byte with 8 cave flags.
                            	   339:     ;
                            	   340:     ; If cave flag "money game" is missing, then go finish up,
                            	   341:     ; instead of choosing random amounts for the money game.
                            	   342:     ;
02:0002E1EA 02000020        	   343:     andi.b #$20,D0
02:0002E1EE 6700009E        	   344:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   345:     ; Determine an index randomly with increasing probability,
                            	   346:     ; from 6 to 1. Start with the following test:
                            	   347:     ;
                            	   348:     ;   If $FF < Random, then go use index 6.
                            	   349:     ;
02:0002E1F2 103C00FF        	   350:     move.b  #$FF,D0
02:0002E1F6 7606            	   351:     moveq   #6,D3
                            	   352:     even
                            	   353: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E1F8 122C0019        	   354:     move.b  ($0019,A4),D1
02:0002E1FC B001            	   355:     cmp.b   D1,D0
02:0002E1FE 6516            	   356:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   357:     ; If the test fails, then subtract $2B from the reference number.
                            	   358:     ;
02:0002E200 003C0011        	   359:     ori     #$11,CCR  ; SEC: set C+X
02:0002E204 123C002B        	   360:     move.b  #$2B,D1
02:0002E208 0A3C0010        	   361:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E20C 9101            	   362:     subx.b  D1,D0   ; SBC #$2B
02:0002E20E 0A3C0010        	   363:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E212 5303            	   364:     subq.b  #1,D3
02:0002E214 66E2            	   365:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   366:     even
                            	   367: _L_z01_InitCaveContinue_FoundPermutation:
                            	   368:     ; The index chooses the last offset of a permutation of three indexes.
                            	   369:     ;
02:0002E216 7400            	   370:     moveq   #0,D2
