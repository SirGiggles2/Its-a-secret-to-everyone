02:0003DBC6 41EC0405        	  9492:     lea     ($0405,A4),A0
02:0003DBCA 10302000        	  9493:     move.b  (A0,D2.W),D0
02:0003DBCE 674E            	  9494:     beq  _L_z04_Manhandla_CheckCollisions_Exit
02:0003DBD0 4EB90004B6FE    	  9495:     jsr     ResetShoveInfo
                            	  9496:     ; Don't let the base die on its own.
                            	  9497:     ; If this is the base, then reset metastate, and return.
