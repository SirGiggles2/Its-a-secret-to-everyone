                            	  3928: __far_z_04_0033:
                            	  3929:     ; Animate.
                            	  3930:     ;
                            	  3931:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3932:     ; then only go draw.
                            	  3933:     ;
02:0003B2CE 41EC03D0        	  3934:     lea     ($03D0,A4),A0
02:0003B2D2 53302000        	  3935:     subq.b  #1,(A0,D2.W)
02:0003B2D6 6702            	  3936:     beq.s  __far_z_04_0034
02:0003B2D8 601E            	  3937:     jmp  DrawArmosAndCheckCollisions
                            	  3938: __far_z_04_0034:
                            	  3939:     ; Armos animation frames last 6 screen frames.
                            	  3940:     ;
02:0003B2DA 7006            	  3941:     moveq   #6,D0
02:0003B2DC 41EC03D0        	  3942:     lea     ($03D0,A4),A0
02:0003B2E0 11802000        	  3943:     move.b  D0,(A0,D2.W)
                            	  3944:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3945:     ; change the position of the shield. To keep fixed it in place,
                            	  3946:     ; there are separate frame images for each animation frame.
                            	  3947:     ;
                            	  3948:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3949:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3950:     ;
                            	  3951:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3952:     ; Then choose the direction at the point of drawing below.
                            	  3953:     ;
02:0003B2E4 41EC03E4        	  3954:     lea     ($03E4,A4),A0
02:0003B2E8 10302000        	  3955:     move.b  (A0,D2.W),D0
02:0003B2EC 0A000002        	  3956:     eori.b #$02,D0
02:0003B2F0 41EC03E4        	  3957:     lea     ($03E4,A4),A0
02:0003B2F4 11802000        	  3958:     move.b  D0,(A0,D2.W)
                            	  3959:     even
                            	  3960: DrawArmosAndCheckCollisions:
02:0003B2F8 4EB90004CD7A    	  3961:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B2FE 7600            	  3962:     moveq   #0,D3
02:0003B300 41EC0098        	  3963:     lea     ($0098,A4),A0
02:0003B304 16302000        	  3964:     move.b  (A0,D2.W),D3
                            	  3965:     ; If facing up, then use the second frame image in the set ("back").
                            	  3966:     ; Else use the second.
                            	  3967:     ;
02:0003B308 0C030008        	  3968:     cmpi.b  #$08,D3
02:0003B30C 6602            	  3969:     bne  _anon_z04_54
02:0003B30E 7001            	  3970:     moveq   #1,D0
                            	  3971: _anon_z04_54:
02:0003B310 023C00EE        	  3972:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B314 41EC03E4        	  3973:     lea     ($03E4,A4),A0
02:0003B318 12302000        	  3974:     move.b  (A0,D2.W),D1
02:0003B31C D101            	  3975:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B31E 4EB900031836    	  3976:     jsr     DrawObjectNotMirrored
