02:0004AC08 122C0004        	  2119:     move.b  ($0004,A4),D1
02:0004AC0C D101            	  2120:     addx.b  D1,D0   ; ADC $04
02:0004AC0E 4A02            	  2121:     cmpi.b  #$00,D2
02:0004AC10 66E4            	  2122:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AC12 0C000002        	  2123:     cmpi.b  #$02,D0
02:0004AC16 66DE            	  2124:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004AC18 7620            	  2125:     moveq   #32,D3
