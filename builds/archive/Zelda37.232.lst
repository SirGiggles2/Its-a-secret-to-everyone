                            	  3019: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  3020:     ; If the horizontal distance between Link and the trap >= $E,
                            	  3021:     ; then this trap definitely wasn't triggered.
                            	  3022:     ; Go draw and check collisions.
                            	  3023:     ;
02:000304CC 102C0070        	  3024:     move.b  ($0070,A4),D0
02:000304D0 003C0011        	  3025:     ori     #$11,CCR  ; SEC: set C+X
02:000304D4 12342070        	  3026:     move.b  ($70,A4,D2.W),D1
02:000304D8 0A3C0010        	  3027:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000304DC 9101            	  3028:     subx.b  D1,D0   ; SBC ObjX,X
02:000304DE 0A3C0010        	  3029:     eori    #$10,CCR  ; restore X = 6502 C
02:000304E2 61000802        	  3030:     jsr     Abs
02:000304E6 0C00000E        	  3031:     cmpi.b  #$0E,D0
02:000304EA 64DC            	  3032:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  3033:     ; Determine the vertical direction toward Link;
                            	  3034:     ; and if Link and the trap are at the same Y, then we can't move
                            	  3035:     ; along this axis. Go draw and check object collisions.
                            	  3036:     ;
02:000304EC 7604            	  3037:     moveq   #4,D3
02:000304EE 102C0084        	  3038:     move.b  ($0084,A4),D0
02:000304F2 41EC0084        	  3039:     lea     ($0084,A4),A0
02:000304F6 12302000        	  3040:     move.b  (A0,D2.W),D1
