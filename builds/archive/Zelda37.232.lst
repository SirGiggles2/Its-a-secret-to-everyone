02:0003EEB4 10302000        	 12059:     move.b  (A0,D2.W),D0
02:0003EEB8 122C0002        	 12060:     move.b  ($0002,A4),D1
02:0003EEBC E309            	 12061:     lsl.b  #1,D1   ; ASL $02
02:0003EEBE 19410002        	 12062:     move.b  D1,($0002,A4)
02:0003EEC2 122C0002        	 12063:     move.b  ($0002,A4),D1
