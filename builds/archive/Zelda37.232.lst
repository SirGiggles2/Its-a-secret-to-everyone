                            	  4546: PlaceWeaponForPlayerStateAndAnim:
                            	  4547:     ; Set player's animation counter to 1, so that it will roll over
                            	  4548:     ; as soon as possible, causing movement frame to become 0 (legs apart),
                            	  4549:     ; which is how we want to end item-use animations.
