02:000437F8 003C0011        	  5962:     ori     #$11,CCR  ; SEC: set C+X
02:000437FC 123C0001        	  5963:     move.b  #$01,D1
02:00043800 0A3C0010        	  5964:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043804 9101            	  5965:     subx.b  D1,D0   ; SBC #$01
02:00043806 0A3C0010        	  5966:     eori    #$10,CCR  ; restore X = 6502 C
02:0004380A 02000002        	  5967:     andi.b #$02,D0
02:0004380E 19400008        	  5968:     move.b  D0,($0008,A4)
                            	  5969:     ; The command to close a key door or bombable wall does not
                            	  5970:     ; do anything.
                            	  5971:     ;
02:00043812 102C0054        	  5972:     move.b  ($0054,A4),D0
02:00043816 0C000005        	  5973:     cmpi.b  #$05,D0
02:0004381A 6416            	  5974:     bcc  _anon_z05_120
02:0004381C 102C0055        	  5975:     move.b  ($0055,A4),D0
02:00043820 19400002        	  5976:     move.b  D0,($0002,A4)
02:00043824 6100FAEC        	  5977:     jsr     FindDoorAttrByDoorBit
02:00043828 0C000007        	  5978:     cmpi.b  #$07,D0
02:0004382C 6704            	  5979:     beq  _anon_z05_120
