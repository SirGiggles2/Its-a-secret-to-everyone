02:0003C06E 0C020006        	  5753:     cmpi.b  #$06,D2
02:0003C072 6502            	  5754:     bcs  _anon_z04_80
02:0003C074 7604            	  5755:     moveq   #4,D3
                            	  5756: _anon_z04_80:
02:0003C076 5203            	  5757:     addq.b  #1,D3
02:0003C078 41EC0350        	  5758:     lea     ($0350,A4),A0
02:0003C07C 10303000        	  5759:     move.b  (A0,D3.W),D0
02:0003C080 0C000041        	  5760:     cmpi.b  #$41,D0
02:0003C084 66F0            	  5761:     bne  _anon_z04_80
                            	  5762:     ; I don't know why the object timer of the tail segment that will
                            	  5763:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5764:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5765:     ; there, the object timer is set to 6.
                            	  5766:     ;
02:0003C086 7011            	  5767:     moveq   #17,D0
02:0003C088 19803029        	  5768:     move.b  D0,($29,A4,D3.W)
                            	  5769:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5770:     ; segment to the tail segment.
                            	  5771:     ;
02:0003C08C 41EC04F0        	  5772:     lea     ($04F0,A4),A0
02:0003C090 10302000        	  5773:     move.b  (A0,D2.W),D0
02:0003C094 41EC04F1        	  5774:     lea     ($04F1,A4),A0
02:0003C098 11803000        	  5775:     move.b  D0,(A0,D3.W)
02:0003C09C 10342070        	  5776:     move.b  ($70,A4,D2.W),D0
02:0003C0A0 19803071        	  5777:     move.b  D0,($71,A4,D3.W)
02:0003C0A4 41EC0084        	  5778:     lea     ($0084,A4),A0
02:0003C0A8 10302000        	  5779:     move.b  (A0,D2.W),D0
02:0003C0AC 41EC0085        	  5780:     lea     ($0085,A4),A0
02:0003C0B0 11803000        	  5781:     move.b  D0,(A0,D3.W)
