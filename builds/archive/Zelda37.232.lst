                            	  7339: DodongoBombPositiveLimits:
02:0003CBBE 0C              	  7340:     dc.b    $0C, $11
02:0003CBBF 11
                            	  7341: 
                            	  7342:     even
                            	  7343: DodongoBombNegativeLimits:
02:0003CBC0 F4              	  7344:     dc.b    $F4, $F0
02:0003CBC1 F0
                            	  7345: 
                            	  7346: ; Params:
                            	  7347: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7348: ; [00]: monster hotspot X
                            	  7349: ; [01]: monster hotspot Y
                            	  7350: ; [02]: bomb hotspot X
                            	  7351: ; [03]: bomb hotspot Y
                            	  7352: ;
                            	  7353: ; Returns:
                            	  7354: ; A: 0 if the bomb is in range of the monster
                            	  7355: ; Z: 1 if the bomb is in range of the monster
                            	  7356: ; [04]: horizontal distance
                            	  7357: ; [05]: vertical distance
                            	  7358: ;
                            	  7359: ; Store the positive limit in [06], and the negative one in [07].
                            	  7360: ;
                            	  7361:     even
                            	  7362: Dodongo_IsBombInRange:
02:0003CBC2 41F90003CBBE    	  7363:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CBC8 10303000        	  7364:     move.b  (A0,D3.W),D0
02:0003CBCC 19400006        	  7365:     move.b  D0,($0006,A4)
02:0003CBD0 41F90003CBC0    	  7366:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CBD6 10303000        	  7367:     move.b  (A0,D3.W),D0
02:0003CBDA 19400007        	  7368:     move.b  D0,($0007,A4)
                            	  7369:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7370:     ; the bomb is near enough the monster.
                            	  7371:     ;
02:0003CBDE 7003            	  7372:     moveq   #3,D0
02:0003CBE0 19400008        	  7373:     move.b  D0,($0008,A4)
                            	  7374:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7375:     ;
02:0003CBE4 7601            	  7376:     moveq   #1,D3
                            	  7377:     even
                            	  7378: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7379:     ; Subtract the bomb's coordinate from the boss's,
                            	  7380:     ; The loop index determines the coordinate.
                            	  7381:     ;
02:0003CBE6 10343000        	  7382:     move.b  ($00,A4,D3.W),D0
02:0003CBEA 003C0011        	  7383:     ori     #$11,CCR  ; SEC: set C+X
02:0003CBEE 12343002        	  7384:     move.b  ($02,A4,D3.W),D1
02:0003CBF2 0A3C0010        	  7385:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CBF6 9101            	  7386:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CBF8 0A3C0010        	  7387:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7388:     ; If the distance >= positive offset, or < negative offset;
                            	  7389:     ; then loop again.
                            	  7390:     ;
02:0003CBFC 122C0006        	  7391:     move.b  ($0006,A4),D1
02:0003CC00 B001            	  7392:     cmp.b   D1,D0
02:0003CC02 6A16            	  7393:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CC04 122C0007        	  7394:     move.b  ($0007,A4),D1
02:0003CC08 B001            	  7395:     cmp.b   D1,D0
02:0003CC0A 6B0E            	  7396:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7397:     ; The distance is close enough in this axis.
                            	  7398:     ;
                            	  7399:     ; Store the distance in this axis in [05] or [04],
                            	  7400:     ; depending on the loop index.
                            	  7401:     ;
02:0003CC0C 19803004        	  7402:     move.b  D0,($04,A4,D3.W)
                            	  7403:     ; Shift [08] right, because we're in range in this axis.
                            	  7404:     ;
02:0003CC10 122C0008        	  7405:     move.b  ($0008,A4),D1
02:0003CC14 E209            	  7406:     lsr.b  #1,D1   ; LSR $08
02:0003CC16 19410008        	  7407:     move.b  D1,($0008,A4)
                            	  7408:     even
                            	  7409: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CC1A 5303            	  7410:     subq.b  #1,D3
02:0003CC1C 6AC8            	  7411:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7412:     ; If close enough in both axes, then [08] will be 0.
                            	  7413:     ;
02:0003CC1E 102C0008        	  7414:     move.b  ($0008,A4),D0
02:0003CC22 4E75            	  7415:     rts
                            	  7416: 
                            	  7417: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7418: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7419: ;
                            	  7420: ; But these are not typical direction indexes. Instead a
                            	  7421: ; 5-way index is used.
                            	  7422: ; A direction shifted right once becomes a 5-way index.
                            	  7423: ; The fourth element is unused.
                            	  7424: ;
                            	  7425:     even
                            	  7426: DodongoFrameImages:
02:0003CC24 00              	  7427:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CC25 01
02:0003CC26 06
02:0003CC27 FF
02:0003CC28 08
02:0003CC29 02
02:0003CC2A 03
02:0003CC2B 06
02:0003CC2C FF              	  7428:     dc.b    $FF, $08
02:0003CC2D 08
                            	  7429: 
                            	  7430:     even
                            	  7431: DodongoFrameHFlips:
02:0003CC2E 00              	  7432:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003CC2F 40
02:0003CC30 00
02:0003CC31 FF
02:0003CC32 00
02:0003CC33 00
02:0003CC34 40
02:0003CC35 40
02:0003CC36 FF              	  7433:     dc.b    $FF, $40
02:0003CC37 40
                            	  7434: 
                            	  7435:     even
                            	  7436: DodongoFrameImagesBloated:
02:0003CC38 04              	  7437:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003CC39 05
02:0003CC3A 07
02:0003CC3B FF
02:0003CC3C 09
02:0003CC3D 04
02:0003CC3E 05
02:0003CC3F 07
02:0003CC40 FF              	  7438:     dc.b    $FF, $09
02:0003CC41 09
                            	  7439: 
                            	  7440:     even
                            	  7441: DodongoFrameHFlipsBloated:
02:0003CC42 00              	  7442:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003CC43 40
02:0003CC44 00
02:0003CC45 FF
02:0003CC46 00
02:0003CC47 00
02:0003CC48 40
02:0003CC49 00
02:0003CC4A FF              	  7443:     dc.b    $FF, $00
02:0003CC4B 00
