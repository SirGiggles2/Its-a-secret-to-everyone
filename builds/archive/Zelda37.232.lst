                            	  5702:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5703:     ;
02:0004C4DC 7000            	  5704:     moveq   #0,D0
02:0004C4DE 41EC0380        	  5705:     lea     ($0380,A4),A0
