                            	  3572: _L_z04_UpdateOctorock_CheckHorizontal:
                            	  3573:     ; If facing right, then set horizontal flipping, and use frame image offset 0.
                            	  3574:     ;
02:0003B0A6 0C030001        	  3575:     cmpi.b  #$01,D3
02:0003B0AA 6604            	  3576:     bne  _anon_z04_49
02:0003B0AC 522C000F        	  3577:     addq.b  #1,($000F,A4)
                            	  3578: _anon_z04_49:
                            	  3579:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
                            	  3580:     ;
02:0003B0B0 7000            	  3581:     moveq   #0,D0
                            	  3582:     even
                            	  3583: _L_z04_UpdateOctorock_SaveOffset:
02:0003B0B2 1B00            	  3584:     move.b  D0,-(A5)  ; PHA
                            	  3585:     ; Decrement the animation counter, and roll over if needed.
                            	  3586:     ;
02:0003B0B4 41EC03D0        	  3587:     lea     ($03D0,A4),A0
02:0003B0B8 53302000        	  3588:     subq.b  #1,(A0,D2.W)
02:0003B0BC 661E            	  3589:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:0003B0BE 7006            	  3590:     moveq   #6,D0
02:0003B0C0 41EC03D0        	  3591:     lea     ($03D0,A4),A0
02:0003B0C4 11802000        	  3592:     move.b  D0,(A0,D2.W)
                            	  3593:     ; There are actually 6 frame images divided into 2 sets.
                            	  3594:     ; Each set depicts one animation frame. In each set there are
                            	  3595:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3596:     ;
                            	  3597:     ; The movement frame will keep track of the base offset of
                            	  3598:     ; the current set for the current animation frame: 0 or 3.
                            	  3599:     ;
                            	  3600:     ; So, XOR the movement frame with 3.
                            	  3601:     ;
02:0003B0C8 E208            	  3602:     lsr.b  #1,D0   ; LSR A
02:0003B0CA 41EC03E4        	  3603:     lea     ($03E4,A4),A0
02:0003B0CE 12302000        	  3604:     move.b  (A0,D2.W),D1
02:0003B0D2 B300            	  3605:     eor.b  D1,D0
02:0003B0D4 41EC03E4        	  3606:     lea     ($03E4,A4),A0
02:0003B0D8 11802000        	  3607:     move.b  D0,(A0,D2.W)
                            	  3608:     even
                            	  3609: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3610:     ; Add the base offset and the directional offset, and save the result.
                            	  3611:     ;
02:0003B0DC 101D            	  3612:     move.b  (A5)+,D0  ; PLA
02:0003B0DE 023C00EE        	  3613:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0E2 41EC03E4        	  3614:     lea     ($03E4,A4),A0
02:0003B0E6 12302000        	  3615:     move.b  (A0,D2.W),D1
02:0003B0EA D101            	  3616:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B0EC 1B00            	  3617:     move.b  D0,-(A5)  ; PHA
                            	  3618:     ; If facing vertically, go draw mirrored.
                            	  3619:     ;
02:0003B0EE 41EC0098        	  3620:     lea     ($0098,A4),A0
02:0003B0F2 10302000        	  3621:     move.b  (A0,D2.W),D0
02:0003B0F6 0200000C        	  3622:     andi.b #$0C,D0
02:0003B0FA 660E            	  3623:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3624:     ; Else draw not mirrored.
                            	  3625:     ;
02:0003B0FC 101D            	  3626:     move.b  (A5)+,D0  ; PLA
02:0003B0FE 4EB900031836    	  3627:     jsr     DrawObjectNotMirrored
02:0003B104 4EF900031BB2    	  3628:     jmp     CheckMonsterCollisions
                            	  3629: 
                            	  3630:     even
                            	  3631: _L_z04_UpdateOctorock_DrawMirrored:
02:0003B10A 101D            	  3632:     move.b  (A5)+,D0  ; PLA
                            	  3633: ; Params:
                            	  3634: ; A: frame image
                            	  3635: ; X: object index
                            	  3636: ; [00]: object X
                            	  3637: ; [01]: object Y
                            	  3638: ;
                            	  3639:     even
                            	  3640: DrawObjectMirroredAndCheckCollisions:
02:0003B10C 4EB900031832    	  3641:     jsr     DrawObjectMirrored
02:0003B112 4EF900031BB2    	  3642:     jmp     CheckMonsterCollisions
                            	  3643: 
                            	  3644:     even
                            	  3645: UpdateGhini:
02:0003B118 103C00FF        	  3646:     move.b  #$FF,D0
02:0003B11C 6100E81E        	  3647:     jsr     UpdateCommonWanderer
02:0003B120 6130            	  3648:     jsr     DrawGhiniAndCheckCollisions
02:0003B122 4EB900031BB2    	  3649:     jsr     CheckMonsterCollisions
                            	  3650:     ; If the monster is still alive, then return.
                            	  3651:     ;
02:0003B128 41EC0405        	  3652:     lea     ($0405,A4),A0
02:0003B12C 10302000        	  3653:     move.b  (A0,D2.W),D0
02:0003B130 671E            	  3654:     beq  _L_z04_UpdateGhini_Exit
                            	  3655:     ; For each object slot from $B to 1:
                            	  3656:     ; If the object is a flying ghini ($22),
                            	  3657:     ; then kill it by setting metastate to $11.
                            	  3658:     ;
02:0003B132 760B            	  3659:     moveq   #11,D3
                            	  3660:     even
                            	  3661: _L_z04_UpdateGhini_LoopObject:
02:0003B134 41EC034F        	  3662:     lea     ($034F,A4),A0
02:0003B138 10303000        	  3663:     move.b  (A0,D3.W),D0
02:0003B13C 0C000022        	  3664:     cmpi.b  #$22,D0
02:0003B140 660A            	  3665:     bne  _anon_z04_50
02:0003B142 7011            	  3666:     moveq   #17,D0
02:0003B144 41EC0405        	  3667:     lea     ($0405,A4),A0
02:0003B148 11803000        	  3668:     move.b  D0,(A0,D3.W)
                            	  3669: _anon_z04_50:
02:0003B14C 5303            	  3670:     subq.b  #1,D3
02:0003B14E 66E4            	  3671:     bne  _L_z04_UpdateGhini_LoopObject
                            	  3672:     even
                            	  3673: _L_z04_UpdateGhini_Exit:
02:0003B150 4E75            	  3674:     rts
                            	  3675: 
                            	  3676:     even
                            	  3677: DrawGhiniAndCheckCollisions:
02:0003B152 4EB90004CD7A    	  3678:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B158 1940000D        	  3679:     move.b  D0,($000D,A4)
                            	  3680:     ; If the direction has an "up" component, then keep the
                            	  3681:     ; frame image 0, and go figure out horizontal flipping.
                            	  3682:     ;
02:0003B15C 41EC0098        	  3683:     lea     ($0098,A4),A0
02:0003B160 10302000        	  3684:     move.b  (A0,D2.W),D0
02:0003B164 02000008        	  3685:     andi.b #$08,D0
02:0003B168 6614            	  3686:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3687:     ; Else make the frame image 1 for the "down" frame.
                            	  3688:     ; Note that this is the frame image to use, even if there's no
                            	  3689:     ; down component in the direction.
                            	  3690:     ;
02:0003B16A 522C000D        	  3691:     addq.b  #1,($000D,A4)
                            	  3692:     ; If right is a component of the direction, then go set horizontal
                            	  3693:     ; flipping. Else leave horizontal flipping = 0.
                            	  3694:     ;
02:0003B16E 41EC0098        	  3695:     lea     ($0098,A4),A0
02:0003B172 10302000        	  3696:     move.b  (A0,D2.W),D0
02:0003B176 02000001        	  3697:     andi.b #$01,D0
02:0003B17A 6714            	  3698:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003B17C 660E            	  3699:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3700:     even
                            	  3701: _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip:
                            	  3702:     ; Set horizontal flipping if right is a direction component.
                            	  3703:     ; This essentially the same test as above, but for when we jump
                            	  3704:     ; from the "up" test.
                            	  3705:     ;
02:0003B17E 41EC0098        	  3706:     lea     ($0098,A4),A0
02:0003B182 10302000        	  3707:     move.b  (A0,D2.W),D0
02:0003B186 02000002        	  3708:     andi.b #$02,D0
02:0003B18A 6704            	  3709:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3710:     even
                            	  3711: _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip:
02:0003B18C 522C000F        	  3712:     addq.b  #1,($000F,A4)
                            	  3713:     even
                            	  3714: _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions:
02:0003B190 102C000D        	  3715:     move.b  ($000D,A4),D0
                            	  3716: ; Params:
                            	  3717: ; A: frame image
                            	  3718: ; X: object index
                            	  3719: ; [00]: object X
                            	  3720: ; [01]: object Y
                            	  3721: ; [0F]: flip horizontally
                            	  3722: ;
                            	  3723: ; Returns:
                            	  3724: ; [00]: 0 for Link slot
                            	  3725: ; [06]: 1 if objects collide
                            	  3726: ; [09]: 0 for Link damage type (none)
                            	  3727: ; [0C]: 1 if objects collide
                            	  3728: ; [034B]: ShotCollidesWithLink
                            	  3729: ;
                            	  3730:     even
                            	  3731: DrawObjectNotMirroredAndCheckLinkCollision:
02:0003B194 4EB900031836    	  3732:     jsr     DrawObjectNotMirrored
02:0003B19A 4EF900031CFC    	  3733:     jmp     CheckLinkCollision
                            	  3734: 
                            	  3735:     even
                            	  3736: SecretArmosRoomIds:
02:0003B1A0 24              	  3737:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:0003B1A1 0B
02:0003B1A2 1C
02:0003B1A3 22
02:0003B1A4 34
02:0003B1A5 3D
02:0003B1A6 4E
                            	  3738: 
                            	  3739:     even
                            	  3740: SecretArmosXs:
02:0003B1A8 E0              	  3741:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003B1A9 B0
02:0003B1AA B0
02:0003B1AB 30
02:0003B1AC 40
02:0003B1AD 90
02:0003B1AE A0
                            	  3742: 
                            	  3743:     even
                            	  3744: InitArmosOrFlyingGhini:
                            	  3745:     ; In UpdateObject, this object was flagged "initialized".
                            	  3746:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  3747:     ;
02:0003B1B0 10342028        	  3748:     move.b  ($28,A4,D2.W),D0
02:0003B1B4 41EC0492        	  3749:     lea     ($0492,A4),A0
02:0003B1B8 11802000        	  3750:     move.b  D0,(A0,D2.W)
                            	  3751:     ; If it's still fading in, then go finish some initialization needed
                            	  3752:     ; for fading in.
                            	  3753:     ;
02:0003B1BC 660000B6        	  3754:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3755:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3756:     ; go finish initializing it.
                            	  3757:     ;
02:0003B1C0 41EC034F        	  3758:     lea     ($034F,A4),A0
02:0003B1C4 10302000        	  3759:     move.b  (A0,D2.W),D0
02:0003B1C8 0C000022        	  3760:     cmpi.b  #$22,D0
02:0003B1CC 670000A6        	  3761:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3762:     ; Else we have an armos.
                            	  3763:     ;
                            	  3764:     ; Store stairs tile $70 in [00] for use later.
                            	  3765:     ;
02:0003B1D0 7070            	  3766:     moveq   #112,D0
02:0003B1D2 1880            	  3767:     move.b  D0,($0000,A4)
                            	  3768:     ; Look for the current room ID in an array of room ID's that
                            	  3769:     ; have armos secrets.
                            	  3770:     ;
02:0003B1D4 7606            	  3771:     moveq   #6,D3
                            	  3772:     even
                            	  3773: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B1D6 102C00EB        	  3774:     move.b  ($00EB,A4),D0
                            	  3775:     ; If this element does not match the current room ID, go loop again.
                            	  3776:     ;
02:0003B1DA 41F90003B1A0    	  3777:     lea     (SecretArmosRoomIds).l,A0
02:0003B1E0 12303000        	  3778:     move.b  (A0,D3.W),D1
02:0003B1E4 B001            	  3779:     cmp.b   D1,D0
02:0003B1E6 6648            	  3780:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3781:     ; The secret (usually stairs) is under one of the armoses.
                            	  3782:     ;
                            	  3783:     ; If the armos's X coordinate does not match the one needed
                            	  3784:     ; for the current room in the list, then go loop again.
                            	  3785:     ;
02:0003B1E8 10342070        	  3786:     move.b  ($70,A4,D2.W),D0
02:0003B1EC 41F90003B1A8    	  3787:     lea     (SecretArmosXs).l,A0
02:0003B1F2 12303000        	  3788:     move.b  (A0,D3.W),D1
02:0003B1F6 B001            	  3789:     cmp.b   D1,D0
02:0003B1F8 6636            	  3790:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3791:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3792:     ;
02:0003B1FA 41EC0084        	  3793:     lea     ($0084,A4),A0
02:0003B1FE 10302000        	  3794:     move.b  (A0,D2.W),D0
02:0003B202 0C000080        	  3795:     cmpi.b  #$80,D0
02:0003B206 6628            	  3796:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3797:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3798:     ;
02:0003B208 4A03            	  3799:     cmpi.b  #$00,D3
02:0003B20A 662C            	  3800:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3801:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3802:     ; has the power bracelet.
                            	  3803:     ;
                            	  3804:     ; Set up the room item with the armos's coordinates.
                            	  3805:     ;
02:0003B20C 19400097        	  3806:     move.b  D0,($0097,A4)
02:0003B210 10342070        	  3807:     move.b  ($70,A4,D2.W),D0
02:0003B214 19400083        	  3808:     move.b  D0,($0083,A4)
                            	  3809:     ; This resets the room item's state, which activates it.
                            	  3810:     ;
02:0003B218 194300BF        	  3811:     move.b  D3,($00BF,A4)
                            	  3812:     ; Set the room item ID.
                            	  3813:     ;
02:0003B21C 7014            	  3814:     moveq   #20,D0
02:0003B21E 194000AB        	  3815:     move.b  D0,($00AB,A4)
                            	  3816:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3817:     ;
                            	  3818:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3819:     ;
                            	  3820:     ; Note that, if the item was already taken, then the room item
                            	  3821:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3822:     ; it will be ignored, because that routine checks whether
                            	  3823:     ; the item was taken.
                            	  3824:     ;
02:0003B222 4EB9000311DE    	  3825:     jsr     GetRoomFlagUWItemState
02:0003B228 660A            	  3826:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B22A 610006B2        	  3827:     jsr     PlaySecretFoundTune
02:0003B22E 6604            	  3828:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3829:     even
                            	  3830: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3831:     ; Bottom of the loop.
                            	  3832:     ;
02:0003B230 5303            	  3833:     subq.b  #1,D3
02:0003B232 6AA2            	  3834:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3835:     even
                            	  3836: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3837:     ; Not found, or found the power bracelet.
                            	  3838:     ; Use a floor tile $26 to replace the armos.
                            	  3839:     ;
02:0003B234 7026            	  3840:     moveq   #38,D0
02:0003B236 1880            	  3841:     move.b  D0,($0000,A4)
                            	  3842:     even
                            	  3843: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003B238 1014            	  3844:     move.b  ($0000,A4),D0
                            	  3845:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3846:     ;
02:0003B23A 1B00            	  3847:     move.b  D0,-(A5)  ; PHA
02:0003B23C 0C000070        	  3848:     cmpi.b  #$70,D0
02:0003B240 6604            	  3849:     bne  _anon_z04_51
02:0003B242 6100069A        	  3850:     jsr     PlaySecretFoundTune
                            	  3851: _anon_z04_51:
                            	  3852:     ; Replace the tile where the armos was.
                            	  3853:     ;
02:0003B246 522C00F7        	  3854:     addq.b  #1,($00F7,A4)
02:0003B24A 101D            	  3855:     move.b  (A5)+,D0  ; PLA
02:0003B24C 4EB90004AD92    	  3856:     jsr     ChangeTileObjTiles
                            	  3857:     ; Because the armos object is aligned to the square grid
                            	  3858:     ; (because it was made from a square),
                            	  3859:     ; set its grid offset to 3 to compensate.
                            	  3860:     ;
                            	  3861:     ; Most objects are aligned to the grid vertically when the
                            	  3862:     ; low nibble is $D.
                            	  3863:     ;
02:0003B252 7003            	  3864:     moveq   #3,D0
02:0003B254 41EC0394        	  3865:     lea     ($0394,A4),A0
02:0003B258 11802000        	  3866:     move.b  D0,(A0,D2.W)
                            	  3867:     ; Set a speed (q-speed fraction) randomly:
                            	  3868:     ; $20 if random value < $80
                            	  3869:     ; $60 otherwise
                            	  3870:     ;
02:0003B25C 7020            	  3871:     moveq   #32,D0
02:0003B25E 7600            	  3872:     moveq   #0,D3
02:0003B260 16342019        	  3873:     move.b  ($19,A4,D2.W),D3
02:0003B264 0C030080        	  3874:     cmpi.b  #$80,D3
02:0003B268 6502            	  3875:     bcs  _anon_z04_52
02:0003B26A 7060            	  3876:     moveq   #96,D0
                            	  3877: _anon_z04_52:
02:0003B26C 41EC03BC        	  3878:     lea     ($03BC,A4),A0
02:0003B270 11802000        	  3879:     move.b  D0,(A0,D2.W)
                            	  3880:     even
                            	  3881: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3882:     ; Facing and input directions down.
                            	  3883:     ;
02:0003B274 7004            	  3884:     moveq   #4,D0
02:0003B276 41EC03F8        	  3885:     lea     ($03F8,A4),A0
02:0003B27A 11802000        	  3886:     move.b  D0,(A0,D2.W)
02:0003B27E 41EC0098        	  3887:     lea     ($0098,A4),A0
02:0003B282 11802000        	  3888:     move.b  D0,(A0,D2.W)
                            	  3889:     ; Every other frame, return without drawing.
                            	  3890:     ;
02:0003B286 10342028        	  3891:     move.b  ($28,A4,D2.W),D0
02:0003B28A E208            	  3892:     lsr.b  #1,D0   ; LSR A
02:0003B28C 6512            	  3893:     bcs  _anon_z04_53
                            	  3894:     ; Finish initializing based on type.
                            	  3895:     ;
02:0003B28E 41EC034F        	  3896:     lea     ($034F,A4),A0
02:0003B292 10302000        	  3897:     move.b  (A0,D2.W),D0
02:0003B296 0C000022        	  3898:     cmpi.b  #$22,D0
02:0003B29A 6602            	  3899:     bne.s  __far_z_04_0032
02:0003B29C 6008            	  3900:     jmp  L_EndInitFlyingGhini
                            	  3901: __far_z_04_0032:
02:0003B29E 6158            	  3902:     jsr     DrawArmosAndCheckCollisions
                            	  3903: _anon_z04_53:
02:0003B2A0 0A3C0001        	  3904:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B2A4 4E75            	  3905:     rts
                            	  3906: 
                            	  3907:     even
                            	  3908: L_EndInitFlyingGhini:
02:0003B2A6 6100FEAA        	  3909:     jsr     DrawGhiniAndCheckCollisions
                            	  3910:     ; If we're finally leaving the object flagged "initialized",
                            	  3911:     ; then reset metastate and initialize this as a flyer.
                            	  3912:     ;
02:0003B2AA 41EC0492        	  3913:     lea     ($0492,A4),A0
02:0003B2AE 10302000        	  3914:     move.b  (A0,D2.W),D0
