02:0003DD84 0200000F        	  9736:     andi.b #$0F,D0
02:0003DD88 0C000002        	  9737:     cmpi.b  #$02,D0
02:0003DD8C 670C            	  9738:     beq  _anon_z04_117
02:0003DD8E 0C000003        	  9739:     cmpi.b  #$03,D0
02:0003DD92 6706            	  9740:     beq  _anon_z04_117
02:0003DD94 4EF900031832    	  9741:     jmp     DrawObjectMirrored
                            	  9742: 
