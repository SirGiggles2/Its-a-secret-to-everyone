                            	  4868: UpdatePeaceTextbox:
                            	  4869:     ; Only emit a character once every 8 frames --
                            	  4870:     ; when (counter [0412] MOD 8) = 4.
                            	  4871:     ;
02:000365E0 522C0412        	  4872:     addq.b  #1,($0412,A4)
02:000365E4 102C0412        	  4873:     move.b  ($0412,A4),D0
02:000365E8 02000007        	  4874:     andi.b #$07,D0
02:000365EC 0C000004        	  4875:     cmpi.b  #$04,D0
02:000365F0 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4877:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4878:     ; to the dynamic transfer buf.
                            	  4879:     ;
02:000365F2 7604            	  4880:     moveq   #4,D3
                            	  4881: _anon_z02_35:
02:000365F4 41F900036570    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:000365FA 10303000        	  4883:     move.b  (A0,D3.W),D0
02:000365FE 41EC0302        	  4884:     lea     ($0302,A4),A0
02:00036602 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:00036606 5303            	  4886:     subq.b  #1,D3
02:00036608 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:0003660A 7600            	  4891:     moveq   #0,D3
02:0003660C 162C0413        	  4892:     move.b  ($0413,A4),D3
02:00036610 41F9000365AA    	  4893:     lea     (PeaceText).l,A0
02:00036616 10303000        	  4894:     move.b  (A0,D3.W),D0
02:0003661A 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:0003661E 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00036620 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:00036624 0C000024        	  4901:     cmpi.b  #$24,D0
02:00036628 6706            	  4902:     beq  _anon_z02_36
02:0003662A 7010            	  4903:     moveq   #16,D0
02:0003662C 19400604        	  4904:     move.b  D0,($0604,A4)
                            	  4905: _anon_z02_36:
