02:0003BC90 12302000        	  5292:     move.b  (A0,D2.W),D1
02:0003BC94 D101            	  5293:     addx.b  D1,D0   ; ADC SpriteRelativeExtents,X
02:0003BC96 0C0000E9        	  5294:     cmpi.b  #$E9,D0
02:0003BC9A 6406            	  5295:     bcc  _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_AddPriorityBit
