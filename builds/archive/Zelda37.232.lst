02:0003DB94 1B00            	  9472:     move.b  D0,-(A5)  ; PHA
02:0003DB96 10342028        	  9473:     move.b  ($28,A4,D2.W),D0
02:0003DB9A 1B00            	  9474:     move.b  D0,-(A5)  ; PHA
02:0003DB9C 4EB900031BB2    	  9475:     jsr     CheckMonsterCollisions
02:0003DBA2 101D            	  9476:     move.b  (A5)+,D0  ; PLA
