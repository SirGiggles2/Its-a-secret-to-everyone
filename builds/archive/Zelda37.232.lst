                            	   670: _anon_z05_9:
02:00040342 102C00E2        	   671:     move.b  ($00E2,A4),D0
02:00040346 003C0011        	   672:     ori     #$11,CCR  ; SEC: set C+X
02:0004034A 123C0020        	   673:     move.b  #$20,D1
02:0004034E 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040352 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:00040354 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:00040358 194000E2        	   677:     move.b  D0,($00E2,A4)
02:0004035C 6404            	   678:     bcc  _anon_z05_10
02:0004035E 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
02:00040362 0C0000E0        	   681:     cmpi.b  #$E0,D0
02:00040366 661E            	   682:     bne  _L_z05_ScrollWorld_Exit
02:00040368 102C0058        	   683:     move.b  ($0058,A4),D0
02:0004036C 0C000020        	   684:     cmpi.b  #$20,D0
02:00040370 6716            	   685:     beq  _L_z05_ScrollWorld_LimitLow
