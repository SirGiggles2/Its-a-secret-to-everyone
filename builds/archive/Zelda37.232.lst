                            	  4001: UpdatePondFairy:
02:0003B34C 610046A6        	  4002:     jsr     DrawFairy
                            	  4003:     ; If not in state 0, then go handle states 1 to 3.
                            	  4004:     ;
02:0003B350 102C00AD        	  4005:     move.b  ($00AD,A4),D0
02:0003B354 6702            	  4006:     beq.s  __far_z_04_0035
