                            	  4266:     ;
                            	  4267:     ;
                            	  4268:     ; [0E] holds reverse index of doorway direction found.
                            	  4269:     ;
02:00042184 1943000E        	  4270:     move.b  D3,($000E,A4)
                            	  4271:     ; Store input direction in [02] and [0C].
