02:00031EAE 122C000E        	  6609:     move.b  ($000E,A4),D1
02:00031EB2 0A3C0010        	  6610:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031EB6 9101            	  6611:     subx.b  D1,D0   ; SBC $0E
02:00031EB8 0A3C0010        	  6612:     eori    #$10,CCR  ; restore X = 6502 C
02:00031EBC 19400670        	  6613:     move.b  D0,($0670,A4)
                            	  6614:     ; If full hearts >= high damage points byte, then simply
                            	  6615:     ; subtract the damage byte from full hearts.
                            	  6616:     ; Else go handle Link dying.
