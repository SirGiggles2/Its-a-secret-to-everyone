                            	 12582: Ganon_MoveAndShoot:
                            	 12583:     ; Change the animation frame every screen frame; so that
                            	 12584:     ; when Ganon is hit, he appears in a random pose.
                            	 12585:     ;
02:0003F248 41EC046B        	 12586:     lea     ($046B,A4),A0
