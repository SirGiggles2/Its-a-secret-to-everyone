                            	  8132: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  8133:     ; In this state, we have to draw Like-like over Link.
                            	  8134:     ; So, don't use the usual sprite writing code that cycles sprites.
                            	  8135:     ;
02:0003D1B0 4EB90004CD7A    	  8136:     jsr     Anim_FetchObjPosForSpriteDescriptor
