                            	  8292: ; Description:
                            	  8293: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8294: ; When walking, the object timer is set. When teleporting,
                            	  8295: ; the teleporting distance remaining is set.
                            	  8296: ;
                            	  8297: ; If we have the magic clock, then only go draw and check collisions.
                            	  8298: ;
                            	  8299:     even
                            	  8300: UpdateBlueWizzrobe:
02:0003D2F6 102C066C        	  8301:     move.b  ($066C,A4),D0
