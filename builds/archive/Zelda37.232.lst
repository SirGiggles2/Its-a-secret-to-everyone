                            	  5198: Wallmaster_PrepareToDraw:
02:0003BBE2 4EF90002BEFA    	  5199:     jmp     c_wallmaster_prepare_to_draw
                            	  5200: 
                            	  5201: Wallmaster_CalcStartPosition:
02:0003BBE8 41EC0412        	  5202:     lea     ($0412,A4),A0
02:0003BBEC 11802000        	  5203:     move.b  D0,(A0,D2.W)
02:0003BBF0 19430003        	  5204:     move.b  D3,($0003,A4)
                            	  5205:     ; If Link is still (input dir = 0), then use distance $24, else $32.
                            	  5206:     ;
02:0003BBF4 7024            	  5207:     moveq   #36,D0
02:0003BBF6 7600            	  5208:     moveq   #0,D3
02:0003BBF8 162C03F8        	  5209:     move.b  ($03F8,A4),D3
02:0003BBFC 6702            	  5210:     beq  _anon_z04_70
02:0003BBFE 7032            	  5211:     moveq   #50,D0
                            	  5212: _anon_z04_70:
                            	  5213:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  5214:     ; 1. negate the distance
                            	  5215:     ; 2. add 8 to the instruction offset to access
                            	  5216:     ;    the opposite direction for the same wall
                            	  5217:     ;
02:0003BC00 7600            	  5218:     moveq   #0,D3
02:0003BC02 162C0098        	  5219:     move.b  ($0098,A4),D3
02:0003BC06 122C0002        	  5220:     move.b  ($0002,A4),D1
02:0003BC0A B601            	  5221:     cmp.b   D1,D3
02:0003BC0C 662A            	  5222:     bne  _anon_z04_71
02:0003BC0E 1B00            	  5223:     move.b  D0,-(A5)  ; PHA
02:0003BC10 41EC0412        	  5224:     lea     ($0412,A4),A0
02:0003BC14 10302000        	  5225:     move.b  (A0,D2.W),D0
02:0003BC18 023C00EE        	  5226:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC1C 123C0008        	  5227:     move.b  #$08,D1
02:0003BC20 D101            	  5228:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BC22 41EC0412        	  5229:     lea     ($0412,A4),A0
02:0003BC26 11802000        	  5230:     move.b  D0,(A0,D2.W)
02:0003BC2A 101D            	  5231:     move.b  (A5)+,D0  ; PLA
02:0003BC2C 4600            	  5232:     eori.b #$FF,D0
02:0003BC2E 023C00EE        	  5233:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC32 123C0001        	  5234:     move.b  #$01,D1
02:0003BC36 D101            	  5235:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  5236: _anon_z04_71:
                            	  5237:     ; Add the distance and Link's minor coordinate to calculate
                            	  5238:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5239:     ; In general, the monster will be put in front of Link.
                            	  5240:     ;
02:0003BC38 023C00EE        	  5241:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC3C 1214            	  5242:     move.b  ($0000,A4),D1
02:0003BC3E D101            	  5243:     addx.b  D1,D0   ; ADC $00
02:0003BC40 19400004        	  5244:     move.b  D0,($0004,A4)
                            	  5245:     ; By default, will return index 0 to choose the minimum value
                            	  5246:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5247:     ; if Link is at the wall with a smaller major coordinate.
                            	  5248:     ;
02:0003BC44 7600            	  5249:     moveq   #0,D3
                            	  5250:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5251:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5252:     ; to access the block for the other direction along the same axis,
                            	  5253:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5254:     ;
02:0003BC46 102C0001        	  5255:     move.b  ($0001,A4),D0
02:0003BC4A 122C0003        	  5256:     move.b  ($0003,A4),D1
02:0003BC4E B001            	  5257:     cmp.b   D1,D0
02:0003BC50 671C            	  5258:     beq  _anon_z04_72
02:0003BC52 41EC0412        	  5259:     lea     ($0412,A4),A0
02:0003BC56 10302000        	  5260:     move.b  (A0,D2.W),D0
02:0003BC5A 023C00EE        	  5261:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BC5E 123C0010        	  5262:     move.b  #$10,D1
02:0003BC62 D101            	  5263:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003BC64 41EC0412        	  5264:     lea     ($0412,A4),A0
02:0003BC68 11802000        	  5265:     move.b  D0,(A0,D2.W)
02:0003BC6C 5203            	  5266:     addq.b  #1,D3
