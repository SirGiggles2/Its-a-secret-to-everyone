02:0003F3F2 6712            	 12820:     beq  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003F3F4 102C0015        	 12821:     move.b  ($0015,A4),D0
02:0003F3F8 02000007        	 12822:     andi.b #$07,D0
02:0003F3FC 6608            	 12823:     bne  _L_z04_Ganon_DrawBurst_DrawClouds
02:0003F3FE 41EC0478        	 12824:     lea     ($0478,A4),A0
