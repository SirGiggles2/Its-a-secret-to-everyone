02:0004332A 10303000        	  5262:     move.b  (A0,D3.W),D0
02:0004332E 7600            	  5263:     moveq   #0,D3
02:00043330 162C0003        	  5264:     move.b  ($0003,A4),D3
02:00043334 0C030002        	  5265:     cmpi.b  #$02,D3
02:00043338 6510            	  5266:     bcs  _anon_z05_106
02:0004333A 7600            	  5267:     moveq   #0,D3
02:0004333C 162C00EB        	  5268:     move.b  ($00EB,A4),D3
02:00043340 41F900FF68FE    	  5269:     lea     (NES_SRAM+$08FE).l,A0
02:00043346 10303000        	  5270:     move.b  (A0,D3.W),D0
