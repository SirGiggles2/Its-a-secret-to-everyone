                            	  4559: ; Places the weapon $10 pixels away from the player in the
                            	  4560: ; player's direction.
                            	  4561: ;
                            	  4562: ; Params:
                            	  4563: ; A: $10 for right and down
                            	  4564: ; X: object index
                            	  4565: ;
                            	  4566: ;
                            	  4567: ; Set the offset choices to:
