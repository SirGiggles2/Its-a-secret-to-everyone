                            	  7671: _anon_z05_156:
02:00044992 101D            	  7672:     move.b  (A5)+,D0  ; PLA
                            	  7673:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7674:     ; then the player walked all the way to the edge of the play
                            	  7675:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7676:     ;
                            	  7677:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7678:     ; edge of the play area. So, set a relative position that
                            	  7679:     ; reflects that distance: $28 or -$28.
                            	  7680:     ;
                            	  7681:     ; If walking in a decreasing direction (left or up), then
                            	  7682:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7683:     ;
                            	  7684:     ; If walking in an increasing direction (right or down), then
                            	  7685:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7686:     ;
02:00044994 02000007        	  7687:     andi.b #$07,D0
02:00044998 0C000002        	  7688:     cmpi.b  #$02,D0
02:0004499C 6506            	  7689:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:0004499E 0C000005        	  7690:     cmpi.b  #$05,D0
