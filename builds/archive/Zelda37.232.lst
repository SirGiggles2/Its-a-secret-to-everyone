02:00043A40 7005            	  6279:     moveq   #5,D0
02:00043A42 4EB90002A9FA    	  6280:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00043A48 61007342        	  6281:     jsr     GetUniqueRoomId
02:00043A4C 1B00            	  6282:     move.b  D0,-(A5)  ; PHA
02:00043A4E 7000            	  6283:     moveq   #0,D0
