02:00042110 1B00            	  4210:     move.b  D0,-(A5)  ; PHA
02:00042112 610000DC        	  4211:     jsr     GetPlayerCoordsForDirection
02:00042116 101D            	  4212:     move.b  (A5)+,D0  ; PLA
02:00042118 4EB900030CE2    	  4213:     jsr     GetOppositeDir
02:0004211E 102C0001        	  4214:     move.b  ($0001,A4),D0
                            	  4215:     ; If the player is within the bounds of the doorway for DoorwayDir
                            	  4216:     ; (for example the left door way, if DoorwayDir = left;
                            	  4217:     ; instead of right doorway while DoorwayDir = left),
                            	  4218:     ; and player is facing in DoorwayDir, then go repeat the
                            	  4219:     ; original search used to enter the doorway.
