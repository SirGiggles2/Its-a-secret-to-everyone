02:0004215C 6620            	  4250:     bne  _anon_z05_96
02:0004215E 102C0001        	  4251:     move.b  ($0001,A4),D0
02:00042162 41F9000420BA    	  4252:     lea     (DoorwayBoundsMinUnder).l,A0
02:00042168 12303000        	  4253:     move.b  (A0,D3.W),D1
02:0004216C B001            	  4254:     cmp.b   D1,D0
