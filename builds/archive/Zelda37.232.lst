                            	  4212: CheckTiles:
                            	  4213:     ifne TURBO_LINK
                            	  4214:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4215:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004BAF4 4A02            	  4216:     tst.b   D2
02:0004BAF6 6608            	  4217:     bne.s   _L_z07_CheckTiles_notLink
02:0004BAF8 197C0024049E    	  4218:     move.b  #$24,($049E,A4)
02:0004BAFE 605E            	  4219:     jmp     GoWalkableDir
                            	  4220: _L_z07_CheckTiles_notLink:
                            	  4221:     endc
                            	  4222:     ; The code below applies to Link and other objects.
                            	  4223:     ;
                            	  4224:     ; Test the moving direction's walkability.
                            	  4225:     ;
                            	  4226:     ; For the player, this is enough. For other objects, this 
                            	  4227:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4228:     ;
                            	  4229:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4230:     ;
02:0004BB00 6100FB88        	  4231:     jsr     GetCollidingTileMoving
02:0004BB04 122C034A        	  4232:     move.b  ($034A,A4),D1
02:0004BB08 B001            	  4233:     cmp.b   D1,D0
02:0004BB0A 6402            	  4234:     bcc.s  __far_z_07_0053
02:0004BB0C 6050            	  4235:     jmp  GoWalkableDir
                            	  4236: __far_z_07_0053:
                            	  4237:     ; The colliding tile is unwalkable.
                            	  4238:     ;
                            	  4239:     ; If object is the player, then go check passive tile objects and
                            	  4240:     ; the screen edge, or stop moving.
                            	  4241:     ;
