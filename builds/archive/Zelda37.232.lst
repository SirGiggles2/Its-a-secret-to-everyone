                            	  2958: Link_FilterInput:
                            	  2959:     ; [00] holds the opposite of Link's facing direction.
                            	  2960:     ;
02:00041892 102C0098        	  2961:     move.b  ($0098,A4),D0
02:00041896 4EB900030CE2    	  2962:     jsr     GetOppositeDir
02:0004189C 1880            	  2963:     move.b  D0,($0000,A4)
                            	  2964:     ; Call GetOppositeDir again to use this mapping:
                            	  2965:     ; In Dir: 1 2 4 8
                            	  2966:     ;         -------
                            	  2967:     ; Index:  2 3 0 1
                            	  2968:     ;
02:0004189E 4EB900030CE2    	  2969:     jsr     GetOppositeDir
                            	  2970:     ; Get the appropriate coordinate for the direction:
                            	  2971:     ; X for horizontal
                            	  2972:     ; Y for vertical
                            	  2973:     ;
02:000418A4 102C0070        	  2974:     move.b  ($0070,A4),D0
02:000418A8 0C030002        	  2975:     cmpi.b  #$02,D3
02:000418AC 6404            	  2976:     bcc  _anon_z05_74
02:000418AE 102C0084        	  2977:     move.b  ($0084,A4),D0
                            	  2978: _anon_z05_74:
02:000418B2 19400002        	  2979:     move.b  D0,($0002,A4)
                            	  2980:     ; Mask A button and directions if inner border is crossed.
                            	  2981:     ;
02:000418B6 1003            	  2982:     move.b  D3,D0
02:000418B8 1B00            	  2983:     move.b  D0,-(A5)  ; PHA
02:000418BA 023C00EE        	  2984:     andi    #$EE,CCR  ; CLC: clear C+X
02:000418BE 123C0008        	  2985:     move.b  #$08,D1
02:000418C2 D101            	  2986:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000418C4 7600            	  2987:     moveq   #0,D3
02:000418C6 1600            	  2988:     move.b  D0,D3
02:000418C8 103C0080        	  2989:     move.b  #$80,D0
02:000418CC 6134            	  2990:     jsr     MaskInputInBorder
02:000418CE 101D            	  2991:     move.b  (A5)+,D0  ; PLA
02:000418D0 7600            	  2992:     moveq   #0,D3
02:000418D2 1600            	  2993:     move.b  D0,D3
                            	  2994:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2995:     ; boundary using player's direction and reverse direction index.
                            	  2996:     ;
02:000418D4 102C0001        	  2997:     move.b  ($0001,A4),D0
02:000418D8 0C0000FF        	  2998:     cmpi.b  #$FF,D0
02:000418DC 660C            	  2999:     bne  _anon_z05_75
02:000418DE 102C0098        	  3000:     move.b  ($0098,A4),D0
02:000418E2 1880            	  3001:     move.b  D0,($0000,A4)
02:000418E4 4EB900030CE2    	  3002:     jsr     GetOppositeDir
                            	  3003: _anon_z05_75:
                            	  3004:     ; If in UW, use the second set of bounds by adding 4
                            	  3005:     ; to reverse direction index.
                            	  3006:     ;
                            	  3007:     ; Else in OW, and use first set that begins at offset 0.
                            	  3008:     ;
02:000418EA 102C0010        	  3009:     move.b  ($0010,A4),D0
02:000418EE 6710            	  3010:     beq  _anon_z05_76
02:000418F0 1003            	  3011:     move.b  D3,D0
02:000418F2 023C00EE        	  3012:     andi    #$EE,CCR  ; CLC: clear C+X
02:000418F6 123C0004        	  3013:     move.b  #$04,D1
02:000418FA D101            	  3014:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000418FC 7600            	  3015:     moveq   #0,D3
02:000418FE 1600            	  3016:     move.b  D0,D3
                            	  3017: _anon_z05_76:
                            	  3018:     ; We won't mask buttons (A) this time. Only directions now.
                            	  3019:     ;
02:00041900 7000            	  3020:     moveq   #0,D0
                            	  3021: ; Params:
                            	  3022: ; A: mask of buttons to block
                            	  3023: ; Y: offset into BorderBounds
                            	  3024: ; [00]: direction
                            	  3025: ; [02]: coordinate
                            	  3026: ;
                            	  3027: ; Returns:
                            	  3028: ; [01]: button mask that was used
                            	  3029: ;       (set to $FF if boundary not crossed)
                            	  3030: ;
                            	  3031:     even
                            	  3032: MaskInputInBorder:
02:00041902 19400001        	  3033:     move.b  D0,($0001,A4)
                            	  3034:     ; If direction is positive (right or down), then go handle it separately.
                            	  3035:     ;
02:00041906 1014            	  3036:     move.b  ($0000,A4),D0
02:00041908 0200000A        	  3037:     andi.b #$0A,D0
02:0004190C 6748            	  3038:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  3039:     ; The direction is negative (left or up).
                            	  3040:     ;
                            	  3041:     ; If the coordinate does not cross (<) the boundary, then
                            	  3042:     ; go set mask $FF, so that no button is excluded.
                            	  3043:     ;
02:0004190E 102C0002        	  3044:     move.b  ($0002,A4),D0
02:00041912 41F900041886    	  3045:     lea     (BorderBounds).l,A0
02:00041918 12303000        	  3046:     move.b  (A0,D3.W),D1
02:0004191C B001            	  3047:     cmp.b   D1,D0
02:0004191E 6548            	  3048:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  3049:     even
