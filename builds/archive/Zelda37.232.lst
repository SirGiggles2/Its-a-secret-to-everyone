02:0003EC72 41EC0350        	 11724:     lea     ($0350,A4),A0
02:0003EC76 10303000        	 11725:     move.b  (A0,D3.W),D0
02:0003EC7A 122C04E7        	 11726:     move.b  ($04E7,A4),D1
