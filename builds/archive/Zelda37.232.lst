02:0003F37E 19803072        	 12762:     move.b  D0,($72,A4,D3.W)
02:0003F382 41EC0084        	 12763:     lea     ($0084,A4),A0
02:0003F386 10302000        	 12764:     move.b  (A0,D2.W),D0
02:0003F38A 123C0004        	 12765:     move.b  #$04,D1
