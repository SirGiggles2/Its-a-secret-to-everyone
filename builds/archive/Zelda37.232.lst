                            	 11092: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 11093:     ; The whole gleeok died, because the last neck died.
                            	 11094:     ;
                            	 11095:     ; First, hide the first $10 sprites: the attached heads.
                            	 11096:     ;
02:0003E78A 4EB900031558    	 11097:     jsr     WriteBlankPrioritySprites
02:0003E790 61000F5C        	 11098:     jsr     PlayBossDeathCry
                            	 11099:     ; We want a death spark. So, set the metastate of the first
                            	 11100:     ; monster slot to $11.
                            	 11101:     ;
