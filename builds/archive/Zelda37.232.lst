02:00030DC6 0A3C0010        	  4398:     eori    #$10,CCR  ; restore X = 6502 C
02:00030DCA 0C000008        	  4399:     cmpi.b  #$08,D0
02:00030DCE 6538            	  4400:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
