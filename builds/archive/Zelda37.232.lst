02:00041C0A B001            	  3493:     cmp.b   D1,D0
02:00041C0C 66F0            	  3494:     bne  _anon_z05_84
                            	  3495:     ; Add the value of the shortcut chosen to whatever index
                            	  3496:     ; the current room has in the array.
                            	  3497:     ;
                            	  3498:     ; This yields the index of one of the three shortcut rooms
                            	  3499:     ; after the current one.
                            	  3500:     ;
02:00041C0E 1003            	  3501:     move.b  D3,D0
02:00041C10 023C00EE        	  3502:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041C14 1214            	  3503:     move.b  ($0000,A4),D1
02:00041C16 D101            	  3504:     addx.b  D1,D0   ; ADC $00
                            	  3505:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3506:     ;
02:00041C18 02000003        	  3507:     andi.b #$03,D0
02:00041C1C 7600            	  3508:     moveq   #0,D3
02:00041C1E 1600            	  3509:     move.b  D0,D3
02:00041C20 41F900FF6BB2    	  3510:     lea     (NES_SRAM+$0BB2).l,A0
02:00041C26 10303000        	  3511:     move.b  (A0,D3.W),D0
                            	  3512: ; Params:
                            	  3513: ; A: destination room ID
                            	  3514: ;
