                            	  5816: Moldorm_Chase:
                            	  5817:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5818:     ; Only the head controls the movement direction.
                            	  5819:     ;
02:0003C0F0 0C020005        	  5820:     cmpi.b  #$05,D2
02:0003C0F4 670A            	  5821:     beq  _anon_z04_81
02:0003C0F6 0C02000A        	  5822:     cmpi.b  #$0A,D2
02:0003C0FA 6704            	  5823:     beq.s  __far_z_04_0040
02:0003C0FC 600000A4        	  5824:     jmp  L1156B_Exit
                            	  5825: __far_z_04_0040:
                            	  5826: _anon_z04_81:
                            	  5827:     ; Chase while flying, as usual.
                            	  5828:     ;
02:0003C100 61003AE2        	  5829:     jsr     Flyer_Chase
                            	  5830:     ; If timer has not expired, then
                            	  5831:     ; go see if it's time to propagate direction changes down the chain.
                            	  5832:     ;
02:0003C104 10342028        	  5833:     move.b  ($28,A4,D2.W),D0
02:0003C108 6702            	  5834:     beq.s  __far_z_04_0041
02:0003C10A 6032            	  5835:     jmp  Moldorm_PropagateDirs
                            	  5836: __far_z_04_0041:
                            	  5837:     even
                            	  5838: Moldorm_ChangeFlyingState:
                            	  5839:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5840:     ;
02:0003C10C 61000096        	  5841:     jsr     Flyer_MoldormDecideState
02:0003C110 7010            	  5842:     moveq   #16,D0
02:0003C112 19802028        	  5843:     move.b  D0,($28,A4,D2.W)
                            	  5844:     ; If the next lower slot's direction <> 0, then
                            	  5845:     ; go propagate direction changes down the chain.
                            	  5846:     ;
                            	  5847:     ; But you had to have propagated directions once for the
                            	  5848:     ; next lower direction to be set. How does it happen?
                            	  5849:     ;
                            	  5850:     ; Within a flyer state, the flying routines turn the flyer
                            	  5851:     ; and set the object timer to $10 several times. After any of
                            	  5852:     ; those times will the test succeed.
                            	  5853:     ;
                            	  5854:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5855:     ; in this block to set the timer to $10, and try to propagate
                            	  5856:     ; directions.
                            	  5857:     ;
                            	  5858:     ; But this is also the case the first time here.
                            	  5859:     ;
                            	  5860:     ; So, I believe that the point of this test is to delay moving
                            	  5861:     ; the lower (not head) segments when starting out.
                            	  5862:     ;
02:0003C116 41EC0097        	  5863:     lea     ($0097,A4),A0
02:0003C11A 10302000        	  5864:     move.b  (A0,D2.W),D0
02:0003C11E 6702            	  5865:     beq.s  __far_z_04_0042
02:0003C120 601C            	  5866:     jmp  Moldorm_PropagateDirs
                            	  5867: __far_z_04_0042:
02:0003C122 4E75            	  5868:     rts
                            	  5869: 
                            	  5870:     even
                            	  5871: Moldorm_Wander:
                            	  5872:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5873:     ; Only the head controls the movement direction.
                            	  5874:     ;
02:0003C124 0C020005        	  5875:     cmpi.b  #$05,D2
02:0003C128 6708            	  5876:     beq  _anon_z04_82
02:0003C12A 0C02000A        	  5877:     cmpi.b  #$0A,D2
02:0003C12E 6702            	  5878:     beq.s  __far_z_04_0043
02:0003C130 6070            	  5879:     jmp  L1156B_Exit
                            	  5880: __far_z_04_0043:
                            	  5881: _anon_z04_82:
                            	  5882:     ; Turn randomly while flying, as usual.
                            	  5883:     ;
02:0003C132 61003B8E        	  5884:     jsr     Flyer_Wander
                            	  5885:     ; After every turn, the common flyer routines set timer to $10.
                            	  5886:     ; This can be used as a signal for moldorm to propagate
                            	  5887:     ; direction changes down the chain.
                            	  5888:     ;
                            	  5889:     ; Between each turn, timer <> $10.
                            	  5890:     ;
                            	  5891:     ; At the end of the delay after the last turn, timer = 0.
                            	  5892:     ; This is a signal that that flying state ended, and a new one
                            	  5893:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5894:     ; we can propagate direction changes again; and start
                            	  5895:     ; a new flying interval by setting timer to $10. This will make
