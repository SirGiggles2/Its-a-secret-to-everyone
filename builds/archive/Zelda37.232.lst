02:00043A5A 101D            	  6287:     move.b  (A5)+,D0  ; PLA
02:00043A5C E308            	  6288:     lsl.b  #1,D0   ; ASL A
02:00043A5E E308            	  6289:     lsl.b  #1,D0   ; ASL A
