02:00030458 660000B2        	  2960:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2961:     ; State 0. Sensing.
                            	  2962:     ;
                            	  2963:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2964:     ; then go see if the horizontal distance is shorter.
                            	  2965:     ;
02:0003045C 102C0084        	  2966:     move.b  ($0084,A4),D0
02:00030460 003C0011        	  2967:     ori     #$11,CCR  ; SEC: set C+X
02:00030464 41EC0084        	  2968:     lea     ($0084,A4),A0
02:00030468 12302000        	  2969:     move.b  (A0,D2.W),D1
02:0003046C 0A3C0010        	  2970:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030470 9101            	  2971:     subx.b  D1,D0   ; SBC ObjY,X
02:00030472 0A3C0010        	  2972:     eori    #$10,CCR  ; restore X = 6502 C
02:00030476 6100086E        	  2973:     jsr     Abs
02:0003047A 0C00000E        	  2974:     cmpi.b  #$0E,D0
02:0003047E 644C            	  2975:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2976:     ; Determine the horizontal direction toward Link;
                            	  2977:     ; and if Link and the trap are at the same X, then we can't move
                            	  2978:     ; along this axis. Go see about moving vertically.
                            	  2979:     ;
02:00030480 7601            	  2980:     moveq   #1,D3
02:00030482 102C0070        	  2981:     move.b  ($0070,A4),D0
02:00030486 12342070        	  2982:     move.b  ($70,A4,D2.W),D1
02:0003048A B001            	  2983:     cmp.b   D1,D0
02:0003048C 673E            	  2984:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003048E 6402            	  2985:     bcc  _anon_z01_26
02:00030490 7602            	  2986:     moveq   #2,D3
                            	  2987: _anon_z01_26:
                            	  2988:     ; Remember the original X coordinate.
                            	  2989:     ;
02:00030492 10342070        	  2990:     move.b  ($70,A4,D2.W),D0
                            	  2991:     even
                            	  2992: _L_z01_UpdateTrap_Full_GoToState1:
