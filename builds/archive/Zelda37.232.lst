                            	  7049: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  7050:     ; Advance the substate.
                            	  7051:     ;
02:0003C9CE 41EC042C        	  7052:     lea     ($042C,A4),A0
02:0003C9D2 52302000        	  7053:     addq.b  #1,(A0,D2.W)
                            	  7054:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  7055:     ;
02:0003C9D6 41EC042C        	  7056:     lea     ($042C,A4),A0
02:0003C9DA 10302000        	  7057:     move.b  (A0,D2.W),D0
02:0003C9DE 0C000002        	  7058:     cmpi.b  #$02,D0
