02:0003BBAC 41EC0084        	  5173:     lea     ($0084,A4),A0
02:0003BBB0 10302000        	  5174:     move.b  (A0,D2.W),D0
02:0003BBB4 19400084        	  5175:     move.b  D0,($0084,A4)
02:0003BBB8 4EB90004BC8E    	  5176:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BBBE 4EB900030A84    	  5177:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:0003BBC4 7400            	  5178:     moveq   #0,D2
