02:000420DA 12303000        	  4182:     move.b  (A0,D3.W),D1
02:000420DE B001            	  4183:     cmp.b   D1,D0
02:000420E0 6622            	  4184:     bne  _anon_z05_95
02:000420E2 102C0001        	  4185:     move.b  ($0001,A4),D0
02:000420E6 41F9000420B2    	  4186:     lea     (DoorwayBoundsMinOver).l,A0
02:000420EC 12303000        	  4187:     move.b  (A0,D3.W),D1
02:000420F0 B001            	  4188:     cmp.b   D1,D0
02:000420F2 6510            	  4189:     bcs  _anon_z05_95
02:000420F4 41F9000420B6    	  4190:     lea     (DoorwayBoundsMaxOver).l,A0
02:000420FA 12303000        	  4191:     move.b  (A0,D3.W),D1
02:000420FE B001            	  4192:     cmp.b   D1,D0
02:00042100 65000082        	  4193:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  4194: _anon_z05_95:
