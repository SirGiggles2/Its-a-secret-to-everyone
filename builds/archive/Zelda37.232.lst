02:000302A8 B001            	  2734:     cmp.b   D1,D0
02:000302AA 66EC            	  2735:     bne  _L_z01_CheckPassiveTileObjects_NextTile
                            	  2736:     ; We'll be computing the location of the square.
                            	  2737:     ; Start with Link's location.
                            	  2738:     ;
02:000302AC 102C0070        	  2739:     move.b  ($0070,A4),D0
02:000302B0 1880            	  2740:     move.b  D0,($0000,A4)
02:000302B2 102C0084        	  2741:     move.b  ($0084,A4),D0
02:000302B6 19400001        	  2742:     move.b  D0,($0001,A4)
02:000302BA 102C0098        	  2743:     move.b  ($0098,A4),D0
02:000302BE 0200000C        	  2744:     andi.b #$0C,D0
02:000302C2 6726            	  2745:     beq  _L_z01_CheckPassiveTileObjects_CheckHorizontal
                            	  2746:     ; Link is facing vertically.
                            	  2747:     ;
                            	  2748:     ; If Link touched the left side of the square with the right side
                            	  2749:     ; of his body, then add 8 to X.
                            	  2750:     ;
                            	  2751:     ; If Link touched the right side of the square with the left side
                            	  2752:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2753:     ;
02:000302C4 102C0002        	  2754:     move.b  ($0002,A4),D0
02:000302C8 02000003        	  2755:     andi.b #$03,D0
02:000302CC 7600            	  2756:     moveq   #0,D3
02:000302CE 1600            	  2757:     move.b  D0,D3
02:000302D0 1014            	  2758:     move.b  ($0000,A4),D0
02:000302D2 0C030002        	  2759:     cmpi.b  #$02,D3
02:000302D6 640A            	  2760:     bcc  _anon_z01_24
02:000302D8 023C00EE        	  2761:     andi    #$EE,CCR  ; CLC: clear C+X
02:000302DC 123C0008        	  2762:     move.b  #$08,D1
02:000302E0 D101            	  2763:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  2764: _anon_z01_24:
