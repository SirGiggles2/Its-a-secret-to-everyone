02:0004C5AE 41EC03D0        	  5814:     lea     ($03D0,A4),A0
02:0004C5B2 11802000        	  5815:     move.b  D0,(A0,D2.W)
02:0004C5B6 41EC00AC        	  5816:     lea     ($00AC,A4),A0
02:0004C5BA 52302000        	  5817:     addq.b  #1,(A0,D2.W)
02:0004C5BE 41EC00AC        	  5818:     lea     ($00AC,A4),A0
02:0004C5C2 10302000        	  5819:     move.b  (A0,D2.W),D0
02:0004C5C6 02000077        	  5820:     andi.b #$77,D0
02:0004C5CA 41EC00AC        	  5821:     lea     ($00AC,A4),A0
02:0004C5CE 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:0004C5D2 0C02000D        	  5823:     cmpi.b  #$0D,D2
02:0004C5D6 6402            	  5824:     bcc.s  __far_z_07_0088
02:0004C5D8 6032            	  5825:     jmp  CalcBoomerangFrame
