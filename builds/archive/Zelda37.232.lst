02:00041924 122C0001        	  3054:     move.b  ($0001,A4),D1
02:00041928 C001            	  3055:     and.b  D1,D0
02:0004192A 194000F8        	  3056:     move.b  D0,($00F8,A4)
                            	  3057:     ; If in OW or button mask <> 0, return.
                            	  3058:     ;
02:0004192E 102C0010        	  3059:     move.b  ($0010,A4),D0
02:00041932 6720            	  3060:     beq  _L_z05_MaskInputInBorder_Exit
02:00041934 102C0001        	  3061:     move.b  ($0001,A4),D0
