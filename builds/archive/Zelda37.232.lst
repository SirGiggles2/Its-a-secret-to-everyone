02:00033780 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00033784 5203            	   618:     addq.b  #1,D3
02:00033786 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
