02:0003F2F6 19802070        	 12691:     move.b  D0,($70,A4,D2.W)
02:0003F2FA 41EC0084        	 12692:     lea     ($0084,A4),A0
02:0003F2FE 10302000        	 12693:     move.b  (A0,D2.W),D0
02:0003F302 123C0008        	 12694:     move.b  #$08,D1
02:0003F306 D101            	 12695:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F308 41EC0084        	 12696:     lea     ($0084,A4),A0
