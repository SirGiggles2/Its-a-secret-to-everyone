                            	  3538: CheckCaveEdge:
02:00041C5A 4EB90004BB84    	  3539:     jsr     CheckScreenEdge
                            	  3540:     ; If the player touched the edge of the screen and triggered
                            	  3541:     ; a transition to another mode, then go set up the right mode.
                            	  3542:     ;
02:00041C60 102C0011        	  3543:     move.b  ($0011,A4),D0
02:00041C64 6602            	  3544:     bne.s  __far_z_05_0069
02:00041C66 60CC            	  3545:     jmp  GoToModeAFromCave
                            	  3546: __far_z_05_0069:
02:00041C68 4E75            	  3547:     rts
                            	  3548: 
                            	  3549: ; Params:
                            	  3550: ; [0F]: movement direction
                            	  3551: ;
                            	  3552: ; Returns:
                            	  3553: ; [0F]: movement direction or 0
                            	  3554: ;
                            	  3555: ;
                            	  3556: ; If the ladder's not in use, return.
                            	  3557: ;
                            	  3558:     even
                            	  3559: CheckLadder:
02:00041C6A 7400            	  3560:     moveq   #0,D2
02:00041C6C 142C0064        	  3561:     move.b  ($0064,A4),D2
02:00041C70 670000BE        	  3562:     beq  _L_z05_CheckLadder_Exit
                            	  3563:     ; If the ladder is done (state 0), go put away the ladder.
                            	  3564:     ;
02:00041C74 41EC00AC        	  3565:     lea     ($00AC,A4),A0
02:00041C78 10302000        	  3566:     move.b  (A0,D2.W),D0
02:00041C7C 670000A6        	  3567:     beq  _L_z05_CheckLadder_StashLadder
                            	  3568:     ; If the ladder is facing vertically, calculate the vertical distance
                            	  3569:     ; between the ladder and Link.
                            	  3570:     ; If Link's X no longer matches the ladder's, go put the ladder away.
                            	  3571:     ;
02:00041C80 41EC0098        	  3572:     lea     ($0098,A4),A0
02:00041C84 10302000        	  3573:     move.b  (A0,D2.W),D0
02:00041C88 0200000C        	  3574:     andi.b #$0C,D0
02:00041C8C 6734            	  3575:     beq  _anon_z05_85
02:00041C8E 102C0070        	  3576:     move.b  ($0070,A4),D0
02:00041C92 12342070        	  3577:     move.b  ($70,A4,D2.W),D1
02:00041C96 B001            	  3578:     cmp.b   D1,D0
02:00041C98 6600008A        	  3579:     bne  _L_z05_CheckLadder_StashLadder
02:00041C9C 102C0084        	  3580:     move.b  ($0084,A4),D0
02:00041CA0 023C00EE        	  3581:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CA4 123C0003        	  3582:     move.b  #$03,D1
02:00041CA8 D101            	  3583:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041CAA 003C0011        	  3584:     ori     #$11,CCR  ; SEC: set C+X
02:00041CAE 41EC0084        	  3585:     lea     ($0084,A4),A0
02:00041CB2 12302000        	  3586:     move.b  (A0,D2.W),D1
02:00041CB6 0A3C0010        	  3587:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041CBA 9101            	  3588:     subx.b  D1,D0   ; SBC ObjY,X
02:00041CBC 0A3C0010        	  3589:     eori    #$10,CCR  ; restore X = 6502 C
02:00041CC0 6030            	  3590:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
                            	  3591: 
                            	  3592: _anon_z05_85:
                            	  3593:     ; If instead it's facing horizontally, calculate the horizontal distance
                            	  3594:     ; between the ladder and Link.
                            	  3595:     ; If Link's Y no longer matches the ladder's, go put the ladder away.
                            	  3596:     ;
02:00041CC2 102C0084        	  3597:     move.b  ($0084,A4),D0
02:00041CC6 023C00EE        	  3598:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041CCA 123C0003        	  3599:     move.b  #$03,D1
02:00041CCE D101            	  3600:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041CD0 41EC0084        	  3601:     lea     ($0084,A4),A0
02:00041CD4 12302000        	  3602:     move.b  (A0,D2.W),D1
02:00041CD8 B001            	  3603:     cmp.b   D1,D0
02:00041CDA 6648            	  3604:     bne  _L_z05_CheckLadder_StashLadder
02:00041CDC 102C0070        	  3605:     move.b  ($0070,A4),D0
02:00041CE0 003C0011        	  3606:     ori     #$11,CCR  ; SEC: set C+X
02:00041CE4 12342070        	  3607:     move.b  ($70,A4,D2.W),D1
02:00041CE8 0A3C0010        	  3608:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041CEC 9101            	  3609:     subx.b  D1,D0   ; SBC ObjX,X
02:00041CEE 0A3C0010        	  3610:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3611:     even
                            	  3612: _L_z05_CheckLadder_CheckDistanceToLadder:
                            	  3613:     ; If absolute distance < $10, go handle movement on the ladder and set state 2.
                            	  3614:     ; If > $10, go put the ladder away.
                            	  3615:     ;
02:00041CF2 4EB900030CE6    	  3616:     jsr     Abs
02:00041CF8 1880            	  3617:     move.b  D0,($0000,A4)
02:00041CFA 0C000010        	  3618:     cmpi.b  #$10,D0
02:00041CFE 6532            	  3619:     bcs  _L_z05_CheckLadder_SetState2
02:00041D00 0C000010        	  3620:     cmpi.b  #$10,D0
02:00041D04 661E            	  3621:     bne  _L_z05_CheckLadder_StashLadder
                            	  3622:     ; Distance = $10. If player's not facing in the same direction as
                            	  3623:     ; the ladder, go put away the ladder.
                            	  3624:     ;
02:00041D06 102C0098        	  3625:     move.b  ($0098,A4),D0
02:00041D0A 41EC0098        	  3626:     lea     ($0098,A4),A0
02:00041D0E 12302000        	  3627:     move.b  (A0,D2.W),D1
02:00041D12 B001            	  3628:     cmp.b   D1,D0
02:00041D14 660E            	  3629:     bne  _L_z05_CheckLadder_StashLadder
                            	  3630:     ; Distance = $10, and player's facing in the same direction.
                            	  3631:     ;
                            	  3632:     ; If the ladder's still in initial state 1, then Link's facing the
                            	  3633:     ; ladder and had not stepped onto it yet.
                            	  3634:     ; Go handle movement on it, but don't change state yet.
                            	  3635:     ;
                            	  3636:     ; But if ladder state is 2, then it means Link completely stepped
                            	  3637:     ; off of the ladder. So the ladder should be put away. In this
                            	  3638:     ; case, fall thru.
                            	  3639:     ;
02:00041D16 41EC00AC        	  3640:     lea     ($00AC,A4),A0
02:00041D1A 10302000        	  3641:     move.b  (A0,D2.W),D0
02:00041D1E 0C000001        	  3642:     cmpi.b  #$01,D0
02:00041D22 6718            	  3643:     beq  _L_z05_CheckLadder_HandleInput
                            	  3644:     even
                            	  3645: _L_z05_CheckLadder_StashLadder:
                            	  3646:     ; Put away the ladder. Reset ladder slot and destroy the object.
                            	  3647:     ;
02:00041D24 7000            	  3648:     moveq   #0,D0
02:00041D26 19400064        	  3649:     move.b  D0,($0064,A4)
02:00041D2A 4EB90004D55E    	  3650:     jsr     DestroyMonster
                            	  3651:     even
                            	  3652: _L_z05_CheckLadder_Exit:
02:00041D30 4E75            	  3653:     rts
                            	  3654: 
                            	  3655:     even
                            	  3656: _L_z05_CheckLadder_SetState2:
                            	  3657:     ;  Set state 2, because we're on the ladder.
                            	  3658:     ;
02:00041D32 7002            	  3659:     moveq   #2,D0
02:00041D34 41EC00AC        	  3660:     lea     ($00AC,A4),A0
02:00041D38 11802000        	  3661:     move.b  D0,(A0,D2.W)
                            	  3662:     even
                            	  3663: _L_z05_CheckLadder_HandleInput:
                            	  3664:     ; If input direction = 0, go draw and reset moving direction.
                            	  3665:     ;
02:00041D3C 102C03F8        	  3666:     move.b  ($03F8,A4),D0
02:00041D40 67000086        	  3667:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3668:     ; Input direction <> 0. The player intends to move.
                            	  3669:     ; So, see if we need to override the moving direction.
                            	  3670:     ;
                            	  3671:     ; A. If the distance <> 0, and they are facing the same way,
                            	  3672:     ; go draw and set moving direction to Link's direction.
                            	  3673:     ;
                            	  3674:     ; This lets Link step onto the ladder. Otherwise he would have
                            	  3675:     ; been blocked by the water.
                            	  3676:     ;
                            	  3677:     ; Or, Link already passed over the point right over the ladder
                            	  3678:     ; and was allowed to move onto the tiles after the ladder.
                            	  3679:     ;
02:00041D44 102C0098        	  3680:     move.b  ($0098,A4),D0
02:00041D48 7600            	  3681:     moveq   #0,D3
02:00041D4A 1614            	  3682:     move.b  ($0000,A4),D3
02:00041D4C 670C            	  3683:     beq  _anon_z05_86
02:00041D4E 41EC0098        	  3684:     lea     ($0098,A4),A0
02:00041D52 12302000        	  3685:     move.b  (A0,D2.W),D1
02:00041D56 B001            	  3686:     cmp.b   D1,D0
02:00041D58 676E            	  3687:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3688: _anon_z05_86:
                            	  3689:     ; Distance = 0, or facing different directions.
                            	  3690:     ;
                            	  3691:     ; B. If ladder's direction = Link's *moving* direction,
                            	  3692:     ; then go draw and keep moving.
                            	  3693:     ;
                            	  3694:     ; This only applies when distance = 0. Otherwise, (A) would have caught it.
                            	  3695:     ;
                            	  3696:     ; Before checking the ladder, a tile collision check allowed Link
                            	  3697:     ; to move onto the tiles after the ladder.
                            	  3698:     ;
                            	  3699:     ; Note that if Link is not moving, then this test will fail,
                            	  3700:     ; and case (D) will catch it.
                            	  3701:     ;
02:00041D5A 41EC0098        	  3702:     lea     ($0098,A4),A0
02:00041D5E 10302000        	  3703:     move.b  (A0,D2.W),D0
02:00041D62 122C000F        	  3704:     move.b  ($000F,A4),D1
02:00041D66 B001            	  3705:     cmp.b   D1,D0
02:00041D68 675E            	  3706:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3707:     ; C. If opposite of ladder's direction = Link's facing direction,
                            	  3708:     ; then go draw and move in ladder's direction.
                            	  3709:     ;
                            	  3710:     ; You can always step off the ladder where you came from.
                            	  3711:     ;
02:00041D6A 4EB900030CE2    	  3712:     jsr     GetOppositeDir
02:00041D70 122C0098        	  3713:     move.b  ($0098,A4),D1
02:00041D74 B001            	  3714:     cmp.b   D1,D0
02:00041D76 6750            	  3715:     beq  _L_z05_CheckLadder_DrawLadder
                            	  3716:     ; D. If opposite of ladder's direction <> down,
                            	  3717:     ; or input direction <> up,
                            	  3718:     ; then go reset moving direction, and draw.
                            	  3719:     ;
                            	  3720:     ; This will catch all cases of Link facing perpendicular to
                            	  3721:     ; ladder direction. Also, it will catch Link not moving, unless
                            	  3722:     ; ladder direction is up and input direction is up (E).
                            	  3723:     ;
02:00041D78 0C000004        	  3724:     cmpi.b  #$04,D0
02:00041D7C 6648            	  3725:     bne  _anon_z05_87
02:00041D7E 102C03F8        	  3726:     move.b  ($03F8,A4),D0
02:00041D82 0C000008        	  3727:     cmpi.b  #$08,D0
02:00041D86 663E            	  3728:     bne  _anon_z05_87
                            	  3729:     ; E. The ladder's direction is up and input direction is up.
                            	  3730:     ;
                            	  3731:     ; An earlier call to check tile collision would have blocked
                            	  3732:     ; movement, because the tile under Link's top half is a water tile.
                            	  3733:     ; But because Link is squarely on the ladder, we really have
                            	  3734:     ; to check the tile above that one.
                            	  3735:     ;
                            	  3736:     ; Set moving direction to input direction (up) and switch X to
                            	  3737:     ; the player's slot for the purpose of checking tile collision below.
                            	  3738:     ; Based on that, we'll set moving direction according to walkability.
                            	  3739:     ;
02:00041D88 6158            	  3740:     jsr     SetMovingDirAndSwitchToPlayerSlot
                            	  3741:     ; Check the colliding tile as if Link was 8 pixels up.
                            	  3742:     ;
02:00041D8A 102C0084        	  3743:     move.b  ($0084,A4),D0
02:00041D8E 1B00            	  3744:     move.b  D0,-(A5)  ; PHA
02:00041D90 003C0011        	  3745:     ori     #$11,CCR  ; SEC: set C+X
02:00041D94 123C0008        	  3746:     move.b  #$08,D1
02:00041D98 0A3C0010        	  3747:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D9C 9101            	  3748:     subx.b  D1,D0   ; SBC #$08
02:00041D9E 0A3C0010        	  3749:     eori    #$10,CCR  ; restore X = 6502 C
02:00041DA2 19400084        	  3750:     move.b  D0,($0084,A4)
02:00041DA6 4EB90004B68A    	  3751:     jsr     GetCollidingTileMoving
02:00041DAC 101D            	  3752:     move.b  (A5)+,D0  ; PLA
02:00041DAE 19400084        	  3753:     move.b  D0,($0084,A4)
                            	  3754:     ; If the tile is walkable, go draw the ladder and leave the moving
                            	  3755:     ; direction as the input direction (in a roundabout way).
                            	  3756:     ; Else fall thru to reset moving direction and draw the ladder.
                            	  3757:     ;
02:00041DB2 102C000F        	  3758:     move.b  ($000F,A4),D0
02:00041DB6 7600            	  3759:     moveq   #0,D3
02:00041DB8 162C049E        	  3760:     move.b  ($049E,A4),D3
02:00041DBC 122C034A        	  3761:     move.b  ($034A,A4),D1
02:00041DC0 B601            	  3762:     cmp.b   D1,D3
02:00041DC2 6500FF78        	  3763:     bcs  _L_z05_CheckLadder_HandleInput
                            	  3764: _anon_z05_87:
                            	  3765:     ; Set A to reset moving direction in [0F].
                            	  3766:     ;
02:00041DC6 7000            	  3767:     moveq   #0,D0
                            	  3768:     even
                            	  3769: _L_z05_CheckLadder_DrawLadder:
                            	  3770:     ; Draw the ladder.
                            	  3771:     ;
02:00041DC8 1B00            	  3772:     move.b  D0,-(A5)  ; PHA
02:00041DCA 7400            	  3773:     moveq   #0,D2
02:00041DCC 142C0064        	  3774:     move.b  ($0064,A4),D2
02:00041DD0 4EB90004CD7A    	  3775:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00041DD6 760C            	  3776:     moveq   #12,D3
02:00041DD8 7000            	  3777:     moveq   #0,D0
02:00041DDA 4EB900031A3A    	  3778:     jsr     Anim_WriteStaticItemSpritesWithAttributes
02:00041DE0 101D            	  3779:     move.b  (A5)+,D0  ; PLA
                            	  3780: ; Params:
                            	  3781: ; A: direction
                            	  3782: ;
                            	  3783: ; Returns:
                            	  3784: ; [0F]: direction
                            	  3785: ;
                            	  3786:     even
                            	  3787: SetMovingDirAndSwitchToPlayerSlot:
02:00041DE2 4EF90002C048    	  3788:     jmp     c_set_moving_dir_switch_player
                            	  3789: 
                            	  3790: FindNextEdgeSpawnCell:
                            	  3791:     ; Load [0A] with the value before the call.
                            	  3792:     ;
02:00041DE8 102C0525        	  3793:     move.b  ($0525,A4),D0
02:00041DEC 1940000A        	  3794:     move.b  D0,($000A,A4)
                            	  3795:     even
                            	  3796: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3797:     ; Loop to look for a place to spawn a monster from the edge
                            	  3798:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3799:     ;
                            	  3800:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3801:     ; We'll move down $10 pixels.
                            	  3802:     ;
02:00041DF0 7610            	  3803:     moveq   #16,D3
02:00041DF2 102C000A        	  3804:     move.b  ($000A,A4),D0
02:00041DF6 0200000F        	  3805:     andi.b #$0F,D0
02:00041DFA 670A            	  3806:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3807:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3808:     ; Don't move vertically.
                            	  3809:     ;
02:00041DFC 163C00F0        	  3810:     move.b  #$F0,D3
02:00041E00 0C00000F        	  3811:     cmpi.b  #$0F,D0
02:00041E04 6610            	  3812:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3813:     even
                            	  3814: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3815:     ; Else low nibble = $F. We're at the right edge,
                            	  3816:     ; and we'll move up $10 pixels.
                            	  3817:     ;
02:00041E06 1003            	  3818:     move.b  D3,D0
02:00041E08 023C00EE        	  3819:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041E0C 122C000A        	  3820:     move.b  ($000A,A4),D1
02:00041E10 D101            	  3821:     addx.b  D1,D0   ; ADC $0A
02:00041E12 1940000A        	  3822:     move.b  D0,($000A,A4)
                            	  3823:     even
                            	  3824: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3825:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3826:     ; Move right one pixel.
                            	  3827:     ;
02:00041E16 102C000A        	  3828:     move.b  ($000A,A4),D0
02:00041E1A 020000F0        	  3829:     andi.b #$F0,D0
02:00041E1E 0C0000E0        	  3830:     cmpi.b  #$E0,D0
02:00041E22 6606            	  3831:     bne  _anon_z05_88
