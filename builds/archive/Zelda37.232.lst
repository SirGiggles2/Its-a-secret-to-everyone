02:00031DDA 8001            	  6490:     or.b  D1,D0
02:00031DDC 0200000C        	  6491:     andi.b #$0C,D0
02:00031DE0 0C00000C        	  6492:     cmpi.b  #$0C,D0
02:00031DE4 671A            	  6493:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031DE6 102C0098        	  6494:     move.b  ($0098,A4),D0
