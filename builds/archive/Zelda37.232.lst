02:0003A4F2 5303            	  1902:     subq.b  #1,D3
02:0003A4F4 6AEE            	  1903:     bpl  _anon_z04_30
02:0003A4F6 0A3C0001        	  1904:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A4FA 4E75            	  1905:     rts
                            	  1906: 
                            	  1907:     even
                            	  1908: _L_z04_UpdateStatues_Shoot:
                            	  1909:     ; Look for an empty monster slot.
                            	  1910:     ; If none is found, return.
                            	  1911:     ;
                            	  1912:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1913:     ; object. This routine takes a shooter object, and instantiates
                            	  1914:     ; a fireball object at the shooter's location.
                            	  1915:     ;
                            	  1916:     ; The object slot we set up here will behave as the shooter.
                            	  1917:     ; For each fireball index, this object slot will have its coordinates
                            	  1918:     ; changed.
                            	  1919:     ;
                            	  1920:     ; Note that this means that:
                            	  1921:     ; 1. The first fireball made will be its own shooter.
                            	  1922:     ;    Practically, there's nothing special about this.
                            	  1923:     ; 2. If there is more than one fireball made in a frame,
                            	  1924:     ;    then two of them will come from the same statue.
                            	  1925:     ;
                            	  1926:     ;
                            	  1927:     ; Save the fireball pattern.
02:0003A4FC 1003            	  1928:     move.b  D3,D0
02:0003A4FE 1B00            	  1929:     move.b  D0,-(A5)  ; PHA
02:0003A500 4EB90004D56A    	  1930:     jsr     FindEmptyMonsterSlot
02:0003A506 0C000001        	  1931:     cmpi.b  #$01,D0
02:0003A50A 101D            	  1932:     move.b  (A5)+,D0  ; PLA
02:0003A50C 6400010A        	  1933:     bcc  _L_z04_UpdateStatues_Exit
                            	  1934:     ; If we found a slot, but it < 6, return.
                            	  1935:     ;
02:0003A510 0C030006        	  1936:     cmpi.b  #$06,D3
02:0003A514 65000102        	  1937:     bcs  _L_z04_UpdateStatues_Exit
                            	  1938:     ; Store the object slot in [0A].
                            	  1939:     ; Store fireball pattern in [0B].
                            	  1940:     ;
02:0003A518 1943000A        	  1941:     move.b  D3,($000A,A4)
02:0003A51C 1940000B        	  1942:     move.b  D0,($000B,A4)
                            	  1943:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1944:     ;
02:0003A520 7600            	  1945:     moveq   #0,D3
02:0003A522 1600            	  1946:     move.b  D0,D3
02:0003A524 7400            	  1947:     moveq   #0,D2
02:0003A526 41F90003A4B8    	  1948:     lea     (StatueFireballCounts).l,A0
02:0003A52C 14303000        	  1949:     move.b  (A0,D3.W),D2
                            	  1950:     even
                            	  1951: _L_z04_UpdateStatues_LoopFireball:
                            	  1952:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1953:     ;
                            	  1954:     ; Decrement the fireball timer at this index.
                            	  1955:     ;
02:0003A530 7600            	  1956:     moveq   #0,D3
02:0003A532 41EC04E8        	  1957:     lea     ($04E8,A4),A0
02:0003A536 16302000        	  1958:     move.b  (A0,D2.W),D3
02:0003A53A 5303            	  1959:     subq.b  #1,D3
02:0003A53C 1003            	  1960:     move.b  D3,D0
02:0003A53E 41EC04E8        	  1961:     lea     ($04E8,A4),A0
02:0003A542 11802000        	  1962:     move.b  D0,(A0,D2.W)
                            	  1963:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1964:     ; to make a fireball. Go loop again.
                            	  1965:     ;
02:0003A546 5203            	  1966:     addq.b  #1,D3
02:0003A548 660000C8        	  1967:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1968:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1969:     ; This fireball index will wait another $100 frames.
                            	  1970:     ;
02:0003A54C 10342018        	  1971:     move.b  ($18,A4,D2.W),D0
02:0003A550 0C0000F0        	  1972:     cmpi.b  #$F0,D0
02:0003A554 640000BC        	  1973:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1974:     ; Else choose one of four start times for the fireball based on
                            	  1975:     ; the random value.
                            	  1976:     ;
02:0003A558 02000003        	  1977:     andi.b #$03,D0
02:0003A55C 7600            	  1978:     moveq   #0,D3
02:0003A55E 1600            	  1979:     move.b  D0,D3
02:0003A560 41F90003A4BC    	  1980:     lea     (StatueFireballStartTimes).l,A0
02:0003A566 10303000        	  1981:     move.b  (A0,D3.W),D0
02:0003A56A 41EC04E8        	  1982:     lea     ($04E8,A4),A0
02:0003A56E 11802000        	  1983:     move.b  D0,(A0,D2.W)
                            	  1984:     ; The coordinate lists are divided into sets for each pattern.
                            	  1985:     ;
                            	  1986:     ; Look up the index of the base of the set for the pattern in use.
                            	  1987:     ; Add it to the fireball index in X register to get the index of
                            	  1988:     ; the coordinate we want within each coordinate list.
                            	  1989:     ;
                            	  1990:     ;
                            	  1991:     ; Pattern
02:0003A572 7600            	  1992:     moveq   #0,D3
02:0003A574 162C000B        	  1993:     move.b  ($000B,A4),D3
02:0003A578 1002            	  1994:     move.b  D2,D0
02:0003A57A 023C00EE        	  1995:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A57E 41F90003A4C0    	  1996:     lea     (StatuePatternToBasePositionIndex).l,A0
02:0003A584 12303000        	  1997:     move.b  (A0,D3.W),D1
02:0003A588 D101            	  1998:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:0003A58A 7600            	  1999:     moveq   #0,D3
02:0003A58C 1600            	  2000:     move.b  D0,D3
02:0003A58E 1002            	  2001:     move.b  D2,D0
02:0003A590 1B00            	  2002:     move.b  D0,-(A5)  ; PHA
                            	  2003:     ; Get Link's coordinates into [00] and [01].
                            	  2004:     ;
02:0003A592 7400            	  2005:     moveq   #0,D2
02:0003A594 4EB90004CD7A    	  2006:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2007:     ; Switch to the new fireball's object slot.
                            	  2008:     ;
02:0003A59A 7400            	  2009:     moveq   #0,D2
02:0003A59C 142C000A        	  2010:     move.b  ($000A,A4),D2
                            	  2011:     ; Look up and set the X coordinate for the fireball object.
                            	  2012:     ; Also store it in [02].
                            	  2013:     ;
02:0003A5A0 41F90003A4C4    	  2014:     lea     (StatueXs).l,A0
02:0003A5A6 10303000        	  2015:     move.b  (A0,D3.W),D0
02:0003A5AA 19400002        	  2016:     move.b  D0,($0002,A4)
02:0003A5AE 19802070        	  2017:     move.b  D0,($70,A4,D2.W)
                            	  2018:     ; Look up and set the Y coordinate for the fireball object.
                            	  2019:     ; Also store it in [03].
                            	  2020:     ;
02:0003A5B2 41F90003A4CC    	  2021:     lea     (StatueYs).l,A0
02:0003A5B8 10303000        	  2022:     move.b  (A0,D3.W),D0
02:0003A5BC 19400003        	  2023:     move.b  D0,($0003,A4)
02:0003A5C0 41EC0084        	  2024:     lea     ($0084,A4),A0
02:0003A5C4 11802000        	  2025:     move.b  D0,(A0,D2.W)
                            	  2026:     ; Set mask value 3 in [04].
                            	  2027:     ;
02:0003A5C8 7003            	  2028:     moveq   #3,D0
02:0003A5CA 19400004        	  2029:     move.b  D0,($0004,A4)
                            	  2030:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  2031:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  2032:     ;
02:0003A5CE 7601            	  2033:     moveq   #1,D3
                            	  2034:     even
                            	  2035: _L_z04_UpdateStatues_LoopAxis:
02:0003A5D0 10343000        	  2036:     move.b  ($00,A4,D3.W),D0
02:0003A5D4 003C0011        	  2037:     ori     #$11,CCR  ; SEC: set C+X
02:0003A5D8 12343002        	  2038:     move.b  ($02,A4,D3.W),D1
02:0003A5DC 0A3C0010        	  2039:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A5E0 9101            	  2040:     subx.b  D1,D0   ; SBC $0002,Y
02:0003A5E2 0A3C0010        	  2041:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A5E6 0C000018        	  2042:     cmpi.b  #$18,D0
02:0003A5EA 6A10            	  2043:     bpl  _anon_z04_31
02:0003A5EC 0C0000E8        	  2044:     cmpi.b  #$E8,D0
02:0003A5F0 6B0A            	  2045:     bmi  _anon_z04_31
02:0003A5F2 122C0004        	  2046:     move.b  ($0004,A4),D1
02:0003A5F6 E209            	  2047:     lsr.b  #1,D1   ; LSR $04
02:0003A5F8 19410004        	  2048:     move.b  D1,($0004,A4)
                            	  2049: _anon_z04_31:
02:0003A5FC 5303            	  2050:     subq.b  #1,D3
02:0003A5FE 6AD0            	  2051:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  2052:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  2053:     ; 0 or 1 time, instead of 2.
                            	  2054:     ;
                            	  2055:     ; This, in turn, means that the distance between Link and the
                            	  2056:     ; fireball was >= $18 in at least one axis.
                            	  2057:     ;
                            	  2058:     ; So, we're OK to finish making the fireball.
                            	  2059:     ;
02:0003A600 102C0004        	  2060:     move.b  ($0004,A4),D0
02:0003A604 6706            	  2061:     beq  _anon_z04_32
02:0003A606 7055            	  2062:     moveq   #85,D0
02:0003A608 6100F826        	  2063:     jsr     ShootFireball
                            	  2064: _anon_z04_32:
02:0003A60C 101D            	  2065:     move.b  (A5)+,D0  ; PLA
02:0003A60E 7400            	  2066:     moveq   #0,D2
02:0003A610 1400            	  2067:     move.b  D0,D2
                            	  2068:     even
                            	  2069: _L_z04_UpdateStatues_NextLoopFireball:
                            	  2070:     ; Bottom of the loop.
                            	  2071:     ; Loop while fireball index >= 0.
                            	  2072:     ;
02:0003A612 5302            	  2073:     subq.b  #1,D2
02:0003A614 6A00FF1A        	  2074:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  2075:     even
