                            	  7910: UpdatePolsVoiceState1_Jumping:
                            	  7911:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7912:     ;
02:0003CFAA 41EC0444        	  7913:     lea     ($0444,A4),A0
02:0003CFAE 10302000        	  7914:     move.b  (A0,D2.W),D0
02:0003CFB2 023C00EE        	  7915:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFB6 123C0038        	  7916:     move.b  #$38,D1
02:0003CFBA D101            	  7917:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003CFBC 41EC0444        	  7918:     lea     ($0444,A4),A0
02:0003CFC0 11802000        	  7919:     move.b  D0,(A0,D2.W)
                            	  7920:     ; Add Carry to high speed byte (vertical).
                            	  7921:     ;
02:0003CFC4 41EC0412        	  7922:     lea     ($0412,A4),A0
02:0003CFC8 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003CFCC 123C0000        	  7924:     move.b  #$00,D1
02:0003CFD0 D101            	  7925:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003CFD2 41EC0412        	  7926:     lea     ($0412,A4),A0
02:0003CFD6 11802000        	  7927:     move.b  D0,(A0,D2.W)
                            	  7928:     ; Add high speed byte to Y coordinate.
                            	  7929:     ;
02:0003CFDA 023C00EE        	  7930:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFDE 41EC0084        	  7931:     lea     ($0084,A4),A0
02:0003CFE2 12302000        	  7932:     move.b  (A0,D2.W),D1
02:0003CFE6 D101            	  7933:     addx.b  D1,D0   ; ADC ObjY,X
02:0003CFE8 41EC0084        	  7934:     lea     ($0084,A4),A0
02:0003CFEC 11802000        	  7935:     move.b  D0,(A0,D2.W)
                            	  7936:     ; If the speed is still negative, then return.
                            	  7937:     ;
02:0003CFF0 41EC0412        	  7938:     lea     ($0412,A4),A0
02:0003CFF4 10302000        	  7939:     move.b  (A0,D2.W),D0
02:0003CFF8 6B0000AC        	  7940:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7941:     ; If Y coordinate still < target Y, then return.
                            	  7942:     ;
02:0003CFFC 41EC0084        	  7943:     lea     ($0084,A4),A0
02:0003D000 10302000        	  7944:     move.b  (A0,D2.W),D0
02:0003D004 41EC042C        	  7945:     lea     ($042C,A4),A0
02:0003D008 12302000        	  7946:     move.b  (A0,D2.W),D1
02:0003D00C B001            	  7947:     cmp.b   D1,D0
02:0003D00E 65000096        	  7948:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7949:     ; Else reached the destination. Go to state 0.
                            	  7950:     ;
02:0003D012 7000            	  7951:     moveq   #0,D0
02:0003D014 41EC00AC        	  7952:     lea     ($00AC,A4),A0
02:0003D018 11802000        	  7953:     move.b  D0,(A0,D2.W)
                            	  7954:     ; Reset 16-bit vertical speed.
                            	  7955:     ;
02:0003D01C 41EC0444        	  7956:     lea     ($0444,A4),A0
02:0003D020 11802000        	  7957:     move.b  D0,(A0,D2.W)
02:0003D024 41EC0412        	  7958:     lea     ($0412,A4),A0
02:0003D028 11802000        	  7959:     move.b  D0,(A0,D2.W)
                            	  7960:     ; Choose a random direction to face in.
                            	  7961:     ;
02:0003D02C 10342018        	  7962:     move.b  ($18,A4,D2.W),D0
02:0003D030 02000003        	  7963:     andi.b #$03,D0
02:0003D034 7600            	  7964:     moveq   #0,D3
02:0003D036 1600            	  7965:     move.b  D0,D3
02:0003D038 41F90003CE48    	  7966:     lea     (PolsVoiceDirections).l,A0
02:0003D03E 10303000        	  7967:     move.b  (A0,D3.W),D0
02:0003D042 41EC0098        	  7968:     lea     ($0098,A4),A0
02:0003D046 11802000        	  7969:     move.b  D0,(A0,D2.W)
                            	  7970:     ; Randomly set distance-to-move to $30 or $70.
                            	  7971:     ;
02:0003D04A 10342018        	  7972:     move.b  ($18,A4,D2.W),D0
02:0003D04E 02000040        	  7973:     andi.b #$40,D0
02:0003D052 123C0030        	  7974:     move.b  #$30,D1
02:0003D056 D101            	  7975:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003D058 41EC0394        	  7976:     lea     ($0394,A4),A0
02:0003D05C 11802000        	  7977:     move.b  D0,(A0,D2.W)
                            	  7978:     ; Align the monster with a square horizontally.
                            	  7979:     ;
                            	  7980:     ; If in the left half of a square, align with that square.
                            	  7981:     ; If in the right half, align with the next square.
                            	  7982:     ;
02:0003D060 10342070        	  7983:     move.b  ($70,A4,D2.W),D0
02:0003D064 023C00EE        	  7984:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D068 123C0008        	  7985:     move.b  #$08,D1
02:0003D06C D101            	  7986:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D06E 020000F0        	  7987:     andi.b #$F0,D0
02:0003D072 19802070        	  7988:     move.b  D0,($70,A4,D2.W)
                            	  7989:     ; Align the monster with a square vertically.
                            	  7990:     ;
                            	  7991:     ; If in the top half of a square, align with that square.
                            	  7992:     ; If in the bottom half, align with the next square.
                            	  7993:     ;
02:0003D076 41EC0084        	  7994:     lea     ($0084,A4),A0
02:0003D07A 10302000        	  7995:     move.b  (A0,D2.W),D0
02:0003D07E 023C00EE        	  7996:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D082 123C0008        	  7997:     move.b  #$08,D1
02:0003D086 D101            	  7998:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D088 020000F0        	  7999:     andi.b #$F0,D0
                            	  8000:     ; Make sure the lower nibble of Y is $D as usual.
                            	  8001:     ;
02:0003D08C 003C0011        	  8002:     ori     #$11,CCR  ; SEC: set C+X
02:0003D090 123C0003        	  8003:     move.b  #$03,D1
02:0003D094 0A3C0010        	  8004:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D098 9101            	  8005:     subx.b  D1,D0   ; SBC #$03
02:0003D09A 0A3C0010        	  8006:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D09E 41EC0084        	  8007:     lea     ($0084,A4),A0
02:0003D0A2 11802000        	  8008:     move.b  D0,(A0,D2.W)
                            	  8009:     even
