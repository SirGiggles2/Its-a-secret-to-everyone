                            	  3232:     ; Set the chase long-timer to a random value between 0 and 7.
                            	  3233:     ;
02:0004B4AE 102C0019        	  3234:     move.b  ($0019,A4),D0
02:0004B4B2 02000007        	  3235:     andi.b #$07,D0
