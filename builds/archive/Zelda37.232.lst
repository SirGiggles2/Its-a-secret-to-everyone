                            	  7002: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  7003:     ; Bloated timer =>
                            	  7004:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  7005:     ; 1:     go advance the substate
                            	  7006:     ; other: go decrement Bloated timer
                            	  7007:     ;
02:0003C970 7600            	  7008:     moveq   #0,D3
02:0003C972 41EC045E        	  7009:     lea     ($045E,A4),A0
02:0003C976 16302000        	  7010:     move.b  (A0,D2.W),D3
02:0003C97A 5303            	  7011:     subq.b  #1,D3
02:0003C97C 6750            	  7012:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003C97E 6B04            	  7013:     bmi.s  __far_z_04_0058
02:0003C980 60000080        	  7014:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  7015: __far_z_04_0058:
                            	  7016:     ; Set the bloated timer according to the substate.
                            	  7017:     ;
02:0003C984 7600            	  7018:     moveq   #0,D3
02:0003C986 41EC042C        	  7019:     lea     ($042C,A4),A0
