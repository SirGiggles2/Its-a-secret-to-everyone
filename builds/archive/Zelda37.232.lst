                            	 12928: GanonFrameImages:
02:0003F4D6 06              	 12929:     dc.b    $06, $08, $07, $09, $00, $00, $01, $01
02:0003F4D7 08
02:0003F4D8 07
02:0003F4D9 09
02:0003F4DA 00
02:0003F4DB 00
02:0003F4DC 01
02:0003F4DD 01
02:0003F4DE 02              	 12930:     dc.b    $02, $02, $03, $03, $04, $00, $05, $01
02:0003F4DF 02
02:0003F4E0 03
02:0003F4E1 03
02:0003F4E2 04
02:0003F4E3 00
02:0003F4E4 05
02:0003F4E5 01
02:0003F4E6 04              	 12931:     dc.b    $04, $04, $05, $05, $00, $04, $01, $05
02:0003F4E7 04
02:0003F4E8 05
02:0003F4E9 05
02:0003F4EA 00
02:0003F4EB 04
