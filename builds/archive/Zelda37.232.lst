                            	  5982: _anon_z05_120:
                            	  5983:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5984:     ;
                            	  5985:     ; Shutters and the commands to open a door always change
                            	  5986:     ; tiles.
                            	  5987:     ;
02:00043832 61000130        	  5988:     jsr     PrepareWriteHorizontalDoorTransferRecords
