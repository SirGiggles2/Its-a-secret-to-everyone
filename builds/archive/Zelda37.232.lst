                            	  8019: PrepFullBlackRow:
                            	  8020:     ; Prepare the dynamic transfer buf with a row of blank ($24) tiles
                            	  8021:     ; to transfer to row (7 + Y).
                            	  8022:     ;
                            	  8023:     ; Calculate PPU address ($28E0 + Y*$20).
                            	  8024:     ;
02:00044BE0 7028            	  8025:     moveq   #40,D0
02:00044BE2 19400302        	  8026:     move.b  D0,($0302,A4)
02:00044BE6 103C00C0        	  8027:     move.b  #$C0,D0
                            	  8028:     even
                            	  8029: _L_z05_PrepFullBlackRow_Add20H:
