02:0003B43A 11802000        	  4168:     move.b  D0,(A0,D2.W)
                            	  4169:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  4170:     ;
02:0003B43E 102C0071        	  4171:     move.b  ($0071,A4),D0
02:0003B442 19802070        	  4172:     move.b  D0,($70,A4,D2.W)
                            	  4173:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  4174:     ;
02:0003B446 102C0085        	  4175:     move.b  ($0085,A4),D0
02:0003B44A 003C0011        	  4176:     ori     #$11,CCR  ; SEC: set C+X
02:0003B44E 123C001C        	  4177:     move.b  #$1C,D1
02:0003B452 0A3C0010        	  4178:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B456 9101            	  4179:     subx.b  D1,D0   ; SBC #$1C
02:0003B458 0A3C0010        	  4180:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B45C 41EC0084        	  4181:     lea     ($0084,A4),A0
02:0003B460 11802000        	  4182:     move.b  D0,(A0,D2.W)
                            	  4183:     even
                            	  4184: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  4185:     ; Decrease the angle by $00.60.
                            	  4186:     ;
02:0003B464 7000            	  4187:     moveq   #0,D0
02:0003B466 1940000B        	  4188:     move.b  D0,($000B,A4)
02:0003B46A 7060            	  4189:     moveq   #96,D0
02:0003B46C 61004A76        	  4190:     jsr     DecreaseObjectAngle
                            	  4191:     ; Rotate the heart's location by the change in angle.
