02:0003DEC8 6408            	  9895:     bcc  _anon_z04_122
02:0003DECA 41EC042C        	  9896:     lea     ($042C,A4),A0
02:0003DECE 53302000        	  9897:     subq.b  #1,(A0,D2.W)
                            	  9898: _anon_z04_122:
                            	  9899:     ; If open eye timer = 0, then the eye is closed.
