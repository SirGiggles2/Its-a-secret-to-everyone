02:0003ECEE 123C0003        	 11784:     move.b  #$03,D1
02:0003ECF2 D101            	 11785:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ECF4 02000007        	 11786:     andi.b #$07,D0
02:0003ECF8 6702            	 11787:     beq.s  __far_z_04_0119
02:0003ECFA 60D8            	 11788:     jmp  L12A6F_Exit
                            	 11789: __far_z_04_0119:
                            	 11790:     ; Will loop 4 times, propagating directions down the chain,
                            	 11791:     ; by pulling from the bottom.
                            	 11792:     ;
02:0003ECFC 7004            	 11793:     moveq   #4,D0
02:0003ECFE 1880            	 11794:     move.b  D0,($0000,A4)
                            	 11795:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11796:     ;
02:0003ED00 7600            	 11797:     moveq   #0,D3
02:0003ED02 0C020005        	 11798:     cmpi.b  #$05,D2
02:0003ED06 6702            	 11799:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003ED08 7605            	 11800:     moveq   #5,D3
                            	 11801:     even
                            	 11802: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11803:     ; Loop over every segment under the head, starting from the tail.
                            	 11804:     ; Copy the next segment's direction to the current one in this loop.
                            	 11805:     ;
02:0003ED0A 41EC009A        	 11806:     lea     ($009A,A4),A0
02:0003ED0E 10303000        	 11807:     move.b  (A0,D3.W),D0
02:0003ED12 41EC0099        	 11808:     lea     ($0099,A4),A0
02:0003ED16 11803000        	 11809:     move.b  D0,(A0,D3.W)
02:0003ED1A 5203            	 11810:     addq.b  #1,D3
02:0003ED1C 5314            	 11811:     subq.b  #1,($0000,A4)
02:0003ED1E 66EA            	 11812:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11813:     ; If this head segment is not aligned with a square, then return.
                            	 11814:     ;
02:0003ED20 10342070        	 11815:     move.b  ($70,A4,D2.W),D0
02:0003ED24 0200000F        	 11816:     andi.b #$0F,D0
02:0003ED28 660000BA        	 11817:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11818:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11819:     ; We had to account for the usual offset of 3.
                            	 11820:     ;
02:0003ED2C 41EC0084        	 11821:     lea     ($0084,A4),A0
02:0003ED30 10302000        	 11822:     move.b  (A0,D2.W),D0
02:0003ED34 023C00EE        	 11823:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ED38 123C0003        	 11824:     move.b  #$03,D1
02:0003ED3C D101            	 11825:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003ED3E 0200000F        	 11826:     andi.b #$0F,D0
02:0003ED42 660000A0        	 11827:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11828:     ; Store the opposite of the facing direction in [00].
                            	 11829:     ;
02:0003ED46 41EC0098        	 11830:     lea     ($0098,A4),A0
02:0003ED4A 10302000        	 11831:     move.b  (A0,D2.W),D0
02:0003ED4E E208            	 11832:     lsr.b  #1,D0   ; LSR A
02:0003ED50 02000005        	 11833:     andi.b #$05,D0
02:0003ED54 1880            	 11834:     move.b  D0,($0000,A4)
02:0003ED56 41EC0098        	 11835:     lea     ($0098,A4),A0
02:0003ED5A 10302000        	 11836:     move.b  (A0,D2.W),D0
02:0003ED5E E308            	 11837:     lsl.b  #1,D0   ; ASL A
02:0003ED60 0200000A        	 11838:     andi.b #$0A,D0
02:0003ED64 1214            	 11839:     move.b  ($0000,A4),D1
02:0003ED66 8001            	 11840:     or.b  D1,D0
                            	 11841:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11842:     ;
02:0003ED68 0A00000F        	 11843:     eori.b #$0F,D0
02:0003ED6C 1940050F        	 11844:     move.b  D0,($050F,A4)
                            	 11845:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11846:     ;
02:0003ED70 10342018        	 11847:     move.b  ($18,A4,D2.W),D0
02:0003ED74 0C000080        	 11848:     cmpi.b  #$80,D0
02:0003ED78 656C            	 11849:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11850:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11851:     ; Load the monster's facing direction.
                            	 11852:     ;
02:0003ED7A 41EC0098        	 11853:     lea     ($0098,A4),A0
02:0003ED7E 10302000        	 11854:     move.b  (A0,D2.W),D0
                            	 11855:     ; Load the next random number into Y register.
                            	 11856:     ;
02:0003ED82 7600            	 11857:     moveq   #0,D3
02:0003ED84 16342019        	 11858:     move.b  ($19,A4,D2.W),D3
                            	 11859:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11860:     ; to keep moving straight.
                            	 11861:     ;
02:0003ED88 0C030080        	 11862:     cmpi.b  #$80,D3
02:0003ED8C 6418            	 11863:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11864:     even
                            	 11865: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11866:     ; Loop to rotate the direction bit over the mask.
                            	 11867:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11868:     ; facing direction.
                            	 11869:     ;
                            	 11870:     ; Shift right the copy of the direction.
                            	 11871:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11872:     ;
02:0003ED8E E208            	 11873:     lsr.b  #1,D0   ; LSR A
02:0003ED90 6402            	 11874:     bcc  _anon_z04_151
02:0003ED92 7008            	 11875:     moveq   #8,D0
                            	 11876: _anon_z04_151:
                            	 11877:     ; If the current direction bit is masked off, then we've reached
                            	 11878:     ; the opposite direction. Loop again.
                            	 11879:     ;
02:0003ED94 122C050F        	 11880:     move.b  ($050F,A4),D1
02:0003ED98 C200            	 11881:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003ED9A 67F2            	 11882:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11883:     ; If Y register >= $40, then break out of the loop.
                            	 11884:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11885:     ;
02:0003ED9C 0C030040        	 11886:     cmpi.b  #$40,D3
02:0003EDA0 6404            	 11887:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11888:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11889:     ; and loop again now.
                            	 11890:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11891:     ;
02:0003EDA2 7640            	 11892:     moveq   #64,D3
02:0003EDA4 65E8            	 11893:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11894:     even
                            	 11895: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11896:     ; Change the facing direction to the direction found.
                            	 11897:     ;
02:0003EDA6 41EC0098        	 11898:     lea     ($0098,A4),A0
02:0003EDAA 11802000        	 11899:     move.b  D0,(A0,D2.W)
                            	 11900:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11901:     ;
02:0003EDAE 1940000F        	 11902:     move.b  D0,($000F,A4)
02:0003EDB2 4EB900030BE8    	 11903:     jsr     BoundByRoom
                            	 11904:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11905:     ;
02:0003EDB8 102C000F        	 11906:     move.b  ($000F,A4),D0
02:0003EDBC 6618            	 11907:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11908:     even
                            	 11909: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11910:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11911:     ; for looking for any non-opposite direction that is not blocked.
                            	 11912:     ;
02:0003EDBE 41EC0098        	 11913:     lea     ($0098,A4),A0
02:0003EDC2 10302000        	 11914:     move.b  (A0,D2.W),D0
                            	 11915:     even
                            	 11916: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11917:     ; Shift right the copy of the direction.
                            	 11918:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11919:     ;
02:0003EDC6 E208            	 11920:     lsr.b  #1,D0   ; LSR A
02:0003EDC8 6402            	 11921:     bcc  _anon_z04_152
02:0003EDCA 7008            	 11922:     moveq   #8,D0
                            	 11923: _anon_z04_152:
                            	 11924:     ; If the current direction bit is not masked off, then go check the
                            	 11925:     ; room boundary in this direction.
                            	 11926:     ; Else we've reached the opposite direction. Loop again.
                            	 11927:     ;
02:0003EDCC 122C050F        	 11928:     move.b  ($050F,A4),D1
02:0003EDD0 C200            	 11929:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EDD2 66D2            	 11930:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003EDD4 67F0            	 11931:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11932:     even
                            	 11933: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11934:     ; We found a direction that was not blocked by the room boundary.
                            	 11935:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11936:     ;
02:0003EDD6 4EB90004B68A    	 11937:     jsr     GetCollidingTileMoving
02:0003EDDC 122C034A        	 11938:     move.b  ($034A,A4),D1
02:0003EDE0 B001            	 11939:     cmp.b   D1,D0
02:0003EDE2 64DA            	 11940:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11941:     even
                            	 11942: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11943:     ; TODO: confirm this
                            	 11944:     ;
                            	 11945:     ; If there were a room that had lamnolas, and they could get
                            	 11946:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11947:     ; an infinite loop.
                            	 11948:     ;
                            	 11949:     ; But, the only room with that configuration has those blocks
                            	 11950:     ; blocked off with a push block, which can only be pushed after
                            	 11951:     ; all monsters are killed.
                            	 11952:     ;
02:0003EDE4 4E75            	 11953:     rts
                            	 11954: 
                            	 11955:     even
                            	 11956: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11957:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11958:     ;
02:0003EDE6 7001            	 11959:     moveq   #1,D0
02:0003EDE8 19400002        	 11960:     move.b  D0,($0002,A4)
02:0003EDEC 102C0070        	 11961:     move.b  ($0070,A4),D0
02:0003EDF0 003C0011        	 11962:     ori     #$11,CCR  ; SEC: set C+X
02:0003EDF4 12342070        	 11963:     move.b  ($70,A4,D2.W),D1
02:0003EDF8 0A3C0010        	 11964:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EDFC 9101            	 11965:     subx.b  D1,D0   ; SBC ObjX,X
02:0003EDFE 0A3C0010        	 11966:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE02 640A            	 11967:     bcc  _anon_z04_153
02:0003EE04 122C0002        	 11968:     move.b  ($0002,A4),D1
02:0003EE08 E309            	 11969:     lsl.b  #1,D1   ; ASL $02
02:0003EE0A 19410002        	 11970:     move.b  D1,($0002,A4)
                            	 11971: _anon_z04_153:
                            	 11972:     ; Find the vertical direction toward Link and store it in [03].
                            	 11973:     ;
02:0003EE0E 7004            	 11974:     moveq   #4,D0
02:0003EE10 19400003        	 11975:     move.b  D0,($0003,A4)
02:0003EE14 102C0084        	 11976:     move.b  ($0084,A4),D0
02:0003EE18 003C0011        	 11977:     ori     #$11,CCR  ; SEC: set C+X
02:0003EE1C 41EC0084        	 11978:     lea     ($0084,A4),A0
02:0003EE20 12302000        	 11979:     move.b  (A0,D2.W),D1
02:0003EE24 0A3C0010        	 11980:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003EE28 9101            	 11981:     subx.b  D1,D0   ; SBC ObjY,X
02:0003EE2A 0A3C0010        	 11982:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EE2E 640A            	 11983:     bcc  _anon_z04_154
02:0003EE30 122C0003        	 11984:     move.b  ($0003,A4),D1
02:0003EE34 E309            	 11985:     lsl.b  #1,D1   ; ASL $03
02:0003EE36 19410003        	 11986:     move.b  D1,($0003,A4)
                            	 11987: _anon_z04_154:
                            	 11988:     ; If the horizontal direction toward Link is not allowed, then
                            	 11989:     ; go check the vertical direction.
                            	 11990:     ;
02:0003EE3A 102C0002        	 11991:     move.b  ($0002,A4),D0
02:0003EE3E 122C050F        	 11992:     move.b  ($050F,A4),D1
02:0003EE42 C200            	 11993:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE44 6708            	 11994:     beq  _L_z04_Lamnola_UpdateHead_SetVertical
                            	 11995:     ; If the horizontal direction toward Link is the same direction
                            	 11996:     ; that Link is facing, then go test it for tile and room boundary collision.
                            	 11997:     ;
02:0003EE46 122C0098        	 11998:     move.b  ($0098,A4),D1
02:0003EE4A C200            	 11999:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE4C 6604            	 12000:     bne  _anon_z04_155
                            	 12001:     even
                            	 12002: _L_z04_Lamnola_UpdateHead_SetVertical:
                            	 12003:     ; Load the vertical direction toward Link in order to test it for
                            	 12004:     ; room boundary and tile collision.
                            	 12005:     ;
02:0003EE4E 102C0003        	 12006:     move.b  ($0003,A4),D0
                            	 12007: _anon_z04_155:
                            	 12008:     ; Go test this direction for collisions with tiles or the room boundary.
                            	 12009:     ;
02:0003EE52 6000FF52        	 12010:     jmp     _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
