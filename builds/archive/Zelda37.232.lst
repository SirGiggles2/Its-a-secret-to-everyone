02:0003C6C8 5203            	  6633:     addq.b  #1,D3
02:0003C6CA 41EC0098        	  6634:     lea     ($0098,A4),A0
02:0003C6CE 11832000        	  6635:     move.b  D3,(A0,D2.W)
