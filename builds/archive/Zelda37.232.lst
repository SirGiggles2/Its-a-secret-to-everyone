                            	  5130: _L_z04_L_Wallmaster_State1_PatchSprites:
02:0003BB66 19400001        	  5131:     move.b  D0,($0001,A4)
02:0003BB6A 61000104        	  5132:     jsr     Wallmaster_PutSpritesBehindBgIfNeeded
                            	  5133:     ; The default image is the hand open.
                            	  5134:     ; If animation frame = 0, then return.
                            	  5135:     ;
02:0003BB6E 7400            	  5136:     moveq   #0,D2
02:0003BB70 142C0340        	  5137:     move.b  ($0340,A4),D2
02:0003BB74 41EC03E4        	  5138:     lea     ($03E4,A4),A0
02:0003BB78 10302000        	  5139:     move.b  (A0,D2.W),D0
02:0003BB7C 6724            	  5140:     beq  _L_z04_L_Wallmaster_State1_Exit
                            	  5141:     ; Animation frame 1 uses Wallmaster frame image 1, which
                            	  5142:     ; uses tiles $9C/$9D on the left and $9E/$9F on the right.
                            	  5143:     ; The right side is correctly the right side of a closed hand.
                            	  5144:     ; But the left side is Keese. So, we have to patch the left
                            	  5145:     ; side to use the common left side of the hand -- $AC/$AD.
                            	  5146:     ;
                            	  5147:     ; Keep in mind that left and right sprites might be flipped.
                            	  5148:     ;
02:0003BB7E 7600            	  5149:     moveq   #0,D3
02:0003BB80 1614            	  5150:     move.b  ($0000,A4),D3
02:0003BB82 41EC0201        	  5151:     lea     ($0201,A4),A0
02:0003BB86 10303000        	  5152:     move.b  (A0,D3.W),D0
02:0003BB8A 0C00009C        	  5153:     cmpi.b  #$9C,D0
02:0003BB8E 6706            	  5154:     beq  _anon_z04_68
02:0003BB90 7600            	  5155:     moveq   #0,D3
02:0003BB92 162C0001        	  5156:     move.b  ($0001,A4),D3
                            	  5157: _anon_z04_68:
02:0003BB96 103C00AC        	  5158:     move.b  #$AC,D0
