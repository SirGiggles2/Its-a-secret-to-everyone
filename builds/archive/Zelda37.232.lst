                            	  9868: _L_z04_UpdateGohma_AnimateEye:
                            	  9869:     ; Animate the eye.
                            	  9870:     ;
                            	  9871:     ; First, if the counter for when to open the eye next = 0, then
                            	  9872:     ; set it to a random value at least $C0; and set the timer for
                            	  9873:     ; keeping the eye open to $80.
                            	  9874:     ;
                            	  9875:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9876:     ; every other frame.
                            	  9877:     ;
02:0003DE9A 41EC042C        	  9878:     lea     ($042C,A4),A0
02:0003DE9E 10302000        	  9879:     move.b  (A0,D2.W),D0
02:0003DEA2 661E            	  9880:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEA4 103C0080        	  9881:     move.b  #$80,D0
02:0003DEA8 41EC0444        	  9882:     lea     ($0444,A4),A0
02:0003DEAC 11802000        	  9883:     move.b  D0,(A0,D2.W)
02:0003DEB0 103C00C0        	  9884:     move.b  #$C0,D0
02:0003DEB4 12342018        	  9885:     move.b  ($18,A4,D2.W),D1
02:0003DEB8 8001            	  9886:     or.b  D1,D0
02:0003DEBA 41EC042C        	  9887:     lea     ($042C,A4),A0
02:0003DEBE 11802000        	  9888:     move.b  D0,(A0,D2.W)
                            	  9889:     even
