                            	  5034: SpreadShot:
                            	  5035:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5036:     ;
                            	  5037:     ; The shot is spreading out.
                            	  5038:     ;
                            	  5039:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5040:     ; These will be negated appropriately for each corner.
                            	  5041:     ;
02:0004C070 41EC0098        	  5042:     lea     ($0098,A4),A0
02:0004C074 10302000        	  5043:     move.b  (A0,D2.W),D0
02:0004C078 19400002        	  5044:     move.b  D0,($0002,A4)
02:0004C07C 19400003        	  5045:     move.b  D0,($0003,A4)
                            	  5046:     ; Reset [0F] to not flip horizontally.
                            	  5047:     ;
02:0004C080 7000            	  5048:     moveq   #0,D0
02:0004C082 1940000F        	  5049:     move.b  D0,($000F,A4)
                            	  5050:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5051:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5052:     ;
02:0004C086 7603            	  5053:     moveq   #3,D3
                            	  5054:     even
                            	  5055: _L_z07_SpreadShot_DrawShotCorner:
02:0004C088 1003            	  5056:     move.b  D3,D0
02:0004C08A 1B00            	  5057:     move.b  D0,-(A5)  ; PHA
                            	  5058:     ; Save offset X [02] and Y offset [03].
                            	  5059:     ;
02:0004C08C 102C0002        	  5060:     move.b  ($0002,A4),D0
02:0004C090 1B00            	  5061:     move.b  D0,-(A5)  ; PHA
02:0004C092 102C0003        	  5062:     move.b  ($0003,A4),D0
02:0004C096 1B00            	  5063:     move.b  D0,-(A5)  ; PHA
                            	  5064:     ; Calculate and set sprite attributes for this corner:
                            	  5065:     ;   base attribute OR (frame counter AND 3)
                            	  5066:     ;
                            	  5067:     ; The base attribute defines how to flip the sprite.
                            	  5068:     ; The frame counter makes the shot flash by cycling each
                            	  5069:     ; palette row.
                            	  5070:     ;
02:0004C098 102C0015        	  5071:     move.b  ($0015,A4),D0
02:0004C09C 02000003        	  5072:     andi.b #$03,D0
02:0004C0A0 41F90004BEFE    	  5073:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004C0A6 12303000        	  5074:     move.b  (A0,D3.W),D1
02:0004C0AA 8001            	  5075:     or.b  D1,D0
02:0004C0AC 4EB900031B28    	  5076:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5077:     ; Add the object's X (the center of the spread) and the
                            	  5078:     ; current offset in [02] to set sprite X in [00].
                            	  5079:     ;
02:0004C0B2 10342070        	  5080:     move.b  ($70,A4,D2.W),D0
02:0004C0B6 023C00EE        	  5081:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C0BA 122C0002        	  5082:     move.b  ($0002,A4),D1
02:0004C0BE D101            	  5083:     addx.b  D1,D0   ; ADC $02
02:0004C0C0 1880            	  5084:     move.b  D0,($0000,A4)
                            	  5085:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5086:     ; Else calculate the distance from object X to sprite X.
                            	  5087:     ;
02:0004C0C2 12342070        	  5088:     move.b  ($70,A4,D2.W),D1
02:0004C0C6 B001            	  5089:     cmp.b   D1,D0
02:0004C0C8 651A            	  5090:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C0CA 0C0000FC        	  5091:     cmpi.b  #$FC,D0
02:0004C0CE 6466            	  5092:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C0D0 003C0011        	  5093:     ori     #$11,CCR  ; SEC: set C+X
02:0004C0D4 12342070        	  5094:     move.b  ($70,A4,D2.W),D1
02:0004C0D8 0A3C0010        	  5095:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C0DC 9101            	  5096:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C0DE 0A3C0010        	  5097:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C0E2 6014            	  5098:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5099: 
                            	  5100:     even
                            	  5101: _L_z07_SpreadShot_ReverseSub:
02:0004C0E4 10342070        	  5102:     move.b  ($70,A4,D2.W),D0
02:0004C0E8 003C0011        	  5103:     ori     #$11,CCR  ; SEC: set C+X
02:0004C0EC 1214            	  5104:     move.b  ($0000,A4),D1
02:0004C0EE 0A3C0010        	  5105:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C0F2 9101            	  5106:     subx.b  D1,D0   ; SBC $00
02:0004C0F4 0A3C0010        	  5107:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5108:     even
                            	  5109: _L_z07_SpreadShot_CheckDistance:
                            	  5110:     ; If distance >= $20, skip this corner.
                            	  5111:     ;
02:0004C0F8 0C000020        	  5112:     cmpi.b  #$20,D0
02:0004C0FC 6438            	  5113:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5114:     ; Add the object's Y (the center of the spread) and the
                            	  5115:     ; current offset in [03] to set sprite Y in [01].
                            	  5116:     ;
02:0004C0FE 41EC0084        	  5117:     lea     ($0084,A4),A0
02:0004C102 10302000        	  5118:     move.b  (A0,D2.W),D0
02:0004C106 023C00EE        	  5119:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C10A 122C0003        	  5120:     move.b  ($0003,A4),D1
02:0004C10E D101            	  5121:     addx.b  D1,D0   ; ADC $03
02:0004C110 19400001        	  5122:     move.b  D0,($0001,A4)
                            	  5123:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5124:     ;
02:0004C114 7600            	  5125:     moveq   #0,D3
02:0004C116 162C0010        	  5126:     move.b  ($0010,A4),D3
02:0004C11A 670C            	  5127:     beq  _L_z07_SpreadShot_Draw
02:0004C11C 0C00003E        	  5128:     cmpi.b  #$3E,D0
02:0004C120 6514            	  5129:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C122 0C0000E8        	  5130:     cmpi.b  #$E8,D0
02:0004C126 640E            	  5131:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5132:     even
                            	  5133: _L_z07_SpreadShot_Draw:
                            	  5134:     ; Draw the corner.
                            	  5135:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5136:     ;
02:0004C128 7002            	  5137:     moveq   #2,D0
02:0004C12A 1940000C        	  5138:     move.b  D0,($000C,A4)
02:0004C12E 7623            	  5139:     moveq   #35,D3
02:0004C130 4EB900031A48    	  5140:     jsr     Anim_WriteItemSprites
                            	  5141:     even
                            	  5142: _L_z07_SpreadShot_NextCorner:
                            	  5143:     ; Prepare to process the next corner.
                            	  5144:     ;
                            	  5145:     ; First, restore X offset [02] and Y offset [03].
                            	  5146:     ;
02:0004C136 101D            	  5147:     move.b  (A5)+,D0  ; PLA
02:0004C138 19400003        	  5148:     move.b  D0,($0003,A4)
02:0004C13C 101D            	  5149:     move.b  (A5)+,D0  ; PLA
02:0004C13E 19400002        	  5150:     move.b  D0,($0002,A4)
                            	  5151:     ; Take turns negating X offset or Y offset for the next round.
                            	  5152:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5153:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5154:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5155:     ; - Fourth turn: doesn't matter
                            	  5156:     ;
                            	  5157:     ;
                            	  5158:     ; Get the loop index.
02:0004C142 101D            	  5159:     move.b  (A5)+,D0  ; PLA
02:0004C144 1B00            	  5160:     move.b  D0,-(A5)  ; PHA
02:0004C146 7600            	  5161:     moveq   #0,D3
02:0004C148 1600            	  5162:     move.b  D0,D3
02:0004C14A 0C030001        	  5163:     cmpi.b  #$01,D3
02:0004C14E 6602            	  5164:     bne  _anon_z07_25
02:0004C150 7603            	  5165:     moveq   #3,D3
                            	  5166: _anon_z07_25:
02:0004C152 10343000        	  5167:     move.b  ($00,A4,D3.W),D0
02:0004C156 4600            	  5168:     eori.b #$FF,D0
02:0004C158 023C00EE        	  5169:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C15C 123C0001        	  5170:     move.b  #$01,D1
02:0004C160 D101            	  5171:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C162 19803000        	  5172:     move.b  D0,($00,A4,D3.W)
                            	  5173:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5174:     ;
02:0004C166 101D            	  5175:     move.b  (A5)+,D0  ; PLA
02:0004C168 7600            	  5176:     moveq   #0,D3
02:0004C16A 1600            	  5177:     move.b  D0,D3
02:0004C16C 5303            	  5178:     subq.b  #1,D3
02:0004C16E 6A00FF18        	  5179:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5180:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5181:     ;
                            	  5182:     ; Decrease the base negative offset to get farther away from
                            	  5183:     ; the center point.
                            	  5184:     ;
02:0004C172 41EC0098        	  5185:     lea     ($0098,A4),A0
02:0004C176 53302000        	  5186:     subq.b  #1,(A0,D2.W)
                            	  5187:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5188:     ;
                            	  5189:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5190:     ;
02:0004C17A 41EC0098        	  5191:     lea     ($0098,A4),A0
02:0004C17E 10302000        	  5192:     move.b  (A0,D2.W),D0
02:0004C182 0C0000E8        	  5193:     cmpi.b  #$E8,D0
02:0004C186 6702            	  5194:     beq.s  __far_z_07_0078
02:0004C188 6004            	  5195:     jmp  L1F49F_Exit
                            	  5196: __far_z_07_0078:
02:0004C18A 6000FED2        	  5197:     jmp     DeactivateLinkShot
                            	  5198: 
                            	  5199:     even
                            	  5200: L1F49F_Exit:
