02:0004C502 41EC00AC        	  5731:     lea     ($00AC,A4),A0
02:0004C506 11803000        	  5732:     move.b  D0,(A0,D3.W)
02:0004C50A 0A3C0001        	  5733:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C50E 4E75            	  5734:     rts
                            	  5735: 
                            	  5736:     even
