                            	  5990: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5991:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5992:     ; We need to remember how many tiles need to be copied
                            	  5993:     ; in each transfer record.
                            	  5994:     ;
02:00043836 102C0006        	  5995:     move.b  ($0006,A4),D0
02:0004383A 19400004        	  5996:     move.b  D0,($0004,A4)
                            	  5997:     ; Write the transfer record header for the door.
                            	  5998:     ;
                            	  5999:     ;
                            	  6000:     ; VRAM address high byte of door
02:0004383E 1014            	  6001:     move.b  ($0000,A4),D0
02:00043840 41EC0302        	  6002:     lea     ($0302,A4),A0
02:00043844 11802000        	  6003:     move.b  D0,(A0,D2.W)
02:00043848 5202            	  6004:     addq.b  #1,D2
02:0004384A 102C0001        	  6005:     move.b  ($0001,A4),D0
02:0004384E 41EC0302        	  6006:     lea     ($0302,A4),A0
02:00043852 11802000        	  6007:     move.b  D0,(A0,D2.W)
02:00043856 5202            	  6008:     addq.b  #1,D2
02:00043858 102C0006        	  6009:     move.b  ($0006,A4),D0
02:0004385C 41EC0302        	  6010:     lea     ($0302,A4),A0
02:00043860 11802000        	  6011:     move.b  D0,(A0,D2.W)
02:00043864 5202            	  6012:     addq.b  #1,D2
                            	  6013: _anon_z05_121:
                            	  6014:     ; Write two tiles in a short loop indexed by [04].
                            	  6015:     ;
02:00043866 6100ED1C        	  6016:     jsr     WriteDoorFaceTileHorizontally
02:0004386A 66FA            	  6017:     bne  _anon_z05_121
                            	  6018:     ; OR the low VRAM address with $20 to go down one row
                            	  6019:     ; in order to work on the second row of door tiles.
                            	  6020:     ;
02:0004386C 7020            	  6021:     moveq   #32,D0
02:0004386E 122C0001        	  6022:     move.b  ($0001,A4),D1
02:00043872 8001            	  6023:     or.b  D1,D0
02:00043874 19400001        	  6024:     move.b  D0,($0001,A4)
                            	  6025:     ; Bottom of the loop.
                            	  6026:     ; Loop again to write the second transfer record for the
                            	  6027:     ; second pair of door tiles, if [05] has not reached 0.
                            	  6028:     ;
02:00043878 532C0005        	  6029:     subq.b  #1,($0005,A4)
02:0004387C 66B8            	  6030:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  6031:     ; Write the end marker, and update buffer length.
                            	  6032:     ;
02:0004387E 103C00FF        	  6033:     move.b  #$FF,D0
02:00043882 41EC0302        	  6034:     lea     ($0302,A4),A0
02:00043886 11802000        	  6035:     move.b  D0,(A0,D2.W)
02:0004388A 1002            	  6036:     move.b  D2,D0
02:0004388C 19400301        	  6037:     move.b  D0,($0301,A4)
                            	  6038:     ; Increment the command.
                            	  6039:     ;
02:00043890 522C0054        	  6040:     addq.b  #1,($0054,A4)
                            	  6041:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  6042:     ; and resetting the door command.
                            	  6043:     ; This ends up catching original states 3 and 7.
                            	  6044:     ;
                            	  6045:     ; Else set door timer to 8 and return.
                            	  6046:     ;
02:00043894 102C0054        	  6047:     move.b  ($0054,A4),D0
02:00043898 02000003        	  6048:     andi.b #$03,D0
02:0004389C 6708            	  6049:     beq  _anon_z05_122
02:0004389E 7008            	  6050:     moveq   #8,D0
02:000438A0 19400027        	  6051:     move.b  D0,($0027,A4)
02:000438A4 4E75            	  6052:     rts
                            	  6053: 
                            	  6054: _anon_z05_122:
                            	  6055:     ; If the door command = 4 after incrementing it, then
                            	  6056:     ; it was 3 (close door). So:
                            	  6057:     ; 1. reset this door's flag
                            	  6058:     ; 2. remove it from the opened door mask
                            	  6059:     ; 3. reset the door command
                            	  6060:     ; 4. go lay out doors in the play area map
                            	  6061:     ;
02:000438A6 102C0054        	  6062:     move.b  ($0054,A4),D0
02:000438AA 0C000004        	  6063:     cmpi.b  #$04,D0
02:000438AE 6626            	  6064:     bne  _anon_z05_123
02:000438B0 7400            	  6065:     moveq   #0,D2
02:000438B2 142C0009        	  6066:     move.b  ($0009,A4),D2
02:000438B6 6100DB88        	  6067:     jsr     ResetDoorFlag
02:000438BA 102C0055        	  6068:     move.b  ($0055,A4),D0
02:000438BE 0A00000F        	  6069:     eori.b #$0F,D0
02:000438C2 122C00EE        	  6070:     move.b  ($00EE,A4),D1
02:000438C6 C001            	  6071:     and.b  D1,D0
                            	  6072:     even
                            	  6073: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:000438C8 194000EE        	  6074:     move.b  D0,($00EE,A4)
                            	  6075:     even
                            	  6076: L_ResetDoorCmdAndLayOutDoors:
02:000438CC 7000            	  6077:     moveq   #0,D0
02:000438CE 19400054        	  6078:     move.b  D0,($0054,A4)
02:000438D2 6000FCD4        	  6079:     jmp     LayOutDoors
                            	  6080: 
                            	  6081: _anon_z05_123:
                            	  6082:     ; Door command <> 4.
                            	  6083:     ; It must be 8, which means it was 7: open door.
                            	  6084:     ;
                            	  6085:     ; If the door is a shutter (7), then go add the door to the
                            	  6086:     ; opened door mask, reset door command, and lay out doors.
                            	  6087:     ;
02:000438D6 102C0055        	  6088:     move.b  ($0055,A4),D0
02:000438DA 19400002        	  6089:     move.b  D0,($0002,A4)
02:000438DE 6100FA32        	  6090:     jsr     FindDoorAttrByDoorBit
02:000438E2 0C000007        	  6091:     cmpi.b  #$07,D0
02:000438E6 676E            	  6092:     beq  _anon_z05_124
                            	  6093:     ; Else the door is not a shutter.
                            	  6094:     ;
                            	  6095:     ;
                            	  6096:     ; [09] door direction index
02:000438E8 7400            	  6097:     moveq   #0,D2
02:000438EA 142C0009        	  6098:     move.b  ($0009,A4),D2
02:000438EE 6100DB4A        	  6099:     jsr     SetDoorFlag
                            	  6100:     ; Get the next room's ID.
                            	  6101:     ;
02:000438F2 1003            	  6102:     move.b  D3,D0
02:000438F4 023C00EE        	  6103:     andi    #$EE,CCR  ; CLC: clear C+X
02:000438F8 41F9000437B4    	  6104:     lea     (DoorNextRoomIdOffsets).l,A0
02:000438FE 12302000        	  6105:     move.b  (A0,D2.W),D1
02:00043902 D101            	  6106:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00043904 7600            	  6107:     moveq   #0,D3
02:00043906 1600            	  6108:     move.b  D0,D3
                            	  6109:     ; Flip the door direction index.
                            	  6110:     ;
02:00043908 1002            	  6111:     move.b  D2,D0
02:0004390A 0A000001        	  6112:     eori.b #$01,D0
02:0004390E 7400            	  6113:     moveq   #0,D2
02:00043910 1400            	  6114:     move.b  D0,D2
                            	  6115:     ; Set the door flag for the opposite door in the next room.
                            	  6116:     ;
02:00043912 1214            	  6117:     move.b  ($00,A4),D1   ; ptr lo
02:00043914 182C0001        	  6118:     move.b  ($01,A4),D4  ; ptr hi
02:00043918 024100FF        	  6119:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004391C E14C            	  6120:     lsl.w   #8,D4
02:0004391E 8841            	  6121:     or.w    D1,D4             ; D4 = NES ptr addr
02:00043920 48C4            	  6122:     ext.l   D4
02:00043922 D8BC00FF0000    	  6123:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043928 2044            	  6124:     movea.l D4,A0
02:0004392A 10303000        	  6125:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004392E 41F90004AAC2    	  6126:     lea     (LevelMasks).l,A0
02:00043934 12302000        	  6127:     move.b  (A0,D2.W),D1
02:00043938 8001            	  6128:     or.b  D1,D0
02:0004393A 1214            	  6129:     move.b  ($00,A4),D1   ; ptr lo
02:0004393C 182C0001        	  6130:     move.b  ($01,A4),D4  ; ptr hi
02:00043940 024100FF        	  6131:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043944 E14C            	  6132:     lsl.w   #8,D4
02:00043946 8841            	  6133:     or.w    D1,D4
02:00043948 48C4            	  6134:     ext.l   D4
02:0004394A D8BC00FF0000    	  6135:     add.l   #NES_RAM,D4
02:00043950 2044            	  6136:     movea.l D4,A0
02:00043952 11803000        	  6137:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  6138: _anon_z05_124:
                            	  6139:     ; Add the door to the opened door mask, reset door command,
                            	  6140:     ; and lay out doors.
                            	  6141:     ;
02:00043956 102C0055        	  6142:     move.b  ($0055,A4),D0
02:0004395A 122C00EE        	  6143:     move.b  ($00EE,A4),D1
02:0004395E 8001            	  6144:     or.b  D1,D0
02:00043960 6000FF66        	  6145:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  6146: 
                            	  6147: ; Params:
                            	  6148: ; [08]: 0 if closed
                            	  6149: ;
                            	  6150: ; Returns:
                            	  6151: ; X: current length of dynamic transfer buf
                            	  6152: ; [00]: door VRAM address high byte
                            	  6153: ; [01]: door VRAM address low byte
                            	  6154: ; [02:03]: address of door tiles for direction and face
                            	  6155: ; [05]: 2, the number of transfer records to write
                            	  6156: ; [06]: 2, the number of tiles in each record
                            	  6157: ; [07]: 0, the first index of a tile to transfer
                            	  6158: ; [09]: door direction index
                            	  6159: ;
                            	  6160: ; Note that this routine is called with triggered doors:
                            	  6161: ; doors that can change state. Their door type numbers are >= 4.
                            	  6162: ;
                            	  6163: ; If this routine were ever called with a fixed door
                            	  6164: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  6165: ; values for the door face.
                            	  6166: ;
                            	  6167: ;
                            	  6168: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  6169: ;
                            	  6170:     even
                            	  6171: PrepareWriteHorizontalDoorTransferRecords:
02:00043964 102C0055        	  6172:     move.b  ($0055,A4),D0
02:00043968 19400002        	  6173:     move.b  D0,($0002,A4)
02:0004396C 6100F9A4        	  6174:     jsr     FindDoorAttrByDoorBit
02:00043970 0C000005        	  6175:     cmpi.b  #$05,D0
02:00043974 650C            	  6176:     bcs  _anon_z05_125
02:00043976 1B00            	  6177:     move.b  D0,-(A5)  ; PHA
02:00043978 7004            	  6178:     moveq   #4,D0
02:0004397A 4EB90003084E    	  6179:     jsr     PlaySample
02:00043980 101D            	  6180:     move.b  (A5)+,D0  ; PLA
                            	  6181: _anon_z05_125:
                            	  6182:     ; Calculate the door face index in three parts.
                            	  6183:     ;
                            	  6184:     ; First, turn door type 4 into 8, and 1 into 4
                            	  6185:     ; (provisional face index in Y register).
                            	  6186:     ;
02:00043982 0C000004        	  6187:     cmpi.b  #$04,D0
02:00043986 6602            	  6188:     bne  _anon_z05_126
02:00043988 7008            	  6189:     moveq   #8,D0
                            	  6190: _anon_z05_126:
02:0004398A 0C000001        	  6191:     cmpi.b  #$01,D0
02:0004398E 6602            	  6192:     bne  _anon_z05_127
02:00043990 7004            	  6193:     moveq   #4,D0
                            	  6194: _anon_z05_127:
                            	  6195:     ; Second, subtract 3 from provisional face index.
                            	  6196:     ;
02:00043992 003C0011        	  6197:     ori     #$11,CCR  ; SEC: set C+X
02:00043996 123C0003        	  6198:     move.b  #$03,D1
02:0004399A 0A3C0010        	  6199:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004399E 9101            	  6200:     subx.b  D1,D0   ; SBC #$03
02:000439A0 0A3C0010        	  6201:     eori    #$10,CCR  ; restore X = 6502 C
02:000439A4 7600            	  6202:     moveq   #0,D3
02:000439A6 1600            	  6203:     move.b  D0,D3
                            	  6204:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  6205:     ; face index >= 3, then subtract 1 from it.
                            	  6206:     ;
                            	  6207:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  6208:     ; then make it 1.
                            	  6209:     ;
02:000439A8 102C0008        	  6210:     move.b  ($0008,A4),D0
02:000439AC 6708            	  6211:     beq  _anon_z05_128
02:000439AE 0C030005        	  6212:     cmpi.b  #$05,D3
02:000439B2 670A            	  6213:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439B4 7601            	  6214:     moveq   #1,D3
                            	  6215: _anon_z05_128:
02:000439B6 0C030003        	  6216:     cmpi.b  #$03,D3
02:000439BA 6502            	  6217:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439BC 5303            	  6218:     subq.b  #1,D3
                            	  6219:     even
                            	  6220: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6221:     ; The routine that returned the door type also returned its
                            	  6222:     ; reverse direction index in [03].
                            	  6223:     ;
                            	  6224:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6225:     ;
02:000439BE 7003            	  6226:     moveq   #3,D0
02:000439C0 003C0011        	  6227:     ori     #$11,CCR  ; SEC: set C+X
02:000439C4 122C0003        	  6228:     move.b  ($0003,A4),D1
02:000439C8 0A3C0010        	  6229:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439CC 9101            	  6230:     subx.b  D1,D0   ; SBC $03
02:000439CE 0A3C0010        	  6231:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6232:     ; Call this to put the address of door face tiles in [02:03].
                            	  6233:     ;
02:000439D2 6100FD7A        	  6234:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6235:     ; Return the address of the door in the nametable in [01:00].
                            	  6236:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6237:     ;
02:000439D6 41F9000437AC    	  6238:     lea     (DoorVramAddrsHi).l,A0
02:000439DC 10302000        	  6239:     move.b  (A0,D2.W),D0
02:000439E0 1880            	  6240:     move.b  D0,($0000,A4)
02:000439E2 41F9000437B0    	  6241:     lea     (DoorVramAddrsLo).l,A0
02:000439E8 10302000        	  6242:     move.b  (A0,D2.W),D0
02:000439EC 19400001        	  6243:     move.b  D0,($0001,A4)
                            	  6244:     ; Return the direction of the door in [09], and the dynamic
                            	  6245:     ; transfer buf length in X register.
                            	  6246:     ;
02:000439F0 19420009        	  6247:     move.b  D2,($0009,A4)
02:000439F4 7400            	  6248:     moveq   #0,D2
02:000439F6 142C0301        	  6249:     move.b  ($0301,A4),D2
                            	  6250:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6251:     ;
02:000439FA 7000            	  6252:     moveq   #0,D0
02:000439FC 19400007        	  6253:     move.b  D0,($0007,A4)
02:00043A00 7002            	  6254:     moveq   #2,D0
02:00043A02 19400006        	  6255:     move.b  D0,($0006,A4)
02:00043A06 19400005        	  6256:     move.b  D0,($0005,A4)
02:00043A0A 0A3C0001        	  6257:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00043A0E 4E75            	  6258:     rts
                            	  6259: 
