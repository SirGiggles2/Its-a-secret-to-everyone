02:0003C05E 41EC0485        	  5746:     lea     ($0485,A4),A0
02:0003C062 11802000        	  5747:     move.b  D0,(A0,D2.W)
02:0003C066 6100062A        	  5748:     jsr     CheckBossHitReaction
                            	  5749:     ; Look for the tail segment, starting from the low end
                            	  5750:     ; of the chain that this dead segment belongs to.
                            	  5751:     ;
