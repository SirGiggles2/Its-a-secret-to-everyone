02:00030420 41F9000303E4    	  2939:     lea     (TrapXs).l,A0
02:00030426 10303000        	  2940:     move.b  (A0,D3.W),D0
02:0003042A 19802070        	  2941:     move.b  D0,($70,A4,D2.W)
02:0003042E 41F9000303EA    	  2942:     lea     (TrapYs).l,A0
02:00030434 10303000        	  2943:     move.b  (A0,D3.W),D0
02:00030438 41EC0084        	  2944:     lea     ($0084,A4),A0
02:0003043C 11802000        	  2945:     move.b  D0,(A0,D2.W)
02:00030440 619E            	  2946:     jsr     InitOneSimpleObject
