                            	  7260: Dodongo_TryEatBomb:
                            	  7261:     ; Try to eat the bomb.
                            	  7262:     ;
                            	  7263:     ; If the bomb is not in range of the monster, then return.
                            	  7264:     ;
                            	  7265:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7266:     ;
02:0003CB50 7601            	  7267:     moveq   #1,D3
02:0003CB52 616E            	  7268:     jsr     Dodongo_IsBombInRange
02:0003CB54 6666            	  7269:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7270:     ; Will loop from 1 to 0, indexed by [00].
                            	  7271:     ;
02:0003CB56 7001            	  7272:     moveq   #1,D0
02:0003CB58 1880            	  7273:     move.b  D0,($0000,A4)
                            	  7274:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7275:     ;
02:0003CB5A 41EC0098        	  7276:     lea     ($0098,A4),A0
02:0003CB5E 10302000        	  7277:     move.b  (A0,D2.W),D0
02:0003CB62 E208            	  7278:     lsr.b  #1,D0   ; LSR A
02:0003CB64 7600            	  7279:     moveq   #0,D3
02:0003CB66 1600            	  7280:     move.b  D0,D3
                            	  7281:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7282:     ; position depends on the orientation of the monster.
                            	  7283:     ;
                            	  7284:     ; Start with the horizontal distance.
                            	  7285:     ;
02:0003CB68 102C0004        	  7286:     move.b  ($0004,A4),D0
                            	  7287:     even
                            	  7288: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7289:     ; Look up the limits for the given direction.
                            	  7290:     ;
                            	  7291:     ; If the distance from the bomb < negative limit,
                            	  7292:     ; or >= positive limit, then return.
                            	  7293:     ;
                            	  7294:     ; Note that these are simple signed comparisons that work,
                            	  7295:     ; because the operands are in a small range.
                            	  7296:     ;
02:0003CB6C 41F90003CAA6    	  7297:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CB72 12303000        	  7298:     move.b  (A0,D3.W),D1
02:0003CB76 B001            	  7299:     cmp.b   D1,D0
02:0003CB78 6B42            	  7300:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CB7A 41F90003CAAC    	  7301:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CB80 12303000        	  7302:     move.b  (A0,D3.W),D1
02:0003CB84 B001            	  7303:     cmp.b   D1,D0
02:0003CB86 6A34            	  7304:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7305:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7306:     ;
02:0003CB88 1003            	  7307:     move.b  D3,D0
02:0003CB8A 023C00EE        	  7308:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB8E 123C000A        	  7309:     move.b  #$0A,D1
02:0003CB92 D101            	  7310:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CB94 7600            	  7311:     moveq   #0,D3
02:0003CB96 1600            	  7312:     move.b  D0,D3
                            	  7313:     ; Bottom of the loop.
                            	  7314:     ;
                            	  7315:     ; Load the vertical distance for the next iteration.
                            	  7316:     ; Decrement loop counter.
                            	  7317:     ;
02:0003CB98 102C0005        	  7318:     move.b  ($0005,A4),D0
02:0003CB9C 5314            	  7319:     subq.b  #1,($0000,A4)
02:0003CB9E 6ACC            	  7320:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7321:     ; If we get here, then the bomb was within range of the mouth.
                            	  7322:     ; Go to state 1 (bloated).
                            	  7323:     ;
02:0003CBA0 41EC00AC        	  7324:     lea     ($00AC,A4),A0
02:0003CBA4 52302000        	  7325:     addq.b  #1,(A0,D2.W)
                            	  7326:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7327:     ;
02:0003CBA8 7610            	  7328:     moveq   #16,D3
02:0003CBAA 7000            	  7329:     moveq   #0,D0
02:0003CBAC 41EC00AC        	  7330:     lea     ($00AC,A4),A0
02:0003CBB0 11803000        	  7331:     move.b  D0,(A0,D3.W)
02:0003CBB4 41EC042C        	  7332:     lea     ($042C,A4),A0
02:0003CBB8 11802000        	  7333:     move.b  D0,(A0,D2.W)
                            	  7334:     even
                            	  7335: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003CBBC 4E75            	  7336:     rts
