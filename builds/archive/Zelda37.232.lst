                            	 10049: Gohma_CheckCollisions:
                            	 10050:     ; Save the boss's X coordinate.
                            	 10051:     ;
02:0003DFCE 10342070        	 10052:     move.b  ($70,A4,D2.W),D0
02:0003DFD2 1B00            	 10053:     move.b  D0,-(A5)  ; PHA
                            	 10054:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	 10055:     ; on the left side.
                            	 10056:     ;
02:0003DFD4 003C0011        	 10057:     ori     #$11,CCR  ; SEC: set C+X
02:0003DFD8 123C0010        	 10058:     move.b  #$10,D1
02:0003DFDC 0A3C0010        	 10059:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DFE0 9101            	 10060:     subx.b  D1,D0   ; SBC #$10
02:0003DFE2 0A3C0010        	 10061:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DFE6 19802070        	 10062:     move.b  D0,($70,A4,D2.W)
                            	 10063:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	 10064:     ; from left to right, indexed by [0F].
                            	 10065:     ;
02:0003DFEA 7005            	 10066:     moveq   #5,D0
02:0003DFEC 1940000F        	 10067:     move.b  D0,($000F,A4)
