                            	  3237:     ; Switch the flag indicating whether Link is the target.
                            	  3238:     ; If the value is 0 (Link *is* the target), then
                            	  3239:     ; skip this and go update objects.
                            	  3240:     ;
02:0004B4BA 102C0060        	  3241:     move.b  ($0060,A4),D0
02:0004B4BE 0A000001        	  3242:     eori.b #$01,D0
02:0004B4C2 19400060        	  3243:     move.b  D0,($0060,A4)
02:0004B4C6 671C            	  3244:     beq  _L_z07_BeginUpdateWorld_LoopObject
                            	  3245:     ; If Link's X has not changed since the last frame
                            	  3246:     ; (when Link was the target), then XOR the chase target
                            	  3247:     ; coordinates (which were Link's coordinates last frame).
                            	  3248:     ;
                            	  3249:     ; This ends up reflecting Link's coordinates across the room;
                            	  3250:     ; so that monsters chase away from him.
                            	  3251:     ;
