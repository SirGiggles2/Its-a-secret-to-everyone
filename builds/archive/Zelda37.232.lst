                            	  7446: Dodongo_Draw:
02:0003CC4C 610000F4        	  7447:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7448:     ; Make a 5-way direction index out of the facing direction
                            	  7449:     ; by shifting right once, and store it in [00].
                            	  7450:     ;
02:0003CC50 41EC0098        	  7451:     lea     ($0098,A4),A0
02:0003CC54 10302000        	  7452:     move.b  (A0,D2.W),D0
02:0003CC58 E208            	  7453:     lsr.b  #1,D0   ; LSR A
02:0003CC5A 1880            	  7454:     move.b  D0,($0000,A4)
                            	  7455:     ; If state = 0, go handle animating the two frames of this state.
                            	  7456:     ;
02:0003CC5C 7600            	  7457:     moveq   #0,D3
02:0003CC5E 41EC00AC        	  7458:     lea     ($00AC,A4),A0
02:0003CC62 16302000        	  7459:     move.b  (A0,D2.W),D3
02:0003CC66 6744            	  7460:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7461:     ; If state > 1, then the monster is stunned (state 2).
                            	  7462:     ; So, go switch frames every $20 screen frames.
                            	  7463:     ;
02:0003CC68 7020            	  7464:     moveq   #32,D0
02:0003CC6A 5303            	  7465:     subq.b  #1,D3
02:0003CC6C 6640            	  7466:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7467:     ; State = 1. Bloated.
                            	  7468:     ;
                            	  7469:     ; In substate 0, go animate as usual for walking.
                            	  7470:     ;
02:0003CC6E 7600            	  7471:     moveq   #0,D3
02:0003CC70 41EC042C        	  7472:     lea     ($042C,A4),A0
02:0003CC74 16302000        	  7473:     move.b  (A0,D2.W),D3
02:0003CC78 6732            	  7474:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7475:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7476:     ; go fade the boss; so that some frames are not drawn.
                            	  7477:     ;
02:0003CC7A 0C030002        	  7478:     cmpi.b  #$02,D3
02:0003CC7E 6718            	  7479:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CC80 0C030003        	  7480:     cmpi.b  #$03,D3
02:0003CC84 6712            	  7481:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7482:     ; State 1, substate 1
                            	  7483:     ;
                            	  7484:     ; Add $14 to the frame image index to index into the bloated
                            	  7485:     ; frame images and H-flips.
                            	  7486:     ;
02:0003CC86 1014            	  7487:     move.b  ($0000,A4),D0
02:0003CC88 023C00EE        	  7488:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CC8C 123C0014        	  7489:     move.b  #$14,D1
02:0003CC90 D101            	  7490:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CC92 7600            	  7491:     moveq   #0,D3
02:0003CC94 1600            	  7492:     move.b  D0,D3
02:0003CC96 6032            	  7493:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7494: 
                            	  7495:     even
                            	  7496: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7497:     ; In bloated substates 2 and 3:
                            	  7498:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7499:     ;
02:0003CC98 102C0015        	  7500:     move.b  ($0015,A4),D0
02:0003CC9C 02000002        	  7501:     andi.b #$02,D0
02:0003CCA0 6604            	  7502:     bne.s  __far_z_04_0066
02:0003CCA2 600000A6        	  7503:     jmp  L11B00_Exit
                            	  7504: __far_z_04_0066:
02:0003CCA6 7600            	  7505:     moveq   #0,D3
02:0003CCA8 1614            	  7506:     move.b  ($0000,A4),D3
02:0003CCAA 601E            	  7507:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7508: 
                            	  7509:     even
                            	  7510: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7511:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7512:     ;
02:0003CCAC 7008            	  7513:     moveq   #8,D0
                            	  7514:     even
                            	  7515: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CCAE 7600            	  7516:     moveq   #0,D3
02:0003CCB0 1614            	  7517:     move.b  ($0000,A4),D3
02:0003CCB2 122C0015        	  7518:     move.b  ($0015,A4),D1
02:0003CCB6 C001            	  7519:     and.b  D1,D0
02:0003CCB8 6710            	  7520:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7521:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7522:     ; in order to index into the second set of frame image numbers.
                            	  7523:     ;
02:0003CCBA 1003            	  7524:     move.b  D3,D0
02:0003CCBC 023C00EE        	  7525:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CCC0 123C0005        	  7526:     move.b  #$05,D1
02:0003CCC4 D101            	  7527:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CCC6 7600            	  7528:     moveq   #0,D3
02:0003CCC8 1600            	  7529:     move.b  D0,D3
                            	  7530:     even
                            	  7531: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7532:     ; Start preparing sprites.
                            	  7533:     ;
02:0003CCCA 4EB90004CD7A    	  7534:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CCD0 1003            	  7535:     move.b  D3,D0
02:0003CCD2 1B00            	  7536:     move.b  D0,-(A5)  ; PHA
                            	  7537:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7538:     ;
02:0003CCD4 41F90003CC2E    	  7539:     lea     (DodongoFrameHFlips).l,A0
02:0003CCDA 10303000        	  7540:     move.b  (A0,D3.W),D0
02:0003CCDE 1940000F        	  7541:     move.b  D0,($000F,A4)
02:0003CCE2 41F90003CC24    	  7542:     lea     (DodongoFrameImages).l,A0
02:0003CCE8 10303000        	  7543:     move.b  (A0,D3.W),D0
                            	  7544:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7545:     ; They are drawn mirrored.
                            	  7546:     ;
02:0003CCEC 0C000007        	  7547:     cmpi.b  #$07,D0
02:0003CCF0 6706            	  7548:     beq  _anon_z04_92
02:0003CCF2 0C000009        	  7549:     cmpi.b  #$09,D0
02:0003CCF6 6608            	  7550:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7551: _anon_z04_92:
