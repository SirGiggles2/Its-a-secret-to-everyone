                            	 12946: Ganon_DrawBody:
                            	 12947:     ; Loop over four 16x16 images that make up Ganon.
                            	 12948:     ; There are 6 animation frames.
                            	 12949:     ;
02:0003F4FA 7603            	 12950:     moveq   #3,D3
                            	 12951:     even
                            	 12952: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12953:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12954:     ;
02:0003F4FC 10342070        	 12955:     move.b  ($70,A4,D2.W),D0
02:0003F500 023C00EE        	 12956:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F504 41F90003F4EE    	 12957:     lea     (GanonSpriteOffsetsX).l,A0
02:0003F50A 12303000        	 12958:     move.b  (A0,D3.W),D1
02:0003F50E D101            	 12959:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003F510 1880            	 12960:     move.b  D0,($0000,A4)
                            	 12961:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12962:     ;
02:0003F512 41EC0084        	 12963:     lea     ($0084,A4),A0
02:0003F516 10302000        	 12964:     move.b  (A0,D2.W),D0
02:0003F51A 023C00EE        	 12965:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003F51E 41F90003F4F2    	 12966:     lea     (GanonSpriteOffsetsY).l,A0
02:0003F524 12303000        	 12967:     move.b  (A0,D3.W),D1
02:0003F528 D101            	 12968:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003F52A 19400001        	 12969:     move.b  D0,($0001,A4)
                            	 12970:     ; Each part has a horizontal flipping flag.
                            	 12971:     ;
02:0003F52E 41F90003F4F6    	 12972:     lea     (GanonSpriteHFlips).l,A0
02:0003F534 10303000        	 12973:     move.b  (A0,D3.W),D0
02:0003F538 1940000F        	 12974:     move.b  D0,($000F,A4)
                            	 12975:     ; Save and copy the loop index (the current part) to [07].
                            	 12976:     ;
02:0003F53C 1003            	 12977:     move.b  D3,D0
02:0003F53E 1B00            	 12978:     move.b  D0,-(A5)  ; PHA
02:0003F540 19400007        	 12979:     move.b  D0,($0007,A4)
                            	 12980:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12981:     ; that make it up.
                            	 12982:     ;
02:0003F544 41EC046B        	 12983:     lea     ($046B,A4),A0
02:0003F548 10302000        	 12984:     move.b  (A0,D2.W),D0
02:0003F54C E308            	 12985:     lsl.b  #1,D0   ; ASL A
02:0003F54E E308            	 12986:     lsl.b  #1,D0   ; ASL A
                            	 12987:     ; Add [07] -- the index of the current part.
                            	 12988:     ;
                            	 12989:     ; Now you have an index into the frame image table, for the
                            	 12990:     ; current image part of the current animation frame.
                            	 12991:     ;
02:0003F550 122C0007        	 12992:     move.b  ($0007,A4),D1
02:0003F554 D101            	 12993:     addx.b  D1,D0   ; ADC $07
02:0003F556 7600            	 12994:     moveq   #0,D3
02:0003F558 1600            	 12995:     move.b  D0,D3
02:0003F55A 41F90003F4D6    	 12996:     lea     (GanonFrameImages).l,A0
02:0003F560 10303000        	 12997:     move.b  (A0,D3.W),D0
02:0003F564 4EB900031836    	 12998:     jsr     DrawObjectNotMirrored
02:0003F56A 101D            	 12999:     move.b  (A5)+,D0  ; PLA
                            	 13000:     ; Bottom of the part loop.
                            	 13001:     ;
02:0003F56C 7600            	 13002:     moveq   #0,D3
02:0003F56E 1600            	 13003:     move.b  D0,D3
02:0003F570 5303            	 13004:     subq.b  #1,D3
02:0003F572 6A88            	 13005:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003F574 4E75            	 13006:     rts
