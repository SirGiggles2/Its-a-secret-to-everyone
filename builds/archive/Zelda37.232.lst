                            	  2083: CheckZora:
                            	  2084:     ; If the zora attribute of this room is off, return.
                            	  2085:     ;
02:0003A61E 7600            	  2086:     moveq   #0,D3
02:0003A620 162C00EB        	  2087:     move.b  ($00EB,A4),D3
02:0003A624 41F900FF687E    	  2088:     lea     (NES_SRAM+$087E).l,A0
02:0003A62A 10303000        	  2089:     move.b  (A0,D3.W),D0
02:0003A62E 02000008        	  2090:     andi.b #$08,D0
02:0003A632 677C            	  2091:     beq  _L_z04_CheckZora_Exit
                            	  2092:     ; If zora is active, return.
                            	  2093:     ;
02:0003A634 102C0514        	  2094:     move.b  ($0514,A4),D0
02:0003A638 6676            	  2095:     bne  _L_z04_CheckZora_Exit
                            	  2096:     ; Look for an empty monster slot. If none is found, return.
                            	  2097:     ;
02:0003A63A 4EB90004D56A    	  2098:     jsr     FindEmptyMonsterSlot
02:0003A640 676E            	  2099:     beq  _L_z04_CheckZora_Exit
                            	  2100:     ; Loop $D times looking for a water tile to put a zora on.
                            	  2101:     ; Indexed by [0D].
                            	  2102:     ;
02:0003A642 700D            	  2103:     moveq   #13,D0
02:0003A644 1940000D        	  2104:     move.b  D0,($000D,A4)
                            	  2105:     ; Switch to the new object slot.
                            	  2106:     ;
02:0003A648 7400            	  2107:     moveq   #0,D2
02:0003A64A 142C0059        	  2108:     move.b  ($0059,A4),D2
                            	  2109:     even
                            	  2110: _L_z04_CheckZora_LoopTileCandidate:
                            	  2111:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2112:     ; If it = 0 or $F0, go loop again.
                            	  2113:     ;
02:0003A64E 7600            	  2114:     moveq   #0,D3
02:0003A650 162C000D        	  2115:     move.b  ($000D,A4),D3
02:0003A654 10343018        	  2116:     move.b  ($18,A4,D3.W),D0
02:0003A658 020000F0        	  2117:     andi.b #$F0,D0
02:0003A65C 19802070        	  2118:     move.b  D0,($70,A4,D2.W)
02:0003A660 6748            	  2119:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A662 0C0000F0        	  2120:     cmpi.b  #$F0,D0
02:0003A666 6742            	  2121:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2122:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2123:     ; If it < $50 or >= $E0, go loop again.
                            	  2124:     ;
02:0003A668 10343018        	  2125:     move.b  ($18,A4,D3.W),D0
02:0003A66C E308            	  2126:     lsl.b  #1,D0   ; ASL A
02:0003A66E E308            	  2127:     lsl.b  #1,D0   ; ASL A
02:0003A670 E308            	  2128:     lsl.b  #1,D0   ; ASL A
02:0003A672 E308            	  2129:     lsl.b  #1,D0   ; ASL A
02:0003A674 0C000050        	  2130:     cmpi.b  #$50,D0
02:0003A678 6530            	  2131:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A67A 0C0000E0        	  2132:     cmpi.b  #$E0,D0
02:0003A67E 642A            	  2133:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2134:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2135:     ;
02:0003A680 0000000D        	  2136:     ori.b #$0D,D0
02:0003A684 41EC0084        	  2137:     lea     ($0084,A4),A0
02:0003A688 11802000        	  2138:     move.b  D0,(A0,D2.W)
                            	  2139:     ; Get the tile at that location.
                            	  2140:     ; If it's not a water tile, then go loop again.
                            	  2141:     ;
02:0003A68C 4EB90004B684    	  2142:     jsr     GetCollidableTileStill
02:0003A692 0C00008D        	  2143:     cmpi.b  #$8D,D0
02:0003A696 6512            	  2144:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A698 0C000099        	  2145:     cmpi.b  #$99,D0
02:0003A69C 640C            	  2146:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2147:     ; Flag the zora active, and set up the object.
                            	  2148:     ;
02:0003A69E 522C0514        	  2149:     addq.b  #1,($0514,A4)
02:0003A6A2 7011            	  2150:     moveq   #17,D0
02:0003A6A4 4EF90004D564    	  2151:     jmp     SetTypeAndClearObject
                            	  2152: 
                            	  2153:     even
