02:00040332 0C0000DD        	   665:     cmpi.b  #$DD,D0
02:00040336 640A            	   666:     bcc  _anon_z05_9
02:00040338 123C0008        	   667:     move.b  #$08,D1
02:0004033C D101            	   668:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
