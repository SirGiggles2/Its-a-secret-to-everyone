02:0002E5DA 0200003F        	   921:     andi.b #$3F,D0
02:0002E5DE 0C00003F        	   922:     cmpi.b  #$3F,D0
02:0002E5E2 6732            	   923:     beq  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   924:     ; If Link's X <> item's X, then loop again.
