02:0003631A 102C00AD        	  4523:     move.b  ($00AD,A4),D0
02:0003631E 670A            	  4524:     beq  _anon_z02_30
                            	  4525:     ; Set a delay of $50 frames in the next submode.
                            	  4526:     ;
