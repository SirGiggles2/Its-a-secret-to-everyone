                            	 12013: Lamnola_Move:
                            	 12014:     ; This code is similar to 04:96EB Digdogger_Move.
                            	 12015:     ;
                            	 12016:     ; Change coordinates by the appropriate speed according to the direction.
                            	 12017:     ;
                            	 12018:     ; Start with a mask of $A1 in [02]:
                            	 12019:     ; - low nibble represents the right direction
                            	 12020:     ; - high nibble is used to set or clear carry as we go along
                            	 12021:     ;
02:0003EE56 103C00A1        	 12022:     move.b  #$A1,D0
02:0003EE5A 19400002        	 12023:     move.b  D0,($0002,A4)
                            	 12024:     ; If direction has a right component (1), then add offset to X coordinate.
                            	 12025:     ;
02:0003EE5E 41EC0098        	 12026:     lea     ($0098,A4),A0
02:0003EE62 10302000        	 12027:     move.b  (A0,D2.W),D0
02:0003EE66 122C0002        	 12028:     move.b  ($0002,A4),D1
02:0003EE6A C200            	 12029:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003EE6C 6712            	 12030:     beq  _L_z04_Lamnola_Move_Left
02:0003EE6E 10342070        	 12031:     move.b  ($70,A4,D2.W),D0
