                            	  9780: _L_z04_UpdateGohma_Move:
                            	  9781:     ; Add $80 to the movement accumulator.
                            	  9782:     ;
02:0003DDD6 41EC041F        	  9783:     lea     ($041F,A4),A0
02:0003DDDA 10302000        	  9784:     move.b  (A0,D2.W),D0
02:0003DDDE 023C00EE        	  9785:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DDE2 123C0080        	  9786:     move.b  #$80,D1
