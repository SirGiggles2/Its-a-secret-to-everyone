02:0004193C 102C0098        	  3066:     move.b  ($0098,A4),D0
02:00041940 0200000C        	  3067:     andi.b #$0C,D0
02:00041944 6602            	  3068:     bne  _anon_z05_77
02:00041946 7603            	  3069:     moveq   #3,D3
                            	  3070: _anon_z05_77:
