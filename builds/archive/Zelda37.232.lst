                            	   764: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   765:     ; Replace the low byte of the VRAM address with the one
                            	   766:     ; where the next character should be written.
                            	   767:     ;
02:0002E4E0 102C045F        	   768:     move.b  ($045F,A4),D0
02:0002E4E4 19400303        	   769:     move.b  D0,($0303,A4)
                            	   770:     ; Increment the low VRAM address for the next character.
                            	   771:     ;
02:0002E4E8 522C045F        	   772:     addq.b  #1,($045F,A4)
                            	   773:     ; Use the person text selector to look up the address of the
                            	   774:     ; text for the textbox. Store the address in [00:01].
                            	   775:     ;
02:0002E4EC 7600            	   776:     moveq   #0,D3
02:0002E4EE 162C0415        	   777:     move.b  ($0415,A4),D3
02:0002E4F2 41F90002DB28    	   778:     lea     (PersonTextAddrs).l,A0
02:0002E4F8 10303000        	   779:     move.b  (A0,D3.W),D0
02:0002E4FC 1880            	   780:     move.b  D0,($0000,A4)
02:0002E4FE 5203            	   781:     addq.b  #1,D3
02:0002E500 41F90002DB28    	   782:     lea     (PersonTextAddrs).l,A0
02:0002E506 10303000        	   783:     move.b  (A0,D3.W),D0
02:0002E50A 19400001        	   784:     move.b  D0,($0001,A4)
                            	   785:     ; Load the person text current character index.
                            	   786:     ;
02:0002E50E 7600            	   787:     moveq   #0,D3
02:0002E510 162C0416        	   788:     move.b  ($0416,A4),D3
                            	   789:     ; Increment the index variable to point to the next character
                            	   790:     ; for next time.
                            	   791:     ;
02:0002E514 522C0416        	   792:     addq.b  #1,($0416,A4)
                            	   793:     ; Get the current character.
                            	   794:     ;
02:0002E518 1214            	   795:     move.b  ($00,A4),D1   ; ptr lo
02:0002E51A 182C0001        	   796:     move.b  ($01,A4),D4  ; ptr hi
02:0002E51E 024100FF        	   797:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E522 E14C            	   798:     lsl.w   #8,D4
02:0002E524 8841            	   799:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E526 48C4            	   800:     ext.l   D4
02:0002E528 D8BC00FF0000    	   801:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E52E 2044            	   802:     movea.l D4,A0
02:0002E530 10303000        	   803:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   804:     ; If the character is $25, then it's a special space. It will still
                            	   805:     ; take up space, but will not take time to show -- meaning that
                            	   806:     ; we'll go look up the next character to transfer.
                            	   807:     ;
02:0002E534 0200003F        	   808:     andi.b #$3F,D0
02:0002E538 0C000025        	   809:     cmpi.b  #$25,D0
02:0002E53C 67A2            	   810:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   811:     ; We have a non-space character. Put it in the transfer record.
                            	   812:     ;
02:0002E53E 19400305        	   813:     move.b  D0,($0305,A4)
                            	   814:     ; Play the "heart taken/character" sound effect.
                            	   815:     ;
02:0002E542 7010            	   816:     moveq   #16,D0
02:0002E544 19400604        	   817:     move.b  D0,($0604,A4)
                            	   818:     ; If the high 2 bits of character element = 0, then return.
                            	   819:     ;
02:0002E548 1214            	   820:     move.b  ($00,A4),D1   ; ptr lo
02:0002E54A 182C0001        	   821:     move.b  ($01,A4),D4  ; ptr hi
02:0002E54E 024100FF        	   822:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E552 E14C            	   823:     lsl.w   #8,D4
02:0002E554 8841            	   824:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E556 48C4            	   825:     ext.l   D4
02:0002E558 D8BC00FF0000    	   826:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E55E 2044            	   827:     movea.l D4,A0
02:0002E560 10303000        	   828:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E564 020000C0        	   829:     andi.b #$C0,D0
02:0002E568 672E            	   830:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   831:     ; Determine an index based on the high 2 bits of the character element:
                            	   832:     ;   $80: 0
                            	   833:     ;   $40: 1
                            	   834:     ;   $C0: 2
                            	   835:     ;
02:0002E56A 7602            	   836:     moveq   #2,D3
02:0002E56C 0C0000C0        	   837:     cmpi.b  #$C0,D0
02:0002E570 670A            	   838:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E572 5303            	   839:     subq.b  #1,D3
02:0002E574 0C000040        	   840:     cmpi.b  #$40,D0
02:0002E578 6702            	   841:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
