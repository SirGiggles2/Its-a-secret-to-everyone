                            	  4715: ;       to the dynamic transfer buf
                            	  4716: ; [09]: door direction index
                            	  4717: ;
                            	  4718: ; Returns:
                            	  4719: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4720: ; [04]: original value - 1
                            	  4721: ; [07]: original value + 1
                            	  4722: ;
                            	  4723: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4724: ; vertically. The point of this routine is to access them
                            	  4725: ; horizontally in order to transfer them to a nametable.
                            	  4726: ;
                            	  4727: ;
                            	  4728: ; For the direction index in [09], look up the base offset of the
                            	  4729: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4730: ; the door face tiles at [02:03].
                            	  4731: ;
                            	  4732:     even
                            	  4733: WriteDoorFaceTileHorizontally:
02:00042584 7600            	  4734:     moveq   #0,D3
02:00042586 162C0009        	  4735:     move.b  ($0009,A4),D3
02:0004258A 41F9000437A8    	  4736:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:00042590 10303000        	  4737:     move.b  (A0,D3.W),D0
                            	  4738:     ; Add [07] to the base offset we got above. This yields one
                            	  4739:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4740:     ;
02:00042594 023C00EE        	  4741:     andi    #$EE,CCR  ; CLC: clear C+X
02:00042598 122C0007        	  4742:     move.b  ($0007,A4),D1
02:0004259C D101            	  4743:     addx.b  D1,D0   ; ADC $07
02:0004259E 7600            	  4744:     moveq   #0,D3
02:000425A0 1600            	  4745:     move.b  D0,D3
                            	  4746:     ; With that index, look up the index to use with the door face
                            	  4747:     ; list of tiles at [02:03].
                            	  4748:     ;
02:000425A2 41F90004379A    	  4749:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000425A8 10303000        	  4750:     move.b  (A0,D3.W),D0
02:000425AC 7600            	  4751:     moveq   #0,D3
02:000425AE 1600            	  4752:     move.b  D0,D3
                            	  4753:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4754:     ; and copy it to the dynamic transfer buf.
                            	  4755:     ;
02:000425B0 122C0002        	  4756:     move.b  ($02,A4),D1   ; ptr lo
02:000425B4 182C0003        	  4757:     move.b  ($03,A4),D4  ; ptr hi
02:000425B8 024100FF        	  4758:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000425BC E14C            	  4759:     lsl.w   #8,D4
02:000425BE 8841            	  4760:     or.w    D1,D4             ; D4 = NES ptr addr
02:000425C0 48C4            	  4761:     ext.l   D4
02:000425C2 D8BC00FF0000    	  4762:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000425C8 2044            	  4763:     movea.l D4,A0
02:000425CA 10303000        	  4764:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000425CE 41EC0302        	  4765:     lea     ($0302,A4),A0
02:000425D2 11802000        	  4766:     move.b  D0,(A0,D2.W)
                            	  4767:     ; Prepare for the next call:
                            	  4768:     ; - increment dynamic transfer buf pointer
                            	  4769:     ; - increment index of tile to copy [07]
                            	  4770:     ; - decrement count of tiles remaining
                            	  4771:     ;
02:000425D6 5202            	  4772:     addq.b  #1,D2
02:000425D8 522C0007        	  4773:     addq.b  #1,($0007,A4)
02:000425DC 532C0004        	  4774:     subq.b  #1,($0004,A4)
02:000425E0 4E75            	  4775:     rts
