02:0004B6AC 41EC00C0        	  3507:     lea     ($00C0,A4),A0
02:0004B6B0 11802000        	  3508:     move.b  D0,(A0,D2.W)
                            	  3509:     ; If the object faces horizontally, go check which axis shove
                            	  3510:     ; direction is on.
                            	  3511:     ;
02:0004B6B4 7600            	  3512:     moveq   #0,D3
02:0004B6B6 41EC0098        	  3513:     lea     ($0098,A4),A0
