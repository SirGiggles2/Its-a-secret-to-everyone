                            	  4907:     ;
02:00036630 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:00036634 41F900036576    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:0003663A 10303000        	  4913:     move.b  (A0,D3.W),D0
02:0003663E 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
                            	  4916:     ; increment the high address.
                            	  4917:     ;
02:00036642 0C0000A0        	  4918:     cmpi.b  #$A0,D0
