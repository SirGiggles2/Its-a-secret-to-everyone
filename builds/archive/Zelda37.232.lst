02:0003E796 19400406        	 11103:     move.b  D0,($0406,A4)
                            	 11104:     ; Reset the object type of slots 2 to $A.
                            	 11105:     ;
                            	 11106:     ; Beware a left over fireball in slot $B!
                            	 11107:     ;
02:0003E79A 7601            	 11108:     moveq   #1,D3
                            	 11109:     even
                            	 11110: _L_z04_Gleeok_CheckCollisions_DestroyFireballs:
