                            	  7029: Dodongo_CheckBombHit:
                            	  7030:     ; If state <> 0 (not moving), then return.
                            	  7031:     ;
02:0003CB3A 41EC00AC        	  7032:     lea     ($00AC,A4),A0
02:0003CB3E 10302000        	  7033:     move.b  (A0,D2.W),D0
02:0003CB42 66000086        	  7034:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7035:     ; If facing vertically, then store (X + 8) in [00].
                            	  7036:     ; Else store (X + $10).
                            	  7037:     ;
02:0003CB46 10342070        	  7038:     move.b  ($70,A4,D2.W),D0
02:0003CB4A 023C00EE        	  7039:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CB4E 123C0008        	  7040:     move.b  #$08,D1
02:0003CB52 D101            	  7041:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB54 7600            	  7042:     moveq   #0,D3
02:0003CB56 41EC0098        	  7043:     lea     ($0098,A4),A0
02:0003CB5A 16302000        	  7044:     move.b  (A0,D2.W),D3
