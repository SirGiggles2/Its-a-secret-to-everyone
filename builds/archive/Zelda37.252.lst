02:0003C600 19410002        	  6327:     move.b  D1,($0002,A4)
02:0003C604 122C0002        	  6328:     move.b  ($0002,A4),D1
02:0003C608 C200            	  6329:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
