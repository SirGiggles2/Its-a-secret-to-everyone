02:0003DD5E 41EC0084        	  9504:     lea     ($0084,A4),A0
02:0003DD62 10302000        	  9505:     move.b  (A0,D2.W),D0
02:0003DD66 122C0003        	  9506:     move.b  ($0003,A4),D1
