02:00030F28 102C0004        	  3965:     move.b  ($0004,A4),D0
02:00030F2C 19400003        	  3966:     move.b  D0,($0003,A4)
02:00030F30 101D            	  3967:     move.b  (A5)+,D0  ; PLA
02:00030F32 19400004        	  3968:     move.b  D0,($0004,A4)
02:00030F36 7001            	  3969:     moveq   #1,D0
02:00030F38 19400001        	  3970:     move.b  D0,($0001,A4)
