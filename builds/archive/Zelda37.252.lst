02:0003C114 0C020006        	  5622:     cmpi.b  #$06,D2
02:0003C118 6502            	  5623:     bcs  _anon_z04_80
02:0003C11A 7604            	  5624:     moveq   #4,D3
                            	  5625: _anon_z04_80:
