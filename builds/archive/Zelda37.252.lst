                            	 11004: __far_z_04_0101:
                            	 11005:     ; The animation timer has expired. There are two choices for arming it.
                            	 11006:     ;
                            	 11007:     ; When writhing after a hit, Gleeok animates faster.
                            	 11008:     ; So, when the writhing counter <> 0, set a shorter time (6).
                            	 11009:     ; Otherwise, set a longer time ($10).
