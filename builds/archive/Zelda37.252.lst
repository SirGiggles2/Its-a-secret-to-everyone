                            	  2602:     even
                            	  2603: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  2604:     ; If the horizontal distance between Link and the trap >= $E,
                            	  2605:     ; then this trap definitely wasn't triggered.
                            	  2606:     ; Go draw and check collisions.
                            	  2607:     ;
02:00030654 102C0070        	  2608:     move.b  ($0070,A4),D0
02:00030658 003C0011        	  2609:     ori     #$11,CCR  ; SEC: set C+X
02:0003065C 12342070        	  2610:     move.b  ($70,A4,D2.W),D1
02:00030660 0A3C0010        	  2611:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030664 9101            	  2612:     subx.b  D1,D0   ; SBC ObjX,X
02:00030666 0A3C0010        	  2613:     eori    #$10,CCR  ; restore X = 6502 C
02:0003066A 61000802        	  2614:     jsr     Abs
02:0003066E 0C00000E        	  2615:     cmpi.b  #$0E,D0
02:00030672 64DC            	  2616:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  2617:     ; Determine the vertical direction toward Link;
                            	  2618:     ; and if Link and the trap are at the same Y, then we can't move
                            	  2619:     ; along this axis. Go draw and check object collisions.
                            	  2620:     ;
02:00030674 7604            	  2621:     moveq   #4,D3
02:00030676 102C0084        	  2622:     move.b  ($0084,A4),D0
02:0003067A 41EC0084        	  2623:     lea     ($0084,A4),A0
02:0003067E 12302000        	  2624:     move.b  (A0,D2.W),D1
02:00030682 B001            	  2625:     cmp.b   D1,D0
02:00030684 67CA            	  2626:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:00030686 6402            	  2627:     bcc  _anon_z01_27
02:00030688 7608            	  2628:     moveq   #8,D3
                            	  2629: _anon_z01_27:
                            	  2630:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  2631:     ; set the vertical direction we determined, and other preparations.
                            	  2632:     ;
02:0003068A 41EC0084        	  2633:     lea     ($0084,A4),A0
02:0003068E 10302000        	  2634:     move.b  (A0,D2.W),D0
02:00030692 668A            	  2635:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  2636:     even
                            	  2637: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  2638:     ; State 1 and 2.
                            	  2639:     ;
                            	  2640:     ; Move in the direction it's facing.
                            	  2641:     ;
02:00030694 41EC0098        	  2642:     lea     ($0098,A4),A0
02:00030698 10302000        	  2643:     move.b  (A0,D2.W),D0
02:0003069C 1940000F        	  2644:     move.b  D0,($000F,A4)
02:000306A0 4EB90004B79C    	  2645:     jsr     MoveObject
                            	  2646:     ; Truncate the grid offset to square length ($10).
                            	  2647:     ;
02:000306A6 41EC0394        	  2648:     lea     ($0394,A4),A0
02:000306AA 10302000        	  2649:     move.b  (A0,D2.W),D0
02:000306AE 0200000F        	  2650:     andi.b #$0F,D0
02:000306B2 6608            	  2651:     bne  _anon_z01_28
02:000306B4 41EC0394        	  2652:     lea     ($0394,A4),A0
02:000306B8 11802000        	  2653:     move.b  D0,(A0,D2.W)
                            	  2654: _anon_z01_28:
                            	  2655:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  2656:     ;
02:000306BC 610017CA        	  2657:     jsr     CheckLinkCollision
                            	  2658:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  2659:     ; and current coordinate to the trap's X.
                            	  2660:     ;
02:000306C0 7600            	  2661:     moveq   #0,D3
02:000306C2 16342070        	  2662:     move.b  ($70,A4,D2.W),D3
02:000306C6 7078            	  2663:     moveq   #120,D0
02:000306C8 1880            	  2664:     move.b  D0,($0000,A4)
02:000306CA 41EC0098        	  2665:     lea     ($0098,A4),A0
02:000306CE 10302000        	  2666:     move.b  (A0,D2.W),D0
02:000306D2 0200000C        	  2667:     andi.b #$0C,D0
02:000306D6 6710            	  2668:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  2669:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  2670:     ; and current coordinate to the trap's Y.
                            	  2671:     ;
02:000306D8 7600            	  2672:     moveq   #0,D3
02:000306DA 41EC0084        	  2673:     lea     ($0084,A4),A0
02:000306DE 16302000        	  2674:     move.b  (A0,D2.W),D3
02:000306E2 103C0090        	  2675:     move.b  #$90,D0
02:000306E6 1880            	  2676:     move.b  D0,($0000,A4)
                            	  2677:     even
                            	  2678: _L_z01_UpdateTrap_Full_Finish:
                            	  2679:     ; If in state 2, then go finish handling it.
                            	  2680:     ;
02:000306E8 41EC00AC        	  2681:     lea     ($00AC,A4),A0
02:000306EC 10302000        	  2682:     move.b  (A0,D2.W),D0
02:000306F0 02000001        	  2683:     andi.b #$01,D0
02:000306F4 6744            	  2684:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  2685:     ; Finish handling state 1.
                            	  2686:     ;
                            	  2687:     ; Get the distance between the current coordinate and the target.
                            	  2688:     ;
02:000306F6 1003            	  2689:     move.b  D3,D0
02:000306F8 003C0011        	  2690:     ori     #$11,CCR  ; SEC: set C+X
02:000306FC 1214            	  2691:     move.b  ($0000,A4),D1
02:000306FE 0A3C0010        	  2692:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030702 9101            	  2693:     subx.b  D1,D0   ; SBC $00
02:00030704 0A3C0010        	  2694:     eori    #$10,CCR  ; restore X = 6502 C
02:00030708 61000764        	  2695:     jsr     Abs
                            	  2696:     ; If distance >= 5, go draw.
                            	  2697:     ;
02:0003070C 0C000005        	  2698:     cmpi.b  #$05,D0
02:00030710 6426            	  2699:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  2700:     ; Else reverse direction, and advace to state 2
                            	  2701:     ; with q-speed $20 (0.5 pixels a frame) (slow).
                            	  2702:     ;
02:00030712 41EC0098        	  2703:     lea     ($0098,A4),A0
02:00030716 10302000        	  2704:     move.b  (A0,D2.W),D0
02:0003071A 6100074E        	  2705:     jsr     GetOppositeDir
02:0003071E 41EC0098        	  2706:     lea     ($0098,A4),A0
02:00030722 11802000        	  2707:     move.b  D0,(A0,D2.W)
02:00030726 7020            	  2708:     moveq   #32,D0
02:00030728 41EC03BC        	  2709:     lea     ($03BC,A4),A0
02:0003072C 11802000        	  2710:     move.b  D0,(A0,D2.W)
02:00030730 41EC00AC        	  2711:     lea     ($00AC,A4),A0
02:00030734 52302000        	  2712:     addq.b  #1,(A0,D2.W)
