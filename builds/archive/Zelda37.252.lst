02:00030F48 0A3C0010        	  3980:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030F4C 9101            	  3981:     subx.b  D1,D0   ; SBC $04
02:00030F4E 0A3C0010        	  3982:     eori    #$10,CCR  ; restore X = 6502 C
02:00030F52 0C000008        	  3983:     cmpi.b  #$08,D0
02:00030F56 6538            	  3984:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  3985:     even
                            	  3986: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  3987:     ; TODO: call it speed index or angle?
                            	  3988:     ; Otherwise, go to the next speed index (angle).
                            	  3989:     ;
