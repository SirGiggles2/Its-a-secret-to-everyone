02:000324B0 1940000E        	  6899:     move.b  D0,($000E,A4)
                            	  6900: ; Params:
                            	  6901: ; X: monster object slot
                            	  6902: ; [00]: weapon object slot
                            	  6903: ; [02]: monster object mid X
                            	  6904: ; [03]: monster object mid Y
                            	  6905: ; [07]: damage points
                            	  6906: ; [09]: damage type
                            	  6907: ; [0D]: horizontal threshold
                            	  6908: ; [0E]: vertical threshold
                            	  6909: ;
                            	  6910: ; Returns:
                            	  6911: ; [06]: 1 if objects collide
                            	  6912: ;
                            	  6913:     even
                            	  6914: CheckMonsterSlenderWeaponCollision2:
02:000324B4 7600            	  6915:     moveq   #0,D3
02:000324B6 1614            	  6916:     move.b  ($0000,A4),D3
                            	  6917:     ; If Link is facing vertically, then:
                            	  6918:     ; [04] := (weapon X + 6)
                            	  6919:     ; A    := (weapon Y + 8)
                            	  6920:     ;
                            	  6921:     ; Shouldn't it be based on the weapon's direction?
                            	  6922:     ;
02:000324B8 102C0098        	  6923:     move.b  ($0098,A4),D0
02:000324BC 0200000C        	  6924:     andi.b #$0C,D0
02:000324C0 6726            	  6925:     beq  _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal
02:000324C2 10343070        	  6926:     move.b  ($70,A4,D3.W),D0
02:000324C6 023C00EE        	  6927:     andi    #$EE,CCR  ; CLC: clear C+X
02:000324CA 123C0006        	  6928:     move.b  #$06,D1
02:000324CE D101            	  6929:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
02:000324D0 19400004        	  6930:     move.b  D0,($0004,A4)
02:000324D4 41EC0084        	  6931:     lea     ($0084,A4),A0
02:000324D8 10303000        	  6932:     move.b  (A0,D3.W),D0
02:000324DC 023C00EE        	  6933:     andi    #$EE,CCR  ; CLC: clear C+X
02:000324E0 123C0008        	  6934:     move.b  #$08,D1
02:000324E4 D101            	  6935:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000324E6 6024            	  6936:     jmp     _anon_z01_98
                            	  6937: 
                            	  6938:     even
                            	  6939: _L_z01_CheckMonsterSlenderWeaponCollision2_CheckHorizontal:
                            	  6940:     ; Else Link is facing horizontally.
                            	  6941:     ; [04] := (weapon X + 8)
                            	  6942:     ; A    := (weapon Y + 6)
                            	  6943:     ;
                            	  6944:     ; Shouldn't it be based on the weapon's direction?
                            	  6945:     ;
02:000324E8 10343070        	  6946:     move.b  ($70,A4,D3.W),D0
02:000324EC 023C00EE        	  6947:     andi    #$EE,CCR  ; CLC: clear C+X
02:000324F0 123C0008        	  6948:     move.b  #$08,D1
02:000324F4 D101            	  6949:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000324F6 19400004        	  6950:     move.b  D0,($0004,A4)
02:000324FA 41EC0084        	  6951:     lea     ($0084,A4),A0
02:000324FE 10303000        	  6952:     move.b  (A0,D3.W),D0
02:00032502 023C00EE        	  6953:     andi    #$EE,CCR  ; CLC: clear C+X
02:00032506 123C0006        	  6954:     move.b  #$06,D1
02:0003250A D101            	  6955:     addx.b  D1,D0   ; ADC #$06 (X flag = 6502 C)
                            	  6956: _anon_z01_98:
                            	  6957:     ; The A register will be copied to [05] and used here.
                            	  6958:     ;
02:0003250C 6000FC0C        	  6959:     jmp     CheckMonsterWeaponCollision
                            	  6960: 
                            	  6961: ; Params:
                            	  6962: ; A: collision distance threshold (objects collide if nearer in X and Y)
                            	  6963: ; [00]: weapon object slot (unused)
                            	  6964: ; [02]: object 1 mid X
                            	  6965: ; [03]: object 1 mid Y
                            	  6966: ; [04]: object 2 mid X
                            	  6967: ; [05]: object 2 mid Y
                            	  6968: ;
                            	  6969: ; Returns:
                            	  6970: ; A: 1 if objects collide
                            	  6971: ; Y: weapon object slot
                            	  6972: ; Z: 0 if objects collide
                            	  6973: ; [06]: 1 if objects collide
                            	  6974: ; [0A]: horizontal distance
                            	  6975: ; [0B]: vertical distance
                            	  6976: ;
                            	  6977: ;
                            	  6978: ; Use the same threshold value horizontally and vertically.
                            	  6979: ; Copy it to [0D] for horizontal threshold, and [0E] for vertical one.
                            	  6980: ;
                            	  6981:     even
                            	  6982: DoObjectsCollide:
02:00032510 1940000D        	  6983:     move.b  D0,($000D,A4)
02:00032514 1940000E        	  6984:     move.b  D0,($000E,A4)
                            	  6985: ; Params:
                            	  6986: ; [00]: weapon or Link object slot (unused)
                            	  6987: ; [02]: object 1 mid X
                            	  6988: ; [03]: object 1 mid Y
                            	  6989: ; [04]: object 2 mid X
                            	  6990: ; [05]: object 2 mid Y
                            	  6991: ; [0D]: horizontal threshold
                            	  6992: ; [0E]: vertical threshold
                            	  6993: ;
                            	  6994: ; Returns:
                            	  6995: ; A: 1 if objects collide
                            	  6996: ; Y: weapon or Link object slot (copied from [00])
                            	  6997: ; Z: 0 if objects collide
                            	  6998: ; [06]: 1 if objects collide
                            	  6999: ; [0A]: horizontal distance
                            	  7000: ; [0B]: vertical distance
                            	  7001: ;
                            	  7002: ;
                            	  7003: ; Reset [06] to indicate no collision by default.
                            	  7004: ;
                            	  7005:     even
                            	  7006: DoObjectsCollideWithThresholds:
02:00032518 60009BA6        	  7007:     jmp     c_do_objects_collide_with_thresholds
                            	  7008: 
                            	  7009: BeginShove:
02:0003251C 7600            	  7010:     moveq   #0,D3
02:0003251E 1614            	  7011:     move.b  ($0000,A4),D3
02:00032520 0C02000D        	  7012:     cmpi.b  #$0D,D2
02:00032524 6412            	  7013:     bcc  _anon_z01_99
02:00032526 41EC04B2        	  7014:     lea     ($04B2,A4),A0
02:0003252A 10302000        	  7015:     move.b  (A0,D2.W),D0
02:0003252E 122C0009        	  7016:     move.b  ($0009,A4),D1
02:00032532 C001            	  7017:     and.b  D1,D0
02:00032534 660000C4        	  7018:     bne  _L_z01_BeginShove_Exit
                            	  7019: _anon_z01_99:
                            	  7020:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7021:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7022:     ;
                            	  7023:     ; If instead a monster is defending, then all this calculation
                            	  7024:     ; won't matter, because the shove direction will be set to the
                            	  7025:     ; weapon's direction.
                            	  7026:     ;
                            	  7027:     ; As such, calculate a direction from the monster to the defender,
                            	  7028:     ; assuming it's Link.
                            	  7029:     ;
                            	  7030:     ; Start with an assumption that the direction is vertical:
                            	  7031:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7032:     ;
02:00032538 7008            	  7033:     moveq   #8,D0
02:0003253A 19400008        	  7034:     move.b  D0,($0008,A4)
02:0003253E 41EC0084        	  7035:     lea     ($0084,A4),A0
02:00032542 10302000        	  7036:     move.b  (A0,D2.W),D0
02:00032546 19400004        	  7037:     move.b  D0,($0004,A4)
02:0003254A 41EC0084        	  7038:     lea     ($0084,A4),A0
02:0003254E 10303000        	  7039:     move.b  (A0,D3.W),D0
02:00032552 19400005        	  7040:     move.b  D0,($0005,A4)
                            	  7041:     ; If the defender is Link and his grid offset <> 0 then
                            	  7042:     ; use his usual object direction variable to determine
                            	  7043:     ; which axis to check.
                            	  7044:     ;
02:00032556 4A03            	  7045:     cmpi.b  #$00,D3
02:00032558 6612            	  7046:     bne  _anon_z01_100
02:0003255A 102C0394        	  7047:     move.b  ($0394,A4),D0
02:0003255E 670C            	  7048:     beq  _anon_z01_100
02:00032560 102C0098        	  7049:     move.b  ($0098,A4),D0
02:00032564 02000003        	  7050:     andi.b #$03,D0
02:00032568 660C            	  7051:     bne  _L_z01_BeginShove_CheckHorizontal
02:0003256A 6720            	  7052:     beq  _L_z01_BeginShove_CheckVertical
                            	  7053: _anon_z01_100:
                            	  7054:     ; For monsters defending, or Link with grid offset = 0,
                            	  7055:     ; check direction in [0B].
                            	  7056:     ;
                            	  7057:     ; For monsters defending, this won't matter. For Link with grid
                            	  7058:     ; offset = 0, I believe the result will be arbitrary.
                            	  7059:     ;
                            	  7060:     ; TODO:
                            	  7061:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7062:     ; It doesn't seem to be if candle fire attacks him.
                            	  7063:     ;
02:0003256C 102C000B        	  7064:     move.b  ($000B,A4),D0
02:00032570 0C000004        	  7065:     cmpi.b  #$04,D0
02:00032574 6416            	  7066:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7067:     even
                            	  7068: _L_z01_BeginShove_CheckHorizontal:
                            	  7069:     ; If the direction checked is left or right,
                            	  7070:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7071:     ;
02:00032576 7002            	  7072:     moveq   #2,D0
02:00032578 19400008        	  7073:     move.b  D0,($0008,A4)
02:0003257C 10342070        	  7074:     move.b  ($70,A4,D2.W),D0
02:00032580 19400004        	  7075:     move.b  D0,($0004,A4)
02:00032584 10343070        	  7076:     move.b  ($70,A4,D3.W),D0
02:00032588 19400005        	  7077:     move.b  D0,($0005,A4)
                            	  7078:     even
                            	  7079: _L_z01_BeginShove_CheckVertical:
                            	  7080:     ; If the monster is down or right of the other object,
                            	  7081:     ; then use the opposite direction already in [08].
                            	  7082:     ; Else shift [08] right to turn it into the opposite
                            	  7083:     ; direction up or down.
                            	  7084:     ;
                            	  7085:     ; Again assuming Link is the defender; after this, [08] points
                            	  7086:     ; Link away from the monster.
                            	  7087:     ;
02:0003258C 102C0004        	  7088:     move.b  ($0004,A4),D0
02:00032590 122C0005        	  7089:     move.b  ($0005,A4),D1
02:00032594 B001            	  7090:     cmp.b   D1,D0
02:00032596 640A            	  7091:     bcc  _anon_z01_101
02:00032598 122C0008        	  7092:     move.b  ($0008,A4),D1
02:0003259C E209            	  7093:     lsr.b  #1,D1   ; LSR $08
02:0003259E 19410008        	  7094:     move.b  D1,($0008,A4)
                            	  7095: _anon_z01_101:
                            	  7096:     ; If a monster is the defender, go handle it separately.
                            	  7097:     ;
02:000325A2 4A03            	  7098:     cmpi.b  #$00,D3
02:000325A4 6656            	  7099:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7100:     ; Link is the defender.
                            	  7101:     ;
                            	  7102:     ; If Link is invincible, return without shoving.
                            	  7103:     ;
02:000325A6 102C04F0        	  7104:     move.b  ($04F0,A4),D0
02:000325AA 664E            	  7105:     bne  _L_z01_BeginShove_Exit
                            	  7106:     ; Store the shove direction we determined.
                            	  7107:     ;
                            	  7108:     ; Turn on the high bit to indicate that the next time we try to
                            	  7109:     ; move by shoving, it will be the first time for this shove action.
                            	  7110:     ;
02:000325AC 102C0008        	  7111:     move.b  ($0008,A4),D0
02:000325B0 00000080        	  7112:     ori.b #$80,D0
02:000325B4 194000C0        	  7113:     move.b  D0,($00C0,A4)
                            	  7114:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7115:     ;
02:000325B8 7018            	  7116:     moveq   #24,D0
02:000325BA 194004F0        	  7117:     move.b  D0,($04F0,A4)
02:000325BE 7020            	  7118:     moveq   #32,D0
02:000325C0 194000D3        	  7119:     move.b  D0,($00D3,A4)
                            	  7120:     ; If Link was shoved by one of his own weapons, then
                            	  7121:     ; nothing else to do. Return.
                            	  7122:     ;
02:000325C4 0C02000D        	  7123:     cmpi.b  #$0D,D2
02:000325C8 6430            	  7124:     bcc  _L_z01_BeginShove_Exit
                            	  7125:     ; Link was shoved by a monster.
                            	  7126:     ;
                            	  7127:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7128:     ; then return.
                            	  7129:     ;
02:000325CA 41EC04BF        	  7130:     lea     ($04BF,A4),A0
02:000325CE 10302000        	  7131:     move.b  (A0,D2.W),D0
02:000325D2 02000080        	  7132:     andi.b #$80,D0
02:000325D6 6622            	  7133:     bne  _L_z01_BeginShove_Exit
                            	  7134:     ; If the attacker is a vire, then return.
                            	  7135:     ;
02:000325D8 41EC034F        	  7136:     lea     ($034F,A4),A0
02:000325DC 10302000        	  7137:     move.b  (A0,D2.W),D0
02:000325E0 0C000012        	  7138:     cmpi.b  #$12,D0
02:000325E4 6714            	  7139:     beq  _L_z01_BeginShove_Exit
                            	  7140:     ; Turn the attacker in the opposite direction.
                            	  7141:     ;
02:000325E6 41EC0098        	  7142:     lea     ($0098,A4),A0
02:000325EA 10302000        	  7143:     move.b  (A0,D2.W),D0
02:000325EE 6100E87A        	  7144:     jsr     GetOppositeDir
02:000325F2 41EC0098        	  7145:     lea     ($0098,A4),A0
02:000325F6 11802000        	  7146:     move.b  D0,(A0,D2.W)
                            	  7147:     even
                            	  7148: _L_z01_BeginShove_Exit:
02:000325FA 4E75            	  7149:     rts
                            	  7150: 
                            	  7151:     even
                            	  7152: _L_z01_BeginShove_MonsterDefender:
                            	  7153:     ; A monster is the defender. A weapon is the attacker.
                            	  7154:     ;
                            	  7155:     ; Set the shove direction to the weapon's direction,
                            	  7156:     ; instead of the direction passed in [0B].
                            	  7157:     ;
02:000325FC 41EC0098        	  7158:     lea     ($0098,A4),A0
02:00032600 10303000        	  7159:     move.b  (A0,D3.W),D0
02:00032604 19400008        	  7160:     move.b  D0,($0008,A4)
                            	  7161:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  7162:     ; combine the shove direction with $40.
                            	  7163:     ;
                            	  7164:     ; TODO:
                            	  7165:     ; But the shoving routing doesn't read this flag.
                            	  7166:     ;
02:00032608 41EC04BF        	  7167:     lea     ($04BF,A4),A0
02:0003260C 10302000        	  7168:     move.b  (A0,D2.W),D0
02:00032610 02000080        	  7169:     andi.b #$80,D0
02:00032614 670C            	  7170:     beq  _anon_z01_102
02:00032616 102C0008        	  7171:     move.b  ($0008,A4),D0
02:0003261A 00000040        	  7172:     ori.b #$40,D0
