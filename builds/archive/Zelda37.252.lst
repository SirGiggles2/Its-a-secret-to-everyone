02:0004C348 41EC03D0        	  5785:     lea     ($03D0,A4),A0
02:0004C34C 11802000        	  5786:     move.b  D0,(A0,D2.W)
02:0004C350 41EC00AC        	  5787:     lea     ($00AC,A4),A0
02:0004C354 52302000        	  5788:     addq.b  #1,(A0,D2.W)
02:0004C358 41EC00AC        	  5789:     lea     ($00AC,A4),A0
02:0004C35C 10302000        	  5790:     move.b  (A0,D2.W),D0
02:0004C360 02000077        	  5791:     andi.b #$77,D0
02:0004C364 41EC00AC        	  5792:     lea     ($00AC,A4),A0
02:0004C368 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:0004C36C 0C02000D        	  5794:     cmpi.b  #$0D,D2
02:0004C370 6402            	  5795:     bcc.s  __far_z_07_0087
02:0004C372 6032            	  5796:     jmp  CalcBoomerangFrame
                            	  5797: __far_z_07_0087:
