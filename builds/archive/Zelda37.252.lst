02:00031F4A 6602            	  6049:     bne.s  __far_z_01_0059
02:00031F4C 6068            	  6050:     jmp  HarmLink
                            	  6051: __far_z_01_0059:
02:00031F4E 102C00AC        	  6052:     move.b  ($00AC,A4),D0
02:00031F52 020000F0        	  6053:     andi.b #$F0,D0
02:00031F56 6702            	  6054:     beq.s  __far_z_01_0060
02:00031F58 605C            	  6055:     jmp  HarmLink
                            	  6056: __far_z_01_0060:
                            	  6057:     ; If Link and the shot are not facing opposite directions,
                            	  6058:     ; then go harm Link.
                            	  6059:     ;
                            	  6060:     ; Note the bitwise AND in the test. It picks out one direction
                            	  6061:     ; component of a monster that can move diagonally.
                            	  6062:     ;
02:00031F5A 102C0098        	  6063:     move.b  ($0098,A4),D0
02:00031F5E 41EC0098        	  6064:     lea     ($0098,A4),A0
02:00031F62 12302000        	  6065:     move.b  (A0,D2.W),D1
02:00031F66 8001            	  6066:     or.b  D1,D0
02:00031F68 0200000C        	  6067:     andi.b #$0C,D0
02:00031F6C 0C00000C        	  6068:     cmpi.b  #$0C,D0
02:00031F70 671A            	  6069:     beq  _L_z01_CheckLinkCollisionPreinit_FacingOpposite
02:00031F72 102C0098        	  6070:     move.b  ($0098,A4),D0
02:00031F76 41EC0098        	  6071:     lea     ($0098,A4),A0
02:00031F7A 12302000        	  6072:     move.b  (A0,D2.W),D1
02:00031F7E 8001            	  6073:     or.b  D1,D0
02:00031F80 02000003        	  6074:     andi.b #$03,D0
02:00031F84 0C000003        	  6075:     cmpi.b  #$03,D0
02:00031F88 6702            	  6076:     beq.s  __far_z_01_0061
02:00031F8A 602A            	  6077:     jmp  HarmLink
                            	  6078: __far_z_01_0061:
                            	  6079:     even
                            	  6080: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6081:     ; Link and the shot are facing opposite directions.
                            	  6082:     ; Link can parry certain weapons/shots.
                            	  6083:     ;
                            	  6084:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6085:     ; no harmful collision; but it still counts as a shot collision.
                            	  6086:     ; So, go treat this as a parry.
                            	  6087:     ;
02:00031F8C 41EC034F        	  6088:     lea     ($034F,A4),A0
02:00031F90 10302000        	  6089:     move.b  (A0,D2.W),D0
02:00031F94 0C000055        	  6090:     cmpi.b  #$55,D0
02:00031F98 650E            	  6091:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00031F9A 0C00005B        	  6092:     cmpi.b  #$5B,D0
02:00031F9E 6408            	  6093:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6094:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6095:     ; So, go harm Link.
                            	  6096:     ;
02:00031FA0 102C0676        	  6097:     move.b  ($0676,A4),D0
02:00031FA4 6602            	  6098:     bne.s  __far_z_01_0062
02:00031FA6 600E            	  6099:     jmp  HarmLink
                            	  6100: __far_z_01_0062:
                            	  6101:     even
                            	  6102: _L_z01_CheckLinkCollisionPreinit_Parry:
                            	  6103:     ; Else Link parries.
                            	  6104:     ;
                            	  6105:     ; Play the "parry" tune, and cancel the collision (reset [06]).
                            	  6106:     ;
02:00031FA8 7001            	  6107:     moveq   #1,D0
02:00031FAA 19400604        	  6108:     move.b  D0,($0604,A4)
02:00031FAE 7000            	  6109:     moveq   #0,D0
02:00031FB0 19400006        	  6110:     move.b  D0,($0006,A4)
                            	  6111:     even
