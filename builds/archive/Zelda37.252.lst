02:0004C8D2 6A04            	  6552:     bpl.s  __far_z_07_0111
02:0004C8D4 60000098        	  6553:     jmp  DrawBomb
                            	  6554: __far_z_07_0111:
                            	  6555:     ; If the bomb's X is not within $18 pixels of the hotspot, then
                            	  6556:     ; go check the next hotspot.
                            	  6557:     ;
02:0004C8D8 41F90004C828    	  6558:     lea     (BombableWallHotspotsX).l,A0
02:0004C8DE 10303000        	  6559:     move.b  (A0,D3.W),D0
02:0004C8E2 003C0011        	  6560:     ori     #$11,CCR  ; SEC: set C+X
02:0004C8E6 12342070        	  6561:     move.b  ($70,A4,D2.W),D1
02:0004C8EA 0A3C0010        	  6562:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C8EE 9101            	  6563:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C8F0 0A3C0010        	  6564:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C8F4 4EB900030E6E    	  6565:     jsr     Abs
02:0004C8FA 0C000018        	  6566:     cmpi.b  #$18,D0
02:0004C8FE 64D0            	  6567:     bcc  _L_z07_Bomb_CheckState4_LoopHotspot
                            	  6568:     ; If the bomb's Y is not within $18 pixels of the hotspot, then
                            	  6569:     ; go check the next hotspot.
                            	  6570:     ;
02:0004C900 41F90004C82C    	  6571:     lea     (BombableWallHotspotsY).l,A0
02:0004C906 10303000        	  6572:     move.b  (A0,D3.W),D0
02:0004C90A 003C0011        	  6573:     ori     #$11,CCR  ; SEC: set C+X
02:0004C90E 41EC0084        	  6574:     lea     ($0084,A4),A0
02:0004C912 12302000        	  6575:     move.b  (A0,D2.W),D1
02:0004C916 0A3C0010        	  6576:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C91A 9101            	  6577:     subx.b  D1,D0   ; SBC ObjY,X
02:0004C91C 0A3C0010        	  6578:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C920 4EB900030E6E    	  6579:     jsr     Abs
02:0004C926 0C000018        	  6580:     cmpi.b  #$18,D0
02:0004C92A 64A4            	  6581:     bcc  _L_z07_Bomb_CheckState4_LoopHotspot
                            	  6582:     ; Store in [02] the direction corresponding to the hotspot's index.
                            	  6583:     ;
