                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:0004012E 103C00FD        	   447:     move.b  #$FD,D0
02:00040132 613A            	   448:     jsr     MovePositionMarkers
02:00040134 102C00FC        	   449:     move.b  ($00FC,A4),D0
02:00040138 023C00EE        	   450:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004013C 123C0003        	   451:     move.b  #$03,D1
02:00040140 D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00040142 194000FC        	   453:     move.b  D0,($00FC,A4)
                            	   454:     ; If hardware vertical scroll still < $F0, then return.
                            	   455:     ;
02:00040146 0C0000F0        	   456:     cmpi.b  #$F0,D0
02:0004014A 6406            	   457:     bcc.s  __far_z_05_0001
02:0004014C 4EF90002D89A    	   458:     jmp  Exit
                            	   459: __far_z_05_0001:
                            	   460:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   461:     ;
02:00040152 1940005C        	   462:     move.b  D0,($005C,A4)
                            	   463:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   464:     ;
                            	   465:     ; UNKNOWN: But why not do this in OW, too?
                            	   466:     ;
02:00040156 102C0010        	   467:     move.b  ($0010,A4),D0
02:0004015A 6706            	   468:     beq  _anon_z05_4
02:0004015C 4EB9000316E4    	   469:     jsr     WriteBlankPrioritySprites
                            	   470: _anon_z05_4:
                            	   471:     ; We reached the end. So, reset hardware vertical scroll
                            	   472:     ; and submenu state.
                            	   473:     ;
02:00040162 7000            	   474:     moveq   #0,D0
02:00040164 194000FC        	   475:     move.b  D0,($00FC,A4)
02:00040168 194000E1        	   476:     move.b  D0,($00E1,A4)
                            	   477:     ; Move the position markers 2 pixels down, because we
                            	   478:     ; overshot and reached vertical scroll $F2.
                            	   479:     ;
02:0004016C 7002            	   480:     moveq   #2,D0
                            	   481: ; Params:
                            	   482: ; A: vertical velocity of menu scrolling
                            	   483: ;
                            	   484: ;
                            	   485: ; [00] holds the vertical velocity of menu scrolling.
                            	   486:     even
                            	   487: MovePositionMarkers:
02:0004016E 1880            	   488:     move.b  D0,($0000,A4)
                            	   489:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   490:     ;
02:00040170 102C0254        	   491:     move.b  ($0254,A4),D0
02:00040174 0C0000F8        	   492:     cmpi.b  #$F8,D0
02:00040178 670C            	   493:     beq  _anon_z05_5
02:0004017A 023C00EE        	   494:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004017E 1214            	   495:     move.b  ($0000,A4),D1
02:00040180 D101            	   496:     addx.b  D1,D0   ; ADC $00
02:00040182 19400254        	   497:     move.b  D0,($0254,A4)
                            	   498: _anon_z05_5:
