02:00034F8E 60E4            	  2544:     jmp  LA10A_Exit
                            	  2545: __far_z_02_0007:
                            	  2546:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2547:     ; in the current slot's name.
02:00034F90 41F90003499E    	  2548:     lea     (SlotToNameOffset).l,A0
02:00034F96 10303000        	  2549:     move.b  (A0,D3.W),D0
02:00034F9A 19400421        	  2550:     move.b  D0,($0421,A4)
                            	  2551:     ; Get the offset of the end of the initial name character
                            	  2552:     ; transfer record header for the current slot.
02:00034F9E 7400            	  2553:     moveq   #0,D2
02:00034FA0 41F9000349A2    	  2554:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00034FA6 14303000        	  2555:     move.b  (A0,D3.W),D2
02:00034FAA 7602            	  2556:     moveq   #2,D3
                            	  2557:     even
                            	  2558: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00034FAC 41F90003496E    	  2559:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00034FB2 10302000        	  2560:     move.b  (A0,D2.W),D0
02:00034FB6 41EC0422        	  2561:     lea     ($0422,A4),A0
02:00034FBA 11803000        	  2562:     move.b  D0,(A0,D3.W)
02:00034FBE 5302            	  2563:     subq.b  #1,D2
02:00034FC0 5303            	  2564:     subq.b  #1,D3
02:00034FC2 6AE8            	  2565:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00034FC4 522C0420        	  2566:     addq.b  #1,($0420,A4)
                            	  2567:     even
                            	  2568: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2569:     ; At this point:
                            	  2570:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2571:     ;   - This will be changed as the player inputs characters.
                            	  2572:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2573:     ;   - This will be changed as the player inputs characters.
                            	  2574:     ; - InitializedNameField [$0420] is set to 1.
                            	  2575:     ;
02:00034FC8 102C00F8        	  2576:     move.b  ($00F8,A4),D0
02:00034FCC 020000C0        	  2577:     andi.b #$C0,D0
02:00034FD0 670000E8        	  2578:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2579:     ; A or B was pressed.
                            	  2580:     ;
02:00034FD4 0C000040        	  2581:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:00034FD8 660000A6        	  2582:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2583:     ; A was pressed.
                            	  2584:     ;
                            	  2585:     ; Request to play the character click tune (same as bomb set).
02:00034FDC 7620            	  2586:     moveq   #32,D3
02:00034FDE 19430604        	  2587:     move.b  D3,($0604,A4)
02:00034FE2 7602            	  2588:     moveq   #2,D3
                            	  2589:     even
                            	  2590: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:00034FE4 41EC0422        	  2591:     lea     ($0422,A4),A0
02:00034FE8 10303000        	  2592:     move.b  (A0,D3.W),D0
02:00034FEC 41EC0302        	  2593:     lea     ($0302,A4),A0
02:00034FF0 11803000        	  2594:     move.b  D0,(A0,D3.W)
02:00034FF4 5303            	  2595:     subq.b  #1,D3
02:00034FF6 6AEC            	  2596:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:00034FF8 19430306        	  2597:     move.b  D3,($0306,A4)
02:00034FFC 7400            	  2598:     moveq   #0,D2
02:00034FFE 142C0421        	  2599:     move.b  ($0421,A4),D2
02:00035002 7600            	  2600:     moveq   #0,D3
02:00035004 162C041F        	  2601:     move.b  ($041F,A4),D3
02:00035008 41F900034942    	  2602:     lea     (ModeE_CharMap).l,A0
02:0003500E 10303000        	  2603:     move.b  (A0,D3.W),D0
02:00035012 19400305        	  2604:     move.b  D0,($0305,A4)
