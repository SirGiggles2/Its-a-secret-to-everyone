02:0003D054 10302000        	  7770:     move.b  (A0,D2.W),D0
02:0003D058 41EC042C        	  7771:     lea     ($042C,A4),A0
02:0003D05C 12302000        	  7772:     move.b  (A0,D2.W),D1
02:0003D060 B001            	  7773:     cmp.b   D1,D0
02:0003D062 65000096        	  7774:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7775:     ; Else reached the destination. Go to state 0.
