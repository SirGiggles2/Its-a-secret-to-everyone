02:000452D0 7600            	  9073:     moveq   #0,D3
02:000452D2 162C0656        	  9074:     move.b  ($0656,A4),D3
02:000452D6 41EC0657        	  9075:     lea     ($0657,A4),A0
02:000452DA 10303000        	  9076:     move.b  (A0,D3.W),D0
02:000452DE 660A            	  9077:     bne  _anon_z05_215
                            	  9078:     even
