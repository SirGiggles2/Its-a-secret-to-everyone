                            	  7418: _L_z07_P47_post2_ok:
                            	  7419:     ; Extract and set the monster's location.
                            	  7420:     ;
02:0004D008 102C0525        	  7421:     move.b  ($0525,A4),D0
                            	  7422:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7423:     ;
02:0004D00C 1B00            	  7424:     move.b  D0,-(A5)  ; PHA
02:0004D00E E308            	  7425:     lsl.b  #1,D0   ; ASL A
