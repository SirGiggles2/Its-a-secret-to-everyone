                            	  7335: _L_z07_InitObject_InitMonsterFromEdge:
02:0004CF50 7400            	  7336:     moveq   #0,D2
02:0004CF52 142C0340        	  7337:     move.b  ($0340,A4),D2
                            	  7338:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7339:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7340:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7341:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7342:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7343:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7344:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7345:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7346:     ; corrupting them and causing a deterministic address-error
                            	  7347:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7348:     ; identified by Codex static review.)
                            	  7349: _L_z07_P47_pre_check:
