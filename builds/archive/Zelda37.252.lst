02:0003F5F2 6100A414        	 12824:     jsr     PlayBossHitCryIfNeeded
02:0003F5F6 7040            	 12825:     moveq   #64,D0
02:0003F5F8 19802028        	 12826:     move.b  D0,($28,A4,D2.W)
                            	 12827:     even
                            	 12828: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12829:     ; Reset metastate, because Ganon cannot die this way.
                            	 12830:     ;
02:0003F5FC 4EB90004D314    	 12831:     jsr     ResetObjMetastate
