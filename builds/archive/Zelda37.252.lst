02:0004C1BC 41EC034F        	  5558:     lea     ($034F,A4),A0
02:0004C1C0 10302000        	  5559:     move.b  (A0,D2.W),D0
02:0004C1C4 0C00005B        	  5560:     cmpi.b  #$5B,D0
02:0004C1C8 670A            	  5561:     beq  _L_z07_DrawArrowOrBoomerangAndCheckCollisions_PrepareArrow
                            	  5562:     even
