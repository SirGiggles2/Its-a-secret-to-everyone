02:0003DD18 10302000        	  9479:     move.b  (A0,D2.W),D0
02:0003DD1C 122C0002        	  9480:     move.b  ($0002,A4),D1
02:0003DD20 E309            	  9481:     lsl.b  #1,D1   ; ASL $02
02:0003DD22 19410002        	  9482:     move.b  D1,($0002,A4)
02:0003DD26 122C0002        	  9483:     move.b  ($0002,A4),D1
02:0003DD2A C200            	  9484:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DD2C 6716            	  9485:     beq  _L_z04_Manhandla_Move_Up
02:0003DD2E 41EC0084        	  9486:     lea     ($0084,A4),A0
02:0003DD32 10302000        	  9487:     move.b  (A0,D2.W),D0
02:0003DD36 122C0003        	  9488:     move.b  ($0003,A4),D1
