02:0004C992 41EC00AC        	  6650:     lea     ($00AC,A4),A0
02:0004C996 10302000        	  6651:     move.b  (A0,D2.W),D0
02:0004C99A 0200000F        	  6652:     andi.b #$0F,D0
02:0004C99E 003C0011        	  6653:     ori     #$11,CCR  ; SEC: set C+X
02:0004C9A2 123C0002        	  6654:     move.b  #$02,D1
02:0004C9A6 0A3C0010        	  6655:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C9AA 9101            	  6656:     subx.b  D1,D0   ; SBC #$02
02:0004C9AC 0A3C0010        	  6657:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6658: ; Params:
