                            	  6613:     even
                            	  6614: DrawBomb:
                            	  6615:     ; Draw the bomb or dust cloud.
                            	  6616:     ;
02:0004C96E 610001A4        	  6617:     jsr     Anim_FetchObjPosForSpriteDescriptor
