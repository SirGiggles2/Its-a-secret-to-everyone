02:0003203A 122C000E        	  6185:     move.b  ($000E,A4),D1
02:0003203E 0A3C0010        	  6186:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032042 9101            	  6187:     subx.b  D1,D0   ; SBC $0E
