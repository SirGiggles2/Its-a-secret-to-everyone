02:0002E98A 41EC0302        	   781:     lea     ($0302,A4),A0
02:0002E98E 11803000        	   782:     move.b  D0,(A0,D3.W)
02:0002E992 5303            	   783:     subq.b  #1,D3
02:0002E994 6AEA            	   784:     bpl  _anon_z01_7
                            	   785:     even
                            	   786: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   787:     ; Replace the low byte of the VRAM address with the one
                            	   788:     ; where the next character should be written.
                            	   789:     ;
02:0002E996 102C045F        	   790:     move.b  ($045F,A4),D0
02:0002E99A 19400303        	   791:     move.b  D0,($0303,A4)
                            	   792:     ; Increment the low VRAM address for the next character.
                            	   793:     ;
02:0002E99E 522C045F        	   794:     addq.b  #1,($045F,A4)
                            	   795:     ; Use the person text selector to look up the address of the
                            	   796:     ; text for the textbox. Store the address in [00:01].
                            	   797:     ;
02:0002E9A2 7600            	   798:     moveq   #0,D3
02:0002E9A4 162C0415        	   799:     move.b  ($0415,A4),D3
02:0002E9A8 41F90002DFDE    	   800:     lea     (PersonTextAddrs).l,A0
02:0002E9AE 10303000        	   801:     move.b  (A0,D3.W),D0
02:0002E9B2 1880            	   802:     move.b  D0,($0000,A4)
02:0002E9B4 5203            	   803:     addq.b  #1,D3
02:0002E9B6 41F90002DFDE    	   804:     lea     (PersonTextAddrs).l,A0
02:0002E9BC 10303000        	   805:     move.b  (A0,D3.W),D0
02:0002E9C0 19400001        	   806:     move.b  D0,($0001,A4)
                            	   807:     ; Load the person text current character index.
                            	   808:     ;
02:0002E9C4 7600            	   809:     moveq   #0,D3
02:0002E9C6 162C0416        	   810:     move.b  ($0416,A4),D3
                            	   811:     ; Increment the index variable to point to the next character
                            	   812:     ; for next time.
                            	   813:     ;
02:0002E9CA 522C0416        	   814:     addq.b  #1,($0416,A4)
                            	   815:     ; Get the current character.
                            	   816:     ;
02:0002E9CE 1214            	   817:     move.b  ($00,A4),D1   ; ptr lo
02:0002E9D0 182C0001        	   818:     move.b  ($01,A4),D4  ; ptr hi
02:0002E9D4 024100FF        	   819:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E9D8 E14C            	   820:     lsl.w   #8,D4
02:0002E9DA 8841            	   821:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E9DC 48C4            	   822:     ext.l   D4
02:0002E9DE D8BC00FF0000    	   823:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E9E4 2044            	   824:     movea.l D4,A0
02:0002E9E6 10303000        	   825:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   826:     ; If the character is $25, then it's a special space. It will still
                            	   827:     ; take up space, but will not take time to show -- meaning that
                            	   828:     ; we'll go look up the next character to transfer.
                            	   829:     ;
02:0002E9EA 0200003F        	   830:     andi.b #$3F,D0
02:0002E9EE 0C000025        	   831:     cmpi.b  #$25,D0
02:0002E9F2 67A2            	   832:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   833:     ; We have a non-space character. Put it in the transfer record.
                            	   834:     ;
02:0002E9F4 19400305        	   835:     move.b  D0,($0305,A4)
                            	   836:     ; Play the "heart taken/character" sound effect.
                            	   837:     ;
02:0002E9F8 7010            	   838:     moveq   #16,D0
02:0002E9FA 19400604        	   839:     move.b  D0,($0604,A4)
                            	   840:     ; If the high 2 bits of character element = 0, then return.
                            	   841:     ;
02:0002E9FE 1214            	   842:     move.b  ($00,A4),D1   ; ptr lo
02:0002EA00 182C0001        	   843:     move.b  ($01,A4),D4  ; ptr hi
02:0002EA04 024100FF        	   844:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EA08 E14C            	   845:     lsl.w   #8,D4
02:0002EA0A 8841            	   846:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002EA0C 48C4            	   847:     ext.l   D4
02:0002EA0E D8BC00FF0000    	   848:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002EA14 2044            	   849:     movea.l D4,A0
02:0002EA16 10303000        	   850:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EA1A 020000C0        	   851:     andi.b #$C0,D0
02:0002EA1E 672E            	   852:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   853:     ; Determine an index based on the high 2 bits of the character element:
                            	   854:     ;   $80: 0
                            	   855:     ;   $40: 1
                            	   856:     ;   $C0: 2
                            	   857:     ;
02:0002EA20 7602            	   858:     moveq   #2,D3
02:0002EA22 0C0000C0        	   859:     cmpi.b  #$C0,D0
02:0002EA26 670A            	   860:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002EA28 5303            	   861:     subq.b  #1,D3
02:0002EA2A 0C000040        	   862:     cmpi.b  #$40,D0
02:0002EA2E 6702            	   863:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002EA30 5303            	   864:     subq.b  #1,D3
                            	   865:     even
                            	   866: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   867:     ; The index chooses the low VRAM address of the start
                            	   868:     ; of another line:
                            	   869:     ;   0: $C4: front of the second line
                            	   870:     ;   1: $E4: front of the third line
                            	   871:     ;   2: $A4: front of the first line
                            	   872:     ;
                            	   873:     ; Look up the low VRAM address and store it.
                            	   874:     ;
02:0002EA32 41F90002E960    	   875:     lea     (TextboxLineAddrsLo).l,A0
02:0002EA38 10303000        	   876:     move.b  (A0,D3.W),D0
02:0002EA3C 1940045F        	   877:     move.b  D0,($045F,A4)
                            	   878:     ; If index = 2, then we've reached the end of the text,
                            	   879:     ; and low VRAM address is moved to the front of the first line.
                            	   880:     ; So, advance the state of the person object, and unhalt Link.
                            	   881:     ;
02:0002EA40 0C030002        	   882:     cmpi.b  #$02,D3
02:0002EA44 6608            	   883:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002EA46 522C00AD        	   884:     addq.b  #1,($00AD,A4)
02:0002EA4A 6100FB98        	   885:     jsr     UnhaltLink
                            	   886:     even
                            	   887: _L_z01_UpdatePersonState_Textbox_Exit:
02:0002EA4E 4E75            	   888:     rts
                            	   889: 
                            	   890:     even
