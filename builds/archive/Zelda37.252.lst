                            	  5589: CheckState30:
                            	  5590:     ; If major state <> $30, go check other states.
                            	  5591:     ;
02:0004C1F4 0C000030        	  5592:     cmpi.b  #$30,D0
02:0004C1F8 6656            	  5593:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5594:     ; State $3x. Slow down.
                            	  5595:     ;
                            	  5596:     ; Reset grid offset for movement.
                            	  5597:     ;
02:0004C1FA 7000            	  5598:     moveq   #0,D0
02:0004C1FC 41EC0394        	  5599:     lea     ($0394,A4),A0
02:0004C200 11802000        	  5600:     move.b  D0,(A0,D2.W)
                            	  5601:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5602:     ;
02:0004C204 7040            	  5603:     moveq   #64,D0
02:0004C206 41EC03BC        	  5604:     lea     ($03BC,A4),A0
02:0004C20A 11802000        	  5605:     move.b  D0,(A0,D2.W)
                            	  5606:     ; If facing left and X < 2, then go change state to $40. The
                            	  5607:     ; boomerang is too close to the left edge of the screen.
                            	  5608:     ; Another move might make it wrap around.
                            	  5609:     ;
02:0004C20E 41EC0098        	  5610:     lea     ($0098,A4),A0
02:0004C212 10302000        	  5611:     move.b  (A0,D2.W),D0
02:0004C216 1940000F        	  5612:     move.b  D0,($000F,A4)
02:0004C21A 02000002        	  5613:     andi.b #$02,D0
02:0004C21E 670A            	  5614:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004C220 10342070        	  5615:     move.b  ($70,A4,D2.W),D0
02:0004C224 0C000002        	  5616:     cmpi.b  #$02,D0
02:0004C228 650E            	  5617:     bcs  _L_z07_CheckState30_SetState40
                            	  5618:     even
                            	  5619: _L_z07_CheckState30_MoveBoomerang:
