02:0003AF5E 02000008        	  3191:     andi.b #$08,D0
02:0003AF62 6704            	  3192:     beq  _anon_z04_44
02:0003AF64 163C00D8        	  3193:     move.b  #$D8,D3
                            	  3194: _anon_z04_44:
02:0003AF68 1883            	  3195:     move.b  D3,($0000,A4)
                            	  3196:     ; Add Link's Y and the vertical offset.
