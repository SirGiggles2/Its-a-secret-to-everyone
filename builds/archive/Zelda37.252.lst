02:00030780 102C0070        	  2754:     move.b  ($0070,A4),D0
02:00030784 003C0011        	  2755:     ori     #$11,CCR  ; SEC: set C+X
02:00030788 12342070        	  2756:     move.b  ($70,A4,D2.W),D1
02:0003078C 0A3C0010        	  2757:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030790 9101            	  2758:     subx.b  D1,D0   ; SBC ObjX,X
02:00030792 0A3C0010        	  2759:     eori    #$10,CCR  ; restore X = 6502 C
02:00030796 610006D6        	  2760:     jsr     Abs
