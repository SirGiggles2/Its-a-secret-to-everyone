02:0004BCD0 41EC0394        	  4841:     lea     ($0394,A4),A0
02:0004BCD4 10302000        	  4842:     move.b  (A0,D2.W),D0
02:0004BCD8 02000007        	  4843:     andi.b #$07,D0
