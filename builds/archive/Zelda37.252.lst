                            	  5823: CalcBoomerangFrame:
                            	  5824:     ; The minor state (low 3 bits of state) is used to
                            	  5825:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5826:     ;
                            	  5827:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5828:     ; In other words, don't offset the coordinate below.
                            	  5829:     ;
02:0004C3A6 7000            	  5830:     moveq   #0,D0
02:0004C3A8 1880            	  5831:     move.b  D0,($0000,A4)
02:0004C3AA 41EC00AC        	  5832:     lea     ($00AC,A4),A0
02:0004C3AE 10302000        	  5833:     move.b  (A0,D2.W),D0
02:0004C3B2 0200000F        	  5834:     andi.b #$0F,D0
02:0004C3B6 7600            	  5835:     moveq   #0,D3
02:0004C3B8 1600            	  5836:     move.b  D0,D3
02:0004C3BA 7000            	  5837:     moveq   #0,D0
02:0004C3BC 19400001        	  5838:     move.b  D0,($0001,A4)
02:0004C3C0 41F90004BFAE    	  5839:     lea     (BoomerangFrameCycle).l,A0
02:0004C3C6 10303000        	  5840:     move.b  (A0,D3.W),D0
02:0004C3CA 1940000C        	  5841:     move.b  D0,($000C,A4)
                            	  5842:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5843:     ;
