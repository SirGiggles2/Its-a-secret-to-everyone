                            	  5536: HandleArrowOrBoomerangBlocked:
                            	  5537:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5538:     ;
02:0004C192 7003            	  5539:     moveq   #3,D0
02:0004C194 41EC03D0        	  5540:     lea     ($03D0,A4),A0
02:0004C198 11802000        	  5541:     move.b  D0,(A0,D2.W)
                            	  5542:     ; Add $10 to the state to make it $2x.
                            	  5543:     ;
02:0004C19C 41EC00AC        	  5544:     lea     ($00AC,A4),A0
02:0004C1A0 10302000        	  5545:     move.b  (A0,D2.W),D0
02:0004C1A4 023C00EE        	  5546:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C1A8 123C0010        	  5547:     move.b  #$10,D1
02:0004C1AC D101            	  5548:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004C1AE 41EC00AC        	  5549:     lea     ($00AC,A4),A0
02:0004C1B2 11802000        	  5550:     move.b  D0,(A0,D2.W)
                            	  5551:     even
