                            	  5153: _L_z01_CheckMazes_PlaySecretTune:
                            	  5154:     ; Play secret tune, and let the player leave the maze.
                            	  5155:     ;
02:0003175C 7004            	  5156:     moveq   #4,D0
02:0003175E 19400602        	  5157:     move.b  D0,($0602,A4)
02:00031762 4E75            	  5158:     rts
                            	  5159: 
                            	  5160: ; Params:
                            	  5161: ; [02]: Y
                            	  5162: ; [03]: X
                            	  5163: ;
                            	  5164: ; Returns:
                            	  5165: ; [00]: high byte of PPU address
                            	  5166: ; [01]: low byte of PPU address
                            	  5167: ;
                            	  5168: ;
                            	  5169: ; Turn the 16-bit value 08YY into the PPU address
                            	  5170: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5171: ;
                            	  5172: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5173: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5174: ;
                            	  5175:     even
                            	  5176: MapScreenPosToPpuAddr:
02:00031764 6000A300        	  5177:     jmp     c_map_screen_pos_to_ppu_addr
                            	  5178: 
