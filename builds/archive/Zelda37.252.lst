                            	  6026: __far_z_01_0056:
                            	  6027:     ; They collide. Now find out how they collide.
                            	  6028:     ;
                            	  6029:     ; If it's a regular monster, go harm Link.
                            	  6030:     ;
02:00031F2A 41EC034F        	  6031:     lea     ($034F,A4),A0
02:00031F2E 10302000        	  6032:     move.b  (A0,D2.W),D0
02:00031F32 0C000053        	  6033:     cmpi.b  #$53,D0
02:00031F36 6402            	  6034:     bcc.s  __far_z_01_0057
02:00031F38 607C            	  6035:     jmp  HarmLink
                            	  6036: __far_z_01_0057:
                            	  6037:     ; Here, the attacker is a monster's shot/projectile.
                            	  6038:     ; Flag this kind of collision.
                            	  6039:     ;
02:00031F3A 522C034B        	  6040:     addq.b  #1,($034B,A4)
                            	  6041:     ; If object type = Fireball2 ($56) or $5A, or Link is not idle;
                            	  6042:     ; then go harm Link.
                            	  6043:     ;
02:00031F3E 0C000056        	  6044:     cmpi.b  #$56,D0
02:00031F42 6602            	  6045:     bne.s  __far_z_01_0058
02:00031F44 6070            	  6046:     jmp  HarmLink
                            	  6047: __far_z_01_0058:
