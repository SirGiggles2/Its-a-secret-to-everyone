                            	  6102: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6103:     ; The weapon is the sword.
                            	  6104:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6105:     ;
02:0004C5C6 023C00EE        	  6106:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C5CA 122C0657        	  6107:     move.b  ($0657,A4),D1
