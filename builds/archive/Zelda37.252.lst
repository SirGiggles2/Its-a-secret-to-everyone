                            	  6887:     ;
                            	  6888:     ; Assume animation frame 0 (legs apart).
02:0004CAEC 7600            	  6889:     moveq   #0,D3
02:0004CAEE 41EC03E4        	  6890:     lea     ($03E4,A4),A0
02:0004CAF2 10302000        	  6891:     move.b  (A0,D2.W),D0
