02:0003F484 12302000        	 12637:     move.b  (A0,D2.W),D1
02:0003F488 8001            	 12638:     or.b  D1,D0
02:0003F48A 19400003        	 12639:     move.b  D0,($0003,A4)
02:0003F48E 41F90003F358    	 12640:     lea     (GanonBurstTiles).l,A0
