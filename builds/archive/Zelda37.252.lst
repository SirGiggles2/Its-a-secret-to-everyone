                            	  5621:     ;
02:0004C22A 6100F570        	  5622:     jsr     MoveObject
                            	  5623:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5624:     ; state to $40.
                            	  5625:     ;
02:0004C22E 41EC0380        	  5626:     lea     ($0380,A4),A0
02:0004C232 53302000        	  5627:     subq.b  #1,(A0,D2.W)
02:0004C236 6614            	  5628:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5629:     even
                            	  5630: _L_z07_CheckState30_SetState40:
                            	  5631:     ; Set state $40, and a time to move of $20 frames.
                            	  5632:     ;
                            	  5633:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5634:     ;
                            	  5635:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5636:     ;
02:0004C238 7020            	  5637:     moveq   #32,D0
02:0004C23A 41EC0380        	  5638:     lea     ($0380,A4),A0
02:0004C23E 11802000        	  5639:     move.b  D0,(A0,D2.W)
