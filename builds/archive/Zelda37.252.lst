02:0004C830 41EC00AC        	  6461:     lea     ($00AC,A4),A0
02:0004C834 10302000        	  6462:     move.b  (A0,D2.W),D0
02:0004C838 6602            	  6463:     bne.s  __far_z_07_0104
02:0004C83A 606E            	  6464:     jmp  L1F95F_Exit
                            	  6465: __far_z_07_0104:
