                            	  6210: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6211:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6212:     ;   full heart=4 partial heart=$70
                            	  6213:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6214:     ; But the method here yields $3EF, because partial heart is
                            	  6215:     ; considered full when = $FF instead of $100.
                            	  6216:     ;
02:0003207C 102C000E        	  6217:     move.b  ($000E,A4),D0
02:00032080 003C0011        	  6218:     ori     #$11,CCR  ; SEC: set C+X
02:00032084 122C0670        	  6219:     move.b  ($0670,A4),D1
02:00032088 0A3C0010        	  6220:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003208C 9101            	  6221:     subx.b  D1,D0   ; SBC HeartPartial
02:0003208E 0A3C0010        	  6222:     eori    #$10,CCR  ; restore X = 6502 C
02:00032092 1940000E        	  6223:     move.b  D0,($000E,A4)
02:00032096 102C066F        	  6224:     move.b  ($066F,A4),D0
02:0003209A 0200000F        	  6225:     andi.b #$0F,D0
