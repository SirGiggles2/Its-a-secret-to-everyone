02:0003AB36 10303000        	  2647:     move.b  (A0,D3.W),D0
02:0003AB3A 41EC0412        	  2648:     lea     ($0412,A4),A0
02:0003AB3E 11802000        	  2649:     move.b  D0,(A0,D2.W)
                            	  2650:     ; Reset the vertical speed low byte.
                            	  2651:     ; Then go animate, draw, and check collisions.
                            	  2652:     ;
02:0003AB42 6100022E        	  2653:     jsr     Jumper_ResetVSpeedFrac
