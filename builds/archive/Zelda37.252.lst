02:00032622 41EC04F0        	  7177:     lea     ($04F0,A4),A0
02:00032626 10302000        	  7178:     move.b  (A0,D2.W),D0
02:0003262A 6656            	  7179:     bne  _L_z01_BeginShove_Exit2
                            	  7180:     ; If the monster is not a Gohma, then go store the shove direction.
                            	  7181:     ;
02:0003262C 41EC034F        	  7182:     lea     ($034F,A4),A0
02:00032630 10302000        	  7183:     move.b  (A0,D2.W),D0
02:00032634 0C000033        	  7184:     cmpi.b  #$33,D0
02:00032638 6706            	  7185:     beq  _L_z01_BeginShove_Gohma
02:0003263A 0C000034        	  7186:     cmpi.b  #$34,D0
