02:0003BB72 41EC0412        	  4931:     lea     ($0412,A4),A0
02:0003BB76 16302000        	  4932:     move.b  (A0,D2.W),D3
02:0003BB7A 41F90003B9AC    	  4933:     lea     (WallmasterDirsAndAttrsLeft).l,A0
02:0003BB80 10303000        	  4934:     move.b  (A0,D3.W),D0
02:0003BB84 0200000F        	  4935:     andi.b #$0F,D0
02:0003BB88 41EC0098        	  4936:     lea     ($0098,A4),A0
02:0003BB8C 11802000        	  4937:     move.b  D0,(A0,D2.W)
                            	  4938:     ; Increase the count of tiles crossed.
                            	  4939:     ;
02:0003BB90 41EC041F        	  4940:     lea     ($041F,A4),A0
02:0003BB94 52302000        	  4941:     addq.b  #1,(A0,D2.W)
                            	  4942:     ; If the monster has crossed less than 7 tiles, then
                            	  4943:     ; go draw and check collisions.
                            	  4944:     ;
02:0003BB98 41EC041F        	  4945:     lea     ($041F,A4),A0
02:0003BB9C 10302000        	  4946:     move.b  (A0,D2.W),D0
02:0003BBA0 0C000007        	  4947:     cmpi.b  #$07,D0
02:0003BBA4 652C            	  4948:     bcs  _L_z04_L_Wallmaster_State1_Wallmaster_DrawAndCheckCollisions
                            	  4949:     ; It has reached the end of a trip.
                            	  4950:     ;
                            	  4951:     ; If Wallmaster did not capture Link, then go set state to 0 and return.
                            	  4952:     ;
02:0003BBA6 41EC042C        	  4953:     lea     ($042C,A4),A0
02:0003BBAA 10302000        	  4954:     move.b  (A0,D2.W),D0
02:0003BBAE 6718            	  4955:     beq  _L_z04_L_Wallmaster_State1_SetState
                            	  4956:     ; At the end of a trip where Link was captured:
                            	  4957:     ; 1. hide the special sprites used by Wallmaster
                            	  4958:     ; 2. go to mode 3 "unfurl" to go the level's entrance
