                            	  5349: LayOutDoors:
                            	  5350:     ; Copies the right door face for the direction, type, and state
                            	  5351:     ; of the door to the play area tile map.
                            	  5352:     ;
                            	  5353:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5354:     ; that are not true doors.
                            	  5355:     ;
02:000433DE 7403            	  5356:     moveq   #3,D2
                            	  5357:     even
                            	  5358: L_LayOutDoors_LoopDoors:
                            	  5359:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5360:     ;
02:000433E0 7001            	  5361:     moveq   #1,D0
                            	  5362:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5363:     ;
                            	  5364:     ; [06] indicates whether we're handling the first half of
                            	  5365:     ; the door: Left half for N/S, Top half for E/W.
                            	  5366:     ;
02:000433E2 19400006        	  5367:     move.b  D0,($0006,A4)
                            	  5368:     even
                            	  5369: L_LayOutDoors_LoopHalves:
02:000433E6 1002            	  5370:     move.b  D2,D0
02:000433E8 1B00            	  5371:     move.b  D0,-(A5)  ; PHA
02:000433EA 1940000B        	  5372:     move.b  D0,($000B,A4)
02:000433EE 41F9000433BA    	  5373:     lea     (DoorBits).l,A0
02:000433F4 10302000        	  5374:     move.b  (A0,D2.W),D0
02:000433F8 19400002        	  5375:     move.b  D0,($0002,A4)
02:000433FC 6100FD4A        	  5376:     jsr     FindDoorAttrByDoorBit
                            	  5377:     ; Begin looking for the door face for the door attribute.
                            	  5378:     ; In general, use the door type as the provisional face;
                            	  5379:     ; except turn 4 into 8.
                            	  5380:     ;
02:00043400 0C000005        	  5381:     cmpi.b  #$05,D0
02:00043404 642A            	  5382:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00043406 0C000004        	  5383:     cmpi.b  #$04,D0
02:0004340A 6608            	  5384:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:0004340C 7008            	  5385:     moveq   #8,D0
02:0004340E 6620            	  5386:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5387:     even
                            	  5388: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5389:     ; We jump here if the door type is bombable and was opened.
                            	  5390:     ; Change the provisional door face to value 9, which
                            	  5391:     ; will become the "hole in the wall".
                            	  5392:     ;
02:00043410 7009            	  5393:     moveq   #9,D0
02:00043412 665A            	  5394:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5395:     even
                            	  5396: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5397:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5398:     ; the mask of opened doors, because this is not a true door.
                            	  5399:     ;
02:00043414 1B00            	  5400:     move.b  D0,-(A5)  ; PHA
02:00043416 102C0002        	  5401:     move.b  ($0002,A4),D0
02:0004341A 4600            	  5402:     eori.b #$FF,D0
02:0004341C 122C00EE        	  5403:     move.b  ($00EE,A4),D1
02:00043420 C001            	  5404:     and.b  D1,D0
02:00043422 194000EE        	  5405:     move.b  D0,($00EE,A4)
02:00043426 101D            	  5406:     move.b  (A5)+,D0  ; PLA
                            	  5407:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5408:     ;
02:00043428 0C000001        	  5409:     cmpi.b  #$01,D0
02:0004342C 6402            	  5410:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:0004342E 7004            	  5411:     moveq   #4,D0
                            	  5412:     even
                            	  5413: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5414:     ; The door attribute (DA) has been mapped to a
                            	  5415:     ; provisional door face value (PF) in %A as follows:
                            	  5416:     ;
                            	  5417:     ; DA PF Meaning
                            	  5418:     ; -------------
                            	  5419:     ; 0  4  open
                            	  5420:     ; 1  1  wall
                            	  5421:     ; 2  2  false wall
                            	  5422:     ; 3  3  false wall 2
                            	  5423:     ; 4  8  bombable
                            	  5424:     ; 5  5  key
                            	  5425:     ; 6  6  key 2
                            	  5426:     ; 7  7  shutter
                            	  5427:     ;
                            	  5428:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5429:     ; has been cleared, if the type was "open" or any wall.
                            	  5430:     ;
                            	  5431:     ;
                            	  5432:     ; Save the provisional face.
02:00043430 1B00            	  5433:     move.b  D0,-(A5)  ; PHA
                            	  5434:     ; If the current direction points to a door that has been opened,
                            	  5435:     ; then see if we need to set door flags.
                            	  5436:     ;
02:00043432 102C00EE        	  5437:     move.b  ($00EE,A4),D0
02:00043436 122C0002        	  5438:     move.b  ($0002,A4),D1
02:0004343A C001            	  5439:     and.b  D1,D0
02:0004343C 7400            	  5440:     moveq   #0,D2
02:0004343E 1400            	  5441:     move.b  D0,D2
02:00043440 101D            	  5442:     move.b  (A5)+,D0  ; PLA
02:00043442 122C0002        	  5443:     move.b  ($0002,A4),D1
02:00043446 B401            	  5444:     cmp.b   D1,D2
02:00043448 6624            	  5445:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5446:     ; The current direction points to a door that has been opened.
                            	  5447:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5448:     ;
                            	  5449:     ;
                            	  5450:     ; Save provisional door face in Y register.
02:0004344A 7600            	  5451:     moveq   #0,D3
02:0004344C 1600            	  5452:     move.b  D0,D3
02:0004344E 101D            	  5453:     move.b  (A5)+,D0  ; PLA
02:00043450 1B00            	  5454:     move.b  D0,-(A5)  ; PHA
02:00043452 7400            	  5455:     moveq   #0,D2
02:00043454 1400            	  5456:     move.b  D0,D2
02:00043456 1003            	  5457:     move.b  D3,D0
                            	  5458:     ; If provisional door face is not for a shutter, then
                            	  5459:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5460:     ;
                            	  5461:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5462:     ;
02:00043458 0C000007        	  5463:     cmpi.b  #$07,D0
02:0004345C 670E            	  5464:     beq  _anon_z05_111
02:0004345E 1B00            	  5465:     move.b  D0,-(A5)  ; PHA
02:00043460 6100DF68        	  5466:     jsr     SetDoorFlag
02:00043464 101D            	  5467:     move.b  (A5)+,D0  ; PLA
                            	  5468:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5469:     ; then go make it 9 (open "bombable").
                            	  5470:     ; Else make it 4 (open "door").
                            	  5471:     ;
02:00043466 0C000008        	  5472:     cmpi.b  #$08,D0
02:0004346A 67A4            	  5473:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5474: _anon_z05_111:
02:0004346C 7004            	  5475:     moveq   #4,D0
                            	  5476:     even
                            	  5477: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5478:     ; For opened doors, the provisional door face has become:
                            	  5479:     ;
                            	  5480:     ; DA PF Meaning
                            	  5481:     ; -------------
                            	  5482:     ; 0  4  open
                            	  5483:     ; 1  1  wall
                            	  5484:     ; 2  2  false wall
                            	  5485:     ; 3  3  false wall 2
                            	  5486:     ; 4  9  bombable
                            	  5487:     ; 5  4  key
                            	  5488:     ; 6  4  key 2
                            	  5489:     ; 7  4  shutter
                            	  5490:     ;
                            	  5491:     ;
                            	  5492:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5493:     ;
02:0004346E 7400            	  5494:     moveq   #0,D2
02:00043470 142C0006        	  5495:     move.b  ($0006,A4),D2
02:00043474 6712            	  5496:     beq  _anon_z05_112
02:00043476 7400            	  5497:     moveq   #0,D2
02:00043478 142C000B        	  5498:     move.b  ($000B,A4),D2
02:0004347C 1B00            	  5499:     move.b  D0,-(A5)  ; PHA
02:0004347E 6100FCC8        	  5500:     jsr     FindDoorAttrByDoorBit
02:00043482 61001C62        	  5501:     jsr     CalcOpenDoorwayMask
02:00043486 101D            	  5502:     move.b  (A5)+,D0  ; PLA
                            	  5503: _anon_z05_112:
                            	  5504:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5505:     ; because the visible door face is already a wall.
                            	  5506:     ;
02:00043488 0C000004        	  5507:     cmpi.b  #$04,D0
02:0004348C 650000DC        	  5508:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5509:     ; For all other provisional face values, calculate:
                            	  5510:     ; door face := provisional face - 3
02:00043490 003C0011        	  5511:     ori     #$11,CCR  ; SEC: set C+X
02:00043494 123C0003        	  5512:     move.b  #$03,D1
02:00043498 0A3C0010        	  5513:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004349C 9101            	  5514:     subx.b  D1,D0   ; SBC #$03
02:0004349E 0A3C0010        	  5515:     eori    #$10,CCR  ; restore X = 6502 C
02:000434A2 7600            	  5516:     moveq   #0,D3
02:000434A4 1600            	  5517:     move.b  D0,D3
                            	  5518:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5519:     ; subtract one.
                            	  5520:     ;
02:000434A6 0C030003        	  5521:     cmpi.b  #$03,D3
02:000434AA 6502            	  5522:     bcs  _anon_z05_113
02:000434AC 5303            	  5523:     subq.b  #1,D3
                            	  5524: _anon_z05_113:
                            	  5525:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5526:     ;
                            	  5527:     ; DT DFC DFO Meaning
                            	  5528:     ; ------------------
                            	  5529:     ; 0  1   1   open
                            	  5530:     ; 4  4   5   bombable
                            	  5531:     ; 5  2   1   key
                            	  5532:     ; 6  2   1   key 2
                            	  5533:     ; 7  3   1   shutter
                            	  5534:     ;
                            	  5535:     ;
                            	  5536:     ; Get the direction index.
02:000434AE 101D            	  5537:     move.b  (A5)+,D0  ; PLA
02:000434B0 1B00            	  5538:     move.b  D0,-(A5)  ; PHA
02:000434B2 610000D0        	  5539:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5540:     ; If handling the second half, then offset to the second half
                            	  5541:     ; of the tiles.
                            	  5542:     ;
02:000434B6 102C0006        	  5543:     move.b  ($0006,A4),D0
02:000434BA 6618            	  5544:     bne  _anon_z05_114
02:000434BC 41F9000433D2    	  5545:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:000434C2 10302000        	  5546:     move.b  (A0,D2.W),D0
02:000434C6 4EB9000312C2    	  5547:     jsr     AddToInt16At0
02:000434CC 7006            	  5548:     moveq   #6,D0
02:000434CE 4EB9000312CA    	  5549:     jsr     AddToInt16At2
                            	  5550: _anon_z05_114:
                            	  5551:     ; Fix Y at 0 for copying source tiles to destination.
                            	  5552:     ; Pointers will be incremented instead of Y.
02:000434D4 7600            	  5553:     moveq   #0,D3
02:000434D6 41F9000433D6    	  5554:     lea     (DirIndexToDoorColumnCount).l,A0
02:000434DC 10302000        	  5555:     move.b  (A0,D2.W),D0
02:000434E0 19400005        	  5556:     move.b  D0,($0005,A4)
                            	  5557:     even
                            	  5558: _L_z05_L_LayOutDoors_LoopHalves_LoopColumn:
                            	  5559:     ; For each column (3 or 2), indexed by [05] down to 1:
                            	  5560:     ;
02:000434E4 101D            	  5561:     move.b  (A5)+,D0  ; PLA
02:000434E6 1B00            	  5562:     move.b  D0,-(A5)  ; PHA
02:000434E8 7400            	  5563:     moveq   #0,D2
02:000434EA 1400            	  5564:     move.b  D0,D2
                            	  5565:     ; For each row (2 or 3) in the door, indexed by X,
