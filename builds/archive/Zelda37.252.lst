02:0003D344 4EF9000319BE    	  8116:     jmp     DrawObjectMirrored
                            	  8117: 
                            	  8118: ; Description:
                            	  8119: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8120: ; When walking, the object timer is set. When teleporting,
                            	  8121: ; the teleporting distance remaining is set.
                            	  8122: ;
                            	  8123: ; If we have the magic clock, then only go draw and check collisions.
                            	  8124: ;
                            	  8125:     even
                            	  8126: UpdateBlueWizzrobe:
02:0003D34A 102C066C        	  8127:     move.b  ($066C,A4),D0
02:0003D34E 6702            	  8128:     beq.s  __far_z_04_0070
02:0003D350 6014            	  8129:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8130: __far_z_04_0070:
02:0003D352 6116            	  8131:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003D354 61000318        	  8132:     jsr     BlueWizzrobe_TryShooting
                            	  8133:     even
                            	  8134: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8135:     ; If the teleporting distance remaining is even, then draw
                            	  8136:     ; and check collisions, else return.
                            	  8137:     ;
                            	  8138:     ; This means that when 0, the monster is walking.
                            	  8139:     ; So, draw and check collisions every frame.
                            	  8140:     ;
