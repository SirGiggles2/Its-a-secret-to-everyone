02:0003D138 41EC03E4        	  7871:     lea     ($03E4,A4),A0
02:0003D13C 16302000        	  7872:     move.b  (A0,D2.W),D3
02:0003D140 5203            	  7873:     addq.b  #1,D3
02:0003D142 1003            	  7874:     move.b  D3,D0
02:0003D144 02000003        	  7875:     andi.b #$03,D0
02:0003D148 41EC03E4        	  7876:     lea     ($03E4,A4),A0
