                            	  4554: 
                            	  4555: ; Each byte describes an item. The high nibble is the type.
                            	  4556: ; The low nibble is the value. Its meaning depends on the type.
                            	  4557: ;
                            	  4558: ; 0x - individuals
                            	  4559: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4560: ; * bit mask: value doesn't matter.
                            	  4561: ;
                            	  4562: ; 1x - amounts
                            	  4563: ; Value is an amount to add.
                            	  4564: ;
                            	  4565: ; 2x - grades
                            	  4566: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4567: ;
                            	  4568: ; 3x - error?
                            	  4569: ; Produces an item value of $FF.
                            	  4570: ;
                            	  4571:     even
