                            	  4132: UpdateRockOrGravestone:
02:0003B592 41EC00AC        	  4133:     lea     ($00AC,A4),A0
02:0003B596 10302000        	  4134:     move.b  (A0,D2.W),D0
02:0003B59A 660000AA        	  4135:     bne  _L_z04_UpdateRockOrGravestone_State1
                            	  4136:     ; State 0.
                            	  4137:     ;
                            	  4138:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  4139:     ; bracelet, then return.
                            	  4140:     ;
02:0003B59E 41EC034F        	  4141:     lea     ($034F,A4),A0
02:0003B5A2 10302000        	  4142:     move.b  (A0,D2.W),D0
02:0003B5A6 0C000065        	  4143:     cmpi.b  #$65,D0
02:0003B5AA 6708            	  4144:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
02:0003B5AC 102C0665        	  4145:     move.b  ($0665,A4),D0
02:0003B5B0 67000092        	  4146:     beq  _L_z04_UpdateRockOrGravestone_Exit
                            	  4147:     even
                            	  4148: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  4149:     ; If there is a mismatch between the current quest and the quest
                            	  4150:     ; needed for the secret in this room, then return.
                            	  4151:     ;
02:0003B5B4 6100021C        	  4152:     jsr     IsQuestSecretMismatch
02:0003B5B8 6500008A        	  4153:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  4154:     ; The gravestone and rocks can only be pushed vertically.
                            	  4155:     ; Return, if X's don't match.
                            	  4156:     ;
02:0003B5BC 102C0070        	  4157:     move.b  ($0070,A4),D0
02:0003B5C0 12342070        	  4158:     move.b  ($70,A4,D2.W),D1
02:0003B5C4 B001            	  4159:     cmp.b   D1,D0
02:0003B5C6 667C            	  4160:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  4161:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  4162:     ; is positive; then go use it along with a flag that indicates that
                            	  4163:     ; Link is "down" from the object.
                            	  4164:     ;
02:0003B5C8 7600            	  4165:     moveq   #0,D3
02:0003B5CA 102C0084        	  4166:     move.b  ($0084,A4),D0
02:0003B5CE 023C00EE        	  4167:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B5D2 123C0003        	  4168:     move.b  #$03,D1
02:0003B5D6 D101            	  4169:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003B5D8 003C0011        	  4170:     ori     #$11,CCR  ; SEC: set C+X
02:0003B5DC 41EC0084        	  4171:     lea     ($0084,A4),A0
02:0003B5E0 12302000        	  4172:     move.b  (A0,D2.W),D1
02:0003B5E4 0A3C0010        	  4173:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B5E8 9101            	  4174:     subx.b  D1,D0   ; SBC ObjY,X
02:0003B5EA 0A3C0010        	  4175:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B5EE 6A0E            	  4176:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  4177:     ; Else negate it, and indicate Link is "up" from the object.
                            	  4178:     ;
02:0003B5F0 5203            	  4179:     addq.b  #1,D3
02:0003B5F2 4600            	  4180:     eori.b #$FF,D0
02:0003B5F4 023C00EE        	  4181:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B5F8 123C0001        	  4182:     move.b  #$01,D1
02:0003B5FC D101            	  4183:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4184:     even
                            	  4185: _L_z04_UpdateRockOrGravestone_CheckDistance:
                            	  4186:     ; If the distance >= $11, return.
                            	  4187:     ;
02:0003B5FE 0C000011        	  4188:     cmpi.b  #$11,D0
02:0003B602 6440            	  4189:     bcc  _L_z04_UpdateRockOrGravestone_Exit
                            	  4190:     ; If the input direction has no vertical component, then return.
                            	  4191:     ;
02:0003B604 102C03F8        	  4192:     move.b  ($03F8,A4),D0
02:0003B608 0200000C        	  4193:     andi.b #$0C,D0
02:0003B60C 6736            	  4194:     beq  _L_z04_UpdateRockOrGravestone_Exit
                            	  4195:     ; If this vertical input direction does not match the one needed
                            	  4196:     ; to push the rock or gravestone, then return.
                            	  4197:     ;
02:0003B60E 41F90003B590    	  4198:     lea     (RockPushDirections).l,A0
02:0003B614 12303000        	  4199:     move.b  (A0,D3.W),D1
02:0003B618 B001            	  4200:     cmp.b   D1,D0
02:0003B61A 6628            	  4201:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  4202:     ; Set it to the object's direction. Go to the next state.
                            	  4203:     ;
02:0003B61C 41EC0098        	  4204:     lea     ($0098,A4),A0
02:0003B620 11802000        	  4205:     move.b  D0,(A0,D2.W)
02:0003B624 41EC00AC        	  4206:     lea     ($00AC,A4),A0
02:0003B628 52302000        	  4207:     addq.b  #1,(A0,D2.W)
                            	  4208:     ; Store current room ID.
                            	  4209:     ;
02:0003B62C 102C00EB        	  4210:     move.b  ($00EB,A4),D0
