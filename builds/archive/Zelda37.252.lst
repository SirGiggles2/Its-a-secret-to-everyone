02:00039E64 0C000011        	   782:     cmpi.b  #$11,D0
02:00039E68 6502            	   783:     bcs.s  __far_z_04_0007
02:00039E6A 605C            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:00039E6C 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:00039E70 41F900039DC4    	   792:     lea     (BlockPushDirections).l,A0
02:00039E76 12303000        	   793:     move.b  (A0,D3.W),D1
02:00039E7A B001            	   794:     cmp.b   D1,D0
02:00039E7C 6702            	   795:     beq.s  __far_z_04_0008
02:00039E7E 6048            	   796:     jmp  ResetPushTimer
                            	   797: __far_z_04_0008:
                            	   798:     ; Link is truly pushing the block.
