02:0002E726 7600            	   438:     moveq   #0,D3
02:0002E728 41EC046C        	   439:     lea     ($046C,A4),A0
02:0002E72C 16302000        	   440:     move.b  (A0,D2.W),D3
02:0002E730 41EC046F        	   441:     lea     ($046F,A4),A0
02:0002E734 10303000        	   442:     move.b  (A0,D3.W),D0
02:0002E738 41EC0448        	   443:     lea     ($0448,A4),A0
02:0002E73C 11802000        	   444:     move.b  D0,(A0,D2.W)
02:0002E740 5302            	   445:     subq.b  #1,D2
02:0002E742 6AE2            	   446:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
