02:0003AB8A 7600            	  2699:     moveq   #0,D3
02:0003AB8C 1600            	  2700:     move.b  D0,D3
02:0003AB8E 41F90003AA3C    	  2701:     lea     (JumperYAccelerations).l,A0
02:0003AB94 10303000        	  2702:     move.b  (A0,D3.W),D0
02:0003AB98 7602            	  2703:     moveq   #2,D3
02:0003AB9A 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
