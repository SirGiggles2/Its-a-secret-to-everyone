                            	  6960: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6961:     ; To animate the state, the animation counter had to have
                            	  6962:     ; reached 0. Right after this routine, the counter will be
                            	  6963:     ; rolled over, and the movement frame will be switched.
                            	  6964:     ;
                            	  6965:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6966:     ; the animation here, in order to immediately change it to
                            	  6967:     ; 0 (legs apart) after this.
                            	  6968:     ;
02:0004CB5C 7001            	  6969:     moveq   #1,D0
02:0004CB5E 194003E4        	  6970:     move.b  D0,($03E4,A4)
02:0004CB62 4E75            	  6971:     rts
                            	  6972: 
                            	  6973:     even
                            	  6974: _L_z07_AnimateLinkObjState_CheckState30:
                            	  6975:     ; If in state $30, then make Link idle, except for halting.
                            	  6976:     ;
