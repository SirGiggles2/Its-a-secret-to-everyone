02:000320A0 532C066F        	  6227:     subq.b  #1,($066F,A4)
02:000320A4 103C00FF        	  6228:     move.b  #$FF,D0
02:000320A8 19400670        	  6229:     move.b  D0,($0670,A4)
02:000320AC 6600FF6E        	  6230:     bne  _L_z01_Link_BeHarmed_ResetHelp
