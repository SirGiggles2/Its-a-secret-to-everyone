                            	  7301: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7302:     ; If the "monsters from edges" long timer expired, then
                            	  7303:     ; go bring the monster in.
                            	  7304:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7305:     ;
                            	  7306:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7307:     ; residual position so enemies keep their previous-room
                            	  7308:     ; positions instead of being re-edge-spawned (matches NES).
02:0004CF12 102C004B        	  7309:     move.b  ($004B,A4),D0
02:0004CF16 662E            	  7310:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7311:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004CF18 102C000F        	  7312:     move.b  ($000F,A4),D0
02:0004CF1C 0C0000FF        	  7313:     cmpi.b  #$FF,D0
02:0004CF20 662E            	  7314:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004CF22 41EC0070        	  7315:     lea     ($0070,A4),A0
02:0004CF26 10302000        	  7316:     move.b  (A0,D2.W),D0
02:0004CF2A 660A            	  7317:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004CF2C 41EC0084        	  7318:     lea     ($0084,A4),A0
02:0004CF30 10302000        	  7319:     move.b  (A0,D2.W),D0
02:0004CF34 671A            	  7320:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7321:     even
