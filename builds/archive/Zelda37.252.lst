02:0003C5C6 10302000        	  6306:     move.b  (A0,D2.W),D0
02:0003C5CA 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003C5CE E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003C5D0 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003C5D4 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003C5D8 C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C5DA 6716            	  6312:     beq  _L_z04_Digdogger_Move_Down
