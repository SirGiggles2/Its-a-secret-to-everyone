02:0003A772 6748            	  2052:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:0003A774 0C0000F0        	  2053:     cmpi.b  #$F0,D0
02:0003A778 6742            	  2054:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2055:     ; Turn the random value into a $10 pixel aligned Y coordinate.
