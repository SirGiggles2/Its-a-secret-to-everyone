                            	  3995:     ; TODO: call it speed index or angle?
                            	  3996:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  3997:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  3998:     ;
02:00030F66 6728            	  3999:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00030F68 0C000008        	  4000:     cmpi.b  #$08,D0
