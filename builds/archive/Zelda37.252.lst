02:0004000E 7003            	   304:     moveq   #3,D0
02:00040010 6100015C        	   305:     jsr     MovePositionMarkers
02:00040014 102C00FC        	   306:     move.b  ($00FC,A4),D0
02:00040018 003C0011        	   307:     ori     #$11,CCR  ; SEC: set C+X
02:0004001C 123C0003        	   308:     move.b  #$03,D1
02:00040020 0A3C0010        	   309:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040024 9101            	   310:     subx.b  D1,D0   ; SBC #$03
02:00040026 0A3C0010        	   311:     eori    #$10,CCR  ; restore X = 6502 C
02:0004002A 194000FC        	   312:     move.b  D0,($00FC,A4)
                            	   313:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   314:     ;
02:0004002E 0C000041        	   315:     cmpi.b  #$41,D0
02:00040032 66000090        	   316:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   317:     ; VScroll reached $41.
