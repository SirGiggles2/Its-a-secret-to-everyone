02:0004C47B F8
02:0004C47C FF
02:0004C47D 01
02:0004C47E F5
02:0004C47F 0B
02:0004C480 FF              	  5940:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004C481 01
02:0004C482 F9
02:0004C483 07
02:0004C484 FF
02:0004C485 01
02:0004C486 FD
02:0004C487 03
                            	  5941: 
                            	  5942: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5943: ; Each set contains 4 offsets in reverse direction index order:
                            	  5944: ; up, down, left, right
