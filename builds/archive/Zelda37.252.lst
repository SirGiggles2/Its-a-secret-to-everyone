02:00036896 123C0000        	  5018:     move.b  #$00,D1
02:0003689A D101            	  5019:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003689C 194000FC        	  5020:     move.b  D0,($00FC,A4)
