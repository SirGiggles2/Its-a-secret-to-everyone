                            	  2097:     ; We got here in one of three ways:
                            	  2098:     ;
                            	  2099:     ; A. The item flashes. Attribute value 1 or 2 was chosen
                            	  2100:     ;    explicitly.
                            	  2101:     ; B. The item color varies. ItemSlotToPaletteOffsetsOrValues
                            	  2102:     ;    held an offset that was added to base palette attribute
                            	  2103:     ;    passed in [$04]. This corresponds to class 2 items.
                            	  2104:     ; C. Item doesn't change color. ItemSlotToPaletteOffsetsOrValues
                            	  2105:     ;    held absolute attributes.
                            	  2106:     ;
                            	  2107:     ; At this point, A holds the final sprite attributes.
02:0004A9DA 7400            	  2108:     moveq   #0,D2
02:0004A9DC 1942000C        	  2109:     move.b  D2,($000C,A4)
02:0004A9E0 740F            	  2110:     moveq   #15,D2
                            	  2111:     ; Write sprites.
                            	  2112:     ; A holds the calculated sprite attributes.
                            	  2113:     ; Y holds the item slot.
02:0004A9E2 4EF900031BC6    	  2114:     jmp     Anim_WriteStaticItemSpritesWithAttributes
                            	  2115: 
