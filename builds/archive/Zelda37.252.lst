                            	  4207: _L_z07_CheckTiles_notLink:
                            	  4208:     endc
                            	  4209:     ; The code below applies to Link and other objects.
                            	  4210:     ;
                            	  4211:     ; Test the moving direction's walkability.
                            	  4212:     ;
                            	  4213:     ; For the player, this is enough. For other objects, this 
                            	  4214:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4215:     ;
                            	  4216:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4217:     ;
02:0004B8BE 6100FB88        	  4218:     jsr     GetCollidingTileMoving
02:0004B8C2 122C034A        	  4219:     move.b  ($034A,A4),D1
