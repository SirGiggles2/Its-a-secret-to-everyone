                            	  4091: PlayerScreenEdgeBounds:
02:0004B84E 3D              	  4092:     dc.b    $3D, $DD, $00, $F0
02:0004B84F DD
02:0004B850 00
02:0004B851 F0
                            	  4093: 
                            	  4094: ; Params:
                            	  4095: ; [0E]: $FF, if blocked by a door
                            	  4096: ; [0F]: movement direction
                            	  4097: ;
                            	  4098: ; Returns:
                            	  4099: ; [0F]: untouched, or changed if blocked or need to change
                            	  4100: ;
                            	  4101: ; Summary:
                            	  4102: ;
                            	  4103: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4104: ; Then allow movement or go to the next room. Otherwise,
                            	  4105: ; check passive tile objects and stop moving.
                            	  4106: ;
                            	  4107: ; For other objects: First, if moving, test the colliding tile for
                            	  4108: ; walkability. Otherwise search for a walkable direction starting
                            	  4109: ; from input direction.
                            	  4110: ;
                            	  4111: ; When you find a walkable direction, see if it makes the object
                            	  4112: ; cross a boundary. If it doesn't, then make this direction
                            	  4113: ; the objection direction. Otherwise, keep looping.
                            	  4114: ;
                            	  4115: ; If no walkable direction is found, then stop moving.
                            	  4116: ;
                            	  4117: ;
                            	  4118: ; if is player
                            	  4119: ;   if at doorway
                            	  4120: ;     go handle a walkable direction
                            	  4121: ;   if blocked by door
                            	  4122: ;     return
                            	  4123: ;
                            	  4124:     even
                            	  4125: Walker_CheckTileCollision:
                            	  4126:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4127:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4128:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4129:     ; reset) for Link and every other object. Only the tile
                            	  4130:     ; walkability decision in CheckTiles is overridden.
