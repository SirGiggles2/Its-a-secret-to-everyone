02:00039DEC 600000DA        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:00039DF0 102C0070        	   725:     move.b  ($0070,A4),D0
02:00039DF4 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:00039DF8 B001            	   727:     cmp.b   D1,D0
02:00039DFA 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00039DFC 7600            	   729:     moveq   #0,D3
02:00039DFE 102C0084        	   730:     move.b  ($0084,A4),D0
02:00039E02 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E06 123C0003        	   732:     move.b  #$03,D1
02:00039E0A D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039E0C 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:00039E10 41EC0084        	   735:     lea     ($0084,A4),A0
02:00039E14 12302000        	   736:     move.b  (A0,D2.W),D1
02:00039E18 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039E1C 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:00039E1E 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:00039E22 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:00039E24 102C0084        	   747:     move.b  ($0084,A4),D0
02:00039E28 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E2C 123C0003        	   749:     move.b  #$03,D1
02:00039E30 D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00039E32 41EC0084        	   751:     lea     ($0084,A4),A0
02:00039E36 12302000        	   752:     move.b  (A0,D2.W),D1
02:00039E3A B001            	   753:     cmp.b   D1,D0
02:00039E3C 6704            	   754:     beq.s  __far_z_04_0006
02:00039E3E 60000088        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:00039E42 7602            	   760:     moveq   #2,D3
02:00039E44 102C0070        	   761:     move.b  ($0070,A4),D0
02:00039E48 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:00039E4C 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:00039E50 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039E54 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:00039E56 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:00039E5A 6A08            	   776:     bpl  _anon_z04_14
02:00039E5C 5203            	   777:     addq.b  #1,D3
02:00039E5E 4EB900030E72    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
