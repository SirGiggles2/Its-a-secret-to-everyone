                            	  6814: __far_z_07_0118:
02:0004CAA8 102C03F8        	  6815:     move.b  ($03F8,A4),D0
02:0004CAAC 6602            	  6816:     bne.s  __far_z_07_0119
02:0004CAAE 6018            	  6817:     jmp  SetUpWalkingSprites
                            	  6818: __far_z_07_0119:
                            	  6819: ; Params:
                            	  6820: ; X: object index
                            	  6821: ;
                            	  6822: ; Returns:
                            	  6823: ; Y: animation frame
                            	  6824: ; [00]: object X
                            	  6825: ; [01]: object Y
                            	  6826: ; [0F]: flip horizontal
                            	  6827: ;
                            	  6828: ; As the object walks, the animation counter rolls down.
                            	  6829: ;
                            	  6830:     even
                            	  6831: AnimateObjectWalking:
02:0004CAB0 41EC03D0        	  6832:     lea     ($03D0,A4),A0
02:0004CAB4 53302000        	  6833:     subq.b  #1,(A0,D2.W)
02:0004CAB8 6702            	  6834:     beq.s  __far_z_07_0120
02:0004CABA 600C            	  6835:     jmp  SetUpWalkingSprites
                            	  6836: __far_z_07_0120:
                            	  6837:     ; Once the counter reaches 0, and if object is the player,
                            	  6838:     ; animate Link's object state.
                            	  6839:     ;
02:0004CABC 4A02            	  6840:     cmpi.b  #$00,D2
02:0004CABE 6602            	  6841:     bne  _anon_z07_36
02:0004CAC0 615E            	  6842:     jsr     AnimateLinkObjState
                            	  6843: _anon_z07_36:
                            	  6844:     ; Roll over the counter (6 frames).
                            	  6845:     ;
02:0004CAC2 7006            	  6846:     moveq   #6,D0
02:0004CAC4 1880            	  6847:     move.b  D0,($0000,A4)
02:0004CAC6 6152            	  6848:     jsr     RollOverAnimCounter
                            	  6849:     even
                            	  6850: SetUpWalkingSprites:
                            	  6851:     ; Set up sprite position in the descriptors.
                            	  6852:     ;
02:0004CAC8 614A            	  6853:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  6854:     ; Set up horizontal flipping.
                            	  6855:     ;
02:0004CACA 41EC0098        	  6856:     lea     ($0098,A4),A0
02:0004CACE 10302000        	  6857:     move.b  (A0,D2.W),D0
02:0004CAD2 0200000C        	  6858:     andi.b #$0C,D0
02:0004CAD6 6602            	  6859:     bne.s  __far_z_07_0121
02:0004CAD8 6012            	  6860:     jmp  SetUpHorizontalWalkingSprites
                            	  6861: __far_z_07_0121:
                            	  6862:     ; Facing up or down.
                            	  6863:     ;
                            	  6864:     ;
                            	  6865:     ; Assume animation frame 3 (up).
02:0004CADA 7603            	  6866:     moveq   #3,D3
02:0004CADC 02000008        	  6867:     andi.b #$08,D0
02:0004CAE0 6702            	  6868:     beq.s  __far_z_07_0122
02:0004CAE2 6002            	  6869:     jmp  Anim_SetObjHFlipForSpriteDescriptor
                            	  6870: __far_z_07_0122:
02:0004CAE4 5303            	  6871:     subq.b  #1,D3
                            	  6872: ; Use the movement frame as the value for horizontal flipping.
                            	  6873: ;
                            	  6874: ; Params:
                            	  6875: ; X: object index
                            	  6876: ;
                            	  6877: ; Returns:
                            	  6878: ; [0F]: flip horizontal, based on ObjMovementFrame
                            	  6879: ;
                            	  6880:     even
