                            	  5572:     ; Set arrow slot frame 2 (spark) in [0C],
                            	  5573:     ; and no horizontal flipping in [0F].
                            	  5574:     ;
02:0004C1D4 7002            	  5575:     moveq   #2,D0
02:0004C1D6 1940000C        	  5576:     move.b  D0,($000C,A4)
02:0004C1DA 7000            	  5577:     moveq   #0,D0
02:0004C1DC 1940000F        	  5578:     move.b  D0,($000F,A4)
                            	  5579:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5580:     ; and go draw.
                            	  5581:     ;
02:0004C1E0 41EC0098        	  5582:     lea     ($0098,A4),A0
02:0004C1E4 10302000        	  5583:     move.b  (A0,D2.W),D0
02:0004C1E8 4EB900030E6A    	  5584:     jsr     GetOppositeDir
02:0004C1EE 7000            	  5585:     moveq   #0,D0
02:0004C1F0 6000FEF0        	  5586:     jmp     SetAttrAndDrawArrow
