                            	  3221: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  3222:     ; Begin with the leever's Y set to Link's Y.
                            	  3223:     ;
02:0003AF8E 102C0084        	  3224:     move.b  ($0084,A4),D0
02:0003AF92 41EC0084        	  3225:     lea     ($0084,A4),A0
02:0003AF96 11802000        	  3226:     move.b  D0,(A0,D2.W)
                            	  3227:     ; If Y coordinate < $5D (top of the third square row), then
                            	  3228:     ; it's too close to the top edge of the screen. So, return.
                            	  3229:     ;
02:0003AF9A 0C00005D        	  3230:     cmpi.b  #$5D,D0
02:0003AF9E 65EC            	  3231:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  3232:     ; If facing right, then use X offset $28.
                            	  3233:     ; Else store X offset -$28 in [00].
                            	  3234:     ;
02:0003AFA0 7628            	  3235:     moveq   #40,D3
02:0003AFA2 41EC0098        	  3236:     lea     ($0098,A4),A0
02:0003AFA6 10302000        	  3237:     move.b  (A0,D2.W),D0
02:0003AFAA 02000002        	  3238:     andi.b #$02,D0
02:0003AFAE 6704            	  3239:     beq  _anon_z04_45
02:0003AFB0 163C00D8        	  3240:     move.b  #$D8,D3
                            	  3241: _anon_z04_45:
02:0003AFB4 1883            	  3242:     move.b  D3,($0000,A4)
                            	  3243:     ; [01] holds Link's X coordinate.
                            	  3244:     ;
02:0003AFB6 102C0070        	  3245:     move.b  ($0070,A4),D0
02:0003AFBA 19400001        	  3246:     move.b  D0,($0001,A4)
                            	  3247:     ; Add Link's X and the horizontal offset.
                            	  3248:     ;
02:0003AFBE 023C00EE        	  3249:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFC2 1214            	  3250:     move.b  ($0000,A4),D1
02:0003AFC4 D101            	  3251:     addx.b  D1,D0   ; ADC $00
                            	  3252:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3253:     ;
02:0003AFC6 020000F8        	  3254:     andi.b #$F8,D0
                            	  3255:     ; Assign that result to the leever's X coordinate and [02].
                            	  3256:     ;
02:0003AFCA 19802070        	  3257:     move.b  D0,($70,A4,D2.W)
02:0003AFCE 19400002        	  3258:     move.b  D0,($0002,A4)
                            	  3259:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  3260:     ;
02:0003AFD2 122C0001        	  3261:     move.b  ($0001,A4),D1
02:0003AFD6 B001            	  3262:     cmp.b   D1,D0
02:0003AFD8 6510            	  3263:     bcs  _L_z04_UpdateRedLeever_Subtract
02:0003AFDA 1B00            	  3264:     move.b  D0,-(A5)  ; PHA
02:0003AFDC 102C0001        	  3265:     move.b  ($0001,A4),D0
02:0003AFE0 19400002        	  3266:     move.b  D0,($0002,A4)
02:0003AFE4 101D            	  3267:     move.b  (A5)+,D0  ; PLA
02:0003AFE6 19400001        	  3268:     move.b  D0,($0001,A4)
                            	  3269:     even
                            	  3270: _L_z04_UpdateRedLeever_Subtract:
                            	  3271:     ; The point is to get the absolute distance between the two.
                            	  3272:     ;
02:0003AFEA 102C0001        	  3273:     move.b  ($0001,A4),D0
02:0003AFEE 003C0011        	  3274:     ori     #$11,CCR  ; SEC: set C+X
02:0003AFF2 122C0002        	  3275:     move.b  ($0002,A4),D1
02:0003AFF6 0A3C0010        	  3276:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AFFA 9101            	  3277:     subx.b  D1,D0   ; SBC $02
02:0003AFFC 0A3C0010        	  3278:     eori    #$10,CCR  ; restore X = 6502 C
                            	  3279:     ; If the absolute distance >= $30, then return.
                            	  3280:     ; It means that the leever's X coordinate wrapped around
                            	  3281:     ; the left or right edge of the screen.
                            	  3282:     ;
02:0003B000 0C000030        	  3283:     cmpi.b  #$30,D0
02:0003B004 6486            	  3284:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3285:     even
                            	  3286: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  3287:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  3288:     ;
02:0003B006 4EB90004B442    	  3289:     jsr     GetCollidableTileStill
02:0003B00C 122C034A        	  3290:     move.b  ($034A,A4),D1
02:0003B010 B001            	  3291:     cmp.b   D1,D0
02:0003B012 6400FF78        	  3292:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003B016 522C0510        	  3293:     addq.b  #1,($0510,A4)
                            	  3294:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3295:     ; and pick up whatever the new value is for state 1.
                            	  3296:     ;
02:0003B01A 7001            	  3297:     moveq   #1,D0
02:0003B01C 41EC03D0        	  3298:     lea     ($03D0,A4),A0
02:0003B020 11802000        	  3299:     move.b  D0,(A0,D2.W)
                            	  3300:     ; Set the long timer to 2, meaning 20 frames.
                            	  3301:     ;
02:0003B024 E308            	  3302:     lsl.b  #1,D0   ; ASL A
02:0003B026 1940004D        	  3303:     move.b  D0,($004D,A4)
02:0003B02A 6100008C        	  3304:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3305:     ; The leever has to face Link in order to move toward him.
                            	  3306:     ;
02:0003B02E 4EB90004B9F4    	  3307:     jsr     ReverseObjDir
                            	  3308:     even
                            	  3309: _L_z04_UpdateRedLeever_CheckOtherStates:
                            	  3310:     ; If not in state 3, go check the object timer in order to draw and such.
