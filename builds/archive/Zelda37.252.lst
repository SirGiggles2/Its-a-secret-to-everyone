                            	  2696: _L_z02_ModeEandF_SetUpCursorSprites_CopySprites:
02:000350C0 41F900034988    	  2697:     lea     (ModeEandFCursorSprites).l,A0
02:000350C6 10303000        	  2698:     move.b  (A0,D3.W),D0
02:000350CA 41EC0201        	  2699:     lea     ($0201,A4),A0
02:000350CE 11803000        	  2700:     move.b  D0,(A0,D3.W)
02:000350D2 5303            	  2701:     subq.b  #1,D3
02:000350D4 6AEA            	  2702:     bpl  _L_z02_ModeEandF_SetUpCursorSprites_CopySprites
02:000350D6 7600            	  2703:     moveq   #0,D3
02:000350D8 162C0016        	  2704:     move.b  ($0016,A4),D3
02:000350DC 41F90003493E    	  2705:     lea     (ModeEandFSlotCursorYs).l,A0
02:000350E2 10303000        	  2706:     move.b  (A0,D3.W),D0
02:000350E6 19400084        	  2707:     move.b  D0,($0084,A4)
02:000350EA 19400200        	  2708:     move.b  D0,($0200,A4)
02:000350EE 102C0012        	  2709:     move.b  ($0012,A4),D0
02:000350F2 0C00000F        	  2710:     cmpi.b  #$0F,D0
                            	  2711:     ; There's more work in mode $E.
                            	  2712:     ; The name cursor position is held in ObjX/ObjY[0].
                            	  2713:     ; The char-board cursor position is held in ObjX/ObjY[1].
02:000350F6 6736            	  2714:     beq  _L_z02_ModeEandF_SetUpCursorSprites_Exit
02:000350F8 103C00F3        	  2715:     move.b  #$F3,D0
02:000350FC 19400201        	  2716:     move.b  D0,($0201,A4)
                            	  2717:     ; Because the visible part of the cursor block sprite is
                            	  2718:     ; in the bottom, move the name cursor's sprite 8 pixels
                            	  2719:     ; above its ObjY.
02:00035100 102C0084        	  2720:     move.b  ($0084,A4),D0
02:00035104 003C0011        	  2721:     ori     #$11,CCR  ; SEC: set C+X
02:00035108 123C0008        	  2722:     move.b  #$08,D1
02:0003510C 0A3C0010        	  2723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00035110 9101            	  2724:     subx.b  D1,D0   ; SBC #$08
02:00035112 0A3C0010        	  2725:     eori    #$10,CCR  ; restore X = 6502 C
02:00035116 19400204        	  2726:     move.b  D0,($0204,A4)
02:0003511A 7070            	  2727:     moveq   #112,D0
02:0003511C 19400070        	  2728:     move.b  D0,($0070,A4)
02:00035120 103C0087        	  2729:     move.b  #$87,D0
02:00035124 19400085        	  2730:     move.b  D0,($0085,A4)
02:00035128 7030            	  2731:     moveq   #48,D0
02:0003512A 19400071        	  2732:     move.b  D0,($0071,A4)
                            	  2733:     even
