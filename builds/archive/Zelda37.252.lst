                            	  6780: UpdateDodongoState0_Move:
                            	  6781:     ; If facing left, then push X offset 0 on the stack.
                            	  6782:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6783:     ;
                            	  6784:     ; We would like to use one set of coordinates only.
                            	  6785:     ; But movement would break down, if we did; because
                            	  6786:     ; Dodongo is so long.
                            	  6787:     ;
                            	  6788:     ; So, when not facing left, we temporarily shift the
                            	  6789:     ; X coordinate to be closer to the other side of the monster.
                            	  6790:     ;
02:0003C96A 7600            	  6791:     moveq   #0,D3
02:0003C96C 41EC0098        	  6792:     lea     ($0098,A4),A0
02:0003C970 10302000        	  6793:     move.b  (A0,D2.W),D0
02:0003C974 0200000D        	  6794:     andi.b #$0D,D0
02:0003C978 6716            	  6795:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003C97A 10342070        	  6796:     move.b  ($70,A4,D2.W),D0
02:0003C97E 023C00EE        	  6797:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C982 123C0010        	  6798:     move.b  #$10,D1
02:0003C986 D101            	  6799:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C988 19802070        	  6800:     move.b  D0,($70,A4,D2.W)
02:0003C98C 163C00F0        	  6801:     move.b  #$F0,D3
                            	  6802:     even
                            	  6803: _L_z04_UpdateDodongoState0_Move_Move:
02:0003C990 1003            	  6804:     move.b  D3,D0
02:0003C992 1B00            	  6805:     move.b  D0,-(A5)  ; PHA
02:0003C994 7020            	  6806:     moveq   #32,D0
02:0003C996 41EC041F        	  6807:     lea     ($041F,A4),A0
02:0003C99A 11802000        	  6808:     move.b  D0,(A0,D2.W)
02:0003C99E 6100D0FC        	  6809:     jsr     Wanderer_TargetPlayer
                            	  6810:     ; Pop the offset and add it to the X coordinate.
                            	  6811:     ;
                            	  6812:     ; This brings the X coordinate back to the unique value
                            	  6813:     ; that represents the position.
                            	  6814:     ;
02:0003C9A2 101D            	  6815:     move.b  (A5)+,D0  ; PLA
02:0003C9A4 023C00EE        	  6816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C9A8 12342070        	  6817:     move.b  ($70,A4,D2.W),D1
02:0003C9AC D101            	  6818:     addx.b  D1,D0   ; ADC ObjX,X
02:0003C9AE 19802070        	  6819:     move.b  D0,($70,A4,D2.W)
                            	  6820:     ; If X coordinate < $20, then face right.
                            	  6821:     ;
02:0003C9B2 0C000020        	  6822:     cmpi.b  #$20,D0
02:0003C9B6 640A            	  6823:     bcc  _anon_z04_89
02:0003C9B8 7001            	  6824:     moveq   #1,D0
02:0003C9BA 41EC0098        	  6825:     lea     ($0098,A4),A0
02:0003C9BE 11802000        	  6826:     move.b  D0,(A0,D2.W)
