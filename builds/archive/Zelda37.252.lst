02:0003BBB6 19400012        	  4963:     move.b  D0,($0012,A4)
02:0003BBBA 7000            	  4964:     moveq   #0,D0
02:0003BBBC 194000AC        	  4965:     move.b  D0,($00AC,A4)
02:0003BBC0 19400011        	  4966:     move.b  D0,($0011,A4)
02:0003BBC4 19400013        	  4967:     move.b  D0,($0013,A4)
                            	  4968:     even
