02:0004018A 6606            	   502:     bne.s  __far_z_05_0002
02:0004018C 4EF90002D89A    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:00040192 61004EC2        	   505:     jsr     HasCompass
02:00040196 6606            	   506:     bne.s  __far_z_05_0003
02:00040198 4EF90002D89A    	   507:     jmp  Exit
