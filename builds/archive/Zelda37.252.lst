02:0004C85A 10302000        	  6489:     move.b  (A0,D2.W),D0
02:0004C85E 0200000F        	  6490:     andi.b #$0F,D0
02:0004C862 7600            	  6491:     moveq   #0,D3
02:0004C864 1600            	  6492:     move.b  D0,D3
02:0004C866 41F90004C823    	  6493:     lea     (BombTimes-1).l,A0
02:0004C86C 10303000        	  6494:     move.b  (A0,D3.W),D0
02:0004C870 19802028        	  6495:     move.b  D0,($28,A4,D2.W)
