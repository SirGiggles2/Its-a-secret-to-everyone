                            	  9573: UpdateGohma:
                            	  9574:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9575:     ;
02:0003DDF4 41EC0451        	  9576:     lea     ($0451,A4),A0
02:0003DDF8 10302000        	  9577:     move.b  (A0,D2.W),D0
02:0003DDFC 662C            	  9578:     bne  _L_z04_UpdateGohma_Move
                            	  9579:     ; If Random:
                            	  9580:     ;   >= $B0: right
                            	  9581:     ;   >= $60: left
                            	  9582:     ;   Else:   down
                            	  9583:     ;
02:0003DDFE 7001            	  9584:     moveq   #1,D0
02:0003DE00 7600            	  9585:     moveq   #0,D3
02:0003DE02 16342018        	  9586:     move.b  ($18,A4,D2.W),D3
02:0003DE06 0C0300B0        	  9587:     cmpi.b  #$B0,D3
02:0003DE0A 640A            	  9588:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE0C E308            	  9589:     lsl.b  #1,D0   ; ASL A
02:0003DE0E 0C030060        	  9590:     cmpi.b  #$60,D3
02:0003DE12 6402            	  9591:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003DE14 E308            	  9592:     lsl.b  #1,D0   ; ASL A
                            	  9593:     even
                            	  9594: _L_z04_UpdateGohma_ChangeDir:
02:0003DE16 41EC0098        	  9595:     lea     ($0098,A4),A0
02:0003DE1A 11802000        	  9596:     move.b  D0,(A0,D2.W)
                            	  9597:     ; Now we can go straight without changing direction for some time.
                            	  9598:     ;
02:0003DE1E 41EC0451        	  9599:     lea     ($0451,A4),A0
02:0003DE22 52302000        	  9600:     addq.b  #1,(A0,D2.W)
                            	  9601:     ; Go animate the eye.
                            	  9602:     ;
02:0003DE26 600000C6        	  9603:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9604: 
                            	  9605:     even
                            	  9606: _L_z04_UpdateGohma_Move:
                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003DE2A 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003DE2E 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003DE32 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DE36 123C0080        	  9612:     move.b  #$80,D1
02:0003DE3A D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003DE3C 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003DE40 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003DE44 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
02:0003DE48 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003DE4C 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003DE50 7001            	  9625:     moveq   #1,D0
02:0003DE52 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003DE56 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003DE5A 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003DE5E 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003DE62 C200            	  9632:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE64 6704            	  9633:     beq  _anon_z04_118
02:0003DE66 52342070        	  9634:     addq.b  #1,($70,A4,D2.W)
                            	  9635: _anon_z04_118:
                            	  9636:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9637:     ;
02:0003DE6A 122C0002        	  9638:     move.b  ($0002,A4),D1
02:0003DE6E E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003DE70 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003DE74 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003DE78 C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE7A 6704            	  9643:     beq  _anon_z04_119
02:0003DE7C 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
                            	  9646:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9647:     ;
02:0003DE80 122C0002        	  9648:     move.b  ($0002,A4),D1
02:0003DE84 E309            	  9649:     lsl.b  #1,D1   ; ASL $02
02:0003DE86 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003DE8A 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003DE8E C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DE90 6708            	  9653:     beq  _anon_z04_120
02:0003DE92 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003DE96 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
                            	  9657:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9658:     ;
02:0003DE9A 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003DE9E E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003DEA0 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003DEA4 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003DEA8 C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEAA 6708            	  9664:     beq  _anon_z04_121
02:0003DEAC 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003DEB0 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003DEB4 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003DEB8 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003DEBC 0C000020        	  9672:     cmpi.b  #$20,D0
02:0003DEC0 662C            	  9673:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9674:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9675:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9676:     ;
02:0003DEC2 7000            	  9677:     moveq   #0,D0
02:0003DEC4 41EC0412        	  9678:     lea     ($0412,A4),A0
02:0003DEC8 11802000        	  9679:     move.b  D0,(A0,D2.W)
02:0003DECC 61001C62        	  9680:     jsr     ReverseObjDir8
02:0003DED0 41EC045E        	  9681:     lea     ($045E,A4),A0
02:0003DED4 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003DED8 41EC045E        	  9683:     lea     ($045E,A4),A0
02:0003DEDC 52302000        	  9684:     addq.b  #1,(A0,D2.W)
                            	  9685:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9686:     ; should randomly change direction.
                            	  9687:     ;
02:0003DEE0 E208            	  9688:     lsr.b  #1,D0   ; LSR A
02:0003DEE2 640A            	  9689:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003DEE4 7000            	  9690:     moveq   #0,D0
02:0003DEE6 41EC0451        	  9691:     lea     ($0451,A4),A0
02:0003DEEA 11802000        	  9692:     move.b  D0,(A0,D2.W)
                            	  9693:     even
                            	  9694: _L_z04_UpdateGohma_AnimateEye:
                            	  9695:     ; Animate the eye.
                            	  9696:     ;
                            	  9697:     ; First, if the counter for when to open the eye next = 0, then
                            	  9698:     ; set it to a random value at least $C0; and set the timer for
                            	  9699:     ; keeping the eye open to $80.
                            	  9700:     ;
                            	  9701:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9702:     ; every other frame.
                            	  9703:     ;
02:0003DEEE 41EC042C        	  9704:     lea     ($042C,A4),A0
02:0003DEF2 10302000        	  9705:     move.b  (A0,D2.W),D0
02:0003DEF6 661E            	  9706:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003DEF8 103C0080        	  9707:     move.b  #$80,D0
02:0003DEFC 41EC0444        	  9708:     lea     ($0444,A4),A0
02:0003DF00 11802000        	  9709:     move.b  D0,(A0,D2.W)
02:0003DF04 103C00C0        	  9710:     move.b  #$C0,D0
02:0003DF08 12342018        	  9711:     move.b  ($18,A4,D2.W),D1
02:0003DF0C 8001            	  9712:     or.b  D1,D0
02:0003DF0E 41EC042C        	  9713:     lea     ($042C,A4),A0
02:0003DF12 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
                            	  9716: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9717:     ; Decrement the next-open-eye counter.
                            	  9718:     ;
02:0003DF16 102C0015        	  9719:     move.b  ($0015,A4),D0
02:0003DF1A E208            	  9720:     lsr.b  #1,D0   ; LSR A
02:0003DF1C 6408            	  9721:     bcc  _anon_z04_122
02:0003DF1E 41EC042C        	  9722:     lea     ($042C,A4),A0
02:0003DF22 53302000        	  9723:     subq.b  #1,(A0,D2.W)
                            	  9724: _anon_z04_122:
                            	  9725:     ; If open eye timer = 0, then the eye is closed.
                            	  9726:     ; Go animate it differently.
                            	  9727:     ;
02:0003DF26 41EC0444        	  9728:     lea     ($0444,A4),A0
02:0003DF2A 10302000        	  9729:     move.b  (A0,D2.W),D0
02:0003DF2E 674A            	  9730:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9731:     ; Else decrement the open eye timer.
                            	  9732:     ;
02:0003DF30 41EC0444        	  9733:     lea     ($0444,A4),A0
02:0003DF34 53302000        	  9734:     subq.b  #1,(A0,D2.W)
                            	  9735:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9736:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9737:     ;
02:0003DF38 7602            	  9738:     moveq   #2,D3
02:0003DF3A 0C000070        	  9739:     cmpi.b  #$70,D0
02:0003DF3E 6408            	  9740:     bcc  _anon_z04_123
02:0003DF40 0C000010        	  9741:     cmpi.b  #$10,D0
02:0003DF44 6502            	  9742:     bcs  _anon_z04_123
02:0003DF46 5203            	  9743:     addq.b  #1,D3
                            	  9744: _anon_z04_123:
02:0003DF48 1003            	  9745:     move.b  D3,D0
                            	  9746:     even
