                            	   923: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_CheckPickUp:
                            	   924:     ; This is a cave where the player chooses or touches an item:
                            	   925:     ; - give item
                            	   926:     ; - shop
                            	   927:     ; - hint
                            	   928:     ; - money game
                            	   929:     ;
