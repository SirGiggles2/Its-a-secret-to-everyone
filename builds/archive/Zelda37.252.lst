                            	  4007: PondFairy_MoveHearts:
                            	  4008:     ; Loop over each heart from object slot 2 to 9.
                            	  4009:     ;
                            	  4010:     ; Even though they are not standalone objects, their info
                            	  4011:     ; is stored in those object slots.
                            	  4012:     ;
02:0003B4B8 7402            	  4013:     moveq   #2,D2
                            	  4014:     even
                            	  4015: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  4016:     ; If the current heart's state <> 0, then go move it.
                            	  4017:     ; Else we have to wait for it to come out at the right time.
                            	  4018:     ;
02:0003B4BA 41EC00AC        	  4019:     lea     ($00AC,A4),A0
02:0003B4BE 10302000        	  4020:     move.b  (A0,D2.W),D0
02:0003B4C2 667C            	  4021:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  4022:     ; The current heart's state = 0.
                            	  4023:     ;
                            	  4024:     ; If object slot = 2, then go make it appear. This is the first
                            	  4025:     ; heart to show up.
                            	  4026:     ;
02:0003B4C4 0C020002        	  4027:     cmpi.b  #$02,D2
02:0003B4C8 6732            	  4028:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  4029:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  4030:     ; go start over.
                            	  4031:     ;
                            	  4032:     ; TODO:
                            	  4033:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  4034:     ;
02:0003B4CA 102C00AE        	  4035:     move.b  ($00AE,A4),D0
02:0003B4CE 67EA            	  4036:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  4037:     ; Look up the starting angle of this heart with the index
                            	  4038:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  4039:     ; then loop again.
                            	  4040:     ;
02:0003B4D0 1002            	  4041:     move.b  D2,D0
02:0003B4D2 003C0011        	  4042:     ori     #$11,CCR  ; SEC: set C+X
02:0003B4D6 123C0003        	  4043:     move.b  #$03,D1
02:0003B4DA 0A3C0010        	  4044:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B4DE 9101            	  4045:     subx.b  D1,D0   ; SBC #$03
02:0003B4E0 0A3C0010        	  4046:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B4E4 7600            	  4047:     moveq   #0,D3
02:0003B4E6 1600            	  4048:     move.b  D0,D3
02:0003B4E8 102C0396        	  4049:     move.b  ($0396,A4),D0
02:0003B4EC 41F90003B4B0    	  4050:     lea     (PondHeartStartAngles).l,A0
02:0003B4F2 12303000        	  4051:     move.b  (A0,D3.W),D1
02:0003B4F6 B001            	  4052:     cmp.b   D1,D0
02:0003B4F8 66000086        	  4053:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  4054:     even
                            	  4055: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  4056:     ; Set up this heart. Set its state to 1.
                            	  4057:     ;
02:0003B4FC 41EC00AC        	  4058:     lea     ($00AC,A4),A0
02:0003B500 52302000        	  4059:     addq.b  #1,(A0,D2.W)
                            	  4060:     ; TODO: ?
                            	  4061:     ;
02:0003B504 103C0080        	  4062:     move.b  #$80,D0
02:0003B508 41EC0098        	  4063:     lea     ($0098,A4),A0
02:0003B50C 11802000        	  4064:     move.b  D0,(A0,D2.W)
                            	  4065:     ; Starting angle $18 (N).
                            	  4066:     ;
02:0003B510 7018            	  4067:     moveq   #24,D0
02:0003B512 41EC0394        	  4068:     lea     ($0394,A4),A0
02:0003B516 11802000        	  4069:     move.b  D0,(A0,D2.W)
                            	  4070:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  4071:     ;
02:0003B51A 102C0071        	  4072:     move.b  ($0071,A4),D0
02:0003B51E 19802070        	  4073:     move.b  D0,($70,A4,D2.W)
                            	  4074:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  4075:     ;
02:0003B522 102C0085        	  4076:     move.b  ($0085,A4),D0
02:0003B526 003C0011        	  4077:     ori     #$11,CCR  ; SEC: set C+X
02:0003B52A 123C001C        	  4078:     move.b  #$1C,D1
02:0003B52E 0A3C0010        	  4079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B532 9101            	  4080:     subx.b  D1,D0   ; SBC #$1C
02:0003B534 0A3C0010        	  4081:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B538 41EC0084        	  4082:     lea     ($0084,A4),A0
02:0003B53C 11802000        	  4083:     move.b  D0,(A0,D2.W)
                            	  4084:     even
                            	  4085: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  4086:     ; Decrease the angle by $00.60.
                            	  4087:     ;
02:0003B540 7000            	  4088:     moveq   #0,D0
02:0003B542 1940000B        	  4089:     move.b  D0,($000B,A4)
02:0003B546 7060            	  4090:     moveq   #96,D0
02:0003B548 6100492A        	  4091:     jsr     DecreaseObjectAngle
                            	  4092:     ; Rotate the heart's location by the change in angle.
                            	  4093:     ; Use 6 for the number of bits of sine/cosine to use
                            	  4094:     ; for a large ring.
                            	  4095:     ;
02:0003B54C 7006            	  4096:     moveq   #6,D0
02:0003B54E 7600            	  4097:     moveq   #0,D3
02:0003B550 1600            	  4098:     move.b  D0,D3
02:0003B552 61004770        	  4099:     jsr     RotateObjectLocation
02:0003B556 41EC0084        	  4100:     lea     ($0084,A4),A0
02:0003B55A 11802000        	  4101:     move.b  D0,(A0,D2.W)
02:0003B55E 1002            	  4102:     move.b  D2,D0
02:0003B560 1B00            	  4103:     move.b  D0,-(A5)  ; PHA
02:0003B562 4EB900031CB2    	  4104:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
02:0003B568 4EB90004CB14    	  4105:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4106:     ; The variable for the currently updating object slot has to be
                            	  4107:     ; set to the heart's object slot for this drawing routine to work.
                            	  4108:     ;
02:0003B56E 7400            	  4109:     moveq   #0,D2
02:0003B570 142C0340        	  4110:     move.b  ($0340,A4),D2
02:0003B574 4EB9000319C2    	  4111:     jsr     DrawObjectNotMirrored
02:0003B57A 101D            	  4112:     move.b  (A5)+,D0  ; PLA
02:0003B57C 7400            	  4113:     moveq   #0,D2
02:0003B57E 1400            	  4114:     move.b  D0,D2
                            	  4115:     even
                            	  4116: _L_z04_PondFairy_MoveHearts_NextLoopHeart:
                            	  4117:     ; Bottom of the loop.
                            	  4118:     ; Increase the object slot.
                            	  4119:     ;
02:0003B580 5202            	  4120:     addq.b  #1,D2
02:0003B582 0C02000A        	  4121:     cmpi.b  #$0A,D2
02:0003B586 6600FF32        	  4122:     bne  _L_z04_PondFairy_MoveHearts_LoopHeart
02:0003B58A 0A3C0001        	  4123:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003B58E 4E75            	  4124:     rts
