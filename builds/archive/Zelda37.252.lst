02:00041874 102C0098        	  2971:     move.b  ($0098,A4),D0
02:00041878 0200000C        	  2972:     andi.b #$0C,D0
02:0004187C 6602            	  2973:     bne  _anon_z05_77
02:0004187E 7603            	  2974:     moveq   #3,D3
                            	  2975: _anon_z05_77:
02:00041880 1003            	  2976:     move.b  D3,D0
02:00041882 122C03F8        	  2977:     move.b  ($03F8,A4),D1
