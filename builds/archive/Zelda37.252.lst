02:0003B0CA 0C000006        	  3391:     cmpi.b  #$06,D0
02:0003B0CE 6506            	  3392:     bcs  _anon_z04_47
02:0003B0D0 532C0510        	  3393:     subq.b  #1,($0510,A4)
02:0003B0D4 7000            	  3394:     moveq   #0,D0
                            	  3395: _anon_z04_47:
