                            	  7729:     ; If secret color cycle >= $C, return.
                            	  7730:     ;
02:0004D32E 7600            	  7731:     moveq   #0,D3
02:0004D330 162C051A        	  7732:     move.b  ($051A,A4),D3
02:0004D334 0C03000C        	  7733:     cmpi.b  #$0C,D3
02:0004D338 6502            	  7734:     bcs.s  __far_z_07_0124
02:0004D33A 605C            	  7735:     jmp  L1FF28_Exit
                            	  7736: __far_z_07_0124:
                            	  7737:     ; 7 of every 8 frames, return.
                            	  7738:     ;
02:0004D33C 102C0015        	  7739:     move.b  ($0015,A4),D0
02:0004D340 02000007        	  7740:     andi.b #$07,D0
02:0004D344 0C000004        	  7741:     cmpi.b  #$04,D0
02:0004D348 6702            	  7742:     beq.s  __far_z_07_0125
02:0004D34A 604C            	  7743:     jmp  L1FF28_Exit
                            	  7744: __far_z_07_0125:
                            	  7745:     ; So, every 8 frames:
                            	  7746:     ; 1. Increment the secret color cycle count.
                            	  7747:     ; 2. Change the water palette.
                            	  7748:     ;
                            	  7749:     ; But when the count = $B, go reveal the stairs.
                            	  7750:     ;
02:0004D34C 522C051A        	  7751:     addq.b  #1,($051A,A4)
02:0004D350 0C03000B        	  7752:     cmpi.b  #$0B,D3
02:0004D354 6602            	  7753:     bne.s  __far_z_07_0126
02:0004D356 6042            	  7754:     jmp  RevealPondStairs
