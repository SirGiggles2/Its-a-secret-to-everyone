02:0002E8F0 102C0001        	   698:     move.b  ($0001,A4),D0
02:0002E8F4 6148            	   699:     jsr     SwapSpaceAndSign
02:0002E8F6 41EC0307        	   700:     lea     ($0307,A4),A0
02:0002E8FA 11803000        	   701:     move.b  D0,(A0,D3.W)
02:0002E8FE 102C0003        	   702:     move.b  ($0003,A4),D0
