02:0004C32A 1940000F        	  5768:     move.b  D0,($000F,A4)
02:0004C32E 41EC0098        	  5769:     lea     ($0098,A4),A0
02:0004C332 11802000        	  5770:     move.b  D0,(A0,D2.W)
02:0004C336 6100F464        	  5771:     jsr     MoveObject
                            	  5772:     even
                            	  5773: AnimateBoomerangAndCheckCollision:
                            	  5774:     ; Decrement animation counter; and when it reaches 0:
                            	  5775:     ; 1. arm it again for 2 frames
                            	  5776:     ; 2. advance the minor state within a cycle of 8
                            	  5777:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5778:     ;
02:0004C33A 41EC03D0        	  5779:     lea     ($03D0,A4),A0
02:0004C33E 53302000        	  5780:     subq.b  #1,(A0,D2.W)
02:0004C342 6702            	  5781:     beq.s  __far_z_07_0086
02:0004C344 6036            	  5782:     jmp  DrawBoomerangAndCheckCollision
                            	  5783: __far_z_07_0086:
