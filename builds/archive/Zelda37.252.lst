02:0002EA6C 023C00EE        	   911:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EA70 123C0014        	   912:     move.b  #$14,D1
02:0002EA74 D101            	   913:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002EA76 1940067E        	   914:     move.b  D0,($067E,A4)
                            	   915:     ; Mark this secret taken.
                            	   916:     ;
02:0002EA7A 610028E8        	   917:     jsr     SetRoomFlagUWItemState
