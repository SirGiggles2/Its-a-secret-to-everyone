                            	  6118:     ; Flag collision with [0C], even though [06] was already set.
                            	  6119:     ;
02:00031FBA 522C000C        	  6120:     addq.b  #1,($000C,A4)
                            	  6121:     ; Unpack the damage points for the monster's type.
                            	  6122:     ; The low nibble is the high byte.
                            	  6123:     ; (Damage points byte AND $F0) is the low byte.
                            	  6124:     ;
02:00031FBE 7600            	  6125:     moveq   #0,D3
02:00031FC0 41EC034F        	  6126:     lea     ($034F,A4),A0
02:00031FC4 16302000        	  6127:     move.b  (A0,D2.W),D3
02:00031FC8 41F900031E2A    	  6128:     lea     (ObjTypeToDamagePoints).l,A0
02:00031FCE 10303000        	  6129:     move.b  (A0,D3.W),D0
02:00031FD2 1B00            	  6130:     move.b  D0,-(A5)  ; PHA
02:00031FD4 0200000F        	  6131:     andi.b #$0F,D0
02:00031FD8 1940000D        	  6132:     move.b  D0,($000D,A4)
02:00031FDC 101D            	  6133:     move.b  (A5)+,D0  ; PLA
02:00031FDE 020000F0        	  6134:     andi.b #$F0,D0
02:00031FE2 1940000E        	  6135:     move.b  D0,($000E,A4)
                            	  6136: ; Params:
                            	  6137: ; X: object index of the attacker
                            	  6138: ; [0D]: damage points high byte
                            	  6139: ; [0E]: damage points low byte
                            	  6140: ;
                            	  6141: ;
                            	  6142: ; If object type is not whirlwind, then make the "hurt" sound effect.
                            	  6143: ;
                            	  6144:     even
                            	  6145: Link_BeHarmed:
02:00031FE6 7600            	  6146:     moveq   #0,D3
02:00031FE8 41EC034F        	  6147:     lea     ($034F,A4),A0
02:00031FEC 16302000        	  6148:     move.b  (A0,D2.W),D3
02:00031FF0 0C03002E        	  6149:     cmpi.b  #$2E,D3
