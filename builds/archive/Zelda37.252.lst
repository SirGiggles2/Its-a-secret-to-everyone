02:0003C912 10303000        	  6742:     move.b  (A0,D3.W),D0
02:0003C916 7600            	  6743:     moveq   #0,D3
02:0003C918 1600            	  6744:     move.b  D0,D3
02:0003C91A 101D            	  6745:     move.b  (A5)+,D0  ; PLA
02:0003C91C 41EC0201        	  6746:     lea     ($0201,A4),A0
02:0003C920 11803000        	  6747:     move.b  D0,(A0,D3.W)
02:0003C924 1014            	  6748:     move.b  ($0000,A4),D0
02:0003C926 41EC0203        	  6749:     lea     ($0203,A4),A0
02:0003C92A 11803000        	  6750:     move.b  D0,(A0,D3.W)
02:0003C92E 102C0001        	  6751:     move.b  ($0001,A4),D0
