                            	   320:     ;
02:00040036 522C00E1        	   321:     addq.b  #1,($00E1,A4)
02:0004003A 102C0010        	   322:     move.b  ($0010,A4),D0
02:0004003E 67000084        	   323:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:00040042 102C0012        	   324:     move.b  ($0012,A4),D0
02:00040046 0C000009        	   325:     cmpi.b  #$09,D0
02:0004004A 6778            	   326:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   327:     ; Calculate the X coordinate of the submenu position marker.
                            	   328:     ;
                            	   329:     ; First, mask off the high nibble of the room ID and multiply by
                            	   330:     ; the width of a tile, 8. Store the result in [00].
                            	   331:     ;
02:0004004C 102C00EB        	   332:     move.b  ($00EB,A4),D0
02:00040050 0200000F        	   333:     andi.b #$0F,D0
02:00040054 E308            	   334:     lsl.b  #1,D0   ; ASL A
02:00040056 E308            	   335:     lsl.b  #1,D0   ; ASL A
02:00040058 E308            	   336:     lsl.b  #1,D0   ; ASL A
02:0004005A 1880            	   337:     move.b  D0,($0000,A4)
                            	   338:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   339:     ; negative or left rotation by ($10 - rotation value).
                            	   340:     ;
                            	   341:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   342:     ; the width of a tile. Then negate it. The final result is the
                            	   343:     ; negative offset.
                            	   344:     ;
02:0004005C 103900FF6BAB    	   345:     move.b  (NES_SRAM+$0BAB).l,D0
02:00040062 0C000008        	   346:     cmpi.b  #$08,D0
02:00040066 6520            	   347:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:00040068 7010            	   348:     moveq   #16,D0
02:0004006A 123900FF6BAB    	   349:     move.b  (NES_SRAM+$0BAB).l,D1
02:00040070 0A3C0010        	   350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040074 9101            	   351:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:00040076 0A3C0010        	   352:     eori    #$10,CCR  ; restore X = 6502 C
02:0004007A E308            	   353:     lsl.b  #1,D0   ; ASL A
02:0004007C E308            	   354:     lsl.b  #1,D0   ; ASL A
02:0004007E E308            	   355:     lsl.b  #1,D0   ; ASL A
