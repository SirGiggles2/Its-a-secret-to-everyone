02:00030F5A 023C00EE        	  3991:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030F5E 122C0001        	  3992:     move.b  ($0001,A4),D1
02:00030F62 D101            	  3993:     addx.b  D1,D0   ; ADC $01
