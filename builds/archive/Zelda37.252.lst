                            	  4337:     ; The effect involves turning grayscale rendering on and off
                            	  4338:     ; in PPUMASK.
                            	  4339:     ;
                            	  4340:     ; Start by setting A register to the PPU mask shifted right to
                            	  4341:     ; throw away the grayscale bit.
                            	  4342:     ;
02:0003117C 102C00FE        	  4343:     move.b  ($00FE,A4),D0
02:00031180 E208            	  4344:     lsr.b  #1,D0   ; LSR A
