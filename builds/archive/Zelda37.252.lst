                            	  1893: UpdateWhirlwind_Full:
                            	  1894:     ; Get Link's halted state.
                            	  1895:     ;
02:00030174 102C00AC        	  1896:     move.b  ($00AC,A4),D0
02:00030178 02000040        	  1897:     andi.b #$40,D0
02:0003017C 7600            	  1898:     moveq   #0,D3
02:0003017E 1600            	  1899:     move.b  D0,D3
                            	  1900:     ; Add 2 to whirlwind X.
                            	  1901:     ;
02:00030180 7002            	  1902:     moveq   #2,D0
02:00030182 023C00EE        	  1903:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030186 12342070        	  1904:     move.b  ($70,A4,D2.W),D1
02:0003018A D101            	  1905:     addx.b  D1,D0   ; ADC ObjX,X
02:0003018C 19802070        	  1906:     move.b  D0,($70,A4,D2.W)
                            	  1907:     ; If Link is not halted or teleporting state = 0, then
                            	  1908:     ; go check for collision with Link.
                            	  1909:     ;
02:00030190 0C030040        	  1910:     cmpi.b  #$40,D3
02:00030194 6638            	  1911:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:00030196 7600            	  1912:     moveq   #0,D3
02:00030198 162C0522        	  1913:     move.b  ($0522,A4),D3
02:0003019C 6730            	  1914:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1915:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1916:     ;
                            	  1917:     ; Set Link's X to whirlwind's.
                            	  1918:     ;
02:0003019E 19400070        	  1919:     move.b  D0,($0070,A4)
                            	  1920:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1921:     ; the right screen edge and draw.
                            	  1922:     ;
02:000301A2 5303            	  1923:     subq.b  #1,D3
02:000301A4 6776            	  1924:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:000301A6 0C000080        	  1925:     cmpi.b  #$80,D0
02:000301AA 6670            	  1926:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1927:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1928:     ;
                            	  1929:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1930:     ;
02:000301AC E308            	  1931:     lsl.b  #1,D0   ; ASL A
02:000301AE 194000AC        	  1932:     move.b  D0,($00AC,A4)
02:000301B2 19400522        	  1933:     move.b  D0,($0522,A4)
02:000301B6 41EC034F        	  1934:     lea     ($034F,A4),A0
02:000301BA 11802000        	  1935:     move.b  D0,(A0,D2.W)
                            	  1936:     ; Update the player position marker, and draw one last time.
                            	  1937:     ;
02:000301BE 1002            	  1938:     move.b  D2,D0
02:000301C0 1B00            	  1939:     move.b  D0,-(A5)  ; PHA
02:000301C2 61000FE8        	  1940:     jsr     UpdatePlayerPositionMarker
02:000301C6 101D            	  1941:     move.b  (A5)+,D0  ; PLA
02:000301C8 7400            	  1942:     moveq   #0,D2
02:000301CA 1400            	  1943:     move.b  D0,D2
02:000301CC 6070            	  1944:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1945: 
                            	  1946:     even
                            	  1947: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1948:     ; Link is not halted or teleporting state = 0.
                            	  1949:     ; Try to pick up Link.
                            	  1950:     ;
                            	  1951:     ; If the whirlwind does not collide with Link, then go check
                            	  1952:     ; for the screen's right edge.
                            	  1953:     ;
02:000301CE 61001CB8        	  1954:     jsr     CheckLinkCollision
02:000301D2 102C0006        	  1955:     move.b  ($0006,A4),D0
02:000301D6 6744            	  1956:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1957:     ; Collided with Link.
                            	  1958:     ;
                            	  1959:     ; Make Link face right. Reset shove info and subroom type.
                            	  1960:     ;
02:000301D8 7001            	  1961:     moveq   #1,D0
02:000301DA 19400098        	  1962:     move.b  D0,($0098,A4)
02:000301DE E208            	  1963:     lsr.b  #1,D0   ; LSR A
02:000301E0 194000C0        	  1964:     move.b  D0,($00C0,A4)
02:000301E4 194000D3        	  1965:     move.b  D0,($00D3,A4)
02:000301E8 1940005A        	  1966:     move.b  D0,($005A,A4)
                            	  1967:     ; Halt Link (state $40), and hide him.
                            	  1968:     ;
02:000301EC 7040            	  1969:     moveq   #64,D0
02:000301EE 194000AC        	  1970:     move.b  D0,($00AC,A4)
02:000301F2 103C00F8        	  1971:     move.b  #$F8,D0
02:000301F6 19400248        	  1972:     move.b  D0,($0248,A4)
02:000301FA 1940024C        	  1973:     move.b  D0,($024C,A4)
                            	  1974:     ; Find and set the room that will behave as the previous room
                            	  1975:     ; when scrolling right to the room with the level's entrance.
                            	  1976:     ;
02:000301FE 102C0523        	  1977:     move.b  ($0523,A4),D0
02:00030202 02000007        	  1978:     andi.b #$07,D0
02:00030206 7600            	  1979:     moveq   #0,D3
02:00030208 1600            	  1980:     move.b  D0,D3
02:0003020A 41F90003016C    	  1981:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030210 10303000        	  1982:     move.b  (A0,D3.W),D0
02:00030214 194000EA        	  1983:     move.b  D0,($00EA,A4)
                            	  1984:     ; Set teleporting state 1.
                            	  1985:     ;
02:00030218 522C0522        	  1986:     addq.b  #1,($0522,A4)
                            	  1987:     even
                            	  1988: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1989:     ; If whirlwind's X < $F0, go draw.
                            	  1990:     ;
02:0003021C 10342070        	  1991:     move.b  ($70,A4,D2.W),D0
02:00030220 0C0000F0        	  1992:     cmpi.b  #$F0,D0
02:00030224 6518            	  1993:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1994:     ; The whirlwind has reached the right edge of the screen.
                            	  1995:     ;
                            	  1996:     ; Destroy the object.
                            	  1997:     ;
02:00030226 611A            	  1998:     jsr     DestroyWhirlwind
                            	  1999:     ; If teleporting state <> 0, we picked up Link.
                            	  2000:     ; So, go to the next mode.
                            	  2001:     ;
                            	  2002:     ; Either way, draw one last time.
                            	  2003:     ;
02:00030228 102C0522        	  2004:     move.b  ($0522,A4),D0
02:0003022C 6710            	  2005:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:0003022E 1002            	  2006:     move.b  D2,D0
02:00030230 1B00            	  2007:     move.b  D0,-(A5)  ; PHA
02:00030232 4EB90004B98E    	  2008:     jsr     GoToNextModeFromPlay
02:00030238 101D            	  2009:     move.b  (A5)+,D0  ; PLA
02:0003023A 7400            	  2010:     moveq   #0,D2
02:0003023C 1400            	  2011:     move.b  D0,D2
                            	  2012:     even
                            	  2013: _L_z01_UpdateWhirlwind_Full_Draw:
02:0003023E 60000094        	  2014:     jmp     DrawWhirlwind
                            	  2015: 
                            	  2016:     even
                            	  2017: DestroyWhirlwind:
02:00030242 6000B5D0        	  2018:     jmp     c_destroy_whirlwind
                            	  2019: 
                            	  2020: SummonWhirlwind:
                            	  2021:     ; If not in mode 5, return.
                            	  2022:     ;
02:00030246 102C0012        	  2023:     move.b  ($0012,A4),D0
02:0003024A 0C000005        	  2024:     cmpi.b  #$05,D0
02:0003024E 6704            	  2025:     beq.s  __far_z_01_0009
02:00030250 60000080        	  2026:     jmp  L6104_Exit
                            	  2027: __far_z_01_0009:
                            	  2028:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  2029:     ;
02:00030254 6178            	  2030:     jsr     AdvanceTeleportingLevelIndex
02:00030256 102C0523        	  2031:     move.b  ($0523,A4),D0
02:0003025A 02000007        	  2032:     andi.b #$07,D0
02:0003025E 7600            	  2033:     moveq   #0,D3
02:00030260 1600            	  2034:     move.b  D0,D3
02:00030262 41F90004A8A6    	  2035:     lea     (LevelMasks).l,A0
02:00030268 10303000        	  2036:     move.b  (A0,D3.W),D0
02:0003026C 1880            	  2037:     move.b  D0,($0000,A4)
                            	  2038:     even
                            	  2039: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  2040:     ; If there are no triforce pieces, then return.
                            	  2041:     ;
02:0003026E 102C0671        	  2042:     move.b  ($0671,A4),D0
02:00030272 6602            	  2043:     bne.s  __far_z_01_0010
02:00030274 605C            	  2044:     jmp  L6104_Exit
                            	  2045: __far_z_01_0010:
                            	  2046:     ; If we have gotten this triforce piece, then go try to make a
                            	  2047:     ; whirlwind.
                            	  2048:     ;
02:00030276 1214            	  2049:     move.b  ($0000,A4),D1
02:00030278 C200            	  2050:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003027A 662C            	  2051:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  2052:     ; We have not gotten this piece.
                            	  2053:     ; First, advance the teleporting index again.
                            	  2054:     ;
02:0003027C 6150            	  2055:     jsr     AdvanceTeleportingLevelIndex
                            	  2056:     ; If the direction Link is facing is an increasing one, then
                            	  2057:     ; rotate the level mask in [00] left to correspond to the higher
                            	  2058:     ; level number. Then go test this new mask.
                            	  2059:     ;
02:0003027E 102C0098        	  2060:     move.b  ($0098,A4),D0
02:00030282 02000009        	  2061:     andi.b #$09,D0
02:00030286 6710            	  2062:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:00030288 1214            	  2063:     move.b  ($0000,A4),D1
02:0003028A E309            	  2064:     lsl.b  #1,D1   ; ASL $00
02:0003028C 1881            	  2065:     move.b  D1,($0000,A4)
02:0003028E 64DE            	  2066:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:00030290 1214            	  2067:     move.b  ($0000,A4),D1
02:00030292 E311            	  2068:     roxl.b  #1,D1   ; ROL $00
02:00030294 1881            	  2069:     move.b  D1,($0000,A4)
02:00030296 60D6            	  2070:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2071: 
                            	  2072:     even
                            	  2073: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  2074:     ; If instead the direction is a decreasing one, then
                            	  2075:     ; rotate right to correspond to the lower level number.
                            	  2076:     ; Then go test this new mask.
                            	  2077:     ;
02:00030298 1214            	  2078:     move.b  ($0000,A4),D1
02:0003029A E209            	  2079:     lsr.b  #1,D1   ; LSR $00
02:0003029C 1881            	  2080:     move.b  D1,($0000,A4)
02:0003029E 64CE            	  2081:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:000302A0 1214            	  2082:     move.b  ($0000,A4),D1
02:000302A2 E211            	  2083:     roxr.b  #1,D1   ; ROR $00
02:000302A4 1881            	  2084:     move.b  D1,($0000,A4)
02:000302A6 60C6            	  2085:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  2086: 
                            	  2087:     even
                            	  2088: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  2089:     ; If already summoned or in the middle of teleporting, then
                            	  2090:     ; return and don't summon another one.
                            	  2091:     ;
02:000302A8 102C0508        	  2092:     move.b  ($0508,A4),D0
02:000302AC 122C0522        	  2093:     move.b  ($0522,A4),D1
02:000302B0 8001            	  2094:     or.b  D1,D0
02:000302B2 6702            	  2095:     beq.s  __far_z_01_0011
02:000302B4 601C            	  2096:     jmp  L6104_Exit
                            	  2097: __far_z_01_0011:
                            	  2098:     ; Return if we can't find an empty monster slot.
                            	  2099:     ;
02:000302B6 4EB90004D2FC    	  2100:     jsr     FindEmptyMonsterSlot
02:000302BC 6602            	  2101:     bne.s  __far_z_01_0012
02:000302BE 6012            	  2102:     jmp  L6104_Exit
                            	  2103: __far_z_01_0012:
                            	  2104:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  2105:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  2106:     ;
02:000302C0 522C0508        	  2107:     addq.b  #1,($0508,A4)
02:000302C4 1003            	  2108:     move.b  D3,D0
02:000302C6 7400            	  2109:     moveq   #0,D2
02:000302C8 1400            	  2110:     move.b  D0,D2
02:000302CA 6000FE9C        	  2111:     jmp     SetUpWhirlwind
                            	  2112: 
                            	  2113:     even
                            	  2114: AdvanceTeleportingLevelIndex:
02:000302CE 6000C3D8        	  2115:     jmp     c_advance_teleporting_level_index
                            	  2116: 
                            	  2117: L6104_Exit:
02:000302D2 4E75            	  2118:     rts
                            	  2119: 
                            	  2120:     even
                            	  2121: DrawWhirlwind:
                            	  2122:     ; Frames last 1 screen frame.
                            	  2123:     ;
02:000302D4 7001            	  2124:     moveq   #1,D0
02:000302D6 4EB90004CB0E    	  2125:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  2126:     ; The whirlwind flashes by using a palette row based on the
                            	  2127:     ; screen frame counter.
                            	  2128:     ;
02:000302DC 102C0015        	  2129:     move.b  ($0015,A4),D0
02:000302E0 02000003        	  2130:     andi.b #$03,D0
02:000302E4 610019CE        	  2131:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  2132:     ; Flip horizontally based on movement frame, which is
                            	  2133:     ; switched based on animation counter.
                            	  2134:     ;
02:000302E8 4EB90004CAE6    	  2135:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:000302EE 7000            	  2136:     moveq   #0,D0
02:000302F0 600016D0        	  2137:     jmp     DrawObjectNotMirrored
                            	  2138: 
                            	  2139:     even
