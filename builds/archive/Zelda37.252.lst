                            	  7736: UpdatePolsVoiceState1_Jumping:
                            	  7737:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7738:     ;
02:0003CFFE 41EC0444        	  7739:     lea     ($0444,A4),A0
02:0003D002 10302000        	  7740:     move.b  (A0,D2.W),D0
