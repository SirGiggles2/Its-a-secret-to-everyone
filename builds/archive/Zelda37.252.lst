02:0004CB68 660C            	  6978:     bne  _anon_z07_39
02:0004CB6A 102C00AC        	  6979:     move.b  ($00AC,A4),D0
02:0004CB6E 020000C0        	  6980:     andi.b #$C0,D0
02:0004CB72 194000AC        	  6981:     move.b  D0,($00AC,A4)
