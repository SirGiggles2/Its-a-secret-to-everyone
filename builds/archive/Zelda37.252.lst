                            	  9821:     ; Draw the left legs.
                            	  9822:     ;
02:0003DFCC 7600            	  9823:     moveq   #0,D3
                            	  9824: ; Params:
                            	  9825: ; Y: side: 0 for left, 1 for right
                            	  9826: ;
                            	  9827: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9828: ; store the sprite's X in [00].
                            	  9829: ;
                            	  9830:     even
                            	  9831: Gohma_DrawLegsOneSide:
02:0003DFCE 10342070        	  9832:     move.b  ($70,A4,D2.W),D0
02:0003DFD2 023C00EE        	  9833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFD6 41F90003DFAC    	  9834:     lea     (GohmaLegOffsetsX).l,A0
02:0003DFDC 12303000        	  9835:     move.b  (A0,D3.W),D1
02:0003DFE0 D101            	  9836:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003DFE2 1880            	  9837:     move.b  D0,($0000,A4)
                            	  9838:     ; The object's Y is the sprite's.
                            	  9839:     ;
02:0003DFE4 41EC0084        	  9840:     lea     ($0084,A4),A0
02:0003DFE8 10302000        	  9841:     move.b  (A0,D2.W),D0
02:0003DFEC 19400001        	  9842:     move.b  D0,($0001,A4)
02:0003DFF0 612A            	  9843:     jsr     Gohma_SetSpriteAttributes
                            	  9844:     ; There are only two frame images for legs: left and right.
                            	  9845:     ; There are two animation frames. They are animated as follows:
                            	  9846:     ;
                            	  9847:     ; Frame 0:
                            	  9848:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9849:     ; horizontal flipping = frame number = 0
                            	  9850:     ; 
                            	  9851:     ; Frame 1:
                            	  9852:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9853:     ; horizontal flipping = frame number = 1
                            	  9854:     ;
02:0003DFF2 4EB90004CAE6    	  9855:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003DFF8 1003            	  9856:     move.b  D3,D0
02:0003DFFA 023C00EE        	  9857:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFFE 41EC03E4        	  9858:     lea     ($03E4,A4),A0
02:0003E002 12302000        	  9859:     move.b  (A0,D2.W),D1
02:0003E006 D101            	  9860:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E008 02000001        	  9861:     andi.b #$01,D0
02:0003E00C 023C00EE        	  9862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E010 123C0004        	  9863:     move.b  #$04,D1
02:0003E014 D101            	  9864:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E016 4EF9000319C2    	  9865:     jmp     DrawObjectNotMirrored
                            	  9866: 
                            	  9867: ; Returns:
