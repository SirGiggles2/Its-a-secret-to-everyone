02:0003B120 7600            	  3428:     moveq   #0,D3
02:0003B122 41EC034F        	  3429:     lea     ($034F,A4),A0
02:0003B126 16302000        	  3430:     move.b  (A0,D2.W),D3
02:0003B12A 0C030009        	  3431:     cmpi.b  #$09,D3
02:0003B12E 6402            	  3432:     bcc  _anon_z04_48
02:0003B130 7070            	  3433:     moveq   #112,D0
                            	  3434: _anon_z04_48:
