02:0003DCE8 10302000        	  9461:     move.b  (A0,D2.W),D0
02:0003DCEC 122C0002        	  9462:     move.b  ($0002,A4),D1
02:0003DCF0 E309            	  9463:     lsl.b  #1,D1   ; ASL $02
02:0003DCF2 19410002        	  9464:     move.b  D1,($0002,A4)
02:0003DCF6 122C0002        	  9465:     move.b  ($0002,A4),D1
02:0003DCFA C200            	  9466:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCFC 6716            	  9467:     beq  _L_z04_Manhandla_Move_Down
02:0003DCFE 10342070        	  9468:     move.b  ($70,A4,D2.W),D0
02:0003DD02 122C0003        	  9469:     move.b  ($0003,A4),D1
02:0003DD06 0A3C0010        	  9470:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD0A 9101            	  9471:     subx.b  D1,D0   ; SBC $03
02:0003DD0C 0A3C0010        	  9472:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD10 19802070        	  9473:     move.b  D0,($70,A4,D2.W)
                            	  9474:     even
