02:0003C1F0 41EC03BC        	  5789:     lea     ($03BC,A4),A0
02:0003C1F4 10302000        	  5790:     move.b  (A0,D2.W),D0
02:0003C1F8 6712            	  5791:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
