                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:0004379A 102C0055        	  5954:     move.b  ($0055,A4),D0
02:0004379E 19400002        	  5955:     move.b  D0,($0002,A4)
02:000437A2 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:000437A6 0C000005        	  5957:     cmpi.b  #$05,D0
02:000437AA 650C            	  5958:     bcs  _anon_z05_125
02:000437AC 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:000437AE 7004            	  5960:     moveq   #4,D0
02:000437B0 4EB9000309D6    	  5961:     jsr     PlaySample
02:000437B6 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:000437B8 0C000004        	  5969:     cmpi.b  #$04,D0
02:000437BC 6602            	  5970:     bne  _anon_z05_126
02:000437BE 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:000437C0 0C000001        	  5973:     cmpi.b  #$01,D0
02:000437C4 6602            	  5974:     bne  _anon_z05_127
02:000437C6 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:000437C8 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:000437CC 123C0003        	  5980:     move.b  #$03,D1
02:000437D0 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000437D4 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:000437D6 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:000437DA 7600            	  5984:     moveq   #0,D3
02:000437DC 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:000437DE 102C0008        	  5992:     move.b  ($0008,A4),D0
02:000437E2 6708            	  5993:     beq  _anon_z05_128
02:000437E4 0C030005        	  5994:     cmpi.b  #$05,D3
02:000437E8 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000437EA 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:000437EC 0C030003        	  5998:     cmpi.b  #$03,D3
02:000437F0 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000437F2 5303            	  6000:     subq.b  #1,D3
                            	  6001:     even
                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:000437F4 7003            	  6008:     moveq   #3,D0
02:000437F6 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:000437FA 122C0003        	  6010:     move.b  ($0003,A4),D1
02:000437FE 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043802 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:00043804 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
