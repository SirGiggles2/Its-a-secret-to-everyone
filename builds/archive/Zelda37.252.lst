02:0003076C 0A3C0010        	  2748:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030770 9101            	  2749:     subx.b  D1,D0   ; SBC ObjY,X
02:00030772 0A3C0010        	  2750:     eori    #$10,CCR  ; restore X = 6502 C
02:00030776 610006F6        	  2751:     jsr     Abs
