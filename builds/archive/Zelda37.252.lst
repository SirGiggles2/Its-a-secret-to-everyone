02:0004C314 1600            	  5763:     move.b  D0,D3
02:0004C316 41F90004BFCC    	  5764:     lea     (BoomerangQSpeedFracsX).l,A0
02:0004C31C 10303000        	  5765:     move.b  (A0,D3.W),D0
02:0004C320 4EB900030F96    	  5766:     jsr     SetBoomerangSpeed
