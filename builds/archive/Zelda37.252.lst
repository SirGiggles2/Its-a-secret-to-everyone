                            	  6937:     even
                            	  6938: _L_z07_AnimateLinkObjState_CheckState20:
                            	  6939:     ; If major state = $20
                            	  6940:     ;   if minor state = 0, make it 1
                            	  6941:     ;   else OR state with $30
                            	  6942:     ;   go set movement frame to 1
                            	  6943:     ;
02:0004CB3A 0C000020        	  6944:     cmpi.b  #$20,D0
02:0004CB3E 6624            	  6945:     bne  _L_z07_AnimateLinkObjState_CheckState30
02:0004CB40 102C00AC        	  6946:     move.b  ($00AC,A4),D0
02:0004CB44 0200000F        	  6947:     andi.b #$0F,D0
02:0004CB48 6606            	  6948:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
                            	  6949:     even
                            	  6950: _L_z07_AnimateLinkObjState_IncState:
02:0004CB4A 522C00AC        	  6951:     addq.b  #1,($00AC,A4)
02:0004CB4E 600C            	  6952:     jmp     _L_z07_AnimateLinkObjState_SetMovementFrame1
                            	  6953: 
                            	  6954:     even
                            	  6955: _L_z07_AnimateLinkObjState_CombineStateWith30:
02:0004CB50 102C00AC        	  6956:     move.b  ($00AC,A4),D0
02:0004CB54 00000030        	  6957:     ori.b #$30,D0
02:0004CB58 194000AC        	  6958:     move.b  D0,($00AC,A4)
