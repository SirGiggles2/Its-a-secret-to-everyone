02:0004C8B2 600000BA        	  6529:     jmp  DrawBomb
                            	  6530: __far_z_07_0108:
                            	  6531:     ; Minor state = 4. Try to break a wall.
                            	  6532:     ;
                            	  6533:     ; If in OW, go draw. Rock walls have a tile object that checks for bombs.
                            	  6534:     ;
