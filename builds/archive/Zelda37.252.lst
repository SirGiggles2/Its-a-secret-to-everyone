02:0003CB64 123C0008        	  7047:     move.b  #$08,D1
02:0003CB68 D101            	  7048:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7049: _anon_z04_91:
02:0003CB6A 1880            	  7050:     move.b  D0,($0000,A4)
                            	  7051:     ; Store (Y + 8) in [01].
                            	  7052:     ;
02:0003CB6C 41EC0084        	  7053:     lea     ($0084,A4),A0
02:0003CB70 10302000        	  7054:     move.b  (A0,D2.W),D0
02:0003CB74 123C0008        	  7055:     move.b  #$08,D1
02:0003CB78 D101            	  7056:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB7A 19400001        	  7057:     move.b  D0,($0001,A4)
                            	  7058:     ; Only check the first bomb slot ($10).
                            	  7059:     ;
                            	  7060:     ; Store the bomb's (X + 8) in [02].
                            	  7061:     ;
02:0003CB7E 7610            	  7062:     moveq   #16,D3
02:0003CB80 10343070        	  7063:     move.b  ($70,A4,D3.W),D0
02:0003CB84 123C0008        	  7064:     move.b  #$08,D1
02:0003CB88 D101            	  7065:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB8A 19400002        	  7066:     move.b  D0,($0002,A4)
                            	  7067:     ; Store the bomb's (Y + 8) in [03].
                            	  7068:     ;
02:0003CB8E 41EC0084        	  7069:     lea     ($0084,A4),A0
02:0003CB92 10303000        	  7070:     move.b  (A0,D3.W),D0
02:0003CB96 123C0008        	  7071:     move.b  #$08,D1
02:0003CB9A D101            	  7072:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CB9C 19400003        	  7073:     move.b  D0,($0003,A4)
                            	  7074:     ; But, if there's no bomb, then return.
                            	  7075:     ;
02:0003CBA0 41EC00AC        	  7076:     lea     ($00AC,A4),A0
02:0003CBA4 10303000        	  7077:     move.b  (A0,D3.W),D0
02:0003CBA8 6720            	  7078:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7079:     ; If the bomb has not exploded (state $12), then
                            	  7080:     ; go see if Dodongo will eat it.
