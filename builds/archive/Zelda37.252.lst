02:0003F10C 41F90003EFE2    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003F112 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003F116 7600            	 12131:     moveq   #0,D3
