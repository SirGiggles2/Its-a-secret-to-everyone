                            	   761: UpdatePersonState_Textbox:
02:0002E964 7001            	   762:     moveq   #1,D0
02:0002E966 6100C092        	   763:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002E96A 4EB90004BA30    	   764:     jsr     Link_EndMoveAndDraw_Bank1
                            	   765:     ; If the person's timer has not expired, then return.
                            	   766:     ;
