02:0003D334 E208            	  8111:     lsr.b  #1,D0   ; LSR A
02:0003D336 023C00EE        	  8112:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D33A 41EC03E4        	  8113:     lea     ($03E4,A4),A0
02:0003D33E 12302000        	  8114:     move.b  (A0,D2.W),D1
