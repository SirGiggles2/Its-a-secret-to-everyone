                            	  7188: DodongoBombNegativeLimits:
02:0003CC3C F4              	  7189:     dc.b    $F4, $F0
02:0003CC3D F0
                            	  7190: 
                            	  7191: ; Params:
                            	  7192: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  7193: ; [00]: monster hotspot X
                            	  7194: ; [01]: monster hotspot Y
                            	  7195: ; [02]: bomb hotspot X
                            	  7196: ; [03]: bomb hotspot Y
                            	  7197: ;
                            	  7198: ; Returns:
                            	  7199: ; A: 0 if the bomb is in range of the monster
                            	  7200: ; Z: 1 if the bomb is in range of the monster
                            	  7201: ; [04]: horizontal distance
                            	  7202: ; [05]: vertical distance
                            	  7203: ;
                            	  7204: ; Store the positive limit in [06], and the negative one in [07].
                            	  7205: ;
                            	  7206:     even
                            	  7207: Dodongo_IsBombInRange:
02:0003CC3E 41F90003CC3A    	  7208:     lea     (DodongoBombPositiveLimits).l,A0
02:0003CC44 10303000        	  7209:     move.b  (A0,D3.W),D0
02:0003CC48 19400006        	  7210:     move.b  D0,($0006,A4)
02:0003CC4C 41F90003CC3C    	  7211:     lea     (DodongoBombNegativeLimits).l,A0
02:0003CC52 10303000        	  7212:     move.b  (A0,D3.W),D0
02:0003CC56 19400007        	  7213:     move.b  D0,($0007,A4)
                            	  7214:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  7215:     ; the bomb is near enough the monster.
                            	  7216:     ;
02:0003CC5A 7003            	  7217:     moveq   #3,D0
02:0003CC5C 19400008        	  7218:     move.b  D0,($0008,A4)
                            	  7219:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  7220:     ;
02:0003CC60 7601            	  7221:     moveq   #1,D3
                            	  7222:     even
                            	  7223: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  7224:     ; Subtract the bomb's coordinate from the boss's,
                            	  7225:     ; The loop index determines the coordinate.
                            	  7226:     ;
02:0003CC62 10343000        	  7227:     move.b  ($00,A4,D3.W),D0
02:0003CC66 003C0011        	  7228:     ori     #$11,CCR  ; SEC: set C+X
02:0003CC6A 12343002        	  7229:     move.b  ($02,A4,D3.W),D1
02:0003CC6E 0A3C0010        	  7230:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CC72 9101            	  7231:     subx.b  D1,D0   ; SBC $0002,Y
02:0003CC74 0A3C0010        	  7232:     eori    #$10,CCR  ; restore X = 6502 C
                            	  7233:     ; If the distance >= positive offset, or < negative offset;
                            	  7234:     ; then loop again.
                            	  7235:     ;
02:0003CC78 122C0006        	  7236:     move.b  ($0006,A4),D1
02:0003CC7C B001            	  7237:     cmp.b   D1,D0
02:0003CC7E 6A16            	  7238:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003CC80 122C0007        	  7239:     move.b  ($0007,A4),D1
02:0003CC84 B001            	  7240:     cmp.b   D1,D0
02:0003CC86 6B0E            	  7241:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  7242:     ; The distance is close enough in this axis.
                            	  7243:     ;
                            	  7244:     ; Store the distance in this axis in [05] or [04],
                            	  7245:     ; depending on the loop index.
                            	  7246:     ;
02:0003CC88 19803004        	  7247:     move.b  D0,($04,A4,D3.W)
                            	  7248:     ; Shift [08] right, because we're in range in this axis.
                            	  7249:     ;
02:0003CC8C 122C0008        	  7250:     move.b  ($0008,A4),D1
02:0003CC90 E209            	  7251:     lsr.b  #1,D1   ; LSR $08
02:0003CC92 19410008        	  7252:     move.b  D1,($0008,A4)
                            	  7253:     even
                            	  7254: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003CC96 5303            	  7255:     subq.b  #1,D3
02:0003CC98 6AC8            	  7256:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  7257:     ; If close enough in both axes, then [08] will be 0.
                            	  7258:     ;
02:0003CC9A 102C0008        	  7259:     move.b  ($0008,A4),D0
02:0003CC9E 4E75            	  7260:     rts
                            	  7261: 
                            	  7262: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  7263: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  7264: ;
                            	  7265: ; But these are not typical direction indexes. Instead a
                            	  7266: ; 5-way index is used.
                            	  7267: ; A direction shifted right once becomes a 5-way index.
                            	  7268: ; The fourth element is unused.
                            	  7269: ;
                            	  7270:     even
                            	  7271: DodongoFrameImages:
02:0003CCA0 00              	  7272:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003CCA1 01
02:0003CCA2 06
02:0003CCA3 FF
02:0003CCA4 08
02:0003CCA5 02
02:0003CCA6 03
02:0003CCA7 06
02:0003CCA8 FF              	  7273:     dc.b    $FF, $08
02:0003CCA9 08
