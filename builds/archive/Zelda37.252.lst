02:0002BF8E 670A            	  2243:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2244:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2245:     eori    #$01,CCR
02:0002BF98 4E75            	  2246:     rts
                            	  2247: .cc_cnr:
02:0002BF9A 023C00FE        	  2248:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2249:     eori    #$01,CCR
02:0002BFA2 4E75            	  2250:     rts
