02:00032640 102C000F        	  7193:     move.b  ($000F,A4),D0
02:00032644 0C000003        	  7194:     cmpi.b  #$03,D0
02:00032648 6706            	  7195:     beq  _anon_z01_103
02:0003264A 0C000004        	  7196:     cmpi.b  #$04,D0
02:0003264E 6632            	  7197:     bne  _L_z01_BeginShove_Exit2
                            	  7198: _anon_z01_103:
                            	  7199:     ; If Gohma's eye state/frame image <> 3, then return.
                            	  7200:     ;
02:00032650 41EC046B        	  7201:     lea     ($046B,A4),A0
02:00032654 10302000        	  7202:     move.b  (A0,D2.W),D0
02:00032658 0C000003        	  7203:     cmpi.b  #$03,D0
02:0003265C 6624            	  7204:     bne  _L_z01_BeginShove_Exit2
                            	  7205:     even
