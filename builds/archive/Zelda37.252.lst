                            	 12768:     ; Check for a collision with Link.
                            	 12769:     ;
                            	 12770:     ; We can't call CheckLinkCollision, because we need to
                            	 12771:     ; customize Ganon's midpoint.
                            	 12772:     ;
                            	 12773:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12774:     ; detection, if Link is invincible. Initialize variables that will
                            	 12775:     ; be returned from the partial collision check routine. Then
                            	 12776:     ; call it.
                            	 12777:     ;
02:0003F592 102C04F0        	 12778:     move.b  ($04F0,A4),D0
02:0003F596 6616            	 12779:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003F598 19400006        	 12780:     move.b  D0,($0006,A4)
02:0003F59C 19400009        	 12781:     move.b  D0,($0009,A4)
02:0003F5A0 1940000C        	 12782:     move.b  D0,($000C,A4)
02:0003F5A4 7600            	 12783:     moveq   #0,D3
02:0003F5A6 1883            	 12784:     move.b  D3,($0000,A4)
02:0003F5A8 4EB900031EBE    	 12785:     jsr     CheckLinkCollisionPreinit
                            	 12786:     even
                            	 12787: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12788:     ; If Ganon is not in state 0, then he's brown.
                            	 12789:     ; Go check collision with an arrow.
                            	 12790:     ;
02:0003F5AE 41EC00AC        	 12791:     lea     ($00AC,A4),A0
02:0003F5B2 10302000        	 12792:     move.b  (A0,D2.W),D0
02:0003F5B6 6652            	 12793:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12794:     ; If timer <> 0, then Ganon is visible.
                            	 12795:     ; He can't be harmed like this. So, return.
                            	 12796:     ;
02:0003F5B8 10342028        	 12797:     move.b  ($28,A4,D2.W),D0
02:0003F5BC 664A            	 12798:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003F5BE 760D            	 12799:     moveq   #13,D3
02:0003F5C0 4EB900032388    	 12800:     jsr     CheckMonsterSwordCollision
                            	 12801:     ; If Ganon has died according to the usual collision check rules
                            	 12802:     ; (HP = 0), then:
                            	 12803:     ; 1. Restore HP to the initial value $F0
                            	 12804:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12805:     ; 3. Change palette row 7 to make Ganon brown
                            	 12806:     ;
02:0003F5C6 41EC0405        	 12807:     lea     ($0405,A4),A0
02:0003F5CA 10302000        	 12808:     move.b  (A0,D2.W),D0
02:0003F5CE 6718            	 12809:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003F5D0 103C00F0        	 12810:     move.b  #$F0,D0
02:0003F5D4 41EC0485        	 12811:     lea     ($0485,A4),A0
02:0003F5D8 11802000        	 12812:     move.b  D0,(A0,D2.W)
02:0003F5DC 41EC00AC        	 12813:     lea     ($00AC,A4),A0
02:0003F5E0 53302000        	 12814:     subq.b  #1,(A0,D2.W)
02:0003F5E4 61000084        	 12815:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12816:     even
                            	 12817: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12818:     ; If Ganon was harmed, then play the sound effect
                            	 12819:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12820:     ;
02:0003F5E8 41EC04F0        	 12821:     lea     ($04F0,A4),A0
02:0003F5EC 10302000        	 12822:     move.b  (A0,D2.W),D0
