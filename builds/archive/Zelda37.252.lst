02:0004D012 E308            	  7427:     lsl.b  #1,D0   ; ASL A
02:0004D014 E308            	  7428:     lsl.b  #1,D0   ; ASL A
02:0004D016 19802070        	  7429:     move.b  D0,($70,A4,D2.W)
                            	  7430:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7431:     ;
