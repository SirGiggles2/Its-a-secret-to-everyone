                            	  2487: InitTrap_Full:
                            	  2488:     ; Copy this parent/generator object's attributes to [01].
                            	  2489:     ;
02:00030578 41EC04BF        	  2490:     lea     ($04BF,A4),A0
02:0003057C 10302000        	  2491:     move.b  (A0,D2.W),D0
02:00030580 19400001        	  2492:     move.b  D0,($0001,A4)
                            	  2493:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2494:     ;
02:00030584 7605            	  2495:     moveq   #5,D3
                            	  2496:     ; The individual trap objects to make will be of type $49.
                            	  2497:     ; Store it in [00].
                            	  2498:     ;
02:00030586 7049            	  2499:     moveq   #73,D0
02:00030588 1880            	  2500:     move.b  D0,($0000,A4)
                            	  2501:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  2502:     ; then we'll make 4 traps.
                            	  2503:     ;
02:0003058A 41EC034F        	  2504:     lea     ($034F,A4),A0
02:0003058E 12302000        	  2505:     move.b  (A0,D2.W),D1
02:00030592 B001            	  2506:     cmp.b   D1,D0
02:00030594 6702            	  2507:     beq  _L_z01_InitTrap_Full_LoopTrap
02:00030596 7603            	  2508:     moveq   #3,D3
                            	  2509:     even
                            	  2510: _L_z01_InitTrap_Full_LoopTrap:
                            	  2511:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
                            	  2512:     ;
02:00030598 1003            	  2513:     move.b  D3,D0
02:0003059A 023C00EE        	  2514:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  2515:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  2516:     ;
02:0003059E 122C0340        	  2517:     move.b  ($0340,A4),D1
02:000305A2 D101            	  2518:     addx.b  D1,D0   ; ADC CurObjIndex
02:000305A4 7400            	  2519:     moveq   #0,D2
02:000305A6 1400            	  2520:     move.b  D0,D2
                            	  2521:     ; Look up and set the location for this iteration's individual trap.
                            	  2522:     ;
02:000305A8 41F90003056C    	  2523:     lea     (TrapXs).l,A0
02:000305AE 10303000        	  2524:     move.b  (A0,D3.W),D0
02:000305B2 19802070        	  2525:     move.b  D0,($70,A4,D2.W)
02:000305B6 41F900030572    	  2526:     lea     (TrapYs).l,A0
02:000305BC 10303000        	  2527:     move.b  (A0,D3.W),D0
02:000305C0 41EC0084        	  2528:     lea     ($0084,A4),A0
02:000305C4 11802000        	  2529:     move.b  D0,(A0,D2.W)
02:000305C8 619E            	  2530:     jsr     InitOneSimpleObject
02:000305CA 5302            	  2531:     subq.b  #1,D2
02:000305CC 5303            	  2532:     subq.b  #1,D3
02:000305CE 6AC8            	  2533:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:000305D0 4E75            	  2534:     rts
