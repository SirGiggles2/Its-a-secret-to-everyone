02:00031EE8 10302000        	  6001:     move.b  (A0,D2.W),D0
02:00031EEC 020000F0        	  6002:     andi.b #$F0,D0
02:00031EF0 0C000010        	  6003:     cmpi.b  #$10,D0
02:00031EF4 6704            	  6004:     beq.s  __far_z_01_0055
02:00031EF6 600000BC        	  6005:     jmp  L73A9_Exit
                            	  6006: __far_z_01_0055:
                            	  6007: _anon_z01_84:
                            	  6008:     ; Store Link's midpoint coordinates in [04] and [05].
