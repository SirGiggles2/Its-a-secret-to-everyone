02:00031F08 19400004        	  6014:     move.b  D0,($0004,A4)
02:00031F0C 102C0084        	  6015:     move.b  ($0084,A4),D0
02:00031F10 023C00EE        	  6016:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031F14 123C0008        	  6017:     move.b  #$08,D1
02:00031F18 D101            	  6018:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00031F1A 19400005        	  6019:     move.b  D0,($0005,A4)
                            	  6020:     ; If both objects are 9 pixels apart or more, then return no collision.
