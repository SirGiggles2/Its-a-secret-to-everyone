                            	  2910:     ;
02:0003AD36 41EC0412        	  2911:     lea     ($0412,A4),A0
02:0003AD3A 10302000        	  2912:     move.b  (A0,D2.W),D0
02:0003AD3E 123C0000        	  2913:     move.b  #$00,D1
