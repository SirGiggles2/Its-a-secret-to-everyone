                            	  6176:     ; If heart partial >= low damage points byte, then simply
                            	  6177:     ; subtract the damage byte from heart partial.
                            	  6178:     ; Else go borrow from full hearts.
                            	  6179:     ;
02:0003202A 102C0670        	  6180:     move.b  ($0670,A4),D0
