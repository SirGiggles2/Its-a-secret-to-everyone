02:0003CF14 020000FC        	  7624:     andi.b #$FC,D0
02:0003CF18 0C0000B0        	  7625:     cmpi.b  #$B0,D0
02:0003CF1C 6742            	  7626:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003CF1E 0C0000F4        	  7627:     cmpi.b  #$F4,D0
