02:0004C3D0 41F90004BFB8    	  5845:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:0004C3D6 10303000        	  5846:     move.b  (A0,D3.W),D0
02:0004C3DA 19400004        	  5847:     move.b  D0,($0004,A4)
                            	  5848:     ; TODO: ?
                            	  5849:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5850:     ; Else add the item value of the magic boomerang.
                            	  5851:     ;
                            	  5852:     ; But none of the values in the base sprite attributes array is 8.
                            	  5853:     ;
                            	  5854:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5855:     ; the inventory will always be added to the base sprite attribute.
                            	  5856:     ;
                            	  5857:     ; So, palette row 4 or 5 will be chosen.
                            	  5858:     ;
02:0004C3DE 7600            	  5859:     moveq   #0,D3
02:0004C3E0 0C000008        	  5860:     cmpi.b  #$08,D0
02:0004C3E4 6706            	  5861:     beq  _anon_z07_31
02:0004C3E6 7600            	  5862:     moveq   #0,D3
02:0004C3E8 162C0675        	  5863:     move.b  ($0675,A4),D3
