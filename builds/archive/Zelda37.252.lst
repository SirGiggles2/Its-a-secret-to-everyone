02:00041866 102C0010        	  2964:     move.b  ($0010,A4),D0
02:0004186A 6720            	  2965:     beq  _L_z05_MaskInputInBorder_Exit
02:0004186C 102C0001        	  2966:     move.b  ($0001,A4),D0
