                            	  4153:     ; So, we can check tiles for collision.
                            	  4154:     ;
                            	  4155:     ; Reset [0E] alternate direction search step.
                            	  4156:     ;
02:0004B878 1940000E        	  4157:     move.b  D0,($000E,A4)
                            	  4158:     ; If there's a movement direction, go check tile collision.
