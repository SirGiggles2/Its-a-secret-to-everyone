02:0003B13E 7020            	  3441:     moveq   #32,D0
02:0003B140 7600            	  3442:     moveq   #0,D3
02:0003B142 41EC034F        	  3443:     lea     ($034F,A4),A0
02:0003B146 16302000        	  3444:     move.b  (A0,D2.W),D3
02:0003B14A 0C030007        	  3445:     cmpi.b  #$07,D3
02:0003B14E 6708            	  3446:     beq  _L_z04_UpdateOctorock_Shoot
02:0003B150 0C030009        	  3447:     cmpi.b  #$09,D3
02:0003B154 6702            	  3448:     beq  _L_z04_UpdateOctorock_Shoot
02:0003B156 E308            	  3449:     lsl.b  #1,D0   ; ASL A
                            	  3450:     even
                            	  3451: _L_z04_UpdateOctorock_Shoot:
                            	  3452:     ; Shoot a flying rock (object type $53).
                            	  3453:     ;
02:0003B158 7653            	  3454:     moveq   #83,D3
02:0003B15A 6100F706        	  3455:     jsr     _TryShooting
02:0003B15E 4EB90004CB14    	  3456:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3457:     ; If facing down, then use frame image offset 2.
                            	  3458:     ;
02:0003B164 41EC0098        	  3459:     lea     ($0098,A4),A0
02:0003B168 10302000        	  3460:     move.b  (A0,D2.W),D0
02:0003B16C 7600            	  3461:     moveq   #0,D3
02:0003B16E 1600            	  3462:     move.b  D0,D3
02:0003B170 0200000C        	  3463:     andi.b #$0C,D0
02:0003B174 670C            	  3464:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:0003B176 7002            	  3465:     moveq   #2,D0
02:0003B178 0C030008        	  3466:     cmpi.b  #$08,D3
02:0003B17C 6610            	  3467:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  3468:     ; Else facing up. Use frame image offset 1.
                            	  3469:     ;
02:0003B17E 7001            	  3470:     moveq   #1,D0
