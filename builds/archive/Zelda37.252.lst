02:0003D088 7600            	  7790:     moveq   #0,D3
02:0003D08A 1600            	  7791:     move.b  D0,D3
02:0003D08C 41F90003CE9C    	  7792:     lea     (PolsVoiceDirections).l,A0
02:0003D092 10303000        	  7793:     move.b  (A0,D3.W),D0
02:0003D096 41EC0098        	  7794:     lea     ($0098,A4),A0
02:0003D09A 11802000        	  7795:     move.b  D0,(A0,D2.W)
                            	  7796:     ; Randomly set distance-to-move to $30 or $70.
