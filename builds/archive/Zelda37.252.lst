                            	  7818:     ; If in the bottom half, align with the next square.
                            	  7819:     ;
02:0003D0CA 41EC0084        	  7820:     lea     ($0084,A4),A0
02:0003D0CE 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003D0D2 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D0D6 123C0008        	  7823:     move.b  #$08,D1
02:0003D0DA D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003D0DC 020000F0        	  7825:     andi.b #$F0,D0
                            	  7826:     ; Make sure the lower nibble of Y is $D as usual.
