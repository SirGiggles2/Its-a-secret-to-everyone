02:0004C2B8 0C000070        	  5721:     cmpi.b  #$70,D0
02:0004C2BC 6502            	  5722:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004C2BE 7670            	  5723:     moveq   #112,D3
                            	  5724:     even
