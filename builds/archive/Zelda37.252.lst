02:00031184 16342028        	  4348:     move.b  ($28,A4,D2.W),D3
                            	  4349:     ; At times $16 and $11, rotate carry=1 to the low bit.
                            	  4350:     ; Carry will have been set, because of the comparison (CPY).
                            	  4351:     ;
