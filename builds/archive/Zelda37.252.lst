02:0003AB18 41F90003AA30    	  2638:     lea     (JumperYOffsets).l,A0
02:0003AB1E 12303000        	  2639:     move.b  (A0,D3.W),D1
02:0003AB22 D101            	  2640:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:0003AB24 41EC0444        	  2641:     lea     ($0444,A4),A0
02:0003AB28 11802000        	  2642:     move.b  D0,(A0,D2.W)
                            	  2643:     ; Set the starting speed, depending on the object type.
                            	  2644:     ;
