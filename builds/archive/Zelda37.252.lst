02:00036774 02000007        	  4874:     andi.b #$07,D0
02:00036778 0C000004        	  4875:     cmpi.b  #$04,D0
02:0003677C 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
