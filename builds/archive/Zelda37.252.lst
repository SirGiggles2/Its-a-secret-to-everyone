02:0003D074 11802000        	  7783:     move.b  D0,(A0,D2.W)
02:0003D078 41EC0412        	  7784:     lea     ($0412,A4),A0
02:0003D07C 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     ; Choose a random direction to face in.
                            	  7787:     ;
