02:0003C60C 41EC0084        	  6331:     lea     ($0084,A4),A0
02:0003C610 10302000        	  6332:     move.b  (A0,D2.W),D0
02:0003C614 122C0003        	  6333:     move.b  ($0003,A4),D1
