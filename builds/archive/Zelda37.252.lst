                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:0004366C 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00043670 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00043674 1014            	  5783:     move.b  ($0000,A4),D0
02:00043676 41EC0302        	  5784:     lea     ($0302,A4),A0
02:0004367A 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:0004367E 5202            	  5786:     addq.b  #1,D2
02:00043680 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00043684 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00043688 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:0004368C 5202            	  5790:     addq.b  #1,D2
02:0004368E 102C0006        	  5791:     move.b  ($0006,A4),D0
02:00043692 41EC0302        	  5792:     lea     ($0302,A4),A0
02:00043696 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:0004369A 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:0004369C 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:000436A0 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:000436A2 7020            	  5803:     moveq   #32,D0
02:000436A4 122C0001        	  5804:     move.b  ($0001,A4),D1
02:000436A8 8001            	  5805:     or.b  D1,D0
02:000436AA 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:000436AE 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:000436B2 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:000436B4 103C00FF        	  5815:     move.b  #$FF,D0
02:000436B8 41EC0302        	  5816:     lea     ($0302,A4),A0
02:000436BC 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:000436C0 1002            	  5818:     move.b  D2,D0
02:000436C2 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:000436C6 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:000436CA 102C0054        	  5829:     move.b  ($0054,A4),D0
02:000436CE 02000003        	  5830:     andi.b #$03,D0
02:000436D2 6708            	  5831:     beq  _anon_z05_122
02:000436D4 7008            	  5832:     moveq   #8,D0
02:000436D6 19400027        	  5833:     move.b  D0,($0027,A4)
02:000436DA 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:000436DC 102C0054        	  5844:     move.b  ($0054,A4),D0
02:000436E0 0C000004        	  5845:     cmpi.b  #$04,D0
02:000436E4 6626            	  5846:     bne  _anon_z05_123
02:000436E6 7400            	  5847:     moveq   #0,D2
02:000436E8 142C0009        	  5848:     move.b  ($0009,A4),D2
02:000436EC 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:000436F0 102C0055        	  5850:     move.b  ($0055,A4),D0
02:000436F4 0A00000F        	  5851:     eori.b #$0F,D0
02:000436F8 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:000436FC C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:000436FE 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:00043702 7000            	  5859:     moveq   #0,D0
02:00043704 19400054        	  5860:     move.b  D0,($0054,A4)
02:00043708 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:0004370C 102C0055        	  5870:     move.b  ($0055,A4),D0
02:00043710 19400002        	  5871:     move.b  D0,($0002,A4)
02:00043714 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:00043718 0C000007        	  5873:     cmpi.b  #$07,D0
02:0004371C 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:0004371E 7400            	  5879:     moveq   #0,D2
02:00043720 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00043724 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00043728 1003            	  5884:     move.b  D3,D0
02:0004372A 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004372E 41F9000435EA    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00043734 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00043738 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:0004373A 7600            	  5889:     moveq   #0,D3
02:0004373C 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:0004373E 1002            	  5893:     move.b  D2,D0
02:00043740 0A000001        	  5894:     eori.b #$01,D0
02:00043744 7400            	  5895:     moveq   #0,D2
02:00043746 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
