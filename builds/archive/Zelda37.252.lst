                            	  2541: UpdateTrap_Full:
02:000305D8 41EC00AC        	  2542:     lea     ($00AC,A4),A0
02:000305DC 10302000        	  2543:     move.b  (A0,D2.W),D0
02:000305E0 660000B2        	  2544:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2545:     ; State 0. Sensing.
                            	  2546:     ;
                            	  2547:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2548:     ; then go see if the horizontal distance is shorter.
                            	  2549:     ;
02:000305E4 102C0084        	  2550:     move.b  ($0084,A4),D0
02:000305E8 003C0011        	  2551:     ori     #$11,CCR  ; SEC: set C+X
02:000305EC 41EC0084        	  2552:     lea     ($0084,A4),A0
02:000305F0 12302000        	  2553:     move.b  (A0,D2.W),D1
02:000305F4 0A3C0010        	  2554:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000305F8 9101            	  2555:     subx.b  D1,D0   ; SBC ObjY,X
02:000305FA 0A3C0010        	  2556:     eori    #$10,CCR  ; restore X = 6502 C
02:000305FE 6100086E        	  2557:     jsr     Abs
02:00030602 0C00000E        	  2558:     cmpi.b  #$0E,D0
02:00030606 644C            	  2559:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2560:     ; Determine the horizontal direction toward Link;
                            	  2561:     ; and if Link and the trap are at the same X, then we can't move
                            	  2562:     ; along this axis. Go see about moving vertically.
                            	  2563:     ;
02:00030608 7601            	  2564:     moveq   #1,D3
02:0003060A 102C0070        	  2565:     move.b  ($0070,A4),D0
02:0003060E 12342070        	  2566:     move.b  ($70,A4,D2.W),D1
02:00030612 B001            	  2567:     cmp.b   D1,D0
02:00030614 673E            	  2568:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030616 6402            	  2569:     bcc  _anon_z01_26
02:00030618 7602            	  2570:     moveq   #2,D3
                            	  2571: _anon_z01_26:
                            	  2572:     ; Remember the original X coordinate.
                            	  2573:     ;
02:0003061A 10342070        	  2574:     move.b  ($70,A4,D2.W),D0
                            	  2575:     even
                            	  2576: _L_z01_UpdateTrap_Full_GoToState1:
02:0003061E 41EC0380        	  2577:     lea     ($0380,A4),A0
02:00030622 11802000        	  2578:     move.b  D0,(A0,D2.W)
                            	  2579:     ; Set facing direction to the horizontal one that we determined.
                            	  2580:     ;
02:00030626 1003            	  2581:     move.b  D3,D0
02:00030628 41EC0098        	  2582:     lea     ($0098,A4),A0
02:0003062C 11802000        	  2583:     move.b  D0,(A0,D2.W)
                            	  2584:     ; If the direction we determined is not allowed for this trap, then
                            	  2585:     ; go draw and check collisions.
                            	  2586:     ;
02:00030630 41F9000305D1    	  2587:     lea     (TrapAllowedDirs-1).l,A0
02:00030636 12302000        	  2588:     move.b  (A0,D2.W),D1
02:0003063A C001            	  2589:     and.b  D1,D0
02:0003063C 6712            	  2590:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  2591:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  2592:     ;
02:0003063E 41EC00AC        	  2593:     lea     ($00AC,A4),A0
02:00030642 52302000        	  2594:     addq.b  #1,(A0,D2.W)
02:00030646 7070            	  2595:     moveq   #112,D0
02:00030648 41EC03BC        	  2596:     lea     ($03BC,A4),A0
02:0003064C 11802000        	  2597:     move.b  D0,(A0,D2.W)
                            	  2598:     even
                            	  2599: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
02:00030650 60000102        	  2600:     jmp     L_Trap_DrawAndCheckCollisions
