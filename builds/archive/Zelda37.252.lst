02:0004BCE8 61000E2A        	  4853:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4854:     ; If the direction is horizontal, move the sprites down 3 pixels.
                            	  4855:     ;
02:0004BCEC 41EC0098        	  4856:     lea     ($0098,A4),A0
02:0004BCF0 10302000        	  4857:     move.b  (A0,D2.W),D0
02:0004BCF4 1B00            	  4858:     move.b  D0,-(A5)  ; PHA
02:0004BCF6 02000003        	  4859:     andi.b #$03,D0
02:0004BCFA 6712            	  4860:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004BCFC 102C0001        	  4861:     move.b  ($0001,A4),D0
02:0004BD00 023C00EE        	  4862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BD04 123C0003        	  4863:     move.b  #$03,D1
02:0004BD08 D101            	  4864:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004BD0A 19400001        	  4865:     move.b  D0,($0001,A4)
                            	  4866:     even
                            	  4867: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:0004BD0E 101D            	  4868:     move.b  (A5)+,D0  ; PLA
                            	  4869:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4870:     ; This makes the shot flash by cycling all the palettes, one each frame.
                            	  4871:     ;
                            	  4872:     ;
                            	  4873:     ; Call this only to get reverse direction index.
02:0004BD10 4EB900030E6A    	  4874:     jsr     GetOppositeDir
02:0004BD16 102C0015        	  4875:     move.b  ($0015,A4),D0
02:0004BD1A 02000003        	  4876:     andi.b #$03,D0
02:0004BD1E 41F90004BFDA    	  4877:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004BD24 12303000        	  4878:     move.b  (A0,D3.W),D1
02:0004BD28 8001            	  4879:     or.b  D1,D0
02:0004BD2A 4EB900031CB4    	  4880:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4881:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4882:     ;
02:0004BD30 41F90004BFD6    	  4883:     lea     (RDirectionToWeaponFrame).l,A0
02:0004BD36 10303000        	  4884:     move.b  (A0,D3.W),D0
02:0004BD3A 1940000C        	  4885:     move.b  D0,($000C,A4)
                            	  4886:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4887:     ;
02:0004BD3E 0C030002        	  4888:     cmpi.b  #$02,D3
02:0004BD42 6604            	  4889:     bne  _anon_z07_24
02:0004BD44 522C000F        	  4890:     addq.b  #1,($000F,A4)
                            	  4891: _anon_z07_24:
                            	  4892:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4893:     ;   $57 (sword shot) => $22
                            	  4894:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4895:     ;
02:0004BD48 7622            	  4896:     moveq   #34,D3
02:0004BD4A 0C02000D        	  4897:     cmpi.b  #$0D,D2
02:0004BD4E 6410            	  4898:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004BD50 41EC034F        	  4899:     lea     ($034F,A4),A0
02:0004BD54 10302000        	  4900:     move.b  (A0,D2.W),D0
02:0004BD58 0C000057        	  4901:     cmpi.b  #$57,D0
02:0004BD5C 6710            	  4902:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004BD5E 660C            	  4903:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4904:     even
                            	  4905: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4906:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4907:     ;   high bit set (magic)   => $23
                            	  4908:     ;   high bit clear (sword) => $22
                            	  4909:     ;
02:0004BD60 41EC00AC        	  4910:     lea     ($00AC,A4),A0
02:0004BD64 10302000        	  4911:     move.b  (A0,D2.W),D0
02:0004BD68 E308            	  4912:     lsl.b  #1,D0   ; ASL A
02:0004BD6A 6402            	  4913:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4914:     even
                            	  4915: _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites:
02:0004BD6C 7623            	  4916:     moveq   #35,D3
                            	  4917:     even
                            	  4918: _L_z07_DrawSwordShotOrMagicShot_WriteSprites:
02:0004BD6E 4EF900031BD4    	  4919:     jmp     Anim_WriteItemSprites
                            	  4920: 
                            	  4921: ; Params:
                            	  4922: ; X: shot object index
                            	  4923: ;
                            	  4924: ; If the object is a sword shot, go spread out the shot.
                            	  4925: ;
                            	  4926:     even
                            	  4927: HandleShotBlocked:
02:0004BD74 41EC00AC        	  4928:     lea     ($00AC,A4),A0
02:0004BD78 10302000        	  4929:     move.b  (A0,D2.W),D0
02:0004BD7C E308            	  4930:     lsl.b  #1,D0   ; ASL A
02:0004BD7E 6504            	  4931:     bcs.s  __far_z_07_0074
02:0004BD80 60000082        	  4932:     jmp  SetShotSpreadingState
                            	  4933: __far_z_07_0074:
                            	  4934:     ; This is a magic shot.
                            	  4935:     ;
                            	  4936:     ; If missing the magic book, go deactivate the shot object.
                            	  4937:     ;
02:0004BD84 102C0661        	  4938:     move.b  ($0661,A4),D0
02:0004BD88 6602            	  4939:     bne.s  __far_z_07_0075
02:0004BD8A 6072            	  4940:     jmp  DeactivateShot
                            	  4941: __far_z_07_0075:
                            	  4942:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4943:     ; unused, so it only has to depend on having an empty slot.
                            	  4944:     ;
                            	  4945:     ; If successful, Link's state will have been changed to "using item".
                            	  4946:     ; But we don't want that in this case.
                            	  4947:     ;
                            	  4948:     ; For both these reasons, save state and restore it afterward.
                            	  4949:     ;
02:0004BD8C 102C00AC        	  4950:     move.b  ($00AC,A4),D0
02:0004BD90 1B00            	  4951:     move.b  D0,-(A5)  ; PHA
02:0004BD92 102C0513        	  4952:     move.b  ($0513,A4),D0
02:0004BD96 1B00            	  4953:     move.b  D0,-(A5)  ; PHA
02:0004BD98 7000            	  4954:     moveq   #0,D0
02:0004BD9A 19400513        	  4955:     move.b  D0,($0513,A4)
02:0004BD9E 4EB9000310B4    	  4956:     jsr     WieldCandle
02:0004BDA4 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:0004BDA6 19400513        	  4958:     move.b  D0,($0513,A4)
02:0004BDAA 101D            	  4959:     move.b  (A5)+,D0  ; PLA
02:0004BDAC 194000AC        	  4960:     move.b  D0,($00AC,A4)
                            	  4961:     ; State $21 means that a moving fire was just made.
                            	  4962:     ;
                            	  4963:     ; If it's any another value, then we didn't find an empty slot
                            	  4964:     ; to make a fire. In this case, all that's left to do is to go
                            	  4965:     ; deactivate the shot object.
                            	  4966:     ;
02:0004BDB0 41EC00AC        	  4967:     lea     ($00AC,A4),A0
02:0004BDB4 10302000        	  4968:     move.b  (A0,D2.W),D0
02:0004BDB8 0C000021        	  4969:     cmpi.b  #$21,D0
02:0004BDBC 6702            	  4970:     beq.s  __far_z_07_0076
02:0004BDBE 6038            	  4971:     jmp  DeactivateLinkShot
                            	  4972: __far_z_07_0076:
                            	  4973:     ; Make state $22 for a standing fire.
                            	  4974:     ;
02:0004BDC0 41EC00AC        	  4975:     lea     ($00AC,A4),A0
02:0004BDC4 52302000        	  4976:     addq.b  #1,(A0,D2.W)
                            	  4977:     ; Copy the shot's position and direction to the fire.
                            	  4978:     ;
02:0004BDC8 760E            	  4979:     moveq   #14,D3
02:0004BDCA 10343070        	  4980:     move.b  ($70,A4,D3.W),D0
02:0004BDCE 19802070        	  4981:     move.b  D0,($70,A4,D2.W)
02:0004BDD2 41EC0084        	  4982:     lea     ($0084,A4),A0
02:0004BDD6 10303000        	  4983:     move.b  (A0,D3.W),D0
02:0004BDDA 41EC0084        	  4984:     lea     ($0084,A4),A0
02:0004BDDE 11802000        	  4985:     move.b  D0,(A0,D2.W)
02:0004BDE2 41EC0098        	  4986:     lea     ($0098,A4),A0
02:0004BDE6 10303000        	  4987:     move.b  (A0,D3.W),D0
02:0004BDEA 41EC0098        	  4988:     lea     ($0098,A4),A0
02:0004BDEE 11802000        	  4989:     move.b  D0,(A0,D2.W)
                            	  4990:     ; The fire lasts $4F frames.
                            	  4991:     ; Deactivate the shot.
                            	  4992:     ;
02:0004BDF2 704F            	  4993:     moveq   #79,D0
02:0004BDF4 19802028        	  4994:     move.b  D0,($28,A4,D2.W)
                            	  4995:     even
                            	  4996: DeactivateLinkShot:
02:0004BDF8 4EF90002BC8E    	  4997:     jmp     c_deactivate_link_shot
                            	  4998: 
                            	  4999: DeactivateShot:
02:0004BDFE 4EF90002BC7E    	  5000:     jmp     c_deactivate_shot
                            	  5001: 
                            	  5002: SetShotSpreadingState:
02:0004BE04 4EF90002B8B6    	  5003:     jmp     c_set_shot_spreading_state
                            	  5004: 
                            	  5005: SpreadShot:
                            	  5006:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5007:     ;
                            	  5008:     ; The shot is spreading out.
                            	  5009:     ;
                            	  5010:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5011:     ; These will be negated appropriately for each corner.
                            	  5012:     ;
02:0004BE0A 41EC0098        	  5013:     lea     ($0098,A4),A0
02:0004BE0E 10302000        	  5014:     move.b  (A0,D2.W),D0
02:0004BE12 19400002        	  5015:     move.b  D0,($0002,A4)
02:0004BE16 19400003        	  5016:     move.b  D0,($0003,A4)
                            	  5017:     ; Reset [0F] to not flip horizontally.
                            	  5018:     ;
02:0004BE1A 7000            	  5019:     moveq   #0,D0
02:0004BE1C 1940000F        	  5020:     move.b  D0,($000F,A4)
                            	  5021:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5022:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5023:     ;
02:0004BE20 7603            	  5024:     moveq   #3,D3
                            	  5025:     even
                            	  5026: _L_z07_SpreadShot_DrawShotCorner:
02:0004BE22 1003            	  5027:     move.b  D3,D0
02:0004BE24 1B00            	  5028:     move.b  D0,-(A5)  ; PHA
                            	  5029:     ; Save offset X [02] and Y offset [03].
                            	  5030:     ;
02:0004BE26 102C0002        	  5031:     move.b  ($0002,A4),D0
02:0004BE2A 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
02:0004BE2C 102C0003        	  5033:     move.b  ($0003,A4),D0
02:0004BE30 1B00            	  5034:     move.b  D0,-(A5)  ; PHA
                            	  5035:     ; Calculate and set sprite attributes for this corner:
                            	  5036:     ;   base attribute OR (frame counter AND 3)
                            	  5037:     ;
                            	  5038:     ; The base attribute defines how to flip the sprite.
                            	  5039:     ; The frame counter makes the shot flash by cycling each
                            	  5040:     ; palette row.
                            	  5041:     ;
02:0004BE32 102C0015        	  5042:     move.b  ($0015,A4),D0
02:0004BE36 02000003        	  5043:     andi.b #$03,D0
02:0004BE3A 41F90004BC98    	  5044:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004BE40 12303000        	  5045:     move.b  (A0,D3.W),D1
02:0004BE44 8001            	  5046:     or.b  D1,D0
02:0004BE46 4EB900031CB4    	  5047:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5048:     ; Add the object's X (the center of the spread) and the
                            	  5049:     ; current offset in [02] to set sprite X in [00].
                            	  5050:     ;
02:0004BE4C 10342070        	  5051:     move.b  ($70,A4,D2.W),D0
02:0004BE50 023C00EE        	  5052:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BE54 122C0002        	  5053:     move.b  ($0002,A4),D1
02:0004BE58 D101            	  5054:     addx.b  D1,D0   ; ADC $02
02:0004BE5A 1880            	  5055:     move.b  D0,($0000,A4)
                            	  5056:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5057:     ; Else calculate the distance from object X to sprite X.
                            	  5058:     ;
02:0004BE5C 12342070        	  5059:     move.b  ($70,A4,D2.W),D1
02:0004BE60 B001            	  5060:     cmp.b   D1,D0
02:0004BE62 651A            	  5061:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004BE64 0C0000FC        	  5062:     cmpi.b  #$FC,D0
02:0004BE68 6466            	  5063:     bcc  _L_z07_SpreadShot_NextCorner
02:0004BE6A 003C0011        	  5064:     ori     #$11,CCR  ; SEC: set C+X
02:0004BE6E 12342070        	  5065:     move.b  ($70,A4,D2.W),D1
02:0004BE72 0A3C0010        	  5066:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BE76 9101            	  5067:     subx.b  D1,D0   ; SBC ObjX,X
02:0004BE78 0A3C0010        	  5068:     eori    #$10,CCR  ; restore X = 6502 C
02:0004BE7C 6014            	  5069:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5070: 
                            	  5071:     even
                            	  5072: _L_z07_SpreadShot_ReverseSub:
02:0004BE7E 10342070        	  5073:     move.b  ($70,A4,D2.W),D0
02:0004BE82 003C0011        	  5074:     ori     #$11,CCR  ; SEC: set C+X
02:0004BE86 1214            	  5075:     move.b  ($0000,A4),D1
02:0004BE88 0A3C0010        	  5076:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004BE8C 9101            	  5077:     subx.b  D1,D0   ; SBC $00
02:0004BE8E 0A3C0010        	  5078:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5079:     even
                            	  5080: _L_z07_SpreadShot_CheckDistance:
                            	  5081:     ; If distance >= $20, skip this corner.
                            	  5082:     ;
02:0004BE92 0C000020        	  5083:     cmpi.b  #$20,D0
02:0004BE96 6438            	  5084:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5085:     ; Add the object's Y (the center of the spread) and the
                            	  5086:     ; current offset in [03] to set sprite Y in [01].
                            	  5087:     ;
02:0004BE98 41EC0084        	  5088:     lea     ($0084,A4),A0
02:0004BE9C 10302000        	  5089:     move.b  (A0,D2.W),D0
02:0004BEA0 023C00EE        	  5090:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BEA4 122C0003        	  5091:     move.b  ($0003,A4),D1
02:0004BEA8 D101            	  5092:     addx.b  D1,D0   ; ADC $03
02:0004BEAA 19400001        	  5093:     move.b  D0,($0001,A4)
                            	  5094:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5095:     ;
02:0004BEAE 7600            	  5096:     moveq   #0,D3
02:0004BEB0 162C0010        	  5097:     move.b  ($0010,A4),D3
02:0004BEB4 670C            	  5098:     beq  _L_z07_SpreadShot_Draw
02:0004BEB6 0C00003E        	  5099:     cmpi.b  #$3E,D0
02:0004BEBA 6514            	  5100:     bcs  _L_z07_SpreadShot_NextCorner
02:0004BEBC 0C0000E8        	  5101:     cmpi.b  #$E8,D0
02:0004BEC0 640E            	  5102:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5103:     even
                            	  5104: _L_z07_SpreadShot_Draw:
                            	  5105:     ; Draw the corner.
                            	  5106:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5107:     ;
02:0004BEC2 7002            	  5108:     moveq   #2,D0
02:0004BEC4 1940000C        	  5109:     move.b  D0,($000C,A4)
02:0004BEC8 7623            	  5110:     moveq   #35,D3
02:0004BECA 4EB900031BD4    	  5111:     jsr     Anim_WriteItemSprites
                            	  5112:     even
                            	  5113: _L_z07_SpreadShot_NextCorner:
                            	  5114:     ; Prepare to process the next corner.
                            	  5115:     ;
                            	  5116:     ; First, restore X offset [02] and Y offset [03].
                            	  5117:     ;
02:0004BED0 101D            	  5118:     move.b  (A5)+,D0  ; PLA
02:0004BED2 19400003        	  5119:     move.b  D0,($0003,A4)
02:0004BED6 101D            	  5120:     move.b  (A5)+,D0  ; PLA
02:0004BED8 19400002        	  5121:     move.b  D0,($0002,A4)
                            	  5122:     ; Take turns negating X offset or Y offset for the next round.
                            	  5123:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5124:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5125:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5126:     ; - Fourth turn: doesn't matter
                            	  5127:     ;
                            	  5128:     ;
                            	  5129:     ; Get the loop index.
02:0004BEDC 101D            	  5130:     move.b  (A5)+,D0  ; PLA
02:0004BEDE 1B00            	  5131:     move.b  D0,-(A5)  ; PHA
02:0004BEE0 7600            	  5132:     moveq   #0,D3
02:0004BEE2 1600            	  5133:     move.b  D0,D3
02:0004BEE4 0C030001        	  5134:     cmpi.b  #$01,D3
02:0004BEE8 6602            	  5135:     bne  _anon_z07_25
02:0004BEEA 7603            	  5136:     moveq   #3,D3
                            	  5137: _anon_z07_25:
02:0004BEEC 10343000        	  5138:     move.b  ($00,A4,D3.W),D0
02:0004BEF0 4600            	  5139:     eori.b #$FF,D0
02:0004BEF2 023C00EE        	  5140:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004BEF6 123C0001        	  5141:     move.b  #$01,D1
