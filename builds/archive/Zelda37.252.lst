02:00033836 E14C            	   528:     lsl.w   #8,D4
02:00033838 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003383A 48C4            	   530:     ext.l   D4
02:0003383C D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00033842 2044            	   532:     movea.l D4,A0
02:00033844 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00033848 41EC0633        	   534:     lea     ($0633,A4),A0
02:0003384C 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00033850 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:00033852 1003            	   537:     move.b  D3,D0
02:00033854 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:00033856 19430016        	   539:     move.b  D3,($0016,A4)
02:0003385A 6100D204        	   540:     jsr     FetchFileAAddressSet
02:0003385E 61001C3C        	   541:     jsr     FormatFileA
02:00033862 7000            	   542:     moveq   #0,D0
