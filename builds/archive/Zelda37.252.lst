02:0003A780 E308            	  2060:     lsl.b  #1,D0   ; ASL A
02:0003A782 E308            	  2061:     lsl.b  #1,D0   ; ASL A
02:0003A784 E308            	  2062:     lsl.b  #1,D0   ; ASL A
