02:0004C8BA 6604            	  6536:     bne.s  __far_z_07_0109
02:0004C8BC 600000B0        	  6537:     jmp  DrawBomb
                            	  6538: __far_z_07_0109:
                            	  6539:     ; Bombs don't blast walls in cellars (mode 9). Go draw.
                            	  6540:     ;
02:0004C8C0 102C0012        	  6541:     move.b  ($0012,A4),D0
02:0004C8C4 0C000009        	  6542:     cmpi.b  #$09,D0
02:0004C8C8 6604            	  6543:     bne.s  __far_z_07_0110
02:0004C8CA 600000A2        	  6544:     jmp  DrawBomb
                            	  6545: __far_z_07_0110:
                            	  6546:     ; We're in UW. See if the bomb is near a bombable wall.
                            	  6547:     ;
02:0004C8CE 7604            	  6548:     moveq   #4,D3
                            	  6549:     even
                            	  6550: _L_z07_Bomb_CheckState4_LoopHotspot:
