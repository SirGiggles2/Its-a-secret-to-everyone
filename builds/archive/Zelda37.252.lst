                            	  9513: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9514:     ; To the frame accumulator, add:
                            	  9515:     ; - a random value between 0 and 3
                            	  9516:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9517:     ;
02:0003DD7C 10342019        	  9518:     move.b  ($19,A4,D2.W),D0
02:0003DD80 02000003        	  9519:     andi.b #$03,D0
02:0003DD84 023C00EE        	  9520:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DD88 122C0003        	  9521:     move.b  ($0003,A4),D1
02:0003DD8C D101            	  9522:     addx.b  D1,D0   ; ADC $03
02:0003DD8E 41EC0451        	  9523:     lea     ($0451,A4),A0
02:0003DD92 12302000        	  9524:     move.b  (A0,D2.W),D1
02:0003DD96 D101            	  9525:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
