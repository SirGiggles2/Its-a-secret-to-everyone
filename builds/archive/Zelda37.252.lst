                            	  6923: AnimateLinkObjState:
                            	  6924:     ; If major state = $10
                            	  6925:     ;   if minor state = 0, make it 1
                            	  6926:     ;   else OR state with $30
                            	  6927:     ;   go set movement frame to 1
                            	  6928:     ;
02:0004CB20 102C00AC        	  6929:     move.b  ($00AC,A4),D0
02:0004CB24 02000030        	  6930:     andi.b #$30,D0
02:0004CB28 0C000010        	  6931:     cmpi.b  #$10,D0
02:0004CB2C 660C            	  6932:     bne  _L_z07_AnimateLinkObjState_CheckState20
02:0004CB2E 102C00AC        	  6933:     move.b  ($00AC,A4),D0
02:0004CB32 0200000F        	  6934:     andi.b #$0F,D0
02:0004CB36 6618            	  6935:     bne  _L_z07_AnimateLinkObjState_CombineStateWith30
