02:0004AB76 19400005        	  2353:     move.b  D0,($0005,A4)
02:0004AB7A 1002            	  2354:     move.b  D2,D0
02:0004AB7C 1B00            	  2355:     move.b  D0,-(A5)  ; PHA
02:0004AB7E 10342070        	  2356:     move.b  ($70,A4,D2.W),D0
02:0004AB82 19400003        	  2357:     move.b  D0,($0003,A4)
02:0004AB86 41EC0084        	  2358:     lea     ($0084,A4),A0
02:0004AB8A 10302000        	  2359:     move.b  (A0,D2.W),D0
02:0004AB8E 19400002        	  2360:     move.b  D0,($0002,A4)
02:0004AB92 4EB900031764    	  2361:     jsr     MapScreenPosToPpuAddr
02:0004AB98 7400            	  2362:     moveq   #0,D2
02:0004AB9A 142C0301        	  2363:     move.b  ($0301,A4),D2
                            	  2364:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2365:     ;
                            	  2366:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2367:     ; In total, 11 bytes will be written.
                            	  2368:     ;
                            	  2369:     ; First, write the high byte of PPU address in each record.
                            	  2370:     ;
02:0004AB9E 1014            	  2371:     move.b  ($0000,A4),D0
02:0004ABA0 41EC0302        	  2372:     lea     ($0302,A4),A0
02:0004ABA4 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0004ABA8 41EC0307        	  2374:     lea     ($0307,A4),A0
02:0004ABAC 11802000        	  2375:     move.b  D0,(A0,D2.W)
                            	  2376:     ; Write the low address in the first record. In the second record,
                            	  2377:     ; write (low address + 1).
                            	  2378:     ;
02:0004ABB0 102C0001        	  2379:     move.b  ($0001,A4),D0
02:0004ABB4 41EC0303        	  2380:     lea     ($0303,A4),A0
02:0004ABB8 11802000        	  2381:     move.b  D0,(A0,D2.W)
02:0004ABBC 41EC0308        	  2382:     lea     ($0308,A4),A0
02:0004ABC0 11802000        	  2383:     move.b  D0,(A0,D2.W)
02:0004ABC4 41EC0308        	  2384:     lea     ($0308,A4),A0
02:0004ABC8 52302000        	  2385:     addq.b  #1,(A0,D2.W)
                            	  2386:     ; Write the first tile twice in each record. Patch them later.
                            	  2387:     ;
02:0004ABCC 102C0005        	  2388:     move.b  ($0005,A4),D0
02:0004ABD0 41EC0305        	  2389:     lea     ($0305,A4),A0
02:0004ABD4 11802000        	  2390:     move.b  D0,(A0,D2.W)
02:0004ABD8 41EC0306        	  2391:     lea     ($0306,A4),A0
02:0004ABDC 11802000        	  2392:     move.b  D0,(A0,D2.W)
02:0004ABE0 41EC030A        	  2393:     lea     ($030A,A4),A0
02:0004ABE4 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:0004ABE8 41EC030B        	  2395:     lea     ($030B,A4),A0
02:0004ABEC 11802000        	  2396:     move.b  D0,(A0,D2.W)
                            	  2397:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2398:     ; Add 1 more to the second byte in each record.
                            	  2399:     ; Here is an example result of this manipulation:
                            	  2400:     ;   record 1: $70, $71
                            	  2401:     ;   record 2: $72, $73
                            	  2402:     ;
02:0004ABF0 0C000046        	  2403:     cmpi.b  #$46,D0
02:0004ABF4 6530            	  2404:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004ABF6 0C0000F3        	  2405:     cmpi.b  #$F3,D0
02:0004ABFA 642A            	  2406:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:0004ABFC 023C00EE        	  2407:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AC00 123C0002        	  2408:     move.b  #$02,D1
02:0004AC04 D101            	  2409:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004AC06 41EC030A        	  2410:     lea     ($030A,A4),A0
02:0004AC0A 11802000        	  2411:     move.b  D0,(A0,D2.W)
02:0004AC0E 41EC030B        	  2412:     lea     ($030B,A4),A0
02:0004AC12 11802000        	  2413:     move.b  D0,(A0,D2.W)
02:0004AC16 41EC0306        	  2414:     lea     ($0306,A4),A0
02:0004AC1A 52302000        	  2415:     addq.b  #1,(A0,D2.W)
02:0004AC1E 41EC030B        	  2416:     lea     ($030B,A4),A0
02:0004AC22 52302000        	  2417:     addq.b  #1,(A0,D2.W)
                            	  2418:     even
                            	  2419: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2420:     ; Set the count byte in each record to $82:
                            	  2421:     ; 2 tiles arranged vertically
                            	  2422:     ;
02:0004AC26 103C0082        	  2423:     move.b  #$82,D0
02:0004AC2A 41EC0304        	  2424:     lea     ($0304,A4),A0
02:0004AC2E 11802000        	  2425:     move.b  D0,(A0,D2.W)
02:0004AC32 41EC0309        	  2426:     lea     ($0309,A4),A0
02:0004AC36 11802000        	  2427:     move.b  D0,(A0,D2.W)
                            	  2428:     ; Write the end marker.
                            	  2429:     ;
02:0004AC3A 103C00FF        	  2430:     move.b  #$FF,D0
02:0004AC3E 41EC030C        	  2431:     lea     ($030C,A4),A0
02:0004AC42 11802000        	  2432:     move.b  D0,(A0,D2.W)
                            	  2433:     ; Update dynamic buffer length with 10 new bytes.
                            	  2434:     ;
02:0004AC46 1002            	  2435:     move.b  D2,D0
02:0004AC48 023C00EE        	  2436:     andi    #$EE,CCR  ; CLC: clear C+X
