                            	  4174:     ; If object does not have attribute $10, then
                            	  4175:     ; set movement direction to input direction,
                            	  4176:     ; and go try to turn to an unblocked direction in order to move.
                            	  4177:     ;
02:0004B88C 41EC04BF        	  4178:     lea     ($04BF,A4),A0
