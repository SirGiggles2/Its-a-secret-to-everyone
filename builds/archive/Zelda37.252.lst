                            	  5471: CheckState20:
                            	  5472:     ; If major state <> $20, go check other states.
                            	  5473:     ;
02:0004C136 0C000020        	  5474:     cmpi.b  #$20,D0
02:0004C13A 6704            	  5475:     beq.s  __far_z_07_0083
02:0004C13C 600000B6        	  5476:     jmp  CheckState30
                            	  5477: __far_z_07_0083:
                            	  5478:     ; State $2x. Spark.
                            	  5479:     ;
                            	  5480:     ; Change the state to $28, and decrement animation counter.
                            	  5481:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5482:     ; (with Link, if this is a monster's boomerang).
                            	  5483:     ;
                            	  5484:     ; TODO: Why state $28?
                            	  5485:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5486:     ; start over again when spinning.
                            	  5487:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5488:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5489:     ; any drawing code depends on the minor state.
                            	  5490:     ;
02:0004C140 7028            	  5491:     moveq   #40,D0
02:0004C142 41EC00AC        	  5492:     lea     ($00AC,A4),A0
02:0004C146 11802000        	  5493:     move.b  D0,(A0,D2.W)
02:0004C14A 41EC03D0        	  5494:     lea     ($03D0,A4),A0
02:0004C14E 53302000        	  5495:     subq.b  #1,(A0,D2.W)
02:0004C152 6702            	  5496:     beq.s  __far_z_07_0084
02:0004C154 6060            	  5497:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5498: __far_z_07_0084:
                            	  5499:     ; Animation counter = 0.
                            	  5500:     ;
                            	  5501:     ; Set state to $40. It will become $50 below in
                            	  5502:     ; HandleArrowOrBoomerangBlocked.
                            	  5503:     ;
02:0004C156 7040            	  5504:     moveq   #64,D0
02:0004C158 41EC00AC        	  5505:     lea     ($00AC,A4),A0
02:0004C15C 11802000        	  5506:     move.b  D0,(A0,D2.W)
                            	  5507:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5508:     ; Else go handle the boomerang being blocked.
                            	  5509:     ;
02:0004C160 0C02000D        	  5510:     cmpi.b  #$0D,D2
02:0004C164 640E            	  5511:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004C166 41EC034F        	  5512:     lea     ($034F,A4),A0
02:0004C16A 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0004C16E 0C00005B        	  5514:     cmpi.b  #$5B,D0
02:0004C172 6708            	  5515:     beq  _L_z07_CheckState20_Deactivate
                            	  5516:     even
                            	  5517: _L_z07_CheckState20_CheckBoomerangBlocked:
02:0004C174 0C020012        	  5518:     cmpi.b  #$12,D2
02:0004C178 6702            	  5519:     beq.s  __far_z_07_0085
02:0004C17A 6016            	  5520:     jmp  HandleArrowOrBoomerangBlocked
                            	  5521: __far_z_07_0085:
                            	  5522:     even
                            	  5523: _L_z07_CheckState20_Deactivate:
02:0004C17C 61000534        	  5524:     jsr     ResetObjState
                            	  5525:     ; If it's a monster's arrow, then destroy it in the monster slot,
                            	  5526:     ; including clearing object type.
                            	  5527:     ;
02:0004C180 0C02000D        	  5528:     cmpi.b  #$0D,D2
02:0004C184 6406            	  5529:     bcc  _anon_z07_29
02:0004C186 4EB90003A02A    	  5530:     jsr     DestroyCountedMonsterShot
                            	  5531: _anon_z07_29:
02:0004C18C 0A3C0001        	  5532:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
