                            	  3927: ; Params:
                            	  3928: ; Y: middle speed index (4)
                            	  3929: ; [03]: horizontal distance
                            	  3930: ; [04]: vertical distance
                            	  3931: ; [0A]: vertical direction
                            	  3932: ; [0B]: horizontal direction
                            	  3933: ;
                            	  3934: ; Returns:
                            	  3935: ; Y: speed index (0 to 8) for the angle
                            	  3936: ;
                            	  3937: ;
                            	  3938: ; TODO: call it speed index or angle?
                            	  3939: ; Store the middle speed index in [00]. It will be changed to the
                            	  3940: ; right speed index to use incrementally.
                            	  3941: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  3942: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  3943: ;
                            	  3944:     even
                            	  3945: _CalcDiagonalSpeedIndex:
02:00030F10 1883            	  3946:     move.b  D3,($0000,A4)
                            	  3947:     ; Assuming horizontal distance >= vertical distance, the
                            	  3948:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  3949:     ;
02:00030F12 103C00FF        	  3950:     move.b  #$FF,D0
02:00030F16 19400001        	  3951:     move.b  D0,($0001,A4)
                            	  3952:     ; TODO:
                            	  3953:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  3954:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  3955:     ;
                            	  3956:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  3957:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  3958:     ; of the farther distance faster.
                            	  3959:     ;
02:00030F1A 102C0003        	  3960:     move.b  ($0003,A4),D0
02:00030F1E 122C0004        	  3961:     move.b  ($0004,A4),D1
