02:00036794 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:00036796 7600            	  4891:     moveq   #0,D3
02:00036798 162C0413        	  4892:     move.b  ($0413,A4),D3
02:0003679C 41F900036736    	  4893:     lea     (PeaceText).l,A0
02:000367A2 10303000        	  4894:     move.b  (A0,D3.W),D0
02:000367A6 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:000367AA 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000367AC 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:000367B0 0C000024        	  4901:     cmpi.b  #$24,D0
