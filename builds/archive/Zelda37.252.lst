                            	   361:     ; The submenu map's rotation < 8.
                            	   362:     ; It represents the number of tiles to move right.
                            	   363:     ; So, multiply it by 8.
                            	   364:     ;
02:00040088 E308            	   365:     lsl.b  #1,D0   ; ASL A
02:0004008A E308            	   366:     lsl.b  #1,D0   ; ASL A
02:0004008C E308            	   367:     lsl.b  #1,D0   ; ASL A
