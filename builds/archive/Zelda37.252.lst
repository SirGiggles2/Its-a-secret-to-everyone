                            	  3343: FormatHeartsInTextBuf:
                            	  3344:     ; [$0E]: hearts value
                            	  3345:     ; [$0F]: heart partial
                            	  3346:     ; Y: The offset of first character in buffer
                            	  3347:     ;
                            	  3348:     ; The end of the bottom row is $12 bytes after the
                            	  3349:     ; start of the top row. We're writing to two transfer
                            	  3350:     ; records. We write the top row in the first transfer
                            	  3351:     ; record wherever the caller chooses. The second
                            	  3352:     ; transfer record has to begin with the heart tiles.
                            	  3353:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3354:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3355:     ;
                            	  3356:     ; Store the starting offset in [$0D].
02:00030B2A 1943000D        	  3357:     move.b  D3,($000D,A4)
02:00030B2E 102C000E        	  3358:     move.b  ($000E,A4),D0
02:00030B32 1B00            	  3359:     move.b  D0,-(A5)  ; PHA
02:00030B34 0200000F        	  3360:     andi.b #$0F,D0
02:00030B38 1880            	  3361:     move.b  D0,($0000,A4)
02:00030B3A 700F            	  3362:     moveq   #15,D0
02:00030B3C 003C0011        	  3363:     ori     #$11,CCR  ; SEC: set C+X
02:00030B40 1214            	  3364:     move.b  ($0000,A4),D1
02:00030B42 0A3C0010        	  3365:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B46 9101            	  3366:     subx.b  D1,D0   ; SBC $00
02:00030B48 0A3C0010        	  3367:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B4C 1880            	  3368:     move.b  D0,($0000,A4)
02:00030B4E 101D            	  3369:     move.b  (A5)+,D0  ; PLA
02:00030B50 E208            	  3370:     lsr.b  #1,D0   ; LSR A
02:00030B52 E208            	  3371:     lsr.b  #1,D0   ; LSR A
02:00030B54 E208            	  3372:     lsr.b  #1,D0   ; LSR A
02:00030B56 E208            	  3373:     lsr.b  #1,D0   ; LSR A
02:00030B58 19400001        	  3374:     move.b  D0,($0001,A4)
02:00030B5C 700F            	  3375:     moveq   #15,D0
02:00030B5E 003C0011        	  3376:     ori     #$11,CCR  ; SEC: set C+X
02:00030B62 122C0001        	  3377:     move.b  ($0001,A4),D1
02:00030B66 0A3C0010        	  3378:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030B6A 9101            	  3379:     subx.b  D1,D0   ; SBC $01
02:00030B6C 0A3C0010        	  3380:     eori    #$10,CCR  ; restore X = 6502 C
02:00030B70 19400001        	  3381:     move.b  D0,($0001,A4)
                            	  3382:     ; At this point,
                            	  3383:     ; [$00] = $F - hearts
                            	  3384:     ; [$01] = $F - heart containers
                            	  3385:     ; [$0D] = Y parameter (starting offset in tile buf)
                            	  3386:     ;
                            	  3387:     ; Also, Y is still set to the value passed in.
                            	  3388:     ;
02:00030B74 7400            	  3389:     moveq   #0,D2
02:00030B76 1003            	  3390:     move.b  D3,D0
02:00030B78 023C00EE        	  3391:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030B7C 123C0007        	  3392:     move.b  #$07,D1
02:00030B80 D101            	  3393:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:00030B82 1940000B        	  3394:     move.b  D0,($000B,A4)
                            	  3395:     ; Y keeps track of index of heart in row.
                            	  3396:     ; Start at the end of the first row.
02:00030B86 7607            	  3397:     moveq   #7,D3
