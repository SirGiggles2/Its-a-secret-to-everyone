                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:0003AB6E 6100015E        	  2683:     jsr     Jumper_GetKind
02:0003AB72 41F90003AA5E    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
