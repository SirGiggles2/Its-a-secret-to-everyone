                            	   693: ;------------------------------------------------------------------------------
                            	   694: ; _c_move_object_shim — MoveObject trampoline.
                            	   695: ;
                            	   696: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   697: ;   Input:     D2 = slot (0..11)
                            	   698: ;   Preserves: D2, A4, A5
                            	   699: ;   Clobbers:  D0, D1, D3, A0
                            	   700: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   701: ;
                            	   702: ; GCC side:
                            	   703: ;   void c_move_object(unsigned short slot);
                            	   704: ;     slot arrives as a 16-bit value on the stack.
                            	   705: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   706: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   707: ;   never clobbered by gcc.
                            	   708: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   709: ;   semantics can exist in a pure C port).
                            	   710: ;------------------------------------------------------------------------------
                            	   711: _c_move_object_shim:
                            	   712:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   713:     move.b  #$AA,($0900,A4)
                            	   714:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   715:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   716:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   717:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   718:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   719:     moveq   #0,D0
02:0002B658 3002            	   720:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   721:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   722:     jsr     c_move_object
02:0002B662 588F            	   723:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   724:     rts
                            	   725: 
                            	   726: ;==============================================================================
                            	   727: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   728: ; and tail-call the native asm function.
                            	   729: ;
                            	   730: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   731: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   732: ; sign-extended).
                            	   733: ;==============================================================================
                            	   734: 
                            	   735: ;------------------------------------------------------------------------------
                            	   736: ; void c_copy_bank_to_window(unsigned int bank);
                            	   737: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   738: ;------------------------------------------------------------------------------
                            	   739: c_copy_bank_to_window:
02:0002B666 202F0004        	   740:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   741:     jmp     _copy_bank_to_window
                            	   742: 
                            	   743: ;------------------------------------------------------------------------------
                            	   744: ; unsigned char c_ppu_read_2(void);
                            	   745: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   746: ; C return: gcc expects result in D0.
                            	   747: ;------------------------------------------------------------------------------
                            	   748: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   749:     jmp     _ppu_read_2
                            	   750: 
                            	   751: ;------------------------------------------------------------------------------
                            	   752: ; void c_ppu_write_6(unsigned int val);
                            	   753: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   754: ;------------------------------------------------------------------------------
                            	   755: c_ppu_write_6:
02:0002B674 202F0004        	   756:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   757:     jmp     _ppu_write_6
                            	   758: 
                            	   759: ;------------------------------------------------------------------------------
                            	   760: ; void c_ppu_write_7(unsigned int val);
                            	   761: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   762: ;------------------------------------------------------------------------------
                            	   763: c_ppu_write_7:
02:0002B67E 202F0004        	   764:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   765:     jmp     _ppu_write_7
                            	   766: 
