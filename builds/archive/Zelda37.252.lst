                            	  2586: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2587:     ; Set state 1 to jump.
                            	  2588:     ;
02:0003AACA 41EC00AC        	  2589:     lea     ($00AC,A4),A0
02:0003AACE 52302000        	  2590:     addq.b  #1,(A0,D2.W)
