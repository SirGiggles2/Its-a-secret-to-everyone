02:00044232 7000            	  7067:     moveq   #0,D0
02:00044234 1940052B        	  7068:     move.b  D0,($052B,A4)
02:00044238 700C            	  7069:     moveq   #12,D0
02:0004423A 1940000D        	  7070:     move.b  D0,($000D,A4)
                            	  7071:     even
                            	  7072: _L_z05_CheckShortcut_Write:
02:0004423E 6100FD76        	  7073:     jsr     WriteSquareOW
                            	  7074:     even
