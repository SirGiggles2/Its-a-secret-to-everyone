                            	  4492: 
                            	  4493: ; Params:
                            	  4494: ; [02:03]: address of door tiles for direction and face
                            	  4495: ; [04]: count of tiles remaining
                            	  4496: ; [07]: current index (0 to 3) of the tile to copy
                            	  4497: ;       to the dynamic transfer buf
                            	  4498: ; [09]: door direction index
                            	  4499: ;
                            	  4500: ; Returns:
                            	  4501: ; Z: 1 if wrote the last tile / [04] became 0
                            	  4502: ; [04]: original value - 1
                            	  4503: ; [07]: original value + 1
                            	  4504: ;
                            	  4505: ; The door face tile list at [02:03] has pairs of tiles arranged
                            	  4506: ; vertically. The point of this routine is to access them
                            	  4507: ; horizontally in order to transfer them to a nametable.
                            	  4508: ;
                            	  4509: ;
                            	  4510: ; For the direction index in [09], look up the base offset of the
                            	  4511: ; set of 4 indexes in HorizontalDoorFaceIndexes that point to
                            	  4512: ; the door face tiles at [02:03].
                            	  4513: ;
                            	  4514:     even
                            	  4515: WriteDoorFaceTileHorizontally:
02:000423BA 7600            	  4516:     moveq   #0,D3
02:000423BC 162C0009        	  4517:     move.b  ($0009,A4),D3
02:000423C0 41F9000435DE    	  4518:     lea     (HorizontalDoorFaceIndexesBaseOffsets).l,A0
02:000423C6 10303000        	  4519:     move.b  (A0,D3.W),D0
                            	  4520:     ; Add [07] to the base offset we got above. This yields one
                            	  4521:     ; of four consecutive indexes into HorizontalDoorFaceIndexes.
                            	  4522:     ;
02:000423CA 023C00EE        	  4523:     andi    #$EE,CCR  ; CLC: clear C+X
02:000423CE 122C0007        	  4524:     move.b  ($0007,A4),D1
02:000423D2 D101            	  4525:     addx.b  D1,D0   ; ADC $07
02:000423D4 7600            	  4526:     moveq   #0,D3
02:000423D6 1600            	  4527:     move.b  D0,D3
                            	  4528:     ; With that index, look up the index to use with the door face
                            	  4529:     ; list of tiles at [02:03].
                            	  4530:     ;
02:000423D8 41F9000435D0    	  4531:     lea     (HorizontalDoorFaceIndexes).l,A0
02:000423DE 10303000        	  4532:     move.b  (A0,D3.W),D0
02:000423E2 7600            	  4533:     moveq   #0,D3
02:000423E4 1600            	  4534:     move.b  D0,D3
                            	  4535:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4536:     ; and copy it to the dynamic transfer buf.
                            	  4537:     ;
02:000423E6 122C0002        	  4538:     move.b  ($02,A4),D1   ; ptr lo
02:000423EA 182C0003        	  4539:     move.b  ($03,A4),D4  ; ptr hi
02:000423EE 024100FF        	  4540:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000423F2 E14C            	  4541:     lsl.w   #8,D4
02:000423F4 8841            	  4542:     or.w    D1,D4             ; D4 = NES ptr addr
02:000423F6 48C4            	  4543:     ext.l   D4
02:000423F8 D8BC00FF0000    	  4544:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000423FE 2044            	  4545:     movea.l D4,A0
02:00042400 10303000        	  4546:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042404 41EC0302        	  4547:     lea     ($0302,A4),A0
02:00042408 11802000        	  4548:     move.b  D0,(A0,D2.W)
                            	  4549:     ; Prepare for the next call:
                            	  4550:     ; - increment dynamic transfer buf pointer
                            	  4551:     ; - increment index of tile to copy [07]
                            	  4552:     ; - decrement count of tiles remaining
                            	  4553:     ;
02:0004240C 5202            	  4554:     addq.b  #1,D2
02:0004240E 522C0007        	  4555:     addq.b  #1,($0007,A4)
02:00042412 532C0004        	  4556:     subq.b  #1,($0004,A4)
02:00042416 4E75            	  4557:     rts
