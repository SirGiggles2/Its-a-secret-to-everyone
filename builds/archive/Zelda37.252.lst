                            	 10069: _L_z04_UpdateGleeok_LoadNeckBytes:
                            	 10070:     ; Load neck data.
                            	 10071:     ;
                            	 10072:     ; For each segment from 5 to 0, indexed by Y register:
                            	 10073:     ; - load coordinates into object slots 6 to 1
                            	 10074:     ; - load miscellany into an array at [0413]
                            	 10075:     ;
02:0003E1A0 1214            	 10076:     move.b  ($00,A4),D1   ; ptr lo
02:0003E1A2 182C0001        	 10077:     move.b  ($01,A4),D4  ; ptr hi
02:0003E1A6 024100FF        	 10078:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003E1AA E14C            	 10079:     lsl.w   #8,D4
02:0003E1AC 8841            	 10080:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003E1AE 48C4            	 10081:     ext.l   D4
02:0003E1B0 D8BC00FF0000    	 10082:     add.l   #NES_RAM,D4       ; → Genesis addr
