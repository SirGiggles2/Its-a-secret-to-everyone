02:0003CC1C 41EC00AC        	  7169:     lea     ($00AC,A4),A0
02:0003CC20 52302000        	  7170:     addq.b  #1,(A0,D2.W)
                            	  7171:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7172:     ;
02:0003CC24 7610            	  7173:     moveq   #16,D3
02:0003CC26 7000            	  7174:     moveq   #0,D0
02:0003CC28 41EC00AC        	  7175:     lea     ($00AC,A4),A0
02:0003CC2C 11803000        	  7176:     move.b  D0,(A0,D3.W)
02:0003CC30 41EC042C        	  7177:     lea     ($042C,A4),A0
02:0003CC34 11802000        	  7178:     move.b  D0,(A0,D2.W)
                            	  7179:     even
