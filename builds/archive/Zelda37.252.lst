                            	  5685: Moldorm_Chase:
                            	  5686:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5687:     ; Only the head controls the movement direction.
                            	  5688:     ;
02:0003C196 0C020005        	  5689:     cmpi.b  #$05,D2
02:0003C19A 670A            	  5690:     beq  _anon_z04_81
02:0003C19C 0C02000A        	  5691:     cmpi.b  #$0A,D2
