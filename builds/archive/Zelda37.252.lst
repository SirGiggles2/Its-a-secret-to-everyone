                            	   369: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   370:     ; Add the offset we calculated, and $62 to [00] to get
                            	   371:     ; the position marker's X coordinate.
                            	   372:     ;
02:0004008E 023C00EE        	   373:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040092 1214            	   374:     move.b  ($0000,A4),D1
02:00040094 D101            	   375:     addx.b  D1,D0   ; ADC $00
02:00040096 023C00EE        	   376:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004009A 123C0062        	   377:     move.b  #$62,D1
02:0004009E D101            	   378:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:000400A0 19400253        	   379:     move.b  D0,($0253,A4)
                            	   380:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   381:     ; Divide by 2 to get a multiple of the tile height.
                            	   382:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   383:     ;
02:000400A4 102C00EB        	   384:     move.b  ($00EB,A4),D0
02:000400A8 020000F0        	   385:     andi.b #$F0,D0
02:000400AC E208            	   386:     lsr.b  #1,D0   ; LSR A
02:000400AE 123C0069        	   387:     move.b  #$69,D1
02:000400B2 D101            	   388:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:000400B4 19400250        	   389:     move.b  D0,($0250,A4)
                            	   390:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   391:     ;
02:000400B8 703E            	   392:     moveq   #62,D0
02:000400BA 19400251        	   393:     move.b  D0,($0251,A4)
02:000400BE 7000            	   394:     moveq   #0,D0
02:000400C0 19400252        	   395:     move.b  D0,($0252,A4)
                            	   396:     even
                            	   397: _L_z05_UpdateMenuScrollDownUW_Exit:
02:000400C4 4E75            	   398:     rts
