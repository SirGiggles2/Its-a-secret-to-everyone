                            	  7291: Dodongo_Draw:
02:0003CCC8 610000F4        	  7292:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7293:     ; Make a 5-way direction index out of the facing direction
                            	  7294:     ; by shifting right once, and store it in [00].
                            	  7295:     ;
02:0003CCCC 41EC0098        	  7296:     lea     ($0098,A4),A0
02:0003CCD0 10302000        	  7297:     move.b  (A0,D2.W),D0
02:0003CCD4 E208            	  7298:     lsr.b  #1,D0   ; LSR A
02:0003CCD6 1880            	  7299:     move.b  D0,($0000,A4)
                            	  7300:     ; If state = 0, go handle animating the two frames of this state.
                            	  7301:     ;
02:0003CCD8 7600            	  7302:     moveq   #0,D3
02:0003CCDA 41EC00AC        	  7303:     lea     ($00AC,A4),A0
02:0003CCDE 16302000        	  7304:     move.b  (A0,D2.W),D3
02:0003CCE2 6744            	  7305:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7306:     ; If state > 1, then the monster is stunned (state 2).
                            	  7307:     ; So, go switch frames every $20 screen frames.
                            	  7308:     ;
02:0003CCE4 7020            	  7309:     moveq   #32,D0
02:0003CCE6 5303            	  7310:     subq.b  #1,D3
02:0003CCE8 6640            	  7311:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7312:     ; State = 1. Bloated.
                            	  7313:     ;
                            	  7314:     ; In substate 0, go animate as usual for walking.
                            	  7315:     ;
02:0003CCEA 7600            	  7316:     moveq   #0,D3
02:0003CCEC 41EC042C        	  7317:     lea     ($042C,A4),A0
02:0003CCF0 16302000        	  7318:     move.b  (A0,D2.W),D3
02:0003CCF4 6732            	  7319:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7320:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7321:     ; go fade the boss; so that some frames are not drawn.
                            	  7322:     ;
02:0003CCF6 0C030002        	  7323:     cmpi.b  #$02,D3
02:0003CCFA 6718            	  7324:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CCFC 0C030003        	  7325:     cmpi.b  #$03,D3
02:0003CD00 6712            	  7326:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7327:     ; State 1, substate 1
                            	  7328:     ;
                            	  7329:     ; Add $14 to the frame image index to index into the bloated
                            	  7330:     ; frame images and H-flips.
                            	  7331:     ;
02:0003CD02 1014            	  7332:     move.b  ($0000,A4),D0
02:0003CD04 023C00EE        	  7333:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD08 123C0014        	  7334:     move.b  #$14,D1
02:0003CD0C D101            	  7335:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CD0E 7600            	  7336:     moveq   #0,D3
02:0003CD10 1600            	  7337:     move.b  D0,D3
02:0003CD12 6032            	  7338:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7339: 
                            	  7340:     even
                            	  7341: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7342:     ; In bloated substates 2 and 3:
                            	  7343:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7344:     ;
02:0003CD14 102C0015        	  7345:     move.b  ($0015,A4),D0
02:0003CD18 02000002        	  7346:     andi.b #$02,D0
02:0003CD1C 6604            	  7347:     bne.s  __far_z_04_0066
02:0003CD1E 600000A4        	  7348:     jmp  L11B00_Exit
                            	  7349: __far_z_04_0066:
02:0003CD22 7600            	  7350:     moveq   #0,D3
02:0003CD24 1614            	  7351:     move.b  ($0000,A4),D3
02:0003CD26 601E            	  7352:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7353: 
                            	  7354:     even
                            	  7355: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7356:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  7357:     ;
02:0003CD28 7008            	  7358:     moveq   #8,D0
                            	  7359:     even
                            	  7360: _L_z04_Dodongo_Draw_DrawWalking:
02:0003CD2A 7600            	  7361:     moveq   #0,D3
02:0003CD2C 1614            	  7362:     move.b  ($0000,A4),D3
02:0003CD2E 122C0015        	  7363:     move.b  ($0015,A4),D1
02:0003CD32 C001            	  7364:     and.b  D1,D0
02:0003CD34 6710            	  7365:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7366:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7367:     ; in order to index into the second set of frame image numbers.
                            	  7368:     ;
02:0003CD36 1003            	  7369:     move.b  D3,D0
02:0003CD38 023C00EE        	  7370:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD3C 123C0005        	  7371:     move.b  #$05,D1
02:0003CD40 D101            	  7372:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CD42 7600            	  7373:     moveq   #0,D3
02:0003CD44 1600            	  7374:     move.b  D0,D3
                            	  7375:     even
                            	  7376: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7377:     ; Start preparing sprites.
                            	  7378:     ;
02:0003CD46 4EB90004CB14    	  7379:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CD4C 1003            	  7380:     move.b  D3,D0
02:0003CD4E 1B00            	  7381:     move.b  D0,-(A5)  ; PHA
                            	  7382:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7383:     ;
02:0003CD50 41F90003CCAA    	  7384:     lea     (DodongoFrameHFlips).l,A0
02:0003CD56 10303000        	  7385:     move.b  (A0,D3.W),D0
02:0003CD5A 1940000F        	  7386:     move.b  D0,($000F,A4)
02:0003CD5E 41F90003CCA0    	  7387:     lea     (DodongoFrameImages).l,A0
02:0003CD64 10303000        	  7388:     move.b  (A0,D3.W),D0
                            	  7389:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7390:     ; They are drawn mirrored.
                            	  7391:     ;
02:0003CD68 0C000007        	  7392:     cmpi.b  #$07,D0
02:0003CD6C 6706            	  7393:     beq  _anon_z04_92
02:0003CD6E 0C000009        	  7394:     cmpi.b  #$09,D0
02:0003CD72 6608            	  7395:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7396: _anon_z04_92:
02:0003CD74 4EB9000319BE    	  7397:     jsr     DrawObjectMirrored
02:0003CD7A 6006            	  7398:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  7399: 
                            	  7400:     even
                            	  7401: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  7402:     ; No other frame images are mirrored.
                            	  7403:     ;
02:0003CD7C 4EB9000319C2    	  7404:     jsr     DrawObjectNotMirrored
                            	  7405:     even
                            	  7406: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CD82 101D            	  7407:     move.b  (A5)+,D0  ; PLA
02:0003CD84 7600            	  7408:     moveq   #0,D3
02:0003CD86 1600            	  7409:     move.b  D0,D3
                            	  7410:     ; If facing vertically, then return. There's no other side to draw.
                            	  7411:     ;
02:0003CD88 41EC0098        	  7412:     lea     ($0098,A4),A0
02:0003CD8C 10302000        	  7413:     move.b  (A0,D2.W),D0
02:0003CD90 02000003        	  7414:     andi.b #$03,D0
02:0003CD94 6602            	  7415:     bne.s  __far_z_04_0067
02:0003CD96 602C            	  7416:     jmp  L11B00_Exit
                            	  7417: __far_z_04_0067:
                            	  7418:     ; Else draw the right side.
                            	  7419:     ;
                            	  7420:     ; Keep the Y coordinate in [01].
                            	  7421:     ; But, store (X + $10) in [00].
                            	  7422:     ;
02:0003CD98 10342070        	  7423:     move.b  ($70,A4,D2.W),D0
02:0003CD9C 023C00EE        	  7424:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDA0 123C0010        	  7425:     move.b  #$10,D1
02:0003CDA4 D101            	  7426:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CDA6 1880            	  7427:     move.b  D0,($0000,A4)
02:0003CDA8 6114            	  7428:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7429:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7430:     ;
                            	  7431:     ; So, if we had animation frame 1, direction left:
                            	  7432:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7433:     ; - frame image index = 6 (1 + 5)
                            	  7434:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7435:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7436:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7437:     ;
                            	  7438:     ; So, 3 would have been the frame number used above for
                            	  7439:     ; the left side.
                            	  7440:     ;
                            	  7441:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7442:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7443:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7444:     ; on the right.
                            	  7445:     ;
02:0003CDAA 41F90003CCA0    	  7446:     lea     (DodongoFrameImages).l,A0
02:0003CDB0 10303000        	  7447:     move.b  (A0,D3.W),D0
02:0003CDB4 0A000001        	  7448:     eori.b #$01,D0
02:0003CDB8 4EF9000319C2    	  7449:     jmp     DrawObjectNotMirrored
                            	  7450: 
                            	  7451: ; Returns:
                            	  7452: ; A: 3
