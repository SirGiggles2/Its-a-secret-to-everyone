                            	   246: _L_z01_InitCave_TakeType:
                            	   247:     ; Else the cave/person simply does:
                            	   248:     ; - taken:     no person, no text
                            	   249:     ; - not taken: show a person and text
                            	   250:     ;
                            	   251:     ; So, if the item was not taken, then go set up the text.
                            	   252:     ;
02:0002E5D6 61002D90        	   253:     jsr     GetRoomFlagUWItemState
02:0002E5DA 6602            	   254:     bne.s  __far_z_01_0001
02:0002E5DC 600A            	   255:     jmp  InitCaveContinue
                            	   256: __far_z_01_0001:
                            	   257:     ; Otherwise destroy the person object, and let Link continue.
                            	   258:     ;
02:0002E5DE 7000            	   259:     moveq   #0,D0
02:0002E5E0 19400350        	   260:     move.b  D0,($0350,A4)
                            	   261:     even
                            	   262: UnhaltLink:
02:0002E5E4 6000D408        	   263:     jmp     c_unhalt_link
                            	   264: 
                            	   265: InitCaveContinue:
                            	   266:     ; Get this cave's index (object type - $6A).
                            	   267:     ;
02:0002E5E8 102C0350        	   268:     move.b  ($0350,A4),D0
02:0002E5EC 003C0011        	   269:     ori     #$11,CCR  ; SEC: set C+X
02:0002E5F0 123C006A        	   270:     move.b  #$6A,D1
02:0002E5F4 0A3C0010        	   271:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E5F8 9101            	   272:     subx.b  D1,D0   ; SBC #$6A
02:0002E5FA 0A3C0010        	   273:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E5FE 7600            	   274:     moveq   #0,D3
02:0002E600 1600            	   275:     move.b  D0,D3
                            	   276:     ; Get the person text selector by looking up the text selector byte
                            	   277:     ; for this index, and masking it with $3F.
                            	   278:     ;
02:0002E602 41F90002E580    	   279:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E608 10303000        	   280:     move.b  (A0,D3.W),D0
02:0002E60C 1B00            	   281:     move.b  D0,-(A5)  ; PHA
02:0002E60E 0200003F        	   282:     andi.b #$3F,D0
02:0002E612 19400415        	   283:     move.b  D0,($0415,A4)
                            	   284:     ; Pop and mask the text selector byte with $C0 to get the
                            	   285:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   286:     ;
02:0002E616 101D            	   287:     move.b  (A5)+,D0  ; PLA
02:0002E618 020000C0        	   288:     andi.b #$C0,D0
02:0002E61C 19400003        	   289:     move.b  D0,($0003,A4)
                            	   290:     ; At this point, the Y register still has the cave index.
                            	   291:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   292:     ;
02:0002E620 103C00FD        	   293:     move.b  #$FD,D0
                            	   294: _anon_z01_0:
02:0002E624 023C00EE        	   295:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E628 123C0003        	   296:     move.b  #$03,D1
02:0002E62C D101            	   297:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E62E 5303            	   298:     subq.b  #1,D3
02:0002E630 6AF2            	   299:     bpl  _anon_z01_0
02:0002E632 7600            	   300:     moveq   #0,D3
02:0002E634 1600            	   301:     move.b  D0,D3
                            	   302:     ; Loop over the wares from 0 to 2.
                            	   303:     ;
02:0002E636 7400            	   304:     moveq   #0,D2
                            	   305:     even
                            	   306: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   307:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   308:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   309:     ;
02:0002E638 41F900FF6A7E    	   310:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E63E 10303000        	   311:     move.b  (A0,D3.W),D0
02:0002E642 41EC0422        	   312:     lea     ($0422,A4),A0
02:0002E646 11802000        	   313:     move.b  D0,(A0,D2.W)
                            	   314:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   315:     ;
02:0002E64A 020000C0        	   316:     andi.b #$C0,D0
02:0002E64E 19802000        	   317:     move.b  D0,($00,A4,D2.W)
                            	   318:     ; Copy 3 prices from the Cave level block info.
                            	   319:     ;
02:0002E652 41F900FF6ABA    	   320:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E658 10303000        	   321:     move.b  (A0,D3.W),D0
02:0002E65C 41EC0430        	   322:     lea     ($0430,A4),A0
02:0002E660 11802000        	   323:     move.b  D0,(A0,D2.W)
                            	   324:     ; Bottom of the wares copying loop.
                            	   325:     ;
02:0002E664 5203            	   326:     addq.b  #1,D3
02:0002E666 5202            	   327:     addq.b  #1,D2
02:0002E668 0C020003        	   328:     cmpi.b  #$03,D2
02:0002E66C 66CA            	   329:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   330:     ; Get the top 2 bits of text selector byte in [03],
                            	   331:     ; shift them to the bottom, and combine them with [00].
                            	   332:     ;
02:0002E66E 102C0003        	   333:     move.b  ($0003,A4),D0
02:0002E672 E308            	   334:     lsl.b  #1,D0   ; ASL A
02:0002E674 E310            	   335:     roxl.b  #1,D0   ; ROL A
02:0002E676 E310            	   336:     roxl.b  #1,D0   ; ROL A
02:0002E678 1214            	   337:     move.b  ($0000,A4),D1
02:0002E67A 8001            	   338:     or.b  D1,D0
02:0002E67C 1880            	   339:     move.b  D0,($0000,A4)
                            	   340:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   341:     ; and combine them with [00].
                            	   342:     ;
02:0002E67E 102C0002        	   343:     move.b  ($0002,A4),D0
02:0002E682 E208            	   344:     lsr.b  #1,D0   ; LSR A
02:0002E684 E208            	   345:     lsr.b  #1,D0   ; LSR A
02:0002E686 E208            	   346:     lsr.b  #1,D0   ; LSR A
02:0002E688 E208            	   347:     lsr.b  #1,D0   ; LSR A
02:0002E68A 1214            	   348:     move.b  ($0000,A4),D1
02:0002E68C 8001            	   349:     or.b  D1,D0
02:0002E68E 1880            	   350:     move.b  D0,($0000,A4)
                            	   351:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   352:     ; and combine them with [00] into CaveFlags.
                            	   353:     ;
02:0002E690 102C0001        	   354:     move.b  ($0001,A4),D0
02:0002E694 E208            	   355:     lsr.b  #1,D0   ; LSR A
02:0002E696 E208            	   356:     lsr.b  #1,D0   ; LSR A
02:0002E698 1214            	   357:     move.b  ($0000,A4),D1
02:0002E69A 8001            	   358:     or.b  D1,D0
02:0002E69C 19400413        	   359:     move.b  D0,($0413,A4)
                            	   360:     ; The end result is a byte with 8 cave flags.
                            	   361:     ;
                            	   362:     ; If cave flag "money game" is missing, then go finish up,
                            	   363:     ; instead of choosing random amounts for the money game.
                            	   364:     ;
02:0002E6A0 02000020        	   365:     andi.b #$20,D0
02:0002E6A4 6700009E        	   366:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   367:     ; Determine an index randomly with increasing probability,
                            	   368:     ; from 6 to 1. Start with the following test:
                            	   369:     ;
                            	   370:     ;   If $FF < Random, then go use index 6.
                            	   371:     ;
02:0002E6A8 103C00FF        	   372:     move.b  #$FF,D0
02:0002E6AC 7606            	   373:     moveq   #6,D3
                            	   374:     even
                            	   375: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E6AE 122C0019        	   376:     move.b  ($0019,A4),D1
02:0002E6B2 B001            	   377:     cmp.b   D1,D0
02:0002E6B4 6516            	   378:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   379:     ; If the test fails, then subtract $2B from the reference number.
                            	   380:     ;
02:0002E6B6 003C0011        	   381:     ori     #$11,CCR  ; SEC: set C+X
02:0002E6BA 123C002B        	   382:     move.b  #$2B,D1
02:0002E6BE 0A3C0010        	   383:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E6C2 9101            	   384:     subx.b  D1,D0   ; SBC #$2B
02:0002E6C4 0A3C0010        	   385:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E6C8 5303            	   386:     subq.b  #1,D3
02:0002E6CA 66E2            	   387:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   388:     even
                            	   389: _L_z01_InitCaveContinue_FoundPermutation:
                            	   390:     ; The index chooses the last offset of a permutation of three indexes.
                            	   391:     ;
02:0002E6CC 7400            	   392:     moveq   #0,D2
02:0002E6CE 41F90002E5A8    	   393:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E6D4 14303000        	   394:     move.b  (A0,D3.W),D2
                            	   395:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   396:     ;
02:0002E6D8 7602            	   397:     moveq   #2,D3
                            	   398:     even
                            	   399: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E6DA 41F90002E596    	   400:     lea     (MoneyGamePermutations).l,A0
02:0002E6E0 10302000        	   401:     move.b  (A0,D2.W),D0
02:0002E6E4 41EC046C        	   402:     lea     ($046C,A4),A0
02:0002E6E8 11803000        	   403:     move.b  D0,(A0,D3.W)
02:0002E6EC 5302            	   404:     subq.b  #1,D2
02:0002E6EE 5303            	   405:     subq.b  #1,D3
02:0002E6F0 6AE8            	   406:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   407:     ; With the first bit of another random number, choose 10 or 40
                            	   408:     ; to put in [046F]. This is a random amount to lose.
                            	   409:     ;
02:0002E6F2 102C001A        	   410:     move.b  ($001A,A4),D0
02:0002E6F6 02000001        	   411:     andi.b #$01,D0
02:0002E6FA 7600            	   412:     moveq   #0,D3
02:0002E6FC 1600            	   413:     move.b  D0,D3
02:0002E6FE 41F90002E594    	   414:     lea     (MoneyGameLossAmounts).l,A0
02:0002E704 10303000        	   415:     move.b  (A0,D3.W),D0
02:0002E708 1940046F        	   416:     move.b  D0,($046F,A4)
                            	   417:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   418:     ;
02:0002E70C 700A            	   419:     moveq   #10,D0
02:0002E70E 19400470        	   420:     move.b  D0,($0470,A4)
                            	   421:     ; With a different bit of the second random number,
                            	   422:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   423:     ;
02:0002E712 7614            	   424:     moveq   #20,D3
02:0002E714 102C001A        	   425:     move.b  ($001A,A4),D0
02:0002E718 02000002        	   426:     andi.b #$02,D0
02:0002E71C 6702            	   427:     beq  _anon_z01_1
02:0002E71E 7632            	   428:     moveq   #50,D3
                            	   429: _anon_z01_1:
