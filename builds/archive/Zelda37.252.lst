02:0003B03C 0C000003        	  3314:     cmpi.b  #$03,D0
02:0003B040 666E            	  3315:     bne  _L_z04_UpdateRedLeever_AnimateIfTime
                            	  3316:     ; State 3.
                            	  3317:     ;
                            	  3318:     ; If being shoved, go shove, animate, and draw the leever.
