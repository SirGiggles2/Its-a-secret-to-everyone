02:0003D024 D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003D026 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003D02A 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
