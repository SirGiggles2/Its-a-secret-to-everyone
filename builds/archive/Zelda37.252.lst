                            	  9880:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  9881:     ; on the left side.
                            	  9882:     ;
02:0003E028 003C0011        	  9883:     ori     #$11,CCR  ; SEC: set C+X
02:0003E02C 123C0010        	  9884:     move.b  #$10,D1
02:0003E030 0A3C0010        	  9885:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E034 9101            	  9886:     subx.b  D1,D0   ; SBC #$10
02:0003E036 0A3C0010        	  9887:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E03A 19802070        	  9888:     move.b  D0,($70,A4,D2.W)
                            	  9889:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	  9890:     ; from left to right, indexed by [0F].
                            	  9891:     ;
02:0003E03E 7005            	  9892:     moveq   #5,D0
02:0003E040 1940000F        	  9893:     move.b  D0,($000F,A4)
