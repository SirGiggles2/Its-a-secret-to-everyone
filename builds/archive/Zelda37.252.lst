                            	  5198: UpdateRope:
                            	  5199:     ; Set the input direction to the facing direction.
                            	  5200:     ;
02:0003BD8A 41EC0098        	  5201:     lea     ($0098,A4),A0
02:0003BD8E 10302000        	  5202:     move.b  (A0,D2.W),D0
02:0003BD92 41EC03F8        	  5203:     lea     ($03F8,A4),A0
