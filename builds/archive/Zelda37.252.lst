02:0003C20E 1880            	  5802:     move.b  D0,($0000,A4)
                            	  5803:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  5804:     ;
02:0003C210 7600            	  5805:     moveq   #0,D3
02:0003C212 0C020005        	  5806:     cmpi.b  #$05,D2
02:0003C216 6702            	  5807:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003C218 7605            	  5808:     moveq   #5,D3
