02:0003C142 10342070        	  5645:     move.b  ($70,A4,D2.W),D0
02:0003C146 19803071        	  5646:     move.b  D0,($71,A4,D3.W)
02:0003C14A 41EC0084        	  5647:     lea     ($0084,A4),A0
02:0003C14E 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003C152 41EC0085        	  5649:     lea     ($0085,A4),A0
02:0003C156 11803000        	  5650:     move.b  D0,(A0,D3.W)
