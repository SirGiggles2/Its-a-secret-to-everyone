                            	  5648: _L_z07_CheckState30_CheckOtherStates:
                            	  5649:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5650:     ;
                            	  5651:     ; The boomerang will now return. Reset the grid offset.
                            	  5652:     ;
02:0004C250 7000            	  5653:     moveq   #0,D0
02:0004C252 41EC0394        	  5654:     lea     ($0394,A4),A0
02:0004C256 11802000        	  5655:     move.b  D0,(A0,D2.W)
                            	  5656:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5657:     ;
02:0004C25A 0C02000D        	  5658:     cmpi.b  #$0D,D2
02:0004C25E 6408            	  5659:     bcc  _anon_z07_30
02:0004C260 41EC042C        	  5660:     lea     ($042C,A4),A0
02:0004C264 10302000        	  5661:     move.b  (A0,D2.W),D0
                            	  5662: _anon_z07_30:
02:0004C268 4EB900030EC2    	  5663:     jsr     GetDirectionsAndDistancesToTarget
                            	  5664:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5665:     ; then go move towards the thrower, draw, and check collisions.
                            	  5666:     ;
02:0004C26E 1014            	  5667:     move.b  ($0000,A4),D0
02:0004C270 0C000002        	  5668:     cmpi.b  #$02,D0
02:0004C274 666A            	  5669:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5670:     ; The boomerang has reached the thrower.
                            	  5671:     ;
                            	  5672:     ; Reset the distance to move.
                            	  5673:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5674:     ;
02:0004C276 7000            	  5675:     moveq   #0,D0
02:0004C278 41EC0380        	  5676:     lea     ($0380,A4),A0
02:0004C27C 11802000        	  5677:     move.b  D0,(A0,D2.W)
02:0004C280 0C02000D        	  5678:     cmpi.b  #$0D,D2
02:0004C284 6524            	  5679:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5680:     ; Link has caught the boomerang.
                            	  5681:     ;
                            	  5682:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5683:     ;
                            	  5684:     ; If Link catches it some time after throwing it,
                            	  5685:     ; his state will become $20, and he will show the catch animation.
                            	  5686:     ;
                            	  5687:     ; But if he catches it right after throwing it, the state becomes
                            	  5688:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5689:     ;
02:0004C286 102C00AC        	  5690:     move.b  ($00AC,A4),D0
02:0004C28A 00000020        	  5691:     ori.b #$20,D0
02:0004C28E 194000AC        	  5692:     move.b  D0,($00AC,A4)
                            	  5693:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5694:     ; up the new state.
                            	  5695:     ;
02:0004C292 7001            	  5696:     moveq   #1,D0
02:0004C294 194003D0        	  5697:     move.b  D0,($03D0,A4)
                            	  5698:     ; Deactivate the boomerang.
                            	  5699:     ;
02:0004C298 760F            	  5700:     moveq   #15,D3
02:0004C29A 7000            	  5701:     moveq   #0,D0
02:0004C29C 41EC00AC        	  5702:     lea     ($00AC,A4),A0
02:0004C2A0 11803000        	  5703:     move.b  D0,(A0,D3.W)
02:0004C2A4 0A3C0001        	  5704:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004C2A8 4E75            	  5705:     rts
                            	  5706: 
                            	  5707:     even
                            	  5708: _L_z07_CheckState30_CatchBoomerang:
                            	  5709:     ; A monster caught the boomerang that it threw.
                            	  5710:     ;
                            	  5711:     ; Set a timer for the thrower based on a random value:
                            	  5712:     ; < $30: $30
                            	  5713:     ; < $70: $50
                            	  5714:     ; Else:  $70
                            	  5715:     ;
02:0004C2AA 7630            	  5716:     moveq   #48,D3
02:0004C2AC 10342018        	  5717:     move.b  ($18,A4,D2.W),D0
02:0004C2B0 0C000030        	  5718:     cmpi.b  #$30,D0
02:0004C2B4 650A            	  5719:     bcs  _L_z07_CheckState30_SetThrowerTimer
