                            	  3578: DrawGhiniAndCheckCollisions:
02:0003A10A 4EB90004B9F0    	  3579:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003A110 1940000D        	  3580:     move.b  D0,($000D,A4)
                            	  3581:     ; If the direction has an "up" component, then keep the
                            	  3582:     ; frame image 0, and go figure out horizontal flipping.
                            	  3583:     ;
02:0003A114 41EC0098        	  3584:     lea     ($0098,A4),A0
02:0003A118 10302000        	  3585:     move.b  (A0,D2.W),D0
02:0003A11C 02000008        	  3586:     andi.b #$08,D0
02:0003A120 6614            	  3587:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  3588:     ; Else make the frame image 1 for the "down" frame.
                            	  3589:     ; Note that this is the frame image to use, even if there's no
                            	  3590:     ; down component in the direction.
                            	  3591:     ;
02:0003A122 522C000D        	  3592:     addq.b  #1,($000D,A4)
                            	  3593:     ; If right is a component of the direction, then go set horizontal
                            	  3594:     ; flipping. Else leave horizontal flipping = 0.
                            	  3595:     ;
02:0003A126 41EC0098        	  3596:     lea     ($0098,A4),A0
02:0003A12A 10302000        	  3597:     move.b  (A0,D2.W),D0
02:0003A12E 02000001        	  3598:     andi.b #$01,D0
02:0003A132 6714            	  3599:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003A134 660E            	  3600:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3601:     even
