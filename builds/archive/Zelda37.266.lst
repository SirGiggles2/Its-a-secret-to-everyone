02:00031536 41EC034F        	  4175:     lea     ($034F,A4),A0
02:0003153A 10302000        	  4176:     move.b  (A0,D2.W),D0
02:0003153E 0C000033        	  4177:     cmpi.b  #$33,D0
02:00031542 6706            	  4178:     beq  _L_z01_BeginShove_Gohma
02:00031544 0C000034        	  4179:     cmpi.b  #$34,D0
