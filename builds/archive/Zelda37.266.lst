02:00030E48 6004            	  3097:     jmp     DrawObjectNotMirrored
                            	  3098: 
                            	  3099: ; Params:
                            	  3100: ; A: frame image
                            	  3101: ; X: object index
                            	  3102: ; [00]: object X
                            	  3103: ; [01]: object Y
                            	  3104: ;
                            	  3105: ;
                            	  3106: ; Set [0C] mirrored.
                            	  3107:     even
                            	  3108: DrawObjectMirrored:
02:00030E4A 7601            	  3109:     moveq   #1,D3
02:00030E4C 6602            	  3110:     bne  _anon_z01_75
                            	  3111: ; Params:
                            	  3112: ; A: frame image
                            	  3113: ; X: object index
                            	  3114: ; [00]: object X
                            	  3115: ; [01]: object Y
                            	  3116: ; [0F]: flip horizontally
                            	  3117: ;
                            	  3118:     even
                            	  3119: DrawObjectNotMirrored:
02:00030E4E 7600            	  3120:     moveq   #0,D3
                            	  3121: _anon_z01_75:
02:00030E50 1943000C        	  3122:     move.b  D3,($000C,A4)
                            	  3123:     ; Set animation index = object type + 1.
                            	  3124:     ;
02:00030E54 7600            	  3125:     moveq   #0,D3
02:00030E56 41EC034F        	  3126:     lea     ($034F,A4),A0
02:00030E5A 16302000        	  3127:     move.b  (A0,D2.W),D3
                            	  3128: ; Params:
                            	  3129: ; A: frame
                            	  3130: ; X: object index/cycle sprite index
                            	  3131: ; Y: object type
                            	  3132: ; [00]: object X
                            	  3133: ; [01]: object Y
                            	  3134: ; [0C]: mirrored
                            	  3135: ; [0F]: flip horizontally
                            	  3136: ;
                            	  3137: ; Note:
                            	  3138: ; If the object is not mirrored, then it's horizontally flippable.
                            	  3139: ;
                            	  3140: ; The animation index of most objects is (object type + 1),
                            	  3141: ; to make up for the fact that Link uses two animation indexes.
                            	  3142: ;
                            	  3143:     even
                            	  3144: DrawObjectWithType:
02:00030E5E 5203            	  3145:     addq.b  #1,D3
                            	  3146: ; Params:
                            	  3147: ; A: frame
                            	  3148: ; X: object index/cycle sprite index
                            	  3149: ; Y: animation index
                            	  3150: ; [00]: object X
                            	  3151: ; [01]: object Y
                            	  3152: ; [0C]: mirrored
                            	  3153: ; [0F]: flip horizontally
                            	  3154: ;
                            	  3155: ; Note:
                            	  3156: ; If the object is not mirrored, then it's horizontally flippable.
                            	  3157: ; But Link uses [0F] for flipping without checking [0C].
                            	  3158: ;
                            	  3159: ;
                            	  3160: ; [0D] holds frame.
                            	  3161:     even
                            	  3162: DrawObjectWithAnim:
02:00030E60 1940000D        	  3163:     move.b  D0,($000D,A4)
02:00030E64 1943000E        	  3164:     move.b  D3,($000E,A4)
02:00030E68 19420008        	  3165:     move.b  D2,($0008,A4)
                            	  3166:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  3167:     ;
02:00030E6C 7600            	  3168:     moveq   #0,D3
02:00030E6E 162C0341        	  3169:     move.b  ($0341,A4),D3
02:00030E72 41F900030E16    	  3170:     lea     (SpriteOffsets).l,A0
02:00030E78 10303000        	  3171:     move.b  (A0,D3.W),D0
02:00030E7C 19400343        	  3172:     move.b  D0,($0343,A4)
02:00030E80 41F900030E17    	  3173:     lea     (SpriteOffsets+1).l,A0
02:00030E86 10303000        	  3174:     move.b  (A0,D3.W),D0
                            	  3175:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  3176:     ;
02:00030E8A 4A02            	  3177:     cmpi.b  #$00,D2
02:00030E8C 6702            	  3178:     beq.s  __far_z_01_0008
02:00030E8E 6008            	  3179:     jmp  DrawObjectWithAnimAndSpecificSprites
