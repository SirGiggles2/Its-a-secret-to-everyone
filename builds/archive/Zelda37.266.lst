02:0003A02A 6708            	  3446:     beq  _L_z04_UpdateOctorock_Shoot
02:0003A02C 0C030009        	  3447:     cmpi.b  #$09,D3
02:0003A030 6702            	  3448:     beq  _L_z04_UpdateOctorock_Shoot
02:0003A032 E308            	  3449:     lsl.b  #1,D0   ; ASL A
