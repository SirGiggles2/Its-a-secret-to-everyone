                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:000335BA 7000            	  1676:     moveq   #0,D0
02:000335BC 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:000335C0 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:000335C2 41F9000333A4    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:000335C8 D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:000335CA 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
