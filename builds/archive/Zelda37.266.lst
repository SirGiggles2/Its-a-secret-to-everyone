                            	 10069: _L_z04_UpdateGleeok_LoadNeckBytes:
                            	 10070:     ; Load neck data.
                            	 10071:     ;
                            	 10072:     ; For each segment from 5 to 0, indexed by Y register:
                            	 10073:     ; - load coordinates into object slots 6 to 1
                            	 10074:     ; - load miscellany into an array at [0413]
                            	 10075:     ;
02:0003D07C 1214            	 10076:     move.b  ($00,A4),D1   ; ptr lo
02:0003D07E 182C0001        	 10077:     move.b  ($01,A4),D4  ; ptr hi
02:0003D082 024100FF        	 10078:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003D086 E14C            	 10079:     lsl.w   #8,D4
02:0003D088 8841            	 10080:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003D08A 48C4            	 10081:     ext.l   D4
02:0003D08C D8BC00FF0000    	 10082:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003D092 2044            	 10083:     movea.l D4,A0
02:0003D094 10303000        	 10084:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003D098 19803071        	 10085:     move.b  D0,($71,A4,D3.W)
02:0003D09C 122C0002        	 10086:     move.b  ($02,A4),D1   ; ptr lo
02:0003D0A0 182C0003        	 10087:     move.b  ($03,A4),D4  ; ptr hi
02:0003D0A4 024100FF        	 10088:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003D0A8 E14C            	 10089:     lsl.w   #8,D4
02:0003D0AA 8841            	 10090:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003D0AC 48C4            	 10091:     ext.l   D4
02:0003D0AE D8BC00FF0000    	 10092:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003D0B4 2044            	 10093:     movea.l D4,A0
