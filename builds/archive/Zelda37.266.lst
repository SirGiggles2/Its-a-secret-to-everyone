                            	  1816: UpdateStatues:
                            	  1817:     ; If person fireballs are enabled (from the two fires), then
                            	  1818:     ; go make fireballs with pattern 2.
                            	  1819:     ;
02:000394C2 7602            	  1820:     moveq   #2,D3
02:000394C4 102C04CC        	  1821:     move.b  ($04CC,A4),D0
02:000394C8 6620            	  1822:     bne  _L_z04_UpdateStatues_Shoot
                            	  1823:     ; Else if the room layout has two or four statues that shoot fireballs,
                            	  1824:     ; then go shoot fireballs with the corresponding pattern in Y register:
                            	  1825:     ; - layout $23: pattern 1: 2 statues
                            	  1826:     ; - layout $24: pattern 0: 4 statues
                            	  1827:     ;
02:000394CA 4EB900049A4C    	  1828:     jsr     GetUniqueRoomId
02:000394D0 7601            	  1829:     moveq   #1,D3
                            	  1830: _anon_z04_30:
02:000394D2 41F9000394A4    	  1831:     lea     (StatueRoomLayouts).l,A0
02:000394D8 12303000        	  1832:     move.b  (A0,D3.W),D1
02:000394DC B001            	  1833:     cmp.b   D1,D0
02:000394DE 670A            	  1834:     beq  _L_z04_UpdateStatues_Shoot
02:000394E0 5303            	  1835:     subq.b  #1,D3
02:000394E2 6AEE            	  1836:     bpl  _anon_z04_30
02:000394E4 0A3C0001        	  1837:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000394E8 4E75            	  1838:     rts
