02:0003AFFA 41EC0350        	  5627:     lea     ($0350,A4),A0
02:0003AFFE 10303000        	  5628:     move.b  (A0,D3.W),D0
02:0003B002 0C000041        	  5629:     cmpi.b  #$41,D0
02:0003B006 66F0            	  5630:     bne  _anon_z04_80
                            	  5631:     ; I don't know why the object timer of the tail segment that will
                            	  5632:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5633:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5634:     ; there, the object timer is set to 6.
                            	  5635:     ;
02:0003B008 7011            	  5636:     moveq   #17,D0
02:0003B00A 19803029        	  5637:     move.b  D0,($29,A4,D3.W)
                            	  5638:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5639:     ; segment to the tail segment.
                            	  5640:     ;
02:0003B00E 41EC04F0        	  5641:     lea     ($04F0,A4),A0
02:0003B012 10302000        	  5642:     move.b  (A0,D2.W),D0
02:0003B016 41EC04F1        	  5643:     lea     ($04F1,A4),A0
