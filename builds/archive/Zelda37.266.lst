                            	   959: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	   960: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	   961:     move.l  D0,-(SP)
02:0002B6C8 7200            	   962:     moveq   #0,D1
02:0002B6CA 1202            	   963:     move.b  D2,D1
02:0002B6CC 2F01            	   964:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	   965:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	   966:     andi.l  #$FF,D1
02:0002B6D8 2F01            	   967:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	   968:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	   969:     addq.l  #8,SP
02:0002B6E2 201F            	   970:     move.l  (SP)+,D0
02:0002B6E4 4E75            	   971:     rts
                            	   972: 
                            	   973: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	   974: c_add_door_flags:
02:0002B6E6 4EF900000000    	   975:     jmp     z05_add_door_flags
