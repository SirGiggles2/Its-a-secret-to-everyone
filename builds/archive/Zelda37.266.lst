02:000395C6 12343002        	  1971:     move.b  ($02,A4,D3.W),D1
02:000395CA 0A3C0010        	  1972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000395CE 9101            	  1973:     subx.b  D1,D0   ; SBC $0002,Y
02:000395D0 0A3C0010        	  1974:     eori    #$10,CCR  ; restore X = 6502 C
02:000395D4 0C000018        	  1975:     cmpi.b  #$18,D0
02:000395D8 6A10            	  1976:     bpl  _anon_z04_31
02:000395DA 0C0000E8        	  1977:     cmpi.b  #$E8,D0
