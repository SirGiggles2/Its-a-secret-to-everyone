                            	  4521: InitMode13_Sub2:
02:00035392 611C            	  4522:     jsr     UpdateZeldaTextbox
02:00035394 102C00AD        	  4523:     move.b  ($00AD,A4),D0
02:00035398 670A            	  4524:     beq  _anon_z02_30
                            	  4525:     ; Set a delay of $50 frames in the next submode.
                            	  4526:     ;
02:0003539A 7050            	  4527:     moveq   #80,D0
02:0003539C 19400029        	  4528:     move.b  D0,($0029,A4)
02:000353A0 522C0013        	  4529:     addq.b  #1,($0013,A4)
                            	  4530: _anon_z02_30:
