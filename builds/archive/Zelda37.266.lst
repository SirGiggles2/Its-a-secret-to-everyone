                            	  3883:     ; Else check for all collisions.
                            	  3884:     ;
02:0003A2E2 4EB9000311CA    	  3885:     jsr     CheckMonsterCollisions
                            	  3886:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3887:     ;
02:0003A2E8 41EC0405        	  3888:     lea     ($0405,A4),A0
02:0003A2EC 10302000        	  3889:     move.b  (A0,D2.W),D0
02:0003A2F0 670A            	  3890:     beq  _anon_z04_55
02:0003A2F2 705D            	  3891:     moveq   #93,D0
02:0003A2F4 41EC034F        	  3892:     lea     ($034F,A4),A0
02:0003A2F8 11802000        	  3893:     move.b  D0,(A0,D2.W)
