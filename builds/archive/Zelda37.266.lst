02:0003E066 7400            	 12196:     moveq   #0,D2
02:0003E068 1400            	 12197:     move.b  D0,D2
                            	 12198:     ; Turn off the room brightening flag, because we're controlling it
                            	 12199:     ; here instead of in the Mode 5 object update loop.
                            	 12200:     ;
02:0003E06A 7000            	 12201:     moveq   #0,D0
02:0003E06C 1940051E        	 12202:     move.b  D0,($051E,A4)
