02:00039754 6720            	  2207:     beq  _L_z04__TryShooting_TryShootingNow
02:00039756 0C000009        	  2208:     cmpi.b  #$09,D0
02:0003975A 671A            	  2209:     beq  _L_z04__TryShooting_TryShootingNow
