02:0004BA44 660C            	  6982:     bne  _anon_z07_39
02:0004BA46 102C00AC        	  6983:     move.b  ($00AC,A4),D0
02:0004BA4A 020000C0        	  6984:     andi.b #$C0,D0
02:0004BA4E 194000AC        	  6985:     move.b  D0,($00AC,A4)
