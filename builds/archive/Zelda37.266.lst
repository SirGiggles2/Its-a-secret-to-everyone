02:0003BF86 D101            	  7801:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003BF88 41EC0394        	  7802:     lea     ($0394,A4),A0
02:0003BF8C 11802000        	  7803:     move.b  D0,(A0,D2.W)
                            	  7804:     ; Align the monster with a square horizontally.
                            	  7805:     ;
                            	  7806:     ; If in the left half of a square, align with that square.
                            	  7807:     ; If in the right half, align with the next square.
                            	  7808:     ;
02:0003BF90 10342070        	  7809:     move.b  ($70,A4,D2.W),D0
02:0003BF94 023C00EE        	  7810:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF98 123C0008        	  7811:     move.b  #$08,D1
02:0003BF9C D101            	  7812:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BF9E 020000F0        	  7813:     andi.b #$F0,D0
02:0003BFA2 19802070        	  7814:     move.b  D0,($70,A4,D2.W)
                            	  7815:     ; Align the monster with a square vertically.
                            	  7816:     ;
                            	  7817:     ; If in the top half of a square, align with that square.
                            	  7818:     ; If in the bottom half, align with the next square.
                            	  7819:     ;
02:0003BFA6 41EC0084        	  7820:     lea     ($0084,A4),A0
02:0003BFAA 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003BFAE 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BFB2 123C0008        	  7823:     move.b  #$08,D1
02:0003BFB6 D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BFB8 020000F0        	  7825:     andi.b #$F0,D0
                            	  7826:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7827:     ;
