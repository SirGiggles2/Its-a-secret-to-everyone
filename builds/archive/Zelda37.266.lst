                            	  4534: ThanksTextboxCharTransferRecTemplate:
02:000353A6 21              	  4535:     dc.b    $21, $A4, $01, $24, $FF
02:000353A7 A4
02:000353A8 01
02:000353A9 24
02:000353AA FF
                            	  4536: 
