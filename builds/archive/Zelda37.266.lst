                            	 12102:     ;
02:0003DFB6 7600            	 12103:     moveq   #0,D3
02:0003DFB8 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003DFBC 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003DFC0 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003DFC4 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003DFC8 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003DFCA 41F90003DEBC    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003DFD0 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003DFD4 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003DFD6 41F90003DEC0    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003DFDC 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003DFE0 7600            	 12118:     moveq   #0,D3
02:0003DFE2 1600            	 12119:     move.b  D0,D3
02:0003DFE4 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003DFE6 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003DFE8 41F90003DEBE    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003DFEE 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003DFF2 7600            	 12131:     moveq   #0,D3
02:0003DFF4 1600            	 12132:     move.b  D0,D3
