02:00038D2A 60000086        	   755:     jmp  ResetPushTimer
                            	   756: __far_z_04_0006:
                            	   757:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   758:     ; Get the difference in X.
                            	   759:     ;
02:00038D2E 7602            	   760:     moveq   #2,D3
02:00038D30 102C0070        	   761:     move.b  ($0070,A4),D0
02:00038D34 003C0011        	   762:     ori     #$11,CCR  ; SEC: set C+X
02:00038D38 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:00038D3C 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038D40 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:00038D42 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:00038D46 6A08            	   776:     bpl  _anon_z04_14
02:00038D48 5203            	   777:     addq.b  #1,D3
02:00038D4A 4EB90003094C    	   778:     jsr     Negate
                            	   779: _anon_z04_14:
                            	   780:     ; If the distance >= $11, then go reset the push timer and return.
                            	   781:     ;
02:00038D50 0C000011        	   782:     cmpi.b  #$11,D0
02:00038D54 6502            	   783:     bcs.s  __far_z_04_0007
02:00038D56 605A            	   784:     jmp  ResetPushTimer
                            	   785: __far_z_04_0007:
                            	   786:     ; At this point, Link is aligned with the block.
                            	   787:     ;
                            	   788:     ; If the input direction is not the required direction based on
                            	   789:     ; Link's placement; then go reset the push timer and return.
                            	   790:     ;
02:00038D58 102C03F8        	   791:     move.b  ($03F8,A4),D0
02:00038D5C 41F900038CB0    	   792:     lea     (BlockPushDirections).l,A0
02:00038D62 12303000        	   793:     move.b  (A0,D3.W),D1
02:00038D66 B001            	   794:     cmp.b   D1,D0
02:00038D68 6702            	   795:     beq.s  __far_z_04_0008
02:00038D6A 6046            	   796:     jmp  ResetPushTimer
                            	   797: __far_z_04_0008:
