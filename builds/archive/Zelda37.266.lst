                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:00042676 102C0055        	  5954:     move.b  ($0055,A4),D0
02:0004267A 19400002        	  5955:     move.b  D0,($0002,A4)
02:0004267E 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:00042682 0C000005        	  5957:     cmpi.b  #$05,D0
02:00042686 650C            	  5958:     bcs  _anon_z05_125
02:00042688 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:0004268A 7004            	  5960:     moveq   #4,D0
02:0004268C 4EB90003080A    	  5961:     jsr     PlaySample
02:00042692 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:00042694 0C000004        	  5969:     cmpi.b  #$04,D0
02:00042698 6602            	  5970:     bne  _anon_z05_126
02:0004269A 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:0004269C 0C000001        	  5973:     cmpi.b  #$01,D0
02:000426A0 6602            	  5974:     bne  _anon_z05_127
02:000426A2 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:000426A4 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:000426A8 123C0003        	  5980:     move.b  #$03,D1
02:000426AC 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000426B0 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:000426B2 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:000426B6 7600            	  5984:     moveq   #0,D3
02:000426B8 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:000426BA 102C0008        	  5992:     move.b  ($0008,A4),D0
02:000426BE 6708            	  5993:     beq  _anon_z05_128
02:000426C0 0C030005        	  5994:     cmpi.b  #$05,D3
02:000426C4 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000426C6 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:000426C8 0C030003        	  5998:     cmpi.b  #$03,D3
02:000426CC 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000426CE 5303            	  6000:     subq.b  #1,D3
