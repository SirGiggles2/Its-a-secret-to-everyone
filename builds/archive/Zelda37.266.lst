02:00032736 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003273A E14C            	   528:     lsl.w   #8,D4
02:0003273C 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003273E 48C4            	   530:     ext.l   D4
02:00032740 D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00032746 2044            	   532:     movea.l D4,A0
02:00032748 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003274C 41EC0633        	   534:     lea     ($0633,A4),A0
02:00032750 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00032754 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:00032756 1003            	   537:     move.b  D3,D0
02:00032758 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:0003275A 19430016        	   539:     move.b  D3,($0016,A4)
02:0003275E 6100E134        	   540:     jsr     FetchFileAAddressSet
02:00032762 61001C26        	   541:     jsr     FormatFileA
02:00032766 7000            	   542:     moveq   #0,D0
02:00032768 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:0003276C 6100E126        	   550:     jsr     FetchFileAAddressSet
02:00032770 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00032772 7600            	   552:     moveq   #0,D3
02:00032774 1600            	   553:     move.b  D0,D3
                            	   554:     even
