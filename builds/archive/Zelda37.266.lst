                            	   699:     even
                            	   700: _L_z05_ScrollWorld_LimitLow:
                            	   701:     ; Don't let the scroll position go above $2100, the bottom of
                            	   702:     ; the status bar; nor below $2800, the top of NT 2.
02:0003F1F4 522C0058        	   703:     addq.b  #1,($0058,A4)
                            	   704:     even
