02:0003BF2C 41EC0084        	  7769:     lea     ($0084,A4),A0
02:0003BF30 10302000        	  7770:     move.b  (A0,D2.W),D0
02:0003BF34 41EC042C        	  7771:     lea     ($042C,A4),A0
02:0003BF38 12302000        	  7772:     move.b  (A0,D2.W),D1
02:0003BF3C B001            	  7773:     cmp.b   D1,D0
02:0003BF3E 65000096        	  7774:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7775:     ; Else reached the destination. Go to state 0.
