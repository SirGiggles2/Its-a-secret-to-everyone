02:0004B166 00000020        	  5695:     ori.b #$20,D0
02:0004B16A 194000AC        	  5696:     move.b  D0,($00AC,A4)
                            	  5697:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5698:     ; up the new state.
                            	  5699:     ;
02:0004B16E 7001            	  5700:     moveq   #1,D0
02:0004B170 194003D0        	  5701:     move.b  D0,($03D0,A4)
