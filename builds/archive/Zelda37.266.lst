                            	  3829: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  3830:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  3831:     ;   full heart=4 partial heart=$70
                            	  3832:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  3833:     ; But the method here yields $3EF, because partial heart is
                            	  3834:     ; considered full when = $FF instead of $100.
                            	  3835:     ;
02:00031370 102C000E        	  3836:     move.b  ($000E,A4),D0
02:00031374 003C0011        	  3837:     ori     #$11,CCR  ; SEC: set C+X
02:00031378 122C0670        	  3838:     move.b  ($0670,A4),D1
02:0003137C 0A3C0010        	  3839:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031380 9101            	  3840:     subx.b  D1,D0   ; SBC HeartPartial
02:00031382 0A3C0010        	  3841:     eori    #$10,CCR  ; restore X = 6502 C
02:00031386 1940000E        	  3842:     move.b  D0,($000E,A4)
02:0003138A 102C066F        	  3843:     move.b  ($066F,A4),D0
02:0003138E 0200000F        	  3844:     andi.b #$0F,D0
02:00031392 6710            	  3845:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00031394 532C066F        	  3846:     subq.b  #1,($066F,A4)
