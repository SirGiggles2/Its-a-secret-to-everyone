02:00038CD8 600000D8        	   719:     jmp  ResetPushTimer
                            	   720: __far_z_04_0005:
                            	   721:     ; If Link's X is aligned with the block's, then get the difference
                            	   722:     ; between Link's (Y + 3) and the block's Y.
                            	   723:     ; Then go test the difference.
                            	   724:     ;
02:00038CDC 102C0070        	   725:     move.b  ($0070,A4),D0
02:00038CE0 12342070        	   726:     move.b  ($70,A4,D2.W),D1
02:00038CE4 B001            	   727:     cmp.b   D1,D0
02:00038CE6 6628            	   728:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00038CE8 7600            	   729:     moveq   #0,D3
02:00038CEA 102C0084        	   730:     move.b  ($0084,A4),D0
02:00038CEE 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038CF2 123C0003        	   732:     move.b  #$03,D1
02:00038CF6 D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038CF8 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:00038CFC 41EC0084        	   735:     lea     ($0084,A4),A0
02:00038D00 12302000        	   736:     move.b  (A0,D2.W),D1
02:00038D04 0A3C0010        	   737:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038D08 9101            	   738:     subx.b  D1,D0   ; SBC ObjY,X
02:00038D0A 0A3C0010        	   739:     eori    #$10,CCR  ; restore X = 6502 C
02:00038D0E 6036            	   740:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   741: 
                            	   742:     even
                            	   743: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   744:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   745:     ; go reset the push timer.
                            	   746:     ;
02:00038D10 102C0084        	   747:     move.b  ($0084,A4),D0
02:00038D14 023C00EE        	   748:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D18 123C0003        	   749:     move.b  #$03,D1
02:00038D1C D101            	   750:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038D1E 41EC0084        	   751:     lea     ($0084,A4),A0
02:00038D22 12302000        	   752:     move.b  (A0,D2.W),D1
02:00038D26 B001            	   753:     cmp.b   D1,D0
