                            	  5806:     ; If the boomerang belongs to a monster, then check for
                            	  5807:     ; collision with Link.
                            	  5808:     ;
                            	  5809:     ; If they collide, then set state $20 and animation counter 3.
                            	  5810:     ;
02:0004B258 0C02000D        	  5811:     cmpi.b  #$0D,D2
