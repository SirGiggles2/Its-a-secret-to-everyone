                            	  7029: Dodongo_CheckBombHit:
                            	  7030:     ; If state <> 0 (not moving), then return.
                            	  7031:     ;
02:0003BA16 41EC00AC        	  7032:     lea     ($00AC,A4),A0
02:0003BA1A 10302000        	  7033:     move.b  (A0,D2.W),D0
02:0003BA1E 66000086        	  7034:     bne  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7035:     ; If facing vertically, then store (X + 8) in [00].
                            	  7036:     ; Else store (X + $10).
                            	  7037:     ;
02:0003BA22 10342070        	  7038:     move.b  ($70,A4,D2.W),D0
02:0003BA26 023C00EE        	  7039:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BA2A 123C0008        	  7040:     move.b  #$08,D1
02:0003BA2E D101            	  7041:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BA30 7600            	  7042:     moveq   #0,D3
02:0003BA32 41EC0098        	  7043:     lea     ($0098,A4),A0
02:0003BA36 16302000        	  7044:     move.b  (A0,D2.W),D3
02:0003BA3A 0C030004        	  7045:     cmpi.b  #$04,D3
02:0003BA3E 6406            	  7046:     bcc  _anon_z04_91
02:0003BA40 123C0008        	  7047:     move.b  #$08,D1
02:0003BA44 D101            	  7048:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7049: _anon_z04_91:
02:0003BA46 1880            	  7050:     move.b  D0,($0000,A4)
                            	  7051:     ; Store (Y + 8) in [01].
                            	  7052:     ;
02:0003BA48 41EC0084        	  7053:     lea     ($0084,A4),A0
02:0003BA4C 10302000        	  7054:     move.b  (A0,D2.W),D0
02:0003BA50 123C0008        	  7055:     move.b  #$08,D1
02:0003BA54 D101            	  7056:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BA56 19400001        	  7057:     move.b  D0,($0001,A4)
                            	  7058:     ; Only check the first bomb slot ($10).
                            	  7059:     ;
                            	  7060:     ; Store the bomb's (X + 8) in [02].
                            	  7061:     ;
02:0003BA5A 7610            	  7062:     moveq   #16,D3
02:0003BA5C 10343070        	  7063:     move.b  ($70,A4,D3.W),D0
02:0003BA60 123C0008        	  7064:     move.b  #$08,D1
02:0003BA64 D101            	  7065:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BA66 19400002        	  7066:     move.b  D0,($0002,A4)
                            	  7067:     ; Store the bomb's (Y + 8) in [03].
                            	  7068:     ;
02:0003BA6A 41EC0084        	  7069:     lea     ($0084,A4),A0
02:0003BA6E 10303000        	  7070:     move.b  (A0,D3.W),D0
02:0003BA72 123C0008        	  7071:     move.b  #$08,D1
02:0003BA76 D101            	  7072:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003BA78 19400003        	  7073:     move.b  D0,($0003,A4)
                            	  7074:     ; But, if there's no bomb, then return.
                            	  7075:     ;
02:0003BA7C 41EC00AC        	  7076:     lea     ($00AC,A4),A0
02:0003BA80 10303000        	  7077:     move.b  (A0,D3.W),D0
02:0003BA84 6720            	  7078:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7079:     ; If the bomb has not exploded (state $12), then
                            	  7080:     ; go see if Dodongo will eat it.
                            	  7081:     ;
02:0003BA86 0C000012        	  7082:     cmpi.b  #$12,D0
02:0003BA8A 6602            	  7083:     bne.s  __far_z_04_0065
02:0003BA8C 601A            	  7084:     jmp  Dodongo_TryEatBomb
                            	  7085: __far_z_04_0065:
                            	  7086:     ; If the object in the slot is actually a fire, then return.
                            	  7087:     ;
02:0003BA8E 0C000020        	  7088:     cmpi.b  #$20,D0
02:0003BA92 6412            	  7089:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7090:     ; The bomb already blew up.
                            	  7091:     ; If the dust cloud is in range of the monster,
