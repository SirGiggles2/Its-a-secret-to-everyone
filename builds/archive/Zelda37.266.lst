02:00039E86 02000002        	  3238:     andi.b #$02,D0
02:00039E8A 6704            	  3239:     beq  _anon_z04_45
02:00039E8C 163C00D8        	  3240:     move.b  #$D8,D3
                            	  3241: _anon_z04_45:
02:00039E90 1883            	  3242:     move.b  D3,($0000,A4)
                            	  3243:     ; [01] holds Link's X coordinate.
                            	  3244:     ;
02:00039E92 102C0070        	  3245:     move.b  ($0070,A4),D0
02:00039E96 19400001        	  3246:     move.b  D0,($0001,A4)
                            	  3247:     ; Add Link's X and the horizontal offset.
                            	  3248:     ;
02:00039E9A 023C00EE        	  3249:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E9E 1214            	  3250:     move.b  ($0000,A4),D1
02:00039EA0 D101            	  3251:     addx.b  D1,D0   ; ADC $00
                            	  3252:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  3253:     ;
02:00039EA2 020000F8        	  3254:     andi.b #$F8,D0
                            	  3255:     ; Assign that result to the leever's X coordinate and [02].
                            	  3256:     ;
