                            	  2837: _L_z04_Jumper_AnimateAndCheckCollisions_DrawBoulder:
                            	  2838:     ; Draw a boulder.
                            	  2839:     ;
02:00039B7C 7006            	  2840:     moveq   #6,D0
02:00039B7E 4EB90004B9EA    	  2841:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:00039B84 41EC03E4        	  2842:     lea     ($03E4,A4),A0
02:00039B88 10302000        	  2843:     move.b  (A0,D2.W),D0
02:00039B8C 610005BE        	  2844:     jsr     DrawObjectNotMirroredAndCheckLinkCollision
                            	  2845:     ; If the boulder's Y < $F0, return.
                            	  2846:     ;
02:00039B90 41EC0084        	  2847:     lea     ($0084,A4),A0
02:00039B94 10302000        	  2848:     move.b  (A0,D2.W),D0
02:00039B98 0C0000F0        	  2849:     cmpi.b  #$F0,D0
02:00039B9C 6402            	  2850:     bcc.s  __far_z_04_0024
02:00039B9E 6032            	  2851:     jmp  L10A10_Exit
                            	  2852: __far_z_04_0024:
                            	  2853:     ; Else the boulder is close enough to the bottom of the screen
                            	  2854:     ; to destroy it.
                            	  2855:     ;
02:00039BA0 532C0515        	  2856:     subq.b  #1,($0515,A4)
02:00039BA4 4EF90004C1CC    	  2857:     jmp     DestroyMonster
                            	  2858: 
                            	  2859: ; Returns:
                            	  2860: ; Y: 0: blue tektite
                            	  2861: ;    1: red tektite
                            	  2862: ;    2: boulder
                            	  2863: ;
                            	  2864:     even
                            	  2865: Jumper_GetKind:
02:00039BAA 41EC034F        	  2866:     lea     ($034F,A4),A0
02:00039BAE 10302000        	  2867:     move.b  (A0,D2.W),D0
02:00039BB2 003C0011        	  2868:     ori     #$11,CCR  ; SEC: set C+X
02:00039BB6 123C000D        	  2869:     move.b  #$0D,D1
02:00039BBA 0A3C0010        	  2870:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039BBE 9101            	  2871:     subx.b  D1,D0   ; SBC #$0D
02:00039BC0 0A3C0010        	  2872:     eori    #$10,CCR  ; restore X = 6502 C
02:00039BC4 7600            	  2873:     moveq   #0,D3
02:00039BC6 1600            	  2874:     move.b  D0,D3
02:00039BC8 0C030002        	  2875:     cmpi.b  #$02,D3
02:00039BCC 6402            	  2876:     bcc.s  __far_z_04_0025
02:00039BCE 6002            	  2877:     jmp  L10A10_Exit
