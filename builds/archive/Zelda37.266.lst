                            	  1330: SummonWhirlwind:
                            	  1331:     ; If not in mode 5, return.
                            	  1332:     ;
02:0003015E 102C0012        	  1333:     move.b  ($0012,A4),D0
02:00030162 0C000005        	  1334:     cmpi.b  #$05,D0
02:00030166 6704            	  1335:     beq.s  __far_z_01_0000
02:00030168 60000080        	  1336:     jmp  L6104_Exit
                            	  1337: __far_z_01_0000:
                            	  1338:     ; Advance the teleporting index, and store the mask for its level in [00].
                            	  1339:     ;
02:0003016C 6178            	  1340:     jsr     AdvanceTeleportingLevelIndex
02:0003016E 102C0523        	  1341:     move.b  ($0523,A4),D0
02:00030172 02000007        	  1342:     andi.b #$07,D0
02:00030176 7600            	  1343:     moveq   #0,D3
02:00030178 1600            	  1344:     move.b  D0,D3
02:0003017A 41F900049782    	  1345:     lea     (LevelMasks).l,A0
02:00030180 10303000        	  1346:     move.b  (A0,D3.W),D0
02:00030184 1880            	  1347:     move.b  D0,($0000,A4)
                            	  1348:     even
                            	  1349: _L_z01_SummonWhirlwind_LoopTriforcePiece:
                            	  1350:     ; If there are no triforce pieces, then return.
                            	  1351:     ;
02:00030186 102C0671        	  1352:     move.b  ($0671,A4),D0
02:0003018A 6602            	  1353:     bne.s  __far_z_01_0001
02:0003018C 605C            	  1354:     jmp  L6104_Exit
                            	  1355: __far_z_01_0001:
                            	  1356:     ; If we have gotten this triforce piece, then go try to make a
                            	  1357:     ; whirlwind.
                            	  1358:     ;
02:0003018E 1214            	  1359:     move.b  ($0000,A4),D1
02:00030190 C200            	  1360:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:00030192 662C            	  1361:     bne  _L_z01_SummonWhirlwind_MakeWhirlwind
                            	  1362:     ; We have not gotten this piece.
                            	  1363:     ; First, advance the teleporting index again.
                            	  1364:     ;
02:00030194 6150            	  1365:     jsr     AdvanceTeleportingLevelIndex
                            	  1366:     ; If the direction Link is facing is an increasing one, then
                            	  1367:     ; rotate the level mask in [00] left to correspond to the higher
                            	  1368:     ; level number. Then go test this new mask.
                            	  1369:     ;
02:00030196 102C0098        	  1370:     move.b  ($0098,A4),D0
02:0003019A 02000009        	  1371:     andi.b #$09,D0
02:0003019E 6710            	  1372:     beq  _L_z01_SummonWhirlwind_DecreasingDir
02:000301A0 1214            	  1373:     move.b  ($0000,A4),D1
02:000301A2 E309            	  1374:     lsl.b  #1,D1   ; ASL $00
02:000301A4 1881            	  1375:     move.b  D1,($0000,A4)
02:000301A6 64DE            	  1376:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:000301A8 1214            	  1377:     move.b  ($0000,A4),D1
02:000301AA E311            	  1378:     roxl.b  #1,D1   ; ROL $00
02:000301AC 1881            	  1379:     move.b  D1,($0000,A4)
02:000301AE 60D6            	  1380:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1381: 
                            	  1382:     even
                            	  1383: _L_z01_SummonWhirlwind_DecreasingDir:
                            	  1384:     ; If instead the direction is a decreasing one, then
                            	  1385:     ; rotate right to correspond to the lower level number.
                            	  1386:     ; Then go test this new mask.
                            	  1387:     ;
02:000301B0 1214            	  1388:     move.b  ($0000,A4),D1
02:000301B2 E209            	  1389:     lsr.b  #1,D1   ; LSR $00
02:000301B4 1881            	  1390:     move.b  D1,($0000,A4)
02:000301B6 64CE            	  1391:     bcc  _L_z01_SummonWhirlwind_LoopTriforcePiece
02:000301B8 1214            	  1392:     move.b  ($0000,A4),D1
02:000301BA E211            	  1393:     roxr.b  #1,D1   ; ROR $00
02:000301BC 1881            	  1394:     move.b  D1,($0000,A4)
02:000301BE 60C6            	  1395:     jmp     _L_z01_SummonWhirlwind_LoopTriforcePiece
                            	  1396: 
                            	  1397:     even
                            	  1398: _L_z01_SummonWhirlwind_MakeWhirlwind:
                            	  1399:     ; If already summoned or in the middle of teleporting, then
                            	  1400:     ; return and don't summon another one.
                            	  1401:     ;
02:000301C0 102C0508        	  1402:     move.b  ($0508,A4),D0
02:000301C4 122C0522        	  1403:     move.b  ($0522,A4),D1
02:000301C8 8001            	  1404:     or.b  D1,D0
02:000301CA 6702            	  1405:     beq.s  __far_z_01_0002
02:000301CC 601C            	  1406:     jmp  L6104_Exit
                            	  1407: __far_z_01_0002:
                            	  1408:     ; Return if we can't find an empty monster slot.
                            	  1409:     ;
02:000301CE 4EB90004C1D8    	  1410:     jsr     FindEmptyMonsterSlot
02:000301D4 6602            	  1411:     bne.s  __far_z_01_0003
02:000301D6 6012            	  1412:     jmp  L6104_Exit
                            	  1413: __far_z_01_0003:
                            	  1414:     ; An empty slot was found. Flag that summoned the whirlwind.
                            	  1415:     ; Switch to the empty slot, and go set up a whirlwind object.
                            	  1416:     ;
02:000301D8 522C0508        	  1417:     addq.b  #1,($0508,A4)
02:000301DC 1003            	  1418:     move.b  D3,D0
02:000301DE 7400            	  1419:     moveq   #0,D2
02:000301E0 1400            	  1420:     move.b  D0,D2
02:000301E2 6000FE9C        	  1421:     jmp     SetUpWhirlwind
                            	  1422: 
