                            	  2863: Link_FilterInput:
                            	  2864:     ; [00] holds the opposite of Link's facing direction.
                            	  2865:     ;
02:000406A6 102C0098        	  2866:     move.b  ($0098,A4),D0
02:000406AA 4EB900030944    	  2867:     jsr     GetOppositeDir
02:000406B0 1880            	  2868:     move.b  D0,($0000,A4)
                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:000406B2 4EB900030944    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:000406B8 102C0070        	  2879:     move.b  ($0070,A4),D0
02:000406BC 0C030002        	  2880:     cmpi.b  #$02,D3
02:000406C0 6404            	  2881:     bcc  _anon_z05_74
02:000406C2 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:000406C6 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:000406CA 1003            	  2887:     move.b  D3,D0
02:000406CC 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:000406CE 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:000406D2 123C0008        	  2890:     move.b  #$08,D1
02:000406D6 D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000406D8 7600            	  2892:     moveq   #0,D3
02:000406DA 1600            	  2893:     move.b  D0,D3
02:000406DC 103C0080        	  2894:     move.b  #$80,D0
02:000406E0 6134            	  2895:     jsr     MaskInputInBorder
02:000406E2 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:000406E4 7600            	  2897:     moveq   #0,D3
02:000406E6 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:000406E8 102C0001        	  2902:     move.b  ($0001,A4),D0
02:000406EC 0C0000FF        	  2903:     cmpi.b  #$FF,D0
02:000406F0 660C            	  2904:     bne  _anon_z05_75
02:000406F2 102C0098        	  2905:     move.b  ($0098,A4),D0
02:000406F6 1880            	  2906:     move.b  D0,($0000,A4)
02:000406F8 4EB900030944    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
02:000406FE 102C0010        	  2914:     move.b  ($0010,A4),D0
02:00040702 6710            	  2915:     beq  _anon_z05_76
02:00040704 1003            	  2916:     move.b  D3,D0
02:00040706 023C00EE        	  2917:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004070A 123C0004        	  2918:     move.b  #$04,D1
02:0004070E D101            	  2919:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00040710 7600            	  2920:     moveq   #0,D3
02:00040712 1600            	  2921:     move.b  D0,D3
                            	  2922: _anon_z05_76:
                            	  2923:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2924:     ;
02:00040714 7000            	  2925:     moveq   #0,D0
                            	  2926: ; Params:
                            	  2927: ; A: mask of buttons to block
                            	  2928: ; Y: offset into BorderBounds
                            	  2929: ; [00]: direction
                            	  2930: ; [02]: coordinate
                            	  2931: ;
                            	  2932: ; Returns:
                            	  2933: ; [01]: button mask that was used
                            	  2934: ;       (set to $FF if boundary not crossed)
                            	  2935: ;
                            	  2936:     even
                            	  2937: MaskInputInBorder:
02:00040716 19400001        	  2938:     move.b  D0,($0001,A4)
                            	  2939:     ; If direction is positive (right or down), then go handle it separately.
                            	  2940:     ;
02:0004071A 1014            	  2941:     move.b  ($0000,A4),D0
02:0004071C 0200000A        	  2942:     andi.b #$0A,D0
02:00040720 6748            	  2943:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2944:     ; The direction is negative (left or up).
                            	  2945:     ;
                            	  2946:     ; If the coordinate does not cross (<) the boundary, then
                            	  2947:     ; go set mask $FF, so that no button is excluded.
                            	  2948:     ;
02:00040722 102C0002        	  2949:     move.b  ($0002,A4),D0
02:00040726 41F90004069A    	  2950:     lea     (BorderBounds).l,A0
02:0004072C 12303000        	  2951:     move.b  (A0,D3.W),D1
02:00040730 B001            	  2952:     cmp.b   D1,D0
02:00040732 6548            	  2953:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2954:     even
                            	  2955: _L_z05_MaskInputInBorder_MaskButtons:
                            	  2956:     ; The boundary was crossed. Mask buttons.
                            	  2957:     ;
02:00040734 102C00F8        	  2958:     move.b  ($00F8,A4),D0
02:00040738 122C0001        	  2959:     move.b  ($0001,A4),D1
02:0004073C C001            	  2960:     and.b  D1,D0
02:0004073E 194000F8        	  2961:     move.b  D0,($00F8,A4)
                            	  2962:     ; If in OW or button mask <> 0, return.
                            	  2963:     ;
02:00040742 102C0010        	  2964:     move.b  ($0010,A4),D0
02:00040746 6720            	  2965:     beq  _L_z05_MaskInputInBorder_Exit
02:00040748 102C0001        	  2966:     move.b  ($0001,A4),D0
02:0004074C 661A            	  2967:     bne  _L_z05_MaskInputInBorder_Exit
                            	  2968:     ; Mask off input directions perpendicular to player's facing.
                            	  2969:     ;
02:0004074E 760C            	  2970:     moveq   #12,D3
02:00040750 102C0098        	  2971:     move.b  ($0098,A4),D0
02:00040754 0200000C        	  2972:     andi.b #$0C,D0
02:00040758 6602            	  2973:     bne  _anon_z05_77
02:0004075A 7603            	  2974:     moveq   #3,D3
                            	  2975: _anon_z05_77:
02:0004075C 1003            	  2976:     move.b  D3,D0
02:0004075E 122C03F8        	  2977:     move.b  ($03F8,A4),D1
02:00040762 C001            	  2978:     and.b  D1,D0
02:00040764 194003F8        	  2979:     move.b  D0,($03F8,A4)
                            	  2980:     even
                            	  2981: _L_z05_MaskInputInBorder_Exit:
02:00040768 4E75            	  2982:     rts
                            	  2983: 
                            	  2984:     even
                            	  2985: _L_z05_MaskInputInBorder_PositiveDir:
                            	  2986:     ; The direction is positive.
                            	  2987:     ;
                            	  2988:     ; If the coordinate crosses (<) the boundary, then
                            	  2989:     ; go mask buttons.
                            	  2990:     ;
                            	  2991:     ;
                            	  2992:     ; Get coordinate in [02].
02:0004076A 102C0002        	  2993:     move.b  ($0002,A4),D0
02:0004076E 41F90004069A    	  2994:     lea     (BorderBounds).l,A0
02:00040774 12303000        	  2995:     move.b  (A0,D3.W),D1
02:00040778 B001            	  2996:     cmp.b   D1,D0
02:0004077A 65B8            	  2997:     bcs  _L_z05_MaskInputInBorder_MaskButtons
                            	  2998:     even
                            	  2999: _L_z05_MaskInputInBorder_ExcludeNone:
                            	  3000:     ; The coordinate is not crossed; then set mask $FF,
                            	  3001:     ; so that no button is excluded.
                            	  3002:     ;
02:0004077C 103C00FF        	  3003:     move.b  #$FF,D0
02:00040780 19400001        	  3004:     move.b  D0,($0001,A4)
                            	  3005:     even
