02:0003EF6A 023C00EE        	   373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF6E 1214            	   374:     move.b  ($0000,A4),D1
02:0003EF70 D101            	   375:     addx.b  D1,D0   ; ADC $00
02:0003EF72 023C00EE        	   376:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003EF76 123C0062        	   377:     move.b  #$62,D1
02:0003EF7A D101            	   378:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:0003EF7C 19400253        	   379:     move.b  D0,($0253,A4)
