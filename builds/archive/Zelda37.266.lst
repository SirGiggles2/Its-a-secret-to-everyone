02:00040E4A B001            	  4029:     cmp.b   D1,D0
02:00040E4C 6510            	  4030:     bcs  _anon_z05_95
02:00040E4E 41F900040E10    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:00040E54 12303000        	  4032:     move.b  (A0,D3.W),D1
02:00040E58 B001            	  4033:     cmp.b   D1,D0
