02:0003E05A 6644            	 12188:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	 12189:     ; Once the timer expires, it's time to brighten the room.
                            	 12190:     ;
                            	 12191:     ; Save the current object slot.
02:0003E05C 1002            	 12192:     move.b  D2,D0
02:0003E05E 1B00            	 12193:     move.b  D0,-(A5)  ; PHA
02:0003E060 610007F0        	 12194:     jsr     UpdateCandle
