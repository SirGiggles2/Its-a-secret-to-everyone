02:0003A22E 41EC03F8        	  3786:     lea     ($03F8,A4),A0
02:0003A232 11802000        	  3787:     move.b  D0,(A0,D2.W)
02:0003A236 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003A23A 11802000        	  3789:     move.b  D0,(A0,D2.W)
                            	  3790:     ; Every other frame, return without drawing.
