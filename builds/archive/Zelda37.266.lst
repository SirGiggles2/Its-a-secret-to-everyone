                            	 12744:     ; Bottom of the part loop.
                            	 12745:     ;
02:0003E43C 7600            	 12746:     moveq   #0,D3
02:0003E43E 1600            	 12747:     move.b  D0,D3
02:0003E440 5303            	 12748:     subq.b  #1,D3
02:0003E442 6A88            	 12749:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003E444 4E75            	 12750:     rts
