02:0003152C 41EC04F0        	  4170:     lea     ($04F0,A4),A0
02:00031530 10302000        	  4171:     move.b  (A0,D2.W),D0
02:00031534 6656            	  4172:     bne  _L_z01_BeginShove_Exit2
                            	  4173:     ; If the monster is not a Gohma, then go store the shove direction.
