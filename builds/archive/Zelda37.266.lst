                            	  6848: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6849:     ; Bloated timer =>
                            	  6850:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6851:     ; 1:     go advance the substate
