02:0003958E 41F9000394B2    	  1947:     lea     (StatueXs).l,A0
02:00039594 10303000        	  1948:     move.b  (A0,D3.W),D0
02:00039598 19400002        	  1949:     move.b  D0,($0002,A4)
02:0003959C 19802070        	  1950:     move.b  D0,($70,A4,D2.W)
                            	  1951:     ; Look up and set the Y coordinate for the fireball object.
                            	  1952:     ; Also store it in [03].
                            	  1953:     ;
02:000395A0 41F9000394BA    	  1954:     lea     (StatueYs).l,A0
02:000395A6 10303000        	  1955:     move.b  (A0,D3.W),D0
02:000395AA 19400003        	  1956:     move.b  D0,($0003,A4)
02:000395AE 41EC0084        	  1957:     lea     ($0084,A4),A0
02:000395B2 11802000        	  1958:     move.b  D0,(A0,D2.W)
                            	  1959:     ; Set mask value 3 in [04].
