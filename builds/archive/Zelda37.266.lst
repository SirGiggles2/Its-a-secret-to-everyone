02:0003A4CE 4600            	  4180:     eori.b #$FF,D0
02:0003A4D0 023C00EE        	  4181:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A4D4 123C0001        	  4182:     move.b  #$01,D1
02:0003A4D8 D101            	  4183:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4184:     even
