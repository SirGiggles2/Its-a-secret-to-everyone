02:000309D8 0C030012        	  2689:     cmpi.b  #$12,D3
02:000309DC 6706            	  2690:     beq  _anon_z01_55
02:000309DE 0C03000D        	  2691:     cmpi.b  #$0D,D3
02:000309E2 6606            	  2692:     bne  _L_z01_UpdateBombFlashEffect_Exit
