                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:00042548 102C0006        	  5777:     move.b  ($0006,A4),D0
02:0004254C 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:00042550 1014            	  5783:     move.b  ($0000,A4),D0
02:00042552 41EC0302        	  5784:     lea     ($0302,A4),A0
02:00042556 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:0004255A 5202            	  5786:     addq.b  #1,D2
02:0004255C 102C0001        	  5787:     move.b  ($0001,A4),D0
02:00042560 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00042564 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:00042568 5202            	  5790:     addq.b  #1,D2
02:0004256A 102C0006        	  5791:     move.b  ($0006,A4),D0
02:0004256E 41EC0302        	  5792:     lea     ($0302,A4),A0
02:00042572 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:00042576 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:00042578 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:0004257C 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:0004257E 7020            	  5803:     moveq   #32,D0
02:00042580 122C0001        	  5804:     move.b  ($0001,A4),D1
02:00042584 8001            	  5805:     or.b  D1,D0
02:00042586 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:0004258A 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:0004258E 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:00042590 103C00FF        	  5815:     move.b  #$FF,D0
02:00042594 41EC0302        	  5816:     lea     ($0302,A4),A0
02:00042598 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:0004259C 1002            	  5818:     move.b  D2,D0
02:0004259E 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:000425A2 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:000425A6 102C0054        	  5829:     move.b  ($0054,A4),D0
02:000425AA 02000003        	  5830:     andi.b #$03,D0
02:000425AE 6708            	  5831:     beq  _anon_z05_122
02:000425B0 7008            	  5832:     moveq   #8,D0
02:000425B2 19400027        	  5833:     move.b  D0,($0027,A4)
02:000425B6 4E75            	  5834:     rts
