02:0004B224 41EC03D0        	  5789:     lea     ($03D0,A4),A0
02:0004B228 11802000        	  5790:     move.b  D0,(A0,D2.W)
02:0004B22C 41EC00AC        	  5791:     lea     ($00AC,A4),A0
02:0004B230 52302000        	  5792:     addq.b  #1,(A0,D2.W)
02:0004B234 41EC00AC        	  5793:     lea     ($00AC,A4),A0
02:0004B238 10302000        	  5794:     move.b  (A0,D2.W),D0
02:0004B23C 02000077        	  5795:     andi.b #$77,D0
02:0004B240 41EC00AC        	  5796:     lea     ($00AC,A4),A0
02:0004B244 11802000        	  5797:     move.b  D0,(A0,D2.W)
02:0004B248 0C02000D        	  5798:     cmpi.b  #$0D,D2
02:0004B24C 6402            	  5799:     bcc.s  __far_z_07_0087
02:0004B24E 6032            	  5800:     jmp  CalcBoomerangFrame
                            	  5801: __far_z_07_0087:
