                            	   823: 
                            	   824: ;------------------------------------------------------------------------------
                            	   825: ; _c_move_object_shim — MoveObject trampoline.
                            	   826: ;
                            	   827: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   828: ;   Input:     D2 = slot (0..11)
                            	   829: ;   Preserves: D2, A4, A5
                            	   830: ;   Clobbers:  D0, D1, D3, A0
                            	   831: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   832: ;
                            	   833: ; GCC side:
                            	   834: ;   void c_move_object(unsigned short slot);
                            	   835: ;     slot arrives as a 16-bit value on the stack.
                            	   836: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   837: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   838: ;   never clobbered by gcc.
                            	   839: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   840: ;   semantics can exist in a pure C port).
                            	   841: ;------------------------------------------------------------------------------
                            	   842: _c_move_object_shim:
                            	   843:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   844:     move.b  #$AA,($0900,A4)
                            	   845:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   846:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   847:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   848:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   849:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   850:     moveq   #0,D0
02:0002B658 3002            	   851:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   852:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   853:     jsr     c_move_object
02:0002B662 588F            	   854:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   855:     rts
                            	   856: 
                            	   857: ;==============================================================================
                            	   858: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   859: ; and tail-call the native asm function.
                            	   860: ;
                            	   861: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   862: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   863: ; sign-extended).
                            	   864: ;==============================================================================
                            	   865: 
                            	   866: ;------------------------------------------------------------------------------
                            	   867: ; void c_copy_bank_to_window(unsigned int bank);
                            	   868: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   869: ;------------------------------------------------------------------------------
                            	   870: c_copy_bank_to_window:
02:0002B666 202F0004        	   871:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   872:     jmp     _copy_bank_to_window
                            	   873: 
                            	   874: ;------------------------------------------------------------------------------
                            	   875: ; unsigned char c_ppu_read_2(void);
                            	   876: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   877: ; C return: gcc expects result in D0.
                            	   878: ;------------------------------------------------------------------------------
                            	   879: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   880:     jmp     _ppu_read_2
                            	   881: 
                            	   882: ;------------------------------------------------------------------------------
                            	   883: ; void c_ppu_write_6(unsigned int val);
                            	   884: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   885: ;------------------------------------------------------------------------------
                            	   886: c_ppu_write_6:
02:0002B674 202F0004        	   887:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   888:     jmp     _ppu_write_6
                            	   889: 
                            	   890: ;------------------------------------------------------------------------------
                            	   891: ; void c_ppu_write_7(unsigned int val);
                            	   892: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   893: ;------------------------------------------------------------------------------
                            	   894: c_ppu_write_7:
02:0002B67E 202F0004        	   895:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   896:     jmp     _ppu_write_7
                            	   897: 
                            	   898: ;------------------------------------------------------------------------------
                            	   899: ; void c_turn_off_all_video(void);
                            	   900: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   901: ;------------------------------------------------------------------------------
                            	   902: c_turn_off_all_video:
02:0002B688 4EF90004962E    	   903:     jmp     TurnOffAllVideo
