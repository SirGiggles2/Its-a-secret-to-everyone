02:0004BE74 162C0525        	  7377:     move.b  ($0525,A4),D3
02:0004BE78 0243000F        	  7378:     andi.w  #$000F,D3
02:0004BE7C C6FC002C        	  7379:     mulu.w  #44,D3
02:0004BE80 203C00FF6530    	  7380:     move.l  #$FF6530,D0
02:0004BE86 D083            	  7381:     add.l   D3,D0
02:0004BE88 7600            	  7382:     moveq   #0,D3
02:0004BE8A 162C0525        	  7383:     move.b  ($0525,A4),D3
02:0004BE8E E84B            	  7384:     lsr.w   #4,D3
02:0004BE90 5943            	  7385:     subi.w  #4,D3
02:0004BE92 E34B            	  7386:     lsl.w   #1,D3
02:0004BE94 D083            	  7387:     add.l   D3,D0
