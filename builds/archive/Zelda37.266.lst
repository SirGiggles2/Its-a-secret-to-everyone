                            	  6251: Digdogger_Move:
                            	  6252:     ; This calculation is the same one used in Manhandla to
                            	  6253:     ; manifest the fractional speed over several frames.
                            	  6254:     ;
                            	  6255:     ; To summarize, the formula is:
                            	  6256:     ;
                            	  6257:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6258:     ;
                            	  6259:     ;   SA := SA + (SL AND $E0)
                            	  6260:     ;   [03] := SH + carry
                            	  6261:     ;
                            	  6262:     ; See 04:A28E Manhandla_Move.
                            	  6263:     ;
02:0003B440 41EC041F        	  6264:     lea     ($041F,A4),A0
02:0003B444 10302000        	  6265:     move.b  (A0,D2.W),D0
02:0003B448 020000E0        	  6266:     andi.b #$E0,D0
02:0003B44C 023C00EE        	  6267:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B450 41EC0412        	  6268:     lea     ($0412,A4),A0
02:0003B454 12302000        	  6269:     move.b  (A0,D2.W),D1
02:0003B458 D101            	  6270:     addx.b  D1,D0   ; ADC $0412,X
02:0003B45A 41EC0412        	  6271:     lea     ($0412,A4),A0
02:0003B45E 11802000        	  6272:     move.b  D0,(A0,D2.W)
                            	  6273:     ; Assign (high speed byte + carry) to [03].
                            	  6274:     ;
02:0003B462 41EC042C        	  6275:     lea     ($042C,A4),A0
02:0003B466 10302000        	  6276:     move.b  (A0,D2.W),D0
02:0003B46A 123C0000        	  6277:     move.b  #$00,D1
02:0003B46E D101            	  6278:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003B470 19400003        	  6279:     move.b  D0,($0003,A4)
                            	  6280:     ; Change coordinates by the speed amount/offset in [03]
                            	  6281:     ; according to the direction.
                            	  6282:     ;
                            	  6283:     ; Start with a mask of $A1 in [02]:
                            	  6284:     ; - low nibble represents the right direction
                            	  6285:     ; - high nibble is used to set or clear carry as we go along
                            	  6286:     ;
02:0003B474 103C00A1        	  6287:     move.b  #$A1,D0
02:0003B478 19400002        	  6288:     move.b  D0,($0002,A4)
                            	  6289:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6290:     ;
02:0003B47C 41EC0098        	  6291:     lea     ($0098,A4),A0
02:0003B480 10302000        	  6292:     move.b  (A0,D2.W),D0
02:0003B484 122C0002        	  6293:     move.b  ($0002,A4),D1
02:0003B488 C200            	  6294:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B48A 6712            	  6295:     beq  _L_z04_Digdogger_Move_Left
02:0003B48C 10342070        	  6296:     move.b  ($70,A4,D2.W),D0
02:0003B490 023C00EE        	  6297:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B494 122C0003        	  6298:     move.b  ($0003,A4),D1
02:0003B498 D101            	  6299:     addx.b  D1,D0   ; ADC $03
02:0003B49A 19802070        	  6300:     move.b  D0,($70,A4,D2.W)
                            	  6301:     even
