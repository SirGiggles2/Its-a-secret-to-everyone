02:0003954A 7600            	  1911:     moveq   #0,D3
02:0003954C 1600            	  1912:     move.b  D0,D3
02:0003954E 41F9000394AA    	  1913:     lea     (StatueFireballStartTimes).l,A0
02:00039554 10303000        	  1914:     move.b  (A0,D3.W),D0
