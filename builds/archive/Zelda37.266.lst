                            	  5179: UpdateBoomerangOrFood:
                            	  5180:     ; If state = 0, then not active. So, return.
                            	  5181:     ;
02:0004AE06 41EC00AC        	  5182:     lea     ($00AC,A4),A0
02:0004AE0A 10302000        	  5183:     move.b  (A0,D2.W),D0
02:0004AE0E 6602            	  5184:     bne.s  __far_z_07_0078
