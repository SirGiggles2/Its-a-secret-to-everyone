02:0003EF52 0A3C0010        	   352:     eori    #$10,CCR  ; restore X = 6502 C
02:0003EF56 E308            	   353:     lsl.b  #1,D0   ; ASL A
02:0003EF58 E308            	   354:     lsl.b  #1,D0   ; ASL A
