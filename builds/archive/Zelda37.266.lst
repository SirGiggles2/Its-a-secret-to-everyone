                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:0003F0D4 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:0003F0D6 7400            	   545:     moveq   #0,D2
02:0003F0D8 41F90003F08C    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0003F0DE 14303000        	   547:     move.b  (A0,D3.W),D2
02:0003F0E2 41F90003F0BC    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0003F0E8 10303000        	   549:     move.b  (A0,D3.W),D0
02:0003F0EC 41F9000460E4    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003F0F2 11802000        	   551:     move.b  D0,(A0,D2.W)
02:0003F0F6 5303            	   552:     subq.b  #1,D3
02:0003F0F8 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0003F0FA 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0003F0FC 7001            	   561:     moveq   #1,D0
02:0003F0FE 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0003F102 7003            	   569:     moveq   #3,D0
02:0003F104 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:0003F108 7400            	   576:     moveq   #0,D2
02:0003F10A 41F90003F08C    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0003F110 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
02:0003F114 102C0006        	   585:     move.b  ($0006,A4),D0
02:0003F118 122C0671        	   586:     move.b  ($0671,A4),D1
02:0003F11C C200            	   587:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F11E 6730            	   588:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   589:     ; We have the triforce piece.
                            	   590:     ;
                            	   591:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   592:     ; then make it $F5. These are tiles that were half full, and now
                            	   593:     ; need to be full.
                            	   594:     ;
                            	   595:     ; Else replace it with the one at the current triforce tile slot
                            	   596:     ; in the replacement list.
                            	   597:     ;
02:0003F120 41F9000460E4    	   598:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003F126 10302000        	   599:     move.b  (A0,D2.W),D0
02:0003F12A 0C0000E5        	   600:     cmpi.b  #$E5,D0
02:0003F12E 6712            	   601:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003F130 0C0000E6        	   602:     cmpi.b  #$E6,D0
02:0003F134 670C            	   603:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:0003F136 41F90003F0A4    	   604:     lea     (TriforceTriforceBufReplacements).l,A0
02:0003F13C 10303000        	   605:     move.b  (A0,D3.W),D0
02:0003F140 6004            	   606:     jmp     _anon_z05_7
                            	   607: 
                            	   608:     even
                            	   609: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:0003F142 103C00F5        	   610:     move.b  #$F5,D0
                            	   611: _anon_z05_7:
02:0003F146 41F9000460E4    	   612:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003F14C 11802000        	   613:     move.b  D0,(A0,D2.W)
                            	   614:     even
                            	   615: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   616:     ; Bottom of the inner loop.
                            	   617:     ;
                            	   618:     ; Increment the triforce tile slot.
                            	   619:     ; Decrement [07] and loop again, if it's not 0.
                            	   620:     ;
02:0003F150 5203            	   621:     addq.b  #1,D3
02:0003F152 532C0007        	   622:     subq.b  #1,($0007,A4)
02:0003F156 66B0            	   623:     bne  _L_z05_UpdateMenuStartOW_LoopTile
                            	   624:     ; Bottom of the outer loop.
                            	   625:     ;
                            	   626:     ; Shift the level test bit [06] left to test the next level.
                            	   627:     ; When it becomes 0, we're done.
                            	   628:     ;
02:0003F158 122C0006        	   629:     move.b  ($0006,A4),D1
02:0003F15C E309            	   630:     lsl.b  #1,D1   ; ASL $06
02:0003F15E 19410006        	   631:     move.b  D1,($0006,A4)
02:0003F162 669E            	   632:     bne  _L_z05_UpdateMenuStartOW_LoopPiece
02:0003F164 522C00E1        	   633:     addq.b  #1,($00E1,A4)
02:0003F168 4E75            	   634:     rts
                            	   635: 
                            	   636:     even
                            	   637: ScrollWorld:
02:0003F16A 102C0015        	   638:     move.b  ($0015,A4),D0
                            	   639:     ; The purpose of this is to delay vertical scrolling.
                            	   640:     ; OW: once every two frames
                            	   641:     ; UW: once every four frames
                            	   642:     ; Horizontal scrolling happens every frame.
02:0003F16E 02000003        	   643:     andi.b #$03,D0
02:0003F172 7600            	   644:     moveq   #0,D3
02:0003F174 162C0010        	   645:     move.b  ($0010,A4),D3
02:0003F178 6604            	   646:     bne  _anon_z05_8
02:0003F17A 02000001        	   647:     andi.b #$01,D0
                            	   648: _anon_z05_8:
02:0003F17E 122C00E6        	   649:     move.b  ($00E6,A4),D1
02:0003F182 B001            	   650:     cmp.b   D1,D0
02:0003F184 6704            	   651:     beq.s  __far_z_05_0004
02:0003F186 600000DE        	   652:     jmp  ScrollWorldH
                            	   653: __far_z_05_0004:
02:0003F18A 7008            	   654:     moveq   #8,D0
02:0003F18C 122C0098        	   655:     move.b  ($0098,A4),D1
02:0003F190 C200            	   656:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003F192 6602            	   657:     bne.s  __far_z_05_0005
02:0003F194 606E            	   658:     jmp  ScrollWorldDownOrH
                            	   659: __far_z_05_0005:
                            	   660:     ; then scroll up.
                            	   661:     ; Scrolling up starts from the top of NT 2 at $2800.
                            	   662:     ;
02:0003F196 532C00E9        	   663:     subq.b  #1,($00E9,A4)
02:0003F19A 102C0084        	   664:     move.b  ($0084,A4),D0
02:0003F19E 0C0000DD        	   665:     cmpi.b  #$DD,D0
02:0003F1A2 640A            	   666:     bcc  _anon_z05_9
02:0003F1A4 123C0008        	   667:     move.b  #$08,D1
02:0003F1A8 D101            	   668:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003F1AA 19400084        	   669:     move.b  D0,($0084,A4)
                            	   670: _anon_z05_9:
02:0003F1AE 102C00E2        	   671:     move.b  ($00E2,A4),D0
02:0003F1B2 003C0011        	   672:     ori     #$11,CCR  ; SEC: set C+X
02:0003F1B6 123C0020        	   673:     move.b  #$20,D1
02:0003F1BA 0A3C0010        	   674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F1BE 9101            	   675:     subx.b  D1,D0   ; SBC #$20
02:0003F1C0 0A3C0010        	   676:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F1C4 194000E2        	   677:     move.b  D0,($00E2,A4)
02:0003F1C8 6404            	   678:     bcc  _anon_z05_10
02:0003F1CA 532C0058        	   679:     subq.b  #1,($0058,A4)
                            	   680: _anon_z05_10:
02:0003F1CE 0C0000E0        	   681:     cmpi.b  #$E0,D0
02:0003F1D2 661E            	   682:     bne  _L_z05_ScrollWorld_Exit
02:0003F1D4 102C0058        	   683:     move.b  ($0058,A4),D0
02:0003F1D8 0C000020        	   684:     cmpi.b  #$20,D0
02:0003F1DC 6716            	   685:     beq  _L_z05_ScrollWorld_LimitLow
02:0003F1DE 0C000027        	   686:     cmpi.b  #$27,D0
02:0003F1E2 660E            	   687:     bne  _L_z05_ScrollWorld_Exit
                            	   688:     ; VScroll address is $27E0. So, we rolled from the
                            	   689:     ; top of NT 2 to the last row of NT 0. Change the address
                            	   690:     ; to $23A0, the true last row of NT 0.
02:0003F1E4 7023            	   691:     moveq   #35,D0
02:0003F1E6 19400058        	   692:     move.b  D0,($0058,A4)
02:0003F1EA 103C00A0        	   693:     move.b  #$A0,D0
02:0003F1EE 194000E2        	   694:     move.b  D0,($00E2,A4)
                            	   695:     even
                            	   696: _L_z05_ScrollWorld_Exit:
02:0003F1F2 4E75            	   697:     rts
