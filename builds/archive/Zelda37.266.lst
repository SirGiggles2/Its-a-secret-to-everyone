                            	  6665:     ; Store it in [00].
                            	  6666:     ;
02:0003B760 10342070        	  6667:     move.b  ($70,A4,D2.W),D0
02:0003B764 023C00EE        	  6668:     andi    #$EE,CCR  ; CLC: clear C+X
