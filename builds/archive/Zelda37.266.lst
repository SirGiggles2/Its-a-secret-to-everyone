                            	  1851: UpdateTrap_Full:
02:000304F0 41EC00AC        	  1852:     lea     ($00AC,A4),A0
02:000304F4 10302000        	  1853:     move.b  (A0,D2.W),D0
02:000304F8 660000B2        	  1854:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  1855:     ; State 0. Sensing.
                            	  1856:     ;
                            	  1857:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  1858:     ; then go see if the horizontal distance is shorter.
                            	  1859:     ;
02:000304FC 102C0084        	  1860:     move.b  ($0084,A4),D0
02:00030500 003C0011        	  1861:     ori     #$11,CCR  ; SEC: set C+X
02:00030504 41EC0084        	  1862:     lea     ($0084,A4),A0
02:00030508 12302000        	  1863:     move.b  (A0,D2.W),D1
02:0003050C 0A3C0010        	  1864:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030510 9101            	  1865:     subx.b  D1,D0   ; SBC ObjY,X
02:00030512 0A3C0010        	  1866:     eori    #$10,CCR  ; restore X = 6502 C
02:00030516 61000430        	  1867:     jsr     Abs
02:0003051A 0C00000E        	  1868:     cmpi.b  #$0E,D0
02:0003051E 644C            	  1869:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1870:     ; Determine the horizontal direction toward Link;
                            	  1871:     ; and if Link and the trap are at the same X, then we can't move
                            	  1872:     ; along this axis. Go see about moving vertically.
                            	  1873:     ;
02:00030520 7601            	  1874:     moveq   #1,D3
02:00030522 102C0070        	  1875:     move.b  ($0070,A4),D0
02:00030526 12342070        	  1876:     move.b  ($70,A4,D2.W),D1
02:0003052A B001            	  1877:     cmp.b   D1,D0
02:0003052C 673E            	  1878:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:0003052E 6402            	  1879:     bcc  _anon_z01_26
02:00030530 7602            	  1880:     moveq   #2,D3
                            	  1881: _anon_z01_26:
                            	  1882:     ; Remember the original X coordinate.
                            	  1883:     ;
02:00030532 10342070        	  1884:     move.b  ($70,A4,D2.W),D0
                            	  1885:     even
                            	  1886: _L_z01_UpdateTrap_Full_GoToState1:
02:00030536 41EC0380        	  1887:     lea     ($0380,A4),A0
02:0003053A 11802000        	  1888:     move.b  D0,(A0,D2.W)
                            	  1889:     ; Set facing direction to the horizontal one that we determined.
                            	  1890:     ;
02:0003053E 1003            	  1891:     move.b  D3,D0
02:00030540 41EC0098        	  1892:     lea     ($0098,A4),A0
02:00030544 11802000        	  1893:     move.b  D0,(A0,D2.W)
                            	  1894:     ; If the direction we determined is not allowed for this trap, then
                            	  1895:     ; go draw and check collisions.
                            	  1896:     ;
02:00030548 41F9000304E9    	  1897:     lea     (TrapAllowedDirs-1).l,A0
02:0003054E 12302000        	  1898:     move.b  (A0,D2.W),D1
02:00030552 C001            	  1899:     and.b  D1,D0
02:00030554 6712            	  1900:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1901:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  1902:     ;
02:00030556 41EC00AC        	  1903:     lea     ($00AC,A4),A0
02:0003055A 52302000        	  1904:     addq.b  #1,(A0,D2.W)
02:0003055E 7070            	  1905:     moveq   #112,D0
02:00030560 41EC03BC        	  1906:     lea     ($03BC,A4),A0
02:00030564 11802000        	  1907:     move.b  D0,(A0,D2.W)
                            	  1908:     even
                            	  1909: _L_z01_UpdateTrap_Full_DrawAndCheckCollisions:
