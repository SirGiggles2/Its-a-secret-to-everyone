02:0003A3FE 102C0085        	  4076:     move.b  ($0085,A4),D0
02:0003A402 003C0011        	  4077:     ori     #$11,CCR  ; SEC: set C+X
02:0003A406 123C001C        	  4078:     move.b  #$1C,D1
02:0003A40A 0A3C0010        	  4079:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A40E 9101            	  4080:     subx.b  D1,D0   ; SBC #$1C
02:0003A410 0A3C0010        	  4081:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A414 41EC0084        	  4082:     lea     ($0084,A4),A0
02:0003A418 11802000        	  4083:     move.b  D0,(A0,D2.W)
                            	  4084:     even
                            	  4085: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  4086:     ; Decrease the angle by $00.60.
