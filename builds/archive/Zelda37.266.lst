02:0003B4A2 10302000        	  6306:     move.b  (A0,D2.W),D0
02:0003B4A6 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003B4AA E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003B4AC 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003B4B0 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003B4B4 C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003B4B6 6716            	  6312:     beq  _L_z04_Digdogger_Move_Down
02:0003B4B8 10342070        	  6313:     move.b  ($70,A4,D2.W),D0
