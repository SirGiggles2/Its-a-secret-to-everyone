                            	  7780:     ; Reset 16-bit vertical speed.
                            	  7781:     ;
02:0003BF4C 41EC0444        	  7782:     lea     ($0444,A4),A0
02:0003BF50 11802000        	  7783:     move.b  D0,(A0,D2.W)
02:0003BF54 41EC0412        	  7784:     lea     ($0412,A4),A0
02:0003BF58 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     ; Choose a random direction to face in.
                            	  7787:     ;
02:0003BF5C 10342018        	  7788:     move.b  ($18,A4,D2.W),D0
02:0003BF60 02000003        	  7789:     andi.b #$03,D0
02:0003BF64 7600            	  7790:     moveq   #0,D3
02:0003BF66 1600            	  7791:     move.b  D0,D3
02:0003BF68 41F90003BD78    	  7792:     lea     (PolsVoiceDirections).l,A0
02:0003BF6E 10303000        	  7793:     move.b  (A0,D3.W),D0
02:0003BF72 41EC0098        	  7794:     lea     ($0098,A4),A0
02:0003BF76 11802000        	  7795:     move.b  D0,(A0,D2.W)
                            	  7796:     ; Randomly set distance-to-move to $30 or $70.
