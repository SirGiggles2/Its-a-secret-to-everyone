02:0004B178 41EC00AC        	  5706:     lea     ($00AC,A4),A0
02:0004B17C 11803000        	  5707:     move.b  D0,(A0,D3.W)
02:0004B180 0A3C0001        	  5708:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004B184 4E75            	  5709:     rts
                            	  5710: 
                            	  5711:     even
