02:0002B710 7000            	  1005:     moveq   #0,D0
02:0002B712 3002            	  1006:     move.w  D2,D0
02:0002B714 2F00            	  1007:     move.l  D0,-(SP)
02:0002B716 4EB900000000    	  1008:     jsr     z05_set_door_flag
02:0002B71C 588F            	  1009:     addq.l  #4,SP
02:0002B71E 4E75            	  1010:     rts
