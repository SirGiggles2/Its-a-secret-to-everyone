02:00039476 0200000F        	  1765:     andi.b #$0F,D0
02:0003947A 023C00EE        	  1766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003947E 6608            	  1767:     bne  _L_z04_Gel_MoveSplitting_Exit
