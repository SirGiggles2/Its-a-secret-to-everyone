                            	  1920:     ; Add it to the fireball index in X register to get the index of
                            	  1921:     ; the coordinate we want within each coordinate list.
                            	  1922:     ;
                            	  1923:     ;
                            	  1924:     ; Pattern
02:00039560 7600            	  1925:     moveq   #0,D3
02:00039562 162C000B        	  1926:     move.b  ($000B,A4),D3
02:00039566 1002            	  1927:     move.b  D2,D0
02:00039568 023C00EE        	  1928:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003956C 41F9000394AE    	  1929:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00039572 12303000        	  1930:     move.b  (A0,D3.W),D1
02:00039576 D101            	  1931:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:00039578 7600            	  1932:     moveq   #0,D3
02:0003957A 1600            	  1933:     move.b  D0,D3
02:0003957C 1002            	  1934:     move.b  D2,D0
02:0003957E 1B00            	  1935:     move.b  D0,-(A5)  ; PHA
