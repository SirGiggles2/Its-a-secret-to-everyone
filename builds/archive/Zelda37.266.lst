                            	  7769: Submenu_CueTransferRowOW:
                            	  7770:     ;
                            	  7771:     ;
                            	  7772:     ; If menu scroll value is negative, then we transferred everything.
                            	  7773:     ; So, return.
                            	  7774:     ;
02:000438F0 102C005E        	  7775:     move.b  ($005E,A4),D0
02:000438F4 6A02            	  7776:     bpl.s  __far_z_05_0086
