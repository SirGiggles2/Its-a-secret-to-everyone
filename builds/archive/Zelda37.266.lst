                            	  9573: UpdateGohma:
                            	  9574:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9575:     ;
02:0003CCD0 41EC0451        	  9576:     lea     ($0451,A4),A0
02:0003CCD4 10302000        	  9577:     move.b  (A0,D2.W),D0
02:0003CCD8 662C            	  9578:     bne  _L_z04_UpdateGohma_Move
                            	  9579:     ; If Random:
                            	  9580:     ;   >= $B0: right
                            	  9581:     ;   >= $60: left
                            	  9582:     ;   Else:   down
                            	  9583:     ;
02:0003CCDA 7001            	  9584:     moveq   #1,D0
02:0003CCDC 7600            	  9585:     moveq   #0,D3
02:0003CCDE 16342018        	  9586:     move.b  ($18,A4,D2.W),D3
02:0003CCE2 0C0300B0        	  9587:     cmpi.b  #$B0,D3
02:0003CCE6 640A            	  9588:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003CCE8 E308            	  9589:     lsl.b  #1,D0   ; ASL A
02:0003CCEA 0C030060        	  9590:     cmpi.b  #$60,D3
02:0003CCEE 6402            	  9591:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003CCF0 E308            	  9592:     lsl.b  #1,D0   ; ASL A
                            	  9593:     even
                            	  9594: _L_z04_UpdateGohma_ChangeDir:
