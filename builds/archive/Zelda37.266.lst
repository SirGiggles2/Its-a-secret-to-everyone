02:000396F6 10342028        	  2152:     move.b  ($28,A4,D2.W),D0
02:000396FA 0C0000FD        	  2153:     cmpi.b  #$FD,D0
02:000396FE 660C            	  2154:     bne  _L_z04_UpdateZora_DestroyWhenDone
