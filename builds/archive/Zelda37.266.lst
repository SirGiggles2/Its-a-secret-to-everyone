                            	   947: 
                            	   948: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   949: c_has_compass:
02:0002B6B2 4EB900000000    	   950:     jsr     z05_has_compass
02:0002B6B8 4A00            	   951:     tst.b   D0
02:0002B6BA 4E75            	   952:     rts
                            	   953: 
                            	   954: c_has_map:
02:0002B6BC 4EB900000000    	   955:     jsr     z05_has_map
02:0002B6C2 4A00            	   956:     tst.b   D0
02:0002B6C4 4E75            	   957:     rts
