02:0002B724 2F00            	  1016:     move.l  D0,-(SP)
02:0002B726 4EB900000000    	  1017:     jsr     z05_reset_door_flag
02:0002B72C 588F            	  1018:     addq.l  #4,SP
02:0002B72E 4E75            	  1019:     rts
