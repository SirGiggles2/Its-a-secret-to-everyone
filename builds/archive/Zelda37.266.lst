02:000357CE 41F900035742    	  5057:     lea     (CreditsLastVscrollList).l,A0
02:000357D4 12303000        	  5058:     move.b  (A0,D3.W),D1
02:000357D8 B001            	  5059:     cmp.b   D1,D0
02:000357DA 650A            	  5060:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
