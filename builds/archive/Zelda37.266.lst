                            	  6643: Aquamentus_Draw:
                            	  6644:     ; Every $10 screen frames, switch animation frames.
                            	  6645:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6646:     ; The last tile of frame 0 is at index 5.
                            	  6647:     ; The last tile of frame 1 is at index $B.
                            	  6648:     ;
02:0003B742 7605            	  6649:     moveq   #5,D3
02:0003B744 102C0015        	  6650:     move.b  ($0015,A4),D0
02:0003B748 02000010        	  6651:     andi.b #$10,D0
02:0003B74C 6602            	  6652:     bne  _anon_z04_88
