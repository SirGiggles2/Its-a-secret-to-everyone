02:00039CC2 123C0001        	  3006:     move.b  #$01,D1
02:00039CC6 D101            	  3007:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00039CC8 0C000006        	  3008:     cmpi.b  #$06,D0
02:00039CCC 6502            	  3009:     bcs  _anon_z04_41
