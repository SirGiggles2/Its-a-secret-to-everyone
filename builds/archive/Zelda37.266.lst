                            	  7305: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7306:     ; If the "monsters from edges" long timer expired, then
                            	  7307:     ; go bring the monster in.
                            	  7308:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7309:     ;
                            	  7310:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7311:     ; residual position so enemies keep their previous-room
                            	  7312:     ; positions instead of being re-edge-spawned (matches NES).
02:0004BDEE 102C004B        	  7313:     move.b  ($004B,A4),D0
02:0004BDF2 662E            	  7314:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7315:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004BDF4 102C000F        	  7316:     move.b  ($000F,A4),D0
02:0004BDF8 0C0000FF        	  7317:     cmpi.b  #$FF,D0
02:0004BDFC 662E            	  7318:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004BDFE 41EC0070        	  7319:     lea     ($0070,A4),A0
02:0004BE02 10302000        	  7320:     move.b  (A0,D2.W),D0
02:0004BE06 660A            	  7321:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004BE08 41EC0084        	  7322:     lea     ($0084,A4),A0
02:0004BE0C 10302000        	  7323:     move.b  (A0,D2.W),D0
02:0004BE10 671A            	  7324:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7325:     even
