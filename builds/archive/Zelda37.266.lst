                            	  4868: UpdatePeaceTextbox:
                            	  4869:     ; Only emit a character once every 8 frames --
                            	  4870:     ; when (counter [0412] MOD 8) = 4.
                            	  4871:     ;
02:0003565A 522C0412        	  4872:     addq.b  #1,($0412,A4)
02:0003565E 102C0412        	  4873:     move.b  ($0412,A4),D0
02:00035662 02000007        	  4874:     andi.b #$07,D0
02:00035666 0C000004        	  4875:     cmpi.b  #$04,D0
02:0003566A 665C            	  4876:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4877:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4878:     ; to the dynamic transfer buf.
                            	  4879:     ;
02:0003566C 7604            	  4880:     moveq   #4,D3
                            	  4881: _anon_z02_35:
02:0003566E 41F9000355EA    	  4882:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:00035674 10303000        	  4883:     move.b  (A0,D3.W),D0
02:00035678 41EC0302        	  4884:     lea     ($0302,A4),A0
02:0003567C 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:00035680 5303            	  4886:     subq.b  #1,D3
02:00035682 6AEA            	  4887:     bpl  _anon_z02_35
                            	  4888:     ; Load a character from the string and copy it to
                            	  4889:     ; the transfer record until we read character $FF.
                            	  4890:     ;
02:00035684 7600            	  4891:     moveq   #0,D3
02:00035686 162C0413        	  4892:     move.b  ($0413,A4),D3
02:0003568A 41F900035624    	  4893:     lea     (PeaceText).l,A0
02:00035690 10303000        	  4894:     move.b  (A0,D3.W),D0
02:00035694 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:00035698 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:0003569A 19400305        	  4897:     move.b  D0,($0305,A4)
                            	  4898:     ; A regular space takes as much time to emit as any character.
                            	  4899:     ; But it makes no sound.
                            	  4900:     ;
02:0003569E 0C000024        	  4901:     cmpi.b  #$24,D0
02:000356A2 6706            	  4902:     beq  _anon_z02_36
02:000356A4 7010            	  4903:     moveq   #16,D0
02:000356A6 19400604        	  4904:     move.b  D0,($0604,A4)
                            	  4905: _anon_z02_36:
                            	  4906:     ; Point to the next character in the string.
                            	  4907:     ;
02:000356AA 522C0413        	  4908:     addq.b  #1,($0413,A4)
                            	  4909:     ; Replace the low byte of the VRAM address with the one
                            	  4910:     ; where the next character should be written.
                            	  4911:     ;
02:000356AE 41F9000355F0    	  4912:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000356B4 10303000        	  4913:     move.b  (A0,D3.W),D0
02:000356B8 19400303        	  4914:     move.b  D0,($0303,A4)
                            	  4915:     ; Once the low VRAM address rolls over,
                            	  4916:     ; increment the high address.
                            	  4917:     ;
02:000356BC 0C0000A0        	  4918:     cmpi.b  #$A0,D0
02:000356C0 6406            	  4919:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:000356C2 7023            	  4920:     moveq   #35,D0
