                            	  1913: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1914:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1915:     ; then this trap definitely wasn't triggered.
                            	  1916:     ; Go draw and check collisions.
                            	  1917:     ;
02:0003056C 102C0070        	  1918:     move.b  ($0070,A4),D0
02:00030570 003C0011        	  1919:     ori     #$11,CCR  ; SEC: set C+X
02:00030574 12342070        	  1920:     move.b  ($70,A4,D2.W),D1
02:00030578 0A3C0010        	  1921:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003057C 9101            	  1922:     subx.b  D1,D0   ; SBC ObjX,X
02:0003057E 0A3C0010        	  1923:     eori    #$10,CCR  ; restore X = 6502 C
02:00030582 610003C4        	  1924:     jsr     Abs
02:00030586 0C00000E        	  1925:     cmpi.b  #$0E,D0
02:0003058A 64DC            	  1926:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1927:     ; Determine the vertical direction toward Link;
                            	  1928:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1929:     ; along this axis. Go draw and check object collisions.
                            	  1930:     ;
02:0003058C 7604            	  1931:     moveq   #4,D3
02:0003058E 102C0084        	  1932:     move.b  ($0084,A4),D0
02:00030592 41EC0084        	  1933:     lea     ($0084,A4),A0
02:00030596 12302000        	  1934:     move.b  (A0,D2.W),D1
02:0003059A B001            	  1935:     cmp.b   D1,D0
02:0003059C 67CA            	  1936:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:0003059E 6402            	  1937:     bcc  _anon_z01_27
02:000305A0 7608            	  1938:     moveq   #8,D3
                            	  1939: _anon_z01_27:
                            	  1940:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  1941:     ; set the vertical direction we determined, and other preparations.
                            	  1942:     ;
02:000305A2 41EC0084        	  1943:     lea     ($0084,A4),A0
02:000305A6 10302000        	  1944:     move.b  (A0,D2.W),D0
02:000305AA 668A            	  1945:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  1946:     even
                            	  1947: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  1948:     ; State 1 and 2.
                            	  1949:     ;
                            	  1950:     ; Move in the direction it's facing.
                            	  1951:     ;
02:000305AC 41EC0098        	  1952:     lea     ($0098,A4),A0
02:000305B0 10302000        	  1953:     move.b  (A0,D2.W),D0
02:000305B4 1940000F        	  1954:     move.b  D0,($000F,A4)
02:000305B8 4EB90004A678    	  1955:     jsr     MoveObject
                            	  1956:     ; Truncate the grid offset to square length ($10).
                            	  1957:     ;
02:000305BE 41EC0394        	  1958:     lea     ($0394,A4),A0
02:000305C2 10302000        	  1959:     move.b  (A0,D2.W),D0
02:000305C6 0200000F        	  1960:     andi.b #$0F,D0
02:000305CA 6608            	  1961:     bne  _anon_z01_28
02:000305CC 41EC0394        	  1962:     lea     ($0394,A4),A0
02:000305D0 11802000        	  1963:     move.b  D0,(A0,D2.W)
                            	  1964: _anon_z01_28:
                            	  1965:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  1966:     ;
02:000305D4 61000CF6        	  1967:     jsr     CheckLinkCollision
                            	  1968:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  1969:     ; and current coordinate to the trap's X.
                            	  1970:     ;
02:000305D8 7600            	  1971:     moveq   #0,D3
02:000305DA 16342070        	  1972:     move.b  ($70,A4,D2.W),D3
02:000305DE 7078            	  1973:     moveq   #120,D0
02:000305E0 1880            	  1974:     move.b  D0,($0000,A4)
02:000305E2 41EC0098        	  1975:     lea     ($0098,A4),A0
02:000305E6 10302000        	  1976:     move.b  (A0,D2.W),D0
02:000305EA 0200000C        	  1977:     andi.b #$0C,D0
02:000305EE 6710            	  1978:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  1979:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  1980:     ; and current coordinate to the trap's Y.
                            	  1981:     ;
