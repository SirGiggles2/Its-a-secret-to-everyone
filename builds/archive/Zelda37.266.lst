                            	  3829: __far_z_04_0033:
                            	  3830:     ; Animate.
                            	  3831:     ;
                            	  3832:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3833:     ; then only go draw.
                            	  3834:     ;
02:0003A286 41EC03D0        	  3835:     lea     ($03D0,A4),A0
02:0003A28A 53302000        	  3836:     subq.b  #1,(A0,D2.W)
02:0003A28E 6702            	  3837:     beq.s  __far_z_04_0034
02:0003A290 601E            	  3838:     jmp  DrawArmosAndCheckCollisions
                            	  3839: __far_z_04_0034:
                            	  3840:     ; Armos animation frames last 6 screen frames.
                            	  3841:     ;
02:0003A292 7006            	  3842:     moveq   #6,D0
02:0003A294 41EC03D0        	  3843:     lea     ($03D0,A4),A0
02:0003A298 11802000        	  3844:     move.b  D0,(A0,D2.W)
                            	  3845:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3846:     ; change the position of the shield. To keep fixed it in place,
                            	  3847:     ; there are separate frame images for each animation frame.
                            	  3848:     ;
                            	  3849:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3850:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3851:     ;
                            	  3852:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3853:     ; Then choose the direction at the point of drawing below.
                            	  3854:     ;
02:0003A29C 41EC03E4        	  3855:     lea     ($03E4,A4),A0
02:0003A2A0 10302000        	  3856:     move.b  (A0,D2.W),D0
02:0003A2A4 0A000002        	  3857:     eori.b #$02,D0
02:0003A2A8 41EC03E4        	  3858:     lea     ($03E4,A4),A0
02:0003A2AC 11802000        	  3859:     move.b  D0,(A0,D2.W)
                            	  3860:     even
                            	  3861: DrawArmosAndCheckCollisions:
02:0003A2B0 4EB90004B9F0    	  3862:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003A2B6 7600            	  3863:     moveq   #0,D3
02:0003A2B8 41EC0098        	  3864:     lea     ($0098,A4),A0
02:0003A2BC 16302000        	  3865:     move.b  (A0,D2.W),D3
                            	  3866:     ; If facing up, then use the second frame image in the set ("back").
                            	  3867:     ; Else use the second.
                            	  3868:     ;
02:0003A2C0 0C030008        	  3869:     cmpi.b  #$08,D3
02:0003A2C4 6602            	  3870:     bne  _anon_z04_54
02:0003A2C6 7001            	  3871:     moveq   #1,D0
                            	  3872: _anon_z04_54:
02:0003A2C8 023C00EE        	  3873:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2CC 41EC03E4        	  3874:     lea     ($03E4,A4),A0
02:0003A2D0 12302000        	  3875:     move.b  (A0,D2.W),D1
02:0003A2D4 D101            	  3876:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003A2D6 4EB900030E4E    	  3877:     jsr     DrawObjectNotMirrored
                            	  3878:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3879:     ; but not with weapons.
                            	  3880:     ;
