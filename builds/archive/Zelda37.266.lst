                            	  2811:     ; Draw a tektite.
                            	  2812:     ;
                            	  2813:     ; If state = 1, then go draw frame image 1, and check collisions.
                            	  2814:     ;
02:00039B52 41EC00AC        	  2815:     lea     ($00AC,A4),A0
02:00039B56 10302000        	  2816:     move.b  (A0,D2.W),D0
02:00039B5A 661C            	  2817:     bne  _L_z04_Jumper_AnimateAndCheckCollisions_DrawTektite
                            	  2818:     ; If object timer < $21, go draw frame image 0, and check collisions.
                            	  2819:     ;
