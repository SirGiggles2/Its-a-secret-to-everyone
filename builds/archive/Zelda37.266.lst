02:0003CE6E 41EC0478        	  9789:     lea     ($0478,A4),A0
02:0003CE72 11802000        	  9790:     move.b  D0,(A0,D2.W)
02:0003CE76 41EC046B        	  9791:     lea     ($046B,A4),A0
02:0003CE7A 10302000        	  9792:     move.b  (A0,D2.W),D0
