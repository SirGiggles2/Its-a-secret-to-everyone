02:000357A6 7400            	  5039:     moveq   #0,D2
02:000357A8 142C0016        	  5040:     move.b  ($0016,A4),D2
02:000357AC 41EC062D        	  5041:     lea     ($062D,A4),A0
02:000357B0 10302000        	  5042:     move.b  (A0,D2.W),D0
02:000357B4 6702            	  5043:     beq  _anon_z02_40
02:000357B6 5203            	  5044:     addq.b  #1,D3
