02:0004B270 41EC03D0        	  5821:     lea     ($03D0,A4),A0
02:0004B274 11802000        	  5822:     move.b  D0,(A0,D2.W)
02:0004B278 7020            	  5823:     moveq   #32,D0
02:0004B27A 41EC00AC        	  5824:     lea     ($00AC,A4),A0
