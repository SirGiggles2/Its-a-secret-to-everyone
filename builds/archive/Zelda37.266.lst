                            	  2824:     ; Else cycle the animation counter, draw, and check collisions.
                            	  2825:     ;
                            	  2826:     ; The movement frame determines the frame image.
                            	  2827:     ;
02:00039B68 7010            	  2828:     moveq   #16,D0
02:00039B6A 4EB90004B9EA    	  2829:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:00039B70 41EC03E4        	  2830:     lea     ($03E4,A4),A0
02:00039B74 10302000        	  2831:     move.b  (A0,D2.W),D0
                            	  2832:     even
