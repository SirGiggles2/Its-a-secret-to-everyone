                            	  4159:     ;
02:00031512 41EC04BF        	  4160:     lea     ($04BF,A4),A0
02:00031516 10302000        	  4161:     move.b  (A0,D2.W),D0
02:0003151A 02000080        	  4162:     andi.b #$80,D0
02:0003151E 670C            	  4163:     beq  _anon_z01_102
02:00031520 102C0008        	  4164:     move.b  ($0008,A4),D0
02:00031524 00000040        	  4165:     ori.b #$40,D0
