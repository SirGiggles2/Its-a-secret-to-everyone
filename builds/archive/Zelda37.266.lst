                            	  6820:     ; If X coordinate < $20, then face right.
                            	  6821:     ;
02:0003B88E 0C000020        	  6822:     cmpi.b  #$20,D0
02:0003B892 640A            	  6823:     bcc  _anon_z04_89
02:0003B894 7001            	  6824:     moveq   #1,D0
02:0003B896 41EC0098        	  6825:     lea     ($0098,A4),A0
02:0003B89A 11802000        	  6826:     move.b  D0,(A0,D2.W)
