02:0003A246 41EC034F        	  3797:     lea     ($034F,A4),A0
02:0003A24A 10302000        	  3798:     move.b  (A0,D2.W),D0
02:0003A24E 0C000022        	  3799:     cmpi.b  #$22,D0
