                            	  2888: Jumper_MoveY:
02:00039BDA 1880            	  2889:     move.b  D0,($0000,A4)
02:00039BDC 19430002        	  2890:     move.b  D3,($0002,A4)
                            	  2891:     ; Add the high speed byte to the Y coordinate.
                            	  2892:     ;
02:00039BE0 41EC0412        	  2893:     lea     ($0412,A4),A0
02:00039BE4 10302000        	  2894:     move.b  (A0,D2.W),D0
02:00039BE8 41EC0084        	  2895:     lea     ($0084,A4),A0
02:00039BEC 12302000        	  2896:     move.b  (A0,D2.W),D1
02:00039BF0 D101            	  2897:     addx.b  D1,D0   ; ADC ObjY,X
02:00039BF2 41EC0084        	  2898:     lea     ($0084,A4),A0
02:00039BF6 11802000        	  2899:     move.b  D0,(A0,D2.W)
                            	  2900:     ; Add the acceleration to the speed fraction (low byte).
                            	  2901:     ;
02:00039BFA 41EC041F        	  2902:     lea     ($041F,A4),A0
02:00039BFE 10302000        	  2903:     move.b  (A0,D2.W),D0
02:00039C02 023C00EE        	  2904:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039C06 1214            	  2905:     move.b  ($0000,A4),D1
02:00039C08 D101            	  2906:     addx.b  D1,D0   ; ADC $00
02:00039C0A 41EC041F        	  2907:     lea     ($041F,A4),A0
02:00039C0E 11802000        	  2908:     move.b  D0,(A0,D2.W)
                            	  2909:     ; Carry over to the high speed byte.
                            	  2910:     ;
02:00039C12 41EC0412        	  2911:     lea     ($0412,A4),A0
02:00039C16 10302000        	  2912:     move.b  (A0,D2.W),D0
02:00039C1A 123C0000        	  2913:     move.b  #$00,D1
02:00039C1E D101            	  2914:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00039C20 41EC0412        	  2915:     lea     ($0412,A4),A0
02:00039C24 11802000        	  2916:     move.b  D0,(A0,D2.W)
                            	  2917:     ; *Signed comparison*:
                            	  2918:     ; If the high speed byte < high max speed byte, then return.
                            	  2919:     ;
                            	  2920:     ; Note that this is not a general purpose signed comparison,
                            	  2921:     ; which would be more complicated. But it works because
                            	  2922:     ; the deviation from 0 of both values is small.
