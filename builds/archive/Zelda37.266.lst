02:0002BFAC 670A            	  2387:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2388:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2389:     eori    #$01,CCR
02:0002BFB6 4E75            	  2390:     rts
                            	  2391: .cc_cnras:
02:0002BFB8 023C00FE        	  2392:     andi    #$FE,CCR
02:0002BFBC 0A3C0001        	  2393:     eori    #$01,CCR
02:0002BFC0 4E75            	  2394:     rts
