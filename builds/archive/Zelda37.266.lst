                            	  5677:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5678:     ;
02:0004B152 7000            	  5679:     moveq   #0,D0
02:0004B154 41EC0380        	  5680:     lea     ($0380,A4),A0
