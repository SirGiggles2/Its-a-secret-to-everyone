02:000425E0 19400054        	  5860:     move.b  D0,($0054,A4)
02:000425E4 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:000425E8 102C0055        	  5870:     move.b  ($0055,A4),D0
02:000425EC 19400002        	  5871:     move.b  D0,($0002,A4)
02:000425F0 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:000425F4 0C000007        	  5873:     cmpi.b  #$07,D0
02:000425F8 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:000425FA 7400            	  5879:     moveq   #0,D2
02:000425FC 142C0009        	  5880:     move.b  ($0009,A4),D2
02:00042600 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:00042604 1003            	  5884:     move.b  D3,D0
02:00042606 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004260A 41F9000424C6    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:00042610 12302000        	  5887:     move.b  (A0,D2.W),D1
02:00042614 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:00042616 7600            	  5889:     moveq   #0,D3
02:00042618 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:0004261A 1002            	  5893:     move.b  D2,D0
02:0004261C 0A000001        	  5894:     eori.b #$01,D0
02:00042620 7400            	  5895:     moveq   #0,D2
02:00042622 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00042624 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:00042626 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:0004262A 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004262E E14C            	  5902:     lsl.w   #8,D4
02:00042630 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042632 48C4            	  5904:     ext.l   D4
02:00042634 D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0004263A 2044            	  5906:     movea.l D4,A0
02:0004263C 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00042640 41F900049782    	  5908:     lea     (LevelMasks).l,A0
