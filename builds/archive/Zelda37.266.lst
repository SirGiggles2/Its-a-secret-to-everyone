                            	  7093:     ;
02:0003BA94 7600            	  7094:     moveq   #0,D3
02:0003BA96 61000082        	  7095:     jsr     Dodongo_IsBombInRange
02:0003BA9A 660A            	  7096:     bne  _L_z04_Dodongo_CheckBombHit_Exit
