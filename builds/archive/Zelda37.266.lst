                            	  6964: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6965:     ; To animate the state, the animation counter had to have
                            	  6966:     ; reached 0. Right after this routine, the counter will be
                            	  6967:     ; rolled over, and the movement frame will be switched.
                            	  6968:     ;
                            	  6969:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6970:     ; the animation here, in order to immediately change it to
                            	  6971:     ; 0 (legs apart) after this.
                            	  6972:     ;
02:0004BA38 7001            	  6973:     moveq   #1,D0
02:0004BA3A 194003E4        	  6974:     move.b  D0,($03E4,A4)
02:0004BA3E 4E75            	  6975:     rts
                            	  6976: 
                            	  6977:     even
                            	  6978: _L_z07_AnimateLinkObjState_CheckState30:
