02:00039D24 41EC034F        	  3054:     lea     ($034F,A4),A0
02:00039D28 16302000        	  3055:     move.b  (A0,D2.W),D3
02:00039D2C 0C030011        	  3056:     cmpi.b  #$11,D3
02:00039D30 6620            	  3057:     bne  _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage
02:00039D32 7600            	  3058:     moveq   #0,D3
02:00039D34 41EC00AC        	  3059:     lea     ($00AC,A4),A0
02:00039D38 16302000        	  3060:     move.b  (A0,D2.W),D3
02:00039D3C 0C030002        	  3061:     cmpi.b  #$02,D3
