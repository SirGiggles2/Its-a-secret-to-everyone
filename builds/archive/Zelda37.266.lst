02:0004ABC4 61000E2A        	  4857:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4858:     ; If the direction is horizontal, move the sprites down 3 pixels.
                            	  4859:     ;
02:0004ABC8 41EC0098        	  4860:     lea     ($0098,A4),A0
02:0004ABCC 10302000        	  4861:     move.b  (A0,D2.W),D0
02:0004ABD0 1B00            	  4862:     move.b  D0,-(A5)  ; PHA
02:0004ABD2 02000003        	  4863:     andi.b #$03,D0
02:0004ABD6 6712            	  4864:     beq  _L_z07_DrawSwordShotOrMagicShot_Flash
02:0004ABD8 102C0001        	  4865:     move.b  ($0001,A4),D0
02:0004ABDC 023C00EE        	  4866:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004ABE0 123C0003        	  4867:     move.b  #$03,D1
02:0004ABE4 D101            	  4868:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0004ABE6 19400001        	  4869:     move.b  D0,($0001,A4)
                            	  4870:     even
                            	  4871: _L_z07_DrawSwordShotOrMagicShot_Flash:
02:0004ABEA 101D            	  4872:     move.b  (A5)+,D0  ; PLA
                            	  4873:     ; Set the sprite attributes to (base attribute OR (frame counter AND 3)).
                            	  4874:     ; This makes the shot flash by cycling all the palettes, one each frame.
                            	  4875:     ;
                            	  4876:     ;
                            	  4877:     ; Call this only to get reverse direction index.
02:0004ABEC 4EB900030944    	  4878:     jsr     GetOppositeDir
02:0004ABF2 102C0015        	  4879:     move.b  ($0015,A4),D0
02:0004ABF6 02000003        	  4880:     andi.b #$03,D0
02:0004ABFA 41F90004AEB6    	  4881:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004AC00 12303000        	  4882:     move.b  (A0,D3.W),D1
02:0004AC04 8001            	  4883:     or.b  D1,D0
02:0004AC06 4EB900031140    	  4884:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4885:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
                            	  4886:     ;
02:0004AC0C 41F90004AEB2    	  4887:     lea     (RDirectionToWeaponFrame).l,A0
02:0004AC12 10303000        	  4888:     move.b  (A0,D3.W),D0
02:0004AC16 1940000C        	  4889:     move.b  D0,($000C,A4)
                            	  4890:     ; If the direction is left, flip the right facing image by setting [0F] to 1.
                            	  4891:     ;
02:0004AC1A 0C030002        	  4892:     cmpi.b  #$02,D3
02:0004AC1E 6604            	  4893:     bne  _anon_z07_24
02:0004AC20 522C000F        	  4894:     addq.b  #1,($000F,A4)
                            	  4895: _anon_z07_24:
                            	  4896:     ; If this a monster's shot, choose the item slot for drawing based on object type.
                            	  4897:     ;   $57 (sword shot) => $22
                            	  4898:     ;   other (presumably $58 or $59, magic shot) => $23
                            	  4899:     ;
02:0004AC24 7622            	  4900:     moveq   #34,D3
02:0004AC26 0C02000D        	  4901:     cmpi.b  #$0D,D2
02:0004AC2A 6410            	  4902:     bcc  _L_z07_DrawSwordShotOrMagicShot_PlayerShot
02:0004AC2C 41EC034F        	  4903:     lea     ($034F,A4),A0
02:0004AC30 10302000        	  4904:     move.b  (A0,D2.W),D0
02:0004AC34 0C000057        	  4905:     cmpi.b  #$57,D0
02:0004AC38 6710            	  4906:     beq  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
02:0004AC3A 660C            	  4907:     bne  _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites
                            	  4908:     even
                            	  4909: _L_z07_DrawSwordShotOrMagicShot_PlayerShot:
                            	  4910:     ; But if the player shot it, the choice depends on the shot's state.
                            	  4911:     ;   high bit set (magic)   => $23
                            	  4912:     ;   high bit clear (sword) => $22
                            	  4913:     ;
02:0004AC3C 41EC00AC        	  4914:     lea     ($00AC,A4),A0
02:0004AC40 10302000        	  4915:     move.b  (A0,D2.W),D0
02:0004AC44 E308            	  4916:     lsl.b  #1,D0   ; ASL A
02:0004AC46 6402            	  4917:     bcc  _L_z07_DrawSwordShotOrMagicShot_WriteSprites
                            	  4918:     even
                            	  4919: _L_z07_DrawSwordShotOrMagicShot_WriteMagicSprites:
02:0004AC48 7623            	  4920:     moveq   #35,D3
                            	  4921:     even
                            	  4922: _L_z07_DrawSwordShotOrMagicShot_WriteSprites:
02:0004AC4A 4EF900031060    	  4923:     jmp     Anim_WriteItemSprites
                            	  4924: 
                            	  4925: ; Params:
                            	  4926: ; X: shot object index
                            	  4927: ;
                            	  4928: ; If the object is a sword shot, go spread out the shot.
                            	  4929: ;
                            	  4930:     even
                            	  4931: HandleShotBlocked:
02:0004AC50 41EC00AC        	  4932:     lea     ($00AC,A4),A0
02:0004AC54 10302000        	  4933:     move.b  (A0,D2.W),D0
02:0004AC58 E308            	  4934:     lsl.b  #1,D0   ; ASL A
02:0004AC5A 6504            	  4935:     bcs.s  __far_z_07_0074
02:0004AC5C 60000082        	  4936:     jmp  SetShotSpreadingState
                            	  4937: __far_z_07_0074:
                            	  4938:     ; This is a magic shot.
                            	  4939:     ;
                            	  4940:     ; If missing the magic book, go deactivate the shot object.
                            	  4941:     ;
02:0004AC60 102C0661        	  4942:     move.b  ($0661,A4),D0
02:0004AC64 6602            	  4943:     bne.s  __far_z_07_0075
02:0004AC66 6072            	  4944:     jmp  DeactivateShot
                            	  4945: __far_z_07_0075:
                            	  4946:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4947:     ; unused, so it only has to depend on having an empty slot.
                            	  4948:     ;
                            	  4949:     ; If successful, Link's state will have been changed to "using item".
                            	  4950:     ; But we don't want that in this case.
                            	  4951:     ;
                            	  4952:     ; For both these reasons, save state and restore it afterward.
                            	  4953:     ;
02:0004AC68 102C00AC        	  4954:     move.b  ($00AC,A4),D0
02:0004AC6C 1B00            	  4955:     move.b  D0,-(A5)  ; PHA
02:0004AC6E 102C0513        	  4956:     move.b  ($0513,A4),D0
02:0004AC72 1B00            	  4957:     move.b  D0,-(A5)  ; PHA
02:0004AC74 7000            	  4958:     moveq   #0,D0
02:0004AC76 19400513        	  4959:     move.b  D0,($0513,A4)
02:0004AC7A 4EB90003099E    	  4960:     jsr     WieldCandle
02:0004AC80 101D            	  4961:     move.b  (A5)+,D0  ; PLA
02:0004AC82 19400513        	  4962:     move.b  D0,($0513,A4)
02:0004AC86 101D            	  4963:     move.b  (A5)+,D0  ; PLA
02:0004AC88 194000AC        	  4964:     move.b  D0,($00AC,A4)
                            	  4965:     ; State $21 means that a moving fire was just made.
                            	  4966:     ;
                            	  4967:     ; If it's any another value, then we didn't find an empty slot
                            	  4968:     ; to make a fire. In this case, all that's left to do is to go
                            	  4969:     ; deactivate the shot object.
                            	  4970:     ;
02:0004AC8C 41EC00AC        	  4971:     lea     ($00AC,A4),A0
02:0004AC90 10302000        	  4972:     move.b  (A0,D2.W),D0
02:0004AC94 0C000021        	  4973:     cmpi.b  #$21,D0
02:0004AC98 6702            	  4974:     beq.s  __far_z_07_0076
02:0004AC9A 6038            	  4975:     jmp  DeactivateLinkShot
                            	  4976: __far_z_07_0076:
                            	  4977:     ; Make state $22 for a standing fire.
                            	  4978:     ;
02:0004AC9C 41EC00AC        	  4979:     lea     ($00AC,A4),A0
02:0004ACA0 52302000        	  4980:     addq.b  #1,(A0,D2.W)
                            	  4981:     ; Copy the shot's position and direction to the fire.
                            	  4982:     ;
02:0004ACA4 760E            	  4983:     moveq   #14,D3
02:0004ACA6 10343070        	  4984:     move.b  ($70,A4,D3.W),D0
02:0004ACAA 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:0004ACAE 41EC0084        	  4986:     lea     ($0084,A4),A0
02:0004ACB2 10303000        	  4987:     move.b  (A0,D3.W),D0
02:0004ACB6 41EC0084        	  4988:     lea     ($0084,A4),A0
02:0004ACBA 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:0004ACBE 41EC0098        	  4990:     lea     ($0098,A4),A0
02:0004ACC2 10303000        	  4991:     move.b  (A0,D3.W),D0
02:0004ACC6 41EC0098        	  4992:     lea     ($0098,A4),A0
02:0004ACCA 11802000        	  4993:     move.b  D0,(A0,D2.W)
                            	  4994:     ; The fire lasts $4F frames.
                            	  4995:     ; Deactivate the shot.
                            	  4996:     ;
02:0004ACCE 704F            	  4997:     moveq   #79,D0
02:0004ACD0 19802028        	  4998:     move.b  D0,($28,A4,D2.W)
                            	  4999:     even
                            	  5000: DeactivateLinkShot:
02:0004ACD4 4EF90002BC8C    	  5001:     jmp     c_deactivate_link_shot
                            	  5002: 
                            	  5003: DeactivateShot:
02:0004ACDA 4EF90002BC7C    	  5004:     jmp     c_deactivate_shot
                            	  5005: 
                            	  5006: SetShotSpreadingState:
02:0004ACE0 4EF90002B8B6    	  5007:     jmp     c_set_shot_spreading_state
                            	  5008: 
                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:0004ACE6 41EC0098        	  5017:     lea     ($0098,A4),A0
02:0004ACEA 10302000        	  5018:     move.b  (A0,D2.W),D0
02:0004ACEE 19400002        	  5019:     move.b  D0,($0002,A4)
02:0004ACF2 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:0004ACF6 7000            	  5023:     moveq   #0,D0
02:0004ACF8 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:0004ACFC 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:0004ACFE 1003            	  5031:     move.b  D3,D0
02:0004AD00 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:0004AD02 102C0002        	  5035:     move.b  ($0002,A4),D0
02:0004AD06 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:0004AD08 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004AD0C 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004AD0E 102C0015        	  5046:     move.b  ($0015,A4),D0
02:0004AD12 02000003        	  5047:     andi.b #$03,D0
02:0004AD16 41F90004AB74    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004AD1C 12303000        	  5049:     move.b  (A0,D3.W),D1
02:0004AD20 8001            	  5050:     or.b  D1,D0
02:0004AD22 4EB900031140    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:0004AD28 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004AD2C 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AD30 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004AD34 D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004AD36 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:0004AD38 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004AD3C B001            	  5064:     cmp.b   D1,D0
02:0004AD3E 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004AD40 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004AD44 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004AD46 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004AD4A 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004AD4E 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004AD52 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004AD54 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:0004AD58 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:0004AD5A 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:0004AD5E 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:0004AD62 1214            	  5079:     move.b  ($0000,A4),D1
02:0004AD64 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004AD68 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004AD6A 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:0004AD6E 0C000020        	  5087:     cmpi.b  #$20,D0
02:0004AD72 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004AD74 41EC0084        	  5092:     lea     ($0084,A4),A0
02:0004AD78 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004AD7C 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AD80 122C0003        	  5095:     move.b  ($0003,A4),D1
02:0004AD84 D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:0004AD86 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:0004AD8A 7600            	  5100:     moveq   #0,D3
02:0004AD8C 162C0010        	  5101:     move.b  ($0010,A4),D3
02:0004AD90 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:0004AD92 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004AD96 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:0004AD98 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:0004AD9C 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
02:0004AD9E 7002            	  5112:     moveq   #2,D0
02:0004ADA0 1940000C        	  5113:     move.b  D0,($000C,A4)
02:0004ADA4 7623            	  5114:     moveq   #35,D3
02:0004ADA6 4EB900031060    	  5115:     jsr     Anim_WriteItemSprites
                            	  5116:     even
                            	  5117: _L_z07_SpreadShot_NextCorner:
                            	  5118:     ; Prepare to process the next corner.
                            	  5119:     ;
                            	  5120:     ; First, restore X offset [02] and Y offset [03].
                            	  5121:     ;
02:0004ADAC 101D            	  5122:     move.b  (A5)+,D0  ; PLA
02:0004ADAE 19400003        	  5123:     move.b  D0,($0003,A4)
02:0004ADB2 101D            	  5124:     move.b  (A5)+,D0  ; PLA
02:0004ADB4 19400002        	  5125:     move.b  D0,($0002,A4)
                            	  5126:     ; Take turns negating X offset or Y offset for the next round.
                            	  5127:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5128:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5129:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5130:     ; - Fourth turn: doesn't matter
                            	  5131:     ;
                            	  5132:     ;
                            	  5133:     ; Get the loop index.
02:0004ADB8 101D            	  5134:     move.b  (A5)+,D0  ; PLA
02:0004ADBA 1B00            	  5135:     move.b  D0,-(A5)  ; PHA
02:0004ADBC 7600            	  5136:     moveq   #0,D3
02:0004ADBE 1600            	  5137:     move.b  D0,D3
02:0004ADC0 0C030001        	  5138:     cmpi.b  #$01,D3
02:0004ADC4 6602            	  5139:     bne  _anon_z07_25
02:0004ADC6 7603            	  5140:     moveq   #3,D3
                            	  5141: _anon_z07_25:
02:0004ADC8 10343000        	  5142:     move.b  ($00,A4,D3.W),D0
02:0004ADCC 4600            	  5143:     eori.b #$FF,D0
02:0004ADCE 023C00EE        	  5144:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004ADD2 123C0001        	  5145:     move.b  #$01,D1
02:0004ADD6 D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004ADD8 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:0004ADDC 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:0004ADDE 7600            	  5151:     moveq   #0,D3
02:0004ADE0 1600            	  5152:     move.b  D0,D3
02:0004ADE2 5303            	  5153:     subq.b  #1,D3
02:0004ADE4 6A00FF18        	  5154:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5155:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5156:     ;
                            	  5157:     ; Decrease the base negative offset to get farther away from
                            	  5158:     ; the center point.
                            	  5159:     ;
02:0004ADE8 41EC0098        	  5160:     lea     ($0098,A4),A0
02:0004ADEC 53302000        	  5161:     subq.b  #1,(A0,D2.W)
                            	  5162:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5163:     ;
                            	  5164:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5165:     ;
02:0004ADF0 41EC0098        	  5166:     lea     ($0098,A4),A0
02:0004ADF4 10302000        	  5167:     move.b  (A0,D2.W),D0
02:0004ADF8 0C0000E8        	  5168:     cmpi.b  #$E8,D0
02:0004ADFC 6702            	  5169:     beq.s  __far_z_07_0077
02:0004ADFE 6004            	  5170:     jmp  L1F49F_Exit
                            	  5171: __far_z_07_0077:
02:0004AE00 6000FED2        	  5172:     jmp     DeactivateLinkShot
                            	  5173: 
                            	  5174:     even
