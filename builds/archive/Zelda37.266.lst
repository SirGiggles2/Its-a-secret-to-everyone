                            	  4002: BeginShove:
02:00031426 7600            	  4003:     moveq   #0,D3
02:00031428 1614            	  4004:     move.b  ($0000,A4),D3
02:0003142A 0C02000D        	  4005:     cmpi.b  #$0D,D2
02:0003142E 6412            	  4006:     bcc  _anon_z01_99
02:00031430 41EC04B2        	  4007:     lea     ($04B2,A4),A0
02:00031434 10302000        	  4008:     move.b  (A0,D2.W),D0
02:00031438 122C0009        	  4009:     move.b  ($0009,A4),D1
02:0003143C C001            	  4010:     and.b  D1,D0
02:0003143E 660000C4        	  4011:     bne  _L_z01_BeginShove_Exit
                            	  4012: _anon_z01_99:
                            	  4013:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  4014:     ; if he is defending. The goal is to push Link away from the monster.
                            	  4015:     ;
                            	  4016:     ; If instead a monster is defending, then all this calculation
                            	  4017:     ; won't matter, because the shove direction will be set to the
                            	  4018:     ; weapon's direction.
                            	  4019:     ;
                            	  4020:     ; As such, calculate a direction from the monster to the defender,
                            	  4021:     ; assuming it's Link.
                            	  4022:     ;
                            	  4023:     ; Start with an assumption that the direction is vertical:
                            	  4024:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  4025:     ;
02:00031442 7008            	  4026:     moveq   #8,D0
02:00031444 19400008        	  4027:     move.b  D0,($0008,A4)
02:00031448 41EC0084        	  4028:     lea     ($0084,A4),A0
02:0003144C 10302000        	  4029:     move.b  (A0,D2.W),D0
02:00031450 19400004        	  4030:     move.b  D0,($0004,A4)
02:00031454 41EC0084        	  4031:     lea     ($0084,A4),A0
02:00031458 10303000        	  4032:     move.b  (A0,D3.W),D0
02:0003145C 19400005        	  4033:     move.b  D0,($0005,A4)
                            	  4034:     ; If the defender is Link and his grid offset <> 0 then
                            	  4035:     ; use his usual object direction variable to determine
                            	  4036:     ; which axis to check.
                            	  4037:     ;
02:00031460 4A03            	  4038:     cmpi.b  #$00,D3
02:00031462 6612            	  4039:     bne  _anon_z01_100
02:00031464 102C0394        	  4040:     move.b  ($0394,A4),D0
02:00031468 670C            	  4041:     beq  _anon_z01_100
02:0003146A 102C0098        	  4042:     move.b  ($0098,A4),D0
02:0003146E 02000003        	  4043:     andi.b #$03,D0
02:00031472 660C            	  4044:     bne  _L_z01_BeginShove_CheckHorizontal
02:00031474 6720            	  4045:     beq  _L_z01_BeginShove_CheckVertical
                            	  4046: _anon_z01_100:
                            	  4047:     ; For monsters defending, or Link with grid offset = 0,
                            	  4048:     ; check direction in [0B].
                            	  4049:     ;
                            	  4050:     ; For monsters defending, this won't matter. For Link with grid
                            	  4051:     ; offset = 0, I believe the result will be arbitrary.
                            	  4052:     ;
                            	  4053:     ; TODO:
                            	  4054:     ; Is [0B] always set if Link's grid offset = 0?
                            	  4055:     ; It doesn't seem to be if candle fire attacks him.
                            	  4056:     ;
02:00031476 102C000B        	  4057:     move.b  ($000B,A4),D0
02:0003147A 0C000004        	  4058:     cmpi.b  #$04,D0
02:0003147E 6416            	  4059:     bcc  _L_z01_BeginShove_CheckVertical
                            	  4060:     even
                            	  4061: _L_z01_BeginShove_CheckHorizontal:
                            	  4062:     ; If the direction checked is left or right,
                            	  4063:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  4064:     ;
02:00031480 7002            	  4065:     moveq   #2,D0
02:00031482 19400008        	  4066:     move.b  D0,($0008,A4)
02:00031486 10342070        	  4067:     move.b  ($70,A4,D2.W),D0
02:0003148A 19400004        	  4068:     move.b  D0,($0004,A4)
02:0003148E 10343070        	  4069:     move.b  ($70,A4,D3.W),D0
02:00031492 19400005        	  4070:     move.b  D0,($0005,A4)
                            	  4071:     even
                            	  4072: _L_z01_BeginShove_CheckVertical:
                            	  4073:     ; If the monster is down or right of the other object,
                            	  4074:     ; then use the opposite direction already in [08].
                            	  4075:     ; Else shift [08] right to turn it into the opposite
                            	  4076:     ; direction up or down.
                            	  4077:     ;
                            	  4078:     ; Again assuming Link is the defender; after this, [08] points
                            	  4079:     ; Link away from the monster.
                            	  4080:     ;
02:00031496 102C0004        	  4081:     move.b  ($0004,A4),D0
02:0003149A 122C0005        	  4082:     move.b  ($0005,A4),D1
02:0003149E B001            	  4083:     cmp.b   D1,D0
02:000314A0 640A            	  4084:     bcc  _anon_z01_101
02:000314A2 122C0008        	  4085:     move.b  ($0008,A4),D1
02:000314A6 E209            	  4086:     lsr.b  #1,D1   ; LSR $08
02:000314A8 19410008        	  4087:     move.b  D1,($0008,A4)
                            	  4088: _anon_z01_101:
                            	  4089:     ; If a monster is the defender, go handle it separately.
                            	  4090:     ;
02:000314AC 4A03            	  4091:     cmpi.b  #$00,D3
02:000314AE 6656            	  4092:     bne  _L_z01_BeginShove_MonsterDefender
                            	  4093:     ; Link is the defender.
                            	  4094:     ;
                            	  4095:     ; If Link is invincible, return without shoving.
                            	  4096:     ;
02:000314B0 102C04F0        	  4097:     move.b  ($04F0,A4),D0
02:000314B4 664E            	  4098:     bne  _L_z01_BeginShove_Exit
                            	  4099:     ; Store the shove direction we determined.
                            	  4100:     ;
                            	  4101:     ; Turn on the high bit to indicate that the next time we try to
                            	  4102:     ; move by shoving, it will be the first time for this shove action.
                            	  4103:     ;
02:000314B6 102C0008        	  4104:     move.b  ($0008,A4),D0
02:000314BA 00000080        	  4105:     ori.b #$80,D0
02:000314BE 194000C0        	  4106:     move.b  D0,($00C0,A4)
                            	  4107:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  4108:     ;
02:000314C2 7018            	  4109:     moveq   #24,D0
02:000314C4 194004F0        	  4110:     move.b  D0,($04F0,A4)
02:000314C8 7020            	  4111:     moveq   #32,D0
02:000314CA 194000D3        	  4112:     move.b  D0,($00D3,A4)
                            	  4113:     ; If Link was shoved by one of his own weapons, then
                            	  4114:     ; nothing else to do. Return.
                            	  4115:     ;
02:000314CE 0C02000D        	  4116:     cmpi.b  #$0D,D2
02:000314D2 6430            	  4117:     bcc  _L_z01_BeginShove_Exit
                            	  4118:     ; Link was shoved by a monster.
                            	  4119:     ;
                            	  4120:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  4121:     ; then return.
                            	  4122:     ;
02:000314D4 41EC04BF        	  4123:     lea     ($04BF,A4),A0
02:000314D8 10302000        	  4124:     move.b  (A0,D2.W),D0
02:000314DC 02000080        	  4125:     andi.b #$80,D0
02:000314E0 6622            	  4126:     bne  _L_z01_BeginShove_Exit
                            	  4127:     ; If the attacker is a vire, then return.
                            	  4128:     ;
02:000314E2 41EC034F        	  4129:     lea     ($034F,A4),A0
02:000314E6 10302000        	  4130:     move.b  (A0,D2.W),D0
02:000314EA 0C000012        	  4131:     cmpi.b  #$12,D0
02:000314EE 6714            	  4132:     beq  _L_z01_BeginShove_Exit
                            	  4133:     ; Turn the attacker in the opposite direction.
                            	  4134:     ;
02:000314F0 41EC0098        	  4135:     lea     ($0098,A4),A0
02:000314F4 10302000        	  4136:     move.b  (A0,D2.W),D0
02:000314F8 6100F44A        	  4137:     jsr     GetOppositeDir
02:000314FC 41EC0098        	  4138:     lea     ($0098,A4),A0
02:00031500 11802000        	  4139:     move.b  D0,(A0,D2.W)
                            	  4140:     even
                            	  4141: _L_z01_BeginShove_Exit:
02:00031504 4E75            	  4142:     rts
                            	  4143: 
