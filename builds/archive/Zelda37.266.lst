02:0003CCF6 11802000        	  9596:     move.b  D0,(A0,D2.W)
                            	  9597:     ; Now we can go straight without changing direction for some time.
                            	  9598:     ;
02:0003CCFA 41EC0451        	  9599:     lea     ($0451,A4),A0
02:0003CCFE 52302000        	  9600:     addq.b  #1,(A0,D2.W)
                            	  9601:     ; Go animate the eye.
                            	  9602:     ;
02:0003CD02 600000C6        	  9603:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9604: 
                            	  9605:     even
                            	  9606: _L_z04_UpdateGohma_Move:
                            	  9607:     ; Add $80 to the movement accumulator.
                            	  9608:     ;
02:0003CD06 41EC041F        	  9609:     lea     ($041F,A4),A0
02:0003CD0A 10302000        	  9610:     move.b  (A0,D2.W),D0
02:0003CD0E 023C00EE        	  9611:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CD12 123C0080        	  9612:     move.b  #$80,D1
02:0003CD16 D101            	  9613:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003CD18 41EC041F        	  9614:     lea     ($041F,A4),A0
02:0003CD1C 11802000        	  9615:     move.b  D0,(A0,D2.W)
                            	  9616:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9617:     ;
02:0003CD20 640000A8        	  9618:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9619:     ; Increase the distance traveled, and move 1.
                            	  9620:     ;
02:0003CD24 41EC0412        	  9621:     lea     ($0412,A4),A0
02:0003CD28 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003CD2C 7001            	  9625:     moveq   #1,D0
02:0003CD2E 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003CD32 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003CD36 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003CD3A 122C0002        	  9631:     move.b  ($0002,A4),D1
02:0003CD3E C200            	  9632:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CD40 6704            	  9633:     beq  _anon_z04_118
02:0003CD42 52342070        	  9634:     addq.b  #1,($70,A4,D2.W)
                            	  9635: _anon_z04_118:
                            	  9636:     ; If Gohma's facing direction has a left component, then subtract 1 from X.
                            	  9637:     ;
02:0003CD46 122C0002        	  9638:     move.b  ($0002,A4),D1
02:0003CD4A E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003CD4C 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003CD50 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003CD54 C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CD56 6704            	  9643:     beq  _anon_z04_119
02:0003CD58 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
                            	  9646:     ; If Gohma's facing direction has a down component, then add 1 to Y.
                            	  9647:     ;
02:0003CD5C 122C0002        	  9648:     move.b  ($0002,A4),D1
02:0003CD60 E309            	  9649:     lsl.b  #1,D1   ; ASL $02
02:0003CD62 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003CD66 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003CD6A C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CD6C 6708            	  9653:     beq  _anon_z04_120
02:0003CD6E 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003CD72 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
                            	  9657:     ; If Gohma's facing direction has an up component, then subtract 1 from Y.
                            	  9658:     ;
02:0003CD76 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003CD7A E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003CD7C 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003CD80 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003CD84 C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003CD86 6708            	  9664:     beq  _anon_z04_121
02:0003CD88 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003CD8C 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003CD90 41EC0412        	  9670:     lea     ($0412,A4),A0
02:0003CD94 10302000        	  9671:     move.b  (A0,D2.W),D0
02:0003CD98 0C000020        	  9672:     cmpi.b  #$20,D0
02:0003CD9C 662C            	  9673:     bne  _L_z04_UpdateGohma_AnimateEye
                            	  9674:     ; Gohma has traveled $20 pixels. Reset the distance traveled.
                            	  9675:     ; Reverse the facing direction, and increase the number of sprints.
                            	  9676:     ;
02:0003CD9E 7000            	  9677:     moveq   #0,D0
02:0003CDA0 41EC0412        	  9678:     lea     ($0412,A4),A0
02:0003CDA4 11802000        	  9679:     move.b  D0,(A0,D2.W)
02:0003CDA8 61001C62        	  9680:     jsr     ReverseObjDir8
02:0003CDAC 41EC045E        	  9681:     lea     ($045E,A4),A0
02:0003CDB0 10302000        	  9682:     move.b  (A0,D2.W),D0
02:0003CDB4 41EC045E        	  9683:     lea     ($045E,A4),A0
02:0003CDB8 52302000        	  9684:     addq.b  #1,(A0,D2.W)
                            	  9685:     ; If the previous number of sprints was odd, then flag that Gohma
                            	  9686:     ; should randomly change direction.
                            	  9687:     ;
02:0003CDBC E208            	  9688:     lsr.b  #1,D0   ; LSR A
02:0003CDBE 640A            	  9689:     bcc  _L_z04_UpdateGohma_AnimateEye
02:0003CDC0 7000            	  9690:     moveq   #0,D0
02:0003CDC2 41EC0451        	  9691:     lea     ($0451,A4),A0
02:0003CDC6 11802000        	  9692:     move.b  D0,(A0,D2.W)
                            	  9693:     even
                            	  9694: _L_z04_UpdateGohma_AnimateEye:
                            	  9695:     ; Animate the eye.
                            	  9696:     ;
                            	  9697:     ; First, if the counter for when to open the eye next = 0, then
                            	  9698:     ; set it to a random value at least $C0; and set the timer for
                            	  9699:     ; keeping the eye open to $80.
                            	  9700:     ;
                            	  9701:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9702:     ; every other frame.
                            	  9703:     ;
02:0003CDCA 41EC042C        	  9704:     lea     ($042C,A4),A0
02:0003CDCE 10302000        	  9705:     move.b  (A0,D2.W),D0
02:0003CDD2 661E            	  9706:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003CDD4 103C0080        	  9707:     move.b  #$80,D0
02:0003CDD8 41EC0444        	  9708:     lea     ($0444,A4),A0
02:0003CDDC 11802000        	  9709:     move.b  D0,(A0,D2.W)
02:0003CDE0 103C00C0        	  9710:     move.b  #$C0,D0
02:0003CDE4 12342018        	  9711:     move.b  ($18,A4,D2.W),D1
02:0003CDE8 8001            	  9712:     or.b  D1,D0
02:0003CDEA 41EC042C        	  9713:     lea     ($042C,A4),A0
02:0003CDEE 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
                            	  9716: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9717:     ; Decrement the next-open-eye counter.
                            	  9718:     ;
02:0003CDF2 102C0015        	  9719:     move.b  ($0015,A4),D0
02:0003CDF6 E208            	  9720:     lsr.b  #1,D0   ; LSR A
02:0003CDF8 6408            	  9721:     bcc  _anon_z04_122
02:0003CDFA 41EC042C        	  9722:     lea     ($042C,A4),A0
02:0003CDFE 53302000        	  9723:     subq.b  #1,(A0,D2.W)
                            	  9724: _anon_z04_122:
                            	  9725:     ; If open eye timer = 0, then the eye is closed.
                            	  9726:     ; Go animate it differently.
                            	  9727:     ;
02:0003CE02 41EC0444        	  9728:     lea     ($0444,A4),A0
02:0003CE06 10302000        	  9729:     move.b  (A0,D2.W),D0
02:0003CE0A 674A            	  9730:     beq  _L_z04_UpdateGohma_AnimateClosedEye
                            	  9731:     ; Else decrement the open eye timer.
                            	  9732:     ;
02:0003CE0C 41EC0444        	  9733:     lea     ($0444,A4),A0
02:0003CE10 53302000        	  9734:     subq.b  #1,(A0,D2.W)
                            	  9735:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9736:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9737:     ;
02:0003CE14 7602            	  9738:     moveq   #2,D3
02:0003CE16 0C000070        	  9739:     cmpi.b  #$70,D0
02:0003CE1A 6408            	  9740:     bcc  _anon_z04_123
02:0003CE1C 0C000010        	  9741:     cmpi.b  #$10,D0
02:0003CE20 6502            	  9742:     bcs  _anon_z04_123
02:0003CE22 5203            	  9743:     addq.b  #1,D3
                            	  9744: _anon_z04_123:
02:0003CE24 1003            	  9745:     move.b  D3,D0
                            	  9746:     even
