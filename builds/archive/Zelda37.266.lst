02:0003150E 19400008        	  4153:     move.b  D0,($0008,A4)
                            	  4154:     ; If the monster's attribute "reverse after hit Link" is set, then
                            	  4155:     ; combine the shove direction with $40.
                            	  4156:     ;
                            	  4157:     ; TODO:
