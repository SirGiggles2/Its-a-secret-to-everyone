02:00049B16 103C00FF        	  2434:     move.b  #$FF,D0
02:00049B1A 41EC030C        	  2435:     lea     ($030C,A4),A0
02:00049B1E 11802000        	  2436:     move.b  D0,(A0,D2.W)
                            	  2437:     ; Update dynamic buffer length with 10 new bytes.
                            	  2438:     ;
02:00049B22 1002            	  2439:     move.b  D2,D0
02:00049B24 023C00EE        	  2440:     andi    #$EE,CCR  ; CLC: clear C+X
02:00049B28 123C000A        	  2441:     move.b  #$0A,D1
02:00049B2C D101            	  2442:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:00049B2E 19400301        	  2443:     move.b  D0,($0301,A4)
02:00049B32 101D            	  2444:     move.b  (A5)+,D0  ; PLA
02:00049B34 7400            	  2445:     moveq   #0,D2
02:00049B36 1400            	  2446:     move.b  D0,D2
02:00049B38 7005            	  2447:     moveq   #5,D0
