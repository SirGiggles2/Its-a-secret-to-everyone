02:0003155E 10302000        	  4195:     move.b  (A0,D2.W),D0
02:00031562 0C000003        	  4196:     cmpi.b  #$03,D0
02:00031566 6624            	  4197:     bne  _L_z01_BeginShove_Exit2
                            	  4198:     even
