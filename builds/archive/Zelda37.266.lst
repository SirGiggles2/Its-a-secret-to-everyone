                            	  9821:     ; Draw the left legs.
                            	  9822:     ;
02:0003CEA8 7600            	  9823:     moveq   #0,D3
                            	  9824: ; Params:
                            	  9825: ; Y: side: 0 for left, 1 for right
                            	  9826: ;
                            	  9827: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9828: ; store the sprite's X in [00].
                            	  9829: ;
                            	  9830:     even
                            	  9831: Gohma_DrawLegsOneSide:
02:0003CEAA 10342070        	  9832:     move.b  ($70,A4,D2.W),D0
02:0003CEAE 023C00EE        	  9833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEB2 41F90003CE88    	  9834:     lea     (GohmaLegOffsetsX).l,A0
