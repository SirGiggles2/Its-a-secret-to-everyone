                            	  4048: _L_z05_CheckDoorway_InDoorway:
                            	  4049:     ; In a doorway. DoorwayDir is in A.
                            	  4050:     ;
02:00040E6A 1B00            	  4051:     move.b  D0,-(A5)  ; PHA
02:00040E6C 610000DC        	  4052:     jsr     GetPlayerCoordsForDirection
