                            	   257: InitCaveContinue:
                            	   258:     ; Get this cave's index (object type - $6A).
                            	   259:     ;
02:0002E9B8 102C0350        	   260:     move.b  ($0350,A4),D0
02:0002E9BC 003C0011        	   261:     ori     #$11,CCR  ; SEC: set C+X
02:0002E9C0 123C006A        	   262:     move.b  #$6A,D1
02:0002E9C4 0A3C0010        	   263:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E9C8 9101            	   264:     subx.b  D1,D0   ; SBC #$6A
02:0002E9CA 0A3C0010        	   265:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E9CE 7600            	   266:     moveq   #0,D3
02:0002E9D0 1600            	   267:     move.b  D0,D3
                            	   268:     ; Get the person text selector by looking up the text selector byte
                            	   269:     ; for this index, and masking it with $3F.
                            	   270:     ;
02:0002E9D2 41F90002E982    	   271:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E9D8 10303000        	   272:     move.b  (A0,D3.W),D0
02:0002E9DC 1B00            	   273:     move.b  D0,-(A5)  ; PHA
02:0002E9DE 0200003F        	   274:     andi.b #$3F,D0
02:0002E9E2 19400415        	   275:     move.b  D0,($0415,A4)
                            	   276:     ; Pop and mask the text selector byte with $C0 to get the
                            	   277:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   278:     ;
02:0002E9E6 101D            	   279:     move.b  (A5)+,D0  ; PLA
02:0002E9E8 020000C0        	   280:     andi.b #$C0,D0
02:0002E9EC 19400003        	   281:     move.b  D0,($0003,A4)
                            	   282:     ; At this point, the Y register still has the cave index.
                            	   283:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   284:     ;
02:0002E9F0 103C00FD        	   285:     move.b  #$FD,D0
                            	   286: _anon_z01_0:
02:0002E9F4 023C00EE        	   287:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E9F8 123C0003        	   288:     move.b  #$03,D1
02:0002E9FC D101            	   289:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E9FE 5303            	   290:     subq.b  #1,D3
02:0002EA00 6AF2            	   291:     bpl  _anon_z01_0
02:0002EA02 7600            	   292:     moveq   #0,D3
02:0002EA04 1600            	   293:     move.b  D0,D3
                            	   294:     ; Loop over the wares from 0 to 2.
                            	   295:     ;
02:0002EA06 7400            	   296:     moveq   #0,D2
                            	   297:     even
                            	   298: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   299:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   300:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   301:     ;
02:0002EA08 41F900FF6A7E    	   302:     lea     (NES_SRAM+$0A7E).l,A0
02:0002EA0E 10303000        	   303:     move.b  (A0,D3.W),D0
02:0002EA12 41EC0422        	   304:     lea     ($0422,A4),A0
02:0002EA16 11802000        	   305:     move.b  D0,(A0,D2.W)
                            	   306:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   307:     ;
02:0002EA1A 020000C0        	   308:     andi.b #$C0,D0
02:0002EA1E 19802000        	   309:     move.b  D0,($00,A4,D2.W)
                            	   310:     ; Copy 3 prices from the Cave level block info.
                            	   311:     ;
02:0002EA22 41F900FF6ABA    	   312:     lea     (NES_SRAM+$0ABA).l,A0
02:0002EA28 10303000        	   313:     move.b  (A0,D3.W),D0
02:0002EA2C 41EC0430        	   314:     lea     ($0430,A4),A0
02:0002EA30 11802000        	   315:     move.b  D0,(A0,D2.W)
                            	   316:     ; Bottom of the wares copying loop.
                            	   317:     ;
02:0002EA34 5203            	   318:     addq.b  #1,D3
02:0002EA36 5202            	   319:     addq.b  #1,D2
02:0002EA38 0C020003        	   320:     cmpi.b  #$03,D2
02:0002EA3C 66CA            	   321:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   322:     ; Get the top 2 bits of text selector byte in [03],
                            	   323:     ; shift them to the bottom, and combine them with [00].
                            	   324:     ;
02:0002EA3E 102C0003        	   325:     move.b  ($0003,A4),D0
02:0002EA42 E308            	   326:     lsl.b  #1,D0   ; ASL A
02:0002EA44 E310            	   327:     roxl.b  #1,D0   ; ROL A
02:0002EA46 E310            	   328:     roxl.b  #1,D0   ; ROL A
02:0002EA48 1214            	   329:     move.b  ($0000,A4),D1
02:0002EA4A 8001            	   330:     or.b  D1,D0
02:0002EA4C 1880            	   331:     move.b  D0,($0000,A4)
                            	   332:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   333:     ; and combine them with [00].
                            	   334:     ;
02:0002EA4E 102C0002        	   335:     move.b  ($0002,A4),D0
02:0002EA52 E208            	   336:     lsr.b  #1,D0   ; LSR A
02:0002EA54 E208            	   337:     lsr.b  #1,D0   ; LSR A
02:0002EA56 E208            	   338:     lsr.b  #1,D0   ; LSR A
02:0002EA58 E208            	   339:     lsr.b  #1,D0   ; LSR A
02:0002EA5A 1214            	   340:     move.b  ($0000,A4),D1
02:0002EA5C 8001            	   341:     or.b  D1,D0
02:0002EA5E 1880            	   342:     move.b  D0,($0000,A4)
                            	   343:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   344:     ; and combine them with [00] into CaveFlags.
                            	   345:     ;
02:0002EA60 102C0001        	   346:     move.b  ($0001,A4),D0
02:0002EA64 E208            	   347:     lsr.b  #1,D0   ; LSR A
02:0002EA66 E208            	   348:     lsr.b  #1,D0   ; LSR A
02:0002EA68 1214            	   349:     move.b  ($0000,A4),D1
02:0002EA6A 8001            	   350:     or.b  D1,D0
02:0002EA6C 19400413        	   351:     move.b  D0,($0413,A4)
                            	   352:     ; The end result is a byte with 8 cave flags.
                            	   353:     ;
                            	   354:     ; If cave flag "money game" is missing, then go finish up,
                            	   355:     ; instead of choosing random amounts for the money game.
                            	   356:     ;
02:0002EA70 02000020        	   357:     andi.b #$20,D0
02:0002EA74 6700009E        	   358:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   359:     ; Determine an index randomly with increasing probability,
                            	   360:     ; from 6 to 1. Start with the following test:
                            	   361:     ;
                            	   362:     ;   If $FF < Random, then go use index 6.
                            	   363:     ;
02:0002EA78 103C00FF        	   364:     move.b  #$FF,D0
02:0002EA7C 7606            	   365:     moveq   #6,D3
                            	   366:     even
                            	   367: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002EA7E 122C0019        	   368:     move.b  ($0019,A4),D1
02:0002EA82 B001            	   369:     cmp.b   D1,D0
02:0002EA84 6516            	   370:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   371:     ; If the test fails, then subtract $2B from the reference number.
                            	   372:     ;
02:0002EA86 003C0011        	   373:     ori     #$11,CCR  ; SEC: set C+X
02:0002EA8A 123C002B        	   374:     move.b  #$2B,D1
02:0002EA8E 0A3C0010        	   375:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EA92 9101            	   376:     subx.b  D1,D0   ; SBC #$2B
02:0002EA94 0A3C0010        	   377:     eori    #$10,CCR  ; restore X = 6502 C
02:0002EA98 5303            	   378:     subq.b  #1,D3
02:0002EA9A 66E2            	   379:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   380:     even
                            	   381: _L_z01_InitCaveContinue_FoundPermutation:
                            	   382:     ; The index chooses the last offset of a permutation of three indexes.
                            	   383:     ;
02:0002EA9C 7400            	   384:     moveq   #0,D2
02:0002EA9E 41F90002E9AA    	   385:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002EAA4 14303000        	   386:     move.b  (A0,D3.W),D2
                            	   387:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   388:     ;
02:0002EAA8 7602            	   389:     moveq   #2,D3
                            	   390:     even
                            	   391: _L_z01_InitCaveContinue_CopyPermutation:
02:0002EAAA 41F90002E998    	   392:     lea     (MoneyGamePermutations).l,A0
02:0002EAB0 10302000        	   393:     move.b  (A0,D2.W),D0
02:0002EAB4 41EC046C        	   394:     lea     ($046C,A4),A0
02:0002EAB8 11803000        	   395:     move.b  D0,(A0,D3.W)
02:0002EABC 5302            	   396:     subq.b  #1,D2
02:0002EABE 5303            	   397:     subq.b  #1,D3
02:0002EAC0 6AE8            	   398:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   399:     ; With the first bit of another random number, choose 10 or 40
                            	   400:     ; to put in [046F]. This is a random amount to lose.
                            	   401:     ;
02:0002EAC2 102C001A        	   402:     move.b  ($001A,A4),D0
02:0002EAC6 02000001        	   403:     andi.b #$01,D0
02:0002EACA 7600            	   404:     moveq   #0,D3
02:0002EACC 1600            	   405:     move.b  D0,D3
02:0002EACE 41F90002E996    	   406:     lea     (MoneyGameLossAmounts).l,A0
02:0002EAD4 10303000        	   407:     move.b  (A0,D3.W),D0
02:0002EAD8 1940046F        	   408:     move.b  D0,($046F,A4)
                            	   409:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   410:     ;
02:0002EADC 700A            	   411:     moveq   #10,D0
02:0002EADE 19400470        	   412:     move.b  D0,($0470,A4)
                            	   413:     ; With a different bit of the second random number,
                            	   414:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   415:     ;
02:0002EAE2 7614            	   416:     moveq   #20,D3
02:0002EAE4 102C001A        	   417:     move.b  ($001A,A4),D0
02:0002EAE8 02000002        	   418:     andi.b #$02,D0
02:0002EAEC 6702            	   419:     beq  _anon_z01_1
02:0002EAEE 7632            	   420:     moveq   #50,D3
                            	   421: _anon_z01_1:
02:0002EAF0 19430471        	   422:     move.b  D3,($0471,A4)
                            	   423:     ; The 3 amounts are now in [046F] to [0471].
                            	   424:     ; Reference these amounts using the permutation of indexes
                            	   425:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
