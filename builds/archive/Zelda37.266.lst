02:0003A03A 4EB90004B9F0    	  3456:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  3457:     ; If facing down, then use frame image offset 2.
                            	  3458:     ;
02:0003A040 41EC0098        	  3459:     lea     ($0098,A4),A0
02:0003A044 10302000        	  3460:     move.b  (A0,D2.W),D0
02:0003A048 7600            	  3461:     moveq   #0,D3
02:0003A04A 1600            	  3462:     move.b  D0,D3
02:0003A04C 0200000C        	  3463:     andi.b #$0C,D0
