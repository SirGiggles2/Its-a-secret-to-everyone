02:00030E9E 162C000E        	  3188:     move.b  ($000E,A4),D3
02:00030EA2 7001            	  3189:     moveq   #1,D0
02:00030EA4 19400007        	  3190:     move.b  D0,($0007,A4)
02:00030EA8 7008            	  3191:     moveq   #8,D0
02:00030EAA 1940000A        	  3192:     move.b  D0,($000A,A4)
02:00030EAE 41F900030BFE    	  3193:     lea     (ObjAnimations).l,A0
02:00030EB4 10303000        	  3194:     move.b  (A0,D3.W),D0
02:00030EB8 023C00EE        	  3195:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EBC 122C000D        	  3196:     move.b  ($000D,A4),D1
02:00030EC0 D101            	  3197:     addx.b  D1,D0   ; ADC $0D
02:00030EC2 7600            	  3198:     moveq   #0,D3
02:00030EC4 1600            	  3199:     move.b  D0,D3
02:00030EC6 41F900030C7E    	  3200:     lea     (ObjAnimFrameHeap).l,A0
02:00030ECC 10303000        	  3201:     move.b  (A0,D3.W),D0
02:00030ED0 19400002        	  3202:     move.b  D0,($0002,A4)
02:00030ED4 023C00EE        	  3203:     andi    #$EE,CCR  ; CLC: clear C+X
