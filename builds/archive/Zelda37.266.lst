                            	  1203: UpdateWhirlwind_Full:
                            	  1204:     ; Get Link's halted state.
                            	  1205:     ;
02:0003008C 102C00AC        	  1206:     move.b  ($00AC,A4),D0
02:00030090 02000040        	  1207:     andi.b #$40,D0
02:00030094 7600            	  1208:     moveq   #0,D3
02:00030096 1600            	  1209:     move.b  D0,D3
                            	  1210:     ; Add 2 to whirlwind X.
                            	  1211:     ;
02:00030098 7002            	  1212:     moveq   #2,D0
02:0003009A 023C00EE        	  1213:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003009E 12342070        	  1214:     move.b  ($70,A4,D2.W),D1
02:000300A2 D101            	  1215:     addx.b  D1,D0   ; ADC ObjX,X
02:000300A4 19802070        	  1216:     move.b  D0,($70,A4,D2.W)
                            	  1217:     ; If Link is not halted or teleporting state = 0, then
                            	  1218:     ; go check for collision with Link.
                            	  1219:     ;
02:000300A8 0C030040        	  1220:     cmpi.b  #$40,D3
02:000300AC 6638            	  1221:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:000300AE 7600            	  1222:     moveq   #0,D3
02:000300B0 162C0522        	  1223:     move.b  ($0522,A4),D3
02:000300B4 6730            	  1224:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  1225:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  1226:     ;
                            	  1227:     ; Set Link's X to whirlwind's.
                            	  1228:     ;
02:000300B6 19400070        	  1229:     move.b  D0,($0070,A4)
                            	  1230:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  1231:     ; the right screen edge and draw.
                            	  1232:     ;
02:000300BA 5303            	  1233:     subq.b  #1,D3
02:000300BC 6776            	  1234:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:000300BE 0C000080        	  1235:     cmpi.b  #$80,D0
02:000300C2 6670            	  1236:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1237:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  1238:     ;
                            	  1239:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  1240:     ;
02:000300C4 E308            	  1241:     lsl.b  #1,D0   ; ASL A
02:000300C6 194000AC        	  1242:     move.b  D0,($00AC,A4)
02:000300CA 19400522        	  1243:     move.b  D0,($0522,A4)
02:000300CE 41EC034F        	  1244:     lea     ($034F,A4),A0
02:000300D2 11802000        	  1245:     move.b  D0,(A0,D2.W)
                            	  1246:     ; Update the player position marker, and draw one last time.
                            	  1247:     ;
02:000300D6 1002            	  1248:     move.b  D2,D0
02:000300D8 1B00            	  1249:     move.b  D0,-(A5)  ; PHA
02:000300DA 61000910        	  1250:     jsr     UpdatePlayerPositionMarker
02:000300DE 101D            	  1251:     move.b  (A5)+,D0  ; PLA
02:000300E0 7400            	  1252:     moveq   #0,D2
02:000300E2 1400            	  1253:     move.b  D0,D2
02:000300E4 6070            	  1254:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  1255: 
                            	  1256:     even
                            	  1257: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  1258:     ; Link is not halted or teleporting state = 0.
                            	  1259:     ; Try to pick up Link.
                            	  1260:     ;
                            	  1261:     ; If the whirlwind does not collide with Link, then go check
                            	  1262:     ; for the screen's right edge.
                            	  1263:     ;
02:000300E6 610011E4        	  1264:     jsr     CheckLinkCollision
02:000300EA 102C0006        	  1265:     move.b  ($0006,A4),D0
02:000300EE 6744            	  1266:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  1267:     ; Collided with Link.
                            	  1268:     ;
                            	  1269:     ; Make Link face right. Reset shove info and subroom type.
                            	  1270:     ;
02:000300F0 7001            	  1271:     moveq   #1,D0
02:000300F2 19400098        	  1272:     move.b  D0,($0098,A4)
02:000300F6 E208            	  1273:     lsr.b  #1,D0   ; LSR A
02:000300F8 194000C0        	  1274:     move.b  D0,($00C0,A4)
02:000300FC 194000D3        	  1275:     move.b  D0,($00D3,A4)
02:00030100 1940005A        	  1276:     move.b  D0,($005A,A4)
                            	  1277:     ; Halt Link (state $40), and hide him.
                            	  1278:     ;
02:00030104 7040            	  1279:     moveq   #64,D0
02:00030106 194000AC        	  1280:     move.b  D0,($00AC,A4)
02:0003010A 103C00F8        	  1281:     move.b  #$F8,D0
02:0003010E 19400248        	  1282:     move.b  D0,($0248,A4)
02:00030112 1940024C        	  1283:     move.b  D0,($024C,A4)
                            	  1284:     ; Find and set the room that will behave as the previous room
                            	  1285:     ; when scrolling right to the room with the level's entrance.
                            	  1286:     ;
02:00030116 102C0523        	  1287:     move.b  ($0523,A4),D0
02:0003011A 02000007        	  1288:     andi.b #$07,D0
02:0003011E 7600            	  1289:     moveq   #0,D3
02:00030120 1600            	  1290:     move.b  D0,D3
02:00030122 41F900030084    	  1291:     lea     (WhirlwindPrevRoomIdList).l,A0
02:00030128 10303000        	  1292:     move.b  (A0,D3.W),D0
02:0003012C 194000EA        	  1293:     move.b  D0,($00EA,A4)
                            	  1294:     ; Set teleporting state 1.
                            	  1295:     ;
02:00030130 522C0522        	  1296:     addq.b  #1,($0522,A4)
                            	  1297:     even
                            	  1298: _L_z01_UpdateWhirlwind_Full_CheckRightEdge:
                            	  1299:     ; If whirlwind's X < $F0, go draw.
                            	  1300:     ;
02:00030134 10342070        	  1301:     move.b  ($70,A4,D2.W),D0
02:00030138 0C0000F0        	  1302:     cmpi.b  #$F0,D0
02:0003013C 6518            	  1303:     bcs  _L_z01_UpdateWhirlwind_Full_Draw
                            	  1304:     ; The whirlwind has reached the right edge of the screen.
                            	  1305:     ;
                            	  1306:     ; Destroy the object.
                            	  1307:     ;
02:0003013E 611A            	  1308:     jsr     DestroyWhirlwind
                            	  1309:     ; If teleporting state <> 0, we picked up Link.
                            	  1310:     ; So, go to the next mode.
                            	  1311:     ;
                            	  1312:     ; Either way, draw one last time.
                            	  1313:     ;
02:00030140 102C0522        	  1314:     move.b  ($0522,A4),D0
02:00030144 6710            	  1315:     beq  _L_z01_UpdateWhirlwind_Full_Draw
02:00030146 1002            	  1316:     move.b  D2,D0
02:00030148 1B00            	  1317:     move.b  D0,-(A5)  ; PHA
02:0003014A 4EB90004A86A    	  1318:     jsr     GoToNextModeFromPlay
02:00030150 101D            	  1319:     move.b  (A5)+,D0  ; PLA
02:00030152 7400            	  1320:     moveq   #0,D2
02:00030154 1400            	  1321:     move.b  D0,D2
                            	  1322:     even
                            	  1323: _L_z01_UpdateWhirlwind_Full_Draw:
02:00030156 60000094        	  1324:     jmp     DrawWhirlwind
                            	  1325: 
