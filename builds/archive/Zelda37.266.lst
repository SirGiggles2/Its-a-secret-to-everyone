02:0003EF28 102C00EB        	   332:     move.b  ($00EB,A4),D0
02:0003EF2C 0200000F        	   333:     andi.b #$0F,D0
02:0003EF30 E308            	   334:     lsl.b  #1,D0   ; ASL A
02:0003EF32 E308            	   335:     lsl.b  #1,D0   ; ASL A
02:0003EF34 E308            	   336:     lsl.b  #1,D0   ; ASL A
02:0003EF36 1880            	   337:     move.b  D0,($0000,A4)
                            	   338:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   339:     ; negative or left rotation by ($10 - rotation value).
                            	   340:     ;
                            	   341:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   342:     ; the width of a tile. Then negate it. The final result is the
                            	   343:     ; negative offset.
                            	   344:     ;
02:0003EF38 103900FF6BAB    	   345:     move.b  (NES_SRAM+$0BAB).l,D0
