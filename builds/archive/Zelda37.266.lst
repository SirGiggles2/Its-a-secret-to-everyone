02:0003A47A 41EC034F        	  4141:     lea     ($034F,A4),A0
02:0003A47E 10302000        	  4142:     move.b  (A0,D2.W),D0
02:0003A482 0C000065        	  4143:     cmpi.b  #$65,D0
02:0003A486 6708            	  4144:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
02:0003A488 102C0665        	  4145:     move.b  ($0665,A4),D0
