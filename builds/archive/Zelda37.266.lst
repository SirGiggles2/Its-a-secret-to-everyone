02:00035792 7000            	  5026:     moveq   #0,D0
02:00035794 6508            	  5027:     bcs  _anon_z02_39
02:00035796 194000FC        	  5028:     move.b  D0,($00FC,A4)
02:0003579A 522C00E2        	  5029:     addq.b  #1,($00E2,A4)
                            	  5030: _anon_z02_39:
