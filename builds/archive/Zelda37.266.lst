                            	  2867: 
                            	  2868: ; Each byte describes an item. The high nibble is the type.
                            	  2869: ; The low nibble is the value. Its meaning depends on the type.
                            	  2870: ;
                            	  2871: ; 0x - individuals
                            	  2872: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  2873: ; * bit mask: value doesn't matter.
                            	  2874: ;
                            	  2875: ; 1x - amounts
                            	  2876: ; Value is an amount to add.
                            	  2877: ;
                            	  2878: ; 2x - grades
                            	  2879: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  2880: ;
                            	  2881: ; 3x - error?
                            	  2882: ; Produces an item value of $FF.
                            	  2883: ;
                            	  2884:     even
