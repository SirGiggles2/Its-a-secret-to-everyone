                            	   905: ;==============================================================================
                            	   906: ; EXPORT side — z_03 entry point.
                            	   907: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   908: ; the transpiler emits that label pointing to this shim instead of the
                            	   909: ; z_03 asm body. The C function takes no args and returns void.
                            	   910: ;==============================================================================
                            	   911: 
                            	   912: ;------------------------------------------------------------------------------
                            	   913: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   914: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   915: ;------------------------------------------------------------------------------
                            	   916: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   917:     jmp     z03_transfer_level_pattern_blocks
