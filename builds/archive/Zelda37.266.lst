02:0002BF88 08000008        	  2373:     btst    #8,D0
02:0002BF8C 670A            	  2374:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2375:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2376:     eori    #$01,CCR
02:0002BF96 4E75            	  2377:     rts
                            	  2378: .cc_cnr:
02:0002BF98 023C00FE        	  2379:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2380:     eori    #$01,CCR
02:0002BFA0 4E75            	  2381:     rts
                            	  2382: 
