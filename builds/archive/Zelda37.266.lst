                            	   933: ;==============================================================================
                            	   934: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   935: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   936: ;==============================================================================
                            	   937: 
                            	   938: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   939:     jmp     z05_copy_column_to_tilebuf
