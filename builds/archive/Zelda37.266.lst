02:0003EFE8 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003EFEC 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003EFEE 4EB9000495DE    	   434:     jsr     HideAllSprites
