02:00035348 41EC0302        	  4495:     lea     ($0302,A4),A0
02:0003534C 11803000        	  4496:     move.b  D0,(A0,D3.W)
02:00035350 5303            	  4497:     subq.b  #1,D3
02:00035352 6AEA            	  4498:     bpl  _anon_z02_29
                            	  4499:     ; Point to the front of the first textbox line,
