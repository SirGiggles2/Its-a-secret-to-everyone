02:0003BF18 41EC0084        	  7760:     lea     ($0084,A4),A0
02:0003BF1C 11802000        	  7761:     move.b  D0,(A0,D2.W)
                            	  7762:     ; If the speed is still negative, then return.
                            	  7763:     ;
02:0003BF20 41EC0412        	  7764:     lea     ($0412,A4),A0
02:0003BF24 10302000        	  7765:     move.b  (A0,D2.W),D0
02:0003BF28 6B0000AC        	  7766:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7767:     ; If Y coordinate still < target Y, then return.
