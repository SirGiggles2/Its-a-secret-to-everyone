02:0003B02A 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003B02E 41EC0085        	  5649:     lea     ($0085,A4),A0
02:0003B032 11803000        	  5650:     move.b  D0,(A0,D3.W)
                            	  5651:     ; If the tail segment found is also a head, then
