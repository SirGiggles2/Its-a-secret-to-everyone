02:00043A1E 6642            	  7996:     bne  _anon_z05_177
02:00043A20 102C0098        	  7997:     move.b  ($0098,A4),D0
02:00043A24 02000004        	  7998:     andi.b #$04,D0
02:00043A28 6738            	  7999:     beq  _anon_z05_177
