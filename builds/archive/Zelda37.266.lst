                            	  8117: 
                            	  8118: ; Description:
                            	  8119: ; Blue Wizzrobe has two states: walking and teleporting.
                            	  8120: ; When walking, the object timer is set. When teleporting,
                            	  8121: ; the teleporting distance remaining is set.
                            	  8122: ;
                            	  8123: ; If we have the magic clock, then only go draw and check collisions.
                            	  8124: ;
                            	  8125:     even
                            	  8126: UpdateBlueWizzrobe:
02:0003C226 102C066C        	  8127:     move.b  ($066C,A4),D0
02:0003C22A 6702            	  8128:     beq.s  __far_z_04_0070
02:0003C22C 6014            	  8129:     jmp  L_Wizzrobe_DrawAndCheckCollisions
                            	  8130: __far_z_04_0070:
02:0003C22E 6116            	  8131:     jsr     BlueWizzrobe_WalkOrTeleport
02:0003C230 61000318        	  8132:     jsr     BlueWizzrobe_TryShooting
                            	  8133:     even
                            	  8134: Wizzrobe_DrawAndCheckCollisionsIntermittently:
                            	  8135:     ; If the teleporting distance remaining is even, then draw
                            	  8136:     ; and check collisions, else return.
                            	  8137:     ;
                            	  8138:     ; This means that when 0, the monster is walking.
                            	  8139:     ; So, draw and check collisions every frame.
                            	  8140:     ;
                            	  8141:     ; When not 0, the monster is teleporting, and must be drawn
                            	  8142:     ; translucently -- every other frame.
                            	  8143:     ;
02:0003C234 41EC0394        	  8144:     lea     ($0394,A4),A0
02:0003C238 10302000        	  8145:     move.b  (A0,D2.W),D0
02:0003C23C E208            	  8146:     lsr.b  #1,D0   ; LSR A
02:0003C23E 6402            	  8147:     bcc.s  __far_z_04_0071
02:0003C240 603A            	  8148:     jmp  L11E17_Exit
                            	  8149: __far_z_04_0071:
                            	  8150:     even
                            	  8151: L_Wizzrobe_DrawAndCheckCollisions:
02:0003C242 600004DE        	  8152:     jmp     Wizzrobe_DrawAndCheckCollisions
                            	  8153: 
                            	  8154:     even
