02:0003AF50 1940038A        	  5537:     move.b  D0,($038A,A4)
                            	  5538:     ; Set minimum number of turns 1 for flying states.
                            	  5539:     ;
                            	  5540:     ; By setting this, the first time that a flight control routine
                            	  5541:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  5542:     ; that flying state will immediately end, and object timer
                            	  5543:     ; will be left 0: ready for moldorm to decide a flying state
