02:0003B774 1880            	  6672:     move.b  D0,($0000,A4)
                            	  6673:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6674:     ; Store it in [01].
                            	  6675:     ;
02:0003B776 41EC0084        	  6676:     lea     ($0084,A4),A0
02:0003B77A 10302000        	  6677:     move.b  (A0,D2.W),D0
02:0003B77E 023C00EE        	  6678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B782 41F90003B736    	  6679:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003B788 12303000        	  6680:     move.b  (A0,D3.W),D1
02:0003B78C D101            	  6681:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003B78E 19400001        	  6682:     move.b  D0,($0001,A4)
                            	  6683:     ; Calculate sprite attributes:
                            	  6684:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6685:     ;
                            	  6686:     ; If the boss is temporarily invincible, then
                            	  6687:     ; this makes it flash by cycling all the palette rows.
                            	  6688:     ;
                            	  6689:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6690:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6691:     ;
02:0003B792 41EC04F0        	  6692:     lea     ($04F0,A4),A0
02:0003B796 10302000        	  6693:     move.b  (A0,D2.W),D0
02:0003B79A 02000003        	  6694:     andi.b #$03,D0
02:0003B79E 0A000003        	  6695:     eori.b #$03,D0
02:0003B7A2 19400003        	  6696:     move.b  D0,($0003,A4)
02:0003B7A6 7600            	  6697:     moveq   #0,D3
02:0003B7A8 162C000A        	  6698:     move.b  ($000A,A4),D3
                            	  6699:     ; Look up the tile for this sprite.
                            	  6700:     ; If it's not the first one (face), then go write the sprite record.
                            	  6701:     ;
02:0003B7AC 41F90003B72A    	  6702:     lea     (AquamentusTiles).l,A0
02:0003B7B2 10303000        	  6703:     move.b  (A0,D3.W),D0
02:0003B7B6 12390003B72A    	  6704:     move.b  (AquamentusTiles).l,D1
02:0003B7BC B001            	  6705:     cmp.b   D1,D0
02:0003B7BE 6610            	  6706:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6707:     ; Else it's the first one (the face tile).
                            	  6708:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6709:     ;
                            	  6710:     ; $CC/CD shows the closed mouth face.
                            	  6711:     ; $C0/C1 shows the open mouth face.
                            	  6712:     ;
02:0003B7C0 7600            	  6713:     moveq   #0,D3
02:0003B7C2 16342028        	  6714:     move.b  ($28,A4,D2.W),D3
02:0003B7C6 0C030020        	  6715:     cmpi.b  #$20,D3
02:0003B7CA 6404            	  6716:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003B7CC 103C00C0        	  6717:     move.b  #$C0,D0
