02:0003E050 701B            	 12183:     moveq   #27,D0
02:0003E052 19400505        	 12184:     move.b  D0,($0505,A4)
                            	 12185:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12186:     ;
