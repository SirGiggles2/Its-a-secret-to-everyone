02:0003BEF4 41EC0412        	  7748:     lea     ($0412,A4),A0
02:0003BEF8 10302000        	  7749:     move.b  (A0,D2.W),D0
02:0003BEFC 123C0000        	  7750:     move.b  #$00,D1
02:0003BF00 D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003BF02 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003BF06 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
02:0003BF0A 023C00EE        	  7756:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF0E 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003BF12 12302000        	  7758:     move.b  (A0,D2.W),D1
