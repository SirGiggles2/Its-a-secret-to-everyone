02:000305F2 41EC0084        	  1983:     lea     ($0084,A4),A0
02:000305F6 16302000        	  1984:     move.b  (A0,D2.W),D3
02:000305FA 103C0090        	  1985:     move.b  #$90,D0
02:000305FE 1880            	  1986:     move.b  D0,($0000,A4)
                            	  1987:     even
                            	  1988: _L_z01_UpdateTrap_Full_Finish:
                            	  1989:     ; If in state 2, then go finish handling it.
                            	  1990:     ;
02:00030600 41EC00AC        	  1991:     lea     ($00AC,A4),A0
02:00030604 10302000        	  1992:     move.b  (A0,D2.W),D0
02:00030608 02000001        	  1993:     andi.b #$01,D0
02:0003060C 6744            	  1994:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  1995:     ; Finish handling state 1.
                            	  1996:     ;
                            	  1997:     ; Get the distance between the current coordinate and the target.
                            	  1998:     ;
02:0003060E 1003            	  1999:     move.b  D3,D0
02:00030610 003C0011        	  2000:     ori     #$11,CCR  ; SEC: set C+X
02:00030614 1214            	  2001:     move.b  ($0000,A4),D1
02:00030616 0A3C0010        	  2002:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003061A 9101            	  2003:     subx.b  D1,D0   ; SBC $00
02:0003061C 0A3C0010        	  2004:     eori    #$10,CCR  ; restore X = 6502 C
02:00030620 61000326        	  2005:     jsr     Abs
