02:0003DADA 610000EC        	 11420:     jsr     Lamnola_UpdateHead
                            	 11421:     even
                            	 11422: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003DADE 10342070        	 11423:     move.b  ($70,A4,D2.W),D0
02:0003DAE2 1B00            	 11424:     move.b  D0,-(A5)  ; PHA
                            	 11425:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11426:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11427:     ;
02:0003DAE4 023C00EE        	 11428:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DAE8 123C0004        	 11429:     move.b  #$04,D1
02:0003DAEC D101            	 11430:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DAEE 19802070        	 11431:     move.b  D0,($70,A4,D2.W)
                            	 11432:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11433:     ; to store in [03].
                            	 11434:     ;
02:0003DAF2 102C04E6        	 11435:     move.b  ($04E6,A4),D0
02:0003DAF6 0A000003        	 11436:     eori.b #$03,D0
02:0003DAFA 19400003        	 11437:     move.b  D0,($0003,A4)
                            	 11438:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11439:     ;
02:0003DAFE 103C009E        	 11440:     move.b  #$9E,D0
02:0003DB02 0C020005        	 11441:     cmpi.b  #$05,D2
02:0003DB06 670A            	 11442:     beq  _L_z04_UpdateLamnola_Draw
02:0003DB08 0C02000A        	 11443:     cmpi.b  #$0A,D2
02:0003DB0C 6704            	 11444:     beq  _L_z04_UpdateLamnola_Draw
02:0003DB0E 103C00A0        	 11445:     move.b  #$A0,D0
                            	 11446:     even
                            	 11447: _L_z04_UpdateLamnola_Draw:
02:0003DB12 4EB90003114A    	 11448:     jsr     Anim_WriteSprite
02:0003DB18 101D            	 11449:     move.b  (A5)+,D0  ; PLA
02:0003DB1A 19802070        	 11450:     move.b  D0,($70,A4,D2.W)
02:0003DB1E 41EC0098        	 11451:     lea     ($0098,A4),A0
02:0003DB22 10302000        	 11452:     move.b  (A0,D2.W),D0
02:0003DB26 1B00            	 11453:     move.b  D0,-(A5)  ; PHA
02:0003DB28 4EB9000311CA    	 11454:     jsr     CheckMonsterCollisions
02:0003DB2E 101D            	 11455:     move.b  (A5)+,D0  ; PLA
02:0003DB30 41EC0098        	 11456:     lea     ($0098,A4),A0
02:0003DB34 11802000        	 11457:     move.b  D0,(A0,D2.W)
                            	 11458:     ; If still alive, then return.
                            	 11459:     ;
02:0003DB38 41EC0405        	 11460:     lea     ($0405,A4),A0
02:0003DB3C 10302000        	 11461:     move.b  (A0,D2.W),D0
02:0003DB40 6604            	 11462:     bne.s  __far_z_04_0109
02:0003DB42 6000FF72        	 11463:     jmp  L129EA_Exit
                            	 11464: __far_z_04_0109:
                            	 11465:     ; Otherwise, the segment is dead.
                            	 11466:     ;
02:0003DB46 4EB90004A398    	 11467:     jsr     ResetShoveInfo
                            	 11468:     ; Set the current segment's HP to the initial value in anticipation
                            	 11469:     ; of bringing this segment back to life.
                            	 11470:     ;
02:0003DB4C 7020            	 11471:     moveq   #32,D0
02:0003DB4E 41EC0485        	 11472:     lea     ($0485,A4),A0
02:0003DB52 11802000        	 11473:     move.b  D0,(A0,D2.W)
                            	 11474:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11475:     ;
                            	 11476:     ; From the lowest slot, look for one that has the original lamnola
                            	 11477:     ; object type.
                            	 11478:     ;
                            	 11479:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11480:     ;
02:0003DB56 163C00FF        	 11481:     move.b  #$FF,D3
02:0003DB5A 0C020006        	 11482:     cmpi.b  #$06,D2
02:0003DB5E 6502            	 11483:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003DB60 7604            	 11484:     moveq   #4,D3
                            	 11485:     even
                            	 11486: _L_z04_UpdateLamnola_FindTail:
02:0003DB62 5203            	 11487:     addq.b  #1,D3
02:0003DB64 41EC0350        	 11488:     lea     ($0350,A4),A0
02:0003DB68 10303000        	 11489:     move.b  (A0,D3.W),D0
02:0003DB6C 122C04E7        	 11490:     move.b  ($04E7,A4),D1
02:0003DB70 B001            	 11491:     cmp.b   D1,D0
02:0003DB72 66EE            	 11492:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11493:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11494:     ;
02:0003DB74 7011            	 11495:     moveq   #17,D0
02:0003DB76 19803029        	 11496:     move.b  D0,($29,A4,D3.W)
                            	 11497:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11498:     ; to the tail segment.
                            	 11499:     ;
02:0003DB7A 41EC04F0        	 11500:     lea     ($04F0,A4),A0
02:0003DB7E 10302000        	 11501:     move.b  (A0,D2.W),D0
02:0003DB82 41EC04F1        	 11502:     lea     ($04F1,A4),A0
02:0003DB86 11803000        	 11503:     move.b  D0,(A0,D3.W)
02:0003DB8A 10342070        	 11504:     move.b  ($70,A4,D2.W),D0
02:0003DB8E 19803071        	 11505:     move.b  D0,($71,A4,D3.W)
02:0003DB92 41EC0084        	 11506:     lea     ($0084,A4),A0
02:0003DB96 10302000        	 11507:     move.b  (A0,D2.W),D0
02:0003DB9A 41EC0085        	 11508:     lea     ($0085,A4),A0
02:0003DB9E 11803000        	 11509:     move.b  D0,(A0,D3.W)
                            	 11510:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11511:     ; So, return and leave it dead.
                            	 11512:     ;
02:0003DBA2 0C030004        	 11513:     cmpi.b  #$04,D3
02:0003DBA6 6604            	 11514:     bne.s  __far_z_04_0110
02:0003DBA8 6000FF0C        	 11515:     jmp  L129EA_Exit
                            	 11516: __far_z_04_0110:
02:0003DBAC 0C030009        	 11517:     cmpi.b  #$09,D3
02:0003DBB0 6604            	 11518:     bne.s  __far_z_04_0111
02:0003DBB2 6000FF02        	 11519:     jmp  L129EA_Exit
                            	 11520: __far_z_04_0111:
                            	 11521:     ; Change the tail segment to the dead dummy object, and
                            	 11522:     ; bring the current segment back to life.
                            	 11523:     ;
02:0003DBB6 705D            	 11524:     moveq   #93,D0
02:0003DBB8 41EC0350        	 11525:     lea     ($0350,A4),A0
02:0003DBBC 11803000        	 11526:     move.b  D0,(A0,D3.W)
02:0003DBC0 4EF90004C1F0    	 11527:     jmp     ResetObjMetastate
                            	 11528: 
                            	 11529:     even
                            	 11530: L12A6F_Exit:
02:0003DBC6 4E75            	 11531:     rts
                            	 11532: 
                            	 11533:     even
                            	 11534: Lamnola_UpdateHead:
                            	 11535:     ; If X coordinate is not a multiple of 8, then return.
                            	 11536:     ;
02:0003DBC8 10342070        	 11537:     move.b  ($70,A4,D2.W),D0
02:0003DBCC 02000007        	 11538:     andi.b #$07,D0
02:0003DBD0 6702            	 11539:     beq.s  __far_z_04_0112
02:0003DBD2 60F2            	 11540:     jmp  L12A6F_Exit
                            	 11541: __far_z_04_0112:
                            	 11542:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11543:     ; We had to account for the usual offset of 3.
                            	 11544:     ;
02:0003DBD4 41EC0084        	 11545:     lea     ($0084,A4),A0
02:0003DBD8 10302000        	 11546:     move.b  (A0,D2.W),D0
02:0003DBDC 023C00EE        	 11547:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DBE0 123C0003        	 11548:     move.b  #$03,D1
02:0003DBE4 D101            	 11549:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003DBE6 02000007        	 11550:     andi.b #$07,D0
02:0003DBEA 6702            	 11551:     beq.s  __far_z_04_0113
02:0003DBEC 60D8            	 11552:     jmp  L12A6F_Exit
                            	 11553: __far_z_04_0113:
                            	 11554:     ; Will loop 4 times, propagating directions down the chain,
                            	 11555:     ; by pulling from the bottom.
                            	 11556:     ;
02:0003DBEE 7004            	 11557:     moveq   #4,D0
02:0003DBF0 1880            	 11558:     move.b  D0,($0000,A4)
                            	 11559:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11560:     ;
02:0003DBF2 7600            	 11561:     moveq   #0,D3
02:0003DBF4 0C020005        	 11562:     cmpi.b  #$05,D2
02:0003DBF8 6702            	 11563:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003DBFA 7605            	 11564:     moveq   #5,D3
                            	 11565:     even
                            	 11566: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11567:     ; Loop over every segment under the head, starting from the tail.
                            	 11568:     ; Copy the next segment's direction to the current one in this loop.
                            	 11569:     ;
02:0003DBFC 41EC009A        	 11570:     lea     ($009A,A4),A0
02:0003DC00 10303000        	 11571:     move.b  (A0,D3.W),D0
02:0003DC04 41EC0099        	 11572:     lea     ($0099,A4),A0
02:0003DC08 11803000        	 11573:     move.b  D0,(A0,D3.W)
02:0003DC0C 5203            	 11574:     addq.b  #1,D3
02:0003DC0E 5314            	 11575:     subq.b  #1,($0000,A4)
02:0003DC10 66EA            	 11576:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11577:     ; If this head segment is not aligned with a square, then return.
                            	 11578:     ;
02:0003DC12 10342070        	 11579:     move.b  ($70,A4,D2.W),D0
02:0003DC16 0200000F        	 11580:     andi.b #$0F,D0
02:0003DC1A 660000BA        	 11581:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11582:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11583:     ; We had to account for the usual offset of 3.
                            	 11584:     ;
02:0003DC1E 41EC0084        	 11585:     lea     ($0084,A4),A0
02:0003DC22 10302000        	 11586:     move.b  (A0,D2.W),D0
02:0003DC26 023C00EE        	 11587:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DC2A 123C0003        	 11588:     move.b  #$03,D1
02:0003DC2E D101            	 11589:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003DC30 0200000F        	 11590:     andi.b #$0F,D0
02:0003DC34 660000A0        	 11591:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11592:     ; Store the opposite of the facing direction in [00].
                            	 11593:     ;
02:0003DC38 41EC0098        	 11594:     lea     ($0098,A4),A0
02:0003DC3C 10302000        	 11595:     move.b  (A0,D2.W),D0
02:0003DC40 E208            	 11596:     lsr.b  #1,D0   ; LSR A
02:0003DC42 02000005        	 11597:     andi.b #$05,D0
02:0003DC46 1880            	 11598:     move.b  D0,($0000,A4)
02:0003DC48 41EC0098        	 11599:     lea     ($0098,A4),A0
02:0003DC4C 10302000        	 11600:     move.b  (A0,D2.W),D0
02:0003DC50 E308            	 11601:     lsl.b  #1,D0   ; ASL A
02:0003DC52 0200000A        	 11602:     andi.b #$0A,D0
02:0003DC56 1214            	 11603:     move.b  ($0000,A4),D1
02:0003DC58 8001            	 11604:     or.b  D1,D0
                            	 11605:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11606:     ;
02:0003DC5A 0A00000F        	 11607:     eori.b #$0F,D0
02:0003DC5E 1940050F        	 11608:     move.b  D0,($050F,A4)
                            	 11609:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11610:     ;
02:0003DC62 10342018        	 11611:     move.b  ($18,A4,D2.W),D0
02:0003DC66 0C000080        	 11612:     cmpi.b  #$80,D0
02:0003DC6A 656C            	 11613:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11614:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11615:     ; Load the monster's facing direction.
                            	 11616:     ;
02:0003DC6C 41EC0098        	 11617:     lea     ($0098,A4),A0
02:0003DC70 10302000        	 11618:     move.b  (A0,D2.W),D0
                            	 11619:     ; Load the next random number into Y register.
                            	 11620:     ;
02:0003DC74 7600            	 11621:     moveq   #0,D3
02:0003DC76 16342019        	 11622:     move.b  ($19,A4,D2.W),D3
                            	 11623:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11624:     ; to keep moving straight.
                            	 11625:     ;
02:0003DC7A 0C030080        	 11626:     cmpi.b  #$80,D3
02:0003DC7E 6418            	 11627:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11628:     even
                            	 11629: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11630:     ; Loop to rotate the direction bit over the mask.
                            	 11631:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11632:     ; facing direction.
                            	 11633:     ;
                            	 11634:     ; Shift right the copy of the direction.
                            	 11635:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11636:     ;
02:0003DC80 E208            	 11637:     lsr.b  #1,D0   ; LSR A
02:0003DC82 6402            	 11638:     bcc  _anon_z04_151
02:0003DC84 7008            	 11639:     moveq   #8,D0
                            	 11640: _anon_z04_151:
                            	 11641:     ; If the current direction bit is masked off, then we've reached
                            	 11642:     ; the opposite direction. Loop again.
                            	 11643:     ;
02:0003DC86 122C050F        	 11644:     move.b  ($050F,A4),D1
02:0003DC8A C200            	 11645:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DC8C 67F2            	 11646:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11647:     ; If Y register >= $40, then break out of the loop.
                            	 11648:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11649:     ;
02:0003DC8E 0C030040        	 11650:     cmpi.b  #$40,D3
02:0003DC92 6404            	 11651:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11652:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11653:     ; and loop again now.
                            	 11654:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11655:     ;
02:0003DC94 7640            	 11656:     moveq   #64,D3
02:0003DC96 65E8            	 11657:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11658:     even
                            	 11659: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11660:     ; Change the facing direction to the direction found.
                            	 11661:     ;
02:0003DC98 41EC0098        	 11662:     lea     ($0098,A4),A0
02:0003DC9C 11802000        	 11663:     move.b  D0,(A0,D2.W)
                            	 11664:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11665:     ;
02:0003DCA0 1940000F        	 11666:     move.b  D0,($000F,A4)
02:0003DCA4 4EB900030934    	 11667:     jsr     BoundByRoom
                            	 11668:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11669:     ;
02:0003DCAA 102C000F        	 11670:     move.b  ($000F,A4),D0
02:0003DCAE 6618            	 11671:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11672:     even
                            	 11673: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11674:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11675:     ; for looking for any non-opposite direction that is not blocked.
                            	 11676:     ;
02:0003DCB0 41EC0098        	 11677:     lea     ($0098,A4),A0
02:0003DCB4 10302000        	 11678:     move.b  (A0,D2.W),D0
                            	 11679:     even
                            	 11680: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11681:     ; Shift right the copy of the direction.
                            	 11682:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11683:     ;
02:0003DCB8 E208            	 11684:     lsr.b  #1,D0   ; LSR A
02:0003DCBA 6402            	 11685:     bcc  _anon_z04_152
02:0003DCBC 7008            	 11686:     moveq   #8,D0
                            	 11687: _anon_z04_152:
                            	 11688:     ; If the current direction bit is not masked off, then go check the
                            	 11689:     ; room boundary in this direction.
                            	 11690:     ; Else we've reached the opposite direction. Loop again.
                            	 11691:     ;
02:0003DCBE 122C050F        	 11692:     move.b  ($050F,A4),D1
02:0003DCC2 C200            	 11693:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DCC4 66D2            	 11694:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003DCC6 67F0            	 11695:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11696:     even
                            	 11697: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11698:     ; We found a direction that was not blocked by the room boundary.
                            	 11699:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11700:     ;
02:0003DCC8 4EB90004A324    	 11701:     jsr     GetCollidingTileMoving
02:0003DCCE 122C034A        	 11702:     move.b  ($034A,A4),D1
02:0003DCD2 B001            	 11703:     cmp.b   D1,D0
02:0003DCD4 64DA            	 11704:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11705:     even
                            	 11706: _L_z04_Lamnola_UpdateHead_Exit:
                            	 11707:     ; TODO: confirm this
                            	 11708:     ;
                            	 11709:     ; If there were a room that had lamnolas, and they could get
                            	 11710:     ; surrounded on 3 sides, then the loop above would get stuck in
                            	 11711:     ; an infinite loop.
                            	 11712:     ;
                            	 11713:     ; But, the only room with that configuration has those blocks
                            	 11714:     ; blocked off with a push block, which can only be pushed after
                            	 11715:     ; all monsters are killed.
                            	 11716:     ;
02:0003DCD6 4E75            	 11717:     rts
                            	 11718: 
                            	 11719:     even
                            	 11720: _L_z04_Lamnola_UpdateHead_TurnTowardLink:
                            	 11721:     ; Find the horizontal direction toward Link and store it in [02].
                            	 11722:     ;
02:0003DCD8 7001            	 11723:     moveq   #1,D0
02:0003DCDA 19400002        	 11724:     move.b  D0,($0002,A4)
02:0003DCDE 102C0070        	 11725:     move.b  ($0070,A4),D0
02:0003DCE2 003C0011        	 11726:     ori     #$11,CCR  ; SEC: set C+X
02:0003DCE6 12342070        	 11727:     move.b  ($70,A4,D2.W),D1
02:0003DCEA 0A3C0010        	 11728:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DCEE 9101            	 11729:     subx.b  D1,D0   ; SBC ObjX,X
02:0003DCF0 0A3C0010        	 11730:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DCF4 640A            	 11731:     bcc  _anon_z04_153
02:0003DCF6 122C0002        	 11732:     move.b  ($0002,A4),D1
02:0003DCFA E309            	 11733:     lsl.b  #1,D1   ; ASL $02
02:0003DCFC 19410002        	 11734:     move.b  D1,($0002,A4)
                            	 11735: _anon_z04_153:
                            	 11736:     ; Find the vertical direction toward Link and store it in [03].
                            	 11737:     ;
02:0003DD00 7004            	 11738:     moveq   #4,D0
02:0003DD02 19400003        	 11739:     move.b  D0,($0003,A4)
02:0003DD06 102C0084        	 11740:     move.b  ($0084,A4),D0
02:0003DD0A 003C0011        	 11741:     ori     #$11,CCR  ; SEC: set C+X
02:0003DD0E 41EC0084        	 11742:     lea     ($0084,A4),A0
02:0003DD12 12302000        	 11743:     move.b  (A0,D2.W),D1
02:0003DD16 0A3C0010        	 11744:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DD1A 9101            	 11745:     subx.b  D1,D0   ; SBC ObjY,X
02:0003DD1C 0A3C0010        	 11746:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DD20 640A            	 11747:     bcc  _anon_z04_154
02:0003DD22 122C0003        	 11748:     move.b  ($0003,A4),D1
02:0003DD26 E309            	 11749:     lsl.b  #1,D1   ; ASL $03
02:0003DD28 19410003        	 11750:     move.b  D1,($0003,A4)
                            	 11751: _anon_z04_154:
                            	 11752:     ; If the horizontal direction toward Link is not allowed, then
                            	 11753:     ; go check the vertical direction.
                            	 11754:     ;
02:0003DD2C 102C0002        	 11755:     move.b  ($0002,A4),D0
