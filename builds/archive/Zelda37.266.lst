02:00039E06 11802000        	  3167:     move.b  D0,(A0,D2.W)
                            	  3168:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3169:     ;
02:00039E0A 10342019        	  3170:     move.b  ($19,A4,D2.W),D0
02:00039E0E 0C0000C0        	  3171:     cmpi.b  #$C0,D0
02:00039E12 6506            	  3172:     bcs  _anon_z04_43
02:00039E14 4EB90004A8D0    	  3173:     jsr     ReverseObjDir
                            	  3174: _anon_z04_43:
                            	  3175:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3176:     ;
02:00039E1A 41EC0098        	  3177:     lea     ($0098,A4),A0
02:00039E1E 10302000        	  3178:     move.b  (A0,D2.W),D0
02:00039E22 0200000C        	  3179:     andi.b #$0C,D0
02:00039E26 6742            	  3180:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3181:     ; Begin with the leever's X set to Link's X.
