                            	  1797: InitTrap_Full:
                            	  1798:     ; Copy this parent/generator object's attributes to [01].
                            	  1799:     ;
02:00030490 41EC04BF        	  1800:     lea     ($04BF,A4),A0
02:00030494 10302000        	  1801:     move.b  (A0,D2.W),D0
02:00030498 19400001        	  1802:     move.b  D0,($0001,A4)
                            	  1803:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  1804:     ;
02:0003049C 7605            	  1805:     moveq   #5,D3
                            	  1806:     ; The individual trap objects to make will be of type $49.
                            	  1807:     ; Store it in [00].
                            	  1808:     ;
02:0003049E 7049            	  1809:     moveq   #73,D0
02:000304A0 1880            	  1810:     move.b  D0,($0000,A4)
                            	  1811:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  1812:     ; then we'll make 4 traps.
                            	  1813:     ;
02:000304A2 41EC034F        	  1814:     lea     ($034F,A4),A0
02:000304A6 12302000        	  1815:     move.b  (A0,D2.W),D1
02:000304AA B001            	  1816:     cmp.b   D1,D0
02:000304AC 6702            	  1817:     beq  _L_z01_InitTrap_Full_LoopTrap
02:000304AE 7603            	  1818:     moveq   #3,D3
                            	  1819:     even
                            	  1820: _L_z01_InitTrap_Full_LoopTrap:
                            	  1821:     ; Loop over each trap to make, from the last index (5 or 3) to 0.
                            	  1822:     ;
02:000304B0 1003            	  1823:     move.b  D3,D0
02:000304B2 023C00EE        	  1824:     andi    #$EE,CCR  ; CLC: clear C+X
                            	  1825:     ; Add the loop index to the current object slot, and switch the X register to it.
                            	  1826:     ;
02:000304B6 122C0340        	  1827:     move.b  ($0340,A4),D1
02:000304BA D101            	  1828:     addx.b  D1,D0   ; ADC CurObjIndex
02:000304BC 7400            	  1829:     moveq   #0,D2
02:000304BE 1400            	  1830:     move.b  D0,D2
                            	  1831:     ; Look up and set the location for this iteration's individual trap.
                            	  1832:     ;
02:000304C0 41F900030484    	  1833:     lea     (TrapXs).l,A0
02:000304C6 10303000        	  1834:     move.b  (A0,D3.W),D0
02:000304CA 19802070        	  1835:     move.b  D0,($70,A4,D2.W)
02:000304CE 41F90003048A    	  1836:     lea     (TrapYs).l,A0
02:000304D4 10303000        	  1837:     move.b  (A0,D3.W),D0
02:000304D8 41EC0084        	  1838:     lea     ($0084,A4),A0
02:000304DC 11802000        	  1839:     move.b  D0,(A0,D2.W)
02:000304E0 619E            	  1840:     jsr     InitOneSimpleObject
02:000304E2 5302            	  1841:     subq.b  #1,D2
02:000304E4 5303            	  1842:     subq.b  #1,D3
02:000304E6 6AC8            	  1843:     bpl  _L_z01_InitTrap_Full_LoopTrap
02:000304E8 4E75            	  1844:     rts
