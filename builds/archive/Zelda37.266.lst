02:0003CF0C 0A3C0010        	  9885:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003CF10 9101            	  9886:     subx.b  D1,D0   ; SBC #$10
02:0003CF12 0A3C0010        	  9887:     eori    #$10,CCR  ; restore X = 6502 C
02:0003CF16 19802070        	  9888:     move.b  D0,($70,A4,D2.W)
