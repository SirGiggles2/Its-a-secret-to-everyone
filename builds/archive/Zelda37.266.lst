                            	  1434: UpdateZolState2_Split:
                            	  1435:     ; We'll create two gels, but destroy the zol. So, increase
                            	  1436:     ; the object count by 1 only.
                            	  1437:     ;
02:00039232 522C034E        	  1438:     addq.b  #1,($034E,A4)
02:00039236 4EB90004C1CC    	  1439:     jsr     DestroyMonster
02:0003923C 612C            	  1440:     jsr     CreateChildGel
                            	  1441:     ; If the zol's direction is vertical, then set the first child gel's
                            	  1442:     ; direction to left, else up.
                            	  1443:     ;
02:0003923E 41EC0098        	  1444:     lea     ($0098,A4),A0
02:00039242 10302000        	  1445:     move.b  (A0,D2.W),D0
02:00039246 0C000004        	  1446:     cmpi.b  #$04,D0
02:0003924A 7002            	  1447:     moveq   #2,D0
02:0003924C 6402            	  1448:     bcc  _anon_z04_25
02:0003924E 7008            	  1449:     moveq   #8,D0
                            	  1450: _anon_z04_25:
02:00039250 41EC0098        	  1451:     lea     ($0098,A4),A0
02:00039254 11803000        	  1452:     move.b  D0,(A0,D3.W)
