02:0003BD00 7008            	  7492:     moveq   #8,D0
02:0003BD02 4EB90004B9EA    	  7493:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7494:     ; If facing left, then enable horizontal flipping.
