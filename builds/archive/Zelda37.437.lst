02:0003EB32 12303000        	  3872:     move.b  (A0,D3.W),D1
02:0003EB36 B001            	  3873:     cmp.b   D1,D0
02:0003EB38 6622            	  3874:     bne  _anon_z05_95
02:0003EB3A 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003EB3E 41F90003EB0A    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003EB44 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003EB48 B001            	  3878:     cmp.b   D1,D0
02:0003EB4A 6510            	  3879:     bcs  _anon_z05_95
02:0003EB4C 41F90003EB0E    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EB52 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003EB56 B001            	  3882:     cmp.b   D1,D0
02:0003EB58 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
