                            	  5422: _L_z05_L_LayOutDoors_LoopHalves_LoopRowTile:
02:000400D4 122C0002        	  5423:     move.b  ($02,A4),D1   ; ptr lo
02:000400D8 182C0003        	  5424:     move.b  ($03,A4),D4  ; ptr hi
02:000400DC 024100FF        	  5425:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000400E0 E14C            	  5426:     lsl.w   #8,D4
02:000400E2 8841            	  5427:     or.w    D1,D4             ; D4 = NES ptr addr
02:000400E4 48C4            	  5428:     ext.l   D4
02:000400E6 D8BC00FF0000    	  5429:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000400EC 2044            	  5430:     movea.l D4,A0
02:000400EE 10303000        	  5431:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000400F2 1214            	  5432:     move.b  ($00,A4),D1   ; ptr lo
02:000400F4 182C0001        	  5433:     move.b  ($01,A4),D4  ; ptr hi
02:000400F8 024100FF        	  5434:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000400FC E14C            	  5435:     lsl.w   #8,D4
02:000400FE 8841            	  5436:     or.w    D1,D4
02:00040100 48C4            	  5437:     ext.l   D4
02:00040102 D8BC00FF0000    	  5438:     add.l   #NES_RAM,D4
02:00040108 2044            	  5439:     movea.l D4,A0
02:0004010A 11803000        	  5440:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
02:0004010E 4EB900030A0A    	  5441:     jsr     Add1ToInt16At2
02:00040114 41F90003FFA8    	  5442:     lea     (NextDoorTileOffsets).l,A0
02:0004011A 10302000        	  5443:     move.b  (A0,D2.W),D0
02:0004011E 4EB900030A06    	  5444:     jsr     AddToInt16At0
                            	  5445:     ; If we're at the last row, and the direction is horizontal (< 2), then
                            	  5446:     ; go 1 more tile down, to start the next column at the right place.
                            	  5447:     ; We have to compensate for the fact that E/W doors are 
                            	  5448:     ; shorter vertically than N/S doors.
02:00040124 4A02            	  5449:     cmpi.b  #$00,D2
02:00040126 6610            	  5450:     bne  _anon_z05_115
02:00040128 101D            	  5451:     move.b  (A5)+,D0  ; PLA
02:0004012A 1B00            	  5452:     move.b  D0,-(A5)  ; PHA
02:0004012C 0C000002        	  5453:     cmpi.b  #$02,D0
02:00040130 6406            	  5454:     bcc  _anon_z05_115
02:00040132 4EB900030A02    	  5455:     jsr     Add1ToInt16At0
