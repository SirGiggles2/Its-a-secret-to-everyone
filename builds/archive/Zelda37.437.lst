02:00035544 182C0001        	  5091:     move.b  ($01,A4),D4  ; ptr hi
02:00035548 024100FF        	  5092:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003554C E14C            	  5093:     lsl.w   #8,D4
02:0003554E 8841            	  5094:     or.w    D1,D4             ; D4 = NES ptr addr
