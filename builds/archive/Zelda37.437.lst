02:0004907C 0200000F        	  5983:     andi.b #$0F,D0
02:00049080 0C000001        	  5984:     cmpi.b  #$01,D0
02:00049084 6604            	  5985:     bne.s  __far_z_07_0086
02:00049086 600000AA        	  5986:     jmp  L1F854_Exit
                            	  5987: __far_z_07_0086:
                            	  5988:     ; Set Y to the right item slot to pass to the routine to write sprites:
                            	  5989:     ; sword or rod
                            	  5990:     ;
                            	  5991:     ;
                            	  5992:     ; Sword slot
