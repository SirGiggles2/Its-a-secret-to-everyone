                            	  8417: ; Description:
                            	  8418: ; Lift up the Triforce of Courage while the room is dark.
                            	  8419: ;
                            	  8420: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8421: ;
                            	  8422:     even
                            	  8423: Ganon_ScenePhase0:
02:0003BF20 701B            	  8424:     moveq   #27,D0
02:0003BF22 19400505        	  8425:     move.b  D0,($0505,A4)
                            	  8426:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  8427:     ;
02:0003BF26 102C0028        	  8428:     move.b  ($0028,A4),D0
02:0003BF2A 6644            	  8429:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8430:     ; Once the timer expires, it's time to brighten the room.
                            	  8431:     ;
                            	  8432:     ; Save the current object slot.
02:0003BF2C 1002            	  8433:     move.b  D2,D0
02:0003BF2E 1B00            	  8434:     move.b  D0,-(A5)  ; PHA
02:0003BF30 610007F0        	  8435:     jsr     UpdateCandle
02:0003BF34 101D            	  8436:     move.b  (A5)+,D0  ; PLA
02:0003BF36 7400            	  8437:     moveq   #0,D2
02:0003BF38 1400            	  8438:     move.b  D0,D2
                            	  8439:     ; Turn off the room brightening flag, because we're controlling it
                            	  8440:     ; here instead of in the Mode 5 object update loop.
                            	  8441:     ;
02:0003BF3A 7000            	  8442:     moveq   #0,D0
02:0003BF3C 1940051E        	  8443:     move.b  D0,($051E,A4)
                            	  8444:     ; On the first frame of the fade-to-light cycle, play the
                            	  8445:     ; Triforce/Ganon song.
                            	  8446:     ;
02:0003BF40 102C051C        	  8447:     move.b  ($051C,A4),D0
02:0003BF44 0C0000C0        	  8448:     cmpi.b  #$C0,D0
02:0003BF48 6606            	  8449:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BF4A 7002            	  8450:     moveq   #2,D0
02:0003BF4C 19400600        	  8451:     move.b  D0,($0600,A4)
