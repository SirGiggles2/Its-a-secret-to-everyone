                            	  8937: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8938:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8939:     ;
02:0003C29C 10342070        	  8940:     move.b  ($70,A4,D2.W),D0
02:0003C2A0 023C00EE        	  8941:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2A4 41F90003C28E    	  8942:     lea     (GanonSpriteOffsetsX).l,A0
02:0003C2AA 12303000        	  8943:     move.b  (A0,D3.W),D1
02:0003C2AE D101            	  8944:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003C2B0 1880            	  8945:     move.b  D0,($0000,A4)
                            	  8946:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8947:     ;
02:0003C2B2 41EC0084        	  8948:     lea     ($0084,A4),A0
02:0003C2B6 10302000        	  8949:     move.b  (A0,D2.W),D0
02:0003C2BA 023C00EE        	  8950:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2BE 41F90003C292    	  8951:     lea     (GanonSpriteOffsetsY).l,A0
02:0003C2C4 12303000        	  8952:     move.b  (A0,D3.W),D1
02:0003C2C8 D101            	  8953:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003C2CA 19400001        	  8954:     move.b  D0,($0001,A4)
                            	  8955:     ; Each part has a horizontal flipping flag.
                            	  8956:     ;
02:0003C2CE 41F90003C296    	  8957:     lea     (GanonSpriteHFlips).l,A0
02:0003C2D4 10303000        	  8958:     move.b  (A0,D3.W),D0
02:0003C2D8 1940000F        	  8959:     move.b  D0,($000F,A4)
                            	  8960:     ; Save and copy the loop index (the current part) to [07].
                            	  8961:     ;
02:0003C2DC 1003            	  8962:     move.b  D3,D0
02:0003C2DE 1B00            	  8963:     move.b  D0,-(A5)  ; PHA
02:0003C2E0 19400007        	  8964:     move.b  D0,($0007,A4)
                            	  8965:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8966:     ; that make it up.
                            	  8967:     ;
02:0003C2E4 41EC046B        	  8968:     lea     ($046B,A4),A0
02:0003C2E8 10302000        	  8969:     move.b  (A0,D2.W),D0
02:0003C2EC E308            	  8970:     lsl.b  #1,D0   ; ASL A
02:0003C2EE E308            	  8971:     lsl.b  #1,D0   ; ASL A
                            	  8972:     ; Add [07] -- the index of the current part.
                            	  8973:     ;
                            	  8974:     ; Now you have an index into the frame image table, for the
                            	  8975:     ; current image part of the current animation frame.
                            	  8976:     ;
02:0003C2F0 122C0007        	  8977:     move.b  ($0007,A4),D1
02:0003C2F4 D101            	  8978:     addx.b  D1,D0   ; ADC $07
02:0003C2F6 7600            	  8979:     moveq   #0,D3
02:0003C2F8 1600            	  8980:     move.b  D0,D3
02:0003C2FA 41F90003C276    	  8981:     lea     (GanonFrameImages).l,A0
02:0003C300 10303000        	  8982:     move.b  (A0,D3.W),D0
02:0003C304 4EB900030D52    	  8983:     jsr     DrawObjectNotMirrored
02:0003C30A 101D            	  8984:     move.b  (A5)+,D0  ; PLA
                            	  8985:     ; Bottom of the part loop.
                            	  8986:     ;
02:0003C30C 7600            	  8987:     moveq   #0,D3
02:0003C30E 1600            	  8988:     move.b  D0,D3
02:0003C310 5303            	  8989:     subq.b  #1,D3
02:0003C312 6A88            	  8990:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003C314 4E75            	  8991:     rts
