02:00041C12 61005808        	  8532:     jsr     GetRoomFlags
02:00041C16 102C00EB        	  8533:     move.b  ($00EB,A4),D0
02:00041C1A 1B00            	  8534:     move.b  D0,-(A5)  ; PHA
                            	  8535:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8536:     ; in order to look up its information.
                            	  8537:     ;
02:00041C1C 102C005D        	  8538:     move.b  ($005D,A4),D0
02:00041C20 194000EB        	  8539:     move.b  D0,($00EB,A4)
                            	  8540:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8541:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8542:     ; map mark tile.
                            	  8543:     ;
02:00041C24 7013            	  8544:     moveq   #19,D0
02:00041C26 1940033F        	  8545:     move.b  D0,($033F,A4)
                            	  8546:     ; Get the currently scanned room's visit state.
                            	  8547:     ;
02:00041C2A 7600            	  8548:     moveq   #0,D3
02:00041C2C 162C00EB        	  8549:     move.b  ($00EB,A4),D3
02:00041C30 1214            	  8550:     move.b  ($00,A4),D1   ; ptr lo
02:00041C32 182C0001        	  8551:     move.b  ($01,A4),D4  ; ptr hi
02:00041C36 024100FF        	  8552:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041C3A E14C            	  8553:     lsl.w   #8,D4
02:00041C3C 8841            	  8554:     or.w    D1,D4             ; D4 = NES ptr addr
02:00041C3E 48C4            	  8555:     ext.l   D4
02:00041C40 D8BC00FF0000    	  8556:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00041C46 2044            	  8557:     movea.l D4,A0
02:00041C48 10303000        	  8558:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00041C4C 02000020        	  8559:     andi.b #$20,D0
                            	  8560:     ; If it's been visited, then check each of the 4 doors,
                            	  8561:     ; and build an open door mask.
                            	  8562:     ;
                            	  8563:     ; Start with direction up and direction index 3.
                            	  8564:     ;
