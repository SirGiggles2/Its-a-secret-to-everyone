                            	  4980: _L_z02_DrawCredits_TerminateRecords:
                            	  4981:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  4982:     ; attributes or only tiles.
                            	  4983:     ;
02:0003544E 103C00FF        	  4984:     move.b  #$FF,D0
02:00035452 19400325        	  4985:     move.b  D0,($0325,A4)
02:00035456 19400330        	  4986:     move.b  D0,($0330,A4)
                            	  4987:     ; Specify that we're transferring $20 bytes/tiles.
                            	  4988:     ;
02:0003545A 7020            	  4989:     moveq   #32,D0
02:0003545C 19400304        	  4990:     move.b  D0,($0304,A4)
                            	  4991:     ; Write the high byte of the current VRAM page.
                            	  4992:     ;
02:00035460 7400            	  4993:     moveq   #0,D2
02:00035462 142C050C        	  4994:     move.b  ($050C,A4),D2
02:00035466 41F90003520C    	  4995:     lea     (CreditLineVramAddrsHi).l,A0
02:0003546C 10302000        	  4996:     move.b  (A0,D2.W),D0
02:00035470 19400302        	  4997:     move.b  D0,($0302,A4)
                            	  4998:     ; The line number will be used to shift the task mask below.
                            	  4999:     ;
02:00035474 102C050D        	  5000:     move.b  ($050D,A4),D0
02:00035478 7600            	  5001:     moveq   #0,D3
02:0003547A 1600            	  5002:     move.b  D0,D3
                            	  5003:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5004:     ;
02:0003547C E308            	  5005:     lsl.b  #1,D0   ; ASL A
02:0003547E E308            	  5006:     lsl.b  #1,D0   ; ASL A
02:00035480 E308            	  5007:     lsl.b  #1,D0   ; ASL A
02:00035482 E308            	  5008:     lsl.b  #1,D0   ; ASL A
02:00035484 E308            	  5009:     lsl.b  #1,D0   ; ASL A
02:00035486 19400303        	  5010:     move.b  D0,($0303,A4)
                            	  5011:     ; Get the mask for the current VRAM page.
                            	  5012:     ;
02:0003548A 41F900035218    	  5013:     lea     (CreditsPagesTextMasks).l,A0
02:00035490 10302000        	  5014:     move.b  (A0,D2.W),D0
                            	  5015: _anon_z02_43:
                            	  5016:     ; Shift left as many times as the current VRAM line number,
                            	  5017:     ; to get the bit that indicates whether this line has text.
                            	  5018:     ;
02:00035494 E308            	  5019:     lsl.b  #1,D0   ; ASL A
02:00035496 5303            	  5020:     subq.b  #1,D3
02:00035498 6AFA            	  5021:     bpl  _anon_z02_43
02:0003549A 6400013E        	  5022:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5023:     ; The mask inidcates that it should have text.
                            	  5024:     ; But if line index >= $17, then it doesn't.
                            	  5025:     ;
02:0003549E 7600            	  5026:     moveq   #0,D3
02:000354A0 162C050E        	  5027:     move.b  ($050E,A4),D3
02:000354A4 0C030017        	  5028:     cmpi.b  #$17,D3
02:000354A8 64000130        	  5029:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5030:     ; In the first quest, don't consider line numbers >= $10.
                            	  5031:     ;
02:000354AC 7400            	  5032:     moveq   #0,D2
02:000354AE 142C0016        	  5033:     move.b  ($0016,A4),D2
02:000354B2 41EC062D        	  5034:     lea     ($062D,A4),A0
02:000354B6 10302000        	  5035:     move.b  (A0,D2.W),D0
02:000354BA 6608            	  5036:     bne  _anon_z02_44
02:000354BC 0C030010        	  5037:     cmpi.b  #$10,D3
02:000354C0 64000114        	  5038:     bcc  _L_z02_DrawCredits_IncLine
                            	  5039: _anon_z02_44:
02:000354C4 7400            	  5040:     moveq   #0,D2
02:000354C6 142C0016        	  5041:     move.b  ($0016,A4),D2
02:000354CA 41EC062D        	  5042:     lea     ($062D,A4),A0
02:000354CE 10302000        	  5043:     move.b  (A0,D2.W),D0
                            	  5044:     ; In the second quest, skip lines $C to $F.
                            	  5045:     ;
02:000354D2 670E            	  5046:     beq  _anon_z02_45
02:000354D4 0C03000C        	  5047:     cmpi.b  #$0C,D3
02:000354D8 6508            	  5048:     bcs  _anon_z02_45
02:000354DA 0C030010        	  5049:     cmpi.b  #$10,D3
02:000354DE 650000F6        	  5050:     bcs  _L_z02_DrawCredits_IncLine
                            	  5051: _anon_z02_45:
02:000354E2 41F900035224    	  5052:     lea     (CreditsTextAddrsLo).l,A0
02:000354E8 10303000        	  5053:     move.b  (A0,D3.W),D0
02:000354EC 1880            	  5054:     move.b  D0,($0000,A4)
02:000354EE 41F90003523C    	  5055:     lea     (CreditsTextAddrsHi).l,A0
02:000354F4 10303000        	  5056:     move.b  (A0,D3.W),D0
02:000354F8 19400001        	  5057:     move.b  D0,($0001,A4)
                            	  5058:     ; First read the length of the string.
                            	  5059:     ;
02:000354FC 7600            	  5060:     moveq   #0,D3
02:000354FE 1214            	  5061:     move.b  ($00,A4),D1   ; ptr lo
02:00035500 182C0001        	  5062:     move.b  ($01,A4),D4  ; ptr hi
02:00035504 024100FF        	  5063:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035508 E14C            	  5064:     lsl.w   #8,D4
02:0003550A 8841            	  5065:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003550C 48C4            	  5066:     ext.l   D4
02:0003550E D8BC00FF0000    	  5067:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035514 2044            	  5068:     movea.l D4,A0
02:00035516 10303000        	  5069:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003551A 19400002        	  5070:     move.b  D0,($0002,A4)
                            	  5071:     ; Second, read the offset where the first character goes
                            	  5072:     ; in the line.
                            	  5073:     ;
02:0003551E 5203            	  5074:     addq.b  #1,D3
02:00035520 1214            	  5075:     move.b  ($00,A4),D1   ; ptr lo
02:00035522 182C0001        	  5076:     move.b  ($01,A4),D4  ; ptr hi
02:00035526 024100FF        	  5077:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003552A E14C            	  5078:     lsl.w   #8,D4
02:0003552C 8841            	  5079:     or.w    D1,D4             ; D4 = NES ptr addr
02:0003552E 48C4            	  5080:     ext.l   D4
02:00035530 D8BC00FF0000    	  5081:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035536 2044            	  5082:     movea.l D4,A0
02:00035538 10303000        	  5083:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003553C 7400            	  5084:     moveq   #0,D2
02:0003553E 1400            	  5085:     move.b  D0,D2
                            	  5086:     ; Loop over each character in the rest of the credits source record.
                            	  5087:     ;
02:00035540 5203            	  5088:     addq.b  #1,D3
                            	  5089: _anon_z02_46:
