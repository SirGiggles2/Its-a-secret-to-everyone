                            	  8604: ; Params:
                            	  8605: ; A: door attribute
                            	  8606: ; X: direction index
                            	  8607: ;
                            	  8608: ; Returns:
                            	  8609: ; A: untouched
                            	  8610: ;
                            	  8611:     even
