                            	  7173: _L_z07_InitObject_InitMonsterFromEdge:
02:000499C0 7400            	  7174:     moveq   #0,D2
02:000499C2 142C0340        	  7175:     move.b  ($0340,A4),D2
                            	  7176:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7177:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7178:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7179:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7180:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7181:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7182:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7183:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7184:     ; corrupting them and causing a deterministic address-error
                            	  7185:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7186:     ; identified by Codex static review.)
                            	  7187: _L_z07_P47_pre_check:
02:000499C6 102C0525        	  7188:     move.b  ($0525,A4),D0
02:000499CA 020000F0        	  7189:     andi.b  #$F0,D0
02:000499CE 0C000040        	  7190:     cmpi.b  #$40,D0
02:000499D2 6506            	  7191:     blo     _L_z07_P47_pre_snap
02:000499D4 0C0000E0        	  7192:     cmpi.b  #$E0,D0
02:000499D8 6506            	  7193:     blo     _L_z07_P47_pre_ok
                            	  7194: _L_z07_P47_pre_snap:
02:000499DA 197C00480525    	  7195:     move.b  #$48,($0525,A4)
                            	  7196: _L_z07_P47_pre_ok:
02:000499E0 7005            	  7197:     moveq   #5,D0
02:000499E2 610004F4        	  7198:     jsr     SwitchBank
02:000499E6 4EB90003E8E2    	  7199:     jsr     FindNextEdgeSpawnCell
                            	  7200:     ; Post-walk 1: bottom-edge snap.
02:000499EC 102C0525        	  7201:     move.b  ($0525,A4),D0
02:000499F0 020000F0        	  7202:     andi.b  #$F0,D0
02:000499F4 0C0000E0        	  7203:     cmpi.b  #$E0,D0
02:000499F8 660C            	  7204:     bne     _L_z07_P47_post1_ok
02:000499FA 197C00480525    	  7205:     move.b  #$48,($0525,A4)
02:00049A00 4EB90003E8E2    	  7206:     jsr     FindNextEdgeSpawnCell
                            	  7207: _L_z07_P47_post1_ok:
                            	  7208:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7209:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:00049A06 7600            	  7210:     moveq   #0,D3
02:00049A08 162C0525        	  7211:     move.b  ($0525,A4),D3
02:00049A0C 0243000F        	  7212:     andi.w  #$000F,D3
02:00049A10 C6FC002C        	  7213:     mulu.w  #44,D3
02:00049A14 203C00FF6530    	  7214:     move.l  #$FF6530,D0
02:00049A1A D083            	  7215:     add.l   D3,D0
02:00049A1C 7600            	  7216:     moveq   #0,D3
02:00049A1E 162C0525        	  7217:     move.b  ($0525,A4),D3
02:00049A22 E84B            	  7218:     lsr.w   #4,D3
02:00049A24 5943            	  7219:     subi.w  #4,D3
02:00049A26 E34B            	  7220:     lsl.w   #1,D3
02:00049A28 D083            	  7221:     add.l   D3,D0
02:00049A2A 2040            	  7222:     movea.l D0,A0
02:00049A2C 1010            	  7223:     move.b  (A0),D0
02:00049A2E 0C000084        	  7224:     cmpi.b  #$84,D0
02:00049A32 6544            	  7225:     blo     _L_z07_P47_post2_ok
                            	  7226:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7227:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7228:     ; writes to the $05xx region.
02:00049A34 7800            	  7229:     moveq   #0,D4
                            	  7230: _L_z07_P47_fb_loop:
02:00049A36 41FAE566        	  7231:     lea     _L_z07_P47_FallbackCells(pc),A0
02:00049A3A 12304000        	  7232:     move.b  (A0,D4.W),D1
02:00049A3E 19410525        	  7233:     move.b  D1,($0525,A4)
                            	  7234:     ; Validate fallback cell walkable.
02:00049A42 7600            	  7235:     moveq   #0,D3
02:00049A44 1601            	  7236:     move.b  D1,D3
02:00049A46 0243000F        	  7237:     andi.w  #$000F,D3
02:00049A4A C6FC002C        	  7238:     mulu.w  #44,D3
02:00049A4E 203C00FF6530    	  7239:     move.l  #$FF6530,D0
02:00049A54 D083            	  7240:     add.l   D3,D0
02:00049A56 7600            	  7241:     moveq   #0,D3
02:00049A58 1601            	  7242:     move.b  D1,D3
02:00049A5A E84B            	  7243:     lsr.w   #4,D3
02:00049A5C 5943            	  7244:     subi.w  #4,D3
02:00049A5E E34B            	  7245:     lsl.w   #1,D3
02:00049A60 D083            	  7246:     add.l   D3,D0
02:00049A62 2040            	  7247:     movea.l D0,A0
02:00049A64 0C100084        	  7248:     cmpi.b  #$84,(A0)
02:00049A68 650E            	  7249:     blo     _L_z07_P47_post2_ok
02:00049A6A 5204            	  7250:     addq.b  #1,D4
02:00049A6C 0C040008        	  7251:     cmpi.b  #8,D4
02:00049A70 65C4            	  7252:     blo     _L_z07_P47_fb_loop
                            	  7253:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7254:     ; rather than looping).
02:00049A72 197C00480525    	  7255:     move.b  #$48,($0525,A4)
                            	  7256: _L_z07_P47_post2_ok:
                            	  7257:     ; Extract and set the monster's location.
                            	  7258:     ;
02:00049A78 102C0525        	  7259:     move.b  ($0525,A4),D0
                            	  7260:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7261:     ;
02:00049A7C 1B00            	  7262:     move.b  D0,-(A5)  ; PHA
02:00049A7E E308            	  7263:     lsl.b  #1,D0   ; ASL A
02:00049A80 E308            	  7264:     lsl.b  #1,D0   ; ASL A
02:00049A82 E308            	  7265:     lsl.b  #1,D0   ; ASL A
02:00049A84 E308            	  7266:     lsl.b  #1,D0   ; ASL A
02:00049A86 19802070        	  7267:     move.b  D0,($70,A4,D2.W)
                            	  7268:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7269:     ;
02:00049A8A 101D            	  7270:     move.b  (A5)+,D0  ; PLA
02:00049A8C 020000F0        	  7271:     andi.b #$F0,D0
02:00049A90 003C0011        	  7272:     ori     #$11,CCR  ; SEC: set C+X
02:00049A94 123C0003        	  7273:     move.b  #$03,D1
02:00049A98 0A3C0010        	  7274:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00049A9C 9101            	  7275:     subx.b  D1,D0   ; SBC #$03
02:00049A9E 0A3C0010        	  7276:     eori    #$10,CCR  ; restore X = 6502 C
02:00049AA2 41EC0084        	  7277:     lea     ($0084,A4),A0
02:00049AA6 11802000        	  7278:     move.b  D0,(A0,D2.W)
                            	  7279:     ; Set the monsters-from-edges long timer to a random value
