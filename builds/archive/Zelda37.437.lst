02:00038DCC 0C0000C0        	  1762:     cmpi.b  #$C0,D0
02:00038DD0 6506            	  1763:     bcs  _anon_z04_43
02:00038DD2 4EB9000484F4    	  1764:     jsr     ReverseObjDir
                            	  1765: _anon_z04_43:
                            	  1766:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  1767:     ;
