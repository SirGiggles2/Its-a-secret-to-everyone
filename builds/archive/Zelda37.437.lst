02:000338C4 10302000        	  2368:     move.b  (A0,D2.W),D0
02:000338C8 41EC0422        	  2369:     lea     ($0422,A4),A0
02:000338CC 11803000        	  2370:     move.b  D0,(A0,D3.W)
02:000338D0 5302            	  2371:     subq.b  #1,D2
02:000338D2 5303            	  2372:     subq.b  #1,D3
02:000338D4 6AE8            	  2373:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:000338D6 522C0420        	  2374:     addq.b  #1,($0420,A4)
                            	  2375:     even
                            	  2376: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2377:     ; At this point:
                            	  2378:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2379:     ;   - This will be changed as the player inputs characters.
                            	  2380:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2381:     ;   - This will be changed as the player inputs characters.
                            	  2382:     ; - InitializedNameField [$0420] is set to 1.
                            	  2383:     ;
02:000338DA 102C00F8        	  2384:     move.b  ($00F8,A4),D0
02:000338DE 020000C0        	  2385:     andi.b #$C0,D0
02:000338E2 670000E8        	  2386:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2387:     ; A or B was pressed.
                            	  2388:     ;
02:000338E6 0C000040        	  2389:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
02:000338EA 660000A6        	  2390:     bne  _L_z02_ModeE_HandleAOrB_Backspace   ; PATCH P25b: B = backspace
                            	  2391:     ; A was pressed.
                            	  2392:     ;
                            	  2393:     ; Request to play the character click tune (same as bomb set).
02:000338EE 7620            	  2394:     moveq   #32,D3
02:000338F0 19430604        	  2395:     move.b  D3,($0604,A4)
02:000338F4 7602            	  2396:     moveq   #2,D3
                            	  2397:     even
                            	  2398: _L_z02_ModeE_HandleAOrB_CopyHeader:
02:000338F6 41EC0422        	  2399:     lea     ($0422,A4),A0
02:000338FA 10303000        	  2400:     move.b  (A0,D3.W),D0
02:000338FE 41EC0302        	  2401:     lea     ($0302,A4),A0
02:00033902 11803000        	  2402:     move.b  D0,(A0,D3.W)
02:00033906 5303            	  2403:     subq.b  #1,D3
02:00033908 6AEC            	  2404:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeader
02:0003390A 19430306        	  2405:     move.b  D3,($0306,A4)
02:0003390E 7400            	  2406:     moveq   #0,D2
02:00033910 142C0421        	  2407:     move.b  ($0421,A4),D2
02:00033914 7600            	  2408:     moveq   #0,D3
02:00033916 162C041F        	  2409:     move.b  ($041F,A4),D3
02:0003391A 41F90003325A    	  2410:     lea     (ModeE_CharMap).l,A0
02:00033920 10303000        	  2411:     move.b  (A0,D3.W),D0
02:00033924 19400305        	  2412:     move.b  D0,($0305,A4)
02:00033928 41EC0638        	  2413:     lea     ($0638,A4),A0
02:0003392C 11802000        	  2414:     move.b  D0,(A0,D2.W)
