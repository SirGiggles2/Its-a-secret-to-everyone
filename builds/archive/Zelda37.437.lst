                            	  2416: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00033930 102C0070        	  2417:     move.b  ($0070,A4),D0
02:00033934 023C00EE        	  2418:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033938 123C0008        	  2419:     move.b  #$08,D1
02:0003393C D101            	  2420:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003393E 19400070        	  2421:     move.b  D0,($0070,A4)
02:00033942 522C0421        	  2422:     addq.b  #1,($0421,A4)
02:00033946 522C0423        	  2423:     addq.b  #1,($0423,A4)
                            	  2424:     ; If VRAM address still points inside the name field,
                            	  2425:     ; then go finish.
                            	  2426:     ;
                            	  2427:     ; The idea is that each name field in nametable begins at
                            	  2428:     ; an address ending in $E. For example, slot 0 has a name
                            	  2429:     ; at VRAM addresses $20CE to $20D5.
                            	  2430:     ;
                            	  2431:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2432:     ; the name field.
                            	  2433:     ;
                            	  2434:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2435:     ; record header.
                            	  2436:     ;
02:0003394A 102C0070        	  2437:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:0003394E 0C0000B0        	  2438:     cmpi.b  #$B0,D0
02:00033952 6678            	  2439:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2440:     ; The VRAM address now points outside the name field.
                            	  2441:     ; So, wrap around to the beginning of the name field.
                            	  2442:     ;
                            	  2443:     ; For example, $20D6 -> $20CE.
                            	  2444:     ;
02:00033954 102C0423        	  2445:     move.b  ($0423,A4),D0
02:00033958 003C0011        	  2446:     ori     #$11,CCR  ; SEC: set C+X
02:0003395C 123C0008        	  2447:     move.b  #$08,D1
02:00033960 0A3C0010        	  2448:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00033964 9101            	  2449:     subx.b  D1,D0   ; SBC #$08
02:00033966 0A3C0010        	  2450:     eori    #$10,CCR  ; restore X = 6502 C
02:0003396A 19400423        	  2451:     move.b  D0,($0423,A4)
                            	  2452:     ; It also means that we went past the end of the save slot
                            	  2453:     ; info name. Set the offset to the beginning of the name.
02:0003396E 7600            	  2454:     moveq   #0,D3
02:00033970 162C0016        	  2455:     move.b  ($0016,A4),D3
02:00033974 41F9000332B6    	  2456:     lea     (SlotToNameOffset).l,A0
02:0003397A 10303000        	  2457:     move.b  (A0,D3.W),D0
02:0003397E 19400421        	  2458:     move.b  D0,($0421,A4)
                            	  2459:     ; If the name cursor has gone past the end of the field,
                            	  2460:     ; then wrap around.
02:00033982 102C0070        	  2461:     move.b  ($0070,A4),D0
02:00033986 0C0000B0        	  2462:     cmpi.b  #$B0,D0
02:0003398A 6640            	  2463:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:0003398C 7070            	  2464:     moveq   #112,D0
02:0003398E 19400070        	  2465:     move.b  D0,($0070,A4)
                            	  2466:     even
                            	  2467: ; PATCH P25b: FS2-E backspace handler.
                            	  2468: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2469: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2470: ; one column (8 px), and writes a space ($24) to the erased
                            	  2471: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2472: ; cannot cross into a previous slot's name field.
