                            	  5564: __far_z_05_0076:
                            	  5565:     ; Turn the door command into the desired open or closed state
                            	  5566:     ; to store in [08].
                            	  5567:     ;
                            	  5568:     ; cmd:  7 6 3 2 
                            	  5569:     ; [08]: 2 0 0 0
                            	  5570:     ;
                            	  5571:     ; There are other combinations, but 2, 3, 6, and 7 are the only
                            	  5572:     ; commands intended to be used.
                            	  5573:     ;
                            	  5574:     ; 3 is the end state of 2: close
                            	  5575:     ; 7 is the end state of 6: open
                            	  5576:     ;
02:000401E4 02000007        	  5577:     andi.b #$07,D0
02:000401E8 7601            	  5578:     moveq   #1,D3
02:000401EA 19430002        	  5579:     move.b  D3,($0002,A4)
02:000401EE 122C0002        	  5580:     move.b  ($0002,A4),D1
02:000401F2 C200            	  5581:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000401F4 6702            	  5582:     beq  _anon_z05_118
02:000401F6 E208            	  5583:     lsr.b  #1,D0   ; LSR A
                            	  5584: _anon_z05_118:
02:000401F8 0C000002        	  5585:     cmpi.b  #$02,D0
02:000401FC 6606            	  5586:     bne  _anon_z05_119
