                            	  4396: Digdogger_Move:
                            	  4397:     ; This calculation is the same one used in Manhandla to
                            	  4398:     ; manifest the fractional speed over several frames.
                            	  4399:     ;
                            	  4400:     ; To summarize, the formula is:
                            	  4401:     ;
                            	  4402:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4403:     ;
                            	  4404:     ;   SA := SA + (SL AND $E0)
                            	  4405:     ;   [03] := SH + carry
                            	  4406:     ;
                            	  4407:     ; See 04:A28E Manhandla_Move.
                            	  4408:     ;
02:0003A092 41EC041F        	  4409:     lea     ($041F,A4),A0
02:0003A096 10302000        	  4410:     move.b  (A0,D2.W),D0
02:0003A09A 020000E0        	  4411:     andi.b #$E0,D0
02:0003A09E 023C00EE        	  4412:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A0A2 41EC0412        	  4413:     lea     ($0412,A4),A0
02:0003A0A6 12302000        	  4414:     move.b  (A0,D2.W),D1
02:0003A0AA D101            	  4415:     addx.b  D1,D0   ; ADC $0412,X
02:0003A0AC 41EC0412        	  4416:     lea     ($0412,A4),A0
02:0003A0B0 11802000        	  4417:     move.b  D0,(A0,D2.W)
                            	  4418:     ; Assign (high speed byte + carry) to [03].
                            	  4419:     ;
02:0003A0B4 41EC042C        	  4420:     lea     ($042C,A4),A0
02:0003A0B8 10302000        	  4421:     move.b  (A0,D2.W),D0
02:0003A0BC 123C0000        	  4422:     move.b  #$00,D1
02:0003A0C0 D101            	  4423:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A0C2 19400003        	  4424:     move.b  D0,($0003,A4)
                            	  4425:     ; Change coordinates by the speed amount/offset in [03]
                            	  4426:     ; according to the direction.
                            	  4427:     ;
                            	  4428:     ; Start with a mask of $A1 in [02]:
                            	  4429:     ; - low nibble represents the right direction
                            	  4430:     ; - high nibble is used to set or clear carry as we go along
                            	  4431:     ;
02:0003A0C6 103C00A1        	  4432:     move.b  #$A1,D0
02:0003A0CA 19400002        	  4433:     move.b  D0,($0002,A4)
                            	  4434:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4435:     ;
02:0003A0CE 41EC0098        	  4436:     lea     ($0098,A4),A0
02:0003A0D2 10302000        	  4437:     move.b  (A0,D2.W),D0
02:0003A0D6 122C0002        	  4438:     move.b  ($0002,A4),D1
02:0003A0DA C200            	  4439:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A0DC 6712            	  4440:     beq  _L_z04_Digdogger_Move_Left
02:0003A0DE 10342070        	  4441:     move.b  ($70,A4,D2.W),D0
02:0003A0E2 023C00EE        	  4442:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A0E6 122C0003        	  4443:     move.b  ($0003,A4),D1
02:0003A0EA D101            	  4444:     addx.b  D1,D0   ; ADC $03
02:0003A0EC 19802070        	  4445:     move.b  D0,($70,A4,D2.W)
                            	  4446:     even
                            	  4447: _L_z04_Digdogger_Move_Left:
                            	  4448:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  4449:     ;
02:0003A0F0 41EC0098        	  4450:     lea     ($0098,A4),A0
02:0003A0F4 10302000        	  4451:     move.b  (A0,D2.W),D0
02:0003A0F8 122C0002        	  4452:     move.b  ($0002,A4),D1
02:0003A0FC E309            	  4453:     lsl.b  #1,D1   ; ASL $02
02:0003A0FE 19410002        	  4454:     move.b  D1,($0002,A4)
02:0003A102 122C0002        	  4455:     move.b  ($0002,A4),D1
02:0003A106 C200            	  4456:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A108 6716            	  4457:     beq  _L_z04_Digdogger_Move_Down
02:0003A10A 10342070        	  4458:     move.b  ($70,A4,D2.W),D0
