                            	  4859: SpreadShot:
                            	  4860:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4861:     ;
                            	  4862:     ; The shot is spreading out.
                            	  4863:     ;
                            	  4864:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4865:     ; These will be negated appropriately for each corner.
                            	  4866:     ;
02:0004888C 41EC0098        	  4867:     lea     ($0098,A4),A0
02:00048890 10302000        	  4868:     move.b  (A0,D2.W),D0
02:00048894 19400002        	  4869:     move.b  D0,($0002,A4)
02:00048898 19400003        	  4870:     move.b  D0,($0003,A4)
                            	  4871:     ; Reset [0F] to not flip horizontally.
                            	  4872:     ;
02:0004889C 7000            	  4873:     moveq   #0,D0
02:0004889E 1940000F        	  4874:     move.b  D0,($000F,A4)
                            	  4875:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4876:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4877:     ;
02:000488A2 7603            	  4878:     moveq   #3,D3
                            	  4879:     even
                            	  4880: _L_z07_SpreadShot_DrawShotCorner:
02:000488A4 1003            	  4881:     move.b  D3,D0
02:000488A6 1B00            	  4882:     move.b  D0,-(A5)  ; PHA
                            	  4883:     ; Save offset X [02] and Y offset [03].
                            	  4884:     ;
02:000488A8 102C0002        	  4885:     move.b  ($0002,A4),D0
02:000488AC 1B00            	  4886:     move.b  D0,-(A5)  ; PHA
02:000488AE 102C0003        	  4887:     move.b  ($0003,A4),D0
02:000488B2 1B00            	  4888:     move.b  D0,-(A5)  ; PHA
                            	  4889:     ; Calculate and set sprite attributes for this corner:
                            	  4890:     ;   base attribute OR (frame counter AND 3)
                            	  4891:     ;
                            	  4892:     ; The base attribute defines how to flip the sprite.
                            	  4893:     ; The frame counter makes the shot flash by cycling each
                            	  4894:     ; palette row.
                            	  4895:     ;
02:000488B4 102C0015        	  4896:     move.b  ($0015,A4),D0
02:000488B8 02000003        	  4897:     andi.b #$03,D0
02:000488BC 41F900048798    	  4898:     lea     (SwordShotSpreadBaseAttr).l,A0
02:000488C2 12303000        	  4899:     move.b  (A0,D3.W),D1
02:000488C6 8001            	  4900:     or.b  D1,D0
02:000488C8 4EB900031044    	  4901:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4902:     ; Add the object's X (the center of the spread) and the
                            	  4903:     ; current offset in [02] to set sprite X in [00].
                            	  4904:     ;
02:000488CE 10342070        	  4905:     move.b  ($70,A4,D2.W),D0
02:000488D2 023C00EE        	  4906:     andi    #$EE,CCR  ; CLC: clear C+X
02:000488D6 122C0002        	  4907:     move.b  ($0002,A4),D1
02:000488DA D101            	  4908:     addx.b  D1,D0   ; ADC $02
02:000488DC 1880            	  4909:     move.b  D0,($0000,A4)
                            	  4910:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4911:     ; Else calculate the distance from object X to sprite X.
                            	  4912:     ;
02:000488DE 12342070        	  4913:     move.b  ($70,A4,D2.W),D1
02:000488E2 B001            	  4914:     cmp.b   D1,D0
02:000488E4 651A            	  4915:     bcs  _L_z07_SpreadShot_ReverseSub
02:000488E6 0C0000FC        	  4916:     cmpi.b  #$FC,D0
02:000488EA 6466            	  4917:     bcc  _L_z07_SpreadShot_NextCorner
02:000488EC 003C0011        	  4918:     ori     #$11,CCR  ; SEC: set C+X
02:000488F0 12342070        	  4919:     move.b  ($70,A4,D2.W),D1
02:000488F4 0A3C0010        	  4920:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000488F8 9101            	  4921:     subx.b  D1,D0   ; SBC ObjX,X
02:000488FA 0A3C0010        	  4922:     eori    #$10,CCR  ; restore X = 6502 C
02:000488FE 6014            	  4923:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4924: 
                            	  4925:     even
                            	  4926: _L_z07_SpreadShot_ReverseSub:
02:00048900 10342070        	  4927:     move.b  ($70,A4,D2.W),D0
02:00048904 003C0011        	  4928:     ori     #$11,CCR  ; SEC: set C+X
02:00048908 1214            	  4929:     move.b  ($0000,A4),D1
02:0004890A 0A3C0010        	  4930:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004890E 9101            	  4931:     subx.b  D1,D0   ; SBC $00
02:00048910 0A3C0010        	  4932:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4933:     even
                            	  4934: _L_z07_SpreadShot_CheckDistance:
                            	  4935:     ; If distance >= $20, skip this corner.
                            	  4936:     ;
02:00048914 0C000020        	  4937:     cmpi.b  #$20,D0
02:00048918 6438            	  4938:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4939:     ; Add the object's Y (the center of the spread) and the
                            	  4940:     ; current offset in [03] to set sprite Y in [01].
                            	  4941:     ;
02:0004891A 41EC0084        	  4942:     lea     ($0084,A4),A0
02:0004891E 10302000        	  4943:     move.b  (A0,D2.W),D0
02:00048922 023C00EE        	  4944:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048926 122C0003        	  4945:     move.b  ($0003,A4),D1
02:0004892A D101            	  4946:     addx.b  D1,D0   ; ADC $03
02:0004892C 19400001        	  4947:     move.b  D0,($0001,A4)
                            	  4948:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4949:     ;
02:00048930 7600            	  4950:     moveq   #0,D3
02:00048932 162C0010        	  4951:     move.b  ($0010,A4),D3
02:00048936 670C            	  4952:     beq  _L_z07_SpreadShot_Draw
02:00048938 0C00003E        	  4953:     cmpi.b  #$3E,D0
02:0004893C 6514            	  4954:     bcs  _L_z07_SpreadShot_NextCorner
02:0004893E 0C0000E8        	  4955:     cmpi.b  #$E8,D0
02:00048942 640E            	  4956:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4957:     even
                            	  4958: _L_z07_SpreadShot_Draw:
                            	  4959:     ; Draw the corner.
                            	  4960:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4961:     ;
02:00048944 7002            	  4962:     moveq   #2,D0
02:00048946 1940000C        	  4963:     move.b  D0,($000C,A4)
02:0004894A 7623            	  4964:     moveq   #35,D3
02:0004894C 4EB900030F64    	  4965:     jsr     Anim_WriteItemSprites
                            	  4966:     even
                            	  4967: _L_z07_SpreadShot_NextCorner:
                            	  4968:     ; Prepare to process the next corner.
                            	  4969:     ;
                            	  4970:     ; First, restore X offset [02] and Y offset [03].
                            	  4971:     ;
02:00048952 101D            	  4972:     move.b  (A5)+,D0  ; PLA
02:00048954 19400003        	  4973:     move.b  D0,($0003,A4)
02:00048958 101D            	  4974:     move.b  (A5)+,D0  ; PLA
02:0004895A 19400002        	  4975:     move.b  D0,($0002,A4)
                            	  4976:     ; Take turns negating X offset or Y offset for the next round.
                            	  4977:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4978:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4979:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4980:     ; - Fourth turn: doesn't matter
                            	  4981:     ;
                            	  4982:     ;
                            	  4983:     ; Get the loop index.
02:0004895E 101D            	  4984:     move.b  (A5)+,D0  ; PLA
02:00048960 1B00            	  4985:     move.b  D0,-(A5)  ; PHA
02:00048962 7600            	  4986:     moveq   #0,D3
02:00048964 1600            	  4987:     move.b  D0,D3
02:00048966 0C030001        	  4988:     cmpi.b  #$01,D3
02:0004896A 6602            	  4989:     bne  _anon_z07_25
02:0004896C 7603            	  4990:     moveq   #3,D3
                            	  4991: _anon_z07_25:
02:0004896E 10343000        	  4992:     move.b  ($00,A4,D3.W),D0
02:00048972 4600            	  4993:     eori.b #$FF,D0
02:00048974 023C00EE        	  4994:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048978 123C0001        	  4995:     move.b  #$01,D1
02:0004897C D101            	  4996:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004897E 19803000        	  4997:     move.b  D0,($00,A4,D3.W)
                            	  4998:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4999:     ;
02:00048982 101D            	  5000:     move.b  (A5)+,D0  ; PLA
02:00048984 7600            	  5001:     moveq   #0,D3
02:00048986 1600            	  5002:     move.b  D0,D3
02:00048988 5303            	  5003:     subq.b  #1,D3
02:0004898A 6A00FF18        	  5004:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5005:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5006:     ;
                            	  5007:     ; Decrease the base negative offset to get farther away from
                            	  5008:     ; the center point.
                            	  5009:     ;
02:0004898E 41EC0098        	  5010:     lea     ($0098,A4),A0
02:00048992 53302000        	  5011:     subq.b  #1,(A0,D2.W)
                            	  5012:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5013:     ;
                            	  5014:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5015:     ;
02:00048996 41EC0098        	  5016:     lea     ($0098,A4),A0
02:0004899A 10302000        	  5017:     move.b  (A0,D2.W),D0
02:0004899E 0C0000E8        	  5018:     cmpi.b  #$E8,D0
02:000489A2 6702            	  5019:     beq.s  __far_z_07_0072
02:000489A4 6004            	  5020:     jmp  L1F49F_Exit
