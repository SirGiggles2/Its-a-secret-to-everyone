02:00039346 102C0085        	  2587:     move.b  ($0085,A4),D0
02:0003934A 003C0011        	  2588:     ori     #$11,CCR  ; SEC: set C+X
02:0003934E 123C001C        	  2589:     move.b  #$1C,D1
02:00039352 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039356 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:00039358 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:0003935C 41EC0084        	  2593:     lea     ($0084,A4),A0
02:00039360 11802000        	  2594:     move.b  D0,(A0,D2.W)
