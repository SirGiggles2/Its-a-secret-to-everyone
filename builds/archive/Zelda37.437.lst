02:0003EFD0 48C4            	  4392:     ext.l   D4
02:0003EFD2 D8BC00FF0000    	  4393:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003EFD8 2044            	  4394:     movea.l D4,A0
02:0003EFDA 10303000        	  4395:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003EFDE 41EC0302        	  4396:     lea     ($0302,A4),A0
02:0003EFE2 11802000        	  4397:     move.b  D0,(A0,D2.W)
                            	  4398:     ; Prepare for the next call:
                            	  4399:     ; - increment dynamic transfer buf pointer
                            	  4400:     ; - increment index of tile to copy [07]
                            	  4401:     ; - decrement count of tiles remaining
                            	  4402:     ;
