                            	   940: 
                            	   941: ;------------------------------------------------------------------------------
                            	   942: ; _c_move_object_shim — MoveObject trampoline.
                            	   943: ;
                            	   944: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   945: ;   Input:     D2 = slot (0..11)
                            	   946: ;   Preserves: D2, A4, A5
                            	   947: ;   Clobbers:  D0, D1, D3, A0
                            	   948: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   949: ;
                            	   950: ; GCC side:
                            	   951: ;   void c_move_object(unsigned short slot);
                            	   952: ;     slot arrives as a 16-bit value on the stack.
                            	   953: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   954: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   955: ;   never clobbered by gcc.
                            	   956: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   957: ;   semantics can exist in a pure C port).
                            	   958: ;------------------------------------------------------------------------------
                            	   959: _c_move_object_shim:
                            	   960:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   961:     move.b  #$AA,($0900,A4)
                            	   962:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   963:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   964:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   965:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   966:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   967:     moveq   #0,D0
02:0002B658 3002            	   968:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   969:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   970:     jsr     c_move_object
02:0002B662 588F            	   971:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   972:     rts
                            	   973: 
                            	   974: ;==============================================================================
                            	   975: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   976: ; and tail-call the native asm function.
                            	   977: ;
                            	   978: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   979: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   980: ; sign-extended).
                            	   981: ;==============================================================================
                            	   982: 
                            	   983: ;------------------------------------------------------------------------------
                            	   984: ; void c_copy_bank_to_window(unsigned int bank);
                            	   985: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   986: ;------------------------------------------------------------------------------
                            	   987: c_copy_bank_to_window:
02:0002B666 202F0004        	   988:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   989:     jmp     _copy_bank_to_window
                            	   990: 
                            	   991: ;------------------------------------------------------------------------------
                            	   992: ; unsigned char c_ppu_read_2(void);
                            	   993: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   994: ; C return: gcc expects result in D0.
                            	   995: ;------------------------------------------------------------------------------
                            	   996: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   997:     jmp     _ppu_read_2
                            	   998: 
                            	   999: ;------------------------------------------------------------------------------
                            	  1000: ; void c_ppu_write_6(unsigned int val);
                            	  1001: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	  1002: ;------------------------------------------------------------------------------
                            	  1003: c_ppu_write_6:
02:0002B674 202F0004        	  1004:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	  1005:     jmp     _ppu_write_6
                            	  1006: 
                            	  1007: ;------------------------------------------------------------------------------
                            	  1008: ; void c_ppu_write_7(unsigned int val);
                            	  1009: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	  1010: ;------------------------------------------------------------------------------
                            	  1011: c_ppu_write_7:
02:0002B67E 202F0004        	  1012:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	  1013:     jmp     _ppu_write_7
                            	  1014: 
                            	  1015: ;------------------------------------------------------------------------------
                            	  1016: ; void c_turn_off_all_video(void);
                            	  1017: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	  1018: ;------------------------------------------------------------------------------
                            	  1019: c_turn_off_all_video:
02:0002B688 4EF9000472BA    	  1020:     jmp     TurnOffAllVideo
                            	  1021: 
                            	  1022: ;==============================================================================
                            	  1023: ; EXPORT side — z_03 entry point.
                            	  1024: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	  1025: ; the transpiler emits that label pointing to this shim instead of the
                            	  1026: ; z_03 asm body. The C function takes no args and returns void.
                            	  1027: ;==============================================================================
                            	  1028: 
                            	  1029: ;------------------------------------------------------------------------------
                            	  1030: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	  1031: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	  1032: ;------------------------------------------------------------------------------
                            	  1033: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1034:     jmp     z03_transfer_level_pattern_blocks
                            	  1035: 
                            	  1036: ;==============================================================================
                            	  1037: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1038: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1039: ;==============================================================================
                            	  1040: 
                            	  1041: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1042:     jmp     z06_init_mode2_submodes
                            	  1043: 
                            	  1044: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1045:     jmp     z06_copy_common_data_to_ram
                            	  1046: 
                            	  1047: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1048:     jmp     z06_update_mode2_load_full
                            	  1049: 
                            	  1050: ;==============================================================================
                            	  1051: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1052: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
