                            	  3595:     ;
02:0003E92E 61002590        	  3596:     jsr     FetchTileMapAddr
02:0003E932 7005            	  3597:     moveq   #5,D0
02:0003E934 4EB90002A9FA    	  3598:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3599:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3600:     ; in order to point to the column we want.
                            	  3601:     ;
02:0003E93A 102C000A        	  3602:     move.b  ($000A,A4),D0
02:0003E93E 0200000F        	  3603:     andi.b #$0F,D0
