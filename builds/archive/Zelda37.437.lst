02:0003A558 123C0001        	  5026:     move.b  #$01,D1
02:0003A55C D101            	  5027:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A55E 41EC0437        	  5028:     lea     ($0437,A4),A0
02:0003A562 11802000        	  5029:     move.b  D0,(A0,D2.W)
02:0003A566 6034            	  5030:     jmp     L_Dodongo_DecrementBloatedTimer
