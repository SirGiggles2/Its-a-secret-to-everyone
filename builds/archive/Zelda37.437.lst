02:0003A426 41F900030D1A    	  4879:     lea     (SpriteOffsets).l,A0
02:0003A42C 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003A430 7600            	  4881:     moveq   #0,D3
02:0003A432 1600            	  4882:     move.b  D0,D3
02:0003A434 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003A436 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003A43A 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003A43E 1014            	  4886:     move.b  ($0000,A4),D0
