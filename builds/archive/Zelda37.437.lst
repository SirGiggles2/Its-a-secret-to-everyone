02:00041C82 123C00E2        	  8594:     move.b  #$E2,D1
02:00041C86 D101            	  8595:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00041C88 41EC0304        	  8596:     lea     ($0304,A4),A0
02:00041C8C 11803000        	  8597:     move.b  D0,(A0,D3.W)
02:00041C90 4E75            	  8598:     rts
