                            	  8812: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	  8813:     ; Draw the four clouds at diagonal corners.
                            	  8814:     ;
02:0003C1A6 610000B6        	  8815:     jsr     Ganon_GetCurCloudLeft
02:0003C1AA 610000BE        	  8816:     jsr     Ganon_GetCurCloudTop
02:0003C1AE 61A0            	  8817:     jsr     Ganon_DrawCloud
02:0003C1B0 610000B2        	  8818:     jsr     Ganon_GetCurCloudRight
02:0003C1B4 619A            	  8819:     jsr     Ganon_DrawCloud
02:0003C1B6 610000A6        	  8820:     jsr     Ganon_GetCurCloudLeft
02:0003C1BA 610000B4        	  8821:     jsr     Ganon_GetCurCloudBottom
02:0003C1BE 6190            	  8822:     jsr     Ganon_DrawCloud
02:0003C1C0 610000A2        	  8823:     jsr     Ganon_GetCurCloudRight
