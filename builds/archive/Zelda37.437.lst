02:000338A0 60E6            	  2352:     jmp  LA10A_Exit
                            	  2353: __far_z_02_0003:
                            	  2354:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2355:     ; in the current slot's name.
02:000338A2 41F9000332B6    	  2356:     lea     (SlotToNameOffset).l,A0
02:000338A8 10303000        	  2357:     move.b  (A0,D3.W),D0
02:000338AC 19400421        	  2358:     move.b  D0,($0421,A4)
                            	  2359:     ; Get the offset of the end of the initial name character
                            	  2360:     ; transfer record header for the current slot.
02:000338B0 7400            	  2361:     moveq   #0,D2
02:000338B2 41F9000332BA    	  2362:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:000338B8 14303000        	  2363:     move.b  (A0,D3.W),D2
02:000338BC 7602            	  2364:     moveq   #2,D3
