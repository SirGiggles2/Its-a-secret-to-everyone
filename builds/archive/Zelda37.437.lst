02:00049094 4EB900030F64    	  5998:     jsr     Anim_WriteItemSprites
                            	  5999:     ; If state <> 3, return.
                            	  6000:     ;
02:0004909A 41EC00AC        	  6001:     lea     ($00AC,A4),A0
