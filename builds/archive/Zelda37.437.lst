                            	  5873: _L_z07_UpdateSwordOrRod_Add4:
                            	  5874:     ; Set [00] to (state - 1) * 4:
                            	  5875:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  5876:     ;
02:00048F96 023C00EE        	  5877:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048F9A 123C0004        	  5878:     move.b  #$04,D1
02:00048F9E D101            	  5879:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:00048FA0 5303            	  5880:     subq.b  #1,D3
02:00048FA2 66F2            	  5881:     bne  _L_z07_UpdateSwordOrRod_Add4
02:00048FA4 1880            	  5882:     move.b  D0,($0000,A4)
                            	  5883:     ; Set object's direction to player's. It might have changed
                            	  5884:     ; since the last frame.
                            	  5885:     ;
02:00048FA6 102C0098        	  5886:     move.b  ($0098,A4),D0
02:00048FAA 41EC0098        	  5887:     lea     ($0098,A4),A0
02:00048FAE 11802000        	  5888:     move.b  D0,(A0,D2.W)
                            	  5889:     ; Add [00] and the reverse index of the direction to get
                            	  5890:     ; the byte offset of the pixel offset.
                            	  5891:     ;
02:00048FB2 4EB900030982    	  5892:     jsr     GetOppositeDir
02:00048FB8 1003            	  5893:     move.b  D3,D0
02:00048FBA 023C00EE        	  5894:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048FBE 1214            	  5895:     move.b  ($0000,A4),D1
02:00048FC0 D101            	  5896:     addx.b  D1,D0   ; ADC $00
02:00048FC2 7600            	  5897:     moveq   #0,D3
02:00048FC4 1600            	  5898:     move.b  D0,D3
                            	  5899:     ; Set object's X to player's X + offset for state and direction.
                            	  5900:     ; Copy the result to [00].
