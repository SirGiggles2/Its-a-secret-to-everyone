02:0003C118 123C0004        	  8745:     move.b  #$04,D1
02:0003C11C D101            	  8746:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003C11E 19803072        	  8747:     move.b  D0,($72,A4,D3.W)
02:0003C122 41EC0084        	  8748:     lea     ($0084,A4),A0
02:0003C126 10302000        	  8749:     move.b  (A0,D2.W),D0
02:0003C12A 123C0004        	  8750:     move.b  #$04,D1
02:0003C12E D101            	  8751:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003C130 41EC0086        	  8752:     lea     ($0086,A4),A0
02:0003C134 11803000        	  8753:     move.b  D0,(A0,D3.W)
                            	  8754:     ; Set the direction.
                            	  8755:     ;
