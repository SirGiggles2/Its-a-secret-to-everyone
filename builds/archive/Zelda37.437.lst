02:0002F16C 023C00EE        	   301:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F170 123C0003        	   302:     move.b  #$03,D1
02:0002F174 D101            	   303:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002F176 5303            	   304:     subq.b  #1,D3
02:0002F178 6AF2            	   305:     bpl  _anon_z01_0
02:0002F17A 7600            	   306:     moveq   #0,D3
02:0002F17C 1600            	   307:     move.b  D0,D3
                            	   308:     ; Loop over the wares from 0 to 2.
                            	   309:     ;
02:0002F17E 7400            	   310:     moveq   #0,D2
                            	   311:     even
                            	   312: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   313:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   314:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   315:     ;
02:0002F180 41F900FF6A7E    	   316:     lea     (NES_SRAM+$0A7E).l,A0
02:0002F186 10303000        	   317:     move.b  (A0,D3.W),D0
02:0002F18A 41EC0422        	   318:     lea     ($0422,A4),A0
02:0002F18E 11802000        	   319:     move.b  D0,(A0,D2.W)
                            	   320:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   321:     ;
02:0002F192 020000C0        	   322:     andi.b #$C0,D0
02:0002F196 19802000        	   323:     move.b  D0,($00,A4,D2.W)
                            	   324:     ; Copy 3 prices from the Cave level block info.
                            	   325:     ;
02:0002F19A 41F900FF6ABA    	   326:     lea     (NES_SRAM+$0ABA).l,A0
02:0002F1A0 10303000        	   327:     move.b  (A0,D3.W),D0
02:0002F1A4 41EC0430        	   328:     lea     ($0430,A4),A0
02:0002F1A8 11802000        	   329:     move.b  D0,(A0,D2.W)
                            	   330:     ; Bottom of the wares copying loop.
                            	   331:     ;
02:0002F1AC 5203            	   332:     addq.b  #1,D3
02:0002F1AE 5202            	   333:     addq.b  #1,D2
02:0002F1B0 0C020003        	   334:     cmpi.b  #$03,D2
02:0002F1B4 66CA            	   335:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   336:     ; Get the top 2 bits of text selector byte in [03],
                            	   337:     ; shift them to the bottom, and combine them with [00].
                            	   338:     ;
02:0002F1B6 102C0003        	   339:     move.b  ($0003,A4),D0
02:0002F1BA E308            	   340:     lsl.b  #1,D0   ; ASL A
02:0002F1BC E310            	   341:     roxl.b  #1,D0   ; ROL A
02:0002F1BE E310            	   342:     roxl.b  #1,D0   ; ROL A
02:0002F1C0 1214            	   343:     move.b  ($0000,A4),D1
02:0002F1C2 8001            	   344:     or.b  D1,D0
02:0002F1C4 1880            	   345:     move.b  D0,($0000,A4)
                            	   346:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   347:     ; and combine them with [00].
                            	   348:     ;
02:0002F1C6 102C0002        	   349:     move.b  ($0002,A4),D0
02:0002F1CA E208            	   350:     lsr.b  #1,D0   ; LSR A
02:0002F1CC E208            	   351:     lsr.b  #1,D0   ; LSR A
02:0002F1CE E208            	   352:     lsr.b  #1,D0   ; LSR A
02:0002F1D0 E208            	   353:     lsr.b  #1,D0   ; LSR A
02:0002F1D2 1214            	   354:     move.b  ($0000,A4),D1
02:0002F1D4 8001            	   355:     or.b  D1,D0
02:0002F1D6 1880            	   356:     move.b  D0,($0000,A4)
                            	   357:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   358:     ; and combine them with [00] into CaveFlags.
                            	   359:     ;
02:0002F1D8 102C0001        	   360:     move.b  ($0001,A4),D0
02:0002F1DC E208            	   361:     lsr.b  #1,D0   ; LSR A
02:0002F1DE E208            	   362:     lsr.b  #1,D0   ; LSR A
02:0002F1E0 1214            	   363:     move.b  ($0000,A4),D1
02:0002F1E2 8001            	   364:     or.b  D1,D0
02:0002F1E4 19400413        	   365:     move.b  D0,($0413,A4)
                            	   366:     ; The end result is a byte with 8 cave flags.
                            	   367:     ;
                            	   368:     ; If cave flag "money game" is missing, then go finish up,
                            	   369:     ; instead of choosing random amounts for the money game.
                            	   370:     ;
02:0002F1E8 02000020        	   371:     andi.b #$20,D0
02:0002F1EC 6700009E        	   372:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   373:     ; Determine an index randomly with increasing probability,
                            	   374:     ; from 6 to 1. Start with the following test:
                            	   375:     ;
                            	   376:     ;   If $FF < Random, then go use index 6.
                            	   377:     ;
02:0002F1F0 103C00FF        	   378:     move.b  #$FF,D0
02:0002F1F4 7606            	   379:     moveq   #6,D3
                            	   380:     even
                            	   381: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002F1F6 122C0019        	   382:     move.b  ($0019,A4),D1
02:0002F1FA B001            	   383:     cmp.b   D1,D0
02:0002F1FC 6516            	   384:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   385:     ; If the test fails, then subtract $2B from the reference number.
                            	   386:     ;
02:0002F1FE 003C0011        	   387:     ori     #$11,CCR  ; SEC: set C+X
02:0002F202 123C002B        	   388:     move.b  #$2B,D1
02:0002F206 0A3C0010        	   389:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002F20A 9101            	   390:     subx.b  D1,D0   ; SBC #$2B
02:0002F20C 0A3C0010        	   391:     eori    #$10,CCR  ; restore X = 6502 C
02:0002F210 5303            	   392:     subq.b  #1,D3
02:0002F212 66E2            	   393:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   394:     even
                            	   395: _L_z01_InitCaveContinue_FoundPermutation:
                            	   396:     ; The index chooses the last offset of a permutation of three indexes.
                            	   397:     ;
02:0002F214 7400            	   398:     moveq   #0,D2
02:0002F216 41F90002F122    	   399:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002F21C 14303000        	   400:     move.b  (A0,D3.W),D2
                            	   401:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   402:     ;
02:0002F220 7602            	   403:     moveq   #2,D3
                            	   404:     even
                            	   405: _L_z01_InitCaveContinue_CopyPermutation:
02:0002F222 41F90002F110    	   406:     lea     (MoneyGamePermutations).l,A0
02:0002F228 10302000        	   407:     move.b  (A0,D2.W),D0
02:0002F22C 41EC046C        	   408:     lea     ($046C,A4),A0
02:0002F230 11803000        	   409:     move.b  D0,(A0,D3.W)
02:0002F234 5302            	   410:     subq.b  #1,D2
02:0002F236 5303            	   411:     subq.b  #1,D3
02:0002F238 6AE8            	   412:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   413:     ; With the first bit of another random number, choose 10 or 40
                            	   414:     ; to put in [046F]. This is a random amount to lose.
                            	   415:     ;
02:0002F23A 102C001A        	   416:     move.b  ($001A,A4),D0
02:0002F23E 02000001        	   417:     andi.b #$01,D0
02:0002F242 7600            	   418:     moveq   #0,D3
02:0002F244 1600            	   419:     move.b  D0,D3
02:0002F246 41F90002F10E    	   420:     lea     (MoneyGameLossAmounts).l,A0
02:0002F24C 10303000        	   421:     move.b  (A0,D3.W),D0
02:0002F250 1940046F        	   422:     move.b  D0,($046F,A4)
                            	   423:     ; Put 10 in [0470]. This is a fixed amount to lose.
                            	   424:     ;
02:0002F254 700A            	   425:     moveq   #10,D0
02:0002F256 19400470        	   426:     move.b  D0,($0470,A4)
                            	   427:     ; With a different bit of the second random number,
                            	   428:     ; choose 20 or 50 to put in [0471]. This is an amount to win.
                            	   429:     ;
02:0002F25A 7614            	   430:     moveq   #20,D3
02:0002F25C 102C001A        	   431:     move.b  ($001A,A4),D0
02:0002F260 02000002        	   432:     andi.b #$02,D0
02:0002F264 6702            	   433:     beq  _anon_z01_1
02:0002F266 7632            	   434:     moveq   #50,D3
                            	   435: _anon_z01_1:
02:0002F268 19430471        	   436:     move.b  D3,($0471,A4)
                            	   437:     ; The 3 amounts are now in [046F] to [0471].
                            	   438:     ; Reference these amounts using the permutation of indexes
                            	   439:     ; in [046C] to [046E]; and copy them to [0448] to [044A].
                            	   440:     ;
02:0002F26C 7402            	   441:     moveq   #2,D2
                            	   442:     even
