                            	   313: DriveAudio:
                            	   314:     ; PATCHED: NOP — audio data requires NES bank mapping not yet implemented.
02:0002DDEA 4E75            	   315:     rts
                            	   316:     ; If the game is paused, then silence all channels
                            	   317:     ; by first disabling them, then enabling them.
                            	   318:     ;
                            	   319:     ; Then go drive tune channel 0 only.
                            	   320:     ;
02:0002DDEC 102C00E0        	   321:     move.b  ($00E0,A4),D0
02:0002DDF0 670E            	   322:     beq  _L_z00_DriveAudio_Play
02:0002DDF2 7000            	   323:     moveq   #0,D0
02:0002DDF4 6100D07E        	   324:     jsr     _apu_write_4015  ; APU/IO write
02:0002DDF8 700F            	   325:     moveq   #15,D0
02:0002DDFA 6100D078        	   326:     jsr     _apu_write_4015  ; APU/IO write
02:0002DDFE 6618            	   327:     bne  _L_z00_DriveAudio_Paused
                            	   328:     even
                            	   329: _L_z00_DriveAudio_Play:
                            	   330:     ; Else the game is not paused.
                            	   331:     ;
                            	   332:     ; Synchronize the APU frame counter once a video frame.
                            	   333:     ;
02:0002DE00 103C00FF        	   334:     move.b  #$FF,D0
02:0002DE04 6100CFE2        	   335:     jsr     _apu_write_4017  ; APU/IO write
                            	   336:     ; Drive each game sound channel.
                            	   337:     ;
02:0002DE08 610003DE        	   338:     jsr     DriveTune1
02:0002DE0C 6100020C        	   339:     jsr     DriveEffect
02:0002DE10 61000502        	   340:     jsr     DriveSample
02:0002DE14 610006A2        	   341:     jsr     DriveSong
                            	   342:     even
                            	   343: _L_z00_DriveAudio_Paused:
02:0002DE18 6100008C        	   344:     jsr     DriveTune0
                            	   345:     ; Reset all requests for sound.
                            	   346:     ;
02:0002DE1C 7000            	   347:     moveq   #0,D0
02:0002DE1E 19400604        	   348:     move.b  D0,($0604,A4)
