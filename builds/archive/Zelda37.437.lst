                            	  4710: ;==============================================================================
                            	  4711: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4712: ;==============================================================================
                            	  4713: 
                            	  4714:     xref    _ShootIfWanted
                            	  4715: 
                            	  4716: ; ShootIfWanted(type, slot)
                            	  4717: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4718: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4719: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4720: c_shoot_if_wanted:
02:0002CEF6 2F02            	  4721:     move.l  D2,-(SP)
02:0002CEF8 202F0008        	  4722:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CEFC 242F000C        	  4723:     move.l  12(SP),D2       ; arg2 = slot
02:0002CF00 4EB90003C6E4    	  4724:     jsr     _ShootIfWanted
02:0002CF06 640C            	  4725:     bcc.s   .csiw_fail
02:0002CF08 7000            	  4726:     moveq   #0,D0
02:0002CF0A 1003            	  4727:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CF0C 008000000100    	  4728:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF12 6002            	  4729:     bra.s   .csiw_done
                            	  4730: .csiw_fail:
02:0002CF14 7000            	  4731:     moveq   #0,D0
                            	  4732: .csiw_done:
02:0002CF16 241F            	  4733:     move.l  (SP)+,D2
02:0002CF18 4E75            	  4734:     rts
