                            	  8498: _L_z05_Submenu_WriteSheetMapRowTransferRecord_MaskRooms:
                            	  8499:     ; For each element ($10) in the row, starting from $F:
                            	  8500:     ; If the current row is set in the submenu map mask,
                            	  8501:     ; then replace the tile with $F5, a blank map tile.
                            	  8502:     ;
02:00041BD8 41F900FF6BBD    	  8503:     lea     (NES_SRAM+$0BBD).l,A0
02:00041BDE 10303000        	  8504:     move.b  (A0,D3.W),D0
02:00041BE2 41F900041B18    	  8505:     lea     (MapRowMasks).l,A0
02:00041BE8 12302000        	  8506:     move.b  (A0,D2.W),D1
02:00041BEC C001            	  8507:     and.b  D1,D0
02:00041BEE 660C            	  8508:     bne  _anon_z05_201
02:00041BF0 103C00F5        	  8509:     move.b  #$F5,D0
02:00041BF4 41EC0305        	  8510:     lea     ($0305,A4),A0
