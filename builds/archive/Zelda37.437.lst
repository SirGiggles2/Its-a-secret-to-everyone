                            	  4986: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  4987:     ; Bloated timer =>
                            	  4988:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  4989:     ; 1:     go advance the substate
                            	  4990:     ; other: go decrement Bloated timer
                            	  4991:     ;
02:0003A50A 7600            	  4992:     moveq   #0,D3
02:0003A50C 41EC045E        	  4993:     lea     ($045E,A4),A0
02:0003A510 16302000        	  4994:     move.b  (A0,D2.W),D3
02:0003A514 5303            	  4995:     subq.b  #1,D3
02:0003A516 6750            	  4996:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A518 6B04            	  4997:     bmi.s  __far_z_04_0043
02:0003A51A 60000080        	  4998:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  4999: __far_z_04_0043:
                            	  5000:     ; Set the bloated timer according to the substate.
                            	  5001:     ;
02:0003A51E 7600            	  5002:     moveq   #0,D3
02:0003A520 41EC042C        	  5003:     lea     ($042C,A4),A0
02:0003A524 16302000        	  5004:     move.b  (A0,D2.W),D3
02:0003A528 41F90003A466    	  5005:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A52E 10303000        	  5006:     move.b  (A0,D3.W),D0
02:0003A532 41EC045E        	  5007:     lea     ($045E,A4),A0
02:0003A536 11802000        	  5008:     move.b  D0,(A0,D2.W)
                            	  5009:     ; If substate <> 0, go decrement bloated timer.
                            	  5010:     ;
02:0003A53A 4A03            	  5011:     cmpi.b  #$00,D3
02:0003A53C 6702            	  5012:     beq.s  __far_z_04_0044
02:0003A53E 605C            	  5013:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5014: __far_z_04_0044:
                            	  5015:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5016:     ;
02:0003A540 7610            	  5017:     moveq   #16,D3
02:0003A542 7000            	  5018:     moveq   #0,D0
02:0003A544 41EC00AC        	  5019:     lea     ($00AC,A4),A0
