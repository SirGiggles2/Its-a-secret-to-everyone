02:00049004 10302000        	  5924:     move.b  (A0,D2.W),D0
02:00049008 0200000F        	  5925:     andi.b #$0F,D0
02:0004900C 7600            	  5926:     moveq   #0,D3
02:0004900E 1600            	  5927:     move.b  D0,D3
02:00049010 7008            	  5928:     moveq   #8,D0
