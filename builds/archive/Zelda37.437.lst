02:00048828 8001            	  4799:     or.b  D1,D0
02:0004882A 4EB900031044    	  4800:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4801:     ; Set [0C] to the correct frame for the direction: horizontal or vertical.
