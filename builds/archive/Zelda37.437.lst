02:000499A6 7001            	  7161:     moveq   #1,D0
02:000499A8 1940004B        	  7162:     move.b  D0,($004B,A4)
02:000499AC 41EC0492        	  7163:     lea     ($0492,A4),A0
02:000499B0 11802000        	  7164:     move.b  D0,(A0,D2.W)
02:000499B4 4E75            	  7165:     rts
                            	  7166:     even
