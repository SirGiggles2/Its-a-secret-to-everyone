                            	  4918: UpdateDodongoState0_Move:
                            	  4919:     ; If facing left, then push X offset 0 on the stack.
                            	  4920:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  4921:     ;
                            	  4922:     ; We would like to use one set of coordinates only.
                            	  4923:     ; But movement would break down, if we did; because
                            	  4924:     ; Dodongo is so long.
                            	  4925:     ;
                            	  4926:     ; So, when not facing left, we temporarily shift the
                            	  4927:     ; X coordinate to be closer to the other side of the monster.
                            	  4928:     ;
02:0003A484 7600            	  4929:     moveq   #0,D3
02:0003A486 41EC0098        	  4930:     lea     ($0098,A4),A0
02:0003A48A 10302000        	  4931:     move.b  (A0,D2.W),D0
02:0003A48E 0200000D        	  4932:     andi.b #$0D,D0
02:0003A492 6716            	  4933:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003A494 10342070        	  4934:     move.b  ($70,A4,D2.W),D0
02:0003A498 023C00EE        	  4935:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A49C 123C0010        	  4936:     move.b  #$10,D1
02:0003A4A0 D101            	  4937:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A4A2 19802070        	  4938:     move.b  D0,($70,A4,D2.W)
02:0003A4A6 163C00F0        	  4939:     move.b  #$F0,D3
                            	  4940:     even
                            	  4941: _L_z04_UpdateDodongoState0_Move_Move:
02:0003A4AA 1003            	  4942:     move.b  D3,D0
02:0003A4AC 1B00            	  4943:     move.b  D0,-(A5)  ; PHA
02:0003A4AE 7020            	  4944:     moveq   #32,D0
02:0003A4B0 41EC041F        	  4945:     lea     ($041F,A4),A0
02:0003A4B4 11802000        	  4946:     move.b  D0,(A0,D2.W)
02:0003A4B8 6100DE8E        	  4947:     jsr     Wanderer_TargetPlayer
                            	  4948:     ; Pop the offset and add it to the X coordinate.
                            	  4949:     ;
                            	  4950:     ; This brings the X coordinate back to the unique value
                            	  4951:     ; that represents the position.
                            	  4952:     ;
02:0003A4BC 101D            	  4953:     move.b  (A5)+,D0  ; PLA
02:0003A4BE 023C00EE        	  4954:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A4C2 12342070        	  4955:     move.b  ($70,A4,D2.W),D1
