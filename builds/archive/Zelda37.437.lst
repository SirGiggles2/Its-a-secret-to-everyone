                            	   284:     ;
02:0002F14A 41F90002F0FA    	   285:     lea     (OverworldPersonTextSelectors).l,A0
02:0002F150 10303000        	   286:     move.b  (A0,D3.W),D0
02:0002F154 1B00            	   287:     move.b  D0,-(A5)  ; PHA
02:0002F156 0200003F        	   288:     andi.b #$3F,D0
02:0002F15A 19400415        	   289:     move.b  D0,($0415,A4)
                            	   290:     ; Pop and mask the text selector byte with $C0 to get the
