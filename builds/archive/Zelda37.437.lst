                            	  4958:     ; If X coordinate < $20, then face right.
                            	  4959:     ;
02:0003A4CC 0C000020        	  4960:     cmpi.b  #$20,D0
02:0003A4D0 640A            	  4961:     bcc  _anon_z04_89
