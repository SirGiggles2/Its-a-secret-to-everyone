                            	  5356:     ; HandleArrowOrBoomerangBlocked.
                            	  5357:     ;
02:00048BD8 7040            	  5358:     moveq   #64,D0
02:00048BDA 41EC00AC        	  5359:     lea     ($00AC,A4),A0
02:00048BDE 11802000        	  5360:     move.b  D0,(A0,D2.W)
                            	  5361:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5362:     ; Else go handle the boomerang being blocked.
                            	  5363:     ;
02:00048BE2 0C02000D        	  5364:     cmpi.b  #$0D,D2
02:00048BE6 640E            	  5365:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:00048BE8 41EC034F        	  5366:     lea     ($034F,A4),A0
