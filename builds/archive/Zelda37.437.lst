                            	  5808: UpdateSwordOrRod:
                            	  5809:     ; If state = 0, the object is not active. So, return.
                            	  5810:     ;
02:00048F1A 41EC00AC        	  5811:     lea     ($00AC,A4),A0
02:00048F1E 10302000        	  5812:     move.b  (A0,D2.W),D0
02:00048F22 0200000F        	  5813:     andi.b #$0F,D0
02:00048F26 674C            	  5814:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5815:     ; Decrement the state timer.
                            	  5816:     ; If it hasn't expired, go move the sword or rod.
                            	  5817:     ;
02:00048F28 41EC03D0        	  5818:     lea     ($03D0,A4),A0
02:00048F2C 53302000        	  5819:     subq.b  #1,(A0,D2.W)
02:00048F30 6644            	  5820:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5821:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5822:     ;
02:00048F32 41EC00AC        	  5823:     lea     ($00AC,A4),A0
02:00048F36 10302000        	  5824:     move.b  (A0,D2.W),D0
02:00048F3A 0200000F        	  5825:     andi.b #$0F,D0
02:00048F3E 7600            	  5826:     moveq   #0,D3
02:00048F40 1600            	  5827:     move.b  D0,D3
02:00048F42 7008            	  5828:     moveq   #8,D0
02:00048F44 5303            	  5829:     subq.b  #1,D3
02:00048F46 6702            	  5830:     beq  _anon_z07_32
02:00048F48 7001            	  5831:     moveq   #1,D0
                            	  5832: _anon_z07_32:
                            	  5833:     ; Set both the player's animation counter and the sword's
                            	  5834:     ; animation counter/timer to this value.
                            	  5835:     ;
