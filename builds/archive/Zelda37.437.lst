                            	  6939: ; Params:
                            	  6940: ; Y: side: 0 for left, 1 for right
                            	  6941: ;
                            	  6942: ; Add the horizontal offset for the current side to Gohma's X to
                            	  6943: ; store the sprite's X in [00].
                            	  6944: ;
                            	  6945:     even
                            	  6946: Gohma_DrawLegsOneSide:
02:0003B3C6 10342070        	  6947:     move.b  ($70,A4,D2.W),D0
02:0003B3CA 023C00EE        	  6948:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B3CE 41F90003B3A4    	  6949:     lea     (GohmaLegOffsetsX).l,A0
02:0003B3D4 12303000        	  6950:     move.b  (A0,D3.W),D1
02:0003B3D8 D101            	  6951:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003B3DA 1880            	  6952:     move.b  D0,($0000,A4)
                            	  6953:     ; The object's Y is the sprite's.
                            	  6954:     ;
02:0003B3DC 41EC0084        	  6955:     lea     ($0084,A4),A0
02:0003B3E0 10302000        	  6956:     move.b  (A0,D2.W),D0
02:0003B3E4 19400001        	  6957:     move.b  D0,($0001,A4)
02:0003B3E8 612A            	  6958:     jsr     Gohma_SetSpriteAttributes
                            	  6959:     ; There are only two frame images for legs: left and right.
                            	  6960:     ; There are two animation frames. They are animated as follows:
                            	  6961:     ;
                            	  6962:     ; Frame 0:
                            	  6963:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  6964:     ; horizontal flipping = frame number = 0
                            	  6965:     ; 
                            	  6966:     ; Frame 1:
                            	  6967:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  6968:     ; horizontal flipping = frame number = 1
                            	  6969:     ;
02:0003B3EA 4EB900049556    	  6970:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003B3F0 1003            	  6971:     move.b  D3,D0
02:0003B3F2 023C00EE        	  6972:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B3F6 41EC03E4        	  6973:     lea     ($03E4,A4),A0
02:0003B3FA 12302000        	  6974:     move.b  (A0,D2.W),D1
02:0003B3FE D101            	  6975:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B400 02000001        	  6976:     andi.b #$01,D0
02:0003B404 023C00EE        	  6977:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B408 123C0004        	  6978:     move.b  #$04,D1
02:0003B40C D101            	  6979:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003B40E 4EF900030D52    	  6980:     jmp     DrawObjectNotMirrored
