                            	  4957:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  4958:     ; Rows 2 to $2D get side walls.
                            	  4959:     ;
02:00035422 0C000001        	  4960:     cmpi.b  #$01,D0
02:00035426 6708            	  4961:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00035428 0C00002E        	  4962:     cmpi.b  #$2E,D0
02:0003542C 6514            	  4963:     bcs  _L_z02_DrawCredits_WriteSideWalls
