                            	  8869: _anon_z04_164:
02:0003C21C 4EB900049584    	  8870:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8871:     ; The frame counter will make the sprite flash.
                            	  8872:     ; The array has the horizontal and vertical flipping attributes.
                            	  8873:     ; Combine them into [03].
                            	  8874:     ;
02:0003C222 102C0015        	  8875:     move.b  ($0015,A4),D0
02:0003C226 02000003        	  8876:     andi.b #$03,D0
02:0003C22A 41F90003C0FA    	  8877:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003C230 12302000        	  8878:     move.b  (A0,D2.W),D1
02:0003C234 8001            	  8879:     or.b  D1,D0
02:0003C236 19400003        	  8880:     move.b  D0,($0003,A4)
02:0003C23A 41F90003C104    	  8881:     lea     (GanonBurstTiles).l,A0
02:0003C240 10302000        	  8882:     move.b  (A0,D2.W),D0
02:0003C244 4EB90003104E    	  8883:     jsr     Anim_WriteSprite
                            	  8884:     ; Bottom of the loop.
