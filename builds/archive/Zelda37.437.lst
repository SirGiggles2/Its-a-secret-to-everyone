02:000489A6 6000FED2        	  5022:     jmp     DeactivateLinkShot
                            	  5023: 
                            	  5024:     even
                            	  5025: L1F49F_Exit:
02:000489AA 4E75            	  5026:     rts
                            	  5027: 
                            	  5028:     even
                            	  5029: UpdateBoomerangOrFood:
                            	  5030:     ; If state = 0, then not active. So, return.
                            	  5031:     ;
02:000489AC 41EC00AC        	  5032:     lea     ($00AC,A4),A0
02:000489B0 10302000        	  5033:     move.b  (A0,D2.W),D0
02:000489B4 6602            	  5034:     bne.s  __far_z_07_0073
02:000489B6 60F2            	  5035:     jmp  L1F49F_Exit
                            	  5036: __far_z_07_0073:
                            	  5037:     ; If the high bit of state is clear, then go update the boomerang.
                            	  5038:     ;
02:000489B8 E308            	  5039:     lsl.b  #1,D0   ; ASL A
02:000489BA 6504            	  5040:     bcs.s  __far_z_07_0074
02:000489BC 600000AA        	  5041:     jmp  UpdateArrowOrBoomerang
                            	  5042: __far_z_07_0074:
                            	  5043:     ; The object is food.
                            	  5044:     ;
                            	  5045:     ; Once the timer has expired, increment the state and set timer to $FF.
                            	  5046:     ; If we reach state $83, then go deactivate the object.
                            	  5047:     ;
                            	  5048:     ; Nothing changes between the states. So, they are used as
                            	  5049:     ; a way to extend the timer. $2FD screen frames in total.
                            	  5050:     ;
02:000489C0 10342028        	  5051:     move.b  ($28,A4,D2.W),D0
02:000489C4 6622            	  5052:     bne  _L_z07_UpdateBoomerangOrFood_CheckMonsterType
02:000489C6 41EC00AC        	  5053:     lea     ($00AC,A4),A0
02:000489CA 52302000        	  5054:     addq.b  #1,(A0,D2.W)
02:000489CE 41EC00AC        	  5055:     lea     ($00AC,A4),A0
02:000489D2 10302000        	  5056:     move.b  (A0,D2.W),D0
02:000489D6 0200000F        	  5057:     andi.b #$0F,D0
02:000489DA 0C000003        	  5058:     cmpi.b  #$03,D0
02:000489DE 674C            	  5059:     beq  _L_z07_UpdateBoomerangOrFood_Deactivate
02:000489E0 103C00FF        	  5060:     move.b  #$FF,D0
02:000489E4 19802028        	  5061:     move.b  D0,($28,A4,D2.W)
                            	  5062:     even
                            	  5063: _L_z07_UpdateBoomerangOrFood_CheckMonsterType:
                            	  5064:     ; If the template object type in the room is one of:
                            	  5065:     ; moblin, goriya, octorock, vire, keese
                            	  5066:     ; then attract these monsters to the food.
                            	  5067:     ;
                            	  5068:     ; They will chase the food instead of Link when given a chance.
                            	  5069:     ;
02:000489E8 102C035F        	  5070:     move.b  ($035F,A4),D0
02:000489EC 0C000003        	  5071:     cmpi.b  #$03,D0
02:000489F0 652C            	  5072:     bcs  _L_z07_UpdateBoomerangOrFood_Draw
02:000489F2 0C00000B        	  5073:     cmpi.b  #$0B,D0
02:000489F6 6512            	  5074:     bcs  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:000489F8 0C000012        	  5075:     cmpi.b  #$12,D0
02:000489FC 670C            	  5076:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:000489FE 0C00001B        	  5077:     cmpi.b  #$1B,D0
02:00048A02 6706            	  5078:     beq  _L_z07_UpdateBoomerangOrFood_AttractMonsters
02:00048A04 0C00001C        	  5079:     cmpi.b  #$1C,D0
02:00048A08 6614            	  5080:     bne  _L_z07_UpdateBoomerangOrFood_Draw
                            	  5081:     even
                            	  5082: _L_z07_UpdateBoomerangOrFood_AttractMonsters:
