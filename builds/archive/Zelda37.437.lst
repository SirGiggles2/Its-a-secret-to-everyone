                            	  9082: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	  9083:     ; If the silver arrow is not in the inventory, then return.
                            	  9084:     ;
02:0003C3B6 102C0659        	  9085:     move.b  ($0659,A4),D0
02:0003C3BA 0C000002        	  9086:     cmpi.b  #$02,D0
02:0003C3BE 66F4            	  9087:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  9088:     ; Reset the collision return value [06].
                            	  9089:     ;
