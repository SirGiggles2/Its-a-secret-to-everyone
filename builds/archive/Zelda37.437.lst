                            	  3791: _L_z07_Walker_Move_ChooseObjDirOrInputDir:
                            	  3792:     ; Summary: Choose object direction or input direction for movement as appropriate.
                            	  3793:     ;
                            	  3794:     ; Player: If there's input, then use input direction when grid offset = 0,
                            	  3795:     ;         or object direction when <> 0.
                            	  3796:     ;
                            	  3797:     ; Other objects: Move in input direction, unless stunned or magic clock is active.
                            	  3798:     ;
                            	  3799:     ; if slot = 0 and grid offset <> 0 then
                            	  3800:     ;   if input dir = 0 then
                            	  3801:     ;     use 0
                            	  3802:     ;   else
                            	  3803:     ;     use object direction
                            	  3804:     ; else
                            	  3805:     ;   if slot <> 0 and (has clock or stunned) then
                            	  3806:     ;     return
                            	  3807:     ;   else
                            	  3808:     ;     if input dir = 0
                            	  3809:     ;       use 0
                            	  3810:     ;     else
                            	  3811:     ;       use input direction
                            	  3812:     ;
