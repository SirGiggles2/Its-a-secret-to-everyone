02:00039D6A 10302000        	  3975:     move.b  (A0,D2.W),D0
02:00039D6E 41EC0380        	  3976:     lea     ($0380,A4),A0
02:00039D72 11802000        	  3977:     move.b  D0,(A0,D2.W)
                            	  3978:     even
