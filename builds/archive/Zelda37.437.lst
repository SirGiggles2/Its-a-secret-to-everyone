02:00038EC0 1940004D        	  1894:     move.b  D0,($004D,A4)
02:00038EC4 6100008C        	  1895:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  1896:     ; The leever has to face Link in order to move toward him.
                            	  1897:     ;
02:00038EC8 4EB9000484F4    	  1898:     jsr     ReverseObjDir
                            	  1899:     even
                            	  1900: _L_z04_UpdateRedLeever_CheckOtherStates:
