                            	  3252: _L_z07_BeginUpdateWorld_NextObject:
                            	  3253:     ; Bottom of the object update loop.
                            	  3254:     ;
02:00047E4A 532C0340        	  3255:     subq.b  #1,($0340,A4)
02:00047E4E 669C            	  3256:     bne  _L_z07_BeginUpdateWorld_LoopObject
                            	  3257:     ; Set the current object slot to what it should be when we
                            	  3258:     ; begin updating objects again next frame: $B
                            	  3259:     ; the last object slot for monsters and tile objects
                            	  3260:     ;
                            	  3261:     ; Before the first frame of mode 5, the current object slot variable
                            	  3262:     ; was set to $B in 05:87B9 (InitMode_EnterRoom).
                            	  3263:     ;
                            	  3264:     ; This can also be called the last slot for dynamically allocated objects.
                            	  3265:     ;
02:00047E50 700B            	  3266:     moveq   #11,D0
02:00047E52 19400340        	  3267:     move.b  D0,($0340,A4)
