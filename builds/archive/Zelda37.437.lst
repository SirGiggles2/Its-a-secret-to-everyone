                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A83A 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0003A83E 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0003A842 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A846 123C0038        	  5434:     move.b  #$38,D1
02:0003A84A D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A84C 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0003A850 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0003A854 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003A858 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0003A85C 123C0000        	  5442:     move.b  #$00,D1
02:0003A860 D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A862 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0003A866 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0003A86A 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A86E 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0003A872 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0003A876 D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0003A878 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0003A87C 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
02:0003A880 41EC0412        	  5456:     lea     ($0412,A4),A0
02:0003A884 10302000        	  5457:     move.b  (A0,D2.W),D0
02:0003A888 6B0000AC        	  5458:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5459:     ; If Y coordinate still < target Y, then return.
                            	  5460:     ;
02:0003A88C 41EC0084        	  5461:     lea     ($0084,A4),A0
02:0003A890 10302000        	  5462:     move.b  (A0,D2.W),D0
02:0003A894 41EC042C        	  5463:     lea     ($042C,A4),A0
02:0003A898 12302000        	  5464:     move.b  (A0,D2.W),D1
02:0003A89C B001            	  5465:     cmp.b   D1,D0
02:0003A89E 65000096        	  5466:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5467:     ; Else reached the destination. Go to state 0.
                            	  5468:     ;
02:0003A8A2 7000            	  5469:     moveq   #0,D0
02:0003A8A4 41EC00AC        	  5470:     lea     ($00AC,A4),A0
02:0003A8A8 11802000        	  5471:     move.b  D0,(A0,D2.W)
                            	  5472:     ; Reset 16-bit vertical speed.
                            	  5473:     ;
02:0003A8AC 41EC0444        	  5474:     lea     ($0444,A4),A0
02:0003A8B0 11802000        	  5475:     move.b  D0,(A0,D2.W)
02:0003A8B4 41EC0412        	  5476:     lea     ($0412,A4),A0
02:0003A8B8 11802000        	  5477:     move.b  D0,(A0,D2.W)
                            	  5478:     ; Choose a random direction to face in.
                            	  5479:     ;
02:0003A8BC 10342018        	  5480:     move.b  ($18,A4,D2.W),D0
02:0003A8C0 02000003        	  5481:     andi.b #$03,D0
02:0003A8C4 7600            	  5482:     moveq   #0,D3
02:0003A8C6 1600            	  5483:     move.b  D0,D3
02:0003A8C8 41F90003A6D8    	  5484:     lea     (PolsVoiceDirections).l,A0
02:0003A8CE 10303000        	  5485:     move.b  (A0,D3.W),D0
02:0003A8D2 41EC0098        	  5486:     lea     ($0098,A4),A0
02:0003A8D6 11802000        	  5487:     move.b  D0,(A0,D2.W)
                            	  5488:     ; Randomly set distance-to-move to $30 or $70.
                            	  5489:     ;
02:0003A8DA 10342018        	  5490:     move.b  ($18,A4,D2.W),D0
02:0003A8DE 02000040        	  5491:     andi.b #$40,D0
02:0003A8E2 123C0030        	  5492:     move.b  #$30,D1
02:0003A8E6 D101            	  5493:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003A8E8 41EC0394        	  5494:     lea     ($0394,A4),A0
02:0003A8EC 11802000        	  5495:     move.b  D0,(A0,D2.W)
                            	  5496:     ; Align the monster with a square horizontally.
                            	  5497:     ;
                            	  5498:     ; If in the left half of a square, align with that square.
                            	  5499:     ; If in the right half, align with the next square.
                            	  5500:     ;
02:0003A8F0 10342070        	  5501:     move.b  ($70,A4,D2.W),D0
02:0003A8F4 023C00EE        	  5502:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A8F8 123C0008        	  5503:     move.b  #$08,D1
02:0003A8FC D101            	  5504:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A8FE 020000F0        	  5505:     andi.b #$F0,D0
02:0003A902 19802070        	  5506:     move.b  D0,($70,A4,D2.W)
                            	  5507:     ; Align the monster with a square vertically.
                            	  5508:     ;
                            	  5509:     ; If in the top half of a square, align with that square.
                            	  5510:     ; If in the bottom half, align with the next square.
                            	  5511:     ;
02:0003A906 41EC0084        	  5512:     lea     ($0084,A4),A0
02:0003A90A 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0003A90E 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A912 123C0008        	  5515:     move.b  #$08,D1
02:0003A916 D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A918 020000F0        	  5517:     andi.b #$F0,D0
                            	  5518:     ; Make sure the lower nibble of Y is $D as usual.
                            	  5519:     ;
02:0003A91C 003C0011        	  5520:     ori     #$11,CCR  ; SEC: set C+X
02:0003A920 123C0003        	  5521:     move.b  #$03,D1
02:0003A924 0A3C0010        	  5522:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A928 9101            	  5523:     subx.b  D1,D0   ; SBC #$03
02:0003A92A 0A3C0010        	  5524:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A92E 41EC0084        	  5525:     lea     ($0084,A4),A0
02:0003A932 11802000        	  5526:     move.b  D0,(A0,D2.W)
                            	  5527:     even
