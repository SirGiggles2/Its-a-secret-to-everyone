02:00048FDA 19802070        	  5907:     move.b  D0,($70,A4,D2.W)
02:00048FDE 1880            	  5908:     move.b  D0,($0000,A4)
                            	  5909:     ; Set object's Y to player's Y + offset for state and direction.
                            	  5910:     ; Copy the result to [01].
                            	  5911:     ;
02:00048FE0 102C0084        	  5912:     move.b  ($0084,A4),D0
02:00048FE4 023C00EE        	  5913:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048FE8 41F900048F0A    	  5914:     lea     (PlayerToWeaponOffsetsY).l,A0
02:00048FEE 12303000        	  5915:     move.b  (A0,D3.W),D1
02:00048FF2 D101            	  5916:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:00048FF4 41EC0084        	  5917:     lea     ($0084,A4),A0
02:00048FF8 11802000        	  5918:     move.b  D0,(A0,D2.W)
02:00048FFC 19400001        	  5919:     move.b  D0,($0001,A4)
                            	  5920:     ; If state = 1, use up direction.
                            	  5921:     ; Else use object direction.
