02:00038DDC 10302000        	  1769:     move.b  (A0,D2.W),D0
02:00038DE0 0200000C        	  1770:     andi.b #$0C,D0
02:00038DE4 6742            	  1771:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  1772:     ; Begin with the leever's X set to Link's X.
