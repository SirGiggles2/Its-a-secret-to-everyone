02:000393E0 102C0070        	  2668:     move.b  ($0070,A4),D0
02:000393E4 12342070        	  2669:     move.b  ($70,A4,D2.W),D1
02:000393E8 B001            	  2670:     cmp.b   D1,D0
02:000393EA 667C            	  2671:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  2672:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  2673:     ; is positive; then go use it along with a flag that indicates that
                            	  2674:     ; Link is "down" from the object.
                            	  2675:     ;
02:000393EC 7600            	  2676:     moveq   #0,D3
02:000393EE 102C0084        	  2677:     move.b  ($0084,A4),D0
