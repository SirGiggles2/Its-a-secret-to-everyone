02:00038BD4 41EC0412        	  1502:     lea     ($0412,A4),A0
02:00038BD8 10302000        	  1503:     move.b  (A0,D2.W),D0
02:00038BDC 123C0000        	  1504:     move.b  #$00,D1
02:00038BE0 D101            	  1505:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00038BE2 41EC0412        	  1506:     lea     ($0412,A4),A0
02:00038BE6 11802000        	  1507:     move.b  D0,(A0,D2.W)
                            	  1508:     ; *Signed comparison*:
                            	  1509:     ; If the high speed byte < high max speed byte, then return.
