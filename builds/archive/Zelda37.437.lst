02:0003C13E 10303000        	  8757:     move.b  (A0,D3.W),D0
02:0003C142 41EC009A        	  8758:     lea     ($009A,A4),A0
02:0003C146 11803000        	  8759:     move.b  D0,(A0,D3.W)
02:0003C14A 5303            	  8760:     subq.b  #1,D3
02:0003C14C 6AC2            	  8761:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003C14E 4E75            	  8762:     rts
