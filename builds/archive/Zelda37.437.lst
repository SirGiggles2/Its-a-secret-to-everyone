02:00034F54 123C0010        	  4567:     move.b  #$10,D1
02:00034F58 0A3C0010        	  4568:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F5C 9101            	  4569:     subx.b  D1,D0   ; SBC #$10
02:00034F5E 0A3C0010        	  4570:     eori    #$10,CCR  ; restore X = 6502 C
