                            	  3542: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3543:     ; Loop to look for a place to spawn a monster from the edge
                            	  3544:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3545:     ;
                            	  3546:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3547:     ; We'll move down $10 pixels.
                            	  3548:     ;
02:0003E8EA 7610            	  3549:     moveq   #16,D3
02:0003E8EC 102C000A        	  3550:     move.b  ($000A,A4),D0
02:0003E8F0 0200000F        	  3551:     andi.b #$0F,D0
02:0003E8F4 670A            	  3552:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3553:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3554:     ; Don't move vertically.
                            	  3555:     ;
02:0003E8F6 163C00F0        	  3556:     move.b  #$F0,D3
02:0003E8FA 0C00000F        	  3557:     cmpi.b  #$0F,D0
02:0003E8FE 6610            	  3558:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3559:     even
                            	  3560: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3561:     ; Else low nibble = $F. We're at the right edge,
                            	  3562:     ; and we'll move up $10 pixels.
                            	  3563:     ;
02:0003E900 1003            	  3564:     move.b  D3,D0
02:0003E902 023C00EE        	  3565:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E906 122C000A        	  3566:     move.b  ($000A,A4),D1
02:0003E90A D101            	  3567:     addx.b  D1,D0   ; ADC $0A
02:0003E90C 1940000A        	  3568:     move.b  D0,($000A,A4)
                            	  3569:     even
                            	  3570: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3571:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3572:     ; Move right one pixel.
                            	  3573:     ;
02:0003E910 102C000A        	  3574:     move.b  ($000A,A4),D0
02:0003E914 020000F0        	  3575:     andi.b #$F0,D0
02:0003E918 0C0000E0        	  3576:     cmpi.b  #$E0,D0
02:0003E91C 6606            	  3577:     bne  _anon_z05_88
02:0003E91E 522C000A        	  3578:     addq.b  #1,($000A,A4)
02:0003E922 600A            	  3579:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3580: 
                            	  3581: _anon_z05_88:
                            	  3582:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3583:     ; Dont' move horizontally.
                            	  3584:     ;
02:0003E924 0C000040        	  3585:     cmpi.b  #$40,D0
02:0003E928 6604            	  3586:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3587:     ; Else high nibble = 4. We're at the top edge.
                            	  3588:     ; Move left 1 pixel.
                            	  3589:     ;
02:0003E92A 532C000A        	  3590:     subq.b  #1,($000A,A4)
                            	  3591:     even
                            	  3592: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3593:     ; Time to get the address of the column.
