02:0002BF90 08000008        	  2495:     btst    #8,D0
02:0002BF94 670A            	  2496:     beq.s   .cc_cnr
02:0002BF96 003C0001        	  2497:     ori     #$01,CCR
02:0002BF9A 0A3C0001        	  2498:     eori    #$01,CCR
02:0002BF9E 4E75            	  2499:     rts
                            	  2500: .cc_cnr:
02:0002BFA0 023C00FE        	  2501:     andi    #$FE,CCR
02:0002BFA4 0A3C0001        	  2502:     eori    #$01,CCR
02:0002BFA8 4E75            	  2503:     rts
