02:0002F51C 29450004        	   823:     move.l  D5,($04,A4)       ; store to [$04:$07]
02:0002F520 41F90002F4F0    	   824:     lea     (DemoPatternBlockSizes).l,A0
02:0002F526 10302000        	   825:     move.b  (A0,D2.W),D0
