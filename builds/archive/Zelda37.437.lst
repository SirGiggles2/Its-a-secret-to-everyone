02:0003BE86 7600            	  8344:     moveq   #0,D3
02:0003BE88 162C045F        	  8345:     move.b  ($045F,A4),D3
                            	  8346:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  8347:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  8348:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  8349:     ;
02:0003BE8C 41EC034F        	  8350:     lea     ($034F,A4),A0
02:0003BE90 10302000        	  8351:     move.b  (A0,D2.W),D0
02:0003BE94 0C000025        	  8352:     cmpi.b  #$25,D0
02:0003BE98 661E            	  8353:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BE9A 41F90003BD8C    	  8354:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003BEA0 10303000        	  8355:     move.b  (A0,D3.W),D0
02:0003BEA4 1B00            	  8356:     move.b  D0,-(A5)  ; PHA
02:0003BEA6 41F90003BD90    	  8357:     lea     (PatraChild1RotationSineBits).l,A0
02:0003BEAC 10303000        	  8358:     move.b  (A0,D3.W),D0
02:0003BEB0 7600            	  8359:     moveq   #0,D3
02:0003BEB2 1600            	  8360:     move.b  D0,D3
02:0003BEB4 101D            	  8361:     move.b  (A5)+,D0  ; PLA
02:0003BEB6 600E            	  8362:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  8363: 
                            	  8364:     even
                            	  8365: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  8366:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  8367:     ; for both Y and X increment calculations in rotation. This leads to
                            	  8368:     ; a small circle (5) and a large circle (6).
                            	  8369:     ;
02:0003BEB8 41F90003BD8E    	  8370:     lea     (PatraChild2RotationBits).l,A0
02:0003BEBE 10303000        	  8371:     move.b  (A0,D3.W),D0
02:0003BEC2 7600            	  8372:     moveq   #0,D3
02:0003BEC4 1600            	  8373:     move.b  D0,D3
                            	  8374:     even
