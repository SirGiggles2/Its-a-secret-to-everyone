02:000391AA 41EC0492        	  2325:     lea     ($0492,A4),A0
02:000391AE 10302000        	  2326:     move.b  (A0,D2.W),D0
02:000391B2 66EC            	  2327:     bne  _anon_z04_53
02:000391B4 4EB900049D7E    	  2328:     jsr     ResetObjMetastateAndTimer
02:000391BA 6000F794        	  2329:     jmp     EndInitFlyer
