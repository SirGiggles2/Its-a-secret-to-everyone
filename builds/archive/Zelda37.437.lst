                            	  6829: _anon_z04_111:
                            	  6830:     ; Store in [00] the animation frame that you get from the frame accumulator:
                            	  6831:     ; frame := ((accumulator AND $10) >> 4
                            	  6832:     ;
02:0003B312 41EC0451        	  6833:     lea     ($0451,A4),A0
02:0003B316 10302000        	  6834:     move.b  (A0,D2.W),D0
02:0003B31A 02000010        	  6835:     andi.b #$10,D0
02:0003B31E E208            	  6836:     lsr.b  #1,D0   ; LSR A
02:0003B320 E208            	  6837:     lsr.b  #1,D0   ; LSR A
02:0003B322 E208            	  6838:     lsr.b  #1,D0   ; LSR A
02:0003B324 E208            	  6839:     lsr.b  #1,D0   ; LSR A
02:0003B326 1880            	  6840:     move.b  D0,($0000,A4)
                            	  6841:     ; Copy the animation frame bit into the "frame image and
                            	  6842:     ; sprite attributes" byte.
                            	  6843:     ;
