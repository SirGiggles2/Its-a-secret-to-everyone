                            	  2332: UpdateArmos:
02:000391BE 6100F296        	  2333:     jsr     UpdateGoriya
                            	  2334:     ; If it's still shoved, then don't animate. Only go draw.
                            	  2335:     ;
02:000391C2 41EC00C0        	  2336:     lea     ($00C0,A4),A0
02:000391C6 10302000        	  2337:     move.b  (A0,D2.W),D0
02:000391CA 6702            	  2338:     beq.s  __far_z_04_0018
02:000391CC 602A            	  2339:     jmp  DrawArmosAndCheckCollisions
                            	  2340: __far_z_04_0018:
                            	  2341:     ; Animate.
                            	  2342:     ;
                            	  2343:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  2344:     ; then only go draw.
                            	  2345:     ;
02:000391CE 41EC03D0        	  2346:     lea     ($03D0,A4),A0
02:000391D2 53302000        	  2347:     subq.b  #1,(A0,D2.W)
02:000391D6 6702            	  2348:     beq.s  __far_z_04_0019
02:000391D8 601E            	  2349:     jmp  DrawArmosAndCheckCollisions
                            	  2350: __far_z_04_0019:
                            	  2351:     ; Armos animation frames last 6 screen frames.
                            	  2352:     ;
02:000391DA 7006            	  2353:     moveq   #6,D0
02:000391DC 41EC03D0        	  2354:     lea     ($03D0,A4),A0
02:000391E0 11802000        	  2355:     move.b  D0,(A0,D2.W)
                            	  2356:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  2357:     ; change the position of the shield. To keep fixed it in place,
                            	  2358:     ; there are separate frame images for each animation frame.
                            	  2359:     ;
                            	  2360:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  2361:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  2362:     ;
                            	  2363:     ; Here flip between the two sets by XOR'ing with 2.
                            	  2364:     ; Then choose the direction at the point of drawing below.
                            	  2365:     ;
02:000391E4 41EC03E4        	  2366:     lea     ($03E4,A4),A0
02:000391E8 10302000        	  2367:     move.b  (A0,D2.W),D0
02:000391EC 0A000002        	  2368:     eori.b #$02,D0
02:000391F0 41EC03E4        	  2369:     lea     ($03E4,A4),A0
02:000391F4 11802000        	  2370:     move.b  D0,(A0,D2.W)
                            	  2371:     even
                            	  2372: DrawArmosAndCheckCollisions:
02:000391F8 4EB900049584    	  2373:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:000391FE 7600            	  2374:     moveq   #0,D3
02:00039200 41EC0098        	  2375:     lea     ($0098,A4),A0
02:00039204 16302000        	  2376:     move.b  (A0,D2.W),D3
                            	  2377:     ; If facing up, then use the second frame image in the set ("back").
                            	  2378:     ; Else use the second.
                            	  2379:     ;
02:00039208 0C030008        	  2380:     cmpi.b  #$08,D3
02:0003920C 6602            	  2381:     bne  _anon_z04_54
02:0003920E 7001            	  2382:     moveq   #1,D0
                            	  2383: _anon_z04_54:
02:00039210 023C00EE        	  2384:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039214 41EC03E4        	  2385:     lea     ($03E4,A4),A0
02:00039218 12302000        	  2386:     move.b  (A0,D2.W),D1
02:0003921C D101            	  2387:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003921E 4EB900030D52    	  2388:     jsr     DrawObjectNotMirrored
                            	  2389:     ; If the armos is still fading in, then go for check collision with Link,
                            	  2390:     ; but not with weapons.
                            	  2391:     ;
02:00039224 10342028        	  2392:     move.b  ($28,A4,D2.W),D0
02:00039228 661C            	  2393:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  2394:     ; Else check for all collisions.
                            	  2395:     ;
02:0003922A 4EB9000310BE    	  2396:     jsr     CheckMonsterCollisions
                            	  2397:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  2398:     ;
02:00039230 41EC0405        	  2399:     lea     ($0405,A4),A0
02:00039234 10302000        	  2400:     move.b  (A0,D2.W),D0
02:00039238 670A            	  2401:     beq  _anon_z04_55
02:0003923A 705D            	  2402:     moveq   #93,D0
02:0003923C 41EC034F        	  2403:     lea     ($034F,A4),A0
02:00039240 11802000        	  2404:     move.b  D0,(A0,D2.W)
                            	  2405: _anon_z04_55:
02:00039244 4E75            	  2406:     rts
                            	  2407: 
                            	  2408:     even
                            	  2409: _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision:
02:00039246 4EF900031124    	  2410:     jmp     CheckLinkCollision
                            	  2411: 
