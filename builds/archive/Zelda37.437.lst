                            	   272:     ; Get this cave's index (object type - $6A).
                            	   273:     ;
02:0002F130 102C0350        	   274:     move.b  ($0350,A4),D0
02:0002F134 003C0011        	   275:     ori     #$11,CCR  ; SEC: set C+X
02:0002F138 123C006A        	   276:     move.b  #$6A,D1
02:0002F13C 0A3C0010        	   277:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002F140 9101            	   278:     subx.b  D1,D0   ; SBC #$6A
02:0002F142 0A3C0010        	   279:     eori    #$10,CCR  ; restore X = 6502 C
02:0002F146 7600            	   280:     moveq   #0,D3
02:0002F148 1600            	   281:     move.b  D0,D3
                            	   282:     ; Get the person text selector by looking up the text selector byte
