02:00038F64 0C000006        	  1982:     cmpi.b  #$06,D0
02:00038F68 6506            	  1983:     bcs  _anon_z04_47
02:00038F6A 532C0510        	  1984:     subq.b  #1,($0510,A4)
02:00038F6E 7000            	  1985:     moveq   #0,D0
                            	  1986: _anon_z04_47:
