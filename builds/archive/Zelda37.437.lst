                            	  5588:     ;
02:000401FE 7630            	  5589:     moveq   #48,D3
02:00040200 19430028        	  5590:     move.b  D3,($0028,A4)
                            	  5591: _anon_z05_119:
02:00040204 02000003        	  5592:     andi.b #$03,D0
02:00040208 003C0011        	  5593:     ori     #$11,CCR  ; SEC: set C+X
02:0004020C 123C0001        	  5594:     move.b  #$01,D1
02:00040210 0A3C0010        	  5595:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040214 9101            	  5596:     subx.b  D1,D0   ; SBC #$01
02:00040216 0A3C0010        	  5597:     eori    #$10,CCR  ; restore X = 6502 C
02:0004021A 02000002        	  5598:     andi.b #$02,D0
02:0004021E 19400008        	  5599:     move.b  D0,($0008,A4)
                            	  5600:     ; The command to close a key door or bombable wall does not
                            	  5601:     ; do anything.
                            	  5602:     ;
02:00040222 102C0054        	  5603:     move.b  ($0054,A4),D0
02:00040226 0C000005        	  5604:     cmpi.b  #$05,D0
02:0004022A 6416            	  5605:     bcc  _anon_z05_120
02:0004022C 102C0055        	  5606:     move.b  ($0055,A4),D0
02:00040230 19400002        	  5607:     move.b  D0,($0002,A4)
02:00040234 6100FAEC        	  5608:     jsr     FindDoorAttrByDoorBit
