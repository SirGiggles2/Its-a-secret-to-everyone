02:00048F0A F7              	  5804:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:00048F0B F2
02:00048F0C F5
02:00048F0D F5
02:00048F0E F6
02:00048F0F 0D
02:00048F10 03
02:00048F11 03
02:00048F12 F7              	  5805:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:00048F13 09
02:00048F14 03
02:00048F15 03
02:00048F16 FF
02:00048F17 05
02:00048F18 03
02:00048F19 03
