                            	  1795:     ;
02:00038E10 020000F0        	  1796:     andi.b #$F0,D0
02:00038E14 0000000D        	  1797:     ori.b #$0D,D0
02:00038E18 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038E1C 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
                            	  1802:     ;
                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038E20 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038E24 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
02:00038E26 4E75            	  1809:     rts
                            	  1810: 
                            	  1811:     even
                            	  1812: _L_z04_UpdateRedLeever_PlaceHorizontally:
                            	  1813:     ; Begin with the leever's Y set to Link's Y.
                            	  1814:     ;
02:00038E28 102C0084        	  1815:     move.b  ($0084,A4),D0
02:00038E2C 41EC0084        	  1816:     lea     ($0084,A4),A0
02:00038E30 11802000        	  1817:     move.b  D0,(A0,D2.W)
                            	  1818:     ; If Y coordinate < $5D (top of the third square row), then
                            	  1819:     ; it's too close to the top edge of the screen. So, return.
                            	  1820:     ;
02:00038E34 0C00005D        	  1821:     cmpi.b  #$5D,D0
02:00038E38 65EC            	  1822:     bcs  _L_z04_UpdateRedLeever_Exit
                            	  1823:     ; If facing right, then use X offset $28.
                            	  1824:     ; Else store X offset -$28 in [00].
                            	  1825:     ;
02:00038E3A 7628            	  1826:     moveq   #40,D3
02:00038E3C 41EC0098        	  1827:     lea     ($0098,A4),A0
02:00038E40 10302000        	  1828:     move.b  (A0,D2.W),D0
02:00038E44 02000002        	  1829:     andi.b #$02,D0
02:00038E48 6704            	  1830:     beq  _anon_z04_45
02:00038E4A 163C00D8        	  1831:     move.b  #$D8,D3
                            	  1832: _anon_z04_45:
02:00038E4E 1883            	  1833:     move.b  D3,($0000,A4)
                            	  1834:     ; [01] holds Link's X coordinate.
                            	  1835:     ;
02:00038E50 102C0070        	  1836:     move.b  ($0070,A4),D0
02:00038E54 19400001        	  1837:     move.b  D0,($0001,A4)
                            	  1838:     ; Add Link's X and the horizontal offset.
                            	  1839:     ;
02:00038E58 023C00EE        	  1840:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038E5C 1214            	  1841:     move.b  ($0000,A4),D1
02:00038E5E D101            	  1842:     addx.b  D1,D0   ; ADC $00
                            	  1843:     ; AND the result with $F8, so it's aligned with a tile horizontally.
                            	  1844:     ;
02:00038E60 020000F8        	  1845:     andi.b #$F8,D0
                            	  1846:     ; Assign that result to the leever's X coordinate and [02].
                            	  1847:     ;
02:00038E64 19802070        	  1848:     move.b  D0,($70,A4,D2.W)
02:00038E68 19400002        	  1849:     move.b  D0,($0002,A4)
                            	  1850:     ; If the leever's X [02] >= Link's X [01], then swap [02] and [01].
                            	  1851:     ;
02:00038E6C 122C0001        	  1852:     move.b  ($0001,A4),D1
02:00038E70 B001            	  1853:     cmp.b   D1,D0
02:00038E72 6510            	  1854:     bcs  _L_z04_UpdateRedLeever_Subtract
02:00038E74 1B00            	  1855:     move.b  D0,-(A5)  ; PHA
02:00038E76 102C0001        	  1856:     move.b  ($0001,A4),D0
02:00038E7A 19400002        	  1857:     move.b  D0,($0002,A4)
02:00038E7E 101D            	  1858:     move.b  (A5)+,D0  ; PLA
02:00038E80 19400001        	  1859:     move.b  D0,($0001,A4)
                            	  1860:     even
                            	  1861: _L_z04_UpdateRedLeever_Subtract:
                            	  1862:     ; The point is to get the absolute distance between the two.
                            	  1863:     ;
02:00038E84 102C0001        	  1864:     move.b  ($0001,A4),D0
02:00038E88 003C0011        	  1865:     ori     #$11,CCR  ; SEC: set C+X
02:00038E8C 122C0002        	  1866:     move.b  ($0002,A4),D1
02:00038E90 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038E94 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:00038E96 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
                            	  1870:     ; If the absolute distance >= $30, then return.
                            	  1871:     ; It means that the leever's X coordinate wrapped around
                            	  1872:     ; the left or right edge of the screen.
                            	  1873:     ;
02:00038E9A 0C000030        	  1874:     cmpi.b  #$30,D0
02:00038E9E 6486            	  1875:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1876:     even
                            	  1877: _L_z04_UpdateRedLeever_CheckSafeToSpawn:
                            	  1878:     ; The leever can't come out of an unwalkable tile. So, return.
                            	  1879:     ;
02:00038EA0 4EB900047F8C    	  1880:     jsr     GetCollidableTileStill
02:00038EA6 122C034A        	  1881:     move.b  ($034A,A4),D1
02:00038EAA B001            	  1882:     cmp.b   D1,D0
02:00038EAC 6400FF78        	  1883:     bcc  _L_z04_UpdateRedLeever_Exit
02:00038EB0 522C0510        	  1884:     addq.b  #1,($0510,A4)
                            	  1885:     ; Set animation counter to 1, so that it will roll over this frame
                            	  1886:     ; and pick up whatever the new value is for state 1.
                            	  1887:     ;
02:00038EB4 7001            	  1888:     moveq   #1,D0
02:00038EB6 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:00038EBA 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
