                            	  5908:     even
                            	  5909: LayoutUWFloor:
02:00040450 7005            	  5910:     moveq   #5,D0
02:00040452 4EB90002A9FA    	  5911:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:00040458 61007260        	  5912:     jsr     GetUniqueRoomId
02:0004045C 1B00            	  5913:     move.b  D0,-(A5)  ; PHA
02:0004045E 7000            	  5914:     moveq   #0,D0
02:00040460 19400002        	  5915:     move.b  D0,($0002,A4)
02:00040464 7000            	  5916:     moveq   #0,D0
02:00040466 19400003        	  5917:     move.b  D0,($0003,A4)
