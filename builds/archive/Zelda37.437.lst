                            	  3942:     even
                            	  3943: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  3944:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  3945:     ;
02:00039D3A 7004            	  3946:     moveq   #4,D0
02:00039D3C 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:00039D3E 7600            	  3950:     moveq   #0,D3
02:00039D40 0C020005        	  3951:     cmpi.b  #$05,D2
02:00039D44 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:00039D46 7605            	  3953:     moveq   #5,D3
                            	  3954:     even
                            	  3955: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  3956:     ; Copy old direction from a higher slot to the lower one;
                            	  3957:     ; and to the lower one's facing direction.
                            	  3958:     ;
02:00039D48 41EC0382        	  3959:     lea     ($0382,A4),A0
02:00039D4C 10303000        	  3960:     move.b  (A0,D3.W),D0
02:00039D50 41EC0381        	  3961:     lea     ($0381,A4),A0
02:00039D54 11803000        	  3962:     move.b  D0,(A0,D3.W)
02:00039D58 41EC0099        	  3963:     lea     ($0099,A4),A0
02:00039D5C 11803000        	  3964:     move.b  D0,(A0,D3.W)
                            	  3965:     ; Bottom of the loop.
                            	  3966:     ; Increment segment index.
                            	  3967:     ; Decrement loop counter.
                            	  3968:     ;
02:00039D60 5203            	  3969:     addq.b  #1,D3
02:00039D62 5314            	  3970:     subq.b  #1,($0000,A4)
02:00039D64 66E2            	  3971:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  3972:     ; Copy current direction to old direction.
