02:00039FE0 10302000        	  4312:     move.b  (A0,D2.W),D0
02:00039FE4 41EC0437        	  4313:     lea     ($0437,A4),A0
02:00039FE8 12302000        	  4314:     move.b  (A0,D2.W),D1
02:00039FEC B001            	  4315:     cmp.b   D1,D0
02:00039FEE 6704            	  4316:     beq.s  __far_z_04_0038
02:00039FF0 6000009E        	  4317:     jmp  L116EA_Exit
                            	  4318: __far_z_04_0038:
02:00039FF4 41EC042C        	  4319:     lea     ($042C,A4),A0
