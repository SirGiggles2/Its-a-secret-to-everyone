                            	  8216: __far_z_04_0090:
                            	  8217:     ; State = 0.
                            	  8218:     ;
                            	  8219:     ; If the current object slot is 2, then go initialize the patra child.
                            	  8220:     ; This is the only patra child shown in the first fame.
                            	  8221:     ;
02:0003BDA0 0C020002        	  8222:     cmpi.b  #$02,D2
02:0003BDA4 6732            	  8223:     beq  _L_z04_UpdatePatraChild_Ready
                            	  8224:     ; The patra child in slot 2 is the last one to be updated.
                            	  8225:     ; So all other patra children will see slot 2's state = 0, and return.
                            	  8226:     ;
                            	  8227:     ; This means that in the first frame, slot 2 is the only one to be
                            	  8228:     ; shown.
                            	  8229:     ;
02:0003BDA6 102C00AE        	  8230:     move.b  ($00AE,A4),D0
02:0003BDAA 6700008E        	  8231:     beq  _L_z04_UpdatePatraChild_Exit
                            	  8232:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	  8233:     ; here to wait to be shown at the top position (N) one at a time.
                            	  8234:     ;
02:0003BDAE 1002            	  8235:     move.b  D2,D0
                            	  8236:     ; Subtract 3 from the object slot to get the angle where the
                            	  8237:     ; patra child in object slot 2 should be for the current one to appear.
                            	  8238:     ;
02:0003BDB0 003C0011        	  8239:     ori     #$11,CCR  ; SEC: set C+X
02:0003BDB4 123C0003        	  8240:     move.b  #$03,D1
02:0003BDB8 0A3C0010        	  8241:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BDBC 9101            	  8242:     subx.b  D1,D0   ; SBC #$03
02:0003BDBE 0A3C0010        	  8243:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BDC2 7600            	  8244:     moveq   #0,D3
02:0003BDC4 1600            	  8245:     move.b  D0,D3
                            	  8246:     ; If the patra child in slot 2 has not reached the required angle,
                            	  8247:     ; then return.
                            	  8248:     ;
02:0003BDC6 102C0396        	  8249:     move.b  ($0396,A4),D0
02:0003BDCA 41F90003BD84    	  8250:     lea     (PatraChildStartAngles).l,A0
02:0003BDD0 12303000        	  8251:     move.b  (A0,D3.W),D1
02:0003BDD4 B001            	  8252:     cmp.b   D1,D0
02:0003BDD6 6662            	  8253:     bne  _L_z04_UpdatePatraChild_Exit
                            	  8254:     even
