                            	  5934: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  5935:     ; Store the weapon's frame (horizontal or vertical)
                            	  5936:     ; for the direction chosen above in [0C].
                            	  5937:     ;
02:0004901E 4EB900030982    	  5938:     jsr     GetOppositeDir
02:00049024 41F900048A58    	  5939:     lea     (RDirectionToWeaponFrame).l,A0
02:0004902A 10303000        	  5940:     move.b  (A0,D3.W),D0
02:0004902E 1940000C        	  5941:     move.b  D0,($000C,A4)
                            	  5942:     ; Calculate sprite attributes.
                            	  5943:     ;
                            	  5944:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  5945:     ;   base attribute OR 1
                            	  5946:     ; So, it uses palette row 5.
                            	  5947:     ;
02:00049032 41F900048A5C    	  5948:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:00049038 10303000        	  5949:     move.b  (A0,D3.W),D0
02:0004903C 0C02000D        	  5950:     cmpi.b  #$0D,D2
02:00049040 6706            	  5951:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:00049042 00000001        	  5952:     ori.b #$01,D0
02:00049046 601C            	  5953:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  5954: 
                            	  5955:     even
                            	  5956: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  5957:     ; The weapon is the sword.
                            	  5958:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  5959:     ;
02:00049048 023C00EE        	  5960:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004904C 122C0657        	  5961:     move.b  ($0657,A4),D1
02:00049050 D101            	  5962:     addx.b  D1,D0   ; ADC Items
02:00049052 003C0011        	  5963:     ori     #$11,CCR  ; SEC: set C+X
02:00049056 123C0001        	  5964:     move.b  #$01,D1
02:0004905A 0A3C0010        	  5965:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004905E 9101            	  5966:     subx.b  D1,D0   ; SBC #$01
02:00049060 0A3C0010        	  5967:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5968:     even
                            	  5969: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  5970:     ; Set sprite attributes to the calculated value above.
                            	  5971:     ;
02:00049064 4EB900031044    	  5972:     jsr     Anim_SetSpriteDescriptorAttributes
