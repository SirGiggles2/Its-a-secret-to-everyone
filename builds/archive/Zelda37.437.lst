02:000483D0 6604            	  4128:     bne.s  __far_z_07_0050
02:000483D2 6000008A        	  4129:     jmp  L1F148_Exit
                            	  4130: __far_z_07_0050:
                            	  4131:     ; Moving direction = 0.
                            	  4132:     ; The object is not the player.
