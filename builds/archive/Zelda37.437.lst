                            	  1776:     ; If facing down, then use Y offset $28.
                            	  1777:     ; Else store Y offset -$28 in [00].
                            	  1778:     ;
02:00038DEE 7628            	  1779:     moveq   #40,D3
02:00038DF0 41EC0098        	  1780:     lea     ($0098,A4),A0
02:00038DF4 10302000        	  1781:     move.b  (A0,D2.W),D0
02:00038DF8 02000008        	  1782:     andi.b #$08,D0
02:00038DFC 6704            	  1783:     beq  _anon_z04_44
02:00038DFE 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:00038E02 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
