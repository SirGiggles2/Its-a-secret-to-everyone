02:0003E6E8 7601            	  3224:     moveq   #1,D3
02:0003E6EA 102C0070        	  3225:     move.b  ($0070,A4),D0
02:0003E6EE 0C000050        	  3226:     cmpi.b  #$50,D0
02:0003E6F2 6712            	  3227:     beq  _anon_z05_83
02:0003E6F4 5203            	  3228:     addq.b  #1,D3
02:0003E6F6 0C000080        	  3229:     cmpi.b  #$80,D0
02:0003E6FA 670A            	  3230:     beq  _anon_z05_83
02:0003E6FC 5203            	  3231:     addq.b  #1,D3
02:0003E6FE 0C0000B0        	  3232:     cmpi.b  #$B0,D0
02:0003E702 6702            	  3233:     beq.s  __far_z_05_0062
