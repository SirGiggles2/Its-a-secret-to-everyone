02:0003EFA8 122C0007        	  4373:     move.b  ($0007,A4),D1
02:0003EFAC D101            	  4374:     addx.b  D1,D0   ; ADC $07
02:0003EFAE 7600            	  4375:     moveq   #0,D3
02:0003EFB0 1600            	  4376:     move.b  D0,D3
                            	  4377:     ; With that index, look up the index to use with the door face
                            	  4378:     ; list of tiles at [02:03].
                            	  4379:     ;
02:0003EFB2 41F9000401AA    	  4380:     lea     (HorizontalDoorFaceIndexes).l,A0
02:0003EFB8 10303000        	  4381:     move.b  (A0,D3.W),D0
02:0003EFBC 7600            	  4382:     moveq   #0,D3
02:0003EFBE 1600            	  4383:     move.b  D0,D3
                            	  4384:     ; Now we can read one of four tiles inside a door face tile map,
                            	  4385:     ; and copy it to the dynamic transfer buf.
                            	  4386:     ;
02:0003EFC0 122C0002        	  4387:     move.b  ($02,A4),D1   ; ptr lo
02:0003EFC4 182C0003        	  4388:     move.b  ($03,A4),D4  ; ptr hi
