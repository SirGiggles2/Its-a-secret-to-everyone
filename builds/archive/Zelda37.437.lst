                            	  4943: DrawCredits:
                            	  4944:     ; Make a transfer record of a full row of blank tiles.
                            	  4945:     ;
02:0003540C 761F            	  4946:     moveq   #31,D3
02:0003540E 7024            	  4947:     moveq   #36,D0
                            	  4948: _anon_z02_41:
02:00035410 41EC0305        	  4949:     lea     ($0305,A4),A0
02:00035414 11803000        	  4950:     move.b  D0,(A0,D3.W)
02:00035418 5303            	  4951:     subq.b  #1,D3
02:0003541A 6AF4            	  4952:     bpl  _anon_z02_41
                            	  4953:     ; No wall tiles go in row 0.
