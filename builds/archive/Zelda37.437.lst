02:0003C1D0 6100FF7E        	  8830:     jsr     Ganon_DrawCloud
02:0003C1D4 6100009A        	  8831:     jsr     Ganon_GetCurCloudBottom
02:0003C1D8 6100FF76        	  8832:     jsr     Ganon_DrawCloud
                            	  8833:     ; Draw the left and right clouds.
                            	  8834:     ;
