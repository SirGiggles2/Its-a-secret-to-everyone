02:0003C3C8 41EC00AC        	  9095:     lea     ($00AC,A4),A0
02:0003C3CC 10303000        	  9096:     move.b  (A0,D3.W),D0
02:0003C3D0 0C000010        	  9097:     cmpi.b  #$10,D0
02:0003C3D4 66DE            	  9098:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  9099:     ; Check for collision with an arrow; and return if no collision.
