02:0003C1E0 41EC0084        	  8836:     lea     ($0084,A4),A0
02:0003C1E4 10302000        	  8837:     move.b  (A0,D2.W),D0
02:0003C1E8 19400001        	  8838:     move.b  D0,($0001,A4)
02:0003C1EC 6100FF62        	  8839:     jsr     Ganon_DrawCloud
