                            	   521: UpdateBlock0Idle:
                            	   522:     ; If there are monsters in the room, go reset the push timer and return.
                            	   523:     ;
02:0003853C 102C034D        	   524:     move.b  ($034D,A4),D0
02:00038540 6604            	   525:     bne.s  __far_z_04_0000
02:00038542 600000CA        	   526:     jmp  ResetPushTimer
                            	   527: __far_z_04_0000:
                            	   528:     ; If Link's X is aligned with the block's, then get the difference
                            	   529:     ; between Link's (Y + 3) and the block's Y.
                            	   530:     ; Then go test the difference.
                            	   531:     ;
02:00038546 102C0070        	   532:     move.b  ($0070,A4),D0
02:0003854A 12342070        	   533:     move.b  ($70,A4,D2.W),D1
02:0003854E B001            	   534:     cmp.b   D1,D0
02:00038550 6628            	   535:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:00038552 7600            	   536:     moveq   #0,D3
02:00038554 102C0084        	   537:     move.b  ($0084,A4),D0
02:00038558 023C00EE        	   538:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003855C 123C0003        	   539:     move.b  #$03,D1
02:00038560 D101            	   540:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038562 003C0011        	   541:     ori     #$11,CCR  ; SEC: set C+X
02:00038566 41EC0084        	   542:     lea     ($0084,A4),A0
02:0003856A 12302000        	   543:     move.b  (A0,D2.W),D1
02:0003856E 0A3C0010        	   544:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038572 9101            	   545:     subx.b  D1,D0   ; SBC ObjY,X
02:00038574 0A3C0010        	   546:     eori    #$10,CCR  ; restore X = 6502 C
02:00038578 6034            	   547:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   548: 
                            	   549:     even
                            	   550: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   551:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   552:     ; go reset the push timer.
                            	   553:     ;
02:0003857A 102C0084        	   554:     move.b  ($0084,A4),D0
02:0003857E 023C00EE        	   555:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038582 123C0003        	   556:     move.b  #$03,D1
02:00038586 D101            	   557:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038588 41EC0084        	   558:     lea     ($0084,A4),A0
02:0003858C 12302000        	   559:     move.b  (A0,D2.W),D1
02:00038590 B001            	   560:     cmp.b   D1,D0
02:00038592 6702            	   561:     beq.s  __far_z_04_0001
02:00038594 6078            	   562:     jmp  ResetPushTimer
                            	   563: __far_z_04_0001:
                            	   564:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   565:     ; Get the difference in X.
                            	   566:     ;
02:00038596 7602            	   567:     moveq   #2,D3
02:00038598 102C0070        	   568:     move.b  ($0070,A4),D0
02:0003859C 003C0011        	   569:     ori     #$11,CCR  ; SEC: set C+X
02:000385A0 12342070        	   570:     move.b  ($70,A4,D2.W),D1
02:000385A4 0A3C0010        	   571:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000385A8 9101            	   572:     subx.b  D1,D0   ; SBC ObjX,X
02:000385AA 0A3C0010        	   573:     eori    #$10,CCR  ; restore X = 6502 C
                            	   574:     even
                            	   575: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   576:     ; If the difference in coordinates is negative, then Link is
                            	   577:     ; up or left of the block.
                            	   578:     ;
                            	   579:     ; In that case, increase Y register to index the correct opposite
                            	   580:     ; direction below. Also, negate the difference, so we test
                            	   581:     ; positive values.
                            	   582:     ;
02:000385AE 6A06            	   583:     bpl  _anon_z04_14
02:000385B0 5203            	   584:     addq.b  #1,D3
02:000385B2 610083D6        	   585:     jsr     Negate
                            	   586: _anon_z04_14:
                            	   587:     ; If the distance >= $11, then go reset the push timer and return.
                            	   588:     ;
02:000385B6 0C000011        	   589:     cmpi.b  #$11,D0
02:000385BA 6502            	   590:     bcs.s  __far_z_04_0002
02:000385BC 6050            	   591:     jmp  ResetPushTimer
                            	   592: __far_z_04_0002:
                            	   593:     ; At this point, Link is aligned with the block.
                            	   594:     ;
                            	   595:     ; If the input direction is not the required direction based on
                            	   596:     ; Link's placement; then go reset the push timer and return.
                            	   597:     ;
02:000385BE 102C03F8        	   598:     move.b  ($03F8,A4),D0
02:000385C2 41F900038526    	   599:     lea     (BlockPushDirections).l,A0
02:000385C8 12303000        	   600:     move.b  (A0,D3.W),D1
02:000385CC B001            	   601:     cmp.b   D1,D0
02:000385CE 6702            	   602:     beq.s  __far_z_04_0003
02:000385D0 603C            	   603:     jmp  ResetPushTimer
                            	   604: __far_z_04_0003:
                            	   605:     ; Link is truly pushing the block.
                            	   606:     ;
                            	   607:     ; Increase the push timer.
                            	   608:     ;
02:000385D2 41EC0412        	   609:     lea     ($0412,A4),A0
02:000385D6 52302000        	   610:     addq.b  #1,(A0,D2.W)
                            	   611:     ; If the push timer still < $10, return.
                            	   612:     ;
02:000385DA 7600            	   613:     moveq   #0,D3
02:000385DC 41EC0412        	   614:     lea     ($0412,A4),A0
02:000385E0 16302000        	   615:     move.b  (A0,D2.W),D3
02:000385E4 0C030010        	   616:     cmpi.b  #$10,D3
02:000385E8 6402            	   617:     bcc.s  __far_z_04_0004
02:000385EA 6028            	   618:     jmp  L10262_Exit
