02:0003DB0C 19400070        	  1607:     move.b  D0,($0070,A4)
02:0003DB10 41F900FF6AFE    	  1608:     lea     (NES_SRAM+$0AFE).l,A0
02:0003DB16 10303000        	  1609:     move.b  (A0,D3.W),D0
02:0003DB1A 02000007        	  1610:     andi.b #$07,D0
02:0003DB1E E308            	  1611:     lsl.b  #1,D0   ; ASL A
02:0003DB20 E308            	  1612:     lsl.b  #1,D0   ; ASL A
02:0003DB22 E308            	  1613:     lsl.b  #1,D0   ; ASL A
02:0003DB24 E308            	  1614:     lsl.b  #1,D0   ; ASL A
                            	  1615:     ; Add the first Y where Link can come out of underground.
                            	  1616:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
