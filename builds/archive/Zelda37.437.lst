                            	  4799: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003A398 7600            	  4800:     moveq   #0,D3
02:0003A39A 162C000B        	  4801:     move.b  ($000B,A4),D3
                            	  4802:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  4803:     ; Store it in [00].
                            	  4804:     ;
02:0003A39E 10342070        	  4805:     move.b  ($70,A4,D2.W),D0
02:0003A3A2 023C00EE        	  4806:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3A6 41F90003A37A    	  4807:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003A3AC 12303000        	  4808:     move.b  (A0,D3.W),D1
02:0003A3B0 D101            	  4809:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003A3B2 1880            	  4810:     move.b  D0,($0000,A4)
                            	  4811:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  4812:     ; Store it in [01].
                            	  4813:     ;
02:0003A3B4 41EC0084        	  4814:     lea     ($0084,A4),A0
02:0003A3B8 10302000        	  4815:     move.b  (A0,D2.W),D0
02:0003A3BC 023C00EE        	  4816:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A3C0 41F90003A374    	  4817:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003A3C6 12303000        	  4818:     move.b  (A0,D3.W),D1
02:0003A3CA D101            	  4819:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003A3CC 19400001        	  4820:     move.b  D0,($0001,A4)
                            	  4821:     ; Calculate sprite attributes:
                            	  4822:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  4823:     ;
                            	  4824:     ; If the boss is temporarily invincible, then
                            	  4825:     ; this makes it flash by cycling all the palette rows.
                            	  4826:     ;
                            	  4827:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  4828:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  4829:     ;
02:0003A3D0 41EC04F0        	  4830:     lea     ($04F0,A4),A0
02:0003A3D4 10302000        	  4831:     move.b  (A0,D2.W),D0
02:0003A3D8 02000003        	  4832:     andi.b #$03,D0
02:0003A3DC 0A000003        	  4833:     eori.b #$03,D0
02:0003A3E0 19400003        	  4834:     move.b  D0,($0003,A4)
02:0003A3E4 7600            	  4835:     moveq   #0,D3
02:0003A3E6 162C000A        	  4836:     move.b  ($000A,A4),D3
                            	  4837:     ; Look up the tile for this sprite.
                            	  4838:     ; If it's not the first one (face), then go write the sprite record.
                            	  4839:     ;
02:0003A3EA 41F90003A368    	  4840:     lea     (AquamentusTiles).l,A0
02:0003A3F0 10303000        	  4841:     move.b  (A0,D3.W),D0
02:0003A3F4 12390003A368    	  4842:     move.b  (AquamentusTiles).l,D1
02:0003A3FA B001            	  4843:     cmp.b   D1,D0
02:0003A3FC 6610            	  4844:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  4845:     ; Else it's the first one (the face tile).
                            	  4846:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  4847:     ;
                            	  4848:     ; $CC/CD shows the closed mouth face.
                            	  4849:     ; $C0/C1 shows the open mouth face.
                            	  4850:     ;
02:0003A3FE 7600            	  4851:     moveq   #0,D3
02:0003A400 16342028        	  4852:     move.b  ($28,A4,D2.W),D3
02:0003A404 0C030020        	  4853:     cmpi.b  #$20,D3
02:0003A408 6404            	  4854:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003A40A 103C00C0        	  4855:     move.b  #$C0,D0
