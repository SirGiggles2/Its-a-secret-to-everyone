02:00048860 41EC00AC        	  4830:     lea     ($00AC,A4),A0
02:00048864 10302000        	  4831:     move.b  (A0,D2.W),D0
02:00048868 E308            	  4832:     lsl.b  #1,D0   ; ASL A
