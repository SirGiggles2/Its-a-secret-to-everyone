02:00034DF6 41EC0302        	  4373:     lea     ($0302,A4),A0
02:00034DFA 11803000        	  4374:     move.b  D0,(A0,D3.W)
02:00034DFE 5303            	  4375:     subq.b  #1,D3
02:00034E00 6AEA            	  4376:     bpl  _anon_z02_31
                            	  4377: _anon_z02_32:
                            	  4378:     ; Replace the low byte of the VRAM address with the one
                            	  4379:     ; where the next character should be written.
                            	  4380:     ;
02:00034E02 102C045F        	  4381:     move.b  ($045F,A4),D0
02:00034E06 19400303        	  4382:     move.b  D0,($0303,A4)
                            	  4383:     ; Increment the low VRAM address for the next character.
                            	  4384:     ;
02:00034E0A 522C045F        	  4385:     addq.b  #1,($045F,A4)
02:00034E0E 7000            	  4386:     moveq   #0,D0
02:00034E10 1880            	  4387:     move.b  D0,($0000,A4)
02:00034E12 7000            	  4388:     moveq   #0,D0
02:00034E14 19400001        	  4389:     move.b  D0,($0001,A4)
                            	  4390:     ; Load the person text current character index.
                            	  4391:     ;
02:00034E18 7600            	  4392:     moveq   #0,D3
02:00034E1A 162C0416        	  4393:     move.b  ($0416,A4),D3
                            	  4394:     ; Increment the index variable to point to the next character
                            	  4395:     ; for the next time.
                            	  4396:     ;
02:00034E1E 522C0416        	  4397:     addq.b  #1,($0416,A4)
                            	  4398:     ; Get the current character.
                            	  4399:     ;
02:00034E22 1214            	  4400:     move.b  ($00,A4),D1   ; ptr lo
02:00034E24 182C0001        	  4401:     move.b  ($01,A4),D4  ; ptr hi
02:00034E28 024100FF        	  4402:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034E2C E14C            	  4403:     lsl.w   #8,D4
02:00034E2E 8841            	  4404:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034E30 48C4            	  4405:     ext.l   D4
02:00034E32 D8BC00FF0000    	  4406:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034E38 2044            	  4407:     movea.l D4,A0
02:00034E3A 10303000        	  4408:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4409:     ; If the character is $25, then it's a special space. It will still
                            	  4410:     ; take up space, but will not take time to show -- meaning that
                            	  4411:     ; we'll go look up the next character to transfer.
                            	  4412:     ;
02:00034E3E 0200003F        	  4413:     andi.b #$3F,D0
02:00034E42 0C000025        	  4414:     cmpi.b  #$25,D0
02:00034E46 67BA            	  4415:     beq  _anon_z02_32
                            	  4416:     ; We have a non-space character. Put it in the transfer record.
                            	  4417:     ;
02:00034E48 19400305        	  4418:     move.b  D0,($0305,A4)
                            	  4419:     ; Play the "heart taken/character" tune.
                            	  4420:     ;
02:00034E4C 7010            	  4421:     moveq   #16,D0
02:00034E4E 19400604        	  4422:     move.b  D0,($0604,A4)
                            	  4423:     ; If the high 2 bits of character element = 0, then return.
                            	  4424:     ;
02:00034E52 1214            	  4425:     move.b  ($00,A4),D1   ; ptr lo
02:00034E54 182C0001        	  4426:     move.b  ($01,A4),D4  ; ptr hi
02:00034E58 024100FF        	  4427:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034E5C E14C            	  4428:     lsl.w   #8,D4
02:00034E5E 8841            	  4429:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034E60 48C4            	  4430:     ext.l   D4
02:00034E62 D8BC00FF0000    	  4431:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034E68 2044            	  4432:     movea.l D4,A0
02:00034E6A 10303000        	  4433:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034E6E 020000C0        	  4434:     andi.b #$C0,D0
02:00034E72 6602            	  4435:     bne.s  __far_z_02_0006
02:00034E74 6032            	  4436:     jmp  LA9F4_Exit
                            	  4437: __far_z_02_0006:
                            	  4438:     ; Determine an index based on the high 2 bits of the character element:
                            	  4439:     ;   $80: 0
                            	  4440:     ;   $40: 1
                            	  4441:     ;   $C0: 2
                            	  4442:     ;
02:00034E76 7602            	  4443:     moveq   #2,D3
02:00034E78 0C0000C0        	  4444:     cmpi.b  #$C0,D0
02:00034E7C 670A            	  4445:     beq  _anon_z02_33
02:00034E7E 5303            	  4446:     subq.b  #1,D3
02:00034E80 0C000040        	  4447:     cmpi.b  #$40,D0
02:00034E84 6702            	  4448:     beq  _anon_z02_33
02:00034E86 5303            	  4449:     subq.b  #1,D3
                            	  4450: _anon_z02_33:
                            	  4451:     ; The index chooses the low VRAM address of the start
                            	  4452:     ; of another line:
                            	  4453:     ;   0: $C4: front of the second line
                            	  4454:     ;   1: $E4: front of the third line
                            	  4455:     ;   2: $A4: front of the first line
                            	  4456:     ;
02:00034E88 41F900034DD0    	  4457:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034E8E 10303000        	  4458:     move.b  (A0,D3.W),D0
02:00034E92 1940045F        	  4459:     move.b  D0,($045F,A4)
                            	  4460:     ; If index = 2, then we've reached the end of the text,
                            	  4461:     ; and low VRAM address is moved to the front of the first line.
                            	  4462:     ; So, advance the state of the person object, and unhalt Link.
                            	  4463:     ;
02:00034E96 0C030002        	  4464:     cmpi.b  #$02,D3
02:00034E9A 6702            	  4465:     beq.s  __far_z_02_0007
02:00034E9C 600A            	  4466:     jmp  LA9F4_Exit
                            	  4467: __far_z_02_0007:
02:00034E9E 522C00AD        	  4468:     addq.b  #1,($00AD,A4)
02:00034EA2 7000            	  4469:     moveq   #0,D0
02:00034EA4 194000AC        	  4470:     move.b  D0,($00AC,A4)
                            	  4471:     even
