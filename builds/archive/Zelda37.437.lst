02:00040420 0003FBFC        	  5893:     dc.l    ColumnHeapUW0
02:00040424 0003FC0C        	  5894:     dc.l    ColumnHeapUW1
02:00040428 0003FC2A        	  5895:     dc.l    ColumnHeapUW2
02:0004042C 0003FC3C        	  5896:     dc.l    ColumnHeapUW3
02:00040430 0003FC4E        	  5897:     dc.l    ColumnHeapUW4
02:00040434 0003FC66        	  5898:     dc.l    ColumnHeapUW5
02:00040438 0003FC7E        	  5899:     dc.l    ColumnHeapUW6
02:0004043C 0003FC90        	  5900:     dc.l    ColumnHeapUW7
02:00040440 0003FCA2        	  5901:     dc.l    ColumnHeapUW8
02:00040444 0003FCBC        	  5902:     dc.l    ColumnHeapUW9
