                            	  2001:     even
                            	  2002: RedLeever_AnimateAndCheckCollisions:
02:00038F9C 7600            	  2003:     moveq   #0,D3
02:00038F9E 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038FA2 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038FA6 41F900038D98    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038FAC 10303000        	  2007:     move.b  (A0,D3.W),D0
