02:0003B338 41EC0478        	  6849:     lea     ($0478,A4),A0
02:0003B33C 11802000        	  6850:     move.b  D0,(A0,D2.W)
                            	  6851:     ; If this segment is the base, then go draw.
                            	  6852:     ;
02:0003B340 0C020005        	  6853:     cmpi.b  #$05,D2
02:0003B344 6736            	  6854:     beq  _L_z04_UpdateManhandla_Draw
                            	  6855:     ; If the old and new "frame image and sprite attributes" variables
                            	  6856:     ; are the same, then go draw.
                            	  6857:     ;
                            	  6858:     ; The previous frame value begins with value 0, because all
                            	  6859:     ; room data was reset on entry.
                            	  6860:     ;
02:0003B346 41EC0478        	  6861:     lea     ($0478,A4),A0
02:0003B34A 10302000        	  6862:     move.b  (A0,D2.W),D0
02:0003B34E 41EC0437        	  6863:     lea     ($0437,A4),A0
02:0003B352 12302000        	  6864:     move.b  (A0,D2.W),D1
02:0003B356 B001            	  6865:     cmp.b   D1,D0
02:0003B358 6722            	  6866:     beq  _L_z04_UpdateManhandla_Draw
                            	  6867:     ; Copy the new value to the old variable, so that they're the same.
                            	  6868:     ;
02:0003B35A 41EC0437        	  6869:     lea     ($0437,A4),A0
02:0003B35E 11802000        	  6870:     move.b  D0,(A0,D2.W)
                            	  6871:     ; If animation frame = 1, then go draw.
                            	  6872:     ;
                            	  6873:     ; The low bit of "frame image and sprite attributes" byte
                            	  6874:     ; represents the animation frame.
                            	  6875:     ;
02:0003B362 E208            	  6876:     lsr.b  #1,D0   ; LSR A
02:0003B364 6516            	  6877:     bcs  _L_z04_UpdateManhandla_Draw
                            	  6878:     ; If the random value for the next slot up < $E0,
                            	  6879:     ; or there's an object in slot 7; then go draw.
