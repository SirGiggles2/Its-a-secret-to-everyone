                            	  4251:     ; Get the next direction to check, and set moving direction to it.
                            	  4252:     ; If not at the end of the loop, go test the new direction's walkability.
                            	  4253:     ;
02:00048A40 6100009C        	  4254:     jsr     Walker_GetNextAltDir
02:00048A44 1940000F        	  4255:     move.b  D0,($000F,A4)
02:00048A48 102C000E        	  4256:     move.b  ($000E,A4),D0
02:00048A4C 6702            	  4257:     beq.s  __far_z_07_0055
02:00048A4E 60C0            	  4258:     jmp  CheckTiles
