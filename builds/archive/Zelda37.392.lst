02:0003EF66 6620            	  3941:     bne  _anon_z05_96
02:0003EF68 102C0001        	  3942:     move.b  ($0001,A4),D0
02:0003EF6C 41F90003EEC4    	  3943:     lea     (DoorwayBoundsMinUnder).l,A0
02:0003EF72 12303000        	  3944:     move.b  (A0,D3.W),D1
02:0003EF76 B001            	  3945:     cmp.b   D1,D0
02:0003EF78 650E            	  3946:     bcs  _anon_z05_96
02:0003EF7A 41F90003EEC8    	  3947:     lea     (DoorwayBoundsMaxUnder).l,A0
02:0003EF80 12303000        	  3948:     move.b  (A0,D3.W),D1
02:0003EF84 B001            	  3949:     cmp.b   D1,D0
02:0003EF86 6506            	  3950:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3951: _anon_z05_96:
02:0003EF88 5303            	  3952:     subq.b  #1,D3
02:0003EF8A 6ACC            	  3953:     bpl  _L_z05_CheckDoorway_LoopUnderflowDoorway
