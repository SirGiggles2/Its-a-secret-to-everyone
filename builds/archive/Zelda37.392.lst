                            	  4974:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4975:     ; These will be negated appropriately for each corner.
                            	  4976:     ;
02:00048F1E 41EC0098        	  4977:     lea     ($0098,A4),A0
02:00048F22 10302000        	  4978:     move.b  (A0,D2.W),D0
02:00048F26 19400002        	  4979:     move.b  D0,($0002,A4)
02:00048F2A 19400003        	  4980:     move.b  D0,($0003,A4)
                            	  4981:     ; Reset [0F] to not flip horizontally.
                            	  4982:     ;
02:00048F2E 7000            	  4983:     moveq   #0,D0
02:00048F30 1940000F        	  4984:     move.b  D0,($000F,A4)
                            	  4985:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4986:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4987:     ;
02:00048F34 7603            	  4988:     moveq   #3,D3
                            	  4989:     even
                            	  4990: _L_z07_SpreadShot_DrawShotCorner:
02:00048F36 1003            	  4991:     move.b  D3,D0
02:00048F38 1B00            	  4992:     move.b  D0,-(A5)  ; PHA
                            	  4993:     ; Save offset X [02] and Y offset [03].
                            	  4994:     ;
02:00048F3A 102C0002        	  4995:     move.b  ($0002,A4),D0
02:00048F3E 1B00            	  4996:     move.b  D0,-(A5)  ; PHA
02:00048F40 102C0003        	  4997:     move.b  ($0003,A4),D0
02:00048F44 1B00            	  4998:     move.b  D0,-(A5)  ; PHA
                            	  4999:     ; Calculate and set sprite attributes for this corner:
                            	  5000:     ;   base attribute OR (frame counter AND 3)
                            	  5001:     ;
                            	  5002:     ; The base attribute defines how to flip the sprite.
                            	  5003:     ; The frame counter makes the shot flash by cycling each
                            	  5004:     ; palette row.
                            	  5005:     ;
02:00048F46 102C0015        	  5006:     move.b  ($0015,A4),D0
02:00048F4A 02000003        	  5007:     andi.b #$03,D0
02:00048F4E 41F900048DAC    	  5008:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048F54 12303000        	  5009:     move.b  (A0,D3.W),D1
02:00048F58 8001            	  5010:     or.b  D1,D0
02:00048F5A 4EB900030FB6    	  5011:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5012:     ; Add the object's X (the center of the spread) and the
                            	  5013:     ; current offset in [02] to set sprite X in [00].
                            	  5014:     ;
02:00048F60 10342070        	  5015:     move.b  ($70,A4,D2.W),D0
02:00048F64 023C00EE        	  5016:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048F68 122C0002        	  5017:     move.b  ($0002,A4),D1
02:00048F6C D101            	  5018:     addx.b  D1,D0   ; ADC $02
02:00048F6E 1880            	  5019:     move.b  D0,($0000,A4)
                            	  5020:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5021:     ; Else calculate the distance from object X to sprite X.
                            	  5022:     ;
02:00048F70 12342070        	  5023:     move.b  ($70,A4,D2.W),D1
02:00048F74 B001            	  5024:     cmp.b   D1,D0
02:00048F76 651A            	  5025:     bcs  _L_z07_SpreadShot_ReverseSub
02:00048F78 0C0000FC        	  5026:     cmpi.b  #$FC,D0
02:00048F7C 6466            	  5027:     bcc  _L_z07_SpreadShot_NextCorner
02:00048F7E 003C0011        	  5028:     ori     #$11,CCR  ; SEC: set C+X
02:00048F82 12342070        	  5029:     move.b  ($70,A4,D2.W),D1
02:00048F86 0A3C0010        	  5030:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048F8A 9101            	  5031:     subx.b  D1,D0   ; SBC ObjX,X
02:00048F8C 0A3C0010        	  5032:     eori    #$10,CCR  ; restore X = 6502 C
02:00048F90 6014            	  5033:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5034: 
                            	  5035:     even
                            	  5036: _L_z07_SpreadShot_ReverseSub:
02:00048F92 10342070        	  5037:     move.b  ($70,A4,D2.W),D0
02:00048F96 003C0011        	  5038:     ori     #$11,CCR  ; SEC: set C+X
02:00048F9A 1214            	  5039:     move.b  ($0000,A4),D1
02:00048F9C 0A3C0010        	  5040:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048FA0 9101            	  5041:     subx.b  D1,D0   ; SBC $00
02:00048FA2 0A3C0010        	  5042:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5043:     even
