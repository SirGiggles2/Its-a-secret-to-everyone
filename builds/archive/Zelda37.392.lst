                            	  7250:     ; If the "monsters from edges" long timer expired, then
                            	  7251:     ; go bring the monster in.
                            	  7252:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7253:     ;
                            	  7254:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7255:     ; residual position so enemies keep their previous-room
                            	  7256:     ; positions instead of being re-edge-spawned (matches NES).
02:0004A014 102C004B        	  7257:     move.b  ($004B,A4),D0
02:0004A018 662E            	  7258:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7259:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004A01A 102C000F        	  7260:     move.b  ($000F,A4),D0
02:0004A01E 0C0000FF        	  7261:     cmpi.b  #$FF,D0
02:0004A022 662E            	  7262:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004A024 41EC0070        	  7263:     lea     ($0070,A4),A0
