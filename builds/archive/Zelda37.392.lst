02:0003871E 11802000        	   861:     move.b  D0,(A0,D2.W)
02:00038722 10342070        	   862:     move.b  ($70,A4,D2.W),D0
02:00038726 023C00EE        	   863:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003872A 41F900038626    	   864:     lea     (ShotBounceWidths).l,A0
02:00038730 12303000        	   865:     move.b  (A0,D3.W),D1
