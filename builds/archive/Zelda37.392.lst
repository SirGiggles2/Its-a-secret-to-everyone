                            	  2493: SecretArmosXs:
02:0003928E E0              	  2494:     dc.b    $E0, $B0, $B0, $30, $40, $90, $A0
02:0003928F B0
02:00039290 B0
02:00039291 30
02:00039292 40
02:00039293 90
02:00039294 A0
                            	  2495: 
                            	  2496:     even
                            	  2497: InitArmosOrFlyingGhini:
                            	  2498:     ; In UpdateObject, this object was flagged "initialized".
                            	  2499:     ; But if it's still fading in (timer > 0), then flag it "uninitialized".
                            	  2500:     ;
02:00039296 10342028        	  2501:     move.b  ($28,A4,D2.W),D0
02:0003929A 41EC0492        	  2502:     lea     ($0492,A4),A0
02:0003929E 11802000        	  2503:     move.b  D0,(A0,D2.W)
                            	  2504:     ; If it's still fading in, then go finish some initialization needed
                            	  2505:     ; for fading in.
                            	  2506:     ;
02:000392A2 660000B6        	  2507:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2508:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  2509:     ; go finish initializing it.
                            	  2510:     ;
02:000392A6 41EC034F        	  2511:     lea     ($034F,A4),A0
02:000392AA 10302000        	  2512:     move.b  (A0,D2.W),D0
02:000392AE 0C000022        	  2513:     cmpi.b  #$22,D0
02:000392B2 670000A6        	  2514:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  2515:     ; Else we have an armos.
                            	  2516:     ;
                            	  2517:     ; Store stairs tile $70 in [00] for use later.
                            	  2518:     ;
02:000392B6 7070            	  2519:     moveq   #112,D0
02:000392B8 1880            	  2520:     move.b  D0,($0000,A4)
                            	  2521:     ; Look for the current room ID in an array of room ID's that
                            	  2522:     ; have armos secrets.
                            	  2523:     ;
02:000392BA 7606            	  2524:     moveq   #6,D3
                            	  2525:     even
                            	  2526: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:000392BC 102C00EB        	  2527:     move.b  ($00EB,A4),D0
                            	  2528:     ; If this element does not match the current room ID, go loop again.
                            	  2529:     ;
02:000392C0 41F900039286    	  2530:     lea     (SecretArmosRoomIds).l,A0
02:000392C6 12303000        	  2531:     move.b  (A0,D3.W),D1
02:000392CA B001            	  2532:     cmp.b   D1,D0
02:000392CC 6648            	  2533:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2534:     ; The secret (usually stairs) is under one of the armoses.
                            	  2535:     ;
                            	  2536:     ; If the armos's X coordinate does not match the one needed
                            	  2537:     ; for the current room in the list, then go loop again.
                            	  2538:     ;
02:000392CE 10342070        	  2539:     move.b  ($70,A4,D2.W),D0
02:000392D2 41F90003928E    	  2540:     lea     (SecretArmosXs).l,A0
02:000392D8 12303000        	  2541:     move.b  (A0,D3.W),D1
02:000392DC B001            	  2542:     cmp.b   D1,D0
02:000392DE 6636            	  2543:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2544:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  2545:     ;
02:000392E0 41EC0084        	  2546:     lea     ($0084,A4),A0
02:000392E4 10302000        	  2547:     move.b  (A0,D2.W),D0
02:000392E8 0C000080        	  2548:     cmpi.b  #$80,D0
02:000392EC 6628            	  2549:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  2550:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  2551:     ;
02:000392EE 4A03            	  2552:     cmpi.b  #$00,D3
02:000392F0 662C            	  2553:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  2554:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  2555:     ; has the power bracelet.
                            	  2556:     ;
                            	  2557:     ; Set up the room item with the armos's coordinates.
                            	  2558:     ;
02:000392F2 19400097        	  2559:     move.b  D0,($0097,A4)
02:000392F6 10342070        	  2560:     move.b  ($70,A4,D2.W),D0
02:000392FA 19400083        	  2561:     move.b  D0,($0083,A4)
                            	  2562:     ; This resets the room item's state, which activates it.
                            	  2563:     ;
02:000392FE 194300BF        	  2564:     move.b  D3,($00BF,A4)
                            	  2565:     ; Set the room item ID.
                            	  2566:     ;
02:00039302 7014            	  2567:     moveq   #20,D0
02:00039304 194000AB        	  2568:     move.b  D0,($00AB,A4)
                            	  2569:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  2570:     ;
                            	  2571:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  2572:     ;
                            	  2573:     ; Note that, if the item was already taken, then the room item
                            	  2574:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  2575:     ; it will be ignored, because that routine checks whether
                            	  2576:     ; the item was taken.
                            	  2577:     ;
02:00039308 4EB9000309FC    	  2578:     jsr     GetRoomFlagUWItemState
