02:0003C15E 162C045F        	  8810:     move.b  ($045F,A4),D3
                            	  8811:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  8812:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  8813:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  8814:     ;
02:0003C162 41EC034F        	  8815:     lea     ($034F,A4),A0
02:0003C166 10302000        	  8816:     move.b  (A0,D2.W),D0
02:0003C16A 0C000025        	  8817:     cmpi.b  #$25,D0
02:0003C16E 661E            	  8818:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003C170 41F90003C062    	  8819:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003C176 10303000        	  8820:     move.b  (A0,D3.W),D0
02:0003C17A 1B00            	  8821:     move.b  D0,-(A5)  ; PHA
02:0003C17C 41F90003C066    	  8822:     lea     (PatraChild1RotationSineBits).l,A0
02:0003C182 10303000        	  8823:     move.b  (A0,D3.W),D0
02:0003C186 7600            	  8824:     moveq   #0,D3
02:0003C188 1600            	  8825:     move.b  D0,D3
02:0003C18A 101D            	  8826:     move.b  (A5)+,D0  ; PLA
02:0003C18C 600E            	  8827:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  8828: 
                            	  8829:     even
                            	  8830: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  8831:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  8832:     ; for both Y and X increment calculations in rotation. This leads to
                            	  8833:     ; a small circle (5) and a large circle (6).
                            	  8834:     ;
02:0003C18E 41F90003C064    	  8835:     lea     (PatraChild2RotationBits).l,A0
02:0003C194 10303000        	  8836:     move.b  (A0,D3.W),D0
02:0003C198 7600            	  8837:     moveq   #0,D3
02:0003C19A 1600            	  8838:     move.b  D0,D3
