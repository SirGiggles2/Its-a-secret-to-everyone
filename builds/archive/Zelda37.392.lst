                            	  5585:     ;
02:0004933E 6100F5BA        	  5586:     jsr     MoveObject
                            	  5587:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5588:     ; state to $40.
                            	  5589:     ;
02:00049342 41EC0380        	  5590:     lea     ($0380,A4),A0
02:00049346 53302000        	  5591:     subq.b  #1,(A0,D2.W)
02:0004934A 6614            	  5592:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5593:     even
                            	  5594: _L_z07_CheckState30_SetState40:
                            	  5595:     ; Set state $40, and a time to move of $20 frames.
                            	  5596:     ;
                            	  5597:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5598:     ;
                            	  5599:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5600:     ;
02:0004934C 7020            	  5601:     moveq   #32,D0
02:0004934E 41EC0380        	  5602:     lea     ($0380,A4),A0
02:00049352 11802000        	  5603:     move.b  D0,(A0,D2.W)
02:00049356 7040            	  5604:     moveq   #64,D0
02:00049358 41EC00AC        	  5605:     lea     ($00AC,A4),A0
02:0004935C 11802000        	  5606:     move.b  D0,(A0,D2.W)
                            	  5607:     even
