                            	  1895: Burrower_AnimateDrawAndCheckCollisions:
02:00038E40 4EB900049C10    	  1896:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  1897:     ; If state = 0, return.
                            	  1898:     ;
