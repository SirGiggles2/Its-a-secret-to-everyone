                            	  4346: ThanksTextboxLineAddrsLo:
02:00034D42 C4              	  4347:     dc.b    $C4, $E4, $A4
02:00034D43 E4
02:00034D44 A4
                            	  4348: 
                            	  4349: ; Returns:
                            	  4350: ; ObjState[1]: 0 if still updating
                            	  4351: ;
                            	  4352:     even
                            	  4353: UpdateZeldaTextbox:
02:00034D46 4EB900048B58    	  4354:     jsr     Link_EndMoveAndDraw
                            	  4355:     ; If Zelda's timer has not expired, then return.
                            	  4356:     ;
02:00034D4C 102C0029        	  4357:     move.b  ($0029,A4),D0
02:00034D50 6704            	  4358:     beq.s  __far_z_02_0005
02:00034D52 600000C6        	  4359:     jmp  LA9F4_Exit
                            	  4360: __far_z_02_0005:
                            	  4361:     ; Set the timer to wait 6 frames after the next character about
                            	  4362:     ; to be shown.
                            	  4363:     ;
02:00034D56 7006            	  4364:     moveq   #6,D0
02:00034D58 19400029        	  4365:     move.b  D0,($0029,A4)
                            	  4366:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4367:     ; to the dynamic transfer buf.
                            	  4368:     ;
02:00034D5C 7604            	  4369:     moveq   #4,D3
                            	  4370: _anon_z02_31:
02:00034D5E 41F900034D3C    	  4371:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034D64 10303000        	  4372:     move.b  (A0,D3.W),D0
02:00034D68 41EC0302        	  4373:     lea     ($0302,A4),A0
02:00034D6C 11803000        	  4374:     move.b  D0,(A0,D3.W)
02:00034D70 5303            	  4375:     subq.b  #1,D3
02:00034D72 6AEA            	  4376:     bpl  _anon_z02_31
                            	  4377: _anon_z02_32:
                            	  4378:     ; Replace the low byte of the VRAM address with the one
                            	  4379:     ; where the next character should be written.
                            	  4380:     ;
02:00034D74 102C045F        	  4381:     move.b  ($045F,A4),D0
02:00034D78 19400303        	  4382:     move.b  D0,($0303,A4)
                            	  4383:     ; Increment the low VRAM address for the next character.
                            	  4384:     ;
02:00034D7C 522C045F        	  4385:     addq.b  #1,($045F,A4)
02:00034D80 7000            	  4386:     moveq   #0,D0
02:00034D82 1880            	  4387:     move.b  D0,($0000,A4)
02:00034D84 7000            	  4388:     moveq   #0,D0
02:00034D86 19400001        	  4389:     move.b  D0,($0001,A4)
                            	  4390:     ; Load the person text current character index.
                            	  4391:     ;
02:00034D8A 7600            	  4392:     moveq   #0,D3
02:00034D8C 162C0416        	  4393:     move.b  ($0416,A4),D3
                            	  4394:     ; Increment the index variable to point to the next character
                            	  4395:     ; for the next time.
                            	  4396:     ;
02:00034D90 522C0416        	  4397:     addq.b  #1,($0416,A4)
                            	  4398:     ; Get the current character.
                            	  4399:     ;
02:00034D94 1214            	  4400:     move.b  ($00,A4),D1   ; ptr lo
02:00034D96 182C0001        	  4401:     move.b  ($01,A4),D4  ; ptr hi
02:00034D9A 024100FF        	  4402:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034D9E E14C            	  4403:     lsl.w   #8,D4
02:00034DA0 8841            	  4404:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034DA2 48C4            	  4405:     ext.l   D4
02:00034DA4 D8BC00FF0000    	  4406:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034DAA 2044            	  4407:     movea.l D4,A0
02:00034DAC 10303000        	  4408:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4409:     ; If the character is $25, then it's a special space. It will still
                            	  4410:     ; take up space, but will not take time to show -- meaning that
                            	  4411:     ; we'll go look up the next character to transfer.
                            	  4412:     ;
02:00034DB0 0200003F        	  4413:     andi.b #$3F,D0
02:00034DB4 0C000025        	  4414:     cmpi.b  #$25,D0
02:00034DB8 67BA            	  4415:     beq  _anon_z02_32
                            	  4416:     ; We have a non-space character. Put it in the transfer record.
                            	  4417:     ;
02:00034DBA 19400305        	  4418:     move.b  D0,($0305,A4)
                            	  4419:     ; Play the "heart taken/character" tune.
                            	  4420:     ;
02:00034DBE 7010            	  4421:     moveq   #16,D0
02:00034DC0 19400604        	  4422:     move.b  D0,($0604,A4)
                            	  4423:     ; If the high 2 bits of character element = 0, then return.
                            	  4424:     ;
02:00034DC4 1214            	  4425:     move.b  ($00,A4),D1   ; ptr lo
02:00034DC6 182C0001        	  4426:     move.b  ($01,A4),D4  ; ptr hi
02:00034DCA 024100FF        	  4427:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034DCE E14C            	  4428:     lsl.w   #8,D4
02:00034DD0 8841            	  4429:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034DD2 48C4            	  4430:     ext.l   D4
02:00034DD4 D8BC00FF0000    	  4431:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034DDA 2044            	  4432:     movea.l D4,A0
02:00034DDC 10303000        	  4433:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034DE0 020000C0        	  4434:     andi.b #$C0,D0
02:00034DE4 6602            	  4435:     bne.s  __far_z_02_0006
02:00034DE6 6032            	  4436:     jmp  LA9F4_Exit
                            	  4437: __far_z_02_0006:
                            	  4438:     ; Determine an index based on the high 2 bits of the character element:
                            	  4439:     ;   $80: 0
                            	  4440:     ;   $40: 1
                            	  4441:     ;   $C0: 2
                            	  4442:     ;
02:00034DE8 7602            	  4443:     moveq   #2,D3
02:00034DEA 0C0000C0        	  4444:     cmpi.b  #$C0,D0
02:00034DEE 670A            	  4445:     beq  _anon_z02_33
02:00034DF0 5303            	  4446:     subq.b  #1,D3
02:00034DF2 0C000040        	  4447:     cmpi.b  #$40,D0
02:00034DF6 6702            	  4448:     beq  _anon_z02_33
02:00034DF8 5303            	  4449:     subq.b  #1,D3
                            	  4450: _anon_z02_33:
                            	  4451:     ; The index chooses the low VRAM address of the start
                            	  4452:     ; of another line:
                            	  4453:     ;   0: $C4: front of the second line
                            	  4454:     ;   1: $E4: front of the third line
                            	  4455:     ;   2: $A4: front of the first line
                            	  4456:     ;
02:00034DFA 41F900034D42    	  4457:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034E00 10303000        	  4458:     move.b  (A0,D3.W),D0
02:00034E04 1940045F        	  4459:     move.b  D0,($045F,A4)
                            	  4460:     ; If index = 2, then we've reached the end of the text,
                            	  4461:     ; and low VRAM address is moved to the front of the first line.
                            	  4462:     ; So, advance the state of the person object, and unhalt Link.
                            	  4463:     ;
02:00034E08 0C030002        	  4464:     cmpi.b  #$02,D3
02:00034E0C 6702            	  4465:     beq.s  __far_z_02_0007
02:00034E0E 600A            	  4466:     jmp  LA9F4_Exit
                            	  4467: __far_z_02_0007:
02:00034E10 522C00AD        	  4468:     addq.b  #1,($00AD,A4)
02:00034E14 7000            	  4469:     moveq   #0,D0
02:00034E16 194000AC        	  4470:     move.b  D0,($00AC,A4)
                            	  4471:     even
                            	  4472: LA9F4_Exit:
02:00034E1A 4E75            	  4473:     rts
                            	  4474: 
