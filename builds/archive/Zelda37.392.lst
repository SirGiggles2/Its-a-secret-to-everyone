                            	  1818: UpdateBurrower:
                            	  1819:     ; If object timer <> 0, then go animate, draw, and check for collisions.
                            	  1820:     ;
02:00038DA8 10342028        	  1821:     move.b  ($28,A4,D2.W),D0
02:00038DAC 667E            	  1822:     bne  _L_z04_UpdateBurrower_Animate
                            	  1823:     ; If not zora or state <> 1, go cycle the state.
                            	  1824:     ;
02:00038DAE 41EC034F        	  1825:     lea     ($034F,A4),A0
02:00038DB2 10302000        	  1826:     move.b  (A0,D2.W),D0
02:00038DB6 0C000011        	  1827:     cmpi.b  #$11,D0
02:00038DBA 662A            	  1828:     bne  _L_z04_UpdateBurrower_CycleState
02:00038DBC 7600            	  1829:     moveq   #0,D3
02:00038DBE 41EC00AC        	  1830:     lea     ($00AC,A4),A0
02:00038DC2 16302000        	  1831:     move.b  (A0,D2.W),D3
02:00038DC6 5303            	  1832:     subq.b  #1,D3
02:00038DC8 661C            	  1833:     bne  _L_z04_UpdateBurrower_CycleState
                            	  1834:     ; Else is zora and state = 1.
