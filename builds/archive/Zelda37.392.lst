02:00038E36 41F900038D92    	  1885:     lea     (BlueLeeverStateAnimTimes).l,A0
02:00038E3C 10303000        	  1886:     move.b  (A0,D3.W),D0
                            	  1887: ; Params:
                            	  1888: ; A: new value for animation counter, in case it rolls over
                            	  1889: ; X: object index
                            	  1890: ;
                            	  1891: ; Note:
                            	  1892: ; Advances the animation counter first.
                            	  1893: ;
