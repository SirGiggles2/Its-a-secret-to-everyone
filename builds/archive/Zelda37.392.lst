                            	  4203: CheckTiles:
                            	  4204:     ifne TURBO_LINK
                            	  4205:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4206:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:00048A10 4A02            	  4207:     tst.b   D2
02:00048A12 6608            	  4208:     bne.s   _L_z07_CheckTiles_notLink
02:00048A14 197C0024049E    	  4209:     move.b  #$24,($049E,A4)
02:00048A1A 605E            	  4210:     jmp     GoWalkableDir
                            	  4211: _L_z07_CheckTiles_notLink:
                            	  4212:     endc
                            	  4213:     ; The code below applies to Link and other objects.
                            	  4214:     ;
                            	  4215:     ; Test the moving direction's walkability.
                            	  4216:     ;
                            	  4217:     ; For the player, this is enough. For other objects, this 
                            	  4218:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4219:     ;
                            	  4220:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4221:     ;
02:00048A1C 6100FB88        	  4222:     jsr     GetCollidingTileMoving
02:00048A20 122C034A        	  4223:     move.b  ($034A,A4),D1
02:00048A24 B001            	  4224:     cmp.b   D1,D0
02:00048A26 6402            	  4225:     bcc.s  __far_z_07_0052
02:00048A28 6050            	  4226:     jmp  GoWalkableDir
                            	  4227: __far_z_07_0052:
                            	  4228:     ; The colliding tile is unwalkable.
                            	  4229:     ;
                            	  4230:     ; If object is the player, then go check passive tile objects and
                            	  4231:     ; the screen edge, or stop moving.
                            	  4232:     ;
02:00048A2A 4A02            	  4233:     cmpi.b  #$00,D2
02:00048A2C 6602            	  4234:     bne.s  __far_z_07_0053
02:00048A2E 6022            	  4235:     jmp  PlayerUnwalkable
                            	  4236: __far_z_07_0053:
                            	  4237:     even
                            	  4238: CheckObjAttr10AndAltDir:
                            	  4239:     ; Not the player.
                            	  4240:     ; If object attribute has $10, go to the unused code above
                            	  4241:     ; to reverse direction.
                            	  4242:     ;
02:00048A30 41EC04BF        	  4243:     lea     ($04BF,A4),A0
02:00048A34 10302000        	  4244:     move.b  (A0,D2.W),D0
02:00048A38 02000010        	  4245:     andi.b #$10,D0
02:00048A3C 6702            	  4246:     beq.s  __far_z_07_0054
02:00048A3E 60C8            	  4247:     jmp  Reverse
                            	  4248: __far_z_07_0054:
                            	  4249:     even
