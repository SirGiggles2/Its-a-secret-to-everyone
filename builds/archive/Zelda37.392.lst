                            	  3487: Obj_Shove:
                            	  3488:     ; If this is not the first call to this routine for this instance of shoving (high bit is clear),
                            	  3489:     ; then go handle it separately.
                            	  3490:     ;
02:000485BA 41EC00C0        	  3491:     lea     ($00C0,A4),A0
02:000485BE 10302000        	  3492:     move.b  (A0,D2.W),D0
02:000485C2 E308            	  3493:     lsl.b  #1,D0   ; ASL A
02:000485C4 6448            	  3494:     bcc  _L_z07_Obj_Shove_MoveIfNotDone
                            	  3495:     ; Clear the high bit, so we don't repeat this initialization.
                            	  3496:     ;
02:000485C6 E208            	  3497:     lsr.b  #1,D0   ; LSR A
02:000485C8 41EC00C0        	  3498:     lea     ($00C0,A4),A0
02:000485CC 11802000        	  3499:     move.b  D0,(A0,D2.W)
                            	  3500:     ; If the object faces horizontally, go check which axis shove
                            	  3501:     ; direction is on.
                            	  3502:     ;
02:000485D0 7600            	  3503:     moveq   #0,D3
02:000485D2 41EC0098        	  3504:     lea     ($0098,A4),A0
02:000485D6 16302000        	  3505:     move.b  (A0,D2.W),D3
02:000485DA 0C030003        	  3506:     cmpi.b  #$03,D3
02:000485DE 6526            	  3507:     bcs  _L_z07_Obj_Shove_FacingHorizontally
                            	  3508:     ; The object faces vertically.
                            	  3509:     ;
                            	  3510:     ; If the shove direction is vertical, return. We're OK to shove.
                            	  3511:     ;
02:000485E0 02000003        	  3512:     andi.b #$03,D0
02:000485E4 671E            	  3513:     beq  _L_z07_Obj_Shove_Exit
                            	  3514:     even
                            	  3515: _L_z07_Obj_Shove_CheckPerpendicularShove:
                            	  3516:     ; Allow a perpendicular shove, if grid offset = 0.
                            	  3517:     ;
02:000485E6 41EC0394        	  3518:     lea     ($0394,A4),A0
02:000485EA 10302000        	  3519:     move.b  (A0,D2.W),D0
02:000485EE 6714            	  3520:     beq  _L_z07_Obj_Shove_Exit
                            	  3521:     ; Else change the shove direction.
                            	  3522:     ;
                            	  3523:     ; If the object is not Link, then reset it.
                            	  3524:     ;
02:000485F0 4A02            	  3525:     cmpi.b  #$00,D2
02:000485F2 6702            	  3526:     beq.s  __far_z_07_0039
02:000485F4 6024            	  3527:     jmp  ResetShoveInfo
