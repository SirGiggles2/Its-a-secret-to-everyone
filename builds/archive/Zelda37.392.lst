02:000420F6 003C0011        	  8666:     ori     #$11,CCR  ; SEC: set C+X
02:000420FA 123C0001        	  8667:     move.b  #$01,D1
02:000420FE 0A3C0010        	  8668:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00042102 9101            	  8669:     subx.b  D1,D0   ; SBC #$01
02:00042104 0A3C0010        	  8670:     eori    #$10,CCR  ; restore X = 6502 C
02:00042108 0C000008        	  8671:     cmpi.b  #$08,D0
02:0004210C 6504            	  8672:     bcs  _anon_z05_203
02:0004210E 5202            	  8673:     addq.b  #1,D2
02:00042110 5202            	  8674:     addq.b  #1,D2
                            	  8675: _anon_z05_203:
