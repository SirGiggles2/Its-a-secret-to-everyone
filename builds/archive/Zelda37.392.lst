02:00048FD8 1940000C        	  5073:     move.b  D0,($000C,A4)
02:00048FDC 7623            	  5074:     moveq   #35,D3
02:00048FDE 4EB900030ED6    	  5075:     jsr     Anim_WriteItemSprites
