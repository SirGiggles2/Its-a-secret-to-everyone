02:00039DDE 102C0486        	  4096:     move.b  ($0486,A4),D0
02:00039DE2 41EC0486        	  4097:     lea     ($0486,A4),A0
02:00039DE6 11803000        	  4098:     move.b  D0,(A0,D3.W)
                            	  4099:     ; Start with flying speed $80, and in flying state 2.
                            	  4100:     ;
02:00039DEA 103C0080        	  4101:     move.b  #$80,D0
02:00039DEE 41EC0420        	  4102:     lea     ($0420,A4),A0
02:00039DF2 11803000        	  4103:     move.b  D0,(A0,D3.W)
02:00039DF6 7002            	  4104:     moveq   #2,D0
02:00039DF8 41EC0445        	  4105:     lea     ($0445,A4),A0
02:00039DFC 11803000        	  4106:     move.b  D0,(A0,D3.W)
02:00039E00 7041            	  4107:     moveq   #65,D0
02:00039E02 41EC0350        	  4108:     lea     ($0350,A4),A0
02:00039E06 11803000        	  4109:     move.b  D0,(A0,D3.W)
                            	  4110:     ; Bottom of the loop.
                            	  4111:     ;
02:00039E0A 5303            	  4112:     subq.b  #1,D3
02:00039E0C 6A90            	  4113:     bpl  _anon_z04_77
                            	  4114:     ; Choose a random 8-way direction for the head segments
                            	  4115:     ; in slots 4 and 9.
