                            	  8861: DrawSubmenuItems:
                            	  8862:     ; Look for a magic boomerang, then a wooden boomerang.
                            	  8863:     ; If you find one, then draw it.
                            	  8864:     ;
02:0004226C 741E            	  8865:     moveq   #30,D2
                            	  8866: _anon_z05_208:
02:0004226E 41EC0657        	  8867:     lea     ($0657,A4),A0
