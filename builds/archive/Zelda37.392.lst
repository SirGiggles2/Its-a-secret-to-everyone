02:0003CC46 1214            	 10395:     move.b  ($0000,A4),D1
02:0003CC48 8001            	 10396:     or.b  D1,D0
02:0003CC4A 1880            	 10397:     move.b  D0,($0000,A4)
                            	 10398:     even
