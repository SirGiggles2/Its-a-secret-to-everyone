                            	  5314: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003A6C6 610E            	  5315:     jsr     WriteBossSprite
                            	  5316:     ; Bottom of the loop.
                            	  5317:     ; Decrement tile index and loop index.
                            	  5318:     ;
02:0003A6C8 532C000A        	  5319:     subq.b  #1,($000A,A4)
02:0003A6CC 532C000B        	  5320:     subq.b  #1,($000B,A4)
02:0003A6D0 6A00FF7E        	  5321:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003A6D4 4E75            	  5322:     rts
