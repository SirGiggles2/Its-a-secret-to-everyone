02:00031200 5202            	   127:     addq.b  #1,D2
                            	   128:     ; (32-bit Genesis ROM addr already in [$04:$07])
02:00031202 41F9000311AE    	   129:     lea     (CommonPatternBlockSizes).l,A0
02:00031208 10302000        	   130:     move.b  (A0,D2.W),D0
02:0003120C 19400003        	   131:     move.b  D0,($0003,A4)
02:00031210 41F9000311B4    	   132:     lea     (CommonPatternVramAddrs).l,A0
02:00031216 10302000        	   133:     move.b  (A0,D2.W),D0
02:0003121A 611C            	   134:     jsr     TransferPatternBlock_Bank2
                            	   135:     ; Loop until pattern block index = 3.
