02:000492F0 1940000F        	  5542:     move.b  D0,($000F,A4)
                            	  5543:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5544:     ; and go draw.
                            	  5545:     ;
02:000492F4 41EC0098        	  5546:     lea     ($0098,A4),A0
