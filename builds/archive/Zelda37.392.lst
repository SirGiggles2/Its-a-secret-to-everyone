02:0003B6F6 003C0011        	  7463:     ori     #$11,CCR  ; SEC: set C+X
02:0003B6FA 123C0010        	  7464:     move.b  #$10,D1
02:0003B6FE 0A3C0010        	  7465:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B702 9101            	  7466:     subx.b  D1,D0   ; SBC #$10
