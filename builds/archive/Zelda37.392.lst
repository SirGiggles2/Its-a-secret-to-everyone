02:0003916E 41EC0098        	  2311:     lea     ($0098,A4),A0
02:00039172 10302000        	  2312:     move.b  (A0,D2.W),D0
02:00039176 7600            	  2313:     moveq   #0,D3
02:00039178 1600            	  2314:     move.b  D0,D3
02:0003917A 0200000C        	  2315:     andi.b #$0C,D0
02:0003917E 670C            	  2316:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00039180 7002            	  2317:     moveq   #2,D0
