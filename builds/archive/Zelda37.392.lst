                            	  4905: __far_z_07_0073:
                            	  4906:     ; Try to activate a fire object. Temporarily mark the candle
                            	  4907:     ; unused, so it only has to depend on having an empty slot.
                            	  4908:     ;
                            	  4909:     ; If successful, Link's state will have been changed to "using item".
                            	  4910:     ; But we don't want that in this case.
                            	  4911:     ;
                            	  4912:     ; For both these reasons, save state and restore it afterward.
                            	  4913:     ;
02:00048EA0 102C00AC        	  4914:     move.b  ($00AC,A4),D0
02:00048EA4 1B00            	  4915:     move.b  D0,-(A5)  ; PHA
02:00048EA6 102C0513        	  4916:     move.b  ($0513,A4),D0
02:00048EAA 1B00            	  4917:     move.b  D0,-(A5)  ; PHA
02:00048EAC 7000            	  4918:     moveq   #0,D0
02:00048EAE 19400513        	  4919:     move.b  D0,($0513,A4)
02:00048EB2 4EB90003094E    	  4920:     jsr     WieldCandle
02:00048EB8 101D            	  4921:     move.b  (A5)+,D0  ; PLA
02:00048EBA 19400513        	  4922:     move.b  D0,($0513,A4)
02:00048EBE 101D            	  4923:     move.b  (A5)+,D0  ; PLA
02:00048EC0 194000AC        	  4924:     move.b  D0,($00AC,A4)
                            	  4925:     ; State $21 means that a moving fire was just made.
                            	  4926:     ;
                            	  4927:     ; If it's any another value, then we didn't find an empty slot
                            	  4928:     ; to make a fire. In this case, all that's left to do is to go
                            	  4929:     ; deactivate the shot object.
                            	  4930:     ;
02:00048EC4 41EC00AC        	  4931:     lea     ($00AC,A4),A0
02:00048EC8 10302000        	  4932:     move.b  (A0,D2.W),D0
02:00048ECC 0C000021        	  4933:     cmpi.b  #$21,D0
02:00048ED0 6702            	  4934:     beq.s  __far_z_07_0074
02:00048ED2 6038            	  4935:     jmp  DeactivateLinkShot
                            	  4936: __far_z_07_0074:
