02:00048926 654C            	  4034:     bcs  _L_z07_MoveObject_Right
02:00048928 E208            	  4035:     lsr.b  #1,D0   ; LSR A
02:0004892A 655E            	  4036:     bcs  _L_z07_MoveObject_Left
