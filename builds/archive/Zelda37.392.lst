02:00048A56 660C            	  4271:     bne  _L_z07_PlayerUnwalkable_StopMoving
02:00048A58 7001            	  4272:     moveq   #1,D0
02:00048A5A 61001B0E        	  4273:     jsr     SwitchBank
02:00048A5E 4EB9000307B6    	  4274:     jsr     CheckPassiveTileObjects
                            	  4275:     even
