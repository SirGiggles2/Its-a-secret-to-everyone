02:0003511A 123C0000        	  4826:     move.b  #$00,D1
02:0003511E D101            	  4827:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00035120 194000FC        	  4828:     move.b  D0,($00FC,A4)
