02:000422AC 7410            	  8898:     moveq   #16,D2
                            	  8899: _anon_z05_209:
                            	  8900:     ; If at the map item slot, check this level's map.
                            	  8901:     ;
02:000422AE 0C020011        	  8902:     cmpi.b  #$11,D2
02:000422B2 6606            	  8903:     bne  _anon_z05_210
02:000422B4 6100FE38        	  8904:     jsr     HasMap
02:000422B8 7411            	  8905:     moveq   #17,D2
                            	  8906: _anon_z05_210:
                            	  8907:     ; If there are none of this item, then go advance the index and loop again.
                            	  8908:     ;
02:000422BA 4A00            	  8909:     cmpi.b  #$00,D0
02:000422BC 675C            	  8910:     beq  _L_z05_DrawSubmenuItems_NextLoopDrawItem
                            	  8911:     ; If at the letter item slot, look at what's in the potion slot.
                            	  8912:     ; If there is a potion, then go advance the index and loop again.
                            	  8913:     ; That's because we already prepared sprites for the potion.
                            	  8914:     ;
02:000422BE 0C02000F        	  8915:     cmpi.b  #$0F,D2
02:000422C2 6606            	  8916:     bne  _anon_z05_211
02:000422C4 102C065E        	  8917:     move.b  ($065E,A4),D0
02:000422C8 6650            	  8918:     bne  _L_z05_DrawSubmenuItems_NextLoopDrawItem
                            	  8919: _anon_z05_211:
02:000422CA 1002            	  8920:     move.b  D2,D0
02:000422CC 1B00            	  8921:     move.b  D0,-(A5)  ; PHA
02:000422CE 7600            	  8922:     moveq   #0,D3
02:000422D0 1600            	  8923:     move.b  D0,D3
                            	  8924:     ; Look up and set the X coordinate of this item.
                            	  8925:     ;
02:000422D2 41F90004225C    	  8926:     lea     (SubmenuItemXs).l,A0
02:000422D8 10302000        	  8927:     move.b  (A0,D2.W),D0
02:000422DC 1880            	  8928:     move.b  D0,($0000,A4)
                            	  8929:     ; If the item goes in the first selectable row (item slot < 5),
                            	  8930:     ; then go set Y coordinate to $36 and draw.
                            	  8931:     ;
02:000422DE 7036            	  8932:     moveq   #54,D0
02:000422E0 0C020005        	  8933:     cmpi.b  #$05,D2
02:000422E4 6526            	  8934:     bcs  _L_z05_DrawSubmenuItems_Draw
                            	  8935:     ; If the item goes in the second selectable row (item slot < 9 or = $F),
                            	  8936:     ; then go set Y coordinate to $46 and draw.
                            	  8937:     ;
02:000422E6 7046            	  8938:     moveq   #70,D0
02:000422E8 0C02000F        	  8939:     cmpi.b  #$0F,D2
02:000422EC 671E            	  8940:     beq  _L_z05_DrawSubmenuItems_Draw
