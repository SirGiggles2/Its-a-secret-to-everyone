02:00048FC4 162C0010        	  5061:     move.b  ($0010,A4),D3
02:00048FC8 670C            	  5062:     beq  _L_z07_SpreadShot_Draw
02:00048FCA 0C00003E        	  5063:     cmpi.b  #$3E,D0
02:00048FCE 6514            	  5064:     bcs  _L_z07_SpreadShot_NextCorner
02:00048FD0 0C0000E8        	  5065:     cmpi.b  #$E8,D0
02:00048FD4 640E            	  5066:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5067:     even
                            	  5068: _L_z07_SpreadShot_Draw:
                            	  5069:     ; Draw the corner.
                            	  5070:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5071:     ;
