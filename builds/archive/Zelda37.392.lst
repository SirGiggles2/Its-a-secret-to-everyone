02:00042276 660A            	  8869:     bne  _L_z05_DrawSubmenuItems_FoundBoomerang
02:00042278 5302            	  8870:     subq.b  #1,D2
02:0004227A 0C02001C        	  8871:     cmpi.b  #$1C,D2
02:0004227E 66EE            	  8872:     bne  _anon_z05_208
02:00042280 6716            	  8873:     beq  _L_z05_DrawSubmenuItems_DrawOtherItems
                            	  8874:     even
