                            	  4691: ;==============================================================================
                            	  4692: ; BATCH 87 — Common Wanderer / Goriya family helper (IMPORT shim)
                            	  4693: ;==============================================================================
                            	  4694: 
                            	  4695:     xref    _ShootIfWanted
                            	  4696: 
                            	  4697: ; ShootIfWanted(type, slot)
                            	  4698: ;   D0 = shot type (low byte), D2 = monster slot.
                            	  4699: ;   On success returns D0 = 0x100 | shot_slot, on failure returns D0 = 0.
                            	  4700: ;   Used by enrt_walker_set_input_dir_and_try_shooting_boomerang.
                            	  4701: c_shoot_if_wanted:
02:0002CEE8 2F02            	  4702:     move.l  D2,-(SP)
02:0002CEEA 202F0008        	  4703:     move.l  8(SP),D0        ; arg1 = type (after D2 push: SP+8)
02:0002CEEE 242F000C        	  4704:     move.l  12(SP),D2       ; arg2 = slot
02:0002CEF2 4EB90003C9BA    	  4705:     jsr     _ShootIfWanted
02:0002CEF8 640C            	  4706:     bcc.s   .csiw_fail
02:0002CEFA 7000            	  4707:     moveq   #0,D0
02:0002CEFC 1003            	  4708:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CEFE 008000000100    	  4709:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CF04 6002            	  4710:     bra.s   .csiw_done
                            	  4711: .csiw_fail:
02:0002CF06 7000            	  4712:     moveq   #0,D0
                            	  4713: .csiw_done:
02:0002CF08 241F            	  4714:     move.l  (SP)+,D2
02:0002CF0A 4E75            	  4715:     rts
