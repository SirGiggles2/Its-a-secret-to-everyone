02:00038656 0C000055        	   754:     cmpi.b  #$55,D0
02:0003865A 6416            	   755:     bcc  _L_z04_UpdateMonsterShot_CheckBoundary
                            	   756:     ; Additionally, if the flying rock is held back by a timer, then
                            	   757:     ; only check for collision with Link.
                            	   758:     ;
02:0003865C 10342028        	   759:     move.b  ($28,A4,D2.W),D0
02:00038660 661E            	   760:     bne  _L_z04_UpdateMonsterShot_CheckLinkCollision
                            	   761:     ; If the flying rock hit a tile or room boundary, then go destroy it.
