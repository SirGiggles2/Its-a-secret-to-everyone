                            	  5441: __far_z_07_0081:
                            	  5442:     ; State $2x. Spark.
                            	  5443:     ;
                            	  5444:     ; Change the state to $28, and decrement animation counter.
                            	  5445:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5446:     ; (with Link, if this is a monster's boomerang).
                            	  5447:     ;
                            	  5448:     ; TODO: Why state $28?
                            	  5449:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5450:     ; start over again when spinning.
                            	  5451:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5452:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5453:     ; any drawing code depends on the minor state.
                            	  5454:     ;
02:00049254 7028            	  5455:     moveq   #40,D0
02:00049256 41EC00AC        	  5456:     lea     ($00AC,A4),A0
02:0004925A 11802000        	  5457:     move.b  D0,(A0,D2.W)
02:0004925E 41EC03D0        	  5458:     lea     ($03D0,A4),A0
02:00049262 53302000        	  5459:     subq.b  #1,(A0,D2.W)
02:00049266 6702            	  5460:     beq.s  __far_z_07_0082
02:00049268 6060            	  5461:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5462: __far_z_07_0082:
                            	  5463:     ; Animation counter = 0.
                            	  5464:     ;
                            	  5465:     ; Set state to $40. It will become $50 below in
                            	  5466:     ; HandleArrowOrBoomerangBlocked.
                            	  5467:     ;
02:0004926A 7040            	  5468:     moveq   #64,D0
02:0004926C 41EC00AC        	  5469:     lea     ($00AC,A4),A0
02:00049270 11802000        	  5470:     move.b  D0,(A0,D2.W)
                            	  5471:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5472:     ; Else go handle the boomerang being blocked.
                            	  5473:     ;
02:00049274 0C02000D        	  5474:     cmpi.b  #$0D,D2
02:00049278 640E            	  5475:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004927A 41EC034F        	  5476:     lea     ($034F,A4),A0
02:0004927E 10302000        	  5477:     move.b  (A0,D2.W),D0
02:00049282 0C00005B        	  5478:     cmpi.b  #$5B,D0
