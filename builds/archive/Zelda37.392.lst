02:00032F54 666C            	  1480:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1481:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1482:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1483:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032F56 7000            	  1484:     moveq   #0,D0
02:00032F58 102C0437        	  1485:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032F5C EB48            	  1486:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032F5E 41F900032D40    	  1487:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032F64 D0C0            	  1488:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1489:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032F66 197C003F0302    	  1490:     move.b  #$3F,($0302,A4)
02:00032F6C 197C00000303    	  1491:     move.b  #$00,($0303,A4)
02:00032F72 7020            	  1492:     moveq   #32,D0
02:00032F74 19400304        	  1493:     move.b  D0,($0304,A4)
                            	  1494:     ; End marker at DynTileBuf+4+31
02:00032F78 761F            	  1495:     moveq   #31,D3
02:00032F7A 103C00FF        	  1496:     move.b  #$FF,D0
02:00032F7E 43EC0306        	  1497:     lea     ($0306,A4),A1
02:00032F82 13803000        	  1498:     move.b  D0,(A1,D3.W)
