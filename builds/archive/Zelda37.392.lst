02:0004034F A0              	  5164:     dc.b    $A0   ; >DoorFaceTilesW (NES=$A02A)
02:00040350 A0              	  5165:     dc.b    $A0   ; >DoorFaceTilesS (NES=$A066)
02:00040351 A0              	  5166:     dc.b    $A0   ; >DoorFaceTilesN (NES=$A0A2)
                            	  5167: 
