02:000485F6 102C0098        	  3531:     move.b  ($0098,A4),D0
02:000485FA 4EB9000308F4    	  3532:     jsr     GetOppositeDir
02:00048600 194000C0        	  3533:     move.b  D0,($00C0,A4)
                            	  3534:     even
