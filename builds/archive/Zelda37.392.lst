                            	  4139:     ; randomly and set timer to $10.
                            	  4140:     ;
02:00039E4A 7001            	  4141:     moveq   #1,D0
02:00039E4C 19400431        	  4142:     move.b  D0,($0431,A4)
02:00039E50 19400436        	  4143:     move.b  D0,($0436,A4)
02:00039E54 103C0080        	  4144:     move.b  #$80,D0
02:00039E58 194004D1        	  4145:     move.b  D0,($04D1,A4)
02:00039E5C 7008            	  4146:     moveq   #8,D0
02:00039E5E 1940034E        	  4147:     move.b  D0,($034E,A4)
