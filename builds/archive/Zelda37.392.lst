02:0003B60E 41EC0478        	  7314:     lea     ($0478,A4),A0
02:0003B612 11802000        	  7315:     move.b  D0,(A0,D2.W)
                            	  7316:     ; If this segment is the base, then go draw.
                            	  7317:     ;
02:0003B616 0C020005        	  7318:     cmpi.b  #$05,D2
02:0003B61A 6736            	  7319:     beq  _L_z04_UpdateManhandla_Draw
                            	  7320:     ; If the old and new "frame image and sprite attributes" variables
                            	  7321:     ; are the same, then go draw.
                            	  7322:     ;
                            	  7323:     ; The previous frame value begins with value 0, because all
                            	  7324:     ; room data was reset on entry.
                            	  7325:     ;
02:0003B61C 41EC0478        	  7326:     lea     ($0478,A4),A0
02:0003B620 10302000        	  7327:     move.b  (A0,D2.W),D0
02:0003B624 41EC0437        	  7328:     lea     ($0437,A4),A0
02:0003B628 12302000        	  7329:     move.b  (A0,D2.W),D1
02:0003B62C B001            	  7330:     cmp.b   D1,D0
02:0003B62E 6722            	  7331:     beq  _L_z04_UpdateManhandla_Draw
                            	  7332:     ; Copy the new value to the old variable, so that they're the same.
                            	  7333:     ;
02:0003B630 41EC0437        	  7334:     lea     ($0437,A4),A0
02:0003B634 11802000        	  7335:     move.b  D0,(A0,D2.W)
                            	  7336:     ; If animation frame = 1, then go draw.
                            	  7337:     ;
                            	  7338:     ; The low bit of "frame image and sprite attributes" byte
                            	  7339:     ; represents the animation frame.
                            	  7340:     ;
02:0003B638 E208            	  7341:     lsr.b  #1,D0   ; LSR A
02:0003B63A 6516            	  7342:     bcs  _L_z04_UpdateManhandla_Draw
                            	  7343:     ; If the random value for the next slot up < $E0,
                            	  7344:     ; or there's an object in slot 7; then go draw.
