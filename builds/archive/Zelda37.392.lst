                            	  2489: SecretArmosRoomIds:
02:00039286 24              	  2490:     dc.b    $24, $0B, $1C, $22, $34, $3D, $4E
02:00039287 0B
02:00039288 1C
02:00039289 22
02:0003928A 34
02:0003928B 3D
02:0003928C 4E
                            	  2491: 
