02:00039030 1940004D        	  2155:     move.b  D0,($004D,A4)
02:00039034 6100008C        	  2156:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  2157:     ; The leever has to face Link in order to move toward him.
