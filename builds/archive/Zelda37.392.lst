02:00038A3C E308            	  1291:     lsl.b  #1,D0   ; ASL A
02:00038A3E E308            	  1292:     lsl.b  #1,D0   ; ASL A
02:00038A40 E308            	  1293:     lsl.b  #1,D0   ; ASL A
02:00038A42 E308            	  1294:     lsl.b  #1,D0   ; ASL A
02:00038A44 0C000050        	  1295:     cmpi.b  #$50,D0
02:00038A48 6530            	  1296:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038A4A 0C0000E0        	  1297:     cmpi.b  #$E0,D0
02:00038A4E 642A            	  1298:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  1299:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
