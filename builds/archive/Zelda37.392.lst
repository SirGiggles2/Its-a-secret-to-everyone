02:0003121C 102C051D        	   137:     move.b  ($051D,A4),D0
02:00031220 0C000003        	   138:     cmpi.b  #$03,D0
02:00031224 66A0            	   139:     bne  _L_z02_TransferCommonPatterns_LoopBlock
