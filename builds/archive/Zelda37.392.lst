                            	  1223:     ;==========================================================================
                            	  1224:     ; .chr_convert_upload — convert 16-byte NES 2BPP tile to 32-byte Genesis
                            	  1225:     ;                        4BPP and write to VDP VRAM.
                            	  1226:     ;
                            	  1227:     ; Input: CHR_TILE_BUF holds the 16 tile bytes.
                            	  1228:     ;        CHR_BUF_VADDR holds the NES CHR base address (× 16-aligned).
                            	  1229:     ;
                            	  1230:     ; Genesis VRAM tile address = CHR_BUF_VADDR × 2 (tiles are 32 bytes each).
                            	  1231:     ;
                            	  1232:     ; For each of 8 rows:
                            	  1233:     ;   plane0_row = CHR_TILE_BUF[row]       (bit 0 of each of 8 pixels)
                            	  1234:     ;   plane1_row = CHR_TILE_BUF[row+8]     (bit 1 of each of 8 pixels)
                            	  1235:     ;
                            	  1236:     ; Pixel color = (plane1_bit << 1) | plane0_bit  →  4-bit Genesis nibble
                            	  1237:     ;
                            	  1238:     ; Output format per row (4 Genesis bytes = 2 VDP words):
                            	  1239:     ;   byte 0: pixels 0,1  (high nibble = pixel 0, low nibble = pixel 1)
                            	  1240:     ;   byte 1: pixels 2,3
                            	  1241:     ;   byte 2: pixels 4,5
                            	  1242:     ;   byte 3: pixels 6,7
                            	  1243:     ;
                            	  1244:     ; expand_nibble(n) helper: scatters 4-bit value n to positions 12,8,4,0
                            	  1245:     ; of a 16-bit word (one bit per nibble).  Then OR-ing plane0 expansion
                            	  1246:     ; with (plane1 expansion << 1) gives the correct Genesis word.
                            	  1247:     ;
                            	  1248:     ; Uses D0–D5/A0 (all caller-saved at _ppu_write_7 entry).
                            	  1249:     ;==========================================================================
                            	  1250: _chr_convert_upload:
                            	  1251:     ; Set VDP write address: Genesis tile addr = NES CHR addr × 2
02:0000E6FA 323900FF0832    	  1252:     move.w  (CHR_BUF_VADDR).l,D1
02:0000E700 D241            	  1253:     add.w   D1,D1                   ; D1.w = NES_addr × 2  (lsl #1)
                            	  1254:     ; VDP VRAM write command for D1.w (< $4000, so upper word = 0):
                            	  1255:     ; Use moveq+move.w to guarantee D2 upper = 0 before swap.
                            	  1256:     ; (plain move.l D1,D2 would propagate garbage from D1 upper 16 bits
                            	  1257:     ;  into the CD/address bits of the VDP command after swap.)
02:0000E702 7400            	  1258:     moveq   #0,D2
02:0000E704 3401            	  1259:     move.w  D1,D2                   ; D2.w = NES_addr × 2  (D2 upper guaranteed 0)
02:0000E706 4842            	  1260:     swap    D2                      ; D2 = (NES_addr × 2) << 16
02:0000E708 008240000000    	  1261:     ori.l   #$40000000,D2           ; VDP VRAM-write command
02:0000E70E 23C200C00004    	  1262:     move.l  D2,(VDP_CTRL).l
                            	  1263: 
02:0000E714 41F900FF0820    	  1264:     lea     (CHR_TILE_BUF).l,A0     ; A0 → plane-0 row bytes (0..7)
02:0000E71A 43F90000E778    	  1265:     lea     (.expand_nibble_lut).l,A1 ; A1 → LUT (kept across all rows)
02:0000E720 7A07            	  1266:     moveq   #7,D5                   ; 8 rows, counter 7..0
                            	  1267: 
                            	  1268: .ccu_row:
02:0000E722 1610            	  1269:     move.b  0(A0),D3                ; D3.b = plane 0 for this row
02:0000E724 18280008        	  1270:     move.b  8(A0),D4                ; D4.b = plane 1 for this row
02:0000E728 5288            	  1271:     addq.l  #1,A0                   ; advance to next plane-0 row byte
                            	  1272: 
                            	  1273:     ; ---- Pixels 0-3 (upper nibbles of D3 and D4) ----
02:0000E72A 1203            	  1274:     move.b  D3,D1
02:0000E72C E809            	  1275:     lsr.b   #4,D1                   ; D1.b = upper nibble of plane0 (pix 0-3)
02:0000E72E 0201000F        	  1276:     andi.b  #$0F,D1
02:0000E732 6138            	  1277:     bsr     .expand_nibble          ; D2.w = plane0 expansion (bit0 of each nibble)
02:0000E734 3C02            	  1278:     move.w  D2,D6                   ; save plane0 expansion in D6 (D0 clobbered by expand)
                            	  1279: 
02:0000E736 1204            	  1280:     move.b  D4,D1
02:0000E738 E809            	  1281:     lsr.b   #4,D1                   ; D1.b = upper nibble of plane1 (pix 0-3)
02:0000E73A 0201000F        	  1282:     andi.b  #$0F,D1
02:0000E73E 612C            	  1283:     bsr     .expand_nibble          ; D2.w = plane1 expansion
02:0000E740 E34A            	  1284:     lsl.w   #1,D2                   ; ×2 → puts plane1 bits in bit1 of each nibble
02:0000E742 8446            	  1285:     or.w    D6,D2                   ; combine: each nibble = (p1_bit<<1)|p0_bit
02:0000E744 33C200C00000    	  1286:     move.w  D2,(VDP_DATA).l         ; write pixels 0-3 (2 VDP bytes via auto-incr)
                            	  1287: 
                            	  1288:     ; ---- Pixels 4-7 (lower nibbles of D3 and D4) ----
02:0000E74A 1203            	  1289:     move.b  D3,D1
02:0000E74C 0201000F        	  1290:     andi.b  #$0F,D1                 ; D1.b = lower nibble of plane0 (pix 4-7)
02:0000E750 611A            	  1291:     bsr     .expand_nibble
02:0000E752 3C02            	  1292:     move.w  D2,D6                   ; save plane0 expansion in D6
                            	  1293: 
02:0000E754 1204            	  1294:     move.b  D4,D1
02:0000E756 0201000F        	  1295:     andi.b  #$0F,D1                 ; D1.b = lower nibble of plane1 (pix 4-7)
02:0000E75A 6110            	  1296:     bsr     .expand_nibble
02:0000E75C E34A            	  1297:     lsl.w   #1,D2                   ; ×2 for plane1
02:0000E75E 8446            	  1298:     or.w    D6,D2
02:0000E760 33C200C00000    	  1299:     move.w  D2,(VDP_DATA).l         ; write pixels 4-7
                            	  1300: 
02:0000E766 5305            	  1301:     subq.b  #1,D5
02:0000E768 6CB8            	  1302:     bge.s   .ccu_row                ; loop for all 8 rows
02:0000E76A 4E75            	  1303:     rts
                            	  1304: 
                            	  1305:     ;==========================================================================
                            	  1306:     ; .expand_nibble — scatter 4-bit nibble to bit-0 of each output nibble.
                            	  1307:     ;
                            	  1308:     ; Input:  D1.b = 4-bit value n (bits 3..0 = pixels 0..3 of one plane)
                            	  1309:     ; Output: D2.w = bit3→pos12, bit2→pos8, bit1→pos4, bit0→pos0
                            	  1310:     ;
                            	  1311:     ; Uses lookup table for speed: 2 instructions instead of ~24.
                            	  1312:     ;==========================================================================
                            	  1313: .expand_nibble:
02:0000E76C 0241000F        	  1314:     andi.w  #$000F,D1               ; mask to 4 bits, zero-extend
02:0000E770 D241            	  1315:     add.w   D1,D1                   ; word offset into table
02:0000E772 34311000        	  1316:     move.w  (A1,D1.W),D2            ; D2.w = expanded nibble (A1 = LUT base)
02:0000E776 4E75            	  1317:     rts
                            	  1318: 
                            	  1319:     ;==========================================================================
                            	  1320:     ; 16-entry lookup table: nibble → scattered bits.
                            	  1321:     ;   Entry n: bit3→bit12, bit2→bit8, bit1→bit4, bit0→bit0
                            	  1322:     ;   e.g. $F (1111) → $1111, $A (1010) → $1010, $5 (0101) → $0101
                            	  1323:     ;==========================================================================
                            	  1324:     even
                            	  1325: .expand_nibble_lut:
02:0000E778 0000            	  1326:     dc.w    $0000   ; 0000
02:0000E77A 0001            	  1327:     dc.w    $0001   ; 0001
02:0000E77C 0010            	  1328:     dc.w    $0010   ; 0010
02:0000E77E 0011            	  1329:     dc.w    $0011   ; 0011
02:0000E780 0100            	  1330:     dc.w    $0100   ; 0100
02:0000E782 0101            	  1331:     dc.w    $0101   ; 0101
02:0000E784 0110            	  1332:     dc.w    $0110   ; 0110
02:0000E786 0111            	  1333:     dc.w    $0111   ; 0111
02:0000E788 1000            	  1334:     dc.w    $1000   ; 1000
02:0000E78A 1001            	  1335:     dc.w    $1001   ; 1001
02:0000E78C 1010            	  1336:     dc.w    $1010   ; 1010
02:0000E78E 1011            	  1337:     dc.w    $1011   ; 1011
02:0000E790 1100            	  1338:     dc.w    $1100   ; 1100
02:0000E792 1101            	  1339:     dc.w    $1101   ; 1101
02:0000E794 1110            	  1340:     dc.w    $1110   ; 1110
02:0000E796 1111            	  1341:     dc.w    $1111   ; 1111
                            	  1342: 
02:0000E798 4E75            	  1343:     rts
                            	  1344: 
                            	  1345:     ifne CHR_EXPANSION_ENABLED
                            	  1346: ;==============================================================================
                            	  1347: ; _chr_upload_sprite_4x — upload one NES sprite CHR tile to 4 Gen VRAM copies
                            	  1348: ;                         with pre-biased pixel values.
                            	  1349: ;
                            	  1350: ; Input:  CHR_TILE_BUF     = 16 NES 2bpp tile bytes
                            	  1351: ;         CHR_BUF_VADDR    = NES CHR address (16-aligned)
                            	  1352: ;
                            	  1353: ; Output: lower-half sprite CHR populates the normal sprite-copy banks.
                            	  1354: ;         upper-half CHR during NES 8x16 mode populates only the safe banks
                            	  1355: ;         used by the nonzero sprite sub-palettes, so BG pattern-table 1 tiles
                            	  1356: ;         are not clobbered.
                            	  1357: ;
                            	  1358: ; Pixel 0 (transparent) is preserved across all 4 copies — bias is only
                            	  1359: ; applied to nonzero pixels via a nibble mask.
                            	  1360: ;
                            	  1361: ; Bias mechanism (mask-based, no per-copy LUTs):
                            	  1362: ;   1. expand plane0 and plane1 via existing 16-entry .expand_nibble_lut
                            	  1363: ;   2. nonzero_mask = plane0_exp | plane1_exp  ($0 or $1 per nibble)
                            	  1364: ;   3. bias_word_per_copy:  $0000, $4444, $8888, $CCCC
                            	  1365: ;   4. mask_F = mask | mask<<1 | mask<<2 | mask<<3 ($0 or $F per nibble)
                            	  1366: ;   5. bias_add = mask_F & bias_word  ($0 or bias per nonzero nibble)
                            	  1367: ;   6. final = orig_pixels | bias_add  (no nibble overflow: orig <= 3, bias <= 12)
                            	  1368: ;
                            	  1369: ; Clobbers D0-D7, A0-A2.
                            	  1370: ;==============================================================================
                            	  1371: _chr_upload_sprite_4x:
02:0000E79A 48E7FFE0        	  1372:     movem.l D0-D7/A0-A2,-(SP)           ; save everything (helper clobbers D0-D7, A0-A2)
02:0000E79E 303900FF0832    	  1373:     move.w  (CHR_BUF_VADDR).l,D0
02:0000E7A4 0800000C        	  1374:     btst    #12,D0
02:0000E7A8 6714            	  1375:     beq.s   .csfx_use_lo_tbl
02:0000E7AA 0839000500FF0804	  1376:     btst    #5,(PPU_CTRL).l
02:0000E7B2 670A            	  1377:     beq.s   .csfx_use_lo_tbl
02:0000E7B4 45F90000E8CC    	  1378:     lea     (.csfx_hi_copy_base_tbl).l,A2
02:0000E7BA 7A01            	  1379:     moveq   #1,D5                       ; upper-half 8x16 support: banks B/C only
02:0000E7BC 6008            	  1380:     bra.s   .csfx_copy_loop
                            	  1381: .csfx_use_lo_tbl:
02:0000E7BE 45F90000E8AC    	  1382:     lea     (.csfx_copy_base_tbl).l,A2
02:0000E7C4 7A03            	  1383:     moveq   #3,D5                       ; 4 copies, counter 3..0
                            	  1384: .csfx_copy_loop:
                            	  1385:     ; Recompute tile offset each iteration because .csfx_row (below) clobbers
                            	  1386:     ; D3/D4 with plane0/plane1 row bytes. Previously this lived before the
                            	  1387:     ; loop and caused copies 1-3 to land at misaligned VRAM addresses.
02:0000E7C6 363900FF0832    	  1388:     move.w  (CHR_BUF_VADDR).l,D3
02:0000E7CC D643            	  1389:     add.w   D3,D3                       ; D3.w = gen tile offset (NES_addr * 2)
02:0000E7CE 02830000FFFF    	  1390:     andi.l  #$0000FFFF,D3               ; zero-extend for safe .l math
02:0000E7D4 281A            	  1391:     move.l  (A2)+,D4                    ; D4.l = copy base VRAM addr
02:0000E7D6 D883            	  1392:     add.l   D3,D4                       ; D4.l = tile VRAM addr for this copy
02:0000E7D8 2E1A            	  1393:     move.l  (A2)+,D7                    ; D7.l = bias word (low 16 bits used)
                            	  1394:     ; Build VDP VRAM write command in D2.l:
                            	  1395:     ;   cmd = $40000000 | ((addr & $3FFF) << 16) | ((addr >> 14) & $0003)
02:0000E7DA 2004            	  1396:     move.l  D4,D0
02:0000E7DC 028000003FFF    	  1397:     andi.l  #$00003FFF,D0
02:0000E7E2 4840            	  1398:     swap    D0
02:0000E7E4 008040000000    	  1399:     ori.l   #$40000000,D0
02:0000E7EA 2404            	  1400:     move.l  D4,D2
02:0000E7EC E08A            	  1401:     lsr.l   #8,D2
02:0000E7EE EC8A            	  1402:     lsr.l   #6,D2
02:0000E7F0 028200000003    	  1403:     andi.l  #$00000003,D2
02:0000E7F6 8082            	  1404:     or.l    D2,D0
02:0000E7F8 23C000C00004    	  1405:     move.l  D0,(VDP_CTRL).l
                            	  1406: 
02:0000E7FE 41F900FF0820    	  1407:     lea     (CHR_TILE_BUF).l,A0
02:0000E804 43F90000E88C    	  1408:     lea     (.csfx_expand_lut).l,A1
02:0000E80A 7007            	  1409:     move.l  #7,D0
                            	  1410:     ; Using D0 as row counter conflicts with expand_nibble which clobbers D0/D1/D2.
                            	  1411:     ; Save row counter on stack per iteration.
                            	  1412: .csfx_row:
02:0000E80C 2F00            	  1413:     move.l  D0,-(SP)                    ; save row counter
02:0000E80E 1610            	  1414:     move.b  0(A0),D3                    ; D3.b = plane0 row
02:0000E810 18280008        	  1415:     move.b  8(A0),D4                    ; D4.b = plane1 row
02:0000E814 5288            	  1416:     addq.l  #1,A0
                            	  1417: 
                            	  1418:     ; ---- Pixels 0-3 (upper nibbles) ----
02:0000E816 1203            	  1419:     move.b  D3,D1
02:0000E818 E809            	  1420:     lsr.b   #4,D1
02:0000E81A 0201000F        	  1421:     andi.b  #$0F,D1
02:0000E81E 6160            	  1422:     bsr     .csfx_expand                ; D2.w = plane0 expand
02:0000E820 3C02            	  1423:     move.w  D2,D6                       ; D6 = plane0 expand
02:0000E822 1204            	  1424:     move.b  D4,D1
02:0000E824 E809            	  1425:     lsr.b   #4,D1
02:0000E826 0201000F        	  1426:     andi.b  #$0F,D1
02:0000E82A 6154            	  1427:     bsr     .csfx_expand              ; D2.w = plane1 expand
02:0000E82C 3002            	  1428:     move.w  D2,D0                       ; D0.w = plane1 expand
02:0000E82E 8046            	  1429:     or.w    D6,D0                       ; D0.w = nonzero mask ($0/$1 per nibble)
02:0000E830 E34A            	  1430:     lsl.w   #1,D2
02:0000E832 8446            	  1431:     or.w    D6,D2                       ; D2.w = raw pixel nibbles
02:0000E834 6138            	  1432:     bsr     .csfx_apply_bias            ; merges bias using D0(mask), D7(bias)
02:0000E836 33C200C00000    	  1433:     move.w  D2,(VDP_DATA).l
                            	  1434: 
                            	  1435:     ; ---- Pixels 4-7 (lower nibbles) ----
02:0000E83C 1203            	  1436:     move.b  D3,D1
02:0000E83E 0201000F        	  1437:     andi.b  #$0F,D1
02:0000E842 613C            	  1438:     bsr     .csfx_expand
02:0000E844 3C02            	  1439:     move.w  D2,D6
02:0000E846 1204            	  1440:     move.b  D4,D1
02:0000E848 0201000F        	  1441:     andi.b  #$0F,D1
02:0000E84C 6132            	  1442:     bsr     .csfx_expand
02:0000E84E 3002            	  1443:     move.w  D2,D0
02:0000E850 8046            	  1444:     or.w    D6,D0
02:0000E852 E34A            	  1445:     lsl.w   #1,D2
02:0000E854 8446            	  1446:     or.w    D6,D2
02:0000E856 6116            	  1447:     bsr     .csfx_apply_bias
02:0000E858 33C200C00000    	  1448:     move.w  D2,(VDP_DATA).l
                            	  1449: 
02:0000E85E 201F            	  1450:     move.l  (SP)+,D0                    ; restore row counter
02:0000E860 5380            	  1451:     subq.l  #1,D0
02:0000E862 6CA8            	  1452:     bge.s   .csfx_row
                            	  1453: 
02:0000E864 51CDFF60        	  1454:     dbra    D5,.csfx_copy_loop
02:0000E868 4CDF07FF        	  1455:     movem.l (SP)+,D0-D7/A0-A2
02:0000E86C 4E75            	  1456:     rts
