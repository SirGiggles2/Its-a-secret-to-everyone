02:0003980A B001            	  3338:     cmp.b   D1,D0
02:0003980C 664A            	  3339:     bne  _L_z04_UpdateDock_Exit
                            	  3340:     ; Set the dock object's X.
                            	  3341:     ;
02:0003980E 19802070        	  3342:     move.b  D0,($70,A4,D2.W)
                            	  3343:     ; Determine whether Link is coming or going.
                            	  3344:     ; If Y = $3D, then he's at the top edge of the screen. Use state 1.
                            	  3345:     ;
02:00039812 7601            	  3346:     moveq   #1,D3
02:00039814 102C0084        	  3347:     move.b  ($0084,A4),D0
02:00039818 0C00003D        	  3348:     cmpi.b  #$3D,D0
02:0003981C 6708            	  3349:     beq  _L_z04_UpdateDock_SetState
                            	  3350:     ; But if Y = $7D, then he's at the dock. Use state 2.
                            	  3351:     ; Otherwise, return.
                            	  3352:     ;
02:0003981E 5203            	  3353:     addq.b  #1,D3
02:00039820 0C00007D        	  3354:     cmpi.b  #$7D,D0
02:00039824 6632            	  3355:     bne  _L_z04_UpdateDock_Exit
                            	  3356:     even
