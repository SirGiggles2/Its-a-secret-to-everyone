                            	  3956: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  3957:     ;
                            	  3958:     ;
                            	  3959:     ; [0E] holds reverse index of doorway direction found.
                            	  3960:     ;
02:0003EF8E 1943000E        	  3961:     move.b  D3,($000E,A4)
                            	  3962:     ; Store input direction in [02] and [0C].
