                            	  5119:     ;
02:00049020 41EC0098        	  5120:     lea     ($0098,A4),A0
02:00049024 53302000        	  5121:     subq.b  #1,(A0,D2.W)
                            	  5122:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5123:     ;
                            	  5124:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5125:     ;
02:00049028 41EC0098        	  5126:     lea     ($0098,A4),A0
02:0004902C 10302000        	  5127:     move.b  (A0,D2.W),D0
02:00049030 0C0000E8        	  5128:     cmpi.b  #$E8,D0
02:00049034 6702            	  5129:     beq.s  __far_z_07_0075
02:00049036 6004            	  5130:     jmp  L1F49F_Exit
