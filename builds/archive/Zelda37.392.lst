02:00038CE2 003C0011        	  1720:     ori     #$11,CCR  ; SEC: set C+X
02:00038CE6 123C000D        	  1721:     move.b  #$0D,D1
02:00038CEA 0A3C0010        	  1722:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038CEE 9101            	  1723:     subx.b  D1,D0   ; SBC #$0D
02:00038CF0 0A3C0010        	  1724:     eori    #$10,CCR  ; restore X = 6502 C
02:00038CF4 7600            	  1725:     moveq   #0,D3
