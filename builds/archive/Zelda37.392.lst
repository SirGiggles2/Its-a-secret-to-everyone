02:0003C0FC 1214            	  8764:     move.b  ($0000,A4),D1
02:0003C0FE 0A3C0010        	  8765:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C102 9101            	  8766:     subx.b  D1,D0   ; SBC $00
02:0003C104 0A3C0010        	  8767:     eori    #$10,CCR  ; restore X = 6502 C
