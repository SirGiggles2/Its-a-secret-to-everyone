02:0004912C 10302000        	  5291:     move.b  (A0,D2.W),D0
02:00049130 02000003        	  5292:     andi.b #$03,D0
02:00049134 670A            	  5293:     beq  _anon_z07_26
02:00049136 4EB900030900    	  5294:     jsr     MoveShot
02:0004913C 522C000E        	  5295:     addq.b  #1,($000E,A4)
