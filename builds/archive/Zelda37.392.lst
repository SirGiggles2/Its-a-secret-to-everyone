                            	  1500:     ;
02:00038B7A 101D            	  1501:     move.b  (A5)+,D0  ; PLA
02:00038B7C 41EC03BC        	  1502:     lea     ($03BC,A4),A0
02:00038B80 11802000        	  1503:     move.b  D0,(A0,D2.W)
                            	  1504:     even
