                            	   749: _L_z01_CopyCommonCodeToRam_Loop:
02:0002F3C2 1214            	   750:     move.b  ($00,A4),D1   ; ptr lo
02:0002F3C4 182C0001        	   751:     move.b  ($01,A4),D4  ; ptr hi
02:0002F3C8 024100FF        	   752:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002F3CC E14C            	   753:     lsl.w   #8,D4
02:0002F3CE 8841            	   754:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002F3D0 48C4            	   755:     ext.l   D4
02:0002F3D2 D8BC00FF0000    	   756:     add.l   #NES_RAM,D4       ; → Genesis addr
