                            	  4373:     ;
02:00039FB6 10342028        	  4374:     move.b  ($28,A4,D2.W),D0
02:00039FBA 0C000010        	  4375:     cmpi.b  #$10,D0
02:00039FBE 6702            	  4376:     beq.s  __far_z_04_0036
02:00039FC0 6058            	  4377:     jmp  L1156B_Exit
