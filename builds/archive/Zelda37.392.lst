                            	  5169: PlayAreaDoorFaceAddrsLo:
02:00040352 A1              	  5170:     dc.b    ($67A1)&$FF
02:00040353 4F              	  5171:     dc.b    ($654F)&$FF
02:00040354 76              	  5172:     dc.b    ($6676)&$FF
02:00040355 65              	  5173:     dc.b    ($6665)&$FF
                            	  5174: 
                            	  5175:     even
                            	  5176: PlayAreaDoorFaceAddrsHi:
02:00040356 67              	  5177:     dc.b    ($67A1>>8)&$FF
02:00040357 65              	  5178:     dc.b    ($654F>>8)&$FF
02:00040358 66              	  5179:     dc.b    ($6676>>8)&$FF
02:00040359 66              	  5180:     dc.b    ($6665>>8)&$FF
                            	  5181: 
                            	  5182:     even
