02:00039322 0C000070        	  2601:     cmpi.b  #$70,D0
02:00039326 6604            	  2602:     bne  _anon_z04_51
02:00039328 61000686        	  2603:     jsr     PlaySecretFoundTune
                            	  2604: _anon_z04_51:
                            	  2605:     ; Replace the tile where the armos was.
