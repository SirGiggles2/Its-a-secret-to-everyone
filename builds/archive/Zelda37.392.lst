02:00039DC2 41EC0406        	  4085:     lea     ($0406,A4),A0
02:00039DC6 11803000        	  4086:     move.b  D0,(A0,D3.W)
02:00039DCA 41EC0493        	  4087:     lea     ($0493,A4),A0
