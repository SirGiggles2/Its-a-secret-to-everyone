02:0003A6E4 10303000        	  5337:     move.b  (A0,D3.W),D0
02:0003A6E8 7600            	  5338:     moveq   #0,D3
02:0003A6EA 1600            	  5339:     move.b  D0,D3
02:0003A6EC 101D            	  5340:     move.b  (A5)+,D0  ; PLA
02:0003A6EE 41EC0201        	  5341:     lea     ($0201,A4),A0
02:0003A6F2 11803000        	  5342:     move.b  D0,(A0,D3.W)
02:0003A6F6 1014            	  5343:     move.b  ($0000,A4),D0
