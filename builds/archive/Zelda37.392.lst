                            	  2855: PondHeartStartAngles:
02:000394BA 14              	  2856:     dc.b    $14, $10, $0C, $08, $04, $00, $1C
02:000394BB 10
02:000394BC 0C
02:000394BD 08
02:000394BE 04
02:000394BF 00
02:000394C0 1C
                            	  2857: 
