02:000337D0 19400085        	  2315:     move.b  D0,($0085,A4)
02:000337D4 5202            	  2316:     addq.b  #1,D2
02:000337D6 41F90003321E    	  2317:     lea     (ModeE_CharBoardYOffsetsAndBounds).l,A0
02:000337DC 12302000        	  2318:     move.b  (A0,D2.W),D1
02:000337E0 B001            	  2319:     cmp.b   D1,D0
02:000337E2 6612            	  2320:     bne  _L_z02_CycleCharBoardCursorY_ReturnValue
