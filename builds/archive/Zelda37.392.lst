                            	  4095: PlayerScreenEdgeBounds:
02:000489AC 3D              	  4096:     dc.b    $3D, $DD, $00, $F0
02:000489AD DD
02:000489AE 00
02:000489AF F0
                            	  4097: 
                            	  4098: ; Params:
                            	  4099: ; [0E]: $FF, if blocked by a door
                            	  4100: ; [0F]: movement direction
                            	  4101: ;
                            	  4102: ; Returns:
                            	  4103: ; [0F]: untouched, or changed if blocked or need to change
                            	  4104: ;
                            	  4105: ; Summary:
                            	  4106: ;
                            	  4107: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4108: ; Then allow movement or go to the next room. Otherwise,
                            	  4109: ; check passive tile objects and stop moving.
                            	  4110: ;
                            	  4111: ; For other objects: First, if moving, test the colliding tile for
                            	  4112: ; walkability. Otherwise search for a walkable direction starting
                            	  4113: ; from input direction.
                            	  4114: ;
                            	  4115: ; When you find a walkable direction, see if it makes the object
                            	  4116: ; cross a boundary. If it doesn't, then make this direction
                            	  4117: ; the objection direction. Otherwise, keep looping.
                            	  4118: ;
                            	  4119: ; If no walkable direction is found, then stop moving.
                            	  4120: ;
                            	  4121: ;
                            	  4122: ; if is player
                            	  4123: ;   if at doorway
                            	  4124: ;     go handle a walkable direction
                            	  4125: ;   if blocked by door
                            	  4126: ;     return
                            	  4127: ;
                            	  4128:     even
                            	  4129: Walker_CheckTileCollision:
                            	  4130:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4131:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4132:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4133:     ; reset) for Link and every other object. Only the tile
                            	  4134:     ; walkability decision in CheckTiles is overridden.
02:000489B0 4A02            	  4135:     cmpi.b  #$00,D2
02:000489B2 6614            	  4136:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:000489B4 102C0053        	  4137:     move.b  ($0053,A4),D0
02:000489B8 6704            	  4138:     beq  _anon_z07_16
02:000489BA 600000BE        	  4139:     jmp     GoWalkableDir
                            	  4140: 
                            	  4141: _anon_z07_16:
02:000489BE 102C000E        	  4142:     move.b  ($000E,A4),D0
02:000489C2 6A04            	  4143:     bpl.s  __far_z_07_0047
02:000489C4 600000AC        	  4144:     jmp  L1F148_Exit
                            	  4145: __far_z_07_0047:
                            	  4146:     even
                            	  4147: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4148:     ; If grid offset <> 0, return.
                            	  4149:     ;
02:000489C8 41EC0394        	  4150:     lea     ($0394,A4),A0
02:000489CC 10302000        	  4151:     move.b  (A0,D2.W),D0
02:000489D0 6704            	  4152:     beq.s  __far_z_07_0048
02:000489D2 6000009E        	  4153:     jmp  L1F148_Exit
                            	  4154: __far_z_07_0048:
                            	  4155:     ; Grid offset = 0.
                            	  4156:     ; The object is at a point between cells in the grid.
                            	  4157:     ; So, we can check tiles for collision.
                            	  4158:     ;
                            	  4159:     ; Reset [0E] alternate direction search step.
                            	  4160:     ;
02:000489D6 1940000E        	  4161:     move.b  D0,($000E,A4)
                            	  4162:     ; If there's a movement direction, go check tile collision.
                            	  4163:     ;
02:000489DA 102C000F        	  4164:     move.b  ($000F,A4),D0
02:000489DE 6702            	  4165:     beq.s  __far_z_07_0049
02:000489E0 602E            	  4166:     jmp  CheckTiles
                            	  4167: __far_z_07_0049:
                            	  4168:     ; Moving direction = 0.
                            	  4169:     ; If object is the player, return.
                            	  4170:     ;
02:000489E2 4A02            	  4171:     cmpi.b  #$00,D2
02:000489E4 6604            	  4172:     bne.s  __far_z_07_0050
02:000489E6 6000008A        	  4173:     jmp  L1F148_Exit
                            	  4174: __far_z_07_0050:
                            	  4175:     ; Moving direction = 0.
                            	  4176:     ; The object is not the player.
                            	  4177:     ;
                            	  4178:     ; If object does not have attribute $10, then
                            	  4179:     ; set movement direction to input direction,
                            	  4180:     ; and go try to turn to an unblocked direction in order to move.
                            	  4181:     ;
02:000489EA 41EC04BF        	  4182:     lea     ($04BF,A4),A0
02:000489EE 10302000        	  4183:     move.b  (A0,D2.W),D0
02:000489F2 02000010        	  4184:     andi.b #$10,D0
02:000489F6 6702            	  4185:     beq.s  __far_z_07_0051
02:000489F8 600E            	  4186:     jmp  Reverse
                            	  4187: __far_z_07_0051:
02:000489FA 41EC03F8        	  4188:     lea     ($03F8,A4),A0
02:000489FE 10302000        	  4189:     move.b  (A0,D2.W),D0
02:00048A02 1940000F        	  4190:     move.b  D0,($000F,A4)
02:00048A06 6038            	  4191:     jmp     TryNextDir
                            	  4192: 
                            	  4193:     even
                            	  4194: Reverse:
                            	  4195:     ; UNKNOWN:
                            	  4196:     ; This seems to be unused code triggered by object attribute $10.
                            	  4197:     ; But $10 is not used in the object attribute array at 07:FAEF.
                            	  4198:     ;
02:00048A08 610000FE        	  4199:     jsr     ReverseObjDir
02:00048A0C 600000BA        	  4200:     jmp     CheckBoundary
