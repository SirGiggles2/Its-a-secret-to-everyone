02:00042298 7401            	  8888:     moveq   #1,D2
                            	  8889:     even
                            	  8890: _L_z05_DrawSubmenuItems_LoopDrawItem:
02:0004229A 41EC0657        	  8891:     lea     ($0657,A4),A0
02:0004229E 10302000        	  8892:     move.b  (A0,D2.W),D0
                            	  8893:     ; If at the compass item slot, check this level's compass.
                            	  8894:     ;
02:000422A2 0C020010        	  8895:     cmpi.b  #$10,D2
02:000422A6 6606            	  8896:     bne  _anon_z05_209
