02:0003C5C2 E308            	  9435:     lsl.b  #1,D0   ; ASL A
02:0003C5C4 E308            	  9436:     lsl.b  #1,D0   ; ASL A
                            	  9437:     ; Add [07] -- the index of the current part.
                            	  9438:     ;
                            	  9439:     ; Now you have an index into the frame image table, for the
                            	  9440:     ; current image part of the current animation frame.
                            	  9441:     ;
02:0003C5C6 122C0007        	  9442:     move.b  ($0007,A4),D1
02:0003C5CA D101            	  9443:     addx.b  D1,D0   ; ADC $07
02:0003C5CC 7600            	  9444:     moveq   #0,D3
02:0003C5CE 1600            	  9445:     move.b  D0,D3
02:0003C5D0 41F90003C54C    	  9446:     lea     (GanonFrameImages).l,A0
02:0003C5D6 10303000        	  9447:     move.b  (A0,D3.W),D0
