                            	  2430: DrawGhiniAndCheckCollisions:
02:00039238 4EB900049C16    	  2431:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003923E 1940000D        	  2432:     move.b  D0,($000D,A4)
                            	  2433:     ; If the direction has an "up" component, then keep the
                            	  2434:     ; frame image 0, and go figure out horizontal flipping.
                            	  2435:     ;
02:00039242 41EC0098        	  2436:     lea     ($0098,A4),A0
02:00039246 10302000        	  2437:     move.b  (A0,D2.W),D0
02:0003924A 02000008        	  2438:     andi.b #$08,D0
02:0003924E 6614            	  2439:     bne  _L_z04_DrawGhiniAndCheckCollisions_CheckHorizontalFlip
                            	  2440:     ; Else make the frame image 1 for the "down" frame.
                            	  2441:     ; Note that this is the frame image to use, even if there's no
                            	  2442:     ; down component in the direction.
                            	  2443:     ;
02:00039250 522C000D        	  2444:     addq.b  #1,($000D,A4)
                            	  2445:     ; If right is a component of the direction, then go set horizontal
                            	  2446:     ; flipping. Else leave horizontal flipping = 0.
                            	  2447:     ;
02:00039254 41EC0098        	  2448:     lea     ($0098,A4),A0
02:00039258 10302000        	  2449:     move.b  (A0,D2.W),D0
02:0003925C 02000001        	  2450:     andi.b #$01,D0
02:00039260 6714            	  2451:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:00039262 660E            	  2452:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  2453:     even
