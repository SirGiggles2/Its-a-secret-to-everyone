                            	  1389: _TryShooting:
02:00038AE0 19400001        	  1390:     move.b  D0,($0001,A4)
                            	  1391:     ; If the monster is not a blue walking OW monster, and shoot timer = 0,
                            	  1392:     ;
02:00038AE4 41EC034F        	  1393:     lea     ($034F,A4),A0
02:00038AE8 10302000        	  1394:     move.b  (A0,D2.W),D0
02:00038AEC 0C000003        	  1395:     cmpi.b  #$03,D0
02:00038AF0 6726            	  1396:     beq  _L_z04__TryShooting_TryShootingNow
02:00038AF2 0C000001        	  1397:     cmpi.b  #$01,D0
02:00038AF6 6720            	  1398:     beq  _L_z04__TryShooting_TryShootingNow
02:00038AF8 0C000009        	  1399:     cmpi.b  #$09,D0
02:00038AFC 671A            	  1400:     beq  _L_z04__TryShooting_TryShootingNow
02:00038AFE 0C00000A        	  1401:     cmpi.b  #$0A,D0
02:00038B02 6714            	  1402:     beq  _L_z04__TryShooting_TryShootingNow
02:00038B04 41EC0451        	  1403:     lea     ($0451,A4),A0
02:00038B08 10302000        	  1404:     move.b  (A0,D2.W),D0
02:00038B0C 660A            	  1405:     bne  _L_z04__TryShooting_TryShootingNow
                            	  1406:     ; and a random value < $F8, then return.
                            	  1407:     ;
02:00038B0E 10342018        	  1408:     move.b  ($18,A4,D2.W),D0
02:00038B12 0C0000F8        	  1409:     cmpi.b  #$F8,D0
02:00038B16 656C            	  1410:     bcs  _L_z04__TryShooting_Exit
                            	  1411:     even
                            	  1412: _L_z04__TryShooting_TryShootingNow:
                            	  1413:     ; Summary
                            	  1414:     ;
                            	  1415:     ; if temporarily invincible then
                            	  1416:     ;   shoot timer := 0
                            	  1417:     ; elif shoot timer > 0 then
                            	  1418:     ;   decrement shoot timer
                            	  1419:     ; elif wants to shoot then
                            	  1420:     ;   shoot timer := $30
                            	  1421:     ;
                            	  1422:     ; qspeed := [01]
                            	  1423:     ;
                            	  1424:     ; if shoot timer <> 0 then
                            	  1425:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1426:     ;     shoot
                            	  1427:     ;     if succeeded then
                            	  1428:     ;       shoot timer := 0
                            	  1429:     ;       qspeed := 0
                            	  1430:     ;   else
                            	  1431:     ;     qspeed := 0
                            	  1432:     ;
                            	  1433:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:00038B18 102C0001        	  1434:     move.b  ($0001,A4),D0
02:00038B1C 1883            	  1435:     move.b  D3,($0000,A4)
02:00038B1E 1B00            	  1436:     move.b  D0,-(A5)  ; PHA
02:00038B20 7600            	  1437:     moveq   #0,D3
                            	  1438:     ; If not temporarily invincible,
                            	  1439:     ;
02:00038B22 41EC04F0        	  1440:     lea     ($04F0,A4),A0
02:00038B26 10302000        	  1441:     move.b  (A0,D2.W),D0
02:00038B2A 661A            	  1442:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1443:     ; then Y := shoot timer - 1
                            	  1444:     ;
02:00038B2C 7600            	  1445:     moveq   #0,D3
02:00038B2E 41EC0451        	  1446:     lea     ($0451,A4),A0
02:00038B32 16302000        	  1447:     move.b  (A0,D2.W),D3
02:00038B36 5303            	  1448:     subq.b  #1,D3
                            	  1449:     ; If Y register < 0, then shoot timer is 0.
                            	  1450:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1451:     ; Else go set a non-zero speed and return.
                            	  1452:     ;
02:00038B38 6A0C            	  1453:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038B3A 41EC0412        	  1454:     lea     ($0412,A4),A0
02:00038B3E 10302000        	  1455:     move.b  (A0,D2.W),D0
02:00038B42 6736            	  1456:     beq  _L_z04__TryShooting_SetSpeed
02:00038B44 7630            	  1457:     moveq   #48,D3
                            	  1458:     even
                            	  1459: _L_z04__TryShooting_SetShootTimer:
                            	  1460:     ; shoot timer := Y
                            	  1461:     ;
02:00038B46 1003            	  1462:     move.b  D3,D0
02:00038B48 41EC0451        	  1463:     lea     ($0451,A4),A0
02:00038B4C 11802000        	  1464:     move.b  D0,(A0,D2.W)
                            	  1465:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  1466:     ;
02:00038B50 6728            	  1467:     beq  _L_z04__TryShooting_SetSpeed
                            	  1468:     ; shoot timer <> 0
                            	  1469:     ; If shoot timer <> $10, then go set a zero speed.
                            	  1470:     ;
02:00038B52 0C030010        	  1471:     cmpi.b  #$10,D3
02:00038B56 661C            	  1472:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1473:     ; If we have the magic clock, or the monster is stunned, then
                            	  1474:     ; go set a zero speed.
                            	  1475:     ;
02:00038B58 102C066C        	  1476:     move.b  ($066C,A4),D0
02:00038B5C 1234203D        	  1477:     move.b  ($3D,A4,D2.W),D1
02:00038B60 8001            	  1478:     or.b  D1,D0
02:00038B62 6610            	  1479:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1480:     ; Shoot.
                            	  1481:     ;
02:00038B64 1014            	  1482:     move.b  ($0000,A4),D0
02:00038B66 611E            	  1483:     jsr     _ShootIfWanted2
                            	  1484:     ; If it failed, go set a non-zero speed.
                            	  1485:     ;
02:00038B68 6510            	  1486:     bcs  _L_z04__TryShooting_SetSpeed
                            	  1487:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  1488:     ;
02:00038B6A 7000            	  1489:     moveq   #0,D0
02:00038B6C 41EC0412        	  1490:     lea     ($0412,A4),A0
02:00038B70 11802000        	  1491:     move.b  D0,(A0,D2.W)
                            	  1492:     even
                            	  1493: _L_z04__TryShooting_ZeroSpeed:
02:00038B74 101D            	  1494:     move.b  (A5)+,D0  ; PLA
02:00038B76 7000            	  1495:     moveq   #0,D0
02:00038B78 1B00            	  1496:     move.b  D0,-(A5)  ; PHA
                            	  1497:     even
                            	  1498: _L_z04__TryShooting_SetSpeed:
