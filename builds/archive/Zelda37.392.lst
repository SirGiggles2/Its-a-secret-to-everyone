02:00042282 7036            	  8876:     moveq   #54,D0
02:00042284 19400001        	  8877:     move.b  D0,($0001,A4)
02:00042288 103C0080        	  8878:     move.b  #$80,D0
02:0004228C 1880            	  8879:     move.b  D0,($0000,A4)
02:0004228E 1002            	  8880:     move.b  D2,D0
02:00042290 7600            	  8881:     moveq   #0,D3
02:00042292 1600            	  8882:     move.b  D0,D3
