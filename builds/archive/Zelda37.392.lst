                            	  5261: __far_z_07_0078:
                            	  5262:     ; Reset [00], which will hold the number of axes where the distance <= 8
                            	  5263:     ; when calculating the angle to return to thrower.
                            	  5264:     ; See states $40 and $50 and GetDirectionsAndDistancesToTarget.
                            	  5265:     ;
02:00049108 7000            	  5266:     moveq   #0,D0
02:0004910A 1880            	  5267:     move.b  D0,($0000,A4)
                            	  5268:     ; If not in major state $10, go check other states.
                            	  5269:     ;
02:0004910C 41EC00AC        	  5270:     lea     ($00AC,A4),A0
02:00049110 10302000        	  5271:     move.b  (A0,D2.W),D0
02:00049114 020000F0        	  5272:     andi.b #$F0,D0
02:00049118 0C000010        	  5273:     cmpi.b  #$10,D0
