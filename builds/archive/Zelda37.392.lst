                            	  5278: _L_z07_UpdateArrowOrBoomerang_State10:
                            	  5279:     ; State $1x. Fly away from the thrower.
                            	  5280:     ;
                            	  5281:     ; Reset [0E], which will indicate:
                            	  5282:     ; - into MoveShot:   0 update grid offset, else don't
                            	  5283:     ; - out of MoveShot: $80 if blocked
                            	  5284:     ;
02:00049122 7000            	  5285:     moveq   #0,D0
