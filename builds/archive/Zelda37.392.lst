                            	  3661:     even
                            	  3662: _L_z07_ShoveMoveMin_ApplySpeed:
                            	  3663:     ; If the direction is horizontal, add the amount in [02] to X.
                            	  3664:     ;
02:000486E4 41EC00C0        	  3665:     lea     ($00C0,A4),A0
02:000486E8 10302000        	  3666:     move.b  (A0,D2.W),D0
02:000486EC 02000003        	  3667:     andi.b #$03,D0
02:000486F0 6714            	  3668:     beq  _L_z07_ShoveMoveMin_AddToY
02:000486F2 10342070        	  3669:     move.b  ($70,A4,D2.W),D0
02:000486F6 023C00EE        	  3670:     andi    #$EE,CCR  ; CLC: clear C+X
