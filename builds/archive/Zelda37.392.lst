                            	  1027:     ; move, then save the position fraction.
                            	  1028:     ;
02:0003886C 41EC0444        	  1029:     lea     ($0444,A4),A0
02:00038870 10302000        	  1030:     move.b  (A0,D2.W),D0
02:00038874 7600            	  1031:     moveq   #0,D3
02:00038876 41EC045E        	  1032:     lea     ($045E,A4),A0
