02:0003EF3A 41F90003EEC0    	  3916:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EF40 12303000        	  3917:     move.b  (A0,D3.W),D1
02:0003EF44 B001            	  3918:     cmp.b   D1,D0
02:0003EF46 640E            	  3919:     bcc  _L_z05_CheckDoorway_SearchUnderflowDoorway
02:0003EF48 102C0053        	  3920:     move.b  ($0053,A4),D0
