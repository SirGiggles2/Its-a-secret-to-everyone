                            	  5553: CheckState30:
                            	  5554:     ; If major state <> $30, go check other states.
                            	  5555:     ;
02:00049308 0C000030        	  5556:     cmpi.b  #$30,D0
02:0004930C 6656            	  5557:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5558:     ; State $3x. Slow down.
                            	  5559:     ;
                            	  5560:     ; Reset grid offset for movement.
                            	  5561:     ;
02:0004930E 7000            	  5562:     moveq   #0,D0
02:00049310 41EC0394        	  5563:     lea     ($0394,A4),A0
02:00049314 11802000        	  5564:     move.b  D0,(A0,D2.W)
                            	  5565:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5566:     ;
02:00049318 7040            	  5567:     moveq   #64,D0
02:0004931A 41EC03BC        	  5568:     lea     ($03BC,A4),A0
02:0004931E 11802000        	  5569:     move.b  D0,(A0,D2.W)
                            	  5570:     ; If facing left and X < 2, then go change state to $40. The
                            	  5571:     ; boomerang is too close to the left edge of the screen.
                            	  5572:     ; Another move might make it wrap around.
                            	  5573:     ;
02:00049322 41EC0098        	  5574:     lea     ($0098,A4),A0
02:00049326 10302000        	  5575:     move.b  (A0,D2.W),D0
02:0004932A 1940000F        	  5576:     move.b  D0,($000F,A4)
02:0004932E 02000002        	  5577:     andi.b #$02,D0
02:00049332 670A            	  5578:     beq  _L_z07_CheckState30_MoveBoomerang
02:00049334 10342070        	  5579:     move.b  ($70,A4,D2.W),D0
02:00049338 0C000002        	  5580:     cmpi.b  #$02,D0
02:0004933C 650E            	  5581:     bcs  _L_z07_CheckState30_SetState40
                            	  5582:     even
