02:0004032A 6600FF54        	  5139:     bne  _L_z05_NextLoopWallTile_LoopRotate
02:0004032E 102C0003        	  5140:     move.b  ($0003,A4),D0
02:00040332 0C000066        	  5141:     cmpi.b  #$66,D0
02:00040336 6600FF48        	  5142:     bne  _L_z05_NextLoopWallTile_LoopRotate
02:0004033A 0A3C0001        	  5143:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0004033E 4E75            	  5144:     rts
