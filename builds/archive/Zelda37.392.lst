                            	  3322:     ; State 0
                            	  3323:     ;
                            	  3324:     ; Choose an X coordinate for the dock:
                            	  3325:     ; $80 in room $55
                            	  3326:     ; $60 in the other room ($3F)
                            	  3327:     ;
02:000397F4 103C0080        	  3328:     move.b  #$80,D0
02:000397F8 7600            	  3329:     moveq   #0,D3
02:000397FA 162C00EB        	  3330:     move.b  ($00EB,A4),D3
02:000397FE 0C030055        	  3331:     cmpi.b  #$55,D3
02:00039802 6702            	  3332:     beq  _anon_z04_57
02:00039804 7060            	  3333:     moveq   #96,D0
                            	  3334: _anon_z04_57:
                            	  3335:     ; If the player is not aligned with the dock, return.
                            	  3336:     ;
