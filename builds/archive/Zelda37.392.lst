                            	  5077: _L_z07_SpreadShot_NextCorner:
                            	  5078:     ; Prepare to process the next corner.
                            	  5079:     ;
                            	  5080:     ; First, restore X offset [02] and Y offset [03].
                            	  5081:     ;
02:00048FE4 101D            	  5082:     move.b  (A5)+,D0  ; PLA
02:00048FE6 19400003        	  5083:     move.b  D0,($0003,A4)
02:00048FEA 101D            	  5084:     move.b  (A5)+,D0  ; PLA
02:00048FEC 19400002        	  5085:     move.b  D0,($0002,A4)
                            	  5086:     ; Take turns negating X offset or Y offset for the next round.
                            	  5087:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5088:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5089:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5090:     ; - Fourth turn: doesn't matter
                            	  5091:     ;
                            	  5092:     ;
                            	  5093:     ; Get the loop index.
02:00048FF0 101D            	  5094:     move.b  (A5)+,D0  ; PLA
02:00048FF2 1B00            	  5095:     move.b  D0,-(A5)  ; PHA
02:00048FF4 7600            	  5096:     moveq   #0,D3
02:00048FF6 1600            	  5097:     move.b  D0,D3
02:00048FF8 0C030001        	  5098:     cmpi.b  #$01,D3
02:00048FFC 6602            	  5099:     bne  _anon_z07_25
02:00048FFE 7603            	  5100:     moveq   #3,D3
                            	  5101: _anon_z07_25:
02:00049000 10343000        	  5102:     move.b  ($00,A4,D3.W),D0
02:00049004 4600            	  5103:     eori.b #$FF,D0
02:00049006 023C00EE        	  5104:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004900A 123C0001        	  5105:     move.b  #$01,D1
02:0004900E D101            	  5106:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00049010 19803000        	  5107:     move.b  D0,($00,A4,D3.W)
                            	  5108:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5109:     ;
02:00049014 101D            	  5110:     move.b  (A5)+,D0  ; PLA
02:00049016 7600            	  5111:     moveq   #0,D3
02:00049018 1600            	  5112:     move.b  D0,D3
02:0004901A 5303            	  5113:     subq.b  #1,D3
02:0004901C 6A00FF18        	  5114:     bpl  _L_z07_SpreadShot_DrawShotCorner
