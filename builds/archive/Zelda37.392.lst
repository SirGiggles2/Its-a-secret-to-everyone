                            	  9459: Ganon_CheckCollisions:
                            	  9460:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	  9461:     ; Store in [02] and [03].
                            	  9462:     ;
02:0003C5EC 10342070        	  9463:     move.b  ($70,A4,D2.W),D0
02:0003C5F0 023C00EE        	  9464:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C5F4 123C0010        	  9465:     move.b  #$10,D1
02:0003C5F8 D101            	  9466:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C5FA 19400002        	  9467:     move.b  D0,($0002,A4)
02:0003C5FE 41EC0084        	  9468:     lea     ($0084,A4),A0
02:0003C602 10302000        	  9469:     move.b  (A0,D2.W),D0
02:0003C606 023C00EE        	  9470:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C60A 123C0010        	  9471:     move.b  #$10,D1
02:0003C60E D101            	  9472:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003C610 19400003        	  9473:     move.b  D0,($0003,A4)
                            	  9474:     ; Check for a collision with Link.
                            	  9475:     ;
                            	  9476:     ; We can't call CheckLinkCollision, because we need to
                            	  9477:     ; customize Ganon's midpoint.
                            	  9478:     ;
                            	  9479:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	  9480:     ; detection, if Link is invincible. Initialize variables that will
                            	  9481:     ; be returned from the partial collision check routine. Then
                            	  9482:     ; call it.
                            	  9483:     ;
02:0003C614 102C04F0        	  9484:     move.b  ($04F0,A4),D0
02:0003C618 6616            	  9485:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003C61A 19400006        	  9486:     move.b  D0,($0006,A4)
02:0003C61E 19400009        	  9487:     move.b  D0,($0009,A4)
02:0003C622 1940000C        	  9488:     move.b  D0,($000C,A4)
02:0003C626 7600            	  9489:     moveq   #0,D3
02:0003C628 1883            	  9490:     move.b  D3,($0000,A4)
02:0003C62A 4EB90003109A    	  9491:     jsr     CheckLinkCollisionPreinit
                            	  9492:     even
                            	  9493: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	  9494:     ; If Ganon is not in state 0, then he's brown.
                            	  9495:     ; Go check collision with an arrow.
                            	  9496:     ;
02:0003C630 41EC00AC        	  9497:     lea     ($00AC,A4),A0
02:0003C634 10302000        	  9498:     move.b  (A0,D2.W),D0
02:0003C638 6652            	  9499:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	  9500:     ; If timer <> 0, then Ganon is visible.
                            	  9501:     ; He can't be harmed like this. So, return.
                            	  9502:     ;
02:0003C63A 10342028        	  9503:     move.b  ($28,A4,D2.W),D0
02:0003C63E 664A            	  9504:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003C640 760D            	  9505:     moveq   #13,D3
02:0003C642 4EB9000310D4    	  9506:     jsr     CheckMonsterSwordCollision
                            	  9507:     ; If Ganon has died according to the usual collision check rules
                            	  9508:     ; (HP = 0), then:
                            	  9509:     ; 1. Restore HP to the initial value $F0
                            	  9510:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	  9511:     ; 3. Change palette row 7 to make Ganon brown
                            	  9512:     ;
02:0003C648 41EC0405        	  9513:     lea     ($0405,A4),A0
02:0003C64C 10302000        	  9514:     move.b  (A0,D2.W),D0
02:0003C650 6718            	  9515:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003C652 103C00F0        	  9516:     move.b  #$F0,D0
02:0003C656 41EC0485        	  9517:     lea     ($0485,A4),A0
02:0003C65A 11802000        	  9518:     move.b  D0,(A0,D2.W)
02:0003C65E 41EC00AC        	  9519:     lea     ($00AC,A4),A0
02:0003C662 53302000        	  9520:     subq.b  #1,(A0,D2.W)
02:0003C666 61000084        	  9521:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	  9522:     even
                            	  9523: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	  9524:     ; If Ganon was harmed, then play the sound effect
                            	  9525:     ; and set timer to $40, so that he's visible for $40 frames.
                            	  9526:     ;
02:0003C66A 41EC04F0        	  9527:     lea     ($04F0,A4),A0
02:0003C66E 10302000        	  9528:     move.b  (A0,D2.W),D0
02:0003C672 670A            	  9529:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003C674 6100BC16        	  9530:     jsr     PlayBossHitCryIfNeeded
02:0003C678 7040            	  9531:     moveq   #64,D0
02:0003C67A 19802028        	  9532:     move.b  D0,($28,A4,D2.W)
                            	  9533:     even
                            	  9534: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	  9535:     ; Reset metastate, because Ganon cannot die this way.
                            	  9536:     ;
02:0003C67E 4EB90004A416    	  9537:     jsr     ResetObjMetastate
                            	  9538:     ; Reset shove info and invincibility timer, because Ganon
                            	  9539:     ; doesn't react at all as a usual monster.
                            	  9540:     ;
02:0003C684 4EB9000310C2    	  9541:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	  9542:     even
                            	  9543: _L_z04_Ganon_CheckCollisions_Exit:
02:0003C68A 4E75            	  9544:     rts
                            	  9545: 
                            	  9546:     even
                            	  9547: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	  9548:     ; If the silver arrow is not in the inventory, then return.
                            	  9549:     ;
02:0003C68C 102C0659        	  9550:     move.b  ($0659,A4),D0
02:0003C690 0C000002        	  9551:     cmpi.b  #$02,D0
02:0003C694 66F4            	  9552:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  9553:     ; Reset the collision return value [06].
                            	  9554:     ;
02:0003C696 7000            	  9555:     moveq   #0,D0
02:0003C698 19400006        	  9556:     move.b  D0,($0006,A4)
                            	  9557:     ; If there's no arrow in flight, then return.
                            	  9558:     ;
02:0003C69C 7612            	  9559:     moveq   #18,D3
02:0003C69E 41EC00AC        	  9560:     lea     ($00AC,A4),A0
02:0003C6A2 10303000        	  9561:     move.b  (A0,D3.W),D0
02:0003C6A6 0C000010        	  9562:     cmpi.b  #$10,D0
02:0003C6AA 66DE            	  9563:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  9564:     ; Check for collision with an arrow; and return if no collision.
                            	  9565:     ;
02:0003C6AC 4EB9000310DC    	  9566:     jsr     CheckMonsterArrowOrRodCollision
02:0003C6B2 102C0006        	  9567:     move.b  ($0006,A4),D0
02:0003C6B6 67D2            	  9568:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	  9569:     ; Set the Ganon phase to "dying".
                            	  9570:     ;
02:0003C6B8 41EC042C        	  9571:     lea     ($042C,A4),A0
02:0003C6BC 52302000        	  9572:     addq.b  #1,(A0,D2.W)
                            	  9573:     ; Now his body does flash.
                            	  9574:     ;
02:0003C6C0 7028            	  9575:     moveq   #40,D0
02:0003C6C2 41EC04F0        	  9576:     lea     ($04F0,A4),A0
02:0003C6C6 11802000        	  9577:     move.b  D0,(A0,D2.W)
                            	  9578:     ; Set initial cloud distance 8.
                            	  9579:     ;
02:0003C6CA 7008            	  9580:     moveq   #8,D0
02:0003C6CC 41EC0478        	  9581:     lea     ($0478,A4),A0
02:0003C6D0 11802000        	  9582:     move.b  D0,(A0,D2.W)
02:0003C6D4 0A3C0001        	  9583:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C6D8 4E75            	  9584:     rts
