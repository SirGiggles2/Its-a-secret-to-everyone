                            	  6908: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6909:     ; To animate the state, the animation counter had to have
                            	  6910:     ; reached 0. Right after this routine, the counter will be
                            	  6911:     ; rolled over, and the movement frame will be switched.
                            	  6912:     ;
                            	  6913:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6914:     ; the animation here, in order to immediately change it to
                            	  6915:     ; 0 (legs apart) after this.
                            	  6916:     ;
02:00049C5E 7001            	  6917:     moveq   #1,D0
02:00049C60 194003E4        	  6918:     move.b  D0,($03E4,A4)
02:00049C64 4E75            	  6919:     rts
                            	  6920: 
