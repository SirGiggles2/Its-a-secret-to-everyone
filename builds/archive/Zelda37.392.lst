                            	  5045:     ; If distance >= $20, skip this corner.
                            	  5046:     ;
02:00048FA6 0C000020        	  5047:     cmpi.b  #$20,D0
02:00048FAA 6438            	  5048:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5049:     ; Add the object's Y (the center of the spread) and the
                            	  5050:     ; current offset in [03] to set sprite Y in [01].
                            	  5051:     ;
02:00048FAC 41EC0084        	  5052:     lea     ($0084,A4),A0
02:00048FB0 10302000        	  5053:     move.b  (A0,D2.W),D0
02:00048FB4 023C00EE        	  5054:     andi    #$EE,CCR  ; CLC: clear C+X
02:00048FB8 122C0003        	  5055:     move.b  ($0003,A4),D1
02:00048FBC D101            	  5056:     addx.b  D1,D0   ; ADC $03
02:00048FBE 19400001        	  5057:     move.b  D0,($0001,A4)
                            	  5058:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
