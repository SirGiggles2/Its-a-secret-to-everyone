02:0004211A 41EC0657        	  8679:     lea     ($0657,A4),A0
02:0004211E 10302000        	  8680:     move.b  (A0,D2.W),D0
02:00042122 41F900047A04    	  8681:     lea     (LevelMasks).l,A0
02:00042128 12303000        	  8682:     move.b  (A0,D3.W),D1
