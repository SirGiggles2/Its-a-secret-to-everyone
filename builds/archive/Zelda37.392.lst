                            	 10352: TurnTowardsPlayer8:
                            	 10353:     ; Build a direction in [00] towards the player.
                            	 10354:     ;
                            	 10355:     ; First, calculate a horizontal component:
                            	 10356:     ;
                            	 10357:     ; If   observed player X = object X, [00] := 0 (none)
                            	 10358:     ; elif observed player X > object X, [00] := 1 (right)
                            	 10359:     ; else                               [00] := 2 (left)
                            	 10360:     ;
02:0003CC12 7600            	 10361:     moveq   #0,D3
02:0003CC14 1883            	 10362:     move.b  D3,($0000,A4)
02:0003CC16 5203            	 10363:     addq.b  #1,D3
02:0003CC18 102C0061        	 10364:     move.b  ($0061,A4),D0
02:0003CC1C 12342070        	 10365:     move.b  ($70,A4,D2.W),D1
02:0003CC20 B001            	 10366:     cmp.b   D1,D0
02:0003CC22 6706            	 10367:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003CC24 6402            	 10368:     bcc  _anon_z04_175
02:0003CC26 5203            	 10369:     addq.b  #1,D3
                            	 10370: _anon_z04_175:
02:0003CC28 1883            	 10371:     move.b  D3,($0000,A4)
                            	 10372:     even
                            	 10373: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 10374:     ; Second, calculate a vertical component.
                            	 10375:     ; Combine it with the horizontal component:
                            	 10376:     ;
                            	 10377:     ; Y := 4 (down)
                            	 10378:     ; if observed player Y <> object Y then
                            	 10379:     ;   if observed player Y < object Y then
                            	 10380:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 10381:     ;   [00] := [00] | Y
                            	 10382:     ;
02:0003CC2A 7601            	 10383:     moveq   #1,D3
02:0003CC2C 102C0062        	 10384:     move.b  ($0062,A4),D0
02:0003CC30 41EC0084        	 10385:     lea     ($0084,A4),A0
02:0003CC34 12302000        	 10386:     move.b  (A0,D2.W),D1
02:0003CC38 B001            	 10387:     cmp.b   D1,D0
02:0003CC3A 6710            	 10388:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003CC3C 6402            	 10389:     bcc  _anon_z04_176
02:0003CC3E 5203            	 10390:     addq.b  #1,D3
                            	 10391: _anon_z04_176:
