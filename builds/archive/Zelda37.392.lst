02:000337BC 102C0085        	  2310:     move.b  ($0085,A4),D0
02:000337C0 023C00EE        	  2311:     andi    #$EE,CCR  ; CLC: clear C+X
02:000337C4 41F90003321E    	  2312:     lea     (ModeE_CharBoardYOffsetsAndBounds).l,A0
