                            	  1837:     ; 3 (back), else 2 (front).
                            	  1838:     ;
                            	  1839:     ; The frame image number is being assigned to ObjDir.
                            	  1840:     ;
02:00038DCA 7603            	  1841:     moveq   #3,D3
02:00038DCC 41EC0084        	  1842:     lea     ($0084,A4),A0
02:00038DD0 10302000        	  1843:     move.b  (A0,D2.W),D0
02:00038DD4 122C0084        	  1844:     move.b  ($0084,A4),D1
02:00038DD8 B001            	  1845:     cmp.b   D1,D0
02:00038DDA 6402            	  1846:     bcc  _anon_z04_40
02:00038DDC 5303            	  1847:     subq.b  #1,D3
                            	  1848: _anon_z04_40:
02:00038DDE 41EC0098        	  1849:     lea     ($0098,A4),A0
