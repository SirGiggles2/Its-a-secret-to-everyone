                            	  8695: Submenu_WriteScanningMapRoomMark:
02:00042130 1003            	  8696:     move.b  D3,D0
02:00042132 1B00            	  8697:     move.b  D0,-(A5)  ; PHA
02:00042134 610058FA        	  8698:     jsr     GetRoomFlags
02:00042138 102C00EB        	  8699:     move.b  ($00EB,A4),D0
02:0004213C 1B00            	  8700:     move.b  D0,-(A5)  ; PHA
                            	  8701:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8702:     ; in order to look up its information.
                            	  8703:     ;
02:0004213E 102C005D        	  8704:     move.b  ($005D,A4),D0
02:00042142 194000EB        	  8705:     move.b  D0,($00EB,A4)
                            	  8706:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8707:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8708:     ; map mark tile.
                            	  8709:     ;
02:00042146 7013            	  8710:     moveq   #19,D0
02:00042148 1940033F        	  8711:     move.b  D0,($033F,A4)
                            	  8712:     ; Get the currently scanned room's visit state.
                            	  8713:     ;
02:0004214C 7600            	  8714:     moveq   #0,D3
02:0004214E 162C00EB        	  8715:     move.b  ($00EB,A4),D3
02:00042152 1214            	  8716:     move.b  ($00,A4),D1   ; ptr lo
02:00042154 182C0001        	  8717:     move.b  ($01,A4),D4  ; ptr hi
02:00042158 024100FF        	  8718:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004215C E14C            	  8719:     lsl.w   #8,D4
02:0004215E 8841            	  8720:     or.w    D1,D4             ; D4 = NES ptr addr
02:00042160 48C4            	  8721:     ext.l   D4
02:00042162 D8BC00FF0000    	  8722:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00042168 2044            	  8723:     movea.l D4,A0
02:0004216A 10303000        	  8724:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004216E 02000020        	  8725:     andi.b #$20,D0
                            	  8726:     ; If it's been visited, then check each of the 4 doors,
                            	  8727:     ; and build an open door mask.
                            	  8728:     ;
                            	  8729:     ; Start with direction up and direction index 3.
                            	  8730:     ;
02:00042172 671C            	  8731:     beq  _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile
02:00042174 7008            	  8732:     moveq   #8,D0
02:00042176 19400002        	  8733:     move.b  D0,($0002,A4)
02:0004217A 7403            	  8734:     moveq   #3,D2
                            	  8735: _anon_z05_204:
02:0004217C 6100DF56        	  8736:     jsr     FindDoorAttrByDoorBit
02:00042180 6132            	  8737:     jsr     CalcOpenDoorwayMask
02:00042182 5302            	  8738:     subq.b  #1,D2
02:00042184 122C0002        	  8739:     move.b  ($0002,A4),D1
02:00042188 E209            	  8740:     lsr.b  #1,D1   ; LSR $02
02:0004218A 19410002        	  8741:     move.b  D1,($0002,A4)
02:0004218E 66EC            	  8742:     bne  _anon_z05_204
                            	  8743:     even
                            	  8744: _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile:
                            	  8745:     ; Restore current room ID and dynamic buffer offset.
                            	  8746:     ;
02:00042190 101D            	  8747:     move.b  (A5)+,D0  ; PLA
02:00042192 194000EB        	  8748:     move.b  D0,($00EB,A4)
02:00042196 101D            	  8749:     move.b  (A5)+,D0  ; PLA
02:00042198 7600            	  8750:     moveq   #0,D3
02:0004219A 1600            	  8751:     move.b  D0,D3
                            	  8752:     ; The map marks are arranged in the same order as all the
                            	  8753:     ; possible values of OpenDoorMask.
                            	  8754:     ;
                            	  8755:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8756:     ; dynamic transfer buf at the current offset.
                            	  8757:     ;
02:0004219C 102C033F        	  8758:     move.b  ($033F,A4),D0
02:000421A0 023C00EE        	  8759:     andi    #$EE,CCR  ; CLC: clear C+X
02:000421A4 123C00E2        	  8760:     move.b  #$E2,D1
02:000421A8 D101            	  8761:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:000421AA 41EC0304        	  8762:     lea     ($0304,A4),A0
02:000421AE 11803000        	  8763:     move.b  D0,(A0,D3.W)
02:000421B2 4E75            	  8764:     rts
                            	  8765: 
                            	  8766: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8767: ; based on doorway type and room flags. Each call will shift the next
                            	  8768: ; doorway state bit into OpenDoorwayMask.
                            	  8769: ;
                            	  8770: ; Params:
                            	  8771: ; A: door attribute
                            	  8772: ; X: direction index
                            	  8773: ;
                            	  8774: ; Returns:
                            	  8775: ; A: untouched
                            	  8776: ;
                            	  8777:     even
                            	  8778: CalcOpenDoorwayMask:
02:000421B4 7600            	  8779:     moveq   #0,D3
02:000421B6 1B00            	  8780:     move.b  D0,-(A5)  ; PHA
02:000421B8 0C000004        	  8781:     cmpi.b  #$04,D0
02:000421BC 6548            	  8782:     bcs  _L_z05_CalcOpenDoorwayMask_ByDoorType
                            	  8783:     ; Else we have to find out the walkability from the room flags.
                            	  8784:     ;
02:000421BE 1002            	  8785:     move.b  D2,D0
02:000421C0 1B00            	  8786:     move.b  D0,-(A5)  ; PHA
02:000421C2 1003            	  8787:     move.b  D3,D0
02:000421C4 1B00            	  8788:     move.b  D0,-(A5)  ; PHA
02:000421C6 61005868        	  8789:     jsr     GetRoomFlags
02:000421CA 023C00EE        	  8790:     andi    #$EE,CCR  ; CLC: clear C+X
02:000421CE 41F900047A04    	  8791:     lea     (LevelMasks).l,A0
02:000421D4 12302000        	  8792:     move.b  (A0,D2.W),D1
02:000421D8 C001            	  8793:     and.b  D1,D0
02:000421DA 6704            	  8794:     beq  _anon_z05_205
02:000421DC 003C0011        	  8795:     ori     #$11,CCR  ; SEC: set C+X
                            	  8796: _anon_z05_205:
02:000421E0 101D            	  8797:     move.b  (A5)+,D0  ; PLA
02:000421E2 7600            	  8798:     moveq   #0,D3
02:000421E4 1600            	  8799:     move.b  D0,D3
02:000421E6 101D            	  8800:     move.b  (A5)+,D0  ; PLA
02:000421E8 7400            	  8801:     moveq   #0,D2
02:000421EA 1400            	  8802:     move.b  D0,D2
                            	  8803:     even
