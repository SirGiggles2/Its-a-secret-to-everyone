                            	  5443: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  5444:     ; Bloated timer =>
                            	  5445:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  5446:     ; 1:     go advance the substate
                            	  5447:     ; other: go decrement Bloated timer
                            	  5448:     ;
02:0003A7C2 7600            	  5449:     moveq   #0,D3
02:0003A7C4 41EC045E        	  5450:     lea     ($045E,A4),A0
02:0003A7C8 16302000        	  5451:     move.b  (A0,D2.W),D3
02:0003A7CC 5303            	  5452:     subq.b  #1,D3
02:0003A7CE 6750            	  5453:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A7D0 6B04            	  5454:     bmi.s  __far_z_04_0049
02:0003A7D2 60000080        	  5455:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5456: __far_z_04_0049:
                            	  5457:     ; Set the bloated timer according to the substate.
                            	  5458:     ;
02:0003A7D6 7600            	  5459:     moveq   #0,D3
02:0003A7D8 41EC042C        	  5460:     lea     ($042C,A4),A0
02:0003A7DC 16302000        	  5461:     move.b  (A0,D2.W),D3
02:0003A7E0 41F90003A71E    	  5462:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A7E6 10303000        	  5463:     move.b  (A0,D3.W),D0
02:0003A7EA 41EC045E        	  5464:     lea     ($045E,A4),A0
02:0003A7EE 11802000        	  5465:     move.b  D0,(A0,D2.W)
                            	  5466:     ; If substate <> 0, go decrement bloated timer.
                            	  5467:     ;
02:0003A7F2 4A03            	  5468:     cmpi.b  #$00,D3
02:0003A7F4 6702            	  5469:     beq.s  __far_z_04_0050
02:0003A7F6 605C            	  5470:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5471: __far_z_04_0050:
                            	  5472:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5473:     ;
02:0003A7F8 7610            	  5474:     moveq   #16,D3
02:0003A7FA 7000            	  5475:     moveq   #0,D0
02:0003A7FC 41EC00AC        	  5476:     lea     ($00AC,A4),A0
02:0003A800 11803000        	  5477:     move.b  D0,(A0,D3.W)
                            	  5478:     ; Increment the number of bomb hits.
                            	  5479:     ;
02:0003A804 41EC0437        	  5480:     lea     ($0437,A4),A0
02:0003A808 10302000        	  5481:     move.b  (A0,D2.W),D0
02:0003A80C 023C00EE        	  5482:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A810 123C0001        	  5483:     move.b  #$01,D1
02:0003A814 D101            	  5484:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A816 41EC0437        	  5485:     lea     ($0437,A4),A0
02:0003A81A 11802000        	  5486:     move.b  D0,(A0,D2.W)
02:0003A81E 6034            	  5487:     jmp     L_Dodongo_DecrementBloatedTimer
                            	  5488: 
                            	  5489:     even
                            	  5490: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  5491:     ; Advance the substate.
                            	  5492:     ;
02:0003A820 41EC042C        	  5493:     lea     ($042C,A4),A0
02:0003A824 52302000        	  5494:     addq.b  #1,(A0,D2.W)
                            	  5495:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5496:     ;
02:0003A828 41EC042C        	  5497:     lea     ($042C,A4),A0
02:0003A82C 10302000        	  5498:     move.b  (A0,D2.W),D0
02:0003A830 0C000002        	  5499:     cmpi.b  #$02,D0
02:0003A834 6402            	  5500:     bcc.s  __far_z_04_0051
02:0003A836 601C            	  5501:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5502: __far_z_04_0051:
                            	  5503:     ; New bloated substate >= 2.
                            	  5504:     ;
                            	  5505:     ; If bomb hits < 2, then set bloated substate 4,
                            	  5506:     ; which will transition to state 0 (moving).
                            	  5507:     ;
                            	  5508:     ; Note that if the bomb hits >= 2, then:
                            	  5509:     ; - If new substate = 2, then substate 2 will wait,
                            	  5510:     ;   and then transition to substate 3.
                            	  5511:     ; - If new substate = 3, then the next frame the monster will die.
                            	  5512:     ;
02:0003A838 7600            	  5513:     moveq   #0,D3
02:0003A83A 41EC0437        	  5514:     lea     ($0437,A4),A0
02:0003A83E 16302000        	  5515:     move.b  (A0,D2.W),D3
02:0003A842 0C030002        	  5516:     cmpi.b  #$02,D3
02:0003A846 6502            	  5517:     bcs.s  __far_z_04_0052
02:0003A848 600A            	  5518:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5519: __far_z_04_0052:
02:0003A84A 7004            	  5520:     moveq   #4,D0
02:0003A84C 41EC042C        	  5521:     lea     ($042C,A4),A0
02:0003A850 11802000        	  5522:     move.b  D0,(A0,D2.W)
                            	  5523:     even
