                            	  4163: UpdateMoldorm:
                            	  4164:     ; If facing direction = 0, return.
                            	  4165:     ;
02:00039E7C 41EC0098        	  4166:     lea     ($0098,A4),A0
02:00039E80 10302000        	  4167:     move.b  (A0,D2.W),D0
02:00039E84 670000C2        	  4168:     beq  _L_z04_UpdateMoldorm_Exit
