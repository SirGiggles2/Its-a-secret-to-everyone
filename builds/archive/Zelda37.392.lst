02:00038E0A 1600            	  1869:     move.b  D0,D3
02:00038E0C 41F900038D86    	  1870:     lea     (BlueLeeverStateQSpeeds).l,A0
02:00038E12 10303000        	  1871:     move.b  (A0,D3.W),D0
02:00038E16 41EC03BC        	  1872:     lea     ($03BC,A4),A0
02:00038E1A 11802000        	  1873:     move.b  D0,(A0,D2.W)
02:00038E1E 41F900038D8C    	  1874:     lea     (BlueLeeverStateTimes).l,A0
02:00038E24 10303000        	  1875:     move.b  (A0,D3.W),D0
02:00038E28 19802028        	  1876:     move.b  D0,($28,A4,D2.W)
