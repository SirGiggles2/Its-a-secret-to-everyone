02:00035106 123C0080        	  4817:     move.b  #$80,D1
02:0003510A D101            	  4818:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003510C 19400058        	  4819:     move.b  D0,($0058,A4)
                            	  4820:     ; Carry over to the tile offset and current V-scroll.
                            	  4821:     ;
