02:0004893A 10302000        	  4043:     move.b  (A0,D2.W),D0
02:0004893E 123C0000        	  4044:     move.b  #$00,D1
02:00048942 0A3C0010        	  4045:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048946 9101            	  4046:     subx.b  D1,D0   ; SBC #$00
02:00048948 0A3C0010        	  4047:     eori    #$10,CCR  ; restore X = 6502 C
02:0004894C 41EC0084        	  4048:     lea     ($0084,A4),A0
02:00048950 11802000        	  4049:     move.b  D0,(A0,D2.W)
