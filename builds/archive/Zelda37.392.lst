                            	  7042: ChangePlayMapSquareOW:
02:000412E2 1002            	  7043:     move.b  D2,D0
02:000412E4 1B00            	  7044:     move.b  D0,-(A5)  ; PHA
                            	  7045:     ; We're dealing with squares.
                            	  7046:     ; So, align the object's X coordinate with 16 pixels.
                            	  7047:     ;
02:000412E6 10342070        	  7048:     move.b  ($70,A4,D2.W),D0
02:000412EA 020000F0        	  7049:     andi.b #$F0,D0
                            	  7050:     ; Divide it by 4 to get the offset of the address of the column
                            	  7051:     ; in play area map.
                            	  7052:     ;
                            	  7053:     ; The calculation is: address offset = (X / 8) * 2
                            	  7054:     ; 8 for the width of the column; 2 for the width of the address
                            	  7055:     ;
02:000412EE E208            	  7056:     lsr.b  #1,D0   ; LSR A
02:000412F0 E208            	  7057:     lsr.b  #1,D0   ; LSR A
02:000412F2 7400            	  7058:     moveq   #0,D2
02:000412F4 1400            	  7059:     move.b  D0,D2
                            	  7060:     ; Store the address of the column in [00:01].
                            	  7061:     ;
02:000412F6 41F90004756C    	  7062:     lea     (PlayAreaColumnAddrs).l,A0
02:000412FC 10302000        	  7063:     move.b  (A0,D2.W),D0
02:00041300 1880            	  7064:     move.b  D0,($0000,A4)
02:00041302 41F90004756D    	  7065:     lea     (PlayAreaColumnAddrs+1).l,A0
02:00041308 10302000        	  7066:     move.b  (A0,D2.W),D0
02:0004130C 19400001        	  7067:     move.b  D0,($0001,A4)
02:00041310 101D            	  7068:     move.b  (A5)+,D0  ; PLA
02:00041312 1B00            	  7069:     move.b  D0,-(A5)  ; PHA
02:00041314 7400            	  7070:     moveq   #0,D2
02:00041316 1400            	  7071:     move.b  D0,D2
                            	  7072:     ; Align the object's Y coordinate with 16 pixels.
                            	  7073:     ;
02:00041318 41EC0084        	  7074:     lea     ($0084,A4),A0
02:0004131C 10302000        	  7075:     move.b  (A0,D2.W),D0
02:00041320 020000F0        	  7076:     andi.b #$F0,D0
                            	  7077:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  7078:     ; the height of each row.
                            	  7079:     ;
02:00041324 003C0011        	  7080:     ori     #$11,CCR  ; SEC: set C+X
02:00041328 123C0040        	  7081:     move.b  #$40,D1
02:0004132C 0A3C0010        	  7082:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041330 9101            	  7083:     subx.b  D1,D0   ; SBC #$40
02:00041332 0A3C0010        	  7084:     eori    #$10,CCR  ; restore X = 6502 C
02:00041336 E208            	  7085:     lsr.b  #1,D0   ; LSR A
02:00041338 E208            	  7086:     lsr.b  #1,D0   ; LSR A
02:0004133A E208            	  7087:     lsr.b  #1,D0   ; LSR A
                            	  7088:     ; Add this row offset to the column address.
                            	  7089:     ;
02:0004133C 4EB900030978    	  7090:     jsr     AddToInt16At0
                            	  7091:     ; Assume that we'll write a type 1 square with primary square
                            	  7092:     ; taken from [05]. If so, the square index doesn't matter
                            	  7093:     ; as long as >= $10. See WriteSquareOW.
                            	  7094:     ;
02:00041342 7600            	  7095:     moveq   #0,D3
02:00041344 7410            	  7096:     moveq   #16,D2
02:00041346 102C0005        	  7097:     move.b  ($0005,A4),D0
                            	  7098:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  7099:     ; So, we have to look up the square index corresponding
                            	  7100:     ; to primary square/tile in [05].
                            	  7101:     ;
                            	  7102:     ; Look in primary square table from $E to 1. If a match is found,
                            	  7103:     ; then the X register will have the square index value.
                            	  7104:     ;
02:0004134A 0C000027        	  7105:     cmpi.b  #$27,D0
02:0004134E 6506            	  7106:     bcs  _anon_z05_148
02:00041350 0C0000F3        	  7107:     cmpi.b  #$F3,D0
02:00041354 6514            	  7108:     bcs  _L_z05_ChangePlayMapSquareOW_Write
