02:0003E77E 023C00EE        	  2739:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E782 123C0008        	  2740:     move.b  #$08,D1
02:0003E786 D101            	  2741:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003E788 7600            	  2742:     moveq   #0,D3
02:0003E78A 1600            	  2743:     move.b  D0,D3
02:0003E78C 103C0080        	  2744:     move.b  #$80,D0
