                            	  4501: _L_z07_Link_EndMoveAndAnimate_TruncGridOffset:
                            	  4502:     ; Grid offset is a multiple of 8. So set it to 0.
                            	  4503:     ; If not in mode 5, go check warps and animate.
                            	  4504:     ;
02:00048B96 7000            	  4505:     moveq   #0,D0
02:00048B98 19400394        	  4506:     move.b  D0,($0394,A4)
02:00048B9C 7600            	  4507:     moveq   #0,D3
02:00048B9E 162C0012        	  4508:     move.b  ($0012,A4),D3
02:00048BA2 0C030005        	  4509:     cmpi.b  #$05,D3
02:00048BA6 66EA            	  4510:     bne  _L_z07_Link_EndMoveAndAnimate_CheckWarpsAndAnimate
                            	  4511:     ; Grid offset was a multiple of 8. So, we've stepped a whole tile,
                            	  4512:     ; and need to reset the subroom indicator.
                            	  4513:     ;
                            	  4514:     ; That way, we know not to go into a subroom that we just came out of.
                            	  4515:     ;
02:00048BA8 1940005A        	  4516:     move.b  D0,($005A,A4)
                            	  4517:     even
