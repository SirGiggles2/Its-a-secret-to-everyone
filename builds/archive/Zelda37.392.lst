02:0004127E 9101            	  6997:     subx.b  D1,D0   ; SBC #$40
02:00041280 0A3C0010        	  6998:     eori    #$10,CCR  ; restore X = 6502 C
02:00041284 E208            	  6999:     lsr.b  #1,D0   ; LSR A
02:00041286 E208            	  7000:     lsr.b  #1,D0   ; LSR A
02:00041288 E208            	  7001:     lsr.b  #1,D0   ; LSR A
