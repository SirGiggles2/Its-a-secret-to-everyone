02:0003EEE4 12303000        	  3873:     move.b  (A0,D3.W),D1
02:0003EEE8 B001            	  3874:     cmp.b   D1,D0
02:0003EEEA 6622            	  3875:     bne  _anon_z05_95
02:0003EEEC 102C0001        	  3876:     move.b  ($0001,A4),D0
02:0003EEF0 41F90003EEBC    	  3877:     lea     (DoorwayBoundsMinOver).l,A0
02:0003EEF6 12303000        	  3878:     move.b  (A0,D3.W),D1
02:0003EEFA B001            	  3879:     cmp.b   D1,D0
02:0003EEFC 6510            	  3880:     bcs  _anon_z05_95
02:0003EEFE 41F90003EEC0    	  3881:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003EF04 12303000        	  3882:     move.b  (A0,D3.W),D1
02:0003EF08 B001            	  3883:     cmp.b   D1,D0
02:0003EF0A 65000082        	  3884:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3885: _anon_z05_95:
02:0003EF0E 5303            	  3886:     subq.b  #1,D3
