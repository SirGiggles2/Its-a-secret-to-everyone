                            	  1563:     ;
02:00038BCA 41EC0098        	  1564:     lea     ($0098,A4),A0
02:00038BCE 10302000        	  1565:     move.b  (A0,D2.W),D0
02:00038BD2 1940000F        	  1566:     move.b  D0,($000F,A4)
