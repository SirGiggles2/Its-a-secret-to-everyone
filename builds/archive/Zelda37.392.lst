02:0003932C 522C00F7        	  2607:     addq.b  #1,($00F7,A4)
02:00039330 101D            	  2608:     move.b  (A5)+,D0  ; PLA
02:00039332 4EB900047CD4    	  2609:     jsr     ChangeTileObjTiles
                            	  2610:     ; Because the armos object is aligned to the square grid
                            	  2611:     ; (because it was made from a square),
                            	  2612:     ; set its grid offset to 3 to compensate.
                            	  2613:     ;
                            	  2614:     ; Most objects are aligned to the grid vertically when the
                            	  2615:     ; low nibble is $D.
                            	  2616:     ;
02:00039338 7003            	  2617:     moveq   #3,D0
02:0003933A 41EC0394        	  2618:     lea     ($0394,A4),A0
02:0003933E 11802000        	  2619:     move.b  D0,(A0,D2.W)
                            	  2620:     ; Set a speed (q-speed fraction) randomly:
                            	  2621:     ; $20 if random value < $80
                            	  2622:     ; $60 otherwise
                            	  2623:     ;
02:00039342 7020            	  2624:     moveq   #32,D0
02:00039344 7600            	  2625:     moveq   #0,D3
02:00039346 16342019        	  2626:     move.b  ($19,A4,D2.W),D3
02:0003934A 0C030080        	  2627:     cmpi.b  #$80,D3
02:0003934E 6502            	  2628:     bcs  _anon_z04_52
02:00039350 7060            	  2629:     moveq   #96,D0
                            	  2630: _anon_z04_52:
02:00039352 41EC03BC        	  2631:     lea     ($03BC,A4),A0
02:00039356 11802000        	  2632:     move.b  D0,(A0,D2.W)
                            	  2633:     even
                            	  2634: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  2635:     ; Facing and input directions down.
                            	  2636:     ;
02:0003935A 7004            	  2637:     moveq   #4,D0
02:0003935C 41EC03F8        	  2638:     lea     ($03F8,A4),A0
02:00039360 11802000        	  2639:     move.b  D0,(A0,D2.W)
02:00039364 41EC0098        	  2640:     lea     ($0098,A4),A0
02:00039368 11802000        	  2641:     move.b  D0,(A0,D2.W)
                            	  2642:     ; Every other frame, return without drawing.
                            	  2643:     ;
02:0003936C 10342028        	  2644:     move.b  ($28,A4,D2.W),D0
02:00039370 E208            	  2645:     lsr.b  #1,D0   ; LSR A
02:00039372 6512            	  2646:     bcs  _anon_z04_53
                            	  2647:     ; Finish initializing based on type.
                            	  2648:     ;
02:00039374 41EC034F        	  2649:     lea     ($034F,A4),A0
02:00039378 10302000        	  2650:     move.b  (A0,D2.W),D0
02:0003937C 0C000022        	  2651:     cmpi.b  #$22,D0
