02:000421F6 0200000F        	  8808:     andi.b #$0F,D0
02:000421FA 41EC033F        	  8809:     lea     ($033F,A4),A0
02:000421FE 11803000        	  8810:     move.b  D0,(A0,D3.W)
02:00042202 101D            	  8811:     move.b  (A5)+,D0  ; PLA
02:00042204 4E75            	  8812:     rts
