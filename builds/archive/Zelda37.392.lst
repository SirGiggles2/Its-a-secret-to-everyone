02:0003B5F4 E208            	  7301:     lsr.b  #1,D0   ; LSR A
02:0003B5F6 E208            	  7302:     lsr.b  #1,D0   ; LSR A
02:0003B5F8 E208            	  7303:     lsr.b  #1,D0   ; LSR A
02:0003B5FA E208            	  7304:     lsr.b  #1,D0   ; LSR A
02:0003B5FC 1880            	  7305:     move.b  D0,($0000,A4)
                            	  7306:     ; Copy the animation frame bit into the "frame image and
                            	  7307:     ; sprite attributes" byte.
                            	  7308:     ;
02:0003B5FE 41EC0478        	  7309:     lea     ($0478,A4),A0
02:0003B602 10302000        	  7310:     move.b  (A0,D2.W),D0
