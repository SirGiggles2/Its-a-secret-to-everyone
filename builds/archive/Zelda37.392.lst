02:0003AC40 41EC03D0        	  6025:     lea     ($03D0,A4),A0
02:0003AC44 11802000        	  6026:     move.b  D0,(A0,D2.W)
02:0003AC48 7600            	  6027:     moveq   #0,D3
02:0003AC4A 41EC03E4        	  6028:     lea     ($03E4,A4),A0
02:0003AC4E 16302000        	  6029:     move.b  (A0,D2.W),D3
