02:00030D14 162C000E        	  2153:     move.b  ($000E,A4),D3
02:00030D18 7001            	  2154:     moveq   #1,D0
02:00030D1A 19400007        	  2155:     move.b  D0,($0007,A4)
02:00030D1E 7008            	  2156:     moveq   #8,D0
