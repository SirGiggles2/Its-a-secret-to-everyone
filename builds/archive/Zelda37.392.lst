                            	  5787: CalcBoomerangFrame:
                            	  5788:     ; The minor state (low 3 bits of state) is used to
                            	  5789:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5790:     ;
                            	  5791:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5792:     ; In other words, don't offset the coordinate below.
                            	  5793:     ;
02:000494BA 7000            	  5794:     moveq   #0,D0
02:000494BC 1880            	  5795:     move.b  D0,($0000,A4)
02:000494BE 41EC00AC        	  5796:     lea     ($00AC,A4),A0
02:000494C2 10302000        	  5797:     move.b  (A0,D2.W),D0
02:000494C6 0200000F        	  5798:     andi.b #$0F,D0
02:000494CA 7600            	  5799:     moveq   #0,D3
02:000494CC 1600            	  5800:     move.b  D0,D3
02:000494CE 7000            	  5801:     moveq   #0,D0
02:000494D0 19400001        	  5802:     move.b  D0,($0001,A4)
02:000494D4 41F9000490C2    	  5803:     lea     (BoomerangFrameCycle).l,A0
02:000494DA 10303000        	  5804:     move.b  (A0,D3.W),D0
02:000494DE 1940000C        	  5805:     move.b  D0,($000C,A4)
                            	  5806:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5807:     ;
02:000494E2 1003            	  5808:     move.b  D3,D0
02:000494E4 41F9000490CC    	  5809:     lea     (BoomerangBaseSpriteAttrCycle).l,A0
02:000494EA 10303000        	  5810:     move.b  (A0,D3.W),D0
02:000494EE 19400004        	  5811:     move.b  D0,($0004,A4)
                            	  5812:     ; TODO: ?
                            	  5813:     ; If base sprite attribute in [04] = 8, then leave [04] as it is.
                            	  5814:     ; Else add the item value of the magic boomerang.
                            	  5815:     ;
                            	  5816:     ; But none of the values in the base sprite attributes array is 8.
                            	  5817:     ;
                            	  5818:     ; As far I can tell, the magic boomerang's item value (0 or 1) in
                            	  5819:     ; the inventory will always be added to the base sprite attribute.
                            	  5820:     ;
                            	  5821:     ; So, palette row 4 or 5 will be chosen.
                            	  5822:     ;
02:000494F2 7600            	  5823:     moveq   #0,D3
02:000494F4 0C000008        	  5824:     cmpi.b  #$08,D0
02:000494F8 6706            	  5825:     beq  _anon_z07_31
02:000494FA 7600            	  5826:     moveq   #0,D3
02:000494FC 162C0675        	  5827:     move.b  ($0675,A4),D3
