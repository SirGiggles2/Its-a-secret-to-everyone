                            	  7283: _L_z07_InitObject_InitMonsterFromEdge:
02:0004A052 7400            	  7284:     moveq   #0,D2
02:0004A054 142C0340        	  7285:     move.b  ($0340,A4),D2
                            	  7286:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7287:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7288:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7289:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7290:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7291:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7292:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7293:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7294:     ; corrupting them and causing a deterministic address-error
                            	  7295:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7296:     ; identified by Codex static review.)
                            	  7297: _L_z07_P47_pre_check:
02:0004A058 102C0525        	  7298:     move.b  ($0525,A4),D0
02:0004A05C 020000F0        	  7299:     andi.b  #$F0,D0
02:0004A060 0C000040        	  7300:     cmpi.b  #$40,D0
02:0004A064 6506            	  7301:     blo     _L_z07_P47_pre_snap
02:0004A066 0C0000E0        	  7302:     cmpi.b  #$E0,D0
02:0004A06A 6506            	  7303:     blo     _L_z07_P47_pre_ok
                            	  7304: _L_z07_P47_pre_snap:
02:0004A06C 197C00480525    	  7305:     move.b  #$48,($0525,A4)
                            	  7306: _L_z07_P47_pre_ok:
02:0004A072 7005            	  7307:     moveq   #5,D0
02:0004A074 610004F4        	  7308:     jsr     SwitchBank
02:0004A078 4EB90003EC94    	  7309:     jsr     FindNextEdgeSpawnCell
                            	  7310:     ; Post-walk 1: bottom-edge snap.
02:0004A07E 102C0525        	  7311:     move.b  ($0525,A4),D0
02:0004A082 020000F0        	  7312:     andi.b  #$F0,D0
02:0004A086 0C0000E0        	  7313:     cmpi.b  #$E0,D0
02:0004A08A 660C            	  7314:     bne     _L_z07_P47_post1_ok
02:0004A08C 197C00480525    	  7315:     move.b  #$48,($0525,A4)
02:0004A092 4EB90003EC94    	  7316:     jsr     FindNextEdgeSpawnCell
                            	  7317: _L_z07_P47_post1_ok:
                            	  7318:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7319:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004A098 7600            	  7320:     moveq   #0,D3
02:0004A09A 162C0525        	  7321:     move.b  ($0525,A4),D3
02:0004A09E 0243000F        	  7322:     andi.w  #$000F,D3
02:0004A0A2 C6FC002C        	  7323:     mulu.w  #44,D3
02:0004A0A6 203C00FF6530    	  7324:     move.l  #$FF6530,D0
02:0004A0AC D083            	  7325:     add.l   D3,D0
02:0004A0AE 7600            	  7326:     moveq   #0,D3
02:0004A0B0 162C0525        	  7327:     move.b  ($0525,A4),D3
02:0004A0B4 E84B            	  7328:     lsr.w   #4,D3
02:0004A0B6 5943            	  7329:     subi.w  #4,D3
02:0004A0B8 E34B            	  7330:     lsl.w   #1,D3
02:0004A0BA D083            	  7331:     add.l   D3,D0
02:0004A0BC 2040            	  7332:     movea.l D0,A0
02:0004A0BE 1010            	  7333:     move.b  (A0),D0
02:0004A0C0 0C000084        	  7334:     cmpi.b  #$84,D0
02:0004A0C4 6544            	  7335:     blo     _L_z07_P47_post2_ok
                            	  7336:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7337:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7338:     ; writes to the $05xx region.
02:0004A0C6 7800            	  7339:     moveq   #0,D4
                            	  7340: _L_z07_P47_fb_loop:
02:0004A0C8 41FAE4E8        	  7341:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004A0CC 12304000        	  7342:     move.b  (A0,D4.W),D1
02:0004A0D0 19410525        	  7343:     move.b  D1,($0525,A4)
                            	  7344:     ; Validate fallback cell walkable.
02:0004A0D4 7600            	  7345:     moveq   #0,D3
02:0004A0D6 1601            	  7346:     move.b  D1,D3
02:0004A0D8 0243000F        	  7347:     andi.w  #$000F,D3
02:0004A0DC C6FC002C        	  7348:     mulu.w  #44,D3
02:0004A0E0 203C00FF6530    	  7349:     move.l  #$FF6530,D0
02:0004A0E6 D083            	  7350:     add.l   D3,D0
02:0004A0E8 7600            	  7351:     moveq   #0,D3
02:0004A0EA 1601            	  7352:     move.b  D1,D3
02:0004A0EC E84B            	  7353:     lsr.w   #4,D3
02:0004A0EE 5943            	  7354:     subi.w  #4,D3
02:0004A0F0 E34B            	  7355:     lsl.w   #1,D3
02:0004A0F2 D083            	  7356:     add.l   D3,D0
02:0004A0F4 2040            	  7357:     movea.l D0,A0
02:0004A0F6 0C100084        	  7358:     cmpi.b  #$84,(A0)
02:0004A0FA 650E            	  7359:     blo     _L_z07_P47_post2_ok
02:0004A0FC 5204            	  7360:     addq.b  #1,D4
02:0004A0FE 0C040008        	  7361:     cmpi.b  #8,D4
02:0004A102 65C4            	  7362:     blo     _L_z07_P47_fb_loop
                            	  7363:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7364:     ; rather than looping).
02:0004A104 197C00480525    	  7365:     move.b  #$48,($0525,A4)
                            	  7366: _L_z07_P47_post2_ok:
                            	  7367:     ; Extract and set the monster's location.
                            	  7368:     ;
02:0004A10A 102C0525        	  7369:     move.b  ($0525,A4),D0
                            	  7370:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7371:     ;
02:0004A10E 1B00            	  7372:     move.b  D0,-(A5)  ; PHA
02:0004A110 E308            	  7373:     lsl.b  #1,D0   ; ASL A
02:0004A112 E308            	  7374:     lsl.b  #1,D0   ; ASL A
02:0004A114 E308            	  7375:     lsl.b  #1,D0   ; ASL A
02:0004A116 E308            	  7376:     lsl.b  #1,D0   ; ASL A
02:0004A118 19802070        	  7377:     move.b  D0,($70,A4,D2.W)
                            	  7378:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7379:     ;
02:0004A11C 101D            	  7380:     move.b  (A5)+,D0  ; PLA
02:0004A11E 020000F0        	  7381:     andi.b #$F0,D0
02:0004A122 003C0011        	  7382:     ori     #$11,CCR  ; SEC: set C+X
02:0004A126 123C0003        	  7383:     move.b  #$03,D1
02:0004A12A 0A3C0010        	  7384:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A12E 9101            	  7385:     subx.b  D1,D0   ; SBC #$03
02:0004A130 0A3C0010        	  7386:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A134 41EC0084        	  7387:     lea     ($0084,A4),A0
02:0004A138 11802000        	  7388:     move.b  D0,(A0,D2.W)
                            	  7389:     ; Set the monsters-from-edges long timer to a random value
                            	  7390:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7391:     ;
02:0004A13C 10342019        	  7392:     move.b  ($19,A4,D2.W),D0
02:0004A140 02000003        	  7393:     andi.b #$03,D0
02:0004A144 023C00EE        	  7394:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A148 123C0002        	  7395:     move.b  #$02,D1
02:0004A14C D101            	  7396:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004A14E 1940004B        	  7397:     move.b  D0,($004B,A4)
