02:0003D4D4 E208            	   834:     lsr.b  #1,D0   ; LSR A
02:0003D4D6 122C0098        	   835:     move.b  ($0098,A4),D1
02:0003D4DA C200            	   836:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
