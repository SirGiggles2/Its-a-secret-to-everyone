                            	  8614:     ; ((current menu scrolling value) / 2) - $D
                            	  8615:     ;
02:000420A2 102C005E        	  8616:     move.b  ($005E,A4),D0
02:000420A6 003C0011        	  8617:     ori     #$11,CCR  ; SEC: set C+X
02:000420AA 123C001A        	  8618:     move.b  #$1A,D1
02:000420AE 0A3C0010        	  8619:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000420B2 9101            	  8620:     subx.b  D1,D0   ; SBC #$1A
02:000420B4 0A3C0010        	  8621:     eori    #$10,CCR  ; restore X = 6502 C
02:000420B8 E208            	  8622:     lsr.b  #1,D0   ; LSR A
02:000420BA 7400            	  8623:     moveq   #0,D2
02:000420BC 1400            	  8624:     move.b  D0,D2
02:000420BE 760F            	  8625:     moveq   #15,D3
                            	  8626:     even
                            	  8627: _L_z05_Submenu_WriteSheetMapRowTransferRecord_MaskRooms:
                            	  8628:     ; For each element ($10) in the row, starting from $F:
                            	  8629:     ; If the current row is set in the submenu map mask,
                            	  8630:     ; then replace the tile with $F5, a blank map tile.
                            	  8631:     ;
02:000420C0 41F900FF6BBD    	  8632:     lea     (NES_SRAM+$0BBD).l,A0
02:000420C6 10303000        	  8633:     move.b  (A0,D3.W),D0
02:000420CA 41F900042000    	  8634:     lea     (MapRowMasks).l,A0
02:000420D0 12302000        	  8635:     move.b  (A0,D2.W),D1
02:000420D4 C001            	  8636:     and.b  D1,D0
02:000420D6 660C            	  8637:     bne  _anon_z05_201
02:000420D8 103C00F5        	  8638:     move.b  #$F5,D0
02:000420DC 41EC0305        	  8639:     lea     ($0305,A4),A0
02:000420E0 11803000        	  8640:     move.b  D0,(A0,D3.W)
                            	  8641: _anon_z05_201:
02:000420E4 5303            	  8642:     subq.b  #1,D3
