02:00030D24 41F900030A74    	  2158:     lea     (ObjAnimations).l,A0
02:00030D2A 10303000        	  2159:     move.b  (A0,D3.W),D0
02:00030D2E 023C00EE        	  2160:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030D32 122C000D        	  2161:     move.b  ($000D,A4),D1
02:00030D36 D101            	  2162:     addx.b  D1,D0   ; ADC $0D
02:00030D38 7600            	  2163:     moveq   #0,D3
02:00030D3A 1600            	  2164:     move.b  D0,D3
02:00030D3C 41F900030AF4    	  2165:     lea     (ObjAnimFrameHeap).l,A0
02:00030D42 10303000        	  2166:     move.b  (A0,D3.W),D0
02:00030D46 19400002        	  2167:     move.b  D0,($0002,A4)
02:00030D4A 023C00EE        	  2168:     andi    #$EE,CCR  ; CLC: clear C+X
