02:00048EDE 10343070        	  4944:     move.b  ($70,A4,D3.W),D0
02:00048EE2 19802070        	  4945:     move.b  D0,($70,A4,D2.W)
02:00048EE6 41EC0084        	  4946:     lea     ($0084,A4),A0
02:00048EEA 10303000        	  4947:     move.b  (A0,D3.W),D0
02:00048EEE 41EC0084        	  4948:     lea     ($0084,A4),A0
02:00048EF2 11802000        	  4949:     move.b  D0,(A0,D2.W)
02:00048EF6 41EC0098        	  4950:     lea     ($0098,A4),A0
02:00048EFA 10303000        	  4951:     move.b  (A0,D3.W),D0
02:00048EFE 41EC0098        	  4952:     lea     ($0098,A4),A0
02:00048F02 11802000        	  4953:     move.b  D0,(A0,D2.W)
