02:00042232 41F900047A04    	  8837:     lea     (LevelMasks).l,A0
02:00042238 12302000        	  8838:     move.b  (A0,D2.W),D1
02:0004223C C001            	  8839:     and.b  D1,D0
02:0004223E 670A            	  8840:     beq  _anon_z05_206
02:00042240 122C00EE        	  8841:     move.b  ($00EE,A4),D1
02:00042244 8001            	  8842:     or.b  D1,D0
