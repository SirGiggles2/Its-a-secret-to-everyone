                            	  2336: _L_z04_UpdateOctorock_SaveOffset:
02:00039198 1B00            	  2337:     move.b  D0,-(A5)  ; PHA
                            	  2338:     ; Decrement the animation counter, and roll over if needed.
                            	  2339:     ;
02:0003919A 41EC03D0        	  2340:     lea     ($03D0,A4),A0
02:0003919E 53302000        	  2341:     subq.b  #1,(A0,D2.W)
02:000391A2 661E            	  2342:     bne  _L_z04_UpdateOctorock_CalcFinalOffset
02:000391A4 7006            	  2343:     moveq   #6,D0
02:000391A6 41EC03D0        	  2344:     lea     ($03D0,A4),A0
02:000391AA 11802000        	  2345:     move.b  D0,(A0,D2.W)
                            	  2346:     ; There are actually 6 frame images divided into 2 sets.
                            	  2347:     ; Each set depicts one animation frame. In each set there are
                            	  2348:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  2349:     ;
                            	  2350:     ; The movement frame will keep track of the base offset of
                            	  2351:     ; the current set for the current animation frame: 0 or 3.
                            	  2352:     ;
                            	  2353:     ; So, XOR the movement frame with 3.
                            	  2354:     ;
02:000391AE E208            	  2355:     lsr.b  #1,D0   ; LSR A
02:000391B0 41EC03E4        	  2356:     lea     ($03E4,A4),A0
02:000391B4 12302000        	  2357:     move.b  (A0,D2.W),D1
02:000391B8 B300            	  2358:     eor.b  D1,D0
02:000391BA 41EC03E4        	  2359:     lea     ($03E4,A4),A0
02:000391BE 11802000        	  2360:     move.b  D0,(A0,D2.W)
                            	  2361:     even
                            	  2362: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  2363:     ; Add the base offset and the directional offset, and save the result.
                            	  2364:     ;
02:000391C2 101D            	  2365:     move.b  (A5)+,D0  ; PLA
02:000391C4 023C00EE        	  2366:     andi    #$EE,CCR  ; CLC: clear C+X
02:000391C8 41EC03E4        	  2367:     lea     ($03E4,A4),A0
02:000391CC 12302000        	  2368:     move.b  (A0,D2.W),D1
02:000391D0 D101            	  2369:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000391D2 1B00            	  2370:     move.b  D0,-(A5)  ; PHA
                            	  2371:     ; If facing vertically, go draw mirrored.
                            	  2372:     ;
02:000391D4 41EC0098        	  2373:     lea     ($0098,A4),A0
02:000391D8 10302000        	  2374:     move.b  (A0,D2.W),D0
02:000391DC 0200000C        	  2375:     andi.b #$0C,D0
02:000391E0 660E            	  2376:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  2377:     ; Else draw not mirrored.
                            	  2378:     ;
02:000391E2 101D            	  2379:     move.b  (A5)+,D0  ; PLA
02:000391E4 4EB900030CC4    	  2380:     jsr     DrawObjectNotMirrored
02:000391EA 4EF900031030    	  2381:     jmp     CheckMonsterCollisions
                            	  2382: 
                            	  2383:     even
