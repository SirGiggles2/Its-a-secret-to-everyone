                            	   346: _L_z04_Exit_SetDirTowardTarget:
                            	   347:     ; Set the monster's facing direction to the chosen direction
                            	   348:     ; toward the chase target.
                            	   349:     ;
02:00038380 41EC0098        	   350:     lea     ($0098,A4),A0
02:00038384 11832000        	   351:     move.b  D3,(A0,D2.W)
                            	   352:     ; Set turn timer to a random value.
                            	   353:     ;
02:00038388 10342018        	   354:     move.b  ($18,A4,D2.W),D0
02:0003838C 41EC0478        	   355:     lea     ($0478,A4),A0
02:00038390 11802000        	   356:     move.b  D0,(A0,D2.W)
                            	   357:     ; Set "wants to shoot" flag to 1.
                            	   358:     ;
02:00038394 7001            	   359:     moveq   #1,D0
02:00038396 41EC0412        	   360:     lea     ($0412,A4),A0
02:0003839A 11802000        	   361:     move.b  D0,(A0,D2.W)
                            	   362:     ; Go set input direction to facing direction.
                            	   363:     ;
02:0003839E 602E            	   364:     jmp     L_Walker_SetInputDirAndTryShootingBoomerang
                            	   365: 
                            	   366:     even
                            	   367: _L_z04_Exit_TurnIfTime:
                            	   368:     ; Reset "wants to shoot" flag.
                            	   369:     ;
02:000383A0 7000            	   370:     moveq   #0,D0
02:000383A2 41EC0412        	   371:     lea     ($0412,A4),A0
02:000383A6 11802000        	   372:     move.b  D0,(A0,D2.W)
                            	   373:     ; If turn timer <> 0, then go set input direction to facing direction.
                            	   374:     ;
02:000383AA 41EC0478        	   375:     lea     ($0478,A4),A0
02:000383AE 10302000        	   376:     move.b  (A0,D2.W),D0
02:000383B2 6612            	   377:     bne  _L_z04_Exit_SetInputDir
                            	   378:     ; Turn toward the chase target in a direction perpendicular to
                            	   379:     ; facing direction.
                            	   380:     ;
                            	   381:     ; If facing vertically, then go choose a horizontal direction
                            	   382:     ; toward the chase target.
                            	   383:     ;
                            	   384:     ; Else go choose a vertical direction toward the chase target.
                            	   385:     ;
02:000383B4 41EC0098        	   386:     lea     ($0098,A4),A0
02:000383B8 10302000        	   387:     move.b  (A0,D2.W),D0
02:000383BC 0200000C        	   388:     andi.b #$0C,D0
02:000383C0 66AE            	   389:     bne  _L_z04_Exit_TurnHorizontally
02:000383C2 6700FF68        	   390:     beq  _L_z04_Exit_TurnVertically
                            	   391:     even
