                            	  5612: _L_z07_CheckState30_CheckOtherStates:
                            	  5613:     ; State $40 or $50. Return to thrower: $40 slow, $50 fast.
                            	  5614:     ;
                            	  5615:     ; The boomerang will now return. Reset the grid offset.
                            	  5616:     ;
02:00049364 7000            	  5617:     moveq   #0,D0
02:00049366 41EC0394        	  5618:     lea     ($0394,A4),A0
02:0004936A 11802000        	  5619:     move.b  D0,(A0,D2.W)
                            	  5620:     ; Get the horizontal and vertical directions and distances to the thrower.
                            	  5621:     ;
02:0004936E 0C02000D        	  5622:     cmpi.b  #$0D,D2
02:00049372 6408            	  5623:     bcc  _anon_z07_30
02:00049374 41EC042C        	  5624:     lea     ($042C,A4),A0
02:00049378 10302000        	  5625:     move.b  (A0,D2.W),D0
                            	  5626: _anon_z07_30:
02:0004937C 4EB900030904    	  5627:     jsr     GetDirectionsAndDistancesToTarget
                            	  5628:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5629:     ; then go move towards the thrower, draw, and check collisions.
                            	  5630:     ;
02:00049382 1014            	  5631:     move.b  ($0000,A4),D0
02:00049384 0C000002        	  5632:     cmpi.b  #$02,D0
02:00049388 666A            	  5633:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5634:     ; The boomerang has reached the thrower.
                            	  5635:     ;
                            	  5636:     ; Reset the distance to move.
                            	  5637:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5638:     ;
02:0004938A 7000            	  5639:     moveq   #0,D0
02:0004938C 41EC0380        	  5640:     lea     ($0380,A4),A0
02:00049390 11802000        	  5641:     move.b  D0,(A0,D2.W)
02:00049394 0C02000D        	  5642:     cmpi.b  #$0D,D2
02:00049398 6524            	  5643:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5644:     ; Link has caught the boomerang.
                            	  5645:     ;
                            	  5646:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5647:     ;
                            	  5648:     ; If Link catches it some time after throwing it,
                            	  5649:     ; his state will become $20, and he will show the catch animation.
                            	  5650:     ;
                            	  5651:     ; But if he catches it right after throwing it, the state becomes
                            	  5652:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5653:     ;
02:0004939A 102C00AC        	  5654:     move.b  ($00AC,A4),D0
02:0004939E 00000020        	  5655:     ori.b #$20,D0
02:000493A2 194000AC        	  5656:     move.b  D0,($00AC,A4)
                            	  5657:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5658:     ; up the new state.
                            	  5659:     ;
02:000493A6 7001            	  5660:     moveq   #1,D0
02:000493A8 194003D0        	  5661:     move.b  D0,($03D0,A4)
                            	  5662:     ; Deactivate the boomerang.
                            	  5663:     ;
02:000493AC 760F            	  5664:     moveq   #15,D3
02:000493AE 7000            	  5665:     moveq   #0,D0
02:000493B0 41EC00AC        	  5666:     lea     ($00AC,A4),A0
02:000493B4 11803000        	  5667:     move.b  D0,(A0,D3.W)
02:000493B8 0A3C0001        	  5668:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000493BC 4E75            	  5669:     rts
                            	  5670: 
                            	  5671:     even
                            	  5672: _L_z07_CheckState30_CatchBoomerang:
                            	  5673:     ; A monster caught the boomerang that it threw.
                            	  5674:     ;
                            	  5675:     ; Set a timer for the thrower based on a random value:
                            	  5676:     ; < $30: $30
                            	  5677:     ; < $70: $50
                            	  5678:     ; Else:  $70
                            	  5679:     ;
02:000493BE 7630            	  5680:     moveq   #48,D3
02:000493C0 10342018        	  5681:     move.b  ($18,A4,D2.W),D0
02:000493C4 0C000030        	  5682:     cmpi.b  #$30,D0
02:000493C8 650A            	  5683:     bcs  _L_z07_CheckState30_SetThrowerTimer
