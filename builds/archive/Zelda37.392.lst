                            	  2002: _anon_z04_42:
                            	  2003:     ; State 0.
                            	  2004:     ;
                            	  2005:     ; In state we determine whether to burst out of the ground.
                            	  2006:     ; If the long timer has not expired, then return.
                            	  2007:     ;
02:00038F1C 102C004D        	  2008:     move.b  ($004D,A4),D0
02:00038F20 6674            	  2009:     bne  _L_z04_UpdateRedLeever_Exit
                            	  2010:     ; Only allow two red leevers at a time.
                            	  2011:     ;
02:00038F22 102C0510        	  2012:     move.b  ($0510,A4),D0
02:00038F26 0C000002        	  2013:     cmpi.b  #$02,D0
02:00038F2A 646A            	  2014:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2015:     ; Face in the same direction as Link.
                            	  2016:     ;
02:00038F2C 102C0098        	  2017:     move.b  ($0098,A4),D0
02:00038F30 41EC0098        	  2018:     lea     ($0098,A4),A0
02:00038F34 11802000        	  2019:     move.b  D0,(A0,D2.W)
                            	  2020:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  2021:     ;
02:00038F38 10342019        	  2022:     move.b  ($19,A4,D2.W),D0
02:00038F3C 0C0000C0        	  2023:     cmpi.b  #$C0,D0
02:00038F40 6506            	  2024:     bcs  _anon_z04_43
02:00038F42 4EB900048B08    	  2025:     jsr     ReverseObjDir
                            	  2026: _anon_z04_43:
                            	  2027:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  2028:     ;
02:00038F48 41EC0098        	  2029:     lea     ($0098,A4),A0
02:00038F4C 10302000        	  2030:     move.b  (A0,D2.W),D0
02:00038F50 0200000C        	  2031:     andi.b #$0C,D0
02:00038F54 6742            	  2032:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  2033:     ; Begin with the leever's X set to Link's X.
                            	  2034:     ;
02:00038F56 102C0070        	  2035:     move.b  ($0070,A4),D0
02:00038F5A 19802070        	  2036:     move.b  D0,($70,A4,D2.W)
                            	  2037:     ; If facing down, then use Y offset $28.
                            	  2038:     ; Else store Y offset -$28 in [00].
                            	  2039:     ;
02:00038F5E 7628            	  2040:     moveq   #40,D3
02:00038F60 41EC0098        	  2041:     lea     ($0098,A4),A0
02:00038F64 10302000        	  2042:     move.b  (A0,D2.W),D0
02:00038F68 02000008        	  2043:     andi.b #$08,D0
02:00038F6C 6704            	  2044:     beq  _anon_z04_44
02:00038F6E 163C00D8        	  2045:     move.b  #$D8,D3
                            	  2046: _anon_z04_44:
02:00038F72 1883            	  2047:     move.b  D3,($0000,A4)
                            	  2048:     ; Add Link's Y and the vertical offset.
                            	  2049:     ;
02:00038F74 102C0084        	  2050:     move.b  ($0084,A4),D0
02:00038F78 023C00EE        	  2051:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038F7C 1214            	  2052:     move.b  ($0000,A4),D1
02:00038F7E D101            	  2053:     addx.b  D1,D0   ; ADC $00
                            	  2054:     ; Sanitize the Y coordinate:
                            	  2055:     ; (Y AND $F0) OR $D
                            	  2056:     ;
02:00038F80 020000F0        	  2057:     andi.b #$F0,D0
02:00038F84 0000000D        	  2058:     ori.b #$0D,D0
02:00038F88 41EC0084        	  2059:     lea     ($0084,A4),A0
02:00038F8C 11802000        	  2060:     move.b  D0,(A0,D2.W)
                            	  2061:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  2062:     ; go see if the tile is valid to come out of.
                            	  2063:     ;
                            	  2064:     ; Else it's too close to the top edge of the screen. So, return.
                            	  2065:     ;
02:00038F90 0C00005D        	  2066:     cmpi.b  #$5D,D0
02:00038F94 647A            	  2067:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  2068:     even
                            	  2069: _L_z04_UpdateRedLeever_Exit:
