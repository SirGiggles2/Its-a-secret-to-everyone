02:00042684 48E7E080        	   161:     movem.l D0-D2/A0,-(SP)             ; save regs around JSR
02:00042688 4EB90002B0E6    	   162:     jsr     _transfer_tilebuf_fast      ; process pending DynTileBuf now
02:0004268E 4CDF0107        	   163:     movem.l (SP)+,D0-D2/A0             ; restore regs
02:00042692 13FC00FF00FF0302	   164:     move.b  #$FF,(NES_RAM+DynTileBuf).l ; reset sentinel
02:0004269A 703F            	   165:     moveq   #63,D0
