02:00041A3C 6030            	  7647:     jmp  L1725A_Exit
                            	  7648: __far_z_05_0084:
                            	  7649:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7650:     ; and represents the current row of the submenu being processed.
                            	  7651:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7652:     ; black tiles, or (0) a row of the map or other piece of the GUI.
                            	  7653:     ;
                            	  7654:     ; If the bottom bit is set, go prepare the full black row.
                            	  7655:     ;
02:00041A3E E208            	  7656:     lsr.b  #1,D0   ; LSR A
02:00041A40 7600            	  7657:     moveq   #0,D3
02:00041A42 1600            	  7658:     move.b  D0,D3
02:00041A44 6402            	  7659:     bcc.s  __far_z_05_0085
02:00041A46 6028            	  7660:     jmp  PrepFullBlackRow
                            	  7661: __far_z_05_0085:
