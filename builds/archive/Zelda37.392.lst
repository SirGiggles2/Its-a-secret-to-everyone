                            	  2859: PondFairy_MoveHearts:
                            	  2860:     ; Loop over each heart from object slot 2 to 9.
                            	  2861:     ;
                            	  2862:     ; Even though they are not standalone objects, their info
                            	  2863:     ; is stored in those object slots.
                            	  2864:     ;
02:000394C2 7402            	  2865:     moveq   #2,D2
                            	  2866:     even
                            	  2867: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  2868:     ; If the current heart's state <> 0, then go move it.
                            	  2869:     ; Else we have to wait for it to come out at the right time.
                            	  2870:     ;
02:000394C4 41EC00AC        	  2871:     lea     ($00AC,A4),A0
02:000394C8 10302000        	  2872:     move.b  (A0,D2.W),D0
02:000394CC 667C            	  2873:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  2874:     ; The current heart's state = 0.
                            	  2875:     ;
                            	  2876:     ; If object slot = 2, then go make it appear. This is the first
                            	  2877:     ; heart to show up.
                            	  2878:     ;
02:000394CE 0C020002        	  2879:     cmpi.b  #$02,D2
02:000394D2 6732            	  2880:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  2881:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  2882:     ; go start over.
                            	  2883:     ;
                            	  2884:     ; TODO:
                            	  2885:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  2886:     ;
02:000394D4 102C00AE        	  2887:     move.b  ($00AE,A4),D0
02:000394D8 67EA            	  2888:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  2889:     ; Look up the starting angle of this heart with the index
                            	  2890:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  2891:     ; then loop again.
                            	  2892:     ;
02:000394DA 1002            	  2893:     move.b  D2,D0
02:000394DC 003C0011        	  2894:     ori     #$11,CCR  ; SEC: set C+X
02:000394E0 123C0003        	  2895:     move.b  #$03,D1
02:000394E4 0A3C0010        	  2896:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000394E8 9101            	  2897:     subx.b  D1,D0   ; SBC #$03
02:000394EA 0A3C0010        	  2898:     eori    #$10,CCR  ; restore X = 6502 C
02:000394EE 7600            	  2899:     moveq   #0,D3
02:000394F0 1600            	  2900:     move.b  D0,D3
02:000394F2 102C0396        	  2901:     move.b  ($0396,A4),D0
02:000394F6 41F9000394BA    	  2902:     lea     (PondHeartStartAngles).l,A0
02:000394FC 12303000        	  2903:     move.b  (A0,D3.W),D1
02:00039500 B001            	  2904:     cmp.b   D1,D0
02:00039502 66000086        	  2905:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  2906:     even
                            	  2907: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  2908:     ; Set up this heart. Set its state to 1.
                            	  2909:     ;
02:00039506 41EC00AC        	  2910:     lea     ($00AC,A4),A0
02:0003950A 52302000        	  2911:     addq.b  #1,(A0,D2.W)
                            	  2912:     ; TODO: ?
                            	  2913:     ;
