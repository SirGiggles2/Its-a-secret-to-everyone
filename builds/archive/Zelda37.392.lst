02:00039E8E 610000BA        	  4173:     jsr     ControlMoldormFlight
02:00039E92 61002C36        	  4174:     jsr     MoveFlyer
                            	  4175: _anon_z04_79:
                            	  4176:     ; Draw with sprite attributes: normal, red palette row
                            	  4177:     ;
02:00039E96 7002            	  4178:     moveq   #2,D0
02:00039E98 19400003        	  4179:     move.b  D0,($0003,A4)
02:00039E9C 7044            	  4180:     moveq   #68,D0
02:00039E9E 4EB900030FC0    	  4181:     jsr     Anim_WriteSprite
                            	  4182:     ; Check collisions, but never let them interfere with movement.
                            	  4183:     ;
02:00039EA4 41EC0098        	  4184:     lea     ($0098,A4),A0
02:00039EA8 10302000        	  4185:     move.b  (A0,D2.W),D0
02:00039EAC 1B00            	  4186:     move.b  D0,-(A5)  ; PHA
02:00039EAE 10342028        	  4187:     move.b  ($28,A4,D2.W),D0
02:00039EB2 1B00            	  4188:     move.b  D0,-(A5)  ; PHA
02:00039EB4 4EB900031030    	  4189:     jsr     CheckMonsterCollisions
02:00039EBA 101D            	  4190:     move.b  (A5)+,D0  ; PLA
02:00039EBC 19802028        	  4191:     move.b  D0,($28,A4,D2.W)
02:00039EC0 101D            	  4192:     move.b  (A5)+,D0  ; PLA
02:00039EC2 41EC0098        	  4193:     lea     ($0098,A4),A0
02:00039EC6 11802000        	  4194:     move.b  D0,(A0,D2.W)
                            	  4195:     ; If this segment is still alive, then return.
                            	  4196:     ;
02:00039ECA 41EC0405        	  4197:     lea     ($0405,A4),A0
02:00039ECE 10302000        	  4198:     move.b  (A0,D2.W),D0
02:00039ED2 6774            	  4199:     beq  _L_z04_UpdateMoldorm_Exit
                            	  4200:     ; This segment is dead. We'll swap the tail segment with this
                            	  4201:     ; dead segment. This way, moldorm heads are always rooted
                            	  4202:     ; in slots 5 and $A; and the segments are continguous.
                            	  4203:     ;
                            	  4204:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  4205:     ;
                            	  4206:     ; Note that this is not a true swap, because the tail's HP
                            	  4207:     ; might be less than $20.
                            	  4208:     ;
02:00039ED4 7020            	  4209:     moveq   #32,D0
02:00039ED6 41EC0485        	  4210:     lea     ($0485,A4),A0
02:00039EDA 11802000        	  4211:     move.b  D0,(A0,D2.W)
02:00039EDE 61000608        	  4212:     jsr     CheckBossHitReaction
                            	  4213:     ; Look for the tail segment, starting from the low end
                            	  4214:     ; of the chain that this dead segment belongs to.
                            	  4215:     ;
02:00039EE2 163C00FF        	  4216:     move.b  #$FF,D3
02:00039EE6 0C020006        	  4217:     cmpi.b  #$06,D2
02:00039EEA 6502            	  4218:     bcs  _anon_z04_80
02:00039EEC 7604            	  4219:     moveq   #4,D3
                            	  4220: _anon_z04_80:
02:00039EEE 5203            	  4221:     addq.b  #1,D3
02:00039EF0 41EC0350        	  4222:     lea     ($0350,A4),A0
02:00039EF4 10303000        	  4223:     move.b  (A0,D3.W),D0
02:00039EF8 0C000041        	  4224:     cmpi.b  #$41,D0
02:00039EFC 66F0            	  4225:     bne  _anon_z04_80
                            	  4226:     ; I don't know why the object timer of the tail segment that will
                            	  4227:     ; be made dead is set to $11. By setting its object type to $5D
                            	  4228:     ; below, its metastate will become $10 -- dying/dead. From
                            	  4229:     ; there, the object timer is set to 6.
                            	  4230:     ;
02:00039EFE 7011            	  4231:     moveq   #17,D0
