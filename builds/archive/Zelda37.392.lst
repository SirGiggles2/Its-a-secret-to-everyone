02:0003B708 19802070        	  7468:     move.b  D0,($70,A4,D2.W)
                            	  7469:     ; Check object collisions in 5 parts, 8 pixels apart,
                            	  7470:     ; from left to right, indexed by [0F].
                            	  7471:     ;
02:0003B70C 7005            	  7472:     moveq   #5,D0
02:0003B70E 1940000F        	  7473:     move.b  D0,($000F,A4)
