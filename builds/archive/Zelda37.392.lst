                            	  5343: _L_z07_UpdateArrowOrBoomerang_CompareLimit:
                            	  5344:     ; For boomerangs, compare it to the movement limit.
                            	  5345:     ; If it reached the limit, set state $20 and a new movement
                            	  5346:     ; limit of $10, and go handle the rest as if blocked.
                            	  5347:     ; State $20 will become $30 below in HandleArrowOrBoomerangBlocked.
                            	  5348:     ;
                            	  5349:     ; Otherwise, only animate and check collision as usual.
                            	  5350:     ;
                            	  5351:     ; In major state $30, ObjMovingLimit is a timer to change the state to $40.
                            	  5352:     ;
02:00049198 41EC0380        	  5353:     lea     ($0380,A4),A0
02:0004919C 12302000        	  5354:     move.b  (A0,D2.W),D1
02:000491A0 B001            	  5355:     cmp.b   D1,D0
02:000491A2 6518            	  5356:     bcs  _L_z07_UpdateArrowOrBoomerang_AnimateBoomerang
02:000491A4 7010            	  5357:     moveq   #16,D0
02:000491A6 41EC0380        	  5358:     lea     ($0380,A4),A0
02:000491AA 11802000        	  5359:     move.b  D0,(A0,D2.W)
02:000491AE 7020            	  5360:     moveq   #32,D0
02:000491B0 41EC00AC        	  5361:     lea     ($00AC,A4),A0
