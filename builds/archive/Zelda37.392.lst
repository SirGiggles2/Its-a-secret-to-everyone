02:0004A02E 41EC0084        	  7266:     lea     ($0084,A4),A0
02:0004A032 10302000        	  7267:     move.b  (A0,D2.W),D0
02:0004A036 671A            	  7268:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7269:     even
