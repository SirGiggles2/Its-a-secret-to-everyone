02:00041242 4EB90002A9FA    	  6977:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
02:00041248 4EB900030952    	  6978:     jsr     GetShortcutOrItemXY
                            	  6979:     ; Divide X coordinate by 4 to get offset into column address table.
