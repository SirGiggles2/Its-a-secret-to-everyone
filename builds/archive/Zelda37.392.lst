02:000493CC 0C000070        	  5685:     cmpi.b  #$70,D0
02:000493D0 6502            	  5686:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:000493D2 7670            	  5687:     moveq   #112,D3
                            	  5688:     even
                            	  5689: _L_z07_CheckState30_SetThrowerTimer:
02:000493D4 1003            	  5690:     move.b  D3,D0
02:000493D6 7600            	  5691:     moveq   #0,D3
02:000493D8 41EC042C        	  5692:     lea     ($042C,A4),A0
02:000493DC 16302000        	  5693:     move.b  (A0,D2.W),D3
02:000493E0 19803028        	  5694:     move.b  D0,($28,A4,D3.W)
                            	  5695:     ; Reset the thrower's state to make it idle or restart its state machine.
                            	  5696:     ; Destroy the monster's boomerang.
                            	  5697:     ;
02:000493E4 7000            	  5698:     moveq   #0,D0
