02:0003984C 41EC0098        	  3607:     lea     ($0098,A4),A0
02:00039850 10302000        	  3608:     move.b  (A0,D2.W),D0
02:00039854 02000002        	  3609:     andi.b #$02,D0
02:00039858 6704            	  3610:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
                            	  3611:     even
