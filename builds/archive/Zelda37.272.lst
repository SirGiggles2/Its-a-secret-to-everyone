                            	  1481:     ;
02:00030362 41EC0098        	  1482:     lea     ($0098,A4),A0
02:00030366 10302000        	  1483:     move.b  (A0,D2.W),D0
02:0003036A 6100013C        	  1484:     jsr     GetOppositeDir
02:0003036E 41EC0098        	  1485:     lea     ($0098,A4),A0
02:00030372 11802000        	  1486:     move.b  D0,(A0,D2.W)
02:00030376 7020            	  1487:     moveq   #32,D0
02:00030378 41EC03BC        	  1488:     lea     ($03BC,A4),A0
02:0003037C 11802000        	  1489:     move.b  D0,(A0,D2.W)
02:00030380 41EC00AC        	  1490:     lea     ($00AC,A4),A0
02:00030384 52302000        	  1491:     addq.b  #1,(A0,D2.W)
