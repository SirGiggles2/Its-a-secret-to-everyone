02:00035352 102C050A        	  5428:     move.b  ($050A,A4),D0
02:00035356 0200001F        	  5429:     andi.b #$1F,D0
02:0003535A E308            	  5430:     lsl.b  #1,D0   ; ASL A
                            	  5431:     ; Add the offset to the low byte of attribute space base
