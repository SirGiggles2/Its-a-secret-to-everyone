                            	 12102:     ;
02:0003D6CC 7600            	 12103:     moveq   #0,D3
02:0003D6CE 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003D6D2 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003D6D6 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003D6DA 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003D6DE 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003D6E0 41F90003D5D2    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003D6E6 10303000        	 12114:     move.b  (A0,D3.W),D0
02:0003D6EA 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003D6EC 41F90003D5D6    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003D6F2 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003D6F6 7600            	 12118:     moveq   #0,D3
