02:00039512 646A            	  3162:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3163:     ; Face in the same direction as Link.
                            	  3164:     ;
02:00039514 102C0098        	  3165:     move.b  ($0098,A4),D0
02:00039518 41EC0098        	  3166:     lea     ($0098,A4),A0
02:0003951C 11802000        	  3167:     move.b  D0,(A0,D2.W)
                            	  3168:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3169:     ;
02:00039520 10342019        	  3170:     move.b  ($19,A4,D2.W),D0
02:00039524 0C0000C0        	  3171:     cmpi.b  #$C0,D0
02:00039528 6506            	  3172:     bcs  _anon_z04_43
02:0003952A 4EB900049FE4    	  3173:     jsr     ReverseObjDir
                            	  3174: _anon_z04_43:
                            	  3175:     ; If facing horizontally, go place the leever to the left or right of Link.
