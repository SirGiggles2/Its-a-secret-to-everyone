                            	   539: UpdateMenuStartOW:
                            	   540:     ; Put the tiles into the submenu triforce transfer buffers that
                            	   541:     ; make it look completely empty, and no piece has been won.
                            	   542:     ;
02:0003E7EA 7617            	   543:     moveq   #23,D3
                            	   544: _anon_z05_6:
02:0003E7EC 7400            	   545:     moveq   #0,D2
02:0003E7EE 41F90003E7A2    	   546:     lea     (TriforceTransferBufOffsets).l,A0
02:0003E7F4 14303000        	   547:     move.b  (A0,D3.W),D2
02:0003E7F8 41F90003E7D2    	   548:     lea     (TriforceTransferBufTiles).l,A0
02:0003E7FE 10303000        	   549:     move.b  (A0,D3.W),D0
02:0003E802 41F9000457FA    	   550:     lea     (TriforceRow0TransferBuf+4).l,A0
02:0003E808 11802000        	   551:     move.b  D0,(A0,D2.W)
02:0003E80C 5303            	   552:     subq.b  #1,D3
02:0003E80E 6ADC            	   553:     bpl  _anon_z05_6
                            	   554:     ; Reset triforce tile slot. These range from 0 to $17.
                            	   555:     ;
02:0003E810 5203            	   556:     addq.b  #1,D3
                            	   557:     ; Outer loop.
                            	   558:     ; A level test bit in [06] will be used to see whether
                            	   559:     ; we have a triforce piece.
                            	   560:     ;
02:0003E812 7001            	   561:     moveq   #1,D0
02:0003E814 19400006        	   562:     move.b  D0,($0006,A4)
                            	   563:     even
                            	   564: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   565:     ; Inner loop.
                            	   566:     ; Each level bit will make 3 triforce tile slots be
                            	   567:     ; checked and replaced.
                            	   568:     ;
02:0003E818 7003            	   569:     moveq   #3,D0
02:0003E81A 19400007        	   570:     move.b  D0,($0007,A4)
                            	   571:     even
                            	   572: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   573:     ; Get the offset into the submenu triforce transfer buffers of
                            	   574:     ; the current tile slot.
                            	   575:     ;
02:0003E81E 7400            	   576:     moveq   #0,D2
02:0003E820 41F90003E7A2    	   577:     lea     (TriforceTransferBufOffsets).l,A0
02:0003E826 14303000        	   578:     move.b  (A0,D3.W),D2
                            	   579:     ; If the level test bit is not in the triforce mask, then we don't
                            	   580:     ; have this piece. So, go loop again, and leave the tile in the
                            	   581:     ; empty state.
                            	   582:     ;
                            	   583:     ;
                            	   584:     ; [06] level test mask
