02:0004B6A2 1600            	  7505:     move.b  D0,D3
02:0004B6A4 41F90004B1D8    	  7506:     lea     (ObjectTypeToHpPairs).l,A0
02:0004B6AA 10303000        	  7507:     move.b  (A0,D3.W),D0
