02:00041C50 0C000007        	  5760:     cmpi.b  #$07,D0
02:00041C54 6704            	  5761:     beq  _anon_z05_120
02:00041C56 6000009C        	  5762:     jmp     L_ResetDoorCmdAndLayOutDoors
