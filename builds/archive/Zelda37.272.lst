                            	  5544:     ; randomly and set timer to $10.
                            	  5545:     ;
02:0003A66A 7001            	  5546:     moveq   #1,D0
02:0003A66C 19400431        	  5547:     move.b  D0,($0431,A4)
02:0003A670 19400436        	  5548:     move.b  D0,($0436,A4)
02:0003A674 103C0080        	  5549:     move.b  #$80,D0
02:0003A678 194004D1        	  5550:     move.b  D0,($04D1,A4)
02:0003A67C 7008            	  5551:     moveq   #8,D0
02:0003A67E 1940034E        	  5552:     move.b  D0,($034E,A4)
