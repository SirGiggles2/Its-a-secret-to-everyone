02:00038854 0C00002B        	  1311:     cmpi.b  #$2B,D0
02:00038858 6608            	  1312:     bne  _L_z04_UpdateBubble_BlockOrUnblock
                            	  1313:     ; Else the flashing bubble blocks the sword temporarily.
