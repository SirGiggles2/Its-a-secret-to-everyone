                            	  2020: 
                            	  2021: ; Each byte describes an item. The high nibble is the type.
                            	  2022: ; The low nibble is the value. Its meaning depends on the type.
                            	  2023: ;
                            	  2024: ; 0x - individuals
                            	  2025: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  2026: ; * bit mask: value doesn't matter.
                            	  2027: ;
                            	  2028: ; 1x - amounts
                            	  2029: ; Value is an amount to add.
                            	  2030: ;
                            	  2031: ; 2x - grades
                            	  2032: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  2033: ;
                            	  2034: ; 3x - error?
                            	  2035: ; Produces an item value of $FF.
                            	  2036: ;
                            	  2037:     even
