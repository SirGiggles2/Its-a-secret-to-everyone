                            	  5135: DrawCredits:
                            	  5136:     ; Make a transfer record of a full row of blank tiles.
                            	  5137:     ;
02:00035106 761F            	  5138:     moveq   #31,D3
02:00035108 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
02:0003510A 41EC0305        	  5141:     lea     ($0305,A4),A0
02:0003510E 11803000        	  5142:     move.b  D0,(A0,D3.W)
02:00035112 5303            	  5143:     subq.b  #1,D3
02:00035114 6AF4            	  5144:     bpl  _anon_z02_41
                            	  5145:     ; No wall tiles go in row 0.
                            	  5146:     ;
02:00035116 102C050A        	  5147:     move.b  ($050A,A4),D0
02:0003511A 672C            	  5148:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  5149:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  5150:     ; Rows 2 to $2D get side walls.
                            	  5151:     ;
02:0003511C 0C000001        	  5152:     cmpi.b  #$01,D0
02:00035120 6708            	  5153:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:00035122 0C00002E        	  5154:     cmpi.b  #$2E,D0
02:00035126 6514            	  5155:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00035128 661E            	  5156:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  5157:     even
                            	  5158: _L_z02_DrawCredits_WriteHorizontalWalls:
02:0003512A 7619            	  5159:     moveq   #25,D3
02:0003512C 103C00FA        	  5160:     move.b  #$FA,D0
                            	  5161: _anon_z02_42:
02:00035130 41EC0308        	  5162:     lea     ($0308,A4),A0
02:00035134 11803000        	  5163:     move.b  D0,(A0,D3.W)
02:00035138 5303            	  5164:     subq.b  #1,D3
02:0003513A 6AF4            	  5165:     bpl  _anon_z02_42
                            	  5166:     even
                            	  5167: _L_z02_DrawCredits_WriteSideWalls:
02:0003513C 103C00FA        	  5168:     move.b  #$FA,D0
02:00035140 19400308        	  5169:     move.b  D0,($0308,A4)
02:00035144 19400321        	  5170:     move.b  D0,($0321,A4)
                            	  5171:     even
                            	  5172: _L_z02_DrawCredits_TerminateRecords:
                            	  5173:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  5174:     ; attributes or only tiles.
                            	  5175:     ;
02:00035148 103C00FF        	  5176:     move.b  #$FF,D0
02:0003514C 19400325        	  5177:     move.b  D0,($0325,A4)
02:00035150 19400330        	  5178:     move.b  D0,($0330,A4)
                            	  5179:     ; Specify that we're transferring $20 bytes/tiles.
                            	  5180:     ;
02:00035154 7020            	  5181:     moveq   #32,D0
02:00035156 19400304        	  5182:     move.b  D0,($0304,A4)
                            	  5183:     ; Write the high byte of the current VRAM page.
                            	  5184:     ;
02:0003515A 7400            	  5185:     moveq   #0,D2
02:0003515C 142C050C        	  5186:     move.b  ($050C,A4),D2
02:00035160 41F900034F06    	  5187:     lea     (CreditLineVramAddrsHi).l,A0
02:00035166 10302000        	  5188:     move.b  (A0,D2.W),D0
02:0003516A 19400302        	  5189:     move.b  D0,($0302,A4)
                            	  5190:     ; The line number will be used to shift the task mask below.
                            	  5191:     ;
02:0003516E 102C050D        	  5192:     move.b  ($050D,A4),D0
02:00035172 7600            	  5193:     moveq   #0,D3
02:00035174 1600            	  5194:     move.b  D0,D3
                            	  5195:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  5196:     ;
02:00035176 E308            	  5197:     lsl.b  #1,D0   ; ASL A
02:00035178 E308            	  5198:     lsl.b  #1,D0   ; ASL A
02:0003517A E308            	  5199:     lsl.b  #1,D0   ; ASL A
02:0003517C E308            	  5200:     lsl.b  #1,D0   ; ASL A
02:0003517E E308            	  5201:     lsl.b  #1,D0   ; ASL A
02:00035180 19400303        	  5202:     move.b  D0,($0303,A4)
                            	  5203:     ; Get the mask for the current VRAM page.
                            	  5204:     ;
02:00035184 41F900034F12    	  5205:     lea     (CreditsPagesTextMasks).l,A0
02:0003518A 10302000        	  5206:     move.b  (A0,D2.W),D0
                            	  5207: _anon_z02_43:
                            	  5208:     ; Shift left as many times as the current VRAM line number,
                            	  5209:     ; to get the bit that indicates whether this line has text.
                            	  5210:     ;
02:0003518E E308            	  5211:     lsl.b  #1,D0   ; ASL A
02:00035190 5303            	  5212:     subq.b  #1,D3
02:00035192 6AFA            	  5213:     bpl  _anon_z02_43
02:00035194 6400013E        	  5214:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5215:     ; The mask inidcates that it should have text.
                            	  5216:     ; But if line index >= $17, then it doesn't.
                            	  5217:     ;
02:00035198 7600            	  5218:     moveq   #0,D3
02:0003519A 162C050E        	  5219:     move.b  ($050E,A4),D3
02:0003519E 0C030017        	  5220:     cmpi.b  #$17,D3
02:000351A2 64000130        	  5221:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  5222:     ; In the first quest, don't consider line numbers >= $10.
                            	  5223:     ;
02:000351A6 7400            	  5224:     moveq   #0,D2
02:000351A8 142C0016        	  5225:     move.b  ($0016,A4),D2
02:000351AC 41EC062D        	  5226:     lea     ($062D,A4),A0
02:000351B0 10302000        	  5227:     move.b  (A0,D2.W),D0
02:000351B4 6608            	  5228:     bne  _anon_z02_44
02:000351B6 0C030010        	  5229:     cmpi.b  #$10,D3
02:000351BA 64000114        	  5230:     bcc  _L_z02_DrawCredits_IncLine
                            	  5231: _anon_z02_44:
02:000351BE 7400            	  5232:     moveq   #0,D2
02:000351C0 142C0016        	  5233:     move.b  ($0016,A4),D2
02:000351C4 41EC062D        	  5234:     lea     ($062D,A4),A0
02:000351C8 10302000        	  5235:     move.b  (A0,D2.W),D0
                            	  5236:     ; In the second quest, skip lines $C to $F.
                            	  5237:     ;
02:000351CC 670E            	  5238:     beq  _anon_z02_45
02:000351CE 0C03000C        	  5239:     cmpi.b  #$0C,D3
02:000351D2 6508            	  5240:     bcs  _anon_z02_45
02:000351D4 0C030010        	  5241:     cmpi.b  #$10,D3
02:000351D8 650000F6        	  5242:     bcs  _L_z02_DrawCredits_IncLine
                            	  5243: _anon_z02_45:
02:000351DC 41F900034F1E    	  5244:     lea     (CreditsTextAddrsLo).l,A0
02:000351E2 10303000        	  5245:     move.b  (A0,D3.W),D0
02:000351E6 1880            	  5246:     move.b  D0,($0000,A4)
02:000351E8 41F900034F36    	  5247:     lea     (CreditsTextAddrsHi).l,A0
02:000351EE 10303000        	  5248:     move.b  (A0,D3.W),D0
02:000351F2 19400001        	  5249:     move.b  D0,($0001,A4)
                            	  5250:     ; First read the length of the string.
                            	  5251:     ;
02:000351F6 7600            	  5252:     moveq   #0,D3
02:000351F8 1214            	  5253:     move.b  ($00,A4),D1   ; ptr lo
02:000351FA 182C0001        	  5254:     move.b  ($01,A4),D4  ; ptr hi
02:000351FE 024100FF        	  5255:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035202 E14C            	  5256:     lsl.w   #8,D4
02:00035204 8841            	  5257:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035206 48C4            	  5258:     ext.l   D4
02:00035208 D8BC00FF0000    	  5259:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0003520E 2044            	  5260:     movea.l D4,A0
02:00035210 10303000        	  5261:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00035214 19400002        	  5262:     move.b  D0,($0002,A4)
                            	  5263:     ; Second, read the offset where the first character goes
                            	  5264:     ; in the line.
                            	  5265:     ;
02:00035218 5203            	  5266:     addq.b  #1,D3
02:0003521A 1214            	  5267:     move.b  ($00,A4),D1   ; ptr lo
02:0003521C 182C0001        	  5268:     move.b  ($01,A4),D4  ; ptr hi
02:00035220 024100FF        	  5269:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00035224 E14C            	  5270:     lsl.w   #8,D4
02:00035226 8841            	  5271:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035228 48C4            	  5272:     ext.l   D4
