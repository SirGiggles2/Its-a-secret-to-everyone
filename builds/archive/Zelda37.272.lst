                            	  7588: _L_z04_UpdatePolsVoice_State0:
                            	  7589:     ; State 0. Walking.
                            	  7590:     ;
                            	  7591:     ; If grid offset = 0, then no more distance to cover.
                            	  7592:     ; So, go change to state 1 -- jumping.
                            	  7593:     ;
02:0003B4C4 41EC0394        	  7594:     lea     ($0394,A4),A0
02:0003B4C8 10302000        	  7595:     move.b  (A0,D2.W),D0
02:0003B4CC 67000084        	  7596:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7597:     ; Decrement grid offset / distance remaining.
                            	  7598:     ;
02:0003B4D0 41EC0394        	  7599:     lea     ($0394,A4),A0
02:0003B4D4 53302000        	  7600:     subq.b  #1,(A0,D2.W)
                            	  7601:     ; Move vertically.
                            	  7602:     ; Add the Y offset for the current direction to the Y coordinate.
