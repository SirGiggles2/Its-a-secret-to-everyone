02:00031F1A 020000F0        	   602:     andi.b #$F0,D0
02:00031F1E 1940000C        	   603:     move.b  D0,($000C,A4)
02:00031F22 E208            	   604:     lsr.b  #1,D0   ; LSR A
02:00031F24 E208            	   605:     lsr.b  #1,D0   ; LSR A
02:00031F26 E208            	   606:     lsr.b  #1,D0   ; LSR A
02:00031F28 E208            	   607:     lsr.b  #1,D0   ; LSR A
02:00031F2A 122C000C        	   608:     move.b  ($000C,A4),D1
02:00031F2E 8001            	   609:     or.b  D1,D0
02:00031F30 1B00            	   610:     move.b  D0,-(A5)  ; PHA
                            	   611:     even
                            	   612: _L_z02_UpdateMode0Demo_Sub2_StoreValue:
