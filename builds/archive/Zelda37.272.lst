                            	  5384: _L_z02_DrawCredits_WriteAttributes:
                            	  5385:     ; Every 4 rows, we have to transfer NT attributes.
                            	  5386:     ; So, when (counter MOD 4) <> 0, skip filling an attribute record.
                            	  5387:     ;
02:0003530E 102C050A        	  5388:     move.b  ($050A,A4),D0
02:00035312 E208            	  5389:     lsr.b  #1,D0   ; LSR A
02:00035314 6556            	  5390:     bcs  _L_z02_DrawCredits_IncRow
02:00035316 E208            	  5391:     lsr.b  #1,D0   ; LSR A
02:00035318 6552            	  5392:     bcs  _L_z02_DrawCredits_IncRow
                            	  5393:     ; Attributes for the left and right blocks are 0.
                            	  5394:     ;
02:0003531A 7400            	  5395:     moveq   #0,D2
02:0003531C 19420328        	  5396:     move.b  D2,($0328,A4)
02:00035320 1942032F        	  5397:     move.b  D2,($032F,A4)
                            	  5398:     ; The row was already divided by 4. So now it refers to an
                            	  5399:     ; NT attribute block row. Look up the attribute byte to use
                            	  5400:     ; for almost every block in this NT attribute block row.
                            	  5401:     ;
