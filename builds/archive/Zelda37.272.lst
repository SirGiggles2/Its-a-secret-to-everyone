                            	  1191: _L_z04_UpdateFireball_Move:
                            	  1192:     ; A movement routine is used that works along one axis.
                            	  1193:     ; So, load its parameters, and call it for each axis individually.
                            	  1194:     ;
                            	  1195:     ; First, load the horizontal direction into [0F].
                            	  1196:     ;
02:00038778 41EC0412        	  1197:     lea     ($0412,A4),A0
02:0003877C 10302000        	  1198:     move.b  (A0,D2.W),D0
02:00038780 1940000F        	  1199:     move.b  D0,($000F,A4)
                            	  1200:     ; Load the horizontal q-speed and position fraction,
                            	  1201:     ; move, then save the position fraction.
                            	  1202:     ;
02:00038784 41EC041F        	  1203:     lea     ($041F,A4),A0
02:00038788 10302000        	  1204:     move.b  (A0,D2.W),D0
02:0003878C 7600            	  1205:     moveq   #0,D3
02:0003878E 41EC0451        	  1206:     lea     ($0451,A4),A0
02:00038792 16302000        	  1207:     move.b  (A0,D2.W),D3
02:00038796 613E            	  1208:     jsr     Fireball_MoveOneAxis
02:00038798 41EC0451        	  1209:     lea     ($0451,A4),A0
02:0003879C 11802000        	  1210:     move.b  D0,(A0,D2.W)
                            	  1211:     ; Second, load the vertical direction into [0F].
                            	  1212:     ;
02:000387A0 41EC0437        	  1213:     lea     ($0437,A4),A0
02:000387A4 10302000        	  1214:     move.b  (A0,D2.W),D0
02:000387A8 1940000F        	  1215:     move.b  D0,($000F,A4)
                            	  1216:     ; Load the vertical q-speed and position fraction,
                            	  1217:     ; move, then save the position fraction.
                            	  1218:     ;
02:000387AC 41EC0444        	  1219:     lea     ($0444,A4),A0
02:000387B0 10302000        	  1220:     move.b  (A0,D2.W),D0
02:000387B4 7600            	  1221:     moveq   #0,D3
02:000387B6 41EC045E        	  1222:     lea     ($045E,A4),A0
02:000387BA 16302000        	  1223:     move.b  (A0,D2.W),D3
02:000387BE 6116            	  1224:     jsr     Fireball_MoveOneAxis
