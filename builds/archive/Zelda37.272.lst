                            	  6523: _L_z04_Aquamentus_Move_ApplySpeed:
                            	  6524:     ; Use (direction - 1) to index the speeds.
                            	  6525:     ; This yields 0 for right, 1 for left.
                            	  6526:     ;
02:0003AD90 7600            	  6527:     moveq   #0,D3
02:0003AD92 41EC0098        	  6528:     lea     ($0098,A4),A0
02:0003AD96 16302000        	  6529:     move.b  (A0,D2.W),D3
02:0003AD9A 5303            	  6530:     subq.b  #1,D3
                            	  6531:     ; Add the speed to the X coordinate.
                            	  6532:     ;
02:0003AD9C 10342070        	  6533:     move.b  ($70,A4,D2.W),D0
02:0003ADA0 023C00EE        	  6534:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ADA4 41F90003AD0E    	  6535:     lea     (AquamentusSpeeds).l,A0
02:0003ADAA 12303000        	  6536:     move.b  (A0,D3.W),D1
02:0003ADAE D101            	  6537:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
02:0003ADB0 19802070        	  6538:     move.b  D0,($70,A4,D2.W)
                            	  6539:     ; Decrement the distance remaining.
                            	  6540:     ;
02:0003ADB4 41EC0394        	  6541:     lea     ($0394,A4),A0
02:0003ADB8 53302000        	  6542:     subq.b  #1,(A0,D2.W)
                            	  6543:     even
