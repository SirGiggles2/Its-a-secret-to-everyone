02:00041A00 6620            	  5386:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5387:     even
                            	  5388: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5389:     ; We jump here if the door type is bombable and was opened.
                            	  5390:     ; Change the provisional door face to value 9, which
                            	  5391:     ; will become the "hole in the wall".
                            	  5392:     ;
02:00041A02 7009            	  5393:     moveq   #9,D0
02:00041A04 665A            	  5394:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5395:     even
                            	  5396: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5397:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5398:     ; the mask of opened doors, because this is not a true door.
                            	  5399:     ;
02:00041A06 1B00            	  5400:     move.b  D0,-(A5)  ; PHA
02:00041A08 102C0002        	  5401:     move.b  ($0002,A4),D0
02:00041A0C 4600            	  5402:     eori.b #$FF,D0
02:00041A0E 122C00EE        	  5403:     move.b  ($00EE,A4),D1
02:00041A12 C001            	  5404:     and.b  D1,D0
02:00041A14 194000EE        	  5405:     move.b  D0,($00EE,A4)
02:00041A18 101D            	  5406:     move.b  (A5)+,D0  ; PLA
                            	  5407:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5408:     ;
02:00041A1A 0C000001        	  5409:     cmpi.b  #$01,D0
02:00041A1E 6402            	  5410:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:00041A20 7004            	  5411:     moveq   #4,D0
                            	  5412:     even
                            	  5413: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5414:     ; The door attribute (DA) has been mapped to a
                            	  5415:     ; provisional door face value (PF) in %A as follows:
                            	  5416:     ;
                            	  5417:     ; DA PF Meaning
                            	  5418:     ; -------------
                            	  5419:     ; 0  4  open
                            	  5420:     ; 1  1  wall
                            	  5421:     ; 2  2  false wall
                            	  5422:     ; 3  3  false wall 2
                            	  5423:     ; 4  8  bombable
                            	  5424:     ; 5  5  key
                            	  5425:     ; 6  6  key 2
                            	  5426:     ; 7  7  shutter
                            	  5427:     ;
                            	  5428:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5429:     ; has been cleared, if the type was "open" or any wall.
                            	  5430:     ;
                            	  5431:     ;
                            	  5432:     ; Save the provisional face.
02:00041A22 1B00            	  5433:     move.b  D0,-(A5)  ; PHA
                            	  5434:     ; If the current direction points to a door that has been opened,
                            	  5435:     ; then see if we need to set door flags.
                            	  5436:     ;
02:00041A24 102C00EE        	  5437:     move.b  ($00EE,A4),D0
02:00041A28 122C0002        	  5438:     move.b  ($0002,A4),D1
02:00041A2C C001            	  5439:     and.b  D1,D0
02:00041A2E 7400            	  5440:     moveq   #0,D2
02:00041A30 1400            	  5441:     move.b  D0,D2
02:00041A32 101D            	  5442:     move.b  (A5)+,D0  ; PLA
02:00041A34 122C0002        	  5443:     move.b  ($0002,A4),D1
02:00041A38 B401            	  5444:     cmp.b   D1,D2
02:00041A3A 6624            	  5445:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5446:     ; The current direction points to a door that has been opened.
                            	  5447:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5448:     ;
                            	  5449:     ;
                            	  5450:     ; Save provisional door face in Y register.
02:00041A3C 7600            	  5451:     moveq   #0,D3
02:00041A3E 1600            	  5452:     move.b  D0,D3
02:00041A40 101D            	  5453:     move.b  (A5)+,D0  ; PLA
02:00041A42 1B00            	  5454:     move.b  D0,-(A5)  ; PHA
02:00041A44 7400            	  5455:     moveq   #0,D2
02:00041A46 1400            	  5456:     move.b  D0,D2
02:00041A48 1003            	  5457:     move.b  D3,D0
                            	  5458:     ; If provisional door face is not for a shutter, then
                            	  5459:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5460:     ;
                            	  5461:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5462:     ;
02:00041A4A 0C000007        	  5463:     cmpi.b  #$07,D0
02:00041A4E 670E            	  5464:     beq  _anon_z05_111
02:00041A50 1B00            	  5465:     move.b  D0,-(A5)  ; PHA
02:00041A52 6100DF68        	  5466:     jsr     SetDoorFlag
02:00041A56 101D            	  5467:     move.b  (A5)+,D0  ; PLA
                            	  5468:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5469:     ; then go make it 9 (open "bombable").
                            	  5470:     ; Else make it 4 (open "door").
                            	  5471:     ;
02:00041A58 0C000008        	  5472:     cmpi.b  #$08,D0
02:00041A5C 67A4            	  5473:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5474: _anon_z05_111:
02:00041A5E 7004            	  5475:     moveq   #4,D0
                            	  5476:     even
                            	  5477: _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF:
                            	  5478:     ; For opened doors, the provisional door face has become:
                            	  5479:     ;
                            	  5480:     ; DA PF Meaning
                            	  5481:     ; -------------
                            	  5482:     ; 0  4  open
                            	  5483:     ; 1  1  wall
                            	  5484:     ; 2  2  false wall
                            	  5485:     ; 3  3  false wall 2
                            	  5486:     ; 4  9  bombable
                            	  5487:     ; 5  4  key
                            	  5488:     ; 6  4  key 2
                            	  5489:     ; 7  4  shutter
                            	  5490:     ;
                            	  5491:     ;
                            	  5492:     ; If handling the first half [06], then calculate OpenDoorwayMask.
                            	  5493:     ;
02:00041A60 7400            	  5494:     moveq   #0,D2
02:00041A62 142C0006        	  5495:     move.b  ($0006,A4),D2
02:00041A66 6712            	  5496:     beq  _anon_z05_112
