02:00041752 10303000        	  5044:     move.b  (A0,D3.W),D0
02:00041756 7600            	  5045:     moveq   #0,D3
02:00041758 162C0003        	  5046:     move.b  ($0003,A4),D3
02:0004175C 0C030002        	  5047:     cmpi.b  #$02,D3
02:00041760 6510            	  5048:     bcs  _anon_z05_106
02:00041762 7600            	  5049:     moveq   #0,D3
02:00041764 162C00EB        	  5050:     move.b  ($00EB,A4),D3
02:00041768 41F900FF68FE    	  5051:     lea     (NES_SRAM+$08FE).l,A0
02:0004176E 10303000        	  5052:     move.b  (A0,D3.W),D0
                            	  5053: _anon_z05_106:
02:00041772 1880            	  5054:     move.b  D0,($0000,A4)
