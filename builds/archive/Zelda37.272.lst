                            	  6458: Aquamentus_Move:
                            	  6459:     ; The monster uses grid offset to mean distance remaining.
                            	  6460:     ; If there's more distance to cover, then go move.
                            	  6461:     ;
02:0003AD10 41EC0394        	  6462:     lea     ($0394,A4),A0
02:0003AD14 10302000        	  6463:     move.b  (A0,D2.W),D0
02:0003AD18 662C            	  6464:     bne  _L_z04_Aquamentus_Move_Move
                            	  6465:     ; Set a random distance to move of 7 or $F pixels.
                            	  6466:     ;
02:0003AD1A 10342018        	  6467:     move.b  ($18,A4,D2.W),D0
02:0003AD1E 1B00            	  6468:     move.b  D0,-(A5)  ; PHA
02:0003AD20 0200000F        	  6469:     andi.b #$0F,D0
02:0003AD24 00000007        	  6470:     ori.b #$07,D0
02:0003AD28 41EC0394        	  6471:     lea     ($0394,A4),A0
02:0003AD2C 11802000        	  6472:     move.b  D0,(A0,D2.W)
02:0003AD30 101D            	  6473:     move.b  (A5)+,D0  ; PLA
                            	  6474:     ; Randomly head left or right.
                            	  6475:     ;
02:0003AD32 02000001        	  6476:     andi.b #$01,D0
02:0003AD36 7600            	  6477:     moveq   #0,D3
02:0003AD38 1600            	  6478:     move.b  D0,D3
02:0003AD3A 5203            	  6479:     addq.b  #1,D3
02:0003AD3C 41EC0098        	  6480:     lea     ($0098,A4),A0
02:0003AD40 11832000        	  6481:     move.b  D3,(A0,D2.W)
02:0003AD44 4E75            	  6482:     rts
                            	  6483: 
                            	  6484:     even
                            	  6485: _L_z04_Aquamentus_Move_Move:
                            	  6486:     ; 7 of 8 screen frames return without moving.
                            	  6487:     ;
02:0003AD46 102C0015        	  6488:     move.b  ($0015,A4),D0
02:0003AD4A 02000007        	  6489:     andi.b #$07,D0
02:0003AD4E 666C            	  6490:     bne  _L_z04_Aquamentus_Move_Exit
                            	  6491:     ; If the boss crossed the left limit, then
                            	  6492:     ; put it back at the left limit ($88), and face right.
                            	  6493:     ;
02:0003AD50 10342070        	  6494:     move.b  ($70,A4,D2.W),D0
02:0003AD54 0C000088        	  6495:     cmpi.b  #$88,D0
02:0003AD58 6414            	  6496:     bcc  _L_z04_Aquamentus_Move_CheckRightLimit
02:0003AD5A 103C0088        	  6497:     move.b  #$88,D0
02:0003AD5E 19802070        	  6498:     move.b  D0,($70,A4,D2.W)
02:0003AD62 7001            	  6499:     moveq   #1,D0
02:0003AD64 41EC0098        	  6500:     lea     ($0098,A4),A0
02:0003AD68 11802000        	  6501:     move.b  D0,(A0,D2.W)
02:0003AD6C 6618            	  6502:     bne  _L_z04_Aquamentus_Move_SetRemainingDistance
                            	  6503:     even
