02:00031EF6 182C0001        	   585:     move.b  ($01,A4),D4  ; ptr hi
02:00031EFA 024100FF        	   586:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031EFE E14C            	   587:     lsl.w   #8,D4
02:00031F00 8841            	   588:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031F02 48C4            	   589:     ext.l   D4
02:00031F04 D8BC00FF0000    	   590:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031F0A 2044            	   591:     movea.l D4,A0
02:00031F0C 10303000        	   592:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031F10 1B00            	   593:     move.b  D0,-(A5)  ; PHA
02:00031F12 1002            	   594:     move.b  D2,D0
02:00031F14 E208            	   595:     lsr.b  #1,D0   ; LSR A
                            	   596:     ; If X is even, then the value is a hearts value.
                            	   597:     ; So, make the hearts equal the heart containers.
02:00031F16 651A            	   598:     bcs  _L_z02_UpdateMode0Demo_Sub2_StoreValue
                            	   599:     ; Pop what we pushed, because we're going to push
                            	   600:     ; a modification.
