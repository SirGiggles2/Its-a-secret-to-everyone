02:0003DA9A 19400340        	 12652:     move.b  D0,($0340,A4)
02:0003DA9E 0A3C0001        	 12653:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003DAA2 4E75            	 12654:     rts
