                            	  5120: _anon_z04_71:
                            	  5121:     ; Add the distance and Link's minor coordinate to calculate
                            	  5122:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  5123:     ; In general, the monster will be put in front of Link.
                            	  5124:     ;
02:0003A2F2 023C00EE        	  5125:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A2F6 1214            	  5126:     move.b  ($0000,A4),D1
02:0003A2F8 D101            	  5127:     addx.b  D1,D0   ; ADC $00
02:0003A2FA 19400004        	  5128:     move.b  D0,($0004,A4)
                            	  5129:     ; By default, will return index 0 to choose the minimum value
                            	  5130:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  5131:     ; if Link is at the wall with a smaller major coordinate.
                            	  5132:     ;
02:0003A2FE 7600            	  5133:     moveq   #0,D3
                            	  5134:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  5135:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  5136:     ; to access the block for the other direction along the same axis,
                            	  5137:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  5138:     ;
02:0003A300 102C0001        	  5139:     move.b  ($0001,A4),D0
02:0003A304 122C0003        	  5140:     move.b  ($0003,A4),D1
02:0003A308 B001            	  5141:     cmp.b   D1,D0
02:0003A30A 671C            	  5142:     beq  _anon_z04_72
02:0003A30C 41EC0412        	  5143:     lea     ($0412,A4),A0
02:0003A310 10302000        	  5144:     move.b  (A0,D2.W),D0
02:0003A314 023C00EE        	  5145:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A318 123C0010        	  5146:     move.b  #$10,D1
02:0003A31C D101            	  5147:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A31E 41EC0412        	  5148:     lea     ($0412,A4),A0
02:0003A322 11802000        	  5149:     move.b  D0,(A0,D2.W)
02:0003A326 5203            	  5150:     addq.b  #1,D3
