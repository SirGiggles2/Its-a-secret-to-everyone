02:0003AAA8 41EC0437        	  6168:     lea     ($0437,A4),A0
02:0003AAAC 12302000        	  6169:     move.b  (A0,D2.W),D1
02:0003AAB0 B001            	  6170:     cmp.b   D1,D0
02:0003AAB2 6704            	  6171:     beq.s  __far_z_04_0053
