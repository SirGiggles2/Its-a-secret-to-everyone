02:0003983C 41EC0098        	  3596:     lea     ($0098,A4),A0
02:00039840 10302000        	  3597:     move.b  (A0,D2.W),D0
02:00039844 02000001        	  3598:     andi.b #$01,D0
02:00039848 6714            	  3599:     beq  _L_z04_DrawGhiniAndCheckCollisions_DrawAndCheckCollisions
02:0003984A 660E            	  3600:     bne  _L_z04_DrawGhiniAndCheckCollisions_SetHorizontalFlip
                            	  3601:     even
