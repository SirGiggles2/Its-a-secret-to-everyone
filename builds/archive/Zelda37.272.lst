                            	  7339: _L_z07_InitObject_InitMonsterFromEdge:
02:0004B540 7400            	  7340:     moveq   #0,D2
02:0004B542 142C0340        	  7341:     move.b  ($0340,A4),D2
                            	  7342:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7343:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7344:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7345:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7346:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7347:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7348:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7349:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7350:     ; corrupting them and causing a deterministic address-error
                            	  7351:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7352:     ; identified by Codex static review.)
                            	  7353: _L_z07_P47_pre_check:
02:0004B546 102C0525        	  7354:     move.b  ($0525,A4),D0
02:0004B54A 020000F0        	  7355:     andi.b  #$F0,D0
02:0004B54E 0C000040        	  7356:     cmpi.b  #$40,D0
02:0004B552 6506            	  7357:     blo     _L_z07_P47_pre_snap
02:0004B554 0C0000E0        	  7358:     cmpi.b  #$E0,D0
02:0004B558 6506            	  7359:     blo     _L_z07_P47_pre_ok
                            	  7360: _L_z07_P47_pre_snap:
02:0004B55A 197C00480525    	  7361:     move.b  #$48,($0525,A4)
                            	  7362: _L_z07_P47_pre_ok:
02:0004B560 7005            	  7363:     moveq   #5,D0
02:0004B562 610004F4        	  7364:     jsr     SwitchBank
02:0004B566 4EB9000402FA    	  7365:     jsr     FindNextEdgeSpawnCell
                            	  7366:     ; Post-walk 1: bottom-edge snap.
02:0004B56C 102C0525        	  7367:     move.b  ($0525,A4),D0
02:0004B570 020000F0        	  7368:     andi.b  #$F0,D0
02:0004B574 0C0000E0        	  7369:     cmpi.b  #$E0,D0
02:0004B578 660C            	  7370:     bne     _L_z07_P47_post1_ok
02:0004B57A 197C00480525    	  7371:     move.b  #$48,($0525,A4)
02:0004B580 4EB9000402FA    	  7372:     jsr     FindNextEdgeSpawnCell
                            	  7373: _L_z07_P47_post1_ok:
                            	  7374:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7375:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004B586 7600            	  7376:     moveq   #0,D3
02:0004B588 162C0525        	  7377:     move.b  ($0525,A4),D3
02:0004B58C 0243000F        	  7378:     andi.w  #$000F,D3
02:0004B590 C6FC002C        	  7379:     mulu.w  #44,D3
02:0004B594 203C00FF6530    	  7380:     move.l  #$FF6530,D0
02:0004B59A D083            	  7381:     add.l   D3,D0
02:0004B59C 7600            	  7382:     moveq   #0,D3
02:0004B59E 162C0525        	  7383:     move.b  ($0525,A4),D3
02:0004B5A2 E84B            	  7384:     lsr.w   #4,D3
02:0004B5A4 5943            	  7385:     subi.w  #4,D3
02:0004B5A6 E34B            	  7386:     lsl.w   #1,D3
02:0004B5A8 D083            	  7387:     add.l   D3,D0
02:0004B5AA 2040            	  7388:     movea.l D0,A0
02:0004B5AC 1010            	  7389:     move.b  (A0),D0
02:0004B5AE 0C000084        	  7390:     cmpi.b  #$84,D0
02:0004B5B2 6544            	  7391:     blo     _L_z07_P47_post2_ok
                            	  7392:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7393:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7394:     ; writes to the $05xx region.
02:0004B5B4 7800            	  7395:     moveq   #0,D4
                            	  7396: _L_z07_P47_fb_loop:
02:0004B5B6 41FAE48E        	  7397:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004B5BA 12304000        	  7398:     move.b  (A0,D4.W),D1
02:0004B5BE 19410525        	  7399:     move.b  D1,($0525,A4)
                            	  7400:     ; Validate fallback cell walkable.
02:0004B5C2 7600            	  7401:     moveq   #0,D3
02:0004B5C4 1601            	  7402:     move.b  D1,D3
02:0004B5C6 0243000F        	  7403:     andi.w  #$000F,D3
02:0004B5CA C6FC002C        	  7404:     mulu.w  #44,D3
02:0004B5CE 203C00FF6530    	  7405:     move.l  #$FF6530,D0
02:0004B5D4 D083            	  7406:     add.l   D3,D0
02:0004B5D6 7600            	  7407:     moveq   #0,D3
02:0004B5D8 1601            	  7408:     move.b  D1,D3
02:0004B5DA E84B            	  7409:     lsr.w   #4,D3
02:0004B5DC 5943            	  7410:     subi.w  #4,D3
02:0004B5DE E34B            	  7411:     lsl.w   #1,D3
02:0004B5E0 D083            	  7412:     add.l   D3,D0
02:0004B5E2 2040            	  7413:     movea.l D0,A0
02:0004B5E4 0C100084        	  7414:     cmpi.b  #$84,(A0)
02:0004B5E8 650E            	  7415:     blo     _L_z07_P47_post2_ok
02:0004B5EA 5204            	  7416:     addq.b  #1,D4
02:0004B5EC 0C040008        	  7417:     cmpi.b  #8,D4
02:0004B5F0 65C4            	  7418:     blo     _L_z07_P47_fb_loop
                            	  7419:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7420:     ; rather than looping).
02:0004B5F2 197C00480525    	  7421:     move.b  #$48,($0525,A4)
                            	  7422: _L_z07_P47_post2_ok:
                            	  7423:     ; Extract and set the monster's location.
                            	  7424:     ;
02:0004B5F8 102C0525        	  7425:     move.b  ($0525,A4),D0
                            	  7426:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7427:     ;
02:0004B5FC 1B00            	  7428:     move.b  D0,-(A5)  ; PHA
02:0004B5FE E308            	  7429:     lsl.b  #1,D0   ; ASL A
02:0004B600 E308            	  7430:     lsl.b  #1,D0   ; ASL A
02:0004B602 E308            	  7431:     lsl.b  #1,D0   ; ASL A
02:0004B604 E308            	  7432:     lsl.b  #1,D0   ; ASL A
02:0004B606 19802070        	  7433:     move.b  D0,($70,A4,D2.W)
                            	  7434:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7435:     ;
02:0004B60A 101D            	  7436:     move.b  (A5)+,D0  ; PLA
02:0004B60C 020000F0        	  7437:     andi.b #$F0,D0
02:0004B610 003C0011        	  7438:     ori     #$11,CCR  ; SEC: set C+X
02:0004B614 123C0003        	  7439:     move.b  #$03,D1
02:0004B618 0A3C0010        	  7440:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004B61C 9101            	  7441:     subx.b  D1,D0   ; SBC #$03
02:0004B61E 0A3C0010        	  7442:     eori    #$10,CCR  ; restore X = 6502 C
02:0004B622 41EC0084        	  7443:     lea     ($0084,A4),A0
02:0004B626 11802000        	  7444:     move.b  D0,(A0,D2.W)
                            	  7445:     ; Set the monsters-from-edges long timer to a random value
                            	  7446:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7447:     ;
02:0004B62A 10342019        	  7448:     move.b  ($19,A4,D2.W),D0
02:0004B62E 02000003        	  7449:     andi.b #$03,D0
02:0004B632 023C00EE        	  7450:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004B636 123C0002        	  7451:     move.b  #$02,D1
02:0004B63A D101            	  7452:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:0004B63C 1940004B        	  7453:     move.b  D0,($004B,A4)
                            	  7454:     ; If the distance to Link is too close to Link, then
                            	  7455:     ; go flag the monster uninitialized again, so we can
                            	  7456:     ; try to spawn it again next time.
                            	  7457:     ;
02:0004B640 7005            	  7458:     moveq   #5,D0
02:0004B642 61000414        	  7459:     jsr     SwitchBank
02:0004B646 4EB90003F90A    	  7460:     jsr     IsDistanceSafeToSpawn
02:0004B64C 6500FEB4        	  7461:     bcs  _L_z07_InitObject_UninitMonsterFromEdge
                            	  7462:     ; OK to spawn.
                            	  7463:     ; In this situation, monsters don't spawn from a cloud.
                            	  7464:     ;
02:0004B650 7000            	  7465:     moveq   #0,D0
02:0004B652 41EC0405        	  7466:     lea     ($0405,A4),A0
02:0004B656 11802000        	  7467:     move.b  D0,(A0,D2.W)
                            	  7468:     even
                            	  7469: _L_z07_InitObject_NormalSpawn:
02:0004B65A 7004            	  7470:     moveq   #4,D0
02:0004B65C 610003FA        	  7471:     jsr     SwitchBank
                            	  7472:     ; For monsters that spawn in a cloud, set their start time to
                            	  7473:     ; the same value as the object slot; so that they all start
                            	  7474:     ; moving at different times.
                            	  7475:     ;
02:0004B660 7400            	  7476:     moveq   #0,D2
02:0004B662 142C0340        	  7477:     move.b  ($0340,A4),D2
02:0004B666 7600            	  7478:     moveq   #0,D3
02:0004B668 41EC034F        	  7479:     lea     ($034F,A4),A0
02:0004B66C 16302000        	  7480:     move.b  (A0,D2.W),D3
02:0004B670 0C03001E        	  7481:     cmpi.b  #$1E,D3
02:0004B674 6712            	  7482:     beq  _L_z07_InitObject_FetchAttrs
02:0004B676 0C030022        	  7483:     cmpi.b  #$22,D3
02:0004B67A 670C            	  7484:     beq  _L_z07_InitObject_FetchAttrs
02:0004B67C 0C030053        	  7485:     cmpi.b  #$53,D3
02:0004B680 6406            	  7486:     bcc  _L_z07_InitObject_FetchAttrs
02:0004B682 1002            	  7487:     move.b  D2,D0
02:0004B684 19802028        	  7488:     move.b  D0,($28,A4,D2.W)
                            	  7489:     even
                            	  7490: _L_z07_InitObject_FetchAttrs:
                            	  7491:     ; Store the object attributes for fast access.
