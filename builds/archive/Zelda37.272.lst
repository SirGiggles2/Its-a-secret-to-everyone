02:00040362 4EB90003052C    	  3760:     jsr     AddToInt16At0
02:00040368 5303            	  3761:     subq.b  #1,D3
02:0004036A 66F4            	  3762:     bne  _anon_z05_89
                            	  3763:     even
                            	  3764: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3765:     ; Turn the row part of [0A] into a tile index.
                            	  3766:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3767:     ;
02:0004036C 102C000A        	  3768:     move.b  ($000A,A4),D0
02:00040370 020000F0        	  3769:     andi.b #$F0,D0
02:00040374 003C0011        	  3770:     ori     #$11,CCR  ; SEC: set C+X
02:00040378 123C0040        	  3771:     move.b  #$40,D1
02:0004037C 0A3C0010        	  3772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00040380 9101            	  3773:     subx.b  D1,D0   ; SBC #$40
02:00040382 0A3C0010        	  3774:     eori    #$10,CCR  ; restore X = 6502 C
02:00040386 E208            	  3775:     lsr.b  #1,D0   ; LSR A
02:00040388 E208            	  3776:     lsr.b  #1,D0   ; LSR A
02:0004038A E208            	  3777:     lsr.b  #1,D0   ; LSR A
02:0004038C 7600            	  3778:     moveq   #0,D3
02:0004038E 1600            	  3779:     move.b  D0,D3
                            	  3780:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3781:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3782:     ; when coming in from the edges.
                            	  3783:     ;
02:00040390 1214            	  3784:     move.b  ($00,A4),D1   ; ptr lo
02:00040392 182C0001        	  3785:     move.b  ($01,A4),D4  ; ptr hi
02:00040396 024100FF        	  3786:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004039A E14C            	  3787:     lsl.w   #8,D4
02:0004039C 8841            	  3788:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004039E 48C4            	  3789:     ext.l   D4
02:000403A0 D8BC00FF0000    	  3790:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000403A6 2044            	  3791:     movea.l D4,A0
02:000403A8 10303000        	  3792:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000403AC 0C000084        	  3793:     cmpi.b  #$84,D0
02:000403B0 650E            	  3794:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3795:     ; Bottom of the loop.
                            	  3796:     ; If you reach the original cell, then stop.
                            	  3797:     ;
02:000403B2 102C000A        	  3798:     move.b  ($000A,A4),D0
02:000403B6 122C0525        	  3799:     move.b  ($0525,A4),D1
02:000403BA B001            	  3800:     cmp.b   D1,D0
02:000403BC 6600FF44        	  3801:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3802:     even
