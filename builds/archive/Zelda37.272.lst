02:00041A74 61001C62        	  5501:     jsr     CalcOpenDoorwayMask
02:00041A78 101D            	  5502:     move.b  (A5)+,D0  ; PLA
                            	  5503: _anon_z05_112:
                            	  5504:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5505:     ; because the visible door face is already a wall.
                            	  5506:     ;
02:00041A7A 0C000004        	  5507:     cmpi.b  #$04,D0
02:00041A7E 650000DC        	  5508:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5509:     ; For all other provisional face values, calculate:
                            	  5510:     ; door face := provisional face - 3
02:00041A82 003C0011        	  5511:     ori     #$11,CCR  ; SEC: set C+X
02:00041A86 123C0003        	  5512:     move.b  #$03,D1
02:00041A8A 0A3C0010        	  5513:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041A8E 9101            	  5514:     subx.b  D1,D0   ; SBC #$03
02:00041A90 0A3C0010        	  5515:     eori    #$10,CCR  ; restore X = 6502 C
02:00041A94 7600            	  5516:     moveq   #0,D3
02:00041A96 1600            	  5517:     move.b  D0,D3
                            	  5518:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5519:     ; subtract one.
                            	  5520:     ;
02:00041A98 0C030003        	  5521:     cmpi.b  #$03,D3
02:00041A9C 6502            	  5522:     bcs  _anon_z05_113
02:00041A9E 5303            	  5523:     subq.b  #1,D3
                            	  5524: _anon_z05_113:
                            	  5525:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5526:     ;
                            	  5527:     ; DT DFC DFO Meaning
                            	  5528:     ; ------------------
                            	  5529:     ; 0  1   1   open
                            	  5530:     ; 4  4   5   bombable
                            	  5531:     ; 5  2   1   key
                            	  5532:     ; 6  2   1   key 2
                            	  5533:     ; 7  3   1   shutter
                            	  5534:     ;
                            	  5535:     ;
                            	  5536:     ; Get the direction index.
02:00041AA0 101D            	  5537:     move.b  (A5)+,D0  ; PLA
02:00041AA2 1B00            	  5538:     move.b  D0,-(A5)  ; PHA
02:00041AA4 610000D0        	  5539:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5540:     ; If handling the second half, then offset to the second half
                            	  5541:     ; of the tiles.
                            	  5542:     ;
