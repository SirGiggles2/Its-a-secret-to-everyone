02:00035326 1600            	  5403:     move.b  D0,D3
02:00035328 41F9000350EC    	  5404:     lea     (CreditsAttrs).l,A0
02:0003532E 10303000        	  5405:     move.b  (A0,D3.W),D0
                            	  5406:     ; Fill a record with this byte, so the whole NT attribute block
                            	  5407:     ; row is changed.
                            	  5408:     ;
02:00035332 7605            	  5409:     moveq   #5,D3
                            	  5410: _anon_z02_51:
02:00035334 41EC0329        	  5411:     lea     ($0329,A4),A0
