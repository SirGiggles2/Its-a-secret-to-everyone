02:0003CCA8 10302000        	 10733:     move.b  (A0,D2.W),D0
02:0003CCAC 670000D4        	 10734:     beq  _L_z04_Gleeok_CheckCollisions_NextLoopSegment
                            	 10735:     ; This neck died. So, prepare to make a flying head.
