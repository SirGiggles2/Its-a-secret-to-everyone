02:0003AC6A 10302000        	  6380:     move.b  (A0,D2.W),D0
02:0003AC6E 666C            	  6381:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  6382:     ; For each part of the big digdogger, from 0 to 3,
                            	  6383:     ; indexed by Y register:
