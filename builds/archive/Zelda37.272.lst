                            	 11399: UpdateLamnola:
                            	 11400:     ; If the direction of this segment is not set, then it has not started
                            	 11401:     ; moving yet. So, return.
                            	 11402:     ;
02:0003D1CE 41EC0098        	 11403:     lea     ($0098,A4),A0
