                            	  9800: GohmaLegOffsetsX:
02:0003C59E F0              	  9801:     dc.b    $F0, $10
02:0003C59F 10
                            	  9802: 
                            	  9803: ; Params:
                            	  9804: ; A: eye frame image
                            	  9805: ;
                            	  9806: ; Draw the eye with the frame image passed in.
                            	  9807: ;
                            	  9808:     even
                            	  9809: Gohma_AnimateAndDraw:
02:0003C5A0 1B00            	  9810:     move.b  D0,-(A5)  ; PHA
02:0003C5A2 4EB90004B104    	  9811:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003C5A8 6164            	  9812:     jsr     Gohma_SetSpriteAttributes
02:0003C5AA 101D            	  9813:     move.b  (A5)+,D0  ; PLA
02:0003C5AC 4EB900030874    	  9814:     jsr     DrawObjectMirrored
02:0003C5B2 7010            	  9815:     moveq   #16,D0
02:0003C5B4 4EB90004B0FE    	  9816:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  9817:     ; Draw the right legs.
                            	  9818:     ;
02:0003C5BA 7601            	  9819:     moveq   #1,D3
02:0003C5BC 6102            	  9820:     jsr     Gohma_DrawLegsOneSide
                            	  9821:     ; Draw the left legs.
                            	  9822:     ;
02:0003C5BE 7600            	  9823:     moveq   #0,D3
                            	  9824: ; Params:
                            	  9825: ; Y: side: 0 for left, 1 for right
                            	  9826: ;
                            	  9827: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9828: ; store the sprite's X in [00].
                            	  9829: ;
                            	  9830:     even
                            	  9831: Gohma_DrawLegsOneSide:
02:0003C5C0 10342070        	  9832:     move.b  ($70,A4,D2.W),D0
02:0003C5C4 023C00EE        	  9833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C5C8 41F90003C59E    	  9834:     lea     (GohmaLegOffsetsX).l,A0
02:0003C5CE 12303000        	  9835:     move.b  (A0,D3.W),D1
02:0003C5D2 D101            	  9836:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003C5D4 1880            	  9837:     move.b  D0,($0000,A4)
                            	  9838:     ; The object's Y is the sprite's.
                            	  9839:     ;
02:0003C5D6 41EC0084        	  9840:     lea     ($0084,A4),A0
02:0003C5DA 10302000        	  9841:     move.b  (A0,D2.W),D0
02:0003C5DE 19400001        	  9842:     move.b  D0,($0001,A4)
02:0003C5E2 612A            	  9843:     jsr     Gohma_SetSpriteAttributes
                            	  9844:     ; There are only two frame images for legs: left and right.
                            	  9845:     ; There are two animation frames. They are animated as follows:
                            	  9846:     ;
                            	  9847:     ; Frame 0:
                            	  9848:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9849:     ; horizontal flipping = frame number = 0
                            	  9850:     ; 
                            	  9851:     ; Frame 1:
                            	  9852:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9853:     ; horizontal flipping = frame number = 1
                            	  9854:     ;
02:0003C5E4 4EB90004B0D6    	  9855:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003C5EA 1003            	  9856:     move.b  D3,D0
02:0003C5EC 023C00EE        	  9857:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C5F0 41EC03E4        	  9858:     lea     ($03E4,A4),A0
02:0003C5F4 12302000        	  9859:     move.b  (A0,D2.W),D1
02:0003C5F8 D101            	  9860:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003C5FA 02000001        	  9861:     andi.b #$01,D0
02:0003C5FE 023C00EE        	  9862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C602 123C0004        	  9863:     move.b  #$04,D1
02:0003C606 D101            	  9864:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003C608 4EF900030878    	  9865:     jmp     DrawObjectNotMirrored
                            	  9866: 
                            	  9867: ; Returns:
                            	  9868: ; [04]: left side sprite attributes
                            	  9869: ; [05]: right side sprite attributes
                            	  9870: ;
                            	  9871:     even
                            	  9872: Gohma_SetSpriteAttributes:
02:0003C60E 4EF90002BF4A    	  9873:     jmp     c_gohma_set_sprite_attributes
