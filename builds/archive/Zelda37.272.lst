                            	 12753: Ganon_CheckCollisions:
                            	 12754:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12755:     ; Store in [02] and [03].
                            	 12756:     ;
02:0003DB5C 10342070        	 12757:     move.b  ($70,A4,D2.W),D0
02:0003DB60 023C00EE        	 12758:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DB64 123C0010        	 12759:     move.b  #$10,D1
02:0003DB68 D101            	 12760:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003DB6A 19400002        	 12761:     move.b  D0,($0002,A4)
02:0003DB6E 41EC0084        	 12762:     lea     ($0084,A4),A0
02:0003DB72 10302000        	 12763:     move.b  (A0,D2.W),D0
02:0003DB76 023C00EE        	 12764:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DB7A 123C0010        	 12765:     move.b  #$10,D1
02:0003DB7E D101            	 12766:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003DB80 19400003        	 12767:     move.b  D0,($0003,A4)
                            	 12768:     ; Check for a collision with Link.
                            	 12769:     ;
                            	 12770:     ; We can't call CheckLinkCollision, because we need to
                            	 12771:     ; customize Ganon's midpoint.
                            	 12772:     ;
                            	 12773:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12774:     ; detection, if Link is invincible. Initialize variables that will
                            	 12775:     ; be returned from the partial collision check routine. Then
                            	 12776:     ; call it.
                            	 12777:     ;
02:0003DB84 102C04F0        	 12778:     move.b  ($04F0,A4),D0
02:0003DB88 6616            	 12779:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003DB8A 19400006        	 12780:     move.b  D0,($0006,A4)
02:0003DB8E 19400009        	 12781:     move.b  D0,($0009,A4)
02:0003DB92 1940000C        	 12782:     move.b  D0,($000C,A4)
02:0003DB96 7600            	 12783:     moveq   #0,D3
02:0003DB98 1883            	 12784:     move.b  D3,($0000,A4)
02:0003DB9A 4EB900030C4E    	 12785:     jsr     CheckLinkCollisionPreinit
                            	 12786:     even
                            	 12787: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12788:     ; If Ganon is not in state 0, then he's brown.
                            	 12789:     ; Go check collision with an arrow.
                            	 12790:     ;
02:0003DBA0 41EC00AC        	 12791:     lea     ($00AC,A4),A0
02:0003DBA4 10302000        	 12792:     move.b  (A0,D2.W),D0
02:0003DBA8 6652            	 12793:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12794:     ; If timer <> 0, then Ganon is visible.
                            	 12795:     ; He can't be harmed like this. So, return.
                            	 12796:     ;
02:0003DBAA 10342028        	 12797:     move.b  ($28,A4,D2.W),D0
02:0003DBAE 664A            	 12798:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003DBB0 760D            	 12799:     moveq   #13,D3
02:0003DBB2 4EB900030C88    	 12800:     jsr     CheckMonsterSwordCollision
                            	 12801:     ; If Ganon has died according to the usual collision check rules
                            	 12802:     ; (HP = 0), then:
                            	 12803:     ; 1. Restore HP to the initial value $F0
                            	 12804:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12805:     ; 3. Change palette row 7 to make Ganon brown
                            	 12806:     ;
02:0003DBB8 41EC0405        	 12807:     lea     ($0405,A4),A0
02:0003DBBC 10302000        	 12808:     move.b  (A0,D2.W),D0
02:0003DBC0 6718            	 12809:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003DBC2 103C00F0        	 12810:     move.b  #$F0,D0
02:0003DBC6 41EC0485        	 12811:     lea     ($0485,A4),A0
02:0003DBCA 11802000        	 12812:     move.b  D0,(A0,D2.W)
02:0003DBCE 41EC00AC        	 12813:     lea     ($00AC,A4),A0
02:0003DBD2 53302000        	 12814:     subq.b  #1,(A0,D2.W)
02:0003DBD6 61000084        	 12815:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12816:     even
                            	 12817: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12818:     ; If Ganon was harmed, then play the sound effect
                            	 12819:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12820:     ;
02:0003DBDA 41EC04F0        	 12821:     lea     ($04F0,A4),A0
02:0003DBDE 10302000        	 12822:     move.b  (A0,D2.W),D0
02:0003DBE2 670A            	 12823:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003DBE4 6100A42E        	 12824:     jsr     PlayBossHitCryIfNeeded
02:0003DBE8 7040            	 12825:     moveq   #64,D0
02:0003DBEA 19802028        	 12826:     move.b  D0,($28,A4,D2.W)
                            	 12827:     even
                            	 12828: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12829:     ; Reset metastate, because Ganon cannot die this way.
                            	 12830:     ;
02:0003DBEE 4EB90004B904    	 12831:     jsr     ResetObjMetastate
                            	 12832:     ; Reset shove info and invincibility timer, because Ganon
                            	 12833:     ; doesn't react at all as a usual monster.
                            	 12834:     ;
02:0003DBF4 4EB900030C76    	 12835:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12836:     even
                            	 12837: _L_z04_Ganon_CheckCollisions_Exit:
02:0003DBFA 4E75            	 12838:     rts
                            	 12839: 
                            	 12840:     even
                            	 12841: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12842:     ; If the silver arrow is not in the inventory, then return.
                            	 12843:     ;
02:0003DBFC 102C0659        	 12844:     move.b  ($0659,A4),D0
02:0003DC00 0C000002        	 12845:     cmpi.b  #$02,D0
02:0003DC04 66F4            	 12846:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12847:     ; Reset the collision return value [06].
                            	 12848:     ;
02:0003DC06 7000            	 12849:     moveq   #0,D0
02:0003DC08 19400006        	 12850:     move.b  D0,($0006,A4)
                            	 12851:     ; If there's no arrow in flight, then return.
                            	 12852:     ;
02:0003DC0C 7612            	 12853:     moveq   #18,D3
02:0003DC0E 41EC00AC        	 12854:     lea     ($00AC,A4),A0
02:0003DC12 10303000        	 12855:     move.b  (A0,D3.W),D0
02:0003DC16 0C000010        	 12856:     cmpi.b  #$10,D0
02:0003DC1A 66DE            	 12857:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12858:     ; Check for collision with an arrow; and return if no collision.
                            	 12859:     ;
02:0003DC1C 4EB900030C90    	 12860:     jsr     CheckMonsterArrowOrRodCollision
02:0003DC22 102C0006        	 12861:     move.b  ($0006,A4),D0
02:0003DC26 67D2            	 12862:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 12863:     ; Set the Ganon phase to "dying".
                            	 12864:     ;
02:0003DC28 41EC042C        	 12865:     lea     ($042C,A4),A0
02:0003DC2C 52302000        	 12866:     addq.b  #1,(A0,D2.W)
                            	 12867:     ; Now his body does flash.
                            	 12868:     ;
02:0003DC30 7028            	 12869:     moveq   #40,D0
02:0003DC32 41EC04F0        	 12870:     lea     ($04F0,A4),A0
02:0003DC36 11802000        	 12871:     move.b  D0,(A0,D2.W)
                            	 12872:     ; Set initial cloud distance 8.
                            	 12873:     ;
02:0003DC3A 7008            	 12874:     moveq   #8,D0
02:0003DC3C 41EC0478        	 12875:     lea     ($0478,A4),A0
02:0003DC40 11802000        	 12876:     move.b  D0,(A0,D2.W)
02:0003DC44 0A3C0001        	 12877:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003DC48 4E75            	 12878:     rts
