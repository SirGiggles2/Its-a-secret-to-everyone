02:0003F520 19400070        	  1757:     move.b  D0,($0070,A4)
02:0003F524 41F900FF6AFE    	  1758:     lea     (NES_SRAM+$0AFE).l,A0
02:0003F52A 10303000        	  1759:     move.b  (A0,D3.W),D0
02:0003F52E 02000007        	  1760:     andi.b #$07,D0
02:0003F532 E308            	  1761:     lsl.b  #1,D0   ; ASL A
02:0003F534 E308            	  1762:     lsl.b  #1,D0   ; ASL A
02:0003F536 E308            	  1763:     lsl.b  #1,D0   ; ASL A
02:0003F538 E308            	  1764:     lsl.b  #1,D0   ; ASL A
                            	  1765:     ; Add the first Y where Link can come out of underground.
