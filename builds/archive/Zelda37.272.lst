                            	  5349: LayOutDoors:
                            	  5350:     ; Copies the right door face for the direction, type, and state
                            	  5351:     ; of the door to the play area tile map.
                            	  5352:     ;
                            	  5353:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5354:     ; that are not true doors.
                            	  5355:     ;
02:000419D0 7403            	  5356:     moveq   #3,D2
                            	  5357:     even
                            	  5358: L_LayOutDoors_LoopDoors:
                            	  5359:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5360:     ;
02:000419D2 7001            	  5361:     moveq   #1,D0
                            	  5362:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5363:     ;
                            	  5364:     ; [06] indicates whether we're handling the first half of
                            	  5365:     ; the door: Left half for N/S, Top half for E/W.
                            	  5366:     ;
02:000419D4 19400006        	  5367:     move.b  D0,($0006,A4)
                            	  5368:     even
                            	  5369: L_LayOutDoors_LoopHalves:
02:000419D8 1002            	  5370:     move.b  D2,D0
02:000419DA 1B00            	  5371:     move.b  D0,-(A5)  ; PHA
02:000419DC 1940000B        	  5372:     move.b  D0,($000B,A4)
02:000419E0 41F9000419AC    	  5373:     lea     (DoorBits).l,A0
02:000419E6 10302000        	  5374:     move.b  (A0,D2.W),D0
02:000419EA 19400002        	  5375:     move.b  D0,($0002,A4)
02:000419EE 6100FD4A        	  5376:     jsr     FindDoorAttrByDoorBit
                            	  5377:     ; Begin looking for the door face for the door attribute.
                            	  5378:     ; In general, use the door type as the provisional face;
                            	  5379:     ; except turn 4 into 8.
                            	  5380:     ;
02:000419F2 0C000005        	  5381:     cmpi.b  #$05,D0
02:000419F6 642A            	  5382:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000419F8 0C000004        	  5383:     cmpi.b  #$04,D0
02:000419FC 6608            	  5384:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
