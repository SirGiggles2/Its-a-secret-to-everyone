                            	  3299:     ; If Link's X < $80 look in level block attributes A, else B.
                            	  3300:     ;
                            	  3301:     ; Note that in cellars, level block attributes A and B indicate
                            	  3302:     ; the destination room ID only.
                            	  3303:     ;
02:00040082 7600            	  3304:     moveq   #0,D3
02:00040084 1600            	  3305:     move.b  D0,D3
02:00040086 102C0070        	  3306:     move.b  ($0070,A4),D0
02:0004008A 0C000080        	  3307:     cmpi.b  #$80,D0
02:0004008E 640C            	  3308:     bcc  _L_z05_CheckSubroom_GetRightSideRoom
02:00040090 41F900FF687E    	  3309:     lea     (NES_SRAM+$087E).l,A0
02:00040096 10303000        	  3310:     move.b  (A0,D3.W),D0
02:0004009A 600A            	  3311:     jmp     _anon_z05_82
                            	  3312: 
                            	  3313:     even
                            	  3314: _L_z05_CheckSubroom_GetRightSideRoom:
02:0004009C 41F900FF68FE    	  3315:     lea     (NES_SRAM+$08FE).l,A0
02:000400A2 10303000        	  3316:     move.b  (A0,D3.W),D0
                            	  3317: _anon_z05_82:
02:000400A6 610000AC        	  3318:     jsr     GoToModeAFromCellar
                            	  3319:     ; Set Link's position in the destination room.
                            	  3320:     ;
02:000400AA 101D            	  3321:     move.b  (A5)+,D0  ; PLA
02:000400AC 7600            	  3322:     moveq   #0,D3
02:000400AE 1600            	  3323:     move.b  D0,D3
02:000400B0 41F900FF697E    	  3324:     lea     (NES_SRAM+$097E).l,A0
02:000400B6 10303000        	  3325:     move.b  (A0,D3.W),D0
02:000400BA 1B00            	  3326:     move.b  D0,-(A5)  ; PHA
02:000400BC 020000F0        	  3327:     andi.b #$F0,D0
02:000400C0 19400070        	  3328:     move.b  D0,($0070,A4)
02:000400C4 101D            	  3329:     move.b  (A5)+,D0  ; PLA
02:000400C6 E308            	  3330:     lsl.b  #1,D0   ; ASL A
02:000400C8 E308            	  3331:     lsl.b  #1,D0   ; ASL A
02:000400CA E308            	  3332:     lsl.b  #1,D0   ; ASL A
02:000400CC E308            	  3333:     lsl.b  #1,D0   ; ASL A
02:000400CE 0000000D        	  3334:     ori.b #$0D,D0
02:000400D2 19400084        	  3335:     move.b  D0,($0084,A4)
02:000400D6 4E75            	  3336:     rts
                            	  3337: 
