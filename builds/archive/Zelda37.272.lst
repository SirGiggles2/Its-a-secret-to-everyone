                            	  5666: _anon_z07_30:
02:0004A858 4EB9000304B8    	  5667:     jsr     GetDirectionsAndDistancesToTarget
                            	  5668:     ; If the boomerang hasn't reached the thrower ([00] < 2),
                            	  5669:     ; then go move towards the thrower, draw, and check collisions.
                            	  5670:     ;
02:0004A85E 1014            	  5671:     move.b  ($0000,A4),D0
02:0004A860 0C000002        	  5672:     cmpi.b  #$02,D0
02:0004A864 666A            	  5673:     bne  _L_z07_CheckState30_MoveTowardThrower
                            	  5674:     ; The boomerang has reached the thrower.
                            	  5675:     ;
                            	  5676:     ; Reset the distance to move.
                            	  5677:     ; If this is a monster's boomerang, go handle the monster catching it.
                            	  5678:     ;
02:0004A866 7000            	  5679:     moveq   #0,D0
02:0004A868 41EC0380        	  5680:     lea     ($0380,A4),A0
02:0004A86C 11802000        	  5681:     move.b  D0,(A0,D2.W)
02:0004A870 0C02000D        	  5682:     cmpi.b  #$0D,D2
02:0004A874 6524            	  5683:     bcs  _L_z07_CheckState30_CatchBoomerang
                            	  5684:     ; Link has caught the boomerang.
                            	  5685:     ;
                            	  5686:     ; Combine Link's state with $20 for having caught the boomerang.
                            	  5687:     ;
                            	  5688:     ; If Link catches it some time after throwing it,
                            	  5689:     ; his state will become $20, and he will show the catch animation.
                            	  5690:     ;
                            	  5691:     ; But if he catches it right after throwing it, the state becomes
                            	  5692:     ; $30 ($10 OR $20), which is the end state of using an item.
                            	  5693:     ;
