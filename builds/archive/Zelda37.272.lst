02:00031ED6 D8BC00FF0000    	   573:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031EDC 2044            	   574:     movea.l D4,A0
02:00031EDE 10303000        	   575:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
