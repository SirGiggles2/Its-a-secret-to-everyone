02:0003B16A D101            	  7056:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B16C 19400001        	  7057:     move.b  D0,($0001,A4)
                            	  7058:     ; Only check the first bomb slot ($10).
                            	  7059:     ;
                            	  7060:     ; Store the bomb's (X + 8) in [02].
                            	  7061:     ;
02:0003B170 7610            	  7062:     moveq   #16,D3
02:0003B172 10343070        	  7063:     move.b  ($70,A4,D3.W),D0
02:0003B176 123C0008        	  7064:     move.b  #$08,D1
02:0003B17A D101            	  7065:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B17C 19400002        	  7066:     move.b  D0,($0002,A4)
                            	  7067:     ; Store the bomb's (Y + 8) in [03].
                            	  7068:     ;
02:0003B180 41EC0084        	  7069:     lea     ($0084,A4),A0
02:0003B184 10303000        	  7070:     move.b  (A0,D3.W),D0
02:0003B188 123C0008        	  7071:     move.b  #$08,D1
02:0003B18C D101            	  7072:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B18E 19400003        	  7073:     move.b  D0,($0003,A4)
                            	  7074:     ; But, if there's no bomb, then return.
                            	  7075:     ;
02:0003B192 41EC00AC        	  7076:     lea     ($00AC,A4),A0
02:0003B196 10303000        	  7077:     move.b  (A0,D3.W),D0
02:0003B19A 6720            	  7078:     beq  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7079:     ; If the bomb has not exploded (state $12), then
                            	  7080:     ; go see if Dodongo will eat it.
                            	  7081:     ;
02:0003B19C 0C000012        	  7082:     cmpi.b  #$12,D0
02:0003B1A0 6602            	  7083:     bne.s  __far_z_04_0065
02:0003B1A2 601A            	  7084:     jmp  Dodongo_TryEatBomb
                            	  7085: __far_z_04_0065:
                            	  7086:     ; If the object in the slot is actually a fire, then return.
                            	  7087:     ;
02:0003B1A4 0C000020        	  7088:     cmpi.b  #$20,D0
02:0003B1A8 6412            	  7089:     bcc  _L_z04_Dodongo_CheckBombHit_Exit
                            	  7090:     ; The bomb already blew up.
                            	  7091:     ; If the dust cloud is in range of the monster,
                            	  7092:     ; then set stunned state (2).
                            	  7093:     ;
02:0003B1AA 7600            	  7094:     moveq   #0,D3
02:0003B1AC 61000082        	  7095:     jsr     Dodongo_IsBombInRange
02:0003B1B0 660A            	  7096:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003B1B2 7002            	  7097:     moveq   #2,D0
02:0003B1B4 41EC00AC        	  7098:     lea     ($00AC,A4),A0
02:0003B1B8 11802000        	  7099:     move.b  D0,(A0,D2.W)
                            	  7100:     even
                            	  7101: _L_z04_Dodongo_CheckBombHit_Exit:
