                            	 13647: TurnTowardsPlayer8:
                            	 13648:     ; Build a direction in [00] towards the player.
                            	 13649:     ;
                            	 13650:     ; First, calculate a horizontal component:
                            	 13651:     ;
                            	 13652:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13653:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13654:     ; else                               [00] := 2 (left)
                            	 13655:     ;
02:0003E186 7600            	 13656:     moveq   #0,D3
02:0003E188 1883            	 13657:     move.b  D3,($0000,A4)
02:0003E18A 5203            	 13658:     addq.b  #1,D3
02:0003E18C 102C0061        	 13659:     move.b  ($0061,A4),D0
02:0003E190 12342070        	 13660:     move.b  ($70,A4,D2.W),D1
02:0003E194 B001            	 13661:     cmp.b   D1,D0
02:0003E196 6706            	 13662:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003E198 6402            	 13663:     bcc  _anon_z04_175
02:0003E19A 5203            	 13664:     addq.b  #1,D3
                            	 13665: _anon_z04_175:
02:0003E19C 1883            	 13666:     move.b  D3,($0000,A4)
                            	 13667:     even
                            	 13668: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 13669:     ; Second, calculate a vertical component.
                            	 13670:     ; Combine it with the horizontal component:
                            	 13671:     ;
                            	 13672:     ; Y := 4 (down)
                            	 13673:     ; if observed player Y <> object Y then
                            	 13674:     ;   if observed player Y < object Y then
                            	 13675:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 13676:     ;   [00] := [00] | Y
                            	 13677:     ;
02:0003E19E 7601            	 13678:     moveq   #1,D3
02:0003E1A0 102C0062        	 13679:     move.b  ($0062,A4),D0
02:0003E1A4 41EC0084        	 13680:     lea     ($0084,A4),A0
02:0003E1A8 12302000        	 13681:     move.b  (A0,D2.W),D1
02:0003E1AC B001            	 13682:     cmp.b   D1,D0
02:0003E1AE 6710            	 13683:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003E1B0 6402            	 13684:     bcc  _anon_z04_176
02:0003E1B2 5203            	 13685:     addq.b  #1,D3
                            	 13686: _anon_z04_176:
02:0003E1B4 1003            	 13687:     move.b  D3,D0
02:0003E1B6 E308            	 13688:     lsl.b  #1,D0   ; ASL A
02:0003E1B8 E308            	 13689:     lsl.b  #1,D0   ; ASL A
02:0003E1BA 1214            	 13690:     move.b  ($0000,A4),D1
02:0003E1BC 8001            	 13691:     or.b  D1,D0
02:0003E1BE 1880            	 13692:     move.b  D0,($0000,A4)
                            	 13693:     even
                            	 13694: _L_z04_TurnTowardsPlayer8_SkipVertical:
                            	 13695:     ; Get the index of the object's direction.
                            	 13696:     ;
02:0003E1C0 610000C2        	 13697:     jsr     GetObjDir8Index
                            	 13698:     ; Check 3 directions turning left:
                            	 13699:     ; 1. right from object direction
                            	 13700:     ; 2. object direction
                            	 13701:     ; 3. left from object direction
                            	 13702:     ;
                            	 13703:     ; If the target direction matches any of these, then
                            	 13704:     ; leave the object's direction alone.
                            	 13705:     ;
02:0003E1C4 7003            	 13706:     moveq   #3,D0
02:0003E1C6 19400001        	 13707:     move.b  D0,($0001,A4)
