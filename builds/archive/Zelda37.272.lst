02:0003C49C 6708            	  9664:     beq  _anon_z04_121
02:0003C49E 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003C4A2 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
