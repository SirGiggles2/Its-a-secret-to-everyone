02:00038870 0A3C0010        	  1330:     eori    #$10,CCR  ; restore X = 6502 C
02:00038874 1940052E        	  1331:     move.b  D0,($052E,A4)
02:00038878 0A3C0001        	  1332:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
