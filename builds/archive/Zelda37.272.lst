                            	  3578: DrawGhiniAndCheckCollisions:
02:00039820 4EB90004B104    	  3579:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00039826 1940000D        	  3580:     move.b  D0,($000D,A4)
                            	  3581:     ; If the direction has an "up" component, then keep the
                            	  3582:     ; frame image 0, and go figure out horizontal flipping.
                            	  3583:     ;
02:0003982A 41EC0098        	  3584:     lea     ($0098,A4),A0
02:0003982E 10302000        	  3585:     move.b  (A0,D2.W),D0
02:00039832 02000008        	  3586:     andi.b #$08,D0
