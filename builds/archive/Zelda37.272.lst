02:0003D95E 123C0004        	 12504:     move.b  #$04,D1
02:0003D962 D101            	 12505:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003D964 19803072        	 12506:     move.b  D0,($72,A4,D3.W)
02:0003D968 41EC0084        	 12507:     lea     ($0084,A4),A0
02:0003D96C 10302000        	 12508:     move.b  (A0,D2.W),D0
02:0003D970 123C0004        	 12509:     move.b  #$04,D1
02:0003D974 D101            	 12510:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003D976 41EC0086        	 12511:     lea     ($0086,A4),A0
02:0003D97A 11803000        	 12512:     move.b  D0,(A0,D3.W)
