02:0003D400 0A3C0010        	 11728:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D404 9101            	 11729:     subx.b  D1,D0   ; SBC ObjX,X
02:0003D406 0A3C0010        	 11730:     eori    #$10,CCR  ; restore X = 6502 C
