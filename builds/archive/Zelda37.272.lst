                            	  6548: Aquamentus_Shoot:
                            	  6549:     ; If the object timer <> 0, then
                            	  6550:     ; go modify fireballs that might still be flying.
                            	  6551:     ;
02:0003ADBE 10342028        	  6552:     move.b  ($28,A4,D2.W),D0
02:0003ADC2 6634            	  6553:     bne  _L_z04_Aquamentus_Shoot_SpreadOutFireballs
                            	  6554:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  6555:     ;
                            	  6556:     ; Set the timer to a random time, at least $70 frames.
                            	  6557:     ;
02:0003ADC4 10342018        	  6558:     move.b  ($18,A4,D2.W),D0
02:0003ADC8 00000070        	  6559:     ori.b #$70,D0
02:0003ADCC 19802028        	  6560:     move.b  D0,($28,A4,D2.W)
                            	  6561:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  6562:     ;
02:0003ADD0 6168            	  6563:     jsr     ShootFireball55
02:0003ADD2 7000            	  6564:     moveq   #0,D0
02:0003ADD4 41EC0478        	  6565:     lea     ($0478,A4),A0
02:0003ADD8 11803000        	  6566:     move.b  D0,(A0,D3.W)
                            	  6567:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  6568:     ;
02:0003ADDC 615C            	  6569:     jsr     ShootFireball55
02:0003ADDE 7001            	  6570:     moveq   #1,D0
02:0003ADE0 41EC0478        	  6571:     lea     ($0478,A4),A0
02:0003ADE4 11803000        	  6572:     move.b  D0,(A0,D3.W)
                            	  6573:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  6574:     ;
02:0003ADE8 6150            	  6575:     jsr     ShootFireball55
02:0003ADEA 103C00FF        	  6576:     move.b  #$FF,D0
02:0003ADEE 41EC0478        	  6577:     lea     ($0478,A4),A0
02:0003ADF2 11803000        	  6578:     move.b  D0,(A0,D3.W)
02:0003ADF6 4E75            	  6579:     rts
