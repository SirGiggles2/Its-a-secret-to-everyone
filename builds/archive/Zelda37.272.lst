02:0003B378 1600            	  7409:     move.b  D0,D3
                            	  7410:     ; If facing vertically, then return. There's no other side to draw.
                            	  7411:     ;
02:0003B37A 41EC0098        	  7412:     lea     ($0098,A4),A0
