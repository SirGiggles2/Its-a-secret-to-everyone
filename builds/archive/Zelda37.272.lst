02:000397BC 41EC0098        	  3521:     lea     ($0098,A4),A0
02:000397C0 10302000        	  3522:     move.b  (A0,D2.W),D0
02:000397C4 0200000C        	  3523:     andi.b #$0C,D0
02:000397C8 660E            	  3524:     bne  _L_z04_UpdateOctorock_DrawMirrored
                            	  3525:     ; Else draw not mirrored.
