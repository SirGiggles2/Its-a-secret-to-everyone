02:00031EA2 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:00031EA6 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031EAA E14C            	   559:     lsl.w   #8,D4
02:00031EAC 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031EAE 48C4            	   561:     ext.l   D4
02:00031EB0 D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031EB6 2044            	   563:     movea.l D4,A0
02:00031EB8 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031EBC 41EC0630        	   565:     lea     ($0630,A4),A0
02:00031EC0 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00031EC4 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00031EC8 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00031ECC 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031ED0 E14C            	   570:     lsl.w   #8,D4
02:00031ED2 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
