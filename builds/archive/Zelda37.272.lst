02:0003D40C 122C0002        	 11732:     move.b  ($0002,A4),D1
02:0003D410 E309            	 11733:     lsl.b  #1,D1   ; ASL $02
02:0003D412 19410002        	 11734:     move.b  D1,($0002,A4)
