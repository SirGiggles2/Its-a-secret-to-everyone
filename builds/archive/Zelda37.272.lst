02:0004B692 41EC04BF        	  7495:     lea     ($04BF,A4),A0
02:0004B696 11802000        	  7496:     move.b  D0,(A0,D2.W)
02:0004B69A 1003            	  7497:     move.b  D3,D0
02:0004B69C 1880            	  7498:     move.b  D0,($0000,A4)
                            	  7499:     ; Hit points are packed two values to a byte.
