02:000491F2 123C0002        	  2412:     move.b  #$02,D1
02:000491F6 D101            	  2413:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:000491F8 41EC030A        	  2414:     lea     ($030A,A4),A0
02:000491FC 11802000        	  2415:     move.b  D0,(A0,D2.W)
02:00049200 41EC030B        	  2416:     lea     ($030B,A4),A0
02:00049204 11802000        	  2417:     move.b  D0,(A0,D2.W)
02:00049208 41EC0306        	  2418:     lea     ($0306,A4),A0
02:0004920C 52302000        	  2419:     addq.b  #1,(A0,D2.W)
02:00049210 41EC030B        	  2420:     lea     ($030B,A4),A0
02:00049214 52302000        	  2421:     addq.b  #1,(A0,D2.W)
