02:0003A5FA 11803000        	  5498:     move.b  D0,(A0,D3.W)
                            	  5499:     ; Copy HP from the first monster slot.
                            	  5500:     ;
02:0003A5FE 102C0486        	  5501:     move.b  ($0486,A4),D0
02:0003A602 41EC0486        	  5502:     lea     ($0486,A4),A0
02:0003A606 11803000        	  5503:     move.b  D0,(A0,D3.W)
                            	  5504:     ; Start with flying speed $80, and in flying state 2.
                            	  5505:     ;
02:0003A60A 103C0080        	  5506:     move.b  #$80,D0
02:0003A60E 41EC0420        	  5507:     lea     ($0420,A4),A0
02:0003A612 11803000        	  5508:     move.b  D0,(A0,D3.W)
02:0003A616 7002            	  5509:     moveq   #2,D0
02:0003A618 41EC0445        	  5510:     lea     ($0445,A4),A0
02:0003A61C 11803000        	  5511:     move.b  D0,(A0,D3.W)
02:0003A620 7041            	  5512:     moveq   #65,D0
02:0003A622 41EC0350        	  5513:     lea     ($0350,A4),A0
02:0003A626 11803000        	  5514:     move.b  D0,(A0,D3.W)
                            	  5515:     ; Bottom of the loop.
                            	  5516:     ;
02:0003A62A 5303            	  5517:     subq.b  #1,D3
02:0003A62C 6A90            	  5518:     bpl  _anon_z04_77
                            	  5519:     ; Choose a random 8-way direction for the head segments
                            	  5520:     ; in slots 4 and 9.
                            	  5521:     ;
02:0003A62E 102C001D        	  5522:     move.b  ($001D,A4),D0
02:0003A632 02000007        	  5523:     andi.b #$07,D0
02:0003A636 7600            	  5524:     moveq   #0,D3
02:0003A638 1600            	  5525:     move.b  D0,D3
02:0003A63A 41F90003E016    	  5526:     lea     (Directions8).l,A0
02:0003A640 10303000        	  5527:     move.b  (A0,D3.W),D0
02:0003A644 1940009D        	  5528:     move.b  D0,($009D,A4)
02:0003A648 19400385        	  5529:     move.b  D0,($0385,A4)
02:0003A64C 102C0022        	  5530:     move.b  ($0022,A4),D0
02:0003A650 02000007        	  5531:     andi.b #$07,D0
02:0003A654 7600            	  5532:     moveq   #0,D3
02:0003A656 1600            	  5533:     move.b  D0,D3
02:0003A658 41F90003E016    	  5534:     lea     (Directions8).l,A0
02:0003A65E 10303000        	  5535:     move.b  (A0,D3.W),D0
02:0003A662 194000A2        	  5536:     move.b  D0,($00A2,A4)
02:0003A666 1940038A        	  5537:     move.b  D0,($038A,A4)
                            	  5538:     ; Set minimum number of turns 1 for flying states.
                            	  5539:     ;
                            	  5540:     ; By setting this, the first time that a flight control routine
                            	  5541:     ; (Flyer_Chase, Flyer_Wander) is called and returns;
                            	  5542:     ; that flying state will immediately end, and object timer
