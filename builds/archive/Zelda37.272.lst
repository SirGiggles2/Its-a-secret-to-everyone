                            	  5568: UpdateMoldorm:
                            	  5569:     ; If facing direction = 0, return.
                            	  5570:     ;
02:0003A69C 41EC0098        	  5571:     lea     ($0098,A4),A0
02:0003A6A0 10302000        	  5572:     move.b  (A0,D2.W),D0
02:0003A6A4 670000C2        	  5573:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5574:     ; If the magic clock is missing, then move around (using the flying mechanism).
