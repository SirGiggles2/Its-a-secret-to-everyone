                            	  7748: __far_z_07_0125:
                            	  7749:     ; So, every 8 frames:
                            	  7750:     ; 1. Increment the secret color cycle count.
                            	  7751:     ; 2. Change the water palette.
                            	  7752:     ;
                            	  7753:     ; But when the count = $B, go reveal the stairs.
                            	  7754:     ;
02:0004B93C 522C051A        	  7755:     addq.b  #1,($051A,A4)
02:0004B940 0C03000B        	  7756:     cmpi.b  #$0B,D3
02:0004B944 6602            	  7757:     bne.s  __far_z_07_0126
02:0004B946 6042            	  7758:     jmp  RevealPondStairs
