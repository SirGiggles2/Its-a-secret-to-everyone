                            	   298: UpdateMenuScrollDownUW:
02:0003E5FC 61004996        	   299:     jsr     Submenu_CueTransferRowUW
                            	   300: _anon_z05_2:
                            	   301:     ; Move position markers and advance nametable scrolling;
                            	   302:     ; so that we scroll down 3 pixels.
                            	   303:     ;
02:0003E600 7003            	   304:     moveq   #3,D0
02:0003E602 6100015C        	   305:     jsr     MovePositionMarkers
02:0003E606 102C00FC        	   306:     move.b  ($00FC,A4),D0
02:0003E60A 003C0011        	   307:     ori     #$11,CCR  ; SEC: set C+X
02:0003E60E 123C0003        	   308:     move.b  #$03,D1
02:0003E612 0A3C0010        	   309:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E616 9101            	   310:     subx.b  D1,D0   ; SBC #$03
02:0003E618 0A3C0010        	   311:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E61C 194000FC        	   312:     move.b  D0,($00FC,A4)
                            	   313:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   314:     ;
02:0003E620 0C000041        	   315:     cmpi.b  #$41,D0
02:0003E624 66000090        	   316:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   317:     ; VScroll reached $41.
                            	   318:     ; Advance the submenu state.
                            	   319:     ; If in OW or in a cellar, we're done. Return.
                            	   320:     ;
02:0003E628 522C00E1        	   321:     addq.b  #1,($00E1,A4)
02:0003E62C 102C0010        	   322:     move.b  ($0010,A4),D0
02:0003E630 67000084        	   323:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:0003E634 102C0012        	   324:     move.b  ($0012,A4),D0
02:0003E638 0C000009        	   325:     cmpi.b  #$09,D0
02:0003E63C 6778            	   326:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   327:     ; Calculate the X coordinate of the submenu position marker.
                            	   328:     ;
                            	   329:     ; First, mask off the high nibble of the room ID and multiply by
                            	   330:     ; the width of a tile, 8. Store the result in [00].
                            	   331:     ;
02:0003E63E 102C00EB        	   332:     move.b  ($00EB,A4),D0
02:0003E642 0200000F        	   333:     andi.b #$0F,D0
02:0003E646 E308            	   334:     lsl.b  #1,D0   ; ASL A
02:0003E648 E308            	   335:     lsl.b  #1,D0   ; ASL A
02:0003E64A E308            	   336:     lsl.b  #1,D0   ; ASL A
02:0003E64C 1880            	   337:     move.b  D0,($0000,A4)
                            	   338:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   339:     ; negative or left rotation by ($10 - rotation value).
                            	   340:     ;
                            	   341:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   342:     ; the width of a tile. Then negate it. The final result is the
                            	   343:     ; negative offset.
                            	   344:     ;
02:0003E64E 103900FF6BAB    	   345:     move.b  (NES_SRAM+$0BAB).l,D0
02:0003E654 0C000008        	   346:     cmpi.b  #$08,D0
02:0003E658 6520            	   347:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:0003E65A 7010            	   348:     moveq   #16,D0
02:0003E65C 123900FF6BAB    	   349:     move.b  (NES_SRAM+$0BAB).l,D1
02:0003E662 0A3C0010        	   350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003E666 9101            	   351:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:0003E668 0A3C0010        	   352:     eori    #$10,CCR  ; restore X = 6502 C
02:0003E66C E308            	   353:     lsl.b  #1,D0   ; ASL A
02:0003E66E E308            	   354:     lsl.b  #1,D0   ; ASL A
02:0003E670 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:0003E672 4EB9000304B0    	   356:     jsr     Negate
02:0003E678 6006            	   357:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   358: 
                            	   359:     even
                            	   360: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   361:     ; The submenu map's rotation < 8.
                            	   362:     ; It represents the number of tiles to move right.
                            	   363:     ; So, multiply it by 8.
                            	   364:     ;
02:0003E67A E308            	   365:     lsl.b  #1,D0   ; ASL A
02:0003E67C E308            	   366:     lsl.b  #1,D0   ; ASL A
02:0003E67E E308            	   367:     lsl.b  #1,D0   ; ASL A
                            	   368:     even
                            	   369: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   370:     ; Add the offset we calculated, and $62 to [00] to get
                            	   371:     ; the position marker's X coordinate.
                            	   372:     ;
02:0003E680 023C00EE        	   373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E684 1214            	   374:     move.b  ($0000,A4),D1
02:0003E686 D101            	   375:     addx.b  D1,D0   ; ADC $00
02:0003E688 023C00EE        	   376:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E68C 123C0062        	   377:     move.b  #$62,D1
02:0003E690 D101            	   378:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:0003E692 19400253        	   379:     move.b  D0,($0253,A4)
                            	   380:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   381:     ; Divide by 2 to get a multiple of the tile height.
                            	   382:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   383:     ;
02:0003E696 102C00EB        	   384:     move.b  ($00EB,A4),D0
02:0003E69A 020000F0        	   385:     andi.b #$F0,D0
02:0003E69E E208            	   386:     lsr.b  #1,D0   ; LSR A
02:0003E6A0 123C0069        	   387:     move.b  #$69,D1
02:0003E6A4 D101            	   388:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:0003E6A6 19400250        	   389:     move.b  D0,($0250,A4)
                            	   390:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   391:     ;
02:0003E6AA 703E            	   392:     moveq   #62,D0
02:0003E6AC 19400251        	   393:     move.b  D0,($0251,A4)
02:0003E6B0 7000            	   394:     moveq   #0,D0
02:0003E6B2 19400252        	   395:     move.b  D0,($0252,A4)
                            	   396:     even
                            	   397: _L_z05_UpdateMenuScrollDownUW_Exit:
02:0003E6B6 4E75            	   398:     rts
                            	   399: 
                            	   400:     even
                            	   401: UpdateMenuActive:
02:0003E6B8 61005046        	   402:     jsr     DrawSubmenuItems
02:0003E6BC 6100510A        	   403:     jsr     UpdateSubmenuSelection
                            	   404:     ; If buttons Up and A are down on the second controller, then
                            	   405:     ; 1. reset submenu state
                            	   406:     ; 2. go to mode 8
                            	   407:     ; 3. silence sound
                            	   408:     ;
02:0003E6C0 102C00FB        	   409:     move.b  ($00FB,A4),D0
02:0003E6C4 02000088        	   410:     andi.b #$88,D0
02:0003E6C8 0C000088        	   411:     cmpi.b  #$88,D0
02:0003E6CC 661A            	   412:     bne  _anon_z05_3
02:0003E6CE 4EB9000496B0    	   413:     jsr     EndGameMode
02:0003E6D4 194000E1        	   414:     move.b  D0,($00E1,A4)
02:0003E6D8 7008            	   415:     moveq   #8,D0
02:0003E6DA 19400012        	   416:     move.b  D0,($0012,A4)
02:0003E6DE 7000            	   417:     moveq   #0,D0
02:0003E6E0 19400619        	   418:     move.b  D0,($0619,A4)
02:0003E6E4 600012CE        	   419:     jmp     SilenceSound
                            	   420: 
                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:0003E6E8 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0003E6EC 02000010        	   426:     andi.b #$10,D0
02:0003E6F0 6606            	   427:     bne.s  __far_z_05_0000
02:0003E6F2 4EF90002DDAE    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:0003E6F8 102C0254        	   430:     move.b  ($0254,A4),D0
02:0003E6FC 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0003E6FE 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003E702 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003E704 4EB900048CF4    	   434:     jsr     HideAllSprites
02:0003E70A 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0003E70C 19400258        	   436:     move.b  D0,($0258,A4)
02:0003E710 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:0003E712 19400254        	   438:     move.b  D0,($0254,A4)
02:0003E716 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0003E71A 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003E71E 4E75            	   441:     rts
                            	   442: 
