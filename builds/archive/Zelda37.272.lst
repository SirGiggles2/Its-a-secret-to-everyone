02:00039798 41EC03E4        	  3504:     lea     ($03E4,A4),A0
02:0003979C 12302000        	  3505:     move.b  (A0,D2.W),D1
02:000397A0 B300            	  3506:     eor.b  D1,D0
02:000397A2 41EC03E4        	  3507:     lea     ($03E4,A4),A0
02:000397A6 11802000        	  3508:     move.b  D0,(A0,D2.W)
                            	  3509:     even
                            	  3510: _L_z04_UpdateOctorock_CalcFinalOffset:
                            	  3511:     ; Add the base offset and the directional offset, and save the result.
