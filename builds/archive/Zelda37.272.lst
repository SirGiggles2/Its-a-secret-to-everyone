                            	  7736: UpdatePolsVoiceState1_Jumping:
                            	  7737:     ; Add acceleration $38 to low speed byte (vertical).
                            	  7738:     ;
02:0003B5F0 41EC0444        	  7739:     lea     ($0444,A4),A0
02:0003B5F4 10302000        	  7740:     move.b  (A0,D2.W),D0
02:0003B5F8 023C00EE        	  7741:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B5FC 123C0038        	  7742:     move.b  #$38,D1
02:0003B600 D101            	  7743:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003B602 41EC0444        	  7744:     lea     ($0444,A4),A0
02:0003B606 11802000        	  7745:     move.b  D0,(A0,D2.W)
                            	  7746:     ; Add Carry to high speed byte (vertical).
                            	  7747:     ;
02:0003B60A 41EC0412        	  7748:     lea     ($0412,A4),A0
02:0003B60E 10302000        	  7749:     move.b  (A0,D2.W),D0
02:0003B612 123C0000        	  7750:     move.b  #$00,D1
02:0003B616 D101            	  7751:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003B618 41EC0412        	  7752:     lea     ($0412,A4),A0
02:0003B61C 11802000        	  7753:     move.b  D0,(A0,D2.W)
                            	  7754:     ; Add high speed byte to Y coordinate.
                            	  7755:     ;
02:0003B620 023C00EE        	  7756:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B624 41EC0084        	  7757:     lea     ($0084,A4),A0
02:0003B628 12302000        	  7758:     move.b  (A0,D2.W),D1
02:0003B62C D101            	  7759:     addx.b  D1,D0   ; ADC ObjY,X
02:0003B62E 41EC0084        	  7760:     lea     ($0084,A4),A0
02:0003B632 11802000        	  7761:     move.b  D0,(A0,D2.W)
                            	  7762:     ; If the speed is still negative, then return.
                            	  7763:     ;
02:0003B636 41EC0412        	  7764:     lea     ($0412,A4),A0
02:0003B63A 10302000        	  7765:     move.b  (A0,D2.W),D0
02:0003B63E 6B0000AC        	  7766:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7767:     ; If Y coordinate still < target Y, then return.
                            	  7768:     ;
02:0003B642 41EC0084        	  7769:     lea     ($0084,A4),A0
02:0003B646 10302000        	  7770:     move.b  (A0,D2.W),D0
02:0003B64A 41EC042C        	  7771:     lea     ($042C,A4),A0
02:0003B64E 12302000        	  7772:     move.b  (A0,D2.W),D1
02:0003B652 B001            	  7773:     cmp.b   D1,D0
02:0003B654 65000096        	  7774:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  7775:     ; Else reached the destination. Go to state 0.
                            	  7776:     ;
02:0003B658 7000            	  7777:     moveq   #0,D0
02:0003B65A 41EC00AC        	  7778:     lea     ($00AC,A4),A0
02:0003B65E 11802000        	  7779:     move.b  D0,(A0,D2.W)
                            	  7780:     ; Reset 16-bit vertical speed.
                            	  7781:     ;
02:0003B662 41EC0444        	  7782:     lea     ($0444,A4),A0
02:0003B666 11802000        	  7783:     move.b  D0,(A0,D2.W)
02:0003B66A 41EC0412        	  7784:     lea     ($0412,A4),A0
02:0003B66E 11802000        	  7785:     move.b  D0,(A0,D2.W)
                            	  7786:     ; Choose a random direction to face in.
                            	  7787:     ;
02:0003B672 10342018        	  7788:     move.b  ($18,A4,D2.W),D0
02:0003B676 02000003        	  7789:     andi.b #$03,D0
02:0003B67A 7600            	  7790:     moveq   #0,D3
02:0003B67C 1600            	  7791:     move.b  D0,D3
02:0003B67E 41F90003B48E    	  7792:     lea     (PolsVoiceDirections).l,A0
02:0003B684 10303000        	  7793:     move.b  (A0,D3.W),D0
02:0003B688 41EC0098        	  7794:     lea     ($0098,A4),A0
02:0003B68C 11802000        	  7795:     move.b  D0,(A0,D2.W)
                            	  7796:     ; Randomly set distance-to-move to $30 or $70.
                            	  7797:     ;
02:0003B690 10342018        	  7798:     move.b  ($18,A4,D2.W),D0
02:0003B694 02000040        	  7799:     andi.b #$40,D0
02:0003B698 123C0030        	  7800:     move.b  #$30,D1
02:0003B69C D101            	  7801:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003B69E 41EC0394        	  7802:     lea     ($0394,A4),A0
02:0003B6A2 11802000        	  7803:     move.b  D0,(A0,D2.W)
                            	  7804:     ; Align the monster with a square horizontally.
                            	  7805:     ;
                            	  7806:     ; If in the left half of a square, align with that square.
                            	  7807:     ; If in the right half, align with the next square.
                            	  7808:     ;
02:0003B6A6 10342070        	  7809:     move.b  ($70,A4,D2.W),D0
02:0003B6AA 023C00EE        	  7810:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6AE 123C0008        	  7811:     move.b  #$08,D1
02:0003B6B2 D101            	  7812:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B6B4 020000F0        	  7813:     andi.b #$F0,D0
02:0003B6B8 19802070        	  7814:     move.b  D0,($70,A4,D2.W)
                            	  7815:     ; Align the monster with a square vertically.
                            	  7816:     ;
                            	  7817:     ; If in the top half of a square, align with that square.
                            	  7818:     ; If in the bottom half, align with the next square.
                            	  7819:     ;
02:0003B6BC 41EC0084        	  7820:     lea     ($0084,A4),A0
02:0003B6C0 10302000        	  7821:     move.b  (A0,D2.W),D0
02:0003B6C4 023C00EE        	  7822:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B6C8 123C0008        	  7823:     move.b  #$08,D1
02:0003B6CC D101            	  7824:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003B6CE 020000F0        	  7825:     andi.b #$F0,D0
                            	  7826:     ; Make sure the lower nibble of Y is $D as usual.
                            	  7827:     ;
02:0003B6D2 003C0011        	  7828:     ori     #$11,CCR  ; SEC: set C+X
02:0003B6D6 123C0003        	  7829:     move.b  #$03,D1
02:0003B6DA 0A3C0010        	  7830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B6DE 9101            	  7831:     subx.b  D1,D0   ; SBC #$03
02:0003B6E0 0A3C0010        	  7832:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B6E4 41EC0084        	  7833:     lea     ($0084,A4),A0
02:0003B6E8 11802000        	  7834:     move.b  D0,(A0,D2.W)
                            	  7835:     even
