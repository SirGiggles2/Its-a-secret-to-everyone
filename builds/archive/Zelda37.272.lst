                            	  3693: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3694:     ; Loop to look for a place to spawn a monster from the edge
                            	  3695:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3696:     ;
                            	  3697:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3698:     ; We'll move down $10 pixels.
                            	  3699:     ;
02:00040302 7610            	  3700:     moveq   #16,D3
02:00040304 102C000A        	  3701:     move.b  ($000A,A4),D0
02:00040308 0200000F        	  3702:     andi.b #$0F,D0
02:0004030C 670A            	  3703:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3704:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3705:     ; Don't move vertically.
                            	  3706:     ;
02:0004030E 163C00F0        	  3707:     move.b  #$F0,D3
02:00040312 0C00000F        	  3708:     cmpi.b  #$0F,D0
02:00040316 6610            	  3709:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3710:     even
                            	  3711: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3712:     ; Else low nibble = $F. We're at the right edge,
                            	  3713:     ; and we'll move up $10 pixels.
                            	  3714:     ;
02:00040318 1003            	  3715:     move.b  D3,D0
02:0004031A 023C00EE        	  3716:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004031E 122C000A        	  3717:     move.b  ($000A,A4),D1
02:00040322 D101            	  3718:     addx.b  D1,D0   ; ADC $0A
02:00040324 1940000A        	  3719:     move.b  D0,($000A,A4)
                            	  3720:     even
                            	  3721: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3722:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3723:     ; Move right one pixel.
                            	  3724:     ;
02:00040328 102C000A        	  3725:     move.b  ($000A,A4),D0
02:0004032C 020000F0        	  3726:     andi.b #$F0,D0
02:00040330 0C0000E0        	  3727:     cmpi.b  #$E0,D0
02:00040334 6606            	  3728:     bne  _anon_z05_88
02:00040336 522C000A        	  3729:     addq.b  #1,($000A,A4)
02:0004033A 600A            	  3730:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3731: 
                            	  3732: _anon_z05_88:
                            	  3733:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3734:     ; Dont' move horizontally.
                            	  3735:     ;
02:0004033C 0C000040        	  3736:     cmpi.b  #$40,D0
02:00040340 6604            	  3737:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3738:     ; Else high nibble = 4. We're at the top edge.
                            	  3739:     ; Move left 1 pixel.
                            	  3740:     ;
02:00040342 532C000A        	  3741:     subq.b  #1,($000A,A4)
                            	  3742:     even
                            	  3743: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3744:     ; Time to get the address of the column.
                            	  3745:     ; Starting at the top of the leftmost column.
                            	  3746:     ;
02:00040346 61002590        	  3747:     jsr     FetchTileMapAddr
02:0004034A 7005            	  3748:     moveq   #5,D0
02:0004034C 4EB90002A9FA    	  3749:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3750:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3751:     ; in order to point to the column we want.
                            	  3752:     ;
02:00040352 102C000A        	  3753:     move.b  ($000A,A4),D0
02:00040356 0200000F        	  3754:     andi.b #$0F,D0
02:0004035A 7600            	  3755:     moveq   #0,D3
02:0004035C 1600            	  3756:     move.b  D0,D3
02:0004035E 670C            	  3757:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3758: _anon_z05_89:
