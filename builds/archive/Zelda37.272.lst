                            	  1320: UpdateTrap_Full:
02:00030228 41EC00AC        	  1321:     lea     ($00AC,A4),A0
02:0003022C 10302000        	  1322:     move.b  (A0,D2.W),D0
02:00030230 660000B2        	  1323:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  1324:     ; State 0. Sensing.
                            	  1325:     ;
                            	  1326:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  1327:     ; then go see if the horizontal distance is shorter.
                            	  1328:     ;
02:00030234 102C0084        	  1329:     move.b  ($0084,A4),D0
02:00030238 003C0011        	  1330:     ori     #$11,CCR  ; SEC: set C+X
02:0003023C 41EC0084        	  1331:     lea     ($0084,A4),A0
02:00030240 12302000        	  1332:     move.b  (A0,D2.W),D1
02:00030244 0A3C0010        	  1333:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030248 9101            	  1334:     subx.b  D1,D0   ; SBC ObjY,X
02:0003024A 0A3C0010        	  1335:     eori    #$10,CCR  ; restore X = 6502 C
02:0003024E 6100025C        	  1336:     jsr     Abs
02:00030252 0C00000E        	  1337:     cmpi.b  #$0E,D0
02:00030256 644C            	  1338:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  1339:     ; Determine the horizontal direction toward Link;
                            	  1340:     ; and if Link and the trap are at the same X, then we can't move
                            	  1341:     ; along this axis. Go see about moving vertically.
                            	  1342:     ;
02:00030258 7601            	  1343:     moveq   #1,D3
02:0003025A 102C0070        	  1344:     move.b  ($0070,A4),D0
02:0003025E 12342070        	  1345:     move.b  ($70,A4,D2.W),D1
02:00030262 B001            	  1346:     cmp.b   D1,D0
02:00030264 673E            	  1347:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
02:00030266 6402            	  1348:     bcc  _anon_z01_26
02:00030268 7602            	  1349:     moveq   #2,D3
                            	  1350: _anon_z01_26:
                            	  1351:     ; Remember the original X coordinate.
                            	  1352:     ;
02:0003026A 10342070        	  1353:     move.b  ($70,A4,D2.W),D0
                            	  1354:     even
                            	  1355: _L_z01_UpdateTrap_Full_GoToState1:
02:0003026E 41EC0380        	  1356:     lea     ($0380,A4),A0
02:00030272 11802000        	  1357:     move.b  D0,(A0,D2.W)
                            	  1358:     ; Set facing direction to the horizontal one that we determined.
                            	  1359:     ;
02:00030276 1003            	  1360:     move.b  D3,D0
02:00030278 41EC0098        	  1361:     lea     ($0098,A4),A0
02:0003027C 11802000        	  1362:     move.b  D0,(A0,D2.W)
                            	  1363:     ; If the direction we determined is not allowed for this trap, then
                            	  1364:     ; go draw and check collisions.
                            	  1365:     ;
02:00030280 41F900030221    	  1366:     lea     (TrapAllowedDirs-1).l,A0
02:00030286 12302000        	  1367:     move.b  (A0,D2.W),D1
02:0003028A C001            	  1368:     and.b  D1,D0
02:0003028C 6712            	  1369:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1370:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
