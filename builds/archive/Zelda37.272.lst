02:00039530 41EC0098        	  3177:     lea     ($0098,A4),A0
02:00039534 10302000        	  3178:     move.b  (A0,D2.W),D0
02:00039538 0200000C        	  3179:     andi.b #$0C,D0
02:0003953C 6742            	  3180:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3181:     ; Begin with the leever's X set to Link's X.
                            	  3182:     ;
