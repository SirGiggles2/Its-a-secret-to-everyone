02:00032D32 10303000        	  1706:     move.b  (A0,D3.W),D0
02:00032D36 19400438        	  1707:     move.b  D0,($0438,A4)
02:00032D3A 0C03000E        	  1708:     cmpi.b  #$0E,D3
02:00032D3E 650E            	  1709:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
