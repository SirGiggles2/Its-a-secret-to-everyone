02:0002BF88 08000008        	  2422:     btst    #8,D0
02:0002BF8C 670A            	  2423:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2424:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2425:     eori    #$01,CCR
02:0002BF96 4E75            	  2426:     rts
                            	  2427: .cc_cnr:
02:0002BF98 023C00FE        	  2428:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2429:     eori    #$01,CCR
02:0002BFA0 4E75            	  2430:     rts
