                            	 12571: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12572:     ; Draw the four clouds at diagonal corners.
                            	 12573:     ;
02:0003D9EC 610000B6        	 12574:     jsr     Ganon_GetCurCloudLeft
02:0003D9F0 610000BE        	 12575:     jsr     Ganon_GetCurCloudTop
02:0003D9F4 61A0            	 12576:     jsr     Ganon_DrawCloud
02:0003D9F6 610000B2        	 12577:     jsr     Ganon_GetCurCloudRight
02:0003D9FA 619A            	 12578:     jsr     Ganon_DrawCloud
02:0003D9FC 610000A6        	 12579:     jsr     Ganon_GetCurCloudLeft
