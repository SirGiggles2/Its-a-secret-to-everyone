                            	  7922: _L_z04_UpdateLikeLike_HandleCaptured:
                            	  7923:     ; Animate up to frame 3. Then stay there.
                            	  7924:     ;
02:0003B7A4 7002            	  7925:     moveq   #2,D0
02:0003B7A6 41EC03E4        	  7926:     lea     ($03E4,A4),A0
02:0003B7AA 12302000        	  7927:     move.b  (A0,D2.W),D1
02:0003B7AE B001            	  7928:     cmp.b   D1,D0
02:0003B7B0 651C            	  7929:     bcs  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003B7B2 41EC03D0        	  7930:     lea     ($03D0,A4),A0
02:0003B7B6 53302000        	  7931:     subq.b  #1,(A0,D2.W)
02:0003B7BA 6612            	  7932:     bne  _L_z04_UpdateLikeLike_IncCaptureTime
02:0003B7BC E308            	  7933:     lsl.b  #1,D0   ; ASL A
02:0003B7BE 41EC03D0        	  7934:     lea     ($03D0,A4),A0
02:0003B7C2 11802000        	  7935:     move.b  D0,(A0,D2.W)
02:0003B7C6 41EC03E4        	  7936:     lea     ($03E4,A4),A0
02:0003B7CA 52302000        	  7937:     addq.b  #1,(A0,D2.W)
                            	  7938:     even
                            	  7939: _L_z04_UpdateLikeLike_IncCaptureTime:
                            	  7940:     ; Increment capture time.
                            	  7941:     ;
02:0003B7CE 41EC042C        	  7942:     lea     ($042C,A4),A0
02:0003B7D2 52302000        	  7943:     addq.b  #1,(A0,D2.W)
                            	  7944:     ; Once capture time >= $60 screen frames, remove the magic shield.
                            	  7945:     ;
02:0003B7D6 41EC042C        	  7946:     lea     ($042C,A4),A0
02:0003B7DA 10302000        	  7947:     move.b  (A0,D2.W),D0
02:0003B7DE 0C000060        	  7948:     cmpi.b  #$60,D0
02:0003B7E2 6512            	  7949:     bcs  _L_z04_UpdateLikeLike_DrawAfterCapture
02:0003B7E4 7000            	  7950:     moveq   #0,D0
02:0003B7E6 19400676        	  7951:     move.b  D0,($0676,A4)
                            	  7952:     ; Set a value above $60 over and over.
                            	  7953:     ;
02:0003B7EA 103C00C0        	  7954:     move.b  #$C0,D0
02:0003B7EE 41EC042C        	  7955:     lea     ($042C,A4),A0
02:0003B7F2 11802000        	  7956:     move.b  D0,(A0,D2.W)
                            	  7957:     even
                            	  7958: _L_z04_UpdateLikeLike_DrawAfterCapture:
                            	  7959:     ; In this state, we have to draw Like-like over Link.
                            	  7960:     ; So, don't use the usual sprite writing code that cycles sprites.
                            	  7961:     ;
02:0003B7F6 4EB90004B104    	  7962:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B7FC 41EC03E4        	  7963:     lea     ($03E4,A4),A0
02:0003B800 10302000        	  7964:     move.b  (A0,D2.W),D0
02:0003B804 6100CD26        	  7965:     jsr     DrawObjectMirroredOverLink
                            	  7966:     ; Check object collisions.
                            	  7967:     ; If this monster hasn't died, then return.
                            	  7968:     ;
02:0003B808 4EB900030BE4    	  7969:     jsr     CheckMonsterCollisions
02:0003B80E 41EC0405        	  7970:     lea     ($0405,A4),A0
02:0003B812 10302000        	  7971:     move.b  (A0,D2.W),D0
02:0003B816 678A            	  7972:     beq  _L_z04_UpdateLikeLike_Exit
                            	  7973:     ; But once it has died, then let Link move again.
                            	  7974:     ;
02:0003B818 7000            	  7975:     moveq   #0,D0
02:0003B81A 19400512        	  7976:     move.b  D0,($0512,A4)
02:0003B81E 6000CD02        	  7977:     jmp     HideSpritesOverLink
                            	  7978: 
                            	  7979:     even
