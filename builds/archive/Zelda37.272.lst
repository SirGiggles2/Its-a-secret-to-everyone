02:0003CCBA 1002            	 10740:     move.b  D2,D0
02:0003CCBC 1B00            	 10741:     move.b  D0,-(A5)  ; PHA
                            	 10742:     ; If the segment is not a head, then skip making a flying head.
                            	 10743:     ;
                            	 10744:     ; TODO:
                            	 10745:     ; But how can we get here in this case, since earlier branches
                            	 10746:     ; would have been taken to skip all this for all other segments?
