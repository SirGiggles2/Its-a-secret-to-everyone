02:00038406 7600            	   729:     moveq   #0,D3
02:00038408 102C0084        	   730:     move.b  ($0084,A4),D0
02:0003840C 023C00EE        	   731:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038410 123C0003        	   732:     move.b  #$03,D1
02:00038414 D101            	   733:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038416 003C0011        	   734:     ori     #$11,CCR  ; SEC: set C+X
02:0003841A 41EC0084        	   735:     lea     ($0084,A4),A0
02:0003841E 12302000        	   736:     move.b  (A0,D2.W),D1
