                            	  3339: _L_z05_CheckSubroom_InCave:
                            	  3340:     ; In a cave.
                            	  3341:     ;
                            	  3342:     ; Check whether a person is blocking the upper half of the room.
                            	  3343:     ;
02:000400D8 1B00            	  3344:     move.b  D0,-(A5)  ; PHA
02:000400DA 4EB90003045E    	  3345:     jsr     CheckPersonBlocking
02:000400E0 101D            	  3346:     move.b  (A5)+,D0  ; PLA
                            	  3347:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3348:     ;
02:000400E2 0C00000C        	  3349:     cmpi.b  #$0C,D0
02:000400E6 6704            	  3350:     beq.s  __far_z_05_0059
02:000400E8 60000082        	  3351:     jmp  CheckCaveEdge
                            	  3352: __far_z_05_0059:
                            	  3353:     ; In a shortcut cave (mode $C).
                            	  3354:     ;
                            	  3355:     ; If grid offset <> 0, return.
                            	  3356:     ;
02:000400EC 102C0394        	  3357:     move.b  ($0394,A4),D0
02:000400F0 6702            	  3358:     beq.s  __far_z_05_0060
02:000400F2 6076            	  3359:     jmp  L14F72_Exit
                            	  3360: __far_z_05_0060:
                            	  3361:     ; If Link's Y <> $9D, go check the screen edge.
                            	  3362:     ;
02:000400F4 102C0084        	  3363:     move.b  ($0084,A4),D0
02:000400F8 0C00009D        	  3364:     cmpi.b  #$9D,D0
02:000400FC 6702            	  3365:     beq.s  __far_z_05_0061
02:000400FE 606C            	  3366:     jmp  CheckCaveEdge
                            	  3367: __far_z_05_0061:
                            	  3368:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3369:     ; X = $50: 1
                            	  3370:     ; X = $80: 2
                            	  3371:     ; X = $B0: 3
                            	  3372:     ;
                            	  3373:     ; If he's not on any, then return.
                            	  3374:     ;
02:00040100 7601            	  3375:     moveq   #1,D3
02:00040102 102C0070        	  3376:     move.b  ($0070,A4),D0
02:00040106 0C000050        	  3377:     cmpi.b  #$50,D0
02:0004010A 6712            	  3378:     beq  _anon_z05_83
02:0004010C 5203            	  3379:     addq.b  #1,D3
02:0004010E 0C000080        	  3380:     cmpi.b  #$80,D0
02:00040112 670A            	  3381:     beq  _anon_z05_83
02:00040114 5203            	  3382:     addq.b  #1,D3
02:00040116 0C0000B0        	  3383:     cmpi.b  #$B0,D0
02:0004011A 6702            	  3384:     beq.s  __far_z_05_0062
02:0004011C 604C            	  3385:     jmp  L14F72_Exit
                            	  3386: __far_z_05_0062:
                            	  3387: _anon_z05_83:
                            	  3388:     ; Look for the current room in the cellar/shortcut room array.
                            	  3389:     ;
02:0004011E 1883            	  3390:     move.b  D3,($0000,A4)
02:00040120 163C00FF        	  3391:     move.b  #$FF,D3
02:00040124 102C00EB        	  3392:     move.b  ($00EB,A4),D0
                            	  3393: _anon_z05_84:
02:00040128 5203            	  3394:     addq.b  #1,D3
02:0004012A 41F900FF6BB2    	  3395:     lea     (NES_SRAM+$0BB2).l,A0
02:00040130 12303000        	  3396:     move.b  (A0,D3.W),D1
02:00040134 B001            	  3397:     cmp.b   D1,D0
02:00040136 66F0            	  3398:     bne  _anon_z05_84
                            	  3399:     ; Add the value of the shortcut chosen to whatever index
                            	  3400:     ; the current room has in the array.
                            	  3401:     ;
                            	  3402:     ; This yields the index of one of the three shortcut rooms
                            	  3403:     ; after the current one.
                            	  3404:     ;
02:00040138 1003            	  3405:     move.b  D3,D0
02:0004013A 023C00EE        	  3406:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004013E 1214            	  3407:     move.b  ($0000,A4),D1
02:00040140 D101            	  3408:     addx.b  D1,D0   ; ADC $00
                            	  3409:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3410:     ;
02:00040142 02000003        	  3411:     andi.b #$03,D0
02:00040146 7600            	  3412:     moveq   #0,D3
02:00040148 1600            	  3413:     move.b  D0,D3
02:0004014A 41F900FF6BB2    	  3414:     lea     (NES_SRAM+$0BB2).l,A0
02:00040150 10303000        	  3415:     move.b  (A0,D3.W),D0
                            	  3416: ; Params:
                            	  3417: ; A: destination room ID
                            	  3418: ;
                            	  3419:     even
                            	  3420: GoToModeAFromCellar:
02:00040154 194000EB        	  3421:     move.b  D0,($00EB,A4)
02:00040158 4EB900048EA0    	  3422:     jsr     MarkRoomVisited
                            	  3423:     even
                            	  3424: GoToModeAFromCave:
02:0004015E 700A            	  3425:     moveq   #10,D0
02:00040160 19400012        	  3426:     move.b  D0,($0012,A4)
                            	  3427:     even
                            	  3428: EndPrepareMode:
02:00040164 4EF90002C45A    	  3429:     jmp     c_end_prepare_mode
                            	  3430: 
                            	  3431: L14F72_Exit:
02:0004016A 4E75            	  3432:     rts
                            	  3433: 
