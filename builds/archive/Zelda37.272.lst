02:0003B31A 7008            	  7358:     moveq   #8,D0
                            	  7359:     even
                            	  7360: _L_z04_Dodongo_Draw_DrawWalking:
02:0003B31C 7600            	  7361:     moveq   #0,D3
02:0003B31E 1614            	  7362:     move.b  ($0000,A4),D3
02:0003B320 122C0015        	  7363:     move.b  ($0015,A4),D1
02:0003B324 C001            	  7364:     and.b  D1,D0
02:0003B326 6710            	  7365:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7366:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7367:     ; in order to index into the second set of frame image numbers.
                            	  7368:     ;
02:0003B328 1003            	  7369:     move.b  D3,D0
