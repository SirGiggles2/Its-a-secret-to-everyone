02:0003B5A4 023C00EE        	  7705:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B5A8 41F90003B486    	  7706:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003B5AE 12303000        	  7707:     move.b  (A0,D3.W),D1
