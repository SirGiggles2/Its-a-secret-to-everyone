                            	  6022:     even
                            	  6023: _L_z07_UpdateSwordOrRod_Add4:
                            	  6024:     ; Set [00] to (state - 1) * 4:
                            	  6025:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6026:     ;
02:0004AB04 023C00EE        	  6027:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AB08 123C0004        	  6028:     move.b  #$04,D1
02:0004AB0C D101            	  6029:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004AB0E 5303            	  6030:     subq.b  #1,D3
02:0004AB10 66F2            	  6031:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004AB12 1880            	  6032:     move.b  D0,($0000,A4)
                            	  6033:     ; Set object's direction to player's. It might have changed
                            	  6034:     ; since the last frame.
                            	  6035:     ;
02:0004AB14 102C0098        	  6036:     move.b  ($0098,A4),D0
02:0004AB18 41EC0098        	  6037:     lea     ($0098,A4),A0
02:0004AB1C 11802000        	  6038:     move.b  D0,(A0,D2.W)
                            	  6039:     ; Add [00] and the reverse index of the direction to get
                            	  6040:     ; the byte offset of the pixel offset.
                            	  6041:     ;
02:0004AB20 4EB9000304A8    	  6042:     jsr     GetOppositeDir
02:0004AB26 1003            	  6043:     move.b  D3,D0
02:0004AB28 023C00EE        	  6044:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AB2C 1214            	  6045:     move.b  ($0000,A4),D1
02:0004AB2E D101            	  6046:     addx.b  D1,D0   ; ADC $00
02:0004AB30 7600            	  6047:     moveq   #0,D3
02:0004AB32 1600            	  6048:     move.b  D0,D3
                            	  6049:     ; Set object's X to player's X + offset for state and direction.
                            	  6050:     ; Copy the result to [00].
                            	  6051:     ;
02:0004AB34 102C0070        	  6052:     move.b  ($0070,A4),D0
02:0004AB38 023C00EE        	  6053:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AB3C 41F90004AA68    	  6054:     lea     (PlayerToWeaponOffsetsX).l,A0
02:0004AB42 12303000        	  6055:     move.b  (A0,D3.W),D1
02:0004AB46 D101            	  6056:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsX,Y
02:0004AB48 19802070        	  6057:     move.b  D0,($70,A4,D2.W)
02:0004AB4C 1880            	  6058:     move.b  D0,($0000,A4)
                            	  6059:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6060:     ; Copy the result to [01].
                            	  6061:     ;
02:0004AB4E 102C0084        	  6062:     move.b  ($0084,A4),D0
02:0004AB52 023C00EE        	  6063:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004AB56 41F90004AA78    	  6064:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004AB5C 12303000        	  6065:     move.b  (A0,D3.W),D1
02:0004AB60 D101            	  6066:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004AB62 41EC0084        	  6067:     lea     ($0084,A4),A0
02:0004AB66 11802000        	  6068:     move.b  D0,(A0,D2.W)
02:0004AB6A 19400001        	  6069:     move.b  D0,($0001,A4)
                            	  6070:     ; If state = 1, use up direction.
                            	  6071:     ; Else use object direction.
                            	  6072:     ;
02:0004AB6E 41EC00AC        	  6073:     lea     ($00AC,A4),A0
02:0004AB72 10302000        	  6074:     move.b  (A0,D2.W),D0
02:0004AB76 0200000F        	  6075:     andi.b #$0F,D0
02:0004AB7A 7600            	  6076:     moveq   #0,D3
02:0004AB7C 1600            	  6077:     move.b  D0,D3
02:0004AB7E 7008            	  6078:     moveq   #8,D0
02:0004AB80 5303            	  6079:     subq.b  #1,D3
02:0004AB82 6708            	  6080:     beq  _L_z07_UpdateSwordOrRod_CalcAttrs
02:0004AB84 41EC0098        	  6081:     lea     ($0098,A4),A0
02:0004AB88 10302000        	  6082:     move.b  (A0,D2.W),D0
