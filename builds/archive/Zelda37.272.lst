02:0003D988 41EC009A        	 12517:     lea     ($009A,A4),A0
02:0003D98C 11803000        	 12518:     move.b  D0,(A0,D3.W)
02:0003D990 5303            	 12519:     subq.b  #1,D3
02:0003D992 6AC2            	 12520:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0003D994 4E75            	 12521:     rts
