02:00049184 4EB90003061A    	  2365:     jsr     MapScreenPosToPpuAddr
02:0004918A 7400            	  2366:     moveq   #0,D2
02:0004918C 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:00049190 1014            	  2375:     move.b  ($0000,A4),D0
02:00049192 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00049196 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:0004919A 41EC0307        	  2378:     lea     ($0307,A4),A0
02:0004919E 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:000491A2 102C0001        	  2383:     move.b  ($0001,A4),D0
02:000491A6 41EC0303        	  2384:     lea     ($0303,A4),A0
02:000491AA 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:000491AE 41EC0308        	  2386:     lea     ($0308,A4),A0
02:000491B2 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:000491B6 41EC0308        	  2388:     lea     ($0308,A4),A0
02:000491BA 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:000491BE 102C0005        	  2392:     move.b  ($0005,A4),D0
02:000491C2 41EC0305        	  2393:     lea     ($0305,A4),A0
02:000491C6 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:000491CA 41EC0306        	  2395:     lea     ($0306,A4),A0
02:000491CE 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:000491D2 41EC030A        	  2397:     lea     ($030A,A4),A0
02:000491D6 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:000491DA 41EC030B        	  2399:     lea     ($030B,A4),A0
02:000491DE 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
                            	  2403:     ; Here is an example result of this manipulation:
                            	  2404:     ;   record 1: $70, $71
                            	  2405:     ;   record 2: $72, $73
                            	  2406:     ;
02:000491E2 0C000046        	  2407:     cmpi.b  #$46,D0
02:000491E6 6530            	  2408:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:000491E8 0C0000F3        	  2409:     cmpi.b  #$F3,D0
02:000491EC 642A            	  2410:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
