02:00035342 102C0302        	  5420:     move.b  ($0302,A4),D0
02:00035346 02000008        	  5421:     andi.b #$08,D0
02:0003534A 6702            	  5422:     beq  _anon_z02_52
02:0003534C 762B            	  5423:     moveq   #43,D3
                            	  5424: _anon_z02_52:
