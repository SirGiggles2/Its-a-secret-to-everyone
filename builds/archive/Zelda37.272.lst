02:00038456 12342070        	   763:     move.b  ($70,A4,D2.W),D1
02:0003845A 0A3C0010        	   764:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003845E 9101            	   765:     subx.b  D1,D0   ; SBC ObjX,X
02:00038460 0A3C0010        	   766:     eori    #$10,CCR  ; restore X = 6502 C
                            	   767:     even
                            	   768: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   769:     ; If the difference in coordinates is negative, then Link is
                            	   770:     ; up or left of the block.
                            	   771:     ;
                            	   772:     ; In that case, increase Y register to index the correct opposite
                            	   773:     ; direction below. Also, negate the difference, so we test
                            	   774:     ; positive values.
                            	   775:     ;
02:00038464 6A06            	   776:     bpl  _anon_z04_14
02:00038466 5203            	   777:     addq.b  #1,D3
02:00038468 61008046        	   778:     jsr     Negate
                            	   779: _anon_z04_14:
