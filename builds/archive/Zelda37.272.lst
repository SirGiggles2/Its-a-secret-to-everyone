02:0003D690 19802070        	 12076:     move.b  D0,($70,A4,D2.W)
02:0003D694 41EC0084        	 12077:     lea     ($0084,A4),A0
02:0003D698 10302000        	 12078:     move.b  (A0,D2.W),D0
02:0003D69C 023C00EE        	 12079:     andi    #$EE,CCR  ; CLC: clear C+X
