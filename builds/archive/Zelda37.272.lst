02:0003028E 41EC00AC        	  1372:     lea     ($00AC,A4),A0
02:00030292 52302000        	  1373:     addq.b  #1,(A0,D2.W)
02:00030296 7070            	  1374:     moveq   #112,D0
02:00030298 41EC03BC        	  1375:     lea     ($03BC,A4),A0
02:0003029C 11802000        	  1376:     move.b  D0,(A0,D2.W)
                            	  1377:     even
