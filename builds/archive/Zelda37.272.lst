02:0003C48C 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003C490 E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003C492 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003C496 122C0002        	  9662:     move.b  ($0002,A4),D1
