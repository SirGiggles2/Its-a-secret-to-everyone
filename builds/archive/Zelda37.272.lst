                            	  4399: 
                            	  4400: ; Description:
                            	  4401: ; Calculates the next alternate direction to move in while
                            	  4402: ; searching for an unblocked direction.
                            	  4403: ;
                            	  4404: ; Params:
                            	  4405: ; [0E]: the current step
                            	  4406: ;
                            	  4407: ; Returns:
                            	  4408: ; A: a direction for the current step, or 0 at the end of the loop
                            	  4409: ; [0E]: the next step, or 0 to end the loop
