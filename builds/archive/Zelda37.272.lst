02:0003AD6E 0C0000C8        	  6508:     cmpi.b  #$C8,D0
02:0003AD72 651C            	  6509:     bcs  _L_z04_Aquamentus_Move_ApplySpeed
02:0003AD74 103C00C7        	  6510:     move.b  #$C7,D0
02:0003AD78 19802070        	  6511:     move.b  D0,($70,A4,D2.W)
02:0003AD7C 7002            	  6512:     moveq   #2,D0
02:0003AD7E 41EC0098        	  6513:     lea     ($0098,A4),A0
02:0003AD82 11802000        	  6514:     move.b  D0,(A0,D2.W)
                            	  6515:     even
                            	  6516: _L_z04_Aquamentus_Move_SetRemainingDistance:
