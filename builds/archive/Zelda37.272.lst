                            	  8163:     ; decrement the distance remaining, and move.
                            	  8164:     ;
02:0003B962 41EC0394        	  8165:     lea     ($0394,A4),A0
02:0003B966 10302000        	  8166:     move.b  (A0,D2.W),D0
02:0003B96A 670A            	  8167:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003B96C 41EC0394        	  8168:     lea     ($0394,A4),A0
