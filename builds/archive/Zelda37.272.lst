02:00034C46 102C0084        	  4757:     move.b  ($0084,A4),D0
02:00034C4A 003C0011        	  4758:     ori     #$11,CCR  ; SEC: set C+X
02:00034C4E 123C0010        	  4759:     move.b  #$10,D1
02:00034C52 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034C56 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:00034C58 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
