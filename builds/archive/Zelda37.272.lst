                            	  4211: _L_z07_CheckTiles_notLink:
                            	  4212:     endc
                            	  4213:     ; The code below applies to Link and other objects.
                            	  4214:     ;
                            	  4215:     ; Test the moving direction's walkability.
                            	  4216:     ;
                            	  4217:     ; For the player, this is enough. For other objects, this 
                            	  4218:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4219:     ;
                            	  4220:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4221:     ;
