02:00031F34 41EC0650        	   614:     lea     ($0650,A4),A0
02:00031F38 11802000        	   615:     move.b  D0,(A0,D2.W)
                            	   616:     ; Point to the next byte in Items block.
                            	   617:     ; hearts value -> hearts partial
02:00031F3C 5203            	   618:     addq.b  #1,D3
02:00031F3E 5202            	   619:     addq.b  #1,D2
                            	   620:     ; There are 6 values total:
                            	   621:     ; (hearts value, hearts partial) * 3 slots.
02:00031F40 0C020006        	   622:     cmpi.b  #$06,D2
02:00031F44 6714            	   623:     beq  _L_z02_UpdateMode0Demo_Sub2_CopyNames
02:00031F46 1002            	   624:     move.b  D2,D0
