                            	  5566:     ; starting from highest index down to 0:
                            	  5567:     ;
02:00041ADE 41F9000419CC    	  5568:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:00041AE4 10302000        	  5569:     move.b  (A0,D2.W),D0
02:00041AE8 7400            	  5570:     moveq   #0,D2
