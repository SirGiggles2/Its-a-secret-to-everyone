02:0003E794 023C00EE        	   510:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E798 1214            	   511:     move.b  ($0000,A4),D1
02:0003E79A D101            	   512:     addx.b  D1,D0   ; ADC $00
02:0003E79C 19400258        	   513:     move.b  D0,($0258,A4)
                            	   514:     even
