                            	  3883:     ; Else check for all collisions.
                            	  3884:     ;
02:000399F8 4EB900030BE4    	  3885:     jsr     CheckMonsterCollisions
                            	  3886:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3887:     ;
02:000399FE 41EC0405        	  3888:     lea     ($0405,A4),A0
02:00039A02 10302000        	  3889:     move.b  (A0,D2.W),D0
02:00039A06 670A            	  3890:     beq  _anon_z04_55
02:00039A08 705D            	  3891:     moveq   #93,D0
02:00039A0A 41EC034F        	  3892:     lea     ($034F,A4),A0
02:00039A0E 11802000        	  3893:     move.b  D0,(A0,D2.W)
