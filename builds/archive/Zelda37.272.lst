02:00038A7E 123C0008        	  1619:     move.b  #$08,D1
02:00038A82 D101            	  1620:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:00038A84 020000F0        	  1621:     andi.b #$F0,D0
02:00038A88 19802070        	  1622:     move.b  D0,($70,A4,D2.W)
                            	  1623:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
