                            	  1670: AnimateDemoPhase0Subphase1:
02:00032CDC 102C0438        	  1671:     move.b  ($0438,A4),D0
02:00032CE0 666C            	  1672:     bne  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1673:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1674:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1675:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032CE2 7000            	  1676:     moveq   #0,D0
02:00032CE4 102C0437        	  1677:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032CE8 EB48            	  1678:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032CEA 41F900032ACC    	  1679:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032CF0 D0C0            	  1680:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1681:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032CF2 197C003F0302    	  1682:     move.b  #$3F,($0302,A4)
02:00032CF8 197C00000303    	  1683:     move.b  #$00,($0303,A4)
02:00032CFE 7020            	  1684:     moveq   #32,D0
02:00032D00 19400304        	  1685:     move.b  D0,($0304,A4)
                            	  1686:     ; End marker at DynTileBuf+4+31
02:00032D04 761F            	  1687:     moveq   #31,D3
02:00032D06 103C00FF        	  1688:     move.b  #$FF,D0
02:00032D0A 43EC0306        	  1689:     lea     ($0306,A4),A1
02:00032D0E 13803000        	  1690:     move.b  D0,(A1,D3.W)
                            	  1691:     even
                            	  1692: _L_z02_AnimateDemoPhase0Subphase1_CopyPalette:
02:00032D12 10303000        	  1693:     move.b  (A0,D3.W),D0        ; read from ROM palette table
02:00032D16 43EC0305        	  1694:     lea     ($0305,A4),A1
02:00032D1A 13803000        	  1695:     move.b  D0,(A1,D3.W)
02:00032D1E 5303            	  1696:     subq.b  #1,D3
02:00032D20 6AF0            	  1697:     bpl  _L_z02_AnimateDemoPhase0Subphase1_CopyPalette
