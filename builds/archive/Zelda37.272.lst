                            	  1762:     ;
02:00038B86 41EC0394        	  1763:     lea     ($0394,A4),A0
02:00038B8A 10302000        	  1764:     move.b  (A0,D2.W),D0
02:00038B8E 0200000F        	  1765:     andi.b #$0F,D0
02:00038B92 023C00EE        	  1766:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B96 6608            	  1767:     bne  _L_z04_Gel_MoveSplitting_Exit
02:00038B98 41EC0394        	  1768:     lea     ($0394,A4),A0
02:00038B9C 11802000        	  1769:     move.b  D0,(A0,D2.W)
