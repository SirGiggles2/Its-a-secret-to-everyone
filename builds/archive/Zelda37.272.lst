                            	  1382: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  1383:     ; If the horizontal distance between Link and the trap >= $E,
                            	  1384:     ; then this trap definitely wasn't triggered.
                            	  1385:     ; Go draw and check collisions.
                            	  1386:     ;
02:000302A4 102C0070        	  1387:     move.b  ($0070,A4),D0
02:000302A8 003C0011        	  1388:     ori     #$11,CCR  ; SEC: set C+X
02:000302AC 12342070        	  1389:     move.b  ($70,A4,D2.W),D1
02:000302B0 0A3C0010        	  1390:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000302B4 9101            	  1391:     subx.b  D1,D0   ; SBC ObjX,X
02:000302B6 0A3C0010        	  1392:     eori    #$10,CCR  ; restore X = 6502 C
02:000302BA 610001F0        	  1393:     jsr     Abs
02:000302BE 0C00000E        	  1394:     cmpi.b  #$0E,D0
02:000302C2 64DC            	  1395:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  1396:     ; Determine the vertical direction toward Link;
                            	  1397:     ; and if Link and the trap are at the same Y, then we can't move
                            	  1398:     ; along this axis. Go draw and check object collisions.
                            	  1399:     ;
02:000302C4 7604            	  1400:     moveq   #4,D3
02:000302C6 102C0084        	  1401:     move.b  ($0084,A4),D0
02:000302CA 41EC0084        	  1402:     lea     ($0084,A4),A0
02:000302CE 12302000        	  1403:     move.b  (A0,D2.W),D1
02:000302D2 B001            	  1404:     cmp.b   D1,D0
02:000302D4 67CA            	  1405:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:000302D6 6402            	  1406:     bcc  _anon_z01_27
02:000302D8 7608            	  1407:     moveq   #8,D3
                            	  1408: _anon_z01_27:
                            	  1409:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  1410:     ; set the vertical direction we determined, and other preparations.
                            	  1411:     ;
02:000302DA 41EC0084        	  1412:     lea     ($0084,A4),A0
02:000302DE 10302000        	  1413:     move.b  (A0,D2.W),D0
02:000302E2 668A            	  1414:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  1415:     even
                            	  1416: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  1417:     ; State 1 and 2.
                            	  1418:     ;
                            	  1419:     ; Move in the direction it's facing.
                            	  1420:     ;
02:000302E4 41EC0098        	  1421:     lea     ($0098,A4),A0
02:000302E8 10302000        	  1422:     move.b  (A0,D2.W),D0
02:000302EC 1940000F        	  1423:     move.b  D0,($000F,A4)
02:000302F0 4EB900049D8E    	  1424:     jsr     MoveObject
                            	  1425:     ; Truncate the grid offset to square length ($10).
                            	  1426:     ;
02:000302F6 41EC0394        	  1427:     lea     ($0394,A4),A0
02:000302FA 10302000        	  1428:     move.b  (A0,D2.W),D0
02:000302FE 0200000F        	  1429:     andi.b #$0F,D0
02:00030302 6608            	  1430:     bne  _anon_z01_28
02:00030304 41EC0394        	  1431:     lea     ($0394,A4),A0
02:00030308 11802000        	  1432:     move.b  D0,(A0,D2.W)
                            	  1433: _anon_z01_28:
                            	  1434:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  1435:     ;
02:0003030C 6100093C        	  1436:     jsr     CheckLinkCollision
                            	  1437:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  1438:     ; and current coordinate to the trap's X.
                            	  1439:     ;
02:00030310 7600            	  1440:     moveq   #0,D3
02:00030312 16342070        	  1441:     move.b  ($70,A4,D2.W),D3
02:00030316 7078            	  1442:     moveq   #120,D0
02:00030318 1880            	  1443:     move.b  D0,($0000,A4)
02:0003031A 41EC0098        	  1444:     lea     ($0098,A4),A0
02:0003031E 10302000        	  1445:     move.b  (A0,D2.W),D0
02:00030322 0200000C        	  1446:     andi.b #$0C,D0
02:00030326 6710            	  1447:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  1448:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  1449:     ; and current coordinate to the trap's Y.
                            	  1450:     ;
02:00030328 7600            	  1451:     moveq   #0,D3
02:0003032A 41EC0084        	  1452:     lea     ($0084,A4),A0
02:0003032E 16302000        	  1453:     move.b  (A0,D2.W),D3
02:00030332 103C0090        	  1454:     move.b  #$90,D0
02:00030336 1880            	  1455:     move.b  D0,($0000,A4)
                            	  1456:     even
                            	  1457: _L_z01_UpdateTrap_Full_Finish:
                            	  1458:     ; If in state 2, then go finish handling it.
                            	  1459:     ;
02:00030338 41EC00AC        	  1460:     lea     ($00AC,A4),A0
02:0003033C 10302000        	  1461:     move.b  (A0,D2.W),D0
02:00030340 02000001        	  1462:     andi.b #$01,D0
02:00030344 6744            	  1463:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  1464:     ; Finish handling state 1.
                            	  1465:     ;
                            	  1466:     ; Get the distance between the current coordinate and the target.
                            	  1467:     ;
02:00030346 1003            	  1468:     move.b  D3,D0
02:00030348 003C0011        	  1469:     ori     #$11,CCR  ; SEC: set C+X
02:0003034C 1214            	  1470:     move.b  ($0000,A4),D1
02:0003034E 0A3C0010        	  1471:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00030352 9101            	  1472:     subx.b  D1,D0   ; SBC $00
02:00030354 0A3C0010        	  1473:     eori    #$10,CCR  ; restore X = 6502 C
02:00030358 61000152        	  1474:     jsr     Abs
                            	  1475:     ; If distance >= 5, go draw.
                            	  1476:     ;
02:0003035C 0C000005        	  1477:     cmpi.b  #$05,D0
02:00030360 6426            	  1478:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  1479:     ; Else reverse direction, and advace to state 2
