                            	  9774: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9775:     ; Here the eye is closed. So animate it this way.
                            	  9776:     ; Increment the animation counter, and if <> 8, then
                            	  9777:     ; go shoot, draw, and check collisions.
                            	  9778:     ;
02:0003C56C 41EC0478        	  9779:     lea     ($0478,A4),A0
02:0003C570 52302000        	  9780:     addq.b  #1,(A0,D2.W)
02:0003C574 41EC0478        	  9781:     lea     ($0478,A4),A0
02:0003C578 10302000        	  9782:     move.b  (A0,D2.W),D0
02:0003C57C 0C000008        	  9783:     cmpi.b  #$08,D0
02:0003C580 66C2            	  9784:     bne  _L_z04_UpdateGohma_ShootAnimateCollide
                            	  9785:     ; Roll over the eye animation counter to 0.
                            	  9786:     ; Clear bit 1 and invert bit 0 to switch between frame images 0 and 1.
                            	  9787:     ;
02:0003C582 7000            	  9788:     moveq   #0,D0
02:0003C584 41EC0478        	  9789:     lea     ($0478,A4),A0
02:0003C588 11802000        	  9790:     move.b  D0,(A0,D2.W)
02:0003C58C 41EC046B        	  9791:     lea     ($046B,A4),A0
02:0003C590 10302000        	  9792:     move.b  (A0,D2.W),D0
02:0003C594 02000001        	  9793:     andi.b #$01,D0
02:0003C598 0A000001        	  9794:     eori.b #$01,D0
                            	  9795:     ; Go set eye state/frame image, shoot, draw, and check collisions
                            	  9796:     ;
02:0003C59C 609E            	  9797:     jmp     _L_z04_UpdateGohma_SetEyeStateAndShoot
                            	  9798: 
