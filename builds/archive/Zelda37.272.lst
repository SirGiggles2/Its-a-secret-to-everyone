02:0003355C 19400085        	  2507:     move.b  D0,($0085,A4)
02:00033560 5202            	  2508:     addq.b  #1,D2
02:00033562 41F900032FAA    	  2509:     lea     (ModeE_CharBoardYOffsetsAndBounds).l,A0
