02:0004AAEE 10302000        	  6015:     move.b  (A0,D2.W),D0
02:0004AAF2 0200000F        	  6016:     andi.b #$0F,D0
02:0004AAF6 7600            	  6017:     moveq   #0,D3
02:0004AAF8 1600            	  6018:     move.b  D0,D3
02:0004AAFA 103C00FC        	  6019:     move.b  #$FC,D0
