                            	  2863: Link_FilterInput:
                            	  2864:     ; [00] holds the opposite of Link's facing direction.
                            	  2865:     ;
02:0003FDBC 102C0098        	  2866:     move.b  ($0098,A4),D0
02:0003FDC0 4EB9000304A8    	  2867:     jsr     GetOppositeDir
02:0003FDC6 1880            	  2868:     move.b  D0,($0000,A4)
                            	  2869:     ; Call GetOppositeDir again to use this mapping:
                            	  2870:     ; In Dir: 1 2 4 8
                            	  2871:     ;         -------
                            	  2872:     ; Index:  2 3 0 1
                            	  2873:     ;
02:0003FDC8 4EB9000304A8    	  2874:     jsr     GetOppositeDir
                            	  2875:     ; Get the appropriate coordinate for the direction:
                            	  2876:     ; X for horizontal
                            	  2877:     ; Y for vertical
                            	  2878:     ;
02:0003FDCE 102C0070        	  2879:     move.b  ($0070,A4),D0
02:0003FDD2 0C030002        	  2880:     cmpi.b  #$02,D3
02:0003FDD6 6404            	  2881:     bcc  _anon_z05_74
02:0003FDD8 102C0084        	  2882:     move.b  ($0084,A4),D0
                            	  2883: _anon_z05_74:
02:0003FDDC 19400002        	  2884:     move.b  D0,($0002,A4)
                            	  2885:     ; Mask A button and directions if inner border is crossed.
                            	  2886:     ;
02:0003FDE0 1003            	  2887:     move.b  D3,D0
02:0003FDE2 1B00            	  2888:     move.b  D0,-(A5)  ; PHA
02:0003FDE4 023C00EE        	  2889:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FDE8 123C0008        	  2890:     move.b  #$08,D1
02:0003FDEC D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003FDEE 7600            	  2892:     moveq   #0,D3
02:0003FDF0 1600            	  2893:     move.b  D0,D3
02:0003FDF2 103C0080        	  2894:     move.b  #$80,D0
02:0003FDF6 6134            	  2895:     jsr     MaskInputInBorder
02:0003FDF8 101D            	  2896:     move.b  (A5)+,D0  ; PLA
02:0003FDFA 7600            	  2897:     moveq   #0,D3
02:0003FDFC 1600            	  2898:     move.b  D0,D3
                            	  2899:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2900:     ; boundary using player's direction and reverse direction index.
                            	  2901:     ;
02:0003FDFE 102C0001        	  2902:     move.b  ($0001,A4),D0
02:0003FE02 0C0000FF        	  2903:     cmpi.b  #$FF,D0
02:0003FE06 660C            	  2904:     bne  _anon_z05_75
02:0003FE08 102C0098        	  2905:     move.b  ($0098,A4),D0
02:0003FE0C 1880            	  2906:     move.b  D0,($0000,A4)
02:0003FE0E 4EB9000304A8    	  2907:     jsr     GetOppositeDir
                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
02:0003FE14 102C0010        	  2914:     move.b  ($0010,A4),D0
02:0003FE18 6710            	  2915:     beq  _anon_z05_76
02:0003FE1A 1003            	  2916:     move.b  D3,D0
02:0003FE1C 023C00EE        	  2917:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FE20 123C0004        	  2918:     move.b  #$04,D1
02:0003FE24 D101            	  2919:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003FE26 7600            	  2920:     moveq   #0,D3
02:0003FE28 1600            	  2921:     move.b  D0,D3
                            	  2922: _anon_z05_76:
                            	  2923:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2924:     ;
02:0003FE2A 7000            	  2925:     moveq   #0,D0
                            	  2926: ; Params:
                            	  2927: ; A: mask of buttons to block
                            	  2928: ; Y: offset into BorderBounds
                            	  2929: ; [00]: direction
                            	  2930: ; [02]: coordinate
                            	  2931: ;
                            	  2932: ; Returns:
                            	  2933: ; [01]: button mask that was used
                            	  2934: ;       (set to $FF if boundary not crossed)
                            	  2935: ;
                            	  2936:     even
                            	  2937: MaskInputInBorder:
