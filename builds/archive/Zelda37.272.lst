02:00030884 16302000        	  2280:     move.b  (A0,D2.W),D3
                            	  2281: ; Params:
                            	  2282: ; A: frame
                            	  2283: ; X: object index/cycle sprite index
                            	  2284: ; Y: object type
                            	  2285: ; [00]: object X
                            	  2286: ; [01]: object Y
                            	  2287: ; [0C]: mirrored
                            	  2288: ; [0F]: flip horizontally
                            	  2289: ;
                            	  2290: ; Note:
                            	  2291: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2292: ;
                            	  2293: ; The animation index of most objects is (object type + 1),
                            	  2294: ; to make up for the fact that Link uses two animation indexes.
                            	  2295: ;
                            	  2296:     even
