                            	  2304: ; [01]: object Y
                            	  2305: ; [0C]: mirrored
                            	  2306: ; [0F]: flip horizontally
                            	  2307: ;
                            	  2308: ; Note:
                            	  2309: ; If the object is not mirrored, then it's horizontally flippable.
                            	  2310: ; But Link uses [0F] for flipping without checking [0C].
                            	  2311: ;
                            	  2312: ;
                            	  2313: ; [0D] holds frame.
                            	  2314:     even
