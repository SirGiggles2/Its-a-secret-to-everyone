02:0003A5BE 103C0080        	  5477:     move.b  #$80,D0
02:0003A5C2 19803071        	  5478:     move.b  D0,($71,A4,D3.W)
02:0003A5C6 7070            	  5479:     moveq   #112,D0
02:0003A5C8 41EC0085        	  5480:     lea     ($0085,A4),A0
02:0003A5CC 11803000        	  5481:     move.b  D0,(A0,D3.W)
                            	  5482:     ; Start with no direction, no deferred bounce direction,
                            	  5483:     ; and ready to update.
                            	  5484:     ;
02:0003A5D0 7000            	  5485:     moveq   #0,D0
02:0003A5D2 41EC0099        	  5486:     lea     ($0099,A4),A0
02:0003A5D6 11803000        	  5487:     move.b  D0,(A0,D3.W)
02:0003A5DA 41EC03BD        	  5488:     lea     ($03BD,A4),A0
02:0003A5DE 11803000        	  5489:     move.b  D0,(A0,D3.W)
02:0003A5E2 41EC0406        	  5490:     lea     ($0406,A4),A0
02:0003A5E6 11803000        	  5491:     move.b  D0,(A0,D3.W)
02:0003A5EA 41EC0493        	  5492:     lea     ($0493,A4),A0
02:0003A5EE 11803000        	  5493:     move.b  D0,(A0,D3.W)
                            	  5494:     ; Copy object attributes from the first monster slot.
