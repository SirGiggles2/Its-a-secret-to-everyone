02:000397AA 101D            	  3513:     move.b  (A5)+,D0  ; PLA
02:000397AC 023C00EE        	  3514:     andi    #$EE,CCR  ; CLC: clear C+X
02:000397B0 41EC03E4        	  3515:     lea     ($03E4,A4),A0
02:000397B4 12302000        	  3516:     move.b  (A0,D2.W),D1
02:000397B8 D101            	  3517:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:000397BA 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
                            	  3519:     ; If facing vertically, go draw mirrored.
