02:0002BFAC 670A            	  2436:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2437:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2438:     eori    #$01,CCR
02:0002BFB6 4E75            	  2439:     rts
                            	  2440: .cc_cnras:
02:0002BFB8 023C00FE        	  2441:     andi    #$FE,CCR
