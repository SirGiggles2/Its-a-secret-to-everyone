                            	  1190: .nt_skip_write:
02:0000E6C6 610E            	  1191:     bsr     .inc_ppuaddr
02:0000E6C8 4CDF037F        	  1192:     movem.l (SP)+,D0-D6/A0-A1
02:0000E6CC 4E75            	  1193:     rts
                            	  1194: 
                            	  1195:     ifne CHR_EXPANSION_ENABLED
