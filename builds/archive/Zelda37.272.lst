                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003D6FE 41F90003D5D4    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003D704 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003D708 7600            	 12131:     moveq   #0,D3
