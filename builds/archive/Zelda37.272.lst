02:0003DA12 6100009C        	 12588:     jsr     Ganon_GetCurCloudTop
02:0003DA16 6100FF7E        	 12589:     jsr     Ganon_DrawCloud
02:0003DA1A 6100009A        	 12590:     jsr     Ganon_GetCurCloudBottom
02:0003DA1E 6100FF76        	 12591:     jsr     Ganon_DrawCloud
                            	 12592:     ; Draw the left and right clouds.
                            	 12593:     ;
02:0003DA22 61000080        	 12594:     jsr     Ganon_GetCurCloudLeft
02:0003DA26 41EC0084        	 12595:     lea     ($0084,A4),A0
02:0003DA2A 10302000        	 12596:     move.b  (A0,D2.W),D0
02:0003DA2E 19400001        	 12597:     move.b  D0,($0001,A4)
02:0003DA32 6100FF62        	 12598:     jsr     Ganon_DrawCloud
02:0003DA36 6172            	 12599:     jsr     Ganon_GetCurCloudRight
02:0003DA38 6100FF5C        	 12600:     jsr     Ganon_DrawCloud
                            	 12601:     ; Save the object index.
                            	 12602:     ;
02:0003DA3C 102C0340        	 12603:     move.b  ($0340,A4),D0
02:0003DA40 1B00            	 12604:     move.b  D0,-(A5)  ; PHA
                            	 12605:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12606:     ;
02:0003DA42 7402            	 12607:     moveq   #2,D2
                            	 12608:     even
                            	 12609: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003DA44 19420340        	 12610:     move.b  D2,($0340,A4)
                            	 12611:     ; If object slot < 5 or = 7, then move every frame.
                            	 12612:     ; Else move 3 out of every 4 frames.
                            	 12613:     ;
                            	 12614:     ; This makes pieces spread out in somewhat of a circle,
                            	 12615:     ; by making the pieces at cardinal directions move at
                            	 12616:     ; full speed while the diagonal ones move a little slower.
                            	 12617:     ;
02:0003DA48 0C020005        	 12618:     cmpi.b  #$05,D2
02:0003DA4C 6510            	 12619:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003DA4E 0C020007        	 12620:     cmpi.b  #$07,D2
02:0003DA52 670A            	 12621:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003DA54 102C0015        	 12622:     move.b  ($0015,A4),D0
02:0003DA58 02000003        	 12623:     andi.b #$03,D0
02:0003DA5C 6704            	 12624:     beq  _anon_z04_164
                            	 12625:     even
                            	 12626: _L_z04_Ganon_DrawBurst_Move:
02:0003DA5E 6100E036        	 12627:     jsr     BlueWizzrobe_Move
                            	 12628: _anon_z04_164:
02:0003DA62 4EB90004B104    	 12629:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12630:     ; The frame counter will make the sprite flash.
                            	 12631:     ; The array has the horizontal and vertical flipping attributes.
                            	 12632:     ; Combine them into [03].
                            	 12633:     ;
02:0003DA68 102C0015        	 12634:     move.b  ($0015,A4),D0
02:0003DA6C 02000003        	 12635:     andi.b #$03,D0
02:0003DA70 41F90003D940    	 12636:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003DA76 12302000        	 12637:     move.b  (A0,D2.W),D1
02:0003DA7A 8001            	 12638:     or.b  D1,D0
02:0003DA7C 19400003        	 12639:     move.b  D0,($0003,A4)
02:0003DA80 41F90003D94A    	 12640:     lea     (GanonBurstTiles).l,A0
02:0003DA86 10302000        	 12641:     move.b  (A0,D2.W),D0
02:0003DA8A 4EB900030B74    	 12642:     jsr     Anim_WriteSprite
                            	 12643:     ; Bottom of the loop.
