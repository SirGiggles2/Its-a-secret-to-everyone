02:0003C478 19410002        	  9650:     move.b  D1,($0002,A4)
02:0003C47C 122C0002        	  9651:     move.b  ($0002,A4),D1
02:0003C480 C200            	  9652:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C482 6708            	  9653:     beq  _anon_z04_120
02:0003C484 41EC0084        	  9654:     lea     ($0084,A4),A0
02:0003C488 52302000        	  9655:     addq.b  #1,(A0,D2.W)
                            	  9656: _anon_z04_120:
