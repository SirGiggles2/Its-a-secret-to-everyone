                            	  7853: UpdateLikeLike:
                            	  7854:     ; If the monster captured Link, then go handle it.
                            	  7855:     ;
02:0003B700 41EC042C        	  7856:     lea     ($042C,A4),A0
02:0003B704 10302000        	  7857:     move.b  (A0,D2.W),D0
02:0003B708 6600009A        	  7858:     bne  _L_z04_UpdateLikeLike_HandleCaptured
02:0003B70C 103C0080        	  7859:     move.b  #$80,D0
02:0003B710 6100C956        	  7860:     jsr     UpdateCommonWanderer
                            	  7861:     ; Like-like has a 4 animation frame cycle unlike most monsters
                            	  7862:     ; which have 2.
                            	  7863:     ;
02:0003B714 41EC03D0        	  7864:     lea     ($03D0,A4),A0
02:0003B718 53302000        	  7865:     subq.b  #1,(A0,D2.W)
02:0003B71C 6624            	  7866:     bne  _L_z04_UpdateLikeLike_Draw
02:0003B71E 7008            	  7867:     moveq   #8,D0
02:0003B720 41EC03D0        	  7868:     lea     ($03D0,A4),A0
02:0003B724 11802000        	  7869:     move.b  D0,(A0,D2.W)
02:0003B728 7600            	  7870:     moveq   #0,D3
02:0003B72A 41EC03E4        	  7871:     lea     ($03E4,A4),A0
02:0003B72E 16302000        	  7872:     move.b  (A0,D2.W),D3
02:0003B732 5203            	  7873:     addq.b  #1,D3
02:0003B734 1003            	  7874:     move.b  D3,D0
02:0003B736 02000003        	  7875:     andi.b #$03,D0
02:0003B73A 41EC03E4        	  7876:     lea     ($03E4,A4),A0
02:0003B73E 11802000        	  7877:     move.b  D0,(A0,D2.W)
                            	  7878:     even
                            	  7879: _L_z04_UpdateLikeLike_Draw:
                            	  7880:     ; Draw.
                            	  7881:     ;
02:0003B742 4EB90004B104    	  7882:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003B748 41EC03E4        	  7883:     lea     ($03E4,A4),A0
02:0003B74C 10302000        	  7884:     move.b  (A0,D2.W),D0
02:0003B750 4EB900030874    	  7885:     jsr     DrawObjectMirrored
                            	  7886:     ; Check collisions. If Link was not captured, then return.
                            	  7887:     ;
02:0003B756 4EB900030BE4    	  7888:     jsr     CheckMonsterCollisions
02:0003B75C 41EC042C        	  7889:     lea     ($042C,A4),A0
02:0003B760 10302000        	  7890:     move.b  (A0,D2.W),D0
02:0003B764 673C            	  7891:     beq  _L_z04_UpdateLikeLike_Exit
                            	  7892:     ; The monster captured Link.
                            	  7893:     ; Put the monster at the same location as him.
                            	  7894:     ;
02:0003B766 102C0070        	  7895:     move.b  ($0070,A4),D0
02:0003B76A 19802070        	  7896:     move.b  D0,($70,A4,D2.W)
02:0003B76E 102C0084        	  7897:     move.b  ($0084,A4),D0
02:0003B772 41EC0084        	  7898:     lea     ($0084,A4),A0
02:0003B776 11802000        	  7899:     move.b  D0,(A0,D2.W)
                            	  7900:     ; Reset Link's timer, metastate, and shove info.
                            	  7901:     ;
02:0003B77A 7000            	  7902:     moveq   #0,D0
02:0003B77C 19400028        	  7903:     move.b  D0,($0028,A4)
02:0003B780 19400405        	  7904:     move.b  D0,($0405,A4)
02:0003B784 194000C0        	  7905:     move.b  D0,($00C0,A4)
02:0003B788 194000D3        	  7906:     move.b  D0,($00D3,A4)
                            	  7907:     ; Restart the monster's movement frame cycle: frame 0, counter 4
                            	  7908:     ;
02:0003B78C 41EC03E4        	  7909:     lea     ($03E4,A4),A0
02:0003B790 11802000        	  7910:     move.b  D0,(A0,D2.W)
02:0003B794 7004            	  7911:     moveq   #4,D0
02:0003B796 41EC03D0        	  7912:     lea     ($03D0,A4),A0
02:0003B79A 11802000        	  7913:     move.b  D0,(A0,D2.W)
                            	  7914:     ; Now Link can't move.
                            	  7915:     ;
02:0003B79E 522C0512        	  7916:     addq.b  #1,($0512,A4)
                            	  7917:     even
