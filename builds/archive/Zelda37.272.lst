02:0003D9C2 19400001        	 12552:     move.b  D0,($0001,A4)
02:0003D9C6 101D            	 12553:     move.b  (A5)+,D0  ; PLA
02:0003D9C8 1880            	 12554:     move.b  D0,($0000,A4)
02:0003D9CA 0A3C0001        	 12555:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D9CE 4E75            	 12556:     rts
