02:00039542 19802070        	  3184:     move.b  D0,($70,A4,D2.W)
                            	  3185:     ; If facing down, then use Y offset $28.
                            	  3186:     ; Else store Y offset -$28 in [00].
                            	  3187:     ;
02:00039546 7628            	  3188:     moveq   #40,D3
02:00039548 41EC0098        	  3189:     lea     ($0098,A4),A0
02:0003954C 10302000        	  3190:     move.b  (A0,D2.W),D0
02:00039550 02000008        	  3191:     andi.b #$08,D0
02:00039554 6704            	  3192:     beq  _anon_z04_44
02:00039556 163C00D8        	  3193:     move.b  #$D8,D3
                            	  3194: _anon_z04_44:
02:0003955A 1883            	  3195:     move.b  D3,($0000,A4)
                            	  3196:     ; Add Link's Y and the vertical offset.
                            	  3197:     ;
02:0003955C 102C0084        	  3198:     move.b  ($0084,A4),D0
02:00039560 023C00EE        	  3199:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039564 1214            	  3200:     move.b  ($0000,A4),D1
02:00039566 D101            	  3201:     addx.b  D1,D0   ; ADC $00
                            	  3202:     ; Sanitize the Y coordinate:
                            	  3203:     ; (Y AND $F0) OR $D
                            	  3204:     ;
02:00039568 020000F0        	  3205:     andi.b #$F0,D0
02:0003956C 0000000D        	  3206:     ori.b #$0D,D0
