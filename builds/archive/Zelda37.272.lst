                            	 11534: Lamnola_UpdateHead:
                            	 11535:     ; If X coordinate is not a multiple of 8, then return.
                            	 11536:     ;
02:0003D2DE 10342070        	 11537:     move.b  ($70,A4,D2.W),D0
02:0003D2E2 02000007        	 11538:     andi.b #$07,D0
02:0003D2E6 6702            	 11539:     beq.s  __far_z_04_0112
02:0003D2E8 60F2            	 11540:     jmp  L12A6F_Exit
                            	 11541: __far_z_04_0112:
                            	 11542:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11543:     ; We had to account for the usual offset of 3.
                            	 11544:     ;
02:0003D2EA 41EC0084        	 11545:     lea     ($0084,A4),A0
02:0003D2EE 10302000        	 11546:     move.b  (A0,D2.W),D0
02:0003D2F2 023C00EE        	 11547:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D2F6 123C0003        	 11548:     move.b  #$03,D1
02:0003D2FA D101            	 11549:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003D2FC 02000007        	 11550:     andi.b #$07,D0
02:0003D300 6702            	 11551:     beq.s  __far_z_04_0113
02:0003D302 60D8            	 11552:     jmp  L12A6F_Exit
                            	 11553: __far_z_04_0113:
                            	 11554:     ; Will loop 4 times, propagating directions down the chain,
                            	 11555:     ; by pulling from the bottom.
                            	 11556:     ;
02:0003D304 7004            	 11557:     moveq   #4,D0
02:0003D306 1880            	 11558:     move.b  D0,($0000,A4)
                            	 11559:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11560:     ;
02:0003D308 7600            	 11561:     moveq   #0,D3
02:0003D30A 0C020005        	 11562:     cmpi.b  #$05,D2
02:0003D30E 6702            	 11563:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003D310 7605            	 11564:     moveq   #5,D3
                            	 11565:     even
                            	 11566: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11567:     ; Loop over every segment under the head, starting from the tail.
                            	 11568:     ; Copy the next segment's direction to the current one in this loop.
                            	 11569:     ;
02:0003D312 41EC009A        	 11570:     lea     ($009A,A4),A0
02:0003D316 10303000        	 11571:     move.b  (A0,D3.W),D0
02:0003D31A 41EC0099        	 11572:     lea     ($0099,A4),A0
02:0003D31E 11803000        	 11573:     move.b  D0,(A0,D3.W)
02:0003D322 5203            	 11574:     addq.b  #1,D3
02:0003D324 5314            	 11575:     subq.b  #1,($0000,A4)
02:0003D326 66EA            	 11576:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11577:     ; If this head segment is not aligned with a square, then return.
                            	 11578:     ;
02:0003D328 10342070        	 11579:     move.b  ($70,A4,D2.W),D0
02:0003D32C 0200000F        	 11580:     andi.b #$0F,D0
02:0003D330 660000BA        	 11581:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11582:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11583:     ; We had to account for the usual offset of 3.
                            	 11584:     ;
02:0003D334 41EC0084        	 11585:     lea     ($0084,A4),A0
02:0003D338 10302000        	 11586:     move.b  (A0,D2.W),D0
02:0003D33C 023C00EE        	 11587:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D340 123C0003        	 11588:     move.b  #$03,D1
02:0003D344 D101            	 11589:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003D346 0200000F        	 11590:     andi.b #$0F,D0
02:0003D34A 660000A0        	 11591:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11592:     ; Store the opposite of the facing direction in [00].
                            	 11593:     ;
02:0003D34E 41EC0098        	 11594:     lea     ($0098,A4),A0
02:0003D352 10302000        	 11595:     move.b  (A0,D2.W),D0
02:0003D356 E208            	 11596:     lsr.b  #1,D0   ; LSR A
02:0003D358 02000005        	 11597:     andi.b #$05,D0
02:0003D35C 1880            	 11598:     move.b  D0,($0000,A4)
02:0003D35E 41EC0098        	 11599:     lea     ($0098,A4),A0
02:0003D362 10302000        	 11600:     move.b  (A0,D2.W),D0
02:0003D366 E308            	 11601:     lsl.b  #1,D0   ; ASL A
02:0003D368 0200000A        	 11602:     andi.b #$0A,D0
02:0003D36C 1214            	 11603:     move.b  ($0000,A4),D1
02:0003D36E 8001            	 11604:     or.b  D1,D0
                            	 11605:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11606:     ;
02:0003D370 0A00000F        	 11607:     eori.b #$0F,D0
02:0003D374 1940050F        	 11608:     move.b  D0,($050F,A4)
                            	 11609:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11610:     ;
02:0003D378 10342018        	 11611:     move.b  ($18,A4,D2.W),D0
02:0003D37C 0C000080        	 11612:     cmpi.b  #$80,D0
02:0003D380 656C            	 11613:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11614:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11615:     ; Load the monster's facing direction.
                            	 11616:     ;
02:0003D382 41EC0098        	 11617:     lea     ($0098,A4),A0
02:0003D386 10302000        	 11618:     move.b  (A0,D2.W),D0
                            	 11619:     ; Load the next random number into Y register.
                            	 11620:     ;
02:0003D38A 7600            	 11621:     moveq   #0,D3
02:0003D38C 16342019        	 11622:     move.b  ($19,A4,D2.W),D3
                            	 11623:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11624:     ; to keep moving straight.
                            	 11625:     ;
02:0003D390 0C030080        	 11626:     cmpi.b  #$80,D3
02:0003D394 6418            	 11627:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11628:     even
                            	 11629: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11630:     ; Loop to rotate the direction bit over the mask.
                            	 11631:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11632:     ; facing direction.
                            	 11633:     ;
                            	 11634:     ; Shift right the copy of the direction.
                            	 11635:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11636:     ;
02:0003D396 E208            	 11637:     lsr.b  #1,D0   ; LSR A
02:0003D398 6402            	 11638:     bcc  _anon_z04_151
02:0003D39A 7008            	 11639:     moveq   #8,D0
                            	 11640: _anon_z04_151:
                            	 11641:     ; If the current direction bit is masked off, then we've reached
                            	 11642:     ; the opposite direction. Loop again.
                            	 11643:     ;
02:0003D39C 122C050F        	 11644:     move.b  ($050F,A4),D1
02:0003D3A0 C200            	 11645:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D3A2 67F2            	 11646:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11647:     ; If Y register >= $40, then break out of the loop.
                            	 11648:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11649:     ;
02:0003D3A4 0C030040        	 11650:     cmpi.b  #$40,D3
02:0003D3A8 6404            	 11651:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11652:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11653:     ; and loop again now.
                            	 11654:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11655:     ;
02:0003D3AA 7640            	 11656:     moveq   #64,D3
02:0003D3AC 65E8            	 11657:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11658:     even
                            	 11659: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11660:     ; Change the facing direction to the direction found.
                            	 11661:     ;
02:0003D3AE 41EC0098        	 11662:     lea     ($0098,A4),A0
02:0003D3B2 11802000        	 11663:     move.b  D0,(A0,D2.W)
                            	 11664:     ; Set moving direction [0F] for boundary and tile checks.
                            	 11665:     ;
02:0003D3B6 1940000F        	 11666:     move.b  D0,($000F,A4)
02:0003D3BA 4EB900030498    	 11667:     jsr     BoundByRoom
                            	 11668:     ; If not blocked by the room boundary, then go check tile collision.
                            	 11669:     ;
02:0003D3C0 102C000F        	 11670:     move.b  ($000F,A4),D0
02:0003D3C4 6618            	 11671:     bne  _L_z04_Lamnola_UpdateHead_CheckTileCollision
                            	 11672:     even
                            	 11673: _L_z04_Lamnola_UpdateHead_FindNonOpposite:
                            	 11674:     ; Else it was blocked. So, load the facing direction in preparation
                            	 11675:     ; for looking for any non-opposite direction that is not blocked.
                            	 11676:     ;
02:0003D3C6 41EC0098        	 11677:     lea     ($0098,A4),A0
02:0003D3CA 10302000        	 11678:     move.b  (A0,D2.W),D0
                            	 11679:     even
                            	 11680: _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite:
                            	 11681:     ; Shift right the copy of the direction.
                            	 11682:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11683:     ;
02:0003D3CE E208            	 11684:     lsr.b  #1,D0   ; LSR A
02:0003D3D0 6402            	 11685:     bcc  _anon_z04_152
02:0003D3D2 7008            	 11686:     moveq   #8,D0
                            	 11687: _anon_z04_152:
                            	 11688:     ; If the current direction bit is not masked off, then go check the
                            	 11689:     ; room boundary in this direction.
                            	 11690:     ; Else we've reached the opposite direction. Loop again.
                            	 11691:     ;
02:0003D3D4 122C050F        	 11692:     move.b  ($050F,A4),D1
02:0003D3D8 C200            	 11693:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D3DA 66D2            	 11694:     bne  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
02:0003D3DC 67F0            	 11695:     beq  _L_z04_Lamnola_UpdateHead_LoopFindNonOpposite
                            	 11696:     even
                            	 11697: _L_z04_Lamnola_UpdateHead_CheckTileCollision:
                            	 11698:     ; We found a direction that was not blocked by the room boundary.
                            	 11699:     ; Check tile collision. If blocked by a tile, then go look for another direction.
                            	 11700:     ;
02:0003D3DE 4EB900049A3A    	 11701:     jsr     GetCollidingTileMoving
02:0003D3E4 122C034A        	 11702:     move.b  ($034A,A4),D1
02:0003D3E8 B001            	 11703:     cmp.b   D1,D0
02:0003D3EA 64DA            	 11704:     bcc  _L_z04_Lamnola_UpdateHead_FindNonOpposite
                            	 11705:     even
