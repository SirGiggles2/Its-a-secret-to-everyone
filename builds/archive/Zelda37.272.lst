                            	  5678: ControlMoldormFlight_JumpTable:
02:0003A778 0003A788        	  5679:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A77C 0003A788        	  5680:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A780 0003A788        	  5681:     dc.l    Moldorm_Chase   ; jump table entry (32-bit for _m68k_tablejump)
02:0003A784 0003A7BC        	  5682:     dc.l    Moldorm_Wander   ; jump table entry (32-bit for _m68k_tablejump)
