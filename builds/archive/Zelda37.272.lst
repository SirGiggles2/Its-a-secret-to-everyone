02:0003533C 5303            	  5413:     subq.b  #1,D3
02:0003533E 6AF4            	  5414:     bpl  _anon_z02_51
                            	  5415:     ; If tiles are being written to NT 1 (>= $2800), then
                            	  5416:     ; write the high byte of NT 1's attribute space (>= $2BC0).
