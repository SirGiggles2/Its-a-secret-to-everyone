02:0003ADF8 740B            	  6587:     moveq   #11,D2
                            	  6588:     even
                            	  6589: _L_z04_Aquamentus_Shoot_LoopObject:
                            	  6590:     ; If type <> $55, loop again.
                            	  6591:     ;
02:0003ADFA 41EC034F        	  6592:     lea     ($034F,A4),A0
