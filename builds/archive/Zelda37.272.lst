                            	   872: 
                            	   873: ;------------------------------------------------------------------------------
                            	   874: ; _c_move_object_shim — MoveObject trampoline.
                            	   875: ;
                            	   876: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   877: ;   Input:     D2 = slot (0..11)
                            	   878: ;   Preserves: D2, A4, A5
                            	   879: ;   Clobbers:  D0, D1, D3, A0
                            	   880: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   881: ;
                            	   882: ; GCC side:
                            	   883: ;   void c_move_object(unsigned short slot);
                            	   884: ;     slot arrives as a 16-bit value on the stack.
                            	   885: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   886: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   887: ;   never clobbered by gcc.
                            	   888: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   889: ;   semantics can exist in a pure C port).
                            	   890: ;------------------------------------------------------------------------------
                            	   891: _c_move_object_shim:
                            	   892:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   893:     move.b  #$AA,($0900,A4)
                            	   894:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   895:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   896:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   897:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   898:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   899:     moveq   #0,D0
02:0002B658 3002            	   900:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   901:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   902:     jsr     c_move_object
02:0002B662 588F            	   903:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   904:     rts
                            	   905: 
                            	   906: ;==============================================================================
                            	   907: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   908: ; and tail-call the native asm function.
                            	   909: ;
                            	   910: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   911: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   912: ; sign-extended).
                            	   913: ;==============================================================================
                            	   914: 
                            	   915: ;------------------------------------------------------------------------------
                            	   916: ; void c_copy_bank_to_window(unsigned int bank);
                            	   917: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   918: ;------------------------------------------------------------------------------
                            	   919: c_copy_bank_to_window:
02:0002B666 202F0004        	   920:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   921:     jmp     _copy_bank_to_window
                            	   922: 
                            	   923: ;------------------------------------------------------------------------------
                            	   924: ; unsigned char c_ppu_read_2(void);
                            	   925: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   926: ; C return: gcc expects result in D0.
                            	   927: ;------------------------------------------------------------------------------
                            	   928: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   929:     jmp     _ppu_read_2
                            	   930: 
                            	   931: ;------------------------------------------------------------------------------
                            	   932: ; void c_ppu_write_6(unsigned int val);
                            	   933: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   934: ;------------------------------------------------------------------------------
                            	   935: c_ppu_write_6:
02:0002B674 202F0004        	   936:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   937:     jmp     _ppu_write_6
                            	   938: 
                            	   939: ;------------------------------------------------------------------------------
                            	   940: ; void c_ppu_write_7(unsigned int val);
                            	   941: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   942: ;------------------------------------------------------------------------------
                            	   943: c_ppu_write_7:
02:0002B67E 202F0004        	   944:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   945:     jmp     _ppu_write_7
                            	   946: 
                            	   947: ;------------------------------------------------------------------------------
                            	   948: ; void c_turn_off_all_video(void);
                            	   949: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   950: ;------------------------------------------------------------------------------
                            	   951: c_turn_off_all_video:
02:0002B688 4EF900048D44    	   952:     jmp     TurnOffAllVideo
                            	   953: 
                            	   954: ;==============================================================================
                            	   955: ; EXPORT side — z_03 entry point.
                            	   956: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   957: ; the transpiler emits that label pointing to this shim instead of the
                            	   958: ; z_03 asm body. The C function takes no args and returns void.
                            	   959: ;==============================================================================
                            	   960: 
                            	   961: ;------------------------------------------------------------------------------
                            	   962: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   963: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   964: ;------------------------------------------------------------------------------
                            	   965: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	   966:     jmp     z03_transfer_level_pattern_blocks
                            	   967: 
                            	   968: ;==============================================================================
                            	   969: ; EXPORT side — z_06 entry points (Stage 3a).
                            	   970: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   971: ;==============================================================================
                            	   972: 
                            	   973: c_init_mode2_submodes:
02:0002B694 4EF900000000    	   974:     jmp     z06_init_mode2_submodes
                            	   975: 
                            	   976: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	   977:     jmp     z06_copy_common_data_to_ram
                            	   978: 
                            	   979: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	   980:     jmp     z06_update_mode2_load_full
                            	   981: 
                            	   982: ;==============================================================================
                            	   983: ; EXPORT side — z_05 entry points (Stage 3b).
                            	   984: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	   985: ;==============================================================================
                            	   986: 
                            	   987: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	   988:     jmp     z05_copy_column_to_tilebuf
                            	   989: 
                            	   990: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	   991:     jmp     z05_copy_row_to_tilebuf
                            	   992: 
                            	   993: ;==============================================================================
                            	   994: ; EXPORT side — z_05 entry points (Stage 4a).
                            	   995: ;==============================================================================
                            	   996: 
                            	   997: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	   998: c_has_compass:
02:0002B6B2 4EB900000000    	   999:     jsr     z05_has_compass
02:0002B6B8 4A00            	  1000:     tst.b   D0
02:0002B6BA 4E75            	  1001:     rts
                            	  1002: 
                            	  1003: c_has_map:
02:0002B6BC 4EB900000000    	  1004:     jsr     z05_has_map
02:0002B6C2 4A00            	  1005:     tst.b   D0
02:0002B6C4 4E75            	  1006:     rts
                            	  1007: 
                            	  1008: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	  1009: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	  1010:     move.l  D0,-(SP)
02:0002B6C8 7200            	  1011:     moveq   #0,D1
02:0002B6CA 1202            	  1012:     move.b  D2,D1
02:0002B6CC 2F01            	  1013:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	  1014:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	  1015:     andi.l  #$FF,D1
02:0002B6D8 2F01            	  1016:     move.l  D1,-(SP)
02:0002B6DA 4EB900000000    	  1017:     jsr     z05_calc_open_doorway_mask
02:0002B6E0 508F            	  1018:     addq.l  #8,SP
02:0002B6E2 201F            	  1019:     move.l  (SP)+,D0
02:0002B6E4 4E75            	  1020:     rts
                            	  1021: 
                            	  1022: ; AddDoorFlagsToCurOpenedDoors — no args, void return
                            	  1023: c_add_door_flags:
02:0002B6E6 4EF900000000    	  1024:     jmp     z05_add_door_flags
                            	  1025: 
                            	  1026: ;==============================================================================
                            	  1027: ; EXPORT side — z_05 entry points (Stage 4b).
                            	  1028: ;==============================================================================
                            	  1029: 
                            	  1030: ; SplitRoomId — reads RAM($EB), returns D2=row (hi nibble), D3=col (lo nibble).
                            	  1031: ; C function returns (row<<8)|col in D0; shim unpacks into D2/D3.
                            	  1032: c_split_room_id:
02:0002B6EC 4EB900000000    	  1033:     jsr     z05_split_room_id
02:0002B6F2 7600            	  1034:     moveq   #0,D3
02:0002B6F4 1600            	  1035:     move.b  D0,D3           ; col = low byte of return
02:0002B6F6 E048            	  1036:     lsr.w   #8,D0
02:0002B6F8 7400            	  1037:     moveq   #0,D2
02:0002B6FA 1400            	  1038:     move.b  D0,D2           ; row = high byte of return
02:0002B6FC 4E75            	  1039:     rts
                            	  1040: 
                            	  1041: ; IsDarkRoom_Bank5 — D3=column. Returns D0=$80 if dark, 0 otherwise.
                            	  1042: ; Sets CCR flags for callers that branch on BEQ/BNE.
                            	  1043: c_is_dark_room:
02:0002B6FE 7000            	  1044:     moveq   #0,D0
02:0002B700 3003            	  1045:     move.w  D3,D0
02:0002B702 2F00            	  1046:     move.l  D0,-(SP)
