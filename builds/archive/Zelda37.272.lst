                            	  5016: 
                            	  5017: ; Params:
                            	  5018: ; [02]: bitmask for target door.
                            	  5019: ;
                            	  5020: ; Returns:
                            	  5021: ; A: door attribute for desired direction in current room.
                            	  5022: ; [01]: same as [02] if found; $10 otherwise
                            	  5023: ; [03]: reverse direction index
                            	  5024: ;
                            	  5025: ; Door bits:
                            	  5026: ; 1: E
                            	  5027: ; 2: W
                            	  5028: ; 4: S
                            	  5029: ; 8: N
                            	  5030: ;
                            	  5031: ;
                            	  5032: ; Start with single-bit mask 1.
                            	  5033:     even
                            	  5034: FindDoorAttrByDoorBit:
02:0004173A 7001            	  5035:     moveq   #1,D0
02:0004173C 19400001        	  5036:     move.b  D0,($0001,A4)
02:00041740 7003            	  5037:     moveq   #3,D0
02:00041742 19400003        	  5038:     move.b  D0,($0003,A4)
                            	  5039:     even
