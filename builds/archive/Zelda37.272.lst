                            	  2525: UpdateTektiteOrBoulder:
                            	  2526:     ; If the monster is shoved, then keep shoving it.
                            	  2527:     ;
02:00039054 41EC00C0        	  2528:     lea     ($00C0,A4),A0
02:00039058 10302000        	  2529:     move.b  (A0,D2.W),D0
