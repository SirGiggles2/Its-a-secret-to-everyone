02:0003372C 19400070        	  2728:     move.b  D0,($0070,A4)
02:00033730 103C0087        	  2729:     move.b  #$87,D0
02:00033734 19400085        	  2730:     move.b  D0,($0085,A4)
02:00033738 7030            	  2731:     moveq   #48,D0
