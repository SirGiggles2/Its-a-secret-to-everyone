                            	  2535: _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions:
02:00039062 600001EC        	  2536:     jmp     Jumper_AnimateAndCheckCollisions
                            	  2537: 
                            	  2538:     even
                            	  2539: _L_z04_UpdateTektiteOrBoulder_CheckStunned:
                            	  2540:     ; If we have the magic clock, or the monster is stunned; 
                            	  2541:     ; then go animate, draw, and check collisions.
                            	  2542:     ;
02:00039066 102C066C        	  2543:     move.b  ($066C,A4),D0
02:0003906A 1234203D        	  2544:     move.b  ($3D,A4,D2.W),D1
02:0003906E 8001            	  2545:     or.b  D1,D0
02:00039070 66F0            	  2546:     bne  _L_z04_UpdateTektiteOrBoulder_DrawAndCheckCollisions
                            	  2547:     ; If state <> 0, go update the jump.
                            	  2548:     ;
02:00039072 41EC00AC        	  2549:     lea     ($00AC,A4),A0
02:00039076 10302000        	  2550:     move.b  (A0,D2.W),D0
02:0003907A 660000C0        	  2551:     bne  _L_z04_UpdateTektiteOrBoulder_State1
                            	  2552:     ; State 0. On the ground.
                            	  2553:     ;
                            	  2554:     ; If timer <> 0, then go animate, draw, and check collisions.
                            	  2555:     ;
02:0003907E 10342028        	  2556:     move.b  ($28,A4,D2.W),D0
02:00039082 660000B4        	  2557:     bne  _L_z04_UpdateTektiteOrBoulder_Animate
                            	  2558:     ; State = 0 and object timer expired. Time to jump.
                            	  2559:     ;
                            	  2560:     ; First, turn 1 step toward the chase target.
                            	  2561:     ;
02:00039086 610050FE        	  2562:     jsr     TurnTowardsPlayer8
                            	  2563:     ; If the facing direction has no horizontal component, then
                            	  2564:     ; find the horizontal direction toward the chase target.
                            	  2565:     ;
                            	  2566:     ; Then combine it with the facing direction.
                            	  2567:     ;
02:0003908A 41EC0098        	  2568:     lea     ($0098,A4),A0
02:0003908E 10302000        	  2569:     move.b  (A0,D2.W),D0
02:00039092 02000003        	  2570:     andi.b #$03,D0
02:00039096 6624            	  2571:     bne  _L_z04_UpdateTektiteOrBoulder_SetStateJump
02:00039098 7602            	  2572:     moveq   #2,D3
02:0003909A 102C0061        	  2573:     move.b  ($0061,A4),D0
02:0003909E 12342070        	  2574:     move.b  ($70,A4,D2.W),D1
02:000390A2 B001            	  2575:     cmp.b   D1,D0
02:000390A4 6502            	  2576:     bcs  _anon_z04_36
02:000390A6 5303            	  2577:     subq.b  #1,D3
                            	  2578: _anon_z04_36:
02:000390A8 1003            	  2579:     move.b  D3,D0
02:000390AA 41EC0098        	  2580:     lea     ($0098,A4),A0
02:000390AE 12302000        	  2581:     move.b  (A0,D2.W),D1
02:000390B2 8001            	  2582:     or.b  D1,D0
02:000390B4 41EC0098        	  2583:     lea     ($0098,A4),A0
02:000390B8 11802000        	  2584:     move.b  D0,(A0,D2.W)
                            	  2585:     even
                            	  2586: _L_z04_UpdateTektiteOrBoulder_SetStateJump:
                            	  2587:     ; Set state 1 to jump.
                            	  2588:     ;
02:000390BC 41EC00AC        	  2589:     lea     ($00AC,A4),A0
02:000390C0 52302000        	  2590:     addq.b  #1,(A0,D2.W)
                            	  2591:     even
                            	  2592: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2593:     ; If reversal count >= 2, then
                            	  2594:     ; 1. invert the horizontal component of facing direction,
                            	  2595:     ;    to face away from the chase target
                            	  2596:     ; 2. reset the reversal count to 0.
                            	  2597:     ;
                            	  2598:     ; This prevents a jumper from getting stuck in a corner.
                            	  2599:     ;
                            	  2600:     ; For example, if a tektite's direction is down and right,
                            	  2601:     ; and jumps into the top right corner of the room:
                            	  2602:     ; 1. The right room boundary is hit. So the direction is
                            	  2603:     ;    automatically reversed to up and left.
                            	  2604:     ; 2. The next frame, the top room boundary is hit.
                            	  2605:     ;    The direction is reversed to down and right.
                            	  2606:     ;
                            	  2607:     ; As you can see, an endless loop has been made.
                            	  2608:     ;
02:000390C4 41EC0451        	  2609:     lea     ($0451,A4),A0
02:000390C8 10302000        	  2610:     move.b  (A0,D2.W),D0
02:000390CC 0C000002        	  2611:     cmpi.b  #$02,D0
02:000390D0 651E            	  2612:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:000390D2 41EC0098        	  2613:     lea     ($0098,A4),A0
02:000390D6 10302000        	  2614:     move.b  (A0,D2.W),D0
02:000390DA 0A000003        	  2615:     eori.b #$03,D0
02:000390DE 41EC0098        	  2616:     lea     ($0098,A4),A0
02:000390E2 11802000        	  2617:     move.b  D0,(A0,D2.W)
02:000390E6 7000            	  2618:     moveq   #0,D0
02:000390E8 41EC0451        	  2619:     lea     ($0451,A4),A0
02:000390EC 11802000        	  2620:     move.b  D0,(A0,D2.W)
                            	  2621:     even
                            	  2622: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2623:     ; If the object is a boulder, then make sure its facing direction
                            	  2624:     ; has a down vertical component.
                            	  2625:     ;
02:000390F0 610001F8        	  2626:     jsr     Jumper_PointBoulderDownward
                            	  2627:     ; For the given direction, get the Y offset of the destination
                            	  2628:     ; of the jump.
                            	  2629:     ;
                            	  2630:     ; Add it to the object's Y, and store this destination Y.
                            	  2631:     ;
02:000390F4 7600            	  2632:     moveq   #0,D3
02:000390F6 41EC0098        	  2633:     lea     ($0098,A4),A0
02:000390FA 16302000        	  2634:     move.b  (A0,D2.W),D3
02:000390FE 41EC0084        	  2635:     lea     ($0084,A4),A0
02:00039102 10302000        	  2636:     move.b  (A0,D2.W),D0
02:00039106 023C00EE        	  2637:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003910A 41F900039022    	  2638:     lea     (JumperYOffsets).l,A0
02:00039110 12303000        	  2639:     move.b  (A0,D3.W),D1
02:00039114 D101            	  2640:     addx.b  D1,D0   ; ADC JumperYOffsets,Y
02:00039116 41EC0444        	  2641:     lea     ($0444,A4),A0
02:0003911A 11802000        	  2642:     move.b  D0,(A0,D2.W)
                            	  2643:     ; Set the starting speed, depending on the object type.
                            	  2644:     ;
02:0003911E 610001A0        	  2645:     jsr     Jumper_GetKind
02:00039122 41F90003904C    	  2646:     lea     (JumperStartSpeedsHi).l,A0
02:00039128 10303000        	  2647:     move.b  (A0,D3.W),D0
02:0003912C 41EC0412        	  2648:     lea     ($0412,A4),A0
02:00039130 11802000        	  2649:     move.b  D0,(A0,D2.W)
                            	  2650:     ; Reset the vertical speed low byte.
                            	  2651:     ; Then go animate, draw, and check collisions.
                            	  2652:     ;
02:00039134 6100022E        	  2653:     jsr     Jumper_ResetVSpeedFrac
                            	  2654:     even
                            	  2655: _L_z04_UpdateTektiteOrBoulder_Animate:
02:00039138 60000116        	  2656:     jmp     Jumper_AnimateAndCheckCollisions
                            	  2657: 
                            	  2658:     even
                            	  2659: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2660:     ; State 1. Jumping.
                            	  2661:     ;
                            	  2662:     ; Keep the object inside the bounds of the room.
                            	  2663:     ;
02:0003913C 61004FB6        	  2664:     jsr     BoundFlyer
                            	  2665:     ; If the object was blocked at the room boundary, then
                            	  2666:     ; increase boundary reversal count, and go set up another jump.
                            	  2667:     ;
02:00039140 102C000F        	  2668:     move.b  ($000F,A4),D0
02:00039144 660C            	  2669:     bne  _anon_z04_37
02:00039146 41EC0451        	  2670:     lea     ($0451,A4),A0
02:0003914A 52302000        	  2671:     addq.b  #1,(A0,D2.W)
02:0003914E 6000FF74        	  2672:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2673: 
                            	  2674: _anon_z04_37:
02:00039152 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:00039156 7000            	  2678:     moveq   #0,D0
02:00039158 41EC0451        	  2679:     lea     ($0451,A4),A0
02:0003915C 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:00039160 6100015E        	  2683:     jsr     Jumper_GetKind
02:00039164 41F900039050    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003916A 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:0003916E 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039172 41EC0098        	  2696:     lea     ($0098,A4),A0
02:00039176 12302000        	  2697:     move.b  (A0,D2.W),D1
02:0003917A D101            	  2698:     addx.b  D1,D0   ; ADC ObjDir,X
02:0003917C 7600            	  2699:     moveq   #0,D3
02:0003917E 1600            	  2700:     move.b  D0,D3
02:00039180 41F90003902E    	  2701:     lea     (JumperYAccelerations).l,A0
02:00039186 10303000        	  2702:     move.b  (A0,D3.W),D0
02:0003918A 7602            	  2703:     moveq   #2,D3
02:0003918C 61000162        	  2704:     jsr     Jumper_MoveY
                            	  2705:     ; If the facing direction has a left component, then
                            	  2706:     ; subtract 1 from the object's X.
                            	  2707:     ;
                            	  2708:     ; Else add 1.
                            	  2709:     ;
02:00039190 163C00FF        	  2710:     move.b  #$FF,D3
02:00039194 41EC0098        	  2711:     lea     ($0098,A4),A0
02:00039198 10302000        	  2712:     move.b  (A0,D2.W),D0
02:0003919C 02000002        	  2713:     andi.b #$02,D0
02:000391A0 6602            	  2714:     bne  _anon_z04_38
02:000391A2 7601            	  2715:     moveq   #1,D3
                            	  2716: _anon_z04_38:
02:000391A4 1003            	  2717:     move.b  D3,D0
02:000391A6 023C00EE        	  2718:     andi    #$EE,CCR  ; CLC: clear C+X
02:000391AA 12342070        	  2719:     move.b  ($70,A4,D2.W),D1
02:000391AE D101            	  2720:     addx.b  D1,D0   ; ADC ObjX,X
02:000391B0 19802070        	  2721:     move.b  D0,($70,A4,D2.W)
                            	  2722:     ; If going up (negative v-speed high byte), then
                            	  2723:     ; go animate, draw, and check collisions.
                            	  2724:     ;
02:000391B4 41EC0412        	  2725:     lea     ($0412,A4),A0
02:000391B8 10302000        	  2726:     move.b  (A0,D2.W),D0
02:000391BC 6A04            	  2727:     bpl.s  __far_z_04_0022
02:000391BE 60000090        	  2728:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2729: __far_z_04_0022:
                            	  2730:     ; Going down. We have to consider the target Y.
                            	  2731:     ;
                            	  2732:     ; If the absolute vertical distance to the target position >= 3,
                            	  2733:     ; then go animate, draw, and check collisions.
                            	  2734:     ;
02:000391C2 41EC0084        	  2735:     lea     ($0084,A4),A0
02:000391C6 10302000        	  2736:     move.b  (A0,D2.W),D0
02:000391CA 003C0011        	  2737:     ori     #$11,CCR  ; SEC: set C+X
02:000391CE 41EC0444        	  2738:     lea     ($0444,A4),A0
02:000391D2 12302000        	  2739:     move.b  (A0,D2.W),D1
02:000391D6 0A3C0010        	  2740:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000391DA 9101            	  2741:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:000391DC 0A3C0010        	  2742:     eori    #$10,CCR  ; restore X = 6502 C
02:000391E0 4EB9000304AC    	  2743:     jsr     Abs
02:000391E6 0C000003        	  2744:     cmpi.b  #$03,D0
02:000391EA 6502            	  2745:     bcs.s  __far_z_04_0023
02:000391EC 6062            	  2746:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2747: __far_z_04_0023:
                            	  2748:     ; Distance < 3. Go to state 0.
                            	  2749:     ;
                            	  2750:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2751:     ;
02:000391EE 4EB90004ACA2    	  2752:     jsr     ResetObjState
02:000391F4 7600            	  2753:     moveq   #0,D3
02:000391F6 41EC034F        	  2754:     lea     ($034F,A4),A0
02:000391FA 16302000        	  2755:     move.b  (A0,D2.W),D3
02:000391FE 0C030020        	  2756:     cmpi.b  #$20,D3
02:00039202 6748            	  2757:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2758:     ; Else calculate a timer value.
                            	  2759:     ;
                            	  2760:     ; t := (Random + $10)
                            	  2761:     ; if t < $20 then
                            	  2762:     ;   t := t - $40
                            	  2763:     ;
02:00039204 7010            	  2764:     moveq   #16,D0
02:00039206 023C00EE        	  2765:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003920A 12342019        	  2766:     move.b  ($19,A4,D2.W),D1
02:0003920E D101            	  2767:     addx.b  D1,D0   ; ADC Random+1,X
02:00039210 0C000020        	  2768:     cmpi.b  #$20,D0
02:00039214 6412            	  2769:     bcc  _anon_z04_39
02:00039216 003C0011        	  2770:     ori     #$11,CCR  ; SEC: set C+X
02:0003921A 123C0040        	  2771:     move.b  #$40,D1
02:0003921E 0A3C0010        	  2772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039222 9101            	  2773:     subx.b  D1,D0   ; SBC #$40
02:00039224 0A3C0010        	  2774:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2775: _anon_z04_39:
                            	  2776:     ; If the object is a blue tektite, then go use this t.
                            	  2777:     ;
02:00039228 7600            	  2778:     moveq   #0,D3
02:0003922A 41EC034F        	  2779:     lea     ($034F,A4),A0
02:0003922E 16302000        	  2780:     move.b  (A0,D2.W),D3
02:00039232 0C03000D        	  2781:     cmpi.b  #$0D,D3
02:00039236 6714            	  2782:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2783:     ; t := t AND $7F
