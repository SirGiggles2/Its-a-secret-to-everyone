02:0003D62C 52302000        	 12025:     addq.b  #1,(A0,D2.W)
                            	 12026:     ; TODO: ?
                            	 12027:     ;
02:0003D630 103C0080        	 12028:     move.b  #$80,D0
02:0003D634 41EC0098        	 12029:     lea     ($0098,A4),A0
02:0003D638 11802000        	 12030:     move.b  D0,(A0,D2.W)
                            	 12031:     ; Set angle $18 (N).
                            	 12032:     ;
02:0003D63C 7018            	 12033:     moveq   #24,D0
02:0003D63E 41EC0394        	 12034:     lea     ($0394,A4),A0
02:0003D642 11802000        	 12035:     move.b  D0,(A0,D2.W)
                            	 12036:     ; This location is right above Patra.
                            	 12037:     ; Set X coordinate to Patra's.
                            	 12038:     ;
02:0003D646 102C0071        	 12039:     move.b  ($0071,A4),D0
02:0003D64A 19802070        	 12040:     move.b  D0,($70,A4,D2.W)
                            	 12041:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 12042:     ; Else use radius $18. Store the chosen value in [00].
                            	 12043:     ;
02:0003D64E 702C            	 12044:     moveq   #44,D0
02:0003D650 7600            	 12045:     moveq   #0,D3
02:0003D652 41EC034F        	 12046:     lea     ($034F,A4),A0
02:0003D656 16302000        	 12047:     move.b  (A0,D2.W),D3
02:0003D65A 0C030025        	 12048:     cmpi.b  #$25,D3
02:0003D65E 6702            	 12049:     beq  _anon_z04_158
02:0003D660 7018            	 12050:     moveq   #24,D0
                            	 12051: _anon_z04_158:
02:0003D662 1880            	 12052:     move.b  D0,($0000,A4)
