                            	  7740: __far_z_07_0124:
                            	  7741:     ; 7 of every 8 frames, return.
                            	  7742:     ;
02:0004B92C 102C0015        	  7743:     move.b  ($0015,A4),D0
02:0004B930 02000007        	  7744:     andi.b #$07,D0
02:0004B934 0C000004        	  7745:     cmpi.b  #$04,D0
02:0004B938 6702            	  7746:     beq.s  __far_z_07_0125
