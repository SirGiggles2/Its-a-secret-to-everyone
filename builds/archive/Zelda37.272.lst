02:0002EAC6 6000CF26        	   267:     jmp     c_unhalt_link
                            	   268: 
                            	   269: InitCaveContinue:
                            	   270:     ; Get this cave's index (object type - $6A).
                            	   271:     ;
02:0002EACA 102C0350        	   272:     move.b  ($0350,A4),D0
02:0002EACE 003C0011        	   273:     ori     #$11,CCR  ; SEC: set C+X
02:0002EAD2 123C006A        	   274:     move.b  #$6A,D1
02:0002EAD6 0A3C0010        	   275:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EADA 9101            	   276:     subx.b  D1,D0   ; SBC #$6A
02:0002EADC 0A3C0010        	   277:     eori    #$10,CCR  ; restore X = 6502 C
02:0002EAE0 7600            	   278:     moveq   #0,D3
02:0002EAE2 1600            	   279:     move.b  D0,D3
                            	   280:     ; Get the person text selector by looking up the text selector byte
                            	   281:     ; for this index, and masking it with $3F.
                            	   282:     ;
02:0002EAE4 41F90002EA94    	   283:     lea     (OverworldPersonTextSelectors).l,A0
02:0002EAEA 10303000        	   284:     move.b  (A0,D3.W),D0
02:0002EAEE 1B00            	   285:     move.b  D0,-(A5)  ; PHA
02:0002EAF0 0200003F        	   286:     andi.b #$3F,D0
02:0002EAF4 19400415        	   287:     move.b  D0,($0415,A4)
                            	   288:     ; Pop and mask the text selector byte with $C0 to get the
                            	   289:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   290:     ;
02:0002EAF8 101D            	   291:     move.b  (A5)+,D0  ; PLA
02:0002EAFA 020000C0        	   292:     andi.b #$C0,D0
02:0002EAFE 19400003        	   293:     move.b  D0,($0003,A4)
                            	   294:     ; At this point, the Y register still has the cave index.
                            	   295:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   296:     ;
02:0002EB02 103C00FD        	   297:     move.b  #$FD,D0
                            	   298: _anon_z01_0:
02:0002EB06 023C00EE        	   299:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EB0A 123C0003        	   300:     move.b  #$03,D1
02:0002EB0E D101            	   301:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002EB10 5303            	   302:     subq.b  #1,D3
02:0002EB12 6AF2            	   303:     bpl  _anon_z01_0
02:0002EB14 7600            	   304:     moveq   #0,D3
02:0002EB16 1600            	   305:     move.b  D0,D3
                            	   306:     ; Loop over the wares from 0 to 2.
                            	   307:     ;
02:0002EB18 7400            	   308:     moveq   #0,D2
                            	   309:     even
                            	   310: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   311:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   312:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   313:     ;
02:0002EB1A 41F900FF6A7E    	   314:     lea     (NES_SRAM+$0A7E).l,A0
02:0002EB20 10303000        	   315:     move.b  (A0,D3.W),D0
02:0002EB24 41EC0422        	   316:     lea     ($0422,A4),A0
02:0002EB28 11802000        	   317:     move.b  D0,(A0,D2.W)
                            	   318:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   319:     ;
02:0002EB2C 020000C0        	   320:     andi.b #$C0,D0
02:0002EB30 19802000        	   321:     move.b  D0,($00,A4,D2.W)
                            	   322:     ; Copy 3 prices from the Cave level block info.
                            	   323:     ;
02:0002EB34 41F900FF6ABA    	   324:     lea     (NES_SRAM+$0ABA).l,A0
02:0002EB3A 10303000        	   325:     move.b  (A0,D3.W),D0
02:0002EB3E 41EC0430        	   326:     lea     ($0430,A4),A0
02:0002EB42 11802000        	   327:     move.b  D0,(A0,D2.W)
                            	   328:     ; Bottom of the wares copying loop.
                            	   329:     ;
02:0002EB46 5203            	   330:     addq.b  #1,D3
02:0002EB48 5202            	   331:     addq.b  #1,D2
02:0002EB4A 0C020003        	   332:     cmpi.b  #$03,D2
02:0002EB4E 66CA            	   333:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   334:     ; Get the top 2 bits of text selector byte in [03],
                            	   335:     ; shift them to the bottom, and combine them with [00].
                            	   336:     ;
02:0002EB50 102C0003        	   337:     move.b  ($0003,A4),D0
02:0002EB54 E308            	   338:     lsl.b  #1,D0   ; ASL A
02:0002EB56 E310            	   339:     roxl.b  #1,D0   ; ROL A
02:0002EB58 E310            	   340:     roxl.b  #1,D0   ; ROL A
02:0002EB5A 1214            	   341:     move.b  ($0000,A4),D1
02:0002EB5C 8001            	   342:     or.b  D1,D0
02:0002EB5E 1880            	   343:     move.b  D0,($0000,A4)
                            	   344:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   345:     ; and combine them with [00].
                            	   346:     ;
02:0002EB60 102C0002        	   347:     move.b  ($0002,A4),D0
02:0002EB64 E208            	   348:     lsr.b  #1,D0   ; LSR A
02:0002EB66 E208            	   349:     lsr.b  #1,D0   ; LSR A
02:0002EB68 E208            	   350:     lsr.b  #1,D0   ; LSR A
02:0002EB6A E208            	   351:     lsr.b  #1,D0   ; LSR A
02:0002EB6C 1214            	   352:     move.b  ($0000,A4),D1
02:0002EB6E 8001            	   353:     or.b  D1,D0
02:0002EB70 1880            	   354:     move.b  D0,($0000,A4)
                            	   355:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   356:     ; and combine them with [00] into CaveFlags.
                            	   357:     ;
02:0002EB72 102C0001        	   358:     move.b  ($0001,A4),D0
02:0002EB76 E208            	   359:     lsr.b  #1,D0   ; LSR A
02:0002EB78 E208            	   360:     lsr.b  #1,D0   ; LSR A
02:0002EB7A 1214            	   361:     move.b  ($0000,A4),D1
02:0002EB7C 8001            	   362:     or.b  D1,D0
02:0002EB7E 19400413        	   363:     move.b  D0,($0413,A4)
                            	   364:     ; The end result is a byte with 8 cave flags.
                            	   365:     ;
                            	   366:     ; If cave flag "money game" is missing, then go finish up,
                            	   367:     ; instead of choosing random amounts for the money game.
                            	   368:     ;
02:0002EB82 02000020        	   369:     andi.b #$20,D0
02:0002EB86 6700009E        	   370:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   371:     ; Determine an index randomly with increasing probability,
                            	   372:     ; from 6 to 1. Start with the following test:
                            	   373:     ;
                            	   374:     ;   If $FF < Random, then go use index 6.
                            	   375:     ;
02:0002EB8A 103C00FF        	   376:     move.b  #$FF,D0
02:0002EB8E 7606            	   377:     moveq   #6,D3
                            	   378:     even
                            	   379: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002EB90 122C0019        	   380:     move.b  ($0019,A4),D1
02:0002EB94 B001            	   381:     cmp.b   D1,D0
02:0002EB96 6516            	   382:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   383:     ; If the test fails, then subtract $2B from the reference number.
                            	   384:     ;
02:0002EB98 003C0011        	   385:     ori     #$11,CCR  ; SEC: set C+X
02:0002EB9C 123C002B        	   386:     move.b  #$2B,D1
02:0002EBA0 0A3C0010        	   387:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002EBA4 9101            	   388:     subx.b  D1,D0   ; SBC #$2B
