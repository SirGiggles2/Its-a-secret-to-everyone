02:0003C644 123C0008        	  9901:     move.b  #$08,D1
02:0003C648 D101            	  9902:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003C64A 19802070        	  9903:     move.b  D0,($70,A4,D2.W)
02:0003C64E 532C000F        	  9904:     subq.b  #1,($000F,A4)
02:0003C652 66E2            	  9905:     bne  _L_z04_Gohma_CheckCollisions_LoopSprite
                            	  9906:     ; Restore the boss's X coordinate.
