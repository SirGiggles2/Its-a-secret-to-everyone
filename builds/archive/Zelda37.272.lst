02:0003B4DC 10302000        	  7605:     move.b  (A0,D2.W),D0
02:0003B4E0 023C00EE        	  7606:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B4E4 41F90003B474    	  7607:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003B4EA 12303000        	  7608:     move.b  (A0,D3.W),D1
02:0003B4EE D101            	  7609:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003B4F0 41EC0084        	  7610:     lea     ($0084,A4),A0
02:0003B4F4 11802000        	  7611:     move.b  D0,(A0,D2.W)
                            	  7612:     even
