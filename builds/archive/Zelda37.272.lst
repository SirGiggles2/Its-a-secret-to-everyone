02:0003D41C 102C0084        	 11740:     move.b  ($0084,A4),D0
02:0003D420 003C0011        	 11741:     ori     #$11,CCR  ; SEC: set C+X
02:0003D424 41EC0084        	 11742:     lea     ($0084,A4),A0
02:0003D428 12302000        	 11743:     move.b  (A0,D2.W),D1
02:0003D42C 0A3C0010        	 11744:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D430 9101            	 11745:     subx.b  D1,D0   ; SBC ObjY,X
02:0003D432 0A3C0010        	 11746:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D436 640A            	 11747:     bcc  _anon_z04_154
02:0003D438 122C0003        	 11748:     move.b  ($0003,A4),D1
