                            	  5685: Moldorm_Chase:
                            	  5686:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5687:     ; Only the head controls the movement direction.
                            	  5688:     ;
02:0003A788 0C020005        	  5689:     cmpi.b  #$05,D2
02:0003A78C 670A            	  5690:     beq  _anon_z04_81
02:0003A78E 0C02000A        	  5691:     cmpi.b  #$0A,D2
02:0003A792 6704            	  5692:     beq.s  __far_z_04_0040
02:0003A794 600000A4        	  5693:     jmp  L1156B_Exit
                            	  5694: __far_z_04_0040:
                            	  5695: _anon_z04_81:
                            	  5696:     ; Chase while flying, as usual.
                            	  5697:     ;
02:0003A798 610039CC        	  5698:     jsr     Flyer_Chase
                            	  5699:     ; If timer has not expired, then
                            	  5700:     ; go see if it's time to propagate direction changes down the chain.
                            	  5701:     ;
02:0003A79C 10342028        	  5702:     move.b  ($28,A4,D2.W),D0
02:0003A7A0 6702            	  5703:     beq.s  __far_z_04_0041
02:0003A7A2 6032            	  5704:     jmp  Moldorm_PropagateDirs
                            	  5705: __far_z_04_0041:
                            	  5706:     even
                            	  5707: Moldorm_ChangeFlyingState:
                            	  5708:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5709:     ;
02:0003A7A4 61000096        	  5710:     jsr     Flyer_MoldormDecideState
02:0003A7A8 7010            	  5711:     moveq   #16,D0
02:0003A7AA 19802028        	  5712:     move.b  D0,($28,A4,D2.W)
                            	  5713:     ; If the next lower slot's direction <> 0, then
                            	  5714:     ; go propagate direction changes down the chain.
                            	  5715:     ;
                            	  5716:     ; But you had to have propagated directions once for the
                            	  5717:     ; next lower direction to be set. How does it happen?
                            	  5718:     ;
                            	  5719:     ; Within a flyer state, the flying routines turn the flyer
                            	  5720:     ; and set the object timer to $10 several times. After any of
                            	  5721:     ; those times will the test succeed.
                            	  5722:     ;
                            	  5723:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5724:     ; in this block to set the timer to $10, and try to propagate
                            	  5725:     ; directions.
                            	  5726:     ;
                            	  5727:     ; But this is also the case the first time here.
                            	  5728:     ;
                            	  5729:     ; So, I believe that the point of this test is to delay moving
                            	  5730:     ; the lower (not head) segments when starting out.
                            	  5731:     ;
02:0003A7AE 41EC0097        	  5732:     lea     ($0097,A4),A0
02:0003A7B2 10302000        	  5733:     move.b  (A0,D2.W),D0
02:0003A7B6 6702            	  5734:     beq.s  __far_z_04_0042
02:0003A7B8 601C            	  5735:     jmp  Moldorm_PropagateDirs
                            	  5736: __far_z_04_0042:
02:0003A7BA 4E75            	  5737:     rts
                            	  5738: 
                            	  5739:     even
                            	  5740: Moldorm_Wander:
                            	  5741:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5742:     ; Only the head controls the movement direction.
                            	  5743:     ;
02:0003A7BC 0C020005        	  5744:     cmpi.b  #$05,D2
02:0003A7C0 6708            	  5745:     beq  _anon_z04_82
02:0003A7C2 0C02000A        	  5746:     cmpi.b  #$0A,D2
02:0003A7C6 6702            	  5747:     beq.s  __far_z_04_0043
02:0003A7C8 6070            	  5748:     jmp  L1156B_Exit
                            	  5749: __far_z_04_0043:
                            	  5750: _anon_z04_82:
                            	  5751:     ; Turn randomly while flying, as usual.
                            	  5752:     ;
02:0003A7CA 61003A78        	  5753:     jsr     Flyer_Wander
                            	  5754:     ; After every turn, the common flyer routines set timer to $10.
                            	  5755:     ; This can be used as a signal for moldorm to propagate
                            	  5756:     ; direction changes down the chain.
                            	  5757:     ;
                            	  5758:     ; Between each turn, timer <> $10.
                            	  5759:     ;
                            	  5760:     ; At the end of the delay after the last turn, timer = 0.
                            	  5761:     ; This is a signal that that flying state ended, and a new one
                            	  5762:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5763:     ; we can propagate direction changes again; and start
                            	  5764:     ; a new flying interval by setting timer to $10. This will make
                            	  5765:     ; the next flying state delay that amount of time before turning
                            	  5766:     ; the first time.
                            	  5767:     ;
                            	  5768:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5769:     ; arm the timer again, and shift directions down the chain.
                            	  5770:     ;
02:0003A7CE 10342028        	  5771:     move.b  ($28,A4,D2.W),D0
02:0003A7D2 6602            	  5772:     bne.s  __far_z_04_0044
02:0003A7D4 60CE            	  5773:     jmp  Moldorm_ChangeFlyingState
                            	  5774: __far_z_04_0044:
                            	  5775:     even
                            	  5776: Moldorm_PropagateDirs:
                            	  5777:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5778:     ;
02:0003A7D6 10342028        	  5779:     move.b  ($28,A4,D2.W),D0
02:0003A7DA 0C000010        	  5780:     cmpi.b  #$10,D0
02:0003A7DE 6702            	  5781:     beq.s  __far_z_04_0045
02:0003A7E0 6058            	  5782:     jmp  L1156B_Exit
                            	  5783: __far_z_04_0045:
                            	  5784:     ; Timer = $10.
                            	  5785:     ;
                            	  5786:     ; If deferred bounce direction <> 0, then
                            	  5787:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  5788:     ;
02:0003A7E2 41EC03BC        	  5789:     lea     ($03BC,A4),A0
02:0003A7E6 10302000        	  5790:     move.b  (A0,D2.W),D0
02:0003A7EA 6712            	  5791:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003A7EC 41EC0098        	  5792:     lea     ($0098,A4),A0
02:0003A7F0 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:0003A7F4 7000            	  5794:     moveq   #0,D0
02:0003A7F6 41EC03BC        	  5795:     lea     ($03BC,A4),A0
02:0003A7FA 11802000        	  5796:     move.b  D0,(A0,D2.W)
                            	  5797:     even
                            	  5798: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  5799:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  5800:     ;
02:0003A7FE 7004            	  5801:     moveq   #4,D0
02:0003A800 1880            	  5802:     move.b  D0,($0000,A4)
                            	  5803:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  5804:     ;
02:0003A802 7600            	  5805:     moveq   #0,D3
02:0003A804 0C020005        	  5806:     cmpi.b  #$05,D2
02:0003A808 6702            	  5807:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:0003A80A 7605            	  5808:     moveq   #5,D3
                            	  5809:     even
                            	  5810: _L_z04_Moldorm_PropagateDirs_Loop:
                            	  5811:     ; Copy old direction from a higher slot to the lower one;
                            	  5812:     ; and to the lower one's facing direction.
                            	  5813:     ;
02:0003A80C 41EC0382        	  5814:     lea     ($0382,A4),A0
02:0003A810 10303000        	  5815:     move.b  (A0,D3.W),D0
02:0003A814 41EC0381        	  5816:     lea     ($0381,A4),A0
02:0003A818 11803000        	  5817:     move.b  D0,(A0,D3.W)
02:0003A81C 41EC0099        	  5818:     lea     ($0099,A4),A0
02:0003A820 11803000        	  5819:     move.b  D0,(A0,D3.W)
                            	  5820:     ; Bottom of the loop.
                            	  5821:     ; Increment segment index.
                            	  5822:     ; Decrement loop counter.
                            	  5823:     ;
02:0003A824 5203            	  5824:     addq.b  #1,D3
02:0003A826 5314            	  5825:     subq.b  #1,($0000,A4)
02:0003A828 66E2            	  5826:     bne  _L_z04_Moldorm_PropagateDirs_Loop
                            	  5827:     ; Copy current direction to old direction.
                            	  5828:     ;
02:0003A82A 41EC0098        	  5829:     lea     ($0098,A4),A0
02:0003A82E 10302000        	  5830:     move.b  (A0,D2.W),D0
02:0003A832 41EC0380        	  5831:     lea     ($0380,A4),A0
