                            	  7276: InitObject:
02:0004B4B8 7400            	  7277:     moveq   #0,D2
02:0004B4BA 142C0340        	  7278:     move.b  ($0340,A4),D2
                            	  7279:     ; We want to handle "enemies from the edges of the screen".
                            	  7280:     ;
                            	  7281:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7282:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7283:     ; that does not spawn with a cloud (type >= $53);
                            	  7284:     ; 
                            	  7285:     ; then go initialize the object.
                            	  7286:     ;
02:0004B4BE 102C0010        	  7287:     move.b  ($0010,A4),D0
02:0004B4C2 66000196        	  7288:     bne  _L_z07_InitObject_NormalSpawn
02:0004B4C6 102C04CD        	  7289:     move.b  ($04CD,A4),D0
02:0004B4CA 02000008        	  7290:     andi.b #$08,D0
02:0004B4CE 6700018A        	  7291:     beq  _L_z07_InitObject_NormalSpawn
02:0004B4D2 41EC034F        	  7292:     lea     ($034F,A4),A0
02:0004B4D6 10302000        	  7293:     move.b  (A0,D2.W),D0
02:0004B4DA 0C000011        	  7294:     cmpi.b  #$11,D0
02:0004B4DE 6700017A        	  7295:     beq  _L_z07_InitObject_NormalSpawn
02:0004B4E2 0C000040        	  7296:     cmpi.b  #$40,D0
02:0004B4E6 67000172        	  7297:     beq  _L_z07_InitObject_NormalSpawn
02:0004B4EA 0C00001E        	  7298:     cmpi.b  #$1E,D0
02:0004B4EE 6700016A        	  7299:     beq  _L_z07_InitObject_NormalSpawn
02:0004B4F2 0C00002E        	  7300:     cmpi.b  #$2E,D0
02:0004B4F6 67000162        	  7301:     beq  _L_z07_InitObject_NormalSpawn
02:0004B4FA 0C000053        	  7302:     cmpi.b  #$53,D0
02:0004B4FE 6400015A        	  7303:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7304:     even
                            	  7305: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7306:     ; If the "monsters from edges" long timer expired, then
                            	  7307:     ; go bring the monster in.
                            	  7308:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7309:     ;
                            	  7310:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7311:     ; residual position so enemies keep their previous-room
                            	  7312:     ; positions instead of being re-edge-spawned (matches NES).
02:0004B502 102C004B        	  7313:     move.b  ($004B,A4),D0
02:0004B506 662E            	  7314:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7315:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004B508 102C000F        	  7316:     move.b  ($000F,A4),D0
02:0004B50C 0C0000FF        	  7317:     cmpi.b  #$FF,D0
02:0004B510 662E            	  7318:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004B512 41EC0070        	  7319:     lea     ($0070,A4),A0
02:0004B516 10302000        	  7320:     move.b  (A0,D2.W),D0
02:0004B51A 660A            	  7321:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004B51C 41EC0084        	  7322:     lea     ($0084,A4),A0
02:0004B520 10302000        	  7323:     move.b  (A0,D2.W),D0
02:0004B524 671A            	  7324:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7325:     even
                            	  7326: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:0004B526 7001            	  7327:     moveq   #1,D0
02:0004B528 1940004B        	  7328:     move.b  D0,($004B,A4)
02:0004B52C 41EC0492        	  7329:     lea     ($0492,A4),A0
02:0004B530 11802000        	  7330:     move.b  D0,(A0,D2.W)
02:0004B534 4E75            	  7331:     rts
                            	  7332:     even
                            	  7333: _L_z07_InitObject_UninitMonsterFromEdge_Gate:
02:0004B536 41EC0492        	  7334:     lea     ($0492,A4),A0
