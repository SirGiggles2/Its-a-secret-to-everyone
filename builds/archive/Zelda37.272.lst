02:0003AF6A 6716            	  6795:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003AF6C 10342070        	  6796:     move.b  ($70,A4,D2.W),D0
02:0003AF70 023C00EE        	  6797:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AF74 123C0010        	  6798:     move.b  #$10,D1
02:0003AF78 D101            	  6799:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003AF7A 19802070        	  6800:     move.b  D0,($70,A4,D2.W)
02:0003AF7E 163C00F0        	  6801:     move.b  #$F0,D3
                            	  6802:     even
