                            	  1841: _L_z04_UpdateStatues_Shoot:
                            	  1842:     ; Look for an empty monster slot.
                            	  1843:     ; If none is found, return.
                            	  1844:     ;
                            	  1845:     ; Later, for each fireball, we'll call a routine to make the fireball
                            	  1846:     ; object. This routine takes a shooter object, and instantiates
                            	  1847:     ; a fireball object at the shooter's location.
                            	  1848:     ;
                            	  1849:     ; The object slot we set up here will behave as the shooter.
                            	  1850:     ; For each fireball index, this object slot will have its coordinates
                            	  1851:     ; changed.
                            	  1852:     ;
                            	  1853:     ; Note that this means that:
                            	  1854:     ; 1. The first fireball made will be its own shooter.
                            	  1855:     ;    Practically, there's nothing special about this.
                            	  1856:     ; 2. If there is more than one fireball made in a frame,
                            	  1857:     ;    then two of them will come from the same statue.
                            	  1858:     ;
                            	  1859:     ;
                            	  1860:     ; Save the fireball pattern.
02:00038C00 1003            	  1861:     move.b  D3,D0
02:00038C02 1B00            	  1862:     move.b  D0,-(A5)  ; PHA
02:00038C04 4EB90004B8EC    	  1863:     jsr     FindEmptyMonsterSlot
02:00038C0A 0C000001        	  1864:     cmpi.b  #$01,D0
02:00038C0E 101D            	  1865:     move.b  (A5)+,D0  ; PLA
02:00038C10 6400010A        	  1866:     bcc  _L_z04_UpdateStatues_Exit
                            	  1867:     ; If we found a slot, but it < 6, return.
                            	  1868:     ;
02:00038C14 0C030006        	  1869:     cmpi.b  #$06,D3
02:00038C18 65000102        	  1870:     bcs  _L_z04_UpdateStatues_Exit
                            	  1871:     ; Store the object slot in [0A].
                            	  1872:     ; Store fireball pattern in [0B].
                            	  1873:     ;
02:00038C1C 1943000A        	  1874:     move.b  D3,($000A,A4)
02:00038C20 1940000B        	  1875:     move.b  D0,($000B,A4)
                            	  1876:     ; Look for the number of fireballs to make (minus 1) by pattern number.
                            	  1877:     ;
02:00038C24 7600            	  1878:     moveq   #0,D3
02:00038C26 1600            	  1879:     move.b  D0,D3
02:00038C28 7400            	  1880:     moveq   #0,D2
02:00038C2A 41F900038BBC    	  1881:     lea     (StatueFireballCounts).l,A0
02:00038C30 14303000        	  1882:     move.b  (A0,D3.W),D2
                            	  1883:     even
                            	  1884: _L_z04_UpdateStatues_LoopFireball:
                            	  1885:     ; For each fireball to make, indexed by X, (1 or 3 down to 0):
                            	  1886:     ;
                            	  1887:     ; Decrement the fireball timer at this index.
                            	  1888:     ;
02:00038C34 7600            	  1889:     moveq   #0,D3
02:00038C36 41EC04E8        	  1890:     lea     ($04E8,A4),A0
02:00038C3A 16302000        	  1891:     move.b  (A0,D2.W),D3
02:00038C3E 5303            	  1892:     subq.b  #1,D3
02:00038C40 1003            	  1893:     move.b  D3,D0
02:00038C42 41EC04E8        	  1894:     lea     ($04E8,A4),A0
02:00038C46 11802000        	  1895:     move.b  D0,(A0,D2.W)
                            	  1896:     ; If it was not 0, then this fireball index has to keep waiting
                            	  1897:     ; to make a fireball. Go loop again.
                            	  1898:     ;
02:00038C4A 5203            	  1899:     addq.b  #1,D3
02:00038C4C 660000C8        	  1900:     bne  _L_z04_UpdateStatues_NextLoopFireball
                            	  1901:     ; If the random value for this fireball index >= $F0, go loop again.
                            	  1902:     ; This fireball index will wait another $100 frames.
                            	  1903:     ;
02:00038C50 10342018        	  1904:     move.b  ($18,A4,D2.W),D0
02:00038C54 0C0000F0        	  1905:     cmpi.b  #$F0,D0
02:00038C58 640000BC        	  1906:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1907:     ; Else choose one of four start times for the fireball based on
                            	  1908:     ; the random value.
                            	  1909:     ;
02:00038C5C 02000003        	  1910:     andi.b #$03,D0
02:00038C60 7600            	  1911:     moveq   #0,D3
02:00038C62 1600            	  1912:     move.b  D0,D3
02:00038C64 41F900038BC0    	  1913:     lea     (StatueFireballStartTimes).l,A0
02:00038C6A 10303000        	  1914:     move.b  (A0,D3.W),D0
02:00038C6E 41EC04E8        	  1915:     lea     ($04E8,A4),A0
02:00038C72 11802000        	  1916:     move.b  D0,(A0,D2.W)
                            	  1917:     ; The coordinate lists are divided into sets for each pattern.
                            	  1918:     ;
                            	  1919:     ; Look up the index of the base of the set for the pattern in use.
                            	  1920:     ; Add it to the fireball index in X register to get the index of
                            	  1921:     ; the coordinate we want within each coordinate list.
                            	  1922:     ;
                            	  1923:     ;
                            	  1924:     ; Pattern
02:00038C76 7600            	  1925:     moveq   #0,D3
02:00038C78 162C000B        	  1926:     move.b  ($000B,A4),D3
02:00038C7C 1002            	  1927:     move.b  D2,D0
02:00038C7E 023C00EE        	  1928:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038C82 41F900038BC4    	  1929:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00038C88 12303000        	  1930:     move.b  (A0,D3.W),D1
02:00038C8C D101            	  1931:     addx.b  D1,D0   ; ADC StatuePatternToBasePositionIndex,Y
02:00038C8E 7600            	  1932:     moveq   #0,D3
02:00038C90 1600            	  1933:     move.b  D0,D3
02:00038C92 1002            	  1934:     move.b  D2,D0
02:00038C94 1B00            	  1935:     move.b  D0,-(A5)  ; PHA
                            	  1936:     ; Get Link's coordinates into [00] and [01].
                            	  1937:     ;
02:00038C96 7400            	  1938:     moveq   #0,D2
02:00038C98 4EB90004B104    	  1939:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  1940:     ; Switch to the new fireball's object slot.
                            	  1941:     ;
02:00038C9E 7400            	  1942:     moveq   #0,D2
02:00038CA0 142C000A        	  1943:     move.b  ($000A,A4),D2
                            	  1944:     ; Look up and set the X coordinate for the fireball object.
                            	  1945:     ; Also store it in [02].
                            	  1946:     ;
02:00038CA4 41F900038BC8    	  1947:     lea     (StatueXs).l,A0
02:00038CAA 10303000        	  1948:     move.b  (A0,D3.W),D0
02:00038CAE 19400002        	  1949:     move.b  D0,($0002,A4)
02:00038CB2 19802070        	  1950:     move.b  D0,($70,A4,D2.W)
                            	  1951:     ; Look up and set the Y coordinate for the fireball object.
                            	  1952:     ; Also store it in [03].
                            	  1953:     ;
02:00038CB6 41F900038BD0    	  1954:     lea     (StatueYs).l,A0
02:00038CBC 10303000        	  1955:     move.b  (A0,D3.W),D0
02:00038CC0 19400003        	  1956:     move.b  D0,($0003,A4)
02:00038CC4 41EC0084        	  1957:     lea     ($0084,A4),A0
02:00038CC8 11802000        	  1958:     move.b  D0,(A0,D2.W)
                            	  1959:     ; Set mask value 3 in [04].
                            	  1960:     ;
02:00038CCC 7003            	  1961:     moveq   #3,D0
02:00038CCE 19400004        	  1962:     move.b  D0,($0004,A4)
                            	  1963:     ; Loop to compare each of Link's coordinates to the fireball's.
                            	  1964:     ; Each time the distance < $18, the mask in [04] is shifted right.
                            	  1965:     ;
02:00038CD2 7601            	  1966:     moveq   #1,D3
                            	  1967:     even
                            	  1968: _L_z04_UpdateStatues_LoopAxis:
02:00038CD4 10343000        	  1969:     move.b  ($00,A4,D3.W),D0
02:00038CD8 003C0011        	  1970:     ori     #$11,CCR  ; SEC: set C+X
02:00038CDC 12343002        	  1971:     move.b  ($02,A4,D3.W),D1
02:00038CE0 0A3C0010        	  1972:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038CE4 9101            	  1973:     subx.b  D1,D0   ; SBC $0002,Y
02:00038CE6 0A3C0010        	  1974:     eori    #$10,CCR  ; restore X = 6502 C
02:00038CEA 0C000018        	  1975:     cmpi.b  #$18,D0
02:00038CEE 6A10            	  1976:     bpl  _anon_z04_31
02:00038CF0 0C0000E8        	  1977:     cmpi.b  #$E8,D0
02:00038CF4 6B0A            	  1978:     bmi  _anon_z04_31
02:00038CF6 122C0004        	  1979:     move.b  ($0004,A4),D1
02:00038CFA E209            	  1980:     lsr.b  #1,D1   ; LSR $04
02:00038CFC 19410004        	  1981:     move.b  D1,($0004,A4)
                            	  1982: _anon_z04_31:
02:00038D00 5303            	  1983:     subq.b  #1,D3
02:00038D02 6AD0            	  1984:     bpl  _L_z04_UpdateStatues_LoopAxis
                            	  1985:     ; If [04] <> 0, then its value is 1 or 3, meaning that it was shifted
                            	  1986:     ; 0 or 1 time, instead of 2.
                            	  1987:     ;
                            	  1988:     ; This, in turn, means that the distance between Link and the
                            	  1989:     ; fireball was >= $18 in at least one axis.
                            	  1990:     ;
                            	  1991:     ; So, we're OK to finish making the fireball.
                            	  1992:     ;
02:00038D04 102C0004        	  1993:     move.b  ($0004,A4),D0
02:00038D08 6706            	  1994:     beq  _anon_z04_32
02:00038D0A 7055            	  1995:     moveq   #85,D0
02:00038D0C 6100F848        	  1996:     jsr     ShootFireball
                            	  1997: _anon_z04_32:
02:00038D10 101D            	  1998:     move.b  (A5)+,D0  ; PLA
02:00038D12 7400            	  1999:     moveq   #0,D2
02:00038D14 1400            	  2000:     move.b  D0,D2
                            	  2001:     even
                            	  2002: _L_z04_UpdateStatues_NextLoopFireball:
                            	  2003:     ; Bottom of the loop.
                            	  2004:     ; Loop while fireball index >= 0.
                            	  2005:     ;
02:00038D16 5302            	  2006:     subq.b  #1,D2
02:00038D18 6A00FF1A        	  2007:     bpl  _L_z04_UpdateStatues_LoopFireball
                            	  2008:     even
                            	  2009: _L_z04_UpdateStatues_Exit:
02:00038D1C 4E75            	  2010:     rts
                            	  2011: 
                            	  2012: ; Unknown block
02:00038D1E FF              	  2013:     dc.b    $FF, $FF, $FF
02:00038D1F FF
02:00038D20 FF
                            	  2014: 
                            	  2015:     even
                            	  2016: CheckZora:
                            	  2017:     ; If the zora attribute of this room is off, return.
                            	  2018:     ;
02:00038D22 7600            	  2019:     moveq   #0,D3
02:00038D24 162C00EB        	  2020:     move.b  ($00EB,A4),D3
02:00038D28 41F900FF687E    	  2021:     lea     (NES_SRAM+$087E).l,A0
02:00038D2E 10303000        	  2022:     move.b  (A0,D3.W),D0
02:00038D32 02000008        	  2023:     andi.b #$08,D0
02:00038D36 677C            	  2024:     beq  _L_z04_CheckZora_Exit
                            	  2025:     ; If zora is active, return.
                            	  2026:     ;
02:00038D38 102C0514        	  2027:     move.b  ($0514,A4),D0
02:00038D3C 6676            	  2028:     bne  _L_z04_CheckZora_Exit
                            	  2029:     ; Look for an empty monster slot. If none is found, return.
                            	  2030:     ;
02:00038D3E 4EB90004B8EC    	  2031:     jsr     FindEmptyMonsterSlot
02:00038D44 676E            	  2032:     beq  _L_z04_CheckZora_Exit
                            	  2033:     ; Loop $D times looking for a water tile to put a zora on.
                            	  2034:     ; Indexed by [0D].
                            	  2035:     ;
02:00038D46 700D            	  2036:     moveq   #13,D0
02:00038D48 1940000D        	  2037:     move.b  D0,($000D,A4)
                            	  2038:     ; Switch to the new object slot.
                            	  2039:     ;
02:00038D4C 7400            	  2040:     moveq   #0,D2
02:00038D4E 142C0059        	  2041:     move.b  ($0059,A4),D2
                            	  2042:     even
                            	  2043: _L_z04_CheckZora_LoopTileCandidate:
                            	  2044:     ; Turn the random value at this index into a $10 pixel aligned X coordinate.
                            	  2045:     ; If it = 0 or $F0, go loop again.
                            	  2046:     ;
02:00038D52 7600            	  2047:     moveq   #0,D3
02:00038D54 162C000D        	  2048:     move.b  ($000D,A4),D3
02:00038D58 10343018        	  2049:     move.b  ($18,A4,D3.W),D0
02:00038D5C 020000F0        	  2050:     andi.b #$F0,D0
02:00038D60 19802070        	  2051:     move.b  D0,($70,A4,D2.W)
02:00038D64 6748            	  2052:     beq  _L_z04_CheckZora_NextLoopTileCandidate
02:00038D66 0C0000F0        	  2053:     cmpi.b  #$F0,D0
02:00038D6A 6742            	  2054:     beq  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2055:     ; Turn the random value into a $10 pixel aligned Y coordinate.
                            	  2056:     ; If it < $50 or >= $E0, go loop again.
                            	  2057:     ;
02:00038D6C 10343018        	  2058:     move.b  ($18,A4,D3.W),D0
02:00038D70 E308            	  2059:     lsl.b  #1,D0   ; ASL A
02:00038D72 E308            	  2060:     lsl.b  #1,D0   ; ASL A
02:00038D74 E308            	  2061:     lsl.b  #1,D0   ; ASL A
02:00038D76 E308            	  2062:     lsl.b  #1,D0   ; ASL A
02:00038D78 0C000050        	  2063:     cmpi.b  #$50,D0
02:00038D7C 6530            	  2064:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038D7E 0C0000E0        	  2065:     cmpi.b  #$E0,D0
02:00038D82 642A            	  2066:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2067:     ; Turn it into a normal object Y coordinate by OR'ing it with $D.
                            	  2068:     ;
02:00038D84 0000000D        	  2069:     ori.b #$0D,D0
02:00038D88 41EC0084        	  2070:     lea     ($0084,A4),A0
02:00038D8C 11802000        	  2071:     move.b  D0,(A0,D2.W)
                            	  2072:     ; Get the tile at that location.
                            	  2073:     ; If it's not a water tile, then go loop again.
                            	  2074:     ;
02:00038D90 4EB900049A34    	  2075:     jsr     GetCollidableTileStill
02:00038D96 0C00008D        	  2076:     cmpi.b  #$8D,D0
02:00038D9A 6512            	  2077:     bcs  _L_z04_CheckZora_NextLoopTileCandidate
02:00038D9C 0C000099        	  2078:     cmpi.b  #$99,D0
02:00038DA0 640C            	  2079:     bcc  _L_z04_CheckZora_NextLoopTileCandidate
                            	  2080:     ; Flag the zora active, and set up the object.
                            	  2081:     ;
02:00038DA2 522C0514        	  2082:     addq.b  #1,($0514,A4)
02:00038DA6 7011            	  2083:     moveq   #17,D0
02:00038DA8 4EF90004B8E6    	  2084:     jmp     SetTypeAndClearObject
                            	  2085: 
                            	  2086:     even
                            	  2087: _L_z04_CheckZora_NextLoopTileCandidate:
                            	  2088:     ; Bottom of the loop. Keep going until loop index [0D] = 0.
                            	  2089:     ;
02:00038DAE 532C000D        	  2090:     subq.b  #1,($000D,A4)
02:00038DB2 669E            	  2091:     bne  _L_z04_CheckZora_LoopTileCandidate
                            	  2092:     even
                            	  2093: _L_z04_CheckZora_Exit:
02:00038DB4 4E75            	  2094:     rts
                            	  2095: 
                            	  2096:     even
