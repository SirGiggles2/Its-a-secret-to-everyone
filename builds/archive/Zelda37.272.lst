02:0003B32E 123C0005        	  7371:     move.b  #$05,D1
02:0003B332 D101            	  7372:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003B334 7600            	  7373:     moveq   #0,D3
02:0003B336 1600            	  7374:     move.b  D0,D3
