                            	  1956: ; Otherwise, X will have the empty slot found.
                            	  1957: ;
                            	  1958: ; Note that it's possible that we fail to find an empty slot,
                            	  1959: ; but the caller might find slot X occupied by a fire made earlier.
                            	  1960: ;
