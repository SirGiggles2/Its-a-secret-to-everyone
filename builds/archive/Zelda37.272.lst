02:0003978C 7006            	  3491:     moveq   #6,D0
02:0003978E 41EC03D0        	  3492:     lea     ($03D0,A4),A0
02:00039792 11802000        	  3493:     move.b  D0,(A0,D2.W)
                            	  3494:     ; There are actually 6 frame images divided into 2 sets.
                            	  3495:     ; Each set depicts one animation frame. In each set there are
                            	  3496:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3497:     ;
                            	  3498:     ; The movement frame will keep track of the base offset of
                            	  3499:     ; the current set for the current animation frame: 0 or 3.
                            	  3500:     ;
                            	  3501:     ; So, XOR the movement frame with 3.
                            	  3502:     ;
