                            	  9494:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9495:     ;
02:0003C336 41EC0098        	  9496:     lea     ($0098,A4),A0
02:0003C33A 10302000        	  9497:     move.b  (A0,D2.W),D0
02:0003C33E 122C0002        	  9498:     move.b  ($0002,A4),D1
02:0003C342 E309            	  9499:     lsl.b  #1,D1   ; ASL $02
02:0003C344 19410002        	  9500:     move.b  D1,($0002,A4)
02:0003C348 122C0002        	  9501:     move.b  ($0002,A4),D1
02:0003C34C C200            	  9502:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C34E 671E            	  9503:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003C350 41EC0084        	  9504:     lea     ($0084,A4),A0
02:0003C354 10302000        	  9505:     move.b  (A0,D2.W),D0
02:0003C358 122C0003        	  9506:     move.b  ($0003,A4),D1
02:0003C35C 0A3C0010        	  9507:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C360 9101            	  9508:     subx.b  D1,D0   ; SBC $03
02:0003C362 0A3C0010        	  9509:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C366 41EC0084        	  9510:     lea     ($0084,A4),A0
02:0003C36A 11802000        	  9511:     move.b  D0,(A0,D2.W)
                            	  9512:     even
                            	  9513: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9514:     ; To the frame accumulator, add:
                            	  9515:     ; - a random value between 0 and 3
                            	  9516:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9517:     ;
02:0003C36E 10342019        	  9518:     move.b  ($19,A4,D2.W),D0
02:0003C372 02000003        	  9519:     andi.b #$03,D0
02:0003C376 023C00EE        	  9520:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C37A 122C0003        	  9521:     move.b  ($0003,A4),D1
02:0003C37E D101            	  9522:     addx.b  D1,D0   ; ADC $03
02:0003C380 41EC0451        	  9523:     lea     ($0451,A4),A0
02:0003C384 12302000        	  9524:     move.b  (A0,D2.W),D1
02:0003C388 D101            	  9525:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003C38A 41EC0451        	  9526:     lea     ($0451,A4),A0
