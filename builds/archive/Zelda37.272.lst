02:0003884A 6714            	  1305:     beq  _L_z04_UpdateBubble_Exit
                            	  1306:     ; If not type $2B (flashing), then go block or unblock the sword
                            	  1307:     ; depending on the bubble type.
                            	  1308:     ;
02:0003884C 41EC034F        	  1309:     lea     ($034F,A4),A0
