                            	  9401: Manhandla_Move:
                            	  9402:     ; Implement a way of manifesting the fractional part of the speed
                            	  9403:     ; in the movement.
                            	  9404:     ;
                            	  9405:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  9406:     ; byte to add to the coordinates, then the effective speed would
                            	  9407:     ; be 1 pixel a frame instead of 1.25.
                            	  9408:     ;
                            	  9409:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  9410:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  9411:     ;
                            	  9412:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9413:     ;
                            	  9414:     ;   SA := SA + (SL AND $E0)
                            	  9415:     ;   [03] := SH + carry
                            	  9416:     ;
                            	  9417:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9418:     ;
02:0003C278 41EC041F        	  9419:     lea     ($041F,A4),A0
02:0003C27C 10302000        	  9420:     move.b  (A0,D2.W),D0
02:0003C280 020000E0        	  9421:     andi.b #$E0,D0
02:0003C284 023C00EE        	  9422:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C288 41EC0412        	  9423:     lea     ($0412,A4),A0
02:0003C28C 12302000        	  9424:     move.b  (A0,D2.W),D1
02:0003C290 D101            	  9425:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003C292 41EC0412        	  9426:     lea     ($0412,A4),A0
02:0003C296 11802000        	  9427:     move.b  D0,(A0,D2.W)
                            	  9428:     ; Assign (high speed byte + carry) to [03].
                            	  9429:     ;
02:0003C29A 41EC042C        	  9430:     lea     ($042C,A4),A0
02:0003C29E 10302000        	  9431:     move.b  (A0,D2.W),D0
02:0003C2A2 123C0000        	  9432:     move.b  #$00,D1
02:0003C2A6 D101            	  9433:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C2A8 19400003        	  9434:     move.b  D0,($0003,A4)
                            	  9435:     ; Change coordinates by the speed amount/offset in [03]
                            	  9436:     ; according to the direction.
                            	  9437:     ;
                            	  9438:     ; Start with a mask of $A1 in [02]:
                            	  9439:     ; - low nibble represents the right direction
                            	  9440:     ; - high nibble is used to set or clear carry as we go along
                            	  9441:     ;
02:0003C2AC 103C00A1        	  9442:     move.b  #$A1,D0
02:0003C2B0 19400002        	  9443:     move.b  D0,($0002,A4)
                            	  9444:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9445:     ;
02:0003C2B4 41EC0098        	  9446:     lea     ($0098,A4),A0
02:0003C2B8 10302000        	  9447:     move.b  (A0,D2.W),D0
02:0003C2BC 122C0002        	  9448:     move.b  ($0002,A4),D1
02:0003C2C0 C200            	  9449:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C2C2 6712            	  9450:     beq  _L_z04_Manhandla_Move_Left
02:0003C2C4 10342070        	  9451:     move.b  ($70,A4,D2.W),D0
02:0003C2C8 023C00EE        	  9452:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2CC 122C0003        	  9453:     move.b  ($0003,A4),D1
02:0003C2D0 D101            	  9454:     addx.b  D1,D0   ; ADC $03
02:0003C2D2 19802070        	  9455:     move.b  D0,($70,A4,D2.W)
                            	  9456:     even
                            	  9457: _L_z04_Manhandla_Move_Left:
                            	  9458:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9459:     ;
02:0003C2D6 41EC0098        	  9460:     lea     ($0098,A4),A0
02:0003C2DA 10302000        	  9461:     move.b  (A0,D2.W),D0
02:0003C2DE 122C0002        	  9462:     move.b  ($0002,A4),D1
02:0003C2E2 E309            	  9463:     lsl.b  #1,D1   ; ASL $02
02:0003C2E4 19410002        	  9464:     move.b  D1,($0002,A4)
02:0003C2E8 122C0002        	  9465:     move.b  ($0002,A4),D1
02:0003C2EC C200            	  9466:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C2EE 6716            	  9467:     beq  _L_z04_Manhandla_Move_Down
02:0003C2F0 10342070        	  9468:     move.b  ($70,A4,D2.W),D0
02:0003C2F4 122C0003        	  9469:     move.b  ($0003,A4),D1
02:0003C2F8 0A3C0010        	  9470:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C2FC 9101            	  9471:     subx.b  D1,D0   ; SBC $03
02:0003C2FE 0A3C0010        	  9472:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C302 19802070        	  9473:     move.b  D0,($70,A4,D2.W)
                            	  9474:     even
                            	  9475: _L_z04_Manhandla_Move_Down:
                            	  9476:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9477:     ;
02:0003C306 41EC0098        	  9478:     lea     ($0098,A4),A0
02:0003C30A 10302000        	  9479:     move.b  (A0,D2.W),D0
02:0003C30E 122C0002        	  9480:     move.b  ($0002,A4),D1
02:0003C312 E309            	  9481:     lsl.b  #1,D1   ; ASL $02
02:0003C314 19410002        	  9482:     move.b  D1,($0002,A4)
02:0003C318 122C0002        	  9483:     move.b  ($0002,A4),D1
02:0003C31C C200            	  9484:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C31E 6716            	  9485:     beq  _L_z04_Manhandla_Move_Up
02:0003C320 41EC0084        	  9486:     lea     ($0084,A4),A0
02:0003C324 10302000        	  9487:     move.b  (A0,D2.W),D0
02:0003C328 122C0003        	  9488:     move.b  ($0003,A4),D1
02:0003C32C D101            	  9489:     addx.b  D1,D0   ; ADC $03
02:0003C32E 41EC0084        	  9490:     lea     ($0084,A4),A0
