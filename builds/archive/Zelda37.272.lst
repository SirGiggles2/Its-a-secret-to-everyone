                            	  5580: _anon_z04_79:
                            	  5581:     ; Draw with sprite attributes: normal, red palette row
                            	  5582:     ;
02:0003A6B6 7002            	  5583:     moveq   #2,D0
02:0003A6B8 19400003        	  5584:     move.b  D0,($0003,A4)
02:0003A6BC 7044            	  5585:     moveq   #68,D0
02:0003A6BE 4EB900030B74    	  5586:     jsr     Anim_WriteSprite
                            	  5587:     ; Check collisions, but never let them interfere with movement.
                            	  5588:     ;
02:0003A6C4 41EC0098        	  5589:     lea     ($0098,A4),A0
02:0003A6C8 10302000        	  5590:     move.b  (A0,D2.W),D0
02:0003A6CC 1B00            	  5591:     move.b  D0,-(A5)  ; PHA
02:0003A6CE 10342028        	  5592:     move.b  ($28,A4,D2.W),D0
02:0003A6D2 1B00            	  5593:     move.b  D0,-(A5)  ; PHA
02:0003A6D4 4EB900030BE4    	  5594:     jsr     CheckMonsterCollisions
02:0003A6DA 101D            	  5595:     move.b  (A5)+,D0  ; PLA
02:0003A6DC 19802028        	  5596:     move.b  D0,($28,A4,D2.W)
02:0003A6E0 101D            	  5597:     move.b  (A5)+,D0  ; PLA
02:0003A6E2 41EC0098        	  5598:     lea     ($0098,A4),A0
02:0003A6E6 11802000        	  5599:     move.b  D0,(A0,D2.W)
                            	  5600:     ; If this segment is still alive, then return.
                            	  5601:     ;
02:0003A6EA 41EC0405        	  5602:     lea     ($0405,A4),A0
02:0003A6EE 10302000        	  5603:     move.b  (A0,D2.W),D0
02:0003A6F2 6774            	  5604:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5605:     ; This segment is dead. We'll swap the tail segment with this
                            	  5606:     ; dead segment. This way, moldorm heads are always rooted
                            	  5607:     ; in slots 5 and $A; and the segments are continguous.
                            	  5608:     ;
                            	  5609:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5610:     ;
                            	  5611:     ; Note that this is not a true swap, because the tail's HP
                            	  5612:     ; might be less than $20.
                            	  5613:     ;
02:0003A6F4 7020            	  5614:     moveq   #32,D0
02:0003A6F6 41EC0485        	  5615:     lea     ($0485,A4),A0
02:0003A6FA 11802000        	  5616:     move.b  D0,(A0,D2.W)
02:0003A6FE 61000608        	  5617:     jsr     CheckBossHitReaction
                            	  5618:     ; Look for the tail segment, starting from the low end
                            	  5619:     ; of the chain that this dead segment belongs to.
                            	  5620:     ;
02:0003A702 163C00FF        	  5621:     move.b  #$FF,D3
02:0003A706 0C020006        	  5622:     cmpi.b  #$06,D2
02:0003A70A 6502            	  5623:     bcs  _anon_z04_80
02:0003A70C 7604            	  5624:     moveq   #4,D3
                            	  5625: _anon_z04_80:
02:0003A70E 5203            	  5626:     addq.b  #1,D3
02:0003A710 41EC0350        	  5627:     lea     ($0350,A4),A0
02:0003A714 10303000        	  5628:     move.b  (A0,D3.W),D0
02:0003A718 0C000041        	  5629:     cmpi.b  #$41,D0
02:0003A71C 66F0            	  5630:     bne  _anon_z04_80
                            	  5631:     ; I don't know why the object timer of the tail segment that will
                            	  5632:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5633:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5634:     ; there, the object timer is set to 6.
                            	  5635:     ;
02:0003A71E 7011            	  5636:     moveq   #17,D0
02:0003A720 19803029        	  5637:     move.b  D0,($29,A4,D3.W)
                            	  5638:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5639:     ; segment to the tail segment.
                            	  5640:     ;
02:0003A724 41EC04F0        	  5641:     lea     ($04F0,A4),A0
02:0003A728 10302000        	  5642:     move.b  (A0,D2.W),D0
02:0003A72C 41EC04F1        	  5643:     lea     ($04F1,A4),A0
02:0003A730 11803000        	  5644:     move.b  D0,(A0,D3.W)
02:0003A734 10342070        	  5645:     move.b  ($70,A4,D2.W),D0
02:0003A738 19803071        	  5646:     move.b  D0,($71,A4,D3.W)
02:0003A73C 41EC0084        	  5647:     lea     ($0084,A4),A0
02:0003A740 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003A744 41EC0085        	  5649:     lea     ($0085,A4),A0
02:0003A748 11803000        	  5650:     move.b  D0,(A0,D3.W)
                            	  5651:     ; If the tail segment found is also a head, then
                            	  5652:     ; the last segment has died. Return.
                            	  5653:     ;
02:0003A74C 0C030004        	  5654:     cmpi.b  #$04,D3
02:0003A750 6716            	  5655:     beq  _L_z04_UpdateMoldorm_Exit
02:0003A752 0C030009        	  5656:     cmpi.b  #$09,D3
02:0003A756 6710            	  5657:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5658:     ; Else finish swapping the segments.
                            	  5659:     ; Set the tail segment's type to the dead dummy object.
                            	  5660:     ;
02:0003A758 705D            	  5661:     moveq   #93,D0
02:0003A75A 41EC0350        	  5662:     lea     ($0350,A4),A0
02:0003A75E 11803000        	  5663:     move.b  D0,(A0,D3.W)
                            	  5664:     ; Reset the metastate of the current segment, so that it comes
                            	  5665:     ; back to life.
                            	  5666:     ;
02:0003A762 4EB90004B904    	  5667:     jsr     ResetObjMetastate
                            	  5668:     even
