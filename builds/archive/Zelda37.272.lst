                            	  2900:     ; Add the acceleration to the speed fraction (low byte).
                            	  2901:     ;
02:00039310 41EC041F        	  2902:     lea     ($041F,A4),A0
02:00039314 10302000        	  2903:     move.b  (A0,D2.W),D0
02:00039318 023C00EE        	  2904:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003931C 1214            	  2905:     move.b  ($0000,A4),D1
02:0003931E D101            	  2906:     addx.b  D1,D0   ; ADC $00
02:00039320 41EC041F        	  2907:     lea     ($041F,A4),A0
02:00039324 11802000        	  2908:     move.b  D0,(A0,D2.W)
                            	  2909:     ; Carry over to the high speed byte.
                            	  2910:     ;
02:00039328 41EC0412        	  2911:     lea     ($0412,A4),A0
02:0003932C 10302000        	  2912:     move.b  (A0,D2.W),D0
02:00039330 123C0000        	  2913:     move.b  #$00,D1
02:00039334 D101            	  2914:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00039336 41EC0412        	  2915:     lea     ($0412,A4),A0
02:0003933A 11802000        	  2916:     move.b  D0,(A0,D2.W)
                            	  2917:     ; *Signed comparison*:
                            	  2918:     ; If the high speed byte < high max speed byte, then return.
                            	  2919:     ;
                            	  2920:     ; Note that this is not a general purpose signed comparison,
                            	  2921:     ; which would be more complicated. But it works because
                            	  2922:     ; the deviation from 0 of both values is small.
                            	  2923:     ;
02:0003933E 122C0002        	  2924:     move.b  ($0002,A4),D1
02:00039342 B001            	  2925:     cmp.b   D1,D0
