                            	  5347: _L_z02_DrawCredits_IncVramLine:
02:000352D4 522C050D        	  5348:     addq.b  #1,($050D,A4)
                            	  5349:     ; In each VRAM page there are 8 lines, except in ones where
                            	  5350:     ; (page MOD 4) = 3. This means $23xx and $2Bxx.
                            	  5351:     ; These pages have 6 lines.
                            	  5352:     ;
02:000352D8 102C050C        	  5353:     move.b  ($050C,A4),D0
02:000352DC 02000003        	  5354:     andi.b #$03,D0
02:000352E0 0C000003        	  5355:     cmpi.b  #$03,D0
02:000352E4 7008            	  5356:     moveq   #8,D0
02:000352E6 6502            	  5357:     bcs  _anon_z02_49
02:000352E8 7006            	  5358:     moveq   #6,D0
                            	  5359: _anon_z02_49:
                            	  5360:     ; If the VRAM line number has not just been incremented to
                            	  5361:     ; the reference line number count, then go write NT attributes.
                            	  5362:     ;
02:000352EA 122C050D        	  5363:     move.b  ($050D,A4),D1
02:000352EE B001            	  5364:     cmp.b   D1,D0
02:000352F0 661C            	  5365:     bne  _L_z02_DrawCredits_WriteAttributes
                            	  5366:     ; Else roll over the VRAM line to 0.
                            	  5367:     ;
02:000352F2 7000            	  5368:     moveq   #0,D0
02:000352F4 1940050D        	  5369:     move.b  D0,($050D,A4)
                            	  5370:     ; Increment the VRAM page number.
                            	  5371:     ;
02:000352F8 7600            	  5372:     moveq   #0,D3
02:000352FA 162C050C        	  5373:     move.b  ($050C,A4),D3
02:000352FE 5203            	  5374:     addq.b  #1,D3
                            	  5375:     ; If it has reached $C, then roll it over to 0.
                            	  5376:     ;
02:00035300 0C03000C        	  5377:     cmpi.b  #$0C,D3
02:00035304 6504            	  5378:     bcs  _anon_z02_50
02:00035306 7600            	  5379:     moveq   #0,D3
02:00035308 1600            	  5380:     move.b  D0,D3
