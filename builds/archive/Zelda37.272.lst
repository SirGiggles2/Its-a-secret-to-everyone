02:0003D9A0 700C            	 12538:     moveq   #12,D0
02:0003D9A2 7600            	 12539:     moveq   #0,D3
02:0003D9A4 41EC0478        	 12540:     lea     ($0478,A4),A0
02:0003D9A8 16302000        	 12541:     move.b  (A0,D2.W),D3
