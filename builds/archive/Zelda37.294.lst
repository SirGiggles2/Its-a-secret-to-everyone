                            	  4812:     ; Characters stop emitting when the long timer is $10.
                            	  4813:     ; So, keep showing Link and Zelda until it reaches 4.
                            	  4814:     ; Then hide them and wait until it reaches 0.
                            	  4815:     ;
02:00034CDA 102C004D        	  4816:     move.b  ($004D,A4),D0
