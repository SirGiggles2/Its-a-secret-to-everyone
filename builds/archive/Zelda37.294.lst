02:000498B2 662A            	  3753:     bne  _L_z07_WieldFlute_SummonWhirlwind
02:000498B4 6704            	  3754:     beq  _L_z07_WieldFlute_RevealSecret
                            	  3755:     even
                            	  3756: _L_z07_WieldFlute_Normal:
                            	  3757:     ; For other rooms in the list:
