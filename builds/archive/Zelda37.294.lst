02:000395A0 7006            	  3234:     moveq   #6,D0
02:000395A2 41EC03D0        	  3235:     lea     ($03D0,A4),A0
02:000395A6 11802000        	  3236:     move.b  D0,(A0,D2.W)
                            	  3237:     ; There are actually 6 frame images divided into 2 sets.
                            	  3238:     ; Each set depicts one animation frame. In each set there are
                            	  3239:     ; 3 frame images: 1 for each direction (left, up, down).
                            	  3240:     ;
                            	  3241:     ; The movement frame will keep track of the base offset of
                            	  3242:     ; the current set for the current animation frame: 0 or 3.
                            	  3243:     ;
                            	  3244:     ; So, XOR the movement frame with 3.
                            	  3245:     ;
02:000395AA E208            	  3246:     lsr.b  #1,D0   ; LSR A
02:000395AC 41EC03E4        	  3247:     lea     ($03E4,A4),A0
02:000395B0 12302000        	  3248:     move.b  (A0,D2.W),D1
02:000395B4 B300            	  3249:     eor.b  D1,D0
02:000395B6 41EC03E4        	  3250:     lea     ($03E4,A4),A0
02:000395BA 11802000        	  3251:     move.b  D0,(A0,D2.W)
                            	  3252:     even
