02:0003D45C 19400601        	 11826:     move.b  D0,($0601,A4)
                            	 11827: _anon_z04_160:
02:0003D460 0A3C0001        	 11828:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D464 4E75            	 11829:     rts
                            	 11830: 
                            	 11831: ; Description:
                            	 11832: ; Lift up the Triforce of Courage while the room is light.
                            	 11833: ;
                            	 11834: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 11835: ;
                            	 11836:     even
                            	 11837: Ganon_ScenePhase1:
02:0003D466 701B            	 11838:     moveq   #27,D0
02:0003D468 19400505        	 11839:     move.b  D0,($0505,A4)
                            	 11840:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	 11841:     ;
02:0003D46C 102C0028        	 11842:     move.b  ($0028,A4),D0
02:0003D470 6702            	 11843:     beq.s  __far_z_04_0115
02:0003D472 6012            	 11844:     jmp  Ganon_DrawBodyFrame0
                            	 11845: __far_z_04_0115:
                            	 11846:     ; Once the timer expires:
                            	 11847:     ; 1. unhalt Link
                            	 11848:     ; 2. clear the item to lift
                            	 11849:     ; 3. play level 9 song
                            	 11850:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	 11851:     ;
02:0003D474 194000AC        	 11852:     move.b  D0,($00AC,A4)
02:0003D478 19400505        	 11853:     move.b  D0,($0505,A4)
02:0003D47C 7020            	 11854:     moveq   #32,D0
02:0003D47E 19400600        	 11855:     move.b  D0,($0600,A4)
02:0003D482 522C0445        	 11856:     addq.b  #1,($0445,A4)
                            	 11857:     even
                            	 11858: Ganon_DrawBodyFrame0:
                            	 11859:     ; When holding the Triforce of Courage, only draw Ganon
                            	 11860:     ; with animation frame 0.
                            	 11861:     ;
02:0003D486 7000            	 11862:     moveq   #0,D0
02:0003D488 41EC046B        	 11863:     lea     ($046B,A4),A0
02:0003D48C 11802000        	 11864:     move.b  D0,(A0,D2.W)
02:0003D490 600002EC        	 11865:     jmp     Ganon_DrawBody
                            	 11866: 
                            	 11867: ; Description:
                            	 11868: ; Fighting Ganon.
                            	 11869: ;
                            	 11870: ; If Ganon is dying, go handle it.
                            	 11871: ;
                            	 11872:     even
                            	 11873: Ganon_ScenePhase2:
02:0003D494 41EC042C        	 11874:     lea     ($042C,A4),A0
