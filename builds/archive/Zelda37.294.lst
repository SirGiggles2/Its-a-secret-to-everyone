02:00038AC2 B001            	  1685:     cmp.b   D1,D0
02:00038AC4 670A            	  1686:     beq  _L_z04_UpdateStatues_Shoot
02:00038AC6 5303            	  1687:     subq.b  #1,D3
02:00038AC8 6AEE            	  1688:     bpl  _anon_z04_30
