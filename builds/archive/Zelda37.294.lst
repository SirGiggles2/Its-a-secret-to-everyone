02:0003DE50 E308            	 13274:     lsl.b  #1,D0   ; ASL A
02:0003DE52 E308            	 13275:     lsl.b  #1,D0   ; ASL A
02:0003DE54 1214            	 13276:     move.b  ($0000,A4),D1
02:0003DE56 8001            	 13277:     or.b  D1,D0
02:0003DE58 1880            	 13278:     move.b  D0,($0000,A4)
                            	 13279:     even
