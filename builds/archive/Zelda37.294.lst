02:0003A67E 41EC0084        	  5670:     lea     ($0084,A4),A0
02:0003A682 11802000        	  5671:     move.b  D0,(A0,D2.W)
02:0003A686 101D            	  5672:     move.b  (A5)+,D0  ; PLA
02:0003A688 19802070        	  5673:     move.b  D0,($70,A4,D2.W)
