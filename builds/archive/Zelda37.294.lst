02:00034C44 19400083        	  4756:     move.b  D0,($0083,A4)
02:00034C48 102C0084        	  4757:     move.b  ($0084,A4),D0
02:00034C4C 003C0011        	  4758:     ori     #$11,CCR  ; SEC: set C+X
02:00034C50 123C0010        	  4759:     move.b  #$10,D1
02:00034C54 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034C58 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:00034C5A 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
02:00034C5E 19400097        	  4763:     move.b  D0,($0097,A4)
                            	  4764:     ; Draw Link.
