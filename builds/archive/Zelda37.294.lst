                            	  4545: UpdateZeldaTextbox:
02:00034AD0 4EB900049CD0    	  4546:     jsr     Link_EndMoveAndDraw
                            	  4547:     ; If Zelda's timer has not expired, then return.
                            	  4548:     ;
02:00034AD6 102C0029        	  4549:     move.b  ($0029,A4),D0
02:00034ADA 6704            	  4550:     beq.s  __far_z_02_0009
02:00034ADC 600000C6        	  4551:     jmp  LA9F4_Exit
                            	  4552: __far_z_02_0009:
                            	  4553:     ; Set the timer to wait 6 frames after the next character about
                            	  4554:     ; to be shown.
                            	  4555:     ;
02:00034AE0 7006            	  4556:     moveq   #6,D0
02:00034AE2 19400029        	  4557:     move.b  D0,($0029,A4)
                            	  4558:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4559:     ; to the dynamic transfer buf.
                            	  4560:     ;
02:00034AE6 7604            	  4561:     moveq   #4,D3
                            	  4562: _anon_z02_31:
02:00034AE8 41F900034AC6    	  4563:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00034AEE 10303000        	  4564:     move.b  (A0,D3.W),D0
02:00034AF2 41EC0302        	  4565:     lea     ($0302,A4),A0
02:00034AF6 11803000        	  4566:     move.b  D0,(A0,D3.W)
02:00034AFA 5303            	  4567:     subq.b  #1,D3
02:00034AFC 6AEA            	  4568:     bpl  _anon_z02_31
                            	  4569: _anon_z02_32:
                            	  4570:     ; Replace the low byte of the VRAM address with the one
                            	  4571:     ; where the next character should be written.
                            	  4572:     ;
02:00034AFE 102C045F        	  4573:     move.b  ($045F,A4),D0
02:00034B02 19400303        	  4574:     move.b  D0,($0303,A4)
                            	  4575:     ; Increment the low VRAM address for the next character.
                            	  4576:     ;
02:00034B06 522C045F        	  4577:     addq.b  #1,($045F,A4)
02:00034B0A 7000            	  4578:     moveq   #0,D0
02:00034B0C 1880            	  4579:     move.b  D0,($0000,A4)
02:00034B0E 7000            	  4580:     moveq   #0,D0
02:00034B10 19400001        	  4581:     move.b  D0,($0001,A4)
                            	  4582:     ; Load the person text current character index.
                            	  4583:     ;
02:00034B14 7600            	  4584:     moveq   #0,D3
02:00034B16 162C0416        	  4585:     move.b  ($0416,A4),D3
                            	  4586:     ; Increment the index variable to point to the next character
                            	  4587:     ; for the next time.
                            	  4588:     ;
02:00034B1A 522C0416        	  4589:     addq.b  #1,($0416,A4)
                            	  4590:     ; Get the current character.
                            	  4591:     ;
02:00034B1E 1214            	  4592:     move.b  ($00,A4),D1   ; ptr lo
02:00034B20 182C0001        	  4593:     move.b  ($01,A4),D4  ; ptr hi
02:00034B24 024100FF        	  4594:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034B28 E14C            	  4595:     lsl.w   #8,D4
02:00034B2A 8841            	  4596:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034B2C 48C4            	  4597:     ext.l   D4
02:00034B2E D8BC00FF0000    	  4598:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034B34 2044            	  4599:     movea.l D4,A0
02:00034B36 10303000        	  4600:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4601:     ; If the character is $25, then it's a special space. It will still
                            	  4602:     ; take up space, but will not take time to show -- meaning that
                            	  4603:     ; we'll go look up the next character to transfer.
                            	  4604:     ;
02:00034B3A 0200003F        	  4605:     andi.b #$3F,D0
02:00034B3E 0C000025        	  4606:     cmpi.b  #$25,D0
02:00034B42 67BA            	  4607:     beq  _anon_z02_32
                            	  4608:     ; We have a non-space character. Put it in the transfer record.
                            	  4609:     ;
02:00034B44 19400305        	  4610:     move.b  D0,($0305,A4)
                            	  4611:     ; Play the "heart taken/character" tune.
                            	  4612:     ;
02:00034B48 7010            	  4613:     moveq   #16,D0
02:00034B4A 19400604        	  4614:     move.b  D0,($0604,A4)
                            	  4615:     ; If the high 2 bits of character element = 0, then return.
                            	  4616:     ;
02:00034B4E 1214            	  4617:     move.b  ($00,A4),D1   ; ptr lo
02:00034B50 182C0001        	  4618:     move.b  ($01,A4),D4  ; ptr hi
02:00034B54 024100FF        	  4619:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034B58 E14C            	  4620:     lsl.w   #8,D4
02:00034B5A 8841            	  4621:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034B5C 48C4            	  4622:     ext.l   D4
02:00034B5E D8BC00FF0000    	  4623:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034B64 2044            	  4624:     movea.l D4,A0
02:00034B66 10303000        	  4625:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034B6A 020000C0        	  4626:     andi.b #$C0,D0
02:00034B6E 6602            	  4627:     bne.s  __far_z_02_0010
02:00034B70 6032            	  4628:     jmp  LA9F4_Exit
                            	  4629: __far_z_02_0010:
                            	  4630:     ; Determine an index based on the high 2 bits of the character element:
                            	  4631:     ;   $80: 0
                            	  4632:     ;   $40: 1
                            	  4633:     ;   $C0: 2
                            	  4634:     ;
02:00034B72 7602            	  4635:     moveq   #2,D3
02:00034B74 0C0000C0        	  4636:     cmpi.b  #$C0,D0
02:00034B78 670A            	  4637:     beq  _anon_z02_33
02:00034B7A 5303            	  4638:     subq.b  #1,D3
02:00034B7C 0C000040        	  4639:     cmpi.b  #$40,D0
02:00034B80 6702            	  4640:     beq  _anon_z02_33
02:00034B82 5303            	  4641:     subq.b  #1,D3
                            	  4642: _anon_z02_33:
                            	  4643:     ; The index chooses the low VRAM address of the start
                            	  4644:     ; of another line:
                            	  4645:     ;   0: $C4: front of the second line
                            	  4646:     ;   1: $E4: front of the third line
                            	  4647:     ;   2: $A4: front of the first line
                            	  4648:     ;
02:00034B84 41F900034ACC    	  4649:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:00034B8A 10303000        	  4650:     move.b  (A0,D3.W),D0
02:00034B8E 1940045F        	  4651:     move.b  D0,($045F,A4)
                            	  4652:     ; If index = 2, then we've reached the end of the text,
                            	  4653:     ; and low VRAM address is moved to the front of the first line.
                            	  4654:     ; So, advance the state of the person object, and unhalt Link.
                            	  4655:     ;
02:00034B92 0C030002        	  4656:     cmpi.b  #$02,D3
02:00034B96 6702            	  4657:     beq.s  __far_z_02_0011
02:00034B98 600A            	  4658:     jmp  LA9F4_Exit
                            	  4659: __far_z_02_0011:
