02:0003D49C 6704            	 11876:     beq.s  __far_z_04_0116
02:0003D49E 600000A4        	 11877:     jmp  Ganon_Dying
                            	 11878: __far_z_04_0116:
02:0003D4A2 61000356        	 11879:     jsr     Ganon_CheckCollisions
02:0003D4A6 6100AB6E        	 11880:     jsr     PlayBossHitCryIfNeeded
                            	 11881:     ; Go handle the brown state specially.
                            	 11882:     ;
02:0003D4AA 41EC00AC        	 11883:     lea     ($00AC,A4),A0
02:0003D4AE 10302000        	 11884:     move.b  (A0,D2.W),D0
02:0003D4B2 6702            	 11885:     beq.s  __far_z_04_0117
02:0003D4B4 6058            	 11886:     jmp  Ganon_UpdateBrownState
                            	 11887: __far_z_04_0117:
                            	 11888:     ; State = 0: Blue
                            	 11889:     ;
                            	 11890:     ; If timer = 0, then go move around and shoot.
                            	 11891:     ;
02:0003D4B6 10342028        	 11892:     move.b  ($28,A4,D2.W),D0
02:0003D4BA 6602            	 11893:     bne.s  __far_z_04_0118
02:0003D4BC 600E            	 11894:     jmp  Ganon_MoveAndShoot
                            	 11895: __far_z_04_0118:
                            	 11896:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	 11897:     ; Collisions were checked already.
                            	 11898:     ;
                            	 11899:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	 11900:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	 11901:     ;
02:0003D4BE 0C000001        	 11902:     cmpi.b  #$01,D0
02:0003D4C2 6702            	 11903:     beq.s  __far_z_04_0119
02:0003D4C4 6078            	 11904:     jmp  L_Ganon_DrawBody
                            	 11905: __far_z_04_0119:
                            	 11906: ; Description:
                            	 11907: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	 11908: ;
                            	 11909:     even
                            	 11910: Ganon_RandomizeLocation:
02:0003D4C6 4EF90002BA30    	 11911:     jmp     c_ganon_randomize_location
                            	 11912: 
                            	 11913: Ganon_MoveAndShoot:
                            	 11914:     ; Change the animation frame every screen frame; so that
                            	 11915:     ; when Ganon is hit, he appears in a random pose.
                            	 11916:     ;
02:0003D4CC 41EC046B        	 11917:     lea     ($046B,A4),A0
02:0003D4D0 52302000        	 11918:     addq.b  #1,(A0,D2.W)
                            	 11919:     ; The animation cycle has 6 frames.
                            	 11920:     ;
02:0003D4D4 41EC046B        	 11921:     lea     ($046B,A4),A0
02:0003D4D8 10302000        	 11922:     move.b  (A0,D2.W),D0
02:0003D4DC 0C000006        	 11923:     cmpi.b  #$06,D0
02:0003D4E0 660A            	 11924:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003D4E2 7000            	 11925:     moveq   #0,D0
02:0003D4E4 41EC046B        	 11926:     lea     ($046B,A4),A0
02:0003D4E8 11802000        	 11927:     move.b  D0,(A0,D2.W)
                            	 11928:     even
