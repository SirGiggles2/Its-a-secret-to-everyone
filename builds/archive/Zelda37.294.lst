                            	   700: UpdateBlock0Idle:
                            	   701:     ; If there are monsters in the room, go reset the push timer and return.
                            	   702:     ;
02:000383C6 102C034D        	   703:     move.b  ($034D,A4),D0
02:000383CA 6604            	   704:     bne.s  __far_z_04_0005
02:000383CC 600000D6        	   705:     jmp  ResetPushTimer
                            	   706: __far_z_04_0005:
                            	   707:     ; If Link's X is aligned with the block's, then get the difference
                            	   708:     ; between Link's (Y + 3) and the block's Y.
                            	   709:     ; Then go test the difference.
                            	   710:     ;
02:000383D0 102C0070        	   711:     move.b  ($0070,A4),D0
02:000383D4 12342070        	   712:     move.b  ($70,A4,D2.W),D1
02:000383D8 B001            	   713:     cmp.b   D1,D0
02:000383DA 6628            	   714:     bne  _L_z04_UpdateBlock0Idle_CheckAlignedY
02:000383DC 7600            	   715:     moveq   #0,D3
02:000383DE 102C0084        	   716:     move.b  ($0084,A4),D0
02:000383E2 023C00EE        	   717:     andi    #$EE,CCR  ; CLC: clear C+X
02:000383E6 123C0003        	   718:     move.b  #$03,D1
02:000383EA D101            	   719:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000383EC 003C0011        	   720:     ori     #$11,CCR  ; SEC: set C+X
02:000383F0 41EC0084        	   721:     lea     ($0084,A4),A0
02:000383F4 12302000        	   722:     move.b  (A0,D2.W),D1
02:000383F8 0A3C0010        	   723:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000383FC 9101            	   724:     subx.b  D1,D0   ; SBC ObjY,X
02:000383FE 0A3C0010        	   725:     eori    #$10,CCR  ; restore X = 6502 C
02:00038402 6036            	   726:     jmp     _L_z04_UpdateBlock0Idle_TestDifference
                            	   727: 
                            	   728:     even
                            	   729: _L_z04_UpdateBlock0Idle_CheckAlignedY:
                            	   730:     ; If Link's (Y + 3) is not aligned with the block's Y, then
                            	   731:     ; go reset the push timer.
                            	   732:     ;
02:00038404 102C0084        	   733:     move.b  ($0084,A4),D0
02:00038408 023C00EE        	   734:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003840C 123C0003        	   735:     move.b  #$03,D1
02:00038410 D101            	   736:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00038412 41EC0084        	   737:     lea     ($0084,A4),A0
02:00038416 12302000        	   738:     move.b  (A0,D2.W),D1
02:0003841A B001            	   739:     cmp.b   D1,D0
02:0003841C 6704            	   740:     beq.s  __far_z_04_0006
02:0003841E 60000084        	   741:     jmp  ResetPushTimer
                            	   742: __far_z_04_0006:
                            	   743:     ; Link's (Y + 3) is aligned with the block's Y.
                            	   744:     ; Get the difference in X.
                            	   745:     ;
02:00038422 7602            	   746:     moveq   #2,D3
02:00038424 102C0070        	   747:     move.b  ($0070,A4),D0
02:00038428 003C0011        	   748:     ori     #$11,CCR  ; SEC: set C+X
02:0003842C 12342070        	   749:     move.b  ($70,A4,D2.W),D1
02:00038430 0A3C0010        	   750:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038434 9101            	   751:     subx.b  D1,D0   ; SBC ObjX,X
02:00038436 0A3C0010        	   752:     eori    #$10,CCR  ; restore X = 6502 C
                            	   753:     even
                            	   754: _L_z04_UpdateBlock0Idle_TestDifference:
                            	   755:     ; If the difference in coordinates is negative, then Link is
                            	   756:     ; up or left of the block.
                            	   757:     ;
                            	   758:     ; In that case, increase Y register to index the correct opposite
                            	   759:     ; direction below. Also, negate the difference, so we test
                            	   760:     ; positive values.
                            	   761:     ;
02:0003843A 6A06            	   762:     bpl  _anon_z04_14
02:0003843C 5203            	   763:     addq.b  #1,D3
02:0003843E 61008072        	   764:     jsr     Negate
                            	   765: _anon_z04_14:
                            	   766:     ; If the distance >= $11, then go reset the push timer and return.
                            	   767:     ;
02:00038442 0C000011        	   768:     cmpi.b  #$11,D0
02:00038446 6502            	   769:     bcs.s  __far_z_04_0007
02:00038448 605A            	   770:     jmp  ResetPushTimer
                            	   771: __far_z_04_0007:
                            	   772:     ; At this point, Link is aligned with the block.
                            	   773:     ;
                            	   774:     ; If the input direction is not the required direction based on
                            	   775:     ; Link's placement; then go reset the push timer and return.
                            	   776:     ;
02:0003844A 102C03F8        	   777:     move.b  ($03F8,A4),D0
02:0003844E 41F9000383A4    	   778:     lea     (BlockPushDirections).l,A0
02:00038454 12303000        	   779:     move.b  (A0,D3.W),D1
02:00038458 B001            	   780:     cmp.b   D1,D0
02:0003845A 6702            	   781:     beq.s  __far_z_04_0008
02:0003845C 6046            	   782:     jmp  ResetPushTimer
                            	   783: __far_z_04_0008:
                            	   784:     ; Link is truly pushing the block.
                            	   785:     ;
                            	   786:     ; Increase the push timer.
                            	   787:     ;
