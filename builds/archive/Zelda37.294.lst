02:0003C27C 19400001        	  9429:     move.b  D0,($0001,A4)
02:0003C280 612A            	  9430:     jsr     Gohma_SetSpriteAttributes
                            	  9431:     ; There are only two frame images for legs: left and right.
                            	  9432:     ; There are two animation frames. They are animated as follows:
                            	  9433:     ;
                            	  9434:     ; Frame 0:
                            	  9435:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9436:     ; horizontal flipping = frame number = 0
                            	  9437:     ; 
                            	  9438:     ; Frame 1:
                            	  9439:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9440:     ; horizontal flipping = frame number = 1
                            	  9441:     ;
02:0003C282 4EB90004AD60    	  9442:     jsr     Anim_SetObjHFlipForSpriteDescriptor
