                            	  6692: Dodongo_TryEatBomb:
                            	  6693:     ; Try to eat the bomb.
                            	  6694:     ;
                            	  6695:     ; If the bomb is not in range of the monster, then return.
                            	  6696:     ;
                            	  6697:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  6698:     ;
02:0003AE5C 7601            	  6699:     moveq   #1,D3
02:0003AE5E 616E            	  6700:     jsr     Dodongo_IsBombInRange
02:0003AE60 6666            	  6701:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  6702:     ; Will loop from 1 to 0, indexed by [00].
                            	  6703:     ;
02:0003AE62 7001            	  6704:     moveq   #1,D0
02:0003AE64 1880            	  6705:     move.b  D0,($0000,A4)
                            	  6706:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  6707:     ;
02:0003AE66 41EC0098        	  6708:     lea     ($0098,A4),A0
02:0003AE6A 10302000        	  6709:     move.b  (A0,D2.W),D0
02:0003AE6E E208            	  6710:     lsr.b  #1,D0   ; LSR A
02:0003AE70 7600            	  6711:     moveq   #0,D3
02:0003AE72 1600            	  6712:     move.b  D0,D3
                            	  6713:     ; Now we have to see if it's near the mouth. But the mouth
                            	  6714:     ; position depends on the orientation of the monster.
                            	  6715:     ;
                            	  6716:     ; Start with the horizontal distance.
                            	  6717:     ;
02:0003AE74 102C0004        	  6718:     move.b  ($0004,A4),D0
                            	  6719:     even
                            	  6720: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  6721:     ; Look up the limits for the given direction.
                            	  6722:     ;
                            	  6723:     ; If the distance from the bomb < negative limit,
                            	  6724:     ; or >= positive limit, then return.
                            	  6725:     ;
                            	  6726:     ; Note that these are simple signed comparisons that work,
                            	  6727:     ; because the operands are in a small range.
                            	  6728:     ;
02:0003AE78 41F90003ADB2    	  6729:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003AE7E 12303000        	  6730:     move.b  (A0,D3.W),D1
02:0003AE82 B001            	  6731:     cmp.b   D1,D0
02:0003AE84 6B42            	  6732:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003AE86 41F90003ADB8    	  6733:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003AE8C 12303000        	  6734:     move.b  (A0,D3.W),D1
02:0003AE90 B001            	  6735:     cmp.b   D1,D0
02:0003AE92 6A34            	  6736:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  6737:     ; Add $A to the index to look into the second set for vertical limits.
                            	  6738:     ;
02:0003AE94 1003            	  6739:     move.b  D3,D0
02:0003AE96 023C00EE        	  6740:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AE9A 123C000A        	  6741:     move.b  #$0A,D1
02:0003AE9E D101            	  6742:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003AEA0 7600            	  6743:     moveq   #0,D3
02:0003AEA2 1600            	  6744:     move.b  D0,D3
                            	  6745:     ; Bottom of the loop.
                            	  6746:     ;
                            	  6747:     ; Load the vertical distance for the next iteration.
                            	  6748:     ; Decrement loop counter.
                            	  6749:     ;
02:0003AEA4 102C0005        	  6750:     move.b  ($0005,A4),D0
02:0003AEA8 5314            	  6751:     subq.b  #1,($0000,A4)
02:0003AEAA 6ACC            	  6752:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  6753:     ; If we get here, then the bomb was within range of the mouth.
                            	  6754:     ; Go to state 1 (bloated).
                            	  6755:     ;
02:0003AEAC 41EC00AC        	  6756:     lea     ($00AC,A4),A0
02:0003AEB0 52302000        	  6757:     addq.b  #1,(A0,D2.W)
                            	  6758:     ; Deactivate the bomb, and reset the bloated substate.
                            	  6759:     ;
02:0003AEB4 7610            	  6760:     moveq   #16,D3
02:0003AEB6 7000            	  6761:     moveq   #0,D0
02:0003AEB8 41EC00AC        	  6762:     lea     ($00AC,A4),A0
02:0003AEBC 11803000        	  6763:     move.b  D0,(A0,D3.W)
02:0003AEC0 41EC042C        	  6764:     lea     ($042C,A4),A0
02:0003AEC4 11802000        	  6765:     move.b  D0,(A0,D2.W)
                            	  6766:     even
                            	  6767: _L_z04_Dodongo_TryEatBomb_Exit:
02:0003AEC8 4E75            	  6768:     rts
                            	  6769: 
                            	  6770:     even
                            	  6771: DodongoBombPositiveLimits:
02:0003AECA 0C              	  6772:     dc.b    $0C, $11
02:0003AECB 11
                            	  6773: 
                            	  6774:     even
                            	  6775: DodongoBombNegativeLimits:
02:0003AECC F4              	  6776:     dc.b    $F4, $F0
02:0003AECD F0
                            	  6777: 
                            	  6778: ; Params:
                            	  6779: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  6780: ; [00]: monster hotspot X
                            	  6781: ; [01]: monster hotspot Y
                            	  6782: ; [02]: bomb hotspot X
                            	  6783: ; [03]: bomb hotspot Y
                            	  6784: ;
                            	  6785: ; Returns:
                            	  6786: ; A: 0 if the bomb is in range of the monster
                            	  6787: ; Z: 1 if the bomb is in range of the monster
                            	  6788: ; [04]: horizontal distance
                            	  6789: ; [05]: vertical distance
                            	  6790: ;
                            	  6791: ; Store the positive limit in [06], and the negative one in [07].
                            	  6792: ;
                            	  6793:     even
                            	  6794: Dodongo_IsBombInRange:
02:0003AECE 41F90003AECA    	  6795:     lea     (DodongoBombPositiveLimits).l,A0
02:0003AED4 10303000        	  6796:     move.b  (A0,D3.W),D0
02:0003AED8 19400006        	  6797:     move.b  D0,($0006,A4)
02:0003AEDC 41F90003AECC    	  6798:     lea     (DodongoBombNegativeLimits).l,A0
02:0003AEE2 10303000        	  6799:     move.b  (A0,D3.W),D0
02:0003AEE6 19400007        	  6800:     move.b  D0,($0007,A4)
                            	  6801:     ; Set [08] to 3. It will be shifted right once for each axis that
                            	  6802:     ; the bomb is near enough the monster.
                            	  6803:     ;
02:0003AEEA 7003            	  6804:     moveq   #3,D0
02:0003AEEC 19400008        	  6805:     move.b  D0,($0008,A4)
                            	  6806:     ; For each coordinate (Y/X), from 1 to 0, indexed by Y register:
                            	  6807:     ;
02:0003AEF0 7601            	  6808:     moveq   #1,D3
                            	  6809:     even
                            	  6810: _L_z04_Dodongo_IsBombInRange_LoopAxis:
                            	  6811:     ; Subtract the bomb's coordinate from the boss's,
                            	  6812:     ; The loop index determines the coordinate.
                            	  6813:     ;
02:0003AEF2 10343000        	  6814:     move.b  ($00,A4,D3.W),D0
02:0003AEF6 003C0011        	  6815:     ori     #$11,CCR  ; SEC: set C+X
02:0003AEFA 12343002        	  6816:     move.b  ($02,A4,D3.W),D1
02:0003AEFE 0A3C0010        	  6817:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003AF02 9101            	  6818:     subx.b  D1,D0   ; SBC $0002,Y
02:0003AF04 0A3C0010        	  6819:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6820:     ; If the distance >= positive offset, or < negative offset;
                            	  6821:     ; then loop again.
                            	  6822:     ;
02:0003AF08 122C0006        	  6823:     move.b  ($0006,A4),D1
02:0003AF0C B001            	  6824:     cmp.b   D1,D0
02:0003AF0E 6A16            	  6825:     bpl  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
02:0003AF10 122C0007        	  6826:     move.b  ($0007,A4),D1
02:0003AF14 B001            	  6827:     cmp.b   D1,D0
02:0003AF16 6B0E            	  6828:     bmi  _L_z04_Dodongo_IsBombInRange_NextLoopAxis
                            	  6829:     ; The distance is close enough in this axis.
                            	  6830:     ;
                            	  6831:     ; Store the distance in this axis in [05] or [04],
                            	  6832:     ; depending on the loop index.
                            	  6833:     ;
02:0003AF18 19803004        	  6834:     move.b  D0,($04,A4,D3.W)
                            	  6835:     ; Shift [08] right, because we're in range in this axis.
                            	  6836:     ;
02:0003AF1C 122C0008        	  6837:     move.b  ($0008,A4),D1
02:0003AF20 E209            	  6838:     lsr.b  #1,D1   ; LSR $08
02:0003AF22 19410008        	  6839:     move.b  D1,($0008,A4)
                            	  6840:     even
                            	  6841: _L_z04_Dodongo_IsBombInRange_NextLoopAxis:
02:0003AF26 5303            	  6842:     subq.b  #1,D3
02:0003AF28 6AC8            	  6843:     bpl  _L_z04_Dodongo_IsBombInRange_LoopAxis
                            	  6844:     ; If close enough in both axes, then [08] will be 0.
                            	  6845:     ;
02:0003AF2A 102C0008        	  6846:     move.b  ($0008,A4),D0
02:0003AF2E 4E75            	  6847:     rts
                            	  6848: 
                            	  6849: ; Two sets of frame image numbers: 1 set for each animation frame.
                            	  6850: ; Each set contains 5 frame image numbers, indexed by direction.
                            	  6851: ;
                            	  6852: ; But these are not typical direction indexes. Instead a
                            	  6853: ; 5-way index is used.
                            	  6854: ; A direction shifted right once becomes a 5-way index.
                            	  6855: ; The fourth element is unused.
                            	  6856: ;
                            	  6857:     even
                            	  6858: DodongoFrameImages:
02:0003AF30 00              	  6859:     dc.b    $00, $01, $06, $FF, $08, $02, $03, $06
02:0003AF31 01
02:0003AF32 06
02:0003AF33 FF
02:0003AF34 08
02:0003AF35 02
02:0003AF36 03
02:0003AF37 06
02:0003AF38 FF              	  6860:     dc.b    $FF, $08
02:0003AF39 08
                            	  6861: 
                            	  6862:     even
                            	  6863: DodongoFrameHFlips:
02:0003AF3A 00              	  6864:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $40
02:0003AF3B 40
02:0003AF3C 00
02:0003AF3D FF
02:0003AF3E 00
02:0003AF3F 00
02:0003AF40 40
02:0003AF41 40
02:0003AF42 FF              	  6865:     dc.b    $FF, $40
02:0003AF43 40
                            	  6866: 
                            	  6867:     even
                            	  6868: DodongoFrameImagesBloated:
02:0003AF44 04              	  6869:     dc.b    $04, $05, $07, $FF, $09, $04, $05, $07
02:0003AF45 05
02:0003AF46 07
02:0003AF47 FF
02:0003AF48 09
02:0003AF49 04
02:0003AF4A 05
02:0003AF4B 07
02:0003AF4C FF              	  6870:     dc.b    $FF, $09
02:0003AF4D 09
                            	  6871: 
                            	  6872:     even
                            	  6873: DodongoFrameHFlipsBloated:
02:0003AF4E 00              	  6874:     dc.b    $00, $40, $00, $FF, $00, $00, $40, $00
02:0003AF4F 40
02:0003AF50 00
02:0003AF51 FF
02:0003AF52 00
02:0003AF53 00
02:0003AF54 40
02:0003AF55 00
02:0003AF56 FF              	  6875:     dc.b    $FF, $00
02:0003AF57 00
