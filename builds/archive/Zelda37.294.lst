                            	  4343:     ; before jsr: SP→[val | slot | D2_save | ret]
                            	  4344:     ; after jsr:  SP→[callee_ret | val | slot | D2_save | ret]
                            	  4345:     ;              SP+4=val=arg1, SP+8=slot=arg2 ✓
