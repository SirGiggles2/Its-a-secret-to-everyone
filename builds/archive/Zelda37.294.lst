                            	  8546:     ; it's stored right in the object slot -- unlike coordinates.
                            	  8547:     ;
                            	  8548:     ; Also, note that even though these aren't independent objects
                            	  8549:     ; in the object slots -- because object type = 0 -- the values in
                            	  8550:     ; these object slots will be useful during collision detection.
