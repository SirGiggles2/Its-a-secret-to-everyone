                            	  5247:     ;
02:0003A3F6 705D            	  5248:     moveq   #93,D0
02:0003A3F8 41EC0350        	  5249:     lea     ($0350,A4),A0
02:0003A3FC 11803000        	  5250:     move.b  D0,(A0,D3.W)
                            	  5251:     ; Reset the metastate of the current segment, so that it comes
