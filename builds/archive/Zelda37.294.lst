02:00034CA0 19400072        	  4791:     move.b  D0,($0072,A4)
02:00034CA4 102C0085        	  4792:     move.b  ($0085,A4),D0
02:00034CA8 003C0011        	  4793:     ori     #$11,CCR  ; SEC: set C+X
02:00034CAC 123C0010        	  4794:     move.b  #$10,D1
02:00034CB0 0A3C0010        	  4795:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034CB4 9101            	  4796:     subx.b  D1,D0   ; SBC #$10
02:00034CB6 0A3C0010        	  4797:     eori    #$10,CCR  ; restore X = 6502 C
