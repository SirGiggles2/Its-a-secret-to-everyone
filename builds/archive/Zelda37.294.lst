02:0003D2AE 41F90003D268    	 11596:     lea     (PatraChildStartAngles).l,A0
02:0003D2B4 12303000        	 11597:     move.b  (A0,D3.W),D1
02:0003D2B8 B001            	 11598:     cmp.b   D1,D0
