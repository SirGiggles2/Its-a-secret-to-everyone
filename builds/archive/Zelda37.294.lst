02:0002EF5E 1880            	   740:     move.b  D0,($0000,A4)
02:0002EF60 103C00A5        	   741:     move.b  #$A5,D0
02:0002EF64 19400001        	   742:     move.b  D0,($0001,A4)
02:0002EF68 103C0090        	   743:     move.b  #$90,D0
02:0002EF6C 19400002        	   744:     move.b  D0,($0002,A4)
02:0002EF70 706C            	   745:     moveq   #108,D0
