                            	 11121: Lamnola_UpdateHead:
                            	 11122:     ; If X coordinate is not a multiple of 8, then return.
                            	 11123:     ;
02:0003CF7C 10342070        	 11124:     move.b  ($70,A4,D2.W),D0
02:0003CF80 02000007        	 11125:     andi.b #$07,D0
02:0003CF84 6702            	 11126:     beq.s  __far_z_04_0110
02:0003CF86 60F2            	 11127:     jmp  L12A6F_Exit
                            	 11128: __far_z_04_0110:
                            	 11129:     ; If (Y + 3) is not a multiple of 8, then return.
                            	 11130:     ; We had to account for the usual offset of 3.
                            	 11131:     ;
02:0003CF88 41EC0084        	 11132:     lea     ($0084,A4),A0
02:0003CF8C 10302000        	 11133:     move.b  (A0,D2.W),D0
02:0003CF90 023C00EE        	 11134:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF94 123C0003        	 11135:     move.b  #$03,D1
02:0003CF98 D101            	 11136:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003CF9A 02000007        	 11137:     andi.b #$07,D0
02:0003CF9E 6702            	 11138:     beq.s  __far_z_04_0111
02:0003CFA0 60D8            	 11139:     jmp  L12A6F_Exit
                            	 11140: __far_z_04_0111:
                            	 11141:     ; Will loop 4 times, propagating directions down the chain,
                            	 11142:     ; by pulling from the bottom.
                            	 11143:     ;
02:0003CFA2 7004            	 11144:     moveq   #4,D0
02:0003CFA4 1880            	 11145:     move.b  D0,($0000,A4)
                            	 11146:     ; Choose the tail index of the lamnola that the current segment belongs to.
                            	 11147:     ;
02:0003CFA6 7600            	 11148:     moveq   #0,D3
02:0003CFA8 0C020005        	 11149:     cmpi.b  #$05,D2
02:0003CFAC 6702            	 11150:     beq  _L_z04_Lamnola_UpdateHead_PropagateDirs
02:0003CFAE 7605            	 11151:     moveq   #5,D3
                            	 11152:     even
                            	 11153: _L_z04_Lamnola_UpdateHead_PropagateDirs:
                            	 11154:     ; Loop over every segment under the head, starting from the tail.
                            	 11155:     ; Copy the next segment's direction to the current one in this loop.
                            	 11156:     ;
02:0003CFB0 41EC009A        	 11157:     lea     ($009A,A4),A0
02:0003CFB4 10303000        	 11158:     move.b  (A0,D3.W),D0
02:0003CFB8 41EC0099        	 11159:     lea     ($0099,A4),A0
02:0003CFBC 11803000        	 11160:     move.b  D0,(A0,D3.W)
02:0003CFC0 5203            	 11161:     addq.b  #1,D3
02:0003CFC2 5314            	 11162:     subq.b  #1,($0000,A4)
02:0003CFC4 66EA            	 11163:     bne  _L_z04_Lamnola_UpdateHead_PropagateDirs
                            	 11164:     ; If this head segment is not aligned with a square, then return.
                            	 11165:     ;
02:0003CFC6 10342070        	 11166:     move.b  ($70,A4,D2.W),D0
02:0003CFCA 0200000F        	 11167:     andi.b #$0F,D0
02:0003CFCE 660000BA        	 11168:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11169:     ; If (Y + 3) is not a multiple of $10, then return.
                            	 11170:     ; We had to account for the usual offset of 3.
                            	 11171:     ;
02:0003CFD2 41EC0084        	 11172:     lea     ($0084,A4),A0
02:0003CFD6 10302000        	 11173:     move.b  (A0,D2.W),D0
02:0003CFDA 023C00EE        	 11174:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CFDE 123C0003        	 11175:     move.b  #$03,D1
02:0003CFE2 D101            	 11176:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003CFE4 0200000F        	 11177:     andi.b #$0F,D0
02:0003CFE8 660000A0        	 11178:     bne  _L_z04_Lamnola_UpdateHead_Exit
                            	 11179:     ; Store the opposite of the facing direction in [00].
                            	 11180:     ;
02:0003CFEC 41EC0098        	 11181:     lea     ($0098,A4),A0
02:0003CFF0 10302000        	 11182:     move.b  (A0,D2.W),D0
02:0003CFF4 E208            	 11183:     lsr.b  #1,D0   ; LSR A
02:0003CFF6 02000005        	 11184:     andi.b #$05,D0
02:0003CFFA 1880            	 11185:     move.b  D0,($0000,A4)
02:0003CFFC 41EC0098        	 11186:     lea     ($0098,A4),A0
02:0003D000 10302000        	 11187:     move.b  (A0,D2.W),D0
02:0003D004 E308            	 11188:     lsl.b  #1,D0   ; ASL A
02:0003D006 0200000A        	 11189:     andi.b #$0A,D0
02:0003D00A 1214            	 11190:     move.b  ($0000,A4),D1
02:0003D00C 8001            	 11191:     or.b  D1,D0
                            	 11192:     ; Make a mask of the inverted bits of the opposite direction.
                            	 11193:     ;
02:0003D00E 0A00000F        	 11194:     eori.b #$0F,D0
02:0003D012 1940050F        	 11195:     move.b  D0,($050F,A4)
                            	 11196:     ; There's a 50% chance of going to try to turn toward Link.
                            	 11197:     ;
02:0003D016 10342018        	 11198:     move.b  ($18,A4,D2.W),D0
02:0003D01A 0C000080        	 11199:     cmpi.b  #$80,D0
02:0003D01E 656C            	 11200:     bcs  _L_z04_Lamnola_UpdateHead_TurnTowardLink
                            	 11201:     ; Otherwise, we randomly choose a perpendicular direction.
                            	 11202:     ; Load the monster's facing direction.
                            	 11203:     ;
02:0003D020 41EC0098        	 11204:     lea     ($0098,A4),A0
02:0003D024 10302000        	 11205:     move.b  (A0,D2.W),D0
                            	 11206:     ; Load the next random number into Y register.
                            	 11207:     ;
02:0003D028 7600            	 11208:     moveq   #0,D3
02:0003D02A 16342019        	 11209:     move.b  ($19,A4,D2.W),D3
                            	 11210:     ; Based on it, there's a 50% chance of skipping the loop,
                            	 11211:     ; to keep moving straight.
                            	 11212:     ;
02:0003D02E 0C030080        	 11213:     cmpi.b  #$80,D3
02:0003D032 6418            	 11214:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11215:     even
                            	 11216: _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular:
                            	 11217:     ; Loop to rotate the direction bit over the mask.
                            	 11218:     ; The goal is to calculate a direction perpendicular to the monster's
                            	 11219:     ; facing direction.
                            	 11220:     ;
                            	 11221:     ; Shift right the copy of the direction.
                            	 11222:     ; If the direction bit rolled off the low end, then roll it onto the high end.
                            	 11223:     ;
02:0003D034 E208            	 11224:     lsr.b  #1,D0   ; LSR A
02:0003D036 6402            	 11225:     bcc  _anon_z04_151
02:0003D038 7008            	 11226:     moveq   #8,D0
                            	 11227: _anon_z04_151:
                            	 11228:     ; If the current direction bit is masked off, then we've reached
                            	 11229:     ; the opposite direction. Loop again.
                            	 11230:     ;
02:0003D03A 122C050F        	 11231:     move.b  ($050F,A4),D1
02:0003D03E C200            	 11232:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003D040 67F2            	 11233:     beq  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11234:     ; If Y register >= $40, then break out of the loop.
                            	 11235:     ; So, 75% of the time, if horizontal, then turn up, else left.
                            	 11236:     ;
02:0003D042 0C030040        	 11237:     cmpi.b  #$40,D3
02:0003D046 6404            	 11238:     bcc  _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles
                            	 11239:     ; Set Y register to $40 in order to break out of the loop next time;
                            	 11240:     ; and loop again now.
                            	 11241:     ; So, 25% of the time, if horizontal, then turn down, else right.
                            	 11242:     ;
02:0003D048 7640            	 11243:     moveq   #64,D3
02:0003D04A 65E8            	 11244:     bcs  _L_z04_Lamnola_UpdateHead_LoopFindPerpendicular
                            	 11245:     even
                            	 11246: _L_z04_Lamnola_UpdateHead_SetDirAndCheckTiles:
                            	 11247:     ; Change the facing direction to the direction found.
                            	 11248:     ;
02:0003D04C 41EC0098        	 11249:     lea     ($0098,A4),A0
