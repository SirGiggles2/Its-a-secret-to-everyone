                            	  5096: ReachedTopWallBottom:
                            	  5097:     ; Read a zero tile. Reached the bottom of a top wall.
                            	  5098:     ;
                            	  5099:     ; Set up A and X to move top and bottom offsets to the next column.
                            	  5100:     ;
02:0004145E 7013            	  5101:     moveq   #19,D0
                            	  5102:     ; TODO: I think that any value >= 4 would work here;
                            	  5103:     ; so that we keep processing the wall tile list.
02:00041460 19400006        	  5104:     move.b  D0,($0006,A4)
02:00041464 7419            	  5105:     moveq   #25,D2
02:00041466 6704            	  5106:     beq.s  __far_z_05_0067
02:00041468 600000D8        	  5107:     jmp  MoveWallPtrs
