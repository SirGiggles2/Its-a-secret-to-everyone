                            	  6230: Aquamentus_Draw:
                            	  6231:     ; Every $10 screen frames, switch animation frames.
                            	  6232:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  6233:     ; The last tile of frame 0 is at index 5.
                            	  6234:     ; The last tile of frame 1 is at index $B.
                            	  6235:     ;
02:0003AAF6 7605            	  6236:     moveq   #5,D3
02:0003AAF8 102C0015        	  6237:     move.b  ($0015,A4),D0
02:0003AAFC 02000010        	  6238:     andi.b #$10,D0
02:0003AB00 6602            	  6239:     bne  _anon_z04_88
02:0003AB02 760B            	  6240:     moveq   #11,D3
                            	  6241: _anon_z04_88:
02:0003AB04 1943000A        	  6242:     move.b  D3,($000A,A4)
                            	  6243:     ; For each sprite, from 5 to 0, indexed by [0B]:
                            	  6244:     ;
02:0003AB08 7005            	  6245:     moveq   #5,D0
02:0003AB0A 1940000B        	  6246:     move.b  D0,($000B,A4)
                            	  6247:     even
                            	  6248: _L_z04_Aquamentus_Draw_LoopSprite:
02:0003AB0E 7600            	  6249:     moveq   #0,D3
02:0003AB10 162C000B        	  6250:     move.b  ($000B,A4),D3
                            	  6251:     ; Add the current sprite's offset to the boss's X coordinate.
                            	  6252:     ; Store it in [00].
                            	  6253:     ;
02:0003AB14 10342070        	  6254:     move.b  ($70,A4,D2.W),D0
02:0003AB18 023C00EE        	  6255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB1C 41F90003AAF0    	  6256:     lea     (AquamentusSpriteOffsetsX).l,A0
02:0003AB22 12303000        	  6257:     move.b  (A0,D3.W),D1
02:0003AB26 D101            	  6258:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsX,Y
02:0003AB28 1880            	  6259:     move.b  D0,($0000,A4)
                            	  6260:     ; Add the current sprite's offset to the boss's Y coordinate.
                            	  6261:     ; Store it in [01].
                            	  6262:     ;
02:0003AB2A 41EC0084        	  6263:     lea     ($0084,A4),A0
02:0003AB2E 10302000        	  6264:     move.b  (A0,D2.W),D0
02:0003AB32 023C00EE        	  6265:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AB36 41F90003AAEA    	  6266:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003AB3C 12303000        	  6267:     move.b  (A0,D3.W),D1
02:0003AB40 D101            	  6268:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003AB42 19400001        	  6269:     move.b  D0,($0001,A4)
                            	  6270:     ; Calculate sprite attributes:
                            	  6271:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6272:     ;
                            	  6273:     ; If the boss is temporarily invincible, then
                            	  6274:     ; this makes it flash by cycling all the palette rows.
                            	  6275:     ;
                            	  6276:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6277:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6278:     ;
02:0003AB46 41EC04F0        	  6279:     lea     ($04F0,A4),A0
02:0003AB4A 10302000        	  6280:     move.b  (A0,D2.W),D0
02:0003AB4E 02000003        	  6281:     andi.b #$03,D0
02:0003AB52 0A000003        	  6282:     eori.b #$03,D0
02:0003AB56 19400003        	  6283:     move.b  D0,($0003,A4)
02:0003AB5A 7600            	  6284:     moveq   #0,D3
02:0003AB5C 162C000A        	  6285:     move.b  ($000A,A4),D3
                            	  6286:     ; Look up the tile for this sprite.
                            	  6287:     ; If it's not the first one (face), then go write the sprite record.
                            	  6288:     ;
02:0003AB60 41F90003AADE    	  6289:     lea     (AquamentusTiles).l,A0
02:0003AB66 10303000        	  6290:     move.b  (A0,D3.W),D0
02:0003AB6A 12390003AADE    	  6291:     move.b  (AquamentusTiles).l,D1
02:0003AB70 B001            	  6292:     cmp.b   D1,D0
02:0003AB72 6610            	  6293:     bne  _L_z04_Aquamentus_Draw_WriteSprite
                            	  6294:     ; Else it's the first one (the face tile).
                            	  6295:     ; For timer >= $20, use it as is ($CC). Otherwise, use tile $C0.
                            	  6296:     ;
                            	  6297:     ; $CC/CD shows the closed mouth face.
                            	  6298:     ; $C0/C1 shows the open mouth face.
                            	  6299:     ;
02:0003AB74 7600            	  6300:     moveq   #0,D3
02:0003AB76 16342028        	  6301:     move.b  ($28,A4,D2.W),D3
02:0003AB7A 0C030020        	  6302:     cmpi.b  #$20,D3
02:0003AB7E 6404            	  6303:     bcc  _L_z04_Aquamentus_Draw_WriteSprite
02:0003AB80 103C00C0        	  6304:     move.b  #$C0,D0
                            	  6305:     even
                            	  6306: _L_z04_Aquamentus_Draw_WriteSprite:
02:0003AB84 610E            	  6307:     jsr     WriteBossSprite
                            	  6308:     ; Bottom of the loop.
                            	  6309:     ; Decrement tile index and loop index.
                            	  6310:     ;
02:0003AB86 532C000A        	  6311:     subq.b  #1,($000A,A4)
02:0003AB8A 532C000B        	  6312:     subq.b  #1,($000B,A4)
02:0003AB8E 6A00FF7E        	  6313:     bpl  _L_z04_Aquamentus_Draw_LoopSprite
02:0003AB92 4E75            	  6314:     rts
                            	  6315: 
                            	  6316: ; Params:
                            	  6317: ; A: tile
                            	  6318: ; [00]: X
                            	  6319: ; [01]: Y
                            	  6320: ; [03]: sprite attributes
                            	  6321: ;
                            	  6322: ; Save the tile
                            	  6323:     even
                            	  6324: WriteBossSprite:
02:0003AB94 1B00            	  6325:     move.b  D0,-(A5)  ; PHA
02:0003AB96 7600            	  6326:     moveq   #0,D3
02:0003AB98 162C0341        	  6327:     move.b  ($0341,A4),D3
02:0003AB9C 41F900030842    	  6328:     lea     (SpriteOffsets).l,A0
02:0003ABA2 10303000        	  6329:     move.b  (A0,D3.W),D0
02:0003ABA6 7600            	  6330:     moveq   #0,D3
02:0003ABA8 1600            	  6331:     move.b  D0,D3
02:0003ABAA 101D            	  6332:     move.b  (A5)+,D0  ; PLA
02:0003ABAC 41EC0201        	  6333:     lea     ($0201,A4),A0
02:0003ABB0 11803000        	  6334:     move.b  D0,(A0,D3.W)
02:0003ABB4 1014            	  6335:     move.b  ($0000,A4),D0
02:0003ABB6 41EC0203        	  6336:     lea     ($0203,A4),A0
02:0003ABBA 11803000        	  6337:     move.b  D0,(A0,D3.W)
02:0003ABBE 102C0001        	  6338:     move.b  ($0001,A4),D0
02:0003ABC2 4EF900030BC0    	  6339:     jmp     Anim_EndWriteSprite
