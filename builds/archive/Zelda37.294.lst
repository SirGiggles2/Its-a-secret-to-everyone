                            	  6482: _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate:
                            	  6483:     ; Advance the substate.
                            	  6484:     ;
02:0003ACDE 41EC042C        	  6485:     lea     ($042C,A4),A0
02:0003ACE2 52302000        	  6486:     addq.b  #1,(A0,D2.W)
                            	  6487:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  6488:     ;
02:0003ACE6 41EC042C        	  6489:     lea     ($042C,A4),A0
02:0003ACEA 10302000        	  6490:     move.b  (A0,D2.W),D0
02:0003ACEE 0C000002        	  6491:     cmpi.b  #$02,D0
