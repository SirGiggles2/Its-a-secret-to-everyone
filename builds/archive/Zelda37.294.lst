                            	  5738:     ; Command 2 sets Link's timer to $30.
                            	  5739:     ;
02:000418B0 7630            	  5740:     moveq   #48,D3
02:000418B2 19430028        	  5741:     move.b  D3,($0028,A4)
                            	  5742: _anon_z05_119:
