02:000399DE 003C0011        	  3913:     ori     #$11,CCR  ; SEC: set C+X
02:000399E2 41EC0084        	  3914:     lea     ($0084,A4),A0
02:000399E6 12302000        	  3915:     move.b  (A0,D2.W),D1
02:000399EA 0A3C0010        	  3916:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000399EE 9101            	  3917:     subx.b  D1,D0   ; SBC ObjY,X
02:000399F0 0A3C0010        	  3918:     eori    #$10,CCR  ; restore X = 6502 C
