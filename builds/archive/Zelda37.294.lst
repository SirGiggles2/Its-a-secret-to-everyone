02:000413D6 19400001        	  5036:     move.b  D0,($0001,A4)
02:000413DA 7003            	  5037:     moveq   #3,D0
02:000413DC 19400003        	  5038:     move.b  D0,($0003,A4)
                            	  5039:     even
