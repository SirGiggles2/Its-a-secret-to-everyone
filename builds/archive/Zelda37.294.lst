                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:00041956 102C0054        	  5829:     move.b  ($0054,A4),D0
02:0004195A 02000003        	  5830:     andi.b #$03,D0
02:0004195E 6708            	  5831:     beq  _anon_z05_122
02:00041960 7008            	  5832:     moveq   #8,D0
02:00041962 19400027        	  5833:     move.b  D0,($0027,A4)
02:00041966 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:00041968 102C0054        	  5844:     move.b  ($0054,A4),D0
02:0004196C 0C000004        	  5845:     cmpi.b  #$04,D0
02:00041970 6626            	  5846:     bne  _anon_z05_123
02:00041972 7400            	  5847:     moveq   #0,D2
02:00041974 142C0009        	  5848:     move.b  ($0009,A4),D2
02:00041978 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:0004197C 102C0055        	  5850:     move.b  ($0055,A4),D0
02:00041980 0A00000F        	  5851:     eori.b #$0F,D0
02:00041984 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:00041988 C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:0004198A 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:0004198E 7000            	  5859:     moveq   #0,D0
02:00041990 19400054        	  5860:     move.b  D0,($0054,A4)
02:00041994 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:00041998 102C0055        	  5870:     move.b  ($0055,A4),D0
02:0004199C 19400002        	  5871:     move.b  D0,($0002,A4)
02:000419A0 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:000419A4 0C000007        	  5873:     cmpi.b  #$07,D0
02:000419A8 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:000419AA 7400            	  5879:     moveq   #0,D2
02:000419AC 142C0009        	  5880:     move.b  ($0009,A4),D2
02:000419B0 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:000419B4 1003            	  5884:     move.b  D3,D0
02:000419B6 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:000419BA 41F900041876    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:000419C0 12302000        	  5887:     move.b  (A0,D2.W),D1
02:000419C4 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000419C6 7600            	  5889:     moveq   #0,D3
02:000419C8 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:000419CA 1002            	  5893:     move.b  D2,D0
02:000419CC 0A000001        	  5894:     eori.b #$01,D0
02:000419D0 7400            	  5895:     moveq   #0,D2
02:000419D2 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:000419D4 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:000419D6 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:000419DA 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000419DE E14C            	  5902:     lsl.w   #8,D4
02:000419E0 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:000419E2 48C4            	  5904:     ext.l   D4
02:000419E4 D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000419EA 2044            	  5906:     movea.l D4,A0
02:000419EC 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000419F0 41F900048B32    	  5908:     lea     (LevelMasks).l,A0
02:000419F6 12302000        	  5909:     move.b  (A0,D2.W),D1
02:000419FA 8001            	  5910:     or.b  D1,D0
02:000419FC 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:000419FE 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:00041A02 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00041A06 E14C            	  5914:     lsl.w   #8,D4
02:00041A08 8841            	  5915:     or.w    D1,D4
02:00041A0A 48C4            	  5916:     ext.l   D4
02:00041A0C D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:00041A12 2044            	  5918:     movea.l D4,A0
02:00041A14 11803000        	  5919:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:00041A18 102C0055        	  5924:     move.b  ($0055,A4),D0
02:00041A1C 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:00041A20 8001            	  5926:     or.b  D1,D0
02:00041A22 6000FF66        	  5927:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:00041A26 102C0055        	  5954:     move.b  ($0055,A4),D0
02:00041A2A 19400002        	  5955:     move.b  D0,($0002,A4)
02:00041A2E 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:00041A32 0C000005        	  5957:     cmpi.b  #$05,D0
02:00041A36 650C            	  5958:     bcs  _anon_z05_125
02:00041A38 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:00041A3A 7004            	  5960:     moveq   #4,D0
02:00041A3C 4EB9000303F8    	  5961:     jsr     PlaySample
02:00041A42 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:00041A44 0C000004        	  5969:     cmpi.b  #$04,D0
02:00041A48 6602            	  5970:     bne  _anon_z05_126
02:00041A4A 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:00041A4C 0C000001        	  5973:     cmpi.b  #$01,D0
02:00041A50 6602            	  5974:     bne  _anon_z05_127
02:00041A52 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:00041A54 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:00041A58 123C0003        	  5980:     move.b  #$03,D1
02:00041A5C 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041A60 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:00041A62 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:00041A66 7600            	  5984:     moveq   #0,D3
02:00041A68 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:00041A6A 102C0008        	  5992:     move.b  ($0008,A4),D0
02:00041A6E 6708            	  5993:     beq  _anon_z05_128
02:00041A70 0C030005        	  5994:     cmpi.b  #$05,D3
02:00041A74 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00041A76 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:00041A78 0C030003        	  5998:     cmpi.b  #$03,D3
02:00041A7C 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00041A7E 5303            	  6000:     subq.b  #1,D3
                            	  6001:     even
                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:00041A80 7003            	  6008:     moveq   #3,D0
02:00041A82 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:00041A86 122C0003        	  6010:     move.b  ($0003,A4),D1
02:00041A8A 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041A8E 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:00041A90 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6014:     ; Call this to put the address of door face tiles in [02:03].
                            	  6015:     ;
02:00041A94 6100FD7A        	  6016:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6017:     ; Return the address of the door in the nametable in [01:00].
                            	  6018:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6019:     ;
02:00041A98 41F90004186E    	  6020:     lea     (DoorVramAddrsHi).l,A0
02:00041A9E 10302000        	  6021:     move.b  (A0,D2.W),D0
02:00041AA2 1880            	  6022:     move.b  D0,($0000,A4)
02:00041AA4 41F900041872    	  6023:     lea     (DoorVramAddrsLo).l,A0
02:00041AAA 10302000        	  6024:     move.b  (A0,D2.W),D0
02:00041AAE 19400001        	  6025:     move.b  D0,($0001,A4)
                            	  6026:     ; Return the direction of the door in [09], and the dynamic
                            	  6027:     ; transfer buf length in X register.
                            	  6028:     ;
02:00041AB2 19420009        	  6029:     move.b  D2,($0009,A4)
02:00041AB6 7400            	  6030:     moveq   #0,D2
02:00041AB8 142C0301        	  6031:     move.b  ($0301,A4),D2
                            	  6032:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  6033:     ;
02:00041ABC 7000            	  6034:     moveq   #0,D0
02:00041ABE 19400007        	  6035:     move.b  D0,($0007,A4)
02:00041AC2 7002            	  6036:     moveq   #2,D0
02:00041AC4 19400006        	  6037:     move.b  D0,($0006,A4)
02:00041AC8 19400005        	  6038:     move.b  D0,($0005,A4)
02:00041ACC 0A3C0001        	  6039:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00041AD0 4E75            	  6040:     rts
                            	  6041: 
                            	  6042:     even
