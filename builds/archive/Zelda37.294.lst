02:0003A1F4 5303            	  4984:     subq.b  #1,D3
02:0003A1F6 6A0C            	  4985:     bpl  _L_z04_UpdateStalfos_SetShootTimer
                            	  4986:     ; If stalfos does not want to shoot, then go set the qspeed.
