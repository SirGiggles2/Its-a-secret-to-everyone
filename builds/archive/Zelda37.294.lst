                            	  6135: Aquamentus_Shoot:
                            	  6136:     ; If the object timer <> 0, then
                            	  6137:     ; go modify fireballs that might still be flying.
                            	  6138:     ;
02:0003AA5C 10342028        	  6139:     move.b  ($28,A4,D2.W),D0
02:0003AA60 6634            	  6140:     bne  _L_z04_Aquamentus_Shoot_SpreadOutFireballs
                            	  6141:     ; The boss's object timer has expired. Time to shoot fireballs.
                            	  6142:     ;
                            	  6143:     ; Set the timer to a random time, at least $70 frames.
                            	  6144:     ;
02:0003AA62 10342018        	  6145:     move.b  ($18,A4,D2.W),D0
02:0003AA66 00000070        	  6146:     ori.b #$70,D0
02:0003AA6A 19802028        	  6147:     move.b  D0,($28,A4,D2.W)
                            	  6148:     ; Shoot the middle fireball. Its vertical displacement is 0.
                            	  6149:     ;
02:0003AA6E 6168            	  6150:     jsr     ShootFireball55
02:0003AA70 7000            	  6151:     moveq   #0,D0
02:0003AA72 41EC0478        	  6152:     lea     ($0478,A4),A0
02:0003AA76 11803000        	  6153:     move.b  D0,(A0,D3.W)
                            	  6154:     ; Shoot the lower fireball. Its vertical displacement is 1.
                            	  6155:     ;
02:0003AA7A 615C            	  6156:     jsr     ShootFireball55
02:0003AA7C 7001            	  6157:     moveq   #1,D0
02:0003AA7E 41EC0478        	  6158:     lea     ($0478,A4),A0
02:0003AA82 11803000        	  6159:     move.b  D0,(A0,D3.W)
                            	  6160:     ; Shoot the upper fireball. Its vertical displacement is -1.
                            	  6161:     ;
02:0003AA86 6150            	  6162:     jsr     ShootFireball55
02:0003AA88 103C00FF        	  6163:     move.b  #$FF,D0
02:0003AA8C 41EC0478        	  6164:     lea     ($0478,A4),A0
02:0003AA90 11803000        	  6165:     move.b  D0,(A0,D3.W)
02:0003AA94 4E75            	  6166:     rts
