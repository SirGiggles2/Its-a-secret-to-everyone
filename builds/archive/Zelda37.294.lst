                            	  5272: Moldorm_Chase:
                            	  5273:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5274:     ; Only the head controls the movement direction.
                            	  5275:     ;
02:0003A426 0C020005        	  5276:     cmpi.b  #$05,D2
02:0003A42A 670A            	  5277:     beq  _anon_z04_81
02:0003A42C 0C02000A        	  5278:     cmpi.b  #$0A,D2
02:0003A430 6704            	  5279:     beq.s  __far_z_04_0038
02:0003A432 600000A4        	  5280:     jmp  L1156B_Exit
                            	  5281: __far_z_04_0038:
                            	  5282: _anon_z04_81:
                            	  5283:     ; Chase while flying, as usual.
                            	  5284:     ;
02:0003A436 610039C8        	  5285:     jsr     Flyer_Chase
                            	  5286:     ; If timer has not expired, then
                            	  5287:     ; go see if it's time to propagate direction changes down the chain.
                            	  5288:     ;
02:0003A43A 10342028        	  5289:     move.b  ($28,A4,D2.W),D0
02:0003A43E 6702            	  5290:     beq.s  __far_z_04_0039
02:0003A440 6032            	  5291:     jmp  Moldorm_PropagateDirs
                            	  5292: __far_z_04_0039:
                            	  5293:     even
                            	  5294: Moldorm_ChangeFlyingState:
                            	  5295:     ; Timer = 0. Choose a new flying state, and arm the timer.
                            	  5296:     ;
02:0003A442 61000096        	  5297:     jsr     Flyer_MoldormDecideState
02:0003A446 7010            	  5298:     moveq   #16,D0
02:0003A448 19802028        	  5299:     move.b  D0,($28,A4,D2.W)
                            	  5300:     ; If the next lower slot's direction <> 0, then
                            	  5301:     ; go propagate direction changes down the chain.
                            	  5302:     ;
                            	  5303:     ; But you had to have propagated directions once for the
                            	  5304:     ; next lower direction to be set. How does it happen?
                            	  5305:     ;
                            	  5306:     ; Within a flyer state, the flying routines turn the flyer
                            	  5307:     ; and set the object timer to $10 several times. After any of
                            	  5308:     ; those times will the test succeed.
                            	  5309:     ;
                            	  5310:     ; When a flying state ends, timer will be 0, triggering the code
                            	  5311:     ; in this block to set the timer to $10, and try to propagate
                            	  5312:     ; directions.
                            	  5313:     ;
                            	  5314:     ; But this is also the case the first time here.
                            	  5315:     ;
                            	  5316:     ; So, I believe that the point of this test is to delay moving
                            	  5317:     ; the lower (not head) segments when starting out.
                            	  5318:     ;
02:0003A44C 41EC0097        	  5319:     lea     ($0097,A4),A0
02:0003A450 10302000        	  5320:     move.b  (A0,D2.W),D0
02:0003A454 6702            	  5321:     beq.s  __far_z_04_0040
02:0003A456 601C            	  5322:     jmp  Moldorm_PropagateDirs
                            	  5323: __far_z_04_0040:
02:0003A458 4E75            	  5324:     rts
                            	  5325: 
                            	  5326:     even
                            	  5327: Moldorm_Wander:
                            	  5328:     ; If the segment is not a head (slot 5 or $A), then return.
                            	  5329:     ; Only the head controls the movement direction.
                            	  5330:     ;
02:0003A45A 0C020005        	  5331:     cmpi.b  #$05,D2
02:0003A45E 6708            	  5332:     beq  _anon_z04_82
02:0003A460 0C02000A        	  5333:     cmpi.b  #$0A,D2
02:0003A464 6702            	  5334:     beq.s  __far_z_04_0041
02:0003A466 6070            	  5335:     jmp  L1156B_Exit
                            	  5336: __far_z_04_0041:
                            	  5337: _anon_z04_82:
                            	  5338:     ; Turn randomly while flying, as usual.
                            	  5339:     ;
02:0003A468 61003A74        	  5340:     jsr     Flyer_Wander
                            	  5341:     ; After every turn, the common flyer routines set timer to $10.
                            	  5342:     ; This can be used as a signal for moldorm to propagate
                            	  5343:     ; direction changes down the chain.
                            	  5344:     ;
                            	  5345:     ; Between each turn, timer <> $10.
                            	  5346:     ;
                            	  5347:     ; At the end of the delay after the last turn, timer = 0.
                            	  5348:     ; This is a signal that that flying state ended, and a new one
                            	  5349:     ; must be chosen. Also, because a flying interval ended ($10 frames),
                            	  5350:     ; we can propagate direction changes again; and start
                            	  5351:     ; a new flying interval by setting timer to $10. This will make
                            	  5352:     ; the next flying state delay that amount of time before turning
                            	  5353:     ; the first time.
                            	  5354:     ;
                            	  5355:     ; Here and now, if timer has expired, then go decide a new flying state,
                            	  5356:     ; arm the timer again, and shift directions down the chain.
                            	  5357:     ;
02:0003A46C 10342028        	  5358:     move.b  ($28,A4,D2.W),D0
02:0003A470 6602            	  5359:     bne.s  __far_z_04_0042
02:0003A472 60CE            	  5360:     jmp  Moldorm_ChangeFlyingState
                            	  5361: __far_z_04_0042:
                            	  5362:     even
                            	  5363: Moldorm_PropagateDirs:
                            	  5364:     ; If timer <> $10 (rearmed in this frame), then return.
                            	  5365:     ;
02:0003A474 10342028        	  5366:     move.b  ($28,A4,D2.W),D0
02:0003A478 0C000010        	  5367:     cmpi.b  #$10,D0
02:0003A47C 6702            	  5368:     beq.s  __far_z_04_0043
02:0003A47E 6058            	  5369:     jmp  L1156B_Exit
