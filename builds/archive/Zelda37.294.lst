02:0004A544 0C000070        	  5725:     cmpi.b  #$70,D0
02:0004A548 6502            	  5726:     bcs  _L_z07_CheckState30_SetThrowerTimer
02:0004A54A 7670            	  5727:     moveq   #112,D3
                            	  5728:     even
                            	  5729: _L_z07_CheckState30_SetThrowerTimer:
