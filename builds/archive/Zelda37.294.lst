02:0003C5F8 0A3C0010        	  9853:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C5FC 9101            	  9854:     subx.b  D1,D0   ; SBC ObjY+1
02:0003C5FE 0A3C0010        	  9855:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C602 4EB9000304AE    	  9856:     jsr     Abs
