                            	  6948: _L_z07_AnimateLinkObjState_SetMovementFrame1:
                            	  6949:     ; To animate the state, the animation counter had to have
                            	  6950:     ; reached 0. Right after this routine, the counter will be
                            	  6951:     ; rolled over, and the movement frame will be switched.
                            	  6952:     ;
                            	  6953:     ; So, set movement frame to 1 (legs together) at the end of
                            	  6954:     ; the animation here, in order to immediately change it to
                            	  6955:     ; 0 (legs apart) after this.
                            	  6956:     ;
02:0004ADD6 7001            	  6957:     moveq   #1,D0
02:0004ADD8 194003E4        	  6958:     move.b  D0,($03E4,A4)
02:0004ADDC 4E75            	  6959:     rts
                            	  6960: 
