02:0003AC24 7020            	  6393:     moveq   #32,D0
02:0003AC26 41EC041F        	  6394:     lea     ($041F,A4),A0
02:0003AC2A 11802000        	  6395:     move.b  D0,(A0,D2.W)
02:0003AC2E 6100D44C        	  6396:     jsr     Wanderer_TargetPlayer
                            	  6397:     ; Pop the offset and add it to the X coordinate.
                            	  6398:     ;
                            	  6399:     ; This brings the X coordinate back to the unique value
                            	  6400:     ; that represents the position.
                            	  6401:     ;
02:0003AC32 101D            	  6402:     move.b  (A5)+,D0  ; PLA
02:0003AC34 023C00EE        	  6403:     andi    #$EE,CCR  ; CLC: clear C+X
