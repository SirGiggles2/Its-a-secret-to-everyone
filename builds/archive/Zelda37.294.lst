02:0003C28A 023C00EE        	  9444:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C28E 41EC03E4        	  9445:     lea     ($03E4,A4),A0
02:0003C292 12302000        	  9446:     move.b  (A0,D2.W),D1
02:0003C296 D101            	  9447:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003C298 02000001        	  9448:     andi.b #$01,D0
02:0003C29C 023C00EE        	  9449:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C2A0 123C0004        	  9450:     move.b  #$04,D1
02:0003C2A4 D101            	  9451:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003C2A6 4EF90003087A    	  9452:     jmp     DrawObjectNotMirrored
