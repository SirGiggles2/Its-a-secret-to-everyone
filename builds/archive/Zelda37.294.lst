02:00048E0A 10342070        	  2360:     move.b  ($70,A4,D2.W),D0
02:00048E0E 19400003        	  2361:     move.b  D0,($0003,A4)
02:00048E12 41EC0084        	  2362:     lea     ($0084,A4),A0
02:00048E16 10302000        	  2363:     move.b  (A0,D2.W),D0
02:00048E1A 19400002        	  2364:     move.b  D0,($0002,A4)
02:00048E1E 4EB90003061C    	  2365:     jsr     MapScreenPosToPpuAddr
02:00048E24 7400            	  2366:     moveq   #0,D2
02:00048E26 142C0301        	  2367:     move.b  ($0301,A4),D2
                            	  2368:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2369:     ;
                            	  2370:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2371:     ; In total, 11 bytes will be written.
                            	  2372:     ;
                            	  2373:     ; First, write the high byte of PPU address in each record.
                            	  2374:     ;
02:00048E2A 1014            	  2375:     move.b  ($0000,A4),D0
02:00048E2C 41EC0302        	  2376:     lea     ($0302,A4),A0
02:00048E30 11802000        	  2377:     move.b  D0,(A0,D2.W)
02:00048E34 41EC0307        	  2378:     lea     ($0307,A4),A0
02:00048E38 11802000        	  2379:     move.b  D0,(A0,D2.W)
                            	  2380:     ; Write the low address in the first record. In the second record,
                            	  2381:     ; write (low address + 1).
                            	  2382:     ;
02:00048E3C 102C0001        	  2383:     move.b  ($0001,A4),D0
02:00048E40 41EC0303        	  2384:     lea     ($0303,A4),A0
02:00048E44 11802000        	  2385:     move.b  D0,(A0,D2.W)
02:00048E48 41EC0308        	  2386:     lea     ($0308,A4),A0
02:00048E4C 11802000        	  2387:     move.b  D0,(A0,D2.W)
02:00048E50 41EC0308        	  2388:     lea     ($0308,A4),A0
02:00048E54 52302000        	  2389:     addq.b  #1,(A0,D2.W)
                            	  2390:     ; Write the first tile twice in each record. Patch them later.
                            	  2391:     ;
02:00048E58 102C0005        	  2392:     move.b  ($0005,A4),D0
02:00048E5C 41EC0305        	  2393:     lea     ($0305,A4),A0
02:00048E60 11802000        	  2394:     move.b  D0,(A0,D2.W)
02:00048E64 41EC0306        	  2395:     lea     ($0306,A4),A0
02:00048E68 11802000        	  2396:     move.b  D0,(A0,D2.W)
02:00048E6C 41EC030A        	  2397:     lea     ($030A,A4),A0
02:00048E70 11802000        	  2398:     move.b  D0,(A0,D2.W)
02:00048E74 41EC030B        	  2399:     lea     ($030B,A4),A0
02:00048E78 11802000        	  2400:     move.b  D0,(A0,D2.W)
                            	  2401:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2402:     ; Add 1 more to the second byte in each record.
