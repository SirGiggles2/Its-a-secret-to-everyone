02:0004A05A 19802070        	  4985:     move.b  D0,($70,A4,D2.W)
02:0004A05E 41EC0084        	  4986:     lea     ($0084,A4),A0
02:0004A062 10303000        	  4987:     move.b  (A0,D3.W),D0
02:0004A066 41EC0084        	  4988:     lea     ($0084,A4),A0
02:0004A06A 11802000        	  4989:     move.b  D0,(A0,D2.W)
02:0004A06E 41EC0098        	  4990:     lea     ($0098,A4),A0
02:0004A072 10303000        	  4991:     move.b  (A0,D3.W),D0
02:0004A076 41EC0098        	  4992:     lea     ($0098,A4),A0
02:0004A07A 11802000        	  4993:     move.b  D0,(A0,D2.W)
