02:0003A380 41EC0098        	  5185:     lea     ($0098,A4),A0
02:0003A384 11802000        	  5186:     move.b  D0,(A0,D2.W)
                            	  5187:     ; If this segment is still alive, then return.
                            	  5188:     ;
02:0003A388 41EC0405        	  5189:     lea     ($0405,A4),A0
02:0003A38C 10302000        	  5190:     move.b  (A0,D2.W),D0
02:0003A390 6774            	  5191:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5192:     ; This segment is dead. We'll swap the tail segment with this
                            	  5193:     ; dead segment. This way, moldorm heads are always rooted
                            	  5194:     ; in slots 5 and $A; and the segments are continguous.
                            	  5195:     ;
                            	  5196:     ; Start by setting the HP for this dead segment's slot to $20.
                            	  5197:     ;
                            	  5198:     ; Note that this is not a true swap, because the tail's HP
                            	  5199:     ; might be less than $20.
                            	  5200:     ;
02:0003A392 7020            	  5201:     moveq   #32,D0
02:0003A394 41EC0485        	  5202:     lea     ($0485,A4),A0
02:0003A398 11802000        	  5203:     move.b  D0,(A0,D2.W)
02:0003A39C 61000608        	  5204:     jsr     CheckBossHitReaction
                            	  5205:     ; Look for the tail segment, starting from the low end
                            	  5206:     ; of the chain that this dead segment belongs to.
                            	  5207:     ;
02:0003A3A0 163C00FF        	  5208:     move.b  #$FF,D3
02:0003A3A4 0C020006        	  5209:     cmpi.b  #$06,D2
02:0003A3A8 6502            	  5210:     bcs  _anon_z04_80
02:0003A3AA 7604            	  5211:     moveq   #4,D3
                            	  5212: _anon_z04_80:
02:0003A3AC 5203            	  5213:     addq.b  #1,D3
02:0003A3AE 41EC0350        	  5214:     lea     ($0350,A4),A0
02:0003A3B2 10303000        	  5215:     move.b  (A0,D3.W),D0
02:0003A3B6 0C000041        	  5216:     cmpi.b  #$41,D0
02:0003A3BA 66F0            	  5217:     bne  _anon_z04_80
                            	  5218:     ; I don't know why the object timer of the tail segment that will
                            	  5219:     ; be made dead is set to $11. By setting its object type to $5D
                            	  5220:     ; below, its metastate will become $10 -- dying/dead. From
                            	  5221:     ; there, the object timer is set to 6.
                            	  5222:     ;
02:0003A3BC 7011            	  5223:     moveq   #17,D0
02:0003A3BE 19803029        	  5224:     move.b  D0,($29,A4,D3.W)
                            	  5225:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  5226:     ; segment to the tail segment.
                            	  5227:     ;
02:0003A3C2 41EC04F0        	  5228:     lea     ($04F0,A4),A0
02:0003A3C6 10302000        	  5229:     move.b  (A0,D2.W),D0
02:0003A3CA 41EC04F1        	  5230:     lea     ($04F1,A4),A0
02:0003A3CE 11803000        	  5231:     move.b  D0,(A0,D3.W)
02:0003A3D2 10342070        	  5232:     move.b  ($70,A4,D2.W),D0
02:0003A3D6 19803071        	  5233:     move.b  D0,($71,A4,D3.W)
02:0003A3DA 41EC0084        	  5234:     lea     ($0084,A4),A0
02:0003A3DE 10302000        	  5235:     move.b  (A0,D2.W),D0
02:0003A3E2 41EC0085        	  5236:     lea     ($0085,A4),A0
02:0003A3E6 11803000        	  5237:     move.b  D0,(A0,D3.W)
                            	  5238:     ; If the tail segment found is also a head, then
                            	  5239:     ; the last segment has died. Return.
                            	  5240:     ;
02:0003A3EA 0C030004        	  5241:     cmpi.b  #$04,D3
02:0003A3EE 6716            	  5242:     beq  _L_z04_UpdateMoldorm_Exit
02:0003A3F0 0C030009        	  5243:     cmpi.b  #$09,D3
02:0003A3F4 6710            	  5244:     beq  _L_z04_UpdateMoldorm_Exit
                            	  5245:     ; Else finish swapping the segments.
