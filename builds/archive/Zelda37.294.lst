                            	   749: _L_z01_CopyCommonCodeToRam_Loop:
02:0002EF78 1214            	   750:     move.b  ($00,A4),D1   ; ptr lo
02:0002EF7A 182C0001        	   751:     move.b  ($01,A4),D4  ; ptr hi
02:0002EF7E 024100FF        	   752:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EF82 E14C            	   753:     lsl.w   #8,D4
02:0002EF84 8841            	   754:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002EF86 48C4            	   755:     ext.l   D4
02:0002EF88 D8BC00FF0000    	   756:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002EF8E 2044            	   757:     movea.l D4,A0
02:0002EF90 10303000        	   758:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002EF94 122C0002        	   759:     move.b  ($02,A4),D1   ; ptr lo
02:0002EF98 182C0003        	   760:     move.b  ($03,A4),D4  ; ptr hi
02:0002EF9C 024100FF        	   761:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002EFA0 E14C            	   762:     lsl.w   #8,D4
02:0002EFA2 8841            	   763:     or.w    D1,D4
02:0002EFA4 48C4            	   764:     ext.l   D4
02:0002EFA6 D8BC00FF0000    	   765:     add.l   #NES_RAM,D4
02:0002EFAC 2044            	   766:     movea.l D4,A0
02:0002EFAE 11803000        	   767:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	   768:     ; Increment source address.
                            	   769:     ;
02:0002EFB2 1014            	   770:     move.b  ($0000,A4),D0
02:0002EFB4 023C00EE        	   771:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EFB8 123C0001        	   772:     move.b  #$01,D1
02:0002EFBC D101            	   773:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EFBE 1880            	   774:     move.b  D0,($0000,A4)
02:0002EFC0 102C0001        	   775:     move.b  ($0001,A4),D0
02:0002EFC4 123C0000        	   776:     move.b  #$00,D1
02:0002EFC8 D101            	   777:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EFCA 19400001        	   778:     move.b  D0,($0001,A4)
                            	   779:     ; Increment destination address.
                            	   780:     ;
02:0002EFCE 102C0002        	   781:     move.b  ($0002,A4),D0
02:0002EFD2 023C00EE        	   782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002EFD6 123C0001        	   783:     move.b  #$01,D1
02:0002EFDA D101            	   784:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0002EFDC 19400002        	   785:     move.b  D0,($0002,A4)
02:0002EFE0 102C0003        	   786:     move.b  ($0003,A4),D0
02:0002EFE4 123C0000        	   787:     move.b  #$00,D1
02:0002EFE8 D101            	   788:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002EFEA 19400003        	   789:     move.b  D0,($0003,A4)
02:0002EFEE 0C00007F        	   790:     cmpi.b  #$7F,D0
02:0002EFF2 6684            	   791:     bne  _L_z01_CopyCommonCodeToRam_Loop
02:0002EFF4 102C0002        	   792:     move.b  ($0002,A4),D0
02:0002EFF8 4A00            	   793:     cmpi.b  #$00,D0
02:0002EFFA 6600FF7C        	   794:     bne  _L_z01_CopyCommonCodeToRam_Loop
