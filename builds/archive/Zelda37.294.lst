                            	  5527: _L_z07_CheckState20_Deactivate:
02:0004A408 61000534        	  5528:     jsr     ResetObjState
                            	  5529:     ; If it's a monster's arrow, then destroy it in the monster slot,
                            	  5530:     ; including clearing object type.
                            	  5531:     ;
02:0004A40C 0C02000D        	  5532:     cmpi.b  #$0D,D2
02:0004A410 6406            	  5533:     bcc  _anon_z07_29
02:0004A412 4EB9000385FE    	  5534:     jsr     DestroyCountedMonsterShot
                            	  5535: _anon_z07_29:
02:0004A418 0A3C0001        	  5536:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
