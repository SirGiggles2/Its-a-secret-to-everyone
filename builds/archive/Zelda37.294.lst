02:00032D2A 162C0437        	  1704:     move.b  ($0437,A4),D3
02:00032D2E 41F900032CCD    	  1705:     lea     (DemoPhase0Subphase1Delays-1).l,A0
02:00032D34 10303000        	  1706:     move.b  (A0,D3.W),D0
02:00032D38 19400438        	  1707:     move.b  D0,($0438,A4)
02:00032D3C 0C03000E        	  1708:     cmpi.b  #$0E,D3
02:00032D40 650E            	  1709:     bcs  _L_z02_AnimateDemoPhase0Subphase1_UpdateAnimation
                            	  1710:     ; Advance to the next demo phase.
                            	  1711:     ;
