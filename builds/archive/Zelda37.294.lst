02:0003D70E 41F90003D5DE    	 12223:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003D714 12302000        	 12224:     move.b  (A0,D2.W),D1
02:0003D718 8001            	 12225:     or.b  D1,D0
02:0003D71A 19400003        	 12226:     move.b  D0,($0003,A4)
02:0003D71E 41F90003D5E8    	 12227:     lea     (GanonBurstTiles).l,A0
