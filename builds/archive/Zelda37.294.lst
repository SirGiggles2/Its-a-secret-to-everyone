                            	  4839: _anon_z04_70:
                            	  4840:     ; If Link is facing in the direction passed in (which decreases), then:
                            	  4841:     ; 1. negate the distance
                            	  4842:     ; 2. add 8 to the instruction offset to access
                            	  4843:     ;    the opposite direction for the same wall
                            	  4844:     ;
02:0003A0CE 7600            	  4845:     moveq   #0,D3
02:0003A0D0 162C0098        	  4846:     move.b  ($0098,A4),D3
02:0003A0D4 122C0002        	  4847:     move.b  ($0002,A4),D1
02:0003A0D8 B601            	  4848:     cmp.b   D1,D3
02:0003A0DA 662A            	  4849:     bne  _anon_z04_71
02:0003A0DC 1B00            	  4850:     move.b  D0,-(A5)  ; PHA
02:0003A0DE 41EC0412        	  4851:     lea     ($0412,A4),A0
02:0003A0E2 10302000        	  4852:     move.b  (A0,D2.W),D0
02:0003A0E6 023C00EE        	  4853:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A0EA 123C0008        	  4854:     move.b  #$08,D1
02:0003A0EE D101            	  4855:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A0F0 41EC0412        	  4856:     lea     ($0412,A4),A0
02:0003A0F4 11802000        	  4857:     move.b  D0,(A0,D2.W)
02:0003A0F8 101D            	  4858:     move.b  (A5)+,D0  ; PLA
02:0003A0FA 4600            	  4859:     eori.b #$FF,D0
02:0003A0FC 023C00EE        	  4860:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A100 123C0001        	  4861:     move.b  #$01,D1
02:0003A104 D101            	  4862:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  4863: _anon_z04_71:
                            	  4864:     ; Add the distance and Link's minor coordinate to calculate
                            	  4865:     ; Wallmaster's initial minor coordinate to store in [04].
                            	  4866:     ; In general, the monster will be put in front of Link.
                            	  4867:     ;
02:0003A106 023C00EE        	  4868:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A10A 1214            	  4869:     move.b  ($0000,A4),D1
02:0003A10C D101            	  4870:     addx.b  D1,D0   ; ADC $00
02:0003A10E 19400004        	  4871:     move.b  D0,($0004,A4)
                            	  4872:     ; By default, will return index 0 to choose the minimum value
                            	  4873:     ; for Wallmaster's initial major coordinate. This will be returned,
                            	  4874:     ; if Link is at the wall with a smaller major coordinate.
                            	  4875:     ;
02:0003A112 7600            	  4876:     moveq   #0,D3
                            	  4877:     ; If Link's major coordinate <> the minimum major coordinate, then
                            	  4878:     ; he's on the farther wall. Add $10 to the instruction offset 
                            	  4879:     ; to access the block for the other direction along the same axis,
                            	  4880:     ; and increment the index for the Wallmaster's initial major coordinate.
                            	  4881:     ;
02:0003A114 102C0001        	  4882:     move.b  ($0001,A4),D0
02:0003A118 122C0003        	  4883:     move.b  ($0003,A4),D1
02:0003A11C B001            	  4884:     cmp.b   D1,D0
02:0003A11E 671C            	  4885:     beq  _anon_z04_72
02:0003A120 41EC0412        	  4886:     lea     ($0412,A4),A0
02:0003A124 10302000        	  4887:     move.b  (A0,D2.W),D0
02:0003A128 023C00EE        	  4888:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A12C 123C0010        	  4889:     move.b  #$10,D1
02:0003A130 D101            	  4890:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003A132 41EC0412        	  4891:     lea     ($0412,A4),A0
02:0003A136 11802000        	  4892:     move.b  D0,(A0,D2.W)
02:0003A13A 5203            	  4893:     addq.b  #1,D3
