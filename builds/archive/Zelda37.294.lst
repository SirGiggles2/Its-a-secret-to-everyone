02:0003AAAC 651E            	  6187:     bcs  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  6188:     ; Add the displacement for this fireball to its Y coordinate.
                            	  6189:     ;
02:0003AAAE 41EC0084        	  6190:     lea     ($0084,A4),A0
02:0003AAB2 10302000        	  6191:     move.b  (A0,D2.W),D0
02:0003AAB6 023C00EE        	  6192:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AABA 41EC0478        	  6193:     lea     ($0478,A4),A0
02:0003AABE 12302000        	  6194:     move.b  (A0,D2.W),D1
02:0003AAC2 D101            	  6195:     addx.b  D1,D0   ; ADC Aquamentus_ObjFireballOffset,X
02:0003AAC4 41EC0084        	  6196:     lea     ($0084,A4),A0
02:0003AAC8 11802000        	  6197:     move.b  D0,(A0,D2.W)
                            	  6198:     even
