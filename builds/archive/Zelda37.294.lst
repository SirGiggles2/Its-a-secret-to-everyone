                            	  2892: 
                            	  2893: _anon_z04_42:
                            	  2894:     ; State 0.
                            	  2895:     ;
                            	  2896:     ; In state we determine whether to burst out of the ground.
                            	  2897:     ; If the long timer has not expired, then return.
                            	  2898:     ;
02:00039318 102C004D        	  2899:     move.b  ($004D,A4),D0
02:0003931C 6674            	  2900:     bne  _L_z04_UpdateRedLeever_Exit
                            	  2901:     ; Only allow two red leevers at a time.
                            	  2902:     ;
02:0003931E 102C0510        	  2903:     move.b  ($0510,A4),D0
02:00039322 0C000002        	  2904:     cmpi.b  #$02,D0
02:00039326 646A            	  2905:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  2906:     ; Face in the same direction as Link.
                            	  2907:     ;
02:00039328 102C0098        	  2908:     move.b  ($0098,A4),D0
02:0003932C 41EC0098        	  2909:     lea     ($0098,A4),A0
02:00039330 11802000        	  2910:     move.b  D0,(A0,D2.W)
                            	  2911:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  2912:     ;
02:00039334 10342019        	  2913:     move.b  ($19,A4,D2.W),D0
02:00039338 0C0000C0        	  2914:     cmpi.b  #$C0,D0
02:0003933C 6506            	  2915:     bcs  _anon_z04_43
02:0003933E 4EB900049C80    	  2916:     jsr     ReverseObjDir
                            	  2917: _anon_z04_43:
                            	  2918:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  2919:     ;
02:00039344 41EC0098        	  2920:     lea     ($0098,A4),A0
02:00039348 10302000        	  2921:     move.b  (A0,D2.W),D0
02:0003934C 0200000C        	  2922:     andi.b #$0C,D0
02:00039350 6742            	  2923:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  2924:     ; Begin with the leever's X set to Link's X.
                            	  2925:     ;
02:00039352 102C0070        	  2926:     move.b  ($0070,A4),D0
02:00039356 19802070        	  2927:     move.b  D0,($70,A4,D2.W)
                            	  2928:     ; If facing down, then use Y offset $28.
                            	  2929:     ; Else store Y offset -$28 in [00].
                            	  2930:     ;
02:0003935A 7628            	  2931:     moveq   #40,D3
02:0003935C 41EC0098        	  2932:     lea     ($0098,A4),A0
02:00039360 10302000        	  2933:     move.b  (A0,D2.W),D0
02:00039364 02000008        	  2934:     andi.b #$08,D0
02:00039368 6704            	  2935:     beq  _anon_z04_44
02:0003936A 163C00D8        	  2936:     move.b  #$D8,D3
                            	  2937: _anon_z04_44:
02:0003936E 1883            	  2938:     move.b  D3,($0000,A4)
                            	  2939:     ; Add Link's Y and the vertical offset.
                            	  2940:     ;
02:00039370 102C0084        	  2941:     move.b  ($0084,A4),D0
02:00039374 023C00EE        	  2942:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039378 1214            	  2943:     move.b  ($0000,A4),D1
02:0003937A D101            	  2944:     addx.b  D1,D0   ; ADC $00
                            	  2945:     ; Sanitize the Y coordinate:
                            	  2946:     ; (Y AND $F0) OR $D
                            	  2947:     ;
02:0003937C 020000F0        	  2948:     andi.b #$F0,D0
02:00039380 0000000D        	  2949:     ori.b #$0D,D0
02:00039384 41EC0084        	  2950:     lea     ($0084,A4),A0
02:00039388 11802000        	  2951:     move.b  D0,(A0,D2.W)
                            	  2952:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  2953:     ; go see if the tile is valid to come out of.
                            	  2954:     ;
                            	  2955:     ; Else it's too close to the top edge of the screen. So, return.
                            	  2956:     ;
02:0003938C 0C00005D        	  2957:     cmpi.b  #$5D,D0
02:00039390 647A            	  2958:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  2959:     even
                            	  2960: _L_z04_UpdateRedLeever_Exit:
02:00039392 4E75            	  2961:     rts
                            	  2962: 
