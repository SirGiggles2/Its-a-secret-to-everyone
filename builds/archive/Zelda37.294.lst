                            	  5593: CheckState30:
                            	  5594:     ; If major state <> $30, go check other states.
                            	  5595:     ;
02:0004A480 0C000030        	  5596:     cmpi.b  #$30,D0
02:0004A484 6656            	  5597:     bne  _L_z07_CheckState30_CheckOtherStates
                            	  5598:     ; State $3x. Slow down.
                            	  5599:     ;
                            	  5600:     ; Reset grid offset for movement.
                            	  5601:     ;
02:0004A486 7000            	  5602:     moveq   #0,D0
02:0004A488 41EC0394        	  5603:     lea     ($0394,A4),A0
02:0004A48C 11802000        	  5604:     move.b  D0,(A0,D2.W)
                            	  5605:     ; Go slow at q-speed fraction $40 (1 pixel a frame).
                            	  5606:     ;
02:0004A490 7040            	  5607:     moveq   #64,D0
02:0004A492 41EC03BC        	  5608:     lea     ($03BC,A4),A0
02:0004A496 11802000        	  5609:     move.b  D0,(A0,D2.W)
                            	  5610:     ; If facing left and X < 2, then go change state to $40. The
                            	  5611:     ; boomerang is too close to the left edge of the screen.
                            	  5612:     ; Another move might make it wrap around.
                            	  5613:     ;
02:0004A49A 41EC0098        	  5614:     lea     ($0098,A4),A0
02:0004A49E 10302000        	  5615:     move.b  (A0,D2.W),D0
02:0004A4A2 1940000F        	  5616:     move.b  D0,($000F,A4)
02:0004A4A6 02000002        	  5617:     andi.b #$02,D0
02:0004A4AA 670A            	  5618:     beq  _L_z07_CheckState30_MoveBoomerang
02:0004A4AC 10342070        	  5619:     move.b  ($70,A4,D2.W),D0
02:0004A4B0 0C000002        	  5620:     cmpi.b  #$02,D0
02:0004A4B4 650E            	  5621:     bcs  _L_z07_CheckState30_SetState40
                            	  5622:     even
                            	  5623: _L_z07_CheckState30_MoveBoomerang:
                            	  5624:     ; Move the boomerang.
                            	  5625:     ;
02:0004A4B6 6100F570        	  5626:     jsr     MoveObject
                            	  5627:     ; Decrement timer ObjMovingLimit. Once it reaches 0, change
                            	  5628:     ; state to $40.
                            	  5629:     ;
02:0004A4BA 41EC0380        	  5630:     lea     ($0380,A4),A0
02:0004A4BE 53302000        	  5631:     subq.b  #1,(A0,D2.W)
02:0004A4C2 6614            	  5632:     bne  _L_z07_CheckState30_AnimateBoomerang
                            	  5633:     even
                            	  5634: _L_z07_CheckState30_SetState40:
                            	  5635:     ; Set state $40, and a time to move of $20 frames.
                            	  5636:     ;
                            	  5637:     ; In major state $40, ObjMovingLimit is a timer to change the state to $50.
                            	  5638:     ;
                            	  5639:     ; Also, animate, draw, and handle any collision (with Link, if a monster's boomerang).
                            	  5640:     ;
02:0004A4C4 7020            	  5641:     moveq   #32,D0
02:0004A4C6 41EC0380        	  5642:     lea     ($0380,A4),A0
02:0004A4CA 11802000        	  5643:     move.b  D0,(A0,D2.W)
