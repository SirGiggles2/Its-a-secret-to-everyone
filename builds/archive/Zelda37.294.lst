                            	  9361: _L_z04_UpdateGohma_AnimateClosedEye:
                            	  9362:     ; Here the eye is closed. So animate it this way.
                            	  9363:     ; Increment the animation counter, and if <> 8, then
                            	  9364:     ; go shoot, draw, and check collisions.
                            	  9365:     ;
02:0003C20A 41EC0478        	  9366:     lea     ($0478,A4),A0
