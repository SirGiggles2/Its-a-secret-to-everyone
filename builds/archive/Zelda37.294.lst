                            	 11656: PatraChild_State1:
                            	 11657:     ; Add Patra's distance traveled since the last frame to this child's coordinates.
                            	 11658:     ;
02:0003D320 10342070        	 11659:     move.b  ($70,A4,D2.W),D0
02:0003D324 023C00EE        	 11660:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D328 122C046C        	 11661:     move.b  ($046C,A4),D1
02:0003D32C D101            	 11662:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetX+1
02:0003D32E 19802070        	 11663:     move.b  D0,($70,A4,D2.W)
02:0003D332 41EC0084        	 11664:     lea     ($0084,A4),A0
02:0003D336 10302000        	 11665:     move.b  (A0,D2.W),D0
02:0003D33A 023C00EE        	 11666:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D33E 122C0479        	 11667:     move.b  ($0479,A4),D1
02:0003D342 D101            	 11668:     addx.b  D1,D0   ; ADC Flyer_ObjOffsetY+1
02:0003D344 41EC0084        	 11669:     lea     ($0084,A4),A0
02:0003D348 11802000        	 11670:     move.b  D0,(A0,D2.W)
                            	 11671:     ; Reset [0B]. The high byte of the amount to subtract is 0.
                            	 11672:     ;
02:0003D34C 7000            	 11673:     moveq   #0,D0
02:0003D34E 1940000B        	 11674:     move.b  D0,($000B,A4)
                            	 11675:     ; If the monster is type $25 Patra Child1, then decrease the
                            	 11676:     ; monster's angle by $70, else by $60 to go slower.
