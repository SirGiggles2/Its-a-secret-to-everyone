                            	 11009: _L_z04_UpdateLamnola_DrawAndCheckCollisions:
02:0003CE92 10342070        	 11010:     move.b  ($70,A4,D2.W),D0
02:0003CE96 1B00            	 11011:     move.b  D0,-(A5)  ; PHA
                            	 11012:     ; Each segment is a full 16x16 object. But, it's drawn as a narrow,
                            	 11013:     ; half-width object. So, center it by temporarily adding 4 to X.
                            	 11014:     ;
02:0003CE98 023C00EE        	 11015:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CE9C 123C0004        	 11016:     move.b  #$04,D1
02:0003CEA0 D101            	 11017:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003CEA2 19802070        	 11018:     move.b  D0,($70,A4,D2.W)
                            	 11019:     ; The speed is 1 or 2. By swapping them, you get sprite attributes
                            	 11020:     ; to store in [03].
                            	 11021:     ;
02:0003CEA6 102C04E6        	 11022:     move.b  ($04E6,A4),D0
02:0003CEAA 0A000003        	 11023:     eori.b #$03,D0
02:0003CEAE 19400003        	 11024:     move.b  D0,($0003,A4)
                            	 11025:     ; If the segment is a head, then use tile $9E, else $A0.
                            	 11026:     ;
02:0003CEB2 103C009E        	 11027:     move.b  #$9E,D0
02:0003CEB6 0C020005        	 11028:     cmpi.b  #$05,D2
02:0003CEBA 670A            	 11029:     beq  _L_z04_UpdateLamnola_Draw
02:0003CEBC 0C02000A        	 11030:     cmpi.b  #$0A,D2
02:0003CEC0 6704            	 11031:     beq  _L_z04_UpdateLamnola_Draw
02:0003CEC2 103C00A0        	 11032:     move.b  #$A0,D0
                            	 11033:     even
                            	 11034: _L_z04_UpdateLamnola_Draw:
02:0003CEC6 4EB900030B76    	 11035:     jsr     Anim_WriteSprite
02:0003CECC 101D            	 11036:     move.b  (A5)+,D0  ; PLA
02:0003CECE 19802070        	 11037:     move.b  D0,($70,A4,D2.W)
02:0003CED2 41EC0098        	 11038:     lea     ($0098,A4),A0
02:0003CED6 10302000        	 11039:     move.b  (A0,D2.W),D0
02:0003CEDA 1B00            	 11040:     move.b  D0,-(A5)  ; PHA
02:0003CEDC 4EB900030BE6    	 11041:     jsr     CheckMonsterCollisions
02:0003CEE2 101D            	 11042:     move.b  (A5)+,D0  ; PLA
02:0003CEE4 41EC0098        	 11043:     lea     ($0098,A4),A0
02:0003CEE8 11802000        	 11044:     move.b  D0,(A0,D2.W)
                            	 11045:     ; If still alive, then return.
                            	 11046:     ;
02:0003CEEC 41EC0405        	 11047:     lea     ($0405,A4),A0
02:0003CEF0 10302000        	 11048:     move.b  (A0,D2.W),D0
02:0003CEF4 6604            	 11049:     bne.s  __far_z_04_0107
02:0003CEF6 6000FF72        	 11050:     jmp  L129EA_Exit
                            	 11051: __far_z_04_0107:
                            	 11052:     ; Otherwise, the segment is dead.
                            	 11053:     ;
02:0003CEFA 4EB900049748    	 11054:     jsr     ResetShoveInfo
                            	 11055:     ; Set the current segment's HP to the initial value in anticipation
                            	 11056:     ; of bringing this segment back to life.
                            	 11057:     ;
02:0003CF00 7020            	 11058:     moveq   #32,D0
02:0003CF02 41EC0485        	 11059:     lea     ($0485,A4),A0
02:0003CF06 11802000        	 11060:     move.b  D0,(A0,D2.W)
                            	 11061:     ; Find the tail of the lamnola that the current segment belongs to.
                            	 11062:     ;
                            	 11063:     ; From the lowest slot, look for one that has the original lamnola
                            	 11064:     ; object type.
                            	 11065:     ;
                            	 11066:     ; The goal is to swap the current dead segment with the tail segment.
                            	 11067:     ;
02:0003CF0A 163C00FF        	 11068:     move.b  #$FF,D3
02:0003CF0E 0C020006        	 11069:     cmpi.b  #$06,D2
02:0003CF12 6502            	 11070:     bcs  _L_z04_UpdateLamnola_FindTail
02:0003CF14 7604            	 11071:     moveq   #4,D3
                            	 11072:     even
                            	 11073: _L_z04_UpdateLamnola_FindTail:
02:0003CF16 5203            	 11074:     addq.b  #1,D3
02:0003CF18 41EC0350        	 11075:     lea     ($0350,A4),A0
02:0003CF1C 10303000        	 11076:     move.b  (A0,D3.W),D0
02:0003CF20 122C04E7        	 11077:     move.b  ($04E7,A4),D1
02:0003CF24 B001            	 11078:     cmp.b   D1,D0
02:0003CF26 66EE            	 11079:     bne  _L_z04_UpdateLamnola_FindTail
                            	 11080:     ; Set the timer for the dead dummy object that will replace the tail.
                            	 11081:     ;
02:0003CF28 7011            	 11082:     moveq   #17,D0
02:0003CF2A 19803029        	 11083:     move.b  D0,($29,A4,D3.W)
                            	 11084:     ; Copy the current dead segment's invincibility timer, X, and Y
                            	 11085:     ; to the tail segment.
                            	 11086:     ;
02:0003CF2E 41EC04F0        	 11087:     lea     ($04F0,A4),A0
02:0003CF32 10302000        	 11088:     move.b  (A0,D2.W),D0
02:0003CF36 41EC04F1        	 11089:     lea     ($04F1,A4),A0
02:0003CF3A 11803000        	 11090:     move.b  D0,(A0,D3.W)
02:0003CF3E 10342070        	 11091:     move.b  ($70,A4,D2.W),D0
02:0003CF42 19803071        	 11092:     move.b  D0,($71,A4,D3.W)
02:0003CF46 41EC0084        	 11093:     lea     ($0084,A4),A0
02:0003CF4A 10302000        	 11094:     move.b  (A0,D2.W),D0
02:0003CF4E 41EC0085        	 11095:     lea     ($0085,A4),A0
02:0003CF52 11803000        	 11096:     move.b  D0,(A0,D3.W)
                            	 11097:     ; If the tail segment found is a head, then the whole lamnola died.
                            	 11098:     ; So, return and leave it dead.
                            	 11099:     ;
02:0003CF56 0C030004        	 11100:     cmpi.b  #$04,D3
02:0003CF5A 6604            	 11101:     bne.s  __far_z_04_0108
02:0003CF5C 6000FF0C        	 11102:     jmp  L129EA_Exit
                            	 11103: __far_z_04_0108:
02:0003CF60 0C030009        	 11104:     cmpi.b  #$09,D3
02:0003CF64 6604            	 11105:     bne.s  __far_z_04_0109
02:0003CF66 6000FF02        	 11106:     jmp  L129EA_Exit
                            	 11107: __far_z_04_0109:
                            	 11108:     ; Change the tail segment to the dead dummy object, and
                            	 11109:     ; bring the current segment back to life.
                            	 11110:     ;
02:0003CF6A 705D            	 11111:     moveq   #93,D0
02:0003CF6C 41EC0350        	 11112:     lea     ($0350,A4),A0
02:0003CF70 11803000        	 11113:     move.b  D0,(A0,D3.W)
02:0003CF74 4EF90004B58E    	 11114:     jmp     ResetObjMetastate
