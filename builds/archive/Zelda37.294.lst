                            	  5443:     ;
02:0004A372 0C02000D        	  5444:     cmpi.b  #$0D,D2
02:0004A376 641E            	  5445:     bcc  _L_z07_SetAttrAndDrawArrow_PlayerArrow
02:0004A378 41EC034F        	  5446:     lea     ($034F,A4),A0
02:0004A37C 10302000        	  5447:     move.b  (A0,D2.W),D0
02:0004A380 0C00005B        	  5448:     cmpi.b  #$5B,D0
02:0004A384 6610            	  5449:     bne  _L_z07_SetAttrAndDrawArrow_PlayerArrow
02:0004A386 102C0004        	  5450:     move.b  ($0004,A4),D0
02:0004A38A 023C00EE        	  5451:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A38E 123C0002        	  5452:     move.b  #$02,D1
02:0004A392 D101            	  5453:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
