02:00038B24 0C0000F0        	  1757:     cmpi.b  #$F0,D0
02:00038B28 640000BC        	  1758:     bcc  _L_z04_UpdateStatues_NextLoopFireball
                            	  1759:     ; Else choose one of four start times for the fireball based on
                            	  1760:     ; the random value.
