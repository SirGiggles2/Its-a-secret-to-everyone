02:00038FBA 023C00EE        	  2461:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038FBE 12342070        	  2462:     move.b  ($70,A4,D2.W),D1
02:00038FC2 D101            	  2463:     addx.b  D1,D0   ; ADC ObjX,X
