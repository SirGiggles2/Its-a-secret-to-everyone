02:0004141C 1881            	  5060:     move.b  D1,($0000,A4)
02:0004141E 1214            	  5061:     move.b  ($0000,A4),D1
02:00041420 E209            	  5062:     lsr.b  #1,D1   ; LSR $00
02:00041422 1881            	  5063:     move.b  D1,($0000,A4)
02:00041424 1214            	  5064:     move.b  ($0000,A4),D1
02:00041426 E209            	  5065:     lsr.b  #1,D1   ; LSR $00
