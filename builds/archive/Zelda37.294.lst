                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:0003E382 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:0003E386 02000010        	   426:     andi.b #$10,D0
02:0003E38A 6606            	   427:     bne.s  __far_z_05_0000
02:0003E38C 4EF90002DF28    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:0003E392 102C0254        	   430:     move.b  ($0254,A4),D0
02:0003E396 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:0003E398 102C0258        	   432:     move.b  ($0258,A4),D0
02:0003E39C 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:0003E39E 4EB90004898E    	   434:     jsr     HideAllSprites
02:0003E3A4 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:0003E3A6 19400258        	   436:     move.b  D0,($0258,A4)
02:0003E3AA 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:0003E3AC 19400254        	   438:     move.b  D0,($0254,A4)
02:0003E3B0 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:0003E3B4 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003E3B8 4E75            	   441:     rts
