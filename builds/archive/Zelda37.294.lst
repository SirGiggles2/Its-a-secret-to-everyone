02:0003C1AC 6408            	  9308:     bcc  _anon_z04_122
02:0003C1AE 41EC042C        	  9309:     lea     ($042C,A4),A0
02:0003C1B2 53302000        	  9310:     subq.b  #1,(A0,D2.W)
                            	  9311: _anon_z04_122:
                            	  9312:     ; If open eye timer = 0, then the eye is closed.
                            	  9313:     ; Go animate it differently.
