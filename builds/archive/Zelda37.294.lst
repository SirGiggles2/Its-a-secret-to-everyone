                            	  6110: _L_z04_Aquamentus_Move_ApplySpeed:
                            	  6111:     ; Use (direction - 1) to index the speeds.
                            	  6112:     ; This yields 0 for right, 1 for left.
                            	  6113:     ;
02:0003AA2E 7600            	  6114:     moveq   #0,D3
02:0003AA30 41EC0098        	  6115:     lea     ($0098,A4),A0
02:0003AA34 16302000        	  6116:     move.b  (A0,D2.W),D3
02:0003AA38 5303            	  6117:     subq.b  #1,D3
                            	  6118:     ; Add the speed to the X coordinate.
                            	  6119:     ;
02:0003AA3A 10342070        	  6120:     move.b  ($70,A4,D2.W),D0
02:0003AA3E 023C00EE        	  6121:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AA42 41F90003A9AC    	  6122:     lea     (AquamentusSpeeds).l,A0
02:0003AA48 12303000        	  6123:     move.b  (A0,D3.W),D1
02:0003AA4C D101            	  6124:     addx.b  D1,D0   ; ADC AquamentusSpeeds,Y
02:0003AA4E 19802070        	  6125:     move.b  D0,($70,A4,D2.W)
                            	  6126:     ; Decrement the distance remaining.
                            	  6127:     ;
02:0003AA52 41EC0394        	  6128:     lea     ($0394,A4),A0
02:0003AA56 53302000        	  6129:     subq.b  #1,(A0,D2.W)
                            	  6130:     even
