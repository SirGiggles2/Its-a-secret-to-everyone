                            	  3750: PondFairy_MoveHearts:
                            	  3751:     ; Loop over each heart from object slot 2 to 9.
                            	  3752:     ;
                            	  3753:     ; Even though they are not standalone objects, their info
                            	  3754:     ; is stored in those object slots.
                            	  3755:     ;
02:000398BE 7402            	  3756:     moveq   #2,D2
                            	  3757:     even
                            	  3758: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  3759:     ; If the current heart's state <> 0, then go move it.
                            	  3760:     ; Else we have to wait for it to come out at the right time.
                            	  3761:     ;
02:000398C0 41EC00AC        	  3762:     lea     ($00AC,A4),A0
02:000398C4 10302000        	  3763:     move.b  (A0,D2.W),D0
02:000398C8 667C            	  3764:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  3765:     ; The current heart's state = 0.
                            	  3766:     ;
                            	  3767:     ; If object slot = 2, then go make it appear. This is the first
                            	  3768:     ; heart to show up.
                            	  3769:     ;
02:000398CA 0C020002        	  3770:     cmpi.b  #$02,D2
02:000398CE 6732            	  3771:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  3772:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  3773:     ; go start over.
                            	  3774:     ;
                            	  3775:     ; TODO:
                            	  3776:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  3777:     ;
02:000398D0 102C00AE        	  3778:     move.b  ($00AE,A4),D0
02:000398D4 67EA            	  3779:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  3780:     ; Look up the starting angle of this heart with the index
                            	  3781:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  3782:     ; then loop again.
                            	  3783:     ;
02:000398D6 1002            	  3784:     move.b  D2,D0
02:000398D8 003C0011        	  3785:     ori     #$11,CCR  ; SEC: set C+X
02:000398DC 123C0003        	  3786:     move.b  #$03,D1
02:000398E0 0A3C0010        	  3787:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000398E4 9101            	  3788:     subx.b  D1,D0   ; SBC #$03
02:000398E6 0A3C0010        	  3789:     eori    #$10,CCR  ; restore X = 6502 C
02:000398EA 7600            	  3790:     moveq   #0,D3
02:000398EC 1600            	  3791:     move.b  D0,D3
02:000398EE 102C0396        	  3792:     move.b  ($0396,A4),D0
02:000398F2 41F9000398B6    	  3793:     lea     (PondHeartStartAngles).l,A0
02:000398F8 12303000        	  3794:     move.b  (A0,D3.W),D1
02:000398FC B001            	  3795:     cmp.b   D1,D0
02:000398FE 66000086        	  3796:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  3797:     even
