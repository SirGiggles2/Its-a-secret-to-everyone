                            	  5827: CalcBoomerangFrame:
                            	  5828:     ; The minor state (low 3 bits of state) is used to
                            	  5829:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5830:     ;
                            	  5831:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5832:     ; In other words, don't offset the coordinate below.
                            	  5833:     ;
02:0004A632 7000            	  5834:     moveq   #0,D0
02:0004A634 1880            	  5835:     move.b  D0,($0000,A4)
02:0004A636 41EC00AC        	  5836:     lea     ($00AC,A4),A0
02:0004A63A 10302000        	  5837:     move.b  (A0,D2.W),D0
02:0004A63E 0200000F        	  5838:     andi.b #$0F,D0
02:0004A642 7600            	  5839:     moveq   #0,D3
02:0004A644 1600            	  5840:     move.b  D0,D3
02:0004A646 7000            	  5841:     moveq   #0,D0
