                            	  7750:     ; decrement the distance remaining, and move.
                            	  7751:     ;
02:0003B600 41EC0394        	  7752:     lea     ($0394,A4),A0
02:0003B604 10302000        	  7753:     move.b  (A0,D2.W),D0
02:0003B608 670A            	  7754:     beq  _L_z04_BlueWizzrobe_WalkOrTeleport_WalkAgain
02:0003B60A 41EC0394        	  7755:     lea     ($0394,A4),A0
