02:0003A746 41EC0437        	  5755:     lea     ($0437,A4),A0
02:0003A74A 12302000        	  5756:     move.b  (A0,D2.W),D1
02:0003A74E B001            	  5757:     cmp.b   D1,D0
02:0003A750 6704            	  5758:     beq.s  __far_z_04_0051
02:0003A752 6000009E        	  5759:     jmp  L116EA_Exit
                            	  5760: __far_z_04_0051:
02:0003A756 41EC042C        	  5761:     lea     ($042C,A4),A0
02:0003A75A 10302000        	  5762:     move.b  (A0,D2.W),D0
02:0003A75E 41EC0444        	  5763:     lea     ($0444,A4),A0
02:0003A762 12302000        	  5764:     move.b  (A0,D2.W),D1
02:0003A766 B001            	  5765:     cmp.b   D1,D0
02:0003A768 6704            	  5766:     beq.s  __far_z_04_0052
02:0003A76A 60000086        	  5767:     jmp  L116EA_Exit
