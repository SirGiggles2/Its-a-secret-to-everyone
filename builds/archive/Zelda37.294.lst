02:0003C116 19410002        	  9237:     move.b  D1,($0002,A4)
02:0003C11A 122C0002        	  9238:     move.b  ($0002,A4),D1
02:0003C11E C200            	  9239:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C120 6708            	  9240:     beq  _anon_z04_120
02:0003C122 41EC0084        	  9241:     lea     ($0084,A4),A0
02:0003C126 52302000        	  9242:     addq.b  #1,(A0,D2.W)
                            	  9243: _anon_z04_120:
