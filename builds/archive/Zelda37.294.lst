02:0003D352 7070            	 11678:     moveq   #112,D0
02:0003D354 7600            	 11679:     moveq   #0,D3
02:0003D356 41EC034F        	 11680:     lea     ($034F,A4),A0
02:0003D35A 16302000        	 11681:     move.b  (A0,D2.W),D3
02:0003D35E 0C030025        	 11682:     cmpi.b  #$25,D3
02:0003D362 6702            	 11683:     beq  _anon_z04_159
02:0003D364 7060            	 11684:     moveq   #96,D0
                            	 11685: _anon_z04_159:
02:0003D366 61000D98        	 11686:     jsr     DecreaseObjectAngle
                            	 11687:     ; Load Patra's maneuver index.
                            	 11688:     ; It determines which counts of bits are looked up below.
                            	 11689:     ;
02:0003D36A 7600            	 11690:     moveq   #0,D3
02:0003D36C 162C045F        	 11691:     move.b  ($045F,A4),D3
                            	 11692:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 11693:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 11694:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 11695:     ;
02:0003D370 41EC034F        	 11696:     lea     ($034F,A4),A0
02:0003D374 10302000        	 11697:     move.b  (A0,D2.W),D0
02:0003D378 0C000025        	 11698:     cmpi.b  #$25,D0
02:0003D37C 661E            	 11699:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003D37E 41F90003D270    	 11700:     lea     (PatraChild1RotationCosineBits).l,A0
02:0003D384 10303000        	 11701:     move.b  (A0,D3.W),D0
02:0003D388 1B00            	 11702:     move.b  D0,-(A5)  ; PHA
02:0003D38A 41F90003D274    	 11703:     lea     (PatraChild1RotationSineBits).l,A0
02:0003D390 10303000        	 11704:     move.b  (A0,D3.W),D0
02:0003D394 7600            	 11705:     moveq   #0,D3
02:0003D396 1600            	 11706:     move.b  D0,D3
02:0003D398 101D            	 11707:     move.b  (A5)+,D0  ; PLA
02:0003D39A 600E            	 11708:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 11709: 
                            	 11710:     even
                            	 11711: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 11712:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 11713:     ; for both Y and X increment calculations in rotation. This leads to
                            	 11714:     ; a small circle (5) and a large circle (6).
                            	 11715:     ;
02:0003D39C 41F90003D272    	 11716:     lea     (PatraChild2RotationBits).l,A0
02:0003D3A2 10303000        	 11717:     move.b  (A0,D3.W),D0
02:0003D3A6 7600            	 11718:     moveq   #0,D3
02:0003D3A8 1600            	 11719:     move.b  D0,D3
                            	 11720:     even
                            	 11721: _L_z04_PatraChild_State1_Rotate:
02:0003D3AA 61000BA4        	 11722:     jsr     RotateObjectLocation
02:0003D3AE 41EC0084        	 11723:     lea     ($0084,A4),A0
02:0003D3B2 11802000        	 11724:     move.b  D0,(A0,D2.W)
02:0003D3B6 611C            	 11725:     jsr     PatraChild_Draw
                            	 11726:     ; If Patra's state still = 0, then the last patra child has not
                            	 11727:     ; shown up yet. In this case don't check collisions yet, only return.
                            	 11728:     ;
02:0003D3B8 102C00AD        	 11729:     move.b  ($00AD,A4),D0
02:0003D3BC 6714            	 11730:     beq  _L_z04_PatraChild_State1_Exit
02:0003D3BE 4EB900030BE6    	 11731:     jsr     CheckMonsterCollisions
                            	 11732:     ; If the monster died, then change to the dead dummy object.
                            	 11733:     ;
