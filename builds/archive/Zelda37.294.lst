                            	  1775:     ;
                            	  1776:     ; Pattern
02:00038B46 7600            	  1777:     moveq   #0,D3
02:00038B48 162C000B        	  1778:     move.b  ($000B,A4),D3
02:00038B4C 1002            	  1779:     move.b  D2,D0
02:00038B4E 023C00EE        	  1780:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038B52 41F900038A94    	  1781:     lea     (StatuePatternToBasePositionIndex).l,A0
02:00038B58 12303000        	  1782:     move.b  (A0,D3.W),D1
