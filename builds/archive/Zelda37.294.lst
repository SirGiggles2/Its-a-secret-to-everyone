                            	  8988: Manhandla_Move:
                            	  8989:     ; Implement a way of manifesting the fractional part of the speed
                            	  8990:     ; in the movement.
                            	  8991:     ;
                            	  8992:     ; Let's say the 16-bit speed is $0140. If we only took the high
                            	  8993:     ; byte to add to the coordinates, then the effective speed would
                            	  8994:     ; be 1 pixel a frame instead of 1.25.
                            	  8995:     ;
                            	  8996:     ; By keeping a speed accumulator, we can turn speed $0140
                            	  8997:     ; into 1.25 pixels a frame over four frames, using this calculation:
                            	  8998:     ;
                            	  8999:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  9000:     ;
                            	  9001:     ;   SA := SA + (SL AND $E0)
                            	  9002:     ;   [03] := SH + carry
                            	  9003:     ;
                            	  9004:     ; AND'ing the low speed byte with $E0 isn't strictly needed.
                            	  9005:     ;
02:0003BF16 41EC041F        	  9006:     lea     ($041F,A4),A0
02:0003BF1A 10302000        	  9007:     move.b  (A0,D2.W),D0
02:0003BF1E 020000E0        	  9008:     andi.b #$E0,D0
02:0003BF22 023C00EE        	  9009:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF26 41EC0412        	  9010:     lea     ($0412,A4),A0
02:0003BF2A 12302000        	  9011:     move.b  (A0,D2.W),D1
02:0003BF2E D101            	  9012:     addx.b  D1,D0   ; ADC Manhandla_ObjSpeedAccum,X
02:0003BF30 41EC0412        	  9013:     lea     ($0412,A4),A0
02:0003BF34 11802000        	  9014:     move.b  D0,(A0,D2.W)
                            	  9015:     ; Assign (high speed byte + carry) to [03].
                            	  9016:     ;
02:0003BF38 41EC042C        	  9017:     lea     ($042C,A4),A0
02:0003BF3C 10302000        	  9018:     move.b  (A0,D2.W),D0
02:0003BF40 123C0000        	  9019:     move.b  #$00,D1
02:0003BF44 D101            	  9020:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003BF46 19400003        	  9021:     move.b  D0,($0003,A4)
                            	  9022:     ; Change coordinates by the speed amount/offset in [03]
                            	  9023:     ; according to the direction.
                            	  9024:     ;
                            	  9025:     ; Start with a mask of $A1 in [02]:
                            	  9026:     ; - low nibble represents the right direction
                            	  9027:     ; - high nibble is used to set or clear carry as we go along
                            	  9028:     ;
02:0003BF4A 103C00A1        	  9029:     move.b  #$A1,D0
02:0003BF4E 19400002        	  9030:     move.b  D0,($0002,A4)
                            	  9031:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  9032:     ;
02:0003BF52 41EC0098        	  9033:     lea     ($0098,A4),A0
02:0003BF56 10302000        	  9034:     move.b  (A0,D2.W),D0
02:0003BF5A 122C0002        	  9035:     move.b  ($0002,A4),D1
02:0003BF5E C200            	  9036:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BF60 6712            	  9037:     beq  _L_z04_Manhandla_Move_Left
02:0003BF62 10342070        	  9038:     move.b  ($70,A4,D2.W),D0
02:0003BF66 023C00EE        	  9039:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BF6A 122C0003        	  9040:     move.b  ($0003,A4),D1
02:0003BF6E D101            	  9041:     addx.b  D1,D0   ; ADC $03
02:0003BF70 19802070        	  9042:     move.b  D0,($70,A4,D2.W)
                            	  9043:     even
                            	  9044: _L_z04_Manhandla_Move_Left:
                            	  9045:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  9046:     ;
02:0003BF74 41EC0098        	  9047:     lea     ($0098,A4),A0
02:0003BF78 10302000        	  9048:     move.b  (A0,D2.W),D0
02:0003BF7C 122C0002        	  9049:     move.b  ($0002,A4),D1
02:0003BF80 E309            	  9050:     lsl.b  #1,D1   ; ASL $02
02:0003BF82 19410002        	  9051:     move.b  D1,($0002,A4)
02:0003BF86 122C0002        	  9052:     move.b  ($0002,A4),D1
02:0003BF8A C200            	  9053:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BF8C 6716            	  9054:     beq  _L_z04_Manhandla_Move_Down
02:0003BF8E 10342070        	  9055:     move.b  ($70,A4,D2.W),D0
02:0003BF92 122C0003        	  9056:     move.b  ($0003,A4),D1
02:0003BF96 0A3C0010        	  9057:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BF9A 9101            	  9058:     subx.b  D1,D0   ; SBC $03
02:0003BF9C 0A3C0010        	  9059:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BFA0 19802070        	  9060:     move.b  D0,($70,A4,D2.W)
                            	  9061:     even
                            	  9062: _L_z04_Manhandla_Move_Down:
                            	  9063:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  9064:     ;
02:0003BFA4 41EC0098        	  9065:     lea     ($0098,A4),A0
02:0003BFA8 10302000        	  9066:     move.b  (A0,D2.W),D0
02:0003BFAC 122C0002        	  9067:     move.b  ($0002,A4),D1
02:0003BFB0 E309            	  9068:     lsl.b  #1,D1   ; ASL $02
02:0003BFB2 19410002        	  9069:     move.b  D1,($0002,A4)
02:0003BFB6 122C0002        	  9070:     move.b  ($0002,A4),D1
02:0003BFBA C200            	  9071:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BFBC 6716            	  9072:     beq  _L_z04_Manhandla_Move_Up
02:0003BFBE 41EC0084        	  9073:     lea     ($0084,A4),A0
02:0003BFC2 10302000        	  9074:     move.b  (A0,D2.W),D0
02:0003BFC6 122C0003        	  9075:     move.b  ($0003,A4),D1
02:0003BFCA D101            	  9076:     addx.b  D1,D0   ; ADC $03
02:0003BFCC 41EC0084        	  9077:     lea     ($0084,A4),A0
02:0003BFD0 11802000        	  9078:     move.b  D0,(A0,D2.W)
                            	  9079:     even
                            	  9080: _L_z04_Manhandla_Move_Up:
                            	  9081:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  9082:     ;
02:0003BFD4 41EC0098        	  9083:     lea     ($0098,A4),A0
02:0003BFD8 10302000        	  9084:     move.b  (A0,D2.W),D0
02:0003BFDC 122C0002        	  9085:     move.b  ($0002,A4),D1
02:0003BFE0 E309            	  9086:     lsl.b  #1,D1   ; ASL $02
02:0003BFE2 19410002        	  9087:     move.b  D1,($0002,A4)
02:0003BFE6 122C0002        	  9088:     move.b  ($0002,A4),D1
02:0003BFEA C200            	  9089:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003BFEC 671E            	  9090:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003BFEE 41EC0084        	  9091:     lea     ($0084,A4),A0
02:0003BFF2 10302000        	  9092:     move.b  (A0,D2.W),D0
02:0003BFF6 122C0003        	  9093:     move.b  ($0003,A4),D1
02:0003BFFA 0A3C0010        	  9094:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BFFE 9101            	  9095:     subx.b  D1,D0   ; SBC $03
02:0003C000 0A3C0010        	  9096:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C004 41EC0084        	  9097:     lea     ($0084,A4),A0
02:0003C008 11802000        	  9098:     move.b  D0,(A0,D2.W)
                            	  9099:     even
                            	  9100: _L_z04_Manhandla_Move_IncFrameAccum:
                            	  9101:     ; To the frame accumulator, add:
                            	  9102:     ; - a random value between 0 and 3
                            	  9103:     ; - [03] the effective high speed byte calculated for this screen frame
                            	  9104:     ;
02:0003C00C 10342019        	  9105:     move.b  ($19,A4,D2.W),D0
02:0003C010 02000003        	  9106:     andi.b #$03,D0
02:0003C014 023C00EE        	  9107:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C018 122C0003        	  9108:     move.b  ($0003,A4),D1
02:0003C01C D101            	  9109:     addx.b  D1,D0   ; ADC $03
02:0003C01E 41EC0451        	  9110:     lea     ($0451,A4),A0
02:0003C022 12302000        	  9111:     move.b  (A0,D2.W),D1
02:0003C026 D101            	  9112:     addx.b  D1,D0   ; ADC Manhandla_ObjFrameAccum,X
02:0003C028 41EC0451        	  9113:     lea     ($0451,A4),A0
02:0003C02C 11802000        	  9114:     move.b  D0,(A0,D2.W)
02:0003C030 61001D5C        	  9115:     jsr     BoundFlyer
                            	  9116:     ; TODO:
                            	  9117:     ; I don't see why this is needed.
                            	  9118:     ;
02:0003C034 4EF90004AD8E    	  9119:     jmp     Anim_FetchObjPosForSpriteDescriptor
