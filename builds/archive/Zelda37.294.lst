                            	  5961: Digdogger_Draw:
02:0003A8FC 7006            	  5962:     moveq   #6,D0
02:0003A8FE 4EB90004AD88    	  5963:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5964:     ; If this is a child digdogger, then go draw it.
                            	  5965:     ;
02:0003A904 41EC046B        	  5966:     lea     ($046B,A4),A0
02:0003A908 10302000        	  5967:     move.b  (A0,D2.W),D0
02:0003A90C 666C            	  5968:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  5969:     ; For each part of the big digdogger, from 0 to 3,
                            	  5970:     ; indexed by Y register:
                            	  5971:     ;
02:0003A90E 7600            	  5972:     moveq   #0,D3
                            	  5973:     even
                            	  5974: _L_z04_Digdogger_Draw_LoopPart:
                            	  5975:     ; Store in [00] the X coordinate offset for the current corner.
                            	  5976:     ;
02:0003A910 10342070        	  5977:     move.b  ($70,A4,D2.W),D0
02:0003A914 023C00EE        	  5978:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A918 41F90003A8F0    	  5979:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0003A91E 12303000        	  5980:     move.b  (A0,D3.W),D1
02:0003A922 D101            	  5981:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0003A924 1880            	  5982:     move.b  D0,($0000,A4)
                            	  5983:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  5984:     ;
02:0003A926 41EC0084        	  5985:     lea     ($0084,A4),A0
02:0003A92A 10302000        	  5986:     move.b  (A0,D2.W),D0
02:0003A92E 023C00EE        	  5987:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A932 41F90003A8F4    	  5988:     lea     (DigdoggerSpriteOffsetsY).l,A0
02:0003A938 12303000        	  5989:     move.b  (A0,D3.W),D1
02:0003A93C D101            	  5990:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsY,Y
02:0003A93E 19400001        	  5991:     move.b  D0,($0001,A4)
                            	  5992:     ; Load and set the sprite attributes for this part.
                            	  5993:     ; Vertical flipping is set appropriately here.
                            	  5994:     ;
02:0003A942 41F90003A8F8    	  5995:     lea     (DigdoggerSpriteAttrs).l,A0
02:0003A948 10303000        	  5996:     move.b  (A0,D3.W),D0
02:0003A94C 4EB900030B6C    	  5997:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003A952 1003            	  5998:     move.b  D3,D0
02:0003A954 1B00            	  5999:     move.b  D0,-(A5)  ; PHA
                            	  6000:     ; Parts at odd indexes are flipped horizontally.
                            	  6001:     ;
02:0003A956 02000001        	  6002:     andi.b #$01,D0
02:0003A95A 1940000F        	  6003:     move.b  D0,($000F,A4)
02:0003A95E 7000            	  6004:     moveq   #0,D0
02:0003A960 4EB90003087A    	  6005:     jsr     DrawObjectNotMirrored
02:0003A966 101D            	  6006:     move.b  (A5)+,D0  ; PLA
02:0003A968 7600            	  6007:     moveq   #0,D3
02:0003A96A 1600            	  6008:     move.b  D0,D3
                            	  6009:     ; Bottom of the loop.
                            	  6010:     ; Increment Y register until = 4.
                            	  6011:     ;
02:0003A96C 5203            	  6012:     addq.b  #1,D3
02:0003A96E 0C030004        	  6013:     cmpi.b  #$04,D3
02:0003A972 669C            	  6014:     bne  _L_z04_Digdogger_Draw_LoopPart
02:0003A974 0A3C0001        	  6015:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003A978 4E75            	  6016:     rts
