                            	  2608: _L_z02_ModeE_HandleAOrB_MoveCursor:
02:00033630 102C0070        	  2609:     move.b  ($0070,A4),D0
02:00033634 023C00EE        	  2610:     andi    #$EE,CCR  ; CLC: clear C+X
02:00033638 123C0008        	  2611:     move.b  #$08,D1
02:0003363C D101            	  2612:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003363E 19400070        	  2613:     move.b  D0,($0070,A4)
02:00033642 522C0421        	  2614:     addq.b  #1,($0421,A4)
02:00033646 522C0423        	  2615:     addq.b  #1,($0423,A4)
                            	  2616:     ; If VRAM address still points inside the name field,
                            	  2617:     ; then go finish.
                            	  2618:     ;
                            	  2619:     ; The idea is that each name field in nametable begins at
                            	  2620:     ; an address ending in $E. For example, slot 0 has a name
                            	  2621:     ; at VRAM addresses $20CE to $20D5.
                            	  2622:     ;
                            	  2623:     ; Once the $E becomes a 6, we've gone past the end of
                            	  2624:     ; the name field.
                            	  2625:     ;
                            	  2626:     ; Keep in mind that [0423] is the second byte of the transfer
                            	  2627:     ; record header.
                            	  2628:     ;
02:0003364A 102C0070        	  2629:     move.b  ($0070,A4),D0      ; PATCH P14: Zelda16.11
02:0003364E 0C0000B0        	  2630:     cmpi.b  #$B0,D0
02:00033652 6678            	  2631:     bne  _L_z02_ModeE_HandleAOrB_Exit
                            	  2632:     ; The VRAM address now points outside the name field.
                            	  2633:     ; So, wrap around to the beginning of the name field.
                            	  2634:     ;
                            	  2635:     ; For example, $20D6 -> $20CE.
                            	  2636:     ;
02:00033654 102C0423        	  2637:     move.b  ($0423,A4),D0
02:00033658 003C0011        	  2638:     ori     #$11,CCR  ; SEC: set C+X
02:0003365C 123C0008        	  2639:     move.b  #$08,D1
02:00033660 0A3C0010        	  2640:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00033664 9101            	  2641:     subx.b  D1,D0   ; SBC #$08
02:00033666 0A3C0010        	  2642:     eori    #$10,CCR  ; restore X = 6502 C
02:0003366A 19400423        	  2643:     move.b  D0,($0423,A4)
                            	  2644:     ; It also means that we went past the end of the save slot
                            	  2645:     ; info name. Set the offset to the beginning of the name.
02:0003366E 7600            	  2646:     moveq   #0,D3
02:00033670 162C0016        	  2647:     move.b  ($0016,A4),D3
02:00033674 41F900032FB6    	  2648:     lea     (SlotToNameOffset).l,A0
02:0003367A 10303000        	  2649:     move.b  (A0,D3.W),D0
02:0003367E 19400421        	  2650:     move.b  D0,($0421,A4)
                            	  2651:     ; If the name cursor has gone past the end of the field,
                            	  2652:     ; then wrap around.
02:00033682 102C0070        	  2653:     move.b  ($0070,A4),D0
02:00033686 0C0000B0        	  2654:     cmpi.b  #$B0,D0
02:0003368A 6640            	  2655:     bne  _L_z02_ModeE_HandleAOrB_Exit
02:0003368C 7070            	  2656:     moveq   #112,D0
02:0003368E 19400070        	  2657:     move.b  D0,($0070,A4)
                            	  2658:     even
                            	  2659: ; PATCH P25b: FS2-E backspace handler.
                            	  2660: ; Entered when bit $40 (B) is set in $00F8 & $C0. Decrements
                            	  2661: ; NameCharOffset, VRAM low byte, and name cursor sprite X by
                            	  2662: ; one column (8 px), and writes a space ($24) to the erased
                            	  2663: ; position. Clamps at SlotToNameOffset[$0016] so the backspace
                            	  2664: ; cannot cross into a previous slot's name field.
                            	  2665: _L_z02_ModeE_HandleAOrB_Backspace:
02:00033692 7600            	  2666:     moveq   #0,D3
02:00033694 162C0016        	  2667:     move.b  ($0016,A4),D3        ; D3 = current slot
02:00033698 41F900032FB6    	  2668:     lea     (SlotToNameOffset).l,A0
02:0003369E 12303000        	  2669:     move.b  (A0,D3.W),D1         ; D1 = slot start offset
02:000336A2 102C0421        	  2670:     move.b  ($0421,A4),D0        ; D0 = current NameCharOffset
02:000336A6 B001            	  2671:     cmp.b   D1,D0
02:000336A8 6322            	  2672:     bls     _L_z02_ModeE_HandleAOrB_Exit   ; at/below start, no-op
02:000336AA 5300            	  2673:     subq.b  #1,D0
02:000336AC 19400421        	  2674:     move.b  D0,($0421,A4)        ; NameCharOffset -= 1
02:000336B0 532C0423        	  2675:     subq.b  #1,($0423,A4)        ; VRAM low byte -= 1
02:000336B4 122C0070        	  2676:     move.b  ($0070,A4),D1
02:000336B8 5101            	  2677:     subi.b  #8,D1
02:000336BA 19410070        	  2678:     move.b  D1,($0070,A4)        ; name cursor X -= 8
02:000336BE 7224            	  2679:     moveq   #$24,D1              ; space tile
02:000336C0 7600            	  2680:     moveq   #0,D3
02:000336C2 1600            	  2681:     move.b  D0,D3                ; D3 = erased offset
02:000336C4 41EC0638        	  2682:     lea     ($0638,A4),A0
02:000336C8 11813000        	  2683:     move.b  D1,(A0,D3.W)         ; namebuf[offset] = space
                            	  2684:     jmp     _L_z02_ModeE_HandleAOrB_Exit
                            	  2685:     even
