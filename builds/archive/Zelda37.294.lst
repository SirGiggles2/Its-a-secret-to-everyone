02:00034DA6 162C0413        	  4892:     move.b  ($0413,A4),D3
02:00034DAA 41F900034D44    	  4893:     lea     (PeaceText).l,A0
02:00034DB0 10303000        	  4894:     move.b  (A0,D3.W),D0
02:00034DB4 0C0000FF        	  4895:     cmpi.b  #$FF,D0
02:00034DB8 6730            	  4896:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034DBA 19400305        	  4897:     move.b  D0,($0305,A4)
