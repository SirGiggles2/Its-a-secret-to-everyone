                            	  2405:     ; Keep the object inside the bounds of the room.
                            	  2406:     ;
02:00038F50 61004E3C        	  2407:     jsr     BoundFlyer
                            	  2408:     ; If the object was blocked at the room boundary, then
                            	  2409:     ; increase boundary reversal count, and go set up another jump.
                            	  2410:     ;
02:00038F54 102C000F        	  2411:     move.b  ($000F,A4),D0
02:00038F58 660C            	  2412:     bne  _anon_z04_37
02:00038F5A 41EC0451        	  2413:     lea     ($0451,A4),A0
02:00038F5E 52302000        	  2414:     addq.b  #1,(A0,D2.W)
02:00038F62 6000FF74        	  2415:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2416: 
                            	  2417: _anon_z04_37:
02:00038F66 61000196        	  2418:     jsr     Jumper_PointBoulderDownward
                            	  2419:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2420:     ;
02:00038F6A 7000            	  2421:     moveq   #0,D0
02:00038F6C 41EC0451        	  2422:     lea     ($0451,A4),A0
02:00038F70 11802000        	  2423:     move.b  D0,(A0,D2.W)
                            	  2424:     ; Get the base offset for the kind of jumper the object is.
                            	  2425:     ;
02:00038F74 6100015E        	  2426:     jsr     Jumper_GetKind
02:00038F78 41F900038E64    	  2427:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:00038F7E 10303000        	  2428:     move.b  (A0,D3.W),D0
                            	  2429:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2430:     ;
                            	  2431:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2432:     ; does not have $B elements like the tektites' sets.
                            	  2433:     ;
                            	  2434:     ; Boulder does not need the upward accelerations.
                            	  2435:     ; So, the elements for those are used for the starting speeds
                            	  2436:     ; at 04:88F2.
                            	  2437:     ;
02:00038F82 023C00EE        	  2438:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038F86 41EC0098        	  2439:     lea     ($0098,A4),A0
02:00038F8A 12302000        	  2440:     move.b  (A0,D2.W),D1
02:00038F8E D101            	  2441:     addx.b  D1,D0   ; ADC ObjDir,X
02:00038F90 7600            	  2442:     moveq   #0,D3
02:00038F92 1600            	  2443:     move.b  D0,D3
02:00038F94 41F900038E42    	  2444:     lea     (JumperYAccelerations).l,A0
02:00038F9A 10303000        	  2445:     move.b  (A0,D3.W),D0
02:00038F9E 7602            	  2446:     moveq   #2,D3
02:00038FA0 61000162        	  2447:     jsr     Jumper_MoveY
                            	  2448:     ; If the facing direction has a left component, then
                            	  2449:     ; subtract 1 from the object's X.
