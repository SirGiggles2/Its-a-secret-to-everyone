                            	  9159:     even
                            	  9160: UpdateGohma:
                            	  9161:     ; If flagged not to continue straight, then choose a random facing direction.
                            	  9162:     ;
02:0003C084 41EC0451        	  9163:     lea     ($0451,A4),A0
02:0003C088 10302000        	  9164:     move.b  (A0,D2.W),D0
02:0003C08C 662C            	  9165:     bne  _L_z04_UpdateGohma_Move
                            	  9166:     ; If Random:
                            	  9167:     ;   >= $B0: right
                            	  9168:     ;   >= $60: left
                            	  9169:     ;   Else:   down
                            	  9170:     ;
02:0003C08E 7001            	  9171:     moveq   #1,D0
02:0003C090 7600            	  9172:     moveq   #0,D3
02:0003C092 16342018        	  9173:     move.b  ($18,A4,D2.W),D3
02:0003C096 0C0300B0        	  9174:     cmpi.b  #$B0,D3
02:0003C09A 640A            	  9175:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003C09C E308            	  9176:     lsl.b  #1,D0   ; ASL A
02:0003C09E 0C030060        	  9177:     cmpi.b  #$60,D3
02:0003C0A2 6402            	  9178:     bcc  _L_z04_UpdateGohma_ChangeDir
02:0003C0A4 E308            	  9179:     lsl.b  #1,D0   ; ASL A
                            	  9180:     even
                            	  9181: _L_z04_UpdateGohma_ChangeDir:
02:0003C0A6 41EC0098        	  9182:     lea     ($0098,A4),A0
02:0003C0AA 11802000        	  9183:     move.b  D0,(A0,D2.W)
                            	  9184:     ; Now we can go straight without changing direction for some time.
                            	  9185:     ;
02:0003C0AE 41EC0451        	  9186:     lea     ($0451,A4),A0
02:0003C0B2 52302000        	  9187:     addq.b  #1,(A0,D2.W)
                            	  9188:     ; Go animate the eye.
                            	  9189:     ;
02:0003C0B6 600000C6        	  9190:     jmp     _L_z04_UpdateGohma_AnimateEye
                            	  9191: 
                            	  9192:     even
                            	  9193: _L_z04_UpdateGohma_Move:
                            	  9194:     ; Add $80 to the movement accumulator.
                            	  9195:     ;
02:0003C0BA 41EC041F        	  9196:     lea     ($041F,A4),A0
02:0003C0BE 10302000        	  9197:     move.b  (A0,D2.W),D0
02:0003C0C2 023C00EE        	  9198:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C0C6 123C0080        	  9199:     move.b  #$80,D1
02:0003C0CA D101            	  9200:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:0003C0CC 41EC041F        	  9201:     lea     ($041F,A4),A0
02:0003C0D0 11802000        	  9202:     move.b  D0,(A0,D2.W)
                            	  9203:     ; If movement accumulator didn't overflow, then go animate the eye.
                            	  9204:     ;
02:0003C0D4 640000A8        	  9205:     bcc  _L_z04_UpdateGohma_AnimateEye
                            	  9206:     ; Increase the distance traveled, and move 1.
                            	  9207:     ;
02:0003C0D8 41EC0412        	  9208:     lea     ($0412,A4),A0
02:0003C0DC 52302000        	  9209:     addq.b  #1,(A0,D2.W)
                            	  9210:     ; Set a direction mask in [02], starting with right (1).
                            	  9211:     ;
02:0003C0E0 7001            	  9212:     moveq   #1,D0
02:0003C0E2 19400002        	  9213:     move.b  D0,($0002,A4)
                            	  9214:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9215:     ;
02:0003C0E6 41EC0098        	  9216:     lea     ($0098,A4),A0
02:0003C0EA 10302000        	  9217:     move.b  (A0,D2.W),D0
02:0003C0EE 122C0002        	  9218:     move.b  ($0002,A4),D1
02:0003C0F2 C200            	  9219:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C0F4 6704            	  9220:     beq  _anon_z04_118
02:0003C0F6 52342070        	  9221:     addq.b  #1,($70,A4,D2.W)
                            	  9222: _anon_z04_118:
