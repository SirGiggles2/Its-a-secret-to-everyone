02:0003D2E4 102C0071        	 11626:     move.b  ($0071,A4),D0
02:0003D2E8 19802070        	 11627:     move.b  D0,($70,A4,D2.W)
                            	 11628:     ; If patra child type = $25, then the radius of its orbit is $2C.
                            	 11629:     ; Else use radius $18. Store the chosen value in [00].
                            	 11630:     ;
02:0003D2EC 702C            	 11631:     moveq   #44,D0
02:0003D2EE 7600            	 11632:     moveq   #0,D3
02:0003D2F0 41EC034F        	 11633:     lea     ($034F,A4),A0
02:0003D2F4 16302000        	 11634:     move.b  (A0,D2.W),D3
02:0003D2F8 0C030025        	 11635:     cmpi.b  #$25,D3
02:0003D2FC 6702            	 11636:     beq  _anon_z04_158
02:0003D2FE 7018            	 11637:     moveq   #24,D0
                            	 11638: _anon_z04_158:
02:0003D300 1880            	 11639:     move.b  D0,($0000,A4)
                            	 11640:     ; This location is right above Patra.
