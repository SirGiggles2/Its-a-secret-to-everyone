02:0004A182 123C0001        	  5145:     move.b  #$01,D1
02:0004A186 D101            	  5146:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004A188 19803000        	  5147:     move.b  D0,($00,A4,D3.W)
                            	  5148:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5149:     ;
02:0004A18C 101D            	  5150:     move.b  (A5)+,D0  ; PLA
02:0004A18E 7600            	  5151:     moveq   #0,D3
02:0004A190 1600            	  5152:     move.b  D0,D3
