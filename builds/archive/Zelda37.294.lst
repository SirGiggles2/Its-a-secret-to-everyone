02:0003DE9A 1600            	 13327:     move.b  D0,D3
02:0003DE9C 41F90003DCB0    	 13328:     lea     (Directions8).l,A0
02:0003DEA2 10303000        	 13329:     move.b  (A0,D3.W),D0
02:0003DEA6 1214            	 13330:     move.b  ($0000,A4),D1
