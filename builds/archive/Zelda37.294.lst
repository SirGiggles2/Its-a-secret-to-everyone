                            	  6367: UpdateDodongoState0_Move:
                            	  6368:     ; If facing left, then push X offset 0 on the stack.
                            	  6369:     ; Else push X offset -$10, and add $10 to X coordinate.
                            	  6370:     ;
                            	  6371:     ; We would like to use one set of coordinates only.
                            	  6372:     ; But movement would break down, if we did; because
                            	  6373:     ; Dodongo is so long.
                            	  6374:     ;
                            	  6375:     ; So, when not facing left, we temporarily shift the
                            	  6376:     ; X coordinate to be closer to the other side of the monster.
                            	  6377:     ;
02:0003ABFA 7600            	  6378:     moveq   #0,D3
02:0003ABFC 41EC0098        	  6379:     lea     ($0098,A4),A0
02:0003AC00 10302000        	  6380:     move.b  (A0,D2.W),D0
02:0003AC04 0200000D        	  6381:     andi.b #$0D,D0
02:0003AC08 6716            	  6382:     beq  _L_z04_UpdateDodongoState0_Move_Move
02:0003AC0A 10342070        	  6383:     move.b  ($70,A4,D2.W),D0
02:0003AC0E 023C00EE        	  6384:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AC12 123C0010        	  6385:     move.b  #$10,D1
02:0003AC16 D101            	  6386:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003AC18 19802070        	  6387:     move.b  D0,($70,A4,D2.W)
02:0003AC1C 163C00F0        	  6388:     move.b  #$F0,D3
                            	  6389:     even
                            	  6390: _L_z04_UpdateDodongoState0_Move_Move:
02:0003AC20 1003            	  6391:     move.b  D3,D0
