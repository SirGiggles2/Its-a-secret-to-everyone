                            	  3687: FindNextEdgeSpawnCell:
                            	  3688:     ; Load [0A] with the value before the call.
                            	  3689:     ;
02:0003FF94 102C0525        	  3690:     move.b  ($0525,A4),D0
02:0003FF98 1940000A        	  3691:     move.b  D0,($000A,A4)
                            	  3692:     even
                            	  3693: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3694:     ; Loop to look for a place to spawn a monster from the edge
                            	  3695:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3696:     ;
                            	  3697:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3698:     ; We'll move down $10 pixels.
                            	  3699:     ;
02:0003FF9C 7610            	  3700:     moveq   #16,D3
02:0003FF9E 102C000A        	  3701:     move.b  ($000A,A4),D0
02:0003FFA2 0200000F        	  3702:     andi.b #$0F,D0
02:0003FFA6 670A            	  3703:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3704:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3705:     ; Don't move vertically.
                            	  3706:     ;
02:0003FFA8 163C00F0        	  3707:     move.b  #$F0,D3
02:0003FFAC 0C00000F        	  3708:     cmpi.b  #$0F,D0
02:0003FFB0 6610            	  3709:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3710:     even
                            	  3711: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3712:     ; Else low nibble = $F. We're at the right edge,
                            	  3713:     ; and we'll move up $10 pixels.
                            	  3714:     ;
02:0003FFB2 1003            	  3715:     move.b  D3,D0
02:0003FFB4 023C00EE        	  3716:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003FFB8 122C000A        	  3717:     move.b  ($000A,A4),D1
02:0003FFBC D101            	  3718:     addx.b  D1,D0   ; ADC $0A
02:0003FFBE 1940000A        	  3719:     move.b  D0,($000A,A4)
                            	  3720:     even
                            	  3721: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3722:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3723:     ; Move right one pixel.
                            	  3724:     ;
02:0003FFC2 102C000A        	  3725:     move.b  ($000A,A4),D0
02:0003FFC6 020000F0        	  3726:     andi.b #$F0,D0
02:0003FFCA 0C0000E0        	  3727:     cmpi.b  #$E0,D0
02:0003FFCE 6606            	  3728:     bne  _anon_z05_88
02:0003FFD0 522C000A        	  3729:     addq.b  #1,($000A,A4)
02:0003FFD4 600A            	  3730:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3731: 
                            	  3732: _anon_z05_88:
                            	  3733:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3734:     ; Dont' move horizontally.
                            	  3735:     ;
02:0003FFD6 0C000040        	  3736:     cmpi.b  #$40,D0
02:0003FFDA 6604            	  3737:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3738:     ; Else high nibble = 4. We're at the top edge.
                            	  3739:     ; Move left 1 pixel.
                            	  3740:     ;
02:0003FFDC 532C000A        	  3741:     subq.b  #1,($000A,A4)
                            	  3742:     even
                            	  3743: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3744:     ; Time to get the address of the column.
                            	  3745:     ; Starting at the top of the leftmost column.
                            	  3746:     ;
02:0003FFE0 61002590        	  3747:     jsr     FetchTileMapAddr
02:0003FFE4 7005            	  3748:     moveq   #5,D0
02:0003FFE6 4EB90002A9FA    	  3749:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3750:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3751:     ; in order to point to the column we want.
                            	  3752:     ;
02:0003FFEC 102C000A        	  3753:     move.b  ($000A,A4),D0
02:0003FFF0 0200000F        	  3754:     andi.b #$0F,D0
02:0003FFF4 7600            	  3755:     moveq   #0,D3
02:0003FFF6 1600            	  3756:     move.b  D0,D3
02:0003FFF8 670C            	  3757:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3758: _anon_z05_89:
02:0003FFFA 702C            	  3759:     moveq   #44,D0
02:0003FFFC 4EB90003052E    	  3760:     jsr     AddToInt16At0
02:00040002 5303            	  3761:     subq.b  #1,D3
02:00040004 66F4            	  3762:     bne  _anon_z05_89
                            	  3763:     even
                            	  3764: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3765:     ; Turn the row part of [0A] into a tile index.
                            	  3766:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3767:     ;
02:00040006 102C000A        	  3768:     move.b  ($000A,A4),D0
02:0004000A 020000F0        	  3769:     andi.b #$F0,D0
02:0004000E 003C0011        	  3770:     ori     #$11,CCR  ; SEC: set C+X
02:00040012 123C0040        	  3771:     move.b  #$40,D1
02:00040016 0A3C0010        	  3772:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004001A 9101            	  3773:     subx.b  D1,D0   ; SBC #$40
02:0004001C 0A3C0010        	  3774:     eori    #$10,CCR  ; restore X = 6502 C
02:00040020 E208            	  3775:     lsr.b  #1,D0   ; LSR A
02:00040022 E208            	  3776:     lsr.b  #1,D0   ; LSR A
02:00040024 E208            	  3777:     lsr.b  #1,D0   ; LSR A
02:00040026 7600            	  3778:     moveq   #0,D3
02:00040028 1600            	  3779:     move.b  D0,D3
                            	  3780:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3781:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3782:     ; when coming in from the edges.
                            	  3783:     ;
02:0004002A 1214            	  3784:     move.b  ($00,A4),D1   ; ptr lo
02:0004002C 182C0001        	  3785:     move.b  ($01,A4),D4  ; ptr hi
02:00040030 024100FF        	  3786:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00040034 E14C            	  3787:     lsl.w   #8,D4
02:00040036 8841            	  3788:     or.w    D1,D4             ; D4 = NES ptr addr
02:00040038 48C4            	  3789:     ext.l   D4
02:0004003A D8BC00FF0000    	  3790:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00040040 2044            	  3791:     movea.l D4,A0
02:00040042 10303000        	  3792:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00040046 0C000084        	  3793:     cmpi.b  #$84,D0
02:0004004A 650E            	  3794:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3795:     ; Bottom of the loop.
                            	  3796:     ; If you reach the original cell, then stop.
                            	  3797:     ;
02:0004004C 102C000A        	  3798:     move.b  ($000A,A4),D0
02:00040050 122C0525        	  3799:     move.b  ($0525,A4),D1
02:00040054 B001            	  3800:     cmp.b   D1,D0
02:00040056 6600FF44        	  3801:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3802:     even
