                            	  5009: SpreadShot:
                            	  5010:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5011:     ;
                            	  5012:     ; The shot is spreading out.
                            	  5013:     ;
                            	  5014:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5015:     ; These will be negated appropriately for each corner.
                            	  5016:     ;
02:0004A096 41EC0098        	  5017:     lea     ($0098,A4),A0
02:0004A09A 10302000        	  5018:     move.b  (A0,D2.W),D0
02:0004A09E 19400002        	  5019:     move.b  D0,($0002,A4)
02:0004A0A2 19400003        	  5020:     move.b  D0,($0003,A4)
                            	  5021:     ; Reset [0F] to not flip horizontally.
                            	  5022:     ;
02:0004A0A6 7000            	  5023:     moveq   #0,D0
02:0004A0A8 1940000F        	  5024:     move.b  D0,($000F,A4)
                            	  5025:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5026:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5027:     ;
02:0004A0AC 7603            	  5028:     moveq   #3,D3
                            	  5029:     even
                            	  5030: _L_z07_SpreadShot_DrawShotCorner:
02:0004A0AE 1003            	  5031:     move.b  D3,D0
02:0004A0B0 1B00            	  5032:     move.b  D0,-(A5)  ; PHA
                            	  5033:     ; Save offset X [02] and Y offset [03].
                            	  5034:     ;
02:0004A0B2 102C0002        	  5035:     move.b  ($0002,A4),D0
02:0004A0B6 1B00            	  5036:     move.b  D0,-(A5)  ; PHA
02:0004A0B8 102C0003        	  5037:     move.b  ($0003,A4),D0
02:0004A0BC 1B00            	  5038:     move.b  D0,-(A5)  ; PHA
                            	  5039:     ; Calculate and set sprite attributes for this corner:
                            	  5040:     ;   base attribute OR (frame counter AND 3)
                            	  5041:     ;
                            	  5042:     ; The base attribute defines how to flip the sprite.
                            	  5043:     ; The frame counter makes the shot flash by cycling each
                            	  5044:     ; palette row.
                            	  5045:     ;
02:0004A0BE 102C0015        	  5046:     move.b  ($0015,A4),D0
02:0004A0C2 02000003        	  5047:     andi.b #$03,D0
02:0004A0C6 41F900049F24    	  5048:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004A0CC 12303000        	  5049:     move.b  (A0,D3.W),D1
02:0004A0D0 8001            	  5050:     or.b  D1,D0
02:0004A0D2 4EB900030B6C    	  5051:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5052:     ; Add the object's X (the center of the spread) and the
                            	  5053:     ; current offset in [02] to set sprite X in [00].
                            	  5054:     ;
02:0004A0D8 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0004A0DC 023C00EE        	  5056:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A0E0 122C0002        	  5057:     move.b  ($0002,A4),D1
02:0004A0E4 D101            	  5058:     addx.b  D1,D0   ; ADC $02
02:0004A0E6 1880            	  5059:     move.b  D0,($0000,A4)
                            	  5060:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5061:     ; Else calculate the distance from object X to sprite X.
                            	  5062:     ;
02:0004A0E8 12342070        	  5063:     move.b  ($70,A4,D2.W),D1
02:0004A0EC B001            	  5064:     cmp.b   D1,D0
02:0004A0EE 651A            	  5065:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004A0F0 0C0000FC        	  5066:     cmpi.b  #$FC,D0
02:0004A0F4 6466            	  5067:     bcc  _L_z07_SpreadShot_NextCorner
02:0004A0F6 003C0011        	  5068:     ori     #$11,CCR  ; SEC: set C+X
02:0004A0FA 12342070        	  5069:     move.b  ($70,A4,D2.W),D1
02:0004A0FE 0A3C0010        	  5070:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A102 9101            	  5071:     subx.b  D1,D0   ; SBC ObjX,X
02:0004A104 0A3C0010        	  5072:     eori    #$10,CCR  ; restore X = 6502 C
02:0004A108 6014            	  5073:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5074: 
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_ReverseSub:
02:0004A10A 10342070        	  5077:     move.b  ($70,A4,D2.W),D0
02:0004A10E 003C0011        	  5078:     ori     #$11,CCR  ; SEC: set C+X
02:0004A112 1214            	  5079:     move.b  ($0000,A4),D1
02:0004A114 0A3C0010        	  5080:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004A118 9101            	  5081:     subx.b  D1,D0   ; SBC $00
02:0004A11A 0A3C0010        	  5082:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5083:     even
                            	  5084: _L_z07_SpreadShot_CheckDistance:
                            	  5085:     ; If distance >= $20, skip this corner.
                            	  5086:     ;
02:0004A11E 0C000020        	  5087:     cmpi.b  #$20,D0
02:0004A122 6438            	  5088:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5089:     ; Add the object's Y (the center of the spread) and the
                            	  5090:     ; current offset in [03] to set sprite Y in [01].
                            	  5091:     ;
02:0004A124 41EC0084        	  5092:     lea     ($0084,A4),A0
02:0004A128 10302000        	  5093:     move.b  (A0,D2.W),D0
02:0004A12C 023C00EE        	  5094:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A130 122C0003        	  5095:     move.b  ($0003,A4),D1
02:0004A134 D101            	  5096:     addx.b  D1,D0   ; ADC $03
02:0004A136 19400001        	  5097:     move.b  D0,($0001,A4)
                            	  5098:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5099:     ;
02:0004A13A 7600            	  5100:     moveq   #0,D3
02:0004A13C 162C0010        	  5101:     move.b  ($0010,A4),D3
02:0004A140 670C            	  5102:     beq  _L_z07_SpreadShot_Draw
02:0004A142 0C00003E        	  5103:     cmpi.b  #$3E,D0
02:0004A146 6514            	  5104:     bcs  _L_z07_SpreadShot_NextCorner
02:0004A148 0C0000E8        	  5105:     cmpi.b  #$E8,D0
02:0004A14C 640E            	  5106:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5107:     even
                            	  5108: _L_z07_SpreadShot_Draw:
                            	  5109:     ; Draw the corner.
                            	  5110:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5111:     ;
