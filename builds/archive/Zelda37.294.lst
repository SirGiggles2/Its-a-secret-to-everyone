                            	  5438:     ; If this is a monster's arrow, add 2 to sprite attributes in [04].
                            	  5439:     ; This chooses palette row 6.
                            	  5440:     ;
                            	  5441:     ; Otherwise, add the arrow item value less 1. This chooses
