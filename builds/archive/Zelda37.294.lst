02:000413EC 10303000        	  5044:     move.b  (A0,D3.W),D0
02:000413F0 7600            	  5045:     moveq   #0,D3
02:000413F2 162C0003        	  5046:     move.b  ($0003,A4),D3
02:000413F6 0C030002        	  5047:     cmpi.b  #$02,D3
02:000413FA 6510            	  5048:     bcs  _anon_z05_106
02:000413FC 7600            	  5049:     moveq   #0,D3
02:000413FE 162C00EB        	  5050:     move.b  ($00EB,A4),D3
02:00041402 41F900FF68FE    	  5051:     lea     (NES_SRAM+$08FE).l,A0
02:00041408 10303000        	  5052:     move.b  (A0,D3.W),D0
                            	  5053: _anon_z05_106:
02:0004140C 1880            	  5054:     move.b  D0,($0000,A4)
