02:0003C140 53302000        	  9253:     subq.b  #1,(A0,D2.W)
                            	  9254: _anon_z04_121:
                            	  9255:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9256:     ;
02:0003C144 41EC0412        	  9257:     lea     ($0412,A4),A0
