02:000388DA 41EC0084        	  1390:     lea     ($0084,A4),A0
02:000388DE 10302000        	  1391:     move.b  (A0,D2.W),D0
02:000388E2 0200000F        	  1392:     andi.b #$0F,D0
02:000388E6 0C00000D        	  1393:     cmpi.b  #$0D,D0
02:000388EA 6602            	  1394:     bne  _anon_z04_26
02:000388EC 7603            	  1395:     moveq   #3,D3
                            	  1396: _anon_z04_26:
02:000388EE 1883            	  1397:     move.b  D3,($0000,A4)
                            	  1398:     ; If horizontally aligned with the square grid, then
                            	  1399:     ; use a vertical direction mask ($C).
                            	  1400:     ;
02:000388F0 7600            	  1401:     moveq   #0,D3
02:000388F2 10342070        	  1402:     move.b  ($70,A4,D2.W),D0
02:000388F6 0200000F        	  1403:     andi.b #$0F,D0
02:000388FA 6602            	  1404:     bne  _anon_z04_27
02:000388FC 760C            	  1405:     moveq   #12,D3
                            	  1406: _anon_z04_27:
02:000388FE 1003            	  1407:     move.b  D3,D0
                            	  1408:     ; Combine the two masks. At most one will be 0.
                            	  1409:     ;
02:00038900 1214            	  1410:     move.b  ($0000,A4),D1
02:00038902 8001            	  1411:     or.b  D1,D0
                            	  1412:     ; The point is to see if the zol is facing in a way that's aligned
                            	  1413:     ; with the grid.
                            	  1414:     ;
                            	  1415:     ; If so, then go to state 1 to do a "big shove".
                            	  1416:     ; Else go to state 2, to immediately split in two.
                            	  1417:     ;
                            	  1418:     ; Examples:
                            	  1419:     ; It would be aligned, if moving left along a tile as usual.
                            	  1420:     ; It would *not* be aligned, if while moving left, it was hit downward.
                            	  1421:     ; - The collision check routines would have made the zol
                            	  1422:     ;   face in the direction of the weapon.
                            	  1423:     ; - See CheckMonsterWeaponCollision.
                            	  1424:     ;
02:00038904 122C0098        	  1425:     move.b  ($0098,A4),D1
02:00038908 C001            	  1426:     and.b  D1,D0
02:0003890A 6608            	  1427:     bne  _anon_z04_28
02:0003890C 41EC00AC        	  1428:     lea     ($00AC,A4),A0
02:00038910 52302000        	  1429:     addq.b  #1,(A0,D2.W)
