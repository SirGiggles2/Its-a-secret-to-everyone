                            	  9245:     ;
02:0003C12A 122C0002        	  9246:     move.b  ($0002,A4),D1
02:0003C12E E309            	  9247:     lsl.b  #1,D1   ; ASL $02
02:0003C130 19410002        	  9248:     move.b  D1,($0002,A4)
02:0003C134 122C0002        	  9249:     move.b  ($0002,A4),D1
02:0003C138 C200            	  9250:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C13A 6708            	  9251:     beq  _anon_z04_121
