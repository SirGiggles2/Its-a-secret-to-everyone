02:000418BE 123C0001        	  5745:     move.b  #$01,D1
02:000418C2 0A3C0010        	  5746:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000418C6 9101            	  5747:     subx.b  D1,D0   ; SBC #$01
02:000418C8 0A3C0010        	  5748:     eori    #$10,CCR  ; restore X = 6502 C
02:000418CC 02000002        	  5749:     andi.b #$02,D0
