02:00039692 10342028        	  3392:     move.b  ($28,A4,D2.W),D0
02:00039696 41EC0492        	  3393:     lea     ($0492,A4),A0
02:0003969A 11802000        	  3394:     move.b  D0,(A0,D2.W)
                            	  3395:     ; If it's still fading in, then go finish some initialization needed
                            	  3396:     ; for fading in.
                            	  3397:     ;
02:0003969E 660000B6        	  3398:     bne  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3399:     ; Once the object timer reaches 0; if the object is flying ghini,
                            	  3400:     ; go finish initializing it.
                            	  3401:     ;
02:000396A2 41EC034F        	  3402:     lea     ($034F,A4),A0
02:000396A6 10302000        	  3403:     move.b  (A0,D2.W),D0
02:000396AA 0C000022        	  3404:     cmpi.b  #$22,D0
02:000396AE 670000A6        	  3405:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3406:     ; Else we have an armos.
                            	  3407:     ;
                            	  3408:     ; Store stairs tile $70 in [00] for use later.
                            	  3409:     ;
02:000396B2 7070            	  3410:     moveq   #112,D0
02:000396B4 1880            	  3411:     move.b  D0,($0000,A4)
                            	  3412:     ; Look for the current room ID in an array of room ID's that
                            	  3413:     ; have armos secrets.
                            	  3414:     ;
02:000396B6 7606            	  3415:     moveq   #6,D3
                            	  3416:     even
                            	  3417: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:000396B8 102C00EB        	  3418:     move.b  ($00EB,A4),D0
                            	  3419:     ; If this element does not match the current room ID, go loop again.
                            	  3420:     ;
02:000396BC 41F900039682    	  3421:     lea     (SecretArmosRoomIds).l,A0
02:000396C2 12303000        	  3422:     move.b  (A0,D3.W),D1
02:000396C6 B001            	  3423:     cmp.b   D1,D0
02:000396C8 6648            	  3424:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3425:     ; The secret (usually stairs) is under one of the armoses.
                            	  3426:     ;
                            	  3427:     ; If the armos's X coordinate does not match the one needed
                            	  3428:     ; for the current room in the list, then go loop again.
                            	  3429:     ;
02:000396CA 10342070        	  3430:     move.b  ($70,A4,D2.W),D0
02:000396CE 41F90003968A    	  3431:     lea     (SecretArmosXs).l,A0
02:000396D4 12303000        	  3432:     move.b  (A0,D3.W),D1
02:000396D8 B001            	  3433:     cmp.b   D1,D0
02:000396DA 6636            	  3434:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3435:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3436:     ;
02:000396DC 41EC0084        	  3437:     lea     ($0084,A4),A0
02:000396E0 10302000        	  3438:     move.b  (A0,D2.W),D0
02:000396E4 0C000080        	  3439:     cmpi.b  #$80,D0
02:000396E8 6628            	  3440:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3441:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3442:     ;
02:000396EA 4A03            	  3443:     cmpi.b  #$00,D3
02:000396EC 662C            	  3444:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3445:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3446:     ; has the power bracelet.
                            	  3447:     ;
                            	  3448:     ; Set up the room item with the armos's coordinates.
                            	  3449:     ;
02:000396EE 19400097        	  3450:     move.b  D0,($0097,A4)
02:000396F2 10342070        	  3451:     move.b  ($70,A4,D2.W),D0
02:000396F6 19400083        	  3452:     move.b  D0,($0083,A4)
                            	  3453:     ; This resets the room item's state, which activates it.
                            	  3454:     ;
02:000396FA 194300BF        	  3455:     move.b  D3,($00BF,A4)
                            	  3456:     ; Set the room item ID.
                            	  3457:     ;
02:000396FE 7014            	  3458:     moveq   #20,D0
02:00039700 194000AB        	  3459:     move.b  D0,($00AB,A4)
                            	  3460:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3461:     ;
                            	  3462:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3463:     ;
                            	  3464:     ; Note that, if the item was already taken, then the room item
                            	  3465:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3466:     ; it will be ignored, because that routine checks whether
                            	  3467:     ; the item was taken.
                            	  3468:     ;
02:00039704 4EB9000305B2    	  3469:     jsr     GetRoomFlagUWItemState
02:0003970A 660A            	  3470:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003970C 6100069E        	  3471:     jsr     PlaySecretFoundTune
02:00039710 6604            	  3472:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3473:     even
                            	  3474: _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom:
                            	  3475:     ; Bottom of the loop.
                            	  3476:     ;
02:00039712 5303            	  3477:     subq.b  #1,D3
02:00039714 6AA2            	  3478:     bpl  _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom
                            	  3479:     even
                            	  3480: _L_z04_InitArmosOrFlyingGhini_UseFloorTile:
                            	  3481:     ; Not found, or found the power bracelet.
                            	  3482:     ; Use a floor tile $26 to replace the armos.
                            	  3483:     ;
02:00039716 7026            	  3484:     moveq   #38,D0
02:00039718 1880            	  3485:     move.b  D0,($0000,A4)
                            	  3486:     even
                            	  3487: _L_z04_InitArmosOrFlyingGhini_UseChosenTile:
02:0003971A 1014            	  3488:     move.b  ($0000,A4),D0
                            	  3489:     ; If the replacement tile is a stairs tile, then play the "secret found" tune.
                            	  3490:     ;
02:0003971C 1B00            	  3491:     move.b  D0,-(A5)  ; PHA
02:0003971E 0C000070        	  3492:     cmpi.b  #$70,D0
02:00039722 6604            	  3493:     bne  _anon_z04_51
02:00039724 61000686        	  3494:     jsr     PlaySecretFoundTune
                            	  3495: _anon_z04_51:
                            	  3496:     ; Replace the tile where the armos was.
                            	  3497:     ;
02:00039728 522C00F7        	  3498:     addq.b  #1,($00F7,A4)
02:0003972C 101D            	  3499:     move.b  (A5)+,D0  ; PLA
02:0003972E 4EB900048E02    	  3500:     jsr     ChangeTileObjTiles
                            	  3501:     ; Because the armos object is aligned to the square grid
                            	  3502:     ; (because it was made from a square),
                            	  3503:     ; set its grid offset to 3 to compensate.
                            	  3504:     ;
                            	  3505:     ; Most objects are aligned to the grid vertically when the
                            	  3506:     ; low nibble is $D.
                            	  3507:     ;
02:00039734 7003            	  3508:     moveq   #3,D0
02:00039736 41EC0394        	  3509:     lea     ($0394,A4),A0
02:0003973A 11802000        	  3510:     move.b  D0,(A0,D2.W)
                            	  3511:     ; Set a speed (q-speed fraction) randomly:
                            	  3512:     ; $20 if random value < $80
                            	  3513:     ; $60 otherwise
                            	  3514:     ;
02:0003973E 7020            	  3515:     moveq   #32,D0
02:00039740 7600            	  3516:     moveq   #0,D3
02:00039742 16342019        	  3517:     move.b  ($19,A4,D2.W),D3
02:00039746 0C030080        	  3518:     cmpi.b  #$80,D3
02:0003974A 6502            	  3519:     bcs  _anon_z04_52
02:0003974C 7060            	  3520:     moveq   #96,D0
                            	  3521: _anon_z04_52:
02:0003974E 41EC03BC        	  3522:     lea     ($03BC,A4),A0
02:00039752 11802000        	  3523:     move.b  D0,(A0,D2.W)
                            	  3524:     even
                            	  3525: _L_z04_InitArmosOrFlyingGhini_FinishInit:
                            	  3526:     ; Facing and input directions down.
                            	  3527:     ;
02:00039756 7004            	  3528:     moveq   #4,D0
02:00039758 41EC03F8        	  3529:     lea     ($03F8,A4),A0
02:0003975C 11802000        	  3530:     move.b  D0,(A0,D2.W)
02:00039760 41EC0098        	  3531:     lea     ($0098,A4),A0
02:00039764 11802000        	  3532:     move.b  D0,(A0,D2.W)
                            	  3533:     ; Every other frame, return without drawing.
                            	  3534:     ;
02:00039768 10342028        	  3535:     move.b  ($28,A4,D2.W),D0
02:0003976C E208            	  3536:     lsr.b  #1,D0   ; LSR A
02:0003976E 6512            	  3537:     bcs  _anon_z04_53
                            	  3538:     ; Finish initializing based on type.
                            	  3539:     ;
02:00039770 41EC034F        	  3540:     lea     ($034F,A4),A0
02:00039774 10302000        	  3541:     move.b  (A0,D2.W),D0
02:00039778 0C000022        	  3542:     cmpi.b  #$22,D0
02:0003977C 6602            	  3543:     bne.s  __far_z_04_0030
02:0003977E 6008            	  3544:     jmp  L_EndInitFlyingGhini
                            	  3545: __far_z_04_0030:
02:00039780 6158            	  3546:     jsr     DrawArmosAndCheckCollisions
                            	  3547: _anon_z04_53:
02:00039782 0A3C0001        	  3548:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:00039786 4E75            	  3549:     rts
                            	  3550: 
                            	  3551:     even
                            	  3552: L_EndInitFlyingGhini:
02:00039788 6100FEAA        	  3553:     jsr     DrawGhiniAndCheckCollisions
                            	  3554:     ; If we're finally leaving the object flagged "initialized",
                            	  3555:     ; then reset metastate and initialize this as a flyer.
                            	  3556:     ;
02:0003978C 41EC0492        	  3557:     lea     ($0492,A4),A0
02:00039790 10302000        	  3558:     move.b  (A0,D2.W),D0
02:00039794 66EC            	  3559:     bne  _anon_z04_53
02:00039796 4EB90004B588    	  3560:     jsr     ResetObjMetastateAndTimer
02:0003979C 6000F516        	  3561:     jmp     EndInitFlyer
                            	  3562: 
                            	  3563:     even
                            	  3564: UpdateArmos:
02:000397A0 6100EA0A        	  3565:     jsr     UpdateGoriya
                            	  3566:     ; If it's still shoved, then don't animate. Only go draw.
                            	  3567:     ;
02:000397A4 41EC00C0        	  3568:     lea     ($00C0,A4),A0
02:000397A8 10302000        	  3569:     move.b  (A0,D2.W),D0
02:000397AC 6702            	  3570:     beq.s  __far_z_04_0031
02:000397AE 602A            	  3571:     jmp  DrawArmosAndCheckCollisions
                            	  3572: __far_z_04_0031:
                            	  3573:     ; Animate.
                            	  3574:     ;
                            	  3575:     ; Decrement the animation counter. But if it hasn't reached 0,
                            	  3576:     ; then only go draw.
                            	  3577:     ;
02:000397B0 41EC03D0        	  3578:     lea     ($03D0,A4),A0
02:000397B4 53302000        	  3579:     subq.b  #1,(A0,D2.W)
02:000397B8 6702            	  3580:     beq.s  __far_z_04_0032
02:000397BA 601E            	  3581:     jmp  DrawArmosAndCheckCollisions
                            	  3582: __far_z_04_0032:
                            	  3583:     ; Armos animation frames last 6 screen frames.
                            	  3584:     ;
02:000397BC 7006            	  3585:     moveq   #6,D0
02:000397BE 41EC03D0        	  3586:     lea     ($03D0,A4),A0
02:000397C2 11802000        	  3587:     move.b  D0,(A0,D2.W)
                            	  3588:     ; Armos doesn't simply flip horizontally to animate. That would
                            	  3589:     ; change the position of the shield. To keep fixed it in place,
                            	  3590:     ; there are separate frame images for each animation frame.
                            	  3591:     ;
                            	  3592:     ; Frame images 0 and 1 depict the first animation frame, facing front and back.
                            	  3593:     ; Frame images 2 and 3 depict the second animation frame, facing front and back.
                            	  3594:     ;
                            	  3595:     ; Here flip between the two sets by XOR'ing with 2.
                            	  3596:     ; Then choose the direction at the point of drawing below.
                            	  3597:     ;
02:000397C6 41EC03E4        	  3598:     lea     ($03E4,A4),A0
02:000397CA 10302000        	  3599:     move.b  (A0,D2.W),D0
02:000397CE 0A000002        	  3600:     eori.b #$02,D0
02:000397D2 41EC03E4        	  3601:     lea     ($03E4,A4),A0
02:000397D6 11802000        	  3602:     move.b  D0,(A0,D2.W)
                            	  3603:     even
                            	  3604: DrawArmosAndCheckCollisions:
02:000397DA 4EB90004AD8E    	  3605:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:000397E0 7600            	  3606:     moveq   #0,D3
02:000397E2 41EC0098        	  3607:     lea     ($0098,A4),A0
02:000397E6 16302000        	  3608:     move.b  (A0,D2.W),D3
                            	  3609:     ; If facing up, then use the second frame image in the set ("back").
                            	  3610:     ; Else use the second.
                            	  3611:     ;
02:000397EA 0C030008        	  3612:     cmpi.b  #$08,D3
02:000397EE 6602            	  3613:     bne  _anon_z04_54
02:000397F0 7001            	  3614:     moveq   #1,D0
                            	  3615: _anon_z04_54:
02:000397F2 023C00EE        	  3616:     andi    #$EE,CCR  ; CLC: clear C+X
02:000397F6 41EC03E4        	  3617:     lea     ($03E4,A4),A0
02:000397FA 12302000        	  3618:     move.b  (A0,D2.W),D1
02:000397FE D101            	  3619:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:00039800 4EB90003087A    	  3620:     jsr     DrawObjectNotMirrored
                            	  3621:     ; If the armos is still fading in, then go for check collision with Link,
                            	  3622:     ; but not with weapons.
                            	  3623:     ;
02:00039806 10342028        	  3624:     move.b  ($28,A4,D2.W),D0
02:0003980A 661C            	  3625:     bne  _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision
                            	  3626:     ; Else check for all collisions.
                            	  3627:     ;
02:0003980C 4EB900030BE6    	  3628:     jsr     CheckMonsterCollisions
                            	  3629:     ; If the armos has died, then set object type to $5D (dead dummy).
                            	  3630:     ;
02:00039812 41EC0405        	  3631:     lea     ($0405,A4),A0
02:00039816 10302000        	  3632:     move.b  (A0,D2.W),D0
02:0003981A 670A            	  3633:     beq  _anon_z04_55
02:0003981C 705D            	  3634:     moveq   #93,D0
02:0003981E 41EC034F        	  3635:     lea     ($034F,A4),A0
02:00039822 11802000        	  3636:     move.b  D0,(A0,D2.W)
                            	  3637: _anon_z04_55:
02:00039826 4E75            	  3638:     rts
                            	  3639: 
                            	  3640:     even
                            	  3641: _L_z04_DrawArmosAndCheckCollisions_CheckLinkCollision:
02:00039828 4EF900030C4C    	  3642:     jmp     CheckLinkCollision
                            	  3643: 
                            	  3644:     even
                            	  3645: UpdatePondFairy:
02:0003982E 61004432        	  3646:     jsr     DrawFairy
                            	  3647:     ; If not in state 0, then go handle states 1 to 3.
                            	  3648:     ;
02:00039832 102C00AD        	  3649:     move.b  ($00AD,A4),D0
02:00039836 6702            	  3650:     beq.s  __far_z_04_0033
02:00039838 602A            	  3651:     jmp  PondFairy_HandleOtherStates
                            	  3652: __far_z_04_0033:
                            	  3653:     ; State 0.
                            	  3654:     ;
                            	  3655:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3656:     ;
02:0003983A 102C0084        	  3657:     move.b  ($0084,A4),D0
02:0003983E 0C0000AD        	  3658:     cmpi.b  #$AD,D0
02:00039842 661E            	  3659:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3660:     ; If Link's X < $70 or >= $81, then return.
                            	  3661:     ;
02:00039844 102C0070        	  3662:     move.b  ($0070,A4),D0
02:00039848 0C000070        	  3663:     cmpi.b  #$70,D0
02:0003984C 6514            	  3664:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003984E 0C000081        	  3665:     cmpi.b  #$81,D0
02:00039852 640E            	  3666:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3667:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3668:     ; halt Link, and start filling hearts.
                            	  3669:     ;
02:00039854 522C00AD        	  3670:     addq.b  #1,($00AD,A4)
02:00039858 7040            	  3671:     moveq   #64,D0
02:0003985A 194000AC        	  3672:     move.b  D0,($00AC,A4)
02:0003985E 19400063        	  3673:     move.b  D0,($0063,A4)
                            	  3674:     even
                            	  3675: _L_z04_UpdatePondFairy_Exit:
02:00039862 4E75            	  3676:     rts
                            	  3677: 
                            	  3678:     even
                            	  3679: PondFairy_HandleOtherStates:
02:00039864 0C000001        	  3680:     cmpi.b  #$01,D0
02:00039868 6610            	  3681:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3682:     ; State 1. Flying and filling hearts.
                            	  3683:     ;
                            	  3684:     ; If still filling hearts, then go draw Link and hearts.
                            	  3685:     ;
02:0003986A 102C0063        	  3686:     move.b  ($0063,A4),D0
02:0003986E 6620            	  3687:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3688:     ; If not filling hearts anymore, then go to state 2,
                            	  3689:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3690:     ; a little while after we finish filling hearts.
                            	  3691:     ;
02:00039870 522C00AD        	  3692:     addq.b  #1,($00AD,A4)
02:00039874 7050            	  3693:     moveq   #80,D0
02:00039876 19400029        	  3694:     move.b  D0,($0029,A4)
                            	  3695:     even
                            	  3696: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3697:     ; If state <> 2 (so, it's 3), then return.
                            	  3698:     ;
                            	  3699:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3700:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3701:     ; was set to, and we'll return.
                            	  3702:     ;
02:0003987A 0C000002        	  3703:     cmpi.b  #$02,D0
02:0003987E 6634            	  3704:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3705:     ; State = 2.
                            	  3706:     ;
                            	  3707:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3708:     ;
02:00039880 102C0029        	  3709:     move.b  ($0029,A4),D0
02:00039884 660A            	  3710:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3711:     ; Else go to state 3, and unhalt Link.
                            	  3712:     ;
02:00039886 522C00AD        	  3713:     addq.b  #1,($00AD,A4)
02:0003988A 7000            	  3714:     moveq   #0,D0
02:0003988C 194000AC        	  3715:     move.b  D0,($00AC,A4)
                            	  3716:     even
                            	  3717: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  3718:     ; TODO: but why, since Link is halted?
                            	  3719:     ;
                            	  3720:     ; Reset the input direction, so that Link doesn't animate
                            	  3721:     ; when drawing him.
02:00039890 7600            	  3722:     moveq   #0,D3
02:00039892 194303F8        	  3723:     move.b  D3,($03F8,A4)
                            	  3724:     ; Save and reset Link's state.
                            	  3725:     ;
                            	  3726:     ; TODO: but why, since Link is halted?
                            	  3727:     ;
02:00039896 102C00AC        	  3728:     move.b  ($00AC,A4),D0
02:0003989A 1B00            	  3729:     move.b  D0,-(A5)  ; PHA
02:0003989C 194300AC        	  3730:     move.b  D3,($00AC,A4)
02:000398A0 4EB900049CB4    	  3731:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  3732:     ; Restore Link's state.
                            	  3733:     ;
02:000398A6 101D            	  3734:     move.b  (A5)+,D0  ; PLA
02:000398A8 194000AC        	  3735:     move.b  D0,($00AC,A4)
02:000398AC 6110            	  3736:     jsr     PondFairy_MoveHearts
