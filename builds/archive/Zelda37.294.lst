                            	 12277: Ganon_DrawBody:
                            	 12278:     ; Loop over four 16x16 images that make up Ganon.
                            	 12279:     ; There are 6 animation frames.
                            	 12280:     ;
02:0003D77E 7603            	 12281:     moveq   #3,D3
                            	 12282:     even
                            	 12283: _L_z04_Ganon_DrawBody_LoopCorner:
                            	 12284:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	 12285:     ;
02:0003D780 10342070        	 12286:     move.b  ($70,A4,D2.W),D0
02:0003D784 023C00EE        	 12287:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D788 41F90003D772    	 12288:     lea     (GanonSpriteOffsetsX).l,A0
02:0003D78E 12303000        	 12289:     move.b  (A0,D3.W),D1
02:0003D792 D101            	 12290:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003D794 1880            	 12291:     move.b  D0,($0000,A4)
                            	 12292:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	 12293:     ;
02:0003D796 41EC0084        	 12294:     lea     ($0084,A4),A0
02:0003D79A 10302000        	 12295:     move.b  (A0,D2.W),D0
02:0003D79E 023C00EE        	 12296:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D7A2 41F90003D776    	 12297:     lea     (GanonSpriteOffsetsY).l,A0
02:0003D7A8 12303000        	 12298:     move.b  (A0,D3.W),D1
02:0003D7AC D101            	 12299:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003D7AE 19400001        	 12300:     move.b  D0,($0001,A4)
                            	 12301:     ; Each part has a horizontal flipping flag.
                            	 12302:     ;
02:0003D7B2 41F90003D77A    	 12303:     lea     (GanonSpriteHFlips).l,A0
02:0003D7B8 10303000        	 12304:     move.b  (A0,D3.W),D0
02:0003D7BC 1940000F        	 12305:     move.b  D0,($000F,A4)
                            	 12306:     ; Save and copy the loop index (the current part) to [07].
                            	 12307:     ;
02:0003D7C0 1003            	 12308:     move.b  D3,D0
02:0003D7C2 1B00            	 12309:     move.b  D0,-(A5)  ; PHA
02:0003D7C4 19400007        	 12310:     move.b  D0,($0007,A4)
                            	 12311:     ; Multiply the animation frame by 4, because of the 4 parts
                            	 12312:     ; that make it up.
                            	 12313:     ;
02:0003D7C8 41EC046B        	 12314:     lea     ($046B,A4),A0
02:0003D7CC 10302000        	 12315:     move.b  (A0,D2.W),D0
02:0003D7D0 E308            	 12316:     lsl.b  #1,D0   ; ASL A
02:0003D7D2 E308            	 12317:     lsl.b  #1,D0   ; ASL A
                            	 12318:     ; Add [07] -- the index of the current part.
                            	 12319:     ;
                            	 12320:     ; Now you have an index into the frame image table, for the
                            	 12321:     ; current image part of the current animation frame.
                            	 12322:     ;
02:0003D7D4 122C0007        	 12323:     move.b  ($0007,A4),D1
02:0003D7D8 D101            	 12324:     addx.b  D1,D0   ; ADC $07
02:0003D7DA 7600            	 12325:     moveq   #0,D3
02:0003D7DC 1600            	 12326:     move.b  D0,D3
02:0003D7DE 41F90003D75A    	 12327:     lea     (GanonFrameImages).l,A0
02:0003D7E4 10303000        	 12328:     move.b  (A0,D3.W),D0
02:0003D7E8 4EB90003087A    	 12329:     jsr     DrawObjectNotMirrored
02:0003D7EE 101D            	 12330:     move.b  (A5)+,D0  ; PLA
                            	 12331:     ; Bottom of the part loop.
                            	 12332:     ;
02:0003D7F0 7600            	 12333:     moveq   #0,D3
02:0003D7F2 1600            	 12334:     move.b  D0,D3
02:0003D7F4 5303            	 12335:     subq.b  #1,D3
02:0003D7F6 6A88            	 12336:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003D7F8 4E75            	 12337:     rts
                            	 12338: 
                            	 12339:     even
                            	 12340: Ganon_CheckCollisions:
                            	 12341:     ; Calculate Ganon's midpoint at offset ($10, $10) from his coordinates.
                            	 12342:     ; Store in [02] and [03].
                            	 12343:     ;
02:0003D7FA 10342070        	 12344:     move.b  ($70,A4,D2.W),D0
02:0003D7FE 023C00EE        	 12345:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D802 123C0010        	 12346:     move.b  #$10,D1
02:0003D806 D101            	 12347:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D808 19400002        	 12348:     move.b  D0,($0002,A4)
02:0003D80C 41EC0084        	 12349:     lea     ($0084,A4),A0
02:0003D810 10302000        	 12350:     move.b  (A0,D2.W),D0
02:0003D814 023C00EE        	 12351:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003D818 123C0010        	 12352:     move.b  #$10,D1
02:0003D81C D101            	 12353:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003D81E 19400003        	 12354:     move.b  D0,($0003,A4)
                            	 12355:     ; Check for a collision with Link.
                            	 12356:     ;
                            	 12357:     ; We can't call CheckLinkCollision, because we need to
                            	 12358:     ; customize Ganon's midpoint.
                            	 12359:     ;
                            	 12360:     ; So, we've calculated the midpoint hotspot. Now, skip collision
                            	 12361:     ; detection, if Link is invincible. Initialize variables that will
                            	 12362:     ; be returned from the partial collision check routine. Then
                            	 12363:     ; call it.
                            	 12364:     ;
02:0003D822 102C04F0        	 12365:     move.b  ($04F0,A4),D0
02:0003D826 6616            	 12366:     bne  _L_z04_Ganon_CheckCollisions_SkipLinkCollision
02:0003D828 19400006        	 12367:     move.b  D0,($0006,A4)
02:0003D82C 19400009        	 12368:     move.b  D0,($0009,A4)
02:0003D830 1940000C        	 12369:     move.b  D0,($000C,A4)
02:0003D834 7600            	 12370:     moveq   #0,D3
02:0003D836 1883            	 12371:     move.b  D3,($0000,A4)
02:0003D838 4EB900030C50    	 12372:     jsr     CheckLinkCollisionPreinit
                            	 12373:     even
                            	 12374: _L_z04_Ganon_CheckCollisions_SkipLinkCollision:
                            	 12375:     ; If Ganon is not in state 0, then he's brown.
                            	 12376:     ; Go check collision with an arrow.
                            	 12377:     ;
02:0003D83E 41EC00AC        	 12378:     lea     ($00AC,A4),A0
02:0003D842 10302000        	 12379:     move.b  (A0,D2.W),D0
02:0003D846 6652            	 12380:     bne  _L_z04_Ganon_CheckCollisions_CheckArrowCollision
                            	 12381:     ; If timer <> 0, then Ganon is visible.
                            	 12382:     ; He can't be harmed like this. So, return.
                            	 12383:     ;
02:0003D848 10342028        	 12384:     move.b  ($28,A4,D2.W),D0
02:0003D84C 664A            	 12385:     bne  _L_z04_Ganon_CheckCollisions_Exit
02:0003D84E 760D            	 12386:     moveq   #13,D3
02:0003D850 4EB900030C8A    	 12387:     jsr     CheckMonsterSwordCollision
                            	 12388:     ; If Ganon has died according to the usual collision check rules
                            	 12389:     ; (HP = 0), then:
                            	 12390:     ; 1. Restore HP to the initial value $F0
                            	 12391:     ; 2. Set state to $FF to note that Ganon is vulnerable to silver arrows
                            	 12392:     ; 3. Change palette row 7 to make Ganon brown
                            	 12393:     ;
02:0003D856 41EC0405        	 12394:     lea     ($0405,A4),A0
02:0003D85A 10302000        	 12395:     move.b  (A0,D2.W),D0
02:0003D85E 6718            	 12396:     beq  _L_z04_Ganon_CheckCollisions_CheckHarmed
02:0003D860 103C00F0        	 12397:     move.b  #$F0,D0
02:0003D864 41EC0485        	 12398:     lea     ($0485,A4),A0
02:0003D868 11802000        	 12399:     move.b  D0,(A0,D2.W)
02:0003D86C 41EC00AC        	 12400:     lea     ($00AC,A4),A0
02:0003D870 53302000        	 12401:     subq.b  #1,(A0,D2.W)
02:0003D874 61000084        	 12402:     jsr     Ganon_AppendPaletteRowTransferRecord_Brown
                            	 12403:     even
                            	 12404: _L_z04_Ganon_CheckCollisions_CheckHarmed:
                            	 12405:     ; If Ganon was harmed, then play the sound effect
                            	 12406:     ; and set timer to $40, so that he's visible for $40 frames.
                            	 12407:     ;
02:0003D878 41EC04F0        	 12408:     lea     ($04F0,A4),A0
02:0003D87C 10302000        	 12409:     move.b  (A0,D2.W),D0
02:0003D880 670A            	 12410:     beq  _L_z04_Ganon_CheckCollisions_UndoDeath
02:0003D882 6100A792        	 12411:     jsr     PlayBossHitCryIfNeeded
02:0003D886 7040            	 12412:     moveq   #64,D0
02:0003D888 19802028        	 12413:     move.b  D0,($28,A4,D2.W)
                            	 12414:     even
                            	 12415: _L_z04_Ganon_CheckCollisions_UndoDeath:
                            	 12416:     ; Reset metastate, because Ganon cannot die this way.
                            	 12417:     ;
02:0003D88C 4EB90004B58E    	 12418:     jsr     ResetObjMetastate
                            	 12419:     ; Reset shove info and invincibility timer, because Ganon
                            	 12420:     ; doesn't react at all as a usual monster.
                            	 12421:     ;
02:0003D892 4EB900030C78    	 12422:     jsr     ResetShoveInfoAndInvincibilityTimer
                            	 12423:     even
                            	 12424: _L_z04_Ganon_CheckCollisions_Exit:
02:0003D898 4E75            	 12425:     rts
                            	 12426: 
                            	 12427:     even
                            	 12428: _L_z04_Ganon_CheckCollisions_CheckArrowCollision:
                            	 12429:     ; If the silver arrow is not in the inventory, then return.
                            	 12430:     ;
02:0003D89A 102C0659        	 12431:     move.b  ($0659,A4),D0
02:0003D89E 0C000002        	 12432:     cmpi.b  #$02,D0
02:0003D8A2 66F4            	 12433:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12434:     ; Reset the collision return value [06].
                            	 12435:     ;
02:0003D8A4 7000            	 12436:     moveq   #0,D0
02:0003D8A6 19400006        	 12437:     move.b  D0,($0006,A4)
                            	 12438:     ; If there's no arrow in flight, then return.
                            	 12439:     ;
02:0003D8AA 7612            	 12440:     moveq   #18,D3
02:0003D8AC 41EC00AC        	 12441:     lea     ($00AC,A4),A0
02:0003D8B0 10303000        	 12442:     move.b  (A0,D3.W),D0
02:0003D8B4 0C000010        	 12443:     cmpi.b  #$10,D0
02:0003D8B8 66DE            	 12444:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	 12445:     ; Check for collision with an arrow; and return if no collision.
                            	 12446:     ;
02:0003D8BA 4EB900030C92    	 12447:     jsr     CheckMonsterArrowOrRodCollision
02:0003D8C0 102C0006        	 12448:     move.b  ($0006,A4),D0
02:0003D8C4 67D2            	 12449:     beq  _L_z04_Ganon_CheckCollisions_Exit
                            	 12450:     ; Set the Ganon phase to "dying".
                            	 12451:     ;
02:0003D8C6 41EC042C        	 12452:     lea     ($042C,A4),A0
02:0003D8CA 52302000        	 12453:     addq.b  #1,(A0,D2.W)
                            	 12454:     ; Now his body does flash.
                            	 12455:     ;
02:0003D8CE 7028            	 12456:     moveq   #40,D0
02:0003D8D0 41EC04F0        	 12457:     lea     ($04F0,A4),A0
02:0003D8D4 11802000        	 12458:     move.b  D0,(A0,D2.W)
                            	 12459:     ; Set initial cloud distance 8.
                            	 12460:     ;
02:0003D8D8 7008            	 12461:     moveq   #8,D0
02:0003D8DA 41EC0478        	 12462:     lea     ($0478,A4),A0
02:0003D8DE 11802000        	 12463:     move.b  D0,(A0,D2.W)
02:0003D8E2 0A3C0001        	 12464:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003D8E6 4E75            	 12465:     rts
