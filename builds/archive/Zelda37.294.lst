02:0003A9EC 666C            	  6077:     bne  _L_z04_Aquamentus_Move_Exit
                            	  6078:     ; If the boss crossed the left limit, then
                            	  6079:     ; put it back at the left limit ($88), and face right.
                            	  6080:     ;
02:0003A9EE 10342070        	  6081:     move.b  ($70,A4,D2.W),D0
02:0003A9F2 0C000088        	  6082:     cmpi.b  #$88,D0
02:0003A9F6 6414            	  6083:     bcc  _L_z04_Aquamentus_Move_CheckRightLimit
02:0003A9F8 103C0088        	  6084:     move.b  #$88,D0
02:0003A9FC 19802070        	  6085:     move.b  D0,($70,A4,D2.W)
02:0003AA00 7001            	  6086:     moveq   #1,D0
02:0003AA02 41EC0098        	  6087:     lea     ($0098,A4),A0
02:0003AA06 11802000        	  6088:     move.b  D0,(A0,D2.W)
02:0003AA0A 6618            	  6089:     bne  _L_z04_Aquamentus_Move_SetRemainingDistance
                            	  6090:     even
