                            	  8953:     ;
                            	  8954:     ; Change the base segment's object type to the dead dummy.
                            	  8955:     ; Immediately set metastate to $10, instead of waiting for
                            	  8956:     ; the dead dummy object's update routine to do it.
                            	  8957:     ; Also set its timer to $10.
                            	  8958:     ;
02:0003BEEA 61001A86        	  8959:     jsr     PlayBossDeathCry
02:0003BEEE 705D            	  8960:     moveq   #93,D0
02:0003BEF0 19400354        	  8961:     move.b  D0,($0354,A4)
02:0003BEF4 7010            	  8962:     moveq   #16,D0
02:0003BEF6 1940040A        	  8963:     move.b  D0,($040A,A4)
02:0003BEFA 1940002D        	  8964:     move.b  D0,($002D,A4)
                            	  8965:     even
