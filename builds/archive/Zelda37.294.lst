02:0004A466 7000            	  5581:     moveq   #0,D0
02:0004A468 1940000F        	  5582:     move.b  D0,($000F,A4)
                            	  5583:     ; Get reverse index of weapon's direction, and base sprite attribute 0,
                            	  5584:     ; and go draw.
                            	  5585:     ;
02:0004A46C 41EC0098        	  5586:     lea     ($0098,A4),A0
02:0004A470 10302000        	  5587:     move.b  (A0,D2.W),D0
02:0004A474 4EB9000304AA    	  5588:     jsr     GetOppositeDir
02:0004A47A 7000            	  5589:     moveq   #0,D0
02:0004A47C 6000FEF0        	  5590:     jmp     SetAttrAndDrawArrow
