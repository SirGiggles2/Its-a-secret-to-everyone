02:0003B0B4 7008            	  7079:     moveq   #8,D0
02:0003B0B6 4EB90004AD88    	  7080:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  7081:     ; If facing left, then enable horizontal flipping.
                            	  7082:     ;
02:0003B0BC 41EC0098        	  7083:     lea     ($0098,A4),A0
02:0003B0C0 10302000        	  7084:     move.b  (A0,D2.W),D0
02:0003B0C4 0C000002        	  7085:     cmpi.b  #$02,D0
02:0003B0C8 6604            	  7086:     bne  _anon_z04_94
02:0003B0CA 522C000F        	  7087:     addq.b  #1,($000F,A4)
                            	  7088: _anon_z04_94:
                            	  7089:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  7090:     ; This is the base frame image.
                            	  7091:     ;
02:0003B0CE E208            	  7092:     lsr.b  #1,D0   ; LSR A
02:0003B0D0 E208            	  7093:     lsr.b  #1,D0   ; LSR A
                            	  7094:     ; If movement frame = 1, add 3 to frame image to access
                            	  7095:     ; the second animation frame's images.
                            	  7096:     ;
02:0003B0D2 7600            	  7097:     moveq   #0,D3
02:0003B0D4 41EC03E4        	  7098:     lea     ($03E4,A4),A0
02:0003B0D8 16302000        	  7099:     move.b  (A0,D2.W),D3
02:0003B0DC 671E            	  7100:     beq  _anon_z04_95
02:0003B0DE 023C00EE        	  7101:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B0E2 123C0003        	  7102:     move.b  #$03,D1
02:0003B0E6 D101            	  7103:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  7104:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  7105:     ;
                            	  7106:     ; Down has two frame images, but up only has one. By flipping
                            	  7107:     ; horizontally, you get two frame images.
                            	  7108:     ;
02:0003B0E8 7600            	  7109:     moveq   #0,D3
02:0003B0EA 41EC0098        	  7110:     lea     ($0098,A4),A0
02:0003B0EE 16302000        	  7111:     move.b  (A0,D2.W),D3
02:0003B0F2 0C030008        	  7112:     cmpi.b  #$08,D3
02:0003B0F6 6604            	  7113:     bne  _anon_z04_95
02:0003B0F8 522C000F        	  7114:     addq.b  #1,($000F,A4)
