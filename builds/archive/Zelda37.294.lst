02:0003BC20 13C00000042E    	  8587:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DIRCOUNTERV).l
02:0003BC26 13C000000382    	  8588:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DIRCOUNTERV).l
02:0003BC2C 13C0000003AA    	  8589:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DIRCOUNTERV).l
