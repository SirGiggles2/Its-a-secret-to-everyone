                            	 11613:     ; TODO: ?
                            	 11614:     ;
02:0003D2CE 103C0080        	 11615:     move.b  #$80,D0
02:0003D2D2 41EC0098        	 11616:     lea     ($0098,A4),A0
02:0003D2D6 11802000        	 11617:     move.b  D0,(A0,D2.W)
                            	 11618:     ; Set angle $18 (N).
                            	 11619:     ;
02:0003D2DA 7018            	 11620:     moveq   #24,D0
02:0003D2DC 41EC0394        	 11621:     lea     ($0394,A4),A0
02:0003D2E0 11802000        	 11622:     move.b  D0,(A0,D2.W)
                            	 11623:     ; This location is right above Patra.
                            	 11624:     ; Set X coordinate to Patra's.
