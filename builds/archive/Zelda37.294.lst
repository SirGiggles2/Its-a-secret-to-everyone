02:0003AAA0 0C000055        	  6181:     cmpi.b  #$55,D0
02:0003AAA4 6626            	  6182:     bne  _L_z04_Aquamentus_Shoot_NextLoopObject
                            	  6183:     ; Every other screen frame, loop again.
