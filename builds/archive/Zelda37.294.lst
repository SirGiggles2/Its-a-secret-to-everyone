                            	  5540: HandleArrowOrBoomerangBlocked:
                            	  5541:     ; Use animation counter to count down 3 screen frames in case the state is $20 (spark).
                            	  5542:     ;
02:0004A41E 7003            	  5543:     moveq   #3,D0
02:0004A420 41EC03D0        	  5544:     lea     ($03D0,A4),A0
02:0004A424 11802000        	  5545:     move.b  D0,(A0,D2.W)
                            	  5546:     ; Add $10 to the state to make it $2x.
                            	  5547:     ;
02:0004A428 41EC00AC        	  5548:     lea     ($00AC,A4),A0
02:0004A42C 10302000        	  5549:     move.b  (A0,D2.W),D0
02:0004A430 023C00EE        	  5550:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004A434 123C0010        	  5551:     move.b  #$10,D1
02:0004A438 D101            	  5552:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0004A43A 41EC00AC        	  5553:     lea     ($00AC,A4),A0
02:0004A43E 11802000        	  5554:     move.b  D0,(A0,D2.W)
                            	  5555:     even
