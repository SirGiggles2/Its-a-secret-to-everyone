02:0002BFAC 670A            	  2471:     beq.s   .cc_cnras
02:0002BFAE 003C0001        	  2472:     ori     #$01,CCR
02:0002BFB2 0A3C0001        	  2473:     eori    #$01,CCR
02:0002BFB6 4E75            	  2474:     rts
                            	  2475: .cc_cnras:
02:0002BFB8 023C00FE        	  2476:     andi    #$FE,CCR
02:0002BFBC 0A3C0001        	  2477:     eori    #$01,CCR
