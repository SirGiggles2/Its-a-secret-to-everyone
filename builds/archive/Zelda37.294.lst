                            	  6435: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  6436:     ; Bloated timer =>
                            	  6437:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6438:     ; 1:     go advance the substate
                            	  6439:     ; other: go decrement Bloated timer
                            	  6440:     ;
02:0003AC80 7600            	  6441:     moveq   #0,D3
02:0003AC82 41EC045E        	  6442:     lea     ($045E,A4),A0
02:0003AC86 16302000        	  6443:     move.b  (A0,D2.W),D3
02:0003AC8A 5303            	  6444:     subq.b  #1,D3
02:0003AC8C 6750            	  6445:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003AC8E 6B04            	  6446:     bmi.s  __far_z_04_0056
02:0003AC90 60000080        	  6447:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6448: __far_z_04_0056:
                            	  6449:     ; Set the bloated timer according to the substate.
                            	  6450:     ;
02:0003AC94 7600            	  6451:     moveq   #0,D3
02:0003AC96 41EC042C        	  6452:     lea     ($042C,A4),A0
02:0003AC9A 16302000        	  6453:     move.b  (A0,D2.W),D3
02:0003AC9E 41F90003ABDC    	  6454:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003ACA4 10303000        	  6455:     move.b  (A0,D3.W),D0
02:0003ACA8 41EC045E        	  6456:     lea     ($045E,A4),A0
02:0003ACAC 11802000        	  6457:     move.b  D0,(A0,D2.W)
                            	  6458:     ; If substate <> 0, go decrement bloated timer.
                            	  6459:     ;
02:0003ACB0 4A03            	  6460:     cmpi.b  #$00,D3
02:0003ACB2 6702            	  6461:     beq.s  __far_z_04_0057
02:0003ACB4 605C            	  6462:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  6463: __far_z_04_0057:
                            	  6464:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  6465:     ;
02:0003ACB6 7610            	  6466:     moveq   #16,D3
02:0003ACB8 7000            	  6467:     moveq   #0,D0
02:0003ACBA 41EC00AC        	  6468:     lea     ($00AC,A4),A0
02:0003ACBE 11803000        	  6469:     move.b  D0,(A0,D3.W)
                            	  6470:     ; Increment the number of bomb hits.
                            	  6471:     ;
02:0003ACC2 41EC0437        	  6472:     lea     ($0437,A4),A0
02:0003ACC6 10302000        	  6473:     move.b  (A0,D2.W),D0
02:0003ACCA 023C00EE        	  6474:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003ACCE 123C0001        	  6475:     move.b  #$01,D1
02:0003ACD2 D101            	  6476:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003ACD4 41EC0437        	  6477:     lea     ($0437,A4),A0
02:0003ACD8 11802000        	  6478:     move.b  D0,(A0,D2.W)
02:0003ACDC 6034            	  6479:     jmp     L_Dodongo_DecrementBloatedTimer
