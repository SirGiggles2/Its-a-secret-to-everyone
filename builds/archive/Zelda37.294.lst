02:00038462 52302000        	   789:     addq.b  #1,(A0,D2.W)
                            	   790:     ; If the push timer still < $10, return.
                            	   791:     ;
02:00038466 7600            	   792:     moveq   #0,D3
02:00038468 41EC0412        	   793:     lea     ($0412,A4),A0
02:0003846C 16302000        	   794:     move.b  (A0,D2.W),D3
02:00038470 0C030010        	   795:     cmpi.b  #$10,D3
02:00038474 6402            	   796:     bcc.s  __far_z_04_0009
