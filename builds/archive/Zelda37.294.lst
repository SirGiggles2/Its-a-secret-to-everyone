                            	  7175: _L_z04_UpdatePolsVoice_State0:
                            	  7176:     ; State 0. Walking.
                            	  7177:     ;
                            	  7178:     ; If grid offset = 0, then no more distance to cover.
                            	  7179:     ; So, go change to state 1 -- jumping.
                            	  7180:     ;
02:0003B162 41EC0394        	  7181:     lea     ($0394,A4),A0
02:0003B166 10302000        	  7182:     move.b  (A0,D2.W),D0
02:0003B16A 67000084        	  7183:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  7184:     ; Decrement grid offset / distance remaining.
                            	  7185:     ;
02:0003B16E 41EC0394        	  7186:     lea     ($0394,A4),A0
02:0003B172 53302000        	  7187:     subq.b  #1,(A0,D2.W)
                            	  7188:     ; Move vertically.
                            	  7189:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  7190:     ;
02:0003B176 41EC0084        	  7191:     lea     ($0084,A4),A0
02:0003B17A 10302000        	  7192:     move.b  (A0,D2.W),D0
02:0003B17E 023C00EE        	  7193:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B182 41F90003B112    	  7194:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0003B188 12303000        	  7195:     move.b  (A0,D3.W),D1
02:0003B18C D101            	  7196:     addx.b  D1,D0   ; ADC PolsVoiceWalkSpeedsY,Y
02:0003B18E 41EC0084        	  7197:     lea     ($0084,A4),A0
02:0003B192 11802000        	  7198:     move.b  D0,(A0,D2.W)
                            	  7199:     even
                            	  7200: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  7201:     ; If the square the monster is over is walkable, then
                            	  7202:     ; go draw and check object collisions.
                            	  7203:     ;
02:0003B196 610001F4        	  7204:     jsr     PolsVoice_IsSquareWalkable
02:0003B19A 6452            	  7205:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7206:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  7207:     ; then go change to state 1.
                            	  7208:     ;
02:0003B19C 41EC041F        	  7209:     lea     ($041F,A4),A0
02:0003B1A0 10302000        	  7210:     move.b  (A0,D2.W),D0
02:0003B1A4 020000FC        	  7211:     andi.b #$FC,D0
02:0003B1A8 0C0000B0        	  7212:     cmpi.b  #$B0,D0
02:0003B1AC 6742            	  7213:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0003B1AE 0C0000F4        	  7214:     cmpi.b  #$F4,D0
02:0003B1B2 643C            	  7215:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  7216:     ; Else blocked by something else.
                            	  7217:     ;
                            	  7218:     ; If facing horizontally, then go flip the direction, move, and draw.
                            	  7219:     ;
02:0003B1B4 41EC0098        	  7220:     lea     ($0098,A4),A0
02:0003B1B8 10302000        	  7221:     move.b  (A0,D2.W),D0
02:0003B1BC 02000003        	  7222:     andi.b #$03,D0
02:0003B1C0 6618            	  7223:     bne  _L_z04_UpdatePolsVoice_FlipHorizontally
                            	  7224:     ; Else facing vertically. Flip the direction.
                            	  7225:     ; Go draw.
                            	  7226:     ;
02:0003B1C2 41EC0098        	  7227:     lea     ($0098,A4),A0
02:0003B1C6 10302000        	  7228:     move.b  (A0,D2.W),D0
02:0003B1CA 0A00000C        	  7229:     eori.b #$0C,D0
02:0003B1CE 41EC0098        	  7230:     lea     ($0098,A4),A0
02:0003B1D2 11802000        	  7231:     move.b  D0,(A0,D2.W)
02:0003B1D6 6000008C        	  7232:     jmp     L_PolsVoice_DrawAndCheckCollisions
                            	  7233: 
                            	  7234:     even
                            	  7235: _L_z04_UpdatePolsVoice_FlipHorizontally:
                            	  7236:     ; Facing horizontally. Flip the direction.
                            	  7237:     ; Move two pixels, and go draw.
                            	  7238:     ;
02:0003B1DA 0A000003        	  7239:     eori.b #$03,D0
02:0003B1DE 41EC0098        	  7240:     lea     ($0098,A4),A0
02:0003B1E2 11802000        	  7241:     move.b  D0,(A0,D2.W)
02:0003B1E6 610001B0        	  7242:     jsr     PolsVoice_MoveX
