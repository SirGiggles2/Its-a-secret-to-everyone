02:0002BF88 08000008        	  2457:     btst    #8,D0
02:0002BF8C 670A            	  2458:     beq.s   .cc_cnr
02:0002BF8E 003C0001        	  2459:     ori     #$01,CCR
02:0002BF92 0A3C0001        	  2460:     eori    #$01,CCR
02:0002BF96 4E75            	  2461:     rts
                            	  2462: .cc_cnr:
02:0002BF98 023C00FE        	  2463:     andi    #$FE,CCR
02:0002BF9C 0A3C0001        	  2464:     eori    #$01,CCR
02:0002BFA0 4E75            	  2465:     rts
