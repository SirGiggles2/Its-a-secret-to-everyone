02:0003C100 19410002        	  9227:     move.b  D1,($0002,A4)
02:0003C104 122C0002        	  9228:     move.b  ($0002,A4),D1
02:0003C108 C200            	  9229:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C10A 6704            	  9230:     beq  _anon_z04_119
