                            	  5375:     ;
02:0003A480 41EC03BC        	  5376:     lea     ($03BC,A4),A0
02:0003A484 10302000        	  5377:     move.b  (A0,D2.W),D0
02:0003A488 6712            	  5378:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0003A48A 41EC0098        	  5379:     lea     ($0098,A4),A0
02:0003A48E 11802000        	  5380:     move.b  D0,(A0,D2.W)
02:0003A492 7000            	  5381:     moveq   #0,D0
02:0003A494 41EC03BC        	  5382:     lea     ($03BC,A4),A0
