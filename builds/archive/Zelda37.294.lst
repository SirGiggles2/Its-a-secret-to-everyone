                            	  6878: Dodongo_Draw:
02:0003AF58 610000F4        	  6879:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  6880:     ; Make a 5-way direction index out of the facing direction
                            	  6881:     ; by shifting right once, and store it in [00].
                            	  6882:     ;
02:0003AF5C 41EC0098        	  6883:     lea     ($0098,A4),A0
02:0003AF60 10302000        	  6884:     move.b  (A0,D2.W),D0
02:0003AF64 E208            	  6885:     lsr.b  #1,D0   ; LSR A
02:0003AF66 1880            	  6886:     move.b  D0,($0000,A4)
                            	  6887:     ; If state = 0, go handle animating the two frames of this state.
                            	  6888:     ;
02:0003AF68 7600            	  6889:     moveq   #0,D3
02:0003AF6A 41EC00AC        	  6890:     lea     ($00AC,A4),A0
02:0003AF6E 16302000        	  6891:     move.b  (A0,D2.W),D3
02:0003AF72 6744            	  6892:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  6893:     ; If state > 1, then the monster is stunned (state 2).
                            	  6894:     ; So, go switch frames every $20 screen frames.
                            	  6895:     ;
02:0003AF74 7020            	  6896:     moveq   #32,D0
02:0003AF76 5303            	  6897:     subq.b  #1,D3
02:0003AF78 6640            	  6898:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  6899:     ; State = 1. Bloated.
                            	  6900:     ;
                            	  6901:     ; In substate 0, go animate as usual for walking.
                            	  6902:     ;
02:0003AF7A 7600            	  6903:     moveq   #0,D3
02:0003AF7C 41EC042C        	  6904:     lea     ($042C,A4),A0
02:0003AF80 16302000        	  6905:     move.b  (A0,D2.W),D3
02:0003AF84 6732            	  6906:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  6907:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  6908:     ; go fade the boss; so that some frames are not drawn.
                            	  6909:     ;
02:0003AF86 0C030002        	  6910:     cmpi.b  #$02,D3
02:0003AF8A 6718            	  6911:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003AF8C 0C030003        	  6912:     cmpi.b  #$03,D3
02:0003AF90 6712            	  6913:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  6914:     ; State 1, substate 1
                            	  6915:     ;
                            	  6916:     ; Add $14 to the frame image index to index into the bloated
                            	  6917:     ; frame images and H-flips.
                            	  6918:     ;
02:0003AF92 1014            	  6919:     move.b  ($0000,A4),D0
02:0003AF94 023C00EE        	  6920:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AF98 123C0014        	  6921:     move.b  #$14,D1
02:0003AF9C D101            	  6922:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003AF9E 7600            	  6923:     moveq   #0,D3
02:0003AFA0 1600            	  6924:     move.b  D0,D3
02:0003AFA2 6032            	  6925:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  6926: 
                            	  6927:     even
                            	  6928: _L_z04_Dodongo_Draw_DrawFaded:
                            	  6929:     ; In bloated substates 2 and 3:
                            	  6930:     ; Every two screen frames, don't draw for two frames. Return.
                            	  6931:     ;
02:0003AFA4 102C0015        	  6932:     move.b  ($0015,A4),D0
02:0003AFA8 02000002        	  6933:     andi.b #$02,D0
02:0003AFAC 6604            	  6934:     bne.s  __far_z_04_0064
02:0003AFAE 600000A4        	  6935:     jmp  L11B00_Exit
                            	  6936: __far_z_04_0064:
02:0003AFB2 7600            	  6937:     moveq   #0,D3
02:0003AFB4 1614            	  6938:     move.b  ($0000,A4),D3
02:0003AFB6 601E            	  6939:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  6940: 
                            	  6941:     even
                            	  6942: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  6943:     ; Every 8 screen frames, switch between 2 animation frames.
                            	  6944:     ;
02:0003AFB8 7008            	  6945:     moveq   #8,D0
                            	  6946:     even
                            	  6947: _L_z04_Dodongo_Draw_DrawWalking:
02:0003AFBA 7600            	  6948:     moveq   #0,D3
02:0003AFBC 1614            	  6949:     move.b  ($0000,A4),D3
02:0003AFBE 122C0015        	  6950:     move.b  ($0015,A4),D1
02:0003AFC2 C001            	  6951:     and.b  D1,D0
02:0003AFC4 6710            	  6952:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  6953:     ; For animation frame 1, add 5 to the index in Y register,
                            	  6954:     ; in order to index into the second set of frame image numbers.
                            	  6955:     ;
02:0003AFC6 1003            	  6956:     move.b  D3,D0
02:0003AFC8 023C00EE        	  6957:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AFCC 123C0005        	  6958:     move.b  #$05,D1
02:0003AFD0 D101            	  6959:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003AFD2 7600            	  6960:     moveq   #0,D3
02:0003AFD4 1600            	  6961:     move.b  D0,D3
                            	  6962:     even
                            	  6963: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  6964:     ; Start preparing sprites.
                            	  6965:     ;
02:0003AFD6 4EB90004AD8E    	  6966:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003AFDC 1003            	  6967:     move.b  D3,D0
02:0003AFDE 1B00            	  6968:     move.b  D0,-(A5)  ; PHA
                            	  6969:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  6970:     ;
02:0003AFE0 41F90003AF3A    	  6971:     lea     (DodongoFrameHFlips).l,A0
02:0003AFE6 10303000        	  6972:     move.b  (A0,D3.W),D0
02:0003AFEA 1940000F        	  6973:     move.b  D0,($000F,A4)
02:0003AFEE 41F90003AF30    	  6974:     lea     (DodongoFrameImages).l,A0
02:0003AFF4 10303000        	  6975:     move.b  (A0,D3.W),D0
                            	  6976:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  6977:     ; They are drawn mirrored.
                            	  6978:     ;
02:0003AFF8 0C000007        	  6979:     cmpi.b  #$07,D0
02:0003AFFC 6706            	  6980:     beq  _anon_z04_92
02:0003AFFE 0C000009        	  6981:     cmpi.b  #$09,D0
02:0003B002 6608            	  6982:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  6983: _anon_z04_92:
02:0003B004 4EB900030876    	  6984:     jsr     DrawObjectMirrored
02:0003B00A 6006            	  6985:     jmp     _L_z04_Dodongo_Draw_DrawRightSide
                            	  6986: 
                            	  6987:     even
                            	  6988: _L_z04_Dodongo_Draw_DrawLeftSide:
                            	  6989:     ; No other frame images are mirrored.
                            	  6990:     ;
02:0003B00C 4EB90003087A    	  6991:     jsr     DrawObjectNotMirrored
                            	  6992:     even
                            	  6993: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003B012 101D            	  6994:     move.b  (A5)+,D0  ; PLA
02:0003B014 7600            	  6995:     moveq   #0,D3
02:0003B016 1600            	  6996:     move.b  D0,D3
                            	  6997:     ; If facing vertically, then return. There's no other side to draw.
                            	  6998:     ;
02:0003B018 41EC0098        	  6999:     lea     ($0098,A4),A0
02:0003B01C 10302000        	  7000:     move.b  (A0,D2.W),D0
02:0003B020 02000003        	  7001:     andi.b #$03,D0
02:0003B024 6602            	  7002:     bne.s  __far_z_04_0065
02:0003B026 602C            	  7003:     jmp  L11B00_Exit
                            	  7004: __far_z_04_0065:
                            	  7005:     ; Else draw the right side.
                            	  7006:     ;
                            	  7007:     ; Keep the Y coordinate in [01].
                            	  7008:     ; But, store (X + $10) in [00].
                            	  7009:     ;
02:0003B028 10342070        	  7010:     move.b  ($70,A4,D2.W),D0
02:0003B02C 023C00EE        	  7011:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B030 123C0010        	  7012:     move.b  #$10,D1
02:0003B034 D101            	  7013:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003B036 1880            	  7014:     move.b  D0,($0000,A4)
02:0003B038 6114            	  7015:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7016:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7017:     ;
                            	  7018:     ; So, if we had animation frame 1, direction left:
                            	  7019:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7020:     ; - frame image index = 6 (1 + 5)
                            	  7021:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7022:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7023:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7024:     ;
                            	  7025:     ; So, 3 would have been the frame number used above for
                            	  7026:     ; the left side.
                            	  7027:     ;
                            	  7028:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7029:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7030:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7031:     ; on the right.
                            	  7032:     ;
02:0003B03A 41F90003AF30    	  7033:     lea     (DodongoFrameImages).l,A0
02:0003B040 10303000        	  7034:     move.b  (A0,D3.W),D0
02:0003B044 0A000001        	  7035:     eori.b #$01,D0
02:0003B048 4EF90003087A    	  7036:     jmp     DrawObjectNotMirrored
                            	  7037: 
                            	  7038: ; Returns:
                            	  7039: ; A: 3
                            	  7040: ; [04]: left sprite attributes
                            	  7041: ; [05]: right sprite attributes
                            	  7042: ;
                            	  7043:     even
