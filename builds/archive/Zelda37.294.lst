                            	  7325:     ;
02:0003B28E 41EC0444        	  7326:     lea     ($0444,A4),A0
02:0003B292 10302000        	  7327:     move.b  (A0,D2.W),D0
02:0003B296 023C00EE        	  7328:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B29A 123C0038        	  7329:     move.b  #$38,D1
02:0003B29E D101            	  7330:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003B2A0 41EC0444        	  7331:     lea     ($0444,A4),A0
02:0003B2A4 11802000        	  7332:     move.b  D0,(A0,D2.W)
                            	  7333:     ; Add Carry to high speed byte (vertical).
