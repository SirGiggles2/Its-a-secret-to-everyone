02:0003C1C4 53302000        	  9321:     subq.b  #1,(A0,D2.W)
                            	  9322:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9323:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9324:     ;
02:0003C1C8 7602            	  9325:     moveq   #2,D3
02:0003C1CA 0C000070        	  9326:     cmpi.b  #$70,D0
02:0003C1CE 6408            	  9327:     bcc  _anon_z04_123
