                            	  7724: __far_z_07_0123:
                            	  7725:     ; 7 of every 8 frames, return.
                            	  7726:     ;
02:0004B5B6 102C0015        	  7727:     move.b  ($0015,A4),D0
02:0004B5BA 02000007        	  7728:     andi.b #$07,D0
02:0004B5BE 0C000004        	  7729:     cmpi.b  #$04,D0
02:0004B5C2 6702            	  7730:     beq.s  __far_z_07_0124
02:0004B5C4 604C            	  7731:     jmp  L1FF28_Exit
                            	  7732: __far_z_07_0124:
                            	  7733:     ; So, every 8 frames:
                            	  7734:     ; 1. Increment the secret color cycle count.
                            	  7735:     ; 2. Change the water palette.
                            	  7736:     ;
                            	  7737:     ; But when the count = $B, go reveal the stairs.
                            	  7738:     ;
02:0004B5C6 522C051A        	  7739:     addq.b  #1,($051A,A4)
02:0004B5CA 0C03000B        	  7740:     cmpi.b  #$0B,D3
02:0004B5CE 6602            	  7741:     bne.s  __far_z_07_0125
02:0004B5D0 6042            	  7742:     jmp  RevealPondStairs
