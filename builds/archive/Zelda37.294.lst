02:000388C8 10302000        	  1378:     move.b  (A0,D2.W),D0
02:000388CC 664E            	  1379:     bne  _L_z04_Zol_CheckCollisions_Exit
02:000388CE 41EC04F0        	  1380:     lea     ($04F0,A4),A0
02:000388D2 10302000        	  1381:     move.b  (A0,D2.W),D0
02:000388D6 6744            	  1382:     beq  _L_z04_Zol_CheckCollisions_Exit
                            	  1383:     ; If vertically aligned with the square grid, then
                            	  1384:     ; use a horizontal direction mask (3).
                            	  1385:     ;
                            	  1386:     ; Keep in mind that most objects are aligned vertically when
                            	  1387:     ; the low nibble of their Y is $D.
                            	  1388:     ;
