                            	   513: UpdateMode0Demo_Sub2:
                            	   514:     ; Copy data from each save file A to save slot info.
                            	   515:     ; Most of the game will deal with save slot info.
                            	   516:     ; Format each inactive file A, to make sure it's clear.
                            	   517:     ;
02:00031E46 4EB9000489DE    	   518:     jsr     TurnOffAllVideo
02:00031E4C 7000            	   519:     moveq   #0,D0
02:00031E4E 19400016        	   520:     move.b  D0,($0016,A4)
02:00031E52 6100E5E2        	   521:     jsr     FetchFileAAddressSet
02:00031E56 7602            	   522:     moveq   #2,D3
                            	   523:     even
                            	   524: _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot:
02:00031E58 122C0006        	   525:     move.b  ($06,A4),D1   ; ptr lo
02:00031E5C 182C0007        	   526:     move.b  ($07,A4),D4  ; ptr hi
02:00031E60 024100FF        	   527:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031E64 E14C            	   528:     lsl.w   #8,D4
02:00031E66 8841            	   529:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031E68 48C4            	   530:     ext.l   D4
02:00031E6A D8BC00FF0000    	   531:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031E70 2044            	   532:     movea.l D4,A0
02:00031E72 10303000        	   533:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031E76 41EC0633        	   534:     lea     ($0633,A4),A0
02:00031E7A 11803000        	   535:     move.b  D0,(A0,D3.W)
02:00031E7E 6620            	   536:     bne  _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot
02:00031E80 1003            	   537:     move.b  D3,D0
02:00031E82 1B00            	   538:     move.b  D0,-(A5)  ; PHA
02:00031E84 19430016        	   539:     move.b  D3,($0016,A4)
02:00031E88 6100E5AC        	   540:     jsr     FetchFileAAddressSet
02:00031E8C 61001C1C        	   541:     jsr     FormatFileA
02:00031E90 7000            	   542:     moveq   #0,D0
02:00031E92 19400016        	   543:     move.b  D0,($0016,A4)
                            	   544:     ; Fetch the address set for slot 0 again,
                            	   545:     ; so that we can keep referring to its
                            	   546:     ; IsSaveSlotActive address as a table base.
                            	   547:     ;
                            	   548:     ; After this, the slot is still not active, but it will
                            	   549:     ; definitely be clear.
02:00031E96 6100E59E        	   550:     jsr     FetchFileAAddressSet
02:00031E9A 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00031E9C 7600            	   552:     moveq   #0,D3
02:00031E9E 1600            	   553:     move.b  D0,D3
                            	   554:     even
                            	   555: _L_z02_UpdateMode0Demo_Sub2_NextFormatSlot:
02:00031EA0 122C000A        	   556:     move.b  ($0A,A4),D1   ; ptr lo
02:00031EA4 182C000B        	   557:     move.b  ($0B,A4),D4  ; ptr hi
02:00031EA8 024100FF        	   558:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031EAC E14C            	   559:     lsl.w   #8,D4
02:00031EAE 8841            	   560:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031EB0 48C4            	   561:     ext.l   D4
02:00031EB2 D8BC00FF0000    	   562:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031EB8 2044            	   563:     movea.l D4,A0
02:00031EBA 10303000        	   564:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031EBE 41EC0630        	   565:     lea     ($0630,A4),A0
02:00031EC2 11803000        	   566:     move.b  D0,(A0,D3.W)
02:00031EC6 122C000C        	   567:     move.b  ($0C,A4),D1   ; ptr lo
02:00031ECA 182C000D        	   568:     move.b  ($0D,A4),D4  ; ptr hi
02:00031ECE 024100FF        	   569:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031ED2 E14C            	   570:     lsl.w   #8,D4
02:00031ED4 8841            	   571:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031ED6 48C4            	   572:     ext.l   D4
02:00031ED8 D8BC00FF0000    	   573:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031EDE 2044            	   574:     movea.l D4,A0
02:00031EE0 10303000        	   575:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031EE4 41EC062D        	   576:     lea     ($062D,A4),A0
02:00031EE8 11803000        	   577:     move.b  D0,(A0,D3.W)
02:00031EEC 5303            	   578:     subq.b  #1,D3
02:00031EEE 6A00FF68        	   579:     bpl  _L_z02_UpdateMode0Demo_Sub2_LoopFormatSlot
