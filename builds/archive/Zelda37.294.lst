                            	  2335: _L_z04_UpdateTektiteOrBoulder_SetUpJump:
                            	  2336:     ; If reversal count >= 2, then
                            	  2337:     ; 1. invert the horizontal component of facing direction,
                            	  2338:     ;    to face away from the chase target
                            	  2339:     ; 2. reset the reversal count to 0.
                            	  2340:     ;
                            	  2341:     ; This prevents a jumper from getting stuck in a corner.
                            	  2342:     ;
                            	  2343:     ; For example, if a tektite's direction is down and right,
                            	  2344:     ; and jumps into the top right corner of the room:
                            	  2345:     ; 1. The right room boundary is hit. So the direction is
                            	  2346:     ;    automatically reversed to up and left.
                            	  2347:     ; 2. The next frame, the top room boundary is hit.
                            	  2348:     ;    The direction is reversed to down and right.
                            	  2349:     ;
                            	  2350:     ; As you can see, an endless loop has been made.
                            	  2351:     ;
02:00038ED8 41EC0451        	  2352:     lea     ($0451,A4),A0
02:00038EDC 10302000        	  2353:     move.b  (A0,D2.W),D0
02:00038EE0 0C000002        	  2354:     cmpi.b  #$02,D0
02:00038EE4 651E            	  2355:     bcs  _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump
02:00038EE6 41EC0098        	  2356:     lea     ($0098,A4),A0
02:00038EEA 10302000        	  2357:     move.b  (A0,D2.W),D0
02:00038EEE 0A000003        	  2358:     eori.b #$03,D0
02:00038EF2 41EC0098        	  2359:     lea     ($0098,A4),A0
02:00038EF6 11802000        	  2360:     move.b  D0,(A0,D2.W)
02:00038EFA 7000            	  2361:     moveq   #0,D0
02:00038EFC 41EC0451        	  2362:     lea     ($0451,A4),A0
02:00038F00 11802000        	  2363:     move.b  D0,(A0,D2.W)
                            	  2364:     even
                            	  2365: _L_z04_UpdateTektiteOrBoulder_FinishSetUpJump:
                            	  2366:     ; If the object is a boulder, then make sure its facing direction
                            	  2367:     ; has a down vertical component.
