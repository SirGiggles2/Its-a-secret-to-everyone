                            	 13233: TurnTowardsPlayer8:
                            	 13234:     ; Build a direction in [00] towards the player.
                            	 13235:     ;
                            	 13236:     ; First, calculate a horizontal component:
                            	 13237:     ;
                            	 13238:     ; If   observed player X = object X, [00] := 0 (none)
                            	 13239:     ; elif observed player X > object X, [00] := 1 (right)
                            	 13240:     ; else                               [00] := 2 (left)
                            	 13241:     ;
02:0003DE20 7600            	 13242:     moveq   #0,D3
02:0003DE22 1883            	 13243:     move.b  D3,($0000,A4)
02:0003DE24 5203            	 13244:     addq.b  #1,D3
02:0003DE26 102C0061        	 13245:     move.b  ($0061,A4),D0
02:0003DE2A 12342070        	 13246:     move.b  ($70,A4,D2.W),D1
02:0003DE2E B001            	 13247:     cmp.b   D1,D0
02:0003DE30 6706            	 13248:     beq  _L_z04_TurnTowardsPlayer8_CalcVertical
02:0003DE32 6402            	 13249:     bcc  _anon_z04_175
02:0003DE34 5203            	 13250:     addq.b  #1,D3
                            	 13251: _anon_z04_175:
02:0003DE36 1883            	 13252:     move.b  D3,($0000,A4)
                            	 13253:     even
                            	 13254: _L_z04_TurnTowardsPlayer8_CalcVertical:
                            	 13255:     ; Second, calculate a vertical component.
                            	 13256:     ; Combine it with the horizontal component:
                            	 13257:     ;
                            	 13258:     ; Y := 4 (down)
                            	 13259:     ; if observed player Y <> object Y then
                            	 13260:     ;   if observed player Y < object Y then
                            	 13261:     ;     Y := Y << 1   -- makes it 8 (up)
                            	 13262:     ;   [00] := [00] | Y
                            	 13263:     ;
02:0003DE38 7601            	 13264:     moveq   #1,D3
02:0003DE3A 102C0062        	 13265:     move.b  ($0062,A4),D0
02:0003DE3E 41EC0084        	 13266:     lea     ($0084,A4),A0
02:0003DE42 12302000        	 13267:     move.b  (A0,D2.W),D1
02:0003DE46 B001            	 13268:     cmp.b   D1,D0
02:0003DE48 6710            	 13269:     beq  _L_z04_TurnTowardsPlayer8_SkipVertical
02:0003DE4A 6402            	 13270:     bcc  _anon_z04_176
02:0003DE4C 5203            	 13271:     addq.b  #1,D3
                            	 13272: _anon_z04_176:
