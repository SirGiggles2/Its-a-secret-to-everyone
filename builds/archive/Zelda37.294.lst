02:00038FD2 60000090        	  2471:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2472: __far_z_04_0020:
                            	  2473:     ; Going down. We have to consider the target Y.
                            	  2474:     ;
                            	  2475:     ; If the absolute vertical distance to the target position >= 3,
                            	  2476:     ; then go animate, draw, and check collisions.
                            	  2477:     ;
02:00038FD6 41EC0084        	  2478:     lea     ($0084,A4),A0
02:00038FDA 10302000        	  2479:     move.b  (A0,D2.W),D0
02:00038FDE 003C0011        	  2480:     ori     #$11,CCR  ; SEC: set C+X
02:00038FE2 41EC0444        	  2481:     lea     ($0444,A4),A0
02:00038FE6 12302000        	  2482:     move.b  (A0,D2.W),D1
02:00038FEA 0A3C0010        	  2483:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00038FEE 9101            	  2484:     subx.b  D1,D0   ; SBC Jumper_ObjTargetY,X
02:00038FF0 0A3C0010        	  2485:     eori    #$10,CCR  ; restore X = 6502 C
02:00038FF4 4EB9000304AE    	  2486:     jsr     Abs
02:00038FFA 0C000003        	  2487:     cmpi.b  #$03,D0
02:00038FFE 6502            	  2488:     bcs.s  __far_z_04_0021
02:00039000 6062            	  2489:     jmp  Jumper_AnimateAndCheckCollisions
                            	  2490: __far_z_04_0021:
                            	  2491:     ; Distance < 3. Go to state 0.
                            	  2492:     ;
                            	  2493:     ; If the object is a boulder, then go reset timer, animate, draw.
                            	  2494:     ;
02:00039002 4EB90004A93E    	  2495:     jsr     ResetObjState
02:00039008 7600            	  2496:     moveq   #0,D3
02:0003900A 41EC034F        	  2497:     lea     ($034F,A4),A0
02:0003900E 16302000        	  2498:     move.b  (A0,D2.W),D3
02:00039012 0C030020        	  2499:     cmpi.b  #$20,D3
02:00039016 6748            	  2500:     beq  _L_z04_UpdateTektiteOrBoulder_SetTimerAndAnimate
                            	  2501:     ; Else calculate a timer value.
                            	  2502:     ;
                            	  2503:     ; t := (Random + $10)
                            	  2504:     ; if t < $20 then
                            	  2505:     ;   t := t - $40
                            	  2506:     ;
02:00039018 7010            	  2507:     moveq   #16,D0
02:0003901A 023C00EE        	  2508:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003901E 12342019        	  2509:     move.b  ($19,A4,D2.W),D1
02:00039022 D101            	  2510:     addx.b  D1,D0   ; ADC Random+1,X
02:00039024 0C000020        	  2511:     cmpi.b  #$20,D0
02:00039028 6412            	  2512:     bcc  _anon_z04_39
02:0003902A 003C0011        	  2513:     ori     #$11,CCR  ; SEC: set C+X
02:0003902E 123C0040        	  2514:     move.b  #$40,D1
02:00039032 0A3C0010        	  2515:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039036 9101            	  2516:     subx.b  D1,D0   ; SBC #$40
02:00039038 0A3C0010        	  2517:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2518: _anon_z04_39:
                            	  2519:     ; If the object is a blue tektite, then go use this t.
                            	  2520:     ;
