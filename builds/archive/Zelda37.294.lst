02:00038FA4 163C00FF        	  2453:     move.b  #$FF,D3
02:00038FA8 41EC0098        	  2454:     lea     ($0098,A4),A0
02:00038FAC 10302000        	  2455:     move.b  (A0,D2.W),D0
02:00038FB0 02000002        	  2456:     andi.b #$02,D0
02:00038FB4 6602            	  2457:     bne  _anon_z04_38
