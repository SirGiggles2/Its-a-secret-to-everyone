02:0003D302 102C0085        	 11643:     move.b  ($0085,A4),D0
02:0003D306 003C0011        	 11644:     ori     #$11,CCR  ; SEC: set C+X
02:0003D30A 1214            	 11645:     move.b  ($0000,A4),D1
02:0003D30C 0A3C0010        	 11646:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D310 9101            	 11647:     subx.b  D1,D0   ; SBC $00
02:0003D312 0A3C0010        	 11648:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D316 41EC0084        	 11649:     lea     ($0084,A4),A0
02:0003D31A 11802000        	 11650:     move.b  D0,(A0,D2.W)
