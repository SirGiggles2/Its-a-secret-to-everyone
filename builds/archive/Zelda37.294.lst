                            	  6045: Aquamentus_Move:
                            	  6046:     ; The monster uses grid offset to mean distance remaining.
                            	  6047:     ; If there's more distance to cover, then go move.
                            	  6048:     ;
02:0003A9AE 41EC0394        	  6049:     lea     ($0394,A4),A0
02:0003A9B2 10302000        	  6050:     move.b  (A0,D2.W),D0
02:0003A9B6 662C            	  6051:     bne  _L_z04_Aquamentus_Move_Move
                            	  6052:     ; Set a random distance to move of 7 or $F pixels.
                            	  6053:     ;
02:0003A9B8 10342018        	  6054:     move.b  ($18,A4,D2.W),D0
02:0003A9BC 1B00            	  6055:     move.b  D0,-(A5)  ; PHA
02:0003A9BE 0200000F        	  6056:     andi.b #$0F,D0
02:0003A9C2 00000007        	  6057:     ori.b #$07,D0
02:0003A9C6 41EC0394        	  6058:     lea     ($0394,A4),A0
02:0003A9CA 11802000        	  6059:     move.b  D0,(A0,D2.W)
02:0003A9CE 101D            	  6060:     move.b  (A5)+,D0  ; PLA
                            	  6061:     ; Randomly head left or right.
                            	  6062:     ;
02:0003A9D0 02000001        	  6063:     andi.b #$01,D0
02:0003A9D4 7600            	  6064:     moveq   #0,D3
02:0003A9D6 1600            	  6065:     move.b  D0,D3
02:0003A9D8 5203            	  6066:     addq.b  #1,D3
02:0003A9DA 41EC0098        	  6067:     lea     ($0098,A4),A0
02:0003A9DE 11832000        	  6068:     move.b  D3,(A0,D2.W)
02:0003A9E2 4E75            	  6069:     rts
                            	  6070: 
