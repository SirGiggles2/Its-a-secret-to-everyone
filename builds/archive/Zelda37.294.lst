                            	   907: 
                            	   908: ;------------------------------------------------------------------------------
                            	   909: ; _c_move_object_shim — MoveObject trampoline.
                            	   910: ;
                            	   911: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   912: ;   Input:     D2 = slot (0..11)
                            	   913: ;   Preserves: D2, A4, A5
                            	   914: ;   Clobbers:  D0, D1, D3, A0
                            	   915: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   916: ;
                            	   917: ; GCC side:
                            	   918: ;   void c_move_object(unsigned short slot);
                            	   919: ;     slot arrives as a 16-bit value on the stack.
                            	   920: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   921: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   922: ;   never clobbered by gcc.
                            	   923: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   924: ;   semantics can exist in a pure C port).
                            	   925: ;------------------------------------------------------------------------------
                            	   926: _c_move_object_shim:
                            	   927:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   928:     move.b  #$AA,($0900,A4)
                            	   929:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   930:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   931:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   932:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   933:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   934:     moveq   #0,D0
02:0002B658 3002            	   935:     move.w  D2,D0           ; D0.L = 0000:slot (zero-extended)
02:0002B65A 2F00            	   936:     move.l  D0,-(SP)        ; push 32-bit arg
02:0002B65C 4EB900000000    	   937:     jsr     c_move_object
02:0002B662 588F            	   938:     addq.l  #4,SP           ; pop the 32-bit slot
02:0002B664 4E75            	   939:     rts
                            	   940: 
                            	   941: ;==============================================================================
                            	   942: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   943: ; and tail-call the native asm function.
                            	   944: ;
                            	   945: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   946: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   947: ; sign-extended).
                            	   948: ;==============================================================================
                            	   949: 
                            	   950: ;------------------------------------------------------------------------------
                            	   951: ; void c_copy_bank_to_window(unsigned int bank);
                            	   952: ; Native: D0.w = bank, then jsr _copy_bank_to_window.
                            	   953: ;------------------------------------------------------------------------------
                            	   954: c_copy_bank_to_window:
02:0002B666 202F0004        	   955:     move.l  4(SP),D0        ; D0.L = bank (only low word matters)
02:0002B66A 6000F38E        	   956:     jmp     _copy_bank_to_window
                            	   957: 
                            	   958: ;------------------------------------------------------------------------------
                            	   959: ; unsigned char c_ppu_read_2(void);
                            	   960: ; Native: jsr _ppu_read_2 → result in D0.b.
                            	   961: ; C return: gcc expects result in D0.
                            	   962: ;------------------------------------------------------------------------------
                            	   963: c_ppu_read_2:
02:0002B66E 4EF90000E034    	   964:     jmp     _ppu_read_2
                            	   965: 
                            	   966: ;------------------------------------------------------------------------------
                            	   967: ; void c_ppu_write_6(unsigned int val);
                            	   968: ; Native: D0.b = val, then jsr _ppu_write_6.
                            	   969: ;------------------------------------------------------------------------------
                            	   970: c_ppu_write_6:
02:0002B674 202F0004        	   971:     move.l  4(SP),D0
02:0002B678 4EF90000E32C    	   972:     jmp     _ppu_write_6
                            	   973: 
                            	   974: ;------------------------------------------------------------------------------
                            	   975: ; void c_ppu_write_7(unsigned int val);
                            	   976: ; Native: D0.b = val, then jsr _ppu_write_7.
                            	   977: ;------------------------------------------------------------------------------
                            	   978: c_ppu_write_7:
02:0002B67E 202F0004        	   979:     move.l  4(SP),D0
02:0002B682 4EF90000E36A    	   980:     jmp     _ppu_write_7
                            	   981: 
                            	   982: ;------------------------------------------------------------------------------
                            	   983: ; void c_turn_off_all_video(void);
                            	   984: ; Native: jsr TurnOffAllVideo (no register args, no return value).
                            	   985: ;------------------------------------------------------------------------------
                            	   986: c_turn_off_all_video:
02:0002B688 4EF9000489DE    	   987:     jmp     TurnOffAllVideo
                            	   988: 
                            	   989: ;==============================================================================
                            	   990: ; EXPORT side — z_03 entry point.
                            	   991: ; z_07.asm calls `jsr TransferLevelPatternBlocks`. When BANK_MODE_03="c",
                            	   992: ; the transpiler emits that label pointing to this shim instead of the
                            	   993: ; z_03 asm body. The C function takes no args and returns void.
                            	   994: ;==============================================================================
                            	   995: 
                            	   996: ;------------------------------------------------------------------------------
                            	   997: ; TransferLevelPatternBlocks → c_transfer_level_pattern_blocks
                            	   998: ; (No register args. Preserves D2-D7/A2-A6 via gcc callee-save.)
                            	   999: ;------------------------------------------------------------------------------
                            	  1000: c_transfer_level_pattern_blocks:
02:0002B68E 4EF900000000    	  1001:     jmp     z03_transfer_level_pattern_blocks
                            	  1002: 
                            	  1003: ;==============================================================================
                            	  1004: ; EXPORT side — z_06 entry points (Stage 3a).
                            	  1005: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1006: ;==============================================================================
                            	  1007: 
                            	  1008: c_init_mode2_submodes:
02:0002B694 4EF900000000    	  1009:     jmp     z06_init_mode2_submodes
                            	  1010: 
                            	  1011: c_copy_common_data_to_ram:
02:0002B69A 4EF900000000    	  1012:     jmp     z06_copy_common_data_to_ram
                            	  1013: 
                            	  1014: c_update_mode2_load_full:
02:0002B6A0 4EF900000000    	  1015:     jmp     z06_update_mode2_load_full
                            	  1016: 
                            	  1017: ;==============================================================================
                            	  1018: ; EXPORT side — z_05 entry points (Stage 3b).
                            	  1019: ; No register args. Preserves D2-D7/A2-A6 via gcc callee-save.
                            	  1020: ;==============================================================================
                            	  1021: 
                            	  1022: c_copy_column_to_tilebuf:
02:0002B6A6 4EF900000000    	  1023:     jmp     z05_copy_column_to_tilebuf
                            	  1024: 
                            	  1025: c_copy_row_to_tilebuf:
02:0002B6AC 4EF900000000    	  1026:     jmp     z05_copy_row_to_tilebuf
                            	  1027: 
                            	  1028: ;==============================================================================
                            	  1029: ; EXPORT side — z_05 entry points (Stage 4a).
                            	  1030: ;==============================================================================
                            	  1031: 
                            	  1032: ; HasCompass/HasMap — returns D0.b with Z flag set for BNE/BEQ callers
                            	  1033: c_has_compass:
02:0002B6B2 4EB900000000    	  1034:     jsr     z05_has_compass
02:0002B6B8 4A00            	  1035:     tst.b   D0
02:0002B6BA 4E75            	  1036:     rts
                            	  1037: 
                            	  1038: c_has_map:
02:0002B6BC 4EB900000000    	  1039:     jsr     z05_has_map
02:0002B6C2 4A00            	  1040:     tst.b   D0
02:0002B6C4 4E75            	  1041:     rts
                            	  1042: 
                            	  1043: ; CalcOpenDoorwayMask — D0=attr, D2=dir_idx. Preserves D0 on return.
                            	  1044: c_calc_open_doorway_mask:
02:0002B6C6 2F00            	  1045:     move.l  D0,-(SP)
02:0002B6C8 7200            	  1046:     moveq   #0,D1
02:0002B6CA 1202            	  1047:     move.b  D2,D1
02:0002B6CC 2F01            	  1048:     move.l  D1,-(SP)
02:0002B6CE 222F0004        	  1049:     move.l  4(SP),D1
02:0002B6D2 0281000000FF    	  1050:     andi.l  #$FF,D1
02:0002B6D8 2F01            	  1051:     move.l  D1,-(SP)
