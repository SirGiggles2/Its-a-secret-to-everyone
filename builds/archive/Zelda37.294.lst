                            	  5628: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  5629:     ; Digdogger is big, but room boundary checks and
                            	  5630:     ; object collision checks assume a 16x16 monster or smaller.
                            	  5631:     ; Therefore, we have to check these things four times,
                            	  5632:     ; in different corners of the boss.
                            	  5633:     ;
                            	  5634:     ; Loop 4 times, from 0 to 3.
                            	  5635:     ;
02:0003A61A 7600            	  5636:     moveq   #0,D3
02:0003A61C 41EC0478        	  5637:     lea     ($0478,A4),A0
02:0003A620 16302000        	  5638:     move.b  (A0,D2.W),D3
                            	  5639:     ; Change the coordinates to one corner.
                            	  5640:     ;
02:0003A624 10342070        	  5641:     move.b  ($70,A4,D2.W),D0
02:0003A628 023C00EE        	  5642:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A62C 41F90003A4E0    	  5643:     lea     (DigdoggerCornerOffsetsX).l,A0
02:0003A632 12303000        	  5644:     move.b  (A0,D3.W),D1
02:0003A636 D101            	  5645:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:0003A638 19802070        	  5646:     move.b  D0,($70,A4,D2.W)
02:0003A63C 41EC0084        	  5647:     lea     ($0084,A4),A0
02:0003A640 10302000        	  5648:     move.b  (A0,D2.W),D0
02:0003A644 023C00EE        	  5649:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A648 41F90003A4E4    	  5650:     lea     (DigdoggerCornerOffsetsY).l,A0
02:0003A64E 12303000        	  5651:     move.b  (A0,D3.W),D1
02:0003A652 D101            	  5652:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:0003A654 41EC0084        	  5653:     lea     ($0084,A4),A0
02:0003A658 11802000        	  5654:     move.b  D0,(A0,D2.W)
                            	  5655:     ; Check the room boundary and object collisions in this temporary location.
                            	  5656:     ;
02:0003A65C 61003730        	  5657:     jsr     BoundFlyer
02:0003A660 4EB900030BE6    	  5658:     jsr     CheckMonsterCollisions
                            	  5659:     ; Increase the loop index, and loop again until it = 4.
                            	  5660:     ;
02:0003A666 41EC0478        	  5661:     lea     ($0478,A4),A0
02:0003A66A 52302000        	  5662:     addq.b  #1,(A0,D2.W)
02:0003A66E 41EC0478        	  5663:     lea     ($0478,A4),A0
02:0003A672 10302000        	  5664:     move.b  (A0,D2.W),D0
02:0003A676 0C000004        	  5665:     cmpi.b  #$04,D0
02:0003A67A 659E            	  5666:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  5667:     ; Restore the original coordinates.
                            	  5668:     ;
