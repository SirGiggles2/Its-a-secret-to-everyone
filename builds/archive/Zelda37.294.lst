                            	  7146: _anon_z04_96:
                            	  7147:     ; If we have the magic clock, or is stunned, then
                            	  7148:     ; go draw and check collisions.
                            	  7149:     ;
02:0003B134 102C066C        	  7150:     move.b  ($066C,A4),D0
02:0003B138 1234203D        	  7151:     move.b  ($3D,A4,D2.W),D1
02:0003B13C 8001            	  7152:     or.b  D1,D0
02:0003B13E 660000AE        	  7153:     bne  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  7154:     ; Every odd screen frame, go straight to drawing
                            	  7155:     ; and checking collisions.
                            	  7156:     ;
02:0003B142 102C0015        	  7157:     move.b  ($0015,A4),D0
02:0003B146 E208            	  7158:     lsr.b  #1,D0   ; LSR A
02:0003B148 6404            	  7159:     bcc.s  __far_z_04_0066
02:0003B14A 60000118        	  7160:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7161: __far_z_04_0066:
                            	  7162:     ; Otherwise move horizontally.
                            	  7163:     ;
02:0003B14E 61000248        	  7164:     jsr     PolsVoice_MoveX
                            	  7165:     ; If state <> 0, then the monster is jumping.
                            	  7166:     ; Go handle vertical movement.
                            	  7167:     ;
02:0003B152 41EC00AC        	  7168:     lea     ($00AC,A4),A0
02:0003B156 10302000        	  7169:     move.b  (A0,D2.W),D0
02:0003B15A 6706            	  7170:     beq  _L_z04_UpdatePolsVoice_State0
02:0003B15C 61000130        	  7171:     jsr     UpdatePolsVoiceState1_Jumping
