02:0003D3C8 10302000        	 11735:     move.b  (A0,D2.W),D0
02:0003D3CC 6704            	 11736:     beq  _L_z04_PatraChild_State1_Exit
02:0003D3CE 6100FA94        	 11737:     jsr     SetDeadDummyObjType
                            	 11738:     even
                            	 11739: _L_z04_PatraChild_State1_Exit:
02:0003D3D2 4E75            	 11740:     rts
                            	 11741: 
