                            	  5838: Digdogger_Move:
                            	  5839:     ; This calculation is the same one used in Manhandla to
                            	  5840:     ; manifest the fractional speed over several frames.
                            	  5841:     ;
                            	  5842:     ; To summarize, the formula is:
                            	  5843:     ;
                            	  5844:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  5845:     ;
                            	  5846:     ;   SA := SA + (SL AND $E0)
                            	  5847:     ;   [03] := SH + carry
                            	  5848:     ;
                            	  5849:     ; See 04:A28E Manhandla_Move.
                            	  5850:     ;
02:0003A7F4 41EC041F        	  5851:     lea     ($041F,A4),A0
02:0003A7F8 10302000        	  5852:     move.b  (A0,D2.W),D0
02:0003A7FC 020000E0        	  5853:     andi.b #$E0,D0
02:0003A800 023C00EE        	  5854:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A804 41EC0412        	  5855:     lea     ($0412,A4),A0
02:0003A808 12302000        	  5856:     move.b  (A0,D2.W),D1
02:0003A80C D101            	  5857:     addx.b  D1,D0   ; ADC $0412,X
02:0003A80E 41EC0412        	  5858:     lea     ($0412,A4),A0
02:0003A812 11802000        	  5859:     move.b  D0,(A0,D2.W)
                            	  5860:     ; Assign (high speed byte + carry) to [03].
                            	  5861:     ;
02:0003A816 41EC042C        	  5862:     lea     ($042C,A4),A0
02:0003A81A 10302000        	  5863:     move.b  (A0,D2.W),D0
02:0003A81E 123C0000        	  5864:     move.b  #$00,D1
02:0003A822 D101            	  5865:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A824 19400003        	  5866:     move.b  D0,($0003,A4)
                            	  5867:     ; Change coordinates by the speed amount/offset in [03]
                            	  5868:     ; according to the direction.
                            	  5869:     ;
                            	  5870:     ; Start with a mask of $A1 in [02]:
                            	  5871:     ; - low nibble represents the right direction
                            	  5872:     ; - high nibble is used to set or clear carry as we go along
                            	  5873:     ;
02:0003A828 103C00A1        	  5874:     move.b  #$A1,D0
02:0003A82C 19400002        	  5875:     move.b  D0,($0002,A4)
                            	  5876:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  5877:     ;
02:0003A830 41EC0098        	  5878:     lea     ($0098,A4),A0
02:0003A834 10302000        	  5879:     move.b  (A0,D2.W),D0
02:0003A838 122C0002        	  5880:     move.b  ($0002,A4),D1
02:0003A83C C200            	  5881:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A83E 6712            	  5882:     beq  _L_z04_Digdogger_Move_Left
02:0003A840 10342070        	  5883:     move.b  ($70,A4,D2.W),D0
02:0003A844 023C00EE        	  5884:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A848 122C0003        	  5885:     move.b  ($0003,A4),D1
02:0003A84C D101            	  5886:     addx.b  D1,D0   ; ADC $03
02:0003A84E 19802070        	  5887:     move.b  D0,($70,A4,D2.W)
                            	  5888:     even
                            	  5889: _L_z04_Digdogger_Move_Left:
                            	  5890:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  5891:     ;
02:0003A852 41EC0098        	  5892:     lea     ($0098,A4),A0
02:0003A856 10302000        	  5893:     move.b  (A0,D2.W),D0
02:0003A85A 122C0002        	  5894:     move.b  ($0002,A4),D1
02:0003A85E E309            	  5895:     lsl.b  #1,D1   ; ASL $02
02:0003A860 19410002        	  5896:     move.b  D1,($0002,A4)
02:0003A864 122C0002        	  5897:     move.b  ($0002,A4),D1
02:0003A868 C200            	  5898:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A86A 6716            	  5899:     beq  _L_z04_Digdogger_Move_Down
02:0003A86C 10342070        	  5900:     move.b  ($70,A4,D2.W),D0
02:0003A870 122C0003        	  5901:     move.b  ($0003,A4),D1
02:0003A874 0A3C0010        	  5902:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A878 9101            	  5903:     subx.b  D1,D0   ; SBC $03
02:0003A87A 0A3C0010        	  5904:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A87E 19802070        	  5905:     move.b  D0,($70,A4,D2.W)
                            	  5906:     even
                            	  5907: _L_z04_Digdogger_Move_Down:
                            	  5908:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  5909:     ;
02:0003A882 41EC0098        	  5910:     lea     ($0098,A4),A0
02:0003A886 10302000        	  5911:     move.b  (A0,D2.W),D0
02:0003A88A 122C0002        	  5912:     move.b  ($0002,A4),D1
02:0003A88E E309            	  5913:     lsl.b  #1,D1   ; ASL $02
02:0003A890 19410002        	  5914:     move.b  D1,($0002,A4)
02:0003A894 122C0002        	  5915:     move.b  ($0002,A4),D1
02:0003A898 C200            	  5916:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A89A 6716            	  5917:     beq  _L_z04_Digdogger_Move_Up
02:0003A89C 41EC0084        	  5918:     lea     ($0084,A4),A0
02:0003A8A0 10302000        	  5919:     move.b  (A0,D2.W),D0
02:0003A8A4 122C0003        	  5920:     move.b  ($0003,A4),D1
02:0003A8A8 D101            	  5921:     addx.b  D1,D0   ; ADC $03
02:0003A8AA 41EC0084        	  5922:     lea     ($0084,A4),A0
02:0003A8AE 11802000        	  5923:     move.b  D0,(A0,D2.W)
                            	  5924:     even
                            	  5925: _L_z04_Digdogger_Move_Up:
                            	  5926:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  5927:     ;
02:0003A8B2 41EC0098        	  5928:     lea     ($0098,A4),A0
02:0003A8B6 10302000        	  5929:     move.b  (A0,D2.W),D0
02:0003A8BA 122C0002        	  5930:     move.b  ($0002,A4),D1
02:0003A8BE E309            	  5931:     lsl.b  #1,D1   ; ASL $02
02:0003A8C0 19410002        	  5932:     move.b  D1,($0002,A4)
02:0003A8C4 122C0002        	  5933:     move.b  ($0002,A4),D1
02:0003A8C8 C200            	  5934:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003A8CA 671E            	  5935:     beq  _L_z04_Digdogger_Move_End
02:0003A8CC 41EC0084        	  5936:     lea     ($0084,A4),A0
02:0003A8D0 10302000        	  5937:     move.b  (A0,D2.W),D0
02:0003A8D4 122C0003        	  5938:     move.b  ($0003,A4),D1
02:0003A8D8 0A3C0010        	  5939:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A8DC 9101            	  5940:     subx.b  D1,D0   ; SBC $03
02:0003A8DE 0A3C0010        	  5941:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A8E2 41EC0084        	  5942:     lea     ($0084,A4),A0
02:0003A8E6 11802000        	  5943:     move.b  D0,(A0,D2.W)
                            	  5944:     even
                            	  5945: _L_z04_Digdogger_Move_End:
02:0003A8EA 4EF90004AD8E    	  5946:     jmp     Anim_FetchObjPosForSpriteDescriptor
