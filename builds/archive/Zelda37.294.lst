                            	  6072: _L_z04_Aquamentus_Move_Move:
                            	  6073:     ; 7 of 8 screen frames return without moving.
                            	  6074:     ;
02:0003A9E4 102C0015        	  6075:     move.b  ($0015,A4),D0
