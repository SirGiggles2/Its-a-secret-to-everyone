                            	  9281: _L_z04_UpdateGohma_AnimateEye:
                            	  9282:     ; Animate the eye.
                            	  9283:     ;
                            	  9284:     ; First, if the counter for when to open the eye next = 0, then
                            	  9285:     ; set it to a random value at least $C0; and set the timer for
                            	  9286:     ; keeping the eye open to $80.
                            	  9287:     ;
                            	  9288:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9289:     ; every other frame.
                            	  9290:     ;
02:0003C17E 41EC042C        	  9291:     lea     ($042C,A4),A0
02:0003C182 10302000        	  9292:     move.b  (A0,D2.W),D0
02:0003C186 661E            	  9293:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003C188 103C0080        	  9294:     move.b  #$80,D0
02:0003C18C 41EC0444        	  9295:     lea     ($0444,A4),A0
02:0003C190 11802000        	  9296:     move.b  D0,(A0,D2.W)
02:0003C194 103C00C0        	  9297:     move.b  #$C0,D0
02:0003C198 12342018        	  9298:     move.b  ($18,A4,D2.W),D1
02:0003C19C 8001            	  9299:     or.b  D1,D0
02:0003C19E 41EC042C        	  9300:     lea     ($042C,A4),A0
02:0003C1A2 11802000        	  9301:     move.b  D0,(A0,D2.W)
                            	  9302:     even
