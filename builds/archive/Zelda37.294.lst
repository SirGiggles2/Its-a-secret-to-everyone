                            	 11562: __far_z_04_0112:
                            	 11563:     ; State = 0.
                            	 11564:     ;
                            	 11565:     ; If the current object slot is 2, then go initialize the patra child.
                            	 11566:     ; This is the only patra child shown in the first fame.
                            	 11567:     ;
02:0003D284 0C020002        	 11568:     cmpi.b  #$02,D2
02:0003D288 6732            	 11569:     beq  _L_z04_UpdatePatraChild_Ready
                            	 11570:     ; The patra child in slot 2 is the last one to be updated.
                            	 11571:     ; So all other patra children will see slot 2's state = 0, and return.
                            	 11572:     ;
                            	 11573:     ; This means that in the first frame, slot 2 is the only one to be
                            	 11574:     ; shown.
                            	 11575:     ;
02:0003D28A 102C00AE        	 11576:     move.b  ($00AE,A4),D0
02:0003D28E 6700008E        	 11577:     beq  _L_z04_UpdatePatraChild_Exit
                            	 11578:     ; In subsequent frames, patra children in slots >= 3 will reach
                            	 11579:     ; here to wait to be shown at the top position (N) one at a time.
                            	 11580:     ;
02:0003D292 1002            	 11581:     move.b  D2,D0
                            	 11582:     ; Subtract 3 from the object slot to get the angle where the
                            	 11583:     ; patra child in object slot 2 should be for the current one to appear.
                            	 11584:     ;
02:0003D294 003C0011        	 11585:     ori     #$11,CCR  ; SEC: set C+X
02:0003D298 123C0003        	 11586:     move.b  #$03,D1
02:0003D29C 0A3C0010        	 11587:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003D2A0 9101            	 11588:     subx.b  D1,D0   ; SBC #$03
02:0003D2A2 0A3C0010        	 11589:     eori    #$10,CCR  ; restore X = 6502 C
02:0003D2A6 7600            	 11590:     moveq   #0,D3
02:0003D2A8 1600            	 11591:     move.b  D0,D3
                            	 11592:     ; If the patra child in slot 2 has not reached the required angle,
                            	 11593:     ; then return.
