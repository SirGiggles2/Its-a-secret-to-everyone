02:0003BC3A 13C00000042D    	  8594:     move.b  D0,(Gleook_HeadInfo1+GLEEOK_DIRCOUNTERH).l
02:0003BC40 13C000000381    	  8595:     move.b  D0,(Gleook_HeadInfo2+GLEEOK_DIRCOUNTERH).l
02:0003BC46 13C0000003A9    	  8596:     move.b  D0,(Gleook_HeadInfo3+GLEEOK_DIRCOUNTERH).l
                            	  8597:     ; Set neck 1 head delay timer to 12.
