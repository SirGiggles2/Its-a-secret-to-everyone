                            	  5475: CheckState20:
                            	  5476:     ; If major state <> $20, go check other states.
                            	  5477:     ;
02:0004A3C2 0C000020        	  5478:     cmpi.b  #$20,D0
02:0004A3C6 6704            	  5479:     beq.s  __far_z_07_0083
02:0004A3C8 600000B6        	  5480:     jmp  CheckState30
                            	  5481: __far_z_07_0083:
                            	  5482:     ; State $2x. Spark.
                            	  5483:     ;
                            	  5484:     ; Change the state to $28, and decrement animation counter.
                            	  5485:     ; If it hasn't reached 0, then go draw and check for collision
                            	  5486:     ; (with Link, if this is a monster's boomerang).
                            	  5487:     ;
                            	  5488:     ; TODO: Why state $28?
                            	  5489:     ; I thought that it was set to $28, so that the animation frame cycle will
                            	  5490:     ; start over again when spinning.
                            	  5491:     ; But when animation counter reaches 0, state will be set to $40.
                            	  5492:     ; If the counter hasn't reached 0, then I don't *think* that
                            	  5493:     ; any drawing code depends on the minor state.
                            	  5494:     ;
02:0004A3CC 7028            	  5495:     moveq   #40,D0
02:0004A3CE 41EC00AC        	  5496:     lea     ($00AC,A4),A0
02:0004A3D2 11802000        	  5497:     move.b  D0,(A0,D2.W)
02:0004A3D6 41EC03D0        	  5498:     lea     ($03D0,A4),A0
02:0004A3DA 53302000        	  5499:     subq.b  #1,(A0,D2.W)
02:0004A3DE 6702            	  5500:     beq.s  __far_z_07_0084
02:0004A3E0 6060            	  5501:     jmp  DrawArrowOrBoomerangAndCheckCollisions
                            	  5502: __far_z_07_0084:
                            	  5503:     ; Animation counter = 0.
                            	  5504:     ;
                            	  5505:     ; Set state to $40. It will become $50 below in
                            	  5506:     ; HandleArrowOrBoomerangBlocked.
                            	  5507:     ;
02:0004A3E2 7040            	  5508:     moveq   #64,D0
02:0004A3E4 41EC00AC        	  5509:     lea     ($00AC,A4),A0
02:0004A3E8 11802000        	  5510:     move.b  D0,(A0,D2.W)
                            	  5511:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5512:     ; Else go handle the boomerang being blocked.
                            	  5513:     ;
02:0004A3EC 0C02000D        	  5514:     cmpi.b  #$0D,D2
02:0004A3F0 640E            	  5515:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004A3F2 41EC034F        	  5516:     lea     ($034F,A4),A0
02:0004A3F6 10302000        	  5517:     move.b  (A0,D2.W),D0
02:0004A3FA 0C00005B        	  5518:     cmpi.b  #$5B,D0
02:0004A3FE 6708            	  5519:     beq  _L_z07_CheckState20_Deactivate
                            	  5520:     even
