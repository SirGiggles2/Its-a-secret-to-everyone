02:00038B2C 02000003        	  1762:     andi.b #$03,D0
02:00038B30 7600            	  1763:     moveq   #0,D3
02:00038B32 1600            	  1764:     move.b  D0,D3
02:00038B34 41F900038A90    	  1765:     lea     (StatueFireballStartTimes).l,A0
02:00038B3A 10303000        	  1766:     move.b  (A0,D3.W),D0
02:00038B3E 41EC04E8        	  1767:     lea     ($04E8,A4),A0
02:00038B42 11802000        	  1768:     move.b  D0,(A0,D2.W)
                            	  1769:     ; The coordinate lists are divided into sets for each pattern.
