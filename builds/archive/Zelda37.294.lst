02:0003AE4E 660A            	  6683:     bne  _L_z04_Dodongo_CheckBombHit_Exit
02:0003AE50 7002            	  6684:     moveq   #2,D0
02:0003AE52 41EC00AC        	  6685:     lea     ($00AC,A4),A0
02:0003AE56 11802000        	  6686:     move.b  D0,(A0,D2.W)
                            	  6687:     even
                            	  6688: _L_z04_Dodongo_CheckBombHit_Exit:
02:0003AE5A 4E75            	  6689:     rts
                            	  6690: 
