                            	  7249: _L_z04_UpdatePolsVoice_SetState1:
                            	  7250:     ; If already in state 1, then go draw and check collisions.
                            	  7251:     ;
02:0003B1F0 41EC00AC        	  7252:     lea     ($00AC,A4),A0
02:0003B1F4 10302000        	  7253:     move.b  (A0,D2.W),D0
02:0003B1F8 6702            	  7254:     beq.s  __far_z_04_0067
02:0003B1FA 6068            	  7255:     jmp  L_PolsVoice_DrawAndCheckCollisions
                            	  7256: __far_z_04_0067:
                            	  7257:     ; Go to state 1.
                            	  7258:     ;
02:0003B1FC 41EC00AC        	  7259:     lea     ($00AC,A4),A0
02:0003B200 52302000        	  7260:     addq.b  #1,(A0,D2.W)
                            	  7261:     ; Subtract 1 from facing direction to make an index.
                            	  7262:     ;
02:0003B204 7600            	  7263:     moveq   #0,D3
02:0003B206 41EC0098        	  7264:     lea     ($0098,A4),A0
02:0003B20A 16302000        	  7265:     move.b  (A0,D2.W),D3
02:0003B20E 5303            	  7266:     subq.b  #1,D3
                            	  7267:     ; If Y coordinate < $78, make the index 3 for down.
                            	  7268:     ;
02:0003B210 41EC0084        	  7269:     lea     ($0084,A4),A0
02:0003B214 10302000        	  7270:     move.b  (A0,D2.W),D0
02:0003B218 0C000078        	  7271:     cmpi.b  #$78,D0
02:0003B21C 6402            	  7272:     bcc  _anon_z04_97
02:0003B21E 7603            	  7273:     moveq   #3,D3
                            	  7274: _anon_z04_97:
                            	  7275:     ; If Y coordinate >= $A8, make the index 7 for up.
                            	  7276:     ;
02:0003B220 0C0000A8        	  7277:     cmpi.b  #$A8,D0
02:0003B224 6502            	  7278:     bcs  _anon_z04_98
02:0003B226 7607            	  7279:     moveq   #7,D3
                            	  7280: _anon_z04_98:
                            	  7281:     ; Set the vertical speed for the beginning of the jump.
                            	  7282:     ;
02:0003B228 41F90003B11C    	  7283:     lea     (PolsVoiceInitialJumpSpeeds).l,A0
02:0003B22E 10303000        	  7284:     move.b  (A0,D3.W),D0
02:0003B232 41EC0412        	  7285:     lea     ($0412,A4),A0
02:0003B236 11802000        	  7286:     move.b  D0,(A0,D2.W)
                            	  7287:     ; Look up the Y offset for the current direction.
                            	  7288:     ; Add it to object Y to set the destination Y of the jump.
                            	  7289:     ;
02:0003B23A 41EC0084        	  7290:     lea     ($0084,A4),A0
02:0003B23E 10302000        	  7291:     move.b  (A0,D2.W),D0
02:0003B242 023C00EE        	  7292:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003B246 41F90003B124    	  7293:     lea     (PolsVoiceDestinationYOffsets).l,A0
02:0003B24C 12303000        	  7294:     move.b  (A0,D3.W),D1
02:0003B250 D101            	  7295:     addx.b  D1,D0   ; ADC PolsVoiceDestinationYOffsets,Y
02:0003B252 41EC042C        	  7296:     lea     ($042C,A4),A0
02:0003B256 11802000        	  7297:     move.b  D0,(A0,D2.W)
                            	  7298:     ; Turn the index into a direction again by adding 1.
                            	  7299:     ; Store the facing direction.
                            	  7300:     ;
02:0003B25A 5203            	  7301:     addq.b  #1,D3
02:0003B25C 41EC0098        	  7302:     lea     ($0098,A4),A0
02:0003B260 11832000        	  7303:     move.b  D3,(A0,D2.W)
                            	  7304:     even
                            	  7305: L_PolsVoice_DrawAndCheckCollisions:
