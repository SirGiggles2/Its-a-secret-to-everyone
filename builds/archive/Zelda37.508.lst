                            	  3456:     ;==========================================================================
                            	  3457:     ; PALETTE RANGE ($3F00-$3F1F): NES color -> Genesis CRAM
                            	  3458:     ;==========================================================================
                            	  3459: .ttf_palette_range:
02:0002B614 2F0B            	  3460:     move.l  A3,-(SP)                ; save safety limit
02:0002B616 47F90000E9EA    	  3461:     lea     (nes_palette_to_genesis).l,A3
                            	  3462: 
                            	  3463: .ttf_pal_loop:
                            	  3464:     ; Get data byte
02:0002B61C 4A04            	  3465:     tst.b   D4                      ; repeat mode?
02:0002B61E 6602            	  3466:     bne.s   .ttf_pal_have_byte
02:0002B620 1418            	  3467:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3468: .ttf_pal_have_byte:
                            	  3469: 
                            	  3470:     ; Bounds check
02:0002B622 0C453F20        	  3471:     cmpi.w  #$3F20,D5
02:0002B626 6478            	  3472:     bhs.s   .ttf_pal_skip
                            	  3473: 
                            	  3474:     ; Compute palette offset
02:0002B628 3005            	  3475:     move.w  D5,D0
02:0002B62A 04403F00        	  3476:     subi.w  #$3F00,D0
02:0002B62E 0240001F        	  3477:     andi.w  #$001F,D0               ; offset 0..31
                            	  3478: 
                            	  3479:     ; NES palette mirroring & sprite palette remap
                            	  3480:     ; Entry-0 offsets (16,20,24,28) mirror universal BG color → remap to BG
                            	  3481:     ; Non-entry-0 sprite colors → remap to Genesis CRAM palettes 2-3
02:0002B632 0C400010        	  3482:     cmpi.w  #$10,D0
02:0002B636 6534            	  3483:     blo.s   .ttf_pal_bg
02:0002B638 3C00            	  3484:     move.w  D0,D6
02:0002B63A 02460003        	  3485:     andi.w  #$0003,D6
02:0002B63E 6606            	  3486:     bne.s   .ttf_pal_spr            ; non-zero slot → sprite palette
02:0002B640 04400010        	  3487:     subi.w  #$10,D0                 ; entry-0: remap 16→0, 20→4, 24→8, 28→12
02:0002B644 6026            	  3488:     bra.s   .ttf_pal_bg
                            	  3489: .ttf_pal_spr:
                            	  3490:     ifne CHR_EXPANSION_ENABLED
                            	  3491:     ; T-CHR S8 v2: pack sprite sub-palettes into unused tail slots of BG
                            	  3492:     ; palettes (PAL0[4..15] + PAL1[4..7]).  See .t19_spr_cram_base for the
                            	  3493:     ; mapping table.  Using an inline table to avoid cross-scope lea.
02:0002B646 3C00            	  3494:     move.w  D0,D6
02:0002B648 04460010        	  3495:     subi.w  #$10,D6
02:0002B64C E44E            	  3496:     lsr.w   #2,D6                   ; D6 = sub-pal (0..3)
02:0002B64E DC46            	  3497:     add.w   D6,D6                   ; * 2 for word index
02:0002B650 45FA0010        	  3498:     lea     (.ttf_spr_cram_base,PC),A2
02:0002B654 3C326000        	  3499:     move.w  (A2,D6.W),D6            ; D6 = CRAM base for this sub-pal
02:0002B658 02400003        	  3500:     andi.w  #$0003,D0               ; color slot (1..3)
02:0002B65C D040            	  3501:     add.w   D0,D0                   ; * 2
02:0002B65E DC40            	  3502:     add.w   D0,D6                   ; D6 = CRAM address
                            	  3503:     ; D2 preserved (holds palette data byte for later .ttf_pal_have_cram lookup)
02:0002B660 6008            	  3504:     bra.s   .ttf_pal_have_cram_new
                            	  3505: .ttf_spr_cram_base:
02:0002B662 0008            	  3506:     dc.w    $08                     ; sub-pal 0 → PAL0[4]
02:0002B664 0010            	  3507:     dc.w    $10                     ; sub-pal 1 → PAL0[8]
02:0002B666 0018            	  3508:     dc.w    $18                     ; sub-pal 2 → PAL0[12]
02:0002B668 0028            	  3509:     dc.w    $28                     ; sub-pal 3 → PAL1[4]
                            	  3510: .ttf_pal_have_cram_new:
                            	  3511:     else
                            	  3512:     ; Legacy: remap NES sprite pal 0-3 → Genesis pal 2-3 (last-write-wins).
                            	  3513:     move.w  D0,D6
                            	  3514:     subi.w  #$10,D6
                            	  3515:     lsr.w   #2,D6                   ; NES sprite pal (0-3)
                            	  3516:     ori.w   #$0002,D6               ; Genesis pal = NES_pal | 2 (0→2, 1→3, 2→2, 3→3)
                            	  3517:     andi.w  #$0003,D6
                            	  3518:     lsl.w   #5,D6                   ; * $20
                            	  3519:     andi.w  #$0003,D0               ; color slot
                            	  3520:     lsl.w   #1,D0                   ; * 2
                            	  3521:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3522:     endc
02:0002B66A 600E            	  3523:     bra.s   .ttf_pal_have_cram
                            	  3524: .ttf_pal_bg:
                            	  3525: 
                            	  3526:     ; Compute CRAM address: palette_idx*$20 + color_slot*2
02:0002B66C 3C00            	  3527:     move.w  D0,D6
02:0002B66E E44E            	  3528:     lsr.w   #2,D6                   ; palette index (0..3)
02:0002B670 EB4E            	  3529:     lsl.w   #5,D6                   ; * $20
02:0002B672 02400003        	  3530:     andi.w  #$0003,D0               ; color slot
02:0002B676 E348            	  3531:     lsl.w   #1,D0                   ; * 2
02:0002B678 DC40            	  3532:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3533: .ttf_pal_have_cram:
                            	  3534: 
                            	  3535:     ; VDP CRAM write command
02:0002B67A 7000            	  3536:     moveq   #0,D0
02:0002B67C 3006            	  3537:     move.w  D6,D0
02:0002B67E 4840            	  3538:     swap    D0
02:0002B680 0080C0000000    	  3539:     ori.l   #$C0000000,D0
02:0002B686 23C000C00004    	  3540:     move.l  D0,(VDP_CTRL).l
                            	  3541: 
                            	  3542:     ; Look up NES->Genesis color
02:0002B68C 7000            	  3543:     moveq   #0,D0
02:0002B68E 1002            	  3544:     move.b  D2,D0
02:0002B690 0240003F        	  3545:     andi.w  #$003F,D0               ; mask to valid color index
02:0002B694 E348            	  3546:     lsl.w   #1,D0                   ; word offset
02:0002B696 30330000        	  3547:     move.w  (A3,D0.W),D0           ; Genesis color word
02:0002B69A 33C000C00000    	  3548:     move.w  D0,(VDP_DATA).l
                            	  3549: 
                            	  3550: .ttf_pal_skip:
02:0002B6A0 DA41            	  3551:     add.w   D1,D5                   ; advance PPU_VADDR
02:0002B6A2 02453FFF        	  3552:     andi.w  #$3FFF,D5
02:0002B6A6 5343            	  3553:     subq.w  #1,D3
02:0002B6A8 6600FF72        	  3554:     bne     .ttf_pal_loop
                            	  3555: 
                            	  3556:     ; Palette post-reset: set PPU_VADDR to $0000, clear latch
02:0002B6AC 33FC000000FF0802	  3557:     move.w  #$0000,(PPU_VADDR).l
02:0002B6B4 423900FF0800    	  3558:     clr.b   (PPU_LATCH).l
02:0002B6BA 265F            	  3559:     movea.l (SP)+,A3                ; restore safety limit
02:0002B6BC 6000FAE2        	  3560:     bra     .ttf_next_record        ; skip .ttf_post_record
                            	  3561: 
                            	  3562:     ;==========================================================================
                            	  3563:     ; SKIP: unhandled PPU address range — consume payload and continue
                            	  3564:     ;==========================================================================
                            	  3565: .ttf_skip_range:
02:0002B6C0 4A04            	  3566:     tst.b   D4                      ; repeat mode?
02:0002B6C2 6602            	  3567:     bne.s   .ttf_post_record        ; repeat: 1 byte already consumed
02:0002B6C4 D0C3            	  3568:     adda.w  D3,A0                   ; sequential: skip D3 bytes
                            	  3569:     bra     .ttf_post_record
                            	  3570: 
                            	  3571:     ;==========================================================================
                            	  3572:     ; POST-RECORD: update PPU_VADDR and loop to next record
                            	  3573:     ;==========================================================================
                            	  3574: .ttf_post_record:
02:0002B6C6 33C500FF0802    	  3575:     move.w  D5,(PPU_VADDR).l
02:0002B6CC 6000FAD2        	  3576:     bra     .ttf_next_record
                            	  3577: 
                            	  3578:     ;==========================================================================
                            	  3579:     ; DONE: update ZP pointer and return
                            	  3580:     ;==========================================================================
                            	  3581: .ttf_done:
                            	  3582:     ; Reset VDP to VRAM write mode so stale CRAM targeting doesn't
                            	  3583:     ; corrupt palette on subsequent VDP_DATA writes.
                            	  3584:     ; Target $FFFC (unused VRAM) to avoid corrupting tile 0 on stray writes.
02:0002B6D0 23FC7FFC000300C0	  3585:     move.l  #$7FFC0003,(VDP_CTRL).l
02:0002B6D8 0004
02:0002B6DA 4CDF0FFF        	  3586:     movem.l (SP)+,D0-D7/A0-A3
02:0002B6DE 4E75            	  3587:     rts
