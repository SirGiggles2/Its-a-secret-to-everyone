02:0002D1DE 0281000000FF    	  5171:     andi.l  #$FF,D1
02:0002D1E4 2F01            	  5172:     move.l  D1,-(SP)              ; arg2 init_major_min
02:0002D1E6 7200            	  5173:     moveq   #0,D1
02:0002D1E8 1200            	  5174:     move.b  D0,D1
02:0002D1EA 0281000000FF    	  5175:     andi.l  #$FF,D1
02:0002D1F0 2F01            	  5176:     move.l  D1,-(SP)              ; arg1 instr_offset
02:0002D1F2 4EB900000000    	  5177:     jsr     z04_wallmaster_calc_start_position
