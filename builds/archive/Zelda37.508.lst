02:0003BB00 102C051C        	  8019:     move.b  ($051C,A4),D0
02:0003BB04 0C0000C0        	  8020:     cmpi.b  #$C0,D0
02:0003BB08 6606            	  8021:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003BB0A 7002            	  8022:     moveq   #2,D0
02:0003BB0C 19400600        	  8023:     move.b  D0,($0600,A4)
