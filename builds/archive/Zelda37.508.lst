02:00047352 023C00EE        	  2396:     andi    #$EE,CCR  ; CLC: clear C+X
02:00047356 123C000A        	  2397:     move.b  #$0A,D1
02:0004735A D101            	  2398:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0004735C 19400301        	  2399:     move.b  D0,($0301,A4)
