                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0003A76A 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0003A76E 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0003A772 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A776 123C0038        	  5434:     move.b  #$38,D1
02:0003A77A D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0003A77C 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0003A780 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0003A784 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0003A788 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0003A78C 123C0000        	  5442:     move.b  #$00,D1
02:0003A790 D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003A792 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0003A796 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0003A79A 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A79E 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0003A7A2 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0003A7A6 D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0003A7A8 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0003A7AC 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
02:0003A7B0 41EC0412        	  5456:     lea     ($0412,A4),A0
02:0003A7B4 10302000        	  5457:     move.b  (A0,D2.W),D0
02:0003A7B8 6B0000AC        	  5458:     bmi  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5459:     ; If Y coordinate still < target Y, then return.
                            	  5460:     ;
02:0003A7BC 41EC0084        	  5461:     lea     ($0084,A4),A0
02:0003A7C0 10302000        	  5462:     move.b  (A0,D2.W),D0
02:0003A7C4 41EC042C        	  5463:     lea     ($042C,A4),A0
02:0003A7C8 12302000        	  5464:     move.b  (A0,D2.W),D1
02:0003A7CC B001            	  5465:     cmp.b   D1,D0
02:0003A7CE 65000096        	  5466:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5467:     ; Else reached the destination. Go to state 0.
