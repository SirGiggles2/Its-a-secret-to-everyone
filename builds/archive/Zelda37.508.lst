                            	  4360: DrawLinkZeldaTriforces:
                            	  4361:     ; The triforce over Link goes in the room object slot $13.
                            	  4362:     ; Set its location $10 pixels above Link.
                            	  4363:     ;
02:00034E78 102C0070        	  4364:     move.b  ($0070,A4),D0
02:00034E7C 19400083        	  4365:     move.b  D0,($0083,A4)
02:00034E80 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00034E84 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00034E88 123C0010        	  4368:     move.b  #$10,D1
02:00034E8C 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034E90 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00034E92 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00034E96 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
                            	  4374:     ;
