                            	  8178: Ganon_UpdateBrownState:
                            	  8179:     ; Every other frame decrement the state.
                            	  8180:     ; But every frame draw Ganon either translucent or opaque.
                            	  8181:     ;
02:0003BBEA 102C0015        	  8182:     move.b  ($0015,A4),D0
02:0003BBEE E208            	  8183:     lsr.b  #1,D0   ; LSR A
02:0003BBF0 6410            	  8184:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0003BBF2 41EC00AC        	  8185:     lea     ($00AC,A4),A0
02:0003BBF6 53302000        	  8186:     subq.b  #1,(A0,D2.W)
                            	  8187:     ; If the state becomes 0, then Ganon is blue again.
                            	  8188:     ; Go switch his palette row to reflect it.
                            	  8189:     ;
