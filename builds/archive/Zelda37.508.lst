02:00039C9A 10302000        	  3975:     move.b  (A0,D2.W),D0
02:00039C9E 41EC0380        	  3976:     lea     ($0380,A4),A0
02:00039CA2 11802000        	  3977:     move.b  D0,(A0,D2.W)
