                            	  4106:     ; If object is the player, return.
                            	  4107:     ;
02:00047F6E 4A02            	  4108:     cmpi.b  #$00,D2
02:00047F70 6604            	  4109:     bne.s  __far_z_07_0049
02:00047F72 6000008A        	  4110:     jmp  L1F148_Exit
