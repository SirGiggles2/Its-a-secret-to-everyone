                            	  2973: .ttf_chr_range:
                            	  2974:     ; Fast path: sequential + horizontal (+1) + tile-aligned
02:0002B242 B27C0001        	  2975:     cmp.w   #1,D1                   ; horizontal increment?
02:0002B246 6622            	  2976:     bne.s   .ttf_chr_slow
02:0002B248 4A04            	  2977:     tst.b   D4                      ; sequential mode?
02:0002B24A 661E            	  2978:     bne.s   .ttf_chr_slow
02:0002B24C 3005            	  2979:     move.w  D5,D0
