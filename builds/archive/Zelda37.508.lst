                            	   584: ;------------------------------------------------------------------------------
                            	   585: ; _mode_transition_check — runs from VBlankISR after _ags_prearm, before
                            	   586: ; IsrNmi.  Detects a change in GameMode ($0012) against the LAST_GAMEMODE
                            	   587: ; shadow and, on transition, purges stale scroll latches, zeros the two
                            	   588: ; VSRAM words directly via the VDP control port, and rewinds the DynTileBuf
                            	   589: ; palette-precheck state so _patch_z06 P3 runs fresh on the new mode's
                            	   590: ; first tile transfer.
                            	   591: ;
                            	   592: ; Fixes VSRAM bleed-through seen when leaving attract → file-select →
                            	   593: ; gameplay: the new mode inherited the old mode's vertical scroll register
                            	   594: ; value for a single frame before the first _ags_flush landed.
                            	   595: ;
                            	   596: ; Preserves: D1-D7, A0-A6 (clobbers D0 internally and restores it).
                            	   597: ;------------------------------------------------------------------------------
                            	   598: _mode_transition_check:
02:0000E34A 2F00            	   599:     move.l  D0,-(SP)
02:0000E34C 102C0012        	   600:     move.b  ($0012,A4),D0
02:0000E350 B03900FF083E    	   601:     cmp.b   (LAST_GAMEMODE).l,D0
02:0000E356 6760            	   602:     beq.s   .mtc_done
                            	   603:     ; --- mode changed: latch new shadow and purge stale PPU state ---
02:0000E358 13C000FF083E    	   604:     move.b  D0,(LAST_GAMEMODE).l
02:0000E35E 423900FF0800    	   605:     clr.b   (PPU_LATCH).l
02:0000E364 427900FF0802    	   606:     clr.w   (PPU_VADDR).l
02:0000E36A 423900FF0809    	   607:     clr.b   (PPU_DHALF).l
02:0000E370 423900FF0808    	   608:     clr.b   (PPU_DBUF).l
                            	   609:     ; Phase 9: PPU_SCRL_X/Y clears removed (dead — never read)
                            	   610:     ; Direct VSRAM[0] + VSRAM[1] = 0 (inside vblank window).
02:0000E376 23FC4000001000C0	   611:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E37E 0004
02:0000E380 33FC000000C00000	   612:     move.w  #0,(VDP_DATA).l          ; Plane A V-scroll
02:0000E388 33FC000000C00000	   613:     move.w  #0,(VDP_DATA).l          ; Plane B V-scroll
                            	   614:     ; Preserve any live transfer work across a mode transition.
                            	   615:     ;
                            	   616:     ; Two cases matter:
                            	   617:     ;  1) DynTileBuf non-empty: pending dynamic record must survive.
                            	   618:     ;  2) TileBufSelector non-zero: pending static transfer request must survive.
                            	   619:     ;
                            	   620:     ; Room scroll transitions rely on selector-driven transfers after the mode
                            	   621:     ; has already changed, so clearing $0014 here when DynTileBuf is empty is
                            	   622:     ; too aggressive.
02:0000E390 4A2C0014        	   623:     tst.b   ($0014,A4)
02:0000E394 6622            	   624:     bne.s   .mtc_keep_pending
02:0000E396 0C2C00FF0302    	   625:     cmpi.b  #$FF,($0302,A4)
02:0000E39C 661A            	   626:     bne.s   .mtc_keep_pending
                            	   627:     ; No pending selector and DynTileBuf empty: safe to rewind the
                            	   628:     ; palette-precheck state and clear stale one-shots from the old mode.
02:0000E39E 422C0014        	   629:     clr.b   ($0014,A4)               ; PPU update request byte
02:0000E3A2 422C005C        	   630:     clr.b   ($005C,A4)               ; SwitchNameTablesReq one-shot
02:0000E3A6 197C003F0300    	   631:     move.b  #63,($0300,A4)
02:0000E3AC 197C00000301    	   632:     move.b  #0,($0301,A4)
02:0000E3B2 197C00FF0302    	   633:     move.b  #$FF,($0302,A4)
                            	   634: .mtc_keep_pending:
                            	   635: .mtc_done:
02:0000E3B8 201F            	   636:     move.l  (SP)+,D0
02:0000E3BA 4E75            	   637:     rts
                            	   638: 
                            	   639: 
                            	   640: 
                            	   641: ;------------------------------------------------------------------------------
                            	   642: ; _ppu_write_6 — PPUADDR ($2006)  ← T5 key implementation
                            	   643: ;
                            	   644: ; The NES PPU address register uses a two-write protocol (shared "w" latch):
                            	   645: ;   First  write: high byte of 15-bit VRAM address (bit 14 is forced clear by
                            	   646: ;                 hardware — valid VRAM is $0000–$3FFF).
                            	   647: ;   Second write: low byte.  After this write PPU_VADDR is fully updated and
                            	   648: ;                 the latch resets to 0.
                            	   649: ;
                            	   650: ; Side effect: resets the even-byte PPUDATA buffer (PPU_DHALF = 0) so that a
                            	   651: ; fresh address is always treated as the start of a new word-pair.
                            	   652: ;
                            	   653: ; Preserves: D1.
                            	   654: ;------------------------------------------------------------------------------
                            	   655: _ppu_write_6:
02:0000E3BC 48E74000        	   656:     movem.l D1,-(SP)
02:0000E3C0 123900FF0800    	   657:     move.b  (PPU_LATCH).l,D1
02:0000E3C6 4A01            	   658:     tst.b   D1
02:0000E3C8 6618            	   659:     bne.s   .second_write_6
                            	   660:     ; ---- First write: high byte ----
                            	   661:     ; High byte goes into PPU_VADDR+0.  Force bit 6 (addr bit 14) clear to
                            	   662:     ; keep address in the valid $0000–$3FFF window (matches NES hardware).
02:0000E3CA 0200003F        	   663:     andi.b  #$3F,D0
02:0000E3CE 13C000FF0802    	   664:     move.b  D0,(PPU_VADDR).l        ; store high byte
02:0000E3D4 13FC000100FF0800	   665:     move.b  #1,(PPU_LATCH).l
02:0000E3DC 4CDF0002        	   666:     movem.l (SP)+,D1
02:0000E3E0 4E75            	   667:     rts
                            	   668: .second_write_6:
                            	   669:     ; ---- Second write: low byte ----
02:0000E3E2 13C000FF0803    	   670:     move.b  D0,(PPU_VADDR+1).l      ; store low byte
02:0000E3E8 423900FF0800    	   671:     clr.b   (PPU_LATCH).l           ; reset w register
02:0000E3EE 423900FF0809    	   672:     clr.b   (PPU_DHALF).l           ; discard any pending even-byte buffer
02:0000E3F4 4CDF0002        	   673:     movem.l (SP)+,D1
02:0000E3F8 4E75            	   674:     rts
                            	   675: 
                            	   676: ;------------------------------------------------------------------------------
                            	   677: ; _ppu_write_7 — PPUDATA ($2007)  ← T16 full implementation
                            	   678: ;
                            	   679: ; Routes byte writes to one of two paths based on PPU_VADDR:
                            	   680: ;
                            	   681: ;   CHR-RAM path  (PPU_VADDR $0000–$1FFF):
                            	   682: ;     Accumulates 16 bytes per NES tile in CHR_TILE_BUF, then on the 16th
                            	   683: ;     byte converts the 2BPP NES tile to 4BPP Genesis format and writes the
                            	   684: ;     32-byte result to VDP VRAM at Genesis addr = NES_addr × 2.
                            	   685: ;
                            	   686: ;   Nametable/palette path (PPU_VADDR $2000–$3FFF):
                            	   687: ;     Buffers even-address bytes and flushes pairs as 16-bit VDP words
                            	   688: ;     (unchanged from T5 — correct for nametable clears and palette writes).
                            	   689: ;
                            	   690: ; NES 2BPP → Genesis 4BPP conversion:
                            	   691: ;   16 bytes in: 8 bytes plane-0 then 8 bytes plane-1 (one bit per pixel)
                            	   692: ;   32 bytes out: 4 bytes per row, 2 pixels per byte, high-nibble = left pixel
                            	   693: ;   Pixel color = (plane1_bit << 1) | plane0_bit   (values 0–3)
                            	   694: ;
                            	   695: ; VDP auto-increment = 2 (Reg 15 = $8F02 set by genesis_shell).
                            	   696: ; PPU_VADDR increments by 1 (horizontal mode, bit 2 of PPUCTRL = 0).
                            	   697: ;
                            	   698: ; Preserves: D0–D6, A0–A6 (all saved/restored).
                            	   699: ;------------------------------------------------------------------------------
                            	   700: _ppu_write_7:
02:0000E3FA 48E7FEC0        	   701:     movem.l D0-D6/A0-A1,-(SP)       ; save all working registers (A1 used by LUT in .chr_convert_upload)
                            	   702: 
02:0000E3FE 323900FF0802    	   703:     move.w  (PPU_VADDR).l,D1        ; D1 = current NES PPU address
                            	   704: 
                            	   705:     ; Route: CHR range ($0000–$1FFF) vs nametable/palette ($2000–$3FFF)
02:0000E404 0C412000        	   706:     cmpi.w  #$2000,D1
02:0000E408 647E            	   707:     bhs     .nt_write               ; ≥$2000 → nametable / palette path
                            	   708: 
                            	   709:     ;==========================================================================
                            	   710:     ; CHR TILE BUFFER PATH
                            	   711:     ;==========================================================================
                            	   712:     ; Buffer each byte.  On the 16th byte, convert the tile and upload it.
02:0000E40A 523900FF0834    	   713:     addq.b  #1,(CHR_HIT_COUNT).l   ; DEBUG: count every CHR path entry (wraps at 255)
02:0000E410 7400            	   714:     moveq   #0,D2
02:0000E412 143900FF0830    	   715:     move.b  (CHR_BUF_CNT).l,D2     ; D2 = bytes accumulated so far (0–15)
                            	   716: 
                            	   717:     ; Save this tile's base address on the first byte (aligned to 16 bytes)
02:0000E418 4A02            	   718:     tst.b   D2
02:0000E41A 660C            	   719:     bne.s   .chr_store_byte
02:0000E41C 3601            	   720:     move.w  D1,D3
02:0000E41E 0243FFF0        	   721:     andi.w  #$FFF0,D3               ; round down to 16-byte tile boundary
02:0000E422 33C300FF0832    	   722:     move.w  D3,(CHR_BUF_VADDR).l
                            	   723: 
                            	   724: .chr_store_byte:
02:0000E428 41F900FF0820    	   725:     lea     (CHR_TILE_BUF).l,A0
02:0000E42E 11802000        	   726:     move.b  D0,(A0,D2.w)            ; CHR_TILE_BUF[count] = byte
02:0000E432 523900FF0830    	   727:     addq.b  #1,(CHR_BUF_CNT).l     ; increment count
02:0000E438 6100032C        	   728:     bsr     .inc_ppuaddr            ; advance PPU_VADDR
                            	   729: 
02:0000E43C 0C39001000FF0830	   730:     cmpi.b  #16,(CHR_BUF_CNT).l
02:0000E444 663C            	   731:     bne.s   .chr_ret                ; not yet 16 bytes — keep buffering
                            	   732: 
                            	   733:     ; Complete tile — convert 2BPP → 4BPP and upload to VDP VRAM
                            	   734:     ifne CHR_EXPANSION_ENABLED
                            	   735:     ; Dispatch by NES address bit 12:
                            	   736:     ;   bit12=0 ($0000-$0FFF) → sprite half → _chr_upload_sprite_4x (4 copies)
                            	   737:     ;   bit12=1 ($1000-$1FFF) → BG half     → _chr_convert_upload   (1 copy)
                            	   738:     ; Preflight (reports/chr_preflight.txt) confirms PPUCTRL bit 3 = 0 always,
                            	   739:     ; so sprites live at $0000-$0FFF for all current scenes.
02:0000E446 343900FF0832    	   740:     move.w  (CHR_BUF_VADDR).l,D2
02:0000E44C 0802000C        	   741:     btst    #12,D2
02:0000E450 6606            	   742:     bne.s   .chr_bg_dispatch
02:0000E452 610003D6        	   743:     bsr     _chr_upload_sprite_4x
02:0000E456 6024            	   744:     bra.s   .chr_uploaded
                            	   745: .chr_bg_dispatch:
02:0000E458 61000330        	   746:     bsr     _chr_convert_upload
02:0000E45C 0839000500FF0804	   747:     btst    #5,(PPU_CTRL).l
02:0000E464 6716            	   748:     beq.s   .chr_uploaded
02:0000E466 303900FF0832    	   749:     move.w  (CHR_BUF_VADDR).l,D0
02:0000E46C 0C401F20        	   750:     cmpi.w  #$1F20,D0
02:0000E470 650A            	   751:     blo.s   .chr_uploaded
02:0000E472 0C401F40        	   752:     cmpi.w  #$1F40,D0
02:0000E476 6404            	   753:     bhs.s   .chr_uploaded
02:0000E478 610003B0        	   754:     bsr     _chr_upload_sprite_4x
                            	   755: .chr_uploaded:
                            	   756:     else
                            	   757:     bsr     _chr_convert_upload
                            	   758:     endc
02:0000E47C 423900FF0830    	   759:     clr.b   (CHR_BUF_CNT).l
                            	   760: 
                            	   761: .chr_ret:
02:0000E482 4CDF037F        	   762:     movem.l (SP)+,D0-D6/A0-A1
02:0000E486 4E75            	   763:     rts
                            	   764: 
                            	   765:     ;==========================================================================
                            	   766:     ; NAMETABLE / PALETTE PATH  (PPU_VADDR $2000–$3FFF)
                            	   767:     ;==========================================================================
                            	   768:     ; Word-pair buffering: buffer even-address byte, flush word on odd address.
                            	   769:     ;==========================================================================
                            	   770: .nt_write:
                            	   771:     ;======================================================================
                            	   772:     ; Nametable → Genesis Plane A row mapping:
                            	   773:     ;   NES NT_A tiles ($2000–$23BF, and mirrored $2400–$27BF)
                            	   774:     ;       → Plane A rows 0–29  (VDP $C000–$C5FF)
                            	   775:     ;   NES NT_B tiles ($2800–$2BBF, and mirrored $2C00–$2FBF)
                            	   776:     ;       → Plane A rows 30–59 (VDP $CF00–$D4FF)
                            	   777:     ;
                            	   778:     ; Zelda uses vertical mirroring so NT_A and NT_B are the only two
                            	   779:     ; physical nametables. Story-scroll (intro) writes new rows to NT_B
                            	   780:     ; via $2800+ as the scroll crosses the NT boundary — previously these
                            	   781:     ; writes were dropped, leaving Plane A rows 30..59 stale.
                            	   782:     ;
                            	   783:     ; Each row is 64 tiles × 2 bytes = $80 bytes wide in Plane A.
                            	   784:     ;   vdp_addr = $C000 + row * $80 + col * 2
                            	   785:     ;======================================================================
                            	   786:     ; Fold $2C00 mirror → $2800 (vertical mirroring alias for NT_B).
02:0000E488 0C412C00        	   787:     cmpi.w  #$2C00,D1
02:0000E48C 650A            	   788:     blo.s   .nt_no_b_mirror
02:0000E48E 0C413000        	   789:     cmpi.w  #$3000,D1
02:0000E492 6404            	   790:     bhs.s   .nt_no_b_mirror
02:0000E494 04410400        	   791:     subi.w  #$0400,D1
                            	   792: .nt_no_b_mirror:
                            	   793:     ; T39 HUD/playfield split (Zelda 4-screen semantics).
                            	   794:     ; Track original source range before folding $2400 → $2000:
                            	   795:     ;   D7 = 0 → source was $2000 (HUD region; rows 0-3 only)
                            	   796:     ;   D7 = 1 → source was $2400 (playfield region; rows 4-29 only)
                            	   797:     ; NES renders HUD from $2000 for scanlines 0-31 and playfield from
                            	   798:     ; $2400 for scanlines 32-239 via a mid-frame scroll split. On Gen we
                            	   799:     ; collapse both into Plane A, so we gate writes to avoid one source
                            	   800:     ; clobbering the other's rows. Overworld only writes $2400 rows 4-29
                            	   801:     ; (so the bug was latent), but cave rooms write $2400 rows 0-29 which
                            	   802:     ; stomped the HUD — see builds/reports/t39_stage_a_render_classification.md.
02:0000E498 7E00            	   803:     moveq   #0,D7
02:0000E49A 0C412400        	   804:     cmpi.w  #$2400,D1
02:0000E49E 6508            	   805:     blo.s   .nt_src_detected
02:0000E4A0 0C412800        	   806:     cmpi.w  #$2800,D1
02:0000E4A4 6402            	   807:     bhs.s   .nt_src_detected
02:0000E4A6 7E01            	   808:     moveq   #1,D7
                            	   809: .nt_src_detected:
                            	   810:     ; Fold $2400 mirror → $2000 (vertical mirroring alias for NT_A).
02:0000E4A8 0C412400        	   811:     cmpi.w  #$2400,D1
02:0000E4AC 650A            	   812:     blo.s   .nt_no_a_mirror
02:0000E4AE 0C412800        	   813:     cmpi.w  #$2800,D1
02:0000E4B2 6404            	   814:     bhs.s   .nt_no_a_mirror
02:0000E4B4 04410400        	   815:     subi.w  #$0400,D1
                            	   816: .nt_no_a_mirror:
                            	   817: 
