                            	   976: ;==============================================================================
                            	   977: ; tick_sq0 — Sq0 channel update
                            	   978: ;==============================================================================
                            	   979: tick_sq0:
02:00000A3E 4A3900FFE014    	   980:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:00000A44 6754            	   981:     beq     tick_trg
02:00000A46 533900FFE015    	   982:     subq.b  #1,(m_sq0_cnt).l
02:00000A4C 664C            	   983:     bne     tick_trg
02:00000A4E 207900FFE008    	   984:     move.l  (m_script_ptr).l,A0
02:00000A54 7200            	   985:     moveq   #0,D1
02:00000A56 123900FFE014    	   986:     move.b  (m_sq0_off).l,D1
02:00000A5C 523900FFE014    	   987:     addq.b  #1,(m_sq0_off).l
02:00000A62 10301000        	   988:     move.b  (A0,D1.w),D0
02:00000A66 4A00            	   989:     tst.b   D0
02:00000A68 6A22            	   990:     bpl.s   .play
02:00000A6A 61000164        	   991:     bsr     get_song_note_length
02:00000A6E 13C000FFE016    	   992:     move.b  D0,(m_sq0_len).l
02:00000A74 207900FFE008    	   993:     move.l  (m_script_ptr).l,A0
02:00000A7A 7200            	   994:     moveq   #0,D1
02:00000A7C 123900FFE014    	   995:     move.b  (m_sq0_off).l,D1
02:00000A82 523900FFE014    	   996:     addq.b  #1,(m_sq0_off).l
02:00000A88 10301000        	   997:     move.b  (A0,D1.w),D0
                            	   998: .play:
02:00000A8C 610001BA        	   999:     bsr     emit_note_sq0
02:00000A90 13F900FFE01600FF	  1000:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:00000A98 E015
                            	  1001:     bra     tick_trg
                            	  1002: 
                            	  1003: ;==============================================================================
                            	  1004: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	  1005: ;==============================================================================
                            	  1006: tick_trg:
02:00000A9A 4A3900FFE01C    	  1007:     tst.b   (m_trg_off).l
02:00000AA0 6700009E        	  1008:     beq     tick_noise
02:00000AA4 533900FFE01D    	  1009:     subq.b  #1,(m_trg_cnt).l
02:00000AAA 66000094        	  1010:     bne     tick_noise
                            	  1011: .prep_note_or_passage:
02:00000AAE 207900FFE008    	  1012:     move.l  (m_script_ptr).l,A0
02:00000AB4 7200            	  1013:     moveq   #0,D1
02:00000AB6 123900FFE01C    	  1014:     move.b  (m_trg_off).l,D1
02:00000ABC 523900FFE01C    	  1015:     addq.b  #1,(m_trg_off).l
02:00000AC2 10301000        	  1016:     move.b  (A0,D1.w),D0
02:00000AC6 676A            	  1017:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000AC8 4A00            	  1018:     tst.b   D0
02:00000ACA 6A56            	  1019:     bpl.s   .play_note_trg                ; direct note
02:00000ACC 0C0000F0        	  1020:     cmpi.b  #$F0,D0
02:00000AD0 6718            	  1021:     beq.s   .end_of_passage
02:00000AD2 652A            	  1022:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	  1023:     ; $F1-$FF → start passage
02:00000AD4 040000F0        	  1024:     subi.b  #$F0,D0
02:00000AD8 13C000FFE021    	  1025:     move.b  D0,(m_trg_rep_n).l
02:00000ADE 13F900FFE01C00FF	  1026:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000AE6 E022
02:00000AE8 60C4            	  1027:     bra.s   .prep_note_or_passage
                            	  1028: .end_of_passage:
02:00000AEA 533900FFE021    	  1029:     subq.b  #1,(m_trg_rep_n).l
02:00000AF0 670A            	  1030:     beq.s   .pass_done
02:00000AF2 13F900FFE02200FF	  1031:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000AFA E01C
                            	  1032: .pass_done:
02:00000AFC 60B0            	  1033:     bra.s   .prep_note_or_passage
                            	  1034: .prep_note_trg:
02:00000AFE 610000D0        	  1035:     bsr     get_song_note_length
02:00000B02 13C000FFE01E    	  1036:     move.b  D0,(m_trg_len).l
02:00000B08 207900FFE008    	  1037:     move.l  (m_script_ptr).l,A0
02:00000B0E 7200            	  1038:     moveq   #0,D1
02:00000B10 123900FFE01C    	  1039:     move.b  (m_trg_off).l,D1
02:00000B16 523900FFE01C    	  1040:     addq.b  #1,(m_trg_off).l
02:00000B1C 10301000        	  1041:     move.b  (A0,D1.w),D0
02:00000B20 6710            	  1042:     beq.s   .silence_trg
                            	  1043: .play_note_trg:
02:00000B22 61000182        	  1044:     bsr     emit_note_trg
02:00000B26 13F900FFE01E00FF	  1045:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B2E E01D
02:00000B30 600E            	  1046:     bra     tick_noise
                            	  1047: .silence_trg:
02:00000B32 610001E6        	  1048:     bsr     key_off_trg
02:00000B36 13F900FFE01E00FF	  1049:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000B3E E01D
                            	  1050:     bra     tick_noise
