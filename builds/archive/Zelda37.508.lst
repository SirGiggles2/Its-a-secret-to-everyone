02:00034EB0 704C            	  4381:     moveq   #76,D0
02:00034EB2 19400344        	  4382:     move.b  D0,($0344,A4)
02:00034EB6 7621            	  4383:     moveq   #33,D3
02:00034EB8 6100C21E        	  4384:     jsr     Anim_WriteSpecificItemSprites
                            	  4385:     ; Draw triforce over Link.
                            	  4386:     ;
