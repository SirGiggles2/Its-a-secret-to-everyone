02:000383D4 66000082        	   438:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   439:     ; Store in [00] the type of projectile the monster will throw.
                            	   440:     ;
02:000383D8 1880            	   441:     move.b  D0,($0000,A4)
                            	   442:     ; If we have the magic clock, or the monster is stunned, then return.
                            	   443:     ;
02:000383DA 102C066C        	   444:     move.b  ($066C,A4),D0
02:000383DE 1234203D        	   445:     move.b  ($3D,A4,D2.W),D1
02:000383E2 8001            	   446:     or.b  D1,D0
02:000383E4 6672            	   447:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   448:     ; Try to shoot. Return, if it failed.
