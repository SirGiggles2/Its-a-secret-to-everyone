02:0003BB36 7002            	  8051:     moveq   #2,D0
02:0003BB38 19400601        	  8052:     move.b  D0,($0601,A4)
                            	  8053: _anon_z04_160:
02:0003BB3C 0A3C0001        	  8054:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BB40 4E75            	  8055:     rts
                            	  8056: 
                            	  8057: ; Description:
                            	  8058: ; Lift up the Triforce of Courage while the room is light.
                            	  8059: ;
                            	  8060: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8061: ;
                            	  8062:     even
                            	  8063: Ganon_ScenePhase1:
02:0003BB42 701B            	  8064:     moveq   #27,D0
02:0003BB44 19400505        	  8065:     move.b  D0,($0505,A4)
                            	  8066:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8067:     ;
02:0003BB48 102C0028        	  8068:     move.b  ($0028,A4),D0
02:0003BB4C 6702            	  8069:     beq.s  __far_z_04_0089
02:0003BB4E 6012            	  8070:     jmp  Ganon_DrawBodyFrame0
                            	  8071: __far_z_04_0089:
                            	  8072:     ; Once the timer expires:
                            	  8073:     ; 1. unhalt Link
                            	  8074:     ; 2. clear the item to lift
                            	  8075:     ; 3. play level 9 song
                            	  8076:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8077:     ;
02:0003BB50 194000AC        	  8078:     move.b  D0,($00AC,A4)
02:0003BB54 19400505        	  8079:     move.b  D0,($0505,A4)
02:0003BB58 7020            	  8080:     moveq   #32,D0
02:0003BB5A 19400600        	  8081:     move.b  D0,($0600,A4)
02:0003BB5E 522C0445        	  8082:     addq.b  #1,($0445,A4)
                            	  8083:     even
                            	  8084: Ganon_DrawBodyFrame0:
                            	  8085:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8086:     ; with animation frame 0.
                            	  8087:     ;
02:0003BB62 7000            	  8088:     moveq   #0,D0
02:0003BB64 41EC046B        	  8089:     lea     ($046B,A4),A0
02:0003BB68 11802000        	  8090:     move.b  D0,(A0,D2.W)
02:0003BB6C 600002EC        	  8091:     jmp     Ganon_DrawBody
                            	  8092: 
                            	  8093: ; Description:
                            	  8094: ; Fighting Ganon.
                            	  8095: ;
                            	  8096: ; If Ganon is dying, go handle it.
