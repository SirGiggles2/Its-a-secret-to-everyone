                            	  7911: _anon_z04_159:
02:0003BA42 61000CC0        	  7912:     jsr     DecreaseObjectAngle
                            	  7913:     ; Load Patra's maneuver index.
                            	  7914:     ; It determines which counts of bits are looked up below.
                            	  7915:     ;
02:0003BA46 7600            	  7916:     moveq   #0,D3
02:0003BA48 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0003BA4C 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0003BA50 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0003BA54 0C000025        	  7924:     cmpi.b  #$25,D0
02:0003BA58 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003BA5A 41F90003B94C    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
