02:0003537E 19400321        	  4779:     move.b  D0,($0321,A4)
                            	  4780:     even
                            	  4781: _L_z02_DrawCredits_TerminateRecords:
                            	  4782:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  4783:     ; attributes or only tiles.
                            	  4784:     ;
02:00035382 103C00FF        	  4785:     move.b  #$FF,D0
02:00035386 19400325        	  4786:     move.b  D0,($0325,A4)
02:0003538A 19400330        	  4787:     move.b  D0,($0330,A4)
                            	  4788:     ; Specify that we're transferring $20 bytes/tiles.
                            	  4789:     ;
02:0003538E 7020            	  4790:     moveq   #32,D0
02:00035390 19400304        	  4791:     move.b  D0,($0304,A4)
                            	  4792:     ; Write the high byte of the current VRAM page.
                            	  4793:     ;
02:00035394 7400            	  4794:     moveq   #0,D2
02:00035396 142C050C        	  4795:     move.b  ($050C,A4),D2
02:0003539A 41F900035140    	  4796:     lea     (CreditLineVramAddrsHi).l,A0
02:000353A0 10302000        	  4797:     move.b  (A0,D2.W),D0
02:000353A4 19400302        	  4798:     move.b  D0,($0302,A4)
                            	  4799:     ; The line number will be used to shift the task mask below.
                            	  4800:     ;
02:000353A8 102C050D        	  4801:     move.b  ($050D,A4),D0
02:000353AC 7600            	  4802:     moveq   #0,D3
02:000353AE 1600            	  4803:     move.b  D0,D3
                            	  4804:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  4805:     ;
02:000353B0 E308            	  4806:     lsl.b  #1,D0   ; ASL A
02:000353B2 E308            	  4807:     lsl.b  #1,D0   ; ASL A
02:000353B4 E308            	  4808:     lsl.b  #1,D0   ; ASL A
02:000353B6 E308            	  4809:     lsl.b  #1,D0   ; ASL A
02:000353B8 E308            	  4810:     lsl.b  #1,D0   ; ASL A
02:000353BA 19400303        	  4811:     move.b  D0,($0303,A4)
                            	  4812:     ; Get the mask for the current VRAM page.
                            	  4813:     ;
02:000353BE 41F90003514C    	  4814:     lea     (CreditsPagesTextMasks).l,A0
02:000353C4 10302000        	  4815:     move.b  (A0,D2.W),D0
                            	  4816: _anon_z02_43:
                            	  4817:     ; Shift left as many times as the current VRAM line number,
                            	  4818:     ; to get the bit that indicates whether this line has text.
                            	  4819:     ;
02:000353C8 E308            	  4820:     lsl.b  #1,D0   ; ASL A
02:000353CA 5303            	  4821:     subq.b  #1,D3
02:000353CC 6AFA            	  4822:     bpl  _anon_z02_43
02:000353CE 6400013E        	  4823:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  4824:     ; The mask inidcates that it should have text.
                            	  4825:     ; But if line index >= $17, then it doesn't.
                            	  4826:     ;
02:000353D2 7600            	  4827:     moveq   #0,D3
02:000353D4 162C050E        	  4828:     move.b  ($050E,A4),D3
02:000353D8 0C030017        	  4829:     cmpi.b  #$17,D3
02:000353DC 64000130        	  4830:     bcc  _L_z02_DrawCredits_IncVramLine
                            	  4831:     ; In the first quest, don't consider line numbers >= $10.
                            	  4832:     ;
02:000353E0 7400            	  4833:     moveq   #0,D2
02:000353E2 142C0016        	  4834:     move.b  ($0016,A4),D2
02:000353E6 41EC062D        	  4835:     lea     ($062D,A4),A0
02:000353EA 10302000        	  4836:     move.b  (A0,D2.W),D0
02:000353EE 6608            	  4837:     bne  _anon_z02_44
02:000353F0 0C030010        	  4838:     cmpi.b  #$10,D3
02:000353F4 64000114        	  4839:     bcc  _L_z02_DrawCredits_IncLine
                            	  4840: _anon_z02_44:
02:000353F8 7400            	  4841:     moveq   #0,D2
02:000353FA 142C0016        	  4842:     move.b  ($0016,A4),D2
02:000353FE 41EC062D        	  4843:     lea     ($062D,A4),A0
02:00035402 10302000        	  4844:     move.b  (A0,D2.W),D0
                            	  4845:     ; In the second quest, skip lines $C to $F.
                            	  4846:     ;
02:00035406 670E            	  4847:     beq  _anon_z02_45
02:00035408 0C03000C        	  4848:     cmpi.b  #$0C,D3
02:0003540C 6508            	  4849:     bcs  _anon_z02_45
02:0003540E 0C030010        	  4850:     cmpi.b  #$10,D3
02:00035412 650000F6        	  4851:     bcs  _L_z02_DrawCredits_IncLine
                            	  4852: _anon_z02_45:
02:00035416 41F900035158    	  4853:     lea     (CreditsTextAddrsLo).l,A0
02:0003541C 10303000        	  4854:     move.b  (A0,D3.W),D0
02:00035420 1880            	  4855:     move.b  D0,($0000,A4)
02:00035422 41F900035170    	  4856:     lea     (CreditsTextAddrsHi).l,A0
02:00035428 10303000        	  4857:     move.b  (A0,D3.W),D0
02:0003542C 19400001        	  4858:     move.b  D0,($0001,A4)
                            	  4859:     ; First read the length of the string.
                            	  4860:     ;
02:00035430 7600            	  4861:     moveq   #0,D3
02:00035432 1214            	  4862:     move.b  ($00,A4),D1   ; ptr lo
02:00035434 182C0001        	  4863:     move.b  ($01,A4),D4  ; ptr hi
02:00035438 024100FF        	  4864:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003543C E14C            	  4865:     lsl.w   #8,D4
02:0003543E 8841            	  4866:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035440 48C4            	  4867:     ext.l   D4
02:00035442 D8BC00FF0000    	  4868:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00035448 2044            	  4869:     movea.l D4,A0
02:0003544A 10303000        	  4870:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0003544E 19400002        	  4871:     move.b  D0,($0002,A4)
                            	  4872:     ; Second, read the offset where the first character goes
                            	  4873:     ; in the line.
                            	  4874:     ;
02:00035452 5203            	  4875:     addq.b  #1,D3
02:00035454 1214            	  4876:     move.b  ($00,A4),D1   ; ptr lo
02:00035456 182C0001        	  4877:     move.b  ($01,A4),D4  ; ptr hi
02:0003545A 024100FF        	  4878:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003545E E14C            	  4879:     lsl.w   #8,D4
02:00035460 8841            	  4880:     or.w    D1,D4             ; D4 = NES ptr addr
02:00035462 48C4            	  4881:     ext.l   D4
02:00035464 D8BC00FF0000    	  4882:     add.l   #NES_RAM,D4       ; → Genesis addr
