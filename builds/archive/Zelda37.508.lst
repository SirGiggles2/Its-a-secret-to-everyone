                            	  5115: ; Params:
                            	  5116: ; Y: limit index (0 for dust cloud, 1 for the bomb)
                            	  5117: ; [00]: monster hotspot X
                            	  5118: ; [01]: monster hotspot Y
                            	  5119: ; [02]: bomb hotspot X
                            	  5120: ; [03]: bomb hotspot Y
                            	  5121: ;
                            	  5122: ; Returns:
                            	  5123: ; A: 0 if the bomb is in range of the monster
                            	  5124: ; Z: 1 if the bomb is in range of the monster
                            	  5125: ; [04]: horizontal distance
                            	  5126: ; [05]: vertical distance
                            	  5127: ;
                            	  5128: ; Store the positive limit in [06], and the negative one in [07].
                            	  5129: ;
                            	  5130:     even
