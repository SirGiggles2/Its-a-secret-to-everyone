02:000392C2 7400            	  2620:     moveq   #0,D2
02:000392C4 142C0340        	  2621:     move.b  ($0340,A4),D2
02:000392C8 4EB900030E94    	  2622:     jsr     DrawObjectNotMirrored
02:000392CE 101D            	  2623:     move.b  (A5)+,D0  ; PLA
