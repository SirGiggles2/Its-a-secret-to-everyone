02:0004952C 1940004B        	  7135:     move.b  D0,($004B,A4)
02:00049530 41EC0492        	  7136:     lea     ($0492,A4),A0
02:00049534 11802000        	  7137:     move.b  D0,(A0,D2.W)
02:00049538 4E75            	  7138:     rts
                            	  7139:     even
