                            	  4867: ; Params:
                            	  4868: ; A: tile
                            	  4869: ; [00]: X
                            	  4870: ; [01]: Y
                            	  4871: ; [03]: sprite attributes
                            	  4872: ;
                            	  4873: ; Save the tile
                            	  4874:     even
