02:0003BE0C 0C02000A        	  8460:     cmpi.b  #$0A,D2
02:0003BE10 65AC            	  8461:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	  8462:     ; Restore the object index.
