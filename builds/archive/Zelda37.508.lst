02:0000E6C4 3A04            	  1093:     move.w  D4,D5
02:0000E6C6 EC4D            	  1094:     lsr.w   #6,D5
02:0000E6C8 02450003        	  1095:     andi.w  #$0003,D5
02:0000E6CC EB4D            	  1096:     lsl.w   #5,D5
02:0000E6CE E14D            	  1097:     lsl.w   #8,D5
