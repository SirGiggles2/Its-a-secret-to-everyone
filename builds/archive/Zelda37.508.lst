                            	  3943: _L_z04_Moldorm_PropagateDirs_SkipBounce:
                            	  3944:     ; Will loop 4 times, indexed by [00], once for each segment.
                            	  3945:     ;
02:00039C6A 7004            	  3946:     moveq   #4,D0
02:00039C6C 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:00039C6E 7600            	  3950:     moveq   #0,D3
02:00039C70 0C020005        	  3951:     cmpi.b  #$05,D2
02:00039C74 6702            	  3952:     beq  _L_z04_Moldorm_PropagateDirs_Loop
02:00039C76 7605            	  3953:     moveq   #5,D3
