                            	  2659: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  2660:     ; If there is a mismatch between the current quest and the quest
                            	  2661:     ; needed for the secret in this room, then return.
                            	  2662:     ;
02:00039308 6100021C        	  2663:     jsr     IsQuestSecretMismatch
02:0003930C 6500008A        	  2664:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  2665:     ; The gravestone and rocks can only be pushed vertically.
                            	  2666:     ; Return, if X's don't match.
                            	  2667:     ;
02:00039310 102C0070        	  2668:     move.b  ($0070,A4),D0
02:00039314 12342070        	  2669:     move.b  ($70,A4,D2.W),D1
02:00039318 B001            	  2670:     cmp.b   D1,D0
02:0003931A 667C            	  2671:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  2672:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  2673:     ; is positive; then go use it along with a flag that indicates that
                            	  2674:     ; Link is "down" from the object.
                            	  2675:     ;
02:0003931C 7600            	  2676:     moveq   #0,D3
02:0003931E 102C0084        	  2677:     move.b  ($0084,A4),D0
02:00039322 023C00EE        	  2678:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039326 123C0003        	  2679:     move.b  #$03,D1
02:0003932A D101            	  2680:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0003932C 003C0011        	  2681:     ori     #$11,CCR  ; SEC: set C+X
02:00039330 41EC0084        	  2682:     lea     ($0084,A4),A0
02:00039334 12302000        	  2683:     move.b  (A0,D2.W),D1
02:00039338 0A3C0010        	  2684:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003933C 9101            	  2685:     subx.b  D1,D0   ; SBC ObjY,X
02:0003933E 0A3C0010        	  2686:     eori    #$10,CCR  ; restore X = 6502 C
02:00039342 6A0E            	  2687:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  2688:     ; Else negate it, and indicate Link is "up" from the object.
                            	  2689:     ;
