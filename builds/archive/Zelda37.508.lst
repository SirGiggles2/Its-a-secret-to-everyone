                            	  8503: Ganon_DrawBody:
                            	  8504:     ; Loop over four 16x16 images that make up Ganon.
                            	  8505:     ; There are 6 animation frames.
                            	  8506:     ;
02:0003BE5A 7603            	  8507:     moveq   #3,D3
                            	  8508:     even
                            	  8509: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8510:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8511:     ;
02:0003BE5C 10342070        	  8512:     move.b  ($70,A4,D2.W),D0
02:0003BE60 023C00EE        	  8513:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE64 41F90003BE4E    	  8514:     lea     (GanonSpriteOffsetsX).l,A0
02:0003BE6A 12303000        	  8515:     move.b  (A0,D3.W),D1
02:0003BE6E D101            	  8516:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0003BE70 1880            	  8517:     move.b  D0,($0000,A4)
                            	  8518:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8519:     ;
02:0003BE72 41EC0084        	  8520:     lea     ($0084,A4),A0
02:0003BE76 10302000        	  8521:     move.b  (A0,D2.W),D0
02:0003BE7A 023C00EE        	  8522:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003BE7E 41F90003BE52    	  8523:     lea     (GanonSpriteOffsetsY).l,A0
02:0003BE84 12303000        	  8524:     move.b  (A0,D3.W),D1
02:0003BE88 D101            	  8525:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0003BE8A 19400001        	  8526:     move.b  D0,($0001,A4)
                            	  8527:     ; Each part has a horizontal flipping flag.
                            	  8528:     ;
02:0003BE8E 41F90003BE56    	  8529:     lea     (GanonSpriteHFlips).l,A0
02:0003BE94 10303000        	  8530:     move.b  (A0,D3.W),D0
02:0003BE98 1940000F        	  8531:     move.b  D0,($000F,A4)
                            	  8532:     ; Save and copy the loop index (the current part) to [07].
                            	  8533:     ;
02:0003BE9C 1003            	  8534:     move.b  D3,D0
02:0003BE9E 1B00            	  8535:     move.b  D0,-(A5)  ; PHA
02:0003BEA0 19400007        	  8536:     move.b  D0,($0007,A4)
                            	  8537:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8538:     ; that make it up.
                            	  8539:     ;
02:0003BEA4 41EC046B        	  8540:     lea     ($046B,A4),A0
02:0003BEA8 10302000        	  8541:     move.b  (A0,D2.W),D0
02:0003BEAC E308            	  8542:     lsl.b  #1,D0   ; ASL A
02:0003BEAE E308            	  8543:     lsl.b  #1,D0   ; ASL A
                            	  8544:     ; Add [07] -- the index of the current part.
                            	  8545:     ;
                            	  8546:     ; Now you have an index into the frame image table, for the
                            	  8547:     ; current image part of the current animation frame.
                            	  8548:     ;
02:0003BEB0 122C0007        	  8549:     move.b  ($0007,A4),D1
02:0003BEB4 D101            	  8550:     addx.b  D1,D0   ; ADC $07
02:0003BEB6 7600            	  8551:     moveq   #0,D3
02:0003BEB8 1600            	  8552:     move.b  D0,D3
02:0003BEBA 41F90003BE36    	  8553:     lea     (GanonFrameImages).l,A0
02:0003BEC0 10303000        	  8554:     move.b  (A0,D3.W),D0
02:0003BEC4 4EB900030E94    	  8555:     jsr     DrawObjectNotMirrored
02:0003BECA 101D            	  8556:     move.b  (A5)+,D0  ; PLA
                            	  8557:     ; Bottom of the part loop.
                            	  8558:     ;
02:0003BECC 7600            	  8559:     moveq   #0,D3
02:0003BECE 1600            	  8560:     move.b  D0,D3
02:0003BED0 5303            	  8561:     subq.b  #1,D3
02:0003BED2 6A88            	  8562:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0003BED4 4E75            	  8563:     rts
