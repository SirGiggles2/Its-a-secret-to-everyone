                            	  1380: ;----------------------------------------------------------------------
                            	  1381: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1382: ; Layout per slot:
                            	  1383: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1384: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1385: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1386: ;   +3 reserved
                            	  1387: ;
                            	  1388: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1389: ; values are placeholders.
                            	  1390: ;----------------------------------------------------------------------
                            	  1391: PsgDrumTable:
02:00000E86 E7              	  1392:     dc.b    $E7, $00, $00, $00         ; 0: rest (handled by early-out)
02:00000E87 00
02:00000E88 00
02:00000E89 00
