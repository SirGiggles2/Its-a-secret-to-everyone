02:0003A7F4 7600            	  5482:     moveq   #0,D3
02:0003A7F6 1600            	  5483:     move.b  D0,D3
02:0003A7F8 41F90003A608    	  5484:     lea     (PolsVoiceDirections).l,A0
02:0003A7FE 10303000        	  5485:     move.b  (A0,D3.W),D0
02:0003A802 41EC0098        	  5486:     lea     ($0098,A4),A0
02:0003A806 11802000        	  5487:     move.b  D0,(A0,D2.W)
                            	  5488:     ; Randomly set distance-to-move to $30 or $70.
                            	  5489:     ;
02:0003A80A 10342018        	  5490:     move.b  ($18,A4,D2.W),D0
02:0003A80E 02000040        	  5491:     andi.b #$40,D0
02:0003A812 123C0030        	  5492:     move.b  #$30,D1
02:0003A816 D101            	  5493:     addx.b  D1,D0   ; ADC #$30 (X flag = 6502 C)
02:0003A818 41EC0394        	  5494:     lea     ($0394,A4),A0
02:0003A81C 11802000        	  5495:     move.b  D0,(A0,D2.W)
                            	  5496:     ; Align the monster with a square horizontally.
                            	  5497:     ;
                            	  5498:     ; If in the left half of a square, align with that square.
                            	  5499:     ; If in the right half, align with the next square.
                            	  5500:     ;
02:0003A820 10342070        	  5501:     move.b  ($70,A4,D2.W),D0
02:0003A824 023C00EE        	  5502:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A828 123C0008        	  5503:     move.b  #$08,D1
02:0003A82C D101            	  5504:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A82E 020000F0        	  5505:     andi.b #$F0,D0
02:0003A832 19802070        	  5506:     move.b  D0,($70,A4,D2.W)
                            	  5507:     ; Align the monster with a square vertically.
                            	  5508:     ;
                            	  5509:     ; If in the top half of a square, align with that square.
                            	  5510:     ; If in the bottom half, align with the next square.
                            	  5511:     ;
02:0003A836 41EC0084        	  5512:     lea     ($0084,A4),A0
02:0003A83A 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0003A83E 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A842 123C0008        	  5515:     move.b  #$08,D1
02:0003A846 D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A848 020000F0        	  5517:     andi.b #$F0,D0
                            	  5518:     ; Make sure the lower nibble of Y is $D as usual.
                            	  5519:     ;
02:0003A84C 003C0011        	  5520:     ori     #$11,CCR  ; SEC: set C+X
02:0003A850 123C0003        	  5521:     move.b  #$03,D1
02:0003A854 0A3C0010        	  5522:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003A858 9101            	  5523:     subx.b  D1,D0   ; SBC #$03
02:0003A85A 0A3C0010        	  5524:     eori    #$10,CCR  ; restore X = 6502 C
02:0003A85E 41EC0084        	  5525:     lea     ($0084,A4),A0
02:0003A862 11802000        	  5526:     move.b  D0,(A0,D2.W)
