02:0003E6F2 12303000        	  3872:     move.b  (A0,D3.W),D1
02:0003E6F6 B001            	  3873:     cmp.b   D1,D0
02:0003E6F8 6622            	  3874:     bne  _anon_z05_95
02:0003E6FA 102C0001        	  3875:     move.b  ($0001,A4),D0
02:0003E6FE 41F90003E6CA    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:0003E704 12303000        	  3877:     move.b  (A0,D3.W),D1
02:0003E708 B001            	  3878:     cmp.b   D1,D0
02:0003E70A 6510            	  3879:     bcs  _anon_z05_95
02:0003E70C 41F90003E6CE    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:0003E712 12303000        	  3881:     move.b  (A0,D3.W),D1
02:0003E716 B001            	  3882:     cmp.b   D1,D0
02:0003E718 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
                            	  3884: _anon_z05_95:
