                            	   520: ;------------------------------------------------------------------------------
                            	   521: ; _ags_activate_staged — Promote STAGED_* into the active queue/debug state.
                            	   522: ; Clobbers D0.
                            	   523: ;------------------------------------------------------------------------------
                            	   524: _ags_activate_staged:
02:0000E25C 103900FF080A    	   525:     move.b  (STAGED_SCROLL_MODE).l,D0
02:0000E262 13C000FF081F    	   526:     move.b  D0,(INTRO_SCROLL_MODE).l
02:0000E268 33F900FF080C00FF	   527:     move.w  (STAGED_BASE_VSRAM).l,(ACTIVE_BASE_VSRAM).l
02:0000E270 0836
02:0000E272 33F900FF080E00FF	   528:     move.w  (STAGED_EVENT_VSRAM).l,(ACTIVE_EVENT_VSRAM).l
02:0000E27A 0838
02:0000E27C 13F900FF080B00FF	   529:     move.b  (STAGED_HINT_CTR).l,(ACTIVE_HINT_CTR).l
02:0000E284 083A
02:0000E286 4A00            	   530:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,D0
02:0000E288 6726            	   531:     beq.s   .aas_no_split
02:0000E28A 13FC000100FF081E	   532:     move.b  #1,(HINT_PEND_SPLIT).l
02:0000E292 13FC000100FF0816	   533:     move.b  #1,(HINT_Q_COUNT).l
02:0000E29A 13F900FF080B00FF	   534:     move.b  (STAGED_HINT_CTR).l,(HINT_Q0_CTR).l
02:0000E2A2 0817
02:0000E2A4 33F900FF080E00FF	   535:     move.w  (STAGED_EVENT_VSRAM).l,(HINT_Q0_VSRAM).l
02:0000E2AC 0818
02:0000E2AE 4E75            	   536:     rts
                            	   537: .aas_no_split:
02:0000E2B0 13FC000000FF081E	   538:     move.b  #0,(HINT_PEND_SPLIT).l
02:0000E2B8 13FC000000FF0816	   539:     move.b  #0,(HINT_Q_COUNT).l
02:0000E2C0 4E75            	   540:     rts
