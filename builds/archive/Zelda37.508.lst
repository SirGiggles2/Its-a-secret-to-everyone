02:0003A34E 1B00            	  4876:     move.b  D0,-(A5)  ; PHA
02:0003A350 7600            	  4877:     moveq   #0,D3
02:0003A352 162C0341        	  4878:     move.b  ($0341,A4),D3
02:0003A356 41F900030E5C    	  4879:     lea     (SpriteOffsets).l,A0
02:0003A35C 10303000        	  4880:     move.b  (A0,D3.W),D0
02:0003A360 7600            	  4881:     moveq   #0,D3
02:0003A362 1600            	  4882:     move.b  D0,D3
02:0003A364 101D            	  4883:     move.b  (A5)+,D0  ; PLA
02:0003A366 41EC0201        	  4884:     lea     ($0201,A4),A0
02:0003A36A 11803000        	  4885:     move.b  D0,(A0,D3.W)
02:0003A36E 1014            	  4886:     move.b  ($0000,A4),D0
02:0003A370 41EC0203        	  4887:     lea     ($0203,A4),A0
02:0003A374 11803000        	  4888:     move.b  D0,(A0,D3.W)
02:0003A378 102C0001        	  4889:     move.b  ($0001,A4),D0
02:0003A37C 4EF9000311DA    	  4890:     jmp     Anim_EndWriteSprite
