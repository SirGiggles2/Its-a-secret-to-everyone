02:00047298 19400002        	  2320:     move.b  D0,($0002,A4)
02:0004729C 4EB900030C36    	  2321:     jsr     MapScreenPosToPpuAddr
02:000472A2 7400            	  2322:     moveq   #0,D2
02:000472A4 142C0301        	  2323:     move.b  ($0301,A4),D2
                            	  2324:     ; Two transfer records will be written to the buffer and an end marker.
                            	  2325:     ;
                            	  2326:     ; Each record is 5 bytes and will transfer 2 tiles arranged vertically.
                            	  2327:     ; In total, 11 bytes will be written.
                            	  2328:     ;
                            	  2329:     ; First, write the high byte of PPU address in each record.
                            	  2330:     ;
02:000472A8 1014            	  2331:     move.b  ($0000,A4),D0
02:000472AA 41EC0302        	  2332:     lea     ($0302,A4),A0
02:000472AE 11802000        	  2333:     move.b  D0,(A0,D2.W)
02:000472B2 41EC0307        	  2334:     lea     ($0307,A4),A0
02:000472B6 11802000        	  2335:     move.b  D0,(A0,D2.W)
                            	  2336:     ; Write the low address in the first record. In the second record,
                            	  2337:     ; write (low address + 1).
                            	  2338:     ;
02:000472BA 102C0001        	  2339:     move.b  ($0001,A4),D0
02:000472BE 41EC0303        	  2340:     lea     ($0303,A4),A0
02:000472C2 11802000        	  2341:     move.b  D0,(A0,D2.W)
02:000472C6 41EC0308        	  2342:     lea     ($0308,A4),A0
02:000472CA 11802000        	  2343:     move.b  D0,(A0,D2.W)
02:000472CE 41EC0308        	  2344:     lea     ($0308,A4),A0
02:000472D2 52302000        	  2345:     addq.b  #1,(A0,D2.W)
                            	  2346:     ; Write the first tile twice in each record. Patch them later.
                            	  2347:     ;
02:000472D6 102C0005        	  2348:     move.b  ($0005,A4),D0
02:000472DA 41EC0305        	  2349:     lea     ($0305,A4),A0
02:000472DE 11802000        	  2350:     move.b  D0,(A0,D2.W)
02:000472E2 41EC0306        	  2351:     lea     ($0306,A4),A0
02:000472E6 11802000        	  2352:     move.b  D0,(A0,D2.W)
02:000472EA 41EC030A        	  2353:     lea     ($030A,A4),A0
02:000472EE 11802000        	  2354:     move.b  D0,(A0,D2.W)
02:000472F2 41EC030B        	  2355:     lea     ($030B,A4),A0
02:000472F6 11802000        	  2356:     move.b  D0,(A0,D2.W)
                            	  2357:     ; If tile >= $46 and < $F3, add 2 to the tile bytes in the second record.
                            	  2358:     ; Add 1 more to the second byte in each record.
                            	  2359:     ; Here is an example result of this manipulation:
                            	  2360:     ;   record 1: $70, $71
                            	  2361:     ;   record 2: $72, $73
                            	  2362:     ;
02:000472FA 0C000046        	  2363:     cmpi.b  #$46,D0
02:000472FE 6530            	  2364:     bcs  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047300 0C0000F3        	  2365:     cmpi.b  #$F3,D0
02:00047304 642A            	  2366:     bcc  _L_z07_ChangeTileObjTiles_SetCountBytes
02:00047306 023C00EE        	  2367:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004730A 123C0002        	  2368:     move.b  #$02,D1
02:0004730E D101            	  2369:     addx.b  D1,D0   ; ADC #$02 (X flag = 6502 C)
02:00047310 41EC030A        	  2370:     lea     ($030A,A4),A0
02:00047314 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:00047318 41EC030B        	  2372:     lea     ($030B,A4),A0
02:0004731C 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:00047320 41EC0306        	  2374:     lea     ($0306,A4),A0
02:00047324 52302000        	  2375:     addq.b  #1,(A0,D2.W)
02:00047328 41EC030B        	  2376:     lea     ($030B,A4),A0
02:0004732C 52302000        	  2377:     addq.b  #1,(A0,D2.W)
                            	  2378:     even
                            	  2379: _L_z07_ChangeTileObjTiles_SetCountBytes:
                            	  2380:     ; Set the count byte in each record to $82:
