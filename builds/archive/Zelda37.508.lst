02:0003891E 102C066C        	  1215:     move.b  ($066C,A4),D0
02:00038922 1234203D        	  1216:     move.b  ($3D,A4,D2.W),D1
02:00038926 8001            	  1217:     or.b  D1,D0
02:00038928 6610            	  1218:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1219:     ; Shoot.
                            	  1220:     ;
