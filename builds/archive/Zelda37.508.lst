                            	  2014: UpdateOctorock:
                            	  2015:     ; If the monster is a fast octorock, use turn rate $A0.
                            	  2016:     ; Else use turn rate $70.
                            	  2017:     ;
02:00038EEA 103C00A0        	  2018:     move.b  #$A0,D0
02:00038EEE 7600            	  2019:     moveq   #0,D3
02:00038EF0 41EC034F        	  2020:     lea     ($034F,A4),A0
02:00038EF4 16302000        	  2021:     move.b  (A0,D2.W),D3
02:00038EF8 0C030009        	  2022:     cmpi.b  #$09,D3
02:00038EFC 6402            	  2023:     bcc  _anon_z04_48
02:00038EFE 7070            	  2024:     moveq   #112,D0
                            	  2025: _anon_z04_48:
02:00038F00 41EC041F        	  2026:     lea     ($041F,A4),A0
02:00038F04 11802000        	  2027:     move.b  D0,(A0,D2.W)
02:00038F08 6100F372        	  2028:     jsr     Wanderer_TargetPlayer
                            	  2029:     ; If the octorock is slow, then use q-speed $20.
                            	  2030:     ; Else double it.
                            	  2031:     ;
02:00038F0C 7020            	  2032:     moveq   #32,D0
02:00038F0E 7600            	  2033:     moveq   #0,D3
02:00038F10 41EC034F        	  2034:     lea     ($034F,A4),A0
02:00038F14 16302000        	  2035:     move.b  (A0,D2.W),D3
02:00038F18 0C030007        	  2036:     cmpi.b  #$07,D3
02:00038F1C 6708            	  2037:     beq  _L_z04_UpdateOctorock_Shoot
02:00038F1E 0C030009        	  2038:     cmpi.b  #$09,D3
02:00038F22 6702            	  2039:     beq  _L_z04_UpdateOctorock_Shoot
02:00038F24 E308            	  2040:     lsl.b  #1,D0   ; ASL A
                            	  2041:     even
                            	  2042: _L_z04_UpdateOctorock_Shoot:
                            	  2043:     ; Shoot a flying rock (object type $53).
                            	  2044:     ;
02:00038F26 7653            	  2045:     moveq   #83,D3
02:00038F28 6100F97C        	  2046:     jsr     _TryShooting
02:00038F2C 4EB900049108    	  2047:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2048:     ; If facing down, then use frame image offset 2.
                            	  2049:     ;
02:00038F32 41EC0098        	  2050:     lea     ($0098,A4),A0
02:00038F36 10302000        	  2051:     move.b  (A0,D2.W),D0
02:00038F3A 7600            	  2052:     moveq   #0,D3
02:00038F3C 1600            	  2053:     move.b  D0,D3
02:00038F3E 0200000C        	  2054:     andi.b #$0C,D0
02:00038F42 670C            	  2055:     beq  _L_z04_UpdateOctorock_CheckHorizontal
02:00038F44 7002            	  2056:     moveq   #2,D0
02:00038F46 0C030008        	  2057:     cmpi.b  #$08,D3
02:00038F4A 6610            	  2058:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2059:     ; Else facing up. Use frame image offset 1.
                            	  2060:     ;
02:00038F4C 7001            	  2061:     moveq   #1,D0
02:00038F4E 660C            	  2062:     bne  _L_z04_UpdateOctorock_SaveOffset
                            	  2063:     even
                            	  2064: _L_z04_UpdateOctorock_CheckHorizontal:
                            	  2065:     ; If facing right, then set horizontal flipping, and use frame image offset 0.
                            	  2066:     ;
02:00038F50 0C030001        	  2067:     cmpi.b  #$01,D3
02:00038F54 6604            	  2068:     bne  _anon_z04_49
02:00038F56 522C000F        	  2069:     addq.b  #1,($000F,A4)
                            	  2070: _anon_z04_49:
                            	  2071:     ; Else facing left. Use frame image offset 0, but no horizontal flipping.
