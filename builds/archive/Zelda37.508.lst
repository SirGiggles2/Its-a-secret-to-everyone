                            	  1717: ; A: direction
                            	  1718: ; [01]: value for right
                            	  1719: ; [02]: value for left
                            	  1720: ;
                            	  1721: ; Returns:
                            	  1722: ; A: chosen value, or 0 if not horizontal
                            	  1723: ; C: 0
                            	  1724: ;
                            	  1725: ;
                            	  1726: ; Set default value 0 in default address 0.
                            	  1727: ;
                            	  1728:     even
