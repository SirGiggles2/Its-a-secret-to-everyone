                            	  1887:     ;
02:00038DE8 7001            	  1888:     moveq   #1,D0
02:00038DEA 41EC03D0        	  1889:     lea     ($03D0,A4),A0
02:00038DEE 11802000        	  1890:     move.b  D0,(A0,D2.W)
                            	  1891:     ; Set the long timer to 2, meaning 20 frames.
                            	  1892:     ;
