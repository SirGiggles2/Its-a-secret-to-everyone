                            	  8013:     ;
02:0003BAFA 7000            	  8014:     moveq   #0,D0
02:0003BAFC 1940051E        	  8015:     move.b  D0,($051E,A4)
                            	  8016:     ; On the first frame of the fade-to-light cycle, play the
