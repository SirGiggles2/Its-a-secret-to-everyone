02:0003890E 41EC0451        	  1202:     lea     ($0451,A4),A0
02:00038912 11802000        	  1203:     move.b  D0,(A0,D2.W)
                            	  1204:     ; If new shoot timer = 0, go set a non-zero speed.
                            	  1205:     ;
02:00038916 6728            	  1206:     beq  _L_z04__TryShooting_SetSpeed
                            	  1207:     ; shoot timer <> 0
                            	  1208:     ; If shoot timer <> $10, then go set a zero speed.
