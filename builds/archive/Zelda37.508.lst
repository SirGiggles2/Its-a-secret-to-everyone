02:0003BA6C 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0003BA70 7600            	  7931:     moveq   #0,D3
02:0003BA72 1600            	  7932:     move.b  D0,D3
02:0003BA74 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0003BA76 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
