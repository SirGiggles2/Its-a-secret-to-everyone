02:0003BC50 123C0007        	  8246:     move.b  #$07,D1
02:0003BC54 D101            	  8247:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0003BC56 19802070        	  8248:     move.b  D0,($70,A4,D2.W)
02:0003BC5A 41EC0084        	  8249:     lea     ($0084,A4),A0
