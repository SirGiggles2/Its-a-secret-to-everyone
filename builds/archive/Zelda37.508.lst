02:0003A7D4 41EC00AC        	  5470:     lea     ($00AC,A4),A0
02:0003A7D8 11802000        	  5471:     move.b  D0,(A0,D2.W)
                            	  5472:     ; Reset 16-bit vertical speed.
                            	  5473:     ;
02:0003A7DC 41EC0444        	  5474:     lea     ($0444,A4),A0
02:0003A7E0 11802000        	  5475:     move.b  D0,(A0,D2.W)
02:0003A7E4 41EC0412        	  5476:     lea     ($0412,A4),A0
02:0003A7E8 11802000        	  5477:     move.b  D0,(A0,D2.W)
                            	  5478:     ; Choose a random direction to face in.
                            	  5479:     ;
02:0003A7EC 10342018        	  5480:     move.b  ($18,A4,D2.W),D0
