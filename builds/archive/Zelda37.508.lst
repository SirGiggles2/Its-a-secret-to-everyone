02:000383E6 1014            	   450:     move.b  ($0000,A4),D0
02:000383E8 61003EBA        	   451:     jsr     _ShootIfWanted
02:000383EC 646A            	   452:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   453:     ; Set monster's state to $80 for delaying after shooting.
                            	   454:     ;
02:000383EE 103C0080        	   455:     move.b  #$80,D0
02:000383F2 41EC00AC        	   456:     lea     ($00AC,A4),A0
02:000383F6 11802000        	   457:     move.b  D0,(A0,D2.W)
                            	   458:     ; Reset the "wants to shoot" flag.
                            	   459:     ;
02:000383FA 7000            	   460:     moveq   #0,D0
02:000383FC 41EC0412        	   461:     lea     ($0412,A4),A0
02:00038400 11802000        	   462:     move.b  D0,(A0,D2.W)
                            	   463:     ; Have the shot keep track of the monster.
                            	   464:     ;
02:00038404 1002            	   465:     move.b  D2,D0
02:00038406 41EC042C        	   466:     lea     ($042C,A4),A0
02:0003840A 11803000        	   467:     move.b  D0,(A0,D3.W)
                            	   468:     ; Have the monster keep track of the shot.
                            	   469:     ;
02:0003840E 1003            	   470:     move.b  D3,D0
02:00038410 41EC042C        	   471:     lea     ($042C,A4),A0
02:00038414 11802000        	   472:     move.b  D0,(A0,D2.W)
                            	   473:     ; Set the shot's state to $10, which is the flying state for them.
                            	   474:     ;
02:00038418 7010            	   475:     moveq   #16,D0
02:0003841A 41EC00AC        	   476:     lea     ($00AC,A4),A0
02:0003841E 11803000        	   477:     move.b  D0,(A0,D3.W)
                            	   478:     ; Fly at q-speed $A0 (2.5 pixels a frame).
