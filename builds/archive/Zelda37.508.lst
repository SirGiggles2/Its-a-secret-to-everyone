02:0002CE8A 242F000C        	  4582:     move.l  12(SP),D2       ; slot arg → D2
02:0002CE8E 4EB90003C2B2    	  4583:     jsr     ShootLimited
02:0002CE94 7000            	  4584:     moveq   #0,D0
02:0002CE96 6406            	  4585:     bcc.s   .csl_no_carry
02:0002CE98 008000000100    	  4586:     ori.l   #$100,D0
                            	  4587: .csl_no_carry:
