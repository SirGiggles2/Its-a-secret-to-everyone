Source: "audio_driver.asm"
                            	     2: 
                            	     3: ;==============================================================================
                            	     4: ; audio_driver.asm — YM2612 + PSG driver for NES APU emulation
                            	     5: ;
                            	     6: ; Maps NES APU channels to Genesis sound hardware using Sonic 2 Emerald Hill
                            	     7: ; Zone FM patches:
                            	     8: ;   Pulse 1 → YM2612 ch 0 (EHZ Voice $00, Algorithm 7)
                            	     9: ;   Pulse 2 → YM2612 ch 1 (EHZ Voice $03, Algorithm 5)
                            	    10: ;   Triangle → YM2612 ch 2 (EHZ Voice $07, Algorithm 0)
                            	    11: ;   Noise   → SN76489 PSG ch 3
                            	    12: ;
                            	    13: ; Include BEFORE nes_io.asm so helpers are available to APU stubs.
                            	    14: ;==============================================================================
                            	    15: 
                            	    16: ;----------------------------------------------------------------------
                            	    17: ; Hardware ports
                            	    18: ;----------------------------------------------------------------------
                            	    19: YM_ADDR1        equ $A04000     ; YM2612 Part I address  (ch 0-2 + global regs)
                            	    20: YM_DATA1        equ $A04001     ; YM2612 Part I data
                            	    21: YM_ADDR2        equ $A04002     ; YM2612 Part II address (ch 3-5 / ch 6 DAC pan)
                            	    22: YM_DATA2        equ $A04003     ; YM2612 Part II data
                            	    23: PSG_PORT        equ $C00011     ; SN76489 PSG data
                            	    24: 
                            	    25: ;----------------------------------------------------------------------
                            	    26: ; Shadow APU registers ($FF0A00–$FF0A15)
                            	    27: ; Clear of NES RAM ($FF0000-$FF07FF), PPU/MMC1 ($FF0800-$FF083F),
                            	    28: ; H-int queue ($FF0816-$FF081F), forensics ($FF0900-$FF0943).
                            	    29: ;----------------------------------------------------------------------
                            	    30: APU_SH_BASE     equ $FF0A00
                            	    31: APU_SH_4000     equ APU_SH_BASE+$00    ; Pulse 1 duty/volume
                            	    32: APU_SH_4001     equ APU_SH_BASE+$01    ; Pulse 1 sweep (unused)
                            	    33: APU_SH_4002     equ APU_SH_BASE+$02    ; Pulse 1 period low
                            	    34: APU_SH_4003     equ APU_SH_BASE+$03    ; Pulse 1 period high + length
                            	    35: APU_SH_4004     equ APU_SH_BASE+$04    ; Pulse 2 duty/volume
                            	    36: APU_SH_4005     equ APU_SH_BASE+$05    ; Pulse 2 sweep (unused)
                            	    37: APU_SH_4006     equ APU_SH_BASE+$06    ; Pulse 2 period low
                            	    38: APU_SH_4007     equ APU_SH_BASE+$07    ; Pulse 2 period high + length
                            	    39: APU_SH_4008     equ APU_SH_BASE+$08    ; Triangle linear counter
                            	    40: APU_SH_400A     equ APU_SH_BASE+$0A    ; Triangle period low
                            	    41: APU_SH_400B     equ APU_SH_BASE+$0B    ; Triangle period high + length
                            	    42: APU_SH_400C     equ APU_SH_BASE+$0C    ; Noise volume/envelope
                            	    43: APU_SH_400E     equ APU_SH_BASE+$0E    ; Noise mode + period
                            	    44: APU_SH_400F     equ APU_SH_BASE+$0F    ; Noise length counter
                            	    45: APU_SH_4015     equ APU_SH_BASE+$10    ; Channel enable flags
                            	    46: 
                            	    47: ;----------------------------------------------------------------------
                            	    48: ; Frequency conversion constants
                            	    49: ;
                            	    50: ; NES pulse:    f = CPU_CLK / (16 * (P+1)),   CPU_CLK = 1,789,773
                            	    51: ; NES triangle: f = CPU_CLK / (32 * (P+1))    (one octave lower)
                            	    52: ; YM2612:       f = (F_num * 2^block * YM_CLK) / (144 * 2^20)
                            	    53: ;                   YM_CLK = 7,670,453
                            	    54: ;
                            	    55: ; K_pulse = CPU_CLK * 144 * 2^20 / (16 * YM_CLK) ≈ 4,403,410
                            	    56: ; K5_pulse = K_pulse >> 5 = 137,606    (base block = 5)
                            	    57: ; K5_tri   = K5_pulse / 2 = 68,803     (triangle is one octave below pulse)
                            	    58: ;
                            	    59: ; Sanity check: NES A4 (P=253, P+1=254) → K5/254 = 541.75
                            	    60: ;               Standard YM2612 F_num for A4 at block 5 = 541. ✓
                            	    61: ;----------------------------------------------------------------------
                            	    62: NES_YM_K5_PULSE equ 137606
                            	    63: NES_YM_K5_TRI   equ 68803
                            	    64: 
                            	    65: ;==============================================================================
                            	    66: ; ym_write1 — Write one register to YM2612 Part I
                            	    67: ;
                            	    68: ; Input:  D0.b = register address
                            	    69: ;         D1.b = data value
                            	    70: ; Output: none
                            	    71: ; Preserves: all registers
                            	    72: ;
                            	    73: ; SR lockout: the address+data pair MUST go out as an atomic latched write.
                            	    74: ; With the HBlank-driven DMC streamer enabled, the HINT handler also writes
                            	    75: ; $2A + data to YM2612 Part I; if it preempts between our address write and
                            	    76: ; data write, the YM latch is left pointing at $2A and our subsequent data
                            	    77: ; byte lands in the DAC instead of the intended register.  Mask HINT (level
                            	    78: ; 4) for the duration of the pair by raising SR interrupt level to 6, then
                            	    79: ; restore the caller's SR on exit.  Cost: ~16 cycles per call.
                            	    80: ;==============================================================================
                            	    81: ym_write1:
02:000003D0 40E7            	    82:     move.w  SR,-(SP)                ; save caller's SR
02:000003D2 007C0600        	    83:     ori.w   #$0600,SR               ; mask HINT (level 4) + its below
                            	    84: .wait:
02:000003D6 4A3900A04000    	    85:     tst.b   (YM_ADDR1).l            ; bit 7 = busy flag
02:000003DC 6BF8            	    86:     bmi.s   .wait
02:000003DE 13C000A04000    	    87:     move.b  D0,(YM_ADDR1).l         ; write register address
02:000003E4 4E71            	    88:     nop                              ; address setup delay
02:000003E6 4E71            	    89:     nop
02:000003E8 4E71            	    90:     nop
02:000003EA 13C100A04001    	    91:     move.b  D1,(YM_DATA1).l         ; write data
02:000003F0 46DF            	    92:     move.w  (SP)+,SR                ; restore SR (re-enables HINT)
02:000003F2 4E75            	    93:     rts
                            	    94: 
                            	    95: ;==============================================================================
                            	    96: ; ym_write2 — Write one register to YM2612 Part II
                            	    97: ;
                            	    98: ; Used for ch 4-5 regs and ch 6 pan ($B4+2 = $B6 on Part II).  The busy flag
                            	    99: ; is shared across both parts so we still poll Part I.  Same SR lockout as
                            	   100: ; ym_write1 to prevent HINT-based DMC streamer from stomping the latch.
                            	   101: ;
                            	   102: ; Input:  D0.b = register address
                            	   103: ;         D1.b = data value
                            	   104: ; Output: none
                            	   105: ; Preserves: all registers
                            	   106: ;==============================================================================
                            	   107: ym_write2:
02:000003F4 40E7            	   108:     move.w  SR,-(SP)
02:000003F6 007C0600        	   109:     ori.w   #$0600,SR
                            	   110: .wait:
02:000003FA 4A3900A04000    	   111:     tst.b   (YM_ADDR1).l            ; busy flag is shared between parts
02:00000400 6BF8            	   112:     bmi.s   .wait
02:00000402 13C000A04002    	   113:     move.b  D0,(YM_ADDR2).l         ; write register address (Part II)
02:00000408 4E71            	   114:     nop
02:0000040A 4E71            	   115:     nop
02:0000040C 4E71            	   116:     nop
02:0000040E 13C100A04003    	   117:     move.b  D1,(YM_DATA2).l         ; write data (Part II)
02:00000414 46DF            	   118:     move.w  (SP)+,SR
02:00000416 4E75            	   119:     rts
                            	   120: 
                            	   121: ;==============================================================================
                            	   122: ; nes_to_ym_freq — Convert NES 11-bit period to YM2612 frequency
                            	   123: ;
                            	   124: ; Input:  D2.w = 11-bit NES period (0–2047)
                            	   125: ;         D3.l = K constant (NES_YM_K5_PULSE or NES_YM_K5_TRI)
                            	   126: ; Output: D2.b = A4 register value (block<<3 | F_num bits 10:8)
                            	   127: ;         D3.b = A0 register value (F_num bits 7:0)
                            	   128: ; Destroys: D4, D5
                            	   129: ;==============================================================================
                            	   130: nes_to_ym_freq:
02:00000418 5242            	   131:     addq.w  #1,D2                   ; D2 = P + 1
02:0000041A B47C0002        	   132:     cmp.w   #2,D2
02:0000041E 6532            	   133:     blo.s   .silence                ; period 0 → silence
02:00000420 86C2            	   134:     divu    D2,D3                   ; D3.l / D2.w → quotient in D3.w
02:00000422 692E            	   135:     bvs.s   .silence                ; overflow safety
02:00000424 3A03            	   136:     move.w  D3,D5                   ; D5 = raw quotient = F_num at block 5
02:00000426 7805            	   137:     moveq   #5,D4                   ; starting block (K was pre-shifted by 5)
                            	   138: .norm:
02:00000428 BA7C07FF        	   139:     cmp.w   #2047,D5
02:0000042C 630C            	   140:     bls.s   .done                   ; F_num fits in 11 bits
02:0000042E E24D            	   141:     lsr.w   #1,D5                   ; halve F_num
02:00000430 5204            	   142:     addq.b  #1,D4                   ; increment block
02:00000432 B83C0007        	   143:     cmp.b   #7,D4
02:00000436 6210            	   144:     bhi.s   .clamp                  ; block overflow → clamp
02:00000438 60EE            	   145:     bra.s   .norm
                            	   146: .done:
                            	   147:     ; D5.w = F_num (0–2047), D4.b = block (0–7)
02:0000043A 1404            	   148:     move.b  D4,D2
02:0000043C E70A            	   149:     lsl.b   #3,D2                   ; block << 3
02:0000043E 3605            	   150:     move.w  D5,D3
02:00000440 E04B            	   151:     lsr.w   #8,D3                   ; F_num >> 8 = high 3 bits
02:00000442 8403            	   152:     or.b    D3,D2                   ; D2.b = (block<<3) | F_num_high
02:00000444 1605            	   153:     move.b  D5,D3                   ; D3.b = F_num_low
02:00000446 4E75            	   154:     rts
                            	   155: .clamp:
                            	   156:     ; Frequency too high for YM2612 — clamp to max
02:00000448 143C003F        	   157:     move.b  #$3F,D2                 ; block 7, F_num high = 7
02:0000044C 163C00FF        	   158:     move.b  #$FF,D3                 ; F_num low = $FF → F_num = 2047
02:00000450 4E75            	   159:     rts
                            	   160: .silence:
02:00000452 7400            	   161:     moveq   #0,D2
02:00000454 7600            	   162:     moveq   #0,D3
02:00000456 4E75            	   163:     rts
                            	   164: 
                            	   165: ;==============================================================================
                            	   166: ; load_fm_patch — Load a 25-byte FM patch into a YM2612 channel
                            	   167: ;
                            	   168: ; Input:  A0 = pointer to 25-byte patch data
                            	   169: ;         D6.b = channel (0, 1, or 2)
                            	   170: ; Output: none
                            	   171: ; Preserves: D0-D6, A0-A1 (saved/restored internally)
                            	   172: ;==============================================================================
                            	   173: load_fm_patch:
02:00000458 48E7E0C0        	   174:     movem.l D0-D2/A0-A1,-(SP)
02:0000045C 43FA0172        	   175:     lea     FM_PATCH_REGS(PC),A1
02:00000460 7418            	   176:     moveq   #24,D2                  ; 25 register/value pairs
                            	   177: .loop:
02:00000462 1019            	   178:     move.b  (A1)+,D0                ; register base address
02:00000464 D006            	   179:     add.b   D6,D0                   ; + channel offset (0/1/2)
02:00000466 1218            	   180:     move.b  (A0)+,D1                ; data value
02:00000468 6100FF66        	   181:     bsr     ym_write1
02:0000046C 51CAFFF4        	   182:     dbra    D2,.loop
02:00000470 4CDF0307        	   183:     movem.l (SP)+,D0-D2/A0-A1
02:00000474 4E75            	   184:     rts
                            	   185: 
                            	   186: ;==============================================================================
                            	   187: ; audio_init — Initialize YM2612 and PSG for NES audio emulation
                            	   188: ;
                            	   189: ; Called once during boot. Sets up FM patches and mutes all channels.
                            	   190: ; Preserves: A4, A5, D7 (NES register shadows)
                            	   191: ;==============================================================================
                            	   192: audio_init:
02:00000476 48E7FE80        	   193:     movem.l D0-D6/A0,-(SP)
                            	   194: 
                            	   195:     ;------------------------------------------------------------------
                            	   196:     ; Key-off all 6 YM2612 channels
                            	   197:     ;------------------------------------------------------------------
02:0000047A 103C0028        	   198:     move.b  #$28,D0                 ; Key on/off register
02:0000047E 7200            	   199:     moveq   #0,D1
02:00000480 6100FF4E        	   200:     bsr     ym_write1               ; ch 0 off
02:00000484 123C0001        	   201:     move.b  #$01,D1
02:00000488 6100FF46        	   202:     bsr     ym_write1               ; ch 1 off
02:0000048C 123C0002        	   203:     move.b  #$02,D1
02:00000490 6100FF3E        	   204:     bsr     ym_write1               ; ch 2 off
02:00000494 123C0004        	   205:     move.b  #$04,D1
02:00000498 6100FF36        	   206:     bsr     ym_write1               ; ch 4 off (Part II)
02:0000049C 123C0005        	   207:     move.b  #$05,D1
02:000004A0 6100FF2E        	   208:     bsr     ym_write1               ; ch 5 off
02:000004A4 123C0006        	   209:     move.b  #$06,D1
02:000004A8 6100FF26        	   210:     bsr     ym_write1               ; ch 6 off
                            	   211: 
                            	   212:     ;------------------------------------------------------------------
                            	   213:     ; DMC scaffold (Phase C): enable YM2612 DAC on ch 6 and unmute its
                            	   214:     ; pan register so PCM bytes streamed to reg $2A become audible.
                            	   215:     ;
                            	   216:     ; $2B bit 7 = DAC enable (replaces ch 6's FM synth path).  We also
                            	   217:     ; write a center value ($80) to $2A so the DAC sits at mid-scale
                            	   218:     ; until dmc_feed starts pushing real samples.  $B6 (Part II) is ch 6
                            	   219:     ; pan/AMS/PMS — $C0 enables both L+R outputs.
                            	   220:     ;------------------------------------------------------------------
02:000004AC 103C002B        	   221:     move.b  #$2B,D0                 ; DAC enable register
02:000004B0 123C0080        	   222:     move.b  #$80,D1                 ; bit 7 = DAC on
02:000004B4 6100FF1A        	   223:     bsr     ym_write1
02:000004B8 103C002A        	   224:     move.b  #$2A,D0                 ; DAC data
02:000004BC 123C0080        	   225:     move.b  #$80,D1                 ; center value = silence
02:000004C0 6100FF0E        	   226:     bsr     ym_write1
02:000004C4 103C00B6        	   227:     move.b  #$B6,D0                 ; ch 6 pan/AMS/PMS (Part II)
02:000004C8 123C00C0        	   228:     move.b  #$C0,D1                 ; L+R enabled
02:000004CC 6100FF26        	   229:     bsr     ym_write2
                            	   230: 
                            	   231:     ;------------------------------------------------------------------
                            	   232:     ; LFO off (register $22 = 0)
                            	   233:     ;------------------------------------------------------------------
02:000004D0 103C0022        	   234:     move.b  #$22,D0
02:000004D4 7200            	   235:     moveq   #0,D1
02:000004D6 6100FEF8        	   236:     bsr     ym_write1
                            	   237: 
                            	   238:     ;------------------------------------------------------------------
                            	   239:     ; Clear SSG-EG for every operator on ch 0, 1, 2 ($90-$9E on Part I).
                            	   240:     ;
                            	   241:     ; The YM2612 SSG-EG register per operator has no power-on guarantee
                            	   242:     ; on Genesis hardware and may hold leftover state across soft resets.
                            	   243:     ; If bit 3 (SSG enable) is set, the envelope generator runs in a
                            	   244:     ; sawtooth/square-like "SSG mode" that produces an audible buzz or
                            	   245:     ; hiss alongside the clean FM output — we were hearing that on ch 1
                            	   246:     ; (Voice $00 pad) and ch 2 (Voice $07 bass).
                            	   247:     ;
                            	   248:     ; Zero-ing $90+op+ch for all 4 operators on each used channel puts
                            	   249:     ; every envelope generator back in standard mode.  12 writes total.
                            	   250:     ;------------------------------------------------------------------
02:000004DA 7200            	   251:     moveq   #0,D1                   ; data = 0 for all
02:000004DC 103C0090        	   252:     move.b  #$90,D0                 ; slot1 ch0
02:000004E0 6100FEEE        	   253:     bsr     ym_write1
02:000004E4 103C0091        	   254:     move.b  #$91,D0                 ; slot1 ch1
02:000004E8 6100FEE6        	   255:     bsr     ym_write1
02:000004EC 103C0092        	   256:     move.b  #$92,D0                 ; slot1 ch2
02:000004F0 6100FEDE        	   257:     bsr     ym_write1
02:000004F4 103C0094        	   258:     move.b  #$94,D0                 ; slot3 ch0
02:000004F8 6100FED6        	   259:     bsr     ym_write1
02:000004FC 103C0095        	   260:     move.b  #$95,D0                 ; slot3 ch1
02:00000500 6100FECE        	   261:     bsr     ym_write1
02:00000504 103C0096        	   262:     move.b  #$96,D0                 ; slot3 ch2
02:00000508 6100FEC6        	   263:     bsr     ym_write1
02:0000050C 103C0098        	   264:     move.b  #$98,D0                 ; slot2 ch0
02:00000510 6100FEBE        	   265:     bsr     ym_write1
02:00000514 103C0099        	   266:     move.b  #$99,D0                 ; slot2 ch1
02:00000518 6100FEB6        	   267:     bsr     ym_write1
02:0000051C 103C009A        	   268:     move.b  #$9A,D0                 ; slot2 ch2
02:00000520 6100FEAE        	   269:     bsr     ym_write1
02:00000524 103C009C        	   270:     move.b  #$9C,D0                 ; slot4 ch0
02:00000528 6100FEA6        	   271:     bsr     ym_write1
02:0000052C 103C009D        	   272:     move.b  #$9D,D0                 ; slot4 ch1
02:00000530 6100FE9E        	   273:     bsr     ym_write1
02:00000534 103C009E        	   274:     move.b  #$9E,D0                 ; slot4 ch2
02:00000538 6100FE96        	   275:     bsr     ym_write1
                            	   276: 
                            	   277:     ;------------------------------------------------------------------
                            	   278:     ; Load EHZ Voice $03 into ch 0 (m_sq1 = NES Sq1 = Pulse 2 = LEAD melody)
                            	   279:     ; NES naming: Sq1/Sq0 are reversed from intuition — Sq1 writes $4006/$4007
                            	   280:     ; (Pulse 2) and owns the primary melody.  Put the snappy EHZ lead here.
                            	   281:     ;------------------------------------------------------------------
02:0000053C 41FA00C6        	   282:     lea     PATCH_VOICE03(PC),A0
02:00000540 7C00            	   283:     moveq   #0,D6                   ; channel 0 (emit_note_sq1 target)
02:00000542 6100FF14        	   284:     bsr     load_fm_patch
                            	   285: 
                            	   286:     ;------------------------------------------------------------------
                            	   287:     ; Load EHZ Voice $00 into ch 1 (m_sq0 = NES Sq0 = Pulse 1 = harmony/arp)
                            	   288:     ; The slow-decay pad fits arpeggiated harmony better than a sharp lead.
                            	   289:     ;------------------------------------------------------------------
02:00000546 41FA00A2        	   290:     lea     PATCH_VOICE00(PC),A0
02:0000054A 7C01            	   291:     moveq   #1,D6                   ; channel 1 (emit_note_sq0 target)
02:0000054C 6100FF0A        	   292:     bsr     load_fm_patch
                            	   293: 
                            	   294:     ;------------------------------------------------------------------
                            	   295:     ; Load EHZ Voice $07 into ch 2 (Triangle — Algorithm 0, bass)
                            	   296:     ;------------------------------------------------------------------
02:00000550 41FA00CC        	   297:     lea     PATCH_VOICE07(PC),A0
02:00000554 7C02            	   298:     moveq   #2,D6                   ; channel 2
02:00000556 6100FF00        	   299:     bsr     load_fm_patch
                            	   300: 
                            	   301:     ;------------------------------------------------------------------
                            	   302:     ; Set panning: both speakers for ch 0–2
                            	   303:     ; Register $B4+ch, data $C0 = L+R output
                            	   304:     ;------------------------------------------------------------------
02:0000055A 103C00B4        	   305:     move.b  #$B4,D0
02:0000055E 123C00C0        	   306:     move.b  #$C0,D1
02:00000562 6100FE6C        	   307:     bsr     ym_write1               ; ch 0 panning
02:00000566 103C00B5        	   308:     move.b  #$B5,D0
02:0000056A 6100FE64        	   309:     bsr     ym_write1               ; ch 1 panning
02:0000056E 103C00B6        	   310:     move.b  #$B6,D0
02:00000572 6100FE5C        	   311:     bsr     ym_write1               ; ch 2 panning
                            	   312: 
                            	   313:     ;------------------------------------------------------------------
                            	   314:     ; (Phase E polish: the Phase-C FM isolation mute that forced every
                            	   315:     ; operator TL to $7F has been removed — FM music plays again alongside
                            	   316:     ; the DMC DAC stream now that HBlank-driven non-blocking playback is
                            	   317:     ; in place.  Patches loaded by load_fm_patch above already set the
                            	   318:     ; authoritative TL bytes for each voice.)
                            	   319:     ;------------------------------------------------------------------
                            	   320: 
                            	   321:     ;------------------------------------------------------------------
                            	   322:     ; Mute all 4 PSG channels (attenuation = $F = maximum)
                            	   323:     ;------------------------------------------------------------------
02:00000576 13FC009F00C00011	   324:     move.b  #$9F,(PSG_PORT).l       ; Tone 1 mute
02:0000057E 13FC00BF00C00011	   325:     move.b  #$BF,(PSG_PORT).l       ; Tone 2 mute
02:00000586 13FC00DF00C00011	   326:     move.b  #$DF,(PSG_PORT).l       ; Tone 3 mute
02:0000058E 13FC00FF00C00011	   327:     move.b  #$FF,(PSG_PORT).l       ; Noise mute
                            	   328: 
                            	   329:     ;------------------------------------------------------------------
                            	   330:     ; Clear shadow APU registers
                            	   331:     ;------------------------------------------------------------------
02:00000596 41F900FF0A00    	   332:     lea     (APU_SH_BASE).l,A0
02:0000059C 7008            	   333:     moveq   #($11/2),D0            ; 18 bytes / 2 = 9 words (round up)
                            	   334: .clr:
02:0000059E 4258            	   335:     clr.w   (A0)+
02:000005A0 51C8FFFC        	   336:     dbra    D0,.clr
                            	   337: 
                            	   338:     ;------------------------------------------------------------------
                            	   339:     ; Clear native music player state
                            	   340:     ;------------------------------------------------------------------
02:000005A4 41F900FFE000    	   341:     lea     (MUSIC_BASE).l,A0
02:000005AA 700F            	   342:     moveq   #(MUSIC_STATE_SIZE/4)-1,D0
                            	   343: .clr_music:
02:000005AC 4298            	   344:     clr.l   (A0)+
02:000005AE 51C8FFFC        	   345:     dbra    D0,.clr_music
                            	   346: 
                            	   347:     ;------------------------------------------------------------------
                            	   348:     ; Clear DMC state block ($FFE100, 17 bytes — rounded to 20).  Zero
                            	   349:     ; dmc_active, dmc_burst, dmc_ptr, dmc_remain, shadow registers, and
                            	   350:     ; debug scaffold state.
                            	   351:     ;------------------------------------------------------------------
02:000005B2 41F900FFE100    	   352:     lea     (DMC_BASE).l,A0
02:000005B8 4298            	   353:     clr.l   (A0)+                   ; active + burst
02:000005BA 4298            	   354:     clr.l   (A0)+                   ; dmc_ptr
02:000005BC 4298            	   355:     clr.l   (A0)+                   ; dmc_remain
02:000005BE 4298            	   356:     clr.l   (A0)+                   ; rate/addr/len sel + prev_btn
02:000005C0 4298            	   357:     clr.l   (A0)+                   ; dbg_next + pad (over-clear, safe)
                            	   358:     ;------------------------------------------------------------------
                            	   359:     ; Scaffold: preload dmc_dbg_next = 1 so the first Start press fires
                            	   360:     ; sample #1.  dmc_trigger wraps 1..7 from there.
                            	   361:     ;------------------------------------------------------------------
02:000005C2 13FC000100FFE110	   362:     move.b  #1,(dmc_dbg_next).l
                            	   363: 
02:000005CA 4CDF017F        	   364:     movem.l (SP)+,D0-D6/A0
02:000005CE 4E75            	   365:     rts
                            	   366: 
                            	   367: ;==============================================================================
                            	   368: ; FM Patch Register Address Table
                            	   369: ;
                            	   370: ; 25 register base addresses (add channel 0/1/2 for target channel).
                            	   371: ; Order matches the 25 data bytes in each PATCH_VOICExx block.
                            	   372: ;==============================================================================
                            	   373:     even
                            	   374: FM_PATCH_REGS:
02:000005D0 B0              	   375:     dc.b    $B0                     ; FB/ALG
02:000005D1 30              	   376:     dc.b    $30,$34,$38,$3C         ; DT1/MUL (slot1,slot3,slot2,slot4)
02:000005D2 34
02:000005D3 38
02:000005D4 3C
02:000005D5 50              	   377:     dc.b    $50,$54,$58,$5C         ; RS/AR
02:000005D6 54
02:000005D7 58
02:000005D8 5C
02:000005D9 60              	   378:     dc.b    $60,$64,$68,$6C         ; AM/D1R
02:000005DA 64
02:000005DB 68
02:000005DC 6C
02:000005DD 70              	   379:     dc.b    $70,$74,$78,$7C         ; D2R
02:000005DE 74
02:000005DF 78
02:000005E0 7C
02:000005E1 80              	   380:     dc.b    $80,$84,$88,$8C         ; DL/RR
02:000005E2 84
02:000005E3 88
02:000005E4 8C
02:000005E5 40              	   381:     dc.b    $40,$44,$48,$4C         ; TL
02:000005E6 44
02:000005E7 48
02:000005E8 4C
                            	   382:     even
                            	   383: 
                            	   384: ;==============================================================================
                            	   385: ; FM Patch Data — Sonic 2 Emerald Hill Zone voices
                            	   386: ;
                            	   387: ; 25 bytes each.  Canonical Sonic 2 voice format from sonicretro/s2disasm
                            	   388: ; sound/music/82 - EHZ.asm (label EHZ_Voices):
                            	   389: ;
                            	   390: ;   byte 0      : FB/ALG (feedback<<3 | algorithm)
                            	   391: ;   bytes 1-4   : DT/MUL  — operators in slot order: op1, op3, op2, op4
                            	   392: ;   bytes 5-8   : RS/AR    "
                            	   393: ;   bytes 9-12  : AM/D1R   "
                            	   394: ;   bytes 13-16 : D2R      "
                            	   395: ;   bytes 17-20 : DL/RR    "
                            	   396: ;   bytes 21-24 : TL       "
                            	   397: ;
                            	   398: ; The slot order op1,op3,op2,op4 matches YM2612 register offsets 0,4,8,C in
                            	   399: ; FM_PATCH_REGS, so the bytes stream directly to the right operator slots
                            	   400: ; without any reordering in load_fm_patch.
                            	   401: ;
                            	   402: ; NOTE: the original SMPS driver uses bit 7 ($80) on TL bytes as an "absolute,
                            	   403: ; do not add channel volume" flag — it masks bit 7 before writing and channel
                            	   404: ; volume is added for operators without the flag.  We have no per-channel
                            	   405: ; volume, so we translate $80 directly to a safe carrier TL of $18 (matching
                            	   406: ; Voice $03's proven-clean carrier level) and keep the authoritative
                            	   407: ; modulator TL bytes as-is.
                            	   408: ;
                            	   409: ; ym_trace.lua (2026-04-10) proved the driver was writing these bytes
                            	   410: ; verbatim to the YM2612.  A prior transcription of Voice $00 and Voice $07
                            	   411: ; had the middle two bytes of DT/MUL, RS/AR, AM/D1R, and TL swapped — putting
                            	   412: ; op2's parameters onto op3 and vice versa.  On Voice $03 the middle values
                            	   413: ; are near-symmetric so the swap is inaudible; on Voices $00 and $07 the
                            	   414: ; middle values differ enough that the swap produced cross-wired FM
                            	   415: ; modulation = sustained "crunchy buzz" on both channels.  Restored to the
                            	   416: ; authoritative byte order here.
                            	   417: ;==============================================================================
                            	   418: 
                            	   419: ; Voice $00 — Bell-like pad.
                            	   420: ;
                            	   421: ; Classic FM bell recipe:
                            	   422: ;   Alg 5 (3 carriers modulated by op1)
                            	   423: ;   FB 5 for brightness without the FB 7 "hard bite"
                            	   424: ;   Op1 MUL 4 → produces inharmonic overtones at 4x the carrier pitch,
                            	   425: ;     which is what gives bells their characteristic "chime" quality
                            	   426: ;   Op1 TL $14 → modulator loud enough to shape the bell spectrum
                            	   427: ;   Carriers at MUL 1, tuned unison (no detune beating)
                            	   428: ;   Fast attack, medium D1R, low DL, slow RR = bell strike + sustain tail
                            	   429: PATCH_VOICE00:
02:000005EA 2D              	   430:     dc.b    $2D                     ; FB/ALG: (5<<3)|5 — FB 5 bell pad
02:000005EB 04              	   431:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:000005EC 01
02:000005ED 01
02:000005EE 01
02:000005EF 1F              	   432:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:000005F0 1F
02:000005F1 1F
02:000005F2 1F
02:000005F3 08              	   433:     dc.b    $08,$04,$04,$04         ; AM/D1R — bell-decay shape
02:000005F4 04
02:000005F5 04
02:000005F6 04
02:000005F7 00              	   434:     dc.b    $00,$00,$00,$00         ; D2R
02:000005F8 00
02:000005F9 00
02:000005FA 00
02:000005FB 47              	   435:     dc.b    $47,$37,$37,$17         ; DL 4/3 + RR 7/7/7/7 — bell tail
02:000005FC 37
02:000005FD 37
02:000005FE 17
02:000005FF 14              	   436:     dc.b    $14,$1E,$1E,$1E         ; TL — op1 mod loud ($14), carriers quieter ($1E)
02:00000600 1E
02:00000601 1E
02:00000602 1E
                            	   437:     even
                            	   438: 
                            	   439: ; Voice $03 — EHZ FM3 opening voice (iconic lead)
                            	   440: ; Algorithm 5 (slots 2,3,4 are carriers), Feedback 7
                            	   441: PATCH_VOICE03:
02:00000604 3D              	   442:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:00000605 01              	   443:     dc.b    $01,$51,$21,$01         ; DT/MUL
02:00000606 51
02:00000607 21
02:00000608 01
02:00000609 1F              	   444:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR (max — EHZ's slow-attack swell was delaying Zelda's Pulse 2 melody)
02:0000060A 1F
02:0000060B 1F
02:0000060C 1F
02:0000060D 0A              	   445:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:0000060E 05
02:0000060F 05
02:00000610 05
02:00000611 00              	   446:     dc.b    $00,$00,$00,$00         ; D2R
02:00000612 00
02:00000613 00
02:00000614 00
02:00000615 2B              	   447:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
02:00000616 2B
02:00000617 2B
02:00000618 1B
02:00000619 19              	   448:     dc.b    $19,$18,$18,$18         ; TL (slot1=modulator $19; slots 2/3/4 carriers +$18 for mix)
02:0000061A 18
02:0000061B 18
02:0000061C 18
                            	   449:     even
                            	   450: 
                            	   451: ; Voice $07 — Clean bass.
                            	   452: ;
                            	   453: ; Pure sine-ish bass: Alg 5, low FB, all operators at MUL 1 with no detune.
                            	   454: ; This is the cleanest possible FM bass — no harmonics beyond what the fun-
                            	   455: ; damental already provides.  Moderately quiet so it supports the lead
                            	   456: ; without fighting it.
                            	   457: PATCH_VOICE07:
02:0000061E 0D              	   458:     dc.b    $0D                     ; FB/ALG: (1<<3)|5 — FB 1 (minimal grit)
02:0000061F 01              	   459:     dc.b    $01,$01,$01,$01         ; DT/MUL — unison, no beating
02:00000620 01
02:00000621 01
02:00000622 01
02:00000623 1F              	   460:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
02:00000624 1F
02:00000625 1F
02:00000626 1F
02:00000627 0A              	   461:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:00000628 05
02:00000629 05
02:0000062A 05
02:0000062B 00              	   462:     dc.b    $00,$00,$00,$00         ; D2R
02:0000062C 00
02:0000062D 00
02:0000062E 00
02:0000062F 28              	   463:     dc.b    $28,$28,$28,$18         ; DL 2 / RR 8 — bass punch
02:00000630 28
02:00000631 28
02:00000632 18
02:00000633 22              	   464:     dc.b    $22,$20,$20,$20         ; TL — moderately quiet (less than 27.81's $28)
02:00000634 20
02:00000635 20
02:00000636 20
                            	   465:     even
                            	   466: 
                            	   467: ;==============================================================================
                            	   468: ;==============================================================================
                            	   469: ; NATIVE M68K MUSIC PLAYER
                            	   470: ;
                            	   471: ; Ports the NES Zelda DriveSong engine verbatim, reading the same script
                            	   472: ; opcodes but emitting YM2612/PSG writes instead of NES APU writes.
                            	   473: ;
                            	   474: ; State lives at $FF0B00.  Song data is pulled from the contiguous
                            	   475: ; MusicBlob (SongTable + 9 song headers + 9 song scripts, 2757 bytes)
                            	   476: ; loaded at label MusicBlob.  NES CPU addresses in song headers are
                            	   477: ; converted to M68K pointers via (nes_addr - MUSIC_BLOB_NES_BASE) + MusicBlob.
                            	   478: ;==============================================================================
                            	   479: ;==============================================================================
                            	   480: 
                            	   481: ;----------------------------------------------------------------------
                            	   482: ; Music state RAM ($FF0B00-$FF0B3F, 64 bytes)
                            	   483: ;----------------------------------------------------------------------
                            	   484: ; ============================================================================
                            	   485: ; MUSIC_BASE must be OUTSIDE the NES RAM mirror range.
                            	   486: ; Real NES mirrors its 2 KB RAM through $0000-$1FFF, so any transpiled access
                            	   487: ; through a pointer in zero-page that lands in $0800-$1FFF on 6502 will on our
                            	   488: ; M68K map hit $FF0800-$FF1FFF directly (transpiler does not wrap mirrors).
                            	   489: ; $FF0B00 got continuously clobbered by such accesses during the intro.
                            	   490: ; $FFE000 is safely past $FF1FFF and well below the stack at $FFFFFE.
                            	   491: ; ============================================================================
                            	   492: MUSIC_BASE          equ $FFE000
                            	   493: MUSIC_STATE_SIZE    equ $40
                            	   494: 
                            	   495: m_song              equ MUSIC_BASE+$00  ; current song bitmap
                            	   496: m_song_req          equ MUSIC_BASE+$01  ; requested song change
                            	   497: m_phrase            equ MUSIC_BASE+$02  ; current phrase index
                            	   498: m_len_base          equ MUSIC_BASE+$03  ; note length table base
                            	   499: m_env_sel           equ MUSIC_BASE+$04  ; envelope selector
                            	   500: m_mystery           equ MUSIC_BASE+$05  ; header byte 7 ($05F1 equiv)
                            	   501: m_noise_first       equ MUSIC_BASE+$06  ; noise loop start
                            	   502: m_script_ptr        equ MUSIC_BASE+$08  ; long: M68K pointer to script base
                            	   503: 
                            	   504: ; Sq1 (Pulse 1 → YM ch 0)
                            	   505: m_sq1_off           equ MUSIC_BASE+$0C
                            	   506: m_sq1_cnt           equ MUSIC_BASE+$0D
                            	   507: m_sq1_len           equ MUSIC_BASE+$0E
                            	   508: m_sq1_vib           equ MUSIC_BASE+$0F
                            	   509: m_sq1_per           equ MUSIC_BASE+$10
                            	   510: 
                            	   511: ; Sq0 (Pulse 2 → YM ch 1)
                            	   512: m_sq0_off           equ MUSIC_BASE+$14
                            	   513: m_sq0_cnt           equ MUSIC_BASE+$15
                            	   514: m_sq0_len           equ MUSIC_BASE+$16
                            	   515: m_sq0_vib           equ MUSIC_BASE+$17
                            	   516: m_sq0_per           equ MUSIC_BASE+$18
                            	   517: 
                            	   518: ; Triangle (→ YM ch 2)
                            	   519: m_trg_off           equ MUSIC_BASE+$1C
                            	   520: m_trg_cnt           equ MUSIC_BASE+$1D
                            	   521: m_trg_len           equ MUSIC_BASE+$1E
                            	   522: m_trg_vib           equ MUSIC_BASE+$1F
                            	   523: m_trg_per           equ MUSIC_BASE+$20
                            	   524: m_trg_rep_n         equ MUSIC_BASE+$21
                            	   525: m_trg_rep_s         equ MUSIC_BASE+$22
                            	   526: 
                            	   527: ; Noise (→ PSG ch 3)
                            	   528: m_noise_off         equ MUSIC_BASE+$24
                            	   529: m_noise_cnt         equ MUSIC_BASE+$25
                            	   530: ; Software ADSR state for the PSG noise drum channel (Kroc Sonic 1 SMS pattern).
                            	   531: ; SN76489 has no envelope hardware, so we run a linear software envelope and
                            	   532: ; map it to the 4-bit PSG attenuation every frame.  Writing the noise control
                            	   533: ; register resets the LFSR, so we also cache the last-written control byte and
                            	   534: ; skip redundant writes to preserve the decay tail.
                            	   535: m_noise_level       equ MUSIC_BASE+$26  ; byte: current envelope level ($00-$FF)
                            	   536: m_noise_decay       equ MUSIC_BASE+$27  ; byte: current linear decay rate (per tick)
                            	   537: m_last_psg_nc       equ MUSIC_BASE+$28  ; byte: last noise-control byte written
                            	   538: 
                            	   539: ; Noise-SFX shadow state. Zelda's PlaySfxNote writes $400E/$400C/$400F
                            	   540: ; per sfx-tick. The first two cache here; $400F is the per-hit trigger.
                            	   541: m_sfx_vol           equ MUSIC_BASE+$29  ; byte: last $400C byte
                            	   542: m_sfx_ctrl_raw      equ MUSIC_BASE+$2A  ; byte: last $400E byte
                            	   543: ; Set to 1 by tick_sq1.song_ended each time the song script reaches its
                            	   544: ; loop point (opcode $00). C-side intro_story polls this to sync the
                            	   545: ; final-hold-then-loop-back-to-title transition with the music loop.
                            	   546: ; Owner clears it; ASM only ever writes 1.
                            	   547: m_song_loop_pending equ MUSIC_BASE+$2B  ; byte: 1 = song just looped
                            	   548: 
                            	   549: ;----------------------------------------------------------------------
                            	   550: ; DMC → YM2612 DAC state (Phase A of DMC port — see
                            	   551: ; C:\Users\Jake Diggity\.claude\plans\quirky-baking-goose.md).
                            	   552: ;
                            	   553: ; Lives at $FFE100, clear of the music-state block at $FFE000-$FFE03F.
                            	   554: ; Written by the DMC APU stubs in nes_io.asm, consumed by dmc_feed which
                            	   555: ; runs at the tail of music_tick and bursts PCM bytes to YM reg $2A.
                            	   556: ;----------------------------------------------------------------------
                            	   557: DMC_BASE            equ $FFE100
                            	   558: dmc_active          equ DMC_BASE+$00    ; byte: 0 = idle, 1 = playing
                            	   559: dmc_last_idx        equ DMC_BASE+$01    ; byte: last triggered sample index (for HUD)
                            	   560: dmc_ptr             equ DMC_BASE+$04    ; long: current M68K pointer into PCM blob
                            	   561: dmc_remain          equ DMC_BASE+$08    ; long: PCM bytes left in current sample
                            	   562: dmc_rate_sel        equ DMC_BASE+$0C    ; byte: shadow of last $4010 write
                            	   563: dmc_addr_sel        equ DMC_BASE+$0D    ; byte: shadow of last $4012 write
                            	   564: dmc_len_sel         equ DMC_BASE+$0E    ; byte: shadow of last $4013 write
                            	   565: dmc_dbg_prev_btn    equ DMC_BASE+$0F    ; byte: pad state from last frame (edge det)
                            	   566: dmc_dbg_next        equ DMC_BASE+$10    ; byte: next sample index (1..7) to trigger
                            	   567: 
                            	   568: ;==============================================================================
                            	   569: ; dmc_trigger — non-blocking HBlank DAC streamer.
                            	   570: ;
                            	   571: ; Samples are pre-processed by tools/extract_dmc_samples.py: proper bandlimited
                            	   572: ; resampling (scipy.signal.resample_poly with Kaiser-window FIR) from native
                            	   573: ; NES rate (21/25/33 kHz) down to the empirically-measured Genesis HINT rate
                            	   574: ; (~8751 Hz with music active). That's where the "crunchy" sound came from
                            	   575: ; before — linear interpolation without anti-alias filter caused aliasing.
                            	   576: ; With proper prefiltered resampling, playback sounds clean even at the lower
                            	   577: ; effective rate, and the game does NOT hitch.
                            	   578: ;==============================================================================
                            	   579: dmc_trigger:
02:00000638 4A00            	   580:     tst.b   D0
02:0000063A 6762            	   581:     beq.s   .bad
02:0000063C B03C0007        	   582:     cmp.b   #DMC_SAMPLE_COUNT,D0
02:00000640 625C            	   583:     bhi.s   .bad
02:00000642 48E7E0C0        	   584:     movem.l D0-D2/A0-A1,-(SP)
02:00000646 13C000FFE101    	   585:     move.b  D0,(dmc_last_idx).l
02:0000064C 7200            	   586:     moveq   #0,D1
02:0000064E 1200            	   587:     move.b  D0,D1                   ; D1.l = 1-based index
02:00000650 5381            	   588:     subq.l  #1,D1                   ; 0-based
02:00000652 D281            	   589:     add.l   D1,D1                   ; idx * 2
02:00000654 D281            	   590:     add.l   D1,D1                   ; idx * 4
                            	   591: 
02:00000656 41F90000195C    	   592:     lea     (DMC_SAMPLE_PCM_OFFS).l,A0
02:0000065C 24301800        	   593:     move.l  (A0,D1.l),D2
02:00000660 43F9000052CC    	   594:     lea     (DMC_SAMPLE_PCM_BLOB).l,A1
02:00000666 D3C2            	   595:     add.l   D2,A1
                            	   596: 
02:00000668 41F900001978    	   597:     lea     (DMC_SAMPLE_PCM_LENS).l,A0
02:0000066E 24301800        	   598:     move.l  (A0,D1.l),D2
02:00000672 4A82            	   599:     tst.l   D2
02:00000674 6724            	   600:     beq.s   .bad_restore
                            	   601: 
02:00000676 23C900FFE104    	   602:     move.l  A1,(dmc_ptr).l
02:0000067C 23C200FFE108    	   603:     move.l  D2,(dmc_remain).l
02:00000682 13FC000100FFE100	   604:     move.b  #1,(dmc_active).l
                            	   605: 
                            	   606:     ; Arm HBlank every line, enable HINT (preserve colorfix bit).
02:0000068A 33FC8A0000C00004	   607:     move.w  #$8A00,(VDP_CTRL).l     ; Reg 10 = 0 -> fire every line
02:00000692 33FC801400C00004	   608:     move.w  #$8014,(VDP_CTRL).l     ; Reg  0 = $14 -> HINT on + colorfix
                            	   609: .bad_restore:
02:0000069A 4CDF0307        	   610:     movem.l (SP)+,D0-D2/A0-A1
                            	   611: .bad:
02:0000069E 4E75            	   612:     rts
                            	   613: 
                            	   614: ;==============================================================================
                            	   615: ; dmc_hint_tick — per-HBlank PCM byte -> YM2612 reg $2A DAC write.
                            	   616: ;==============================================================================
                            	   617: dmc_hint_tick:
02:000006A0 207900FFE104    	   618:     move.l  (dmc_ptr).l,A0
02:000006A6 1018            	   619:     move.b  (A0)+,D0
02:000006A8 23C800FFE104    	   620:     move.l  A0,(dmc_ptr).l
02:000006AE 41F900A04000    	   621:     lea     (YM_ADDR1).l,A0
                            	   622: .wait:
02:000006B4 4A10            	   623:     tst.b   (A0)
02:000006B6 6BFC            	   624:     bmi.s   .wait
02:000006B8 10BC002A        	   625:     move.b  #$2A,(A0)
02:000006BC 13C000A04001    	   626:     move.b  D0,(YM_DATA1).l
02:000006C2 53B900FFE108    	   627:     subq.l  #1,(dmc_remain).l
02:000006C8 6702            	   628:     beq.s   .end
02:000006CA 4E75            	   629:     rts
                            	   630: .end:
02:000006CC 41F900A04000    	   631:     lea     (YM_ADDR1).l,A0
                            	   632: .wait2:
02:000006D2 4A10            	   633:     tst.b   (A0)
02:000006D4 6BFC            	   634:     bmi.s   .wait2
02:000006D6 10BC002A        	   635:     move.b  #$2A,(A0)
02:000006DA 13FC008000A04001	   636:     move.b  #$80,(YM_DATA1).l       ; park DAC at mid-rail
02:000006E2 423900FFE100    	   637:     clr.b   (dmc_active).l
02:000006E8 33FC800400C00004	   638:     move.w  #$8004,(VDP_CTRL).l     ; Reg 0 = $04 -> HINT off, colorfix on
02:000006F0 4E75            	   639:     rts
                            	   640: 
                            	   641: ;==============================================================================
                            	   642: ; dmc_feed — legacy VBlank entry point, retained as labeled rts.
                            	   643: ;
                            	   644: ; music_tick used to call this to drain a frame's worth of PCM in VBlank.
                            	   645: ; All streaming now happens from HBlank via dmc_hint_tick.  Kept as a cheap
                            	   646: ; rts so we don't have to surgically delete the call from music_tick.
                            	   647: ;==============================================================================
                            	   648: dmc_feed:
02:000006F2 4E75            	   649:     rts
                            	   650: 
                            	   651: ;==============================================================================
                            	   652: ; dmc_dbg_poll - Phase-C/D scaffold (REMOVED in Phase E).
                            	   653: ;
                            	   654: ; Previously watched the NES-format controller latch for a Start rising edge
                            	   655: ; and cycled through the 7 DMC samples.  That scaffold served its purpose at
                            	   656: ; T27/T28 PASS — DMC triggering is now fully driven by the game's own APU
                            	   657: ; $4015 writes via the _apu_write_4015 stub in nes_io.asm (Phase D), and
                            	   658: ; Start has a real game function (exit attract mode).  Polling it here would
                            	   659: ; fire a stray DMC burst every time the player presses Start on the title
                            	   660: ; screen, masking real game audio events.
                            	   661: ;
                            	   662: ; The label is kept as a labeled rts for backward-compat with the call in
                            	   663: ; music_tick, which we'll peel out in a later cleanup pass.
                            	   664: ;==============================================================================
                            	   665: dmc_dbg_poll:
02:000006F4 4E75            	   666:     rts
                            	   667: 
                            	   668: ;==============================================================================
                            	   669: ; music_play — request a song change
                            	   670: ; Input: D0.b = song bitmap
                            	   671: ;==============================================================================
                            	   672:     xdef    music_play
                            	   673: music_play:
02:000006F6 13C000FFE001    	   674:     move.b  D0,(m_song_req).l
02:000006FC 4E75            	   675:     rts
                            	   676: 
                            	   677: ;==============================================================================
                            	   678: ; music_tick — DriveSong equivalent.  Call once per VBlank.
                            	   679: ;==============================================================================
                            	   680: music_tick:
02:000006FE 48E7FFE0        	   681:     movem.l D0-D7/A0-A2,-(SP)
                            	   682:     ;------------------------------------------------------------------
                            	   683:     ; Phase E polish: FM music path restored.  DMC streams independently
                            	   684:     ; from HBlank via dmc_hint_tick, so the main-thread music tick no
                            	   685:     ; longer needs to stay muted.  ym_write1/2 carry SR lockout so the
                            	   686:     ; HINT-driven DAC streamer can't corrupt the YM2612 latch between
                            	   687:     ; address and data bytes.
                            	   688:     ;
                            	   689:     ; Structure matches the pre-isolation (Zelda27.82) tick: consume
                            	   690:     ; song_req via change_song, otherwise tick_sq1 if a song is playing.
                            	   691:     ; dmc_dbg_poll + dmc_feed run after either path.  dmc_feed is now a
                            	   692:     ; labeled rts — the call costs ~20 cycles total and lets us defer
                            	   693:     ; removing it to a later cleanup pass.
                            	   694:     ;------------------------------------------------------------------
                            	   695:     ; Attract-mode-exit hook: the game's DriveAudio is NOP'd, so the
                            	   696:     ; audio driver's own SilenceSong paths (via DriveTune0 → $0604 bit7
                            	   697:     ; and DriveTune1 → $0602 bit7) never run.  Game logic still writes
                            	   698:     ; the request bytes at state transitions.  The attract-to-file-menu
                            	   699:     ; path (UpdateMode0Demo_Sub0 → SilenceAllSound in z_01.asm:4118)
                            	   700:     ; sets $0604 = $80 and $0603 = $80.  Poll both $0604 and $0602 for
                            	   701:     ; the silence-request bit 7 and route it into native music_silence.
                            	   702:     ; Also clear $0605/$0607 (current-tune shadows) so the game's own
                            	   703:     ; "nothing playing" markers stay coherent with our silenced state.
                            	   704:     ; SongRequest bridge: game writes D0 -> $FF0600 (NES RAM SongRequest) at
                            	   705:     ; every song change (title/gameplay/dungeon/etc.). Forward to m_song_req
                            	   706:     ; and clear the game-side byte so the game's own driver-absent check
                            	   707:     ; ("did my song change get consumed?") stays coherent.
02:00000702 103900FF0600    	   708:     move.b  ($FF0600).l,D0
02:00000708 670C            	   709:     beq.s   .no_song_req_bridge
02:0000070A 423900FF0600    	   710:     clr.b   ($FF0600).l
02:00000710 13C000FFE001    	   711:     move.b  D0,(m_song_req).l
                            	   712: .no_song_req_bridge:
02:00000716 103900FF0604    	   713:     move.b  ($FF0604).l,D0          ; Tune 0 request (SilenceAllSound)
02:0000071C 6B08            	   714:     bmi.s   .do_silence
02:0000071E 103900FF0602    	   715:     move.b  ($FF0602).l,D0          ; Tune 1 request (silence-then-play)
02:00000724 6A24            	   716:     bpl.s   .no_silence_req
                            	   717: .do_silence:
02:00000726 423900FF0602    	   718:     clr.b   ($FF0602).l
02:0000072C 423900FF0603    	   719:     clr.b   ($FF0603).l
02:00000732 423900FF0604    	   720:     clr.b   ($FF0604).l
02:00000738 423900FF0605    	   721:     clr.b   ($FF0605).l
02:0000073E 423900FF0607    	   722:     clr.b   ($FF0607).l
02:00000744 6100067E        	   723:     bsr     music_silence
02:00000748 6024            	   724:     bra.s   .dmc_poll
                            	   725: .no_silence_req:
02:0000074A 103900FFE001    	   726:     move.b  (m_song_req).l,D0
02:00000750 6710            	   727:     beq.s   .no_req
02:00000752 423900FFE001    	   728:     clr.b   (m_song_req).l
02:00000758 13C000FFE000    	   729:     move.b  D0,(m_song).l
02:0000075E 6118            	   730:     bsr     change_song
02:00000760 600C            	   731:     bra.s   .dmc_poll
                            	   732: .no_req:
02:00000762 4A3900FFE000    	   733:     tst.b   (m_song).l
02:00000768 6704            	   734:     beq.s   .dmc_poll
02:0000076A 610001B4        	   735:     bsr     tick_sq1
                            	   736: .dmc_poll:
02:0000076E 6184            	   737:     bsr     dmc_dbg_poll            ; scaffold: Start cycles DMC samples
02:00000770 6180            	   738:     bsr     dmc_feed                ; no-op stub (backward-compat call)
                            	   739:     ; DMC and noise-SFX dispatch paused -- neither produced acceptable
                            	   740:     ; audio yet. Revisit in a future pass. Music + SongRequest bridge
                            	   741:     ; stay wired.
02:00000772 4CDF07FF        	   742:     movem.l (SP)+,D0-D7/A0-A2
02:00000776 4E75            	   743:     rts
