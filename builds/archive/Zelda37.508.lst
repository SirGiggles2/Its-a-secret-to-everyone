02:0004179E 10303000        	  8504:     move.b  (A0,D3.W),D0
02:000417A2 41F9000416D8    	  8505:     lea     (MapRowMasks).l,A0
02:000417A8 12302000        	  8506:     move.b  (A0,D2.W),D1
