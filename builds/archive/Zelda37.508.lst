                            	   746: 
                            	   747: ;==============================================================================
                            	   748: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   749: ;
                            	   750: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   751: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   752: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   753: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   754: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   755: ;
                            	   756: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   757: ;
                            	   758: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   759: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   760: ;==============================================================================
                            	   761:     ifne DEBUG_TELEPORT
                            	   762: _debug_teleport_check:
                            	   763:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   764:     tst.b   ($0010,A4)
                            	   765:     bne     .dtc_no
                            	   766:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   767:     cmpi.b  #$05,($0012,A4)
                            	   768:     bne     .dtc_no
                            	   769:     tst.b   ($0013,A4)
                            	   770:     bne     .dtc_no
                            	   771:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   772:     ;
                            	   773:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   774:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   775:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   776:     ; So the bit map is:
                            	   777:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   778:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   779:     move.b  ($00F8,A4),D1
                            	   780:     andi.b  #$0F,D1
                            	   781:     beq     .dtc_no
                            	   782:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   783:     moveq   #0,D0
                            	   784:     btst    #3,D1                   ; Up
                            	   785:     bne.s   .dtc_dir_set
                            	   786:     moveq   #1,D0
                            	   787:     btst    #2,D1                   ; Down
                            	   788:     bne.s   .dtc_dir_set
                            	   789:     moveq   #2,D0
                            	   790:     btst    #1,D1                   ; Left
                            	   791:     bne.s   .dtc_dir_set
                            	   792:     moveq   #3,D0                   ; Right (bit 0)
                            	   793: .dtc_dir_set:
                            	   794:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   795:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   796:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   797:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   798:     move.b  ($00EB,A4),D2
                            	   799:     move.b  D2,D3
                            	   800:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   801:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   802:     tst.b   D0
                            	   803:     bne.s   .dtc_not_up
                            	   804:     tst.b   D2
                            	   805:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   806:     bra.s   .dtc_apply
                            	   807: .dtc_not_up:
                            	   808:     cmpi.b  #1,D0
                            	   809:     bne.s   .dtc_not_down
                            	   810:     cmpi.b  #7,D2
                            	   811:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   812:     bra.s   .dtc_apply
                            	   813: .dtc_not_down:
                            	   814:     cmpi.b  #2,D0
                            	   815:     bne.s   .dtc_not_left
                            	   816:     tst.b   D3
                            	   817:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   818:     bra.s   .dtc_apply
                            	   819: .dtc_not_left:
                            	   820:     cmpi.b  #$0F,D3
                            	   821:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   822: .dtc_apply:
                            	   823:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   824:     lea     (NextRoomIdOffsets).l,A0
                            	   825:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   826:     move.b  ($00EB,A4),D0
                            	   827:     add.b   D1,D0
                            	   828:     move.b  D0,($00EB,A4)
                            	   829:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   830:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   831:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   832:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   833:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   834:     ; movement update doesn't immediately retrigger the edge.
                            	   835:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   836:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   837:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   838:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   839:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   840:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   841:     ; skip that setup.
                            	   842:     jsr     LayOutRoom
                            	   843:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   844:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   845:     ; kick that from here with arbitrary state causes crashes when the
                            	   846:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   847:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   848:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   849:     ; per target room.
                            	   850:     clr.b   ($00F8,A4)
                            	   851:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   852:                                          ; doesn't walk during sweep settle
                            	   853:     moveq   #1,D0
                            	   854:     rts
                            	   855: .dtc_edge:
                            	   856:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   857:     ; interpret it as "walk into wall" animation.
                            	   858:     clr.b   ($00F8,A4)
                            	   859:     clr.b   ($00FA,A4)
                            	   860:     moveq   #1,D0
                            	   861:     rts
                            	   862: .dtc_no:
                            	   863:     moveq   #0,D0
                            	   864:     rts
                            	   865:     endc
                            	   866: 
                            	   867: ;==============================================================================
                            	   868: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   869: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   870: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   871: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   872: ;==============================================================================
                            	   873:     ifne TURBO_LINK
                            	   874: _turbo_link_boost:
                            	   875:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   876:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   877:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   878:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:00049A9A 4E75            	   879:     rts
                            	   880: _turbo_link_boost_disabled:
                            	   881:     ; OW gate
02:00049A9C 4A2C0010        	   882:     tst.b   ($0010,A4)
02:00049AA0 6670            	   883:     bne     .tlb_exit
                            	   884:     ; Mode 5 / Submode 0 only
02:00049AA2 0C2C00050012    	   885:     cmpi.b  #$05,($0012,A4)
02:00049AA8 6668            	   886:     bne     .tlb_exit
02:00049AAA 4A2C0013        	   887:     tst.b   ($0013,A4)
02:00049AAE 6662            	   888:     bne     .tlb_exit
                            	   889:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:00049AB0 122C00FA        	   890:     move.b  ($00FA,A4),D1
02:00049AB4 0201000F        	   891:     andi.b  #$0F,D1
02:00049AB8 6758            	   892:     beq     .tlb_exit
                            	   893:     ; Edge-safe clamps.
02:00049ABA 08010003        	   894:     btst    #3,D1                   ; Up (bit 3)
02:00049ABE 6710            	   895:     beq     .tlb_no_up
02:00049AC0 102C0084        	   896:     move.b  ($0084,A4),D0
02:00049AC4 0C000040        	   897:     cmpi.b  #$40,D0
02:00049AC8 6306            	   898:     bls     .tlb_no_up
02:00049ACA 5900            	   899:     subi.b  #4,D0
02:00049ACC 19400084        	   900:     move.b  D0,($0084,A4)
                            	   901: .tlb_no_up:
02:00049AD0 08010002        	   902:     btst    #2,D1                   ; Down (bit 2)
02:00049AD4 6710            	   903:     beq     .tlb_no_down
02:00049AD6 102C0084        	   904:     move.b  ($0084,A4),D0
02:00049ADA 0C0000D0        	   905:     cmpi.b  #$D0,D0
02:00049ADE 6406            	   906:     bcc     .tlb_no_down
02:00049AE0 5800            	   907:     addi.b  #4,D0
02:00049AE2 19400084        	   908:     move.b  D0,($0084,A4)
                            	   909: .tlb_no_down:
02:00049AE6 08010001        	   910:     btst    #1,D1                   ; Left (bit 1)
02:00049AEA 6710            	   911:     beq     .tlb_no_left
02:00049AEC 102C0070        	   912:     move.b  ($0070,A4),D0
02:00049AF0 0C00000A        	   913:     cmpi.b  #$0A,D0
02:00049AF4 6306            	   914:     bls     .tlb_no_left
02:00049AF6 5900            	   915:     subi.b  #4,D0
02:00049AF8 19400070        	   916:     move.b  D0,($0070,A4)
                            	   917: .tlb_no_left:
02:00049AFC 08010000        	   918:     btst    #0,D1                   ; Right (bit 0)
02:00049B00 6710            	   919:     beq     .tlb_no_right
02:00049B02 102C0070        	   920:     move.b  ($0070,A4),D0
02:00049B06 0C0000E6        	   921:     cmpi.b  #$E6,D0
02:00049B0A 6406            	   922:     bcc     .tlb_no_right
02:00049B0C 5800            	   923:     addi.b  #4,D0
02:00049B0E 19400070        	   924:     move.b  D0,($0070,A4)
                            	   925: .tlb_no_right:
                            	   926: .tlb_exit:
02:00049B12 4E75            	   927:     rts
                            	   928:     endc
