                            	   930: ;==============================================================================
                            	   931: ; fs_to_transpiled_trampoline — Native FS → transpiled gameplay/register-name
                            	   932: ; handoff. Mirror of intro_to_file_select_trampoline but enters at
                            	   933: ; UpdateMode1Menu_Sub1 (chose-slot path) with CurSaveSlot pre-seeded.
                            	   934: ;
                            	   935: ; Caller (fs_handoff.c) passes save_slot in D0 (low byte). For empty slots,
                            	   936: ; pass 3 → transpiled chose-slot path detects CurSaveSlot >= 3 and routes
                            	   937: ; to register-name (Mode 1 Sub1 → GameMode = slot+$0B = $0E).
                            	   938: ; For occupied slots, pass 0/1/2 → ChoseSlot copies items + JMP GoToNextMode
                            	   939: ; → Mode 2 → eventually Mode 5 (gameplay).
                            	   940: ;
                            	   941: ; Placed at end-of-file (after all zelda_translated includes) so its byte
                            	   942: ; size doesn't push transpiled .s short-branches out of range.
                            	   943: ;
                            	   944: ; Does NOT return.
                            	   945: ;==============================================================================
                            	   946:     xdef    fs_to_transpiled_trampoline
                            	   947: fs_to_transpiled_trampoline:
                            	   948:     ; No-arg trampoline. Caller (fs_handoff.c) writes CurSaveSlot at
                            	   949:     ; nes_ram[0x0016] directly before calling — m68k SysV byte-arg passing
                            	   950:     ; via D0 is unreliable (caller stack-pushes ints), so doing the seed
                            	   951:     ; in C avoids the ABI guesswork.
                            	   952: 
02:00049B14 13FC00CC00FF07F2	   953:     move.b  #$CC,($00FF07F2).l       ; probe: fs trampoline entered
                            	   954: 
                            	   955:     ; [1] Restore translated runtime register contract.
02:00049B1C 287C00FF0000    	   956:     move.l  #$00FF0000,A4
02:00049B22 2A7C00FF0200    	   957:     move.l  #$00FF0200,A5
02:00049B28 7EFF            	   958:     moveq   #-1,D7
                            	   959: 
                            	   960:     ; [2] Seed file-select chose-slot RAM contract.
                            	   961:     ;     CurSaveSlot already set by caller in C.
02:00049B2A 197C00000011    	   962:     move.b  #$00,($0011,A4)          ; IsUpdatingMode = 0
02:00049B30 197C00010012    	   963:     move.b  #$01,($0012,A4)          ; GameMode = $01 (file-select)
02:00049B36 197C00010013    	   964:     move.b  #$01,($0013,A4)          ; GameSubmode = $01 (chose-slot path)
02:00049B3C 13FC000100FF042B	   965:     move.b  #$01,(FrontendStartReleaseGate).l
02:00049B44 13FC000100FF083D	   966:     move.b  #$01,(VRamForceBlankGate).l
02:00049B4C 197C00000600    	   967:     move.b  #$00,($0600,A4)          ; SongRequest = 0
                            	   968: 
                            	   969:     ; [3] Re-enable transpiled NMI heartbeat.
02:00049B52 102C00FF        	   970:     move.b  ($00FF,A4),D0
02:00049B56 00000080        	   971:     ori.b   #$80,D0
02:00049B5A 194000FF        	   972:     move.b  D0,($00FF,A4)
02:00049B5E 13C000FF0804    	   973:     move.b  D0,(PPU_CTRL).l
                            	   974: 
                            	   975:     ; [4] VDP gameplay defaults (V64 + Window V=8).
02:00049B64 33FC901100C00004	   976:     move.w  #$9011,(VDP_CTRL).l
02:00049B6C 33FC920800C00004	   977:     move.w  #$9208,(VDP_CTRL).l
                            	   978: 
                            	   979:     ; [5] Flip dispatcher.
02:00049B74 13FC000100FF0FFC	   980:     move.b  #1,(vblank_mode).l
                            	   981: 
                            	   982:     ; [6] Spin.
02:00049B7C 6000D064        	   983:     jmp     LoopForever
