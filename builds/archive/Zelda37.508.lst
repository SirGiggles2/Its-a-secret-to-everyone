02:00040984 9101            	  6889:     subx.b  D1,D0   ; SBC #$40
02:00040986 0A3C0010        	  6890:     eori    #$10,CCR  ; restore X = 6502 C
02:0004098A E208            	  6891:     lsr.b  #1,D0   ; LSR A
02:0004098C E208            	  6892:     lsr.b  #1,D0   ; LSR A
02:0004098E E208            	  6893:     lsr.b  #1,D0   ; LSR A
02:00040990 7600            	  6894:     moveq   #0,D3
02:00040992 1600            	  6895:     move.b  D0,D3
