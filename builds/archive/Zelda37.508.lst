                            	  2407: ;==============================================================================
                            	  2408: ; APU writes ($4000–$4017)
                            	  2409: ;
                            	  2410: ; Most NES APU register writes are no-ops — the native M68K music player in
                            	  2411: ; audio_driver.asm drives YM2612/PSG directly from song scripts and ignores
                            	  2412: ; channel state, so every stub here is a plain rts.
                            	  2413: ;==============================================================================
                            	  2414: 
                            	  2415: _apu_write_4000:
                            	  2416: _apu_write_4001:
                            	  2417: _apu_write_4002:
                            	  2418: _apu_write_4003:
                            	  2419: _apu_write_4004:
                            	  2420: _apu_write_4005:
                            	  2421: _apu_write_4006:
                            	  2422: _apu_write_4007:
                            	  2423: _apu_write_4008:
                            	  2424: _apu_write_400a:
                            	  2425: _apu_write_400b:
                            	  2426: _apu_write_4011:
                            	  2427: _apu_write_4016:
                            	  2428: _apu_write_4017:
02:0002AE78 4E75            	  2429:     rts
                            	  2430: 
                            	  2431: ; Noise-channel APU writes. Zelda's SFX engine (PlaySfxNote) writes
                            	  2432: ; $400E (period), $400C (volume + const-vol bit), $400F (length trigger)
                            	  2433: ; per sfx-tick. We cache E+C and emit PSG on the F trigger. Arbitration
                            	  2434: ; is via $FF0606 (Effect) -- the music driver skips PSG noise writes
                            	  2435: ; when $0606 != 0, so SFX owns the channel for the duration of the hit.
                            	  2436: _apu_write_400c:
02:0002AE7A 13C000FFE029    	  2437:     move.b  D0,(m_sfx_vol).l
02:0002AE80 4E75            	  2438:     rts
                            	  2439: 
                            	  2440: _apu_write_400e:
02:0002AE82 13C000FFE02A    	  2441:     move.b  D0,(m_sfx_ctrl_raw).l
02:0002AE88 4E75            	  2442:     rts
                            	  2443: 
                            	  2444: _apu_write_400f:
02:0002AE8A 4A3900FF0606    	  2445:     tst.b   ($00FF0606).l                  ; SFX active on game side?
02:0002AE90 6758            	  2446:     beq.s   .f_skip
02:0002AE92 48E7C000        	  2447:     movem.l D0-D1,-(SP)
                            	  2448:     ; PSG noise control byte from cached $400E (low 4 bits = period idx).
                            	  2449:     ; Map NES 16-period index to 4-bucket PSG noise control ($E4..$E7).
02:0002AE96 103900FFE02A    	  2450:     move.b  (m_sfx_ctrl_raw).l,D0
02:0002AE9C 0200000F        	  2451:     andi.b  #$0F,D0
02:0002AEA0 0C000004        	  2452:     cmpi.b  #$04,D0
02:0002AEA4 6512            	  2453:     bcs.s   .pg_short
02:0002AEA6 0C000008        	  2454:     cmpi.b  #$08,D0
02:0002AEAA 6512            	  2455:     bcs.s   .pg_mid
02:0002AEAC 0C00000C        	  2456:     cmpi.b  #$0C,D0
02:0002AEB0 6512            	  2457:     bcs.s   .pg_long
02:0002AEB2 103C00E7        	  2458:     move.b  #$E7,D0
02:0002AEB6 6010            	  2459:     bra.s   .pg_ready
                            	  2460: .pg_short:
02:0002AEB8 103C00E4        	  2461:     move.b  #$E4,D0
02:0002AEBC 600A            	  2462:     bra.s   .pg_ready
                            	  2463: .pg_mid:
02:0002AEBE 103C00E5        	  2464:     move.b  #$E5,D0
02:0002AEC2 6004            	  2465:     bra.s   .pg_ready
                            	  2466: .pg_long:
02:0002AEC4 103C00E6        	  2467:     move.b  #$E6,D0
                            	  2468: .pg_ready:
02:0002AEC8 13C000C00011    	  2469:     move.b  D0,(PSG_PORT).l                ; noise control ($Ex)
                            	  2470:     ; PSG attenuation from cached $400C (low 4 bits = volume nibble).
02:0002AECE 103900FFE029    	  2471:     move.b  (m_sfx_vol).l,D0
02:0002AED4 0200000F        	  2472:     andi.b  #$0F,D0
