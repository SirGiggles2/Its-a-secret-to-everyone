02:00038ED2 41EC00AC        	  2004:     lea     ($00AC,A4),A0
02:00038ED6 16302000        	  2005:     move.b  (A0,D2.W),D3
02:00038EDA 41F900038CCC    	  2006:     lea     (RedLeeverStateAnimTimes).l,A0
02:00038EE0 10303000        	  2007:     move.b  (A0,D3.W),D0
