                            	  4986: UpdateDodongoState1_Bloated_Sub_Wait:
                            	  4987:     ; Bloated timer =>
                            	  4988:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  4989:     ; 1:     go advance the substate
                            	  4990:     ; other: go decrement Bloated timer
                            	  4991:     ;
02:0003A43A 7600            	  4992:     moveq   #0,D3
02:0003A43C 41EC045E        	  4993:     lea     ($045E,A4),A0
02:0003A440 16302000        	  4994:     move.b  (A0,D2.W),D3
02:0003A444 5303            	  4995:     subq.b  #1,D3
02:0003A446 6750            	  4996:     beq  _L_z04_UpdateDodongoState1_Bloated_Sub_Wait_AdvanceSubstate
02:0003A448 6B04            	  4997:     bmi.s  __far_z_04_0043
02:0003A44A 60000080        	  4998:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  4999: __far_z_04_0043:
                            	  5000:     ; Set the bloated timer according to the substate.
                            	  5001:     ;
02:0003A44E 7600            	  5002:     moveq   #0,D3
02:0003A450 41EC042C        	  5003:     lea     ($042C,A4),A0
02:0003A454 16302000        	  5004:     move.b  (A0,D2.W),D3
02:0003A458 41F90003A396    	  5005:     lea     (DodongoBloatedWaitTimes).l,A0
02:0003A45E 10303000        	  5006:     move.b  (A0,D3.W),D0
02:0003A462 41EC045E        	  5007:     lea     ($045E,A4),A0
02:0003A466 11802000        	  5008:     move.b  D0,(A0,D2.W)
                            	  5009:     ; If substate <> 0, go decrement bloated timer.
                            	  5010:     ;
02:0003A46A 4A03            	  5011:     cmpi.b  #$00,D3
02:0003A46C 6702            	  5012:     beq.s  __far_z_04_0044
02:0003A46E 605C            	  5013:     jmp  L_Dodongo_DecrementBloatedTimer
                            	  5014: __far_z_04_0044:
                            	  5015:     ; Deactivate the bomb in the first bomb slot ($10).
                            	  5016:     ;
02:0003A470 7610            	  5017:     moveq   #16,D3
02:0003A472 7000            	  5018:     moveq   #0,D0
02:0003A474 41EC00AC        	  5019:     lea     ($00AC,A4),A0
02:0003A478 11803000        	  5020:     move.b  D0,(A0,D3.W)
                            	  5021:     ; Increment the number of bomb hits.
                            	  5022:     ;
02:0003A47C 41EC0437        	  5023:     lea     ($0437,A4),A0
02:0003A480 10302000        	  5024:     move.b  (A0,D2.W),D0
02:0003A484 023C00EE        	  5025:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A488 123C0001        	  5026:     move.b  #$01,D1
02:0003A48C D101            	  5027:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003A48E 41EC0437        	  5028:     lea     ($0437,A4),A0
02:0003A492 11802000        	  5029:     move.b  D0,(A0,D2.W)
02:0003A496 6034            	  5030:     jmp     L_Dodongo_DecrementBloatedTimer
