                            	  4085:     ; If grid offset <> 0, return.
                            	  4086:     ;
02:00047F54 41EC0394        	  4087:     lea     ($0394,A4),A0
02:00047F58 10302000        	  4088:     move.b  (A0,D2.W),D0
02:00047F5C 6704            	  4089:     beq.s  __far_z_07_0047
02:00047F5E 6000009E        	  4090:     jmp  L1F148_Exit
                            	  4091: __far_z_07_0047:
                            	  4092:     ; Grid offset = 0.
                            	  4093:     ; The object is at a point between cells in the grid.
                            	  4094:     ; So, we can check tiles for collision.
                            	  4095:     ;
                            	  4096:     ; Reset [0E] alternate direction search step.
                            	  4097:     ;
02:00047F62 1940000E        	  4098:     move.b  D0,($000E,A4)
                            	  4099:     ; If there's a movement direction, go check tile collision.
                            	  4100:     ;
02:00047F66 102C000F        	  4101:     move.b  ($000F,A4),D0
02:00047F6A 6702            	  4102:     beq.s  __far_z_07_0048
02:00047F6C 602E            	  4103:     jmp  CheckTiles
