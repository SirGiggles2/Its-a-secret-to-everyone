                            	  1052: ;==============================================================================
                            	  1053: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	  1054: ;==============================================================================
                            	  1055: tick_noise:
02:00000B40 103900FFE000    	  1056:     move.b  (m_song).l,D0
02:00000B46 02000091        	  1057:     andi.b  #$91,D0
02:00000B4A 67000082        	  1058:     beq     .tn_done
                            	  1059:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	  1060:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	  1061:     ; a hit fires below.
02:00000B4E 61000250        	  1062:     bsr     noise_decay_tick
02:00000B52 533900FFE025    	  1063:     subq.b  #1,(m_noise_cnt).l
02:00000B58 6674            	  1064:     bne     .tn_done
                            	  1065: .read:
02:00000B5A 207900FFE008    	  1066:     move.l  (m_script_ptr).l,A0
02:00000B60 7200            	  1067:     moveq   #0,D1
02:00000B62 123900FFE024    	  1068:     move.b  (m_noise_off).l,D1
02:00000B68 523900FFE024    	  1069:     addq.b  #1,(m_noise_off).l
02:00000B6E 10301000        	  1070:     move.b  (A0,D1.w),D0
02:00000B72 660C            	  1071:     bne.s   .got
02:00000B74 13F900FFE00600FF	  1072:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000B7C E024
02:00000B7E 60DA            	  1073:     bra.s   .read
                            	  1074: .got:
02:00000B80 1800            	  1075:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1076:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1077:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1078:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1079:     ; (0,7,6). For our port we replicate exactly.
02:00000B82 7400            	  1080:     moveq   #0,D2
02:00000B84 1404            	  1081:     move.b  D4,D2
                            	  1082:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000B86 7000            	  1083:     moveq   #0,D0
02:00000B88 08020000        	  1084:     btst    #0,D2
02:00000B8C 6704            	  1085:     beq.s   .b0
02:00000B8E 08C00002        	  1086:     bset    #2,D0
                            	  1087: .b0:
02:00000B92 08020007        	  1088:     btst    #7,D2
02:00000B96 6704            	  1089:     beq.s   .b7
02:00000B98 08C00001        	  1090:     bset    #1,D0
                            	  1091: .b7:
02:00000B9C 08020006        	  1092:     btst    #6,D2
02:00000BA0 6704            	  1093:     beq.s   .b6
02:00000BA2 08C00000        	  1094:     bset    #0,D0
                            	  1095: .b6:
02:00000BA6 7200            	  1096:     moveq   #0,D1
02:00000BA8 123900FFE003    	  1097:     move.b  (m_len_base).l,D1
02:00000BAE D240            	  1098:     add.w   D0,D1
02:00000BB0 43F900000E52    	  1099:     lea     (NoteLengthTables).l,A1
02:00000BB6 13F1100000FFE025	  1100:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1101:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000BBE 1004            	  1102:     move.b  D4,D0
02:00000BC0 0200003E        	  1103:     andi.b  #$3E,D0
02:00000BC4 E808            	  1104:     lsr.b   #4,D0
02:00000BC6 7200            	  1105:     moveq   #0,D1
02:00000BC8 1200            	  1106:     move.b  D0,D1
                            	  1107:     ; Map to PSG noise: set volume + period
02:00000BCA 6100015A        	  1108:     bsr     set_psg_noise
                            	  1109: .tn_done:
02:00000BCE 4E75            	  1110:     rts
                            	  1111: 
                            	  1112: ;==============================================================================
                            	  1113: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1114: ; Input: D0 = control byte → Output: D0 = length
                            	  1115: ;==============================================================================
                            	  1116: get_song_note_length:
02:00000BD0 02400007        	  1117:     andi.w  #$07,D0
02:00000BD4 7200            	  1118:     moveq   #0,D1
02:00000BD6 123900FFE003    	  1119:     move.b  (m_len_base).l,D1
02:00000BDC D240            	  1120:     add.w   D0,D1
02:00000BDE 43F900000E52    	  1121:     lea     (NoteLengthTables).l,A1
02:00000BE4 10311000        	  1122:     move.b  (A1,D1.w),D0
02:00000BE8 4E75            	  1123:     rts
                            	  1124: 
                            	  1125: ;==============================================================================
                            	  1126: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1127: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1128: ;==============================================================================
                            	  1129: emit_note_sq1:
02:00000BEA 024000FF        	  1130:     andi.w  #$FF,D0
02:00000BEE 43F900000DE0    	  1131:     lea     (MusicNotePeriodTable).l,A1
02:00000BF4 7400            	  1132:     moveq   #0,D2
02:00000BF6 14310001        	  1133:     move.b  1(A1,D0.w),D2                 ; lo
02:00000BFA 67000106        	  1134:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000BFE 7600            	  1135:     moveq   #0,D3
02:00000C00 16310000        	  1136:     move.b  0(A1,D0.w),D3                 ; hi
02:00000C04 E14B            	  1137:     lsl.w   #8,D3
02:00000C06 8642            	  1138:     or.w    D2,D3                          ; D3.w = period
02:00000C08 024307FF        	  1139:     andi.w  #$07FF,D3
02:00000C0C 13C200FFE010    	  1140:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000C12 3403            	  1141:     move.w  D3,D2
02:00000C14 263C00021986    	  1142:     move.l  #NES_YM_K5_PULSE,D3
02:00000C1A 6100F7FC        	  1143:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1144:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000C1E 103C0028        	  1145:     move.b  #$28,D0
02:00000C22 7200            	  1146:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000C24 6100F7AA        	  1147:     bsr     ym_write1
02:00000C28 103C00A4        	  1148:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000C2C 1202            	  1149:     move.b  D2,D1
02:00000C2E 6100F7A0        	  1150:     bsr     ym_write1
02:00000C32 103C00A0        	  1151:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000C36 1203            	  1152:     move.b  D3,D1
02:00000C38 6100F796        	  1153:     bsr     ym_write1
                            	  1154:     ; Key on ch 0, all ops
02:00000C3C 103C0028        	  1155:     move.b  #$28,D0
02:00000C40 123C00F0        	  1156:     move.b  #$F0,D1
02:00000C44 6000F78A        	  1157:     bra     ym_write1
                            	  1158: 
                            	  1159: ;==============================================================================
                            	  1160: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1161: ;==============================================================================
                            	  1162: emit_note_sq0:
02:00000C48 024000FF        	  1163:     andi.w  #$FF,D0
02:00000C4C 43F900000DE0    	  1164:     lea     (MusicNotePeriodTable).l,A1
02:00000C52 7400            	  1165:     moveq   #0,D2
02:00000C54 14310001        	  1166:     move.b  1(A1,D0.w),D2
02:00000C58 670000B4        	  1167:     beq     key_off_sq0
02:00000C5C 7600            	  1168:     moveq   #0,D3
02:00000C5E 16310000        	  1169:     move.b  0(A1,D0.w),D3
02:00000C62 E14B            	  1170:     lsl.w   #8,D3
02:00000C64 8642            	  1171:     or.w    D2,D3
02:00000C66 024307FF        	  1172:     andi.w  #$07FF,D3
02:00000C6A 13C200FFE018    	  1173:     move.b  D2,(m_sq0_per).l
02:00000C70 3403            	  1174:     move.w  D3,D2
02:00000C72 263C00021986    	  1175:     move.l  #NES_YM_K5_PULSE,D3
02:00000C78 6100F79E        	  1176:     bsr     nes_to_ym_freq
                            	  1177:     ; Key off first so the envelope attack phase retriggers
02:00000C7C 103C0028        	  1178:     move.b  #$28,D0
02:00000C80 7201            	  1179:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000C82 6100F74C        	  1180:     bsr     ym_write1
02:00000C86 103C00A5        	  1181:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000C8A 1202            	  1182:     move.b  D2,D1
02:00000C8C 6100F742        	  1183:     bsr     ym_write1
02:00000C90 103C00A1        	  1184:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000C94 1203            	  1185:     move.b  D3,D1
02:00000C96 6100F738        	  1186:     bsr     ym_write1
02:00000C9A 103C0028        	  1187:     move.b  #$28,D0
02:00000C9E 123C00F1        	  1188:     move.b  #$F1,D1
02:00000CA2 6000F72C        	  1189:     bra     ym_write1
                            	  1190: 
                            	  1191: ;==============================================================================
                            	  1192: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1193: ;==============================================================================
                            	  1194: emit_note_trg:
02:00000CA6 024000FF        	  1195:     andi.w  #$FF,D0
02:00000CAA 43F900000DE0    	  1196:     lea     (MusicNotePeriodTable).l,A1
02:00000CB0 7400            	  1197:     moveq   #0,D2
02:00000CB2 14310001        	  1198:     move.b  1(A1,D0.w),D2
02:00000CB6 6762            	  1199:     beq     key_off_trg
02:00000CB8 7600            	  1200:     moveq   #0,D3
02:00000CBA 16310000        	  1201:     move.b  0(A1,D0.w),D3
02:00000CBE E14B            	  1202:     lsl.w   #8,D3
02:00000CC0 8642            	  1203:     or.w    D2,D3
02:00000CC2 024307FF        	  1204:     andi.w  #$07FF,D3
02:00000CC6 13C200FFE020    	  1205:     move.b  D2,(m_trg_per).l
02:00000CCC 3403            	  1206:     move.w  D3,D2
02:00000CCE 263C00010CC3    	  1207:     move.l  #NES_YM_K5_TRI,D3
02:00000CD4 6100F742        	  1208:     bsr     nes_to_ym_freq
                            	  1209:     ; Key off first so the bass envelope retriggers per note
02:00000CD8 103C0028        	  1210:     move.b  #$28,D0
02:00000CDC 7202            	  1211:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000CDE 6100F6F0        	  1212:     bsr     ym_write1
02:00000CE2 103C00A6        	  1213:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000CE6 1202            	  1214:     move.b  D2,D1
02:00000CE8 6100F6E6        	  1215:     bsr     ym_write1
02:00000CEC 103C00A2        	  1216:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000CF0 1203            	  1217:     move.b  D3,D1
02:00000CF2 6100F6DC        	  1218:     bsr     ym_write1
02:00000CF6 103C0028        	  1219:     move.b  #$28,D0
02:00000CFA 123C00F2        	  1220:     move.b  #$F2,D1
02:00000CFE 6000F6D0        	  1221:     bra     ym_write1
                            	  1222: 
                            	  1223: ;==============================================================================
                            	  1224: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1225: ;==============================================================================
                            	  1226: key_off_sq1:
02:00000D02 103C0028        	  1227:     move.b  #$28,D0
02:00000D06 123C0000        	  1228:     move.b  #$00,D1
02:00000D0A 6000F6C4        	  1229:     bra     ym_write1
                            	  1230: key_off_sq0:
02:00000D0E 103C0028        	  1231:     move.b  #$28,D0
02:00000D12 123C0001        	  1232:     move.b  #$01,D1
02:00000D16 6000F6B8        	  1233:     bra     ym_write1
                            	  1234: key_off_trg:
02:00000D1A 103C0028        	  1235:     move.b  #$28,D0
02:00000D1E 123C0002        	  1236:     move.b  #$02,D1
02:00000D22 6000F6AC        	  1237:     bra     ym_write1
                            	  1238: 
                            	  1239: ;==============================================================================
                            	  1240: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1241: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1242: ;
                            	  1243: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1244: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1245: ;     PsgDrumTable.
                            	  1246: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1247: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1248: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1249: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1250: ;     noise_decay_tick.
                            	  1251: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1252: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1253: ;==============================================================================
                            	  1254: set_psg_noise:
                            	  1255:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1256:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1257:     ; music drums resume on the next beat.
02:00000D26 4A3900FF0606    	  1258:     tst.b   ($00FF0606).l
02:00000D2C 661A            	  1259:     bne.s   .sfx_owns_psg
02:00000D2E 4A01            	  1260:     tst.b   D1
02:00000D30 6618            	  1261:     bne.s   .not_rest
                            	  1262:     ; Rest: silence the PSG noise channel immediately.
02:00000D32 423900FFE026    	  1263:     clr.b   (m_noise_level).l
02:00000D38 423900FFE027    	  1264:     clr.b   (m_noise_decay).l
02:00000D3E 13FC00FF00C00011	  1265:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000D46 4E75            	  1266:     rts
                            	  1267: .sfx_owns_psg:
02:00000D48 4E75            	  1268:     rts
                            	  1269: .not_rest:
02:00000D4A 7000            	  1270:     moveq   #0,D0
02:00000D4C 1001            	  1271:     move.b  D1,D0
02:00000D4E E548            	  1272:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000D50 43F900000E86    	  1273:     lea     (PsgDrumTable).l,A1
02:00000D56 D3C0            	  1274:     adda.l  D0,A1
02:00000D58 1019            	  1275:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1276:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000D5A B03900FFE028    	  1277:     cmp.b   (m_last_psg_nc).l,D0
02:00000D60 670C            	  1278:     beq.s   .nc_same
02:00000D62 13C000FFE028    	  1279:     move.b  D0,(m_last_psg_nc).l
02:00000D68 13C000C00011    	  1280:     move.b  D0,(PSG_PORT).l
                            	  1281: .nc_same:
02:00000D6E 1019            	  1282:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000D70 13C000FFE026    	  1283:     move.b  D0,(m_noise_level).l
02:00000D76 1019            	  1284:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000D78 13C000FFE027    	  1285:     move.b  D0,(m_noise_decay).l
                            	  1286:     bra     write_psg_noise_vol
                            	  1287: 
                            	  1288: ;==============================================================================
                            	  1289: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1290: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1291: ; Preserves D1.
                            	  1292: ;==============================================================================
                            	  1293: write_psg_noise_vol:
02:00000D7E 4A3900FF0606    	  1294:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000D84 6618            	  1295:     bne.s   .wpnv_skip
02:00000D86 7000            	  1296:     moveq   #0,D0
02:00000D88 103900FFE026    	  1297:     move.b  (m_noise_level).l,D0
02:00000D8E E808            	  1298:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000D90 0A00000F        	  1299:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000D94 000000F0        	  1300:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000D98 13C000C00011    	  1301:     move.b  D0,(PSG_PORT).l
                            	  1302: .wpnv_skip:
02:00000D9E 4E75            	  1303:     rts
                            	  1304: 
                            	  1305: ;==============================================================================
                            	  1306: ; noise_decay_tick — linear envelope decay step.
                            	  1307: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1308: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1309: ; Preserves D1.
                            	  1310: ;==============================================================================
                            	  1311: noise_decay_tick:
02:00000DA0 4A3900FF0606    	  1312:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000DA6 661A            	  1313:     bne.s   .nd_done
02:00000DA8 103900FFE026    	  1314:     move.b  (m_noise_level).l,D0
02:00000DAE 6712            	  1315:     beq.s   .nd_done                        ; already silent
02:00000DB0 903900FFE027    	  1316:     sub.b   (m_noise_decay).l,D0
02:00000DB6 6402            	  1317:     bcc.s   .nd_store                       ; no underflow → new level
02:00000DB8 7000            	  1318:     moveq   #0,D0                           ; underflow → silent
                            	  1319: .nd_store:
02:00000DBA 13C000FFE026    	  1320:     move.b  D0,(m_noise_level).l
02:00000DC0 60BC            	  1321:     bra     write_psg_noise_vol
                            	  1322: .nd_done:
02:00000DC2 4E75            	  1323:     rts
                            	  1324: 
                            	  1325: ;==============================================================================
                            	  1326: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1327: ;==============================================================================
                            	  1328: music_silence:
02:00000DC4 423900FFE000    	  1329:     clr.b   (m_song).l
02:00000DCA 6100FF36        	  1330:     bsr     key_off_sq1
02:00000DCE 6100FF3E        	  1331:     bsr     key_off_sq0
02:00000DD2 6100FF46        	  1332:     bsr     key_off_trg
02:00000DD6 13FC00FF00C00011	  1333:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000DDE 4E75            	  1334:     rts
                            	  1335: 
                            	  1336: ;==============================================================================
                            	  1337: ; Music data tables
                            	  1338: ;==============================================================================
                            	  1339:     even
