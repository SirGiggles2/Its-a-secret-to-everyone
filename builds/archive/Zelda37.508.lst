02:00048CE0 E208            	  6093:     lsr.b  #1,D0   ; LSR A
02:00048CE2 E208            	  6094:     lsr.b  #1,D0   ; LSR A
02:00048CE4 E208            	  6095:     lsr.b  #1,D0   ; LSR A
02:00048CE6 E208            	  6096:     lsr.b  #1,D0   ; LSR A
02:00048CE8 1214            	  6097:     move.b  ($0000,A4),D1
02:00048CEA B001            	  6098:     cmp.b   D1,D0
02:00048CEC 6702            	  6099:     beq.s  __far_z_07_0092
02:00048CEE 60C6            	  6100:     jmp  L1F854_Exit
