02:0002B5F4 3C03            	  3444:     move.w  D3,D6
02:0002B5F6 EB4E            	  3445:     lsl.w   #5,D6
02:0002B5F8 DC42            	  3446:     add.w   D2,D6
02:0002B5FA 13806000        	  3447:     move.b  D0,(A1,D6.W)
02:0002B5FE 5246            	  3448:     addq.w  #1,D6
02:0002B600 13806000        	  3449:     move.b  D0,(A1,D6.W)
02:0002B604 0646001F        	  3450:     addi.w  #31,D6
02:0002B608 13806000        	  3451:     move.b  D0,(A1,D6.W)
02:0002B60C 5246            	  3452:     addq.w  #1,D6
02:0002B60E 13806000        	  3453:     move.b  D0,(A1,D6.W)
