                            	    27: DMC_SFX_04_DELTA_OFF equ     $1753
                            	    28: DMC_SFX_04_DELTA_LEN equ     $00A1
                            	    29: DMC_SFX_05_DELTA_OFF equ     $17F4
                            	    30: DMC_SFX_05_DELTA_LEN equ     $0B01
                            	    31: DMC_SFX_06_DELTA_OFF equ     $22F5
                            	    32: DMC_SFX_06_DELTA_LEN equ     $0901
                            	    33: DMC_SFX_07_DELTA_OFF equ     $2BF6
                            	    34: DMC_SFX_07_DELTA_LEN equ     $0D01
                            	    35: 
                            	    36: ; --- PCM form (decoded, ready for YM reg $2A) --------------------------
                            	    37: DMC_SFX_01_PCM_OFF   equ     $000000
                            	    38: DMC_SFX_01_PCM_LEN   equ     $000F75
                            	    39: DMC_SFX_02_PCM_OFF   equ     $000F75
