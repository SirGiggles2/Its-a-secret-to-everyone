02:00034E3A 41EC0302        	  4320:     lea     ($0302,A4),A0
02:00034E3E 11803000        	  4321:     move.b  D0,(A0,D3.W)
02:00034E42 5303            	  4322:     subq.b  #1,D3
02:00034E44 6AEA            	  4323:     bpl  _anon_z02_34
