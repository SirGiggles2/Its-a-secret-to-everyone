02:0003B9E8 0A3C0010        	  7872:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003B9EC 9101            	  7873:     subx.b  D1,D0   ; SBC $00
02:0003B9EE 0A3C0010        	  7874:     eori    #$10,CCR  ; restore X = 6502 C
02:0003B9F2 41EC0084        	  7875:     lea     ($0084,A4),A0
