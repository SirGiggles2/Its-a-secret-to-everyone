                            	  5327:     ;
                            	  5328:     ; Set state to $40. It will become $50 below in
                            	  5329:     ; HandleArrowOrBoomerangBlocked.
                            	  5330:     ;
02:0004875C 7040            	  5331:     moveq   #64,D0
02:0004875E 41EC00AC        	  5332:     lea     ($00AC,A4),A0
02:00048762 11802000        	  5333:     move.b  D0,(A0,D2.W)
                            	  5334:     ; If this is an arrow (monster's or player's), then deactivate it.
                            	  5335:     ; Else go handle the boomerang being blocked.
                            	  5336:     ;
02:00048766 0C02000D        	  5337:     cmpi.b  #$0D,D2
02:0004876A 640E            	  5338:     bcc  _L_z07_CheckState20_CheckBoomerangBlocked
02:0004876C 41EC034F        	  5339:     lea     ($034F,A4),A0
