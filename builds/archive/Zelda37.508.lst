                            	   542: ;------------------------------------------------------------------------------
                            	   543: ; _ags_apply_active — Program VDP VSRAM/H-int state for the current frame from
                            	   544: ; the active queue/debug state set by _ags_activate_staged. For no-split and
                            	   545: ; intro dead-zone modes, the base VSRAM comes from ACTIVE_BASE_VSRAM.
                            	   546: ;
                            	   547: ; Clobbers D0.
                            	   548: ;------------------------------------------------------------------------------
                            	   549: _ags_apply_active:
02:0000E2C2 4A3900FF081F    	   550:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E2C8 6636            	   551:     bne.s   .aaa_split
                            	   552:     ; No-split path. When DMC is NOT active, do the full H-int off sequence.
                            	   553:     ; When DMC IS active, skip the Reg 10 / Reg 0 writes so dmc_trigger's
                            	   554:     ; HINT arm survives -- DMC only fires in no-split contexts (see
                            	   555:     ; dmc_trigger gate), so there's no scroll-split to service this frame.
02:0000E2CA 4A3900FFE100    	   556:     tst.b   (dmc_active).l
02:0000E2D0 6610            	   557:     bne.s   .aaa_dmc_vsram_only
02:0000E2D2 33FC8AFF00C00004	   558:     move.w  #$8AFF,(VDP_CTRL).l             ; Reg 10 = $FF (inactive)
02:0000E2DA 33FC800400C00004	   559:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: H-int off
                            	   560: .aaa_dmc_vsram_only:
02:0000E2E2 23FC4000001000C0	   561:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E2EA 0004
02:0000E2EC 33F900FF083600C0	   562:     move.w  (ACTIVE_BASE_VSRAM).l,(VDP_DATA).l
02:0000E2F4 0000
02:0000E2F6 7000            	   563:     moveq   #0,D0
02:0000E2F8 33C000C00000    	   564:     move.w  D0,(VDP_DATA).l
02:0000E2FE 4E75            	   565:     rts
                            	   566: .aaa_split:
02:0000E300 23FC4000001000C0	   567:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:0000E308 0004
02:0000E30A 7000            	   568:     moveq   #0,D0
02:0000E30C 0C39000100FF081F	   569:     cmpi.b  #INTRO_SCROLL_GAME_SPLIT,(INTRO_SCROLL_MODE).l
02:0000E314 6706            	   570:     beq.s   .aaa_base_ready
02:0000E316 303900FF0836    	   571:     move.w  (ACTIVE_BASE_VSRAM).l,D0
                            	   572: .aaa_base_ready:
02:0000E31C 33C000C00000    	   573:     move.w  D0,(VDP_DATA).l
02:0000E322 7000            	   574:     moveq   #0,D0
02:0000E324 33C000C00000    	   575:     move.w  D0,(VDP_DATA).l
02:0000E32A 7000            	   576:     moveq   #0,D0
02:0000E32C 103900FF0817    	   577:     move.b  (HINT_Q0_CTR).l,D0
02:0000E332 024000FF        	   578:     andi.w  #$00FF,D0
02:0000E336 807C8A00        	   579:     or.w    #$8A00,D0
02:0000E33A 33C000C00004    	   580:     move.w  D0,(VDP_CTRL).l                 ; Reg 10 = active H-int scanline
02:0000E340 33FC801400C00004	   581:     move.w  #$8014,(VDP_CTRL).l             ; Reg 0: enable H-int (+colorfix bit)
02:0000E348 4E75            	   582:     rts
