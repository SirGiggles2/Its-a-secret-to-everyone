02:00038AE8 41EC0084        	  1489:     lea     ($0084,A4),A0
02:00038AEC 11802000        	  1490:     move.b  D0,(A0,D2.W)
                            	  1491:     ; Add the acceleration to the speed fraction (low byte).
                            	  1492:     ;
02:00038AF0 41EC041F        	  1493:     lea     ($041F,A4),A0
02:00038AF4 10302000        	  1494:     move.b  (A0,D2.W),D0
02:00038AF8 023C00EE        	  1495:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038AFC 1214            	  1496:     move.b  ($0000,A4),D1
02:00038AFE D101            	  1497:     addx.b  D1,D0   ; ADC $00
02:00038B00 41EC041F        	  1498:     lea     ($041F,A4),A0
02:00038B04 11802000        	  1499:     move.b  D0,(A0,D2.W)
                            	  1500:     ; Carry over to the high speed byte.
                            	  1501:     ;
02:00038B08 41EC0412        	  1502:     lea     ($0412,A4),A0
02:00038B0C 10302000        	  1503:     move.b  (A0,D2.W),D0
02:00038B10 123C0000        	  1504:     move.b  #$00,D1
02:00038B14 D101            	  1505:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:00038B16 41EC0412        	  1506:     lea     ($0412,A4),A0
02:00038B1A 11802000        	  1507:     move.b  D0,(A0,D2.W)
                            	  1508:     ; *Signed comparison*:
                            	  1509:     ; If the high speed byte < high max speed byte, then return.
                            	  1510:     ;
                            	  1511:     ; Note that this is not a general purpose signed comparison,
                            	  1512:     ; which would be more complicated. But it works because
                            	  1513:     ; the deviation from 0 of both values is small.
                            	  1514:     ;
02:00038B1E 122C0002        	  1515:     move.b  ($0002,A4),D1
02:00038B22 B001            	  1516:     cmp.b   D1,D0
02:00038B24 6A02            	  1517:     bpl.s  __far_z_04_0011
02:00038B26 6022            	  1518:     jmp  L10A52_Exit
