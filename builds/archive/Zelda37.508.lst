                            	  3955: _L_z05_CheckDoorway_TestDoorwayDoor:
                            	  3956:     ;
                            	  3957:     ;
                            	  3958:     ; [0E] holds reverse index of doorway direction found.
                            	  3959:     ;
02:0003E79C 1943000E        	  3960:     move.b  D3,($000E,A4)
                            	  3961:     ; Store input direction in [02] and [0C].
                            	  3962:     ;
02:0003E7A0 102C03F8        	  3963:     move.b  ($03F8,A4),D0
02:0003E7A4 0200000F        	  3964:     andi.b #$0F,D0
02:0003E7A8 19400002        	  3965:     move.b  D0,($0002,A4)
02:0003E7AC 1940000C        	  3966:     move.b  D0,($000C,A4)
