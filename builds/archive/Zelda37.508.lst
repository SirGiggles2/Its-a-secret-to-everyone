                            	  8139: Ganon_MoveAndShoot:
                            	  8140:     ; Change the animation frame every screen frame; so that
                            	  8141:     ; when Ganon is hit, he appears in a random pose.
                            	  8142:     ;
02:0003BBA8 41EC046B        	  8143:     lea     ($046B,A4),A0
02:0003BBAC 52302000        	  8144:     addq.b  #1,(A0,D2.W)
                            	  8145:     ; The animation cycle has 6 frames.
                            	  8146:     ;
02:0003BBB0 41EC046B        	  8147:     lea     ($046B,A4),A0
02:0003BBB4 10302000        	  8148:     move.b  (A0,D2.W),D0
02:0003BBB8 0C000006        	  8149:     cmpi.b  #$06,D0
02:0003BBBC 660A            	  8150:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0003BBBE 7000            	  8151:     moveq   #0,D0
02:0003BBC0 41EC046B        	  8152:     lea     ($046B,A4),A0
02:0003BBC4 11802000        	  8153:     move.b  D0,(A0,D2.W)
                            	  8154:     even
