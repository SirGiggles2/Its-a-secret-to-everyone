02:0003BDA0 41EC0084        	  8408:     lea     ($0084,A4),A0
02:0003BDA4 10302000        	  8409:     move.b  (A0,D2.W),D0
02:0003BDA8 19400001        	  8410:     move.b  D0,($0001,A4)
