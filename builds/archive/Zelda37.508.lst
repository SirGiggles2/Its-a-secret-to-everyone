02:00038918 0C030010        	  1210:     cmpi.b  #$10,D3
02:0003891C 661C            	  1211:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  1212:     ; If we have the magic clock, or the monster is stunned, then
                            	  1213:     ; go set a zero speed.
