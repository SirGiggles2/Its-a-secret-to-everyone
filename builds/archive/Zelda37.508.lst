                            	  3932:     ; assign it to facing direction, and reset deferred bounce direction.
                            	  3933:     ;
02:00039C4E 41EC03BC        	  3934:     lea     ($03BC,A4),A0
02:00039C52 10302000        	  3935:     move.b  (A0,D2.W),D0
02:00039C56 6712            	  3936:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:00039C58 41EC0098        	  3937:     lea     ($0098,A4),A0
02:00039C5C 11802000        	  3938:     move.b  D0,(A0,D2.W)
02:00039C60 7000            	  3939:     moveq   #0,D0
02:00039C62 41EC03BC        	  3940:     lea     ($03BC,A4),A0
