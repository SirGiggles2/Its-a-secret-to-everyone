                            	  4141:     ifne TURBO_LINK
                            	  4142:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4143:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:00047F9C 4A02            	  4144:     tst.b   D2
02:00047F9E 6608            	  4145:     bne.s   _L_z07_CheckTiles_notLink
02:00047FA0 197C0024049E    	  4146:     move.b  #$24,($049E,A4)
02:00047FA6 605E            	  4147:     jmp     GoWalkableDir
                            	  4148: _L_z07_CheckTiles_notLink:
                            	  4149:     endc
                            	  4150:     ; The code below applies to Link and other objects.
                            	  4151:     ;
                            	  4152:     ; Test the moving direction's walkability.
                            	  4153:     ;
                            	  4154:     ; For the player, this is enough. For other objects, this 
                            	  4155:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4156:     ;
                            	  4157:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4158:     ;
02:00047FA8 6100FB88        	  4159:     jsr     GetCollidingTileMoving
02:00047FAC 122C034A        	  4160:     move.b  ($034A,A4),D1
02:00047FB0 B001            	  4161:     cmp.b   D1,D0
02:00047FB2 6402            	  4162:     bcc.s  __far_z_07_0051
02:00047FB4 6050            	  4163:     jmp  GoWalkableDir
                            	  4164: __far_z_07_0051:
                            	  4165:     ; The colliding tile is unwalkable.
                            	  4166:     ;
                            	  4167:     ; If object is the player, then go check passive tile objects and
                            	  4168:     ; the screen edge, or stop moving.
                            	  4169:     ;
02:00047FB6 4A02            	  4170:     cmpi.b  #$00,D2
02:00047FB8 6602            	  4171:     bne.s  __far_z_07_0052
02:00047FBA 6022            	  4172:     jmp  PlayerUnwalkable
                            	  4173: __far_z_07_0052:
                            	  4174:     even
                            	  4175: CheckObjAttr10AndAltDir:
                            	  4176:     ; Not the player.
                            	  4177:     ; If object attribute has $10, go to the unused code above
                            	  4178:     ; to reverse direction.
                            	  4179:     ;
02:00047FBC 41EC04BF        	  4180:     lea     ($04BF,A4),A0
02:00047FC0 10302000        	  4181:     move.b  (A0,D2.W),D0
02:00047FC4 02000010        	  4182:     andi.b #$10,D0
02:00047FC8 6702            	  4183:     beq.s  __far_z_07_0053
02:00047FCA 60C8            	  4184:     jmp  Reverse
                            	  4185: __far_z_07_0053:
                            	  4186:     even
