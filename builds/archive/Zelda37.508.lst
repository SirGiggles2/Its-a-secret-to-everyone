                            	   745: ;==============================================================================
                            	   746: ; change_song — ported from @ChangeSong
                            	   747: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   748: ;
                            	   749: ; Selects the starting phrase index for the new song, then falls into
                            	   750: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   751: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   752: ;==============================================================================
                            	   753: change_song:
02:00000778 4A00            	   754:     tst.b   D0
02:0000077A 6B46            	   755:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:0000077C B03C0006        	   756:     cmp.b   #$06,D0
02:00000780 6610            	   757:     bne.s   .not_zelda
02:00000782 13FC002400FFE002	   758:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:0000078A 610000E0        	   759:     bsr     prep_phrase
02:0000078E 60000190        	   760:     bra     tick_sq1
                            	   761: .not_zelda:
02:00000792 B03C0001        	   762:     cmp.b   #$01,D0
02:00000796 6716            	   763:     beq.s   .first_ow
02:00000798 B03C0040        	   764:     cmp.b   #$40,D0
02:0000079C 671A            	   765:     beq.s   .first_uw
02:0000079E B03C0010        	   766:     cmp.b   #$10,D0
02:000007A2 6626            	   767:     bne     play_next_phrase            ; single-phrase song
02:000007A4 13FC001100FFE002	   768:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:000007AC 601C            	   769:     bra     play_next_phrase
                            	   770: .first_ow:
02:000007AE 13FC000800FFE002	   771:     move.b  #$08,(m_phrase).l
02:000007B6 6012            	   772:     bra     play_next_phrase
                            	   773: .first_uw:
02:000007B8 13FC000F00FFE002	   774:     move.b  #$0F,(m_phrase).l
02:000007C0 6008            	   775:     bra     play_next_phrase
                            	   776: .first_demo:
02:000007C2 13FC001900FFE002	   777:     move.b  #$19,(m_phrase).l
                            	   778:     bra     play_next_phrase
                            	   779: 
                            	   780: ;==============================================================================
                            	   781: ; play_next_phrase — ported from PlayNextPhrase
                            	   782: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   783: ; calls prep_phrase and falls into tick_sq1.
                            	   784: ;==============================================================================
                            	   785: play_next_phrase:
02:000007CA 103900FFE000    	   786:     move.b  (m_song).l,D0
02:000007D0 6B78            	   787:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:000007D2 B03C0001        	   788:     cmp.b   #$01,D0
02:000007D6 6758            	   789:     beq.s   .next_ow
02:000007D8 B03C0040        	   790:     cmp.b   #$40,D0
02:000007DC 6738            	   791:     beq.s   .next_uw
02:000007DE B03C0010        	   792:     cmp.b   #$10,D0
02:000007E2 6718            	   793:     beq.s   .next_ending
                            	   794:     ; Single-phrase song: find bit position, phrase = index
02:000007E4 7200            	   795:     moveq   #0,D1
02:000007E6 7400            	   796:     moveq   #0,D2
02:000007E8 1400            	   797:     move.b  D0,D2
                            	   798: .bitloop:
02:000007EA 5201            	   799:     addq.b  #1,D1
02:000007EC E20A            	   800:     lsr.b   #1,D2
02:000007EE 64FA            	   801:     bcc.s   .bitloop
02:000007F0 13C100FFE002    	   802:     move.b  D1,(m_phrase).l
02:000007F6 6174            	   803:     bsr     prep_phrase
02:000007F8 60000126        	   804:     bra     tick_sq1
                            	   805: .next_ending:
02:000007FC 523900FFE002    	   806:     addq.b  #1,(m_phrase).l
02:00000802 0C39001A00FFE002	   807:     cmpi.b  #$1A,(m_phrase).l
02:0000080A 665A            	   808:     bne.s   .prep_and_tick
02:0000080C 13FC001400FFE002	   809:     move.b  #$14,(m_phrase).l
02:00000814 60B4            	   810:     bra     play_next_phrase
                            	   811: .next_uw:
02:00000816 523900FFE002    	   812:     addq.b  #1,(m_phrase).l
02:0000081C 0C39001200FFE002	   813:     cmpi.b  #$12,(m_phrase).l
02:00000824 6640            	   814:     bne.s   .prep_and_tick
02:00000826 13FC000F00FFE002	   815:     move.b  #$0F,(m_phrase).l
02:0000082E 609A            	   816:     bra     play_next_phrase
                            	   817: .next_ow:
02:00000830 523900FFE002    	   818:     addq.b  #1,(m_phrase).l
02:00000836 0C39001000FFE002	   819:     cmpi.b  #$10,(m_phrase).l
02:0000083E 6626            	   820:     bne.s   .prep_and_tick
02:00000840 13FC000900FFE002	   821:     move.b  #$09,(m_phrase).l
02:00000848 6080            	   822:     bra     play_next_phrase
                            	   823: .next_demo:
02:0000084A 523900FFE002    	   824:     addq.b  #1,(m_phrase).l
02:00000850 0C39002400FFE002	   825:     cmpi.b  #$24,(m_phrase).l
02:00000858 660C            	   826:     bne.s   .prep_and_tick
02:0000085A 13FC001900FFE002	   827:     move.b  #$19,(m_phrase).l
02:00000862 6000FF66        	   828:     bra     play_next_phrase
                            	   829: .prep_and_tick:
02:00000866 6104            	   830:     bsr     prep_phrase
02:00000868 600000B6        	   831:     bra     tick_sq1
                            	   832: 
                            	   833: ;==============================================================================
                            	   834: ; prep_phrase — ported from PrepPhrase
                            	   835: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   836: ;==============================================================================
                            	   837: prep_phrase:
02:0000086C 43F900000E96    	   838:     lea     (MusicBlob).l,A1
02:00000872 7200            	   839:     moveq   #0,D1
02:00000874 123900FFE002    	   840:     move.b  (m_phrase).l,D1
02:0000087A 5341            	   841:     subq.w  #1,D1
02:0000087C 12311000        	   842:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:00000880 024100FF        	   843:     andi.w  #$FF,D1
                            	   844: 
                            	   845:     ; byte 0: NoteLengthTableBase
02:00000884 13F1100000FFE003	   846:     move.b  (A1,D1.w),(m_len_base).l
02:0000088C 5241            	   847:     addq.w  #1,D1
                            	   848:     ; byte 1: script ptr lo
02:0000088E 7400            	   849:     moveq   #0,D2
02:00000890 14311000        	   850:     move.b  (A1,D1.w),D2
02:00000894 5241            	   851:     addq.w  #1,D1
                            	   852:     ; byte 2: script ptr hi
02:00000896 7600            	   853:     moveq   #0,D3
02:00000898 16311000        	   854:     move.b  (A1,D1.w),D3
02:0000089C 5241            	   855:     addq.w  #1,D1
02:0000089E E14B            	   856:     lsl.w   #8,D3
02:000008A0 8642            	   857:     or.w    D2,D3                        ; D3 = NES CPU address
02:000008A2 967C8D60        	   858:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:000008A6 02830000FFFF    	   859:     andi.l  #$FFFF,D3
02:000008AC 41F900000E96    	   860:     lea     (MusicBlob).l,A0
02:000008B2 D1C3            	   861:     adda.l  D3,A0                        ; A0 = M68K script base
02:000008B4 23C800FFE008    	   862:     move.l  A0,(m_script_ptr).l
                            	   863: 
                            	   864:     ; byte 3: NoteOffsetSongTrg
02:000008BA 13F1100000FFE01C	   865:     move.b  (A1,D1.w),(m_trg_off).l
02:000008C2 5241            	   866:     addq.w  #1,D1
                            	   867:     ; byte 4: NoteOffsetSongSq0
02:000008C4 13F1100000FFE014	   868:     move.b  (A1,D1.w),(m_sq0_off).l
02:000008CC 5241            	   869:     addq.w  #1,D1
                            	   870:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:000008CE 13F1100000FFE024	   871:     move.b  (A1,D1.w),(m_noise_off).l
02:000008D6 13F1100000FFE006	   872:     move.b  (A1,D1.w),(m_noise_first).l
02:000008DE 5241            	   873:     addq.w  #1,D1
                            	   874:     ; byte 6: SongEnvelopeSelector
02:000008E0 13F1100000FFE004	   875:     move.b  (A1,D1.w),(m_env_sel).l
02:000008E8 5241            	   876:     addq.w  #1,D1
                            	   877:     ; byte 7: mystery
02:000008EA 13F1100000FFE005	   878:     move.b  (A1,D1.w),(m_mystery).l
                            	   879: 
                            	   880:     ; Reset counters and Sq1 offset
02:000008F2 13FC000100FFE00D	   881:     move.b  #1,(m_sq1_cnt).l
02:000008FA 13FC000100FFE015	   882:     move.b  #1,(m_sq0_cnt).l
02:00000902 13FC000100FFE01D	   883:     move.b  #1,(m_trg_cnt).l
02:0000090A 13FC000100FFE025	   884:     move.b  #1,(m_noise_cnt).l
02:00000912 423900FFE00C    	   885:     clr.b   (m_sq1_off).l
02:00000918 423900FFE021    	   886:     clr.b   (m_trg_rep_n).l
02:0000091E 4E75            	   887:     rts
                            	   888: 
                            	   889: ;==============================================================================
                            	   890: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   891: ;==============================================================================
                            	   892: tick_sq1:
02:00000920 533900FFE00D    	   893:     subq.b  #1,(m_sq1_cnt).l
02:00000926 66000116        	   894:     bne     tick_sq0                     ; no new note
                            	   895: .read:
02:0000092A 207900FFE008    	   896:     move.l  (m_script_ptr).l,A0
02:00000930 7200            	   897:     moveq   #0,D1
02:00000932 123900FFE00C    	   898:     move.b  (m_sq1_off).l,D1
02:00000938 523900FFE00C    	   899:     addq.b  #1,(m_sq1_off).l
02:0000093E 10301000        	   900:     move.b  (A0,D1.w),D0
02:00000942 673A            	   901:     beq.s   .song_ended
02:00000944 4A00            	   902:     tst.b   D0
02:00000946 6B02            	   903:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:00000948 6022            	   904:     bra.s   .play_note
                            	   905: .prep_then_note:
02:0000094A 61000284        	   906:     bsr     get_song_note_length         ; D0 in → D0 length
02:0000094E 13C000FFE00E    	   907:     move.b  D0,(m_sq1_len).l
02:00000954 207900FFE008    	   908:     move.l  (m_script_ptr).l,A0
02:0000095A 7200            	   909:     moveq   #0,D1
02:0000095C 123900FFE00C    	   910:     move.b  (m_sq1_off).l,D1
02:00000962 523900FFE00C    	   911:     addq.b  #1,(m_sq1_off).l
02:00000968 10301000        	   912:     move.b  (A0,D1.w),D0
                            	   913: .play_note:
02:0000096C 6100027C        	   914:     bsr     emit_note_sq1                 ; D0 = note id
02:00000970 13F900FFE00E00FF	   915:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:00000978 E00D
02:0000097A 600000C2        	   916:     bra     tick_sq0
                            	   917: .song_ended:
02:0000097E 13FC000100FFE02B	   918:     move.b  #1,(m_song_loop_pending).l   ; signal loop point to C poller
02:00000986 103900FFE000    	   919:     move.b  (m_song).l,D0
02:0000098C 020000F1        	   920:     andi.b  #$F1,D0
02:00000990 6604            	   921:     bne.s   .play_again
02:00000992 60000430        	   922:     bra     music_silence
                            	   923: .play_again:
02:00000996 6102            	   924:     bsr     play_next_phrase_no_tick
02:00000998 6090            	   925:     bra.s   .read
                            	   926: 
                            	   927: ;----------------------------------------------------------------------
                            	   928: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   929: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   930: ; to restart a looping song when $00 opcode is read.
                            	   931: ;----------------------------------------------------------------------
                            	   932: play_next_phrase_no_tick:
02:0000099A 103900FFE000    	   933:     move.b  (m_song).l,D0
02:000009A0 6B7E            	   934:     bmi     .nsp_demo
02:000009A2 B03C0001        	   935:     cmp.b   #$01,D0
02:000009A6 675A            	   936:     beq     .nsp_ow
02:000009A8 B03C0040        	   937:     cmp.b   #$40,D0
02:000009AC 6738            	   938:     beq     .nsp_uw
02:000009AE B03C0010        	   939:     cmp.b   #$10,D0
02:000009B2 6716            	   940:     beq     .nsp_ending
                            	   941:     ; single-phrase: rebuild phrase from bit
02:000009B4 7200            	   942:     moveq   #0,D1
02:000009B6 7400            	   943:     moveq   #0,D2
02:000009B8 1400            	   944:     move.b  D0,D2
                            	   945: .nsp_loop:
02:000009BA 5201            	   946:     addq.b  #1,D1
02:000009BC E20A            	   947:     lsr.b   #1,D2
02:000009BE 64FA            	   948:     bcc     .nsp_loop
02:000009C0 13C100FFE002    	   949:     move.b  D1,(m_phrase).l
02:000009C6 6000FEA4        	   950:     bra     prep_phrase
                            	   951: .nsp_ending:
02:000009CA 523900FFE002    	   952:     addq.b  #1,(m_phrase).l
02:000009D0 0C39001A00FFE002	   953:     cmpi.b  #$1A,(m_phrase).l
02:000009D8 6600FE92        	   954:     bne     prep_phrase
02:000009DC 13FC001400FFE002	   955:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:000009E4 60B4            	   956:     bra     play_next_phrase_no_tick
                            	   957: .nsp_uw:
02:000009E6 523900FFE002    	   958:     addq.b  #1,(m_phrase).l
02:000009EC 0C39001200FFE002	   959:     cmpi.b  #$12,(m_phrase).l
02:000009F4 6600FE76        	   960:     bne     prep_phrase
02:000009F8 13FC000F00FFE002	   961:     move.b  #$0F,(m_phrase).l
02:00000A00 6098            	   962:     bra     play_next_phrase_no_tick
                            	   963: .nsp_ow:
02:00000A02 523900FFE002    	   964:     addq.b  #1,(m_phrase).l
02:00000A08 0C39001000FFE002	   965:     cmpi.b  #$10,(m_phrase).l
02:00000A10 6600FE5A        	   966:     bne     prep_phrase
02:00000A14 13FC000900FFE002	   967:     move.b  #$09,(m_phrase).l
02:00000A1C 6000FF7C        	   968:     bra     play_next_phrase_no_tick
                            	   969: .nsp_demo:
02:00000A20 523900FFE002    	   970:     addq.b  #1,(m_phrase).l
02:00000A26 0C39002400FFE002	   971:     cmpi.b  #$24,(m_phrase).l
02:00000A2E 6600FE3C        	   972:     bne     prep_phrase
02:00000A32 13FC001900FFE002	   973:     move.b  #$19,(m_phrase).l
02:00000A3A 6000FF5E        	   974:     bra     play_next_phrase_no_tick
