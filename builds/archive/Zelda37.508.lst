02:0003E2C6 1883            	  3239:     move.b  D3,($0000,A4)
02:0003E2C8 163C00FF        	  3240:     move.b  #$FF,D3
02:0003E2CC 102C00EB        	  3241:     move.b  ($00EB,A4),D0
                            	  3242: _anon_z05_84:
02:0003E2D0 5203            	  3243:     addq.b  #1,D3
02:0003E2D2 41F900FF6BB2    	  3244:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E2D8 12303000        	  3245:     move.b  (A0,D3.W),D1
02:0003E2DC B001            	  3246:     cmp.b   D1,D0
02:0003E2DE 66F0            	  3247:     bne  _anon_z05_84
                            	  3248:     ; Add the value of the shortcut chosen to whatever index
                            	  3249:     ; the current room has in the array.
                            	  3250:     ;
                            	  3251:     ; This yields the index of one of the three shortcut rooms
                            	  3252:     ; after the current one.
                            	  3253:     ;
02:0003E2E0 1003            	  3254:     move.b  D3,D0
02:0003E2E2 023C00EE        	  3255:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E2E6 1214            	  3256:     move.b  ($0000,A4),D1
02:0003E2E8 D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:0003E2EA 02000003        	  3260:     andi.b #$03,D0
02:0003E2EE 7600            	  3261:     moveq   #0,D3
02:0003E2F0 1600            	  3262:     move.b  D0,D3
02:0003E2F2 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:0003E2F8 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
                            	  3266: ; A: destination room ID
                            	  3267: ;
                            	  3268:     even
