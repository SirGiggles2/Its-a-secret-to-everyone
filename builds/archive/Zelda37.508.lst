02:00038422 103C00A0        	   480:     move.b  #$A0,D0
02:00038426 41EC03BC        	   481:     lea     ($03BC,A4),A0
02:0003842A 11803000        	   482:     move.b  D0,(A0,D3.W)
                            	   483:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   484:     ;
02:0003842E 7051            	   485:     moveq   #81,D0
02:00038430 41EC0380        	   486:     lea     ($0380,A4),A0
02:00038434 11803000        	   487:     move.b  D0,(A0,D3.W)
                            	   488:     ; Make it autonomous (ready to update on its own).
                            	   489:     ;
02:00038438 7000            	   490:     moveq   #0,D0
02:0003843A 41EC0405        	   491:     lea     ($0405,A4),A0
02:0003843E 11803000        	   492:     move.b  D0,(A0,D3.W)
                            	   493:     ; The first animation frame lasts 3 screen frames.
                            	   494:     ;
02:00038442 7003            	   495:     moveq   #3,D0
02:00038444 41EC03D0        	   496:     lea     ($03D0,A4),A0
02:00038448 11803000        	   497:     move.b  D0,(A0,D3.W)
                            	   498:     ; Have the monster wait a random amount of time, up to $3F frames.
                            	   499:     ;
02:0003844C 10342018        	   500:     move.b  ($18,A4,D2.W),D0
02:00038450 0200003F        	   501:     andi.b #$3F,D0
02:00038454 19802028        	   502:     move.b  D0,($28,A4,D2.W)
