                            	  2413: UpdatePondFairy:
02:0003917C 610031C0        	  2414:     jsr     DrawFairy
                            	  2415:     ; If not in state 0, then go handle states 1 to 3.
                            	  2416:     ;
02:00039180 102C00AD        	  2417:     move.b  ($00AD,A4),D0
02:00039184 6702            	  2418:     beq.s  __far_z_04_0020
02:00039186 602A            	  2419:     jmp  PondFairy_HandleOtherStates
                            	  2420: __far_z_04_0020:
                            	  2421:     ; State 0.
                            	  2422:     ;
                            	  2423:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2424:     ;
02:00039188 102C0084        	  2425:     move.b  ($0084,A4),D0
02:0003918C 0C0000AD        	  2426:     cmpi.b  #$AD,D0
02:00039190 661E            	  2427:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2428:     ; If Link's X < $70 or >= $81, then return.
                            	  2429:     ;
02:00039192 102C0070        	  2430:     move.b  ($0070,A4),D0
02:00039196 0C000070        	  2431:     cmpi.b  #$70,D0
02:0003919A 6514            	  2432:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003919C 0C000081        	  2433:     cmpi.b  #$81,D0
02:000391A0 640E            	  2434:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2435:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2436:     ; halt Link, and start filling hearts.
                            	  2437:     ;
