02:0000E6A0 02450003        	  1075:     andi.w  #$0003,D5
02:0000E6A4 EB4D            	  1076:     lsl.w   #5,D5
02:0000E6A6 E14D            	  1077:     lsl.w   #8,D5
02:0000E6A8 5442            	  1078:     addq.w  #2,D2
02:0000E6AA 610002D8        	  1079:     bsr     _attr_write_2x2
02:0000E6AE 5542            	  1080:     subq.w  #2,D2
                            	  1081: 
