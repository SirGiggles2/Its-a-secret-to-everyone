                            	   410:     ;
02:000383A2 7600            	   411:     moveq   #0,D3
02:000383A4 41EC034F        	   412:     lea     ($034F,A4),A0
02:000383A8 16302000        	   413:     move.b  (A0,D2.W),D3
02:000383AC 0C030005        	   414:     cmpi.b  #$05,D3
02:000383B0 671C            	   415:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShoot
                            	   416:     ; If it's not a red goriya either, then return.
                            	   417:     ;
02:000383B2 0C030006        	   418:     cmpi.b  #$06,D3
02:000383B6 660000A0        	   419:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   420:     ; If a random value <> $23 nor $77, then return.
                            	   421:     ;
02:000383BA 10342018        	   422:     move.b  ($18,A4,D2.W),D0
02:000383BE 0C000023        	   423:     cmpi.b  #$23,D0
02:000383C2 6708            	   424:     beq  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_CheckTimerToShootBoomerang
02:000383C4 0C000077        	   425:     cmpi.b  #$77,D0
