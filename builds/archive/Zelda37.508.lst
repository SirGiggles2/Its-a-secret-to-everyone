02:0003A57C 103C0080        	  5177:     move.b  #$80,D0
02:0003A580 6100DCF4        	  5178:     jsr     UpdateCommonWanderer
02:0003A584 4EB900031200    	  5179:     jsr     CheckMonsterCollisions
                            	  5180:     ; Darknuts are never stunned.
                            	  5181:     ;
02:0003A58A 7000            	  5182:     moveq   #0,D0
02:0003A58C 1980203D        	  5183:     move.b  D0,($3D,A4,D2.W)
02:0003A590 7008            	  5184:     moveq   #8,D0
02:0003A592 4EB900049102    	  5185:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  5186:     ; If facing left, then enable horizontal flipping.
                            	  5187:     ;
02:0003A598 41EC0098        	  5188:     lea     ($0098,A4),A0
02:0003A59C 10302000        	  5189:     move.b  (A0,D2.W),D0
02:0003A5A0 0C000002        	  5190:     cmpi.b  #$02,D0
02:0003A5A4 6604            	  5191:     bne  _anon_z04_94
02:0003A5A6 522C000F        	  5192:     addq.b  #1,($000F,A4)
                            	  5193: _anon_z04_94:
                            	  5194:     ; Shift right 2, yielding: 2 up, 1 down, 0 horizontal
                            	  5195:     ; This is the base frame image.
                            	  5196:     ;
02:0003A5AA E208            	  5197:     lsr.b  #1,D0   ; LSR A
02:0003A5AC E208            	  5198:     lsr.b  #1,D0   ; LSR A
                            	  5199:     ; If movement frame = 1, add 3 to frame image to access
                            	  5200:     ; the second animation frame's images.
                            	  5201:     ;
02:0003A5AE 7600            	  5202:     moveq   #0,D3
02:0003A5B0 41EC03E4        	  5203:     lea     ($03E4,A4),A0
02:0003A5B4 16302000        	  5204:     move.b  (A0,D2.W),D3
02:0003A5B8 671E            	  5205:     beq  _anon_z04_95
02:0003A5BA 023C00EE        	  5206:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A5BE 123C0003        	  5207:     move.b  #$03,D1
02:0003A5C2 D101            	  5208:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  5209:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  5210:     ;
                            	  5211:     ; Down has two frame images, but up only has one. By flipping
                            	  5212:     ; horizontally, you get two frame images.
                            	  5213:     ;
02:0003A5C4 7600            	  5214:     moveq   #0,D3
02:0003A5C6 41EC0098        	  5215:     lea     ($0098,A4),A0
02:0003A5CA 16302000        	  5216:     move.b  (A0,D2.W),D3
02:0003A5CE 0C030008        	  5217:     cmpi.b  #$08,D3
02:0003A5D2 6604            	  5218:     bne  _anon_z04_95
02:0003A5D4 522C000F        	  5219:     addq.b  #1,($000F,A4)
