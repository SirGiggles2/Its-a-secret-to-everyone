02:00039272 19802070        	  2584:     move.b  D0,($70,A4,D2.W)
                            	  2585:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  2586:     ;
02:00039276 102C0085        	  2587:     move.b  ($0085,A4),D0
02:0003927A 003C0011        	  2588:     ori     #$11,CCR  ; SEC: set C+X
02:0003927E 123C001C        	  2589:     move.b  #$1C,D1
02:00039282 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00039286 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:00039288 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:0003928C 41EC0084        	  2593:     lea     ($0084,A4),A0
02:00039290 11802000        	  2594:     move.b  D0,(A0,D2.W)
                            	  2595:     even
                            	  2596: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  2597:     ; Decrease the angle by $00.60.
