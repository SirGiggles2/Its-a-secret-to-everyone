02:00034FDE 162C0413        	  4501:     move.b  ($0413,A4),D3
02:00034FE2 41F900034F7C    	  4502:     lea     (PeaceText).l,A0
02:00034FE8 10303000        	  4503:     move.b  (A0,D3.W),D0
02:00034FEC 0C0000FF        	  4504:     cmpi.b  #$FF,D0
02:00034FF0 6730            	  4505:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:00034FF2 19400305        	  4506:     move.b  D0,($0305,A4)
                            	  4507:     ; A regular space takes as much time to emit as any character.
                            	  4508:     ; But it makes no sound.
                            	  4509:     ;
