                            	  5808:     ;
02:00048ACE 194003D0        	  5809:     move.b  D0,($03D0,A4)
02:00048AD2 41EC03D0        	  5810:     lea     ($03D0,A4),A0
02:00048AD6 11802000        	  5811:     move.b  D0,(A0,D2.W)
                            	  5812:     ; Go to the next state.
                            	  5813:     ;
02:00048ADA 41EC00AC        	  5814:     lea     ($00AC,A4),A0
02:00048ADE 52302000        	  5815:     addq.b  #1,(A0,D2.W)
                            	  5816:     ; Once we reach state 6, deactivate the object.
                            	  5817:     ; Otherwise, go draw it.
                            	  5818:     ;
02:00048AE2 41EC00AC        	  5819:     lea     ($00AC,A4),A0
02:00048AE6 10302000        	  5820:     move.b  (A0,D2.W),D0
02:00048AEA 0200000F        	  5821:     andi.b #$0F,D0
02:00048AEE 0C000006        	  5822:     cmpi.b  #$06,D0
02:00048AF2 6506            	  5823:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
02:00048AF4 610001C2        	  5824:     jsr     ResetObjState
                            	  5825:     even
