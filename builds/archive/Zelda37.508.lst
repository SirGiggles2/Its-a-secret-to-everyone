02:0004968C 41F90004917C    	  7300:     lea     (ObjectTypeToAttributes).l,A0
02:00049692 10303000        	  7301:     move.b  (A0,D3.W),D0
02:00049696 41EC04BF        	  7302:     lea     ($04BF,A4),A0
02:0004969A 11802000        	  7303:     move.b  D0,(A0,D2.W)
02:0004969E 1003            	  7304:     move.b  D3,D0
02:000496A0 1880            	  7305:     move.b  D0,($0000,A4)
                            	  7306:     ; Hit points are packed two values to a byte.
                            	  7307:     ; Divide the object type in half in order to index
                            	  7308:     ; into the hit points table.
                            	  7309:     ;
02:000496A2 E208            	  7310:     lsr.b  #1,D0   ; LSR A
02:000496A4 7600            	  7311:     moveq   #0,D3
02:000496A6 1600            	  7312:     move.b  D0,D3
02:000496A8 41F9000491DC    	  7313:     lea     (ObjectTypeToHpPairs).l,A0
02:000496AE 10303000        	  7314:     move.b  (A0,D3.W),D0
02:000496B2 4EB90003C048    	  7315:     jsr     ExtractHitPointValue
02:000496B8 41EC0485        	  7316:     lea     ($0485,A4),A0
02:000496BC 11802000        	  7317:     move.b  D0,(A0,D2.W)
                            	  7318:     ; If the object is a cave, go initialize it.
