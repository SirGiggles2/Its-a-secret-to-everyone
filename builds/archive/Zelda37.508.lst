02:00038D32 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:00038D36 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
02:00038D38 102C0084        	  1789:     move.b  ($0084,A4),D0
02:00038D3C 023C00EE        	  1790:     andi    #$EE,CCR  ; CLC: clear C+X
02:00038D40 1214            	  1791:     move.b  ($0000,A4),D1
02:00038D42 D101            	  1792:     addx.b  D1,D0   ; ADC $00
                            	  1793:     ; Sanitize the Y coordinate:
                            	  1794:     ; (Y AND $F0) OR $D
