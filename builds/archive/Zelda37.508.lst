02:00041834 101D            	  8583:     move.b  (A5)+,D0  ; PLA
02:00041836 7600            	  8584:     moveq   #0,D3
02:00041838 1600            	  8585:     move.b  D0,D3
                            	  8586:     ; The map marks are arranged in the same order as all the
                            	  8587:     ; possible values of OpenDoorMask.
                            	  8588:     ;
                            	  8589:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8590:     ; dynamic transfer buf at the current offset.
                            	  8591:     ;
02:0004183A 102C033F        	  8592:     move.b  ($033F,A4),D0
02:0004183E 023C00EE        	  8593:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041842 123C00E2        	  8594:     move.b  #$E2,D1
02:00041846 D101            	  8595:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00041848 41EC0304        	  8596:     lea     ($0304,A4),A0
02:0004184C 11803000        	  8597:     move.b  D0,(A0,D3.W)
02:00041850 4E75            	  8598:     rts
                            	  8599: 
                            	  8600: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8601: ; based on doorway type and room flags. Each call will shift the next
                            	  8602: ; doorway state bit into OpenDoorwayMask.
                            	  8603: ;
                            	  8604: ; Params:
                            	  8605: ; A: door attribute
                            	  8606: ; X: direction index
                            	  8607: ;
                            	  8608: ; Returns:
                            	  8609: ; A: untouched
                            	  8610: ;
                            	  8611:     even
