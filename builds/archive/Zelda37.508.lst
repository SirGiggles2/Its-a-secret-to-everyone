02:000391A6 7040            	  2439:     moveq   #64,D0
02:000391A8 194000AC        	  2440:     move.b  D0,($00AC,A4)
02:000391AC 19400063        	  2441:     move.b  D0,($0063,A4)
                            	  2442:     even
                            	  2443: _L_z04_UpdatePondFairy_Exit:
02:000391B0 4E75            	  2444:     rts
                            	  2445: 
                            	  2446:     even
                            	  2447: PondFairy_HandleOtherStates:
02:000391B2 0C000001        	  2448:     cmpi.b  #$01,D0
02:000391B6 6610            	  2449:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2450:     ; State 1. Flying and filling hearts.
                            	  2451:     ;
                            	  2452:     ; If still filling hearts, then go draw Link and hearts.
                            	  2453:     ;
02:000391B8 102C0063        	  2454:     move.b  ($0063,A4),D0
02:000391BC 6620            	  2455:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2456:     ; If not filling hearts anymore, then go to state 2,
                            	  2457:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2458:     ; a little while after we finish filling hearts.
                            	  2459:     ;
02:000391BE 522C00AD        	  2460:     addq.b  #1,($00AD,A4)
02:000391C2 7050            	  2461:     moveq   #80,D0
02:000391C4 19400029        	  2462:     move.b  D0,($0029,A4)
                            	  2463:     even
                            	  2464: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2465:     ; If state <> 2 (so, it's 3), then return.
                            	  2466:     ;
                            	  2467:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2468:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2469:     ; was set to, and we'll return.
                            	  2470:     ;
02:000391C8 0C000002        	  2471:     cmpi.b  #$02,D0
02:000391CC 6634            	  2472:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2473:     ; State = 2.
                            	  2474:     ;
                            	  2475:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2476:     ;
02:000391CE 102C0029        	  2477:     move.b  ($0029,A4),D0
02:000391D2 660A            	  2478:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2479:     ; Else go to state 3, and unhalt Link.
                            	  2480:     ;
02:000391D4 522C00AD        	  2481:     addq.b  #1,($00AD,A4)
02:000391D8 7000            	  2482:     moveq   #0,D0
02:000391DA 194000AC        	  2483:     move.b  D0,($00AC,A4)
                            	  2484:     even
                            	  2485: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  2486:     ; TODO: but why, since Link is halted?
                            	  2487:     ;
                            	  2488:     ; Reset the input direction, so that Link doesn't animate
                            	  2489:     ; when drawing him.
02:000391DE 7600            	  2490:     moveq   #0,D3
02:000391E0 194303F8        	  2491:     move.b  D3,($03F8,A4)
                            	  2492:     ; Save and reset Link's state.
                            	  2493:     ;
                            	  2494:     ; TODO: but why, since Link is halted?
                            	  2495:     ;
02:000391E4 102C00AC        	  2496:     move.b  ($00AC,A4),D0
02:000391E8 1B00            	  2497:     move.b  D0,-(A5)  ; PHA
02:000391EA 194300AC        	  2498:     move.b  D3,($00AC,A4)
02:000391EE 4EB9000480AC    	  2499:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  2500:     ; Restore Link's state.
                            	  2501:     ;
