                            	  5830: _L_z07_UpdateSwordOrRod_DrawSwordOrRod:
                            	  5831:     ; Reset horizontal flipping in [0F].
                            	  5832:     ;
02:00048AFA 7000            	  5833:     moveq   #0,D0
02:00048AFC 1940000F        	  5834:     move.b  D0,($000F,A4)
                            	  5835:     ; If state = 5, return without drawing.
                            	  5836:     ;
02:00048B00 41EC00AC        	  5837:     lea     ($00AC,A4),A0
02:00048B04 10302000        	  5838:     move.b  (A0,D2.W),D0
02:00048B08 0200000F        	  5839:     andi.b #$0F,D0
02:00048B0C 7600            	  5840:     moveq   #0,D3
