                            	  4744: DrawCredits:
                            	  4745:     ; Make a transfer record of a full row of blank tiles.
                            	  4746:     ;
02:00035340 761F            	  4747:     moveq   #31,D3
02:00035342 7024            	  4748:     moveq   #36,D0
                            	  4749: _anon_z02_41:
02:00035344 41EC0305        	  4750:     lea     ($0305,A4),A0
02:00035348 11803000        	  4751:     move.b  D0,(A0,D3.W)
02:0003534C 5303            	  4752:     subq.b  #1,D3
02:0003534E 6AF4            	  4753:     bpl  _anon_z02_41
                            	  4754:     ; No wall tiles go in row 0.
                            	  4755:     ;
02:00035350 102C050A        	  4756:     move.b  ($050A,A4),D0
02:00035354 672C            	  4757:     beq  _L_z02_DrawCredits_TerminateRecords
                            	  4758:     ; Rows 1 and $2E get horizontal wall tiles.
                            	  4759:     ; Rows 2 to $2D get side walls.
                            	  4760:     ;
02:00035356 0C000001        	  4761:     cmpi.b  #$01,D0
02:0003535A 6708            	  4762:     beq  _L_z02_DrawCredits_WriteHorizontalWalls
02:0003535C 0C00002E        	  4763:     cmpi.b  #$2E,D0
02:00035360 6514            	  4764:     bcs  _L_z02_DrawCredits_WriteSideWalls
02:00035362 661E            	  4765:     bne  _L_z02_DrawCredits_TerminateRecords
                            	  4766:     even
                            	  4767: _L_z02_DrawCredits_WriteHorizontalWalls:
02:00035364 7619            	  4768:     moveq   #25,D3
02:00035366 103C00FA        	  4769:     move.b  #$FA,D0
                            	  4770: _anon_z02_42:
02:0003536A 41EC0308        	  4771:     lea     ($0308,A4),A0
02:0003536E 11803000        	  4772:     move.b  D0,(A0,D3.W)
02:00035372 5303            	  4773:     subq.b  #1,D3
02:00035374 6AF4            	  4774:     bpl  _anon_z02_42
