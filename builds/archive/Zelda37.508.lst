                            	  1711:     even
                            	  1712: _bank_rom_bases:
02:0002AA6A 0000EA6A        	  1713:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0002AA6E 00012A6A
02:0002AA72 00016A6A        	  1714:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0002AA76 0001AA6A
