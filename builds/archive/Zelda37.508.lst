02:0003BDBA 1B00            	  8417:     move.b  D0,-(A5)  ; PHA
                            	  8418:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	  8419:     ;
02:0003BDBC 7402            	  8420:     moveq   #2,D2
                            	  8421:     even
                            	  8422: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003BDBE 19420340        	  8423:     move.b  D2,($0340,A4)
                            	  8424:     ; If object slot < 5 or = 7, then move every frame.
                            	  8425:     ; Else move 3 out of every 4 frames.
                            	  8426:     ;
                            	  8427:     ; This makes pieces spread out in somewhat of a circle,
                            	  8428:     ; by making the pieces at cardinal directions move at
                            	  8429:     ; full speed while the diagonal ones move a little slower.
                            	  8430:     ;
02:0003BDC2 0C020005        	  8431:     cmpi.b  #$05,D2
02:0003BDC6 6510            	  8432:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003BDC8 0C020007        	  8433:     cmpi.b  #$07,D2
02:0003BDCC 670A            	  8434:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003BDCE 102C0015        	  8435:     move.b  ($0015,A4),D0
02:0003BDD2 02000003        	  8436:     andi.b #$03,D0
02:0003BDD6 6704            	  8437:     beq  _anon_z04_164
                            	  8438:     even
                            	  8439: _L_z04_Ganon_DrawBurst_Move:
02:0003BDD8 6100EDA2        	  8440:     jsr     BlueWizzrobe_Move
                            	  8441: _anon_z04_164:
02:0003BDDC 4EB900049108    	  8442:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  8443:     ; The frame counter will make the sprite flash.
                            	  8444:     ; The array has the horizontal and vertical flipping attributes.
                            	  8445:     ; Combine them into [03].
                            	  8446:     ;
02:0003BDE2 102C0015        	  8447:     move.b  ($0015,A4),D0
02:0003BDE6 02000003        	  8448:     andi.b #$03,D0
02:0003BDEA 41F90003BCBA    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003BDF0 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0003BDF4 8001            	  8451:     or.b  D1,D0
02:0003BDF6 19400003        	  8452:     move.b  D0,($0003,A4)
02:0003BDFA 41F90003BCC4    	  8453:     lea     (GanonBurstTiles).l,A0
02:0003BE00 10302000        	  8454:     move.b  (A0,D2.W),D0
02:0003BE04 4EB900031190    	  8455:     jsr     Anim_WriteSprite
                            	  8456:     ; Bottom of the loop.
