                            	  2712: Link_FilterInput:
                            	  2713:     ; [00] holds the opposite of Link's facing direction.
                            	  2714:     ;
02:0003DF64 102C0098        	  2715:     move.b  ($0098,A4),D0
02:0003DF68 4EB900030AC4    	  2716:     jsr     GetOppositeDir
02:0003DF6E 1880            	  2717:     move.b  D0,($0000,A4)
                            	  2718:     ; Call GetOppositeDir again to use this mapping:
                            	  2719:     ; In Dir: 1 2 4 8
                            	  2720:     ;         -------
                            	  2721:     ; Index:  2 3 0 1
                            	  2722:     ;
02:0003DF70 4EB900030AC4    	  2723:     jsr     GetOppositeDir
                            	  2724:     ; Get the appropriate coordinate for the direction:
                            	  2725:     ; X for horizontal
                            	  2726:     ; Y for vertical
                            	  2727:     ;
02:0003DF76 102C0070        	  2728:     move.b  ($0070,A4),D0
02:0003DF7A 0C030002        	  2729:     cmpi.b  #$02,D3
02:0003DF7E 6404            	  2730:     bcc  _anon_z05_74
02:0003DF80 102C0084        	  2731:     move.b  ($0084,A4),D0
                            	  2732: _anon_z05_74:
02:0003DF84 19400002        	  2733:     move.b  D0,($0002,A4)
                            	  2734:     ; Mask A button and directions if inner border is crossed.
                            	  2735:     ;
02:0003DF88 1003            	  2736:     move.b  D3,D0
02:0003DF8A 1B00            	  2737:     move.b  D0,-(A5)  ; PHA
02:0003DF8C 023C00EE        	  2738:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DF90 123C0008        	  2739:     move.b  #$08,D1
02:0003DF94 D101            	  2740:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003DF96 7600            	  2741:     moveq   #0,D3
02:0003DF98 1600            	  2742:     move.b  D0,D3
02:0003DF9A 103C0080        	  2743:     move.b  #$80,D0
02:0003DF9E 6134            	  2744:     jsr     MaskInputInBorder
02:0003DFA0 101D            	  2745:     move.b  (A5)+,D0  ; PLA
02:0003DFA2 7600            	  2746:     moveq   #0,D3
02:0003DFA4 1600            	  2747:     move.b  D0,D3
                            	  2748:     ; If inner boundary was not crossed, then we'll check the outer
                            	  2749:     ; boundary using player's direction and reverse direction index.
                            	  2750:     ;
02:0003DFA6 102C0001        	  2751:     move.b  ($0001,A4),D0
02:0003DFAA 0C0000FF        	  2752:     cmpi.b  #$FF,D0
02:0003DFAE 660C            	  2753:     bne  _anon_z05_75
02:0003DFB0 102C0098        	  2754:     move.b  ($0098,A4),D0
02:0003DFB4 1880            	  2755:     move.b  D0,($0000,A4)
02:0003DFB6 4EB900030AC4    	  2756:     jsr     GetOppositeDir
                            	  2757: _anon_z05_75:
                            	  2758:     ; If in UW, use the second set of bounds by adding 4
                            	  2759:     ; to reverse direction index.
                            	  2760:     ;
                            	  2761:     ; Else in OW, and use first set that begins at offset 0.
                            	  2762:     ;
02:0003DFBC 102C0010        	  2763:     move.b  ($0010,A4),D0
02:0003DFC0 6710            	  2764:     beq  _anon_z05_76
02:0003DFC2 1003            	  2765:     move.b  D3,D0
02:0003DFC4 023C00EE        	  2766:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003DFC8 123C0004        	  2767:     move.b  #$04,D1
02:0003DFCC D101            	  2768:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003DFCE 7600            	  2769:     moveq   #0,D3
02:0003DFD0 1600            	  2770:     move.b  D0,D3
                            	  2771: _anon_z05_76:
                            	  2772:     ; We won't mask buttons (A) this time. Only directions now.
                            	  2773:     ;
02:0003DFD2 7000            	  2774:     moveq   #0,D0
                            	  2775: ; Params:
                            	  2776: ; A: mask of buttons to block
                            	  2777: ; Y: offset into BorderBounds
                            	  2778: ; [00]: direction
                            	  2779: ; [02]: coordinate
                            	  2780: ;
                            	  2781: ; Returns:
                            	  2782: ; [01]: button mask that was used
                            	  2783: ;       (set to $FF if boundary not crossed)
                            	  2784: ;
                            	  2785:     even
                            	  2786: MaskInputInBorder:
02:0003DFD4 19400001        	  2787:     move.b  D0,($0001,A4)
                            	  2788:     ; If direction is positive (right or down), then go handle it separately.
                            	  2789:     ;
02:0003DFD8 1014            	  2790:     move.b  ($0000,A4),D0
02:0003DFDA 0200000A        	  2791:     andi.b #$0A,D0
02:0003DFDE 6748            	  2792:     beq  _L_z05_MaskInputInBorder_PositiveDir
                            	  2793:     ; The direction is negative (left or up).
                            	  2794:     ;
                            	  2795:     ; If the coordinate does not cross (<) the boundary, then
                            	  2796:     ; go set mask $FF, so that no button is excluded.
                            	  2797:     ;
02:0003DFE0 102C0002        	  2798:     move.b  ($0002,A4),D0
02:0003DFE4 41F90003DF58    	  2799:     lea     (BorderBounds).l,A0
02:0003DFEA 12303000        	  2800:     move.b  (A0,D3.W),D1
02:0003DFEE B001            	  2801:     cmp.b   D1,D0
02:0003DFF0 6548            	  2802:     bcs  _L_z05_MaskInputInBorder_ExcludeNone
                            	  2803:     even
                            	  2804: _L_z05_MaskInputInBorder_MaskButtons:
                            	  2805:     ; The boundary was crossed. Mask buttons.
                            	  2806:     ;
02:0003DFF2 102C00F8        	  2807:     move.b  ($00F8,A4),D0
02:0003DFF6 122C0001        	  2808:     move.b  ($0001,A4),D1
02:0003DFFA C001            	  2809:     and.b  D1,D0
02:0003DFFC 194000F8        	  2810:     move.b  D0,($00F8,A4)
                            	  2811:     ; If in OW or button mask <> 0, return.
                            	  2812:     ;
02:0003E000 102C0010        	  2813:     move.b  ($0010,A4),D0
02:0003E004 6720            	  2814:     beq  _L_z05_MaskInputInBorder_Exit
02:0003E006 102C0001        	  2815:     move.b  ($0001,A4),D0
02:0003E00A 661A            	  2816:     bne  _L_z05_MaskInputInBorder_Exit
                            	  2817:     ; Mask off input directions perpendicular to player's facing.
                            	  2818:     ;
02:0003E00C 760C            	  2819:     moveq   #12,D3
02:0003E00E 102C0098        	  2820:     move.b  ($0098,A4),D0
02:0003E012 0200000C        	  2821:     andi.b #$0C,D0
02:0003E016 6602            	  2822:     bne  _anon_z05_77
02:0003E018 7603            	  2823:     moveq   #3,D3
                            	  2824: _anon_z05_77:
02:0003E01A 1003            	  2825:     move.b  D3,D0
02:0003E01C 122C03F8        	  2826:     move.b  ($03F8,A4),D1
02:0003E020 C001            	  2827:     and.b  D1,D0
02:0003E022 194003F8        	  2828:     move.b  D0,($03F8,A4)
                            	  2829:     even
                            	  2830: _L_z05_MaskInputInBorder_Exit:
02:0003E026 4E75            	  2831:     rts
                            	  2832: 
                            	  2833:     even
                            	  2834: _L_z05_MaskInputInBorder_PositiveDir:
                            	  2835:     ; The direction is positive.
                            	  2836:     ;
                            	  2837:     ; If the coordinate crosses (<) the boundary, then
                            	  2838:     ; go mask buttons.
                            	  2839:     ;
                            	  2840:     ;
                            	  2841:     ; Get coordinate in [02].
02:0003E028 102C0002        	  2842:     move.b  ($0002,A4),D0
02:0003E02C 41F90003DF58    	  2843:     lea     (BorderBounds).l,A0
02:0003E032 12303000        	  2844:     move.b  (A0,D3.W),D1
02:0003E036 B001            	  2845:     cmp.b   D1,D0
02:0003E038 65B8            	  2846:     bcs  _L_z05_MaskInputInBorder_MaskButtons
                            	  2847:     even
                            	  2848: _L_z05_MaskInputInBorder_ExcludeNone:
                            	  2849:     ; The coordinate is not crossed; then set mask $FF,
                            	  2850:     ; so that no button is excluded.
                            	  2851:     ;
02:0003E03A 103C00FF        	  2852:     move.b  #$FF,D0
02:0003E03E 19400001        	  2853:     move.b  D0,($0001,A4)
                            	  2854:     even
