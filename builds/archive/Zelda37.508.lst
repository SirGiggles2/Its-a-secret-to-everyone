02:0003BD6E 61A0            	  8389:     jsr     Ganon_DrawCloud
02:0003BD70 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0003BD74 619A            	  8391:     jsr     Ganon_DrawCloud
02:0003BD76 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
02:0003BD7A 610000B4        	  8393:     jsr     Ganon_GetCurCloudBottom
02:0003BD7E 6190            	  8394:     jsr     Ganon_DrawCloud
02:0003BD80 610000A2        	  8395:     jsr     Ganon_GetCurCloudRight
