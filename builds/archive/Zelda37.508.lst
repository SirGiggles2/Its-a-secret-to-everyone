02:0002CFBC 242F000C        	  4766:     move.l  12(SP),D2       ; arg2 = slot
02:0002CFC0 4EB90003C2A4    	  4767:     jsr     _ShootIfWanted
02:0002CFC6 640C            	  4768:     bcc.s   .csiw_fail
02:0002CFC8 7000            	  4769:     moveq   #0,D0
02:0002CFCA 1003            	  4770:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:0002CFCC 008000000100    	  4771:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:0002CFD2 6002            	  4772:     bra.s   .csiw_done
