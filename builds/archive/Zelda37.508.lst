                            	  7086:     ; We want to handle "enemies from the edges of the screen".
                            	  7087:     ;
                            	  7088:     ; So, if not in UW, or "enemies from edges" attribute is clear,
                            	  7089:     ; or the object is (zora, fire, armos, whirlwind), or any object
                            	  7090:     ; that does not spawn with a cloud (type >= $53);
                            	  7091:     ; 
                            	  7092:     ; then go initialize the object.
                            	  7093:     ;
02:000494C2 102C0010        	  7094:     move.b  ($0010,A4),D0
02:000494C6 66000196        	  7095:     bne  _L_z07_InitObject_NormalSpawn
02:000494CA 102C04CD        	  7096:     move.b  ($04CD,A4),D0
02:000494CE 02000008        	  7097:     andi.b #$08,D0
02:000494D2 6700018A        	  7098:     beq  _L_z07_InitObject_NormalSpawn
02:000494D6 41EC034F        	  7099:     lea     ($034F,A4),A0
02:000494DA 10302000        	  7100:     move.b  (A0,D2.W),D0
02:000494DE 0C000011        	  7101:     cmpi.b  #$11,D0
02:000494E2 6700017A        	  7102:     beq  _L_z07_InitObject_NormalSpawn
02:000494E6 0C000040        	  7103:     cmpi.b  #$40,D0
02:000494EA 67000172        	  7104:     beq  _L_z07_InitObject_NormalSpawn
02:000494EE 0C00001E        	  7105:     cmpi.b  #$1E,D0
02:000494F2 6700016A        	  7106:     beq  _L_z07_InitObject_NormalSpawn
02:000494F6 0C00002E        	  7107:     cmpi.b  #$2E,D0
02:000494FA 67000162        	  7108:     beq  _L_z07_InitObject_NormalSpawn
02:000494FE 0C000053        	  7109:     cmpi.b  #$53,D0
02:00049502 6400015A        	  7110:     bcc  _L_z07_InitObject_NormalSpawn
                            	  7111:     even
                            	  7112: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7113:     ; If the "monsters from edges" long timer expired, then
                            	  7114:     ; go bring the monster in.
                            	  7115:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7116:     ;
                            	  7117:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7118:     ; residual position so enemies keep their previous-room
                            	  7119:     ; positions instead of being re-edge-spawned (matches NES).
02:00049506 102C004B        	  7120:     move.b  ($004B,A4),D0
02:0004950A 662E            	  7121:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7122:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004950C 102C000F        	  7123:     move.b  ($000F,A4),D0
02:00049510 0C0000FF        	  7124:     cmpi.b  #$FF,D0
02:00049514 662E            	  7125:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:00049516 41EC0070        	  7126:     lea     ($0070,A4),A0
02:0004951A 10302000        	  7127:     move.b  (A0,D2.W),D0
02:0004951E 660A            	  7128:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:00049520 41EC0084        	  7129:     lea     ($0084,A4),A0
02:00049524 10302000        	  7130:     move.b  (A0,D2.W),D0
02:00049528 671A            	  7131:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7132:     even
