Source: "data\dmc_samples.inc"
                            	     1: ; dmc_samples.inc - auto-generated by tools/extract_dmc_samples.py
                            	     2: ; DO NOT EDIT BY HAND. Regenerate from Legend of Zelda, The (USA).nes.
                            	     3: ;
                            	     4: ; 7 DMC samples ripped from the stock NES ROM, available in two forms:
                            	     5: ;
                            	     6: ;   data/dmc_samples.bin     — raw DMC delta-PCM bytes. Kept for a
                            	     7: ;                              possible future true-NES-DMC emulation
                            	     8: ;                              path. The current Phase-C scaffold does
                            	     9: ;                              NOT consume this.
                            	    10: ;   data/dmc_samples_pcm.bin — decoded 8-bit unsigned linear PCM,
                            	    11: ;                              ready to stream byte-by-byte to YM2612
                            	    12: ;                              register $2A (DAC). Each delta byte
                            	    13: ;                              expands to 8 PCM bytes.
                            	    14: ;
                            	    15: ; Each sample's metadata matches the NES $4010/$4012/$4013 values so the
                            	    16: ; APU register stubs in nes_io.asm can look them up by 1-based index.
                            	    17: 
                            	    18: DMC_SAMPLE_COUNT    equ     7
                            	    19: 
                            	    20: ; --- Delta form (raw DMC bytes) ----------------------------------------
                            	    21: DMC_SFX_01_DELTA_OFF equ     $0000
                            	    22: DMC_SFX_01_DELTA_LEN equ     $0751
                            	    23: DMC_SFX_02_DELTA_OFF equ     $0751
                            	    24: DMC_SFX_02_DELTA_LEN equ     $0C01
