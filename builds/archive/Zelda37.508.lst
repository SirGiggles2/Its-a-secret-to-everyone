02:00038D44 020000F0        	  1796:     andi.b #$F0,D0
02:00038D48 0000000D        	  1797:     ori.b #$0D,D0
02:00038D4C 41EC0084        	  1798:     lea     ($0084,A4),A0
02:00038D50 11802000        	  1799:     move.b  D0,(A0,D2.W)
                            	  1800:     ; If Y coordinate >= $5D (top of the third square row), then
                            	  1801:     ; go see if the tile is valid to come out of.
                            	  1802:     ;
                            	  1803:     ; Else it's too close to the top edge of the screen. So, return.
                            	  1804:     ;
02:00038D54 0C00005D        	  1805:     cmpi.b  #$5D,D0
02:00038D58 647A            	  1806:     bcc  _L_z04_UpdateRedLeever_CheckSafeToSpawn
                            	  1807:     even
                            	  1808: _L_z04_UpdateRedLeever_Exit:
02:00038D5A 4E75            	  1809:     rts
                            	  1810: 
