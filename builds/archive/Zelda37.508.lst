                            	  4186: _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision:
                            	  4187:     ; Digdogger is big, but room boundary checks and
                            	  4188:     ; object collision checks assume a 16x16 monster or smaller.
                            	  4189:     ; Therefore, we have to check these things four times,
                            	  4190:     ; in different corners of the boss.
                            	  4191:     ;
                            	  4192:     ; Loop 4 times, from 0 to 3.
                            	  4193:     ;
02:00039DE8 7600            	  4194:     moveq   #0,D3
02:00039DEA 41EC0478        	  4195:     lea     ($0478,A4),A0
02:00039DEE 16302000        	  4196:     move.b  (A0,D2.W),D3
                            	  4197:     ; Change the coordinates to one corner.
                            	  4198:     ;
02:00039DF2 10342070        	  4199:     move.b  ($70,A4,D2.W),D0
02:00039DF6 023C00EE        	  4200:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039DFA 41F900039CAE    	  4201:     lea     (DigdoggerCornerOffsetsX).l,A0
02:00039E00 12303000        	  4202:     move.b  (A0,D3.W),D1
02:00039E04 D101            	  4203:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsX,Y
02:00039E06 19802070        	  4204:     move.b  D0,($70,A4,D2.W)
02:00039E0A 41EC0084        	  4205:     lea     ($0084,A4),A0
02:00039E0E 10302000        	  4206:     move.b  (A0,D2.W),D0
02:00039E12 023C00EE        	  4207:     andi    #$EE,CCR  ; CLC: clear C+X
02:00039E16 41F900039CB2    	  4208:     lea     (DigdoggerCornerOffsetsY).l,A0
02:00039E1C 12303000        	  4209:     move.b  (A0,D3.W),D1
02:00039E20 D101            	  4210:     addx.b  D1,D0   ; ADC DigdoggerCornerOffsetsY,Y
02:00039E22 41EC0084        	  4211:     lea     ($0084,A4),A0
02:00039E26 11802000        	  4212:     move.b  D0,(A0,D2.W)
                            	  4213:     ; Check the room boundary and object collisions in this temporary location.
                            	  4214:     ;
02:00039E2A 6100258E        	  4215:     jsr     BoundFlyer
02:00039E2E 4EB900031200    	  4216:     jsr     CheckMonsterCollisions
                            	  4217:     ; Increase the loop index, and loop again until it = 4.
                            	  4218:     ;
02:00039E34 41EC0478        	  4219:     lea     ($0478,A4),A0
02:00039E38 52302000        	  4220:     addq.b  #1,(A0,D2.W)
02:00039E3C 41EC0478        	  4221:     lea     ($0478,A4),A0
02:00039E40 10302000        	  4222:     move.b  (A0,D2.W),D0
02:00039E44 0C000004        	  4223:     cmpi.b  #$04,D0
02:00039E48 659E            	  4224:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  4225:     ; Restore the original coordinates.
                            	  4226:     ;
02:00039E4A 101D            	  4227:     move.b  (A5)+,D0  ; PLA
02:00039E4C 41EC0084        	  4228:     lea     ($0084,A4),A0
02:00039E50 11802000        	  4229:     move.b  D0,(A0,D2.W)
02:00039E54 101D            	  4230:     move.b  (A5)+,D0  ; PLA
02:00039E56 19802070        	  4231:     move.b  D0,($70,A4,D2.W)
