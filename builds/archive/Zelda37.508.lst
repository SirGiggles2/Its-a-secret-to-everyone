                            	  8046:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8047:     ; In this case, I think it means Ganon is shouting.
                            	  8048:     ;
02:0003BB30 0C000001        	  8049:     cmpi.b  #$01,D0
