02:0003BE14 19400340        	  8465:     move.b  D0,($0340,A4)
02:0003BE18 0A3C0001        	  8466:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003BE1C 4E75            	  8467:     rts
