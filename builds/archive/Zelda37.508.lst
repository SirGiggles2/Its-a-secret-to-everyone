02:0004854E 52302000        	  5027:     addq.b  #1,(A0,D2.W)
02:00048552 41EC00AC        	  5028:     lea     ($00AC,A4),A0
02:00048556 10302000        	  5029:     move.b  (A0,D2.W),D0
02:0004855A 0200000F        	  5030:     andi.b #$0F,D0
02:0004855E 0C000003        	  5031:     cmpi.b  #$03,D0
