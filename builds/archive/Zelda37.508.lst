                            	  1282:     ; PATCHED (P6): Replace broken NES indirect-pointer math with direct
                            	  1283:     ; M68K addressing. The original ADC #<label / ADC #>label that adds
                            	  1284:     ; DemoPhase0Subphase1Palettes base address was lost in transpilation.
02:00032F1A 7000            	  1285:     moveq   #0,D0
02:00032F1C 102C0437        	  1286:     move.b  ($0437,A4),D0        ; cycle index (0-13)
02:00032F20 EB48            	  1287:     lsl.w   #5,D0                ; * 32 = byte offset into palette table
02:00032F22 41F900032D04    	  1288:     lea     (DemoPhase0Subphase1Palettes).l,A0
02:00032F28 D0C0            	  1289:     adda.w  D0,A0                ; A0 -> palette for this cycle
                            	  1290:     ; Set up DynTileBuf header: $3F, $00, $20
02:00032F2A 197C003F0302    	  1291:     move.b  #$3F,($0302,A4)
02:00032F30 197C00000303    	  1292:     move.b  #$00,($0303,A4)
02:00032F36 7020            	  1293:     moveq   #32,D0
