02:0000E6B4 02450003        	  1085:     andi.w  #$0003,D5
02:0000E6B8 EB4D            	  1086:     lsl.w   #5,D5
02:0000E6BA E14D            	  1087:     lsl.w   #8,D5
02:0000E6BC 5443            	  1088:     addq.w  #2,D3
02:0000E6BE 610002C4        	  1089:     bsr     _attr_write_2x2
02:0000E6C2 5543            	  1090:     subq.w  #2,D3
                            	  1091: 
