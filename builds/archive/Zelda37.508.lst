                            	  8529: Submenu_WriteScanningMapRoomMark:
02:000417CE 1003            	  8530:     move.b  D3,D0
02:000417D0 1B00            	  8531:     move.b  D0,-(A5)  ; PHA
02:000417D2 61005808        	  8532:     jsr     GetRoomFlags
02:000417D6 102C00EB        	  8533:     move.b  ($00EB,A4),D0
02:000417DA 1B00            	  8534:     move.b  D0,-(A5)  ; PHA
                            	  8535:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8536:     ; in order to look up its information.
                            	  8537:     ;
02:000417DC 102C005D        	  8538:     move.b  ($005D,A4),D0
