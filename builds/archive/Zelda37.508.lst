                            	  4832: SpreadShot:
                            	  4833:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4834:     ;
                            	  4835:     ; The shot is spreading out.
                            	  4836:     ;
                            	  4837:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  4838:     ; These will be negated appropriately for each corner.
                            	  4839:     ;
02:00048410 41EC0098        	  4840:     lea     ($0098,A4),A0
02:00048414 10302000        	  4841:     move.b  (A0,D2.W),D0
02:00048418 19400002        	  4842:     move.b  D0,($0002,A4)
02:0004841C 19400003        	  4843:     move.b  D0,($0003,A4)
                            	  4844:     ; Reset [0F] to not flip horizontally.
                            	  4845:     ;
02:00048420 7000            	  4846:     moveq   #0,D0
02:00048422 1940000F        	  4847:     move.b  D0,($000F,A4)
                            	  4848:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  4849:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  4850:     ;
02:00048426 7603            	  4851:     moveq   #3,D3
                            	  4852:     even
                            	  4853: _L_z07_SpreadShot_DrawShotCorner:
02:00048428 1003            	  4854:     move.b  D3,D0
02:0004842A 1B00            	  4855:     move.b  D0,-(A5)  ; PHA
                            	  4856:     ; Save offset X [02] and Y offset [03].
                            	  4857:     ;
02:0004842C 102C0002        	  4858:     move.b  ($0002,A4),D0
02:00048430 1B00            	  4859:     move.b  D0,-(A5)  ; PHA
02:00048432 102C0003        	  4860:     move.b  ($0003,A4),D0
02:00048436 1B00            	  4861:     move.b  D0,-(A5)  ; PHA
                            	  4862:     ; Calculate and set sprite attributes for this corner:
                            	  4863:     ;   base attribute OR (frame counter AND 3)
                            	  4864:     ;
                            	  4865:     ; The base attribute defines how to flip the sprite.
                            	  4866:     ; The frame counter makes the shot flash by cycling each
                            	  4867:     ; palette row.
                            	  4868:     ;
02:00048438 102C0015        	  4869:     move.b  ($0015,A4),D0
02:0004843C 02000003        	  4870:     andi.b #$03,D0
02:00048440 41F90004831C    	  4871:     lea     (SwordShotSpreadBaseAttr).l,A0
02:00048446 12303000        	  4872:     move.b  (A0,D3.W),D1
02:0004844A 8001            	  4873:     or.b  D1,D0
02:0004844C 4EB900031186    	  4874:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  4875:     ; Add the object's X (the center of the spread) and the
                            	  4876:     ; current offset in [02] to set sprite X in [00].
                            	  4877:     ;
02:00048452 10342070        	  4878:     move.b  ($70,A4,D2.W),D0
02:00048456 023C00EE        	  4879:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004845A 122C0002        	  4880:     move.b  ($0002,A4),D1
02:0004845E D101            	  4881:     addx.b  D1,D0   ; ADC $02
02:00048460 1880            	  4882:     move.b  D0,($0000,A4)
                            	  4883:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  4884:     ; Else calculate the distance from object X to sprite X.
                            	  4885:     ;
02:00048462 12342070        	  4886:     move.b  ($70,A4,D2.W),D1
02:00048466 B001            	  4887:     cmp.b   D1,D0
02:00048468 651A            	  4888:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004846A 0C0000FC        	  4889:     cmpi.b  #$FC,D0
02:0004846E 6466            	  4890:     bcc  _L_z07_SpreadShot_NextCorner
02:00048470 003C0011        	  4891:     ori     #$11,CCR  ; SEC: set C+X
02:00048474 12342070        	  4892:     move.b  ($70,A4,D2.W),D1
02:00048478 0A3C0010        	  4893:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004847C 9101            	  4894:     subx.b  D1,D0   ; SBC ObjX,X
02:0004847E 0A3C0010        	  4895:     eori    #$10,CCR  ; restore X = 6502 C
02:00048482 6014            	  4896:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  4897: 
                            	  4898:     even
                            	  4899: _L_z07_SpreadShot_ReverseSub:
02:00048484 10342070        	  4900:     move.b  ($70,A4,D2.W),D0
02:00048488 003C0011        	  4901:     ori     #$11,CCR  ; SEC: set C+X
02:0004848C 1214            	  4902:     move.b  ($0000,A4),D1
02:0004848E 0A3C0010        	  4903:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00048492 9101            	  4904:     subx.b  D1,D0   ; SBC $00
02:00048494 0A3C0010        	  4905:     eori    #$10,CCR  ; restore X = 6502 C
                            	  4906:     even
                            	  4907: _L_z07_SpreadShot_CheckDistance:
                            	  4908:     ; If distance >= $20, skip this corner.
                            	  4909:     ;
02:00048498 0C000020        	  4910:     cmpi.b  #$20,D0
02:0004849C 6438            	  4911:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4912:     ; Add the object's Y (the center of the spread) and the
                            	  4913:     ; current offset in [03] to set sprite Y in [01].
                            	  4914:     ;
02:0004849E 41EC0084        	  4915:     lea     ($0084,A4),A0
02:000484A2 10302000        	  4916:     move.b  (A0,D2.W),D0
02:000484A6 023C00EE        	  4917:     andi    #$EE,CCR  ; CLC: clear C+X
02:000484AA 122C0003        	  4918:     move.b  ($0003,A4),D1
02:000484AE D101            	  4919:     addx.b  D1,D0   ; ADC $03
02:000484B0 19400001        	  4920:     move.b  D0,($0001,A4)
                            	  4921:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  4922:     ;
02:000484B4 7600            	  4923:     moveq   #0,D3
02:000484B6 162C0010        	  4924:     move.b  ($0010,A4),D3
02:000484BA 670C            	  4925:     beq  _L_z07_SpreadShot_Draw
02:000484BC 0C00003E        	  4926:     cmpi.b  #$3E,D0
02:000484C0 6514            	  4927:     bcs  _L_z07_SpreadShot_NextCorner
02:000484C2 0C0000E8        	  4928:     cmpi.b  #$E8,D0
02:000484C6 640E            	  4929:     bcc  _L_z07_SpreadShot_NextCorner
                            	  4930:     even
                            	  4931: _L_z07_SpreadShot_Draw:
                            	  4932:     ; Draw the corner.
                            	  4933:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  4934:     ;
02:000484C8 7002            	  4935:     moveq   #2,D0
02:000484CA 1940000C        	  4936:     move.b  D0,($000C,A4)
02:000484CE 7623            	  4937:     moveq   #35,D3
02:000484D0 4EB9000310A6    	  4938:     jsr     Anim_WriteItemSprites
                            	  4939:     even
                            	  4940: _L_z07_SpreadShot_NextCorner:
                            	  4941:     ; Prepare to process the next corner.
                            	  4942:     ;
                            	  4943:     ; First, restore X offset [02] and Y offset [03].
                            	  4944:     ;
02:000484D6 101D            	  4945:     move.b  (A5)+,D0  ; PLA
02:000484D8 19400003        	  4946:     move.b  D0,($0003,A4)
02:000484DC 101D            	  4947:     move.b  (A5)+,D0  ; PLA
02:000484DE 19400002        	  4948:     move.b  D0,($0002,A4)
                            	  4949:     ; Take turns negating X offset or Y offset for the next round.
                            	  4950:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  4951:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  4952:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  4953:     ; - Fourth turn: doesn't matter
                            	  4954:     ;
                            	  4955:     ;
                            	  4956:     ; Get the loop index.
02:000484E2 101D            	  4957:     move.b  (A5)+,D0  ; PLA
02:000484E4 1B00            	  4958:     move.b  D0,-(A5)  ; PHA
02:000484E6 7600            	  4959:     moveq   #0,D3
02:000484E8 1600            	  4960:     move.b  D0,D3
02:000484EA 0C030001        	  4961:     cmpi.b  #$01,D3
02:000484EE 6602            	  4962:     bne  _anon_z07_25
02:000484F0 7603            	  4963:     moveq   #3,D3
                            	  4964: _anon_z07_25:
02:000484F2 10343000        	  4965:     move.b  ($00,A4,D3.W),D0
02:000484F6 4600            	  4966:     eori.b #$FF,D0
02:000484F8 023C00EE        	  4967:     andi    #$EE,CCR  ; CLC: clear C+X
02:000484FC 123C0001        	  4968:     move.b  #$01,D1
02:00048500 D101            	  4969:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:00048502 19803000        	  4970:     move.b  D0,($00,A4,D3.W)
                            	  4971:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  4972:     ;
02:00048506 101D            	  4973:     move.b  (A5)+,D0  ; PLA
02:00048508 7600            	  4974:     moveq   #0,D3
02:0004850A 1600            	  4975:     move.b  D0,D3
02:0004850C 5303            	  4976:     subq.b  #1,D3
02:0004850E 6A00FF18        	  4977:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  4978:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4979:     ;
                            	  4980:     ; Decrease the base negative offset to get farther away from
                            	  4981:     ; the center point.
                            	  4982:     ;
02:00048512 41EC0098        	  4983:     lea     ($0098,A4),A0
02:00048516 53302000        	  4984:     subq.b  #1,(A0,D2.W)
                            	  4985:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  4986:     ;
                            	  4987:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  4988:     ;
02:0004851A 41EC0098        	  4989:     lea     ($0098,A4),A0
02:0004851E 10302000        	  4990:     move.b  (A0,D2.W),D0
02:00048522 0C0000E8        	  4991:     cmpi.b  #$E8,D0
02:00048526 6702            	  4992:     beq.s  __far_z_07_0071
02:00048528 6004            	  4993:     jmp  L1F49F_Exit
