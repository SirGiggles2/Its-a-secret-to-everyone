                            	  1151: _L_z04__TryShooting_TryShootingNow:
                            	  1152:     ; Summary
                            	  1153:     ;
                            	  1154:     ; if temporarily invincible then
                            	  1155:     ;   shoot timer := 0
                            	  1156:     ; elif shoot timer > 0 then
                            	  1157:     ;   decrement shoot timer
                            	  1158:     ; elif wants to shoot then
                            	  1159:     ;   shoot timer := $30
                            	  1160:     ;
                            	  1161:     ; qspeed := [01]
                            	  1162:     ;
                            	  1163:     ; if shoot timer <> 0 then
                            	  1164:     ;   if shoot timer = $10 and no clock and not stunned then
                            	  1165:     ;     shoot
                            	  1166:     ;     if succeeded then
                            	  1167:     ;       shoot timer := 0
                            	  1168:     ;       qspeed := 0
                            	  1169:     ;   else
                            	  1170:     ;     qspeed := 0
                            	  1171:     ;
                            	  1172:     ; Push a 0 q-speed, in case the monster is in shooting time.
02:000388DE 102C0001        	  1173:     move.b  ($0001,A4),D0
02:000388E2 1883            	  1174:     move.b  D3,($0000,A4)
02:000388E4 1B00            	  1175:     move.b  D0,-(A5)  ; PHA
02:000388E6 7600            	  1176:     moveq   #0,D3
                            	  1177:     ; If not temporarily invincible,
                            	  1178:     ;
02:000388E8 41EC04F0        	  1179:     lea     ($04F0,A4),A0
02:000388EC 10302000        	  1180:     move.b  (A0,D2.W),D0
02:000388F0 661A            	  1181:     bne  _L_z04__TryShooting_SetShootTimer
                            	  1182:     ; then Y := shoot timer - 1
                            	  1183:     ;
02:000388F2 7600            	  1184:     moveq   #0,D3
02:000388F4 41EC0451        	  1185:     lea     ($0451,A4),A0
02:000388F8 16302000        	  1186:     move.b  (A0,D2.W),D3
02:000388FC 5303            	  1187:     subq.b  #1,D3
                            	  1188:     ; If Y register < 0, then shoot timer is 0.
                            	  1189:     ; So, if "wants to shoot" flag is set, then set shoot timer to $30.
                            	  1190:     ; Else go set a non-zero speed and return.
                            	  1191:     ;
02:000388FE 6A0C            	  1192:     bpl  _L_z04__TryShooting_SetShootTimer
02:00038900 41EC0412        	  1193:     lea     ($0412,A4),A0
02:00038904 10302000        	  1194:     move.b  (A0,D2.W),D0
02:00038908 6736            	  1195:     beq  _L_z04__TryShooting_SetSpeed
02:0003890A 7630            	  1196:     moveq   #48,D3
                            	  1197:     even
