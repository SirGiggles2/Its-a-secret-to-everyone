                            	  5819: CalcBoomerangFrame:
                            	  5820:     ; The minor state (low 3 bits of state) is used to
                            	  5821:     ; set the right frame in [0C] for this point in the spinning cycle.
                            	  5822:     ;
                            	  5823:     ; Reset [00] and [01]. These are the offsets for boomerang's position.
                            	  5824:     ; In other words, don't offset the coordinate below.
                            	  5825:     ;
02:0004C55C 7000            	  5826:     moveq   #0,D0
02:0004C55E 1880            	  5827:     move.b  D0,($0000,A4)
02:0004C560 41EC00AC        	  5828:     lea     ($00AC,A4),A0
02:0004C564 10302000        	  5829:     move.b  (A0,D2.W),D0
02:0004C568 0200000F        	  5830:     andi.b #$0F,D0
02:0004C56C 7600            	  5831:     moveq   #0,D3
02:0004C56E 1600            	  5832:     move.b  D0,D3
02:0004C570 7000            	  5833:     moveq   #0,D0
02:0004C572 19400001        	  5834:     move.b  D0,($0001,A4)
02:0004C576 41F90004C164    	  5835:     lea     (BoomerangFrameCycle).l,A0
02:0004C57C 10303000        	  5836:     move.b  (A0,D3.W),D0
02:0004C580 1940000C        	  5837:     move.b  D0,($000C,A4)
                            	  5838:     ; Store the base sprite attribute for this point in the cycle in [04].
                            	  5839:     ;
