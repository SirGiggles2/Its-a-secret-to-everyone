                            	  2908: _anon_z05_75:
                            	  2909:     ; If in UW, use the second set of bounds by adding 4
                            	  2910:     ; to reverse direction index.
                            	  2911:     ;
                            	  2912:     ; Else in OW, and use first set that begins at offset 0.
                            	  2913:     ;
