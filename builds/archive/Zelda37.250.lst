02:0003DED0 10302000        	  9479:     move.b  (A0,D2.W),D0
02:0003DED4 122C0002        	  9480:     move.b  ($0002,A4),D1
02:0003DED8 E309            	  9481:     lsl.b  #1,D1   ; ASL $02
02:0003DEDA 19410002        	  9482:     move.b  D1,($0002,A4)
02:0003DEDE 122C0002        	  9483:     move.b  ($0002,A4),D1
02:0003DEE2 C200            	  9484:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DEE4 6716            	  9485:     beq  _L_z04_Manhandla_Move_Up
02:0003DEE6 41EC0084        	  9486:     lea     ($0084,A4),A0
02:0003DEEA 10302000        	  9487:     move.b  (A0,D2.W),D0
02:0003DEEE 122C0003        	  9488:     move.b  ($0003,A4),D1
02:0003DEF2 D101            	  9489:     addx.b  D1,D0   ; ADC $03
02:0003DEF4 41EC0084        	  9490:     lea     ($0084,A4),A0
