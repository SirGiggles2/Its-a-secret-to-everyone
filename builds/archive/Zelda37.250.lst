                            	  3732: _L_z07_WieldFlute_Found:
                            	  3733:     ; Found.
                            	  3734:     ;
                            	  3735:     ; If it was the first room in the list, handle it specially.
                            	  3736:     ; This room is the only one in Q1 with a flute secret. It's also
                            	  3737:     ; the only one in the list without a flute secret in Q2.
                            	  3738:     ;
