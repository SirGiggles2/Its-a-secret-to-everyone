02:0002E9BE 7402            	   922:     moveq   #2,D2
                            	   923:     even
                            	   924: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_LoopWare:
                            	   925:     ; If this item is nothing, then loop again.
