                            	  6861: __far_z_04_0058:
                            	  6862:     ; Set the bloated timer according to the substate.
                            	  6863:     ;
02:0003CBBC 7600            	  6864:     moveq   #0,D3
02:0003CBBE 41EC042C        	  6865:     lea     ($042C,A4),A0
