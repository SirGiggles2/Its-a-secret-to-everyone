02:0002E988 102C0413        	   881:     move.b  ($0413,A4),D0
02:0002E98C E208            	   882:     lsr.b  #1,D0   ; LSR A
02:0002E98E 6528            	   883:     bcs  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_CheckPickUp
                            	   884:     ; Advance to the end state, where the person is still shown.
