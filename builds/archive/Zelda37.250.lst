                            	   421: _anon_z05_3:
                            	   422:     ; If Start was pressed, then hide all sprites except
                            	   423:     ; Link and triforce position markers, and go to the next state (scroll up).
                            	   424:     ;
02:000402AE 102C00F8        	   425:     move.b  ($00F8,A4),D0
02:000402B2 02000010        	   426:     andi.b #$10,D0
02:000402B6 6606            	   427:     bne.s  __far_z_05_0000
02:000402B8 4EF90002D7D2    	   428:     jmp  Exit
                            	   429: __far_z_05_0000:
02:000402BE 102C0254        	   430:     move.b  ($0254,A4),D0
02:000402C2 1B00            	   431:     move.b  D0,-(A5)  ; PHA
02:000402C4 102C0258        	   432:     move.b  ($0258,A4),D0
02:000402C8 1B00            	   433:     move.b  D0,-(A5)  ; PHA
02:000402CA 4EB90004A8BA    	   434:     jsr     HideAllSprites
02:000402D0 101D            	   435:     move.b  (A5)+,D0  ; PLA
02:000402D2 19400258        	   436:     move.b  D0,($0258,A4)
02:000402D6 101D            	   437:     move.b  (A5)+,D0  ; PLA
02:000402D8 19400254        	   438:     move.b  D0,($0254,A4)
02:000402DC 522C00E1        	   439:     addq.b  #1,($00E1,A4)
02:000402E0 0A3C0001        	   440:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000402E4 4E75            	   441:     rts
                            	   442: 
