                            	  7345: _anon_z01_99:
                            	  7346:     ; [08], [04], and [05] are used in determining the direction to push Link,
                            	  7347:     ; if he is defending. The goal is to push Link away from the monster.
                            	  7348:     ;
                            	  7349:     ; If instead a monster is defending, then all this calculation
                            	  7350:     ; won't matter, because the shove direction will be set to the
                            	  7351:     ; weapon's direction.
                            	  7352:     ;
                            	  7353:     ; As such, calculate a direction from the monster to the defender,
                            	  7354:     ; assuming it's Link.
                            	  7355:     ;
                            	  7356:     ; Start with an assumption that the direction is vertical:
                            	  7357:     ; Store 8 (up) in [08], monster Y in [04], and other Y in [05].
                            	  7358:     ;
02:000326F0 7008            	  7359:     moveq   #8,D0
02:000326F2 19400008        	  7360:     move.b  D0,($0008,A4)
02:000326F6 41EC0084        	  7361:     lea     ($0084,A4),A0
02:000326FA 10302000        	  7362:     move.b  (A0,D2.W),D0
02:000326FE 19400004        	  7363:     move.b  D0,($0004,A4)
02:00032702 41EC0084        	  7364:     lea     ($0084,A4),A0
02:00032706 10303000        	  7365:     move.b  (A0,D3.W),D0
02:0003270A 19400005        	  7366:     move.b  D0,($0005,A4)
                            	  7367:     ; If the defender is Link and his grid offset <> 0 then
                            	  7368:     ; use his usual object direction variable to determine
                            	  7369:     ; which axis to check.
                            	  7370:     ;
02:0003270E 4A03            	  7371:     cmpi.b  #$00,D3
02:00032710 6612            	  7372:     bne  _anon_z01_100
02:00032712 102C0394        	  7373:     move.b  ($0394,A4),D0
02:00032716 670C            	  7374:     beq  _anon_z01_100
02:00032718 102C0098        	  7375:     move.b  ($0098,A4),D0
02:0003271C 02000003        	  7376:     andi.b #$03,D0
02:00032720 660C            	  7377:     bne  _L_z01_BeginShove_CheckHorizontal
02:00032722 6720            	  7378:     beq  _L_z01_BeginShove_CheckVertical
                            	  7379: _anon_z01_100:
                            	  7380:     ; For monsters defending, or Link with grid offset = 0,
                            	  7381:     ; check direction in [0B].
                            	  7382:     ;
                            	  7383:     ; For monsters defending, this won't matter. For Link with grid
                            	  7384:     ; offset = 0, I believe the result will be arbitrary.
                            	  7385:     ;
                            	  7386:     ; TODO:
                            	  7387:     ; Is [0B] always set if Link's grid offset = 0?
                            	  7388:     ; It doesn't seem to be if candle fire attacks him.
                            	  7389:     ;
02:00032724 102C000B        	  7390:     move.b  ($000B,A4),D0
02:00032728 0C000004        	  7391:     cmpi.b  #$04,D0
02:0003272C 6416            	  7392:     bcc  _L_z01_BeginShove_CheckVertical
                            	  7393:     even
                            	  7394: _L_z01_BeginShove_CheckHorizontal:
                            	  7395:     ; If the direction checked is left or right,
                            	  7396:     ; set [08] to 2 (left), monster X in [04] and other X in [05].
                            	  7397:     ;
02:0003272E 7002            	  7398:     moveq   #2,D0
02:00032730 19400008        	  7399:     move.b  D0,($0008,A4)
02:00032734 10342070        	  7400:     move.b  ($70,A4,D2.W),D0
02:00032738 19400004        	  7401:     move.b  D0,($0004,A4)
02:0003273C 10343070        	  7402:     move.b  ($70,A4,D3.W),D0
02:00032740 19400005        	  7403:     move.b  D0,($0005,A4)
                            	  7404:     even
                            	  7405: _L_z01_BeginShove_CheckVertical:
                            	  7406:     ; If the monster is down or right of the other object,
                            	  7407:     ; then use the opposite direction already in [08].
                            	  7408:     ; Else shift [08] right to turn it into the opposite
                            	  7409:     ; direction up or down.
                            	  7410:     ;
                            	  7411:     ; Again assuming Link is the defender; after this, [08] points
                            	  7412:     ; Link away from the monster.
                            	  7413:     ;
02:00032744 102C0004        	  7414:     move.b  ($0004,A4),D0
02:00032748 122C0005        	  7415:     move.b  ($0005,A4),D1
02:0003274C B001            	  7416:     cmp.b   D1,D0
02:0003274E 640A            	  7417:     bcc  _anon_z01_101
02:00032750 122C0008        	  7418:     move.b  ($0008,A4),D1
02:00032754 E209            	  7419:     lsr.b  #1,D1   ; LSR $08
02:00032756 19410008        	  7420:     move.b  D1,($0008,A4)
                            	  7421: _anon_z01_101:
                            	  7422:     ; If a monster is the defender, go handle it separately.
                            	  7423:     ;
02:0003275A 4A03            	  7424:     cmpi.b  #$00,D3
02:0003275C 6656            	  7425:     bne  _L_z01_BeginShove_MonsterDefender
                            	  7426:     ; Link is the defender.
                            	  7427:     ;
                            	  7428:     ; If Link is invincible, return without shoving.
                            	  7429:     ;
02:0003275E 102C04F0        	  7430:     move.b  ($04F0,A4),D0
02:00032762 664E            	  7431:     bne  _L_z01_BeginShove_Exit
                            	  7432:     ; Store the shove direction we determined.
                            	  7433:     ;
                            	  7434:     ; Turn on the high bit to indicate that the next time we try to
                            	  7435:     ; move by shoving, it will be the first time for this shove action.
                            	  7436:     ;
02:00032764 102C0008        	  7437:     move.b  ($0008,A4),D0
02:00032768 00000080        	  7438:     ori.b #$80,D0
02:0003276C 194000C0        	  7439:     move.b  D0,($00C0,A4)
                            	  7440:     ; Mark Link invincible $18 frames, and should move $20 pixels.
                            	  7441:     ;
02:00032770 7018            	  7442:     moveq   #24,D0
02:00032772 194004F0        	  7443:     move.b  D0,($04F0,A4)
02:00032776 7020            	  7444:     moveq   #32,D0
02:00032778 194000D3        	  7445:     move.b  D0,($00D3,A4)
                            	  7446:     ; If Link was shoved by one of his own weapons, then
                            	  7447:     ; nothing else to do. Return.
                            	  7448:     ;
02:0003277C 0C02000D        	  7449:     cmpi.b  #$0D,D2
02:00032780 6430            	  7450:     bcc  _L_z01_BeginShove_Exit
                            	  7451:     ; Link was shoved by a monster.
                            	  7452:     ;
                            	  7453:     ; If the monster's object attribute "reverse after hit Link" is set,
                            	  7454:     ; then return.
                            	  7455:     ;
02:00032782 41EC04BF        	  7456:     lea     ($04BF,A4),A0
02:00032786 10302000        	  7457:     move.b  (A0,D2.W),D0
02:0003278A 02000080        	  7458:     andi.b #$80,D0
02:0003278E 6622            	  7459:     bne  _L_z01_BeginShove_Exit
                            	  7460:     ; If the attacker is a vire, then return.
                            	  7461:     ;
02:00032790 41EC034F        	  7462:     lea     ($034F,A4),A0
02:00032794 10302000        	  7463:     move.b  (A0,D2.W),D0
02:00032798 0C000012        	  7464:     cmpi.b  #$12,D0
02:0003279C 6714            	  7465:     beq  _L_z01_BeginShove_Exit
                            	  7466:     ; Turn the attacker in the opposite direction.
                            	  7467:     ;
02:0003279E 41EC0098        	  7468:     lea     ($0098,A4),A0
02:000327A2 10302000        	  7469:     move.b  (A0,D2.W),D0
02:000327A6 6100E87A        	  7470:     jsr     GetOppositeDir
02:000327AA 41EC0098        	  7471:     lea     ($0098,A4),A0
02:000327AE 11802000        	  7472:     move.b  D0,(A0,D2.W)
                            	  7473:     even
