02:00039F0A 61005BE4        	   641:     jsr     _ShootIfWanted
02:00039F0E 646A            	   642:     bcc  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   643:     ; Set monster's state to $80 for delaying after shooting.
                            	   644:     ;
02:00039F10 103C0080        	   645:     move.b  #$80,D0
02:00039F14 41EC00AC        	   646:     lea     ($00AC,A4),A0
02:00039F18 11802000        	   647:     move.b  D0,(A0,D2.W)
                            	   648:     ; Reset the "wants to shoot" flag.
                            	   649:     ;
02:00039F1C 7000            	   650:     moveq   #0,D0
02:00039F1E 41EC0412        	   651:     lea     ($0412,A4),A0
02:00039F22 11802000        	   652:     move.b  D0,(A0,D2.W)
                            	   653:     ; Have the shot keep track of the monster.
                            	   654:     ;
02:00039F26 1002            	   655:     move.b  D2,D0
02:00039F28 41EC042C        	   656:     lea     ($042C,A4),A0
02:00039F2C 11803000        	   657:     move.b  D0,(A0,D3.W)
                            	   658:     ; Have the monster keep track of the shot.
                            	   659:     ;
02:00039F30 1003            	   660:     move.b  D3,D0
02:00039F32 41EC042C        	   661:     lea     ($042C,A4),A0
02:00039F36 11802000        	   662:     move.b  D0,(A0,D2.W)
                            	   663:     ; Set the shot's state to $10, which is the flying state for them.
                            	   664:     ;
02:00039F3A 7010            	   665:     moveq   #16,D0
02:00039F3C 41EC00AC        	   666:     lea     ($00AC,A4),A0
02:00039F40 11803000        	   667:     move.b  D0,(A0,D3.W)
                            	   668:     ; Fly at q-speed $A0 (2.5 pixels a frame).
                            	   669:     ;
