                            	  6577: 
                            	  6578: ; Params:
                            	  6579: ; X: monster slot
                            	  6580: ; Y: weapon slot
                            	  6581: ; [02]: monster mid X
                            	  6582: ; [03]: monster mid Y
                            	  6583: ;
