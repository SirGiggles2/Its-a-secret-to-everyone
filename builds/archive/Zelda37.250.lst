                            	   298: UpdateMenuScrollDownUW:
02:000401C2 61004996        	   299:     jsr     Submenu_CueTransferRowUW
                            	   300: _anon_z05_2:
                            	   301:     ; Move position markers and advance nametable scrolling;
                            	   302:     ; so that we scroll down 3 pixels.
                            	   303:     ;
02:000401C6 7003            	   304:     moveq   #3,D0
02:000401C8 6100015C        	   305:     jsr     MovePositionMarkers
02:000401CC 102C00FC        	   306:     move.b  ($00FC,A4),D0
02:000401D0 003C0011        	   307:     ori     #$11,CCR  ; SEC: set C+X
02:000401D4 123C0003        	   308:     move.b  #$03,D1
02:000401D8 0A3C0010        	   309:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000401DC 9101            	   310:     subx.b  D1,D0   ; SBC #$03
02:000401DE 0A3C0010        	   311:     eori    #$10,CCR  ; restore X = 6502 C
02:000401E2 194000FC        	   312:     move.b  D0,($00FC,A4)
                            	   313:     ; There's nothing else to do until we reach hardware VScroll=$41. Return.
                            	   314:     ;
02:000401E6 0C000041        	   315:     cmpi.b  #$41,D0
02:000401EA 66000090        	   316:     bne  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   317:     ; VScroll reached $41.
                            	   318:     ; Advance the submenu state.
                            	   319:     ; If in OW or in a cellar, we're done. Return.
                            	   320:     ;
02:000401EE 522C00E1        	   321:     addq.b  #1,($00E1,A4)
02:000401F2 102C0010        	   322:     move.b  ($0010,A4),D0
02:000401F6 67000084        	   323:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
02:000401FA 102C0012        	   324:     move.b  ($0012,A4),D0
02:000401FE 0C000009        	   325:     cmpi.b  #$09,D0
02:00040202 6778            	   326:     beq  _L_z05_UpdateMenuScrollDownUW_Exit
                            	   327:     ; Calculate the X coordinate of the submenu position marker.
                            	   328:     ;
                            	   329:     ; First, mask off the high nibble of the room ID and multiply by
                            	   330:     ; the width of a tile, 8. Store the result in [00].
                            	   331:     ;
02:00040204 102C00EB        	   332:     move.b  ($00EB,A4),D0
02:00040208 0200000F        	   333:     andi.b #$0F,D0
02:0004020C E308            	   334:     lsl.b  #1,D0   ; ASL A
02:0004020E E308            	   335:     lsl.b  #1,D0   ; ASL A
02:00040210 E308            	   336:     lsl.b  #1,D0   ; ASL A
02:00040212 1880            	   337:     move.b  D0,($0000,A4)
                            	   338:     ; If the submenu map's rotation >= 8, it's the same as a
                            	   339:     ; negative or left rotation by ($10 - rotation value).
                            	   340:     ;
                            	   341:     ; Subtract the two values as shown. Multiply the result by 8,
                            	   342:     ; the width of a tile. Then negate it. The final result is the
                            	   343:     ; negative offset.
                            	   344:     ;
02:00040214 103900FF6BAB    	   345:     move.b  (NES_SRAM+$0BAB).l,D0
02:0004021A 0C000008        	   346:     cmpi.b  #$08,D0
02:0004021E 6520            	   347:     bcs  _L_z05_UpdateMenuScrollDownUW_ShortRotation
02:00040220 7010            	   348:     moveq   #16,D0
02:00040222 123900FF6BAB    	   349:     move.b  (NES_SRAM+$0BAB).l,D1
02:00040228 0A3C0010        	   350:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004022C 9101            	   351:     subx.b  D1,D0   ; SBC LevelInfo_SubmenuMapRotation
02:0004022E 0A3C0010        	   352:     eori    #$10,CCR  ; restore X = 6502 C
02:00040232 E308            	   353:     lsl.b  #1,D0   ; ASL A
02:00040234 E308            	   354:     lsl.b  #1,D0   ; ASL A
02:00040236 E308            	   355:     lsl.b  #1,D0   ; ASL A
02:00040238 4EB90003102A    	   356:     jsr     Negate
02:0004023E 6006            	   357:     jmp     _L_z05_UpdateMenuScrollDownUW_SumMarkerX
                            	   358: 
                            	   359:     even
                            	   360: _L_z05_UpdateMenuScrollDownUW_ShortRotation:
                            	   361:     ; The submenu map's rotation < 8.
                            	   362:     ; It represents the number of tiles to move right.
                            	   363:     ; So, multiply it by 8.
                            	   364:     ;
02:00040240 E308            	   365:     lsl.b  #1,D0   ; ASL A
02:00040242 E308            	   366:     lsl.b  #1,D0   ; ASL A
02:00040244 E308            	   367:     lsl.b  #1,D0   ; ASL A
                            	   368:     even
                            	   369: _L_z05_UpdateMenuScrollDownUW_SumMarkerX:
                            	   370:     ; Add the offset we calculated, and $62 to [00] to get
                            	   371:     ; the position marker's X coordinate.
                            	   372:     ;
02:00040246 023C00EE        	   373:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004024A 1214            	   374:     move.b  ($0000,A4),D1
02:0004024C D101            	   375:     addx.b  D1,D0   ; ADC $00
02:0004024E 023C00EE        	   376:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040252 123C0062        	   377:     move.b  #$62,D1
02:00040256 D101            	   378:     addx.b  D1,D0   ; ADC #$62 (X flag = 6502 C)
02:00040258 19400253        	   379:     move.b  D0,($0253,A4)
                            	   380:     ; Mask off the low nibble of room ID to get a multiple of $10.
                            	   381:     ; Divide by 2 to get a multiple of the tile height.
                            	   382:     ; Then add $69 to get the Y coordinate of the sprite.
                            	   383:     ;
02:0004025C 102C00EB        	   384:     move.b  ($00EB,A4),D0
02:00040260 020000F0        	   385:     andi.b #$F0,D0
02:00040264 E208            	   386:     lsr.b  #1,D0   ; LSR A
02:00040266 123C0069        	   387:     move.b  #$69,D1
02:0004026A D101            	   388:     addx.b  D1,D0   ; ADC #$69 (X flag = 6502 C)
02:0004026C 19400250        	   389:     move.b  D0,($0250,A4)
                            	   390:     ; Write tile $3E (dot) and attributes 0 (Link palette row 4).
                            	   391:     ;
02:00040270 703E            	   392:     moveq   #62,D0
02:00040272 19400251        	   393:     move.b  D0,($0251,A4)
02:00040276 7000            	   394:     moveq   #0,D0
02:00040278 19400252        	   395:     move.b  D0,($0252,A4)
                            	   396:     even
                            	   397: _L_z05_UpdateMenuScrollDownUW_Exit:
02:0004027C 4E75            	   398:     rts
                            	   399: 
