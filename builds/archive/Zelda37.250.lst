                            	  4751: DrawLinkZeldaTriforces:
                            	  4752:     ; The triforce over Link goes in the room object slot $13.
                            	  4753:     ; Set its location $10 pixels above Link.
                            	  4754:     ;
02:000367EA 102C0070        	  4755:     move.b  ($0070,A4),D0
02:000367EE 19400083        	  4756:     move.b  D0,($0083,A4)
02:000367F2 102C0084        	  4757:     move.b  ($0084,A4),D0
02:000367F6 003C0011        	  4758:     ori     #$11,CCR  ; SEC: set C+X
02:000367FA 123C0010        	  4759:     move.b  #$10,D1
02:000367FE 0A3C0010        	  4760:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00036802 9101            	  4761:     subx.b  D1,D0   ; SBC #$10
02:00036804 0A3C0010        	  4762:     eori    #$10,CCR  ; restore X = 6502 C
02:00036808 19400097        	  4763:     move.b  D0,($0097,A4)
                            	  4764:     ; Draw Link.
                            	  4765:     ;
