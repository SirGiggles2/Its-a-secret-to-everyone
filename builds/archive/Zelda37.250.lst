02:0003F5D6 1880            	 12587:     move.b  D0,($0000,A4)
02:0003F5D8 6100009C        	 12588:     jsr     Ganon_GetCurCloudTop
02:0003F5DC 6100FF7E        	 12589:     jsr     Ganon_DrawCloud
02:0003F5E0 6100009A        	 12590:     jsr     Ganon_GetCurCloudBottom
02:0003F5E4 6100FF76        	 12591:     jsr     Ganon_DrawCloud
                            	 12592:     ; Draw the left and right clouds.
                            	 12593:     ;
02:0003F5E8 61000080        	 12594:     jsr     Ganon_GetCurCloudLeft
02:0003F5EC 41EC0084        	 12595:     lea     ($0084,A4),A0
02:0003F5F0 10302000        	 12596:     move.b  (A0,D2.W),D0
02:0003F5F4 19400001        	 12597:     move.b  D0,($0001,A4)
02:0003F5F8 6100FF62        	 12598:     jsr     Ganon_DrawCloud
02:0003F5FC 6172            	 12599:     jsr     Ganon_GetCurCloudRight
02:0003F5FE 6100FF5C        	 12600:     jsr     Ganon_DrawCloud
                            	 12601:     ; Save the object index.
                            	 12602:     ;
02:0003F602 102C0340        	 12603:     move.b  ($0340,A4),D0
02:0003F606 1B00            	 12604:     move.b  D0,-(A5)  ; PHA
                            	 12605:     ; Loop over the 8 burst rays in slots 2 to 9, to move and draw them.
                            	 12606:     ;
02:0003F608 7402            	 12607:     moveq   #2,D2
                            	 12608:     even
                            	 12609: _L_z04_Ganon_DrawBurst_LoopRay:
02:0003F60A 19420340        	 12610:     move.b  D2,($0340,A4)
                            	 12611:     ; If object slot < 5 or = 7, then move every frame.
                            	 12612:     ; Else move 3 out of every 4 frames.
                            	 12613:     ;
                            	 12614:     ; This makes pieces spread out in somewhat of a circle,
                            	 12615:     ; by making the pieces at cardinal directions move at
                            	 12616:     ; full speed while the diagonal ones move a little slower.
                            	 12617:     ;
02:0003F60E 0C020005        	 12618:     cmpi.b  #$05,D2
02:0003F612 6510            	 12619:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0003F614 0C020007        	 12620:     cmpi.b  #$07,D2
02:0003F618 670A            	 12621:     beq  _L_z04_Ganon_DrawBurst_Move
02:0003F61A 102C0015        	 12622:     move.b  ($0015,A4),D0
02:0003F61E 02000003        	 12623:     andi.b #$03,D0
02:0003F622 6704            	 12624:     beq  _anon_z04_164
                            	 12625:     even
                            	 12626: _L_z04_Ganon_DrawBurst_Move:
02:0003F624 6100E036        	 12627:     jsr     BlueWizzrobe_Move
                            	 12628: _anon_z04_164:
02:0003F628 4EB90004CCCA    	 12629:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	 12630:     ; The frame counter will make the sprite flash.
                            	 12631:     ; The array has the horizontal and vertical flipping attributes.
                            	 12632:     ; Combine them into [03].
                            	 12633:     ;
02:0003F62E 102C0015        	 12634:     move.b  ($0015,A4),D0
02:0003F632 02000003        	 12635:     andi.b #$03,D0
02:0003F636 41F90003F506    	 12636:     lea     (GanonBurstSpriteAttrs).l,A0
02:0003F63C 12302000        	 12637:     move.b  (A0,D2.W),D1
02:0003F640 8001            	 12638:     or.b  D1,D0
02:0003F642 19400003        	 12639:     move.b  D0,($0003,A4)
02:0003F646 41F90003F510    	 12640:     lea     (GanonBurstTiles).l,A0
02:0003F64C 10302000        	 12641:     move.b  (A0,D2.W),D0
02:0003F650 4EB900031E76    	 12642:     jsr     Anim_WriteSprite
                            	 12643:     ; Bottom of the loop.
                            	 12644:     ; Increment object slot while <= 9.
                            	 12645:     ;
02:0003F656 5202            	 12646:     addq.b  #1,D2
02:0003F658 0C02000A        	 12647:     cmpi.b  #$0A,D2
02:0003F65C 65AC            	 12648:     bcs  _L_z04_Ganon_DrawBurst_LoopRay
                            	 12649:     ; Restore the object index.
                            	 12650:     ;
02:0003F65E 101D            	 12651:     move.b  (A5)+,D0  ; PLA
02:0003F660 19400340        	 12652:     move.b  D0,($0340,A4)
02:0003F664 0A3C0001        	 12653:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003F668 4E75            	 12654:     rts
                            	 12655: 
