                            	  6563:     ; Go to mode $11.
                            	  6564:     ;
02:00032268 102C066F        	  6565:     move.b  ($066F,A4),D0
02:0003226C 020000F0        	  6566:     andi.b #$F0,D0
02:00032270 1940066F        	  6567:     move.b  D0,($066F,A4)
02:00032274 4EB90004B276    	  6568:     jsr     EndGameMode
02:0003227A 19400670        	  6569:     move.b  D0,($0670,A4)
02:0003227E 194000AC        	  6570:     move.b  D0,($00AC,A4)
