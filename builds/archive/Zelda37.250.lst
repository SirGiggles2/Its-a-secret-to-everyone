                            	  3669: FormatHeartsInTextBuf:
                            	  3670:     ; [$0E]: hearts value
                            	  3671:     ; [$0F]: heart partial
                            	  3672:     ; Y: The offset of first character in buffer
                            	  3673:     ;
                            	  3674:     ; The end of the bottom row is $12 bytes after the
                            	  3675:     ; start of the top row. We're writing to two transfer
                            	  3676:     ; records. We write the top row in the first transfer
                            	  3677:     ; record wherever the caller chooses. The second
                            	  3678:     ; transfer record has to begin with the heart tiles.
                            	  3679:     ; So, 7 (offset to end of first row) + 3 (size of transfer
                            	  3680:     ; header) + 8 (length of bottom row) = 18 ($12).
                            	  3681:     ;
