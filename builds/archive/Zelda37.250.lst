02:0003075A D101            	  2844:     addx.b  D1,D0   ; ADC CurObjIndex
02:0003075C 7400            	  2845:     moveq   #0,D2
02:0003075E 1400            	  2846:     move.b  D0,D2
                            	  2847:     ; Look up and set the location for this iteration's individual trap.
                            	  2848:     ;
02:00030760 41F900030724    	  2849:     lea     (TrapXs).l,A0
02:00030766 10303000        	  2850:     move.b  (A0,D3.W),D0
02:0003076A 19802070        	  2851:     move.b  D0,($70,A4,D2.W)
02:0003076E 41F90003072A    	  2852:     lea     (TrapYs).l,A0
