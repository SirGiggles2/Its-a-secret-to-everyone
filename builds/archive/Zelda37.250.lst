02:000322B2 023C00EE        	  6608:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322B6 123C0004        	  6609:     move.b  #$04,D1
02:000322BA D101            	  6610:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:000322BC 19400004        	  6611:     move.b  D0,($0004,A4)
                            	  6612:     ; The boomerang's middle Y is 8 pixels down. Store in [05].
                            	  6613:     ;
02:000322C0 41EC0084        	  6614:     lea     ($0084,A4),A0
02:000322C4 10303000        	  6615:     move.b  (A0,D3.W),D0
02:000322C8 023C00EE        	  6616:     andi    #$EE,CCR  ; CLC: clear C+X
02:000322CC 123C0008        	  6617:     move.b  #$08,D1
02:000322D0 D101            	  6618:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  6619: ; Params:
                            	  6620: ; A: weapon object mid Y
                            	  6621: ; X: monster object slot
                            	  6622: ; Y: weapon object slot
                            	  6623: ; [00]: weapon object slot
                            	  6624: ; [02]: monster object mid X
                            	  6625: ; [03]: monster object mid Y
                            	  6626: ; [04]: weapon object mid X
                            	  6627: ; [07]: damage points
                            	  6628: ; [09]: damage type
                            	  6629: ; [0D]: horizontal threshold
                            	  6630: ; [0E]: vertical threshold
                            	  6631: ;
