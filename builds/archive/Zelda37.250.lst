02:0003FEEE 0A3C0010        	 13929:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003FEF2 9101            	 13930:     subx.b  D1,D0   ; SBC $03
02:0003FEF4 0A3C0010        	 13931:     eori    #$10,CCR  ; restore X = 6502 C
