                            	  1616: InitMode4:
02:00041000 7400            	  1617:     moveq   #0,D2
02:00041002 142C0013        	  1618:     move.b  ($0013,A4),D2
02:00041006 6604            	  1619:     bne.s  __far_z_05_0023
02:00041008 60000084        	  1620:     jmp  InitMode_EnterRoom
                            	  1621: __far_z_05_0023:
02:0004100C 5302            	  1622:     subq.b  #1,D2
02:0004100E 6612            	  1623:     bne  _L_z05_InitMode4_CheckSub2
                            	  1624:     ; Submode 1.
                            	  1625:     ; Copies the whole play area to NT 0, one row each frame.
                            	  1626:     ;
                            	  1627:     ; TODO:
                            	  1628:     ; If mode 7 scrolls to a dark room, then it sets
                            	  1629:     ; CurRow to zero. Otherwise it would be $FF.
                            	  1630:     ; A positive value triggers this submode 1 to transfer
                            	  1631:     ; the whole play area.
                            	  1632:     ;
                            	  1633:     ; But why? As far as I can tell, the NT 0 is already in
                            	  1634:     ; a good state reflecting the new room. The only thing
                            	  1635:     ; needed is possibly to brighten the room by way of
                            	  1636:     ; changing the palette.
                            	  1637:     ;
                            	  1638:     ; So why does mode 7 trigger this?
                            	  1639:     ; Is there another mode that truly needs this behavior?
                            	  1640:     ;
02:00041010 102C00E9        	  1641:     move.b  ($00E9,A4),D0
02:00041014 6B06            	  1642:     bmi  _anon_z05_40
02:00041016 61003492        	  1643:     jsr     CopyNextRowToTransferBuf
02:0004101A 6404            	  1644:     bcc  _L_z05_InitMode4_Exit
                            	  1645: _anon_z05_40:
02:0004101C 522C0013        	  1646:     addq.b  #1,($0013,A4)
                            	  1647:     even
                            	  1648: _L_z05_InitMode4_Exit:
02:00041020 4E75            	  1649:     rts
                            	  1650: 
                            	  1651:     even
                            	  1652: _L_z05_InitMode4_CheckSub2:
02:00041022 5302            	  1653:     subq.b  #1,D2
02:00041024 6702            	  1654:     beq.s  __far_z_05_0024
02:00041026 6058            	  1655:     jmp  InitMode4_Sub3
                            	  1656: __far_z_05_0024:
                            	  1657:     ; Submode 2.
                            	  1658:     ;
02:00041028 7600            	  1659:     moveq   #0,D3
02:0004102A 162C00EB        	  1660:     move.b  ($00EB,A4),D3
02:0004102E 61004280        	  1661:     jsr     IsDarkRoom_Bank5
02:00041032 6702            	  1662:     beq.s  __far_z_05_0025
02:00041034 6052            	  1663:     jmp  InitMode4_GoToSub0
                            	  1664: __far_z_05_0025:
                            	  1665:     ; This is a light room.
                            	  1666:     ; See if we have to brighten it after leaving a dark room.
                            	  1667:     ;
02:00041036 102C0098        	  1668:     move.b  ($0098,A4),D0
02:0004103A 610040BC        	  1669:     jsr     CalcNextRoomByDir
                            	  1670:     ; Subtract RoomId from next room ID that was calculated
                            	  1671:     ; to get room ID offset in that direction.
02:0004103E 003C0011        	  1672:     ori     #$11,CCR  ; SEC: set C+X
02:00041042 122C00EB        	  1673:     move.b  ($00EB,A4),D1
02:00041046 0A3C0010        	  1674:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004104A 9101            	  1675:     subx.b  D1,D0   ; SBC RoomId
02:0004104C 0A3C0010        	  1676:     eori    #$10,CCR  ; restore X = 6502 C
02:00041050 4EB90003102A    	  1677:     jsr     Negate
02:00041056 023C00EE        	  1678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004105A 122C00EB        	  1679:     move.b  ($00EB,A4),D1
02:0004105E D101            	  1680:     addx.b  D1,D0   ; ADC RoomId
02:00041060 7600            	  1681:     moveq   #0,D3
02:00041062 1600            	  1682:     move.b  D0,D3
02:00041064 6100424A        	  1683:     jsr     IsDarkRoom_Bank5
02:00041068 6602            	  1684:     bne.s  __far_z_05_0026
02:0004106A 601C            	  1685:     jmp  InitMode4_GoToSub0
                            	  1686: __far_z_05_0026:
                            	  1687:     ; The previous room was dark.
                            	  1688:     ;
02:0004106C 102C051F        	  1689:     move.b  ($051F,A4),D0
02:00041070 6702            	  1690:     beq.s  __far_z_05_0027
02:00041072 6014            	  1691:     jmp  InitMode4_GoToSub0
                            	  1692: __far_z_05_0027:
02:00041074 103C00C0        	  1693:     move.b  #$C0,D0
                            	  1694: ; Params:
                            	  1695: ; A: start index of cycle
                            	  1696: ;
                            	  1697:     even
                            	  1698: SetFadeCycleAndAdvanceSubmode:
02:00041078 4EF90002C036    	  1699:     jmp     c_set_fade_cycle_advance_submode
                            	  1700: 
                            	  1701: _anon_z05_41:
02:0004107E 4E75            	  1702:     rts
                            	  1703: 
                            	  1704:     even
                            	  1705: InitMode4_Sub3:
                            	  1706:     ; Submode 3.
                            	  1707:     ;
02:00041080 4EB9000317F8    	  1708:     jsr     AnimateWorldFading
02:00041086 66F6            	  1709:     bne  _anon_z05_41
                            	  1710:     even
                            	  1711: InitMode4_GoToSub0:
02:00041088 4EF90002B9E8    	  1712:     jmp     c_init_mode4_go_to_sub0
                            	  1713: 
                            	  1714: InitMode_EnterRoom:
02:0004108E 4EB90004B042    	  1715:     jsr     DrawSpritesBetweenRooms
02:00041094 4EB90004B060    	  1716:     jsr     ResetPlayerState
                            	  1717:     ; Reset [0300] to [051F].
                            	  1718:     ;
02:0004109A 7005            	  1719:     moveq   #5,D0
02:0004109C 761F            	  1720:     moveq   #31,D3
02:0004109E 4EB90004A8C0    	  1721:     jsr     ClearRam0300UpTo
                            	  1722:     ; Reset door trigger info.
                            	  1723:     ;
02:000410A4 7000            	  1724:     moveq   #0,D0
02:000410A6 19400054        	  1725:     move.b  D0,($0054,A4)
02:000410AA 19400055        	  1726:     move.b  D0,($0055,A4)
                            	  1727:     ; Store level block attribute byte F for convenience.
                            	  1728:     ;
02:000410AE 7600            	  1729:     moveq   #0,D3
02:000410B0 162C00EB        	  1730:     move.b  ($00EB,A4),D3
02:000410B4 41F900FF6AFE    	  1731:     lea     (NES_SRAM+$0AFE).l,A0
02:000410BA 10303000        	  1732:     move.b  (A0,D3.W),D0
02:000410BE 194004CD        	  1733:     move.b  D0,($04CD,A4)
02:000410C2 610038A6        	  1734:     jsr     ResetInvObjState
                            	  1735:     ; There's more than one way to enter a room.
                            	  1736:     ;
                            	  1737:     ; 1: Out of a cave, dungeon, or cellar
                            	  1738:     ;     a. Walking exit
                            	  1739:     ;     b. Next to stairs
                            	  1740:     ; 2: Room to room
                            	  1741:     ;
                            	  1742:     ; Determine which one we need.
                            	  1743:     ;
02:000410C6 102C005A        	  1744:     move.b  ($005A,A4),D0
02:000410CA 6770            	  1745:     beq  _L_z05_InitMode_EnterRoom_Method2
02:000410CC 102C0010        	  1746:     move.b  ($0010,A4),D0
02:000410D0 665C            	  1747:     bne  _anon_z05_42
                            	  1748:     ; Enter method 1.
                            	  1749:     ;
                            	  1750:     ; Set up Link's exit from underground.
                            	  1751:     ;
02:000410D2 7600            	  1752:     moveq   #0,D3
02:000410D4 162C00EB        	  1753:     move.b  ($00EB,A4),D3
02:000410D8 41F900FF687E    	  1754:     lea     (NES_SRAM+$087E).l,A0
02:000410DE 10303000        	  1755:     move.b  (A0,D3.W),D0
02:000410E2 020000F0        	  1756:     andi.b #$F0,D0
02:000410E6 19400070        	  1757:     move.b  D0,($0070,A4)
02:000410EA 41F900FF6AFE    	  1758:     lea     (NES_SRAM+$0AFE).l,A0
02:000410F0 10303000        	  1759:     move.b  (A0,D3.W),D0
02:000410F4 02000007        	  1760:     andi.b #$07,D0
02:000410F8 E308            	  1761:     lsl.b  #1,D0   ; ASL A
02:000410FA E308            	  1762:     lsl.b  #1,D0   ; ASL A
02:000410FC E308            	  1763:     lsl.b  #1,D0   ; ASL A
02:000410FE E308            	  1764:     lsl.b  #1,D0   ; ASL A
                            	  1765:     ; Add the first Y where Link can come out of underground.
                            	  1766:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:00041100 123C004D        	  1767:     move.b  #$4D,D1
02:00041104 D101            	  1768:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00041106 19400084        	  1769:     move.b  D0,($0084,A4)
                            	  1770:     ; If the player didn't step on a cave entrance to go underground,
                            	  1771:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1772:     ;
02:0004110A 7600            	  1773:     moveq   #0,D3
02:0004110C 162C0065        	  1774:     move.b  ($0065,A4),D3
02:00041110 0C030024        	  1775:     cmpi.b  #$24,D3
02:00041114 6618            	  1776:     bne  _anon_z05_42
                            	  1777:     ; Enter method 1-a.
                            	  1778:     ;
                            	  1779:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1780:     ;
02:00041116 19400412        	  1781:     move.b  D0,($0412,A4)
02:0004111A 023C00EE        	  1782:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004111E 123C0010        	  1783:     move.b  #$10,D1
02:00041122 D101            	  1784:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:00041124 19400084        	  1785:     move.b  D0,($0084,A4)
02:00041128 7008            	  1786:     moveq   #8,D0
02:0004112A 19400603        	  1787:     move.b  D0,($0603,A4)
                            	  1788: _anon_z05_42:
                            	  1789:     ; This part is the same no matter if the player went
                            	  1790:     ; underground by stairs or a cave entrance.
                            	  1791:     ;
02:0004112E 7004            	  1792:     moveq   #4,D0
02:00041130 19400098        	  1793:     move.b  D0,($0098,A4)
02:00041134 7000            	  1794:     moveq   #0,D0
02:00041136 19400053        	  1795:     move.b  D0,($0053,A4)
02:0004113A 6064            	  1796:     jmp     _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1797: 
                            	  1798:     even
                            	  1799: _L_z05_InitMode_EnterRoom_Method2:
                            	  1800:     ; Enter method 2.
                            	  1801:     ; Room to room.
                            	  1802:     ;
                            	  1803:     ; Get the direction that the player is entering from.
                            	  1804:     ;
02:0004113C 102C0098        	  1805:     move.b  ($0098,A4),D0
02:00041140 19400053        	  1806:     move.b  D0,($0053,A4)
02:00041144 4EB900031022    	  1807:     jsr     GetOppositeDir
                            	  1808:     ; If the player is entering from a door that was opened, then
                            	  1809:     ; set the "close" door command.
                            	  1810:     ;
02:0004114A 122C00EE        	  1811:     move.b  ($00EE,A4),D1
02:0004114E C001            	  1812:     and.b  D1,D0
02:00041150 19400055        	  1813:     move.b  D0,($0055,A4)
02:00041154 6706            	  1814:     beq  _anon_z05_43
02:00041156 7002            	  1815:     moveq   #2,D0
02:00041158 19400054        	  1816:     move.b  D0,($0054,A4)
                            	  1817: _anon_z05_43:
                            	  1818:     ; If in OW, go reset Link's relative position, and work on objects.
                            	  1819:     ;
02:0004115C 102C0010        	  1820:     move.b  ($0010,A4),D0
02:00041160 673E            	  1821:     beq  _L_z05_InitMode_EnterRoom_PlaceObjects
                            	  1822:     ; If facing right, then set Link's X to 0 at the left edge.
                            	  1823:     ; If direction is left, then set Link's X to $F0 at the right edge.
                            	  1824:     ;
02:00041162 7600            	  1825:     moveq   #0,D3
02:00041164 102C0098        	  1826:     move.b  ($0098,A4),D0
02:00041168 02000003        	  1827:     andi.b #$03,D0
02:0004116C 670E            	  1828:     beq  _L_z05_InitMode_EnterRoom_ChooseWalkDistance
02:0004116E 02000001        	  1829:     andi.b #$01,D0
02:00041172 6604            	  1830:     bne  _anon_z05_44
02:00041174 163C00F0        	  1831:     move.b  #$F0,D3
                            	  1832: _anon_z05_44:
02:00041178 19430070        	  1833:     move.b  D3,($0070,A4)
                            	  1834:     even
                            	  1835: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1836:     ; Choose a distance to walk depending on the door you
                            	  1837:     ; come out of.
                            	  1838:     ;
                            	  1839:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1840:     ;
                            	  1841:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1842:     ; then you have shorter distance to cover. So use the
                            	  1843:     ; previous value as is to use indexes 0 and 1.
