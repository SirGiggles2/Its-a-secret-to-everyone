                            	  6076: _L_z07_UpdateSwordOrRod_CalcAttrs:
                            	  6077:     ; Store the weapon's frame (horizontal or vertical)
                            	  6078:     ; for the direction chosen above in [0C].
                            	  6079:     ;
02:0004C752 4EB900031022    	  6080:     jsr     GetOppositeDir
02:0004C758 41F90004C18C    	  6081:     lea     (RDirectionToWeaponFrame).l,A0
02:0004C75E 10303000        	  6082:     move.b  (A0,D3.W),D0
02:0004C762 1940000C        	  6083:     move.b  D0,($000C,A4)
                            	  6084:     ; Calculate sprite attributes.
                            	  6085:     ;
                            	  6086:     ; If the weapon is the rod, calculate its sprite attributes:
                            	  6087:     ;   base attribute OR 1
                            	  6088:     ; So, it uses palette row 5.
                            	  6089:     ;
02:0004C766 41F90004C190    	  6090:     lea     (RDirectionToWeaponBaseAttribute).l,A0
02:0004C76C 10303000        	  6091:     move.b  (A0,D3.W),D0
02:0004C770 0C02000D        	  6092:     cmpi.b  #$0D,D2
02:0004C774 6706            	  6093:     beq  _L_z07_UpdateSwordOrRod_CalcSwordAttrs
02:0004C776 00000001        	  6094:     ori.b #$01,D0
02:0004C77A 601C            	  6095:     jmp     _L_z07_UpdateSwordOrRod_SetAttrs
                            	  6096: 
                            	  6097:     even
                            	  6098: _L_z07_UpdateSwordOrRod_CalcSwordAttrs:
                            	  6099:     ; The weapon is the sword.
                            	  6100:     ; To calculate the sprite attributes: (item value - 1) + base attribute
                            	  6101:     ;
02:0004C77C 023C00EE        	  6102:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C780 122C0657        	  6103:     move.b  ($0657,A4),D1
02:0004C784 D101            	  6104:     addx.b  D1,D0   ; ADC Items
02:0004C786 003C0011        	  6105:     ori     #$11,CCR  ; SEC: set C+X
02:0004C78A 123C0001        	  6106:     move.b  #$01,D1
02:0004C78E 0A3C0010        	  6107:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C792 9101            	  6108:     subx.b  D1,D0   ; SBC #$01
02:0004C794 0A3C0010        	  6109:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6110:     even
                            	  6111: _L_z07_UpdateSwordOrRod_SetAttrs:
                            	  6112:     ; Set sprite attributes to the calculated value above.
                            	  6113:     ;
02:0004C798 4EB900031E6C    	  6114:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  6115:     ; If the direction is left, set [0F] to flip horizontally.
                            	  6116:     ;
02:0004C79E 0C030002        	  6117:     cmpi.b  #$02,D3
02:0004C7A2 6604            	  6118:     bne  _anon_z07_33
02:0004C7A4 522C000F        	  6119:     addq.b  #1,($000F,A4)
