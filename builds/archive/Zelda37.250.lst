                            	  7105: Dodongo_TryEatBomb:
                            	  7106:     ; Try to eat the bomb.
                            	  7107:     ;
                            	  7108:     ; If the bomb is not in range of the monster, then return.
                            	  7109:     ;
                            	  7110:     ; This is a coarse test, to see if the bomb is over any part of the monster.
                            	  7111:     ;
02:0003CD84 7601            	  7112:     moveq   #1,D3
02:0003CD86 616E            	  7113:     jsr     Dodongo_IsBombInRange
02:0003CD88 6666            	  7114:     bne  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7115:     ; Will loop from 1 to 0, indexed by [00].
                            	  7116:     ;
02:0003CD8A 7001            	  7117:     moveq   #1,D0
02:0003CD8C 1880            	  7118:     move.b  D0,($0000,A4)
                            	  7119:     ; Shift facing direction right 1 to make an index. Value 3 is unused.
                            	  7120:     ;
02:0003CD8E 41EC0098        	  7121:     lea     ($0098,A4),A0
02:0003CD92 10302000        	  7122:     move.b  (A0,D2.W),D0
02:0003CD96 E208            	  7123:     lsr.b  #1,D0   ; LSR A
02:0003CD98 7600            	  7124:     moveq   #0,D3
02:0003CD9A 1600            	  7125:     move.b  D0,D3
                            	  7126:     ; Now we have to see if it's near the mouth. But the mouth
                            	  7127:     ; position depends on the orientation of the monster.
                            	  7128:     ;
                            	  7129:     ; Start with the horizontal distance.
                            	  7130:     ;
02:0003CD9C 102C0004        	  7131:     move.b  ($0004,A4),D0
                            	  7132:     even
                            	  7133: _L_z04_Dodongo_TryEatBomb_LoopLimit:
                            	  7134:     ; Look up the limits for the given direction.
                            	  7135:     ;
                            	  7136:     ; If the distance from the bomb < negative limit,
                            	  7137:     ; or >= positive limit, then return.
                            	  7138:     ;
                            	  7139:     ; Note that these are simple signed comparisons that work,
                            	  7140:     ; because the operands are in a small range.
                            	  7141:     ;
02:0003CDA0 41F90003CCDA    	  7142:     lea     (DodongoMouthNegativeLimits0).l,A0
02:0003CDA6 12303000        	  7143:     move.b  (A0,D3.W),D1
02:0003CDAA B001            	  7144:     cmp.b   D1,D0
02:0003CDAC 6B42            	  7145:     bmi  _L_z04_Dodongo_TryEatBomb_Exit
02:0003CDAE 41F90003CCE0    	  7146:     lea     (DodongoMouthPositiveLimits0).l,A0
02:0003CDB4 12303000        	  7147:     move.b  (A0,D3.W),D1
02:0003CDB8 B001            	  7148:     cmp.b   D1,D0
02:0003CDBA 6A34            	  7149:     bpl  _L_z04_Dodongo_TryEatBomb_Exit
                            	  7150:     ; Add $A to the index to look into the second set for vertical limits.
                            	  7151:     ;
02:0003CDBC 1003            	  7152:     move.b  D3,D0
02:0003CDBE 023C00EE        	  7153:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CDC2 123C000A        	  7154:     move.b  #$0A,D1
02:0003CDC6 D101            	  7155:     addx.b  D1,D0   ; ADC #$0A (X flag = 6502 C)
02:0003CDC8 7600            	  7156:     moveq   #0,D3
02:0003CDCA 1600            	  7157:     move.b  D0,D3
                            	  7158:     ; Bottom of the loop.
                            	  7159:     ;
                            	  7160:     ; Load the vertical distance for the next iteration.
                            	  7161:     ; Decrement loop counter.
                            	  7162:     ;
02:0003CDCC 102C0005        	  7163:     move.b  ($0005,A4),D0
02:0003CDD0 5314            	  7164:     subq.b  #1,($0000,A4)
02:0003CDD2 6ACC            	  7165:     bpl  _L_z04_Dodongo_TryEatBomb_LoopLimit
                            	  7166:     ; If we get here, then the bomb was within range of the mouth.
                            	  7167:     ; Go to state 1 (bloated).
                            	  7168:     ;
02:0003CDD4 41EC00AC        	  7169:     lea     ($00AC,A4),A0
02:0003CDD8 52302000        	  7170:     addq.b  #1,(A0,D2.W)
                            	  7171:     ; Deactivate the bomb, and reset the bloated substate.
                            	  7172:     ;
02:0003CDDC 7610            	  7173:     moveq   #16,D3
02:0003CDDE 7000            	  7174:     moveq   #0,D0
02:0003CDE0 41EC00AC        	  7175:     lea     ($00AC,A4),A0
02:0003CDE4 11803000        	  7176:     move.b  D0,(A0,D3.W)
02:0003CDE8 41EC042C        	  7177:     lea     ($042C,A4),A0
02:0003CDEC 11802000        	  7178:     move.b  D0,(A0,D2.W)
                            	  7179:     even
