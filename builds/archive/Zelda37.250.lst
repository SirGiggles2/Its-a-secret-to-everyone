02:00030740 1880            	  2826:     move.b  D0,($0000,A4)
                            	  2827:     ; If the object type we're initializing is not $49 (as in it's $4A),
                            	  2828:     ; then we'll make 4 traps.
                            	  2829:     ;
02:00030742 41EC034F        	  2830:     lea     ($034F,A4),A0
02:00030746 12302000        	  2831:     move.b  (A0,D2.W),D1
