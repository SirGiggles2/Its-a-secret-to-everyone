02:0003BF66 41EC0394        	  5215:     lea     ($0394,A4),A0
02:0003BF6A 10302000        	  5216:     move.b  (A0,D2.W),D0
02:0003BF6E 0200000F        	  5217:     andi.b #$0F,D0
02:0003BF72 6608            	  5218:     bne  _anon_z04_75
02:0003BF74 41EC0394        	  5219:     lea     ($0394,A4),A0
02:0003BF78 11802000        	  5220:     move.b  D0,(A0,D2.W)
                            	  5221: _anon_z04_75:
                            	  5222:     ; If not rushing (qspeed <> $60) and timer = 0, then
                            	  5223:     ; set timer to a random value up to $3F, and turn to face
                            	  5224:     ; an unblocked direction.
