02:0003280C 10302000        	  7528:     move.b  (A0,D2.W),D0
02:00032810 0C000003        	  7529:     cmpi.b  #$03,D0
02:00032814 6624            	  7530:     bne  _L_z01_BeginShove_Exit2
                            	  7531:     even
