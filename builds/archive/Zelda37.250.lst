                            	  5764: _anon_z05_120:
                            	  5765:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5766:     ;
                            	  5767:     ; Shutters and the commands to open a door always change
                            	  5768:     ; tiles.
                            	  5769:     ;
02:00043820 61000130        	  5770:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5771:     even
                            	  5772: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5773:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5774:     ; We need to remember how many tiles need to be copied
                            	  5775:     ; in each transfer record.
                            	  5776:     ;
02:00043824 102C0006        	  5777:     move.b  ($0006,A4),D0
02:00043828 19400004        	  5778:     move.b  D0,($0004,A4)
                            	  5779:     ; Write the transfer record header for the door.
                            	  5780:     ;
                            	  5781:     ;
                            	  5782:     ; VRAM address high byte of door
02:0004382C 1014            	  5783:     move.b  ($0000,A4),D0
02:0004382E 41EC0302        	  5784:     lea     ($0302,A4),A0
02:00043832 11802000        	  5785:     move.b  D0,(A0,D2.W)
02:00043836 5202            	  5786:     addq.b  #1,D2
02:00043838 102C0001        	  5787:     move.b  ($0001,A4),D0
02:0004383C 41EC0302        	  5788:     lea     ($0302,A4),A0
02:00043840 11802000        	  5789:     move.b  D0,(A0,D2.W)
02:00043844 5202            	  5790:     addq.b  #1,D2
02:00043846 102C0006        	  5791:     move.b  ($0006,A4),D0
02:0004384A 41EC0302        	  5792:     lea     ($0302,A4),A0
02:0004384E 11802000        	  5793:     move.b  D0,(A0,D2.W)
02:00043852 5202            	  5794:     addq.b  #1,D2
                            	  5795: _anon_z05_121:
                            	  5796:     ; Write two tiles in a short loop indexed by [04].
                            	  5797:     ;
02:00043854 6100ED1C        	  5798:     jsr     WriteDoorFaceTileHorizontally
02:00043858 66FA            	  5799:     bne  _anon_z05_121
                            	  5800:     ; OR the low VRAM address with $20 to go down one row
                            	  5801:     ; in order to work on the second row of door tiles.
                            	  5802:     ;
02:0004385A 7020            	  5803:     moveq   #32,D0
02:0004385C 122C0001        	  5804:     move.b  ($0001,A4),D1
02:00043860 8001            	  5805:     or.b  D1,D0
02:00043862 19400001        	  5806:     move.b  D0,($0001,A4)
                            	  5807:     ; Bottom of the loop.
                            	  5808:     ; Loop again to write the second transfer record for the
                            	  5809:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5810:     ;
02:00043866 532C0005        	  5811:     subq.b  #1,($0005,A4)
02:0004386A 66B8            	  5812:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5813:     ; Write the end marker, and update buffer length.
                            	  5814:     ;
02:0004386C 103C00FF        	  5815:     move.b  #$FF,D0
02:00043870 41EC0302        	  5816:     lea     ($0302,A4),A0
02:00043874 11802000        	  5817:     move.b  D0,(A0,D2.W)
02:00043878 1002            	  5818:     move.b  D2,D0
02:0004387A 19400301        	  5819:     move.b  D0,($0301,A4)
                            	  5820:     ; Increment the command.
                            	  5821:     ;
02:0004387E 522C0054        	  5822:     addq.b  #1,($0054,A4)
                            	  5823:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5824:     ; and resetting the door command.
                            	  5825:     ; This ends up catching original states 3 and 7.
                            	  5826:     ;
                            	  5827:     ; Else set door timer to 8 and return.
                            	  5828:     ;
02:00043882 102C0054        	  5829:     move.b  ($0054,A4),D0
02:00043886 02000003        	  5830:     andi.b #$03,D0
02:0004388A 6708            	  5831:     beq  _anon_z05_122
02:0004388C 7008            	  5832:     moveq   #8,D0
02:0004388E 19400027        	  5833:     move.b  D0,($0027,A4)
02:00043892 4E75            	  5834:     rts
                            	  5835: 
                            	  5836: _anon_z05_122:
                            	  5837:     ; If the door command = 4 after incrementing it, then
                            	  5838:     ; it was 3 (close door). So:
                            	  5839:     ; 1. reset this door's flag
                            	  5840:     ; 2. remove it from the opened door mask
                            	  5841:     ; 3. reset the door command
                            	  5842:     ; 4. go lay out doors in the play area map
                            	  5843:     ;
02:00043894 102C0054        	  5844:     move.b  ($0054,A4),D0
02:00043898 0C000004        	  5845:     cmpi.b  #$04,D0
02:0004389C 6626            	  5846:     bne  _anon_z05_123
02:0004389E 7400            	  5847:     moveq   #0,D2
02:000438A0 142C0009        	  5848:     move.b  ($0009,A4),D2
02:000438A4 6100DCE2        	  5849:     jsr     ResetDoorFlag
02:000438A8 102C0055        	  5850:     move.b  ($0055,A4),D0
02:000438AC 0A00000F        	  5851:     eori.b #$0F,D0
02:000438B0 122C00EE        	  5852:     move.b  ($00EE,A4),D1
02:000438B4 C001            	  5853:     and.b  D1,D0
                            	  5854:     even
                            	  5855: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:000438B6 194000EE        	  5856:     move.b  D0,($00EE,A4)
                            	  5857:     even
                            	  5858: L_ResetDoorCmdAndLayOutDoors:
02:000438BA 7000            	  5859:     moveq   #0,D0
02:000438BC 19400054        	  5860:     move.b  D0,($0054,A4)
02:000438C0 6000FCD4        	  5861:     jmp     LayOutDoors
                            	  5862: 
                            	  5863: _anon_z05_123:
                            	  5864:     ; Door command <> 4.
                            	  5865:     ; It must be 8, which means it was 7: open door.
                            	  5866:     ;
                            	  5867:     ; If the door is a shutter (7), then go add the door to the
                            	  5868:     ; opened door mask, reset door command, and lay out doors.
                            	  5869:     ;
02:000438C4 102C0055        	  5870:     move.b  ($0055,A4),D0
02:000438C8 19400002        	  5871:     move.b  D0,($0002,A4)
02:000438CC 6100FA32        	  5872:     jsr     FindDoorAttrByDoorBit
02:000438D0 0C000007        	  5873:     cmpi.b  #$07,D0
02:000438D4 676E            	  5874:     beq  _anon_z05_124
                            	  5875:     ; Else the door is not a shutter.
                            	  5876:     ;
                            	  5877:     ;
                            	  5878:     ; [09] door direction index
02:000438D6 7400            	  5879:     moveq   #0,D2
02:000438D8 142C0009        	  5880:     move.b  ($0009,A4),D2
02:000438DC 6100DCA4        	  5881:     jsr     SetDoorFlag
                            	  5882:     ; Get the next room's ID.
                            	  5883:     ;
02:000438E0 1003            	  5884:     move.b  D3,D0
02:000438E2 023C00EE        	  5885:     andi    #$EE,CCR  ; CLC: clear C+X
02:000438E6 41F9000437A2    	  5886:     lea     (DoorNextRoomIdOffsets).l,A0
02:000438EC 12302000        	  5887:     move.b  (A0,D2.W),D1
02:000438F0 D101            	  5888:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000438F2 7600            	  5889:     moveq   #0,D3
02:000438F4 1600            	  5890:     move.b  D0,D3
                            	  5891:     ; Flip the door direction index.
                            	  5892:     ;
02:000438F6 1002            	  5893:     move.b  D2,D0
02:000438F8 0A000001        	  5894:     eori.b #$01,D0
02:000438FC 7400            	  5895:     moveq   #0,D2
02:000438FE 1400            	  5896:     move.b  D0,D2
                            	  5897:     ; Set the door flag for the opposite door in the next room.
                            	  5898:     ;
02:00043900 1214            	  5899:     move.b  ($00,A4),D1   ; ptr lo
02:00043902 182C0001        	  5900:     move.b  ($01,A4),D4  ; ptr hi
02:00043906 024100FF        	  5901:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0004390A E14C            	  5902:     lsl.w   #8,D4
02:0004390C 8841            	  5903:     or.w    D1,D4             ; D4 = NES ptr addr
02:0004390E 48C4            	  5904:     ext.l   D4
02:00043910 D8BC00FF0000    	  5905:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00043916 2044            	  5906:     movea.l D4,A0
02:00043918 10303000        	  5907:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0004391C 41F90004AA5E    	  5908:     lea     (LevelMasks).l,A0
02:00043922 12302000        	  5909:     move.b  (A0,D2.W),D1
02:00043926 8001            	  5910:     or.b  D1,D0
02:00043928 1214            	  5911:     move.b  ($00,A4),D1   ; ptr lo
02:0004392A 182C0001        	  5912:     move.b  ($01,A4),D4  ; ptr hi
02:0004392E 024100FF        	  5913:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00043932 E14C            	  5914:     lsl.w   #8,D4
02:00043934 8841            	  5915:     or.w    D1,D4
02:00043936 48C4            	  5916:     ext.l   D4
02:00043938 D8BC00FF0000    	  5917:     add.l   #NES_RAM,D4
02:0004393E 2044            	  5918:     movea.l D4,A0
02:00043940 11803000        	  5919:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5920: _anon_z05_124:
                            	  5921:     ; Add the door to the opened door mask, reset door command,
                            	  5922:     ; and lay out doors.
                            	  5923:     ;
02:00043944 102C0055        	  5924:     move.b  ($0055,A4),D0
02:00043948 122C00EE        	  5925:     move.b  ($00EE,A4),D1
02:0004394C 8001            	  5926:     or.b  D1,D0
02:0004394E 6000FF66        	  5927:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5928: 
                            	  5929: ; Params:
                            	  5930: ; [08]: 0 if closed
                            	  5931: ;
                            	  5932: ; Returns:
                            	  5933: ; X: current length of dynamic transfer buf
                            	  5934: ; [00]: door VRAM address high byte
                            	  5935: ; [01]: door VRAM address low byte
                            	  5936: ; [02:03]: address of door tiles for direction and face
                            	  5937: ; [05]: 2, the number of transfer records to write
                            	  5938: ; [06]: 2, the number of tiles in each record
                            	  5939: ; [07]: 0, the first index of a tile to transfer
                            	  5940: ; [09]: door direction index
                            	  5941: ;
                            	  5942: ; Note that this routine is called with triggered doors:
                            	  5943: ; doors that can change state. Their door type numbers are >= 4.
                            	  5944: ;
                            	  5945: ; If this routine were ever called with a fixed door
                            	  5946: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5947: ; values for the door face.
                            	  5948: ;
                            	  5949: ;
                            	  5950: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5951: ;
                            	  5952:     even
                            	  5953: PrepareWriteHorizontalDoorTransferRecords:
02:00043952 102C0055        	  5954:     move.b  ($0055,A4),D0
02:00043956 19400002        	  5955:     move.b  D0,($0002,A4)
02:0004395A 6100F9A4        	  5956:     jsr     FindDoorAttrByDoorBit
02:0004395E 0C000005        	  5957:     cmpi.b  #$05,D0
02:00043962 650C            	  5958:     bcs  _anon_z05_125
02:00043964 1B00            	  5959:     move.b  D0,-(A5)  ; PHA
02:00043966 7004            	  5960:     moveq   #4,D0
02:00043968 4EB900030B8E    	  5961:     jsr     PlaySample
02:0004396E 101D            	  5962:     move.b  (A5)+,D0  ; PLA
                            	  5963: _anon_z05_125:
                            	  5964:     ; Calculate the door face index in three parts.
                            	  5965:     ;
                            	  5966:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5967:     ; (provisional face index in Y register).
                            	  5968:     ;
02:00043970 0C000004        	  5969:     cmpi.b  #$04,D0
02:00043974 6602            	  5970:     bne  _anon_z05_126
02:00043976 7008            	  5971:     moveq   #8,D0
                            	  5972: _anon_z05_126:
02:00043978 0C000001        	  5973:     cmpi.b  #$01,D0
02:0004397C 6602            	  5974:     bne  _anon_z05_127
02:0004397E 7004            	  5975:     moveq   #4,D0
                            	  5976: _anon_z05_127:
                            	  5977:     ; Second, subtract 3 from provisional face index.
                            	  5978:     ;
02:00043980 003C0011        	  5979:     ori     #$11,CCR  ; SEC: set C+X
02:00043984 123C0003        	  5980:     move.b  #$03,D1
02:00043988 0A3C0010        	  5981:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004398C 9101            	  5982:     subx.b  D1,D0   ; SBC #$03
02:0004398E 0A3C0010        	  5983:     eori    #$10,CCR  ; restore X = 6502 C
02:00043992 7600            	  5984:     moveq   #0,D3
02:00043994 1600            	  5985:     move.b  D0,D3
                            	  5986:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5987:     ; face index >= 3, then subtract 1 from it.
                            	  5988:     ;
                            	  5989:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5990:     ; then make it 1.
                            	  5991:     ;
02:00043996 102C0008        	  5992:     move.b  ($0008,A4),D0
02:0004399A 6708            	  5993:     beq  _anon_z05_128
02:0004399C 0C030005        	  5994:     cmpi.b  #$05,D3
02:000439A0 670A            	  5995:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439A2 7601            	  5996:     moveq   #1,D3
                            	  5997: _anon_z05_128:
02:000439A4 0C030003        	  5998:     cmpi.b  #$03,D3
02:000439A8 6502            	  5999:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:000439AA 5303            	  6000:     subq.b  #1,D3
                            	  6001:     even
                            	  6002: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  6003:     ; The routine that returned the door type also returned its
                            	  6004:     ; reverse direction index in [03].
                            	  6005:     ;
                            	  6006:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  6007:     ;
02:000439AC 7003            	  6008:     moveq   #3,D0
02:000439AE 003C0011        	  6009:     ori     #$11,CCR  ; SEC: set C+X
02:000439B2 122C0003        	  6010:     move.b  ($0003,A4),D1
02:000439B6 0A3C0010        	  6011:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000439BA 9101            	  6012:     subx.b  D1,D0   ; SBC $03
02:000439BC 0A3C0010        	  6013:     eori    #$10,CCR  ; restore X = 6502 C
                            	  6014:     ; Call this to put the address of door face tiles in [02:03].
                            	  6015:     ;
02:000439C0 6100FD7A        	  6016:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  6017:     ; Return the address of the door in the nametable in [01:00].
                            	  6018:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  6019:     ;
02:000439C4 41F90004379A    	  6020:     lea     (DoorVramAddrsHi).l,A0
02:000439CA 10302000        	  6021:     move.b  (A0,D2.W),D0
02:000439CE 1880            	  6022:     move.b  D0,($0000,A4)
02:000439D0 41F90004379E    	  6023:     lea     (DoorVramAddrsLo).l,A0
02:000439D6 10302000        	  6024:     move.b  (A0,D2.W),D0
02:000439DA 19400001        	  6025:     move.b  D0,($0001,A4)
                            	  6026:     ; Return the direction of the door in [09], and the dynamic
