02:0002BF8E 670A            	  2209:     beq.s   .cc_cnr
02:0002BF90 003C0001        	  2210:     ori     #$01,CCR
02:0002BF94 0A3C0001        	  2211:     eori    #$01,CCR
02:0002BF98 4E75            	  2212:     rts
                            	  2213: .cc_cnr:
02:0002BF9A 023C00FE        	  2214:     andi    #$FE,CCR
02:0002BF9E 0A3C0001        	  2215:     eori    #$01,CCR
02:0002BFA2 4E75            	  2216:     rts
