                            	 12571: _L_z04_Ganon_DrawBurst_DrawClouds:
                            	 12572:     ; Draw the four clouds at diagonal corners.
                            	 12573:     ;
02:0003F5B2 610000B6        	 12574:     jsr     Ganon_GetCurCloudLeft
02:0003F5B6 610000BE        	 12575:     jsr     Ganon_GetCurCloudTop
02:0003F5BA 61A0            	 12576:     jsr     Ganon_DrawCloud
02:0003F5BC 610000B2        	 12577:     jsr     Ganon_GetCurCloudRight
02:0003F5C0 619A            	 12578:     jsr     Ganon_DrawCloud
02:0003F5C2 610000A6        	 12579:     jsr     Ganon_GetCurCloudLeft
02:0003F5C6 610000B4        	 12580:     jsr     Ganon_GetCurCloudBottom
02:0003F5CA 6190            	 12581:     jsr     Ganon_DrawCloud
02:0003F5CC 610000A2        	 12582:     jsr     Ganon_GetCurCloudRight
