                            	  5950: UpdateSwordOrRod:
                            	  5951:     ; If state = 0, the object is not active. So, return.
                            	  5952:     ;
02:0004C64E 41EC00AC        	  5953:     lea     ($00AC,A4),A0
02:0004C652 10302000        	  5954:     move.b  (A0,D2.W),D0
02:0004C656 0200000F        	  5955:     andi.b #$0F,D0
02:0004C65A 674C            	  5956:     beq  _L_z07_UpdateSwordOrRod_Exit
                            	  5957:     ; Decrement the state timer.
                            	  5958:     ; If it hasn't expired, go move the sword or rod.
                            	  5959:     ;
02:0004C65C 41EC03D0        	  5960:     lea     ($03D0,A4),A0
02:0004C660 53302000        	  5961:     subq.b  #1,(A0,D2.W)
02:0004C664 6644            	  5962:     bne  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
                            	  5963:     ; State 2 will last 8 frames. The higher ones last 1.
                            	  5964:     ;
02:0004C666 41EC00AC        	  5965:     lea     ($00AC,A4),A0
02:0004C66A 10302000        	  5966:     move.b  (A0,D2.W),D0
02:0004C66E 0200000F        	  5967:     andi.b #$0F,D0
02:0004C672 7600            	  5968:     moveq   #0,D3
02:0004C674 1600            	  5969:     move.b  D0,D3
02:0004C676 7008            	  5970:     moveq   #8,D0
02:0004C678 5303            	  5971:     subq.b  #1,D3
