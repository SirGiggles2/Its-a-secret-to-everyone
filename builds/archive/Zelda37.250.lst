                            	  5135: DrawCredits:
                            	  5136:     ; Make a transfer record of a full row of blank tiles.
                            	  5137:     ;
02:00036CB2 761F            	  5138:     moveq   #31,D3
02:00036CB4 7024            	  5139:     moveq   #36,D0
                            	  5140: _anon_z02_41:
