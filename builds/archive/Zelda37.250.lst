02:0003AA92 102C066C        	  2285:     move.b  ($066C,A4),D0
02:0003AA96 1234203D        	  2286:     move.b  ($3D,A4,D2.W),D1
02:0003AA9A 8001            	  2287:     or.b  D1,D0
02:0003AA9C 6610            	  2288:     bne  _L_z04__TryShooting_ZeroSpeed
                            	  2289:     ; Shoot.
                            	  2290:     ;
02:0003AA9E 1014            	  2291:     move.b  ($0000,A4),D0
02:0003AAA0 611E            	  2292:     jsr     _ShootIfWanted2
                            	  2293:     ; If it failed, go set a non-zero speed.
                            	  2294:     ;
