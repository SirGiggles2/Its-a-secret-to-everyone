                            	  9694: _L_z04_UpdateGohma_AnimateEye:
                            	  9695:     ; Animate the eye.
                            	  9696:     ;
                            	  9697:     ; First, if the counter for when to open the eye next = 0, then
                            	  9698:     ; set it to a random value at least $C0; and set the timer for
                            	  9699:     ; keeping the eye open to $80.
                            	  9700:     ;
                            	  9701:     ; Note that $C0 is not a number of frames, because it's changed
                            	  9702:     ; every other frame.
                            	  9703:     ;
02:0003E0A6 41EC042C        	  9704:     lea     ($042C,A4),A0
02:0003E0AA 10302000        	  9705:     move.b  (A0,D2.W),D0
02:0003E0AE 661E            	  9706:     bne  _L_z04_UpdateGohma_DecNextOpenEyeCounter
02:0003E0B0 103C0080        	  9707:     move.b  #$80,D0
02:0003E0B4 41EC0444        	  9708:     lea     ($0444,A4),A0
02:0003E0B8 11802000        	  9709:     move.b  D0,(A0,D2.W)
02:0003E0BC 103C00C0        	  9710:     move.b  #$C0,D0
02:0003E0C0 12342018        	  9711:     move.b  ($18,A4,D2.W),D1
02:0003E0C4 8001            	  9712:     or.b  D1,D0
02:0003E0C6 41EC042C        	  9713:     lea     ($042C,A4),A0
02:0003E0CA 11802000        	  9714:     move.b  D0,(A0,D2.W)
                            	  9715:     even
                            	  9716: _L_z04_UpdateGohma_DecNextOpenEyeCounter:
                            	  9717:     ; Decrement the next-open-eye counter.
                            	  9718:     ;
02:0003E0CE 102C0015        	  9719:     move.b  ($0015,A4),D0
02:0003E0D2 E208            	  9720:     lsr.b  #1,D0   ; LSR A
02:0003E0D4 6408            	  9721:     bcc  _anon_z04_122
02:0003E0D6 41EC042C        	  9722:     lea     ($042C,A4),A0
02:0003E0DA 53302000        	  9723:     subq.b  #1,(A0,D2.W)
                            	  9724: _anon_z04_122:
                            	  9725:     ; If open eye timer = 0, then the eye is closed.
                            	  9726:     ; Go animate it differently.
                            	  9727:     ;
