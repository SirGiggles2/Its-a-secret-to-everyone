                            	  3909: __far_z_04_0035:
                            	  3910:     ; State 0.
                            	  3911:     ;
                            	  3912:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  3913:     ;
02:0003B5EC 102C0084        	  3914:     move.b  ($0084,A4),D0
02:0003B5F0 0C0000AD        	  3915:     cmpi.b  #$AD,D0
02:0003B5F4 661E            	  3916:     bne  _L_z04_UpdatePondFairy_Exit
                            	  3917:     ; If Link's X < $70 or >= $81, then return.
                            	  3918:     ;
02:0003B5F6 102C0070        	  3919:     move.b  ($0070,A4),D0
02:0003B5FA 0C000070        	  3920:     cmpi.b  #$70,D0
02:0003B5FE 6514            	  3921:     bcs  _L_z04_UpdatePondFairy_Exit
02:0003B600 0C000081        	  3922:     cmpi.b  #$81,D0
02:0003B604 640E            	  3923:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  3924:     ; Link is at the edge of the pond. Advance to state 1,
                            	  3925:     ; halt Link, and start filling hearts.
                            	  3926:     ;
02:0003B606 522C00AD        	  3927:     addq.b  #1,($00AD,A4)
02:0003B60A 7040            	  3928:     moveq   #64,D0
02:0003B60C 194000AC        	  3929:     move.b  D0,($00AC,A4)
02:0003B610 19400063        	  3930:     move.b  D0,($0063,A4)
                            	  3931:     even
                            	  3932: _L_z04_UpdatePondFairy_Exit:
02:0003B614 4E75            	  3933:     rts
                            	  3934: 
                            	  3935:     even
                            	  3936: PondFairy_HandleOtherStates:
02:0003B616 0C000001        	  3937:     cmpi.b  #$01,D0
02:0003B61A 6610            	  3938:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  3939:     ; State 1. Flying and filling hearts.
                            	  3940:     ;
                            	  3941:     ; If still filling hearts, then go draw Link and hearts.
                            	  3942:     ;
02:0003B61C 102C0063        	  3943:     move.b  ($0063,A4),D0
02:0003B620 6620            	  3944:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3945:     ; If not filling hearts anymore, then go to state 2,
                            	  3946:     ; and set Link's object timer to $50, to keep showing hearts
                            	  3947:     ; a little while after we finish filling hearts.
                            	  3948:     ;
02:0003B622 522C00AD        	  3949:     addq.b  #1,($00AD,A4)
02:0003B626 7050            	  3950:     moveq   #80,D0
02:0003B628 19400029        	  3951:     move.b  D0,($0029,A4)
                            	  3952:     even
                            	  3953: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  3954:     ; If state <> 2 (so, it's 3), then return.
                            	  3955:     ;
                            	  3956:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  3957:     ; In this case, A has $50 -- the value that Link's object timer
                            	  3958:     ; was set to, and we'll return.
                            	  3959:     ;
02:0003B62C 0C000002        	  3960:     cmpi.b  #$02,D0
02:0003B630 6634            	  3961:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  3962:     ; State = 2.
                            	  3963:     ;
                            	  3964:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  3965:     ;
02:0003B632 102C0029        	  3966:     move.b  ($0029,A4),D0
02:0003B636 660A            	  3967:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  3968:     ; Else go to state 3, and unhalt Link.
                            	  3969:     ;
02:0003B638 522C00AD        	  3970:     addq.b  #1,($00AD,A4)
02:0003B63C 7000            	  3971:     moveq   #0,D0
02:0003B63E 194000AC        	  3972:     move.b  D0,($00AC,A4)
                            	  3973:     even
