                            	   692: ;==============================================================================
                            	   693: ; IMPORT side — C callers invoke these; we marshal stack args into registers
                            	   694: ; and tail-call the native asm function.
                            	   695: ;
                            	   696: ; GCC 13 m68k passes the first int/ptr arg as a 32-bit value at SP+4.
                            	   697: ; For byte/word args the caller still pushes a full longword (zero- or
                            	   698: ; sign-extended).
                            	   699: ;==============================================================================
                            	   700: 
                            	   701: ;------------------------------------------------------------------------------
                            	   702: ; void c_copy_bank_to_window(unsigned int bank);
