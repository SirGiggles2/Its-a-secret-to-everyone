02:00039F48 41EC03BC        	   671:     lea     ($03BC,A4),A0
02:00039F4C 11803000        	   672:     move.b  D0,(A0,D3.W)
                            	   673:     ; For boomerangs, move up to $51 pixels (horizontally or vertically).
                            	   674:     ;
