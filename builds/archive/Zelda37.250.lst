02:0003F0A0 122C04E6        	 11832:     move.b  ($04E6,A4),D1
02:0003F0A4 D101            	 11833:     addx.b  D1,D0   ; ADC Lamnola_Speed
02:0003F0A6 41EC0084        	 11834:     lea     ($0084,A4),A0
