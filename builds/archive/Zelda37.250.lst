                            	   658: 
                            	   659: ;------------------------------------------------------------------------------
                            	   660: ; _c_move_object_shim — MoveObject trampoline.
                            	   661: ;
                            	   662: ; Asm contract (see tools/transpile_6502.py:5260-5264 P48 comment block):
                            	   663: ;   Input:     D2 = slot (0..11)
                            	   664: ;   Preserves: D2, A4, A5
                            	   665: ;   Clobbers:  D0, D1, D3, A0
                            	   666: ;   Returns:   via rts with unspecified CCR (callers never BCC).
                            	   667: ;
                            	   668: ; GCC side:
                            	   669: ;   void c_move_object(unsigned short slot);
                            	   670: ;     slot arrives as a 16-bit value on the stack.
                            	   671: ;   GCC preserves D2-D7/A2-A6 across C calls (callee-save).
                            	   672: ;   -ffixed-a4 globally reserves A4 so the pinned NES_RAM pointer is
                            	   673: ;   never clobbered by gcc.
                            	   674: ;   A5 is NOT touched by any C code (audit-enforced: no (A5)+ / -(A5)
                            	   675: ;   semantics can exist in a pure C port).
                            	   676: ;------------------------------------------------------------------------------
                            	   677: _c_move_object_shim:
                            	   678:     ; DEBUG canary: write $AA to NES RAM $0900 each time we're called
02:0002B650 197C00AA0900    	   679:     move.b  #$AA,($0900,A4)
                            	   680:     ; GCC 13 m68k reads the first arg via `move.l 4(%sp),%d0` — a full
                            	   681:     ; 32-bit load at SP+4 (after the return address). Big-endian means
                            	   682:     ; the slot value must sit in the LOW byte of that longword, i.e.
                            	   683:     ; at SP+7. We push a zero-extended 32-bit longword with D2 in the
                            	   684:     ; low position. moveq is safe because slot range is 0..11.
02:0002B656 7000            	   685:     moveq   #0,D0
