                            	  6406: _L_z01_CheckLinkCollisionPreinit_FacingOpposite:
                            	  6407:     ; Link and the shot are facing opposite directions.
                            	  6408:     ; Link can parry certain weapons/shots.
                            	  6409:     ;
                            	  6410:     ; For flying rock, $54, arrow, and boomerang, this means
                            	  6411:     ; no harmful collision; but it still counts as a shot collision.
                            	  6412:     ; So, go treat this as a parry.
                            	  6413:     ;
02:00032144 41EC034F        	  6414:     lea     ($034F,A4),A0
02:00032148 10302000        	  6415:     move.b  (A0,D2.W),D0
02:0003214C 0C000055        	  6416:     cmpi.b  #$55,D0
02:00032150 650E            	  6417:     bcs  _L_z01_CheckLinkCollisionPreinit_Parry
02:00032152 0C00005B        	  6418:     cmpi.b  #$5B,D0
02:00032156 6408            	  6419:     bcc  _L_z01_CheckLinkCollisionPreinit_Parry
                            	  6420:     ; If the magic shield is missing, then the rest of the shots do damage.
                            	  6421:     ; So, go harm Link.
