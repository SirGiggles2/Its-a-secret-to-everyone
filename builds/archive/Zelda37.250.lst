02:0003B50E 11802000        	  3787:     move.b  D0,(A0,D2.W)
02:0003B512 41EC0098        	  3788:     lea     ($0098,A4),A0
02:0003B516 11802000        	  3789:     move.b  D0,(A0,D2.W)
                            	  3790:     ; Every other frame, return without drawing.
