02:00030326 73
02:00030327 44
02:00030328 0A
02:00030329 21
02:0003032A 41
02:0003032B 6C
                            	  2217: 
                            	  2218:     even
                            	  2219: UpdateWhirlwind_Full:
                            	  2220:     ; Get Link's halted state.
                            	  2221:     ;
02:0003032C 102C00AC        	  2222:     move.b  ($00AC,A4),D0
02:00030330 02000040        	  2223:     andi.b #$40,D0
02:00030334 7600            	  2224:     moveq   #0,D3
02:00030336 1600            	  2225:     move.b  D0,D3
                            	  2226:     ; Add 2 to whirlwind X.
                            	  2227:     ;
02:00030338 7002            	  2228:     moveq   #2,D0
02:0003033A 023C00EE        	  2229:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003033E 12342070        	  2230:     move.b  ($70,A4,D2.W),D1
02:00030342 D101            	  2231:     addx.b  D1,D0   ; ADC ObjX,X
02:00030344 19802070        	  2232:     move.b  D0,($70,A4,D2.W)
                            	  2233:     ; If Link is not halted or teleporting state = 0, then
                            	  2234:     ; go check for collision with Link.
                            	  2235:     ;
02:00030348 0C030040        	  2236:     cmpi.b  #$40,D3
02:0003034C 6638            	  2237:     bne  _L_z01_UpdateWhirlwind_Full_CheckCollision
02:0003034E 7600            	  2238:     moveq   #0,D3
02:00030350 162C0522        	  2239:     move.b  ($0522,A4),D3
02:00030354 6730            	  2240:     beq  _L_z01_UpdateWhirlwind_Full_CheckCollision
                            	  2241:     ; Else Link is halted (state $40) and teleporting state <> 0.
                            	  2242:     ;
                            	  2243:     ; Set Link's X to whirlwind's.
                            	  2244:     ;
02:00030356 19400070        	  2245:     move.b  D0,($0070,A4)
                            	  2246:     ; If teleporting state = 1 or whirlwind's X <> $80, go check
                            	  2247:     ; the right screen edge and draw.
                            	  2248:     ;
02:0003035A 5303            	  2249:     subq.b  #1,D3
02:0003035C 6776            	  2250:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
02:0003035E 0C000080        	  2251:     cmpi.b  #$80,D0
02:00030362 6670            	  2252:     bne  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2253:     ; Teleporting state = 2 and whirlwind's X = $80.
                            	  2254:     ;
                            	  2255:     ; Reset Link's state, teleporting state, and whirlwind object type.
                            	  2256:     ;
02:00030364 E308            	  2257:     lsl.b  #1,D0   ; ASL A
02:00030366 194000AC        	  2258:     move.b  D0,($00AC,A4)
02:0003036A 19400522        	  2259:     move.b  D0,($0522,A4)
02:0003036E 41EC034F        	  2260:     lea     ($034F,A4),A0
02:00030372 11802000        	  2261:     move.b  D0,(A0,D2.W)
                            	  2262:     ; Update the player position marker, and draw one last time.
                            	  2263:     ;
02:00030376 1002            	  2264:     move.b  D2,D0
02:00030378 1B00            	  2265:     move.b  D0,-(A5)  ; PHA
02:0003037A 61000FE8        	  2266:     jsr     UpdatePlayerPositionMarker
02:0003037E 101D            	  2267:     move.b  (A5)+,D0  ; PLA
02:00030380 7400            	  2268:     moveq   #0,D2
02:00030382 1400            	  2269:     move.b  D0,D2
02:00030384 6070            	  2270:     jmp     _L_z01_UpdateWhirlwind_Full_Draw
                            	  2271: 
                            	  2272:     even
                            	  2273: _L_z01_UpdateWhirlwind_Full_CheckCollision:
                            	  2274:     ; Link is not halted or teleporting state = 0.
                            	  2275:     ; Try to pick up Link.
                            	  2276:     ;
                            	  2277:     ; If the whirlwind does not collide with Link, then go check
                            	  2278:     ; for the screen's right edge.
                            	  2279:     ;
02:00030386 61001CB8        	  2280:     jsr     CheckLinkCollision
02:0003038A 102C0006        	  2281:     move.b  ($0006,A4),D0
02:0003038E 6744            	  2282:     beq  _L_z01_UpdateWhirlwind_Full_CheckRightEdge
                            	  2283:     ; Collided with Link.
                            	  2284:     ;
                            	  2285:     ; Make Link face right. Reset shove info and subroom type.
                            	  2286:     ;
02:00030390 7001            	  2287:     moveq   #1,D0
02:00030392 19400098        	  2288:     move.b  D0,($0098,A4)
