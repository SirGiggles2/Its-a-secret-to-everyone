                            	  2296:     ; It succeeded, so reset "wants to shoot" flag and the speed.
                            	  2297:     ;
02:0003AAA4 7000            	  2298:     moveq   #0,D0
02:0003AAA6 41EC0412        	  2299:     lea     ($0412,A4),A0
