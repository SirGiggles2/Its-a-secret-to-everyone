                            	  5696:     ; Chase while flying, as usual.
                            	  5697:     ;
02:0003C35E 610039CC        	  5698:     jsr     Flyer_Chase
                            	  5699:     ; If timer has not expired, then
                            	  5700:     ; go see if it's time to propagate direction changes down the chain.
                            	  5701:     ;
02:0003C362 10342028        	  5702:     move.b  ($28,A4,D2.W),D0
02:0003C366 6702            	  5703:     beq.s  __far_z_04_0041
