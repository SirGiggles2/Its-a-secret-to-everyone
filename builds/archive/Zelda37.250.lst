02:0004C70E 19802070        	  6049:     move.b  D0,($70,A4,D2.W)
02:0004C712 1880            	  6050:     move.b  D0,($0000,A4)
                            	  6051:     ; Set object's Y to player's Y + offset for state and direction.
                            	  6052:     ; Copy the result to [01].
                            	  6053:     ;
02:0004C714 102C0084        	  6054:     move.b  ($0084,A4),D0
02:0004C718 023C00EE        	  6055:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C71C 41F90004C63E    	  6056:     lea     (PlayerToWeaponOffsetsY).l,A0
02:0004C722 12303000        	  6057:     move.b  (A0,D3.W),D1
02:0004C726 D101            	  6058:     addx.b  D1,D0   ; ADC PlayerToWeaponOffsetsY,Y
02:0004C728 41EC0084        	  6059:     lea     ($0084,A4),A0
02:0004C72C 11802000        	  6060:     move.b  D0,(A0,D2.W)
02:0004C730 19400001        	  6061:     move.b  D0,($0001,A4)
                            	  6062:     ; If state = 1, use up direction.
                            	  6063:     ; Else use object direction.
