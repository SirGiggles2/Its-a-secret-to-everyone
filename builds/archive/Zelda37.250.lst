02:0003B0FE 0200000C        	  3179:     andi.b #$0C,D0
02:0003B102 6742            	  3180:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  3181:     ; Begin with the leever's X set to Link's X.
                            	  3182:     ;
