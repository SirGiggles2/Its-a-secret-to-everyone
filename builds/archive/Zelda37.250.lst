02:00041DBC 12342070        	  3504:     move.b  ($70,A4,D2.W),D1
02:00041DC0 0A3C0010        	  3505:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041DC4 9101            	  3506:     subx.b  D1,D0   ; SBC ObjX,X
02:00041DC6 0A3C0010        	  3507:     eori    #$10,CCR  ; restore X = 6502 C
