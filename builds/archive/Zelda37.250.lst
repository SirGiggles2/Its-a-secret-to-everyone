                            	  7291: Dodongo_Draw:
02:0003CE80 610000F4        	  7292:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7293:     ; Make a 5-way direction index out of the facing direction
                            	  7294:     ; by shifting right once, and store it in [00].
                            	  7295:     ;
02:0003CE84 41EC0098        	  7296:     lea     ($0098,A4),A0
02:0003CE88 10302000        	  7297:     move.b  (A0,D2.W),D0
02:0003CE8C E208            	  7298:     lsr.b  #1,D0   ; LSR A
02:0003CE8E 1880            	  7299:     move.b  D0,($0000,A4)
                            	  7300:     ; If state = 0, go handle animating the two frames of this state.
                            	  7301:     ;
02:0003CE90 7600            	  7302:     moveq   #0,D3
02:0003CE92 41EC00AC        	  7303:     lea     ($00AC,A4),A0
02:0003CE96 16302000        	  7304:     move.b  (A0,D2.W),D3
02:0003CE9A 6744            	  7305:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7306:     ; If state > 1, then the monster is stunned (state 2).
                            	  7307:     ; So, go switch frames every $20 screen frames.
                            	  7308:     ;
02:0003CE9C 7020            	  7309:     moveq   #32,D0
02:0003CE9E 5303            	  7310:     subq.b  #1,D3
02:0003CEA0 6640            	  7311:     bne  _L_z04_Dodongo_Draw_DrawWalking
                            	  7312:     ; State = 1. Bloated.
                            	  7313:     ;
                            	  7314:     ; In substate 0, go animate as usual for walking.
                            	  7315:     ;
02:0003CEA2 7600            	  7316:     moveq   #0,D3
02:0003CEA4 41EC042C        	  7317:     lea     ($042C,A4),A0
02:0003CEA8 16302000        	  7318:     move.b  (A0,D2.W),D3
02:0003CEAC 6732            	  7319:     beq  _L_z04_Dodongo_Draw_DrawWalkingFast
                            	  7320:     ; If in bloated substates 2 or 3 (last wait or die), then
                            	  7321:     ; go fade the boss; so that some frames are not drawn.
                            	  7322:     ;
02:0003CEAE 0C030002        	  7323:     cmpi.b  #$02,D3
02:0003CEB2 6718            	  7324:     beq  _L_z04_Dodongo_Draw_DrawFaded
02:0003CEB4 0C030003        	  7325:     cmpi.b  #$03,D3
02:0003CEB8 6712            	  7326:     beq  _L_z04_Dodongo_Draw_DrawFaded
                            	  7327:     ; State 1, substate 1
                            	  7328:     ;
                            	  7329:     ; Add $14 to the frame image index to index into the bloated
                            	  7330:     ; frame images and H-flips.
                            	  7331:     ;
02:0003CEBA 1014            	  7332:     move.b  ($0000,A4),D0
02:0003CEBC 023C00EE        	  7333:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEC0 123C0014        	  7334:     move.b  #$14,D1
02:0003CEC4 D101            	  7335:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0003CEC6 7600            	  7336:     moveq   #0,D3
02:0003CEC8 1600            	  7337:     move.b  D0,D3
02:0003CECA 6032            	  7338:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7339: 
                            	  7340:     even
                            	  7341: _L_z04_Dodongo_Draw_DrawFaded:
                            	  7342:     ; In bloated substates 2 and 3:
                            	  7343:     ; Every two screen frames, don't draw for two frames. Return.
                            	  7344:     ;
02:0003CECC 102C0015        	  7345:     move.b  ($0015,A4),D0
02:0003CED0 02000002        	  7346:     andi.b #$02,D0
02:0003CED4 6604            	  7347:     bne.s  __far_z_04_0066
02:0003CED6 600000A4        	  7348:     jmp  L11B00_Exit
                            	  7349: __far_z_04_0066:
02:0003CEDA 7600            	  7350:     moveq   #0,D3
02:0003CEDC 1614            	  7351:     move.b  ($0000,A4),D3
02:0003CEDE 601E            	  7352:     jmp     _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7353: 
                            	  7354:     even
                            	  7355: _L_z04_Dodongo_Draw_DrawWalkingFast:
                            	  7356:     ; Every 8 screen frames, switch between 2 animation frames.
