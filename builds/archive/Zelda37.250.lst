                            	  7492:     ;
02:000327C0 41EC04BF        	  7493:     lea     ($04BF,A4),A0
02:000327C4 10302000        	  7494:     move.b  (A0,D2.W),D0
02:000327C8 02000080        	  7495:     andi.b #$80,D0
