02:00032214 102C066F        	  6525:     move.b  ($066F,A4),D0
02:00032218 003C0011        	  6526:     ori     #$11,CCR  ; SEC: set C+X
02:0003221C 122C000D        	  6527:     move.b  ($000D,A4),D1
02:00032220 0A3C0010        	  6528:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032224 9101            	  6529:     subx.b  D1,D0   ; SBC $0D
02:00032226 0A3C0010        	  6530:     eori    #$10,CCR  ; restore X = 6502 C
02:0003222A 1940066F        	  6531:     move.b  D0,($066F,A4)
