02:00044BB2 19400303        	  7759:     move.b  D0,($0303,A4)
02:00044BB6 7060            	  7760:     moveq   #96,D0
02:00044BB8 19400304        	  7761:     move.b  D0,($0304,A4)
02:00044BBC 7024            	  7762:     moveq   #36,D0
02:00044BBE 19400305        	  7763:     move.b  D0,($0305,A4)
02:00044BC2 103C00FF        	  7764:     move.b  #$FF,D0
02:00044BC6 19400306        	  7765:     move.b  D0,($0306,A4)
