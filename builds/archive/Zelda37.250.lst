                            	  9731:     ; Else decrement the open eye timer.
                            	  9732:     ;
02:0003E0E8 41EC0444        	  9733:     lea     ($0444,A4),A0
02:0003E0EC 53302000        	  9734:     subq.b  #1,(A0,D2.W)
                            	  9735:     ; If open eye timer >= $70 and < $10, then the eye is fully open.
                            	  9736:     ; So, set its frame image to 2. Else use 3 for a half open eye.
                            	  9737:     ;
02:0003E0F0 7602            	  9738:     moveq   #2,D3
02:0003E0F2 0C000070        	  9739:     cmpi.b  #$70,D0
02:0003E0F6 6408            	  9740:     bcc  _anon_z04_123
02:0003E0F8 0C000010        	  9741:     cmpi.b  #$10,D0
02:0003E0FC 6502            	  9742:     bcs  _anon_z04_123
02:0003E0FE 5203            	  9743:     addq.b  #1,D3
