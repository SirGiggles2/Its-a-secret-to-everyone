02:0003E026 E309            	  9639:     lsl.b  #1,D1   ; ASL $02
02:0003E028 19410002        	  9640:     move.b  D1,($0002,A4)
02:0003E02C 122C0002        	  9641:     move.b  ($0002,A4),D1
02:0003E030 C200            	  9642:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E032 6704            	  9643:     beq  _anon_z04_119
02:0003E034 53342070        	  9644:     subq.b  #1,($70,A4,D2.W)
                            	  9645: _anon_z04_119:
