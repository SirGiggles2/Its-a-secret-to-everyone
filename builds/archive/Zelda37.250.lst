                            	   933: InitMode7_Sub2:
                            	   934:     ; This transfers a room's play area tiles to nametable 2.
                            	   935:     ;
                            	   936:     ; CurRow starts at the bottom ($15).
02:000406C0 61003764        	   937:     jsr     CopyRowToTileBuf
02:000406C4 102C0302        	   938:     move.b  ($0302,A4),D0
                            	   939:     ; Change the target nametable from 0 to 2.
                            	   940:     ;
                            	   941:     ; Because there's only a play area and no status bar in
                            	   942:     ; nametable 2, you have to add 7 to the high byte instead of 8.
                            	   943:     ; So, the top of the play area in NT 0 is at $2100.
                            	   944:     ; But the top of the play area in NT 2 is at $2800.
                            	   945:     ;
                            	   946:     ; This assumes that you want to scroll vertically, where the
                            	   947:     ; two scroll areas must be contiguous vertically.
02:000406C8 0200000F        	   948:     andi.b #$0F,D0
02:000406CC 023C00EE        	   949:     andi    #$EE,CCR  ; CLC: clear C+X
02:000406D0 123C0027        	   950:     move.b  #$27,D1
02:000406D4 D101            	   951:     addx.b  D1,D0   ; ADC #$27 (X flag = 6502 C)
02:000406D6 19400302        	   952:     move.b  D0,($0302,A4)
02:000406DA 102C0098        	   953:     move.b  ($0098,A4),D0
02:000406DE 0C000004        	   954:     cmpi.b  #$04,D0
02:000406E2 6404            	   955:     bcc  _anon_z05_20
                            	   956:     ; then you DO have to account for the status bar.
                            	   957:     ; So, add $100 (by incrementing high byte) to move
                            	   958:     ; everything down 64 pixels.
                            	   959:     ;
                            	   960:     ; Now the play areas will line up in NT 0 and NT 2 when
                            	   961:     ; we change mirroring to vertical at the end of this mode.
02:000406E4 522C0302        	   962:     addq.b  #1,($0302,A4)
                            	   963: _anon_z05_20:
02:000406E8 532C00E9        	   964:     subq.b  #1,($00E9,A4)
02:000406EC 6A06            	   965:     bpl  _anon_z05_21
                            	   966:     even
