02:00041D9E 023C00EE        	  3495:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041DA2 123C0003        	  3496:     move.b  #$03,D1
02:00041DA6 D101            	  3497:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041DA8 41EC0084        	  3498:     lea     ($0084,A4),A0
