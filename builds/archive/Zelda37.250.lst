02:0002E9C0 41EC0422        	   927:     lea     ($0422,A4),A0
02:0002E9C4 10302000        	   928:     move.b  (A0,D2.W),D0
02:0002E9C8 0200003F        	   929:     andi.b #$3F,D0
02:0002E9CC 0C00003F        	   930:     cmpi.b  #$3F,D0
02:0002E9D0 6732            	   931:     beq  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   932:     ; If Link's X <> item's X, then loop again.
