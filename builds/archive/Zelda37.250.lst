02:00039F64 7003            	   685:     moveq   #3,D0
02:00039F66 41EC03D0        	   686:     lea     ($03D0,A4),A0
02:00039F6A 11803000        	   687:     move.b  D0,(A0,D3.W)
                            	   688:     ; Have the monster wait a random amount of time, up to $3F frames.
