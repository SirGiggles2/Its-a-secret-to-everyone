                            	  7406: _L_z04_Dodongo_Draw_DrawRightSide:
02:0003CF3A 101D            	  7407:     move.b  (A5)+,D0  ; PLA
02:0003CF3C 7600            	  7408:     moveq   #0,D3
02:0003CF3E 1600            	  7409:     move.b  D0,D3
                            	  7410:     ; If facing vertically, then return. There's no other side to draw.
                            	  7411:     ;
02:0003CF40 41EC0098        	  7412:     lea     ($0098,A4),A0
02:0003CF44 10302000        	  7413:     move.b  (A0,D2.W),D0
02:0003CF48 02000003        	  7414:     andi.b #$03,D0
02:0003CF4C 6602            	  7415:     bne.s  __far_z_04_0067
02:0003CF4E 602C            	  7416:     jmp  L11B00_Exit
                            	  7417: __far_z_04_0067:
                            	  7418:     ; Else draw the right side.
                            	  7419:     ;
                            	  7420:     ; Keep the Y coordinate in [01].
                            	  7421:     ; But, store (X + $10) in [00].
                            	  7422:     ;
02:0003CF50 10342070        	  7423:     move.b  ($70,A4,D2.W),D0
02:0003CF54 023C00EE        	  7424:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CF58 123C0010        	  7425:     move.b  #$10,D1
02:0003CF5C D101            	  7426:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:0003CF5E 1880            	  7427:     move.b  D0,($0000,A4)
02:0003CF60 6114            	  7428:     jsr     Anim_SetSpriteDescriptorLevelPaletteRow
                            	  7429:     ; XOR'ing the low bit swaps the left and right frame numbers.
                            	  7430:     ;
                            	  7431:     ; So, if we had animation frame 1, direction left:
                            	  7432:     ; - 5-way direction index = 1 (2 >> 1)
                            	  7433:     ; - frame image index = 6 (1 + 5)
                            	  7434:     ;   (dodongo/walk/right/right half/anim frame 1)
                            	  7435:     ; - frame number = 3 (look up element 6 in frame image array)
                            	  7436:     ; - horizontal flip = true (loop up element 6 in H-flip array)
                            	  7437:     ;
                            	  7438:     ; So, 3 would have been the frame number used above for
                            	  7439:     ; the left side.
                            	  7440:     ;
                            	  7441:     ; Here, the frame number is 2 (3 XOR 1), meaning
                            	  7442:     ; (dodongo/walk/right/left half/anim frame 1). The horizontal
                            	  7443:     ; flipping flag is unchanged. So, this left half frame is shown correctly
                            	  7444:     ; on the right.
                            	  7445:     ;
02:0003CF62 41F90003CE58    	  7446:     lea     (DodongoFrameImages).l,A0
02:0003CF68 10303000        	  7447:     move.b  (A0,D3.W),D0
02:0003CF6C 0A000001        	  7448:     eori.b #$01,D0
02:0003CF70 4EF900031B7A    	  7449:     jmp     DrawObjectNotMirrored
                            	  7450: 
                            	  7451: ; Returns:
                            	  7452: ; A: 3
                            	  7453: ; [04]: left sprite attributes
                            	  7454: ; [05]: right sprite attributes
                            	  7455: ;
                            	  7456:     even
