                            	  9800: GohmaLegOffsetsX:
02:0003E164 F0              	  9801:     dc.b    $F0, $10
02:0003E165 10
                            	  9802: 
                            	  9803: ; Params:
                            	  9804: ; A: eye frame image
                            	  9805: ;
                            	  9806: ; Draw the eye with the frame image passed in.
                            	  9807: ;
                            	  9808:     even
                            	  9809: Gohma_AnimateAndDraw:
02:0003E166 1B00            	  9810:     move.b  D0,-(A5)  ; PHA
02:0003E168 4EB90004CCCA    	  9811:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003E16E 6164            	  9812:     jsr     Gohma_SetSpriteAttributes
02:0003E170 101D            	  9813:     move.b  (A5)+,D0  ; PLA
02:0003E172 4EB900031B76    	  9814:     jsr     DrawObjectMirrored
