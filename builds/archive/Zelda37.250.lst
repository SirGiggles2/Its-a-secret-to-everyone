02:0004C73C 0200000F        	  6067:     andi.b #$0F,D0
02:0004C740 7600            	  6068:     moveq   #0,D3
02:0004C742 1600            	  6069:     move.b  D0,D3
02:0004C744 7008            	  6070:     moveq   #8,D0
