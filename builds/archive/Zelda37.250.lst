02:0003CC0A 52302000        	  6899:     addq.b  #1,(A0,D2.W)
                            	  6900:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  6901:     ;
02:0003CC0E 41EC042C        	  6902:     lea     ($042C,A4),A0
