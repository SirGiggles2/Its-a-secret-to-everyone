02:000341B6 41F900033F1C    	  1064:     lea     (DemoLineTextAddrs).l,A0
02:000341BC 30300000        	  1065:     move.w  (A0,D0.W),D0        ; D0.w = offset into DemoTextFields
02:000341C0 41F900033D08    	  1066:     lea     (DemoTextFields).l,A0
02:000341C6 D0C0            	  1067:     adda.w  D0,A0               ; A0 -> text field entry in ROM
02:000341C8 7600            	  1068:     moveq   #0,D3               ; Y index into text field
02:000341CA 10303000        	  1069:     move.b  (A0,D3.W),D0        ; first byte = column offset
02:000341CE 7400            	  1070:     moveq   #0,D2
