02:00044BD2 6022            	  7777:     jmp  L17295_Exit
                            	  7778: __far_z_05_0086:
                            	  7779:     ; Shift right. The value in A is now (menu scroll value) / 2,
                            	  7780:     ; and represents the current row of the submenu being processed.
                            	  7781:     ; The bottom bit tells us (1) whether to transfer a full row of
                            	  7782:     ; black tiles, or (0) a row of the triforce or other piece of the GUI.
                            	  7783:     ;
                            	  7784:     ; If the bottom bit is set, go prepare the full black row.
                            	  7785:     ;
02:00044BD4 E208            	  7786:     lsr.b  #1,D0   ; LSR A
02:00044BD6 7600            	  7787:     moveq   #0,D3
02:00044BD8 1600            	  7788:     move.b  D0,D3
02:00044BDA 6402            	  7789:     bcc.s  __far_z_05_0087
02:00044BDC 60B6            	  7790:     jmp  PrepFullBlackRow
                            	  7791: __far_z_05_0087:
                            	  7792:     ; There's nothing to do for row $15.
                            	  7793:     ; If submenu row < $15, cue a transfer of a triforce or other
                            	  7794:     ; transfer buffer for this row.
                            	  7795:     ;
02:00044BDE 0C000015        	  7796:     cmpi.b  #$15,D0
02:00044BE2 640E            	  7797:     bcc  _anon_z05_170
02:00044BE4 41F900044B44    	  7798:     lea     (SubmenuTransferBufSelectorsOW).l,A0
02:00044BEA 10303000        	  7799:     move.b  (A0,D3.W),D0
                            	  7800:     even
                            	  7801: SelectTransferBufAndDecCounter:
02:00044BEE 19400014        	  7802:     move.b  D0,($0014,A4)
                            	  7803: _anon_z05_170:
                            	  7804:     ; Decrease the counter for the next frame.
                            	  7805:     ;
02:00044BF2 532C005E        	  7806:     subq.b  #1,($005E,A4)
