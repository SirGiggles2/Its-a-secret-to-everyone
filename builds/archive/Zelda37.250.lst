02:0003C66E 41EC0437        	  6168:     lea     ($0437,A4),A0
02:0003C672 12302000        	  6169:     move.b  (A0,D2.W),D1
02:0003C676 B001            	  6170:     cmp.b   D1,D0
02:0003C678 6704            	  6171:     beq.s  __far_z_04_0053
02:0003C67A 6000009E        	  6172:     jmp  L116EA_Exit
                            	  6173: __far_z_04_0053:
