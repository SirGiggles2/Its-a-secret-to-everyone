                            	  2204: ; Params:
                            	  2205: ; A: Y coordinate
                            	  2206: ; X: object index
                            	  2207: ;
                            	  2208:     even
                            	  2209: InitWhirlwind:
02:0003031C 6000B92C        	  2210:     jmp     c_init_whirlwind
                            	  2211: 
                            	  2212: SetUpWhirlwind:
