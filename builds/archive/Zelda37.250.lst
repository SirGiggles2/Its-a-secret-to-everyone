                            	   211: InitCave:
                            	   212:     ; The person goes at location ($78, $80).
                            	   213:     ;
02:0002E4E6 7078            	   214:     moveq   #120,D0
02:0002E4E8 163C0080        	   215:     move.b  #$80,D3
02:0002E4EC 610001A0        	   216:     jsr     SetUpCommonCaveObjects
                            	   217:     ; If the cave/person does not remember state (give item, door charge),
                            	   218:     ; then go handle other kinds.
                            	   219:     ;
02:0002E4F0 102C0350        	   220:     move.b  ($0350,A4),D0
02:0002E4F4 0C000072        	   221:     cmpi.b  #$72,D0
02:0002E4F8 6714            	   222:     beq  _L_z01_InitCave_TakeType
02:0002E4FA 0C000071        	   223:     cmpi.b  #$71,D0
02:0002E4FE 670E            	   224:     beq  _L_z01_InitCave_TakeType
02:0002E500 0C00007B        	   225:     cmpi.b  #$7B,D0
02:0002E504 6408            	   226:     bcc  _L_z01_InitCave_TakeType
02:0002E506 0C00006E        	   227:     cmpi.b  #$6E,D0
02:0002E50A 6502            	   228:     bcs.s  __far_z_01_0000
02:0002E50C 6012            	   229:     jmp  InitCaveContinue
                            	   230: __far_z_01_0000:
                            	   231:     even
                            	   232: _L_z01_InitCave_TakeType:
                            	   233:     ; Else the cave/person simply does:
                            	   234:     ; - taken:     no person, no text
                            	   235:     ; - not taken: show a person and text
                            	   236:     ;
                            	   237:     ; So, if the item was not taken, then go set up the text.
                            	   238:     ;
02:0002E50E 61003010        	   239:     jsr     GetRoomFlagUWItemState
02:0002E512 6602            	   240:     bne.s  __far_z_01_0001
02:0002E514 600A            	   241:     jmp  InitCaveContinue
                            	   242: __far_z_01_0001:
                            	   243:     ; Otherwise destroy the person object, and let Link continue.
                            	   244:     ;
02:0002E516 7000            	   245:     moveq   #0,D0
02:0002E518 19400350        	   246:     move.b  D0,($0350,A4)
                            	   247:     even
                            	   248: UnhaltLink:
02:0002E51C 6000D4D0        	   249:     jmp     c_unhalt_link
                            	   250: 
                            	   251: InitCaveContinue:
                            	   252:     ; Get this cave's index (object type - $6A).
                            	   253:     ;
02:0002E520 102C0350        	   254:     move.b  ($0350,A4),D0
02:0002E524 003C0011        	   255:     ori     #$11,CCR  ; SEC: set C+X
02:0002E528 123C006A        	   256:     move.b  #$6A,D1
02:0002E52C 0A3C0010        	   257:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E530 9101            	   258:     subx.b  D1,D0   ; SBC #$6A
02:0002E532 0A3C0010        	   259:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E536 7600            	   260:     moveq   #0,D3
02:0002E538 1600            	   261:     move.b  D0,D3
                            	   262:     ; Get the person text selector by looking up the text selector byte
                            	   263:     ; for this index, and masking it with $3F.
                            	   264:     ;
02:0002E53A 41F90002E4B8    	   265:     lea     (OverworldPersonTextSelectors).l,A0
02:0002E540 10303000        	   266:     move.b  (A0,D3.W),D0
02:0002E544 1B00            	   267:     move.b  D0,-(A5)  ; PHA
02:0002E546 0200003F        	   268:     andi.b #$3F,D0
02:0002E54A 19400415        	   269:     move.b  D0,($0415,A4)
                            	   270:     ; Pop and mask the text selector byte with $C0 to get the
                            	   271:     ; "pay" and "pick up" cave flags and store them in [03].
                            	   272:     ;
02:0002E54E 101D            	   273:     move.b  (A5)+,D0  ; PLA
02:0002E550 020000C0        	   274:     andi.b #$C0,D0
02:0002E554 19400003        	   275:     move.b  D0,($0003,A4)
                            	   276:     ; At this point, the Y register still has the cave index.
                            	   277:     ; Multiply it by 3 to get the offset of the first item in a set of 3.
                            	   278:     ;
02:0002E558 103C00FD        	   279:     move.b  #$FD,D0
                            	   280: _anon_z01_0:
02:0002E55C 023C00EE        	   281:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E560 123C0003        	   282:     move.b  #$03,D1
02:0002E564 D101            	   283:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002E566 5303            	   284:     subq.b  #1,D3
02:0002E568 6AF2            	   285:     bpl  _anon_z01_0
02:0002E56A 7600            	   286:     moveq   #0,D3
02:0002E56C 1600            	   287:     move.b  D0,D3
                            	   288:     ; Loop over the wares from 0 to 2.
                            	   289:     ;
02:0002E56E 7400            	   290:     moveq   #0,D2
                            	   291:     even
                            	   292: _L_z01_InitCaveContinue_CopyCaveBytes:
                            	   293:     ; Copy 3 item ID bytes from the Cave level block info.
                            	   294:     ; Item ID's are in the low 6 bits, cave flags are in the high 2 bits.
                            	   295:     ;
02:0002E570 41F900FF6A7E    	   296:     lea     (NES_SRAM+$0A7E).l,A0
02:0002E576 10303000        	   297:     move.b  (A0,D3.W),D0
02:0002E57A 41EC0422        	   298:     lea     ($0422,A4),A0
02:0002E57E 11802000        	   299:     move.b  D0,(A0,D2.W)
                            	   300:     ; Copy the cave flags (high 2 bits) of the three items to [00] to [02].
                            	   301:     ;
02:0002E582 020000C0        	   302:     andi.b #$C0,D0
02:0002E586 19802000        	   303:     move.b  D0,($00,A4,D2.W)
                            	   304:     ; Copy 3 prices from the Cave level block info.
                            	   305:     ;
02:0002E58A 41F900FF6ABA    	   306:     lea     (NES_SRAM+$0ABA).l,A0
02:0002E590 10303000        	   307:     move.b  (A0,D3.W),D0
02:0002E594 41EC0430        	   308:     lea     ($0430,A4),A0
02:0002E598 11802000        	   309:     move.b  D0,(A0,D2.W)
                            	   310:     ; Bottom of the wares copying loop.
                            	   311:     ;
02:0002E59C 5203            	   312:     addq.b  #1,D3
02:0002E59E 5202            	   313:     addq.b  #1,D2
02:0002E5A0 0C020003        	   314:     cmpi.b  #$03,D2
02:0002E5A4 66CA            	   315:     bne  _L_z01_InitCaveContinue_CopyCaveBytes
                            	   316:     ; Get the top 2 bits of text selector byte in [03],
                            	   317:     ; shift them to the bottom, and combine them with [00].
                            	   318:     ;
02:0002E5A6 102C0003        	   319:     move.b  ($0003,A4),D0
02:0002E5AA E308            	   320:     lsl.b  #1,D0   ; ASL A
02:0002E5AC E310            	   321:     roxl.b  #1,D0   ; ROL A
02:0002E5AE E310            	   322:     roxl.b  #1,D0   ; ROL A
02:0002E5B0 1214            	   323:     move.b  ($0000,A4),D1
02:0002E5B2 8001            	   324:     or.b  D1,D0
02:0002E5B4 1880            	   325:     move.b  D0,($0000,A4)
                            	   326:     ; Get the top 2 bits of item descriptor 2, shift them right 4 times,
                            	   327:     ; and combine them with [00].
                            	   328:     ;
02:0002E5B6 102C0002        	   329:     move.b  ($0002,A4),D0
02:0002E5BA E208            	   330:     lsr.b  #1,D0   ; LSR A
02:0002E5BC E208            	   331:     lsr.b  #1,D0   ; LSR A
02:0002E5BE E208            	   332:     lsr.b  #1,D0   ; LSR A
02:0002E5C0 E208            	   333:     lsr.b  #1,D0   ; LSR A
02:0002E5C2 1214            	   334:     move.b  ($0000,A4),D1
02:0002E5C4 8001            	   335:     or.b  D1,D0
02:0002E5C6 1880            	   336:     move.b  D0,($0000,A4)
                            	   337:     ; Get the top 2 bits of item descriptor 1, shift them right twice,
                            	   338:     ; and combine them with [00] into CaveFlags.
                            	   339:     ;
02:0002E5C8 102C0001        	   340:     move.b  ($0001,A4),D0
02:0002E5CC E208            	   341:     lsr.b  #1,D0   ; LSR A
02:0002E5CE E208            	   342:     lsr.b  #1,D0   ; LSR A
02:0002E5D0 1214            	   343:     move.b  ($0000,A4),D1
02:0002E5D2 8001            	   344:     or.b  D1,D0
02:0002E5D4 19400413        	   345:     move.b  D0,($0413,A4)
                            	   346:     ; The end result is a byte with 8 cave flags.
                            	   347:     ;
                            	   348:     ; If cave flag "money game" is missing, then go finish up,
                            	   349:     ; instead of choosing random amounts for the money game.
                            	   350:     ;
02:0002E5D8 02000020        	   351:     andi.b #$20,D0
02:0002E5DC 6700009E        	   352:     beq  _L_z01_InitCaveContinue_ResetTextbox
                            	   353:     ; Determine an index randomly with increasing probability,
                            	   354:     ; from 6 to 1. Start with the following test:
                            	   355:     ;
                            	   356:     ;   If $FF < Random, then go use index 6.
                            	   357:     ;
02:0002E5E0 103C00FF        	   358:     move.b  #$FF,D0
02:0002E5E4 7606            	   359:     moveq   #6,D3
                            	   360:     even
                            	   361: _L_z01_InitCaveContinue_ChoosePermutation:
02:0002E5E6 122C0019        	   362:     move.b  ($0019,A4),D1
02:0002E5EA B001            	   363:     cmp.b   D1,D0
02:0002E5EC 6516            	   364:     bcs  _L_z01_InitCaveContinue_FoundPermutation
                            	   365:     ; If the test fails, then subtract $2B from the reference number.
                            	   366:     ;
02:0002E5EE 003C0011        	   367:     ori     #$11,CCR  ; SEC: set C+X
02:0002E5F2 123C002B        	   368:     move.b  #$2B,D1
02:0002E5F6 0A3C0010        	   369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E5FA 9101            	   370:     subx.b  D1,D0   ; SBC #$2B
02:0002E5FC 0A3C0010        	   371:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E600 5303            	   372:     subq.b  #1,D3
02:0002E602 66E2            	   373:     bne  _L_z01_InitCaveContinue_ChoosePermutation
                            	   374:     even
                            	   375: _L_z01_InitCaveContinue_FoundPermutation:
                            	   376:     ; The index chooses the last offset of a permutation of three indexes.
                            	   377:     ;
02:0002E604 7400            	   378:     moveq   #0,D2
02:0002E606 41F90002E4E0    	   379:     lea     (MoneyGamePermutationEndIndexes).l,A0
02:0002E60C 14303000        	   380:     move.b  (A0,D3.W),D2
                            	   381:     ; Copy the permutation of 3 indexes to [046C] to [046E].
                            	   382:     ;
02:0002E610 7602            	   383:     moveq   #2,D3
                            	   384:     even
                            	   385: _L_z01_InitCaveContinue_CopyPermutation:
02:0002E612 41F90002E4CE    	   386:     lea     (MoneyGamePermutations).l,A0
02:0002E618 10302000        	   387:     move.b  (A0,D2.W),D0
02:0002E61C 41EC046C        	   388:     lea     ($046C,A4),A0
02:0002E620 11803000        	   389:     move.b  D0,(A0,D3.W)
02:0002E624 5302            	   390:     subq.b  #1,D2
02:0002E626 5303            	   391:     subq.b  #1,D3
02:0002E628 6AE8            	   392:     bpl  _L_z01_InitCaveContinue_CopyPermutation
                            	   393:     ; With the first bit of another random number, choose 10 or 40
                            	   394:     ; to put in [046F]. This is a random amount to lose.
                            	   395:     ;
