02:0003F22A 102C0085        	 12056:     move.b  ($0085,A4),D0
02:0003F22E 003C0011        	 12057:     ori     #$11,CCR  ; SEC: set C+X
02:0003F232 1214            	 12058:     move.b  ($0000,A4),D1
02:0003F234 0A3C0010        	 12059:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003F238 9101            	 12060:     subx.b  D1,D0   ; SBC $00
02:0003F23A 0A3C0010        	 12061:     eori    #$10,CCR  ; restore X = 6502 C
02:0003F23E 41EC0084        	 12062:     lea     ($0084,A4),A0
