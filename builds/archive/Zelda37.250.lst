                            	  7376: _L_z04_Dodongo_Draw_PrepareToDraw:
                            	  7377:     ; Start preparing sprites.
                            	  7378:     ;
02:0003CEFE 4EB90004CCCA    	  7379:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:0003CF04 1003            	  7380:     move.b  D3,D0
02:0003CF06 1B00            	  7381:     move.b  D0,-(A5)  ; PHA
                            	  7382:     ; Get the horizontal flipping and frame image number for this frame image.
                            	  7383:     ;
02:0003CF08 41F90003CE62    	  7384:     lea     (DodongoFrameHFlips).l,A0
02:0003CF0E 10303000        	  7385:     move.b  (A0,D3.W),D0
02:0003CF12 1940000F        	  7386:     move.b  D0,($000F,A4)
02:0003CF16 41F90003CE58    	  7387:     lea     (DodongoFrameImages).l,A0
02:0003CF1C 10303000        	  7388:     move.b  (A0,D3.W),D0
                            	  7389:     ; Frame image numbers 7 and 9 are vertical bloated frame images.
                            	  7390:     ; They are drawn mirrored.
                            	  7391:     ;
02:0003CF20 0C000007        	  7392:     cmpi.b  #$07,D0
02:0003CF24 6706            	  7393:     beq  _anon_z04_92
02:0003CF26 0C000009        	  7394:     cmpi.b  #$09,D0
02:0003CF2A 6608            	  7395:     bne  _L_z04_Dodongo_Draw_DrawLeftSide
                            	  7396: _anon_z04_92:
