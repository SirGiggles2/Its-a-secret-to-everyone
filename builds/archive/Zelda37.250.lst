                            	  5050: _L_z04_L_Wallmaster_State1_DrawWithCapturedLink:
                            	  5051:     ; Draw Wallmaster with captured Link.
                            	  5052:     ;
                            	  5053:     ; First, put Link right where the monster is.
                            	  5054:     ;
02:0003BE24 10342070        	  5055:     move.b  ($70,A4,D2.W),D0
02:0003BE28 19400070        	  5056:     move.b  D0,($0070,A4)
02:0003BE2C 41EC0084        	  5057:     lea     ($0084,A4),A0
02:0003BE30 10302000        	  5058:     move.b  (A0,D2.W),D0
02:0003BE34 19400084        	  5059:     move.b  D0,($0084,A4)
02:0003BE38 4EB90004BBDE    	  5060:     jsr     Link_EndMoveAndAnimate_Bank4
02:0003BE3E 4EB900030DC4    	  5061:     jsr     ShowLinkSpritesBehindHorizontalDoors
02:0003BE44 7400            	  5062:     moveq   #0,D2
