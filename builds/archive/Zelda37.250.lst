02:00044B9E 023C00EE        	  7751:     andi    #$EE,CCR  ; CLC: clear C+X
02:00044BA2 123C0020        	  7752:     move.b  #$20,D1
02:00044BA6 D101            	  7753:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00044BA8 6404            	  7754:     bcc  _anon_z05_169
02:00044BAA 522C0302        	  7755:     addq.b  #1,($0302,A4)
                            	  7756: _anon_z05_169:
02:00044BAE 5303            	  7757:     subq.b  #1,D3
