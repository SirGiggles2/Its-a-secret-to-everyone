                            	  4252: 
                            	  4253: ; Params:
                            	  4254: ; Y: middle speed index (4)
                            	  4255: ; [03]: horizontal distance
                            	  4256: ; [04]: vertical distance
                            	  4257: ; [0A]: vertical direction
                            	  4258: ; [0B]: horizontal direction
                            	  4259: ;
                            	  4260: ; Returns:
                            	  4261: ; Y: speed index (0 to 8) for the angle
                            	  4262: ;
                            	  4263: ;
                            	  4264: ; TODO: call it speed index or angle?
                            	  4265: ; Store the middle speed index in [00]. It will be changed to the
                            	  4266: ; right speed index to use incrementally.
                            	  4267: ; Lower speed indexes yield faster X speeds and lower Y speeds.
                            	  4268: ; Higher speed indexes yield faster Y speeds and lower X speeds.
                            	  4269: ;
                            	  4270:     even
                            	  4271: _CalcDiagonalSpeedIndex:
02:000310C8 1883            	  4272:     move.b  D3,($0000,A4)
                            	  4273:     ; Assuming horizontal distance >= vertical distance, the
                            	  4274:     ; index offset in [01] is negative (-1) to go towards the X axis.
                            	  4275:     ;
02:000310CA 103C00FF        	  4276:     move.b  #$FF,D0
02:000310CE 19400001        	  4277:     move.b  D0,($0001,A4)
                            	  4278:     ; TODO:
                            	  4279:     ; If horizontal distance [03] < vertical distance [04], swap [03] and [04],
                            	  4280:     ; and store positive speed index 1 in [01] to go towards the Y axis.
                            	  4281:     ;
                            	  4282:     ; The point is to put the greater value in [03] and the lesser one in [04],
                            	  4283:     ; and use a speed index offset (1 or -1) that will point us in the direction
                            	  4284:     ; of the farther distance faster.
                            	  4285:     ;
02:000310D2 102C0003        	  4286:     move.b  ($0003,A4),D0
02:000310D6 122C0004        	  4287:     move.b  ($0004,A4),D1
02:000310DA B001            	  4288:     cmp.b   D1,D0
02:000310DC 6416            	  4289:     bcc  _L_z01__CalcDiagonalSpeedIndex_Swap
02:000310DE 1B00            	  4290:     move.b  D0,-(A5)  ; PHA
02:000310E0 102C0004        	  4291:     move.b  ($0004,A4),D0
02:000310E4 19400003        	  4292:     move.b  D0,($0003,A4)
02:000310E8 101D            	  4293:     move.b  (A5)+,D0  ; PLA
02:000310EA 19400004        	  4294:     move.b  D0,($0004,A4)
02:000310EE 7001            	  4295:     moveq   #1,D0
02:000310F0 19400001        	  4296:     move.b  D0,($0001,A4)
                            	  4297:     even
                            	  4298: _L_z01__CalcDiagonalSpeedIndex_Swap:
                            	  4299:     ; TODO: call it speed index or angle?
                            	  4300:     ; If the difference in distances is within 8 pixels,
                            	  4301:     ; return the speed index (angle) we have.
                            	  4302:     ;
02:000310F4 102C0003        	  4303:     move.b  ($0003,A4),D0
02:000310F8 003C0011        	  4304:     ori     #$11,CCR  ; SEC: set C+X
02:000310FC 122C0004        	  4305:     move.b  ($0004,A4),D1
02:00031100 0A3C0010        	  4306:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031104 9101            	  4307:     subx.b  D1,D0   ; SBC $04
02:00031106 0A3C0010        	  4308:     eori    #$10,CCR  ; restore X = 6502 C
02:0003110A 0C000008        	  4309:     cmpi.b  #$08,D0
02:0003110E 6538            	  4310:     bcs  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4311:     even
                            	  4312: _L_z01__CalcDiagonalSpeedIndex_Turn:
                            	  4313:     ; TODO: call it speed index or angle?
                            	  4314:     ; Otherwise, go to the next speed index (angle).
                            	  4315:     ;
02:00031110 1014            	  4316:     move.b  ($0000,A4),D0
02:00031112 023C00EE        	  4317:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031116 122C0001        	  4318:     move.b  ($0001,A4),D1
02:0003111A D101            	  4319:     addx.b  D1,D0   ; ADC $01
02:0003111C 1880            	  4320:     move.b  D0,($0000,A4)
                            	  4321:     ; TODO: call it speed index or angle?
                            	  4322:     ; If a speed index (angle) limit (0 or 8), we've gone all the way to an axis
                            	  4323:     ; (0, 90, 180, 270 degrees). So return this speed index (angle).
                            	  4324:     ;
02:0003111E 6728            	  4325:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
02:00031120 0C000008        	  4326:     cmpi.b  #$08,D0
02:00031124 6722            	  4327:     beq  _L_z01__CalcDiagonalSpeedIndex_Return
                            	  4328:     ; Subtract the lesser distance from the greater distance.
                            	  4329:     ; If they still haven't crossed, then we can turn more.
                            	  4330:     ;
02:00031126 102C0003        	  4331:     move.b  ($0003,A4),D0
02:0003112A 003C0011        	  4332:     ori     #$11,CCR  ; SEC: set C+X
02:0003112E 122C0004        	  4333:     move.b  ($0004,A4),D1
02:00031132 0A3C0010        	  4334:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031136 9101            	  4335:     subx.b  D1,D0   ; SBC $04
02:00031138 0A3C0010        	  4336:     eori    #$10,CCR  ; restore X = 6502 C
02:0003113C 19400003        	  4337:     move.b  D0,($0003,A4)
02:00031140 122C0004        	  4338:     move.b  ($0004,A4),D1
02:00031144 B001            	  4339:     cmp.b   D1,D0
02:00031146 64C8            	  4340:     bcc  _L_z01__CalcDiagonalSpeedIndex_Turn
                            	  4341:     even
