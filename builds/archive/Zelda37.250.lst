                            	  6849:     ; Bloated timer =>
                            	  6850:     ; 0:     fall thru to set a new timer and check bomb hits
                            	  6851:     ; 1:     go advance the substate
                            	  6852:     ; other: go decrement Bloated timer
                            	  6853:     ;
02:0003CBA8 7600            	  6854:     moveq   #0,D3
02:0003CBAA 41EC045E        	  6855:     lea     ($045E,A4),A0
02:0003CBAE 16302000        	  6856:     move.b  (A0,D2.W),D3
