02:0003CBF6 123C0001        	  6888:     move.b  #$01,D1
02:0003CBFA D101            	  6889:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0003CBFC 41EC0437        	  6890:     lea     ($0437,A4),A0
02:0003CC00 11802000        	  6891:     move.b  D0,(A0,D2.W)
