                            	  7399:     ; If the door attribute is "false wall",
                            	  7400:     ; then play the "found secret" tune.
02:00044932 1B00            	  7401:     move.b  D0,-(A5)  ; PHA
02:00044934 02000007        	  7402:     andi.b #$07,D0
02:00044938 0C000002        	  7403:     cmpi.b  #$02,D0
02:0004493C 6606            	  7404:     bne  _anon_z05_156
02:0004493E 7004            	  7405:     moveq   #4,D0
02:00044940 19400602        	  7406:     move.b  D0,($0602,A4)
                            	  7407: _anon_z05_156:
02:00044944 101D            	  7408:     move.b  (A5)+,D0  ; PLA
                            	  7409:     ; If the player is at an "open", "key", or "shutter" door,
                            	  7410:     ; then the player walked all the way to the edge of the play
                            	  7411:     ; area. So, use index 2 to set Link's relative position to 0.
                            	  7412:     ;
                            	  7413:     ; Otherwise, the player is at wall level. Link has to walk to the
                            	  7414:     ; edge of the play area. So, set a relative position that
                            	  7415:     ; reflects that distance: $28 or -$28.
                            	  7416:     ;
                            	  7417:     ; If walking in a decreasing direction (left or up), then
                            	  7418:     ; Link's relative position is $28 and has to decrease to 0.
                            	  7419:     ;
                            	  7420:     ; If walking in an increasing direction (right or down), then
                            	  7421:     ; Link's relative position is -$28 and has to increase to 0.
                            	  7422:     ;
02:00044946 02000007        	  7423:     andi.b #$07,D0
02:0004494A 0C000002        	  7424:     cmpi.b  #$02,D0
02:0004494E 6506            	  7425:     bcs  _L_z05_InitMode6_SetWalkDistance0
02:00044950 0C000005        	  7426:     cmpi.b  #$05,D0
02:00044954 6502            	  7427:     bcs  _anon_z05_157
                            	  7428:     even
                            	  7429: _L_z05_InitMode6_SetWalkDistance0:
02:00044956 7602            	  7430:     moveq   #2,D3
