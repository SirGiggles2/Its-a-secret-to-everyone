02:00039F5A 7000            	   680:     moveq   #0,D0
02:00039F5C 41EC0405        	   681:     lea     ($0405,A4),A0
02:00039F60 11803000        	   682:     move.b  D0,(A0,D3.W)
                            	   683:     ; The first animation frame lasts 3 screen frames.
