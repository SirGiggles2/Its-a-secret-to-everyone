02:0003B474 12303000        	  3679:     move.b  (A0,D3.W),D1
02:0003B478 B001            	  3680:     cmp.b   D1,D0
02:0003B47A 6648            	  3681:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3682:     ; The secret (usually stairs) is under one of the armoses.
                            	  3683:     ;
                            	  3684:     ; If the armos's X coordinate does not match the one needed
                            	  3685:     ; for the current room in the list, then go loop again.
                            	  3686:     ;
02:0003B47C 10342070        	  3687:     move.b  ($70,A4,D2.W),D0
02:0003B480 41F90003B43C    	  3688:     lea     (SecretArmosXs).l,A0
02:0003B486 12303000        	  3689:     move.b  (A0,D3.W),D1
02:0003B48A B001            	  3690:     cmp.b   D1,D0
02:0003B48C 6636            	  3691:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3692:     ; If the armos's Y coordinate <> $80, go loop again.
                            	  3693:     ;
02:0003B48E 41EC0084        	  3694:     lea     ($0084,A4),A0
02:0003B492 10302000        	  3695:     move.b  (A0,D2.W),D0
02:0003B496 0C000080        	  3696:     cmpi.b  #$80,D0
02:0003B49A 6628            	  3697:     bne  _L_z04_InitArmosOrFlyingGhini_NextLoopArmosRoom
                            	  3698:     ; If the loop index <> 0, go use the stairs tile to patch the floor.
                            	  3699:     ;
02:0003B49C 4A03            	  3700:     cmpi.b  #$00,D3
02:0003B49E 662C            	  3701:     bne  _L_z04_InitArmosOrFlyingGhini_UseChosenTile
                            	  3702:     ; The room ID at index 0 is $24. Instead of stairs, this room
                            	  3703:     ; has the power bracelet.
                            	  3704:     ;
                            	  3705:     ; Set up the room item with the armos's coordinates.
                            	  3706:     ;
02:0003B4A0 19400097        	  3707:     move.b  D0,($0097,A4)
02:0003B4A4 10342070        	  3708:     move.b  ($70,A4,D2.W),D0
02:0003B4A8 19400083        	  3709:     move.b  D0,($0083,A4)
                            	  3710:     ; This resets the room item's state, which activates it.
                            	  3711:     ;
02:0003B4AC 194300BF        	  3712:     move.b  D3,($00BF,A4)
                            	  3713:     ; Set the room item ID.
                            	  3714:     ;
02:0003B4B0 7014            	  3715:     moveq   #20,D0
02:0003B4B2 194000AB        	  3716:     move.b  D0,($00AB,A4)
                            	  3717:     ; If the bracelet has not been taken, then play the "secret found" tune.
                            	  3718:     ;
                            	  3719:     ; Either way, quit the loop, and replace the tile with a floor tile.
                            	  3720:     ;
                            	  3721:     ; Note that, if the item was already taken, then the room item
                            	  3722:     ; object will stay activated. But in E6EA (MoveAndDrawRoomItem),
                            	  3723:     ; it will be ignored, because that routine checks whether
                            	  3724:     ; the item was taken.
                            	  3725:     ;
02:0003B4B6 4EB900031520    	  3726:     jsr     GetRoomFlagUWItemState
02:0003B4BC 660A            	  3727:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
02:0003B4BE 6100069E        	  3728:     jsr     PlaySecretFoundTune
02:0003B4C2 6604            	  3729:     bne  _L_z04_InitArmosOrFlyingGhini_UseFloorTile
                            	  3730:     even
