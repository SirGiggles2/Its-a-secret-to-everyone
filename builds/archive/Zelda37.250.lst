02:0003B216 8001            	  3333:     or.b  D1,D0
02:0003B218 6704            	  3334:     beq.s  __far_z_04_0028
02:0003B21A 6000009E        	  3335:     jmp  RedLeever_AnimateAndCheckCollisions
                            	  3336: __far_z_04_0028:
                            	  3337:     ; If the leever is blocked by a tile or the room boundary,
                            	  3338:     ; then go to the next state, in addition to animating, drawing,
