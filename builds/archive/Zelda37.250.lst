02:0003CEE6 122C0015        	  7363:     move.b  ($0015,A4),D1
02:0003CEEA C001            	  7364:     and.b  D1,D0
02:0003CEEC 6710            	  7365:     beq  _L_z04_Dodongo_Draw_PrepareToDraw
                            	  7366:     ; For animation frame 1, add 5 to the index in Y register,
                            	  7367:     ; in order to index into the second set of frame image numbers.
                            	  7368:     ;
02:0003CEEE 1003            	  7369:     move.b  D3,D0
02:0003CEF0 023C00EE        	  7370:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CEF4 123C0005        	  7371:     move.b  #$05,D1
02:0003CEF8 D101            	  7372:     addx.b  D1,D0   ; ADC #$05 (X flag = 6502 C)
02:0003CEFA 7600            	  7373:     moveq   #0,D3
02:0003CEFC 1600            	  7374:     move.b  D0,D3
