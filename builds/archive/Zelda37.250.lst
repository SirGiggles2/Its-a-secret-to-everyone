02:0004C7A8 41EC00AC        	  6123:     lea     ($00AC,A4),A0
02:0004C7AC 10302000        	  6124:     move.b  (A0,D2.W),D0
02:0004C7B0 0200000F        	  6125:     andi.b #$0F,D0
02:0004C7B4 0C000001        	  6126:     cmpi.b  #$01,D0
02:0004C7B8 6604            	  6127:     bne.s  __far_z_07_0091
