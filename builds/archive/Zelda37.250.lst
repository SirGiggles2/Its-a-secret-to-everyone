02:00030D00 0A3C0010        	  3693:     eori    #$10,CCR  ; restore X = 6502 C
02:00030D04 1880            	  3694:     move.b  D0,($0000,A4)
02:00030D06 101D            	  3695:     move.b  (A5)+,D0  ; PLA
02:00030D08 E208            	  3696:     lsr.b  #1,D0   ; LSR A
