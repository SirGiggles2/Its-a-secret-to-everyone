                            	  6015: _L_z07_UpdateSwordOrRod_Add4:
                            	  6016:     ; Set [00] to (state - 1) * 4:
                            	  6017:     ; the byte offset of the beginning of a set of pixel offsets.
                            	  6018:     ;
02:0004C6CA 023C00EE        	  6019:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6CE 123C0004        	  6020:     move.b  #$04,D1
02:0004C6D2 D101            	  6021:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0004C6D4 5303            	  6022:     subq.b  #1,D3
02:0004C6D6 66F2            	  6023:     bne  _L_z07_UpdateSwordOrRod_Add4
02:0004C6D8 1880            	  6024:     move.b  D0,($0000,A4)
                            	  6025:     ; Set object's direction to player's. It might have changed
                            	  6026:     ; since the last frame.
                            	  6027:     ;
02:0004C6DA 102C0098        	  6028:     move.b  ($0098,A4),D0
02:0004C6DE 41EC0098        	  6029:     lea     ($0098,A4),A0
02:0004C6E2 11802000        	  6030:     move.b  D0,(A0,D2.W)
                            	  6031:     ; Add [00] and the reverse index of the direction to get
                            	  6032:     ; the byte offset of the pixel offset.
                            	  6033:     ;
02:0004C6E6 4EB900031022    	  6034:     jsr     GetOppositeDir
02:0004C6EC 1003            	  6035:     move.b  D3,D0
02:0004C6EE 023C00EE        	  6036:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C6F2 1214            	  6037:     move.b  ($0000,A4),D1
02:0004C6F4 D101            	  6038:     addx.b  D1,D0   ; ADC $00
02:0004C6F6 7600            	  6039:     moveq   #0,D3
02:0004C6F8 1600            	  6040:     move.b  D0,D3
                            	  6041:     ; Set object's X to player's X + offset for state and direction.
                            	  6042:     ; Copy the result to [00].
                            	  6043:     ;
02:0004C6FA 102C0070        	  6044:     move.b  ($0070,A4),D0
02:0004C6FE 023C00EE        	  6045:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C702 41F90004C62E    	  6046:     lea     (PlayerToWeaponOffsetsX).l,A0
02:0004C708 12303000        	  6047:     move.b  (A0,D3.W),D1
