02:00044B7C 6070            	  7717:     jmp     SelectTransferBufAndDecCounter
                            	  7718: 
                            	  7719: _anon_z05_167:
                            	  7720:     ; If map row = $15, go cue the transfer of the bottom edge
                            	  7721:     ; of the big map sheet.
                            	  7722:     ;
02:00044B7E 0C000015        	  7723:     cmpi.b  #$15,D0
02:00044B82 6604            	  7724:     bne  _anon_z05_168
02:00044B84 7042            	  7725:     moveq   #66,D0
02:00044B86 60F4            	  7726:     jmp     _L_z05_Submenu_CueTransferRowUW_SelectTransferBuf
                            	  7727: 
