02:0003FE9A 10303000        	 13894:     move.b  (A0,D3.W),D0
02:0003FE9E 1880            	 13895:     move.b  D0,($0000,A4)
                            	 13896:     ; Mutliply q-speed by [00].
                            	 13897:     ;
                            	 13898:     ; Q-speed has the default value $20 set when entering the room.
                            	 13899:     ;
02:0003FEA0 41EC03BC        	 13900:     lea     ($03BC,A4),A0
02:0003FEA4 10302000        	 13901:     move.b  (A0,D2.W),D0
02:0003FEA8 7600            	 13902:     moveq   #0,D3
02:0003FEAA 162C0005        	 13903:     move.b  ($0005,A4),D3
02:0003FEAE 61000136        	 13904:     jsr     ShiftMultiply
                            	 13905:     ; The absolute X increment for the current angle is now in [02:03].
                            	 13906:     ;
                            	 13907:     ; If angle >= $10, then the monster is in the top half of circle going left.
                            	 13908:     ;
02:0003FEB2 41EC0394        	 13909:     lea     ($0394,A4),A0
02:0003FEB6 10302000        	 13910:     move.b  (A0,D2.W),D0
