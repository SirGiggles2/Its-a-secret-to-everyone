                            	 12171: UpdateGanon_JumpTable:
02:0003F320 0003F32C        	 12172:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F324 0003F38E        	 12173:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0003F328 0003F3BC        	 12174:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	 12175: 
                            	 12176: ; Description:
                            	 12177: ; Lift up the Triforce of Courage while the room is dark.
                            	 12178: ;
                            	 12179: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	 12180: ;
                            	 12181:     even
                            	 12182: Ganon_ScenePhase0:
02:0003F32C 701B            	 12183:     moveq   #27,D0
02:0003F32E 19400505        	 12184:     move.b  D0,($0505,A4)
                            	 12185:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	 12186:     ;
