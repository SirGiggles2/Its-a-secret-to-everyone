                            	  4087: PlayerScreenEdgeBounds:
02:0004BA06 3D              	  4088:     dc.b    $3D, $DD, $00, $F0
02:0004BA07 DD
02:0004BA08 00
02:0004BA09 F0
                            	  4089: 
                            	  4090: ; Params:
                            	  4091: ; [0E]: $FF, if blocked by a door
                            	  4092: ; [0F]: movement direction
                            	  4093: ;
                            	  4094: ; Returns:
                            	  4095: ; [0F]: untouched, or changed if blocked or need to change
                            	  4096: ;
                            	  4097: ; Summary:
                            	  4098: ;
                            	  4099: ; For the player: if at a doorway or walkable tile, check the screen edge.
                            	  4100: ; Then allow movement or go to the next room. Otherwise,
                            	  4101: ; check passive tile objects and stop moving.
                            	  4102: ;
                            	  4103: ; For other objects: First, if moving, test the colliding tile for
                            	  4104: ; walkability. Otherwise search for a walkable direction starting
                            	  4105: ; from input direction.
                            	  4106: ;
                            	  4107: ; When you find a walkable direction, see if it makes the object
                            	  4108: ; cross a boundary. If it doesn't, then make this direction
                            	  4109: ; the objection direction. Otherwise, keep looping.
                            	  4110: ;
                            	  4111: ; If no walkable direction is found, then stop moving.
                            	  4112: ;
                            	  4113: ;
                            	  4114: ; if is player
                            	  4115: ;   if at doorway
                            	  4116: ;     go handle a walkable direction
                            	  4117: ;   if blocked by door
                            	  4118: ;     return
                            	  4119: ;
                            	  4120:     even
                            	  4121: Walker_CheckTileCollision:
                            	  4122:     ; PATCH P40 (v2): no-clip moved to CheckTiles; see further
                            	  4123:     ; down in the file. Walker_CheckTileCollision runs its
                            	  4124:     ; normal bookkeeping (DoorwayDir / grid-offset / state
                            	  4125:     ; reset) for Link and every other object. Only the tile
                            	  4126:     ; walkability decision in CheckTiles is overridden.
02:0004BA0A 4A02            	  4127:     cmpi.b  #$00,D2
02:0004BA0C 6614            	  4128:     bne  _L_z07_Walker_CheckTileCollision_CheckGridOffset
02:0004BA0E 102C0053        	  4129:     move.b  ($0053,A4),D0
02:0004BA12 6704            	  4130:     beq  _anon_z07_16
02:0004BA14 600000BE        	  4131:     jmp     GoWalkableDir
                            	  4132: 
                            	  4133: _anon_z07_16:
02:0004BA18 102C000E        	  4134:     move.b  ($000E,A4),D0
02:0004BA1C 6A04            	  4135:     bpl.s  __far_z_07_0047
02:0004BA1E 600000AC        	  4136:     jmp  L1F148_Exit
                            	  4137: __far_z_07_0047:
                            	  4138:     even
                            	  4139: _L_z07_Walker_CheckTileCollision_CheckGridOffset:
                            	  4140:     ; If grid offset <> 0, return.
                            	  4141:     ;
02:0004BA22 41EC0394        	  4142:     lea     ($0394,A4),A0
02:0004BA26 10302000        	  4143:     move.b  (A0,D2.W),D0
02:0004BA2A 6704            	  4144:     beq.s  __far_z_07_0048
02:0004BA2C 6000009E        	  4145:     jmp  L1F148_Exit
                            	  4146: __far_z_07_0048:
                            	  4147:     ; Grid offset = 0.
                            	  4148:     ; The object is at a point between cells in the grid.
                            	  4149:     ; So, we can check tiles for collision.
                            	  4150:     ;
                            	  4151:     ; Reset [0E] alternate direction search step.
                            	  4152:     ;
02:0004BA30 1940000E        	  4153:     move.b  D0,($000E,A4)
                            	  4154:     ; If there's a movement direction, go check tile collision.
                            	  4155:     ;
02:0004BA34 102C000F        	  4156:     move.b  ($000F,A4),D0
02:0004BA38 6702            	  4157:     beq.s  __far_z_07_0049
02:0004BA3A 602E            	  4158:     jmp  CheckTiles
                            	  4159: __far_z_07_0049:
                            	  4160:     ; Moving direction = 0.
                            	  4161:     ; If object is the player, return.
                            	  4162:     ;
02:0004BA3C 4A02            	  4163:     cmpi.b  #$00,D2
02:0004BA3E 6604            	  4164:     bne.s  __far_z_07_0050
02:0004BA40 6000008A        	  4165:     jmp  L1F148_Exit
                            	  4166: __far_z_07_0050:
                            	  4167:     ; Moving direction = 0.
