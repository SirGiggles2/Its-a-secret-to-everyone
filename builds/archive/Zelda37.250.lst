02:0003CA5A 023C00EE        	  6678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003CA5E 41F90003CA12    	  6679:     lea     (AquamentusSpriteOffsetsY).l,A0
02:0003CA64 12303000        	  6680:     move.b  (A0,D3.W),D1
02:0003CA68 D101            	  6681:     addx.b  D1,D0   ; ADC AquamentusSpriteOffsetsY,Y
02:0003CA6A 19400001        	  6682:     move.b  D0,($0001,A4)
                            	  6683:     ; Calculate sprite attributes:
                            	  6684:     ; [03] := (invincibility timer AND 3) XOR 3
                            	  6685:     ;
                            	  6686:     ; If the boss is temporarily invincible, then
                            	  6687:     ; this makes it flash by cycling all the palette rows.
                            	  6688:     ;
                            	  6689:     ; Otherwise invincibility timer = 0. So [03] becomes 3:
                            	  6690:     ; the attribute value for a normal sprite with palette row 7 (level).
                            	  6691:     ;
02:0003CA6E 41EC04F0        	  6692:     lea     ($04F0,A4),A0
02:0003CA72 10302000        	  6693:     move.b  (A0,D2.W),D0
02:0003CA76 02000003        	  6694:     andi.b #$03,D0
02:0003CA7A 0A000003        	  6695:     eori.b #$03,D0
02:0003CA7E 19400003        	  6696:     move.b  D0,($0003,A4)
02:0003CA82 7600            	  6697:     moveq   #0,D3
02:0003CA84 162C000A        	  6698:     move.b  ($000A,A4),D3
                            	  6699:     ; Look up the tile for this sprite.
                            	  6700:     ; If it's not the first one (face), then go write the sprite record.
                            	  6701:     ;
02:0003CA88 41F90003CA06    	  6702:     lea     (AquamentusTiles).l,A0
02:0003CA8E 10303000        	  6703:     move.b  (A0,D3.W),D0
02:0003CA92 12390003CA06    	  6704:     move.b  (AquamentusTiles).l,D1
