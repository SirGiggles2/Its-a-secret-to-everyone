                            	  7610:     ; Each cellar can have two destination rooms: A and B.
                            	  7611:     ; Tunnels use both. Treasure rooms only use room A.
                            	  7612:     ;
                            	  7613:     ; If the room that Link came from is the room A of this cellar,
                            	  7614:     ; then look up the X coordinate of the ladder on the left at index 0.
                            	  7615:     ; Else use index 1 to get the X coordinate on the right.
                            	  7616:     ;
02:00044AB2 7600            	  7617:     moveq   #0,D3
