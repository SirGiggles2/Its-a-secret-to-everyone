02:0003AA2C 0C000001        	  2206:     cmpi.b  #$01,D0
02:0003AA30 6720            	  2207:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA32 0C000009        	  2208:     cmpi.b  #$09,D0
02:0003AA36 671A            	  2209:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA38 0C00000A        	  2210:     cmpi.b  #$0A,D0
02:0003AA3C 6714            	  2211:     beq  _L_z04__TryShooting_TryShootingNow
02:0003AA3E 41EC0451        	  2212:     lea     ($0451,A4),A0
02:0003AA42 10302000        	  2213:     move.b  (A0,D2.W),D0
02:0003AA46 660A            	  2214:     bne  _L_z04__TryShooting_TryShootingNow
                            	  2215:     ; and a random value < $F8, then return.
                            	  2216:     ;
02:0003AA48 10342018        	  2217:     move.b  ($18,A4,D2.W),D0
02:0003AA4C 0C0000F8        	  2218:     cmpi.b  #$F8,D0
