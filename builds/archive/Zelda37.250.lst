02:0003A63E 023C00EE        	  1618:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003A642 123C0008        	  1619:     move.b  #$08,D1
02:0003A646 D101            	  1620:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A648 020000F0        	  1621:     andi.b #$F0,D0
02:0003A64C 19802070        	  1622:     move.b  D0,($70,A4,D2.W)
                            	  1623:     ; Set Y coordinate to (((Y + 8) AND $F0) OR $D).
                            	  1624:     ;
02:0003A650 41EC0084        	  1625:     lea     ($0084,A4),A0
02:0003A654 10302000        	  1626:     move.b  (A0,D2.W),D0
02:0003A658 123C0008        	  1627:     move.b  #$08,D1
02:0003A65C D101            	  1628:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003A65E 020000F0        	  1629:     andi.b #$F0,D0
