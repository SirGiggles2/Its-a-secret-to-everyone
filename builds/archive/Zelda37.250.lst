                            	  5596: AnimateAndDrawObjectWalking:
02:00031B6C 4EB90004CC66    	  5597:     jsr     AnimateObjectWalking
02:00031B72 1003            	  5598:     move.b  D3,D0
02:00031B74 6004            	  5599:     jmp     DrawObjectNotMirrored
                            	  5600: 
                            	  5601: ; Params:
                            	  5602: ; A: frame image
                            	  5603: ; X: object index
                            	  5604: ; [00]: object X
                            	  5605: ; [01]: object Y
                            	  5606: ;
                            	  5607: ;
                            	  5608: ; Set [0C] mirrored.
                            	  5609:     even
                            	  5610: DrawObjectMirrored:
02:00031B76 7601            	  5611:     moveq   #1,D3
02:00031B78 6602            	  5612:     bne  _anon_z01_75
                            	  5613: ; Params:
                            	  5614: ; A: frame image
                            	  5615: ; X: object index
                            	  5616: ; [00]: object X
                            	  5617: ; [01]: object Y
                            	  5618: ; [0F]: flip horizontally
                            	  5619: ;
                            	  5620:     even
                            	  5621: DrawObjectNotMirrored:
02:00031B7A 7600            	  5622:     moveq   #0,D3
                            	  5623: _anon_z01_75:
02:00031B7C 1943000C        	  5624:     move.b  D3,($000C,A4)
                            	  5625:     ; Set animation index = object type + 1.
                            	  5626:     ;
02:00031B80 7600            	  5627:     moveq   #0,D3
02:00031B82 41EC034F        	  5628:     lea     ($034F,A4),A0
02:00031B86 16302000        	  5629:     move.b  (A0,D2.W),D3
                            	  5630: ; Params:
                            	  5631: ; A: frame
                            	  5632: ; X: object index/cycle sprite index
                            	  5633: ; Y: object type
                            	  5634: ; [00]: object X
                            	  5635: ; [01]: object Y
                            	  5636: ; [0C]: mirrored
                            	  5637: ; [0F]: flip horizontally
                            	  5638: ;
                            	  5639: ; Note:
                            	  5640: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5641: ;
                            	  5642: ; The animation index of most objects is (object type + 1),
                            	  5643: ; to make up for the fact that Link uses two animation indexes.
                            	  5644: ;
                            	  5645:     even
                            	  5646: DrawObjectWithType:
02:00031B8A 5203            	  5647:     addq.b  #1,D3
                            	  5648: ; Params:
                            	  5649: ; A: frame
                            	  5650: ; X: object index/cycle sprite index
                            	  5651: ; Y: animation index
                            	  5652: ; [00]: object X
                            	  5653: ; [01]: object Y
                            	  5654: ; [0C]: mirrored
                            	  5655: ; [0F]: flip horizontally
                            	  5656: ;
                            	  5657: ; Note:
                            	  5658: ; If the object is not mirrored, then it's horizontally flippable.
                            	  5659: ; But Link uses [0F] for flipping without checking [0C].
                            	  5660: ;
                            	  5661: ;
                            	  5662: ; [0D] holds frame.
                            	  5663:     even
                            	  5664: DrawObjectWithAnim:
02:00031B8C 1940000D        	  5665:     move.b  D0,($000D,A4)
02:00031B90 1943000E        	  5666:     move.b  D3,($000E,A4)
02:00031B94 19420008        	  5667:     move.b  D2,($0008,A4)
                            	  5668:     ; Set the left and right sprite record offsets for CurSpriteIndex.
                            	  5669:     ;
02:00031B98 7600            	  5670:     moveq   #0,D3
02:00031B9A 162C0341        	  5671:     move.b  ($0341,A4),D3
02:00031B9E 41F900031B42    	  5672:     lea     (SpriteOffsets).l,A0
02:00031BA4 10303000        	  5673:     move.b  (A0,D3.W),D0
02:00031BA8 19400343        	  5674:     move.b  D0,($0343,A4)
02:00031BAC 41F900031B43    	  5675:     lea     (SpriteOffsets+1).l,A0
02:00031BB2 10303000        	  5676:     move.b  (A0,D3.W),D0
                            	  5677:     ; But if it's Link, then hardcode them to sprites $12 and $13.
                            	  5678:     ;
02:00031BB6 4A02            	  5679:     cmpi.b  #$00,D2
02:00031BB8 6702            	  5680:     beq.s  __far_z_01_0048
02:00031BBA 6008            	  5681:     jmp  DrawObjectWithAnimAndSpecificSprites
