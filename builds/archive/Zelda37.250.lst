02:0003E17A 4EB90004CCC4    	  9816:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  9817:     ; Draw the right legs.
                            	  9818:     ;
02:0003E180 7601            	  9819:     moveq   #1,D3
02:0003E182 6102            	  9820:     jsr     Gohma_DrawLegsOneSide
                            	  9821:     ; Draw the left legs.
                            	  9822:     ;
02:0003E184 7600            	  9823:     moveq   #0,D3
                            	  9824: ; Params:
                            	  9825: ; Y: side: 0 for left, 1 for right
                            	  9826: ;
                            	  9827: ; Add the horizontal offset for the current side to Gohma's X to
                            	  9828: ; store the sprite's X in [00].
                            	  9829: ;
                            	  9830:     even
                            	  9831: Gohma_DrawLegsOneSide:
02:0003E186 10342070        	  9832:     move.b  ($70,A4,D2.W),D0
02:0003E18A 023C00EE        	  9833:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E18E 41F90003E164    	  9834:     lea     (GohmaLegOffsetsX).l,A0
02:0003E194 12303000        	  9835:     move.b  (A0,D3.W),D1
02:0003E198 D101            	  9836:     addx.b  D1,D0   ; ADC GohmaLegOffsetsX,Y
02:0003E19A 1880            	  9837:     move.b  D0,($0000,A4)
                            	  9838:     ; The object's Y is the sprite's.
                            	  9839:     ;
02:0003E19C 41EC0084        	  9840:     lea     ($0084,A4),A0
02:0003E1A0 10302000        	  9841:     move.b  (A0,D2.W),D0
02:0003E1A4 19400001        	  9842:     move.b  D0,($0001,A4)
02:0003E1A8 612A            	  9843:     jsr     Gohma_SetSpriteAttributes
                            	  9844:     ; There are only two frame images for legs: left and right.
                            	  9845:     ; There are two animation frames. They are animated as follows:
                            	  9846:     ;
                            	  9847:     ; Frame 0:
                            	  9848:     ; ((leg index + frame number) AND 1) = 0 or 1
                            	  9849:     ; horizontal flipping = frame number = 0
                            	  9850:     ; 
                            	  9851:     ; Frame 1:
                            	  9852:     ; ((leg index + frame number) AND 1) = 1 or 0
                            	  9853:     ; horizontal flipping = frame number = 1
                            	  9854:     ;
02:0003E1AA 4EB90004CC9C    	  9855:     jsr     Anim_SetObjHFlipForSpriteDescriptor
02:0003E1B0 1003            	  9856:     move.b  D3,D0
02:0003E1B2 023C00EE        	  9857:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E1B6 41EC03E4        	  9858:     lea     ($03E4,A4),A0
02:0003E1BA 12302000        	  9859:     move.b  (A0,D2.W),D1
02:0003E1BE D101            	  9860:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003E1C0 02000001        	  9861:     andi.b #$01,D0
02:0003E1C4 023C00EE        	  9862:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003E1C8 123C0004        	  9863:     move.b  #$04,D1
02:0003E1CC D101            	  9864:     addx.b  D1,D0   ; ADC #$04 (X flag = 6502 C)
02:0003E1CE 4EF900031B7A    	  9865:     jmp     DrawObjectNotMirrored
                            	  9866: 
                            	  9867: ; Returns:
                            	  9868: ; [04]: left side sprite attributes
                            	  9869: ; [05]: right side sprite attributes
                            	  9870: ;
                            	  9871:     even
                            	  9872: Gohma_SetSpriteAttributes:
02:0003E1D4 4EF90002BF4C    	  9873:     jmp     c_gohma_set_sprite_attributes
                            	  9874: 
                            	  9875: Gohma_CheckCollisions:
                            	  9876:     ; Save the boss's X coordinate.
                            	  9877:     ;
02:0003E1DA 10342070        	  9878:     move.b  ($70,A4,D2.W),D0
02:0003E1DE 1B00            	  9879:     move.b  D0,-(A5)  ; PHA
                            	  9880:     ; Subtract $10 from the X coordinate, so we start checking collisions
                            	  9881:     ; on the left side.
