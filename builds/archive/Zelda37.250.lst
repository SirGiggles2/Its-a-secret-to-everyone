02:0003B51A 10342028        	  3792:     move.b  ($28,A4,D2.W),D0
02:0003B51E E208            	  3793:     lsr.b  #1,D0   ; LSR A
02:0003B520 6512            	  3794:     bcs  _anon_z04_53
                            	  3795:     ; Finish initializing based on type.
