02:0003B1DE 1940004D        	  3303:     move.b  D0,($004D,A4)
02:0003B1E2 6100008C        	  3304:     jsr     RedLeever_CycleStateDrawAndCheckCollisions
                            	  3305:     ; The leever has to face Link in order to move toward him.
