                            	  2917:     ; Advance to state 1 with q-speed $70 (1.75 pixels a frame) (fast).
                            	  2918:     ;
02:000307F6 41EC00AC        	  2919:     lea     ($00AC,A4),A0
02:000307FA 52302000        	  2920:     addq.b  #1,(A0,D2.W)
02:000307FE 7070            	  2921:     moveq   #112,D0
02:00030800 41EC03BC        	  2922:     lea     ($03BC,A4),A0
