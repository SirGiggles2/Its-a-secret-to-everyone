02:0004363A 61001C62        	  5501:     jsr     CalcOpenDoorwayMask
02:0004363E 101D            	  5502:     move.b  (A5)+,D0  ; PLA
                            	  5503: _anon_z05_112:
                            	  5504:     ; If provisional door face < 4 (any wall), then go loop another half,
                            	  5505:     ; because the visible door face is already a wall.
                            	  5506:     ;
02:00043640 0C000004        	  5507:     cmpi.b  #$04,D0
02:00043644 650000DC        	  5508:     bcs  _L_z05_L_LayOutDoors_LoopHalves_NextLoopDoorHalf
                            	  5509:     ; For all other provisional face values, calculate:
                            	  5510:     ; door face := provisional face - 3
02:00043648 003C0011        	  5511:     ori     #$11,CCR  ; SEC: set C+X
02:0004364C 123C0003        	  5512:     move.b  #$03,D1
02:00043650 0A3C0010        	  5513:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00043654 9101            	  5514:     subx.b  D1,D0   ; SBC #$03
02:00043656 0A3C0010        	  5515:     eori    #$10,CCR  ; restore X = 6502 C
02:0004365A 7600            	  5516:     moveq   #0,D3
02:0004365C 1600            	  5517:     move.b  D0,D3
                            	  5518:     ; Furthermore, if the latest provisional door face >= 3, then
                            	  5519:     ; subtract one.
                            	  5520:     ;
02:0004365E 0C030003        	  5521:     cmpi.b  #$03,D3
02:00043662 6502            	  5522:     bcs  _anon_z05_113
02:00043664 5303            	  5523:     subq.b  #1,D3
                            	  5524: _anon_z05_113:
                            	  5525:     ; Now Y holds the door face index (DFC closed, DFO opened) for the door type (DT).
                            	  5526:     ;
                            	  5527:     ; DT DFC DFO Meaning
                            	  5528:     ; ------------------
                            	  5529:     ; 0  1   1   open
                            	  5530:     ; 4  4   5   bombable
                            	  5531:     ; 5  2   1   key
                            	  5532:     ; 6  2   1   key 2
                            	  5533:     ; 7  3   1   shutter
                            	  5534:     ;
                            	  5535:     ;
                            	  5536:     ; Get the direction index.
02:00043666 101D            	  5537:     move.b  (A5)+,D0  ; PLA
02:00043668 1B00            	  5538:     move.b  D0,-(A5)  ; PHA
02:0004366A 610000D0        	  5539:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5540:     ; If handling the second half, then offset to the second half
                            	  5541:     ; of the tiles.
                            	  5542:     ;
02:0004366E 102C0006        	  5543:     move.b  ($0006,A4),D0
02:00043672 6618            	  5544:     bne  _anon_z05_114
02:00043674 41F90004358A    	  5545:     lea     (DirIndexToDoorSecondHalfOffsets).l,A0
02:0004367A 10302000        	  5546:     move.b  (A0,D2.W),D0
02:0004367E 4EB90003147A    	  5547:     jsr     AddToInt16At0
02:00043684 7006            	  5548:     moveq   #6,D0
02:00043686 4EB900031482    	  5549:     jsr     AddToInt16At2
