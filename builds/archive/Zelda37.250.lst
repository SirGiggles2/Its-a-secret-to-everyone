02:0004444C 123C0040        	  7124:     move.b  #$40,D1
02:00044450 0A3C0010        	  7125:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00044454 9101            	  7126:     subx.b  D1,D0   ; SBC #$40
