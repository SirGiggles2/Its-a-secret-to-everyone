02:00041D4C 41EC00AC        	  3462:     lea     ($00AC,A4),A0
02:00041D50 10302000        	  3463:     move.b  (A0,D2.W),D0
02:00041D54 670000A6        	  3464:     beq  _L_z05_CheckLadder_StashLadder
                            	  3465:     ; If the ladder is facing vertically, calculate the vertical distance
