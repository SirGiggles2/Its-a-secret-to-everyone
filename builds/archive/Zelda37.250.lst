02:0003B1C4 122C034A        	  3290:     move.b  ($034A,A4),D1
02:0003B1C8 B001            	  3291:     cmp.b   D1,D0
02:0003B1CA 6400FF78        	  3292:     bcc  _L_z04_UpdateRedLeever_Exit
02:0003B1CE 522C0510        	  3293:     addq.b  #1,($0510,A4)
                            	  3294:     ; Set animation counter to 1, so that it will roll over this frame
                            	  3295:     ; and pick up whatever the new value is for state 1.
                            	  3296:     ;
