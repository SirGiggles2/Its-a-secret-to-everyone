                            	  5413: _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF:
                            	  5414:     ; The door attribute (DA) has been mapped to a
                            	  5415:     ; provisional door face value (PF) in %A as follows:
                            	  5416:     ;
                            	  5417:     ; DA PF Meaning
                            	  5418:     ; -------------
                            	  5419:     ; 0  4  open
                            	  5420:     ; 1  1  wall
                            	  5421:     ; 2  2  false wall
                            	  5422:     ; 3  3  false wall 2
                            	  5423:     ; 4  8  bombable
                            	  5424:     ; 5  5  key
                            	  5425:     ; 6  6  key 2
                            	  5426:     ; 7  7  shutter
                            	  5427:     ;
                            	  5428:     ; Also at this point, the door bit in CurOpenedDoors
                            	  5429:     ; has been cleared, if the type was "open" or any wall.
                            	  5430:     ;
                            	  5431:     ;
                            	  5432:     ; Save the provisional face.
02:000435E8 1B00            	  5433:     move.b  D0,-(A5)  ; PHA
                            	  5434:     ; If the current direction points to a door that has been opened,
                            	  5435:     ; then see if we need to set door flags.
                            	  5436:     ;
02:000435EA 102C00EE        	  5437:     move.b  ($00EE,A4),D0
02:000435EE 122C0002        	  5438:     move.b  ($0002,A4),D1
02:000435F2 C001            	  5439:     and.b  D1,D0
02:000435F4 7400            	  5440:     moveq   #0,D2
02:000435F6 1400            	  5441:     move.b  D0,D2
02:000435F8 101D            	  5442:     move.b  (A5)+,D0  ; PLA
02:000435FA 122C0002        	  5443:     move.b  ($0002,A4),D1
02:000435FE B401            	  5444:     cmp.b   D1,D2
02:00043600 6624            	  5445:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5446:     ; The current direction points to a door that has been opened.
                            	  5447:     ; It can only be "bombable", "key", "key 2", or "shutter".
                            	  5448:     ;
                            	  5449:     ;
                            	  5450:     ; Save provisional door face in Y register.
02:00043602 7600            	  5451:     moveq   #0,D3
02:00043604 1600            	  5452:     move.b  D0,D3
02:00043606 101D            	  5453:     move.b  (A5)+,D0  ; PLA
02:00043608 1B00            	  5454:     move.b  D0,-(A5)  ; PHA
02:0004360A 7400            	  5455:     moveq   #0,D2
02:0004360C 1400            	  5456:     move.b  D0,D2
02:0004360E 1003            	  5457:     move.b  D3,D0
                            	  5458:     ; If provisional door face is not for a shutter, then
                            	  5459:     ; it's for a "key" or "bombable". So, set the door's flag.
                            	  5460:     ;
                            	  5461:     ; Else it is for a shutter. Go set provisional door face to 4.
                            	  5462:     ;
02:00043610 0C000007        	  5463:     cmpi.b  #$07,D0
02:00043614 670E            	  5464:     beq  _anon_z05_111
02:00043616 1B00            	  5465:     move.b  D0,-(A5)  ; PHA
02:00043618 6100DF68        	  5466:     jsr     SetDoorFlag
02:0004361C 101D            	  5467:     move.b  (A5)+,D0  ; PLA
                            	  5468:     ; If the provisional door face = 8 (closed "bombable"),
                            	  5469:     ; then go make it 9 (open "bombable").
                            	  5470:     ; Else make it 4 (open "door").
                            	  5471:     ;
02:0004361E 0C000008        	  5472:     cmpi.b  #$08,D0
02:00043622 67A4            	  5473:     beq  _L_z05_L_LayOutDoors_LoopHalves_SetPF9
                            	  5474: _anon_z05_111:
02:00043624 7004            	  5475:     moveq   #4,D0
