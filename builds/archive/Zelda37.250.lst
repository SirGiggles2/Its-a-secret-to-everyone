02:00042122 12303000        	  4028:     move.b  (A0,D3.W),D1
02:00042126 B001            	  4029:     cmp.b   D1,D0
02:00042128 6510            	  4030:     bcs  _anon_z05_95
02:0004212A 41F9000420EC    	  4031:     lea     (DoorwayBoundsMaxOver).l,A0
02:00042130 12303000        	  4032:     move.b  (A0,D3.W),D1
02:00042134 B001            	  4033:     cmp.b   D1,D0
