02:0003F1FA 41EC0098        	 12029:     lea     ($0098,A4),A0
02:0003F1FE 11802000        	 12030:     move.b  D0,(A0,D2.W)
                            	 12031:     ; Set angle $18 (N).
                            	 12032:     ;
