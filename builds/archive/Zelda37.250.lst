02:0003F342 7400            	 12196:     moveq   #0,D2
02:0003F344 1400            	 12197:     move.b  D0,D2
                            	 12198:     ; Turn off the room brightening flag, because we're controlling it
                            	 12199:     ; here instead of in the Mode 5 object update loop.
                            	 12200:     ;
02:0003F346 7000            	 12201:     moveq   #0,D0
02:0003F348 1940051E        	 12202:     move.b  D0,($051E,A4)
                            	 12203:     ; On the first frame of the fade-to-light cycle, play the
                            	 12204:     ; Triforce/Ganon song.
                            	 12205:     ;
02:0003F34C 102C051C        	 12206:     move.b  ($051C,A4),D0
02:0003F350 0C0000C0        	 12207:     cmpi.b  #$C0,D0
02:0003F354 6606            	 12208:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0003F356 7002            	 12209:     moveq   #2,D0
