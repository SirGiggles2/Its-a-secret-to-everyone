                            	  9658:     ;
02:0003E052 122C0002        	  9659:     move.b  ($0002,A4),D1
02:0003E056 E309            	  9660:     lsl.b  #1,D1   ; ASL $02
02:0003E058 19410002        	  9661:     move.b  D1,($0002,A4)
02:0003E05C 122C0002        	  9662:     move.b  ($0002,A4),D1
02:0003E060 C200            	  9663:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003E062 6708            	  9664:     beq  _anon_z04_121
02:0003E064 41EC0084        	  9665:     lea     ($0084,A4),A0
02:0003E068 53302000        	  9666:     subq.b  #1,(A0,D2.W)
                            	  9667: _anon_z04_121:
                            	  9668:     ; If Gohma has not traveled $20 pixels, then go animate the eye.
                            	  9669:     ;
02:0003E06C 41EC0412        	  9670:     lea     ($0412,A4),A0
