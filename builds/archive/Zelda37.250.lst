                            	  2646:     ; We'll be computing the location of the square.
                            	  2647:     ; Start with Link's location.
                            	  2648:     ;
02:000305EC 102C0070        	  2649:     move.b  ($0070,A4),D0
02:000305F0 1880            	  2650:     move.b  D0,($0000,A4)
02:000305F2 102C0084        	  2651:     move.b  ($0084,A4),D0
02:000305F6 19400001        	  2652:     move.b  D0,($0001,A4)
02:000305FA 102C0098        	  2653:     move.b  ($0098,A4),D0
02:000305FE 0200000C        	  2654:     andi.b #$0C,D0
02:00030602 6726            	  2655:     beq  _L_z01_CheckPassiveTileObjects_CheckHorizontal
                            	  2656:     ; Link is facing vertically.
                            	  2657:     ;
                            	  2658:     ; If Link touched the left side of the square with the right side
                            	  2659:     ; of his body, then add 8 to X.
                            	  2660:     ;
                            	  2661:     ; If Link touched the right side of the square with the left side
                            	  2662:     ; of his body, then bitwise AND'ing with $F0 will align X with the square.
                            	  2663:     ;
02:00030604 102C0002        	  2664:     move.b  ($0002,A4),D0
02:00030608 02000003        	  2665:     andi.b #$03,D0
02:0003060C 7600            	  2666:     moveq   #0,D3
02:0003060E 1600            	  2667:     move.b  D0,D3
02:00030610 1014            	  2668:     move.b  ($0000,A4),D0
02:00030612 0C030002        	  2669:     cmpi.b  #$02,D3
02:00030616 640A            	  2670:     bcc  _anon_z01_24
02:00030618 023C00EE        	  2671:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003061C 123C0008        	  2672:     move.b  #$08,D1
02:00030620 D101            	  2673:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
