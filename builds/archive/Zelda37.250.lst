02:0003CD06 123C0008        	  7040:     move.b  #$08,D1
02:0003CD0A D101            	  7041:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD0C 7600            	  7042:     moveq   #0,D3
02:0003CD0E 41EC0098        	  7043:     lea     ($0098,A4),A0
02:0003CD12 16302000        	  7044:     move.b  (A0,D2.W),D3
