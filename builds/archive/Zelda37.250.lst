                            	  4173:     ;
02:0004BA44 41EC04BF        	  4174:     lea     ($04BF,A4),A0
02:0004BA48 10302000        	  4175:     move.b  (A0,D2.W),D0
02:0004BA4C 02000010        	  4176:     andi.b #$10,D0
02:0004BA50 6702            	  4177:     beq.s  __far_z_07_0051
02:0004BA52 600E            	  4178:     jmp  Reverse
                            	  4179: __far_z_07_0051:
02:0004BA54 41EC03F8        	  4180:     lea     ($03F8,A4),A0
02:0004BA58 10302000        	  4181:     move.b  (A0,D2.W),D0
02:0004BA5C 1940000F        	  4182:     move.b  D0,($000F,A4)
