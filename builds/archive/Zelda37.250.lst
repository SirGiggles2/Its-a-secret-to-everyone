                            	   444: UpdateMenuScrollUp:
                            	   445:     ; Move position marker's and vertical scroll up 3 pixels.
                            	   446:     ;
02:000402E6 103C00FD        	   447:     move.b  #$FD,D0
02:000402EA 613A            	   448:     jsr     MovePositionMarkers
02:000402EC 102C00FC        	   449:     move.b  ($00FC,A4),D0
02:000402F0 023C00EE        	   450:     andi    #$EE,CCR  ; CLC: clear C+X
02:000402F4 123C0003        	   451:     move.b  #$03,D1
02:000402F8 D101            	   452:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:000402FA 194000FC        	   453:     move.b  D0,($00FC,A4)
                            	   454:     ; If hardware vertical scroll still < $F0, then return.
                            	   455:     ;
02:000402FE 0C0000F0        	   456:     cmpi.b  #$F0,D0
02:00040302 6406            	   457:     bcc.s  __far_z_05_0001
02:00040304 4EF90002D7D2    	   458:     jmp  Exit
                            	   459: __far_z_05_0001:
                            	   460:     ; Once vertical scroll >= $F0, switch to NT0.
                            	   461:     ;
02:0004030A 1940005C        	   462:     move.b  D0,($005C,A4)
                            	   463:     ; In UW, clear the first $10 sprites. This clears the submenu cursor.
                            	   464:     ;
                            	   465:     ; UNKNOWN: But why not do this in OW, too?
                            	   466:     ;
02:0004030E 102C0010        	   467:     move.b  ($0010,A4),D0
02:00040312 6706            	   468:     beq  _anon_z05_4
02:00040314 4EB90003189C    	   469:     jsr     WriteBlankPrioritySprites
                            	   470: _anon_z05_4:
                            	   471:     ; We reached the end. So, reset hardware vertical scroll
                            	   472:     ; and submenu state.
                            	   473:     ;
02:0004031A 7000            	   474:     moveq   #0,D0
02:0004031C 194000FC        	   475:     move.b  D0,($00FC,A4)
02:00040320 194000E1        	   476:     move.b  D0,($00E1,A4)
                            	   477:     ; Move the position markers 2 pixels down, because we
                            	   478:     ; overshot and reached vertical scroll $F2.
                            	   479:     ;
02:00040324 7002            	   480:     moveq   #2,D0
                            	   481: ; Params:
                            	   482: ; A: vertical velocity of menu scrolling
                            	   483: ;
                            	   484: ;
                            	   485: ; [00] holds the vertical velocity of menu scrolling.
                            	   486:     even
                            	   487: MovePositionMarkers:
02:00040326 1880            	   488:     move.b  D0,($0000,A4)
                            	   489:     ; If Link's position marker is visible, then move it by the velocity in [00].
                            	   490:     ;
02:00040328 102C0254        	   491:     move.b  ($0254,A4),D0
02:0004032C 0C0000F8        	   492:     cmpi.b  #$F8,D0
02:00040330 670C            	   493:     beq  _anon_z05_5
02:00040332 023C00EE        	   494:     andi    #$EE,CCR  ; CLC: clear C+X
02:00040336 1214            	   495:     move.b  ($0000,A4),D1
02:00040338 D101            	   496:     addx.b  D1,D0   ; ADC $00
02:0004033A 19400254        	   497:     move.b  D0,($0254,A4)
                            	   498: _anon_z05_5:
                            	   499:     ; If in UW and have the compass, then move the triforce position marker.
                            	   500:     ;
02:0004033E 102C0010        	   501:     move.b  ($0010,A4),D0
02:00040342 6606            	   502:     bne.s  __far_z_05_0002
02:00040344 4EF90002D7D2    	   503:     jmp  Exit
                            	   504: __far_z_05_0002:
02:0004034A 61004EC2        	   505:     jsr     HasCompass
02:0004034E 6606            	   506:     bne.s  __far_z_05_0003
02:00040350 4EF90002D7D2    	   507:     jmp  Exit
                            	   508: __far_z_05_0003:
02:00040356 102C0258        	   509:     move.b  ($0258,A4),D0
02:0004035A 023C00EE        	   510:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004035E 1214            	   511:     move.b  ($0000,A4),D1
02:00040360 D101            	   512:     addx.b  D1,D0   ; ADC $00
02:00040362 19400258        	   513:     move.b  D0,($0258,A4)
                            	   514:     even
                            	   515:     IFND Exit
