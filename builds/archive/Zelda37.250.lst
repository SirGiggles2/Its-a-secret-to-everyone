02:0003F216 7600            	 12045:     moveq   #0,D3
02:0003F218 41EC034F        	 12046:     lea     ($034F,A4),A0
02:0003F21C 16302000        	 12047:     move.b  (A0,D2.W),D3
02:0003F220 0C030025        	 12048:     cmpi.b  #$25,D3
02:0003F224 6702            	 12049:     beq  _anon_z04_158
02:0003F226 7018            	 12050:     moveq   #24,D0
                            	 12051: _anon_z04_158:
