02:0003BFFC 11802000        	  5274:     move.b  D0,(A0,D2.W)
                            	  5275:     ; But, if Link is down from the monster, then face down.
                            	  5276:     ;
02:0003C000 102C0084        	  5277:     move.b  ($0084,A4),D0
02:0003C004 41EC0084        	  5278:     lea     ($0084,A4),A0
02:0003C008 12302000        	  5279:     move.b  (A0,D2.W),D1
02:0003C00C B001            	  5280:     cmp.b   D1,D0
02:0003C00E 650E            	  5281:     bcs  _L_z04_UpdateRope_Rush
                            	  5282:     even
