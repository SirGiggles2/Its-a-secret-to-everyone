02:0003A7B4 12303000        	  1832:     move.b  (A0,D3.W),D1
02:0003A7B8 B001            	  1833:     cmp.b   D1,D0
02:0003A7BA 670A            	  1834:     beq  _L_z04_UpdateStatues_Shoot
