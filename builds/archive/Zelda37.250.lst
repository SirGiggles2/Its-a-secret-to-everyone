02:0003BF5C 8001            	  5210:     or.b  D1,D0
02:0003BF5E 6642            	  5211:     bne  _L_z04_UpdateRope_CheckSpeed
02:0003BF60 4EB90004B82A    	  5212:     jsr     Walker_Move
