                            	  5198: UpdateRope:
                            	  5199:     ; Set the input direction to the facing direction.
                            	  5200:     ;
02:0003BF42 41EC0098        	  5201:     lea     ($0098,A4),A0
02:0003BF46 10302000        	  5202:     move.b  (A0,D2.W),D0
02:0003BF4A 41EC03F8        	  5203:     lea     ($03F8,A4),A0
02:0003BF4E 11802000        	  5204:     move.b  D0,(A0,D2.W)
02:0003BF52 1B00            	  5205:     move.b  D0,-(A5)  ; PHA
                            	  5206:     ; If we have the clock, or the monster is stunned, then don't move.
                            	  5207:     ;
02:0003BF54 102C066C        	  5208:     move.b  ($066C,A4),D0
