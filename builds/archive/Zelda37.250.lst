                            	  6251: Digdogger_Move:
                            	  6252:     ; This calculation is the same one used in Manhandla to
                            	  6253:     ; manifest the fractional speed over several frames.
                            	  6254:     ;
                            	  6255:     ; To summarize, the formula is:
                            	  6256:     ;
                            	  6257:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  6258:     ;
                            	  6259:     ;   SA := SA + (SL AND $E0)
                            	  6260:     ;   [03] := SH + carry
                            	  6261:     ;
                            	  6262:     ; See 04:A28E Manhandla_Move.
                            	  6263:     ;
02:0003C71C 41EC041F        	  6264:     lea     ($041F,A4),A0
02:0003C720 10302000        	  6265:     move.b  (A0,D2.W),D0
02:0003C724 020000E0        	  6266:     andi.b #$E0,D0
02:0003C728 023C00EE        	  6267:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C72C 41EC0412        	  6268:     lea     ($0412,A4),A0
02:0003C730 12302000        	  6269:     move.b  (A0,D2.W),D1
02:0003C734 D101            	  6270:     addx.b  D1,D0   ; ADC $0412,X
02:0003C736 41EC0412        	  6271:     lea     ($0412,A4),A0
02:0003C73A 11802000        	  6272:     move.b  D0,(A0,D2.W)
                            	  6273:     ; Assign (high speed byte + carry) to [03].
                            	  6274:     ;
02:0003C73E 41EC042C        	  6275:     lea     ($042C,A4),A0
02:0003C742 10302000        	  6276:     move.b  (A0,D2.W),D0
02:0003C746 123C0000        	  6277:     move.b  #$00,D1
02:0003C74A D101            	  6278:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0003C74C 19400003        	  6279:     move.b  D0,($0003,A4)
                            	  6280:     ; Change coordinates by the speed amount/offset in [03]
                            	  6281:     ; according to the direction.
                            	  6282:     ;
                            	  6283:     ; Start with a mask of $A1 in [02]:
                            	  6284:     ; - low nibble represents the right direction
                            	  6285:     ; - high nibble is used to set or clear carry as we go along
                            	  6286:     ;
02:0003C750 103C00A1        	  6287:     move.b  #$A1,D0
02:0003C754 19400002        	  6288:     move.b  D0,($0002,A4)
                            	  6289:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  6290:     ;
02:0003C758 41EC0098        	  6291:     lea     ($0098,A4),A0
02:0003C75C 10302000        	  6292:     move.b  (A0,D2.W),D0
02:0003C760 122C0002        	  6293:     move.b  ($0002,A4),D1
02:0003C764 C200            	  6294:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C766 6712            	  6295:     beq  _L_z04_Digdogger_Move_Left
02:0003C768 10342070        	  6296:     move.b  ($70,A4,D2.W),D0
02:0003C76C 023C00EE        	  6297:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003C770 122C0003        	  6298:     move.b  ($0003,A4),D1
02:0003C774 D101            	  6299:     addx.b  D1,D0   ; ADC $03
02:0003C776 19802070        	  6300:     move.b  D0,($70,A4,D2.W)
                            	  6301:     even
                            	  6302: _L_z04_Digdogger_Move_Left:
                            	  6303:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  6304:     ;
02:0003C77A 41EC0098        	  6305:     lea     ($0098,A4),A0
02:0003C77E 10302000        	  6306:     move.b  (A0,D2.W),D0
02:0003C782 122C0002        	  6307:     move.b  ($0002,A4),D1
02:0003C786 E309            	  6308:     lsl.b  #1,D1   ; ASL $02
02:0003C788 19410002        	  6309:     move.b  D1,($0002,A4)
02:0003C78C 122C0002        	  6310:     move.b  ($0002,A4),D1
02:0003C790 C200            	  6311:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003C792 6716            	  6312:     beq  _L_z04_Digdogger_Move_Down
02:0003C794 10342070        	  6313:     move.b  ($70,A4,D2.W),D0
02:0003C798 122C0003        	  6314:     move.b  ($0003,A4),D1
