                            	  3158:     ; Only allow two red leevers at a time.
                            	  3159:     ;
02:0003B0D0 102C0510        	  3160:     move.b  ($0510,A4),D0
02:0003B0D4 0C000002        	  3161:     cmpi.b  #$02,D0
02:0003B0D8 646A            	  3162:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  3163:     ; Face in the same direction as Link.
                            	  3164:     ;
02:0003B0DA 102C0098        	  3165:     move.b  ($0098,A4),D0
02:0003B0DE 41EC0098        	  3166:     lea     ($0098,A4),A0
02:0003B0E2 11802000        	  3167:     move.b  D0,(A0,D2.W)
                            	  3168:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  3169:     ;
02:0003B0E6 10342019        	  3170:     move.b  ($19,A4,D2.W),D0
02:0003B0EA 0C0000C0        	  3171:     cmpi.b  #$C0,D0
02:0003B0EE 6506            	  3172:     bcs  _anon_z04_43
02:0003B0F0 4EB90004BBAA    	  3173:     jsr     ReverseObjDir
                            	  3174: _anon_z04_43:
                            	  3175:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  3176:     ;
02:0003B0F6 41EC0098        	  3177:     lea     ($0098,A4),A0
