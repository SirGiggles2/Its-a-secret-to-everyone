                            	  7331: _L_z07_InitObject_InitMonsterFromEdge:
02:0004D106 7400            	  7332:     moveq   #0,D2
02:0004D108 142C0340        	  7333:     move.b  ($0340,A4),D2
                            	  7334:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7335:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7336:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7337:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7338:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7339:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7340:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7341:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7342:     ; corrupting them and causing a deterministic address-error
                            	  7343:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7344:     ; identified by Codex static review.)
                            	  7345: _L_z07_P47_pre_check:
02:0004D10C 102C0525        	  7346:     move.b  ($0525,A4),D0
02:0004D110 020000F0        	  7347:     andi.b  #$F0,D0
02:0004D114 0C000040        	  7348:     cmpi.b  #$40,D0
02:0004D118 6506            	  7349:     blo     _L_z07_P47_pre_snap
02:0004D11A 0C0000E0        	  7350:     cmpi.b  #$E0,D0
02:0004D11E 6506            	  7351:     blo     _L_z07_P47_pre_ok
                            	  7352: _L_z07_P47_pre_snap:
02:0004D120 197C00480525    	  7353:     move.b  #$48,($0525,A4)
                            	  7354: _L_z07_P47_pre_ok:
02:0004D126 7005            	  7355:     moveq   #5,D0
02:0004D128 610004F4        	  7356:     jsr     SwitchBank
02:0004D12C 4EB900041EC0    	  7357:     jsr     FindNextEdgeSpawnCell
                            	  7358:     ; Post-walk 1: bottom-edge snap.
02:0004D132 102C0525        	  7359:     move.b  ($0525,A4),D0
02:0004D136 020000F0        	  7360:     andi.b  #$F0,D0
02:0004D13A 0C0000E0        	  7361:     cmpi.b  #$E0,D0
02:0004D13E 660C            	  7362:     bne     _L_z07_P47_post1_ok
02:0004D140 197C00480525    	  7363:     move.b  #$48,($0525,A4)
02:0004D146 4EB900041EC0    	  7364:     jsr     FindNextEdgeSpawnCell
                            	  7365: _L_z07_P47_post1_ok:
                            	  7366:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7367:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0004D14C 7600            	  7368:     moveq   #0,D3
02:0004D14E 162C0525        	  7369:     move.b  ($0525,A4),D3
02:0004D152 0243000F        	  7370:     andi.w  #$000F,D3
02:0004D156 C6FC002C        	  7371:     mulu.w  #44,D3
02:0004D15A 203C00FF6530    	  7372:     move.l  #$FF6530,D0
02:0004D160 D083            	  7373:     add.l   D3,D0
02:0004D162 7600            	  7374:     moveq   #0,D3
02:0004D164 162C0525        	  7375:     move.b  ($0525,A4),D3
02:0004D168 E84B            	  7376:     lsr.w   #4,D3
02:0004D16A 5943            	  7377:     subi.w  #4,D3
02:0004D16C E34B            	  7378:     lsl.w   #1,D3
02:0004D16E D083            	  7379:     add.l   D3,D0
02:0004D170 2040            	  7380:     movea.l D0,A0
02:0004D172 1010            	  7381:     move.b  (A0),D0
02:0004D174 0C000084        	  7382:     cmpi.b  #$84,D0
02:0004D178 6544            	  7383:     blo     _L_z07_P47_post2_ok
                            	  7384:     ; Unwalkable — pick from fallback table, scan up to 8 tries.
                            	  7385:     ; Local counter lives in D4.b (caller-clobberable); no RAM
                            	  7386:     ; writes to the $05xx region.
02:0004D17A 7800            	  7387:     moveq   #0,D4
                            	  7388: _L_z07_P47_fb_loop:
02:0004D17C 41FAE48E        	  7389:     lea     _L_z07_P47_FallbackCells(pc),A0
02:0004D180 12304000        	  7390:     move.b  (A0,D4.W),D1
02:0004D184 19410525        	  7391:     move.b  D1,($0525,A4)
                            	  7392:     ; Validate fallback cell walkable.
02:0004D188 7600            	  7393:     moveq   #0,D3
02:0004D18A 1601            	  7394:     move.b  D1,D3
02:0004D18C 0243000F        	  7395:     andi.w  #$000F,D3
02:0004D190 C6FC002C        	  7396:     mulu.w  #44,D3
02:0004D194 203C00FF6530    	  7397:     move.l  #$FF6530,D0
02:0004D19A D083            	  7398:     add.l   D3,D0
02:0004D19C 7600            	  7399:     moveq   #0,D3
02:0004D19E 1601            	  7400:     move.b  D1,D3
02:0004D1A0 E84B            	  7401:     lsr.w   #4,D3
02:0004D1A2 5943            	  7402:     subi.w  #4,D3
02:0004D1A4 E34B            	  7403:     lsl.w   #1,D3
02:0004D1A6 D083            	  7404:     add.l   D3,D0
02:0004D1A8 2040            	  7405:     movea.l D0,A0
02:0004D1AA 0C100084        	  7406:     cmpi.b  #$84,(A0)
02:0004D1AE 650E            	  7407:     blo     _L_z07_P47_post2_ok
02:0004D1B0 5204            	  7408:     addq.b  #1,D4
02:0004D1B2 0C040008        	  7409:     cmpi.b  #8,D4
02:0004D1B6 65C4            	  7410:     blo     _L_z07_P47_fb_loop
                            	  7411:     ; All 8 fallback cells unwalkable — just use $48 (fails gracefully
                            	  7412:     ; rather than looping).
02:0004D1B8 197C00480525    	  7413:     move.b  #$48,($0525,A4)
                            	  7414: _L_z07_P47_post2_ok:
                            	  7415:     ; Extract and set the monster's location.
                            	  7416:     ;
02:0004D1BE 102C0525        	  7417:     move.b  ($0525,A4),D0
                            	  7418:     ; Square column in low nibble. Multiply by 16 to get X.
                            	  7419:     ;
02:0004D1C2 1B00            	  7420:     move.b  D0,-(A5)  ; PHA
02:0004D1C4 E308            	  7421:     lsl.b  #1,D0   ; ASL A
02:0004D1C6 E308            	  7422:     lsl.b  #1,D0   ; ASL A
02:0004D1C8 E308            	  7423:     lsl.b  #1,D0   ; ASL A
02:0004D1CA E308            	  7424:     lsl.b  #1,D0   ; ASL A
02:0004D1CC 19802070        	  7425:     move.b  D0,($70,A4,D2.W)
                            	  7426:     ; Square row in high nibble. Subtract 3, for the usual offset, to get Y.
                            	  7427:     ;
02:0004D1D0 101D            	  7428:     move.b  (A5)+,D0  ; PLA
02:0004D1D2 020000F0        	  7429:     andi.b #$F0,D0
02:0004D1D6 003C0011        	  7430:     ori     #$11,CCR  ; SEC: set C+X
02:0004D1DA 123C0003        	  7431:     move.b  #$03,D1
02:0004D1DE 0A3C0010        	  7432:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004D1E2 9101            	  7433:     subx.b  D1,D0   ; SBC #$03
02:0004D1E4 0A3C0010        	  7434:     eori    #$10,CCR  ; restore X = 6502 C
02:0004D1E8 41EC0084        	  7435:     lea     ($0084,A4),A0
02:0004D1EC 11802000        	  7436:     move.b  D0,(A0,D2.W)
                            	  7437:     ; Set the monsters-from-edges long timer to a random value
                            	  7438:     ; between 2 and 5. So, it will last 20 to 50 frames.
                            	  7439:     ;
02:0004D1F0 10342019        	  7440:     move.b  ($19,A4,D2.W),D0
02:0004D1F4 02000003        	  7441:     andi.b #$03,D0
02:0004D1F8 023C00EE        	  7442:     andi    #$EE,CCR  ; CLC: clear C+X
