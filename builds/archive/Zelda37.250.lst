                            	 10856: _L_z04_Gleeok_CheckCollisions_BossDied:
                            	 10857:     ; The whole gleeok died, because the last neck died.
                            	 10858:     ;
                            	 10859:     ; First, hide the first $10 sprites: the attached heads.
                            	 10860:     ;
02:0003E958 4EB90003189C    	 10861:     jsr     WriteBlankPrioritySprites
02:0003E95E 61000F3A        	 10862:     jsr     PlayBossDeathCry
                            	 10863:     ; We want a death spark. So, set the metastate of the first
