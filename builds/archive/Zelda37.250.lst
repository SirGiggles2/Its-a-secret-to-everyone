02:0004C67C 7001            	  5973:     moveq   #1,D0
                            	  5974: _anon_z07_32:
                            	  5975:     ; Set both the player's animation counter and the sword's
                            	  5976:     ; animation counter/timer to this value.
                            	  5977:     ;
02:0004C67E 194003D0        	  5978:     move.b  D0,($03D0,A4)
02:0004C682 41EC03D0        	  5979:     lea     ($03D0,A4),A0
02:0004C686 11802000        	  5980:     move.b  D0,(A0,D2.W)
                            	  5981:     ; Go to the next state.
                            	  5982:     ;
02:0004C68A 41EC00AC        	  5983:     lea     ($00AC,A4),A0
02:0004C68E 52302000        	  5984:     addq.b  #1,(A0,D2.W)
                            	  5985:     ; Once we reach state 6, deactivate the object.
                            	  5986:     ; Otherwise, go draw it.
                            	  5987:     ;
02:0004C692 41EC00AC        	  5988:     lea     ($00AC,A4),A0
02:0004C696 10302000        	  5989:     move.b  (A0,D2.W),D0
02:0004C69A 0200000F        	  5990:     andi.b #$0F,D0
02:0004C69E 0C000006        	  5991:     cmpi.b  #$06,D0
02:0004C6A2 6506            	  5992:     bcs  _L_z07_UpdateSwordOrRod_DrawSwordOrRod
