                            	  1165:     ; Sprite entry-0 = BG mirror: remap 16→0, 20→4, 24→8, 28→12
02:0000E68C 04420010        	  1166:     subi.w  #$10,D2
                            	  1167: .t19_bg_color:
02:0000E690 3602            	  1168:     move.w  D2,D3
02:0000E692 E44B            	  1169:     lsr.w   #2,D3                   ; D3.w = palette index (0..3)
02:0000E694 EB4B            	  1170:     lsl.w   #5,D3                   ; D3.w = palette * $20
02:0000E696 02420003        	  1171:     andi.w  #$0003,D2               ; D2.w = color slot (0..3)
02:0000E69A E34A            	  1172:     lsl.w   #1,D2                   ; D2.w = color * 2
02:0000E69C D642            	  1173:     add.w   D2,D3                   ; D3.w = CRAM address (0..$66)
