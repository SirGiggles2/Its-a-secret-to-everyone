                            	   549:     ; definitely be clear.
02:00033A20 6100D1F6        	   550:     jsr     FetchFileAAddressSet
02:00033A24 101D            	   551:     move.b  (A5)+,D0  ; PLA
02:00033A26 7600            	   552:     moveq   #0,D3
02:00033A28 1600            	   553:     move.b  D0,D3
                            	   554:     even
