02:0003B1D4 41EC03D0        	  3298:     lea     ($03D0,A4),A0
02:0003B1D8 11802000        	  3299:     move.b  D0,(A0,D2.W)
                            	  3300:     ; Set the long timer to 2, meaning 20 frames.
                            	  3301:     ;
