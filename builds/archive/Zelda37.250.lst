                            	  2542:     ;
02:0003AC2C 102C066C        	  2543:     move.b  ($066C,A4),D0
02:0003AC30 1234203D        	  2544:     move.b  ($3D,A4,D2.W),D1
02:0003AC34 8001            	  2545:     or.b  D1,D0
