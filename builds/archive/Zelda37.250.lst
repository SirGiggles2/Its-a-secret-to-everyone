02:00044ABE 41F900FF687E    	  7621:     lea     (NES_SRAM+$087E).l,A0
02:00044AC4 12303000        	  7622:     move.b  (A0,D3.W),D1
02:00044AC8 B001            	  7623:     cmp.b   D1,D0
02:00044ACA 6702            	  7624:     beq  _anon_z05_165
02:00044ACC 5202            	  7625:     addq.b  #1,D2
