                            	  6536: _L_z01_Link_BeHarmed_BorrowHeart:
                            	  6537:     ; This isn't a simple case of borrowing. For example, supposing:
                            	  6538:     ;   full heart=4 partial heart=$70
                            	  6539:     ; The straightforward way to subtract $80 would yield $3F0.
                            	  6540:     ; But the method here yields $3EF, because partial heart is
                            	  6541:     ; considered full when = $FF instead of $100.
                            	  6542:     ;
02:00032234 102C000E        	  6543:     move.b  ($000E,A4),D0
02:00032238 003C0011        	  6544:     ori     #$11,CCR  ; SEC: set C+X
02:0003223C 122C0670        	  6545:     move.b  ($0670,A4),D1
02:00032240 0A3C0010        	  6546:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00032244 9101            	  6547:     subx.b  D1,D0   ; SBC HeartPartial
02:00032246 0A3C0010        	  6548:     eori    #$10,CCR  ; restore X = 6502 C
02:0003224A 1940000E        	  6549:     move.b  D0,($000E,A4)
02:0003224E 102C066F        	  6550:     move.b  ($066F,A4),D0
02:00032252 0200000F        	  6551:     andi.b #$0F,D0
02:00032256 6710            	  6552:     beq  _L_z01_Link_BeHarmed_HandleDied
02:00032258 532C066F        	  6553:     subq.b  #1,($066F,A4)
02:0003225C 103C00FF        	  6554:     move.b  #$FF,D0
02:00032260 19400670        	  6555:     move.b  D0,($0670,A4)
02:00032264 6600FF6E        	  6556:     bne  _L_z01_Link_BeHarmed_ResetHelp
                            	  6557:     even
