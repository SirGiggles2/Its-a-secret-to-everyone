02:0002BFB0 003C0001        	  2223:     ori     #$01,CCR
02:0002BFB4 0A3C0001        	  2224:     eori    #$01,CCR
02:0002BFB8 4E75            	  2225:     rts
                            	  2226: .cc_cnras:
02:0002BFBA 023C00FE        	  2227:     andi    #$FE,CCR
