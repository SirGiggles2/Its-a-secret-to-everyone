                            	  9535: Manhandla_Draw:
02:0003DF62 4EB90004CCCA    	  9536:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  9537:     ; Push the "frame image and sprite attributes" value.
                            	  9538:     ;
02:0003DF68 41EC0478        	  9539:     lea     ($0478,A4),A0
02:0003DF6C 10302000        	  9540:     move.b  (A0,D2.W),D0
02:0003DF70 1B00            	  9541:     move.b  D0,-(A5)  ; PHA
                            	  9542:     ; Bit 7 is the sprite attribute for vertical flipping, and can be
                            	  9543:     ; passed along as is.
                            	  9544:     ;
02:0003DF72 02000080        	  9545:     andi.b #$80,D0
02:0003DF76 00000001        	  9546:     ori.b #$01,D0
02:0003DF7A 4EB900031E6C    	  9547:     jsr     Anim_SetSpriteDescriptorAttributes
02:0003DF80 101D            	  9548:     move.b  (A5)+,D0  ; PLA
02:0003DF82 1B00            	  9549:     move.b  D0,-(A5)  ; PHA
                            	  9550:     ; If bit 6 is set, then enable horizontal flipping in [0F].
                            	  9551:     ;
