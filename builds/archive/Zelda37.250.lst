02:0003B376 41EC03E4        	  3515:     lea     ($03E4,A4),A0
02:0003B37A 12302000        	  3516:     move.b  (A0,D2.W),D1
02:0003B37E D101            	  3517:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0003B380 1B00            	  3518:     move.b  D0,-(A5)  ; PHA
