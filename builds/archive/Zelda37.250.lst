                            	  3902: UpdatePondFairy:
02:0003B5E0 610045AC        	  3903:     jsr     DrawFairy
                            	  3904:     ; If not in state 0, then go handle states 1 to 3.
                            	  3905:     ;
02:0003B5E4 102C00AD        	  3906:     move.b  ($00AD,A4),D0
02:0003B5E8 6702            	  3907:     beq.s  __far_z_04_0035
