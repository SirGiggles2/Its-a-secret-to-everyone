                            	  7297: _L_z07_InitObject_UninitMonsterFromEdge:
                            	  7298:     ; If the "monsters from edges" long timer expired, then
                            	  7299:     ; go bring the monster in.
                            	  7300:     ; Else revert the flag, so this monster becomes uninitialized.
                            	  7301:     ;
                            	  7302:     ; PATCH P43 (Codex): extra gate on fresh room-entry with
                            	  7303:     ; residual position so enemies keep their previous-room
                            	  7304:     ; positions instead of being re-edge-spawned (matches NES).
02:0004D0C8 102C004B        	  7305:     move.b  ($004B,A4),D0
02:0004D0CC 662E            	  7306:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Gate
                            	  7307:     ; timer == 0. Check for fresh room-entry + residual position.
02:0004D0CE 102C000F        	  7308:     move.b  ($000F,A4),D0
02:0004D0D2 0C0000FF        	  7309:     cmpi.b  #$FF,D0
02:0004D0D6 662E            	  7310:     bne     _L_z07_InitObject_InitMonsterFromEdge
02:0004D0D8 41EC0070        	  7311:     lea     ($0070,A4),A0
02:0004D0DC 10302000        	  7312:     move.b  (A0,D2.W),D0
02:0004D0E0 660A            	  7313:     bne     _L_z07_InitObject_UninitMonsterFromEdge_Seed
02:0004D0E2 41EC0084        	  7314:     lea     ($0084,A4),A0
02:0004D0E6 10302000        	  7315:     move.b  (A0,D2.W),D0
02:0004D0EA 671A            	  7316:     beq     _L_z07_InitObject_InitMonsterFromEdge
                            	  7317:     even
                            	  7318: _L_z07_InitObject_UninitMonsterFromEdge_Seed:
02:0004D0EC 7001            	  7319:     moveq   #1,D0
02:0004D0EE 1940004B        	  7320:     move.b  D0,($004B,A4)
02:0004D0F2 41EC0492        	  7321:     lea     ($0492,A4),A0
02:0004D0F6 11802000        	  7322:     move.b  D0,(A0,D2.W)
02:0004D0FA 4E75            	  7323:     rts
                            	  7324:     even
