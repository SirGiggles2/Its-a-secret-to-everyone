02:0003BF88 6718            	  5229:     beq  _L_z04_UpdateRope_CheckSpeed
02:0003BF8A 10342028        	  5230:     move.b  ($28,A4,D2.W),D0
02:0003BF8E 6612            	  5231:     bne  _L_z04_UpdateRope_CheckSpeed
02:0003BF90 10342018        	  5232:     move.b  ($18,A4,D2.W),D0
02:0003BF94 0200003F        	  5233:     andi.b #$3F,D0
02:0003BF98 19802028        	  5234:     move.b  D0,($28,A4,D2.W)
02:0003BF9C 4EB90004BBB6    	  5235:     jsr     _FaceUnblockedDir
