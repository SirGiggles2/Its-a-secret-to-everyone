02:00030798 660000B2        	  2870:     bne  _L_z01_UpdateTrap_Full_UpdateMovingStates
                            	  2871:     ; State 0. Sensing.
                            	  2872:     ;
                            	  2873:     ; If the absolute vertical distance between Link and the trap >= $E,
                            	  2874:     ; then go see if the horizontal distance is shorter.
                            	  2875:     ;
02:0003079C 102C0084        	  2876:     move.b  ($0084,A4),D0
02:000307A0 003C0011        	  2877:     ori     #$11,CCR  ; SEC: set C+X
02:000307A4 41EC0084        	  2878:     lea     ($0084,A4),A0
02:000307A8 12302000        	  2879:     move.b  (A0,D2.W),D1
02:000307AC 0A3C0010        	  2880:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000307B0 9101            	  2881:     subx.b  D1,D0   ; SBC ObjY,X
02:000307B2 0A3C0010        	  2882:     eori    #$10,CCR  ; restore X = 6502 C
02:000307B6 6100086E        	  2883:     jsr     Abs
02:000307BA 0C00000E        	  2884:     cmpi.b  #$0E,D0
02:000307BE 644C            	  2885:     bcc  _L_z01_UpdateTrap_Full_CheckHorizontal
                            	  2886:     ; Determine the horizontal direction toward Link;
                            	  2887:     ; and if Link and the trap are at the same X, then we can't move
                            	  2888:     ; along this axis. Go see about moving vertically.
                            	  2889:     ;
02:000307C0 7601            	  2890:     moveq   #1,D3
02:000307C2 102C0070        	  2891:     move.b  ($0070,A4),D0
02:000307C6 12342070        	  2892:     move.b  ($70,A4,D2.W),D1
02:000307CA B001            	  2893:     cmp.b   D1,D0
02:000307CC 673E            	  2894:     beq  _L_z01_UpdateTrap_Full_CheckHorizontal
