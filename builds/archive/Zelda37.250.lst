                            	  2929: _L_z01_UpdateTrap_Full_CheckHorizontal:
                            	  2930:     ; If the horizontal distance between Link and the trap >= $E,
                            	  2931:     ; then this trap definitely wasn't triggered.
                            	  2932:     ; Go draw and check collisions.
                            	  2933:     ;
02:0003080C 102C0070        	  2934:     move.b  ($0070,A4),D0
02:00030810 003C0011        	  2935:     ori     #$11,CCR  ; SEC: set C+X
02:00030814 12342070        	  2936:     move.b  ($70,A4,D2.W),D1
02:00030818 0A3C0010        	  2937:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003081C 9101            	  2938:     subx.b  D1,D0   ; SBC ObjX,X
02:0003081E 0A3C0010        	  2939:     eori    #$10,CCR  ; restore X = 6502 C
02:00030822 61000802        	  2940:     jsr     Abs
02:00030826 0C00000E        	  2941:     cmpi.b  #$0E,D0
02:0003082A 64DC            	  2942:     bcc  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
                            	  2943:     ; Determine the vertical direction toward Link;
                            	  2944:     ; and if Link and the trap are at the same Y, then we can't move
                            	  2945:     ; along this axis. Go draw and check object collisions.
                            	  2946:     ;
02:0003082C 7604            	  2947:     moveq   #4,D3
02:0003082E 102C0084        	  2948:     move.b  ($0084,A4),D0
02:00030832 41EC0084        	  2949:     lea     ($0084,A4),A0
02:00030836 12302000        	  2950:     move.b  (A0,D2.W),D1
02:0003083A B001            	  2951:     cmp.b   D1,D0
02:0003083C 67CA            	  2952:     beq  _L_z01_UpdateTrap_Full_DrawAndCheckCollisions
02:0003083E 6402            	  2953:     bcc  _anon_z01_27
02:00030840 7608            	  2954:     moveq   #8,D3
                            	  2955: _anon_z01_27:
                            	  2956:     ; We'll advance to state 1. Go remember the original Y coordinate,
                            	  2957:     ; set the vertical direction we determined, and other preparations.
                            	  2958:     ;
02:00030842 41EC0084        	  2959:     lea     ($0084,A4),A0
02:00030846 10302000        	  2960:     move.b  (A0,D2.W),D0
02:0003084A 668A            	  2961:     bne  _L_z01_UpdateTrap_Full_GoToState1
                            	  2962:     even
                            	  2963: _L_z01_UpdateTrap_Full_UpdateMovingStates:
                            	  2964:     ; State 1 and 2.
                            	  2965:     ;
                            	  2966:     ; Move in the direction it's facing.
                            	  2967:     ;
02:0003084C 41EC0098        	  2968:     lea     ($0098,A4),A0
02:00030850 10302000        	  2969:     move.b  (A0,D2.W),D0
02:00030854 1940000F        	  2970:     move.b  D0,($000F,A4)
02:00030858 4EB90004B954    	  2971:     jsr     MoveObject
                            	  2972:     ; Truncate the grid offset to square length ($10).
                            	  2973:     ;
02:0003085E 41EC0394        	  2974:     lea     ($0394,A4),A0
02:00030862 10302000        	  2975:     move.b  (A0,D2.W),D0
02:00030866 0200000F        	  2976:     andi.b #$0F,D0
02:0003086A 6608            	  2977:     bne  _anon_z01_28
02:0003086C 41EC0394        	  2978:     lea     ($0394,A4),A0
02:00030870 11802000        	  2979:     move.b  D0,(A0,D2.W)
                            	  2980: _anon_z01_28:
                            	  2981:     ; The trap cannot be harmed. So, only check for collision with Link.
                            	  2982:     ;
02:00030874 610017CA        	  2983:     jsr     CheckLinkCollision
                            	  2984:     ; If moving horizontally, then set target coordinate in [00] to $78
                            	  2985:     ; and current coordinate to the trap's X.
                            	  2986:     ;
02:00030878 7600            	  2987:     moveq   #0,D3
02:0003087A 16342070        	  2988:     move.b  ($70,A4,D2.W),D3
02:0003087E 7078            	  2989:     moveq   #120,D0
02:00030880 1880            	  2990:     move.b  D0,($0000,A4)
02:00030882 41EC0098        	  2991:     lea     ($0098,A4),A0
02:00030886 10302000        	  2992:     move.b  (A0,D2.W),D0
02:0003088A 0200000C        	  2993:     andi.b #$0C,D0
02:0003088E 6710            	  2994:     beq  _L_z01_UpdateTrap_Full_Finish
                            	  2995:     ; Else moving vertically. Set target coordinate in [00] to $90
                            	  2996:     ; and current coordinate to the trap's Y.
                            	  2997:     ;
02:00030890 7600            	  2998:     moveq   #0,D3
02:00030892 41EC0084        	  2999:     lea     ($0084,A4),A0
02:00030896 16302000        	  3000:     move.b  (A0,D2.W),D3
02:0003089A 103C0090        	  3001:     move.b  #$90,D0
02:0003089E 1880            	  3002:     move.b  D0,($0000,A4)
                            	  3003:     even
                            	  3004: _L_z01_UpdateTrap_Full_Finish:
                            	  3005:     ; If in state 2, then go finish handling it.
                            	  3006:     ;
02:000308A0 41EC00AC        	  3007:     lea     ($00AC,A4),A0
02:000308A4 10302000        	  3008:     move.b  (A0,D2.W),D0
02:000308A8 02000001        	  3009:     andi.b #$01,D0
02:000308AC 6744            	  3010:     beq  _L_z01_UpdateTrap_Full_FinishState2
                            	  3011:     ; Finish handling state 1.
                            	  3012:     ;
                            	  3013:     ; Get the distance between the current coordinate and the target.
                            	  3014:     ;
02:000308AE 1003            	  3015:     move.b  D3,D0
02:000308B0 003C0011        	  3016:     ori     #$11,CCR  ; SEC: set C+X
02:000308B4 1214            	  3017:     move.b  ($0000,A4),D1
02:000308B6 0A3C0010        	  3018:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000308BA 9101            	  3019:     subx.b  D1,D0   ; SBC $00
02:000308BC 0A3C0010        	  3020:     eori    #$10,CCR  ; restore X = 6502 C
02:000308C0 61000764        	  3021:     jsr     Abs
                            	  3022:     ; If distance >= 5, go draw.
                            	  3023:     ;
02:000308C4 0C000005        	  3024:     cmpi.b  #$05,D0
02:000308C8 6426            	  3025:     bcc  _L_z01_UpdateTrap_Full_Draw
                            	  3026:     ; Else reverse direction, and advace to state 2
                            	  3027:     ; with q-speed $20 (0.5 pixels a frame) (slow).
                            	  3028:     ;
02:000308CA 41EC0098        	  3029:     lea     ($0098,A4),A0
02:000308CE 10302000        	  3030:     move.b  (A0,D2.W),D0
02:000308D2 6100074E        	  3031:     jsr     GetOppositeDir
02:000308D6 41EC0098        	  3032:     lea     ($0098,A4),A0
02:000308DA 11802000        	  3033:     move.b  D0,(A0,D2.W)
02:000308DE 7020            	  3034:     moveq   #32,D0
02:000308E0 41EC03BC        	  3035:     lea     ($03BC,A4),A0
02:000308E4 11802000        	  3036:     move.b  D0,(A0,D2.W)
02:000308E8 41EC00AC        	  3037:     lea     ($00AC,A4),A0
02:000308EC 52302000        	  3038:     addq.b  #1,(A0,D2.W)
                            	  3039:     even
