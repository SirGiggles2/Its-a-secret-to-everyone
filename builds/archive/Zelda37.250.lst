                            	  5485: 
                            	  5486: ; Params:
                            	  5487: ; [02]: Y
                            	  5488: ; [03]: X
                            	  5489: ;
                            	  5490: ; Returns:
                            	  5491: ; [00]: high byte of PPU address
                            	  5492: ; [01]: low byte of PPU address
                            	  5493: ;
                            	  5494: ;
                            	  5495: ; Turn the 16-bit value 08YY into the PPU address
                            	  5496: ; ($2000 + (YY * 4)) by multiplying it by 4.
                            	  5497: ;
                            	  5498: ; Each row of tiles is 32 tiles (and bytes) long, and 8 pixels tall.
                            	  5499: ; This is why the Y coordinate is multiplied by 4 (= 32 / 8).
                            	  5500: ;
                            	  5501:     even
