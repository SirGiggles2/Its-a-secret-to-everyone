02:0003E004 52302000        	  9622:     addq.b  #1,(A0,D2.W)
                            	  9623:     ; Set a direction mask in [02], starting with right (1).
                            	  9624:     ;
02:0003E008 7001            	  9625:     moveq   #1,D0
02:0003E00A 19400002        	  9626:     move.b  D0,($0002,A4)
                            	  9627:     ; If Gohma's facing direction has a right component, then add 1 to X.
                            	  9628:     ;
02:0003E00E 41EC0098        	  9629:     lea     ($0098,A4),A0
02:0003E012 10302000        	  9630:     move.b  (A0,D2.W),D0
02:0003E016 122C0002        	  9631:     move.b  ($0002,A4),D1
