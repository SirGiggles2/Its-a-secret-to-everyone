02:0004C0FE 52302000        	  5196:     addq.b  #1,(A0,D2.W)
02:0004C102 41EC00AC        	  5197:     lea     ($00AC,A4),A0
02:0004C106 10302000        	  5198:     move.b  (A0,D2.W),D0
02:0004C10A 0200000F        	  5199:     andi.b #$0F,D0
02:0004C10E 0C000003        	  5200:     cmpi.b  #$03,D0
