02:0002E9E4 102C0084        	   942:     move.b  ($0084,A4),D0
02:0002E9E8 003C0011        	   943:     ori     #$11,CCR  ; SEC: set C+X
02:0002E9EC 123C0098        	   944:     move.b  #$98,D1
02:0002E9F0 0A3C0010        	   945:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002E9F4 9101            	   946:     subx.b  D1,D0   ; SBC #$98
02:0002E9F6 0A3C0010        	   947:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E9FA 6100262A        	   948:     jsr     Abs
02:0002E9FE 0C000006        	   949:     cmpi.b  #$06,D0
02:0002EA02 6506            	   950:     bcs  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_PickedUp
                            	   951:     even
