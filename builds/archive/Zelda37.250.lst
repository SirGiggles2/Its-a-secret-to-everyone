                            	  5001: SpreadShot:
                            	  5002:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5003:     ;
                            	  5004:     ; The shot is spreading out.
                            	  5005:     ;
                            	  5006:     ; Copy base negative offset in [98][X] to [02] and [03].
                            	  5007:     ; These will be negated appropriately for each corner.
                            	  5008:     ;
02:0004BFC0 41EC0098        	  5009:     lea     ($0098,A4),A0
02:0004BFC4 10302000        	  5010:     move.b  (A0,D2.W),D0
02:0004BFC8 19400002        	  5011:     move.b  D0,($0002,A4)
02:0004BFCC 19400003        	  5012:     move.b  D0,($0003,A4)
                            	  5013:     ; Reset [0F] to not flip horizontally.
                            	  5014:     ;
02:0004BFD0 7000            	  5015:     moveq   #0,D0
02:0004BFD2 1940000F        	  5016:     move.b  D0,($000F,A4)
                            	  5017:     ; Loop 4 times to draw each corner of the spreading sword shot.
                            	  5018:     ; The corners are: top-left, bottom-left, bottom-right, top-right
                            	  5019:     ;
02:0004BFD6 7603            	  5020:     moveq   #3,D3
                            	  5021:     even
                            	  5022: _L_z07_SpreadShot_DrawShotCorner:
02:0004BFD8 1003            	  5023:     move.b  D3,D0
02:0004BFDA 1B00            	  5024:     move.b  D0,-(A5)  ; PHA
                            	  5025:     ; Save offset X [02] and Y offset [03].
                            	  5026:     ;
02:0004BFDC 102C0002        	  5027:     move.b  ($0002,A4),D0
02:0004BFE0 1B00            	  5028:     move.b  D0,-(A5)  ; PHA
02:0004BFE2 102C0003        	  5029:     move.b  ($0003,A4),D0
02:0004BFE6 1B00            	  5030:     move.b  D0,-(A5)  ; PHA
                            	  5031:     ; Calculate and set sprite attributes for this corner:
                            	  5032:     ;   base attribute OR (frame counter AND 3)
                            	  5033:     ;
                            	  5034:     ; The base attribute defines how to flip the sprite.
                            	  5035:     ; The frame counter makes the shot flash by cycling each
                            	  5036:     ; palette row.
                            	  5037:     ;
02:0004BFE8 102C0015        	  5038:     move.b  ($0015,A4),D0
02:0004BFEC 02000003        	  5039:     andi.b #$03,D0
02:0004BFF0 41F90004BE4E    	  5040:     lea     (SwordShotSpreadBaseAttr).l,A0
02:0004BFF6 12303000        	  5041:     move.b  (A0,D3.W),D1
02:0004BFFA 8001            	  5042:     or.b  D1,D0
02:0004BFFC 4EB900031E6C    	  5043:     jsr     Anim_SetSpriteDescriptorAttributes
                            	  5044:     ; Add the object's X (the center of the spread) and the
                            	  5045:     ; current offset in [02] to set sprite X in [00].
                            	  5046:     ;
02:0004C002 10342070        	  5047:     move.b  ($70,A4,D2.W),D0
02:0004C006 023C00EE        	  5048:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C00A 122C0002        	  5049:     move.b  ($0002,A4),D1
02:0004C00E D101            	  5050:     addx.b  D1,D0   ; ADC $02
02:0004C010 1880            	  5051:     move.b  D0,($0000,A4)
                            	  5052:     ; If sprite X >= object X and sprite X >= $FC, skip this corner.
                            	  5053:     ; Else calculate the distance from object X to sprite X.
                            	  5054:     ;
02:0004C012 12342070        	  5055:     move.b  ($70,A4,D2.W),D1
02:0004C016 B001            	  5056:     cmp.b   D1,D0
02:0004C018 651A            	  5057:     bcs  _L_z07_SpreadShot_ReverseSub
02:0004C01A 0C0000FC        	  5058:     cmpi.b  #$FC,D0
02:0004C01E 6466            	  5059:     bcc  _L_z07_SpreadShot_NextCorner
02:0004C020 003C0011        	  5060:     ori     #$11,CCR  ; SEC: set C+X
02:0004C024 12342070        	  5061:     move.b  ($70,A4,D2.W),D1
02:0004C028 0A3C0010        	  5062:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C02C 9101            	  5063:     subx.b  D1,D0   ; SBC ObjX,X
02:0004C02E 0A3C0010        	  5064:     eori    #$10,CCR  ; restore X = 6502 C
02:0004C032 6014            	  5065:     jmp     _L_z07_SpreadShot_CheckDistance
                            	  5066: 
                            	  5067:     even
                            	  5068: _L_z07_SpreadShot_ReverseSub:
02:0004C034 10342070        	  5069:     move.b  ($70,A4,D2.W),D0
02:0004C038 003C0011        	  5070:     ori     #$11,CCR  ; SEC: set C+X
02:0004C03C 1214            	  5071:     move.b  ($0000,A4),D1
02:0004C03E 0A3C0010        	  5072:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0004C042 9101            	  5073:     subx.b  D1,D0   ; SBC $00
02:0004C044 0A3C0010        	  5074:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5075:     even
                            	  5076: _L_z07_SpreadShot_CheckDistance:
                            	  5077:     ; If distance >= $20, skip this corner.
                            	  5078:     ;
02:0004C048 0C000020        	  5079:     cmpi.b  #$20,D0
02:0004C04C 6438            	  5080:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5081:     ; Add the object's Y (the center of the spread) and the
                            	  5082:     ; current offset in [03] to set sprite Y in [01].
                            	  5083:     ;
02:0004C04E 41EC0084        	  5084:     lea     ($0084,A4),A0
02:0004C052 10302000        	  5085:     move.b  (A0,D2.W),D0
02:0004C056 023C00EE        	  5086:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C05A 122C0003        	  5087:     move.b  ($0003,A4),D1
02:0004C05E D101            	  5088:     addx.b  D1,D0   ; ADC $03
02:0004C060 19400001        	  5089:     move.b  D0,($0001,A4)
                            	  5090:     ; If in UW, and (sprite Y < $3E or >= $E8), then skip this corner.
                            	  5091:     ;
02:0004C064 7600            	  5092:     moveq   #0,D3
02:0004C066 162C0010        	  5093:     move.b  ($0010,A4),D3
02:0004C06A 670C            	  5094:     beq  _L_z07_SpreadShot_Draw
02:0004C06C 0C00003E        	  5095:     cmpi.b  #$3E,D0
02:0004C070 6514            	  5096:     bcs  _L_z07_SpreadShot_NextCorner
02:0004C072 0C0000E8        	  5097:     cmpi.b  #$E8,D0
02:0004C076 640E            	  5098:     bcc  _L_z07_SpreadShot_NextCorner
                            	  5099:     even
                            	  5100: _L_z07_SpreadShot_Draw:
                            	  5101:     ; Draw the corner.
                            	  5102:     ; Pass [0C] = frame 2 (spread shot), Y = $23 (sword 2).
                            	  5103:     ;
02:0004C078 7002            	  5104:     moveq   #2,D0
02:0004C07A 1940000C        	  5105:     move.b  D0,($000C,A4)
02:0004C07E 7623            	  5106:     moveq   #35,D3
02:0004C080 4EB900031D8C    	  5107:     jsr     Anim_WriteItemSprites
                            	  5108:     even
                            	  5109: _L_z07_SpreadShot_NextCorner:
                            	  5110:     ; Prepare to process the next corner.
                            	  5111:     ;
                            	  5112:     ; First, restore X offset [02] and Y offset [03].
                            	  5113:     ;
02:0004C086 101D            	  5114:     move.b  (A5)+,D0  ; PLA
02:0004C088 19400003        	  5115:     move.b  D0,($0003,A4)
02:0004C08C 101D            	  5116:     move.b  (A5)+,D0  ; PLA
02:0004C08E 19400002        	  5117:     move.b  D0,($0002,A4)
                            	  5118:     ; Take turns negating X offset or Y offset for the next round.
                            	  5119:     ; - First turn:  loop index = 3, negate Y offset [03]
                            	  5120:     ; - Second turn: loop index = 2, negate X offset [02]
                            	  5121:     ; - Third turn:  loop index = 1, negate Y offset [03]
                            	  5122:     ; - Fourth turn: doesn't matter
                            	  5123:     ;
                            	  5124:     ;
                            	  5125:     ; Get the loop index.
02:0004C092 101D            	  5126:     move.b  (A5)+,D0  ; PLA
02:0004C094 1B00            	  5127:     move.b  D0,-(A5)  ; PHA
02:0004C096 7600            	  5128:     moveq   #0,D3
02:0004C098 1600            	  5129:     move.b  D0,D3
02:0004C09A 0C030001        	  5130:     cmpi.b  #$01,D3
02:0004C09E 6602            	  5131:     bne  _anon_z07_25
02:0004C0A0 7603            	  5132:     moveq   #3,D3
                            	  5133: _anon_z07_25:
02:0004C0A2 10343000        	  5134:     move.b  ($00,A4,D3.W),D0
02:0004C0A6 4600            	  5135:     eori.b #$FF,D0
02:0004C0A8 023C00EE        	  5136:     andi    #$EE,CCR  ; CLC: clear C+X
02:0004C0AC 123C0001        	  5137:     move.b  #$01,D1
02:0004C0B0 D101            	  5138:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
02:0004C0B2 19803000        	  5139:     move.b  D0,($00,A4,D3.W)
                            	  5140:     ; Restore the loop index, decrement it, and loop again if >= 0.
                            	  5141:     ;
02:0004C0B6 101D            	  5142:     move.b  (A5)+,D0  ; PLA
02:0004C0B8 7600            	  5143:     moveq   #0,D3
02:0004C0BA 1600            	  5144:     move.b  D0,D3
02:0004C0BC 5303            	  5145:     subq.b  #1,D3
02:0004C0BE 6A00FF18        	  5146:     bpl  _L_z07_SpreadShot_DrawShotCorner
                            	  5147:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5148:     ;
                            	  5149:     ; Decrease the base negative offset to get farther away from
                            	  5150:     ; the center point.
                            	  5151:     ;
02:0004C0C2 41EC0098        	  5152:     lea     ($0098,A4),A0
02:0004C0C6 53302000        	  5153:     subq.b  #1,(A0,D2.W)
                            	  5154:     ; MULTI: ObjDir -> ObjSwordShotNegativeOffset
                            	  5155:     ;
                            	  5156:     ; Once the base negative offset reaches $E8, go deactivate the object.
                            	  5157:     ;
02:0004C0CA 41EC0098        	  5158:     lea     ($0098,A4),A0
02:0004C0CE 10302000        	  5159:     move.b  (A0,D2.W),D0
02:0004C0D2 0C0000E8        	  5160:     cmpi.b  #$E8,D0
02:0004C0D6 6702            	  5161:     beq.s  __far_z_07_0077
02:0004C0D8 6004            	  5162:     jmp  L1F49F_Exit
