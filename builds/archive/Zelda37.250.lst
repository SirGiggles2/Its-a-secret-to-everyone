02:0003F27E 41EC034F        	 12093:     lea     ($034F,A4),A0
02:0003F282 16302000        	 12094:     move.b  (A0,D2.W),D3
02:0003F286 0C030025        	 12095:     cmpi.b  #$25,D3
02:0003F28A 6702            	 12096:     beq  _anon_z04_159
