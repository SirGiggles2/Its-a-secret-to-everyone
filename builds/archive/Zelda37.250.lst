                            	  4195: CheckTiles:
                            	  4196:     ifne TURBO_LINK
                            	  4197:     ; PATCH P40b: Link no-clip — always treat target tile as
                            	  4198:     ; walkable. Pre-seeds ObjCollidedTile[0] ($049E) to $24.
02:0004BA6A 4A02            	  4199:     tst.b   D2
02:0004BA6C 6608            	  4200:     bne.s   _L_z07_CheckTiles_notLink
02:0004BA6E 197C0024049E    	  4201:     move.b  #$24,($049E,A4)
02:0004BA74 605E            	  4202:     jmp     GoWalkableDir
                            	  4203: _L_z07_CheckTiles_notLink:
                            	  4204:     endc
                            	  4205:     ; The code below applies to Link and other objects.
                            	  4206:     ;
                            	  4207:     ; Test the moving direction's walkability.
                            	  4208:     ;
                            	  4209:     ; For the player, this is enough. For other objects, this 
                            	  4210:     ; becomes a loop looking for an unblocked direction to move in.
                            	  4211:     ;
                            	  4212:     ; If the colliding tile is walkable, go handle a walkable direction.
                            	  4213:     ;
02:0004BA76 6100FB88        	  4214:     jsr     GetCollidingTileMoving
02:0004BA7A 122C034A        	  4215:     move.b  ($034A,A4),D1
02:0004BA7E B001            	  4216:     cmp.b   D1,D0
02:0004BA80 6402            	  4217:     bcc.s  __far_z_07_0052
02:0004BA82 6050            	  4218:     jmp  GoWalkableDir
                            	  4219: __far_z_07_0052:
                            	  4220:     ; The colliding tile is unwalkable.
                            	  4221:     ;
                            	  4222:     ; If object is the player, then go check passive tile objects and
                            	  4223:     ; the screen edge, or stop moving.
                            	  4224:     ;
02:0004BA84 4A02            	  4225:     cmpi.b  #$00,D2
02:0004BA86 6602            	  4226:     bne.s  __far_z_07_0053
02:0004BA88 6022            	  4227:     jmp  PlayerUnwalkable
                            	  4228: __far_z_07_0053:
                            	  4229:     even
                            	  4230: CheckObjAttr10AndAltDir:
                            	  4231:     ; Not the player.
                            	  4232:     ; If object attribute has $10, go to the unused code above
                            	  4233:     ; to reverse direction.
                            	  4234:     ;
02:0004BA8A 41EC04BF        	  4235:     lea     ($04BF,A4),A0
02:0004BA8E 10302000        	  4236:     move.b  (A0,D2.W),D0
02:0004BA92 02000010        	  4237:     andi.b #$10,D0
02:0004BA96 6702            	  4238:     beq.s  __far_z_07_0054
02:0004BA98 60C8            	  4239:     jmp  Reverse
                            	  4240: __far_z_07_0054:
                            	  4241:     even
