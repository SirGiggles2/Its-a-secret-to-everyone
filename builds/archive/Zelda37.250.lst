                            	  4881: ; Each byte describes an item. The high nibble is the type.
                            	  4882: ; The low nibble is the value. Its meaning depends on the type.
                            	  4883: ;
                            	  4884: ; 0x - individuals
                            	  4885: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  4886: ; * bit mask: value doesn't matter.
                            	  4887: ;
                            	  4888: ; 1x - amounts
                            	  4889: ; Value is an amount to add.
                            	  4890: ;
                            	  4891: ; 2x - grades
                            	  4892: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  4893: ;
                            	  4894: ; 3x - error?
                            	  4895: ; Produces an item value of $FF.
                            	  4896: ;
                            	  4897:     even
