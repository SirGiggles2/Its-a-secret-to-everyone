02:00032180 41F900031FE2    	  6454:     lea     (ObjTypeToDamagePoints).l,A0
02:00032186 10303000        	  6455:     move.b  (A0,D3.W),D0
02:0003218A 1B00            	  6456:     move.b  D0,-(A5)  ; PHA
02:0003218C 0200000F        	  6457:     andi.b #$0F,D0
02:00032190 1940000D        	  6458:     move.b  D0,($000D,A4)
02:00032194 101D            	  6459:     move.b  (A5)+,D0  ; PLA
02:00032196 020000F0        	  6460:     andi.b #$F0,D0
02:0003219A 1940000E        	  6461:     move.b  D0,($000E,A4)
                            	  6462: ; Params:
                            	  6463: ; X: object index of the attacker
