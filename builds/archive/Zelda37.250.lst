02:0003BF16 0C0000E9        	  5178:     cmpi.b  #$E9,D0
02:0003BF1A 6406            	  5179:     bcc  _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_AddPriorityBit
02:0003BF1C 0C000018        	  5180:     cmpi.b  #$18,D0
02:0003BF20 6414            	  5181:     bcc  _anon_z04_73
                            	  5182:     even
                            	  5183: _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_AddPriorityBit:
02:0003BF22 41EC0202        	  5184:     lea     ($0202,A4),A0
02:0003BF26 10303000        	  5185:     move.b  (A0,D3.W),D0
02:0003BF2A 00000020        	  5186:     ori.b #$20,D0
02:0003BF2E 41EC0202        	  5187:     lea     ($0202,A4),A0
02:0003BF32 11803000        	  5188:     move.b  D0,(A0,D3.W)
                            	  5189: _anon_z04_73:
02:0003BF36 5302            	  5190:     subq.b  #1,D2
02:0003BF38 6AC4            	  5191:     bpl  _L_z04_Wallmaster_PutSpriteBehindBgIfNeeded_LoopExtent
02:0003BF3A 4E75            	  5192:     rts
