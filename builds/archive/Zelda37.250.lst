                            	  2659: _L_z04_UpdateTektiteOrBoulder_State1:
                            	  2660:     ; State 1. Jumping.
                            	  2661:     ;
                            	  2662:     ; Keep the object inside the bounds of the room.
                            	  2663:     ;
02:0003AD02 61004FB6        	  2664:     jsr     BoundFlyer
                            	  2665:     ; If the object was blocked at the room boundary, then
                            	  2666:     ; increase boundary reversal count, and go set up another jump.
                            	  2667:     ;
02:0003AD06 102C000F        	  2668:     move.b  ($000F,A4),D0
02:0003AD0A 660C            	  2669:     bne  _anon_z04_37
02:0003AD0C 41EC0451        	  2670:     lea     ($0451,A4),A0
02:0003AD10 52302000        	  2671:     addq.b  #1,(A0,D2.W)
02:0003AD14 6000FF74        	  2672:     jmp     _L_z04_UpdateTektiteOrBoulder_SetUpJump
                            	  2673: 
                            	  2674: _anon_z04_37:
02:0003AD18 61000196        	  2675:     jsr     Jumper_PointBoulderDownward
                            	  2676:     ; This step in the jump succeeded. So, reset the reversal count.
                            	  2677:     ;
02:0003AD1C 7000            	  2678:     moveq   #0,D0
02:0003AD1E 41EC0451        	  2679:     lea     ($0451,A4),A0
02:0003AD22 11802000        	  2680:     move.b  D0,(A0,D2.W)
                            	  2681:     ; Get the base offset for the kind of jumper the object is.
                            	  2682:     ;
02:0003AD26 6100015E        	  2683:     jsr     Jumper_GetKind
02:0003AD2A 41F90003AC16    	  2684:     lea     (JumperYAccelerationBaseOffsets).l,A0
02:0003AD30 10303000        	  2685:     move.b  (A0,D3.W),D0
                            	  2686:     ; Get the acceleration by indexing with (base offset + direction).
                            	  2687:     ;
                            	  2688:     ; Note that the set of accelerations of Boulder (the third set)
                            	  2689:     ; does not have $B elements like the tektites' sets.
                            	  2690:     ;
                            	  2691:     ; Boulder does not need the upward accelerations.
                            	  2692:     ; So, the elements for those are used for the starting speeds
                            	  2693:     ; at 04:88F2.
                            	  2694:     ;
02:0003AD34 023C00EE        	  2695:     andi    #$EE,CCR  ; CLC: clear C+X
02:0003AD38 41EC0098        	  2696:     lea     ($0098,A4),A0
02:0003AD3C 12302000        	  2697:     move.b  (A0,D2.W),D1
