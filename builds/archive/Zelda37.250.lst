02:0004ABA4 122C0004        	  2119:     move.b  ($0004,A4),D1
02:0004ABA8 D101            	  2120:     addx.b  D1,D0   ; ADC $04
02:0004ABAA 4A02            	  2121:     cmpi.b  #$00,D2
02:0004ABAC 66E4            	  2122:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004ABAE 0C000002        	  2123:     cmpi.b  #$02,D0
02:0004ABB2 66DE            	  2124:     bne  _L_z07_DrawItemBySlot_WriteSprites
02:0004ABB4 7620            	  2125:     moveq   #32,D3
