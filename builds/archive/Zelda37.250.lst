02:0002E99A 0C000071        	   892:     cmpi.b  #$71,D0
02:0002E99E 6616            	   893:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_Exit
                            	   894:     ; Post 20 rupees to subtract.
                            	   895:     ;
02:0002E9A0 102C067E        	   896:     move.b  ($067E,A4),D0
02:0002E9A4 023C00EE        	   897:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E9A8 123C0014        	   898:     move.b  #$14,D1
02:0002E9AC D101            	   899:     addx.b  D1,D0   ; ADC #$14 (X flag = 6502 C)
02:0002E9AE 1940067E        	   900:     move.b  D0,($067E,A4)
                            	   901:     ; Mark this secret taken.
                            	   902:     ;
02:0002E9B2 61002B68        	   903:     jsr     SetRoomFlagUWItemState
                            	   904:     even
