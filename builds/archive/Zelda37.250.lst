02:00030738 19400001        	  2818:     move.b  D0,($0001,A4)
                            	  2819:     ; Assume we're initializing trap object type $49 that makes 6 traps.
                            	  2820:     ;
02:0003073C 7605            	  2821:     moveq   #5,D3
                            	  2822:     ; The individual trap objects to make will be of type $49.
                            	  2823:     ; Store it in [00].
                            	  2824:     ;
