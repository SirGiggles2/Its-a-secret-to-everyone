                            	  5349: LayOutDoors:
                            	  5350:     ; Copies the right door face for the direction, type, and state
                            	  5351:     ; of the door to the play area tile map.
                            	  5352:     ;
                            	  5353:     ; Also, clears door bits from CurOpenedDoors of doorways
                            	  5354:     ; that are not true doors.
                            	  5355:     ;
02:00043596 7403            	  5356:     moveq   #3,D2
                            	  5357:     even
                            	  5358: L_LayOutDoors_LoopDoors:
                            	  5359:     ; For each door, indexed by X, from 3 (N) to 0:
                            	  5360:     ;
02:00043598 7001            	  5361:     moveq   #1,D0
                            	  5362:     ; For each half of a door, indexed by [06], from 1 to 0:
                            	  5363:     ;
                            	  5364:     ; [06] indicates whether we're handling the first half of
                            	  5365:     ; the door: Left half for N/S, Top half for E/W.
                            	  5366:     ;
02:0004359A 19400006        	  5367:     move.b  D0,($0006,A4)
                            	  5368:     even
                            	  5369: L_LayOutDoors_LoopHalves:
02:0004359E 1002            	  5370:     move.b  D2,D0
02:000435A0 1B00            	  5371:     move.b  D0,-(A5)  ; PHA
02:000435A2 1940000B        	  5372:     move.b  D0,($000B,A4)
02:000435A6 41F900043572    	  5373:     lea     (DoorBits).l,A0
02:000435AC 10302000        	  5374:     move.b  (A0,D2.W),D0
02:000435B0 19400002        	  5375:     move.b  D0,($0002,A4)
02:000435B4 6100FD4A        	  5376:     jsr     FindDoorAttrByDoorBit
                            	  5377:     ; Begin looking for the door face for the door attribute.
                            	  5378:     ; In general, use the door type as the provisional face;
                            	  5379:     ; except turn 4 into 8.
                            	  5380:     ;
02:000435B8 0C000005        	  5381:     cmpi.b  #$05,D0
02:000435BC 642A            	  5382:     bcc  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
02:000435BE 0C000004        	  5383:     cmpi.b  #$04,D0
02:000435C2 6608            	  5384:     bne  _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask
02:000435C4 7008            	  5385:     moveq   #8,D0
02:000435C6 6620            	  5386:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneClosedPF
                            	  5387:     even
                            	  5388: _L_z05_L_LayOutDoors_LoopHalves_SetPF9:
                            	  5389:     ; We jump here if the door type is bombable and was opened.
                            	  5390:     ; Change the provisional door face to value 9, which
                            	  5391:     ; will become the "hole in the wall".
                            	  5392:     ;
02:000435C8 7009            	  5393:     moveq   #9,D0
02:000435CA 665A            	  5394:     bne  _L_z05_L_LayOutDoors_LoopHalves_DoneOpenPF
                            	  5395:     even
                            	  5396: _L_z05_L_LayOutDoors_LoopHalves_ClearFromOpenedMask:
                            	  5397:     ; Door attribute < 4 (open or any wall), clear door bit from
                            	  5398:     ; the mask of opened doors, because this is not a true door.
                            	  5399:     ;
02:000435CC 1B00            	  5400:     move.b  D0,-(A5)  ; PHA
02:000435CE 102C0002        	  5401:     move.b  ($0002,A4),D0
02:000435D2 4600            	  5402:     eori.b #$FF,D0
02:000435D4 122C00EE        	  5403:     move.b  ($00EE,A4),D1
02:000435D8 C001            	  5404:     and.b  D1,D0
02:000435DA 194000EE        	  5405:     move.b  D0,($00EE,A4)
02:000435DE 101D            	  5406:     move.b  (A5)+,D0  ; PLA
                            	  5407:     ; Furthermore, if door type = 0, then use 4 as the provisional face.
                            	  5408:     ;
02:000435E0 0C000001        	  5409:     cmpi.b  #$01,D0
