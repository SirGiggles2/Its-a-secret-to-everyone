02:0002EA22 41EC0430        	   979:     lea     ($0430,A4),A0
02:0002EA26 12302000        	   980:     move.b  (A0,D2.W),D1
02:0002EA2A B001            	   981:     cmp.b   D1,D0
02:0002EA2C 6404            	   982:     bcc.s  __far_z_01_0004
02:0002EA2E 6000EDA2        	   983:     jmp  Exit
