                            	  7744:     ; Calculate PPU address ($28E0 + Y*$20).
                            	  7745:     ;
02:00044B94 7028            	  7746:     moveq   #40,D0
02:00044B96 19400302        	  7747:     move.b  D0,($0302,A4)
02:00044B9A 103C00C0        	  7748:     move.b  #$C0,D0
