02:0003B458 10302000        	  3660:     move.b  (A0,D2.W),D0
02:0003B45C 0C000022        	  3661:     cmpi.b  #$22,D0
02:0003B460 670000A6        	  3662:     beq  _L_z04_InitArmosOrFlyingGhini_FinishInit
                            	  3663:     ; Else we have an armos.
                            	  3664:     ;
                            	  3665:     ; Store stairs tile $70 in [00] for use later.
                            	  3666:     ;
02:0003B464 7070            	  3667:     moveq   #112,D0
02:0003B466 1880            	  3668:     move.b  D0,($0000,A4)
                            	  3669:     ; Look for the current room ID in an array of room ID's that
                            	  3670:     ; have armos secrets.
                            	  3671:     ;
02:0003B468 7606            	  3672:     moveq   #6,D3
                            	  3673:     even
                            	  3674: _L_z04_InitArmosOrFlyingGhini_LoopArmosRoom:
02:0003B46A 102C00EB        	  3675:     move.b  ($00EB,A4),D0
