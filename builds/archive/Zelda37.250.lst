                            	  7478: _L_z01_BeginShove_MonsterDefender:
                            	  7479:     ; A monster is the defender. A weapon is the attacker.
                            	  7480:     ;
                            	  7481:     ; Set the shove direction to the weapon's direction,
                            	  7482:     ; instead of the direction passed in [0B].
