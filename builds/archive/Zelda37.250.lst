02:0003BE56 6100E282        	  5070:     jsr     DrawObjectNotMirroredOverLink
                            	  5071:     ; Store the offsets of the sprites to show over Link
                            	  5072:     ; ($10 and $11) in [00] and [01] for use in patching the right sprite.
                            	  5073:     ;
02:0003BE5A 7040            	  5074:     moveq   #64,D0
