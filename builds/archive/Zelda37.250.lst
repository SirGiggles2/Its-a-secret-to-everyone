02:0002E9D6 41F90002E750    	   935:     lea     (CaveWareXs).l,A0
02:0002E9DC 12302000        	   936:     move.b  (A0,D2.W),D1
02:0002E9E0 B001            	   937:     cmp.b   D1,D0
02:0002E9E2 6620            	   938:     bne  _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_NextWare
                            	   939:     ; If the vertical distance between Link and the item < 6, then
                            	   940:     ; go try to take it.
