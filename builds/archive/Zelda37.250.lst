02:0003CD1C 123C0008        	  7047:     move.b  #$08,D1
02:0003CD20 D101            	  7048:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
                            	  7049: _anon_z04_91:
02:0003CD22 1880            	  7050:     move.b  D0,($0000,A4)
                            	  7051:     ; Store (Y + 8) in [01].
                            	  7052:     ;
02:0003CD24 41EC0084        	  7053:     lea     ($0084,A4),A0
02:0003CD28 10302000        	  7054:     move.b  (A0,D2.W),D0
02:0003CD2C 123C0008        	  7055:     move.b  #$08,D1
02:0003CD30 D101            	  7056:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0003CD32 19400001        	  7057:     move.b  D0,($0001,A4)
                            	  7058:     ; Only check the first bomb slot ($10).
                            	  7059:     ;
                            	  7060:     ; Store the bomb's (X + 8) in [02].
