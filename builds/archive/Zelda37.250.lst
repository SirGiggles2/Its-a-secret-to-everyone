02:0003F2B0 1B00            	 12115:     move.b  D0,-(A5)  ; PHA
02:0003F2B2 41F90003F19C    	 12116:     lea     (PatraChild1RotationSineBits).l,A0
02:0003F2B8 10303000        	 12117:     move.b  (A0,D3.W),D0
02:0003F2BC 7600            	 12118:     moveq   #0,D3
02:0003F2BE 1600            	 12119:     move.b  D0,D3
02:0003F2C0 101D            	 12120:     move.b  (A5)+,D0  ; PLA
02:0003F2C2 600E            	 12121:     jmp     _L_z04_PatraChild_State1_Rotate
                            	 12122: 
                            	 12123:     even
                            	 12124: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	 12125:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	 12126:     ; for both Y and X increment calculations in rotation. This leads to
                            	 12127:     ; a small circle (5) and a large circle (6).
                            	 12128:     ;
02:0003F2C4 41F90003F19A    	 12129:     lea     (PatraChild2RotationBits).l,A0
02:0003F2CA 10303000        	 12130:     move.b  (A0,D3.W),D0
02:0003F2CE 7600            	 12131:     moveq   #0,D3
02:0003F2D0 1600            	 12132:     move.b  D0,D3
