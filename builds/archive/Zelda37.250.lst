02:0003DF00 10302000        	  9497:     move.b  (A0,D2.W),D0
02:0003DF04 122C0002        	  9498:     move.b  ($0002,A4),D1
02:0003DF08 E309            	  9499:     lsl.b  #1,D1   ; ASL $02
02:0003DF0A 19410002        	  9500:     move.b  D1,($0002,A4)
02:0003DF0E 122C0002        	  9501:     move.b  ($0002,A4),D1
02:0003DF12 C200            	  9502:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0003DF14 671E            	  9503:     beq  _L_z04_Manhandla_Move_IncFrameAccum
02:0003DF16 41EC0084        	  9504:     lea     ($0084,A4),A0
02:0003DF1A 10302000        	  9505:     move.b  (A0,D2.W),D0
02:0003DF1E 122C0003        	  9506:     move.b  ($0003,A4),D1
02:0003DF22 0A3C0010        	  9507:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003DF26 9101            	  9508:     subx.b  D1,D0   ; SBC $03
02:0003DF28 0A3C0010        	  9509:     eori    #$10,CCR  ; restore X = 6502 C
02:0003DF2C 41EC0084        	  9510:     lea     ($0084,A4),A0
