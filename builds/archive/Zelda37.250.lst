                            	   909: _L_z01_UpdateCavePersonState_TalkOrShopOrDoorCharge_CheckPickUp:
                            	   910:     ; This is a cave where the player chooses or touches an item:
                            	   911:     ; - give item
                            	   912:     ; - shop
                            	   913:     ; - hint
                            	   914:     ; - money game
                            	   915:     ;
                            	   916:     ; If rupees are decreasing, then return.
                            	   917:     ;
02:0002E9B8 102C067E        	   918:     move.b  ($067E,A4),D0
