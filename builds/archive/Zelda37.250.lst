02:0003ADE8 9101            	  2773:     subx.b  D1,D0   ; SBC #$40
02:0003ADEA 0A3C0010        	  2774:     eori    #$10,CCR  ; restore X = 6502 C
                            	  2775: _anon_z04_39:
