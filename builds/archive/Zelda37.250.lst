                            	  3468:     ;
02:00041D58 41EC0098        	  3469:     lea     ($0098,A4),A0
02:00041D5C 10302000        	  3470:     move.b  (A0,D2.W),D0
02:00041D60 0200000C        	  3471:     andi.b #$0C,D0
02:00041D64 6734            	  3472:     beq  _anon_z05_85
02:00041D66 102C0070        	  3473:     move.b  ($0070,A4),D0
02:00041D6A 12342070        	  3474:     move.b  ($70,A4,D2.W),D1
02:00041D6E B001            	  3475:     cmp.b   D1,D0
02:00041D70 6600008A        	  3476:     bne  _L_z05_CheckLadder_StashLadder
02:00041D74 102C0084        	  3477:     move.b  ($0084,A4),D0
02:00041D78 023C00EE        	  3478:     andi    #$EE,CCR  ; CLC: clear C+X
02:00041D7C 123C0003        	  3479:     move.b  #$03,D1
02:00041D80 D101            	  3480:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:00041D82 003C0011        	  3481:     ori     #$11,CCR  ; SEC: set C+X
02:00041D86 41EC0084        	  3482:     lea     ($0084,A4),A0
02:00041D8A 12302000        	  3483:     move.b  (A0,D2.W),D1
02:00041D8E 0A3C0010        	  3484:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00041D92 9101            	  3485:     subx.b  D1,D0   ; SBC ObjY,X
02:00041D94 0A3C0010        	  3486:     eori    #$10,CCR  ; restore X = 6502 C
02:00041D98 6030            	  3487:     jmp     _L_z05_CheckLadder_CheckDistanceToLadder
