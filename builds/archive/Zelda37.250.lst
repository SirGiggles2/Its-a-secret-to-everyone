                            	  3771:     ;
02:0003B4F0 7020            	  3772:     moveq   #32,D0
02:0003B4F2 7600            	  3773:     moveq   #0,D3
02:0003B4F4 16342019        	  3774:     move.b  ($19,A4,D2.W),D3
02:0003B4F8 0C030080        	  3775:     cmpi.b  #$80,D3
