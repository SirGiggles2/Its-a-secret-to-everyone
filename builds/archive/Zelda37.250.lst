                            	   747: UpdatePersonState_Textbox:
02:0002E89C 7001            	   748:     moveq   #1,D0
02:0002E89E 6100C15A        	   749:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 1
02:0002E8A2 4EB90004BBE6    	   750:     jsr     Link_EndMoveAndDraw_Bank1
                            	   751:     ; If the person's timer has not expired, then return.
                            	   752:     ;
02:0002E8A8 102C0029        	   753:     move.b  ($0029,A4),D0
02:0002E8AC 660000D8        	   754:     bne  _L_z01_UpdatePersonState_Textbox_Exit
                            	   755:     ; Set the timer to wait 6 frames after the next character about
                            	   756:     ; to be shown.
                            	   757:     ;
02:0002E8B0 7006            	   758:     moveq   #6,D0
02:0002E8B2 19400029        	   759:     move.b  D0,($0029,A4)
                            	   760:     ; Copy the 5 bytes of the textbox character transfer record template
                            	   761:     ; to the dynamic transfer buf.
                            	   762:     ;
02:0002E8B6 7604            	   763:     moveq   #4,D3
                            	   764: _anon_z01_7:
02:0002E8B8 41F90002E892    	   765:     lea     (TextboxCharTransferRecTemplate).l,A0
02:0002E8BE 10303000        	   766:     move.b  (A0,D3.W),D0
02:0002E8C2 41EC0302        	   767:     lea     ($0302,A4),A0
02:0002E8C6 11803000        	   768:     move.b  D0,(A0,D3.W)
02:0002E8CA 5303            	   769:     subq.b  #1,D3
02:0002E8CC 6AEA            	   770:     bpl  _anon_z01_7
                            	   771:     even
                            	   772: _L_z01_UpdatePersonState_Textbox_WriteChar:
                            	   773:     ; Replace the low byte of the VRAM address with the one
                            	   774:     ; where the next character should be written.
                            	   775:     ;
02:0002E8CE 102C045F        	   776:     move.b  ($045F,A4),D0
02:0002E8D2 19400303        	   777:     move.b  D0,($0303,A4)
                            	   778:     ; Increment the low VRAM address for the next character.
                            	   779:     ;
02:0002E8D6 522C045F        	   780:     addq.b  #1,($045F,A4)
                            	   781:     ; Use the person text selector to look up the address of the
                            	   782:     ; text for the textbox. Store the address in [00:01].
                            	   783:     ;
02:0002E8DA 7600            	   784:     moveq   #0,D3
02:0002E8DC 162C0415        	   785:     move.b  ($0415,A4),D3
02:0002E8E0 41F90002DF16    	   786:     lea     (PersonTextAddrs).l,A0
02:0002E8E6 10303000        	   787:     move.b  (A0,D3.W),D0
02:0002E8EA 1880            	   788:     move.b  D0,($0000,A4)
02:0002E8EC 5203            	   789:     addq.b  #1,D3
02:0002E8EE 41F90002DF16    	   790:     lea     (PersonTextAddrs).l,A0
02:0002E8F4 10303000        	   791:     move.b  (A0,D3.W),D0
02:0002E8F8 19400001        	   792:     move.b  D0,($0001,A4)
                            	   793:     ; Load the person text current character index.
                            	   794:     ;
02:0002E8FC 7600            	   795:     moveq   #0,D3
02:0002E8FE 162C0416        	   796:     move.b  ($0416,A4),D3
                            	   797:     ; Increment the index variable to point to the next character
                            	   798:     ; for next time.
                            	   799:     ;
02:0002E902 522C0416        	   800:     addq.b  #1,($0416,A4)
                            	   801:     ; Get the current character.
                            	   802:     ;
02:0002E906 1214            	   803:     move.b  ($00,A4),D1   ; ptr lo
02:0002E908 182C0001        	   804:     move.b  ($01,A4),D4  ; ptr hi
02:0002E90C 024100FF        	   805:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E910 E14C            	   806:     lsl.w   #8,D4
02:0002E912 8841            	   807:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E914 48C4            	   808:     ext.l   D4
02:0002E916 D8BC00FF0000    	   809:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E91C 2044            	   810:     movea.l D4,A0
02:0002E91E 10303000        	   811:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	   812:     ; If the character is $25, then it's a special space. It will still
                            	   813:     ; take up space, but will not take time to show -- meaning that
                            	   814:     ; we'll go look up the next character to transfer.
                            	   815:     ;
02:0002E922 0200003F        	   816:     andi.b #$3F,D0
02:0002E926 0C000025        	   817:     cmpi.b  #$25,D0
02:0002E92A 67A2            	   818:     beq  _L_z01_UpdatePersonState_Textbox_WriteChar
                            	   819:     ; We have a non-space character. Put it in the transfer record.
                            	   820:     ;
02:0002E92C 19400305        	   821:     move.b  D0,($0305,A4)
                            	   822:     ; Play the "heart taken/character" sound effect.
                            	   823:     ;
02:0002E930 7010            	   824:     moveq   #16,D0
02:0002E932 19400604        	   825:     move.b  D0,($0604,A4)
                            	   826:     ; If the high 2 bits of character element = 0, then return.
                            	   827:     ;
02:0002E936 1214            	   828:     move.b  ($00,A4),D1   ; ptr lo
02:0002E938 182C0001        	   829:     move.b  ($01,A4),D4  ; ptr hi
02:0002E93C 024100FF        	   830:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0002E940 E14C            	   831:     lsl.w   #8,D4
02:0002E942 8841            	   832:     or.w    D1,D4             ; D4 = NES ptr addr
02:0002E944 48C4            	   833:     ext.l   D4
02:0002E946 D8BC00FF0000    	   834:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002E94C 2044            	   835:     movea.l D4,A0
02:0002E94E 10303000        	   836:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:0002E952 020000C0        	   837:     andi.b #$C0,D0
02:0002E956 672E            	   838:     beq  _L_z01_UpdatePersonState_Textbox_Exit
                            	   839:     ; Determine an index based on the high 2 bits of the character element:
                            	   840:     ;   $80: 0
                            	   841:     ;   $40: 1
                            	   842:     ;   $C0: 2
                            	   843:     ;
02:0002E958 7602            	   844:     moveq   #2,D3
02:0002E95A 0C0000C0        	   845:     cmpi.b  #$C0,D0
02:0002E95E 670A            	   846:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E960 5303            	   847:     subq.b  #1,D3
02:0002E962 0C000040        	   848:     cmpi.b  #$40,D0
02:0002E966 6702            	   849:     beq  _L_z01_UpdatePersonState_Textbox_ChangeLine
02:0002E968 5303            	   850:     subq.b  #1,D3
                            	   851:     even
                            	   852: _L_z01_UpdatePersonState_Textbox_ChangeLine:
                            	   853:     ; The index chooses the low VRAM address of the start
                            	   854:     ; of another line:
                            	   855:     ;   0: $C4: front of the second line
                            	   856:     ;   1: $E4: front of the third line
                            	   857:     ;   2: $A4: front of the first line
                            	   858:     ;
                            	   859:     ; Look up the low VRAM address and store it.
                            	   860:     ;
02:0002E96A 41F90002E898    	   861:     lea     (TextboxLineAddrsLo).l,A0
02:0002E970 10303000        	   862:     move.b  (A0,D3.W),D0
02:0002E974 1940045F        	   863:     move.b  D0,($045F,A4)
                            	   864:     ; If index = 2, then we've reached the end of the text,
                            	   865:     ; and low VRAM address is moved to the front of the first line.
                            	   866:     ; So, advance the state of the person object, and unhalt Link.
                            	   867:     ;
02:0002E978 0C030002        	   868:     cmpi.b  #$02,D3
02:0002E97C 6608            	   869:     bne  _L_z01_UpdatePersonState_Textbox_Exit
02:0002E97E 522C00AD        	   870:     addq.b  #1,($00AD,A4)
02:0002E982 6100FB98        	   871:     jsr     UnhaltLink
                            	   872:     even
                            	   873: _L_z01_UpdatePersonState_Textbox_Exit:
02:0002E986 4E75            	   874:     rts
                            	   875: 
                            	   876:     even
