                            	  2138: __far_z_04_0017:
02:0003A9C0 61000592        	  2139:     jsr     UpdateBurrower
                            	  2140:     ; If zora died in the call above, then it happened while in
                            	  2141:     ; states 2, 3, or 4. In the code below, the state won't be 0.
                            	  2142:     ; So, it won't flag the zora inactive. This is why the zora does
                            	  2143:     ; not come back after killing it.
                            	  2144:     ;
                            	  2145:     ; If state <> 3 or timer <> $FD,
                            	  2146:     ; then go see if the object needs to be destroyed.
                            	  2147:     ;
02:0003A9C4 41EC00AC        	  2148:     lea     ($00AC,A4),A0
02:0003A9C8 10302000        	  2149:     move.b  (A0,D2.W),D0
02:0003A9CC 0C000003        	  2150:     cmpi.b  #$03,D0
02:0003A9D0 6616            	  2151:     bne  _L_z04_UpdateZora_DestroyWhenDone
02:0003A9D2 10342028        	  2152:     move.b  ($28,A4,D2.W),D0
02:0003A9D6 0C0000FD        	  2153:     cmpi.b  #$FD,D0
02:0003A9DA 660C            	  2154:     bne  _L_z04_UpdateZora_DestroyWhenDone
