                            	  5237: _L_z04_UpdateRope_CheckSpeed:
02:0003BFA2 101D            	  5238:     move.b  (A5)+,D0  ; PLA
                            	  5239:     ; If the facing direction has changed, then set qspeed to $20 (slow).
                            	  5240:     ;
02:0003BFA4 41EC0098        	  5241:     lea     ($0098,A4),A0
02:0003BFA8 12302000        	  5242:     move.b  (A0,D2.W),D1
02:0003BFAC B001            	  5243:     cmp.b   D1,D0
02:0003BFAE 670A            	  5244:     beq  _anon_z04_76
02:0003BFB0 7020            	  5245:     moveq   #32,D0
02:0003BFB2 41EC03BC        	  5246:     lea     ($03BC,A4),A0
02:0003BFB6 11802000        	  5247:     move.b  D0,(A0,D2.W)
                            	  5248: _anon_z04_76:
                            	  5249:     ; If qspeed <> $20 or grid offset <> 0, then go draw.
                            	  5250:     ;
02:0003BFBA 41EC03BC        	  5251:     lea     ($03BC,A4),A0
02:0003BFBE 10302000        	  5252:     move.b  (A0,D2.W),D0
02:0003BFC2 0C000020        	  5253:     cmpi.b  #$20,D0
02:0003BFC6 6660            	  5254:     bne  _L_z04_UpdateRope_Animate
02:0003BFC8 41EC0394        	  5255:     lea     ($0394,A4),A0
02:0003BFCC 10302000        	  5256:     move.b  (A0,D2.W),D0
02:0003BFD0 6656            	  5257:     bne  _L_z04_UpdateRope_Animate
                            	  5258:     ; If the absolute horizontal distance between Link and the monster >= 8,
                            	  5259:     ; then go see if the vertical distance is smaller.
                            	  5260:     ;
02:0003BFD2 102C0070        	  5261:     move.b  ($0070,A4),D0
02:0003BFD6 003C0011        	  5262:     ori     #$11,CCR  ; SEC: set C+X
02:0003BFDA 12342070        	  5263:     move.b  ($70,A4,D2.W),D1
02:0003BFDE 0A3C0010        	  5264:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003BFE2 9101            	  5265:     subx.b  D1,D0   ; SBC ObjX,X
02:0003BFE4 0A3C0010        	  5266:     eori    #$10,CCR  ; restore X = 6502 C
02:0003BFE8 4EB900031026    	  5267:     jsr     Abs
02:0003BFEE 0C000008        	  5268:     cmpi.b  #$08,D0
02:0003BFF2 64000088        	  5269:     bcc  _L_z04_UpdateRope_CheckVertical
                            	  5270:     ; Face up.
                            	  5271:     ;
02:0003BFF6 7008            	  5272:     moveq   #8,D0
