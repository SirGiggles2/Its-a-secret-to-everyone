02:000419AE 123C0008        	  2890:     move.b  #$08,D1
02:000419B2 D101            	  2891:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:000419B4 7600            	  2892:     moveq   #0,D3
02:000419B6 1600            	  2893:     move.b  D0,D3
02:000419B8 103C0080        	  2894:     move.b  #$80,D0
