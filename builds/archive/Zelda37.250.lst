                            	  5065:     ; Force animation frame 1: hand closed.
                            	  5066:     ;
02:0003BE4C 7001            	  5067:     moveq   #1,D0
02:0003BE4E 41EC03E4        	  5068:     lea     ($03E4,A4),A0
