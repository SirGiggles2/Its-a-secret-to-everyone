                            	  5927: ; 4 sets of horizontal offsets, one for each state of weapon.
                            	  5928: ; Each set contains 4 offsets in reverse direction index order:
                            	  5929: ; up, down, left, right
                            	  5930: ;
                            	  5931: ; These offsets are added to player X to get weapon X.
                            	  5932: ;
                            	  5933:     even
                            	  5934: PlayerToWeaponOffsetsX:
02:0004C62E FF              	  5935:     dc.b    $FF, $01, $00, $F8, $FF, $01, $F5, $0B
02:0004C62F 01
02:0004C630 00
02:0004C631 F8
02:0004C632 FF
02:0004C633 01
02:0004C634 F5
02:0004C635 0B
02:0004C636 FF              	  5936:     dc.b    $FF, $01, $F9, $07, $FF, $01, $FD, $03
02:0004C637 01
02:0004C638 F9
02:0004C639 07
02:0004C63A FF
02:0004C63B 01
02:0004C63C FD
02:0004C63D 03
                            	  5937: 
                            	  5938: ; 4 sets of vertical offsets, one for each state of weapon.
                            	  5939: ; Each set contains 4 offsets in reverse direction index order:
                            	  5940: ; up, down, left, right
                            	  5941: ;
                            	  5942: ; These offsets are added to player Y to get weapon Y.
                            	  5943: ;
                            	  5944:     even
                            	  5945: PlayerToWeaponOffsetsY:
02:0004C63E F7              	  5946:     dc.b    $F7, $F2, $F5, $F5, $F6, $0D, $03, $03
02:0004C63F F2
02:0004C640 F5
02:0004C641 F5
02:0004C642 F6
02:0004C643 0D
02:0004C644 03
02:0004C645 03
02:0004C646 F7              	  5947:     dc.b    $F7, $09, $03, $03, $FF, $05, $03, $03
02:0004C647 09
02:0004C648 03
02:0004C649 03
02:0004C64A FF
02:0004C64B 05
02:0004C64C 03
02:0004C64D 03
