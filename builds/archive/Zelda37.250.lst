                            	 12098: _anon_z04_159:
02:0003F28E 61000D9C        	 12099:     jsr     DecreaseObjectAngle
                            	 12100:     ; Load Patra's maneuver index.
                            	 12101:     ; It determines which counts of bits are looked up below.
                            	 12102:     ;
02:0003F292 7600            	 12103:     moveq   #0,D3
02:0003F294 162C045F        	 12104:     move.b  ($045F,A4),D3
                            	 12105:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	 12106:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	 12107:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	 12108:     ;
02:0003F298 41EC034F        	 12109:     lea     ($034F,A4),A0
02:0003F29C 10302000        	 12110:     move.b  (A0,D2.W),D0
02:0003F2A0 0C000025        	 12111:     cmpi.b  #$25,D0
02:0003F2A4 661E            	 12112:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0003F2A6 41F90003F198    	 12113:     lea     (PatraChild1RotationCosineBits).l,A0
