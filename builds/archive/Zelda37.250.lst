02:00039EFC 102C066C        	   634:     move.b  ($066C,A4),D0
02:00039F00 1234203D        	   635:     move.b  ($3D,A4,D2.W),D1
02:00039F04 8001            	   636:     or.b  D1,D0
02:00039F06 6672            	   637:     bne  _L_z04_L_Walker_SetInputDirAndTryShootingBoomerang_Exit
                            	   638:     ; Try to shoot. Return, if it failed.
                            	   639:     ;
