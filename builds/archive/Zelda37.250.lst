                            	 10698: Gleeok_CheckCollisions:
                            	 10699:     ; If this segment is not the head nor the bottom of the neck,
                            	 10700:     ; then loop again to process the next segment.
                            	 10701:     ;
                            	 10702:     ; This kind of segment is only drawn, and is not checked
                            	 10703:     ; for object collisions.
                            	 10704:     ;
