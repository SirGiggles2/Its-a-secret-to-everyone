                            	  8215: Ganon_Dying:
                            	  8216:     ; Ganon is dying.
                            	  8217:     ; Increment Ganon phase every frame.
                            	  8218:     ;
02:0002F400 41EC042C        	  8219:     lea     ($042C,A4),A0
02:0002F404 52302000        	  8220:     addq.b  #1,(A0,D2.W)
                            	  8221:     ; If it just went from $FF to 0, then keep it at $FF.
                            	  8222:     ;
02:0002F408 41EC042C        	  8223:     lea     ($042C,A4),A0
02:0002F40C 10302000        	  8224:     move.b  (A0,D2.W),D0
02:0002F410 660C            	  8225:     bne  _anon_z04_162
02:0002F412 103C00FF        	  8226:     move.b  #$FF,D0
02:0002F416 41EC042C        	  8227:     lea     ($042C,A4),A0
02:0002F41A 11802000        	  8228:     move.b  D0,(A0,D2.W)
                            	  8229: _anon_z04_162:
                            	  8230:     ; If Ganon phase < $50, then go draw only.
                            	  8231:     ;
02:0002F41E 0C000050        	  8232:     cmpi.b  #$50,D0
02:0002F422 6402            	  8233:     bcc.s  __far_z_04_0095
02:0002F424 60D4            	  8234:     jmp  L_Ganon_DrawBody
                            	  8235: __far_z_04_0095:
                            	  8236:     ; If > $50, then go handle ashes only.
                            	  8237:     ;
02:0002F426 6634            	  8238:     bne  _L_z04_Ganon_Dying_HandleAshes
                            	  8239:     ; Otherwise Ganon phase = $50.
                            	  8240:     ; Set up the burst and ashes.
                            	  8241:     ;
02:0002F428 61000394        	  8242:     jsr     Ganon_AppendPaletteRowTransferRecord_Triforce
                            	  8243:     ; Ganon is now a pile of ashes at offset (7, 8) from where he was.
                            	  8244:     ;
02:0002F42C 10342070        	  8245:     move.b  ($70,A4,D2.W),D0
02:0002F430 123C0007        	  8246:     move.b  #$07,D1
02:0002F434 D101            	  8247:     addx.b  D1,D0   ; ADC #$07 (X flag = 6502 C)
02:0002F436 19802070        	  8248:     move.b  D0,($70,A4,D2.W)
02:0002F43A 41EC0084        	  8249:     lea     ($0084,A4),A0
02:0002F43E 10302000        	  8250:     move.b  (A0,D2.W),D0
02:0002F442 123C0008        	  8251:     move.b  #$08,D1
02:0002F446 D101            	  8252:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
02:0002F448 41EC0084        	  8253:     lea     ($0084,A4),A0
02:0002F44C 11802000        	  8254:     move.b  D0,(A0,D2.W)
02:0002F450 615C            	  8255:     jsr     Ganon_SetUpBurstRays
02:0002F452 610003DA        	  8256:     jsr     PlayBossDeathCry
02:0002F456 7002            	  8257:     moveq   #2,D0
