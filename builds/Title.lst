                            	  2246: ;==============================================================================
                            	  2247: ; _oam_dma_flush — Phase 1: transfer previous-frame SAT_SHADOW bank via VDP
                            	  2248: ;   68k→VRAM DMA to sprite attribute table at $F800.
                            	  2249: ;
                            	  2250: ; Must be called at the TOP of VBlankISR (before IsrNmi).  IsrNmi can extend
                            	  2251: ; into active display past scanline 40, so scheduling the DMA at the tail of
                            	  2252: ; VBlankISR would miss vblank.  The DMA source is the bank CURRENTLY flagged
                            	  2253: ; by SAT_ACTIVE_BANK — that is, the bank the previous frame's _oam_dma just
                            	  2254: ; finished filling.  After DMA setup the flag flips so the new frame's
                            	  2255: ; _oam_dma writes the OTHER bank.
                            	  2256: ;
                            	  2257: ; DMA params:
                            	  2258: ;   Reg 19/20: length = 256 words ($0100)
                            	  2259: ;   Reg 21/22/23: source = SAT_SHADOW_A or SAT_SHADOW_B (word address / 2)
                            	  2260: ;   VDP cmd: $78000083 (VRAM write $F800 + CD5 DMA bit)
                            	  2261: ;
                            	  2262: ; No busy-poll needed: DMA is fire-and-forget from 68k RAM.  Next VDP access
                            	  2263: ; (later in VBlankISR) will stall briefly if transfer still in flight.
                            	  2264: ;==============================================================================
                            	  2265:     even
                            	  2266: _oam_dma_flush:
02:0001E54E 48E7C000        	  2267:     movem.l D0/D1,-(SP)
02:0001E552 7000            	  2268:     moveq   #0,D0
02:0001E554 103900FF2400    	  2269:     move.b  (SAT_ACTIVE_BANK).l,D0
                            	  2270:     ; D0 = 0 → source = SAT_SHADOW_A; D0 = 1 → source = SAT_SHADOW_B
02:0001E55A 223C00FF2000    	  2271:     move.l  #SAT_SHADOW_A,D1
02:0001E560 4A00            	  2272:     tst.b   D0
02:0001E562 6706            	  2273:     beq.s   .oflush_src_ready
02:0001E564 223C00FF2200    	  2274:     move.l  #SAT_SHADOW_B,D1
                            	  2275: .oflush_src_ready:
                            	  2276:     ; Length: 256 words. Reg 19 = lo byte = $00, Reg 20 = hi byte = $01
02:0001E56A 33FC930000C00004	  2277:     move.w  #$9300,(VDP_CTRL).l   ; Reg 19: length lo = $00
02:0001E572 33FC940100C00004	  2278:     move.w  #$9401,(VDP_CTRL).l   ; Reg 20: length hi = $01
                            	  2279:     ; Source addr in words: D1 >> 1
02:0001E57A E289            	  2280:     lsr.l   #1,D1
                            	  2281:     ; Reg 21 = source[7:0]
02:0001E57C 3001            	  2282:     move.w  D1,D0
02:0001E57E 024000FF        	  2283:     andi.w  #$00FF,D0
02:0001E582 00409500        	  2284:     ori.w   #$9500,D0
02:0001E586 33C000C00004    	  2285:     move.w  D0,(VDP_CTRL).l
                            	  2286:     ; Reg 22 = source[15:8]
02:0001E58C 2001            	  2287:     move.l  D1,D0
02:0001E58E E088            	  2288:     lsr.l   #8,D0
02:0001E590 024000FF        	  2289:     andi.w  #$00FF,D0
02:0001E594 00409600        	  2290:     ori.w   #$9600,D0
02:0001E598 33C000C00004    	  2291:     move.w  D0,(VDP_CTRL).l
                            	  2292:     ; Reg 23 = source[22:16] with bit 7 clear (68k→VRAM mode)
02:0001E59E 2001            	  2293:     move.l  D1,D0
02:0001E5A0 E088            	  2294:     lsr.l   #8,D0
02:0001E5A2 E088            	  2295:     lsr.l   #8,D0
02:0001E5A4 0240007F        	  2296:     andi.w  #$007F,D0
02:0001E5A8 00409700        	  2297:     ori.w   #$9700,D0
02:0001E5AC 33C000C00004    	  2298:     move.w  D0,(VDP_CTRL).l
                            	  2299:     ; VDP command: VRAM write $F800 + DMA trigger bit
02:0001E5B2 23FC7800008300C0	  2300:     move.l  #$78000083,(VDP_CTRL).l
02:0001E5BA 0004
                            	  2301:     ; Flip active bank: bank just DMA'd becomes "previous"; other bank becomes active
02:0001E5BC 0A39000100FF2400	  2302:     eori.b  #1,(SAT_ACTIVE_BANK).l
02:0001E5C4 4CDF0003        	  2303:     movem.l (SP)+,D0/D1
02:0001E5C8 4E75            	  2304:     rts
                            	  2305: 
                            	  2306: ;==============================================================================
                            	  2307: ; MMC1 mapper writes ($8000 / $A000 / $C000 / $E000)
                            	  2308: ;==============================================================================
                            	  2309: ;
                            	  2310: ; T11b: real MMC1 shift-register decoder.
                            	  2311: ;
                            	  2312: ; Protocol: five consecutive writes to a register address.  Each write
                            	  2313: ; contributes bit 0 (LSB first) to the 5-bit shift accumulator.  Writing
                            	  2314: ; any byte with bit 7 set resets the shift register immediately.  On the
                            	  2315: ; 5th valid write the accumulated 5-bit value is stored in the corresponding
                            	  2316: ; MMC1 state register and the accumulator resets.
                            	  2317: ;
                            	  2318: ; MMC1 register map (Genesis RAM, $FF0812–$FF0815):
                            	  2319: ;   $8000 writes → MMC1_CTRL  (mirroring, PRG mode, CHR mode)
                            	  2320: ;   $A000 writes → MMC1_CHR0  (CHR bank 0)
                            	  2321: ;   $C000 writes → MMC1_CHR1  (CHR bank 1)
                            	  2322: ;   $E000 writes → MMC1_PRG   (PRG bank + RAM enable)
                            	  2323: ;
                            	  2324: ; Register contract:
                            	  2325: ;   D0.b = write value (NES accumulator, from transpiler)
                            	  2326: ;   D1-D3 saved/restored  (D3 = NES Y index — MUST be preserved)
                            	  2327: ;   D3 repurposed internally as target register offset (0-3 from MMC1_CTRL)
                            	  2328: ;   D1 = bit count (work), D2 = bit value (work)
                            	  2329: ;
                            	  2330: ; Expected state at LoopForever (T11b probe):
                            	  2331: ;   MMC1_CTRL = $0F  (IsrReset → SetMMC1Control($0F))
                            	  2332: ;   MMC1_PRG  = $05  (RunGame  → SwitchBank(5))
                            	  2333: ;   MMC1_SHIFT = $00, MMC1_COUNT = $00  (reset after each 5th write)
                            	  2334: ;==============================================================================
                            	  2335: 
                            	  2336: _mmc1_write_8000:
02:0001E5CA 48E77000        	  2337:     movem.l D1-D3,-(SP)
02:0001E5CE 7600            	  2338:     moveq   #0,D3                   ; CTRL is at offset 0 from MMC1_CTRL
02:0001E5D0 6016            	  2339:     bra.s   _mmc1_common
                            	  2340: 
                            	  2341: _mmc1_write_a000:
02:0001E5D2 48E77000        	  2342:     movem.l D1-D3,-(SP)
02:0001E5D6 7601            	  2343:     moveq   #1,D3                   ; CHR0 is at offset 1
02:0001E5D8 600E            	  2344:     bra.s   _mmc1_common
                            	  2345: 
                            	  2346: _mmc1_write_c000:
02:0001E5DA 48E77000        	  2347:     movem.l D1-D3,-(SP)
02:0001E5DE 7602            	  2348:     moveq   #2,D3                   ; CHR1 is at offset 2
02:0001E5E0 6006            	  2349:     bra.s   _mmc1_common
                            	  2350: 
                            	  2351: _mmc1_write_e000:
02:0001E5E2 48E77000        	  2352:     movem.l D1-D3,-(SP)
02:0001E5E6 7603            	  2353:     moveq   #3,D3                   ; PRG is at offset 3
                            	  2354:     ; fall through to _mmc1_common
                            	  2355: 
                            	  2356: _mmc1_common:
                            	  2357:     ; Check bit 7 — reset strobe
02:0001E5E8 08000007        	  2358:     btst    #7,D0
02:0001E5EC 6712            	  2359:     beq.s   .no_reset
02:0001E5EE 423900FF0810    	  2360:     clr.b   (MMC1_SHIFT).l
02:0001E5F4 423900FF0811    	  2361:     clr.b   (MMC1_COUNT).l
02:0001E5FA 4CDF000E        	  2362:     movem.l (SP)+,D1-D3
02:0001E5FE 4E75            	  2363:     rts
                            	  2364: 
                            	  2365: .no_reset:
                            	  2366:     ; Shift bit 0 of D0 into position MMC1_COUNT of the accumulator
02:0001E600 123900FF0811    	  2367:     move.b  (MMC1_COUNT).l,D1      ; D1.b = current count (0–4)
02:0001E606 1400            	  2368:     move.b  D0,D2
02:0001E608 02020001        	  2369:     andi.b  #1,D2                   ; D2.b = bit 0 of write value
02:0001E60C E32A            	  2370:     lsl.b   D1,D2                   ; D2.b = bit shifted to correct position
02:0001E60E 853900FF0810    	  2371:     or.b    D2,(MMC1_SHIFT).l       ; accumulate into shift register
                            	  2372: 
                            	  2373:     ; Increment count; check for completion
02:0001E614 523900FF0811    	  2374:     addq.b  #1,(MMC1_COUNT).l
02:0001E61A 0C39000500FF0811	  2375:     cmpi.b  #5,(MMC1_COUNT).l
02:0001E622 6620            	  2376:     bne.s   .mmc1_done              ; not yet 5 bits — wait for more writes
                            	  2377: 
                            	  2378:     ; 5th write: copy 5-bit shift value to the target state register
02:0001E624 143900FF0810    	  2379:     move.b  (MMC1_SHIFT).l,D2
02:0001E62A 0202001F        	  2380:     andi.b  #$1F,D2                 ; mask to 5 bits
02:0001E62E 41F900FF0812    	  2381:     lea     (MMC1_CTRL).l,A0        ; A0 = base of MMC1_CTRL ($FF0812)
02:0001E634 11823000        	  2382:     move.b  D2,(A0,D3.w)            ; store at MMC1_CTRL + D3 offset
                            	  2383: 
                            	  2384:     ; T36 Stage H experiment: universal auto-refresh of the PRG bank
                            	  2385:     ; window on $E000 writes. REVERTED — incompatible with the existing
                            	  2386:     ; manual P33b/P33c pins (z_01/z_03/z_05/z_06) which deliberately
                            	  2387:     ; set _current_window_bank to a bank that differs from MMC1_PRG.
                            	  2388:     ; Auto-refresh undid every pin on the next MMC1 write, breaking
                            	  2389:     ; Link movement in mode $05 (walk_left never reached x=$40, cave
                            	  2390:     ; entry never triggered). Full evidence in
                            	  2391:     ; builds/reports/t36_mmc1_autorefresh_finding.md. Next attempt
                            	  2392:     ; should target specific cave-interior pointer sites with P33b-
                            	  2393:     ; style pins instead of a universal write-side refresh.
                            	  2394: 
                            	  2395:     ; Reset accumulator
02:0001E638 423900FF0810    	  2396:     clr.b   (MMC1_SHIFT).l
02:0001E63E 423900FF0811    	  2397:     clr.b   (MMC1_COUNT).l
                            	  2398: 
                            	  2399: .mmc1_done:
02:0001E644 4CDF000E        	  2400:     movem.l (SP)+,D1-D3
02:0001E648 4E75            	  2401:     rts
