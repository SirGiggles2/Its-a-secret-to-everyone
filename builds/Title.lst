                            	  4236: GoWalkableDir:
                            	  4237:     ; If object is not Link, then the tile is walkable. Go see if this direction
                            	  4238:     ; makes the object cross a boundary. Then go check another direction if it does,
                            	  4239:     ; or else make this the object direction.
                            	  4240:     ;
02:0003B7E6 4A02            	  4241:     cmpi.b  #$00,D2
02:0003B7E8 6702            	  4242:     beq.s  __far_z_07_0056
02:0003B7EA 602C            	  4243:     jmp  CheckBoundary
                            	  4244: __far_z_07_0056:
                            	  4245:     ; The object is Link. We end up here regardless of walkability.
                            	  4246:     ;
                            	  4247:     ; If not in mode 5 or ladder is in use, return.
                            	  4248:     ;
02:0003B7EC 102C0012        	  4249:     move.b  ($0012,A4),D0
02:0003B7F0 0C000005        	  4250:     cmpi.b  #$05,D0
02:0003B7F4 6702            	  4251:     beq.s  __far_z_07_0057
02:0003B7F6 601C            	  4252:     jmp  ExitX0
