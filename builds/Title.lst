                            	   703:     ; Stage 2c: asm trampolines that bridge the register-based MoveObject
                            	   704:     ; contract (D2=slot) to the m68k SysV stack ABI used by C.
                            	   705:     include "c_shims.asm"

Source: "c_shims.asm"
                            	     1: ;==============================================================================
                            	     2: ; c_shims.asm — Stage 2c/2d: asm trampolines between the transpiled
                            	     3: ; register-based ABI (D2=slot, D0.b=val, etc.) and GCC's m68k SysV C ABI
                            	     4: ; (stack-passed args, D0/D1/A0/A1 caller-save, D2-D7/A2-A6 callee-save).
                            	     5: ;
                            	     6: ; Two classes of shim:
                            	     7: ;
                            	     8: ;   1. EXPORT side (asm caller -> C callee):
                            	     9: ;      Asm caller jumps here with args in registers; we marshal them
                            	    10: ;      to the stack and jsr the C function; pop args; rts.
                            	    11: ;
                            	    12: ;   2. IMPORT side (C caller -> asm callee):
                            	    13: ;      C caller puts args on the stack per SysV ABI; we pull them into
                            	    14: ;      the expected registers and jsr/jmp the asm function. These will
                            	    15: ;      be wired up in Stage 2d when C-emitted banks need to call native
                            	    16: ;      register-ABI helpers (_copy_bank_to_window, _ppu_write_6/7, etc).
                            	    17: ;==============================================================================
                            	    18: 
                            	    19:     section "text",code
                            	    20: 
