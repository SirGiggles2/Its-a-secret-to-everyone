02:0003B692 654C            	  3971:     bcs  _L_z07_MoveObject_Right
02:0003B694 E208            	  3972:     lsr.b  #1,D0   ; LSR A
02:0003B696 655E            	  3973:     bcs  _L_z07_MoveObject_Left
