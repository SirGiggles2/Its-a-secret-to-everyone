02:0002C4CE 646A            	  1753:     bcc  _L_z04_UpdateRedLeever_Exit
                            	  1754:     ; Face in the same direction as Link.
                            	  1755:     ;
02:0002C4D0 102C0098        	  1756:     move.b  ($0098,A4),D0
02:0002C4D4 41EC0098        	  1757:     lea     ($0098,A4),A0
02:0002C4D8 11802000        	  1758:     move.b  D0,(A0,D2.W)
                            	  1759:     ; Randomly (>= $C0) face the opposite direction -- toward Link.
                            	  1760:     ;
02:0002C4DC 10342019        	  1761:     move.b  ($19,A4,D2.W),D0
02:0002C4E0 0C0000C0        	  1762:     cmpi.b  #$C0,D0
