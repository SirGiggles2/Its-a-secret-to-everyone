02:0002C8A2 41EC034F        	  2308:     lea     ($034F,A4),A0
02:0002C8A6 10302000        	  2309:     move.b  (A0,D2.W),D0
02:0002C8AA 0C000022        	  2310:     cmpi.b  #$22,D0
