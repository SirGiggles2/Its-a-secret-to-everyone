02:0002D62C 41EC0084        	  4228:     lea     ($0084,A4),A0
02:0002D630 11802000        	  4229:     move.b  D0,(A0,D2.W)
02:0002D634 101D            	  4230:     move.b  (A5)+,D0  ; PLA
