                            	  4154: UpdateZeldaTextbox:
02:000284E8 4EB90003B8A8    	  4155:     jsr     Link_EndMoveAndDraw
                            	  4156:     ; If Zelda's timer has not expired, then return.
                            	  4157:     ;
02:000284EE 102C0029        	  4158:     move.b  ($0029,A4),D0
02:000284F2 6704            	  4159:     beq.s  __far_z_02_0004
02:000284F4 600000C6        	  4160:     jmp  LA9F4_Exit
                            	  4161: __far_z_02_0004:
                            	  4162:     ; Set the timer to wait 6 frames after the next character about
                            	  4163:     ; to be shown.
                            	  4164:     ;
02:000284F8 7006            	  4165:     moveq   #6,D0
02:000284FA 19400029        	  4166:     move.b  D0,($0029,A4)
                            	  4167:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4168:     ; to the dynamic transfer buf.
                            	  4169:     ;
02:000284FE 7604            	  4170:     moveq   #4,D3
                            	  4171: _anon_z02_31:
02:00028500 41F9000284DE    	  4172:     lea     (ThanksTextboxCharTransferRecTemplate).l,A0
02:00028506 10303000        	  4173:     move.b  (A0,D3.W),D0
02:0002850A 41EC0302        	  4174:     lea     ($0302,A4),A0
02:0002850E 11803000        	  4175:     move.b  D0,(A0,D3.W)
02:00028512 5303            	  4176:     subq.b  #1,D3
02:00028514 6AEA            	  4177:     bpl  _anon_z02_31
                            	  4178: _anon_z02_32:
                            	  4179:     ; Replace the low byte of the VRAM address with the one
                            	  4180:     ; where the next character should be written.
                            	  4181:     ;
02:00028516 102C045F        	  4182:     move.b  ($045F,A4),D0
02:0002851A 19400303        	  4183:     move.b  D0,($0303,A4)
                            	  4184:     ; Increment the low VRAM address for the next character.
                            	  4185:     ;
02:0002851E 522C045F        	  4186:     addq.b  #1,($045F,A4)
02:00028522 7000            	  4187:     moveq   #0,D0
02:00028524 1880            	  4188:     move.b  D0,($0000,A4)
02:00028526 7000            	  4189:     moveq   #0,D0
02:00028528 19400001        	  4190:     move.b  D0,($0001,A4)
                            	  4191:     ; Load the person text current character index.
                            	  4192:     ;
02:0002852C 7600            	  4193:     moveq   #0,D3
02:0002852E 162C0416        	  4194:     move.b  ($0416,A4),D3
                            	  4195:     ; Increment the index variable to point to the next character
                            	  4196:     ; for the next time.
                            	  4197:     ;
02:00028532 522C0416        	  4198:     addq.b  #1,($0416,A4)
                            	  4199:     ; Get the current character.
                            	  4200:     ;
02:00028536 1214            	  4201:     move.b  ($00,A4),D1   ; ptr lo
02:00028538 182C0001        	  4202:     move.b  ($01,A4),D4  ; ptr hi
02:0002853C 024100FF        	  4203:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00028540 E14C            	  4204:     lsl.w   #8,D4
02:00028542 8841            	  4205:     or.w    D1,D4             ; D4 = NES ptr addr
02:00028544 48C4            	  4206:     ext.l   D4
02:00028546 D8BC00FF0000    	  4207:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002854C 2044            	  4208:     movea.l D4,A0
02:0002854E 10303000        	  4209:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
                            	  4210:     ; If the character is $25, then it's a special space. It will still
                            	  4211:     ; take up space, but will not take time to show -- meaning that
                            	  4212:     ; we'll go look up the next character to transfer.
                            	  4213:     ;
02:00028552 0200003F        	  4214:     andi.b #$3F,D0
02:00028556 0C000025        	  4215:     cmpi.b  #$25,D0
02:0002855A 67BA            	  4216:     beq  _anon_z02_32
                            	  4217:     ; We have a non-space character. Put it in the transfer record.
                            	  4218:     ;
02:0002855C 19400305        	  4219:     move.b  D0,($0305,A4)
                            	  4220:     ; Play the "heart taken/character" tune.
                            	  4221:     ;
02:00028560 7010            	  4222:     moveq   #16,D0
02:00028562 19400604        	  4223:     move.b  D0,($0604,A4)
                            	  4224:     ; If the high 2 bits of character element = 0, then return.
                            	  4225:     ;
02:00028566 1214            	  4226:     move.b  ($00,A4),D1   ; ptr lo
02:00028568 182C0001        	  4227:     move.b  ($01,A4),D4  ; ptr hi
02:0002856C 024100FF        	  4228:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00028570 E14C            	  4229:     lsl.w   #8,D4
02:00028572 8841            	  4230:     or.w    D1,D4             ; D4 = NES ptr addr
02:00028574 48C4            	  4231:     ext.l   D4
02:00028576 D8BC00FF0000    	  4232:     add.l   #NES_RAM,D4       ; → Genesis addr
02:0002857C 2044            	  4233:     movea.l D4,A0
02:0002857E 10303000        	  4234:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00028582 020000C0        	  4235:     andi.b #$C0,D0
02:00028586 6602            	  4236:     bne.s  __far_z_02_0005
02:00028588 6032            	  4237:     jmp  LA9F4_Exit
                            	  4238: __far_z_02_0005:
                            	  4239:     ; Determine an index based on the high 2 bits of the character element:
                            	  4240:     ;   $80: 0
                            	  4241:     ;   $40: 1
                            	  4242:     ;   $C0: 2
                            	  4243:     ;
02:0002858A 7602            	  4244:     moveq   #2,D3
02:0002858C 0C0000C0        	  4245:     cmpi.b  #$C0,D0
02:00028590 670A            	  4246:     beq  _anon_z02_33
02:00028592 5303            	  4247:     subq.b  #1,D3
02:00028594 0C000040        	  4248:     cmpi.b  #$40,D0
02:00028598 6702            	  4249:     beq  _anon_z02_33
02:0002859A 5303            	  4250:     subq.b  #1,D3
                            	  4251: _anon_z02_33:
                            	  4252:     ; The index chooses the low VRAM address of the start
                            	  4253:     ; of another line:
                            	  4254:     ;   0: $C4: front of the second line
                            	  4255:     ;   1: $E4: front of the third line
                            	  4256:     ;   2: $A4: front of the first line
                            	  4257:     ;
02:0002859C 41F9000284E4    	  4258:     lea     (ThanksTextboxLineAddrsLo).l,A0
02:000285A2 10303000        	  4259:     move.b  (A0,D3.W),D0
02:000285A6 1940045F        	  4260:     move.b  D0,($045F,A4)
                            	  4261:     ; If index = 2, then we've reached the end of the text,
                            	  4262:     ; and low VRAM address is moved to the front of the first line.
                            	  4263:     ; So, advance the state of the person object, and unhalt Link.
                            	  4264:     ;
02:000285AA 0C030002        	  4265:     cmpi.b  #$02,D3
02:000285AE 6702            	  4266:     beq.s  __far_z_02_0006
02:000285B0 600A            	  4267:     jmp  LA9F4_Exit
                            	  4268: __far_z_02_0006:
02:000285B2 522C00AD        	  4269:     addq.b  #1,($00AD,A4)
02:000285B6 7000            	  4270:     moveq   #0,D0
02:000285B8 194000AC        	  4271:     move.b  D0,($00AC,A4)
