02:0002F3AA 41EC0394        	  8159:     lea     ($0394,A4),A0
02:0002F3AE 11802000        	  8160:     move.b  D0,(A0,D2.W)
02:0002F3B2 6100EEB0        	  8161:     jsr     BlueWizzrobe_TurnSometimesAndMoveAndCheckTile
                            	  8162:     ; Shoot every $40 frames.
                            	  8163:     ;
02:0002F3B6 102C0015        	  8164:     move.b  ($0015,A4),D0
02:0002F3BA 0200003F        	  8165:     andi.b #$3F,D0
02:0002F3BE 6606            	  8166:     bne  _L_z04_Ganon_MoveAndShoot_Exit
02:0002F3C0 7056            	  8167:     moveq   #86,D0
02:0002F3C2 6100C9E6        	  8168:     jsr     ShootFireball
                            	  8169:     even
                            	  8170: _L_z04_Ganon_MoveAndShoot_Exit:
02:0002F3C6 4E75            	  8171:     rts
                            	  8172: 
                            	  8173:     even
                            	  8174: GanonStartXs:
02:0002F3C8 30              	  8175:     dc.b    $30, $B0
02:0002F3C9 B0
