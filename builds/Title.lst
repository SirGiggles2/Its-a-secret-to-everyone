02:0002F918 023C00EE        	  8898:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F91C 122C052A        	  8899:     move.b  ($052A,A4),D1
02:0002F920 D101            	  8900:     addx.b  D1,D0   ; ADC WorldKillCycle
02:0002F922 7600            	  8901:     moveq   #0,D3
02:0002F924 1600            	  8902:     move.b  D0,D3
