                            	  4396:     ; The triforce over Zelda goes in slot 2.
                            	  4397:     ; Set its location $10 pixels above her.
                            	  4398:     ;
02:000286B4 102C0071        	  4399:     move.b  ($0071,A4),D0
02:000286B8 19400072        	  4400:     move.b  D0,($0072,A4)
02:000286BC 102C0085        	  4401:     move.b  ($0085,A4),D0
02:000286C0 003C0011        	  4402:     ori     #$11,CCR  ; SEC: set C+X
02:000286C4 123C0010        	  4403:     move.b  #$10,D1
02:000286C8 0A3C0010        	  4404:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:000286CC 9101            	  4405:     subx.b  D1,D0   ; SBC #$10
02:000286CE 0A3C0010        	  4406:     eori    #$10,CCR  ; restore X = 6502 C
02:000286D2 19400086        	  4407:     move.b  D0,($0086,A4)
                            	  4408:     ; Draw triforce over Zelda.
                            	  4409:     ;
02:000286D6 7402            	  4410:     moveq   #2,D2
