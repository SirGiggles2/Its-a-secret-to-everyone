02:000288F4 41F900028878    	  4658:     lea     (CreditsLastScreenList).l,A0
02:000288FA 12303000        	  4659:     move.b  (A0,D3.W),D1
02:000288FE B001            	  4660:     cmp.b   D1,D0
02:00028900 651C            	  4661:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4662:     ; If we haven't scrolled the last amount in the last screen,
                            	  4663:     ; then return.
                            	  4664:     ;
02:00028902 102C00FC        	  4665:     move.b  ($00FC,A4),D0
02:00028906 41F90002887A    	  4666:     lea     (CreditsLastVscrollList).l,A0
02:0002890C 12303000        	  4667:     move.b  (A0,D3.W),D1
02:00028910 B001            	  4668:     cmp.b   D1,D0
02:00028912 650A            	  4669:     bcs  _L_z02_UpdateMode13WinGame_Sub3_Exit
                            	  4670:     ; But if we have, then go to the next submode, and set a timer
