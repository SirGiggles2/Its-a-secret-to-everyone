                            	  1685: _L_z05_InitMode_EnterRoom_ChooseWalkDistance:
                            	  1686:     ; Choose a distance to walk depending on the door you
                            	  1687:     ; come out of.
                            	  1688:     ;
                            	  1689:     ; We'll get a 0 or 1 depending on the direction of the door.
                            	  1690:     ;
                            	  1691:     ; If the attribute of the door is "open", "key", or "key 2";
                            	  1692:     ; then you have shorter distance to cover. So use the
                            	  1693:     ; previous value as is to use indexes 0 and 1.
                            	  1694:     ;
                            	  1695:     ; Otherwise, add 2 to use indexes 2 and 3 to walk farther
                            	  1696:     ; to get out of the way of the wall or door.
                            	  1697:     ;
02:00030F42 610037EE        	  1698:     jsr     GetPassedDoorType
02:00030F46 02000007        	  1699:     andi.b #$07,D0
02:00030F4A 6710            	  1700:     beq  _anon_z05_45
02:00030F4C 0C000005        	  1701:     cmpi.b  #$05,D0
02:00030F50 670A            	  1702:     beq  _anon_z05_45
02:00030F52 0C000006        	  1703:     cmpi.b  #$06,D0
02:00030F56 6704            	  1704:     beq  _anon_z05_45
02:00030F58 5203            	  1705:     addq.b  #1,D3
02:00030F5A 5203            	  1706:     addq.b  #1,D3
                            	  1707: _anon_z05_45:
02:00030F5C 41F9000308B8    	  1708:     lea     (EnteringRoomRelativePositions).l,A0
02:00030F62 10303000        	  1709:     move.b  (A0,D3.W),D0
                            	  1710:     even
                            	  1711: _L_z05_InitMode_EnterRoom_PlaceObjects:
02:00030F66 19400394        	  1712:     move.b  D0,($0394,A4)
02:00030F6A 6100375A        	  1713:     jsr     SetupObjRoomBounds
                            	  1714:     ; Set current object slot variable to $B, to be ready for the
                            	  1715:     ; first frame of mode 5. So, that it begins updating objects
                            	  1716:     ; at slot $B.
                            	  1717:     ;
02:00030F6E 740B            	  1718:     moveq   #11,D2
02:00030F70 19420340        	  1719:     move.b  D2,($0340,A4)
                            	  1720: _anon_z05_46:
                            	  1721:     ; Reset common state of objects $B to 1.
                            	  1722:     ;
02:00030F74 41EC0492        	  1723:     lea     ($0492,A4),A0
02:00030F78 53302000        	  1724:     subq.b  #1,(A0,D2.W)
02:00030F7C 4EB90003B386    	  1725:     jsr     ResetShoveInfo
02:00030F82 41EC00AC        	  1726:     lea     ($00AC,A4),A0
02:00030F86 11802000        	  1727:     move.b  D0,(A0,D2.W)
02:00030F8A 41EC0098        	  1728:     lea     ($0098,A4),A0
02:00030F8E 11802000        	  1729:     move.b  D0,(A0,D2.W)
02:00030F92 1980203D        	  1730:     move.b  D0,($3D,A4,D2.W)
02:00030F96 41EC03D0        	  1731:     lea     ($03D0,A4),A0
02:00030F9A 52302000        	  1732:     addq.b  #1,(A0,D2.W)
02:00030F9E 41EC0405        	  1733:     lea     ($0405,A4),A0
02:00030FA2 52302000        	  1734:     addq.b  #1,(A0,D2.W)
02:00030FA6 7020            	  1735:     moveq   #32,D0
02:00030FA8 41EC03BC        	  1736:     lea     ($03BC,A4),A0
02:00030FAC 11802000        	  1737:     move.b  D0,(A0,D2.W)
02:00030FB0 5302            	  1738:     subq.b  #1,D2
