                            	  3575:     ;==========================================================================
                            	  3576:     ; SKIP: unhandled PPU address range — consume payload and continue
                            	  3577:     ;==========================================================================
                            	  3578: .ttf_skip_range:
02:0001EEA0 4A04            	  3579:     tst.b   D4                      ; repeat mode?
02:0001EEA2 6602            	  3580:     bne.s   .ttf_post_record        ; repeat: 1 byte already consumed
02:0001EEA4 D0C3            	  3581:     adda.w  D3,A0                   ; sequential: skip D3 bytes
                            	  3582:     bra     .ttf_post_record
                            	  3583: 
                            	  3584:     ;==========================================================================
                            	  3585:     ; POST-RECORD: update PPU_VADDR and loop to next record
                            	  3586:     ;==========================================================================
                            	  3587: .ttf_post_record:
02:0001EEA6 33C500FF0802    	  3588:     move.w  D5,(PPU_VADDR).l
02:0001EEAC 6000FAD2        	  3589:     bra     .ttf_next_record
                            	  3590: 
                            	  3591:     ;==========================================================================
                            	  3592:     ; DONE: update ZP pointer and return
                            	  3593:     ;==========================================================================
                            	  3594: .ttf_done:
                            	  3595:     ; Reset VDP to VRAM write mode so stale CRAM targeting doesn't
                            	  3596:     ; corrupt palette on subsequent VDP_DATA writes.
                            	  3597:     ; Target $FFFC (unused VRAM) to avoid corrupting tile 0 on stray writes.
02:0001EEB0 23FC7FFC000300C0	  3598:     move.l  #$7FFC0003,(VDP_CTRL).l
02:0001EEB8 0004
02:0001EEBA 4CDF0FFF        	  3599:     movem.l (SP)+,D0-D7/A0-A3
02:0001EEBE 4E75            	  3600:     rts
