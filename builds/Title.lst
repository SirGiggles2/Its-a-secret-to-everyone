02:0002F59C 7402            	  8420:     moveq   #2,D2
                            	  8421:     even
                            	  8422: _L_z04_Ganon_DrawBurst_LoopRay:
02:0002F59E 19420340        	  8423:     move.b  D2,($0340,A4)
                            	  8424:     ; If object slot < 5 or = 7, then move every frame.
                            	  8425:     ; Else move 3 out of every 4 frames.
                            	  8426:     ;
                            	  8427:     ; This makes pieces spread out in somewhat of a circle,
                            	  8428:     ; by making the pieces at cardinal directions move at
                            	  8429:     ; full speed while the diagonal ones move a little slower.
                            	  8430:     ;
02:0002F5A2 0C020005        	  8431:     cmpi.b  #$05,D2
02:0002F5A6 6510            	  8432:     bcs  _L_z04_Ganon_DrawBurst_Move
02:0002F5A8 0C020007        	  8433:     cmpi.b  #$07,D2
02:0002F5AC 670A            	  8434:     beq  _L_z04_Ganon_DrawBurst_Move
02:0002F5AE 102C0015        	  8435:     move.b  ($0015,A4),D0
02:0002F5B2 02000003        	  8436:     andi.b #$03,D0
02:0002F5B6 6704            	  8437:     beq  _anon_z04_164
                            	  8438:     even
