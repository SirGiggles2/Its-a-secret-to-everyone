02:000201A0 588F            	  3883:     addq.l  #4,SP
02:000201A2 08000008        	  3884:     btst    #8,D0
02:000201A6 6706            	  3885:     beq.s   .cc_aqspf
02:000201A8 003C0011        	  3886:     ori     #$11,CCR
02:000201AC 4E75            	  3887:     rts
                            	  3888: .cc_aqspf:
02:000201AE 023C00EE        	  3889:     andi    #$EE,CCR
02:000201B2 4E75            	  3890:     rts
