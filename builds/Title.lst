02:0001F844 670A            	  2534:     beq.s   .cc_iqsm
02:0001F846 003C0001        	  2535:     ori     #$01,CCR
02:0001F84A 0A3C0001        	  2536:     eori    #$01,CCR
02:0001F84E 4E75            	  2537:     rts
                            	  2538: .cc_iqsm:
02:0001F850 023C00FE        	  2539:     andi    #$FE,CCR
02:0001F854 0A3C0001        	  2540:     eori    #$01,CCR
02:0001F858 4E75            	  2541:     rts
