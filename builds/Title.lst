02:0002D342 41EC0485        	  3760:     lea     ($0485,A4),A0
02:0002D346 11802000        	  3761:     move.b  D0,(A0,D2.W)
02:0002D34A 610005F4        	  3762:     jsr     CheckBossHitReaction
                            	  3763:     ; Look for the tail segment, starting from the low end
                            	  3764:     ; of the chain that this dead segment belongs to.
                            	  3765:     ;
