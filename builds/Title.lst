                            	  8178: Ganon_UpdateBrownState:
                            	  8179:     ; Every other frame decrement the state.
                            	  8180:     ; But every frame draw Ganon either translucent or opaque.
                            	  8181:     ;
02:0002F3CA 102C0015        	  8182:     move.b  ($0015,A4),D0
02:0002F3CE E208            	  8183:     lsr.b  #1,D0   ; LSR A
02:0002F3D0 6410            	  8184:     bcc  _L_z04_Ganon_UpdateBrownState_Draw
02:0002F3D2 41EC00AC        	  8185:     lea     ($00AC,A4),A0
02:0002F3D6 53302000        	  8186:     subq.b  #1,(A0,D2.W)
                            	  8187:     ; If the state becomes 0, then Ganon is blue again.
                            	  8188:     ; Go switch his palette row to reflect it.
                            	  8189:     ;
02:0002F3DA 6606            	  8190:     bne  _L_z04_Ganon_UpdateBrownState_Draw
02:0002F3DC 61A4            	  8191:     jsr     Ganon_RandomizeLocation
02:0002F3DE 600003DA        	  8192:     jmp     Ganon_AppendPaletteRowTransferRecord_Blue
                            	  8193: 
                            	  8194:     even
                            	  8195: _L_z04_Ganon_UpdateBrownState_Draw:
                            	  8196:     ; When state >= $30, draw Ganon opaque.
                            	  8197:     ; When state goes below, draw him translucent.
                            	  8198:     ;
02:0002F3E2 41EC00AC        	  8199:     lea     ($00AC,A4),A0
02:0002F3E6 10302000        	  8200:     move.b  (A0,D2.W),D0
02:0002F3EA 0C000030        	  8201:     cmpi.b  #$30,D0
02:0002F3EE 6502            	  8202:     bcs.s  __far_z_04_0094
02:0002F3F0 6008            	  8203:     jmp  L_Ganon_DrawBody
                            	  8204: __far_z_04_0094:
02:0002F3F2 102C0015        	  8205:     move.b  ($0015,A4),D0
02:0002F3F6 E208            	  8206:     lsr.b  #1,D0   ; LSR A
02:0002F3F8 6404            	  8207:     bcc  _anon_z04_161
                            	  8208:     even
                            	  8209: L_Ganon_DrawBody:
02:0002F3FA 6100023E        	  8210:     jsr     Ganon_DrawBody
                            	  8211: _anon_z04_161:
02:0002F3FE 4E75            	  8212:     rts
                            	  8213: 
