                            	  1706: 
                            	  1707:     even
                            	  1708: _bank_rom_bases:
02:0001E23C 0000223C        	  1709:     dc.l    _nes_bank_00_data, _nes_bank_01_data
02:0001E240 0000623C
02:0001E244 0000A23C        	  1710:     dc.l    _nes_bank_02_data, _nes_bank_03_data
02:0001E248 0000E23C
02:0001E24C 0001223C        	  1711:     dc.l    _nes_bank_04_data, _nes_bank_05_data
