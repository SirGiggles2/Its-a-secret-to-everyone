02:00031A7C 102C0084        	  3212:     move.b  ($0084,A4),D0
02:00031A80 0C00009D        	  3213:     cmpi.b  #$9D,D0
02:00031A84 6702            	  3214:     beq.s  __far_z_05_0061
02:00031A86 606C            	  3215:     jmp  CheckCaveEdge
                            	  3216: __far_z_05_0061:
                            	  3217:     ; See if Link is on one of the 3 shortcut stairs.
                            	  3218:     ; X = $50: 1
                            	  3219:     ; X = $80: 2
                            	  3220:     ; X = $B0: 3
                            	  3221:     ;
                            	  3222:     ; If he's not on any, then return.
                            	  3223:     ;
02:00031A88 7601            	  3224:     moveq   #1,D3
02:00031A8A 102C0070        	  3225:     move.b  ($0070,A4),D0
02:00031A8E 0C000050        	  3226:     cmpi.b  #$50,D0
02:00031A92 6712            	  3227:     beq  _anon_z05_83
02:00031A94 5203            	  3228:     addq.b  #1,D3
02:00031A96 0C000080        	  3229:     cmpi.b  #$80,D0
02:00031A9A 670A            	  3230:     beq  _anon_z05_83
02:00031A9C 5203            	  3231:     addq.b  #1,D3
02:00031A9E 0C0000B0        	  3232:     cmpi.b  #$B0,D0
02:00031AA2 6702            	  3233:     beq.s  __far_z_05_0062
02:00031AA4 604C            	  3234:     jmp  L14F72_Exit
                            	  3235: __far_z_05_0062:
                            	  3236: _anon_z05_83:
                            	  3237:     ; Look for the current room in the cellar/shortcut room array.
                            	  3238:     ;
02:00031AA6 1883            	  3239:     move.b  D3,($0000,A4)
02:00031AA8 163C00FF        	  3240:     move.b  #$FF,D3
02:00031AAC 102C00EB        	  3241:     move.b  ($00EB,A4),D0
                            	  3242: _anon_z05_84:
02:00031AB0 5203            	  3243:     addq.b  #1,D3
02:00031AB2 41F900FF6BB2    	  3244:     lea     (NES_SRAM+$0BB2).l,A0
02:00031AB8 12303000        	  3245:     move.b  (A0,D3.W),D1
02:00031ABC B001            	  3246:     cmp.b   D1,D0
02:00031ABE 66F0            	  3247:     bne  _anon_z05_84
                            	  3248:     ; Add the value of the shortcut chosen to whatever index
                            	  3249:     ; the current room has in the array.
                            	  3250:     ;
                            	  3251:     ; This yields the index of one of the three shortcut rooms
                            	  3252:     ; after the current one.
                            	  3253:     ;
02:00031AC0 1003            	  3254:     move.b  D3,D0
02:00031AC2 023C00EE        	  3255:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031AC6 1214            	  3256:     move.b  ($0000,A4),D1
02:00031AC8 D101            	  3257:     addx.b  D1,D0   ; ADC $00
                            	  3258:     ; Wrap around if needed. Go to that room by way of mode $A.
                            	  3259:     ;
02:00031ACA 02000003        	  3260:     andi.b #$03,D0
02:00031ACE 7600            	  3261:     moveq   #0,D3
02:00031AD0 1600            	  3262:     move.b  D0,D3
02:00031AD2 41F900FF6BB2    	  3263:     lea     (NES_SRAM+$0BB2).l,A0
02:00031AD8 10303000        	  3264:     move.b  (A0,D3.W),D0
                            	  3265: ; Params:
                            	  3266: ; A: destination room ID
                            	  3267: ;
                            	  3268:     even
                            	  3269: GoToModeAFromCellar:
02:00031ADC 194000EB        	  3270:     move.b  D0,($00EB,A4)
02:00031AE0 4EB90003A7B6    	  3271:     jsr     MarkRoomVisited
                            	  3272:     even
