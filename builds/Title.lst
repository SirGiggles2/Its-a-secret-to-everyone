02:0002D464 11803000        	  3962:     move.b  D0,(A0,D3.W)
02:0002D468 41EC0099        	  3963:     lea     ($0099,A4),A0
02:0002D46C 11803000        	  3964:     move.b  D0,(A0,D3.W)
                            	  3965:     ; Bottom of the loop.
