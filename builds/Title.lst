                            	  3469:     ;==========================================================================
                            	  3470:     ; PALETTE RANGE ($3F00-$3F1F): NES color -> Genesis CRAM
                            	  3471:     ;==========================================================================
                            	  3472: .ttf_palette_range:
02:0001EDF4 2F0B            	  3473:     move.l  A3,-(SP)                ; save safety limit
02:0001EDF6 47F9000021BC    	  3474:     lea     (nes_palette_to_genesis).l,A3
                            	  3475: 
                            	  3476: .ttf_pal_loop:
                            	  3477:     ; Get data byte
02:0001EDFC 4A04            	  3478:     tst.b   D4                      ; repeat mode?
02:0001EDFE 6602            	  3479:     bne.s   .ttf_pal_have_byte
02:0001EE00 1418            	  3480:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3481: .ttf_pal_have_byte:
                            	  3482: 
                            	  3483:     ; Bounds check
02:0001EE02 0C453F20        	  3484:     cmpi.w  #$3F20,D5
02:0001EE06 6478            	  3485:     bhs.s   .ttf_pal_skip
                            	  3486: 
                            	  3487:     ; Compute palette offset
02:0001EE08 3005            	  3488:     move.w  D5,D0
02:0001EE0A 04403F00        	  3489:     subi.w  #$3F00,D0
02:0001EE0E 0240001F        	  3490:     andi.w  #$001F,D0               ; offset 0..31
                            	  3491: 
                            	  3492:     ; NES palette mirroring & sprite palette remap
                            	  3493:     ; Entry-0 offsets (16,20,24,28) mirror universal BG color → remap to BG
                            	  3494:     ; Non-entry-0 sprite colors → remap to Genesis CRAM palettes 2-3
02:0001EE12 0C400010        	  3495:     cmpi.w  #$10,D0
02:0001EE16 6534            	  3496:     blo.s   .ttf_pal_bg
02:0001EE18 3C00            	  3497:     move.w  D0,D6
02:0001EE1A 02460003        	  3498:     andi.w  #$0003,D6
02:0001EE1E 6606            	  3499:     bne.s   .ttf_pal_spr            ; non-zero slot → sprite palette
02:0001EE20 04400010        	  3500:     subi.w  #$10,D0                 ; entry-0: remap 16→0, 20→4, 24→8, 28→12
02:0001EE24 6026            	  3501:     bra.s   .ttf_pal_bg
                            	  3502: .ttf_pal_spr:
                            	  3503:     ifne CHR_EXPANSION_ENABLED
                            	  3504:     ; T-CHR S8 v2: pack sprite sub-palettes into unused tail slots of BG
                            	  3505:     ; palettes (PAL0[4..15] + PAL1[4..7]).  See .t19_spr_cram_base for the
                            	  3506:     ; mapping table.  Using an inline table to avoid cross-scope lea.
02:0001EE26 3C00            	  3507:     move.w  D0,D6
02:0001EE28 04460010        	  3508:     subi.w  #$10,D6
02:0001EE2C E44E            	  3509:     lsr.w   #2,D6                   ; D6 = sub-pal (0..3)
02:0001EE2E DC46            	  3510:     add.w   D6,D6                   ; * 2 for word index
02:0001EE30 45FA0010        	  3511:     lea     (.ttf_spr_cram_base,PC),A2
02:0001EE34 3C326000        	  3512:     move.w  (A2,D6.W),D6            ; D6 = CRAM base for this sub-pal
02:0001EE38 02400003        	  3513:     andi.w  #$0003,D0               ; color slot (1..3)
02:0001EE3C D040            	  3514:     add.w   D0,D0                   ; * 2
02:0001EE3E DC40            	  3515:     add.w   D0,D6                   ; D6 = CRAM address
                            	  3516:     ; D2 preserved (holds palette data byte for later .ttf_pal_have_cram lookup)
02:0001EE40 6008            	  3517:     bra.s   .ttf_pal_have_cram_new
                            	  3518: .ttf_spr_cram_base:
02:0001EE42 0008            	  3519:     dc.w    $08                     ; sub-pal 0 → PAL0[4]
02:0001EE44 0010            	  3520:     dc.w    $10                     ; sub-pal 1 → PAL0[8]
02:0001EE46 0018            	  3521:     dc.w    $18                     ; sub-pal 2 → PAL0[12]
02:0001EE48 0028            	  3522:     dc.w    $28                     ; sub-pal 3 → PAL1[4]
                            	  3523: .ttf_pal_have_cram_new:
                            	  3524:     else
                            	  3525:     ; Legacy: remap NES sprite pal 0-3 → Genesis pal 2-3 (last-write-wins).
                            	  3526:     move.w  D0,D6
                            	  3527:     subi.w  #$10,D6
                            	  3528:     lsr.w   #2,D6                   ; NES sprite pal (0-3)
                            	  3529:     ori.w   #$0002,D6               ; Genesis pal = NES_pal | 2 (0→2, 1→3, 2→2, 3→3)
                            	  3530:     andi.w  #$0003,D6
                            	  3531:     lsl.w   #5,D6                   ; * $20
                            	  3532:     andi.w  #$0003,D0               ; color slot
                            	  3533:     lsl.w   #1,D0                   ; * 2
                            	  3534:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3535:     endc
02:0001EE4A 600E            	  3536:     bra.s   .ttf_pal_have_cram
                            	  3537: .ttf_pal_bg:
                            	  3538: 
                            	  3539:     ; Compute CRAM address: palette_idx*$20 + color_slot*2
02:0001EE4C 3C00            	  3540:     move.w  D0,D6
02:0001EE4E E44E            	  3541:     lsr.w   #2,D6                   ; palette index (0..3)
02:0001EE50 EB4E            	  3542:     lsl.w   #5,D6                   ; * $20
02:0001EE52 02400003        	  3543:     andi.w  #$0003,D0               ; color slot
02:0001EE56 E348            	  3544:     lsl.w   #1,D0                   ; * 2
02:0001EE58 DC40            	  3545:     add.w   D0,D6                   ; D6.w = CRAM address
                            	  3546: .ttf_pal_have_cram:
                            	  3547: 
                            	  3548:     ; VDP CRAM write command
02:0001EE5A 7000            	  3549:     moveq   #0,D0
02:0001EE5C 3006            	  3550:     move.w  D6,D0
02:0001EE5E 4840            	  3551:     swap    D0
02:0001EE60 0080C0000000    	  3552:     ori.l   #$C0000000,D0
02:0001EE66 23C000C00004    	  3553:     move.l  D0,(VDP_CTRL).l
                            	  3554: 
                            	  3555:     ; Look up NES->Genesis color
02:0001EE6C 7000            	  3556:     moveq   #0,D0
02:0001EE6E 1002            	  3557:     move.b  D2,D0
02:0001EE70 0240003F        	  3558:     andi.w  #$003F,D0               ; mask to valid color index
02:0001EE74 E348            	  3559:     lsl.w   #1,D0                   ; word offset
02:0001EE76 30330000        	  3560:     move.w  (A3,D0.W),D0           ; Genesis color word
02:0001EE7A 33C000C00000    	  3561:     move.w  D0,(VDP_DATA).l
                            	  3562: 
                            	  3563: .ttf_pal_skip:
02:0001EE80 DA41            	  3564:     add.w   D1,D5                   ; advance PPU_VADDR
02:0001EE82 02453FFF        	  3565:     andi.w  #$3FFF,D5
02:0001EE86 5343            	  3566:     subq.w  #1,D3
02:0001EE88 6600FF72        	  3567:     bne     .ttf_pal_loop
                            	  3568: 
                            	  3569:     ; Palette post-reset: set PPU_VADDR to $0000, clear latch
02:0001EE8C 33FC000000FF0802	  3570:     move.w  #$0000,(PPU_VADDR).l
02:0001EE94 423900FF0800    	  3571:     clr.b   (PPU_LATCH).l
02:0001EE9A 265F            	  3572:     movea.l (SP)+,A3                ; restore safety limit
02:0001EE9C 6000FAE2        	  3573:     bra     .ttf_next_record        ; skip .ttf_post_record
