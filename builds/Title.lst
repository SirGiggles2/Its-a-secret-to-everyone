02:0002C850 0C000070        	  2260:     cmpi.b  #$70,D0
02:0002C854 6604            	  2261:     bne  _anon_z04_51
02:0002C856 61000682        	  2262:     jsr     PlaySecretFoundTune
                            	  2263: _anon_z04_51:
                            	  2264:     ; Replace the tile where the armos was.
                            	  2265:     ;
02:0002C85A 522C00F7        	  2266:     addq.b  #1,($00F7,A4)
02:0002C85E 101D            	  2267:     move.b  (A5)+,D0  ; PLA
02:0002C860 4EB90003AA60    	  2268:     jsr     ChangeTileObjTiles
                            	  2269:     ; Because the armos object is aligned to the square grid
                            	  2270:     ; (because it was made from a square),
                            	  2271:     ; set its grid offset to 3 to compensate.
                            	  2272:     ;
                            	  2273:     ; Most objects are aligned to the grid vertically when the
                            	  2274:     ; low nibble is $D.
                            	  2275:     ;
02:0002C866 7003            	  2276:     moveq   #3,D0
02:0002C868 41EC0394        	  2277:     lea     ($0394,A4),A0
02:0002C86C 11802000        	  2278:     move.b  D0,(A0,D2.W)
                            	  2279:     ; Set a speed (q-speed fraction) randomly:
                            	  2280:     ; $20 if random value < $80
                            	  2281:     ; $60 otherwise
                            	  2282:     ;
02:0002C870 7020            	  2283:     moveq   #32,D0
02:0002C872 7600            	  2284:     moveq   #0,D3
02:0002C874 16342019        	  2285:     move.b  ($19,A4,D2.W),D3
02:0002C878 0C030080        	  2286:     cmpi.b  #$80,D3
02:0002C87C 6502            	  2287:     bcs  _anon_z04_52
02:0002C87E 7060            	  2288:     moveq   #96,D0
                            	  2289: _anon_z04_52:
02:0002C880 41EC03BC        	  2290:     lea     ($03BC,A4),A0
02:0002C884 11802000        	  2291:     move.b  D0,(A0,D2.W)
                            	  2292:     even
                            	  2293: _L_z04_InitArmosOrFlyingGhini_FinishInit:
