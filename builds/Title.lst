                            	  5600: AnimateBoomerangAndCheckCollision:
                            	  5601:     ; Decrement animation counter; and when it reaches 0:
                            	  5602:     ; 1. arm it again for 2 frames
                            	  5603:     ; 2. advance the minor state within a cycle of 8
                            	  5604:     ; 3. see if it's time to play the sound effect, if the boomerang belongs to Link
                            	  5605:     ;
02:0003C120 41EC03D0        	  5606:     lea     ($03D0,A4),A0
02:0003C124 53302000        	  5607:     subq.b  #1,(A0,D2.W)
02:0003C128 6702            	  5608:     beq.s  __far_z_07_0080
02:0003C12A 6036            	  5609:     jmp  DrawBoomerangAndCheckCollision
