                            	  4781: _L_z02_DrawCredits_TerminateRecords:
                            	  4782:     ; Put the buffer's end marker -- whether we transfer tiles and
                            	  4783:     ; attributes or only tiles.
                            	  4784:     ;
02:00028B62 103C00FF        	  4785:     move.b  #$FF,D0
02:00028B66 19400325        	  4786:     move.b  D0,($0325,A4)
02:00028B6A 19400330        	  4787:     move.b  D0,($0330,A4)
                            	  4788:     ; Specify that we're transferring $20 bytes/tiles.
                            	  4789:     ;
02:00028B6E 7020            	  4790:     moveq   #32,D0
02:00028B70 19400304        	  4791:     move.b  D0,($0304,A4)
                            	  4792:     ; Write the high byte of the current VRAM page.
                            	  4793:     ;
02:00028B74 7400            	  4794:     moveq   #0,D2
02:00028B76 142C050C        	  4795:     move.b  ($050C,A4),D2
02:00028B7A 41F900028920    	  4796:     lea     (CreditLineVramAddrsHi).l,A0
02:00028B80 10302000        	  4797:     move.b  (A0,D2.W),D0
02:00028B84 19400302        	  4798:     move.b  D0,($0302,A4)
                            	  4799:     ; The line number will be used to shift the task mask below.
                            	  4800:     ;
02:00028B88 102C050D        	  4801:     move.b  ($050D,A4),D0
02:00028B8C 7600            	  4802:     moveq   #0,D3
02:00028B8E 1600            	  4803:     move.b  D0,D3
                            	  4804:     ; Multiply the VRAM line number by $20 to get the low VRAM address.
                            	  4805:     ;
02:00028B90 E308            	  4806:     lsl.b  #1,D0   ; ASL A
02:00028B92 E308            	  4807:     lsl.b  #1,D0   ; ASL A
02:00028B94 E308            	  4808:     lsl.b  #1,D0   ; ASL A
02:00028B96 E308            	  4809:     lsl.b  #1,D0   ; ASL A
02:00028B98 E308            	  4810:     lsl.b  #1,D0   ; ASL A
02:00028B9A 19400303        	  4811:     move.b  D0,($0303,A4)
                            	  4812:     ; Get the mask for the current VRAM page.
                            	  4813:     ;
02:00028B9E 41F90002892C    	  4814:     lea     (CreditsPagesTextMasks).l,A0
02:00028BA4 10302000        	  4815:     move.b  (A0,D2.W),D0
                            	  4816: _anon_z02_43:
                            	  4817:     ; Shift left as many times as the current VRAM line number,
                            	  4818:     ; to get the bit that indicates whether this line has text.
                            	  4819:     ;
02:00028BA8 E308            	  4820:     lsl.b  #1,D0   ; ASL A
02:00028BAA 5303            	  4821:     subq.b  #1,D3
