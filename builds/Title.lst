02:0002079C 242F000C        	  4766:     move.l  12(SP),D2       ; arg2 = slot
02:000207A0 4EB90002FA84    	  4767:     jsr     _ShootIfWanted
02:000207A6 640C            	  4768:     bcc.s   .csiw_fail
02:000207A8 7000            	  4769:     moveq   #0,D0
02:000207AA 1003            	  4770:     move.b  D3,D0           ; D0 = shot slot (low byte)
02:000207AC 008000000100    	  4771:     ori.l   #$100,D0        ; D0 |= CARRY_SET
02:000207B2 6002            	  4772:     bra.s   .csiw_done
                            	  4773: .csiw_fail:
02:000207B4 7000            	  4774:     moveq   #0,D0
                            	  4775: .csiw_done:
02:000207B6 241F            	  4776:     move.l  (SP)+,D2
02:000207B8 4E75            	  4777:     rts
