02:0002E03A 0A3C0010        	  5524:     eori    #$10,CCR  ; restore X = 6502 C
02:0002E03E 41EC0084        	  5525:     lea     ($0084,A4),A0
02:0002E042 11802000        	  5526:     move.b  D0,(A0,D2.W)
