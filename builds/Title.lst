                            	  2172:     ; palettes — sub-pal 0/1/2 → PAL0 (biased to slots 4/8/12), sub-pal 3 → PAL1
                            	  2173:     ; (biased to slot 4).  BG palettes themselves untouched.  CHR tiles live in
                            	  2174:     ; copy N (0..3) at VRAM $0000/$4000/$6000/$8000.
02:0001E4EE 3802            	  2175:     move.w  D2,D4
02:0001E4F0 02440003        	  2176:     andi.w  #$0003,D4           ; NES sub-palette (0..3)
02:0001E4F4 D844            	  2177:     add.w   D4,D4               ; word index
02:0001E4F6 43FA0046        	  2178:     lea     (.oam_tile_bias_tbl,PC),A1
02:0001E4FA DA714000        	  2179:     add.w   (A1,D4.W),D5        ; apply per-copy tile bias
02:0001E4FE 024507FF        	  2180:     andi.w  #$07FF,D5           ; keep bits 10:0 only
                            	  2181:     ; Attempt 5g: honor NES sprite attr bit 5 (behind background).  When set,
                            	  2182:     ; leave bit 15 clear so Plane A (now high priority) renders in front.
02:0001E502 08020005        	  2183:     btst    #5,D2
02:0001E506 6604            	  2184:     bne.s   .spr_low_prio_che
02:0001E508 00458000        	  2185:     ori.w   #$8000,D5           ; bit 15 = high priority
                            	  2186: .spr_low_prio_che:
02:0001E50C 43FA0038        	  2187:     lea     (.oam_pal_bits_tbl,PC),A1
02:0001E510 8A714000        	  2188:     or.w    (A1,D4.W),D5        ; OR in palette bits (PAL0/PAL0/PAL0/PAL1)
                            	  2189:     else
                            	  2190:     andi.w  #$07FF,D5           ; keep bits 10:0 only
                            	  2191:     ; Attempt 5g: honor NES sprite attr bit 5 (behind background).  When set,
                            	  2192:     ; leave bit 15 clear so Plane A (now high priority) renders in front.
                            	  2193:     btst    #5,D2
                            	  2194:     bne.s   .spr_low_prio_noche
                            	  2195:     ori.w   #$8000,D5           ; bit 15 = high priority (sprite over planes)
                            	  2196: .spr_low_prio_noche:
                            	  2197:     ; Palette: NES sprite attr[1:0] → Genesis bits[14:13], offset +2
                            	  2198:     move.w  D2,D4
                            	  2199:     andi.w  #$0003,D4           ; isolate NES sprite palette (0–3)
                            	  2200:     ori.w   #$0002,D4           ; offset: NES sprite pal 0,1→Genesis pal 2,3
                            	  2201:     andi.w  #$0003,D4           ; mask (0→2, 1→3, 2→2, 3→3)
                            	  2202:     lsl.w   #5,D4               ; shift left 5
                            	  2203:     lsl.w   #8,D4               ; shift left 8 more → total shift 13 → bits[14:13]
                            	  2204:     or.w    D4,D5               ; merge palette
                            	  2205:     endc
                            	  2206:     ; V-flip: NES attr bit 7 → Genesis tile word bit 12
02:0001E514 08020007        	  2207:     btst    #7,D2
02:0001E518 6704            	  2208:     beq     .no_vflip
02:0001E51A 00451000        	  2209:     ori.w   #$1000,D5           ; set bit 12
                            	  2210: .no_vflip:
