02:0002F796 41EC0478        	  8688:     lea     ($0478,A4),A0
02:0002F79A 11802000        	  8689:     move.b  D0,(A0,D2.W)
02:0002F79E 0A3C0001        	  8690:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
