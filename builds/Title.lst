                            	  2790:     ; plane0 = (A0), plane1 = 8(A0)
02:0001E8A6 7600            	  2791:     moveq   #0,D3
02:0001E8A8 1610            	  2792:     move.b  (A0),D3                 ; D3.b = plane 0 row byte
02:0001E8AA 7800            	  2793:     moveq   #0,D4
02:0001E8AC 18280008        	  2794:     move.b  8(A0),D4                ; D4.b = plane 1 row byte
                            	  2795: 
                            	  2796:     ; ---- Pixels 0-3 (upper nibbles) ----
02:0001E8B0 1C03            	  2797:     move.b  D3,D6
02:0001E8B2 E80E            	  2798:     lsr.b   #4,D6
02:0001E8B4 0246000F        	  2799:     andi.w  #$000F,D6
02:0001E8B8 DC46            	  2800:     add.w   D6,D6
02:0001E8BA 3C326000        	  2801:     move.w  (A2,D6.W),D6           ; D6.w = plane0 upper expanded
                            	  2802: 
02:0001E8BE 1004            	  2803:     move.b  D4,D0
02:0001E8C0 E808            	  2804:     lsr.b   #4,D0
02:0001E8C2 0240000F        	  2805:     andi.w  #$000F,D0
02:0001E8C6 D040            	  2806:     add.w   D0,D0
02:0001E8C8 30320000        	  2807:     move.w  (A2,D0.W),D0           ; D0.w = plane1 upper expanded
02:0001E8CC E348            	  2808:     lsl.w   #1,D0                   ; shift plane1 to bit 1
02:0001E8CE 8046            	  2809:     or.w    D6,D0                   ; combine
02:0001E8D0 33C000C00000    	  2810:     move.w  D0,(VDP_DATA).l         ; write pixels 0-3
                            	  2811: 
                            	  2812:     ; ---- Pixels 4-7 (lower nibbles) ----
02:0001E8D6 1C03            	  2813:     move.b  D3,D6
02:0001E8D8 0246000F        	  2814:     andi.w  #$000F,D6
02:0001E8DC DC46            	  2815:     add.w   D6,D6
02:0001E8DE 3C326000        	  2816:     move.w  (A2,D6.W),D6           ; D6.w = plane0 lower expanded
                            	  2817: 
02:0001E8E2 1004            	  2818:     move.b  D4,D0
02:0001E8E4 0240000F        	  2819:     andi.w  #$000F,D0
02:0001E8E8 D040            	  2820:     add.w   D0,D0
02:0001E8EA 30320000        	  2821:     move.w  (A2,D0.W),D0           ; D0.w = plane1 lower expanded
02:0001E8EE E348            	  2822:     lsl.w   #1,D0
02:0001E8F0 8046            	  2823:     or.w    D6,D0
02:0001E8F2 33C000C00000    	  2824:     move.w  D0,(VDP_DATA).l         ; write pixels 4-7
                            	  2825: 
02:0001E8F8 5288            	  2826:     addq.l  #1,A0                   ; next plane-0 row
02:0001E8FA 5305            	  2827:     subq.b  #1,D5
02:0001E8FC 6CA8            	  2828:     bge.s   .ftcb_row
                            	  2829: 
                            	  2830:     ; Skip past plane-1 bytes (A0 is now at +8, plane1 starts at +8 from tile start)
02:0001E8FE 5088            	  2831:     addq.l  #8,A0                   ; A0 now points to next tile
                            	  2832: 
02:0001E900 0839000500FF0804	  2833:     btst    #5,(PPU_CTRL).l
02:0001E908 6712            	  2834:     beq.s   .ftcb_no_hi_sprite_upload
02:0001E90A 0C411F20        	  2835:     cmpi.w  #$1F20,D1
02:0001E90E 650C            	  2836:     blo.s   .ftcb_no_hi_sprite_upload
02:0001E910 0C411F40        	  2837:     cmpi.w  #$1F40,D1
02:0001E914 6406            	  2838:     bhs.s   .ftcb_no_hi_sprite_upload
02:0001E916 4EB900001FFC    	  2839:     bsr     _chr_upload_sprite_4x
