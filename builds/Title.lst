                            	  2862: ;==============================================================================
                            	  2863: ; _transfer_tilebuf_fast -- Native tile buffer interpreter.
                            	  2864: ;
                            	  2865: ; Replaces TransferTileBuf + ContinueTransferTileBuf.
                            	  2866: ; Parses tile buffer records and dispatches by PPU address range into
                            	  2867: ; tight inner loops, avoiding per-byte _ppu_write_7 overhead.
                            	  2868: ;
                            	  2869: ; Input:
                            	  2870: ;   ($0000,A4) / ($0001,A4) = 16-bit NES RAM pointer to buffer start
                            	  2871: ;   A4 = NES_RAM ($FF0000)
                            	  2872: ;
                            	  2873: ; Output:
                            	  2874: ;   ($0000,A4) / ($0001,A4) updated past last consumed record
                            	  2875: ;   PPU_VADDR, PPU_CTRL, NT_CACHE, CRAM updated per record contents
                            	  2876: ;
                            	  2877: ; Preserves: D0, D2, D3, D7, A4, A5 (6502 register convention)
                            	  2878: ;==============================================================================
                            	  2879:     even
                            	  2880: _transfer_tilebuf_fast:
                            	  2881:     ; Caller passes buffer pointer in A0 (32-bit absolute address).
02:0001E956 48E7FFF0        	  2882:     movem.l D0-D7/A0-A3,-(SP)
                            	  2883: 
                            	  2884:     ; Reset PPU latch (matches _ppu_read_2 in original TransferTileBuf)
02:0001E95A 423900FF0800    	  2885:     clr.b   (PPU_LATCH).l
                            	  2886: 
                            	  2887:     ; HUD guard hoisted out of inner loop: compute once here, reused per
                            	  2888:     ; tile in the .ttf_nt_range loop. D7.b = 1 if any cave-mode predicate
                            	  2889:     ; is active and NT rows 0-6 writes must be suppressed; 0 otherwise.
                            	  2890:     ; Was previously 3 memory reads + 3 compares per NT tile; now 1
                            	  2891:     ; tst.b D7 per tile. Matters because HUD updates touch hundreds of
                            	  2892:     ; tiles per frame and the guard runs on every one.
02:0001E960 7E00            	  2893:     moveq   #0,D7
02:0001E962 0C2C000B0012    	  2894:     cmpi.b  #$0B,($0012,A4)         ; mode == cave?
02:0001E968 6710            	  2895:     beq.s   .ttf_hud_guard_on
02:0001E96A 0C2C00100012    	  2896:     cmpi.b  #$10,($0012,A4)         ; mode == stair transition?
02:0001E970 6708            	  2897:     beq.s   .ttf_hud_guard_on
02:0001E972 0C2C000B005B    	  2898:     cmpi.b  #$0B,($005B,A4)         ; target mode == cave?
02:0001E978 6602            	  2899:     bne.s   .ttf_hud_guard_off
                            	  2900: .ttf_hud_guard_on:
02:0001E97A 7E01            	  2901:     moveq   #1,D7
                            	  2902: .ttf_hud_guard_off:
                            	  2903: 
                            	  2904:     ; A0 = buffer pointer (set by caller via TransferBufPtrs)
                            	  2905:     ; A3 = safety limit: bail if buffer exceeds 2048 bytes (prevents runaway parsing)
02:0001E97C 47E80800        	  2906:     lea     (2048,A0),A3            ; largest buffer is ~1121 bytes
                            	  2907: 
                            	  2908: .ttf_next_record:
02:0001E980 B1CB            	  2909:     cmpa.l  A3,A0                   ; safety limit: bail if past 128 records
02:0001E982 6C00052C        	  2910:     bge     .ttf_done
02:0001E986 1018            	  2911:     move.b  (A0)+,D0                ; first byte of record
02:0001E988 6B000526        	  2912:     bmi     .ttf_done               ; bit 7 set ($80-$FF) = sentinel -> done
                            	  2913: 
                            	  2914:     ; --- Parse record header ---
                            	  2915:     ; D0.b = PPU addr hi byte
02:0001E98C 7A00            	  2916:     moveq   #0,D5
02:0001E98E 1A00            	  2917:     move.b  D0,D5
02:0001E990 E14D            	  2918:     lsl.w   #8,D5
02:0001E992 1A18            	  2919:     move.b  (A0)+,D5                ; D5.w = PPU address
02:0001E994 02453FFF        	  2920:     andi.w  #$3FFF,D5
                            	  2921: 
02:0001E998 1C18            	  2922:     move.b  (A0)+,D6                ; D6.b = control byte
                            	  2923: 
                            	  2924:     ; Decode count (bits 5:0, 0 means 64)
02:0001E99A 7600            	  2925:     moveq   #0,D3
02:0001E99C 1606            	  2926:     move.b  D6,D3
02:0001E99E 0243003F        	  2927:     andi.w  #$003F,D3
02:0001E9A2 6602            	  2928:     bne.s   .ttf_count_ok
02:0001E9A4 7640            	  2929:     moveq   #64,D3
                            	  2930: .ttf_count_ok:
                            	  2931: 
                            	  2932:     ; NES control byte layout (after two ASLs in original 6502):
                            	  2933:     ;   Bit 7 = increment mode: 0 = horizontal (+1), 1 = vertical (+32)
                            	  2934:     ;   Bit 6 = repeat mode:    0 = sequential,      1 = repeat single byte
                            	  2935: 
                            	  2936:     ; Decode increment (bit 7): 1 or 32
02:0001E9A6 7201            	  2937:     moveq   #1,D1                   ; D1.w = increment
02:0001E9A8 08060007        	  2938:     btst    #7,D6
02:0001E9AC 6702            	  2939:     beq.s   .ttf_inc_ok
02:0001E9AE 7220            	  2940:     moveq   #32,D1
                            	  2941: .ttf_inc_ok:
                            	  2942: 
                            	  2943:     ; Decode repeat mode (bit 6): prefetch single data byte
02:0001E9B0 7800            	  2944:     moveq   #0,D4                   ; D4.b = 0 = sequential mode
02:0001E9B2 08060006        	  2945:     btst    #6,D6
02:0001E9B6 6704            	  2946:     beq.s   .ttf_no_repeat
02:0001E9B8 1418            	  2947:     move.b  (A0)+,D2                ; D2.b = repeat data byte
02:0001E9BA 78FF            	  2948:     moveq   #-1,D4                  ; D4.b = $FF = repeat mode
                            	  2949: .ttf_no_repeat:
                            	  2950: 
                            	  2951:     ; Update PPU_CTRL bit 2 (increment mode) + NES RAM $00FF
02:0001E9BC 102C00FF        	  2952:     move.b  ($00FF,A4),D0
02:0001E9C0 08060007        	  2953:     btst    #7,D6
02:0001E9C4 6706            	  2954:     beq.s   .ttf_ctrl_h
02:0001E9C6 00000004        	  2955:     ori.b   #$04,D0                 ; set bit 2 = +32 mode
02:0001E9CA 6004            	  2956:     bra.s   .ttf_ctrl_s
                            	  2957: .ttf_ctrl_h:
02:0001E9CC 020000FB        	  2958:     andi.b  #$FB,D0                 ; clear bit 2 = +1 mode
                            	  2959: .ttf_ctrl_s:
02:0001E9D0 194000FF        	  2960:     move.b  D0,($00FF,A4)          ; update NES RAM CurPpuControl
02:0001E9D4 13C000FF0804    	  2961:     move.b  D0,(PPU_CTRL).l        ; update PPU_CTRL shadow
02:0001E9DA 33C500FF0802    	  2962:     move.w  D5,(PPU_VADDR).l       ; set PPU_VADDR to record start
                            	  2963: 
                            	  2964:     ; --- Dispatch by PPU address range ---
02:0001E9E0 0C452000        	  2965:     cmpi.w  #$2000,D5
02:0001E9E4 653C            	  2966:     blo     .ttf_chr_range          ; $0000-$1FFF = CHR
02:0001E9E6 0C4523C0        	  2967:     cmpi.w  #$23C0,D5
02:0001E9EA 650000D4        	  2968:     blo     .ttf_nt_range           ; $2000-$23BF = nametable 0 tiles
02:0001E9EE 0C452400        	  2969:     cmpi.w  #$2400,D5
02:0001E9F2 65000186        	  2970:     blo     .ttf_attr_range         ; $23C0-$23FF = nametable 0 attributes
02:0001E9F6 0C452800        	  2971:     cmpi.w  #$2800,D5
02:0001E9FA 650004A4        	  2972:     blo     .ttf_skip_range         ; $2400-$27FF = NT mirror (unused w/ vert mirror)
02:0001E9FE 0C452BC0        	  2973:     cmpi.w  #$2BC0,D5
02:0001EA02 6500025A        	  2974:     blo     .ttf_nt1_range          ; $2800-$2BBF = nametable 1 tiles
02:0001EA06 0C452C00        	  2975:     cmpi.w  #$2C00,D5
02:0001EA0A 65000300        	  2976:     blo     .ttf_attr1_range        ; $2BC0-$2BFF = nametable 1 attributes
02:0001EA0E 0C453F00        	  2977:     cmpi.w  #$3F00,D5
02:0001EA12 6500048C        	  2978:     blo     .ttf_skip_range         ; $2C00-$3EFF = unhandled
02:0001EA16 0C453F20        	  2979:     cmpi.w  #$3F20,D5
02:0001EA1A 650003D8        	  2980:     blo     .ttf_palette_range      ; $3F00-$3F1F = palette
02:0001EA1E 60000480        	  2981:     bra     .ttf_skip_range         ; $3F20+ = unhandled
                            	  2982: 
                            	  2983:     ;==========================================================================
                            	  2984:     ; CHR RANGE ($0000-$1FFF): 2BPP tile data -> VDP VRAM
                            	  2985:     ;==========================================================================
                            	  2986: .ttf_chr_range:
                            	  2987:     ; Fast path: sequential + horizontal (+1) + tile-aligned
02:0001EA22 B27C0001        	  2988:     cmp.w   #1,D1                   ; horizontal increment?
02:0001EA26 6622            	  2989:     bne.s   .ttf_chr_slow
02:0001EA28 4A04            	  2990:     tst.b   D4                      ; sequential mode?
02:0001EA2A 661E            	  2991:     bne.s   .ttf_chr_slow
02:0001EA2C 3005            	  2992:     move.w  D5,D0
02:0001EA2E 0240000F        	  2993:     andi.w  #$000F,D0               ; offset within tile
02:0001EA32 4A40            	  2994:     tst.w   D0
02:0001EA34 6614            	  2995:     bne.s   .ttf_chr_slow           ; not tile-aligned
                            	  2996: 
                            	  2997:     ; Delegate to _transfer_chr_block_fast (A0=source, D1.w=dest, D2.l=count)
02:0001EA36 2248            	  2998:     movea.l A0,A1                   ; save source pointer
02:0001EA38 3205            	  2999:     move.w  D5,D1                   ; D1.w = PPU dest
02:0001EA3A 7400            	  3000:     moveq   #0,D2
02:0001EA3C 3403            	  3001:     move.w  D3,D2                   ; D2.l = byte count
02:0001EA3E 6100FDC4        	  3002:     bsr     _transfer_chr_block_fast
02:0001EA42 D3C3            	  3003:     adda.l  D3,A1                   ; advance past consumed bytes
02:0001EA44 2049            	  3004:     movea.l A1,A0
02:0001EA46 6000045E        	  3005:     bra     .ttf_post_record
                            	  3006: 
                            	  3007: .ttf_chr_slow:
                            	  3008:     ; Byte-by-byte CHR buffering (handles non-aligned, vertical, repeat)
                            	  3009:     ; Use existing CHR_TILE_BUF accumulation logic
02:0001EA4A 45F900FF0820    	  3010:     lea     (CHR_TILE_BUF).l,A2
                            	  3011: 
                            	  3012: .ttf_chr_slow_loop:
                            	  3013:     ; Get data byte
02:0001EA50 4A04            	  3014:     tst.b   D4                      ; repeat mode?
02:0001EA52 6602            	  3015:     bne.s   .ttf_chr_have_byte
02:0001EA54 1418            	  3016:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3017: .ttf_chr_have_byte:
                            	  3018: 
                            	  3019:     ; Store in CHR_TILE_BUF at (PPU_VADDR & $F)
02:0001EA56 3005            	  3020:     move.w  D5,D0
02:0001EA58 0240000F        	  3021:     andi.w  #$000F,D0
02:0001EA5C 15820000        	  3022:     move.b  D2,(A2,D0.W)           ; CHR_TILE_BUF[offset] = byte
                            	  3023: 
                            	  3024:     ; Check if first byte of tile: save base address
02:0001EA60 4A40            	  3025:     tst.w   D0
02:0001EA62 660C            	  3026:     bne.s   .ttf_chr_no_base
02:0001EA64 3005            	  3027:     move.w  D5,D0
02:0001EA66 0240FFF0        	  3028:     andi.w  #$FFF0,D0
02:0001EA6A 33C000FF0832    	  3029:     move.w  D0,(CHR_BUF_VADDR).l
                            	  3030: .ttf_chr_no_base:
                            	  3031: 
                            	  3032:     ; Advance PPU_VADDR
02:0001EA70 DA41            	  3033:     add.w   D1,D5
                            	  3034: 
                            	  3035:     ; Check if we just completed a tile (16 bytes)
02:0001EA72 3005            	  3036:     move.w  D5,D0
02:0001EA74 0240000F        	  3037:     andi.w  #$000F,D0
02:0001EA78 4A40            	  3038:     tst.w   D0
02:0001EA7A 663C            	  3039:     bne.s   .ttf_chr_no_convert
                            	  3040: 
                            	  3041:     ; Convert and upload the completed tile
                            	  3042:     ifne CHR_EXPANSION_ENABLED
02:0001EA7C 303900FF0832    	  3043:     move.w  (CHR_BUF_VADDR).l,D0
02:0001EA82 0800000C        	  3044:     btst    #12,D0
02:0001EA86 6608            	  3045:     bne.s   .ttf_chr_bg_dispatch
02:0001EA88 4EB900001FFC    	  3046:     bsr     _chr_upload_sprite_4x
02:0001EA8E 6028            	  3047:     bra.s   .ttf_chr_uploaded
                            	  3048: .ttf_chr_bg_dispatch:
02:0001EA90 4EB900001F5C    	  3049:     bsr     _chr_convert_upload
02:0001EA96 0839000500FF0804	  3050:     btst    #5,(PPU_CTRL).l
02:0001EA9E 6718            	  3051:     beq.s   .ttf_chr_uploaded
02:0001EAA0 303900FF0832    	  3052:     move.w  (CHR_BUF_VADDR).l,D0
02:0001EAA6 0C401F20        	  3053:     cmpi.w  #$1F20,D0
02:0001EAAA 650C            	  3054:     blo.s   .ttf_chr_uploaded
02:0001EAAC 0C401F40        	  3055:     cmpi.w  #$1F40,D0
02:0001EAB0 6406            	  3056:     bhs.s   .ttf_chr_uploaded
02:0001EAB2 4EB900001FFC    	  3057:     bsr     _chr_upload_sprite_4x
