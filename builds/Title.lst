02:00030FBA 41F900FF697E    	  1744:     lea     (NES_SRAM+$097E).l,A0
02:00030FC0 10303000        	  1745:     move.b  (A0,D3.W),D0
02:00030FC4 1B00            	  1746:     move.b  D0,-(A5)  ; PHA
