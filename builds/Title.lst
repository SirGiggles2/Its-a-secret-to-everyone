02:00031A68 101D            	  3195:     move.b  (A5)+,D0  ; PLA
                            	  3196:     ; If mode is not $C (shortcuts), go check the screen edge.
                            	  3197:     ;
02:00031A6A 0C00000C        	  3198:     cmpi.b  #$0C,D0
