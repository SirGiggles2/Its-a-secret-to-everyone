                            	  4360: DrawLinkZeldaTriforces:
                            	  4361:     ; The triforce over Link goes in the room object slot $13.
                            	  4362:     ; Set its location $10 pixels above Link.
                            	  4363:     ;
02:00028658 102C0070        	  4364:     move.b  ($0070,A4),D0
02:0002865C 19400083        	  4365:     move.b  D0,($0083,A4)
02:00028660 102C0084        	  4366:     move.b  ($0084,A4),D0
02:00028664 003C0011        	  4367:     ori     #$11,CCR  ; SEC: set C+X
02:00028668 123C0010        	  4368:     move.b  #$10,D1
02:0002866C 0A3C0010        	  4369:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00028670 9101            	  4370:     subx.b  D1,D0   ; SBC #$10
02:00028672 0A3C0010        	  4371:     eori    #$10,CCR  ; restore X = 6502 C
02:00028676 19400097        	  4372:     move.b  D0,($0097,A4)
                            	  4373:     ; Draw Link.
                            	  4374:     ;
02:0002867A 7400            	  4375:     moveq   #0,D2
02:0002867C 4EB90003C8E8    	  4376:     jsr     Anim_FetchObjPosForSpriteDescriptor
02:00028682 6100C2E2        	  4377:     jsr     Anim_SetSpriteDescriptorAttributes
02:00028686 1940000C        	  4378:     move.b  D0,($000C,A4)
02:0002868A 7048            	  4379:     moveq   #72,D0
02:0002868C 19400343        	  4380:     move.b  D0,($0343,A4)
02:00028690 704C            	  4381:     moveq   #76,D0
02:00028692 19400344        	  4382:     move.b  D0,($0344,A4)
02:00028696 7621            	  4383:     moveq   #33,D3
02:00028698 6100C21E        	  4384:     jsr     Anim_WriteSpecificItemSprites
                            	  4385:     ; Draw triforce over Link.
                            	  4386:     ;
02:0002869C 701B            	  4387:     moveq   #27,D0
02:0002869E 7413            	  4388:     moveq   #19,D2
02:000286A0 4EB90003A814    	  4389:     jsr     AnimateItemObject
02:000286A6 7401            	  4390:     moveq   #1,D2
02:000286A8 4EB90003C8E8    	  4391:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  4392:     ; Draw Zelda.
                            	  4393:     ;
