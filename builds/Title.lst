02:0002F4DE 10303000        	  8329:     move.b  (A0,D3.W),D0
02:0002F4E2 41EC009A        	  8330:     lea     ($009A,A4),A0
02:0002F4E6 11803000        	  8331:     move.b  D0,(A0,D3.W)
02:0002F4EA 5303            	  8332:     subq.b  #1,D3
02:0002F4EC 6AC2            	  8333:     bpl  _L_z04_Ganon_SetUpBurstRays_LoopRay
02:0002F4EE 4E75            	  8334:     rts
