02:0003CD10 41EC0492        	  7136:     lea     ($0492,A4),A0
02:0003CD14 11802000        	  7137:     move.b  D0,(A0,D2.W)
02:0003CD18 4E75            	  7138:     rts
                            	  7139:     even
