02:0002C754 41EC03E4        	  2095:     lea     ($03E4,A4),A0
02:0002C758 12302000        	  2096:     move.b  (A0,D2.W),D1
02:0002C75C B300            	  2097:     eor.b  D1,D0
02:0002C75E 41EC03E4        	  2098:     lea     ($03E4,A4),A0
02:0002C762 11802000        	  2099:     move.b  D0,(A0,D2.W)
                            	  2100:     even
