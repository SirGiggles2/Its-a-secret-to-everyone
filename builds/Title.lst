02:0001E254 0001A23C        	  1712:     dc.l    _nes_bank_06_data, 0
02:0001E258 00000000
                            	  1713: 
                            	  1714: ;------------------------------------------------------------------------------
                            	  1715: ; _copy_bank_to_window
                            	  1716: ;   D0.w = bank number (0-7)
                            	  1717: ;   Copies bank 0-6 into $FF8000 when cache misses. Bank 7 is exempt.
                            	  1718: ;------------------------------------------------------------------------------
                            	  1719: _copy_bank_to_window:
02:0001E25C 02400007        	  1720:     andi.w  #$0007,D0
02:0001E260 0C400007        	  1721:     cmpi.w  #7,D0
02:0001E264 6734            	  1722:     beq.s   .skip
02:0001E266 B03900FF083F    	  1723:     cmp.b   (_current_window_bank).l,D0
02:0001E26C 672C            	  1724:     beq.s   .skip
02:0001E26E 48E740C0        	  1725:     movem.l D1/A0-A1,-(SP)
02:0001E272 3200            	  1726:     move.w  D0,D1
02:0001E274 E549            	  1727:     lsl.w   #2,D1
02:0001E276 41F90001E23C    	  1728:     lea     (_bank_rom_bases).l,A0
02:0001E27C 20701000        	  1729:     movea.l (A0,D1.W),A0
02:0001E280 43F900FF8000    	  1730:     lea     (BANK_WINDOW_BASE).l,A1
02:0001E286 323C0FFF        	  1731:     move.w  #BANK_WINDOW_SIZE/4-1,D1
                            	  1732: .copy_loop:
02:0001E28A 22D8            	  1733:     move.l  (A0)+,(A1)+
02:0001E28C 51C9FFFC        	  1734:     dbra    D1,.copy_loop
02:0001E290 13C000FF083F    	  1735:     move.b  D0,(_current_window_bank).l
02:0001E296 4CDF0302        	  1736:     movem.l (SP)+,D1/A0-A1
                            	  1737: .skip:
02:0001E29A 4E75            	  1738:     rts
                            	  1739: 
                            	  1740: ;------------------------------------------------------------------------------
                            	  1741: ; _ensure_bank_window
                            	  1742: ;   Reads MMC1_PRG and ensures $FF8000 currently mirrors that PRG bank.
                            	  1743: ;   Preserves D0 and all address registers used by callers.
                            	  1744: ;------------------------------------------------------------------------------
                            	  1745: _ensure_bank_window:
02:0001E29C 48E78000        	  1746:     movem.l D0,-(SP)
02:0001E2A0 7000            	  1747:     moveq   #0,D0
02:0001E2A2 103900FF0815    	  1748:     move.b  (MMC1_PRG).l,D0
02:0001E2A8 02400007        	  1749:     andi.w  #$0007,D0
02:0001E2AC B03900FF083F    	  1750:     cmp.b   (_current_window_bank).l,D0
02:0001E2B2 6702            	  1751:     beq.s   .done
02:0001E2B4 61A6            	  1752:     bsr     _copy_bank_to_window
                            	  1753: .done:
02:0001E2B6 4CDF0001        	  1754:     movem.l (SP)+,D0
02:0001E2BA 4E75            	  1755:     rts
                            	  1756: 
                            	  1757: ;==============================================================================
                            	  1758: ; Controller I/O
                            	  1759: ;==============================================================================
                            	  1760: 
                            	  1761: ;------------------------------------------------------------------------------
                            	  1762: ; _ctrl_strobe — $4016 write (T27).
                            	  1763: ;
                            	  1764: ; On every call: read Genesis controller 1 via hardware I/O (TH two-phase),
                            	  1765: ; build an 8-bit NES button latch byte, and reset the serial read index.
                            	  1766: ;
                            	  1767: ; NES button order (bit0=A, bit1=B, bit2=Sel, bit3=Start,
                            	  1768: ;                   bit4=Up, bit5=Down, bit6=Left, bit7=Right).
                            	  1769: ; Genesis bits are active-low (0 = pressed).
                            	  1770: ;
                            	  1771: ; Latch storage (in Genesis work-RAM above NES address space):
                            	  1772: ;   CTL1_LATCH = ($1100,A4) = $FF1100 — latched NES button byte
                            	  1773: ;   CTL1_IDX   = ($1101,A4) = $FF1101 — serial read index (0–7)
                            	  1774: ;------------------------------------------------------------------------------
                            	  1775: _ctrl_strobe:
                            	  1776:     ; Gate: the NES protocol writes $01 then $00 to $4016.  The transpiled
                            	  1777:     ; code preserves this as two jsr _ctrl_strobe calls — first with D0=1
                            	  1778:     ; (strobe-on), then D0=0 (strobe-off = latch).  Only the D0=0 call
                            	  1779:     ; needs to actually poll the pad.  Skipping the D0=1 call halves the
                            	  1780:     ; TH toggle frequency, which prevents ReadOneController's debounce
                            	  1781:     ; loop from trapping on real hardware where rapid toggling produces
                            	  1782:     ; inconsistent reads from the 3-button pad multiplexer.
02:0001E2BC 4A00            	  1783:     tst.b   D0
02:0001E2BE 660000A0        	  1784:     bne     .cs_skip             ; D0 != 0 → strobe-on phase, no-op
                            	  1785: 
02:0001E2C2 48E77000        	  1786:     movem.l D1-D3,-(SP)
                            	  1787:     ; Phase 1: TH=1 → bits[5:4]=C,B  bits[3:0]=Right,Left,Down,Up (active low)
                            	  1788:     ; CTRL register ($A10009) already set to $40 by EntryPoint init.
02:0001E2C6 13FC004000A10003	  1789:     move.b  #$40,($A10003).l    ; assert TH=1
02:0001E2CE 4E71            	  1790:     nop                          ; 4 NOPs settling time for real hardware
02:0001E2D0 4E71            	  1791:     nop
02:0001E2D2 4E71            	  1792:     nop
02:0001E2D4 4E71            	  1793:     nop
02:0001E2D6 123900A10003    	  1794:     move.b  ($A10003).l,D1      ; D1 = TH=1 data
                            	  1795:     ; Phase 2: TH=0 → bits[5:4]=Start,A  bits[3:0]=Right,Left,Down,Up (active low)
02:0001E2DC 13FC000000A10003	  1796:     move.b  #$00,($A10003).l    ; assert TH=0
02:0001E2E4 4E71            	  1797:     nop
02:0001E2E6 4E71            	  1798:     nop
02:0001E2E8 4E71            	  1799:     nop
02:0001E2EA 4E71            	  1800:     nop
02:0001E2EC 143900A10003    	  1801:     move.b  ($A10003).l,D2      ; D2 = TH=0 data
                            	  1802:     ; Restore TH=1 idle state (standard Genesis practice)
02:0001E2F2 13FC004000A10003	  1803:     move.b  #$40,($A10003).l
                            	  1804:     ; Build NES button byte
                            	  1805:     ; Button mapping (user request): NES B = Genesis A, NES A = Genesis B.
                            	  1806:     ; Genesis B sits where the user's primary attack thumb lands, so it
                            	  1807:     ; drives the NES "sword/attack" (NES A).  Genesis A falls to NES B
                            	  1808:     ; ("item" — boomerang, bombs, candle, etc.).
02:0001E2FA 7600            	  1809:     moveq   #0,D3
02:0001E2FC 08010004        	  1810:     btst    #4,D1               ; Genesis B: TH=1 bit4 (active low) → NES A
02:0001E300 6604            	  1811:     bne.s   .cs_no_a
02:0001E302 08C30000        	  1812:     bset    #0,D3
                            	  1813: .cs_no_a:
02:0001E306 08020004        	  1814:     btst    #4,D2               ; Genesis A: TH=0 bit4 (active low) → NES B
02:0001E30A 6604            	  1815:     bne.s   .cs_no_b
02:0001E30C 08C30001        	  1816:     bset    #1,D3
                            	  1817: .cs_no_b:
                            	  1818:     ; Phase 2.3: Genesis C → NES Select remap.  The 3-button pad has no
                            	  1819:     ; hardware Select; the diary standardized on C so the user can
                            	  1820:     ; eliminate save slots in file-select and access the NES pause menu.
02:0001E310 08010005        	  1821:     btst    #5,D1               ; C button: TH=1 bit5 (active low)
02:0001E314 6604            	  1822:     bne.s   .cs_no_select
02:0001E316 08C30002        	  1823:     bset    #2,D3               ; NES Select
                            	  1824: .cs_no_select:
02:0001E31A 08020005        	  1825:     btst    #5,D2               ; Start: TH=0 bit5 (active low)
02:0001E31E 6604            	  1826:     bne.s   .cs_no_start
02:0001E320 08C30003        	  1827:     bset    #3,D3
                            	  1828: .cs_no_start:
02:0001E324 08010000        	  1829:     btst    #0,D1               ; Up: TH=1 bit0 (active low)
02:0001E328 6604            	  1830:     bne.s   .cs_no_up
02:0001E32A 08C30004        	  1831:     bset    #4,D3
                            	  1832: .cs_no_up:
02:0001E32E 08010001        	  1833:     btst    #1,D1               ; Down: TH=1 bit1 (active low)
02:0001E332 6604            	  1834:     bne.s   .cs_no_down
02:0001E334 08C30005        	  1835:     bset    #5,D3
                            	  1836: .cs_no_down:
02:0001E338 08010002        	  1837:     btst    #2,D1               ; Left: TH=1 bit2 (active low)
02:0001E33C 6604            	  1838:     bne.s   .cs_no_left
02:0001E33E 08C30006        	  1839:     bset    #6,D3
                            	  1840: .cs_no_left:
02:0001E342 08010003        	  1841:     btst    #3,D1               ; Right: TH=1 bit3 (active low)
02:0001E346 6604            	  1842:     bne.s   .cs_no_right
02:0001E348 08C30007        	  1843:     bset    #7,D3
                            	  1844: .cs_no_right:
02:0001E34C 19431100        	  1845:     move.b  D3,($1100,A4)       ; store latched NES button byte
02:0001E350 197C00001101    	  1846:     move.b  #0,($1101,A4)       ; reset serial index
02:0001E356 523900FF100A    	  1847:     addq.b  #1,($00FF100A).l    ; Phase 2.4: input-poll probe counter
02:0001E35C 4CDF000E        	  1848:     movem.l (SP)+,D1-D3
                            	  1849: .cs_skip:
02:0001E360 4E75            	  1850:     rts
                            	  1851: 
                            	  1852: ;------------------------------------------------------------------------------
                            	  1853: ; _ctrl_read_1 — $4016 read (T27).
                            	  1854: ;
                            	  1855: ; Returns the next button bit from the latch in D0.b (bit0 = button state,
                            	  1856: ; 1 = pressed).  Buttons are in NES order: A, B, Sel, Start, Up, Down, Left,
                            	  1857: ; Right (index 0–7).  Returns 0 when index overflows past 7.
                            	  1858: ;------------------------------------------------------------------------------
                            	  1859: _ctrl_read_1:
02:0001E362 7200            	  1860:     moveq   #0,D1
02:0001E364 122C1101        	  1861:     move.b  ($1101,A4),D1       ; D1.l = current index (zero-extended)
02:0001E368 0C010008        	  1862:     cmpi.b  #8,D1
02:0001E36C 6C12            	  1863:     bge.s   .cr1_overflow
02:0001E36E 522C1101        	  1864:     addq.b  #1,($1101,A4)       ; advance index for next read
02:0001E372 7000            	  1865:     moveq   #0,D0
02:0001E374 102C1100        	  1866:     move.b  ($1100,A4),D0       ; D0 = latched button byte
02:0001E378 E228            	  1867:     lsr.b   D1,D0               ; shift right by index → target bit in bit0
02:0001E37A 02000001        	  1868:     andi.b  #1,D0               ; isolate bit0
02:0001E37E 4E75            	  1869:     rts
                            	  1870: .cr1_overflow:
02:0001E380 7000            	  1871:     moveq   #0,D0
02:0001E382 4E75            	  1872:     rts
                            	  1873: 
                            	  1874: ;------------------------------------------------------------------------------
                            	  1875: ; _ctrl_read_2 — $4017 read: controller 2 / frame counter.
                            	  1876: ; Return 0.
                            	  1877: ;------------------------------------------------------------------------------
                            	  1878: _ctrl_read_2:
02:0001E384 7000            	  1879:     moveq   #0,D0
02:0001E386 4E75            	  1880:     rts
                            	  1881: 
                            	  1882: ;==============================================================================
                            	  1883: ; SRAM helpers (Phase 9.7)
                            	  1884: ;==============================================================================
                            	  1885: ;
                            	  1886: ; Genesis cartridges declare battery-backed SRAM in the ROM header at
                            	  1887: ; $1B0-$1BB.  We declare a 4 KB odd-byte SRAM region at $200001-$203FFF
                            	  1888: ; (genesis_shell.asm).  In gpgx and on real Mega Everdrive flashcarts the
                            	  1889: ; cart area at $200000 is shared between ROM and SRAM; writing $01 to the
                            	  1890: ; mapper port at $A130F1 swaps SRAM in.  Writing $00 swaps ROM back.
                            	  1891: ;
                            	  1892: ; Logical SRAM offset N (0 .. $1FFF) maps to bus address $200001 + (N << 1):
                            	  1893: ; only the odd byte of each word is wired up, hence the 8 KB cart-address
                            	  1894: ; window for 4 KB of usable storage.
                            	  1895: ;
                            	  1896: ; Helpers leave the mapping in the SRAM-enabled state after _sram_enable so
                            	  1897: ; the save-slot read/write helpers in 9.8 don't have to toggle the port on
                            	  1898: ; every byte.  Boot calls _sram_enable once from EntryPoint.
                            	  1899: ;------------------------------------------------------------------------------
                            	  1900: 
                            	  1901: SRAM_PORT       equ $A130F1
                            	  1902: SRAM_BASE_ODD   equ $200001
                            	  1903: 
                            	  1904: ;------------------------------------------------------------------------------
                            	  1905: ; P31: FileBChecksums — relocated from ROM code label to writable work RAM.
                            	  1906: ;
                            	  1907: ; On NES, this was a RAM variable holding 6 bytes (3 slots × 2-byte checksum).
                            	  1908: ; The transpiler incorrectly placed it as a code label inside z_01.asm, which
                            	  1909: ; maps to ROM on Genesis.  All writes silently fail on real hardware, breaking
                            	  1910: ; the File B → File A copy chain (checksums never match on re-read).
                            	  1911: ;
                            	  1912: ; $FF1200 is in the NES RAM mirror range ($0800-$1FFF) which is valid writable
                            	  1913: ; work RAM on Genesis but unused by any NES game code.
                            	  1914: ;------------------------------------------------------------------------------
                            	  1915: FileBChecksums  equ $00FF1200
                            	  1916: 
                            	  1917: ;------------------------------------------------------------------------------
                            	  1918: ; _sram_enable — switch cart area to SRAM mapping.  Clobbers nothing.
                            	  1919: ;------------------------------------------------------------------------------
                            	  1920: _sram_enable:
02:0001E388 13FC000100A130F1	  1921:     move.b  #$01,(SRAM_PORT).l
02:0001E390 4E75            	  1922:     rts
                            	  1923: 
                            	  1924: ;------------------------------------------------------------------------------
                            	  1925: ; _sram_disable — switch cart area back to ROM.  Used by tooling only;
                            	  1926: ; gameplay leaves SRAM mapped in continuously.
                            	  1927: ;------------------------------------------------------------------------------
                            	  1928: _sram_disable:
02:0001E392 13FC000000A130F1	  1929:     move.b  #$00,(SRAM_PORT).l
02:0001E39A 4E75            	  1930:     rts
                            	  1931: 
                            	  1932: ;------------------------------------------------------------------------------
                            	  1933: ; _sram_read_byte — read one byte from logical SRAM offset.
                            	  1934: ; In:  D0.w = offset (0 .. $1FFF)
                            	  1935: ; Out: D0.b = byte
                            	  1936: ;------------------------------------------------------------------------------
                            	  1937: _sram_read_byte:
02:0001E39C 48E70080        	  1938:     movem.l A0,-(SP)
02:0001E3A0 028000001FFF    	  1939:     andi.l  #$00001FFF,D0
02:0001E3A6 D080            	  1940:     add.l   D0,D0                       ; offset *= 2 (odd-byte stride)
02:0001E3A8 207C00200001    	  1941:     movea.l #SRAM_BASE_ODD,A0
02:0001E3AE 10300800        	  1942:     move.b  (A0,D0.L),D0
02:0001E3B2 205F            	  1943:     movem.l (SP)+,A0
02:0001E3B4 4E75            	  1944:     rts
                            	  1945: 
                            	  1946: ;------------------------------------------------------------------------------
                            	  1947: ; _sram_write_byte — write one byte to logical SRAM offset.
                            	  1948: ; In:  D0.w = offset (0 .. $1FFF)
                            	  1949: ;      D1.b = byte to store
                            	  1950: ;------------------------------------------------------------------------------
                            	  1951: _sram_write_byte:
02:0001E3B6 48E78080        	  1952:     movem.l A0/D0,-(SP)
02:0001E3BA 028000001FFF    	  1953:     andi.l  #$00001FFF,D0
02:0001E3C0 D080            	  1954:     add.l   D0,D0                       ; offset *= 2 (odd-byte stride)
02:0001E3C2 207C00200001    	  1955:     movea.l #SRAM_BASE_ODD,A0
02:0001E3C8 11810800        	  1956:     move.b  D1,(A0,D0.L)
02:0001E3CC 4CDF0101        	  1957:     movem.l (SP)+,A0/D0
02:0001E3D0 4E75            	  1958:     rts
                            	  1959: 
                            	  1960: ;------------------------------------------------------------------------------
                            	  1961: ; Phase 9.8 — bulk save-slot copy helpers.
                            	  1962: ;
                            	  1963: ; NES Zelda's three save slots live at NES $6000-$67FF (2 KB), which the
                            	  1964: ; shell mirrors at work RAM $FF6000-$FF67FF.  z_02 reads/writes go to that
                            	  1965: ; mirror via NES_SRAM equ $FF6000.  To make saves persist across power
                            	  1966: ; cycles we copy:
                            	  1967: ;   _sram_load_save_slots    cart SRAM → mirror   (called once at boot)
                            	  1968: ;   _sram_commit_save_slots  mirror   → cart SRAM (called from save funnel)
                            	  1969: ;
                            	  1970: ; Cart SRAM is odd-byte at $200001 with stride 2; logical offset N (0..$7FF)
                            	  1971: ; lands at bus $200001 + N*2.
                            	  1972: ;
                            	  1973: ; Both helpers preserve all caller registers.
                            	  1974: ;------------------------------------------------------------------------------
                            	  1975: _sram_load_save_slots:
02:0001E3D2 48E7C0C0        	  1976:     movem.l D0/D1/A0/A1,-(SP)
02:0001E3D6 207C00FF6000    	  1977:     movea.l #$00FF6000,A0               ; mirror destination
02:0001E3DC 227C00200001    	  1978:     movea.l #SRAM_BASE_ODD,A1           ; cart SRAM source ($200001)
02:0001E3E2 323C07FF        	  1979:     move.w  #$07FF,D1                   ; 2048 bytes - 1
                            	  1980: .lsl_loop:
02:0001E3E6 1011            	  1981:     move.b  (A1),D0
02:0001E3E8 10C0            	  1982:     move.b  D0,(A0)+
02:0001E3EA 5489            	  1983:     addq.l  #2,A1                       ; advance odd-byte stride
02:0001E3EC 51C9FFF8        	  1984:     dbra    D1,.lsl_loop
                            	  1985:     ; T36: Zero-fill the remainder of the NES SRAM window ($FF6800..$FF7FFF).
                            	  1986:     ; NES has 8 KB of SRAM at $6000-$7FFF but Zelda's save-slots only occupy
                            	  1987:     ; the first 2 KB ($6000-$67FF).  z_05 AssignObjSpawnPositions reads
                            	  1988:     ; SRAM[$08FE+$00EB] which can land past offset $7FF (e.g. $FF6975 for
                            	  1989:     ; OW room $77).  On NES those bytes read 0 (unmapped or cleared by
                            	  1990:     ; ROM init).  Without this zero-fill, the read hits work-RAM residue
                            	  1991:     ; and corrupts the cave-dweller type calculation ($0350 := $6A+idx),
                            	  1992:     ; spawning a phantom cave-person that halts Link via $00AC=$40.
                            	  1993:     ; A0 already points at $FF6800 after the slot copy.
02:0001E3F0 323C17FF        	  1994:     move.w  #$17FF,D1                   ; 6144 bytes - 1 ($6800..$7FFF)
02:0001E3F4 7000            	  1995:     moveq   #0,D0
                            	  1996: .lsl_zero:
02:0001E3F6 10C0            	  1997:     move.b  D0,(A0)+
02:0001E3F8 51C9FFFC        	  1998:     dbra    D1,.lsl_zero
02:0001E3FC 4CDF0303        	  1999:     movem.l (SP)+,D0/D1/A0/A1
02:0001E400 4E75            	  2000:     rts
                            	  2001: 
                            	  2002: _sram_commit_save_slots:
02:0001E402 48E7C0C0        	  2003:     movem.l D0/D1/A0/A1,-(SP)
02:0001E406 207C00FF6000    	  2004:     movea.l #$00FF6000,A0               ; mirror source
02:0001E40C 227C00200001    	  2005:     movea.l #SRAM_BASE_ODD,A1           ; cart SRAM destination
02:0001E412 323C07FF        	  2006:     move.w  #$07FF,D1                   ; 2048 bytes - 1
                            	  2007: .csl_loop:
02:0001E416 1018            	  2008:     move.b  (A0)+,D0
02:0001E418 1280            	  2009:     move.b  D0,(A1)
02:0001E41A 5489            	  2010:     addq.l  #2,A1
02:0001E41C 51C9FFF8        	  2011:     dbra    D1,.csl_loop
02:0001E420 4CDF0303        	  2012:     movem.l (SP)+,D0/D1/A0/A1
02:0001E424 4E75            	  2013:     rts
                            	  2014: 
                            	  2015: ;==============================================================================
                            	  2016: ; OAM DMA
                            	  2017: ;==============================================================================
                            	  2018: 
                            	  2019: ;------------------------------------------------------------------------------
                            	  2020: ; _oam_dma — $4014 write: OAM DMA transfer.
                            	  2021: ;
                            	  2022: ; On NES, writing page number P to $4014 copies 256 bytes from CPU page P
                            	  2023: ; ($PP00–$PPFF) to OAM.  Zelda writes #$02, meaning copy from $0200–$02FF.
                            	  2024: ; NES $0200–$02FF = Genesis $FF0200–$FF02FF.
                            	  2025: ;
                            	  2026: ; T23: Convert 64 NES OAM entries → 64 Genesis SAT entries, write to VRAM $D800.
                            	  2027: ;
                            	  2028: ; NES OAM entry layout (4 bytes, address is OAM byte index):
                            	  2029: ;   [0] Y position (sprite top − 1; visible on scanline Y+1)
                            	  2030: ;   [1] Tile index (0–255, pattern table determined by PPUCTRL bit 3)
                            	  2031: ;   [2] Attribute: bit7=Vflip, bit6=Hflip, bit5=behind-BG, bits1:0=sprite palette
                            	  2032: ;   [3] X position (sprite left edge, 0–255)
                            	  2033: ;
                            	  2034: ; Genesis SAT entry layout (8 bytes at VRAM $D800 + sprite*8):
                            	  2035: ;   Word 0 [bits 8:0]: Y position (=NES_Y+129 for 240-line; 128=top of screen)
                            	  2036: ;   Word 1 [bits 11:8]: size (00=8×8 px); [bits 6:0]: link to next sprite index
                            	  2037: ;   Word 2: tile word → bit15=priority, bits14:13=palette, bit12=Vflip, bit11=Hflip,
                            	  2038: ;                        bits10:0=tile index
                            	  2039: ;   Word 3 [bits 8:0]: X position (=NES_X+128; 128=left of screen)
                            	  2040: ;
                            	  2041: ; Sprite palette mapping: NES sprite palette 0–3 → Genesis palette 0–3 directly.
                            	  2042: ;   (T25 will map NES sprite palettes to CRAM entries 32–63 = Genesis palettes 2–3.)
                            	  2043: ; Priority: bit15 = 1 (sprites always above background planes).
                            	  2044: ; Off-screen: NES Y+129 ≥ 368 means off-screen naturally; no special case needed.
                            	  2045: ;------------------------------------------------------------------------------
                            	  2046: _oam_dma:
                            	  2047:     ifne CHR_EXPANSION_ENABLED
02:0001E426 48E7FFE0        	  2048:     movem.l D0-D7/A0-A2,-(SP)
                            	  2049:     else
                            	  2050:     movem.l D0-D7/A0/A2,-(SP)
                            	  2051:     endc
                            	  2052: 
                            	  2053:     ; VSRAM scroll is now driven by _apply_genesis_scroll in IsrNmi.
                            	  2054:     ; The old static 8px bias has been removed.
                            	  2055: 
                            	  2056:     ; Phase 1 (HW adoption): write into SAT_SHADOW bank instead of VDP data
                            	  2057:     ; port.  DMA from the same bank happens at the top of the NEXT frame's
                            	  2058:     ; VBlankISR via _oam_dma_flush.  One-frame OAM display latency.
02:0001E42A 45F900FF2000    	  2059:     lea     (SAT_SHADOW_A).l,A2
02:0001E430 4A3900FF2400    	  2060:     tst.b   (SAT_ACTIVE_BANK).l
02:0001E436 6706            	  2061:     beq.s   .sat_bank_picked
02:0001E438 45F900FF2200    	  2062:     lea     (SAT_SHADOW_B).l,A2
                            	  2063: .sat_bank_picked:
                            	  2064: 
02:0001E43E 41F900FF0200    	  2065:     lea     (NES_RAM_BASE+$0200).l,A0  ; A0 → NES OAM buffer ($FF0200)
02:0001E444 7E3F            	  2066:     moveq   #63,D7                     ; loop: 64 sprites (dbra counts 63→0)
02:0001E446 7C00            	  2067:     moveq   #0,D6                      ; D6 = current sprite index (0..63)
                            	  2068:     ; V64 gap compensation: when the display wraps through the 32px gap
                            	  2069:     ; at pixels 480-511, BG content below the gap is shifted 32px down.
                            	  2070:     ; Compute the Genesis Y threshold: sprites at or below this line need
                            	  2071:     ; +32 to match their shifted BG text.  Store in D6 upper word (0=no gap).
02:0001E448 3A3900FF0838    	  2072:     move.w  (ACTIVE_EVENT_VSRAM).l,D5
02:0001E44E 064500E0        	  2073:     addi.w  #224,D5
02:0001E452 0C450200        	  2074:     cmpi.w  #512,D5
02:0001E456 6310            	  2075:     bls.s   .oam_no_gap_setup          ; display doesn't wrap through gap
02:0001E458 3A3C0260        	  2076:     move.w  #608,D5                    ; 608 = 480 (gap start) + 128 (Y origin)
02:0001E45C 9A7900FF0838    	  2077:     sub.w   (ACTIVE_EVENT_VSRAM).l,D5  ; D5 = gap threshold in Genesis Y
02:0001E462 4846            	  2078:     swap    D6
02:0001E464 3C05            	  2079:     move.w  D5,D6
02:0001E466 4846            	  2080:     swap    D6
                            	  2081: .oam_no_gap_setup:
                            	  2082: 
                            	  2083: .oam_loop:
                            	  2084:     ; ── Read 4 NES OAM bytes ────────────────────────────�
02:0001E468 7000            	  2085:     moveq   #0,D0
02:0001E46A 1018            	  2086:     move.b  (A0)+,D0            ; D0.w = NES Y (sprite top − 1)
02:0001E46C 7200            	  2087:     moveq   #0,D1
02:0001E46E 1218            	  2088:     move.b  (A0)+,D1            ; D1.w = tile index
02:0001E470 7400            	  2089:     moveq   #0,D2
02:0001E472 1418            	  2090:     move.b  (A0)+,D2            ; D2.w = attribute byte
02:0001E474 7600            	  2091:     moveq   #0,D3
02:0001E476 1618            	  2092:     move.b  (A0)+,D3            ; D3.w = NES X
                            	  2093: 
                            	  2094:     ; ── Word 0: Genesis Y ─────────────────────────────�
                            	  2095:     ; NES sprite is visible on scanline (NES_Y + 1).
                            	  2096:     ; Genesis 240-line: screen line 0 is at Y=128 → Genesis Y = 128 + screen_line
                            	  2097:     ;   = 128 + (NES_Y + 1) = NES_Y + 129
                            	  2098:     ; Sprites with NES_Y ≥ 239 produce Genesis Y ≥ 368 which is naturally off-screen.
02:0001E478 3800            	  2099:     move.w  D0,D4
02:0001E47A 06440081        	  2100:     addi.w  #129,D4
                            	  2101:     ; Phase 12: _ags_compute_stage adds +8 to VSRAM for overscan in ALL
                            	  2102:     ; modes.  This shifts the BG up 8px.  Sprites must compensate with a
                            	  2103:     ; matching -8 Y lift, otherwise they appear 8px too low relative to
                            	  2104:     ; background text/tiles.  Previously gated to Mode 0 only (Diary #26),
                            	  2105:     ; but fs2_probe confirmed VSRAM=8 during file-select, proving the lift
                            	  2106:     ; must be unconditional.
02:0001E47E 0C000008        	  2107:     cmpi.b  #8,D0
02:0001E482 6502            	  2108:     bcs.s   .oam_gap_check          ; NES Y < 8 → skip lift (top-edge)
02:0001E484 5144            	  2109:     subi.w  #8,D4
                            	  2110: .oam_gap_check:
02:0001E486 4846            	  2111:     swap    D6                      ; access gap threshold from upper word
02:0001E488 4A46            	  2112:     tst.w   D6
02:0001E48A 6712            	  2113:     beq.s   .oam_gap_done           ; 0 = no gap visible
                            	  2114:     ; Gradual ramp: offset = clamp(sprite_Y - gap_top + 1, 0, 32).
                            	  2115:     ; Sprites well above the gap get 0 (untouched); sprites crossing the gap
                            	  2116:     ; boundary ramp in at 1px/frame up to a max +32 shift to match the shifted
                            	  2117:     ; BG below the V64 dead zone.  Avoids the single-frame 32px teleport that
                            	  2118:     ; occurred with a hard threshold.  D0 is scratch here — it's reloaded at
                            	  2119:     ; the top of the next .oam_loop iteration.
02:0001E48C 3004            	  2120:     move.w  D4,D0                   ; D0 = adjusted sprite Y
02:0001E48E 9046            	  2121:     sub.w   D6,D0                   ; D0 = Y - gap_top
02:0001E490 5240            	  2122:     addq.w  #1,D0                   ; D0 = Y - gap_top + 1
02:0001E492 6F0A            	  2123:     ble.s   .oam_gap_done           ; <= 0: sprite above gap, no offset
02:0001E494 0C400020        	  2124:     cmpi.w  #32,D0
02:0001E498 6302            	  2125:     bls.s   .oam_gap_apply
02:0001E49A 7020            	  2126:     moveq   #32,D0                  ; cap ramp at full 32px shift
                            	  2127: .oam_gap_apply:
02:0001E49C D840            	  2128:     add.w   D0,D4                   ; apply gradual offset
                            	  2129: .oam_gap_done:
02:0001E49E 4846            	  2130:     swap    D6                      ; restore sprite index in low word
                            	  2131: .oam_write_y:
02:0001E4A0 34C4            	  2132:     move.w  D4,(A2)+                ; Phase 1: SAT_SHADOW write (was VDP_DATA)
                            	  2133: 
                            	  2134:     ; ── Word 1: size | link ────────────────────────────�
                            	  2135:     ; Link field: chain sprites 0→1→2→...→63→0
02:0001E4A2 3806            	  2136:     move.w  D6,D4
02:0001E4A4 5244            	  2137:     addq.w  #1,D4               ; D4 = this_sprite_index + 1
02:0001E4A6 0C440040        	  2138:     cmpi.w  #64,D4              ; is this the last sprite?
02:0001E4AA 6602            	  2139:     bne     .write_link
02:0001E4AC 7800            	  2140:     moveq   #0,D4               ; yes → link = 0 (terminate list)
                            	  2141: .write_link:
                            	  2142:     ; Size: check PPUCTRL bit 5 for 8×16 sprite mode
                            	  2143:     ; Genesis SAT word 1: [11:10]=H-size, [9:8]=V-size, [6:0]=link
02:0001E4AE 0839000500FF0804	  2144:     btst    #5,(PPU_CTRL).l
02:0001E4B6 6704            	  2145:     beq.s   .oam_size_done
02:0001E4B8 00440100        	  2146:     ori.w   #$0100,D4           ; V-size = 2 (8×16: two 8×8 cells stacked)
                            	  2147: .oam_size_done:
02:0001E4BC 34C4            	  2148:     move.w  D4,(A2)+            ; Phase 1: SAT_SHADOW write size | link
                            	  2149: 
                            	  2150:     ; ── Word 2: tile word (priority | palette | Vflip | Hflip | tile) ────
                            	  2151:     ; Compute Genesis tile index based on sprite size mode
02:0001E4BE 0839000500FF0804	  2152:     btst    #5,(PPU_CTRL).l
02:0001E4C6 6712            	  2153:     beq.s   .oam_8x8
                            	  2154:     ; 8×16 mode: tile byte bit 0 = pattern table, bits 7:1 = tile pair
02:0001E4C8 3A01            	  2155:     move.w  D1,D5
02:0001E4CA 02450001        	  2156:     andi.w  #$0001,D5           ; pattern table bit
02:0001E4CE E14D            	  2157:     lsl.w   #8,D5               ; $0000 or $0100
02:0001E4D0 3801            	  2158:     move.w  D1,D4
02:0001E4D2 024400FE        	  2159:     andi.w  #$00FE,D4           ; tile pair (even tile number)
02:0001E4D6 8A44            	  2160:     or.w    D4,D5               ; Genesis tile index
