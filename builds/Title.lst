02:000337E8 B0              	  5906:     dc.b    $B0, $74, $94, $B4, $70, $68, $F4, $24
02:000337E9 74
02:000337EA 94
02:000337EB B4
02:000337EC 70
02:000337ED 68
02:000337EE F4
02:000337EF 24
