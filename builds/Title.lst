                            	  2133: 
                            	  2134: ; PATCH P13: ModeE_SyncCharBoardCursorToIndex (Attempt 6a part 2).
                            	  2135: ; Source-of-truth sync for the char board cursor.  Normalizes
                            	  2136: ; CharBoardIndex ($041F) mod 44, snaps the hidden slot (idx 43)
                            	  2137: ; to idx 9, and regenerates (ObjX=$0071, ObjY=$0085) from the
                            	  2138: ; index using row = idx/11, col = idx%11, ObjX = $30+col*$10,
                            	  2139: ; ObjY = $87+row*$10.  Call this after any direction move.
                            	  2140:     even
                            	  2141: ModeE_SyncCharBoardCursorToIndex:
02:00026FA0 600083A8        	  2142:     jmp     c_mode_e_sync_char_board_cursor
                            	  2143: 
                            	  2144: ModeE_HandleAOrB:
02:00026FA4 102C0420        	  2145:     move.b  ($0420,A4),D0
                            	  2146:     ; If InitializedNameField [$0420] is set, then skip initializing
                            	  2147:     ; the name field.
02:00026FA8 6646            	  2148:     bne  _L_z02_ModeE_HandleAOrB_CheckAB
02:00026FAA 7600            	  2149:     moveq   #0,D3
02:00026FAC 162C0016        	  2150:     move.b  ($0016,A4),D3
02:00026FB0 0C030003        	  2151:     cmpi.b  #$03,D3
02:00026FB4 6602            	  2152:     bne.s  __far_z_02_0002
02:00026FB6 60E6            	  2153:     jmp  LA10A_Exit
                            	  2154: __far_z_02_0002:
                            	  2155:     ; Set NameCharOffset [$0421] to the offset of first char
                            	  2156:     ; in the current slot's name.
02:00026FB8 41F9000269CC    	  2157:     lea     (SlotToNameOffset).l,A0
02:00026FBE 10303000        	  2158:     move.b  (A0,D3.W),D0
02:00026FC2 19400421        	  2159:     move.b  D0,($0421,A4)
                            	  2160:     ; Get the offset of the end of the initial name character
                            	  2161:     ; transfer record header for the current slot.
02:00026FC6 7400            	  2162:     moveq   #0,D2
02:00026FC8 41F9000269D0    	  2163:     lea     (SlotToInitialNameCharTransferHeaderEndOffsets).l,A0
02:00026FCE 14303000        	  2164:     move.b  (A0,D3.W),D2
02:00026FD2 7602            	  2165:     moveq   #2,D3
                            	  2166:     even
                            	  2167: _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate:
02:00026FD4 41F90002699C    	  2168:     lea     (SlotToInitialNameCharTransferHeaders).l,A0
02:00026FDA 10302000        	  2169:     move.b  (A0,D2.W),D0
02:00026FDE 41EC0422        	  2170:     lea     ($0422,A4),A0
02:00026FE2 11803000        	  2171:     move.b  D0,(A0,D3.W)
02:00026FE6 5302            	  2172:     subq.b  #1,D2
02:00026FE8 5303            	  2173:     subq.b  #1,D3
02:00026FEA 6AE8            	  2174:     bpl  _L_z02_ModeE_HandleAOrB_CopyHeaderTemplate
02:00026FEC 522C0420        	  2175:     addq.b  #1,($0420,A4)
                            	  2176:     even
                            	  2177: _L_z02_ModeE_HandleAOrB_CheckAB:
                            	  2178:     ; At this point:
                            	  2179:     ; - NameCharOffset [$0421] holds the offset of the first character in the save slot info name for the current slot.
                            	  2180:     ;   - This will be changed as the player inputs characters.
                            	  2181:     ; - [$0422] to [$0424] hold a transfer record header. The VRAM address points to the beginning of the appropriate n
                            	  2182:     ;   - This will be changed as the player inputs characters.
                            	  2183:     ; - InitializedNameField [$0420] is set to 1.
                            	  2184:     ;
02:00026FF0 102C00F8        	  2185:     move.b  ($00F8,A4),D0
02:00026FF4 020000C0        	  2186:     andi.b #$C0,D0
02:00026FF8 670000E8        	  2187:     beq  _L_z02_ModeE_HandleAOrB_Exit
                            	  2188:     ; A or B was pressed.
                            	  2189:     ;
02:00026FFC 0C000040        	  2190:     cmpi.b  #$40,D0  ; PATCH P29: swap so NES-B (Gen A) = write, NES-A (Gen B) = bksp
