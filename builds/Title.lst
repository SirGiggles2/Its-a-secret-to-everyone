                            	  8922:     ; - other: bomb
                            	  8923:     ;
02:0002F94A 700F            	  8924:     moveq   #15,D0
02:0002F94C 7600            	  8925:     moveq   #0,D3
02:0002F94E 162C0051        	  8926:     move.b  ($0051,A4),D3
02:0002F952 6702            	  8927:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
02:0002F954 7000            	  8928:     moveq   #0,D0
                            	  8929:     even
