02:00033460 1B00            	  5411:     move.b  D0,-(A5)  ; PHA
02:00033462 7400            	  5412:     moveq   #0,D2
02:00033464 1400            	  5413:     move.b  D0,D2
                            	  5414:     ; For each row (2 or 3) in the door, indexed by X,
                            	  5415:     ; starting from highest index down to 0:
                            	  5416:     ;
02:00033466 41F900033354    	  5417:     lea     (DirIndexToDoorRowCountMinusOne).l,A0
02:0003346C 10302000        	  5418:     move.b  (A0,D2.W),D0
02:00033470 7400            	  5419:     moveq   #0,D2
