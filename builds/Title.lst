02:0003C086 11803000        	  5530:     move.b  D0,(A0,D3.W)
02:0003C08A 0A3C0001        	  5531:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0003C08E 4E75            	  5532:     rts
                            	  5533: 
                            	  5534:     even
