02:0002F768 41EC00AC        	  8667:     lea     ($00AC,A4),A0
02:0002F76C 10303000        	  8668:     move.b  (A0,D3.W),D0
02:0002F770 0C000010        	  8669:     cmpi.b  #$10,D0
02:0002F774 66DE            	  8670:     bne  _L_z04_Ganon_CheckCollisions_Exit
                            	  8671:     ; Check for collision with an arrow; and return if no collision.
