                            	   706: 
                            	   707: ;==============================================================================
                            	   708: ; Zelda translated code — generated by tools/transpile_6502.py --all --no-stubs
                            	   709: ;
                            	   710: ; z_07.asm is the NES fixed bank ($E000-$FFFF): IsrReset, IsrNmi, RunGame,
                            	   711: ; and ALL shared equates (NES RAM variables).  It must be included first.
                            	   712: ;
                            	   713: ; z_00–z_06 are the switchable PRG banks.  They carry no equate block in
                            	   714: ; --all mode (suppressed by transpiler to avoid vasm duplicate-symbol errors).
                            	   715: ; All cross-bank import stubs are also suppressed — every symbol resolves
                            	   716: ; directly by label across the flat Genesis ROM.
                            	   717: ;
                            	   718: ; vasm CWD is src/ (set by build.bat pushd), so paths are relative to src/.
                            	   719: ;==============================================================================
                            	   720:     ; All 8 banks included in ascending order (z_00 first so its definitions of
                            	   721:     ; multiply-exported symbols like Exit are canonical).  z_07 is included last
                            	   722:     ; so its cross-bank stubs (which are suppressed for globally-exported symbols)
                            	   723:     ; don't conflict with real definitions from z_00-z_06.
                            	   724:     ; Equates are only in z_07 (other banks omit them in --all mode).
                            	   725:     include "zelda_translated/z_00.asm"

