                            	  3653:     ; Set the spawn cell to the one we found.
                            	  3654:     ;
02:00031D48 102C000A        	  3655:     move.b  ($000A,A4),D0
02:00031D4C 19400525        	  3656:     move.b  D0,($0525,A4)
02:00031D50 4E75            	  3657:     rts
