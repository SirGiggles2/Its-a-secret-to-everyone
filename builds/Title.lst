                            	  2643: UpdateRockOrGravestone:
02:0002CAC6 41EC00AC        	  2644:     lea     ($00AC,A4),A0
02:0002CACA 10302000        	  2645:     move.b  (A0,D2.W),D0
02:0002CACE 660000AA        	  2646:     bne  _L_z04_UpdateRockOrGravestone_State1
                            	  2647:     ; State 0.
                            	  2648:     ;
                            	  2649:     ; If this is not a gravestone (but it's a rock), and there is no
                            	  2650:     ; bracelet, then return.
                            	  2651:     ;
02:0002CAD2 41EC034F        	  2652:     lea     ($034F,A4),A0
02:0002CAD6 10302000        	  2653:     move.b  (A0,D2.W),D0
02:0002CADA 0C000065        	  2654:     cmpi.b  #$65,D0
02:0002CADE 6708            	  2655:     beq  _L_z04_UpdateRockOrGravestone_CheckQuest
02:0002CAE0 102C0665        	  2656:     move.b  ($0665,A4),D0
02:0002CAE4 67000092        	  2657:     beq  _L_z04_UpdateRockOrGravestone_Exit
                            	  2658:     even
                            	  2659: _L_z04_UpdateRockOrGravestone_CheckQuest:
                            	  2660:     ; If there is a mismatch between the current quest and the quest
                            	  2661:     ; needed for the secret in this room, then return.
                            	  2662:     ;
02:0002CAE8 6100021C        	  2663:     jsr     IsQuestSecretMismatch
02:0002CAEC 6500008A        	  2664:     bcs  _L_z04_UpdateRockOrGravestone_Exit
                            	  2665:     ; The gravestone and rocks can only be pushed vertically.
                            	  2666:     ; Return, if X's don't match.
                            	  2667:     ;
02:0002CAF0 102C0070        	  2668:     move.b  ($0070,A4),D0
02:0002CAF4 12342070        	  2669:     move.b  ($70,A4,D2.W),D1
02:0002CAF8 B001            	  2670:     cmp.b   D1,D0
02:0002CAFA 667C            	  2671:     bne  _L_z04_UpdateRockOrGravestone_Exit
                            	  2672:     ; If the difference between Link's (Y + 3) and the block's Y
                            	  2673:     ; is positive; then go use it along with a flag that indicates that
                            	  2674:     ; Link is "down" from the object.
                            	  2675:     ;
02:0002CAFC 7600            	  2676:     moveq   #0,D3
02:0002CAFE 102C0084        	  2677:     move.b  ($0084,A4),D0
02:0002CB02 023C00EE        	  2678:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002CB06 123C0003        	  2679:     move.b  #$03,D1
02:0002CB0A D101            	  2680:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
02:0002CB0C 003C0011        	  2681:     ori     #$11,CCR  ; SEC: set C+X
02:0002CB10 41EC0084        	  2682:     lea     ($0084,A4),A0
02:0002CB14 12302000        	  2683:     move.b  (A0,D2.W),D1
02:0002CB18 0A3C0010        	  2684:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002CB1C 9101            	  2685:     subx.b  D1,D0   ; SBC ObjY,X
02:0002CB1E 0A3C0010        	  2686:     eori    #$10,CCR  ; restore X = 6502 C
02:0002CB22 6A0E            	  2687:     bpl  _L_z04_UpdateRockOrGravestone_CheckDistance
                            	  2688:     ; Else negate it, and indicate Link is "up" from the object.
                            	  2689:     ;
02:0002CB24 5203            	  2690:     addq.b  #1,D3
02:0002CB26 4600            	  2691:     eori.b #$FF,D0
02:0002CB28 023C00EE        	  2692:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002CB2C 123C0001        	  2693:     move.b  #$01,D1
02:0002CB30 D101            	  2694:     addx.b  D1,D0   ; ADC #$01 (X flag = 6502 C)
                            	  2695:     even
                            	  2696: _L_z04_UpdateRockOrGravestone_CheckDistance:
                            	  2697:     ; If the distance >= $11, return.
                            	  2698:     ;
