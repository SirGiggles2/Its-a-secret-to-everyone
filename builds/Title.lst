02:0002DD90 41EC03E4        	  5203:     lea     ($03E4,A4),A0
02:0002DD94 16302000        	  5204:     move.b  (A0,D2.W),D3
02:0002DD98 671E            	  5205:     beq  _anon_z04_95
02:0002DD9A 023C00EE        	  5206:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DD9E 123C0003        	  5207:     move.b  #$03,D1
02:0002DDA2 D101            	  5208:     addx.b  D1,D0   ; ADC #$03 (X flag = 6502 C)
                            	  5209:     ; Also if movement frame = 1, and facing up, then flip horizontally.
                            	  5210:     ;
                            	  5211:     ; Down has two frame images, but up only has one. By flipping
                            	  5212:     ; horizontally, you get two frame images.
                            	  5213:     ;
02:0002DDA4 7600            	  5214:     moveq   #0,D3
02:0002DDA6 41EC0098        	  5215:     lea     ($0098,A4),A0
02:0002DDAA 16302000        	  5216:     move.b  (A0,D2.W),D3
02:0002DDAE 0C030008        	  5217:     cmpi.b  #$08,D3
