                            	  4600: UpdateMode13WinGame_Sub3:
                            	  4601:     ; After scrolling 8 pixels, draw another tile row.
                            	  4602:     ;
02:0002887C 102C050B        	  4603:     move.b  ($050B,A4),D0
02:00028880 0C000008        	  4604:     cmpi.b  #$08,D0
02:00028884 6B1A            	  4605:     bmi  _anon_z02_37
02:00028886 102C050B        	  4606:     move.b  ($050B,A4),D0
02:0002888A 123C0008        	  4607:     move.b  #$08,D1
02:0002888E 0A3C0010        	  4608:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00028892 9101            	  4609:     subx.b  D1,D0   ; SBC #$08
02:00028894 0A3C0010        	  4610:     eori    #$10,CCR  ; restore X = 6502 C
02:00028898 1940050B        	  4611:     move.b  D0,($050B,A4)
02:0002889C 61000282        	  4612:     jsr     DrawCredits
                            	  4613: _anon_z02_37:
                            	  4614:     ; Add $80 to the scroll speed fraction.
                            	  4615:     ;
02:000288A0 102C0058        	  4616:     move.b  ($0058,A4),D0
02:000288A4 023C00EE        	  4617:     andi    #$EE,CCR  ; CLC: clear C+X
02:000288A8 123C0080        	  4618:     move.b  #$80,D1
02:000288AC D101            	  4619:     addx.b  D1,D0   ; ADC #$80 (X flag = 6502 C)
02:000288AE 19400058        	  4620:     move.b  D0,($0058,A4)
                            	  4621:     ; Carry over to the tile offset and current V-scroll.
                            	  4622:     ;
02:000288B2 6404            	  4623:     bcc  _anon_z02_38
02:000288B4 522C050B        	  4624:     addq.b  #1,($050B,A4)
                            	  4625: _anon_z02_38:
02:000288B8 102C00FC        	  4626:     move.b  ($00FC,A4),D0
02:000288BC 123C0000        	  4627:     move.b  #$00,D1
02:000288C0 D101            	  4628:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:000288C2 194000FC        	  4629:     move.b  D0,($00FC,A4)
                            	  4630:     ; If we've reached the bottom of a nametable, then
                            	  4631:     ; roll over current V-scroll to 0, and increase number of
                            	  4632:     ; screens scrolled.
                            	  4633:     ;
02:000288C6 0C0000F0        	  4634:     cmpi.b  #$F0,D0
02:000288CA 7000            	  4635:     moveq   #0,D0
02:000288CC 6508            	  4636:     bcs  _anon_z02_39
02:000288CE 194000FC        	  4637:     move.b  D0,($00FC,A4)
02:000288D2 522C00E2        	  4638:     addq.b  #1,($00E2,A4)
                            	  4639: _anon_z02_39:
                            	  4640:     ; Roll the carry from the comparison above into bit 0.
                            	  4641:     ; So, if reached the bottom of a nametable, switch nametables.
                            	  4642:     ;
02:000288D6 E310            	  4643:     roxl.b  #1,D0   ; ROL A
02:000288D8 1940005C        	  4644:     move.b  D0,($005C,A4)
                            	  4645:     ; Put the quest number in Y register.
                            	  4646:     ;
02:000288DC 7600            	  4647:     moveq   #0,D3
02:000288DE 7400            	  4648:     moveq   #0,D2
02:000288E0 142C0016        	  4649:     move.b  ($0016,A4),D2
02:000288E4 41EC062D        	  4650:     lea     ($062D,A4),A0
02:000288E8 10302000        	  4651:     move.b  (A0,D2.W),D0
02:000288EC 6702            	  4652:     beq  _anon_z02_40
02:000288EE 5203            	  4653:     addq.b  #1,D3
                            	  4654: _anon_z02_40:
                            	  4655:     ; If we're not showing the last screen, then return.
                            	  4656:     ;
