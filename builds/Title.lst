02:00031A50 E308            	  3180:     lsl.b  #1,D0   ; ASL A
02:00031A52 E308            	  3181:     lsl.b  #1,D0   ; ASL A
02:00031A54 E308            	  3182:     lsl.b  #1,D0   ; ASL A
