02:0003C132 11802000        	  5613:     move.b  D0,(A0,D2.W)
02:0003C136 41EC00AC        	  5614:     lea     ($00AC,A4),A0
02:0003C13A 52302000        	  5615:     addq.b  #1,(A0,D2.W)
02:0003C13E 41EC00AC        	  5616:     lea     ($00AC,A4),A0
02:0003C142 10302000        	  5617:     move.b  (A0,D2.W),D0
