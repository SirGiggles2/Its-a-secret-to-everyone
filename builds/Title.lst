02:0002DE4A 41EC0084        	  5302:     lea     ($0084,A4),A0
02:0002DE4E 11802000        	  5303:     move.b  D0,(A0,D2.W)
                            	  5304:     even
                            	  5305: _L_z04_UpdatePolsVoice_CheckWalkability:
                            	  5306:     ; If the square the monster is over is walkable, then
                            	  5307:     ; go draw and check object collisions.
                            	  5308:     ;
02:0002DE52 610001F4        	  5309:     jsr     PolsVoice_IsSquareWalkable
02:0002DE56 6452            	  5310:     bcc  _L_z04_UpdatePolsVoice_DrawAndCheckCollisions
                            	  5311:     ; If the unwalkable tile is a block, or >= $F4 (water, screen edge bricks),
                            	  5312:     ; then go change to state 1.
                            	  5313:     ;
02:0002DE58 41EC041F        	  5314:     lea     ($041F,A4),A0
02:0002DE5C 10302000        	  5315:     move.b  (A0,D2.W),D0
02:0002DE60 020000FC        	  5316:     andi.b #$FC,D0
02:0002DE64 0C0000B0        	  5317:     cmpi.b  #$B0,D0
02:0002DE68 6742            	  5318:     beq  _L_z04_UpdatePolsVoice_SetState1
02:0002DE6A 0C0000F4        	  5319:     cmpi.b  #$F4,D0
02:0002DE6E 643C            	  5320:     bcc  _L_z04_UpdatePolsVoice_SetState1
                            	  5321:     ; Else blocked by something else.
