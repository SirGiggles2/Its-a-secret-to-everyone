02:0001ED96 5443            	  3433:     addq.w  #2,D3
02:0001ED98 612C            	  3434:     bsr     .ttf_attr1_cache_2x2
02:0001ED9A 4EB900002156    	  3435:     bsr     _attr_write_2x2
