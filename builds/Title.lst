                            	  1817: 
                            	  1818: ; Each byte describes an item. The high nibble is the type.
                            	  1819: ; The low nibble is the value. Its meaning depends on the type.
                            	  1820: ;
                            	  1821: ; 0x - individuals
                            	  1822: ; * unique: value is boolean: you have it or you don't; also value indicates palette row sprite attribute.
                            	  1823: ; * bit mask: value doesn't matter.
                            	  1824: ;
                            	  1825: ; 1x - amounts
                            	  1826: ; Value is an amount to add.
                            	  1827: ;
                            	  1828: ; 2x - grades
                            	  1829: ; Value is a grade and palette row. Picking up an item with a lower grade won't change the inventory.
                            	  1830: ;
                            	  1831: ; 3x - error?
                            	  1832: ; Produces an item value of $FF.
                            	  1833: ;
                            	  1834:     even
