                            	   917: ;==============================================================================
                            	   918: ; fs_to_transpiled_trampoline — Native FS → transpiled gameplay/register-name
                            	   919: ; handoff. Mirror of intro_to_file_select_trampoline but enters at
                            	   920: ; UpdateMode1Menu_Sub1 (chose-slot path) with CurSaveSlot pre-seeded.
                            	   921: ;
                            	   922: ; Caller (fs_handoff.c) passes save_slot in D0 (low byte). For empty slots,
                            	   923: ; pass 3 → transpiled chose-slot path detects CurSaveSlot >= 3 and routes
                            	   924: ; to register-name (Mode 1 Sub1 → GameMode = slot+$0B = $0E).
                            	   925: ; For occupied slots, pass 0/1/2 → ChoseSlot copies items + JMP GoToNextMode
                            	   926: ; → Mode 2 → eventually Mode 5 (gameplay).
                            	   927: ;
                            	   928: ; Placed at end-of-file (after all zelda_translated includes) so its byte
                            	   929: ; size doesn't push transpiled .s short-branches out of range.
                            	   930: ;
                            	   931: ; Does NOT return.
                            	   932: ;==============================================================================
                            	   933:     xdef    fs_to_transpiled_trampoline
                            	   934: fs_to_transpiled_trampoline:
                            	   935:     ; No-arg trampoline. Caller (fs_handoff.c) writes CurSaveSlot at
                            	   936:     ; nes_ram[0x0016] directly before calling — m68k SysV byte-arg passing
                            	   937:     ; via D0 is unreliable (caller stack-pushes ints), so doing the seed
                            	   938:     ; in C avoids the ABI guesswork.
                            	   939: 
02:0003D2F4 13FC00CC00FF07F2	   940:     move.b  #$CC,($00FF07F2).l       ; probe: fs trampoline entered
                            	   941: 
                            	   942:     ; [1] Restore translated runtime register contract.
02:0003D2FC 287C00FF0000    	   943:     move.l  #$00FF0000,A4
02:0003D302 2A7C00FF0200    	   944:     move.l  #$00FF0200,A5
02:0003D308 7EFF            	   945:     moveq   #-1,D7
                            	   946: 
                            	   947:     ; [2] Hand off to transpiled FS at Sub 0 (initial state). Transpiled
                            	   948:     ;     FS init runs InitMode1_Full → UpdateMode1Menu_Sub0; player picks
                            	   949:     ;     slot via real transpiled flow. Native FS is the intro screen
                            	   950:     ;     replacement; transpiled FS still owns the actual save selection.
02:0003D30A 197C00000011    	   951:     move.b  #$00,($0011,A4)          ; IsUpdatingMode = 0 (next NMI runs InitMode)
02:0003D310 197C00010012    	   952:     move.b  #$01,($0012,A4)          ; GameMode = $01 (file-select)
02:0003D316 197C00000013    	   953:     move.b  #$00,($0013,A4)          ; GameSubmode = $00 (initial)
02:0003D31C 13FC000100FF042B	   954:     move.b  #$01,(FrontendStartReleaseGate).l ; Start consumed
02:0003D324 13FC000100FF083D	   955:     move.b  #$01,(VRamForceBlankGate).l       ; VRAM streaming protection
02:0003D32C 197C00000600    	   956:     move.b  #$00,($0600,A4)          ; SongRequest = 0
                            	   957: 
                            	   958:     ; [3] Re-enable transpiled NMI heartbeat.
02:0003D332 102C00FF        	   959:     move.b  ($00FF,A4),D0
02:0003D336 00000080        	   960:     ori.b   #$80,D0
02:0003D33A 194000FF        	   961:     move.b  D0,($00FF,A4)
02:0003D33E 13C000FF0804    	   962:     move.b  D0,(PPU_CTRL).l
                            	   963: 
                            	   964:     ; [4] VDP gameplay defaults (V64 + Window V=8).
02:0003D344 33FC901100C00004	   965:     move.w  #$9011,(VDP_CTRL).l
02:0003D34C 33FC920800C00004	   966:     move.w  #$9208,(VDP_CTRL).l
                            	   967: 
                            	   968:     ; [5] Flip dispatcher.
02:0003D354 13FC000100FF0FFC	   969:     move.b  #1,(vblank_mode).l
                            	   970: 
                            	   971:     ; [6] Spin.
02:0003D35C 6000D064        	   972:     jmp     LoopForever
                            	   973: 
