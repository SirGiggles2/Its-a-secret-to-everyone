02:0002DFA4 41EC042C        	  5463:     lea     ($042C,A4),A0
02:0002DFA8 12302000        	  5464:     move.b  (A0,D2.W),D1
02:0002DFAC B001            	  5465:     cmp.b   D1,D0
02:0002DFAE 65000096        	  5466:     bcs  _L_z04_UpdatePolsVoiceState1_Jumping_Exit
                            	  5467:     ; Else reached the destination. Go to state 0.
