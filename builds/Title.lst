02:00030E88 610038A2        	  1584:     jsr     ResetInvObjState
                            	  1585:     ; There's more than one way to enter a room.
                            	  1586:     ;
                            	  1587:     ; 1: Out of a cave, dungeon, or cellar
                            	  1588:     ;     a. Walking exit
                            	  1589:     ;     b. Next to stairs
                            	  1590:     ; 2: Room to room
                            	  1591:     ;
                            	  1592:     ; Determine which one we need.
                            	  1593:     ;
02:00030E8C 102C005A        	  1594:     move.b  ($005A,A4),D0
02:00030E90 6770            	  1595:     beq  _L_z05_InitMode_EnterRoom_Method2
02:00030E92 102C0010        	  1596:     move.b  ($0010,A4),D0
02:00030E96 665C            	  1597:     bne  _anon_z05_42
                            	  1598:     ; Enter method 1.
                            	  1599:     ;
                            	  1600:     ; Set up Link's exit from underground.
                            	  1601:     ;
02:00030E98 7600            	  1602:     moveq   #0,D3
02:00030E9A 162C00EB        	  1603:     move.b  ($00EB,A4),D3
02:00030E9E 41F900FF687E    	  1604:     lea     (NES_SRAM+$087E).l,A0
02:00030EA4 10303000        	  1605:     move.b  (A0,D3.W),D0
02:00030EA8 020000F0        	  1606:     andi.b #$F0,D0
02:00030EAC 19400070        	  1607:     move.b  D0,($0070,A4)
02:00030EB0 41F900FF6AFE    	  1608:     lea     (NES_SRAM+$0AFE).l,A0
02:00030EB6 10303000        	  1609:     move.b  (A0,D3.W),D0
02:00030EBA 02000007        	  1610:     andi.b #$07,D0
02:00030EBE E308            	  1611:     lsl.b  #1,D0   ; ASL A
02:00030EC0 E308            	  1612:     lsl.b  #1,D0   ; ASL A
02:00030EC2 E308            	  1613:     lsl.b  #1,D0   ; ASL A
02:00030EC4 E308            	  1614:     lsl.b  #1,D0   ; ASL A
                            	  1615:     ; Add the first Y where Link can come out of underground.
                            	  1616:     ; $4D is $50 (the second square row) - 3 (Link's offset above the row).
02:00030EC6 123C004D        	  1617:     move.b  #$4D,D1
02:00030ECA D101            	  1618:     addx.b  D1,D0   ; ADC #$4D (X flag = 6502 C)
02:00030ECC 19400084        	  1619:     move.b  D0,($0084,A4)
                            	  1620:     ; If the player didn't step on a cave entrance to go underground,
                            	  1621:     ; then he used the stairs. So, skip starting the exit effect (method 1-b).
                            	  1622:     ;
02:00030ED0 7600            	  1623:     moveq   #0,D3
02:00030ED2 162C0065        	  1624:     move.b  ($0065,A4),D3
02:00030ED6 0C030024        	  1625:     cmpi.b  #$24,D3
02:00030EDA 6618            	  1626:     bne  _anon_z05_42
                            	  1627:     ; Enter method 1-a.
