02:0002C4E6 4EB90003B858    	  1764:     jsr     ReverseObjDir
                            	  1765: _anon_z04_43:
                            	  1766:     ; If facing horizontally, go place the leever to the left or right of Link.
                            	  1767:     ;
02:0002C4EC 41EC0098        	  1768:     lea     ($0098,A4),A0
02:0002C4F0 10302000        	  1769:     move.b  (A0,D2.W),D0
02:0002C4F4 0200000C        	  1770:     andi.b #$0C,D0
02:0002C4F8 6742            	  1771:     beq  _L_z04_UpdateRedLeever_PlaceHorizontally
                            	  1772:     ; Begin with the leever's X set to Link's X.
                            	  1773:     ;
