02:0002D436 6712            	  3936:     beq  _L_z04_Moldorm_PropagateDirs_SkipBounce
02:0002D438 41EC0098        	  3937:     lea     ($0098,A4),A0
02:0002D43C 11802000        	  3938:     move.b  D0,(A0,D2.W)
02:0002D440 7000            	  3939:     moveq   #0,D0
