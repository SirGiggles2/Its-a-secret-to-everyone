                            	  3059:     else
                            	  3060:     bsr     _chr_convert_upload
                            	  3061:     endc
                            	  3062: .ttf_chr_no_convert:
                            	  3063: 
02:0001EAB8 5343            	  3064:     subq.w  #1,D3
02:0001EABA 6694            	  3065:     bne.s   .ttf_chr_slow_loop
02:0001EABC 600003E8        	  3066:     bra     .ttf_post_record
