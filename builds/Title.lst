02:0002F934 7600            	  8909:     moveq   #0,D3
02:0002F936 162C0627        	  8910:     move.b  ($0627,A4),D3
02:0002F93A 0C030010        	  8911:     cmpi.b  #$10,D3
02:0002F93E 6716            	  8912:     beq  _L_z04_SetUpDroppedItem_SetHelpItem
                            	  8913:     ; If help drop counter < $A, then use the dropped item ID as is.
                            	  8914:     ; But there is a random chance that the item drop will be canceled.
                            	  8915:     ;
02:0002F940 102C0050        	  8916:     move.b  ($0050,A4),D0
02:0002F944 0C00000A        	  8917:     cmpi.b  #$0A,D0
02:0002F948 651A            	  8918:     bcs  _L_z04_SetUpDroppedItem_RandomlyCancel
                            	  8919:     ; Otherwise, the item will be guaranteed to be made.
                            	  8920:     ; [51] HelpDropValue determines which kind:
