                            	  2230:     endc
02:0001E53C 4E75            	  2231:     rts
                            	  2232: 
                            	  2233:     ifne CHR_EXPANSION_ENABLED
                            	  2234: .oam_tile_bias_tbl:
02:0001E53E 0000            	  2235:     dc.w    0                   ; NES sub-pal 0 → shared bank A @ VRAM $0000
02:0001E540 0200            	  2236:     dc.w    512                 ; NES sub-pal 1 → bank B @ VRAM $4000 (tile 512)
02:0001E542 0400            	  2237:     dc.w    1024                ; NES sub-pal 2 → bank C @ VRAM $8000 (tile 1024)
02:0001E544 0000            	  2238:     dc.w    0                   ; NES sub-pal 3 → shared bank A @ VRAM $0000
                            	  2239: .oam_pal_bits_tbl:
02:0001E546 0000            	  2240:     dc.w    $0000               ; sub-pal 0 → PAL0 (bits 14:13 = 00)
02:0001E548 0000            	  2241:     dc.w    $0000               ; sub-pal 1 → PAL0
02:0001E54A 0000            	  2242:     dc.w    $0000               ; sub-pal 2 → PAL0
02:0001E54C 2000            	  2243:     dc.w    $2000               ; sub-pal 3 → PAL1 (bits 14:13 = 01)
                            	  2244:     endc
