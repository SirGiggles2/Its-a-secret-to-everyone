02:00034F44 41EC0306        	  8470:     lea     ($0306,A4),A0
02:00034F48 11803000        	  8471:     move.b  D0,(A0,D3.W)
02:00034F4C 5303            	  8472:     subq.b  #1,D3
02:00034F4E 6AEC            	  8473:     bpl  _anon_z05_200
02:00034F50 101D            	  8474:     move.b  (A5)+,D0  ; PLA
