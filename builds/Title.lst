02:0002D352 0C020006        	  3767:     cmpi.b  #$06,D2
02:0002D356 6502            	  3768:     bcs  _anon_z04_80
02:0002D358 7604            	  3769:     moveq   #4,D3
                            	  3770: _anon_z04_80:
02:0002D35A 5203            	  3771:     addq.b  #1,D3
02:0002D35C 41EC0350        	  3772:     lea     ($0350,A4),A0
02:0002D360 10303000        	  3773:     move.b  (A0,D3.W),D0
02:0002D364 0C000041        	  3774:     cmpi.b  #$41,D0
02:0002D368 66F0            	  3775:     bne  _anon_z04_80
                            	  3776:     ; I don't know why the object timer of the tail segment that will
                            	  3777:     ; be made dead is set to $11. By setting its object type to $5D
                            	  3778:     ; below, its metastate will become $10 -- dying/dead. From
                            	  3779:     ; there, the object timer is set to 6.
                            	  3780:     ;
02:0002D36A 7011            	  3781:     moveq   #17,D0
02:0002D36C 19803029        	  3782:     move.b  D0,($29,A4,D3.W)
                            	  3783:     ; Copy the invincibility timer, X, and Y from the original dead
                            	  3784:     ; segment to the tail segment.
                            	  3785:     ;
02:0002D370 41EC04F0        	  3786:     lea     ($04F0,A4),A0
02:0002D374 10302000        	  3787:     move.b  (A0,D2.W),D0
02:0002D378 41EC04F1        	  3788:     lea     ($04F1,A4),A0
02:0002D37C 11803000        	  3789:     move.b  D0,(A0,D3.W)
02:0002D380 10342070        	  3790:     move.b  ($70,A4,D2.W),D0
02:0002D384 19803071        	  3791:     move.b  D0,($71,A4,D3.W)
02:0002D388 41EC0084        	  3792:     lea     ($0084,A4),A0
02:0002D38C 10302000        	  3793:     move.b  (A0,D2.W),D0
02:0002D390 41EC0085        	  3794:     lea     ($0085,A4),A0
02:0002D394 11803000        	  3795:     move.b  D0,(A0,D3.W)
                            	  3796:     ; If the tail segment found is also a head, then
                            	  3797:     ; the last segment has died. Return.
