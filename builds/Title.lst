02:0003C6F0 003C0011        	  6400:     ori     #$11,CCR  ; SEC: set C+X
02:0003C6F4 41EC0084        	  6401:     lea     ($0084,A4),A0
02:0003C6F8 12302000        	  6402:     move.b  (A0,D2.W),D1
02:0003C6FC 0A3C0010        	  6403:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003C700 9101            	  6404:     subx.b  D1,D0   ; SBC ObjY,X
02:0003C702 0A3C0010        	  6405:     eori    #$10,CCR  ; restore X = 6502 C
02:0003C706 4EB9000242A8    	  6406:     jsr     Abs
