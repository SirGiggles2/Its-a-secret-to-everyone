02:000209C6 7200            	  5173:     moveq   #0,D1
02:000209C8 1200            	  5174:     move.b  D0,D1
02:000209CA 0281000000FF    	  5175:     andi.l  #$FF,D1
02:000209D0 2F01            	  5176:     move.l  D1,-(SP)              ; arg1 instr_offset
02:000209D2 4EB900000000    	  5177:     jsr     z04_wallmaster_calc_start_position
02:000209D8 4FEF000C        	  5178:     lea     (12,SP),SP
02:000209DC 7600            	  5179:     moveq   #0,D3
02:000209DE 1600            	  5180:     move.b  D0,D3                 ; return value -> D3
02:000209E0 4E75            	  5181:     rts
