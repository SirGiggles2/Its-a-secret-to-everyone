                            	  7146: _L_z07_InitObject_InitMonsterFromEdge:
02:0003CD24 7400            	  7147:     moveq   #0,D2
02:0003CD26 142C0340        	  7148:     move.b  ($0340,A4),D2
                            	  7149:     ; PATCH P47: pre- and post-walk $0525 validation + walkability.
                            	  7150:     ; Pre: snap OOB (hi < $40 or hi >= $E0) to $48.
                            	  7151:     ; Post1: if result hi=$E (bottom edge), redo from $48.
                            	  7152:     ; Post2: read chosen cell's tile; if unwalkable (>= $84),
                            	  7153:     ; rotate through FallbackCells until walkable or bail to $48.
                            	  7154:     ; (Debug instrumentation at $FF0500/0501/0508/050E/050F/0510
                            	  7155:     ; was removed 2026-04-19 — it aliased $0510..$054F which
                            	  7156:     ; overlaps BrighteningRoom ($051E) and CandleState ($051F),
                            	  7157:     ; corrupting them and causing a deterministic address-error
                            	  7158:     ; freeze at room $73 ~240 frames after entry. Root cause
                            	  7159:     ; identified by Codex static review.)
                            	  7160: _L_z07_P47_pre_check:
02:0003CD2A 102C0525        	  7161:     move.b  ($0525,A4),D0
02:0003CD2E 020000F0        	  7162:     andi.b  #$F0,D0
02:0003CD32 0C000040        	  7163:     cmpi.b  #$40,D0
02:0003CD36 6506            	  7164:     blo     _L_z07_P47_pre_snap
02:0003CD38 0C0000E0        	  7165:     cmpi.b  #$E0,D0
02:0003CD3C 6506            	  7166:     blo     _L_z07_P47_pre_ok
                            	  7167: _L_z07_P47_pre_snap:
02:0003CD3E 197C00480525    	  7168:     move.b  #$48,($0525,A4)
                            	  7169: _L_z07_P47_pre_ok:
02:0003CD44 7005            	  7170:     moveq   #5,D0
02:0003CD46 610004F4        	  7171:     jsr     SwitchBank
02:0003CD4A 4EB900031C82    	  7172:     jsr     FindNextEdgeSpawnCell
                            	  7173:     ; Post-walk 1: bottom-edge snap.
02:0003CD50 102C0525        	  7174:     move.b  ($0525,A4),D0
02:0003CD54 020000F0        	  7175:     andi.b  #$F0,D0
02:0003CD58 0C0000E0        	  7176:     cmpi.b  #$E0,D0
02:0003CD5C 660C            	  7177:     bne     _L_z07_P47_post1_ok
02:0003CD5E 197C00480525    	  7178:     move.b  #$48,($0525,A4)
02:0003CD64 4EB900031C82    	  7179:     jsr     FindNextEdgeSpawnCell
                            	  7180: _L_z07_P47_post1_ok:
                            	  7181:     ; Post-walk 2: validate resulting cell is walkable.
                            	  7182:     ; Playmap addr = $FF6530 + (lo * 44) + ((hi - 4) * 2).
02:0003CD6A 7600            	  7183:     moveq   #0,D3
02:0003CD6C 162C0525        	  7184:     move.b  ($0525,A4),D3
02:0003CD70 0243000F        	  7185:     andi.w  #$000F,D3
02:0003CD74 C6FC002C        	  7186:     mulu.w  #44,D3
02:0003CD78 203C00FF6530    	  7187:     move.l  #$FF6530,D0
02:0003CD7E D083            	  7188:     add.l   D3,D0
02:0003CD80 7600            	  7189:     moveq   #0,D3
02:0003CD82 162C0525        	  7190:     move.b  ($0525,A4),D3
02:0003CD86 E84B            	  7191:     lsr.w   #4,D3
02:0003CD88 5943            	  7192:     subi.w  #4,D3
