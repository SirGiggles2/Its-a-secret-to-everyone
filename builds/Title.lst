                            	   761:     ;==========================================================================
                            	   762:     ; NAMETABLE / PALETTE PATH  (PPU_VADDR $2000–$3FFF)
                            	   763:     ;==========================================================================
                            	   764:     ; Word-pair buffering: buffer even-address byte, flush word on odd address.
                            	   765:     ;==========================================================================
                            	   766: .nt_write:
                            	   767:     ;======================================================================
                            	   768:     ; Nametable → Genesis Plane A row mapping:
                            	   769:     ;   NES NT_A tiles ($2000–$23BF, and mirrored $2400–$27BF)
                            	   770:     ;       → Plane A rows 0–29  (VDP $C000–$C5FF)
                            	   771:     ;   NES NT_B tiles ($2800–$2BBF, and mirrored $2C00–$2FBF)
                            	   772:     ;       → Plane A rows 30–59 (VDP $CF00–$D4FF)
                            	   773:     ;
                            	   774:     ; Zelda uses vertical mirroring so NT_A and NT_B are the only two
                            	   775:     ; physical nametables. Story-scroll (intro) writes new rows to NT_B
                            	   776:     ; via $2800+ as the scroll crosses the NT boundary — previously these
                            	   777:     ; writes were dropped, leaving Plane A rows 30..59 stale.
                            	   778:     ;
                            	   779:     ; Each row is 64 tiles × 2 bytes = $80 bytes wide in Plane A.
                            	   780:     ;   vdp_addr = $C000 + row * $80 + col * 2
                            	   781:     ;======================================================================
                            	   782:     ; Fold $2C00 mirror → $2800 (vertical mirroring alias for NT_B).
02:00001C5A 0C412C00        	   783:     cmpi.w  #$2C00,D1
02:00001C5E 650A            	   784:     blo.s   .nt_no_b_mirror
02:00001C60 0C413000        	   785:     cmpi.w  #$3000,D1
02:00001C64 6404            	   786:     bhs.s   .nt_no_b_mirror
02:00001C66 04410400        	   787:     subi.w  #$0400,D1
                            	   788: .nt_no_b_mirror:
                            	   789:     ; T39 HUD/playfield split (Zelda 4-screen semantics).
                            	   790:     ; Track original source range before folding $2400 → $2000:
                            	   791:     ;   D7 = 0 → source was $2000 (HUD region; rows 0-3 only)
                            	   792:     ;   D7 = 1 → source was $2400 (playfield region; rows 4-29 only)
                            	   793:     ; NES renders HUD from $2000 for scanlines 0-31 and playfield from
                            	   794:     ; $2400 for scanlines 32-239 via a mid-frame scroll split. On Gen we
                            	   795:     ; collapse both into Plane A, so we gate writes to avoid one source
                            	   796:     ; clobbering the other's rows. Overworld only writes $2400 rows 4-29
                            	   797:     ; (so the bug was latent), but cave rooms write $2400 rows 0-29 which
                            	   798:     ; stomped the HUD — see builds/reports/t39_stage_a_render_classification.md.
02:00001C6A 7E00            	   799:     moveq   #0,D7
02:00001C6C 0C412400        	   800:     cmpi.w  #$2400,D1
02:00001C70 6508            	   801:     blo.s   .nt_src_detected
