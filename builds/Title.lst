02:00033492 1214            	  5432:     move.b  ($00,A4),D1   ; ptr lo
02:00033494 182C0001        	  5433:     move.b  ($01,A4),D4  ; ptr hi
02:00033498 024100FF        	  5434:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:0003349C E14C            	  5435:     lsl.w   #8,D4
02:0003349E 8841            	  5436:     or.w    D1,D4
02:000334A0 48C4            	  5437:     ext.l   D4
02:000334A2 D8BC00FF0000    	  5438:     add.l   #NES_RAM,D4
