                            	  4317: _anon_z02_34:
02:00028610 41F900FF6B7E    	  4318:     lea     (NES_SRAM+$0B7E).l,A0
02:00028616 10303000        	  4319:     move.b  (A0,D3.W),D0
02:0002861A 41EC0302        	  4320:     lea     ($0302,A4),A0
02:0002861E 11803000        	  4321:     move.b  D0,(A0,D3.W)
02:00028622 5303            	  4322:     subq.b  #1,D3
02:00028624 6AEA            	  4323:     bpl  _anon_z02_34
                            	  4324:     ; Use (timer MOD 4) as an index to look up a color.
