                            	  8629: DrawSubmenuItems:
                            	  8630:     ; Look for a magic boomerang, then a wooden boomerang.
                            	  8631:     ; If you find one, then draw it.
                            	  8632:     ;
02:0003505A 741E            	  8633:     moveq   #30,D2
                            	  8634: _anon_z05_208:
02:0003505C 41EC0657        	  8635:     lea     ($0657,A4),A0
02:00035060 10302000        	  8636:     move.b  (A0,D2.W),D0
02:00035064 660A            	  8637:     bne  _L_z05_DrawSubmenuItems_FoundBoomerang
02:00035066 5302            	  8638:     subq.b  #1,D2
02:00035068 0C02001C        	  8639:     cmpi.b  #$1C,D2
02:0003506C 66EE            	  8640:     bne  _anon_z05_208
02:0003506E 6716            	  8641:     beq  _L_z05_DrawSubmenuItems_DrawOtherItems
                            	  8642:     even
                            	  8643: _L_z05_DrawSubmenuItems_FoundBoomerang:
02:00035070 7036            	  8644:     moveq   #54,D0
02:00035072 19400001        	  8645:     move.b  D0,($0001,A4)
02:00035076 103C0080        	  8646:     move.b  #$80,D0
02:0003507A 1880            	  8647:     move.b  D0,($0000,A4)
02:0003507C 1002            	  8648:     move.b  D2,D0
02:0003507E 7600            	  8649:     moveq   #0,D3
02:00035080 1600            	  8650:     move.b  D0,D3
02:00035082 610057E2        	  8651:     jsr     DrawItemInInventory
                            	  8652:     even
                            	  8653: _L_z05_DrawSubmenuItems_DrawOtherItems:
                            	  8654:     ; Look at the rest of the items, starting at index 1.
                            	  8655:     ;
02:00035086 7401            	  8656:     moveq   #1,D2
                            	  8657:     even
                            	  8658: _L_z05_DrawSubmenuItems_LoopDrawItem:
02:00035088 41EC0657        	  8659:     lea     ($0657,A4),A0
02:0003508C 10302000        	  8660:     move.b  (A0,D2.W),D0
                            	  8661:     ; If at the compass item slot, check this level's compass.
                            	  8662:     ;
02:00035090 0C020010        	  8663:     cmpi.b  #$10,D2
02:00035094 6606            	  8664:     bne  _anon_z05_209
02:00035096 6100FF0A        	  8665:     jsr     HasCompass
02:0003509A 7410            	  8666:     moveq   #16,D2
                            	  8667: _anon_z05_209:
                            	  8668:     ; If at the map item slot, check this level's map.
                            	  8669:     ;
02:0003509C 0C020011        	  8670:     cmpi.b  #$11,D2
02:000350A0 6606            	  8671:     bne  _anon_z05_210
02:000350A2 6100FF04        	  8672:     jsr     HasMap
02:000350A6 7411            	  8673:     moveq   #17,D2
                            	  8674: _anon_z05_210:
                            	  8675:     ; If there are none of this item, then go advance the index and loop again.
                            	  8676:     ;
02:000350A8 4A00            	  8677:     cmpi.b  #$00,D0
02:000350AA 675C            	  8678:     beq  _L_z05_DrawSubmenuItems_NextLoopDrawItem
                            	  8679:     ; If at the letter item slot, look at what's in the potion slot.
                            	  8680:     ; If there is a potion, then go advance the index and loop again.
                            	  8681:     ; That's because we already prepared sprites for the potion.
                            	  8682:     ;
02:000350AC 0C02000F        	  8683:     cmpi.b  #$0F,D2
02:000350B0 6606            	  8684:     bne  _anon_z05_211
02:000350B2 102C065E        	  8685:     move.b  ($065E,A4),D0
02:000350B6 6650            	  8686:     bne  _L_z05_DrawSubmenuItems_NextLoopDrawItem
                            	  8687: _anon_z05_211:
02:000350B8 1002            	  8688:     move.b  D2,D0
02:000350BA 1B00            	  8689:     move.b  D0,-(A5)  ; PHA
02:000350BC 7600            	  8690:     moveq   #0,D3
02:000350BE 1600            	  8691:     move.b  D0,D3
                            	  8692:     ; Look up and set the X coordinate of this item.
                            	  8693:     ;
02:000350C0 41F90003504A    	  8694:     lea     (SubmenuItemXs).l,A0
02:000350C6 10302000        	  8695:     move.b  (A0,D2.W),D0
02:000350CA 1880            	  8696:     move.b  D0,($0000,A4)
                            	  8697:     ; If the item goes in the first selectable row (item slot < 5),
                            	  8698:     ; then go set Y coordinate to $36 and draw.
                            	  8699:     ;
02:000350CC 7036            	  8700:     moveq   #54,D0
02:000350CE 0C020005        	  8701:     cmpi.b  #$05,D2
02:000350D2 6526            	  8702:     bcs  _L_z05_DrawSubmenuItems_Draw
                            	  8703:     ; If the item goes in the second selectable row (item slot < 9 or = $F),
                            	  8704:     ; then go set Y coordinate to $46 and draw.
                            	  8705:     ;
02:000350D4 7046            	  8706:     moveq   #70,D0
02:000350D6 0C02000F        	  8707:     cmpi.b  #$0F,D2
02:000350DA 671E            	  8708:     beq  _L_z05_DrawSubmenuItems_Draw
02:000350DC 0C020009        	  8709:     cmpi.b  #$09,D2
02:000350E0 6518            	  8710:     bcs  _L_z05_DrawSubmenuItems_Draw
                            	  8711:     ; If the item goes in the unselectable row at the top (item slot < $10),
                            	  8712:     ; then go set Y coordinate to $1E and draw.
                            	  8713:     ;
02:000350E2 701E            	  8714:     moveq   #30,D0
02:000350E4 0C020010        	  8715:     cmpi.b  #$10,D2
02:000350E8 6510            	  8716:     bcs  _L_z05_DrawSubmenuItems_Draw
                            	  8717:     ; The Y coordinate of the compass is $9E; and the map's is $76.
                            	  8718:     ; The X coordinate for both is $2C.
                            	  8719:     ;
02:000350EA 702C            	  8720:     moveq   #44,D0
02:000350EC 1880            	  8721:     move.b  D0,($0000,A4)
02:000350EE 103C009E        	  8722:     move.b  #$9E,D0
02:000350F2 0C020011        	  8723:     cmpi.b  #$11,D2
02:000350F6 6502            	  8724:     bcs  _L_z05_DrawSubmenuItems_Draw
02:000350F8 7076            	  8725:     moveq   #118,D0
                            	  8726:     even
