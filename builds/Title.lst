02:0002DC78 41EC042C        	  5036:     lea     ($042C,A4),A0
02:0002DC7C 52302000        	  5037:     addq.b  #1,(A0,D2.W)
                            	  5038:     ; If new bloated substate < 2, then go decrement the bloated timer.
                            	  5039:     ;
