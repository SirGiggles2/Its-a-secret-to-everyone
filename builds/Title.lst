02:0002C5A4 0A3C0010        	  1867:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002C5A8 9101            	  1868:     subx.b  D1,D0   ; SBC $02
02:0002C5AA 0A3C0010        	  1869:     eori    #$10,CCR  ; restore X = 6502 C
