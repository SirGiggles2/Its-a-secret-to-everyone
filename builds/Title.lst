02:00028B28 11803000        	  4751:     move.b  D0,(A0,D3.W)
02:00028B2C 5303            	  4752:     subq.b  #1,D3
02:00028B2E 6AF4            	  4753:     bpl  _anon_z02_41
                            	  4754:     ; No wall tiles go in row 0.
                            	  4755:     ;
