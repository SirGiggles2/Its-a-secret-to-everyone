                            	  1102:     ;======================================================================
                            	  1103:     ; T19: Palette writes ($3F00–$3F1F) → Genesis CRAM.
                            	  1104:     ;======================================================================
                            	  1105: .t19_palette:
02:00001EB0 0C413F20        	  1106:     cmpi.w  #$3F20,D1
02:00001EB4 6472            	  1107:     bhs.s   .nt_skip_write          ; ≥$3F20: mirror / overflow — skip
                            	  1108: 
                            	  1109:     ; Compute CRAM address from PPU_VADDR
02:00001EB6 3401            	  1110:     move.w  D1,D2
02:00001EB8 04423F00        	  1111:     subi.w  #$3F00,D2               ; D2.w = offset (0..31)
02:00001EBC 0242001F        	  1112:     andi.w  #$001F,D2               ; mask to 5 bits
                            	  1113: 
                            	  1114:     ; NES palette handling:
                            	  1115:     ; Offsets 0-15  ($3F00-$3F0F): BG palettes → Genesis CRAM pal 0-3
                            	  1116:     ; Offset entry-0s (0,4,8,12,16,20,24,28): universal BG color mirror
                            	  1117:     ; Offsets 16-31 ($3F10-$3F1F): sprite palettes → Genesis CRAM pal 2-3
                            	  1118:     ;   (NES sprite pal 0,2→Genesis pal 2; NES sprite pal 1,3→Genesis pal 3)
                            	  1119:     ; Sequential last-write-wins: sprite pals 2,3 end up in PAL2/PAL3 which
                            	  1120:     ; gives correct sprite colors (red hearts, green grass) while BG text
                            	  1121:     ; only uses PAL0/PAL1 during the story phase, so BG2/BG3 clobber is OK.
                            	  1122:     ; _oam_dma maps NES sprite pal bits → Gen pal 2/3 to match.
02:00001EC0 0C420010        	  1123:     cmpi.w  #$10,D2
02:00001EC4 652C            	  1124:     blo.s   .t19_bg_color           ; offset < 16: BG palette
                            	  1125:     ; Sprite palette (offset 16-31)
02:00001EC6 3602            	  1126:     move.w  D2,D3
02:00001EC8 02430003        	  1127:     andi.w  #$0003,D3               ; color slot within palette
02:00001ECC 6720            	  1128:     beq.s   .t19_spr_entry0         ; slot 0 → BG mirror
                            	  1129:     ; Non-entry-0 sprite color: remap
                            	  1130:     ifne CHR_EXPANSION_ENABLED
                            	  1131:     ; T-CHR S8 (v2): pack sprite sub-palettes into unused tail slots of BG
                            	  1132:     ; palettes so BG PAL0-3[0..3] stay untouched.
                            	  1133:     ;   sub-pal 0 → PAL0[4..7]   (CRAM base $08, bias +4 pixels)
                            	  1134:     ;   sub-pal 1 → PAL0[8..11]  (CRAM base $10, bias +8 pixels)
                            	  1135:     ;   sub-pal 2 → PAL0[12..15] (CRAM base $18, bias +12 pixels)
                            	  1136:     ;   sub-pal 3 → PAL1[4..7]   (CRAM base $28, bias +4 pixels, different palette)
02:00001ECE 3602            	  1137:     move.w  D2,D3
02:00001ED0 04430010        	  1138:     subi.w  #$10,D3                 ; D3 = 0..15 within sprite range
02:00001ED4 E44B            	  1139:     lsr.w   #2,D3                   ; D3 = sub-pal (0..3)
02:00001ED6 D643            	  1140:     add.w   D3,D3                   ; * 2 for word index
02:00001ED8 43F900001F30    	  1141:     lea     (.t19_spr_cram_base).l,A1
02:00001EDE 36313000        	  1142:     move.w  (A1,D3.W),D3            ; D3 = CRAM base for this sub-pal
02:00001EE2 3802            	  1143:     move.w  D2,D4
02:00001EE4 02440003        	  1144:     andi.w  #$0003,D4               ; color slot (1..3)
02:00001EE8 D844            	  1145:     add.w   D4,D4                   ; * 2
02:00001EEA D644            	  1146:     add.w   D4,D3                   ; D3 = CRAM address
                            	  1147:     else
                            	  1148:     ; Legacy last-write-wins: NES sprite pal 0-3 → Gen pal 2|3 (2,3,2,3).
                            	  1149:     move.w  D2,D3
                            	  1150:     subi.w  #$10,D3                 ; 0-15 range
                            	  1151:     lsr.w   #2,D3                   ; NES sprite pal (0-3)
                            	  1152:     ori.w   #$0002,D3               ; Genesis pal = NES_pal | 2 (→ 2,3,2,3)
                            	  1153:     lsl.w   #5,D3                   ; * $20 = CRAM palette base
                            	  1154:     move.w  D2,D2
                            	  1155:     andi.w  #$0003,D2               ; color slot (1-3)
                            	  1156:     lsl.w   #1,D2                   ; * 2
                            	  1157:     add.w   D2,D3                   ; D3 = CRAM address
                            	  1158:     endc
02:00001EEC 6012            	  1159:     bra.s   .t19_have_cram
                            	  1160: .t19_spr_entry0:
                            	  1161:     ; Sprite entry-0 = BG mirror: remap 16→0, 20→4, 24→8, 28→12
02:00001EEE 04420010        	  1162:     subi.w  #$10,D2
                            	  1163: .t19_bg_color:
02:00001EF2 3602            	  1164:     move.w  D2,D3
02:00001EF4 E44B            	  1165:     lsr.w   #2,D3                   ; D3.w = palette index (0..3)
02:00001EF6 EB4B            	  1166:     lsl.w   #5,D3                   ; D3.w = palette * $20
02:00001EF8 02420003        	  1167:     andi.w  #$0003,D2               ; D2.w = color slot (0..3)
02:00001EFC E34A            	  1168:     lsl.w   #1,D2                   ; D2.w = color * 2
02:00001EFE D642            	  1169:     add.w   D2,D3                   ; D3.w = CRAM address (0..$66)
                            	  1170: .t19_have_cram:
                            	  1171: 
                            	  1172:     ; Issue VDP CRAM write command
02:00001F00 7400            	  1173:     moveq   #0,D2
02:00001F02 3403            	  1174:     move.w  D3,D2
02:00001F04 4842            	  1175:     swap    D2                      ; D2 = CRAM_addr << 16
02:00001F06 0082C0000000    	  1176:     ori.l   #$C0000000,D2           ; VDP CRAM-write command ($C0 = CD bits for CRAM write)
02:00001F0C 23C200C00004    	  1177:     move.l  D2,(VDP_CTRL).l
                            	  1178: 
                            	  1179:     ; Look up NES color index (D0.b, 0..63) in NES→Genesis 16-bit color table
02:00001F12 0240003F        	  1180:     andi.w  #$003F,D0               ; D0.w = NES color index (mask high bits)
02:00001F16 41F9000021BC    	  1181:     lea     (nes_palette_to_genesis).l,A0
02:00001F1C E348            	  1182:     lsl.w   #1,D0                   ; D0.w = byte offset into 16-bit word table
02:00001F1E 34300000        	  1183:     move.w  (A0,D0.W),D2            ; D2.w = Genesis color word ($0BGR)
02:00001F22 33C200C00000    	  1184:     move.w  D2,(VDP_DATA).l         ; write Genesis color to CRAM
                            	  1185: 
                            	  1186: .nt_skip_write:
02:00001F28 610E            	  1187:     bsr     .inc_ppuaddr
02:00001F2A 4CDF037F        	  1188:     movem.l (SP)+,D0-D6/A0-A1
02:00001F2E 4E75            	  1189:     rts
                            	  1190: 
                            	  1191:     ifne CHR_EXPANSION_ENABLED
                            	  1192:     ; T-CHR S8 v2: NES sprite sub-palette → CRAM base address (PAL slot 4).
                            	  1193:     ; Slots 1..3 (color indices 1..3) are written relative to this base.
                            	  1194: .t19_spr_cram_base:
02:00001F30 0008            	  1195:     dc.w    $08                 ; sub-pal 0 → PAL0[4]  (CRAM $08..$0E)
02:00001F32 0010            	  1196:     dc.w    $10                 ; sub-pal 1 → PAL0[8]  (CRAM $10..$16)
02:00001F34 0018            	  1197:     dc.w    $18                 ; sub-pal 2 → PAL0[12] (CRAM $18..$1E)
02:00001F36 0028            	  1198:     dc.w    $28                 ; sub-pal 3 → PAL1[4]  (CRAM $28..$2E)
                            	  1199:     endc
                            	  1200: 
                            	  1201:     ;==========================================================================
                            	  1202:     ; .inc_ppuaddr — advance PPU_VADDR by 1 or 32.
                            	  1203:     ; PPUCTRL bit 2: 0 → +1 horizontal, 1 → +32 vertical.
                            	  1204:     ; Modifies D1.w.
                            	  1205:     ;==========================================================================
                            	  1206: .inc_ppuaddr:
02:00001F38 323900FF0802    	  1207:     move.w  (PPU_VADDR).l,D1
02:00001F3E 0839000200FF0804	  1208:     btst    #2,(PPU_CTRL).l
02:00001F46 6604            	  1209:     bne.s   .inc32
02:00001F48 5241            	  1210:     addq.w  #1,D1
02:00001F4A 6004            	  1211:     bra.s   .store_inc
                            	  1212: .inc32:
02:00001F4C 06410020        	  1213:     addi.w  #32,D1
                            	  1214: .store_inc:
02:00001F50 02413FFF        	  1215:     andi.w  #$3FFF,D1               ; clamp to valid PPU address range
02:00001F54 33C100FF0802    	  1216:     move.w  D1,(PPU_VADDR).l
02:00001F5A 4E75            	  1217:     rts
                            	  1218: 
                            	  1219:     ;==========================================================================
                            	  1220:     ; .chr_convert_upload — convert 16-byte NES 2BPP tile to 32-byte Genesis
                            	  1221:     ;                        4BPP and write to VDP VRAM.
                            	  1222:     ;
                            	  1223:     ; Input: CHR_TILE_BUF holds the 16 tile bytes.
                            	  1224:     ;        CHR_BUF_VADDR holds the NES CHR base address (× 16-aligned).
                            	  1225:     ;
                            	  1226:     ; Genesis VRAM tile address = CHR_BUF_VADDR × 2 (tiles are 32 bytes each).
                            	  1227:     ;
                            	  1228:     ; For each of 8 rows:
                            	  1229:     ;   plane0_row = CHR_TILE_BUF[row]       (bit 0 of each of 8 pixels)
                            	  1230:     ;   plane1_row = CHR_TILE_BUF[row+8]     (bit 1 of each of 8 pixels)
                            	  1231:     ;
                            	  1232:     ; Pixel color = (plane1_bit << 1) | plane0_bit  →  4-bit Genesis nibble
                            	  1233:     ;
                            	  1234:     ; Output format per row (4 Genesis bytes = 2 VDP words):
                            	  1235:     ;   byte 0: pixels 0,1  (high nibble = pixel 0, low nibble = pixel 1)
                            	  1236:     ;   byte 1: pixels 2,3
                            	  1237:     ;   byte 2: pixels 4,5
                            	  1238:     ;   byte 3: pixels 6,7
                            	  1239:     ;
                            	  1240:     ; expand_nibble(n) helper: scatters 4-bit value n to positions 12,8,4,0
                            	  1241:     ; of a 16-bit word (one bit per nibble).  Then OR-ing plane0 expansion
                            	  1242:     ; with (plane1 expansion << 1) gives the correct Genesis word.
                            	  1243:     ;
                            	  1244:     ; Uses D0–D5/A0 (all caller-saved at _ppu_write_7 entry).
                            	  1245:     ;==========================================================================
                            	  1246: _chr_convert_upload:
                            	  1247:     ; Set VDP write address: Genesis tile addr = NES CHR addr × 2
02:00001F5C 323900FF0832    	  1248:     move.w  (CHR_BUF_VADDR).l,D1
02:00001F62 D241            	  1249:     add.w   D1,D1                   ; D1.w = NES_addr × 2  (lsl #1)
                            	  1250:     ; VDP VRAM write command for D1.w (< $4000, so upper word = 0):
                            	  1251:     ; Use moveq+move.w to guarantee D2 upper = 0 before swap.
                            	  1252:     ; (plain move.l D1,D2 would propagate garbage from D1 upper 16 bits
                            	  1253:     ;  into the CD/address bits of the VDP command after swap.)
02:00001F64 7400            	  1254:     moveq   #0,D2
02:00001F66 3401            	  1255:     move.w  D1,D2                   ; D2.w = NES_addr × 2  (D2 upper guaranteed 0)
02:00001F68 4842            	  1256:     swap    D2                      ; D2 = (NES_addr × 2) << 16
02:00001F6A 008240000000    	  1257:     ori.l   #$40000000,D2           ; VDP VRAM-write command
02:00001F70 23C200C00004    	  1258:     move.l  D2,(VDP_CTRL).l
                            	  1259: 
02:00001F76 41F900FF0820    	  1260:     lea     (CHR_TILE_BUF).l,A0     ; A0 → plane-0 row bytes (0..7)
02:00001F7C 43F900001FDA    	  1261:     lea     (.expand_nibble_lut).l,A1 ; A1 → LUT (kept across all rows)
02:00001F82 7A07            	  1262:     moveq   #7,D5                   ; 8 rows, counter 7..0
                            	  1263: 
                            	  1264: .ccu_row:
02:00001F84 1610            	  1265:     move.b  0(A0),D3                ; D3.b = plane 0 for this row
02:00001F86 18280008        	  1266:     move.b  8(A0),D4                ; D4.b = plane 1 for this row
02:00001F8A 5288            	  1267:     addq.l  #1,A0                   ; advance to next plane-0 row byte
                            	  1268: 
                            	  1269:     ; ---- Pixels 0-3 (upper nibbles of D3 and D4) ----
02:00001F8C 1203            	  1270:     move.b  D3,D1
02:00001F8E E809            	  1271:     lsr.b   #4,D1                   ; D1.b = upper nibble of plane0 (pix 0-3)
02:00001F90 0201000F        	  1272:     andi.b  #$0F,D1
02:00001F94 6138            	  1273:     bsr     .expand_nibble          ; D2.w = plane0 expansion (bit0 of each nibble)
02:00001F96 3C02            	  1274:     move.w  D2,D6                   ; save plane0 expansion in D6 (D0 clobbered by expand)
                            	  1275: 
02:00001F98 1204            	  1276:     move.b  D4,D1
02:00001F9A E809            	  1277:     lsr.b   #4,D1                   ; D1.b = upper nibble of plane1 (pix 0-3)
02:00001F9C 0201000F        	  1278:     andi.b  #$0F,D1
02:00001FA0 612C            	  1279:     bsr     .expand_nibble          ; D2.w = plane1 expansion
02:00001FA2 E34A            	  1280:     lsl.w   #1,D2                   ; ×2 → puts plane1 bits in bit1 of each nibble
02:00001FA4 8446            	  1281:     or.w    D6,D2                   ; combine: each nibble = (p1_bit<<1)|p0_bit
02:00001FA6 33C200C00000    	  1282:     move.w  D2,(VDP_DATA).l         ; write pixels 0-3 (2 VDP bytes via auto-incr)
                            	  1283: 
                            	  1284:     ; ---- Pixels 4-7 (lower nibbles of D3 and D4) ----
02:00001FAC 1203            	  1285:     move.b  D3,D1
02:00001FAE 0201000F        	  1286:     andi.b  #$0F,D1                 ; D1.b = lower nibble of plane0 (pix 4-7)
02:00001FB2 611A            	  1287:     bsr     .expand_nibble
02:00001FB4 3C02            	  1288:     move.w  D2,D6                   ; save plane0 expansion in D6
                            	  1289: 
02:00001FB6 1204            	  1290:     move.b  D4,D1
02:00001FB8 0201000F        	  1291:     andi.b  #$0F,D1                 ; D1.b = lower nibble of plane1 (pix 4-7)
02:00001FBC 6110            	  1292:     bsr     .expand_nibble
02:00001FBE E34A            	  1293:     lsl.w   #1,D2                   ; ×2 for plane1
02:00001FC0 8446            	  1294:     or.w    D6,D2
02:00001FC2 33C200C00000    	  1295:     move.w  D2,(VDP_DATA).l         ; write pixels 4-7
                            	  1296: 
02:00001FC8 5305            	  1297:     subq.b  #1,D5
02:00001FCA 6CB8            	  1298:     bge.s   .ccu_row                ; loop for all 8 rows
02:00001FCC 4E75            	  1299:     rts
                            	  1300: 
                            	  1301:     ;==========================================================================
                            	  1302:     ; .expand_nibble — scatter 4-bit nibble to bit-0 of each output nibble.
                            	  1303:     ;
                            	  1304:     ; Input:  D1.b = 4-bit value n (bits 3..0 = pixels 0..3 of one plane)
                            	  1305:     ; Output: D2.w = bit3→pos12, bit2→pos8, bit1→pos4, bit0→pos0
                            	  1306:     ;
                            	  1307:     ; Uses lookup table for speed: 2 instructions instead of ~24.
                            	  1308:     ;==========================================================================
                            	  1309: .expand_nibble:
02:00001FCE 0241000F        	  1310:     andi.w  #$000F,D1               ; mask to 4 bits, zero-extend
02:00001FD2 D241            	  1311:     add.w   D1,D1                   ; word offset into table
02:00001FD4 34311000        	  1312:     move.w  (A1,D1.W),D2            ; D2.w = expanded nibble (A1 = LUT base)
02:00001FD8 4E75            	  1313:     rts
                            	  1314: 
                            	  1315:     ;==========================================================================
                            	  1316:     ; 16-entry lookup table: nibble → scattered bits.
                            	  1317:     ;   Entry n: bit3→bit12, bit2→bit8, bit1→bit4, bit0→bit0
                            	  1318:     ;   e.g. $F (1111) → $1111, $A (1010) → $1010, $5 (0101) → $0101
                            	  1319:     ;==========================================================================
                            	  1320:     even
                            	  1321: .expand_nibble_lut:
02:00001FDA 0000            	  1322:     dc.w    $0000   ; 0000
02:00001FDC 0001            	  1323:     dc.w    $0001   ; 0001
02:00001FDE 0010            	  1324:     dc.w    $0010   ; 0010
02:00001FE0 0011            	  1325:     dc.w    $0011   ; 0011
02:00001FE2 0100            	  1326:     dc.w    $0100   ; 0100
02:00001FE4 0101            	  1327:     dc.w    $0101   ; 0101
02:00001FE6 0110            	  1328:     dc.w    $0110   ; 0110
02:00001FE8 0111            	  1329:     dc.w    $0111   ; 0111
02:00001FEA 1000            	  1330:     dc.w    $1000   ; 1000
02:00001FEC 1001            	  1331:     dc.w    $1001   ; 1001
02:00001FEE 1010            	  1332:     dc.w    $1010   ; 1010
02:00001FF0 1011            	  1333:     dc.w    $1011   ; 1011
02:00001FF2 1100            	  1334:     dc.w    $1100   ; 1100
02:00001FF4 1101            	  1335:     dc.w    $1101   ; 1101
02:00001FF6 1110            	  1336:     dc.w    $1110   ; 1110
02:00001FF8 1111            	  1337:     dc.w    $1111   ; 1111
                            	  1338: 
02:00001FFA 4E75            	  1339:     rts
                            	  1340: 
                            	  1341:     ifne CHR_EXPANSION_ENABLED
                            	  1342: ;==============================================================================
                            	  1343: ; _chr_upload_sprite_4x — upload one NES sprite CHR tile to 4 Gen VRAM copies
                            	  1344: ;                         with pre-biased pixel values.
                            	  1345: ;
                            	  1346: ; Input:  CHR_TILE_BUF     = 16 NES 2bpp tile bytes
                            	  1347: ;         CHR_BUF_VADDR    = NES CHR address (16-aligned)
                            	  1348: ;
                            	  1349: ; Output: lower-half sprite CHR populates the normal sprite-copy banks.
                            	  1350: ;         upper-half CHR during NES 8x16 mode populates only the safe banks
                            	  1351: ;         used by the nonzero sprite sub-palettes, so BG pattern-table 1 tiles
                            	  1352: ;         are not clobbered.
                            	  1353: ;
                            	  1354: ; Pixel 0 (transparent) is preserved across all 4 copies — bias is only
                            	  1355: ; applied to nonzero pixels via a nibble mask.
                            	  1356: ;
                            	  1357: ; Bias mechanism (mask-based, no per-copy LUTs):
                            	  1358: ;   1. expand plane0 and plane1 via existing 16-entry .expand_nibble_lut
                            	  1359: ;   2. nonzero_mask = plane0_exp | plane1_exp  ($0 or $1 per nibble)
                            	  1360: ;   3. bias_word_per_copy:  $0000, $4444, $8888, $CCCC
                            	  1361: ;   4. mask_F = mask | mask<<1 | mask<<2 | mask<<3 ($0 or $F per nibble)
                            	  1362: ;   5. bias_add = mask_F & bias_word  ($0 or bias per nonzero nibble)
                            	  1363: ;   6. final = orig_pixels | bias_add  (no nibble overflow: orig <= 3, bias <= 12)
                            	  1364: ;
                            	  1365: ; Clobbers D0-D7, A0-A2.
                            	  1366: ;==============================================================================
                            	  1367: _chr_upload_sprite_4x:
02:00001FFC 48E7FFE0        	  1368:     movem.l D0-D7/A0-A2,-(SP)           ; save everything (helper clobbers D0-D7, A0-A2)
02:00002000 303900FF0832    	  1369:     move.w  (CHR_BUF_VADDR).l,D0
02:00002006 0800000C        	  1370:     btst    #12,D0
02:0000200A 6714            	  1371:     beq.s   .csfx_use_lo_tbl
02:0000200C 0839000500FF0804	  1372:     btst    #5,(PPU_CTRL).l
02:00002014 670A            	  1373:     beq.s   .csfx_use_lo_tbl
02:00002016 45F90000212E    	  1374:     lea     (.csfx_hi_copy_base_tbl).l,A2
02:0000201C 7A01            	  1375:     moveq   #1,D5                       ; upper-half 8x16 support: banks B/C only
02:0000201E 6008            	  1376:     bra.s   .csfx_copy_loop
                            	  1377: .csfx_use_lo_tbl:
02:00002020 45F90000210E    	  1378:     lea     (.csfx_copy_base_tbl).l,A2
02:00002026 7A03            	  1379:     moveq   #3,D5                       ; 4 copies, counter 3..0
                            	  1380: .csfx_copy_loop:
                            	  1381:     ; Recompute tile offset each iteration because .csfx_row (below) clobbers
                            	  1382:     ; D3/D4 with plane0/plane1 row bytes. Previously this lived before the
                            	  1383:     ; loop and caused copies 1-3 to land at misaligned VRAM addresses.
02:00002028 363900FF0832    	  1384:     move.w  (CHR_BUF_VADDR).l,D3
02:0000202E D643            	  1385:     add.w   D3,D3                       ; D3.w = gen tile offset (NES_addr * 2)
02:00002030 02830000FFFF    	  1386:     andi.l  #$0000FFFF,D3               ; zero-extend for safe .l math
02:00002036 281A            	  1387:     move.l  (A2)+,D4                    ; D4.l = copy base VRAM addr
02:00002038 D883            	  1388:     add.l   D3,D4                       ; D4.l = tile VRAM addr for this copy
02:0000203A 2E1A            	  1389:     move.l  (A2)+,D7                    ; D7.l = bias word (low 16 bits used)
                            	  1390:     ; Build VDP VRAM write command in D2.l:
                            	  1391:     ;   cmd = $40000000 | ((addr & $3FFF) << 16) | ((addr >> 14) & $0003)
02:0000203C 2004            	  1392:     move.l  D4,D0
02:0000203E 028000003FFF    	  1393:     andi.l  #$00003FFF,D0
02:00002044 4840            	  1394:     swap    D0
02:00002046 008040000000    	  1395:     ori.l   #$40000000,D0
02:0000204C 2404            	  1396:     move.l  D4,D2
02:0000204E E08A            	  1397:     lsr.l   #8,D2
02:00002050 EC8A            	  1398:     lsr.l   #6,D2
02:00002052 028200000003    	  1399:     andi.l  #$00000003,D2
02:00002058 8082            	  1400:     or.l    D2,D0
02:0000205A 23C000C00004    	  1401:     move.l  D0,(VDP_CTRL).l
                            	  1402: 
02:00002060 41F900FF0820    	  1403:     lea     (CHR_TILE_BUF).l,A0
02:00002066 43F9000020EE    	  1404:     lea     (.csfx_expand_lut).l,A1
02:0000206C 7007            	  1405:     move.l  #7,D0
                            	  1406:     ; Using D0 as row counter conflicts with expand_nibble which clobbers D0/D1/D2.
                            	  1407:     ; Save row counter on stack per iteration.
                            	  1408: .csfx_row:
02:0000206E 2F00            	  1409:     move.l  D0,-(SP)                    ; save row counter
02:00002070 1610            	  1410:     move.b  0(A0),D3                    ; D3.b = plane0 row
02:00002072 18280008        	  1411:     move.b  8(A0),D4                    ; D4.b = plane1 row
02:00002076 5288            	  1412:     addq.l  #1,A0
                            	  1413: 
                            	  1414:     ; ---- Pixels 0-3 (upper nibbles) ----
02:00002078 1203            	  1415:     move.b  D3,D1
02:0000207A E809            	  1416:     lsr.b   #4,D1
02:0000207C 0201000F        	  1417:     andi.b  #$0F,D1
02:00002080 6160            	  1418:     bsr     .csfx_expand                ; D2.w = plane0 expand
02:00002082 3C02            	  1419:     move.w  D2,D6                       ; D6 = plane0 expand
02:00002084 1204            	  1420:     move.b  D4,D1
02:00002086 E809            	  1421:     lsr.b   #4,D1
02:00002088 0201000F        	  1422:     andi.b  #$0F,D1
02:0000208C 6154            	  1423:     bsr     .csfx_expand              ; D2.w = plane1 expand
02:0000208E 3002            	  1424:     move.w  D2,D0                       ; D0.w = plane1 expand
02:00002090 8046            	  1425:     or.w    D6,D0                       ; D0.w = nonzero mask ($0/$1 per nibble)
02:00002092 E34A            	  1426:     lsl.w   #1,D2
02:00002094 8446            	  1427:     or.w    D6,D2                       ; D2.w = raw pixel nibbles
02:00002096 6138            	  1428:     bsr     .csfx_apply_bias            ; merges bias using D0(mask), D7(bias)
02:00002098 33C200C00000    	  1429:     move.w  D2,(VDP_DATA).l
                            	  1430: 
                            	  1431:     ; ---- Pixels 4-7 (lower nibbles) ----
02:0000209E 1203            	  1432:     move.b  D3,D1
02:000020A0 0201000F        	  1433:     andi.b  #$0F,D1
02:000020A4 613C            	  1434:     bsr     .csfx_expand
02:000020A6 3C02            	  1435:     move.w  D2,D6
02:000020A8 1204            	  1436:     move.b  D4,D1
02:000020AA 0201000F        	  1437:     andi.b  #$0F,D1
02:000020AE 6132            	  1438:     bsr     .csfx_expand
02:000020B0 3002            	  1439:     move.w  D2,D0
02:000020B2 8046            	  1440:     or.w    D6,D0
02:000020B4 E34A            	  1441:     lsl.w   #1,D2
02:000020B6 8446            	  1442:     or.w    D6,D2
02:000020B8 6116            	  1443:     bsr     .csfx_apply_bias
02:000020BA 33C200C00000    	  1444:     move.w  D2,(VDP_DATA).l
                            	  1445: 
02:000020C0 201F            	  1446:     move.l  (SP)+,D0                    ; restore row counter
02:000020C2 5380            	  1447:     subq.l  #1,D0
02:000020C4 6CA8            	  1448:     bge.s   .csfx_row
                            	  1449: 
02:000020C6 51CDFF60        	  1450:     dbra    D5,.csfx_copy_loop
02:000020CA 4CDF07FF        	  1451:     movem.l (SP)+,D0-D7/A0-A2
02:000020CE 4E75            	  1452:     rts
                            	  1453: 
                            	  1454:     ;==========================================================================
                            	  1455:     ; .csfx_apply_bias — add per-copy bias to nonzero pixel nibbles.
                            	  1456:     ; In:  D0.w = nonzero mask ($0/$1 per nibble)
                            	  1457:     ;      D2.w = raw pixel nibbles
                            	  1458:     ;      D7.w = bias word ($0000/$4444/$8888/$CCCC)
                            	  1459:     ; Out: D2.w = biased pixel nibbles
                            	  1460:     ; Clobbers D0, D1.
                            	  1461:     ;==========================================================================
                            	  1462: .csfx_apply_bias:
02:000020D0 3200            	  1463:     move.w  D0,D1
02:000020D2 E349            	  1464:     lsl.w   #1,D1
02:000020D4 8041            	  1465:     or.w    D1,D0
02:000020D6 3200            	  1466:     move.w  D0,D1
02:000020D8 E549            	  1467:     lsl.w   #2,D1
02:000020DA 8041            	  1468:     or.w    D1,D0                       ; D0 now has $F per nonzero nibble
02:000020DC C047            	  1469:     and.w   D7,D0                       ; D0 = bias_add (bias per nonzero nibble)
02:000020DE 8440            	  1470:     or.w    D0,D2                       ; merge into pixel nibbles
02:000020E0 4E75            	  1471:     rts
                            	  1472: 
                            	  1473:     ;==========================================================================
                            	  1474:     ; .csfx_expand — local copy of the nibble expander used by _chr_convert_upload.
                            	  1475:     ; In:  D1.b = 4-bit nibble, A1 = .csfx_expand_lut
                            	  1476:     ; Out: D2.w = bit3→pos12, bit2→pos8, bit1→pos4, bit0→pos0
                            	  1477:     ;==========================================================================
                            	  1478: .csfx_expand:
02:000020E2 0241000F        	  1479:     andi.w  #$000F,D1
02:000020E6 D241            	  1480:     add.w   D1,D1
02:000020E8 34311000        	  1481:     move.w  (A1,D1.W),D2
02:000020EC 4E75            	  1482:     rts
                            	  1483: 
                            	  1484:     even
                            	  1485: .csfx_expand_lut:
02:000020EE 0000            	  1486:     dc.w    $0000,$0001,$0010,$0011
02:000020F0 0001
02:000020F2 0010
02:000020F4 0011
02:000020F6 0100            	  1487:     dc.w    $0100,$0101,$0110,$0111
02:000020F8 0101
02:000020FA 0110
02:000020FC 0111
02:000020FE 1000            	  1488:     dc.w    $1000,$1001,$1010,$1011
02:00002100 1001
02:00002102 1010
02:00002104 1011
02:00002106 1100            	  1489:     dc.w    $1100,$1101,$1110,$1111
02:00002108 1101
02:0000210A 1110
02:0000210C 1111
                            	  1490: 
                            	  1491:     even
                            	  1492: .csfx_copy_base_tbl:
                            	  1493:     ; 4 entries, 8 bytes each: (base_vram .l, bias_word_as_long .l)
                            	  1494:     ; Bias word sits in the low 16 bits of the long so `move.l (A2)+,D7`
                            	  1495:     ; leaves the bias in D7.w for the .w AND in .csfx_apply_bias.
                            	  1496:     ; T-CHR v9: sub-pal→CRAM slot mapping via pixel bias + Gen-pal bits (OAM).
                            	  1497:     ;   copy 0 / shared bank A (sub-pal 0 + sub-pal 3): bias +$4
                            	  1498:     ;   copy 1 / bank B (sub-pal 1): bias +$8
                            	  1499:     ;   copy 2 / bank C (sub-pal 2): bias +$C
                            	  1500:     ;   copy 3 reuses bank A because sub-pal 3 needs the same +$4 biased pixels
                            	  1501:     ;   as sub-pal 0; only the SAT palette bits differ. This frees the old bank-C
                            	  1502:     ;   overlap so 8x16 table-1 sprites like the item-roll heart can use upper-half
                            	  1503:     ;   tile pairs without colliding with another sprite copy.
02:0000210E 00000000        	  1504:     dc.l    $00000000,$00004444
02:00002112 00004444
02:00002116 00004000        	  1505:     dc.l    $00004000,$00008888
02:0000211A 00008888
02:0000211E 00008000        	  1506:     dc.l    $00008000,$0000CCCC
02:00002122 0000CCCC
02:00002126 00000000        	  1507:     dc.l    $00000000,$00004444
02:0000212A 00004444
                            	  1508: .csfx_hi_copy_base_tbl:
                            	  1509:     ; Upper-half CHR mirrored for NES 8x16 sprites. Only the safe banks used by
                            	  1510:     ; sub-pal 1 (+8) and sub-pal 2 (+C) are populated here.
02:0000212E 00004000        	  1511:     dc.l    $00004000,$00008888
02:00002132 00008888
02:00002136 00008000        	  1512:     dc.l    $00008000,$0000CCCC
02:0000213A 0000CCCC
                            	  1513:     endc
                            	  1514: 
                            	  1515: ;==============================================================================
                            	  1516: ; _compose_bg_tile_word — add the active BG pattern-table offset to a raw tile.
                            	  1517: ;
                            	  1518: ; Input:  D0.w = raw NES BG tile index (0..255)
                            	  1519: ; Output: D0.w = Genesis tile word: bit 15 (high prio) | tile index
                            	  1520: ; Uses no other registers.
                            	  1521: ;
                            	  1522: ; Attempt 5g (diary 2026-04-04 12:37:44): Plane A BG tiles are promoted to
                            	  1523: ; high priority so text and board glyphs can sit in front of sprites that
                            	  1524: ; NES OAM marks as behind-background (attr bit 5). _oam_dma pairs with this
                            	  1525: ; by honoring attr bit 5 and leaving those sprites low-priority.
                            	  1526: ;==============================================================================
                            	  1527: _compose_bg_tile_word:
02:0000213E 024000FF        	  1528:     andi.w  #$00FF,D0               ; raw tile index only
02:00002142 0839000400FF0804	  1529:     btst    #4,(PPU_CTRL).l
02:0000214A 6704            	  1530:     beq.s   .cbgtw_done
02:0000214C 00400100        	  1531:     ori.w   #$0100,D0               ; BG pattern table 1 → VRAM $1000
                            	  1532: .cbgtw_done:
02:00002150 00408000        	  1533:     ori.w   #$8000,D0               ; bit 15 = high priority (Attempt 5g)
02:00002154 4E75            	  1534:     rts
                            	  1535: 
                            	  1536: ;==============================================================================
                            	  1537: ; _attr_write_2x2 — write palette bits into a 2x2 tile block.
                            	  1538: ;
                            	  1539: ; Input: D2.w = col (top-left tile), D3.w = row (top-left tile)
                            	  1540: ;        D5.w = palette << 13  (Genesis tile word palette bits [14:13])
                            	  1541: ; All inputs preserved.  Uses D0, D1, A0 as scratch.
                            	  1542: ;==============================================================================
                            	  1543: _attr_write_2x2:
02:00002156 6110            	  1544:     bsr     _attr_write_one_tile        ; (row,   col)
02:00002158 5242            	  1545:     addq.w  #1,D2
02:0000215A 610C            	  1546:     bsr     _attr_write_one_tile        ; (row,   col+1)
02:0000215C 5243            	  1547:     addq.w  #1,D3
02:0000215E 6108            	  1548:     bsr     _attr_write_one_tile        ; (row+1, col+1)
02:00002160 5342            	  1549:     subq.w  #1,D2
02:00002162 6104            	  1550:     bsr     _attr_write_one_tile        ; (row+1, col)
02:00002164 5343            	  1551:     subq.w  #1,D3
02:00002166 4E75            	  1552:     rts
                            	  1553: 
                            	  1554: ;==============================================================================
                            	  1555: ; _attr_write_one_tile — write one Plane A tile word with palette bits.
                            	  1556: ;
                            	  1557: ; Input: D2.w = col (0..31), D3.w = row (0..29), D5.w = palette << 13
                            	  1558: ; Reads tile index from NT_CACHE_BASE[row*32 + col].
                            	  1559: ; Writes tile word = (palette<<13) | tile_index to VDP Plane A.
                            	  1560: ; Inputs D2, D3, D5 preserved.  Uses D0, D1, A0.
                            	  1561: ;==============================================================================
                            	  1562: _attr_write_one_tile:
                            	  1563:     ; Bounds check (V64: NT0 rows 0-29, NT1 rows 30-59)
02:00002168 0C43003C        	  1564:     cmpi.w  #60,D3
02:0000216C 644C            	  1565:     bhs     .awt_skip           ; row >= 60 -> out of nametable
02:0000216E 0C420020        	  1566:     cmpi.w  #32,D2
02:00002172 6446            	  1567:     bhs     .awt_skip           ; col >= 32 -> out of nametable
                            	  1568: 
                            	  1569:     ; Load cached tile index: NT_CACHE[row*32 + col]
02:00002174 7200            	  1570:     moveq   #0,D1
02:00002176 3203            	  1571:     move.w  D3,D1
02:00002178 EB49            	  1572:     lsl.w   #5,D1               ; D1.w = row * 32
02:0000217A D242            	  1573:     add.w   D2,D1               ; D1.w = row*32 + col
02:0000217C 41F900FF0840    	  1574:     lea     (NT_CACHE_BASE).l,A0
02:00002182 7000            	  1575:     moveq   #0,D0
02:00002184 10301000        	  1576:     move.b  (A0,D1.W),D0        ; D0.b = tile index
                            	  1577: 
02:00002188 61B4            	  1578:     bsr     _compose_bg_tile_word
                            	  1579:     ; Build tile word: (palette<<13) | tile_index
02:0000218A 8045            	  1580:     or.w    D5,D0               ; D0.w = tile word with palette bits
                            	  1581: 
                            	  1582:     ; Compute Genesis VDP address: $C000 + row*$80 + col*2
02:0000218C 7200            	  1583:     moveq   #0,D1
02:0000218E 3203            	  1584:     move.w  D3,D1
02:00002190 EF89            	  1585:     lsl.l   #7,D1               ; D1.l = row * $80
02:00002192 D242            	  1586:     add.w   D2,D1
02:00002194 D242            	  1587:     add.w   D2,D1               ; D1.w += col * 2
02:00002196 0641C000        	  1588:     addi.w  #$C000,D1           ; D1.w = VDP address
                            	  1589: 
                            	  1590:     ; Issue VDP VRAM write command
02:0000219A 3F00            	  1591:     move.w  D0,-(SP)            ; save tile word
02:0000219C 2001            	  1592:     move.l  D1,D0
02:0000219E 028000003FFF    	  1593:     andi.l  #$00003FFF,D0
02:000021A4 4840            	  1594:     swap    D0
02:000021A6 008040000003    	  1595:     ori.l   #$40000003,D0       ; CD bits + A[15:14]=3
02:000021AC 23C000C00004    	  1596:     move.l  D0,(VDP_CTRL).l
02:000021B2 301F            	  1597:     move.w  (SP)+,D0            ; restore tile word
02:000021B4 33C000C00000    	  1598:     move.w  D0,(VDP_DATA).l     ; write to Plane A
                            	  1599: 
                            	  1600:     ; V64 gap rows 60-63 left blank — see _ppu_write_7 comment.
                            	  1601: 
                            	  1602: .awt_skip:
02:000021BA 4E75            	  1603:     rts
                            	  1604: 
                            	  1605: ;==============================================================================
                            	  1606: ; NES → Genesis palette lookup table
                            	  1607: ;
                            	  1608: ; 64 × 16-bit words: index = NES color byte (0–63).
                            	  1609: ; Genesis color format: $0BGR (bits [10:8]=Blue, [6:4]=Green, [2:0]=Red, 0–7 each).
                            	  1610: ; Source: title-calibrated NES palette approximations tuned against BizHawk
                            	  1611: ; frame-200 NES reference captures, quantized to Genesis 3-bit channels.
                            	  1612: ;==============================================================================
                            	  1613:     even
                            	  1614: nes_palette_to_genesis:
                            	  1615:     ;       NES $00–$0F  (grays, blues, purples, reds, greens)
                            	  1616:     ;       Genesis CRAM = (B<<9)|(G<<5)|(R<<1)  — NOT raw $0BGR nibbles
02:000021BC 0666            	  1617:     dc.w    $0666   ; $00  rgb(84,84,84)     dark gray (universal BG)
02:000021BE 0E00            	  1618:     dc.w    $0E00   ; $01  rgb(0,0,252)     dark blue
02:000021C0 0A00            	  1619:     dc.w    $0A00   ; $02  rgb(0,0,188)     dark blue
02:000021C2 0A24            	  1620:     dc.w    $0A24   ; $03  rgb(68,40,188)   blue-violet
02:000021C4 0808            	  1621:     dc.w    $0808   ; $04  rgb(148,0,132)   purple
02:000021C6 020A            	  1622:     dc.w    $020A   ; $05  rgb(168,0,32)    dark red-magenta
02:000021C8 000A            	  1623:     dc.w    $000A   ; $06  rgb(168,16,0)    dark red
02:000021CA 0028            	  1624:     dc.w    $0028   ; $07  rgb(136,20,0)    dark red-brown
02:000021CC 0044            	  1625:     dc.w    $0044   ; $08  dark olive-brown
02:000021CE 0060            	  1626:     dc.w    $0060   ; $09  rgb(0,120,0)     dark green
02:000021D0 0060            	  1627:     dc.w    $0060   ; $0A  rgb(0,104,0)     dark green
02:000021D2 0040            	  1628:     dc.w    $0040   ; $0B  rgb(0,88,0)      very dark green
02:000021D4 0440            	  1629:     dc.w    $0440   ; $0C  rgb(0,64,88)     dark teal
02:000021D6 0000            	  1630:     dc.w    $0000   ; $0D  black (unused/invalid)
02:000021D8 0000            	  1631:     dc.w    $0000   ; $0E  black (unused/invalid)
02:000021DA 0000            	  1632:     dc.w    $0000   ; $0F  black (unused/invalid)
                            	  1633: 
                            	  1634:     ;       NES $10–$1F  (light grays, bright blues/reds, mid greens, teals)
02:000021DC 0AAA            	  1635:     dc.w    $0AAA   ; $10  rgb(152,152,152)  light gray
02:000021DE 0E60            	  1636:     dc.w    $0E60   ; $11  rgb(0,120,248)   bright blue
02:000021E0 0E40            	  1637:     dc.w    $0E40   ; $12  rgb(0,88,248)    bright blue
02:000021E2 0E46            	  1638:     dc.w    $0E46   ; $13  rgb(104,68,252)  blue-violet
02:000021E4 0C0C            	  1639:     dc.w    $0C0C   ; $14  rgb(216,0,204)   bright magenta
02:000021E6 040C            	  1640:     dc.w    $040C   ; $15  rgb(228,0,88)    bright red
