Source: "genesis_shell.asm"
                            	   733: 
                            	   734: ;==============================================================================
                            	   735: ; DEBUG_TELEPORT — DPAD instant-teleport for overworld QA.
                            	   736: ;
                            	   737: ; Hooked from _L_z07_UpdateMode5Play_NotInMenu by transpile_6502.py patch
                            	   738: ; P37. When the player presses a DPAD direction while idle in an overworld
                            	   739: ; room, this routine snaps RoomId to the adjacent overworld room, clears
                            	   740: ; scroll/NT state, relays out the room, and returns D0=1 so the hook
                            	   741: ; skips the frame's normal play update. Otherwise returns D0=0.
                            	   742: ;
                            	   743: ; Gated by DEBUG_TELEPORT equ. DEBUG_TELEPORT=0 strips the entire routine.
                            	   744: ;
                            	   745: ; On entry: A4 = $00FF0000 (NES RAM base, maintained by the translated code).
                            	   746: ; Clobbers: D0-D3, A0. Preserves A4.
                            	   747: ;==============================================================================
                            	   748:     ifne DEBUG_TELEPORT
                            	   749: _debug_teleport_check:
                            	   750:     ; Overworld gate: CurLevel ($0010) must be 0 (OW, not UW/dungeon).
                            	   751:     tst.b   ($0010,A4)
                            	   752:     bne     .dtc_no
                            	   753:     ; Mode gate: GameMode ($0012) == $05 (play), GameSubmode ($0013) == $00.
                            	   754:     cmpi.b  #$05,($0012,A4)
                            	   755:     bne     .dtc_no
                            	   756:     tst.b   ($0013,A4)
                            	   757:     bne     .dtc_no
                            	   758:     ; DPAD gate: ButtonsPressed ($00F8) bits 0..3 (R/L/D/U).
                            	   759:     ;
                            	   760:     ; NES Zelda stores buttons in reverse wire order because ReadInputs
                            	   761:     ; builds the byte via `ROL ButtonsPressed, X` across 8 serial reads.
                            	   762:     ; First read (A) lands in bit 7, last read (Right) lands in bit 0.
                            	   763:     ; So the bit map is:
                            	   764:     ;   bit 7 = A     bit 6 = B      bit 5 = Select bit 4 = Start
                            	   765:     ;   bit 3 = Up    bit 2 = Down   bit 1 = Left   bit 0 = Right
                            	   766:     move.b  ($00F8,A4),D1
                            	   767:     andi.b  #$0F,D1
                            	   768:     beq     .dtc_no
                            	   769:     ; Direction index 0..3, matching NextRoomIdOffsets (U/D/L/R).
                            	   770:     moveq   #0,D0
                            	   771:     btst    #3,D1                   ; Up
                            	   772:     bne.s   .dtc_dir_set
                            	   773:     moveq   #1,D0
                            	   774:     btst    #2,D1                   ; Down
                            	   775:     bne.s   .dtc_dir_set
                            	   776:     moveq   #2,D0
                            	   777:     btst    #1,D1                   ; Left
                            	   778:     bne.s   .dtc_dir_set
                            	   779:     moveq   #3,D0                   ; Right (bit 0)
                            	   780: .dtc_dir_set:
                            	   781:     ; Edge gate. RoomId ($00EB): row = bits 4..7, col = bits 0..3.
                            	   782:     ; NextRoomIdOffsets is pure arithmetic (-16/+16/-1/+1); without this
                            	   783:     ; gate, pressing Left from row 1 col 0 would wrap to row 0 col 15,
                            	   784:     ; which is not an adjacent neighbour on the 8x16 OW grid.
                            	   785:     move.b  ($00EB,A4),D2
                            	   786:     move.b  D2,D3
                            	   787:     lsr.b   #4,D2                      ; row = RoomId >> 4
                            	   788:     andi.b  #$0F,D3                    ; col = RoomId & $0F
                            	   789:     tst.b   D0
                            	   790:     bne.s   .dtc_not_up
                            	   791:     tst.b   D2
                            	   792:     beq     .dtc_edge                   ; Up and row=0 -> reject
                            	   793:     bra.s   .dtc_apply
                            	   794: .dtc_not_up:
                            	   795:     cmpi.b  #1,D0
                            	   796:     bne.s   .dtc_not_down
                            	   797:     cmpi.b  #7,D2
                            	   798:     bcc     .dtc_edge                   ; Down and row>=7 -> reject
                            	   799:     bra.s   .dtc_apply
                            	   800: .dtc_not_down:
                            	   801:     cmpi.b  #2,D0
                            	   802:     bne.s   .dtc_not_left
                            	   803:     tst.b   D3
                            	   804:     beq     .dtc_edge                   ; Left and col=0 -> reject
                            	   805:     bra.s   .dtc_apply
                            	   806: .dtc_not_left:
                            	   807:     cmpi.b  #$0F,D3
                            	   808:     bcc     .dtc_edge                   ; Right and col>=15 -> reject
                            	   809: .dtc_apply:
                            	   810:     ; Apply NextRoomIdOffsets[D0] to RoomId.
                            	   811:     lea     (NextRoomIdOffsets).l,A0
                            	   812:     move.b  (A0,D0.W),D1               ; signed byte offset
                            	   813:     move.b  ($00EB,A4),D0
                            	   814:     add.b   D1,D0
                            	   815:     move.b  D0,($00EB,A4)
                            	   816:     ; Reset scroll / NT base state so the new room renders at origin.
                            	   817:     clr.b   ($00FC,A4)                 ; CurVScroll
                            	   818:     clr.b   ($00FD,A4)                 ; CurHScroll
                            	   819:     clr.b   ($005F,A4)                 ; OddBaseNameTableOverride
                            	   820:     ; Nudge Link toward the center of the new screen so the next frame's
                            	   821:     ; movement update doesn't immediately retrigger the edge.
                            	   822:     move.b  #$78,($0070,A4)            ; ObjX (Link slot 0) ~= 120
                            	   823:     move.b  #$8D,($0084,A4)            ; ObjY ~= 141
                            	   824:     ; Relay out the current room via the top-level LayOutRoom entry.
                            	   825:     ; LayOutRoom runs PatchColumnDirectoryForCellar then LayoutRoomOW +
                            	   826:     ; CheckShortcut, preserving the cache seed at $FF1102 that
                            	   827:     ; LayoutRoomOrCaveOW reads. Calling LayoutRoomOrCaveOW directly would
                            	   828:     ; skip that setup.
                            	   829:     jsr     LayOutRoom
                            	   830:     ; NOTE: Plane A won't visibly refresh until the normal transfer
                            	   831:     ; pipeline (DynTileBuf / InitMode7_Sub2..Sub6) runs. Attempting to
                            	   832:     ; kick that from here with arbitrary state causes crashes when the
                            	   833:     ; source Link-walk direction / door flags aren't coherent. Caller
                            	   834:     ; (sweep script) should use the playmap in NES RAM ($FF6530) as
                            	   835:     ; authoritative for parity comparison — it IS updated by LayOutRoom
                            	   836:     ; per target room.
                            	   837:     clr.b   ($00F8,A4)
                            	   838:     clr.b   ($00FA,A4)                 ; also clear ButtonsDown so Link
                            	   839:                                          ; doesn't walk during sweep settle
                            	   840:     moveq   #1,D0
                            	   841:     rts
                            	   842: .dtc_edge:
                            	   843:     ; Pressed into an edge. Consume the frame so normal play doesn't
                            	   844:     ; interpret it as "walk into wall" animation.
                            	   845:     clr.b   ($00F8,A4)
                            	   846:     clr.b   ($00FA,A4)
                            	   847:     moveq   #1,D0
                            	   848:     rts
                            	   849: .dtc_no:
                            	   850:     moveq   #0,D0
                            	   851:     rts
                            	   852:     endc
