                            	   854: ;==============================================================================
                            	   855: ; TURBO_LINK — OW-only speed + no-clip boost. Called from the end of
                            	   856: ; UpdatePlayer (via transpile_6502.py patch P39). Runs AFTER the normal
                            	   857: ; Walker_Move collision pass, so any extra movement this routine writes
                            	   858: ; to ObjX/ObjY is not re-checked against tile collision this frame.
                            	   859: ;==============================================================================
                            	   860:     ifne TURBO_LINK
                            	   861: _turbo_link_boost:
                            	   862:     ; Disabled body: $73 freezes ~240 frames after entry whenever
                            	   863:     ; this routine writes any Link state (ObjX, ObjGridOffset,
                            	   864:     ; ObjQSpeedFrac, or triggers Walker_Move). Leaving as no-op rts
                            	   865:     ; so TURBO_LINK=1 still assembles but doesn't mis-behave.
02:0003D27A 4E75            	   866:     rts
                            	   867: _turbo_link_boost_disabled:
                            	   868:     ; OW gate
02:0003D27C 4A2C0010        	   869:     tst.b   ($0010,A4)
02:0003D280 6670            	   870:     bne     .tlb_exit
                            	   871:     ; Mode 5 / Submode 0 only
02:0003D282 0C2C00050012    	   872:     cmpi.b  #$05,($0012,A4)
02:0003D288 6668            	   873:     bne     .tlb_exit
02:0003D28A 4A2C0013        	   874:     tst.b   ($0013,A4)
02:0003D28E 6662            	   875:     bne     .tlb_exit
                            	   876:     ; DPAD held (ButtonsDown bits 0..3 = R/L/D/U in reversed order)
02:0003D290 122C00FA        	   877:     move.b  ($00FA,A4),D1
02:0003D294 0201000F        	   878:     andi.b  #$0F,D1
02:0003D298 6758            	   879:     beq     .tlb_exit
                            	   880:     ; Edge-safe clamps.
02:0003D29A 08010003        	   881:     btst    #3,D1                   ; Up (bit 3)
02:0003D29E 6710            	   882:     beq     .tlb_no_up
02:0003D2A0 102C0084        	   883:     move.b  ($0084,A4),D0
02:0003D2A4 0C000040        	   884:     cmpi.b  #$40,D0
02:0003D2A8 6306            	   885:     bls     .tlb_no_up
02:0003D2AA 5900            	   886:     subi.b  #4,D0
02:0003D2AC 19400084        	   887:     move.b  D0,($0084,A4)
                            	   888: .tlb_no_up:
02:0003D2B0 08010002        	   889:     btst    #2,D1                   ; Down (bit 2)
02:0003D2B4 6710            	   890:     beq     .tlb_no_down
02:0003D2B6 102C0084        	   891:     move.b  ($0084,A4),D0
02:0003D2BA 0C0000D0        	   892:     cmpi.b  #$D0,D0
02:0003D2BE 6406            	   893:     bcc     .tlb_no_down
02:0003D2C0 5800            	   894:     addi.b  #4,D0
02:0003D2C2 19400084        	   895:     move.b  D0,($0084,A4)
                            	   896: .tlb_no_down:
02:0003D2C6 08010001        	   897:     btst    #1,D1                   ; Left (bit 1)
02:0003D2CA 6710            	   898:     beq     .tlb_no_left
02:0003D2CC 102C0070        	   899:     move.b  ($0070,A4),D0
02:0003D2D0 0C00000A        	   900:     cmpi.b  #$0A,D0
02:0003D2D4 6306            	   901:     bls     .tlb_no_left
02:0003D2D6 5900            	   902:     subi.b  #4,D0
02:0003D2D8 19400070        	   903:     move.b  D0,($0070,A4)
                            	   904: .tlb_no_left:
02:0003D2DC 08010000        	   905:     btst    #0,D1                   ; Right (bit 0)
02:0003D2E0 6710            	   906:     beq     .tlb_no_right
02:0003D2E2 102C0070        	   907:     move.b  ($0070,A4),D0
02:0003D2E6 0C0000E6        	   908:     cmpi.b  #$E6,D0
02:0003D2EA 6406            	   909:     bcc     .tlb_no_right
02:0003D2EC 5800            	   910:     addi.b  #4,D0
02:0003D2EE 19400070        	   911:     move.b  D0,($0070,A4)
