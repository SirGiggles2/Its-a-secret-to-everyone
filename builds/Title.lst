                            	  1008: .nt_noop:
                            	  1009:     ;======================================================================
                            	  1010:     ; T20: Attribute byte ($23C0–$23FF) → Genesis tile word palette bits.
                            	  1011:     ;
                            	  1012:     ; Each NES attribute byte covers a 4×4 tile block.  Two bits per quadrant:
                            	  1013:     ;   bits [1:0] = palette for quadrant 0 (top-left  2×2 tiles)
                            	  1014:     ;   bits [3:2] = palette for quadrant 1 (top-right 2×2 tiles)
                            	  1015:     ;   bits [5:4] = palette for quadrant 2 (bot-left  2×2 tiles)
                            	  1016:     ;   bits [7:6] = palette for quadrant 3 (bot-right 2×2 tiles)
                            	  1017:     ;
                            	  1018:     ; For each of the 16 affected tiles, look up the cached tile index
                            	  1019:     ; from NT_CACHE_BASE[row*32+col] and write the tile word to Plane A
                            	  1020:     ; with bits [12:11] set to the palette.  No VDP VRAM read required.
                            	  1021:     ;======================================================================
02:00001E20 0C413F00        	  1022:     cmpi.w  #$3F00,D1
02:00001E24 6400008A        	  1023:     bhs     .t19_palette            ; ≥$3F00: check palette range (widened for T39)
02:00001E28 0C4123C0        	  1024:     cmpi.w  #$23C0,D1
02:00001E2C 650000FA        	  1025:     blo     .nt_skip_write          ; $23C0 not reached yet — skip (shouldn't happen)
02:00001E30 0C412400        	  1026:     cmpi.w  #$2400,D1
02:00001E34 640000F2        	  1027:     bhs     .nt_skip_write          ; ≥$2400: overflow past attr table — skip
                            	  1028: 
                            	  1029:     ; ── T20 attribute decode ────────────────────────────�
                            	  1030:     ; offset = PPU_VADDR - $23C0 (0..63)
02:00001E38 3401            	  1031:     move.w  D1,D2
02:00001E3A 044223C0        	  1032:     subi.w  #$23C0,D2               ; D2.w = attribute offset (0..63)
                            	  1033: 
                            	  1034:     ; tile_base_col = (offset & 7) * 4,  tile_base_row = (offset >> 3) * 4
02:00001E3E 3602            	  1035:     move.w  D2,D3
02:00001E40 E64B            	  1036:     lsr.w   #3,D3
02:00001E42 E54B            	  1037:     lsl.w   #2,D3                   ; D3.w = tile_base_row (0..28)
                            	  1038:     ; T39 HUD/playfield split: same gate as the tile path. tile_base_row
                            	  1039:     ; is always a multiple of 4 (0, 4, 8, …, 28); an attr byte at row 0
                            	  1040:     ; covers tile rows 0-3 (HUD), at row 4+ covers playfield. Route
                            	  1041:     ; $2000-source attrs to HUD only, $2400-source attrs to playfield only.
02:00001E44 4A47            	  1042:     tst.w   D7
02:00001E46 6608            	  1043:     bne.s   .nt_attr_src_2400
                            	  1044:     ; $2000-source: allow only tile_base_row == 0 (HUD rows 0-3).
02:00001E48 4A43            	  1045:     tst.w   D3
02:00001E4A 660000DC        	  1046:     bne     .nt_skip_write
02:00001E4E 6008            	  1047:     bra.s   .nt_attr_row_ok
                            	  1048: .nt_attr_src_2400:
                            	  1049:     ; $2400-source: allow only tile_base_row >= 4 (playfield rows 4+).
02:00001E50 0C430004        	  1050:     cmpi.w  #4,D3
02:00001E54 650000D2        	  1051:     blo     .nt_skip_write
                            	  1052: .nt_attr_row_ok:
02:00001E58 02420007        	  1053:     andi.w  #$0007,D2
02:00001E5C E54A            	  1054:     lsl.w   #2,D2                   ; D2.w = tile_base_col (0..28)
                            	  1055: 
                            	  1056:     ; Save attribute byte in D4; process 4 quadrants using D5 = palette<<13
                            	  1057:     ; Genesis tile word palette field = bits [14:13].
                            	  1058:     ; palette<<13: lsl.w #5 then lsl.w #8 = total 13 bits  (immediate max is 8; both valid).
02:00001E5E 1800            	  1059:     move.b  D0,D4
                            	  1060: 
                            	  1061:     ; Quadrant 0: bits [1:0], row_off=0, col_off=0
02:00001E60 3A04            	  1062:     move.w  D4,D5
02:00001E62 02450003        	  1063:     andi.w  #$0003,D5
02:00001E66 EB4D            	  1064:     lsl.w   #5,D5
02:00001E68 E14D            	  1065:     lsl.w   #8,D5                   ; D5.w = palette<<13  (bits [14:13])
02:00001E6A 610002EA        	  1066:     bsr     _attr_write_2x2
                            	  1067: 
                            	  1068:     ; Quadrant 1: bits [3:2], row_off=0, col_off=+2
02:00001E6E 3A04            	  1069:     move.w  D4,D5
02:00001E70 E44D            	  1070:     lsr.w   #2,D5
02:00001E72 02450003        	  1071:     andi.w  #$0003,D5
02:00001E76 EB4D            	  1072:     lsl.w   #5,D5
02:00001E78 E14D            	  1073:     lsl.w   #8,D5
02:00001E7A 5442            	  1074:     addq.w  #2,D2
02:00001E7C 610002D8        	  1075:     bsr     _attr_write_2x2
02:00001E80 5542            	  1076:     subq.w  #2,D2
                            	  1077: 
                            	  1078:     ; Quadrant 2: bits [5:4], row_off=+2, col_off=0
02:00001E82 3A04            	  1079:     move.w  D4,D5
02:00001E84 E84D            	  1080:     lsr.w   #4,D5
02:00001E86 02450003        	  1081:     andi.w  #$0003,D5
02:00001E8A EB4D            	  1082:     lsl.w   #5,D5
02:00001E8C E14D            	  1083:     lsl.w   #8,D5
02:00001E8E 5443            	  1084:     addq.w  #2,D3
02:00001E90 610002C4        	  1085:     bsr     _attr_write_2x2
02:00001E94 5543            	  1086:     subq.w  #2,D3
                            	  1087: 
