02:0001EF48 2F01            	  1096:     move.l  D1,-(SP)
02:0001EF4A 4EB900000000    	  1097:     jsr     z05_calc_open_doorway_mask
02:0001EF50 508F            	  1098:     addq.l  #8,SP
