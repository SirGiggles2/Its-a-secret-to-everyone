                            	  4596: Aquamentus_Move:
                            	  4597:     ; The monster uses grid offset to mean distance remaining.
                            	  4598:     ; If there's more distance to cover, then go move.
                            	  4599:     ;
02:0002D948 41EC0394        	  4600:     lea     ($0394,A4),A0
02:0002D94C 10302000        	  4601:     move.b  (A0,D2.W),D0
02:0002D950 662C            	  4602:     bne  _L_z04_Aquamentus_Move_Move
                            	  4603:     ; Set a random distance to move of 7 or $F pixels.
                            	  4604:     ;
