02:0002D8AC 4EB90003C8E2    	  4521:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
                            	  4522:     ; If this is a child digdogger, then go draw it.
                            	  4523:     ;
02:0002D8B2 41EC046B        	  4524:     lea     ($046B,A4),A0
02:0002D8B6 10302000        	  4525:     move.b  (A0,D2.W),D0
02:0002D8BA 666C            	  4526:     bne  _L_z04_Digdogger_Draw_DrawLittle
                            	  4527:     ; For each part of the big digdogger, from 0 to 3,
                            	  4528:     ; indexed by Y register:
                            	  4529:     ;
02:0002D8BC 7600            	  4530:     moveq   #0,D3
                            	  4531:     even
                            	  4532: _L_z04_Digdogger_Draw_LoopPart:
                            	  4533:     ; Store in [00] the X coordinate offset for the current corner.
                            	  4534:     ;
02:0002D8BE 10342070        	  4535:     move.b  ($70,A4,D2.W),D0
02:0002D8C2 023C00EE        	  4536:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002D8C6 41F90002D89E    	  4537:     lea     (DigdoggerSpriteOffsetsX).l,A0
02:0002D8CC 12303000        	  4538:     move.b  (A0,D3.W),D1
02:0002D8D0 D101            	  4539:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsX,Y
02:0002D8D2 1880            	  4540:     move.b  D0,($0000,A4)
                            	  4541:     ; Store in [01] the Y coordinate offset for the current corner.
                            	  4542:     ;
02:0002D8D4 41EC0084        	  4543:     lea     ($0084,A4),A0
02:0002D8D8 10302000        	  4544:     move.b  (A0,D2.W),D0
02:0002D8DC 023C00EE        	  4545:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002D8E0 41F90002D8A2    	  4546:     lea     (DigdoggerSpriteOffsetsY).l,A0
02:0002D8E6 12303000        	  4547:     move.b  (A0,D3.W),D1
02:0002D8EA D101            	  4548:     addx.b  D1,D0   ; ADC DigdoggerSpriteOffsetsY,Y
02:0002D8EC 19400001        	  4549:     move.b  D0,($0001,A4)
                            	  4550:     ; Load and set the sprite attributes for this part.
                            	  4551:     ; Vertical flipping is set appropriately here.
                            	  4552:     ;
02:0002D8F0 41F90002D8A6    	  4553:     lea     (DigdoggerSpriteAttrs).l,A0
02:0002D8F6 10303000        	  4554:     move.b  (A0,D3.W),D0
02:0002D8FA 4EB900024966    	  4555:     jsr     Anim_SetSpriteDescriptorAttributes
02:0002D900 1003            	  4556:     move.b  D3,D0
02:0002D902 1B00            	  4557:     move.b  D0,-(A5)  ; PHA
                            	  4558:     ; Parts at odd indexes are flipped horizontally.
