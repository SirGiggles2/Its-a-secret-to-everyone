02:0002C888 7004            	  2296:     moveq   #4,D0
02:0002C88A 41EC03F8        	  2297:     lea     ($03F8,A4),A0
02:0002C88E 11802000        	  2298:     move.b  D0,(A0,D2.W)
02:0002C892 41EC0098        	  2299:     lea     ($0098,A4),A0
02:0002C896 11802000        	  2300:     move.b  D0,(A0,D2.W)
