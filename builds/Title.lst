                            	  2841: 
02:0001E91C 06410010        	  2842:     addi.w  #16,D1                  ; advance NES PPU address by 16 (one tile)
02:0001E920 048200000010    	  2843:     subi.l  #16,D2                  ; decrement remaining byte count
02:0001E926 6E00FF2A        	  2844:     bgt     .ftcb_tile
                            	  2845: 
