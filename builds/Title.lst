                            	  5613: _anon_z05_120:
                            	  5614:     ; TriggeredDoorCmd >= 5 or door type = 7
                            	  5615:     ;
                            	  5616:     ; Shutters and the commands to open a door always change
                            	  5617:     ; tiles.
                            	  5618:     ;
02:000335E2 61000130        	  5619:     jsr     PrepareWriteHorizontalDoorTransferRecords
                            	  5620:     even
                            	  5621: _L_z05_UpdateDoors_LoopTransferRec:
                            	  5622:     ; Copy [06] to [04] for the call to write tiles below.
                            	  5623:     ; We need to remember how many tiles need to be copied
                            	  5624:     ; in each transfer record.
                            	  5625:     ;
02:000335E6 102C0006        	  5626:     move.b  ($0006,A4),D0
02:000335EA 19400004        	  5627:     move.b  D0,($0004,A4)
                            	  5628:     ; Write the transfer record header for the door.
                            	  5629:     ;
                            	  5630:     ;
                            	  5631:     ; VRAM address high byte of door
02:000335EE 1014            	  5632:     move.b  ($0000,A4),D0
02:000335F0 41EC0302        	  5633:     lea     ($0302,A4),A0
02:000335F4 11802000        	  5634:     move.b  D0,(A0,D2.W)
02:000335F8 5202            	  5635:     addq.b  #1,D2
02:000335FA 102C0001        	  5636:     move.b  ($0001,A4),D0
02:000335FE 41EC0302        	  5637:     lea     ($0302,A4),A0
02:00033602 11802000        	  5638:     move.b  D0,(A0,D2.W)
02:00033606 5202            	  5639:     addq.b  #1,D2
02:00033608 102C0006        	  5640:     move.b  ($0006,A4),D0
02:0003360C 41EC0302        	  5641:     lea     ($0302,A4),A0
02:00033610 11802000        	  5642:     move.b  D0,(A0,D2.W)
02:00033614 5202            	  5643:     addq.b  #1,D2
                            	  5644: _anon_z05_121:
                            	  5645:     ; Write two tiles in a short loop indexed by [04].
                            	  5646:     ;
02:00033616 6100ED1C        	  5647:     jsr     WriteDoorFaceTileHorizontally
02:0003361A 66FA            	  5648:     bne  _anon_z05_121
                            	  5649:     ; OR the low VRAM address with $20 to go down one row
                            	  5650:     ; in order to work on the second row of door tiles.
                            	  5651:     ;
02:0003361C 7020            	  5652:     moveq   #32,D0
02:0003361E 122C0001        	  5653:     move.b  ($0001,A4),D1
02:00033622 8001            	  5654:     or.b  D1,D0
02:00033624 19400001        	  5655:     move.b  D0,($0001,A4)
                            	  5656:     ; Bottom of the loop.
                            	  5657:     ; Loop again to write the second transfer record for the
                            	  5658:     ; second pair of door tiles, if [05] has not reached 0.
                            	  5659:     ;
02:00033628 532C0005        	  5660:     subq.b  #1,($0005,A4)
02:0003362C 66B8            	  5661:     bne  _L_z05_UpdateDoors_LoopTransferRec
                            	  5662:     ; Write the end marker, and update buffer length.
                            	  5663:     ;
02:0003362E 103C00FF        	  5664:     move.b  #$FF,D0
02:00033632 41EC0302        	  5665:     lea     ($0302,A4),A0
02:00033636 11802000        	  5666:     move.b  D0,(A0,D2.W)
02:0003363A 1002            	  5667:     move.b  D2,D0
02:0003363C 19400301        	  5668:     move.b  D0,($0301,A4)
                            	  5669:     ; Increment the command.
                            	  5670:     ;
02:00033640 522C0054        	  5671:     addq.b  #1,($0054,A4)
                            	  5672:     ; If (new command AND 3) = 0, go update door flags and masks,
                            	  5673:     ; and resetting the door command.
                            	  5674:     ; This ends up catching original states 3 and 7.
                            	  5675:     ;
                            	  5676:     ; Else set door timer to 8 and return.
                            	  5677:     ;
02:00033644 102C0054        	  5678:     move.b  ($0054,A4),D0
02:00033648 02000003        	  5679:     andi.b #$03,D0
02:0003364C 6708            	  5680:     beq  _anon_z05_122
02:0003364E 7008            	  5681:     moveq   #8,D0
02:00033650 19400027        	  5682:     move.b  D0,($0027,A4)
02:00033654 4E75            	  5683:     rts
                            	  5684: 
                            	  5685: _anon_z05_122:
                            	  5686:     ; If the door command = 4 after incrementing it, then
                            	  5687:     ; it was 3 (close door). So:
                            	  5688:     ; 1. reset this door's flag
                            	  5689:     ; 2. remove it from the opened door mask
                            	  5690:     ; 3. reset the door command
                            	  5691:     ; 4. go lay out doors in the play area map
                            	  5692:     ;
02:00033656 102C0054        	  5693:     move.b  ($0054,A4),D0
02:0003365A 0C000004        	  5694:     cmpi.b  #$04,D0
02:0003365E 6626            	  5695:     bne  _anon_z05_123
02:00033660 7400            	  5696:     moveq   #0,D2
02:00033662 142C0009        	  5697:     move.b  ($0009,A4),D2
02:00033666 6100DCE6        	  5698:     jsr     ResetDoorFlag
02:0003366A 102C0055        	  5699:     move.b  ($0055,A4),D0
02:0003366E 0A00000F        	  5700:     eori.b #$0F,D0
02:00033672 122C00EE        	  5701:     move.b  ($00EE,A4),D1
02:00033676 C001            	  5702:     and.b  D1,D0
                            	  5703:     even
                            	  5704: L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors:
02:00033678 194000EE        	  5705:     move.b  D0,($00EE,A4)
                            	  5706:     even
                            	  5707: L_ResetDoorCmdAndLayOutDoors:
02:0003367C 7000            	  5708:     moveq   #0,D0
02:0003367E 19400054        	  5709:     move.b  D0,($0054,A4)
02:00033682 6000FCD4        	  5710:     jmp     LayOutDoors
                            	  5711: 
                            	  5712: _anon_z05_123:
                            	  5713:     ; Door command <> 4.
                            	  5714:     ; It must be 8, which means it was 7: open door.
                            	  5715:     ;
                            	  5716:     ; If the door is a shutter (7), then go add the door to the
                            	  5717:     ; opened door mask, reset door command, and lay out doors.
                            	  5718:     ;
02:00033686 102C0055        	  5719:     move.b  ($0055,A4),D0
02:0003368A 19400002        	  5720:     move.b  D0,($0002,A4)
02:0003368E 6100FA32        	  5721:     jsr     FindDoorAttrByDoorBit
02:00033692 0C000007        	  5722:     cmpi.b  #$07,D0
02:00033696 676E            	  5723:     beq  _anon_z05_124
                            	  5724:     ; Else the door is not a shutter.
                            	  5725:     ;
                            	  5726:     ;
                            	  5727:     ; [09] door direction index
02:00033698 7400            	  5728:     moveq   #0,D2
02:0003369A 142C0009        	  5729:     move.b  ($0009,A4),D2
02:0003369E 6100DCA8        	  5730:     jsr     SetDoorFlag
                            	  5731:     ; Get the next room's ID.
                            	  5732:     ;
02:000336A2 1003            	  5733:     move.b  D3,D0
02:000336A4 023C00EE        	  5734:     andi    #$EE,CCR  ; CLC: clear C+X
02:000336A8 41F900033564    	  5735:     lea     (DoorNextRoomIdOffsets).l,A0
02:000336AE 12302000        	  5736:     move.b  (A0,D2.W),D1
02:000336B2 D101            	  5737:     addx.b  D1,D0   ; ADC DoorNextRoomIdOffsets,X
02:000336B4 7600            	  5738:     moveq   #0,D3
02:000336B6 1600            	  5739:     move.b  D0,D3
                            	  5740:     ; Flip the door direction index.
                            	  5741:     ;
02:000336B8 1002            	  5742:     move.b  D2,D0
02:000336BA 0A000001        	  5743:     eori.b #$01,D0
02:000336BE 7400            	  5744:     moveq   #0,D2
02:000336C0 1400            	  5745:     move.b  D0,D2
                            	  5746:     ; Set the door flag for the opposite door in the next room.
                            	  5747:     ;
02:000336C2 1214            	  5748:     move.b  ($00,A4),D1   ; ptr lo
02:000336C4 182C0001        	  5749:     move.b  ($01,A4),D4  ; ptr hi
02:000336C8 024100FF        	  5750:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000336CC E14C            	  5751:     lsl.w   #8,D4
02:000336CE 8841            	  5752:     or.w    D1,D4             ; D4 = NES ptr addr
02:000336D0 48C4            	  5753:     ext.l   D4
02:000336D2 D8BC00FF0000    	  5754:     add.l   #NES_RAM,D4       ; → Genesis addr
02:000336D8 2044            	  5755:     movea.l D4,A0
02:000336DA 10303000        	  5756:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:000336DE 41F90003A7AE    	  5757:     lea     (LevelMasks).l,A0
02:000336E4 12302000        	  5758:     move.b  (A0,D2.W),D1
02:000336E8 8001            	  5759:     or.b  D1,D0
02:000336EA 1214            	  5760:     move.b  ($00,A4),D1   ; ptr lo
02:000336EC 182C0001        	  5761:     move.b  ($01,A4),D4  ; ptr hi
02:000336F0 024100FF        	  5762:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:000336F4 E14C            	  5763:     lsl.w   #8,D4
02:000336F6 8841            	  5764:     or.w    D1,D4
02:000336F8 48C4            	  5765:     ext.l   D4
02:000336FA D8BC00FF0000    	  5766:     add.l   #NES_RAM,D4
02:00033700 2044            	  5767:     movea.l D4,A0
02:00033702 11803000        	  5768:     move.b  D0,(A0,D3.W)     ; STA ($nn),Y
                            	  5769: _anon_z05_124:
                            	  5770:     ; Add the door to the opened door mask, reset door command,
                            	  5771:     ; and lay out doors.
                            	  5772:     ;
02:00033706 102C0055        	  5773:     move.b  ($0055,A4),D0
02:0003370A 122C00EE        	  5774:     move.b  ($00EE,A4),D1
02:0003370E 8001            	  5775:     or.b  D1,D0
02:00033710 6000FF66        	  5776:     jmp     L_SetOpenedDoorMaskAndResetCmdAndLayOutDoors
                            	  5777: 
                            	  5778: ; Params:
                            	  5779: ; [08]: 0 if closed
                            	  5780: ;
                            	  5781: ; Returns:
                            	  5782: ; X: current length of dynamic transfer buf
                            	  5783: ; [00]: door VRAM address high byte
                            	  5784: ; [01]: door VRAM address low byte
                            	  5785: ; [02:03]: address of door tiles for direction and face
                            	  5786: ; [05]: 2, the number of transfer records to write
                            	  5787: ; [06]: 2, the number of tiles in each record
                            	  5788: ; [07]: 0, the first index of a tile to transfer
                            	  5789: ; [09]: door direction index
                            	  5790: ;
                            	  5791: ; Note that this routine is called with triggered doors:
                            	  5792: ; doors that can change state. Their door type numbers are >= 4.
                            	  5793: ;
                            	  5794: ; If this routine were ever called with a fixed door
                            	  5795: ; ("open", "wall", or "false"), then it would produce non-sensical
                            	  5796: ; values for the door face.
                            	  5797: ;
                            	  5798: ;
                            	  5799: ; If triggered door type >= 5 (keys and shutter), play door sound.
                            	  5800: ;
                            	  5801:     even
                            	  5802: PrepareWriteHorizontalDoorTransferRecords:
02:00033714 102C0055        	  5803:     move.b  ($0055,A4),D0
02:00033718 19400002        	  5804:     move.b  D0,($0002,A4)
02:0003371C 6100F9A4        	  5805:     jsr     FindDoorAttrByDoorBit
02:00033720 0C000005        	  5806:     cmpi.b  #$05,D0
02:00033724 650C            	  5807:     bcs  _anon_z05_125
02:00033726 1B00            	  5808:     move.b  D0,-(A5)  ; PHA
02:00033728 7004            	  5809:     moveq   #4,D0
02:0003372A 4EB9000241FE    	  5810:     jsr     PlaySample
02:00033730 101D            	  5811:     move.b  (A5)+,D0  ; PLA
                            	  5812: _anon_z05_125:
                            	  5813:     ; Calculate the door face index in three parts.
                            	  5814:     ;
                            	  5815:     ; First, turn door type 4 into 8, and 1 into 4
                            	  5816:     ; (provisional face index in Y register).
                            	  5817:     ;
02:00033732 0C000004        	  5818:     cmpi.b  #$04,D0
02:00033736 6602            	  5819:     bne  _anon_z05_126
02:00033738 7008            	  5820:     moveq   #8,D0
                            	  5821: _anon_z05_126:
02:0003373A 0C000001        	  5822:     cmpi.b  #$01,D0
02:0003373E 6602            	  5823:     bne  _anon_z05_127
02:00033740 7004            	  5824:     moveq   #4,D0
                            	  5825: _anon_z05_127:
                            	  5826:     ; Second, subtract 3 from provisional face index.
                            	  5827:     ;
02:00033742 003C0011        	  5828:     ori     #$11,CCR  ; SEC: set C+X
02:00033746 123C0003        	  5829:     move.b  #$03,D1
02:0003374A 0A3C0010        	  5830:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003374E 9101            	  5831:     subx.b  D1,D0   ; SBC #$03
02:00033750 0A3C0010        	  5832:     eori    #$10,CCR  ; restore X = 6502 C
02:00033754 7600            	  5833:     moveq   #0,D3
02:00033756 1600            	  5834:     move.b  D0,D3
                            	  5835:     ; Lastly, if the door is closed ([08] = 0) and provisional
                            	  5836:     ; face index >= 3, then subtract 1 from it.
                            	  5837:     ;
                            	  5838:     ; But if open ([08] <> 0) and provisional face index <> 5,
                            	  5839:     ; then make it 1.
                            	  5840:     ;
02:00033758 102C0008        	  5841:     move.b  ($0008,A4),D0
02:0003375C 6708            	  5842:     beq  _anon_z05_128
02:0003375E 0C030005        	  5843:     cmpi.b  #$05,D3
02:00033762 670A            	  5844:     beq  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:00033764 7601            	  5845:     moveq   #1,D3
                            	  5846: _anon_z05_128:
02:00033766 0C030003        	  5847:     cmpi.b  #$03,D3
02:0003376A 6502            	  5848:     bcs  _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex
02:0003376C 5303            	  5849:     subq.b  #1,D3
                            	  5850:     even
                            	  5851: _L_z05_PrepareWriteHorizontalDoorTransferRecords_MakeForwardIndex:
                            	  5852:     ; The routine that returned the door type also returned its
                            	  5853:     ; reverse direction index in [03].
                            	  5854:     ;
                            	  5855:     ; We want a forward direction index. So, subtract [03] from 3.
                            	  5856:     ;
02:0003376E 7003            	  5857:     moveq   #3,D0
02:00033770 003C0011        	  5858:     ori     #$11,CCR  ; SEC: set C+X
02:00033774 122C0003        	  5859:     move.b  ($0003,A4),D1
02:00033778 0A3C0010        	  5860:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0003377C 9101            	  5861:     subx.b  D1,D0   ; SBC $03
02:0003377E 0A3C0010        	  5862:     eori    #$10,CCR  ; restore X = 6502 C
                            	  5863:     ; Call this to put the address of door face tiles in [02:03].
                            	  5864:     ;
02:00033782 6100FD7A        	  5865:     jsr     FetchDoorAddrsFaceTilesSrcAndPlayAreaDst
                            	  5866:     ; Return the address of the door in the nametable in [01:00].
                            	  5867:     ; Note the order is reversed, as usual with VRAM addresses.
                            	  5868:     ;
02:00033786 41F90003355C    	  5869:     lea     (DoorVramAddrsHi).l,A0
02:0003378C 10302000        	  5870:     move.b  (A0,D2.W),D0
02:00033790 1880            	  5871:     move.b  D0,($0000,A4)
02:00033792 41F900033560    	  5872:     lea     (DoorVramAddrsLo).l,A0
02:00033798 10302000        	  5873:     move.b  (A0,D2.W),D0
02:0003379C 19400001        	  5874:     move.b  D0,($0001,A4)
                            	  5875:     ; Return the direction of the door in [09], and the dynamic
                            	  5876:     ; transfer buf length in X register.
                            	  5877:     ;
02:000337A0 19420009        	  5878:     move.b  D2,($0009,A4)
02:000337A4 7400            	  5879:     moveq   #0,D2
02:000337A6 142C0301        	  5880:     move.b  ($0301,A4),D2
                            	  5881:     ; Return some hardcoded values in [05], [06], [07]. See the comments above.
                            	  5882:     ;
02:000337AA 7000            	  5883:     moveq   #0,D0
02:000337AC 19400007        	  5884:     move.b  D0,($0007,A4)
02:000337B0 7002            	  5885:     moveq   #2,D0
02:000337B2 19400006        	  5886:     move.b  D0,($0006,A4)
02:000337B6 19400005        	  5887:     move.b  D0,($0005,A4)
02:000337BA 0A3C0001        	  5888:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:000337BE 4E75            	  5889:     rts
                            	  5890: 
                            	  5891:     even
                            	  5892: ColumnDirectoryUW:
02:000337C0 00032F9C        	  5893:     dc.l    ColumnHeapUW0
02:000337C4 00032FAC        	  5894:     dc.l    ColumnHeapUW1
02:000337C8 00032FCA        	  5895:     dc.l    ColumnHeapUW2
02:000337CC 00032FDC        	  5896:     dc.l    ColumnHeapUW3
02:000337D0 00032FEE        	  5897:     dc.l    ColumnHeapUW4
02:000337D4 00033006        	  5898:     dc.l    ColumnHeapUW5
02:000337D8 0003301E        	  5899:     dc.l    ColumnHeapUW6
02:000337DC 00033030        	  5900:     dc.l    ColumnHeapUW7
02:000337E0 00033042        	  5901:     dc.l    ColumnHeapUW8
02:000337E4 0003305C        	  5902:     dc.l    ColumnHeapUW9
                            	  5903: 
                            	  5904:     even
