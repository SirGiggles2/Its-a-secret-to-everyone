02:0003AAF4 11802000        	  2371:     move.b  D0,(A0,D2.W)
02:0003AAF8 41EC030B        	  2372:     lea     ($030B,A4),A0
02:0003AAFC 11802000        	  2373:     move.b  D0,(A0,D2.W)
02:0003AB00 41EC0306        	  2374:     lea     ($0306,A4),A0
