02:0002F5C2 102C0015        	  8447:     move.b  ($0015,A4),D0
02:0002F5C6 02000003        	  8448:     andi.b #$03,D0
02:0002F5CA 41F90002F49A    	  8449:     lea     (GanonBurstSpriteAttrs).l,A0
02:0002F5D0 12302000        	  8450:     move.b  (A0,D2.W),D1
02:0002F5D4 8001            	  8451:     or.b  D1,D0
02:0002F5D6 19400003        	  8452:     move.b  D0,($0003,A4)
02:0002F5DA 41F90002F4A4    	  8453:     lea     (GanonBurstTiles).l,A0
02:0002F5E0 10302000        	  8454:     move.b  (A0,D2.W),D0
