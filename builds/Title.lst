                            	  8480: _L_z05_Submenu_WriteSheetMapRowTransferRecord_DoneRotate:
                            	  8481:     ; Exclude rooms that are not part of this level, and certain rooms
                            	  8482:     ; that should never be marked visited in the submenu map.
                            	  8483:     ;
                            	  8484:     ; First calculate the map row:
                            	  8485:     ; ((current menu scrolling value) / 2) - $D
                            	  8486:     ;
02:00034F5A 102C005E        	  8487:     move.b  ($005E,A4),D0
02:00034F5E 003C0011        	  8488:     ori     #$11,CCR  ; SEC: set C+X
02:00034F62 123C001A        	  8489:     move.b  #$1A,D1
02:00034F66 0A3C0010        	  8490:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F6A 9101            	  8491:     subx.b  D1,D0   ; SBC #$1A
02:00034F6C 0A3C0010        	  8492:     eori    #$10,CCR  ; restore X = 6502 C
02:00034F70 E208            	  8493:     lsr.b  #1,D0   ; LSR A
02:00034F72 7400            	  8494:     moveq   #0,D2
02:00034F74 1400            	  8495:     move.b  D0,D2
02:00034F76 760F            	  8496:     moveq   #15,D3
                            	  8497:     even
                            	  8498: _L_z05_Submenu_WriteSheetMapRowTransferRecord_MaskRooms:
                            	  8499:     ; For each element ($10) in the row, starting from $F:
                            	  8500:     ; If the current row is set in the submenu map mask,
                            	  8501:     ; then replace the tile with $F5, a blank map tile.
                            	  8502:     ;
02:00034F78 41F900FF6BBD    	  8503:     lea     (NES_SRAM+$0BBD).l,A0
02:00034F7E 10303000        	  8504:     move.b  (A0,D3.W),D0
02:00034F82 41F900034EB8    	  8505:     lea     (MapRowMasks).l,A0
02:00034F88 12302000        	  8506:     move.b  (A0,D2.W),D1
02:00034F8C C001            	  8507:     and.b  D1,D0
02:00034F8E 660C            	  8508:     bne  _anon_z05_201
02:00034F90 103C00F5        	  8509:     move.b  #$F5,D0
02:00034F94 41EC0305        	  8510:     lea     ($0305,A4),A0
02:00034F98 11803000        	  8511:     move.b  D0,(A0,D3.W)
                            	  8512: _anon_z05_201:
02:00034F9C 5303            	  8513:     subq.b  #1,D3
02:00034F9E 6AD8            	  8514:     bpl  _L_z05_Submenu_WriteSheetMapRowTransferRecord_MaskRooms
02:00034FA0 4E75            	  8515:     rts
