                            	  4396: Digdogger_Move:
                            	  4397:     ; This calculation is the same one used in Manhandla to
                            	  4398:     ; manifest the fractional speed over several frames.
                            	  4399:     ;
                            	  4400:     ; To summarize, the formula is:
                            	  4401:     ;
                            	  4402:     ;   (SA=speed accumulator, SH=speed high, SL=speed low)
                            	  4403:     ;
                            	  4404:     ;   SA := SA + (SL AND $E0)
                            	  4405:     ;   [03] := SH + carry
                            	  4406:     ;
                            	  4407:     ; See 04:A28E Manhandla_Move.
                            	  4408:     ;
02:0002D7A2 41EC041F        	  4409:     lea     ($041F,A4),A0
02:0002D7A6 10302000        	  4410:     move.b  (A0,D2.W),D0
02:0002D7AA 020000E0        	  4411:     andi.b #$E0,D0
02:0002D7AE 023C00EE        	  4412:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002D7B2 41EC0412        	  4413:     lea     ($0412,A4),A0
02:0002D7B6 12302000        	  4414:     move.b  (A0,D2.W),D1
02:0002D7BA D101            	  4415:     addx.b  D1,D0   ; ADC $0412,X
02:0002D7BC 41EC0412        	  4416:     lea     ($0412,A4),A0
02:0002D7C0 11802000        	  4417:     move.b  D0,(A0,D2.W)
                            	  4418:     ; Assign (high speed byte + carry) to [03].
                            	  4419:     ;
02:0002D7C4 41EC042C        	  4420:     lea     ($042C,A4),A0
02:0002D7C8 10302000        	  4421:     move.b  (A0,D2.W),D0
02:0002D7CC 123C0000        	  4422:     move.b  #$00,D1
02:0002D7D0 D101            	  4423:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002D7D2 19400003        	  4424:     move.b  D0,($0003,A4)
                            	  4425:     ; Change coordinates by the speed amount/offset in [03]
                            	  4426:     ; according to the direction.
                            	  4427:     ;
                            	  4428:     ; Start with a mask of $A1 in [02]:
                            	  4429:     ; - low nibble represents the right direction
                            	  4430:     ; - high nibble is used to set or clear carry as we go along
                            	  4431:     ;
02:0002D7D6 103C00A1        	  4432:     move.b  #$A1,D0
02:0002D7DA 19400002        	  4433:     move.b  D0,($0002,A4)
                            	  4434:     ; If direction has a right component (1), then add offset to X coordinate.
                            	  4435:     ;
02:0002D7DE 41EC0098        	  4436:     lea     ($0098,A4),A0
02:0002D7E2 10302000        	  4437:     move.b  (A0,D2.W),D0
02:0002D7E6 122C0002        	  4438:     move.b  ($0002,A4),D1
02:0002D7EA C200            	  4439:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002D7EC 6712            	  4440:     beq  _L_z04_Digdogger_Move_Left
02:0002D7EE 10342070        	  4441:     move.b  ($70,A4,D2.W),D0
02:0002D7F2 023C00EE        	  4442:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002D7F6 122C0003        	  4443:     move.b  ($0003,A4),D1
02:0002D7FA D101            	  4444:     addx.b  D1,D0   ; ADC $03
02:0002D7FC 19802070        	  4445:     move.b  D0,($70,A4,D2.W)
                            	  4446:     even
                            	  4447: _L_z04_Digdogger_Move_Left:
                            	  4448:     ; If direction has a left component (2), then subtract offset from X coordinate.
                            	  4449:     ;
02:0002D800 41EC0098        	  4450:     lea     ($0098,A4),A0
02:0002D804 10302000        	  4451:     move.b  (A0,D2.W),D0
02:0002D808 122C0002        	  4452:     move.b  ($0002,A4),D1
02:0002D80C E309            	  4453:     lsl.b  #1,D1   ; ASL $02
02:0002D80E 19410002        	  4454:     move.b  D1,($0002,A4)
02:0002D812 122C0002        	  4455:     move.b  ($0002,A4),D1
02:0002D816 C200            	  4456:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002D818 6716            	  4457:     beq  _L_z04_Digdogger_Move_Down
02:0002D81A 10342070        	  4458:     move.b  ($70,A4,D2.W),D0
02:0002D81E 122C0003        	  4459:     move.b  ($0003,A4),D1
02:0002D822 0A3C0010        	  4460:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002D826 9101            	  4461:     subx.b  D1,D0   ; SBC $03
02:0002D828 0A3C0010        	  4462:     eori    #$10,CCR  ; restore X = 6502 C
02:0002D82C 19802070        	  4463:     move.b  D0,($70,A4,D2.W)
                            	  4464:     even
                            	  4465: _L_z04_Digdogger_Move_Down:
                            	  4466:     ; If direction has a down component (4), then add offset to Y coordinate.
                            	  4467:     ;
02:0002D830 41EC0098        	  4468:     lea     ($0098,A4),A0
02:0002D834 10302000        	  4469:     move.b  (A0,D2.W),D0
02:0002D838 122C0002        	  4470:     move.b  ($0002,A4),D1
02:0002D83C E309            	  4471:     lsl.b  #1,D1   ; ASL $02
02:0002D83E 19410002        	  4472:     move.b  D1,($0002,A4)
02:0002D842 122C0002        	  4473:     move.b  ($0002,A4),D1
02:0002D846 C200            	  4474:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002D848 6716            	  4475:     beq  _L_z04_Digdogger_Move_Up
02:0002D84A 41EC0084        	  4476:     lea     ($0084,A4),A0
02:0002D84E 10302000        	  4477:     move.b  (A0,D2.W),D0
02:0002D852 122C0003        	  4478:     move.b  ($0003,A4),D1
02:0002D856 D101            	  4479:     addx.b  D1,D0   ; ADC $03
02:0002D858 41EC0084        	  4480:     lea     ($0084,A4),A0
02:0002D85C 11802000        	  4481:     move.b  D0,(A0,D2.W)
                            	  4482:     even
                            	  4483: _L_z04_Digdogger_Move_Up:
                            	  4484:     ; If direction has an up component (8), then subtract offset from Y coordinate.
                            	  4485:     ;
02:0002D860 41EC0098        	  4486:     lea     ($0098,A4),A0
02:0002D864 10302000        	  4487:     move.b  (A0,D2.W),D0
02:0002D868 122C0002        	  4488:     move.b  ($0002,A4),D1
02:0002D86C E309            	  4489:     lsl.b  #1,D1   ; ASL $02
02:0002D86E 19410002        	  4490:     move.b  D1,($0002,A4)
02:0002D872 122C0002        	  4491:     move.b  ($0002,A4),D1
02:0002D876 C200            	  4492:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:0002D878 671E            	  4493:     beq  _L_z04_Digdogger_Move_End
02:0002D87A 41EC0084        	  4494:     lea     ($0084,A4),A0
02:0002D87E 10302000        	  4495:     move.b  (A0,D2.W),D0
02:0002D882 122C0003        	  4496:     move.b  ($0003,A4),D1
02:0002D886 0A3C0010        	  4497:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002D88A 9101            	  4498:     subx.b  D1,D0   ; SBC $03
02:0002D88C 0A3C0010        	  4499:     eori    #$10,CCR  ; restore X = 6502 C
02:0002D890 41EC0084        	  4500:     lea     ($0084,A4),A0
02:0002D894 11802000        	  4501:     move.b  D0,(A0,D2.W)
                            	  4502:     even
