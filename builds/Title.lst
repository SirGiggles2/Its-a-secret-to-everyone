Source: "audio_driver.asm"
                            	     2: 
                            	     3: ;==============================================================================
                            	     4: ; audio_driver.asm — YM2612 + PSG driver for NES APU emulation
                            	     5: ;
                            	     6: ; Maps NES APU channels to Genesis sound hardware using Sonic 2 Emerald Hill
                            	     7: ; Zone FM patches:
                            	     8: ;   Pulse 1 → YM2612 ch 0 (EHZ Voice $00, Algorithm 7)
                            	     9: ;   Pulse 2 → YM2612 ch 1 (EHZ Voice $03, Algorithm 5)
                            	    10: ;   Triangle → YM2612 ch 2 (EHZ Voice $07, Algorithm 0)
                            	    11: ;   Noise   → SN76489 PSG ch 3
                            	    12: ;
                            	    13: ; Include BEFORE nes_io.asm so helpers are available to APU stubs.
                            	    14: ;==============================================================================
                            	    15: 
                            	    16: ;----------------------------------------------------------------------
                            	    17: ; Hardware ports
                            	    18: ;----------------------------------------------------------------------
                            	    19: YM_ADDR1        equ $A04000     ; YM2612 Part I address  (ch 0-2 + global regs)
                            	    20: YM_DATA1        equ $A04001     ; YM2612 Part I data
                            	    21: YM_ADDR2        equ $A04002     ; YM2612 Part II address (ch 3-5 / ch 6 DAC pan)
                            	    22: YM_DATA2        equ $A04003     ; YM2612 Part II data
                            	    23: PSG_PORT        equ $C00011     ; SN76489 PSG data
                            	    24: 
                            	    25: ;----------------------------------------------------------------------
                            	    26: ; Shadow APU registers ($FF0A00–$FF0A15)
                            	    27: ; Clear of NES RAM ($FF0000-$FF07FF), PPU/MMC1 ($FF0800-$FF083F),
                            	    28: ; H-int queue ($FF0816-$FF081F), forensics ($FF0900-$FF0943).
                            	    29: ;----------------------------------------------------------------------
                            	    30: APU_SH_BASE     equ $FF0A00
                            	    31: APU_SH_4000     equ APU_SH_BASE+$00    ; Pulse 1 duty/volume
                            	    32: APU_SH_4001     equ APU_SH_BASE+$01    ; Pulse 1 sweep (unused)
                            	    33: APU_SH_4002     equ APU_SH_BASE+$02    ; Pulse 1 period low
                            	    34: APU_SH_4003     equ APU_SH_BASE+$03    ; Pulse 1 period high + length
                            	    35: APU_SH_4004     equ APU_SH_BASE+$04    ; Pulse 2 duty/volume
                            	    36: APU_SH_4005     equ APU_SH_BASE+$05    ; Pulse 2 sweep (unused)
                            	    37: APU_SH_4006     equ APU_SH_BASE+$06    ; Pulse 2 period low
                            	    38: APU_SH_4007     equ APU_SH_BASE+$07    ; Pulse 2 period high + length
                            	    39: APU_SH_4008     equ APU_SH_BASE+$08    ; Triangle linear counter
                            	    40: APU_SH_400A     equ APU_SH_BASE+$0A    ; Triangle period low
                            	    41: APU_SH_400B     equ APU_SH_BASE+$0B    ; Triangle period high + length
                            	    42: APU_SH_400C     equ APU_SH_BASE+$0C    ; Noise volume/envelope
                            	    43: APU_SH_400E     equ APU_SH_BASE+$0E    ; Noise mode + period
                            	    44: APU_SH_400F     equ APU_SH_BASE+$0F    ; Noise length counter
                            	    45: APU_SH_4015     equ APU_SH_BASE+$10    ; Channel enable flags
                            	    46: 
                            	    47: ;----------------------------------------------------------------------
                            	    48: ; Frequency conversion constants
                            	    49: ;
                            	    50: ; NES pulse:    f = CPU_CLK / (16 * (P+1)),   CPU_CLK = 1,789,773
                            	    51: ; NES triangle: f = CPU_CLK / (32 * (P+1))    (one octave lower)
                            	    52: ; YM2612:       f = (F_num * 2^block * YM_CLK) / (144 * 2^20)
                            	    53: ;                   YM_CLK = 7,670,453
                            	    54: ;
                            	    55: ; K_pulse = CPU_CLK * 144 * 2^20 / (16 * YM_CLK) ≈ 4,403,410
                            	    56: ; K5_pulse = K_pulse >> 5 = 137,606    (base block = 5)
                            	    57: ; K5_tri   = K5_pulse / 2 = 68,803     (triangle is one octave below pulse)
                            	    58: ;
                            	    59: ; Sanity check: NES A4 (P=253, P+1=254) → K5/254 = 541.75
                            	    60: ;               Standard YM2612 F_num for A4 at block 5 = 541. ✓
                            	    61: ;----------------------------------------------------------------------
                            	    62: NES_YM_K5_PULSE equ 137606
                            	    63: NES_YM_K5_TRI   equ 68803
                            	    64: 
                            	    65: ;==============================================================================
                            	    66: ; ym_write1 — Write one register to YM2612 Part I
                            	    67: ;
                            	    68: ; Input:  D0.b = register address
                            	    69: ;         D1.b = data value
                            	    70: ; Output: none
                            	    71: ; Preserves: all registers
                            	    72: ;
                            	    73: ; SR lockout: the address+data pair MUST go out as an atomic latched write.
                            	    74: ; With the HBlank-driven DMC streamer enabled, the HINT handler also writes
                            	    75: ; $2A + data to YM2612 Part I; if it preempts between our address write and
                            	    76: ; data write, the YM latch is left pointing at $2A and our subsequent data
                            	    77: ; byte lands in the DAC instead of the intended register.  Mask HINT (level
                            	    78: ; 4) for the duration of the pair by raising SR interrupt level to 6, then
                            	    79: ; restore the caller's SR on exit.  Cost: ~16 cycles per call.
                            	    80: ;==============================================================================
                            	    81: ym_write1:
02:000003BA 40E7            	    82:     move.w  SR,-(SP)                ; save caller's SR
02:000003BC 007C0600        	    83:     ori.w   #$0600,SR               ; mask HINT (level 4) + its below
                            	    84: .wait:
02:000003C0 4A3900A04000    	    85:     tst.b   (YM_ADDR1).l            ; bit 7 = busy flag
02:000003C6 6BF8            	    86:     bmi.s   .wait
02:000003C8 13C000A04000    	    87:     move.b  D0,(YM_ADDR1).l         ; write register address
02:000003CE 4E71            	    88:     nop                              ; address setup delay
02:000003D0 4E71            	    89:     nop
02:000003D2 4E71            	    90:     nop
02:000003D4 13C100A04001    	    91:     move.b  D1,(YM_DATA1).l         ; write data
02:000003DA 46DF            	    92:     move.w  (SP)+,SR                ; restore SR (re-enables HINT)
02:000003DC 4E75            	    93:     rts
                            	    94: 
                            	    95: ;==============================================================================
                            	    96: ; ym_write2 — Write one register to YM2612 Part II
                            	    97: ;
                            	    98: ; Used for ch 4-5 regs and ch 6 pan ($B4+2 = $B6 on Part II).  The busy flag
                            	    99: ; is shared across both parts so we still poll Part I.  Same SR lockout as
                            	   100: ; ym_write1 to prevent HINT-based DMC streamer from stomping the latch.
                            	   101: ;
                            	   102: ; Input:  D0.b = register address
                            	   103: ;         D1.b = data value
                            	   104: ; Output: none
                            	   105: ; Preserves: all registers
                            	   106: ;==============================================================================
                            	   107: ym_write2:
02:000003DE 40E7            	   108:     move.w  SR,-(SP)
02:000003E0 007C0600        	   109:     ori.w   #$0600,SR
                            	   110: .wait:
02:000003E4 4A3900A04000    	   111:     tst.b   (YM_ADDR1).l            ; busy flag is shared between parts
02:000003EA 6BF8            	   112:     bmi.s   .wait
02:000003EC 13C000A04002    	   113:     move.b  D0,(YM_ADDR2).l         ; write register address (Part II)
02:000003F2 4E71            	   114:     nop
02:000003F4 4E71            	   115:     nop
02:000003F6 4E71            	   116:     nop
02:000003F8 13C100A04003    	   117:     move.b  D1,(YM_DATA2).l         ; write data (Part II)
02:000003FE 46DF            	   118:     move.w  (SP)+,SR
02:00000400 4E75            	   119:     rts
                            	   120: 
                            	   121: ;==============================================================================
                            	   122: ; nes_to_ym_freq — Convert NES 11-bit period to YM2612 frequency
                            	   123: ;
                            	   124: ; Input:  D2.w = 11-bit NES period (0–2047)
                            	   125: ;         D3.l = K constant (NES_YM_K5_PULSE or NES_YM_K5_TRI)
                            	   126: ; Output: D2.b = A4 register value (block<<3 | F_num bits 10:8)
                            	   127: ;         D3.b = A0 register value (F_num bits 7:0)
                            	   128: ; Destroys: D4, D5
                            	   129: ;==============================================================================
                            	   130: nes_to_ym_freq:
02:00000402 5242            	   131:     addq.w  #1,D2                   ; D2 = P + 1
02:00000404 B47C0002        	   132:     cmp.w   #2,D2
02:00000408 6532            	   133:     blo.s   .silence                ; period 0 → silence
02:0000040A 86C2            	   134:     divu    D2,D3                   ; D3.l / D2.w → quotient in D3.w
02:0000040C 692E            	   135:     bvs.s   .silence                ; overflow safety
02:0000040E 3A03            	   136:     move.w  D3,D5                   ; D5 = raw quotient = F_num at block 5
02:00000410 7805            	   137:     moveq   #5,D4                   ; starting block (K was pre-shifted by 5)
                            	   138: .norm:
02:00000412 BA7C07FF        	   139:     cmp.w   #2047,D5
02:00000416 630C            	   140:     bls.s   .done                   ; F_num fits in 11 bits
02:00000418 E24D            	   141:     lsr.w   #1,D5                   ; halve F_num
02:0000041A 5204            	   142:     addq.b  #1,D4                   ; increment block
02:0000041C B83C0007        	   143:     cmp.b   #7,D4
02:00000420 6210            	   144:     bhi.s   .clamp                  ; block overflow → clamp
02:00000422 60EE            	   145:     bra.s   .norm
                            	   146: .done:
                            	   147:     ; D5.w = F_num (0–2047), D4.b = block (0–7)
02:00000424 1404            	   148:     move.b  D4,D2
02:00000426 E70A            	   149:     lsl.b   #3,D2                   ; block << 3
02:00000428 3605            	   150:     move.w  D5,D3
02:0000042A E04B            	   151:     lsr.w   #8,D3                   ; F_num >> 8 = high 3 bits
02:0000042C 8403            	   152:     or.b    D3,D2                   ; D2.b = (block<<3) | F_num_high
02:0000042E 1605            	   153:     move.b  D5,D3                   ; D3.b = F_num_low
02:00000430 4E75            	   154:     rts
                            	   155: .clamp:
                            	   156:     ; Frequency too high for YM2612 — clamp to max
02:00000432 143C003F        	   157:     move.b  #$3F,D2                 ; block 7, F_num high = 7
02:00000436 163C00FF        	   158:     move.b  #$FF,D3                 ; F_num low = $FF → F_num = 2047
02:0000043A 4E75            	   159:     rts
                            	   160: .silence:
02:0000043C 7400            	   161:     moveq   #0,D2
02:0000043E 7600            	   162:     moveq   #0,D3
02:00000440 4E75            	   163:     rts
                            	   164: 
                            	   165: ;==============================================================================
                            	   166: ; load_fm_patch — Load a 25-byte FM patch into a YM2612 channel
                            	   167: ;
                            	   168: ; Input:  A0 = pointer to 25-byte patch data
                            	   169: ;         D6.b = channel (0, 1, or 2)
                            	   170: ; Output: none
                            	   171: ; Preserves: D0-D6, A0-A1 (saved/restored internally)
                            	   172: ;==============================================================================
                            	   173: load_fm_patch:
02:00000442 48E7E0C0        	   174:     movem.l D0-D2/A0-A1,-(SP)
02:00000446 43FA0168        	   175:     lea     FM_PATCH_REGS(PC),A1
02:0000044A 7418            	   176:     moveq   #24,D2                  ; 25 register/value pairs
                            	   177: .loop:
02:0000044C 1019            	   178:     move.b  (A1)+,D0                ; register base address
02:0000044E D006            	   179:     add.b   D6,D0                   ; + channel offset (0/1/2)
02:00000450 1218            	   180:     move.b  (A0)+,D1                ; data value
02:00000452 6100FF66        	   181:     bsr     ym_write1
02:00000456 51CAFFF4        	   182:     dbra    D2,.loop
02:0000045A 4CDF0307        	   183:     movem.l (SP)+,D0-D2/A0-A1
02:0000045E 4E75            	   184:     rts
                            	   185: 
                            	   186: ;==============================================================================
                            	   187: ; audio_init — Initialize YM2612 and PSG for NES audio emulation
                            	   188: ;
                            	   189: ; Called once during boot. Sets up FM patches and mutes all channels.
                            	   190: ; Preserves: A4, A5, D7 (NES register shadows)
                            	   191: ;==============================================================================
                            	   192: audio_init:
02:00000460 48E7FE80        	   193:     movem.l D0-D6/A0,-(SP)
                            	   194: 
                            	   195:     ;------------------------------------------------------------------
                            	   196:     ; Key-off all 6 YM2612 channels
                            	   197:     ;------------------------------------------------------------------
02:00000464 103C0028        	   198:     move.b  #$28,D0                 ; Key on/off register
02:00000468 7200            	   199:     moveq   #0,D1
02:0000046A 6100FF4E        	   200:     bsr     ym_write1               ; ch 0 off
02:0000046E 123C0001        	   201:     move.b  #$01,D1
02:00000472 6100FF46        	   202:     bsr     ym_write1               ; ch 1 off
02:00000476 123C0002        	   203:     move.b  #$02,D1
02:0000047A 6100FF3E        	   204:     bsr     ym_write1               ; ch 2 off
02:0000047E 123C0004        	   205:     move.b  #$04,D1
02:00000482 6100FF36        	   206:     bsr     ym_write1               ; ch 4 off (Part II)
02:00000486 123C0005        	   207:     move.b  #$05,D1
02:0000048A 6100FF2E        	   208:     bsr     ym_write1               ; ch 5 off
02:0000048E 123C0006        	   209:     move.b  #$06,D1
02:00000492 6100FF26        	   210:     bsr     ym_write1               ; ch 6 off
                            	   211: 
                            	   212:     ;------------------------------------------------------------------
                            	   213:     ; DMC scaffold (Phase C): enable YM2612 DAC on ch 6 and unmute its
                            	   214:     ; pan register so PCM bytes streamed to reg $2A become audible.
                            	   215:     ;
                            	   216:     ; $2B bit 7 = DAC enable (replaces ch 6's FM synth path).  We also
                            	   217:     ; write a center value ($80) to $2A so the DAC sits at mid-scale
                            	   218:     ; until dmc_feed starts pushing real samples.  $B6 (Part II) is ch 6
                            	   219:     ; pan/AMS/PMS — $C0 enables both L+R outputs.
                            	   220:     ;------------------------------------------------------------------
02:00000496 103C002B        	   221:     move.b  #$2B,D0                 ; DAC enable register
02:0000049A 123C0080        	   222:     move.b  #$80,D1                 ; bit 7 = DAC on
02:0000049E 6100FF1A        	   223:     bsr     ym_write1
02:000004A2 103C002A        	   224:     move.b  #$2A,D0                 ; DAC data
02:000004A6 123C0080        	   225:     move.b  #$80,D1                 ; center value = silence
02:000004AA 6100FF0E        	   226:     bsr     ym_write1
02:000004AE 103C00B6        	   227:     move.b  #$B6,D0                 ; ch 6 pan/AMS/PMS (Part II)
02:000004B2 123C00C0        	   228:     move.b  #$C0,D1                 ; L+R enabled
02:000004B6 6100FF26        	   229:     bsr     ym_write2
                            	   230: 
                            	   231:     ;------------------------------------------------------------------
                            	   232:     ; LFO off (register $22 = 0)
                            	   233:     ;------------------------------------------------------------------
02:000004BA 103C0022        	   234:     move.b  #$22,D0
02:000004BE 7200            	   235:     moveq   #0,D1
02:000004C0 6100FEF8        	   236:     bsr     ym_write1
                            	   237: 
                            	   238:     ;------------------------------------------------------------------
                            	   239:     ; Clear SSG-EG for every operator on ch 0, 1, 2 ($90-$9E on Part I).
                            	   240:     ;
                            	   241:     ; The YM2612 SSG-EG register per operator has no power-on guarantee
                            	   242:     ; on Genesis hardware and may hold leftover state across soft resets.
                            	   243:     ; If bit 3 (SSG enable) is set, the envelope generator runs in a
                            	   244:     ; sawtooth/square-like "SSG mode" that produces an audible buzz or
                            	   245:     ; hiss alongside the clean FM output — we were hearing that on ch 1
                            	   246:     ; (Voice $00 pad) and ch 2 (Voice $07 bass).
                            	   247:     ;
                            	   248:     ; Zero-ing $90+op+ch for all 4 operators on each used channel puts
                            	   249:     ; every envelope generator back in standard mode.  12 writes total.
                            	   250:     ;------------------------------------------------------------------
02:000004C4 7200            	   251:     moveq   #0,D1                   ; data = 0 for all
02:000004C6 103C0090        	   252:     move.b  #$90,D0                 ; slot1 ch0
02:000004CA 6100FEEE        	   253:     bsr     ym_write1
02:000004CE 103C0091        	   254:     move.b  #$91,D0                 ; slot1 ch1
02:000004D2 6100FEE6        	   255:     bsr     ym_write1
02:000004D6 103C0092        	   256:     move.b  #$92,D0                 ; slot1 ch2
02:000004DA 6100FEDE        	   257:     bsr     ym_write1
02:000004DE 103C0094        	   258:     move.b  #$94,D0                 ; slot3 ch0
02:000004E2 6100FED6        	   259:     bsr     ym_write1
02:000004E6 103C0095        	   260:     move.b  #$95,D0                 ; slot3 ch1
02:000004EA 6100FECE        	   261:     bsr     ym_write1
02:000004EE 103C0096        	   262:     move.b  #$96,D0                 ; slot3 ch2
02:000004F2 6100FEC6        	   263:     bsr     ym_write1
02:000004F6 103C0098        	   264:     move.b  #$98,D0                 ; slot2 ch0
02:000004FA 6100FEBE        	   265:     bsr     ym_write1
02:000004FE 103C0099        	   266:     move.b  #$99,D0                 ; slot2 ch1
02:00000502 6100FEB6        	   267:     bsr     ym_write1
02:00000506 103C009A        	   268:     move.b  #$9A,D0                 ; slot2 ch2
02:0000050A 6100FEAE        	   269:     bsr     ym_write1
02:0000050E 103C009C        	   270:     move.b  #$9C,D0                 ; slot4 ch0
02:00000512 6100FEA6        	   271:     bsr     ym_write1
02:00000516 103C009D        	   272:     move.b  #$9D,D0                 ; slot4 ch1
02:0000051A 6100FE9E        	   273:     bsr     ym_write1
02:0000051E 103C009E        	   274:     move.b  #$9E,D0                 ; slot4 ch2
02:00000522 6100FE96        	   275:     bsr     ym_write1
                            	   276: 
                            	   277:     ;------------------------------------------------------------------
                            	   278:     ; Load EHZ Voice $03 into ch 0 (m_sq1 = NES Sq1 = Pulse 2 = LEAD melody)
                            	   279:     ; NES naming: Sq1/Sq0 are reversed from intuition — Sq1 writes $4006/$4007
                            	   280:     ; (Pulse 2) and owns the primary melody.  Put the snappy EHZ lead here.
                            	   281:     ;------------------------------------------------------------------
02:00000526 41FA00BC        	   282:     lea     PATCH_VOICE03(PC),A0
02:0000052A 7C00            	   283:     moveq   #0,D6                   ; channel 0 (emit_note_sq1 target)
02:0000052C 6100FF14        	   284:     bsr     load_fm_patch
                            	   285: 
                            	   286:     ;------------------------------------------------------------------
                            	   287:     ; Load EHZ Voice $00 into ch 1 (m_sq0 = NES Sq0 = Pulse 1 = harmony/arp)
                            	   288:     ; The slow-decay pad fits arpeggiated harmony better than a sharp lead.
                            	   289:     ;------------------------------------------------------------------
02:00000530 41FA0098        	   290:     lea     PATCH_VOICE00(PC),A0
02:00000534 7C01            	   291:     moveq   #1,D6                   ; channel 1 (emit_note_sq0 target)
02:00000536 6100FF0A        	   292:     bsr     load_fm_patch
                            	   293: 
                            	   294:     ;------------------------------------------------------------------
                            	   295:     ; Load EHZ Voice $07 into ch 2 (Triangle — Algorithm 0, bass)
                            	   296:     ;------------------------------------------------------------------
02:0000053A 41FA00C2        	   297:     lea     PATCH_VOICE07(PC),A0
02:0000053E 7C02            	   298:     moveq   #2,D6                   ; channel 2
02:00000540 6100FF00        	   299:     bsr     load_fm_patch
                            	   300: 
                            	   301:     ;------------------------------------------------------------------
                            	   302:     ; Set panning: both speakers for ch 0–2
                            	   303:     ; Register $B4+ch, data $C0 = L+R output
                            	   304:     ;------------------------------------------------------------------
02:00000544 103C00B4        	   305:     move.b  #$B4,D0
02:00000548 123C00C0        	   306:     move.b  #$C0,D1
02:0000054C 6100FE6C        	   307:     bsr     ym_write1               ; ch 0 panning
02:00000550 103C00B5        	   308:     move.b  #$B5,D0
02:00000554 6100FE64        	   309:     bsr     ym_write1               ; ch 1 panning
02:00000558 103C00B6        	   310:     move.b  #$B6,D0
02:0000055C 6100FE5C        	   311:     bsr     ym_write1               ; ch 2 panning
                            	   312: 
                            	   313:     ;------------------------------------------------------------------
                            	   314:     ; (Phase E polish: the Phase-C FM isolation mute that forced every
                            	   315:     ; operator TL to $7F has been removed — FM music plays again alongside
                            	   316:     ; the DMC DAC stream now that HBlank-driven non-blocking playback is
                            	   317:     ; in place.  Patches loaded by load_fm_patch above already set the
                            	   318:     ; authoritative TL bytes for each voice.)
                            	   319:     ;------------------------------------------------------------------
                            	   320: 
                            	   321:     ;------------------------------------------------------------------
                            	   322:     ; Mute all 4 PSG channels (attenuation = $F = maximum)
                            	   323:     ;------------------------------------------------------------------
02:00000560 13FC009F00C00011	   324:     move.b  #$9F,(PSG_PORT).l       ; Tone 1 mute
02:00000568 13FC00BF00C00011	   325:     move.b  #$BF,(PSG_PORT).l       ; Tone 2 mute
02:00000570 13FC00DF00C00011	   326:     move.b  #$DF,(PSG_PORT).l       ; Tone 3 mute
02:00000578 13FC00FF00C00011	   327:     move.b  #$FF,(PSG_PORT).l       ; Noise mute
                            	   328: 
                            	   329:     ;------------------------------------------------------------------
                            	   330:     ; Clear shadow APU registers
                            	   331:     ;------------------------------------------------------------------
02:00000580 41F900FF0A00    	   332:     lea     (APU_SH_BASE).l,A0
02:00000586 7008            	   333:     moveq   #($11/2),D0            ; 18 bytes / 2 = 9 words (round up)
                            	   334: .clr:
02:00000588 4258            	   335:     clr.w   (A0)+
02:0000058A 51C8FFFC        	   336:     dbra    D0,.clr
                            	   337: 
                            	   338:     ;------------------------------------------------------------------
                            	   339:     ; Clear native music player state
                            	   340:     ;------------------------------------------------------------------
02:0000058E 41F900FFE000    	   341:     lea     (MUSIC_BASE).l,A0
02:00000594 700F            	   342:     moveq   #(MUSIC_STATE_SIZE/4)-1,D0
                            	   343: .clr_music:
02:00000596 4298            	   344:     clr.l   (A0)+
02:00000598 51C8FFFC        	   345:     dbra    D0,.clr_music
                            	   346: 
                            	   347:     ;------------------------------------------------------------------
                            	   348:     ; Clear DMC shadow block ($FFE100, 16 bytes). The remaining state
                            	   349:     ; is just dmc_last_idx (HUD readout) plus the three NES-reg
                            	   350:     ; shadows ($4010/$4012/$4013) used by the lookup in nes_io.asm —
                            	   351:     ; everything else (active flag, ptr, remain, debug scaffolds)
                            	   352:     ; went away with the HBlank streamer in the XGM migration.
                            	   353:     ;------------------------------------------------------------------
02:0000059C 41F900FFE100    	   354:     lea     (DMC_BASE).l,A0
02:000005A2 4298            	   355:     clr.l   (A0)+
02:000005A4 4298            	   356:     clr.l   (A0)+
02:000005A6 4298            	   357:     clr.l   (A0)+
02:000005A8 4298            	   358:     clr.l   (A0)+
                            	   359: 
                            	   360:     ;------------------------------------------------------------------
                            	   361:     ; Hand audio off to the SGDK XGM Z80 driver. audio_xgm_init() does:
                            	   362:     ;   1. Z80_loadDriver(Z80_DRIVER_XGM, TRUE)  - upload + wait ready
                            	   363:     ;   2. XGM_setPCM(64..70, sfx_pcm_NN, len)   - register 7 SFX samples
                            	   364:     ; After this, dmc_trigger trampolines to audio_sfx_play and the Z80
                            	   365:     ; owns YM2612 reg $2A. The legacy HBlank streamer is dead.
                            	   366:     ;
                            	   367:     ; LA-jingle bring-up: the XGM Z80 driver mutes the FM channels we
                            	   368:     ; need for the ItemTaken (LA "Get Item") song. Skip XGM init so the
                            	   369:     ; legacy FM driver retains exclusive YM2612 ownership. SFX path is
                            	   370:     ; lost until xgm-mig finishes a coexistence story.
                            	   371:     ;------------------------------------------------------------------
                            	   372:     xref    audio_xgm_init
                            	   373:     ; jsr     audio_xgm_init       ; disabled: see comment above
                            	   374: 
02:000005AA 4CDF017F        	   375:     movem.l (SP)+,D0-D6/A0
02:000005AE 4E75            	   376:     rts
                            	   377: 
                            	   378: ;==============================================================================
                            	   379: ; FM Patch Register Address Table
                            	   380: ;
                            	   381: ; 25 register base addresses (add channel 0/1/2 for target channel).
                            	   382: ; Order matches the 25 data bytes in each PATCH_VOICExx block.
                            	   383: ;==============================================================================
                            	   384:     even
                            	   385: FM_PATCH_REGS:
02:000005B0 B0              	   386:     dc.b    $B0                     ; FB/ALG
02:000005B1 30              	   387:     dc.b    $30,$34,$38,$3C         ; DT1/MUL (slot1,slot3,slot2,slot4)
02:000005B2 34
02:000005B3 38
02:000005B4 3C
02:000005B5 50              	   388:     dc.b    $50,$54,$58,$5C         ; RS/AR
02:000005B6 54
02:000005B7 58
02:000005B8 5C
02:000005B9 60              	   389:     dc.b    $60,$64,$68,$6C         ; AM/D1R
02:000005BA 64
02:000005BB 68
02:000005BC 6C
02:000005BD 70              	   390:     dc.b    $70,$74,$78,$7C         ; D2R
02:000005BE 74
02:000005BF 78
02:000005C0 7C
02:000005C1 80              	   391:     dc.b    $80,$84,$88,$8C         ; DL/RR
02:000005C2 84
02:000005C3 88
02:000005C4 8C
02:000005C5 40              	   392:     dc.b    $40,$44,$48,$4C         ; TL
02:000005C6 44
02:000005C7 48
02:000005C8 4C
                            	   393:     even
                            	   394: 
                            	   395: ;==============================================================================
                            	   396: ; FM Patch Data — Sonic 2 Emerald Hill Zone voices
                            	   397: ;
                            	   398: ; 25 bytes each.  Canonical Sonic 2 voice format from sonicretro/s2disasm
                            	   399: ; sound/music/82 - EHZ.asm (label EHZ_Voices):
                            	   400: ;
                            	   401: ;   byte 0      : FB/ALG (feedback<<3 | algorithm)
                            	   402: ;   bytes 1-4   : DT/MUL  — operators in slot order: op1, op3, op2, op4
                            	   403: ;   bytes 5-8   : RS/AR    "
                            	   404: ;   bytes 9-12  : AM/D1R   "
                            	   405: ;   bytes 13-16 : D2R      "
                            	   406: ;   bytes 17-20 : DL/RR    "
                            	   407: ;   bytes 21-24 : TL       "
                            	   408: ;
                            	   409: ; The slot order op1,op3,op2,op4 matches YM2612 register offsets 0,4,8,C in
                            	   410: ; FM_PATCH_REGS, so the bytes stream directly to the right operator slots
                            	   411: ; without any reordering in load_fm_patch.
                            	   412: ;
                            	   413: ; NOTE: the original SMPS driver uses bit 7 ($80) on TL bytes as an "absolute,
                            	   414: ; do not add channel volume" flag — it masks bit 7 before writing and channel
                            	   415: ; volume is added for operators without the flag.  We have no per-channel
                            	   416: ; volume, so we translate $80 directly to a safe carrier TL of $18 (matching
                            	   417: ; Voice $03's proven-clean carrier level) and keep the authoritative
                            	   418: ; modulator TL bytes as-is.
                            	   419: ;
                            	   420: ; ym_trace.lua (2026-04-10) proved the driver was writing these bytes
                            	   421: ; verbatim to the YM2612.  A prior transcription of Voice $00 and Voice $07
                            	   422: ; had the middle two bytes of DT/MUL, RS/AR, AM/D1R, and TL swapped — putting
                            	   423: ; op2's parameters onto op3 and vice versa.  On Voice $03 the middle values
                            	   424: ; are near-symmetric so the swap is inaudible; on Voices $00 and $07 the
                            	   425: ; middle values differ enough that the swap produced cross-wired FM
                            	   426: ; modulation = sustained "crunchy buzz" on both channels.  Restored to the
                            	   427: ; authoritative byte order here.
                            	   428: ;==============================================================================
                            	   429: 
                            	   430: ; Voice $00 — Bell-like pad.
                            	   431: ;
                            	   432: ; Classic FM bell recipe:
                            	   433: ;   Alg 5 (3 carriers modulated by op1)
                            	   434: ;   FB 5 for brightness without the FB 7 "hard bite"
                            	   435: ;   Op1 MUL 4 → produces inharmonic overtones at 4x the carrier pitch,
                            	   436: ;     which is what gives bells their characteristic "chime" quality
                            	   437: ;   Op1 TL $14 → modulator loud enough to shape the bell spectrum
                            	   438: ;   Carriers at MUL 1, tuned unison (no detune beating)
                            	   439: ;   Fast attack, medium D1R, low DL, slow RR = bell strike + sustain tail
                            	   440: PATCH_VOICE00:
02:000005CA 2D              	   441:     dc.b    $2D                     ; FB/ALG: (5<<3)|5 — FB 5 bell pad
02:000005CB 04              	   442:     dc.b    $04,$01,$01,$01         ; DT/MUL — op1 MUL 4 (bell modulator)
02:000005CC 01
02:000005CD 01
02:000005CE 01
02:000005CF 1F              	   443:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR max
02:000005D0 1F
02:000005D1 1F
02:000005D2 1F
02:000005D3 08              	   444:     dc.b    $08,$04,$04,$04         ; AM/D1R — bell-decay shape
02:000005D4 04
02:000005D5 04
02:000005D6 04
02:000005D7 00              	   445:     dc.b    $00,$00,$00,$00         ; D2R
02:000005D8 00
02:000005D9 00
02:000005DA 00
02:000005DB 47              	   446:     dc.b    $47,$37,$37,$17         ; DL 4/3 + RR 7/7/7/7 — bell tail
02:000005DC 37
02:000005DD 37
02:000005DE 17
02:000005DF 14              	   447:     dc.b    $14,$1E,$1E,$1E         ; TL — op1 mod loud ($14), carriers quieter ($1E)
02:000005E0 1E
02:000005E1 1E
02:000005E2 1E
                            	   448:     even
                            	   449: 
                            	   450: ; Voice $03 — EHZ FM3 opening voice (iconic lead)
                            	   451: ; Algorithm 5 (slots 2,3,4 are carriers), Feedback 7
                            	   452: PATCH_VOICE03:
02:000005E4 3D              	   453:     dc.b    $3D                     ; FB/ALG: (7<<3)|5
02:000005E5 01              	   454:     dc.b    $01,$51,$21,$01         ; DT/MUL
02:000005E6 51
02:000005E7 21
02:000005E8 01
02:000005E9 1F              	   455:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR (max — EHZ's slow-attack swell was delaying Zelda's Pulse 2 melody)
02:000005EA 1F
02:000005EB 1F
02:000005EC 1F
02:000005ED 0A              	   456:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:000005EE 05
02:000005EF 05
02:000005F0 05
02:000005F1 00              	   457:     dc.b    $00,$00,$00,$00         ; D2R
02:000005F2 00
02:000005F3 00
02:000005F4 00
02:000005F5 2B              	   458:     dc.b    $2B,$2B,$2B,$1B         ; DL/RR
02:000005F6 2B
02:000005F7 2B
02:000005F8 1B
02:000005F9 19              	   459:     dc.b    $19,$18,$18,$18         ; TL (slot1=modulator $19; slots 2/3/4 carriers +$18 for mix)
02:000005FA 18
02:000005FB 18
02:000005FC 18
                            	   460:     even
                            	   461: 
                            	   462: ; Voice $07 — Clean bass.
                            	   463: ;
                            	   464: ; Pure sine-ish bass: Alg 5, low FB, all operators at MUL 1 with no detune.
                            	   465: ; This is the cleanest possible FM bass — no harmonics beyond what the fun-
                            	   466: ; damental already provides.  Moderately quiet so it supports the lead
                            	   467: ; without fighting it.
                            	   468: PATCH_VOICE07:
02:000005FE 0D              	   469:     dc.b    $0D                     ; FB/ALG: (1<<3)|5 — FB 1 (minimal grit)
02:000005FF 01              	   470:     dc.b    $01,$01,$01,$01         ; DT/MUL — unison, no beating
02:00000600 01
02:00000601 01
02:00000602 01
02:00000603 1F              	   471:     dc.b    $1F,$1F,$1F,$1F         ; RS/AR
02:00000604 1F
02:00000605 1F
02:00000606 1F
02:00000607 0A              	   472:     dc.b    $0A,$05,$05,$05         ; AM/D1R
02:00000608 05
02:00000609 05
02:0000060A 05
02:0000060B 00              	   473:     dc.b    $00,$00,$00,$00         ; D2R
02:0000060C 00
02:0000060D 00
02:0000060E 00
02:0000060F 28              	   474:     dc.b    $28,$28,$28,$18         ; DL 2 / RR 8 — bass punch
02:00000610 28
02:00000611 28
02:00000612 18
02:00000613 22              	   475:     dc.b    $22,$20,$20,$20         ; TL — moderately quiet (less than 27.81's $28)
02:00000614 20
02:00000615 20
02:00000616 20
                            	   476:     even
                            	   477: 
                            	   478: ;==============================================================================
                            	   479: ;==============================================================================
                            	   480: ; NATIVE M68K MUSIC PLAYER
                            	   481: ;
                            	   482: ; Ports the NES Zelda DriveSong engine verbatim, reading the same script
                            	   483: ; opcodes but emitting YM2612/PSG writes instead of NES APU writes.
                            	   484: ;
                            	   485: ; State lives at $FF0B00.  Song data is pulled from the contiguous
                            	   486: ; MusicBlob (SongTable + 9 song headers + 9 song scripts, 2757 bytes)
                            	   487: ; loaded at label MusicBlob.  NES CPU addresses in song headers are
                            	   488: ; converted to M68K pointers via (nes_addr - MUSIC_BLOB_NES_BASE) + MusicBlob.
                            	   489: ;==============================================================================
                            	   490: ;==============================================================================
                            	   491: 
                            	   492: ;----------------------------------------------------------------------
                            	   493: ; Music state RAM ($FF0B00-$FF0B3F, 64 bytes)
                            	   494: ;----------------------------------------------------------------------
                            	   495: ; ============================================================================
                            	   496: ; MUSIC_BASE must be OUTSIDE the NES RAM mirror range.
                            	   497: ; Real NES mirrors its 2 KB RAM through $0000-$1FFF, so any transpiled access
                            	   498: ; through a pointer in zero-page that lands in $0800-$1FFF on 6502 will on our
                            	   499: ; M68K map hit $FF0800-$FF1FFF directly (transpiler does not wrap mirrors).
                            	   500: ; $FF0B00 got continuously clobbered by such accesses during the intro.
                            	   501: ; $FFE000 is safely past $FF1FFF and well below the stack at $FFFFFE.
                            	   502: ; ============================================================================
                            	   503: MUSIC_BASE          equ $FFE000
                            	   504: MUSIC_STATE_SIZE    equ $40
                            	   505: 
                            	   506: m_song              equ MUSIC_BASE+$00  ; current song bitmap
                            	   507: m_song_req          equ MUSIC_BASE+$01  ; requested song change
                            	   508: m_phrase            equ MUSIC_BASE+$02  ; current phrase index
                            	   509: m_len_base          equ MUSIC_BASE+$03  ; note length table base
                            	   510: m_env_sel           equ MUSIC_BASE+$04  ; envelope selector
                            	   511: m_mystery           equ MUSIC_BASE+$05  ; header byte 7 ($05F1 equiv)
                            	   512: m_noise_first       equ MUSIC_BASE+$06  ; noise loop start
                            	   513: m_script_ptr        equ MUSIC_BASE+$08  ; long: M68K pointer to script base
                            	   514: 
                            	   515: ; Sq1 (Pulse 1 → YM ch 0)
                            	   516: m_sq1_off           equ MUSIC_BASE+$0C
                            	   517: m_sq1_cnt           equ MUSIC_BASE+$0D
                            	   518: m_sq1_len           equ MUSIC_BASE+$0E
                            	   519: m_sq1_vib           equ MUSIC_BASE+$0F
                            	   520: m_sq1_per           equ MUSIC_BASE+$10
                            	   521: 
                            	   522: ; Sq0 (Pulse 2 → YM ch 1)
                            	   523: m_sq0_off           equ MUSIC_BASE+$14
                            	   524: m_sq0_cnt           equ MUSIC_BASE+$15
                            	   525: m_sq0_len           equ MUSIC_BASE+$16
                            	   526: m_sq0_vib           equ MUSIC_BASE+$17
                            	   527: m_sq0_per           equ MUSIC_BASE+$18
                            	   528: 
                            	   529: ; Triangle (→ YM ch 2)
                            	   530: m_trg_off           equ MUSIC_BASE+$1C
                            	   531: m_trg_cnt           equ MUSIC_BASE+$1D
                            	   532: m_trg_len           equ MUSIC_BASE+$1E
                            	   533: m_trg_vib           equ MUSIC_BASE+$1F
                            	   534: m_trg_per           equ MUSIC_BASE+$20
                            	   535: m_trg_rep_n         equ MUSIC_BASE+$21
                            	   536: m_trg_rep_s         equ MUSIC_BASE+$22
                            	   537: 
                            	   538: ; Noise (→ PSG ch 3)
                            	   539: m_noise_off         equ MUSIC_BASE+$24
                            	   540: m_noise_cnt         equ MUSIC_BASE+$25
                            	   541: ; Software ADSR state for the PSG noise drum channel (Kroc Sonic 1 SMS pattern).
                            	   542: ; SN76489 has no envelope hardware, so we run a linear software envelope and
                            	   543: ; map it to the 4-bit PSG attenuation every frame.  Writing the noise control
                            	   544: ; register resets the LFSR, so we also cache the last-written control byte and
                            	   545: ; skip redundant writes to preserve the decay tail.
                            	   546: m_noise_level       equ MUSIC_BASE+$26  ; byte: current envelope level ($00-$FF)
                            	   547: m_noise_decay       equ MUSIC_BASE+$27  ; byte: current linear decay rate (per tick)
                            	   548: m_last_psg_nc       equ MUSIC_BASE+$28  ; byte: last noise-control byte written
                            	   549: 
                            	   550: ; Noise-SFX shadow state. Zelda's PlaySfxNote writes $400E/$400C/$400F
                            	   551: ; per sfx-tick. The first two cache here; $400F is the per-hit trigger.
                            	   552: m_sfx_vol           equ MUSIC_BASE+$29  ; byte: last $400C byte
                            	   553: m_sfx_ctrl_raw      equ MUSIC_BASE+$2A  ; byte: last $400E byte
                            	   554: ; Set to 1 by tick_sq1.song_ended each time the song script reaches its
                            	   555: ; loop point (opcode $00). C-side intro_story polls this to sync the
                            	   556: ; final-hold-then-loop-back-to-title transition with the music loop.
                            	   557: ; Owner clears it; ASM only ever writes 1.
                            	   558: m_song_loop_pending equ MUSIC_BASE+$2B  ; byte: 1 = song just looped
                            	   559: 
                            	   560: ;----------------------------------------------------------------------
                            	   561: ; DMC NES-register shadows. The XGM Z80 driver owns playback now; the
                            	   562: ; only state we keep on the 68K side is what nes_io.asm needs to
                            	   563: ; recover the 1-based sample index from the NES $4010/$4012 writes
                            	   564: ; (DMC_SAMPLE_LOOKUP) plus a HUD readout cell.
                            	   565: ;----------------------------------------------------------------------
                            	   566: DMC_BASE            equ $FFE100
                            	   567: dmc_last_idx        equ DMC_BASE+$01    ; byte: last triggered sample index (for HUD)
                            	   568: dmc_rate_sel        equ DMC_BASE+$0C    ; byte: shadow of last $4010 write
                            	   569: dmc_addr_sel        equ DMC_BASE+$0D    ; byte: shadow of last $4012 write
                            	   570: dmc_len_sel         equ DMC_BASE+$0E    ; byte: shadow of last $4013 write
                            	   571: 
                            	   572: ;==============================================================================
                            	   573: ; dmc_trigger — trampoline to SGDK XGM PCM playback.
                            	   574: ;
                            	   575: ; D0.b = 1-based sample index (1..7). Forwards to audio_sfx_play, which
                            	   576: ; maps to XGM SFX ID 64+(idx-1) and dispatches on a round-robin XGM PCM
                            	   577: ; channel (CH2..CH4). Z80 mixer streams to YM2612 reg $2A; the legacy
                            	   578: ; HBlank DAC streamer below is dead (kept temporarily for reference, to
                            	   579: ; be deleted in step 5).
                            	   580: ;
                            	   581: ; Sample format conversion lives in tools/extract_dmc_samples.py:
                            	   582: ; bandlimited resample (scipy resample_poly + Kaiser FIR) from native NES
                            	   583: ; rate to XGM's fixed 14 kHz, padded to 256-byte boundaries, emitted as
                            	   584: ; aligned C arrays in data/audio/sfx_pcm.c.
                            	   585: ;==============================================================================
                            	   586:     xref    audio_sfx_play
                            	   587: dmc_trigger:
02:00000618 4A00            	   588:     tst.b   D0
02:0000061A 6716            	   589:     beq.s   .bad
02:0000061C B03C0007        	   590:     cmp.b   #DMC_SAMPLE_COUNT,D0
02:00000620 6210            	   591:     bhi.s   .bad
02:00000622 13C000FFE101    	   592:     move.b  D0,(dmc_last_idx).l     ; HUD readout still uses this
02:00000628 2F00            	   593:     move.l  D0,-(SP)                ; GCC m68k ABI: arg in stack
02:0000062A 4EB900000000    	   594:     jsr     audio_sfx_play
02:00000630 588F            	   595:     addq.l  #4,SP
                            	   596: .bad:
02:00000632 4E75            	   597:     rts
                            	   598: 
                            	   599: ;==============================================================================
                            	   600: ; music_play — request a song change
                            	   601: ; Input: D0.b = song bitmap
                            	   602: ;==============================================================================
                            	   603:     xdef    music_play
                            	   604: music_play:
02:00000634 13C000FFE001    	   605:     move.b  D0,(m_song_req).l
02:0000063A 4E75            	   606:     rts
                            	   607: 
                            	   608: ;==============================================================================
                            	   609: ; music_tick — DriveSong equivalent.  Call once per VBlank.
                            	   610: ;==============================================================================
                            	   611:     xdef    music_tick
                            	   612: music_tick:
02:0000063C 48E7FFE0        	   613:     movem.l D0-D7/A0-A2,-(SP)
                            	   614:     ;------------------------------------------------------------------
                            	   615:     ; Phase E polish: FM music path restored.  DMC streams independently
                            	   616:     ; from HBlank via dmc_hint_tick, so the main-thread music tick no
                            	   617:     ; longer needs to stay muted.  ym_write1/2 carry SR lockout so the
                            	   618:     ; HINT-driven DAC streamer can't corrupt the YM2612 latch between
                            	   619:     ; address and data bytes.
                            	   620:     ;
                            	   621:     ; Structure matches the pre-isolation (Zelda27.82) tick: consume
                            	   622:     ; song_req via change_song, otherwise tick_sq1 if a song is playing.
                            	   623:     ; dmc_dbg_poll + dmc_feed run after either path.  dmc_feed is now a
                            	   624:     ; labeled rts — the call costs ~20 cycles total and lets us defer
                            	   625:     ; removing it to a later cleanup pass.
                            	   626:     ;------------------------------------------------------------------
                            	   627:     ; Attract-mode-exit hook: the game's DriveAudio is NOP'd, so the
                            	   628:     ; audio driver's own SilenceSong paths (via DriveTune0 → $0604 bit7
                            	   629:     ; and DriveTune1 → $0602 bit7) never run.  Game logic still writes
                            	   630:     ; the request bytes at state transitions.  The attract-to-file-menu
                            	   631:     ; path (UpdateMode0Demo_Sub0 → SilenceAllSound in z_01.asm:4118)
                            	   632:     ; sets $0604 = $80 and $0603 = $80.  Poll both $0604 and $0602 for
                            	   633:     ; the silence-request bit 7 and route it into native music_silence.
                            	   634:     ; Also clear $0605/$0607 (current-tune shadows) so the game's own
                            	   635:     ; "nothing playing" markers stay coherent with our silenced state.
                            	   636:     ; SongRequest bridge: game writes D0 -> $FF0600 (NES RAM SongRequest) at
                            	   637:     ; every song change (title/gameplay/dungeon/etc.). Forward to m_song_req
                            	   638:     ; and clear the game-side byte so the game's own driver-absent check
                            	   639:     ; ("did my song change get consumed?") stays coherent.
02:00000640 103900FF0600    	   640:     move.b  ($FF0600).l,D0
02:00000646 670C            	   641:     beq.s   .no_song_req_bridge
02:00000648 423900FF0600    	   642:     clr.b   ($FF0600).l
02:0000064E 13C000FFE001    	   643:     move.b  D0,(m_song_req).l
                            	   644: .no_song_req_bridge:
02:00000654 103900FF0604    	   645:     move.b  ($FF0604).l,D0          ; Tune 0 request (SilenceAllSound)
02:0000065A 6B08            	   646:     bmi.s   .do_silence
02:0000065C 103900FF0602    	   647:     move.b  ($FF0602).l,D0          ; Tune 1 request (silence-then-play)
02:00000662 6A24            	   648:     bpl.s   .no_silence_req
                            	   649: .do_silence:
02:00000664 423900FF0602    	   650:     clr.b   ($FF0602).l
02:0000066A 423900FF0603    	   651:     clr.b   ($FF0603).l
02:00000670 423900FF0604    	   652:     clr.b   ($FF0604).l
02:00000676 423900FF0605    	   653:     clr.b   ($FF0605).l
02:0000067C 423900FF0607    	   654:     clr.b   ($FF0607).l
02:00000682 6100067A        	   655:     bsr     music_silence
02:00000686 6024            	   656:     bra.s   .done
                            	   657: .no_silence_req:
02:00000688 103900FFE001    	   658:     move.b  (m_song_req).l,D0
02:0000068E 6710            	   659:     beq.s   .no_req
02:00000690 423900FFE001    	   660:     clr.b   (m_song_req).l
02:00000696 13C000FFE000    	   661:     move.b  D0,(m_song).l
02:0000069C 6114            	   662:     bsr     change_song
02:0000069E 600C            	   663:     bra.s   .done
                            	   664: .no_req:
02:000006A0 4A3900FFE000    	   665:     tst.b   (m_song).l
02:000006A6 6704            	   666:     beq.s   .done
02:000006A8 610001B0        	   667:     bsr     tick_sq1
                            	   668: .done:
                            	   669:     ; SFX dispatch lives on the SGDK XGM Z80 driver now (Z80 mixes PCM
                            	   670:     ; on its own clock); no per-VBlank DMC drain or scaffold poll here.
02:000006AC 4CDF07FF        	   671:     movem.l (SP)+,D0-D7/A0-A2
02:000006B0 4E75            	   672:     rts
                            	   673: 
                            	   674: ;==============================================================================
                            	   675: ; change_song — ported from @ChangeSong
                            	   676: ; Input: D0.b = new song bitmap (already stored in m_song)
                            	   677: ;
                            	   678: ; Selects the starting phrase index for the new song, then falls into
                            	   679: ; prep_phrase / play_next_phrase to begin playback.  Final step performs
                            	   680: ; an immediate tick_sq1 (matching KeepPlayingSong fall-through).
                            	   681: ;==============================================================================
                            	   682: change_song:
02:000006B2 4A00            	   683:     tst.b   D0
02:000006B4 6B46            	   684:     bmi.s   .first_demo                 ; bit 7 → demo/title
02:000006B6 B03C0006        	   685:     cmp.b   #$06,D0
02:000006BA 6610            	   686:     bne.s   .not_zelda
02:000006BC 13FC002400FFE002	   687:     move.b  #$24,(m_phrase).l           ; zelda: phrase $24 directly
02:000006C4 610000E0        	   688:     bsr     prep_phrase
02:000006C8 60000190        	   689:     bra     tick_sq1
                            	   690: .not_zelda:
02:000006CC B03C0001        	   691:     cmp.b   #$01,D0
02:000006D0 6716            	   692:     beq.s   .first_ow
02:000006D2 B03C0040        	   693:     cmp.b   #$40,D0
02:000006D6 671A            	   694:     beq.s   .first_uw
02:000006D8 B03C0010        	   695:     cmp.b   #$10,D0
02:000006DC 6626            	   696:     bne     play_next_phrase            ; single-phrase song
02:000006DE 13FC001100FFE002	   697:     move.b  #$11,(m_phrase).l           ; ending: SetPrev then fall into PlayNext
02:000006E6 601C            	   698:     bra     play_next_phrase
                            	   699: .first_ow:
02:000006E8 13FC000800FFE002	   700:     move.b  #$08,(m_phrase).l
02:000006F0 6012            	   701:     bra     play_next_phrase
                            	   702: .first_uw:
02:000006F2 13FC000F00FFE002	   703:     move.b  #$0F,(m_phrase).l
02:000006FA 6008            	   704:     bra     play_next_phrase
                            	   705: .first_demo:
02:000006FC 13FC001900FFE002	   706:     move.b  #$19,(m_phrase).l
                            	   707:     bra     play_next_phrase
                            	   708: 
                            	   709: ;==============================================================================
                            	   710: ; play_next_phrase — ported from PlayNextPhrase
                            	   711: ; Increments phrase index for multi-phrase songs (with wrap), then
                            	   712: ; calls prep_phrase and falls into tick_sq1.
                            	   713: ;==============================================================================
                            	   714: play_next_phrase:
02:00000704 103900FFE000    	   715:     move.b  (m_song).l,D0
02:0000070A 6B78            	   716:     bmi.s   .next_demo                  ; bit 7 → demo (multi)
02:0000070C B03C0001        	   717:     cmp.b   #$01,D0
02:00000710 6758            	   718:     beq.s   .next_ow
02:00000712 B03C0040        	   719:     cmp.b   #$40,D0
02:00000716 6738            	   720:     beq.s   .next_uw
02:00000718 B03C0010        	   721:     cmp.b   #$10,D0
02:0000071C 6718            	   722:     beq.s   .next_ending
                            	   723:     ; Single-phrase song: find bit position, phrase = index
02:0000071E 7200            	   724:     moveq   #0,D1
02:00000720 7400            	   725:     moveq   #0,D2
02:00000722 1400            	   726:     move.b  D0,D2
                            	   727: .bitloop:
02:00000724 5201            	   728:     addq.b  #1,D1
02:00000726 E20A            	   729:     lsr.b   #1,D2
02:00000728 64FA            	   730:     bcc.s   .bitloop
02:0000072A 13C100FFE002    	   731:     move.b  D1,(m_phrase).l
02:00000730 6174            	   732:     bsr     prep_phrase
02:00000732 60000126        	   733:     bra     tick_sq1
                            	   734: .next_ending:
02:00000736 523900FFE002    	   735:     addq.b  #1,(m_phrase).l
02:0000073C 0C39001A00FFE002	   736:     cmpi.b  #$1A,(m_phrase).l
02:00000744 665A            	   737:     bne.s   .prep_and_tick
02:00000746 13FC001400FFE002	   738:     move.b  #$14,(m_phrase).l
02:0000074E 60B4            	   739:     bra     play_next_phrase
                            	   740: .next_uw:
02:00000750 523900FFE002    	   741:     addq.b  #1,(m_phrase).l
02:00000756 0C39001200FFE002	   742:     cmpi.b  #$12,(m_phrase).l
02:0000075E 6640            	   743:     bne.s   .prep_and_tick
02:00000760 13FC000F00FFE002	   744:     move.b  #$0F,(m_phrase).l
02:00000768 609A            	   745:     bra     play_next_phrase
                            	   746: .next_ow:
02:0000076A 523900FFE002    	   747:     addq.b  #1,(m_phrase).l
02:00000770 0C39001000FFE002	   748:     cmpi.b  #$10,(m_phrase).l
02:00000778 6626            	   749:     bne.s   .prep_and_tick
02:0000077A 13FC000900FFE002	   750:     move.b  #$09,(m_phrase).l
02:00000782 6080            	   751:     bra     play_next_phrase
                            	   752: .next_demo:
02:00000784 523900FFE002    	   753:     addq.b  #1,(m_phrase).l
02:0000078A 0C39002400FFE002	   754:     cmpi.b  #$24,(m_phrase).l
02:00000792 660C            	   755:     bne.s   .prep_and_tick
02:00000794 13FC001900FFE002	   756:     move.b  #$19,(m_phrase).l
02:0000079C 6000FF66        	   757:     bra     play_next_phrase
                            	   758: .prep_and_tick:
