                            	  4477: UpdatePeaceTextbox:
                            	  4478:     ; Only emit a character once every 8 frames --
                            	  4479:     ; when (counter [0412] MOD 8) = 4.
                            	  4480:     ;
02:00028792 522C0412        	  4481:     addq.b  #1,($0412,A4)
02:00028796 102C0412        	  4482:     move.b  ($0412,A4),D0
02:0002879A 02000007        	  4483:     andi.b #$07,D0
02:0002879E 0C000004        	  4484:     cmpi.b  #$04,D0
02:000287A2 665C            	  4485:     bne  _L_z02_UpdatePeaceTextbox_Exit
                            	  4486:     ; Copy the 5 bytes of the textbox character transfer record template
                            	  4487:     ; to the dynamic transfer buf.
                            	  4488:     ;
02:000287A4 7604            	  4489:     moveq   #4,D3
                            	  4490: _anon_z02_35:
02:000287A6 41F900028722    	  4491:     lea     (PeaceTextboxCharTransferRecTemplate).l,A0
02:000287AC 10303000        	  4492:     move.b  (A0,D3.W),D0
02:000287B0 41EC0302        	  4493:     lea     ($0302,A4),A0
02:000287B4 11803000        	  4494:     move.b  D0,(A0,D3.W)
02:000287B8 5303            	  4495:     subq.b  #1,D3
02:000287BA 6AEA            	  4496:     bpl  _anon_z02_35
                            	  4497:     ; Load a character from the string and copy it to
                            	  4498:     ; the transfer record until we read character $FF.
                            	  4499:     ;
02:000287BC 7600            	  4500:     moveq   #0,D3
02:000287BE 162C0413        	  4501:     move.b  ($0413,A4),D3
02:000287C2 41F90002875C    	  4502:     lea     (PeaceText).l,A0
02:000287C8 10303000        	  4503:     move.b  (A0,D3.W),D0
02:000287CC 0C0000FF        	  4504:     cmpi.b  #$FF,D0
02:000287D0 6730            	  4505:     beq  _L_z02_UpdatePeaceTextbox_AdvanceSubmode
02:000287D2 19400305        	  4506:     move.b  D0,($0305,A4)
                            	  4507:     ; A regular space takes as much time to emit as any character.
                            	  4508:     ; But it makes no sound.
                            	  4509:     ;
02:000287D6 0C000024        	  4510:     cmpi.b  #$24,D0
02:000287DA 6706            	  4511:     beq  _anon_z02_36
02:000287DC 7010            	  4512:     moveq   #16,D0
02:000287DE 19400604        	  4513:     move.b  D0,($0604,A4)
                            	  4514: _anon_z02_36:
                            	  4515:     ; Point to the next character in the string.
                            	  4516:     ;
02:000287E2 522C0413        	  4517:     addq.b  #1,($0413,A4)
                            	  4518:     ; Replace the low byte of the VRAM address with the one
                            	  4519:     ; where the next character should be written.
                            	  4520:     ;
02:000287E6 41F900028728    	  4521:     lea     (PeaceTextboxCharAddrsLo).l,A0
02:000287EC 10303000        	  4522:     move.b  (A0,D3.W),D0
02:000287F0 19400303        	  4523:     move.b  D0,($0303,A4)
                            	  4524:     ; Once the low VRAM address rolls over,
                            	  4525:     ; increment the high address.
                            	  4526:     ;
02:000287F4 0C0000A0        	  4527:     cmpi.b  #$A0,D0
02:000287F8 6406            	  4528:     bcc  _L_z02_UpdatePeaceTextbox_Exit
02:000287FA 7023            	  4529:     moveq   #35,D0
02:000287FC 19400302        	  4530:     move.b  D0,($0302,A4)
