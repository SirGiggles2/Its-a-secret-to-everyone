02:000346F4 1B00            	  7250:     move.b  D0,-(A5)  ; PHA
02:000346F6 02000007        	  7251:     andi.b #$07,D0
02:000346FA 0C000002        	  7252:     cmpi.b  #$02,D0
02:000346FE 6606            	  7253:     bne  _anon_z05_156
02:00034700 7004            	  7254:     moveq   #4,D0
