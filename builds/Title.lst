02:000300F2 0C0000F8        	   342:     cmpi.b  #$F8,D0
02:000300F6 670C            	   343:     beq  _anon_z05_5
02:000300F8 023C00EE        	   344:     andi    #$EE,CCR  ; CLC: clear C+X
