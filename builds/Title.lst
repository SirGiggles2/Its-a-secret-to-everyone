                            	  1629:     ; Store the Y coordinate that we determined as the Target Y.
                            	  1630:     ;
02:00030EDC 19400412        	  1631:     move.b  D0,($0412,A4)
02:00030EE0 023C00EE        	  1632:     andi    #$EE,CCR  ; CLC: clear C+X
02:00030EE4 123C0010        	  1633:     move.b  #$10,D1
02:00030EE8 D101            	  1634:     addx.b  D1,D0   ; ADC #$10 (X flag = 6502 C)
02:00030EEA 19400084        	  1635:     move.b  D0,($0084,A4)
02:00030EEE 7008            	  1636:     moveq   #8,D0
02:00030EF0 19400603        	  1637:     move.b  D0,($0603,A4)
