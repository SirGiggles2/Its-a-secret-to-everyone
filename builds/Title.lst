                            	   542: ;------------------------------------------------------------------------------
                            	   543: ; _ags_apply_active — Program VDP VSRAM/H-int state for the current frame from
                            	   544: ; the active queue/debug state set by _ags_activate_staged. For no-split and
                            	   545: ; intro dead-zone modes, the base VSRAM comes from ACTIVE_BASE_VSRAM.
                            	   546: ;
                            	   547: ; Clobbers D0.
                            	   548: ;------------------------------------------------------------------------------
                            	   549: _ags_apply_active:
02:00001A9C 4A3900FF081F    	   550:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,(INTRO_SCROLL_MODE).l
02:00001AA2 662E            	   551:     bne.s   .aaa_split
                            	   552:     ; No-split path: full H-int off sequence. PCM streaming moved off
                            	   553:     ; HBlank onto the SGDK XGM Z80 driver, so HINT can be unconditionally
                            	   554:     ; disabled here without stomping any sample DAC writes.
02:00001AA4 33FC8AFF00C00004	   555:     move.w  #$8AFF,(VDP_CTRL).l             ; Reg 10 = $FF (inactive)
02:00001AAC 33FC800400C00004	   556:     move.w  #$8004,(VDP_CTRL).l             ; Reg 0: H-int off
02:00001AB4 23FC4000001000C0	   557:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00001ABC 0004
02:00001ABE 33F900FF083600C0	   558:     move.w  (ACTIVE_BASE_VSRAM).l,(VDP_DATA).l
02:00001AC6 0000
02:00001AC8 7000            	   559:     moveq   #0,D0
02:00001ACA 33C000C00000    	   560:     move.w  D0,(VDP_DATA).l
02:00001AD0 4E75            	   561:     rts
                            	   562: .aaa_split:
02:00001AD2 23FC4000001000C0	   563:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00001ADA 0004
02:00001ADC 7000            	   564:     moveq   #0,D0
02:00001ADE 0C39000100FF081F	   565:     cmpi.b  #INTRO_SCROLL_GAME_SPLIT,(INTRO_SCROLL_MODE).l
02:00001AE6 6706            	   566:     beq.s   .aaa_base_ready
02:00001AE8 303900FF0836    	   567:     move.w  (ACTIVE_BASE_VSRAM).l,D0
                            	   568: .aaa_base_ready:
02:00001AEE 33C000C00000    	   569:     move.w  D0,(VDP_DATA).l
02:00001AF4 7000            	   570:     moveq   #0,D0
02:00001AF6 33C000C00000    	   571:     move.w  D0,(VDP_DATA).l
02:00001AFC 7000            	   572:     moveq   #0,D0
02:00001AFE 103900FF0817    	   573:     move.b  (HINT_Q0_CTR).l,D0
02:00001B04 024000FF        	   574:     andi.w  #$00FF,D0
02:00001B08 807C8A00        	   575:     or.w    #$8A00,D0
02:00001B0C 33C000C00004    	   576:     move.w  D0,(VDP_CTRL).l                 ; Reg 10 = active H-int scanline
02:00001B12 33FC801400C00004	   577:     move.w  #$8014,(VDP_CTRL).l             ; Reg 0: enable H-int (+colorfix bit)
02:00001B1A 4E75            	   578:     rts
                            	   579: 
                            	   580: ;------------------------------------------------------------------------------
                            	   581: ; _mode_transition_check — runs from VBlankISR after _ags_prearm, before
                            	   582: ; IsrNmi.  Detects a change in GameMode ($0012) against the LAST_GAMEMODE
                            	   583: ; shadow and, on transition, purges stale scroll latches, zeros the two
                            	   584: ; VSRAM words directly via the VDP control port, and rewinds the DynTileBuf
                            	   585: ; palette-precheck state so _patch_z06 P3 runs fresh on the new mode's
                            	   586: ; first tile transfer.
                            	   587: ;
                            	   588: ; Fixes VSRAM bleed-through seen when leaving attract → file-select →
                            	   589: ; gameplay: the new mode inherited the old mode's vertical scroll register
                            	   590: ; value for a single frame before the first _ags_flush landed.
                            	   591: ;
                            	   592: ; Preserves: D1-D7, A0-A6 (clobbers D0 internally and restores it).
                            	   593: ;------------------------------------------------------------------------------
                            	   594: _mode_transition_check:
02:00001B1C 2F00            	   595:     move.l  D0,-(SP)
02:00001B1E 102C0012        	   596:     move.b  ($0012,A4),D0
02:00001B22 B03900FF083E    	   597:     cmp.b   (LAST_GAMEMODE).l,D0
02:00001B28 6760            	   598:     beq.s   .mtc_done
                            	   599:     ; --- mode changed: latch new shadow and purge stale PPU state ---
02:00001B2A 13C000FF083E    	   600:     move.b  D0,(LAST_GAMEMODE).l
02:00001B30 423900FF0800    	   601:     clr.b   (PPU_LATCH).l
02:00001B36 427900FF0802    	   602:     clr.w   (PPU_VADDR).l
02:00001B3C 423900FF0809    	   603:     clr.b   (PPU_DHALF).l
02:00001B42 423900FF0808    	   604:     clr.b   (PPU_DBUF).l
                            	   605:     ; Phase 9: PPU_SCRL_X/Y clears removed (dead — never read)
                            	   606:     ; Direct VSRAM[0] + VSRAM[1] = 0 (inside vblank window).
02:00001B48 23FC4000001000C0	   607:     move.l  #VSRAM_WRITE_0000,(VDP_CTRL).l
02:00001B50 0004
02:00001B52 33FC000000C00000	   608:     move.w  #0,(VDP_DATA).l          ; Plane A V-scroll
02:00001B5A 33FC000000C00000	   609:     move.w  #0,(VDP_DATA).l          ; Plane B V-scroll
                            	   610:     ; Preserve any live transfer work across a mode transition.
                            	   611:     ;
                            	   612:     ; Two cases matter:
                            	   613:     ;  1) DynTileBuf non-empty: pending dynamic record must survive.
                            	   614:     ;  2) TileBufSelector non-zero: pending static transfer request must survive.
                            	   615:     ;
                            	   616:     ; Room scroll transitions rely on selector-driven transfers after the mode
                            	   617:     ; has already changed, so clearing $0014 here when DynTileBuf is empty is
                            	   618:     ; too aggressive.
02:00001B62 4A2C0014        	   619:     tst.b   ($0014,A4)
02:00001B66 6622            	   620:     bne.s   .mtc_keep_pending
02:00001B68 0C2C00FF0302    	   621:     cmpi.b  #$FF,($0302,A4)
02:00001B6E 661A            	   622:     bne.s   .mtc_keep_pending
                            	   623:     ; No pending selector and DynTileBuf empty: safe to rewind the
                            	   624:     ; palette-precheck state and clear stale one-shots from the old mode.
02:00001B70 422C0014        	   625:     clr.b   ($0014,A4)               ; PPU update request byte
02:00001B74 422C005C        	   626:     clr.b   ($005C,A4)               ; SwitchNameTablesReq one-shot
02:00001B78 197C003F0300    	   627:     move.b  #63,($0300,A4)
02:00001B7E 197C00000301    	   628:     move.b  #0,($0301,A4)
02:00001B84 197C00FF0302    	   629:     move.b  #$FF,($0302,A4)
                            	   630: .mtc_keep_pending:
                            	   631: .mtc_done:
02:00001B8A 201F            	   632:     move.l  (SP)+,D0
02:00001B8C 4E75            	   633:     rts
                            	   634: 
                            	   635: 
                            	   636: 
                            	   637: ;------------------------------------------------------------------------------
                            	   638: ; _ppu_write_6 — PPUADDR ($2006)  ← T5 key implementation
                            	   639: ;
                            	   640: ; The NES PPU address register uses a two-write protocol (shared "w" latch):
                            	   641: ;   First  write: high byte of 15-bit VRAM address (bit 14 is forced clear by
                            	   642: ;                 hardware — valid VRAM is $0000–$3FFF).
                            	   643: ;   Second write: low byte.  After this write PPU_VADDR is fully updated and
                            	   644: ;                 the latch resets to 0.
                            	   645: ;
                            	   646: ; Side effect: resets the even-byte PPUDATA buffer (PPU_DHALF = 0) so that a
                            	   647: ; fresh address is always treated as the start of a new word-pair.
                            	   648: ;
                            	   649: ; Preserves: D1.
                            	   650: ;------------------------------------------------------------------------------
                            	   651: _ppu_write_6:
02:00001B8E 48E74000        	   652:     movem.l D1,-(SP)
02:00001B92 123900FF0800    	   653:     move.b  (PPU_LATCH).l,D1
02:00001B98 4A01            	   654:     tst.b   D1
02:00001B9A 6618            	   655:     bne.s   .second_write_6
                            	   656:     ; ---- First write: high byte ----
                            	   657:     ; High byte goes into PPU_VADDR+0.  Force bit 6 (addr bit 14) clear to
                            	   658:     ; keep address in the valid $0000–$3FFF window (matches NES hardware).
02:00001B9C 0200003F        	   659:     andi.b  #$3F,D0
02:00001BA0 13C000FF0802    	   660:     move.b  D0,(PPU_VADDR).l        ; store high byte
02:00001BA6 13FC000100FF0800	   661:     move.b  #1,(PPU_LATCH).l
02:00001BAE 4CDF0002        	   662:     movem.l (SP)+,D1
02:00001BB2 4E75            	   663:     rts
                            	   664: .second_write_6:
                            	   665:     ; ---- Second write: low byte ----
02:00001BB4 13C000FF0803    	   666:     move.b  D0,(PPU_VADDR+1).l      ; store low byte
02:00001BBA 423900FF0800    	   667:     clr.b   (PPU_LATCH).l           ; reset w register
02:00001BC0 423900FF0809    	   668:     clr.b   (PPU_DHALF).l           ; discard any pending even-byte buffer
02:00001BC6 4CDF0002        	   669:     movem.l (SP)+,D1
02:00001BCA 4E75            	   670:     rts
                            	   671: 
                            	   672: ;------------------------------------------------------------------------------
                            	   673: ; _ppu_write_7 — PPUDATA ($2007)  ← T16 full implementation
                            	   674: ;
                            	   675: ; Routes byte writes to one of two paths based on PPU_VADDR:
                            	   676: ;
                            	   677: ;   CHR-RAM path  (PPU_VADDR $0000–$1FFF):
                            	   678: ;     Accumulates 16 bytes per NES tile in CHR_TILE_BUF, then on the 16th
                            	   679: ;     byte converts the 2BPP NES tile to 4BPP Genesis format and writes the
                            	   680: ;     32-byte result to VDP VRAM at Genesis addr = NES_addr × 2.
                            	   681: ;
                            	   682: ;   Nametable/palette path (PPU_VADDR $2000–$3FFF):
                            	   683: ;     Buffers even-address bytes and flushes pairs as 16-bit VDP words
                            	   684: ;     (unchanged from T5 — correct for nametable clears and palette writes).
                            	   685: ;
                            	   686: ; NES 2BPP → Genesis 4BPP conversion:
                            	   687: ;   16 bytes in: 8 bytes plane-0 then 8 bytes plane-1 (one bit per pixel)
                            	   688: ;   32 bytes out: 4 bytes per row, 2 pixels per byte, high-nibble = left pixel
                            	   689: ;   Pixel color = (plane1_bit << 1) | plane0_bit   (values 0–3)
                            	   690: ;
                            	   691: ; VDP auto-increment = 2 (Reg 15 = $8F02 set by genesis_shell).
                            	   692: ; PPU_VADDR increments by 1 (horizontal mode, bit 2 of PPUCTRL = 0).
                            	   693: ;
                            	   694: ; Preserves: D0–D6, A0–A6 (all saved/restored).
                            	   695: ;------------------------------------------------------------------------------
                            	   696: _ppu_write_7:
02:00001BCC 48E7FEC0        	   697:     movem.l D0-D6/A0-A1,-(SP)       ; save all working registers (A1 used by LUT in .chr_convert_upload)
                            	   698: 
02:00001BD0 323900FF0802    	   699:     move.w  (PPU_VADDR).l,D1        ; D1 = current NES PPU address
                            	   700: 
                            	   701:     ; Route: CHR range ($0000–$1FFF) vs nametable/palette ($2000–$3FFF)
02:00001BD6 0C412000        	   702:     cmpi.w  #$2000,D1
02:00001BDA 647E            	   703:     bhs     .nt_write               ; ≥$2000 → nametable / palette path
                            	   704: 
                            	   705:     ;==========================================================================
                            	   706:     ; CHR TILE BUFFER PATH
                            	   707:     ;==========================================================================
                            	   708:     ; Buffer each byte.  On the 16th byte, convert the tile and upload it.
02:00001BDC 523900FF0834    	   709:     addq.b  #1,(CHR_HIT_COUNT).l   ; DEBUG: count every CHR path entry (wraps at 255)
02:00001BE2 7400            	   710:     moveq   #0,D2
02:00001BE4 143900FF0830    	   711:     move.b  (CHR_BUF_CNT).l,D2     ; D2 = bytes accumulated so far (0–15)
                            	   712: 
                            	   713:     ; Save this tile's base address on the first byte (aligned to 16 bytes)
02:00001BEA 4A02            	   714:     tst.b   D2
02:00001BEC 660C            	   715:     bne.s   .chr_store_byte
02:00001BEE 3601            	   716:     move.w  D1,D3
02:00001BF0 0243FFF0        	   717:     andi.w  #$FFF0,D3               ; round down to 16-byte tile boundary
02:00001BF4 33C300FF0832    	   718:     move.w  D3,(CHR_BUF_VADDR).l
                            	   719: 
                            	   720: .chr_store_byte:
02:00001BFA 41F900FF0820    	   721:     lea     (CHR_TILE_BUF).l,A0
02:00001C00 11802000        	   722:     move.b  D0,(A0,D2.w)            ; CHR_TILE_BUF[count] = byte
02:00001C04 523900FF0830    	   723:     addq.b  #1,(CHR_BUF_CNT).l     ; increment count
02:00001C0A 6100032C        	   724:     bsr     .inc_ppuaddr            ; advance PPU_VADDR
                            	   725: 
02:00001C0E 0C39001000FF0830	   726:     cmpi.b  #16,(CHR_BUF_CNT).l
02:00001C16 663C            	   727:     bne.s   .chr_ret                ; not yet 16 bytes — keep buffering
                            	   728: 
                            	   729:     ; Complete tile — convert 2BPP → 4BPP and upload to VDP VRAM
                            	   730:     ifne CHR_EXPANSION_ENABLED
                            	   731:     ; Dispatch by NES address bit 12:
                            	   732:     ;   bit12=0 ($0000-$0FFF) → sprite half → _chr_upload_sprite_4x (4 copies)
                            	   733:     ;   bit12=1 ($1000-$1FFF) → BG half     → _chr_convert_upload   (1 copy)
                            	   734:     ; Preflight (reports/chr_preflight.txt) confirms PPUCTRL bit 3 = 0 always,
                            	   735:     ; so sprites live at $0000-$0FFF for all current scenes.
02:00001C18 343900FF0832    	   736:     move.w  (CHR_BUF_VADDR).l,D2
02:00001C1E 0802000C        	   737:     btst    #12,D2
02:00001C22 6606            	   738:     bne.s   .chr_bg_dispatch
02:00001C24 610003D6        	   739:     bsr     _chr_upload_sprite_4x
02:00001C28 6024            	   740:     bra.s   .chr_uploaded
                            	   741: .chr_bg_dispatch:
02:00001C2A 61000330        	   742:     bsr     _chr_convert_upload
02:00001C2E 0839000500FF0804	   743:     btst    #5,(PPU_CTRL).l
02:00001C36 6716            	   744:     beq.s   .chr_uploaded
02:00001C38 303900FF0832    	   745:     move.w  (CHR_BUF_VADDR).l,D0
02:00001C3E 0C401F20        	   746:     cmpi.w  #$1F20,D0
