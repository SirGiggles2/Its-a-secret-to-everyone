                            	  2413: UpdatePondFairy:
02:0002C95C 610031C0        	  2414:     jsr     DrawFairy
                            	  2415:     ; If not in state 0, then go handle states 1 to 3.
                            	  2416:     ;
02:0002C960 102C00AD        	  2417:     move.b  ($00AD,A4),D0
02:0002C964 6702            	  2418:     beq.s  __far_z_04_0020
02:0002C966 602A            	  2419:     jmp  PondFairy_HandleOtherStates
                            	  2420: __far_z_04_0020:
                            	  2421:     ; State 0.
                            	  2422:     ;
                            	  2423:     ; If Link is not at the edge of the pond (Y=$AD), then return.
                            	  2424:     ;
02:0002C968 102C0084        	  2425:     move.b  ($0084,A4),D0
02:0002C96C 0C0000AD        	  2426:     cmpi.b  #$AD,D0
02:0002C970 661E            	  2427:     bne  _L_z04_UpdatePondFairy_Exit
                            	  2428:     ; If Link's X < $70 or >= $81, then return.
                            	  2429:     ;
02:0002C972 102C0070        	  2430:     move.b  ($0070,A4),D0
02:0002C976 0C000070        	  2431:     cmpi.b  #$70,D0
02:0002C97A 6514            	  2432:     bcs  _L_z04_UpdatePondFairy_Exit
02:0002C97C 0C000081        	  2433:     cmpi.b  #$81,D0
02:0002C980 640E            	  2434:     bcc  _L_z04_UpdatePondFairy_Exit
                            	  2435:     ; Link is at the edge of the pond. Advance to state 1,
                            	  2436:     ; halt Link, and start filling hearts.
                            	  2437:     ;
02:0002C982 522C00AD        	  2438:     addq.b  #1,($00AD,A4)
02:0002C986 7040            	  2439:     moveq   #64,D0
02:0002C988 194000AC        	  2440:     move.b  D0,($00AC,A4)
02:0002C98C 19400063        	  2441:     move.b  D0,($0063,A4)
                            	  2442:     even
                            	  2443: _L_z04_UpdatePondFairy_Exit:
02:0002C990 4E75            	  2444:     rts
                            	  2445: 
                            	  2446:     even
                            	  2447: PondFairy_HandleOtherStates:
02:0002C992 0C000001        	  2448:     cmpi.b  #$01,D0
02:0002C996 6610            	  2449:     bne  _L_z04_PondFairy_HandleOtherStates_CheckState2
                            	  2450:     ; State 1. Flying and filling hearts.
                            	  2451:     ;
                            	  2452:     ; If still filling hearts, then go draw Link and hearts.
                            	  2453:     ;
02:0002C998 102C0063        	  2454:     move.b  ($0063,A4),D0
02:0002C99C 6620            	  2455:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2456:     ; If not filling hearts anymore, then go to state 2,
                            	  2457:     ; and set Link's object timer to $50, to keep showing hearts
                            	  2458:     ; a little while after we finish filling hearts.
                            	  2459:     ;
02:0002C99E 522C00AD        	  2460:     addq.b  #1,($00AD,A4)
02:0002C9A2 7050            	  2461:     moveq   #80,D0
02:0002C9A4 19400029        	  2462:     move.b  D0,($0029,A4)
                            	  2463:     even
                            	  2464: _L_z04_PondFairy_HandleOtherStates_CheckState2:
                            	  2465:     ; If state <> 2 (so, it's 3), then return.
                            	  2466:     ;
                            	  2467:     ; Note that the first time here is when we fall thru from 8DBC.
                            	  2468:     ; In this case, A has $50 -- the value that Link's object timer
                            	  2469:     ; was set to, and we'll return.
                            	  2470:     ;
02:0002C9A8 0C000002        	  2471:     cmpi.b  #$02,D0
02:0002C9AC 6634            	  2472:     bne  _L_z04_PondFairy_HandleOtherStates_Exit
                            	  2473:     ; State = 2.
                            	  2474:     ;
                            	  2475:     ; If Link's timer <> 0, then go draw Link and hearts.
                            	  2476:     ;
02:0002C9AE 102C0029        	  2477:     move.b  ($0029,A4),D0
02:0002C9B2 660A            	  2478:     bne  _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts
                            	  2479:     ; Else go to state 3, and unhalt Link.
                            	  2480:     ;
02:0002C9B4 522C00AD        	  2481:     addq.b  #1,($00AD,A4)
02:0002C9B8 7000            	  2482:     moveq   #0,D0
02:0002C9BA 194000AC        	  2483:     move.b  D0,($00AC,A4)
                            	  2484:     even
                            	  2485: _L_z04_PondFairy_HandleOtherStates_DrawLinkAndHearts:
                            	  2486:     ; TODO: but why, since Link is halted?
                            	  2487:     ;
                            	  2488:     ; Reset the input direction, so that Link doesn't animate
                            	  2489:     ; when drawing him.
02:0002C9BE 7600            	  2490:     moveq   #0,D3
02:0002C9C0 194303F8        	  2491:     move.b  D3,($03F8,A4)
                            	  2492:     ; Save and reset Link's state.
                            	  2493:     ;
                            	  2494:     ; TODO: but why, since Link is halted?
                            	  2495:     ;
02:0002C9C4 102C00AC        	  2496:     move.b  ($00AC,A4),D0
02:0002C9C8 1B00            	  2497:     move.b  D0,-(A5)  ; PHA
02:0002C9CA 194300AC        	  2498:     move.b  D3,($00AC,A4)
02:0002C9CE 4EB90003B88C    	  2499:     jsr     Link_EndMoveAndAnimate_Bank4
                            	  2500:     ; Restore Link's state.
                            	  2501:     ;
02:0002C9D4 101D            	  2502:     move.b  (A5)+,D0  ; PLA
02:0002C9D6 194000AC        	  2503:     move.b  D0,($00AC,A4)
02:0002C9DA 6110            	  2504:     jsr     PondFairy_MoveHearts
                            	  2505:     ; Restore the object slot.
                            	  2506:     ;
02:0002C9DC 7400            	  2507:     moveq   #0,D2
02:0002C9DE 142C0340        	  2508:     move.b  ($0340,A4),D2
                            	  2509:     even
