                            	  7980: UpdateGanon:
02:0002F2AA 102C0445        	  7981:     move.b  ($0445,A4),D0
02:0002F2AE 4EB90001E73A    	  7982:     jsr     _m68k_tablejump  ; M68K-native table dispatch (replaces JSR TableJump)
                            	  7983:     even
                            	  7984: UpdateGanon_JumpTable:
02:0002F2B4 0002F2C0        	  7985:     dc.l    Ganon_ScenePhase0   ; jump table entry (32-bit for _m68k_tablejump)
02:0002F2B8 0002F322        	  7986:     dc.l    Ganon_ScenePhase1   ; jump table entry (32-bit for _m68k_tablejump)
02:0002F2BC 0002F350        	  7987:     dc.l    Ganon_ScenePhase2   ; jump table entry (32-bit for _m68k_tablejump)
                            	  7988: 
                            	  7989: ; Description:
                            	  7990: ; Lift up the Triforce of Courage while the room is dark.
                            	  7991: ;
                            	  7992: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  7993: ;
                            	  7994:     even
                            	  7995: Ganon_ScenePhase0:
02:0002F2C0 701B            	  7996:     moveq   #27,D0
02:0002F2C2 19400505        	  7997:     move.b  D0,($0505,A4)
                            	  7998:     ; If Link's timer has not expired, then go do nothing until the last frame.
                            	  7999:     ;
02:0002F2C6 102C0028        	  8000:     move.b  ($0028,A4),D0
02:0002F2CA 6644            	  8001:     bne  _L_z04_Ganon_ScenePhase0_CheckTimeToShout
                            	  8002:     ; Once the timer expires, it's time to brighten the room.
                            	  8003:     ;
                            	  8004:     ; Save the current object slot.
02:0002F2CC 1002            	  8005:     move.b  D2,D0
02:0002F2CE 1B00            	  8006:     move.b  D0,-(A5)  ; PHA
02:0002F2D0 610007F0        	  8007:     jsr     UpdateCandle
02:0002F2D4 101D            	  8008:     move.b  (A5)+,D0  ; PLA
02:0002F2D6 7400            	  8009:     moveq   #0,D2
02:0002F2D8 1400            	  8010:     move.b  D0,D2
                            	  8011:     ; Turn off the room brightening flag, because we're controlling it
                            	  8012:     ; here instead of in the Mode 5 object update loop.
                            	  8013:     ;
02:0002F2DA 7000            	  8014:     moveq   #0,D0
02:0002F2DC 1940051E        	  8015:     move.b  D0,($051E,A4)
                            	  8016:     ; On the first frame of the fade-to-light cycle, play the
                            	  8017:     ; Triforce/Ganon song.
                            	  8018:     ;
02:0002F2E0 102C051C        	  8019:     move.b  ($051C,A4),D0
02:0002F2E4 0C0000C0        	  8020:     cmpi.b  #$C0,D0
02:0002F2E8 6606            	  8021:     bne  _L_z04_Ganon_ScenePhase0_CheckFadeCycle
02:0002F2EA 7002            	  8022:     moveq   #2,D0
02:0002F2EC 19400600        	  8023:     move.b  D0,($0600,A4)
                            	  8024:     even
                            	  8025: _L_z04_Ganon_ScenePhase0_CheckFadeCycle:
                            	  8026:     ; If the fade cycle has not ended, then go draw Ganon.
                            	  8027:     ;
02:0002F2F0 102C051C        	  8028:     move.b  ($051C,A4),D0
02:0002F2F4 0200000F        	  8029:     andi.b #$0F,D0
02:0002F2F8 0C000004        	  8030:     cmpi.b  #$04,D0
02:0002F2FC 6702            	  8031:     beq.s  __far_z_04_0087
02:0002F2FE 6042            	  8032:     jmp  Ganon_DrawBodyFrame0
                            	  8033: __far_z_04_0087:
                            	  8034:     ; Set Link's timer to $C0 for the next scene phase.
                            	  8035:     ;
02:0002F300 103C00C0        	  8036:     move.b  #$C0,D0
02:0002F304 19400028        	  8037:     move.b  D0,($0028,A4)
                            	  8038:     ; Set scene phase 1, and go draw Ganon.
                            	  8039:     ;
02:0002F308 522C0445        	  8040:     addq.b  #1,($0445,A4)
02:0002F30C 6702            	  8041:     beq.s  __far_z_04_0088
02:0002F30E 6032            	  8042:     jmp  Ganon_DrawBodyFrame0
                            	  8043: __far_z_04_0088:
                            	  8044:     even
                            	  8045: _L_z04_Ganon_ScenePhase0_CheckTimeToShout:
                            	  8046:     ; If timer = 1, then play Boss hit/hurt sound effect.
                            	  8047:     ; In this case, I think it means Ganon is shouting.
                            	  8048:     ;
02:0002F310 0C000001        	  8049:     cmpi.b  #$01,D0
02:0002F314 6606            	  8050:     bne  _anon_z04_160
02:0002F316 7002            	  8051:     moveq   #2,D0
02:0002F318 19400601        	  8052:     move.b  D0,($0601,A4)
                            	  8053: _anon_z04_160:
02:0002F31C 0A3C0001        	  8054:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0002F320 4E75            	  8055:     rts
                            	  8056: 
                            	  8057: ; Description:
                            	  8058: ; Lift up the Triforce of Courage while the room is light.
                            	  8059: ;
                            	  8060: ; Lift the Triforce of Courage -- represented with a triforce piece.
                            	  8061: ;
                            	  8062:     even
                            	  8063: Ganon_ScenePhase1:
02:0002F322 701B            	  8064:     moveq   #27,D0
02:0002F324 19400505        	  8065:     move.b  D0,($0505,A4)
                            	  8066:     ; If Link's timer hasn't expired, then go draw Ganon.
                            	  8067:     ;
02:0002F328 102C0028        	  8068:     move.b  ($0028,A4),D0
02:0002F32C 6702            	  8069:     beq.s  __far_z_04_0089
02:0002F32E 6012            	  8070:     jmp  Ganon_DrawBodyFrame0
                            	  8071: __far_z_04_0089:
                            	  8072:     ; Once the timer expires:
                            	  8073:     ; 1. unhalt Link
                            	  8074:     ; 2. clear the item to lift
                            	  8075:     ; 3. play level 9 song
                            	  8076:     ; 4. go to scene phase 2: fighting / not holding triforce
                            	  8077:     ;
02:0002F330 194000AC        	  8078:     move.b  D0,($00AC,A4)
02:0002F334 19400505        	  8079:     move.b  D0,($0505,A4)
02:0002F338 7020            	  8080:     moveq   #32,D0
02:0002F33A 19400600        	  8081:     move.b  D0,($0600,A4)
02:0002F33E 522C0445        	  8082:     addq.b  #1,($0445,A4)
                            	  8083:     even
                            	  8084: Ganon_DrawBodyFrame0:
                            	  8085:     ; When holding the Triforce of Courage, only draw Ganon
                            	  8086:     ; with animation frame 0.
                            	  8087:     ;
02:0002F342 7000            	  8088:     moveq   #0,D0
02:0002F344 41EC046B        	  8089:     lea     ($046B,A4),A0
02:0002F348 11802000        	  8090:     move.b  D0,(A0,D2.W)
02:0002F34C 600002EC        	  8091:     jmp     Ganon_DrawBody
                            	  8092: 
                            	  8093: ; Description:
                            	  8094: ; Fighting Ganon.
                            	  8095: ;
                            	  8096: ; If Ganon is dying, go handle it.
                            	  8097: ;
                            	  8098:     even
                            	  8099: Ganon_ScenePhase2:
02:0002F350 41EC042C        	  8100:     lea     ($042C,A4),A0
02:0002F354 10302000        	  8101:     move.b  (A0,D2.W),D0
02:0002F358 6704            	  8102:     beq.s  __far_z_04_0090
02:0002F35A 600000A4        	  8103:     jmp  Ganon_Dying
                            	  8104: __far_z_04_0090:
02:0002F35E 61000356        	  8105:     jsr     Ganon_CheckCollisions
02:0002F362 6100C6CA        	  8106:     jsr     PlayBossHitCryIfNeeded
                            	  8107:     ; Go handle the brown state specially.
                            	  8108:     ;
02:0002F366 41EC00AC        	  8109:     lea     ($00AC,A4),A0
02:0002F36A 10302000        	  8110:     move.b  (A0,D2.W),D0
02:0002F36E 6702            	  8111:     beq.s  __far_z_04_0091
02:0002F370 6058            	  8112:     jmp  Ganon_UpdateBrownState
                            	  8113: __far_z_04_0091:
                            	  8114:     ; State = 0: Blue
                            	  8115:     ;
                            	  8116:     ; If timer = 0, then go move around and shoot.
                            	  8117:     ;
02:0002F372 10342028        	  8118:     move.b  ($28,A4,D2.W),D0
02:0002F376 6602            	  8119:     bne.s  __far_z_04_0092
02:0002F378 600E            	  8120:     jmp  Ganon_MoveAndShoot
                            	  8121: __far_z_04_0092:
                            	  8122:     ; If timer > 1, then Ganon is blue and visible. Only draw.
                            	  8123:     ; Collisions were checked already.
                            	  8124:     ;
                            	  8125:     ; Else timer = 1. Fall thru and randomize Ganon's location,
                            	  8126:     ; in anticipation of moving around when timer becomes 0 next frame.
                            	  8127:     ;
02:0002F37A 0C000001        	  8128:     cmpi.b  #$01,D0
02:0002F37E 6702            	  8129:     beq.s  __far_z_04_0093
02:0002F380 6078            	  8130:     jmp  L_Ganon_DrawBody
                            	  8131: __far_z_04_0093:
                            	  8132: ; Description:
                            	  8133: ; Put Ganon at Y=$A0, and a random X of $30 or $B0.
                            	  8134: ;
                            	  8135:     even
                            	  8136: Ganon_RandomizeLocation:
02:0002F382 4EF90001F2A0    	  8137:     jmp     c_ganon_randomize_location
                            	  8138: 
                            	  8139: Ganon_MoveAndShoot:
                            	  8140:     ; Change the animation frame every screen frame; so that
                            	  8141:     ; when Ganon is hit, he appears in a random pose.
                            	  8142:     ;
02:0002F388 41EC046B        	  8143:     lea     ($046B,A4),A0
02:0002F38C 52302000        	  8144:     addq.b  #1,(A0,D2.W)
                            	  8145:     ; The animation cycle has 6 frames.
                            	  8146:     ;
02:0002F390 41EC046B        	  8147:     lea     ($046B,A4),A0
02:0002F394 10302000        	  8148:     move.b  (A0,D2.W),D0
02:0002F398 0C000006        	  8149:     cmpi.b  #$06,D0
02:0002F39C 660A            	  8150:     bne  _L_z04_Ganon_MoveAndShoot_Move
02:0002F39E 7000            	  8151:     moveq   #0,D0
02:0002F3A0 41EC046B        	  8152:     lea     ($046B,A4),A0
02:0002F3A4 11802000        	  8153:     move.b  D0,(A0,D2.W)
                            	  8154:     even
