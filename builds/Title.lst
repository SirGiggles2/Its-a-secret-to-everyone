                            	   414: _L_z05_UpdateMenuStartOW_LoopPiece:
                            	   415:     ; Inner loop.
                            	   416:     ; Each level bit will make 3 triforce tile slots be
                            	   417:     ; checked and replaced.
                            	   418:     ;
02:000301A4 7003            	   419:     moveq   #3,D0
02:000301A6 19400007        	   420:     move.b  D0,($0007,A4)
                            	   421:     even
                            	   422: _L_z05_UpdateMenuStartOW_LoopTile:
                            	   423:     ; Get the offset into the submenu triforce transfer buffers of
                            	   424:     ; the current tile slot.
                            	   425:     ;
02:000301AA 7400            	   426:     moveq   #0,D2
02:000301AC 41F90003012E    	   427:     lea     (TriforceTransferBufOffsets).l,A0
02:000301B2 14303000        	   428:     move.b  (A0,D3.W),D2
                            	   429:     ; If the level test bit is not in the triforce mask, then we don't
                            	   430:     ; have this piece. So, go loop again, and leave the tile in the
                            	   431:     ; empty state.
                            	   432:     ;
                            	   433:     ;
                            	   434:     ; [06] level test mask
02:000301B6 102C0006        	   435:     move.b  ($0006,A4),D0
02:000301BA 122C0671        	   436:     move.b  ($0671,A4),D1
02:000301BE C200            	   437:     and.b   D0,D1   ; BIT: set Z/N/V from D1 AND A
02:000301C0 6730            	   438:     beq  _L_z05_UpdateMenuStartOW_NextLoopTile
                            	   439:     ; We have the triforce piece.
                            	   440:     ;
                            	   441:     ; If the base/empty tile already in the transfer buf = $E5 or $E6,
                            	   442:     ; then make it $F5. These are tiles that were half full, and now
                            	   443:     ; need to be full.
                            	   444:     ;
                            	   445:     ; Else replace it with the one at the current triforce tile slot
                            	   446:     ; in the replacement list.
                            	   447:     ;
02:000301C2 41F900037154    	   448:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000301C8 10302000        	   449:     move.b  (A0,D2.W),D0
02:000301CC 0C0000E5        	   450:     cmpi.b  #$E5,D0
02:000301D0 6712            	   451:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000301D2 0C0000E6        	   452:     cmpi.b  #$E6,D0
02:000301D6 670C            	   453:     beq  _L_z05_UpdateMenuStartOW_ReplaceWithF5
02:000301D8 41F900030146    	   454:     lea     (TriforceTriforceBufReplacements).l,A0
02:000301DE 10303000        	   455:     move.b  (A0,D3.W),D0
02:000301E2 6004            	   456:     jmp     _anon_z05_7
                            	   457: 
                            	   458:     even
                            	   459: _L_z05_UpdateMenuStartOW_ReplaceWithF5:
02:000301E4 103C00F5        	   460:     move.b  #$F5,D0
                            	   461: _anon_z05_7:
02:000301E8 41F900037154    	   462:     lea     (TriforceRow0TransferBuf+4).l,A0
02:000301EE 11802000        	   463:     move.b  D0,(A0,D2.W)
                            	   464:     even
                            	   465: _L_z05_UpdateMenuStartOW_NextLoopTile:
                            	   466:     ; Bottom of the inner loop.
                            	   467:     ;
                            	   468:     ; Increment the triforce tile slot.
                            	   469:     ; Decrement [07] and loop again, if it's not 0.
                            	   470:     ;
