02:0002D618 52302000        	  4220:     addq.b  #1,(A0,D2.W)
02:0002D61C 41EC0478        	  4221:     lea     ($0478,A4),A0
02:0002D620 10302000        	  4222:     move.b  (A0,D2.W),D0
02:0002D624 0C000004        	  4223:     cmpi.b  #$04,D0
02:0002D628 659E            	  4224:     bcs  _L_z04_CheckBigDigdoggerCollisions_LoopCornerCollision
                            	  4225:     ; Restore the original coordinates.
                            	  4226:     ;
