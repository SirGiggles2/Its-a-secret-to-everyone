                            	  2403: ;==============================================================================
                            	  2404: ; APU writes ($4000–$4017)
                            	  2405: ;
                            	  2406: ; Most NES APU register writes are no-ops — the native M68K music player in
                            	  2407: ; audio_driver.asm drives YM2612/PSG directly from song scripts and ignores
                            	  2408: ; channel state, so every stub here is a plain rts.
                            	  2409: ;==============================================================================
                            	  2410: 
                            	  2411: _apu_write_4000:
                            	  2412: _apu_write_4001:
                            	  2413: _apu_write_4002:
                            	  2414: _apu_write_4003:
                            	  2415: _apu_write_4004:
                            	  2416: _apu_write_4005:
                            	  2417: _apu_write_4006:
                            	  2418: _apu_write_4007:
                            	  2419: _apu_write_4008:
                            	  2420: _apu_write_400a:
                            	  2421: _apu_write_400b:
                            	  2422: _apu_write_4011:
                            	  2423: _apu_write_4016:
                            	  2424: _apu_write_4017:
02:0001E64A 4E75            	  2425:     rts
                            	  2426: 
                            	  2427: ; Noise-channel APU writes. Zelda's SFX engine (PlaySfxNote) writes
                            	  2428: ; $400E (period), $400C (volume + const-vol bit), $400F (length trigger)
                            	  2429: ; per sfx-tick. We cache E+C and emit PSG on the F trigger. Arbitration
                            	  2430: ; is via $FF0606 (Effect) -- the music driver skips PSG noise writes
                            	  2431: ; when $0606 != 0, so SFX owns the channel for the duration of the hit.
                            	  2432: _apu_write_400c:
02:0001E64C 13C000FFE029    	  2433:     move.b  D0,(m_sfx_vol).l
02:0001E652 4E75            	  2434:     rts
                            	  2435: 
                            	  2436: _apu_write_400e:
02:0001E654 13C000FFE02A    	  2437:     move.b  D0,(m_sfx_ctrl_raw).l
02:0001E65A 4E75            	  2438:     rts
                            	  2439: 
                            	  2440: _apu_write_400f:
02:0001E65C 4A3900FF0606    	  2441:     tst.b   ($00FF0606).l                  ; SFX active on game side?
02:0001E662 6758            	  2442:     beq.s   .f_skip
02:0001E664 48E7C000        	  2443:     movem.l D0-D1,-(SP)
                            	  2444:     ; PSG noise control byte from cached $400E (low 4 bits = period idx).
                            	  2445:     ; Map NES 16-period index to 4-bucket PSG noise control ($E4..$E7).
02:0001E668 103900FFE02A    	  2446:     move.b  (m_sfx_ctrl_raw).l,D0
02:0001E66E 0200000F        	  2447:     andi.b  #$0F,D0
02:0001E672 0C000004        	  2448:     cmpi.b  #$04,D0
02:0001E676 6512            	  2449:     bcs.s   .pg_short
02:0001E678 0C000008        	  2450:     cmpi.b  #$08,D0
02:0001E67C 6512            	  2451:     bcs.s   .pg_mid
02:0001E67E 0C00000C        	  2452:     cmpi.b  #$0C,D0
02:0001E682 6512            	  2453:     bcs.s   .pg_long
02:0001E684 103C00E7        	  2454:     move.b  #$E7,D0
02:0001E688 6010            	  2455:     bra.s   .pg_ready
                            	  2456: .pg_short:
02:0001E68A 103C00E4        	  2457:     move.b  #$E4,D0
02:0001E68E 600A            	  2458:     bra.s   .pg_ready
                            	  2459: .pg_mid:
02:0001E690 103C00E5        	  2460:     move.b  #$E5,D0
02:0001E694 6004            	  2461:     bra.s   .pg_ready
                            	  2462: .pg_long:
02:0001E696 103C00E6        	  2463:     move.b  #$E6,D0
                            	  2464: .pg_ready:
02:0001E69A 13C000C00011    	  2465:     move.b  D0,(PSG_PORT).l                ; noise control ($Ex)
                            	  2466:     ; PSG attenuation from cached $400C (low 4 bits = volume nibble).
02:0001E6A0 103900FFE029    	  2467:     move.b  (m_sfx_vol).l,D0
02:0001E6A6 0200000F        	  2468:     andi.b  #$0F,D0
02:0001E6AA 0A00000F        	  2469:     eori.b  #$0F,D0                        ; NES 15=loud -> PSG 0=loud
02:0001E6AE 000000F0        	  2470:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:0001E6B2 13C000C00011    	  2471:     move.b  D0,(PSG_PORT).l
02:0001E6B8 4CDF0003        	  2472:     movem.l (SP)+,D0-D1
                            	  2473: .f_skip:
02:0001E6BC 4E75            	  2474:     rts
                            	  2475: 
                            	  2476: ;==============================================================================
                            	  2477: ; DMC APU register stubs (Phase D)
                            	  2478: ;
                            	  2479: ; Zelda's SelectDMC routine (transpiled at z_00.asm:_L_z00_DriveSample_*)
                            	  2480: ; writes the APU DMC registers in a fixed order whenever it wants to play
                            	  2481: ; a sample effect:
                            	  2482: ;
                            	  2483: ;     $4010  <- SampleRates[idx-1]   ; rate nibble (low 4 bits)
                            	  2484: ;     $4012  <- SampleAddrs[idx-1]   ; start addr high byte ($C000 + b*64)
                            	  2485: ;     $4013  <- SampleLengths[idx-1] ; length byte (length = b*16 + 1)
                            	  2486: ;     $4015  <- $0F                  ; enable all non-DMC channels
                            	  2487: ;     $4015  <- $1F                  ; OR in bit 4 -> DMC playback
                            	  2488: ;
                            	  2489: ; We shadow $4010 and $4012 on write so that when $4015 arrives with bit 4
                            	  2490: ; set we can recover the intended sample index via DMC_SAMPLE_LOOKUP.
                            	  2491: ;==============================================================================
                            	  2492: _apu_write_4010:
02:0001E6BE 13C000FFE10C    	  2493:     move.b  D0,(dmc_rate_sel).l
02:0001E6C4 4E75            	  2494:     rts
                            	  2495: 
                            	  2496: _apu_write_4012:
02:0001E6C6 13C000FFE10D    	  2497:     move.b  D0,(dmc_addr_sel).l
02:0001E6CC 4E75            	  2498:     rts
                            	  2499: 
                            	  2500: _apu_write_4013:
02:0001E6CE 13C000FFE10E    	  2501:     move.b  D0,(dmc_len_sel).l
02:0001E6D4 4E75            	  2502:     rts
                            	  2503: 
                            	  2504: _apu_write_4015:
02:0001E6D6 08000004        	  2505:     btst    #4,D0                       ; DMC enable bit?
02:0001E6DA 673E            	  2506:     beq.s   .no_dmc                     ; clearing → stop playback
                            	  2507:     ; Look up (addr, rate) in DMC_SAMPLE_LOOKUP.  Walk 7 {addr,rate,idx,0}
                            	  2508:     ; quads; on match, load the 1-based index into D1 and call dmc_trigger.
02:0001E6DC 48E77080        	  2509:     movem.l D1-D3/A0,-(SP)
02:0001E6E0 143900FFE10D    	  2510:     move.b  (dmc_addr_sel).l,D2
02:0001E6E6 163900FFE10C    	  2511:     move.b  (dmc_rate_sel).l,D3
02:0001E6EC 41F90001E71C    	  2512:     lea     (DMC_SAMPLE_LOOKUP).l,A0
02:0001E6F2 7206            	  2513:     moveq   #DMC_SAMPLE_COUNT-1,D1
                            	  2514: .scan:
02:0001E6F4 B410            	  2515:     cmp.b   (A0),D2
02:0001E6F6 6616            	  2516:     bne.s   .next
02:0001E6F8 B6280001        	  2517:     cmp.b   1(A0),D3
02:0001E6FC 6610            	  2518:     bne.s   .next
                            	  2519:     ; Match: 3rd byte of the quad is the 1-based index
02:0001E6FE 7200            	  2520:     moveq   #0,D1
02:0001E700 12280002        	  2521:     move.b  2(A0),D1
02:0001E704 1001            	  2522:     move.b  D1,D0                       ; dmc_trigger wants index in D0.b
02:0001E706 4EB900000618    	  2523:     bsr     dmc_trigger
02:0001E70C 6006            	  2524:     bra.s   .done
                            	  2525: .next:
02:0001E70E 5888            	  2526:     addq.l  #4,A0
02:0001E710 51C9FFE2        	  2527:     dbra    D1,.scan
                            	  2528:     ; No match — silently ignore (unknown rate/addr combo, not fatal)
                            	  2529: .done:
02:0001E714 4CDF010E        	  2530:     movem.l (SP)+,D1-D3/A0
02:0001E718 4E75            	  2531:     rts
                            	  2532: .no_dmc:
                            	  2533:     ; Bit 4 clear: NES wanted to stop DMC playback. With XGM the Z80
                            	  2534:     ; mixer auto-finishes samples; we don't proactively kill them mid-
                            	  2535:     ; stream. NES Zelda doesn't issue mid-SFX stop in normal play, so a
                            	  2536:     ; no-op is safe.
02:0001E71A 4E75            	  2537:     rts
                            	  2538: 
                            	  2539: ; $4015 (addr, rate) -> 1-based DMC sample index lookup. Mirror of
                            	  2540: ; SampleAddrs / SampleRates in src/zelda_translated/z_00.asm. Inlined
                            	  2541: ; here because the data is tiny (28 bytes), tightly coupled to the APU
                            	  2542: ; stub above, and used to be code-generated into dmc_samples.inc which
                            	  2543: ; was deleted in the XGM migration.
                            	  2544: DMC_SAMPLE_COUNT    equ     7
                            	  2545: 
                            	  2546:     even
                            	  2547: DMC_SAMPLE_LOOKUP:
02:0001E71C 00              	  2548:     dc.b    $00,$0F, 1,0   ; 1 SFX_01
02:0001E71D 0F
02:0001E71E 01
02:0001E71F 00
02:0001E720 4C              	  2549:     dc.b    $4C,$0F, 2,0   ; 2 SFX_02
02:0001E721 0F
02:0001E722 02
02:0001E723 00
02:0001E724 80              	  2550:     dc.b    $80,$0D, 3,0   ; 3 SFX_03
02:0001E725 0D
02:0001E726 03
02:0001E727 00
02:0001E728 1D              	  2551:     dc.b    $1D,$0F, 4,0   ; 4 SFX_04
02:0001E729 0F
02:0001E72A 04
02:0001E72B 00
02:0001E72C 20              	  2552:     dc.b    $20,$0E, 5,0   ; 5 SFX_05
02:0001E72D 0E
02:0001E72E 05
02:0001E72F 00
02:0001E730 28              	  2553:     dc.b    $28,$0F, 6,0   ; 6 SFX_06
02:0001E731 0F
02:0001E732 06
02:0001E733 00
02:0001E734 4C              	  2554:     dc.b    $4C,$0E, 7,0   ; 7 SFX_07
02:0001E735 0E
02:0001E736 07
02:0001E737 00
                            	  2555: DMC_SAMPLE_LOOKUP_END:
                            	  2556: 
                            	  2557: ;==============================================================================
                            	  2558: ; _indirect_stub — JMP (abs) indirect placeholder.
                            	  2559: ; Called when the transpiler can't resolve an indirect jump target at
                            	  2560: ; translate-time.  Halts via an infinite bra so BizHawk shows PC stuck here.
                            	  2561: ; In T9+ these will be replaced by computed dispatch tables.
                            	  2562: ;==============================================================================
                            	  2563: _indirect_stub:
02:0001E738 60FE            	  2564:     bra.s   _indirect_stub          ; spin — caught as deliberate halt in T9+
                            	  2565: 
                            	  2566: ;==============================================================================
                            	  2567: ; _m68k_tablejump — M68K-native replacement for the NES JSR-trick TableJump.
                            	  2568: ;
                            	  2569: ; On NES, "JSR TableJump" is a JSR-trick: the bytes after the JSR are a
                            	  2570: ; table of 16-bit vectors.  TableJump pops the return address from the 6502
                            	  2571: ; stack to find the table base, then jumps through it using the value in A.
                            	  2572: ;
                            	  2573: ; In M68K, BSR pushes the return address (= table base) onto A7 (M68K stack),
                            	  2574: ; not A5 (our NES stack).  The original TableJump pulled from A5 (zeros),
                            	  2575: ; constructing a bogus NES address and jumping into garbage.
                            	  2576: ;
                            	  2577: ; This replacement correctly pops the M68K return address as the dc.l table
                            	  2578: ; base, indexes by D0.b × 4, and dispatches.
                            	  2579: ;
                            	  2580: ; Calling convention:
                            	  2581: ;   D0.b = mode index
                            	  2582: ;   (A7)  = base address of the dc.l jump table (pushed by BSR)
                            	  2583: ;   Jumps directly to the selected target (does not RTS).
                            	  2584: ;==============================================================================
                            	  2585: _m68k_tablejump:
02:0001E73A 205F            	  2586:     movea.l (SP)+,A0        ; pop M68K return address = dc.l table base
02:0001E73C C07C00FF        	  2587:     and.w   #$00FF,D0       ; zero-extend mode byte → word
02:0001E740 E548            	  2588:     lsl.w   #2,D0           ; D0.w = index × 4  (each dc.l = 4 bytes)
02:0001E742 20700000        	  2589:     movea.l (A0,D0.W),A0   ; load 32-bit target address from table
02:0001E746 4ED0            	  2590:     jmp     (A0)            ; dispatch (no return)
                            	  2591: 
                            	  2592: ;==============================================================================
                            	  2593: ; _clear_nametable_fast — Fast replacement for ClearNameTable.
                            	  2594: ;
                            	  2595: ; Fills Plane A with a tile word directly via VDP_DATA (bypassing _ppu_write_7)
                            	  2596: ; and clears NT_CACHE.  V64 plane: NT0 ($20) → rows 0-29, NT1 ($28) → rows 30-59.
                            	  2597: ;
                            	  2598: ; Input:
                            	  2599: ;   D0.b = hi byte of NES PPU address ($20 = nametable 0, $28 = nametable 1)
                            	  2600: ;   D2.b = tile index to fill with
                            	  2601: ;   D3.b = attribute byte (always 0 for Zelda clear; palette 0 used)
                            	  2602: ;
                            	  2603: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2604: ; Updates PPU_VADDR to the post-clear address (matching original behavior).
                            	  2605: ;==============================================================================
                            	  2606:     even
                            	  2607: _clear_nametable_fast:
02:0001E748 48E7F880        	  2608:     movem.l D0-D4/A0,-(SP)
                            	  2609: 
                            	  2610:     ; Save NT selection before D0 is clobbered
02:0001E74C 1800            	  2611:     move.b  D0,D4                   ; D4.b = NT hi byte ($20 or $28)
                            	  2612: 
                            	  2613:     ; Compute the end PPU_VADDR: start + 1024 tiles + 64 attributes = +$0440
02:0001E74E 024000FF        	  2614:     andi.w  #$00FF,D0
02:0001E752 E148            	  2615:     lsl.w   #8,D0                   ; D0.w = PPU base ($2000 or $2800)
02:0001E754 06400440        	  2616:     addi.w  #$0440,D0
02:0001E758 33C000FF0802    	  2617:     move.w  D0,(PPU_VADDR).l        ; set PPU_VADDR to expected end value
                            	  2618: 
                            	  2619:     ; Build tile word from the current BG pattern-table selection
02:0001E75E 7000            	  2620:     moveq   #0,D0
02:0001E760 1002            	  2621:     move.b  D2,D0                   ; D0.w = raw tile index
02:0001E762 4EB90000213E    	  2622:     bsr     _compose_bg_tile_word
02:0001E768 3200            	  2623:     move.w  D0,D1                   ; D1.w = tile word to write
                            	  2624: 
                            	  2625:     ; Determine VRAM start address based on NT selection
02:0001E76A 0C040028        	  2626:     cmpi.b  #$28,D4
02:0001E76E 672A            	  2627:     beq.s   .cnf_nt1
                            	  2628: 
                            	  2629:     ; ---- NT0: Fill Plane A rows 0-29 starting at $C000 ----
                            	  2630:     ; Phase 2c: also fill Window nametable rows 0-7 (256 tiles = 512 bytes).
                            	  2631:     ; Without this, NT0-clear requests leave stale HUD tiles in Window
                            	  2632:     ; after a mode transition that clears NT0.
02:0001E770 23FC7000000200C0	  2633:     move.l  #$70000002,(VDP_CTRL).l ; VRAM write at $B000 (Window)
02:0001E778 0004
02:0001E77A 363C00FF        	  2634:     move.w  #255,D3                 ; 32 cols * 8 rows - 1
                            	  2635: .cnf_window_fill:
02:0001E77E 33C100C00000    	  2636:     move.w  D1,(VDP_DATA).l
02:0001E784 51CBFFF8        	  2637:     dbf     D3,.cnf_window_fill
                            	  2638: 
02:0001E788 23FC4000000300C0	  2639:     move.l  #$40000003,(VDP_CTRL).l ; VRAM write at $C000
02:0001E790 0004
                            	  2640:     ; Clear NT_CACHE offsets 0-959 (NT0)
02:0001E792 41F900FF0840    	  2641:     lea     (NT_CACHE_BASE).l,A0
02:0001E798 6010            	  2642:     bra.s   .cnf_fill
                            	  2643: 
                            	  2644: .cnf_nt1:
                            	  2645:     ; ---- NT1: Fill Plane A rows 30-63 starting at $CF00 ----
                            	  2646:     ; 34 rows = 30 NT1 rows + 4 gap rows (prevents garbage when scroll wraps).
                            	  2647:     ; $CF00 = $C000 + 30*$80.  VDP command: ($CF00 & $3FFF)<<16 | $40000003
                            	  2648:     ; NT1 doesn't touch HUD range — skip Window fill.
02:0001E79A 23FC4F00000300C0	  2649:     move.l  #$4F000003,(VDP_CTRL).l ; VRAM write at $CF00
02:0001E7A2 0004
                            	  2650:     ; Clear NT_CACHE offsets 960-1919 (NT1)
02:0001E7A4 41F900FF0C00    	  2651:     lea     (NT_CACHE_BASE+960).l,A0
                            	  2652: 
                            	  2653: .cnf_fill:
                            	  2654:     ; Write tiles to Plane A rows.  Plane A is 64 tiles wide,
                            	  2655:     ; so after each 32-tile NES row we must skip 32 unused tiles.
                            	  2656:     ; NT0: 30 rows (0-29).  NT1: 34 rows (30-63, includes 4 gap rows).
02:0001E7AA 0C040028        	  2657:     cmpi.b  #$28,D4
02:0001E7AE 6604            	  2658:     bne.s   .cnf_nt0_count
02:0001E7B0 7621            	  2659:     moveq   #34-1,D3                ; NT1: 34 rows (fills gap rows 60-63)
02:0001E7B2 6002            	  2660:     bra.s   .cnf_row
                            	  2661: .cnf_nt0_count:
02:0001E7B4 761D            	  2662:     moveq   #30-1,D3                ; NT0: 30 rows
                            	  2663: .cnf_row:
02:0001E7B6 781F            	  2664:     moveq   #32-1,D4                ; 32 cols per row
                            	  2665: .cnf_col:
02:0001E7B8 33C100C00000    	  2666:     move.w  D1,(VDP_DATA).l
02:0001E7BE 51CCFFF8        	  2667:     dbf     D4,.cnf_col
                            	  2668: 
                            	  2669:     ; Skip 32 unused tile slots (64 bytes) in Plane A row.
02:0001E7C2 781F            	  2670:     moveq   #32-1,D4
                            	  2671: .cnf_skip:
02:0001E7C4 33C100C00000    	  2672:     move.w  D1,(VDP_DATA).l         ; write same tile to unused slots (harmless)
02:0001E7CA 51CCFFF8        	  2673:     dbf     D4,.cnf_skip
                            	  2674: 
02:0001E7CE 51CBFFE6        	  2675:     dbf     D3,.cnf_row
                            	  2676: 
                            	  2677:     ; ---- Clear NT_CACHE (960 bytes for the selected NT) ----
02:0001E7D2 363C03BF        	  2678:     move.w  #960-1,D3
02:0001E7D6 1001            	  2679:     move.b  D1,D0                   ; fill byte = tile index
                            	  2680: .cnf_cache:
02:0001E7D8 10C0            	  2681:     move.b  D0,(A0)+
02:0001E7DA 51CBFFFC        	  2682:     dbf     D3,.cnf_cache
                            	  2683: 
                            	  2684:     ; Clear matching transfer-interpreter palette shadow for this NT.
02:0001E7DE 0C040028        	  2685:     cmpi.b  #$28,D4
02:0001E7E2 6708            	  2686:     beq.s   .cnf_attr_nt1
02:0001E7E4 41F900FF1400    	  2687:     lea     (NT_ATTR_CACHE_BASE).l,A0
02:0001E7EA 6006            	  2688:     bra.s   .cnf_attr_fill
                            	  2689: .cnf_attr_nt1:
02:0001E7EC 41F900FF17C0    	  2690:     lea     (NT_ATTR_CACHE_BASE+960).l,A0
                            	  2691: .cnf_attr_fill:
02:0001E7F2 363C03BF        	  2692:     move.w  #960-1,D3
02:0001E7F6 4200            	  2693:     clr.b   D0
                            	  2694: .cnf_attr_loop:
02:0001E7F8 10C0            	  2695:     move.b  D0,(A0)+
02:0001E7FA 51CBFFFC        	  2696:     dbf     D3,.cnf_attr_loop
                            	  2697: 
                            	  2698: .cnf_done:
02:0001E7FE 4CDF011F        	  2699:     movem.l (SP)+,D0-D4/A0
02:0001E802 4E75            	  2700:     rts
                            	  2701: 
                            	  2702: ;==============================================================================
                            	  2703: ; _transfer_chr_block_fast — Bulk 2BPP→4BPP tile transfer to VDP VRAM.
                            	  2704: ;
                            	  2705: ; Bypasses _ppu_write_7 entirely.  Reads NES 2BPP tile data from a ROM source
                            	  2706: ; address, converts each 16-byte tile to 32-byte Genesis 4BPP, and writes
                            	  2707: ; directly to VDP VRAM.  Processes full tiles (16 bytes each).
                            	  2708: ;
                            	  2709: ; Input:
                            	  2710: ;   A0     = ROM source address (32-bit, points to NES 2BPP tile data)
                            	  2711: ;   D1.w   = NES PPU destination address (CHR range $0000–$1FFF)
                            	  2712: ;   D2.l   = byte count (must be multiple of 16)
                            	  2713: ;
                            	  2714: ; Output:
                            	  2715: ;   PPU_VADDR updated to D1 + D2 (post-transfer address)
                            	  2716: ;
                            	  2717: ; Preserves all NES registers (D0, D2, D3, D7, A4, A5).
                            	  2718: ;==============================================================================
                            	  2719:     even
                            	  2720: _transfer_chr_block_fast:
                            	  2721:     ifne CHR_EXPANSION_ENABLED
                            	  2722:     ; If destination is sprite half ($0000-$0FFF), stage each 16-byte tile
                            	  2723:     ; through CHR_TILE_BUF and call _chr_upload_sprite_4x (emits 4 biased
                            	  2724:     ; copies).  BG half ($1000-$1FFF) takes the legacy 1x fast path below.
02:0001E804 3A01            	  2725:     move.w  D1,D5
02:0001E806 02451000        	  2726:     andi.w  #$1000,D5
02:0001E80A 663A            	  2727:     bne.s   .tcbf_legacy_entry
02:0001E80C 48E7FFE0        	  2728:     movem.l D0-D7/A0-A2,-(SP)
                            	  2729: .tcbf_4x_loop:
02:0001E810 4A82            	  2730:     tst.l   D2
02:0001E812 6F26            	  2731:     ble.s   .tcbf_4x_done
02:0001E814 43F900FF0820    	  2732:     lea     (CHR_TILE_BUF).l,A1
02:0001E81A 22D8            	  2733:     move.l  (A0)+,(A1)+
02:0001E81C 22D8            	  2734:     move.l  (A0)+,(A1)+
02:0001E81E 22D8            	  2735:     move.l  (A0)+,(A1)+
02:0001E820 22D8            	  2736:     move.l  (A0)+,(A1)+
02:0001E822 33C100FF0832    	  2737:     move.w  D1,(CHR_BUF_VADDR).l
02:0001E828 4EB900001FFC    	  2738:     bsr     _chr_upload_sprite_4x
02:0001E82E 06410010        	  2739:     addi.w  #16,D1
02:0001E832 048200000010    	  2740:     subi.l  #16,D2
02:0001E838 60D6            	  2741:     bra.s   .tcbf_4x_loop
                            	  2742: .tcbf_4x_done:
02:0001E83A 33C100FF0802    	  2743:     move.w  D1,(PPU_VADDR).l
02:0001E840 4CDF07FF        	  2744:     movem.l (SP)+,D0-D7/A0-A2
02:0001E844 4E75            	  2745:     rts
                            	  2746: .tcbf_legacy_entry:
                            	  2747:     endc
02:0001E846 48E7FEE0        	  2748:     movem.l D0-D6/A0-A2,-(SP)
                            	  2749: 
                            	  2750:     ; Save byte count for PPU_VADDR update at end
02:0001E84A 2002            	  2751:     move.l  D2,D0                   ; D0.l = total byte count
                            	  2752: 
                            	  2753:     ; A2 = LUT base (kept across all tiles)
02:0001E84C 45F90001E936    	  2754:     lea     (.fast_expand_lut).l,A2
                            	  2755: 
                            	  2756:     ; A0 = ROM source (already set by caller)
                            	  2757:     ; D1.w = NES PPU dest address
                            	  2758: 
                            	  2759: .ftcb_tile:
02:0001E852 4A82            	  2760:     tst.l   D2
02:0001E854 6F0000D4        	  2761:     ble     .ftcb_done
                            	  2762: 
02:0001E858 0839000500FF0804	  2763:     btst    #5,(PPU_CTRL).l
02:0001E860 672C            	  2764:     beq.s   .ftcb_no_stage_hi_sprite
02:0001E862 0C411F20        	  2765:     cmpi.w  #$1F20,D1
02:0001E866 6526            	  2766:     blo.s   .ftcb_no_stage_hi_sprite
02:0001E868 0C411F40        	  2767:     cmpi.w  #$1F40,D1
02:0001E86C 6420            	  2768:     bhs.s   .ftcb_no_stage_hi_sprite
02:0001E86E 43F900FF0820    	  2769:     lea     (CHR_TILE_BUF).l,A1
02:0001E874 2290            	  2770:     move.l  0(A0),(A1)
02:0001E876 236800040004    	  2771:     move.l  4(A0),4(A1)
02:0001E87C 236800080008    	  2772:     move.l  8(A0),8(A1)
02:0001E882 2368000C000C    	  2773:     move.l  12(A0),12(A1)
02:0001E888 33C100FF0832    	  2774:     move.w  D1,(CHR_BUF_VADDR).l
                            	  2775: .ftcb_no_stage_hi_sprite:
                            	  2776: 
                            	  2777:     ; Set VDP write address: Genesis VRAM addr = NES CHR addr × 2
02:0001E88E 3601            	  2778:     move.w  D1,D3
02:0001E890 D643            	  2779:     add.w   D3,D3                   ; D3.w = VDP VRAM address
02:0001E892 7800            	  2780:     moveq   #0,D4
02:0001E894 3803            	  2781:     move.w  D3,D4
02:0001E896 4844            	  2782:     swap    D4                      ; D4 = addr << 16
02:0001E898 008440000000    	  2783:     ori.l   #$40000000,D4           ; VDP VRAM-write command
02:0001E89E 23C400C00004    	  2784:     move.l  D4,(VDP_CTRL).l
                            	  2785: 
                            	  2786:     ; Convert 8 rows of this tile
02:0001E8A4 7A07            	  2787:     moveq   #7,D5                   ; row counter
                            	  2788: 
