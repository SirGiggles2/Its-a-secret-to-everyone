                            	   498: ;------------------------------------------------------------------------------
                            	   499: ; _ags_prearm — Promote the previously staged scroll state into the active
                            	   500: ;               queue at START of vblank, BEFORE IsrNmi runs. This guarantees
                            	   501: ;               a coherent current-frame fallback even if the post-NMI flush
                            	   502: ;               finishes too late to safely touch VDP state for the same frame.
                            	   503: ;
                            	   504: ; Promotes the staged scroll state prepared by the previous frame's _ags_flush
                            	   505: ; into the active queue consumed by HBlankISR, then applies it immediately.
                            	   506: ;
                            	   507: ; Reads:  STAGED_SCROLL_MODE, STAGED_HINT_CTR, STAGED_BASE_VSRAM,
                            	   508: ;         STAGED_EVENT_VSRAM
                            	   509: ; Writes: HINT_Q_COUNT, HINT_Q0_CTR, HINT_Q0_VSRAM, HINT_PEND_SPLIT,
                            	   510: ;         INTRO_SCROLL_MODE
                            	   511: ; Preserves: D1-D7, A0-A6  (clobbers D0 internally, saved/restored)
                            	   512: ;------------------------------------------------------------------------------
                            	   513: _ags_prearm:
02:00001A28 48E78000        	   514:     movem.l D0,-(SP)
02:00001A2C 6108            	   515:     bsr     _ags_activate_staged
02:00001A2E 616C            	   516:     bsr     _ags_apply_active
02:00001A30 4CDF0001        	   517:     movem.l (SP)+,D0
02:00001A34 4E75            	   518:     rts
                            	   519: 
                            	   520: ;------------------------------------------------------------------------------
                            	   521: ; _ags_activate_staged — Promote STAGED_* into the active queue/debug state.
                            	   522: ; Clobbers D0.
                            	   523: ;------------------------------------------------------------------------------
                            	   524: _ags_activate_staged:
02:00001A36 103900FF080A    	   525:     move.b  (STAGED_SCROLL_MODE).l,D0
02:00001A3C 13C000FF081F    	   526:     move.b  D0,(INTRO_SCROLL_MODE).l
02:00001A42 33F900FF080C00FF	   527:     move.w  (STAGED_BASE_VSRAM).l,(ACTIVE_BASE_VSRAM).l
02:00001A4A 0836
02:00001A4C 33F900FF080E00FF	   528:     move.w  (STAGED_EVENT_VSRAM).l,(ACTIVE_EVENT_VSRAM).l
02:00001A54 0838
02:00001A56 13F900FF080B00FF	   529:     move.b  (STAGED_HINT_CTR).l,(ACTIVE_HINT_CTR).l
02:00001A5E 083A
02:00001A60 4A00            	   530:     cmpi.b  #INTRO_SCROLL_NO_SPLIT,D0
02:00001A62 6726            	   531:     beq.s   .aas_no_split
02:00001A64 13FC000100FF081E	   532:     move.b  #1,(HINT_PEND_SPLIT).l
02:00001A6C 13FC000100FF0816	   533:     move.b  #1,(HINT_Q_COUNT).l
02:00001A74 13F900FF080B00FF	   534:     move.b  (STAGED_HINT_CTR).l,(HINT_Q0_CTR).l
02:00001A7C 0817
02:00001A7E 33F900FF080E00FF	   535:     move.w  (STAGED_EVENT_VSRAM).l,(HINT_Q0_VSRAM).l
02:00001A86 0818
02:00001A88 4E75            	   536:     rts
                            	   537: .aas_no_split:
02:00001A8A 13FC000000FF081E	   538:     move.b  #0,(HINT_PEND_SPLIT).l
02:00001A92 13FC000000FF0816	   539:     move.b  #0,(HINT_Q_COUNT).l
02:00001A9A 4E75            	   540:     rts
