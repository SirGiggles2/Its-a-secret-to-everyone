                            	  1660: _L_z04_Burrower_AnimateDrawAndCheckCollisions_CalcFrameImage:
                            	  1661:     ; Or else if is zora in state 1 or 5, then use one of
                            	  1662:     ; the mound frame images:
                            	  1663:     ;
                            	  1664:     ; frame image := ((state - 1) * 2) + movement frame
                            	  1665:     ;
                            	  1666:     ; This yields 0/1 or 8/9, depending on the state.
                            	  1667:     ;
                            	  1668:     ; This formula is used for states 1 to 5 of non-zora burrowers.
                            	  1669:     ;
02:0002C428 003C0011        	  1670:     ori     #$11,CCR  ; SEC: set C+X
02:0002C42C 123C0001        	  1671:     move.b  #$01,D1
02:0002C430 0A3C0010        	  1672:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002C434 9101            	  1673:     subx.b  D1,D0   ; SBC #$01
02:0002C436 0A3C0010        	  1674:     eori    #$10,CCR  ; restore X = 6502 C
02:0002C43A E308            	  1675:     lsl.b  #1,D0   ; ASL A
02:0002C43C 023C00EE        	  1676:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002C440 41EC03E4        	  1677:     lea     ($03E4,A4),A0
02:0002C444 12302000        	  1678:     move.b  (A0,D2.W),D1
02:0002C448 D101            	  1679:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
                            	  1680:     even
