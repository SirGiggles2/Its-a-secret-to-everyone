                            	  3068:     ;==========================================================================
                            	  3069:     ; NAMETABLE RANGE ($2000-$23BF): tile index -> Plane A word
                            	  3070:     ;==========================================================================
                            	  3071: .ttf_nt_range:
02:0001EAC0 45F900FF0840    	  3072:     lea     (NT_CACHE_BASE).l,A2
                            	  3073: 
                            	  3074: .ttf_nt_loop:
                            	  3075:     ; Get data byte
02:0001EAC6 4A04            	  3076:     tst.b   D4                      ; repeat mode?
02:0001EAC8 6602            	  3077:     bne.s   .ttf_nt_have_byte
02:0001EACA 1418            	  3078:     move.b  (A0)+,D2                ; sequential: read next byte
                            	  3079: .ttf_nt_have_byte:
                            	  3080: 
                            	  3081:     ; Bounds check
02:0001EACC 0C4523C0        	  3082:     cmpi.w  #$23C0,D5
02:0001EAD0 64000098        	  3083:     bhs     .ttf_nt_skip            ; long branch (added HUD guard ops)
                            	  3084: 
                            	  3085:     ; Compute index = PPU_VADDR - $2000
02:0001EAD4 3005            	  3086:     move.w  D5,D0
02:0001EAD6 04402000        	  3087:     subi.w  #$2000,D0               ; D0.w = index (0..$3BF)
                            	  3088: 
                            	  3089:     ; T39 HUD row guard (Stage B + Stage C + Stage D + P45 + perf-hoist):
