                            	  8529: Submenu_WriteScanningMapRoomMark:
02:00034FAE 1003            	  8530:     move.b  D3,D0
02:00034FB0 1B00            	  8531:     move.b  D0,-(A5)  ; PHA
02:00034FB2 61005808        	  8532:     jsr     GetRoomFlags
02:00034FB6 102C00EB        	  8533:     move.b  ($00EB,A4),D0
02:00034FBA 1B00            	  8534:     move.b  D0,-(A5)  ; PHA
                            	  8535:     ; Temporarily set current room ID to the room ID we're scanning,
                            	  8536:     ; in order to look up its information.
                            	  8537:     ;
02:00034FBC 102C005D        	  8538:     move.b  ($005D,A4),D0
02:00034FC0 194000EB        	  8539:     move.b  D0,($00EB,A4)
                            	  8540:     ; Set OpenDoorMask to $13, in case the room has not been
                            	  8541:     ; visited. $E2 will be added, yielding $F5, which is the blank
                            	  8542:     ; map mark tile.
                            	  8543:     ;
02:00034FC4 7013            	  8544:     moveq   #19,D0
02:00034FC6 1940033F        	  8545:     move.b  D0,($033F,A4)
                            	  8546:     ; Get the currently scanned room's visit state.
                            	  8547:     ;
02:00034FCA 7600            	  8548:     moveq   #0,D3
02:00034FCC 162C00EB        	  8549:     move.b  ($00EB,A4),D3
02:00034FD0 1214            	  8550:     move.b  ($00,A4),D1   ; ptr lo
02:00034FD2 182C0001        	  8551:     move.b  ($01,A4),D4  ; ptr hi
02:00034FD6 024100FF        	  8552:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00034FDA E14C            	  8553:     lsl.w   #8,D4
02:00034FDC 8841            	  8554:     or.w    D1,D4             ; D4 = NES ptr addr
02:00034FDE 48C4            	  8555:     ext.l   D4
02:00034FE0 D8BC00FF0000    	  8556:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00034FE6 2044            	  8557:     movea.l D4,A0
02:00034FE8 10303000        	  8558:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00034FEC 02000020        	  8559:     andi.b #$20,D0
                            	  8560:     ; If it's been visited, then check each of the 4 doors,
                            	  8561:     ; and build an open door mask.
                            	  8562:     ;
                            	  8563:     ; Start with direction up and direction index 3.
                            	  8564:     ;
02:00034FF0 671C            	  8565:     beq  _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile
02:00034FF2 7008            	  8566:     moveq   #8,D0
02:00034FF4 19400002        	  8567:     move.b  D0,($0002,A4)
02:00034FF8 7403            	  8568:     moveq   #3,D2
                            	  8569: _anon_z05_204:
02:00034FFA 6100E0C6        	  8570:     jsr     FindDoorAttrByDoorBit
02:00034FFE 6132            	  8571:     jsr     CalcOpenDoorwayMask
02:00035000 5302            	  8572:     subq.b  #1,D2
02:00035002 122C0002        	  8573:     move.b  ($0002,A4),D1
02:00035006 E209            	  8574:     lsr.b  #1,D1   ; LSR $02
02:00035008 19410002        	  8575:     move.b  D1,($0002,A4)
02:0003500C 66EC            	  8576:     bne  _anon_z05_204
                            	  8577:     even
                            	  8578: _L_z05_Submenu_WriteScanningMapRoomMark_WriteMapTile:
                            	  8579:     ; Restore current room ID and dynamic buffer offset.
                            	  8580:     ;
02:0003500E 101D            	  8581:     move.b  (A5)+,D0  ; PLA
02:00035010 194000EB        	  8582:     move.b  D0,($00EB,A4)
02:00035014 101D            	  8583:     move.b  (A5)+,D0  ; PLA
02:00035016 7600            	  8584:     moveq   #0,D3
02:00035018 1600            	  8585:     move.b  D0,D3
                            	  8586:     ; The map marks are arranged in the same order as all the
                            	  8587:     ; possible values of OpenDoorMask.
                            	  8588:     ;
                            	  8589:     ; Add $E2 for the first map mark tile, and store it in the
                            	  8590:     ; dynamic transfer buf at the current offset.
                            	  8591:     ;
02:0003501A 102C033F        	  8592:     move.b  ($033F,A4),D0
02:0003501E 023C00EE        	  8593:     andi    #$EE,CCR  ; CLC: clear C+X
02:00035022 123C00E2        	  8594:     move.b  #$E2,D1
02:00035026 D101            	  8595:     addx.b  D1,D0   ; ADC #$E2 (X flag = 6502 C)
02:00035028 41EC0304        	  8596:     lea     ($0304,A4),A0
02:0003502C 11803000        	  8597:     move.b  D0,(A0,D3.W)
02:00035030 4E75            	  8598:     rts
                            	  8599: 
                            	  8600: ; Call for each direction index (3 to 0) to build an open doorway mask
                            	  8601: ; based on doorway type and room flags. Each call will shift the next
                            	  8602: ; doorway state bit into OpenDoorwayMask.
                            	  8603: ;
                            	  8604: ; Params:
                            	  8605: ; A: door attribute
                            	  8606: ; X: direction index
                            	  8607: ;
                            	  8608: ; Returns:
                            	  8609: ; A: untouched
                            	  8610: ;
                            	  8611:     even
                            	  8612: CalcOpenDoorwayMask:
02:00035032 4EF90001EF36    	  8613:     jmp     c_calc_open_doorway_mask
                            	  8614: 
