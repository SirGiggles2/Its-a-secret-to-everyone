                            	  2518: PondFairy_MoveHearts:
                            	  2519:     ; Loop over each heart from object slot 2 to 9.
                            	  2520:     ;
                            	  2521:     ; Even though they are not standalone objects, their info
                            	  2522:     ; is stored in those object slots.
                            	  2523:     ;
02:0002C9EC 7402            	  2524:     moveq   #2,D2
                            	  2525:     even
                            	  2526: _L_z04_PondFairy_MoveHearts_LoopHeart:
                            	  2527:     ; If the current heart's state <> 0, then go move it.
                            	  2528:     ; Else we have to wait for it to come out at the right time.
                            	  2529:     ;
02:0002C9EE 41EC00AC        	  2530:     lea     ($00AC,A4),A0
02:0002C9F2 10302000        	  2531:     move.b  (A0,D2.W),D0
02:0002C9F6 667C            	  2532:     bne  _L_z04_PondFairy_MoveHearts_MoveHeart
                            	  2533:     ; The current heart's state = 0.
                            	  2534:     ;
                            	  2535:     ; If object slot = 2, then go make it appear. This is the first
                            	  2536:     ; heart to show up.
                            	  2537:     ;
02:0002C9F8 0C020002        	  2538:     cmpi.b  #$02,D2
02:0002C9FC 6732            	  2539:     beq  _L_z04_PondFairy_MoveHearts_SetUpHeart
                            	  2540:     ; Object slot <> 2. If the state of the heart in slot 2 = 0, then
                            	  2541:     ; go start over.
                            	  2542:     ;
                            	  2543:     ; TODO:
                            	  2544:     ; Is it possible to jump from here? This looks like an infinite loop.
                            	  2545:     ;
02:0002C9FE 102C00AE        	  2546:     move.b  ($00AE,A4),D0
02:0002CA02 67EA            	  2547:     beq  _L_z04_PondFairy_MoveHearts_LoopHeart
                            	  2548:     ; Look up the starting angle of this heart with the index
                            	  2549:     ; (object slot - 3). If the first heart has not reached this angle,
                            	  2550:     ; then loop again.
                            	  2551:     ;
02:0002CA04 1002            	  2552:     move.b  D2,D0
02:0002CA06 003C0011        	  2553:     ori     #$11,CCR  ; SEC: set C+X
02:0002CA0A 123C0003        	  2554:     move.b  #$03,D1
02:0002CA0E 0A3C0010        	  2555:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002CA12 9101            	  2556:     subx.b  D1,D0   ; SBC #$03
02:0002CA14 0A3C0010        	  2557:     eori    #$10,CCR  ; restore X = 6502 C
02:0002CA18 7600            	  2558:     moveq   #0,D3
02:0002CA1A 1600            	  2559:     move.b  D0,D3
02:0002CA1C 102C0396        	  2560:     move.b  ($0396,A4),D0
02:0002CA20 41F90002C9E4    	  2561:     lea     (PondHeartStartAngles).l,A0
02:0002CA26 12303000        	  2562:     move.b  (A0,D3.W),D1
02:0002CA2A B001            	  2563:     cmp.b   D1,D0
02:0002CA2C 66000086        	  2564:     bne  _L_z04_PondFairy_MoveHearts_NextLoopHeart
                            	  2565:     even
                            	  2566: _L_z04_PondFairy_MoveHearts_SetUpHeart:
                            	  2567:     ; Set up this heart. Set its state to 1.
                            	  2568:     ;
02:0002CA30 41EC00AC        	  2569:     lea     ($00AC,A4),A0
02:0002CA34 52302000        	  2570:     addq.b  #1,(A0,D2.W)
                            	  2571:     ; TODO: ?
                            	  2572:     ;
02:0002CA38 103C0080        	  2573:     move.b  #$80,D0
02:0002CA3C 41EC0098        	  2574:     lea     ($0098,A4),A0
02:0002CA40 11802000        	  2575:     move.b  D0,(A0,D2.W)
                            	  2576:     ; Starting angle $18 (N).
                            	  2577:     ;
02:0002CA44 7018            	  2578:     moveq   #24,D0
02:0002CA46 41EC0394        	  2579:     lea     ($0394,A4),A0
02:0002CA4A 11802000        	  2580:     move.b  D0,(A0,D2.W)
                            	  2581:     ; This heart is right above the fairy. Set its X the same as the fairy's.
                            	  2582:     ;
02:0002CA4E 102C0071        	  2583:     move.b  ($0071,A4),D0
02:0002CA52 19802070        	  2584:     move.b  D0,($70,A4,D2.W)
                            	  2585:     ; This heart is right above the fairy. Set its Y $1C pixels above the fairy.
                            	  2586:     ;
02:0002CA56 102C0085        	  2587:     move.b  ($0085,A4),D0
02:0002CA5A 003C0011        	  2588:     ori     #$11,CCR  ; SEC: set C+X
02:0002CA5E 123C001C        	  2589:     move.b  #$1C,D1
02:0002CA62 0A3C0010        	  2590:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:0002CA66 9101            	  2591:     subx.b  D1,D0   ; SBC #$1C
02:0002CA68 0A3C0010        	  2592:     eori    #$10,CCR  ; restore X = 6502 C
02:0002CA6C 41EC0084        	  2593:     lea     ($0084,A4),A0
02:0002CA70 11802000        	  2594:     move.b  D0,(A0,D2.W)
                            	  2595:     even
                            	  2596: _L_z04_PondFairy_MoveHearts_MoveHeart:
                            	  2597:     ; Decrease the angle by $00.60.
                            	  2598:     ;
02:0002CA74 7000            	  2599:     moveq   #0,D0
02:0002CA76 1940000B        	  2600:     move.b  D0,($000B,A4)
02:0002CA7A 7060            	  2601:     moveq   #96,D0
02:0002CA7C 61003466        	  2602:     jsr     DecreaseObjectAngle
                            	  2603:     ; Rotate the heart's location by the change in angle.
                            	  2604:     ; Use 6 for the number of bits of sine/cosine to use
                            	  2605:     ; for a large ring.
                            	  2606:     ;
02:0002CA80 7006            	  2607:     moveq   #6,D0
02:0002CA82 7600            	  2608:     moveq   #0,D3
02:0002CA84 1600            	  2609:     move.b  D0,D3
02:0002CA86 610032AC        	  2610:     jsr     RotateObjectLocation
02:0002CA8A 41EC0084        	  2611:     lea     ($0084,A4),A0
02:0002CA8E 11802000        	  2612:     move.b  D0,(A0,D2.W)
02:0002CA92 1002            	  2613:     move.b  D2,D0
02:0002CA94 1B00            	  2614:     move.b  D0,-(A5)  ; PHA
02:0002CA96 4EB900024964    	  2615:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
02:0002CA9C 4EB90003C8E8    	  2616:     jsr     Anim_FetchObjPosForSpriteDescriptor
                            	  2617:     ; The variable for the currently updating object slot has to be
                            	  2618:     ; set to the heart's object slot for this drawing routine to work.
                            	  2619:     ;
02:0002CAA2 7400            	  2620:     moveq   #0,D2
02:0002CAA4 142C0340        	  2621:     move.b  ($0340,A4),D2
02:0002CAA8 4EB900024674    	  2622:     jsr     DrawObjectNotMirrored
02:0002CAAE 101D            	  2623:     move.b  (A5)+,D0  ; PLA
02:0002CAB0 7400            	  2624:     moveq   #0,D2
02:0002CAB2 1400            	  2625:     move.b  D0,D2
                            	  2626:     even
                            	  2627: _L_z04_PondFairy_MoveHearts_NextLoopHeart:
                            	  2628:     ; Bottom of the loop.
                            	  2629:     ; Increase the object slot.
                            	  2630:     ;
02:0002CAB4 5202            	  2631:     addq.b  #1,D2
02:0002CAB6 0C02000A        	  2632:     cmpi.b  #$0A,D2
02:0002CABA 6600FF32        	  2633:     bne  _L_z04_PondFairy_MoveHearts_LoopHeart
02:0002CABE 0A3C0001        	  2634:     eori    #$01,CCR  ; normalize C to 6502 polarity before RTS
02:0002CAC2 4E75            	  2635:     rts
                            	  2636: 
