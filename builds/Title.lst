02:00001E96 3A04            	  1089:     move.w  D4,D5
02:00001E98 EC4D            	  1090:     lsr.w   #6,D5
02:00001E9A 02450003        	  1091:     andi.w  #$0003,D5
02:00001E9E EB4D            	  1092:     lsl.w   #5,D5
02:00001EA0 E14D            	  1093:     lsl.w   #8,D5
02:00001EA2 5442            	  1094:     addq.w  #2,D2
02:00001EA4 5443            	  1095:     addq.w  #2,D3
02:00001EA6 610002AE        	  1096:     bsr     _attr_write_2x2
02:00001EAA 5542            	  1097:     subq.w  #2,D2
02:00001EAC 5543            	  1098:     subq.w  #2,D3
