                            	  7969: PatraChild_Draw:
02:0002F290 4EB900024964    	  7970:     jsr     Anim_SetSpriteDescriptorRedPaletteRow
                            	  7971:     ; 2 was returned from the routine above in A.
                            	  7972:     ; Pass it as the animation counter value to the routine below.
                            	  7973:     ;
02:0002F296 4EB90003C8E2    	  7974:     jsr     Anim_AdvanceAnimCounterAndSetObjPosForSpriteDescriptor
02:0002F29C 41EC03E4        	  7975:     lea     ($03E4,A4),A0
02:0002F2A0 10302000        	  7976:     move.b  (A0,D2.W),D0
02:0002F2A4 4EF900024674    	  7977:     jmp     DrawObjectNotMirrored
