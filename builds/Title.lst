                            	  4781: Aquamentus_Draw:
                            	  4782:     ; Every $10 screen frames, switch animation frames.
                            	  4783:     ; Each frame has 6 tiles (representing the top of 6 sprites).
                            	  4784:     ; The last tile of frame 0 is at index 5.
                            	  4785:     ; The last tile of frame 1 is at index $B.
                            	  4786:     ;
02:0002DA90 7605            	  4787:     moveq   #5,D3
02:0002DA92 102C0015        	  4788:     move.b  ($0015,A4),D0
02:0002DA96 02000010        	  4789:     andi.b #$10,D0
02:0002DA9A 6602            	  4790:     bne  _anon_z04_88
02:0002DA9C 760B            	  4791:     moveq   #11,D3
                            	  4792: _anon_z04_88:
02:0002DA9E 1943000A        	  4793:     move.b  D3,($000A,A4)
