02:0002E92A 41EC03E4        	  6732:     lea     ($03E4,A4),A0
02:0002E92E 12302000        	  6733:     move.b  (A0,D2.W),D1
02:0002E932 D101            	  6734:     addx.b  D1,D0   ; ADC ObjAnimFrame,X
02:0002E934 02000001        	  6735:     andi.b #$01,D0
02:0002E938 023C00EE        	  6736:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E93C 123C0004        	  6737:     move.b  #$04,D1
