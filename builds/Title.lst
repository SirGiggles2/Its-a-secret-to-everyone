02:0003C074 194000AC        	  5519:     move.b  D0,($00AC,A4)
                            	  5520:     ; Make to set Link's animation counter to 1, so that he picks
                            	  5521:     ; up the new state.
                            	  5522:     ;
02:0003C078 7001            	  5523:     moveq   #1,D0
02:0003C07A 194003D0        	  5524:     move.b  D0,($03D0,A4)
