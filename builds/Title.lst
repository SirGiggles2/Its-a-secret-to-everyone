02:0002C4FE 19802070        	  1775:     move.b  D0,($70,A4,D2.W)
                            	  1776:     ; If facing down, then use Y offset $28.
                            	  1777:     ; Else store Y offset -$28 in [00].
                            	  1778:     ;
02:0002C502 7628            	  1779:     moveq   #40,D3
02:0002C504 41EC0098        	  1780:     lea     ($0098,A4),A0
02:0002C508 10302000        	  1781:     move.b  (A0,D2.W),D0
02:0002C50C 02000008        	  1782:     andi.b #$08,D0
02:0002C510 6704            	  1783:     beq  _anon_z04_44
02:0002C512 163C00D8        	  1784:     move.b  #$D8,D3
                            	  1785: _anon_z04_44:
02:0002C516 1883            	  1786:     move.b  D3,($0000,A4)
                            	  1787:     ; Add Link's Y and the vertical offset.
                            	  1788:     ;
02:0002C518 102C0084        	  1789:     move.b  ($0084,A4),D0
02:0002C51C 023C00EE        	  1790:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002C520 1214            	  1791:     move.b  ($0000,A4),D1
02:0002C522 D101            	  1792:     addx.b  D1,D0   ; ADC $00
                            	  1793:     ; Sanitize the Y coordinate:
                            	  1794:     ; (Y AND $F0) OR $D
                            	  1795:     ;
02:0002C524 020000F0        	  1796:     andi.b #$F0,D0
02:0002C528 0000000D        	  1797:     ori.b #$0D,D0
