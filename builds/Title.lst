                            	  8405: Submenu_WriteSheetMapRowTransferRecord:
02:00034EC0 7610            	  8406:     moveq   #16,D3
                            	  8407:     ; Get the submenu row by dividing (current menu scrolling value) by 2.
                            	  8408:     ;
02:00034EC2 102C005E        	  8409:     move.b  ($005E,A4),D0
02:00034EC6 E208            	  8410:     lsr.b  #1,D0   ; LSR A
02:00034EC8 7400            	  8411:     moveq   #0,D2
02:00034ECA 1400            	  8412:     move.b  D0,D2
                            	  8413:     ; Write an end marker at the end of the row data.
                            	  8414:     ;
02:00034ECC 103C00FF        	  8415:     move.b  #$FF,D0
02:00034ED0 41EC0305        	  8416:     lea     ($0305,A4),A0
02:00034ED4 11803000        	  8417:     move.b  D0,(A0,D3.W)
02:00034ED8 7010            	  8418:     moveq   #16,D0
02:00034EDA 19400304        	  8419:     move.b  D0,($0304,A4)
                            	  8420:     ; Calculate PPU address ($290C + X*$20).
                            	  8421:     ;
02:00034EDE 7028            	  8422:     moveq   #40,D0
02:00034EE0 19400302        	  8423:     move.b  D0,($0302,A4)
02:00034EE4 103C00EC        	  8424:     move.b  #$EC,D0
                            	  8425:     even
                            	  8426: _L_z05_Submenu_WriteSheetMapRowTransferRecord_Add20H:
02:00034EE8 023C00EE        	  8427:     andi    #$EE,CCR  ; CLC: clear C+X
02:00034EEC 123C0020        	  8428:     move.b  #$20,D1
02:00034EF0 D101            	  8429:     addx.b  D1,D0   ; ADC #$20 (X flag = 6502 C)
02:00034EF2 6404            	  8430:     bcc  _anon_z05_198
02:00034EF4 522C0302        	  8431:     addq.b  #1,($0302,A4)
                            	  8432: _anon_z05_198:
02:00034EF8 5302            	  8433:     subq.b  #1,D2
02:00034EFA 6AEC            	  8434:     bpl  _L_z05_Submenu_WriteSheetMapRowTransferRecord_Add20H
02:00034EFC 19400303        	  8435:     move.b  D0,($0303,A4)
                            	  8436:     ; Write a map mark in the dynamic transfer buf for each room
                            	  8437:     ; in the range currently being scanned.
                            	  8438:     ;
02:00034F00 102C005D        	  8439:     move.b  ($005D,A4),D0
02:00034F04 1B00            	  8440:     move.b  D0,-(A5)  ; PHA
                            	  8441: _anon_z05_199:
02:00034F06 610000A6        	  8442:     jsr     Submenu_WriteScanningMapRoomMark
02:00034F0A 532C005D        	  8443:     subq.b  #1,($005D,A4)
02:00034F0E 5303            	  8444:     subq.b  #1,D3
02:00034F10 66F4            	  8445:     bne  _anon_z05_199
                            	  8446:     ; Restore the current scanned room index and subtract $10.
                            	  8447:     ;
02:00034F12 101D            	  8448:     move.b  (A5)+,D0  ; PLA
02:00034F14 003C0011        	  8449:     ori     #$11,CCR  ; SEC: set C+X
02:00034F18 123C0010        	  8450:     move.b  #$10,D1
02:00034F1C 0A3C0010        	  8451:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034F20 9101            	  8452:     subx.b  D1,D0   ; SBC #$10
02:00034F22 0A3C0010        	  8453:     eori    #$10,CCR  ; restore X = 6502 C
02:00034F26 1940005D        	  8454:     move.b  D0,($005D,A4)
                            	  8455:     ; If the level info indicates that the submenu map should be
                            	  8456:     ; rotated horizontally, then loop to rotate right the number of
                            	  8457:     ; bytes indicated.
