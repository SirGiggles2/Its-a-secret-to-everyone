                            	   762: ;==============================================================================
                            	   763: ; prep_phrase — ported from PrepPhrase
                            	   764: ; Reads 8-byte header at MusicBlob[MusicBlob[m_phrase-1]].
                            	   765: ;==============================================================================
                            	   766: prep_phrase:
02:000007A6 43F900000DD0    	   767:     lea     (MusicBlob).l,A1
02:000007AC 7200            	   768:     moveq   #0,D1
02:000007AE 123900FFE002    	   769:     move.b  (m_phrase).l,D1
02:000007B4 5341            	   770:     subq.w  #1,D1
02:000007B6 12311000        	   771:     move.b  (A1,D1.w),D1                ; indirect: inner index
02:000007BA 024100FF        	   772:     andi.w  #$FF,D1
                            	   773: 
                            	   774:     ; byte 0: NoteLengthTableBase
02:000007BE 13F1100000FFE003	   775:     move.b  (A1,D1.w),(m_len_base).l
02:000007C6 5241            	   776:     addq.w  #1,D1
                            	   777:     ; byte 1: script ptr lo
02:000007C8 7400            	   778:     moveq   #0,D2
02:000007CA 14311000        	   779:     move.b  (A1,D1.w),D2
02:000007CE 5241            	   780:     addq.w  #1,D1
                            	   781:     ; byte 2: script ptr hi
02:000007D0 7600            	   782:     moveq   #0,D3
02:000007D2 16311000        	   783:     move.b  (A1,D1.w),D3
02:000007D6 5241            	   784:     addq.w  #1,D1
02:000007D8 E14B            	   785:     lsl.w   #8,D3
02:000007DA 8642            	   786:     or.w    D2,D3                        ; D3 = NES CPU address
02:000007DC 967C8D60        	   787:     sub.w   #MUSIC_BLOB_NES_BASE,D3
02:000007E0 02830000FFFF    	   788:     andi.l  #$FFFF,D3
02:000007E6 41F900000DD0    	   789:     lea     (MusicBlob).l,A0
02:000007EC D1C3            	   790:     adda.l  D3,A0                        ; A0 = M68K script base
02:000007EE 23C800FFE008    	   791:     move.l  A0,(m_script_ptr).l
                            	   792: 
                            	   793:     ; byte 3: NoteOffsetSongTrg
02:000007F4 13F1100000FFE01C	   794:     move.b  (A1,D1.w),(m_trg_off).l
02:000007FC 5241            	   795:     addq.w  #1,D1
                            	   796:     ; byte 4: NoteOffsetSongSq0
02:000007FE 13F1100000FFE014	   797:     move.b  (A1,D1.w),(m_sq0_off).l
02:00000806 5241            	   798:     addq.w  #1,D1
                            	   799:     ; byte 5: NoteOffsetSongNoise (also FirstNoiseIdx)
02:00000808 13F1100000FFE024	   800:     move.b  (A1,D1.w),(m_noise_off).l
02:00000810 13F1100000FFE006	   801:     move.b  (A1,D1.w),(m_noise_first).l
02:00000818 5241            	   802:     addq.w  #1,D1
                            	   803:     ; byte 6: SongEnvelopeSelector
02:0000081A 13F1100000FFE004	   804:     move.b  (A1,D1.w),(m_env_sel).l
02:00000822 5241            	   805:     addq.w  #1,D1
                            	   806:     ; byte 7: mystery
02:00000824 13F1100000FFE005	   807:     move.b  (A1,D1.w),(m_mystery).l
                            	   808: 
                            	   809:     ; Reset counters and Sq1 offset
02:0000082C 13FC000100FFE00D	   810:     move.b  #1,(m_sq1_cnt).l
02:00000834 13FC000100FFE015	   811:     move.b  #1,(m_sq0_cnt).l
02:0000083C 13FC000100FFE01D	   812:     move.b  #1,(m_trg_cnt).l
02:00000844 13FC000100FFE025	   813:     move.b  #1,(m_noise_cnt).l
02:0000084C 423900FFE00C    	   814:     clr.b   (m_sq1_off).l
02:00000852 423900FFE021    	   815:     clr.b   (m_trg_rep_n).l
02:00000858 4E75            	   816:     rts
                            	   817: 
                            	   818: ;==============================================================================
                            	   819: ; tick_sq1 — Sq1 channel update (primary: owns phrase advance on song-end)
                            	   820: ;==============================================================================
                            	   821: tick_sq1:
02:0000085A 533900FFE00D    	   822:     subq.b  #1,(m_sq1_cnt).l
02:00000860 66000116        	   823:     bne     tick_sq0                     ; no new note
                            	   824: .read:
02:00000864 207900FFE008    	   825:     move.l  (m_script_ptr).l,A0
02:0000086A 7200            	   826:     moveq   #0,D1
02:0000086C 123900FFE00C    	   827:     move.b  (m_sq1_off).l,D1
02:00000872 523900FFE00C    	   828:     addq.b  #1,(m_sq1_off).l
02:00000878 10301000        	   829:     move.b  (A0,D1.w),D0
02:0000087C 673A            	   830:     beq.s   .song_ended
02:0000087E 4A00            	   831:     tst.b   D0
02:00000880 6B02            	   832:     bmi.s   .prep_then_note              ; bit 7 set → control byte
02:00000882 6022            	   833:     bra.s   .play_note
                            	   834: .prep_then_note:
02:00000884 61000284        	   835:     bsr     get_song_note_length         ; D0 in → D0 length
02:00000888 13C000FFE00E    	   836:     move.b  D0,(m_sq1_len).l
02:0000088E 207900FFE008    	   837:     move.l  (m_script_ptr).l,A0
02:00000894 7200            	   838:     moveq   #0,D1
02:00000896 123900FFE00C    	   839:     move.b  (m_sq1_off).l,D1
02:0000089C 523900FFE00C    	   840:     addq.b  #1,(m_sq1_off).l
02:000008A2 10301000        	   841:     move.b  (A0,D1.w),D0
                            	   842: .play_note:
02:000008A6 6100027C        	   843:     bsr     emit_note_sq1                 ; D0 = note id
02:000008AA 13F900FFE00E00FF	   844:     move.b  (m_sq1_len).l,(m_sq1_cnt).l
02:000008B2 E00D
02:000008B4 600000C2        	   845:     bra     tick_sq0
                            	   846: .song_ended:
02:000008B8 13FC000100FFE02B	   847:     move.b  #1,(m_song_loop_pending).l   ; signal loop point to C poller
02:000008C0 103900FFE000    	   848:     move.b  (m_song).l,D0
02:000008C6 020000F1        	   849:     andi.b  #$F1,D0
02:000008CA 6604            	   850:     bne.s   .play_again
02:000008CC 60000430        	   851:     bra     music_silence
                            	   852: .play_again:
02:000008D0 6102            	   853:     bsr     play_next_phrase_no_tick
02:000008D2 6090            	   854:     bra.s   .read
                            	   855: 
                            	   856: ;----------------------------------------------------------------------
                            	   857: ; play_next_phrase_no_tick — variant that ends with rts (via prep_phrase
                            	   858: ; tail call) instead of falling into tick_sq1.  Used from inside tick_sq1
                            	   859: ; to restart a looping song when $00 opcode is read.
                            	   860: ;----------------------------------------------------------------------
                            	   861: play_next_phrase_no_tick:
02:000008D4 103900FFE000    	   862:     move.b  (m_song).l,D0
02:000008DA 6B7E            	   863:     bmi     .nsp_demo
02:000008DC B03C0001        	   864:     cmp.b   #$01,D0
02:000008E0 675A            	   865:     beq     .nsp_ow
02:000008E2 B03C0040        	   866:     cmp.b   #$40,D0
02:000008E6 6738            	   867:     beq     .nsp_uw
02:000008E8 B03C0010        	   868:     cmp.b   #$10,D0
02:000008EC 6716            	   869:     beq     .nsp_ending
                            	   870:     ; single-phrase: rebuild phrase from bit
02:000008EE 7200            	   871:     moveq   #0,D1
02:000008F0 7400            	   872:     moveq   #0,D2
02:000008F2 1400            	   873:     move.b  D0,D2
                            	   874: .nsp_loop:
02:000008F4 5201            	   875:     addq.b  #1,D1
02:000008F6 E20A            	   876:     lsr.b   #1,D2
02:000008F8 64FA            	   877:     bcc     .nsp_loop
02:000008FA 13C100FFE002    	   878:     move.b  D1,(m_phrase).l
02:00000900 6000FEA4        	   879:     bra     prep_phrase
                            	   880: .nsp_ending:
02:00000904 523900FFE002    	   881:     addq.b  #1,(m_phrase).l
02:0000090A 0C39001A00FFE002	   882:     cmpi.b  #$1A,(m_phrase).l
02:00000912 6600FE92        	   883:     bne     prep_phrase
02:00000916 13FC001400FFE002	   884:     move.b  #$14,(m_phrase).l         ; wrap: set prev, re-enter (will +1)
02:0000091E 60B4            	   885:     bra     play_next_phrase_no_tick
                            	   886: .nsp_uw:
02:00000920 523900FFE002    	   887:     addq.b  #1,(m_phrase).l
02:00000926 0C39001200FFE002	   888:     cmpi.b  #$12,(m_phrase).l
02:0000092E 6600FE76        	   889:     bne     prep_phrase
02:00000932 13FC000F00FFE002	   890:     move.b  #$0F,(m_phrase).l
02:0000093A 6098            	   891:     bra     play_next_phrase_no_tick
                            	   892: .nsp_ow:
02:0000093C 523900FFE002    	   893:     addq.b  #1,(m_phrase).l
02:00000942 0C39001000FFE002	   894:     cmpi.b  #$10,(m_phrase).l
02:0000094A 6600FE5A        	   895:     bne     prep_phrase
02:0000094E 13FC000900FFE002	   896:     move.b  #$09,(m_phrase).l
02:00000956 6000FF7C        	   897:     bra     play_next_phrase_no_tick
                            	   898: .nsp_demo:
02:0000095A 523900FFE002    	   899:     addq.b  #1,(m_phrase).l
02:00000960 0C39002400FFE002	   900:     cmpi.b  #$24,(m_phrase).l
02:00000968 6600FE3C        	   901:     bne     prep_phrase
02:0000096C 13FC001900FFE002	   902:     move.b  #$19,(m_phrase).l
02:00000974 6000FF5E        	   903:     bra     play_next_phrase_no_tick
                            	   904: 
                            	   905: ;==============================================================================
                            	   906: ; tick_sq0 — Sq0 channel update
                            	   907: ;==============================================================================
                            	   908: tick_sq0:
02:00000978 4A3900FFE014    	   909:     tst.b   (m_sq0_off).l                 ; if starting offset 0 → channel off
02:0000097E 6754            	   910:     beq     tick_trg
02:00000980 533900FFE015    	   911:     subq.b  #1,(m_sq0_cnt).l
02:00000986 664C            	   912:     bne     tick_trg
02:00000988 207900FFE008    	   913:     move.l  (m_script_ptr).l,A0
02:0000098E 7200            	   914:     moveq   #0,D1
02:00000990 123900FFE014    	   915:     move.b  (m_sq0_off).l,D1
02:00000996 523900FFE014    	   916:     addq.b  #1,(m_sq0_off).l
02:0000099C 10301000        	   917:     move.b  (A0,D1.w),D0
02:000009A0 4A00            	   918:     tst.b   D0
02:000009A2 6A22            	   919:     bpl.s   .play
02:000009A4 61000164        	   920:     bsr     get_song_note_length
02:000009A8 13C000FFE016    	   921:     move.b  D0,(m_sq0_len).l
02:000009AE 207900FFE008    	   922:     move.l  (m_script_ptr).l,A0
02:000009B4 7200            	   923:     moveq   #0,D1
02:000009B6 123900FFE014    	   924:     move.b  (m_sq0_off).l,D1
02:000009BC 523900FFE014    	   925:     addq.b  #1,(m_sq0_off).l
02:000009C2 10301000        	   926:     move.b  (A0,D1.w),D0
                            	   927: .play:
02:000009C6 610001BA        	   928:     bsr     emit_note_sq0
02:000009CA 13F900FFE01600FF	   929:     move.b  (m_sq0_len).l,(m_sq0_cnt).l
02:000009D2 E015
                            	   930:     bra     tick_trg
                            	   931: 
                            	   932: ;==============================================================================
                            	   933: ; tick_trg — Triangle channel update (handles $F0/$F1-$FF passage ops)
                            	   934: ;==============================================================================
                            	   935: tick_trg:
02:000009D4 4A3900FFE01C    	   936:     tst.b   (m_trg_off).l
02:000009DA 6700009E        	   937:     beq     tick_noise
02:000009DE 533900FFE01D    	   938:     subq.b  #1,(m_trg_cnt).l
02:000009E4 66000094        	   939:     bne     tick_noise
                            	   940: .prep_note_or_passage:
02:000009E8 207900FFE008    	   941:     move.l  (m_script_ptr).l,A0
02:000009EE 7200            	   942:     moveq   #0,D1
02:000009F0 123900FFE01C    	   943:     move.b  (m_trg_off).l,D1
02:000009F6 523900FFE01C    	   944:     addq.b  #1,(m_trg_off).l
02:000009FC 10301000        	   945:     move.b  (A0,D1.w),D0
02:00000A00 676A            	   946:     beq.s   .silence_trg                  ; $00 → silence triangle this step
02:00000A02 4A00            	   947:     tst.b   D0
02:00000A04 6A56            	   948:     bpl.s   .play_note_trg                ; direct note
02:00000A06 0C0000F0        	   949:     cmpi.b  #$F0,D0
02:00000A0A 6718            	   950:     beq.s   .end_of_passage
02:00000A0C 652A            	   951:     bcs.s   .prep_note_trg                ; $80-$EF → control
                            	   952:     ; $F1-$FF → start passage
02:00000A0E 040000F0        	   953:     subi.b  #$F0,D0
02:00000A12 13C000FFE021    	   954:     move.b  D0,(m_trg_rep_n).l
02:00000A18 13F900FFE01C00FF	   955:     move.b  (m_trg_off).l,(m_trg_rep_s).l
02:00000A20 E022
02:00000A22 60C4            	   956:     bra.s   .prep_note_or_passage
                            	   957: .end_of_passage:
02:00000A24 533900FFE021    	   958:     subq.b  #1,(m_trg_rep_n).l
02:00000A2A 670A            	   959:     beq.s   .pass_done
02:00000A2C 13F900FFE02200FF	   960:     move.b  (m_trg_rep_s).l,(m_trg_off).l
02:00000A34 E01C
                            	   961: .pass_done:
02:00000A36 60B0            	   962:     bra.s   .prep_note_or_passage
                            	   963: .prep_note_trg:
02:00000A38 610000D0        	   964:     bsr     get_song_note_length
02:00000A3C 13C000FFE01E    	   965:     move.b  D0,(m_trg_len).l
02:00000A42 207900FFE008    	   966:     move.l  (m_script_ptr).l,A0
02:00000A48 7200            	   967:     moveq   #0,D1
02:00000A4A 123900FFE01C    	   968:     move.b  (m_trg_off).l,D1
02:00000A50 523900FFE01C    	   969:     addq.b  #1,(m_trg_off).l
02:00000A56 10301000        	   970:     move.b  (A0,D1.w),D0
02:00000A5A 6710            	   971:     beq.s   .silence_trg
                            	   972: .play_note_trg:
02:00000A5C 61000182        	   973:     bsr     emit_note_trg
02:00000A60 13F900FFE01E00FF	   974:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000A68 E01D
02:00000A6A 600E            	   975:     bra     tick_noise
                            	   976: .silence_trg:
02:00000A6C 610001E6        	   977:     bsr     key_off_trg
02:00000A70 13F900FFE01E00FF	   978:     move.b  (m_trg_len).l,(m_trg_cnt).l
02:00000A78 E01D
                            	   979:     bra     tick_noise
                            	   980: 
                            	   981: ;==============================================================================
                            	   982: ; tick_noise — PSG noise channel (demo/ending/overworld only)
                            	   983: ;==============================================================================
                            	   984: tick_noise:
02:00000A7A 103900FFE000    	   985:     move.b  (m_song).l,D0
02:00000A80 02000091        	   986:     andi.b  #$91,D0
02:00000A84 67000082        	   987:     beq     .tn_done
                            	   988:     ; Always run the per-tick envelope decay step, regardless of whether a new
                            	   989:     ; drum hit fires this frame.  set_psg_noise will overwrite the envelope if
                            	   990:     ; a hit fires below.
02:00000A88 61000250        	   991:     bsr     noise_decay_tick
02:00000A8C 533900FFE025    	   992:     subq.b  #1,(m_noise_cnt).l
02:00000A92 6674            	   993:     bne     .tn_done
                            	   994: .read:
02:00000A94 207900FFE008    	   995:     move.l  (m_script_ptr).l,A0
02:00000A9A 7200            	   996:     moveq   #0,D1
02:00000A9C 123900FFE024    	   997:     move.b  (m_noise_off).l,D1
02:00000AA2 523900FFE024    	   998:     addq.b  #1,(m_noise_off).l
02:00000AA8 10301000        	   999:     move.b  (A0,D1.w),D0
02:00000AAC 660C            	  1000:     bne.s   .got
02:00000AAE 13F900FFE00600FF	  1001:     move.b  (m_noise_first).l,(m_noise_off).l
02:00000AB6 E024
02:00000AB8 60DA            	  1002:     bra.s   .read
                            	  1003: .got:
02:00000ABA 1800            	  1004:     move.b  D0,D4                         ; preserve control note for length calc
                            	  1005:     ; Length via GetSongNoiseNoteLength: rotate control note bits then AND #$07
                            	  1006:     ; Original: ROR (through C), ROL, ROL, ROL, AND #$07, ADC NoteLengthTableBase
                            	  1007:     ; Net effect: reorders to "low 3 bits of rotated" which is bits (2,1,0) ←
                            	  1008:     ; (0,7,6). For our port we replicate exactly.
02:00000ABC 7400            	  1009:     moveq   #0,D2
02:00000ABE 1404            	  1010:     move.b  D4,D2
                            	  1011:     ; We need bit0→2, bit7→1, bit6→0 of the original → into D0 bits 2,1,0.
02:00000AC0 7000            	  1012:     moveq   #0,D0
02:00000AC2 08020000        	  1013:     btst    #0,D2
02:00000AC6 6704            	  1014:     beq.s   .b0
02:00000AC8 08C00002        	  1015:     bset    #2,D0
                            	  1016: .b0:
02:00000ACC 08020007        	  1017:     btst    #7,D2
02:00000AD0 6704            	  1018:     beq.s   .b7
02:00000AD2 08C00001        	  1019:     bset    #1,D0
                            	  1020: .b7:
02:00000AD6 08020006        	  1021:     btst    #6,D2
02:00000ADA 6704            	  1022:     beq.s   .b6
02:00000ADC 08C00000        	  1023:     bset    #0,D0
                            	  1024: .b6:
02:00000AE0 7200            	  1025:     moveq   #0,D1
02:00000AE2 123900FFE003    	  1026:     move.b  (m_len_base).l,D1
02:00000AE8 D240            	  1027:     add.w   D0,D1
02:00000AEA 43F900000D8C    	  1028:     lea     (NoteLengthTables).l,A1
02:00000AF0 13F1100000FFE025	  1029:     move.b  (A1,D1.w),(m_noise_cnt).l
                            	  1030:     ; Extract index 0-3: (note AND #$3E) >> 4
02:00000AF8 1004            	  1031:     move.b  D4,D0
02:00000AFA 0200003E        	  1032:     andi.b  #$3E,D0
02:00000AFE E808            	  1033:     lsr.b   #4,D0
02:00000B00 7200            	  1034:     moveq   #0,D1
02:00000B02 1200            	  1035:     move.b  D0,D1
                            	  1036:     ; Map to PSG noise: set volume + period
02:00000B04 6100015A        	  1037:     bsr     set_psg_noise
                            	  1038: .tn_done:
02:00000B08 4E75            	  1039:     rts
                            	  1040: 
                            	  1041: ;==============================================================================
                            	  1042: ; get_song_note_length — equivalent to GetSongNoteLength
                            	  1043: ; Input: D0 = control byte → Output: D0 = length
                            	  1044: ;==============================================================================
                            	  1045: get_song_note_length:
02:00000B0A 02400007        	  1046:     andi.w  #$07,D0
02:00000B0E 7200            	  1047:     moveq   #0,D1
02:00000B10 123900FFE003    	  1048:     move.b  (m_len_base).l,D1
02:00000B16 D240            	  1049:     add.w   D0,D1
02:00000B18 43F900000D8C    	  1050:     lea     (NoteLengthTables).l,A1
02:00000B1E 10311000        	  1051:     move.b  (A1,D1.w),D0
02:00000B22 4E75            	  1052:     rts
                            	  1053: 
                            	  1054: ;==============================================================================
                            	  1055: ; emit_note_sq1 — Play a note on YM ch 0 (Pulse 1 slot)
                            	  1056: ; Input: D0.b = note id (even byte offset into MusicNotePeriodTable)
                            	  1057: ;==============================================================================
                            	  1058: emit_note_sq1:
02:00000B24 024000FF        	  1059:     andi.w  #$FF,D0
02:00000B28 43F900000D1A    	  1060:     lea     (MusicNotePeriodTable).l,A1
02:00000B2E 7400            	  1061:     moveq   #0,D2
02:00000B30 14310001        	  1062:     move.b  1(A1,D0.w),D2                 ; lo
02:00000B34 67000106        	  1063:     beq     key_off_sq1                    ; lo=0 → rest → key off
02:00000B38 7600            	  1064:     moveq   #0,D3
02:00000B3A 16310000        	  1065:     move.b  0(A1,D0.w),D3                 ; hi
02:00000B3E E14B            	  1066:     lsl.w   #8,D3
02:00000B40 8642            	  1067:     or.w    D2,D3                          ; D3.w = period
02:00000B42 024307FF        	  1068:     andi.w  #$07FF,D3
02:00000B46 13C200FFE010    	  1069:     move.b  D2,(m_sq1_per).l              ; save low period for vibrato
02:00000B4C 3403            	  1070:     move.w  D3,D2
02:00000B4E 263C00021986    	  1071:     move.l  #NES_YM_K5_PULSE,D3
02:00000B54 6100F8AC        	  1072:     bsr     nes_to_ym_freq                ; D2=A4val, D3=A0val
                            	  1073:     ; Key off first so the next key-on retriggers envelopes from attack
02:00000B58 103C0028        	  1074:     move.b  #$28,D0
02:00000B5C 7200            	  1075:     moveq   #$00,D1                        ; ch 0, all ops off
02:00000B5E 6100F85A        	  1076:     bsr     ym_write1
02:00000B62 103C00A4        	  1077:     move.b  #$A4,D0                        ; ch 0 freq high
02:00000B66 1202            	  1078:     move.b  D2,D1
02:00000B68 6100F850        	  1079:     bsr     ym_write1
02:00000B6C 103C00A0        	  1080:     move.b  #$A0,D0                        ; ch 0 freq low
02:00000B70 1203            	  1081:     move.b  D3,D1
02:00000B72 6100F846        	  1082:     bsr     ym_write1
                            	  1083:     ; Key on ch 0, all ops
02:00000B76 103C0028        	  1084:     move.b  #$28,D0
02:00000B7A 123C00F0        	  1085:     move.b  #$F0,D1
02:00000B7E 6000F83A        	  1086:     bra     ym_write1
                            	  1087: 
                            	  1088: ;==============================================================================
                            	  1089: ; emit_note_sq0 — Play a note on YM ch 1 (Pulse 2 slot)
                            	  1090: ;==============================================================================
                            	  1091: emit_note_sq0:
02:00000B82 024000FF        	  1092:     andi.w  #$FF,D0
02:00000B86 43F900000D1A    	  1093:     lea     (MusicNotePeriodTable).l,A1
02:00000B8C 7400            	  1094:     moveq   #0,D2
02:00000B8E 14310001        	  1095:     move.b  1(A1,D0.w),D2
02:00000B92 670000B4        	  1096:     beq     key_off_sq0
02:00000B96 7600            	  1097:     moveq   #0,D3
02:00000B98 16310000        	  1098:     move.b  0(A1,D0.w),D3
02:00000B9C E14B            	  1099:     lsl.w   #8,D3
02:00000B9E 8642            	  1100:     or.w    D2,D3
02:00000BA0 024307FF        	  1101:     andi.w  #$07FF,D3
02:00000BA4 13C200FFE018    	  1102:     move.b  D2,(m_sq0_per).l
02:00000BAA 3403            	  1103:     move.w  D3,D2
02:00000BAC 263C00021986    	  1104:     move.l  #NES_YM_K5_PULSE,D3
02:00000BB2 6100F84E        	  1105:     bsr     nes_to_ym_freq
                            	  1106:     ; Key off first so the envelope attack phase retriggers
02:00000BB6 103C0028        	  1107:     move.b  #$28,D0
02:00000BBA 7201            	  1108:     moveq   #$01,D1                        ; ch 1 all ops off
02:00000BBC 6100F7FC        	  1109:     bsr     ym_write1
02:00000BC0 103C00A5        	  1110:     move.b  #$A5,D0                        ; ch 1 freq high
02:00000BC4 1202            	  1111:     move.b  D2,D1
02:00000BC6 6100F7F2        	  1112:     bsr     ym_write1
02:00000BCA 103C00A1        	  1113:     move.b  #$A1,D0                        ; ch 1 freq low
02:00000BCE 1203            	  1114:     move.b  D3,D1
02:00000BD0 6100F7E8        	  1115:     bsr     ym_write1
02:00000BD4 103C0028        	  1116:     move.b  #$28,D0
02:00000BD8 123C00F1        	  1117:     move.b  #$F1,D1
02:00000BDC 6000F7DC        	  1118:     bra     ym_write1
                            	  1119: 
                            	  1120: ;==============================================================================
                            	  1121: ; emit_note_trg — Play a note on YM ch 2 (triangle slot, octave lower)
                            	  1122: ;==============================================================================
                            	  1123: emit_note_trg:
02:00000BE0 024000FF        	  1124:     andi.w  #$FF,D0
02:00000BE4 43F900000D1A    	  1125:     lea     (MusicNotePeriodTable).l,A1
02:00000BEA 7400            	  1126:     moveq   #0,D2
02:00000BEC 14310001        	  1127:     move.b  1(A1,D0.w),D2
02:00000BF0 6762            	  1128:     beq     key_off_trg
02:00000BF2 7600            	  1129:     moveq   #0,D3
02:00000BF4 16310000        	  1130:     move.b  0(A1,D0.w),D3
02:00000BF8 E14B            	  1131:     lsl.w   #8,D3
02:00000BFA 8642            	  1132:     or.w    D2,D3
02:00000BFC 024307FF        	  1133:     andi.w  #$07FF,D3
02:00000C00 13C200FFE020    	  1134:     move.b  D2,(m_trg_per).l
02:00000C06 3403            	  1135:     move.w  D3,D2
02:00000C08 263C00010CC3    	  1136:     move.l  #NES_YM_K5_TRI,D3
02:00000C0E 6100F7F2        	  1137:     bsr     nes_to_ym_freq
                            	  1138:     ; Key off first so the bass envelope retriggers per note
02:00000C12 103C0028        	  1139:     move.b  #$28,D0
02:00000C16 7202            	  1140:     moveq   #$02,D1                        ; ch 2 all ops off
02:00000C18 6100F7A0        	  1141:     bsr     ym_write1
02:00000C1C 103C00A6        	  1142:     move.b  #$A6,D0                        ; ch 2 freq high
02:00000C20 1202            	  1143:     move.b  D2,D1
02:00000C22 6100F796        	  1144:     bsr     ym_write1
02:00000C26 103C00A2        	  1145:     move.b  #$A2,D0                        ; ch 2 freq low
02:00000C2A 1203            	  1146:     move.b  D3,D1
02:00000C2C 6100F78C        	  1147:     bsr     ym_write1
02:00000C30 103C0028        	  1148:     move.b  #$28,D0
02:00000C34 123C00F2        	  1149:     move.b  #$F2,D1
02:00000C38 6000F780        	  1150:     bra     ym_write1
                            	  1151: 
                            	  1152: ;==============================================================================
                            	  1153: ; key_off_{sq1,sq0,trg} — silence the channel without reloading freq
                            	  1154: ;==============================================================================
                            	  1155: key_off_sq1:
02:00000C3C 103C0028        	  1156:     move.b  #$28,D0
02:00000C40 123C0000        	  1157:     move.b  #$00,D1
02:00000C44 6000F774        	  1158:     bra     ym_write1
                            	  1159: key_off_sq0:
02:00000C48 103C0028        	  1160:     move.b  #$28,D0
02:00000C4C 123C0001        	  1161:     move.b  #$01,D1
02:00000C50 6000F768        	  1162:     bra     ym_write1
                            	  1163: key_off_trg:
02:00000C54 103C0028        	  1164:     move.b  #$28,D0
02:00000C58 123C0002        	  1165:     move.b  #$02,D1
02:00000C5C 6000F75C        	  1166:     bra     ym_write1
                            	  1167: 
                            	  1168: ;==============================================================================
                            	  1169: ; set_psg_noise — Trigger a drum hit on the PSG noise channel.
                            	  1170: ; Input: D1.w = drum index 0-3 (engine index, extracted from noise script byte)
                            	  1171: ;
                            	  1172: ; Pattern lifted from Kroc's Sonic 1 SMS disassembly (Z80 → M68K):
                            	  1173: ;   - Each drum has a (noise_mode, attack_level, decay_rate) entry in
                            	  1174: ;     PsgDrumTable.
                            	  1175: ;   - The noise control byte is ONLY written when it differs from the cached
                            	  1176: ;     last-written byte — writing it re-seeds the SN76489 LFSR which would
                            	  1177: ;     otherwise chop off the decay tail of an in-flight hit.
                            	  1178: ;   - Envelope level is reset to the attack_level; per-tick decay is done by
                            	  1179: ;     noise_decay_tick.
                            	  1180: ;   - Index 0 is treated as a rest: volume goes to mute but the noise control
                            	  1181: ;     latch is untouched so pending decays on adjacent channels are preserved.
                            	  1182: ;==============================================================================
                            	  1183: set_psg_noise:
                            	  1184:     ; SFX arbitration: if Zelda's SFX engine has an active hit ($0606 != 0),
                            	  1185:     ; skip music drum writes so the SFX owns PSG ch 3. When the SFX ends,
                            	  1186:     ; music drums resume on the next beat.
02:00000C60 4A3900FF0606    	  1187:     tst.b   ($00FF0606).l
02:00000C66 661A            	  1188:     bne.s   .sfx_owns_psg
02:00000C68 4A01            	  1189:     tst.b   D1
02:00000C6A 6618            	  1190:     bne.s   .not_rest
                            	  1191:     ; Rest: silence the PSG noise channel immediately.
02:00000C6C 423900FFE026    	  1192:     clr.b   (m_noise_level).l
02:00000C72 423900FFE027    	  1193:     clr.b   (m_noise_decay).l
02:00000C78 13FC00FF00C00011	  1194:     move.b  #$FF,(PSG_PORT).l              ; ch3 attenuation = max (mute)
02:00000C80 4E75            	  1195:     rts
                            	  1196: .sfx_owns_psg:
02:00000C82 4E75            	  1197:     rts
                            	  1198: .not_rest:
02:00000C84 7000            	  1199:     moveq   #0,D0
02:00000C86 1001            	  1200:     move.b  D1,D0
02:00000C88 E548            	  1201:     lsl.w   #2,D0                          ; 4 bytes per drum entry
02:00000C8A 43F900000DC0    	  1202:     lea     (PsgDrumTable).l,A1
02:00000C90 D3C0            	  1203:     adda.l  D0,A1
02:00000C92 1019            	  1204:     move.b  (A1)+,D0                       ; byte 0: noise control byte ($Ex)
                            	  1205:     ; Write control byte only if different from cached value (preserves LFSR).
02:00000C94 B03900FFE028    	  1206:     cmp.b   (m_last_psg_nc).l,D0
02:00000C9A 670C            	  1207:     beq.s   .nc_same
02:00000C9C 13C000FFE028    	  1208:     move.b  D0,(m_last_psg_nc).l
02:00000CA2 13C000C00011    	  1209:     move.b  D0,(PSG_PORT).l
                            	  1210: .nc_same:
02:00000CA8 1019            	  1211:     move.b  (A1)+,D0                       ; byte 1: attack level ($00-$FF)
02:00000CAA 13C000FFE026    	  1212:     move.b  D0,(m_noise_level).l
02:00000CB0 1019            	  1213:     move.b  (A1)+,D0                       ; byte 2: decay rate per tick
02:00000CB2 13C000FFE027    	  1214:     move.b  D0,(m_noise_decay).l
                            	  1215:     bra     write_psg_noise_vol
                            	  1216: 
                            	  1217: ;==============================================================================
                            	  1218: ; write_psg_noise_vol — emit PSG ch3 attenuation from the software envelope.
                            	  1219: ; Uses m_noise_level (8-bit) → 4-bit PSG atten by shifting and inverting.
                            	  1220: ; Preserves D1.
                            	  1221: ;==============================================================================
                            	  1222: write_psg_noise_vol:
02:00000CB8 4A3900FF0606    	  1223:     tst.b   ($00FF0606).l                  ; SFX owns PSG?
02:00000CBE 6618            	  1224:     bne.s   .wpnv_skip
02:00000CC0 7000            	  1225:     moveq   #0,D0
02:00000CC2 103900FFE026    	  1226:     move.b  (m_noise_level).l,D0
02:00000CC8 E808            	  1227:     lsr.b   #4,D0                          ; level $00-$FF → 0-15
02:00000CCA 0A00000F        	  1228:     eori.b  #$0F,D0                        ; invert: SN76489 0=loud, 15=silent
02:00000CCE 000000F0        	  1229:     ori.b   #$F0,D0                        ; ch3 attenuation latch
02:00000CD2 13C000C00011    	  1230:     move.b  D0,(PSG_PORT).l
                            	  1231: .wpnv_skip:
02:00000CD8 4E75            	  1232:     rts
                            	  1233: 
                            	  1234: ;==============================================================================
                            	  1235: ; noise_decay_tick — linear envelope decay step.
                            	  1236: ; Called every music tick (before any new-hit check) to fade the current drum
                            	  1237: ; toward silence.  Underflow clamps to 0 so the envelope stops.
                            	  1238: ; Preserves D1.
                            	  1239: ;==============================================================================
                            	  1240: noise_decay_tick:
02:00000CDA 4A3900FF0606    	  1241:     tst.b   ($00FF0606).l                   ; SFX owns PSG?
02:00000CE0 661A            	  1242:     bne.s   .nd_done
02:00000CE2 103900FFE026    	  1243:     move.b  (m_noise_level).l,D0
02:00000CE8 6712            	  1244:     beq.s   .nd_done                        ; already silent
02:00000CEA 903900FFE027    	  1245:     sub.b   (m_noise_decay).l,D0
02:00000CF0 6402            	  1246:     bcc.s   .nd_store                       ; no underflow → new level
02:00000CF2 7000            	  1247:     moveq   #0,D0                           ; underflow → silent
                            	  1248: .nd_store:
02:00000CF4 13C000FFE026    	  1249:     move.b  D0,(m_noise_level).l
02:00000CFA 60BC            	  1250:     bra     write_psg_noise_vol
                            	  1251: .nd_done:
02:00000CFC 4E75            	  1252:     rts
                            	  1253: 
                            	  1254: ;==============================================================================
                            	  1255: ; music_silence — Full silence: key-off all channels, clear song state
                            	  1256: ;==============================================================================
                            	  1257: music_silence:
02:00000CFE 423900FFE000    	  1258:     clr.b   (m_song).l
02:00000D04 6100FF36        	  1259:     bsr     key_off_sq1
02:00000D08 6100FF3E        	  1260:     bsr     key_off_sq0
02:00000D0C 6100FF46        	  1261:     bsr     key_off_trg
02:00000D10 13FC00FF00C00011	  1262:     move.b  #$FF,(PSG_PORT).l              ; PSG noise mute
02:00000D18 4E75            	  1263:     rts
                            	  1264: 
