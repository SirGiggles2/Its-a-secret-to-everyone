02:00031EDE 41F900031EAA    	  3876:     lea     (DoorwayBoundsMinOver).l,A0
02:00031EE4 12303000        	  3877:     move.b  (A0,D3.W),D1
02:00031EE8 B001            	  3878:     cmp.b   D1,D0
02:00031EEA 6510            	  3879:     bcs  _anon_z05_95
02:00031EEC 41F900031EAE    	  3880:     lea     (DoorwayBoundsMaxOver).l,A0
02:00031EF2 12303000        	  3881:     move.b  (A0,D3.W),D1
02:00031EF6 B001            	  3882:     cmp.b   D1,D0
02:00031EF8 65000082        	  3883:     bcs  _L_z05_CheckDoorway_TestDoorwayDoor
