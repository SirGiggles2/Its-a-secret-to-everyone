02:000341EE 10302000        	  6958:     move.b  (A0,D2.W),D0
02:000341F2 19400001        	  6959:     move.b  D0,($0001,A4)
02:000341F6 101D            	  6960:     move.b  (A5)+,D0  ; PLA
02:000341F8 1B00            	  6961:     move.b  D0,-(A5)  ; PHA
02:000341FA 7400            	  6962:     moveq   #0,D2
02:000341FC 1400            	  6963:     move.b  D0,D2
                            	  6964:     ; Align the object's Y coordinate with 16 pixels.
                            	  6965:     ;
02:000341FE 41EC0084        	  6966:     lea     ($0084,A4),A0
02:00034202 10302000        	  6967:     move.b  (A0,D2.W),D0
02:00034206 020000F0        	  6968:     andi.b #$F0,D0
                            	  6969:     ; Subtract $40 for the status bar; and divide by 8 for
                            	  6970:     ; the height of each row.
                            	  6971:     ;
02:0003420A 003C0011        	  6972:     ori     #$11,CCR  ; SEC: set C+X
02:0003420E 123C0040        	  6973:     move.b  #$40,D1
02:00034212 0A3C0010        	  6974:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00034216 9101            	  6975:     subx.b  D1,D0   ; SBC #$40
02:00034218 0A3C0010        	  6976:     eori    #$10,CCR  ; restore X = 6502 C
02:0003421C E208            	  6977:     lsr.b  #1,D0   ; LSR A
02:0003421E E208            	  6978:     lsr.b  #1,D0   ; LSR A
02:00034220 E208            	  6979:     lsr.b  #1,D0   ; LSR A
                            	  6980:     ; Add this row offset to the column address.
                            	  6981:     ;
02:00034222 4EB900024328    	  6982:     jsr     AddToInt16At0
                            	  6983:     ; Assume that we'll write a type 1 square with primary square
                            	  6984:     ; taken from [05]. If so, the square index doesn't matter
                            	  6985:     ; as long as >= $10. See WriteSquareOW.
                            	  6986:     ;
02:00034228 7600            	  6987:     moveq   #0,D3
02:0003422A 7410            	  6988:     moveq   #16,D2
02:0003422C 102C0005        	  6989:     move.b  ($0005,A4),D0
                            	  6990:     ; If tile < $27 or >= $F3, we'll write a type 3 square.
                            	  6991:     ; So, we have to look up the square index corresponding
                            	  6992:     ; to primary square/tile in [05].
                            	  6993:     ;
                            	  6994:     ; Look in primary square table from $E to 1. If a match is found,
                            	  6995:     ; then the X register will have the square index value.
                            	  6996:     ;
02:00034230 0C000027        	  6997:     cmpi.b  #$27,D0
