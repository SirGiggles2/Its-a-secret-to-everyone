                            	  3135:     ; Look for this room's ID in the 6-element cellar room array.
                            	  3136:     ;
02:000319F2 7606            	  3137:     moveq   #6,D3
02:000319F4 102C00EB        	  3138:     move.b  ($00EB,A4),D0
02:000319F8 1B00            	  3139:     move.b  D0,-(A5)  ; PHA
                            	  3140: _anon_z05_81:
02:000319FA 5303            	  3141:     subq.b  #1,D3
02:000319FC 41F900FF6BB2    	  3142:     lea     (NES_SRAM+$0BB2).l,A0
02:00031A02 12303000        	  3143:     move.b  (A0,D3.W),D1
02:00031A06 B001            	  3144:     cmp.b   D1,D0
02:00031A08 66F0            	  3145:     bne  _anon_z05_81
                            	  3146:     ; Determine the destination room ID, and go there.
