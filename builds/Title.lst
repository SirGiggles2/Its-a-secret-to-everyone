02:00022B9A 41EC046F        	   447:     lea     ($046F,A4),A0
02:00022B9E 10303000        	   448:     move.b  (A0,D3.W),D0
02:00022BA2 41EC0448        	   449:     lea     ($0448,A4),A0
02:00022BA6 11802000        	   450:     move.b  D0,(A0,D2.W)
02:00022BAA 5302            	   451:     subq.b  #1,D2
02:00022BAC 6AE2            	   452:     bpl  _L_z01_InitCaveContinue_ArrangeAmounts
                            	   453:     even
