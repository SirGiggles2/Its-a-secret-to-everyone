                            	  5510:     ; If in the bottom half, align with the next square.
                            	  5511:     ;
02:0002E016 41EC0084        	  5512:     lea     ($0084,A4),A0
02:0002E01A 10302000        	  5513:     move.b  (A0,D2.W),D0
02:0002E01E 023C00EE        	  5514:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002E022 123C0008        	  5515:     move.b  #$08,D1
02:0002E026 D101            	  5516:     addx.b  D1,D0   ; ADC #$08 (X flag = 6502 C)
