02:0002F546 610000B6        	  8387:     jsr     Ganon_GetCurCloudLeft
02:0002F54A 610000BE        	  8388:     jsr     Ganon_GetCurCloudTop
02:0002F54E 61A0            	  8389:     jsr     Ganon_DrawCloud
02:0002F550 610000B2        	  8390:     jsr     Ganon_GetCurCloudRight
02:0002F554 619A            	  8391:     jsr     Ganon_DrawCloud
02:0002F556 610000A6        	  8392:     jsr     Ganon_GetCurCloudLeft
02:0002F55A 610000B4        	  8393:     jsr     Ganon_GetCurCloudBottom
