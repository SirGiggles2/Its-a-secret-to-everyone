                            	  5428: UpdatePolsVoiceState1_Jumping:
                            	  5429:     ; Add acceleration $38 to low speed byte (vertical).
                            	  5430:     ;
02:0002DF4A 41EC0444        	  5431:     lea     ($0444,A4),A0
02:0002DF4E 10302000        	  5432:     move.b  (A0,D2.W),D0
02:0002DF52 023C00EE        	  5433:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DF56 123C0038        	  5434:     move.b  #$38,D1
02:0002DF5A D101            	  5435:     addx.b  D1,D0   ; ADC #$38 (X flag = 6502 C)
02:0002DF5C 41EC0444        	  5436:     lea     ($0444,A4),A0
02:0002DF60 11802000        	  5437:     move.b  D0,(A0,D2.W)
                            	  5438:     ; Add Carry to high speed byte (vertical).
                            	  5439:     ;
02:0002DF64 41EC0412        	  5440:     lea     ($0412,A4),A0
02:0002DF68 10302000        	  5441:     move.b  (A0,D2.W),D0
02:0002DF6C 123C0000        	  5442:     move.b  #$00,D1
02:0002DF70 D101            	  5443:     addx.b  D1,D0   ; ADC #$00 (X flag = 6502 C)
02:0002DF72 41EC0412        	  5444:     lea     ($0412,A4),A0
02:0002DF76 11802000        	  5445:     move.b  D0,(A0,D2.W)
                            	  5446:     ; Add high speed byte to Y coordinate.
                            	  5447:     ;
02:0002DF7A 023C00EE        	  5448:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DF7E 41EC0084        	  5449:     lea     ($0084,A4),A0
02:0002DF82 12302000        	  5450:     move.b  (A0,D2.W),D1
02:0002DF86 D101            	  5451:     addx.b  D1,D0   ; ADC ObjY,X
02:0002DF88 41EC0084        	  5452:     lea     ($0084,A4),A0
02:0002DF8C 11802000        	  5453:     move.b  D0,(A0,D2.W)
                            	  5454:     ; If the speed is still negative, then return.
                            	  5455:     ;
