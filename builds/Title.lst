02:000019FE 7000            	   487:     moveq   #0,D0
02:00001A00 102C00FD        	   488:     move.b  ($00FD,A4),D0              ; CurHScroll
02:00001A04 4440            	   489:     neg.w   D0
02:00001A06 024001FF        	   490:     andi.w  #$01FF,D0
02:00001A0A 23FC7C00000300C0	   491:     move.l  #$7C000003,(VDP_CTRL).l    ; VRAM write at $FC00
02:00001A12 0004
02:00001A14 33C000C00000    	   492:     move.w  D0,(VDP_DATA).l            ; Plane A H-scroll
02:00001A1A 7000            	   493:     moveq   #0,D0
02:00001A1C 33C000C00000    	   494:     move.w  D0,(VDP_DATA).l            ; Plane B H-scroll = 0
02:00001A22 4CDF001F        	   495:     movem.l (SP)+,D0-D4
02:00001A26 4E75            	   496:     rts
