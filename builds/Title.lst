02:0002F228 162C045F        	  7917:     move.b  ($045F,A4),D3
                            	  7918:     ; If the monster is Patra Child 1 ($25), then look up two separate
                            	  7919:     ; counts of bits to use for Y and X increment calculations in rotation.
                            	  7920:     ; This leads to a large circle (6,6) and a wobbling ring (5,6).
                            	  7921:     ;
02:0002F22C 41EC034F        	  7922:     lea     ($034F,A4),A0
02:0002F230 10302000        	  7923:     move.b  (A0,D2.W),D0
02:0002F234 0C000025        	  7924:     cmpi.b  #$25,D0
02:0002F238 661E            	  7925:     bne  _L_z04_PatraChild_State1_UsePatraChild2Bits
02:0002F23A 41F90002F12C    	  7926:     lea     (PatraChild1RotationCosineBits).l,A0
02:0002F240 10303000        	  7927:     move.b  (A0,D3.W),D0
02:0002F244 1B00            	  7928:     move.b  D0,-(A5)  ; PHA
02:0002F246 41F90002F130    	  7929:     lea     (PatraChild1RotationSineBits).l,A0
02:0002F24C 10303000        	  7930:     move.b  (A0,D3.W),D0
02:0002F250 7600            	  7931:     moveq   #0,D3
02:0002F252 1600            	  7932:     move.b  D0,D3
02:0002F254 101D            	  7933:     move.b  (A5)+,D0  ; PLA
02:0002F256 600E            	  7934:     jmp     _L_z04_PatraChild_State1_Rotate
                            	  7935: 
                            	  7936:     even
                            	  7937: _L_z04_PatraChild_State1_UsePatraChild2Bits:
                            	  7938:     ; Else it's Patra Child 2 ($26). Look up one value that will be used
                            	  7939:     ; for both Y and X increment calculations in rotation. This leads to
                            	  7940:     ; a small circle (5) and a large circle (6).
                            	  7941:     ;
02:0002F258 41F90002F12E    	  7942:     lea     (PatraChild2RotationBits).l,A0
02:0002F25E 10303000        	  7943:     move.b  (A0,D3.W),D0
02:0002F262 7600            	  7944:     moveq   #0,D3
02:0002F264 1600            	  7945:     move.b  D0,D3
                            	  7946:     even
                            	  7947: _L_z04_PatraChild_State1_Rotate:
02:0002F266 61000ACC        	  7948:     jsr     RotateObjectLocation
02:0002F26A 41EC0084        	  7949:     lea     ($0084,A4),A0
02:0002F26E 11802000        	  7950:     move.b  D0,(A0,D2.W)
02:0002F272 611C            	  7951:     jsr     PatraChild_Draw
                            	  7952:     ; If Patra's state still = 0, then the last patra child has not
                            	  7953:     ; shown up yet. In this case don't check collisions yet, only return.
                            	  7954:     ;
02:0002F274 102C00AD        	  7955:     move.b  ($00AD,A4),D0
02:0002F278 6714            	  7956:     beq  _L_z04_PatraChild_State1_Exit
02:0002F27A 4EB9000249E0    	  7957:     jsr     CheckMonsterCollisions
                            	  7958:     ; If the monster died, then change to the dead dummy object.
                            	  7959:     ;
02:0002F280 41EC0405        	  7960:     lea     ($0405,A4),A0
02:0002F284 10302000        	  7961:     move.b  (A0,D2.W),D0
02:0002F288 6704            	  7962:     beq  _L_z04_PatraChild_State1_Exit
02:0002F28A 6100FDD4        	  7963:     jsr     SetDeadDummyObjType
                            	  7964:     even
                            	  7965: _L_z04_PatraChild_State1_Exit:
02:0002F28E 4E75            	  7966:     rts
                            	  7967: 
