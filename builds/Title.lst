02:0002DE26 67000084        	  5288:     beq  _L_z04_UpdatePolsVoice_SetState1
                            	  5289:     ; Decrement grid offset / distance remaining.
                            	  5290:     ;
02:0002DE2A 41EC0394        	  5291:     lea     ($0394,A4),A0
02:0002DE2E 53302000        	  5292:     subq.b  #1,(A0,D2.W)
                            	  5293:     ; Move vertically.
                            	  5294:     ; Add the Y offset for the current direction to the Y coordinate.
                            	  5295:     ;
02:0002DE32 41EC0084        	  5296:     lea     ($0084,A4),A0
02:0002DE36 10302000        	  5297:     move.b  (A0,D2.W),D0
02:0002DE3A 023C00EE        	  5298:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002DE3E 41F90002DDCE    	  5299:     lea     (PolsVoiceWalkSpeedsY).l,A0
02:0002DE44 12303000        	  5300:     move.b  (A0,D3.W),D1
