                            	  5908:     even
                            	  5909: LayoutUWFloor:
02:000337F0 7005            	  5910:     moveq   #5,D0
02:000337F2 4EB90001E25C    	  5911:     jsr     _copy_bank_to_window   ; PATCH P33b: force window bank 5
02:000337F8 61007260        	  5912:     jsr     GetUniqueRoomId
02:000337FC 1B00            	  5913:     move.b  D0,-(A5)  ; PHA
02:000337FE 7000            	  5914:     moveq   #0,D0
02:00033800 19400002        	  5915:     move.b  D0,($0002,A4)
02:00033804 7000            	  5916:     moveq   #0,D0
02:00033806 19400003        	  5917:     move.b  D0,($0003,A4)
02:0003380A 101D            	  5918:     move.b  (A5)+,D0  ; PLA
02:0003380C E308            	  5919:     lsl.b  #1,D0   ; ASL A
02:0003380E E308            	  5920:     lsl.b  #1,D0   ; ASL A
02:00033810 1880            	  5921:     move.b  D0,($0000,A4)
02:00033812 4EB900024330    	  5922:     jsr     AddToInt16At2
