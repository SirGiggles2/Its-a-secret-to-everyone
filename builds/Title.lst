02:0001EDC6 3005            	  3452:     move.w  D5,D0
02:0001EDC8 E048            	  3453:     lsr.w   #8,D0
02:0001EDCA EA48            	  3454:     lsr.w   #5,D0                   ; D0.w = raw palette id 0..3
02:0001EDCC 43F900FF1400    	  3455:     lea     (NT_ATTR_CACHE_BASE).l,A1
02:0001EDD2 7C00            	  3456:     moveq   #0,D6
02:0001EDD4 3C03            	  3457:     move.w  D3,D6
02:0001EDD6 EB4E            	  3458:     lsl.w   #5,D6
02:0001EDD8 DC42            	  3459:     add.w   D2,D6
02:0001EDDA 13806000        	  3460:     move.b  D0,(A1,D6.W)
02:0001EDDE 5246            	  3461:     addq.w  #1,D6
02:0001EDE0 13806000        	  3462:     move.b  D0,(A1,D6.W)
02:0001EDE4 0646001F        	  3463:     addi.w  #31,D6
02:0001EDE8 13806000        	  3464:     move.b  D0,(A1,D6.W)
02:0001EDEC 5246            	  3465:     addq.w  #1,D6
02:0001EDEE 13806000        	  3466:     move.b  D0,(A1,D6.W)
