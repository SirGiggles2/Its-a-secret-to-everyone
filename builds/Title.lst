02:00031A36 1600            	  3172:     move.b  D0,D3
02:00031A38 41F900FF697E    	  3173:     lea     (NES_SRAM+$097E).l,A0
02:00031A3E 10303000        	  3174:     move.b  (A0,D3.W),D0
