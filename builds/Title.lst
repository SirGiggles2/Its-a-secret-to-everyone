                            	  1308: 
                            	  1309: ;----------------------------------------------------------------------
                            	  1310: ; PsgDrumTable — 4 drum slots × 4 bytes each (Kroc Sonic 1 SMS pattern).
                            	  1311: ; Layout per slot:
                            	  1312: ;   +0 noise control byte ($Ex): bit2=FB (1=white), bits 1-0=NF shift rate
                            	  1313: ;   +1 attack level ($00-$FF): starting software-envelope level
                            	  1314: ;   +2 decay rate   (per tick): envelope subtracted each music_tick
                            	  1315: ;   +3 reserved
                            	  1316: ;
                            	  1317: ; Index 0 is the "rest" slot but set_psg_noise short-circuits it, so its
                            	  1318: ; values are placeholders.
                            	  1319: ;----------------------------------------------------------------------
                            	  1320: PsgDrumTable:
02:00000DC0 E7              	  1321:     dc.b    $E7, $00, $00, $00         ; 0: rest (handled by early-out)
02:00000DC1 00
02:00000DC2 00
02:00000DC3 00
02:00000DC4 E4              	  1322:     dc.b    $E4, $E0, 48,  $00         ; 1: hi-hat  — white NF=00, ~5 frames
02:00000DC5 E0
02:00000DC6 30
02:00000DC7 00
02:00000DC8 E5              	  1323:     dc.b    $E5, $FF, 14,  $00         ; 2: snare   — white NF=01, ~18 frames
02:00000DC9 FF
02:00000DCA 0E
02:00000DCB 00
02:00000DCC E4              	  1324:     dc.b    $E4, $E0, 48,  $00         ; 3: hi-hat alt
02:00000DCD E0
02:00000DCE 30
02:00000DCF 00
                            	  1325:     even
