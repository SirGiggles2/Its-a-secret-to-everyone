                            	  8508:     even
                            	  8509: _L_z04_Ganon_DrawBody_LoopCorner:
                            	  8510:     ; Add an offset to Ganon's X, and store the result in [00] -- the sprite's X.
                            	  8511:     ;
02:0002F63C 10342070        	  8512:     move.b  ($70,A4,D2.W),D0
02:0002F640 023C00EE        	  8513:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F644 41F90002F62E    	  8514:     lea     (GanonSpriteOffsetsX).l,A0
02:0002F64A 12303000        	  8515:     move.b  (A0,D3.W),D1
02:0002F64E D101            	  8516:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsX,Y
02:0002F650 1880            	  8517:     move.b  D0,($0000,A4)
                            	  8518:     ; Add an offset to Ganon's Y, and store the result in [01] -- the sprite's Y.
                            	  8519:     ;
02:0002F652 41EC0084        	  8520:     lea     ($0084,A4),A0
02:0002F656 10302000        	  8521:     move.b  (A0,D2.W),D0
02:0002F65A 023C00EE        	  8522:     andi    #$EE,CCR  ; CLC: clear C+X
02:0002F65E 41F90002F632    	  8523:     lea     (GanonSpriteOffsetsY).l,A0
02:0002F664 12303000        	  8524:     move.b  (A0,D3.W),D1
02:0002F668 D101            	  8525:     addx.b  D1,D0   ; ADC GanonSpriteOffsetsY,Y
02:0002F66A 19400001        	  8526:     move.b  D0,($0001,A4)
                            	  8527:     ; Each part has a horizontal flipping flag.
                            	  8528:     ;
02:0002F66E 41F90002F636    	  8529:     lea     (GanonSpriteHFlips).l,A0
02:0002F674 10303000        	  8530:     move.b  (A0,D3.W),D0
02:0002F678 1940000F        	  8531:     move.b  D0,($000F,A4)
                            	  8532:     ; Save and copy the loop index (the current part) to [07].
                            	  8533:     ;
02:0002F67C 1003            	  8534:     move.b  D3,D0
02:0002F67E 1B00            	  8535:     move.b  D0,-(A5)  ; PHA
02:0002F680 19400007        	  8536:     move.b  D0,($0007,A4)
                            	  8537:     ; Multiply the animation frame by 4, because of the 4 parts
                            	  8538:     ; that make it up.
                            	  8539:     ;
02:0002F684 41EC046B        	  8540:     lea     ($046B,A4),A0
02:0002F688 10302000        	  8541:     move.b  (A0,D2.W),D0
02:0002F68C E308            	  8542:     lsl.b  #1,D0   ; ASL A
02:0002F68E E308            	  8543:     lsl.b  #1,D0   ; ASL A
                            	  8544:     ; Add [07] -- the index of the current part.
                            	  8545:     ;
                            	  8546:     ; Now you have an index into the frame image table, for the
                            	  8547:     ; current image part of the current animation frame.
                            	  8548:     ;
02:0002F690 122C0007        	  8549:     move.b  ($0007,A4),D1
02:0002F694 D101            	  8550:     addx.b  D1,D0   ; ADC $07
02:0002F696 7600            	  8551:     moveq   #0,D3
02:0002F698 1600            	  8552:     move.b  D0,D3
02:0002F69A 41F90002F616    	  8553:     lea     (GanonFrameImages).l,A0
02:0002F6A0 10303000        	  8554:     move.b  (A0,D3.W),D0
02:0002F6A4 4EB900024674    	  8555:     jsr     DrawObjectNotMirrored
02:0002F6AA 101D            	  8556:     move.b  (A5)+,D0  ; PLA
                            	  8557:     ; Bottom of the part loop.
                            	  8558:     ;
02:0002F6AC 7600            	  8559:     moveq   #0,D3
02:0002F6AE 1600            	  8560:     move.b  D0,D3
02:0002F6B0 5303            	  8561:     subq.b  #1,D3
02:0002F6B2 6A88            	  8562:     bpl  _L_z04_Ganon_DrawBody_LoopCorner
02:0002F6B4 4E75            	  8563:     rts
