                            	  3536: FindNextEdgeSpawnCell:
                            	  3537:     ; Load [0A] with the value before the call.
                            	  3538:     ;
02:00031C82 102C0525        	  3539:     move.b  ($0525,A4),D0
02:00031C86 1940000A        	  3540:     move.b  D0,($000A,A4)
                            	  3541:     even
                            	  3542: _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell:
                            	  3543:     ; Loop to look for a place to spawn a monster from the edge
                            	  3544:     ; of the screen. Move counterclockwise, one square at a time.
                            	  3545:     ;
                            	  3546:     ; First, if low nibble = 0, then we're at the left edge.
                            	  3547:     ; We'll move down $10 pixels.
                            	  3548:     ;
02:00031C8A 7610            	  3549:     moveq   #16,D3
02:00031C8C 102C000A        	  3550:     move.b  ($000A,A4),D0
02:00031C90 0200000F        	  3551:     andi.b #$0F,D0
02:00031C94 670A            	  3552:     beq  _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight
                            	  3553:     ; Else if low nibble <> $F, then we're at the top or bottom.
                            	  3554:     ; Don't move vertically.
                            	  3555:     ;
02:00031C96 163C00F0        	  3556:     move.b  #$F0,D3
02:00031C9A 0C00000F        	  3557:     cmpi.b  #$0F,D0
02:00031C9E 6610            	  3558:     bne  _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom
                            	  3559:     even
                            	  3560: _L_z05_FindNextEdgeSpawnCell_HandleLeftOrRight:
                            	  3561:     ; Else low nibble = $F. We're at the right edge,
                            	  3562:     ; and we'll move up $10 pixels.
                            	  3563:     ;
02:00031CA0 1003            	  3564:     move.b  D3,D0
02:00031CA2 023C00EE        	  3565:     andi    #$EE,CCR  ; CLC: clear C+X
02:00031CA6 122C000A        	  3566:     move.b  ($000A,A4),D1
02:00031CAA D101            	  3567:     addx.b  D1,D0   ; ADC $0A
02:00031CAC 1940000A        	  3568:     move.b  D0,($000A,A4)
                            	  3569:     even
                            	  3570: _L_z05_FindNextEdgeSpawnCell_CheckTopOrBottom:
                            	  3571:     ; Next, if high nibble = $E, then we're at the bottom edge.
                            	  3572:     ; Move right one pixel.
                            	  3573:     ;
02:00031CB0 102C000A        	  3574:     move.b  ($000A,A4),D0
02:00031CB4 020000F0        	  3575:     andi.b #$F0,D0
02:00031CB8 0C0000E0        	  3576:     cmpi.b  #$E0,D0
02:00031CBC 6606            	  3577:     bne  _anon_z05_88
02:00031CBE 522C000A        	  3578:     addq.b  #1,($000A,A4)
02:00031CC2 600A            	  3579:     jmp     _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3580: 
                            	  3581: _anon_z05_88:
                            	  3582:     ; Else if high nibble <> 4, then we're at the left or right.
                            	  3583:     ; Dont' move horizontally.
                            	  3584:     ;
02:00031CC4 0C000040        	  3585:     cmpi.b  #$40,D0
02:00031CC8 6604            	  3586:     bne  _L_z05_FindNextEdgeSpawnCell_PointToColumn
                            	  3587:     ; Else high nibble = 4. We're at the top edge.
                            	  3588:     ; Move left 1 pixel.
                            	  3589:     ;
02:00031CCA 532C000A        	  3590:     subq.b  #1,($000A,A4)
                            	  3591:     even
                            	  3592: _L_z05_FindNextEdgeSpawnCell_PointToColumn:
                            	  3593:     ; Time to get the address of the column.
                            	  3594:     ; Starting at the top of the leftmost column.
                            	  3595:     ;
02:00031CCE 61002590        	  3596:     jsr     FetchTileMapAddr
02:00031CD2 7005            	  3597:     moveq   #5,D0
02:00031CD4 4EB90001E25C    	  3598:     jsr     _copy_bank_to_window   ; PATCH P33c: re-pin bank 5 after FetchTileMapAddr
                            	  3599:     ; Add $2C to the address as many times as the low nibble of [0A],
                            	  3600:     ; in order to point to the column we want.
                            	  3601:     ;
02:00031CDA 102C000A        	  3602:     move.b  ($000A,A4),D0
02:00031CDE 0200000F        	  3603:     andi.b #$0F,D0
02:00031CE2 7600            	  3604:     moveq   #0,D3
02:00031CE4 1600            	  3605:     move.b  D0,D3
02:00031CE6 670C            	  3606:     beq  _L_z05_FindNextEdgeSpawnCell_GetRowOffset
                            	  3607: _anon_z05_89:
02:00031CE8 702C            	  3608:     moveq   #44,D0
02:00031CEA 4EB900024328    	  3609:     jsr     AddToInt16At0
02:00031CF0 5303            	  3610:     subq.b  #1,D3
02:00031CF2 66F4            	  3611:     bne  _anon_z05_89
                            	  3612:     even
                            	  3613: _L_z05_FindNextEdgeSpawnCell_GetRowOffset:
                            	  3614:     ; Turn the row part of [0A] into a tile index.
                            	  3615:     ; row := (([0A] AND $F0) - $40) / 8
                            	  3616:     ;
02:00031CF4 102C000A        	  3617:     move.b  ($000A,A4),D0
02:00031CF8 020000F0        	  3618:     andi.b #$F0,D0
02:00031CFC 003C0011        	  3619:     ori     #$11,CCR  ; SEC: set C+X
02:00031D00 123C0040        	  3620:     move.b  #$40,D1
02:00031D04 0A3C0010        	  3621:     eori    #$10,CCR  ; flip X: 6502 SBC polarity
02:00031D08 9101            	  3622:     subx.b  D1,D0   ; SBC #$40
02:00031D0A 0A3C0010        	  3623:     eori    #$10,CCR  ; restore X = 6502 C
02:00031D0E E208            	  3624:     lsr.b  #1,D0   ; LSR A
02:00031D10 E208            	  3625:     lsr.b  #1,D0   ; LSR A
02:00031D12 E208            	  3626:     lsr.b  #1,D0   ; LSR A
02:00031D14 7600            	  3627:     moveq   #0,D3
02:00031D16 1600            	  3628:     move.b  D0,D3
                            	  3629:     ; If the tile < $84, then it's walkable. So, go use it.
                            	  3630:     ; $84 is a sand tile, which is OK for many monsters; but not
                            	  3631:     ; when coming in from the edges.
                            	  3632:     ;
02:00031D18 1214            	  3633:     move.b  ($00,A4),D1   ; ptr lo
02:00031D1A 182C0001        	  3634:     move.b  ($01,A4),D4  ; ptr hi
02:00031D1E 024100FF        	  3635:     andi.w  #$00FF,D1         ; zero-extend lo byte
02:00031D22 E14C            	  3636:     lsl.w   #8,D4
02:00031D24 8841            	  3637:     or.w    D1,D4             ; D4 = NES ptr addr
02:00031D26 48C4            	  3638:     ext.l   D4
02:00031D28 D8BC00FF0000    	  3639:     add.l   #NES_RAM,D4       ; → Genesis addr
02:00031D2E 2044            	  3640:     movea.l D4,A0
02:00031D30 10303000        	  3641:     move.b  (A0,D3.W),D0     ; LDA ($nn),Y
02:00031D34 0C000084        	  3642:     cmpi.b  #$84,D0
02:00031D38 650E            	  3643:     bcs  _L_z05_FindNextEdgeSpawnCell_SetSpawnCell
                            	  3644:     ; Bottom of the loop.
                            	  3645:     ; If you reach the original cell, then stop.
                            	  3646:     ;
02:00031D3A 102C000A        	  3647:     move.b  ($000A,A4),D0
02:00031D3E 122C0525        	  3648:     move.b  ($0525,A4),D1
02:00031D42 B001            	  3649:     cmp.b   D1,D0
02:00031D44 6600FF44        	  3650:     bne  _L_z05_FindNextEdgeSpawnCell_LoopEdgeCell
                            	  3651:     even
