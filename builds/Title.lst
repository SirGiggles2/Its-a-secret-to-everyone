02:0002D44C 1880            	  3947:     move.b  D0,($0000,A4)
                            	  3948:     ; Starting from the last slot of this moldorm chain (0 or 5):
                            	  3949:     ;
02:0002D44E 7600            	  3950:     moveq   #0,D3
02:0002D450 0C020005        	  3951:     cmpi.b  #$05,D2
