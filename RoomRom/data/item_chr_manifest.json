  "item_defs": [
    {
      "name": "sword_vert",
      "item": "sword",
      "direction_class": "vertical",
      "nes_frame_tile": "0x20",
      "sprite_size": [
        1,
        2
      ],
      "tile_ids": [
        "0x20",
        "0x21"
      ],
      "draw_rule": "narrow_8x16",
      "sprite_size_override_reason": "NES uses 8x16 hardware sprites (PPU OAM obj size bit): tile $20 is the top 8x8, tile $21 is the bottom 8x8 of the same 8x16 sprite. Anim_WriteSpecificItemSprites @Narrow (Z_01.asm:5288) emits a single OAM entry whose hardware height is 16px. Genesis SPRITE_SIZE(1,2) matches NES visual output exactly. The dispatch table [1,1] reflects the NES tile-count per OAM entry, not the rendered pixel height."
    },
    {
      "name": "sword_horz",
      "item": "sword",
      "direction_class": "horizontal",
      "nes_frame_tile": "0x82",
      "sprite_size": [
        2,
        2
      ],
      "tile_ids": [
        "0x82",
        "0x83",
        "0x84",
        "0x85"
      ],
      "draw_rule": "wide_16x16_hflippable",
      "sprite_size_override_reason": "NES Flippable dispatch (Z_01.asm:5301) draws two 8x8 sprites side-by-side (tiles $82+$84, 16x8 visible). Genesis renderer stores all 4 tiles ($82-$85, the full 2x2 NES CHR block) in a 2x2 SPRITE_SIZE so both the top row and bottom row are uploaded and accessible for Genesis column-major tile layout. SPRITE_SIZE(2,1) would omit bottom-row tiles needed for the sword cross-guard graphic."
    },
    {
      "name": "boomerang",
      "item": "boomerang",
      "direction_class": "rotating",
